package main

import "./ci"
import "dice"
import "mint"
import "say"
import "twine"

// Compare container/list and container/ring with Go's, operation by operation.
//
// The corpus is three parts, all fed to bench/ref/list_ring and tools/ci/fixtures/list_ring.tin: hand-written edge cases
// (PushFrontList and PushBackList into non-empty lists, a list into itself, stale and foreign element handles, rings of
// one node, Link of a ring with itself, Unlink of zero, negative and too many nodes), every small list and ring case
// (lists of up to three elements with each element removed, moved or inserted beside, and rings of one to five nodes
// with every Link pair, Unlink count and Move distance), and generated scripts from a fixed seed. Each case prints
// after every operation the two lists and every handle (value, owner, next, prev), so the check compares the whole
// structure, not just the results of the operations.

const SEED = 919

// fixed is the hand-written part of the corpus.
fn fixed() []str {
	return []str{
		"pfl a a",
		"pbl a a",
		"pb a 1 ; pb a 2 ; pfl a a",
		"pb a 1 ; pb a 2 ; pbl a a",
		"pb a 1 ; pb a 2 ; pb b 7 ; pb b 8 ; pfl a b ; pbl a b ; pfl b a",
		"pb b 7 ; pfl a b ; pbl b b",
		"pb a 1 ; rm a e0 ; mtf a e0 ; mtb a e0 ; ib a e0 2 ; ia a e0 3 ; nx e0 ; pv e0",
		"pb a 1 ; pb b 2 ; mtf b e0 ; rm b e0 ; ib b e0 5 ; ia a e0 6 ; rm a e1",
		"pb a 1 ; pb a 2 ; rm a e0 ; rm a e0 ; fr a ; bk a ; fr b ; bk b",
		"nx e0 ; pv e3 ; rm a e0 ; mtf a e9 ; ib a e0 1",
		"pb a 4 ; fr a ; bk a ; nx e0 ; pv e0 ; mtf a e0 ; mtb a e0",
		"new",
		"new 5",
		"new 1 2 ; link r0 r0",
		"new 1 2 3 ; link r0 r0 ; do r0 ; len r0",
		"new 1 2 3 ; unlink r0 0 ; unlink r0 -1 ; unlink r0 2 ; do r0 ; do r1 ; len r2",
		"new 1 2 3 4 5 ; unlink r0 4 ; do r0 ; len r0",
		"new 1 2 3 ; unlink r0 9 ; do r0 ; unlink r0 3",
		"new 1 2 3 ; move r0 -7 ; move r0 7 ; move r1 -1 ; nx r2 ; pv r2",
		"new 1 2 ; new 3 4 ; link r0 r2 ; do r0 ; len r3 ; link r1 r3 ; do r1 ; len r0",
		"new 1 2 3 4 ; link r0 r2 ; do r0 ; unlink r1 1 ; do r1 ; do r3",
		"new 1 ; new 2 ; link r0 r1 ; link r0 r0 ; do r0 ; len r1",
		"nx r9 ; move r0 1 ; unlink r7 1 ; link r0 r5 ; do r0",
	}
}

// genOps is one generated script of operations, drawn from the seeded generator.
fn genCase(rng mut dice.Rand) str {
	let count = 3 + rng.Range(0, 8)
	mut ops = []str{}
	mut elems = i64(0)
	mut nodes = i64(0)
	mut v = i64(1)
	for i in 0..count {
		let pick = rng.Range(0, 20)
		let l = []str{"a", "b"}[rng.Range(0, 2)]
		let m = []str{"a", "b"}[rng.Range(0, 2)]
		let e = "e" + mint.Itoa(rng.Range(0, elems+1))
		let r = "r" + mint.Itoa(rng.Range(0, nodes+1))
		if pick == 0 || pick == 1 {
			ops = append(ops, op(pick == 0, l, v))
			elems += 1
		} else if pick == 2 {
			ops = append(ops, "ib " + l + " " + e + " " + mint.Itoa(v))
			elems += 1
		} else if pick == 3 {
			ops = append(ops, "ia " + l + " " + e + " " + mint.Itoa(v))
			elems += 1
		} else if pick == 4 {
			ops = append(ops, "pfl " + l + " " + m)
		} else if pick == 5 {
			ops = append(ops, "pbl " + l + " " + m)
		} else if pick == 6 {
			ops = append(ops, "rm " + l + " " + e)
		} else if pick == 7 {
			ops = append(ops, "mtf " + l + " " + e)
		} else if pick == 8 {
			ops = append(ops, "mtb " + l + " " + e)
		} else if pick == 9 {
			ops = append(ops, "fr " + l)
			elems += 1
		} else if pick == 10 {
			ops = append(ops, "bk " + l)
			elems += 1
		} else if pick == 11 {
			ops = append(ops, "nx " + e)
		} else if pick == 12 {
			ops = append(ops, "pv " + e)
		} else if pick == 13 || nodes == 0 {
			let k = rng.Range(0, 5)
			mut vals = []str{}
			for j in 0..k {
				vals = append(vals, mint.Itoa(v + j))
			}
			ops = append(ops, twine.Join(append([]str{"new"}, vals...), " "))
			v += k
			nodes += k
		} else if pick == 14 {
			ops = append(ops, "link " + r + " r" + mint.Itoa(rng.Range(0, nodes+1)))
		} else if pick == 15 {
			ops = append(ops, "unlink " + r + " " + mint.Itoa(rng.Range(-1, 5)))
		} else if pick == 16 {
			ops = append(ops, "move " + r + " " + mint.Itoa(rng.Range(-6, 6)))
		} else if pick == 17 {
			ops = append(ops, "do " + r)
		} else if pick == 18 {
			ops = append(ops, "len " + r)
		} else {
			ops = append(ops, "nx " + r)
		}
		v += 1
	}
	return twine.Join(ops, " ; ")
}

// op is a PushFront (front) or PushBack call on list l of the value v.
fn op(front bool, l str, v i64) str {
	if front {
		return "pf " + l + " " + mint.Itoa(v)
	}
	return "pb " + l + " " + mint.Itoa(v)
}

// exhaustive is every small list case and every small ring case.
fn exhaustive() []str {
	mut out = []str{}
	// Lists: a holds n elements (e0..e(n-1)), b holds m more (e(n)..). Each case builds them, then runs one operation.
	for n in 0..4 {
		for m in 0..3 {
			mut build = []str{}
			for i in 0..n {
				build = append(build, "pb a " + mint.Itoa(i + 1))
			}
			for j in 0..m {
				build = append(build, "pb b " + mint.Itoa(10 + j))
			}
			let prefix = twine.Join(build, " ; ")
			mut joint = ""
			if prefix != "" {
				joint = " ; "
			}
			for i in 0..(n + m) {
				let e = "e" + mint.Itoa(i)
				for l in []str{"a", "b"} {
					out = append(out, prefix + joint + "rm " + l + " " + e)
					out = append(out, prefix + joint + "mtf " + l + " " + e)
					out = append(out, prefix + joint + "mtb " + l + " " + e)
					out = append(out, prefix + joint + "ib " + l + " " + e + " 99")
					out = append(out, prefix + joint + "ia " + l + " " + e + " 99")
					out = append(out, prefix + joint + "nx " + e + " ; pv " + e)
				}
			}
			for l in []str{"a", "b"} {
				for s in []str{"a", "b"} {
					out = append(out, prefix + joint + "pfl " + l + " " + s + " ; fr " + l + " ; bk " + l)
					out = append(out, prefix + joint + "pbl " + l + " " + s + " ; fr " + l + " ; bk " + l)
				}
			}
		}
	}
	// Rings: k nodes r0..r(k-1) with values 1..k; every Link pair, Unlink count and Move distance.
	for k in 1..6 {
		let build = "new " + twine.Join(seq(k), " ")
		for i in 0..k {
			for j in 0..k {
				out = append(out, build + " ; link r" + mint.Itoa(i) + " r" + mint.Itoa(j) + " ; do r0 ; len r0")
			}
			for c in -2..k+2 {
				out = append(out, build + " ; unlink r" + mint.Itoa(i) + " " + mint.Itoa(c) + " ; do r0")
			}
			for d in -6..7 {
				out = append(out, build + " ; move r" + mint.Itoa(i) + " " + mint.Itoa(d))
			}
		}
	}
	return out
}

// seq is the decimal strings 1..k.
fn seq(k i64) []str {
	mut out = []str{}
	for i in 1..k+1 {
		out = append(out, mint.Itoa(i))
	}
	return out
}

fn corpus() []str {
	mut rng = dice.New(SEED)
	mut lines = fixed()
	lines = append(lines, exhaustive()...)
	for i in 0..400 {
		lines = append(lines, genCase(mut rng))
	}
	return lines
}

fn run(exe str, data str) []str {
	let o = ci.ExecIn([]str{exe}, ci.Root(), 900, data, []str{})
	ci.Must(o, exe)
	return ci.Lines(o.Stdout)
}

fn main() {
	let lines = corpus()
	let data = twine.Join(lines, "\n") + "\n"
	let directory = ci.Join(ci.Root(), "bin/ci/list_ring")
	ci.Mkdirs(directory)
	let work = ci.TempDir(directory, "list_ring-")
	let tin = ci.Join(work, "list_ring-tin")
	ci.BuildTin("tools/ci/fixtures/list_ring.tin", tin, "", []str{})
	let goexe = ci.Join(work, "list_ring-go")
	ci.Must(ci.Exec([]str{"go", "build", "-o", goexe, "./bench/ref/list_ring"}, ci.Root(), 300), "go build list_ring")
	let want = run(goexe, data)
	let got = run(tin, data)
	ci.Check(len(got) == len(want), "list_ring: " + mint.Itoa(len(got)) + " lines against Go's " + mint.Itoa(len(want)))
	mut bad = 0
	for i in 0..len(want) {
		if want[i] != got[i] {
			say.Line("line " + mint.Itoa(i + 1) + " (case " + caseOf(want, i) + "):")
			say.Line("  Go:  " + short(want[i]))
			say.Line("  Tin: " + short(got[i]))
			bad += 1
			if bad >= 6 {
				break
			}
		}
	}
	ci.Check(bad == 0, "list_ring: " + mint.Itoa(bad) + " of " + mint.Itoa(len(want)) + " lines differ")
	ci.Remove(work)
	ci.Pass("list_ring: " + mint.Itoa(len(want)) + " lines (" + mint.Itoa(len(lines)) + " cases) match Go's container/list and container/ring")
}

// caseOf is the number of the case whose output holds line i of want (the "case N" header before it).
fn caseOf(want []str, i i64) str {
	mut j = i
	for j >= 0 {
		if twine.HasPrefix(want[j], "case ") {
			return want[j][5:len(want[j])]
		}
		j -= 1
	}
	return "?"
}

// short keeps a diff line readable: the first and last part of a long line.
fn short(line str) str {
	if len(line) <= 160 {
		return line
	}
	return line[0:80] + " ... " + line[len(line)-60:len(line)]
}
