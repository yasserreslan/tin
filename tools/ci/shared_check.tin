package main

import "./ci"
import "./nettest"
import "mint"
import "say"
import "twine"

// shared let and atomic (#344): a 100 MB table in a shared let is built once and read by every core, so the process's resident memory
// does not grow with TIN_CORES (a per-core global would take 100 MB per core), every core sees the same table, and atomic.Int counts
// exactly under concurrent requests that land on different cores. Fixture shared.tin.

fn hit(port i64, path str) str {
	return nettest.Get(port, path)
}

// bump makes the requests, eight at a time on this core.
fn bump(port i64, bumps i64) ! {
	scope s {
		for t in 0..8 {
			s.spawn(fn() ! {
				for k in 0..bumps / 8 {
					hit(port, "/hit")
				}
			})
		}
	}
}

// run starts the server on this many cores and returns its resident memory (bytes) and the counter after the hits.
fn run(exe str, cores i64, log str) (i64, i64) {
	let port = nettest.Port()
	let server = nettest.Start(exe, []str{}, []str{"TIN_CORES=" + mint.Itoa(cores)}, log, port)
	server.Ready(20)
	for i in 0..40 {
		ci.Check(hit(port, "/sum") == "12500000 235076008923", "shared: /sum answered " + hit(port, "/sum"))
	}
	for i in 0..40 {
		ci.Check(hit(port, "/lookup") == "30000 449985000", "shared: /lookup answered " + hit(port, "/lookup"))
	}
	let bumps = 4000
	bump(port, bumps) catch err {
		ci.Fail("shared: " + say.Str(err))
	}
	let count = ci.Num(twine.TrimSpace(hit(port, "/count")))
	ci.Check(count == bumps, "shared: " + mint.Itoa(cores) + " cores counted " + mint.Itoa(count) + ", want " + mint.Itoa(bumps))
	let rss = nettest.RssKiB(server.Pid) * 1024
	server.Stop()
	return rss, count
}

fn main() {
	let out = ci.Join(ci.Root(), "bin/ci/shared")
	ci.Mkdirs(out)
	let exe = ci.Join(out, "shared")
	ci.BuildTin("tools/ci/fixtures/shared.tin", exe, "", []str{})
	let (one, c1) = run(exe, 1, ci.Join(out, "one.log"))
	let (eight, c8) = run(exe, 8, ci.Join(out, "eight.log"))
	ci.Check(one > 90 * 1048576, "shared: one core holds only " + mint.Itoa(one) + " bytes")
	ci.Check(eight - one < 40 * 1048576, "shared: eight cores hold " + mint.Itoa(eight) + " bytes against " + mint.Itoa(one))
	ci.Pass("100 MB shared let: resident " + mint.Itoa(one / 1048576) + " MiB on 1 core, " + mint.Itoa(eight / 1048576) + " MiB on 8 cores; the atomic counter counted " + mint.Itoa(c1) + " and " + mint.Itoa(c8))
}
