package main

import "./ci"
import "dice"
import "mint"
import "say"
import "twine"

// Compare pack and the small encodings with Go's encoding/binary, encoding/base32 and encoding/ascii85.
//
// A generated corpus of values and byte strings (a fixed seed, so both sides see the same cases) is fed to bench/ref/pack and
// tools/ci/fixtures/pack.tin; the check compares their lines: the packed forms of u64 values, the u64 reads and varints of byte
// strings (including truncated and over-long encodings), and the base32/ascii85 encodings, decodes and round trips.

const SEED = 740
const VALUES = 4000
const BYTES = 4000

fn hex(b []u8) str {
	let digits = "0123456789abcdef"
	mut out = []u8{}
	for x in b {
		out = append(out, digits[x >> 4])
		out = append(out, digits[x & 15])
	}
	return str(out)
}

fn be64(v u64) []u8 {
	mut out = []u8{}
	for i in 0..8 {
		out = append(out, u8(v >> u64(8 * (7 - i))))
	}
	return out
}

// bits is a random number of up to k bits (Python's getrandbits).
fn bits(rng dice.Rand, k i64) u64 {
	return rng.U64() >> u64(64 - k)
}

// varint is Go's PutUvarint.
fn varint(v u64) []u8 {
	mut out = []u8{}
	mut x = v
	for x >= 128 {
		out = append(out, u8((x & 127) | 128))
		x = x >> 7
	}
	out = append(out, u8(x))
	return out
}

fn zigzag(v i64) u64 {
	return u64((v << 1) ^ (v >> 63))
}

fn bytesOf(s str) []u8 {
	mut out = []u8{}
	for i in 0..len(s) {
		out = append(out, s[i])
	}
	return out
}

fn repeat(b u8, n i64) []u8 {
	mut out = []u8{}
	for i in 0..n {
		out = append(out, b)
	}
	return out
}

fn corpus() []str {
	let rng = dice.New(SEED)
	mut lines = []str{}
	let fixed = []u64{0, 1, 2, 127, 128, 255, 256, 65535, 65536, 4294967295, 4294967296, 9223372036854775807, 9223372036854775808, 18446744073709551615, 300, 16384}
	for v in fixed {
		lines = append(lines, "P " + hex(be64(v)))
	}
	for len(lines) < VALUES {
		mut v = rng.U64()
		if rng.F64() < 0.3 {
			v = bits(rng, rng.Range(1, 33))
		}
		lines = append(lines, "P " + hex(be64(v)))
	}

	// Varint corpora: valid, truncated and over-long encodings, and arbitrary bytes.
	mut extra = [][]u8{}
	for i in 0..BYTES / 4 {
		let v = bits(rng, rng.Range(1, 65))
		let enc = varint(v)
		extra = append(extra, enc)
		if len(enc) > 1 {
			extra = append(extra, enc[0:rng.Range(1, len(enc))])
		}
		let sv = i64(rng.U64())
		extra = append(extra, varint(zigzag(sv)))
	}
	extra = append(extra, repeat(255, 10))
	mut nine = repeat(255, 9)
	nine = append(nine, 2)
	extra = append(extra, nine)
	extra = append(extra, repeat(128, 10))
	extra = append(extra, []u8{})
	for len(extra) < BYTES {
		let n = rng.Range(0, 13)
		mut b = []u8{}
		for k in 0..n {
			b = append(b, u8(rng.I64n(256)))
		}
		extra = append(extra, b)
	}
	// The encodings get arbitrary bytes too: every length, padding in the middle, whitespace, 'z' and '~' in ascii85, and invalid
	// alphabet bytes.
	let specialText = []str{"", "=", "====", "A", "A=", "AB", "ABC", "ABCDE", "MZXW6", "MZXW6===", "MZXW6====", "=MZXW6", "MZ=W6===", "mzxw6===", "7Z======", "z", "~>", "<~9jqo~>", "9jq o", "9jqo\n", "!!!!!", "uuuuu", "vvvvv", "!!!!", "\xff\xff\xff\xff\xff", "9jqo~", "z9jqo", "\t\n 9jqo \r"}
	mut special = [][]u8{}
	for t in specialText {
		special = append(special, bytesOf(t))
	}
	for b in extra {
		lines = append(lines, "U " + hex(b))
	}
	for b in special {
		lines = append(lines, "B " + hex(b))
	}
	let alphabet = bytesOf("ABZ27=az\t\nz~!u\xff")
	mut count = len(special)
	for count < 2000 {
		let n = rng.Range(0, 11)
		mut b = []u8{}
		for k in 0..n {
			b = append(b, alphabet[rng.I64n(len(alphabet))])
		}
		lines = append(lines, "B " + hex(b))
		count += 1
	}
	return lines
}

fn run(exe str, data str) []str {
	let o = ci.ExecIn([]str{exe}, ci.Root(), 600, data, []str{})
	ci.Must(o, exe)
	return ci.Lines(o.Stdout)
}

// corpusLine is the corpus line an output line came from: P and U print one line, B prints three.
fn corpusLine(lines []str, outIndex i64) str {
	mut n = 0
	for line in lines {
		if twine.HasPrefix(line, "B ") {
			n += 3
		} else {
			n += 1
		}
		if outIndex < n {
			return line
		}
	}
	return "?"
}

fn main() {
	let lines = corpus()
	let data = twine.Join(lines, "\n") + "\n"
	let directory = ci.Join(ci.Root(), "bin/ci/pack")
	ci.Mkdirs(directory)
	let work = ci.TempDir(directory, "pack-")
	let tin = ci.Join(work, "pack-tin")
	ci.BuildTin("tools/ci/fixtures/pack.tin", tin, "", []str{})
	let goexe = ci.Join(work, "pack-go")
	ci.Must(ci.Exec([]str{"go", "build", "-o", goexe, "./bench/ref/pack"}, ci.Root(), 300), "go build pack")
	let want = run(goexe, data)
	let got = run(tin, data)
	ci.Check(len(got) == len(want), "pack: " + mint.Itoa(len(got)) + " lines against Go's " + mint.Itoa(len(want)))
	mut bad = 0
	for i in 0..len(want) {
		if want[i] != got[i] {
			say.Line("line " + mint.Itoa(i + 1) + " (corpus line " + corpusLine(lines, i) + "):")
			say.Line("  Go:  " + want[i])
			say.Line("  Tin: " + got[i])
			bad += 1
			if bad >= 10 {
				break
			}
		}
	}
	ci.Check(bad == 0, "pack: " + mint.Itoa(bad) + " of " + mint.Itoa(len(want)) + " lines differ")
	ci.Remove(work)
	ci.Pass("pack: " + mint.Itoa(len(want)) + " lines (" + mint.Itoa(len(lines)) + " corpus cases) match Go's encoding/binary, base32 and ascii85")
}
