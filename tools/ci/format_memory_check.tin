package main

import "./ci"
import "mint"
import "say"

// Formatting in a plain program runs in the memory of its results: say.Line takes no pool memory per call, and an interpolation
// or say.Fmt no more than the string it returns (#553).

fn main() {
	if !ci.Linux() {
		say.Line("SKIP format memory: peak RSS is measured on Linux")
		return
	}
	let out = ci.Join(ci.Root(), "bin/ci/format")
	ci.Mkdirs(out)
	let exe = ci.Join(out, "format_memory")
	ci.BuildTin("tools/ci/fixtures/format_memory.tin", exe, "", []str{})
	mut peaks = map[str]i64{}
	let names = []str{"line", "itoa", "interp", "fmt"}
	let counts = []str{"10000000", "1000000", "1000000", "1000000"}
	for i in 0..len(names) {
		let (code, kib, err) = ci.Peak(exe, []str{names[i], counts[i]}, 120)
		ci.Check(code == 0, "format memory " + names[i] + ": exit " + mint.Itoa(code) + " " + err)
		peaks[names[i]] = kib
		say.Line(names[i] + " x" + counts[i] + ": peak " + mint.Itoa(kib) + " KiB")
	}
	// 10 million lines used to take about 3 GB (304 bytes a line); now a few MiB of heap.
	ci.Check(peaks["line"] < 16 * 1024, "format memory: say.Line peak " + mint.Itoa(peaks["line"]) + " KiB")
	// A string from interpolation or say.Fmt costs what the same string made by + costs.
	for what in []str{"interp", "fmt"} {
		ci.Check(peaks[what] * 10 <= peaks["itoa"] * 11, "format memory " + what + ": " + mint.Itoa(peaks[what]) + " KiB against " + mint.Itoa(peaks["itoa"]))
	}
	ci.Pass("format memory: 10M say.Line in " + mint.Itoa(peaks["line"]) + " KiB; 1M interpolations " + mint.Itoa(peaks["interp"]) + " KiB, say.Fmt " + mint.Itoa(peaks["fmt"]) + " KiB, + and Itoa " + mint.Itoa(peaks["itoa"]) + " KiB")
}
