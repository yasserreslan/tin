// Helpers for the CI checks, which are Tin programs: run a program with a deadline and collect what it printed, make throwaway
// directories and trees, compare output with what is expected, and report.
package ci

import "fault"
import "mint"
import "quarry"
import "say"
import "spawn"
import "twine"

// Out is what a finished program left: its exit code (124 when the deadline killed it, -1 when it could not be started), its
// standard output and its standard error.
type Out struct {
	Code i64
	Stdout str
	Stderr str
}

// Ok reports whether the program exited with 0.
fn (o Out) Ok() bool {
	return o.Code == 0
}

// Both is the output and the error together.
fn (o Out) Both() str {
	return o.Stdout + o.Stderr
}

// cmd is a Cmd that inherits everything but the pipes Run adds.
fn cmd(argv []str, dir str) spawn.Cmd {
	return spawn.Cmd{Argv: argv, Env: spawn.Env.Inherit, Dir: dir, Stdin: spawn.Stdio.Null, Stdout: spawn.Stdio.Inherit, Stderr: spawn.Stdio.Inherit, MaxOutput: 0}
}

// Exec runs the program (a name without a slash is looked up in PATH) in the directory ("" for the current one) and kills it after
// seconds. A program that cannot be started has code -1 and its reason in Stderr.
fn Exec(argv []str, dir str, seconds i64) Out {
	let r = within seconds * 1000000000 {
		try spawn.Run(cmd(argv, dir))
	} catch err {
		if fault.Is(err, fault.DeadlineExceeded) {
			return Out{Code: 124, Stdout: "", Stderr: "CI timeout\n"}
		}
		return Out{Code: -1, Stdout: "", Stderr: say.Str(err) + "\n"}
	}
	return Out{Code: r.Code, Stdout: r.Stdout, Stderr: r.Stderr}
}

// ExecEnv is Exec with environment entries added (NAME=value) and some removed (names), through env(1).
fn ExecEnv(argv []str, dir str, seconds i64, set []str, unset []str) Out {
	mut full = []str{"env"}
	for name in unset {
		full = append(full, "-u")
		full = append(full, name)
	}
	for entry in set {
		full = append(full, entry)
	}
	for a in argv {
		full = append(full, a)
	}
	return Exec(full, dir, seconds)
}

// Sh runs a shell script.
fn Sh(script str, dir str, seconds i64) Out {
	return Exec([]str{"/bin/sh", "-c", script}, dir, seconds)
}

// Fail prints the message and ends the check with status 1.
fn Fail(message str) {
	say.Line("FAIL", message)
	cleanupTracked()
	quarry.Exit(1)
}

// Check fails the check with the message unless ok.
fn Check(ok bool, message str) {
	if !ok {
		Fail(message)
	}
}

// Must fails the check unless the program exited with 0, showing what it printed.
fn Must(o Out, what str) {
	if o.Code != 0 {
		Fail(what + ": exit " + mint.Itoa(o.Code) + "\n" + tail(o.Stdout, 3000) + tail(o.Stderr, 3000))
	}
}

// tail is the last n bytes of s.
fn tail(s str, n i64) str {
	if len(s) <= n {
		return s
	}
	return s[len(s) - n:]
}

// Pass prints the line that says a check passed.
fn Pass(message str) {
	say.Line("PASS", message)
}

// Root is the repository: the directory the check runs in (the wrappers start from it).
fn Root() str {
	return quarry.Getwd() catch _ {
		"."
	}
}

// Join puts two path parts together.
fn Join(a str, b str) str {
	if len(a) == 0 {
		return b
	}
	if twine.HasSuffix(a, "/") {
		return a + b
	}
	return a + "/" + b
}

// Read is the text of a file ("" when it cannot be read).
fn Read(path str) str {
	return quarry.ReadFile(path) catch _ {
		""
	}
}

// Write puts text in a file, failing the check when it cannot.
fn Write(path str, text str) {
	quarry.WriteFile(path, text) catch err {
		Fail("cannot write " + path + ": " + say.Str(err))
	}
}

// Mkdirs makes a directory and the ones above it.
fn Mkdirs(path str) {
	quarry.MkdirAll(path) catch err {
		Fail("cannot make " + path + ": " + say.Str(err))
	}
}

// TempDir makes a new directory below dir (made if need be) whose name starts with prefix, and returns its path. A check that
// fails removes it before it exits.
fn TempDir(dir str, prefix str) str {
	Mkdirs(dir)
	let o = Exec([]str{"mktemp", "-d", Join(dir, prefix + "XXXXXX")}, "", 20)
	Must(o, "mktemp")
	let path = twine.TrimSpace(o.Stdout)
	TrackDir(path)
	return path
}

// What a failing check cleans up before it exits: the throwaway directories it made and the programs it started, so a failure
// leaves no directory and no process behind.
mut failDirs = []str{}
mut failPids = []i64{}

// TrackDir names a throwaway directory a failing check removes.
fn TrackDir(path str) {
	failDirs = append(failDirs, keep(path))
}

// TrackPid names a process a failing check ends.
fn TrackPid(pid i64) {
	failPids = append(failPids, pid)
}

// cleanupTracked ends every tracked program, then removes every tracked directory: the programs hold files in them open.
fn cleanupTracked() {
	if len(failDirs) == 0 && len(failPids) == 0 {
		return
	}
	if len(failPids) > 0 {
		mut argv = []str{"kill", "-9"}
		for i in 0..len(failPids) {
			argv = append(argv, mint.Itoa(failPids[len(failPids) - 1 - i]))
		}
		Exec(argv, "", 10)
	}
	for i in 0..len(failDirs) {
		Remove(failDirs[i])
	}
}

// Remove deletes a file or a directory with everything in it.
fn Remove(path str) {
	quarry.RemoveAll(path) catch _ {
	}
}

// Copy copies a file or a directory tree (cp -R).
fn Copy(src str, dst str) {
	Must(Exec([]str{"cp", "-R", src, dst}, "", 120), "copy " + src)
}

// Link makes a symbolic link at link pointing to target (ln -s).
fn Link(target str, link str) {
	Must(Exec([]str{"ln", "-s", target, link}, "", 20), "link " + link)
}

// Files are the files below dir whose names end with the suffix, as paths, in name order.
fn Files(dir str, suffix str) []str {
	mut out = []str{}
	let names = quarry.ReadDir(dir) catch _ {
		return out
	}
	for name in names {
		let path = Join(dir, name)
		if quarry.IsDir(path) {
			for f in Files(path, suffix) {
				out = append(out, f)
			}
		} else if twine.HasSuffix(name, suffix) {
			out = append(out, path)
		}
	}
	return out
}

// Names are the names in a directory that end with the suffix, in order.
fn Names(dir str, suffix str) []str {
	mut out = []str{}
	let names = quarry.ReadDir(dir) catch _ {
		return out
	}
	for name in names {
		if twine.HasSuffix(name, suffix) {
			out = append(out, name)
		}
	}
	return out
}

// Diff is a unified diff of two texts (empty when they are equal), made by diff(1) on two temporary files.
fn Diff(nameA str, a str, nameB str, b str) str {
	if a == b {
		return ""
	}
	let dir = TempDir(quarry.TempDir(), "tin-diff-")
	Write(dir + "/a", a)
	Write(dir + "/b", b)
	let o = Exec([]str{"diff", "-u", "--label", nameA, "--label", nameB, dir + "/a", dir + "/b"}, "", 20)
	Remove(dir)
	return o.Stdout
}

// Env is an environment variable ("" when it is not set).
fn Env(name str) str {
	return quarry.Getenv(name)
}

// OS is "darwin" or "linux".
fn OS() str {
	let o = Exec([]str{"uname", "-s"}, "", 10)
	if twine.TrimSpace(o.Stdout) == "Darwin" {
		return "darwin"
	}
	return "linux"
}

// Arch is "arm64" or "amd64".
fn Arch() str {
	let o = Exec([]str{"uname", "-m"}, "", 10)
	let m = twine.TrimSpace(o.Stdout)
	if m == "arm64" || m == "aarch64" {
		return "arm64"
	}
	return "amd64"
}

// The unit-test style checks count what failed and report at the end.
mut failures i64
mut tests i64

// Test records one test: it prints ok or FAIL with the name.
fn Test(name str, ok bool) {
	tests += 1
	if ok {
		say.Line("ok", name)
	} else {
		failures += 1
		say.Line("FAIL", name)
	}
}

// Same is Test for two values of the same type shown as text: a failure prints both.
fn Same(name str, got str, want str) {
	tests += 1
	if got == want {
		say.Line("ok", name)
	} else {
		failures += 1
		say.Line("FAIL", name, "got", got, "want", want)
	}
}

// Finish ends a unit-test style check: status 1 when a test failed.
fn Finish() {
	say.Line(tests, "tests,", failures, "failed")
	if failures > 0 {
		cleanupTracked()
		quarry.Exit(1)
	}
}

// Linux reports whether this is Linux (where /proc and peak memory figures exist).
fn Linux() bool {
	return quarry.Exists("/proc/self/maps")
}

// Tinc is the compiler under test: TIN_COMPILER when set, else bin/tinc of the tree.
fn Tinc() str {
	let c = Env("TIN_COMPILER")
	if len(c) > 0 {
		return c
	}
	return Join(Root(), "bin/tinc")
}

// BuildTin compiles the program (a path from the repository root) into exe with the compiler under test, finding the library in
// the tree at tinRoot ("" for the repository), plus extra compiler arguments. It fails the check when the compile fails.
fn BuildTin(source str, exe str, tinRoot str, extra []str) {
	mut root = tinRoot
	if len(root) == 0 {
		root = Root()
	}
	mut argv = []str{Tinc()}
	for a in extra {
		argv = append(argv, a)
	}
	argv = append(argv, "-o")
	argv = append(argv, exe)
	argv = append(argv, source)
	let o = ExecEnv(argv, Root(), 300, []str{"TIN_ROOT=" + root}, []str{})
	Must(o, "compile " + source)
}

// CopyTree copies the runtime, the standard library and the packages of the tree at root into dest, keeping the tree layout.
fn CopyTree(root str, dest str) {
	Mkdirs(Join(dest, "toolchain"))
	Copy(Join(root, "toolchain/runtime"), Join(dest, "toolchain/runtime"))
	Copy(Join(root, "toolchain/std"), Join(dest, "toolchain/std"))
	Copy(Join(root, "packages"), Join(dest, "packages"))
}

// CopyLib copies the runtime, the standard library and the packages into one lib/ directory (each as a directory of its own).
fn CopyLib(root str, lib str) {
	Mkdirs(lib)
	Copy(Join(root, "toolchain/runtime"), Join(lib, "runtime"))
	for part in []str{"toolchain/std", "packages"} {
		let names = quarry.ReadDir(Join(root, part)) catch _ {
			[]str{}
		}
		for name in names {
			if quarry.IsDir(Join(Join(root, part), name)) {
				Copy(Join(Join(root, part), name), Join(lib, name))
			}
		}
	}
}

// Words reads "name value name value ..." (a line a fixture printed) into a map.
fn Words(text str) map[str]str {
	mut m = map[str]str{}
	let parts = twine.Fields(text)
	mut i = 0
	for i + 1 < len(parts) {
		m[parts[i]] = parts[i + 1]
		i += 2
	}
	return m
}

// Peak runs the program with its output thrown away and returns its exit code, its peak memory in KiB (the last number the
// program printed on standard error) and its standard error.
fn Peak(exe str, args []str, seconds i64) (i64, i64, str) {
	mut argv = []str{"/bin/sh", "-c", "exec \"$0\" \"$@\" >/dev/null", exe}
	for a in args {
		argv = append(argv, a)
	}
	let o = Exec(argv, "", seconds)
	let words = twine.Fields(o.Stderr)
	mut kib = -1
	if len(words) > 0 {
		kib = mint.Atoi(words[len(words) - 1]) catch _ {
			-1
		}
	}
	return o.Code, kib, o.Stderr
}

// Num is a decimal number in a string (0 when it is not one).
fn Num(s str) i64 {
	return mint.Atoi(s) catch _ {
		0
	}
}

// ExecIn is ExecEnv with text on the program's standard input (through a temporary file below bin/ci).
fn ExecIn(argv []str, dir str, seconds i64, input str, set []str) Out {
	let tmp = TempDir(Join(Root(), "bin/ci"), "stdin-")
	let path = Join(tmp, "input")
	Write(path, input)
	mut full = []str{"env"}
	for entry in set {
		full = append(full, entry)
	}
	for a in argv {
		full = append(full, a)
	}
	mut c = cmd(full, dir)
	c.Stdin = spawn.Stdio.File(path)
	let r = within seconds * 1000000000 {
		try spawn.Run(c)
	} catch err {
		Remove(tmp)
		if fault.Is(err, fault.DeadlineExceeded) {
			return Out{Code: 124, Stdout: "", Stderr: "CI timeout\n"}
		}
		return Out{Code: -1, Stdout: "", Stderr: say.Str(err) + "\n"}
	}
	Remove(tmp)
	return Out{Code: r.Code, Stdout: r.Stdout, Stderr: r.Stderr}
}

// Lines splits text into its lines (no empty last one).
fn Lines(text str) []str {
	if len(text) == 0 {
		return []str{}
	}
	return twine.Split(twine.TrimSuffix(text, "\n"), "\n")
}

// Exists reports whether the path exists.
fn Exists(path str) bool {
	return quarry.Exists(path)
}

// PeakRun runs the program (with extra environment entries) under /usr/bin/time and returns its exit status, standard output and its
// peak resident memory in bytes (the child's own, as the kernel counts it). The standard error of the program is returned too.
fn PeakRun(exe str, args []str, set []str, seconds i64) (i64, str, i64, str) {
	mut argv = []str{"/usr/bin/time"}
	let linux = OS() == "linux"
	if linux {
		argv = append(argv, "-f")
		argv = append(argv, "PEAK %M")
	} else {
		argv = append(argv, "-l")
	}
	argv = append(argv, "env")
	for e in set {
		argv = append(argv, e)
	}
	argv = append(argv, exe)
	for a in args {
		argv = append(argv, a)
	}
	let o = Exec(argv, Root(), seconds)
	mut peak = -1
	mut errText = ""
	for line in Lines(o.Stderr) {
		let words = twine.Fields(line)
		if linux && len(words) == 2 && words[0] == "PEAK" {
			peak = Num(words[1]) * 1024
		} else if !linux && len(words) >= 4 && words[1] == "maximum" && words[2] == "resident" {
			peak = Num(words[0])
		} else {
			errText += line + "\n"
		}
	}
	return o.Code, o.Stdout, peak, errText
}
