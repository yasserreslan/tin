package main

import "./ci"
import "dice"
import "mint"
import "say"
import "twine"

// Compare the io helpers with Go's io.
//
// A generated corpus of chunk patterns (a fixed seed, so both sides see the same cases) is fed to bench/ref/io and
// tools/ci/fixtures/io.tin; both read the same deterministic byte sequence through a reader that returns it in the given chunk sizes
// and print one line per case: ReadAll and Copy with several buffer sizes, LimitReader, ReadFull, ReadAtLeast, CopyN and TeeReader.
// The check compares the lines.

const SEED = 736
const CASES = 4000

fn spec(chunks []i64) str {
	mut parts = []str{}
	for c in chunks {
		parts = append(parts, mint.Itoa(c))
	}
	return twine.Join(parts, ",")
}

fn sum(chunks []i64) i64 {
	mut n = 0
	for c in chunks {
		n += c
	}
	return n
}

// distinct are the values once each, in order.
fn distinct(values []i64) []i64 {
	mut out = []i64{}
	for v in values {
		mut seen = false
		for o in out {
			if o == v {
				seen = true
			}
		}
		if !seen {
			out = append(out, v)
		}
	}
	return out
}

fn corpus() []str {
	let rng = dice.New(SEED)
	mut lines = []str{}
	mut patterns = [][]i64{[]i64{1}, []i64{2}, []i64{3}, []i64{1, 1}, []i64{1, 1, 1}, []i64{4, 1, 3}, []i64{8}, []i64{1, 7}, []i64{5, 5, 5}, []i64{1, 2, 3, 4, 5, 6, 7, 8}, []i64{9, 1, 1, 1}, []i64{2, 3, 5, 7, 11}}
	for len(patterns) < CASES / 4 {
		let n = rng.Range(1, 7)
		mut chunks = []i64{}
		for i in 0..n {
			chunks = append(chunks, rng.Range(1, 9))
		}
		patterns = append(patterns, chunks)
	}
	for chunks in patterns {
		let s = spec(chunks)
		let total = sum(chunks)
		lines = append(lines, "R " + s)
		for k in distinct([]i64{0, 1, total / 2, total, total + 5}) {
			lines = append(lines, "L " + s + " " + mint.Itoa(k))
		}
		for k in distinct([]i64{0, 1, total / 2, total, total + 3}) {
			lines = append(lines, "F " + s + " " + mint.Itoa(k))
			lines = append(lines, "N " + s + " " + mint.Itoa(k))
		}
		lines = append(lines, "T " + s)
	}
	return lines
}

fn run(exe str, data str) []str {
	let o = ci.ExecIn([]str{exe}, ci.Root(), 600, data, []str{})
	ci.Must(o, exe)
	return ci.Lines(o.Stdout)
}

fn main() {
	let lines = corpus()
	let data = twine.Join(lines, "\n") + "\n"
	let directory = ci.Join(ci.Root(), "bin/ci/io")
	ci.Mkdirs(directory)
	let work = ci.TempDir(directory, "io-")
	let tin = ci.Join(work, "io-tin")
	ci.BuildTin("tools/ci/fixtures/io.tin", tin, "", []str{})
	let goexe = ci.Join(work, "io-go")
	ci.Must(ci.Exec([]str{"go", "build", "-o", goexe, "./bench/ref/io"}, ci.Root(), 300), "go build io")
	let want = run(goexe, data)
	let got = run(tin, data)
	ci.Check(len(got) == len(want), "io: " + mint.Itoa(len(got)) + " lines against Go's " + mint.Itoa(len(want)))
	mut bad = 0
	for i in 0..len(want) {
		if want[i] != got[i] {
			mut source = "?"
			if i < len(lines) {
				source = lines[i]
			}
			say.Line("line " + mint.Itoa(i + 1) + " (corpus line " + source + "):")
			say.Line("  Go:  " + want[i])
			say.Line("  Tin: " + got[i])
			bad += 1
			if bad >= 10 {
				break
			}
		}
	}
	ci.Check(bad == 0, "io: " + mint.Itoa(bad) + " of " + mint.Itoa(len(want)) + " lines differ")
	ci.Remove(work)
	ci.Pass("io: " + mint.Itoa(len(want)) + " lines (" + mint.Itoa(len(lines)) + " corpus cases) match Go's io")
}
