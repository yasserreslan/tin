// A reader of the DWARF the compiler writes with -g, in an ELF or Mach-O file: the sections are found, the line program is run and the
// debugging entries of the one compilation unit are decoded (#409 macOS, #370 Linux).
package dwarf

import "say"

fn le(d str, at i64, n i64) i64 {
	mut v = i64(0)
	for i in 0..n {
		v = v | (i64(d[at + i]) << (8 * i))
	}
	return v
}

// Section is a named section of the file's DWARF.
type Sections struct {
	Names []str
	Data []str
}

// Get is the bytes of a section and whether there is one.
fn (s Sections) Get(name str) (str, bool) {
	for i in 0..len(s.Names) {
		if s.Names[i] == name {
			return s.Data[i], true
		}
	}
	return "", false
}

fn cstring(d str, at i64) str {
	mut end = at
	for d[end] != 0 {
		end += 1
	}
	return d[at:end]
}

// SectionsOf finds the DWARF sections of an ELF or Mach-O file.
fn SectionsOf(data str) !Sections {
	mut names = []str{}
	mut bodies = []str{}
	if data[0:4] == "\x7fELF" {
		let shoff = le(data, 0x28, 8)
		let shentsize = le(data, 0x3a, 2)
		let shnum = le(data, 0x3c, 2)
		let shstrndx = le(data, 0x3e, 2)
		let strtab = le(data, shoff + shstrndx * shentsize + 24, 8)
		for i in 0..shnum {
			let h = shoff + i * shentsize
			let name = cstring(data, strtab + le(data, h, 4))
			if twine_hasPrefix(name, ".debug_") {
				let off = le(data, h + 24, 8)
				let size = le(data, h + 32, 8)
				names = append(names, name)
				bodies = append(bodies, data[off:off + size])
			}
		}
		return Sections{Names: names, Data: bodies}
	}
	if le(data, 0, 4) != 0xfeedfacf {
		fail say.Fault("%s", "neither ELF nor Mach-O")
	}
	let ncmds = le(data, 16, 4)
	mut at = 32
	for c in 0..ncmds {
		let cmd = le(data, at, 4)
		let size = le(data, at + 4, 4)
		if cmd == 0x19 {
			let nsects = le(data, at + 64, 4)
			for k in 0..nsects {
				let sect = at + 72 + 80 * k
				let name = trimNul(data[sect:sect + 16])
				let seg = trimNul(data[sect + 16:sect + 32])
				let sz = le(data, sect + 40, 8)
				let off = le(data, sect + 48, 4)
				if seg == "__DWARF" {
					names = append(names, "." + name[2:])
					bodies = append(bodies, data[off:off + sz])
				}
			}
		}
		at += size
	}
	return Sections{Names: names, Data: bodies}
}

fn twine_hasPrefix(s str, p str) bool {
	return len(s) >= len(p) && s[0:len(p)] == p
}

fn trimNul(s str) str {
	mut end = len(s)
	for end > 0 && s[end - 1] == 0 {
		end -= 1
	}
	return s[0:end]
}

// uleb reads an unsigned LEB128 number at i: the value and the next index.
fn uleb(b str, start i64) (i64, i64) {
	mut v = i64(0)
	mut shift = i64(0)
	mut i = start
	for {
		let c = i64(b[i])
		i += 1
		v = v | ((c & 127) << shift)
		shift += 7
		if c < 128 {
			return v, i
		}
	}
	return v, i
}

// sleb reads a signed LEB128 number.
fn sleb(b str, start i64) (i64, i64) {
	mut v = i64(0)
	mut shift = i64(0)
	mut i = start
	for {
		let c = i64(b[i])
		i += 1
		v = v | ((c & 127) << shift)
		shift += 7
		if c < 128 {
			if (c & 64) != 0 {
				v -= i64(1) << shift
			}
			return v, i
		}
	}
	return v, i
}

// Row is a row of the line table.
type Row struct {
	Addr i64
	File i64
	Line i64
	Col i64
	End bool
}

// Lines is the files and rows of a DWARF 4 line program.
type Lines struct {
	Files []str
	Rows []Row
}

fn LineRows(sec str) !Lines {
	let length = le(sec, 0, 4)
	let version = le(sec, 4, 2)
	let headerLength = le(sec, 6, 4)
	if version != 4 || 4 + length != len(sec) {
		fail say.Fault("%s", "unexpected line table header")
	}
	let mil = le(sec, 10, 1)
	let lineBase = i64(i8(sec[13]))
	let lineRange = le(sec, 14, 1)
	let opcodeBase = le(sec, 15, 1)
	mut i = 16 + opcodeBase - 1
	mut lens = []i64{}
	for k in 0..opcodeBase - 1 {
		lens = append(lens, i64(sec[16 + k]))
	}
	// include directories
	for sec[i] != 0 {
		i += len(cstring(sec, i)) + 1
	}
	i += 1
	mut files = []str{}
	for sec[i] != 0 {
		let name = cstring(sec, i)
		files = append(files, name)
		i += len(name) + 1
		for k in 0..3 {
			let (_, next) = uleb(sec, i)
			i = next
		}
	}
	i += 1
	if i != 10 + headerLength {
		fail say.Fault("%s", "the line table header ends elsewhere than it says")
	}
	mut rows = []Row{}
	mut addr = i64(0)
	mut file = i64(1)
	mut line = i64(1)
	mut col = i64(0)
	for i < len(sec) {
		let op = i64(sec[i])
		i += 1
		if op >= opcodeBase {
			let adj = op - opcodeBase
			addr += (adj / lineRange) * mil
			line += lineBase + adj % lineRange
			rows = append(rows, Row{Addr: addr, File: file, Line: line, Col: col, End: false})
		} else if op == 0 {
			let (n, next) = uleb(sec, i)
			i = next
			let sub = i64(sec[i])
			if sub == 2 {
				addr = le(sec, i + 1, 8)
			} else if sub == 1 {
				rows = append(rows, Row{Addr: addr, File: file, Line: line, Col: col, End: true})
				addr = 0
				file = 1
				line = 1
				col = 0
			}
			i += n
		} else if op == 1 {
			rows = append(rows, Row{Addr: addr, File: file, Line: line, Col: col, End: false})
		} else if op == 2 {
			let (d, next) = uleb(sec, i)
			i = next
			addr += d * mil
		} else if op == 3 {
			let (d, next) = sleb(sec, i)
			i = next
			line += d
		} else if op == 4 {
			let (f, next) = uleb(sec, i)
			i = next
			file = f
		} else if op == 5 {
			let (c, next) = uleb(sec, i)
			i = next
			col = c
		} else {
			for k in 0..lens[op - 1] {
				let (_, next) = uleb(sec, i)
				i = next
			}
		}
	}
	return Lines{Files: files, Rows: rows}
}

// Die is a debugging information entry: its tag, parent (an offset, -1 at the top), and the attribute values it holds as numbers
// (Nums) and as text or bytes (Strs).
type Die struct {
	At i64
	Tag i64
	Parent i64
	NumKeys []i64
	NumValues []i64
	StrKeys []i64
	StrValues []str
}

fn (d Die) Num(attr i64) (i64, bool) {
	for i in 0..len(d.NumKeys) {
		if d.NumKeys[i] == attr {
			return d.NumValues[i], true
		}
	}
	return 0, false
}

fn (d Die) Str(attr i64) (str, bool) {
	for i in 0..len(d.StrKeys) {
		if d.StrKeys[i] == attr {
			return d.StrValues[i], true
		}
	}
	return "", false
}

// Abbrev is an abbreviation: tag, whether it has children and its (attribute, form) pairs.
type Abbrev struct {
	Code i64
	Tag i64
	Children bool
	Attrs []i64
	Forms []i64
}

fn findAbbrev(table []Abbrev, code i64) Abbrev {
	for a in table {
		if a.Code == code {
			return a
		}
	}
	return Abbrev{Code: code, Tag: 0, Children: false, Attrs: []i64{}, Forms: []i64{}}
}

// Dies decodes the entries of the one compilation unit in order.
fn Dies(info str, abbrev str) ![]Die {
	mut table = []Abbrev{}
	mut i = 0
	for abbrev[i] != 0 {
		let (code, a) = uleb(abbrev, i)
		let (tag, b) = uleb(abbrev, a)
		let children = abbrev[b] != 0
		i = b + 1
		mut attrs = []i64{}
		mut forms = []i64{}
		for {
			let (attr, c) = uleb(abbrev, i)
			let (form, d) = uleb(abbrev, c)
			i = d
			if attr == 0 && form == 0 {
				break
			}
			attrs = append(attrs, attr)
			forms = append(forms, form)
		}
		table = append(table, Abbrev{Code: code, Tag: tag, Children: children, Attrs: attrs, Forms: forms})
	}
	let length = le(info, 0, 4)
	let version = le(info, 4, 2)
	let addrSize = le(info, 10, 1)
	if version != 4 || addrSize != 8 || 4 + length != len(info) {
		fail say.Fault("%s", "unexpected compilation unit header")
	}
	mut pos = 11
	mut out = []Die{}
	mut stack = []i64{}
	for pos < len(info) {
		let at = pos
		let (code, next) = uleb(info, pos)
		pos = next
		if code == 0 {
			stack = stack[0:len(stack) - 1]
			continue
		}
		let ab = findAbbrev(table, code)
		mut numKeys = []i64{}
		mut numValues = []i64{}
		mut strKeys = []i64{}
		mut strValues = []str{}
		for k in 0..len(ab.Attrs) {
			let a = ab.Attrs[k]
			let f = ab.Forms[k]
			if f == 0x08 {
				let s = cstring(info, pos)
				strKeys = append(strKeys, a)
				strValues = append(strValues, s)
				pos += len(s) + 1
			} else if f == 0x05 {
				numKeys = append(numKeys, a)
				numValues = append(numValues, le(info, pos, 2))
				pos += 2
			} else if f == 0x06 || f == 0x17 || f == 0x13 {
				numKeys = append(numKeys, a)
				numValues = append(numValues, le(info, pos, 4))
				pos += 4
			} else if f == 0x01 || f == 0x07 {
				numKeys = append(numKeys, a)
				numValues = append(numValues, le(info, pos, 8))
				pos += 8
			} else if f == 0x0b {
				numKeys = append(numKeys, a)
				numValues = append(numValues, i64(info[pos]))
				pos += 1
			} else if f == 0x18 {
				let (n, after) = uleb(info, pos)
				strKeys = append(strKeys, a)
				strValues = append(strValues, info[after:after + n])
				pos = after + n
			} else if f == 0x19 {
				numKeys = append(numKeys, a)
				numValues = append(numValues, 1)
			} else {
				fail say.Fault("form %d", f)
			}
		}
		mut parent = i64(-1)
		if len(stack) > 0 {
			parent = stack[len(stack) - 1]
		}
		out = append(out, Die{At: at, Tag: ab.Tag, Parent: parent, NumKeys: numKeys, NumValues: numValues, StrKeys: strKeys, StrValues: strValues})
		if ab.Children {
			stack = append(stack, at)
		}
	}
	return out
}

// Find is the entry at an offset.
fn Find(dies []Die, at i64) Die {
	for d in dies {
		if d.At == at {
			return d
		}
	}
	return dies[0]
}

// TypeText is a short text for the type entry at an offset: a base type's name, a pointer as *target, a struct's name.
fn TypeText(dies []Die, at i64) !str {
	let d = Find(dies, at)
	if d.Tag == 0x24 || d.Tag == 0x13 {
		let (name, _) = d.Str(0x03)
		return name
	}
	if d.Tag == 0x0f {
		let (target, _) = d.Num(0x49)
		let inner = try TypeText(dies, target)
		return "*" + inner
	}
	fail say.Fault("type tag %d", d.Tag)
}
