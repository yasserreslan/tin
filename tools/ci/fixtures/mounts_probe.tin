// Appended to a temporary copy of toolchain/std/quarry/quarry.tin by file_io_check.tin (#357).

// ProbeSlowMounts is slowMountsIn: the mount points of slow file systems in mountinfo text.
fn ProbeSlowMounts(text str) []str {
	return slowMountsIn(text)
}

// ProbeUnder is underAny: whether the absolute path p is in one of dirs.
fn ProbeUnder(p str, dirs []str) bool {
	return underAny(p, dirs)
}
