package main

import "say"
import "spawn"
import "fault"
import "quarry"
import "ore"

// The #576 Linux tests: start and wait, exit codes, a missing program, stdin from a file, a
// separate stderr, a working directory, signals, and a task deadline killing the child. They run
// in the Linux containers (tools/ci/spawn_check.py); /bin/sh and cat need debian:bookworm-slim.

// runSh runs sh and returns (code, stdout is "out", stderr is "err").
fn runSh() !(i64, bool, bool) {
	let r = try spawn.Run(spawn.Cmd{Argv: []str{"/bin/sh", "-c", "echo out; echo err >&2; exit 4"},
		Env: spawn.Env.Inherit, Dir: "", Stdin: spawn.Stdio.Inherit, Stdout: spawn.Stdio.Inherit,
		Stderr: spawn.Stdio.Inherit, MaxOutput: 0})
	return r.Code, r.Stdout == "out\n", r.Stderr == "err\n"
}

// runSleep runs a sleeping child through Run, for the deadline test.
fn runSleep() !bool {
	let r = try spawn.Run(spawn.Cmd{Argv: []str{"/bin/sleep", "10"}, Env: spawn.Env.Inherit, Dir: "",
		Stdin: spawn.Stdio.Inherit, Stdout: spawn.Stdio.Inherit, Stderr: spawn.Stdio.Inherit,
		MaxOutput: 0})
	return r.Code == 0
}

fn cmd(argv []str) spawn.Cmd {
	return spawn.Cmd{Argv: argv, Env: spawn.Env.Inherit, Dir: "", Stdin: spawn.Stdio.Inherit, Stdout: spawn.Stdio.Inherit, Stderr: spawn.Stdio.Inherit}
}

fn main() {
	// /bin/echo runs and exits 0.
	mut p = spawn.Start(cmd([]str{"/bin/echo", "hello"})) catch err {
		say.Line("echo start failed", err)
		return
	}
	let code = p.Wait() catch err {
		say.Line("echo wait failed", err)
		return
	}
	say.Line("echo", code)

	// sh -c 'exit 3' exits 3.
	mut q = spawn.Start(cmd([]str{"/bin/sh", "-c", "exit 3"})) catch err {
		say.Line("sh start failed", err)
		return
	}
	let code3 = q.Wait() catch err {
		say.Line("sh wait failed", err)
		return
	}
	say.Line("sh exit", code3)

	// A missing program fails with the path in the message.
	spawn.Start(cmd([]str{"/no/such/tin-program"})) catch err {
		say.Line("missing", err)
	}

	// A working directory changes the child's own directory (pwd prints it).
	mut d = spawn.Start(spawn.Cmd{Argv: []str{"/bin/sh", "-c", "pwd"}, Env: spawn.Env.Inherit, Dir: "/tmp",
		Stdin: spawn.Stdio.Inherit, Stdout: spawn.Stdio.Pipe, Stderr: spawn.Stdio.Inherit, MaxOutput: 0}) catch err {
		say.Line("dir start failed", err)
		return
	}
	let dbuf = make([]u8, 256)
	mut dout = ""
	for {
		let n = d.Read(mut dbuf) catch err {
			say.Line("dir read failed", err)
			-1
		}
		if n <= 0 {
			break
		}
		dout += ore.ToStr(dbuf[0:n])
	}
	let dcode = d.Wait() catch err {
		say.Line("dir wait failed", err)
		i64(-1)
	}
	say.Line("dir", dcode, dout == "/tmp\n" || dout == "/private/tmp\n")

	// A program name is looked up in PATH.
	let path = spawn.LookPath("sh") catch err {
		say.Line("lookpath failed", err)
		return
	}
	say.Line("lookpath", path != "")

	// A task deadline interrupts the wait: the child is killed, reaped and the deadline reported.
	mut w = spawn.Start(cmd([]str{"/bin/sleep", "10"})) catch err {
		say.Line("deadline start failed", err)
		return
	}
	let r = within 100ms {
		try w.Wait()
	} catch err {
		say.Line("deadline", fault.Is(err, fault.DeadlineExceeded))
		i64(-1)
	}
	say.Line("deadline result", r)

	// Two hundred runs in a row leak no descriptors and leave no zombies (each Wait reaps).
	let fdsBefore = fdCount()
	for i in 0..200 {
		mut r2 = spawn.Start(cmd([]str{"/usr/bin/true"})) catch err {
			say.Line("loop start failed", err)
			return
		}
		let c2 = r2.Wait() catch err {
			say.Line("loop wait failed", err)
			return
		}
		if c2 != 0 {
			say.Line("loop exit", c2)
		}
	}
	say.Line("loop fds equal", fdsBefore == fdCount())

	// stdin piped to cat: 1 MiB round trips through the pipe into a file.
	let outPath = "/tmp/tin-spawn-cat.txt"
	mut cp = spawn.Start(spawn.Cmd{Argv: []str{"/bin/cat"}, Env: spawn.Env.Inherit, Dir: "",
		Stdin: spawn.Stdio.Pipe, Stdout: spawn.Stdio.File(outPath), Stderr: spawn.Stdio.Inherit,
		MaxOutput: 0}) catch err {
		say.Line("cat start failed", err)
		return
	}
	let chunk = make([]u8, 65536)
	for i in 0..len(chunk) {
		chunk[i] = u8(65 + i % 26)
	}
	mut written = i64(0)
	mut catErr = false
	for i in 0..16 {
		let n = cp.Write(ore.ToStr(chunk)) catch err {
			say.Line("cat write failed", err)
			catErr = true
			-1
		}
		written += n
	}
	cp.CloseStdin() catch err {
		say.Line("cat close failed", err)
		catErr = true
	}
	let ccode = cp.Wait() catch err {
		say.Line("cat wait failed", err)
		catErr = true
		i64(-1)
	}
	let back = quarry.ReadFile(outPath) catch _ {
		""
	}
	say.Line("cat", !catErr, ccode, written, len(back) == 16*65536)

	// Streaming: read the child's stdout as it writes, 0 at end of file.
	mut ep = spawn.Start(spawn.Cmd{Argv: []str{"/bin/echo", "streamed"}, Env: spawn.Env.Inherit, Dir: "",
		Stdin: spawn.Stdio.Inherit, Stdout: spawn.Stdio.Pipe, Stderr: spawn.Stdio.Inherit,
		MaxOutput: 0}) catch err {
		say.Line("stream start failed", err)
		return
	}
	let rbuf = make([]u8, 64)
	mut got = ""
	for {
		let n = ep.Read(mut rbuf) catch err {
			say.Line("stream read failed", err)
			-1
		}
		if n <= 0 {
			break
		}
		got += ore.ToStr(rbuf[0:n])
	}
	let ecode = ep.Wait() catch err {
		say.Line("stream wait failed", err)
		i64(-1)
	}
	say.Line("stream", got == "streamed\n", ecode)

	// Run collects stdout and stderr separately; a non-zero exit is not a fault.
	let (rc, rout, rerr) = runSh() catch err {
		say.Line("run failed", err)
		return
	}
	say.Line("run", rc, rout, rerr)

	// More output than maxOutput fails with fault.LimitExceeded and the child is killed.
	spawn.Run(spawn.Cmd{Argv: []str{"/bin/sh", "-c", "cat /dev/zero"}, Env: spawn.Env.Inherit, Dir: "",
		Stdin: spawn.Stdio.Inherit, Stdout: spawn.Stdio.Inherit, Stderr: spawn.Stdio.Inherit,
		MaxOutput: 1000}) catch err {
		say.Line("limit", fault.Is(err, fault.LimitExceeded))
	}

	// A deadline inside Run kills the child, reaps it and reports the deadline.
	let dr = within 100ms {
		try runSleep()
	} catch err {
		say.Line("run deadline", fault.Is(err, fault.DeadlineExceeded))
		false
	}
	say.Line("run deadline result", dr)

	// Signal: a sleeping child is killed and Wait reports -1.
	mut s = spawn.Start(cmd([]str{"/bin/sleep", "10"})) catch err {
		say.Line("sleep start failed", err)
		return
	}
	s.Kill() catch err {
		say.Line("kill failed", err)
		return
	}
	let killed = s.Wait() catch err {
		say.Line("sleep wait failed", err)
		return
	}
	say.Line("killed", killed)
}

// fdCount is the number of open descriptors: /proc/self/fd on Linux, /dev/fd on macOS.
fn fdCount() i64 {
	mut names = quarry.ReadDir("/proc/self/fd") catch _ {
		[]str{}
	}
	if len(names) == 0 {
		names = quarry.ReadDir("/dev/fd") catch _ {
			[]str{}
		}
	}
	return len(names)
}
