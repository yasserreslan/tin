package main

import "anvil"
import "lane"
import "say"
import "tide"

fn fetch(i i64, failAt i64, ms i64) !str {
	if i == failAt {
		fail "child {i} failed"
	}
	try tide.Wait(ms * tide.Millisecond)
	return "p{i}"
}

// fetchAll gives the pages and the most children that were waiting at once in this request.
fn fetchAll(n i64, failAt i64, ms i64) !str {
	let pages = make([]str, n)
	mut waiting i64 = 0
	mut most i64 = 0
	scope s {
		for i in 0..n {
			let k = i
			s.spawn(fn() ! {
				waiting += 1
				if waiting > most {
					most = waiting
				}
				pages[k] = try fetch(k, failAt, ms)
				waiting -= 1
			})
		}
	}
	return "{pages} {most} at once"
}

// all runs 4 children that each wait 100 ms: all 4 are waiting at once.
fn all(q anvil.Req, w mut anvil.Out) {
	let got = fetchAll(4, -1, 100) catch err {
		w.Status(500)
		w.Text("fault: {err}")
		return
	}
	w.Text(got)
}

// fails has one child fail at once: the others are cancelled instead of waiting 5 s.
fn fails(q anvil.Req, w mut anvil.Out) {
	let got = fetchAll(4, 2, 5000) catch err {
		w.Text("fault: {err}")
		return
	}
	w.Text("never {got}")
}

mut flushed str = ""

fn record(s str) {
	flushed = keep(flushed + s + ";")
}

// later detaches work that outlives the request: it captures the request's path and runs
// after the response, on the core's event loop. The path is request memory, so the block
// reads it only inside keep() (a detached block may not capture request memory as is).
fn later(q anvil.Req, w mut anvil.Out) {
	let path = q.Path
	detach {
		try tide.Wait(20 * tide.Millisecond)
		record(keep(path))
	}
	w.Text("detached")
}

// failing detaches work that fails: the fault is logged and the server goes on.
fn failing(q anvil.Req, w mut anvil.Out) {
	detach {
		fail "background work failed"
	}
	w.Text("detached")
}

fn seen(q anvil.Req, w mut anvil.Out) {
	w.Text(flushed)
}

fn pick() !str {
	mut jobs = lane.New[str](1)
	mut got str = ""
	scope s {
		s.spawn(fn() ! {
			try tide.Wait(10 * tide.Millisecond)
			try jobs.Send("job")
		})
		select {
			let j = jobs.Recv() => { got = j }
			after(tide.Second) => { got = "timeout" }
		}
	}
	return got
}

// picked runs a select inside the request: the child's value wins over the 1 s timer.
fn picked(q anvil.Req, w mut anvil.Out) {
	let got = pick() catch err {
		w.Text("fault: {err}")
		return
	}
	w.Text(got)
}

fn main() {
	mut r = anvil.NewRouter()
	r.Get("/all", all)
	r.Get("/fail", fails)
	r.Get("/later/one", later)
	r.Get("/later/two", later)
	r.Get("/failing", failing)
	r.Get("/seen", seen)
	r.Get("/select", picked)
	let err = r.Serve(":0")
	say.Line(err)
}
