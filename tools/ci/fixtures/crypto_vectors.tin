// Runs the seal primitives over test vectors, one per input line (tools/ci/crypto_check.py):
// "OP ARG..." (seal/open take KIND KEY NONCE AAD DATA) with byte arguments in hex ("-" for empty), printing one line per input: the
// result in hex, "fault" or "ok"/"bad".
package main

import "mint"
import "quarry"
import "say"
import "seal"
import "twine"

fn hx(s str) []u8 {
	if s == "-" {
		return []u8{}
	}
	let (b, err) = seal.HexDecode(s)
	if err != nil {
		panic("crypto_vectors: bad hex")
	}
	return b
}

fn hash(name str) seal.Hash {
	if name == "sha384" {
		return seal.Hash.SHA384
	}
	if name == "sha512" {
		return seal.Hash.SHA512
	}
	return seal.Hash.SHA256
}

fn num(s str) i64 {
	let (n, err) = mint.Atoi(s)
	if err != nil {
		panic("crypto_vectors: bad number")
	}
	return n
}

fn aead(kind str, key []u8) !seal.AEAD {
	if kind == "chacha" {
		return try seal.NewChaCha20Poly1305(key)
	}
	if kind == "aes" {
		return try seal.NewAESGCM(key)
	}
	fail "unknown AEAD"
}

fn run(f []str) str {
	match f[0] {
		"sha" => {
			return seal.Hex(seal.Sum(hash(f[1]), str(hx(f[2]))))
		}
		"hmac" => {
			return seal.Hex(seal.Hmac(hash(f[1]), str(hx(f[2])), str(hx(f[3]))))
		}
		"hkdf" => {
			let prk = seal.HkdfExtract(hash(f[1]), str(hx(f[3])), str(hx(f[2])))
			let okm = seal.HkdfExpand(hash(f[1]), str(prk), str(hx(f[4])), num(f[5])) catch _ {
				return "fault"
			}
			return seal.Hex(okm)
		}
		"p256ecdh" => {
			mut shared_ = seal.P256ECDH(hx(f[1]), hx(f[2])) catch _ {
				return "fault"
			}
			return seal.Hex(shared_)
		}
		"x25519" => {
			let shared_ = seal.X25519(hx(f[1]), hx(f[2])) catch _ {
				return "fault"
			}
			return seal.Hex(shared_)
		}
		"seal", "open", "sealto" => {
			let a = aead(f[1], hx(f[2])) catch _ {
				return "fault"
			}
			if f[0] == "sealto" {
				// AEAD.SealTo through crypto_check's probe in its private lib/seal.
				let out = seal.ProbeSealTo(a, hx(f[3]), hx(f[5]), hx(f[4])) catch _ {
					return "fault"
				}
				return out
			}
			if f[0] == "seal" {
				let out = a.Seal(hx(f[3]), hx(f[5]), hx(f[4])) catch _ {
					return "fault"
				}
				return seal.Hex(out)
			}
			let out = a.Open(hx(f[3]), hx(f[5]), hx(f[4])) catch _ {
				return "fault"
			}
			return seal.Hex(out)
		}
	}
	panic("crypto_vectors: unknown op")
}

fn main() {
	let input = quarry.ReadStdin() catch e {
		say.Line("stdin:", e)
		return
	}
	for _, line in twine.Split(input, "\n") {
		if line == "" {
			continue
		}
		say.Line(run(twine.Fields(line)))
	}
}
