package main
import "anvil"
import "memoryprobe"
import "say"
fn handle(q anvil.Req, w mut anvil.Out) {
	if q.Path == "/heavy" { w.Text(memoryprobe.Heavy()) } else if q.Path == "/release" { memoryprobe.Release()
		w.Text("released") } else { w.Text(say.Fmt("%d %d", memoryprobe.Active(), memoryprobe.Cached())) }
}
fn main() { anvil.Serve(":9180", handle) catch err { panic(err) } }
