// Command tide_zones runs the zone corpus bench/ref/tide writes: for every case in zones.in it
// prints tide's In and DateIn result in Go's format, and tools/ci/helpers_check.tin compares the
// output with expected.txt line by line (#573).
package main

import "say"
import "fault"
import "mint"
import "twine"
import "quarry"
import "tide"

// hexVal returns the value of a hex digit.
fn hexVal(c u8) i64 {
	if c >= '0' && c <= '9' {
		return i64(c) - '0'
	}
	if c >= 'a' && c <= 'f' {
		return i64(c) - 'a' + 10
	}
	return 0
}

// unhex decodes a lowercase hex string.
fn unhex(s str) str {
	mut b = make([]u8, 0, len(s)/2)
	mut i = 0
	for i+1 < len(s) {
		b = append(b, u8(hexVal(s[i])*16+hexVal(s[i+1])))
		i += 2
	}
	return str(b)
}

// num parses a corpus field (the format is generated, so a bad field is a corpus bug).
fn num(s str) i64 {
	let (v, err) = mint.Atoi(s)
	if err != nil {
		return 0
	}
	return v
}

fn main() {
	let (text, err) = quarry.ReadFile(quarry.Args()[1])
	if err != nil {
		say.Line("read fault", err)
		return
	}
	mut z = tide.UTCZone()
	mut layouts = make([]str, 0, 32)
	for line in twine.Split(text, "\n") {
		if len(line) == 0 {
			continue
		}
		let p = twine.Split(line, " ")
		if p[0] == "ZONE" {
			let (zz, lerr) = tide.LoadZone(p[1])
			if lerr != nil {
				say.Line("zone", p[1], "fault")
				z = tide.UTCZone()
			} else {
				say.Line("zone", p[1])
				z = zz
			}
		} else if p[0] == "IN" {
			let sec = num(p[1])
			let c = tide.In(sec*1000000000, z)
			say.Line("in", z.Name(), sec, c.Year, c.Month, c.Day, c.Hour, c.Min, c.Sec, c.Offset, c.Zone)
		} else if p[0] == "LAYOUT" {
			layouts = append(layouts, unhex(p[2]))
		} else if p[0] == "FMT" {
			let sec = num(p[1])
			let nano = num(p[2])
			let idx = num(p[3])
			say.Line("fmt", z.Name(), sec, nano, idx, tide.Format(sec*1000000000+nano, z, layouts[idx]))
		} else if p[0] == "PARSE" {
			let sec = num(p[1])
			let nano = num(p[2])
			let idx = num(p[3])
			let text = tide.Format(sec*1000000000+nano, z, layouts[idx])
			let (ns, perr) = tide.Parse(layouts[idx], text, z)
			mut res = "err"
			if perr == nil {
				res = say.Fmt("%d", ns)
			} else if fault.Message(perr) != "" && twine.Contains(fault.Message(perr), "outside the range of Unix nanoseconds") {
				res = "out"
			}
			say.Line("parse", z.Name(), sec, nano, idx, res)
		} else if p[0] == "PARSEBAD" {
			let sec = num(p[1])
			let nano = num(p[2])
			let idx = num(p[3])
			let v = num(p[4])
			mut text = tide.Format(sec*1000000000+nano, z, layouts[idx])
			if v == 0 {
				if len(text) > 0 {
					text = text[0:len(text)-1]
				}
			} else if v == 1 {
				text = "!" + text
			} else {
				text = text + "!"
			}
			let (ns, perr) = tide.Parse(layouts[idx], text, z)
			mut res = "err"
			if perr == nil {
				res = say.Fmt("%d", ns)
			} else if twine.Contains(fault.Message(perr), "outside the range of Unix nanoseconds") {
				res = "out"
			}
			say.Line("parsebad", z.Name(), sec, nano, idx, v, res)
		} else if p[0] == "ADDDATE" {
			let sec = num(p[1])
			say.Line("adddate", z.Name(), sec, num(p[2]), num(p[3]), num(p[4]), tide.AddDate(sec*1000000000, z, num(p[2]), num(p[3]), num(p[4])))
		} else if p[0] == "TRUNC" {
			let sec = num(p[1])
			say.Line("trunc", z.Name(), sec, num(p[2]), tide.Truncate(sec*1000000000, num(p[2])))
		} else if p[0] == "ROUND" {
			let sec = num(p[1])
			say.Line("round", z.Name(), sec, num(p[2]), tide.Round(sec*1000000000, num(p[2])))
		} else if p[0] == "ISOWEEK" {
			let sec = num(p[1])
			let (iy, iw) = tide.ISOWeek(tide.In(sec*1000000000, z))
			say.Line("isoweek", z.Name(), sec, iy, iw)
		} else if p[0] == "DATE" {
			let ns = tide.DateIn(num(p[1]), num(p[2]), num(p[3]), num(p[4]), num(p[5]), num(p[6]), num(p[7]), z)
			say.Line("date", z.Name(), num(p[1]), num(p[2]), num(p[3]), num(p[4]), num(p[5]), num(p[6]), num(p[7]), ns)
		}
	}
}
