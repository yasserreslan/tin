package main

import "anvil"
import "fault"
import "quarry"
import "replayserve"
import "tide"
import "twine"

// A checkout service for replay_check.py (#242): it reads the cart, then charges the payment
// service; a failed charge is a 500. CHECKOUT_SWAP=1 charges before reading the cart; ?wait=1
// waits first (the request task parks and resumes), ?panic=1 panics after the charge.
// /who answers the request's RemoteAddr and ClientIP (#355); TRUST lists the trusted proxy
// networks, comma-separated.

fn cart(id str) !str {
	return try replayserve.Effect("redis@1", "GET cart:" + id)
}

fn charge(items str) !str {
	return try replayserve.Effect("wire.http@1", "POST http://payments/charge\n\ncart=" + items)
}

fn checkout(q anvil.Req, w mut anvil.Out) {
	let id = q.PathParam("id")
	mut items = ""
	if q.Param("wait") == "1" {
		let err = tide.Wait(20000000)
		if err != nil {
			w.Status(503)
			return
		}
	}
	if quarry.Getenv("CHECKOUT_SWAP") != "1" {
		items = cart(id) catch err {
			w.Status(502)
			w.Text("cart: " + fault.Message(err) + "\n")
			return
		}
	}
	let paid = charge(items) catch err {
		w.Status(500)
		if fault.Is(err, fault.DeadlineExceeded) {
			w.Status(504)
		}
		w.Text("charge failed: " + fault.Message(err) + " (live calls {replayserve.LiveCalls()})\n")
		return
	}
	if q.Param("panic") == "1" {
		panic("checkout: paid " + paid)
	}
	w.Text("paid: " + paid + " for " + items + " (live calls {replayserve.LiveCalls()})\n")
}

fn who(q anvil.Req, w mut anvil.Out) {
	w.Text("peer {q.RemoteAddr()} client {q.ClientIP()}\n")
}

fn main() {
	let trust = quarry.Getenv("TRUST")
	if len(trust) > 0 {
		anvil.TrustedProxies(twine.Split(trust, ",")) catch err {
			panic(fault.Message(err))
		}
	}
	let r = anvil.NewRouter()
	r.Post(`/checkout/{id}`, checkout)
	r.Get("/who", who)
	let err = r.Serve(":8080")
	if err != nil {
		panic(fault.Message(err))
	}
}
