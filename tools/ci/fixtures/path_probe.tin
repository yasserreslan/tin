package main

// The compiler host path helper is also exercised directly, beyond /proc/self/exe. The check copies
// this file into a tree's selfhost/ so it may call the compiler's own host functions (trusted code).
fn main() {
	let argc = rtArgc
	let argv = rtArgv
	let out = calloc(4096, 1)
	mut i = 1
	for i < argc {
		if host_realpath(argv[i], out) != 0 {
			rt_sys_write(1, out, strlen(out))
		} else {
			rt_sys_write(1, cast(i64, "<nil>") + 8, 5)
		}
		rt_sys_write(1, cast(i64, "\n") + 8, 1)
		i = i + 1
	}
	free(out)
	rt_sys_exit(0)
}
