package main

import "quarry"
import "say"
import "tar"

const largeSize = 33554432
// entryCount is the number of file entries tar_oracle.go writes and reads (the global header is not one).
const entryCount = 16

// main exits 1 on a fault itself: a fault returned from main is not reported as a failure.
fn main() {
	let args = quarry.Args()
	if len(args) != 3 {
		say.Line("usage: tar_interop read|write path")
		quarry.Exit(2)
	}
	if args[1] == "read" { readArchive(args[2]) catch err { exitWith(err) } }
	if args[1] == "write" { writeArchive(args[2]) catch err { exitWith(err) } }
}

fn exitWith(err fault) {
	say.Line("tar interop:", say.Str(err))
	quarry.Exit(1)
}

fn readArchive(path str) ! {
	let raw = try quarry.ReadFileBound(path, tar.MaxArchiveSize)
	mut r = try tar.NewReader([]u8(raw), tar.MaxArchiveSize)
	mut index = i64(0)
	for {
		let h = try r.Next()
		if h == nil { break }
		say.Line(say.Fmt("%s %o %d %d %d %d %d %d %q %q %q %d %d", h.Name, h.Mode, h.Uid, h.Gid, h.Size, flagByte(h.Type), h.Mtime, h.MtimeNsec, h.Linkname, h.Uname, h.Gname, h.Devmajor, h.Devminor))
		mut remain = h.Size
		mut buf = make([]u8, 65536)
		mut offset = i64(0)
		for remain > 0 {
			let n = try r.Read(mut buf)
			if n == 0 { fail "tar interop: early payload end" }
			for i in 0..n {
				mut expected = u8(0)
				if h.Name == "regular.txt" { expected = "hello"[offset+i] } else { expected = "0123456789abcdef\n"[(offset+i)%17] }
				if buf[i] != expected { fail "tar interop: payload mismatch" }
			}
			offset += n
			remain -= n
		}
		index += 1
	}
	if index != entryCount { fail "tar interop: wrong entry count" }
	return
}

fn writeArchive(path str) ! {
	mut w = tar.NewWriter()
	try w.WriteHeader(tar.Header{Name: "regular.txt", Mode: 0o640, Uid: 12, Gid: 34, Size: 5, Mtime: 1700000000, MtimeNsec: 0, Type: tar.TypeFlag.Regular, Linkname: "", Uname: "user", Gname: "group"})
	try w.Write([]u8("hello"))
	try w.WriteHeader(tar.Header{Name: "dir/", Mode: 0o755, Uid: 1, Gid: 2, Size: 0, Mtime: 0, MtimeNsec: 0, Type: tar.TypeFlag.Directory, Linkname: ""})
	try w.WriteHeader(tar.Header{Name: "sym", Mode: 0o777, Uid: 0, Gid: 0, Size: 0, Mtime: 0, MtimeNsec: 0, Type: tar.TypeFlag.Symlink, Linkname: "target"})
	try w.WriteHeader(tar.Header{Name: "hard", Mode: 0o644, Uid: 0, Gid: 0, Size: 0, Mtime: 0, MtimeNsec: 0, Type: tar.TypeFlag.HardLink, Linkname: "regular.txt"})
	try w.WriteHeader(tar.Header{Name: "fifo", Mode: 0o600, Uid: 0, Gid: 0, Size: 0, Mtime: 0, MtimeNsec: 0, Type: tar.TypeFlag.Fifo, Linkname: ""})
	try w.WriteHeader(tar.Header{Name: "device-char", Mode: 0o600, Uid: 0, Gid: 0, Size: 0, Mtime: 0, MtimeNsec: 0, Type: tar.TypeFlag.Character, Linkname: "", Devmajor: 8, Devminor: 1})
	try w.WriteHeader(tar.Header{Name: "device-block", Mode: 0o600, Uid: 0, Gid: 0, Size: 0, Mtime: 0, MtimeNsec: 0, Type: tar.TypeFlag.Block, Linkname: "", Devmajor: 8, Devminor: 2})
	try w.WriteHeader(tar.Header{Name: repeat("p", 155) + "/" + repeat("n", 100), Mode: 0o600, Uid: 3, Gid: 4, Size: 0, Mtime: 0, MtimeNsec: 0, Type: tar.TypeFlag.Regular, Linkname: ""})
	try w.WriteHeader(tar.Header{Name: repeat("a", 150), Mode: 0o600, Uid: 5, Gid: 6, Size: 0, Mtime: 0, MtimeNsec: 0, Type: tar.TypeFlag.Regular, Linkname: ""})
	try w.WriteHeader(tar.Header{Name: "pax-link", Mode: 0o777, Uid: 0, Gid: 0, Size: 0, Mtime: 0, MtimeNsec: 0, Type: tar.TypeFlag.Symlink, Linkname: repeat("l", 130)})
	try w.WriteHeader(tar.Header{Name: "pax-owner", Mode: 0o600, Uid: 2097152, Gid: 2097153, Size: 0, Mtime: 0, MtimeNsec: 0, Type: tar.TypeFlag.Regular, Linkname: "", Uname: repeat("u", 40), Gname: repeat("g", 33)})
	try w.WriteHeader(tar.Header{Name: "pax-mtime", Mode: 0o600, Uid: 0, Gid: 0, Size: 0, Mtime: 1700000001, MtimeNsec: 500000000, Type: tar.TypeFlag.Regular, Linkname: ""})
	try w.WriteHeader(tar.Header{Name: "pax-mtime-nano", Mode: 0o600, Uid: 0, Gid: 0, Size: 0, Mtime: 1700000002, MtimeNsec: 123456789, Type: tar.TypeFlag.Regular, Linkname: ""})
	try w.WriteHeader(tar.Header{Name: repeat("n", 150), Mode: 0o600, Uid: 0, Gid: 0, Size: 0, Mtime: 0, MtimeNsec: 0, Type: tar.TypeFlag.Regular, Linkname: ""})
	try w.WriteHeader(tar.Header{Name: "gnu-link", Mode: 0o777, Uid: 0, Gid: 0, Size: 0, Mtime: 0, MtimeNsec: 0, Type: tar.TypeFlag.Symlink, Linkname: repeat("m", 150)})
	try w.WriteHeader(tar.Header{Name: "large.bin", Mode: 0o600, Uid: 0, Gid: 0, Size: largeSize, Mtime: 0, MtimeNsec: 0, Type: tar.TypeFlag.Regular, Linkname: ""})
	let chunk = []u8("0123456789abcdef\n")
	mut left = largeSize
	for left > 0 {
		let n = min(left, 65536)
		mut buf = make([]u8, n)
		let offset = largeSize - left
		for i in 0..n { buf[i] = chunk[(offset + i) % 17] }
		try w.Write(buf)
		left -= n
	}
	try w.Close()
	let archive = try w.Bytes()
	try quarry.WriteFile(path, str(archive))
	return
}

fn repeat(c str, n i64) str {
	mut b = make([]u8, n)
	for i in 0..n { b[i] = u8(c[0]) }
	return str(b)
}

fn flagByte(t tar.TypeFlag) i64 {
	return match t {
		tar.TypeFlag.Regular => i64('0')
		tar.TypeFlag.Directory => i64('5')
		tar.TypeFlag.Symlink => i64('2')
		tar.TypeFlag.HardLink => i64('1')
		tar.TypeFlag.Fifo => i64('6')
		tar.TypeFlag.Character => i64('3')
		tar.TypeFlag.Block => i64('4')
		tar.TypeFlag.PAX => i64('x')
		tar.TypeFlag.GNULongName => i64('L')
		tar.TypeFlag.GNULongLink => i64('K')
	}
}
