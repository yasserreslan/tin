package main
import "anvil"
import "wire"
import "mint"
import "say"

fn resolve(q anvil.Req, w mut anvil.Out) {
	let timeout = mint.Atoi(q.Param("timeout")) catch _ { 0 }
	let (answer, err) = wire.ProbeResolve(q.Param("name"), timeout*1000000)
	if err != nil {
		if say.Str(err) == "deadline exceeded" { w.Status(504) } else { w.Status(502) }
		w.Text(say.Str(err))
		return
	}
	w.Text(answer)
}
fn health(q anvil.Req, w mut anvil.Out) { w.Text("healthy") }
fn main() {
	let r = anvil.NewRouter()
	r.Get("/resolve", resolve)
	r.Get("/health", health)
	r.Serve(":0") catch err { panic(err) }
}
