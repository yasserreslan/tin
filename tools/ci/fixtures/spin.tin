// #341: a handler that never waits holds its core. /spin loops for ever, /ok answers, /stuck gives
// anvil.StuckCores and anvil.StuckFor; wedge_check.py runs it.
package main

import "anvil"
import "quarry"
import "say"

fn spin(q anvil.Req, w mut anvil.Out) {
	mut x i64 = 0
	for {
		x += 1
		if x < 0 {
			break
		}
	}
	w.Text("spun")
}

fn ok(q anvil.Req, w mut anvil.Out) {
	w.Text("ok")
}

fn stuck(q anvil.Req, w mut anvil.Out) {
	w.Text("{anvil.StuckCores()} {anvil.StuckFor()}")
}

fn main() {
	let r = anvil.NewRouter()
	r.Get("/spin", spin)
	r.Get("/ok", ok)
	r.Get("/stuck", stuck)
	say.Line(r.Serve(":" + quarry.Getenv("PORT")))
}
