package main

import "anvil"
import "quarry"
import "say"
import "tide"
import "websocket"

mut saved str

fn delayed(s str, ms i64) str {
	tide.Wait(ms * 1ms) catch _ { return "timeout" }
	return s
}

fn echo(ws websocket.Conn, m websocket.Message) ! {
	websocket.ProbeScopeResource()
	if websocket.ProbePoolUsed() > len(m.Data)*2+65536 {
		panic("message allocations accumulated")
	}
	if m.Text && m.Data == "fault" {
		fail "callback stopped"
	}
	if m.Text && m.Data == "keep" {
		saved = keep(m.Data)
	}
	if m.Text && m.Data == "wait" {
		try tide.Wait(5ms)
	}
	if m.Text {
		try ws.WriteText(m.Data)
	} else {
		try ws.WriteBinary([]u8(m.Data))
	}
}

fn handle(q anvil.Req, w mut anvil.Out) {
	if q.Path == "/a" {
		w.Text(say.Fmt("A:%s", delayed(q.Path, 100)))
		return
	}
	if q.Path == "/b" {
		w.Text(say.Fmt("B:%s", delayed(q.Path, 300)))
		return
	}
	if q.Path == "/file" || q.Path == "/write" {
		let path = quarry.Getenv("REVIEW_DIR") + "/" + q.Param("name")
		if q.Path == "/file" {
			let data = quarry.ReadFile(path) catch e {
				w.Status(504)
				w.Text(say.Str(e))
				return
			}
			w.Text(data)
		} else {
			let data = q.Param("data")
			quarry.WriteFile(path, "owned:{data}") catch e {
				w.Status(504)
				w.Text(say.Str(e))
				return
			}
			w.Text("written")
		}
		return
	}
	if q.Path == "/ws" || q.Path == "/raw" || q.Path == "/close" {
		let ws = websocket.ProbeAccept(q, mut w) catch _ { return }
		if q.Path == "/close" {
			ws.Close()
			ws.Close()
			let (_, e) = ws.Read()
			if e == nil || !websocket.IsClosed(e) {
				panic("Read after Close did not report closure")
			}
			return
		}
		if q.Path == "/raw" {
			let first = ws.Read() catch _ { return }
			let second = ws.Read() catch _ { return }
			ws.WriteText("{first.Data}|{second.Data}") catch _ {}
			return
		}
		let before = "outer:" + q.Path
		let err = ws.Each(echo)
		if err != nil && !websocket.IsClosed(err) {
			ws.WriteText("{before}|{err}") catch _ {}
		}
		return
	}
	if q.Path == "/log" {
		// #747: a server's say.Line reaches its stdout pipe before the response does.
		say.Line("log", q.Param("n"), "")
		w.Text("logged")
		return
	}
	if q.Path == "/stats" {
		w.Text("{websocket.ProbeClosed()}|{websocket.ProbeBadCleanup()}|{websocket.ProbeHelpers()}|{saved}|{websocket.ProbeScoped()}")
		return
	}
	w.Text("healthy")
}

fn main() {
	let err = anvil.Serve(":0", handle)
	say.Line(err)
}
