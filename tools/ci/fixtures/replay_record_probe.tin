package replayrecord

import "fault"

// Copied into a temporary lib/replayrecord by replay_check.tin: an effect made the way a client
// library makes one (rt_effect around its live call), so anvil's recording (#241) can be checked
// before the clients record.

mut answer str

fn live() !str {
	return answer
}

fn late() !str {
	try fault.Wrap(fault.DeadlineExceeded, "payments")
	return ""
}

// Effect is one effect of kind asking key that gives result: recorded when the request has a tape.
fn Effect(kind str, key str, result str) !str {
	answer = result
	let tp = rt_tape()
	if tp == 0 {
		return try live()
	}
	return try rt_effect(tp, kind, key, live)
}

// Late is an effect that fails with a deadline.
fn Late(key str) !str {
	let tp = rt_tape()
	if tp == 0 {
		return try late()
	}
	return try rt_effect(tp, "wire.http@1", key, late)
}
