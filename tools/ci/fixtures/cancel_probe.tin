// Appended to a temporary copy of lib/tide/tide.tin by cancel_check.py.
let probeBnd = make([]i64, 32)

// ProbeMark remembers the current boundary in slot i.
fn ProbeMark(i i64) {
	probeBnd[i] = rt_bnd_current()
}

// ProbeCancel cancels the boundary in slot i with a heap-owned reason (a fault record, design/interface_faults.md).
fn ProbeCancel(i i64, reason str) {
	rt_bnd_cancel(probeBnd[i], cast(fault, rt_fault_copy(rt_fail(reason), true)))
}

// ProbeEnter enters a block boundary and returns it.
fn ProbeEnter() i64 {
	return rt_bnd_enter(bkWithin)
}

fn ProbeLeave(b i64) {
	rt_bnd_leave(b)
}

fn ProbeCurrent() i64 {
	return rt_bnd_current()
}

// ProbeCanceled is b's cancel reason, or "".
fn ProbeCanceled(b i64) str {
	let r = rt_bnd_canceled(b)
	if r == 0 {
		return ""
	}
	return cast(str, r)
}

// ProbeDeadline sets b's own deadline ms from now.
fn ProbeDeadline(b i64, ms i64) {
	rt_bnd_set_deadline(b, rt_mono_ns()+ms*1000000)
}
