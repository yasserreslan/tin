package main

import "mysql"
import "quarry"
import "redis"
import "replaysecret"
import "say"

// Edition 1: secret values written into queries are sent as themselves, and the replay tape
// keys hold their handles (query.Hidden, design/interface_replay.md 5.3; #241).

let cache = redis.Open(redis.Options{Addr: quarry.Getenv("REDIS_ADDR")})
let db = mysql.Open(mysql.Options{Addr: quarry.Getenv("MYSQL_ADDR"), User: "tin", Password: "tinpass", Database: "tin", Pool: 2})

fn token() secret str {
	return "s3cr3t-token"
}

fn pin() secret i64 {
	return 424242
}

fn work() str {
	let t = token()
	let p = pin()
	let got = cache.Do("GET {t}") catch err {
		return "redis: {err}"
	}
	let rows = db.Query("SELECT id, name FROM users WHERE id = {p}") catch err {
		return "mysql: {err}"
	}
	return say.Fmt("redis %v mysql %d rows", got, len(rows.Rows))
}

fn main() {
	replaysecret.Run(work)
}
