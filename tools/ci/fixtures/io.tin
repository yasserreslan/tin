package main

// The io twin, Tin side: read the corpus of bench/ref/io on stdin and print the same lines, so
// tools/ci/io_check.py can compare the helpers' behaviour with Go's io (#736).
//
// The reader yields the bytes of the same deterministic sequence (byte i is (i*7+3) % 251) in
// the chunk sizes of the corpus line.
//
//	R <chunks>          ReadAll, and Copy into a writer, with buffer sizes 1, 3 and 7
//	L <chunks> <n>      LimitReader(n) then ReadAll
//	F <chunks> <n>      ReadFull(n) and ReadAtLeast(n) results
//	N <chunks> <n>      CopyN(n)
//	T <chunks>          TeeReader into a second writer, ReadAll

import "say"
import "io"
import "mint"
import "quarry"

// chunked is a reader that returns the bytes of the sequence in the given chunk sizes.
type chunked struct {
	chunks []i64
	at     i64
	pos    i64
}

// seqByte is the sequence's byte at i: (i*7+3) % 251, computed before the byte conversion, as
// the Go side does.
fn seqByte(i i64) u8 {
	return u8((i*7 + 3) % 251)
}

// Read fills buf from the current chunk, which shrinks as it is consumed.
fn (c mut chunked) Read(buf mut []u8) !i64 {
	if c.at >= i64(len(c.chunks)) {
		return 0
	}
	mut n = c.chunks[c.at]
	if n > i64(len(buf)) {
		n = i64(len(buf))
	}
	mut i = i64(0)
	for i < n {
		buf[i] = seqByte(c.pos + i)
		i += 1
	}
	c.pos += n
	if n == c.chunks[c.at] {
		c.at += 1
	} else {
		c.chunks[c.at] -= n
	}
	return n
}

// sink is a writer that keeps what it is given.
type sink struct {
	b []u8
}

fn (s mut sink) Write(data []u8) !i64 {
	s.b = append(s.b, data...)
	return i64(len(data))
}

fn main() {
	let body = quarry.ReadStdin() catch err {
		say.Line("fault", err)
		return
	}
	mut start = i64(0)
	mut i = i64(0)
	for i <= i64(len(body)) {
		if i < i64(len(body)) && body[i] != '\n' {
			i += 1
			continue
		}
		let line = body[start:i]
		start = i + 1
		i += 1
		if len(line) == 0 {
			continue
		}
		run(line)
	}
}

// run handles one corpus line.
fn run(line str) {
	let parts = splitSpace(line)
	if len(parts) == 0 {
		return
	}
	let chunks = parseChunks(parts[1])
	if parts[0] == "R" {
		mut r = chunked{chunks: chunks, at: 0, pos: 0}
		let data = io.ReadAll(r) catch err {
			say.Line("R fault", err)
			return
		}
		mut sums = []str{}
		for _, size in []i64{1, 3, 7} {
			mut r2 = chunked{chunks: parseChunks(parts[1]), at: 0, pos: 0}
			mut d = sink{}
			mut buf = make([]u8, size)
			let n = io.CopyBuffer(d, r2, mut buf) catch _ {
				sums = append(sums, "fault")
				continue
			}
			sums = append(sums, say.Fmt("%d/%d", n, len(d.b)))
		}
		say.Line("R", say.Fmt("%d/%d", len(data), checksum([]u8(data))), texts(sums))
	} else if parts[0] == "L" {
		let k = parseInt(parts[2])
		mut r = chunked{chunks: chunks, at: 0, pos: 0}
		let limited = io.LimitReader(r, k)
		let data = io.ReadAll(limited) catch err {
			say.Line("L fault", err)
			return
		}
		say.Line("L", say.Fmt("%d/%d", len(data), checksum([]u8(data))))
	} else if parts[0] == "F" {
		let k = parseInt(parts[2])
		mut r = chunked{chunks: chunks, at: 0, pos: 0}
		mut buf = make([]u8, k)
		let n = io.ReadFull(r, mut buf) catch _ {
			-1
		}
		mut full = "fault"
		if n >= 0 {
			full = say.Fmt("%d/%d", n, checksum(buf[0:n]))
		}
		mut r2 = chunked{chunks: parseChunks(parts[1]), at: 0, pos: 0}
		mut buf2 = make([]u8, k)
		let n2 = io.ReadAtLeast(r2, mut buf2, k) catch _ {
			-1
		}
		mut least = "fault"
		if n2 >= 0 {
			least = say.Fmt("%d/%d", n2, checksum(buf2[0:n2]))
		}
		say.Line("F", full, least)
	} else if parts[0] == "N" {
		let k = parseInt(parts[2])
		mut r = chunked{chunks: chunks, at: 0, pos: 0}
		mut d = sink{}
		let n = io.CopyN(d, r, k) catch _ {
			say.Line("N", say.Fmt("fault/%d", len(d.b)))
			return
		}
		say.Line("N", say.Fmt("%d/%d", n, len(d.b)))
	} else if parts[0] == "T" {
		mut r = chunked{chunks: chunks, at: 0, pos: 0}
		mut tee = sink{}
		let tr = io.NewTeeReader(r, tee)
		let data = io.ReadAll(tr) catch err {
			say.Line("T fault", err)
			return
		}
		say.Line("T", say.Fmt("%d/%d %d/%d", len(data), checksum([]u8(data)), len(tee.b), checksum(tee.b)))
	}
}

// checksum is the same rolling hash as the Go side's.
fn checksum(data []u8) u64 {
	mut h = u64(0)
	for _, b in data {
		h = h*%1000003 +% u64(b)
	}
	return h
}

// texts joins the pieces with spaces.
fn texts(parts []str) str {
	mut out = ""
	for i, p in parts {
		if i > 0 {
			out += " "
		}
		out += p
	}
	return out
}

// splitSpace splits a line on spaces.
fn splitSpace(line str) []str {
	mut out = []str{}
	mut start = i64(0)
	mut i = i64(0)
	for i <= i64(len(line)) {
		if i == i64(len(line)) || line[i] == ' ' {
			if i > start {
				out = append(out, line[start:i])
			}
			start = i + 1
		}
		i += 1
	}
	return out
}

// parseChunks parses the comma-separated chunk sizes.
fn parseChunks(s str) []i64 {
	mut out = []i64{}
	mut start = i64(0)
	mut i = i64(0)
	for i <= i64(len(s)) {
		if i == i64(len(s)) || s[i] == ',' {
			if i > start {
				out = append(out, parseInt(s[start:i]))
			}
			start = i + 1
		}
		i += 1
	}
	return out
}

// parseInt parses a non-negative decimal number.
fn parseInt(s str) i64 {
	let v = mint.Atoi(s) catch _ {
		return 0
	}
	return v
}
