package schedprobe

import "say"
import "tide"

// Copied into a temporary lib/schedprobe by sched_check.py: puts replay tapes
// (lib/runtime/replay.tin, design/interface_replay.md) on the running task, as anvil will for a
// request, and reads back the scheduling events (lib/runtime/sched_replay.tin, #243).

const taskTape = 56 // tTape: the task's replay tape

// Record gives the running task a new recording tape.
fn Record() i64 {
	let tp = rt_tape_new(1)
	rt_task_current()[taskTape] = tp
	return tp
}

// Replay gives the running task a tape that replays the records of tape rec.
fn Replay(rec i64) i64 {
	let rp = rt_tape_new(2)
	rt_tape_load(rp, rec[1], rec[2])
	rt_task_current()[taskTape] = rp
	return rp
}

// Detach takes the running task's tape off it.
fn Detach() {
	rt_task_current()[taskTape] = 0
}

// Free frees tape tp.
fn Free(tp i64) {
	rt_tape_free(tp)
}

// Diverged is tape tp's first divergence, "" if none.
fn Diverged(tp i64) str {
	return rt_tape_diverged(tp)
}

// Left is how many records of replaying tape tp were not served.
fn Left(tp i64) i64 {
	return rt_tape_left(tp)
}

// Events lists tape tp's records as "kind key word" lines.
fn Events(tp i64) []str {
	mut out = make([]str, 0, 4)
	let b = tp[1]
	mut pos = 0
	for pos < tp[2] {
		let kind = tape_field(b, pos+8)
		let key = tape_field(b, pos+16+len(kind))
		let data = tape_data(tp, pos)
		mut line = kind + " " + key
		let at = pos + 24 + len(kind) + len(key)
		if (b + at)[0] != 0 {
			line = line + " fault " + data
		} else if len(data) == 8 {
			line = line + " " + say.Str((cast(i64, data) + 8)[0])
		}
		out = append(out, line)
		pos = tape_skip(tp, pos)
	}
	return out
}

mut curKey str
mut curMs i64

// waited is an effect body: it waits curMs, then gives "v:" and its key.
fn waited() !str {
	let k = curKey
	let ms = curMs
	try tide.Wait(ms * 1ms)
	return "v:" + k
}

// Effect is a test effect (test@1, key key) whose live call waits ms; recorded and replayed
// on the running task's tape like a client's call.
fn Effect(key str, ms i64) !str {
	curKey = key
	curMs = ms
	let tp = rt_tape()
	if tp == 0 {
		return try waited()
	}
	return try rt_effect(tp, "test@1", key, waited)
}

// Strip is a recording tape with the records of tp except the scheduling ones: a tape as a
// build without scheduling replay records it.
fn Strip(tp i64) i64 {
	let out = rt_tape_new(1)
	let b = tp[1]
	mut pos = 0
	for pos < tp[2] {
		let next = tape_skip(tp, pos)
		let kind = tape_field(b, pos+8)
		if len(kind) < 6 || kind[:6] != "sched." {
			tape_room(out, next-pos)
			memcpy(out[1]+out[2], b+pos, next-pos)
			out[2] += next - pos
		}
		pos = next
	}
	return out
}
