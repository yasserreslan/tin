package main

// The cmplx twin, Tin side: read the corpus of bench/ref/cmplx (Go's math/cmplx) on stdin and print the same lines, so
// tools/ci/cmplx_check.tin can compare them (#916). Every float is the hex of its bits, and a NaN prints as "nan".
//
//	<op> <re> <im> [<re2> <im2>]   a complex function of one complex argument (Pow takes two)
//	Rect <r> <theta>               the complex number of modulus r and phase theta
//	Abs|Phase|IsNaN|IsInf|Polar    the real or bool results of one complex argument
//	Inf | NaN                      the constants
//	C64 <re> <im>                  From64, printed as the float32 bits of each part
//	C64SQRT <re> <im>              Sqrt of the widened Complex64, rounded to Complex64 and printed the same way

import "cmplx"
import "gauge"
import "quarry"
import "say"

fn main() {
	let body = quarry.ReadStdin() catch err {
		say.Line("fault", err)
		return
	}
	mut start = i64(0)
	mut i = i64(0)
	for i <= i64(len(body)) {
		if i < i64(len(body)) && body[i] != '\n' {
			i += 1
			continue
		}
		let line = body[start:i]
		start = i + 1
		i += 1
		if len(line) == 0 {
			continue
		}
		run(splitSpace(line))
	}
}

// run handles one corpus line, given its fields.
fn run(f []str) {
	let op = f[0]
	if op == "Inf" {
		say.Line(op, cfmt(cmplx.Inf()))
		return
	}
	if op == "NaN" {
		say.Line(op, cfmt(cmplx.NaN()))
		return
	}
	if op == "Rect" {
		say.Line(op, cfmt(cmplx.Rect(bitsArg(f, 1), bitsArg(f, 2))))
		return
	}
	if op == "C64" || op == "C64SQRT" {
		mut z = cmplx.From64(arg(f, 1))
		if op == "C64SQRT" {
			z = cmplx.From64(cmplx.Sqrt(z.To128()))
		}
		say.Line(op, hex32(z.Re) + " " + hex32(z.Im))
		return
	}
	let z = arg(f, 1)
	if op == "Abs" {
		say.Line(op, hex64(cmplx.Abs(z)))
		return
	}
	if op == "Phase" {
		say.Line(op, hex64(cmplx.Phase(z)))
		return
	}
	if op == "IsNaN" {
		say.Line(op, boolText(cmplx.IsNaN(z)))
		return
	}
	if op == "IsInf" {
		say.Line(op, boolText(cmplx.IsInf(z)))
		return
	}
	if op == "Polar" {
		let (r, t) = cmplx.Polar(z)
		say.Line(op, hex64(r) + " " + hex64(t))
		return
	}
	if op == "Pow" {
		say.Line(op, cfmt(cmplx.Pow(z, arg(f, 3))))
		return
	}
	let (w, ok) = complexOp(op, z)
	if ok {
		say.Line(op, cfmt(w))
	} else {
		say.Line("unknown", op)
	}
}

// complexOp applies the one-argument function named op; ok is false for a name it does not know.
fn complexOp(op str, z cmplx.Complex) (cmplx.Complex, bool) {
	if op == "Sqrt" {
		return cmplx.Sqrt(z), true
	}
	if op == "Exp" {
		return cmplx.Exp(z), true
	}
	if op == "Log" {
		return cmplx.Log(z), true
	}
	if op == "Log10" {
		return cmplx.Log10(z), true
	}
	if op == "Asin" {
		return cmplx.Asin(z), true
	}
	if op == "Acos" {
		return cmplx.Acos(z), true
	}
	if op == "Atan" {
		return cmplx.Atan(z), true
	}
	if op == "Asinh" {
		return cmplx.Asinh(z), true
	}
	if op == "Acosh" {
		return cmplx.Acosh(z), true
	}
	if op == "Atanh" {
		return cmplx.Atanh(z), true
	}
	if op == "Sin" {
		return cmplx.Sin(z), true
	}
	if op == "Cos" {
		return cmplx.Cos(z), true
	}
	if op == "Tan" {
		return cmplx.Tan(z), true
	}
	if op == "Cot" {
		return cmplx.Cot(z), true
	}
	if op == "Sinh" {
		return cmplx.Sinh(z), true
	}
	if op == "Cosh" {
		return cmplx.Cosh(z), true
	}
	if op == "Tanh" {
		return cmplx.Tanh(z), true
	}
	if op == "Conj" {
		return cmplx.Conj(z), true
	}
	return cmplx.New(0, 0), false
}

// arg reads the complex number whose parts are fields i and i+1 (hex bits).
fn arg(f []str, i i64) cmplx.Complex {
	return cmplx.New(bitsArg(f, i), bitsArg(f, i+1))
}

// bitsArg reads field i as the f64 of its hex bits.
fn bitsArg(f []str, i i64) f64 {
	return gauge.F64frombits(parseHex(f[i]))
}

// cfmt prints a complex number as its two parts.
fn cfmt(z cmplx.Complex) str {
	return hex64(z.Re) + " " + hex64(z.Im)
}

// hex64 is the hex of the bits of x (16 digits), or "nan" for a NaN.
fn hex64(x f64) str {
	if gauge.IsNaN(x) {
		return "nan"
	}
	return hexDigits(gauge.F64bits(x), 16)
}

// hex32 is the hex of the bits of a float32 (8 digits), or "nan" for a NaN.
fn hex32(x f32) str {
	if gauge.IsNaN(f64(x)) {
		return "nan"
	}
	return hexDigits(u64(gauge.F32bits(x)), 8)
}

// hexDigits writes v in n lowercase hex digits, with leading zeros.
fn hexDigits(v u64, n i64) str {
	let digits = "0123456789abcdef"
	mut out = []u8{}
	for k in 0..n {
		let shift = u64(4 * (n - 1 - k))
		out = append(out, digits[(v>>shift)&15])
	}
	return str(out)
}

// parseHex reads a hex number of at most 16 digits.
fn parseHex(s str) u64 {
	mut v = u64(0)
	for i in 0..len(s) {
		let c = s[i]
		mut d = u64(0)
		if c >= '0' && c <= '9' {
			d = u64(c - '0')
		} else {
			d = u64(c - 'a') + 10
		}
		v = (v << 4) | d
	}
	return v
}

// boolText is "1" or "0".
fn boolText(b bool) str {
	if b {
		return "1"
	}
	return "0"
}

// splitSpace splits a line at its spaces, dropping empty fields.
fn splitSpace(line str) []str {
	mut out = []str{}
	mut start = i64(0)
	for i in 0..len(line) + 1 {
		if i == len(line) || line[i] == ' ' {
			if i > start {
				out = append(out, line[start:i])
			}
			start = i64(i) + 1
		}
	}
	return out
}
