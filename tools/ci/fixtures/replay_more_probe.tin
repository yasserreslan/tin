package replaymore

import "fault"
import "mysql"
import "postgres"
import "quarry"
import "replay"
import "say"
import "websocket"

// Copied into a temporary lib/replaymore by replay_check.tin: one task records what mysql,
// postgres, websocket and quarry do against live servers and files (#241), then the same code
// replays from that tape with no live call.

let my = mysql.Open(mysql.Options{Addr: quarry.Getenv("MYSQL_ADDR"), User: "tin", Password: "tinpass", Database: "tin", Pool: 2})
let pg = postgres.Open(postgres.Options{Addr: quarry.Getenv("POSTGRES_ADDR"), User: "tin", Password: "tinpass", Database: "tin", Pool: 2})
mut summary str
mut gTape i64

fn sql() str {
	let name = "ada"
	let (res, err) = my.Exec("INSERT INTO users (name) VALUES ({name})")
	let id = res.LastID
	let (rows, err2) = my.Query("SELECT id, name FROM users WHERE id = {id}")
	mut got = ""
	for _, r in rows.Rows {
		got = got + say.Fmt("[%d %s]", r[0].Int(), r[1].Text())
	}
	let (_, err3) = my.Query("SELECT id FROM nope WHERE id = {id}")
	let (tx, err4) = my.Begin()
	let more = "bob"
	let (tres, err5) = tx.Exec("INSERT INTO users (name) VALUES ({more})")
	let err6 = tx.Commit()
	let m = say.Fmt("mysql %d %v %s %v | %v | %v %d %v %v", id, err, got, err2, fault.Message(err3), err4, tres.LastID, err5, err6)
	let (prow, perr) = pg.Query("INSERT INTO users (name) VALUES ({name}) RETURNING id")
	mut pid = 0
	if len(prow.Rows) > 0 {
		pid = prow.Rows[0][0].Int()
	}
	let (pres, perr2) = pg.Query("SELECT id, name FROM users WHERE id = {pid}")
	mut pgot = ""
	for _, r in pres.Rows {
		pgot = pgot + say.Fmt("[%d %s]", r[0].Int(), r[1].Text())
	}
	let (ptx, perr3) = pg.Begin()
	let (pex, perr4) = ptx.Exec("INSERT INTO users (name) VALUES ({more}) RETURNING id")
	let perr5 = ptx.Commit()
	return m + say.Fmt(" | postgres %d %v %s %v | %v %d %v %v", pid, perr, pgot, perr2, perr3, pex.Affected, perr4, perr5)
}

fn ws() str {
	let (c, err) = websocket.Dial("ws://" + quarry.Getenv("WS_ADDR") + "/echo")
	if err != nil {
		return "ws " + say.Str(err)
	}
	let werr = c.WriteText("hello ws")
	let (m, rerr) = c.Read()
	c.Close()
	return say.Fmt("ws %v %v %q %v", werr, m.Text, m.Data, rerr)
}

fn files() str {
	let dir = quarry.Getenv("FILES_DIR")
	let e1 = quarry.MkdirAll(dir + "/sub")
	let e2 = quarry.WriteFile(dir + "/a.txt", "alpha")
	let e3 = quarry.AppendFile(dir + "/a.txt", "+beta")
	let e4 = quarry.Rename(dir + "/a.txt", dir + "/b.txt")
	let (text, e5) = quarry.ReadFile(dir + "/b.txt")
	let (size, e6) = quarry.Size(dir + "/b.txt")
	let (_, e7) = quarry.ModTime(dir + "/b.txt")
	let (names, e8) = quarry.ReadDir(dir)
	let ex = quarry.Exists(dir + "/b.txt")
	let isdir = quarry.IsDir(dir + "/sub")
	let e9 = quarry.Remove(dir + "/b.txt")
	let (_, e10) = quarry.ReadFile(dir + "/missing")
	return say.Fmt("files %v %v %v %v %q %v %d %v %v %v %v %v %v %v %v", e1, e2, e3, e4, text, e5, size, e6, e7, names, e8, ex, isdir, e9, e10 != nil)
}

fn work() str {
	return sql() + " || " + ws() + " || " + files()
}

// inTask runs work in a task with tape tp and returns its summary.
fn inTask(tp i64) str {
	gTape = tp
	summary = ""
	let s = rt_scope_open()
	s.spawn(fn() ! {
		rt_tape_set(curTask, gTape)
		summary = work()
		rt_tape_set(curTask, 0)
	})
	rt_scope_close(s) catch err {
		say.Line("task:", fault.Message(err))
	}
	return summary
}

fn Run() {
	say.Line("recording on:", replay.Setup(1))
	let tp = rt_tape_new(1)
	let recorded = inTask(tp)
	say.Line("recorded:", recorded)
	say.Line("effects:", tp[4])
	quarry.WriteFile(quarry.Getenv("TAPE_OUT"), rt_str_from_raw(tp[1], tp[2])) catch err {
		say.Line("tape:", fault.Message(err))
	}
	let dir = quarry.Getenv("FILES_DIR")
	quarry.RemoveAll(dir) catch err {
		say.Line("cleanup:", fault.Message(err))
	}
	let rp = rt_tape_new(2)
	rt_tape_load(rp, tp[1], tp[2])
	let replayed = inTask(rp)
	say.Line("replayed same:", replayed == recorded, "left:", rt_tape_left(rp), "diverged:", rt_tape_diverged(rp))
	if replayed != recorded {
		say.Line("replayed:", replayed)
	}
	say.Line("replay touched no file:", !quarry.Exists(dir))
}
