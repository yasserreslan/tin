package main
import "wire"
import "quarry"
import "say"
fn main() {
	let c = wire.DialTimeout(quarry.Args()[1], 3000000000) catch err { panic(err) }
	defer c.Close()
	c.Write("IPv6") catch err { panic(err) }
	let s = c.ReadFull(4) catch err { panic(err) }
	if s != "IPv6" { panic("IPv6 client echo") }
	say.Line(s)
}
