package replayserve

// Copied into a temporary lib/replayserve by replay_check.tin: an effect made the way a client
// library makes one (rt_effect around its live call), so replay mode (#242) can be checked
// before the clients record (#241).

mut liveCalls i64

// live is the effect's real call: it only counts itself.
fn live() !str {
	liveCalls += 1
	return "live"
}

// Effect is one effect of kind asking key: recorded or replayed when the request has a tape.
fn Effect(kind str, key str) !str {
	let tp = rt_tape()
	if tp == 0 {
		return try live()
	}
	return try rt_effect(tp, kind, key, live)
}

// LiveCalls is how many effects this core performed for real.
fn LiveCalls() i64 {
	return liveCalls
}
