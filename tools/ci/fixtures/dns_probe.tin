package wire

import "say"

// ProbeResolve exposes only the chosen bytes in a temporary CI library copy.
fn ProbeResolve(name str, timeout i64) !str {
	let sa = calloc(1, 32)
	defer free(sa)
	mut until = i64(0)
	if timeout > 0 { until = rt_mono_ns()+timeout }
	try resolve(name, 80, sa, until)
	let family = rt_sockaddr_family(sa)
	mut start = i64(4)
	mut n = i64(4)
	if family == 10 { start = 8
		n = 16 }
	mut b = make([]u8, 0, n*2)
	let digits = "0123456789abcdef"
	for i in 0..n {
		let v = load8(sa+start+i)
		b = append(b, digits[i64(v)>>4], digits[i64(v)&15])
	}
	return say.Str(family)+":"+str(b)
}
