package main

import "mint"
import "quarry"
import "say"
import "tide"

// #346: the slowest single insert into a long-lived map that grows to N entries. mapgrow <n>
// <int|str> prints the slowest insert, how many took over 100 us and 1 ms, and the total;
// map_growth_check.py runs it.

mut ints = map[i64]i64{}
mut names = map[str]i64{}

fn main() {
	let args = quarry.Args()
	let n = mint.Atoi(args[1]) catch _ { 1000000 }
	let kind = args[2]
	mut worst i64 = 0
	mut over100 i64 = 0
	mut over1000 i64 = 0
	mut at i64 = 0
	let start = tide.Now()
	for i in 0..n {
		let t0 = tide.Now()
		if kind == "str" {
			names[keep("key-{i}")] = i
		} else {
			ints[i * 2654435761] = i
		}
		let d = tide.Since(t0) / 1000
		if d > worst {
			worst = d
			at = i
		}
		if d > 100 {
			over100 += 1
		}
		if d > 1000 {
			over1000 += 1
		}
	}
	let total = tide.Since(start) / 1000000
	let lookups = tide.Now()
	mut found i64 = 0
	for i in 0..n {
		if kind == "str" {
			if names["key-{i}"] == i {
				found += 1
			}
		} else if ints[i * 2654435761] == i {
			found += 1
		}
	}
	say.Line("kind", kind, "entries", n, "worst_us", worst, "at", at, "over100us", over100, "over1ms", over1000, "total_ms", total, "lookup_ms", tide.Since(lookups) / 1000000, "found", found)
}
