package replaycapsule

import "fault"
import "quarry"
import "replay"
import "say"

// Copied into a temporary lib/replaycapsule by replay_check.tin: records tapes the way anvil and
// the clients will (#241), and ends them with replay.Done, which writes their capsules.

const request = "POST /checkout/7?x=1 HTTP/1.1\r\nHost: shop\r\nAuthorization: Bearer s3cr3t-token\r\nCookie: sid=c00k1e\r\nX-Api-Key: k-123-secret\r\nX-Email: alice@example.com\r\nContent-Length: 9\r\n\r\ncart=7&x="

fn ok() !str {
	return "2 books"
}

fn late() !str {
	try fault.Wrap(fault.DeadlineExceeded, "payments")
	return ""
}

// tape is a recording tape for a request that started at wall, with the request bytes req.
fn tape(req str, wall i64) i64 {
	let tp = rt_tape_new(1)
	rt_tape_req(tp, cast(i64, req)+8, len(req))
	tp[13] = wall
	return tp
}

// Failing records a 500 with three effects, one of them keyed by a secret's handle.
fn Failing(core i64) {
	let tp = tape(request, 1700000000000000001)
	mut (a, err) = rt_effect(tp, "redis@1", "3:GET 6:cart:7\n", ok)
	say.Line("effect:", a, err == nil)
	_, err = rt_effect(tp, "wire.http@1", "POST http://payments/charge\nAuthorization: " + rt_secret_key("Bearer s3cr3t-token") + "\n\ncart=7", late)
	say.Line("effect fault:", fault.Is(err, fault.DeadlineExceeded))
	say.Line("word:", rt_effect_word(tp, "tide.now@1", "", 1234567))
	tp[10] = 500
	replay.Done(tp, core)
}

// Panicked records a request that panicked (500).
fn Panicked(core i64) {
	let tp = tape("GET /boom HTTP/1.1\r\nHost: shop\r\n\r\n", 1700000000000000002)
	rt_tape_panic(tp, "boom: index 3 out of range")
	tp[10] = 500
	replay.Done(tp, core)
}

// Fine records a 200 (kept only when sampled).
fn Fine(core i64) {
	let tp = tape("GET /ok HTTP/1.1\r\nHost: shop\r\n\r\n", 1700000000000000003)
	tp[10] = 200
	replay.Done(tp, core)
}

// Big records n failing requests whose bodies have size bytes, on core.
fn Big(n i64, size i64, core i64) {
	let body = make([]u8, size)
	for i in 0..size {
		body[i] = 'a' + u8(i%26)
	}
	for k in 0..n {
		let req = "POST /big HTTP/1.1\r\nHost: shop\r\nContent-Length: " + say.Str(size) + "\r\n\r\n" + str(body)
		let tp = tape(req, 1700000000000000100+k)
		tp[10] = 503
		replay.Done(tp, core)
	}
}

fn Run() {
	let mode = quarry.Getenv("CAPSULE_CASE")
	let on = replay.Setup(2)
	say.Line("on:", on, replay.On())
	if mode == "basic" {
		Failing(0)
		Panicked(1)
		Fine(0)
	} else if mode == "sample" {
		Fine(1)
	} else if mode == "bound" {
		Big(6, 300000, 0)
		Big(2, 300000, 1)
	} else if mode == "off" {
		Failing(0)
	}
}
