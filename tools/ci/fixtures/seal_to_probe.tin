// Copied into a private lib/seal by crypto_check.py, so a test program can call AEAD.SealTo,
// which takes raw addresses: the bytes it writes into another buffer and in place must equal
// Seal's.
package seal

fn ProbeSealTo(a AEAD, nonce []u8, pt []u8, aad []u8) !str {
	let n = len(pt)
	let dst = make([]u8, n+16)
	let src = make([]u8, n)
	copy(src, pt)
	try a.SealTo(nonce, cast(i64, src)[2], n, aad, cast(i64, dst)[2])
	let inplace = make([]u8, n+16)
	copy(inplace, pt)
	try a.SealTo(nonce, cast(i64, inplace)[2], n, aad, cast(i64, inplace)[2])
	if Hex(dst) != Hex(inplace) {
		return "in place differs"
	}
	return Hex(dst)
}
