// Appended to a temporary copy of packages/websocket/websocket.tin by lifetime_check.tin.
// Observe automatic resource cleanup after the handler, before its pool is wiped.
mut probeClosed i64
mut probeBadCleanup i64
mut probeScoped i64

fn probe_after(slot i64) {
	if slot[0] != 0 {
		if slot[1] != 0 {
			probeScoped += 1
		} else {
			probeClosed += 1
		}
		if slot[0][sBuf] != 0 {
			probeBadCleanup += 1
		}
	}
	free(slot)
}

fn ProbeAccept(q anvil.Req, w mut anvil.Out) !Conn {
	let slot = calloc(2, 8)
	rt_task_cleanup(probe_after, slot)
	let c = try Accept(q, mut w)
	slot[0] = c.st
	return c
}

fn ProbeClosed() i64 {
	return probeClosed
}

fn ProbeBadCleanup() i64 {
	return probeBadCleanup
}

fn ProbePoolUsed() i64 {
	return rt_pool_used()
}

// The runtime probe's helper count for lifetime.tin, which cannot call rt_ functions.
fn ProbeHelpers() i64 {
	return rt_test_helpers()
}

// A callback-owned connection state must be cleaned before Each resets its pool,
// rather than leaving a dangling cleanup argument for task exit.
fn ProbeScopeResource() {
	let slot = calloc(2, 8)
	slot[1] = 1
	rt_task_cleanup(probe_after, slot)
	slot[0] = new_state(-1, false)
}

fn ProbeScoped() i64 {
	return probeScoped
}
