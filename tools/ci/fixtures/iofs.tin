package main

// The io/fs twin, Tin side: read the corpus of bench/ref/iofs on stdin and print the same lines
// for the tree named by the argument, so tools/ci/iofs_check.tin can compare fs (over fs.Dir) and
// io.Pipe with Go's io/fs (over os.DirFS) and io.Pipe (#736). The commands are listed in
// bench/ref/iofs/main.go; every argument is hex-encoded.

import "fault"
import "fs"
import "io"
import "mint"
import "quarry"
import "say"
import "sift"

// hasher is a writer that counts the bytes and takes their FNV-1a 64.
type hasher struct {
	n i64
	h u64
}

fn newHasher() hasher {
	return hasher{n: 0, h: 14695981039346656037}
}

fn (h mut hasher) Write(data []u8) !i64 {
	mut x = h.h
	for c in data {
		x ^= u64(c)
		x *%= 1099511628211
	}
	h.h = x
	h.n += i64(len(data))
	return i64(len(data))
}

fn (h hasher) text() str {
	return say.Fmt("%d %016x", h.n, h.h)
}

fn sum(b []u8) str {
	mut h = newHasher()
	h.Write(b) catch err {
		return say.Str(err)
	}
	return h.text()
}

fn seqByte(i i64) u8 {
	return u8((i*7 + 3) % 251)
}

fn unhex(c u8) i64 {
	if c >= '0' && c <= '9' {
		return i64(c - '0')
	}
	if c >= 'a' && c <= 'f' {
		return i64(c-'a') + 10
	}
	return i64(c-'A') + 10
}

// arg decodes a hex argument.
fn arg(s str) str {
	if s == "-" {
		return ""
	}
	mut out = make([]u8, 0, len(s)/2)
	mut i = 0
	for i+1 < len(s) {
		out = append(out, u8(unhex(s[i])*16+unhex(s[i+1])))
		i += 2
	}
	return str(out)
}

fn errText(err fault) str {
	if err == nil {
		return "nil"
	}
	if indexOf(say.Str(err), "io: unexpected end of stream:") == 0 {
		return "fault unexpected EOF"
	}
	return "fault " + say.Str(err)
}

fn indexOf(s str, sub str) i64 {
	if len(sub) > len(s) {
		return -1
	}
	for i in 0..len(s)-len(sub)+1 {
		if s[i:i+len(sub)] == sub {
			return i
		}
	}
	return -1
}

fn info(fi fs.FileInfo) str {
	mut size = "-"
	if fi.Mode&fs.ModeType == 0 {
		size = mint.Itoa(fi.Size)
	}
	return fi.Name + " " + size + " " + fs.ModeString(fi.Mode) + " " + say.Str(fi.IsDir())
}

fn splitSpace(line str) []str {
	mut out = []str{}
	mut start = 0
	for i in 0..len(line)+1 {
		if i == len(line) || line[i] == ' ' {
			if i > start {
				out = append(out, line[start:i])
			}
			start = i + 1
		}
	}
	return out
}

fn chunks(s str) []i64 {
	mut out = []i64{}
	mut v = i64(0)
	for i in 0..len(s) {
		if s[i] == ',' {
			out = append(out, v)
			v = 0
		} else {
			v = v*10 + i64(s[i]-'0')
		}
	}
	out = append(out, v)
	return out
}

fn join(xs []str, sep str) str {
	mut out = ""
	for i, x in xs {
		if i > 0 {
			out = out + sep
		}
		out = out + x
	}
	return out
}

fn main() {
	let args = quarry.Args()
	let d = fs.Dir(args[1])
	let body = quarry.ReadStdin() catch err {
		say.Line("fault", err)
		return
	}
	mut start = 0
	for i in 0..len(body)+1 {
		if i == len(body) || body[i] == '\n' {
			if i > start {
				run(d, body[start:i])
			}
			start = i + 1
		}
	}
}

// run handles one corpus line.
fn run(d fs.DirFS, line str) {
	let f = splitSpace(line)
	let cmd = f[0]
	if cmd == "V" {
		say.Line("V", fs.ValidPath(arg(f[1])))
	} else if cmd == "S" || cmd == "L" {
		mut fi = fs.FileInfo{Name: "", Size: 0, Mode: 0, ModTime: 0}
		mut err fault = nil
		if cmd == "S" {
			let (a, e) = fs.Stat(d, arg(f[1]))
			fi = a
			err = e
		} else {
			let (a, e) = d.Lstat(arg(f[1]))
			fi = a
			err = e
		}
		if err != nil {
			say.Line(cmd, errText(err))
			return
		}
		say.Line(cmd, info(fi))
	} else if cmd == "D" {
		let es = fs.ReadDir(d, arg(f[1])) catch err {
			say.Line("D", errText(err))
			return
		}
		mut parts = []str{}
		for e in es {
			parts = append(parts, e.Name + ":" + fs.ModeString(e.Type))
		}
		say.Line("D", len(es), join(parts, "|"))
	} else if cmd == "F" {
		// Go's fs.ReadFile uses the ReadFileFS method when there is one, as Dir has.
		let b = d.ReadFile(arg(f[1])) catch err {
			say.Line("F", errText(err))
			return
		}
		say.Line("F", sum([]u8(b)))
	} else if cmd == "O" {
		openCase(d, arg(f[1]))
	} else if cmd == "W" {
		walkCase(d, arg(f[1]), f[2], arg(f[3]))
	} else if cmd == "G" {
		let m = fs.Glob(d, arg(f[1])) catch err {
			say.Line("G", errText(err))
			return
		}
		say.Line("G", len(m), join(m, "|"))
	} else if cmd == "P" || cmd == "E" || cmd == "R" {
		pipeCase(cmd, f)
	}
}

// openCase opens name, describes it, copies it, lists it and closes it.
fn openCase(d fs.DirFS, name str) {
	mut file = d.Open(name) catch err {
		say.Line("O", errText(err))
		return
	}
	let (fi, serr) = file.Stat()
	if serr != nil {
		say.Line("O stat", errText(serr))
	} else {
		say.Line("O stat", info(fi))
	}
	mut h = newHasher()
	let (_, cerr) = io.Copy(h, fs.Reader(file))
	say.Line("O copy", h.text(), errText(cerr))
	let (es, rerr) = file.ReadDir(-1)
	mut names = []str{}
	for e in es {
		names = append(names, e.Name)
	}
	sift.Strs(mut names)
	// Go asks for ReadDir only of a file that has it, and every os.File has it.
	say.Line("O readdir", join(names, "|"), errText(rerr))
	let closed = file.Close()
	say.Line("O close", errText(closed))
}

// walkCase walks root, printing every call, and returns SkipDir, SkipAll or a fault at name.
fn walkCase(d fs.DirFS, root str, mode str, name str) {
	let err = fs.WalkDir(d, root, fn(p str, e ?fs.DirEntry, err fault) ! {
		if e == nil {
			say.Line("W", p, "nil", errText(err))
			return
		}
		say.Line("W", p, e.Name, e.IsDir(), fs.ModeString(e.Type), errText(err))
		if e.Name == name && err == nil {
			if mode == "skipdir" {
				fail fs.SkipDir
			} else if mode == "skipall" {
				fail fs.SkipAll
			} else if mode == "stop" {
				fail "stop at " + name
			}
		}
	})
	say.Line("W end", errText(err))
}

// writeChunks writes the sequence's bytes to w in the chunk sizes.
fn writeChunks(w io.PipeWriter, cs []i64) ! {
	mut pos = i64(0)
	for c in cs {
		mut b = make([]u8, c)
		for i in 0..c {
			b[i] = seqByte(pos + i)
		}
		pos += c
		try w.Write(b)
	}
}

// pipeCase runs a writer task and reads in main, as the Go side's goroutine and main do.
fn pipeCase(cmd str, f []str) {
	let (line, werr) = pipeScope(cmd, f) catch err {
		say.Line(cmd, "scope", errText(err))
		return
	}
	say.Line(line, "writer", werr)
}

// failWith fails with msg, so a fault can carry a text the corpus chose.
fn failWith(msg str) ! {
	fail msg
}

// pipeScope runs the case and returns the reader's line and the writer's fault text.
fn pipeScope(cmd str, f []str) !(str, str) {
	let cs = chunks(f[1])
	mut (r, w) = try io.Pipe()
	mut we = "nil"
	mut out = ""
	scope s {
		s.spawn(fn() ! {
			writeChunks(w, cs) catch e {
				we = errText(e)
			}
			if cmd == "E" {
				failWith(arg(f[2])) catch reason {
					w.CloseWithError(reason) catch e {
						we = errText(e)
					}
				}
			}
			w.Close() catch e {
				we = errText(e)
			}
		})
		out = readSide(cmd, f, mut r)
	}
	return out, we
}

// readSide is the reader's half of a pipe case.
fn readSide(cmd str, f []str, r mut io.PipeReader) str {
	if cmd == "R" {
		let k = mint.Atoi(f[2]) catch err {
			return errText(err)
		}
		mut b = make([]u8, k)
		let (_, err) = io.ReadFull(r, mut b)
		r.Close() catch e {
			return errText(e)
		}
		return "R " + sum(b) + " " + errText(err)
	}
	mut n = i64(0)
	if cmd == "P" {
		n = mint.Atoi(f[2]) catch err {
			return errText(err)
		}
	}
	mut h = newHasher()
	mut err fault = nil
	if n == 0 {
		let (b, e) = io.ReadAll(r)
		err = e
		if e == nil {
			h.Write([]u8(b)) catch e2 {
				return errText(e2)
			}
		}
	} else {
		mut buf = make([]u8, n)
		let (_, e) = io.CopyBuffer(h, r, mut buf)
		err = e
	}
	r.Close() catch e {
		return errText(e)
	}
	if err != nil {
		return cmd + " " + errText(err)
	}
	return cmd + " " + h.text()
}
