package main

import "anvil"
import "mint"
import "mysql"
import "quarry"
import "say"

// #359: a service for mysql_check.py that holds statements open and counts the connections its
// user has on the server. MYSQL_POOL and MYSQL_MAX_TOTAL are Options.Pool and Options.MaxTotal
// (unset: the defaults).
let db = mysql.Open(mysql.Options{
	Addr:     quarry.Getenv("MYSQL_ADDR"),
	User:     quarry.Getenv("MYSQL_USER"),
	Password: quarry.Getenv("MYSQL_PASSWORD"),
	Database: quarry.Getenv("MYSQL_DATABASE"),
	Pool:     env_int("MYSQL_POOL"),
	MaxTotal: env_int("MYSQL_MAX_TOTAL"),
})

fn env_int(name str) i64 {
	let n = mint.Atoi(quarry.Getenv(name)) catch _ { 0 }
	return n
}

fn sleep(q anvil.Req, w mut anvil.Out) {
	let ms = mint.Atoi(q.Param("ms")) catch _ { 100 }
	let secs = f64(ms) / 1000.0
	_ = db.Query("SELECT SLEEP({secs})") catch err {
		w.Status(502)
		w.Text("{err}")
		return
	}
	w.Text("slept")
}

fn connections(q anvil.Req, w mut anvil.Out) {
	let rows = db.Query("SELECT COUNT(*) FROM information_schema.PROCESSLIST WHERE USER = SUBSTRING_INDEX(CURRENT_USER(), '@', 1)") catch err {
		w.Status(502)
		w.Text("{err}")
		return
	}
	w.Text(rows.Rows[0][0].Text())
}

fn main() {
	let r = anvil.NewRouter()
	r.Get("/sleep", sleep)
	r.Get("/connections", connections)
	let err = r.Serve(":" + quarry.Getenv("PORT"))
	say.Line("server:", err)
}
