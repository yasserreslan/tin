package main

// The Tin side of argo_twin.go: argo.Get against Go's default decoder and argo.GetStrict
// against DisallowUnknownFields. Output: "<case> default=<ok|fault> strict=<ok|fault>".

import "argo"
import "say"

type T struct {
	n    u8
	name str
	tags []str
}

fn verdict(err fault) str {
	if err == nil {
		return "ok"
	}
	return "fault"
}

fn run(name str, in str) {
	let a = T{name: "", tags: []str{}}
	let b = T{name: "", tags: []str{}}
	say.Line(name, "default="+verdict(argo.Get(in, mut a)), "strict="+verdict(argo.GetStrict(in, mut b)))
}

fn main() {
	run("unknown", `{"n":1,"zz":2}`)
	run("duplicate", `{"n":1,"n":2}`)
	run("trailing_comma", `{"tags":["a",]}`)
	run("type_mismatch", `{"n":"x"}`)
	run("out_of_range", `{"n":700}`)
	run("trailing_garbage", `{"n":1} x`)
	run("bad_utf8", `{"name":"a` + "\xff" + `b"}`)
	run("lone_surrogate", `{"name":"\ud800"}`)
	run("valid_pair", `{"name":"😀"}`)
}
