package main

// The Tin side of argo_twin.go: argo.Get against Go's default decoder and argo.GetStrict
// against DisallowUnknownFields. Output: "<case> default=<ok|fault> strict=<ok|fault>".

import "argo"
import "say"

type T struct {
	n    u8
	name str
	tags []str
}

type U struct {
	n ?i64
	f ?f64
	b ?bool
}

fn runOpt(name str, in str) {
	let u = U{}
	let err = argo.Get(in, mut u)
	if err != nil {
		say.Line(name, "default=fault", "strict=fault")
		return
	}
	mut set = ""
	if u.n != nil {
		set += "S"
	} else {
		set += "-"
	}
	if u.f != nil {
		set += "S"
	} else {
		set += "-"
	}
	if u.b != nil {
		set += "S"
	} else {
		set += "-"
	}
	say.Line(name, "default=ok:" + set, "strict=ok:" + set)
}

fn verdict(err fault) str {
	if err == nil {
		return "ok"
	}
	return "fault"
}

fn run(name str, in str) {
	let a = T{name: "", tags: []str{}}
	let b = T{name: "", tags: []str{}}
	say.Line(name, "default="+verdict(argo.Get(in, mut a)), "strict="+verdict(argo.GetStrict(in, mut b)))
}

fn main() {
	run("unknown", `{"n":1,"zz":2}`)
	run("duplicate", `{"n":1,"n":2}`)
	run("trailing_comma", `{"tags":["a",]}`)
	run("type_mismatch", `{"n":"x"}`)
	run("out_of_range", `{"n":700}`)
	run("trailing_garbage", `{"n":1} x`)
	run("bad_utf8", `{"name":"a` + "\xff" + `b"}`)
	run("lone_surrogate", `{"name":"\ud800"}`)
	run("valid_pair", `{"name":"😀"}`)
	run("null_scalars", `{"n":null,"name":null}`)
	run("null_slice", `{"tags":null}`)
	run("null_element", `{"tags":["a",null]}`)
	run("null_top", `null`)
	runOpt("opt_null", `{"n":null,"f":null,"b":null}`)
	runOpt("opt_missing", `{}`)
	runOpt("opt_values", `{"n":7,"f":1.5,"b":true}`)
	runOpt("opt_zero", `{"n":0,"f":0,"b":false}`)
	runOpt("opt_string", `{"n":"x"}`)
	runOpt("opt_fraction", `{"n":1.5}`)
	runOpt("opt_range", `{"n":99999999999999999999}`)
}
