package main

// The column twin, Tin side: read the hex corpus of bench/ref/column (Go's text/tabwriter) on stdin and print the same lines,
// so tools/ci/column_check.tin can compare them (#753).
//
//	T <flags> <minwidth> <tabwidth> <padding> <padchar> <text>          one Write, then Flush
//	W <flags> <minwidth> <tabwidth> <padding> <padchar> <chunk> ...     one Write per chunk, then Flush

import "column"
import "quarry"
import "say"
import "seal"

// sink collects what column.Writer writes.
type sink struct {
	b []u8
}

fn (s mut sink) Write(data []u8) !i64 {
	s.b = append(s.b, data...)
	return i64(len(data))
}

fn main() {
	let body = quarry.ReadStdin() catch err {
		say.Line("fault", err)
		return
	}
	mut start = i64(0)
	mut i = i64(0)
	for i <= i64(len(body)) {
		if i < i64(len(body)) && body[i] != '\n' {
			i += 1
			continue
		}
		let line = body[start:i]
		start = i + 1
		i += 1
		if len(line) == 0 {
			continue
		}
		run(line)
	}
}

// run handles one corpus line.
fn run(line str) {
	let parts = splitSpace(line)
	if len(parts) == 0 {
		return
	}
	let flags = parseInt(argOf(parts, 1))
	let minwidth = parseInt(argOf(parts, 2))
	let tabwidth = parseInt(argOf(parts, 3))
	let padding = parseInt(argOf(parts, 4))
	mut padchar = u8(0)
	let pad = hexBytes(argOf(parts, 5))
	if len(pad) == 1 {
		padchar = pad[0]
	}
	mut s = sink{b: []u8{}}
	mut w = column.NewWriter(s, minwidth, tabwidth, padding, padchar, flags) catch err {
		say.Line("fail", err)
		return
	}
	if parts[0] == "T" {
		w.Write(hexBytes(argOf(parts, 6))) catch err {
			say.Line("fail", err)
			return
		}
	} else {
		for k in 6..len(parts) {
			w.Write(hexBytes(parts[k])) catch err {
				say.Line("fail", err)
				return
			}
		}
	}
	w.Flush() catch err {
		say.Line("fail", err)
		return
	}
	say.Line(parts[0], seal.Hex(s.b))
}

// hexBytes decodes a lowercase hex string.
fn hexBytes(s str) []u8 {
	if len(s) == 0 {
		return []u8{}
	}
	return seal.HexDecode(s) catch _ {
		return []u8{}
	}
}

// parseInt parses a non-negative decimal number.
fn parseInt(s str) i64 {
	mut v = i64(0)
	for i in 0..len(s) {
		if s[i] < '0' || s[i] > '9' {
			return v
		}
		v = v*10 + i64(s[i]) - '0'
	}
	return v
}

// argOf is the argument at i, or "" when the line has none.
fn argOf(parts []str, i i64) str {
	if i < i64(len(parts)) {
		return parts[i]
	}
	return ""
}

// splitSpace splits a line on spaces.
fn splitSpace(line str) []str {
	mut out = []str{}
	mut start = i64(0)
	mut i = i64(0)
	for i <= i64(len(line)) {
		if i == i64(len(line)) || line[i] == ' ' {
			if i > start {
				out = append(out, line[start:i])
			}
			start = i + 1
		}
		i += 1
	}
	return out
}
