package main

import "anvil"
import "fault"
import "replayrecord"
import "tide"

// A checkout service for replay_check.tin (#241): anvil records its requests, and toolchain/std/replay
// keeps the capsules of the ones that fail, panic or are sampled.

fn cart(q anvil.Req, w mut anvil.Out) {
	let items = replayrecord.Effect("redis@1", "GET cart:" + q.PathParam("id"), "2 books") catch err {
		w.Status(502)
		w.Text(fault.Message(err))
		return
	}
	if q.Param("wait") == "1" {
		let err = tide.Wait(5000000)
		if err != nil {
			w.Status(503)
			return
		}
	}
	if q.Param("panic") == "1" {
		panic("checkout: cart " + items)
	}
	if q.Param("fail") == "1" {
		_ = replayrecord.Late("POST http://payments/charge\n\ncart=" + items) catch err {
			w.Status(500)
			if fault.Is(err, fault.DeadlineExceeded) {
				w.Status(504)
			}
			w.Text("charge failed: " + fault.Message(err) + "\n")
			return
		}
	}
	w.Text("cart: " + items + "\n")
}

fn main() {
	let r = anvil.NewRouter()
	r.Get(`/cart/{id}`, cart)
	let err = r.Serve(":8080")
	if err != nil {
		panic(fault.Message(err))
	}
}
