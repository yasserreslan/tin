package main

import "anvil"
import "mint"
import "say"
import "tide"
import "websocket"

// The routed server tools/ci/router_check.py drives. Every request goes through two root
// middleware; /api adds one that waits before calling next. Handlers wait too, and read
// their path parameters and middleware values after the wait.

// stamp tags the request in the order the middleware ran, and the status after them.
fn stamp(q anvil.Req, w mut anvil.Out, next fn(anvil.Req, mut anvil.Out)) {
	w.SetValue("trace", "stamp")
	next(q, mut w)
	w.Head("X-Status", say.Str(w.Code()))
}

// tag adds its name to the trace set by stamp.
fn tag(q anvil.Req, w mut anvil.Out, next fn(anvil.Req, mut anvil.Out)) {
	w.SetValue("trace", w.Value("trace") + ">tag")
	next(q, mut w)
}

// slow_mw waits ms (from the query) before the rest of the chain runs.
fn slow_mw(q anvil.Req, w mut anvil.Out, next fn(anvil.Req, mut anvil.Out)) {
	let ms = mint.Atoi(q.Param("mw")) catch _ { 0 }
	if ms > 0 {
		tide.Wait(ms * 1ms) catch err {
			w.Status(504)
			w.Text("middleware: {err}")
			return
		}
	}
	w.SetValue("trace", w.Value("trace") + ">api")
	next(q, mut w)
}

fn pause(q anvil.Req) ! {
	let ms = mint.Atoi(q.Param("ms")) catch _ { 0 }
	if ms > 0 {
		try tide.Wait(ms * 1ms)
	}
}

fn user(q anvil.Req, w mut anvil.Out) {
	pause(q) catch err {
		w.Status(504)
		w.Text("{err}")
		return
	}
	let id = q.PathParam("id")
	let trace = w.Value("trace")
	w.Text("user {id} {trace} {q.Pattern()}")
}

fn create(q anvil.Req, w mut anvil.Out) {
	let b = q.Body()
	w.Status(201)
	w.Text("created {len(b)}")
}

fn file(q anvil.Req, w mut anvil.Out) {
	let p = q.PathParam("path")
	w.Text("file {p}")
}

fn item(q anvil.Req, w mut anvil.Out) {
	pause(q) catch err {
		w.Status(504)
		w.Text("{err}")
		return
	}
	let id = q.PathParam("id")
	let trace = w.Value("trace")
	w.Text("item {id} {trace}")
}

// deep recurses n levels (from the query): far past a request task's 256 KiB stack (#175).
fn deep(n i64) i64 {
	if n == 0 {
		return 0
	}
	return deep(n-1) + 1
}

// add sums a and b from the query: a sum past i64 panics (#362), so that request gets 500
// and the server keeps serving.
fn add(q anvil.Req, w mut anvil.Out) {
	let a = mint.Atoi(q.Param("a")) catch _ { 0 }
	let b = mint.Atoi(q.Param("b")) catch _ { 0 }
	w.Text("sum {a + b}")
}

fn recurse(q anvil.Req, w mut anvil.Out) {
	let n = mint.Atoi(q.Param("n")) catch _ { 10 }
	w.Text("depth {deep(n)}")
}

// boom panics, at once or after waiting ms (from the query): the request gets 500 and the
// server keeps serving (#142); its defers and pick's run while the panic unwinds (#230).
fn boom(q anvil.Req, w mut anvil.Out) {
	defer note_unwind("handler;")
	pause(q) catch err {
		w.Status(504)
		w.Text("{err}")
		return
	}
	let xs = []i64{1, 2, 3}
	let k = len(q.Param("k")) + 5
	w.Text("never {pick(xs, k)}")
}

mut unwound str

fn note_unwind(s str) {
	unwound = keep(unwound + s)
}

fn pick(xs []i64, k i64) i64 {
	defer note_unwind("inner;")
	return xs[k]
}

// unwinds reports the deferred calls that ran during panics, in order.
fn unwinds(q anvil.Req, w mut anvil.Out) {
	w.Text(unwound)
}

// double panics again in a deferred call while unwinding: the process ends (#230).
fn double(q anvil.Req, w mut anvil.Out) {
	defer panic_again()
	panic("first")
}

fn panic_again() {
	panic("second")
}

fn fast(q anvil.Req, w mut anvil.Out) {
	w.Text("fast")
}

// echo_head copies query values into response headers (#172: they must not add lines).
fn echo_head(q anvil.Req, w mut anvil.Out) {
	w.Head("X-Echo", q.Param("v"))
	w.Head("Bad Name", "dropped")
	w.Head("Content-Length", "0")
	w.Head("connection", "close")
	w.Type(q.Param("t"))
	w.Text("echoed")
}

// status answers with the status in the path and a body, which 204 and 304 must not send.
fn status(q anvil.Req, w mut anvil.Out) {
	let code = mint.Atoi(q.PathParam("code")) catch _ { 500 }
	w.Status(code)
	w.Text("body for {code}")
}

// ws upgrades a routed request: it names its room, then echoes every message.
fn ws(q anvil.Req, w mut anvil.Out) {
	let c = websocket.Accept(q, mut w) catch _ { return }
	let room = q.PathParam("room")
	c.WriteText("room {room}") catch _ { return }
	c.Each(echo) catch _ {}
}

fn echo(c websocket.Conn, m websocket.Message) ! {
	try c.WriteText("echo: {m.Data}")
}

fn main() {
	let r = anvil.NewRouter()
	r.Use(stamp)
	r.Use(tag)
	r.Get(`/users/{id}`, user)
	r.Post("/users", create)
	r.Get(`/files/{path...}`, file)
	r.Get("/fast", fast)
	r.Get("/boom", boom)
	r.Get("/unwinds", unwinds)
	r.Get("/double", double)
	r.Get("/recurse", recurse)
	r.Get("/add", add)
	r.Get("/echo-head", echo_head)
	r.Get(`/status/{code}`, status)
	r.Get(`/ws/{room}`, ws)
	r.Route("/api", fn(g mut anvil.Router) {
		g.Use(slow_mw)
		g.Get(`/items/{id}`, item)
	})
	let err = r.Serve(":0")
	say.Line("server:", err)
}
