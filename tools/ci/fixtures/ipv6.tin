package main
import "wire"
import "say"
import "quarry"
fn main() {
	let l = wire.Listen("[::1]:0") catch err { panic(err) }
	defer l.Close()
	quarry.Eprint(say.Str(l.Port())+"\n")
	let c = l.Accept() catch err { panic(err) }
	defer c.Close()
	let s = c.ReadFull(4) catch err { panic(err) }
	c.Write(s) catch err { panic(err) }
}
