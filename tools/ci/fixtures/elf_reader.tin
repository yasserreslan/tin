package main

import "debug/elf"
import "quarry"
import "say"

fn main() {
	let args = quarry.Args()
	if len(args) != 2 {
		say.Line("usage: elf_reader FILE")
		return
	}
	let f = elf.Open(args[1]) catch err {
		say.Line(err)
		return
	}
	say.Line("header {f.Header.Class} {f.Header.Machine} {len(f.Segments)} {len(f.Sections)}")
	for s in f.Sections {
		say.Line("section {s.Name}")
	}
}
