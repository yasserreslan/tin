package main

import "image"
import "image/color"
import "image/draw"
import "mint"
import "image/png"
import "quarry"
import "say"
import "seal"
import "twine"

fn main() {
	let body = quarry.ReadStdin() catch err {
		say.Line("fault", err)
		return
	}
	mut start = i64(0)
	for i in 0..len(body)+1 {
		if i < len(body) && body[i] != '\n' { continue }
		let line = body[start:i]
		start = i + 1
		if len(line) == 0 { continue }
		let fields = twine.Split(line, " ")
		if fields[0] == "D" {
			let which = mint.Atoi(fields[1]) catch _ { 0 }
			say.Line(drawResult(which))
			continue
		}
		if fields[0] == "E" {
			let which = mint.Atoi(fields[1]) catch _ { 0 }
			let m = encodeImage(which)
			say.Line("E", seal.Hex([]u8(png.Encode(m))), pixels(m))
			continue
		}
		let data = seal.HexDecode(fields[0]) catch err {
			say.Line("bad hex", err)
			return
		}
		let decoded = png.Decode(str(data)) catch err {
			say.Line("decode fault", err)
			return
		}
		let bounds = decoded.Bounds()
		mut out = ""
		for y in bounds.Min.Y..bounds.Max.Y {
			for x in bounds.Min.X..bounds.Max.X {
				let c = decoded.At(x, y)
				out += say.Fmt("%04x%04x%04x%04x", c.R, c.G, c.B, c.A)
			}
		}
		say.Line(out, seal.Hex([]u8(png.Encode(decoded))))
	}
}

fn encodeImage(which i64) dyn image.Image {
	if which == 0 {
		mut m = image.NewGray(image.Rect(0, 0, 3, 2))
		m.SetGray(0, 0, color.Gray{Y: 7})
		m.SetGray(1, 0, color.Gray{Y: 128})
		m.SetGray(2, 1, color.Gray{Y: 255})
		return m
	}
	if which == 1 {
		mut m = image.NewGray16(image.Rect(0, 0, 2, 1))
		m.SetGray16(0, 0, color.Gray16{Y: 0x1234})
		m.SetGray16(1, 0, color.Gray16{Y: 0xabcd})
		return m
	}
	if which == 2 {
		let pal color.Palette = []color.NRGBA{{R: 255, A: 255}, {G: 255, A: 128}, {B: 255, A: 0}}
		mut m = image.NewPaletted(image.Rect(0, 0, 5, 1), pal)
		for x in 0..5 { m.SetColorIndex(x, 0, u8(x%3)) }
		return m
	}
	if which == 3 {
		mut m = image.NewRGBA(image.Rect(0, 0, 2, 1))
		m.SetRGBA(0, 0, color.RGBA{R: 128, G: 0, B: 0, A: 128})
		m.SetRGBA(1, 0, color.RGBA{R: 4, G: 5, B: 6, A: 255})
		return m
	}
	if which == 4 {
		mut m = image.NewRGBA64(image.Rect(0, 0, 1, 2))
		m.SetRGBA64(0, 0, color.RGBA64{R: 0x1234, G: 0x5678, B: 0x9abc, A: 0xffff})
		m.SetRGBA64(0, 1, color.RGBA64{R: 0x1010, G: 0x2020, B: 0x3030, A: 0xffff})
		return m
	}
	if which == 5 {
		mut m = image.NewNRGBA(image.Rect(0, 0, 2, 1))
		m.SetNRGBA(0, 0, color.NRGBA{R: 255, G: 60, B: 10, A: 88})
		m.SetNRGBA(1, 0, color.NRGBA{R: 3, G: 4, B: 5, A: 255})
		return m
	}
	mut m = image.NewNRGBA64(image.Rect(0, 0, 1, 2))
	m.SetNRGBA64(0, 0, color.NRGBA64{R: 0x1234, G: 0x5678, B: 0x9abc, A: 0x8080})
	m.SetNRGBA64(0, 1, color.NRGBA64{R: 0xfedc, G: 0xba98, B: 0x7654, A: 0xffff})
	return m
}

fn pixels(m dyn image.Image) str {
	let bounds = m.Bounds()
	mut out = ""
	for y in bounds.Min.Y..bounds.Max.Y {
		for x in bounds.Min.X..bounds.Max.X {
			let c = m.At(x, y)
			out += say.Fmt("%04x%04x%04x%04x", c.R, c.G, c.B, c.A)
		}
	}
	return out
}

fn drawResult(which i64) str {
	mut dst = image.NewRGBA(image.Rect(0, 0, 4, 3))
	mut src = image.NewNRGBA(image.Rect(0, 0, 4, 3))
	mut mask = image.NewAlpha(image.Rect(0, 0, 4, 3))
	for y in 0..3 {
		for x in 0..4 {
			dst.SetRGBA(x, y, color.RGBA{R: u8(20+x*19), G: u8(30+y*21), B: 70, A: 255})
			src.SetNRGBA(x, y, color.NRGBA{R: u8(200-x*23), G: u8(40+y*17), B: u8(10+x*9), A: u8(60+x*43+y*11)})
			mask.SetAlpha(x, y, color.Alpha{A: u8(30+x*50+y*13)})
		}
	}
	let r = image.Rect(-1, 0, 3, 3)
	if which == 0 { draw.Draw(mut dst, r, src, image.Point{}, draw.Src) }
	if which == 1 { draw.Draw(mut dst, r, src, image.Point{}, draw.Over) }
	if which == 2 { draw.DrawMask(mut dst, r, src, image.Point{}, mask, image.Point{}, draw.Src) }
	if which == 3 { draw.DrawMask(mut dst, r, src, image.Point{}, mask, image.Point{}, draw.Over) }
	mut out = ""
	for y in 0..3 {
		for x in 0..4 {
			let c = dst.At(x, y)
			out += say.Fmt("%04x%04x%04x%04x", c.R, c.G, c.B, c.A)
		}
	}
	return out
}
