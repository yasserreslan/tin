package main

import "image"
import "image/color"
import "image/jpeg"
import "mint"
import "seal"
import "say"

// Encodes gray and color test images at each quality and size, printing "tin-LABEL|hex" for the Go corpus check to decode.
fn main() {
	let qualities = []i64{1, 25, 50, 75, 90, 100}
	let widths = []i64{1, 9, 17}
	let heights = []i64{1, 7, 13}
	for quality in qualities {
		for s in 0..len(widths) {
			let w = widths[s]
			let h = heights[s]
			mut gray = image.NewGray(image.Rect(0, 0, w, h))
			mut rgba = image.NewRGBA(image.Rect(0, 0, w, h))
			for y in 0..h {
				for x in 0..w {
					gray.SetGray(x, y, color.Gray{Y: u8((x*37 + y*53 + 11) % 256)})
					rgba.SetRGBA(x, y, color.RGBA{R: u8((x*37 + y*13 + 7) % 256), G: u8((x*11 + y*47 + 19) % 256), B: u8((x*23 + y*29 + 31) % 256), A: 255})
				}
			}
			let suffix = "-q" + mint.Itoa(quality) + "-" + mint.Itoa(w) + "x" + mint.Itoa(h)
			say.Line("tin-gray" + suffix + "|" + seal.Hex([]u8(jpeg.Encode(gray, quality))))
			say.Line("tin-color" + suffix + "|" + seal.Hex([]u8(jpeg.Encode(rgba, quality))))
		}
	}
}
