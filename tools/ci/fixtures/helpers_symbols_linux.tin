package helperprobe
import "say"

// Symbols checks linker ranges, relocations and the name at every function boundary.
fn Symbols() {
	let table = __tin_symbols()
	let base = __image_base()
	let info = calloc(4, 8)
	if table[0] < 20 || rt_symbol_lookup(0, info) != 0 { panic("symbol table") }
	for i in i64(0)..table[0] {
		let rec = table+8+i*24
		if rec[0] >= rec[1] || strlen(base+rec[2]) == 0 { panic("symbol range") }
		for _, pc in []i64{rec[0], rec[1]-1} {
			if rt_symbol_lookup(base+pc, info) == 0 || info[2] != base+rec[2] { panic("symbol boundary") }
		}
		if i+1 == table[0] {
			if rt_symbol_lookup(base+rec[1], info) != 0 { panic("symbol final end") }
		} else {
			let next = table+8+(i+1)*24
			if rec[1] > next[0] { panic("symbol overlap") }
			let found = rt_symbol_lookup(base+rec[1], info)
			if rec[1] == next[0] && (found == 0 || info[2] != base+next[2]) { panic("symbol adjacent end") }
			if rec[1] < next[0] && found != 0 { panic("symbol gap") }
		}
	}
	free(info)
	say.Line("symbols bounded")
}
