package main

// The hash twin, Tin side: read the hex corpus of bench/ref/hash (Go's hash/crc64 and
// compress/lzw) on stdin and print the same lines, so tools/ci/hash_check.py can compare them
// (#754).
//
//	P <hex>            crc64: ECMA and ISO of the data, and the same chained over two halves
//	Z <order> <hex>    lzw: the encoding of the data and the decoding of that encoding

import "say"
import "quarry"
import "seal"
import "squash"
import "stamp"

fn main() {
	let body = quarry.ReadStdin() catch err {
		say.Line("fault", err)
		return
	}
	mut start = i64(0)
	mut i = i64(0)
	for i <= i64(len(body)) {
		if i < i64(len(body)) && body[i] != '\n' {
			i += 1
			continue
		}
		let line = body[start:i]
		start = i + 1
		i += 1
		if len(line) == 0 {
			continue
		}
		run(line)
	}
}

// run handles one corpus line.
fn run(line str) {
	let parts = splitSpace(line)
	if len(parts) == 0 {
		return
	}
	if parts[0] == "P" {
		let raw = unhex(argOf(parts, 1))
		let half = i64(len(raw)) / 2
		let first = raw[0:half]
		let second = raw[half:i64(len(raw))]
		say.Line("P", hex64(stamp.Crc64ECMA(raw)), hex64(stamp.Crc64ISO(raw)),
			hex64(stamp.Crc64ECMAUpdate(stamp.Crc64ECMAUpdate(0, first), second)),
			hex64(stamp.Crc64ISOUpdate(stamp.Crc64ISOUpdate(0, first), second)))
	} else if parts[0] == "Z" {
		let order = parseInt(argOf(parts, 1))
		let raw = unhex(argOf(parts, 2))
		let enc = squash.Lzw(raw, order)
		let dec = squash.Unlzw(enc, order, 64*1024*1024) catch err {
			say.Line("Z", seal.Hex([]u8(enc)), "fault", err)
			return
		}
		say.Line("Z", seal.Hex([]u8(enc)), seal.Hex([]u8(dec)))
	}
}

// hex64 is a 16-digit lowercase hex number.
fn hex64(v u64) str {
	return say.Fmt("%016x", v)
}

// argOf is the argument at i, or "" when the line has none.
fn argOf(parts []str, i i64) str {
	if i < i64(len(parts)) {
		return parts[i]
	}
	return ""
}

// splitSpace splits a line on spaces.
fn splitSpace(line str) []str {
	mut out = []str{}
	mut start = i64(0)
	mut i = i64(0)
	for i <= i64(len(line)) {
		if i == i64(len(line)) || line[i] == ' ' {
			if i > start {
				out = append(out, line[start:i])
			}
			start = i + 1
		}
		i += 1
	}
	return out
}

// unhex decodes a lowercase hex string.
fn unhex(s str) str {
	let b = seal.HexDecode(s) catch _ {
		return ""
	}
	return str(b)
}

// parseInt parses a non-negative decimal number.
fn parseInt(s str) i64 {
	mut v = i64(0)
	for i in 0..len(s) {
		if s[i] < '0' || s[i] > '9' {
			return v
		}
		v = v*10 + i64(s[i]) - '0'
	}
	return v
}
