package main

import "anvil"
import "flume"
import "mint"
import "mysql"
import "postgres"
import "quarry"
import "redis"
import "relay"
import "say"
import "tide"
import "websocket"
import "wire"

// Every client points at a server that accepts and never answers (cancel_check.py).
let hole = quarry.Getenv("HOLE_ADDR")
let rc = redis.Open(redis.Options{Addr: quarry.Getenv("HOLE_ADDR")})
let mc = mysql.Open(mysql.Options{Addr: quarry.Getenv("HOLE_ADDR"), User: "tin", Pool: 1})
let pc = postgres.Open(postgres.Options{Addr: quarry.Getenv("HOLE_ADDR"), User: "tin", Pool: 1})

fn slot(q anvil.Req) i64 {
	let i = mint.Atoi(q.PathParam("i")) catch _ { 0 }
	return i
}

// wait_in waits in one client until the wait fails.
fn wait_in(kind str) ! {
	match kind {
		"tide" => {
			try tide.Wait(10s)
		}
		"wire" => {
			mut c = try wire.Dial(hole)
			let buf = make([]u8, 16)
			let n = try c.Read(mut buf, 16)
			say.Line(n)
		}
		"redis" => {
			mut r = try rc.Do("GET k")
			say.Line(r)
		}
		"mysql" => {
			mut r = try mc.Exec("SELECT 1")
			say.Line(r)
		}
		"postgres" => {
			mut r = try pc.Exec("SELECT 1")
			say.Line(r)
		}
		"websocket" => {
			let c = try websocket.Dial("ws://{hole}/")
			say.Line(c)
		}
		"file" => {
			mut s = try quarry.ReadFile(quarry.Getenv("FIFO"))
			say.Line(len(s))
		}
		"relay" => {
			let (from, msg) = try relay.Next()
			say.Line(from, msg)
		}
		"stdin" => {
			let s = try quarry.ReadStdin()
			say.Line(len(s))
		}
		"flume" => {
			let r = flume.New(0)
			let (line, ok) = try r.Line()
			say.Line(line, ok)
		}
	}
}

// park waits in a client; /cancel/{i} cancels it.
fn park(q anvil.Req, w mut anvil.Out) {
	tide.ProbeMark(slot(q))
	wait_in(q.PathParam("kind")) catch err {
		w.Text("fault: {err}")
		return
	}
	w.Text("no fault")
}

fn cancel(q anvil.Req, w mut anvil.Out) {
	tide.ProbeCancel(slot(q), "test reason {slot(q)}")
	w.Text("ok")
}

// nested cancels an inner block only: the request's own boundary must stay live.
fn nested(q anvil.Req, w mut anvil.Out) {
	let outer = tide.ProbeCurrent()
	let b = tide.ProbeEnter()
	tide.ProbeMark(slot(q))
	mut inner = ""
	tide.Wait(10s) catch err {
		inner = say.Str(err)
	}
	tide.ProbeLeave(b)
	mut after = "ok"
	tide.Wait(1ms) catch err {
		after = say.Str(err)
	}
	w.Text("inner: {inner}; outer: [{tide.ProbeCanceled(outer)}]; after: {after}")
}

// outer cancels the request's boundary while a block inside it waits.
fn outer(q anvil.Req, w mut anvil.Out) {
	tide.ProbeMark(slot(q))
	let b = tide.ProbeEnter()
	mut inner = ""
	tide.Wait(10s) catch err {
		inner = say.Str(err)
	}
	let reason = tide.ProbeCanceled(b)
	tide.ProbeLeave(b)
	mut again = "ok"
	tide.Wait(1ms) catch err {
		again = say.Str(err)
	}
	w.Text("inner: {inner}; block: {reason}; again: {again}")
}

// within gives a block a 50 ms deadline inside the request's longer one.
fn within_(q anvil.Req, w mut anvil.Out) {
	let b = tide.ProbeEnter()
	tide.ProbeDeadline(b, 50)
	let start = tide.Now()
	mut inner = ""
	tide.Wait(10s) catch err {
		inner = say.Str(err)
	}
	let ms = (tide.Now() - start) / tide.Millisecond
	tide.ProbeLeave(b)
	mut after = "ok"
	tide.Wait(1ms) catch err {
		after = say.Str(err)
	}
	w.Text("inner: {inner}; ms: {ms}; after: {after}")
}

// within_in gives a block a 50 ms deadline around a wait in one client (#316).
fn within_in(q anvil.Req, w mut anvil.Out) {
	let b = tide.ProbeEnter()
	tide.ProbeDeadline(b, 50)
	let start = tide.Now()
	mut inner = "no fault"
	wait_in(q.PathParam("kind")) catch err {
		inner = say.Str(err)
	}
	let ms = (tide.Now() - start) / tide.Millisecond
	tide.ProbeLeave(b)
	mut after = "ok"
	tide.Wait(1ms) catch err {
		after = say.Str(err)
	}
	w.Text("inner: {inner}; ms: {ms}; after: {after}")
}

// relay_next waits in relay.Next until /relay-send gives this core a message (#316).
fn relay_next(q anvil.Req, w mut anvil.Out) {
	let (from, msg) = relay.Next() catch err {
		w.Text("fault: {err}")
		return
	}
	w.Text("from {from}: {msg}")
}

fn relay_send(q anvil.Req, w mut anvil.Out) {
	relay.Send(relay.Me(), q.PathParam("msg"))
	w.Text("sent")
}

// hog holds about 64 MiB of request memory, past a TIN_REQUEST_MEMORY budget (it keeps each
// block: one dropped in its loop would go back when the iteration ends, #633).
fn hog(q anvil.Req, w mut anvil.Out) {
	mut held = make([][]i64, 0, 0)
	mut total = 0
	for i in 0..8 {
		let xs = make([]i64, 1000000)
		held = append(held, xs)
		total += len(xs)
	}
	w.Text("hogged {total} in {len(held)}")
}

fn cpu_deferred() {
	say.Line("cpu cancel deferred")
}

// cpu_cancel never waits after cancelling its own request.
fn cpu_cancel(q anvil.Req, w mut anvil.Out) {
	defer cpu_deferred()
	tide.ProbeMark(31)
	tide.ProbeCancel(31, "cpu stop")
	for {
	}
}

fn plain(q anvil.Req, w mut anvil.Out) {
	tide.Wait(1ms) catch err {
		w.Text("fault: {err}")
		return
	}
	w.Text("plain ok")
}

fn main() {
	let r = anvil.NewRouter()
	r.Get(`/park/{i}/{kind}`, park)
	r.Get(`/cancel/{i}`, cancel)
	r.Get(`/nested/{i}`, nested)
	r.Get(`/outer/{i}`, outer)
	r.Get(`/within`, within_)
	r.Get(`/within/{kind}`, within_in)
	r.Get(`/relay-next`, relay_next)
	r.Get(`/relay-send/{msg}`, relay_send)
	r.Get(`/plain`, plain)
	r.Get(`/hog`, hog)
	r.Get(`/cpu-cancel`, cpu_cancel)
	let err = r.Serve(":0")
	say.Line(err)
}
