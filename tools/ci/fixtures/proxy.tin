package main

import "anvil"
import "fault"
import "mint"
import "proxy"
import "quarry"
import "say"

fn echo(q anvil.Req, w mut anvil.Out) {
	let reader = q.BodyStream()
	mut count = 0
	mut buf = make([]u8, 32768)
	for {
		let (n, err) = reader.Read(mut buf)
		if err != nil { w.Status(400)
			return }
		if n == 0 { break }
		count += n
	}
	w.Text("len=" + mint.Itoa(count))
}

fn large(q anvil.Req, w mut anvil.Out) {
	w.Head("X-Seen-Forwarded-For", q.Header("X-Forwarded-For"))
	w.Head("X-Seen-Secret", q.Header("X-Secret"))
	w.Head("X-Seen-Proxy-Hop", q.Header("Proxy-Hop"))
	w.Stream() catch _ { return }
	mut piece = make([]u8, 32768)
	for i in 0..len(piece) { piece[i] = u8('x') }
	for i in 0..128 {
		w.Write(piece) catch _ { return }
	}
}

// cut sends the first chunk of a chunked body and aborts it, so the connection closes before the last chunk (#739).
fn cut(q anvil.Req, w mut anvil.Out) {
	w.Type("text/csv; charset=utf-8")
	w.Stream() catch _ { return }
	w.WriteString("hello") catch _ { return }
	w.Abort()
}

// cutLength sends part of a body of 10 bytes and aborts it, so the connection closes short of the Content-Length.
fn cutLength(q anvil.Req, w mut anvil.Out) {
	w.Type("text/csv; charset=utf-8")
	w.Stream() catch _ { return }
	w.Length(10) catch _ { return }
	w.WriteString("hello") catch _ { return }
	w.Abort()
}

// typed answers with a body whose Content-Type is set.
fn typed(q anvil.Req, w mut anvil.Out) {
	w.Json()
	w.Text("{{}}")
}

fn repeated(n i64) str {
	mut b = make([]u8, n)
	for i in 0..n { b[i] = u8(i % 251) }
	return str(b)
}

fn metadata(q anvil.Req, w mut anvil.Out) {
	w.Head("X-Seen-Forwarded-For", q.Header("X-Forwarded-For"))
	w.Head("X-Seen-Secret", q.Header("X-Secret"))
	w.Head("X-Seen-Proxy-Hop", q.Header("Proxy-Hop"))
	w.Text("ok")
}

fn main() {
	let role = quarry.Getenv("PROXY_ROLE")
	let port = quarry.Getenv("PORT")
	let r = anvil.NewRouter()
	if role == "backend" {
		r.Stream("POST", "/echo", echo)
		r.Get("/meta", metadata)
		r.Get("/large", large)
		r.Get("/cut", cut)
		r.Get("/cut-length", cutLength)
		r.Get("/typed", typed)
		r.Serve(":" + port) catch err { say.Line(err) }
		return
	}
	mut p = proxy.New(quarry.Getenv("UPSTREAM"))
	p.ErrorHandler = fn(q anvil.Req, w mut anvil.Out, err fault) {
		say.Line("proxy error: " + say.Str(err))
		proxy.DefaultErrorHandler(q, mut w, err)
	}
	r.Stream("POST", "/echo", p.ServeHTTP)
	r.Get("/meta", p.ServeHTTP)
	r.Get("/large", p.ServeHTTP)
	r.Get("/cut", p.ServeHTTP)
	r.Get("/cut-length", p.ServeHTTP)
	r.Get("/typed", p.ServeHTTP)
	r.Serve(":" + port) catch err { say.Line(err) }
}
