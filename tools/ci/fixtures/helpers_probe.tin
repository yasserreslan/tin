package helperprobe
import "say"

// Calendar checks UTC fields and the complete existing Date header.
fn Calendar(now i64) {
	let fields = rt_alloc(56)
	rt_calendar(now, fields)
	say.Out("%d %d %d %d %d %d %d %q\n", fields[0], fields[1], fields[2], fields[3], fields[4], fields[5], fields[6], rt_http_date(now))
}
// Error copies each message before formatting so the table stays immutable.
fn Error(n i64) {
	let raw = rt_sys_strerror(n)
	say.Out("%d %q\n", n, rt_str_from_raw(raw, strlen(raw)))
}
// TTY checks inherited PTYs, pipes, files and invalid descriptors.
fn TTY(fd i64) { say.Line(rt_isatty(fd)) }
// CPUs checks the affinity count and the final quota-aware choice.
fn CPUs() { say.Line(rt_ncpus(), rt_page_size()) }
