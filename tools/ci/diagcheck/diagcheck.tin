// Diagnostic codes (#244): the compiler, toolchain/docs/ERRORS.md and the expected diagnostics agree.
//
// Without a compiler it checks the codes only: every code the compiler prints (a string such as "E502 TYPE_ARG_COUNT" in
// toolchain/compiler/*.tin) is documented under that name, every documented code is printed by the compiler or retired, a number and a
// name each belong to one code, the compiler prints no error without a code, and every line of the tests' expected diagnostics carries
// a documented code. Given a compiler, it also compiles each documented example and requires exactly the output the page shows.
package diagcheck

import "../ci"
import "mint"
import "say"
import "tinjson"
import "twine"

const DOC = "toolchain/docs/ERRORS.md"

// EDITION: examples use the syntax toolchain/docs/LANGUAGE.md describes; a ```tin edition=1 block uses edition 1.
const EDITION = "0"

// Block is a fenced block of an entry: its language, text, edition and the file it is written to (HasName), if any.
type Block struct {
	Kind str
	Body str
	Edition str
	Name str
	HasName bool
}

// Entry is a documented code.
type Entry struct {
	Code str
	Name str
	Line i64
	Group str
	Retired bool
	Unexampled bool
	Fix str
	HasFix bool
	Blocks []Block
}

fn isDigit(c u8) bool {
	return c >= '0' && c <= '9'
}

fn isUpper(c u8) bool {
	return c >= 'A' && c <= 'Z'
}

fn isWordByte(c u8) bool {
	return c == '_' || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || isDigit(c)
}

// codeAt reads "E123 NAME" at the start of the text (NAME: capital, then capitals, digits and underscores); it returns the code, the
// name and how many bytes it used, or ok false.
fn codeAt(s str) (str, str, i64, bool) {
	if len(s) < 7 || s[0] != 'E' || !isDigit(s[1]) || !isDigit(s[2]) || !isDigit(s[3]) || s[4] != ' ' || !isUpper(s[5]) {
		return "", "", 0, false
	}
	mut j = 6
	for j < len(s) && (isUpper(s[j]) || isDigit(s[j]) || s[j] == '_') {
		j += 1
	}
	return s[0:4], s[5:j], j, true
}

// sourceCodes are the (code, name) pairs of the quoted strings "E123 NAME" in a line.
fn sourceCodes(line str) ([]str, []str) {
	mut codes = []str{}
	mut names = []str{}
	mut from = 0
	for from < len(line) {
		let at = twine.IndexByte(line[from:], '"')
		if at < 0 {
			break
		}
		let start = from + at + 1
		let (code, name, used, ok) = codeAt(line[start:])
		if ok && start + used < len(line) && line[start + used] == '"' {
			codes = append(codes, code)
			names = append(names, name)
		}
		from = start
	}
	return codes, names
}

// printed are the (code, name) pairs of "error E123 NAME: " in a line.
fn printed(line str) ([]str, []str) {
	mut codes = []str{}
	mut names = []str{}
	mut from = 0
	for from < len(line) {
		let at = twine.Index(line[from:], "error E")
		if at < 0 {
			break
		}
		let start = from + at
		let boundary = start == 0 || !isWordByte(line[start - 1])
		let (code, name, used, ok) = codeAt(line[start + 6:])
		if boundary && ok && twine.HasPrefix(line[start + 6 + used:], ": ") {
			codes = append(codes, code)
			names = append(names, name)
		}
		from = start + 6
	}
	return codes, names
}

// uncoded reports whether the line has "error: " at its start or after ": ".
fn uncoded(line str) bool {
	if twine.HasPrefix(line, "error: ") {
		return true
	}
	return twine.Contains(line, ": error: ")
}

fn hasWord(text str, prefix str) (str, bool) {
	let at = twine.Index(text, prefix)
	if at < 0 {
		return "", false
	}
	if at > 0 && isWordByte(text[at - 1]) {
		return "", false
	}
	return text[at + len(prefix):], true
}

fn digitsAt(s str) str {
	mut j = 0
	for j < len(s) && isDigit(s[j]) {
		j += 1
	}
	return s[0:j]
}

// ParseDoc reads the entries of the page in order.
fn ParseDoc(text str) ![]Entry {
	mut entries = []Entry{}
	mut have = false
	mut entry = Entry{Code: "", Name: "", Line: 0, Group: "", Retired: false, Unexampled: false, Fix: "", HasFix: false, Blocks: []Block{}}
	mut group = ""
	mut fence = ""
	mut inFence = false
	mut body = ""
	mut edition = EDITION
	mut fileName = ""
	mut hasFile = false
	mut fixOpen = false
	let lines = twine.Split(text, "\n")
	mut count = len(lines)
	if count > 0 && len(lines[count - 1]) == 0 {
		count -= 1
	}
	for n in 0..count {
		let number = n + 1
		let line = lines[n]
		if inFence {
			if twine.HasPrefix(line, "```") {
				if have {
					entry.Blocks = append(entry.Blocks, Block{Kind: fence, Body: body, Edition: edition, Name: fileName, HasName: hasFile})
				}
				inFence = false
				body = ""
			} else {
				body += line + "\n"
			}
			continue
		}
		if have && fixOpen {
			if len(twine.TrimSpace(line)) > 0 {
				entry.Fix = entry.Fix + " " + twine.TrimSpace(line)
				continue
			}
			fixOpen = false
		}
		if have && twine.HasPrefix(line, "Fix: ") && !entry.HasFix {
			entry.Fix = twine.TrimRight(line[5:], " \t\r\n")
			entry.HasFix = true
			fixOpen = true
			continue
		}
		if twine.HasPrefix(line, "```") {
			mut j = 3
			for j < len(line) && isWordByte(line[j]) {
				j += 1
			}
			fence = line[3:j]
			let rest = line[j:]
			edition = EDITION
			let (afterEdition, hasEdition) = hasWord(rest, "edition=")
			if hasEdition && len(digitsAt(afterEdition)) > 0 {
				edition = digitsAt(afterEdition)
			}
			hasFile = false
			fileName = ""
			let (afterFile, hasFileAttr) = hasWord(rest, "file=")
			if hasFileAttr {
				mut k = 0
				for k < len(afterFile) && !isSpace(afterFile[k]) {
					k += 1
				}
				if k > 0 {
					fileName = afterFile[0:k]
					hasFile = true
				}
			}
			inFence = true
			body = ""
			continue
		}
		if twine.HasPrefix(line, "### E") {
			let (code, name, used, ok) = codeAt(line[4:])
			if ok && 4 + used == len(line) {
				if have {
					entries = append(entries, entry)
				}
				entry = Entry{Code: code, Name: name, Line: number, Group: group, Retired: false, Unexampled: false, Fix: "", HasFix: false, Blocks: []Block{}}
				have = true
				continue
			}
		}
		if twine.HasPrefix(line, "## ") || twine.HasPrefix(line, "# ") {
			group = ""
			// "## E5xx ..."
			if len(line) > 8 && line[3] == 'E' && isDigit(line[4]) && line[5] == 'x' && line[6] == 'x' && line[7] == ' ' {
				group = line[4:5]
			}
			if have {
				entries = append(entries, entry)
				have = false
			}
			continue
		}
		if have && twine.HasPrefix(line, "Retired") {
			entry.Retired = true
		}
		if have && twine.HasPrefix(line, "No example:") {
			entry.Unexampled = true
		}
	}
	if inFence {
		fail say.Fault("%s", DOC + ": unterminated code block")
	}
	if have {
		entries = append(entries, entry)
	}
	return entries
}

fn isSpace(c u8) bool {
	return c == ' ' || c == '\t' || c == '\r' || c == '\n' || c == '\v' || c == '\f'
}

// Example is the program of an entry (HasProgram false when a command runs without one), its edition and expected output; Why is the
// problem when the entry has no usable example.
type Example struct {
	Program str
	HasProgram bool
	Edition str
	Output str
	Why str
}

fn ExampleOf(entry Entry) Example {
	mut programs = []Block{}
	mut outputs = []str{}
	mut commands = []str{}
	for b in entry.Blocks {
		if b.HasName {
			continue
		}
		if b.Kind == "tin" {
			programs = append(programs, b)
		} else if b.Kind == "text" {
			outputs = append(outputs, b.Body)
		} else if b.Kind == "sh" {
			commands = append(commands, b.Body)
		}
	}
	let bad = Example{Program: "", HasProgram: false, Edition: "", Output: "", Why: "needs exactly one ```tin example (or ```sh command) and one ```text output"}
	if len(programs) > 1 || len(outputs) != 1 || len(commands) > 1 || (len(programs) == 0 && len(commands) == 0) {
		return bad
	}
	if len(commands) > 0 {
		let words = twine.Fields(commands[0])
		mut runsTinc = false
		for w in words {
			if w == "tinc" {
				runsTinc = true
			}
		}
		if len(ci.Lines(commands[0])) != 1 || !runsTinc {
			return Example{Program: "", HasProgram: false, Edition: "", Output: "", Why: "a ```sh command is one line that runs tinc"}
		}
	}
	if len(programs) == 0 {
		return Example{Program: "", HasProgram: false, Edition: EDITION, Output: outputs[0], Why: ""}
	}
	return Example{Program: programs[0].Body, HasProgram: true, Edition: programs[0].Edition, Output: outputs[0], Why: ""}
}

// Command is the environment additions (NAME=value words) and the argv that compile an entry's example.
type Command struct {
	Env []str
	Argv []str
}

fn CommandOf(entry Entry, compiler str, edition str) Command {
	for b in entry.Blocks {
		if b.Kind == "sh" && !b.HasName {
			let words = twine.Fields(b.Body)
			mut at = 0
			for i in 0..len(words) {
				if words[i] == "tinc" {
					at = i
					break
				}
			}
			mut env = []str{}
			for w in words[0:at] {
				env = append(env, w)
			}
			mut argv = []str{compiler}
			for w in words[at + 1:] {
				argv = append(argv, w)
			}
			return Command{Env: env, Argv: argv}
		}
	}
	return Command{Env: []str{}, Argv: []str{compiler, "-edition", edition, "-o", "example", "example.tin"}}
}

fn hasCode(entries []Entry, code str) i64 {
	for i in 0..len(entries) {
		if entries[i].Code == code {
			return i
		}
	}
	return -1
}

fn contains(xs []str, x str) bool {
	for y in xs {
		if y == x {
			return true
		}
	}
	return false
}

// CheckDoc checks the page's own consistency; problems are appended.
fn CheckDoc(entries []Entry, problems mut []str) {
	mut codes = []str{}
	mut names = []str{}
	mut owners = []str{}
	mut last = -1
	for e in entries {
		let where = DOC + ":" + mint.Itoa(e.Line) + ": " + e.Code + " " + e.Name
		let number = ci.Num(e.Code[1:])
		if contains(codes, e.Code) {
			problems = append(problems, where + ": code documented twice")
		}
		for k in 0..len(names) {
			if names[k] == e.Name {
				problems = append(problems, where + ": name already used by " + owners[k])
			}
		}
		if number <= last {
			problems = append(problems, where + ": entries must be in code order")
		}
		if e.Group != e.Code[1:2] {
			problems = append(problems, where + ": belongs under the heading ## E" + e.Code[1:2] + "xx")
		}
		last = number
		codes = append(codes, e.Code)
		names = append(names, e.Name)
		owners = append(owners, e.Code)
		if e.Retired || e.Unexampled {
			continue
		}
		let ex = ExampleOf(e)
		if len(ex.Why) > 0 {
			problems = append(problems, where + ": " + ex.Why)
			continue
		}
		let (found, foundNames) = printed(ex.Output)
		mut shows = false
		for k in 0..len(found) {
			if found[k] == e.Code && foundNames[k] == e.Name {
				shows = true
			}
		}
		if !shows {
			problems = append(problems, where + ": the example output does not show this code")
		}
	}
}

// Used is a code string of the compiler's sources with where it is.
type Used struct {
	Code str
	Name str
	Site str
}

fn compilerFiles(root str) []str {
	mut files = []str{}
	for name in ci.Names(ci.Join(root, "toolchain/compiler"), ".tin") {
		files = append(files, ci.Join(root, "toolchain/compiler/" + name))
	}
	return files
}

fn relative(path str, root str) str {
	return twine.TrimPrefix(path, root + "/")
}

fn sourceUsed(root str) []Used {
	mut used = []Used{}
	for path in compilerFiles(root) {
		let lines = ci.Lines(ci.Read(path))
		for n in 0..len(lines) {
			let (codes, names) = sourceCodes(lines[n])
			for k in 0..len(codes) {
				used = append(used, Used{Code: codes[k], Name: names[k], Site: relative(path, root) + ":" + mint.Itoa(n + 1)})
			}
		}
	}
	return used
}

// Expectation is an expected diagnostic line of the tests; Whole is false for a stderr_contains contract (part of a line).
type Expectation struct {
	Where str
	Text str
	Whole bool
}

fn expectedDiagnostics(root str) []Expectation {
	mut found = []Expectation{}
	for dir in []str{"toolchain/tests/v2", "toolchain/tests/edition1"} {
		for name in ci.Names(ci.Join(root, dir), ".err") {
			let path = ci.Join(root, dir + "/" + name)
			let lines = ci.Lines(ci.Read(path))
			for n in 0..len(lines) {
				found = append(found, Expectation{Where: relative(path, root) + ":" + mint.Itoa(n + 1), Text: lines[n], Whole: true})
			}
		}
	}
	let cases = ci.Join(root, "toolchain/tests/regressions/cases.json")
	if ci.Exists(cases) {
		let (j, ok) = tinjson.Parse(ci.Read(cases))
		if ok {
			for c in j.Items() {
				let expected = c.Get("expected")
				if expected.Get("phase").Text() != "compile" {
					continue
				}
				for key in []str{"stderr", "stderr_contains"} {
					for line in ci.Lines(expected.Get(key).Text()) {
						found = append(found, Expectation{Where: relative(cases, root) + ": " + c.Get("source").Text(), Text: line, Whole: key == "stderr"})
					}
				}
			}
		}
	}
	return found
}

// Static is the result of the text check.
type Static struct {
	Problems []str
	Entries []Entry
	Coded i64
	Uncoded i64
}

fn CheckStatic(root str) Static {
	mut problems = []str{}
	let entries = ParseDoc(ci.Read(ci.Join(root, DOC))) catch err {
		return Static{Problems: []str{say.Str(err)}, Entries: []Entry{}, Coded: 0, Uncoded: 0}
	}
	CheckDoc(entries, mut problems)
	let used = sourceUsed(root)
	mut codeNames = [][]str{}
	mut codeKeys = []str{}
	mut nameCodes = [][]str{}
	mut nameKeys = []str{}
	for u in used {
		let k = hasCode(entries, u.Code)
		if k < 0 {
			problems = append(problems, u.Site + ": " + u.Code + " " + u.Name + " is not documented in " + DOC)
		} else if entries[k].Name != u.Name {
			problems = append(problems, u.Site + ": " + u.Code + " is " + entries[k].Name + " in " + DOC + ", not " + u.Name)
		} else if entries[k].Retired {
			problems = append(problems, u.Site + ": " + u.Code + " " + u.Name + " is retired; a code is never reused")
		}
		let ci_ = indexOf(codeKeys, u.Code)
		if ci_ < 0 {
			codeKeys = append(codeKeys, u.Code)
			codeNames = append(codeNames, []str{u.Name})
		} else if !contains(codeNames[ci_], u.Name) {
			codeNames[ci_] = append(codeNames[ci_], u.Name)
		}
		let ni = indexOf(nameKeys, u.Name)
		if ni < 0 {
			nameKeys = append(nameKeys, u.Name)
			nameCodes = append(nameCodes, []str{u.Code})
		} else if !contains(nameCodes[ni], u.Code) {
			nameCodes[ni] = append(nameCodes[ni], u.Code)
		}
	}
	for i in 0..len(codeKeys) {
		if len(codeNames[i]) > 1 {
			problems = append(problems, "the compiler prints " + codeKeys[i] + " with several names: " + twine.Join(sortedStrs(codeNames[i]), ", "))
		}
	}
	for i in 0..len(nameKeys) {
		if len(nameCodes[i]) > 1 {
			problems = append(problems, "the compiler prints " + nameKeys[i] + " with several codes: " + twine.Join(sortedStrs(nameCodes[i]), ", "))
		}
	}
	for e in entries {
		if !e.Retired && !contains(codeKeys, e.Code) {
			problems = append(problems, DOC + ":" + mint.Itoa(e.Line) + ": " + e.Code + " " + e.Name + " is not printed by the compiler (mark it retired; never delete or reuse a code)")
		}
	}
	for path in compilerFiles(root) {
		let lines = ci.Lines(ci.Read(path))
		for n in 0..len(lines) {
			if twine.Contains(lines[n], "\"error: ") {
				problems = append(problems, relative(path, root) + ":" + mint.Itoa(n + 1) + ": prints an error without a code (use err_code and a code from toolchain/docs/ERRORS.md)")
			}
		}
	}
	mut coded = 0
	mut bare = 0
	for x in expectedDiagnostics(root) {
		let (codes, names) = printed(x.Text)
		for k in 0..len(codes) {
			let e = hasCode(entries, codes[k])
			if e < 0 || entries[e].Name != names[k] {
				problems = append(problems, x.Where + ": " + codes[k] + " " + names[k] + " is not documented in " + DOC)
			}
		}
		if len(codes) > 0 {
			coded += 1
		} else if x.Whole || uncoded(x.Text) {
			bare += 1
			problems = append(problems, x.Where + ": an expected diagnostic without a code: " + x.Text)
		}
	}
	return Static{Problems: problems, Entries: entries, Coded: coded, Uncoded: bare}
}

fn indexOf(xs []str, x str) i64 {
	for i in 0..len(xs) {
		if xs[i] == x {
			return i
		}
	}
	return -1
}

fn sortedStrs(xs []str) []str {
	mut out = []str{}
	for x in xs {
		out = append(out, x)
	}
	for i in 1..len(out) {
		let x = out[i]
		mut j = i - 1
		for j >= 0 && out[j] > x {
			out[j + 1] = out[j]
			j -= 1
		}
		out[j + 1] = x
	}
	return out
}

// Fix is the Fix: paragraph of a code on the page ("" when it has none).
fn Fix(entries []Entry, code str) str {
	let k = hasCode(entries, code)
	if k < 0 {
		return ""
	}
	return entries[k].Fix
}

// TextError is a diagnostic of the text form: file, line, column, code, name and message.
type TextError struct {
	File str
	Line str
	Col str
	Code str
	Name str
	Message str
	Ok bool
}

// ParseTextError reads "[FILE:LINE[:COL]: ]error E123 NAME: message".
fn ParseTextError(line str) TextError {
	let none = TextError{File: "", Line: "", Col: "", Code: "", Name: "", Message: "", Ok: false}
	mut at = -1
	mut from = 0
	for from < len(line) {
		let k = twine.Index(line[from:], "error E")
		if k < 0 {
			break
		}
		let start = from + k
		let (code, name, used, ok) = codeAt(line[start + 6:])
		if ok && twine.HasPrefix(line[start + 6 + used:], ": ") && (start == 0 || twine.HasSuffix(line[0:start], ": ")) {
			at = start
			break
		}
		from = start + 6
	}
	if at < 0 {
		return none
	}
	let (code, name, used, _) = codeAt(line[at + 6:])
	let message = line[at + 6 + used + 2:]
	mut file = ""
	mut lineNo = ""
	mut col = ""
	if at > 0 {
		let prefix = line[0:at - 2]
		// FILE:LINE or FILE:LINE:COL, FILE as short as it can be
		let last = twine.LastIndex(prefix, ":")
		if last < 0 {
			return none
		}
		let tail = prefix[last + 1:]
		if len(tail) == 0 || len(digitsAt(tail)) != len(tail) {
			return none
		}
		let head = prefix[0:last]
		let prev = twine.LastIndex(head, ":")
		if prev >= 0 && len(head[prev + 1:]) > 0 && len(digitsAt(head[prev + 1:])) == len(head[prev + 1:]) {
			file = head[0:prev]
			lineNo = head[prev + 1:]
			col = tail
		} else {
			file = head
			lineNo = tail
		}
	}
	return TextError{File: file, Line: lineNo, Col: col, Code: code, Name: name, Message: message, Ok: true}
}
