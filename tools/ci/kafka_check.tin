package main

import "./ci"
import "./nettest"
import "mint"
import "say"
import "tide"

// Kafka client connections in an event loop (#445): the fixture (tools/ci/fixtures/kafka_conn.tin, one core) runs a fake broker as
// tasks beside its handlers, and GET /run checks what needs a client's waits to overlap with other tasks: Close from another task
// ends a held fetch at once (ErrClosed, not retried), one group's held JoinGroup holds up no fetch, and a caller whose own deadline
// ends a handshake leaves the callers queued behind it their requests. The rest of #445 (request timeouts, reused connections, more
// clients, TLS reads, KIP-368) is in the strict suite: toolchain/tests/v2/kafka_conn.tin.

fn main() {
	let out = ci.Join(ci.Root(), "bin/ci/kafka")
	ci.Mkdirs(out)
	let exe = ci.Join(out, "server")
	ci.BuildTin("tools/ci/fixtures/kafka_conn.tin", exe, "", []str{})
	let port = nettest.Port()
	let server = nettest.Start(exe, []str{}, []str{"TIN_CORES=1"}, ci.Join(out, "server.log"), port)
	server.Ready(10)
	let start = tide.Now()
	let r = nettest.Parse(nettest.Raw(port, nettest.GetRequest("/run"), 60))
	let took = (tide.Now() - start) / 100000000
	let lines = ci.Lines(r.Body)
	for line in lines {
		say.Line(line)
	}
	ci.Check(r.Status == 200, "kafka: status " + mint.Itoa(r.Status) + " " + r.Body)
	ci.Check(len(lines) == 5, "kafka: " + mint.Itoa(len(lines)) + " lines")
	for line in lines {
		ci.Check(line[0:3] == "ok ", "kafka: " + line)
	}
	ci.Check(server.Running(), "kafka: the server exited")
	server.Stop()
	ci.Pass("kafka: connections in an event loop (" + mint.Itoa(took / 10) + "." + mint.Itoa(took % 10) + " s)")
}
