package main

import "../../bench/benchlib"
import "./ci"
import "mint"
import "say"
import "twine"

// Benchmark correctness, revision isolation and noisy/failing process handling.

// The scripted runner: run number n reports the n-th scripted time and output. order records which command ran (1 base, 2 head).
mut calls i64
mut order i64
mut scenario i64

fn scriptedSeconds(n i64) f64 {
	if scenario == 0 {
		let base = []f64{10.0, 1.0, 3.0}
		let head = []f64{2.0, 20.0, 4.0}
		return base[0]
	}
	return 0.0
}

fn scripted(c benchlib.Command) !benchlib.Timed {
	calls += 1
	mut which = 1
	if c.Argv[0] == "head" {
		which = 2
	}
	order = order * 10 + which
	mut seconds = 0.0
	mut out = "same\n"
	if scenario == 0 {
		// base takes 10, 1, 3 and head 2, 20, 4
		let n = (calls + 1) / 2
		let base = []f64{10.0, 1.0, 3.0}
		let head = []f64{2.0, 20.0, 4.0}
		let round = (calls - 1) / 2
		if which == 1 {
			seconds = base[round]
		} else {
			seconds = head[round]
		}
		if n < 0 {
			seconds = 0.0
		}
	} else {
		// the third run prints something else
		if calls == 3 {
			out = "wrong"
		} else {
			out = "ok"
		}
	}
	return benchlib.Timed{Seconds: seconds, Stdout: out, Stderr: ""}
}

fn pair() ([]str, []benchlib.Command) {
	return []str{"base", "head"}, []benchlib.Command{benchlib.Command{Argv: []str{"base"}, Dir: "", Set: []str{}}, benchlib.Command{Argv: []str{"head"}, Dir: "", Set: []str{}}}
}

fn tin(path str, text str) {
	ci.Write(path, text)
}

fn tempSetup(sides []str) str {
	return ci.TempDir(ci.Join(ci.Root(), "bin/ci"), "tin benchmark ")
}

fn main() {
	// alternates and reports the median, not the minimum
	scenario = 0
	let (names, commands) = pair()
	let result = benchlib.Interleaved(names, commands, 3, true, scripted) catch err {
		ci.Fail(say.Str(err))
		panic("unreachable")
	}
	ci.Same("the rounds alternate the order", mint.Itoa(order), "122112")
	ci.Test("median of base is 3", result.MedianOf("base") == 3.0)
	ci.Test("median of head is 4", result.MedianOf("head") == 4.0)
	let samples = result.SamplesOf("base")
	ci.Test("base's samples", len(samples) == 3 && samples[0] == 10.0 && samples[1] == 1.0 && samples[2] == 3.0)

	// the output is checked on every repetition
	scenario = 1
	calls = 0
	order = 0
	let (names2, commands2) = pair()
	let mismatch = benchlib.Interleaved(names2, commands2, 3, true, scripted) catch err {
		benchlib.Result{Names: []str{say.Str(err)}, Medians: []f64{}, Samples: [][]f64{}}
	}
	ci.Test("a changed output is refused", len(mismatch.Names) == 1 && twine.Contains(mismatch.Names[0], "OUTPUT MISMATCH"))

	// a crash and a timeout are never samples
	let crash = benchlib.RunChecked(benchlib.Command{Argv: []str{"sh", "-c", "exit 2"}, Dir: "", Set: []str{}}, 20) catch _ {
		benchlib.Timed{Seconds: -1.0, Stdout: "", Stderr: ""}
	}
	ci.Test("a crash fails the run", crash.Seconds < 0.0)
	let slow = benchlib.RunChecked(benchlib.Command{Argv: []str{"sleep", "10"}, Dir: "", Set: []str{}}, 1) catch _ {
		benchlib.Timed{Seconds: -1.0, Stdout: "", Stderr: ""}
	}
	ci.Test("a timeout fails the run", slow.Seconds < 0.0)

	// the comparison uses the matching library tree and identical input
	let tmp = ci.TempDir(ci.Join(ci.Root(), "bin/ci"), "tin benchmark ")
	for side in []str{"base", "head"} {
		let root = ci.Join(tmp, side)
		ci.Mkdirs(ci.Join(root, "bin"))
		ci.Mkdirs(ci.Join(root, "toolchain/runtime"))
		ci.Write(ci.Join(root, "toolchain/runtime/version"), side)
		let compiler = ci.Join(root, "bin/tinc")
		ci.Write(compiler, "#!/bin/sh\n[ \"$TIN_ROOT\" = \"$(pwd -P)\" ] || exit 1\n[ \"$TIN_ROOT\" = \"$(cd \"$(dirname \"$0\")/..\" && pwd -P)\" ] || exit 1\n[ \"$(cat \"$TIN_ROOT/toolchain/runtime/version\")\" = '" + side + "' ] || exit 1\nfor a in \"$@\"; do last=$a; done\nprintf %s \"$last\" > \"$TIN_ROOT/compiled-source\"\nwhile [ $# -gt 0 ]; do case $1 in -o) out=$2; shift 2 ;; *) shift ;; esac; done\nprintf '#!/bin/sh\\necho \"same output\"\\n' > \"$out\"\nchmod +x \"$out\"\n")
		ci.Must(ci.Exec([]str{"chmod", "755", compiler}, "", 5), "chmod")
	}
	let suite = ci.Join(tmp, "input")
	ci.Mkdirs(suite)
	ci.Write(ci.Join(suite, "one.tin"), "same benchmark input")
	let report = ci.Join(tmp, "results.json")
	let run = ci.ExecEnv([]str{"sh", "tools/ci/tin.sh", "bench/compare.tin", "--base-root", ci.Join(tmp, "base"), "--head-root", ci.Join(tmp, "head"), "--bench-dir", suite, "--json", report}, ci.Root(), 600, []str{"TIN_ROOT=/wrong/inherited/root"}, []str{})
	ci.Test("the comparison runs", run.Code == 0)
	if run.Code != 0 {
		say.Line(run.Stdout + run.Stderr)
	}
	ci.Same("base compiled the shared input", ci.Read(ci.Join(tmp, "base/compiled-source")), ci.Join(suite, "one.tin"))
	ci.Same("head compiled the shared input", ci.Read(ci.Join(tmp, "head/compiled-source")), ci.Join(suite, "one.tin"))
	let reportText = ci.Read(report)
	ci.Test("seven samples each", twine.Count(reportText, ", ") >= 12 && twine.Contains(reportText, "\"runs\": 7"))
	ci.Remove(tmp)

	// unknown and empty suites fail
	let empty = ci.TempDir(ci.Join(ci.Root(), "bin/ci"), "bench-names-")
	let none = benchlib.BenchmarkNames(empty, []str{}) catch err {
		[]str{say.Str(err)}
	}
	ci.Test("no benchmarks", len(none) == 1 && twine.Contains(none[0], "no benchmarks"))
	let typo = benchlib.BenchmarkNames(empty, []str{"typo"}) catch err {
		[]str{say.Str(err)}
	}
	ci.Test("unknown benchmarks", len(typo) == 1 && twine.Contains(typo[0], "unknown benchmarks"))
	ci.Remove(empty)

	// the wrk parser rejects errors and missing measurements
	let valid = "  99%    1.50ms\n  100 requests in 1.00s, 20KB read\nRequests/sec: 100.00\n"
	let good = benchlib.ParseWrk(valid) catch _ {
		benchlib.Wrk{Rps: -1.0, P99us: -1.0, Requests: -1}
	}
	ci.Test("wrk: a valid report", good.P99us == 1500.0 && good.Rps == 100.0 && good.Requests == 100)
	for text in []str{"", "unable to connect", valid + "Socket errors: connect 1\n", valid + "Non-2xx or 3xx responses: 100\n", twine.Replace(valid, "100.00", "0.00", 1)} {
		let r = benchlib.ParseWrk(text) catch _ {
			benchlib.Wrk{Rps: -1.0, P99us: -1.0, Requests: -1}
		}
		ci.Test("wrk: rejects " + twine.Replace(text, "\n", "|", -1), r.Requests == -1)
	}

	// the h2load parser reads both formats and rejects failures
	let head = "finished in 10.00s, 1000.50 req/s, 1.00MB/s\nrequests: 10005 total, 10005 started, 10005 done, 10005 succeeded, 0 failed, 0 errored, 0 timeout\nstatus codes: 10007 2xx, 0 3xx, 0 4xx, 0 5xx\n"
	let old = head + "time for request:       30us      2.39ms       157us        63us    87.68%\n"
	let current = head + "request     :       30us      2.39ms       150us       234us       306us       1.58ms        63us    87.68%\n"
	let a = benchlib.ParseH2load(old) catch _ {
		benchlib.H2load{Rps: -1.0, Requests: -1, MeanUs: -1.0}
	}
	ci.Test("h2load: the older format", a.Rps == 1000.5 && a.Requests == 10005 && a.MeanUs == 157.0)
	let b = benchlib.ParseH2load(current) catch _ {
		benchlib.H2load{Rps: -1.0, Requests: -1, MeanUs: -1.0}
	}
	ci.Test("h2load: the newer format", b.MeanUs == 1580.0)
	for text in []str{"", head, twine.Replace(old, " 0 failed", " 3 failed", 1), twine.Replace(old, " 0 errored", " 1 errored", 1), twine.Replace(old, " 0 5xx", " 2 5xx", 1), twine.Replace(old, "10005 succeeded", "10004 succeeded", 1)} {
		let r = benchlib.ParseH2load(text) catch _ {
			benchlib.H2load{Rps: -1.0, Requests: -1, MeanUs: -1.0}
		}
		ci.Test("h2load: rejects a bad report", r.Requests == -1)
	}

	// the workflow's pipelines propagate harness failures
	let workflow = ci.Read(ci.Join(ci.Root(), ".github/workflows/bench-linux.yml"))
	ci.Test("the workflow runs bash", twine.Contains(workflow, "defaults:\n  run:\n    shell: bash"))
	let piped = ci.Exec([]str{"bash", "-e", "-o", "pipefail", "-c", "sh -c 'exit 2' | cat"}, "", 10)
	ci.Test("a failing stage fails the pipeline", piped.Code == 2)

	// the HTTP body is checked before timing
	benchlib.VerifyBody("/json", "{{\"message\":\"Hello, World!\"}}\n") catch _ {
		ci.Fail("a correct /json body was refused")
	}
	benchlib.VerifyBody("/plaintext", "Hello, World!") catch _ {
		ci.Fail("a correct /plaintext body was refused")
	}
	mut refusedJson = false
	benchlib.VerifyBody("/json", "{{\"message\":\"wrong\"}}") catch _ {
		refusedJson = true
	}
	ci.Test("a wrong /json body is refused", refusedJson)
	mut refusedPlain = false
	benchlib.VerifyBody("/plaintext", "error page") catch _ {
		refusedPlain = true
	}
	ci.Test("a wrong /plaintext body is refused", refusedPlain)
	ci.Finish()
}
