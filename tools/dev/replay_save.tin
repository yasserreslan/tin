package main

import "../ci/capsule"
import "quarry"
import "say"

// tin replay --save-test (#242): turn a capsule into a regression case.
//
// Usage: replay_save ROOT NAME ISSUE CAPSULE BUILD.tin STDOUT_FILE
//
// Writes toolchain/tests/regressions/NAME.tin (a copy of BUILD.tin), toolchain/tests/regressions/NAME.tcap (the capsule, opened with
// TIN_REPLAY_KEY and sealed again under a public test key kept in the case) and the case in cases.json: the program run with the
// replay switches must exit 0 and print STDOUT_FILE. The saved capsule is readable by anyone: review its request and results before
// committing it.

fn main() {
	let args = quarry.Args()
	if len(args) != 7 {
		say.Line("usage: replay_save ROOT NAME ISSUE CAPSULE BUILD.tin STDOUT_FILE")
		quarry.Exit(1)
	}
	let message = capsule.Save(args[1], args[2], args[3], args[4], args[5], args[6], quarry.Getenv("TIN_REPLAY_KEY")) catch err {
		say.Line(say.Str(err))
		quarry.Exit(1)
		return
	}
	say.Line(message)
}
