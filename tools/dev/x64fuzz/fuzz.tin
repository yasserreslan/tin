// x64fuzz: encodes random x86-64 instructions with selfhost/asm_x64.tin and writes the raw
// bytes and our Intel-syntax listing, for tools/dev/x64fuzz/run.sh to check against objdump.
// Usage: x64fuzz OUT.bin OUT.txt [COUNT] [SEED]
shared mut rng i64

// rnd is a 64-bit linear congruential generator (modulo 2^64); the high bits are the good ones.
@wrap fn rnd() i64 {
	rng = rng * 6364136223846793005 + 1442695040888963407
	return (rng >> 33) & 0x7fffffff
}

fn rnd_below(n i64) i64 {
	return rnd() % n
}

fn rnd_gpr() i64 {
	return rnd_below(16)
}

fn rnd_xmm() i64 {
	return XMM + rnd_below(16)
}

// rnd_signed returns a random value in [-2^(bits-1), 2^(bits-1)).
fn rnd_signed(bits i64) i64 {
	let r = (rnd() << 33) ^ (rnd() << 2) ^ rnd()
	if bits >= 64 {
		// 1 << 64 is out of range (#362): it used to be 1, which made every 64-bit value 0.
		return r
	}
	mut v = r & ((1 << bits) - 1)
	if v >= (1 << (bits - 1)) {
		v = v - (1 << bits)
	}
	return v
}

// rnd_imm32 favours the boundaries where the encoder picks between imm8 and imm32.
fn rnd_imm32() i64 {
	let k = rnd_below(12)
	if k == 0 {
		return 0
	} else if k == 1 {
		return -1
	} else if k == 2 {
		return 1
	} else if k == 3 {
		return 127
	} else if k == 4 {
		return 128
	} else if k == 5 {
		return -128
	} else if k == 6 {
		return -129
	} else if k == 7 {
		return 0x7fffffff
	} else if k == 8 {
		return -0x80000000
	} else if k == 9 {
		return rnd_signed(8)
	} else if k == 10 {
		return rnd_signed(16)
	}
	return rnd_signed(32)
}

// rnd_imm64 adds the boundaries where mov switches between its 32-bit forms and movabs.
fn rnd_imm64() i64 {
	let k = rnd_below(10)
	if k == 0 {
		return 0xffffffff
	} else if k == 1 {
		return 0x100000000
	} else if k == 2 {
		return -0x80000001
	} else if k == 3 {
		return 0x7fffffffffffffff
	} else if k == 4 {
		return 1 << 63
	} else if k == 5 {
		return 0x80000000
	} else if k == 6 {
		return rnd_signed(64)
	} else if k == 7 {
		return rnd_signed(48)
	}
	return rnd_imm32()
}

// rnd_disp is mostly zero or small so that every ModRM mod value gets exercised.
fn rnd_disp() i64 {
	let k = rnd_below(10)
	if k < 3 {
		return 0
	} else if k < 5 {
		return rnd_signed(8)
	} else if k == 5 {
		return 127
	} else if k == 6 {
		return -128
	} else if k == 7 {
		return 128 + rnd_below(2) * -257
	} else if k == 8 {
		return 0x7fffffff - rnd_below(2) * 0xffffffff
	}
	return rnd_signed(32)
}

// Random instructions use labels label_lo and up; the ones below belong to gen_edges.
shared mut label_lo i64

// rnd_mem draws every base (including rip, rsp, rbp, r12, r13), every index but rsp and every scale.
fn rnd_mem(nlabels i64, nsyms i64) i64 {
	let base = rnd_below(18)
	if base == XM_RIP {
		return x64_mem_rip(label_lo + rnd_below(nlabels))
	}
	if base == XM_RIPSYM {
		return x64_mem_sym(rnd_below(nsyms))
	}
	mut index = rnd_below(17)
	if index == RSP {
		index = XM_NONE
	}
	return x64_mem(base, index, 1 << rnd_below(4), rnd_disp())
}

fn rnd_shift() i64 {
	let k = rnd_below(4)
	if k == 0 {
		return 0
	} else if k == 1 {
		return 1
	} else if k == 2 {
		return 63
	}
	return rnd_below(64)
}

fn emit(code []i64, op i64, a i64, b i64, c i64, d i64) {
	code = append(code, op)
	code = append(code, a)
	code = append(code, b)
	code = append(code, c)
	code = append(code, d)
}

const N_CASES = 74

// rnd_label picks a branch target: half the time one of the labels around the current
// position, so that plenty of branches relax to rel8 in both directions, else any label.
fn rnd_label(nlabels i64, near i64) i64 {
	if rnd_below(2) != 0 {
		mut l = near + rnd_below(9) - 4
		if l < label_lo {
			l = label_lo
		}
		if l >= label_lo + nlabels {
			l = label_lo + nlabels - 1
		}
		return l
	}
	return label_lo + rnd_below(nlabels)
}

const N_EDGE_LABELS = 32

fn fill(code []i64, n i64) {
	mut i = 0
	for i < n {
		emit(code, X_RET, 0, 0, 0, 0)
		i = i + 1
	}
}

// gen_edges appends branches whose targets sit right at the rel8 boundary in both directions,
// and chains of branches to one label that only shrink over several relaxation passes; it
// defines labels 0 to N_EDGE_LABELS - 1.
fn gen_edges(code []i64) {
	mut l = 0
	mut n = 124
	for n <= 130 {
		// Forward: short when n <= 127.
		emit(code, X_JMP, l, 0, 0, 0)
		fill(code, n)
		emit(code, X_LABEL, l, 0, 0, 0)
		emit(code, X_JCC, n & 15, l + 1, 0, 0)
		fill(code, n)
		emit(code, X_LABEL, l + 1, 0, 0, 0)
		// Backward: short when n + 2 <= 128.
		emit(code, X_LABEL, l + 2, 0, 0, 0)
		fill(code, n)
		emit(code, X_JMP, l + 2, 0, 0, 0)
		emit(code, X_LABEL, l + 3, 0, 0, 0)
		fill(code, n)
		emit(code, X_JCC, n & 15, l + 3, 0, 0)
		l = l + 4
		n = n + 1
	}
	// Cascades: 80 branches to one label, forward then backward, with jmp and with jcc.
	mut k = 0
	for k < 4 {
		if k >= 2 {
			emit(code, X_LABEL, l, 0, 0, 0)
		}
		mut i = 0
		for i < 80 {
			if k & 1 != 0 {
				emit(code, X_JCC, i & 15, l, 0, 0)
			} else {
				emit(code, X_JMP, l, 0, 0, 0)
			}
			i = i + 1
		}
		if k < 2 {
			emit(code, X_LABEL, l, 0, 0, 0)
		}
		l = l + 1
		k = k + 1
	}
	if l != N_EDGE_LABELS {
		complain(cstr("x64fuzz: edge label count is off"))
		rt_sys_exit(1)
	}
}

// gen_ins appends one random instruction, choosing uniformly over every op and form;
// near is the id of the next label to be defined.
fn gen_ins(code []i64, nlabels i64, nsyms i64, near i64) {
	let k = rnd_below(N_CASES)
	if k == 0 {
		emit(code, X_MOV_RR, rnd_gpr(), rnd_gpr(), 0, 0)
	} else if k == 1 {
		emit(code, X_MOV_RI, rnd_gpr(), rnd_imm64(), 0, 0)
	} else if k == 2 {
		emit(code, X_LOAD, rnd_gpr(), rnd_mem(nlabels, nsyms), rnd_below(8), 0)
	} else if k == 3 {
		emit(code, X_STORE, rnd_gpr(), rnd_mem(nlabels, nsyms), rnd_below(4), 0)
	} else if k == 4 {
		emit(code, X_LEA, rnd_gpr(), rnd_mem(nlabels, nsyms), 0, 0)
	} else if k < 12 {
		emit(code, X_ADD + (k - 5), rnd_gpr(), rnd_gpr(), 0, 0)
	} else if k < 19 {
		emit(code, X_ADDI + (k - 12), rnd_gpr(), rnd_imm32(), 0, 0)
	} else if k < 26 {
		emit(code, X_ADDM + (k - 19), rnd_gpr(), rnd_mem(nlabels, nsyms), 0, 0)
	} else if k == 26 {
		emit(code, X_IMUL_RR, rnd_gpr(), rnd_gpr(), 0, 0)
	} else if k == 27 {
		emit(code, X_IMUL_RRI, rnd_gpr(), rnd_gpr(), rnd_imm32(), 0)
	} else if k == 28 {
		emit(code, X_IDIV, rnd_gpr(), 0, 0, 0)
	} else if k == 29 {
		emit(code, X_DIV, rnd_gpr(), 0, 0, 0)
	} else if k == 30 {
		emit(code, X_CQO, 0, 0, 0, 0)
	} else if k == 31 {
		emit(code, X_NEG, rnd_gpr(), 0, 0, 0)
	} else if k == 32 {
		emit(code, X_NOT, rnd_gpr(), 0, 0, 0)
	} else if k < 36 {
		emit(code, X_SHL + (k - 33), rnd_gpr(), 0, 0, 0)
	} else if k < 39 {
		emit(code, X_SHLI + (k - 36), rnd_gpr(), rnd_shift(), 0, 0)
	} else if k == 39 {
		emit(code, X_SETCC, rnd_gpr(), rnd_below(16), 0, 0)
	} else if k == 40 {
		emit(code, X_CMOVCC, rnd_gpr(), rnd_gpr(), rnd_below(16), 0)
	} else if k == 41 {
		emit(code, X_JMP, rnd_label(nlabels, near), 0, 0, 0)
	} else if k == 42 {
		emit(code, X_JCC, rnd_below(16), rnd_label(nlabels, near), 0, 0)
	} else if k == 43 {
		emit(code, X_CALL, rnd_below(nsyms), 0, 0, 0)
	} else if k == 44 {
		emit(code, X_CALL_R, rnd_gpr(), 0, 0, 0)
	} else if k == 45 {
		emit(code, X_RET, 0, 0, 0, 0)
	} else if k == 46 {
		emit(code, X_PUSH, rnd_gpr(), 0, 0, 0)
	} else if k == 47 {
		emit(code, X_POP, rnd_gpr(), 0, 0, 0)
	} else if k == 48 {
		emit(code, X_SXT, rnd_gpr(), rnd_gpr(), rnd_below(3), 0)
	} else if k == 49 {
		emit(code, X_ZXT, rnd_gpr(), rnd_gpr(), rnd_below(3), 0)
	} else if k == 50 {
		emit(code, X_MOVSD, rnd_xmm(), rnd_xmm(), 0, 0)
	} else if k == 51 {
		emit(code, X_MOVSD_LD, rnd_xmm(), rnd_mem(nlabels, nsyms), 0, 0)
	} else if k == 52 {
		emit(code, X_MOVSD_ST, rnd_xmm(), rnd_mem(nlabels, nsyms), 0, 0)
	} else if k < 58 {
		emit(code, X_ADDSD + (k - 53), rnd_xmm(), rnd_xmm(), 0, 0)
	} else if k == 58 {
		emit(code, X_UCOMISD, rnd_xmm(), rnd_xmm(), 0, 0)
	} else if k == 59 {
		emit(code, X_CVTSI2SD, rnd_xmm(), rnd_gpr(), 0, 0)
	} else if k == 60 {
		emit(code, X_CVTTSD2SI, rnd_gpr(), rnd_xmm(), 0, 0)
	} else if k == 61 {
		if rnd_below(2) != 0 {
			emit(code, X_MOVQ, rnd_xmm(), rnd_gpr(), 0, 0)
		} else {
			emit(code, X_MOVQ, rnd_gpr(), rnd_xmm(), 0, 0)
		}
	} else if k == 62 {
		emit(code, X_XORPD, rnd_xmm(), rnd_xmm(), 0, 0)
	} else if k == 63 {
		emit(code, X_ANDPD, rnd_xmm(), rnd_xmm(), 0, 0)
	} else if k == 64 {
		emit(code, X_ROUNDSD, rnd_xmm(), rnd_xmm(), rnd_below(16), 0)
	} else if k == 65 {
		emit(code, X_PREFETCHW, rnd_mem(nlabels, nsyms), 0, 0, 0)
	} else if k == 66 {
		emit(code, X_PREFETCHT0, rnd_mem(nlabels, nsyms), 0, 0, 0)
	} else if k == 67 {
		emit(code, X_LOCK_XADD, rnd_gpr(), rnd_mem(nlabels, nsyms), 0, 0)
	} else if k == 68 {
		emit(code, X_XCHG, rnd_gpr(), rnd_mem(nlabels, nsyms), 0, 0)
	} else if k == 69 {
		emit(code, X_LOCK_CMPXCHG, rnd_gpr(), rnd_mem(nlabels, nsyms), 0, 0)
	} else if k == 70 {
		emit(code, X_MFENCE, 0, 0, 0, 0)
	} else if k == 71 {
		emit(code, X_PAUSE, 0, 0, 0, 0)
	} else if k == 72 {
		emit(code, X_MULU, rnd_gpr(), 0, 0, 0)
	} else {
		emit(code, X_UD2, 0, 0, 0, 0)
	}
}

// The fuzzer resolves every symbol through x64_syms, so the linker hook is never reached.
fn x64_sym_hook(s i64) i64 {
	return 0
}

// The -S listing is not built here (there is no symbol table to name calls from).
fn x64_fn_name(id i64) i64 {
	return 0
}

fn parse_int(s i64) i64 {
	mut n = 0
	mut i = 0
	for i64(load8(s + i)) >= '0' && i64(load8(s + i)) <= '9' {
		n = n * 10 + i64(load8(s + i)) - '0'
		i = i + 1
	}
	return n
}

fn write_file(path i64, b []u8) {
	let fd = rt_sys_creat(path, 420)
	if fd < 0 {
		complain(cstr("x64fuzz: cannot create output file"))
		rt_sys_exit(1)
	}
	write_all(fd, b)
	rt_sys_close(fd)
}

fn run(argc i64, argv i64) i64 {
	if argc < 3 {
		complain(cstr("usage: x64fuzz OUT.bin OUT.txt [COUNT] [SEED]"))
		return 2
	}
	mut count = 20000
	if argc > 3 {
		count = parse_int(argv[3])
	}
	rng = 1
	if argc > 4 {
		rng = parse_int(argv[4])
	}
	let nlabels = count / 8 + 1
	let nsyms = 16
	let code = []i64{}
	gen_edges(code)
	label_lo = N_EDGE_LABELS
	mut next_label = label_lo
	mut i = 0
	for i < count {
		if next_label < label_lo + nlabels && rnd_below(8) == 0 {
			emit(code, X_LABEL, next_label, 0, 0, 0)
			next_label = next_label + 1
		}
		gen_ins(code, nlabels, nsyms, next_label)
		i = i + 1
	}
	for next_label < label_lo + nlabels {
		emit(code, X_LABEL, next_label, 0, 0, 0)
		next_label = next_label + 1
	}
	// Symbols get addresses anywhere in the code once its size is known.
	let size = x64_layout(code, 0)
	let passes = x64_passes
	x64_syms = []i64{}
	i = 0
	for i < nsyms {
		x64_syms = append(x64_syms, rnd_below(size + 1))
		i = i + 1
	}
	let bin = buf_new()
	let txt = buf_new()
	mut pc = 0
	mut shorts = 0
	i = 0
	for i < len(code) {
		let ins = slice_data(code) + 8 * i
		if (ins[0] == X_JMP || ins[0] == X_JCC) && ins[4] != 0 {
			shorts = shorts + 1
		}
		x64_print(txt, ins, pc)
		pc = pc + x64_encode(ins, pc, bin)
		i = i + 5
	}
	if pc != size {
		complain(cstr("x64fuzz: layout size disagrees with the encoded size"))
		return 1
	}
	// x64_assemble must produce the very same bytes.
	let again = x64_assemble(code, 0)
	if len(again) != len(bin) || mem_eq(slice_data(again), slice_data(bin), len(bin)) == 0 {
		complain(cstr("x64fuzz: x64_assemble disagrees with x64_encode"))
		return 1
	}
	write_file(argv[1], bin)
	write_file(argv[2], txt)
	// A fifth argument gets the symbolic listing (labels as L<n>, symbols as S<n>).
	if argc > 5 {
		let sym = buf_new()
		i = 0
		for i < len(code) {
			x64_print(sym, slice_data(code) + 8 * i, -1)
			i = i + 5
		}
		write_file(argv[5], sym)
	}
	let msg = buf_new()
	buf_str(msg, cstr("x64fuzz: "))
	buf_int(msg, len(code) / 5)
	buf_str(msg, cstr(" instructions, "))
	buf_int(msg, nlabels)
	buf_str(msg, cstr(" labels, "))
	buf_int(msg, shorts)
	buf_str(msg, cstr(" short branches after "))
	buf_int(msg, passes)
	buf_str(msg, cstr(" relaxation passes, "))
	buf_int(msg, len(x64_relocs) / 3)
	buf_str(msg, cstr(" relocations, "))
	buf_int(msg, size)
	buf_str(msg, cstr(" bytes\n"))
	write_all(1, msg)
	return 0
}

// complain writes a line to standard error.
fn complain(s i64) {
	rt_sys_write(2, s, strlen(s))
	rt_sys_write(2, cstr("\n"), 1)
}

fn main() {
	let status = run(rtArgc, rtArgv)
	rt_flush()
	rt_sys_exit(status)
}
