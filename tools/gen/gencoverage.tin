package main

import "quarry"
import "say"

// Generate rewrites docs/COVERAGE.md from its maintained source in design/coverage.md.
fn main() {
	let contents = quarry.ReadFile("design/coverage.md") catch e {
		say.Line("gencoverage: " + say.Str(e))
		quarry.Exit(1)
		return
	}
	quarry.WriteFile("docs/COVERAGE.md", contents) catch e {
		say.Line("gencoverage: " + say.Str(e))
		quarry.Exit(1)
		return
	}
}
