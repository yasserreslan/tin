package main

import "../ci/ci"
import "mint"
import "quarry"
import "twine"

// Generate toolchain/std/html/entity.tin from golang.org/x/net/html/entity.go (run from the repo root).
//
//     gen_html_entities PATH/TO/entity.go
//
// The named character references of HTML5: entities maps every name (with its ";" where the name has one) to its rune, and
// entities2 maps the references that stand for two runes to both. Both are shared maps: built once on core 0, read-only.

const OUT = "toolchain/std/html/entity.tin"

// NAMES lists every name, one per line: the check (tools/ci/html_check.tin) runs each one through both twins.
const NAMES = "toolchain/tests/data/html/entity_names.txt"

// hexAt returns the hex digits that follow the n-th (0-based) occurrence of prefix (\U with 8 digits, \u with 4) in s, without
// leading zeros.
fn hexAt(s str, prefix str, n i64) str {
	mut from = 0
	for k in 0..n {
		let at = twine.Index(s[from:], prefix)
		ci.Check(at >= 0, "gen_html_entities: missing escape in " + s)
		from += at + len(prefix)
	}
	let at = twine.Index(s[from:], prefix)
	ci.Check(at >= 0, "gen_html_entities: missing escape in " + s)
	mut width = 4
	if prefix == "\\U" {
		width = 8
	}
	let digits = s[from+at+len(prefix) : from+at+len(prefix)+width]
	mut i = 0
	for i < len(digits)-1 && digits[i] == '0' {
		i += 1
	}
	return digits[i:]
}

// nameOf returns the quoted name at the start of a table line.
fn nameOf(line str) str {
	let t = twine.TrimSpace(line)
	let end = twine.Index(t[1:], "\"")
	return t[1:end+1]
}

fn main() {
	let args = quarry.Args()
	ci.Check(len(args) > 1, "usage: gen_html_entities PATH/TO/entity.go")
	let text = ci.Read(args[1])
	ci.Check(len(text) > 0, "gen_html_entities: cannot read " + args[1])
	mut out = twine.NewBuilder(256 * 1024)
	out.Str("// Code generated by tools/gen/gen_html_entities.tin from golang.org/x/net/html/entity.go; DO NOT EDIT.\n\n")
	out.Str("package html\n\n")
	out.Str("// entities maps each named character reference (with its \";\" where the name has one) to its rune.\n")
	out.Str("shared let entities = map[str]i64{{\n")
	mut pairs = twine.NewBuilder(64 * 1024)
	mut names = twine.NewBuilder(32 * 1024)
	mut mode = 0
	mut singles = 0
	mut doubles = 0
	for line in twine.Split(text, "\n") {
		let t = twine.TrimSpace(line)
		if line == "var entity = map[string]rune{{" {
			mode = 1
		} else if line == "var entity2 = map[string][2]rune{{" {
			mode = 2
		} else if line == "}}" {
			mode = 0
		} else if mode == 1 && twine.HasPrefix(t, "\"") {
			out.Str("\t\"" + nameOf(line) + "\": 0x" + hexAt(line, "\\U", 0) + ",\n")
			names.Str(nameOf(line) + "\n")
			singles += 1
		} else if mode == 2 && twine.HasPrefix(t, "\"") {
			names.Str(nameOf(line) + "\n")
			pairs.Str("\t\"" + nameOf(line) + "\": [2]i64{{0x" + hexAt(line, "\\u", 0) + ", 0x" + hexAt(line, "\\u", 1) + "}},\n")
			doubles += 1
		}
	}
	ci.Check(singles > 2000 && doubles > 0, "gen_html_entities: the tables are not there")
	out.Str("}}\n\n")
	out.Str("// entities2 maps the named references of two runes to both runes, in order.\n")
	out.Str("shared let entities2 = map[str][2]i64{{\n")
	out.Str(pairs.String())
	out.Str("}}\n")
	ci.Write(ci.Join(ci.Root(), OUT), out.String())
	ci.Write(ci.Join(ci.Root(), NAMES), names.String())
	ci.Pass("gen_html_entities: " + mint.Itoa(singles) + " references and " + mint.Itoa(doubles) + " two-rune references")
}
