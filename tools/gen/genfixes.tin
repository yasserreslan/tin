package main

import "quarry"
import "say"
import "twine"

// Generate rewrites toolchain/compiler/fixes.tin from the "Fix:" paragraph of each entry of toolchain/docs/ERRORS.md: the
// text `tinc -check -json` prints as an error's "fix". Run it from the repository root:
//
//	bin/tinc -o /tmp/genfixes tools/gen/genfixes.tin && /tmp/genfixes
//
// tools/ci/diagnostics_check.tin compiles every example of the page and requires that the fix in the JSON form is the
// page's, so a stale fixes.tin fails CI.

// literal is s as the body of a Tin string.
fn literal(s str) str {
	mut out = []u8{}
	for i in 0..len(s) {
		let c = s[i]
		if c == '"' || c == '\\' {
			out = append(out, '\\')
			out = append(out, c)
		} else if c == '{' || c == '}' {
			out = append(out, c)
			out = append(out, c)
		} else if c == '\t' {
			out = append(out, '\\')
			out = append(out, 't')
		} else {
			out = append(out, c)
		}
	}
	return str(out)
}

fn main() {
	let page = quarry.ReadFile("toolchain/docs/ERRORS.md") catch e {
		say.Line("genfixes: " + say.Str(e))
		quarry.Exit(1)
		return
	}
	let lines = twine.Split(page, "\n")
	mut entries = []str{}
	mut code = ""
	mut i = 0
	for i < len(lines) {
		let l = lines[i]
		if twine.HasPrefix(l, "### E") && len(l) > 9 {
			code = l[4:8]
		}
		if len(code) > 0 && twine.HasPrefix(l, "Fix: ") {
			mut fix = l[5:]
			let at = i
			i += 1
			for i < len(lines) && len(twine.TrimSpace(lines[i])) > 0 {
				fix = fix + " " + twine.TrimSpace(lines[i])
				i += 1
			}
			entries = append(entries, code + "\t" + fix + "\n")
			code = ""
			continue
		}
		i += 1
	}
	mut out = "package main\n\n"
	out = out + "// The fix text of each error code, from the Fix: paragraphs of toolchain/docs/ERRORS.md (\"CODE<tab>text\", one per line).\n"
	out = out + "// Generated by tools/gen/genfixes.tin: do not edit.\n"
	out = out + "fn fix_table() str {{\n\treturn \"\" +\n"
	for k in 0..len(entries) {
		out = out + "\t\t\"" + literal(entries[k][:len(entries[k]) - 1]) + "\\n\""
		if k + 1 < len(entries) {
			out = out + " +"
		}
		out = out + "\n"
	}
	out = out + "}}\n"
	quarry.WriteFile("toolchain/compiler/fixes.tin", out) catch e {
		say.Line("genfixes: " + say.Str(e))
		quarry.Exit(1)
	}
}
