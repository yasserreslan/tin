package main

import "../ci/ci"
import "abacus"
import "dice"
import "mint"
import "quarry"
import "say"
import "twine"

// Generate tools/gen/arch/fe25519-arm64.S and fe25519-amd64.S: seal's fe_mul and fe_sq (mod 2^255 - 19, five limbs in radix 2^51) as
// assembly leaves (#488), the same arithmetic as the Tin code tools/gen/fe25519.tin writes (toolchain/std/seal/fe25519.tin): each
// coefficient is a sum of 64x64-bit products in 128 bits (a product past limb 4 wraps with factor 19, folded into the operand), then
// carried back below 2^52. The product tables below are checked on a model against big integers before anything is written.
//
//   fe_mul_hw(h, f, g), fe_sq_hw(h, f): the addresses of five u64 limbs; h may alias f or g.
//
// arm64 uses mul/umulh and adds/adc; x86-64 uses BMI2 mulx (the CPU check is bmi2_cpu). Constant time: straight-line code.
// Relocation-free; r15 and x28 (the core context) are untouched.
//
// Usage: fe25519_asm [--check]   (writes tools/gen/arch/*.S; --check compares them)

fn n(i i64) str {
	return mint.Itoa(i)
}

// Pre is a premultiplied operand: name, base limb and factor.
type Pre struct {
	Name str
	Base str
	K i64
}

// Row is one coefficient: pairs of (f-side, g-side) operands.
type Row struct {
	A []str
	B []str
}

fn mulPre() []Pre {
	return []Pre{Pre{Name: "f1x19", Base: "f1", K: 19}, Pre{Name: "f2x19", Base: "f2", K: 19}, Pre{Name: "f3x19", Base: "f3", K: 19}, Pre{Name: "f4x19", Base: "f4", K: 19}}
}

fn mulRows() []Row {
	mut rows = []Row{}
	for k in 0..5 {
		mut a = []str{}
		mut b = []str{}
		for i in 0..5 {
			let j = ((k - i) % 5 + 5) % 5
			if i + j >= 5 {
				a = append(a, "f" + n(i) + "x19")
			} else {
				a = append(a, "f" + n(i))
			}
			b = append(b, "g" + n(j))
		}
		rows = append(rows, Row{A: a, B: b})
	}
	return rows
}

fn sqPre() []Pre {
	return []Pre{Pre{Name: "f0x2", Base: "f0", K: 2}, Pre{Name: "f1x2", Base: "f1", K: 2}, Pre{Name: "f1x38", Base: "f1", K: 38}, Pre{Name: "f2x38", Base: "f2", K: 38}, Pre{Name: "f3x38", Base: "f3", K: 38}, Pre{Name: "f3x19", Base: "f3", K: 19}, Pre{Name: "f4x19", Base: "f4", K: 19}}
}

fn sqRows() []Row {
	return []Row{Row{A: []str{"f0", "f1x38", "f2x38"}, B: []str{"f0", "f4", "f3"}}, Row{A: []str{"f0x2", "f2x38", "f3x19"}, B: []str{"f1", "f4", "f3"}}, Row{A: []str{"f0x2", "f1", "f3x38"}, B: []str{"f2", "f1", "f4"}}, Row{A: []str{"f0x2", "f1x2", "f4x19"}, B: []str{"f3", "f2", "f4"}}, Row{A: []str{"f0x2", "f1x2", "f2"}, B: []str{"f4", "f3", "f2"}}}
}

// The order the coefficients are computed in: r4 first, so that each carry is used as soon as it exists.
fn order() []i64 {
	return []i64{4, 0, 1, 2, 3}
}

// ---------------- the model ----------------

fn big(v u64) abacus.Int {
	let (x, err) = abacus.Parse(mint.FormatUint(v, 10), 10)
	if err != nil {
		ci.Fail("model: cannot parse a limb")
	}
	return x
}

fn two(shift i64) abacus.Int {
	return abacus.FromI64(1).Lsh(shift)
}

// lookup finds the value of an operand name among limbs and premultiplied operands.
fn lookup(names []str, values []u64, name str) u64 {
	for i in 0..len(names) {
		if names[i] == name {
			return values[i]
		}
	}
	ci.Fail("model: unknown operand " + name)
	return 0
}

// model is the leaf's arithmetic on big integers (what the assembly computes); it returns the five limbs of h.
fn model(pre []Pre, rows []Row, f []u64, g []u64) []u64 {
	mut names = []str{}
	mut values = []u64{}
	for i in 0..5 {
		names = append(names, "f" + n(i))
		values = append(values, f[i])
		names = append(names, "g" + n(i))
		values = append(values, g[i])
	}
	for p in pre {
		names = append(names, p.Name)
		values = append(values, lookup(names, values, p.Base) * u64(p.K))
	}
	let m64 = two(64).Sub(abacus.FromI64(1))
	let m51 = two(51).Sub(abacus.FromI64(1))
	mut r = []abacus.Int{}
	for row in rows {
		mut total = abacus.FromI64(0)
		for k in 0..len(row.A) {
			total = total.Add(big(lookup(names, values, row.A[k])).Mul(big(lookup(names, values, row.B[k]))))
		}
		ci.Check(total.Cmp(two(128)) < 0, "model: a coefficient does not fit in 128 bits")
		r = append(r, total)
	}
	mut c = []abacus.Int{}
	mut lo = []abacus.Int{}
	for v in r {
		c = append(c, v.Rsh(51).And(m64))
		lo = append(lo, v.And(m51))
	}
	mut s = []abacus.Int{lo[0].Add(c[4].Mul(abacus.FromI64(19))).And(m64)}
	for i in 1..5 {
		s = append(s, lo[i].Add(c[i - 1]).And(m64))
	}
	mut h = []abacus.Int{s[0].And(m51).Add(s[4].Rsh(51).Mul(abacus.FromI64(19))).And(m64)}
	for i in 1..5 {
		h = append(h, s[i].And(m51).Add(s[i - 1].Rsh(51)).And(m64))
	}
	mut out = []u64{}
	for x in h {
		let (v, ok) = x.U64()
		ci.Check(ok, "model: a limb of h does not fit in 64 bits")
		out = append(out, v)
	}
	return out
}

fn value(limbs []u64) abacus.Int {
	mut v = abacus.FromI64(0)
	for i in 0..5 {
		v = v.Add(big(limbs[i]).Lsh(51 * i))
	}
	return v
}

fn check() {
	let rnd = dice.New(488)
	let p = two(255).Sub(abacus.FromI64(19))
	let lim = []u64{0, 1, 2251799813685247, 2251799813685248, 4503599627370495, 19, 1125899906842624}
	for round in 0..20000 {
		arena {
			mut f = []u64{}
			mut g = []u64{}
			for i in 0..5 {
				if rnd.F64() < 0.3 {
					f = append(f, lim[rnd.I64n(len(lim))])
				} else {
					f = append(f, rnd.U64() >> 12)
				}
				if rnd.F64() < 0.3 {
					g = append(g, lim[rnd.I64n(len(lim))])
				} else {
					g = append(g, rnd.U64() >> 12)
				}
			}
			let fv = value(f)
			let gv = value(g)
			let hm = model(mulPre(), mulRows(), f, g)
			let (_, rm) = value(hm).QuoRem(p)
			let (_, wm) = fv.Mul(gv).QuoRem(p)
			ci.Check(rm.Cmp(wm) == 0, "the multiplication model disagrees with big integers")
			let hs = model(sqPre(), sqRows(), f, f)
			let (_, rs) = value(hs).QuoRem(p)
			let (_, ws) = fv.Mul(fv).QuoRem(p)
			ci.Check(rs.Cmp(ws) == 0, "the squaring model disagrees with big integers")
			for x in hm {
				ci.Check(x < 4503599627370496, "the multiplication model leaves a limb past 2^52")
			}
			for x in hs {
				ci.Check(x < 4503599627370496, "the squaring model leaves a limb past 2^52")
			}
		}
	}
}

// ---------------- AArch64 ----------------

const MASK_A = "#0x7ffffffffffff"

fn indexOf(xs []str, x str) i64 {
	for i in 0..len(xs) {
		if xs[i] == x {
			return i
		}
	}
	return -1
}

// arm64: x0 = h, x1 = f, x2 = g. f in x3-x7, g in x8-x12, premultiplied limbs after them; the accumulator is x17 (lo) and x1 (hi), the
// product temporaries x2 and the last free register; h is parked in x19, and the carries and sums in x20-x27.
fn arm64(name str, pre []Pre, rows []Row, square bool) []str {
	mut regNames = []str{}
	mut regs = []str{}
	for i in 0..5 {
		regNames = append(regNames, "f" + n(i))
		regs = append(regs, "x" + n(3 + i))
	}
	mut nxt = 8
	if !square {
		for i in 0..5 {
			regNames = append(regNames, "g" + n(i))
			regs = append(regs, "x" + n(8 + i))
		}
		nxt = 13
	}
	mut out = []str{"\t.globl " + name, "\t.type " + name + ", %function", name + ":", "\tstp\tx19, x20, [sp, #-80]!", "\tstp\tx21, x22, [sp, #16]", "\tstp\tx23, x24, [sp, #32]", "\tstp\tx25, x26, [sp, #48]", "\tstr\tx27, [sp, #64]", "\tmov\tx19, x0", "\tldp\tx3, x4, [x1]", "\tldp\tx5, x6, [x1, #16]", "\tldr\tx7, [x1, #32]"}
	if !square {
		out = append(out, "\tldp\tx8, x9, [x2]")
		out = append(out, "\tldp\tx10, x11, [x2, #16]")
		out = append(out, "\tldr\tx12, [x2, #32]")
	}
	mut th = "x16"
	if !square {
		th = "x0"
	}
	out = append(out, "\tmov\t" + th + ", #0")
	mut cur = -1
	for p in pre {
		if cur != p.K {
			out = append(out, "\tmov\tx17, #" + n(p.K))
			cur = p.K
		}
		regNames = append(regNames, p.Name)
		regs = append(regs, "x" + n(nxt))
		out = append(out, "\tmul\tx" + n(nxt) + ", " + regs[indexOf(regNames, p.Base)] + ", x17")
		nxt += 1
	}
	let lo = "x17"
	let hi = "x1"
	let tl = "x2"
	let m4 = "x20"
	let c4 = "x21"
	let cs = []str{"x22", "x23"}
	let sums = []str{"x24", "x25", "x26", "x27"}
	mut prev = ""
	mut ci_ = 0
	for k in order() {
		let row = rows[k]
		let r = func_reg(regNames, regs)
		out = append(out, "\tmul\t" + lo + ", " + regs[indexOf(regNames, row.A[0])] + ", " + regs[indexOf(regNames, row.B[0])])
		out = append(out, "\tumulh\t" + hi + ", " + regs[indexOf(regNames, row.A[0])] + ", " + regs[indexOf(regNames, row.B[0])])
		for t in 1..len(row.A) {
			let ra = regs[indexOf(regNames, row.A[t])]
			let rb = regs[indexOf(regNames, row.B[t])]
			out = append(out, "\tmul\t" + tl + ", " + ra + ", " + rb)
			out = append(out, "\tumulh\t" + th + ", " + ra + ", " + rb)
			out = append(out, "\tadds\t" + lo + ", " + lo + ", " + tl)
			out = append(out, "\tadc\t" + hi + ", " + hi + ", " + th)
		}
		if k == 4 {
			out = append(out, "\textr\t" + c4 + ", " + hi + ", " + lo + ", #51")
			out = append(out, "\tand\t" + m4 + ", " + lo + ", " + MASK_A)
			continue
		}
		let c = cs[ci_]
		ci_ = 1 - ci_
		out = append(out, "\textr\t" + c + ", " + hi + ", " + lo + ", #51")
		out = append(out, "\tand\t" + lo + ", " + lo + ", " + MASK_A)
		if k == 0 {
			out = append(out, "\tmov\t" + tl + ", #19")
			out = append(out, "\tmadd\t" + sums[0] + ", " + c4 + ", " + tl + ", " + lo)
		} else {
			out = append(out, "\tadd\t" + sums[k] + ", " + lo + ", " + prev)
		}
		prev = c
		if r == "" {
			prev = c
		}
	}
	out = append(out, "\tadd\t" + m4 + ", " + m4 + ", " + prev)
	let s = []str{sums[0], sums[1], sums[2], sums[3], m4}
	out = append(out, "\tlsr\t" + th + ", " + s[4] + ", #51")
	out = append(out, "\tmov\t" + tl + ", #19")
	out = append(out, "\tand\t" + lo + ", " + s[0] + ", " + MASK_A)
	out = append(out, "\tmadd\t" + lo + ", " + th + ", " + tl + ", " + lo)
	out = append(out, "\tstr\t" + lo + ", [x19]")
	for i in 1..5 {
		out = append(out, "\tand\t" + lo + ", " + s[i] + ", " + MASK_A)
		out = append(out, "\tadd\t" + lo + ", " + lo + ", " + s[i - 1] + ", lsr #51")
		out = append(out, "\tstr\t" + lo + ", [x19, #" + n(8 * i) + "]")
	}
	for l in []str{"\tldr\tx27, [sp, #64]", "\tldp\tx25, x26, [sp, #48]", "\tldp\tx23, x24, [sp, #32]", "\tldp\tx21, x22, [sp, #16]", "\tldp\tx19, x20, [sp], #80", "\tret", "\t.size " + name + ", .-" + name} {
		out = append(out, l)
	}
	return out
}

fn func_reg(names []str, regs []str) str {
	return "x"
}

// ---------------- x86-64 (BMI2) ----------------

// amd64: rdi = h, rsi = f, rdx = g (moved to rcx). Operands are read from memory: f at rsi, g at rcx, the premultiplied limbs in the
// frame at rsp (56 bytes), the sums s0-s3 at rsp+64. r8/r9 accumulate (lo/hi), r10/r11 hold a product, rbx = r4's low bits, rbp = c4,
// r12/r13 the carries, r14 = mask51.
fn amd64(name str, pre []Pre, rows []Row, square bool) []str {
	mut memNames = []str{}
	mut mem = []str{}
	for i in 0..5 {
		memNames = append(memNames, "f" + n(i))
		mem = append(mem, "[rsi+" + n(8 * i) + "]")
	}
	if !square {
		for i in 0..5 {
			memNames = append(memNames, "g" + n(i))
			mem = append(mem, "[rcx+" + n(8 * i) + "]")
		}
	}
	mut out = []str{"\t.globl " + name, "\t.type " + name + ", @function", name + ":"}
	for l in []str{"\tpush\trbx", "\tpush\trbp", "\tpush\tr12", "\tpush\tr13", "\tpush\tr14", "\tsub\trsp, 96"} {
		out = append(out, l)
	}
	if !square {
		out = append(out, "\tmov\trcx, rdx")
	}
	out = append(out, "\tmov\tr14, 0x7ffffffffffff")
	for index in 0..len(pre) {
		let p = pre[index]
		out = append(out, "\timul\trax, " + mem[indexOf(memNames, p.Base)] + ", " + n(p.K))
		out = append(out, "\tmov\t[rsp+" + n(8 * index) + "], rax")
		memNames = append(memNames, p.Name)
		mem = append(mem, "[rsp+" + n(8 * index) + "]")
	}
	mut prev = ""
	mut ci_ = 0
	let cs = []str{"r12", "r13"}
	for k in order() {
		let row = rows[k]
		out = append(out, "\tmov\trdx, " + mem[indexOf(memNames, row.A[0])])
		out = append(out, "\tmulx\tr9, r8, " + mem[indexOf(memNames, row.B[0])])
		for t in 1..len(row.A) {
			out = append(out, "\tmov\trdx, " + mem[indexOf(memNames, row.A[t])])
			out = append(out, "\tmulx\tr11, r10, " + mem[indexOf(memNames, row.B[t])])
			out = append(out, "\tadd\tr8, r10")
			out = append(out, "\tadc\tr9, r11")
		}
		out = append(out, "\tshld\tr9, r8, 13")
		if k == 4 {
			out = append(out, "\tmov\trbp, r9")
			out = append(out, "\tmov\trbx, r8")
			out = append(out, "\tand\trbx, r14")
			continue
		}
		let c = cs[ci_]
		ci_ = 1 - ci_
		out = append(out, "\tmov\t" + c + ", r9")
		out = append(out, "\tand\tr8, r14")
		if k == 0 {
			out = append(out, "\timul\trax, rbp, 19")
			out = append(out, "\tadd\tr8, rax")
		} else {
			out = append(out, "\tadd\tr8, " + prev)
		}
		out = append(out, "\tmov\t[rsp+" + n(64 + 8 * k) + "], r8")
		prev = c
	}
	out = append(out, "\tadd\trbx, " + prev)
	for l in []str{"\tmov\trax, rbx", "\tshr\trax, 51", "\timul\trax, rax, 19", "\tmov\tr9, [rsp+64]", "\tmov\tr8, r9", "\tand\tr8, r14", "\tadd\tr8, rax", "\tmov\t[rdi], r8"} {
		out = append(out, l)
	}
	for i in 1..5 {
		mut cur = "[rsp+" + n(64 + 8 * i) + "]"
		if i == 4 {
			cur = "rbx"
		}
		out = append(out, "\tmov\tr8, " + cur)
		out = append(out, "\tand\tr8, r14")
		out = append(out, "\tshr\tr9, 51")
		out = append(out, "\tadd\tr8, r9")
		out = append(out, "\tmov\t[rdi+" + n(8 * i) + "], r8")
		if i < 4 {
			out = append(out, "\tmov\tr9, " + cur)
		}
	}
	for l in []str{"\tadd\trsp, 96", "\tpop\tr14", "\tpop\tr13", "\tpop\tr12", "\tpop\trbp", "\tpop\trbx", "\tret", "\t.size " + name + ", .-" + name} {
		out = append(out, l)
	}
	return out
}

const HEADER_X = `// fe_mul_hw and fe_sq_hw for seal (#488), x86-64 with BMI2 (mulx; the CPU check is bmi2_cpu).
// Generated by tools/gen/fe25519_asm.tin; do not edit. tools/gen/aes_hw.tin turns them into
// toolchain/compiler/aes_hw.tin. Relocation-free, never touches r15 (the core context); rbx, rbp and
// r12-r14 are saved. Straight-line: no branch or address depends on the operands.
.intel_syntax noprefix
.text
`

const HEADER_A = `// fe_mul_hw and fe_sq_hw for seal (#488), AArch64. Generated by tools/gen/fe25519_asm.tin; do not
// edit. tools/gen/aes_hw.tin turns them into toolchain/compiler/aes_hw.tin. Relocation-free; they
// use x0-x17 and the callee-saved x19-x27 (saved here) and keep x28 (the core context). Straight-line:
// no branch or address depends on the operands.
`

fn join(parts []str) str {
	return twine.Join(parts, "\n")
}

fn concat(a []str, b []str) []str {
	mut out = []str{}
	for x in a {
		out = append(out, x)
	}
	for x in b {
		out = append(out, x)
	}
	return out
}

// render is the two files: name and text.
fn render() ([]str, []str) {
	mut a = []str{HEADER_A + "\t.text\n", "// fe_mul_hw(h x0, f x1, g x2): h = f*g mod 2^255-19, limbs below 2^52 in and out."}
	a = concat(a, arm64("fe_mul_hw", mulPre(), mulRows(), false))
	a = concat(a, []str{"", "// fe_sq_hw(h x0, f x1): h = f*f."})
	a = concat(a, arm64("fe_sq_hw", sqPre(), sqRows(), true))
	mut x = []str{HEADER_X, "// fe_mul_hw(h rdi, f rsi, g rdx): h = f*g mod 2^255-19, limbs below 2^52 in and out."}
	x = concat(x, amd64("fe_mul_hw", mulPre(), mulRows(), false))
	x = concat(x, []str{"", "// fe_sq_hw(h rdi, f rsi): h = f*f."})
	x = concat(x, amd64("fe_sq_hw", sqPre(), sqRows(), true))
	return []str{"fe25519-amd64.S", "fe25519-arm64.S"}, []str{join(x) + "\n", join(a) + "\n"}
}

fn main() {
	let args = quarry.Args()
	let checking = len(args) > 1 && args[1] == "--check"
	check()
	let (names, texts) = render()
	for i in 0..len(names) {
		let path = ci.Join(ci.Root(), "tools/gen/arch/" + names[i])
		if checking {
			ci.Check(ci.Read(path) == texts[i], names[i] + " is stale: run tools/gen/fe25519_asm.tin")
		} else {
			ci.Write(path, texts[i])
		}
	}
	if checking {
		say.Line("fe25519 assembly is current")
	}
}
