package main

import "../ci/ci"
import "./leaves"
import "quarry"
import "twine"

// Regenerate toolchain/compiler/aes_hw.tin, seal's AES-CTR, GHASH and CPU-check leaves, from tools/gen/arch/aes-gcm-*.S (needs clang).
// The code generators emit these bytes for the seal.aes_hw_ctr, seal.aes_hw_subword, seal.ghash_hw and seal.aes_hw_cpu placeholders.
// Usage: aes_hw [--check]

fn names(arch str) []str {
	if arch == "arm64" {
		return []str{"aes_hw_ctr", "aes_hw_subword", "ghash_hw", "mont_mul", "m4_mont", "fe_mul_hw", "fe_sq_hw", "m4_add", "m4_sub", "p256_pick"}
	}
	return []str{"aes_hw_cpu", "aes_hw_ctr", "aes_hw_subword", "ghash_hw", "sha_hw_cpu", "hw_blocks", "bmi2_cpu", "mont_mul", "m4_mont", "m4_add", "m4_sub", "p256_pick", "fe_mul_hw", "fe_sq_hw"}
}

// sources are the assembly sources of each architecture (amd64's SHA-256 leaves are generated by sha256_amd64.tin).
fn sources(arch str) []str {
	if arch == "arm64" {
		return []str{"aes-gcm-arm64.S", "monty-arm64.S", "fe25519-arm64.S"}
	}
	return []str{"aes-gcm-amd64.S", "sha256-amd64.S", "monty-amd64.S", "m4-amd64.S", "fe25519-amd64.S"}
}

fn generate(work str) str {
	mut text = []str{"// Generated by tools/gen/aes_hw.tin from tools/gen/arch/aes-gcm-*.S."}
	for arch in leaves.Archs() {
		let wanted = names(arch)
		mut codes = []str{}
		for n in wanted {
			codes = append(codes, "")
		}
		for source in sources(arch) {
			let obj = leaves.Assemble(arch, ci.Join(ci.Root(), "tools/gen/arch/" + source), ci.Join(work, arch + "-" + source + ".o"), []str{})
			for k in 0..len(wanted) {
				let code = obj.Function(wanted[k])
				if len(code) > 0 {
					codes[k] = code
				}
			}
		}
		mut found = []leaves.Leaf{}
		for k in 0..len(wanted) {
			ci.Check(len(codes[k]) > 0, "aes_hw: " + wanted[k] + " is missing for " + arch)
			found = append(found, leaves.Leaf{Name: wanted[k], Hex: leaves.Hex(arch, codes[k])})
		}
		text = append(text, "")
		text = append(text, "// aes_hw_" + arch + " is the machine code of seal.NAME (NAME without the package), or 0.")
		mut body = leaves.Emit(arch, "aes_hw_" + arch, "seal.", found, []str{"\tif len(hex) == 0 {{", "\t\treturn 0", "\t}}"})
		// Emit starts with a blank line and the function: the comment above goes before the function line
		for k in 1..len(body) {
			text = append(text, body[k])
		}
	}
	return twine.Join(text, "\n") + "\n"
}

fn main() {
	let work = ci.TempDir(ci.Join(ci.Root(), "bin/ci"), "aes-hw-")
	let result = generate(work)
	ci.Remove(work)
	let args = quarry.Args()
	let write = !(len(args) > 1 && args[1] == "--check")
	leaves.Finish(ci.Join(ci.Root(), "toolchain/compiler/aes_hw.tin"), result, write, "AES machine code is stale")
}
