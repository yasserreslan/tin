package main

import "../ci/ci"
import "mint"
import "quarry"
import "say"
import "twine"

// Generate toolchain/std/seal/fe25519.tin: multiplication and squaring mod 2^255 - 19 on five unsigned limbs in radix 2^51 (#474), as
// straight-line code: no loop, branch or bounds check past the operand loads.
//
// Each coefficient of the product is a sum of 64x64-bit products accumulated in 128 bits (lo, hi): mulhi is the high word (umulh, mul),
// lt the carry of the low word (cset). A product past limb 4 wraps around with factor 19 (2^255 = 19 mod p), folded into one operand.
// With limbs below 2^52 every coefficient is below 2^111 (Go's crypto/internal/fips140/edwards25519/field has the bounds); the carries
// then bring the limbs back below 2^52.
//
// Usage: fe25519 [--check]

fn n(i i64) str {
	return mint.Itoa(i)
}

// acc accumulates the products in terms (a, b pairs) into (name_lo, name_hi).
fn acc(lines mut []str, name str, a []str, b []str) {
	lines = append(lines, "\tmut " + name + "lo = " + a[0] + " * " + b[0])
	lines = append(lines, "\tmut " + name + "hi = mulhi(" + a[0] + ", " + b[0] + ")")
	for k in 1..len(a) {
		lines = append(lines, "\tlet " + name + a[k] + b[k] + " = " + a[k] + " * " + b[k])
		lines = append(lines, "\t" + name + "hi += mulhi(" + a[k] + ", " + b[k] + ")")
		lines = append(lines, "\t" + name + "lo += " + name + a[k] + b[k])
		lines = append(lines, "\t" + name + "hi += lt(" + name + "lo, " + name + a[k] + b[k] + ")")
	}
}

// reduce carries the five 128-bit coefficients into limbs below 2^52 and stores them in h.
fn reduce(lines mut []str) {
	for i in 0..5 {
		lines = append(lines, "\tlet c" + n(i) + " = (r" + n(i) + "hi << 13) | (r" + n(i) + "lo >> 51)")
	}
	lines = append(lines, "\tlet s0 = (r0lo & mask51) + c4*19")
	for i in 1..5 {
		lines = append(lines, "\tlet s" + n(i) + " = (r" + n(i) + "lo & mask51) + c" + n(i - 1))
	}
	lines = append(lines, "\th[0] = (s0 & mask51) + (s4>>51)*19")
	for i in 1..5 {
		lines = append(lines, "\th[" + n(i) + "] = (s" + n(i) + " & mask51) + (s" + n(i - 1) + " >> 51)")
	}
}

fn mulLines() []str {
	mut lines = []str{"// fe_mul sets h = f*g; h may alias f or g. Limbs of f and g below 2^52.", "@wrap fn fe_mul(h mut []u64, f []u64, g []u64) {{", "\tif mont_hw && len(h) == 5 && len(f) == 5 && len(g) == 5 {{", "\t\tfe_mul_hw(cast(i64, h)[2], cast(i64, f)[2], cast(i64, g)[2])", "\t\treturn", "\t}}"}
	for i in 0..5 {
		lines = append(lines, "\tlet f" + n(i) + " = f[" + n(i) + "]")
	}
	for i in 0..5 {
		lines = append(lines, "\tlet g" + n(i) + " = g[" + n(i) + "]")
	}
	for i in 1..5 {
		lines = append(lines, "\tlet f" + n(i) + "x19 = f" + n(i) + " * 19")
	}
	for k in 0..5 {
		mut a = []str{}
		mut b = []str{}
		for i in 0..5 {
			let j = ((k - i) % 5 + 5) % 5
			if i + j >= 5 {
				a = append(a, "f" + n(i) + "x19")
			} else {
				a = append(a, "f" + n(i))
			}
			b = append(b, "g" + n(j))
		}
		acc(mut lines, "r" + n(k), a, b)
	}
	reduce(mut lines)
	lines = append(lines, "}}")
	return lines
}

fn sqLines() []str {
	mut lines = []str{"// fe_sq sets h = f*f (each cross product once, doubled); h may alias f.", "@wrap fn fe_sq(h mut []u64, f []u64) {{", "\tif mont_hw && len(h) == 5 && len(f) == 5 {{", "\t\tfe_sq_hw(cast(i64, h)[2], cast(i64, f)[2])", "\t\treturn", "\t}}"}
	for i in 0..5 {
		lines = append(lines, "\tlet f" + n(i) + " = f[" + n(i) + "]")
	}
	for l in []str{"\tlet f0x2 = f0 * 2", "\tlet f1x2 = f1 * 2", "\tlet f1x38 = f1 * 38", "\tlet f2x38 = f2 * 38", "\tlet f3x38 = f3 * 38", "\tlet f3x19 = f3 * 19", "\tlet f4x19 = f4 * 19"} {
		lines = append(lines, l)
	}
	let rowsA = [][]str{[]str{"f0", "f1x38", "f2x38"}, []str{"f0x2", "f2x38", "f3x19"}, []str{"f0x2", "f1", "f3x38"}, []str{"f0x2", "f1x2", "f4x19"}, []str{"f0x2", "f1x2", "f2"}}
	let rowsB = [][]str{[]str{"f0", "f4", "f3"}, []str{"f1", "f4", "f3"}, []str{"f2", "f1", "f4"}, []str{"f3", "f2", "f4"}, []str{"f4", "f3", "f2"}}
	for k in 0..5 {
		acc(mut lines, "r" + n(k), rowsA[k], rowsB[k])
	}
	reduce(mut lines)
	lines = append(lines, "}}")
	return lines
}

fn generate() str {
	mut out = []str{"// Code generated by tools/gen/gen_fe25519.py; DO NOT EDIT.", "", "package seal", ""}
	for l in mulLines() {
		out = append(out, l)
	}
	out = append(out, "")
	for l in sqLines() {
		out = append(out, l)
	}
	return twine.Join(out, "\n") + "\n"
}

fn main() {
	let text = generate()
	let args = quarry.Args()
	if len(args) > 1 && args[1] == "--check" {
		let path = ci.Join(ci.Root(), "toolchain/std/seal/fe25519.tin")
		ci.Check(ci.Read(path) == text, "run tools/gen/fe25519.tin > toolchain/std/seal/fe25519.tin")
		return
	}
	say.Out("%s", text)
}
