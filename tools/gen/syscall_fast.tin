package main

import "../ci/ci"
import "./leaves"
import "quarry"
import "twine"

// Generate bounded strict syscall leaves using the recorded per-CPU Linux numbers (needs clang).
// Usage: syscall_fast [--check]

fn calls() []str {
	return []str{"read", "write", "close", "fcntl", "accept", "recvfrom", "epoll_ctl", "epoll_pwait", "timerfd_settime", "clock_gettime", "clone"}
}

fn leafName(call str) str {
	if call == "recvfrom" {
		return "rt_sys_recv"
	}
	if call == "epoll_pwait" {
		return "rt_sys_epoll_wait"
	}
	return "rt_sys_" + call
}

// number is the syscall number a runtime source records for the call: `fn linux_nr_NAME() i64 { return N }`.
fn number(source str, call str) str {
	let marker = "fn linux_nr_" + call + "()"
	let at = twine.Index(source, marker)
	ci.Check(at >= 0, "syscall_fast: no number for " + call)
	let rest = source[at + len(marker):]
	let ret = twine.Index(rest, "return ")
	mut digits = ""
	mut i = ret + 7
	for i < len(rest) && rest[i] >= '0' && rest[i] <= '9' {
		digits += rest[i:i + 1]
		i += 1
	}
	ci.Check(len(digits) > 0, "syscall_fast: no number for " + call)
	return digits
}

fn generate(work str) str {
	mut text = []str{"// Generated by tools/gen/syscall_fast.tin from tools/gen/arch/syscall-fast-*.S."}
	for arch in leaves.Archs() {
		let source = ci.Read(ci.Join(ci.Root(), "toolchain/runtime/syscalls_linux_" + arch + ".tin"))
		mut defines = []str{}
		mut all = calls()
		all = append(all, "exit")
		for c in all {
			defines = append(defines, "-DNR_" + twine.ToUpper(c) + "=" + number(source, c))
		}
		let obj = leaves.Assemble(arch, ci.Join(ci.Root(), "tools/gen/arch/syscall-fast-" + arch + ".S"), ci.Join(work, arch + ".o"), defines)
		mut found = []leaves.Leaf{}
		for c in calls() {
			let name = leafName(c)
			let code = obj.Function(name)
			ci.Check(len(code) > 0, "syscall_fast: " + name + " is missing")
			found = append(found, leaves.Leaf{Name: name, Hex: leaves.Hex(arch, code)})
		}
		for l in leaves.Emit(arch, "syscall_fast_" + arch, "", found, []str{"\tif i64(byte_at(hex, 0)) == 0 {{", "\t\treturn 0", "\t}}"}) {
			text = append(text, l)
		}
	}
	return twine.Join(text, "\n") + "\n"
}

fn main() {
	let work = ci.TempDir(ci.Join(ci.Root(), "bin/ci"), "syscall-fast-")
	let result = generate(work)
	ci.Remove(work)
	let args = quarry.Args()
	let write = !(len(args) > 1 && args[1] == "--check")
	leaves.Finish(ci.Join(ci.Root(), "toolchain/compiler/syscall_fast.tin"), result, write, "syscall leaves are stale")
}
