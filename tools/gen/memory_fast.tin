package main

import "../ci/ci"
import "./leaves"
import "quarry"
import "twine"

// Regenerate bounded vector leaves from their relocation-free assembly sources (needs clang).
// Usage: memory_fast [--check]

fn names() []str {
	return []str{"memcpy", "memmove", "memset", "memcmp", "memchr"}
}

fn isVector(name str) bool {
	return name == "memcpy" || name == "memmove" || name == "memcmp" || name == "memchr"
}

fn generate(work str) str {
	mut text = []str{"// Generated by tools/gen/memory_fast.tin from tools/gen/arch/memory-fast-*.S."}
	for arch in leaves.Archs() {
		let source = ci.Join(ci.Root(), "tools/gen/arch/memory-fast-" + arch + ".S")
		mut wanted = names()
		if arch == "amd64" {
			wanted = append(wanted, "mem_avx2_supported")
		}
		let table = leaves.Assemble(arch, source, ci.Join(work, arch + ".o"), []str{})
		// the AVX2-capable variants (they read the core context in r15): every program has one
		mut vectors = table
		mut haveVectors = false
		if arch == "amd64" {
			vectors = leaves.Assemble(arch, source, ci.Join(work, arch + "-vector.o"), []str{"-DMEMORY_VECTOR"})
			haveVectors = true
		}
		mut found = []leaves.Leaf{}
		for name in wanted {
			mut code = table.Function(name)
			if isVector(name) && haveVectors {
				code = vectors.Function(name)
			}
			ci.Check(len(code) > 0, "memory_fast: " + name + " is missing from " + source)
			found = append(found, leaves.Leaf{Name: name, Hex: leaves.Hex(arch, code)})
		}
		for l in leaves.Emit(arch, "memory_fast_" + arch, "", found, []str{}) {
			text = append(text, l)
		}
	}
	return twine.Join(text, "\n") + "\n"
}

fn main() {
	let work = ci.TempDir(ci.Join(ci.Root(), "bin/ci"), "memory-fast-")
	let result = generate(work)
	ci.Remove(work)
	let args = quarry.Args()
	let write = !(len(args) > 1 && args[1] == "--check")
	leaves.Finish(ci.Join(ci.Root(), "toolchain/compiler/memory_fast.tin"), result, write, "memory machine code is stale")
}
