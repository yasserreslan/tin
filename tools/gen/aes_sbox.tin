package main

import "../ci/ci"
import "mint"
import "quarry"
import "say"
import "twine"

// Generate toolchain/std/seal/aes_sbox.tin: the AES S-box on eight bit planes, as straight-line code.
//
// Plane i holds bit i of up to 64 bytes. The S-box is the inverse in GF(2^8) (x^254, mod x^8 + x^4 + x^3 + x + 1) followed by the
// affine map with 0x63, computed with ANDs and XORs only, so no table is indexed by data (the point of a constant-time AES).
//
// Usage: aes_sbox [--check]   (prints the file; --check compares it with toolchain/std/seal/aes_sbox.tin)

mut lines = []str{}
mut counter = 0

fn fresh() str {
	counter += 1
	return "v" + mint.Itoa(counter)
}

fn count(xs []str, x str) i64 {
	mut n = 0
	for y in xs {
		if y == x {
			n += 1
		}
	}
	return n
}

// reduce reduces 15 product planes (lists of terms) to 8, mod x^8 + x^4 + x^3 + x + 1.
fn reduce(planes [][]str) []str {
	mut p = planes
	for k in []i64{14, 13, 12, 11, 10, 9, 8} {
		for d in []i64{4, 5, 7, 8} {
			mut joined = []str{}
			for t in p[k - d] {
				joined = append(joined, t)
			}
			for t in p[k] {
				joined = append(joined, t)
			}
			p[k - d] = joined
		}
		p[k] = []str{}
	}
	mut out = []str{}
	for k in 0..8 {
		// x ^ x = 0: keep only the terms that occur an odd number of times.
		mut terms = []str{}
		mut seen = []str{}
		for t in p[k] {
			if count(seen, t) == 0 {
				seen = append(seen, t)
				if count(p[k], t) % 2 == 1 {
					terms = append(terms, t)
				}
			}
		}
		if len(terms) == 0 {
			out = append(out, "u64(0)")
			continue
		}
		if len(terms) == 1 {
			out = append(out, terms[0])
			continue
		}
		let v = fresh()
		lines = append(lines, "\tlet " + v + " = " + twine.Join(terms, " ^ "))
		out = append(out, v)
	}
	return out
}

fn emptyPlanes() [][]str {
	mut p = [][]str{}
	for i in 0..15 {
		p = append(p, []str{})
	}
	return p
}

fn mul(a []str, b []str) []str {
	mut p = emptyPlanes()
	for i in 0..8 {
		for j in 0..8 {
			let v = fresh()
			lines = append(lines, "\tlet " + v + " = " + a[i] + " & " + b[j])
			p[i + j] = append(p[i + j], v)
		}
	}
	return reduce(p)
}

fn sq(a []str) []str {
	mut p = emptyPlanes()
	for i in 0..8 {
		p[2 * i] = append(p[2 * i], a[i])
	}
	return reduce(p)
}

fn generate() str {
	lines = []str{}
	counter = 0
	mut x = []str{}
	for i in 0..8 {
		x = append(x, "q" + mint.Itoa(i))
		lines = append(lines, "\tlet q" + mint.Itoa(i) + " = q[" + mint.Itoa(i) + "]")
	}
	let x2 = sq(x)
	let x3 = mul(x2, x)
	let x6 = sq(x3)
	let x12 = sq(x6)
	let x15 = mul(x12, x3)
	let x30 = sq(x15)
	let x60 = sq(x30)
	let x120 = sq(x60)
	let x240 = sq(x120)
	let x252 = mul(x240, x12)
	let inv = mul(x252, x2)
	// The affine map: b_i = x_i ^ x_(i+4) ^ x_(i+5) ^ x_(i+6) ^ x_(i+7) ^ bit i of 0x63.
	for i in 0..8 {
		mut terms = []str{}
		for k in []i64{0, 4, 5, 6, 7} {
			terms = append(terms, inv[(i + k) % 8])
		}
		mut expr = twine.Join(terms, " ^ ")
		if ((0x63 >> i) & 1) == 1 {
			expr = "^(" + expr + ")"
		}
		lines = append(lines, "\tq[" + mint.Itoa(i) + "] = " + expr)
	}
	mut out = []str{"// Code generated by tools/gen/aes_sbox.tin; DO NOT EDIT.", "", "package seal", "", "// aes_sbox applies the AES S-box to every byte held in the bit planes q[0..7], with", "// ANDs and XORs only (constant-time: no table, no branch).", "fn aes_sbox(q mut []u64) {{"}
	for l in lines {
		out = append(out, l)
	}
	out = append(out, "}}")
	out = append(out, "")
	return twine.Join(out, "\n")
}

fn main() {
	let text = generate()
	let args = quarry.Args()
	if len(args) > 1 && args[1] == "--check" {
		let path = ci.Join(ci.Root(), "toolchain/std/seal/aes_sbox.tin")
		ci.Check(ci.Read(path) == text, "run tools/gen/aes_sbox.tin > toolchain/std/seal/aes_sbox.tin")
		return
	}
	say.Out("%s", text)
}
