// Region pass: request memory must never be reachable from long-lived memory.
//
// Every request allocates from its core's pool (ember), which is wiped when the request
// ends; globals and everything they hold live in the core's ingot heap. The pass gives
// each expression a set of region bits and rejects any store of a possibly-ember pointer
// into a container that may be long-lived, unless the value went through keep().
// A container that is not long-lived may still hold long-lived or parameter objects (a
// fresh slice holding a global's struct): the pass records, per type, the origins stored
// into such containers (rg_hold), and reads of that type out of them carry those origins.
// Functions are summarized (which parameters they store into and what they store, what
// their containers hold, and where their results come from) and the summaries are
// iterated to a fixed point.
const RG_FRESH = 1 // may be a fresh allocation from the current request's pool
const RG_INGOT = 2 // may be long-lived (a global or something reachable from one)
const RG_UNK = 4 // origin unknown: treated as long-lived when stored into
const RG_EMB = 8 // the value may point into request memory
const RG_OUT = 16 // in an arena's closure: made outside the arena (#236)
const RG_P0 = 256 // derived from parameter i: bit 8 + i
const RG_MAXP = 48


shared mut rg_fn i64
shared mut rg_sum i64
shared mut rg_report i64
shared mut rg_changed i64 // a summary grew: another round is needed
shared mut rg_lchanged i64 // a local's bits grew
shared mut rg_nparams i64
shared mut rg_multi []i64 // per-result bits of the last call (for ST_CALLMULTI)
shared mut rg_modrep i64 // parameters already reported as modified
shared mut rg_held []i64 // [holder type, type, bits] triples: origins held by containers that may not be long-lived (#1080)
shared mut rg_fnsum i64 // the summaries of all functions used as values, joined (indirect calls)
shared mut rs_active i64 // the use-after-reset walk is running (rs_walk)
shared mut rs_dead []i64 // locals that may hold request memory from before a hearth.Reset()
shared mut rs_said []i64 // locals already reported
shared mut rs_cur []i64 // [local, bits] of each local's latest assignment on the walk (else Sym.region)

fn has_ptr(t Ty) i64 {
	let k = kind_of(t)
	if k == K_OPT {
		return has_ptr(cast(Ty, t.elem))
	}
	if k == K_DYN {
		// A dyn value's bits are its object's; the table is static.
		return 1
	}
	// A value struct's bytes are copied wherever it is stored (#631): no reference flows, unless
	// a field of it is one (#669).
	return i64(k == K_STRING || (k == K_STRUCT && (t.value == 0 || value_has_ref(t) != 0)) || k == K_SLICE || k == K_MAP || k == K_ERROR || k == K_FUNC)
}

fn rg_analyzable(f Fn) i64 {
	return i64(f.extern_ == 0 && f.body != 0 && f.generated == 0 && is_template(f) == 0)
}

fn is_keep_fn(f Fn) i64 {
	let n = f.qname
	return i64(len(n) >= 5 && i64(byte_at(n, 0)) == 'k' && i64(n[1]) == 'e' && i64(n[2]) == 'e' && i64(n[3]) == 'p' && i64(n[4]) == '$')
}

fn region_check() {
	mut i = 0
	for i < len(prog_fns) {
		let f = prog_fns[i]
		if rg_analyzable(f) != 0 {
			f.regsum = rg_sum_new()
		}
		i = i + 1
	}
	rg_fnsum = rg_sum_new()
	mut round = 0
	rg_changed = 1
	for rg_changed != 0 && round < 60 {
		rg_changed = 0
		i = 0
		for i < len(prog_fns) {
			let f = prog_fns[i]
			if f.regsum != 0 && f.reach != 0 {
				rg_fn_pass(f, 0)
			}
			i = i + 1
		}
		round = round + 1
	}
	i = 0
	for i < len(prog_fns) {
		let f = prog_fns[i]
		if f.regsum != 0 && f.reach != 0 {
			rg_fn_pass(f, 1)
		}
		i = i + 1
	}
	with_body_check()
}

fn rg_sum_new() i64 {
	let sum = calloc(15, 8) // [12]: the function resets the request pool (hearth.Reset)
	// [13]: it may keep memory past the call other than through its parameters and results
	// [14]: it may allocate pool memory, itself or through a call (loop_pools)
	sum[1] = cast(i64, []i64{})
	sum[10] = cast(i64, []i64{})
	sum[11] = cast(i64, []i64{})
	return sum
}

fn rg_fn_pass(f Fn, report i64) {
	rg_fn = cast(i64, f)
	rg_sum = f.regsum
	if is_keep_fn(f) != 0 {
		rg_sum[2] = RG_INGOT
		return
	}
	set_file(f.file)
	rg_report = 0
	let locals = cast([]i64, f.locals)
	rg_nparams = len(f.params)
	mut i = 0
	for i < len(locals) {
		let s = cast(Sym, locals[i])
		// A captured local also holds what frame-local closures stored into it.
		s.region = s.capbits
		if i < rg_nparams && has_ptr(cast(Ty, s.type_)) != 0 {
			s.region = RG_EMB | RG_UNK
			if i < RG_MAXP {
				s.region = RG_EMB | (RG_P0 << i)
			}
		}
		i = i + 1
	}
	rg_held = []i64{}
	mut iter = 0
	rg_lchanged = 1
	for rg_lchanged != 0 && iter < 30 {
		rg_lchanged = 0
		rg_stmts(cast(Block, f.body).stmts)
		iter = iter + 1
	}
	// Callers can reach what is held only through the parameters and results.
	i = 0
	for i < len(rg_held) {
		let t = rg_held[i + 1]
		if rg_visible(f, t) != 0 && rg_merge3(cast([]i64, rg_sum[1]), rg_held[i], t, rg_held[i + 2]) != 0 {
			rg_changed = 1
		}
		i = i + 3
	}
	if report != 0 && file_trusted[f.file] == 0 {
		rg_report = 1
		rg_modrep = 0
		rg_stmts(cast(Block, f.body).stmts)
		rg_detach_check(cast(i64, f))
		rg_report = 0
		if rg_sum[12] != 0 {
			rs_walk(f)
		}
	}
}

fn rg_stmts(v []i64) {
	mut i = 0
	for i < len(v) {
		rg_stmt(v[i])
		i = i + 1
	}
}

fn rg_local(s Sym, bits i64) {
	if has_ptr(cast(Ty, s.type_)) == 0 {
		return
	}
	if (s.region | bits) != s.region {
		s.region = s.region | bits
		rg_lchanged = 1
	}
}

fn rg_assign_sym(s Sym, bits i64, pos i64) {
	if s.kind == SYM_LOCAL {
		rg_local(s, bits)
	} else if s.kind == SYM_GLOBAL {
		rg_store(RG_INGOT, 0, 0, bits, 0, pos, s.name)
	}
}

fn rg_stmt(s i64) {
	rg_cell_note = -1
	let k = cast(Node, s).kind
	if k == ST_BLOCK {
		rg_stmts(cast(Block, s).stmts)
	} else if k == ST_LET {
		if cast(LetStmt, s).init != 0 {
			rg_local(cast(Sym, cast(LetStmt, s).sym), rg_expr(cast(LetStmt, s).init))
		}
	} else if k == ST_ASSIGN {
		let t = cast(AssignStmt, s).target
		let v = rg_expr(cast(AssignStmt, s).value)
		rg_note_kept(t, v)
		let tk = cast(Node, t).kind
		if tk == EX_IDENT {
			rg_assign_sym(cast(Sym, cast(IdentExpr, t).ref), v, cast(Node, s).pos)
		} else if rg_value_field(t) != 0 {
			rg_value_store(t, v, cast(Node, s).pos)
		} else if rg_regrow(t, cast(AssignStmt, s).value) != 0 {
			// The slot gets back the object it held; the append checked what it added.
		} else if tk == EX_MEM && rg_cell_index(cast(MemExpr, t).base) >= 0 {
			rg_cell_store(rg_cell_index(cast(MemExpr, t).base), v, cast(Node, t).type_, cast(Node, s).pos)
		} else if tk == EX_MEM && rg_own_cell(t) != 0 {
			// The parent's own store into a variable it keeps in a cell.
			rg_local(cast(Sym, rg_own_cell(t)), v)
		} else if tk == EX_MEM {
			let c = rg_expr(cast(MemExpr, t).base)
			if cast(MemExpr, t).index != 0 {
				rg_expr(cast(MemExpr, t).index)
			}
			rg_store(c, rg_owner(cast(MemExpr, t).base), rg_key(cast(Node, cast(MemExpr, t).base).type_), v, cast(Node, t).type_, cast(Node, s).pos, "")
		} else if tk == EX_ELEM {
			let c2 = rg_expr(cast(ElemExpr, t).seq)
			rg_expr(cast(ElemExpr, t).idx)
			rg_store(c2, rg_owner(cast(ElemExpr, t).seq), rg_key(cast(Node, cast(ElemExpr, t).seq).type_), v, cast(Node, t).type_, cast(Node, s).pos, "")
		} else {
			rg_expr(t)
		}
	} else if k == ST_EXPR {
		rg_expr(cast(ExprStmt, s).x)
	} else if k == ST_IF {
		rg_expr(cast(IfStmt, s).cond)
		rg_stmts(cast(Block, cast(IfStmt, s).then).stmts)
		if cast(IfStmt, s).else_ != 0 {
			rg_stmt(cast(IfStmt, s).else_)
		}
	} else if k == ST_WHILE {
		rg_expr(cast(WhileStmt, s).cond)
		rg_stmts(cast(Block, cast(WhileStmt, s).body).stmts)
		if cast(WhileStmt, s).post != 0 {
			rg_stmt(cast(WhileStmt, s).post)
		}
	} else if k == ST_RETURN {
		if cast(ReturnStmt, s).value != 0 {
			rg_result(0, rg_expr(cast(ReturnStmt, s).value))
		}
		if cast(i64, cast(ReturnStmt, s).values) != 0 {
			mut i = 0
			for i < len(cast(ReturnStmt, s).values) {
				rg_result(i, rg_expr(cast(ReturnStmt, s).values[i]))
				i = i + 1
			}
		}
	} else if k == ST_CALLMULTI {
		rg_expr(cast(CallMultiStmt, s).call)
		let bits = rg_multi
		let syms = cast(CallMultiStmt, s).syms
		mut j = 0
		for j < len(syms) {
			let sy = syms[j]
			if cast(i64, sy) != 0 {
				mut b = RG_UNK | RG_EMB
				if cast(i64, bits) != 0 && j < 8 {
					b = bits[j]
				}
				rg_assign_sym(cast(Sym, sy), b, cast(Node, s).pos)
			}
			j = j + 1
		}
	}
}

// rg_regrow reports whether x appends onto the slot target t names: append grows the
// header in place and returns it, so storing the result back changes nothing.
fn rg_regrow(t i64, x_in i64) i64 {
	mut x = rg_unseq(x_in)
	for cast(Node, x).kind == EX_CALL && len(cast(Call, x).name) != 0 && (cast(Call, x).name == "rt_append" || cast(Call, x).name == "rt_append_rc" || cast(Call, x).name == "rt_slice_appendn" || cast(Call, x).name == "rt_slice_appendn_rc" || cast(Call, x).name == "rt_append_str" || cast(Call, x).name == "rt_append_dyn" || cast(Call, x).name == "rt_slice_appendn_dyn" || cast(Call, x).name == "rt_append_mem" || cast(Call, x).name == "rt_append_mem_rc" || cast(Call, x).name == "rt_slice_appendn_vrc") {
		x = rg_unseq(cast(Call, x).args[0])
	}
	return rg_same(t, x)
}

// rg_unseq is the call inside a dyn append, which binds its value first (lower_append_dyn).
fn rg_unseq(x i64) i64 {
	if cast(Node, x).kind == EX_SEQ && cast(Node, cast(SeqExpr, x).value).kind == EX_CALL && cast(Call, cast(SeqExpr, x).value).name == "rt_append_dyn" {
		return cast(SeqExpr, x).value
	}
	return x
}

// rg_same reports whether two expressions name the same slot: one variable, or the same
// field or element of the same slot, indexed by one variable or constant.
fn rg_same(a i64, b i64) i64 {
	let k = cast(Node, a).kind
	if k != cast(Node, b).kind {
		return 0
	}
	if k == EX_IDENT {
		return i64(cast(IdentExpr, a).ref != 0 && cast(IdentExpr, a).ref == cast(IdentExpr, b).ref)
	}
	if k == EX_INT {
		return i64(cast(IntLit, a).val == cast(IntLit, b).val)
	}
	if k == EX_MEM {
		return i64(cast(MemExpr, a).index == 0 && cast(MemExpr, b).index == 0 && cast(MemExpr, a).off == cast(MemExpr, b).off && rg_same(cast(MemExpr, a).base, cast(MemExpr, b).base) != 0)
	}
	if k == EX_ELEM {
		return i64(rg_same(cast(ElemExpr, a).seq, cast(ElemExpr, b).seq) != 0 && rg_same(cast(ElemExpr, a).idx, cast(ElemExpr, b).idx) != 0)
	}
	return 0
}

fn rg_result(i i64, bits i64) {
	if i >= 8 {
		return
	}
	if (rg_sum[2 + i] | bits) != rg_sum[2 + i] {
		rg_sum[2 + i] = rg_sum[2 + i] | bits
		rg_changed = 1
	}
}

// rg_load is what a pointer of type t read out of a container with bits b may be: anything
// held by long-lived memory is long-lived (the pass keeps it so); anything else may be
// ember, or whatever such containers were given (rg_hold).
fn rg_load(b i64, t i64) i64 {
	return rg_load_in(b, t, 0)
}

// rg_load_in is rg_load for a read out of a container of key type o (0: unknown): only what
// was stored into containers of that type comes back out (#1080).
fn rg_load_in(b i64, t i64, o i64) i64 {
	mut r = b & ~RG_EMB
	if (b & ~RG_INGOT) != 0 {
		r = r | RG_EMB
	}
	if b != RG_INGOT {
		r = r | rg_held_lookup(o, rg_key(t))
	}
	return r
}

// rg_held_lookup joins the bits of the held triples for type t whose holder type is o; a
// holder of 0 on either side is unknown and matches every holder.
fn rg_held_lookup(o i64, t i64) i64 {
	mut r = 0
	mut i = 0
	for t != 0 && i < len(rg_held) {
		if rg_held[i + 1] == t && (o == 0 || rg_held[i] == 0 || rg_held[i] == o) {
			r = r | rg_held[i + 2]
		}
		i = i + 3
	}
	return r
}

// rg_key is the type held objects are filed under: an optional holds the same objects as
// its element. Strings and faults cannot be modified, so where they come from no longer
// matters once they are in a container: 0.
fn rg_key(t_in i64) i64 {
	mut t = cast(Ty, t_in)
	if kind_of(t) == K_OPT {
		t = cast(Ty, t.elem)
	}
	let k = kind_of(t)
	if k == K_STRUCT || k == K_SLICE || k == K_MAP || k == K_DYN {
		return cast(i64, t)
	}
	return 0
}

// rg_owner is the type of the object an expression reads out of (a field's struct, an
// element's slice), or 0 when the expression is not such a read.
fn rg_owner(e i64) i64 {
	let k = cast(Node, e).kind
	if k == EX_MEM && has_ptr(cast(Ty, cast(Node, cast(MemExpr, e).base).type_)) != 0 {
		return rg_key(cast(Node, cast(MemExpr, e).base).type_)
	}
	if k == EX_ELEM {
		return rg_key(cast(Node, cast(ElemExpr, e).seq).type_)
	}
	return 0
}

// rg_merge adds bits to type t's entry in the pair vector h and reports whether it grew.
fn rg_merge(h []i64, t i64, bits i64) i64 {
	mut i = 0
	for i < len(h) {
		if h[i] == t {
			let old = h[i + 1]
			h[i + 1] = old | bits
			return i64((old | bits) != old)
		}
		i = i + 2
	}
	h = append(h, t)
	h = append(h, bits)
	return 1
}

// rg_merge3 adds bits to the entry for holder type o and type t in the triple vector h
// (held objects, rg_held) and reports whether it grew.
fn rg_merge3(h []i64, o i64, t i64, bits i64) i64 {
	mut i = 0
	for i < len(h) {
		if h[i] == o && h[i + 1] == t {
			let old = h[i + 2]
			h[i + 2] = old | bits
			return i64((old | bits) != old)
		}
		i = i + 3
	}
	h = append(h, o)
	h = append(h, t)
	h = append(h, bits)
	return 1
}

fn rg_lookup(h []i64, t i64) i64 {
	mut i = 0
	for t != 0 && i < len(h) {
		if h[i] == t {
			return h[i + 1]
		}
		i = i + 2
	}
	return 0
}

// rg_hold records that a container that may not be long-lived now holds a value of type t
// with bits v. Fresh and ember origins are what reads out of such a container give anyway;
// long-lived, unknown and parameter origins must come back out with the value.
fn rg_hold(t i64, v i64) {
	rg_hold_in(0, t, v)
}

// rg_hold_in is rg_hold for a container of key type o (0: unknown), so that reads out of
// containers of other types do not pick up what it holds (#1080).
fn rg_hold_in(o i64, t i64, v i64) {
	let k = rg_key(t)
	let b = v & ~(RG_FRESH | RG_EMB)
	if k != 0 && b != 0 && rg_merge3(rg_held, o, k, b) != 0 {
		rg_lchanged = 1
	}
}

// rg_reaches reports whether a value of type from leads, through one or more fields,
// elements or map values, to an object of key type to (seen guards recursive types).
fn rg_reaches(from_in i64, to i64, seen []i64) i64 {
	mut from = cast(Ty, from_in)
	if kind_of(from) == K_OPT {
		from = cast(Ty, from.elem)
	}
	if slice_index(seen, cast(i64, from)) >= 0 {
		return 0
	}
	seen = append(seen, cast(i64, from))
	let k = kind_of(from)
	if k == K_SLICE || k == K_MAP {
		return i64(rg_key(from.elem) == to || rg_reaches(from.elem, to, seen) != 0)
	}
	mut i = 0
	for k == K_STRUCT && cast(i64, from.fields) != 0 && i < len(from.fields) {
		let t = field_type(from, i)
		if rg_key(t) == to || rg_reaches(t, to, seen) != 0 {
			return 1
		}
		i = i + 1
	}
	return 0
}

// rg_deep widens the bits b of an argument of type t with the held pairs reachable from t
// (what the containers inside it may hold) that lie on a way to an object of type v held
// by an object of type o (o 0: by anything; o and v 0: any object inside the argument).
fn rg_deep(b_in i64, t i64, o i64, v i64) i64 {
	mut b = b_in
	if b == RG_INGOT {
		// Long-lived memory holds only long-lived memory.
		return b
	}
	mut i = 0
	for i < len(rg_held) {
		let h = rg_held[i + 1]
		mut on_ = i64((o == 0 && v == 0) || h == o || h == v)
		if on_ == 0 && o != 0 {
			on_ = rg_reaches(h, o, []i64{})
		} else if on_ == 0 {
			on_ = rg_reaches(h, v, []i64{})
		}
		if on_ != 0 && rg_reaches(t, h, []i64{}) != 0 {
			b = b | rg_held[i + 2]
		}
		i = i + 3
	}
	return b
}

// rg_visible reports whether f's callers can reach objects of key type t: through its
// parameters or its results.
fn rg_visible(f Fn, t i64) i64 {
	mut i = 0
	for i < len(f.ptypes) {
		let p = f.ptypes[i]
		if rg_key(p) == t || rg_reaches(p, t, []i64{}) != 0 {
			return 1
		}
		i = i + 1
	}
	i = 0
	for i < len(f.rtypes) {
		let r = f.rtypes[i]
		if rg_key(r) == t || rg_reaches(r, t, []i64{}) != 0 {
			return 1
		}
		i = i + 1
	}
	return 0
}

// rg_record notes in recs, triples [param, holder type, type], that the function stores
// into an object of type t held by an object of type o (0: unknown) inside parameter i.
fn rg_record(recs []i64, i i64, o i64, t i64) {
	mut j = 0
	for j < len(recs) {
		if recs[j] == i && recs[j + 1] == o && recs[j + 2] == t {
			return
		}
		j = j + 3
	}
	recs = append(recs, i)
	recs = append(recs, o)
	recs = append(recs, t)
	rg_changed = 1
}

fn rg_param_name(i i64) str {
	let pf = rg_param_fn()
	return pf.locals[i].name
}

// rg_store checks a store of a value with bits v and type t into a container with bits c,
// an object of type ct held by an object of type co (see rg_record).
fn rg_store(c i64, co i64, ct i64, v i64, t i64, pos i64, gname str) {
	let pf = rg_param_fn()
	let psum = pf.regsum
	mut i = 0
	for i < len(pf.params) && i < RG_MAXP {
		if (c & (RG_P0 << i)) != 0 {
			if rg_report != 0 && pf.muts[i] == 0 && (rg_modrep & (1 << i)) == 0 {
				rg_modrep = rg_modrep | (1 << i)
				err_code_quoted(pos, "E701 NOT_MUT", "cannot modify parameter ", rg_param_name(i), ": declare it mut")
			}
			if psum != 0 {
				rg_record(cast([]i64, psum[11]), i, co, ct)
			}
		}
		i = i + 1
	}
	if c != RG_INGOT {
		rg_hold_in(ct, t, v)
	}
	if (v & RG_EMB) == 0 {
		return
	}
	if v != RG_EMB {
		// A call's stores (rg_pass gives them RG_EMB) are checked by rg_arena_call.
		rg_arena_store(c, v, pos)
	}
	if (c & (RG_INGOT | RG_UNK)) != 0 || c == 0 {
		// Long-lived memory, or a raw word with no origin (malloc'd, the core context).
		rg_keeps()
	}
	if (c & (RG_INGOT | RG_UNK)) != 0 && rg_report != 0 {
		if len(gname) != 0 {
			err_code_quoted(pos, "E310 REQUEST_ESCAPE", "request memory stored into global ", gname, ", which outlives the request: wrap the value in keep()")
		} else if cast(Fn, rg_fn).escapes != 0 && rg_cell_note >= 0 && cast(i64, cast(Fn, rg_fn).captures[rg_cell_note]) != 0 {
			err_code_quoted(pos, "E310 REQUEST_ESCAPE", "request memory stored into ", cast(Fn, rg_fn).captures[rg_cell_note].name, ", a captured variable of a closure that may outlive the request (" + rg_why() + "): wrap the value in keep()")
		} else {
			err_code_at(pos, "E310 REQUEST_ESCAPE", "request memory stored into long-lived memory (it may be reachable from a global): wrap the value in keep()")
		}
	}
	i = 0
	for i < len(pf.params) && i < RG_MAXP {
		if (c & (RG_P0 << i)) != 0 && psum != 0 {
			if (psum[0] & (1 << i)) == 0 {
				psum[0] = psum[0] | (1 << i)
				rg_changed = 1
			}
			rg_record(cast([]i64, psum[10]), i, co, ct)
		}
		i = i + 1
	}
}

// rg_value_arg notes that a callee may have written request memory into the value struct
// argument a, passed as mut (#669): a local holds it now, a value inside a container stores it.
fn rg_value_arg(a i64, pos i64) {
	if cast(Node, a).kind == EX_IDENT {
		let s = cast(Sym, cast(IdentExpr, a).ref)
		if cast(i64, s) != 0 && s.kind == SYM_LOCAL {
			rg_local(s, RG_EMB)
			return
		}
	}
	if cast(Node, a).kind == EX_MEM || cast(Node, a).kind == EX_ELEM {
		rg_value_store(a, RG_EMB, pos)
	}
}

// rg_value_field reports a store target inside a value struct with a reference field (#669).
fn rg_value_field(t i64) i64 {
	let k = cast(Node, t).kind
	if k == EX_MEM {
		return value_has_ref(cast(Ty, cast(Node, cast(MemExpr, t).base).type_))
	}
	if k == EX_ELEM {
		return value_has_ref(cast(Ty, cast(Node, cast(ElemExpr, t).seq).type_))
	}
	return 0
}

// rg_value_store checks a store of bits v into a field of a value struct (#669). The bytes are
// the value's own: a local or parameter needs nothing (its bits are always "anything"); a value
// inside a container or a global is a store of v into that container.
fn rg_value_store(t i64, v i64, pos i64) {
	mut x = t
	for {
		let k = cast(Node, x).kind
		mut b = 0
		if k == EX_MEM {
			if cast(MemExpr, x).index != 0 {
				rg_expr(cast(MemExpr, x).index)
			}
			b = cast(MemExpr, x).base
		} else if k == EX_ELEM {
			rg_expr(cast(ElemExpr, x).idx)
			b = cast(ElemExpr, x).seq
		} else {
			break
		}
		if is_value_struct(cast(Ty, cast(Node, b).type_)) == 0 {
			// x is a value inside the container b.
			let c = rg_expr(b)
			rg_store(c, rg_owner(b), rg_key(cast(Node, b).type_), v, cast(Node, x).type_, pos, "")
			return
		}
		x = b
	}
	if cast(Node, x).kind == EX_IDENT {
		let s = cast(Sym, cast(IdentExpr, x).ref)
		if cast(i64, s) != 0 && s.kind == SYM_GLOBAL {
			rg_store(RG_INGOT, 0, 0, v, cast(Node, x).type_, pos, s.name)
		} else if cast(i64, s) != 0 && s.kind == SYM_LOCAL {
			// The local now holds what its field was given too; a mut parameter's bytes are
			// its caller's, which the summary records like any store into a parameter.
			rg_local(s, v)
			let pi = slice_index(cast([]i64, cast(Fn, rg_fn).locals), cast(i64, s))
			if pi >= 0 && pi < rg_nparams {
				rg_store(s.region | (RG_P0 << pi), 0, 0, v, cast(Node, x).type_, pos, "")
			}
		}
		return
	}
	rg_expr(x)
}

// rg_own_cell is the variable e reads or writes when e is the word of a cell the running
// function made for one of its own variables, which no closure that may be kept captures; or 0.
fn rg_own_cell(e i64) i64 {
	if cast(Node, e).kind != EX_MEM || cast(MemExpr, e).index != 0 || cast(MemExpr, e).off != 0 {
		return 0
	}
	let b = cast(MemExpr, e).base
	if cast(Node, b).kind != EX_IDENT || cast(IdentExpr, b).ref == 0 {
		return 0
	}
	let os = cast(Sym, cast(IdentExpr, b).ref).cell_of
	if os == 0 || cast(Sym, os).kept_cap != 0 {
		return 0
	}
	return os
}

// rg_cell_index is i when e is the address of captured variable i, read from the closure's
// environment ($env word 2 + i), or -1.
fn rg_cell_index(e i64) i64 {
	if cast(Fn, rg_fn).parent == 0 || cast(Fn, rg_fn).env_sym == 0 || cast(Node, e).kind != EX_MEM || cast(MemExpr, e).index != 0 {
		return -1
	}
	let b = cast(MemExpr, e).base
	if cast(Node, b).kind != EX_IDENT || cast(IdentExpr, b).ref != cast(Fn, rg_fn).env_sym || cast(MemExpr, e).off < 16 {
		return -1
	}
	return cast(MemExpr, e).off / 8 - 2
}

// rg_why says why the running closure may outlive the request: where it was passed, when that is known.
fn rg_why() str {
	let why = co_why_of(rg_fn)
	if len(why) == 0 {
		return "keep() copies its variables into long-lived memory"
	}
	return why + "; keep() copies its variables into long-lived memory"
}

shared mut rg_cell_note i64 = -1 // the captured variable of a closure that may be kept read last (E310 names it)

// rg_cell_bits is what captured variable i may hold. A closure that is only passed to functions
// that call it (sift.Each and the like) lives no longer than its parent's frame: the variable
// holds what the parent and such closures put there. Any other closure may be kept, which copies
// its variables into long-lived memory, so their origin is unknown.
fn rg_cell_bits(i i64) i64 {
	if cast(Fn, rg_fn).escapes != 0 {
		rg_cell_note = i
		return RG_UNK | RG_EMB
	}
	let os = cast(Fn, rg_fn).captures[i]
	if cast(i64, os) == 0 || os.captured != 0 {
		return RG_UNK | RG_EMB
	}
	if rg_is_arena(rg_fn) != 0 {
		// Made outside the arena: what it holds is not the arena's fresh memory.
		return ((os.region | os.capbits) & ~RG_FRESH) | RG_OUT
	}
	return os.region | os.capbits
}

// rg_cell_store checks an assignment of bits v to captured variable i. In a frame-local closure
// the variable is the parent's local: the bits join it. A closure that may be kept must not
// store request memory there: once kept, its variables are long-lived (#171).
fn rg_cell_store(i i64, v_in i64, t i64, pos i64) {
	mut v = v_in
	if rg_in_arena() != 0 {
		v = rg_arena_cell_store(i, v, t, pos)
	}
	if cast(Fn, rg_fn).escapes != 0 {
		if (v & RG_EMB) != 0 && has_ptr(cast(Ty, t)) != 0 && rg_report != 0 {
			let os = cast(Fn, rg_fn).captures[i]
			mut name = "a captured variable"
			if cast(i64, os) != 0 {
				name = os.name
			}
			err_code_quoted(pos, "E311 CAPTURE_ESCAPE", "request memory stored into ", name, ", a captured variable of a closure that may outlive the request (" + rg_why() + "): wrap the value in keep(), or pass the closure only to functions that call it")
		}
		return
	}
	let os = cast(Fn, rg_fn).captures[i]
	if cast(i64, os) != 0 && os.captured == 0 && (os.capbits | v) != os.capbits {
		os.capbits = os.capbits | v
		rg_changed = 1
	}
}

fn rg_expr(e i64) i64 {
	let k = cast(Node, e).kind
	if k == EX_MEM && value_has_ref(cast(Ty, cast(Node, cast(MemExpr, e).base).type_)) != 0 {
		// A field of such a value holds what the value holds (#669).
		if cast(MemExpr, e).index != 0 {
			rg_expr(cast(MemExpr, e).index)
		}
		let vb = rg_expr(cast(MemExpr, e).base)
		if has_ptr(cast(Ty, cast(Node, e).type_)) == 0 {
			return 0
		}
		return vb
	}
	if k == EX_IDENT {
		let s = cast(Sym, cast(IdentExpr, e).ref)
		if cast(i64, s) == 0 {
			return 0
		}
		if s.kind == SYM_LOCAL {
			if rs_active != 0 && slice_has(rs_dead, cast(i64, s)) != 0 && slice_has(rs_said, cast(i64, s)) == 0 {
				rs_said = append(rs_said, cast(i64, s))
				err_code_quoted(cast(Node, e).pos, "E313 USE_AFTER_RESET", "", s.name, " may hold request memory from before hearth.Reset(), which freed it, and is read after the reset: keep() the value before the reset, or create it after")
			}
			return s.region
		}
		if s.kind == SYM_GLOBAL {
			return RG_INGOT
		}
		return 0
	}
	if k == EX_UNARY {
		rg_expr(cast(Unary, e).x)
		return 0
	}
	if k == EX_BINARY {
		rg_expr(cast(Binary, e).l)
		rg_expr(cast(Binary, e).r)
		if has_ptr(cast(Ty, cast(Node, e).type_)) != 0 {
			return RG_FRESH | RG_EMB
		}
		return 0
	}
	if k == EX_CONV {
		let x = rg_expr(cast(Conv, e).x)
		if cast(Conv, e).kind == CV_DYN_KEEP {
			return RG_INGOT
		}
		if has_ptr(cast(Ty, cast(Node, e).type_)) != 0 && has_ptr(cast(Ty, cast(Node, cast(Conv, e).x).type_)) == 0 && cast(Conv, e).kind != CV_DYN {
			// A raw word turned into a reference (standard library only): origin unknown. (A
			// value struct without references as a dyn object is its box: x, #692.)
			return x | RG_UNK | RG_EMB
		}
		return x
	}
	if k == EX_MEM && rg_cell_index(e) >= 0 {
		rg_detach_read(rg_cell_index(e))
		return 0
	}
	if k == EX_MEM && rg_cell_index(cast(MemExpr, e).base) >= 0 {
		rg_detach_read(rg_cell_index(cast(MemExpr, e).base))
		if has_ptr(cast(Ty, cast(Node, e).type_)) == 0 {
			return 0
		}
		return rg_cell_bits(rg_cell_index(cast(MemExpr, e).base))
	}
	if k == EX_MEM && rg_own_cell(e) != 0 {
		// The parent reading a variable it keeps in a cell for closures that cannot outlive it
		// (frame-local ones and a scope's children): the variable holds what was stored in it.
		let os = cast(Sym, rg_own_cell(e))
		if has_ptr(cast(Ty, cast(Node, e).type_)) == 0 {
			return 0
		}
		return os.region | os.capbits
	}
	if k == EX_MEM {
		let b = rg_expr(cast(MemExpr, e).base)
		if cast(MemExpr, e).index != 0 {
			rg_expr(cast(MemExpr, e).index)
		}
		if cast(MemExpr, e).len != 0 {
			rg_expr(cast(MemExpr, e).len)
		}
		if has_ptr(cast(Ty, cast(Node, e).type_)) == 0 {
			return 0
		}
		if has_ptr(cast(Ty, cast(Node, cast(MemExpr, e).base).type_)) == 0 {
			return b | RG_UNK | RG_EMB
		}
		return rg_load_in(b, cast(Node, e).type_, rg_key(cast(Node, cast(MemExpr, e).base).type_))
	}
	if k == EX_ELEM {
		let b2 = rg_expr(cast(ElemExpr, e).seq)
		rg_expr(cast(ElemExpr, e).idx)
		if has_ptr(cast(Ty, cast(Node, e).type_)) == 0 {
			return 0
		}
		return rg_load_in(b2, cast(Node, e).type_, rg_key(cast(Node, cast(ElemExpr, e).seq).type_))
	}
	if k == EX_SEQ {
		if rs_active != 0 {
			// the reset walk: a let in the sequence is a fresh assignment, after any reset
			rs_stmts(cast(SeqExpr, e).stmts)
		} else {
			rg_stmts(cast(SeqExpr, e).stmts)
		}
		let v = rg_expr(cast(SeqExpr, e).value)
		if cast(Node, e).region == R_OWNED {
			return RG_INGOT
		}
		if rg_unseq(e) != e {
			// A dyn append is its call: the slice it grows (#618).
			return v
		}
		if is_value_struct(cast(Ty, cast(Node, e).type_)) != 0 && is_value_struct(cast(Ty, cast(Node, cast(SeqExpr, e).value).type_)) == 0 {
			// A value struct boxed as a dyn object (box_dyn_value, #692): a block of request
			// memory, holding what its bytes were given.
			return v | RG_FRESH | RG_EMB
		}
		if is_value_struct(cast(Ty, cast(Node, e).type_)) != 0 {
			// A value struct built in a frame area (a literal, ?P's box): what its fields were
			// given, which rg_value_store added to the area's local (#669).
			return v
		}
		if has_ptr(cast(Ty, cast(Node, e).type_)) != 0 {
			return v | RG_FRESH | RG_EMB
		}
		return v
	}
	if k == EX_CALL {
		return rg_call(e)
	}
	if k == EX_FUNCREF && cast(Fn, cast(FuncRef, e).fn_).regsum != 0 {
		// A call through a function value may run this function.
		let g = cast(Fn, cast(FuncRef, e).fn_).regsum
		mut i = 0
		for i < len(cast([]i64, g[1])) {
			if rg_merge3(cast([]i64, rg_fnsum[1]), cast([]i64, g[1])[i], cast([]i64, g[1])[i + 1], cast([]i64, g[1])[i + 2]) != 0 {
				rg_changed = 1
			}
			i = i + 3
		}
		i = 0
		for i < len(cast([]i64, g[10])) {
			rg_record(cast([]i64, rg_fnsum[10]), cast([]i64, g[10])[i], cast([]i64, g[10])[i + 1], cast([]i64, g[10])[i + 2])
			i = i + 3
		}
		i = 0
		for i < len(cast([]i64, g[11])) {
			rg_record(cast([]i64, rg_fnsum[11]), cast([]i64, g[11])[i], cast([]i64, g[11])[i + 1], cast([]i64, g[11])[i + 2])
			i = i + 3
		}
		return 0
	}
	if k == EX_INDEX {
		rg_expr(cast(IndexExpr, e).x)
		rg_expr(cast(IndexExpr, e).i)
		return 0
	}
	return 0
}

// ---- detach captures only long-lived memory (#232) ----
shared mut rg_in_keep i64 // evaluating keep()'s argument
shared mut rg_detach_raw []i64 // [detached closure, bits]: captures it reads other than inside keep()
shared mut rg_kept_bits []i64 // [variable a kept closure captures, what was stored into its cell]

// rg_detach_read notes that the running function, when a detach block, reads its capture i.
fn rg_detach_read(i_in i64) {
	mut i = i_in
	if rg_in_keep != 0 || cast(i64, ck_detached) == 0 || slice_has(cast([]i64, ck_detached), rg_fn) == 0 {
		return
	}
	if cast(i64, rg_detach_raw) == 0 {
		rg_detach_raw = []i64{}
	}
	if i > 62 {
		i = 62
	}
	rg_merge(rg_detach_raw, rg_fn, 1 << i)
}

// rg_note_kept records what an assignment stores into the cell of a variable that a closure
// which may be kept captures (reads of it go through the cell, so its bits are not tracked).
fn rg_note_kept(t i64, v i64) {
	if cast(Node, t).kind != EX_MEM || cast(MemExpr, t).index != 0 || cast(MemExpr, t).off != 0 || cast(Node, cast(MemExpr, t).base).kind != EX_IDENT || cast(IdentExpr, cast(MemExpr, t).base).ref == 0 {
		return
	}
	let os = cast(Sym, cast(IdentExpr, cast(MemExpr, t).base).ref).cell_of
	if os == 0 || cast(Sym, os).kept_cap == 0 {
		return
	}
	if cast(i64, rg_kept_bits) == 0 {
		rg_kept_bits = []i64{}
	}
	rg_merge(rg_kept_bits, os, v)
}

// rg_capture_bits is what variable os of the running function (or its capture) may hold.
fn rg_capture_bits(os Sym) i64 {
	if os.captured != 0 {
		return rg_cell_bits(os.cap_idx)
	}
	mut b = os.region | os.capbits
	if cast(i64, rg_kept_bits) != 0 {
		b = b | rg_lookup(rg_kept_bits, cast(i64, os))
	}
	return b
}

// rg_detach_check reports what a detach block in f captures that may hold request memory:
// the detached task outlives the request, so the capture must be long-lived already
// (keep() it first), unless the block reads it only inside keep() (design_semantics §6).
fn rg_detach_check(f i64) {
	mut i = 0
	for cast(i64, ck_detached) != 0 && i < len(ck_detached) {
		let d = cast(Fn, cast([]i64, ck_detached)[i])
		let caps = cast([]i64, d.captures)
		mut raw = 0
		if cast(i64, rg_detach_raw) != 0 {
			raw = rg_lookup(rg_detach_raw, cast(i64, d))
		}
		mut j = 0
		for cast(Fn, d).parent == f && cast(i64, caps) != 0 && j < len(caps) {
			let os = cast(Sym, caps[j])
			mut bit = 62
			if j < 62 {
				bit = j
			}
			if cast(i64, os) != 0 && (raw & (1 << bit)) != 0 && has_ptr(cast(Ty, os.type_)) != 0 && (rg_capture_bits(cast(Sym, os)) & RG_EMB) != 0 {
				err_code_quoted(d.pos, "E314 DETACH_ESCAPE", "detach captures ", os.name, ", which may hold request memory, but the detached task outlives the request: keep() it before the block (let v = keep(...)), or read it in the block only inside keep()")
			}
			j = j + 1
		}
		i = i + 1
	}
}

// ---- arena: nothing made in it leaves it (#236, design/interface_arena.md §7) ----
//
// An arena's closure reads its captured variables as RG_OUT (made outside the arena) instead
// of RG_FRESH, so fresh bits there are the arena's own memory. Storing that into an object
// from outside, or into a captured variable, is E315; so is growing (append, map insert) a
// slice or map from outside, since the new array or table would be allocated in the arena.
shared mut rg_grows []i64 // [function, parameter bits]: the parameters (and what they hold) it may grow
shared mut rg_fstores []i64 // [function, parameter bits]: the parameters it may store its own fresh memory into
shared mut rg_pstores []i64 // [function, parameter i, parameter bits]: the parameters it may store into parameter i

fn rg_is_arena(f i64) i64 {
	return i64(cast(i64, ck_arenas) != 0 && slice_has(ck_arenas, f) != 0)
}

// rg_in_arena reports whether the running function is an arena's closure or one inside it.
fn rg_in_arena() i64 {
	mut f = cast(Fn, rg_fn)
	for cast(i64, f) != 0 {
		if rg_is_arena(cast(i64, f)) != 0 {
			return 1
		}
		f = cast(Fn, f.parent)
	}
	return 0
}

// rg_param_fn is the function whose parameters the running function's parameter bits name. An
// arena's closure has one parameter, $r, an integer that holds no bits, so the parameter bits it
// sees came in through captured variables (rg_cell_bits): they belong to the nearest enclosing
// function that is not an arena's closure.
fn rg_param_fn() Fn {
	mut f = cast(Fn, rg_fn)
	for rg_is_arena(cast(i64, f)) != 0 && f.parent != 0 {
		f = cast(Fn, f.parent)
	}
	return f
}

// rg_arena_made reports whether a value with bits v may be memory made in the arena.
fn rg_arena_made(v i64) i64 {
	return i64((v & RG_FRESH) != 0 || ((v & RG_EMB) != 0 && (v & RG_OUT) == 0))
}

fn rg_arena_escape(pos i64, name str) {
	err_code_quoted(pos, "E315 ARENA_ESCAPE", "memory made in an arena stored into ", name, ", a variable from outside it, which outlives the arena: make the value the arena block's result (it is copied out), or keep() it")
}

// rg_arena_cell_store checks a store of bits v into captured variable i inside an arena and
// returns the bits that join the variable (RG_OUT means nothing outside the arena).
fn rg_arena_cell_store(i i64, v i64, t i64, pos i64) i64 {
	let os = cast(Fn, rg_fn).captures[i]
	let outside = i64(rg_is_arena(rg_fn) != 0 || (cast(i64, os) != 0 && os.captured != 0 && rg_is_arena(cast(Fn, rg_fn).parent) != 0))
	if outside != 0 && cast(Fn, rg_fn).escapes == 0 && has_ptr(cast(Ty, t)) != 0 && rg_arena_made(v) != 0 && rg_report != 0 {
		mut name = "a captured variable"
		if cast(i64, os) != 0 {
			name = os.name
		}
		rg_arena_escape(pos, name)
	}
	return v & ~RG_OUT
}

fn rg_grows_op(name str) i64 {
	return i64(name == "rt_append" || name == "rt_append_rc" || name == "rt_append_dyn" || name == "rt_slice_appendn" || name == "rt_slice_appendn_rc" || name == "rt_append_str" || name == "rt_map_set" || name == "rt_map_setk" || name == "rt_map_set_dyn" || name == "rt_slice_appendn_dyn" || name == "rt_append_mem" || name == "rt_append_mem_rc" || name == "rt_slice_appendn_vrc" || name == "rt_map_set_vcell")
}

// rg_grow notes that the running function may grow the slice or map with bits b.
fn rg_grow(b i64, pos i64) {
	if (b & (RG_INGOT | RG_UNK)) != 0 {
		rg_keeps()
	}
	let pf = rg_param_fn()
	mut i = 0
	for i < len(pf.params) && i < RG_MAXP {
		if (b & (RG_P0 << i)) != 0 {
			if cast(i64, rg_grows) == 0 {
				rg_grows = []i64{}
			}
			if rg_merge(rg_grows, cast(i64, pf), 1 << i) != 0 {
				rg_changed = 1
			}
		}
		i = i + 1
	}
	if (b & RG_OUT) != 0 && (b & ~(RG_OUT | RG_INGOT)) != 0 && rg_report != 0 && rg_in_arena() != 0 {
		err_code_at(pos, "E315 ARENA_ESCAPE", "a slice or map from outside an arena grows inside it (append or insert), so its new memory would be the arena's: grow it after the block, from the block's result")
	}
}

// rg_arena_store notes a store of bits v into a container with bits c: in terms of the running
// function's parameters, for its callers, and as E315 when it takes arena memory outside.
fn rg_arena_store(c i64, v i64, pos i64) {
	let pf = rg_param_fn()
	mut i = 0
	for i < len(pf.params) && i < RG_MAXP && i < 62 {
		if (c & (RG_P0 << i)) != 0 {
			if (v & RG_FRESH) != 0 {
				if cast(i64, rg_fstores) == 0 {
					rg_fstores = []i64{}
				}
				if rg_merge(rg_fstores, cast(i64, pf), 1 << i) != 0 {
					rg_changed = 1
				}
			}
			mut j = 0
			mut from = 0
			for j < len(pf.params) && j < RG_MAXP && j < 62 {
				if (v & (RG_P0 << j)) != 0 {
					from = from | (1 << j)
				}
				j = j + 1
			}
			if from != 0 && rg_pstore_add(i, from) != 0 {
				rg_changed = 1
			}
		}
		i = i + 1
	}
	if (c & (RG_INGOT | RG_UNK)) == 0 && (c & RG_OUT) != 0 && rg_report != 0 && rg_in_arena() != 0 && rg_arena_made(v) != 0 {
		err_code_at(pos, "E315 ARENA_ESCAPE", "memory made in an arena stored into an object from outside it, which outlives the arena: make the value the arena block's result (it is copied out), or keep() it")
	}
}

fn rg_pstore_add(i i64, from i64) i64 {
	let f = cast(i64, rg_param_fn())
	if cast(i64, rg_pstores) == 0 {
		rg_pstores = []i64{}
	}
	mut k = 0
	for k < len(rg_pstores) {
		if cast([]i64, rg_pstores)[k] == f && cast([]i64, rg_pstores)[k + 1] == i {
			let old = cast([]i64, rg_pstores)[k + 2]
			cast([]i64, rg_pstores)[k + 2] = old | from
			return i64((old | from) != old)
		}
		k = k + 3
	}
	mut vs1 = cast([]i64, rg_pstores)
	vs1 = append(vs1, f)
	mut vs2 = cast([]i64, rg_pstores)
	vs2 = append(vs2, i)
	mut vs3 = cast([]i64, rg_pstores)
	vs3 = append(vs3, from)
	return 1
}

fn rg_pstore_get(f i64, i i64) i64 {
	mut k = 0
	for cast(i64, rg_pstores) != 0 && k < len(rg_pstores) {
		if cast([]i64, rg_pstores)[k] == f && cast([]i64, rg_pstores)[k + 1] == i {
			return cast([]i64, rg_pstores)[k + 2]
		}
		k = k + 3
	}
	return 0
}

// rg_arena_call applies what callee f may grow and store into its parameters to the call's
// arguments (bits b): its own fresh memory, or another argument.
fn rg_arena_call(f i64, b []i64, pos i64) {
	mut g = 0
	mut fs = 0
	if cast(i64, rg_grows) != 0 {
		g = rg_lookup(rg_grows, f)
	}
	if cast(i64, rg_fstores) != 0 {
		fs = rg_lookup(rg_fstores, f)
	}
	mut i = 0
	for i < len(b) && i < RG_MAXP && i < 62 {
		if (g & (1 << i)) != 0 {
			rg_grow(b[i], pos)
		}
		mut v = 0
		if (fs & (1 << i)) != 0 {
			v = RG_FRESH | RG_EMB
		}
		let from = rg_pstore_get(f, i)
		mut j = 0
		for from != 0 && j < len(b) && j < 62 {
			if (from & (1 << j)) != 0 {
				v = v | b[j]
			}
			j = j + 1
		}
		if (v & RG_EMB) != 0 {
			rg_arena_store(b[i], v, pos)
		}
		i = i + 1
	}
}

// rg_keeps notes that the function being analyzed, or one it calls, may keep memory past the call
// other than through its parameters and results: in long-lived memory, a task, a deferred call or
// anything the pass cannot see (#633). Loops that call it get no iteration pool.
fn rg_keeps() {
	if rg_sum[13] == 0 {
		rg_sum[13] = 1
		rg_changed = 1
	}
}

// ---- use after hearth.Reset() (#179) ----
// rg_resets notes that the function being analyzed resets the request pool (its callers do
// too), and in rs_walk marks every local that may hold request memory as freed.
fn rg_resets() {
	if rg_sum[12] == 0 {
		rg_sum[12] = 1
		rg_changed = 1
	}
	if rs_active == 0 {
		return
	}
	let locals = cast(Fn, rg_fn).locals
	mut i = 0
	for i < len(locals) {
		let s = locals[i]
		if has_ptr(cast(Ty, s.type_)) != 0 && (rs_bits(cast([]Sym, rs_cur), s) & RG_EMB) != 0 && slice_has(rs_dead, cast(i64, s)) == 0 {
			rs_dead = append(rs_dead, cast(i64, s))
		}
		i = i + 1
	}
}

// rs_bits is what local s may hold on the walk: its latest assignment's bits, else all of them.
fn rs_bits(cur []Sym, s Sym) i64 {
	mut i = 0
	for i < len(cur) {
		if cast(i64, cur[i]) == cast(i64, s) {
			return cast(i64, cur[i + 1])
		}
		i = i + 2
	}
	return s.region
}

fn rs_assign(s i64, bits i64) {
	mut i = 0
	for i < len(rs_cur) {
		if rs_cur[i] == s {
			rs_cur[i + 1] = bits
			slice_drop(rs_dead, s)
			return
		}
		i = i + 2
	}
	rs_cur = append(rs_cur, s)
	rs_cur = append(rs_cur, bits)
	slice_drop(rs_dead, s)
}

// rs_join merges two walk states: a local is freed if it is on either path, and may hold
// what either path assigned.
fn rs_join(dead_a []i64, cur_a []Sym, dead_b []i64, cur_b []Sym) {
	slice_union(dead_a, dead_b)
	mut out = []i64{}
	mut i = 0
	for i < len(cur_a) {
		let s = cur_a[i]
		out = append(out, cast(i64, s))
		out = append(out, cast(i64, cur_a[i + 1]) | rs_bits(cur_b, s))
		i = i + 2
	}
	i = 0
	for i < len(cur_b) {
		let s = cur_b[i]
		if rs_bits(cast([]Sym, out), s) == s.region && rs_has_entry(out, cast(i64, s)) == 0 {
			out = append(out, cast(i64, s))
			out = append(out, cast(i64, cur_b[i + 1]) | s.region)
		}
		i = i + 2
	}
	rs_dead = cast([]i64, dead_a)
	rs_cur = out
}

fn rs_has_entry(cur []i64, s i64) i64 {
	mut i = 0
	for i < len(cur) {
		if cur[i] == s {
			return 1
		}
		i = i + 2
	}
	return 0
}

fn slice_has(v []i64, x i64) i64 {
	mut i = 0
	for i < len(v) {
		if v[i] == x {
			return 1
		}
		i = i + 1
	}
	return 0
}

fn slice_drop(v []i64, x i64) {
	mut i = 0
	for i < len(v) {
		if v[i] == x {
			v[i] = v[len(v) - 1]
			slice_truncate(v, len(v) - 1)
			return
		}
		i = i + 1
	}
}

fn slice_union(a []i64, b []i64) {
	mut i = 0
	for i < len(b) {
		if slice_has(a, b[i]) == 0 {
			a = append(a, b[i])
		}
		i = i + 1
	}
}

// rs_walk follows f's statements in order: after a reset, a local that may hold request
// memory is freed until it is assigned again; reading it then is an error. Loop bodies are
// walked twice so a read before the reset in the next iteration is seen; branches join.
fn rs_walk(f Fn) {
	rs_active = 1
	rs_dead = []i64{}
	rs_said = []i64{}
	rs_cur = []i64{}
	rs_stmts(cast(Block, f.body).stmts)
	rs_active = 0
}

fn rs_stmts(v []i64) {
	mut i = 0
	for i < len(v) {
		rs_stmt(v[i])
		i = i + 1
	}
}

fn rs_stmt(s i64) {
	let k = cast(Node, s).kind
	if k == ST_BLOCK {
		rs_stmts(cast(Block, s).stmts)
	} else if k == ST_LET {
		mut lb = 0
		if cast(LetStmt, s).init != 0 {
			lb = rg_expr(cast(LetStmt, s).init)
		}
		rs_assign(cast(LetStmt, s).sym, lb)
	} else if k == ST_ASSIGN {
		let ab = rg_expr(cast(AssignStmt, s).value)
		let t = cast(AssignStmt, s).target
		if cast(Node, t).kind == EX_IDENT && cast(IdentExpr, t).ref != 0 {
			rs_assign(cast(IdentExpr, t).ref, ab)
		} else {
			rg_expr(t)
		}
	} else if k == ST_EXPR {
		rg_expr(cast(ExprStmt, s).x)
	} else if k == ST_IF {
		rg_expr(cast(IfStmt, s).cond)
		let dead0 = slice_clone(rs_dead)
		let cur0 = slice_clone(rs_cur)
		rs_stmts(cast(Block, cast(IfStmt, s).then).stmts)
		let dead1 = rs_dead
		let cur1 = cast([]i64, rs_cur)
		rs_dead = cast([]i64, dead0)
		rs_cur = cast([]i64, cur0)
		if cast(IfStmt, s).else_ != 0 {
			rs_stmt(cast(IfStmt, s).else_)
		}
		rs_join(rs_dead, cast([]Sym, rs_cur), dead1, cast([]Sym, cur1))
	} else if k == ST_WHILE {
		// Twice, so the next iteration sees what this one freed; then joined with the path
		// that skips the loop.
		let dead0 = slice_clone(rs_dead)
		let cur0 = slice_clone(rs_cur)
		mut pass = 0
		for pass < 2 {
			rg_expr(cast(WhileStmt, s).cond)
			rs_stmts(cast(Block, cast(WhileStmt, s).body).stmts)
			if cast(WhileStmt, s).post != 0 {
				rs_stmt(cast(WhileStmt, s).post)
			}
			pass = pass + 1
		}
		rs_join(rs_dead, cast([]Sym, rs_cur), cast([]i64, dead0), cast([]Sym, cast([]i64, cur0)))
	} else if k == ST_RETURN {
		if cast(ReturnStmt, s).value != 0 {
			rg_expr(cast(ReturnStmt, s).value)
		}
		if cast(i64, cast(ReturnStmt, s).values) != 0 {
			mut i = 0
			for i < len(cast(ReturnStmt, s).values) {
				rg_expr(cast(ReturnStmt, s).values[i])
				i = i + 1
			}
		}
	} else if k == ST_CALLMULTI {
		rg_expr(cast(CallMultiStmt, s).call)
		let syms = cast(CallMultiStmt, s).syms
		mut j = 0
		for j < len(syms) {
			if cast(i64, syms[j]) != 0 {
				rs_assign(cast(i64, syms[j]), syms[j].region)
			}
			j = j + 1
		}
	}
}

fn rg_call(e i64) i64 {
	if cast(Node, e).region == R_OWNED && rg_in_keep == 0 {
		// keep(x): a detached block that reads a capture only in here uses a copy (#232).
		rg_in_keep = 1
		let kb = rg_call(e)
		rg_in_keep = 0
		return kb
	}
	let args = cast(Call, e).args
	let n = len(args)
	mut b = []i64{}
	mut i = 0
	for i < n {
		b = append(b, rg_expr(args[i]))
		i = i + 1
	}
	rg_multi = cast([]i64, 0)
	if cast(Call, e).intrinsic != 0 {
		return 0
	}
	let pos = cast(Node, e).pos
	if cast(Call, e).dyn_shape != 0 {
		rg_keeps()
		return rg_dyn_call(e, cast([]Node, args), cast(i64, b), pos)
	}
	if cast(Call, e).callee != 0 {
		rg_keeps()
		rg_expr(cast(Call, e).callee)
		// The callee is unknown: a mut argument may be modified and may receive request
		// memory, and the call may do what any function used as a value does (rg_fnsum).
		let ct = cast(Ty, cast(Node, cast(Call, e).callee).type_)
		mut mask = 0
		if cast(i64, ct) != 0 && ct.kind == K_FUNC {
			mask = ct.key
		}
		i = 0
		for i < n && i < 63 {
			if (mask & (1 << i)) != 0 {
				let saved = rg_report
				if rg_report != 0 && ((b[i] | rg_pass(cast([]i64, rg_fnsum[10]), i, cast([]Node, args), b, -1, pos)) & (RG_INGOT | RG_UNK)) != 0 {
					let m = err_code(pos, "E312 ARG_ESCAPE")
					buf_str(m, "a call through a function value may store request memory into its mut argument ")
					buf_int(m, i + 1)
					buf_str(m, ", which may be long-lived: call the function directly or pass request-owned memory")
					err_end(cast([]u8, m))
					rg_report = 0
				}
				let a = cast(Node, args[i])
				rg_store(b[i], rg_owner(cast(i64, a)), rg_key(a.type_), RG_EMB, 0, pos, "")
				rg_pass(cast([]i64, rg_fnsum[10]), i, cast([]Node, args), b, RG_EMB, pos)
				rg_pass(cast([]i64, rg_fnsum[11]), i, cast([]Node, args), b, 0, pos)
				if value_has_ref(cast(Ty, a.type_)) != 0 {
					rg_value_arg(cast(i64, a), pos)
				}
				rg_report = saved
			}
			i = i + 1
		}
		rg_import(cast([]i64, rg_fnsum[1]), cast([]i64, args), b)
		if has_ptr(cast(Ty, cast(Node, e).type_)) != 0 {
			return RG_UNK | RG_EMB
		}
		return 0
	}
	let f = cast(Fn, cast(Call, e).fn_)
	mut name = cast(Call, e).name
	if cast(i64, f) != 0 && len(f.qname) != 0 {
		name = f.qname
	}
	if (len(name) != 0 && name == "hearth.Reset") || (cast(i64, f) != 0 && f.regsum != 0 && f.regsum[12] != 0 && file_trusted[f.file] == 0) {
		rg_resets()
	}
	if cast(Node, e).region == R_OWNED || (cast(i64, f) != 0 && is_keep_fn(f) != 0) || (len(name) != 0 && str_prefix(name, "rt_keep") != 0) {
		return RG_INGOT
	}
	if len(name) != 0 && str_prefix(name, "rt_") != 0 {
		if lp_rt_keeps_nothing(name) == 0 && lp_rt_into_first(name) == 0 {
			rg_keeps()
		}
		return rg_runtime_call(e, name, b, pos)
	}
	if cast(i64, f) == 0 || f.regsum == 0 {
		if lp_pure_fn(name) == 0 {
			rg_keeps()
		}
	} else if f.regsum[13] != 0 {
		rg_keeps()
	}
	mut sum = 0
	if cast(i64, f) != 0 {
		sum = f.regsum
	}
	if sum == 0 {
		// A function with no summary (generated: argo's decoders) may write request memory into
		// a value struct it is given as mut (#669).
		i = 0
		for cast(i64, f) != 0 && i < n {
			if cast(i64, f.muts) != 0 && i < len(f.muts) && f.muts[i] != 0 && value_has_ref(cast(Ty, cast(Node, args[i]).type_)) != 0 {
				rg_value_arg(args[i], pos)
			}
			i = i + 1
		}
		if has_ptr(cast(Ty, cast(Node, e).type_)) != 0 {
			return RG_UNK | RG_EMB
		}
		return 0
	}
	i = 0
	for i < n && i < RG_MAXP {
		let mutp = i64(cast(i64, f.muts) != 0 && i < len(f.muts) && f.muts[i] != 0)
		if (sum[0] & (1 << i)) != 0 {
			let saved = rg_report
			if rg_report != 0 && (rg_pass(cast([]i64, sum[10]), i, cast([]Node, args), b, -1, pos) & (RG_INGOT | RG_UNK)) != 0 {
				let m = err_code(pos, "E312 ARG_ESCAPE")
				buf_str(m, name)
				buf_str(m, " stores request memory into its mut parameter '")
				buf_str(m, cast(Sym, cast([]i64, f.locals)[i]).name)
				if file_trusted[f.file] != 0 {
					// The standard library cannot be changed by its caller: the argument must.
					buf_str(m, "', but this argument may be long-lived: pass request memory (a local) instead")
				} else {
					buf_str(m, "', but this argument may be long-lived: keep() the stored values inside ")
					buf_str(m, name)
				}
				err_end(cast([]u8, m))
				rg_report = 0
			}
			rg_pass(cast([]i64, sum[10]), i, cast([]Node, args), b, RG_EMB, pos)
			rg_report = saved
			if value_has_ref(cast(Ty, cast(Node, args[i]).type_)) != 0 {
				// The callee wrote request memory into the bytes of a value struct (#669).
				rg_value_arg(args[i], pos)
			}
		} else if mutp != 0 {
			let a = cast(Node, args[i])
			rg_store(b[i], rg_owner(cast(i64, a)), rg_key(a.type_), 0, 0, pos, "")
		}
		if mutp != 0 {
			rg_pass(cast([]i64, sum[11]), i, cast([]Node, args), b, 0, pos)
		}
		i = i + 1
	}
	rg_arena_call(cast(i64, f), b, pos)
	rg_import(cast([]i64, sum[1]), cast([]i64, args), b)
	mut res = []i64{}
	mut j = 0
	for j < 8 {
		mut rt = 0
		if j < len(f.rtypes) {
			rt = f.rtypes[j]
		}
		res = append(res, rg_subst(sum[2 + j], cast([]Node, args), b, rt))
		j = j + 1
	}
	rg_multi = cast([]i64, res)
	if has_ptr(cast(Ty, cast(Node, e).type_)) == 0 {
		return 0
	}
	return res[0]
}

// A dyn call can target any concrete method table for its shape. Join the region
// summaries of those methods using each table's concrete receiver type.
fn rg_dyn_call(e i64, args []Node, b i64, pos i64) i64 {
	let shape_ = cast(Call, e).dyn_shape
	let index = cast(Call, e).dyn_index - 1
	let saved_fn = cast(Call, e).fn_
	let saved_callee = cast(Call, e).callee
	let saved_shape = cast(Call, e).dyn_shape
	let saved_index = cast(Call, e).dyn_index
	let saved_type = args[0].type_
	mut joined = []i64{}
	mut j = 0
	for j < 8 {
		joined = append(joined, 0)
		j = j + 1
	}
	mut result = 0
	mut found = 0
	mut i = 0
	for i < len(dyn_tables) {
		let rec = cast(DynTable, dyn_tables[i])
		let methods = rec.fns
		if rec.dyn_ == shape_ && index >= 0 && index < len(methods) {
			let f = methods[index]
			if f != 0 {
				found = 1
				cast(Call, e).fn_ = f
				cast(Call, e).callee = 0
				cast(Call, e).dyn_shape = 0
				cast(Call, e).dyn_index = 0
				args[0].type_ = rec.ty
				result = result | rg_call(e)
				mut ri = 0
				for ri < 8 {
					cast([]i64, joined)[ri] = joined[ri] | rg_multi[ri]
					ri = ri + 1
				}
			}
		}
		i = i + 1
	}
	cast(Call, e).fn_ = saved_fn
	cast(Call, e).callee = saved_callee
	cast(Call, e).dyn_shape = saved_shape
	cast(Call, e).dyn_index = saved_index
	args[0].type_ = saved_type
	// A mut shape method modifies its receiver whichever type is behind it (#644), as a call
	// of a method with a mut receiver does (rg_call).
	let info = cast(Pair, dyn_shape_method(cast(Ty, shape_), cast(Call, e).name))
	if cast(i64, info) != 0 && cast(ShapeSig, info.b).recvmut != 0 {
		rg_store(cast([]i64, b)[0], rg_owner(cast(i64, args[0])), rg_key(args[0].type_), 0, 0, pos, "")
	}
	if found == 0 {
		if has_ptr(cast(Ty, cast(Node, e).type_)) != 0 {
			return RG_UNK | RG_EMB
		}
		return 0
	}
	rg_multi = cast([]i64, joined)
	return result
}

// rg_pass applies a callee's records (rg_record) for argument i: each names an object
// inside the argument, whose bits (rg_deep) are joined into the result, and v (unless -1)
// is stored into each.
fn rg_pass(recs []i64, i i64, args []Node, b []i64, v i64, pos i64) i64 {
	mut all = 0
	mut j = 0
	for j < len(recs) {
		if recs[j] == i {
			let o = recs[j + 1]
			let t = recs[j + 2]
			let c = rg_deep(b[i], args[i].type_, o, t)
			all = all | c
			if v != -1 {
				rg_store(c, o, t, v, 0, pos, "")
			}
		}
		j = j + 3
	}
	return all
}

// rg_import adds a callee's held triples to the caller's, in terms of the call's arguments.
fn rg_import(h []i64, args []i64, b []i64) {
	mut i = 0
	for i < len(h) {
		let t = h[i + 1]
		rg_hold_in(h[i], t, rg_subst(h[i + 2], cast([]Node, args), b, t))
		i = i + 3
	}
}

// rg_subst replaces a summary's parameter bits with the bits of the call's arguments (b),
// for a value of type t: a parameter's bits stand for everything reachable from it, so
// they also take what the argument's containers hold on the way to a t (rg_deep).
fn rg_subst(r i64, args []Node, b []i64, t i64) i64 {
	let v = rg_key(t)
	mut out = r & 0xff
	mut i = 0
	for i < len(b) && i < RG_MAXP {
		if (r & (RG_P0 << i)) != 0 {
			mut x = b[i]
			if v != 0 || t == 0 {
				x = rg_deep(x, args[i].type_, 0, v)
			}
			out = out | x
		}
		i = i + 1
	}
	return out
}

fn rg_runtime_call(e i64, name str, b []i64, pos i64) i64 {
	let n = len(b)
	mut b0 = 0
	if n > 0 {
		b0 = b[0]
	}
	// Stores go into the object of argument 0.
	let args = cast(Call, e).args
	mut co = 0
	mut ct = 0
	if n > 0 {
		co = rg_owner(args[0])
		ct = rg_key(cast(Node, args[0]).type_)
	}
	if n > 0 && rg_grows_op(name) != 0 {
		rg_grow(b0, pos)
	}
	if name == "rt_map_set" {
		rg_store(b0, co, ct, b[1], cast(Node, args[1]).type_, pos, "")
		rg_store(b0, co, ct, b[2], cast(Node, args[2]).type_, pos, "")
		return 0
	}
	if name == "rt_map_setk" {
		// The encoded key is copied into the map's region; only the value is stored.
		rg_store(b0, co, ct, b[2], cast(Node, args[2]).type_, pos, "")
		return 0
	}
	if name == "rt_map_set_vcell" {
		// A value struct's bytes into the map's cell (#669); an encoded key is copied.
		let ck = cast(Node, args[6]).kind == EX_INT && cast(IntLit, args[6]).val != 0
		if !ck {
			rg_store(b0, co, ct, b[1], cast(Node, args[1]).type_, pos, "")
		}
		rg_store(b0, co, ct, b[2], cast(Ty, cast(Node, args[0]).type_).elem, pos, "")
		return 0
	}
	if name == "rt_map_set_dyn" {
		// A dyn value (#567): argument 2 is its object word; an encoded key (argument 4
		// set) is copied, as by rt_map_setk.
		let ck = cast(Node, args[4]).kind == EX_INT && cast(IntLit, args[4]).val != 0
		if !ck {
			rg_store(b0, co, ct, b[1], cast(Node, args[1]).type_, pos, "")
		}
		rg_store(b0, co, ct, b[2], cast(Ty, cast(Node, args[0]).type_).elem, pos, "")
		return 0
	}
	if name == "rt_append" || name == "rt_append_rc" || name == "rt_append_mem" || name == "rt_append_mem_rc" {
		// A value struct's bytes are copied in: what its fields hold is stored (#631, #669).
		rg_store(b0, co, ct, b[1], cast(Node, args[1]).type_, pos, "")
		return b0
	}
	if name == "rt_append_dyn" {
		mut et = cast(Ty, cast(Node, args[0]).type_).elem
		rg_store(b0, co, ct, b[1], et, pos, "")
		return b0
	}
	if name == "rt_slice_appendn" || name == "rt_slice_copy" || name == "rt_slice_appendn_rc" || name == "rt_slice_copy_rc" || name == "rt_slice_appendn_dyn" || name == "rt_slice_copy_dyn" || name == "rt_slice_appendn_vrc" || name == "rt_slice_copy_vrc" {
		mut et = 0
		let a1 = cast(Node, args[1])
		if kind_of(cast(Ty, a1.type_)) == K_SLICE {
			et = cast(Ty, a1.type_).elem
		}
		if has_ptr(cast(Ty, et)) != 0 {
			rg_store(b0, co, ct, rg_load_in(b[1], et, rg_key(a1.type_)), et, pos, "")
		} else {
			rg_store(b0, co, ct, 0, 0, pos, "")
		}
		return b0
	}
	if name == "rt_append_str" || name == "rt_copy_str" || name == "rt_map_del" {
		rg_store(b0, co, ct, 0, 0, pos, "")
		return b0
	}
	if name == "rt_map_get" || name == "rt_map_key" || name == "rt_map_val" {
		if has_ptr(cast(Ty, cast(Node, e).type_)) != 0 {
			return rg_load_in(b0, cast(Node, e).type_, ct)
		}
		return 0
	}
	if name == "rt_map_vget" {
		// The value struct in a map's cell, or the zero given (#669).
		return rg_load_in(b0, cast(Node, e).type_, ct) | b[2]
	}
	if name == "rt_map_get_dyn" || name == "rt_map_val_dyn" {
		// The dyn value in a map's cell (#567).
		return rg_load_in(b0, cast(Node, e).type_, ct)
	}
	if name == "rt_slice_sub" {
		return b0 | RG_FRESH | RG_EMB
	}
	if has_ptr(cast(Ty, cast(Node, e).type_)) != 0 {
		return RG_FRESH | RG_EMB
	}
	return 0
}

fn str_prefix(s str, p str) i64 {
	return i64(len(s) >= len(p) && s[:len(p)] == p)
}

// ---- the body of a with policy (#237, design/interface_policy.md §3) ----
//
// A with block's closure lives on its caller's frame, so the Run of its policy may only call
// body, or pass it to a parameter that obeys the same rule (checked here, recursively). Any
// other use in Run is reported there; a function Run passes body to is only judged.
shared mut wb_memo []i64 // [function, parameter, state]: 1 checking or fine, 2 may keep it
shared mut wb_fn i64 // the function being walked
shared mut wb_sym i64 // its parameter
shared mut wb_bad i64 // the parameter may be kept
shared mut wb_say i64 // report each bad use (the Run of a with), or only judge

fn with_body_check() {
	if cast(i64, with_runs) == 0 {
		return
	}
	wb_memo = []i64{}
	mut i = 0
	for i < len(with_runs) {
		wb_param_ok(cast(Fn, cast([]i64, with_runs)[i]), 1, 1)
		i = i + 2
	}
}

// wb_param_ok reports whether parameter i of f is only called or passed on to such parameters.
fn wb_param_ok(f Fn, i i64, say i64) i64 {
	mut j = 0
	for j < len(wb_memo) {
		if cast(i64, wb_memo[j]) == cast(i64, f) && cast(i64, wb_memo[j + 1]) == i {
			return i64(cast(i64, wb_memo[j + 2]) == 1)
		}
		j = j + 3
	}
	if cast(i64, f) == 0 || f.extern_ != 0 || f.body == 0 || cast(i64, f.locals) == 0 || i >= len(f.params) {
		return 0
	}
	wb_memo = append(wb_memo, cast(i64, f))
	wb_memo = append(wb_memo, i)
	let at = len(wb_memo)
	wb_memo = append(wb_memo, 1)
	let saved_fn = wb_fn
	let saved_sym = wb_sym
	let saved_bad = wb_bad
	let saved_say = wb_say
	wb_fn = cast(i64, f)
	wb_sym = cast([]i64, f.locals)[i]
	wb_bad = 0
	wb_say = say
	wb_stmts(cast(Block, f.body).stmts)
	let ok = i64(wb_bad == 0)
	if ok == 0 {
		wb_memo[at] = 2
	}
	wb_fn = saved_fn
	wb_sym = saved_sym
	wb_bad = saved_bad
	wb_say = saved_say
	return ok
}

// wb_keeps notes a use of the parameter other than a call; via names the function it was
// passed to, or is 0.
fn wb_keeps(pos i64, via i64) {
	if wb_say != 0 && wb_bad == 0 {
		let m = err_code(pos, "E653 POLICY_BODY")
		buf_str(m, cast(Fn, wb_fn).qname)
		if via != 0 {
			buf_str(m, " passes the body of a with block to ")
			buf_str(m, cast(Fn, via).qname)
			buf_str(m, ", which may keep it")
		} else {
			buf_str(m, " keeps the body of a with block")
		}
		buf_str(m, ": a policy may only call body, or pass it to a function that only calls it (the block's variables live on the caller's frame)")
		err_end(cast([]u8, m))
	}
	wb_bad = 1
}

fn wb_stmts(v []i64) {
	mut i = 0
	for i < len(v) {
		wb_stmt(v[i])
		i = i + 1
	}
}

fn wb_stmt(s i64) {
	let k = cast(Node, s).kind
	if k == ST_BLOCK {
		wb_stmts(cast(Block, s).stmts)
	} else if k == ST_LET {
		wb_expr(cast(LetStmt, s).init)
	} else if k == ST_ASSIGN {
		if cast(Node, cast(AssignStmt, s).target).kind != EX_IDENT {
			wb_expr(cast(AssignStmt, s).target)
		}
		wb_expr(cast(AssignStmt, s).value)
	} else if k == ST_EXPR {
		wb_expr(cast(ExprStmt, s).x)
	} else if k == ST_IF {
		wb_expr(cast(IfStmt, s).cond)
		wb_stmts(cast(Block, cast(IfStmt, s).then).stmts)
		if cast(IfStmt, s).else_ != 0 {
			wb_stmt(cast(IfStmt, s).else_)
		}
	} else if k == ST_WHILE {
		wb_expr(cast(WhileStmt, s).cond)
		wb_stmts(cast(Block, cast(WhileStmt, s).body).stmts)
		if cast(WhileStmt, s).post != 0 {
			wb_stmt(cast(WhileStmt, s).post)
		}
	} else if k == ST_RETURN {
		wb_expr(cast(ReturnStmt, s).value)
		if cast(i64, cast(ReturnStmt, s).values) != 0 {
			wb_exprs(cast(ReturnStmt, s).values)
		}
	} else if k == ST_CALLMULTI {
		wb_expr(cast(CallMultiStmt, s).call)
	}
}

fn wb_exprs(v []i64) {
	mut i = 0
	for i < len(v) {
		wb_expr(v[i])
		i = i + 1
	}
}

fn wb_is_param(e i64) i64 {
	return i64(e != 0 && cast(Node, e).kind == EX_IDENT && cast(IdentExpr, e).ref == wb_sym)
}

fn wb_expr(e i64) {
	if e == 0 {
		return
	}
	let k = cast(Node, e).kind
	if k == EX_IDENT {
		if cast(IdentExpr, e).ref == wb_sym {
			wb_keeps(cast(Node, e).pos, 0)
		}
	} else if k == EX_UNARY {
		wb_expr(cast(Unary, e).x)
	} else if k == EX_BINARY {
		wb_expr(cast(Binary, e).l)
		wb_expr(cast(Binary, e).r)
	} else if k == EX_CONV {
		wb_expr(cast(Conv, e).x)
	} else if k == EX_MEM {
		wb_expr(cast(MemExpr, e).base)
		wb_expr(cast(MemExpr, e).index)
		wb_expr(cast(MemExpr, e).len)
	} else if k == EX_ELEM {
		wb_expr(cast(ElemExpr, e).seq)
		wb_expr(cast(ElemExpr, e).idx)
	} else if k == EX_SEQ {
		wb_stmts(cast(SeqExpr, e).stmts)
		wb_expr(cast(SeqExpr, e).value)
	} else if k == EX_INDEX {
		wb_expr(cast(IndexExpr, e).x)
		wb_expr(cast(IndexExpr, e).i)
	} else if k == EX_CALL {
		let callee = cast(Call, e).callee
		if wb_is_param(callee) == 0 {
			wb_expr(callee)
		}
		let args = cast(Call, e).args
		mut i = 0
		for i < len(args) {
			let a = cast(Node, args[i])
			if wb_is_param(cast(i64, a)) != 0 {
				let g = cast(Fn, cast(Call, e).fn_)
				if cast(i64, g) == 0 || callee != 0 || cast(Call, e).intrinsic != 0 {
					wb_keeps(a.pos, 0)
				} else if wb_param_ok(g, i, 0) == 0 && file_trusted[g.file] != 0 && i64(byte_at(file_pkgs[g.file], 0)) == 0 {
					// A runtime helper (append, a store): the use itself keeps it.
					wb_keeps(a.pos, 0)
				} else if wb_param_ok(g, i, 0) == 0 {
					wb_keeps(a.pos, cast(i64, g))
				}
			} else {
				wb_expr(cast(i64, a))
			}
			i = i + 1
		}
	}
}

// ---- long-lived stores: the counts around them (#176, design/interface_mem.md) ----
//
// rc_mark runs after region_check, when the bits on every local are final. It wraps each
// store whose destination is provably long-lived: an assignment to a global, and field
// or element stores whose base ident is a global or a local left at exactly RG_INGOT
// (one that can hold nothing else). The store keeps the value it had: the new value's
// count arrives and the old slot's count leaves, both before the store itself (the value
// is bound to a temporary first, so it is evaluated once).
//
// A store whose destination may be long-lived but is not provably so (through a
// parameter, a closure's cells, an element of an element) cannot be counted: the old
// slot may never have had a count. Its value is pinned instead (rt_rc_pinned), so the
// uncounted reference can leak the block but never outlive it. A store into a container
// the region pass proved request-local needs neither.
//
// Map entries and append elements count themselves in the runtime (rt_map_set,
// rt_append_rc, rt_slice_appendn_rc, rt_slice_copy_rc), which decide by the container's
// own region word and need no marking here. keep$N counts the fields, elements and
// entries of its copy itself, so lifted functions are left alone. __core_init is not
// visited: what a core makes while it initializes starts pinned (rt_ingot_alloc).
shared mut rc_fn i64
shared mut rc_reach_ok i64 // 1 once reachability is final: rc_*_call may mark what they add

fn rc_mark() {
	rc_reach_ok = 1
	let saved_fn = ck_fn
	let saved_marks = sc_marks
	let saved_syms = sc_syms
	let saved_cells = ck_escaping_cells
	// declare_local reads the current scope; give the wrapped temporaries one of their own.
	sc_marks = []i64{}
	sc_marks = append(sc_marks, 0)
	sc_syms = cast([]Sym, []i64{})
	ck_escaping_cells = []str{}
	mut i = 0
	for i < len(prog_fns) {
		let f = prog_fns[i]
		if f.regsum != 0 && f.reach != 0 && f.lifted != 2 {
			rc_fn = cast(i64, f)
			ck_fn = cast(Fn, f)
			rc_stmts(cast(Block, f.body).stmts)
		}
		i = i + 1
	}
	ck_fn = saved_fn
	sc_marks = saved_marks
	sc_syms = saved_syms
	ck_escaping_cells = saved_cells
}

fn rc_stmts(v []i64) {
	mut i = 0
	for i < len(v) {
		let s = v[i]
		if s != 0 && cast(Node, s).kind == ST_ASSIGN {
			// The wrap leaves the store itself in place; skip it, the temporaries around
			// it carry the value expression (a composite literal's stores) instead.
			i = i + rc_assign(s, cast([]i64, v), i) + 1
		} else if s != 0 && cast(Node, s).kind == ST_CALLMULTI {
			rc_seq(cast(CallMultiStmt, s).call)
			i = i + rc_callmulti(s, cast([]i64, v), i) + 1
		} else {
			rc_walk(s)
			i = i + 1
		}
	}
}

// rc_walk reaches the stores nested in a statement (a composite literal carries them
// inside an EX_SEQ).
fn rc_walk(s i64) {
	if s == 0 {
		return
	}
	let k = cast(Node, s).kind
	if k == ST_BLOCK {
		rc_stmts(cast(Block, s).stmts)
	} else if k == ST_LIST {
		rc_stmts(cast(ListStmt, s).stmts)
	} else if k == ST_LET {
		rc_seq(cast(LetStmt, s).init)
	} else if k == ST_EXPR {
		rc_seq(cast(ExprStmt, s).x)
	} else if k == ST_IF {
		rc_stmts(cast(Block, cast(IfStmt, s).then).stmts)
		if cast(IfStmt, s).else_ != 0 {
			rc_walk(cast(IfStmt, s).else_)
		}
	} else if k == ST_WHILE {
		rc_stmts(cast(Block, cast(WhileStmt, s).body).stmts)
		if cast(WhileStmt, s).post != 0 {
			rc_walk(cast(WhileStmt, s).post)
		}
	} else if k == ST_RETURN {
		if cast(ReturnStmt, s).value != 0 {
			rc_seq(cast(ReturnStmt, s).value)
		}
	}
}

fn rc_seq(e i64) {
	if e != 0 && cast(Node, e).kind == EX_SEQ {
		rc_stmts(cast(SeqExpr, e).stmts)
		rc_seq(cast(SeqExpr, e).value)
	}
}

// rc_assign counts or pins the assignment at position i of stmts, by what its
// destination can be. It reports how many statements it spliced in before it.
fn rc_assign(s i64, stmts []i64, i i64) i64 {
	let target = cast(AssignStmt, s).target
	let val = cast(AssignStmt, s).value
	if target == 0 || val == 0 {
		return 0
	}
	let pos = cast(Node, s).pos
	let t = cast(Node, target).type_
	if rc_counted(cast(Ty, t)) == 0 || file_trusted[cast(Fn, rc_fn).file] == 2 {
		rc_seq(val)
		return 0
	}
	let k = cast(Node, target).kind
	if (k == EX_MEM || k == EX_ELEM) && rc_value_inner(target) != 0 {
		// A field or element inside a value struct (#669): the slot is the container that holds
		// the value. Its indexes are bound to temporaries so the old value is read from the
		// very same place.
		mut pre0 = []i64{}
		let root = rc_value_root(pos, target, pre0)
		if root != 0 && is_value_struct(cast(Ty, cast(Node, root).type_)) != 0 && (cast(Node, root).kind != EX_IDENT || cast(IdentExpr, root).ref == 0 || cast(Sym, cast(IdentExpr, root).ref).kind != SYM_GLOBAL) {
			// The bytes of a local or parameter: a frame, not a long-lived slot.
			rc_seq(val)
			rc_splice(stmts, i, cast([]i64, pre0))
			return len(cast([]i64, pre0))
		}
		if root != 0 && rc_ingot_base(root) != 0 {
			return rc_wrap(s, stmts, i, rc_chain_read(pos, target), t, cast([]i64, pre0))
		}
		if root != 0 && rc_local_base(root) == 0 && is_value_struct(cast(Ty, t)) == 0 {
			rc_pin_value(s, t)
		}
		rc_seq(val)
		rc_splice(stmts, i, cast([]i64, pre0))
		return len(cast([]i64, pre0))
	}
	if k == EX_IDENT {
		if cast(IdentExpr, target).ref != 0 && cast(Sym, cast(IdentExpr, target).ref).kind == SYM_GLOBAL {
			// xs = append(xs, v): the append counts its own element and returns the same
			// header, so the slot's count is already right.
			if rc_append_into(val, cast(IdentExpr, target)) != 0 {
				return 0
			}
			return rc_wrap(s, stmts, i, sym_ref_node(pos, cast(Sym, cast(IdentExpr, target).ref)), t, cast([]i64, 0))
		}
		// A local: the variable itself is not long-lived storage.
		rc_seq(val)
		return 0
	}
	if k == EX_MEM {
		let base = cast(MemExpr, target).base
		if cast(MemExpr, target).index == 0 && rc_ingot_base(base) != 0 {
			return rc_wrap(s, stmts, i, rc_field_read(pos, cast(MemExpr, target), t), t, cast([]i64, 0))
		}
		if rc_local_base(base) == 0 {
			rc_pin_value(s, t)
		}
		rc_seq(val)
		return 0
	}
	if k == EX_ELEM {
		// s[i] = v, already lowered to a bounds-checked element. The index is bound to a
		// temporary so the old value is read back from the very same index.
		let seq = cast(ElemExpr, target).seq
		if rc_ingot_base(seq) != 0 {
			mut pre0 = []i64{}
			let idx = temp(pos, cast(ElemExpr, target).idx, ty_int)
			pre0 = append(pre0, cast(i64, idx))
			cast(ElemExpr, target).idx = sym_ref_node(pos, cast(Sym, idx.sym))
			return rc_wrap(s, stmts, i, rc_elem_read(pos, cast(ElemExpr, target), t), t, cast([]i64, pre0))
		}
		if rc_local_base(seq) == 0 {
			rc_pin_value(s, t)
		}
		rc_seq(val)
		return 0
	}
	rc_seq(val)
	return 0
}

// rc_value_inner reports a store target whose base is a value struct (#669).
fn rc_value_inner(t i64) i64 {
	if cast(Node, t).kind == EX_MEM {
		return is_value_struct(cast(Ty, cast(Node, cast(MemExpr, t).base).type_))
	}
	return is_value_struct(cast(Ty, cast(Node, cast(ElemExpr, t).seq).type_))
}

// rc_value_root walks target's value struct bases up to the container that holds the value (a
// slice or object, or a variable), binding each index on the way to a temporary (added to pre).
fn rc_value_root(pos i64, target i64, pre []i64) i64 {
	mut x = target
	for {
		let k = cast(Node, x).kind
		mut b = 0
		if k == EX_MEM {
			if cast(MemExpr, x).index != 0 {
				let it = temp(pos, cast(MemExpr, x).index, ty_int)
				pre = append(pre, cast(i64, it))
				cast(MemExpr, x).index = sym_ref_node(pos, cast(Sym, it.sym))
			}
			b = cast(MemExpr, x).base
		} else if k == EX_ELEM {
			let it = temp(pos, cast(ElemExpr, x).idx, ty_int)
			pre = append(pre, cast(i64, it))
			cast(ElemExpr, x).idx = sym_ref_node(pos, cast(Sym, it.sym))
			b = cast(ElemExpr, x).seq
		} else {
			return x
		}
		if is_value_struct(cast(Ty, cast(Node, b).type_)) == 0 {
			return b
		}
		x = b
	}
	return 0
}

// rc_chain_read is a second read of target, a field or element inside a value struct whose
// indexes rc_value_root bound: the nodes along the value struct bases are copied.
fn rc_chain_read(pos i64, x i64) i64 {
	let k = cast(Node, x).kind
	if k != EX_MEM && k != EX_ELEM {
		return x
	}
	let n = node_new(k, pos)
	replace_node(n, x)
	if k == EX_MEM && is_value_struct(cast(Ty, cast(Node, cast(MemExpr, x).base).type_)) != 0 {
		cast(MemExpr, n).base = rc_chain_read(pos, cast(MemExpr, x).base)
	} else if k == EX_ELEM && is_value_struct(cast(Ty, cast(Node, cast(ElemExpr, x).seq).type_)) != 0 {
		cast(ElemExpr, n).seq = rc_chain_read(pos, cast(ElemExpr, x).seq)
	}
	return n
}

// rc_wrap binds the stored value, reads the old one, counts the new value, drops the old
// one's count (in that order: a value stored over itself is never queued) and leaves the
// store itself last. pre0 (0: none) holds statements the caller prepared (an index
// temporary). It reports how many statements it spliced in.
fn rc_wrap(s i64, stmts []i64, i i64, oldRead i64, t i64, pre0 []i64) i64 {
	let pos = cast(Node, s).pos
	let val = cast(AssignStmt, s).value
	mut pre = []i64{}
	if cast(i64, pre0) != 0 {
		mut p = 0
		for p < len(pre0) {
			pre = append(pre, pre0[p])
			p = p + 1
		}
	}
	let v = temp(pos, val, t)
	pre = append(pre, cast(i64, v))
	// The store reads the temporary now, so the value expression is evaluated once.
	cast(AssignStmt, s).value = sym_ref_node(pos, cast(Sym, v.sym))
	let old = temp(pos, oldRead, t)
	pre = append(pre, cast(i64, old))
	pre = append(pre, expr_stmt(rc_inc_call(pos, sym_ref_node(pos, cast(Sym, v.sym)))))
	pre = append(pre, expr_stmt(rc_dec_call(pos, sym_ref_node(pos, cast(Sym, old.sym)), drop_fn(t))))
	rc_splice(stmts, i, cast([]i64, pre))
	// A composite literal's own stores travel inside the bound value.
	rc_stmts(cast([]i64, pre))
	return len(cast([]i64, pre))
}

// rc_pin_value pins the value assignment s stores, in place: rt_rc_pinned returns its
// argument, so the evaluation order of the store does not change.
fn rc_pin_value(s i64, t i64) {
	if is_dyn_value(cast(Ty, t)) != 0 {
		// A dyn value pins its object (#618); the value itself is two words.
		let pos = cast(Node, s).pos
		let held = temp(pos, cast(AssignStmt, s).value, t)
		let pin = cast(Call, rt_call(pos, "rt_rc_pin", args1(mk_conv(pos, sym_ref_node(pos, cast(Sym, held.sym)), CV_DYN_OBJECT, ty_int)), ty_void))
		mark_reach(cast(Fn, pin.fn_))
		mut stmts = []i64{}
		stmts = append(stmts, cast(i64, held))
		stmts = append(stmts, expr_stmt(cast(Node, pin)))
		cast(AssignStmt, s).value = mk_seq(pos, cast(i64, stmts), sym_ref_node(pos, cast(Sym, held.sym)), t)
		return
	}
	let c = cast(Call, rt_call(cast(Node, s).pos, "rt_rc_pinned", args1(cast(AssignStmt, s).value), t))
	mark_reach(cast(Fn, c.fn_))
	cast(AssignStmt, s).value = cast(i64, c)
}

// rc_callmulti counts the globals a multiple assignment (a, g = f()) stores: each old
// value is read before the call and loses its count after it, once the new one has
// gained its own. It reports how many statements it spliced in around the call.
fn rc_callmulti(s i64, stmts []i64, i i64) i64 {
	let pos = cast(Node, s).pos
	let syms = cast(CallMultiStmt, s).syms
	mut pre = []i64{}
	mut post = []i64{}
	mut j = 0
	for j < len(syms) {
		let g = syms[j]
		if cast(i64, g) != 0 && g.kind == SYM_GLOBAL && rc_counted(cast(Ty, g.type_)) != 0 {
			let old = temp(pos, sym_ref_node(pos, g), g.type_)
			pre = append(pre, cast(i64, old))
			post = append(post, expr_stmt(rc_inc_call(pos, sym_ref_node(pos, g))))
			post = append(post, expr_stmt(rc_dec_call(pos, sym_ref_node(pos, cast(Sym, old.sym)), drop_fn(g.type_))))
		}
		j = j + 1
	}
	rc_splice(stmts, i + 1, cast([]i64, post))
	rc_splice(stmts, i, cast([]i64, pre))
	return len(cast([]i64, pre)) + len(cast([]i64, post))
}

// rc_splice puts pre before position i, moving the statements from i up.
fn rc_splice(stmts []i64, i i64, pre []i64) {
	let n = len(stmts)
	let k = len(pre)
	if k == 0 {
		return
	}
	mut m = 0
	for m < k {
		stmts = append(stmts, 0)
		m = m + 1
	}
	mut j = n - 1
	for j >= i {
		stmts[j + k] = stmts[j]
		j = j - 1
	}
	m = 0
	for m < k {
		stmts[i + m] = pre[m]
		m = m + 1
	}
}

// rc_ingot_base reports whether the ident e names a container that can hold nothing but
// long-lived values: a global, or a local the region pass left at exactly RG_INGOT.
fn rc_ingot_base(e i64) i64 {
	if cast(Node, e).kind != EX_IDENT || cast(IdentExpr, e).ref == 0 {
		return 0
	}
	let s = cast(Sym, cast(IdentExpr, e).ref)
	if s.kind == SYM_GLOBAL {
		return 1
	}
	if cast(i64, s) == cast(Fn, rc_fn).env_sym {
		return 0
	}
	return i64(s.region == RG_INGOT)
}

// rc_local_base reports whether the ident e names a container the region pass proved
// request-local: a local whose objects are all fresh from the pool.
fn rc_local_base(e i64) i64 {
	if cast(Node, e).kind != EX_IDENT || cast(IdentExpr, e).ref == 0 {
		return 0
	}
	let s = cast(Sym, cast(IdentExpr, e).ref)
	if s.kind == SYM_GLOBAL || cast(i64, s) == cast(Fn, rc_fn).env_sym {
		return 0
	}
	return i64(s.region != 0 && (s.region & ~(RG_FRESH | RG_EMB)) == 0)
}

// rc_field_read reads the field the store writes (the base is a named ident).
fn rc_field_read(pos i64, target MemExpr, t i64) i64 {
	let base = cast(IdentExpr, target.base)
	return mk_mem(pos, sym_ref_node(pos, cast(Sym, base.ref)), 0, 0, target.off, t)
}

// rc_elem_read reads the element the store writes; the slice and the index are names, so
// naming them twice costs nothing.
fn rc_elem_read(pos i64, target ElemExpr, t i64) i64 {
	let seq = cast(IdentExpr, target.seq)
	let n = node_new(EX_ELEM, pos)
	cast(ElemExpr, n).seq = sym_ref_node(pos, cast(Sym, seq.ref))
	cast(ElemExpr, n).idx = sym_ref_node(pos, cast(Sym, cast(IdentExpr, target.idx).ref))
	cast(ElemExpr, n).size = target.size
	cast(ElemExpr, n).str = target.str
	cast(Node, n).type_ = t
	return n
}

// rc_append_into reports whether xs = append(xs, v) grows the very global being assigned:
// rt_append_rc counted its element and returned the same header, so nothing else moves.
fn rc_append_into(v i64, target IdentExpr) i64 {
	if cast(Node, v).kind != EX_CALL || len(cast(Call, v).name) == 0 || (cast(Call, v).name != "rt_append_rc" && cast(Call, v).name != "rt_append_mem_rc") {
		return 0
	}
	let a0 = cast(Call, v).args[0]
	return i64(cast(Node, a0).kind == EX_IDENT && cast(IdentExpr, a0).ref == target.ref)
}

// ---- globals set on core 0 only (#343) ----
//
// Globals are per core and main runs on core 0, so a global that main (or a function main calls)
// assigns holds the new value on core 0 alone: the handlers of the other cores read their own
// copy, still the initializer's. In a program that starts cores (anvil.Serve, hearth.Run) that is
// an error. A global that only main's own code reads is fine: nothing else looks at it.
//
// cg_seen are the user functions main reaches by direct calls (a function used as a value, such
// as a handler, is not among them: it may run on any core). cg_stores are the [global, position]
// stores they make, cg_refs the per-core globals every other reachable function names.
shared mut cg_seen []i64
shared mut cg_stores []i64
shared mut cg_refs []i64
shared mut cg_in_main i64 // 1 while walking main's tree (record stores, follow calls), 0 while collecting names

fn core_global_check() {
	let run = find_fn("hearth.Run")
	let m = find_fn("main")
	if cast(i64, run) == 0 || cast(Fn, run).reach == 0 || cast(i64, m) == 0 || cast(Fn, m).body == 0 {
		return
	}
	cg_seen = []i64{}
	cg_stores = []i64{}
	cg_refs = []i64{}
	cg_in_main = 1
	cg_visit(cast(i64, m))
	if len(cg_stores) == 0 {
		return
	}
	cg_in_main = 0
	mut i = 0
	for i < len(prog_fns) {
		let f = prog_fns[i]
		if cast(Fn, f).reach != 0 && cast(Fn, f).extern_ == 0 && cast(Fn, f).body != 0 && cast(Fn, f).generated == 0 && slice_has(cg_seen, cast(i64, f)) == 0 {
			cg_stmts(cast(Block, cast(Fn, f).body).stmts)
		}
		i = i + 1
	}
	i = 0
	for i < len(cg_stores) {
		let g = cg_stores[i]
		if slice_has(cg_refs, g) != 0 {
			err_code_quoted(cg_stores[i + 1], "E131 CORE_GLOBAL", "global ", cast(Sym, g).name, " is assigned here, in code that runs on core 0 only (main and what it calls): the other cores keep the initializer's value. Assign it in its initializer, in `on core.start` or in `once`")
		}
		i = i + 2
	}
}

// cg_visit walks f (main, or a user function reached from it) once. Library functions are
// trusted code: their own per-core state is theirs to manage, so they are not entered.
fn cg_visit(f i64) {
	if f == 0 || cast(Fn, f).extern_ != 0 || cast(Fn, f).body == 0 || cast(Fn, f).generated != 0 || slice_has(cg_seen, f) != 0 || file_trusted[cast(Fn, f).file] != 0 {
		return
	}
	cg_seen = append(cg_seen, f)
	cg_stmts(cast(Block, cast(Fn, f).body).stmts)
}

// cg_root is the per-core global a store into e lands in (the ident itself, or the base of a
// field, element or index chain), or 0.
fn cg_root(e i64) i64 {
	for e != 0 {
		let k = cast(Node, e).kind
		if k == EX_IDENT {
			let s = cast(IdentExpr, e).ref
			if s != 0 && cast(Sym, s).kind == SYM_GLOBAL && cast(Sym, s).tls != 0 {
				return s
			}
			return 0
		}
		if k == EX_MEM {
			e = cast(MemExpr, e).base
		} else if k == EX_ELEM {
			e = cast(ElemExpr, e).seq
		} else if k == EX_INDEX {
			e = cast(IndexExpr, e).x
		} else if k == EX_CONV {
			e = cast(Conv, e).x
		} else {
			return 0
		}
	}
	return 0
}

fn cg_store(target i64, pos i64) {
	let g = cg_root(target)
	if g != 0 {
		cg_stores = append(cg_stores, g)
		cg_stores = append(cg_stores, pos)
	}
}

fn cg_stmts(v []i64) {
	mut i = 0
	for i < len(v) {
		cg_stmt(v[i])
		i = i + 1
	}
}

fn cg_stmt(s i64) {
	if s == 0 {
		return
	}
	let k = cast(Node, s).kind
	if k == ST_BLOCK {
		cg_stmts(cast(Block, s).stmts)
	} else if k == ST_LET {
		cg_expr(cast(LetStmt, s).init)
	} else if k == ST_ASSIGN {
		if cg_in_main != 0 {
			cg_store(cast(AssignStmt, s).target, cast(Node, s).pos)
		}
		cg_expr(cast(AssignStmt, s).target)
		cg_expr(cast(AssignStmt, s).value)
	} else if k == ST_EXPR {
		cg_expr(cast(ExprStmt, s).x)
	} else if k == ST_IF {
		cg_expr(cast(IfStmt, s).cond)
		cg_stmt(cast(IfStmt, s).then)
		cg_stmt(cast(IfStmt, s).else_)
	} else if k == ST_WHILE {
		cg_expr(cast(WhileStmt, s).cond)
		cg_stmt(cast(WhileStmt, s).body)
		cg_stmt(cast(WhileStmt, s).post)
	} else if k == ST_RETURN {
		cg_expr(cast(ReturnStmt, s).value)
		if cast(i64, cast(ReturnStmt, s).values) != 0 {
			cg_exprs(cast(ReturnStmt, s).values)
		}
	} else if k == ST_CALLMULTI {
		if cg_in_main != 0 {
			let syms = cast([]i64, cast(CallMultiStmt, s).syms)
			mut i = 0
			for i < len(syms) {
				let t = syms[i]
				if t != 0 && cast(Sym, t).kind == SYM_GLOBAL && cast(Sym, t).tls != 0 {
					cg_stores = append(cg_stores, t)
					cg_stores = append(cg_stores, cast(Node, s).pos)
				}
				i = i + 1
			}
		}
		cg_expr(cast(CallMultiStmt, s).call)
	}
}

fn cg_exprs(v []i64) {
	mut i = 0
	for i < len(v) {
		cg_expr(v[i])
		i = i + 1
	}
}

fn cg_expr(e i64) {
	if e == 0 {
		return
	}
	let k = cast(Node, e).kind
	if k == EX_CALL {
		if cg_in_main != 0 {
			// A runtime call that stores into its first argument (a map insert, an in-place
			// append) writes the global that argument names.
			if cast(Call, e).store != 0 && cast(i64, cast(Call, e).args) != 0 && len(cast(Call, e).args) > 0 {
				cg_store(cast(Call, e).args[0], cast(Node, e).pos)
			}
			cg_visit(cast(Call, e).fn_)
		}
		cg_expr(cast(Call, e).callee)
		cg_exprs(cast(Call, e).args)
	} else if k == EX_IDENT {
		let s = cast(IdentExpr, e).ref
		if cg_in_main == 0 && s != 0 && cast(Sym, s).kind == SYM_GLOBAL && cast(Sym, s).tls != 0 && slice_has(cg_refs, s) == 0 {
			cg_refs = append(cg_refs, s)
		}
	} else if k == EX_UNARY {
		cg_expr(cast(Unary, e).x)
	} else if k == EX_BINARY {
		cg_expr(cast(Binary, e).l)
		cg_expr(cast(Binary, e).r)
	} else if k == EX_INDEX {
		cg_expr(cast(IndexExpr, e).x)
		cg_expr(cast(IndexExpr, e).i)
	} else if k == EX_CONV {
		cg_expr(cast(Conv, e).x)
	} else if k == EX_SEQ {
		cg_stmts(cast(SeqExpr, e).stmts)
		cg_expr(cast(SeqExpr, e).value)
	} else if k == EX_MEM {
		cg_expr(cast(MemExpr, e).base)
		cg_expr(cast(MemExpr, e).index)
		cg_expr(cast(MemExpr, e).len)
	} else if k == EX_ELEM {
		cg_expr(cast(ElemExpr, e).seq)
		cg_expr(cast(ElemExpr, e).idx)
	}
}

// ---- iteration pools (#633, design/design_escape.md section 3) ----
//
// A loop whose iterations keep everything they allocate gives each iteration's memory back: a
// pool mark (the core's bump pointer and extra-block list) is taken when the body starts, and
// rt_pool_release runs when it ends and before a break, continue or return leaves it. The scan
// is conservative and runs after the region fixed point, so callee summaries are final: storing
// anything that holds a pointer outside the iteration, growing an outside slice or map, a callee
// that stores into or grows an argument from outside, a function literal, an indirect call, a
// pool reset, a returned pointer or a fault leaves the loop as it is.
shared mut lp_fn i64
shared mut lp_inner []i64 // locals the body declares
shared mut lp_fresh []i64 // of those, the ones bound only to memory the iteration made
shared mut lp_ok i64
shared mut lp_calls i64 // the body may allocate: a loop that cannot gets no mark
shared mut lp_depth i64 // nested loops inside the body being scanned
shared mut lp_gen i64 // the local holding the loop's ctxShareGen mark

fn loop_pools() {
	lp_alloc_summaries()
	mut i = 0
	for i < len(prog_fns) {
		let f = prog_fns[i]
		if f.reach != 0 && f.body != 0 && f.regsum != 0 && rg_analyzable(f) != 0 && file_trusted[f.file] == 0 {
			lp_fn = cast(i64, f)
			set_file(f.file)
			lp_find(cast(Block, f.body).stmts)
		}
		i = i + 1
	}
}

// lp_find visits the loops among statements v, inner ones first.
fn lp_find(v []i64) {
	mut i = 0
	for i < len(v) {
		let s = v[i]
		let k = cast(Node, s).kind
		if k == ST_BLOCK {
			lp_find(cast(Block, s).stmts)
		} else if k == ST_IF {
			lp_find_one(cast(IfStmt, s).then)
			if cast(IfStmt, s).else_ != 0 {
				lp_find_one(cast(IfStmt, s).else_)
			}
		} else if k == ST_WHILE {
			lp_find_one(cast(WhileStmt, s).body)
			lp_try(cast(WhileStmt, s))
		}
		i = i + 1
	}
}

fn lp_find_one(s i64) {
	if s == 0 {
		return
	}
	if cast(Node, s).kind == ST_BLOCK {
		lp_find(cast(Block, s).stmts)
		return
	}
	mut one = []i64{}
	one = append(one, s)
	lp_find(one)
}

fn lp_try(w WhileStmt) {
	if w.body == 0 || cast(Node, w.body).kind != ST_BLOCK {
		return
	}
	lp_inner = []i64{}
	lp_fresh = []i64{}
	lp_ok = 1
	lp_calls = 0
	lp_depth = 0
	lp_collect(cast(Block, w.body).stmts)
	lp_scan(cast(Block, w.body).stmts)
	if lp_ok == 0 || lp_calls == 0 {
		return
	}
	let f = cast(Fn, lp_fn)
	let pos = cast(Node, w).pos
	let mb = cast(Sym, ia_local_in(f, ty_int))
	let mx = cast(Sym, ia_local_in(f, ty_int))
	let mg = cast(Sym, ia_local_in(f, ty_int))
	// The mark lives in the frame: three registers held across a hot loop would cost more.
	mb.addr = 1
	mx.addr = 1
	mg.addr = 1
	lp_gen = cast(i64, mg)
	let body = cast(Block, w.body)
	lp_exits(body.stmts, mb, mx, 0)
	mut nb = []i64{}
	nb = append(nb, let_stmt(pos, mb, lp_ctx_word(pos, 0)))
	nb = append(nb, let_stmt(pos, mx, lp_ctx_word(pos, 9)))
	nb = append(nb, let_stmt(pos, mg, lp_ctx_word(pos, 15)))
	mut i = 0
	for i < len(body.stmts) {
		nb = append(nb, body.stmts[i])
		i = i + 1
	}
	nb = append(nb, lp_release(pos, mb, mx))
	body.stmts = cast([]i64, nb)
}

// lp_ctx_word reads word i of the core context: 0 the bump pointer, 9 the extra-block list, 15
// the count of pool-sharing scope children started and ended.
fn lp_ctx_word(pos i64, i i64) i64 {
	return mk_mem(pos, intrinsic_call(pos, "__ctx", cast(i64, []i64{}), ty_int), 0, 0, 8 * i, ty_int)
}

// lp_release gives the iteration's memory back when it allocated any: the two words moved.
fn lp_release(pos i64, mb Sym, mx Sym) i64 {
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = mk_bin(pos, "||", mk_bin(pos, "!=", lp_ctx_word(pos, 0), sym_ref_node(pos, mb), ty_bool), mk_bin(pos, "!=", lp_ctx_word(pos, 9), sym_ref_node(pos, mx), ty_bool), ty_bool)
	ifs.then = empty_block(pos)
	let rf = find_fn("rt_pool_release")
	mark_reach(rf)
	mut tb = cast(Block, ifs.then).stmts
	tb = append(tb, expr_stmt(cast(Node, rt_call(pos, "rt_pool_release", args3(sym_ref_node(pos, mb), sym_ref_node(pos, mx), sym_ref_node(pos, cast(Sym, lp_gen))), ty_void))))
	return cast(i64, ifs)
}

// lp_exits puts a release before each break and continue of this loop (depth 0, outside the
// loops nested in it) and before each return anywhere in it; a returned value is computed first,
// since the release zeroes what the iteration made.
fn lp_exits(v []i64, mb Sym, mx Sym, depth i64) {
	mut i = 0
	for i < len(v) {
		let s = v[i]
		let k = cast(Node, s).kind
		let pos = cast(Node, s).pos
		if k == ST_BLOCK {
			lp_exits(cast(Block, s).stmts, mb, mx, depth)
		} else if k == ST_IF {
			lp_exits_one(cast(IfStmt, s).then, mb, mx, depth)
			if cast(IfStmt, s).else_ != 0 {
				lp_exits_one(cast(IfStmt, s).else_, mb, mx, depth)
			}
		} else if k == ST_WHILE {
			lp_exits_one(cast(WhileStmt, s).body, mb, mx, depth + 1)
		} else if (k == ST_BREAK || k == ST_CONTINUE) && depth == 0 {
			let b = cast(Block, empty_block(pos))
			b.flat = 1
			b.stmts = append(b.stmts, lp_release(pos, mb, mx))
			let jump = node_new(k, pos)
			replace_node(jump, s)
			b.stmts = append(b.stmts, jump)
			replace_node(s, cast(i64, b))
		} else if k == ST_RETURN {
			let b = cast(Block, empty_block(pos))
			b.flat = 1
			let r = cast(ReturnStmt, node_new(ST_RETURN, pos))
			if cast(ReturnStmt, s).value != 0 {
				// The value's local belongs to the function being changed (temp() would put it
				// in the checker's current one).
				let v0 = cast(Node, cast(ReturnStmt, s).value)
				let t0 = cast(Sym, ia_local_in(cast(Fn, lp_fn), v0.type_))
				b.stmts = append(b.stmts, let_stmt(pos, t0, cast(i64, v0)))
				r.value = sym_ref_node(pos, t0)
			}
			if cast(i64, cast(ReturnStmt, s).values) != 0 {
				mut vals = []i64{}
				mut j = 0
				for j < len(cast(ReturnStmt, s).values) {
					let vj = cast(Node, cast(ReturnStmt, s).values[j])
					let tj = cast(Sym, ia_local_in(cast(Fn, lp_fn), vj.type_))
					b.stmts = append(b.stmts, let_stmt(pos, tj, cast(i64, vj)))
					vals = append(vals, sym_ref_node(pos, tj))
					j = j + 1
				}
				r.values = cast([]i64, vals)
			}
			b.stmts = append(b.stmts, lp_release(pos, mb, mx))
			b.stmts = append(b.stmts, cast(i64, r))
			replace_node(s, cast(i64, b))
		}
		i = i + 1
	}
}

fn lp_exits_one(s i64, mb Sym, mx Sym, depth i64) {
	if s == 0 {
		return
	}
	mut one = []i64{}
	one = append(one, s)
	lp_exits(one, mb, mx, depth)
}

// lp_collect notes the locals the body declares, and which are bound to fresh memory.
fn lp_collect(v []i64) {
	mut i = 0
	for i < len(v) {
		lp_collect_stmt(v[i])
		i = i + 1
	}
}

fn lp_collect_stmt(s i64) {
	if s == 0 {
		return
	}
	let k = cast(Node, s).kind
	if k == ST_LET {
		let sym = cast(LetStmt, s).sym
		lp_inner = append(lp_inner, sym)
		lp_collect_expr(cast(LetStmt, s).init)
		if lp_fresh_expr(cast(LetStmt, s).init) != 0 {
			lp_fresh = append(lp_fresh, sym)
		}
	} else if k == ST_BLOCK {
		lp_collect(cast(Block, s).stmts)
	} else if k == ST_IF {
		lp_collect_expr(cast(IfStmt, s).cond)
		lp_collect_stmt(cast(IfStmt, s).then)
		lp_collect_stmt(cast(IfStmt, s).else_)
	} else if k == ST_WHILE {
		lp_collect_expr(cast(WhileStmt, s).cond)
		lp_collect_stmt(cast(WhileStmt, s).body)
		lp_collect_stmt(cast(WhileStmt, s).post)
	} else if k == ST_ASSIGN {
		lp_collect_expr(cast(AssignStmt, s).value)
		let t = cast(AssignStmt, s).target
		if cast(Node, t).kind == EX_IDENT && slice_has(lp_fresh, cast(IdentExpr, t).ref) != 0 && lp_fresh_expr(cast(AssignStmt, s).value) == 0 {
			// Bound to something else too: no longer only fresh memory.
			lp_unfresh(cast(IdentExpr, t).ref)
		}
	} else if k == ST_EXPR {
		lp_collect_expr(cast(ExprStmt, s).x)
	} else if k == ST_CALLMULTI {
		let syms = cast(CallMultiStmt, s).syms
		mut j = 0
		for j < len(syms) {
			lp_inner = append(lp_inner, cast(i64, syms[j]))
			lp_unfresh(cast(i64, syms[j]))
			j = j + 1
		}
	}
}

fn lp_unfresh(sym i64) {
	mut out = []i64{}
	mut i = 0
	for i < len(lp_fresh) {
		if lp_fresh[i] != sym {
			out = append(out, lp_fresh[i])
		}
		i = i + 1
	}
	lp_fresh = out
}

// lp_collect_expr finds the temps that checker-made sequences declare (a literal's object).
fn lp_collect_expr(e i64) {
	if e == 0 {
		return
	}
	let k = cast(Node, e).kind
	if k == EX_SEQ {
		lp_collect(cast(SeqExpr, e).stmts)
		lp_collect_expr(cast(SeqExpr, e).value)
	} else if k == EX_CALL {
		let args = cast(Call, e).args
		mut i = 0
		for cast(i64, args) != 0 && i < len(args) {
			lp_collect_expr(args[i])
			i = i + 1
		}
	} else if k == EX_CONV {
		lp_collect_expr(cast(Conv, e).x)
	} else if k == EX_BINARY {
		lp_collect_expr(cast(Binary, e).l)
		lp_collect_expr(cast(Binary, e).r)
	} else if k == EX_UNARY {
		lp_collect_expr(cast(Unary, e).x)
	}
}

// lp_fresh_expr reports whether e is memory the iteration makes: an allocation, a literal's
// object, or a call whose results come only from fresh memory (its summary).
fn lp_fresh_expr(e i64) i64 {
	if e == 0 {
		return 0
	}
	let k = cast(Node, e).kind
	if k == EX_CONV && cast(Conv, e).kind == CV_SAME {
		return lp_fresh_expr(cast(Conv, e).x)
	}
	if k == EX_SEQ {
		let v = cast(SeqExpr, e).value
		return i64(cast(Node, v).kind == EX_IDENT && slice_has(lp_fresh, cast(IdentExpr, v).ref) != 0)
	}
	if k == EX_IDENT {
		return slice_has(lp_fresh, cast(IdentExpr, e).ref)
	}
	if k == EX_MEM && cast(MemExpr, e).hdr != 0 && cast(MemExpr, e).off == 16 && cast(MemExpr, e).index == 0 && cast(Node, cast(MemExpr, e).base).kind == EX_IDENT {
		// The data block of a slice the iteration made (a literal's elements are stored through
		// it) is the iteration's memory too (#714).
		return slice_has(lp_fresh, cast(IdentExpr, cast(MemExpr, e).base).ref)
	}
	if k != EX_CALL || cast(Call, e).callee != 0 {
		return 0
	}
	let name = cast(Call, e).name
	if name == "rt_alloc" || name == "rt_slice_make" || name == "rt_slice_make_str" || name == "rt_map_make" || name == "rt_map_make_rc" || name == "rt_vdup" {
		return 1
	}
	let f = cast(Fn, cast(Call, e).fn_)
	if cast(i64, f) == 0 || f.regsum == 0 {
		return 0
	}
	let bits = f.regsum[2]
	return i64((bits & RG_FRESH) != 0 && (bits & ~(RG_FRESH | RG_EMB)) == 0)
}

// lp_scan clears lp_ok when the body may keep memory it makes past the iteration.
fn lp_scan(v []i64) {
	mut i = 0
	for i < len(v) && lp_ok != 0 {
		lp_scan_stmt(v[i])
		i = i + 1
	}
}

fn lp_scan_stmt(s i64) {
	if s == 0 || lp_ok == 0 {
		return
	}
	let k = cast(Node, s).kind
	if k == ST_LET {
		lp_scan_expr(cast(LetStmt, s).init)
	} else if k == ST_ASSIGN {
		let t = cast(AssignStmt, s).target
		let tt = cast(Ty, cast(Node, t).type_)
		if cast(Node, t).kind == EX_IDENT {
			if has_ptr(tt) != 0 && slice_has(lp_inner, cast(IdentExpr, t).ref) == 0 {
				lp_ok = 0
				return
			}
		} else {
			if has_ptr(tt) != 0 && slice_has(lp_fresh, lp_root(t)) == 0 {
				lp_ok = 0
				return
			}
			lp_scan_expr(t)
		}
		lp_scan_expr(cast(AssignStmt, s).value)
	} else if k == ST_EXPR {
		lp_scan_expr(cast(ExprStmt, s).x)
	} else if k == ST_BLOCK {
		lp_scan(cast(Block, s).stmts)
	} else if k == ST_IF {
		lp_scan_expr(cast(IfStmt, s).cond)
		lp_scan_stmt(cast(IfStmt, s).then)
		lp_scan_stmt(cast(IfStmt, s).else_)
	} else if k == ST_WHILE {
		lp_scan_expr(cast(WhileStmt, s).cond)
		lp_depth = lp_depth + 1
		lp_scan_stmt(cast(WhileStmt, s).body)
		lp_scan_stmt(cast(WhileStmt, s).post)
		lp_depth = lp_depth - 1
	} else if k == ST_RETURN {
		if cast(ReturnStmt, s).value != 0 {
			if has_ptr(cast(Ty, cast(Node, cast(ReturnStmt, s).value).type_)) != 0 {
				lp_ok = 0
				return
			}
			lp_scan_expr(cast(ReturnStmt, s).value)
		}
		let vals = cast(ReturnStmt, s).values
		mut j = 0
		for cast(i64, vals) != 0 && j < len(vals) {
			if has_ptr(cast(Ty, cast(Node, vals[j]).type_)) != 0 {
				lp_ok = 0
				return
			}
			lp_scan_expr(vals[j])
			j = j + 1
		}
	} else if k == ST_BREAK || k == ST_CONTINUE {
		if len(cast(BreakStmt, s).label) != 0 {
			// A labeled jump may leave several loops at once: not handled yet.
			lp_ok = 0
		}
	} else if k == ST_CALLMULTI {
		let syms = cast(CallMultiStmt, s).syms
		mut j = 0
		for j < len(syms) {
			if has_ptr(cast(Ty, syms[j].type_)) != 0 && lp_fresh_expr(cast(CallMultiStmt, s).call) == 0 && slice_has(lp_inner, cast(i64, syms[j])) == 0 {
				lp_ok = 0
				return
			}
			j = j + 1
		}
		lp_scan_expr(cast(CallMultiStmt, s).call)
	} else {
		// fail, defer, select, detach and anything not lowered to the above.
		lp_ok = 0
	}
}

// lp_root is the local whose own object a field, element or index target lies in, or 0. Only
// the object the local points at is known to be the iteration's: a pointer loaded from one of
// its fields may lead anywhere, so p.next.v has no root.
fn lp_root(e i64) i64 {
	mut x = e
	mut steps = 0
	for x != 0 {
		let k = cast(Node, x).kind
		if k == EX_IDENT {
			return cast(IdentExpr, x).ref
		}
		if k == EX_CONV {
			x = cast(Conv, x).x
		} else if steps == 1 {
			return 0
		} else if k == EX_MEM {
			x = cast(MemExpr, x).base
			steps = 1
		} else if k == EX_ELEM {
			x = cast(ElemExpr, x).seq
			steps = 1
		} else if k == EX_INDEX {
			x = cast(IndexExpr, x).x
			steps = 1
		} else {
			return 0
		}
	}
	return 0
}

// lp_alloc_summaries sets regsum[14] for each function that may allocate pool memory: it calls a
// runtime function that does (lp_rt_allocates), a function value, a dyn method, a generated
// function, or a function that may. Only loops whose bodies may allocate get a mark, so a wrong
// answer costs speed or memory, never correctness.
fn lp_alloc_summaries() {
	mut changed = 1
	mut round = 0
	for changed != 0 && round < 30 {
		changed = 0
		mut i = 0
		for i < len(prog_fns) {
			let f = prog_fns[i]
			if f.reach != 0 && f.body != 0 && f.regsum != 0 && f.regsum[14] == 0 && lp_allocs_in(cast(Block, f.body).stmts) != 0 {
				f.regsum[14] = 1
				changed = 1
			}
			i = i + 1
		}
		round = round + 1
	}
}

fn lp_allocs_in(v []i64) i64 {
	mut i = 0
	for cast(i64, v) != 0 && i < len(v) {
		if lp_allocs_stmt(v[i]) != 0 {
			return 1
		}
		i = i + 1
	}
	return 0
}

fn lp_allocs_stmt(s i64) i64 {
	if s == 0 {
		return 0
	}
	let k = cast(Node, s).kind
	if k == ST_BLOCK {
		return lp_allocs_in(cast(Block, s).stmts)
	}
	if k == ST_LET {
		return lp_allocs_expr(cast(LetStmt, s).init)
	}
	if k == ST_ASSIGN {
		return i64(lp_allocs_expr(cast(AssignStmt, s).target) != 0 || lp_allocs_expr(cast(AssignStmt, s).value) != 0)
	}
	if k == ST_EXPR {
		return lp_allocs_expr(cast(ExprStmt, s).x)
	}
	if k == ST_IF {
		return i64(lp_allocs_expr(cast(IfStmt, s).cond) != 0 || lp_allocs_stmt(cast(IfStmt, s).then) != 0 || lp_allocs_stmt(cast(IfStmt, s).else_) != 0)
	}
	if k == ST_WHILE {
		return i64(lp_allocs_expr(cast(WhileStmt, s).cond) != 0 || lp_allocs_stmt(cast(WhileStmt, s).body) != 0 || lp_allocs_stmt(cast(WhileStmt, s).post) != 0)
	}
	if k == ST_RETURN {
		if lp_allocs_expr(cast(ReturnStmt, s).value) != 0 {
			return 1
		}
		let vals = cast(ReturnStmt, s).values
		mut j = 0
		for cast(i64, vals) != 0 && j < len(vals) {
			if lp_allocs_expr(vals[j]) != 0 {
				return 1
			}
			j = j + 1
		}
		return 0
	}
	if k == ST_CALLMULTI {
		return lp_allocs_expr(cast(CallMultiStmt, s).call)
	}
	if k == ST_BREAK || k == ST_CONTINUE {
		return 0
	}
	// fail, defer, select: they allocate.
	return 1
}

fn lp_allocs_expr(e i64) i64 {
	if e == 0 {
		return 0
	}
	let k = cast(Node, e).kind
	if k == EX_CALL {
		if lp_call_allocs(e) != 0 {
			return 1
		}
		if lp_allocs_expr(cast(Call, e).callee) != 0 {
			return 1
		}
		let args = cast(Call, e).args
		mut i = 0
		for cast(i64, args) != 0 && i < len(args) {
			if lp_allocs_expr(args[i]) != 0 {
				return 1
			}
			i = i + 1
		}
		return 0
	}
	if k == EX_BINARY {
		return i64(lp_allocs_expr(cast(Binary, e).l) != 0 || lp_allocs_expr(cast(Binary, e).r) != 0)
	}
	if k == EX_UNARY {
		return lp_allocs_expr(cast(Unary, e).x)
	}
	if k == EX_CONV {
		return lp_allocs_expr(cast(Conv, e).x)
	}
	if k == EX_MEM {
		return i64(lp_allocs_expr(cast(MemExpr, e).base) != 0 || lp_allocs_expr(cast(MemExpr, e).index) != 0 || lp_allocs_expr(cast(MemExpr, e).len) != 0)
	}
	if k == EX_ELEM {
		return i64(lp_allocs_expr(cast(ElemExpr, e).seq) != 0 || lp_allocs_expr(cast(ElemExpr, e).idx) != 0)
	}
	if k == EX_INDEX {
		return i64(lp_allocs_expr(cast(IndexExpr, e).x) != 0 || lp_allocs_expr(cast(IndexExpr, e).i) != 0)
	}
	if k == EX_SEQ {
		return i64(lp_allocs_in(cast(SeqExpr, e).stmts) != 0 || lp_allocs_expr(cast(SeqExpr, e).value) != 0)
	}
	if k == EX_INT || k == EX_FLOAT || k == EX_STR || k == EX_IDENT || k == EX_FUNCREF || k == EX_NIL {
		return 0
	}
	// A function literal makes a closure.
	return 1
}

// lp_call_allocs reports whether call e itself may allocate pool memory (not its arguments).
fn lp_call_allocs(e i64) i64 {
	if cast(Call, e).callee != 0 || cast(Call, e).dyn_shape != 0 {
		return 1
	}
	if cast(Call, e).intrinsic != 0 {
		return 0
	}
	let name = cast(Call, e).name
	if len(name) > 3 && str_prefix(name, "rt_") != 0 {
		return lp_rt_allocates(name)
	}
	let f = cast(Fn, cast(Call, e).fn_)
	if cast(i64, f) == 0 {
		return 1
	}
	if f.extern_ != 0 {
		return 0
	}
	if f.regsum == 0 {
		return 1
	}
	return f.regsum[14]
}

// lp_rt_allocates reports a runtime call that takes pool memory.
fn lp_rt_allocates(name str) i64 {
	if str_prefix(name, "rt_slice_make") != 0 || str_prefix(name, "rt_map_make") != 0 || str_prefix(name, "rt_append") != 0 || str_prefix(name, "rt_slice_appendn") != 0 || str_prefix(name, "rt_str_from") != 0 || str_prefix(name, "rt_map_set") != 0 || str_prefix(name, "rt_kb_") != 0 {
		return 1
	}
	return i64(name == "rt_alloc" || name == "rt_vdup" || name == "rt_str_new" || name == "rt_str_cat" || name == "rt_str_grow" || name == "rt_str_sub" || name == "rt_bytes_from_str" || name == "rt_fmt_end" || name == "rt_slice_sub" || name == "rt_map_order" || name == "rt_err_str" || name == "rt_utf8" || name == "rt_copy_str" || name == "rt_slice_copy" || name == "rt_slice_copy_rc" || name == "rt_slice_copy_dyn")
}

// lp_rt_into_first reports whether runtime call name stores into, or grows, its first argument
// (the region pass records that as a store into the argument).
fn lp_rt_into_first(name str) i64 {
	return i64(rg_grows_op(name) != 0 || name == "rt_slice_copy" || name == "rt_slice_copy_rc" || name == "rt_slice_copy_dyn" || name == "rt_map_set_pair" || name == "rt_append_pair" || name == "rt_append_mem")
}

// lp_pure_fn reports whether generated function q only reads its arguments (printing,
// comparing, encoding keys) or copies them out (keep).
fn lp_pure_fn(q str) i64 {
	return i64(str_prefix(q, "say$") != 0 || str_prefix(q, "eq$") != 0 || str_prefix(q, "veq$") != 0 || str_prefix(q, "keyenc$") != 0 || str_prefix(q, "keydec$") != 0 || str_prefix(q, "keep$") != 0)
}

// lp_rt_keeps_nothing reports whether runtime call name keeps none of its arguments past the
// call (it may read them, or return them or a new value built from them).
fn lp_rt_keeps_nothing(name str) i64 {
	if str_prefix(name, "rt_fmt_") != 0 || str_prefix(name, "rt_sys_") != 0 || str_prefix(name, "rt_kb_") != 0 || str_prefix(name, "rt_kd_") != 0 || str_prefix(name, "rt_keep") != 0 || str_prefix(name, "rt_bounds_fail") != 0 {
		return 1
	}
	return i64(name == "rt_alloc" || name == "rt_vdup" || name == "rt_str_new" || name == "rt_ingot_alloc" || name == "rt_slice_make" || name == "rt_slice_make_str" || name == "rt_slice_make_nest" || name == "rt_slice_make_grid" || name == "rt_map_make" || name == "rt_map_make_rc" || name == "rt_map_key" || name == "rt_map_slots" || name == "rt_map_live" || name == "rt_map_len" || name == "rt_map_val" || name == "rt_map_val_dyn" || name == "rt_map_get" || name == "rt_map_get_dyn" || name == "rt_map_found" || name == "rt_map_del" || name == "rt_map_order" || name == "rt_order_at" || name == "rt_str_eq" || name == "rt_str_cmp" || name == "rt_str_cat" || name == "rt_str_sub" || name == "rt_str_from_rune" || name == "rt_str_from_bytes" || name == "rt_bytes_from_str" || name == "rt_copy_str" || name == "rt_slice_sub" || name == "rt_utf8" || name == "rt_err_str" || name == "rt_panic" || name == "rt_overflow_fail" || name == "rt_div_fail" || name == "rt_bnd_poll" || name == "rt_rc_inc" || name == "rt_rc_dec" || name == "rt_rc_dec_dyn" || name == "rt_rc_drop_none" || name == "rt_rc_arr_n" || name == "rt_pool_used" || name == "rt_task_swap")
}

fn lp_scan_exprs(v []i64) {
	mut i = 0
	for cast(i64, v) != 0 && i < len(v) && lp_ok != 0 {
		lp_scan_expr(v[i])
		i = i + 1
	}
}

fn lp_scan_expr(e i64) {
	if e == 0 || lp_ok == 0 {
		return
	}
	let k = cast(Node, e).kind
	if k == EX_INT || k == EX_FLOAT || k == EX_STR || k == EX_IDENT || k == EX_FUNCREF || k == EX_NIL {
		return
	}
	if k == EX_BINARY {
		lp_scan_expr(cast(Binary, e).l)
		lp_scan_expr(cast(Binary, e).r)
	} else if k == EX_UNARY {
		lp_scan_expr(cast(Unary, e).x)
	} else if k == EX_CONV {
		lp_scan_expr(cast(Conv, e).x)
	} else if k == EX_MEM {
		lp_scan_expr(cast(MemExpr, e).base)
		lp_scan_expr(cast(MemExpr, e).index)
	} else if k == EX_ELEM {
		lp_scan_expr(cast(ElemExpr, e).seq)
		lp_scan_expr(cast(ElemExpr, e).idx)
	} else if k == EX_INDEX {
		lp_scan_expr(cast(IndexExpr, e).x)
		lp_scan_expr(cast(IndexExpr, e).i)
	} else if k == EX_SEQ {
		lp_scan(cast(SeqExpr, e).stmts)
		lp_scan_expr(cast(SeqExpr, e).value)
	} else if k == EX_CALL {
		lp_scan_call(e)
	} else {
		// A function literal, and any node this scan does not know.
		lp_ok = 0
	}
}

// lp_scan_call checks a call: an indirect call is unknown; a runtime call that grows or stores
// into its first argument needs that to be fresh; a call of a function needs its summary to keep
// what it is given (no store into, no growth of, an argument from outside), and no pool reset.
fn lp_scan_call(e i64) {
	if lp_call_allocs(e) != 0 {
		lp_calls = 1
	}
	let args = cast(Call, e).args
	if cast(Call, e).callee != 0 || cast(Call, e).dyn_shape != 0 {
		lp_ok = 0
		return
	}
	let name = cast(Call, e).name
	if cast(Call, e).intrinsic != 0 {
		lp_scan_exprs(args)
		return
	}
	if len(name) > 3 && name[0] == 'r' && name[1] == 't' && name[2] == '_' {
		if lp_rt_into_first(name) != 0 {
			if cast(i64, args) == 0 || len(args) == 0 || slice_has(lp_fresh, lp_root(args[0])) == 0 {
				lp_ok = 0
				return
			}
		} else if lp_rt_keeps_nothing(name) == 0 && name != "rt_pool_release" {
			// Spawns, scopes, defer, select, use, within, guard, arenas, faults and the rest may
			// keep what they are given past the iteration. A nested loop's own release (#714)
			// gives back only memory its iteration made, which is inside this one's.
			lp_ok = 0
			return
		}
		lp_scan_exprs(args)
		return
	}
	let f = cast(Fn, cast(Call, e).fn_)
	if cast(i64, f) == 0 {
		lp_ok = 0
		return
	}
	if f.regsum == 0 {
		// A generated or extern function: with no summary, it may keep anything.
		if lp_pure_fn(f.qname) == 0 {
			lp_ok = 0
			return
		}
		lp_scan_exprs(args)
		return
	}
	if f.regsum[12] != 0 || f.regsum[13] != 0 {
		lp_ok = 0
		return
	}
	mut i = 0
	for cast(i64, args) != 0 && i < len(args) {
		let a = args[i]
		if has_ptr(cast(Ty, cast(Node, a).type_)) != 0 && i < 62 && lp_into_param(f, i) != 0 && slice_has(lp_fresh, lp_root(a)) == 0 {
			lp_ok = 0
			return
		}
		i = i + 1
	}
	lp_scan_exprs(args)
}

// lp_into_param reports whether f may store into, or grow, what parameter i reaches.
fn lp_into_param(f Fn, i i64) i64 {
	if (f.regsum[0] & (1 << i)) != 0 {
		return 1
	}
	if lp_list_bit(rg_grows, cast(i64, f), i) != 0 || lp_list_bit(rg_fstores, cast(i64, f), i) != 0 {
		return 1
	}
	mut k = 0
	for cast(i64, rg_pstores) != 0 && k < len(rg_pstores) {
		if rg_pstores[k] == cast(i64, f) && rg_pstores[k + 1] == i {
			return 1
		}
		k = k + 3
	}
	return 0
}

fn lp_list_bit(h []i64, f i64, i i64) i64 {
	if cast(i64, h) == 0 {
		return 0
	}
	mut k = 0
	for k < len(h) {
		if h[k] == f {
			return i64((h[k + 1] & (1 << i)) != 0)
		}
		k = k + 2
	}
	return 0
}

// ---- frame objects (#633, design/design_escape.md section 2) ----
//
// A struct literal bound to a local that is contained (every use reads or writes a field of it,
// or passes it to a parameter its callee's summary does not let escape) lives in the frame: the
// literal's rt_alloc becomes a zeroed frame area, a value-struct twin of the struct's type, so
// no allocator runs. Small objects only (fo_max bytes each, fo_budget per function): a frame
// object costs stack in every activation, and task stacks are 256 KiB.
const fo_max = 128
const fo_budget = 512
shared mut fo_fn i64
shared mut fo_bytes i64
shared mut fo_sym i64 // the local being checked
shared mut fo_ok i64

fn frame_objects() {
	mut i = 0
	for i < len(prog_fns) {
		let f = prog_fns[i]
		if f.reach != 0 && f.body != 0 && f.regsum != 0 && rg_analyzable(f) != 0 && file_trusted[f.file] == 0 {
			fo_fn = cast(i64, f)
			fo_bytes = 0
			set_file(f.file)
			fo_find(cast(Block, f.body).stmts)
			fh_fn(f)
		}
		i = i + 1
	}
}

// fo_find visits every let among statements v and the blocks nested in them.
fn fo_find(v []i64) {
	mut i = 0
	for i < len(v) {
		fo_find_stmt(v[i])
		i = i + 1
	}
}

fn fo_find_stmt(s i64) {
	if s == 0 {
		return
	}
	let k = cast(Node, s).kind
	if k == ST_BLOCK {
		fo_find(cast(Block, s).stmts)
	} else if k == ST_IF {
		fo_find_stmt(cast(IfStmt, s).then)
		fo_find_stmt(cast(IfStmt, s).else_)
	} else if k == ST_WHILE {
		fo_find_stmt(cast(WhileStmt, s).body)
	} else if k == ST_LET {
		fo_try(cast(LetStmt, s))
	}
}

// fo_alloc is the rt_alloc let that starts a struct literal's sequence e, or 0.
fn fo_alloc(e i64) i64 {
	if e == 0 || cast(Node, e).kind != EX_SEQ {
		return 0
	}
	let stmts = cast(SeqExpr, e).stmts
	let v = cast(SeqExpr, e).value
	if cast(i64, stmts) == 0 || len(stmts) == 0 || cast(Node, stmts[0]).kind != ST_LET || v == 0 || cast(Node, v).kind != EX_IDENT {
		return 0
	}
	let first = cast(LetStmt, stmts[0])
	if cast(IdentExpr, v).ref != first.sym {
		return 0
	}
	let init = first.init
	if init == 0 || cast(Node, init).kind != EX_CALL || cast(Call, init).name != "rt_alloc" || cast(Call, init).callee != 0 {
		return 0
	}
	return cast(i64, first)
}

fn fo_try(s LetStmt) {
	let t = cast(Ty, cast(Sym, s.sym).type_)
	if cast(Sym, s.sym).captured != 0 || kind_of(t) != K_STRUCT || t.value != 0 || cast(i64, t.enum_) != 0 {
		return
	}
	let a = fo_alloc(s.init)
	if a == 0 {
		return
	}
	let size = t.size
	if size <= 0 || size > fo_max || fo_bytes + size > fo_budget {
		return
	}
	fo_sym = s.sym
	fo_ok = 1
	fo_stmts(cast(Block, cast(Fn, fo_fn).body).stmts)
	if fo_ok == 0 {
		return
	}
	fo_bytes = fo_bytes + size
	// The object's bytes: a frame area of a value-struct twin of its type, zeroed where the
	// literal runs (each time it runs, in a loop), and the literal's object is its address.
	let vt = cast(Ty, ty_new(K_STRUCT, t.name))
	ty_copy(vt, t)
	vt.value = 1
	let pos = cast(Node, a).pos
	let area = cast(Sym, ia_local_in(cast(Fn, fo_fn), cast(i64, vt)))
	let first = cast(LetStmt, a)
	let b = cast(Block, empty_block(pos))
	b.flat = 1
	b.stmts = append(b.stmts, let_stmt(pos, area, mk_int(pos, 0, cast(i64, vt))))
	first.init = mk_conv(pos, sym_ref_node(pos, area), CV_SAME, cast(i64, t))
	b.stmts = append(b.stmts, cast(i64, first))
	cast(SeqExpr, s.init).stmts[0] = cast(i64, b)
}

// fo_stmts clears fo_ok when a statement among v uses the local fo_sym in a way that may keep
// its object: anything but reading or writing a field, comparing it, or passing it to a
// parameter that does not escape (fo_call).
fn fo_stmts(v []i64) {
	mut i = 0
	for cast(i64, v) != 0 && i < len(v) && fo_ok != 0 {
		fo_stmt(v[i])
		i = i + 1
	}
}

fn fo_stmt(s i64) {
	if s == 0 || fo_ok == 0 {
		return
	}
	let k = cast(Node, s).kind
	if k == ST_LET {
		fo_expr(cast(LetStmt, s).init)
	} else if k == ST_ASSIGN {
		let t = cast(AssignStmt, s).target
		let tk = cast(Node, t).kind
		if tk == EX_IDENT {
			if cast(IdentExpr, t).ref == fo_sym {
				// Rebinding the local: the object it held may still be in use.
				fo_ok = 0
				return
			}
		} else if tk == EX_MEM {
			fo_field_base(cast(MemExpr, t).base)
			fo_expr(cast(MemExpr, t).index)
		} else {
			fo_expr(t)
		}
		fo_expr(cast(AssignStmt, s).value)
	} else if k == ST_EXPR {
		fo_expr(cast(ExprStmt, s).x)
	} else if k == ST_BLOCK {
		fo_stmts(cast(Block, s).stmts)
	} else if k == ST_IF {
		fo_expr(cast(IfStmt, s).cond)
		fo_stmt(cast(IfStmt, s).then)
		fo_stmt(cast(IfStmt, s).else_)
	} else if k == ST_WHILE {
		fo_expr(cast(WhileStmt, s).cond)
		fo_stmt(cast(WhileStmt, s).body)
		fo_stmt(cast(WhileStmt, s).post)
	} else if k == ST_RETURN {
		fo_expr(cast(ReturnStmt, s).value)
		let vals = cast(ReturnStmt, s).values
		mut j = 0
		for cast(i64, vals) != 0 && j < len(vals) {
			fo_expr(vals[j])
			j = j + 1
		}
	} else if k == ST_CALLMULTI {
		fo_expr(cast(CallMultiStmt, s).call)
	} else if k != ST_BREAK && k != ST_CONTINUE {
		// fail, defer, select and anything not lowered to the above.
		fo_ok = 0
	}
}

// fo_field_base checks the base of a field access: the local itself is fine (its object's
// field is read or written), anything else is an expression like any other.
fn fo_field_base(b i64) {
	if b != 0 && cast(Node, b).kind == EX_IDENT && cast(IdentExpr, b).ref == fo_sym {
		return
	}
	fo_expr(b)
}

fn fo_is_sym(e i64) i64 {
	return i64(e != 0 && cast(Node, e).kind == EX_IDENT && cast(IdentExpr, e).ref == fo_sym)
}

fn fo_expr(e i64) {
	if e == 0 || fo_ok == 0 {
		return
	}
	let k = cast(Node, e).kind
	if k == EX_IDENT {
		if cast(IdentExpr, e).ref == fo_sym {
			// The object itself as a value: stored, returned, converted or passed on.
			fo_ok = 0
		}
		return
	}
	if k == EX_INT || k == EX_FLOAT || k == EX_STR || k == EX_FUNCREF || k == EX_NIL {
		return
	}
	if k == EX_MEM {
		fo_field_base(cast(MemExpr, e).base)
		fo_expr(cast(MemExpr, e).index)
		fo_expr(cast(MemExpr, e).len)
	} else if k == EX_ELEM {
		// A header local's elements are read and written through it (#944).
		if fo_hdr == 0 || fo_is_sym(cast(ElemExpr, e).seq) == 0 {
			fo_expr(cast(ElemExpr, e).seq)
		}
		fo_expr(cast(ElemExpr, e).idx)
	} else if k == EX_INDEX {
		fo_expr(cast(IndexExpr, e).x)
		fo_expr(cast(IndexExpr, e).i)
	} else if k == EX_BINARY {
		// Comparing the object's address keeps nothing.
		let op = cast(Binary, e).op
		let cmp = i64(op == "==" || op == "!=")
		if cmp == 0 || fo_is_sym(cast(Binary, e).l) == 0 {
			fo_expr(cast(Binary, e).l)
		}
		if cmp == 0 || fo_is_sym(cast(Binary, e).r) == 0 {
			fo_expr(cast(Binary, e).r)
		}
	} else if k == EX_UNARY {
		fo_expr(cast(Unary, e).x)
	} else if k == EX_CONV {
		fo_expr(cast(Conv, e).x)
	} else if k == EX_SEQ {
		fo_stmts(cast(SeqExpr, e).stmts)
		fo_expr(cast(SeqExpr, e).value)
	} else if k == EX_CALL {
		fo_call(e)
	} else {
		// A function literal (it may capture the local), and any node this pass does not know.
		fo_ok = 0
	}
}

// fo_call lets the local be an argument where the callee keeps nothing of it: a generated
// printing, comparing, key or keep helper, keep itself, or a function whose summary shows the
// parameter reaching no result, no container its caller can see, and nothing kept past the call.
fn fo_call(e i64) {
	let args = cast(Call, e).args
	fo_expr(cast(Call, e).callee)
	let direct = i64(cast(Call, e).callee == 0 && cast(Call, e).dyn_shape == 0 && cast(Call, e).intrinsic == 0)
	let name = cast(Call, e).name
	let f = cast(Fn, cast(Call, e).fn_)
	mut i = 0
	for cast(i64, args) != 0 && i < len(args) && fo_ok != 0 {
		let a = args[i]
		if fo_is_sym(a) != 0 {
			if direct == 0 {
				fo_ok = 0
			} else if len(name) > 3 && str_prefix(name, "rt_") != 0 {
				if fo_hdr != 0 {
					// A header local goes only where the runtime reads it (#944).
					if fh_rt_reads(name, i) == 0 {
						fo_ok = 0
					}
				} else if str_prefix(name, "rt_keep") == 0 {
					fo_ok = 0
				}
			} else if cast(i64, f) == 0 || f.regsum == 0 {
				if cast(i64, f) == 0 || lp_pure_fn(f.qname) == 0 {
					fo_ok = 0
				}
			} else if fo_param_escapes(f, i) != 0 {
				fo_ok = 0
			}
		} else {
			fo_expr(a)
		}
		i = i + 1
	}
}

// fo_param_escapes reports whether f may keep what its parameter i points at after it returns.
fn fo_param_escapes(f Fn, i i64) i64 {
	let sum = f.regsum
	if i >= RG_MAXP || sum[13] != 0 || cast(i64, f.rtypes) != 0 && len(f.rtypes) > 8 {
		return 1
	}
	let bit = RG_P0 << i
	mut j = 0
	for j < 8 {
		if (sum[2 + j] & bit) != 0 {
			return 1
		}
		j = j + 1
	}
	let held = cast([]i64, sum[1])
	j = 0
	for cast(i64, held) != 0 && j + 2 < len(held) {
		if (held[j + 2] & bit) != 0 {
			return 1
		}
		j = j + 3
	}
	return 0
}

// ---- frame slice headers (#944) ----
//
// A sub-slice x[lo:hi] makes a 32-byte header (rt_slice_sub). Passed straight to a parameter
// that keeps nothing of it (fo_param_escapes), or to the runtime where it only reads it (copy,
// append(s, x...), str(x)), the header is needed only during that call; bound to a local that
// stays contained (fo_stmts), only while the function runs. Such a header goes in a frame area
// instead, filled by rt_slice_sub_in, so a loop that copies chunk by chunk takes no pool memory.
// An argument's area is free again once its statement has run: the next statement reuses it.
const fh_max = 8 // areas per function: each costs 32 bytes of stack in every activation
shared mut fh_ty i64 // the areas' type: a 32-byte value struct
shared mut fh_f i64
shared mut fh_areas []i64 // the function's argument areas, reused statement by statement
shared mut fh_next i64 // the first argument area the statement being walked has not used
shared mut fh_count i64 // areas made in this function, argument and local ones
shared mut fh_depth i64 // > 0 inside an expression, whose statements free no areas
shared mut fo_hdr i64 // fo_stmts is checking a header local: its elements may be used

fn fh_fn(f Fn) {
	fh_f = cast(i64, f)
	fh_areas = []i64{}
	fh_count = 0
	fh_depth = 0
	fh_stmts(cast(Block, f.body).stmts)
}

fn fh_stmts(v []i64) {
	mut i = 0
	for cast(i64, v) != 0 && i < len(v) {
		if fh_depth == 0 {
			fh_next = 0
		}
		fh_stmt(v[i])
		i = i + 1
	}
}

// fh_stmt walks the statements fo_stmt knows. Anything else (defer, select, fail) is left as
// it is: a call there may run later than its arguments are made.
fn fh_stmt(s i64) {
	if s == 0 {
		return
	}
	let k = cast(Node, s).kind
	if k == ST_LET {
		fh_expr(cast(LetStmt, s).init)
		fh_let(cast(LetStmt, s))
	} else if k == ST_ASSIGN {
		fh_expr(cast(AssignStmt, s).target)
		fh_expr(cast(AssignStmt, s).value)
	} else if k == ST_EXPR {
		fh_expr(cast(ExprStmt, s).x)
	} else if k == ST_BLOCK {
		fh_stmts(cast(Block, s).stmts)
	} else if k == ST_IF {
		fh_expr(cast(IfStmt, s).cond)
		fh_stmt(cast(IfStmt, s).then)
		fh_stmt(cast(IfStmt, s).else_)
	} else if k == ST_WHILE {
		fh_expr(cast(WhileStmt, s).cond)
		fh_stmt(cast(WhileStmt, s).body)
		fh_stmt(cast(WhileStmt, s).post)
	} else if k == ST_RETURN {
		fh_expr(cast(ReturnStmt, s).value)
		let vals = cast(ReturnStmt, s).values
		mut j = 0
		for cast(i64, vals) != 0 && j < len(vals) {
			fh_expr(vals[j])
			j = j + 1
		}
	} else if k == ST_CALLMULTI {
		fh_expr(cast(CallMultiStmt, s).call)
	}
}

// fh_expr walks the expression kinds fo_expr knows; a function literal's body runs in its own
// frame, so it is not entered.
fn fh_expr(e i64) {
	if e == 0 {
		return
	}
	let k = cast(Node, e).kind
	if k == EX_MEM {
		fh_expr(cast(MemExpr, e).base)
		fh_expr(cast(MemExpr, e).index)
		fh_expr(cast(MemExpr, e).len)
	} else if k == EX_ELEM {
		fh_expr(cast(ElemExpr, e).seq)
		fh_expr(cast(ElemExpr, e).idx)
	} else if k == EX_INDEX {
		fh_expr(cast(IndexExpr, e).x)
		fh_expr(cast(IndexExpr, e).i)
	} else if k == EX_BINARY {
		fh_expr(cast(Binary, e).l)
		fh_expr(cast(Binary, e).r)
	} else if k == EX_UNARY {
		fh_expr(cast(Unary, e).x)
	} else if k == EX_CONV {
		fh_expr(cast(Conv, e).x)
	} else if k == EX_SEQ {
		fh_depth = fh_depth + 1
		fh_stmts(cast(SeqExpr, e).stmts)
		fh_expr(cast(SeqExpr, e).value)
		fh_depth = fh_depth - 1
	} else if k == EX_CALL {
		fh_expr(cast(Call, e).callee)
		let args = cast(Call, e).args
		mut i = 0
		for cast(i64, args) != 0 && i < len(args) {
			let a = args[i]
			fh_expr(a)
			if fh_is_sub(a) != 0 && fh_arg_reads(e, i) != 0 {
				let area = fh_arg_area()
				if area != 0 {
					fh_into(a, area)
				}
			}
			i = i + 1
		}
	}
}

// fh_is_sub reports a sub-slice: a call of rt_slice_sub, as chk_slice makes it.
fn fh_is_sub(e i64) i64 {
	return i64(e != 0 && cast(Node, e).kind == EX_CALL && cast(Call, e).callee == 0 && cast(Call, e).name == "rt_slice_sub" && len(cast(Call, e).args) == 5)
}

// fh_arg_reads reports whether call e only reads its argument i during the call: a direct call
// of a function whose summary keeps nothing of that parameter, or a runtime function that reads
// the header and lets it go.
fn fh_arg_reads(e i64, i i64) i64 {
	if cast(Call, e).callee != 0 || cast(Call, e).dyn_shape != 0 || cast(Call, e).intrinsic != 0 {
		return 0
	}
	let name = cast(Call, e).name
	if len(name) > 3 && str_prefix(name, "rt_") != 0 {
		return fh_rt_reads(name, i)
	}
	let f = cast(Fn, cast(Call, e).fn_)
	if cast(i64, f) == 0 || f.regsum == 0 {
		return 0
	}
	return i64(fo_param_escapes(f, i) == 0)
}

// fh_rt_reads reports a runtime function whose argument i is a slice it reads during the call
// and keeps nothing of: copy's two, append(s, x...)'s x, str(x), and a sub-slice's base.
fn fh_rt_reads(name str, i i64) i64 {
	if name == "rt_slice_copy" || name == "rt_slice_copy_rc" || name == "rt_slice_copy_dyn" {
		return i64(i == 0 || i == 1)
	}
	if name == "rt_slice_appendn" || name == "rt_slice_appendn_rc" || name == "rt_slice_appendn_dyn" {
		return i64(i == 1)
	}
	if name == "rt_str_from_bytes" || name == "rt_slice_sub" {
		return i64(i == 0)
	}
	if name == "rt_slice_sub_in" {
		return i64(i == 1)
	}
	return 0
}

// fh_arg_area is the next argument area of the statement being walked, made on first use, or 0
// when the function has made all it may.
fn fh_arg_area() i64 {
	if fh_next < len(fh_areas) {
		fh_next = fh_next + 1
		return fh_areas[fh_next - 1]
	}
	let area = fh_new_area()
	if area != 0 {
		fh_areas = append(fh_areas, area)
		fh_next = len(fh_areas)
	}
	return area
}

fn fh_new_area() i64 {
	if fh_count >= fh_max {
		return 0
	}
	if fh_ty == 0 {
		let t = cast(Ty, ty_new(K_STRUCT, "$slice"))
		t.value = 1
		t.size = 32
		t.fields = []i64{}
		fh_ty = cast(i64, t)
	}
	if fh_count == 0 && fh_areas_reached == 0 {
		mark_reach(find_fn("rt_slice_sub_in"))
		fh_areas_reached = 1
	}
	fh_count = fh_count + 1
	return ia_local_in(cast(Fn, fh_f), fh_ty)
}

shared mut fh_areas_reached i64

// fh_into makes sub-slice call e write its header into area.
fn fh_into(e i64, area i64) {
	let pos = cast(Node, e).pos
	let old = cast(Call, e).args
	mut args = []i64{}
	args = append(args, mk_conv(pos, sym_ref_node(pos, cast(Sym, area)), CV_SAME, ty_int))
	mut i = 0
	for i < len(old) {
		args = append(args, old[i])
		i = i + 1
	}
	let t = cast(Node, e).type_
	replace_node(e, rt_call(pos, "rt_slice_sub_in", cast(i64, args), t))
}

// fh_let puts the header of a sub-slice bound to a local in a frame area of its own when the
// local stays contained: only its elements, its length and capacity are used, and it goes
// only where an argument's header may.
fn fh_let(s LetStmt) {
	let sym = cast(Sym, s.sym)
	if sym.captured != 0 || kind_of(cast(Ty, sym.type_)) != K_SLICE || fh_is_sub(s.init) == 0 || fh_count >= fh_max {
		return
	}
	fo_fn = fh_f
	fo_sym = s.sym
	fo_ok = 1
	fo_hdr = 1
	fo_stmts(cast(Block, cast(Fn, fh_f).body).stmts)
	fo_hdr = 0
	if fo_ok == 0 {
		return
	}
	let area = fh_new_area()
	if area != 0 {
		fh_into(s.init, area)
	}
}
