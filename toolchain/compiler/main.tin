// tinc: the self-hosted Tin compiler.
// Usage: tinc [-o OUT] FILE.tin...   write a native executable (default a.out)
//        tinc -S FILE.tin...         print assembly instead
shared mut lib_root str = ""
shared mut project_root str
shared mut project_lock []u8
shared mut compiler_edition i64
shared mut load_unsafe i64 // the file being loaded is a vendored package granted unsafe: trusted, same edition
shared mut compiler_fix i64
shared mut tokens_dump i64 // -tokens: print every file's tokens instead of building (#392)
shared mut let_fix i64 // -fix-let: collect E711 declarations instead of reporting them (#526)
shared mut let_fix_decls []i64
shared mut compiler_parse_only i64 // -parse-only: like -fix, a library file reads trusted
shared mut check_only i64 // -check: lex, parse and check, write nothing (#393)
shared mut overlay_files []str // -overlay FILE=PATH: FILE is read from PATH
shared mut overlay_paths []str

// overlay_of is the path file's content is read from: the -overlay replacement when there is one.
fn overlay_of(path str) str {
	mut i = 0
	for i < len(overlay_files) {
		if overlay_files[i] == path {
			return overlay_paths[i]
		}
		i = i + 1
	}
	return path
}

// read_file returns a buffer holding the whole file, or 0 if it cannot be opened.
fn try_read_file(path str) i64 {
	let fd = rt_sys_open(rt_cstr(path), 0, 0)
	// open returns a C int: only the low 32 bits of x0 are defined.
	if (fd & 0x80000000) != 0 {
		return 0
	}
	let b = buf_new()
	for {
		buf_reserve(b, 65536)
		let n = rt_sys_read(fd, slice_data(b) + len(b), 65536)
		if n <= 0 {
			break
		}
		buf_extend(b, n)
	}
	rt_sys_close(fd)
	return cast(i64, b)
}

fn read_file(path str) []i64 {
	let b = try_read_file(path)
	if b == 0 {
		let e = cast([]i64, err_code(NO_POS, "E003 CANNOT_OPEN"))
		buf_str(cast([]u8, e), "cannot open ")
		buf_str(cast([]u8, e), path)
		fatal(cast([]u8, e))
	}
	return cast([]i64, b)
}

// os_suffix is the file-name suffix of the target's OS-specific library files.
fn os_suffix() str {
	if tgt_linux != 0 {
		return "_linux"
	}
	return "_darwin"
}

// arch_suffix is the file-name suffix of the target's CPU-specific library files.
fn arch_suffix() str {
	if tgt_x64 != 0 {
		return "_amd64"
	}
	return "_arm64"
}

// host_is_linux asks uname which kernel the compiler is running on.
fn host_is_linux() i64 {
	let u = calloc(1280, 1)
	rt_sys_uname(u)
	return i64(i64(load8(u)) == 'L')
}

// host_is_x64 asks uname whether a Linux host's CPU is x86-64 (machine is the fifth 65-byte field).
fn host_is_x64() i64 {
	let u = calloc(1280, 1)
	rt_sys_uname(u)
	return i64(i64(load8(u)) == 'L' && host_str(u + 4 * 65) == "x86_64")
}

// set_target parses darwin-arm64, linux-arm64 or linux-amd64.
fn set_target(t str) {
	if t == "darwin-arm64" {
		tgt_linux = 0
		tgt_x64 = 0
	} else if t == "linux-arm64" {
		tgt_linux = 1
		tgt_x64 = 0
	} else if t == "linux-amd64" {
		tgt_linux = 1
		tgt_x64 = 1
	} else {
		let e = cast([]i64, err_code(NO_POS, "E901 UNKNOWN_TARGET"))
		buf_str(cast([]u8, e), "unknown target ")
		buf_str(cast([]u8, e), t)
		buf_str(cast([]u8, e), " (darwin-arm64, linux-arm64, linux-amd64)")
		fatal(cast([]u8, e))
	}
}

fn usage() i64 {
	let u = buf_new()
	buf_str(u, "usage: tinc [-fix] [-polls] [-edition 0|1] [-parse-only] [-audit-secrets] [-caps] [-hash FILE...] [-tokens] [-S] [-o OUT] [-target darwin-arm64|linux-arm64|linux-amd64] FILE.tin...\n")
	write_all(2, cast([]u8, u))
	return 2
}

// token_kind_name is the name a token kind has in the -tokens dump (lex.tin's TK_ constants).
fn token_kind_name(kind i64) str {
	if kind == TK_IDENT {
		return "IDENT"
	} else if kind == TK_INT {
		return "INT"
	} else if kind == TK_FLOAT {
		return "FLOAT"
	} else if kind == TK_STRING {
		return "STRING"
	} else if kind == TK_KEYWORD {
		return "KEYWORD"
	} else if kind == TK_PUNCT {
		return "PUNCT"
	}
	return "EOF"
}

// buf_quoted writes s as a double-quoted literal, escaping the characters that would break a line.
fn buf_quoted(b []u8, s str) {
	buf_byte(b, '"')
	mut i = 0
	for i < len(s) {
		let c = i64(s[i])
		if c == '"' || c == '\\' {
			buf_byte(b, '\\')
			buf_byte(b, c)
		} else if c == '\n' {
			buf_str(b, "\\n")
		} else if c == '\r' {
			buf_str(b, "\\r")
		} else if c == '\t' {
			buf_str(b, "\\t")
		} else {
			buf_byte(b, c)
		}
		i = i + 1
	}
	buf_byte(b, '"')
}

// dump_tokens prints the tokens of every file, one per line as `file:line:col KIND "text"`, for the
// tools that read the lexer's output (tinc -tokens, #392). End-of-file is not printed; the flags are
// listed where they are written.
fn dump_tokens() i64 {
	let out = buf_new()
	mut f = 0
	for f < len(files) {
		let toks = cast([]Token, file_tokens[f])
		mut i = 0
		for i < len(toks) {
			let t = toks[i]
			if t.kind != TK_EOF {
				buf_pos(out, t.pos)
				buf_byte(out, ' ')
				buf_str(out, token_kind_name(t.kind))
				buf_byte(out, ' ')
				buf_quoted(out, t.text)
				// Flags, in this order: a unit suffix (200ms is INT "200" unit=ms); a raw string
				// (backquoted); a string whose text holds an escaped brace doubled (lex.tin, Token.dbl);
				// a ';' the lexer adds at a line end, which the source does not have (Token.synth).
				if len(t.unit) != 0 {
					buf_str(out, " unit=")
					buf_str(out, t.unit)
				}
				if t.raw != 0 {
					buf_str(out, " raw")
				}
				if t.dbl != 0 {
					buf_str(out, " escaped-brace")
				}
				if t.synth != 0 {
					buf_str(out, " synthetic")
				}
				buf_byte(out, '\n')
			}
			i = i + 1
		}
		f = f + 1
	}
	write_all(1, cast([]u8, out))
	return 0
}

// real_path is the canonical path of path as a compiler string, or 0 when it does not exist.
fn real_path(path str) str {
	let buf = calloc(4096, 1)
	if host_realpath(path, buf) == 0 {
		return ""
	}
	return host_str(buf)
}

// find_root locates the Tin tree (with lib/) from $TIN_ROOT or this executable's path.
fn find_root() str {
	let env = host_getenv("TIN_ROOT")
	if env != 0 {
		return host_str(env)
	}
	let raw = calloc(4096, 1)
	host_exe_path(raw, 4096)
	let real = real_path(host_str(raw))
	if len(real) == 0 {
		return "."
	}
	// .../bin/tinc -> ...
	mut cut = 0
	mut i = len(real) - 1
	for i > 0 && cut < 2 {
		if real[i] == '/' {
			cut = cut + 1
		}
		i = i - 1
	}
	return real[:i + 1]
}

// The library layouts. The source tree keeps the standard library in toolchain/std, the packages in
// packages/ and the runtime in toolchain/runtime; an installed copy keeps all of them in lib/ (the
// runtime in lib/runtime).
shared mut layout_tree i64 // 0 not looked at yet, 1 the installed layout, 2 the source tree

fn tree_layout() i64 {
	if layout_tree == 0 {
		layout_tree = 1
		let d = host_opendir(cat_path(find_root(), "/toolchain/runtime"))
		if d != 0 {
			rt_sys_closedir(d)
			layout_tree = 2
		}
	}
	return i64(layout_tree == 2)
}

// import_dirs are the directories under the root an import is looked up in after vendor/.
fn import_dirs() []str {
	mut d = []str{}
	if tree_layout() != 0 {
		d = append(d, "/toolchain/std/")
		d = append(d, "/packages/")
	} else {
		d = append(d, "/lib/")
	}
	return d
}

// lib_dirs are the directories under the root whose files are the library's: imports, packages and the
// runtime. They read trusted and are not pinned by tin.lock.
fn lib_dirs() []str {
	mut d = import_dirs()
	if tree_layout() != 0 {
		d = append(d, "/toolchain/runtime/")
	}
	return d
}

// runtime_dir is the directory of the runtime package under the root.
fn runtime_dir() str {
	if tree_layout() != 0 {
		return "/toolchain/runtime"
	}
	return "/lib/runtime"
}

// in_lib reports whether path (as the compiler names it) is a library file.
fn in_lib(path str) i64 {
	let d = lib_dirs()
	mut i = 0
	for i < len(d) {
		if starts_with(path, cat_path(lib_root, d[i])) != 0 {
			return 1
		}
		i = i + 1
	}
	return 0
}

// real_in_lib reports whether the file at path, resolved, is a library file of the tree find_root locates.
fn real_in_lib(path str) i64 {
	let d = lib_dirs()
	mut i = 0
	for i < len(d) {
		if path_in_root_dir(path, d[i]) != 0 {
			return 1
		}
		i = i + 1
	}
	return 0
}

fn load_file(path str) {
	// The compiler's own files (toolchain/compiler/, selfhost/ in an installed copy) and the tree's development tools (tools/)
	// use raw words and cast like the runtime does.
	// 2 marks the compiler's own files: their stores are not reference counted (rc_assign), the
	// compiler's records live as long as the process.
	mut trusted = (path_in_root_dir(path, "/selfhost/") | path_in_root_dir(path, "/toolchain/compiler/")) * 2
	if trusted == 0 {
		trusted = path_in_root_dir(path, "/tools/")
	}
	load_file_trusted(path, trusted)
}

// path_in_root_dir reports whether the file at path is under <root><dir>, the Tin tree that
// find_root locates (dir starts and ends with a slash).
fn path_in_root_dir(path str, dir str) i64 {
	let real = real_path(path)
	let root = real_path(find_root())
	if len(real) == 0 || len(root) == 0 {
		return 0
	}
	let prefix = cat_path(root, dir)
	let n = len(prefix)
	return i64(len(real) > n && real[:n] == prefix)
}

// Standard library files may use the runtime's raw memory operations.
fn load_file_trusted(path str, trusted_in i64) {
	mut trusted = trusted_in
	let text = str(cast([]u8, read_file(overlay_of(path))))
	files = append(files, path)
	file_trusted = append(file_trusted, trusted)
	file_cap_pkg = append(file_cap_pkg, cast(CapsRec, 0))
	cur_file = len(files) - 1
	mut edition = compiler_edition
	if edition < 0 {
		// no -edition flag: the file says which edition it is written in
		edition = source_edition(text)
	}
	if compiler_fix != 0 {
		edition = 0
		if fix_source_is_edition1(text) != 0 || source_edition(text) != 0 {
			edition = 1
		}
	}
	if (compiler_fix != 0 || compiler_parse_only != 0) && trusted == 0 && fix_in_lib(path) != 0 {
		trusted = 1
		file_trusted[cur_file] = 1
	}
	if trusted != 0 && load_unsafe == 0 {
		// a standard library file is read in the edition it is written in (#226)
		edition = source_edition(text)
	}
	if edition == 0 && compiler_fix == 0 {
		// edition 0 is retired (#226): only tin fix reads it. The message points at the token
		// that decided it (#646).
		source_edition(text)
		let e = cast([]i64, err_code(offset_pos(cur_file, text, edition0_at), "E090 OLD_SYNTAX"))
		buf_str(cast([]u8, e), path)
		buf_str(cast([]u8, e), " is edition 0 (")
		if edition0_at + 1 < len(text) && text[edition0_at] == ':' {
			buf_str(cast([]u8, e), "':='")
		} else if text[edition0_at] == 'f' {
			buf_str(cast([]u8, e), "a 'func' declaration")
		} else {
			buf_str(cast([]u8, e), "a 'var' declaration")
		}
		buf_str(cast([]u8, e), " here), which is retired: translate it with tin fix -edition 1")
		fatal(cast([]u8, e))
	}
	let toks = lex(cur_file, text, edition)
	file_sources = append(file_sources, text)
	json_sources = append(json_sources, text)
	file_tokens = append(file_tokens, toks)
	if edition == 1 {
		parse_edition1(cast([]i64, toks))
	} else {
		parse(cast([]i64, toks))
	}
}

// fix_in_lib reports a standard library file (under <root>/lib/): -fix reads it trusted, as an
// import loads it, so its edition 0 secret types parse.
fn fix_in_lib(path str) i64 {
	return real_in_lib(path)
}

fn is_loaded(path str) i64 {
	mut i = 0
	for i < len(files) {
		if files[i] == path {
			return 1
		}
		i = i + 1
	}
	return 0
}

fn cat_path(a str, b str) str {
	let p = buf_new()
	buf_str(p, a)
	buf_str(p, b)
	return str(p)
}

// dir_of is the directory part of a file path ("." when there is none).
fn dir_of(path str) str {
	let n = len(path)
	mut i = n - 1
	for i >= 0 && i64(path[i]) != '/' {
		i = i - 1
	}
	if i < 0 {
		return "."
	}
	let b = buf_new()
	mut j = 0
	for j < i {
		buf_byte(b, i64(path[j]))
		j = j + 1
	}
	return str(b)
}

fn ends_with(s str, suffix str) i64 {
	return i64(len(s) >= len(suffix) && s[len(s) - len(suffix):] == suffix)
}

// package_files returns the files of the package at base: base.tin, or every .tin file in
// the directory base (tests excluded), sorted; 0 if neither exists.
fn package_files(base str) i64 {
	let single = cat_path(base, ".tin")
	let probe = try_read_file(single)
	if probe != 0 {
		mut one = []str{}
		one = append(one, single)
		// name_linux.tin / name_darwin.tin: the target OS's part of the package.
		let osf = cat_path(cat_path(base, os_suffix()), ".tin")
		if try_read_file(osf) != 0 {
			one = append(one, osf)
		}
		// name_linux_amd64.tin: the part that depends on the CPU too (struct layouts).
		let archf = cat_path(cat_path(cat_path(base, os_suffix()), arch_suffix()), ".tin")
		if try_read_file(archf) != 0 {
			one = append(one, archf)
		}
		return cast(i64, one)
	}
	let d = host_opendir(base)
	if d == 0 {
		return 0
	}
	mut out = []str{}
	for {
		let ent = rt_sys_readdir(d)
		if ent == 0 {
			break
		}
		let dname = host_dirent_name(ent)
		let name = host_str(dname)
		if ends_with(name, ".tin") != 0 && ends_with(name, "_test.tin") == 0 && i64(byte_at(name, 0)) != '.' && other_os_file(name) == 0 {
			out = append(out, cat_path(cat_path(base, "/"), name))
		}
	}
	rt_sys_closedir(d)
	// Sorted, so builds do not depend on directory order.
	mut i = 1
	for i < len(out) {
		mut j = i
		for j > 0 && out[j - 1] > out[j] {
			let t = out[j]
			out[j] = out[j - 1]
			out[j - 1] = t
			j = j - 1
		}
		i = i + 1
	}
	if len(out) == 0 {
		return 0
	}
	return cast(i64, out)
}

// resolve_import finds an import's files: ./x and ../x next to the importing file,
// otherwise the standard library, then the main program's directory.
fn resolve_import(ipath str, from str) i64 {
	if i64(byte_at(ipath, 0)) == '.' {
		return package_files(cat_path(cat_path(dir_of(from), "/"), ipath))
	}
	// A path import (github.com/ana/geo) is read from vendor/ only: never lib/ or the network.
	if remote_path(ipath) != 0 {
		return package_files(cat_path(vendor_dir(), ipath))
	}
	let vendored = package_files(cat_path(vendor_dir(), ipath))
	if vendored != 0 {
		return vendored
	}
	let dirs = import_dirs()
	mut di = 0
	for di < len(dirs) {
		let std = package_files(cat_path(cat_path(lib_root, dirs[di]), ipath))
		if std != 0 {
			return std
		}
		di = di + 1
	}
	return package_files(cat_path(cat_path(dir_of(files[0]), "/"), ipath))
}

// vendor_dir is the project's vendor/ directory, with a trailing slash ("vendor/" when the
// program is in the current directory, so paths in messages do not start with ./).
fn vendor_dir() str {
	if project_root == "." {
		return "vendor/"
	}
	return cat_path(project_root, "/vendor/")
}

// remote_path reports whether an import path names a package by where it comes from: its
// first element contains a dot ("github.com/ana/geo", toolchain/docs/PACKAGES.md).
fn remote_path(ipath str) i64 {
	mut i = 0
	for i < len(ipath) && i64(ipath[i]) != '/' {
		if i64(ipath[i]) == '.' {
			return i64(i > 0)
		}
		i = i + 1
	}
	return 0
}

shared mut pkg_homes []i64 // [package name, real path of its first file, import path] per resolved import

// check_pkg_home rejects two import paths that load different packages under one name: they
// would merge into one package.
fn check_pkg_home(ipath str, found []str) {
	let name = path_pkg(ipath)
	let rbuf = calloc(4096, 1)
	if host_realpath(found[0], rbuf) == 0 {
		return
	}
	let real = host_str(rbuf)
	mut i = 0
	for i < len(pkg_homes) {
		let h = cast([]str, pkg_homes[i])
		if h[0] == name {
			if h[1] != real {
				let e = cast([]i64, err_code(NO_POS, "E113 PACKAGE_CONFLICT"))
				buf_str(cast([]u8, e), "import paths \"")
				buf_str(cast([]u8, e), h[2])
				buf_str(cast([]u8, e), "\" and \"")
				buf_str(cast([]u8, e), ipath)
				buf_str(cast([]u8, e), "\" are different packages with the same name ")
				buf_str(cast([]u8, e), name)
				fatal(cast([]u8, e))
			}
			return
		}
		i = i + 1
	}
	mut rec = []str{}
	rec = append(rec, name)
	rec = append(rec, real)
	rec = append(rec, ipath)
	pkg_homes = append(pkg_homes, cast(i64, rec))
}

// load_imports parses every package any loaded file imports, transitively.
fn load_imports() {
	pkg_homes = []i64{}
	mut f = 0
	for f < len(files) {
		let imps = file_imports[f]
		mut i = 0
		for i < len(imps) {
			let ipath = imps[i].path
			let found = cast([]str, resolve_import(ipath, files[f]))
			if cast(i64, found) == 0 && remote_path(ipath) != 0 {
				let e = cast([]i64, err_code(NO_POS, "E112 NOT_VENDORED"))
				buf_str(cast([]u8, e), "package \"")
				buf_str(cast([]u8, e), ipath)
				buf_str(cast([]u8, e), "\" is not vendored: there is no vendor/")
				buf_str(cast([]u8, e), ipath)
				buf_str(cast([]u8, e), " in the program's directory (tin vendor copies it there; the build never fetches)")
				fatal(cast([]u8, e))
			}
			if cast(i64, found) == 0 {
				let e = cast([]i64, err_code(NO_POS, "E110 UNKNOWN_PACKAGE"))
				buf_str(cast([]u8, e), "unknown package \"")
				buf_str(cast([]u8, e), ipath)
				buf_str(cast([]u8, e), "\" (looked in the standard library, next to the importing file and in the program's directory)")
				fatal(cast([]u8, e))
			}
			check_pkg_home(ipath, found)
			// A vendored package is restricted to its manifest's capabilities; a package a
			// vendored file imports relatively is part of the same package.
			mut cpkg = cast(CapsRec, vendored_package(ipath, found))
			if cast(i64, cpkg) == 0 && i64(byte_at(ipath, 0)) == '.' {
				cpkg = file_cap_pkg[f]
			}
			mut k = 0
			for k < len(found) {
				let path = found[k]
				if is_loaded(path) == 0 {
					let std = in_lib(path)
					// A changed dependency is reported by its hash before it is parsed.
					if std == 0 {
						lock_has(path)
					}
					// Only the standard library (and a package granted unsafe) may use the raw operations.
					load_unsafe = i64(std == 0 && cast(i64, cpkg) != 0 && (cpkg.caps & CAP_UNSAFE) != 0)
					load_file_trusted(path, i64(std != 0 || load_unsafe != 0))
					load_unsafe = 0
					file_cap_pkg[len(files) - 1] = cast(CapsRec, cpkg)
				}
				k = k + 1
			}
			i = i + 1
		}
		f = f + 1
	}
}

// other_os_file reports whether a file belongs to the other OS (x_linux.tin on macOS).
fn other_os_file(name str) i64 {
	if tgt_linux != 0 {
		return i64(ends_with(name, "_darwin.tin") != 0 || ends_with(name, other_arch_suffix()) != 0)
	}
	return i64(ends_with(name, "_linux.tin") != 0 || ends_with(name, "_linux_arm64.tin") != 0 || ends_with(name, "_linux_amd64.tin") != 0)
}

fn other_arch_suffix() str {
	if tgt_x64 != 0 {
		return "_arm64.tin"
	}
	return "_amd64.tin"
}

// c_positive reports whether a C int result (low 32 bits) is above zero.
fn c_positive(r i64) i64 {
	let w = r & 0xffffffff
	return i64(w != 0 && (w & 0x80000000) == 0)
}

fn starts_with(s str, prefix str) i64 {
	return i64(len(s) >= len(prefix) && s[:len(prefix)] == prefix)
}

fn bytes_equal(a i64, b str, n i64) i64 {
	mut i = 0
	for i < n {
		if i64(load8(a + i)) != i64(b[i]) {
			return 0
		}
		i = i + 1
	}
	return 1
}

fn hex_nibble(v i64) i64 {
	if v < 10 {
		return '0' + v
	}
	return 'a' + v - 10
}

fn digest_hex(d i64) str {
	let out = buf_new()
	mut i = 0
	for i < 32 {
		let v = i64(load8(d + i))
		buf_byte(out, hex_nibble(v >> 4))
		buf_byte(out, hex_nibble(v & 15))
		i = i + 1
	}
	return str(out)
}

// lock_entry returns the hash tin.lock records for a project-relative path (a C string of
// 64 hex digits), or 0 when the lock has no line for it.
fn lock_entry(rel str) str {
	let data = slice_data(project_lock)
	let n = len(project_lock)
	let m = len(rel)
	mut i = 0
	for i < n {
		mut end = i
		for end < n && i64(load8(data + end)) != '\n' {
			end = end + 1
		}
		// <64 hex> <path>: the path runs to the end of the line.
		if end - i == 65 + m && i64(load8(data + i + 64)) == ' ' && bytes_equal(data + i + 65, rel, m) != 0 {
			let h = buf_new()
			mut j = 0
			for j < 64 {
				buf_byte(h, i64(load8(data + i + j)))
				j = j + 1
			}
			return str(h)
		}
		i = end + 1
	}
	return ""
}

// lock_has checks a loaded file against tin.lock: a vendored file must be listed with its
// hash, and any other file the lock lists must still have the recorded hash.
fn lock_has(path str) i64 {
	if cast(i64, project_lock) == 0 {
		return 1
	}
	mut rel = path
	let plen = len(project_root)
	if starts_with(path, project_root) != 0 && byte_at(path, plen) == '/' {
		rel = path[plen + 1:]
	}
	for starts_with(rel, "./") != 0 {
		rel = rel[2:]
	}
	let src = cast([]u8, read_file(path))
	let digest = calloc(32, 1)
	sha256(slice_data(src), len(src), digest)
	let hex = digest_hex(digest)
	let want = lock_entry(rel)
	if len(want) != 0 && want == hex {
		return 1
	}
	if len(want) == 0 && starts_with(rel, "vendor/") == 0 {
		return 1
	}
	let e = cast([]i64, err_code(NO_POS, "E111 LOCK_MISMATCH"))
	if len(want) != 0 {
		buf_str(cast([]u8, e), "tin.lock hash mismatch for ")
		buf_str(cast([]u8, e), rel)
		buf_str(cast([]u8, e), ": the lock records sha256 ")
		buf_str(cast([]u8, e), want)
		buf_str(cast([]u8, e), ", the file has ")
		buf_str(cast([]u8, e), hex)
	} else {
		buf_str(cast([]u8, e), "tin.lock has no entry for ")
		buf_str(cast([]u8, e), rel)
		buf_str(cast([]u8, e), " (sha256 ")
		buf_str(cast([]u8, e), hex)
		buf_str(cast([]u8, e), "); every vendored file must be locked")
	}
	fatal(cast([]u8, e))
	return 0
}

fn verify_lock() {
	if cast(i64, project_lock) == 0 {
		return
	}
	mut i = 0
	for i < len(files) {
		let path = files[i]
		if in_lib(path) == 0 {
			lock_has(path)
		}
		i = i + 1
	}
}

// print_hashes prints "<sha256> <path>" for each file, the lines tin vendor writes to tin.lock.
fn print_hashes(argc i64, av []str) i64 {
	let out = buf_new()
	mut i = 2
	for i < argc {
		let src = cast([]u8, read_file(av[i]))
		let digest = calloc(32, 1)
		sha256(slice_data(src), len(src), digest)
		buf_str(out, digest_hex(digest))
		buf_byte(out, ' ')
		buf_str(out, av[i])
		buf_byte(out, '\n')
		i = i + 1
	}
	write_all(1, cast([]u8, out))
	return 0
}

fn compiler_main(argc i64, argv i64) i64 {
	host_start(argc, argv)
	// The arguments are the operating system's C strings: copy them into strings of the compiler's kind.
	mut av = []str{}
	mut ai = 0
	for ai < argc {
		av = append(av, host_str(argv[ai]))
		ai = ai + 1
	}
	if argc > 1 && av[1] == "-hash" {
		return print_hashes(argc, av)
	}
	files = []str{}
	json_sources = []str{}
	overlay_files = []str{}
	overlay_paths = []str{}
	file_trusted = []i64{}
	file_cap_pkg = cast([]CapsRec, []i64{})
	cap_pkgs = cast([]CapsRec, []i64{})
	parse_setup()
	types_init()
	mut asm_only = 0
	mut parse_only = 0
	mut audit_secrets = 0
	mut fix_edition1 = 0
	compiler_edition = -1
	compiler_polls = 0
	polls_auto = 1
	let polls_env = host_getenv("TINC_POLLS")
	if polls_env != 0 && i64(load8(polls_env)) == '1' {
		compiler_polls = 1
	}
	if polls_env != 0 && i64(load8(polls_env)) == '0' {
		polls_auto = 0
	}
	// Integer overflow checks (#362): TINC_OVERFLOW=0 turns them off, 1 checks user code only,
	// 2 also library packages, 3 also the runtime and the compiler (for measurements).
	compiler_overflow = 2
	let ovf_env = host_getenv("TINC_OVERFLOW")
	if ovf_env != 0 && i64(load8(ovf_env)) >= '0' && i64(load8(ovf_env)) <= '3' {
		compiler_overflow = i64(load8(ovf_env)) - '0'
	}
	mut out_path = "a.out"
	tgt_linux = host_is_linux()
	tgt_x64 = host_is_x64()
	mut i = 1
	for i < argc {
		let a = av[i]
		if a == "-target" && i + 1 < argc {
			i = i + 1
			set_target(av[i])
		} else if a == "-edition" && i + 1 < argc {
			i = i + 1
			if av[i] == "0" {
				compiler_edition = 0
			} else if av[i] == "1" {
				compiler_edition = 1
			} else {
				let e = cast([]i64, err_code(NO_POS, "E902 UNKNOWN_EDITION"))
				buf_str(cast([]u8, e), "unknown edition ")
				buf_str(cast([]u8, e), av[i])
				buf_str(cast([]u8, e), " (expected 0 or 1)")
				fatal(cast([]u8, e))
			}
		} else if a == "-polls" {
			compiler_polls = 1
		} else if a == "-nopolls" {
			// no safepoints, even in a program that starts cores (#341)
			polls_auto = 0
		} else if a == "-parse-only" {
			parse_only = 1
			compiler_parse_only = 1
		} else if a == "-caps" {
			// tin caps: check the program, then print the capabilities each package can reach.
			caps_report = 1
		} else if a == "-audit-secrets" {
			// tin audit secrets: check the program, then list every place a secret leaves.
			audit_secrets = 1
		} else if a == "-fix" {
			fix_edition1 = 1
			compiler_fix = 1
		} else if a == "-fix-let" {
			// tin fix: check the program, then print its first file with every let that is
			// reassigned (E711) declared mut instead (#526).
			let_fix = 1
		} else if a == "-entry" && i + 1 < argc {
			// -entry pkg.Name: start the program at that function instead of main (tin test).
			i = i + 1
			entry_name = av[i]
		} else if a == "-strip" {
			// -strip: a Linux executable without section headers and symbol table (#351)
			link_strip = 1
		} else if a == "-check" {
			check_only = 1
		} else if a == "-json" {
			json_diag = 1
		} else if a == "-overlay" && i + 1 < argc {
			// -overlay FILE=PATH: check the text in PATH as FILE (an editor's unsaved buffer)
			i = i + 1
			let eq = json_index(av[i], "=", 0)
			if eq > 0 {
				overlay_files = append(overlay_files, av[i][:eq])
				overlay_paths = append(overlay_paths, av[i][eq + 1:])
			}
		} else if a == "-tokens" {
			tokens_dump = 1
		} else if a == "-S" {
			asm_only = 1
		} else if a == "-o" && i + 1 < argc {
			i = i + 1
			out_path = av[i]
		} else {
			load_file(a)
		}
		i = i + 1
	}
	if len(files) == 0 {
		return usage()
	}
	if tokens_dump != 0 {
		return dump_tokens()
	}
	if fix_edition1 != 0 {
		if compiler_edition != 1 || len(files) != 1 {
			let e = cast([]i64, err_code(NO_POS, "E906 FIX_USAGE"))
			buf_str(cast([]u8, e), "-fix translates one file to edition 1: pass -edition 1 and exactly one file")
			fatal(cast([]u8, e))
		}
		let source = file_sources[0]
		let toks = cast([]i64, file_tokens[0])
		fx_trusted = file_trusted[0]
		fx_path = files[0]
		let rewritten = cast([]i64, print_edition1(0, source, cast([]Token, toks)))
		write_all(1, cast([]u8, rewritten))
		return 0
	}
	if parse_only != 0 {
		return 0
	}
	lib_root = find_root()
	project_root = dir_of(files[0])
	project_lock = cast([]u8, cast([]i64, try_read_file(cat_path(project_root, "/tin.lock"))))
	// The runtime is a package (toolchain/runtime in the source tree, lib/runtime in an installed copy): every file of it for this OS and CPU.
	let rtfiles = cast([]str, package_files(cat_path(lib_root, runtime_dir())))
	if cast(i64, rtfiles) == 0 {
		let e = cast([]i64, err_code(NO_POS, "E903 NO_RUNTIME"))
		buf_str(cast([]u8, e), "the runtime package is missing: no runtime in ")
		buf_str(cast([]u8, e), lib_root)
		fatal(cast([]u8, e))
	}
	mut rk = 0
	for rk < len(rtfiles) {
		let rpath = rtfiles[rk]
		if is_loaded(rpath) == 0 {
			load_file_trusted(rpath, 1)
		}
		rk = rk + 1
	}
	load_imports()
	verify_lock()
	check()
	if error_count > 0 {
		return 1
	}
	check_capabilities()
	if error_count > 0 {
		return 1
	}
	if caps_report != 0 {
		print_capabilities()
		return 0
	}
	if audit_secrets != 0 {
		secret_audit_print()
		return 0
	}
	if let_fix != 0 {
		write_all(1, let_fix_source())
		return 0
	}
	core_global_check()
	if error_count > 0 {
		return 1
	}
	region_check()
	if error_count > 0 {
		return 1
	}
	// Loops whose iterations keep nothing they make give it back each time (#633).
	loop_pools()
	// Struct literals that never leave their function live in its frame (#633).
	frame_objects()
	rc_mark()
	if error_count > 0 {
		return 1
	}
	if check_only != 0 {
		return 0
	}
	generate()
	if error_count > 0 {
		return 1
	}
	if asm_only != 0 && tgt_x64 != 0 {
		write_all(1, cast([]u8, cast([]i64, print_asm_x64())))
	} else if asm_only != 0 {
		write_all(1, cast([]u8, cast([]i64, print_asm())))
	} else if tgt_x64 != 0 {
		write_elf_x64(out_path)
	} else if tgt_linux != 0 {
		write_elf(out_path)
	} else {
		write_executable(out_path)
	}
	return 0
}

// source_has_word reports whether the word appears in src outside comments and strings.
fn source_has_word(src str, word str) i64 {
	let n = len(src)
	let wn = len(word)
	mut i = 0
	for i < n {
		let c = i64(src[i])
		if c == '/' && i + 1 < n && i64(src[i + 1]) == '/' {
			for i < n && i64(src[i]) != '\n' {
				i = i + 1
			}
		} else if c == '/' && i + 1 < n && i64(src[i + 1]) == '*' {
			i = i + 2
			for i + 1 < n && !(i64(src[i]) == '*' && i64(src[i + 1]) == '/') {
				i = i + 1
			}
			i = i + 2
		} else if c == '"' || c == '`' || c == '\'' {
			let quote = c
			i = i + 1
			for i < n && i64(src[i]) != quote {
				if quote != '`' && i64(src[i]) == '\\' && i + 1 < n {
					i = i + 1
				}
				i = i + 1
			}
			i = i + 1
		} else if is_letter(c) != 0 {
			let start = i
			for i < n && (is_letter(i64(src[i])) != 0 || is_digit(i64(src[i])) != 0) {
				i = i + 1
			}
			if i - start == wn && src[start:start + wn] == word {
				return 1
			}
		} else {
			i = i + 1
		}
	}
	return 0
}

shared mut edition0_at i64 // the byte offset of what made source_edition answer 0 (#646)

// source_edition is 1 for a file written in edition 1. Outside comments and strings, the first
// of these decides: `fn` at the start of a line (edition 1), or `func` or `var` at the start of
// a line or `:=` (edition 0, which always has one of them). A `;` alone does not decide (#646):
// in an edition-1 file the lexer reports it with its position. A file of only constants and
// types reads the same in both. When the answer is 0, edition0_at is the offset of the deciding
// token.
fn source_edition(src str) i64 {
	let n = len(src)
	mut i = 0
	for i < n {
		let c = i64(src[i])
		if c == '/' && i + 1 < n && i64(src[i + 1]) == '/' {
			for i < n && i64(src[i]) != '\n' {
				i = i + 1
			}
		} else if c == '/' && i + 1 < n && i64(src[i + 1]) == '*' {
			i = i + 2
			for i + 1 < n && !(i64(src[i]) == '*' && i64(src[i + 1]) == '/') {
				i = i + 1
			}
			i = i + 2
		} else if c == '"' || c == '`' || c == '\'' {
			let quote = c
			i = i + 1
			for i < n && i64(src[i]) != quote {
				if quote != '`' && i64(src[i]) == '\\' && i + 1 < n {
					i = i + 1
				}
				i = i + 1
			}
			i = i + 1
		} else if c == ':' && i + 1 < n && i64(src[i + 1]) == '=' {
			edition0_at = i
			return 0
		} else if is_letter(c) != 0 {
			let start = i
			for i < n && (is_letter(i64(src[i])) != 0 || is_digit(i64(src[i])) != 0) {
				i = i + 1
			}
			let len_ = i - start
			let line_start = i64(start == 0 || i64(src[start - 1]) == '\n')
			if line_start != 0 && ((len_ == 4 && src[start:start + 4] == "func") || (len_ == 3 && src[start:start + 3] == "var")) {
				edition0_at = start
				return 0
			}
			if line_start != 0 && len_ == 2 && src[start:start + 2] == "fn" {
				// An edition-1 declaration first: what follows is edition 1 with errors that the
				// lexer and parser report where they are.
				return 1
			}
		} else {
			i = i + 1
		}
	}
	return 1
}

// offset_pos is the position (file, line, column) of byte offset off in src.
fn offset_pos(file i64, src str, off i64) i64 {
	mut line = 1
	mut col = 1
	mut i = 0
	for i < off && i < len(src) {
		if src[i] == '\n' {
			line = line + 1
			col = 1
		} else {
			col = col + 1
		}
		i = i + 1
	}
	return (file << 48) | (line << 16) | col
}

// let_fix_source is the first file's source with the let of every declaration E711 found
// written mut (-fix-let, #526): a local's position is its let, a global's is its name.
fn let_fix_source() []u8 {
	let src = file_sources[0]
	let n = len(src)
	mut offs = []i64{}
	mut i = 0
	for i < len(let_fix_decls) {
		let pos = let_fix_decls[i]
		i = i + 1
		if pos >> 48 != 0 {
			continue
		}
		let line = (pos >> 16) & 0xffffffff
		let col = pos & 0xffff
		mut off = 0
		mut l = 1
		for off < n && l < line {
			if src[off] == '\n' {
				l = l + 1
			}
			off = off + 1
		}
		off = off + col - 1
		mut k = off
		for k >= 0 && !(k + 3 <= n && src[k:k + 3] == "let" && (k + 3 == n || src[k + 3] == ' ' || src[k + 3] == '(')) {
			if k < n && src[k] == '\n' {
				k = -1
				break
			}
			k = k - 1
		}
		if k >= 0 {
			offs = append(offs, k)
		}
	}
	let out = buf_new()
	mut p = 0
	for p < n {
		mut hit = 0
		mut j = 0
		for j < len(offs) {
			if offs[j] == p {
				hit = 1
			}
			j = j + 1
		}
		if hit != 0 {
			buf_str(out, "mut")
			p = p + 3
		} else {
			buf_byte(out, i64(src[p]))
			p = p + 1
		}
	}
	return cast([]u8, out)
}

// fix_source_is_edition1 recognizes translated package files so repeated runs are a no-op.
fn fix_source_is_edition1(src str) i64 {
	let n = len(src)
	mut saw_package = 0
	mut saw_function = 0
	mut i = 0
	for i < n {
		let c = i64(src[i])
		if c == '/' && i + 1 < n && i64(src[i + 1]) == '/' {
			for i < n && i64(src[i]) != '\n' {
				i = i + 1
			}
		} else if c == '/' && i + 1 < n && i64(src[i + 1]) == '*' {
			i = i + 2
			for i + 1 < n && !(i64(src[i]) == '*' && i64(src[i + 1]) == '/') {
				i = i + 1
			}
			i = i + 2
		} else if c == '"' || c == '`' || c == '\'' {
			let quote = c
			i = i + 1
			for i < n && i64(src[i]) != quote {
				if quote == '"' && i64(src[i]) == '\\' && i + 1 < n {
					i = i + 1
				}
				i = i + 1
			}
			i = i + 1
		} else if is_letter(c) != 0 {
			let start = i
			for i < n && (is_letter(i64(src[i])) != 0 || is_digit(i64(src[i])) != 0) {
				i = i + 1
			}
			let len_ = i - start
			if len_ == 7 && src[start:start + 7] == "package" {
				saw_package = 1
			}
			if len_ == 2 && src[start:start + 2] == "fn" {
				saw_function = 1
			}
		} else {
			i = i + 1
		}
	}
	return i64(saw_package != 0 && saw_function != 0)
}
