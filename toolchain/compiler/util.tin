// str_has_at reports whether hay holds needle at offset off.
fn str_has_at(hay str, off i64, needle str) bool {
	if off + len(needle) > len(hay) {
		return false
	}
	mut k = 0
	for k < len(needle) {
		if hay[off + k] != needle[k] {
			return false
		}
		k = k + 1
	}
	return true
}

// byte_at is byte i of s, or 0 past its end (the NUL a C string ended with).
fn byte_at(s str, i i64) i64 {
	if i < len(s) {
		return i64(s[i])
	}
	return 0
}

// or_empty is s, or the empty string when it is nil.
fn or_empty(s ?str) str {
	if let v = s {
		return v
	}
	return ""
}

// Data structures for the self-hosted compiler: word vectors, byte buffers, positions, errors.
// Vectors and buffers share one header layout; vectors count words, buffers count bytes.

// slice_truncate shortens (or, up to its capacity, lengthens) v in place: every holder of the slice sees it.
fn slice_truncate[T Any](v []T, n i64) {
	cast(SliceHdr, v).len = n
}

// slice_data is the address of v's first element.
fn slice_data[T Any](v []T) i64 {
	return cast(SliceHdr, v).data
}

// slice_filled is a slice of n copies of x.
fn slice_filled[T Any](n i64, x T) []T {
	mut v = []T{}
	mut i = 0
	for i < n {
		v = append(v, x)
		i = i + 1
	}
	return v
}

// slice_clone is a copy of v (an empty slice for a nil one).
fn slice_clone[T Any](v []T) []T {
	mut out = []T{}
	if cast(i64, v) == 0 {
		return out
	}
	mut i = 0
	for i < len(v) {
		out = append(out, v[i])
		i = i + 1
	}
	return out
}

// Byte buffers are []u8 slices: appending grows the shared header in place, so a buffer passed to
// a helper grows for its caller too.
fn buf_new() []u8 {
	return make([]u8, 0, 256)
}

// buf_reserve makes room for n more bytes at the end of b (buf_extend then counts the ones a system call wrote).
fn buf_reserve(b []u8, n i64) {
	if len(b) + n > cap(b) {
		let h = cast(SliceHdr, b)
		let grown = make([]u8, len(b), 2 * cap(b) + n)
		copy(grown, b)
		h.cap = cap(grown)
		h.data = slice_data(grown)
	}
}

fn buf_extend(b []u8, n i64) {
	cast(SliceHdr, b).len = len(b) + n
}

fn buf_byte(b []u8, c i64) {
	b = append(b, u8(c))
}

fn buf_bytes(b []u8, s i64, n i64) {
	mut i = 0
	for i < n {
		b = append(b, load8(s + i))
		i = i + 1
	}
}

fn buf_str(b []u8, s str) {
	buf_bytes(b, rt_cstr(s), len(s))
}

fn buf_int(b []u8, n i64) {
	if n < 0 {
		buf_byte(b, '-')
		if n / 10 != 0 {
			buf_int(b, -(n / 10))
		}
		buf_byte(b, '0' - n % 10)
		return
	}
	if n >= 10 {
		buf_int(b, n / 10)
	}
	buf_byte(b, '0' + n % 10)
}

fn write_all(fd i64, b []u8) {
	mut done = 0
	for done < len(b) {
		let n = rt_sys_write(fd, slice_data(b) + done, len(b) - done)
		if n <= 0 {
			rt_sys_exit(1)
		}
		done = done + n
	}
}

// A position packs file index, line and column into one word.
const NO_POS = -1

shared mut files []str
shared mut tgt_linux i64 // the target OS is Linux (else macOS)
shared mut tgt_x64 i64 // the target CPU is x86-64 (else arm64)
shared mut error_count i64
shared mut json_diag i64 // -json: errors print as one JSON object per line on standard output (#393)

fn pos_make(file i64, line i64, col i64) i64 {
	return (file << 48) | (line << 16) | col
}

fn buf_pos(b []u8, pos i64) {
	buf_str(b, files[pos >> 48])
	buf_byte(b, ':')
	buf_int(b, (pos >> 16) & 0xffffffff)
	buf_byte(b, ':')
	buf_int(b, pos & 0xffff)
}

fn err_end(b []u8) {
	if json_diag != 0 {
		json_error(b)
		return
	}
	buf_byte(b, '\n')
	write_all(2, cast([]u8, b))
	error_count = error_count + 1
}

// json_quote appends s as a JSON string.
fn json_quote(b []u8, s str) {
	buf_byte(b, '"')
	mut i = 0
	for i < len(s) {
		let c = i64(s[i])
		if c == '"' || c == '\\' {
			buf_byte(b, '\\')
			buf_byte(b, c)
		} else if c == '\n' {
			buf_str(b, "\\n")
		} else if c == '\t' {
			buf_str(b, "\\t")
		} else if c < 32 {
			buf_str(b, "\\u00")
			buf_byte(b, i64("0123456789abcdef"[c >> 4]))
			buf_byte(b, i64("0123456789abcdef"[c & 15]))
		} else {
			buf_byte(b, c)
		}
		i = i + 1
	}
	buf_byte(b, '"')
}

// json_index is where sub first occurs in s at or after from (-1 when it does not).
fn json_index(s str, sub str, from i64) i64 {
	mut i = from
	for i + len(sub) <= len(s) {
		if s[i:i + len(sub)] == sub {
			return i
		}
		i = i + 1
	}
	return -1
}

// json_number is the decimal number at the start of s (-1 when s does not start with a digit).
fn json_number(s str) i64 {
	mut n = 0
	mut i = 0
	for i < len(s) && s[i] >= '0' && s[i] <= '9' {
		n = n * 10 + (i64(s[i]) - '0')
		i = i + 1
	}
	if i == 0 {
		return -1
	}
	return n
}

// json_token_end is the column just past the token that starts at (line, col) of file's source: an identifier or
// number run, a string or rune literal on the line, a comment's line, or one character.
fn json_token_end(file i64, line i64, col i64) i64 {
	if file < 0 || file >= len(file_sources) {
		return col + 1
	}
	let src = file_sources[file]
	mut at = 0
	mut l = 1
	for l < line && at < len(src) {
		if src[at] == '\n' {
			l = l + 1
		}
		at = at + 1
	}
	let start = at + col - 1
	if start >= len(src) || start < 0 || src[start] == '\n' {
		return col + 1
	}
	let c = i64(src[start])
	mut end = start + 1
	if c == '"' || c == '\'' {
		for end < len(src) && src[end] != '\n' && i64(src[end]) != c {
			if src[end] == '\\' {
				end = end + 1
			}
			end = end + 1
		}
		if end < len(src) && src[end] != '\n' {
			end = end + 1
		}
	} else if c == '/' && start + 1 < len(src) && src[start + 1] == '/' {
		for end < len(src) && src[end] != '\n' {
			end = end + 1
		}
	} else if c >= '0' && c <= '9' {
		for end < len(src) && ((src[end] >= 'a' && src[end] <= 'z') || (src[end] >= 'A' && src[end] <= 'Z') || src[end] == '_' || (src[end] >= '0' && src[end] <= '9') || (src[end] == '.' && end + 1 < len(src) && src[end + 1] >= '0' && src[end + 1] <= '9')) {
			end = end + 1
		}
	} else if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || (c >= '0' && c <= '9') || c >= 128 {
		for end < len(src) && ((src[end] >= 'a' && src[end] <= 'z') || (src[end] >= 'A' && src[end] <= 'Z') || src[end] == '_' || (src[end] >= '0' && src[end] <= '9') || i64(src[end]) >= 128) {
			end = end + 1
		}
	}
	if end > len(src) {
		end = len(src)
	}
	return col + (end - start)
}

// json_error prints a finished error text ("file:line:col: error E502 NAME: message") as the JSON object of
// toolchain/docs/TOOLING.md section 3, on standard output, and counts it.
fn json_error(b []u8) {
	let text = str(b)
	let e = json_index(text, "error ", 0)
	mut file = ""
	mut line = 0
	mut col = 0
	mut fileidx = -1
	mut rest = text
	if e >= 0 {
		rest = text[e + 6:]
	}
	if e > 2 {
		// the prefix "file:line:col: ": file, then the two numbers after the last two colons
		let prefix = text[:e - 2]
		mut c2 = len(prefix) - 1
		for c2 >= 0 && prefix[c2] != ':' {
			c2 = c2 - 1
		}
		mut c1 = c2 - 1
		for c1 >= 0 && prefix[c1] != ':' {
			c1 = c1 - 1
		}
		if c1 > 0 && c2 > c1 && json_number(prefix[c1 + 1:c2]) >= 0 {
			file = prefix[:c1]
			line = json_number(prefix[c1 + 1:c2])
			col = json_number(prefix[c2 + 1:])
		} else if c2 > 0 && json_number(prefix[c2 + 1:]) >= 0 {
			// "file:line" (a tin.mod or tin.lock line): column 1
			file = prefix[:c2]
			line = json_number(prefix[c2 + 1:])
			col = 1
		}
	}
	mut k = 0
	for k < len(files) {
		if files[k] == file {
			fileidx = k
		}
		k = k + 1
	}
	mut code = ""
	mut name = ""
	mut msg = rest
	let sp = json_index(rest, " ", 0)
	let colon = json_index(rest, ": ", 0)
	if sp > 0 && colon > sp && rest[0] == 'E' {
		code = rest[:sp]
		name = rest[sp + 1:colon]
		msg = rest[colon + 2:]
	} else if colon >= 0 {
		msg = rest[colon + 2:]
	}
	let o = buf_new()
	buf_str(o, "{{\"file\":")
	json_quote(o, file)
	buf_str(o, ",\"line\":")
	buf_int(o, line)
	buf_str(o, ",\"col\":")
	buf_int(o, col)
	buf_str(o, ",\"endLine\":")
	buf_int(o, line)
	buf_str(o, ",\"endCol\":")
	if line > 0 {
		buf_int(o, json_token_end(fileidx, line, col))
	} else {
		buf_int(o, 0)
	}
	buf_str(o, ",\"code\":")
	json_quote(o, code)
	buf_str(o, ",\"name\":")
	json_quote(o, name)
	buf_str(o, ",\"severity\":\"error\",\"message\":")
	json_quote(o, msg)
	buf_str(o, ",\"fix\":\"\"}}\n")
	write_all(1, cast([]u8, o))
	error_count = error_count + 1
}

fn fatal(b []u8) {
	err_end(cast([]u8, b))
	rt_sys_exit(1)
}

// err_code starts an error with its code and name from toolchain/docs/ERRORS.md, such as
// "E502 TYPE_ARG_COUNT"; finish it with err_end (keep going) or fatal (stop).
fn err_code(pos i64, code str) []u8 {
	let b = buf_new()
	if pos != NO_POS {
		buf_pos(b, pos)
		buf_str(b, ": ")
	}
	buf_str(b, "error ")
	buf_str(b, code)
	buf_str(b, ": ")
	return cast([]u8, b)
}

// err_code_at reports a coded error whose whole message is MSG.
fn err_code_at(pos i64, code str, msg str) {
	let e = err_code(pos, code)
	buf_str(e, msg)
	err_end(cast([]u8, e))
}

// err_code_quoted reports a coded PREFIX 'NAME' SUFFIX.
fn err_code_quoted(pos i64, code str, prefix str, name str, suffix str) {
	let e = err_code(pos, code)
	buf_str(e, prefix)
	buf_byte(e, '\'')
	buf_str(e, name)
	buf_byte(e, '\'')
	buf_str(e, suffix)
	err_end(cast([]u8, e))
}

// Little- and big-endian stores into a byte array.
fn put32(p i64, v i64) {
	store8(p, v)
	store8(p + 1, v >> 8)
	store8(p + 2, v >> 16)
	store8(p + 3, v >> 24)
}

fn put64(p i64, v i64) {
	put32(p, v)
	put32(p + 4, v >> 32)
}

fn load32(p i64) i64 {
	return i64(load8(p)) | (i64(load8(p + 1)) << 8) | (i64(load8(p + 2)) << 16) | (i64(load8(p + 3)) << 24)
}

fn put32be(p i64, v i64) {
	store8(p, v >> 24)
	store8(p + 1, v >> 16)
	store8(p + 2, v >> 8)
	store8(p + 3, v)
}

fn put64be(p i64, v i64) {
	put32be(p, v >> 32)
	put32be(p + 4, v)
}

fn align_up(n i64, a i64) i64 {
	return (n + a - 1) & ~(a - 1)
}

fn name_bind(name str, val i64) i64 {
	let b = cast(NameBind, calloc(2, 8))
	b.name = name
	b.val = val
	return cast(i64, b)
}
