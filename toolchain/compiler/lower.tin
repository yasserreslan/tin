// Expression checking and lowering. chk(e, want) types e and rewrites it in place into
// core nodes; want is the type the context expects (it settles untyped constants and
// elided composite types). A node is checked once: Node.type_ marks it done.
//
// Strict rules for package code: operands must have identical types (constants adapt
// and must fit), conditions are bool, references are never nil (?T may be), faults must
// be handled, and every slice/string index is bounds-checked unless proven safe.
// Legacy fn code keeps its untyped word semantics.
fn chk(e Node, want i64) i64 {
	if e.type_ != 0 {
		return e.type_
	}
	mut t = chk_kind(cast(i64, e), want)
	if t == 0 {
		t = ty_int
	}
	e.type_ = t
	return t
}

fn chk_kind(e i64, want i64) i64 {
	let k = cast(Node, e).kind
	if k == EX_INT {
		return adapt_int(e, want)
	}
	if k == EX_FLOAT {
		if is_f32(cast(Ty, want)) != 0 {
			// An f32 constant: fold the rounding into the bits.
			cast(FloatLit, e).bits = round_f32_bits(cast(FloatLit, e).bits)
			if cast(Ty, want).under != 0 {
				return want
			}
			return ty_f32
		}
		if kind_of(cast(Ty, want)) == K_FLOAT && cast(Ty, want).under != 0 {
			// A literal takes a named float type: c + 1.0 with c a Celsius (#564).
			return want
		}
		return ty_float
	}
	if k == EX_STR {
		if is_query_t(cast(Ty, want)) != 0 {
			return chk_query(e, want)
		}
		if kind_of(cast(Ty, want)) == K_STRING && cast(Ty, want).under != 0 && cast(Ty, want).secret_ == 0 {
			// A string literal takes a named string type: let n Name = "tin" (#564).
			return want
		}
		return ty_string
	}
	if k == EX_NIL {
		cast(Node, e).kind = EX_INT
		cast(IntLit, e).val = 0
		if nilable(want) != 0 {
			return want
		}
		err_code_at(cast(Node, e).pos, "E233 UNTYPED_NIL", "nil needs an optional (?T) or fault type")
		return ty_nil
	}
	if k == EX_IDENT {
		return chk_ident(e, want)
	}
	if k == EX_UNARY {
		if fold_const(e) != 0 {
			return adapt_int(e, want)
		}
		return chk_unary(e, want)
	}
	if k == EX_BINARY {
		if fold_const(e) != 0 {
			return adapt_int(e, want)
		}
		if fold_compare(e) != 0 {
			return ty_bool
		}
		return chk_binary(e, want)
	}
	if k == EX_CALL {
		return chk_call(e, want)
	}
	if k == EX_INDEX {
		return chk_index(e)
	}
	if k == EX_SLICE {
		return chk_slice(e)
	}
	if k == EX_SELECT {
		return chk_select(e, want)
	}
	if k == EX_COMPOSITE {
		return chk_composite(e, want)
	}
	if k == EX_FUNCLIT {
		return chk_funclit(e)
	}
	if k == EX_BOUNDARY {
		return chk_boundary(e)
	}
	if k == EX_MATCH {
		return chk_match(e, want)
	}
	if k == EX_UNIT {
		return chk_unit(e, want)
	}
	if k == EX_TYPE {
		err_code_at(cast(Node, e).pos, "E235 NOT_A_VALUE", "type used as a value")
		return ty_int
	}
	if k == EX_TRY {
		err_code_at(cast(Node, e).pos, "E403 TRY_PLACEMENT", "try is only allowed as a statement, an initializer, an assignment or a return")
		return placeholder_type(want)
	}
	if k == EX_CATCH {
		err_code_at(cast(Node, e).pos, "E401 CATCH_PLACEMENT", "catch is only allowed on a whole statement, initializer, assignment or return value")
		return placeholder_type(want)
	}
	if k == EX_INTERP {
		if is_query_t(cast(Ty, want)) != 0 {
			return chk_query(e, want)
		}
		return chk_interp(e, want)
	}
	if k == EX_MUTARG {
		err_code_at(cast(Node, e).pos, "E705 MUT_ARG", "mut here does nothing: only an argument for a mut parameter takes mut")
		return chk(cast(Node, cast(MutArg, e).x), want)
	}
	if k == EX_COALESCE {
		return chk_coalesce(e)
	}
	err_code_at(cast(Node, e).pos, "E990 INTERNAL", "unexpected expression")
	return ty_int
}

// chk_coalesce checks opt ?? fallback (#561): the optional's value when it is not nil, else
// the fallback, which is evaluated only then. With a ?T fallback the result stays ?T. It
// becomes a hidden local holding the optional and an if:
//   a reference (or a ?T result): $x = opt; if $x == nil { $x = fallback }; $x as the result
//   an optional number (#632):    $x = opt; $r = 0; if $x == nil { $r = fallback } else { $r = payload($x) }
// coalesce_value is x ?? fb for ?P (#669): the value after x's tag when the tag is set, else
// fb (a P, or another ?P for a ?P result).
fn coalesce_value(e i64, x i64, fb i64, xt Ty) i64 {
	let pos = cast(Node, e).pos
	let et = xt.elem
	let ft = chk(cast(Node, fb), et)
	mut rt = et
	if ft == cast(i64, xt) {
		rt = cast(i64, xt)
	} else {
		check_assignable(cast(Node, fb), ft, cast(Ty, et))
	}
	mut stmts = []i64{}
	let tx = temp(pos, x, cast(i64, xt))
	stmts = append(stmts, cast(i64, tx))
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = mk_bin(pos, "!=", opt_tag(pos, sym_ref_node(pos, cast(Sym, tx.sym))), mk_int(pos, 0, ty_int), ty_bool)
	ifs.then = empty_block(pos)
	ifs.else_ = empty_block(pos)
	if rt == cast(i64, xt) {
		mut e1 = cast([]i64, cast(Block, ifs.else_).stmts)
		e1 = append(e1, assign_stmt(pos, sym_ref_node(pos, cast(Sym, tx.sym)), fb))
		cast(Block, ifs.else_).stmts = e1
		stmts = append(stmts, cast(i64, ifs))
		return set_seq(e, mk_seq(pos, cast(i64, stmts), sym_ref_node(pos, cast(Sym, tx.sym)), rt), rt)
	}
	let tr = temp(pos, mk_int(pos, 0, et), et)
	stmts = append(stmts, cast(i64, tr))
	mut t1 = cast([]i64, cast(Block, ifs.then).stmts)
	t1 = append(t1, assign_stmt(pos, sym_ref_node(pos, cast(Sym, tr.sym)), opt_payload(pos, sym_ref_node(pos, cast(Sym, tx.sym)), et)))
	cast(Block, ifs.then).stmts = t1
	mut e2 = cast([]i64, cast(Block, ifs.else_).stmts)
	e2 = append(e2, assign_stmt(pos, sym_ref_node(pos, cast(Sym, tr.sym)), fb))
	cast(Block, ifs.else_).stmts = e2
	stmts = append(stmts, cast(i64, ifs))
	return set_seq(e, mk_seq(pos, cast(i64, stmts), sym_ref_node(pos, cast(Sym, tr.sym)), rt), rt)
}

fn chk_coalesce(e i64) i64 {
	let pos = cast(Node, e).pos
	let x = cast(Coalesce, e).x
	let fb = cast(Coalesce, e).fallback
	let xt = cast(Ty, chk(cast(Node, x), 0))
	if kind_of(xt) != K_OPT {
		err_code_type(pos, "E422 COALESCE", "?? needs an optional on the left, not ", cast(i64, xt), "")
		chk(cast(Node, fb), cast(i64, xt))
		return cast(i64, xt)
	}
	if cast(Node, fb).kind == EX_NIL {
		err_code_at(cast(Node, fb).pos, "E422 COALESCE", "?? nil does nothing: the result is nil whenever the optional is")
		return cast(i64, xt)
	}
	if opt_value(xt) != 0 {
		return coalesce_value(e, x, fb, xt)
	}
	let scalar = opt_scalar(xt)
	mut et = scalar
	if et == 0 {
		et = xt.elem
	}
	let ft = chk(cast(Node, fb), et)
	mut rt = et
	if ft == cast(i64, xt) {
		rt = cast(i64, xt)
	} else {
		check_assignable(cast(Node, fb), ft, cast(Ty, et))
		if is_untyped(ft) != 0 {
			reconvert(cast(Node, fb), et)
		}
	}
	mut stmts = []i64{}
	mut xs = cast(Sym, 0)
	let xn = cast(Node, x)
	if scalar != 0 && rt != cast(i64, xt) && xn.kind == EX_IDENT && cast(IdentExpr, x).ref != 0 && cast(Sym, cast(IdentExpr, x).ref).kind == SYM_LOCAL && cast(Sym, cast(IdentExpr, x).ref).cell == 0 && cast(Sym, cast(IdentExpr, x).ref).captured == 0 {
		// An optional number in a local is read in place: no copy of its two words (#632).
		xs = cast(Sym, cast(IdentExpr, x).ref)
	} else {
		let tx = temp(pos, x, cast(i64, xt))
		xs = cast(Sym, tx.sym)
		stmts = append(stmts, cast(i64, tx))
	}
	xs.reads = xs.reads + 1
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = mk_bin(pos, "==", sym_ref_node(pos, xs), mk_int(pos, 0, cast(i64, xt)), ty_bool)
	ifs.then = empty_block(pos)
	if scalar == 0 || rt == cast(i64, xt) {
		// The optional's own representation either way: nil takes the fallback's.
		mut then1 = cast([]i64, cast(Block, ifs.then).stmts)
		then1 = append(then1, assign_stmt(pos, sym_ref_node(pos, xs), fb))
		cast(Block, ifs.then).stmts = then1
		stmts = append(stmts, cast(i64, ifs))
		let v = sym_ref_node(pos, xs)
		cast(Node, v).type_ = rt
		return set_seq(e, mk_seq(pos, cast(i64, stmts), v, rt), rt)
	}
	let tr = temp(pos, zero_value(pos, scalar), scalar)
	let rs = cast(Sym, tr.sym)
	rs.reads = rs.reads + 1
	stmts = append(stmts, cast(i64, tr))
	mut then2 = cast([]i64, cast(Block, ifs.then).stmts)
	then2 = append(then2, assign_stmt(pos, sym_ref_node(pos, rs), fb))
	cast(Block, ifs.then).stmts = then2
	let els = cast(Block, empty_block(pos))
	mut st3 = cast([]i64, els.stmts)
	st3 = append(st3, assign_stmt(pos, sym_ref_node(pos, rs), opt_payload(pos, sym_ref_node(pos, xs), scalar)))
	els.stmts = st3
	ifs.else_ = cast(i64, els)
	stmts = append(stmts, cast(i64, ifs))
	return set_seq(e, mk_seq(pos, cast(i64, stmts), sym_ref_node(pos, rs), scalar), scalar)
}

// set_seq makes e the sequence seq and returns its type t.
fn set_seq(e i64, seq i64, t i64) i64 {
	replace_node(e, seq)
	cast(Node, e).type_ = 0
	return t
}

// int_fits reports whether constant v is representable in integer type t.
fn int_fits(v i64, t Ty, big i64) i64 {
	let w = t.width
	if w == 8 {
		if big == 2 && t.signed != 0 {
			// Arithmetic that reached 2^63 or more is no i64; only a literal keeps its bits (#362).
			return 0
		}
		return i64(t.signed != 0 || v >= 0 || big != 0)
	}
	if big != 0 {
		return 0
	}
	let bits = 8 * w
	if t.signed != 0 {
		let lim = 1 << (bits - 1)
		return i64(v >= -lim && v < lim)
	}
	return i64(v >= 0 && v < (1 << bits))
}

// fold_compare turns a comparison of two integer constants into a bool (unsigned when
// either is above 2^63-1).
fn fold_compare(e i64) i64 {
	let op = cast(Binary, e).op
	if !(op == "<" || op == "<=" || op == ">" || op == ">=" || op == "==" || op == "!=") {
		return 0
	}
	let l = cast(Binary, e).l
	let r = cast(Binary, e).r
	if fold_const(l) == 0 || fold_const(r) == 0 || cast(Node, l).kind != EX_INT || cast(Node, r).kind != EX_INT || cast(IntLit, l).char_ != 0 || cast(IntLit, r).char_ != 0 {
		return 0
	}
	mut a = cast(IntLit, l).val
	mut b = cast(IntLit, r).val
	if cast(IntLit, l).big != 0 || cast(IntLit, r).big != 0 {
		a = a ^ (1 << 63)
		b = b ^ (1 << 63)
	}
	replace_node(e, mk_int(cast(Node, e).pos, eval_binary(op, a, b), ty_bool))
	return 1
}

// fold_const evaluates an expression made only of integer literals, turning e into one literal.
fn fold_const(e i64) i64 {
	let k = cast(Node, e).kind
	if k == EX_INT {
		return 1
	}
	if k == EX_IDENT {
		// An untyped integer constant folds like the literal it stands for.
		let s = lookup_name(cast(IdentExpr, e).name)
		if cast(i64, s) == 0 || s.kind != SYM_CONST || s.done == 0 || s.expr != 0 || kind_of(cast(Ty, s.type_)) != K_UINT {
			return 0
		}
		mut big = s.big
		replace_node(e, mk_int(cast(Node, e).pos, s.val, 0))
		cast(IntLit, e).big = big
		return 1
	}
	mut v = 0
	if k == EX_UNARY {
		let op = cast(Unary, e).op
		let x = cast(IntLit, cast(Unary, e).x)
		if !(op == "-" || op == "^" || op == "+") || fold_const(cast(i64, x)) == 0 {
			return 0
		}
		v = x.val
		if op == "-" {
			// Negation is exact (#362): -(2^63) is the most negative i64, and below that is no constant.
			v = const_neg(v, x.big)
			if cx_ovf != 0 {
				const_overflow(cast(Node, e).pos)
			}
			let nb = 2 * cx_big
			fold_to_int(e, v)
			cast(IntLit, e).big = nb
			return 1
		} else if op == "^" {
			v = ~v
		}
	} else if k == EX_BINARY {
		let op = cast(Binary, e).op
		let l = cast(IntLit, cast(Binary, e).l)
		let r = cast(IntLit, cast(Binary, e).r)
		if fold_const(cast(i64, l)) == 0 || fold_const(cast(i64, r)) == 0 {
			return 0
		}
		let a = l.val
		let b = r.val
		let ub = i64(cast(IntLit, l).big != 0 || cast(IntLit, r).big != 0)
		if (op == "<<" || op == ">>") && (b < 0 || b >= 64) {
			shift_count_error(cast(Node, e).pos, b, 64, 0)
			fold_to_int(e, 0)
			return 1
		}
		if is_ovf_op(op) != 0 && cast(Binary, e).ovf != OVF_WRAP {
			// + - * on constants are exact (#362): a result no 64-bit type holds is an error.
			v = const_exact(op, a, cast(IntLit, l).big, b, cast(IntLit, r).big)
			if cx_ovf != 0 {
				const_overflow(cast(Node, e).pos)
			}
			let nb = 2 * cx_big
			fold_to_int(e, v)
			cast(IntLit, e).big = nb
			return 1
		}
		if op == "<<" {
			// A shift keeps the bits it moves (a literal-like pattern), but losing one is an error (#362).
			v = const_exact("*", a, cast(IntLit, l).big, 1 << b, i64(b == 63))
			if cx_ovf != 0 {
				const_overflow(cast(Node, e).pos)
			}
			let sb = cx_big
			fold_to_int(e, v)
			cast(IntLit, e).big = sb
			return 1
		}
		if ub != 0 && (op == ">>" || op == "/" || op == "%") {
			if (op == "/" || op == "%") && b == 0 {
				return 0
			}
			v = eval_unsigned(op, a, b)
			cast(Node, e).kind = EX_INT
			cast(IntLit, e).val = v
			cast(IntLit, e).w3 = 0
			cast(IntLit, e).w4 = 0
			cast(IntLit, e).char_ = 0
			cast(IntLit, e).big = i64(v < 0)
			return 1
		}
		if op == "+" {
			v = a + b
		} else if op == "-" {
			v = a - b
		} else if op == "*" {
			v = a * b
		} else if (op == "/" || op == "%") && b != 0 {
			if op == "/" {
				v = a / b
			} else {
				v = a % b
			}
		} else if op == "&" {
			v = a & b
		} else if op == "|" {
			v = a | b
		} else if op == "^" {
			v = a ^ b
		} else if op == "<<" && b >= 0 && b < 64 {
			v = a << b
		} else if op == ">>" && b >= 0 && b < 64 {
			v = a >> b
		} else {
			return 0
		}
	} else {
		return 0
	}
	mut big = 0
	if k == EX_BINARY {
		big = i64((cast(IntLit, cast(Binary, e).l).big != 0 || cast(IntLit, cast(Binary, e).r).big != 0) && v < 0)
	}
	cast(Node, e).kind = EX_INT
	cast(IntLit, e).val = v
	cast(IntLit, e).w3 = 0
	cast(IntLit, e).w4 = 0
	cast(IntLit, e).char_ = 0
	cast(IntLit, e).big = big
	return 1
}

// buf_const writes constant v in decimal, as unsigned when it is big (above 2^63-1).
@wrap fn buf_const(m []u8, v i64, big i64) {
	if big == 0 || v >= 0 {
		buf_int(m, v)
		return
	}
	let q = ((v >> 1) & 0x7fffffffffffffff) / 5
	buf_int(m, q)
	buf_int(m, v - q * 10)
}

// fold_to_int turns the folded expression e into the integer literal v.
fn fold_to_int(e i64, v i64) {
	cast(Node, e).kind = EX_INT
	cast(IntLit, e).val = v
	cast(IntLit, e).w3 = 0
	cast(IntLit, e).w4 = 0
	cast(IntLit, e).w5 = 0
	cast(IntLit, e).char_ = 0
	cast(IntLit, e).big = 0
}

// const_overflow reports constant arithmetic whose exact result no 64-bit integer type holds.
fn const_overflow(pos i64) {
	err_code_at(pos, "E223 CONST_OVERFLOW", "constant arithmetic overflows: the result is outside -2^63 .. 2^64-1")
}

// shift_count_error reports a constant shift count outside 0 .. bits-1 for a value of type t
// (0: an untyped constant) (#362).
fn shift_count_error(pos i64, c i64, bits i64, t i64) {
	let m = err_code(pos, "E224 SHIFT_COUNT")
	buf_str(m, "shift count ")
	buf_int(m, c)
	buf_str(m, " is out of range for ")
	if t == 0 {
		buf_str(m, "a constant")
	} else {
		type_name(cast([]u8, m), cast(Ty, t))
	}
	buf_str(m, ": counts are 0 to ")
	buf_int(m, bits - 1)
	err_end(cast([]u8, m))
}

// adapt_int gives an integer literal the expected type, checking that it fits.
fn adapt_int(e i64, want_in i64) i64 {
	mut want = want_in
	if want == 0 {
		want = ty_int
	}
	if is_float_t(want) != 0 {
		cast(Node, e).kind = EX_FLOAT
		cast(FloatLit, e).bits = int_to_float_bits(cast(IntLit, e).val)
		if is_f32(cast(Ty, want)) != 0 {
			cast(FloatLit, e).bits = round_f32_bits(cast(FloatLit, e).bits)
			if cast(Ty, want).under != 0 {
				return want
			}
			return ty_f32
		}
		if kind_of(cast(Ty, want)) == K_FLOAT && cast(Ty, want).under != 0 {
			return want
		}
		return ty_float
	}
	if kind_of(cast(Ty, want)) == K_INT {
		if int_fits(cast(IntLit, e).val, cast(Ty, want), cast(IntLit, e).big) == 0 {
			let m = err_code(cast(Node, e).pos, "E223 CONST_OVERFLOW")
			buf_str(m, "constant ")
			buf_const(m, cast(IntLit, e).val, cast(IntLit, e).big)
			buf_str(m, " overflows ")
			type_name(cast([]u8, m), cast(Ty, want))
			err_end(cast([]u8, m))
		}
		return want
	}
	return ty_uint
}

fn chk_ident(e i64, want i64) i64 {
	let name = cast(IdentExpr, e).name
	if name == "true" || name == "false" {
		replace_node(e, mk_int(cast(Node, e).pos, i64(name == "true"), 0))
		if kind_of(cast(Ty, want)) == K_BOOL && cast(Ty, want).under != 0 {
			// true and false take a named bool type (#564).
			return want
		}
		return ty_bool
	}
	let s = lookup_name(name)
	if cast(i64, s) == 0 {
		if len(import_pkg(name)) != 0 {
			err_code_quoted(cast(Node, e).pos, "E235 NOT_A_VALUE", "use of package ", name, " without a selector")
		} else {
			let u = err_code(cast(Node, e).pos, "E103 UNDEFINED")
			buf_str(u, "undefined: ")
			buf_str(u, name)
			err_end(cast([]u8, u))
		}
		return ty_int
	}
	return use_sym(e, cast(Sym, s), want)
}

// starts_select reports whether name is one of the rt_select_ helpers select lowers to.
fn starts_select(name str) i64 {
	return i64(len(name) >= 10 && name[:10] == "rt_select_")
}

// runtime_use rejects user code naming a function only the standard library may use: a C
// extern or one of the runtime's own (the trusted files outside any package).
fn runtime_use(pos i64, f Fn, name str) {
	if ck_trusted != 0 || name == "rt_pool_used" || name == "rt_once" || name == "rt_scope_open" || name == "rt_scope_close" || name == "rt_detach" || (i64(byte_at(name, 0)) == 'r' && starts_select(name) != 0) {
		return
	}
	if f.extern_ != 0 || (file_trusted[f.file] != 0 && i64(byte_at(file_pkgs[f.file], 0)) == 0) {
		err_code_quoted(pos, "E802 RUNTIME_INTERNAL", "", name, " is internal to the runtime")
	}
}

// use_sym turns a resolved name into a variable read, a constant or a function value.
fn use_sym(e i64, s Sym, want i64) i64 {
	let k = s.kind
	if k == SYM_LOCAL && al_nstale != 0 {
		al_read(cast(Node, e).pos, al_sym_key(s))
	}
	if k == SYM_FUNC {
		let f = cast(Fn, s.fn_)
		runtime_use(cast(Node, e).pos, f, cast(IdentExpr, e).name)
		cast(Node, e).kind = EX_FUNCREF
		cast(FuncRef, e).fn_ = cast(i64, f)
		return f.type_
	}
	if k == SYM_CONST {
		const_ready(s)
		if s.done == 0 {
			err_code_quoted(cast(Node, e).pos, "E130 INIT_ORDER", "constant ", cast(IdentExpr, e).name, " used before its definition")
			return ty_int
		}
		if s.expr != 0 {
			replace_node(e, expr_clone(s.expr))
			if kind_of(cast(Ty, s.type_)) == K_UFLOAT {
				// An untyped float constant takes the float type the context wants (#566).
				return chk_kind(e, want)
			}
			return s.type_
		}
		let v = s.val
		let t = s.type_
		replace_node(e, mk_int(cast(Node, e).pos, v, 0))
		cast(IdentExpr, e).ref = cast(i64, s)
		cast(IntLit, e).big = s.big
		if kind_of(cast(Ty, t)) == K_UINT {
			return chk_kind(e, want)
		}
		if is_float_t(t) != 0 {
			cast(Node, e).kind = EX_FLOAT
			cast(FloatLit, e).bits = int_to_float_bits(v)
		}
		return t
	}
	if s.captured != 0 {
		let env_ref = sym_ref_node(cast(Node, e).pos, cast(Sym, cast(Fn, ck_fn).env_sym))
		let cell_addr = mk_mem(cast(Node, e).pos, env_ref, 0, 0, 8 * (2 + s.cap_idx), ty_int)
		let val = mk_mem(cast(Node, e).pos, cell_addr, 0, 0, 0, s.type_)
		replace_node(e, val)
		return s.type_
	}
	if s.cell != 0 {
		let cell_ref = sym_ref_node(cast(Node, e).pos, cast(Sym, s.cell_sym))
		let val = mk_mem(cast(Node, e).pos, cell_ref, 0, 0, 0, s.type_)
		replace_node(e, val)
		return s.type_
	}
	cast(IdentExpr, e).ref = cast(i64, s)
	s.reads = s.reads + 1
	if s.type_ == 0 {
		return ty_int
	}
	if s.unbox != 0 {
		// A narrowed ?number: the variable holds the optional's two words; read the payload.
		let base = sym_ref_node(cast(Node, e).pos, s)
		cast(Node, base).type_ = opt_of(s.type_)
		replace_node(e, opt_payload(cast(Node, e).pos, base, s.type_))
	}
	return s.type_
}

fn chk_unary(e i64, want i64) i64 {
	let op = cast(Unary, e).op
	let x = cast(Unary, e).x
	if op == "&" {
		if cast(Node, x).kind == EX_COMPOSITE {
			let ct = chk(cast(Node, x), want)
			replace_node(e, x)
			return ct
		}
		if cast(Node, x).kind != EX_IDENT {
			err_code_at(cast(Node, e).pos, "E803 ADDRESS_OF", "'&' needs a variable name")
			chk(cast(Node, x), 0)
			return ty_int
		}
		let xname = cast(IdentExpr, x).name
		let xt = chk(cast(Node, x), 0)
		if cast(IdentExpr, x).ref != 0 && cast(Sym, cast(IdentExpr, x).ref).captured != 0 {
			let s = cast(Sym, cast(IdentExpr, x).ref)
			let env_ref = sym_ref_node(cast(Node, e).pos, cast(Sym, cast(Fn, ck_fn).env_sym))
			let cell_addr = mk_mem(cast(Node, e).pos, env_ref, 0, 0, 8 * (2 + s.cap_idx), ty_int)
			replace_node(e, cell_addr)
			return ty_int
		}
		if cast(IdentExpr, x).ref != 0 && cast(Sym, cast(IdentExpr, x).ref).cell != 0 {
			let s = cast(Sym, cast(IdentExpr, x).ref)
			replace_node(e, sym_ref_node(cast(Node, e).pos, cast(Sym, s.cell_sym)))
			return ty_int
		}
		if cast(Node, x).kind != EX_IDENT || cast(IdentExpr, x).ref == 0 {
			err_code_quoted(cast(Node, e).pos, "E803 ADDRESS_OF", "cannot take the address of constant ", xname, "")
			return ty_int
		}
		if kind_of(cast(Ty, xt)) == K_STRUCT {
			replace_node(e, x)
			return xt
		}
		if ck_trusted == 0 {
			err_code_at(cast(Node, e).pos, "E801 TRUSTED_ONLY", "'&' on a variable is only allowed in the standard library")
		}
		return ty_int
	}
	if op == "..." {
		err_code_at(cast(Node, e).pos, "E211 VARIADIC_ARG", "... is only allowed on the last argument of a call")
		return ty_int
	}
	let t = chk(cast(Node, x), want)
	if op == "!" {
		if is_bool_t(t) == 0 {
			err_code_type(cast(Node, e).pos, "E236 OPERATOR", "operator ! needs a bool, not ", t, "")
		}
		if is_secret(cast(Ty, t)) != 0 {
			return t
		}
		return ty_bool
	}
	if op == "-" {
		if is_numeric_t(t) == 0 {
			err_code_type(cast(Node, e).pos, "E236 OPERATOR", "operator - needs a number, not ", t, "")
		}
		if cast(Node, x).kind == EX_FLOAT {
			replace_node(e, x)
			cast(FloatLit, e).bits = cast(FloatLit, e).bits ^ (1 << 63)
			cast(Node, e).type_ = 0
			return ty_float
		}
		if cast(Node, x).kind == EX_INT && (kind_of(cast(Ty, t)) == K_UINT) {
			let nv = const_neg(cast(IntLit, x).val, cast(IntLit, x).big)
			if cx_ovf != 0 {
				const_overflow(cast(Node, e).pos)
			}
			let nb = 2 * cx_big
			replace_node(e, mk_int(cast(Node, e).pos, nv, 0))
			cast(IntLit, e).big = nb
			return t
		}
		if is_integer_t(t) != 0 && kind_of(cast(Ty, t)) != K_UINT {
			cast(Unary, e).ovf = ovf_mode()
			if cast(Node, x).kind == EX_INT && cast(Unary, e).ovf == OVF_CHECK {
				typed_const_check(cast(Node, e).pos, "-", 0, 0, cast(IntLit, x).val, cast(Ty, t))
			}
		}
		return t
	}
	if is_integer_t(t) == 0 {
		err_code_type(cast(Node, e).pos, "E236 OPERATOR", "operator ^ needs an integer, not ", t, "")
	}
	if cast(Node, x).kind == EX_INT && kind_of(cast(Ty, t)) == K_UINT {
		replace_node(e, mk_int(cast(Node, e).pos, ~cast(IntLit, x).val, 0))
		return ty_uint
	}
	return t
}

fn is_cmp_op(op str) i64 {
	return i64(op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=")
}

fn is_untyped_lit(e i64) i64 {
	let k = cast(Node, e).kind
	if k != EX_BINARY {
		return i64(k == EX_INT || k == EX_NIL || k == EX_FLOAT || (k == EX_UNARY && is_untyped_lit(cast(Unary, e).x) != 0))
	}
	// A leaf operand that is not a literal answers at once, before any walk down the other
	// side: unify asks at every level of a chain (a + b + c ..., or a + (b + (c ...))) (#713).
	let l = cast(Binary, e).l
	let r = cast(Binary, e).r
	let lk = cast(Node, l).kind
	let rk = cast(Node, r).kind
	if (lk != EX_BINARY && is_untyped_lit(l) == 0) || (rk != EX_BINARY && is_untyped_lit(r) == 0) {
		return 0
	}
	return i64(is_untyped_lit(r) != 0 && is_untyped_lit(l) != 0)
}

// untyped_int_expr reports an untyped integer: a literal, an integer constant without a type,
// or arithmetic on those.
fn untyped_int_expr(e i64) i64 {
	return i64(untyped_class(e) == 1)
}

// untyped_float_expr reports an untyped float: a float literal, a float constant without a
// type, or arithmetic in which one of those meets untyped integers.
fn untyped_float_expr(e i64) i64 {
	return i64(untyped_class(e) == 2)
}

// untyped_class is 1 for an untyped integer expression, 2 for an untyped float one and 0
// otherwise, in one walk that stops at the first operand that is neither (#713). unify asks at
// every level of a chain `x + x + x ...`; walking the left spine each time, twice over, made
// compiling a chain of n terms take time n^3.
fn untyped_class(e i64) i64 {
	let k = cast(Node, e).kind
	if k == EX_INT {
		return 1
	}
	if k == EX_FLOAT {
		return 2
	}
	if k == EX_IDENT || k == EX_SELECT {
		mut s = pkg_const(e)
		if k == EX_IDENT {
			s = lookup_name(cast(IdentExpr, e).name)
		}
		if cast(i64, s) == 0 || s.kind != SYM_CONST || s.done == 0 {
			return 0
		}
		if s.expr == 0 && kind_of(cast(Ty, s.type_)) == K_UINT {
			return 1
		}
		if s.expr != 0 && kind_of(cast(Ty, s.type_)) == K_UFLOAT {
			return 2
		}
		return 0
	}
	if k == EX_UNARY {
		if cast(Unary, e).op != "-" {
			return 0
		}
		return untyped_class(cast(Unary, e).x)
	}
	if k != EX_BINARY {
		return 0
	}
	let op = cast(Binary, e).op
	if op != "+" && op != "-" && op != "*" && op != "/" && op != "%" {
		return 0
	}
	let l = cast(Binary, e).l
	let r = cast(Binary, e).r
	// A leaf operand that is not untyped settles it without walking the other side.
	let lk = cast(Node, l).kind
	let rk = cast(Node, r).kind
	if (lk != EX_BINARY && lk != EX_UNARY && untyped_class(l) == 0) || (rk != EX_BINARY && rk != EX_UNARY && untyped_class(r) == 0) {
		return 0
	}
	let rc = untyped_class(r)
	if rc == 0 {
		return 0
	}
	let lc = untyped_class(l)
	if lc == 0 {
		return 0
	}
	if lc == 1 && rc == 1 {
		return 1
	}
	// A float meets an int or a float: a float, except under %, which floats do not have.
	if op == "%" {
		return 0
	}
	return 2
}

// unify checks both operands of a binary operator and returns their common type:
// identical types, or an untyped constant adapted to the other side.
fn unify(l Node, r i64, want i64) i64 {
	mut lt = 0
	mut rt = 0
	if (untyped_float_expr(cast(i64, l)) != 0 && untyped_int_expr(r) != 0) || (untyped_float_expr(r) != 0 && untyped_int_expr(cast(i64, l)) != 0) {
		// An untyped integer with an untyped float is a float, as in Go: 4 * 2.5, C * 2.5 (#566).
		mut fw = ty_float
		if is_float_t(want) != 0 {
			fw = want
		}
		lt = chk(l, fw)
		rt = chk(cast(Node, r), fw)
	} else if (is_untyped_lit(cast(i64, l)) == 0 && shifts_untyped(cast(i64, l)) == 0) || is_untyped_lit(r) != 0 {
		lt = chk(l, want)
		rt = chk(cast(Node, r), default_or(lt, want))
	} else {
		rt = chk(cast(Node, r), want)
		lt = chk(l, default_or(rt, want))
	}
	if kind_of(cast(Ty, lt)) == K_UINT && is_untyped(rt) == 0 {
		lt = reconvert(l, rt)
	} else if kind_of(cast(Ty, rt)) == K_UINT && is_untyped(lt) == 0 {
		rt = reconvert(cast(Node, r), lt)
	}
	if kind_of(cast(Ty, lt)) == K_NIL && nilable(rt) != 0 {
		reconvert(l, rt)
		return rt
	}
	if kind_of(cast(Ty, rt)) == K_NIL && nilable(lt) != 0 {
		reconvert(cast(Node, r), lt)
		return lt
	}
	if kind_of(cast(Ty, lt)) == K_UINT && kind_of(cast(Ty, rt)) == K_UINT {
		return ty_uint
	}
	// A bounded operand counts as its unbounded type: the result may be longer (#240).
	lt = unbounded(cast(Ty, lt))
	rt = unbounded(cast(Ty, rt))
	// An operation on a secret and a plain value of the same type is secret.
	if lt != rt && secret_join(lt, rt) != 0 {
		return secret_join(lt, rt)
	}
	if lt != rt {
		err_code_types(l.pos, "E230 TYPE_MISMATCH", "mismatched types ", lt, " and ", rt)
	}
	return lt
}

// shifts_untyped reports a non-constant shift of an untyped constant (1 << n): it takes its type from the other
// operand of the binary operation it stands in, and from the context only when it stands alone, as in Go (#820).
fn shifts_untyped(e i64) i64 {
	if cast(Node, e).kind != EX_BINARY {
		return 0
	}
	let op = cast(Binary, e).op
	return i64((op == "<<" || op == ">>") && is_untyped_lit(cast(Binary, e).l) != 0)
}

fn default_or(t i64, want i64) i64 {
	if is_untyped(t) != 0 {
		return want
	}
	return t
}

// reconvert gives an untyped constant node the concrete type to.
fn reconvert(e Node, to i64) i64 {
	let k = kind_of(cast(Ty, e.type_))
	if k == K_UINT {
		if e.kind == EX_INT {
			e.type_ = 0
			let t = adapt_int(cast(i64, e), to)
			e.type_ = t
			return t
		}
		retype_untyped(cast(i64, e), to)
		return to
	}
	if k == K_NIL && nilable(to) != 0 {
		e.type_ = to
		return to
	}
	return e.type_
}

fn retype_untyped(e i64, to i64) {
	if kind_of(cast(Ty, cast(Node, e).type_)) != K_UINT {
		return
	}
	cast(Node, e).type_ = to
	let k = cast(Node, e).kind
	if k == EX_UNARY {
		retype_untyped(cast(Unary, e).x, to)
	} else if k == EX_BINARY && is_cmp_op(cast(Binary, e).op) == 0 {
		retype_untyped(cast(Binary, e).l, to)
		retype_untyped(cast(Binary, e).r, to)
	}
}

// ---- integer overflow (#362) ----
shared mut compiler_overflow i64 // checked code: 0 none, 1 user code, 2 also library packages, 3 also the runtime and compiler

shared mut ovf_levels []i64 // per file: ovf_level + 1 once computed

// ovf_level is 1 for user code, 3 for the runtime (toolchain/runtime/) and the compiler (toolchain/compiler/),
// and 2 for the other trusted files: library packages, tools and vendored unsafe packages.
fn ovf_level() i64 {
	if cast(i64, ovf_levels) == 0 {
		ovf_levels = []i64{}
	}
	for len(ovf_levels) <= ck_file {
		ovf_levels = append(ovf_levels, 0)
	}
	if ovf_levels[ck_file] == 0 {
		let tr = file_trusted[ck_file]
		mut level = 2
		if tr == 0 {
			level = 1
		} else if tr == 2 || (path_has(files[ck_file], "lib/runtime/") != 0 || path_has(files[ck_file], "toolchain/runtime/") != 0) {
			level = 3
		}
		ovf_levels[ck_file] = level + 1
	}
	return ovf_levels[ck_file] - 1
}

// path_has reports whether path contains part.
fn path_has(path str, part str) i64 {
	mut i = 0
	for i + len(part) <= len(path) {
		if path[i:i + len(part)] == part {
			return 1
		}
		i = i + 1
	}
	return 0
}

// fn_has_attr reports whether f is declared with the attribute @name.
fn fn_has_attr(f Fn, name str) i64 {
	let attrs = f.attrs
	mut i = 0
	for cast(i64, attrs) != 0 && i < len(attrs) {
		if cast(Attr, attrs[i]).name == name {
			return 1
		}
		i = i + 1
	}
	return 0
}

// fn_wraps reports whether integer arithmetic in f wraps: f, its generic template or a function
// literal's enclosing function is declared @wrap.
fn fn_wraps(f Fn) i64 {
	mut g = f
	for cast(i64, g) != 0 {
		if fn_has_attr(g, "wrap") != 0 || (g.genof != 0 && fn_has_attr(cast(Fn, g.genof), "wrap") != 0) {
			return 1
		}
		g = cast(Fn, g.parent)
	}
	return 0
}

// range_mode is OVF_CHECK where float to integer conversions are checked: the code the overflow
// policy covers (@wrap functions too), except helpers the compiler writes.
fn range_mode() i64 {
	if ovf_level() > compiler_overflow {
		return OVF_NONE
	}
	if cast(i64, ck_fn) != 0 && ck_fn.lifted == 2 {
		return OVF_NONE
	}
	return OVF_CHECK
}

// ovf_mode is OVF_CHECK where integer + - *, negation and signed / panic on overflow and shift
// counts must be below the width; a @wrap function keeps the machine's arithmetic (wrapping, and
// shift counts taken modulo 64).
fn ovf_mode() i64 {
	if range_mode() == OVF_NONE {
		return OVF_NONE
	}
	if cast(i64, ck_fn) != 0 && fn_wraps(ck_fn) != 0 {
		return OVF_NONE
	}
	return OVF_CHECK
}

// typed_const_check reports l op r on two constants of integer type t whose result t cannot hold
// (op "-" with no left operand when has_l is 0: a negation).
fn typed_const_check(pos i64, op str, l i64, has_l i64, r i64, t Ty) {
	let u = i64(t.signed == 0 && t.width == 8)
	mut v = 0
	if has_l == 0 {
		v = const_neg(r, u)
	} else {
		v = const_exact(op, l, u, r, u)
	}
	if cx_ovf != 0 {
		const_overflow(pos)
		return
	}
	mut big = 2 * cx_big
	if u != 0 {
		big = cx_big
	}
	if int_fits(v, t, big) == 0 || (u != 0 && v < 0 && cx_big == 0) {
		let m = err_code(pos, "E223 CONST_OVERFLOW")
		buf_str(m, "constant ")
		buf_const(m, v, cx_big)
		buf_str(m, " overflows ")
		type_name(cast([]u8, m), t)
		err_end(cast([]u8, m))
	}
}

fn chk_binary(e i64, want i64) i64 {
	let op = cast(Binary, e).op
	let l = cast(Binary, e).l
	let r = cast(Binary, e).r
	let pos = cast(Node, e).pos
	if op == "$is" {
		// A case of switch err { ... }: fault.Is, walking the chain and comparing identity.
		let ft = unify(cast(Node, l), r, ty_error)
		if kind_of(cast(Ty, ft)) == K_ERROR {
			replace_node(e, rt_call(pos, "rt_fault_is", args2(l, r), ty_bool))
			cast(Node, e).type_ = 0
		}
		return ty_bool
	}
	if op == "&&" || op == "||" {
		let a = chk(cast(Node, l), ty_bool)
		// x != nil && x.f: the right side sees x narrowed.
		mut narrowed = cast(Pair, 0)
		if op == "&&" {
			narrowed = narrow_begin(l, 1)
		} else {
			// x == nil || x.f: the right side runs only when x != nil.
			narrowed = narrow_begin(l, 0)
		}
		let b = chk(cast(Node, r), ty_bool)
		narrow_end(narrowed)
		if is_bool_t(a) == 0 || is_bool_t(b) == 0 {
			err_code_at(pos, "E236 OPERATOR", "operands of && and || must be bool")
		}
		return ty_bool
	}
	if op == "<<" || op == ">>" {
		let st = chk(cast(Node, l), want)
		let ct = chk(cast(Node, r), ty_int)
		if is_integer_t(st) == 0 {
			err_code_type(pos, "E236 OPERATOR", "cannot shift ", st, "")
		}
		if is_integer_t(ct) == 0 {
			err_code_type(pos, "E236 OPERATOR", "shift count must be an integer, not ", ct, "")
		}
		if kind_of(cast(Ty, ct)) == K_UINT {
			reconvert(cast(Node, r), ty_int)
		}
		if cast(Node, r).kind == EX_INT && is_integer_t(ct) != 0 {
			// A constant count is checked here: 0 to the width less one (#362).
			mut bits = 64
			mut named = 0
			if is_integer_t(st) != 0 && kind_of(cast(Ty, st)) != K_UINT {
				named = unbounded(cast(Ty, st))
				bits = 8 * cast(Ty, named).width
			}
			let c = cast(IntLit, r).val
			if (c < 0 || c >= bits) && ovf_mode() == OVF_CHECK {
				shift_count_error(pos, c, bits, named)
				return st
			}
		} else if is_integer_t(st) != 0 && kind_of(cast(Ty, st)) != K_UINT {
			cast(Binary, e).ovf = ovf_mode()
		}
		if cast(Node, l).kind == EX_INT && cast(Node, r).kind == EX_INT && kind_of(cast(Ty, st)) == K_UINT {
			replace_node(e, mk_int(pos, eval_binary(op, cast(IntLit, l).val, cast(IntLit, r).val), 0))
			return ty_uint
		}
		if is_secret(cast(Ty, ct)) != 0 && is_untyped(st) == 0 {
			return secret_of(cast(Ty, st))
		}
		return st
	}
	let t = cast(Ty, unify(cast(Node, l), r, want))
	if is_cmp_op(op) != 0 && secret_compare_error(pos, op, cast(Node, l).type_, cast(Node, r).type_) != 0 {
		return ty_bool
	}
	if is_cmp_op(op) != 0 && kind_of(t) == K_DYN {
		err_code_at(pos, "E237 COMPARE", "cannot compare dyn values: use a method on the shape (?dyn compares against nil)")
		return ty_bool
	}
	if is_cmp_op(op) != 0 {
		let ordered = i64(op != "==" && op != "!=")
		if ordered == 0 && kind_of(t) == K_VARRAY {
			// Element by element, through a generated loop (#631).
			mut x = cast(i64, call_fn(pos, cast(Fn, varray_eq_fn(t)), args2(l, r), ty_bool))
			if op == "!=" {
				x = mk_unot(pos, x)
			}
			replace_node(e, x)
			return ty_bool
		}
		if ordered == 0 && kind_of(t) == K_STRUCT {
			return lower_enum_eq(cast(Node, e), op, l, r, cast(i64, t))
		}
		if ordered == 0 && kind_of(t) == K_OPT && opt_scalar(t) != 0 && is_nil_lit(l) == 0 && is_nil_lit(r) == 0 {
			return lower_optnum_eq(cast(Node, e), op, l, r, t)
		}
		if opt_value(t) != 0 {
			// ?P against nil reads its tag word (#669); two of them do not compare (E237).
			if ordered == 0 && (is_nil_lit(l) != 0 || is_nil_lit(r) != 0) {
				mut x = l
				if is_nil_lit(l) != 0 {
					x = r
				}
				replace_node(e, mk_bin(pos, op, opt_tag(pos, x), mk_int(pos, 0, ty_int), ty_bool))
				return ty_bool
			}
			err_code_type(pos, "E237 COMPARE", "cannot compare ", cast(i64, t), " values: compare their fields after narrowing (x != nil)")
			return ty_bool
		}
		if kind_of(t) == K_STRING {
			lower_str_cmp(cast(Node, e), op, l, r)
			return ty_bool
		}
		if cast(Node, l).kind == EX_INT && cast(Node, r).kind == EX_INT && kind_of(t) == K_UINT {
			replace_node(e, mk_int(pos, eval_binary(op, cast(IntLit, l).val, cast(IntLit, r).val), 0))
			return ty_bool
		}
		if ordered != 0 && is_numeric_t(cast(i64, t)) == 0 {
			err_code_type(pos, "E236 OPERATOR", "cannot order values of type ", cast(i64, t), "")
		}
		if kind_of(t) == K_UINT {
			reconvert(cast(Node, l), ty_int)
			reconvert(cast(Node, r), ty_int)
		}
		return ty_bool
	}
	let k = kind_of(t)
	if k == K_STRING {
		if op != "+" {
			err_code_quoted(pos, "E236 OPERATOR", "operator ", op, " is not defined on str")
		}
		let grow = sg_record(e)
		if grow != 0 {
			// s = s + e in a loop that only appends to s (#520).
			mut ga = cast([]i64, args2(l, r))
			ga = append(ga, sym_ref_node(pos, cast(Sym, grow)))
			replace_node(e, rt_call(pos, "rt_str_grow", cast(i64, ga), ty_string))
		} else {
			replace_node(e, rt_call(pos, "rt_str_cat", args2(l, r), ty_string))
		}
		cast(Node, e).type_ = 0
		if is_secret(t) != 0 {
			return cast(i64, t)
		}
		return ty_string
	}
	if is_numeric_t(cast(i64, t)) == 0 {
		err_code_type(pos, "E236 OPERATOR", "arithmetic on ", cast(i64, t), "")
	}
	if is_float_t(cast(i64, t)) != 0 && (op == "%" || op == "&" || op == "|" || op == "^") {
		err_code_quoted(pos, "E236 OPERATOR", "operator ", op, " is not defined on floats")
	}
	if cast(Binary, e).ovf == OVF_WRAP && is_integer_t(cast(i64, t)) == 0 {
		err_code_type(pos, "E236 OPERATOR", "the wrapping operators +% -% *% need integers, not ", cast(i64, t), "")
	}
	if k == K_UINT && cast(Node, l).kind == EX_INT && cast(Node, r).kind == EX_INT {
		if (op == "/" || op == "%") && cast(IntLit, r).val == 0 {
			err_code_at(pos, "E222 DIVISION_BY_ZERO", "division by zero")
			return ty_uint
		}
		if is_ovf_op(op) != 0 && cast(Binary, e).ovf != OVF_WRAP {
			let v = const_exact(op, cast(IntLit, l).val, cast(IntLit, l).big, cast(IntLit, r).val, cast(IntLit, r).big)
			if cx_ovf != 0 {
				const_overflow(pos)
			}
			let nb = 2 * cx_big
			replace_node(e, mk_int(pos, v, 0))
			cast(IntLit, e).big = nb
			return ty_uint
		}
		replace_node(e, mk_int(pos, eval_binary(op, cast(IntLit, l).val, cast(IntLit, r).val), 0))
		return ty_uint
	}
	if k == K_INT && is_const_zero(r) != 0 && (op == "/" || op == "%") {
		err_code_at(pos, "E222 DIVISION_BY_ZERO", "division by zero")
	}
	if k == K_INT && cast(Binary, e).ovf != OVF_WRAP && (is_ovf_op(op) != 0 || (op == "/" && t.signed != 0)) {
		// Integer + - * (and signed /, for the most negative value / -1) panic on overflow (#362).
		cast(Binary, e).ovf = ovf_mode()
		if cast(Binary, e).ovf == OVF_CHECK && cast(Node, l).kind == EX_INT && cast(Node, r).kind == EX_INT && is_ovf_op(op) != 0 {
			typed_const_check(pos, op, cast(IntLit, l).val, 1, cast(IntLit, r).val, t)
		}
	}
	if is_f32(t) != 0 {
		// f32 arithmetic is f64 arithmetic rounded to f32 after each step (exact for + - * /).
		let inner = cast(Node, node_copy(e))
		inner.type_ = cast(i64, t)
		replace_node(e, mk_conv(pos, cast(i64, inner), CV_ROUND32, cast(i64, t)))
	}
	return cast(i64, t)
}

// enum_incomparable returns a payload type of enum t without value equality (slices, maps,
// structs, funcs, optionals), or 0 when every variant compares by value.
fn enum_incomparable(t Ty) i64 {
	return value_incomparable(t, 0)
}

// value_incomparable is the first type inside the struct or enum t that has no value equality
// (a slice, map, function, dyn value, optional), or 0. Numbers, bool, str and faults compare;
// structs and enums compare field by field (depth bounds a recursive enum).
fn value_incomparable(t Ty, depth i64) i64 {
	if depth > 6 {
		return 0
	}
	let fs = cast([]i64, t.fields)
	mut i = 0
	if cast(i64, t.enum_) != 0 {
		i = 1
	}
	for i < len(fs) {
		mut ft = cast(Ty, field_type(t, i))
		for kind_of(ft) == K_VARRAY {
			// An inline array compares as its elements do (#631).
			ft = cast(Ty, ft.elem)
		}
		let k = kind_of(ft)
		if k == K_STRUCT {
			if cast(i64, ft) != cast(i64, t) {
				let inner = value_incomparable(ft, depth + 1)
				if inner != 0 {
					return inner
				}
			}
		} else if !(is_integer_t(cast(i64, ft)) != 0 || is_float_t(cast(i64, ft)) != 0 || k == K_BOOL || k == K_STRING || k == K_ERROR) {
			return cast(i64, ft)
		}
		i = i + 1
	}
	return 0
}

// is_nil_lit reports whether the checked expression e is the literal nil (an integer 0).
fn is_nil_lit(e i64) i64 {
	return i64(cast(Node, e).kind == EX_INT && cast(IntLit, e).val == 0 && kind_of(cast(Ty, cast(Node, e).type_)) == K_OPT)
}

// lower_optnum_eq compares two optional numbers by value: both nil, or both set and equal (#353).
fn lower_optnum_eq(e Node, op str, l i64, r i64, t Ty) i64 {
	let pos = e.pos
	mut stmts = []i64{}
	let a = temp(pos, l, cast(i64, t))
	let b = temp(pos, r, cast(i64, t))
	stmts = append(stmts, cast(i64, a))
	stmts = append(stmts, cast(i64, b))
	let ar = sym_ref_node(pos, cast(Sym, a.sym))
	let br = sym_ref_node(pos, cast(Sym, b.sym))
	let both_nil = mk_bin(pos, "&&", mk_bin(pos, "==", ar, mk_int(pos, 0, cast(i64, t)), ty_bool), mk_bin(pos, "==", br, mk_int(pos, 0, cast(i64, t)), ty_bool), ty_bool)
	let sa = opt_payload(pos, sym_ref_node(pos, cast(Sym, a.sym)), opt_scalar(t))
	let sb = opt_payload(pos, sym_ref_node(pos, cast(Sym, b.sym)), opt_scalar(t))
	let both_set = mk_bin(pos, "&&", mk_bin(pos, "!=", sym_ref_node(pos, cast(Sym, a.sym)), mk_int(pos, 0, cast(i64, t)), ty_bool), mk_bin(pos, "&&", mk_bin(pos, "!=", sym_ref_node(pos, cast(Sym, b.sym)), mk_int(pos, 0, cast(i64, t)), ty_bool), mk_bin(pos, "==", sa, sb, ty_bool), ty_bool), ty_bool)
	mut x = mk_seq(pos, cast(i64, stmts), mk_bin(pos, "||", both_nil, both_set, ty_bool), ty_bool)
	if op == "!=" {
		x = mk_unot(pos, x)
	}
	replace_node(cast(i64, e), x)
	return ty_bool
}

shared mut enum_eq_types []i64
shared mut enum_eq_fns []i64

// lower_enum_eq compares two enum or struct values by value (same variant and equal fields, or
// equal fields) through a generated eq function per type, so recursive enums compare without
// expanding forever.
fn lower_enum_eq(e Node, op str, l i64, r i64, t i64) i64 {
	let pos = e.pos
	let bad = value_incomparable(cast(Ty, t), 0)
	if bad != 0 {
		let u = err_code(pos, "E237 COMPARE")
		buf_str(u, "cannot compare ")
		type_name(u, cast(Ty, t))
		if cast(i64, cast(Ty, t).enum_) != 0 {
			buf_str(u, " values: a variant holds ")
		} else {
			buf_str(u, " values: a field holds ")
		}
		type_name(u, cast(Ty, bad))
		buf_str(u, ", which has no value equality")
		err_end(cast([]u8, u))
		return ty_bool
	}
	mut x = call_fn(pos, cast(Fn, enum_eq_fn(cast(Ty, t))), args2(l, r), ty_bool)
	if op == "!=" {
		let n = node_new(EX_UNARY, pos)
		cast(Unary, n).op = "!"
		cast(Unary, n).x = cast(i64, x)
		cast(Node, n).type_ = ty_bool
		x = cast(Node, n)
	}
	replace_node(cast(i64, e), cast(i64, x))
	return ty_bool
}

shared mut varray_eq_types []i64
shared mut varray_eq_fns []i64

// varray_eq_fn returns (making it once per type) veq$N(a, b [N]T) bool, which compares two inline
// arrays element by element (#631).
fn varray_eq_fn(t Ty) i64 {
	if cast(i64, varray_eq_types) == 0 {
		varray_eq_types = []i64{}
		varray_eq_fns = []i64{}
	}
	mut i = 0
	for i < len(varray_eq_types) {
		if varray_eq_types[i] == cast(i64, t) {
			return varray_eq_fns[i]
		}
		i = i + 1
	}
	mut names = []str{}
	names = append(names, "a")
	names = append(names, "b")
	mut types = []i64{}
	types = append(types, cast(i64, t))
	types = append(types, cast(i64, t))
	mut rts = []i64{}
	rts = append(rts, ty_bool)
	let f = lifted_fn("veq", names, cast([]i64, types), cast(i64, rts))
	varray_eq_types = append(varray_eq_types, cast(i64, t))
	varray_eq_fns = append(varray_eq_fns, cast(i64, f))
	let saved_fn = ck_fn
	ck_fn = cast(Fn, f)
	let pos = 0
	let ls = cast(Sym, cast([]i64, f.locals)[0])
	let rs = cast(Sym, cast([]i64, f.locals)[1])
	let et = t.elem
	let w8 = type_width(cast(Ty, et))
	let j = declare_local(pos, "$", ty_int)
	mut body = cast(Block, f.body).stmts
	body = append(body, let_stmt(pos, cast(Sym, j), mk_int(pos, 0, ty_int)))
	let w = cast(WhileStmt, node_new(ST_WHILE, pos))
	w.cond = mk_bin(pos, "<", sym_ref_node(pos, cast(Sym, j)), mk_int(pos, t.key, ty_int), ty_bool)
	w.post = assign_stmt(pos, sym_ref_node(pos, cast(Sym, j)), mk_bin(pos, "+", sym_ref_node(pos, cast(Sym, j)), mk_int(pos, 1, ty_int), ty_int))
	let wb = cast(Block, empty_block(pos))
	w.body = cast(i64, wb)
	let ea = mk_mem(pos, sym_ref_node(pos, ls), sym_ref_node(pos, cast(Sym, j)), w8, 0, et)
	let eb = mk_mem(pos, sym_ref_node(pos, rs), sym_ref_node(pos, cast(Sym, j)), w8, 0, et)
	let ne = binary_new(pos, "!=", ea, eb)
	chk(cast(Node, ne), ty_bool)
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = ne
	ifs.then = empty_block(pos)
	let rf = cast(ReturnStmt, node_new(ST_RETURN, pos))
	rf.value = mk_int(pos, 0, ty_bool)
	mut vt = cast(Block, ifs.then).stmts
	vt = append(vt, cast(i64, rf))
	wb.stmts = append(wb.stmts, cast(i64, ifs))
	body = append(body, cast(i64, w))
	let rt = cast(ReturnStmt, node_new(ST_RETURN, pos))
	rt.value = mk_int(pos, 1, ty_bool)
	body = append(body, cast(i64, rt))
	ck_fn = saved_fn
	return cast(i64, f)
}

// say_varray prints an inline array as a slice prints: [a b c] (#631).
fn say_varray(a Node, t Ty, prefix str) i64 {
	let pos = a.pos
	let et = t.elem
	let w8 = type_width(cast(Ty, et))
	mut stmts = []i64{}
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, prefix + "argsep", cast(i64, []i64{}), ty_void))))
	let av = temp(pos, cast(i64, a), cast(i64, t))
	stmts = append(stmts, cast(i64, av))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, prefix + "raw", args1(lit_string(pos, "[")), ty_void))))
	let j = declare_local(pos, "$", ty_int)
	stmts = append(stmts, let_stmt(pos, cast(Sym, j), mk_int(pos, 0, ty_int)))
	let w = cast(WhileStmt, node_new(ST_WHILE, pos))
	w.cond = mk_bin(pos, "<", sym_ref_node(pos, cast(Sym, j)), mk_int(pos, t.key, ty_int), ty_bool)
	w.post = assign_stmt(pos, sym_ref_node(pos, cast(Sym, j)), mk_bin(pos, "+", sym_ref_node(pos, cast(Sym, j)), mk_int(pos, 1, ty_int), ty_int))
	let wb = cast(Block, empty_block(pos))
	w.body = cast(i64, wb)
	let sep = cast(IfStmt, node_new(ST_IF, pos))
	sep.cond = mk_bin(pos, ">", sym_ref_node(pos, cast(Sym, j)), mk_int(pos, 0, ty_int), ty_bool)
	sep.then = empty_block(pos)
	mut vs1 = cast(Block, sep.then).stmts
	vs1 = append(vs1, expr_stmt(cast(Node, rt_call(pos, prefix + "raw", args1(lit_string(pos, " ")), ty_void))))
	wb.stmts = append(wb.stmts, cast(i64, sep))
	let el = mk_mem(pos, sym_ref_node(pos, cast(Sym, av.sym)), sym_ref_node(pos, cast(Sym, j)), w8, 0, et)
	if kind_of(cast(Ty, et)) == K_STRUCT {
		wb.stmts = append(wb.stmts, expr_stmt(call_fn(pos, say_struct_fn(cast(Ty, et), prefix), args1(el), ty_void)))
	} else {
		wb.stmts = append(wb.stmts, expr_stmt(say_arg(cast(Node, el), prefix)))
	}
	stmts = append(stmts, cast(i64, w))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, prefix + "raw", args1(lit_string(pos, "]")), ty_void))))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, prefix + "argend", cast(i64, []i64{}), ty_void))))
	return mk_seq(pos, cast(i64, stmts), mk_int(pos, 0, ty_int), ty_void)
}

fn enum_eq_fn(t Ty) i64 {
	if cast(i64, enum_eq_types) == 0 {
		enum_eq_types = []i64{}
		enum_eq_fns = []i64{}
	}
	mut i = 0
	for i < len(enum_eq_types) {
		if cast(i64, cast(Ty, cast([]i64, enum_eq_types)[i])) == cast(i64, t) {
			return enum_eq_fns[i]
		}
		i = i + 1
	}
	mut names = []str{}
	names = append(names, "a")
	names = append(names, "b")
	mut types = []i64{}
	types = append(types, cast(i64, t))
	types = append(types, cast(i64, t))
	mut rts = []i64{}
	rts = append(rts, ty_bool)
	let f = lifted_fn("eq", names, cast([]i64, types), cast(i64, rts))
	mut vs1 = cast([]i64, enum_eq_types)
	vs1 = append(vs1, cast(i64, t))
	enum_eq_fns = append(enum_eq_fns, cast(i64, f))
	let saved_fn = ck_fn
	ck_fn = cast(Fn, f)
	let pos = 0
	let ls = cast([]i64, f.locals)[0]
	let rs = cast([]i64, f.locals)[1]
	let tag0 = field_offset(t, 0)
	if cast(i64, t.enum_) == 0 {
		// A struct is equal when every field is.
		mut sx = mk_int(pos, 1, ty_bool)
		mut sf = 0
		for sf < len(cast([]i64, t.fields)) {
			let sft = field_type(t, sf)
			let sa = mk_mem(pos, sym_ref_node(pos, cast(Sym, ls)), 0, 0, field_offset(t, sf), sft)
			let sb = mk_mem(pos, sym_ref_node(pos, cast(Sym, rs)), 0, 0, field_offset(t, sf), sft)
			let sc = binary_new(pos, "==", sa, sb)
			chk(cast(Node, sc), ty_bool)
			if sf == 0 {
				sx = sc
			} else {
				sx = mk_bin(pos, "&&", sx, sc, ty_bool)
			}
			sf = sf + 1
		}
		let sret = cast(ReturnStmt, node_new(ST_RETURN, pos))
		sret.value = sx
		mut vs1 = cast(Block, f.body).stmts
		vs1 = append(vs1, cast(i64, sret))
		ck_fn = saved_fn
		return cast(i64, f)
	}
	mut x = mk_bin(pos, "==", mk_mem(pos, sym_ref_node(pos, cast(Sym, ls)), 0, 0, tag0, ty_int), mk_mem(pos, sym_ref_node(pos, cast(Sym, rs)), 0, 0, tag0, ty_int), ty_bool)
	let vs = t.enum_
	mut vi = 0
	for vi < len(vs) {
		let v = vs[vi]
		mut fe = 0
		mut k = 0
		for k < v.count {
			let fi = v.first + k
			let ft = field_type(t, fi)
			let a = mk_mem(pos, sym_ref_node(pos, cast(Sym, ls)), 0, 0, field_offset(t, fi), ft)
			let b = mk_mem(pos, sym_ref_node(pos, cast(Sym, rs)), 0, 0, field_offset(t, fi), ft)
			let c = binary_new(pos, "==", a, b)
			chk(cast(Node, c), ty_bool)
			if fe != 0 {
				fe = mk_bin(pos, "&&", fe, c, ty_bool)
			} else {
				fe = c
			}
			k = k + 1
		}
		if fe != 0 {
			let other = mk_bin(pos, "!=", mk_mem(pos, sym_ref_node(pos, cast(Sym, ls)), 0, 0, tag0, ty_int), mk_int(pos, vi, ty_int), ty_bool)
			x = mk_bin(pos, "&&", x, mk_bin(pos, "||", other, fe, ty_bool), ty_bool)
		}
		vi = vi + 1
	}
	let ret = cast(ReturnStmt, node_new(ST_RETURN, pos))
	ret.value = x
	mut vs2 = cast(Block, f.body).stmts
	vs2 = append(vs2, cast(i64, ret))
	ck_fn = saved_fn
	return cast(i64, f)
}

// elem_bits is value v as the bits a slice element of type et holds (4 bytes for f32).
fn elem_bits(v Node, et i64) i64 {
	if is_f32(cast(Ty, et)) != 0 {
		return mk_conv(v.pos, cast(i64, v), CV_F2BITS32, ty_int)
	}
	return to_bits(v)
}

fn is_const_zero(e i64) i64 {
	return i64(cast(Node, e).kind == EX_INT && cast(IntLit, e).val == 0)
}

fn lower_str_cmp(e Node, op str, l i64, r i64) {
	let pos = e.pos
	if op == "==" || op == "!=" {
		mut eq = rt_call(pos, "rt_str_eq", args2(l, r), ty_bool)
		if op == "!=" {
			let n = node_new(EX_UNARY, pos)
			cast(Unary, n).op = "!"
			cast(Unary, n).x = eq
			cast(Node, n).type_ = ty_bool
			eq = n
		}
		replace_node(cast(i64, e), eq)
		e.type_ = 0
		return
	}
	replace_node(cast(i64, e), mk_bin(pos, op, rt_call(pos, "rt_str_cmp", args2(l, r), ty_int), mk_int(pos, 0, ty_int), 0))
}

// ---- memory access ----
// mk_mem is a load or store of type t at base + index*scale + off.
fn mk_mem(pos i64, base i64, index i64, scale i64, off i64, t i64) i64 {
	let n = node_new(EX_MEM, pos)
	cast(MemExpr, n).base = base
	cast(MemExpr, n).index = index
	cast(MemExpr, n).scale = scale
	cast(MemExpr, n).off = off
	cast(Node, n).type_ = t
	return n
}

// ---- map keys: struct and enum keys are encoded to bytes, so they compare by value ----
fn key_composite(t i64) i64 {
	return i64(kind_of(cast(Ty, t)) == K_STRUCT)
}

// map_str_keys reports whether a map with key type kt keeps str keys inside.
fn map_str_keys(kt i64) i64 {
	return i64(kind_of(cast(Ty, kt)) == K_STRING || key_composite(kt) != 0)
}

// key_in is key e as the word the runtime stores (bits, a str, or an encoded struct/enum).
fn key_in(e Node, kt i64) i64 {
	if key_composite(kt) == 0 {
		return to_bits(e)
	}
	let pos = e.pos
	mut stmts = []i64{}
	let b = temp(pos, rt_call(pos, "rt_kb_new", cast(i64, []i64{}), ty_int), ty_int)
	stmts = append(stmts, cast(i64, b))
	stmts = append(stmts, assign_stmt(pos, sym_ref_node(pos, cast(Sym, b.sym)), cast(i64, call_fn(pos, cast(Fn, key_enc_fn(cast(Ty, kt))), args2(sym_ref_node(pos, cast(Sym, b.sym)), cast(i64, e)), ty_int))))
	return mk_seq(pos, cast(i64, stmts), rt_call(pos, "rt_kb_done", args1(sym_ref_node(pos, cast(Sym, b.sym))), ty_string), ty_string)
}

// key_out turns a stored key word back into a key of type kt.
fn key_out(e Node, kt i64) i64 {
	if key_composite(kt) == 0 {
		return from_bits(e, kt)
	}
	let pos = e.pos
	mut stmts = []i64{}
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, "rt_kd_begin", cast(i64, []i64{}), ty_void))))
	return mk_seq(pos, cast(i64, stmts), cast(i64, call_fn(pos, cast(Fn, key_dec_fn(cast(Ty, kt))), args1(mk_conv(pos, cast(i64, e), CV_SAME, ty_string)), kt)), kt)
}

// map_set_call stores v under key k in map m.
fn map_set_call(pos i64, m i64, k i64, v i64, kt i64) i64 {
	if is_value_struct(cast(Ty, cast(Ty, cast(Node, m).type_).elem)) != 0 {
		return map_set_vcell(pos, m, key_in(cast(Node, k), kt), v, key_composite(kt))
	}
	if is_dyn_value(cast(Ty, cast(Ty, cast(Node, m).type_).elem)) != 0 {
		return map_set_dyn(pos, m, key_in(cast(Node, k), kt), v, key_composite(kt))
	}
	if key_composite(kt) != 0 {
		return rt_call(pos, "rt_map_setk", args3(m, key_in(cast(Node, k), kt), to_bits(cast(Node, v))), ty_void)
	}
	// dup: the caller keeps no reference to the key it passes.
	return rt_call(pos, "rt_map_set", args4(m, to_bits(cast(Node, k)), to_bits(cast(Node, v)), mk_int(pos, 1, ty_int)), ty_void)
}

// map_set_dyn stores the dyn (or ?dyn) value v under k, the key's stored form (key_in),
// in map m (#567): the runtime keeps the value's two words in a cell of the map's memory.
// ck says the key is encoded (a struct or enum key).
fn map_set_dyn(pos i64, m i64, k i64, v i64, ck i64) i64 {
	mut stmts = []i64{}
	let key = temp(pos, k, cast(Node, k).type_)
	stmts = append(stmts, cast(i64, key))
	let saved = temp(pos, v, cast(Node, v).type_)
	stmts = append(stmts, cast(i64, saved))
	let object = mk_conv(pos, sym_ref_node(pos, cast(Sym, saved.sym)), CV_DYN_OBJECT, ty_int)
	let table = mk_conv(pos, sym_ref_node(pos, cast(Sym, saved.sym)), CV_DYN_TABLE_WORD, ty_int)
	mut args = []i64{}
	args = append(args, m)
	args = append(args, sym_ref_node(pos, cast(Sym, key.sym)))
	args = append(args, object)
	args = append(args, table)
	args = append(args, mk_int(pos, ck, ty_int))
	if is_shape_value(cast(Ty, cast(Node, v).type_)) == 0 {
		// An optional number: two words in the cell and no object to count (#632).
		return mk_seq(pos, cast(i64, stmts), rt_call(pos, "rt_map_set_pair", cast(i64, args), ty_void), ty_void)
	}
	// The cell keeps the table entry of the object's drop (#618).
	args = append(args, mk_int(pos, dyn_drop_index(cast(Node, v).type_), ty_int))
	let call = rt_call(pos, "rt_map_set_dyn", cast(i64, args), ty_void)
	return mk_seq(pos, cast(i64, stmts), call, ty_void)
}

// map_set_vcell stores value struct v under k, the key's stored form, in a cell of map m's own
// as wide as the value (#669): its bytes are copied in, and in a long-lived map its fields are
// counted (inc) and the old ones released (drop). ck says the key is encoded (rt_map_setk).
fn map_set_vcell(pos i64, m i64, k i64, v i64, ck i64) i64 {
	let vt = cast(Ty, cast(Node, v).type_)
	mut inc = rc_none()
	mut drop = rc_none()
	if value_has_ref(vt) != 0 {
		inc = vinc_fn(cast(i64, vt))
		drop = drop_fn(cast(i64, vt))
	}
	mut args = []i64{}
	args = append(args, m)
	args = append(args, k)
	args = append(args, v)
	args = append(args, mk_int(pos, vt.size, ty_int))
	args = append(args, fn_ref_node(pos, cast(Fn, inc)))
	args = append(args, fn_ref_node(pos, cast(Fn, drop)))
	args = append(args, mk_int(pos, ck, ty_int))
	return rt_call(pos, "rt_map_set_vcell", cast(i64, args), ty_void)
}

// map_val is the value of entry j of map m (rt_map_val) as a vt.
fn map_val(pos i64, m i64, j i64, vt i64) i64 {
	if is_value_struct(cast(Ty, vt)) != 0 {
		// The entry's cell holds the value's bytes (#669).
		return rt_call(pos, "rt_map_val", args2(m, j), vt)
	}
	if is_dyn_value(cast(Ty, vt)) != 0 {
		return rt_call(pos, "rt_map_val_dyn", args2(m, j), vt)
	}
	return from_bits(cast(Node, rt_call(pos, "rt_map_val", args2(m, j), ty_int)), vt)
}

// map_make_call makes a map of type t (#176): counted sides carry their drops, so the
// runtime counts the entries of a long-lived map by itself (its m[9] decides).
fn map_make_call(pos i64, t Ty) i64 {
	let counted = rc_map_bits(t)
	// Bit 1 tells the runtime the keys are floats, compared with float == (#643).
	let isstr = mk_int(pos, map_str_keys(t.key) | (2 * is_float_t(t.key)), ty_int)
	if counted == 0 {
		return rt_call(pos, "rt_map_make", args1(isstr), cast(i64, t))
	}
	return rt_call(pos, "rt_map_make_rc", args3(isstr, fn_ref_node(pos, cast(Fn, rc_map_drop(t))), mk_int(pos, counted, ty_int)), cast(i64, t))
}

// key_valid reports whether t can be a map key: str, numbers, bool, or structs and enums
// made of those (compared by value).
fn key_valid(t Ty, path []Ty) i64 {
	let k = kind_of(t)
	if k == K_STRING || k == K_BOOL || is_integer_t(cast(i64, t)) != 0 || is_float_t(cast(i64, t)) != 0 {
		return 1
	}
	if k == K_VARRAY {
		// An inline array is a key when its elements are (#631).
		return key_valid(cast(Ty, t.elem), path)
	}
	if k != K_STRUCT {
		return 0
	}
	mut i = 0
	for i < len(path) {
		if cast(i64, path[i]) == cast(i64, t) {
			return i64(cast(i64, t.enum_) != 0)
		}
		i = i + 1
	}
	path = append(path, cast(Ty, t))
	mut ok = 1
	mut fi = 0
	for fi < len(t.fields) && ok != 0 {
		ok = key_valid(cast(Ty, field_type(t, fi)), path)
		fi = fi + 1
	}
	slice_truncate(path, len(path) - 1)
	return ok
}

shared mut key_enc_types []i64
shared mut key_enc_fns []i64
shared mut key_dec_types []i64
shared mut key_dec_fns []i64

// key_enc_fn returns keyenc$N(b, x) b: x's bytes appended to byte slice b.
fn key_enc_fn(t Ty) i64 {
	if cast(i64, key_enc_types) == 0 {
		key_enc_types = []i64{}
		key_enc_fns = []i64{}
	}
	mut i = 0
	for i < len(key_enc_types) {
		if cast(i64, cast(Ty, cast([]i64, key_enc_types)[i])) == cast(i64, t) {
			return key_enc_fns[i]
		}
		i = i + 1
	}
	mut names = []str{}
	names = append(names, "b")
	names = append(names, "x")
	mut types = []i64{}
	types = append(types, ty_int)
	types = append(types, cast(i64, t))
	mut rts = []i64{}
	rts = append(rts, ty_int)
	let f = lifted_fn("keyenc", names, cast([]i64, types), cast(i64, rts))
	mut vs1 = cast([]i64, key_enc_types)
	vs1 = append(vs1, cast(i64, t))
	key_enc_fns = append(key_enc_fns, cast(i64, f))
	let saved_fn = ck_fn
	ck_fn = cast(Fn, f)
	let pos = 0
	let b = cast([]i64, f.locals)[0]
	let x = cast([]i64, f.locals)[1]
	mut body = cast(Block, f.body).stmts
	if cast(i64, t.enum_) != 0 {
		key_enc_field(pos, body, b, x, cast(i64, t), 0)
		let vs = t.enum_
		mut vi = 0
		for vi < len(vs) {
			let v = vs[vi]
			let ifs = cast(IfStmt, node_new(ST_IF, pos))
			ifs.cond = mk_bin(pos, "==", mk_mem(pos, sym_ref_node(pos, cast(Sym, x)), 0, 0, field_offset(t, 0), ty_int), mk_int(pos, vi, ty_int), ty_bool)
			ifs.then = empty_block(pos)
			mut k = 0
			for k < v.count {
				key_enc_field(pos, cast(Block, ifs.then).stmts, b, x, cast(i64, t), v.first + k)
				k = k + 1
			}
			body = append(body, cast(i64, ifs))
			vi = vi + 1
		}
	} else {
		mut fi = 0
		for fi < len(t.fields) {
			key_enc_field(pos, body, b, x, cast(i64, t), fi)
			fi = fi + 1
		}
	}
	let ret = cast(ReturnStmt, node_new(ST_RETURN, pos))
	ret.value = sym_ref_node(pos, cast(Sym, b))
	body = append(body, cast(i64, ret))
	ck_fn = saved_fn
	return cast(i64, f)
}

// key_enc_field appends `b = <field fi of x, encoded>` to body.
fn key_enc_field(pos i64, body []i64, b i64, x i64, t i64, fi i64) {
	let ft = field_type(cast(Ty, t), fi)
	let fv = mk_mem(pos, sym_ref_node(pos, cast(Sym, x)), 0, 0, field_offset(cast(Ty, t), fi), ft)
	key_enc_value(pos, body, b, fv, ft)
}

// varray_loop appends to body a loop over the N elements of the inline array at fv (#631),
// and returns its body block and the element expression maker's base and index locals.
fn varray_loop(pos i64, body []i64, fv i64, t Ty) Pair {
	let base = declare_local(pos, "$", ty_int)
	body = append(body, let_stmt(pos, cast(Sym, base), mk_conv(pos, fv, CV_SAME, ty_int)))
	let j = declare_local(pos, "$", ty_int)
	body = append(body, let_stmt(pos, cast(Sym, j), mk_int(pos, 0, ty_int)))
	let w = cast(WhileStmt, node_new(ST_WHILE, pos))
	w.cond = mk_bin(pos, "<", sym_ref_node(pos, cast(Sym, j)), mk_int(pos, t.key, ty_int), ty_bool)
	w.post = assign_stmt(pos, sym_ref_node(pos, cast(Sym, j)), mk_bin(pos, "+", sym_ref_node(pos, cast(Sym, j)), mk_int(pos, 1, ty_int), ty_int))
	let wb = cast(Block, empty_block(pos))
	w.body = cast(i64, wb)
	body = append(body, cast(i64, w))
	let el = mk_mem(pos, sym_ref_node(pos, cast(Sym, base)), sym_ref_node(pos, cast(Sym, j)), type_width(cast(Ty, t.elem)), 0, t.elem)
	return cast(Pair, pair(cast(i64, wb), el))
}

// key_enc_value appends the encoding of value fv of type ft (a field or an element) to b.
fn key_enc_value(pos i64, body []i64, b i64, fv i64, ft i64) {
	let k = kind_of(cast(Ty, ft))
	if k == K_VARRAY {
		// Each element in turn (#631).
		let lp = varray_loop(pos, body, fv, cast(Ty, ft))
		key_enc_value(pos, cast(Block, lp.a).stmts, b, lp.b, cast(Ty, ft).elem)
		return
	}
	mut nb = 0
	if k == K_BOOL {
		nb = rt_call(pos, "rt_kb_word", args2(sym_ref_node(pos, cast(Sym, b)), mk_conv(pos, fv, CV_SAME, ty_int)), ty_int)
	} else if k == K_STRING {
		nb = rt_call(pos, "rt_kb_str", args2(sym_ref_node(pos, cast(Sym, b)), fv), ty_int)
	} else if is_float_t(ft) != 0 {
		// -0 as +0, and a NaN never found again (#643).
		nb = rt_call(pos, "rt_kb_float", args2(sym_ref_node(pos, cast(Sym, b)), mk_conv(pos, fv, CV_F2BITS, ty_int)), ty_int)
	} else if k == K_STRUCT {
		nb = cast(i64, call_fn(pos, cast(Fn, key_enc_fn(cast(Ty, ft))), args2(sym_ref_node(pos, cast(Sym, b)), fv), ty_int))
	} else {
		nb = rt_call(pos, "rt_kb_word", args2(sym_ref_node(pos, cast(Sym, b)), mk_conv(pos, fv, CV_INT, ty_int)), ty_int)
	}
	body = append(body, assign_stmt(pos, sym_ref_node(pos, cast(Sym, b)), nb))
}

// key_dec_fn returns keydec$N(s) T: the key encoded in s, read from rt_kd's offset.
fn key_dec_fn(t Ty) i64 {
	if cast(i64, key_dec_types) == 0 {
		key_dec_types = []i64{}
		key_dec_fns = []i64{}
	}
	mut i = 0
	for i < len(key_dec_types) {
		if cast(i64, cast(Ty, cast([]i64, key_dec_types)[i])) == cast(i64, t) {
			return key_dec_fns[i]
		}
		i = i + 1
	}
	mut names = []str{}
	names = append(names, "s")
	mut types = []i64{}
	types = append(types, ty_string)
	mut rts = []i64{}
	rts = append(rts, cast(i64, t))
	let f = lifted_fn("keydec", names, cast([]i64, types), cast(i64, rts))
	mut vs1 = cast([]i64, key_dec_types)
	vs1 = append(vs1, cast(i64, t))
	key_dec_fns = append(key_dec_fns, cast(i64, f))
	let saved_fn = ck_fn
	ck_fn = cast(Fn, f)
	let pos = 0
	let s = cast([]i64, f.locals)[0]
	mut body = cast(Block, f.body).stmts
	let obj = temp(pos, rt_call(pos, "rt_alloc", args1(mk_int(pos, t.size, ty_int)), cast(i64, t)), cast(i64, t))
	body = append(body, cast(i64, obj))
	if cast(i64, t.enum_) != 0 {
		key_dec_field(pos, body, s, obj.sym, cast(i64, t), 0)
		let vs = t.enum_
		mut vi = 0
		for vi < len(vs) {
			let v = vs[vi]
			let ifs = cast(IfStmt, node_new(ST_IF, pos))
			ifs.cond = mk_bin(pos, "==", mk_mem(pos, sym_ref_node(pos, cast(Sym, obj.sym)), 0, 0, field_offset(t, 0), ty_int), mk_int(pos, vi, ty_int), ty_bool)
			ifs.then = empty_block(pos)
			mut k = 0
			for k < v.count {
				key_dec_field(pos, cast(Block, ifs.then).stmts, s, obj.sym, cast(i64, t), v.first + k)
				k = k + 1
			}
			body = append(body, cast(i64, ifs))
			vi = vi + 1
		}
	} else {
		mut fi = 0
		for fi < len(t.fields) {
			key_dec_field(pos, body, s, obj.sym, cast(i64, t), fi)
			fi = fi + 1
		}
	}
	let ret = cast(ReturnStmt, node_new(ST_RETURN, pos))
	ret.value = sym_ref_node(pos, cast(Sym, obj.sym))
	body = append(body, cast(i64, ret))
	ck_fn = saved_fn
	return cast(i64, f)
}

fn key_dec_field(pos i64, body []i64, s i64, obj i64, t i64, fi i64) {
	key_dec_into(pos, body, s, field_store(pos, sym_ref_node(pos, cast(Sym, obj)), t, fi), field_type(cast(Ty, t), fi))
}

// key_dec_into reads a value of type ft from the key s into the place dst (a field or element).
fn key_dec_into(pos i64, body []i64, s i64, dst i64, ft i64) {
	let k = kind_of(cast(Ty, ft))
	if k == K_VARRAY {
		// Each element in turn, into the inline array's bytes (#631).
		let lp = varray_loop(pos, body, dst, cast(Ty, ft))
		key_dec_into(pos, cast(Block, lp.a).stmts, s, lp.b, cast(Ty, ft).elem)
		return
	}
	mut v = 0
	if k == K_BOOL {
		v = mk_conv(pos, rt_call(pos, "rt_kd_word", args1(sym_ref_node(pos, cast(Sym, s))), ty_int), CV_SAME, ft)
	} else if k == K_STRING {
		v = rt_call(pos, "rt_kd_str", args1(sym_ref_node(pos, cast(Sym, s))), ty_string)
	} else if is_float_t(ft) != 0 {
		v = mk_conv(pos, rt_call(pos, "rt_kd_word", args1(sym_ref_node(pos, cast(Sym, s))), ty_int), CV_BITS2F, ft)
	} else if k == K_STRUCT {
		v = cast(i64, call_fn(pos, cast(Fn, key_dec_fn(cast(Ty, ft))), args1(sym_ref_node(pos, cast(Sym, s))), ft))
	} else {
		v = mk_conv(pos, rt_call(pos, "rt_kd_word", args1(sym_ref_node(pos, cast(Sym, s))), ty_int), CV_INT, ft)
	}
	body = append(body, assign_stmt(pos, dst, v))
}

// map_read is m[k]: a missing key reads as the value type's zero, and a str, slice, map
// or struct zero is a real (never nil) value.
fn map_read(pos i64, m Node, k i64, vt i64) i64 {
	if is_value_struct(cast(Ty, vt)) != 0 {
		// The entry's cell, or the value's zero (in a frame area) when the key is missing (#669).
		mut zs = []i64{}
		let z = temp(pos, zero_value(pos, vt), vt)
		zs = append(zs, cast(i64, z))
		return mk_seq(pos, cast(i64, zs), rt_call(pos, "rt_map_vget", args3(cast(i64, m), key_in(cast(Node, k), cast(Ty, m.type_).key), sym_ref_node(pos, cast(Sym, z.sym))), vt), vt)
	}
	if is_dyn_value(cast(Ty, vt)) != 0 {
		// A dyn value has no zero (#567): a missing key panics, or reads nil from a ?dyn map.
		return rt_call(pos, "rt_map_get_dyn", args3(cast(i64, m), key_in(cast(Node, k), cast(Ty, m.type_).key), mk_int(pos, i64(kind_of(cast(Ty, vt)) == K_DYN), ty_int)), vt)
	}
	let get = from_bits(cast(Node, rt_call(pos, "rt_map_get", args2(cast(i64, m), key_in(cast(Node, k), cast(Ty, m.type_).key)), ty_int)), vt)
	let vk = kind_of(cast(Ty, vt))
	if !(vk == K_STRING || vk == K_SLICE || vk == K_MAP || vk == K_STRUCT) {
		return get
	}
	mut stmts = []i64{}
	let tmp = temp(pos, get, vt)
	stmts = append(stmts, cast(i64, tmp))
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = mk_unot(pos, rt_call(pos, "rt_map_found", cast(i64, []i64{}), ty_bool))
	ifs.then = empty_block(pos)
	mut alt = 0
	if vk == K_STRING {
		alt = lit_string(pos, "")
	} else if vk == K_SLICE {
		alt = intrinsic_call(pos, "__empty", cast(i64, []i64{}), vt)
	} else {
		alt = argo_new(pos, cast(Block, ifs.then).stmts, cast(Ty, vt))
	}
	mut vs1 = cast(Block, ifs.then).stmts
	vs1 = append(vs1, assign_stmt(pos, sym_ref_node(pos, cast(Sym, tmp.sym)), alt))
	stmts = append(stmts, cast(i64, ifs))
	return mk_seq(pos, cast(i64, stmts), sym_ref_node(pos, cast(Sym, tmp.sym)), vt)
}

// mk_elem indexes a slice or string; the backend checks the index against the length
// unless the index's safe flag is set (the checker proved it in range).
fn mk_elem(pos i64, seq i64, index i64, t i64, isstr i64) ElemExpr {
	let n = node_new(EX_ELEM, pos)
	cast(ElemExpr, n).seq = seq
	cast(ElemExpr, n).idx = index
	cast(ElemExpr, n).size = type_width(cast(Ty, t))
	cast(ElemExpr, n).str = isstr
	cast(Node, n).type_ = t
	return cast(ElemExpr, n)
}

fn chk_index(e i64) i64 {
	let pos = cast(Node, e).pos
	if al_nstale != 0 {
		// A read of a constant element or map key whose slice append grew elsewhere (#627).
		al_read(pos, al_place(e, 0))
	}
	let x = cast(IndexExpr, e).x
	if cast(IndexExpr, e).i == 0 && index_from_targs(e) == 0 {
		err_code_at(pos, "E501 NOT_GENERIC", "type arguments go only to a generic function or type")
		return ty_int
	}
	let xt = cast(Ty, chk(cast(Node, x), 0))
	let k = kind_of(xt)
	if (k == K_INT && ck_trusted != 0) {
		// Raw word indexing: trusted code (the runtime's own memory management, the compiler's records).
		chk(cast(Node, cast(IndexExpr, e).i), ty_int)
		reconvert(cast(Node, cast(IndexExpr, e).i), ty_int)
		return ty_int
	}
	if k == K_MAP {
		let kt = chk(cast(Node, cast(IndexExpr, e).i), xt.key)
		check_assignable(cast(Node, cast(IndexExpr, e).i), kt, cast(Ty, xt.key))
		if is_untyped(kt) != 0 {
			reconvert(cast(Node, cast(IndexExpr, e).i), xt.key)
		}
		replace_node(e, map_read(pos, cast(Node, x), cast(IndexExpr, e).i, xt.elem))
		cast(Node, e).type_ = 0
		if is_secret(xt) != 0 {
			return secret_of(cast(Ty, xt.elem))
		}
		return xt.elem
	}
	let it = chk(cast(Node, cast(IndexExpr, e).i), ty_int)
	if is_integer_t(it) == 0 {
		err_code_type(pos, "E238 INDEX", "index must be an integer, not ", it, "")
	}
	if kind_of(cast(Ty, it)) == K_UINT {
		reconvert(cast(Node, cast(IndexExpr, e).i), ty_int)
	}
	if k == K_STRING {
		replace_node(e, cast(i64, mk_elem(pos, x, cast(IndexExpr, e).i, ty_byte, 1)))
		mark_safe_index(cast(ElemExpr, e))
		cast(Node, e).type_ = 0
		if is_secret(xt) != 0 || is_secret(cast(Ty, it)) != 0 {
			return secret_of(cast(Ty, ty_byte))
		}
		return ty_byte
	}
	if k == K_SLICE {
		replace_node(e, cast(i64, mk_elem(pos, x, cast(IndexExpr, e).i, xt.elem, 0)))
		mark_safe_index(cast(ElemExpr, e))
		cast(Node, e).type_ = 0
		if is_secret(xt) != 0 || is_secret(cast(Ty, it)) != 0 {
			return secret_of(cast(Ty, xt.elem))
		}
		return xt.elem
	}
	if k == K_VARRAY {
		// An inline array's element (#631): its address plus i times the element's width,
		// checked against N (at compile time for a constant index).
		let ix = cast(IndexExpr, e).i
		mut lenx = mk_int(pos, xt.key, ty_int)
		if is_const(ix) != 0 {
			let c = const_val(ix)
			if c < 0 || c >= xt.key {
				let m = err_code(pos, "E238 INDEX")
				buf_str(m, "index ")
				buf_int(m, c)
				buf_str(m, " is out of range for ")
				type_name(cast([]u8, m), xt)
				err_end(cast([]u8, m))
			}
			lenx = 0
		}
		let m = cast(MemExpr, mk_mem(pos, x, ix, type_width(cast(Ty, xt.elem)), 0, xt.elem))
		m.len = lenx
		replace_node(e, cast(i64, m))
		cast(Node, e).type_ = xt.elem
		return xt.elem
	}
	err_code_type(pos, "E238 INDEX", "cannot index ", cast(i64, xt), "")
	return ty_int
}

fn chk_slice(e i64) i64 {
	let pos = cast(Node, e).pos
	let x = cast(SliceExpr, e).x
	let xt = chk(cast(Node, x), 0)
	mut lo = cast(SliceExpr, e).lo
	mut hi = cast(SliceExpr, e).hi
	if lo != 0 {
		chk(cast(Node, lo), ty_int)
		reconvert(cast(Node, lo), ty_int)
	} else {
		lo = mk_int(pos, 0, ty_int)
	}
	// has_hi tells the runtime whether an upper bound was written (a negative one must panic).
	let has_hi = mk_int(pos, i64(hi != 0), ty_int)
	if hi != 0 {
		chk(cast(Node, hi), ty_int)
		reconvert(cast(Node, hi), ty_int)
	} else {
		hi = mk_int(pos, 0, ty_int)
	}
	if kind_of(cast(Ty, xt)) == K_STRING {
		replace_node(e, rt_call(pos, "rt_str_sub", args4(x, lo, hi, has_hi), ty_string))
		cast(Node, e).type_ = 0
		if is_secret(cast(Ty, xt)) != 0 {
			return xt
		}
		return ty_string
	}
	if kind_of(cast(Ty, xt)) == K_SLICE {
		replace_node(e, rt_call(pos, "rt_slice_sub", args5(x, lo, hi, mk_int(pos, elem_size(cast(Ty, xt)), ty_int), has_hi), xt))
		cast(Node, e).type_ = 0
		return xt
	}
	err_code_type(pos, "E238 INDEX", "cannot slice ", xt, "")
	return ty_int
}

// pkg_member resolves pkg.name to its global symbol, or 0.
fn pkg_member(pkg str, name str) i64 {
	return cast(i64, lookup_global(pkg + "." + name))
}

// is_private reports whether name is private to its package (not capitalized).
fn is_private(name str) i64 {
	let c = i64(byte_at(name, 0))
	return i64((c >= 'a' && c <= 'z') || c == '_')
}

// foreign_type reports whether struct type t was declared in a package other than the one
// being checked (its name is pkg.Name with pkg not the current package).
fn foreign_type(t Ty) i64 {
	let n = t.name
	if len(n) == 0 {
		return 0
	}
	mut i = 0
	for i < len(n) && i64(n[i]) != '.' && i64(n[i]) != '[' {
		i = i + 1
	}
	if byte_at(n, i) != '.' {
		return 0
	}
	return i64(n[:i] != ck_pkg)
}

// private_use reports (once) a private name of another package used here.
fn private_use(pos i64, what str, name str, owner str) {
	let m = err_code(pos, "E104 PRIVATE")
	buf_str(m, what)
	buf_str(m, " ")
	buf_str(m, name)
	buf_str(m, " is private to ")
	buf_str(m, owner)
	buf_str(m, ": only capitalized names are exported")
	err_end(cast([]u8, m))
}

// type_pkg is the package part of struct type t's name (for messages).
fn type_pkg(t Ty) str {
	let n = t.name
	mut i = 0
	for i < len(n) && i64(n[i]) != '.' {
		i = i + 1
	}
	return n[:i]
}

// enum_type_of returns the enum type x names (Shape, geo.Shape, Option[i64]), or 0.
fn enum_type_of(x i64) i64 {
	mut t = cast(Ty, 0)
	if cast(Node, x).kind == EX_IDENT {
		if lookup_name_local(cast(IdentExpr, x).name) != 0 || len(import_pkg(cast(IdentExpr, x).name)) != 0 {
			return 0
		}
		let s = lookup_name(cast(IdentExpr, x).name)
		if cast(i64, s) != 0 {
			return 0
		}
		t = cast(Ty, find_type_name(cast(IdentExpr, x).name))
	} else if cast(Node, x).kind == EX_SELECT {
		let px = cast(SelectExpr, x).x
		if cast(Node, px).kind != EX_IDENT || lookup_name_local(cast(IdentExpr, px).name) != 0 || len(import_pkg(cast(IdentExpr, px).name)) == 0 {
			return 0
		}
		t = cast(Ty, find_type(import_pkg(cast(IdentExpr, px).name) + "." + cast(SelectExpr, x).name))
	} else if cast(Node, x).kind == EX_INDEX {
		// Option[i64].Some(3): only when the base names a type, not a value.
		let base = cast(IndexExpr, x).x
		if cast(Node, base).kind != EX_IDENT || lookup_name_local(cast(IdentExpr, base).name) != 0 || cast(i64, lookup_name(cast(IdentExpr, base).name)) != 0 || !(cast(i64, find_generic(cast(IdentExpr, base).name)) != 0 || (len(ck_pkg) != 0 && cast(i64, find_generic(qual(ck_pkg, cast(IdentExpr, base).name))) != 0)) {
			return 0
		}
		let gtx = expr_to_tx(x)
		if gtx != 0 {
			t = cast(Ty, resolve_type(gtx))
		}
	}
	if cast(i64, t) != 0 && kind_of(t) == K_STRUCT && cast(i64, t.enum_) != 0 {
		return cast(i64, t)
	}
	return 0
}

// enum_variant is the index of variant name in enum t, or -1.
fn enum_variant(t Ty, name str) i64 {
	let vs = t.enum_
	mut i = 0
	for i < len(vs) {
		if vs[i].name == name {
			return i
		}
		i = i + 1
	}
	return -1
}

// enum_construct builds Shape.Circle(2.0): a tagged object whose other variants' fields
// hold their zero values.
fn enum_construct(e Node, t Ty, name str, args []i64) i64 {
	let pos = e.pos
	let vi = enum_variant(t, name)
	if vi < 0 {
		let u = err_code(pos, "E239 VARIANT")
		type_name(cast([]u8, u), t)
		buf_str(u, " has no variant ")
		buf_str(u, name)
		err_end(cast([]u8, u))
		return cast(i64, t)
	}
	if is_private(name) != 0 && foreign_type(t) != 0 {
		private_use(pos, "variant", name, type_pkg(t))
	}
	let v = t.enum_[vi]
	let first = v.first
	let nf = v.count
	if len(args) != nf {
		let u = err_code(pos, "E239 VARIANT")
		type_name(cast([]u8, u), t)
		buf_byte(u, '.')
		buf_str(u, name)
		buf_str(u, " takes ")
		buf_int(u, nf)
		if nf == 1 {
			buf_str(u, " value, got ")
		} else {
			buf_str(u, " values, got ")
		}
		buf_int(u, len(args))
		err_end(cast([]u8, u))
		return cast(i64, t)
	}
	mut stmts = []i64{}
	let obj = temp(pos, rt_call(pos, "rt_alloc", args1(mk_int(pos, t.size, ty_int)), cast(i64, t)), cast(i64, t))
	stmts = append(stmts, cast(i64, obj))
	stmts = append(stmts, assign_stmt(pos, field_store(pos, sym_ref_node(pos, cast(Sym, obj.sym)), cast(i64, t), 0), mk_int(pos, vi, ty_int)))
	let total = len(t.fields)
	mut i = 1
	for i < total {
		if i >= first && i < first + nf {
			let a = args[i - first]
			unwrap_mut(a)
			let ft = field_type(t, i)
			let at = chk(cast(Node, a), ft)
			check_assignable(cast(Node, a), at, cast(Ty, ft))
			if is_untyped(at) != 0 {
				reconvert(cast(Node, a), ft)
			}
			stmts = append(stmts, assign_stmt(pos, field_store(pos, sym_ref_node(pos, cast(Sym, obj.sym)), cast(i64, t), i), a))
		}
		// Other variants' fields stay empty: only a switch on the tag can reach them.
		i = i + 1
	}
	replace_node(cast(i64, e), mk_seq(pos, cast(i64, stmts), sym_ref_node(pos, cast(Sym, obj.sym)), 0))
	return cast(i64, t)
}

fn chk_select(e i64, want i64) i64 {
	let pos = cast(Node, e).pos
	if al_nstale != 0 {
		// A read of a field path whose slice append grew through another place (#627).
		al_read(pos, al_place(e, 0))
	}
	let x = cast(SelectExpr, e).x
	let name = cast(SelectExpr, e).name
	let et = enum_type_of(x)
	if et != 0 {
		return enum_construct(cast(Node, e), cast(Ty, et), name, []i64{})
	}
	if cast(Node, x).kind == EX_IDENT && lookup_name_local(cast(IdentExpr, x).name) == 0 {
		let pkg = import_pkg(cast(IdentExpr, x).name)
		if len(pkg) != 0 {
			let s = pkg_member(pkg, name)
			if s == 0 {
				let u = err_code(pos, "E103 UNDEFINED")
				buf_str(u, "undefined: ")
				buf_str(u, cast(IdentExpr, x).name)
				buf_byte(u, '.')
				buf_str(u, name)
				err_end(cast([]u8, u))
				return ty_int
			}
			if is_private(name) != 0 {
				private_use(pos, "name", name, pkg)
			}
			replace_node(e, node_new(EX_IDENT, pos))
			cast(IdentExpr, e).name = name
			return use_sym(e, cast(Sym, s), want)
		}
	}
	let xt = cast(Ty, chk(cast(Node, x), 0))
	if kind_of(xt) == K_OPT {
		err_code_type(pos, "E421 UNCHECKED_OPTIONAL", "cannot use a field of optional ", cast(i64, xt), " before checking it against nil")
		// The field keeps its declared type, so no second error follows from this one (#522).
		let ot = cast(Ty, xt.elem)
		if kind_of(ot) == K_STRUCT && cast(i64, ot.enum_) == 0 && struct_field(ot, name) >= 0 {
			return field_type(ot, struct_field(ot, name))
		}
		return ty_int
	}
	if kind_of(xt) == K_STRUCT && cast(i64, xt.enum_) != 0 {
		err_code_type(pos, "E213 FIELD", "an enum's data is read with switch, not as a field of ", cast(i64, xt), "")
		return ty_int
	}
	if kind_of(xt) == K_DYN {
		let info = cast(Pair, dyn_shape_method(xt, name))
		if cast(i64, info) == 0 {
			let dm = err_code(pos, "E214 METHOD")
			buf_str(dm, "dyn shape ")
			buf_str(dm, cast(Decl, xt.gdecl).name)
			buf_str(dm, " has no method ")
			buf_str(dm, name)
			err_end(cast([]u8, dm))
			return ty_int
		}
		let sig = cast(ShapeSig, info.b)
		return method_value(e, x, cast(i64, xt), name, sig.types, sig.muts, sig.results, i64(sig.bang != 0) | (i64(sig.mutres != 0) << 1))
	}
	if xt.under != 0 && cast(i64, find_fn(xt.name + "." + name)) != 0 {
		// A method value on a named non-struct type (#564, #565).
		let nmf = find_fn(xt.name + "." + name)
		mut nps = []i64{}
		mut nms = []i64{}
		mut npi = 1
		for npi < len(nmf.ptypes) {
			nps = append(nps, nmf.ptypes[npi])
			nms = append(nms, nmf.muts[npi])
			npi = npi + 1
		}
		return method_value(e, x, cast(i64, xt), name, nps, nms, nmf.rtypes, i64(nmf.bang != 0) | (i64(nmf.mutres != 0) << 1))
	}
	if kind_of(xt) == K_STRUCT {
		let i = struct_field(xt, name)
		let mf = find_fn(xt.name + "." + name)
		if i < 0 && cast(i64, mf) != 0 && cast(i64, xt.enum_) == 0 {
			if is_private(name) != 0 && foreign_type(xt) != 0 {
				private_use(pos, "method", name, type_pkg(xt))
			}
			// x.m not called: a method value (#565). Parameter zero is the receiver.
			mut ps = []i64{}
			mut ms = []i64{}
			mut pi = 1
			for pi < len(mf.ptypes) {
				ps = append(ps, mf.ptypes[pi])
				ms = append(ms, mf.muts[pi])
				pi = pi + 1
			}
			return method_value(e, x, cast(i64, xt), name, ps, ms, mf.rtypes, i64(mf.bang != 0) | (i64(mf.mutres != 0) << 1))
		}
		if i < 0 {
			let u = err_code(pos, "E213 FIELD")
			type_name(cast([]u8, u), xt)
			buf_str(u, " has no field ")
			buf_str(u, name)
			err_end(cast([]u8, u))
			return ty_int
		}
		if is_private(name) != 0 && foreign_type(xt) != 0 {
			private_use(pos, "field", name, type_pkg(xt))
		}
		replace_node(e, mk_mem(pos, x, 0, 0, field_offset(xt, i), 0))
		return field_type(xt, i)
	}
	err_code_type(pos, "E213 FIELD", "cannot select a field of ", cast(i64, xt), "")
	return ty_int
}

// method_value makes x.m, a method that is not called, a closure: it holds x, evaluated now,
// and calls x.m with its own arguments, so let f = c.get is a fn() i64 (#565). ps, ms and rs
// are the method's parameter types and mut marks without the receiver, and its results;
// flags is its bang (1) and mutres (2).
fn method_value(e i64, x i64, xt i64, name str, ps []i64, ms []i64, rs []i64, flags i64) i64 {
	let pos = cast(Node, e).pos
	let bang = flags & 1
	let mutres = flags >> 1
	// The closure is checked at once, so "$mv" is the innermost one when its body is.
	let rsym = cast(Sym, declare_local(pos, "$mv", xt))
	// The closure may outlive this frame, so the receiver lives in a cell, as a captured let does.
	give_cell(rsym, pos, "$mv")
	let csym = cast(Sym, rsym.cell_sym)
	mut hs = []i64{}
	hs = append(hs, let_stmt(pos, csym, rt_call(pos, "rt_alloc", args1(mk_int(pos, cell_bytes(xt), ty_int)), ty_int)))
	hs = append(hs, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, csym), 0, 0, 0, xt), x))
	let f = fn_new(pos, "func")
	// The signature's types are resolved already; the closure names them through type
	// bindings ($T0, $T1, ...), as a generic instance names its type arguments.
	mut binds = []i64{}
	mut args = []i64{}
	mut i = 0
	for i < len(ps) {
		let b = buf_new()
		buf_str(b, "$p")
		buf_int(b, i)
		let pn = str(b)
		f.params = append(f.params, pn)
		f.ptypes = append(f.ptypes, mv_type(pos, ps[i], mut binds))
		f.muts = append(f.muts, ms[i])
		let id = cast(IdentExpr, node_new(EX_IDENT, pos))
		id.name = pn
		mut a = cast(i64, id)
		if ms[i] != 0 {
			let ma = cast(MutArg, node_new(EX_MUTARG, pos))
			ma.x = a
			a = cast(i64, ma)
		}
		args = append(args, a)
		i = i + 1
	}
	mut rts = []i64{}
	for rt in rs {
		rts = append(rts, mv_type(pos, rt, mut binds))
	}
	f.rtypes = rts
	f.bang = bang
	f.mutres = mutres
	let rid = cast(IdentExpr, node_new(EX_IDENT, pos))
	rid.name = "$mv"
	let sel = cast(SelectExpr, node_new(EX_SELECT, pos))
	sel.x = cast(i64, rid)
	sel.name = name
	let call = cast(Call, node_new(EX_CALL, pos))
	call.callee = cast(i64, sel)
	call.args = cast([]i64, args)
	mut v = cast(i64, call)
	if bang != 0 {
		let tr = cast(TryExpr, node_new(EX_TRY, pos))
		tr.x = v
		v = cast(i64, tr)
	}
	let body = cast(Block, empty_block(pos))
	mut stmts = body.stmts
	if len(rs) - i64(bang != 0) > 0 {
		let ret = cast(ReturnStmt, node_new(ST_RETURN, pos))
		ret.value = v
		stmts = append(stmts, cast(i64, ret))
	} else {
		let es = cast(ExprStmt, node_new(ST_EXPR, pos))
		es.x = v
		stmts = append(stmts, cast(i64, es))
	}
	body.stmts = stmts
	f.body = cast(i64, body)
	let lit = cast(FuncLit, node_new(EX_FUNCLIT, pos))
	lit.fn_ = cast(i64, f)
	lit.escape = 1
	let saved = ck_tbind
	if cast(i64, saved) != 0 {
		for sb in cast([]i64, saved) {
			binds = append(binds, sb)
		}
	}
	ck_tbind = binds
	let ct = chk_funclit(cast(i64, lit))
	ck_tbind = saved
	replace_node(e, mk_seq(pos, cast(i64, hs), cast(i64, lit), ct))
	cast(Node, e).type_ = 0
	return ct
}

// mv_type is a type expression naming the resolved type t through a new binding in binds.
fn mv_type(pos i64, t i64, binds mut []i64) i64 {
	let b = buf_new()
	buf_str(b, "$T")
	buf_int(b, len(binds))
	let nb = cast(NameBind, calloc(2, 8))
	nb.name = str(b)
	nb.val = t
	binds = append(binds, cast(i64, nb))
	let tx = cast(TypeExpr, node_new(TX_NAME, pos))
	cast(TypeName, tx).name = nb.name
	return cast(i64, tx)
}

fn lookup_name_local(name str) i64 {
	mut i = len(sc_syms) - 1
	for i >= 0 {
		if sc_syms[i].name == name {
			return cast(i64, sc_syms[i])
		}
		i = i - 1
	}
	return 0
}

// lit_in_place reports a checked value struct literal v of type t that can be built in its
// field's bytes (#669): its sequence starts by zeroing its temporary and yields it, and t holds
// no reference, so the region pass, which sees the stores as stores into the temporary, misses
// nothing.
fn lit_in_place(v i64, t Ty) i64 {
	if cast(Node, v).kind != EX_SEQ || kind_of(t) != K_STRUCT || t.value == 0 || value_has_ref(t) != 0 {
		return 0
	}
	let vs = cast(SeqExpr, v).stmts
	let x = cast(SeqExpr, v).value
	if len(vs) == 0 || cast(Node, vs[0]).kind != ST_LET || x == 0 || cast(Node, x).kind != EX_IDENT {
		return 0
	}
	let l = cast(LetStmt, vs[0])
	return i64(l.sym == cast(IdentExpr, x).ref && l.init != 0 && cast(Node, l.init).kind == EX_INT && cast(IntLit, l.init).val == 0)
}

// field_store builds the target for storing into field fi of struct object obj.
fn field_store(pos i64, obj i64, t i64, fi i64) i64 {
	return mk_mem(pos, obj, 0, 0, field_offset(cast(Ty, t), fi), field_type(cast(Ty, t), fi))
}

// chk_composite allocates a struct, slice or map and fills it, as an EX_SEQ.
fn chk_composite(e i64, want i64) i64 {
	let pos = cast(Node, e).pos
	let tx = cast(Composite, e).type_
	mut t = cast(Ty, want)
	if kind_of(t) == K_OPT {
		t = cast(Ty, t.elem)
	}
	if kind_of(t) == K_VARRAY && varray_literal_fits(tx, t) != 0 {
		return chk_varray_literal(e, t)
	}
	if cast(Node, tx).kind == EX_TYPE && cast(TypeNode, tx).ty != 0 {
		t = cast(Ty, resolve_type(cast(TypeNode, tx).ty))
	} else if cast(Node, tx).kind == EX_INDEX {
		let gtx = expr_to_tx(tx)
		if gtx != 0 {
			t = cast(Ty, resolve_type(gtx))
		}
	} else if cast(Node, tx).kind == EX_IDENT || cast(Node, tx).kind == EX_SELECT {
		let tn = cast(TypeExpr, node_new(TX_NAME, pos))
		if cast(Node, tx).kind == EX_IDENT {
			cast(TypeName, tn).name = cast(IdentExpr, tx).name
		} else {
			cast(TypeName, tn).pkg = cast(IdentExpr, cast(SelectExpr, tx).x).name
			cast(TypeName, tn).name = cast(SelectExpr, tx).name
		}
		t = cast(Ty, resolve_type(cast(i64, tn)))
	}
	if cast(i64, t) == 0 {
		err_code_at(pos, "E216 COMPOSITE", "missing type in composite literal")
		return ty_int
	}
	let elems = cast(Composite, e).elems
	let keys = cast(Composite, e).keys
	mut stmts = []i64{}
	let k = kind_of(t)
	if k == K_STRUCT && cast(i64, t.enum_) != 0 {
		err_code_type(pos, "E216 COMPOSITE", "build an enum with one of its variants (", cast(i64, t), ".Variant(...)), not a composite literal")
		return cast(i64, t)
	}
	if k == K_STRUCT {
		let nf = len(t.fields)
		mut obj = cast(LetStmt, 0)
		if t.value != 0 {
			// A value struct literal is built in a zeroed frame area (#631).
			obj = temp(pos, mk_int(pos, 0, cast(i64, t)), cast(i64, t))
		} else {
			obj = temp(pos, rt_call(pos, "rt_alloc", args1(mk_int(pos, t.size, ty_int)), cast(i64, t)), cast(i64, t))
		}
		stmts = append(stmts, cast(i64, obj))
		let set = slice_filled(nf, 0)
		mut i = 0
		for i < len(elems) {
			mut fi = i
			let key = keys[i]
			if key != 0 {
				if cast(Node, key).kind != EX_IDENT {
					err_code_at(cast(Node, key).pos, "E216 COMPOSITE", "expected a field name")
					return cast(i64, t)
				}
				fi = struct_field(t, cast(IdentExpr, key).name)
				if fi < 0 {
					err_code_quoted(cast(Node, key).pos, "E216 COMPOSITE", "unknown field ", cast(IdentExpr, key).name, "")
					return cast(i64, t)
				}
				if is_private(cast(IdentExpr, key).name) != 0 && foreign_type(t) != 0 {
					private_use(cast(Node, key).pos, "field", cast(IdentExpr, key).name, type_pkg(t))
				}
			} else if fi >= nf {
				err_code_at(pos, "E216 COMPOSITE", "too many values in struct literal")
				return cast(i64, t)
			} else if foreign_type(t) != 0 && is_private(cast(Field, t.fields[fi]).name) != 0 {
				// A positional value sets the field as surely as its name would (#96).
				private_use(cast(Node, elems[i]).pos, "field", cast(Field, t.fields[fi]).name, type_pkg(t))
			}
			if key != 0 && set[fi] != 0 {
				// P{x: 1, x: 2}: the first value would be thrown away (#712).
				err_code_quoted(cast(Node, key).pos, "E216 COMPOSITE", "duplicate field ", cast(IdentExpr, key).name, " in struct literal")
			}
			set[fi] = 1
			let ft = field_type(t, fi)
			let v = elems[i]
			let lit = i64(cast(Node, v).kind == EX_COMPOSITE)
			let vt = chk(cast(Node, v), ft)
			check_assignable(cast(Node, v), vt, cast(Ty, ft))
			if is_untyped(vt) != 0 {
				reconvert(cast(Node, v), ft)
			}
			if t.value != 0 && lit != 0 && lit_in_place(v, cast(Ty, ft)) != 0 {
				// A value struct literal in a field of one is built in place, in the field's bytes
				// (#669): its temporary becomes a view of the field, which starts zeroed.
				let l = cast(LetStmt, cast(SeqExpr, v).stmts[0])
				cast(Sym, l.sym).view = 1
				l.init = field_store(pos, sym_ref_node(pos, cast(Sym, obj.sym)), cast(i64, t), fi)
				let vs = cast(SeqExpr, v).stmts
				mut j = 0
				for j < len(vs) {
					stmts = append(stmts, vs[j])
					j = j + 1
				}
			} else if !(is_const_zero(cast(i64, v)) != 0 && is_ref(ft) == 0) {
				stmts = append(stmts, assign_stmt(pos, field_store(pos, sym_ref_node(pos, cast(Sym, obj.sym)), cast(i64, t), fi), cast(i64, v)))
			}
			i = i + 1
		}
		// Fields left out get their zero value; references that cannot be nil must be set.
		i = 0
		for i < nf {
			if set[i] == 0 {
				init_zero_field(pos, cast([]i64, stmts), obj.sym, t, i)
			}
			i = i + 1
		}
		replace_node(e, mk_seq(pos, cast(i64, stmts), sym_ref_node(pos, cast(Sym, obj.sym)), 0))
		return cast(i64, t)
	}
	if k == K_SLICE {
		let n = len(elems)
		let et = t.elem
		// [N]T{...} has N elements: the listed ones, then zero values (#518).
		mut alen = -1
		mut ainner = 0
		if cast(Node, tx).kind == EX_TYPE && cast(TypeNode, tx).ty != 0 && cast(Node, cast(TypeNode, tx).ty).kind == TX_ARRAY {
			let atx = cast(TypeNode, tx).ty
			alen = array_len(atx)
			ainner = array_inner
			array_inner = 0
			if n > alen {
				let m = err_code(pos, "E202 ARRAY_TYPE")
				buf_str(m, "too many values in an array literal: ")
				buf_int(m, n)
				buf_str(m, " for ")
				buf_int(m, alen)
				buf_str(m, " elements")
				err_end(cast([]u8, m))
				return cast(i64, t)
			}
			// A row written {...} in [N][M]T{...} is an [M]T itself.
			let row = cast(TypeExpr, atx).b
			if row != 0 && cast(Node, row).kind == TX_ARRAY {
				mut ri = 0
				for ri < n {
					let rv = elems[ri]
					if cast(Node, rv).kind == EX_COMPOSITE && cast(Node, cast(Composite, rv).type_).kind == EX_TYPE && cast(TypeNode, cast(Composite, rv).type_).ty == 0 {
						cast(TypeNode, cast(Composite, rv).type_).ty = row
					}
					ri = ri + 1
				}
			}
		}
		mut made = rt_call(pos, "rt_slice_make", args3(mk_int(pos, n, ty_int), mk_int(pos, n, ty_int), mk_int(pos, elem_size(t), ty_int)), cast(i64, t))
		if alen > n {
			array_inner = ainner
			made = array_make(pos, t, alen)
		}
		let sl = temp(pos, made, cast(i64, t))
		stmts = append(stmts, cast(i64, sl))
		let data = temp(pos, mk_hdr(pos, sym_ref_node(pos, cast(Sym, sl.sym)), 2), ty_int)
		stmts = append(stmts, cast(i64, data))
		mut i = 0
		for i < n {
			let v = elems[i]
			let vt = chk(cast(Node, v), et)
			check_assignable(cast(Node, v), vt, cast(Ty, et))
			if is_untyped(vt) != 0 {
				reconvert(cast(Node, v), et)
			}
			stmts = append(stmts, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, cast(Sym, data.sym)), 0, 0, i * type_width(cast(Ty, et)), et), cast(i64, v)))
			i = i + 1
		}
		replace_node(e, mk_seq(pos, cast(i64, stmts), sym_ref_node(pos, cast(Sym, sl.sym)), 0))
		return cast(i64, t)
	}
	if k == K_MAP {
		let m = temp(pos, map_make_call(pos, t), cast(i64, t))
		stmts = append(stmts, cast(i64, m))
		// Constant keys so far, to report one given twice (#712): its first value would be lost.
		mut int_keys = []i64{}
		mut str_keys = []str{}
		mut i = 0
		for i < len(elems) {
			let key = keys[i]
			let v = cast(Node, elems[i])
			if key == 0 {
				err_code_at(v.pos, "E216 COMPOSITE", "missing key in map literal")
				return cast(i64, t)
			}
			let kt = chk(cast(Node, key), t.key)
			check_assignable(cast(Node, key), kt, cast(Ty, t.key))
			if is_untyped(kt) != 0 {
				reconvert(cast(Node, key), t.key)
			}
			let kk = cast(Node, key).kind
			if kk == EX_INT && kind_of(cast(Ty, t.key)) == K_INT {
				if slice_has(int_keys, cast(IntLit, key).val) != 0 {
					let u = err_code(cast(Node, key).pos, "E216 COMPOSITE")
					buf_str(u, "duplicate key ")
					buf_int(u, cast(IntLit, key).val)
					buf_str(u, " in map literal")
					err_end(cast([]u8, u))
				}
				int_keys = append(int_keys, cast(IntLit, key).val)
			} else if kk == EX_STR {
				mut j = 0
				for j < len(str_keys) {
					if str_keys[j] == cast(StrLit, key).ptr {
						let u = err_code(cast(Node, key).pos, "E216 COMPOSITE")
						buf_str(u, "duplicate key \"")
						buf_str(u, str_keys[j])
						buf_str(u, "\" in map literal")
						err_end(cast([]u8, u))
						break
					}
					j = j + 1
				}
				str_keys = append(str_keys, cast(StrLit, key).ptr)
			}
			let vt = chk(cast(Node, v), t.elem)
			check_assignable(cast(Node, v), vt, cast(Ty, t.elem))
			if is_untyped(vt) != 0 {
				reconvert(cast(Node, v), t.elem)
			}
			stmts = append(stmts, expr_stmt(cast(Node, map_set_call(pos, sym_ref_node(pos, cast(Sym, m.sym)), key, cast(i64, v), t.key))))
			i = i + 1
		}
		replace_node(e, mk_seq(pos, cast(i64, stmts), sym_ref_node(pos, cast(Sym, m.sym)), 0))
		return cast(i64, t)
	}
	err_code_type(pos, "E216 COMPOSITE", "cannot build a composite literal of type ", cast(i64, t), "")
	return ty_int
}

// varray_literal_fits reports whether a composite literal's type is the inline array type t where one is wanted
// (a value struct field, an element of one array, an assignment to such a field): `[N]T{...}` with N and T as t's, or
// no type at all ({...} for a row, #817).
fn varray_literal_fits(tx i64, t Ty) i64 {
	if cast(Node, tx).kind != EX_TYPE {
		return 0
	}
	let ty = cast(TypeNode, tx).ty
	if ty == 0 {
		return 1
	}
	return varray_type_fits(ty, t)
}

// varray_type_fits reports whether the array type as written, [N]T or [N][M]T, is the inline array type t.
fn varray_type_fits(ty i64, t Ty) i64 {
	if cast(Node, ty).kind != TX_ARRAY {
		return 0
	}
	let et = cast(Ty, t.elem)
	let b = cast(TypeExpr, ty).b
	if kind_of(et) == K_VARRAY {
		if varray_type_fits(b, et) == 0 {
			return 0
		}
	} else if resolve_type(b) != cast(i64, et) {
		return 0
	}
	let n = array_len(ty)
	array_inner = 0
	return i64(n == t.key)
}

// chk_varray_literal builds an inline array value [N]T{...}: N elements, the listed ones and then zero values, in a
// zeroed frame area like a value struct literal's, so that a store copies its bytes (#817).
fn chk_varray_literal(e i64, t Ty) i64 {
	let pos = cast(Node, e).pos
	let elems = cast(Composite, e).elems
	let n = len(elems)
	if n > t.key {
		let m = err_code(pos, "E202 ARRAY_TYPE")
		buf_str(m, "too many values in an array literal: ")
		buf_int(m, n)
		buf_str(m, " for ")
		buf_int(m, t.key)
		buf_str(m, " elements")
		err_end(cast([]u8, m))
		return cast(i64, t)
	}
	mut stmts = []i64{}
	// Elements that are references (a str, a slice) start as their zero value, "" and the empty slice.
	mut init = mk_int(pos, 0, cast(i64, t))
	if value_has_ref(t) != 0 {
		init = value_zero(pos, t)
	}
	let obj = temp(pos, init, cast(i64, t))
	stmts = append(stmts, cast(i64, obj))
	let et = t.elem
	let w = type_width(cast(Ty, et))
	mut i = 0
	for i < n {
		let v = elems[i]
		let vt = chk(cast(Node, v), et)
		check_assignable(cast(Node, v), vt, cast(Ty, et))
		if is_untyped(vt) != 0 {
			reconvert(cast(Node, v), et)
		}
		if !(is_const_zero(v) != 0 && is_ref(et) == 0) {
			stmts = append(stmts, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, cast(Sym, obj.sym)), 0, 0, i * w, et), v))
		}
		i = i + 1
	}
	replace_node(e, mk_seq(pos, cast(i64, stmts), sym_ref_node(pos, cast(Sym, obj.sym)), 0))
	return cast(i64, t)
}

// init_zero_field stores the zero value of a field the literal left out. Memory is
// already zeroed, so only references need work: "" and empty slices are static
// objects, and structs, maps and funcs have no zero value at all.
fn init_zero_field(pos i64, stmts []i64, obj i64, t Ty, fi i64) {
	let ft = field_type(t, fi)
	let k = kind_of(cast(Ty, ft))
	let rec = cast(Field, t.fields[fi])
	if k == K_SLICE && rec.arr > 0 {
		array_inner = rec.inner
		stmts = append(stmts, assign_stmt(pos, field_store(pos, sym_ref_node(pos, cast(Sym, obj)), cast(i64, t), fi), array_make(pos, cast(Ty, ft), rec.arr)))
		return
	}
	if k == K_STRING || k == K_SLICE {
		stmts = append(stmts, assign_stmt(pos, field_store(pos, sym_ref_node(pos, cast(Sym, obj)), cast(i64, t), fi), zero_value(pos, ft)))
	} else if is_value_struct(cast(Ty, ft)) != 0 {
		// A value struct field starts as zeroed bytes, as the object does (#631); its str
		// fields hold "" (#669).
		if value_has_ref(cast(Ty, ft)) != 0 && opt_value(cast(Ty, ft)) == 0 {
			stmts = append(stmts, assign_stmt(pos, field_store(pos, sym_ref_node(pos, cast(Sym, obj)), cast(i64, t), fi), value_zero(pos, cast(Ty, ft))))
		}
	} else if k == K_STRUCT || k == K_MAP || k == K_FUNC || k == K_DYN {
		let m = err_code(pos, "E203 NO_ZERO_VALUE")
		buf_str(m, "field ")
		buf_str(m, cast(Field, t.fields[fi]).name)
		buf_str(m, " of type ")
		type_name(cast([]u8, m), cast(Ty, ft))
		if k == K_DYN {
			buf_str(m, " must be set (a dyn value has no zero value)")
		} else {
			buf_str(m, " must be set (it cannot be nil; declare it ?T to allow that)")
		}
		err_end(cast([]u8, m))
	}
}

// value_zero is the zero value of a value struct holding a str (#669): zeroed bytes, then "" in
// each str field, built in a frame area like a literal.
fn value_zero(pos i64, t Ty) i64 {
	if opt_value(t) != 0 {
		// ?P's zero is nil: zeroed bytes (#669).
		return mk_int(pos, 0, cast(i64, t))
	}
	mut stmts = []i64{}
	let obj = temp(pos, mk_int(pos, 0, cast(i64, t)), cast(i64, t))
	stmts = append(stmts, cast(i64, obj))
	if t.kind == K_VARRAY {
		// An inline array of references (#692): each element's zero ("" or an empty slice).
		let et = cast(Ty, t.elem)
		let ek = kind_of(et)
		if ek == K_MAP || ek == K_FUNC || ek == K_DYN || (ek == K_STRUCT && is_value_struct(et) == 0) {
			err_code_type(pos, "E203 NO_ZERO_VALUE", "an inline array of ", cast(i64, et), " must be set (its elements cannot be nil)")
		}
		mut j = 0
		for j < t.key {
			let el = mk_mem(pos, sym_ref_node(pos, cast(Sym, obj.sym)), 0, 0, j * type_width(et), cast(i64, et))
			if ek == K_STRING || ek == K_SLICE {
				stmts = append(stmts, assign_stmt(pos, el, zero_value(pos, cast(i64, et))))
			} else if is_value_struct(et) != 0 && value_has_ref(et) != 0 && opt_value(et) == 0 {
				stmts = append(stmts, assign_stmt(pos, el, value_zero(pos, et)))
			}
			j = j + 1
		}
		return mk_seq(pos, cast(i64, stmts), sym_ref_node(pos, cast(Sym, obj.sym)), 0)
	}
	mut i = 0
	for i < len(t.fields) {
		init_zero_field(pos, cast([]i64, stmts), obj.sym, t, i)
		i = i + 1
	}
	return mk_seq(pos, cast(i64, stmts), sym_ref_node(pos, cast(Sym, obj.sym)), 0)
}

fn get_cell_addr(pos i64, os Sym) i64 {
	if os.captured != 0 {
		return mk_mem(pos, sym_ref_node(pos, cast(Sym, cast(Fn, ck_fn).env_sym)), 0, 0, 8 * (2 + os.cap_idx), ty_int)
	}
	if os.cell != 0 {
		return sym_ref_node(pos, cast(Sym, os.cell_sym))
	}
	os.addr = 1
	return mk_unary(pos, "&", sym_ref_node(pos, os))
}

// closure_keeper builds keep$N(d), which copies closure descriptor d and its captured
// variables into the long-lived heap, each value kept by its type (a str, slice, struct or
// closure deeply), so a kept closure never reads request memory (#170). It returns 0 when
// no captured variable holds a reference and every cell is one word.
fn closure_keeper(pos i64, cf Fn) i64 {
	let caps = cast([]i64, cf.captures)
	let k = len(caps)
	mut refs = 0
	mut i = 0
	for i < k {
		let ct = cast(Sym, caps[i]).type_
		if is_ref(ct) != 0 || is_dyn_value(cast(Ty, ct)) != 0 || cell_bytes(ct) > 8 || value_has_ref(cast(Ty, ct)) != 0 {
			// A cell wider than a word (a value struct's bytes, #631) needs a keeper too: the
			// runtime's own copy moves one word per cell.
			refs = 1
		}
		i = i + 1
	}
	if refs == 0 {
		return 0
	}
	lifted_count = lifted_count + 1
	let f = fn_new(pos, "keep")
	let nb = buf_new()
	buf_str(nb, "keep$")
	buf_int(nb, lifted_count)
	f.qname = str(nb)
	f.name = str(nb)
	f.lifted = 2
	f.file = cf.file
	f.params = append(f.params, "d")
	f.ptypes = append(f.ptypes, ty_int)
	f.rtypes = append(f.rtypes, ty_int)
	f.type_ = func_of(f.ptypes, f.rtypes, 0)
	f.locals = cast([]Sym, []i64{})
	f.body = empty_block(pos)
	prog_fns = append(prog_fns, cast(Fn, f))
	let saved_fn = ck_fn
	ck_fn = cast(Fn, f)
	let d = sym_new(SYM_LOCAL, "d", pos)
	d.type_ = ty_int
	d.slot = 0
	f.slots = 1
	mut vs4 = cast([]i64, f.locals)
	vs4 = append(vs4, cast(i64, d))
	mut body = cast(Block, f.body).stmts
	let nd = temp(pos, rt_call(pos, "rt_ingot_alloc", args1(mk_int(pos, 8 * (3 + k), ty_int)), ty_int), ty_int)
	body = append(body, cast(i64, nd))
	mut w = 0
	for w < 2 {
		body = append(body, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, cast(Sym, nd.sym)), 0, 0, 8 * w, ty_int), mk_mem(pos, sym_ref_node(pos, d), 0, 0, 8 * w, ty_int)))
		w = w + 1
	}
	body = append(body, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, cast(Sym, nd.sym)), 0, 0, 8 * (2 + k), ty_int), mk_mem(pos, sym_ref_node(pos, d), 0, 0, 8 * (2 + k), ty_int)))
	i = 0
	for i < k {
		let ct = cast(Sym, caps[i]).type_
		let cell = temp(pos, rt_call(pos, "rt_ingot_alloc", args1(mk_int(pos, cell_bytes(ct), ty_int)), ty_int), ty_int)
		body = append(body, cast(i64, cell))
		let old = mk_mem(pos, mk_mem(pos, sym_ref_node(pos, d), 0, 0, 8 * (2 + i), ty_int), 0, 0, 0, ct)
		mut val = old
		if is_ref(ct) != 0 || is_dyn_value(cast(Ty, ct)) != 0 || value_has_ref(cast(Ty, ct)) != 0 {
			val = keep_call(pos, keep_fn(cast(Ty, ct)), old, ct)
		}
		body = append(body, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, cast(Sym, cell.sym)), 0, 0, 0, ct), val))
		body = append(body, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, cast(Sym, nd.sym)), 0, 0, 8 * (2 + i), ty_int), sym_ref_node(pos, cast(Sym, cell.sym))))
		i = i + 1
	}
	let ret = cast(ReturnStmt, node_new(ST_RETURN, pos))
	ret.value = sym_ref_node(pos, cast(Sym, nd.sym))
	body = append(body, cast(i64, ret))
	ck_fn = saved_fn
	return cast(i64, f)
}

// chk_funclit lifts a function literal to a top-level function. Literals may capture
// variables from enclosing scopes: non-escaping closures allocate frame descriptors
// and cells on stack (0 bytes allocated), while escaping closures allocate region objects.
fn chk_funclit(e i64) i64 {
	let f = cast(Fn, cast(FuncLit, e).fn_)
	lifted_count = lifted_count + 1
	let b = buf_new()
	buf_str(b, "func$")
	buf_int(b, lifted_count)
	f.name = str(b)
	f.file = ck_file
	f.lifted = 1
	f.qname = f.name
	f.parent = cast(i64, ck_fn)
	f.captures = cast([]Sym, []i64{})
	f.outer_syms = cast([]i64, cast(i64, slice_clone(sc_syms)))
	f.escapes = cast(FuncLit, e).escape
	if len(cast(FuncLit, e).scoped) != 0 {
		f.escapes = 0
	}

	let saved_fn = ck_fn
	declare_fn(f)
	ck_fn = saved_fn

	check_fn_closure(cast(i64, f))
	sb_captures(e, f)
	f.done = 1
	prog_fns = append(prog_fns, cast(Fn, f))

	let k = len(cast([]i64, f.captures))
	if k == 0 {
		replace_node(e, node_new(EX_FUNCREF, cast(Node, e).pos))
		cast(FuncRef, e).fn_ = cast(i64, f)
		return f.type_
	}

	let pos = cast(Node, e).pos
	let fn_ref = node_new(EX_FUNCREF, pos)
	cast(FuncRef, fn_ref).fn_ = cast(i64, f)
	cast(FuncRef, fn_ref).raw = 1
	cast(Node, fn_ref).type_ = ty_int

	mut stmts = []i64{}
	mut desc_val = 0

	if cast(FuncLit, e).escape == 0 {
		let desc_sym = cast(Sym, declare_local(pos, "$desc", ty_int))
		desc_sym.addr = 1
		desc_sym.words = 3 + k
		let desc_addr = mk_unary(pos, "&", sym_ref_node(pos, desc_sym))
		let dptr = temp(pos, desc_addr, ty_int)
		stmts = append(stmts, cast(i64, dptr))
		let dref = sym_ref_node(pos, cast(Sym, dptr.sym))

		stmts = append(stmts, assign_stmt(pos, mk_mem(pos, dref, 0, 0, 0, ty_int), fn_ref))
		stmts = append(stmts, assign_stmt(pos, mk_mem(pos, dref, 0, 0, 8, ty_int), mk_int(pos, k, ty_int)))

		mut i = 0
		for i < k {
			let os = cast([]i64, f.captures)[i]
			let cell_expr = get_cell_addr(pos, cast(Sym, os))
			stmts = append(stmts, assign_stmt(pos, mk_mem(pos, dref, 0, 0, 8 * (2 + i), ty_int), cell_expr))
			i = i + 1
		}
		// A frame descriptor is never kept (the closure is only called): no keeper.
		stmts = append(stmts, assign_stmt(pos, mk_mem(pos, dref, 0, 0, 8 * (2 + k), ty_int), mk_int(pos, 0, ty_int)))
		desc_val = dref
	} else {
		let alloc_call = rt_call(pos, "rt_alloc", args1(mk_int(pos, 8 * (3 + k), ty_int)), ty_int)
		let obj = temp(pos, alloc_call, ty_int)
		stmts = append(stmts, cast(i64, obj))
		let dref = sym_ref_node(pos, cast(Sym, obj.sym))

		stmts = append(stmts, assign_stmt(pos, mk_mem(pos, dref, 0, 0, 0, ty_int), fn_ref))
		stmts = append(stmts, assign_stmt(pos, mk_mem(pos, dref, 0, 0, 8, ty_int), mk_int(pos, k, ty_int)))

		mut i = 0
		for i < k {
			let os = cast([]i64, f.captures)[i]
			let cell_expr = get_cell_addr(pos, cast(Sym, os))
			stmts = append(stmts, assign_stmt(pos, mk_mem(pos, dref, 0, 0, 8 * (2 + i), ty_int), cell_expr))
			i = i + 1
		}
		// Word 2 + k: the function keep() calls to copy this closure deeply (0: no captured
		// variable holds a reference, so copying the words is enough).
		let keeper = closure_keeper(pos, f)
		mut kv = mk_int(pos, 0, ty_int)
		if keeper != 0 {
			kv = node_new(EX_FUNCREF, pos)
			cast(FuncRef, kv).fn_ = keeper
			cast(Node, kv).type_ = ty_int
		}
		stmts = append(stmts, assign_stmt(pos, mk_mem(pos, dref, 0, 0, 8 * (2 + k), ty_int), kv))
		desc_val = dref
	}

	let seq = mk_seq(pos, cast(i64, stmts), desc_val, f.type_)
	replace_node(e, seq)
	return f.type_
}

// chk_unit turns an edition 1 unit literal (200ms, 4mb) into its integer constant:
// nanoseconds for a duration, bytes for a size (design_syntax §2).
fn chk_unit(e i64, want i64) i64 {
	let pos = cast(Node, e).pos
	let u = cast(UnitExpr, e).name
	if cast(UnitExpr, e).float != 0 {
		err_code_at(pos, "E012 NUMERIC_UNIT", "a fractional unit literal is not supported yet: write it in a smaller unit (2500ms, not 2.5s)")
		return ty_int
	}
	mut scale = 1
	if u == "us" {
		scale = 1000
	} else if u == "ms" {
		scale = 1000000
	} else if u == "s" {
		scale = 1000000000
	} else if u == "m" {
		scale = 60000000000
	} else if u == "h" {
		scale = 3600000000000
	} else if u == "kb" {
		scale = 1024
	} else if u == "mb" {
		scale = 1048576
	} else if u == "gb" {
		scale = 1073741824
	}
	let v = cast(UnitExpr, e).value
	if v < 0 || (v > 0 && v > 9223372036854775807 / scale) {
		err_code_at(pos, "E012 NUMERIC_UNIT", "unit literal out of range")
		return ty_int
	}
	let n = cast(IntLit, node_new(EX_INT, pos))
	n.val = v * scale
	replace_node(e, cast(i64, n))
	return chk(cast(Node, e), want)
}

// ---- boundary blocks: guard (#230), within (#233) and limit (#235) ----
//
// The block becomes a closure func($r i64) ! whose last expression is stored through $r, so
// fail and try leave the block with a fault. A generated boundary$N(c, a) !T runs it inside
// the boundary (a guard stack, or a boundary record with a deadline) and returns the value.
fn chk_boundary(e i64) i64 {
	let pos = cast(Node, e).pos
	let kind = cast(BoundaryStmt, e).kind
	if kind == BOUND_PARALLEL {
		return chk_parallel(e)
	}
	if kind == BOUND_WITH {
		return chk_with(e)
	}
	if kind == BOUND_ARENA {
		return chk_arena(e)
	}
	if (kind != BOUND_WITHIN && kind != BOUND_GUARD && kind != BOUND_LIMIT) {
		err_code_at(pos, "E650 BOUNDARY", "this boundary block is not supported yet")
		return ty_int
	}
	mut arg = mk_int(pos, 0, ty_int)
	mut arg2 = mk_int(pos, 0, ty_int)
	if kind == BOUND_WITHIN {
		arg = bound_int_arg(cast(BoundaryStmt, e).args[0])
	}
	if kind == BOUND_LIMIT {
		// limit memory n, tasks k: each bound at most once.
		mut i = 0
		for i < len(cast(BoundaryStmt, e).args) {
			let item = cast(NameBind, cast(BoundaryStmt, e).args[i])
			let name = item.name
			let v = bound_int_arg(item.val)
			if name == "memory" {
				arg = v
			} else if name == "tasks" {
				arg2 = v
			} else {
				err_code_quoted(pos, "E650 BOUNDARY", "limit bounds are memory and tasks, not ", name, "")
			}
			i = i + 1
		}
	}
	let body = cast(Block, cast(BoundaryStmt, e).body)
	bound_leaves(body.stmts)
	let f = fn_new(pos, "func")
	f.params = append(f.params, "$r")
	let it = cast(TypeExpr, node_new(TX_NAME, pos))
	cast(TypeName, it).name = "i64"
	f.ptypes = append(f.ptypes, cast(i64, it))
	let ft = cast(TypeExpr, node_new(TX_NAME, pos))
	cast(TypeName, ft).name = "fault"
	f.rtypes = append(f.rtypes, cast(i64, ft))
	f.bang = 1
	let stmts = body.stmts
	let n = len(stmts)
	if n > 0 && cast(Node, stmts[n - 1]).kind == ST_EXPR {
		let last = stmts[n - 1]
		let bs = cast(ExprStmt, node_new(ST_BSTORE, cast(Node, last).pos))
		bs.x = cast(ExprStmt, last).x
		stmts[n - 1] = cast(i64, bs)
	}
	f.body = cast(i64, body)
	let lit = cast(FuncLit, node_new(EX_FUNCLIT, pos))
	lit.fn_ = cast(i64, f)
	lit.escape = 0
	let saved_t = bound_t
	bound_t = ty_void
	let ct = chk_funclit(cast(i64, lit))
	let vt = bound_t
	bound_t = saved_t
	let w = cast(Fn, boundary_wrapper(pos, kind, ct, vt))
	let c = node_new(EX_CALL, pos)
	cast(Call, c).name = w.name
	cast(Call, c).fn_ = cast(i64, w)
	mut cargs = cast([]i64, args2(cast(i64, lit), arg))
	cargs = append(cargs, arg2)
	cast(Call, c).args = cast([]i64, cargs)
	mut results = []i64{}
	if kind_of(cast(Ty, vt)) != K_VOID {
		results = append(results, vt)
	}
	results = append(results, ty_error)
	mut rt = ty_error
	if len(cast([]i64, results)) > 1 {
		rt = tuple_of(cast(i64, results))
	}
	cast(Node, c).type_ = rt
	replace_node(e, c)
	return rt
}

// chk_parallel lowers parallel { e1 \n e2 ... } (#232): each line is a closure run as a child
// of an implicit scope, storing its value (a fault leaves the scope, cancelling the others);
// a generated parallel$N(c1, c2, ...) waits for them and returns the tuple of values.
fn chk_parallel(e i64) i64 {
	let pos = cast(Node, e).pos
	let stmts = cast(Block, cast(BoundaryStmt, e).body).stmts
	mut lits = []i64{}
	mut vts = []i64{}
	mut i = 0
	for i < len(stmts) {
		let st = stmts[i]
		if cast(Node, st).kind != ST_EXPR {
			err_code_at(cast(Node, st).pos, "E651 PARALLEL", "each line of parallel is an expression that runs as a child task")
			return ty_int
		}
		mut x = cast(Node, cast(ExprStmt, st).x)
		if x.kind != EX_TRY && x.kind != EX_CATCH {
			let tr = cast(TryExpr, node_new(EX_TRY, x.pos))
			tr.x = cast(i64, x)
			tr.soft = 1
			x = cast(Node, tr)
		}
		let bs = cast(ExprStmt, node_new(ST_BSTORE, cast(Node, st).pos))
		bs.x = cast(i64, x)
		let body = cast(Block, empty_block(cast(Node, st).pos))
		body.stmts = append(body.stmts, cast(i64, bs))
		let f = fn_new(cast(Node, st).pos, "func")
		f.params = append(f.params, "$r")
		let it = cast(TypeExpr, node_new(TX_NAME, pos))
		cast(TypeName, it).name = "i64"
		f.ptypes = append(f.ptypes, cast(i64, it))
		let ft = cast(TypeExpr, node_new(TX_NAME, pos))
		cast(TypeName, ft).name = "fault"
		f.rtypes = append(f.rtypes, cast(i64, ft))
		f.bang = 1
		f.body = cast(i64, body)
		let lit = cast(FuncLit, node_new(EX_FUNCLIT, cast(Node, st).pos))
		lit.fn_ = cast(i64, f)
		lit.escape = 0
		let saved_t = bound_t
		bound_t = ty_void
		let ct = chk_funclit(cast(i64, lit))
		if kind_of(cast(Ty, bound_t)) == K_VOID {
			err_code_at(cast(Node, st).pos, "E651 PARALLEL", "a parallel line must give a value")
		}
		vts = append(vts, bound_t)
		bound_t = saved_t
		lits = append(lits, pair(cast(i64, lit), ct))
		i = i + 1
	}
	if len(cast([]i64, lits)) < 2 {
		err_code_at(pos, "E651 PARALLEL", "parallel needs at least two lines")
		return ty_int
	}
	let w = cast(Fn, parallel_wrapper(pos, cast([]i64, lits), cast([]i64, vts)))
	let c = node_new(EX_CALL, pos)
	cast(Call, c).name = w.name
	cast(Call, c).fn_ = cast(i64, w)
	mut args = []i64{}
	i = 0
	for i < len(cast([]i64, lits)) {
		args = append(args, cast(Pair, lits[i]).a)
		i = i + 1
	}
	cast(Call, c).args = cast([]i64, args)
	mut results = []i64{}
	i = 0
	for i < len(cast([]i64, vts)) {
		results = append(results, vts[i])
		i = i + 1
	}
	results = append(results, ty_error)
	let rt = tuple_of(cast(i64, results))
	cast(Node, c).type_ = rt
	replace_node(e, c)
	return rt
}

// result_cell is the size of the cell a block's value of type vt is stored in: two words, or a
// value struct's bytes when it is wider (#669).
fn result_cell(vt i64) i64 {
	if is_value_struct(cast(Ty, vt)) != 0 && cast(Ty, vt).size > 16 {
		return align_up(cast(Ty, vt).size, 8)
	}
	return 16
}

// parallel_wrapper builds parallel$N(c1..cn) (T1..Tn, fault): it spawns each ci with its own
// result cell (result_cell) in an implicit scope, waits for all of them, and returns the values.
fn parallel_wrapper(pos i64, lits []i64, vts []i64) i64 {
	lifted_count = lifted_count + 1
	let f = fn_new(pos, "parallel")
	let nb = buf_new()
	buf_str(nb, "parallel$")
	buf_int(nb, lifted_count)
	f.qname = str(nb)
	f.name = str(nb)
	f.lifted = 2
	f.file = ck_file
	f.bang = 1
	let n = len(lits)
	mut i = 0
	for i < n {
		f.params = append(f.params, "c")
		f.ptypes = append(f.ptypes, cast(Pair, lits[i]).b)
		f.rtypes = append(f.rtypes, vts[i])
		i = i + 1
	}
	f.rtypes = append(f.rtypes, ty_error)
	f.type_ = func_of(f.ptypes, f.rtypes, 0)
	f.locals = cast([]Sym, []i64{})
	f.body = empty_block(pos)
	prog_fns = append(prog_fns, cast(Fn, f))
	let saved_fn = ck_fn
	ck_fn = cast(Fn, f)
	mut syms = []Sym{}
	i = 0
	for i < n {
		let cs = sym_new(SYM_LOCAL, "c", pos)
		cs.type_ = cast(Pair, lits[i]).b
		cs.slot = i
		mut vs5 = cast([]i64, f.locals)
		vs5 = append(vs5, cast(i64, cs))
		syms = append(syms, cast(Sym, cs))
		i = i + 1
	}
	f.slots = n
	mut body = cast(Block, f.body).stmts
	mut cells = []i64{}
	mut total = 0
	i = 0
	for i < n {
		cells = append(cells, total)
		total = total + result_cell(vts[i])
		i = i + 1
	}
	let r = temp(pos, rt_call(pos, "rt_alloc", args1(mk_int(pos, total, ty_int)), ty_int), ty_int)
	body = append(body, cast(i64, r))
	let sc = temp(pos, rt_call(pos, "rt_scope_open_word", cast(i64, []i64{}), ty_int), ty_int)
	body = append(body, cast(i64, sc))
	i = 0
	for i < n {
		let at = mk_bin(pos, "+", sym_ref_node(pos, cast(Sym, r.sym)), mk_int(pos, cells[i], ty_int), ty_int)
		mut sa = cast([]i64, args2(sym_ref_node(pos, cast(Sym, sc.sym)), sym_ref_node(pos, syms[i])))
		sa = append(sa, at)
		body = append(body, expr_stmt(cast(Node, rt_call(pos, "rt_scope_spawn_arg", cast(i64, sa), ty_void))))
		i = i + 1
	}
	let fe = temp(pos, rt_call(pos, "rt_scope_close_word", args1(sym_ref_node(pos, cast(Sym, sc.sym))), ty_error), ty_error)
	body = append(body, cast(i64, fe))
	cast(Sym, fe.sym).reads = 1
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = mk_bin(pos, "!=", sym_ref_node(pos, cast(Sym, fe.sym)), mk_int(pos, 0, ty_error), ty_bool)
	ifs.then = empty_block(pos)
	mut vs6 = cast(Block, ifs.then).stmts
	vs6 = append(vs6, fault_return(pos, cast(Block, ifs.then).stmts, sym_ref_node(pos, cast(Sym, fe.sym))))
	body = append(body, cast(i64, ifs))
	let ret = cast(ReturnStmt, node_new(ST_RETURN, pos))
	mut rv = []i64{}
	i = 0
	for i < n {
		rv = append(rv, mk_mem(pos, sym_ref_node(pos, cast(Sym, r.sym)), 0, 0, cells[i], vts[i]))
		i = i + 1
	}
	rv = append(rv, mk_int(pos, 0, ty_error))
	ret.values = cast([]i64, rv)
	body = append(body, cast(i64, ret))
	ck_fn = saved_fn
	return cast(i64, f)
}

// bound_int_arg checks a boundary argument (a duration or a size) as an i64.
fn bound_int_arg(a i64) i64 {
	let at = chk(cast(Node, a), ty_int)
	check_assignable(cast(Node, a), at, cast(Ty, ty_int))
	if is_untyped(at) != 0 {
		reconvert(cast(Node, a), ty_int)
	}
	return a
}

// bound_leaves rejects a return that would leave a boundary block from inside it.
fn bound_leaves(v []i64) {
	mut i = 0
	for i < len(v) {
		let s = v[i]
		let k = cast(Node, s).kind
		if k == ST_RETURN {
			err_code_at(cast(Node, s).pos, "E650 BOUNDARY", "return cannot leave a boundary block: its value is its last expression (use fail to leave it with a fault)")
		} else if k == ST_BLOCK {
			bound_leaves(cast(Block, s).stmts)
		} else if k == ST_IF {
			bound_leaves(cast(Block, cast(IfStmt, s).then).stmts)
			if cast(IfStmt, s).else_ != 0 {
				bound_leaves(cast([]i64, one_elem_slice(cast(IfStmt, s).else_)))
			}
		} else if k == ST_WHILE {
			bound_leaves(cast(Block, cast(WhileStmt, s).body).stmts)
		} else if k == ST_RANGE {
			bound_leaves(cast(Block, cast(RangeStmt, s).body).stmts)
		} else if mt_stmt_expr(s) != 0 && cast(Node, mt_stmt_expr(s)).kind == EX_MATCH {
			let arms = cast(MatchExpr, mt_stmt_expr(s)).arms
			mut ai = 0
			for ai < len(arms) {
				if cast(MatchArm, cast([]i64, arms[ai])).block != 0 {
					bound_leaves(cast(Block, cast(MatchArm, cast([]i64, arms[ai])).body).stmts)
				}
				ai = ai + 1
			}
		}
		i = i + 1
	}
}

fn one_elem_slice(x i64) i64 {
	mut v = []i64{}
	v = append(v, x)
	return cast(i64, v)
}

// boundary_wrapper builds boundary$N(c, a): it runs closure c (type ct) with a result_cell-sized result
// cell inside the boundary and returns the value of type vt (ty_void: none) or the fault.
fn boundary_wrapper(pos i64, kind i64, ct i64, vt i64) i64 {
	lifted_count = lifted_count + 1
	let f = fn_new(pos, "boundary")
	let nb = buf_new()
	buf_str(nb, "boundary$")
	buf_int(nb, lifted_count)
	f.qname = str(nb)
	f.name = str(nb)
	f.lifted = 2
	f.file = ck_file
	f.bang = 1
	f.params = append(f.params, "c")
	f.ptypes = append(f.ptypes, ct)
	f.params = append(f.params, "a")
	f.ptypes = append(f.ptypes, ty_int)
	f.params = append(f.params, "a2")
	f.ptypes = append(f.ptypes, ty_int)
	if kind_of(cast(Ty, vt)) != K_VOID {
		f.rtypes = append(f.rtypes, vt)
	}
	f.rtypes = append(f.rtypes, ty_error)
	f.type_ = func_of(f.ptypes, f.rtypes, 0)
	f.locals = cast([]Sym, []i64{})
	f.body = empty_block(pos)
	prog_fns = append(prog_fns, cast(Fn, f))
	let saved_fn = ck_fn
	ck_fn = cast(Fn, f)
	let cs = sym_new(SYM_LOCAL, "c", pos)
	cs.type_ = ct
	cs.slot = 0
	let asym = sym_new(SYM_LOCAL, "a", pos)
	asym.type_ = ty_int
	asym.slot = 1
	let a2sym = sym_new(SYM_LOCAL, "a2", pos)
	a2sym.type_ = ty_int
	a2sym.slot = 2
	f.slots = 3
	mut vs9 = cast([]i64, f.locals)
	vs9 = append(vs9, cast(i64, cs))
	mut vs10 = cast([]i64, f.locals)
	vs10 = append(vs10, cast(i64, asym))
	mut vs11 = cast([]i64, f.locals)
	vs11 = append(vs11, cast(i64, a2sym))
	mut body = cast(Block, f.body).stmts
	let r = temp(pos, rt_call(pos, "rt_alloc", args1(mk_int(pos, result_cell(vt), ty_int)), ty_int), ty_int)
	body = append(body, cast(i64, r))
	let rref = sym_ref_node(pos, cast(Sym, r.sym))
	mut fe = cast(LetStmt, 0)
	if kind == BOUND_GUARD {
		fe = temp(pos, rt_call(pos, "rt_guard_call", args2(sym_ref_node(pos, cs), rref), ty_error), ty_error)
		body = append(body, cast(i64, fe))
	} else if kind == BOUND_LIMIT {
		mut la = cast([]i64, args2(sym_ref_node(pos, cs), sym_ref_node(pos, cast(Sym, r.sym))))
		la = append(la, sym_ref_node(pos, asym))
		la = append(la, sym_ref_node(pos, a2sym))
		fe = temp(pos, rt_call(pos, "rt_limit_call", cast(i64, la), ty_error), ty_error)
		body = append(body, cast(i64, fe))
	} else {
		mut wa = cast([]i64, args2(sym_ref_node(pos, cs), sym_ref_node(pos, cast(Sym, r.sym))))
		wa = append(wa, sym_ref_node(pos, asym))
		fe = temp(pos, rt_call(pos, "rt_within_call", cast(i64, wa), ty_error), ty_error)
		body = append(body, cast(i64, fe))
	}
	cast(Sym, fe.sym).reads = 1
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = mk_bin(pos, "!=", sym_ref_node(pos, cast(Sym, fe.sym)), mk_int(pos, 0, ty_error), ty_bool)
	ifs.then = empty_block(pos)
	mut vs12 = cast(Block, ifs.then).stmts
	vs12 = append(vs12, fault_return(pos, cast(Block, ifs.then).stmts, sym_ref_node(pos, cast(Sym, fe.sym))))
	body = append(body, cast(i64, ifs))
	let ret = cast(ReturnStmt, node_new(ST_RETURN, pos))
	if kind_of(cast(Ty, vt)) == K_VOID {
		ret.value = mk_int(pos, 0, ty_error)
	} else {
		mut rv = []i64{}
		rv = append(rv, mk_mem(pos, sym_ref_node(pos, cast(Sym, r.sym)), 0, 0, 0, vt))
		rv = append(rv, mk_int(pos, 0, ty_error))
		ret.values = cast([]i64, rv)
	}
	body = append(body, cast(i64, ret))
	ck_fn = saved_fn
	return cast(i64, f)
}

// ---- arena (#236, design/interface_arena.md) ----
//
// arena { body } becomes arena$N(c): c is the block's closure func($r i64) !, as for the other
// boundary blocks. arena$N opens the arena, runs c, switches back to the parent pool, copies
// the fault and the value there (arenacopy$N) and frees the arena. A block whose body cannot
// fail has the type of its value; one that can is a !T, used with try or catch.
shared mut ck_arenas []i64 // the closures arena blocks became (region.tin: nothing else leaves them)
shared mut arena_check_fn i64 // the arena closure being checked
shared mut arena_fail_count i64 // fault returns made in it (fault_return)

fn chk_arena(e i64) i64 {
	let pos = cast(Node, e).pos
	let body = cast(Block, cast(BoundaryStmt, e).body)
	bound_leaves(body.stmts)
	let f = fn_new(pos, "func")
	f.params = append(f.params, "$r")
	let it = cast(TypeExpr, node_new(TX_NAME, pos))
	cast(TypeName, it).name = "i64"
	f.ptypes = append(f.ptypes, cast(i64, it))
	let ft = cast(TypeExpr, node_new(TX_NAME, pos))
	cast(TypeName, ft).name = "fault"
	f.rtypes = append(f.rtypes, cast(i64, ft))
	f.bang = 1
	let stmts = body.stmts
	let n = len(stmts)
	if n > 0 && cast(Node, stmts[n - 1]).kind == ST_EXPR {
		let last = stmts[n - 1]
		let bs = cast(ExprStmt, node_new(ST_BSTORE, cast(Node, last).pos))
		bs.x = cast(ExprStmt, last).x
		stmts[n - 1] = cast(i64, bs)
	}
	f.body = cast(i64, body)
	if cast(i64, ck_arenas) == 0 {
		ck_arenas = []i64{}
	}
	ck_arenas = append(ck_arenas, cast(i64, f))
	let lit = cast(FuncLit, node_new(EX_FUNCLIT, pos))
	lit.fn_ = cast(i64, f)
	lit.escape = 0
	let saved_t = bound_t
	let saved_fn = arena_check_fn
	let saved_count = arena_fail_count
	bound_t = ty_void
	arena_check_fn = cast(i64, f)
	arena_fail_count = 0
	let ct = chk_funclit(cast(i64, lit))
	let vt = bound_t
	let fails = i64(arena_fail_count > 0)
	bound_t = saved_t
	arena_check_fn = saved_fn
	arena_fail_count = saved_count
	arena_value_check(pos, vt)
	let w = cast(Fn, arena_wrapper(pos, ct, vt, fails))
	let c = node_new(EX_CALL, pos)
	cast(Call, c).name = w.name
	cast(Call, c).fn_ = cast(i64, w)
	cast(Call, c).args = cast([]i64, args1(cast(i64, lit)))
	mut results = []i64{}
	if kind_of(cast(Ty, vt)) != K_VOID {
		results = append(results, vt)
	}
	if fails != 0 {
		results = append(results, ty_error)
	}
	mut rt = ty_void
	if len(cast([]i64, results)) == 1 {
		rt = results[0]
	} else if len(cast([]i64, results)) > 1 {
		rt = tuple_of(cast(i64, results))
	}
	cast(Node, c).type_ = rt
	replace_node(e, c)
	return rt
}

// arena_value_check reports a value type the arena cannot copy out: one holding a func or dyn
// value (their objects are not described by the type). A recursive one is copied object by
// object, and a cycle in it panics (#628).
fn arena_value_check(pos i64, vt i64) {
	mut bad = ""
	if arena_copyable(cast(Ty, vt), []i64{}) == 0 {
		bad = " holds a func or dyn value, which cannot be copied: return the data it needs instead"
	}
	if i64(byte_at(bad, 0)) != 0 {
		let m = err_code(pos, "E316 ARENA_VALUE")
		buf_str(m, "an arena block's value is copied out of the arena, but type ")
		type_name(cast([]u8, m), cast(Ty, vt))
		buf_str(m, bad)
		err_end(cast([]u8, m))
	}
}

// arena_wrapper builds arena$N(c): it runs closure c (type ct) with a result cell (result_cell) in
// a new arena and returns the copied value of type vt (ty_void: none), and the fault if fails.
fn arena_wrapper(pos i64, ct i64, vt i64, fails i64) i64 {
	lifted_count = lifted_count + 1
	let f = fn_new(pos, "arena")
	let nb = buf_new()
	buf_str(nb, "arena$")
	buf_int(nb, lifted_count)
	f.qname = str(nb)
	f.name = str(nb)
	f.lifted = 2
	f.file = ck_file
	f.bang = fails
	f.params = append(f.params, "c")
	f.ptypes = append(f.ptypes, ct)
	if kind_of(cast(Ty, vt)) != K_VOID {
		f.rtypes = append(f.rtypes, vt)
	}
	if fails != 0 {
		f.rtypes = append(f.rtypes, ty_error)
	}
	f.type_ = func_of(f.ptypes, f.rtypes, 0)
	f.locals = cast([]Sym, []i64{})
	f.body = empty_block(pos)
	prog_fns = append(prog_fns, cast(Fn, f))
	let saved_fn = ck_fn
	ck_fn = cast(Fn, f)
	let cs = sym_new(SYM_LOCAL, "c", pos)
	cs.type_ = ct
	cs.slot = 0
	f.slots = 1
	mut vs5 = cast([]i64, f.locals)
	vs5 = append(vs5, cast(i64, cs))
	mut body = cast(Block, f.body).stmts
	let a = temp(pos, rt_call(pos, "rt_arena_open", cast(i64, []i64{}), ty_int), ty_int)
	body = append(body, cast(i64, a))
	// The result cell lives in the arena, so an arena leaves nothing in the enclosing pool:
	// a plain program's loop of arenas stays flat (#629).
	let r = temp(pos, rt_call(pos, "rt_alloc", args1(mk_int(pos, result_cell(vt), ty_int)), ty_int), ty_int)
	body = append(body, cast(i64, r))
	let fe = temp(pos, rt_call(pos, "rt_arena_run", args2(sym_ref_node(pos, cs), sym_ref_node(pos, cast(Sym, r.sym))), ty_error), ty_error)
	body = append(body, cast(i64, fe))
	cast(Sym, fe.sym).reads = 1
	body = append(body, expr_stmt(cast(Node, rt_call(pos, "rt_arena_out", args1(sym_ref_node(pos, cast(Sym, a.sym))), ty_void))))
	body = append(body, assign_stmt(pos, sym_ref_node(pos, cast(Sym, fe.sym)), rt_call(pos, "rt_arena_fault", args1(sym_ref_node(pos, cast(Sym, fe.sym))), ty_error)))
	// The value is read out of the cell before the arena closes.
	mut v = cast(LetStmt, 0)
	if kind_of(cast(Ty, vt)) != K_VOID {
		v = temp(pos, mk_mem(pos, sym_ref_node(pos, cast(Sym, r.sym)), 0, 0, 0, vt), vt)
		body = append(body, cast(i64, v))
	}
	if is_ref(vt) != 0 || value_has_ref(cast(Ty, vt)) != 0 {
		// A value struct's references are copied out too (#669).
		let ifs = cast(IfStmt, node_new(ST_IF, pos))
		ifs.cond = mk_bin(pos, "==", sym_ref_node(pos, cast(Sym, fe.sym)), mk_int(pos, 0, ty_error), ty_bool)
		ifs.then = empty_block(pos)
		mut vs6 = cast(Block, ifs.then).stmts
		vs6 = append(vs6, assign_stmt(pos, sym_ref_node(pos, cast(Sym, v.sym)), keep_call(pos, arenacopy_fn(cast(Ty, vt)), sym_ref_node(pos, cast(Sym, v.sym)), vt)))
		body = append(body, cast(i64, ifs))
	}
	body = append(body, expr_stmt(cast(Node, rt_call(pos, "rt_arena_close", args1(sym_ref_node(pos, cast(Sym, a.sym))), ty_void))))
	if fails != 0 {
		let ifs2 = cast(IfStmt, node_new(ST_IF, pos))
		ifs2.cond = mk_bin(pos, "!=", sym_ref_node(pos, cast(Sym, fe.sym)), mk_int(pos, 0, ty_error), ty_bool)
		ifs2.then = empty_block(pos)
		mut vs7 = cast(Block, ifs2.then).stmts
		vs7 = append(vs7, fault_return(pos, cast(Block, ifs2.then).stmts, sym_ref_node(pos, cast(Sym, fe.sym))))
		body = append(body, cast(i64, ifs2))
	}
	let ret = cast(ReturnStmt, node_new(ST_RETURN, pos))
	mut rv = []i64{}
	if kind_of(cast(Ty, vt)) != K_VOID {
		rv = append(rv, sym_ref_node(pos, cast(Sym, v.sym)))
	}
	if fails != 0 {
		rv = append(rv, mk_int(pos, 0, ty_error))
	}
	if len(cast([]i64, rv)) == 1 {
		ret.value = rv[0]
	} else if len(cast([]i64, rv)) > 1 {
		ret.values = cast([]i64, rv)
	}
	body = append(body, cast(i64, ret))
	ck_fn = saved_fn
	return cast(i64, f)
}

// ---- with policies (#237, design/interface_policy.md) ----
//
// with p { body } is with$N(c, p): c is the block's closure func($r i64) !, as for the other
// boundary blocks. with$N enters a bkWith boundary, calls p.Run with an adapter func() !T that
// runs c and gives the value c stored, leaves the boundary and returns what Run gave.
shared mut with_fill_calls []i64 // the policy calls whose open type parameters take with_fill_t (generic_call)
shared mut with_fill_t i64
shared mut with_runs []i64 // [Run method, with position] pairs: Run may only call its body (region.tin)

fn chk_with(e i64) i64 {
	let pos = cast(Node, e).pos
	let body = cast(Block, cast(BoundaryStmt, e).body)
	bound_leaves(body.stmts)
	let f = fn_new(pos, "func")
	f.params = append(f.params, "$r")
	let it = cast(TypeExpr, node_new(TX_NAME, pos))
	cast(TypeName, it).name = "i64"
	f.ptypes = append(f.ptypes, cast(i64, it))
	let ft = cast(TypeExpr, node_new(TX_NAME, pos))
	cast(TypeName, ft).name = "fault"
	f.rtypes = append(f.rtypes, cast(i64, ft))
	f.bang = 1
	let stmts = body.stmts
	let n = len(stmts)
	if n > 0 && cast(Node, stmts[n - 1]).kind == ST_EXPR {
		let last = stmts[n - 1]
		let bs = cast(ExprStmt, node_new(ST_BSTORE, cast(Node, last).pos))
		bs.x = cast(ExprStmt, last).x
		stmts[n - 1] = cast(i64, bs)
	}
	f.body = cast(i64, body)
	let lit = cast(FuncLit, node_new(EX_FUNCLIT, pos))
	lit.fn_ = cast(i64, f)
	lit.escape = 0
	let saved_t = bound_t
	bound_t = ty_void
	let ct = chk_funclit(cast(i64, lit))
	let vt = bound_t
	bound_t = saved_t
	// The policy, after the block: the type parameters its constructor (and the calls whose
	// receiver it is) leave open are the block's type, u8 for a block without a value.
	let pe = cast(Node, cast(BoundaryStmt, e).args[0])
	let saved_calls = with_fill_calls
	let saved_fill = with_fill_t
	with_fill_calls = []i64{}
	with_fill_t = vt
	if kind_of(cast(Ty, vt)) == K_VOID {
		with_fill_t = ty_byte
	}
	mut x = pe
	for cast(Node, x).kind == EX_CALL {
		with_fill_calls = append(with_fill_calls, cast(i64, x))
		let cx = cast(Call, x).callee
		if cx == 0 || cast(Node, cx).kind != EX_SELECT {
			break
		}
		x = cast(Node, cast(SelectExpr, cx).x)
	}
	let pt = cast(Ty, chk(cast(Node, pe), 0))
	with_fill_calls = saved_calls
	with_fill_t = saved_fill
	if kind_of(pt) == K_DYN {
		err_code_type(pe.pos, "E652 POLICY", "a with policy is called directly so that its Run can be checked: use the concrete type, not ", cast(i64, pt), "")
		return with_failed(cast(Node, e), vt)
	}
	mut run = cast(Fn, 0)
	if kind_of(pt) == K_STRUCT {
		run = find_fn(pt.name + "." + "Run")
	}
	if cast(i64, run) == 0 {
		err_code_type(pe.pos, "E652 POLICY", "", cast(i64, pt), " is not a policy: with needs a value with a method Run(body func() !T) !T")
		return with_failed(cast(Node, e), vt)
	}
	// Run(body func() !T) !T, or Run(body func() !) !: the body has Run's own results.
	let rps = run.ptypes
	let rrs = run.rtypes
	let bt = func_of([]i64{}, cast([]i64, rrs), 0)
	mut tt = ty_void
	if len(rrs) == 2 {
		tt = rrs[0]
	}
	let shaped = i64(run.bang != 0 && len(rps) == 2 && rps[1] == bt && run.muts[1] == 0)
	if shaped == 0 || len(rrs) < 1 || len(rrs) > 2 || kind_of(cast(Ty, rrs[len(rrs) - 1])) != K_ERROR {
		err_code_type(pe.pos, "E652 POLICY", "", cast(i64, pt), " is not a policy: its Run must be Run(body func() !T) !T")
		return with_failed(cast(Node, e), vt)
	}
	if kind_of(cast(Ty, vt)) != K_VOID && kind_of(cast(Ty, tt)) == K_VOID {
		with_error(pos, "the block gives a ", vt, ", but the Run of its policy ", cast(i64, pt), " runs a body without a value")
		return with_failed(cast(Node, e), vt)
	}
	if kind_of(cast(Ty, vt)) != K_VOID && tt != vt {
		err_code_types(pos, "E652 POLICY", "the block gives a ", vt, ", but its policy runs a body of type ", bt)
		return with_failed(cast(Node, e), vt)
	}
	if kind_of(cast(Ty, vt)) == K_VOID && kind_of(cast(Ty, tt)) != K_VOID && with_scalar(tt) == 0 {
		with_error(pos, "the block gives no value, but its policy ", cast(i64, pt), " needs one of type ", tt, "")
		return with_failed(cast(Node, e), vt)
	}
	let w = cast(Fn, with_wrapper(pos, ct, cast(i64, pt), bt, tt, vt))
	let c = node_new(EX_CALL, pos)
	cast(Call, c).name = w.name
	cast(Call, c).fn_ = cast(i64, w)
	cast(Call, c).args = cast([]i64, args2(cast(i64, lit), cast(i64, pe)))
	mut rt = ty_error
	if kind_of(cast(Ty, vt)) != K_VOID {
		mut results = []i64{}
		results = append(results, vt)
		results = append(results, ty_error)
		rt = tuple_of(cast(i64, results))
	}
	cast(Node, c).type_ = rt
	replace_node(e, c)
	return rt
}

// with_failed stands in for a with that was rejected: a call of the type the with would have,
// so its catch or try reports nothing more.
fn with_failed(e Node, vt i64) i64 {
	mut rt = ty_error
	if kind_of(cast(Ty, vt)) != K_VOID {
		mut results = []i64{}
		results = append(results, vt)
		results = append(results, ty_error)
		rt = tuple_of(cast(i64, results))
	}
	let c = node_new(EX_CALL, e.pos)
	cast(Call, c).name = "with"
	cast(Call, c).args = []i64{}
	cast(Node, c).type_ = rt
	replace_node(cast(i64, e), c)
	return rt
}

// with_error reports a with block whose value does not fit its policy.
fn with_error(pos i64, a str, ta i64, b str, tb i64, c str) {
	let m = err_code(pos, "E652 POLICY")
	buf_str(m, a)
	type_name(cast([]u8, m), cast(Ty, ta))
	buf_str(m, b)
	type_name(cast([]u8, m), cast(Ty, tb))
	buf_str(m, c)
	err_end(cast([]u8, m))
}

// with_scalar reports whether a body without a value can give t's zero to its policy.
fn with_scalar(t i64) i64 {
	let k = kind_of(cast(Ty, t))
	return i64(k == K_INT || k == K_BYTE || k == K_BOOL || is_float_t(t) != 0)
}

// with_wrapper builds with$N(c, p) for policy type pt, whose Run takes a body of type bt
// giving tt (ty_void: none); the with gives vt (ty_void: none). The adapter's descriptor
// [code, 2, c, cell, 0] and the value cell live on with$N's frame, which outlives every run
// of the body because Run cannot keep it (design/interface_policy.md §3). p is mut so that a
// Run with a mut receiver may change it; the region pass judges the with's own policy value.
fn with_wrapper(pos i64, ct i64, pt i64, bt i64, tt i64, vt i64) i64 {
	let rmut = 1
	lifted_count = lifted_count + 1
	let f = fn_new(pos, "with")
	let nb = buf_new()
	buf_str(nb, "with$")
	buf_int(nb, lifted_count)
	f.qname = str(nb)
	f.name = str(nb)
	f.lifted = 2
	f.done = 1
	f.file = ck_file
	f.bang = 1
	f.params = append(f.params, "c")
	f.ptypes = append(f.ptypes, ct)
	f.muts = append(f.muts, 0)
	f.params = append(f.params, "$p")
	f.ptypes = append(f.ptypes, pt)
	f.muts = append(f.muts, rmut)
	if kind_of(cast(Ty, vt)) != K_VOID {
		f.rtypes = append(f.rtypes, vt)
	}
	f.rtypes = append(f.rtypes, ty_error)
	f.type_ = func_of_m(f.ptypes, f.rtypes, 0, mut_mask(f.muts))
	f.locals = cast([]Sym, []i64{})
	f.body = empty_block(pos)
	prog_fns = append(prog_fns, cast(Fn, f))
	let adapt = with_adapter(pos, f, ct, cast(Ty, bt), tt, vt)
	let saved_fn = ck_fn
	ck_fn = cast(Fn, f)
	let cs = sym_new(SYM_LOCAL, "c", pos)
	cs.type_ = ct
	cs.slot = 0
	cs.reads = 1
	let ps = sym_new(SYM_LOCAL, "$p", pos)
	ps.type_ = pt
	ps.slot = 1
	ps.mut_ = rmut
	ps.reads = 1
	f.slots = 2
	mut vs9 = cast([]i64, f.locals)
	vs9 = append(vs9, cast(i64, cs))
	mut vs10 = cast([]i64, f.locals)
	vs10 = append(vs10, cast(i64, ps))
	mut body = cast(Block, f.body).stmts
	let cell = cast(Sym, declare_local(pos, "$cell", ty_int))
	cell.addr = 1
	cell.words = 2
	let desc = cast(Sym, declare_local(pos, "$desc", ty_int))
	desc.addr = 1
	desc.words = 5
	let da = temp(pos, mk_unary(pos, "&", sym_ref_node(pos, desc)), ty_int)
	body = append(body, cast(i64, da))
	let code = node_new(EX_FUNCREF, pos)
	cast(FuncRef, code).fn_ = adapt
	cast(FuncRef, code).raw = 1
	cast(Node, code).type_ = ty_int
	body = append(body, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, cast(Sym, da.sym)), 0, 0, 0, ty_int), code))
	body = append(body, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, cast(Sym, da.sym)), 0, 0, 8, ty_int), mk_int(pos, 2, ty_int)))
	body = append(body, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, cast(Sym, da.sym)), 0, 0, 16, ct), sym_ref_node(pos, cs)))
	body = append(body, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, cast(Sym, da.sym)), 0, 0, 24, ty_int), mk_unary(pos, "&", sym_ref_node(pos, cell))))
	body = append(body, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, cast(Sym, da.sym)), 0, 0, 32, ty_int), mk_int(pos, 0, ty_int)))
	let dv = temp(pos, sym_ref_node(pos, cast(Sym, da.sym)), bt)
	body = append(body, cast(i64, dv))
	let bd = temp(pos, rt_call(pos, "rt_bnd_enter", args1(mk_int(pos, 10, ty_int)), ty_int), ty_int)
	body = append(body, cast(i64, bd))
	// p.Run(adapter), checked like any method call.
	let sel = cast(SelectExpr, node_new(EX_SELECT, pos))
	sel.x = sym_ref_node(pos, ps)
	sel.name = "Run"
	let call = node_new(EX_CALL, pos)
	cast(Call, call).callee = cast(i64, sel)
	cast(Call, call).args = cast([]i64, args1(sym_ref_node(pos, cast(Sym, dv.sym))))
	chk(cast(Node, call), 0)
	if cast(i64, with_runs) == 0 {
		with_runs = []i64{}
	}
	mut vs11 = cast([]i64, with_runs)
	vs11 = append(vs11, cast(Call, call).fn_)
	mut vs12 = cast([]i64, with_runs)
	vs12 = append(vs12, pos)
	mut vs = 0
	mut fes = cast(Sym, 0)
	if kind_of(cast(Ty, tt)) != K_VOID {
		let cm = cast(CallMultiStmt, node_new(ST_CALLMULTI, pos))
		cm.call = call
		cm.syms = cast([]Sym, []i64{})
		vs = declare_local(pos, "$", tt)
		fes = cast(Sym, declare_local(pos, "$", ty_error))
		mut vs13 = cast([]i64, cm.syms)
		vs13 = append(vs13, vs)
		mut vs14 = cast([]i64, cm.syms)
		vs14 = append(vs14, cast(i64, fes))
		cast(Node, call).type_ = ty_void
		body = append(body, cast(i64, cm))
	} else {
		let fe = temp(pos, call, ty_error)
		body = append(body, cast(i64, fe))
		fes = cast(Sym, fe.sym)
	}
	fes.reads = 1
	body = append(body, expr_stmt(cast(Node, rt_call(pos, "rt_bnd_leave", args1(sym_ref_node(pos, cast(Sym, bd.sym))), ty_void))))
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = mk_bin(pos, "!=", sym_ref_node(pos, fes), mk_int(pos, 0, ty_error), ty_bool)
	ifs.then = empty_block(pos)
	mut vs15 = cast(Block, ifs.then).stmts
	vs15 = append(vs15, fault_return(pos, cast(Block, ifs.then).stmts, sym_ref_node(pos, fes)))
	body = append(body, cast(i64, ifs))
	let ret = cast(ReturnStmt, node_new(ST_RETURN, pos))
	if kind_of(cast(Ty, vt)) == K_VOID {
		ret.value = mk_int(pos, 0, ty_error)
	} else {
		mut rv = []i64{}
		rv = append(rv, sym_ref_node(pos, cast(Sym, vs)))
		rv = append(rv, mk_int(pos, 0, ty_error))
		ret.values = cast([]i64, rv)
	}
	body = append(body, cast(i64, ret))
	ck_fn = saved_fn
	return cast(i64, f)
}

// with_adapter builds with$N$body, the func() !T a policy runs: its closure environment (X17)
// is with$N's descriptor; it calls the block's closure with the cell and gives the value.
fn with_adapter(pos i64, w Fn, ct i64, bt Ty, tt i64, vt i64) i64 {
	let a = fn_new(pos, "func")
	let nb = buf_new()
	buf_str(nb, w.name)
	buf_str(nb, "$body")
	a.qname = str(nb)
	a.name = str(nb)
	a.lifted = 2
	a.done = 1
	a.file = ck_file
	a.bang = 1
	mut i = 0
	for i < len(bt.results) {
		a.rtypes = append(a.rtypes, bt.results[i])
		i = i + 1
	}
	a.type_ = cast(i64, bt)
	a.locals = cast([]Sym, []i64{})
	a.body = empty_block(pos)
	prog_fns = append(prog_fns, cast(Fn, a))
	let saved_fn = ck_fn
	ck_fn = cast(Fn, a)
	let env = cast(Sym, declare_local(pos, "$env", ty_int))
	env.reads = 1
	a.env_sym = cast(i64, env)
	mut body = cast(Block, a.body).stmts
	let call = cast(Call, node_new(EX_CALL, pos))
	call.callee = mk_mem(pos, sym_ref_node(pos, env), 0, 0, 16, ct)
	call.args = cast([]i64, args1(mk_mem(pos, sym_ref_node(pos, env), 0, 0, 24, ty_int)))
	chk(cast(Node, call), 0)
	let fe = temp(pos, cast(i64, call), ty_error)
	body = append(body, cast(i64, fe))
	cast(Sym, fe.sym).reads = 1
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = mk_bin(pos, "!=", sym_ref_node(pos, cast(Sym, fe.sym)), mk_int(pos, 0, ty_error), ty_bool)
	ifs.then = empty_block(pos)
	mut vs2 = cast(Block, ifs.then).stmts
	vs2 = append(vs2, fault_return(pos, cast(Block, ifs.then).stmts, sym_ref_node(pos, cast(Sym, fe.sym))))
	body = append(body, cast(i64, ifs))
	let ret = cast(ReturnStmt, node_new(ST_RETURN, pos))
	if kind_of(cast(Ty, tt)) == K_VOID {
		ret.value = mk_int(pos, 0, ty_error)
	} else {
		mut rv = []i64{}
		if kind_of(cast(Ty, vt)) == K_VOID && is_float_t(tt) != 0 {
			rv = append(rv, zero_value(pos, tt))
		} else if kind_of(cast(Ty, vt)) == K_VOID {
			rv = append(rv, mk_int(pos, 0, tt))
		} else {
			rv = append(rv, mk_mem(pos, mk_mem(pos, sym_ref_node(pos, env), 0, 0, 24, ty_int), 0, 0, 0, vt))
		}
		rv = append(rv, mk_int(pos, 0, ty_error))
		ret.values = cast([]i64, rv)
	}
	body = append(body, cast(i64, ret))
	ck_fn = saved_fn
	return cast(i64, a)
}

// ---- calls ----
// mask has bit i set when parameter i is mut: its argument must be written `mut x`
// (a method's receiver, argument 0 of a CALL_METHOD call, is exempt).
fn chk_args(e i64, ptypes []i64, variadic i64, mask i64) {
	let args = cast(Call, e).args
	if variadic == 2 {
		// The last parameter is variadic (#562): the arguments past the others become one
		// []T, made here as a slice literal, unless the call ends in s... (passed as it is).
		let n = len(ptypes)
		let fixed = n - 1
		mut va = cast([]i64, cast(Call, e).args)
		let last = n - 1
		if len(va) == n && cast(Node, va[last]).kind == EX_UNARY && cast(Unary, va[last]).op == "..." {
			va[last] = cast(Unary, va[last]).x
		} else if len(va) >= fixed {
			let lit = cast(Composite, node_new(EX_COMPOSITE, cast(Node, e).pos))
			lit.type_ = node_new(EX_TYPE, cast(Node, e).pos)
			lit.elems = []i64{}
			lit.keys = []i64{}
			mut ai = fixed
			for ai < len(va) {
				lit.elems = append(lit.elems, va[ai])
				lit.keys = append(lit.keys, 0)
				ai = ai + 1
			}
			mut packed = []i64{}
			ai = 0
			for ai < fixed {
				packed = append(packed, va[ai])
				ai = ai + 1
			}
			packed = append(packed, cast(i64, lit))
			cast(Call, e).args = cast([]i64, packed)
		} else {
			let am = err_code(cast(Node, e).pos, "E210 ARG_COUNT")
			if len(cast(Call, e).name) != 0 {
				buf_str(cast([]u8, am), cast(Call, e).name)
			} else {
				buf_str(cast([]u8, am), "function")
			}
			buf_str(cast([]u8, am), " expects at least ")
			buf_int(cast([]u8, am), fixed)
			buf_str(cast([]u8, am), " arguments, got ")
			buf_int(cast([]u8, am), len(va))
			err_end(cast([]u8, am))
			return
		}
		chk_args(e, ptypes, 0, mask)
		return
	}
	let n = len(ptypes)
	if len(args) != n && !(variadic != 0 && len(args) >= n) {
		let a = err_code(cast(Node, e).pos, "E210 ARG_COUNT")
		if len(cast(Call, e).name) != 0 {
			buf_str(cast([]u8, a), cast(Call, e).name)
		} else {
			buf_str(cast([]u8, a), "function")
		}
		buf_str(cast([]u8, a), " expects ")
		buf_int(cast([]u8, a), n)
		buf_str(cast([]u8, a), " arguments, got ")
		buf_int(cast([]u8, a), len(args))
		err_end(cast([]u8, a))
	}
	mut algrow = []str{}
	mut i = 0
	for i < len(args) {
		let a = args[i]
		let marked = unwrap_mut(a)
		if ck_trusted == 0 && marked != 0 && i < len(ptypes) && kind_of(cast(Ty, ptypes[i])) == K_SLICE && al_fn_grows(cast(Fn, cast(Call, e).fn_), i) != 0 {
			// A callee that appends to this mut slice grows the caller's slice (#627).
			let mk = al_place(a, 1)
			if len(mk) != 0 {
				algrow = append(algrow, mk)
				algrow = append(algrow, al_ptext)
			}
		}
		if !(i == 0 && cast(Call, e).method != 0) {
			let pm = i64(i < n && i < 63 && (mask & (1 << i)) != 0)
			if pm != 0 && marked == 0 {
				mut_arg_error(cast(Call, e), cast(Node, a), i, "is a mut parameter: write mut before the argument")
			} else if marked != 0 && pm == 0 {
				mut_arg_error(cast(Call, e), cast(Node, a), i, "is not a mut parameter: remove mut")
			}
		}
		mut want = 0
		if i < n {
			want = ptypes[i]
		}
		let adesc = secret_desc(a)
		let at = chk(cast(Node, a), want)
		if is_value_struct(cast(Ty, at)) != 0 && i < n && i < 63 && (mask & (1 << i)) != 0 {
			// A mut value struct argument (or mut receiver) is written through (#631).
			value_write_check(cast(Node, a).pos, a, 1)
		}
		if cast(Node, a).kind == EX_UNARY && cast(Unary, a).op == "..." {
			// E211 said it already: a spread slice is no argument of the parameter's type.
			i = i + 1
			continue
		}
		if i < n {
			secret_arg(cast(Call, e), i, adesc, at, want)
			check_assignable(cast(Node, a), at, cast(Ty, want))
			secret_arg_done()
			if is_untyped(at) != 0 {
				reconvert(cast(Node, a), want)
			}
		}
		if i >= n && is_untyped(at) != 0 {
			reconvert(cast(Node, a), default_type(at))
		}
		i = i + 1
	}
	i = 0
	for i + 1 < len(algrow) {
		al_grow(cast(Node, e).pos, algrow[i], algrow[i + 1])
		i = i + 2
	}
}

// unwrap_mut turns `mut x` back into x and reports whether it was marked.
fn unwrap_mut(a i64) i64 {
	if cast(Node, a).kind != EX_MUTARG {
		return 0
	}
	shared_let_write(cast(Node, a).pos, cast(MutArg, a).x)
	replace_node(a, cast(MutArg, a).x)
	return 1
}

fn mut_arg_error(e Call, a Node, i i64, what str) {
	let m = err_code(a.pos, "E705 MUT_ARG")
	buf_str(m, "argument ")
	if e.method != 0 {
		buf_int(m, i)
	} else {
		buf_int(m, i + 1)
	}
	buf_str(m, " of ")
	if len(e.name) != 0 {
		buf_str(m, e.name)
	} else {
		buf_str(m, "this call")
	}
	buf_byte(m, ' ')
	buf_str(m, what)
	err_end(cast([]u8, m))
}

fn result_type(f Fn) i64 {
	let rs = f.rtypes
	if len(rs) == 0 {
		return ty_void
	}
	if len(rs) == 1 {
		return rs[0]
	}
	return tuple_of(cast(i64, rs))
}

fn func_result(ft Ty) i64 {
	let rs = ft.results
	if len(rs) == 0 {
		return ty_void
	}
	if len(rs) == 1 {
		return rs[0]
	}
	return tuple_of(cast(i64, rs))
}

fn direct_call(e Call, f Fn) i64 {
	if is_template(f) != 0 {
		return generic_call(cast(i64, e), f)
	}
	e.fn_ = cast(i64, f)
	e.callee = 0
	chk_args(cast(i64, e), f.ptypes, f.variadic, mut_mask(f.muts))
	return result_type(f)
}

// method_with_targs returns "x.m" for a callee x.m[T] where x is a variable whose struct type
// has a method m: methods have no type parameters of their own (#554).
fn method_with_targs(callee i64) str {
	let x = cast(IndexExpr, callee).x
	if cast(Node, x).kind != EX_SELECT || cast(Node, cast(SelectExpr, x).x).kind != EX_IDENT {
		return ""
	}
	let s = lookup_name(cast(IdentExpr, cast(SelectExpr, x).x).name)
	if cast(i64, s) == 0 || (s.kind != SYM_LOCAL && s.kind != SYM_GLOBAL) || s.type_ == 0 {
		return ""
	}
	let t = cast(Ty, s.type_)
	if kind_of(t) != K_STRUCT || cast(i64, find_fn(t.name + "." + cast(SelectExpr, x).name)) == 0 {
		return ""
	}
	return cast(IdentExpr, cast(SelectExpr, x).x).name + "." + cast(SelectExpr, x).name
}

fn chk_call(e i64, want i64) i64 {
	sb_call(cast(Call, e))
	let name = cast(Call, e).name
	let callee = cast(Call, e).callee
	if len(name) != 0 {
		let s = lookup_name(name)
		if cast(i64, s) != 0 && s.kind == SYM_FUNC {
			runtime_use(cast(Node, e).pos, cast(Fn, s.fn_), name)
			return direct_call(cast(Call, e), cast(Fn, s.fn_))
		}
		if cast(i64, s) != 0 && (s.kind == SYM_LOCAL || s.kind == SYM_GLOBAL) && kind_of(cast(Ty, s.type_)) == K_FUNC {
			let id = cast(IdentExpr, node_new(EX_IDENT, cast(Node, e).pos))
			id.name = name
			cast(Call, e).callee = cast(i64, id)
			cast(Call, e).name = ""
			return indirect_call(e)
		}
		if cast(i64, s) == 0 {
			let n = intrinsic_arity(name)
			if n >= 0 {
				if ck_trusted == 0 {
					err_code_quoted(cast(Node, e).pos, "E802 RUNTIME_INTERNAL", "", name, " is internal to the runtime")
				}
				cast(Call, e).intrinsic = 1
				if len(cast(Call, e).args) != n {
					arity_error(e, n)
				}
				mut i = 0
				for i < len(cast(Call, e).args) {
					let a = cast(Call, e).args[i]
					chk(cast(Node, a), ty_int)
					reconvert(cast(Node, a), ty_int)
					i = i + 1
				}
				if name == "load8" {
					return ty_byte
				}
				return ty_int
			}
			let bt = chk_builtin(e, name, want)
			if bt != 0 {
				return bt
			}
			let tt = find_type_name(name)
			if tt != 0 {
				return chk_conversion(e, cast(Ty, tt))
			}
			let u = err_code(cast(Node, e).pos, "E103 UNDEFINED")
			buf_str(u, "undefined function: ")
			buf_str(u, name)
			err_end(cast([]u8, u))
			return ty_int
		}
		err_code_quoted(cast(Node, e).pos, "E215 NOT_CALLABLE", "", name, " is not a function")
		return ty_int
	}
	let gx = explicit_generic(callee)
	if gx != 0 {
		let inst = instantiate_fn(cast(Fn, gx), cast([]Ty, resolve_types(cast([]i64, index_targs(callee)))), cast(Node, e).pos)
		cast(Call, e).name = inst.qname
		return direct_call(cast(Call, e), inst)
	}
	if cast(Node, callee).kind == EX_INDEX && cast(IndexExpr, callee).i == 0 {
		// Type arguments on a function or method that has none (#554): say so, then check the
		// call without them.
		mut ng = not_generic_func(callee)
		if len(ng) == 0 {
			ng = method_with_targs(callee)
		}
		if len(ng) != 0 {
			err_code_quoted(cast(Node, callee).pos, "E501 NOT_GENERIC", "", ng, " is not a generic function")
			let x = cast(IndexExpr, callee).x
			if cast(Node, x).kind == EX_IDENT {
				cast(Call, e).name = cast(IdentExpr, x).name
				cast(Call, e).callee = 0
			} else {
				cast(Call, e).callee = x
			}
			return chk_call(e, want)
		}
		if index_from_targs(callee) == 0 {
			err_code_at(cast(Node, callee).pos, "E501 NOT_GENERIC", "type arguments go only to a generic function or type")
			mut ai = 0
			for ai < len(cast(Call, e).args) {
				chk(cast(Node, cast(Call, e).args[ai]), 0)
				ai = ai + 1
			}
			return ty_int
		}
	}
	if cast(Node, callee).kind == EX_SELECT {
		let x = cast(SelectExpr, callee).x
		let m = cast(SelectExpr, callee).name
		let et = enum_type_of(x)
		if et != 0 {
			return enum_construct(cast(Node, e), cast(Ty, et), m, cast(Call, e).args)
		}
		if cast(Node, x).kind == EX_IDENT && lookup_name_local(cast(IdentExpr, x).name) == 0 && len(import_pkg(cast(IdentExpr, x).name)) != 0 {
			let pkg = import_pkg(cast(IdentExpr, x).name)
			if pkg == "say" && is_say_func(m) != 0 {
				return lower_say(e, m, want)
			}
			if pkg == "argo" && (m == "Put" || m == "PutV2") {
				return lower_argo_put(e, i64(m == "PutV2"))
			}
			if pkg == "argo" && m == "Get" {
				return lower_argo_get(e, 0)
			}
			if pkg == "argo" && m == "GetStrict" {
				return lower_argo_get(e, 1)
			}
			let s = cast(Sym, pkg_member(pkg, m))
			if cast(i64, s) != 0 && is_private(m) != 0 {
				private_use(cast(Node, e).pos, "function", m, pkg)
			}
			if cast(i64, s) != 0 && s.kind == SYM_FUNC {
				cast(Call, e).name = s.name
				return direct_call(cast(Call, e), cast(Fn, s.fn_))
			}
			let pt = find_type(pkg + "." + m)
			if pt != 0 {
				return chk_conversion(e, cast(Ty, pt))
			}
			let ov = cast(Fn, overload(pkg, m, cast(Call, e)))
			if cast(i64, ov) != 0 {
				cast(Call, e).name = ov.qname
				return direct_call(cast(Call, e), ov)
			}
			let u = err_code(cast(Node, e).pos, "E103 UNDEFINED")
			buf_str(u, "undefined: ")
			buf_str(u, cast(IdentExpr, x).name)
			buf_byte(u, '.')
			buf_str(u, m)
			err_end(cast([]u8, u))
			return ty_int
		}
		let xt = cast(Ty, chk(cast(Node, x), 0))
		if kind_of(xt) == K_OPT {
			err_code_type(cast(Node, e).pos, "E421 UNCHECKED_OPTIONAL", "cannot call a method of optional ", cast(i64, xt), " before checking it against nil")
			return ty_int
		}
		if xt.under != 0 {
			// A method of a named non-struct type (#564).
			let nm = find_fn(xt.name + "." + m)
			if cast(i64, nm) != 0 {
				if is_private(m) != 0 && foreign_type(xt) != 0 {
					private_use(cast(Node, e).pos, "method", m, type_pkg(xt))
				}
				mut nargs = []i64{}
				nargs = append(nargs, x)
				mut ni = 0
				for ni < len(cast(Call, e).args) {
					nargs = append(nargs, cast(Call, e).args[ni])
					ni = ni + 1
				}
				cast(Call, e).args = cast([]i64, nargs)
				cast(Call, e).name = nm.qname
				cast(Call, e).method = 1
				return direct_call(cast(Call, e), nm)
			}
			let um = err_code(cast(Node, e).pos, "E214 METHOD")
			type_name(cast([]u8, um), xt)
			buf_str(um, " has no method ")
			buf_str(um, m)
			err_end(cast([]u8, um))
			return ty_int
		}
		if kind_of(xt) == K_STRUCT {
			// s.spawn(f) for f with a value gives a spawnedOf[T] (#232).
			let sv = spawn_value(e, x, cast(i64, xt), m)
			if sv != 0 {
				return sv
			}
			let mf = find_fn(xt.name + "." + m)
			if cast(i64, mf) != 0 && is_private(m) != 0 && foreign_type(xt) != 0 {
				private_use(cast(Node, e).pos, "method", m, type_pkg(xt))
			}
			if cast(i64, mf) != 0 {
				mut args = []i64{}
				args = append(args, x)
				mut i = 0
				for i < len(cast(Call, e).args) {
					args = append(args, cast(Call, e).args[i])
					i = i + 1
				}
				cast(Call, e).args = cast([]i64, args)
				cast(Call, e).name = mf.qname
				cast(Call, e).method = 1
				return direct_call(cast(Call, e), mf)
			}
			let fi = struct_field(xt, m)
			if fi >= 0 && kind_of(cast(Ty, field_type(xt, fi))) == K_FUNC {
				cast(Call, e).callee = mk_mem(cast(Node, e).pos, x, 0, 0, field_offset(xt, fi), field_type(xt, fi))
				return indirect_call(e)
			}
			let u = err_code(cast(Node, e).pos, "E214 METHOD")
			type_name(cast([]u8, u), xt)
			buf_str(u, " has no method ")
			buf_str(u, m)
			err_end(cast([]u8, u))
			return ty_int
		}
		if kind_of(xt) == K_ERROR && m == "Error" {
			replace_node(e, rt_call(cast(Node, e).pos, "rt_err_str", args1(x), ty_string))
			cast(Node, e).type_ = 0
			return ty_string
		}
		if kind_of(xt) == K_DYN {
			return lower_dyn_method_call(e, x, xt, m)
		}
		err_code_type(cast(Node, e).pos, "E214 METHOD", "cannot call a method on ", cast(i64, xt), "")
		return ty_int
	}
	if cast(Node, callee).kind == EX_TYPE {
		return chk_conversion(e, cast(Ty, resolve_type(cast(TypeNode, callee).ty)))
	}
	return indirect_call(e)
}

// lower_dyn_method_call checks the explicit arguments against the flattened shape
// signature, then builds an ordinary indirect call whose first ABI argument is the
// object word and whose callee is the method descriptor loaded from the table.
fn lower_dyn_method_call(e i64, receiver i64, dt Ty, name str) i64 {
	let pos = cast(Node, e).pos
	let info = cast(Pair, dyn_shape_method(dt, name))
	if cast(i64, info) == 0 {
		let m = err_code(pos, "E214 METHOD")
		buf_str(m, "dyn shape ")
		buf_str(m, cast(Decl, dt.gdecl).name)
		buf_str(m, " has no method ")
		buf_str(m, name)
		err_end(cast([]u8, m))
		return ty_int
	}
	let sig = cast(ShapeSig, info.b)
	let names = sig.names
	let ps = sig.types
	let ms = sig.muts
	let rs = sig.results
	let variadic = sig.variadic
	mut mutmask = 0
	mut i = 0
	for i < len(ms) && i < 63 {
		if ms[i] != 0 {
			mutmask = mutmask | (1 << i)
		}
		i = i + 1
	}
	cast(Call, e).name = name
	chk_args(e, ps, variadic, mutmask)

	// A method receiver may itself be an expression with effects. Store its pair once;
	// both the object argument and descriptor lookup then read the same value.
	let receiver_temp = temp(pos, receiver, cast(i64, dt))
	let receiver_ref = sym_ref_node(pos, cast(Sym, receiver_temp.sym))
	let object = mk_conv(pos, receiver_ref, CV_DYN_OBJECT, ty_int)
	mut desc_params = []i64{}
	desc_params = append(desc_params, ty_int)
	i = 0
	for i < len(ps) {
		desc_params = append(desc_params, ps[i])
		i = i + 1
	}
	mut desc_mask = 0
	i = 0
	for i < len(ms) && i < 62 {
		if ms[i] != 0 {
			desc_mask = desc_mask | (1 << (i + 1))
		}
		i = i + 1
	}
	let ft = func_of_m(cast([]i64, desc_params), rs, variadic, desc_mask)
	let desc = cast(Conv, mk_conv(pos, receiver_ref, CV_DYN_DESC, ft))
	desc.dyn_index = info.a

	let inner = node_new(EX_CALL, pos)
	cast(Call, inner).name = name
	cast(Call, inner).args = cast([]i64, args1(object))
	i = 0
	for i < len(cast(Call, e).args) {
		cast(Call, inner).args = append(cast(Call, inner).args, cast(Call, e).args[i])
		i = i + 1
	}
	cast(Call, inner).callee = cast(i64, desc)
	cast(Call, inner).method = 1
	cast(Call, inner).dyn_shape = cast(i64, dt)
	cast(Call, inner).dyn_index = info.a
	cast(Node, inner).type_ = func_result(cast(Ty, ft))
	mut stmts = []i64{}
	stmts = append(stmts, cast(i64, receiver_temp))
	replace_node(e, mk_seq(pos, cast(i64, stmts), inner, cast(Node, inner).type_))
	return cast(Node, inner).type_
}

// overload picks pkg.Name__suffix by the first argument's element type, the stand-in
// for generics in library functions like sift.Sort.
fn overload(pkg str, name str, e Call) i64 {
	let args = e.args
	if len(args) == 0 {
		return 0
	}
	mut t = cast(Ty, chk(cast(Node, args[0]), 0))
	if kind_of(t) == K_SLICE {
		t = cast(Ty, t.elem)
	}
	let b = buf_new()
	buf_str(b, pkg)
	buf_byte(b, '.')
	buf_str(b, name)
	buf_str(b, "__")
	type_name(cast([]u8, b), cast(Ty, default_type(cast(i64, t))))
	return cast(i64, find_fn(str(b)))
}

fn indirect_call(e i64) i64 {
	let callee = cast(Call, e).callee
	// A closure that appends to an outer variable grows its slice when called (#627).
	let algrow = al_closure_grows(al_place(callee, 0))
	let ft = cast(Ty, chk(cast(Node, callee), 0))
	if kind_of(ft) != K_FUNC {
		err_code_type(cast(Node, e).pos, "E215 NOT_CALLABLE", "cannot call a value of type ", cast(i64, ft), "")
		return ty_int
	}
	cast(Call, e).fn_ = 0
	chk_args(e, ft.fields, ft.variadic, ft.key)
	mut gi = 0
	for gi + 1 < len(algrow) {
		al_grow(cast(Node, e).pos, algrow[gi], algrow[gi + 1])
		gi = gi + 2
	}
	return func_result(ft)
}

// lower_append_dyn passes the object and table as separate scalar arguments to the
// runtime append helper. The pair temporary evaluates a conversion or other expression
// once, and the region pass still sees its object bits through both projections.
fn lower_append_dyn(pos i64, slice i64, value i64, st Ty) i64 {
	let et = st.elem
	let vn = cast(Node, value)
	if is_shape_value(cast(Ty, et)) == 0 && vn.kind == EX_CONV && cast(Conv, value).kind == CV_OPT_SOME {
		// A number made optional here: its two words go straight to the call (#632).
		return rt_call(pos, "rt_append_pair", args3(slice, mk_int(pos, 1, ty_int), cast(Conv, value).x), cast(i64, st))
	}
	if is_shape_value(cast(Ty, et)) == 0 && vn.kind == EX_INT && cast(IntLit, value).val == 0 {
		return rt_call(pos, "rt_append_pair", args3(slice, mk_int(pos, 0, ty_int), mk_int(pos, 0, ty_int)), cast(i64, st))
	}
	let saved = temp(pos, value, et)
	let ref_ = sym_ref_node(pos, cast(Sym, saved.sym))
	let object = mk_conv(pos, ref_, CV_DYN_OBJECT, ty_int)
	let table = mk_conv(pos, ref_, CV_DYN_TABLE_WORD, ty_int)
	mut fname = "rt_append_dyn"
	if is_shape_value(cast(Ty, et)) == 0 {
		// An optional number's two words, with no object to count (#632).
		fname = "rt_append_pair"
	}
	let call = rt_call(pos, fname, args3(slice, object, table), cast(i64, st))
	mut stmts = []i64{}
	stmts = append(stmts, cast(i64, saved))
	return mk_seq(pos, cast(i64, stmts), call, cast(i64, st))
}

fn find_type_name(name str) i64 {
	if len(ck_pkg) != 0 {
		let t = find_type(qual(ck_pkg, name))
		if t != 0 {
			return t
		}
	}
	return find_type(name)
}

fn arg0(e Call) i64 {
	return e.args[0]
}

fn chk_conversion(e i64, to Ty) i64 {
	let pos = cast(Node, e).pos
	if len(cast(Call, e).args) != 1 {
		err_code_type(pos, "E210 ARG_COUNT", "conversion to ", cast(i64, to), " needs exactly one argument")
		return cast(i64, to)
	}
	if to.under != 0 && to.secret_ == 0 {
		// A named type converts as its underlying type does, then takes the name (#564).
		let bt = chk_conversion(e, cast(Ty, to.under))
		if kind_of(cast(Ty, bt)) == K_FLOAT || kind_of(cast(Ty, bt)) == K_INT || cast(i64, bt) == to.under {
			let inner = expr_clone(e)
			replace_node(e, mk_conv(pos, inner, CV_SAME, cast(i64, to)))
		}
		return cast(i64, to)
	}
	let x = arg0(cast(Call, e))
	let from = cast(Ty, chk(cast(Node, x), cast(i64, to)))
	if saw_secret != 0 && (is_secret(from) != 0 || is_secret(to) != 0) {
		return secret_conversion(e, cast(Node, x), from, cast(i64, to))
	}
	if from.under != 0 && from.under == cast(i64, to) {
		// The named type's own value, seen as its underlying type: f64(c), []i64(ids) (#564).
		replace_node(e, mk_conv(pos, x, CV_SAME, cast(i64, to)))
		return cast(i64, to)
	}
	let fk = kind_of(from)
	let tk = kind_of(to)
	if cast(i64, from) == cast(i64, to) || (is_untyped(cast(i64, from)) != 0 && assignable(from, to) != 0) {
		if is_untyped(cast(i64, from)) != 0 {
			reconvert(cast(Node, x), cast(i64, to))
		}
		if tk == K_FLOAT && cast(Node, x).kind == EX_BINARY && cast(Binary, x).op == "*" {
			// f64(x * y) + z: the conversion rounds the product, so arm64 must not fuse it into a multiply-add, as in Go
			// (spec, Floating-point operators). The node is a no-op for the code generator, which looks for the multiply.
			replace_node(e, mk_conv(pos, x, CV_SAME, cast(i64, to)))
			return cast(i64, to)
		}
		replace_node(e, x)
		return cast(i64, to)
	}
	if tk == K_FLOAT && is_integer_t(cast(i64, from)) != 0 {
		if is_untyped(cast(i64, from)) != 0 {
			reconvert(cast(Node, x), ty_int)
		}
		if is_f32(to) != 0 {
			replace_node(e, mk_conv(pos, mk_conv(pos, x, CV_I2F, ty_float), CV_ROUND32, ty_f32))
			return ty_f32
		}
		replace_node(e, mk_conv(pos, x, CV_I2F, ty_float))
		return ty_float
	}
	if tk == K_FLOAT && fk == K_FLOAT {
		// f64 -> f32 rounds; f32 -> f64 is exact (the register already holds an f64).
		if is_f32(to) != 0 {
			replace_node(e, mk_conv(pos, x, CV_ROUND32, ty_f32))
		} else {
			replace_node(e, mk_conv(pos, x, CV_SAME, cast(i64, to)))
		}
		return cast(i64, to)
	}
	if tk == K_INT && fk == K_FLOAT {
		replace_node(e, mk_conv(pos, x, CV_F2I, cast(i64, to)))
		// Out of range (or NaN) panics instead of saturating (#362).
		cast(Conv, e).ovf = range_mode()
		return cast(i64, to)
	}
	if tk == K_INT && is_integer_t(cast(i64, from)) != 0 {
		// Integer conversions truncate or extend to the target width.
		replace_node(e, mk_conv(pos, x, CV_INT, cast(i64, to)))
		return cast(i64, to)
	}
	if tk == K_INT && fk == K_BOOL {
		replace_node(e, mk_conv(pos, x, CV_SAME, cast(i64, to)))
		return cast(i64, to)
	}
	if tk == K_STRING && is_integer_t(cast(i64, from)) != 0 {
		replace_node(e, rt_call(pos, "rt_str_from_rune", args1(x), ty_string))
		return ty_string
	}
	if tk == K_STRING && fk == K_SLICE && from.elem == ty_byte {
		replace_node(e, rt_call(pos, "rt_str_from_bytes", args1(x), ty_string))
		return ty_string
	}
	if tk == K_SLICE && to.elem == ty_byte && fk == K_STRING {
		replace_node(e, rt_call(pos, "rt_bytes_from_str", args1(x), cast(i64, to)))
		return cast(i64, to)
	}
	if tk == K_OPT && cast(i64, from) == to.elem {
		replace_node(e, mk_conv(pos, x, CV_SAME, cast(i64, to)))
		return cast(i64, to)
	}
	err_code_types(pos, "E231 CONVERSION", "cannot convert ", cast(i64, from), " to ", cast(i64, to))
	return cast(i64, to)
}

// chk_builtin handles the predeclared functions; it returns 0 for other names.
fn chk_builtin(e i64, name str, want i64) i64 {
	let pos = cast(Node, e).pos
	let args = cast(Call, e).args
	let n = len(args)
	if name == "bound" {
		return chk_bound(e, cast(Ty, want))
	}
	if name == "len" || name == "cap" {
		if n != 1 {
			err_code_quoted(pos, "E210 ARG_COUNT", "", name, " expects 1 argument")
			return ty_int
		}
		let t = cast(Ty, chk(cast(Node, arg0(cast(Call, e))), 0))
		let k = kind_of(t)
		if k == K_VARRAY {
			// An inline array's length is its type's (#631).
			replace_node(e, mk_int(pos, t.key, ty_int))
			return ty_int
		}
		if k != K_STRING && k != K_SLICE && k != K_MAP {
			err_code_type(pos, "E217 BUILTIN_ARGS", "invalid argument for len: ", cast(i64, t), "")
		}
		mut word = 0
		if name == "cap" {
			word = 1
		}
		replace_node(e, mk_hdr(pos, arg0(cast(Call, e)), word))
		cast(Node, e).type_ = 0
		return ty_int
	}
	if name == "append" {
		if n == 0 {
			err_code_at(pos, "E217 BUILTIN_ARGS", "append needs a slice")
			return ty_int
		}
		shared_let_write(pos, arg0(cast(Call, e)))
		// The place append grows (#627), taken before checking lowers it.
		let agk = al_place(arg0(cast(Call, e)), 1)
		let agt = al_ptext
		mut st = cast(Ty, chk(cast(Node, arg0(cast(Call, e))), want))
		al_grow(pos, agk, agt)
		// append can grow a bounded slice past its bound: the result is unbounded (#240).
		st = cast(Ty, unbounded(st))
		if kind_of(st) != K_SLICE {
			err_code_type(pos, "E217 BUILTIN_ARGS", "first argument to append must be a slice, not ", cast(i64, st), "")
			return ty_int
		}
		let et = st.elem
		mut acc = arg0(cast(Call, e))
		mut i = 1
		for i < n {
			let a = args[i]
			if cast(Node, a).kind == EX_UNARY && cast(Unary, a).op == "..." {
				let at = chk(cast(Node, cast(Unary, a).x), cast(i64, st))
				if kind_of(cast(Ty, at)) == K_STRING && et == ty_byte && is_secret(cast(Ty, at)) != 0 && is_secret(st) == 0 {
					secret_sink_error(cast(Node, a).pos, "append would put ", " into a slice that is not secret", "", at)
				}
				if kind_of(cast(Ty, at)) == K_STRING && et == ty_byte {
					acc = rt_call(pos, "rt_append_str", args2(acc, cast(Unary, a).x), cast(i64, st))
				} else {
					check_assignable(cast(Node, cast(Unary, a).x), at, st)
					mut appendn = "rt_slice_appendn"
					if rc_counted(cast(Ty, et)) != 0 {
						// The elements' new slots own them (#176): a long-lived slice counts them.
						appendn = "rt_slice_appendn_rc"
					}
					if is_shape_value(cast(Ty, et)) != 0 {
						// Their objects, for dyn elements (#618).
						acc = rt_call(pos, "rt_slice_appendn_dyn", args2(acc, cast(Unary, a).x), cast(i64, st))
					} else if value_has_ref(cast(Ty, et)) != 0 {
						// Value structs: each one's fields, in a long-lived slice (#669).
						mut nargs = cast([]i64, args3(acc, cast(Unary, a).x, mk_int(pos, elem_size(st), ty_int)))
						nargs = append(nargs, fn_ref_node(pos, cast(Fn, vinc_fn(et))))
						acc = rt_call(pos, "rt_slice_appendn_vrc", cast(i64, nargs), cast(i64, st))
					} else {
						acc = rt_call(pos, appendn, args3(acc, cast(Unary, a).x, mk_int(pos, elem_size(st), ty_int)), cast(i64, st))
					}
				}
			} else {
				let vt = chk(cast(Node, a), et)
				check_assignable(cast(Node, a), vt, cast(Ty, secret_like(cast(i64, st), et)))
				if is_untyped(vt) != 0 {
					reconvert(cast(Node, a), et)
				}
				if is_dyn_value(cast(Ty, et)) != 0 {
					acc = lower_append_dyn(pos, acc, a, st)
				} else if value_has_ref(cast(Ty, et)) != 0 {
					// Its bytes, copied in, and in a long-lived slice its fields' counts (#669).
					mut margs = cast([]i64, args3(acc, a, mk_int(pos, elem_size(st), ty_int)))
					margs = append(margs, fn_ref_node(pos, cast(Fn, vinc_fn(et))))
					acc = rt_call(pos, "rt_append_mem_rc", cast(i64, margs), cast(i64, st))
				} else if is_value_struct(cast(Ty, et)) != 0 {
					// A value struct's bytes, copied in (#631).
					acc = rt_call(pos, "rt_append_mem", args3(acc, a, mk_int(pos, elem_size(st), ty_int)), cast(i64, st))
				} else if rc_counted(cast(Ty, et)) != 0 {
					// The element's slot owns it (#176): a long-lived slice counts it.
					acc = rt_call(pos, "rt_append_rc", args3(acc, elem_bits(cast(Node, a), st.elem), mk_int(pos, elem_size(st), ty_int)), cast(i64, st))
				} else {
					acc = rt_call(pos, "rt_append", args3(acc, elem_bits(cast(Node, a), st.elem), mk_int(pos, elem_size(st), ty_int)), cast(i64, st))
				}
			}
			i = i + 1
		}
		replace_node(e, acc)
		cast(Node, e).type_ = 0
		return cast(i64, st)
	}
	if name == "make" {
		if n < 1 || cast(Node, arg0(cast(Call, e))).kind != EX_TYPE {
			err_code_at(pos, "E217 BUILTIN_ARGS", "make needs a slice or map type: make([]T, n), make([]T, n, capacity) or make(map[K]V)")
			return ty_int
		}
		let t = cast(Ty, resolve_type(cast(TypeNode, arg0(cast(Call, e))).ty))
		let k = kind_of(t)
		if k == K_SLICE {
			if n < 2 {
				err_code_at(pos, "E217 BUILTIN_ARGS", "make of a slice needs a length")
				return cast(i64, t)
			}
			chk(cast(Node, args[1]), ty_int)
			reconvert(cast(Node, args[1]), ty_int)
			// Without a capacity pass 0 (the runtime raises it to the length), so the length
			// expression is evaluated once.
			mut c = mk_int(pos, 0, ty_int)
			if n > 2 {
				c = args[2]
				chk(cast(Node, c), ty_int)
				reconvert(cast(Node, c), ty_int)
			}
			let ek = kind_of(cast(Ty, t.elem))
			let len0 = args[1]
			let zero_len = i64(cast(Node, len0).kind == EX_INT && cast(IntLit, len0).val == 0)
			if zero_len == 0 && (ek == K_STRUCT || ek == K_MAP || ek == K_FUNC || ek == K_DYN) && is_value_struct(cast(Ty, t.elem)) == 0 {
				err_code_type(pos, "E203 NO_ZERO_VALUE", "make with a length would fill the slice with nil ", t.elem, " values: use make([]T, 0, n) and append (or []?T)")
				return cast(i64, t)
			}
			if zero_len == 0 && ek == K_STRING {
				// Elements start as "" (a str is never nil).
				replace_node(e, rt_call(pos, "rt_slice_make_str", args2(args[1], c), cast(i64, t)))
				return cast(i64, t)
			}
			if zero_len == 0 && ek == K_SLICE {
				replace_node(e, rt_call(pos, "rt_slice_make_nest", args3(args[1], c, mk_int(pos, elem_size(cast(Ty, t.elem)), ty_int)), cast(i64, t)))
				return cast(i64, t)
			}
			if zero_len == 0 && is_value_struct(cast(Ty, t.elem)) != 0 && value_no_zero(cast(Ty, t.elem)) != 0 {
				err_code_type(pos, "E203 NO_ZERO_VALUE", "make with a length would fill the slice with ", t.elem, " values whose map, struct, func or dyn field is nil: use make([]T, 0, n) and append")
				return cast(i64, t)
			}
			mut made = rt_call(pos, "rt_slice_make", args3(args[1], c, mk_int(pos, elem_size(t), ty_int)), cast(i64, t))
			if zero_len == 0 {
				made = value_fill_strs(pos, made, t)
			}
			replace_node(e, made)
			return cast(i64, t)
		}
		if k == K_MAP {
			replace_node(e, map_make_call(pos, t))
			return cast(i64, t)
		}
		err_code_type(pos, "E217 BUILTIN_ARGS", "cannot make ", cast(i64, t), "")
		return cast(i64, t)
	}
	if name == "new" {
		if n != 1 || cast(Node, arg0(cast(Call, e))).kind != EX_TYPE {
			err_code_at(pos, "E217 BUILTIN_ARGS", "new needs one struct type: new(T)")
			return ty_int
		}
		let t = cast(Ty, resolve_type(cast(TypeNode, arg0(cast(Call, e))).ty))
		if kind_of(t) != K_STRUCT {
			err_code_type(pos, "E217 BUILTIN_ARGS", "new needs a struct type, not ", cast(i64, t), "")
			return cast(i64, t)
		}
		// new(T) is T{}: fields that cannot be nil must still be set.
		let lit = cast(Composite, node_new(EX_COMPOSITE, pos))
		let tyx = node_new(EX_TYPE, pos)
		cast(TypeNode, tyx).ty = cast(TypeNode, arg0(cast(Call, e))).ty
		lit.type_ = tyx
		lit.elems = []i64{}
		lit.keys = []i64{}
		replace_node(e, cast(i64, lit))
		cast(Node, e).type_ = 0
		return chk_kind(e, cast(i64, t))
	}
	if name == "cast" {
		if ck_trusted == 0 {
			err_code_at(pos, "E802 RUNTIME_INTERNAL", "cast is internal to the runtime")
		}
		if n != 2 || cast(Node, arg0(cast(Call, e))).kind != EX_TYPE {
			err_code_at(pos, "E217 BUILTIN_ARGS", "cast needs a type and a value")
			return ty_int
		}
		let t = cast(Ty, resolve_type(cast(TypeNode, arg0(cast(Call, e))).ty))
		let x = args[1]
		let from = chk(cast(Node, x), 0)
		if is_untyped(from) != 0 {
			reconvert(cast(Node, x), ty_int)
		}
		if is_float_t(cast(i64, t)) != 0 && is_float_t(from) == 0 {
			replace_node(e, mk_conv(pos, x, CV_BITS2F, cast(i64, t)))
		} else if is_float_t(cast(i64, t)) == 0 && is_float_t(from) != 0 {
			replace_node(e, mk_conv(pos, x, CV_F2BITS, cast(i64, t)))
		} else {
			// Same bits, new static type: the operand keeps its own type.
			if is_integer_t(cast(i64, t)) != 0 && cast(Node, x).kind == EX_FUNCREF {
				cast(FuncRef, x).raw = 1
			}
			replace_node(e, mk_conv(pos, x, CV_SAME, cast(i64, t)))
		}
		return cast(i64, t)
	}
	if name == "delete" {
		if n != 2 {
			err_code_at(pos, "E217 BUILTIN_ARGS", "delete needs a map and a key")
			return ty_void
		}
		shared_let_write(pos, arg0(cast(Call, e)))
		let mt = cast(Ty, chk(cast(Node, arg0(cast(Call, e))), 0))
		if kind_of(mt) != K_MAP || n != 2 {
			err_code_at(pos, "E217 BUILTIN_ARGS", "delete needs a map and a key")
			return ty_void
		}
		let kt = chk(cast(Node, args[1]), mt.key)
		check_assignable(cast(Node, args[1]), kt, cast(Ty, mt.key))
		if is_untyped(kt) != 0 {
			reconvert(cast(Node, args[1]), mt.key)
		}
		replace_node(e, rt_call(pos, "rt_map_del", args2(arg0(cast(Call, e)), key_in(cast(Node, args[1]), mt.key)), ty_void))
		return ty_void
	}
	if name == "copy" {
		if n != 2 {
			err_code_at(pos, "E217 BUILTIN_ARGS", "copy needs a destination slice and a source (a slice or a str)")
			return ty_int
		}
		shared_let_write(pos, arg0(cast(Call, e)))
		let dt = cast(Ty, chk(cast(Node, arg0(cast(Call, e))), 0))
		let cdesc = secret_desc(args[1])
		mut st = cast(Ty, chk(cast(Node, args[1]), 0))
		if has_secret(cast(i64, st)) != 0 && has_secret(cast(i64, dt)) == 0 {
			secret_sink_error(cast(Node, args[1]).pos, "copy would put ", " into a slice that is not secret", cdesc, cast(i64, st))
		}
		if kind_of(dt) == K_VARRAY {
			// copy(v.arr, xs): the fewer of N and len(xs) elements, into the inline array's bytes (#817).
			value_write_check(pos, arg0(cast(Call, e)), 0)
			let et = cast(Ty, dt.elem)
			if value_has_ref(cast(Ty, dt)) != 0 || value_ref_field(et) != 0 {
				err_code_type(pos, "E217 BUILTIN_ARGS", "copy fills an inline array of numbers, bools and value structs without references, not ", cast(i64, dt), ": assign its elements one by one")
				return ty_int
			}
			mut dsrc = 0
			mut slen = 0
			if kind_of(st) == K_STRING && is_integer_t(cast(i64, et)) != 0 && type_width(et) == 1 {
				let sv = temp(pos, args[1], cast(i64, st))
				dsrc = mk_bin(pos, "+", mk_conv(pos, sym_ref_node(pos, cast(Sym, sv.sym)), CV_SAME, ty_int), mk_int(pos, 8, ty_int), ty_int)
				slen = mk_mem(pos, sym_ref_node(pos, cast(Sym, sv.sym)), 0, 0, 0, ty_int)
				let cp = rt_call(pos, "rt_varray_copy", cast(i64, args5(mk_conv(pos, arg0(cast(Call, e)), CV_SAME, ty_int), mk_int(pos, dt.key, ty_int), dsrc, slen, mk_int(pos, type_width(et), ty_int))), ty_int)
				replace_node(e, mk_seq(pos, args1(cast(i64, sv)), cp, ty_int))
			} else if kind_of(st) == K_SLICE && st.elem == dt.elem {
				let sv = temp(pos, args[1], cast(i64, st))
				dsrc = mk_hdr(pos, sym_ref_node(pos, cast(Sym, sv.sym)), 2)
				slen = mk_hdr(pos, sym_ref_node(pos, cast(Sym, sv.sym)), 0)
				let cp = rt_call(pos, "rt_varray_copy", cast(i64, args5(mk_conv(pos, arg0(cast(Call, e)), CV_SAME, ty_int), mk_int(pos, dt.key, ty_int), dsrc, slen, mk_int(pos, type_width(et), ty_int))), ty_int)
				replace_node(e, mk_seq(pos, args1(cast(i64, sv)), cp, ty_int))
			} else {
				err_code_type(pos, "E217 BUILTIN_ARGS", "copy into an inline array needs a slice of its elements (or a str for bytes), filling ", cast(i64, dt), "")
			}
			return ty_int
		}
		if kind_of(st) == K_STRING {
			replace_node(e, rt_call(pos, "rt_copy_str", args2(arg0(cast(Call, e)), args[1]), ty_int))
		} else if kind_of(dt) == K_SLICE && is_shape_value(cast(Ty, dt.elem)) != 0 {
			// The objects of dyn elements, released through their tables (#618).
			replace_node(e, rt_call(pos, "rt_slice_copy_dyn", args3(arg0(cast(Call, e)), args[1], mk_int(pos, dyn_drop_index(dt.elem), ty_int)), ty_int))
		} else if kind_of(dt) == K_SLICE && value_has_ref(cast(Ty, dt.elem)) != 0 {
			// Value structs: their fields, element by element (#669).
			mut vargs = cast([]i64, args3(arg0(cast(Call, e)), args[1], mk_int(pos, elem_size(dt), ty_int)))
			vargs = append(vargs, fn_ref_node(pos, cast(Fn, vinc_fn(dt.elem))))
			vargs = append(vargs, fn_ref_node(pos, cast(Fn, drop_fn(dt.elem))))
			replace_node(e, rt_call(pos, "rt_slice_copy_vrc", cast(i64, vargs), ty_int))
		} else if kind_of(dt) == K_SLICE && rc_counted(cast(Ty, dt.elem)) != 0 {
			// Copied values gain their slots' counts and replaced ones lose theirs (#176).
			mut cargs = cast([]i64, args3(arg0(cast(Call, e)), args[1], mk_int(pos, elem_size(dt), ty_int)))
			cargs = append(cargs, fn_ref_node(pos, cast(Fn, drop_fn(dt.elem))))
			replace_node(e, rt_call(pos, "rt_slice_copy_rc", cast(i64, cargs), ty_int))
		} else {
			replace_node(e, rt_call(pos, "rt_slice_copy", args3(arg0(cast(Call, e)), args[1], mk_int(pos, elem_size(dt), ty_int)), ty_int))
		}
		return ty_int
	}
	if name == "panic" {
		if n != 1 {
			err_code_at(pos, "E217 BUILTIN_ARGS", "panic needs one value: panic(\"message\") or panic(err)")
			return ty_void
		}
		let pdesc = secret_desc(arg0(cast(Call, e)))
		let pt = chk(cast(Node, arg0(cast(Call, e))), ty_string)
		secret_sink(cast(Node, arg0(cast(Call, e))).pos, "panic would print ", "", pdesc, pt)
		mut msg = arg0(cast(Call, e))
		if kind_of(cast(Ty, pt)) == K_ERROR {
			msg = rt_call(pos, "rt_err_str", args1(msg), ty_string)
		} else if kind_of(cast(Ty, pt)) != K_STRING {
			msg = say_text(pos, cast([]Node, args), 0)
		}
		replace_node(e, rt_call(pos, "rt_panic", args1(msg), ty_void))
		return ty_void
	}
	if name == "fail" {
		if n != 1 {
			err_code_at(pos, "E416 FAIL_VALUE", "fail needs a message")
			return ty_error
		}
		let fdesc = secret_desc(arg0(cast(Call, e)))
		let ft = chk(cast(Node, arg0(cast(Call, e))), ty_string)
		secret_sink(cast(Node, arg0(cast(Call, e))).pos, "fail would put ", " in a fault message", fdesc, ft)
		if kind_of(cast(Ty, ft)) != K_STRING {
			err_code_type(pos, "E416 FAIL_VALUE", "fail needs a str message, not ", ft, "")
		}
		replace_node(e, rt_call(pos, "rt_fail", args1(arg0(cast(Call, e))), ty_error))
		cast(Node, e).type_ = 0
		return ty_error
	}
	if name == "fault" {
		// var ErrX = fault("msg") declares a sentinel: one identity per declaration (fault.Is).
		if n != 1 {
			err_code_at(pos, "E417 SENTINEL", "fault needs a message: var ErrX = fault(\"...\")")
			return ty_error
		}
		if ck_sentinel != e {
			err_code_at(pos, "E417 SENTINEL", "fault(\"...\") declares a sentinel: write it at package level as var ErrX = fault(\"msg\"), or use fail(\"msg\") for a one-off fault")
			return ty_error
		}
		let sdesc = secret_desc(arg0(cast(Call, e)))
		mut st = cast(Ty, chk(cast(Node, arg0(cast(Call, e))), ty_string))
		secret_sink(cast(Node, arg0(cast(Call, e))).pos, "fault would put ", " in a fault message", sdesc, cast(i64, st))
		if kind_of(st) != K_STRING {
			err_code_type(pos, "E417 SENTINEL", "fault needs a str message, not ", cast(i64, st), "")
		}
		sentinel_seq = sentinel_seq + 1
		replace_node(e, rt_call(pos, "rt_fault_sentinel", args2(arg0(cast(Call, e)), mk_int(pos, 63 + sentinel_seq, ty_int)), ty_error))
		cast(Node, e).type_ = 0
		return ty_error
	}
	if name == "same" {
		if n != 2 {
			err_code_at(pos, "E217 BUILTIN_ARGS", "same needs two values")
			return ty_bool
		}
		let sa = chk(cast(Node, arg0(cast(Call, e))), 0)
		let sb = chk(cast(Node, args[1]), sa)
		let sk = kind_of(cast(Ty, sa))
		if is_value_struct(cast(Ty, sa)) != 0 {
			err_code_at(pos, "E217 BUILTIN_ARGS", "same compares identity, and a value struct has none (every store copies it): compare with ==")
			return ty_bool
		}
		if (sk != K_STRUCT && sk != K_SLICE && sk != K_MAP) || cast(i64, sa) != sb {
			err_code_at(pos, "E217 BUILTIN_ARGS", "same compares two structs, slices or maps of one type for identity (the same object)")
			return ty_bool
		}
		replace_node(e, mk_bin(pos, "==", mk_conv(pos, arg0(cast(Call, e)), CV_SAME, ty_int), mk_conv(pos, args[1], CV_SAME, ty_int), ty_bool))
		return ty_bool
	}
	if name == "keep" {
		if n != 1 {
			err_code_at(pos, "E217 BUILTIN_ARGS", "keep needs one value")
			return ty_int
		}
		return lower_keep(cast(Node, e), want)
	}
	if name == "reveal" {
		return secret_reveal(e)
	}
	if name == "print" || name == "println" {
		if name == "println" {
			return lower_say(e, "Line", want)
		}
		return lower_say(e, "Text", want)
	}
	if name == "min" || name == "max" {
		return lower_minmax(e, name, want)
	}
	return 0
}

fn lower_minmax(e i64, name str, want i64) i64 {
	let pos = cast(Node, e).pos
	let args = cast(Call, e).args
	let n = len(args)
	if n == 0 {
		err_code_quoted(pos, "E210 ARG_COUNT", "", name, " needs arguments")
		return ty_int
	}
	chk(cast(Node, arg0(cast(Call, e))), want)
	mut i = 1
	for i < n {
		unify(cast(Node, arg0(cast(Call, e))), args[i], want)
		i = i + 1
	}
	let t = default_type(cast(Node, arg0(cast(Call, e))).type_)
	i = 0
	for i < n {
		reconvert(cast(Node, args[i]), t)
		i = i + 1
	}
	secret_compare_error(pos, name, t, t)
	if is_numeric_t(t) == 0 && kind_of(cast(Ty, t)) != K_STRING {
		err_code_type(pos, "E237 COMPARE", "cannot compare ", t, "")
	}
	// acc := a; if b < acc { acc = b }  (compiled to csel)
	mut stmts = []i64{}
	let acc = temp(pos, arg0(cast(Call, e)), t)
	stmts = append(stmts, cast(i64, acc))
	mut op = "<"
	if name == "max" {
		op = ">"
	}
	i = 1
	for i < n {
		let v = temp(pos, args[i], t)
		stmts = append(stmts, cast(i64, v))
		mut cond = mk_bin(pos, op, sym_ref_node(pos, cast(Sym, v.sym)), sym_ref_node(pos, cast(Sym, acc.sym)), ty_bool)
		if kind_of(cast(Ty, t)) == K_STRING {
			cond = mk_bin(pos, op, rt_call(pos, "rt_str_cmp", args2(sym_ref_node(pos, cast(Sym, v.sym)), sym_ref_node(pos, cast(Sym, acc.sym))), ty_int), mk_int(pos, 0, ty_int), ty_bool)
		}
		let ifs = cast(IfStmt, node_new(ST_IF, pos))
		ifs.cond = cond
		ifs.then = empty_block(pos)
		mut vs1 = cast(Block, ifs.then).stmts
		vs1 = append(vs1, assign_stmt(pos, sym_ref_node(pos, cast(Sym, acc.sym)), sym_ref_node(pos, cast(Sym, v.sym))))
		stmts = append(stmts, cast(i64, ifs))
		i = i + 1
	}
	replace_node(e, mk_seq(pos, cast(i64, stmts), sym_ref_node(pos, cast(Sym, acc.sym)), t))
	return t
}

// lower_keep deep-copies a value into the core's long-lived ingot heap. The result may
// only be stored straight into long-lived memory (checked by the region pass).
// type_has_dyn reports whether a value of t holds a dyn value (a dyn field, element or
// optional), depth-limited so a recursive type stays finite.
fn type_has_dyn(t Ty, depth i64) i64 {
	if depth > 8 {
		return 0
	}
	let k = kind_of(t)
	if k == K_DYN {
		return 1
	}
	if k == K_OPT || k == K_SLICE {
		return type_has_dyn(cast(Ty, t.elem), depth + 1)
	}
	if k == K_MAP {
		return i64(type_has_dyn(cast(Ty, t.key), depth + 1) != 0 || type_has_dyn(cast(Ty, t.elem), depth + 1) != 0)
	}
	if k == K_STRUCT {
		mut i = 0
		for i < len(t.fields) {
			if type_has_dyn(cast(Ty, field_type(t, i)), depth + 1) != 0 {
				return 1
			}
			i = i + 1
		}
	}
	return 0
}

fn lower_keep(e Node, want i64) i64 {
	let pos = e.pos
	let x = arg0(cast(Call, e))
	mut t = chk(cast(Node, x), want)
	if is_untyped(t) != 0 {
		t = reconvert(cast(Node, x), default_type(t))
	}
	if kind_of(cast(Ty, t)) == K_DYN || type_has_dyn(cast(Ty, t), 0) != 0 {
		let f = keep_fn(cast(Ty, t))
		let c = node_new(EX_CALL, pos)
		cast(Call, c).name = f.qname
		cast(Call, c).args = cast([]i64, args1(x))
		cast(Call, c).fn_ = cast(i64, f)
		cast(Node, c).type_ = t
		cast(Node, c).region = R_OWNED
		replace_node(cast(i64, e), c)
		return t
	}
	if kind_of(cast(Ty, t)) == K_FUNC {
		let c = rt_call(pos, "rt_keep_closure", args1(x), t)
		cast(Node, c).region = R_OWNED
		replace_node(cast(i64, e), c)
		return t
	}
	if is_ref(t) == 0 && value_has_ref(cast(Ty, t)) == 0 {
		replace_node(cast(i64, e), x)
		if is_value_struct(cast(Ty, t)) != 0 {
			// Marked kept: as a dyn object, its box is a kept block (box_dyn_value, #692).
			e.region = R_OWNED
		}
		return t
	}
	let f = keep_fn(cast(Ty, t))
	let c = node_new(EX_CALL, pos)
	cast(Call, c).name = f.qname
	cast(Call, c).args = cast([]i64, args1(x))
	cast(Call, c).fn_ = cast(i64, f)
	cast(Node, c).type_ = t
	cast(Node, c).region = R_OWNED
	replace_node(cast(i64, e), c)
	return t
}

// ---- argo: a JSON encoder generated for each type ----
shared mut argo_types []i64
shared mut argo_fns []i64
shared mut argo_v2_types []i64
shared mut argo_v2_fns []i64

fn lower_argo_put(e i64, v2 i64) i64 {
	let pos = cast(Node, e).pos
	let args = cast(Call, e).args
	if len(args) != 2 {
		err_code_at(pos, "E281 ARGO", "argo.Put takes a []u8 buffer and a value")
		return ty_void
	}
	let b = cast(Node, args[0])
	if unwrap_mut(cast(i64, b)) == 0 {
		err_code_at(b.pos, "E281 ARGO", "argo.Put appends to its buffer: write mut before it")
	}
	let bt = cast(Ty, chk(cast(Node, b), 0))
	if kind_of(bt) != K_SLICE || bt.elem != ty_byte {
		err_code_type(pos, "E281 ARGO", "argo.Put writes into a []u8, not ", cast(i64, bt), "")
		return ty_void
	}
	let v = cast(Node, args[1])
	let vdesc = secret_desc(cast(i64, v))
	mut t = chk(cast(Node, v), 0)
	if secret_sink(v.pos, "argo.Put would encode ", " as JSON", vdesc, t) != 0 {
		return ty_void
	}
	if is_untyped(t) != 0 {
		t = reconvert(cast(Node, v), default_type(t))
	}
	let f = argo_fn(pos, cast(Ty, t), v2)
	if f == 0 {
		return ty_void
	}
	replace_node(e, cast(i64, call_fn(pos, cast(Fn, f), args2(cast(i64, b), cast(i64, v)), ty_void)))
	return ty_void
}

fn call_fn(pos i64, f Fn, args i64, t i64) Node {
	let c = node_new(EX_CALL, pos)
	cast(Call, c).name = f.qname
	cast(Call, c).args = cast([]i64, args)
	cast(Call, c).fn_ = cast(i64, f)
	cast(Node, c).type_ = t
	return cast(Node, c)
}

fn argo_lib(pos i64, name str) Fn {
	let f = find_fn(name)
	if cast(i64, f) == 0 {
		err_code_quoted(pos, "E281 ARGO", "argo.Put needs package argo (", name, " is missing): import \"argo\"")
	}
	return f
}

// argo_emit appends a call that writes x (of type t) to buffer b.
fn argo_emit(pos i64, body []i64, b i64, x i64, t Ty, v2 i64) {
	let k = kind_of(t)
	let bref = sym_ref_node(pos, cast(Sym, b))
	if k == K_STRING {
		body = append(body, expr_stmt(call_fn(pos, argo_lib(pos, "argo.wstr"), args2(bref, x), ty_void)))
	} else if k == K_BOOL {
		body = append(body, expr_stmt(call_fn(pos, argo_lib(pos, "argo.wbool"), args2(bref, x), ty_void)))
	} else if is_f32(t) != 0 {
		body = append(body, expr_stmt(call_fn(pos, argo_lib(pos, "argo.wfloat32"), args2(bref, x), ty_void)))
	} else if is_float_t(cast(i64, t)) != 0 {
		body = append(body, expr_stmt(call_fn(pos, argo_lib(pos, "argo.wfloat"), args2(bref, x), ty_void)))
	} else if k == K_INT && t.signed == 0 {
		body = append(body, expr_stmt(call_fn(pos, argo_lib(pos, "argo.wuint"), args2(bref, mk_conv(pos, x, CV_SAME, ty_u64)), ty_void)))
	} else if k == K_INT {
		body = append(body, expr_stmt(call_fn(pos, argo_lib(pos, "argo.wint"), args2(bref, mk_conv(pos, x, CV_SAME, ty_int)), ty_void)))
	} else {
		let f = argo_fn(pos, t, v2)
		if f != 0 {
			body = append(body, expr_stmt(call_fn(pos, cast(Fn, f), args2(bref, x), ty_void)))
		}
	}
}

fn argo_raw(pos i64, body []i64, b i64, text str) {
	body = append(body, expr_stmt(cast(Node, rt_call(pos, "rt_append_str", args2(sym_ref_node(pos, cast(Sym, b)), lit_string(pos, text)), ty_byte_slice()))))
}

fn ty_byte_slice() i64 {
	return slice_of(ty_byte)
}

// argo_fn returns (generating on first use) argo$N(b mut []u8, x T), the encoder for T.
fn argo_fn(pos i64, t Ty, v2 i64) i64 {
	if v2 != 0 && cast(i64, argo_v2_types) == 0 {
		argo_v2_types = []i64{}
		argo_v2_fns = []i64{}
	}
	if v2 == 0 && cast(i64, argo_types) == 0 {
		argo_types = []i64{}
		argo_fns = []i64{}
	}
	mut i = 0
	mut types = argo_types
	mut fns = argo_fns
	if v2 != 0 {
		types = argo_v2_types
		fns = argo_v2_fns
	}
	for i < len(types) {
		if cast(i64, cast(Ty, types[i])) == cast(i64, t) {
			return fns[i]
		}
		i = i + 1
	}
	let k = kind_of(t)
	if !(k == K_STRUCT || k == K_SLICE || k == K_VARRAY || k == K_MAP || k == K_OPT || k == K_ERROR || k == K_STRING || k == K_INT || k == K_BOOL || is_float_t(cast(i64, t)) != 0) {
		err_code_type(pos, "E281 ARGO", "argo cannot encode values of type ", cast(i64, t), "")
		return 0
	}
	if k == K_MAP && kind_of(cast(Ty, t.key)) != K_STRING && kind_of(cast(Ty, t.key)) != K_INT {
		err_code_type(pos, "E281 ARGO", "argo encodes maps with str or integer keys, not ", cast(i64, t), "")
		return 0
	}
	lifted_count = lifted_count + 1
	let f = fn_new(0, "argo")
	let nb = buf_new()
	buf_str(nb, "argo$")
	buf_int(nb, lifted_count)
	f.qname = str(nb)
	f.name = str(nb)
	f.lifted = 2
	let bt = ty_byte_slice()
	f.params = append(f.params, "b")
	f.params = append(f.params, "x")
	f.ptypes = append(f.ptypes, bt)
	f.ptypes = append(f.ptypes, cast(i64, t))
	f.muts = append(f.muts, 1)
	f.muts = append(f.muts, 0)
	f.type_ = func_of(f.ptypes, f.rtypes, 0)
	f.locals = cast([]Sym, []i64{})
	f.body = empty_block(0)
	if v2 != 0 {
		argo_v2_types = append(argo_v2_types, cast(i64, t))
		argo_v2_fns = append(argo_v2_fns, cast(i64, f))
	} else {
		argo_types = append(argo_types, cast(i64, t))
		argo_fns = append(argo_fns, cast(i64, f))
	}
	prog_fns = append(prog_fns, cast(Fn, f))
	let saved_fn = ck_fn
	ck_fn = cast(Fn, f)
	let b = sym_new(SYM_LOCAL, "b", 0)
	b.type_ = bt
	b.slot = 0
	b.mut_ = 1
	let x = sym_new(SYM_LOCAL, "x", 0)
	x.type_ = cast(i64, t)
	x.slot = 1
	f.slots = 2
	mut vs8 = cast([]i64, f.locals)
	vs8 = append(vs8, cast(i64, b))
	mut vs9 = cast([]i64, f.locals)
	vs9 = append(vs9, cast(i64, x))
	mut body = cast(Block, f.body).stmts
	if k == K_STRUCT && cast(i64, t.enum_) != 0 {
		// "Name" for a variant without data, {"Name":{"field":...}} for one with data.
		let vs = t.enum_
		mut vi = 0
		for vi < len(vs) {
			let v = vs[vi]
			let ifs = cast(IfStmt, node_new(ST_IF, pos))
			ifs.cond = mk_bin(pos, "==", mk_mem(pos, sym_ref_node(pos, x), 0, 0, field_offset(t, 0), ty_int), mk_int(pos, vi, ty_int), ty_bool)
			ifs.then = empty_block(pos)
			let vb = cast(Block, ifs.then).stmts
			let vn = v.name
			let nfv = v.count
			let head = buf_new()
			if nfv == 0 {
				buf_byte(head, '"')
				buf_str(head, vn)
				buf_byte(head, '"')
				argo_raw(pos, vb, cast(i64, b), str(head))
			} else {
				buf_str(head, "{{\"")
				buf_str(head, vn)
				buf_str(head, "\":")
				argo_raw(pos, vb, cast(i64, b), str(head))
				mut kk = 0
				for kk < nfv {
					let fi2 = v.first + kk
					let full = cast(Field, t.fields[fi2]).name
					let piece = buf_new()
					if kk == 0 {
						buf_byte(piece, '{')
					} else {
						buf_byte(piece, ',')
					}
					buf_byte(piece, '"')
					buf_str(piece, full[len(vn) + 1:])
					buf_str(piece, "\":")
					argo_raw(pos, vb, cast(i64, b), str(piece))
					let ft2 = field_type(t, fi2)
					argo_emit(pos, vb, cast(i64, b), mk_mem(pos, sym_ref_node(pos, x), 0, 0, field_offset(t, fi2), ft2), cast(Ty, ft2), v2)
					kk = kk + 1
				}
				argo_raw(pos, vb, cast(i64, b), "}}}}")
			}
			body = append(body, cast(i64, ifs))
			vi = vi + 1
		}
	} else if k == K_STRUCT {
		let nf = len(t.fields)
		mut fi = 0
		mut lead = "{{"
		for fi < nf {
			mut fname = cast(Field, t.fields[fi]).name
			let json_name = cast(Field, t.fields[fi]).json
			if len(json_name) != 0 {
				fname = json_name
			}
			let ft = field_type(t, fi)
			let piece = buf_new()
			buf_str(piece, lead)
			buf_byte(piece, '"')
			buf_str(piece, fname)
			buf_str(piece, "\":")
			argo_raw(pos, body, cast(i64, b), str(piece))
			argo_emit(pos, body, cast(i64, b), mk_mem(pos, sym_ref_node(pos, x), 0, 0, field_offset(t, fi), ft), cast(Ty, ft), v2)
			lead = ","
			fi = fi + 1
		}
		if nf == 0 {
			argo_raw(pos, body, cast(i64, b), "{{}}")
		} else {
			argo_raw(pos, body, cast(i64, b), "}}")
		}
	} else if k == K_OPT || k == K_ERROR {
		let ifs = cast(IfStmt, node_new(ST_IF, pos))
		ifs.cond = mk_bin(pos, "==", sym_ref_node(pos, x), mk_int(pos, 0, cast(i64, t)), ty_bool)
		if opt_value(t) != 0 {
			// ?P's tag word says nil (#669).
			ifs.cond = mk_bin(pos, "==", opt_tag(pos, sym_ref_node(pos, x)), mk_int(pos, 0, ty_int), ty_bool)
		}
		ifs.then = empty_block(pos)
		mut null_value = "null"
		if v2 != 0 && kind_of(cast(Ty, t.elem)) == K_SLICE {
			null_value = "[]"
		} else if v2 != 0 && kind_of(cast(Ty, t.elem)) == K_MAP {
			null_value = "{{}}"
		}
		argo_raw(pos, cast(Block, ifs.then).stmts, cast(i64, b), null_value)
		let els = cast(Block, empty_block(pos))
		ifs.else_ = cast(i64, els)
		if k == K_ERROR {
			argo_emit(pos, els.stmts, cast(i64, b), mk_conv(pos, sym_ref_node(pos, x), CV_SAME, ty_string), cast(Ty, ty_string), v2)
		} else if opt_scalar(t) != 0 {
			argo_emit(pos, els.stmts, cast(i64, b), opt_payload(pos, sym_ref_node(pos, x), opt_scalar(t)), cast(Ty, opt_scalar(t)), v2)
		} else if opt_value(t) != 0 {
			argo_emit(pos, els.stmts, cast(i64, b), opt_payload(pos, sym_ref_node(pos, x), t.elem), cast(Ty, t.elem), v2)
		} else {
			argo_emit(pos, els.stmts, cast(i64, b), mk_conv(pos, sym_ref_node(pos, x), CV_SAME, t.elem), cast(Ty, t.elem), v2)
		}
		body = append(body, cast(i64, ifs))
	} else if k == K_VARRAY {
		// An inline array is a JSON array of its N elements (#631).
		argo_raw(pos, body, cast(i64, b), "[")
		let lp = varray_loop(pos, body, sym_ref_node(pos, x), t)
		let comma = cast(IfStmt, node_new(ST_IF, pos))
		let jx = cast(MemExpr, lp.b).index
		comma.cond = mk_bin(pos, ">", sym_ref_node(pos, cast(Sym, cast(IdentExpr, jx).ref)), mk_int(pos, 0, ty_int), ty_bool)
		comma.then = empty_block(pos)
		argo_raw(pos, cast(Block, comma.then).stmts, cast(i64, b), ",")
		mut lb = cast(Block, lp.a).stmts
		lb = append(lb, cast(i64, comma))
		argo_emit(pos, cast(Block, lp.a).stmts, cast(i64, b), lp.b, cast(Ty, t.elem), v2)
		argo_raw(pos, body, cast(i64, b), "]")
	} else if k == K_SLICE {
		let et = t.elem
		mut enc_body = body
		if v2 != 0 {
			let nils = cast(IfStmt, node_new(ST_IF, pos))
			nils.cond = mk_bin(pos, "==", sym_ref_node(pos, x), mk_int(pos, 0, ty_int), ty_bool)
			nils.then = empty_block(pos)
			argo_raw(pos, cast(Block, nils.then).stmts, cast(i64, b), "[]")
			let rest = cast(Block, empty_block(pos))
			nils.else_ = cast(i64, rest)
			body = append(body, cast(i64, nils))
			enc_body = rest.stmts
		}
		argo_raw(pos, enc_body, cast(i64, b), "[")
		let n = temp(pos, mk_hdr(pos, sym_ref_node(pos, x), 0), ty_int)
		enc_body = append(enc_body, cast(i64, n))
		let j = declare_local(pos, "$", ty_int)
		enc_body = append(enc_body, let_stmt(pos, cast(Sym, j), mk_int(pos, 0, ty_int)))
		let w = cast(WhileStmt, node_new(ST_WHILE, pos))
		w.cond = mk_bin(pos, "<", sym_ref_node(pos, cast(Sym, j)), sym_ref_node(pos, cast(Sym, n.sym)), ty_bool)
		w.post = assign_stmt(pos, sym_ref_node(pos, cast(Sym, j)), mk_bin(pos, "+", sym_ref_node(pos, cast(Sym, j)), mk_int(pos, 1, ty_int), ty_int))
		let wb = cast(Block, empty_block(pos))
		w.body = cast(i64, wb)
		let comma = cast(IfStmt, node_new(ST_IF, pos))
		comma.cond = mk_bin(pos, ">", sym_ref_node(pos, cast(Sym, j)), mk_int(pos, 0, ty_int), ty_bool)
		comma.then = empty_block(pos)
		argo_raw(pos, cast(Block, comma.then).stmts, cast(i64, b), ",")
		wb.stmts = append(wb.stmts, cast(i64, comma))
		let el = mk_elem(pos, sym_ref_node(pos, x), sym_ref_node(pos, cast(Sym, j)), et, 0)
		el.safe = 1
		argo_emit(pos, wb.stmts, cast(i64, b), cast(i64, el), cast(Ty, et), v2)
		enc_body = append(enc_body, cast(i64, w))
		argo_raw(pos, enc_body, cast(i64, b), "]")
	} else if k == K_MAP {
		mut enc_body = body
		if v2 != 0 {
			let nils = cast(IfStmt, node_new(ST_IF, pos))
			nils.cond = mk_bin(pos, "==", sym_ref_node(pos, x), mk_int(pos, 0, ty_int), ty_bool)
			nils.then = empty_block(pos)
			argo_raw(pos, cast(Block, nils.then).stmts, cast(i64, b), "{{}}")
			let rest = cast(Block, empty_block(pos))
			nils.else_ = cast(i64, rest)
			body = append(body, cast(i64, nils))
			enc_body = rest.stmts
		}
		argo_raw(pos, enc_body, cast(i64, b), "{{")
		let first = declare_local(pos, "$", ty_bool)
		enc_body = append(enc_body, let_stmt(pos, cast(Sym, first), mk_int(pos, 1, ty_bool)))
		let slots = temp(pos, rt_call(pos, "rt_map_slots", args1(sym_ref_node(pos, x)), ty_int), ty_int)
		enc_body = append(enc_body, cast(i64, slots))
		let j2 = declare_local(pos, "$", ty_int)
		enc_body = append(enc_body, let_stmt(pos, cast(Sym, j2), mk_int(pos, 0, ty_int)))
		let w2 = cast(WhileStmt, node_new(ST_WHILE, pos))
		w2.cond = mk_bin(pos, "<", sym_ref_node(pos, cast(Sym, j2)), sym_ref_node(pos, cast(Sym, slots.sym)), ty_bool)
		w2.post = assign_stmt(pos, sym_ref_node(pos, cast(Sym, j2)), mk_bin(pos, "+", sym_ref_node(pos, cast(Sym, j2)), mk_int(pos, 1, ty_int), ty_int))
		let wb2 = cast(Block, empty_block(pos))
		w2.body = cast(i64, wb2)
		let live = cast(IfStmt, node_new(ST_IF, pos))
		live.cond = rt_call(pos, "rt_map_live", args2(sym_ref_node(pos, x), sym_ref_node(pos, cast(Sym, j2))), ty_bool)
		live.then = empty_block(pos)
		mut lb = cast(Block, live.then).stmts
		let sep = cast(IfStmt, node_new(ST_IF, pos))
		sep.cond = sym_ref_node(pos, cast(Sym, first))
		sep.then = empty_block(pos)
		mut vs11 = cast(Block, sep.then).stmts
		vs11 = append(vs11, assign_stmt(pos, sym_ref_node(pos, cast(Sym, first)), mk_int(pos, 0, ty_bool)))
		sep.else_ = empty_block(pos)
		argo_raw(pos, cast(Block, sep.else_).stmts, cast(i64, b), ",")
		lb = append(lb, cast(i64, sep))
		let kt = t.key
		let kv = from_bits(cast(Node, rt_call(pos, "rt_map_key", args2(sym_ref_node(pos, x), sym_ref_node(pos, cast(Sym, j2))), ty_int)), kt)
		if kind_of(cast(Ty, kt)) == K_STRING {
			argo_emit(pos, lb, cast(i64, b), kv, cast(Ty, kt), v2)
		} else {
			argo_raw(pos, lb, cast(i64, b), "\"")
			argo_emit(pos, lb, cast(i64, b), kv, cast(Ty, kt), v2)
			argo_raw(pos, lb, cast(i64, b), "\"")
		}
		argo_raw(pos, lb, cast(i64, b), ":")
		let vt = t.elem
		let vv = map_val(pos, sym_ref_node(pos, x), sym_ref_node(pos, cast(Sym, j2)), vt)
		argo_emit(pos, lb, cast(i64, b), vv, cast(Ty, vt), v2)
		wb2.stmts = append(wb2.stmts, cast(i64, live))
		enc_body = append(enc_body, cast(i64, w2))
		argo_raw(pos, enc_body, cast(i64, b), "}}")
	} else {
		argo_emit(pos, body, cast(i64, b), sym_ref_node(pos, x), t, v2)
	}
	ck_fn = saved_fn
	return cast(i64, f)
}

// ---- argo.Get: a JSON decoder generated for each type ----
shared mut argo_dtypes []i64
shared mut argo_dfns []i64
shared mut argo_ptype i64

// lower_argo_get lowers argo.Get and argo.GetStrict (strict != 0). A slice target is filled
// in place and cut back to its length on a fault. Any other target is validated first (a
// pass that stores nothing) and filled only when that succeeds, so a fault leaves the
// target as it was.
fn lower_argo_get(e i64, strict i64) i64 {
	let pos = cast(Node, e).pos
	let args = cast(Call, e).args
	if len(args) != 2 {
		err_code_at(pos, "E281 ARGO", "argo.Get takes the JSON text and a struct, slice or map to fill")
		return ty_error
	}
	if unwrap_mut(args[1]) == 0 {
		err_code_at(cast(Node, args[1]).pos, "E281 ARGO", "argo.Get fills its target: write mut before it")
	}
	let s = args[0]
	let st = chk(cast(Node, s), ty_string)
	if kind_of(cast(Ty, st)) != K_STRING {
		err_code_type(pos, "E281 ARGO", "argo.Get reads JSON from a str, not ", st, "")
		return ty_error
	}
	let v = args[1]
	let t = chk(cast(Node, v), 0)
	let k = kind_of(cast(Ty, t))
	if k != K_STRUCT && k != K_SLICE && k != K_MAP {
		err_code_type(pos, "E281 ARGO", "argo.Get fills a struct, slice or map (passed by reference), not ", t, "")
		return ty_error
	}
	let pt = argo_parser_type(pos)
	let df = argo_dfn(pos, cast(Ty, t))
	if pt == 0 || df == 0 {
		return ty_error
	}
	mut stmts = []i64{}
	mut ctor = "argo.parser"
	if strict != 0 {
		ctor = "argo.strictly"
	}
	let p = temp(pos, cast(i64, call_fn(pos, argo_lib(pos, ctor), args1(s), pt)), pt)
	stmts = append(stmts, cast(i64, p))
	let ps = sym_ref_node(pos, cast(Sym, p.sym))
	if k == K_SLICE {
		// A slice only gains elements at its end: decode in place and cut it back on a fault.
		let n0 = temp(pos, mk_hdr(pos, v, 0), ty_int)
		stmts = append(stmts, cast(i64, n0))
		stmts = append(stmts, expr_stmt(call_fn(pos, cast(Fn, df), args2(ps, v), ty_void)))
		let r1 = temp(pos, cast(i64, call_fn(pos, argo_lib(pos, "argo.finish"), args1(sym_ref_node(pos, cast(Sym, p.sym))), ty_error)), ty_error)
		stmts = append(stmts, cast(i64, r1))
		let cut = cast(IfStmt, node_new(ST_IF, pos))
		cut.cond = mk_bin(pos, "!=", sym_ref_node(pos, cast(Sym, r1.sym)), mk_int(pos, 0, ty_error), ty_bool)
		cut.then = empty_block(pos)
		mut vs1 = cast(Block, cut.then).stmts
		vs1 = append(vs1, expr_stmt(call_fn(pos, argo_lib(pos, "argo.cut"), args2(mk_conv(pos, v, CV_SAME, ty_int), sym_ref_node(pos, cast(Sym, n0.sym))), ty_void)))
		stmts = append(stmts, cast(i64, cut))
		replace_node(e, mk_seq(pos, cast(i64, stmts), sym_ref_node(pos, cast(Sym, r1.sym)), ty_error))
		return ty_error
	}
	// Pass one only validates: input that fails never touches the target.
	let vf = argo_vfn(pos, cast(Ty, t))
	if vf == 0 {
		return ty_error
	}
	stmts = append(stmts, expr_stmt(call_fn(pos, cast(Fn, vf), args1(ps), ty_void)))
	let r = temp(pos, cast(i64, call_fn(pos, argo_lib(pos, "argo.finish"), args1(sym_ref_node(pos, cast(Sym, p.sym))), ty_error)), ty_error)
	stmts = append(stmts, cast(i64, r))
	// Pass two: the text is valid for this type, so it fills the target.
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = mk_bin(pos, "==", sym_ref_node(pos, cast(Sym, r.sym)), mk_int(pos, 0, ty_error), ty_bool)
	ifs.then = empty_block(pos)
	mut tb = cast(Block, ifs.then).stmts
	tb = append(tb, expr_stmt(call_fn(pos, argo_lib(pos, "argo.rewind"), args1(sym_ref_node(pos, cast(Sym, p.sym))), ty_void)))
	tb = append(tb, expr_stmt(call_fn(pos, cast(Fn, df), args2(sym_ref_node(pos, cast(Sym, p.sym)), v), ty_void)))
	tb = append(tb, assign_stmt(pos, sym_ref_node(pos, cast(Sym, r.sym)), cast(i64, call_fn(pos, argo_lib(pos, "argo.finish"), args1(sym_ref_node(pos, cast(Sym, p.sym))), ty_error))))
	stmts = append(stmts, cast(i64, ifs))
	replace_node(e, mk_seq(pos, cast(i64, stmts), sym_ref_node(pos, cast(Sym, r.sym)), ty_error))
	return ty_error
}

fn argo_parser_type(pos i64) i64 {
	if argo_ptype == 0 {
		argo_ptype = find_type("argo.Parser")
		if argo_ptype == 0 {
			err_code_at(pos, "E281 ARGO", "argo.Get needs package argo: import \"argo\"")
		}
	}
	return argo_ptype
}

// argo_rd is a call of reader name on parser p, of type t.
fn argo_rd(pos i64, p i64, name str, t i64) i64 {
	return cast(i64, call_fn(pos, argo_lib(pos, name), args1(sym_ref_node(pos, cast(Sym, p))), t))
}

fn argo_err_return(pos i64, body []i64, p i64) {
	let pt = argo_ptype
	let fi = struct_field(cast(Ty, pt), "err")
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = mk_bin(pos, "!=", mk_mem(pos, sym_ref_node(pos, cast(Sym, p)), 0, 0, field_offset(cast(Ty, pt), fi), ty_error), mk_int(pos, 0, ty_error), ty_bool)
	ifs.then = empty_block(pos)
	mut vs1 = cast(Block, ifs.then).stmts
	vs1 = append(vs1, node_new(ST_RETURN, pos))
	body = append(body, cast(i64, ifs))
}

// argo_new is a fresh value of type t with every reference field made (decode target).
fn argo_new(pos i64, body []i64, t Ty) i64 {
	let k = kind_of(t)
	if k == K_STRING {
		return lit_string(pos, "")
	}
	if k == K_SLICE {
		return rt_call(pos, "rt_slice_make", args3(mk_int(pos, 0, ty_int), mk_int(pos, 0, ty_int), mk_int(pos, elem_size(t), ty_int)), cast(i64, t))
	}
	if k == K_MAP {
		return map_make_call(pos, t)
	}
	if k != K_STRUCT {
		return mk_int(pos, 0, cast(i64, t))
	}
	if cast(i64, t.enum_) != 0 {
		return enum_zero(pos, body, t)
	}
	let obj = temp(pos, rt_call(pos, "rt_alloc", args1(mk_int(pos, t.size, ty_int)), cast(i64, t)), cast(i64, t))
	body = append(body, cast(i64, obj))
	mut fi = 0
	for fi < len(t.fields) {
		let ft = field_type(t, fi)
		let fk = kind_of(cast(Ty, ft))
		if fk == K_STRING || fk == K_SLICE || fk == K_MAP || fk == K_STRUCT {
			body = append(body, assign_stmt(pos, field_store(pos, sym_ref_node(pos, cast(Sym, obj.sym)), cast(i64, t), fi), argo_new(pos, body, cast(Ty, ft))))
		}
		fi = fi + 1
	}
	return sym_ref_node(pos, cast(Sym, obj.sym))
}

shared mut enum_zeroing []i64 // enums whose zero value is being built (a recursion guard)

// enum_zero is an enum's zero value: its first variant without data, else variant 0 with
// zero fields (an enum whose every variant holds itself has no finite zero value).
fn enum_zero(pos i64, body []i64, t Ty) i64 {
	if cast(i64, enum_zeroing) == 0 {
		enum_zeroing = []i64{}
	}
	let vs = t.enum_
	mut vi = 0
	for vi < len(vs) && vs[vi].count > 0 {
		vi = vi + 1
	}
	if vi == len(vs) {
		vi = 0
	}
	let obj = temp(pos, rt_call(pos, "rt_alloc", args1(mk_int(pos, t.size, ty_int)), cast(i64, t)), cast(i64, t))
	body = append(body, cast(i64, obj))
	body = append(body, assign_stmt(pos, field_store(pos, sym_ref_node(pos, cast(Sym, obj.sym)), cast(i64, t), 0), mk_int(pos, vi, ty_int)))
	let v = vs[vi]
	mut i = 0
	for i < len(enum_zeroing) {
		if cast(i64, cast(Ty, cast([]i64, enum_zeroing)[i])) == cast(i64, t) {
			err_code_type(pos, "E281 ARGO", "enum ", cast(i64, t), " has no zero value: give it a variant without data")
			return sym_ref_node(pos, cast(Sym, obj.sym))
		}
		i = i + 1
	}
	mut vs1 = cast([]i64, enum_zeroing)
	vs1 = append(vs1, cast(i64, t))
	mut k = 0
	for k < v.count {
		let fi = v.first + k
		let ft = field_type(t, fi)
		let fk = kind_of(cast(Ty, ft))
		if fk == K_STRING || fk == K_SLICE || fk == K_MAP || fk == K_STRUCT {
			body = append(body, assign_stmt(pos, field_store(pos, sym_ref_node(pos, cast(Sym, obj.sym)), cast(i64, t), fi), argo_new(pos, body, cast(Ty, ft))))
		}
		k = k + 1
	}
	slice_truncate(enum_zeroing, len(enum_zeroing) - 1)
	return sym_ref_node(pos, cast(Sym, obj.sym))
}

// argo_scalar reads one str, bool, float or integer of type t at p.
fn argo_scalar(pos i64, p i64, t Ty) i64 {
	let k = kind_of(t)
	if k == K_STRING && t.bound != 0 {
		// A str max n stops reading at the bound (#240).
		return cast(i64, call_fn(pos, argo_lib(pos, "argo.rstrmax"), args2(sym_ref_node(pos, cast(Sym, p)), mk_int(pos, t.max, ty_int)), ty_string))
	}
	if k == K_STRING {
		return argo_rd(pos, p, "argo.rstr", ty_string)
	}
	if k == K_BOOL {
		return argo_rd(pos, p, "argo.rbool", ty_bool)
	}
	if is_f32(t) != 0 {
		return argo_rd(pos, p, "argo.rfloat32", ty_f32)
	}
	if is_float_t(cast(i64, t)) != 0 {
		return argo_rd(pos, p, "argo.rfloat", ty_float)
	}
	if k == K_INT {
		let w = t.width
		if w == 8 && t.signed != 0 {
			return argo_rd(pos, p, "argo.rint", ty_int)
		}
		if w == 8 {
			return argo_rd(pos, p, "argo.ruint", ty_u64)
		}
		mut lo = 0
		mut hi = (1 << (8 * w)) - 1
		if t.signed != 0 {
			lo = 0 - (1 << (8 * w - 1))
			hi = (1 << (8 * w - 1)) - 1
		}
		let c = call_fn(pos, argo_lib(pos, "argo.rintr"), args3(sym_ref_node(pos, cast(Sym, p)), mk_int(pos, lo, ty_int), mk_int(pos, hi, ty_int)), ty_int)
		return mk_conv(pos, cast(i64, c), CV_INT, cast(i64, t))
	}
	return 0
}

// argo_value appends statements that decode one value of type t and returns it, or 0
// when t cannot be decoded (an error is reported).
fn argo_value(pos i64, body []i64, p i64, t Ty) i64 {
	let k = kind_of(t)
	if k == K_STRING || k == K_BOOL || k == K_INT || is_float_t(cast(i64, t)) != 0 {
		// null is the zero value outside GetStrict, as in Go (#715): v = zero; if
		// !argo.rnullok(p) { v = read(p) }.
		let z = zero_value(pos, cast(i64, t))
		cast(Node, z).type_ = cast(i64, t)
		let v = temp(pos, z, cast(i64, t))
		body = append(body, cast(i64, v))
		let ifs = cast(IfStmt, node_new(ST_IF, pos))
		ifs.cond = mk_unot(pos, argo_rd(pos, p, "argo.rnullok", ty_bool))
		ifs.then = empty_block(pos)
		mut tb = cast(Block, ifs.then).stmts
		let rv = argo_scalar(pos, p, t)
		tb = append(tb, assign_stmt(pos, sym_ref_node(pos, cast(Sym, v.sym)), rv))
		body = append(body, cast(i64, ifs))
		return sym_ref_node(pos, cast(Sym, v.sym))
	}
	if k == K_STRUCT || k == K_SLICE || k == K_MAP {
		let obj = temp(pos, argo_new(pos, body, t), cast(i64, t))
		body = append(body, cast(i64, obj))
		let df = argo_dfn(pos, t)
		if df == 0 {
			return 0
		}
		body = append(body, expr_stmt(call_fn(pos, cast(Fn, df), args2(sym_ref_node(pos, cast(Sym, p)), sym_ref_node(pos, cast(Sym, obj.sym))), ty_void)))
		return sym_ref_node(pos, cast(Sym, obj.sym))
	}
	if k == K_OPT && opt_scalar(t) != 0 {
		// ?number and ?bool: null is nil, else the number is the optional's payload (#632).
		let out = declare_local(pos, "$", cast(i64, t))
		body = append(body, let_stmt(pos, cast(Sym, out), mk_int(pos, 0, cast(i64, t))))
		let ifs = cast(IfStmt, node_new(ST_IF, pos))
		ifs.cond = mk_unot(pos, argo_rd(pos, p, "argo.rnull", ty_bool))
		ifs.then = empty_block(pos)
		let inner = argo_value(pos, cast(Block, ifs.then).stmts, p, cast(Ty, opt_scalar(t)))
		if inner == 0 {
			return 0
		}
		mut vp3 = cast(Block, ifs.then).stmts
		vp3 = append(vp3, assign_stmt(pos, sym_ref_node(pos, cast(Sym, out)), mk_conv(pos, to_bits(cast(Node, inner)), CV_OPT_SOME, cast(i64, t))))
		body = append(body, cast(i64, ifs))
		return sym_ref_node(pos, cast(Sym, out))
	}
	if opt_value(t) != 0 {
		// ?P (#669): null is nil, else the value goes after a set tag.
		let out = declare_local(pos, "$", cast(i64, t))
		body = append(body, let_stmt(pos, cast(Sym, out), mk_int(pos, 0, cast(i64, t))))
		let ifs = cast(IfStmt, node_new(ST_IF, pos))
		ifs.cond = mk_unot(pos, argo_rd(pos, p, "argo.rnull", ty_bool))
		ifs.then = empty_block(pos)
		let inner = argo_value(pos, cast(Block, ifs.then).stmts, p, cast(Ty, t.elem))
		if inner == 0 {
			return 0
		}
		mut vv = cast(Block, ifs.then).stmts
		vv = append(vv, assign_stmt(pos, opt_tag(pos, sym_ref_node(pos, cast(Sym, out))), mk_int(pos, 1, ty_int)))
		vv = append(vv, assign_stmt(pos, opt_payload(pos, sym_ref_node(pos, cast(Sym, out)), t.elem), inner))
		body = append(body, cast(i64, ifs))
		return sym_ref_node(pos, cast(Sym, out))
	}
	if k == K_OPT {
		let et = t.elem
		if is_ref(et) == 0 || kind_of(cast(Ty, et)) == K_FUNC {
			err_code_type(pos, "E281 ARGO", "argo.Get decodes optionals of references only, not ", cast(i64, t), "")
			return 0
		}
		let out = declare_local(pos, "$", cast(i64, t))
		body = append(body, let_stmt(pos, cast(Sym, out), mk_int(pos, 0, cast(i64, t))))
		let ifs = cast(IfStmt, node_new(ST_IF, pos))
		ifs.cond = mk_unot(pos, argo_rd(pos, p, "argo.rnull", ty_bool))
		ifs.then = empty_block(pos)
		let inner = argo_value(pos, cast(Block, ifs.then).stmts, p, cast(Ty, et))
		if inner == 0 {
			return 0
		}
		mut vs1 = cast(Block, ifs.then).stmts
		vs1 = append(vs1, assign_stmt(pos, sym_ref_node(pos, cast(Sym, out)), mk_conv(pos, inner, CV_SAME, cast(i64, t))))
		body = append(body, cast(i64, ifs))
		return sym_ref_node(pos, cast(Sym, out))
	}
	err_code_type(pos, "E281 ARGO", "argo.Get cannot decode values of type ", cast(i64, t), "")
	return 0
}

fn mk_unot(pos i64, x i64) i64 {
	let u = node_new(EX_UNARY, pos)
	cast(Unary, u).op = "!"
	cast(Unary, u).x = x
	cast(Node, u).type_ = ty_bool
	return u
}

fn forever(pos i64) WhileStmt {
	let w = cast(WhileStmt, node_new(ST_WHILE, pos))
	w.cond = mk_int(pos, 1, ty_bool)
	w.body = empty_block(pos)
	return cast(WhileStmt, w)
}

// argo_more ends a loop body: if !argo.rmore(p, close) { break }.
fn argo_more(pos i64, body []i64, p i64, close i64) {
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = mk_unot(pos, cast(i64, call_fn(pos, argo_lib(pos, "argo.rmore"), args2(sym_ref_node(pos, cast(Sym, p)), mk_int(pos, close, ty_byte)), ty_bool)))
	ifs.then = empty_block(pos)
	mut vs1 = cast(Block, ifs.then).stmts
	vs1 = append(vs1, node_new(ST_BREAK, pos))
	body = append(body, cast(i64, ifs))
}

// argo_denum decodes into enum x: renum gives the variant name (and whether it came as
// {"Name": payload}); the tag is set and the payload's fields are read by name.
fn argo_denum(pos i64, body []i64, p i64, x i64, t Ty) {
	let cm = cast(CallMultiStmt, node_new(ST_CALLMULTI, pos))
	cm.call = cast(i64, call_fn(pos, argo_lib(pos, "argo.renum"), args1(sym_ref_node(pos, cast(Sym, p))), ty_void))
	let nm = declare_local(pos, "$", ty_string)
	let boxed = declare_local(pos, "$", ty_bool)
	cm.syms = cast([]Sym, []i64{})
	mut vs1 = cast([]i64, cm.syms)
	vs1 = append(vs1, nm)
	mut vs2 = cast([]i64, cm.syms)
	vs2 = append(vs2, boxed)
	body = append(body, cast(i64, cm))
	argo_err_return(pos, body, p)
	let vs = t.enum_
	mut first = 0
	mut last = cast(IfStmt, 0)
	mut vi = 0
	for vi < len(vs) {
		let v = vs[vi]
		let vn = v.name
		let nfv = v.count
		let br = cast(IfStmt, node_new(ST_IF, pos))
		br.cond = rt_call(pos, "rt_str_eq", args2(sym_ref_node(pos, cast(Sym, nm)), lit_string(pos, vn)), ty_bool)
		br.then = empty_block(pos)
		mut bb = cast(Block, br.then).stmts
		bb = append(bb, assign_stmt(pos, field_store(pos, sym_ref_node(pos, cast(Sym, x)), cast(i64, t), 0), mk_int(pos, vi, ty_int)))
		mut z = 0
		for z < nfv {
			let zf = v.first + z
			let zt = field_type(t, zf)
			let zk = kind_of(cast(Ty, zt))
			if zk == K_STRING || zk == K_SLICE || zk == K_MAP || zk == K_STRUCT {
				bb = append(bb, assign_stmt(pos, field_store(pos, sym_ref_node(pos, cast(Sym, x)), cast(i64, t), zf), argo_new(pos, bb, cast(Ty, zt))))
			}
			z = z + 1
		}
		if nfv == 0 {
			// A bare "Name"; {"Name": anything} skips the payload.
			let ib = cast(IfStmt, node_new(ST_IF, pos))
			ib.cond = sym_ref_node(pos, cast(Sym, boxed))
			ib.then = empty_block(pos)
			mut vs3 = cast(Block, ib.then).stmts
			vs3 = append(vs3, expr_stmt(call_fn(pos, argo_lib(pos, "argo.rskip"), args1(sym_ref_node(pos, cast(Sym, p))), ty_void)))
			mut vs4 = cast(Block, ib.then).stmts
			vs4 = append(vs4, expr_stmt(call_fn(pos, argo_lib(pos, "argo.rclose"), args1(sym_ref_node(pos, cast(Sym, p))), ty_void)))
			bb = append(bb, cast(i64, ib))
		} else {
			let nb = cast(IfStmt, node_new(ST_IF, pos))
			nb.cond = mk_unot(pos, sym_ref_node(pos, cast(Sym, boxed)))
			nb.then = empty_block(pos)
			mut vs5 = cast(Block, nb.then).stmts
			vs5 = append(vs5, expr_stmt(call_fn(pos, argo_lib(pos, "argo.rvariant"), args2(sym_ref_node(pos, cast(Sym, p)), sym_ref_node(pos, cast(Sym, nm))), ty_void)))
			mut vs6 = cast(Block, nb.then).stmts
			vs6 = append(vs6, node_new(ST_RETURN, pos))
			bb = append(bb, cast(i64, nb))
			let ob = cast(IfStmt, node_new(ST_IF, pos))
			ob.cond = argo_rd(pos, p, "argo.robj", ty_bool)
			ob.then = empty_block(pos)
			let w = forever(pos)
			mut vs7 = cast(Block, ob.then).stmts
			vs7 = append(vs7, cast(i64, w))
			mut wb = cast(Block, w.body).stmts
			let key = temp(pos, argo_rd(pos, p, "argo.rkey", ty_string), ty_string)
			wb = append(wb, cast(i64, key))
			argo_err_return(pos, wb, p)
			mut chain = 0
			mut lastf = cast(IfStmt, 0)
			mut kk = 0
			for kk < nfv {
				let fi = v.first + kk
				let full = cast(Field, t.fields[fi]).name
				let ft = field_type(t, fi)
				let fb = cast(IfStmt, node_new(ST_IF, pos))
				fb.cond = rt_call(pos, "rt_str_eq", args2(sym_ref_node(pos, cast(Sym, key.sym)), lit_string(pos, full[len(vn) + 1:])), ty_bool)
				fb.then = empty_block(pos)
				mut fbb = cast(Block, fb.then).stmts
				let fk = kind_of(cast(Ty, ft))
				if fk == K_STRUCT || fk == K_SLICE || fk == K_MAP {
					let df = argo_dfn(pos, cast(Ty, ft))
					if df != 0 {
						fbb = append(fbb, expr_stmt(call_fn(pos, cast(Fn, df), args2(sym_ref_node(pos, cast(Sym, p)), mk_mem(pos, sym_ref_node(pos, cast(Sym, x)), 0, 0, field_offset(t, fi), ft)), ty_void)))
					}
				} else {
					let val = argo_value(pos, fbb, p, cast(Ty, ft))
					if val != 0 {
						fbb = append(fbb, assign_stmt(pos, field_store(pos, sym_ref_node(pos, cast(Sym, x)), cast(i64, t), fi), val))
					}
				}
				if cast(i64, lastf) != 0 {
					let eb = cast(Block, empty_block(pos))
					eb.stmts = append(eb.stmts, cast(i64, fb))
					lastf.else_ = cast(i64, eb)
				} else {
					chain = cast(i64, fb)
				}
				lastf = fb
				kk = kk + 1
			}
			let sb = cast(Block, empty_block(pos))
			sb.stmts = append(sb.stmts, expr_stmt(call_fn(pos, argo_lib(pos, "argo.runknown"), args2(sym_ref_node(pos, cast(Sym, p)), sym_ref_node(pos, cast(Sym, key.sym))), ty_void)))
			lastf.else_ = cast(i64, sb)
			wb = append(wb, chain)
			argo_more(pos, wb, p, '}')
			bb = append(bb, cast(i64, ob))
			bb = append(bb, expr_stmt(call_fn(pos, argo_lib(pos, "argo.rclose"), args1(sym_ref_node(pos, cast(Sym, p))), ty_void)))
		}
		if cast(i64, last) != 0 {
			let eb2 = cast(Block, empty_block(pos))
			eb2.stmts = append(eb2.stmts, cast(i64, br))
			last.else_ = cast(i64, eb2)
		} else {
			first = cast(i64, br)
		}
		last = br
		vi = vi + 1
	}
	let unk = cast(Block, empty_block(pos))
	unk.stmts = append(unk.stmts, expr_stmt(call_fn(pos, argo_lib(pos, "argo.rvariant"), args2(sym_ref_node(pos, cast(Sym, p)), sym_ref_node(pos, cast(Sym, nm))), ty_void)))
	last.else_ = cast(i64, unk)
	body = append(body, first)
}

// argo_bound stops decoding a bounded slice or map x before an element past its bound:
// if len(x) >= max { argo.over(p, max); return } (#240).
fn argo_bound(pos i64, body []i64, p i64, x i64, t Ty) {
	if t.bound == 0 {
		return
	}
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = mk_bin(pos, ">=", mk_hdr(pos, sym_ref_node(pos, cast(Sym, x)), 0), mk_int(pos, t.max, ty_int), ty_bool)
	ifs.then = empty_block(pos)
	mut vs1 = cast(Block, ifs.then).stmts
	vs1 = append(vs1, expr_stmt(call_fn(pos, argo_lib(pos, "argo.over"), args2(sym_ref_node(pos, cast(Sym, p)), mk_int(pos, t.max, ty_int)), ty_void)))
	mut vs2 = cast(Block, ifs.then).stmts
	vs2 = append(vs2, node_new(ST_RETURN, pos))
	body = append(body, cast(i64, ifs))
}

// argo_null_return starts a decoder or validator: outside GetStrict a null leaves the target
// as it was (#715): if argo.rnullok(p) { return }.
fn argo_null_return(pos i64, body []i64, p i64) {
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = argo_rd(pos, p, "argo.rnullok", ty_bool)
	ifs.then = empty_block(pos)
	mut tb = cast(Block, ifs.then).stmts
	tb = append(tb, node_new(ST_RETURN, pos))
	body = append(body, cast(i64, ifs))
}

// argo_null_keeps puts the statements of block b that decode a field of type ft under
// if !argo.rnullok(p): a null leaves the field as it was, as in Go (#715). An optional field
// reads null as nil itself.
fn argo_null_keeps(pos i64, b i64, p i64, ft Ty) {
	if kind_of(ft) == K_OPT {
		return
	}
	let blk = cast(Block, b)
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = mk_unot(pos, argo_rd(pos, p, "argo.rnullok", ty_bool))
	ifs.then = empty_block(pos)
	cast(Block, ifs.then).stmts = blk.stmts
	blk.stmts = cast([]i64, []i64{})
	blk.stmts = append(blk.stmts, cast(i64, ifs))
}

// argo_int_key reads member name k (a str Sym) as a key of integer type t: argo.rkeyint
// within t's range, or argo.rkeyuint for an unsigned t (#716).
fn argo_int_key(pos i64, p i64, k i64, t Ty) i64 {
	let w = t.width
	if t.signed == 0 {
		mut hi = -1
		if w < 8 {
			hi = (1 << (8 * w)) - 1
		}
		let c = call_fn(pos, argo_lib(pos, "argo.rkeyuint"), args3(sym_ref_node(pos, cast(Sym, p)), sym_ref_node(pos, cast(Sym, k)), mk_int(pos, hi, ty_u64)), ty_u64)
		return mk_conv(pos, cast(i64, c), CV_INT, cast(i64, t))
	}
	mut lo = -9223372036854775807 - 1
	mut hi = 9223372036854775807
	if w < 8 {
		lo = 0 - (1 << (8 * w - 1))
		hi = (1 << (8 * w - 1)) - 1
	}
	let c = call_fn(pos, argo_lib(pos, "argo.rkeyint"), args4(sym_ref_node(pos, cast(Sym, p)), sym_ref_node(pos, cast(Sym, k)), mk_int(pos, lo, ty_int), mk_int(pos, hi, ty_int)), ty_int)
	return mk_conv(pos, cast(i64, c), CV_INT, cast(i64, t))
}

// argo_dfn returns (generating on first use) argo$dN(p mut argo.Parser, x mut T), which
// fills x from the JSON value at p.
fn argo_dfn(pos i64, t Ty) i64 {
	if cast(i64, argo_dtypes) == 0 {
		argo_dtypes = []i64{}
		argo_dfns = []i64{}
	}
	mut i = 0
	for i < len(argo_dtypes) {
		if cast(i64, cast(Ty, cast([]i64, argo_dtypes)[i])) == cast(i64, t) {
			return argo_dfns[i]
		}
		i = i + 1
	}
	let pt = argo_parser_type(pos)
	if pt == 0 {
		return 0
	}
	let k = kind_of(t)
	if k == K_MAP && kind_of(cast(Ty, t.key)) != K_STRING && kind_of(cast(Ty, t.key)) != K_INT {
		err_code_type(pos, "E281 ARGO", "argo.Get decodes maps with str or integer keys, not ", cast(i64, t), "")
		return 0
	}
	lifted_count = lifted_count + 1
	let f = fn_new(0, "argo")
	let nb = buf_new()
	buf_str(nb, "argo$d")
	buf_int(nb, lifted_count)
	f.qname = str(nb)
	f.name = str(nb)
	f.lifted = 2
	f.params = append(f.params, "p")
	f.params = append(f.params, "x")
	f.ptypes = append(f.ptypes, pt)
	f.ptypes = append(f.ptypes, cast(i64, t))
	f.muts = append(f.muts, 1)
	f.muts = append(f.muts, 1)
	f.type_ = func_of(f.ptypes, f.rtypes, 0)
	f.locals = cast([]Sym, []i64{})
	f.body = empty_block(0)
	mut vs7 = cast([]i64, argo_dtypes)
	vs7 = append(vs7, cast(i64, t))
	argo_dfns = append(argo_dfns, cast(i64, f))
	prog_fns = append(prog_fns, cast(Fn, f))
	let saved_fn = ck_fn
	ck_fn = cast(Fn, f)
	let p = sym_new(SYM_LOCAL, "p", 0)
	p.type_ = pt
	p.slot = 0
	p.mut_ = 1
	let x = sym_new(SYM_LOCAL, "x", 0)
	x.type_ = cast(i64, t)
	x.slot = 1
	x.mut_ = 1
	f.slots = 2
	mut vs8 = cast([]i64, f.locals)
	vs8 = append(vs8, cast(i64, p))
	mut vs9 = cast([]i64, f.locals)
	vs9 = append(vs9, cast(i64, x))
	mut body = cast(Block, f.body).stmts
	argo_null_return(pos, body, cast(i64, p))
	if k == K_STRUCT && cast(i64, t.enum_) != 0 {
		argo_denum(pos, body, cast(i64, p), cast(i64, x), t)
	} else if k == K_STRUCT {
		let ifs = cast(IfStmt, node_new(ST_IF, pos))
		ifs.cond = mk_unot(pos, argo_rd(pos, cast(i64, p), "argo.robj", ty_bool))
		ifs.then = empty_block(pos)
		mut vs10 = cast(Block, ifs.then).stmts
		vs10 = append(vs10, node_new(ST_RETURN, pos))
		body = append(body, cast(i64, ifs))
		let w = forever(pos)
		body = append(body, cast(i64, w))
		mut wb = cast(Block, w.body).stmts
		let key = temp(pos, argo_rd(pos, cast(i64, p), "argo.rkey", ty_string), ty_string)
		wb = append(wb, cast(i64, key))
		argo_err_return(pos, wb, cast(i64, p))
		mut chain = 0
		mut last = cast(IfStmt, 0)
		mut fi = 0
		for fi < len(t.fields) {
			mut fname = cast(Field, t.fields[fi]).name
			let json_name = cast(Field, t.fields[fi]).json
			if len(json_name) != 0 {
				fname = json_name
			}
			let ft = field_type(t, fi)
			let br = cast(IfStmt, node_new(ST_IF, pos))
			br.cond = rt_call(pos, "rt_str_eq", args2(sym_ref_node(pos, cast(Sym, key.sym)), lit_string(pos, fname)), ty_bool)
			br.then = empty_block(pos)
			mut bb = cast(Block, br.then).stmts
			let fk = kind_of(cast(Ty, ft))
			if fk == K_STRUCT || fk == K_SLICE || fk == K_MAP || fk == K_VARRAY {
				// Fill the object the field already holds (a value struct's or inline array's
				// bytes in place, #631).
				let df = argo_dfn(pos, cast(Ty, ft))
				if df != 0 {
					bb = append(bb, expr_stmt(call_fn(pos, cast(Fn, df), args2(sym_ref_node(pos, p), mk_mem(pos, sym_ref_node(pos, x), 0, 0, field_offset(t, fi), ft)), ty_void)))
				}
			} else {
				let val = argo_value(pos, bb, cast(i64, p), cast(Ty, ft))
				if val != 0 {
					bb = append(bb, assign_stmt(pos, field_store(pos, sym_ref_node(pos, x), cast(i64, t), fi), val))
				}
			}
			argo_null_keeps(pos, br.then, cast(i64, p), cast(Ty, ft))
			if cast(i64, last) != 0 {
				let eb = cast(Block, empty_block(pos))
				eb.stmts = append(eb.stmts, cast(i64, br))
				last.else_ = cast(i64, eb)
			} else {
				chain = cast(i64, br)
			}
			last = br
			fi = fi + 1
		}
		let skip = expr_stmt(call_fn(pos, argo_lib(pos, "argo.runknown"), args2(sym_ref_node(pos, p), sym_ref_node(pos, cast(Sym, key.sym))), ty_void))
		if cast(i64, last) != 0 {
			let sb = cast(Block, empty_block(pos))
			sb.stmts = append(sb.stmts, skip)
			last.else_ = cast(i64, sb)
			wb = append(wb, chain)
		} else {
			wb = append(wb, skip)
		}
		argo_more(pos, wb, cast(i64, p), '}')
	} else if k == K_VARRAY {
		// Up to N elements in place; JSON elements past N are skipped, as Go does (#631).
		let et = t.elem
		let ifs4 = cast(IfStmt, node_new(ST_IF, pos))
		ifs4.cond = mk_unot(pos, argo_rd(pos, cast(i64, p), "argo.rarr", ty_bool))
		ifs4.then = empty_block(pos)
		mut vs15 = cast(Block, ifs4.then).stmts
		vs15 = append(vs15, node_new(ST_RETURN, pos))
		body = append(body, cast(i64, ifs4))
		let jv = declare_local(pos, "$", ty_int)
		body = append(body, let_stmt(pos, cast(Sym, jv), mk_int(pos, 0, ty_int)))
		let w4 = forever(pos)
		body = append(body, cast(i64, w4))
		mut wb4 = cast(Block, w4.body).stmts
		let inr = cast(IfStmt, node_new(ST_IF, pos))
		inr.cond = mk_bin(pos, "<", sym_ref_node(pos, cast(Sym, jv)), mk_int(pos, t.key, ty_int), ty_bool)
		inr.then = empty_block(pos)
		let el = mk_mem(pos, sym_ref_node(pos, cast(Sym, x)), sym_ref_node(pos, cast(Sym, jv)), type_width(cast(Ty, et)), 0, et)
		mut ib = cast(Block, inr.then).stmts
		let ek = kind_of(cast(Ty, et))
		if ek == K_STRUCT || ek == K_VARRAY {
			let edf = argo_dfn(pos, cast(Ty, et))
			if edf != 0 {
				ib = append(ib, expr_stmt(call_fn(pos, cast(Fn, edf), args2(sym_ref_node(pos, cast(Sym, p)), el), ty_void)))
			}
		} else {
			let eval = argo_value(pos, ib, cast(i64, p), cast(Ty, et))
			if eval != 0 {
				ib = append(ib, assign_stmt(pos, el, eval))
			}
		}
		let skipb = cast(Block, empty_block(pos))
		skipb.stmts = append(skipb.stmts, expr_stmt(call_fn(pos, argo_lib(pos, "argo.rskip"), args1(sym_ref_node(pos, cast(Sym, p))), ty_void)))
		inr.else_ = cast(i64, skipb)
		wb4 = append(wb4, cast(i64, inr))
		wb4 = append(wb4, assign_stmt(pos, sym_ref_node(pos, cast(Sym, jv)), mk_bin(pos, "+", sym_ref_node(pos, cast(Sym, jv)), mk_int(pos, 1, ty_int), ty_int)))
		argo_err_return(pos, wb4, cast(i64, p))
		argo_more(pos, wb4, cast(i64, p), ']')
	} else if k == K_SLICE {
		let et = t.elem
		let ifs2 = cast(IfStmt, node_new(ST_IF, pos))
		ifs2.cond = mk_unot(pos, argo_rd(pos, cast(i64, p), "argo.rarr", ty_bool))
		ifs2.then = empty_block(pos)
		mut vs13 = cast(Block, ifs2.then).stmts
		vs13 = append(vs13, node_new(ST_RETURN, pos))
		body = append(body, cast(i64, ifs2))
		let w2 = forever(pos)
		body = append(body, cast(i64, w2))
		mut wb2 = cast(Block, w2.body).stmts
		argo_bound(pos, wb2, cast(i64, p), cast(i64, x), t)
		let ev = argo_value(pos, wb2, cast(i64, p), cast(Ty, et))
		if ev != 0 && is_dyn_value(cast(Ty, et)) != 0 {
			// A two-word element (#632).
			wb2 = append(wb2, expr_stmt(cast(Node, lower_append_dyn(pos, sym_ref_node(pos, x), ev, t))))
		} else if ev != 0 && is_value_struct(cast(Ty, et)) != 0 {
			// A value struct element's bytes (#631).
			wb2 = append(wb2, expr_stmt(cast(Node, rt_call(pos, "rt_append_mem", args3(sym_ref_node(pos, x), ev, mk_int(pos, elem_size(t), ty_int)), cast(i64, t)))))
		} else if ev != 0 {
			wb2 = append(wb2, expr_stmt(cast(Node, rt_call(pos, "rt_append", args3(sym_ref_node(pos, x), elem_bits(cast(Node, ev), t.elem), mk_int(pos, elem_size(t), ty_int)), cast(i64, t)))))
		}
		argo_err_return(pos, wb2, cast(i64, p))
		argo_more(pos, wb2, cast(i64, p), ']')
	} else if k == K_MAP {
		let ifs3 = cast(IfStmt, node_new(ST_IF, pos))
		ifs3.cond = mk_unot(pos, argo_rd(pos, cast(i64, p), "argo.robj", ty_bool))
		ifs3.then = empty_block(pos)
		mut vs14 = cast(Block, ifs3.then).stmts
		vs14 = append(vs14, node_new(ST_RETURN, pos))
		body = append(body, cast(i64, ifs3))
		let w3 = forever(pos)
		body = append(body, cast(i64, w3))
		mut wb3 = cast(Block, w3.body).stmts
		argo_bound(pos, wb3, cast(i64, p), cast(i64, x), t)
		let mk = temp(pos, argo_rd(pos, cast(i64, p), "argo.rkey", ty_string), ty_string)
		wb3 = append(wb3, cast(i64, mk))
		argo_err_return(pos, wb3, cast(i64, p))
		mut ks = cast(Sym, mk.sym)
		if kind_of(cast(Ty, t.key)) == K_INT {
			// An integer key comes as a member name: "7" (#716).
			let ik = temp(pos, argo_int_key(pos, cast(i64, p), cast(i64, ks), cast(Ty, t.key)), t.key)
			wb3 = append(wb3, cast(i64, ik))
			argo_err_return(pos, wb3, cast(i64, p))
			ks = cast(Sym, ik.sym)
		}
		let mv = argo_value(pos, wb3, cast(i64, p), cast(Ty, t.elem))
		if mv != 0 && is_value_struct(cast(Ty, t.elem)) != 0 {
			// A value struct goes in a cell of the map's own (#669).
			wb3 = append(wb3, expr_stmt(cast(Node, map_set_vcell(pos, sym_ref_node(pos, x), sym_ref_node(pos, ks), mv, 0))))
		} else if mv != 0 && is_dyn_value(cast(Ty, t.elem)) != 0 {
			// Two-word values go in cells of the map's own (#632).
			wb3 = append(wb3, expr_stmt(cast(Node, map_set_dyn(pos, sym_ref_node(pos, x), sym_ref_node(pos, ks), mv, 0))))
		} else if mv != 0 {
			wb3 = append(wb3, expr_stmt(cast(Node, rt_call(pos, "rt_map_set", args4(sym_ref_node(pos, x), to_bits(cast(Node, sym_ref_node(pos, ks))), to_bits(cast(Node, mv)), mk_int(pos, 1, ty_int)), ty_void))))
		}
		argo_err_return(pos, wb3, cast(i64, p))
		argo_more(pos, wb3, cast(i64, p), '}')
	}
	ck_fn = saved_fn
	return cast(i64, f)
}

// ---- argo.Get pass one: a validator generated for each type ----
// argo$vN(p mut argo.Parser) reads the JSON value at p the way argo$dN does, with the same
// faults, but stores nothing: Get runs it first, so a fault never leaves the target half
// filled, and decoding then cannot fail.
shared mut argo_vtypes []i64
shared mut argo_vfns []i64

// argo_vval validates one value of type t at p (a Sym).
fn argo_vval(pos i64, body []i64, p i64, t Ty) {
	let k = kind_of(t)
	if k == K_STRUCT || k == K_SLICE || k == K_MAP || k == K_VARRAY {
		let vf = argo_vfn(pos, t)
		if vf != 0 {
			body = append(body, expr_stmt(call_fn(pos, cast(Fn, vf), args1(sym_ref_node(pos, cast(Sym, p))), ty_void)))
		}
		return
	}
	if k == K_OPT {
		mut et = t.elem
		if opt_scalar(t) != 0 {
			et = opt_scalar(t)
		}
		if is_ref(et) == 0 && opt_scalar(t) == 0 && opt_value(t) == 0 || kind_of(cast(Ty, et)) == K_FUNC {
			return
		}
		let ifs = cast(IfStmt, node_new(ST_IF, pos))
		ifs.cond = mk_unot(pos, argo_rd(pos, p, "argo.rnull", ty_bool))
		ifs.then = empty_block(pos)
		argo_vval(pos, cast(Block, ifs.then).stmts, p, cast(Ty, et))
		body = append(body, cast(i64, ifs))
		return
	}
	if is_f32(t) != 0 || is_float_t(cast(i64, t)) != 0 {
		// The grammar and the range, without converting (most numbers cannot overflow).
		mut width = 300
		if is_f32(t) != 0 {
			width = 38
		}
		body = append(body, expr_stmt(call_fn(pos, argo_lib(pos, "argo.vfloat"), args2(sym_ref_node(pos, cast(Sym, p)), mk_int(pos, width, ty_int)), ty_void)))
		return
	}
	let val = argo_value(pos, body, p, t)
	if val != 0 {
		body = append(body, expr_stmt(cast(Node, val)))
	}
}

// argo_vbound is argo_bound for a validator: cnt counts the elements read so far.
fn argo_vbound(pos i64, body []i64, p i64, cnt i64, t Ty) {
	if t.bound == 0 {
		return
	}
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = mk_bin(pos, ">=", sym_ref_node(pos, cast(Sym, cnt)), mk_int(pos, t.max, ty_int), ty_bool)
	ifs.then = empty_block(pos)
	mut vs1 = cast(Block, ifs.then).stmts
	vs1 = append(vs1, expr_stmt(call_fn(pos, argo_lib(pos, "argo.over"), args2(sym_ref_node(pos, cast(Sym, p)), mk_int(pos, t.max, ty_int)), ty_void)))
	mut vs2 = cast(Block, ifs.then).stmts
	vs2 = append(vs2, node_new(ST_RETURN, pos))
	body = append(body, cast(i64, ifs))
	body = append(body, assign_stmt(pos, sym_ref_node(pos, cast(Sym, cnt)), mk_bin(pos, "+", sym_ref_node(pos, cast(Sym, cnt)), mk_int(pos, 1, ty_int), ty_int)))
}

// argo_vfn returns (generating on first use) argo$vN(p mut argo.Parser) for type t, or 0
// when t cannot be decoded (argo_dfn reports that).
fn argo_vfn(pos i64, t Ty) i64 {
	if cast(i64, argo_vtypes) == 0 {
		argo_vtypes = []i64{}
		argo_vfns = []i64{}
	}
	mut i = 0
	for i < len(argo_vtypes) {
		if cast(i64, cast(Ty, argo_vtypes[i])) == cast(i64, t) {
			return argo_vfns[i]
		}
		i = i + 1
	}
	let pt = argo_parser_type(pos)
	let k = kind_of(t)
	if pt == 0 || (k == K_MAP && kind_of(cast(Ty, t.key)) != K_STRING && kind_of(cast(Ty, t.key)) != K_INT) {
		return 0
	}
	lifted_count = lifted_count + 1
	let f = fn_new(0, "argo")
	let nb = buf_new()
	buf_str(nb, "argo$v")
	buf_int(nb, lifted_count)
	f.qname = str(nb)
	f.name = str(nb)
	f.lifted = 2
	f.params = append(f.params, "p")
	f.ptypes = append(f.ptypes, pt)
	f.muts = append(f.muts, 1)
	f.type_ = func_of(f.ptypes, f.rtypes, 0)
	f.locals = cast([]Sym, []i64{})
	f.body = empty_block(0)
	argo_vtypes = append(argo_vtypes, cast(i64, t))
	argo_vfns = append(argo_vfns, cast(i64, f))
	prog_fns = append(prog_fns, cast(Fn, f))
	let saved_fn = ck_fn
	ck_fn = cast(Fn, f)
	let ps = sym_new(SYM_LOCAL, "p", 0)
	ps.type_ = pt
	ps.slot = 0
	ps.mut_ = 1
	f.slots = 1
	mut vs4 = cast([]i64, f.locals)
	vs4 = append(vs4, cast(i64, ps))
	let p = cast(i64, ps)
	mut body = cast(Block, f.body).stmts
	argo_null_return(pos, body, p)
	if k == K_STRUCT && cast(i64, t.enum_) != 0 {
		// An enum's payload shapes are decoded into a scratch value.
		let df = argo_dfn(pos, t)
		if df != 0 {
			let obj = temp(pos, argo_new(pos, body, t), cast(i64, t))
			body = append(body, cast(i64, obj))
			body = append(body, expr_stmt(call_fn(pos, cast(Fn, df), args2(sym_ref_node(pos, ps), sym_ref_node(pos, cast(Sym, obj.sym))), ty_void)))
		}
	} else if k == K_STRUCT {
		let ifs = cast(IfStmt, node_new(ST_IF, pos))
		ifs.cond = mk_unot(pos, argo_rd(pos, p, "argo.robj", ty_bool))
		ifs.then = empty_block(pos)
		mut vs5 = cast(Block, ifs.then).stmts
		vs5 = append(vs5, node_new(ST_RETURN, pos))
		body = append(body, cast(i64, ifs))
		let w = forever(pos)
		body = append(body, cast(i64, w))
		mut wb = cast(Block, w.body).stmts
		let key = temp(pos, argo_rd(pos, p, "argo.rkey", ty_string), ty_string)
		wb = append(wb, cast(i64, key))
		argo_err_return(pos, wb, p)
		mut chain = 0
		mut last = cast(IfStmt, 0)
		mut fi = 0
		for fi < len(t.fields) {
			mut fname = cast(Field, t.fields[fi]).name
			let json_name = cast(Field, t.fields[fi]).json
			if len(json_name) != 0 {
				fname = json_name
			}
			let br = cast(IfStmt, node_new(ST_IF, pos))
			br.cond = rt_call(pos, "rt_str_eq", args2(sym_ref_node(pos, cast(Sym, key.sym)), lit_string(pos, fname)), ty_bool)
			br.then = empty_block(pos)
			argo_vval(pos, cast(Block, br.then).stmts, p, cast(Ty, field_type(t, fi)))
			argo_null_keeps(pos, br.then, p, cast(Ty, field_type(t, fi)))
			if cast(i64, last) != 0 {
				let eb = cast(Block, empty_block(pos))
				eb.stmts = append(eb.stmts, cast(i64, br))
				last.else_ = cast(i64, eb)
			} else {
				chain = cast(i64, br)
			}
			last = br
			fi = fi + 1
		}
		let skip = expr_stmt(call_fn(pos, argo_lib(pos, "argo.runknown"), args2(sym_ref_node(pos, ps), sym_ref_node(pos, cast(Sym, key.sym))), ty_void))
		if cast(i64, last) != 0 {
			let sb = cast(Block, empty_block(pos))
			sb.stmts = append(sb.stmts, skip)
			last.else_ = cast(i64, sb)
			wb = append(wb, chain)
		} else {
			wb = append(wb, skip)
		}
		argo_more(pos, wb, p, '}')
	} else if k == K_SLICE || k == K_MAP || k == K_VARRAY {
		// An inline array is checked as a JSON array (#631).
		let ifs = cast(IfStmt, node_new(ST_IF, pos))
		mut opener = "argo.rarr"
		mut close = ']'
		if k == K_MAP {
			opener = "argo.robj"
			close = '}'
		}
		ifs.cond = mk_unot(pos, argo_rd(pos, p, opener, ty_bool))
		ifs.then = empty_block(pos)
		mut vs8 = cast(Block, ifs.then).stmts
		vs8 = append(vs8, node_new(ST_RETURN, pos))
		body = append(body, cast(i64, ifs))
		let cnt = declare_local(pos, "$", ty_int)
		body = append(body, let_stmt(pos, cast(Sym, cnt), mk_int(pos, 0, ty_int)))
		let w = forever(pos)
		body = append(body, cast(i64, w))
		mut wb = cast(Block, w.body).stmts
		argo_vbound(pos, wb, p, cnt, t)
		if k == K_MAP && kind_of(cast(Ty, t.key)) == K_INT {
			// An integer key must parse and fit (#716).
			let vk = temp(pos, argo_rd(pos, p, "argo.rkey", ty_string), ty_string)
			wb = append(wb, cast(i64, vk))
			wb = append(wb, expr_stmt(cast(Node, argo_int_key(pos, p, cast(i64, vk.sym), cast(Ty, t.key)))))
			argo_err_return(pos, wb, p)
		} else if k == K_MAP {
			wb = append(wb, expr_stmt(cast(Node, argo_rd(pos, p, "argo.rkey", ty_string))))
			argo_err_return(pos, wb, p)
		}
		argo_vval(pos, wb, p, cast(Ty, t.elem))
		argo_err_return(pos, wb, p)
		argo_more(pos, wb, p, close)
	}
	ck_fn = saved_fn
	return cast(i64, f)
}

// ---- say: formatting without interfaces ----
fn is_say_func(m str) i64 {
	return i64(m == "Line" || m == "Text" || m == "Out" || m == "Fmt" || m == "Str" || m == "Fault" || m == "To" || m == "LineTo")
}

// say_arg formats one argument by its static type: prefix + "i", "s", "f", ...
// say_type_has_dyn reports whether a struct's fields (or a container's element) hold a
// dyn value, which has no formatter until the table lands. The depth limit keeps a
// recursive type (an enum holding itself) finite; a deeper dyn is still caught by
// say_arg when the recursion reaches it.
fn say_type_has_dyn(t i64) i64 {
	return say_type_has_dyn_at(cast(Ty, t), 0)
}

fn say_type_has_dyn_at(t Ty, depth i64) i64 {
	if depth > 8 {
		return 0
	}
	let k = kind_of(t)
	if k == K_DYN {
		return 1
	}
	if k == K_OPT || k == K_SLICE {
		return say_type_has_dyn_at(cast(Ty, t.elem), depth + 1)
	}
	if k == K_MAP {
		return i64(say_type_has_dyn_at(cast(Ty, t.key), depth + 1) != 0 || say_type_has_dyn_at(cast(Ty, t.elem), depth + 1) != 0)
	}
	if k == K_STRUCT {
		mut i = 0
		for i < len(t.fields) {
			if say_type_has_dyn_at(cast(Ty, field_type(t, i)), depth + 1) != 0 {
				return 1
			}
			i = i + 1
		}
	}
	return 0
}

fn say_arg(a Node, prefix str) Node {
	let pos = a.pos
	let t = cast(Ty, default_type(chk(a, 0)))
	check_value(pos, cast(i64, t))
	if is_untyped(a.type_) != 0 {
		reconvert(a, cast(i64, t))
	}
	let k = kind_of(t)
	mut suffix = "i"
	if k == K_STRING {
		suffix = "s"
	} else if k == K_FLOAT {
		suffix = "f"
		if is_f32(t) != 0 {
			suffix = "f32"
		}
	} else if k == K_BOOL {
		suffix = "b"
	} else if k == K_ERROR {
		suffix = "e"
	} else if is_unsigned_t(t) != 0 {
		suffix = "u"
	} else if k == K_VARRAY {
		return cast(Node, say_varray(a, t, prefix))
	} else if k == K_SLICE {
		let et = t.elem
		let ek = kind_of(cast(Ty, et))
		if ek == K_DYN || say_type_has_dyn(et) != 0 {
			// Element by element: a dyn value formats through its table (#569).
			return cast(Node, say_struct_slice(a, t, prefix))
		}
		if ek == K_STRING {
			suffix = "sls"
		} else if ek == K_FLOAT {
			suffix = "slf"
			if is_f32(cast(Ty, et)) != 0 {
				suffix = "slf32"
			}
		} else if ek == K_BOOL {
			suffix = "slt"
		} else if ek == K_INT {
			return cast(Node, rt_call(pos, prefix + "slint", args3(cast(i64, a), mk_int(pos, type_width(cast(Ty, et)), ty_int), mk_int(pos, cast(Ty, et).signed, ty_int)), ty_void))
		} else if ek == K_OPT && opt_scalar(cast(Ty, et)) != 0 {
			return cast(Node, say_optnum_slice(a, t, prefix))
		} else if ek == K_STRUCT && cast(i64, cast(Ty, et).enum_) != 0 {
			return cast(Node, say_enum_slice(a, t, prefix))
		} else if ek == K_STRUCT {
			return cast(Node, say_struct_slice(a, t, prefix))
		} else if ek == K_SLICE || ek == K_MAP || ek == K_ERROR || (ek == K_OPT && kind_of(cast(Ty, cast(Ty, et).elem)) != K_STRUCT) || opt_value(cast(Ty, et)) != 0 {
			// Element by element, each as its own type prints (#524).
			return cast(Node, say_struct_slice(a, t, prefix))
		} else {
			suffix = "slp"
		}
	} else if k == K_OPT && (opt_scalar(t) != 0 || opt_value(t) != 0 || (kind_of(cast(Ty, t.elem)) != K_STRUCT && kind_of(cast(Ty, t.elem)) != K_DYN)) {
		return cast(Node, say_opt(a, t, prefix))
	} else if k == K_STRUCT || k == K_OPT {
		mut st = t
		if k == K_OPT {
			if kind_of(cast(Ty, t.elem)) == K_DYN {
				return cast(Node, say_opt_dyn(a, t, prefix))
			}
			st = cast(Ty, t.elem)
		}
		return cast(Node, say_struct(a, st, prefix))
	} else if k == K_MAP && key_composite(t.key) != 0 {
		return cast(Node, say_map_keyed(a, t, prefix))
	} else if k == K_MAP {
		return cast(Node, say_map_sorted(a, t, prefix))
	} else if k == K_DYN {
		return cast(Node, say_dyn(a, t))
	} else if k != K_INT && k != K_UINT {
		suffix = "p"
	}
	mut x = a
	if type_width(t) < 8 && k == K_INT {
		x = cast(Node, mk_conv(pos, cast(i64, a), CV_SAME, ty_int))
	}
	return cast(Node, rt_call(pos, prefix + suffix, args1(cast(i64, x)), ty_void))
}

// say_dyn prints a dyn value as its concrete value prints (#569): the last entry of every dyn
// table is the concrete type's formatter (dyn_format_fns), called with the object.
fn say_dyn(a Node, dt Ty) i64 {
	let pos = a.pos
	let held = temp(pos, cast(i64, a), cast(i64, dt))
	let ref = sym_ref_node(pos, cast(Sym, held.sym))
	let object = mk_conv(pos, ref, CV_DYN_OBJECT, ty_int)
	let index = dyn_method_count(dt) + 1
	mut ps = []i64{}
	ps = append(ps, ty_int)
	let ft = func_of_m(cast([]i64, ps), []i64{}, 0, 0)
	let desc = cast(Conv, mk_conv(pos, sym_ref_node(pos, cast(Sym, held.sym)), CV_DYN_DESC, ft))
	desc.dyn_index = index
	let call = node_new(EX_CALL, pos)
	cast(Call, call).name = "format"
	cast(Call, call).args = cast([]i64, args1(object))
	cast(Call, call).callee = cast(i64, desc)
	cast(Call, call).method = 1
	cast(Call, call).dyn_shape = cast(i64, dt)
	cast(Call, call).dyn_index = index
	cast(Node, call).type_ = ty_void
	mut stmts = []i64{}
	stmts = append(stmts, cast(i64, held))
	stmts = append(stmts, expr_stmt(cast(Node, call)))
	return mk_seq(pos, cast(i64, stmts), mk_int(pos, 0, ty_int), ty_void)
}

// say_opt_dyn prints a ?dyn S: <nil>, or the value as say_dyn prints it.
fn say_opt_dyn(a Node, t Ty, prefix str) i64 {
	let pos = a.pos
	let obj = temp(pos, cast(i64, a), cast(i64, t))
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = mk_bin(pos, "==", sym_ref_node(pos, cast(Sym, obj.sym)), mk_int(pos, 0, cast(i64, t)), ty_bool)
	ifs.then = empty_block(pos)
	mut tb = cast(Block, ifs.then).stmts
	tb = append(tb, expr_stmt(cast(Node, rt_call(pos, prefix + "s", args1(lit_string(pos, "<nil>")), ty_void))))
	let els = cast(Block, empty_block(pos))
	mut eb = els.stmts
	eb = append(eb, expr_stmt(cast(Node, say_dyn(cast(Node, mk_conv(pos, sym_ref_node(pos, cast(Sym, obj.sym)), CV_SAME, t.elem)), cast(Ty, t.elem)))))
	els.stmts = eb
	ifs.else_ = cast(i64, els)
	mut stmts = []i64{}
	stmts = append(stmts, cast(i64, obj))
	stmts = append(stmts, cast(i64, ifs))
	return mk_seq(pos, cast(i64, stmts), mk_int(pos, 0, ty_int), ty_void)
}

// say_opt prints an optional str, slice or map: <nil>, or its value as that type prints.
fn say_opt(a Node, t Ty, prefix str) i64 {
	let pos = a.pos
	mut stmts = []i64{}
	mut obj = cast(LetStmt, 0)
	if opt_scalar(t) != 0 || opt_value(t) != 0 {
		// An optional number keeps its two words: nil is tag 0 (#632); ?P its tag and bytes (#669).
		obj = temp(pos, cast(i64, a), cast(i64, t))
	} else {
		obj = temp(pos, mk_conv(pos, cast(i64, a), CV_SAME, ty_int), ty_int)
	}
	stmts = append(stmts, cast(i64, obj))
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = mk_bin(pos, "==", sym_ref_node(pos, cast(Sym, obj.sym)), mk_int(pos, 0, ty_int), ty_bool)
	if opt_value(t) != 0 {
		ifs.cond = mk_bin(pos, "==", opt_tag(pos, sym_ref_node(pos, cast(Sym, obj.sym))), mk_int(pos, 0, ty_int), ty_bool)
	}
	ifs.then = empty_block(pos)
	mut vs1 = cast(Block, ifs.then).stmts
	vs1 = append(vs1, expr_stmt(cast(Node, rt_call(pos, prefix + "argsep", cast(i64, []i64{}), ty_void))))
	mut vs2 = cast(Block, ifs.then).stmts
	vs2 = append(vs2, expr_stmt(cast(Node, rt_call(pos, prefix + "raw", args1(lit_string(pos, "<nil>")), ty_void))))
	mut vs3 = cast(Block, ifs.then).stmts
	vs3 = append(vs3, expr_stmt(cast(Node, rt_call(pos, prefix + "argend", cast(i64, []i64{}), ty_void))))
	ifs.else_ = empty_block(pos)
	mut vs4 = cast(Block, ifs.else_).stmts
	if opt_scalar(t) != 0 {
		vs4 = append(vs4, expr_stmt(say_arg(cast(Node, opt_payload(pos, sym_ref_node(pos, cast(Sym, obj.sym)), opt_scalar(t))), prefix)))
	} else if opt_value(t) != 0 {
		vs4 = append(vs4, expr_stmt(say_arg(cast(Node, opt_payload(pos, sym_ref_node(pos, cast(Sym, obj.sym)), t.elem)), prefix)))
	} else {
		vs4 = append(vs4, expr_stmt(say_arg(cast(Node, mk_conv(pos, sym_ref_node(pos, cast(Sym, obj.sym)), CV_SAME, t.elem)), prefix)))
	}
	stmts = append(stmts, cast(i64, ifs))
	return mk_seq(pos, cast(i64, stmts), mk_int(pos, 0, ty_int), ty_void)
}

// say_struct prints {a b c} by formatting each field in turn (nil optionals print <nil>).
fn say_struct(a Node, t Ty, prefix str) i64 {
	if cast(i64, t.enum_) != 0 {
		return say_enum(a, cast(i64, t), prefix)
	}
	let pos = a.pos
	mut stmts = []i64{}
	let obj = temp(pos, mk_conv(pos, cast(i64, a), CV_SAME, ty_int), ty_int)
	stmts = append(stmts, cast(i64, obj))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, prefix + "argsep", cast(i64, []i64{}), ty_void))))
	let nonnil = cast(IfStmt, node_new(ST_IF, pos))
	nonnil.cond = mk_bin(pos, "==", sym_ref_node(pos, cast(Sym, obj.sym)), mk_int(pos, 0, ty_int), ty_bool)
	nonnil.then = empty_block(pos)
	mut vs1 = cast(Block, nonnil.then).stmts
	vs1 = append(vs1, expr_stmt(cast(Node, rt_call(pos, prefix + "raw", args1(lit_string(pos, "<nil>")), ty_void))))
	let body = cast(Block, empty_block(pos))
	nonnil.else_ = cast(i64, body)
	body.stmts = append(body.stmts, expr_stmt(call_fn(pos, say_struct_fn(t, prefix), args1(mk_conv(pos, sym_ref_node(pos, cast(Sym, obj.sym)), CV_SAME, cast(i64, t))), ty_void)))
	stmts = append(stmts, cast(i64, nonnil))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, prefix + "argend", cast(i64, []i64{}), ty_void))))
	return mk_seq(pos, cast(i64, stmts), mk_int(pos, 0, ty_int), ty_void)
}

shared mut say_struct_keys []i64 // [type, prefix] of each generated struct printer
shared mut say_struct_fns []Fn

// field_name is the declared name of field i of struct type t.
fn field_name(t Ty, i i64) str {
	return cast(Field, t.fields[i]).name
}

// say_struct_fn returns the generated function that prints one (non-nil) struct of type t as
// {v1 v2 ...}, or {name:v1 name:v2 ...} under %+v. It is a function of its own, not inline code, so
// a struct that holds itself through a slice (Node with kids []Node) terminates: the printer is
// registered before its body is built, and the recursion happens when the program runs. A field
// of struct or enum type is printed by the printer of its own type, a slice of structs element by
// element; an optional field (a pointer in effect) stays an address, as Go prints a pointer field.
fn say_struct_fn(t Ty, prefix str) Fn {
	if cast(i64, say_struct_keys) == 0 {
		say_struct_keys = []i64{}
		say_struct_fns = cast([]Fn, []i64{})
	}
	mut i = 0
	for i < len(say_struct_keys) {
		let kp = cast(NameBind, cast([]i64, say_struct_keys)[i])
		if kp.val == cast(i64, t) && kp.name == prefix {
			return say_struct_fns[i]
		}
		i = i + 1
	}
	mut names = []str{}
	names = append(names, "x")
	mut types = []i64{}
	types = append(types, cast(i64, t))
	let f = lifted_fn("say", names, cast([]i64, types), cast(i64, []i64{}))
	let kp2 = name_bind(prefix, cast(i64, t))
	mut vs1 = cast([]i64, say_struct_keys)
	vs1 = append(vs1, kp2)
	say_struct_fns = append(say_struct_fns, cast(Fn, f))
	let saved_fn = ck_fn
	ck_fn = cast(Fn, f)
	let pos = 0
	let x = cast([]i64, f.locals)[0]
	mut body = cast(Block, f.body).stmts
	body = append(body, expr_stmt(cast(Node, rt_call(pos, prefix + "raw", args1(lit_string(pos, "{{")), ty_void))))
	let fs = t.fields
	i = 0
	for i < len(fs) {
		if i > 0 {
			body = append(body, expr_stmt(cast(Node, rt_call(pos, prefix + "raw", args1(lit_string(pos, " ")), ty_void))))
		}
		let named = cast(IfStmt, node_new(ST_IF, pos))
		named.cond = rt_call(pos, "rt_fmt_plusv", cast(i64, []i64{}), ty_bool)
		named.then = empty_block(pos)
		mut vs2 = cast(Block, named.then).stmts
		vs2 = append(vs2, expr_stmt(cast(Node, rt_call(pos, prefix + "raw", args1(lit_string(pos, field_name(t, i) + (":"))), ty_void))))
		body = append(body, cast(i64, named))
		let ft = cast(Ty, field_type(t, i))
		let fv = mk_mem(pos, sym_ref_node(pos, cast(Sym, x)), 0, 0, field_offset(t, i), cast(i64, ft))
		if kind_of(ft) == K_STRUCT && cast(i64, ft.enum_) != 0 {
			body = append(body, expr_stmt(call_fn(pos, say_enum_fn(ft, prefix), args1(fv), ty_void)))
		} else if kind_of(ft) == K_STRUCT {
			body = append(body, expr_stmt(call_fn(pos, say_struct_fn(ft, prefix), args1(fv), ty_void)))
		} else if kind_of(ft) == K_OPT && (opt_scalar(ft) != 0 || opt_value(ft) != 0 || (kind_of(cast(Ty, ft.elem)) != K_STRUCT && kind_of(cast(Ty, ft.elem)) != K_DYN)) {
			body = append(body, expr_stmt(cast(Node, say_opt(cast(Node, fv), ft, prefix))))
		} else if kind_of(ft) == K_OPT {
			body = append(body, expr_stmt(cast(Node, rt_call(pos, prefix + "p", args1(mk_conv(pos, fv, CV_SAME, ty_int)), ty_void))))
		} else {
			body = append(body, expr_stmt(say_arg(cast(Node, fv), prefix)))
		}
		i = i + 1
	}
	body = append(body, expr_stmt(cast(Node, rt_call(pos, prefix + "raw", args1(lit_string(pos, "}}")), ty_void))))
	ck_fn = saved_fn
	return cast(Fn, f)
}

// say_struct_slice prints [{...} {...}] with each element through its struct's printer; a
// slice of slices, maps, faults or optionals prints each element as that type prints (#524).
fn say_struct_slice(a Node, t Ty, prefix str) i64 {
	let pos = a.pos
	let et = t.elem
	mut stmts = []i64{}
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, prefix + "argsep", cast(i64, []i64{}), ty_void))))
	let sl = temp(pos, cast(i64, a), cast(i64, t))
	stmts = append(stmts, cast(i64, sl))
	let n = temp(pos, mk_hdr(pos, sym_ref_node(pos, cast(Sym, sl.sym)), 0), ty_int)
	stmts = append(stmts, cast(i64, n))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, prefix + "raw", args1(lit_string(pos, "[")), ty_void))))
	let j = declare_local(pos, "$", ty_int)
	stmts = append(stmts, let_stmt(pos, cast(Sym, j), mk_int(pos, 0, ty_int)))
	let w = cast(WhileStmt, node_new(ST_WHILE, pos))
	w.cond = mk_bin(pos, "<", sym_ref_node(pos, cast(Sym, j)), sym_ref_node(pos, cast(Sym, n.sym)), ty_bool)
	w.post = assign_stmt(pos, sym_ref_node(pos, cast(Sym, j)), mk_bin(pos, "+", sym_ref_node(pos, cast(Sym, j)), mk_int(pos, 1, ty_int), ty_int))
	let wb = cast(Block, empty_block(pos))
	w.body = cast(i64, wb)
	let sep = cast(IfStmt, node_new(ST_IF, pos))
	sep.cond = mk_bin(pos, ">", sym_ref_node(pos, cast(Sym, j)), mk_int(pos, 0, ty_int), ty_bool)
	sep.then = empty_block(pos)
	mut vs1 = cast(Block, sep.then).stmts
	vs1 = append(vs1, expr_stmt(cast(Node, rt_call(pos, prefix + "raw", args1(lit_string(pos, " ")), ty_void))))
	wb.stmts = append(wb.stmts, cast(i64, sep))
	let el = mk_elem(pos, sym_ref_node(pos, cast(Sym, sl.sym)), sym_ref_node(pos, cast(Sym, j)), et, 0)
	el.safe = 1
	if kind_of(cast(Ty, et)) == K_STRUCT {
		wb.stmts = append(wb.stmts, expr_stmt(call_fn(pos, say_struct_fn(cast(Ty, et), prefix), args1(cast(i64, el)), ty_void)))
	} else {
		wb.stmts = append(wb.stmts, expr_stmt(say_arg(cast(Node, el), prefix)))
	}
	stmts = append(stmts, cast(i64, w))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, prefix + "raw", args1(lit_string(pos, "]")), ty_void))))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, prefix + "argend", cast(i64, []i64{}), ty_void))))
	return mk_seq(pos, cast(i64, stmts), mk_int(pos, 0, ty_int), ty_void)
}

shared mut say_enum_keys []i64 // [type, prefix] of each generated enum printer
shared mut say_enum_fns []Fn

// lifted_fn starts a generated function name$N with params (names, types) and results.
fn lifted_fn(base str, names []str, types []i64, rtypes i64) Fn {
	lifted_count = lifted_count + 1
	let f = fn_new(0, base)
	let nb = buf_new()
	buf_str(nb, base)
	buf_byte(nb, '$')
	buf_int(nb, lifted_count)
	f.qname = str(nb)
	f.name = str(nb)
	f.lifted = 2
	f.locals = cast([]Sym, []i64{})
	mut i = 0
	for i < len(names) {
		f.params = append(f.params, names[i])
		f.ptypes = append(f.ptypes, types[i])
		f.muts = append(f.muts, 0)
		let ps = sym_new(SYM_LOCAL, names[i], 0)
		ps.type_ = types[i]
		ps.slot = i
		mut vs4 = cast([]i64, f.locals)
		vs4 = append(vs4, cast(i64, ps))
		i = i + 1
	}
	f.slots = len(names)
	f.rtypes = cast([]i64, rtypes)
	f.type_ = func_of(f.ptypes, f.rtypes, 0)
	f.body = empty_block(0)
	prog_fns = append(prog_fns, cast(Fn, f))
	return cast(Fn, f)
}

// say_enum prints a variant like Circle(2) or Rect(3 4), and a variant without data as its
// name, through a generated printer per enum (so recursive enums print without expanding
// forever).
fn say_enum(a Node, t i64, prefix str) i64 {
	let pos = a.pos
	mut stmts = []i64{}
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, prefix + "argsep", cast(i64, []i64{}), ty_void))))
	stmts = append(stmts, expr_stmt(call_fn(pos, say_enum_fn(cast(Ty, t), prefix), args1(cast(i64, a)), ty_void)))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, prefix + "argend", cast(i64, []i64{}), ty_void))))
	return mk_seq(pos, cast(i64, stmts), mk_int(pos, 0, ty_int), ty_void)
}

// map_key_kind is the kind rt_map_order sorts a map's key words by: 0 signed integers, 1 str,
// 2 f64, 3 unsigned integers and bool.
fn map_key_kind(kt i64) i64 {
	let k = kind_of(cast(Ty, kt))
	if k == K_STRING {
		return 1
	}
	if k == K_FLOAT {
		return 2
	}
	if k == K_BOOL || is_unsigned_t(cast(Ty, kt)) != 0 {
		return 3
	}
	return 0
}

// say_map_sorted prints a map with str, number or bool keys as map[k:v ...], the entries in the
// order Go prints them (by key), and each key and value through its own static type, so a float
// key reads as a float and a slice or map value prints its elements.
fn say_map_sorted(a Node, t Ty, prefix str) i64 {
	let pos = a.pos
	let kt = t.key
	mut stmts = []i64{}
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, prefix + "argsep", cast(i64, []i64{}), ty_void))))
	let m = temp(pos, cast(i64, a), cast(i64, t))
	stmts = append(stmts, cast(i64, m))
	let ord = temp(pos, rt_call(pos, "rt_map_order", args2(sym_ref_node(pos, cast(Sym, m.sym)), mk_int(pos, map_key_kind(kt), ty_int)), ty_int), ty_int)
	stmts = append(stmts, cast(i64, ord))
	let n = temp(pos, rt_call(pos, "rt_map_len", args1(sym_ref_node(pos, cast(Sym, m.sym))), ty_int), ty_int)
	stmts = append(stmts, cast(i64, n))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, prefix + "raw", args1(lit_string(pos, "map[")), ty_void))))
	let j = declare_local(pos, "$", ty_int)
	stmts = append(stmts, let_stmt(pos, cast(Sym, j), mk_int(pos, 0, ty_int)))
	let w = cast(WhileStmt, node_new(ST_WHILE, pos))
	w.cond = mk_bin(pos, "<", sym_ref_node(pos, cast(Sym, j)), sym_ref_node(pos, cast(Sym, n.sym)), ty_bool)
	w.post = assign_stmt(pos, sym_ref_node(pos, cast(Sym, j)), mk_bin(pos, "+", sym_ref_node(pos, cast(Sym, j)), mk_int(pos, 1, ty_int), ty_int))
	let wb = cast(Block, empty_block(pos))
	w.body = cast(i64, wb)
	let sep = cast(IfStmt, node_new(ST_IF, pos))
	sep.cond = mk_bin(pos, ">", sym_ref_node(pos, cast(Sym, j)), mk_int(pos, 0, ty_int), ty_bool)
	sep.then = empty_block(pos)
	mut vs1 = cast(Block, sep.then).stmts
	vs1 = append(vs1, expr_stmt(cast(Node, rt_call(pos, prefix + "raw", args1(lit_string(pos, " ")), ty_void))))
	wb.stmts = append(wb.stmts, cast(i64, sep))
	let slot = temp(pos, rt_call(pos, "rt_order_at", args2(sym_ref_node(pos, cast(Sym, ord.sym)), sym_ref_node(pos, cast(Sym, j))), ty_int), ty_int)
	wb.stmts = append(wb.stmts, cast(i64, slot))
	let kv = from_bits(cast(Node, rt_call(pos, "rt_map_key", args2(sym_ref_node(pos, cast(Sym, m.sym)), sym_ref_node(pos, cast(Sym, slot.sym))), ty_int)), kt)
	wb.stmts = append(wb.stmts, expr_stmt(say_arg(cast(Node, kv), prefix)))
	wb.stmts = append(wb.stmts, expr_stmt(cast(Node, rt_call(pos, prefix + "raw", args1(lit_string(pos, ":")), ty_void))))
	let vv = map_val(pos, sym_ref_node(pos, cast(Sym, m.sym)), sym_ref_node(pos, cast(Sym, slot.sym)), t.elem)
	wb.stmts = append(wb.stmts, expr_stmt(say_arg(cast(Node, vv), prefix)))
	stmts = append(stmts, cast(i64, w))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, prefix + "raw", args1(lit_string(pos, "]")), ty_void))))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, prefix + "argend", cast(i64, []i64{}), ty_void))))
	return mk_seq(pos, cast(i64, stmts), mk_int(pos, 0, ty_int), ty_void)
}

// say_map_keyed prints a map with struct or enum keys as map[k:v ...] in insertion order.
fn say_map_keyed(a Node, t Ty, prefix str) i64 {
	let pos = a.pos
	mut stmts = []i64{}
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, prefix + "argsep", cast(i64, []i64{}), ty_void))))
	let m = temp(pos, cast(i64, a), cast(i64, t))
	stmts = append(stmts, cast(i64, m))
	let n = temp(pos, rt_call(pos, "rt_map_slots", args1(sym_ref_node(pos, cast(Sym, m.sym))), ty_int), ty_int)
	stmts = append(stmts, cast(i64, n))
	let first = declare_local(pos, "$", ty_bool)
	stmts = append(stmts, let_stmt(pos, cast(Sym, first), mk_int(pos, 1, ty_bool)))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, prefix + "raw", args1(lit_string(pos, "map[")), ty_void))))
	let j = declare_local(pos, "$", ty_int)
	stmts = append(stmts, let_stmt(pos, cast(Sym, j), mk_int(pos, 0, ty_int)))
	let w = cast(WhileStmt, node_new(ST_WHILE, pos))
	w.cond = mk_bin(pos, "<", sym_ref_node(pos, cast(Sym, j)), sym_ref_node(pos, cast(Sym, n.sym)), ty_bool)
	w.post = assign_stmt(pos, sym_ref_node(pos, cast(Sym, j)), mk_bin(pos, "+", sym_ref_node(pos, cast(Sym, j)), mk_int(pos, 1, ty_int), ty_int))
	let wb = cast(Block, empty_block(pos))
	w.body = cast(i64, wb)
	let live = cast(IfStmt, node_new(ST_IF, pos))
	live.cond = rt_call(pos, "rt_map_live", args2(sym_ref_node(pos, cast(Sym, m.sym)), sym_ref_node(pos, cast(Sym, j))), ty_bool)
	live.then = empty_block(pos)
	mut lb = cast(Block, live.then).stmts
	let sep = cast(IfStmt, node_new(ST_IF, pos))
	sep.cond = mk_unot(pos, sym_ref_node(pos, cast(Sym, first)))
	sep.then = empty_block(pos)
	mut vs1 = cast(Block, sep.then).stmts
	vs1 = append(vs1, expr_stmt(cast(Node, rt_call(pos, prefix + "raw", args1(lit_string(pos, " ")), ty_void))))
	lb = append(lb, cast(i64, sep))
	lb = append(lb, assign_stmt(pos, sym_ref_node(pos, cast(Sym, first)), mk_int(pos, 0, ty_bool)))
	let kt = t.key
	let kv = key_out(cast(Node, rt_call(pos, "rt_map_key", args2(sym_ref_node(pos, cast(Sym, m.sym)), sym_ref_node(pos, cast(Sym, j))), ty_int)), kt)
	if cast(i64, cast(Ty, kt).enum_) != 0 {
		lb = append(lb, expr_stmt(call_fn(pos, say_enum_fn(cast(Ty, kt), prefix), args1(kv), ty_void)))
	} else {
		lb = append(lb, expr_stmt(cast(Node, say_struct(cast(Node, kv), cast(Ty, kt), prefix))))
	}
	lb = append(lb, expr_stmt(cast(Node, rt_call(pos, prefix + "raw", args1(lit_string(pos, ":")), ty_void))))
	let vv = map_val(pos, sym_ref_node(pos, cast(Sym, m.sym)), sym_ref_node(pos, cast(Sym, j)), t.elem)
	lb = append(lb, expr_stmt(say_arg(cast(Node, vv), prefix)))
	wb.stmts = append(wb.stmts, cast(i64, live))
	stmts = append(stmts, cast(i64, w))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, prefix + "raw", args1(lit_string(pos, "]")), ty_void))))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, prefix + "argend", cast(i64, []i64{}), ty_void))))
	return mk_seq(pos, cast(i64, stmts), mk_int(pos, 0, ty_int), ty_void)
}

// say_enum_slice prints [A B C] with each element through its enum's printer.
fn say_enum_slice(a Node, t Ty, prefix str) i64 {
	let pos = a.pos
	let et = t.elem
	mut stmts = []i64{}
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, prefix + "argsep", cast(i64, []i64{}), ty_void))))
	let sl = temp(pos, cast(i64, a), cast(i64, t))
	stmts = append(stmts, cast(i64, sl))
	let n = temp(pos, mk_hdr(pos, sym_ref_node(pos, cast(Sym, sl.sym)), 0), ty_int)
	stmts = append(stmts, cast(i64, n))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, prefix + "raw", args1(lit_string(pos, "[")), ty_void))))
	let j = declare_local(pos, "$", ty_int)
	stmts = append(stmts, let_stmt(pos, cast(Sym, j), mk_int(pos, 0, ty_int)))
	let w = cast(WhileStmt, node_new(ST_WHILE, pos))
	w.cond = mk_bin(pos, "<", sym_ref_node(pos, cast(Sym, j)), sym_ref_node(pos, cast(Sym, n.sym)), ty_bool)
	w.post = assign_stmt(pos, sym_ref_node(pos, cast(Sym, j)), mk_bin(pos, "+", sym_ref_node(pos, cast(Sym, j)), mk_int(pos, 1, ty_int), ty_int))
	let wb = cast(Block, empty_block(pos))
	w.body = cast(i64, wb)
	let sep = cast(IfStmt, node_new(ST_IF, pos))
	sep.cond = mk_bin(pos, ">", sym_ref_node(pos, cast(Sym, j)), mk_int(pos, 0, ty_int), ty_bool)
	sep.then = empty_block(pos)
	mut vs1 = cast(Block, sep.then).stmts
	vs1 = append(vs1, expr_stmt(cast(Node, rt_call(pos, prefix + "raw", args1(lit_string(pos, " ")), ty_void))))
	wb.stmts = append(wb.stmts, cast(i64, sep))
	let el = mk_elem(pos, sym_ref_node(pos, cast(Sym, sl.sym)), sym_ref_node(pos, cast(Sym, j)), et, 0)
	el.safe = 1
	wb.stmts = append(wb.stmts, expr_stmt(call_fn(pos, say_enum_fn(cast(Ty, et), prefix), args1(cast(i64, el)), ty_void)))
	stmts = append(stmts, cast(i64, w))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, prefix + "raw", args1(lit_string(pos, "]")), ty_void))))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, prefix + "argend", cast(i64, []i64{}), ty_void))))
	return mk_seq(pos, cast(i64, stmts), mk_int(pos, 0, ty_int), ty_void)
}

// say_optnum_slice prints [1 <nil> 3] for a slice of optional numbers or bools (#353).
fn say_optnum_slice(a Node, t Ty, prefix str) i64 {
	let pos = a.pos
	let et = t.elem
	mut stmts = []i64{}
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, prefix + "argsep", cast(i64, []i64{}), ty_void))))
	let sl = temp(pos, cast(i64, a), cast(i64, t))
	stmts = append(stmts, cast(i64, sl))
	let n = temp(pos, mk_hdr(pos, sym_ref_node(pos, cast(Sym, sl.sym)), 0), ty_int)
	stmts = append(stmts, cast(i64, n))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, prefix + "raw", args1(lit_string(pos, "[")), ty_void))))
	let j = declare_local(pos, "$", ty_int)
	stmts = append(stmts, let_stmt(pos, cast(Sym, j), mk_int(pos, 0, ty_int)))
	let w = cast(WhileStmt, node_new(ST_WHILE, pos))
	w.cond = mk_bin(pos, "<", sym_ref_node(pos, cast(Sym, j)), sym_ref_node(pos, cast(Sym, n.sym)), ty_bool)
	w.post = assign_stmt(pos, sym_ref_node(pos, cast(Sym, j)), mk_bin(pos, "+", sym_ref_node(pos, cast(Sym, j)), mk_int(pos, 1, ty_int), ty_int))
	let wb = cast(Block, empty_block(pos))
	w.body = cast(i64, wb)
	let sep = cast(IfStmt, node_new(ST_IF, pos))
	sep.cond = mk_bin(pos, ">", sym_ref_node(pos, cast(Sym, j)), mk_int(pos, 0, ty_int), ty_bool)
	sep.then = empty_block(pos)
	mut vp4 = cast(Block, sep.then).stmts
	vp4 = append(vp4, expr_stmt(cast(Node, rt_call(pos, prefix + "raw", args1(lit_string(pos, " ")), ty_void))))
	mut vp5 = cast([]i64, wb.stmts)
	vp5 = append(vp5, cast(i64, sep))
	let el = mk_elem(pos, sym_ref_node(pos, cast(Sym, sl.sym)), sym_ref_node(pos, cast(Sym, j)), et, 0)
	el.safe = 1
	mut vp6 = cast([]i64, wb.stmts)
	vp6 = append(vp6, expr_stmt(call_fn(pos, say_optnum_fn(cast(Ty, et), prefix), args1(cast(i64, el)), ty_void)))
	stmts = append(stmts, cast(i64, w))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, prefix + "raw", args1(lit_string(pos, "]")), ty_void))))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, prefix + "argend", cast(i64, []i64{}), ty_void))))
	return mk_seq(pos, cast(i64, stmts), mk_int(pos, 0, ty_int), ty_void)
}

shared mut say_optnum_keys []i64
shared mut say_optnum_fns []Fn

// say_optnum_fn is say$N(x ?number) prints the number or <nil>, inside a longer line.
fn say_optnum_fn(t Ty, prefix str) Fn {
	if cast(i64, say_optnum_keys) == 0 {
		say_optnum_keys = []i64{}
		say_optnum_fns = cast([]Fn, []i64{})
	}
	mut i = 0
	for i < len(say_optnum_keys) {
		let kp = cast(NameBind, (cast([]i64, say_optnum_keys))[i])
		if kp.val == cast(i64, t) && kp.name == prefix {
			return say_optnum_fns[i]
		}
		i = i + 1
	}
	mut names = []str{}
	names = append(names, "x")
	mut types = []i64{}
	types = append(types, cast(i64, t))
	let f = lifted_fn("say", names, cast([]i64, types), cast(i64, []i64{}))
	let kp2 = name_bind(prefix, cast(i64, t))
	mut vp7 = cast([]i64, say_optnum_keys)
	vp7 = append(vp7, kp2)
	say_optnum_fns = append(say_optnum_fns, cast(Fn, f))
	let saved_fn = ck_fn
	ck_fn = cast(Fn, f)
	let pos = 0
	let x = (cast([]i64, f.locals))[0]
	mut body = cast(Block, f.body).stmts
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = mk_bin(pos, "==", sym_ref_node(pos, cast(Sym, x)), mk_int(pos, 0, cast(i64, t)), ty_bool)
	ifs.then = empty_block(pos)
	mut vp8 = cast(Block, ifs.then).stmts
	vp8 = append(vp8, expr_stmt(cast(Node, rt_call(pos, prefix + "raw", args1(lit_string(pos, "<nil>")), ty_void))))
	ifs.else_ = empty_block(pos)
	mut vp9 = cast(Block, ifs.else_).stmts
	vp9 = append(vp9, expr_stmt(say_arg(cast(Node, opt_payload(pos, sym_ref_node(pos, cast(Sym, x)), opt_scalar(t))), prefix)))
	body = append(body, cast(i64, ifs))
	ck_fn = saved_fn
	return cast(Fn, f)
}

fn say_enum_fn(t Ty, prefix str) Fn {
	if cast(i64, say_enum_keys) == 0 {
		say_enum_keys = []i64{}
		say_enum_fns = cast([]Fn, []i64{})
	}
	mut i = 0
	for i < len(say_enum_keys) {
		let kp = cast(NameBind, cast([]i64, say_enum_keys)[i])
		if kp.val == cast(i64, t) && kp.name == prefix {
			return say_enum_fns[i]
		}
		i = i + 1
	}
	mut names = []str{}
	names = append(names, "x")
	mut types = []i64{}
	types = append(types, cast(i64, t))
	let f = lifted_fn("say", names, cast([]i64, types), cast(i64, []i64{}))
	let kp2 = name_bind(prefix, cast(i64, t))
	mut vs1 = cast([]i64, say_enum_keys)
	vs1 = append(vs1, kp2)
	say_enum_fns = append(say_enum_fns, cast(Fn, f))
	let saved_fn = ck_fn
	ck_fn = cast(Fn, f)
	let pos = 0
	let x = cast([]i64, f.locals)[0]
	mut body = cast(Block, f.body).stmts
	let vs = t.enum_
	mut vi = 0
	for vi < len(vs) {
		let v = vs[vi]
		let ifs = cast(IfStmt, node_new(ST_IF, pos))
		ifs.cond = mk_bin(pos, "==", mk_mem(pos, sym_ref_node(pos, cast(Sym, x)), 0, 0, field_offset(t, 0), ty_int), mk_int(pos, vi, ty_int), ty_bool)
		ifs.then = empty_block(pos)
		mut b = cast(Block, ifs.then).stmts
		b = append(b, expr_stmt(cast(Node, rt_call(pos, prefix + "raw", args1(lit_string(pos, v.name)), ty_void))))
		let nf = v.count
		if nf > 0 {
			b = append(b, expr_stmt(cast(Node, rt_call(pos, prefix + "raw", args1(lit_string(pos, "(")), ty_void))))
			mut k = 0
			for k < nf {
				if k > 0 {
					b = append(b, expr_stmt(cast(Node, rt_call(pos, prefix + "raw", args1(lit_string(pos, " ")), ty_void))))
				}
				let fi = v.first + k
				let ft = cast(Ty, field_type(t, fi))
				let fv = mk_mem(pos, sym_ref_node(pos, cast(Sym, x)), 0, 0, field_offset(t, fi), cast(i64, ft))
				if kind_of(ft) == K_STRUCT && cast(i64, ft.enum_) != 0 {
					b = append(b, expr_stmt(call_fn(pos, say_enum_fn(ft, prefix), args1(fv), ty_void)))
				} else {
					b = append(b, expr_stmt(say_arg(cast(Node, fv), prefix)))
				}
				k = k + 1
			}
			b = append(b, expr_stmt(cast(Node, rt_call(pos, prefix + "raw", args1(lit_string(pos, ")")), ty_void))))
		}
		body = append(body, cast(i64, ifs))
		vi = vi + 1
	}
	ck_fn = saved_fn
	return cast(Fn, f)
}

fn lit_string(pos i64, s str) i64 {
	let n = node_new(EX_STR, pos)
	cast(StrLit, n).ptr = s
	cast(StrLit, n).len = len(s)
	cast(Node, n).type_ = ty_string
	return n
}

shared mut say_temps i64 // hidden locals say_hoist has made, for their names

// say_hoist evaluates the arguments from first on that are more than a literal or a name into
// hidden locals before the formatting frame opens: the frame is the core's, so a call that
// runs other tasks (anvil.Serve in say.Line) must not run while it is open (#347).
fn say_hoist(pos i64, args []Node, first i64, stmts []i64) i64 {
	mut i = first
	for i < len(args) {
		let a = args[i]
		let k = a.kind
		if k != EX_INT && k != EX_STR && k != EX_IDENT && k != EX_FLOAT && k != EX_NIL {
			let t = default_type(chk(a, 0))
			let tk = kind_of(cast(Ty, t))
			if tk != K_VOID && tk != K_TUPLE {
				if is_untyped(a.type_) != 0 {
					reconvert(a, t)
				}
				// a name of its own: the lifetime checks tell hidden locals apart by name
				say_temps = say_temps + 1
				let nb = buf_new()
				buf_str(nb, "$say")
				buf_int(nb, say_temps)
				let s = declare_local(a.pos, str(nb), t)
				stmts = append(stmts, let_stmt(a.pos, cast(Sym, s), cast(i64, a)))
				args[i] = cast(Node, sym_ref_node(a.pos, cast(Sym, s)))
			}
		}
		i = i + 1
	}
	return 0
}

// say_text formats args like say.Str (Line spacing when ln) and returns the str.
fn say_text(pos i64, args []Node, ln i64) i64 {
	mut stmts = []i64{}
	say_hoist(pos, args, 0, cast([]i64, stmts))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, "rt_fmt_begin_v", args1(mk_int(pos, ln, ty_int)), ty_void))))
	mut i = 0
	for i < len(args) {
		stmts = append(stmts, expr_stmt(say_arg(args[i], "rt_fmt_")))
		i = i + 1
	}
	return mk_seq(pos, cast(i64, stmts), rt_call(pos, "rt_fmt_end", cast(i64, []i64{}), ty_string), ty_string)
}

// lower_say compiles say calls into typed runtime calls: begin, one call per argument,
// then end. No interfaces or reflection are needed.
//   say.Line(a...)        print, spaces between, newline
//   say.Text(a...)        print, Go's Print spacing
//   say.Out(f, a...)      printf
//   say.Fmt(f, a...) str  sprintf
//   say.Str(a...) str     sprint
//   say.Fault(f, a...)    a fault with a formatted message
//   say.To(w, f, a...)    printf into w.Write(str)
//   say.LineTo(w, a...)   println into w.Write(str)
// chk_interp turns "a {x} b {y:.2}" into say.Fmt("a %v b %.2f", x, y): the verb comes from
// the spec (its last letter), else %v, or %f for a float with a precision.
// is_query_t reports whether t is the runtime's query type.
fn is_query_t(t Ty) i64 {
	return i64(cast(i64, t) != 0 && t.kind == K_STRUCT && len(t.name) != 0 && t.name == "query")
}

fn tx_named(pos i64, name str) i64 {
	let n = cast(TypeName, node_new(TX_NAME, pos))
	n.name = name
	return cast(i64, n)
}

fn tx_slice_of(pos i64, name str) i64 {
	let n = cast(TypeExpr, node_new(TX_SLICE, pos))
	n.a = tx_named(pos, name)
	return cast(i64, n)
}

fn ident_node(pos i64, name str) i64 {
	let n = cast(IdentExpr, node_new(EX_IDENT, pos))
	n.name = name
	return cast(i64, n)
}

fn composite_of(tyx Node, elems i64, keys i64) i64 {
	let c = cast(Composite, node_new(EX_COMPOSITE, tyx.pos))
	c.type_ = cast(i64, tyx)
	c.elems = cast([]i64, elems)
	c.keys = cast([]i64, keys)
	return cast(i64, c)
}

// query_arg wraps a checked value in the qarg variant for its type: integers become
// Int(i64(x)), floats Float(f64(x)), then Str, Bool and Bytes ([]u8).
fn query_arg(a Node, t Ty) i64 {
	let pos = a.pos
	mut variant = ""
	mut conv = ""
	if is_integer_t(cast(i64, t)) != 0 {
		variant = "Int"
		if cast(i64, t) != ty_int {
			conv = "i64"
		}
	} else if is_float_t(cast(i64, t)) != 0 {
		variant = "Float"
		if cast(i64, t) != ty_float {
			conv = "f64"
		}
	} else if kind_of(t) == K_STRING {
		variant = "Str"
	} else if kind_of(t) == K_BOOL || kind_of(t) == K_UBOOL {
		variant = "Bool"
	} else if kind_of(t) == K_SLICE && t.elem == ty_byte {
		variant = "Bytes"
	} else {
		err_code_type(pos, "E280 QUERY", "a query value must be an integer, a float, a str, a bool or []u8, not ", cast(i64, t), "")
		return 0
	}
	mut v = cast(Call, a)
	if len(conv) != 0 {
		v = cast(Call, node_new(EX_CALL, pos))
		v.name = conv
		v.args = cast([]i64, args1(cast(i64, a)))
	}
	let sel = cast(SelectExpr, node_new(EX_SELECT, pos))
	sel.x = ident_node(pos, "qarg")
	sel.name = variant
	let call = cast(Call, node_new(EX_CALL, pos))
	call.callee = cast(i64, sel)
	call.args = cast([]i64, args1(cast(i64, v)))
	return cast(i64, call)
}

// chk_query turns a literal where a query is wanted into query{Parts, Args}: "GET user:{id}"
// keeps "GET user:" and "" as text and id as a value, so a value is never parsed as text.
fn chk_query(e i64, want i64) i64 {
	let pos = cast(Node, e).pos
	mut parts = []i64{}
	mut args = []i64{}
	mut hidden = 0
	if cast(Node, e).kind == EX_STR {
		let s = cast(StrLit, node_new(EX_STR, pos))
		s.ptr = cast(StrLit, e).ptr
		s.len = cast(StrLit, e).len
		parts = append(parts, cast(i64, s))
	} else {
		parts = cast(InterpExpr, e).parts
		let vals = cast(InterpExpr, e).args
		let specs = cast(InterpExpr, e).specs
		mut i = 0
		for i < len(vals) {
			if specs[i] != nil {
				err_code_at(pos, "E280 QUERY", "a query value takes no format spec: it is sent as it is")
			}
			let a = cast(Node, vals[i])
			mut at = chk(cast(Node, a), 0)
			if is_secret(cast(Ty, at)) != 0 {
				// Sent as itself; a replay key holds its handle instead (query.Hidden, #241).
				hidden = hidden | secret_query_arg(cast(Node, a), at, len(cast([]i64, args)))
				at = cast(i64, plain_type(cast(Ty, at)))
				a.type_ = at
			}
			let qa = query_arg(cast(Node, a), cast(Ty, at))
			if qa != 0 {
				args = append(args, qa)
			}
			i = i + 1
		}
	}
	mut nokeys = []i64{}
	mut i = 0
	for i < len(cast([]i64, parts)) {
		nokeys = append(nokeys, 0)
		i = i + 1
	}
	mut akeys = []i64{}
	i = 0
	for i < len(cast([]i64, args)) {
		akeys = append(akeys, 0)
		i = i + 1
	}
	mut elems = []i64{}
	elems = append(elems, composite_of(cast(Node, tx_slice_of(pos, "str")), cast(i64, parts), cast(i64, nokeys)))
	elems = append(elems, composite_of(cast(Node, tx_slice_of(pos, "qarg")), cast(i64, args), cast(i64, akeys)))
	mut keys = []i64{}
	keys = append(keys, ident_node(pos, "Parts"))
	keys = append(keys, ident_node(pos, "Args"))
	if hidden != 0 {
		elems = append(elems, mk_int(pos, hidden, ty_u64))
		keys = append(keys, ident_node(pos, "Hidden"))
	}
	let c = composite_of(cast(Node, tx_named(pos, "query")), cast(i64, elems), cast(i64, keys))
	replace_node(e, c)
	cast(Node, e).type_ = 0
	return chk_kind(e, want)
}

// interp_name_known reports whether a name inside {...} in a string resolves: chk_ident
// would not report it undefined.
fn interp_name_known(name str) i64 {
	return i64(name == "true" || name == "false" || cast(i64, lookup_name(name)) != 0 || len(import_pkg(name)) != 0)
}

fn chk_interp(e i64, want i64) i64 {
	let pos = cast(Node, e).pos
	let parts = cast(InterpExpr, e).parts
	let vals = cast(InterpExpr, e).args
	let specs = cast(InterpExpr, e).specs
	let f = buf_new()
	mut args = []i64{}
	args = append(args, 0)
	mut i = 0
	for i < len(parts) {
		let part = cast(StrLit, parts[i])
		mut k = 0
		for k < part.len {
			let c = i64(cast(StrLit, part).ptr[k])
			if c == '%' {
				buf_byte(f, '%')
			}
			buf_byte(f, c)
			k = k + 1
		}
		if i < len(vals) {
			let a = vals[i]
			if cast(Node, a).kind == EX_IDENT && interp_name_known(cast(IdentExpr, a).name) == 0 {
				// Often meant as literal text, like a route pattern's {id}.
				let u = err_code(cast(Node, a).pos, "E103 UNDEFINED")
				buf_str(u, "undefined: ")
				buf_str(u, cast(IdentExpr, a).name)
				buf_str(u, " (in a string, {{")
				buf_str(u, cast(IdentExpr, a).name)
				buf_str(u, "}} is a value: write {{{{ for a brace, or use a `raw` string)")
				err_end(cast([]u8, u))
				replace_node(a, mk_int(cast(Node, a).pos, 0, 0))
			}
			let t = chk(cast(Node, a), 0)
			buf_byte(f, '%')
			if let spec = specs[i] {
				interp_spec_check(cast(Node, a).pos, spec, t)
				buf_str(f, spec)
				let sl = len(spec)
				mut last = 0
				if sl > 0 {
					last = i64(spec[sl - 1])
				}
				if !((last >= 'a' && last <= 'z') || (last >= 'A' && last <= 'Z')) {
					mut dot = 0
					mut q = 0
					for q < sl {
						if i64(spec[q]) == '.' {
							dot = 1
						}
						q = q + 1
					}
					if dot != 0 && is_float_t(t) != 0 {
						buf_byte(f, 'f')
					} else {
						buf_byte(f, 'v')
					}
				}
			} else {
				buf_byte(f, 'v')
			}
			args = append(args, a)
		}
		i = i + 1
	}
	let fs = cast(StrLit, node_new(EX_STR, pos))
	fs.len = len(f)
	fs.ptr = str(f)
	interp_format = cast(i64, fs)
	cast([]i64, args)[0] = cast(i64, fs)
	let call = cast(Call, node_new(EX_CALL, pos))
	call.args = cast([]i64, args)
	replace_node(e, cast(i64, call))
	cast(Node, e).type_ = 0
	return secret_interp_result(e, cast([]Node, cast([]i64, args)), want)
}

shared mut interp_format i64 // the format chk_interp built: its specs were checked there (#529)

// fmt_verbs are the verbs say's printf knows (LANGUAGE.md §16).
const fmt_verbs = "vdbcoOqxXUeEfFgGstp"

// fmt_verb_fits reports whether verb can format a value of type t, as go vet's printf check
// decides for Go's types (#529): integers take d b c o O q x X U, floats b e E f F g G x X, strs
// and faults s q x X, bools t, and %v anything. A slice, map or optional takes what its elements
// take (and %p); structs, enums, functions and dyn values print through their own printers.
fn fmt_verb_fits(verb i64, t Ty) i64 {
	if verb == 'v' || cast(i64, t) == 0 {
		return 1
	}
	let k = kind_of(t)
	if k == K_INT || k == K_UINT || k == K_BYTE {
		return i64(byte_index("dbcoOqxXU", verb) >= 0)
	}
	if k == K_FLOAT || k == K_UFLOAT {
		return i64(byte_index("beEfFgGxX", verb) >= 0)
	}
	if k == K_STRING || k == K_ERROR {
		return i64(byte_index("sqxX", verb) >= 0)
	}
	if k == K_BOOL || k == K_UBOOL {
		return i64(verb == 't')
	}
	if k == K_SLICE || k == K_OPT {
		return i64(verb == 'p' || fmt_verb_fits(verb, cast(Ty, t.elem)) != 0)
	}
	if k == K_MAP {
		return i64(verb == 'p' || (fmt_verb_fits(verb, cast(Ty, t.key)) != 0 && fmt_verb_fits(verb, cast(Ty, t.elem)) != 0))
	}
	return 1
}

fn byte_index(s str, c i64) i64 {
	mut i = 0
	for i < len(s) {
		if i64(s[i]) == c {
			return i
		}
		i = i + 1
	}
	return -1
}

// interp_spec_check reports a {value:spec} whose spec is not [flags][width][.precision][verb]
// with a verb that formats the value's type (#529).
fn interp_spec_check(pos i64, spec str, t i64) {
	let n = len(spec)
	mut i = 0
	for i < n && byte_index("-+0# ", i64(spec[i])) >= 0 {
		i = i + 1
	}
	for i < n && spec[i] >= '0' && spec[i] <= '9' {
		i = i + 1
	}
	if i < n && spec[i] == '.' {
		i = i + 1
		for i < n && spec[i] >= '0' && spec[i] <= '9' {
			i = i + 1
		}
	}
	mut verb = 0
	if i < n {
		verb = i64(spec[i])
		i = i + 1
	}
	if i < n || (verb != 0 && byte_index(fmt_verbs, verb) < 0) {
		let m = err_code(pos, "E282 FORMAT")
		buf_str(m, "bad format spec {{...:")
		buf_str(m, spec)
		buf_str(m, "}}: a spec is [flags][width][.precision][verb], flags from - + 0 # and space, a verb from ")
		buf_str(m, fmt_verbs)
		err_end(cast([]u8, m))
		return
	}
	if verb != 0 && fmt_verb_fits(verb, cast(Ty, default_type(t))) == 0 {
		let m = err_code(pos, "E282 FORMAT")
		buf_str(m, "{{...:")
		buf_str(m, spec)
		buf_str(m, "}}: verb %")
		buf_byte(m, verb)
		buf_str(m, " cannot format a value of type ")
		type_name(cast([]u8, m), cast(Ty, default_type(t)))
		buf_str(m, " (%v formats any value)")
		err_end(cast([]u8, m))
	}
}

fn fmt_verb_mismatch(pos i64, verb i64, t i64) {
	let m = err_code(pos, "E282 FORMAT")
	buf_str(m, "verb %")
	buf_byte(m, verb)
	buf_str(m, " cannot format a value of type ")
	type_name(cast([]u8, m), cast(Ty, default_type(t)))
	buf_str(m, " (%v formats any value)")
	err_end(cast([]u8, m))
}

// fmt_check_format checks a printf format written as a literal against the values after it, as
// go vet does (#529): each verb is known and formats its value's type, and every verb has a
// value and every value a verb. types[i] is the type of value i; poss[i] its position.
fn fmt_check_format(fpos i64, format str, types []i64, poss []i64) {
	let n = len(format)
	mut i = 0
	mut arg = 0
	for i < n {
		if format[i] != '%' {
			i = i + 1
			continue
		}
		if i + 1 < n && format[i + 1] == '%' {
			i = i + 2
			continue
		}
		i = i + 1
		for i < n && byte_index("-+0# ", i64(format[i])) >= 0 {
			i = i + 1
		}
		for i < n && format[i] >= '0' && format[i] <= '9' {
			i = i + 1
		}
		if i < n && format[i] == '.' {
			i = i + 1
			for i < n && format[i] >= '0' && format[i] <= '9' {
				i = i + 1
			}
		}
		if i >= n {
			err_code_at(fpos, "E282 FORMAT", "the format ends in the middle of a verb: write %% for a percent sign")
			return
		}
		let verb = i64(format[i])
		i = i + 1
		if !((verb >= 'a' && verb <= 'z') || (verb >= 'A' && verb <= 'Z')) {
			err_code_at(fpos, "E282 FORMAT", "a % in the format starts a verb (like %d or %v): write %% for a percent sign")
			return
		}
		if byte_index(fmt_verbs, verb) < 0 {
			let m = err_code(fpos, "E282 FORMAT")
			buf_str(m, "unknown verb %")
			buf_byte(m, verb)
			buf_str(m, " in the format: the verbs are ")
			buf_str(m, fmt_verbs)
			buf_str(m, ", and %% is a percent sign")
			err_end(cast([]u8, m))
			return
		}
		if arg >= len(types) {
			let m = err_code(fpos, "E282 FORMAT")
			buf_str(m, "verb %")
			buf_byte(m, verb)
			buf_str(m, " has no value: the format has more verbs than the ")
			buf_int(m, len(types))
			buf_str(m, " values after it")
			err_end(cast([]u8, m))
			return
		}
		if fmt_verb_fits(verb, cast(Ty, default_type(types[arg]))) == 0 {
			fmt_verb_mismatch(poss[arg], verb, types[arg])
		}
		arg = arg + 1
	}
	if arg < len(types) {
		let m = err_code(poss[arg], "E282 FORMAT")
		buf_str(m, "this value has no verb in the format: ")
		buf_int(m, len(types))
		buf_str(m, " values for ")
		buf_int(m, arg)
		buf_str(m, " verbs")
		err_end(cast([]u8, m))
	}
}

fn lower_say(e i64, m str, want i64) i64 {
	let pos = cast(Node, e).pos
	let args = cast(Call, e).args
	mut first = 0
	mut writer = 0
	if m == "To" || m == "LineTo" {
		writer = arg0(cast(Call, e))
		first = 1
	}
	let printf = i64(m == "Out" || m == "Fmt" || m == "Fault" || m == "To")
	let ln = i64(m == "Line" || m == "LineTo")
	mut stmts = []i64{}
	secret_say_args(cast([]Node, args), m)
	if printf != 0 {
		say_hoist(pos, cast([]Node, args), first + 1, cast([]i64, stmts))
	} else {
		say_hoist(pos, cast([]Node, args), first, cast([]i64, stmts))
	}
	if printf != 0 {
		if len(args) <= first {
			err_code_at(pos, "E282 FORMAT", "missing format")
			return ty_void
		}
		let f = cast(Node, args[first])
		let ft = chk(cast(Node, f), ty_string)
		if kind_of(cast(Ty, ft)) != K_STRING {
			err_code_at(f.pos, "E282 FORMAT", "format must be a str")
		}
		stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, "rt_fmt_begin", args1(cast(i64, f)), ty_void))))
		first = first + 1
	} else {
		stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, "rt_fmt_begin_v", args1(mk_int(pos, ln, ty_int)), ty_void))))
	}
	mut types = []i64{}
	mut poss = []i64{}
	mut i = first
	for i < len(args) {
		stmts = append(stmts, expr_stmt(say_arg(cast(Node, args[i]), "rt_fmt_")))
		types = append(types, cast(Node, args[i]).type_)
		poss = append(poss, cast(Node, args[i]).pos)
		i = i + 1
	}
	// A format written as a literal is checked against its values (#529); interpolation's own
	// format was checked spec by spec.
	if printf != 0 {
		let fl = cast(Node, args[first - 1])
		if fl.kind == EX_STR && cast(i64, fl) != interp_format {
			fmt_check_format(fl.pos, cast(StrLit, fl).ptr, cast([]i64, types), cast([]i64, poss))
		}
	}
	mut tail = 0
	mut t = ty_void
	if writer != 0 {
		let ws = cast(SelectExpr, node_new(EX_SELECT, pos))
		ws.x = writer
		ws.name = "Write"
		tail = node_new(EX_CALL, pos)
		cast(Call, tail).callee = cast(i64, ws)
		cast(Call, tail).args = cast([]i64, args1(rt_call(pos, "rt_fmt_end", cast(i64, []i64{}), ty_string)))
		chk(cast(Node, tail), 0)
		cast(Node, tail).type_ = ty_void
	} else if m == "Fmt" || m == "Str" {
		tail = rt_call(pos, "rt_fmt_end", cast(i64, []i64{}), ty_string)
		t = ty_string
	} else if m == "Fault" {
		tail = rt_call(pos, "rt_fmt_err", cast(i64, []i64{}), ty_error)
		t = ty_error
	} else {
		tail = rt_call(pos, "rt_fmt_out", cast(i64, []i64{}), ty_void)
	}
	replace_node(e, mk_seq(pos, cast(i64, stmts), tail, t))
	cast(Node, e).type_ = 0
	return t
}

fn arity_error(e i64, want i64) {
	let a = err_code(cast(Node, e).pos, "E210 ARG_COUNT")
	buf_str(a, cast(Call, e).name)
	buf_str(a, " expects ")
	buf_int(a, want)
	buf_str(a, " arguments, got ")
	buf_int(a, len(cast(Call, e).args))
	err_end(cast([]u8, a))
}

// ---- bound(x) !T (#240) ----
//
// bound(x) checks x against the bounded type its destination has (let v str max 100 = try
// bound(x), an assignment or a return): a generated bound$N(x) gives x as that type, or
// fails with fault.LimitExceeded when x is longer than the bound.
fn chk_bound(e i64, want Ty) i64 {
	let pos = cast(Node, e).pos
	mut target = cast(Ty, bound_want)
	bound_want = 0
	if (cast(i64, target) == 0 || target.bound == 0) && cast(i64, want) != 0 && want.bound != 0 {
		target = want
	}
	if len(cast(Call, e).args) != 1 {
		err_code_at(pos, "E252 BOUND_CALL", "bound takes one value")
		return ty_error
	}
	if cast(i64, target) == 0 || target.bound == 0 {
		err_code_at(pos, "E252 BOUND_CALL", "bound needs a bounded destination to check against: write its type (let v str max 100 = try bound(x))")
		return ty_error
	}
	let plain = target.bound
	let x = arg0(cast(Call, e))
	mut xt = chk(cast(Node, x), plain)
	// q.Body() into a bounded type checks the body's length before copying it: the call
	// becomes q.BodyBound(n), which gives the body or fault.LimitExceeded (#240).
	if kind_of(cast(Ty, plain)) == K_STRING && cast(Node, x).kind == EX_CALL && len(cast(Call, x).name) != 0 && cast(Call, x).name == "anvil.Req.Body" {
		let bb = find_fn("anvil.Req.BodyBound")
		if cast(i64, bb) != 0 {
			cast(Call, e).name = bb.qname
			cast(Call, e).fn_ = cast(i64, bb)
			cast(Call, e).method = 1
			cast(Call, e).args = cast([]i64, args2(arg0(cast(Call, x)), mk_int(pos, target.max, ty_int)))
			mut brts = []i64{}
			brts = append(brts, cast(i64, target))
			brts = append(brts, ty_error)
			cast(Node, e).type_ = tuple_of(cast(i64, brts))
			return cast(Node, e).type_
		}
	}
	if is_untyped(xt) != 0 {
		reconvert(cast(Node, x), plain)
		xt = plain
	}
	if assignable(cast(Ty, xt), cast(Ty, plain)) == 0 {
		err_code_types(pos, "E252 BOUND_CALL", "bound cannot check ", xt, " against ", cast(i64, target))
		return ty_error
	}
	let w = cast(Fn, bound_wrapper(pos, target))
	cast(Call, e).name = w.name
	cast(Call, e).fn_ = cast(i64, w)
	mut rts = []i64{}
	rts = append(rts, cast(i64, target))
	rts = append(rts, ty_error)
	let rt = tuple_of(cast(i64, rts))
	cast(Node, e).type_ = rt
	return rt
}

// bound_wrapper builds bound$N(x T) (T max n, fault): x itself, or fault.LimitExceeded.
fn bound_wrapper(pos i64, target Ty) i64 {
	lifted_count = lifted_count + 1
	let f = fn_new(pos, "bound")
	let nb = buf_new()
	buf_str(nb, "bound$")
	buf_int(nb, lifted_count)
	f.qname = str(nb)
	f.name = str(nb)
	f.lifted = 2
	f.file = ck_file
	let plain = target.bound
	f.params = append(f.params, "x")
	f.ptypes = append(f.ptypes, plain)
	f.rtypes = append(f.rtypes, cast(i64, target))
	f.rtypes = append(f.rtypes, ty_error)
	f.type_ = func_of(f.ptypes, f.rtypes, 0)
	f.locals = cast([]Sym, []i64{})
	f.body = empty_block(pos)
	prog_fns = append(prog_fns, cast(Fn, f))
	let saved_fn = ck_fn
	ck_fn = cast(Fn, f)
	let xs = sym_new(SYM_LOCAL, "x", pos)
	xs.type_ = plain
	xs.slot = 0
	mut vs5 = cast([]i64, f.locals)
	vs5 = append(vs5, cast(i64, xs))
	f.slots = 1
	mut body = cast(Block, f.body).stmts
	let over = cast(IfStmt, node_new(ST_IF, pos))
	let n = mk_hdr(pos, sym_ref_node(pos, xs), 0)
	over.cond = mk_bin(pos, ">", n, mk_int(pos, target.max, ty_int), ty_bool)
	over.then = empty_block(pos)
	mut ob = cast(Block, over.then).stmts
	let fx = rt_call(pos, "rt_fault_over", args2(mk_hdr(pos, sym_ref_node(pos, xs), 0), mk_int(pos, target.max, ty_int)), ty_error)
	ob = append(ob, fault_return(pos, cast([]i64, ob), fx))
	body = append(body, cast(i64, over))
	let ret = cast(ReturnStmt, node_new(ST_RETURN, pos))
	let v = cast(Node, sym_ref_node(pos, xs))
	v.type_ = cast(i64, target)
	ret.values = cast([]i64, args2(cast(i64, v), mk_int(pos, 0, ty_error)))
	body = append(body, cast(i64, ret))
	ck_fn = saved_fn
	return cast(i64, f)
}
