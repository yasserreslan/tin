package squash

import "fault"
import "stamp"

// Streaming DEFLATE and zlib (#772): writers that compress what they are given in chunks, so the input never has to
// be held whole, and inflate functions that report where their stream ended, for formats (git's packs) that store
// zlib streams back to back without their compressed lengths.

// Writer is what a streaming compressor writes to: io.Writer's method.
shape Writer {
	mut Write(data []u8) !i64
}

const streamChunk = 262144

// DeflateWriter compresses raw DEFLATE into another writer, a chunk of up to 256 KiB at a time; Close ends the stream.
// Each chunk is compressed on its own (matches do not reach into the chunk before), which costs a little ratio and
// bounds the memory.
type DeflateWriter[W Writer] struct {
	out    W
	level  i64
	buf    []u8
	zlib   bool
	a      u32
	b      u32
	acc    u64
	nbits  i64
	closed bool
}

// packed is one chunk's compressed whole bytes and the bits left over for the next chunk.
type packed struct {
	bytes str
	acc   u64
	nbits i64
}

// NewDeflateWriter is a raw DEFLATE writer into out at level.
fn NewDeflateWriter[W Writer](out W, level i64) DeflateWriter[W] {
	return DeflateWriter[W]{out: out, level: level, buf: make([]u8, 0, streamChunk), zlib: false, a: 1, b: 0, acc: 0, nbits: 0, closed: false}
}

// NewZlibWriter is a zlib (RFC 1950) writer into out at level; Close writes the Adler-32 trailer.
fn NewZlibWriter[W Writer](out W, level i64) !DeflateWriter[W] {
	mut z = DeflateWriter[W]{out: out, level: level, buf: make([]u8, 0, streamChunk), zlib: true, a: 1, b: 0, acc: 0, nbits: 0, closed: false}
	mut lv = 2
	if level <= Fastest {
		lv = 0
	} else if level < Default {
		lv = 1
	} else if level > Default {
		lv = 3
	}
	let cmf = 0x78
	mut flg = lv << 6
	flg += 31 - (cmf * 256 + flg) % 31
	_ = try z.out.Write([]u8{u8(cmf), u8(flg)})
	return z
}

// adler adds data to the running Adler-32.
fn (z mut DeflateWriter[W]) adler(data []u8) {
	mut a = z.a
	mut b = z.b
	mut i = 0
	for i < len(data) {
		let end = min(len(data), i + 5552)
		for k in i..end {
			a = a + u32(data[k])
			b = b + a
		}
		a = a % 65521
		b = b % 65521
		i = end
	}
	z.a = a
	z.b = b
}

// Write takes data, compressing and writing each full chunk.
fn (z mut DeflateWriter[W]) Write(data []u8) !i64 {
	if z.closed {
		fail "squash: write to a closed writer"
	}
	if z.zlib {
		z.adler(data)
	}
	mut i = 0
	for i < len(data) {
		let k = min(len(data) - i, streamChunk - len(z.buf))
		z.buf = append(z.buf, data[i:i + k]...)
		i += k
		if len(z.buf) == streamChunk {
			try z.emit(false)
		}
	}
	return len(data)
}

// emit compresses the buffered chunk as blocks (the final one when final) and writes their whole bytes. DEFLATE
// blocks are not byte-aligned, so the bits after the last whole byte carry over to the next chunk. The compressor's
// tables and copies live in an arena, so a long stream does not grow the pool chunk by chunk.
fn (z mut DeflateWriter[W]) emit(final bool) ! {
	let input = z.buf
	let level = z.level
	let acc0 = z.acc
	let n0 = z.nbits
	let p = arena {
		mut w = bitWriter{out: make([]u8, 0, len(input) / 2 + 64), acc: acc0, n: n0}
		if len(input) > 0 {
			deflateBlocks(mut w, str(input), level, false)
		}
		if final {
			writeStored(mut w, "", 0, 0, true)
			w.flush()
		}
		packed{bytes: str(w.out), acc: w.acc, nbits: w.n}
	}
	z.acc = p.acc
	z.nbits = p.nbits
	if len(p.bytes) > 0 {
		_ = try z.out.Write([]u8(p.bytes))
	}
	z.buf = z.buf[0:0]
}

// Close compresses what is buffered, ends the stream and writes the zlib trailer; it does not close the writer below.
fn (z mut DeflateWriter[W]) Close() ! {
	if z.closed {
		fail "squash: close of a closed writer"
	}
	try z.emit(true)
	if z.zlib {
		let v = (z.b << 16) | z.a
		_ = try z.out.Write([]u8{u8(v >> 24), u8(v >> 16), u8(v >> 8), u8(v)})
	}
	z.closed = true
}

// InflatePrefix decompresses the raw DEFLATE stream at the start of data (at most max bytes out) and says how many
// bytes of data the stream took; what follows is left alone.
fn InflatePrefix(data str, max i64) !(str, i64) {
	mut r = bitReader{s: data, pos: 0, acc: 0, n: 0, bad: false}
	mut out = make([]u8, 0, min(max, len(data) * 4 + 64))
	mut z = newInflater()
	try inflateInto(mut r, mut out, max, mut z)
	return str(out), trailerAt(mut r)
}

// UnzlibPrefix decompresses the zlib stream at the start of data (at most max bytes out), checks its Adler-32 and
// says how many bytes of data the stream took, trailer included.
fn UnzlibPrefix(data str, max i64) !(str, i64) {
	if len(data) < 6 {
		fail "squash: zlib data is too short"
	}
	let cmf = i64(data[0])
	let flg = i64(data[1])
	if cmf & 15 != 8 || cmf >> 4 > 7 || (cmf * 256 + flg) % 31 != 0 {
		fail "squash: not zlib data (its header is damaged)"
	}
	if flg & 32 != 0 {
		fail "squash: zlib data needs a preset dictionary"
	}
	mut r = bitReader{s: data, pos: 2, acc: 0, n: 0, bad: false}
	mut buf = make([]u8, 0, min(max, len(data) * 4 + 64))
	mut z = newInflater()
	try inflateInto(mut r, mut buf, max, mut z)
	let out = str(buf)
	let end = trailerAt(mut r)
	if end + 4 > len(data) {
		fail "squash: zlib data ends before its checksum"
	}
	let want = i64(data[end]) << 24 | i64(data[end + 1]) << 16 | i64(data[end + 2]) << 8 | i64(data[end + 3])
	if want != i64(stamp.Adler32(out)) {
		fail "squash: zlib checksum mismatch"
	}
	return out, end + 4
}
