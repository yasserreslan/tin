package tide

import "say"

// layout.tin renders and reads Go's reference-time layouts ("2006-01-02T15:04:05Z07:00").
// nextStdChunk, appendFormat and the constants are ports of Go's format.go; a layout's reference
// time is Mon Jan 2 15:04:05 MST 2006.

// The standard layouts, as Go's time package names them.
const Layout = "01/02 03:04:05PM '06 -0700"
const ANSIC = "Mon Jan _2 15:04:05 2006"
const UnixDate = "Mon Jan _2 15:04:05 MST 2006"
const RubyDate = "Mon Jan 02 15:04:05 -0700 2006"
const RFC822 = "02 Jan 06 15:04 MST"
const RFC822Z = "02 Jan 06 15:04 -0700"
const RFC850 = "Monday, 02-Jan-06 15:04:05 MST"
const RFC1123 = "Mon, 02 Jan 2006 15:04:05 MST"
const RFC1123Z = "Mon, 02 Jan 2006 15:04:05 -0700"
const RFC3339 = "2006-01-02T15:04:05Z07:00"
const RFC3339Nano = "2006-01-02T15:04:05.999999999Z07:00"
const Kitchen = "3:04PM"
const Stamp = "Jan _2 15:04:05"
const StampMilli = "Jan _2 15:04:05.000"
const StampMicro = "Jan _2 15:04:05.000000"
const StampNano = "Jan _2 15:04:05.000000000"
const DateTime = "2006-01-02 15:04:05"
const DateOnly = "2006-01-02"
const TimeOnly = "15:04:05"

// The standard chunk codes: the low 16 bits of a chunk's value; 0 means "rest is literal".
const stdMask = 65535
const stdArgShift = 16
const stdSeparatorShift = 28
const stdLongMonth = 1
const stdMonth = 2
const stdNumMonth = 3
const stdZeroMonth = 4
const stdLongWeekDay = 5
const stdWeekDay = 6
const stdDay = 7
const stdUnderDay = 8
const stdZeroDay = 9
const stdUnderYearDay = 10
const stdZeroYearDay = 11
const stdHour = 12
const stdHour12 = 13
const stdZeroHour12 = 14
const stdMinute = 15
const stdZeroMinute = 16
const stdSecond = 17
const stdZeroSecond = 18
const stdLongYear = 19
const stdYear = 20
const stdPM = 21
const stdpm = 22
const stdTZ = 23
const stdISO8601TZ = 24
const stdISO8601SecondsTZ = 25
const stdISO8601ShortTZ = 26
const stdISO8601ColonTZ = 27
const stdISO8601ColonSecondsTZ = 28
const stdNumTZ = 29
const stdNumSecondsTz = 30
const stdNumShortTZ = 31
const stdNumColonTZ = 32
const stdNumColonSecondsTZ = 33
const stdFracSecond0 = 34
const stdFracSecond9 = 35

// The month and weekday names parse and print with (Go's tables).
let longDayNames = []str{"Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"}
let shortDayNames = []str{"Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"}
let shortMonthNames = []str{"Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"}
let longMonthNames = []str{"January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"}

// std0x is the code of "01", "02", ..., "06".
let std0x = []i64{stdZeroMonth, stdZeroDay, stdZeroHour12, stdZeroMinute, stdZeroSecond, stdYear}

// startsWithLowerCase reports whether s starts with a lower-case ASCII letter (so "Month" is
// not read as "Mon" plus "th").
fn startsWithLowerCase(s str) bool {
	if len(s) == 0 {
		return false
	}
	let c = s[0]
	return c >= 'a' && c <= 'z'
}

// nextStdChunk finds the first standard chunk in layout and returns the text before it, its code,
// and the text after it; with no chunk the whole layout comes back as the prefix.
fn nextStdChunk(layout str) (str, i64, str) {
	mut i = 0
	for i < len(layout) {
		let c = layout[i]
		if c == 'J' { // January, Jan
			if len(layout) >= i+3 && layout[i:i+3] == "Jan" {
				if len(layout) >= i+7 && layout[i:i+7] == "January" {
					return layout[0:i], stdLongMonth, layout[i+7:len(layout)]
				}
				if !startsWithLowerCase(layout[i+3:len(layout)]) {
					return layout[0:i], stdMonth, layout[i+3:len(layout)]
				}
			}
		} else if c == 'M' { // Monday, Mon, MST
			if len(layout) >= i+3 {
				if layout[i:i+3] == "Mon" {
					if len(layout) >= i+6 && layout[i:i+6] == "Monday" {
						return layout[0:i], stdLongWeekDay, layout[i+6:len(layout)]
					}
					if !startsWithLowerCase(layout[i+3:len(layout)]) {
						return layout[0:i], stdWeekDay, layout[i+3:len(layout)]
					}
				}
				if layout[i:i+3] == "MST" {
					return layout[0:i], stdTZ, layout[i+3:len(layout)]
				}
			}
		} else if c == '0' { // 01, 02, 03, 04, 05, 06, 002
			if len(layout) >= i+2 && layout[i+1] >= '1' && layout[i+1] <= '6' {
				return layout[0:i], std0x[i64(layout[i+1])-'1'], layout[i+2:len(layout)]
			}
			if len(layout) >= i+3 && layout[i+1] == '0' && layout[i+2] == '2' {
				return layout[0:i], stdZeroYearDay, layout[i+3:len(layout)]
			}
		} else if c == '1' { // 15, 1
			if len(layout) >= i+2 && layout[i+1] == '5' {
				return layout[0:i], stdHour, layout[i+2:len(layout)]
			}
			return layout[0:i], stdNumMonth, layout[i+1:len(layout)]
		} else if c == '2' { // 2006, 2
			if len(layout) >= i+4 && layout[i:i+4] == "2006" {
				return layout[0:i], stdLongYear, layout[i+4:len(layout)]
			}
			return layout[0:i], stdDay, layout[i+1:len(layout)]
		} else if c == '_' { // _2, _2006, __2
			if len(layout) >= i+2 && layout[i+1] == '2' {
				// _2006 is a literal "_" followed by stdLongYear.
				if len(layout) >= i+5 && layout[i+1:i+5] == "2006" {
					return layout[0 : i+1], stdLongYear, layout[i+5:len(layout)]
				}
				return layout[0:i], stdUnderDay, layout[i+2:len(layout)]
			}
			if len(layout) >= i+3 && layout[i+1] == '_' && layout[i+2] == '2' {
				return layout[0:i], stdUnderYearDay, layout[i+3:len(layout)]
			}
		} else if c == '3' {
			return layout[0:i], stdHour12, layout[i+1:len(layout)]
		} else if c == '4' {
			return layout[0:i], stdMinute, layout[i+1:len(layout)]
		} else if c == '5' {
			return layout[0:i], stdSecond, layout[i+1:len(layout)]
		} else if c == 'P' { // PM
			if len(layout) >= i+2 && layout[i+1] == 'M' {
				return layout[0:i], stdPM, layout[i+2:len(layout)]
			}
		} else if c == 'p' { // pm
			if len(layout) >= i+2 && layout[i+1] == 'm' {
				return layout[0:i], stdpm, layout[i+2:len(layout)]
			}
		} else if c == '-' { // -070000, -07:00:00, -0700, -07:00, -07
			if len(layout) >= i+7 && layout[i:i+7] == "-070000" {
				return layout[0:i], stdNumSecondsTz, layout[i+7:len(layout)]
			}
			if len(layout) >= i+9 && layout[i:i+9] == "-07:00:00" {
				return layout[0:i], stdNumColonSecondsTZ, layout[i+9:len(layout)]
			}
			if len(layout) >= i+5 && layout[i:i+5] == "-0700" {
				return layout[0:i], stdNumTZ, layout[i+5:len(layout)]
			}
			if len(layout) >= i+6 && layout[i:i+6] == "-07:00" {
				return layout[0:i], stdNumColonTZ, layout[i+6:len(layout)]
			}
			if len(layout) >= i+3 && layout[i:i+3] == "-07" {
				return layout[0:i], stdNumShortTZ, layout[i+3:len(layout)]
			}
		} else if c == 'Z' { // Z070000, Z07:00:00, Z0700, Z07:00, Z07
			if len(layout) >= i+7 && layout[i:i+7] == "Z070000" {
				return layout[0:i], stdISO8601SecondsTZ, layout[i+7:len(layout)]
			}
			if len(layout) >= i+9 && layout[i:i+9] == "Z07:00:00" {
				return layout[0:i], stdISO8601ColonSecondsTZ, layout[i+9:len(layout)]
			}
			if len(layout) >= i+5 && layout[i:i+5] == "Z0700" {
				return layout[0:i], stdISO8601TZ, layout[i+5:len(layout)]
			}
			if len(layout) >= i+6 && layout[i:i+6] == "Z07:00" {
				return layout[0:i], stdISO8601ColonTZ, layout[i+6:len(layout)]
			}
			if len(layout) >= i+3 && layout[i:i+3] == "Z07" {
				return layout[0:i], stdISO8601ShortTZ, layout[i+3:len(layout)]
			}
		} else if c == '.' || c == ',' { // ,000, .000, ,999, .999, ...
			if i+1 < len(layout) && (layout[i+1] == '0' || layout[i+1] == '9') {
				let ch = layout[i+1]
				mut j = i + 1
				for j < len(layout) && layout[j] == ch {
					j += 1
				}
				// A run of digits must be the whole fractional-second chunk.
				if !(j < len(layout) && layout[j] >= '0' && layout[j] <= '9') {
					mut code = stdFracSecond0
					if layout[i+1] == '9' {
						code = stdFracSecond9
					}
					return layout[0:i], stdFracSecond(code, j-(i+1), c), layout[j:len(layout)]
				}
			}
		}
		i += 1
	}
	return layout, 0, ""
}

// stdFracSecond packs a fractional-second code: its kind, its number of digits, and the
// separator ('.' or ',').
fn stdFracSecond(code i64, n i64, c u8) i64 {
	if c == '.' {
		return code | (n&4095)<<stdArgShift
	}
	return code | (n&4095)<<stdArgShift | 1<<stdSeparatorShift
}

// digitsLen returns the number of fractional digits packed into std.
fn digitsLen(std i64) i64 {
	return (std >> stdArgShift) & 4095
}

// separator returns the fractional-second separator packed into std.
fn separator(std i64) u8 {
	if (std >> stdSeparatorShift) == 0 {
		return '.'
	}
	return ','
}

// fmtBuf accumulates formatted bytes.
type fmtBuf struct {
	buf []u8
}

// byte appends c.
fn (b mut fmtBuf) byte(c u8) {
	b.buf = append(b.buf, c)
}

// str appends s.
fn (b mut fmtBuf) str(s str) {
	b.buf = append(b.buf, s...)
}

// len returns the bytes accumulated.
fn (b mut fmtBuf) len() i64 {
	return len(b.buf)
}

// truncate drops the last n bytes.
fn (b mut fmtBuf) truncate(n i64) {
	b.buf = b.buf[0 : len(b.buf)-n]
}

// last returns the final byte.
fn (b mut fmtBuf) last() u8 {
	return b.buf[len(b.buf)-1]
}

// result returns the bytes as a str.
fn (b mut fmtBuf) result() str {
	return str(b.buf)
}

// int appends x in decimal with at least width digits.
fn (b mut fmtBuf) int(x i64, width i64) {
	mut u = u64(x)
	if x < 0 {
		b.byte('-')
		u = u64(0 -% x)
	}
	if u == 0 {
		mut pad = 1
		for pad < width {
			b.byte('0')
			pad += 1
		}
		b.byte('0')
		return
	}
	mut n = 0
	{
		mut u2 = u
		for u2 > 0 {
			n += 1
			u2 /= 10
		}
	}
	{
		mut pad = width - n
		for pad > 0 {
			b.byte('0')
			pad -= 1
		}
	}
	let start = b.len()
	for i in 0..n {
		b.byte('0')
	}
	mut pos = start + n - 1
	for u > 0 {
		b.buf[pos] = u8(u%10) + '0'
		u /= 10
		pos -= 1
	}
}

// appendNano appends nanosec as a fractional second per std (its digits and separator; the 9
// variant drops trailing zeros).
fn (b mut fmtBuf) appendNano(nanosec i64, std i64) {
	let trim = (std & stdMask) == stdFracSecond9
	let n = digitsLen(std)
	if trim && (n == 0 || nanosec == 0) {
		return
	}
	let dot = separator(std)
	b.byte(dot)
	b.int(nanosec, 9)
	if n < 9 {
		b.truncate(9 - n)
	}
	if trim {
		for b.len() > 0 && b.last() == '0' {
			b.truncate(1)
		}
		if b.len() > 0 && b.last() == dot {
			b.truncate(1)
		}
	}
}

// appendFormat renders the civil time c in layout and returns it.
fn appendFormat(c Civil, layout str) str {
	mut b = fmtBuf{}
	mut rest = layout
	for len(rest) > 0 {
		let (prefix, std, suffix) = nextStdChunk(rest)
		if len(prefix) > 0 {
			b.str(prefix)
		}
		if std == 0 {
			break
		}
		rest = suffix
		let code = std & stdMask
		if code == stdYear {
			mut y = c.Year
			if y < 0 {
				y = -y
			}
			b.int(y%100, 2)
		} else if code == stdLongYear {
			b.int(c.Year, 4)
		} else if code == stdMonth {
			b.str(MonthName(c.Month)[0:3])
		} else if code == stdLongMonth {
			b.str(MonthName(c.Month))
		} else if code == stdNumMonth {
			b.int(c.Month, 0)
		} else if code == stdZeroMonth {
			b.int(c.Month, 2)
		} else if code == stdWeekDay {
			b.str(WeekdayName(c.Weekday)[0:3])
		} else if code == stdLongWeekDay {
			b.str(WeekdayName(c.Weekday))
		} else if code == stdDay {
			b.int(c.Day, 0)
		} else if code == stdUnderDay {
			if c.Day < 10 {
				b.byte(' ')
			}
			b.int(c.Day, 0)
		} else if code == stdZeroDay {
			b.int(c.Day, 2)
		} else if code == stdUnderYearDay {
			if c.YearDay < 100 {
				b.byte(' ')
				if c.YearDay < 10 {
					b.byte(' ')
				}
			}
			b.int(c.YearDay, 0)
		} else if code == stdZeroYearDay {
			b.int(c.YearDay, 3)
		} else if code == stdHour {
			b.int(c.Hour, 2)
		} else if code == stdHour12 || code == stdZeroHour12 {
			// Noon is 12PM, midnight is 12AM.
			mut hr = c.Hour % 12
			if hr == 0 {
				hr = 12
			}
			mut width i64 = 0
			if code == stdZeroHour12 {
				width = 2
			}
			b.int(hr, width)
		} else if code == stdMinute {
			b.int(c.Min, 0)
		} else if code == stdZeroMinute {
			b.int(c.Min, 2)
		} else if code == stdSecond {
			b.int(c.Sec, 0)
		} else if code == stdZeroSecond {
			b.int(c.Sec, 2)
		} else if code == stdPM {
			if c.Hour >= 12 {
				b.str("PM")
			} else {
				b.str("AM")
			}
		} else if code == stdpm {
			if c.Hour >= 12 {
				b.str("pm")
			} else {
				b.str("am")
			}
		} else if code >= stdISO8601TZ && code <= stdNumColonSecondsTZ {
			// The "Z" variants print Z at zero offset and are numeric otherwise.
			if c.Offset == 0 && code >= stdISO8601TZ && code <= stdISO8601ColonSecondsTZ {
				b.byte('Z')
			} else {
				let zone = c.Offset / 60 // minutes
				mut absoffset = c.Offset
				if zone < 0 {
					b.byte('-')
					absoffset = -absoffset
				} else {
					b.byte('+')
				}
				mut az = zone
				if az < 0 {
					az = -az
				}
				b.int(az/60, 2)
				if code == stdISO8601ColonTZ || code == stdNumColonTZ || code == stdISO8601ColonSecondsTZ || code == stdNumColonSecondsTZ {
					b.byte(':')
				}
				if code != stdNumShortTZ && code != stdISO8601ShortTZ {
					b.int(az%60, 2)
				}
				if code == stdISO8601SecondsTZ || code == stdNumSecondsTz || code == stdNumColonSecondsTZ || code == stdISO8601ColonSecondsTZ {
					if code == stdNumColonSecondsTZ || code == stdISO8601ColonSecondsTZ {
						b.byte(':')
					}
					b.int(absoffset%60, 2)
				}
			}
		} else if code == stdTZ {
			if len(c.Zone) > 0 {
				b.str(c.Zone)
			} else {
				let zone = c.Offset / 60
				mut az = zone
				if az < 0 {
					b.byte('-')
					az = -az
				} else {
					b.byte('+')
				}
				b.int(az/60, 2)
				b.int(az%60, 2)
			}
		} else if code == stdFracSecond0 || code == stdFracSecond9 {
			b.appendNano(c.Nano, std)
		}
	}
	return b.result()
}

// Format renders the instant ns in zone z with a reference-time layout, like Go's Time.Format.
fn Format(ns i64, z Zone, layout str) str {
	return appendFormat(In(ns, z), layout)
}

// match reports whether s1 and s2 are equal ignoring case (the same length).
fn matchName(s1 str, s2 str) bool {
	if len(s1) != len(s2) {
		return false
	}
	for i in 0..len(s1) {
		let c1 = s1[i]
		let c2 = s2[i]
		if c1 != c2 {
			let l1 = c1 | 32
			let l2 = c2 | 32
			if l1 != l2 || l1 < 'a' || l1 > 'z' {
				return false
			}
		}
	}
	return true
}

// lookup returns the index of the first name in tab that starts val (ignoring case), with the
// rest of val; ok is false when none matches.
fn lookup(tab []str, val str) (i64, str, bool) {
	for i, v in tab {
		if len(val) >= len(v) && matchName(val[0:len(v)], v) {
			return i, val[len(v):len(val)], true
		}
	}
	return -1, val, false
}

// commaOrPeriod reports whether c is the fractional-second separator.
fn commaOrPeriod(c u8) bool {
	return c == '.' || c == ','
}

// leadingInt consumes the leading digits of s; ok is false on overflow.
fn leadingInt(s str) (u64, str, bool) {
	mut x = u64(0)
	mut i = 0
	for i < len(s) {
		let c = s[i]
		if c < '0' || c > '9' {
			break
		}
		if x > (u64(1)<<63)/10 {
			return 0, "", false
		}
		x = x*10 + u64(c) - '0'
		if x > u64(1)<<63 {
			return 0, "", false
		}
		i += 1
	}
	return x, s[i:len(s)], true
}

// atoi parses a signed decimal integer; ok is false when it is malformed.
fn atoi(s str) (i64, bool) {
	mut neg = false
	mut body = s
	if len(body) > 0 && (body[0] == '-' || body[0] == '+') {
		neg = body[0] == '-'
		body = body[1:len(body)]
	}
	let (q, rem, ok) = leadingInt(body)
	if !ok || len(rem) > 0 {
		return 0, false
	}
	mut x = i64(q)
	if neg {
		x = -x
	}
	return x, true
}

// getnum parses s[0:1] or s[0:2] (fixed forces s[0:2]) as a decimal number.
fn getnum(s str, fixed bool) (i64, str, bool) {
	if !isDigitAt(s, 0) {
		return 0, s, false
	}
	if !isDigitAt(s, 1) {
		if fixed {
			return 0, s, false
		}
		return i64(s[0]) - '0', s[1:len(s)], true
	}
	return (i64(s[0])-'0')*10 + i64(s[1]) - '0', s[2:len(s)], true
}

// getnum3 parses s[0:1], s[0:2] or s[0:3] (fixed forces s[0:3]).
fn getnum3(s str, fixed bool) (i64, str, bool) {
	mut n = 0
	mut i = 0
	for i < 3 && isDigitAt(s, i) {
		n = n*10 + i64(s[i]) - '0'
		i += 1
	}
	if i == 0 || (fixed && i != 3) {
		return 0, s, false
	}
	return n, s[i:len(s)], true
}

// cutspace returns s without leading spaces.
fn cutspace(s str) str {
	mut i = 0
	for i < len(s) && s[i] == ' ' {
		i += 1
	}
	return s[i:len(s)]
}

// skip removes prefix from value, treating runs of spaces as equivalent; ok is false when value
// does not start with it.
fn skip(value str, prefix str) (str, bool) {
	mut v = value
	mut p = prefix
	for len(p) > 0 {
		if p[0] == ' ' {
			if len(v) > 0 && v[0] != ' ' {
				return v, false
			}
			p = cutspace(p)
			v = cutspace(v)
			continue
		}
		if len(v) == 0 || v[0] != p[0] {
			return v, false
		}
		p = p[1:len(p)]
		v = v[1:len(v)]
	}
	return v, true
}

// parseNanoseconds parses a fractional second of nbytes bytes (its first byte is ',' or '.');
// range is true when the fraction is out of range, ok false when malformed.
fn parseNanoseconds(value str, nbytes i64) (i64, bool, bool) {
	if !commaOrPeriod(value[0]) {
		return 0, false, false
	}
	mut body = value
	mut n = nbytes
	if n > 10 {
		body = body[0:10]
		n = 10
	}
	let (ns, ok) = atoi(body[1:n])
	if !ok {
		return 0, false, false
	}
	if ns < 0 {
		return 0, true, true
	}
	mut scaled = ns
	for i in 0..10-n {
		scaled *= 10
	}
	return scaled, false, true
}

// parseTimeZone parses a zone abbreviation at the start of value and returns its length.
fn parseTimeZone(value str) (i64, bool) {
	if len(value) < 3 {
		return 0, false
	}
	// ChST and MeST are the only zones with a lower-case letter.
	if len(value) >= 4 && (value[0:4] == "ChST" || value[0:4] == "MeST") {
		return 4, true
	}
	// GMT may carry an hour offset.
	if value[0:3] == "GMT" {
		return 3 + parseSignedOffset(value[3:len(value)]), true
	}
	// Some zones are unnamed and have a +/-00 form.
	if value[0] == '+' || value[0] == '-' {
		let length = parseSignedOffset(value)
		return length, length > 0
	}
	mut nUpper = 0
	for nUpper < 6 {
		if nUpper >= len(value) {
			break
		}
		let c = value[nUpper]
		if c < 'A' || c > 'Z' {
			break
		}
		nUpper += 1
	}
	if nUpper == 0 || nUpper == 1 || nUpper == 2 || nUpper == 6 {
		return 0, false
	}
	if nUpper == 5 {
		if value[4] == 'T' {
			return 5, true
		}
	} else if nUpper == 4 {
		if value[3] == 'T' || value[0:4] == "WITA" {
			return 4, true
		}
	} else {
		return 3, true
	}
	return 0, false
}

// parseSignedOffset parses "+03" or "-04" (hours -23..23, not zero) and returns its length.
fn parseSignedOffset(value str) i64 {
	if len(value) == 0 {
		return 0
	}
	let sign = value[0]
	if sign != '-' && sign != '+' {
		return 0
	}
	let (x, rem, ok) = leadingInt(value[1:len(value)])
	if !ok || len(rem) == len(value)-1 {
		return 0
	}
	if x > 23 {
		return 0
	}
	return len(value) - len(rem)
}

// lookupName returns the offset of the zone called name in z at the pseudo-Unix time unix (Go's
// Location.lookupName); ok is false when z has no such zone.
fn (z Zone) lookupName(name str, unix i64) (i64, bool) {
	for zn in z.zones {
		if zn.name == name {
			let (nam, offset, _, _) = z.lookup(unix - zn.offset)
			if nam == zn.name {
				return offset, true
			}
		}
	}
	for zn in z.zones {
		if zn.name == name {
			return zn.offset, true
		}
	}
	return 0, false
}

// parseErr fails with tide's Parse fault for value under layout.
fn parseErr(layout str, value str) ! {
	fail say.Fault("tide: cannot parse %s as %s", quote(value), quote(layout))
}

// Parse parses value with a reference-time layout, like Go's time.ParseInLocation: a wall time
// with no zone in the value is read in z, while a zone offset or abbreviation is that instant
// (matched against z when it names one of z's zones). It returns Unix nanoseconds; malformed or
// out-of-range values fail with a parse fault (tide's message carries the layout and text).
fn Parse(layout str, value str, z Zone) !i64 {
	mut year i64 = 0
	mut month i64 = -1
	mut day i64 = -1
	mut yday i64 = -1
	mut hour i64 = 0
	mut min i64 = 0
	mut sec i64 = 0
	mut nsec i64 = 0
	mut zoneOffset i64 = -1
	mut zoneName = ""
	mut zoneUTC = false
	mut amSet = false
	mut pmSet = false
	mut lay = layout
	mut val = value
	for {
		let (prefix, std, suffix) = nextStdChunk(lay)
		let (sv, sok) = skip(val, prefix)
		if !sok {
			try parseErr(layout, value)
		}
		val = sv
		if std == 0 {
			if len(val) != 0 {
				try parseErr(layout, value)
			}
			break
		}
		lay = suffix
		mut bad = false
		mut rangeErr = ""
		let code = std & stdMask
		if code == stdYear {
			if len(val) < 2 {
				bad = true
			} else {
				let (y, ok) = atoi(val[0:2])
				if !ok {
					bad = true
				} else {
					year = y
					if year >= 69 {
						year += 1900
					} else {
						year += 2000
					}
					val = val[2:len(val)]
				}
			}
		} else if code == stdLongYear {
			if len(val) < 4 || !isDigitAt(val, 0) {
				bad = true
			} else {
				let (y, ok) = atoi(val[0:4])
				if !ok {
					bad = true
				} else {
					year = y
					val = val[4:len(val)]
				}
			}
		} else if code == stdMonth {
			let (m, rest, ok) = lookup(shortMonthNames, val)
			if !ok {
				bad = true
			} else {
				month = m + 1
				val = rest
			}
		} else if code == stdLongMonth {
			let (m, rest, ok) = lookup(longMonthNames, val)
			if !ok {
				bad = true
			} else {
				month = m + 1
				val = rest
			}
		} else if code == stdNumMonth || code == stdZeroMonth {
			let (m, rest, ok) = getnum(val, code == stdZeroMonth)
			if !ok {
				bad = true
			} else {
				month = m
				val = rest
				if month <= 0 || month > 12 {
					rangeErr = "month"
				}
			}
		} else if code == stdWeekDay || code == stdLongWeekDay {
			mut ok = true
			if code == stdWeekDay {
				let (_, rest, ok2) = lookup(shortDayNames, val)
				ok = ok2
				val = rest
			} else {
				let (_, rest, ok2) = lookup(longDayNames, val)
				ok = ok2
				val = rest
			}
			if !ok {
				bad = true
			}
		} else if code == stdDay || code == stdUnderDay || code == stdZeroDay {
			if code == stdUnderDay && len(val) > 0 && val[0] == ' ' {
				val = val[1:len(val)]
			}
			let (d, rest, ok) = getnum(val, code == stdZeroDay)
			if !ok {
				bad = true
			} else {
				day = d
				val = rest
			}
		} else if code == stdUnderYearDay || code == stdZeroYearDay {
			for i in 0..2 {
				if code == stdUnderYearDay && len(val) > 0 && val[0] == ' ' {
					val = val[1:len(val)]
				}
			}
			let (d, rest, ok) = getnum3(val, code == stdZeroYearDay)
			if !ok {
				bad = true
			} else {
				yday = d
				val = rest
			}
		} else if code == stdHour {
			let (h, rest, ok) = getnum(val, false)
			if !ok {
				bad = true
			} else {
				hour = h
				val = rest
				if hour >= 24 {
					rangeErr = "hour"
				}
			}
		} else if code == stdHour12 || code == stdZeroHour12 {
			let (h, rest, ok) = getnum(val, code == stdZeroHour12)
			if !ok {
				bad = true
			} else {
				hour = h
				val = rest
				if hour > 12 {
					rangeErr = "hour"
				}
			}
		} else if code == stdMinute || code == stdZeroMinute {
			let (m, rest, ok) = getnum(val, code == stdZeroMinute)
			if !ok {
				bad = true
			} else {
				min = m
				val = rest
				if min >= 60 {
					rangeErr = "minute"
				}
			}
		} else if code == stdSecond || code == stdZeroSecond {
			let (s, rest, ok) = getnum(val, code == stdZeroSecond)
			if !ok {
				bad = true
			} else {
				sec = s
				val = rest
				if sec >= 60 {
					rangeErr = "second"
				} else if len(val) >= 2 && commaOrPeriod(val[0]) && isDigitAt(val, 1) {
					// A fractional second with none in the layout: take every digit.
					let (_, std2, _) = nextStdChunk(lay)
					let code2 = std2 & stdMask
					if code2 != stdFracSecond0 && code2 != stdFracSecond9 {
						mut n = 2
						for n < len(val) && isDigitAt(val, n) {
							n += 1
						}
						let (ns, rng, ok2) = parseNanoseconds(val, n)
						if !ok2 {
							bad = true
						} else if rng {
							rangeErr = "fractional second"
						} else {
							nsec = ns
							val = val[n:len(val)]
						}
					}
				}
			}
		} else if code == stdPM || code == stdpm {
			if len(val) < 2 {
				bad = true
			} else {
				let p = val[0:2]
				if code == stdPM {
					if p == "PM" {
						pmSet = true
					} else if p == "AM" {
						amSet = true
					} else {
						bad = true
					}
				} else {
					if p == "pm" {
						pmSet = true
					} else if p == "am" {
						amSet = true
					} else {
						bad = true
					}
				}
				if !bad {
					val = val[2:len(val)]
				}
			}
		} else if code >= stdISO8601TZ && code <= stdNumColonSecondsTZ {
			if code <= stdISO8601ColonSecondsTZ && len(val) >= 1 && val[0] == 'Z' {
				val = val[1:len(val)]
				zoneUTC = true
			} else {
				mut sign = ""
				mut hourS = ""
				mut minS = ""
				mut secS = ""
				mut ok = true
				if code == stdISO8601ColonTZ || code == stdNumColonTZ {
					if len(val) < 6 || val[3] != ':' {
						ok = false
					} else {
						sign, hourS, minS, secS, val = val[0:1], val[1:3], val[4:6], "00", val[6:len(val)]
					}
				} else if code == stdNumShortTZ || code == stdISO8601ShortTZ {
					if len(val) < 3 {
						ok = false
					} else {
						sign, hourS, minS, secS, val = val[0:1], val[1:3], "00", "00", val[3:len(val)]
					}
				} else if code == stdISO8601ColonSecondsTZ || code == stdNumColonSecondsTZ {
					if len(val) < 9 || val[3] != ':' || val[6] != ':' {
						ok = false
					} else {
						sign, hourS, minS, secS, val = val[0:1], val[1:3], val[4:6], val[7:9], val[9:len(val)]
					}
				} else if code == stdISO8601SecondsTZ || code == stdNumSecondsTz {
					if len(val) < 7 {
						ok = false
					} else {
						sign, hourS, minS, secS, val = val[0:1], val[1:3], val[3:5], val[5:7], val[7:len(val)]
					}
				} else {
					if len(val) < 5 {
						ok = false
					} else {
						sign, hourS, minS, secS, val = val[0:1], val[1:3], val[3:5], "00", val[5:len(val)]
					}
				}
				if !ok {
					bad = true
				} else {
					let (hr, _, okh) = getnum(hourS, true)
					let (mm, _, okm) = getnum(minS, true)
					let (ss, _, oks) = getnum(secS, true)
					if !okh || !okm || !oks {
						bad = true
					} else {
						// Offsets of 24 hours or 60 minutes are allowed by the range test.
						if hr > 24 {
							rangeErr = "time zone offset hour"
						}
						if mm > 60 {
							rangeErr = "time zone offset minute"
						}
						if ss > 60 {
							rangeErr = "time zone offset second"
						}
						zoneOffset = (hr*60+mm)*60 + ss
						if sign[0] == '-' {
							zoneOffset = -zoneOffset
						} else if sign[0] != '+' {
							bad = true
						}
					}
				}
			}
		} else if code == stdTZ {
			if len(val) >= 3 && val[0:3] == "UTC" {
				zoneUTC = true
				val = val[3:len(val)]
			} else {
				let (n, ok) = parseTimeZone(val)
				if !ok {
					bad = true
				} else {
					zoneName = val[0:n]
					val = val[n:len(val)]
				}
			}
		} else if code == stdFracSecond0 {
			let ndigit = 1 + digitsLen(std)
			if len(val) < ndigit {
				bad = true
			} else {
				let (ns, rng, ok) = parseNanoseconds(val, ndigit)
				if !ok {
					bad = true
				} else {
					if rng {
						rangeErr = "fractional second"
					}
					nsec = ns
					val = val[ndigit:len(val)]
				}
			}
		} else if code == stdFracSecond9 {
			if len(val) >= 2 && commaOrPeriod(val[0]) && val[1] >= '0' && val[1] <= '9' {
				mut i = 0
				for i+1 < len(val) && val[i+1] >= '0' && val[i+1] <= '9' {
					i += 1
				}
				let (ns, rng, ok) = parseNanoseconds(val, 1+i)
				if !ok {
					bad = true
				} else {
					if rng {
						rangeErr = "fractional second"
					}
					nsec = ns
					val = val[1+i:len(val)]
				}
			}
		}
		if rangeErr != "" {
			try parseErr(layout, value)
		}
		if bad {
			try parseErr(layout, value)
		}
	}
	if pmSet && hour < 12 {
		hour += 12
	} else if amSet && hour == 12 {
		hour = 0
	}

	// Convert a day of the year to month and day.
	if yday >= 0 {
		mut m i64 = 0
		mut d i64 = 0
		if IsLeap(year) {
			if yday == 60 {
				m = 2
				d = 29
			} else if yday > 60 {
				yday -= 1
			}
		}
		if yday < 1 || yday > 365 {
			try parseErr(layout, value)
		}
		if m == 0 {
			m = (yday-1)/31 + 1
			if m < 12 && daysBefore(m+1) < yday {
				m += 1
			}
			d = yday - daysBefore(m)
		}
		if month >= 0 && month != m {
			try parseErr(layout, value)
		}
		month = m
		if day >= 0 && day != d {
			try parseErr(layout, value)
		}
		day = d
	} else {
		if month < 0 {
			month = 1
		}
		if day < 0 {
			day = 1
		}
	}
	if day < 1 || day > DaysIn(year, month) {
		try parseErr(layout, value)
	}

	// The wall time in seconds, then the instant each zone case gives. Scaling to nanoseconds
	// happens once, with a range check: Go wraps out-of-range UnixNano values, tide faults.
	let wall = (DaysFromCivil(year, month, 1) + day - 1)*86400 + hour*3600 + min*60 + sec
	if zoneUTC {
		return try stamp(wall, nsec)
	}
	if zoneOffset != -1 {
		return try stamp(wall - zoneOffset, nsec)
	}
	if len(zoneName) > 0 {
		let (offset, ok) = z.lookupName(zoneName, wall)
		if ok {
			return try stamp(wall - offset, nsec)
		}
		// An unknown abbreviation records the instant as UTC; Go's fake zone only affects
		// formatting, which this API does not carry.
		return try stamp(wall, nsec)
	}
	let (unix, nano2) = dateInSec(year, month, day, hour, min, sec, nsec, z)
	return try stamp(unix, nano2)
}

// stamp turns Unix seconds and nanoseconds into Unix nanoseconds, failing when the instant is
// outside 1677-09-21 to 2262-04-11 (Go's UnixNano wraps there; tide refuses).
fn stamp(unix i64, nano i64) !i64 {
	if unix > 9223372036 || unix < -9223372037 || (unix == 9223372036 && nano > 854775807) || (unix == -9223372037 && nano < 145224192) {
		fail say.Fault("tide: the parsed time is outside the range of Unix nanoseconds (1677-09-21 to 2262-04-11)")
	}
	// unix*Second alone overflows in the first second of the range: borrow it back.
	if unix < 0 && nano > 0 {
		return (unix+1)*Second + (nano - Second)
	}
	return unix*Second + nano
}
