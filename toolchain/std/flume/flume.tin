// Package flume reads and writes file descriptors through 64 KiB buffers: lines, whole
// files and buffered output with one write per flush.
package flume

import "say"

const bufSize = 65536

// Reader buffers reads from a file descriptor. Inside a task it waits on a pipe, socket or
// terminal through rt_task_wait, so a deadline or cancel fails the read (the next read retries).
type Reader struct {
	open bool // false for the zero Reader (a failed Open): it owns no descriptor
	fd   i64
	buf  []u8
	pos  i64
	fill i64
	eof  bool
	err  fault
	wait   i64  // 0 not checked yet, 1 a pipe, socket or terminal (tasks wait on it), 2 anything else
	waited bool // err is a wait's deadline or cancel fault, which the next read clears
}

// Writer buffers writes to a file descriptor.
type Writer struct {
	open bool // false for the zero Writer (a failed Create): it owns no descriptor
	fd  i64
	buf []u8
	err fault
}

fn errno_fault(what str) ! {
	let e = rt_errno()
	let m = rt_sys_strerror(e)
	fail say.Fault("flume: %s: %s", what, rt_str_from_raw(m, strlen(m)))
}

// New reads from fd.
fn New(fd i64) Reader {
	return Reader{open: true, fd: fd, buf: make([]u8, bufSize)}
}

// Open reads the file at path.
fn Open(path str) !Reader {
	let fd = i64(i32(rt_sys_open(cast(i64, path)+8, 0, 0)))
	if fd < 0 {
		fail errno_fault(path)
	}
	return New(fd)
}

// Close closes the reader's descriptor.
fn (r mut Reader) Close() {
	if r.open {
		rt_sys_close(r.fd)
		r.open = false
	}
}

// more reads the next chunk, keeping the unread bytes at the front; false at end or error.
fn (r mut Reader) more() bool {
	if r.waited {
		r.err = nil
		r.waited = false
	}
	if r.eof || r.err != nil {
		return false
	}
	if !r.open {
		r.err = fail("flume: read: reader is closed")
		return false
	}
	if r.pos > 0 {
		let n = r.fill - r.pos
		let h = cast(i64, r.buf)
		memmove(h[2], h[2]+r.pos, n)
		r.fill = n
		r.pos = 0
	}
	if r.fill == len(r.buf) {
		let bigger = make([]u8, 2*len(r.buf))
		copy(bigger, r.buf)
		r.buf = bigger
	}
	let h2 = cast(i64, r.buf)
	// Inside a task a pipe, socket or terminal is waited on, so deadlines and cancels apply.
	if rt_task_current() != 0 && r.waits() {
		if rt_task_wait(r.fd, 1, 0) == waitDeadline {
			r.err = cast(fault, rt_wait_fault())
			r.waited = true
			return false
		}
	}
	let n = rt_sys_read(r.fd, h2[2]+r.fill, len(r.buf)-r.fill)
	if n < 0 && rt_errno() == EAGAIN && rt_task_current() != 0 && r.waits() {
		return r.more()
	}
	if n < 0 {
		r.err = errno_fault("read")
		return false
	}
	if n == 0 {
		r.eof = true
		return false
	}
	r.fill += n
	return true
}

// waits reports whether the reader's descriptor is a pipe, socket or terminal.
fn (r mut Reader) waits() bool {
	if r.wait == 0 {
		r.wait = 2
		let st = calloc(1, 256)
		if i64(i32(rt_sys_fstat(r.fd, st))) == 0 {
			let t = rt_stat_mode(st) & 0xf000
			if t == 0x1000 || t == 0xc000 || (t == 0x2000 && rt_isatty(r.fd)) {
				r.wait = 1
			}
		}
		free(st)
	}
	return r.wait == 1
}

// Line returns the next line without its "\n" (or "\r\n"); ok is false at the end.
fn (r mut Reader) Line() !(str, bool) {
	mut start = 0
	for {
		let h = cast(i64, r.buf)
		for i in r.pos + start..r.fill {
			if load8(h[2]+i) == '\n' {
				mut end = i
				if end > r.pos && load8(h[2]+end-1) == '\r' {
					end -= 1
				}
				let line = rt_str_from_raw(h[2]+r.pos, end-r.pos)
				r.pos = i + 1
				return line, true
			}
		}
		start = r.fill - r.pos
		if !r.more() {
			if r.err != nil {
				fail r.err
			}
			if r.fill > r.pos {
				let h3 = cast(i64, r.buf)
				mut end2 = r.fill
				if load8(h3[2]+end2-1) == '\r' {
					end2 -= 1
				}
				let line2 = rt_str_from_raw(h3[2]+r.pos, end2-r.pos)
				r.pos = r.fill
				return line2, true
			}
			return "", false
		}
	}
}

// Byte returns the next byte; ok is false at the end.
fn (r mut Reader) Byte() (u8, bool) {
	if r.pos >= r.fill && !r.more() {
		return 0, false
	}
	let c = r.buf[r.pos]
	r.pos += 1
	return c, true
}

// Read fills buf with the next buffered bytes, waiting for them, and returns how many it wrote:
// 0 at the end. It is what makes a flume.Reader an io.Reader (ledger.NewStream).
fn (r mut Reader) Read(buf mut []u8) !i64 {
	if len(buf) == 0 {
		return 0
	}
	if r.pos >= r.fill && !r.more() {
		if r.err != nil {
			fail r.err
		}
		return 0
	}
	let n = min(len(buf), r.fill-r.pos)
	copy(buf[0:n], r.buf[r.pos:r.pos+n])
	r.pos += n
	return n
}

// ReadByte returns the next byte; ok is false at the end. It makes a flume.Reader an
// io.ByteReader.
fn (r mut Reader) ReadByte() !(u8, bool) {
	if r.pos >= r.fill && !r.more() {
		if r.err != nil {
			fail r.err
		}
		return 0, false
	}
	let c = r.buf[r.pos]
	r.pos += 1
	return c, true
}

// ReadRune returns the next UTF-8 encoded rune and its size in bytes: size 0 at the end, and
// U+FFFD of size 1 for an invalid encoding, as Go's bufio.Reader does. It makes a flume.Reader an
// io.RuneReader.
fn (r mut Reader) ReadRune() !(i32, i64) {
	for !fullRune(r.buf, r.pos, r.fill) && r.more() {
	}
	if r.pos >= r.fill {
		if r.err != nil {
			fail r.err
		}
		return 0, 0
	}
	let (c, size) = decodeRune(r.buf, r.pos, r.fill)
	r.pos += size
	return c, size
}

// fullRune reports whether b[i:end] starts with a whole encoding, valid or not (Go's
// utf8.FullRune), so ReadRune reads more only for a rune that is cut off.
fn fullRune(b []u8, i i64, end i64) bool {
	let n = end - i
	if n <= 0 {
		return false
	}
	let c = b[i]
	mut need = i64(1)
	mut lo = u8(0x80)
	mut hi = u8(0xbf)
	if c >= 0xc2 && c <= 0xdf {
		need = 2
	} else if c >= 0xe0 && c <= 0xef {
		need = 3
		if c == 0xe0 {
			lo = 0xa0
		} else if c == 0xed {
			hi = 0x9f
		}
	} else if c >= 0xf0 && c <= 0xf4 {
		need = 4
		if c == 0xf0 {
			lo = 0x90
		} else if c == 0xf4 {
			hi = 0x8f
		}
	}
	if n >= need {
		return true
	}
	if n > 1 && (b[i+1] < lo || b[i+1] > hi) {
		return true
	}
	if n > 2 && (b[i+2] < 0x80 || b[i+2] > 0xbf) {
		return true
	}
	return false
}

// decodeRune decodes the rune at b[i:end] like Go's utf8.DecodeRune: (U+FFFD, 1) for an invalid,
// overlong, surrogate or cut-off encoding.
fn decodeRune(b []u8, i i64, end i64) (i32, i64) {
	let c = b[i]
	if c < 0x80 {
		return i32(c), 1
	}
	mut size = i64(0)
	mut lo = u8(0x80)
	mut hi = u8(0xbf)
	mut v = i32(0)
	if c >= 0xc2 && c <= 0xdf {
		size = 2
		v = i32(c & 0x1f)
	} else if c >= 0xe0 && c <= 0xef {
		size = 3
		v = i32(c & 0x0f)
		if c == 0xe0 {
			lo = 0xa0
		} else if c == 0xed {
			hi = 0x9f
		}
	} else if c >= 0xf0 && c <= 0xf4 {
		size = 4
		v = i32(c & 0x07)
		if c == 0xf0 {
			lo = 0x90
		} else if c == 0xf4 {
			hi = 0x8f
		}
	} else {
		return 0xfffd, 1
	}
	if i+size > end {
		return 0xfffd, 1
	}
	let c1 = b[i+1]
	if c1 < lo || c1 > hi {
		return 0xfffd, 1
	}
	v = (v << 6) | i32(c1&0x3f)
	for j in 2..size {
		let cj = b[i+j]
		if cj < 0x80 || cj > 0xbf {
			return 0xfffd, 1
		}
		v = (v << 6) | i32(cj&0x3f)
	}
	return v, size
}

// ReadAll returns everything left.
fn (r mut Reader) ReadAll() !str {
	for r.more() {
	}
	if r.err != nil {
		fail r.err
	}
	let h = cast(i64, r.buf)
	let s = rt_str_from_raw(h[2]+r.pos, r.fill-r.pos)
	r.pos = r.fill
	return s
}

// ReadFile returns the contents of the file at path.
fn ReadFile(path str) !str {
	let r = try Open(path)
	defer r.Close()
	return try r.ReadAll()
}

// NewWriter writes to fd.
fn NewWriter(fd i64) Writer {
	return Writer{open: true, fd: fd, buf: make([]u8, 0, bufSize)}
}

// Stdout writes to standard output (flush it before mixing with say output).
fn Stdout() Writer {
	rt_flush()
	return NewWriter(1)
}

// Create truncates or creates the file at path for writing.
fn Create(path str) !Writer {
	let fd = i64(i32(rt_sys_open(cast(i64, path)+8, O_WRITE_CREATE, 420)))
	if fd < 0 {
		fail errno_fault(path)
	}
	return NewWriter(fd)
}

// CreateExcl creates the file at path for writing (mode 0644) only if nothing exists there yet; two processes
// that race for one path never both succeed, which makes it the basis of lock files.
fn CreateExcl(path str) !Writer {
	let fd = i64(i32(rt_sys_open(cast(i64, path)+8, O_WRITE_EXCL, 420)))
	if fd < 0 {
		fail errno_fault(path)
	}
	return NewWriter(fd)
}

// Sync flushes the writer and waits until the file is on stable storage (fsync; on macOS F_FULLFSYNC).
fn (w mut Writer) Sync() ! {
	try w.Flush()
	if !w.open {
		fail "flume: sync: writer is closed"
	}
	if i64(i32(sysFsync(w.fd))) != 0 {
		fail errno_fault("fsync")
	}
}

// Str appends s.
fn (w mut Writer) Str(s str) {
	if len(w.buf)+len(s) > bufSize && w.Flush() != nil {
		return
	}
	w.buf = append(w.buf, s...)
}

// Byte appends c.
fn (w mut Writer) Byte(c u8) {
	if len(w.buf)+1 > bufSize && w.Flush() != nil {
		return
	}
	w.buf = append(w.buf, c)
}

// Write appends data, flushing first when the buffer would pass 64 KiB, and returns len(data);
// it fails with the writer's fault (a failed flush, or a closed writer). It makes a flume.Writer
// an io.Writer.
fn (w mut Writer) Write(data []u8) !i64 {
	if !w.open {
		fail "flume: write: writer is closed"
	}
	if len(w.buf)+len(data) > bufSize {
		try w.Flush()
	}
	w.buf = append(w.buf, data...)
	return i64(len(data))
}

// WriteString is Write for a str (an io.StringWriter).
fn (w mut Writer) WriteString(s str) !i64 {
	if !w.open {
		fail "flume: write: writer is closed"
	}
	if len(w.buf)+len(s) > bufSize {
		try w.Flush()
	}
	w.buf = append(w.buf, s...)
	return i64(len(s))
}

// WriteByte is Write for one byte (an io.ByteWriter).
fn (w mut Writer) WriteByte(c u8) ! {
	if !w.open {
		fail "flume: write: writer is closed"
	}
	if len(w.buf)+1 > bufSize {
		try w.Flush()
	}
	w.buf = append(w.buf, c)
}

// Int appends v in decimal.
fn (w mut Writer) Int(v i64) {
	w.Str(say.Str(v))
}

// Line appends s and a newline.
fn (w mut Writer) Line(s str) {
	w.Str(s)
	w.Byte('\n')
}

// Flush writes everything buffered (with as few writes as the descriptor allows).
fn (w mut Writer) Flush() ! {
	let h = cast(i64, w.buf)
	mut p = h[2]
	mut n = h[0]
	if n > 0 && !w.open {
		w.err = fail("flume: write: writer is closed")
		n = 0
	}
	for n > 0 {
		let k = rt_sys_write(w.fd, p, n)
		if k < 0 {
			let e = rt_errno()
			if e == 4 {
				continue
			}
			w.err = errno_fault("write")
			break
		}
		p += k
		n -= k
	}
	h[0] = 0
	return try w.err
}

// Close flushes and closes the writer's descriptor once; closing again (or a writer that never opened) is a fault.
fn (w mut Writer) Close() ! {
	if !w.open {
		fail "flume: close: writer is closed"
	}
	mut err = w.Flush()
	let fd = w.fd
	w.open = false
	if i64(i32(rt_sys_close(fd))) < 0 && err == nil {
		err = errno_fault("close")
	}
	if err != nil {
		fail err
	}
}
