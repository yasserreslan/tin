// Package io declares the streaming shapes: a type satisfies Reader, Writer, Closer or
// Seeker by having the methods, with no declaration, and compositions like
// ReadWriteCloser by satisfying every listed shape. The helpers read and write over any
// reader or writer: ReadAll, ReadFull, ReadAtLeast, Copy, CopyN, CopyBuffer, LimitReader,
// TeeReader, MultiReader, MultiWriter, WriteString and Discard. A stream ends when Read
// returns 0 (flume's and ledger's readers do), not with a sentinel fault; ReadByte and
// ReadRune say the same with ok false and size 0.
//
// Pipe connects a writer and a reader on different tasks or cores: it waits through the
// scheduler, never blocking a core, and holds back a writer while it is full. The byte, rune
// and string shapes (ByteReader, ByteScanner, RuneReader, RuneScanner, ByteWriter,
// StringWriter) and ReaderFrom and WriterTo are declared for code that wants them; a generic
// helper cannot ask a value which shapes it has, so Copy always copies through its buffer and a
// caller with a WriterTo calls WriteTo itself. The file system interface (Go's io/fs) is package
// fs. Reading, writing, closing and seeking change the stream, so those methods are mut (#644):
// a type's method may take its receiver mut, and a call through a dyn value needs a mut one
// (w mut dyn io.Writer).
package io

import "say"

// Reader is anything with Read: it fills buf and returns how many bytes it wrote.
shape Reader { mut Read(buf mut []u8) !i64 }

// Writer is anything with Write: it takes data and returns how many bytes it took.
shape Writer { mut Write(data []u8) !i64 }

// Closer is anything with Close.
shape Closer { mut Close() !i64 }

// Seeker is anything with Seek: offset is relative to whence (0 start, 1 current, 2 end).
shape Seeker { mut Seek(offset i64, whence i64) !i64 }

// ReaderAt is a reader that does not move a position: it reads at off.
shape ReaderAt { ReadAt(buf mut []u8, off i64) !i64 }

// WriterAt is a writer that does not move a position: it writes at off.
shape WriterAt { mut WriteAt(data []u8, off i64) !i64 }

// ReadWriter reads and writes.
shape ReadWriter {
	Reader
	Writer
}

// ReadCloser reads and closes.
shape ReadCloser {
	Reader
	Closer
}

// WriteCloser writes and closes.
shape WriteCloser {
	Writer
	Closer
}

// WriteSeeker writes and seeks.
shape WriteSeeker {
	Writer
	Seeker
}

// ReadSeekCloser reads, seeks and closes.
shape ReadSeekCloser {
	Reader
	Seeker
	Closer
}

// ReadWriteCloser reads, writes and closes.
shape ReadWriteCloser {
	Reader
	Writer
	Closer
}

// ReadSeeker reads and seeks.
shape ReadSeeker {
	Reader
	Seeker
}

// ReadWriteSeeker reads, writes and seeks.
shape ReadWriteSeeker {
	Reader
	Writer
	Seeker
}

// ByteReader reads one byte at a time: ok is false at the end of the stream.
shape ByteReader { mut ReadByte() !(u8, bool) }

// ByteScanner is a ByteReader that can step back: UnreadByte makes the next ReadByte return the
// byte the last one returned.
shape ByteScanner {
	ByteReader
	mut UnreadByte() !
}

// ByteWriter writes one byte.
shape ByteWriter { mut WriteByte(c u8) ! }

// RuneReader reads one UTF-8 encoded rune: its value and its size in bytes, size 0 at the end of
// the stream (an invalid encoding is U+FFFD of size 1, as Go's readers give).
shape RuneReader { mut ReadRune() !(i32, i64) }

// RuneScanner is a RuneReader that can step back: UnreadRune makes the next ReadRune return the
// rune the last one returned.
shape RuneScanner {
	RuneReader
	mut UnreadRune() !
}

// StringWriter writes a str without making a []u8 of it, and returns how many bytes it took.
shape StringWriter { mut WriteString(s str) !i64 }

// ReaderFrom reads src until its end into itself and returns how many bytes it took.
shape ReaderFrom { mut ReadFrom(src mut dyn Reader) !i64 }

// WriterTo writes its data to dst until it has none left and returns how many bytes it wrote.
shape WriterTo { mut WriteTo(dst mut dyn Writer) !i64 }

// ---- helpers ----

// ReadAll reads until the stream ends and returns what it read.
fn ReadAll[R Reader](src R) !str {
	mut s = src
	mut out = []u8{}
	mut buf = make([]u8, 512)
	for {
		let n = try s.Read(mut buf)
		if n <= 0 {
			break
		}
		out = append(out, buf[0:n]...)
	}
	return str(out)
}

// ReadFull reads exactly len(buf) bytes; a stream that ends first fails with "unexpected end of
// stream". A zero-length buffer reads nothing.
fn ReadFull[R Reader](src R, buf mut []u8) !i64 {
	return try ReadAtLeast(src, mut buf, len(buf))
}

// ReadAtLeast reads at least min bytes (or until the stream ends) into buf; fewer than min bytes
// is the "unexpected end of stream" fault.
fn ReadAtLeast[R Reader](src R, buf mut []u8, min i64) !i64 {
	if min > i64(len(buf)) {
		fail say.Fault("io: ReadAtLeast: %d bytes do not fit a buffer of %d", min, len(buf))
	}
	mut s = src
	mut n = i64(0)
	for n < min {
		mut rest = buf[n:len(buf)]
		let k = try s.Read(mut rest)
		if k <= 0 {
			break
		}
		n += k
	}
	if n < min {
		fail say.Fault("io: unexpected end of stream: %d of %d bytes", n, min)
	}
	return n
}

// Copy reads from src and writes every chunk to dst until the stream ends, and returns how many
// bytes it copied. The scratch buffer is 32 KiB, as Go's is, taken from this core's pool of them
// and given back when Copy returns, so a loop of copies allocates nothing; a Reader must not keep
// the buffer it is given (Go's rule too).
fn Copy[W Writer, R Reader](dst W, src R) !i64 {
	let raw = copyTake()
	defer copyGive(raw)
	mut buf = copyView(raw)
	return try CopyBuffer(dst, src, mut buf)
}

// copySize is Copy's buffer size, Go's.
const copySize = 32768

// copyMax is how many Copy buffers a core keeps: more copies at once on one core (tasks that wait
// inside Copy) use request memory for theirs.
const copyMax = 4

// copyFree is this core's stack of free Copy buffers (copyMax words, made once in the ingot heap),
// copyTop how many it holds and copyMade how many buffers this core has made.
mut copyFree i64
mut copyTop i64
mut copyMade i64

// copyTake is a free 32 KiB ingot block of this core's Copy pool, or 0 when all are in use.
fn copyTake() i64 {
	if copyTop > 0 {
		copyTop -= 1
		return (copyFree + 8*copyTop)[0]
	}
	if copyMade >= copyMax {
		return 0
	}
	if copyFree == 0 {
		copyFree = rt_ingot_alloc(8 * copyMax)
	}
	copyMade += 1
	return rt_ingot_alloc(copySize)
}

// copyGive returns a block copyTake gave to the pool (0: none was taken).
fn copyGive(raw i64) {
	if raw == 0 {
		return
	}
	(copyFree + 8*copyTop)[0] = raw
	copyTop += 1
}

// copyView is a []u8 over the block raw (a slice header in request memory, the data in the ingot
// heap), or a fresh request-memory buffer when raw is 0.
fn copyView(raw i64) []u8 {
	if raw == 0 {
		return make([]u8, copySize)
	}
	let h = rt_alloc(32)
	h[0] = copySize
	h[1] = copySize
	h[2] = raw
	h[3] = 1
	return cast([]u8, h)
}

// CopyBuffer is Copy with the caller's scratch buffer, which must not be empty.
fn CopyBuffer[W Writer, R Reader](dst W, src R, buf mut []u8) !i64 {
	if len(buf) == 0 {
		fail say.Fault("io: CopyBuffer: the buffer is empty")
	}
	mut d = dst
	mut s = src
	mut total = i64(0)
	for {
		let n = try s.Read(mut buf)
		if n <= 0 {
			break
		}
		let chunk = buf[0:n]
		let k = try d.Write(chunk)
		if k != n {
			fail say.Fault("io: short write: %d of %d bytes", k, n)
		}
		total += n
	}
	return total
}

// CopyN copies exactly n bytes; fewer means the stream ended first, which is the "unexpected end
// of stream" fault.
fn CopyN[W Writer, R Reader](dst W, src R, n i64) !i64 {
	mut s = src
	let limited = LimitReader(s, n)
	mut d = dst
	let k = try Copy(d, limited)
	if k < n {
		fail say.Fault("io: unexpected end of stream: %d of %d bytes", k, n)
	}
	return k
}

// WriteString writes s to dst.
fn WriteString[W Writer](dst W, s str) !i64 {
	mut d = dst
	return try d.Write([]u8(s))
}

// LimitedReader reads at most n bytes from r; it is what LimitReader returns.
type LimitedReader[R Reader] struct {
	r R
	n i64
}

// LimitReader returns a reader that yields at most n bytes of src and then ends.
fn LimitReader[R Reader](src R, n i64) LimitedReader[R] {
	return LimitedReader[R]{r: src, n: n}
}

// Left returns how many bytes the limit has left.
fn (l LimitedReader[R]) Left() i64 {
	return l.n
}

// Read reads at most what the limit has left; it returns 0 once the limit is reached.
fn (l mut LimitedReader[R]) Read(buf mut []u8) !i64 {
	if l.n <= 0 {
		return 0
	}
	mut b = buf
	if i64(len(b)) > l.n {
		b = buf[0:l.n]
	}
	let k = try l.r.Read(mut b)
	if k > 0 {
		l.n -= k
	}
	return k
}

// TeeReader reads from r and writes what it read to w, like Go's TeeReader.
type TeeReader[R Reader, W Writer] struct {
	r R
	w W
}

// NewTeeReader returns a reader that writes everything it reads from src to dst.
fn NewTeeReader[R Reader, W Writer](src R, dst W) TeeReader[R, W] {
	return TeeReader[R, W]{r: src, w: dst}
}

// Read reads from the underlying reader and writes the same bytes to the tee.
fn (t mut TeeReader[R, W]) Read(buf mut []u8) !i64 {
	let k = try t.r.Read(mut buf)
	if k <= 0 {
		return k
	}
	let wrote = try t.w.Write(buf[0:k])
	if wrote != k {
		fail say.Fault("io: short write: %d of %d bytes", wrote, k)
	}
	return k
}

// MultiReader reads several readers in turn, as one stream; it is what NewMultiReader returns
// and takes dyn values, so the readers may have different types.
type MultiReader struct {
	rs []dyn Reader
	at i64
}

// NewMultiReader reads the readers in order.
fn NewMultiReader(rs []dyn Reader) MultiReader {
	return MultiReader{rs: rs, at: 0}
}

// Read reads from the current reader; when one ends, the next is used, and the last one's end is
// the stream's end.
fn (m mut MultiReader) Read(buf mut []u8) !i64 {
	for m.at < i64(len(m.rs)) {
		mut r = m.rs[m.at]
		let k = try r.Read(mut buf)
		if k > 0 {
			return k
		}
		m.at += 1
	}
	return 0
}

// MultiWriter writes to every writer in turn; it is what NewMultiWriter returns and takes dyn
// values, so the writers may have different types.
type MultiWriter struct {
	ws []dyn Writer
}

// NewMultiWriter writes each chunk to every writer, and fails when one takes less than all of it.
fn NewMultiWriter(ws []dyn Writer) MultiWriter {
	return MultiWriter{ws: ws}
}

// Write writes data to every writer.
fn (m mut MultiWriter) Write(data []u8) !i64 {
	for i in 0..len(m.ws) {
		mut w = m.ws[i]
		let k = try w.Write(data)
		if k != i64(len(data)) {
			fail say.Fault("io: short write: %d of %d bytes", k, len(data))
		}
	}
	return i64(len(data))
}

// DiscardWriter is a writer that throws everything away, like Go's io.Discard.
type DiscardWriter struct{}

// Discard returns the writer that throws everything away.
fn Discard() DiscardWriter {
	return DiscardWriter{}
}

// Write takes data and reports all of it written.
fn (d mut DiscardWriter) Write(data []u8) !i64 {
	return i64(len(data))
}
