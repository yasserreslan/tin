package quarry

fn hostName(buf i64, n i64) i64 {
	let uts = calloc(1, 390)
	mut result = rt_sys_uname(uts)
	if result == 0 {
		let length = strlen(uts+65)
		mut copy = length+1
		if n < copy { copy = n }
		if copy > 0 { memcpy(buf, uts+65, copy) }
		if n <= length { linux_set_errno(36)
			result = -1 }
	}
	free(uts)
	return result
}
