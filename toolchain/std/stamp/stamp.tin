// Package stamp computes non-cryptographic hashes and checksums: FNV-1a, CRC-32 (IEEE and
// Castagnoli, slicing-by-8), Adler-32, xxHash64, and Hash, a fast 64-bit hash for tables.
package stamp

const ieeePoly = 0xedb88320
const castagnoliPoly = 0x82f63b78

let ieee []u32 = crc_tables(ieeePoly)
let castagnoli []u32 = crc_tables(castagnoliPoly)

// crc_tables builds the 8 slicing tables (8 x 256 entries) for a reflected polynomial.
fn crc_tables(poly u32) []u32 {
	let t = make([]u32, 2048)
	for i in 0..256 {
		mut c = u32(i)
		for k in 0..8 {
			if c&1 != 0 {
				c = (c >> 1) ^ poly
			} else {
				c >>= 1
			}
		}
		t[i] = c
	}
	for i in 0..256 {
		mut c = t[i]
		for s in 1..8 {
			c = t[i64(c&255)] ^ (c >> 8)
			t[s*256+i] = c
		}
	}
	return t
}

fn crc_update(crc u32, t []u32, s str) u32 {
	mut c = ^crc
	let p = cast(i64, s) + 8
	let n = len(s)
	mut i = 0
	for i+8 <= n {
		let lo = u32(__ld(p+i, 2)) ^ c
		let hi = u32(__ld(p+i+4, 2))
		c = t[7*256+i64(lo&255)] ^ t[6*256+i64((lo>>8)&255)] ^ t[5*256+i64((lo>>16)&255)] ^ t[4*256+i64(lo>>24)] ^ t[3*256+i64(hi&255)] ^ t[2*256+i64((hi>>8)&255)] ^ t[256+i64((hi>>16)&255)] ^ t[i64(hi>>24)]
		i += 8
	}
	for i < n {
		c = t[i64((c^u32(load8(p+i)))&255)] ^ (c >> 8)
		i += 1
	}
	return ^c
}

// Crc32 is the IEEE CRC-32 of s (as in zip, gzip and PNG).
fn Crc32(s str) u32 {
	return crc_update(0, ieee, s)
}

// Crc32Update continues an IEEE CRC-32 over more data.
fn Crc32Update(crc u32, s str) u32 {
	return crc_update(crc, ieee, s)
}

// Crc32C is the Castagnoli CRC-32 of s (as in iSCSI, ext4 and many databases).
fn Crc32C(s str) u32 {
	return crc_update(0, castagnoli, s)
}

// Fnv32a is the 32-bit FNV-1a hash of s.
fn Fnv32a(s str) u32 {
	mut h = u32(2166136261)
	for i in 0..len(s) {
		h ^= u32(s[i])
		h *%= 16777619
	}
	return h
}

// Fnv64a is the 64-bit FNV-1a hash of s.
fn Fnv64a(s str) u64 {
	mut h = u64(14695981039346656037)
	for i in 0..len(s) {
		h ^= u64(s[i])
		h *%= 1099511628211
	}
	return h
}

// Adler32 is the Adler-32 checksum of s (as in zlib).
fn Adler32(s str) u32 {
	mut a = u64(1)
	mut b = u64(0)
	mut i = 0
	let n = len(s)
	for i < n {
		// 5552 bytes is the most that can be summed before the 32-bit reduction.
		mut end = i + 5552
		if end > n {
			end = n
		}
		for i < end {
			a += u64(s[i])
			b += a
			i += 1
		}
		a %= 65521
		b %= 65521
	}
	return u32(b<<16 | a)
}

const p1 = 11400714785074694791
const p2 = 14029467366897019727
const p3 = 1609587929392839161
const p4 = 9650029242287828579
const p5 = 2870177450012600261

fn rotl(x u64, r u64) u64 {
	return (x << r) | (x >> (64 - r))
}

// xround, xmerge and Xxh64 compute modulo 2^64 (#362).
@wrap fn xround(acc u64, v u64) u64 {
	acc += v * p2
	acc = rotl(acc, 31)
	return acc * p1
}

@wrap fn xmerge(acc u64, v u64) u64 {
	acc ^= xround(0, v)
	return acc*p1 + p4
}

// Xxh64 is the xxHash64 of s with seed.
@wrap fn Xxh64(s str, seed u64) u64 {
	let p = cast(i64, s) + 8
	let n = len(s)
	mut i = 0
	mut h = u64(0)
	if n >= 32 {
		mut v1 = seed + p1 + p2
		mut v2 = seed + p2
		mut v3 = seed
		mut v4 = seed - p1
		for i+32 <= n {
			v1 = xround(v1, u64(__ld(p+i, 3)))
			v2 = xround(v2, u64(__ld(p+i+8, 3)))
			v3 = xround(v3, u64(__ld(p+i+16, 3)))
			v4 = xround(v4, u64(__ld(p+i+24, 3)))
			i += 32
		}
		h = rotl(v1, 1) + rotl(v2, 7) + rotl(v3, 12) + rotl(v4, 18)
		h = xmerge(h, v1)
		h = xmerge(h, v2)
		h = xmerge(h, v3)
		h = xmerge(h, v4)
	} else {
		h = seed + p5
	}
	h += u64(n)
	for i+8 <= n {
		h ^= xround(0, u64(__ld(p+i, 3)))
		h = rotl(h, 27)*p1 + p4
		i += 8
	}
	if i+4 <= n {
		h ^= u64(u32(__ld(p+i, 2))) * p1
		h = rotl(h, 23)*p2 + p3
		i += 4
	}
	for i < n {
		h ^= u64(load8(p+i)) * p5
		h = rotl(h, 11) * p1
		i += 1
	}
	h ^= h >> 33
	h *= p2
	h ^= h >> 29
	h *= p3
	h ^= h >> 32
	return h
}

// Hash is a fast, well-mixed 64-bit hash for hash tables (not stable across versions).
fn Hash(s str) u64 {
	return Xxh64(s, 0x9e3779b97f4a7c15)
}

// ---- CRC-64 ----

// crc64_table builds the 256-entry table of a reflected polynomial, as Go's crc64.MakeTable
// does (the low bits of the running crc are shifted out first).
fn crc64_table(poly u64) []u64 {
	let t = make([]u64, 256)
	for i in 0..256 {
		mut crc = u64(i)
		for j in 0..8 {
			if crc&1 != 0 {
				crc = (crc >> 1) ^ poly
			} else {
				crc >>= 1
			}
		}
		t[i] = crc
	}
	return t
}

// crc64PolyECMA is the ECMA-182 polynomial in Go's reflected form (crc64.ECMA).
const crc64PolyECMA = 0xc96c5795d7870f42
// crc64PolyISO is the ISO polynomial (Go's crc64.ISO).
const crc64PolyISO = 0xd800000000000000

let crc64ECMA []u64 = crc64_table(crc64PolyECMA)
let crc64ISO []u64 = crc64_table(crc64PolyISO)

// crc64_update continues a CRC-64 over more data, as Go's crc64.Update does.
fn crc64_update(crc u64, t []u64, s str) u64 {
	mut c = ^crc
	let p = cast(i64, s) + 8
	for i in 0..len(s) {
		// The index is the low byte of the running crc exclusive-ored with the data byte.
		c = t[i64((c^u64(load8(p+i)))&255)] ^ (c >> 8)
	}
	return ^c
}

// Crc64ECMA is the ECMA-182 CRC-64 of s (as in XZ and Go's crc64.ECMA).
fn Crc64ECMA(s str) u64 {
	return crc64_update(0, crc64ECMA, s)
}

// Crc64ECMAUpdate continues an ECMA-182 CRC-64 over more data.
fn Crc64ECMAUpdate(crc u64, s str) u64 {
	return crc64_update(crc, crc64ECMA, s)
}

// Crc64ISO is the ISO CRC-64 of s (Go's crc64.ISO).
fn Crc64ISO(s str) u64 {
	return crc64_update(0, crc64ISO, s)
}

// Crc64ISOUpdate continues an ISO CRC-64 over more data.
fn Crc64ISOUpdate(crc u64, s str) u64 {
	return crc64_update(crc, crc64ISO, s)
}

// ---- a seeded hash for map keys ----

// MapHash is a fast seeded 64-bit hash of s, for spreading keys of a table one builds oneself.
// It is not a cryptographic hash, and it is not Go's hash/maphash (whose algorithm is not
// specified and whose seed is random): two runs with the same seed and the same bytes agree, and
// different seeds give unrelated hashes.
fn MapHash(seed u64, s str) u64 {
	let mix = u64(0x9e3779b97f4a7c15)
	mut h = seed ^ (u64(len(s)) *% mix)
	let p = cast(i64, s) + 8
	mut i = 0
	for i+8 <= len(s) {
		h ^= u64(__ld(p+i, 8))
		h = (h *% mix) ^ (h >> 29)
		i += 8
	}
	mut tail = u64(0)
	for i < len(s) {
		tail = (tail << 8) | u64(load8(p+i))
		i += 1
	}
	h ^= tail
	h ^= h >> 33
	h *%= 0xff51afd7ed558ccd
	h ^= h >> 33
	h *%= 0xc4ceb9fe1a85ec53
	h ^= h >> 33
	return h
}
