package glyph

// UTF-16, as Go's unicode/utf16: the code units Windows, Java and many protocols use. A rune above
// 0xFFFF is a surrogate pair, and a lone or stray surrogate is a replacement character.

// The surrogate range: 0xd800 to 0xdc00 encodes the high ten bits of a pair, 0xdc00 to 0xe000 the
// low ten, and the value is those twenty bits plus 0x10000.
const surr1 = 0xd800
const surr2 = 0xdc00
const surr3 = 0xe000
const surrSelf = 0x10000

// Utf16IsSurrogate reports whether r is a surrogate code point, which no string may contain.
fn Utf16IsSurrogate(r i32) bool {
	return r >= surr1 && r < surr3
}

// Utf16DecodeRune joins a surrogate pair into one rune, or returns RuneError when r1 and r2 are not
// a valid pair (as Go's utf16.DecodeRune).
fn Utf16DecodeRune(r1 i32, r2 i32) i32 {
	if r1 >= surr1 && r1 < surr2 && r2 >= surr2 && r2 < surr3 {
		return ((r1-surr1)<<10 | (r2 - surr2)) + surrSelf
	}
	return RuneError
}

// Utf16EncodeRune splits r into a surrogate pair. A rune that is not above 0xFFFF (which needs no
// pair) or not a valid code point gives RuneError twice, as Go's utf16.EncodeRune.
fn Utf16EncodeRune(r i32) (i32, i32) {
	if r < surrSelf || r > MaxRune {
		return RuneError, RuneError
	}
	let v = r - surrSelf
	return surr1 + (v>>10)&0x3ff, surr2 + v&0x3ff
}

// Utf16RuneLen returns the number of UTF-16 code units r needs, or -1 when r is not a valid rune
// (a surrogate or above MaxRune), as Go's utf16.RuneLen.
fn Utf16RuneLen(r i32) i64 {
	if (r >= 0 && r < surr1) || (r >= surr3 && r < surrSelf) {
		return 1
	}
	if r >= surrSelf && r <= MaxRune {
		return 2
	}
	return -1
}

// Utf16AppendRune appends the UTF-16 code units of r to a: one for a rune up to 0xFFFF that is not a
// surrogate, two for one above, and RuneError for anything else, as Go's utf16.AppendRune.
fn Utf16AppendRune(a mut []u16, r i32) []u16 {
	if (r >= 0 && r < surr1) || (r >= surr3 && r < surrSelf) {
		append(a, u16(r))
		return a
	}
	if r >= surrSelf && r <= MaxRune {
		let (r1, r2) = Utf16EncodeRune(r)
		append(a, u16(r1))
		append(a, u16(r2))
		return a
	}
	append(a, u16(RuneError))
	return a
}

// Utf16Encode returns the UTF-16 code units of s: one or two per rune, as Go's utf16.Encode over the
// string's runes. Invalid UTF-8 decodes to RuneError, as in Go.
fn Utf16Encode(s str) []u16 {
	mut out = []u16{}
	mut i = i64(0)
	for i < len(s) {
		let (r, size) = DecodeRune(s, i)
		Utf16AppendRune(mut out, r)
		i += size
	}
	return out
}

// Utf16Decode returns the string of the code units, as Go's utf16.Decode: a high surrogate followed
// by a low one is one rune, and a lone surrogate is RuneError.
fn Utf16Decode(u []u16) str {
	mut out = []u8{}
	mut i = i64(0)
	for i < i64(len(u)) {
		let unit = i32(u[i])
		mut r = unit
		if unit >= surr1 && unit < surr2 && i+1 < i64(len(u)) && i32(u[i+1]) >= surr2 && i32(u[i+1]) < surr3 {
			r = Utf16DecodeRune(unit, i32(u[i+1]))
			i += 1
		} else if unit >= surr1 && unit < surr3 {
			r = RuneError
		}
		EncodeRune(mut out, r)
		i += 1
	}
	return str(out)
}
