package glyph

// ---- range tables ----

// rd3 reads the 3-byte little-endian number at byte i of data.
fn rd3(data str, i i64) i64 {
	return i64(data[i]) | i64(data[i+1])<<8 | i64(data[i+2])<<16
}

// inRanges reports whether r is in the packed range table data (8 bytes per range: low, high,
// stride), by binary search.
fn inRanges(data str, r i64) bool {
	mut lo = 0
	mut hi = len(data) / 8
	for lo < hi {
		let m = (lo + hi) >> 1
		let at = m * 8
		let first = rd3(data, at)
		if r < first {
			hi = m
		} else if r > rd3(data, at+3) {
			lo = m + 1
		} else {
			let stride = i64(data[at+6]) | i64(data[at+7])<<8
			return stride == 1 || (r-first)%stride == 0
		}
	}
	return false
}

// TableRanges returns the table's code points as low, high pairs, with strides expanded, for a
// caller that builds its own classes (lasso's \p{...}).
fn TableRanges(t Table) []i64 {
	let data = tableData(t)
	mut out = []i64{}
	mut i = 0
	for i+8 <= len(data) {
		let lo = rd3(data, i)
		let hi = rd3(data, i+3)
		let stride = i64(data[i+6]) | i64(data[i+7])<<8
		if stride <= 1 {
			out = append(out, lo, hi)
		} else {
			mut r = lo
			for r <= hi {
				out = append(out, r, r)
				r += stride
			}
		}
		i += 8
	}
	return out
}

// Is reports whether r is in the set t.
fn Is(t Table, r i32) bool {
	return inRanges(tableData(t), i64(r))
}

// IsOneOf reports whether r is in any of the sets.
fn IsOneOf(sets []Table, r i32) bool {
	for _, t in sets {
		if inRanges(tableData(t), i64(r)) {
			return true
		}
	}
	return false
}

// ---- classification ----

// IsLetter reports whether r is a letter (category L).
fn IsLetter(r i32) bool {
	if r < 0x80 {
		return r >= 'a' && r <= 'z' || r >= 'A' && r <= 'Z'
	}
	return inRanges(t_L, i64(r))
}

// IsDigit reports whether r is a decimal digit (category Nd).
fn IsDigit(r i32) bool {
	if r < 0x80 {
		return r >= '0' && r <= '9'
	}
	return inRanges(t_Nd, i64(r))
}

// IsNumber reports whether r is a number (category N).
fn IsNumber(r i32) bool {
	if r < 0x80 {
		return r >= '0' && r <= '9'
	}
	return inRanges(t_N, i64(r))
}

// IsSpace reports whether r is white space as Unicode defines it (property White_Space): tab, line
// feed, vertical tab, form feed, carriage return, space, U+0085, U+00A0 and the Unicode space separators.
fn IsSpace(r i32) bool {
	if r < 0x100 {
		return r == ' ' || r >= '\t' && r <= '\r' || r == 0x85 || r == 0xa0
	}
	return inRanges(t_White_Space, i64(r))
}

// IsUpper reports whether r is an upper-case letter (category Lu).
fn IsUpper(r i32) bool {
	if r < 0x80 {
		return r >= 'A' && r <= 'Z'
	}
	return inRanges(t_Lu, i64(r))
}

// IsLower reports whether r is a lower-case letter (category Ll).
fn IsLower(r i32) bool {
	if r < 0x80 {
		return r >= 'a' && r <= 'z'
	}
	return inRanges(t_Ll, i64(r))
}

// IsTitle reports whether r is a title-case letter (category Lt).
fn IsTitle(r i32) bool {
	if r < 0x80 {
		return false
	}
	return inRanges(t_Lt, i64(r))
}

// IsMark reports whether r is a mark (category M).
fn IsMark(r i32) bool {
	if r < 0x300 {
		return false
	}
	return inRanges(t_M, i64(r))
}

// IsPunct reports whether r is punctuation (category P).
fn IsPunct(r i32) bool {
	return inRanges(t_P, i64(r))
}

// IsSymbol reports whether r is a symbol (category S).
fn IsSymbol(r i32) bool {
	return inRanges(t_S, i64(r))
}

// IsControl reports whether r is a control character: U+0000 to U+001F and U+007F to U+009F.
fn IsControl(r i32) bool {
	return r >= 0 && r < 0x20 || r >= 0x7f && r < 0xa0
}

// IsGraphic reports whether r is a letter, mark, number, punctuation, symbol or space separator.
fn IsGraphic(r i32) bool {
	if r < 0x80 {
		return r >= 0x20 && r < 0x7f
	}
	let x = i64(r)
	return inRanges(t_L, x) || inRanges(t_M, x) || inRanges(t_N, x) || inRanges(t_P, x) || inRanges(t_S, x) || inRanges(t_Zs, x)
}

// IsPrint reports whether r is printable: a letter, mark, number, punctuation or symbol, or the
// ASCII space (no other space is).
fn IsPrint(r i32) bool {
	if r < 0x80 {
		return r >= 0x20 && r < 0x7f
	}
	let x = i64(r)
	return inRanges(t_L, x) || inRanges(t_M, x) || inRanges(t_N, x) || inRanges(t_P, x) || inRanges(t_S, x)
}

// ---- case ----

// The case a rune is mapped to by To.
const UpperCase = 0
const LowerCase = 1
const TitleCase = 2

// caseEntry is the width of one entry of caseData: low, high (3 bytes each), three 4-byte deltas.
const caseEntry = 18

// rd4s reads the signed 4-byte little-endian number at byte i of data.
fn rd4s(data str, i i64) i64 {
	let v = i64(data[i]) | i64(data[i+1])<<8 | i64(data[i+2])<<16 | i64(data[i+3])<<24
	if v >= 1<<31 {
		return v - 1<<32
	}
	return v
}

// To maps r to the given case (UpperCase, LowerCase or TitleCase); a rune without a mapping is
// returned unchanged.
fn To(which i64, r i32) i32 {
	if which < 0 || which > 2 {
		return RuneError
	}
	let x = i64(r)
	mut lo = 0
	mut hi = len(caseData) / caseEntry
	for lo < hi {
		let m = (lo + hi) >> 1
		let at = m * caseEntry
		let first = rd3(caseData, at)
		if x < first {
			hi = m
		} else if x > rd3(caseData, at+3) {
			lo = m + 1
		} else {
			let delta = rd4s(caseData, at+6+which*4)
			if delta > MaxRune {
				// An upper/lower sequence starts with an upper-case letter: the even offsets are
				// upper case and the odd ones lower, and the low bit of which (0 upper, 1 lower,
				// 2 title) picks the member.
				return i32(first + ((x-first)&^1 | which&1))
			}
			return i32(x + delta)
		}
	}
	return r
}

// ToUpper maps r to upper case.
fn ToUpper(r i32) i32 {
	if r < 0x80 {
		if r >= 'a' && r <= 'z' {
			return r - 32
		}
		return r
	}
	return To(UpperCase, r)
}

// ToLower maps r to lower case.
fn ToLower(r i32) i32 {
	if r < 0x80 {
		if r >= 'A' && r <= 'Z' {
			return r + 32
		}
		return r
	}
	return To(LowerCase, r)
}

// ToTitle maps r to title case.
fn ToTitle(r i32) i32 {
	if r < 0x80 {
		if r >= 'a' && r <= 'z' {
			return r - 32
		}
		return r
	}
	return To(TitleCase, r)
}

// SimpleFold iterates over the code points that are equivalent under simple case folding: it returns
// the smallest rune greater than r in r's orbit, or the smallest one when there is none ('K' gives
// 'k', 'k' gives U+212A, U+212A gives 'K').
fn SimpleFold(r i32) i32 {
	if r < 0 || r > MaxRune {
		return r
	}
	let x = i64(r)
	mut lo = 0
	mut hi = len(orbitData) / 6
	for lo < hi {
		let m = (lo + hi) >> 1
		if rd3(orbitData, m*6) < x {
			lo = m + 1
		} else {
			hi = m
		}
	}
	if lo < len(orbitData)/6 && rd3(orbitData, lo*6) == x {
		return i32(rd3(orbitData, lo*6+3))
	}
	let l = ToLower(r)
	if l != r {
		return l
	}
	return ToUpper(r)
}
