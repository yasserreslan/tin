package abacus

// Exp returns a**e, or a**e mod |m| when m is not zero, like Go's Exp: the sign of m is ignored,
// e <= 0 gives 1 for a plain power, and a negative exponent with a modulus uses the base's
// modular inverse (panicking when there is none, where Go returns nil).
fn (a Int) Exp(e Int, m Int) Int {
	if m.IsZero() {
		if e.Sign() <= 0 {
			return Int{neg: false, limbs: []u64{1}}
		}
		return a.pow(e)
	}
	let mod = m.Abs()
	if mod.Cmp(Int{neg: false, limbs: []u64{1}}) == 0 {
		return zeroInt()
	}
	mut baseIn = a
	if e.Sign() < 0 {
		// x**y mod m with y < 0 is (x**-1)**|y| mod m.
		let inv = a.ModInverse(mod)
		if inv == nil {
			panic("abacus: Exp: the base has no inverse modulo the modulus")
		}
		baseIn = inv
	}
	let (_, base0) = baseIn.DivMod(mod)
	mut base = base0
	mut result = Int{neg: false, limbs: []u64{1}}
	mut ee = e.Abs()
	for !ee.IsZero() {
		if ee.limbs[0]&1 == 1 {
			let (_, r) = result.Mul(base).DivMod(mod)
			result = r
		}
		ee = half(ee)
		if !ee.IsZero() {
			let (_, r2) = base.Mul(base).DivMod(mod)
			base = r2
		}
	}
	return result
}

// pow returns a**e for e > 0 by repeated squaring.
fn (a Int) pow(e Int) Int {
	mut base = a
	mut result = Int{neg: false, limbs: []u64{1}}
	mut ee = e
	for !ee.IsZero() {
		if ee.limbs[0]&1 == 1 {
			result = result.Mul(base)
		}
		ee = half(ee)
		if !ee.IsZero() {
			base = base.Mul(base)
		}
	}
	return result
}
