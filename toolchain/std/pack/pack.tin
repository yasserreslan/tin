package pack

// Package pack packs numbers into byte buffers and reads them back: the little-endian and
// big-endian orders and the varints of Go's encoding/binary. Everything writes into a buffer the
// caller owns, so nothing allocates.
//
//	pack.LE.PutU32(buf, 0x01020304)         // buf[0] = 4, buf[1] = 3, ...
//	pack.BE.PutU64(buf, 42)
//	let v = pack.LE.U32(buf)                // reads buf[0:4]; it panics when the buffer is short,
//	let w = pack.BE.U64(buf)                // like Go's binary.LittleEndian.Uint32
//	buf = pack.LE.AppendU16(buf, 7)         // append instead of write
//	buf = pack.PutUvarint(buf, 300)         // 300 -> 0xac 0x02
//	let (n, size) = try pack.Uvarint(buf)   // n = 300, size = 2
//
// A varint that is cut off or overflows ten bytes fails with a fault, like Go's Uvarint reports
// it, instead of returning a value.

import "say"

// Order is a byte order: LittleEndian or BigEndian.
type Order struct {
	big bool
}

// LE is the little-endian order and BE the big-endian one.
let LE = Order{big: false}
let BE = Order{big: true}

// Size is the number of bytes U16, U32 and U64 read, and PutU16, PutU32 and PutU64 write.
const Size16 = 2
const Size32 = 4
const Size64 = 8

// U16 reads a u16.
fn (o Order) U16(b []u8) u16 {
	if len(b) < Size16 {
		panic("pack: U16 of a short buffer")
	}
	if o.big {
		return u16(b[0])<<8 | u16(b[1])
	}
	return u16(b[0]) | u16(b[1])<<8
}

// U32 reads a u32.
fn (o Order) U32(b []u8) u32 {
	if len(b) < Size32 {
		panic("pack: U32 of a short buffer")
	}
	if o.big {
		return u32(b[0])<<24 | u32(b[1])<<16 | u32(b[2])<<8 | u32(b[3])
	}
	return u32(b[0]) | u32(b[1])<<8 | u32(b[2])<<16 | u32(b[3])<<24
}

// U64 reads a u64.
fn (o Order) U64(b []u8) u64 {
	if len(b) < Size64 {
		panic("pack: U64 of a short buffer")
	}
	if o.big {
		return u64(b[0])<<56 | u64(b[1])<<48 | u64(b[2])<<40 | u64(b[3])<<32 |
			u64(b[4])<<24 | u64(b[5])<<16 | u64(b[6])<<8 | u64(b[7])
	}
	return u64(b[0]) | u64(b[1])<<8 | u64(b[2])<<16 | u64(b[3])<<24 |
		u64(b[4])<<32 | u64(b[5])<<40 | u64(b[6])<<48 | u64(b[7])<<56
}

// PutU16 writes v into the first two bytes of b, which must be long enough.
fn (o Order) PutU16(b mut []u8, v u16) {
	if len(b) < Size16 {
		panic("pack: PutU16 into a short buffer")
	}
	if o.big {
		b[0] = u8(v >> 8)
		b[1] = u8(v)
	} else {
		b[0] = u8(v)
		b[1] = u8(v >> 8)
	}
}

// PutU32 writes v into the first four bytes of b, which must be long enough.
fn (o Order) PutU32(b mut []u8, v u32) {
	if len(b) < Size32 {
		panic("pack: PutU32 into a short buffer")
	}
	if o.big {
		b[0] = u8(v >> 24)
		b[1] = u8(v >> 16)
		b[2] = u8(v >> 8)
		b[3] = u8(v)
	} else {
		b[0] = u8(v)
		b[1] = u8(v >> 8)
		b[2] = u8(v >> 16)
		b[3] = u8(v >> 24)
	}
}

// PutU64 writes v into the first eight bytes of b, which must be long enough.
fn (o Order) PutU64(b mut []u8, v u64) {
	if len(b) < Size64 {
		panic("pack: PutU64 into a short buffer")
	}
	if o.big {
		mut i = 0
		for i < 8 {
			b[i] = u8(v >> u64((7-i)*8))
			i += 1
		}
	} else {
		mut i = 0
		for i < 8 {
			b[i] = u8(v >> u64(i*8))
			i += 1
		}
	}
}

// AppendU16 appends v to b.
fn (o Order) AppendU16(b mut []u8, v u16) []u8 {
	mut out = append(b, 0, 0)
	o.PutU16(mut out[len(out)-Size16:len(out)], v)
	return out
}

// AppendU32 appends v to b.
fn (o Order) AppendU32(b mut []u8, v u32) []u8 {
	mut out = append(b, 0, 0, 0, 0)
	o.PutU32(mut out[len(out)-Size32:len(out)], v)
	return out
}

// AppendU64 appends v to b.
fn (o Order) AppendU64(b mut []u8, v u64) []u8 {
	mut out = append(b, 0, 0, 0, 0, 0, 0, 0, 0)
	o.PutU64(mut out[len(out)-Size64:len(out)], v)
	return out
}

// PutUvarint appends v in the variable-length form and returns the longer buffer: seven bits a
// byte, the high bit set while more follow, at most ten bytes.
fn PutUvarint(b mut []u8, v u64) []u8 {
	mut out = b
	mut x = v
	for x >= 0x80 {
		out = append(out, u8(x)|0x80)
		x = x >> 7
	}
	return append(out, u8(x))
}

// Uvarint reads a variable-length unsigned integer and returns it with the number of bytes it
// took. A cut-off or over-long encoding fails with a fault.
fn Uvarint(b []u8) !(u64, i64) {
	mut x = u64(0)
	mut s = u64(0)
	mut i = i64(0)
	for i < len(b) {
		if i == 10 {
			fail say.Fault("pack: varint overflows ten bytes")
		}
		let c = b[i]
		if c < 0x80 {
			if i == 9 && c > 1 {
				fail say.Fault("pack: varint overflows uint64")
			}
			return x | u64(c)<<s, i + 1
		}
		x = x | u64(c&0x7f)<<s
		s += 7
		i += 1
	}
	fail say.Fault("pack: varint is cut off")
}

// PutVarint appends v in the zigzag varint form (Go's Varint): small magnitudes take few bytes,
// negative numbers too.
fn PutVarint(b mut []u8, v i64) []u8 {
	let u = (u64(v) << 1) ^ u64(v >> 63)
	return PutUvarint(mut b, u)
}

// Varint reads a zigzag varint and returns it with the number of bytes it took.
fn Varint(b []u8) !(i64, i64) {
	let (u, n) = try Uvarint(b)
	return i64(u>>1) ^ -i64(u&1), n
}
