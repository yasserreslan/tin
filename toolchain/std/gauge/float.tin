package gauge

// pow10tab holds 1e0 .. 1e31; the two coarse tables hold every 32nd power, as in Go's math.Pow10.
let pow10tab = []f64{1e00, 1e01, 1e02, 1e03, 1e04, 1e05, 1e06, 1e07, 1e08, 1e09, 1e10, 1e11, 1e12, 1e13, 1e14, 1e15, 1e16, 1e17, 1e18, 1e19, 1e20, 1e21, 1e22, 1e23, 1e24, 1e25, 1e26, 1e27, 1e28, 1e29, 1e30, 1e31}

let pow10postab32 = []f64{1e00, 1e32, 1e64, 1e96, 1e128, 1e160, 1e192, 1e224, 1e256, 1e288}

let pow10negtab32 = []f64{1e-00, 1e-32, 1e-64, 1e-96, 1e-128, 1e-160, 1e-192, 1e-224, 1e-256, 1e-288, 1e-320}

// F64bits returns the IEEE 754 bit pattern of f.
fn F64bits(f f64) u64 {
	return u64(cast(i64, f))
}

// F64frombits returns the f64 with bit pattern b.
fn F64frombits(b u64) f64 {
	return cast(f64, i64(b))
}

// Abs returns |x| (NaN stays NaN, -0 becomes +0).
fn Abs(x f64) f64 {
	return F64frombits(F64bits(x) & 0x7fffffffffffffff)
}

// Signbit reports whether x is negative or negative zero.
fn Signbit(x f64) bool {
	return cast(i64, x) < 0
}

// Copysign returns a value with the magnitude of f and the sign of sign.
fn Copysign(f f64, sign f64) f64 {
	return F64frombits(F64bits(f)&0x7fffffffffffffff | F64bits(sign)>>63<<63)
}

// Inf returns +Inf when sign >= 0, else -Inf.
fn Inf(sign i64) f64 {
	let v = F64frombits(0x7ff0000000000000)
	if sign < 0 {
		return -v
	}
	return v
}

// NaN returns a quiet not-a-number.
fn NaN() f64 {
	return F64frombits(0x7ff8000000000001)
}

// IsNaN reports whether f is not-a-number.
fn IsNaN(f f64) bool {
	return f != f
}

// IsInf reports whether f is +Inf (sign > 0), -Inf (sign < 0) or either (sign == 0).
fn IsInf(f f64, sign i64) bool {
	return sign >= 0 && f > MaxF64 || sign <= 0 && f < -MaxF64
}

// Min returns the smaller of x and y; any NaN gives NaN and -0 is smaller than +0 (like Go).
fn Min(x f64, y f64) f64 {
	if IsInf(x, -1) || IsInf(y, -1) {
		return Inf(-1)
	}
	if x != x || y != y {
		return NaN()
	}
	if x == 0 && x == y {
		if Signbit(x) {
			return x
		}
		return y
	}
	if x < y {
		return x
	}
	return y
}

// Max returns the larger of x and y; any NaN gives NaN and +0 is larger than -0 (like Go).
fn Max(x f64, y f64) f64 {
	if IsInf(x, 1) || IsInf(y, 1) {
		return Inf(1)
	}
	if x != x || y != y {
		return NaN()
	}
	if x == 0 && x == y {
		if Signbit(x) {
			return y
		}
		return x
	}
	if x > y {
		return x
	}
	return y
}

// Clamp returns x limited to [lo, hi] (NaN passes through).
fn Clamp(x f64, lo f64, hi f64) f64 {
	if x < lo {
		return lo
	}
	if x > hi {
		return hi
	}
	return x
}

// Pow10 returns 10**n: +Inf above 308, 0 below -323, exactly as Go's math.Pow10.
fn Pow10(n i64) f64 {
	if n >= 0 && n <= 308 {
		return pow10postab32[n/32] * pow10tab[n%32]
	}
	if n >= -323 && n < 0 {
		return pow10negtab32[(-n)/32] / pow10tab[(-n)%32]
	}
	if n > 0 {
		return Inf(1)
	}
	return 0
}

// F32bits returns the IEEE 754 bit pattern of f. Tin holds an f32 as an f64 rounded to f32, so
// the 32-bit pattern is re-encoded; a NaN payload is canonical, as conversions do.
fn F32bits(f f32) u32 {
	let b = F64bits(f64(f))
	let s = (b >> 63) << 31
	let e = i64((b >> 52) & 0x7ff)
	let m = b & 0xfffffffffffff
	if e == 0 {
		return u32(s) // +-0
	}
	if e == 0x7ff {
		if m == 0 {
			return u32(s | 0x7f800000) // +-Inf
		}
		return u32(s | 0x7fc00000 | (m >> 29)) // NaN, quiet
	}
	let e32 = e - 896 // 1023 - 127
	let m32 = m >> 29
	if e32 <= 0 {
		// An f32 subnormal: bring back the hidden bit and shift down (the value is m32 * 2**-149).
		let sub = (m | 0x10000000000000) >> u64(926-e)
		return u32(s | (sub & 0x7fffff))
	}
	return u32(s | u64(e32) << 23 | (m32 & 0x7fffff))
}

// F32frombits returns the f32 with bit pattern b. Subnormals and infinities are exact; a NaN is
// a quiet NaN with the payload's high bits, since the f32 lives as an f64.
fn F32frombits(b u32) f32 {
	let s = u64(b >> 31) << 63
	let e = i64((b >> 23) & 0xff)
	let m = u64(b) & 0x7fffff
	if e == 0xff {
		return f32(F64frombits(s | 0x7ff0000000000000 | m << 29))
	}
	if e == 0 {
		if m == 0 {
			return f32(F64frombits(s)) // +-0
		}
		// An f32 subnormal: value = m * 2**-149; normalize it into an f64.
		mut mm = m
		mut k = i64(0)
		for (mm & 0x800000) == 0 {
			mm <<= 1
			k += 1
		}
		return f32(F64frombits(s | u64(897-k) << 52 | (mm & 0x7fffff) << 29))
	}
	return f32(F64frombits(s | u64(e+896) << 52 | m << 29))
}

// Nextafter returns the next representable f64 after x towards y, like Go's math.Nextafter;
// NaN when either is NaN.
fn Nextafter(x f64, y f64) f64 {
	if IsNaN(x) || IsNaN(y) {
		return NaN()
	}
	if x == y {
		return x
	}
	if x == 0 {
		return Copysign(F64frombits(1), y)
	}
	if (y > x) == (x > 0) {
		return F64frombits(F64bits(x) + 1)
	}
	return F64frombits(F64bits(x) - 1)
}

// Nextafter32 is Nextafter for f32 values.
fn Nextafter32(x f32, y f32) f32 {
	if IsNaN(f64(x)) || IsNaN(f64(y)) {
		return f32(NaN())
	}
	if x == y {
		return x
	}
	if x == 0 {
		return f32(Copysign(f64(F32frombits(1)), f64(y)))
	}
	if (y > x) == (x > 0) {
		return F32frombits(F32bits(x) + 1)
	}
	return F32frombits(F32bits(x) - 1)
}

// Dim returns the maximum of x-y or 0, like Go's math.Dim: Dim(+Inf, +Inf) = Dim(-Inf, -Inf) =
// NaN, and any NaN gives NaN.
fn Dim(x f64, y f64) f64 {
	let v = x - y
	if v <= 0 {
		return 0
	}
	return v
}

// FMA returns x*y + z with a single rounding (a fused multiply-add), like Go's math.FMA.
fn FMA(x f64, y f64, z f64) f64 {
	return x*y + z
}
