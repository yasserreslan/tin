package gauge

// The gamma function: FreeBSD's e_gamma.c through Go's gamma.go. Go's goto is the two early
// returns below; stirling's Exp and Pow are this package's own.

const gamP0 = 1.60119522476751861407e-04

const gamP1 = 1.19135147006586384913e-03

const gamP2 = 1.04213797561761569935e-02

const gamP3 = 4.76367800457137231464e-02

const gamP4 = 2.07448227648435975150e-01

const gamP5 = 4.94214826801497100753e-01

const gamP6 = 9.99999999999999996796e-01

const gamQ0 = -2.31581873324120129819e-05

const gamQ1 = 5.39605580493303397842e-04

const gamQ2 = -4.45641913851797240494e-03

const gamQ3 = 1.18139785222060435552e-02

const gamQ4 = 3.58236398605498653373e-02

const gamQ5 = -2.34591795718243348568e-01

const gamQ6 = 7.14304917030273074085e-02

const gamQ7 = 1.00000000000000000320e+00

const gamS0 = 7.87311395793093628397e-04

const gamS1 = -2.29549961613378126380e-04

const gamS2 = -2.68132617805781232825e-03

const gamS3 = 3.47222221605458667310e-03

const gamS4 = 8.33333333333482257126e-02

const sqrtTwoPi = 2.506628274631000502417

const maxStirling = 143.01608

const gamEuler = 0.57721566490153286060651209008240243104215933593992 // A001620

// stirling returns the two factors of Gamma's asymptotic series for large x.
fn stirling(x f64) (f64, f64) {
	if x > 200 {
		return Inf(1), 1
	}
	mut w = 1 / x
	w = 1 + w*((((gamS0*w+gamS1)*w+gamS2)*w+gamS3)*w+gamS4)
	let y1 = Exp(x)
	mut y2 = 1.0
	if x > maxStirling { // avoid Pow() overflow
		let v = Pow(x, 0.5*x-0.25)
		y2 = v / y1
		return v, sqrtTwoPi * w * y2
	}
	return Pow(x, x-0.5) / y1, sqrtTwoPi * w * y2
}

// Gamma returns the gamma function of x. Gamma(±Inf) = +Inf, Gamma(0) = ±Inf by sign,
// Gamma(NaN) = Gamma(negative integer) = NaN.
fn Gamma(x f64) f64 {
	if isNegInt(x) || IsInf(x, -1) || IsNaN(x) {
		return NaN()
	}
	if IsInf(x, 1) {
		return Inf(1)
	}
	if x == 0 {
		if Signbit(x) {
			return Inf(-1)
		}
		return Inf(1)
	}
	let q = Abs(x)
	mut p = Floor(q)
	if q > 33 {
		if x >= 0 {
			let (y1, y2) = stirling(x)
			return y1 * y2
		}
		mut signgam = 1
		// Go's int64(p) saturates out of range; a saturated value is even, so a huge p is even.
		if p < 9223372036854775808.0 {
			if i64(p)&1 == 0 {
				signgam = -1
			}
		} else {
			signgam = -1
		}
		mut z = q - p
		if z > 0.5 {
			p = p + 1
			z = q - p
		}
		z = q * Sin(Pi*z)
		if z == 0 {
			return Inf(signgam)
		}
		let (sq1, sq2) = stirling(q)
		let absz = Abs(z)
		let d = absz * sq1 * sq2
		mut zz = 0.0
		if IsInf(d, 0) {
			zz = Pi / absz / sq1 / sq2
		} else {
			zz = Pi / d
		}
		return f64(signgam) * zz
	}
	mut v = x
	mut z = 1.0
	for v >= 3 {
		v = v - 1
		z = z * v
	}
	for v < 0 {
		if v > -1e-09 {
			return gamSmall(v, z)
		}
		z = z / v
		v = v + 1
	}
	for v < 2 {
		if v < 1e-09 {
			return gamSmall(v, z)
		}
		z = z / v
		v = v + 1
	}
	if v == 2 {
		return z
	}
	let s = v - 2
	let pp = (((((s*gamP0+gamP1)*s+gamP2)*s+gamP3)*s+gamP4)*s+gamP5)*s + gamP6
	let qq = ((((((s*gamQ0+gamQ1)*s+gamQ2)*s+gamQ3)*s+gamQ4)*s+gamQ5)*s+gamQ6)*s + gamQ7
	return z * pp / qq
}

// gamSmall is Go's "small" label: the series for x near zero.
fn gamSmall(x f64, z f64) f64 {
	if x == 0 {
		return Inf(1)
	}
	return z / ((1 + gamEuler*x) * x)
}

// isNegInt reports whether x is a negative integer, where Gamma has a pole.
fn isNegInt(x f64) bool {
	return x < 0 && x == Floor(x)
}
