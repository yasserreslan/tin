// Package gauge is floating-point math and a few integer helpers (like Go's math); bit operations are in package bits. The transcendental
// functions are written in Tin (ported from Go's math package); only the functions the CPU has an
// instruction for (sqrt, floor, ceil, trunc, round, rint) go through the system.
package gauge

// Pi is the ratio of a circle's circumference to its diameter.
const Pi = 3.141592653589793

// E is the base of natural logarithms.
const E = 2.718281828459045

// Sqrt2 is the square root of 2.
const Sqrt2 = 1.4142135623730951

// Ln2 is the natural logarithm of 2.
const Ln2 = 0.6931471805599453

// MaxI64 is the largest i64.
const MaxI64 = 9223372036854775807

// MinI64 is the smallest i64.
const MinI64 = -9223372036854775807 - 1

// MaxU64 is the largest u64 (typed, because an untyped constant this large folds to -1 in the frozen compiler).
const MaxU64 u64 = 18446744073709551615

// MaxF64 is the largest finite f64.
const MaxF64 = 1.7976931348623157e308

// SmallestNonzeroF64 is the smallest positive denormal f64.
const SmallestNonzeroF64 = 4.9406564584124654e-324

// MaxF32 is the largest finite f32.
const MaxF32 = 3.4028234663852886e+38

// Ln10 is the natural logarithm of 10.
const Ln10 = 2.302585092994046

// Log2E is the base-2 logarithm of e.
const Log2E = 1.4426950408889634

// Log10E is the base-10 logarithm of e.
const Log10E = 0.4342944819032518

// Phi is the golden ratio.
const Phi = 1.618033988749895

// SqrtE is the square root of e.
const SqrtE = 1.6487212707001282

// SqrtPi is the square root of Pi.
const SqrtPi = 1.772453850905516

// SqrtPhi is the square root of Phi.
const SqrtPhi = 1.272019649514069

extern fn sqrt(x f64) f64
extern fn floor(x f64) f64
extern fn ceil(x f64) f64
extern fn trunc(x f64) f64
extern fn round(x f64) f64
extern fn rint(x f64) f64

// Sqrt returns the square root of x.
fn Sqrt(x f64) f64 {
	return sqrt(x)
}

// Floor returns the largest integer value <= x.
fn Floor(x f64) f64 {
	return floor(x)
}

// Ceil returns the smallest integer value >= x.
fn Ceil(x f64) f64 {
	return ceil(x)
}

// Trunc returns the integer part of x (rounding toward zero).
fn Trunc(x f64) f64 {
	return trunc(x)
}

// Round returns x rounded to the nearest integer, halves away from zero.
fn Round(x f64) f64 {
	return round(x)
}

// RoundToEven returns x rounded to the nearest integer, halves to the even neighbour.
fn RoundToEven(x f64) f64 {
	return rint(x)
}
