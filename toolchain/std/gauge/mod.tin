package gauge

// Mod, as in Go's mod.go: exact, by repeated subtraction of a scaled divisor.

// Mod returns the remainder of x/y with the sign of x, exactly. NaN for y == 0, infinite x or
// either NaN.
fn Mod(x f64, y f64) f64 {
	if y == 0 || IsInf(x, 0) || IsNaN(x) || IsNaN(y) {
		return NaN()
	}
	y = Abs(y)
	let (yfr, yexp) = Frexp(y)
	mut r = x
	if x < 0 {
		r = -x
	}
	for r >= y {
		mut (rfr, rexp) = Frexp(r)
		if rfr < yfr {
			rexp = rexp - 1
		}
		r = r - Ldexp(y, rexp-yexp)
	}
	if x < 0 {
		r = -r
	}
	return r
}

const remHalfMax = MaxF64 / 2
const remTiny = 4.45014771701440276618e-308 // 0x0020000000000000

// Remainder returns the IEEE 754 remainder of x/y: x - n*y where n is x/y rounded to the nearest
// integer, ties to even (FreeBSD's e_remainder.c through Go's remainder.go). Unlike Mod its sign
// follows x and it is NaN for y = 0 or an infinite x.
fn Remainder(x f64, y f64) f64 {
	if IsNaN(x) || IsNaN(y) || IsInf(x, 0) || y == 0 {
		return NaN()
	}
	if IsInf(y, 0) {
		return x
	}
	mut a = x
	mut b = y
	let sign = a < 0
	if sign {
		a = -a
	}
	if b < 0 {
		b = -b
	}
	if a == b {
		let zero = 0.0
		if sign {
			return -zero
		}
		return 0
	}
	if b <= remHalfMax {
		a = Mod(a, b+b) // now a < 2b
	}
	if b < remTiny {
		if a+a > b {
			a -= b
			if a+a >= b {
				a -= b
			}
		}
	} else {
		let bHalf = 0.5 * b
		if a > bHalf {
			a -= b
			if a >= bHalf {
				a -= b
			}
		}
	}
	if sign {
		a = -a
	}
	return a
}
