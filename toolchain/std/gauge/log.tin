package gauge

// Logarithms: FreeBSD's e_log.c and s_log1p.c, through Go's log.go, log10.go and log1p.go.

const l1 = 6.666666666666735130e-01

const l2 = 3.999999999940941908e-01

const l3 = 2.857142874366239149e-01

const l4 = 2.222219843214978396e-01

const l5 = 1.818357216161805012e-01

const l6 = 1.531383769920937332e-01

const l7 = 1.479819860511658591e-01

// Log returns the natural logarithm of x. Log(+Inf) = +Inf, Log(0) = -Inf, Log(x < 0) = NaN.
// It is Go's math.Log on each architecture, bit for bit (#942). On arm64 it is Go's pure-Go log, whose fused
// multiply-adds are written here as the products Tin's arm64 backend fuses the same way (`x*y + z` and `z + x*y`
// fuse, `z - x*y` does not, so `-z + x*y` stands for Go's fused `x*y - z`). On amd64 it is Go's assembly, the same
// operations unfused, with its own special cases, Frexp and comparison (logAmd64).
fn Log(x f64) f64 {
	if logAmd64 {
		if x == 0 {
			return Inf(-1)
		}
		if F64bits(x)>>63 != 0 {
			return NaN()
		}
		if IsNaN(x) || IsInf(x, 1) {
			return x
		}
	} else {
		if IsNaN(x) || IsInf(x, 1) {
			return x
		}
		if x < 0 {
			return NaN()
		}
		if x == 0 {
			return Inf(-1)
		}
	}
	mut f1 f64
	mut ki i64
	if x >= smallestNormal || logAmd64 { // x > 0 and finite here: Frexp without the call; amd64 keeps a subnormal's bits
		let bits = F64bits(x)
		ki = i64(bits>>f64Shift) - f64Bias + 1
		f1 = F64frombits(bits&0x000fffffffffffff | u64(f64Bias-1)<<f64Shift)
	} else {
		f1, ki = Frexp(x)
	}
	if f1 < sqrt2Half || logAmd64 && f1 == sqrt2Half { // amd64 tests f1 <= Sqrt2/2 (CMPSD "not less than")
		f1 *= 2
		ki -= 1
	}
	let f = f1 - 1
	let k = f64(ki)
	let s = f / (2 + f)
	let s2 = s * s
	let s4 = s2 * s2
	let t2 = s4 * (l2 + s4*(l4+s4*l6))
	let r = s2*(l1+s4*(l3+s4*(l5+s4*l7))) + t2
	let hfsq = 0.5 * f
	let w = k*expLn2Lo + s*(r+hfsq*f)
	let y = -w + hfsq*f - f
	return -y + k*expLn2Hi
}

// Log2 returns the binary logarithm of x, exact for powers of two.
fn Log2(x f64) f64 {
	let (frac, exp) = Frexp(x)
	if frac == 0.5 {
		return f64(exp - 1)
	}
	return Log(frac)*invLn2 + f64(exp)
}

// Log10 returns the decimal logarithm of x.
fn Log10(x f64) f64 {
	return Log(x) * invLn10
}

const sqrt2M1 = 4.142135623730950488017e-01 // Sqrt(2)-1

const sqrt2HalfM1 = -2.928932188134524755992e-01 // Sqrt(2)/2-1

const small = 1.862645149230957e-09 // 2**-29

const tiny = 5.551115123125783e-17 // 2**-54

const two53 = 9007199254740992.0

const lp1 = 6.666666666666735130e-01

const lp2 = 3.999999999940941908e-01

const lp3 = 2.857142874366239149e-01

const lp4 = 2.222219843214978396e-01

const lp5 = 1.818357216161805012e-01

const lp6 = 1.531383769920937332e-01

const lp7 = 1.479819860511658591e-01

// Log1p returns log(1 + x), accurate even when x is close to zero.
fn Log1p(x f64) f64 {
	if x < -1 || IsNaN(x) {
		return NaN()
	}
	if x == -1 {
		return Inf(-1)
	}
	if IsInf(x, 1) {
		return Inf(1)
	}
	let absx = Abs(x)
	mut f f64
	mut iu u64
	mut k = 1
	if absx < sqrt2M1 { // |x| < Sqrt(2)-1
		if absx < small { // |x| < 2**-29
			if absx < tiny { // |x| < 2**-54
				return x
			}
			return x - x*x*0.5
		}
		if x > sqrt2HalfM1 { // Sqrt(2)/2-1 < x
			k = 0
			f = x
			iu = 1
		}
	}
	mut c f64
	if k != 0 {
		mut u f64
		if absx < two53 {
			u = 1.0 + x
			iu = F64bits(u)
			k = i64(iu>>52) - 1023
			if k > 0 {
				c = 1.0 - (u - x)
			} else {
				c = x - (u - 1.0)
			}
			c /= u
		} else {
			u = x
			iu = F64bits(u)
			k = i64(iu>>52) - 1023
			c = 0
		}
		iu &= 0x000fffffffffffff
		if iu < 0x0006a09e667f3bcd { // mantissa of Sqrt(2)
			u = F64frombits(iu | 0x3ff0000000000000) // normalize u
		} else {
			k += 1
			u = F64frombits(iu | 0x3fe0000000000000) // normalize u/2
			iu = (0x0010000000000000 - iu) >> 2
		}
		f = u - 1.0 // Sqrt(2)/2 < u < Sqrt(2)
	}
	let hfsq = 0.5 * f * f
	mut s f64
	mut r f64
	mut z f64
	if iu == 0 { // |f| < 2**-20
		if f == 0 {
			if k == 0 {
				return 0
			}
			c += f64(k) * expLn2Lo
			return f64(k)*expLn2Hi + c
		}
		r = hfsq * (1.0 - 0.66666666666666666*f) // avoid the division
		if k == 0 {
			return f - r
		}
		return f64(k)*expLn2Hi - ((r - (f64(k)*expLn2Lo + c)) - f)
	}
	s = f / (2.0 + f)
	z = s * s
	r = z * (lp1 + z*(lp2+z*(lp3+z*(lp4+z*(lp5+z*(lp6+z*lp7))))))
	if k == 0 {
		return f - (hfsq - s*(hfsq+r))
	}
	return f64(k)*expLn2Hi - ((hfsq - (s*(hfsq+r) + (f64(k)*expLn2Lo + c))) - f)
}

// Logb returns the binary exponent of x as an f64 (Go's math.Logb): +Inf for infinities,
// -Inf for zero, NaN for NaN.
fn Logb(x f64) f64 {
	if x == 0 {
		return Inf(-1)
	}
	if IsInf(x, 0) {
		return Inf(1)
	}
	if IsNaN(x) {
		return x
	}
	return f64(Ilogb(x))
}

// Ilogb returns the binary exponent of x as an i64, like Go's math.Ilogb: MaxI32 for infinities
// and NaN, MinI32 for zero.
fn Ilogb(x f64) i64 {
	if x == 0 {
		return -2147483648
	}
	if IsNaN(x) || IsInf(x, 0) {
		return 2147483647
	}
	return ilogb(x)
}

// ilogb returns the binary exponent of a finite non-zero x.
fn ilogb(x f64) i64 {
	let (g, exp) = normalize(x)
	return i64((F64bits(g)>>f64Shift)&f64Mask) - f64Bias + exp
}
