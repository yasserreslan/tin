package gauge

// The inverse error functions: Go's erfinv.go, based on the rational approximation of percentage
// points of the normal distribution (https://www.jstor.org/stable/2347330). The coefficients keep
// Go's names.

// Coefficients for the approximation to erf in |x| <= 0.85.
const erfinvA0 = 1.1975323115670912564578e0

const erfinvA1 = 4.7072688112383978012285e1

const erfinvA2 = 6.9706266534389598238465e2

const erfinvA3 = 4.8548868893843886794648e3

const erfinvA4 = 1.6235862515167575384252e4

const erfinvA5 = 2.3782041382114385731252e4

const erfinvA6 = 1.1819493347062294404278e4

const erfinvA7 = 8.8709406962545514830200e2

const erfinvB0 = 1.0000000000000000000e0

const erfinvB1 = 4.2313330701600911252e1

const erfinvB2 = 6.8718700749205790830e2

const erfinvB3 = 5.3941960214247511077e3

const erfinvB4 = 2.1213794301586595867e4

const erfinvB5 = 3.9307895800092710610e4

const erfinvB6 = 2.8729085735721942674e4

const erfinvB7 = 5.2264952788528545610e3

// Coefficients for the approximation to erf in 0.85 < |x| <= 1-2*exp(-25).
const erfinvC0 = 1.42343711074968357734e0

const erfinvC1 = 4.63033784615654529590e0

const erfinvC2 = 5.76949722146069140550e0

const erfinvC3 = 3.64784832476320460504e0

const erfinvC4 = 1.27045825245236838258e0

const erfinvC5 = 2.41780725177450611770e-1

const erfinvC6 = 2.27238449892691845833e-2

const erfinvC7 = 7.74545014278341407640e-4

const erfinvD0 = 1.4142135623730950488016887e0

const erfinvD1 = 2.9036514445419946173133295e0

const erfinvD2 = 2.3707661626024532365971225e0

const erfinvD3 = 9.7547832001787427186894837e-1

const erfinvD4 = 2.0945065210512749128288442e-1

const erfinvD5 = 2.1494160384252876777097297e-2

const erfinvD6 = 7.7441459065157709165577218e-4

const erfinvD7 = 1.4859850019840355905497876e-9

// Coefficients for the approximation to erf in 1-2*exp(-25) < |x| < 1.
const erfinvE0 = 6.65790464350110377720e0

const erfinvE1 = 5.46378491116411436990e0

const erfinvE2 = 1.78482653991729133580e0

const erfinvE3 = 2.96560571828504891230e-1

const erfinvE4 = 2.65321895265761230930e-2

const erfinvE5 = 1.24266094738807843860e-3

const erfinvE6 = 2.71155556874348757815e-5

const erfinvE7 = 2.01033439929228813265e-7

const erfinvF0 = 1.414213562373095048801689e0

const erfinvF1 = 8.482908416595164588112026e-1

const erfinvF2 = 1.936480946950659106176712e-1

const erfinvF3 = 2.103693768272068968719679e-2

const erfinvF4 = 1.112800997078859844711555e-3

const erfinvF5 = 2.611088405080593625138020e-5

const erfinvF6 = 2.010321207683943062279931e-7

const erfinvF7 = 2.891024605872965461538222e-15

// Erfinv returns the inverse error function of x. Erfinv(1) = +Inf, Erfinv(-1) = -Inf,
// Erfinv(x) = NaN outside [-1, 1] and for NaN.
fn Erfinv(x f64) f64 {
	if IsNaN(x) || x <= -1 || x >= 1 {
		if x == -1 {
			return Inf(-1)
		}
		if x == 1 {
			return Inf(1)
		}
		return NaN()
	}
	mut v = x
	mut sign = false
	if v < 0 {
		v = -v
		sign = true
	}
	mut ans = 0.0
	if v <= 0.85 { // |x| <= 0.85
		let r = 0.180625 - 0.25*v*v
		let z1 = ((((((erfinvA7*r+erfinvA6)*r+erfinvA5)*r+erfinvA4)*r+erfinvA3)*r+erfinvA2)*r+erfinvA1)*r + erfinvA0
		let z2 = ((((((erfinvB7*r+erfinvB6)*r+erfinvB5)*r+erfinvB4)*r+erfinvB3)*r+erfinvB2)*r+erfinvB1)*r + erfinvB0
		ans = (v * z1) / z2
	} else {
		mut r = Sqrt(Ln2 - Log(1.0-v))
		if r <= 5.0 {
			r -= 1.6
			let z1 = ((((((erfinvC7*r+erfinvC6)*r+erfinvC5)*r+erfinvC4)*r+erfinvC3)*r+erfinvC2)*r+erfinvC1)*r + erfinvC0
			let z2 = ((((((erfinvD7*r+erfinvD6)*r+erfinvD5)*r+erfinvD4)*r+erfinvD3)*r+erfinvD2)*r+erfinvD1)*r + erfinvD0
			ans = z1 / z2
		} else {
			r -= 5.0
			let z1 = ((((((erfinvE7*r+erfinvE6)*r+erfinvE5)*r+erfinvE4)*r+erfinvE3)*r+erfinvE2)*r+erfinvE1)*r + erfinvE0
			let z2 = ((((((erfinvF7*r+erfinvF6)*r+erfinvF5)*r+erfinvF4)*r+erfinvF3)*r+erfinvF2)*r+erfinvF1)*r + erfinvF0
			ans = z1 / z2
		}
	}
	if sign {
		return -ans
	}
	return ans
}

// Erfcinv returns the inverse of Erfc: Erfcinv(0) = +Inf, Erfcinv(2) = -Inf, Erfcinv(x) = NaN
// outside [0, 2] and for NaN.
fn Erfcinv(x f64) f64 {
	return Erfinv(1 - x)
}
