package gauge

// Hyperbolic sine, cosine and tangent: Cephes, through Go's sinh.go and tanh.go.

const sinhP0 = -0.6307673640497716991184787251e+6

const sinhP1 = -0.8991272022039509355398013511e+5

const sinhP2 = -0.2894211355989563807284660366e+4

const sinhP3 = -0.2630563213397497062819489e+2

const sinhQ0 = -0.6307673640497716991212077277e+6

const sinhQ1 = 0.1521517378790019070696485176e+5

const sinhQ2 = -0.173678953558233699533450911e+3

// Sinh returns the hyperbolic sine of x. It uses Exp above 0.5 and a rational approximation below.
fn Sinh(x f64) f64 {
	mut sign = false
	if x < 0 {
		x = -x
		sign = true
	}
	mut temp f64
	if x > 21 {
		temp = Exp(x) * 0.5
	} else if x > 0.5 {
		let ex = Exp(x)
		temp = (ex - 1/ex) * 0.5
	} else {
		let sq = x * x
		temp = (((sinhP3*sq+sinhP2)*sq+sinhP1)*sq + sinhP0) * x
		temp = temp / (((sq+sinhQ2)*sq+sinhQ1)*sq + sinhQ0)
	}
	if sign {
		temp = -temp
	}
	return temp
}

// Cosh returns the hyperbolic cosine of x.
fn Cosh(x f64) f64 {
	x = Abs(x)
	if x > 21 {
		return Exp(x) * 0.5
	}
	let ex = Exp(x)
	return (ex + 1/ex) * 0.5
}

const tanhP0 = -9.64399179425052238628e-1

const tanhP1 = -9.92877231001918586564e1

const tanhP2 = -1.61468768441708447952e3

const tanhQ0 = 1.12811678491632931402e2

const tanhQ1 = 2.23548839060100448583e3

const tanhQ2 = 4.84406305325125486048e3

const maxlog = 8.8029691931113054295988e+01 // log(2**127)

// Tanh returns the hyperbolic tangent of x, in [-1, 1].
fn Tanh(x f64) f64 {
	mut z = Abs(x)
	if z > 0.5*maxlog {
		if x < 0 {
			return -1
		}
		return 1
	}
	if z >= 0.625 {
		let s = Exp(2 * z)
		z = 1 - 2/(s+1)
		if x < 0 {
			z = -z
		}
		return z
	}
	if x == 0 {
		return x
	}
	let s = x * x
	return x + x*s*((tanhP0*s+tanhP1)*s+tanhP2)/(((s+tanhQ0)*s+tanhQ1)*s+tanhQ2)
}

const hyperNearZero = 1.0 / (1 << 28)

const hyperLarge = 1 << 28

// Asinh returns the inverse hyperbolic sine of x (FreeBSD's s_asinh.c through Go's asinh.go).
fn Asinh(x f64) f64 {
	let nearZero = hyperNearZero
	let large = hyperLarge
	if IsNaN(x) || IsInf(x, 0) {
		return x
	}
	mut v = x
	mut sign = false
	if v < 0 {
		v = -v
		sign = true
	}
	mut temp f64
	if v > f64(large) {
		temp = Log(v) + Ln2
	} else if v > 2 {
		temp = Log(2*v + 1/(Sqrt(v*v+1)+v))
	} else if v < nearZero {
		temp = v
	} else {
		temp = Log1p(v + v*v/(1+Sqrt(1+v*v)))
	}
	if sign {
		temp = -temp
	}
	return temp
}

// Acosh returns the inverse hyperbolic cosine of x (FreeBSD's e_acosh.c through Go's acosh.go);
// it is NaN below 1.
fn Acosh(x f64) f64 {
	let large = hyperLarge
	if x < 1 || IsNaN(x) {
		return NaN()
	}
	if x == 1 {
		return 0
	}
	if x >= f64(large) {
		return Log(x) + Ln2
	}
	if x > 2 {
		return Log(2*x - 1/(x+Sqrt(x*x-1)))
	}
	let t = x - 1
	return Log1p(t + Sqrt(2*t+t*t))
}

// Atanh returns the inverse hyperbolic tangent of x (FreeBSD's e_atanh.c through Go's atanh.go);
// it is +Inf at 1, -Inf at -1 and NaN outside [-1, 1].
fn Atanh(x f64) f64 {
	let nearZero = hyperNearZero
	if x < -1 || x > 1 || IsNaN(x) {
		return NaN()
	}
	if x == 1 {
		return Inf(1)
	}
	if x == -1 {
		return Inf(-1)
	}
	mut v = x
	mut sign = false
	if v < 0 {
		v = -v
		sign = true
	}
	mut temp f64
	if v < nearZero {
		temp = v
	} else if v < 0.5 {
		let d = v + v
		temp = 0.5 * Log1p(d + d*v/(1-v))
	} else {
		temp = 0.5 * Log1p((v+v)/(1-v))
	}
	if sign {
		temp = -temp
	}
	return temp
}
