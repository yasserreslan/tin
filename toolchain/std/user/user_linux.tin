package user

import "quarry"
import "twine"
import "mint"

fn currentUID() !str {
	let status = try quarry.ReadFile("/proc/self/status")
	for line in twine.Split(status, "\n") {
		if twine.HasPrefix(line, "Uid:") {
			let fields = twine.Fields(line)
			if len(fields) > 1 {
				return fields[1]
			}
		}
	}
	fail "user: cannot determine current user ID"
}

fn lookupId(uid str) !User {
	let rows = try quarry.ReadFile("/etc/passwd")
	for row in twine.Split(rows, "\n") {
		let fields = twine.Split(row, ":")
		if len(fields) >= 7 && normalizeID(fields[2]) == normalizeID(uid) {
			return User{Username: fields[0], Uid: normalizeID(fields[2]), Gid: normalizeID(fields[3]), Name: gecosName(fields[4]), HomeDir: fields[5]}
		}
	}
	fail "user: unknown userid {uid}"
}

fn lookupName(name str) !User {
	let rows = try quarry.ReadFile("/etc/passwd")
	for row in twine.Split(rows, "\n") {
		let fields = twine.Split(row, ":")
		if len(fields) >= 7 && fields[0] == name {
			return User{Username: fields[0], Uid: normalizeID(fields[2]), Gid: normalizeID(fields[3]), Name: gecosName(fields[4]), HomeDir: fields[5]}
		}
	}
	fail "user: unknown user {name}"
}

fn lookupGroupName(name str) !Group {
	let rows = try quarry.ReadFile("/etc/group")
	for row in twine.Split(rows, "\n") {
		let fields = twine.Split(row, ":")
		if len(fields) >= 4 && fields[0] == name {
			return Group{Name: fields[0], Gid: normalizeID(fields[2])}
		}
	}
	fail "group: unknown group {name}"
}

fn lookupGroupIds(u User) ![]str {
	let rows = try quarry.ReadFile("/etc/group")
	mut out = []str{normalizeID(u.Gid)}
	for row in twine.Split(rows, "\n") {
		let fields = twine.Split(row, ":")
		if len(fields) < 4 {
			continue
		}
		let gid = normalizeID(fields[2])
		if contains(twine.Split(fields[3], ","), u.Username) && !contains(out, gid) {
			out = append(out, gid)
		}
	}
	return out
}

fn normalizeID(s str) str {
	if len(s) == 0 {
		return s
	}
	mut i = i64(0)
	mut negative = false
	if s[0] == '-' {
		negative = true
		i = 1
	}
	if i == len(s) {
		return s
	}
	mut n = i64(0)
	for i < len(s) {
		if s[i] < '0' || s[i] > '9' {
			return s
		}
		n = n*10 + i64(s[i]) - '0'
		i += 1
	}
	if negative {
		n = -n
	}
	return mint.Itoa(i64(u32(n)))
}

fn gecosName(s str) str {
	let (name, _, found) = twine.Cut(s, ",")
	if found {
		return name
	}
	return s
}
