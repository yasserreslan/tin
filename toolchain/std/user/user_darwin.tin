package user

import "mint"
import "twine"

extern fn getuid() i64
extern fn getpwuid_r(uid i64, pwd i64, buf i64, n i64, result i64) i64
extern fn getpwnam_r(name i64, pwd i64, buf i64, n i64, result i64) i64
extern fn getgrnam_r(name i64, group i64, buf i64, n i64, result i64) i64
extern fn getgrouplist(name i64, base i64, groups i64, ngroups i64) i64

fn currentUID() !str {
	return mint.Itoa(getuid())
}

fn lookupId(uid str) !User {
	let n = parseUID(uid)
	let pwd = calloc(1, 80)
	let buf = calloc(1, 65536)
	mut result = i64(0)
	if getpwuid_r(n, pwd, buf, 65536, cast(i64, &result)) != 0 || result == 0 {
		fail "user: unknown userid {uid}"
	}
	return darwinUser(pwd)
}

fn lookupName(name str) !User {
	let pwd = calloc(1, 80)
	let buf = calloc(1, 65536)
	mut result = i64(0)
	if getpwnam_r(rt_cstr(name), pwd, buf, 65536, cast(i64, &result)) != 0 || result == 0 {
		fail "user: unknown user {name}"
	}
	return darwinUser(pwd)
}

fn lookupGroupName(name str) !Group {
	let group = calloc(1, 32)
	let buf = calloc(1, 65536)
	mut result = i64(0)
	if getgrnam_r(rt_cstr(name), group, buf, 65536, cast(i64, &result)) != 0 || result == 0 {
		fail "group: unknown group {name}"
	}
	return Group{Name: cString(loadPtr(group)), Gid: mint.Itoa(loadU32(group+16))}
}

fn lookupGroupIds(u User) ![]str {
	mut n = i32(256)
	let buf = calloc(i64(n), 4)
	if getgrouplist(rt_cstr(u.Username), parseUID(u.Gid), buf, cast(i64, &n)) < 0 {
		fail "user: user {u.Username} has too many groups"
	}
	mut out = []str{}
	for i in 0..i64(n) {
		let gid = mint.Itoa(loadU32(buf+i*4))
		if !contains(out, gid) {
			out = append(out, gid)
		}
	}
	return out
}

fn darwinUser(p i64) User {
	let name = cString(loadPtr(p))
	let uid = mint.Itoa(loadU32(p+16))
	let gid = mint.Itoa(loadU32(p+20))
	let gecosRaw = cString(loadPtr(p+40))
	let (gecos, _, _) = twine.Cut(gecosRaw, ",")
	let home = cString(loadPtr(p+48))
	return User{Username: name, Uid: uid, Gid: gid, Name: gecos, HomeDir: home}
}

fn parseUID(s str) i64 {
	mut n = i64(0)
	mut i = i64(0)
	mut negative = false
	if len(s) > 0 && s[0] == '-' {
		negative = true
		i = 1
	}
	for i < len(s) {
		if s[i] < '0' || s[i] > '9' {
			return -1
		}
		n = n*10 + i64(s[i]) - '0'
		i += 1
	}
	if negative { return -n }
	return n
}

fn cString(p i64) str {
	if p == 0 {
		return ""
	}
	return rt_str_from_raw(p, strlen(p))
}

fn loadPtr(p i64) i64 {
	mut n = i64(0)
	for i in 0..8 {
		n |= i64(load8(p+i)) << (i*8)
	}
	return n
}

fn loadU32(p i64) i64 {
	mut n = i64(0)
	for i in 0..4 {
		n |= i64(load8(p+i)) << (i*8)
	}
	return n
}
