// Package trail manipulates slash-separated file paths (like Go's path/filepath on Unix).
package trail

import "glyph"
import "say"

// Separator is the path separator byte.
const Separator = '/'

// Clean returns the shortest path equivalent to path by Go's rules: no "." or ".." elements where avoidable, no repeated or trailing slashes, "." for an empty path.
fn Clean(path str) str {
	let n = len(path)
	if n == 0 {
		return "."
	}
	let rooted = path[0] == '/'
	let p = rt_str_new(n)
	let d = p + 8
	mut w = 0
	mut r = 0
	mut dotdot = 0
	if rooted {
		store8(d, '/')
		w = 1
		r = 1
		dotdot = 1
	}
	for r < n {
		if path[r] == '/' {
			r += 1
		} else if path[r] == '.' && (r+1 == n || path[r+1] == '/') {
			r += 1
		} else if path[r] == '.' && path[r+1] == '.' && (r+2 == n || path[r+2] == '/') {
			r += 2
			if w > dotdot {
				w -= 1
				for w > dotdot && load8(d+w) != '/' {
					w -= 1
				}
			} else if !rooted {
				if w > 0 {
					store8(d+w, '/')
					w += 1
				}
				store8(d+w, '.')
				store8(d+w+1, '.')
				w += 2
				dotdot = w
			}
		} else {
			if (rooted && w != 1) || (!rooted && w != 0) {
				store8(d+w, '/')
				w += 1
			}
			for r < n && path[r] != '/' {
				store8(d+w, i64(path[r]))
				w += 1
				r += 1
			}
		}
	}
	if w == 0 {
		return "."
	}
	if w == n {
		return path
	}
	p[0] = w
	store8(d+w, 0)
	return cast(str, p)
}

// IsAbs reports whether path starts with a slash.
fn IsAbs(path str) bool {
	return len(path) > 0 && path[0] == '/'
}

// Base returns the last element of path after dropping trailing slashes: "." for an empty path, "/" for all slashes.
fn Base(path str) str {
	let n = len(path)
	if n == 0 {
		return "."
	}
	mut end = n
	for end > 0 && path[end-1] == '/' {
		end -= 1
	}
	if end == 0 {
		return "/"
	}
	mut i = end - 1
	for i >= 0 && path[i] != '/' {
		i -= 1
	}
	return path[i+1 : end]
}

// Dir returns Clean of everything but the last element of path: "." when there is no slash.
fn Dir(path str) str {
	mut i = len(path) - 1
	for i >= 0 && path[i] != '/' {
		i -= 1
	}
	return Clean(path[0 : i+1])
}

// Ext returns the suffix of path's last element from its final dot, or "".
fn Ext(path str) str {
	{
		mut i = len(path) - 1
		for i >= 0 && path[i] != '/' {
			if path[i] == '.' {
				return path[i:len(path)]
			}
			i -= 1
		}
	}
	return ""
}

// Split splits path right after its last slash into (dir, file); dir keeps the slash.
fn Split(path str) (str, str) {
	mut i = len(path) - 1
	for i >= 0 && path[i] != '/' {
		i -= 1
	}
	return path[0 : i+1], path[i+1 : len(path)]
}

// JoinAll joins the non-empty parts with slashes and Cleans the result; "" when every part is empty.
fn JoinAll(parts []str) str {
	mut first = 0
	for first < len(parts) && len(parts[first]) == 0 {
		first += 1
	}
	if first == len(parts) {
		return ""
	}
	mut total = 0
	for i in first..len(parts) {
		total += len(parts[i]) + 1
	}
	mut b = make([]u8, 0, total)
	for i in first..len(parts) {
		if i > first {
			b = append(b, '/')
		}
		b = append(b, parts[i]...)
	}
	return Clean(str(b))
}

// Join2 joins two path elements like Go's filepath.Join(a, b).
fn Join2(a str, b str) str {
	if len(a) == 0 {
		if len(b) == 0 {
			return ""
		}
		return Clean(b)
	}
	if len(b) == 0 {
		return Clean(a)
	}
	return Clean(a + "/" + b)
}

// Join3 joins three path elements like Go's filepath.Join(a, b, c).
fn Join3(a str, b str, c str) str {
	return JoinAll([]str{a, b, c})
}

// Rel returns a relative path that is lexically equivalent to targ when joined to base, or a fault when one is absolute and the other is not or base holds "..".
fn Rel(base str, targ str) !str {
	mut b = Clean(base)
	let t = Clean(targ)
	if b == t {
		return "."
	}
	if b == "." {
		b = ""
	}
	let bs = len(b) > 0 && b[0] == '/'
	let ts = len(t) > 0 && t[0] == '/'
	if bs != ts {
		fail say.Fault("Rel: can't make %s relative to %s", targ, base)
	}
	let bl = len(b)
	let tl = len(t)
	mut b0 = 0
	mut bi = 0
	mut t0 = 0
	mut ti = 0
	for {
		for bi < bl && b[bi] != '/' {
			bi += 1
		}
		for ti < tl && t[ti] != '/' {
			ti += 1
		}
		if !sameRange(t, t0, ti, b, b0, bi) {
			break
		}
		if bi < bl {
			bi += 1
		}
		if ti < tl {
			ti += 1
		}
		b0 = bi
		t0 = ti
	}
	if bi-b0 == 2 && b[b0] == '.' && b[b0+1] == '.' {
		fail say.Fault("Rel: can't make %s relative to %s", targ, base)
	}
	if b0 != bl {
		mut seps = 0
		for i in b0..bl {
			if b[i] == '/' {
				seps += 1
			}
		}
		mut size = 2 + seps*3
		if tl != t0 {
			size += 1 + tl - t0
		}
		let p = rt_str_new(size)
		let d = p + 8
		store8(d, '.')
		store8(d+1, '.')
		mut n = 2
		for i in 0..seps {
			store8(d+n, '/')
			store8(d+n+1, '.')
			store8(d+n+2, '.')
			n += 3
		}
		if t0 != tl {
			store8(d+n, '/')
			memcpy(d+n+1, cast(i64, t)+8+t0, tl-t0)
		}
		// Clean, as Go does, so a target of "." gives ".." rather than "../."
		return Clean(cast(str, p))
	}
	return t[t0:tl]
}

// sameRange reports whether a[alo:ahi] and b[blo:bhi] hold the same bytes.
fn sameRange(a str, alo i64, ahi i64, b str, blo i64, bhi i64) bool {
	if ahi-alo != bhi-blo {
		return false
	}
	for i in 0..ahi-alo {
		if a[alo+i] != b[blo+i] {
			return false
		}
	}
	return true
}

// Match reports whether name matches the shell pattern: '*' (no slash), '?', '[a-z]', '[^x]' and '\' escapes, like Go's filepath.Match.
fn Match(pattern str, name str) !bool {
	mut pi = 0
	mut ni = 0
	let pn = len(pattern)
	for pi < pn {
		mut star = false
		for pi < pn && pattern[pi] == '*' {
			pi += 1
			star = true
		}
		let clo = pi
		pi = chunkEnd(pattern, pi)
		let chi = pi
		if star && clo == chi {
			for i in ni..len(name) {
				if name[i] == '/' {
					return false
				}
			}
			return true
		}
		let (t, ok, bad) = matchChunk(pattern, clo, chi, name, ni)
		if bad {
			fail badPattern()
		}
		if ok && (t == len(name) || pi < pn) {
			ni = t
			continue
		}
		mut matched = false
		if star {
			{
				mut i = ni
				for i < len(name) && name[i] != '/' {
					let (t2, ok2, bad2) = matchChunk(pattern, clo, chi, name, i+1)
					if bad2 {
						fail badPattern()
					}
					if ok2 && (pi < pn || t2 == len(name)) {
						ni = t2
						matched = true
						break
					}
					i += 1
				}
			}
		}
		if matched {
			continue
		}
		for pi < pn {
			for pi < pn && pattern[pi] == '*' {
				pi += 1
			}
			let c0 = pi
			pi = chunkEnd(pattern, pi)
			let (_, _, bad3) = matchChunk(pattern, c0, pi, "", 0)
			if bad3 {
				fail badPattern()
			}
		}
		return false
	}
	return ni == len(name)
}

// badPattern is the fault for a malformed pattern.
fn badPattern() ! {
	fail "syntax error in pattern"
}

// chunkEnd returns the end of the chunk starting at i: the next unescaped '*' outside brackets, or len.
fn chunkEnd(pattern str, i i64) i64 {
	mut inrange = false
	let n = len(pattern)
	for i < n {
		let c = pattern[i]
		if c == '\\' {
			if i+1 < n {
				i += 1
			}
		} else if c == '[' {
			inrange = true
		} else if c == ']' {
			inrange = false
		} else if c == '*' && !inrange {
			break
		}
		i += 1
	}
	return i
}

// matchChunk matches pattern[clo:chi] at s[si:], returning (end of the match in s, matched, bad pattern).
fn matchChunk(pattern str, clo i64, chi i64, s str, si i64) (i64, bool, bool) {
	mut failed = false
	mut ci = clo
	for ci < chi {
		if !failed && si >= len(s) {
			failed = true
		}
		mut c = pattern[ci]
		if c == '[' {
			mut r = i32(0)
			if !failed {
				let (r2, w) = glyph.DecodeRune(s, si)
				r = r2
				si += w
			}
			ci += 1
			mut negated = false
			if ci < chi && pattern[ci] == '^' {
				negated = true
				ci += 1
			}
			mut match_ = false
			mut nrange = 0
			for {
				if ci < chi && pattern[ci] == ']' && nrange > 0 {
					ci += 1
					break
				}
				let (lo, next, bad) = getEsc(pattern, ci, chi)
				if bad {
					return 0, false, true
				}
				ci = next
				mut hi = lo
				if pattern[ci] == '-' {
					let (hi2, next2, bad2) = getEsc(pattern, ci+1, chi)
					if bad2 {
						return 0, false, true
					}
					hi = hi2
					ci = next2
				}
				if lo <= r && r <= hi {
					match_ = true
				}
				nrange += 1
			}
			if match_ == negated {
				failed = true
			}
		} else if c == '?' {
			if !failed {
				if s[si] == '/' {
					failed = true
				}
				let (_, w) = glyph.DecodeRune(s, si)
				si += w
			}
			ci += 1
		} else {
			if c == '\\' {
				ci += 1
				if ci >= chi {
					return 0, false, true
				}
				c = pattern[ci]
			}
			if !failed {
				if c != s[si] {
					failed = true
				}
				si += 1
			}
			ci += 1
		}
	}
	if failed {
		return 0, false, false
	}
	return si, true, false
}

// getEsc reads one possibly escaped class character at pattern[i], returning (rune, next index, bad pattern).
fn getEsc(pattern str, i i64, chi i64) (i32, i64, bool) {
	if i >= chi || pattern[i] == '-' || pattern[i] == ']' {
		return 0, i, true
	}
	if pattern[i] == '\\' {
		i += 1
		if i >= chi {
			return 0, i, true
		}
	}
	let (r, w) = glyph.DecodeRune(pattern, i)
	mut bad = i64(r) == glyph.RuneError && w == 1
	i += w
	if i >= chi {
		bad = true
	}
	return r, i, bad
}
