// Package fs is the file system interface, like Go's io/fs: a file system is anything with Open
// (the FS shape), and ReadDirFS, StatFS and SubFS add what WalkDir, Glob and Sub use. Names are
// slash-separated and unrooted ("a/b.txt", "." for the root; ValidPath says which are). ReadFile,
// ReadDir, Stat, Sub, Glob and WalkDir work over any file system with the shape they need; Dir is
// the operating system's file tree under a directory (Go's os.DirFS), read through quarry.
//
// Where Go asks an interface at run time (fs.ReadDir tries ReadDirFS, then a file's ReadDir), a
// helper here names the shape it needs at compile time: WalkDir and Glob take a TreeFS (ReadDir
// and Stat). A File has Stat and ReadDir itself (ReadDir fails on a file that is not a
// directory). Faults are Go's PathError text ("open a/b: no such file or directory") and match
// ErrNotExist, ErrPermission, ErrExist and ErrInvalid with fault.Is as Go's errors.Is does. A
// directory listing ends with an empty slice, not a sentinel fault, as a Read ends with 0.
package fs

import "constraints"
import "fault"
import "quarry"
import "trail"

// ErrInvalid is the fault of an invalid argument, such as a name ValidPath refuses.
let ErrInvalid = fault("invalid argument")

// ErrPermission is the fault of a refused permission.
let ErrPermission = fault("permission denied")

// ErrExist is the fault of a file that already exists.
let ErrExist = fault("file already exists")

// ErrNotExist is the fault of a file that does not exist.
let ErrNotExist = fault("file does not exist")

// ErrClosed is the fault of a call on a closed file.
let ErrClosed = fault("file already closed")

// SkipDir, returned by a WalkDir callback, skips the directory (or the rest of the directory a
// file is in).
let SkipDir = fault("skip this directory")

// SkipAll, returned by a WalkDir callback, ends the walk with no fault.
let SkipAll = fault("skip everything and stop the walk")

// ErrBadPattern is the fault of a malformed Glob pattern (trail.Match's text).
let ErrBadPattern = fault("syntax error in pattern")

// ModeDir is the mode bit of a directory (Go's fs.ModeDir); modes are i64 values of Go's FileMode bits.
const ModeDir = 1 << 31

// ModeAppend is the append-only bit.
const ModeAppend = 1 << 30

// ModeExclusive is the exclusive-use bit.
const ModeExclusive = 1 << 29

// ModeTemporary is the temporary-file bit.
const ModeTemporary = 1 << 28

// ModeSymlink is the mode bit of a symbolic link.
const ModeSymlink = 1 << 27

// ModeDevice is the mode bit of a device file.
const ModeDevice = 1 << 26

// ModeNamedPipe is the mode bit of a FIFO.
const ModeNamedPipe = 1 << 25

// ModeSocket is the mode bit of a Unix domain socket.
const ModeSocket = 1 << 24

// ModeSetuid is the setuid bit.
const ModeSetuid = 1 << 23

// ModeSetgid is the setgid bit.
const ModeSetgid = 1 << 22

// ModeCharDevice is the bit of a character device (set with ModeDevice).
const ModeCharDevice = 1 << 21

// ModeSticky is the sticky bit.
const ModeSticky = 1 << 20

// ModeIrregular is the bit of a file of no other known type.
const ModeIrregular = 1 << 19

// ModeType is the type bits: a mode with none of them is a regular file.
const ModeType = ModeDir | ModeSymlink | ModeNamedPipe | ModeSocket | ModeDevice | ModeCharDevice | ModeIrregular

// ModePerm is the Unix permission bits.
const ModePerm = 0o777

// FileInfo describes a file, as Stat reports it (Go's fs.FileInfo).
type FileInfo struct {
	Name    str // the base name
	Size    i64 // bytes, for a regular file; the system's for the others
	Mode    i64 // the FileMode bits: type, permissions, setuid, setgid and sticky
	ModTime i64 // the modification time, in unix nanoseconds
}

// IsDir reports whether the file is a directory.
fn (i FileInfo) IsDir() bool {
	return i.Mode&ModeDir != 0
}

// Type is the file's type bits (Mode & ModeType).
fn (i FileInfo) Type() i64 {
	return i.Mode & ModeType
}

// DirEntry is a name in a directory with its type bits (Go's fs.DirEntry); fs.Stat gives the rest.
type DirEntry struct {
	Name str
	Type i64 // the type bits of the mode (ModeType); 0 is a regular file
}

// IsDir reports whether the entry is a directory.
fn (d DirEntry) IsDir() bool {
	return d.Type&ModeDir != 0
}

// FileInfoToDirEntry is the DirEntry of a file described by info.
fn FileInfoToDirEntry(info FileInfo) DirEntry {
	return DirEntry{Name: info.Name, Type: info.Mode & ModeType}
}

// File is an open file: Read until it returns 0, Stat, ReadDir for a directory, and Close.
// ReadDir(n) with n > 0 gives at most n entries and an empty slice at the end; n <= 0 gives all
// that are left.
shape File {
	mut Read(buf mut []u8) !i64
	Stat() !FileInfo
	mut ReadDir(n i64) ![]DirEntry
	mut Close() !
}

// FileReader is an open File as an io.Reader, what Reader returns: a dyn File satisfies only its
// own shape (dyn-to-dyn widening, E514, is not built), so io.Copy and io.ReadAll take this.
type FileReader struct {
	f dyn File
}

// Reader is f as an io.Reader: its Read is f's.
fn Reader(f dyn File) FileReader {
	return FileReader{f: f}
}

// Read reads from the file.
fn (r mut FileReader) Read(buf mut []u8) !i64 {
	return try r.f.Read(mut buf)
}

// FS is a file system: Open opens a file by a name ValidPath accepts.
shape FS {
	Open(name str) !dyn File
}

// ReadDirFS is a file system that lists a directory by name, sorted by name.
shape ReadDirFS {
	FS
	ReadDir(name str) ![]DirEntry
}

// StatFS is a file system that describes a file by name.
shape StatFS {
	FS
	Stat(name str) !FileInfo
}

// ReadFileFS is a file system that reads a whole file by name.
shape ReadFileFS {
	FS
	ReadFile(name str) !str
}

// TreeFS lists directories and describes files: what WalkDir and Glob need.
shape TreeFS {
	ReadDirFS
	StatFS
}

// SubFS is a file system whose Sub gives the file system of one of its directories, of type S.
shape SubFS[S constraints.Any] {
	FS
	Sub(dir str) !S
}

// ValidPath reports whether name is a valid file system name: UTF-8, slash-separated elements
// that are not empty, "." or "..", no leading or trailing slash; "." alone names the root.
fn ValidPath(name str) bool {
	if !validUTF8(name) {
		return false
	}
	if name == "." {
		return true
	}
	mut start = i64(0)
	let n = i64(len(name))
	for {
		mut i = start
		for i < n && name[i] != '/' {
			i += 1
		}
		let k = i - start
		if k == 0 || (k == 1 && name[start] == '.') || (k == 2 && name[start] == '.' && name[start+1] == '.') {
			return false
		}
		if i == n {
			return true
		}
		start = i + 1
	}
	return true
}

// validUTF8 reports whether s is valid UTF-8 (Go's utf8.ValidString: no surrogates, no overlong forms).
fn validUTF8(s str) bool {
	let n = i64(len(s))
	mut i = i64(0)
	for i < n {
		let c = s[i]
		if c < 0x80 {
			i += 1
			continue
		}
		mut size = i64(0)
		mut lo = u8(0x80)
		mut hi = u8(0xbf)
		if c >= 0xc2 && c <= 0xdf {
			size = 2
		} else if c >= 0xe0 && c <= 0xef {
			size = 3
			if c == 0xe0 {
				lo = 0xa0
			} else if c == 0xed {
				hi = 0x9f
			}
		} else if c >= 0xf0 && c <= 0xf4 {
			size = 4
			if c == 0xf0 {
				lo = 0x90
			} else if c == 0xf4 {
				hi = 0x8f
			}
		} else {
			return false
		}
		if i+size > n {
			return false
		}
		let c1 = s[i+1]
		if c1 < lo || c1 > hi {
			return false
		}
		for j in 2..size {
			let cj = s[i+j]
			if cj < 0x80 || cj > 0xbf {
				return false
			}
		}
		i += size
	}
	return true
}

// PathError is err with the operation and the name in front ("op path: err"), as Go's
// fs.PathError prints; err stays reachable with fault.Is.
fn PathError(op str, path str, err fault) ! {
	fail fault.Wrap(err, op + " " + path)
}

// ReadFile reads the named file to its end: Open, Read until 0, Close.
fn ReadFile[F FS](fsys F, name str) !str {
	mut f = try fsys.Open(name)
	mut size = i64(0)
	let (info, serr) = f.Stat()
	if serr == nil && info.Size > 0 && info.Mode&ModeType == 0 {
		size = info.Size
	}
	mut out = make([]u8, 0, size+1)
	mut buf = make([]u8, 32768)
	for {
		let n = f.Read(mut buf) catch err {
			f.Close() catch e2 {
				fail fault.Join([]fault{err, e2})
			}
			fail err
		}
		if n <= 0 {
			break
		}
		out = append(out, buf[0:n]...)
	}
	try f.Close()
	return str(out)
}

// ReadDir lists the named directory, sorted by name.
fn ReadDir[F ReadDirFS](fsys F, name str) ![]DirEntry {
	return try fsys.ReadDir(name)
}

// Stat describes the named file.
fn Stat[F StatFS](fsys F, name str) !FileInfo {
	return try fsys.Stat(name)
}

// Sub is the file system of the directory dir of fsys: fsys itself for ".", else fsys.Sub(dir).
// A dir ValidPath refuses is "sub DIR: invalid argument".
fn Sub[S SubFS[S]](fsys S, dir str) !S {
	if !ValidPath(dir) {
		fail PathError("sub", dir, ErrInvalid)
	}
	if dir == "." {
		return fsys
	}
	return try fsys.Sub(dir)
}

// hasMeta reports whether a pattern has any of trail.Match's special bytes.
fn hasMeta(p str) bool {
	for i in 0..len(p) {
		let c = p[i]
		if c == '*' || c == '?' || c == '[' || c == '\\' {
			return true
		}
	}
	return false
}

// Glob lists the names that match pattern (trail.Match's syntax, per element), in lexical order
// within each directory, like Go's fs.Glob: a directory that cannot be read is skipped, a pattern
// with no special bytes gives itself when Stat finds it, and only a malformed pattern is a fault
// (ErrBadPattern).
fn Glob[F TreeFS](fsys F, pattern str) ![]str {
	return try globDepth(fsys, pattern, 0)
}

// globDepth is Glob below depth levels of directory patterns (Go stops at 10000, CVE-2022-30630).
fn globDepth[F TreeFS](fsys F, pattern str, depth i64) ![]str {
	if depth > 10000 {
		fail ErrBadPattern
	}
	let (_, merr) = trail.Match(pattern, "")
	if merr != nil {
		fail ErrBadPattern
	}
	if !hasMeta(pattern) {
		let (_, serr) = fsys.Stat(pattern)
		if serr != nil {
			return []str{}
		}
		return []str{pattern}
	}
	let (d, file) = trail.Split(pattern)
	mut dir = "."
	if d != "" {
		dir = d[0 : len(d)-1]
	}
	if !hasMeta(dir) {
		return try globIn(fsys, dir, file, []str{})
	}
	if dir == pattern {
		fail ErrBadPattern
	}
	let ds = try globDepth(fsys, dir, depth+1)
	mut out = []str{}
	for x in ds {
		out = try globIn(fsys, x, file, out)
	}
	return out
}

// globIn appends the names in dir that match pattern to matches; an unreadable dir adds none.
fn globIn[F TreeFS](fsys F, dir str, pattern str, matches []str) ![]str {
	mut out = matches
	let (list, rerr) = fsys.ReadDir(dir)
	if rerr != nil {
		return out
	}
	for e in list {
		let (ok, merr) = trail.Match(pattern, e.Name)
		if merr != nil {
			fail ErrBadPattern
		}
		if ok {
			out = append(out, trail.Join2(dir, e.Name))
		}
	}
	return out
}

// WalkDir calls f for root and every file and directory below it, in lexical order, like Go's
// fs.WalkDir: f gets the path (root joined with the names), the entry (nil when root cannot be
// described) and nil, or a fault: Stat's for root, or ReadDir's in a second call for a directory
// that cannot be listed. f's fault ends the walk and is WalkDir's, except SkipDir (skip this
// directory, or the rest of the one a file is in) and SkipAll (stop, with no fault). Symbolic
// links inside the tree are not followed; a root that is one is.
fn WalkDir[F TreeFS](fsys F, root str, f fn(str, ?DirEntry, fault) !) ! {
	let info = fsys.Stat(root) catch err {
		f(root, nil, err) catch e {
			if fault.Is(e, SkipDir) || fault.Is(e, SkipAll) {
				return
			}
			fail e
		}
		return
	}
	walkDir(fsys, root, FileInfoToDirEntry(info), f) catch e {
		if fault.Is(e, SkipDir) || fault.Is(e, SkipAll) {
			return
		}
		fail e
	}
}

// walkDir visits name and, for a directory, everything below it.
fn walkDir[F TreeFS](fsys F, name str, d DirEntry, f fn(str, ?DirEntry, fault) !) ! {
	f(name, d, nil) catch e {
		if fault.Is(e, SkipDir) && d.IsDir() {
			return
		}
		fail e
	}
	if !d.IsDir() {
		return
	}
	let list = fsys.ReadDir(name) catch err {
		f(name, d, err) catch e {
			if fault.Is(e, SkipDir) {
				return
			}
			fail e
		}
		[]DirEntry{}
	}
	for e1 in list {
		let name1 = trail.Join2(name, e1.Name)
		walkDir(fsys, name1, e1, f) catch e {
			if fault.Is(e, SkipDir) {
				break
			}
			fail e
		}
	}
}

// ModeString is a mode as Go's FileMode.String prints it: the type and special letters
// ("dalTLDpSugct?") or "-", then rwxrwxrwx with "-" for a missing permission.
fn ModeString(m i64) str {
	let letters = "dalTLDpSugct?"
	mut out = []u8{}
	for i in 0..len(letters) {
		if m&(i64(1)<<(31-i)) != 0 {
			out = append(out, letters[i])
		}
	}
	if len(out) == 0 {
		out = append(out, '-')
	}
	let rwx = "rwxrwxrwx"
	for i in 0..9 {
		if m&(i64(1)<<(8-i)) != 0 {
			out = append(out, rwx[i])
		} else {
			out = append(out, '-')
		}
	}
	return str(out)
}

// ---- the operating system's file tree ----

// DirFS is the file tree under a directory of the operating system, read through quarry (Go's
// os.DirFS): it is a TreeFS, a ReadFileFS and a SubFS[DirFS]. Names are joined to the root with a
// slash; a name ValidPath refuses fails with ErrInvalid, and the faults name the name, not the
// joined path, as Go's do.
type DirFS struct {
	root str
}

// Dir is the file tree under root.
fn Dir(root str) DirFS {
	return DirFS{root: root}
}

// Root is the directory the file system was made with.
fn (d DirFS) Root() str {
	return d.root
}

// join is the operating system path of name, or the PathError of op for an invalid name.
fn (d DirFS) join(op str, name str) !str {
	if d.root == "" {
		fail PathError(op, name, fault.Wrap(ErrInvalid, "fs: Dir with an empty root"))
	}
	if !ValidPath(name) || hasNUL(name) {
		fail PathError(op, name, ErrInvalid)
	}
	if d.root[len(d.root)-1] == '/' {
		return d.root + name
	}
	return d.root + "/" + name
}

// Open opens the named file or directory for reading.
fn (d DirFS) Open(name str) !dyn File {
	let full = try d.join("open", name)
	let fd = try openRead(full, name)
	let info = quarry.Stat(full) catch err {
		rt_sys_close(fd)
		fail osFault(err, full, name)
	}
	let fi = infoFrom(info, full)
	return osFile{name: name, full: full, info: fi, fd: fd, dir: fi.IsDir(), list: []DirEntry{}, listed: false, at: 0, closed: false}
}

// Stat describes the named file, following a symbolic link.
fn (d DirFS) Stat(name str) !FileInfo {
	let full = try d.join("stat", name)
	let info = quarry.Stat(full) catch err {
		fail osFault(err, full, name)
	}
	return infoFrom(info, full)
}

// Lstat describes the named file; a symbolic link is described itself.
fn (d DirFS) Lstat(name str) !FileInfo {
	let full = try d.join("lstat", name)
	let info = quarry.Lstat(full) catch err {
		fail osFault(err, full, name)
	}
	return infoFrom(info, full)
}

// ReadDir lists the named directory, sorted by name, with each entry's type (not following links).
fn (d DirFS) ReadDir(name str) ![]DirEntry {
	let full = try d.join("readdir", name)
	return try listDir(full, name, "open")
}

// ReadFile reads the whole named file with quarry.ReadFile (its 64 MiB bound and its waits in a task).
fn (d DirFS) ReadFile(name str) !str {
	let full = try d.join("readfile", name)
	let s = quarry.ReadFile(full) catch err {
		fail osFault(err, full, name)
	}
	return s
}

// Sub is the file tree under the directory dir of this one.
fn (d DirFS) Sub(dir str) !DirFS {
	let full = try d.join("sub", dir)
	return DirFS{root: full}
}

// listDir lists the directory at full; faults name name.
fn listDir(full str, name str, op str) ![]DirEntry {
	let es = quarry.ReadDirEntries(full) catch err {
		fail osFaultOp(err, full, name, op)
	}
	mut out = make([]DirEntry, 0, len(es))
	for e in es {
		out = append(out, DirEntry{Name: e.Name, Type: typeBits(e.Type)})
	}
	return out
}

// typeBits is the mode type bits of a quarry file type (a device counts as a character device).
fn typeBits(t quarry.FileType) i64 {
	return match t {
		Regular => 0
		Dir => ModeDir
		Symlink => ModeSymlink
		Fifo => ModeNamedPipe
		Socket => ModeSocket
		Device => ModeDevice | ModeCharDevice
	}
}

// infoFrom is the FileInfo of quarry's description of the file at full.
fn infoFrom(i quarry.FileInfo, full str) FileInfo {
	mut m = typeBits(i.Type) | (i.Perm & ModePerm)
	if i.Perm&0o4000 != 0 {
		m |= ModeSetuid
	}
	if i.Perm&0o2000 != 0 {
		m |= ModeSetgid
	}
	if i.Perm&0o1000 != 0 {
		m |= ModeSticky
	}
	return FileInfo{Name: trail.Base(full), Size: i.Size, Mode: m, ModTime: i.Mtime}
}

// hasNUL reports whether s holds a NUL byte, which no operating system path can carry.
fn hasNUL(s str) bool {
	for i in 0..len(s) {
		if s[i] == 0 {
			return true
		}
	}
	return false
}

// osFault is quarry's fault err about the path full rewritten as Go's PathError about name: the
// same operation and system text, matching ErrNotExist, ErrPermission or ErrExist as Go's errno does.
fn osFault(err fault, full str, name str) ! {
	fail osFaultOp(err, full, name, "")
}

// osFaultOp rewrites quarry's path to the Go operation and fs name.
fn osFaultOp(err fault, full str, name str, requestedOp str) ! {
	let msg = fault.Message(err)
	let mark = " " + full + ": "
	let at = indexOf(msg, mark)
	if at <= 0 {
		fail err
	}
	mut op = msg[0:at]
	if requestedOp != "" {
		op = requestedOp
	} else if op == "fdopendir" {
		op = readDirOp
	}
	let text = msg[at+len(mark) : len(msg)]
	fail PathError(op, name, textFault(text))
}

// indexOf is the first index of sub in s, or -1.
fn indexOf(s str, sub str) i64 {
	let n = i64(len(s))
	let k = i64(len(sub))
	mut i = i64(0)
	for i+k <= n {
		mut j = i64(0)
		for j < k && s[i+j] == sub[j] {
			j += 1
		}
		if j == k {
			return i
		}
		i += 1
	}
	return -1
}

// textFault is a fault with the system's text for an errno, carrying the identity of the
// sentinel Go's errno matches (ErrNotExist, ErrPermission, ErrExist), or none.
fn textFault(text str) ! {
	mut ident = i64(0)
	if text == errnoText(eNOENT) {
		ident = identOf(ErrNotExist)
	} else if text == errnoText(eACCES) || text == errnoText(ePERM) {
		ident = identOf(ErrPermission)
	} else if text == errnoText(eEXIST) || text == errnoText(eNOTEMPTY) {
		ident = identOf(ErrExist)
	}
	fail cast(fault, rt_fault_raw(cast(i64, text)+8, len(text), 0, ident))
}

// errnoFault is textFault for an errno value.
fn errnoFault(e i64) ! {
	fail textFault(errnoText(e))
}

// identOf is a sentinel's identity (design/interface_faults.md: the word 16 bytes before it).
fn identOf(f fault) i64 {
	return (cast(i64, f) - 16)[0]
}

// errnoText is the system's text for an errno with a lower-case first letter, as Go prints it.
fn errnoText(e i64) str {
	let p = rt_sys_strerror(e)
	let s = rt_str_from_raw(p, strlen(p))
	if len(s) > 0 && s[0] >= 'A' && s[0] <= 'Z' {
		store8(cast(i64, s)+8, i64(s[0])+32)
	}
	return s
}

// openRead opens the file at full for reading; faults name name.
fn openRead(full str, name str) !i64 {
	let fd = i64(i32(rt_sys_open(cast(i64, full)+8, 0, 0)))
	if fd < 0 {
		fail PathError("open", name, errnoFault(rt_errno()))
	}
	return fd
}

// osFile is a file or directory DirFS opened. As Go's os.File, its faults name the joined path.
type osFile struct {
	name   str
	full   str
	info   FileInfo
	fd     i64
	dir    bool
	list   []DirEntry
	listed bool
	at     i64
	closed bool
}

// Read reads the next bytes of the file into buf: 0 at the end. A directory cannot be read.
fn (f mut osFile) Read(buf mut []u8) !i64 {
	if f.closed {
		fail PathError("read", f.full, ErrClosed)
	}
	if f.dir {
		fail PathError("read", f.full, errnoFault(eISDIR))
	}
	if len(buf) == 0 {
		return 0
	}
	for {
		let n = rt_sys_read(f.fd, cast(i64, buf)[2], len(buf))
		if n >= 0 {
			return n
		}
		let e = rt_errno()
		if e != EINTR {
			fail PathError("read", f.full, errnoFault(e))
		}
	}
	return 0
}

// Stat describes the file as it was when it was opened.
fn (f osFile) Stat() !FileInfo {
	if f.closed {
		fail PathError("stat", f.full, ErrClosed)
	}
	return f.info
}

// ReadDir gives the directory's next n entries (all that are left for n <= 0), sorted by name;
// an empty slice at the end.
fn (f mut osFile) ReadDir(n i64) ![]DirEntry {
	if f.closed {
		fail PathError("readdir", f.full, ErrClosed)
	}
	if !f.dir {
		fail PathError(readDirOp, f.full, errnoFault(eNOTDIR))
	}
	if !f.listed {
		f.list = try listDir(f.full, f.full, "readdirent")
		f.listed = true
	}
	let left = i64(len(f.list)) - f.at
	mut k = left
	if n > 0 && n < k {
		k = n
	}
	let out = f.list[f.at : f.at+k]
	f.at += k
	return out
}

// Close closes the file; a second Close fails with ErrClosed.
fn (f mut osFile) Close() ! {
	if f.closed {
		fail PathError("close", f.full, ErrClosed)
	}
	f.closed = true
	if f.fd >= 0 {
		rt_sys_close(f.fd)
		f.fd = -1
	}
}
