package draw

import "image"
import "image/color"

// FloydSteinberg is the Src operator with Floyd-Steinberg error diffusion (Go's draw.FloydSteinberg.Draw): each pixel's
// error against the color dst keeps is spread to its unvisited neighbours.
fn FloydSteinberg(dst mut dyn Image, r0 image.Rectangle, src dyn image.Image, sp0 image.Point) {
	let c = clip(dst.Bounds(), r0, src.Bounds(), sp0, false, image.Rectangle{}, image.Point{})
	if c.r.Empty() {
		return
	}
	drawPaletted(mut dst, c.r, src, c.sp, true)
}

// clamp16 is i limited to 0..0xffff.
fn clamp16(i i32) i32 {
	if i < 0 {
		return 0
	}
	if i > 0xffff {
		return 0xffff
	}
	return i
}

// sqDiff is Go's squared difference shifted right by 2, in wrapping u32 arithmetic.
@wrap fn sqDiff(x i32, y i32) u32 {
	let d = u32(x - y)
	return (d * d) >> 2
}

// drawPaletted draws src onto dst with Src, choosing the nearest palette color directly when dst is Paletted, and with
// Floyd-Steinberg diffusion when dither is set.
fn drawPaletted(dst mut dyn Image, r image.Rectangle, src dyn image.Image, sp image.Point, dither bool) {
	mut dl = dst.Layout()
	let paletted = dl.Kind == image.KindPaletted
	mut palette = []i32{}
	mut base = i64(0)
	if paletted {
		palette = make([]i32, 4*len(dl.Palette))
		for i, col in dl.Palette {
			let (pr, pg, pb, pa) = col.RGBA()
			palette[4*i] = i32(pr)
			palette[4*i+1] = i32(pg)
			palette[4*i+2] = i32(pb)
			palette[4*i+3] = i32(pa)
		}
		base = offset(dl, r.Min.X, r.Min.Y, 1)
	}
	// The errors carried into the current and the next row, four channels per pixel, one spare pixel at each end.
	let w = r.Dx()
	mut cur = []i32{}
	mut next = []i32{}
	if dither {
		cur = make([]i32, 4*(w+2))
		next = make([]i32, 4*(w+2))
	}
	let nrgbaDst = dl.Kind == image.KindNRGBA || dl.Kind == image.KindNRGBA64
	for y in 0..r.Dy() {
		for x in 0..w {
			let s = src.At(sp.X+x, sp.Y+y)
			mut er = i32(s.R)
			mut eg = i32(s.G)
			mut eb = i32(s.B)
			mut ea = i32(s.A)
			if dither {
				er = clamp16(er + cur[4*(x+1)]/16)
				eg = clamp16(eg + cur[4*(x+1)+1]/16)
				eb = clamp16(eb + cur[4*(x+1)+2]/16)
				ea = clamp16(ea + cur[4*(x+1)+3]/16)
			}
			if paletted {
				mut best = i64(0)
				mut bestSum = u32(0xffffffff)
				for k in 0..len(dl.Palette) {
					let sum = sqDiff(er, palette[4*k]) + sqDiff(eg, palette[4*k+1]) + sqDiff(eb, palette[4*k+2]) + sqDiff(ea, palette[4*k+3])
					if sum < bestSum {
						best = k
						bestSum = sum
						if sum == 0 {
							break
						}
					}
				}
				dl.Pix[base+y*dl.Stride+x] = u8(best)
				if !dither {
					continue
				}
				er -= palette[4*best]
				eg -= palette[4*best+1]
				eb -= palette[4*best+2]
				ea -= palette[4*best+3]
			} else {
				mut out = color.RGBA64{R: u16(er), G: u16(eg), B: u16(eb), A: u16(ea)}
				// Go stores through Set(color.Color): its NRGBA models turn a zero alpha into the zero color.
				if nrgbaDst && ea == 0 {
					out = color.RGBA64{}
				}
				dst.Set(r.Min.X+x, r.Min.Y+y, out)
				if !dither {
					continue
				}
				let back = dst.At(r.Min.X+x, r.Min.Y+y)
				er -= i32(back.R)
				eg -= i32(back.G)
				eb -= i32(back.B)
				ea -= i32(back.A)
			}
			next[4*x] += er * 3
			next[4*x+1] += eg * 3
			next[4*x+2] += eb * 3
			next[4*x+3] += ea * 3
			next[4*(x+1)] += er * 5
			next[4*(x+1)+1] += eg * 5
			next[4*(x+1)+2] += eb * 5
			next[4*(x+1)+3] += ea * 5
			next[4*(x+2)] += er
			next[4*(x+2)+1] += eg
			next[4*(x+2)+2] += eb
			next[4*(x+2)+3] += ea
			cur[4*(x+2)] += er * 7
			cur[4*(x+2)+1] += eg * 7
			cur[4*(x+2)+2] += eb * 7
			cur[4*(x+2)+3] += ea * 7
		}
		if dither {
			let t = cur
			cur = next
			next = t
			for i in 0..len(next) {
				next[i] = 0
			}
		}
	}
}
