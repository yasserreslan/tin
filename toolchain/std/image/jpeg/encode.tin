package jpeg

import "image"
import "gauge"

type Entropy struct {
	data []u8
	acc i64
	count i64
}

// Encode writes an 8-bit baseline JPEG at a quality from 1 through 100.
fn Encode(src dyn image.Image, quality i64) str {
	if quality < 1 || quality > 100 { panic("jpeg: quality out of range") }
	let bounds = src.Bounds()
	let width = bounds.Dx()
	let height = bounds.Dy()
	if width <= 0 || height <= 0 || width*height > maxPixels || width > 65535 || height > 65535 { panic("jpeg: image dimensions exceed limit") }
	let gray = src.Layout().Kind == image.KindGray || src.Layout().Kind == image.KindGray16
	let subsample = !gray && quality < 90
	let scale = match quality < 50 { true => 5000/quality _ => 200-2*quality }
	let baseY = []i64{16, 11, 12, 14, 12, 10, 16, 14, 13, 14, 18, 17, 16, 19, 24, 40, 26, 24, 22, 22, 24, 49, 35, 37, 29, 40, 58, 51, 61, 60, 57, 51, 56, 55, 64, 72, 92, 78, 64, 68, 87, 69, 55, 56, 80, 109, 81, 87, 95, 98, 103, 104, 103, 62, 77, 113, 121, 112, 100, 120, 92, 101, 103, 99}
	let baseC = []i64{17, 18, 18, 24, 21, 24, 47, 26, 26, 47, 99, 66, 56, 66, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99}
	mut qy = [64]u8{}
	mut qc = [64]u8{}
	for i in 0..64 {
		mut yv = (baseY[i]*scale+50)/100
		mut cv = (baseC[i]*scale+50)/100
		if yv < 1 { yv = 1 }
		if yv > 255 { yv = 255 }
		if cv < 1 { cv = 1 }
		if cv > 255 { cv = 255 }
		qy[i] = u8(yv)
		qc[i] = u8(cv)
	}
	mut out = []u8{0xff, 0xd8}
	out = appendSegment(out, 0xdb, dqtPayload(qy, qc, gray))
	mut sof = []u8{8, u8(height>>8), u8(height), u8(width>>8), u8(width)}
	if gray { sof = append(sof, 1, 1, 0x11, 0) } else { sof = append(sof, 3, 1, u8(match subsample { true => 0x22 _ => 0x11 }), 0, 2, 0x11, 1, 3, 0x11, 1) }
	out = appendSegment(out, 0xc0, sof)
	out = appendSegment(out, 0xc4, dhtPayload(gray))
	mut sos = []u8{}
	if gray { sos = []u8{1, 1, 0, 0, 63, 0} } else { sos = []u8{3, 1, 0, 2, 0x11, 3, 0x11, 0, 63, 0} }
	out = appendSegment(out, 0xda, sos)
	mut bits = Entropy{data: []u8{}}
	let mcuW = match subsample { true => 16 _ => 8 }
	let mcuH = mcuW
	let cols = (width+mcuW-1)/mcuW
	let rows = (height+mcuH-1)/mcuH
	mut prevY = i64(0)
	mut prevCb = i64(0)
	mut prevCr = i64(0)
	for my in 0..rows {
		for mx in 0..cols {
			let perSide = match subsample { true => 2 _ => 1 }
			let blocks = perSide*perSide
			for by in 0..perSide {
				for bx in 0..perSide {
					let block = encodeBlock(src, bounds.Min.X+mx*mcuW+bx*8, bounds.Min.Y+my*mcuH+by*8, 0, qy, gray, false)
					prevY = emitBlock(mut bits, block, prevY, 0)
				}
			}
			if !gray {
				let cb = encodeBlock(src, bounds.Min.X+mx*mcuW, bounds.Min.Y+my*mcuH, 1, qc, false, subsample)
				let cr = encodeBlock(src, bounds.Min.X+mx*mcuW, bounds.Min.Y+my*mcuH, 2, qc, false, subsample)
				prevCb = emitBlock(mut bits, cb, prevCb, 1)
				prevCr = emitBlock(mut bits, cr, prevCr, 1)
			}
		}
	}
	bitsFlush(mut bits)
	out = append(out, bits.data...)
	out = append(out, 0xff, 0xd9)
	return str(out)
}

fn appendSegment(out []u8, marker i64, payload []u8) []u8 {
	mut s = append(out, 0xff, u8(marker), u8((len(payload)+2)>>8), u8(len(payload)+2))
	return append(s, payload...)
}

fn dqtPayload(y [64]u8, c [64]u8, gray bool) []u8 {
	mut p = []u8{0}
	for b in y { p = append(p, b) }
	if !gray { p = append(p, 1)
		for b in c { p = append(p, b) } }
	return p
}

fn dhtPayload(gray bool) []u8 {
	mut p = []u8{0}
	for _i in 0..3 { p = append(p, 0) }
	p = append(p, 12)
	for _i in 0..12 { p = append(p, 0) }
	for i in 0..12 { p = append(p, u8(i)) }
	p = appendAcTable(p, 0)
	if !gray { p = appendDCTable(p, 1)
		p = appendAcTable(p, 1) }
	return p
}

fn appendDCTable(p []u8, id i64) []u8 {
	mut out = append(p, u8(id))
	for _i in 0..3 { out = append(out, 0) }
	out = append(out, 12)
	for _i in 0..12 { out = append(out, 0) }
	for i in 0..12 { out = append(out, u8(i)) }
	return out
}

fn appendAcTable(p []u8, id i64) []u8 {
	mut out = append(p, u8(0x10+id))
	for _i in 0..8 { out = append(out, 0) }
	out = append(out, 255)
	for _i in 0..7 { out = append(out, 0) }
	for i in 0..255 { out = append(out, u8(i)) }
	return out
}

fn encodeBlock(src dyn image.Image, ox i64, oy i64, plane i64, q [64]u8, gray bool, average bool) [64]i64 {
	let bounds = src.Bounds()
	mut samples = [64]f64{}
	for y in 0..8 {
		for x in 0..8 {
			mut yy = i64(0)
			mut cb = i64(0)
			mut cr = i64(0)
			let factor = match average { true => 2 _ => 1 }
			let n = factor*factor
			for dy in 0..factor {
				for dx in 0..factor {
					let px = min(bounds.Max.X-1, ox+x*factor+dx)
					let py = min(bounds.Max.Y-1, oy+y*factor+dy)
					let c = src.At(px, py)
					let r = i64(c.R >> 8)
					let g = i64(c.G >> 8)
					let b = i64(c.B >> 8)
					yy += (19595*r+38470*g+7471*b+32768)>>16
					cb += ((-11056*r-21712*g+32768*b+32768)>>16)+128
					cr += ((32768*r-27440*g-5328*b+32768)>>16)+128
				}
			}
			mut value = yy
			if !gray && plane == 1 { value = cb/n }
			if !gray && plane == 2 { value = cr/n }
			samples[y*8+x] = f64(value)-128.0
		}
	}
	mut coeff = [64]i64{}
	for v in 0..8 { for u in 0..8 {
		mut sum = f64(0.0)
		for y in 0..8 { for x in 0..8 {
			sum += samples[y*8+x]*gauge.Cos((2.0*f64(x)+1.0)*f64(u)*gauge.Pi/16.0)*gauge.Cos((2.0*f64(y)+1.0)*f64(v)*gauge.Pi/16.0)
			} }
		let cu = match u { 0 => 0.7071067811865476 _ => 1.0 }
		let cv = match v { 0 => 0.7071067811865476 _ => 1.0 }
		let norm = 0.25*cu*cv
		let raw = sum*norm/f64(q[zigIndex(v*8+u)])
		mut rounded = i64(raw+0.5)
		if raw < 0.0 { rounded = -i64(-raw+0.5) }
		coeff[v*8+u] = rounded
		} }
	return coeff
}

fn emitBlock(bits mut Entropy, block [64]i64, previous i64, table i64) i64 {
	let dc = block[0]
	let delta = dc-previous
	let cat = magnitudeBits(delta)
	emitHuff(mut bits, u64(cat), 4)
	if cat > 0 {
		mut encoded = delta
		if delta < 0 { encoded -= 1 }
		emitBits(mut bits, u64(encoded), cat)
	}
	mut run = i64(0)
	for i in 1..64 {
		let value = block[zig(i)]
		if value == 0 { run += 1
			continue }
		for run >= 16 { emitHuff(mut bits, 0xf0, 9)
			run -= 16 }
		let size = magnitudeBits(value)
		emitHuff(mut bits, u64(run*16+size), 9)
		mut encoded = value
		if value < 0 { encoded -= 1 }
		emitBits(mut bits, u64(encoded), size)
		run = 0
	}
	if run > 0 { emitHuff(mut bits, 0, 9) }
	_ = table
	return dc
}

fn magnitudeBits(value i64) i64 {
	mut n = i64(0)
	mut v = value
	if value < 0 { v = -value }
	for v > 0 { n += 1
		v >>= 1 }
	return n
}

fn emitBits(bits mut Entropy, value u64, n i64) {
	for i in 0..n { bits.acc = (bits.acc<<1) | i64((value>>(n-i-1))&1)
		bits.count += 1
		if bits.count == 8 { let b = u8(bits.acc)
			bits.data = append(bits.data, b)
			if b == 0xff { bits.data = append(bits.data, 0) }
			bits.acc = 0
			bits.count = 0 } }
}

fn emitHuff(bits mut Entropy, value u64, n i64) { emitBits(mut bits, value, n) }

fn bitsFlush(bits mut Entropy) {
	if bits.count > 0 { let n = 8-bits.count
		emitBits(mut bits, u64((1<<n)-1), n) }
}

fn zigIndex(natural i64) i64 {
	for i in 0..64 { if zig(i) == natural { return i } }
	return 0
}
