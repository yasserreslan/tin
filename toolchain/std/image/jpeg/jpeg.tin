// Package jpeg decodes 8-bit JPEG images and writes quality-parameterized baseline JPEG images. EXIF orientation is left to the caller.
package jpeg

import "image"
import "image/color"
import "gauge"

const maxPixels = 64 * 1024 * 1024

type Huffman struct {
	counts [16]i64
	values []u8
}

type Component struct {
	id u8
	h i64
	v i64
	qt i64
	dc i64
	ac i64
	prev i64
	blocks [][64]i64
}

// Decode decodes an 8-bit baseline sequential JPEG into NRGBA64 pixels. EXIF orientation is left to the caller.
fn Decode(data str) !dyn image.Image {
	if len(data) < 4 || data[0] != 0xff || data[1] != 0xd8 {
		fail "jpeg: invalid signature"
	}
	mut quant = [256]i64{}
	mut haveQuant = [4]bool{}
	mut huff = []Huffman{}
	for _i in 0..8 { huff = append(huff, Huffman{values: []u8{}}) }
	mut components = []Component{}
	mut width = i64(0)
	mut height = i64(0)
	mut maxH = i64(0)
	mut maxV = i64(0)
	mut pos = i64(2)
	mut scanStart = i64(-1)
	mut scanEnd = i64(-1)
	mut restartInterval = i64(0)
	mut progressive = false
	for pos < len(data) {
		if data[pos] != 0xff { fail "jpeg: expected marker" }
		for pos < len(data) && data[pos] == 0xff { pos += 1 }
		if pos >= len(data) { fail "jpeg: truncated marker" }
		let marker = i64(u8(data[pos]))
		pos += 1
		if marker == 0xd9 { break }
		if marker == 0xd8 || (marker >= 0xd0 && marker <= 0xd7) { continue }
		if pos+2 > len(data) { fail "jpeg: truncated segment" }
		let n = be16(data, pos)
		if n < 2 || n > len(data)-pos { fail "jpeg: invalid segment length" }
		let body = pos+2
		let end = pos+n
		if marker == 0xc0 || marker == 0xc2 {
			if marker == 0xc2 { progressive = true }
			if marker == 0xc0 {
				if n < 8 { fail "jpeg: invalid frame header" }
				if data[body] != 8 { fail "jpeg: unsupported precision" }
				height = be16(data, body+1)
				width = be16(data, body+3)
				let count = i64(u8(data[body+5]))
				if count != 1 && count != 3 { fail "jpeg: unsupported component count" }
				if width <= 0 || height <= 0 || width*height > maxPixels { fail "jpeg: image dimensions exceed limit" }
				if n != 8+3*count { fail "jpeg: invalid frame length" }
				for i in 0..count {
					let at = body+6+3*i
					let hv = i64(u8(data[at+1]))
					let ch = hv >> 4
					let cv = hv & 15
					if ch < 1 || ch > 4 || cv < 1 || cv > 4 { fail "jpeg: invalid sampling factor" }
					maxH = max(maxH, ch)
					maxV = max(maxV, cv)
					components = append(components, Component{id: u8(data[at]), h: ch, v: cv, qt: i64(u8(data[at+2]))})
				}
			} else { fail "jpeg: progressive JPEG is not supported" }
		} else if marker == 0xdb {
			mut at = body
			for at < end {
				let info = i64(u8(data[at]))
				at += 1
				let table = info & 15
				if table > 3 || info >> 4 != 0 || at+64 > end { fail "jpeg: invalid quantization table" }
				for i in 0..64 { quant[table*64+zig(i)] = i64(u8(data[at+i])) }
				haveQuant[table] = true
				at += 64
			}
		} else if marker == 0xc4 {
			mut at = body
			for at < end {
				if at+17 > end { fail "jpeg: invalid Huffman table" }
				let info = i64(u8(data[at]))
				let kind = info >> 4
				let table = info & 15
				if kind > 1 || table > 3 { fail "jpeg: invalid Huffman table id" }
				mut total = i64(0)
				let hi = kind*4+table
				for i in 0..16 {
					huff[hi].counts[i] = i64(u8(data[at+1+i]))
					total += huff[hi].counts[i]
				}
				at += 17
				if total == 0 || total > 256 || at+total > end { fail "jpeg: invalid Huffman values" }
				huff[hi].values = []u8{}
				for i in 0..total { huff[hi].values = append(huff[hi].values, u8(data[at+i])) }
				at += total
			}
		} else if marker == 0xdd {
			if n != 4 { fail "jpeg: invalid restart interval" }
			restartInterval = be16(data, body)
		} else if marker == 0xda {
			if len(components) == 0 || n < 6 { fail "jpeg: scan without frame" }
			let count = i64(u8(data[body]))
			if count != len(components) || n != 6+2*count { fail "jpeg: non-interleaved scans are unsupported" }
			for i in 0..count {
				let at = body+1+2*i
				let id = u8(data[at])
				let selector = i64(u8(data[at+1]))
				mut found = false
				for j in 0..len(components) {
					if components[j].id == id {
						components[j].dc = selector >> 4
						components[j].ac = selector & 15
						found = true
					}
				}
				if !found || components[i].dc > 3 || components[i].ac > 3 { fail "jpeg: invalid scan component" }
			}
			if data[end-3:end] != "\x00\x3f\x00" { fail "jpeg: unsupported scan parameters" }
			scanStart = end
			mut p = end
			for p+1 < len(data) {
				if data[p] == 0xff && data[p+1] >= 0xd0 && data[p+1] <= 0xd7 {
					p += 2
					continue
				}
				if data[p] == 0xff && data[p+1] != 0x00 {
					scanEnd = p
					break
				}
				if data[p] == 0xff { p += 2 } else { p += 1 }
			}
			break
		}
		pos = end
	}
	if progressive { fail "jpeg: progressive JPEG is not supported" }
	if scanStart < 0 || scanEnd < scanStart || width == 0 { fail "jpeg: missing image scan" }
	for i in 0..len(components) {
		if !haveQuant[components[i].qt] { fail "jpeg: missing quantization table" }
		if components[i].h > maxH || components[i].v > maxV { fail "jpeg: invalid sampling factors" }
	}
	let mcuW = maxH*8
	let mcuH = maxV*8
	let mcuCols = (width+mcuW-1)/mcuW
	let mcuRows = (height+mcuH-1)/mcuH
	for i in 0..len(components) {
		components[i].blocks = make([][64]i64, mcuCols*mcuRows*components[i].h*components[i].v)
	}
	let basis = idctBasis()
	mut bits = Bits{data: data, pos: scanStart, end: scanEnd}
	for my in 0..mcuRows {
		for mx in 0..mcuCols {
			for ci in 0..len(components) {
				for by in 0..components[ci].v {
					for bx in 0..components[ci].h {
						let (block, previous) = try readBlock(mut bits, huff[components[ci].dc], huff[4+components[ci].ac], components[ci].prev)
						components[ci].prev = previous
						let idx = (my*mcuCols+mx)*components[ci].h*components[ci].v + by*components[ci].h+bx
						components[ci].blocks[idx] = block
					}
				}
			}
			if restartInterval > 0 && ((my*mcuCols+mx+1) % restartInterval) == 0 && my*mcuCols+mx+1 < mcuCols*mcuRows {
				bits.align()
				for i in 0..len(components) { components[i].prev = 0 }
				bits.skipRestart() catch err { fail "jpeg: invalid restart marker {err}" }
			}
		}
	}
	mut out = image.NewNRGBA64(image.Rect(0, 0, width, height))
	for y in 0..height {
		for x in 0..width {
			let yy = sample(mut components[0], quant[components[0].qt*64:components[0].qt*64+64], basis, x, y, maxH, maxV, mcuCols)
			mut r = yy
			mut g = yy
			mut b = yy
			if len(components) == 3 {
				let cb = sample(mut components[1], quant[components[1].qt*64:components[1].qt*64+64], basis, x, y, maxH, maxV, mcuCols)-128.0
				let cr = sample(mut components[2], quant[components[2].qt*64:components[2].qt*64+64], basis, x, y, maxH, maxV, mcuCols)-128.0
				r = yy + 1.402*cr
				g = yy - 0.344136*cb - 0.714136*cr
				b = yy + 1.772*cb
			}
			out.SetNRGBA64(x, y, color.NRGBA64{R: unit16(r), G: unit16(g), B: unit16(b), A: 0xffff})
		}
	}
	return out
}

type Bits struct {
	data str
	pos i64
	end i64
	acc u64
	count i64
}

fn be16(s str, at i64) i64 {
	return i64(u8(s[at]))<<8 | i64(u8(s[at+1]))
}

fn (b mut Bits) bit() !i64 {
	if b.count == 0 {
		if b.pos >= b.end { fail "truncated entropy data" }
		let v = u8(b.data[b.pos])
		b.pos += 1
		mut byte = v
		if v == 0xff {
			if b.pos >= b.end || b.data[b.pos] != 0 { fail "jpeg: invalid stuffed byte" }
			b.pos += 1
			byte = 0xff
		}
		b.acc = u64(byte)
		b.count = 8
	}
	b.count -= 1
	return i64((b.acc >> b.count) & 1)
}

fn (b mut Bits) take(n i64) !i64 {
	mut value = i64(0)
	mut i = i64(0)
	for i < n {
		let next = try b.bit()
		value = (value<<1) | next
		i += 1
	}
	return value
}

fn (b mut Bits) align() {
	b.count = 0
}

fn (b mut Bits) skipRestart() ! {
	if b.pos+2 > b.end || b.data[b.pos] != 0xff || b.data[b.pos+1] < 0xd0 || b.data[b.pos+1] > 0xd7 { fail "marker missing" }
	b.pos += 2
}

fn (b mut Bits) symbol(h Huffman) !i64 {
	mut code = i64(0)
	mut index = i64(0)
	for length in 0..16 {
			let next = try b.bit()
			code = (code<<1) | next
		let count = h.counts[length]
		if code < count { return i64(h.values[index+code]) }
		index += count
		code -= count
	}
	fail "jpeg: invalid Huffman code"
}

fn readBlock(bits mut Bits, dc Huffman, ac Huffman, previous i64) !([64]i64, i64) {
	mut coefficients = [64]i64{}
	let category = try bits.symbol(dc)
	if category > 11 { fail "jpeg: invalid DC category" }
	mut delta = try bits.take(category)
	if category > 0 && delta < (1<<(category-1)) { delta -= (1<<category)-1 }
	let nextPrevious = previous+delta
	coefficients[0] = nextPrevious
	mut at = i64(1)
	for at < 64 {
		let runSize = try bits.symbol(ac)
		if runSize == 0 { break }
		let run = runSize >> 4
		let size = runSize & 15
		if size == 0 {
			if run != 15 { break }
			at += 16
			continue
		}
		at += run
		if at >= 64 || size > 10 { fail "jpeg: invalid AC coefficient" }
		mut value = try bits.take(size)
		if value < (1<<(size-1)) { value -= (1<<size)-1 }
		coefficients[zig(at)] = value
		at += 1
	}
	return coefficients, nextPrevious
}

fn idctBasis() []f64 {
	mut basis = make([]f64, 64)
	for u in 0..8 {
		let scale = match u { 0 => 0.7071067811865476 _ => 1.0 }
		for x in 0..8 {
			basis[u*8+x] = scale*gauge.Cos((2.0*f64(x)+1.0)*f64(u)*gauge.Pi/16.0)
		}
	}
	return basis
}

fn sample(component mut Component, quant []i64, basis []f64, x i64, y i64, maxH i64, maxV i64, mcuCols i64) f64 {
	let sx = x*component.h/maxH
	let sy = y*component.v/maxV
	let blockX = sx/8
	let blockY = sy/8
	let withinX = sx%8
	let withinY = sy%8
	let blocksWide = mcuCols*component.h
	let idx = ((blockY/component.v)*mcuCols+(blockX/component.h))*component.h*component.v + (blockY%component.v)*component.h + blockX%component.h
	let block = component.blocks[idx]
	mut sum = f64(0.0)
	for v in 0..8 {
		for u in 0..8 {
			sum += f64(block[v*8+u]*quant[v*8+u])*basis[u*8+withinX]*basis[v*8+withinY]
		}
	}
	return sum*0.25+128.0
}

fn unit16(v f64) u16 {
	if v <= 0.0 { return 0 }
	if v >= 255.0 { return 0xffff }
	return u16(u32(v+0.5)*0x101)
}

fn zig(index i64) i64 {
	mut ordinal = i64(0)
	for diagonal in 0..15 {
		let low = max(0, diagonal-7)
		let high = min(7, diagonal)
		if diagonal%2 == 0 {
			for offset in 0..high-low+1 {
				let v = high-offset
				let u = diagonal-v
				if ordinal == index { return v*8+u }
				ordinal += 1
			}
		} else {
			for offset in 0..high-low+1 {
				let u = high-offset
				let v = diagonal-u
				if ordinal == index { return v*8+u }
				ordinal += 1
			}
		}
	}
	return 0
}
