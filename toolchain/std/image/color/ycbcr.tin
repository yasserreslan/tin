package color

// YCbCr is an opaque Y'CbCr color, 8 bits per channel (JFIF's full-range conversion).
type YCbCr value struct {
	Y  u8
	Cb u8
	Cr u8
}

// NYCbCrA is a Y'CbCr color with an alpha that is not premultiplied.
type NYCbCrA value struct {
	Y  u8
	Cb u8
	Cr u8
	A  u8
}

// CMYK is an opaque cyan, magenta, yellow and black color, 8 bits per channel.
type CMYK value struct {
	C u8
	M u8
	Y u8
	K u8
}

// clamp8 is Go's clamp of a 16.16 fixed-point channel to 0..255.
@wrap fn clamp8(v i32) u8 {
	if u32(v) & 0xff000000 == 0 {
		return u8(v >> 16)
	}
	return u8(^(v >> 31))
}

// clamp16 is Go's clamp of a 16.16 fixed-point channel to 0..0xffff.
@wrap fn clamp16(v i32) u32 {
	if u32(v) & 0xff000000 == 0 {
		return u32(v >> 8)
	}
	return u32(^(v >> 31) & 0xffff)
}

// RGBToYCbCr converts an RGB triple to a Y'CbCr triple.
@wrap fn RGBToYCbCr(r u8, g u8, b u8) (u8, u8, u8) {
	let r1 = i32(r)
	let g1 = i32(g)
	let b1 = i32(b)
	let yy = (19595*r1 + 38470*g1 + 7471*b1 + (1 << 15)) >> 16
	let cb = -11056*r1 - 21712*g1 + 32768*b1 + (257 << 15)
	let cr = 32768*r1 - 27440*g1 - 5328*b1 + (257 << 15)
	return u8(yy), clamp8(cb), clamp8(cr)
}

// YCbCrToRGB converts a Y'CbCr triple to an RGB triple.
@wrap fn YCbCrToRGB(y u8, cb u8, cr u8) (u8, u8, u8) {
	let yy1 = i32(y) * 0x10101
	let cb1 = i32(cb) - 128
	let cr1 = i32(cr) - 128
	return clamp8(yy1 + 91881*cr1), clamp8(yy1 - 22554*cb1 - 46802*cr1), clamp8(yy1 + 116130*cb1)
}

// ycc16 is Go's 16-bit RGB of a Y'CbCr triple.
@wrap fn ycc16(y u8, cb u8, cr u8) (u32, u32, u32) {
	let yy1 = i32(y) * 0x10101
	let cb1 = i32(cb) - 128
	let cr1 = i32(cr) - 128
	return clamp16(yy1 + 91881*cr1), clamp16(yy1 - 22554*cb1 - 46802*cr1), clamp16(yy1 + 116130*cb1)
}

// RGBA is the color's 16-bit premultiplied channels.
fn (c YCbCr) RGBA() (u32, u32, u32, u32) {
	let (r, g, b) = ycc16(c.Y, c.Cb, c.Cr)
	return r, g, b, 0xffff
}

// RGBA is the color's 16-bit premultiplied channels.
fn (c NYCbCrA) RGBA() (u32, u32, u32, u32) {
	let (r, g, b) = ycc16(c.Y, c.Cb, c.Cr)
	let a = u32(c.A) * 0x101
	return r * a / 0xffff, g * a / 0xffff, b * a / 0xffff, a
}

// ToYCbCr is c in the YCbCr model.
fn ToYCbCr[C Color](c C) YCbCr {
	let (r, g, b, _) = c.RGBA()
	let (y, u, v) = RGBToYCbCr(u8(r >> 8), u8(g >> 8), u8(b >> 8))
	return YCbCr{Y: y, Cb: u, Cr: v}
}

// ToNYCbCrA is c in the NYCbCrA model.
fn ToNYCbCrA[C Color](c C) NYCbCrA {
	mut (r, g, b, a) = c.RGBA()
	if a != 0 {
		r = r * 0xffff / a
		g = g * 0xffff / a
		b = b * 0xffff / a
	}
	let (y, u, v) = RGBToYCbCr(u8(r >> 8), u8(g >> 8), u8(b >> 8))
	return NYCbCrA{Y: y, Cb: u, Cr: v, A: u8(a >> 8)}
}

// RGBToCMYK converts an RGB triple to a CMYK quadruple.
fn RGBToCMYK(r u8, g u8, b u8) (u8, u8, u8, u8) {
	let rr = u32(r)
	let gg = u32(g)
	let bb = u32(b)
	let w = max(rr, gg, bb)
	if w == 0 {
		return 0, 0, 0, 0xff
	}
	return u8((w - rr) * 0xff / w), u8((w - gg) * 0xff / w), u8((w - bb) * 0xff / w), u8(0xff - w)
}

// CMYKToRGB converts a CMYK quadruple to an RGB triple.
fn CMYKToRGB(c u8, m u8, y u8, k u8) (u8, u8, u8) {
	let (r, g, b) = cmyk16(c, m, y, k)
	return u8(r >> 8), u8(g >> 8), u8(b >> 8)
}

fn cmyk16(c u8, m u8, y u8, k u8) (u32, u32, u32) {
	let w = 0xffff - u32(k) * 0x101
	return (0xffff - u32(c) * 0x101) * w / 0xffff, (0xffff - u32(m) * 0x101) * w / 0xffff, (0xffff - u32(y) * 0x101) * w / 0xffff
}

// RGBA is the color's 16-bit premultiplied channels.
fn (c CMYK) RGBA() (u32, u32, u32, u32) {
	let (r, g, b) = cmyk16(c.C, c.M, c.Y, c.K)
	return r, g, b, 0xffff
}

// ToCMYK is c in the CMYK model.
fn ToCMYK[C Color](c C) CMYK {
	let (r, g, b, _) = c.RGBA()
	let (cc, mm, yy, kk) = RGBToCMYK(u8(r >> 8), u8(g >> 8), u8(b >> 8))
	return CMYK{C: cc, M: mm, Y: yy, K: kk}
}
