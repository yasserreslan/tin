// Package image is Go's image: points and rectangles, the Image shape, and the images that keep their pixels in one
// byte slice (RGBA, RGBA64, NRGBA, NRGBA64, Gray, Gray16, Alpha, Alpha16, Paletted) plus Uniform. Pixels are never
// allocated one by one: an image is a Pix slice, a Stride and a Rect, laid out exactly as in Go.
//
//	mut m = image.NewRGBA(image.Rect(0, 0, 640, 480))
//	m.SetRGBA(10, 20, color.RGBA{R: 255, A: 255})
//	let c = m.At(10, 20)
//
// Image's At gives a pixel as color.RGBA64 (Go's RGBA64At), so reading a pixel through the shape allocates nothing; each
// image also has its own typed accessors (RGBAAt, GrayAt, ColorIndexAt...). Layout tells which concrete image a
// dyn Image is and gives its pixel buffer: it is how image/draw and image/png take their fast paths, and how a caller
// gets the concrete image back (AsRGBA, AsNRGBA...).
package image

import "image/color"

// Image is a rectangle of colors (Go's image.Image): At is the 16-bit premultiplied color at (x, y) (outside Bounds,
// the zero color, or a Paletted image's first palette color), and Layout describes the pixel buffer (Custom for
// an image without one).
shape Image {
	ColorModel() color.Model
	Bounds() Rectangle
	At(x i64, y i64) color.RGBA64
	Layout() Layout
}

// Config is an image's color model and size, as a decoder reads them from the header.
type Config value struct {
	ColorModel color.Model
	Width      i64
	Height     i64
}

// Kind says which concrete image a Layout describes.
type Kind i64

// Custom is an image of another package, with no pixel buffer the image package knows.
const Custom Kind = 0

// KindRGBA is an RGBA image.
const KindRGBA Kind = 1

// KindRGBA64 is an RGBA64 image.
const KindRGBA64 Kind = 2

// KindNRGBA is an NRGBA image.
const KindNRGBA Kind = 3

// KindNRGBA64 is an NRGBA64 image.
const KindNRGBA64 Kind = 4

// KindAlpha is an Alpha image.
const KindAlpha Kind = 5

// KindAlpha16 is an Alpha16 image.
const KindAlpha16 Kind = 6

// KindGray is a Gray image.
const KindGray Kind = 7

// KindGray16 is a Gray16 image.
const KindGray16 Kind = 8

// KindPaletted is a Paletted image.
const KindPaletted Kind = 9

// KindUniform is a Uniform image (no pixel buffer: every pixel is its color).
const KindUniform Kind = 10

// String is the kind's type name, such as "RGBA".
fn (k Kind) String() str {
	return match k {
		KindRGBA => "RGBA"
		KindRGBA64 => "RGBA64"
		KindNRGBA => "NRGBA"
		KindNRGBA64 => "NRGBA64"
		KindAlpha => "Alpha"
		KindAlpha16 => "Alpha16"
		KindGray => "Gray"
		KindGray16 => "Gray16"
		KindPaletted => "Paletted"
		KindUniform => "Uniform"
		_ => "Custom"
	}
}

// Layout is how an image keeps its pixels: the pixel at (x, y) starts at Pix[(y-Rect.Min.Y)*Stride + (x-Rect.Min.X)*n]
// with n bytes per pixel (4 for RGBA and NRGBA, 8 for RGBA64 and NRGBA64, 2 for Gray16 and Alpha16, 1 otherwise; 16-bit
// channels are big-endian). Palette is a Paletted image's.
type Layout value struct {
	Kind    Kind
	Pix     []u8
	Stride  i64
	Rect    Rectangle
	Palette []color.NRGBA
}

// pixelBufferLength is n*r.Dx()*r.Dy(), or a panic (Go's message) for a negative or huge size.
fn pixelBufferLength(n i64, r Rectangle, name str) i64 {
	let w = r.Dx()
	let h = r.Dy()
	if w < 0 || h < 0 || (w > 0 && h > (i64(1) << 62) / w / n) {
		panic("image: New{name} Rectangle has huge or negative dimensions")
	}
	return n * w * h
}

// AsRGBA is m as the RGBA image it is (sharing its pixels), or nil.
fn AsRGBA(m dyn Image) ?RGBA {
	let l = m.Layout()
	if l.Kind != KindRGBA {
		return nil
	}
	return RGBA{Pix: l.Pix, Stride: l.Stride, Rect: l.Rect}
}

// AsRGBA64 is m as the RGBA64 image it is (sharing its pixels), or nil.
fn AsRGBA64(m dyn Image) ?RGBA64 {
	let l = m.Layout()
	if l.Kind != KindRGBA64 {
		return nil
	}
	return RGBA64{Pix: l.Pix, Stride: l.Stride, Rect: l.Rect}
}

// AsNRGBA is m as the NRGBA image it is (sharing its pixels), or nil.
fn AsNRGBA(m dyn Image) ?NRGBA {
	let l = m.Layout()
	if l.Kind != KindNRGBA {
		return nil
	}
	return NRGBA{Pix: l.Pix, Stride: l.Stride, Rect: l.Rect}
}

// AsNRGBA64 is m as the NRGBA64 image it is (sharing its pixels), or nil.
fn AsNRGBA64(m dyn Image) ?NRGBA64 {
	let l = m.Layout()
	if l.Kind != KindNRGBA64 {
		return nil
	}
	return NRGBA64{Pix: l.Pix, Stride: l.Stride, Rect: l.Rect}
}

// AsAlpha is m as the Alpha image it is (sharing its pixels), or nil.
fn AsAlpha(m dyn Image) ?Alpha {
	let l = m.Layout()
	if l.Kind != KindAlpha {
		return nil
	}
	return Alpha{Pix: l.Pix, Stride: l.Stride, Rect: l.Rect}
}

// AsAlpha16 is m as the Alpha16 image it is (sharing its pixels), or nil.
fn AsAlpha16(m dyn Image) ?Alpha16 {
	let l = m.Layout()
	if l.Kind != KindAlpha16 {
		return nil
	}
	return Alpha16{Pix: l.Pix, Stride: l.Stride, Rect: l.Rect}
}

// AsGray is m as the Gray image it is (sharing its pixels), or nil.
fn AsGray(m dyn Image) ?Gray {
	let l = m.Layout()
	if l.Kind != KindGray {
		return nil
	}
	return Gray{Pix: l.Pix, Stride: l.Stride, Rect: l.Rect}
}

// AsGray16 is m as the Gray16 image it is (sharing its pixels), or nil.
fn AsGray16(m dyn Image) ?Gray16 {
	let l = m.Layout()
	if l.Kind != KindGray16 {
		return nil
	}
	return Gray16{Pix: l.Pix, Stride: l.Stride, Rect: l.Rect}
}

// AsPaletted is m as the Paletted image it is (sharing its pixels and palette), or nil.
fn AsPaletted(m dyn Image) ?Paletted {
	let l = m.Layout()
	if l.Kind != KindPaletted {
		return nil
	}
	return Paletted{Pix: l.Pix, Stride: l.Stride, Rect: l.Rect, Palette: l.Palette}
}
