package stencil

// Execution: the node walk, the pipelines, the builtins and the bounds (a template recursion
// limit and a maximum output size).
//
// The dot and the variables live in a per-execution cell bound to a runtime slot (the pattern
// policy.Bind uses), because storing request memory into a struct that a method receives would be
// E312 ARG_ESCAPE: the runtime's slot call is the store.

import "fault"
import "say"
import "twine"

// maxDepth bounds {{template}} recursion. Go's limit is 100000; Tin's main thread has a fixed
// stack (ulimit -s), so a lower bound is what fits: 1000 levels of walk and doCall.
const maxDepth = 1000

const maxOutput = 64 * 1024 * 1024

// execCell is the mutable part of one execution: the current dot and the variables.
type execCell struct {
	dot    Value
	vars   map[str]Value
	frames [][]savedVar
}

// savedVar is what a $x := inside a block shadowed: the variable's value before it, if it had one.
type savedVar struct {
	name  str
	value Value
	had   bool
}

// State is one execution of a template.
type State struct {
	tpl   Template
	key   i64
	w     twine.Builder
	depth i64
}

// cell returns the execution's cell: the slot node is [next, key, value].
fn (st State) cell() execCell {
	let n = rt_slot_find(st.key)
	if n == 0 {
		panic("stencil: no execution cell")
	}
	return cast(execCell, n[2])
}

// push opens a variable scope: $x := inside it is dropped when pop restores what it shadowed.
fn (st State) push() {
	let c = st.cell()
	c.frames = append(c.frames, []savedVar{})
}

// pop closes the scope push opened, restoring every variable it shadowed and dropping the rest.
fn (st State) pop() {
	let c = st.cell()
	let frame = c.frames[len(c.frames)-1]
	c.frames = c.frames[:len(c.frames)-1]
	mut i = len(frame) - 1
	for i >= 0 {
		let sv = frame[i]
		if sv.had {
			c.vars[sv.name] = sv.value
		} else {
			delete(c.vars, sv.name)
		}
		i -= 1
	}
}

// block renders nodes in a new variable scope: a $x := inside is dropped when the block ends (its
// previous value restored if it shadowed one), while $x = reaches the variable it was declared
// in, as Go's template does.
fn (st State) block(nodes []Node) ! {
	st.push()
	try st.walk(nodes)
	st.pop()
}

// declare sets a variable declared with :=, remembering in the current scope what it shadowed.
fn (st State) declare(name str, v Value) {
	let c = st.cell()
	if len(c.frames) > 0 {
		let frame = c.frames[len(c.frames)-1]
		mut seen = false
		for _, sv in frame {
			if sv.name == name {
				seen = true
			}
		}
		if !seen {
			let (old, had) = c.vars[name]
			c.frames[len(c.frames)-1] = append(frame, savedVar{name: name, value: old, had: had})
		}
	}
	c.vars[name] = v
}

// set assigns a variable: a declaration ($x :=) shadows, an assignment ($x =) reaches the
// variable that was declared.
fn (st State) set(name str, v Value, isSet bool) ! {
	if isSet {
		let c = st.cell()
		let (_, ok) = c.vars[name]
		if !ok {
			fail say.Fault("stencil: undefined variable: %s", name)
		}
		c.vars[name] = v
	} else {
		st.declare(name, v)
	}
}

// walk renders a node list.
fn (st State) walk(nodes []Node) ! {
	for _, n in nodes {
		match n {
			Text(s) => {
				try st.emit(s)
			}
			Action(p, mode) => {
				let v = try st.evalPipe(p)
				if p.hasAssign {
					try st.set(p.assign, v, p.isSet)
				} else {
					let out = try actionOutput(mode, v)
					try st.emit(out)
				}
			}
			If(b) => {
				// The if's own scope: a variable its pipe declares lives to its end.
				st.push()
				let v = try st.evalPipe(b.pipe)
				if b.pipe.hasAssign {
					try st.set(b.pipe.assign, v, b.pipe.isSet)
				}
				if truthy(v) {
					try st.block(b.then)
				} else {
					try st.block(b.otherwise)
				}
				st.pop()
			}
			With(b) => {
				// The with's own scope, like the if's.
				st.push()
				let v = try st.evalPipe(b.pipe)
				let c = st.cell()
				if b.pipe.hasAssign {
					try st.set(b.pipe.assign, v, b.pipe.isSet)
				}
				if truthy(v) {
					let save = c.dot
					c.dot = v
					try st.block(b.then)
					c.dot = save
				} else {
					try st.block(b.otherwise)
				}
				st.pop()
			}
			Range(r) => {
				try st.doRange(r)
			}
			Call(c) => {
				try st.doCall(c)
			}
		}
	}
}

// emit appends to the output, enforcing the size bound.
fn (st State) emit(s str) ! {
	let c = st.cell()
	if st.w.Len() + len(s) > maxOutput {
		fail fault.Wrap(fault.LimitExceeded, say.Fmt("stencil: output over %d bytes", maxOutput))
	}
	st.w.Str(s)
}

// doRange renders a range node.
fn (st State) doRange(r RangeNode) ! {
	st.push()
	let v = try st.evalPipe(r.pipe)
	let c = st.cell()
	if r.pipe.hasAssign {
		try st.set(r.pipe.assign, v, r.pipe.isSet)
	}
	let save = c.dot
	mut count = i64(0)
	if v.kind == KindInt && len(r.keyVar) > 0 {
		fail say.Fault("stencil: can't use %d to iterate over more than one variable", v.n)
	}
	if v.kind == KindStr || v.kind == KindFloat || v.kind == KindBool {
		fail say.Fault("stencil: range can't iterate over %s", printValue(v))
	}
	if v.kind == KindList {
		for i, item in v.xs {
			st.setLoop(r, i, item)
			try st.block(r.body)
			count += 1
		}
	} else if v.kind == KindMap {
		for _, k in sortedKeys(v.m) {
			st.setLoop(r, 0, None())
			if len(r.keyVar) > 0 {
				st.declare(r.keyVar, Str(k))
			}
			c.dot = v.m[k]
			if len(r.valVar) > 0 {
				st.declare(r.valVar, c.dot)
			}
			try st.block(r.body)
			count += 1
		}
	} else if v.kind == KindInt {
		// Go 1.22 ranges over integers: 0 to n-1.
		mut i = i64(0)
		for i < v.n {
			st.setLoop(r, i, Int(i))
			try st.block(r.body)
			count += 1
			i += 1
		}
	}
	if count == 0 {
		try st.block(r.otherwise)
	}
	st.pop()
	c.dot = save
}

// setLoop sets the range variables and the dot for one iteration.
fn (st State) setLoop(r RangeNode, i i64, item Value) {
	let c = st.cell()
	if len(r.keyVar) > 0 {
		st.declare(r.keyVar, Int(i))
	}
	if len(r.valVar) > 0 {
		st.declare(r.valVar, item)
	}
	c.dot = item
}

// doCall renders {{template "name" pipe}}.
fn (st State) doCall(c TemplateCall) ! {
	if st.depth >= maxDepth {
		fail fault.Wrap(fault.LimitExceeded, say.Fmt("stencil: template depth over %d", maxDepth))
	}
	mut nodes = []Node{}
	if c.name == st.tpl.name {
		nodes = st.tpl.root
	} else {
		let (n, ok) = st.tpl.defs[c.name]
		if !ok {
			fail say.Fault("stencil: no template %q", c.name)
		}
		nodes = n
	}
	mut data = None()
	if c.hasPipe {
		data = try st.evalPipe(c.pipe)
	}
	let outer = st.cell()
	let saveDot = outer.dot
	let saveVars = outer.vars
	mut inner = execCell{dot: data, vars: make(map[str]Value)}
	inner.vars["$"] = data
	let innerKey = cast(i64, inner)
	rt_slot_bind(innerKey, cast(i64, inner))
	mut sub = State{tpl: st.tpl, key: innerKey, w: st.w, depth: st.depth + 1}
	try sub.walk(nodes)
	outer.dot = saveDot
	outer.vars = saveVars
}

// evalPipe evaluates a pipeline.
fn (st State) evalPipe(p Pipe) !Value {
	mut v = None()
	mut first = true
	for _, c in p.cmds {
		v = try st.evalCmd(c, v, first)
		first = false
	}
	return v
}

// evalCmd evaluates one command, with the piped value appended as the last argument.
fn (st State) evalCmd(c Cmd, piped Value, first bool) !Value {
	match c.args[0] {
		Nil => {
			fail say.Fault("stencil: nil is not a command")
		}
		_ => {}
	}
	if len(c.args) == 1 {
		match c.args[0] {
			Fn(name) => {
				if !first {
					// A piped value is the function's only argument: {{.a | len}}.
					return try st.callFunc(name, []Value{piped})
				}
				return try st.callFunc(name, []Value{})
			}
			Pipe(inner) => {
				return try st.evalPipe(inner)
			}
			_ => {
				if !first {
					fail say.Fault("stencil: cannot pipe into a value")
				}
				return try st.evalArg(c.args[0])
			}
		}
	}
	match c.args[0] {
		Fn(name) => {
			if name == "and" || name == "or" {
				let (_, user) = st.tpl.funcs[name]
				if !user {
					return try st.andOr(name == "or", c, piped, first)
				}
			}
		}
		_ => {}
	}
	mut vals = []Value{}
	for i in 1..len(c.args) {
		let v = try st.evalArg(c.args[i])
		vals = append(vals, v)
	}
	if !first {
		vals = append(vals, piped)
	}
	match c.args[0] {
		Fn(name) => {
			return try st.callFunc(name, vals)
		}
		_ => {
			fail say.Fault("stencil: a command with arguments must start with a function")
		}
	}
	fail say.Fault("stencil: unreachable")
}

// andOr is Go's and and or: the operands are evaluated in order and the first false one (and) or true
// one (or) is the result without evaluating the rest; otherwise the piped value, if any, or the last.
fn (st State) andOr(isOr bool, c Cmd, piped Value, first bool) !Value {
	mut v = None()
	for i in 1..len(c.args) {
		v = try st.evalArg(c.args[i])
		if truthy(v) == isOr {
			return v
		}
	}
	if !first {
		return piped
	}
	return v
}

// evalArg evaluates one operand.
fn (st State) evalArg(a Arg) !Value {
	match a {
		Dot => {
			return st.cell().dot
		}
		Field(path) => {
			return try walkPath(st.cell().dot, path)
		}
		Var(name, path) => {
			let (v, ok) = st.cell().vars[name]
			if !ok {
				fail say.Fault("stencil: undefined variable %s", name)
			}
			return try walkPath(v, path)
		}
		Str(s) => {
			return Str(s)
		}
		Int(v) => {
			return Int(v)
		}
		Float(f) => {
			return Float(f)
		}
		Bool(b) => {
			return Bool(b)
		}
		Fn(name) => {
			return try st.callFunc(name, []Value{})
		}
		Pipe(inner) => {
			return try st.evalPipe(inner)
		}
		Nil => {
			return None()
		}
	}
	fail say.Fault("stencil: unreachable")
}

// walkPath walks .a.b from v: map lookups, where a missing key is None and a field of None is None; a
// field of any other value is an error, as in Go.
fn walkPath(v Value, path []str) !Value {
	mut cur = v
	for _, name in path {
		if cur.kind == KindNone {
			return None()
		}
		if cur.kind != KindMap {
			fail say.Fault("stencil: can't evaluate field %s in a %s", name, kindName(cur))
		}
		let (next, ok) = cur.m[name]
		if !ok {
			return None()
		}
		cur = next
	}
	return cur
}

// callFunc calls a builtin or a registered function.
fn (st State) callFunc(name str, args []Value) !Value {
	if isBuiltin(name) {
		return try builtin(name, args)
	}
	let (f, ok) = st.tpl.funcs[name]
	if !ok {
		fail say.Fault("stencil: no function %q", name)
	}
	return try f(args)
}

// sortedKeys sorts a map's keys (Go's range over a map does too).
fn sortedKeys(m map[str]Value) []str {
	mut keys = []str{}
	for k, _ in m {
		keys = append(keys, k)
	}
	// Insertion sort: template maps are small.
	mut i = 1
	for i < len(keys) {
		let k = keys[i]
		mut j = i
		for j > 0 && keys[j-1] > k {
			keys[j] = keys[j-1]
			j -= 1
		}
		keys[j] = k
		i += 1
	}
	return keys
}
