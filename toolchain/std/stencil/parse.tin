package stencil

import "glyph"
import "mint"
import "say"

// The template parser: the text between {{ and }} actions, with the trim markers {{- and -}}, and
// a recursive descent parser over the actions. Parse errors carry the line and column.

// Node is one piece of a parsed template.
type Node enum {
	Text(str)
	Action(Pipe, i64) // {{pipeline}} and its escape mode; a variable assignment sets Assign
	If(Branch)
	Range(RangeNode)
	With(Branch)
	Call(TemplateCall)
}

// Branch is if/with: the condition, the body and the else branch.
type Branch struct {
	pipe Pipe
	then []Node
	otherwise []Node
}

// RangeNode is range: the optional variables, the pipeline, the body and the else branch.
type RangeNode struct {
	keyVar str
	valVar str
	pipe   Pipe
	body   []Node
	otherwise []Node
}

// TemplateCall is {{template "name" pipe}}; the pipe may be absent.
type TemplateCall struct {
	name str
	pipe Pipe
	hasPipe bool
}

// Pipe is a pipeline: commands joined by |.
type Pipe struct {
	cmds []Cmd
	// assign is a variable assignment ($x := pipe), empty otherwise.
	assign str
	// hasAssign marks the assignment form.
	hasAssign bool
	// isSet marks $x = (assignment) rather than $x := (declaration).
	isSet bool
}

// Cmd is one command: its operands.
type Cmd struct {
	args []Arg
}

// Arg is one operand of a command.
type Arg enum {
	Dot
	Field([]str) // .a.b: the path after the dot
	Var(str, []str) // $x.a.b
	Str(str)
	Int(i64)
	Float(f64)
	Bool(bool)
	Fn(str) // a function name (or a builtin)
	Pipe(Pipe) // a parenthesized pipeline
	Nil // nil: an untyped nil argument, never a command
}

// ParseHTML parses text into a Template whose actions are escaped by their HTML context, as Go's
// html/template does; a context the mode does not support is a parse error. A {{template}} call
// renders its own template in element text, so a called template cannot open a tag.
fn ParseHTML(name str, text str) !Template {
	let t = try Parse(name, text)
	let st = newHTMLState()
	let end = try annotateHTML(t.root, st)
	if end.state != stText {
		fail say.Fault("stencil: %s: the template ends inside an HTML context", name)
	}
	for _, body in t.defs {
		let st2 = newHTMLState()
		let e2 = try annotateHTML(body, st2)
		if e2.state != stText {
			fail say.Fault("stencil: %s: a defined template ends inside an HTML context", name)
		}
	}
	return t
}

// Parse parses text into a Template; errors carry name, line and column.
fn Parse(name str, text str) !Template {
	mut p = Parser{name: name, text: text, pos: 0, line: 1, col: 1, vars: []str{"$"}, trimNext: false, tpl: Template{name: name, root: []Node{}, defs: make(map[str][]Node), funcs: make(map[str]fn([]Value) !Value)}}
	try p.parseTop()
	if len(p.tpl.root) == 0 && len(p.tpl.defs) == 0 {
		// An empty template is fine.
	}
	return p.tpl
}

// Parser walks text.
type Parser struct {
	name str
	text str
	pos  i64
	line i64
	col  i64
	tpl  Template
	// vars are the variables in scope, innermost last: $ and every $x := not yet closed by its {{end}}.
	vars []str
	// trimNext is set by a right trim marker ( -}}): the text after it loses its leading white space.
	trimNext bool
}

// failAt is a parse error with the position.
fn (p Parser) failAt(msg str) ! {
	fail say.Fault("stencil: %s:%d:%d: %s", p.name, p.line, p.col, msg)
}

// parseTop parses the whole text, collecting define blocks.
fn (p mut Parser) parseTop() ! {
	let nodes = try p.parseList("")
	p.tpl.root = nodes
}

// parseList parses nodes until end or one of the stop keywords (else, end).
fn (p mut Parser) parseList(stops str) ![]Node {
	mut out = []Node{}
	for {
		let text = try p.readText()
		if len(text) > 0 {
			out = append(out, Node.Text(text))
		}
		if p.pos >= len(p.text) {
			return out
		}
		// An action starts here.
		let word = try p.peekAction()
		if len(word) > 0 && isStop(word, stops) {
			return out
		}
		if word == "end" || word == "else" {
			fail p.failAt(say.Fmt("unexpected %s", word))
		}
		let node = try p.parseAction()
		if node != nil {
			out = append(out, node)
		}
	}
}

// isStop reports whether word is one of the space-separated stops.
fn isStop(word str, stops str) bool {
	for _, s in splitWords(stops) {
		if s == word {
			return true
		}
	}
	return false
}

// splitWords splits on spaces.
fn splitWords(s str) []str {
	mut out = []str{}
	mut start = 0
	for i in 0..len(s) {
		if s[i] == ' ' {
			if i > start {
				out = append(out, s[start:i])
			}
			start = i + 1
		}
	}
	if start < len(s) {
		out = append(out, s[start:len(s)])
	}
	return out
}

// readText reads literal text up to the next action, applying the trim markers.
fn (p mut Parser) readText() !str {
	let start = p.pos
	mut end = len(p.text)
	mut i = p.pos
	for i + 1 < len(p.text) {
		if p.text[i] == '{' && p.text[i+1] == '{' {
			end = i
			break
		}
		i += 1
	}
	mut text = p.text[start:end]
	if p.trimNext {
		text = trimLeftSpace(text)
		p.trimNext = false
	}
	if p.leftTrimAt(end) {
		text = trimRightSpace(text)
	}
	p.advanceTo(end)
	return text
}

// leftTrimAt reports whether the action at i opens with a left trim marker: "{{-" and a space, as Go's
// lexer requires ("{{-3}}" is the number -3).
fn (p Parser) leftTrimAt(i i64) bool {
	return i + 3 < len(p.text) && p.text[i] == '{' && p.text[i+1] == '{' && p.text[i+2] == '-' && isTrimSpace(p.text[i+3])
}

// rightTrimAt reports whether a right trim marker starts at i: a space, then "-}}".
fn (p Parser) rightTrimAt(i i64) bool {
	return i > 0 && isTrimSpace(p.text[i-1]) && i + 2 < len(p.text) && p.text[i] == '-' && p.text[i+1] == '}' && p.text[i+2] == '}'
}

// isTrimSpace is one of the white space bytes of Go's template lexer.
fn isTrimSpace(c u8) bool {
	return c == ' ' || c == '\t' || c == '\r' || c == '\n'
}

// peekAction looks at the keyword after the next {{, without consuming anything.
fn (p Parser) peekAction() !str {
	// p.pos is at the {{.
	let start = p.pos + 2
	mut i = start
	if p.leftTrimAt(p.pos) {
		i += 1
	}
	for i < len(p.text) && (p.text[i] == ' ' || p.text[i] == '\t' || p.text[i] == '\n' || p.text[i] == '\r') {
		i += 1
	}
	mut j = i
	for j < len(p.text) && isWordByte(p.text[j]) {
		j += 1
	}
	return p.text[i:j]
}

// isWordByte is a letter, digit or underscore.
fn isWordByte(c u8) bool {
	return c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '_'
}

// parseAction parses one {{...}} action into a node (nil for a comment or an assignment).
fn (p mut Parser) parseAction() !?Node {
	let startLine = p.line
	let startCol = p.col
	// A comment starts right after the {{ or the trim marker's "- ", and its */ sits right before the
	// }} or the " -}}", as Go's lexer requires.
	let trim = p.leftTrimAt(p.pos)
	mut after = p.pos + 2
	if trim {
		after += 2
	}
	if after + 1 < len(p.text) && p.text[after] == '/' && p.text[after+1] == '*' {
		p.advanceTo(after + 2)
		let end = p.indexOf("*/")
		if end < 0 {
			fail p.failAt("unclosed comment")
		}
		p.advanceTo(end + 2)
		if p.pos + 1 < len(p.text) && p.text[p.pos] == '}' && p.text[p.pos+1] == '}' {
			p.advanceTo(p.pos + 2)
			return nil
		}
		if p.pos + 1 < len(p.text) && isTrimSpace(p.text[p.pos]) && p.rightTrimAt(p.pos + 1) {
			p.advanceTo(p.pos + 4)
			p.trimNext = true
			return nil
		}
		fail p.failAt("comment ends before closing delimiter")
	}
	p.advanceTo(p.pos + 2)
	if trim {
		p.advance()
	}
	p.skipSpace()
	let word = p.peekWord()
	// A variable an if, range or with declares, in its pipe or its body, ends at its {{end}}.
	let scope = len(p.vars)
	if word == "if" {
		let node = try p.parseIf()
		p.vars = p.vars[0:scope]
		return node
	}
	if word == "range" {
		let node = try p.parseRange()
		p.vars = p.vars[0:scope]
		return node
	}
	if word == "with" {
		let node = try p.parseWith()
		p.vars = p.vars[0:scope]
		return node
	}
	if word == "template" {
		return try p.parseTemplateCall()
	}
	if word == "define" {
		try p.parseDefine()
		return nil
	}
	if word == "block" {
		return try p.parseBlock()
	}
	// A pipeline action.
	let pipe = try p.parsePipe(true)
	try p.expectClose()
	return Node.Action(pipe, escNone)
}

// peekWord reads the current word without consuming.
fn (p Parser) peekWord() str {
	mut j = p.pos
	for j < len(p.text) && isWordByte(p.text[j]) {
		j += 1
	}
	return p.text[p.pos:j]
}

// openAction consumes the {{ and the optional trim marker of the next action and returns its
// first word.
fn (p mut Parser) openAction() !str {
	if p.pos + 1 >= len(p.text) || p.text[p.pos] != '{' || p.text[p.pos+1] != '{' {
		fail p.failAt("expected an action")
	}
	let trim = p.leftTrimAt(p.pos)
	p.advanceTo(p.pos + 2)
	if trim {
		p.advance()
	}
	p.skipSpace()
	return p.peekWord()
}

// parseIf parses if/else if/else/end.
fn (p mut Parser) parseIf() !Node {
	let pipe = try p.parseKeywordPipe("if")
	try p.expectClose()
	return try p.parseIfBody(pipe)
}

// parseIfBody parses an if's body and its else branches, the pipe already parsed.
fn (p mut Parser) parseIfBody(pipe Pipe) !Node {
	let body = try p.parseList("else end")
	let branch = Branch{pipe: pipe, then: body}
	let word = try p.openAction()
	if word == "else" {
		try p.consumeWord("else")
		p.skipSpace()
		if p.peekWord() == "if" {
			try p.consumeWord("if")
			let inner = try p.parseKeywordPipe2()
			try p.expectClose()
			let node = try p.parseIfBody(inner)
			branch.otherwise = []Node{node}
			return Node.If(branch)
		}
		try p.expectClose()
		branch.otherwise = try p.parseList("end")
		let w2 = try p.openAction()
		if w2 != "end" {
			fail p.failAt(say.Fmt("expected end, found %s", w2))
		}
		try p.consumeWord("end")
		try p.expectClose()
		return Node.If(branch)
	}
	if word != "end" {
		fail p.failAt(say.Fmt("expected end, found %s", word))
	}
	try p.consumeWord("end")
	try p.expectClose()
	return Node.If(branch)
}

// parseKeywordPipe2 parses a pipe after "if" in an else if.
fn (p mut Parser) parseKeywordPipe2() !Pipe {
	return try p.parsePipe(false)
}

// parseWith parses with/else/end.
fn (p mut Parser) parseWith() !Node {
	try p.consumeWord("with")
	let pipe = try p.parsePipe(true)
	try p.expectClose()
	return try p.parseWithBody(pipe)
}

// parseWithBody parses a with's body and its else branches, the pipe already parsed.
fn (p mut Parser) parseWithBody(pipe Pipe) !Node {
	let body = try p.parseList("else end")
	let branch = Branch{pipe: pipe, then: body}
	let word = try p.openAction()
	if word == "else" {
		try p.consumeWord("else")
		p.skipSpace()
		if p.peekWord() == "with" {
			// else with, like else if.
			try p.consumeWord("with")
			let inner = try p.parsePipe(true)
			try p.expectClose()
			let node = try p.parseWithBody(inner)
			branch.otherwise = []Node{node}
			return Node.With(branch)
		}
		try p.expectClose()
		branch.otherwise = try p.parseList("end")
		let w2 = try p.openAction()
		if w2 != "end" {
			fail p.failAt(say.Fmt("expected end, found %s", w2))
		}
		try p.consumeWord("end")
		try p.expectClose()
		return Node.With(branch)
	}
	if word != "end" {
		fail p.failAt(say.Fmt("expected end, found %s", word))
	}
	try p.consumeWord("end")
	try p.expectClose()
	return Node.With(branch)
}

// parseRange parses range/else/end, with the optional variable declarations.
fn (p mut Parser) parseRange() !Node {
	try p.consumeWord("range")
	p.skipSpace()
	mut keyVar = ""
	mut valVar = ""
	if p.rangeDeclares() {
		let first = try p.parseVarName()
		p.skipSpace()
		if p.pos < len(p.text) && p.text[p.pos] == ',' {
			keyVar = first
			p.advance()
			p.skipSpace()
			valVar = try p.parseVarName()
		} else {
			valVar = first
		}
		p.skipSpace()
		if p.pos + 1 < len(p.text) && p.text[p.pos] == ':' && p.text[p.pos+1] == '=' {
			p.advance()
			p.advance()
			p.skipSpace()
		} else {
			fail p.failAt("range: expected :=")
		}
		if len(keyVar) > 0 {
			p.vars = append(p.vars, keyVar)
		}
		p.vars = append(p.vars, valVar)
	}
	let pipe = try p.parsePipe(false)
	try p.expectClose()
	let body = try p.parseList("else end")
	mut node = RangeNode{keyVar: keyVar, valVar: valVar, pipe: pipe, body: body, otherwise: []Node{}}
	let word = try p.openAction()
	if word == "else" {
		try p.consumeWord("else")
		try p.expectClose()
		node.otherwise = try p.parseList("end")
		let w2 = try p.openAction()
		if w2 != "end" {
			fail p.failAt(say.Fmt("expected end, found %s", w2))
		}
		try p.consumeWord("end")
		try p.expectClose()
		return Node.Range(node)
	}
	if word != "end" {
		fail p.failAt(say.Fmt("expected end, found %s", word))
	}
	try p.consumeWord("end")
	try p.expectClose()
	return Node.Range(node)
}

// rangeDeclares reports whether the range's pipeline starts with a declaration ($v := or $i, $v :=)
// rather than a variable it ranges over ({{range $}}).
fn (p Parser) rangeDeclares() bool {
	if p.pos >= len(p.text) || p.text[p.pos] != '$' {
		return false
	}
	mut j = p.pos + 1
	for j < len(p.text) && isWordByte(p.text[j]) {
		j += 1
	}
	for j < len(p.text) && (p.text[j] == ' ' || p.text[j] == '\t') {
		j += 1
	}
	return j < len(p.text) && p.text[j] == ',' || j + 1 < len(p.text) && p.text[j] == ':' && p.text[j+1] == '='
}

// hasVar reports whether the variable name is in scope.
fn (p Parser) hasVar(name str) bool {
	for _, v in p.vars {
		if v == name {
			return true
		}
	}
	return false
}

// parseTemplateCall parses {{template "name" pipe}}.
fn (p mut Parser) parseTemplateCall() !Node {
	try p.consumeWord("template")
	p.skipSpace()
	let name = try p.parseStringLiteral()
	p.skipSpace()
	mut hasPipe = false
	mut pipe = Pipe{}
	if !(p.pos < len(p.text) && p.text[p.pos] == '}' || p.rightTrimAt(p.pos)) {
		pipe = try p.parsePipe(false)
		hasPipe = true
	}
	try p.expectClose()
	return Node.Call(TemplateCall{name: name, pipe: pipe, hasPipe: hasPipe})
}

// parseDefine parses {{define "name"}}...{{end}} and stores the template.
fn (p mut Parser) parseDefine() ! {
	try p.consumeWord("define")
	p.skipSpace()
	let name = try p.parseStringLiteral()
	try p.expectClose()
	// A defined template sees only its own $.
	let outer = p.vars
	p.vars = []str{"$"}
	let body = try p.parseList("end")
	p.vars = outer
	let word = try p.openAction()
	if word != "end" {
		fail p.failAt(say.Fmt("expected end, found %s", word))
	}
	try p.consumeWord("end")
	try p.expectClose()
	try p.define(name, body)
}

// define stores a defined template as Go's parser does: an empty body (white space and comments) never
// replaces a template, and two non-empty bodies for one name are an error.
fn (p mut Parser) define(name str, body []Node) ! {
	let (old, had) = p.tpl.defs[name]
	if had && !emptyBody(old) {
		if !emptyBody(body) {
			fail say.Fault("stencil: %s: multiple definition of template %q", p.name, name)
		}
		return
	}
	p.tpl.defs[name] = body
}

// emptyBody reports whether a template body is only white space.
fn emptyBody(nodes []Node) bool {
	for _, n in nodes {
		match n {
			Text(t) => {
				if len(trimLeftSpace(t)) > 0 {
					return false
				}
			}
			_ => {
				return false
			}
		}
	}
	return true
}

// parseBlock parses {{block "name" pipe}}body{{end}}: a define plus a call.
fn (p mut Parser) parseBlock() !Node {
	try p.consumeWord("block")
	p.skipSpace()
	let name = try p.parseStringLiteral()
	p.skipSpace()
	let pipe = try p.parsePipe(false)
	try p.expectClose()
	let outer = p.vars
	p.vars = []str{"$"}
	let body = try p.parseList("end")
	p.vars = outer
	let word = try p.openAction()
	if word != "end" {
		fail p.failAt(say.Fmt("expected end, found %s", word))
	}
	try p.consumeWord("end")
	try p.expectClose()
	try p.define(name, body)
	return Node.Call(TemplateCall{name: name, pipe: pipe, hasPipe: true})
}

// parseKeywordPipe parses "keyword pipe". An if may declare variables in its pipe
// ({{if $x := .a}}), as Go's template allows.
fn (p mut Parser) parseKeywordPipe(word str) !Pipe {
	try p.consumeWord(word)
	return try p.parsePipe(true)
}

// parsePipe parses commands joined by |, and an optional $x := assignment.
fn (p mut Parser) parsePipe(allowAssign bool) !Pipe {
	p.skipSpace()
	mut pipe = Pipe{}
	if allowAssign && p.pos < len(p.text) && p.text[p.pos] == '$' {
		// Look ahead for := .
		mut j = p.pos + 1
		for j < len(p.text) && isWordByte(p.text[j]) {
			j += 1
		}
		mut k = j
		for k < len(p.text) && (p.text[k] == ' ' || p.text[k] == '\t') {
			k += 1
		}
		if k + 1 < len(p.text) && p.text[k] == ':' && p.text[k+1] == '=' {
			pipe.assign = p.text[p.pos:j]
			pipe.hasAssign = true
			p.vars = append(p.vars, pipe.assign)
			p.advanceTo(k + 2)
			p.skipSpace()
		} else if k < len(p.text) && p.text[k] == '=' && (k+1 >= len(p.text) || p.text[k+1] != '=') {
			// $x = expr assigns the variable it was declared with, as Go's template does.
			// Go's parser puts an assigned variable in scope too; assigning one never declared fails
			// when it runs.
			pipe.assign = p.text[p.pos:j]
			p.vars = append(p.vars, pipe.assign)
			pipe.hasAssign = true
			pipe.isSet = true
			p.advanceTo(k + 1)
			p.skipSpace()
		}
	}
	mut cmds = []Cmd{}
	let first = try p.parseCmd()
	cmds = append(cmds, first)
	for {
		p.skipSpace()
		if p.pos < len(p.text) && p.text[p.pos] == '|' {
			p.advance()
			p.skipSpace()
			let next = try p.parseCmd()
			cmds = append(cmds, next)
		} else {
			break
		}
	}
	pipe.cmds = cmds
	return pipe
}

// parseCmd parses one command: operands separated by spaces.
fn (p mut Parser) parseCmd() !Cmd {
	mut args = []Arg{}
	for {
		p.skipSpace()
		if p.pos >= len(p.text) || p.text[p.pos] == '}' || p.text[p.pos] == '|' || p.text[p.pos] == ')' {
			break
		}
		if p.rightTrimAt(p.pos) {
			// The right trim marker, {{ . -}}.
			break
		}
		let a = try p.parseArg()
		args = append(args, a)
	}
	if len(args) == 0 {
		fail p.failAt("empty command")
	}
	return Cmd{args: args}
}

// parseArg parses one operand.
fn (p mut Parser) parseArg() !Arg {
	let c = p.text[p.pos]
	if c == '.' {
		p.advance()
		let path = try p.parseFieldPath()
		return Arg.Field(path)
	}
	if c == '$' {
		let name = try p.parseVarName()
		if !p.hasVar(name) {
			fail p.failAt(say.Fmt("undefined variable %q", name))
		}
		// $x.a is a field of $x; $x .a is two operands.
		if p.pos < len(p.text) && p.text[p.pos] == '.' {
			p.advance()
			let path = try p.parseFieldPath()
			return Arg.Var(name, path)
		}
		return Arg.Var(name, []str{})
	}
	if c == '"' || c == '`' {
		let lit = try p.parseStringLiteral()
		return Arg.Str(lit)
	}
	if c == '(' {
		p.advance()
		let inner = try p.parsePipe(false)
		p.skipSpace()
		if p.pos >= len(p.text) || p.text[p.pos] != ')' {
			fail p.failAt("unclosed parenthesis")
		}
		p.advance()
		return Arg.Pipe(inner)
	}
	if c == '-' || c >= '0' && c <= '9' {
		return try p.parseNumber()
	}
	if c == '\'' {
		return try p.parseCharConstant()
	}
	let word = p.peekWord()
	if len(word) == 0 {
		fail p.failAt(say.Fmt("unexpected character %q", stringOf(c)))
	}
	p.advanceTo(p.pos + len(word))
	if word == "true" {
		return Arg.Bool(true)
	}
	if word == "false" {
		return Arg.Bool(false)
	}
	if word == "nil" {
		return Arg.Nil
	}
	return Arg.Fn(word)
}

// stringOf is a one-character string.
fn stringOf(c u8) str {
	let b = []u8{c}
	return rt_str_from_raw(cast(i64, b)[2], 1)
}

// parseFieldPath parses a.b.c (after the dot).
fn (p mut Parser) parseFieldPath() ![]str {
	mut out = []str{}
	for {
		let word = p.peekWord()
		if len(word) == 0 {
			break
		}
		out = append(out, word)
		p.advanceTo(p.pos + len(word))
		if p.pos < len(p.text) && p.text[p.pos] == '.' {
			p.advance()
		} else {
			break
		}
	}
	return out
}

// parseVarName parses $name (the $ alone is the root variable).
fn (p mut Parser) parseVarName() !str {
	if p.text[p.pos] != '$' {
		fail p.failAt("expected $")
	}
	p.advance()
	let word = p.peekWord()
	p.advanceTo(p.pos + len(word))
	if len(word) == 0 {
		return "$"
	}
	return "$" + word
}

// parseStringLiteral parses a "..." or `...` literal, unquoted as Go's strconv.Unquote does.
fn (p mut Parser) parseStringLiteral() !str {
	let quote = p.text[p.pos]
	let start = p.pos
	mut i = p.pos + 1
	for {
		if i >= len(p.text) || quote == '"' && p.text[i] == '\n' {
			fail p.failAt("unterminated string")
		}
		let c = p.text[i]
		if quote == '"' && c == '\\' && i + 1 < len(p.text) {
			i += 2
			continue
		}
		if c == quote {
			break
		}
		i += 1
	}
	let lit = p.text[start:i+1]
	let (out, err) = mint.Unquote(lit)
	if err != nil {
		fail p.failAt(say.Fmt("bad string %s", lit))
	}
	p.advanceTo(i + 1)
	return out
}

// parseCharConstant parses a character constant ('a', '\n', '\x41', '\u00e9', '\101'), an integer as in
// Go's templates.
fn (p mut Parser) parseCharConstant() !Arg {
	let start = p.pos
	mut i = p.pos + 1
	for {
		if i >= len(p.text) || p.text[i] == '\n' {
			fail p.failAt("unterminated character constant")
		}
		if p.text[i] == '\\' {
			i += 2
			continue
		}
		if p.text[i] == '\'' {
			break
		}
		i += 1
	}
	let lit = p.text[start:i+1]
	let body = lit[1:len(lit)-1]
	let (r, n) = charValue(body)
	if n <= 0 || n != len(body) {
		fail p.failAt(say.Fmt("malformed character constant: %s", lit))
	}
	p.advanceTo(i + 1)
	return Arg.Int(r)
}

// charValue reads the character or escape at the start of s, as Go's strconv.UnquoteChar does for a
// single-quoted constant: its value and the bytes it used, or 0 bytes when it is not one.
fn charValue(s str) (i64, i64) {
	if len(s) == 0 || s[0] == '\'' || s[0] == '\n' {
		return 0, 0
	}
	if s[0] != '\\' {
		let (r, size) = glyph.DecodeRune(s, 0)
		if r == glyph.RuneError && size == 1 {
			return 0, 0
		}
		return i64(r), size
	}
	if len(s) < 2 {
		return 0, 0
	}
	let e = s[1]
	let simple = "a\x07b\x08f\x0cn\nr\rt\tv\x0b\\\\''"
	mut k = 0
	for k + 1 < len(simple) {
		if simple[k] == e {
			return i64(simple[k+1]), 2
		}
		k += 2
	}
	mut digits = 0
	mut base = i64(16)
	if e == 'x' {
		digits = 2
	} else if e == 'u' {
		digits = 4
	} else if e == 'U' {
		digits = 8
	} else if e >= '0' && e <= '7' {
		digits = 3
		base = 8
	} else {
		return 0, 0
	}
	mut at = 2
	if base == 8 {
		at = 1
	}
	if at + digits > len(s) {
		return 0, 0
	}
	mut v = i64(0)
	for j in at..at+digits {
		let c = s[j]
		mut d = i64(-1)
		if c >= '0' && c <= '9' {
			d = i64(c - '0')
		} else if c >= 'a' && c <= 'f' {
			d = i64(c-'a') + 10
		} else if c >= 'A' && c <= 'F' {
			d = i64(c-'A') + 10
		}
		if d < 0 || d >= base {
			return 0, 0
		}
		v = v*base + d
	}
	if base == 8 && v > 255 {
		return 0, 0
	}
	if (e == 'u' || e == 'U') && (v > 0x10FFFF || v >= 0xD800 && v < 0xE000) {
		return 0, 0
	}
	return v, at + digits
}

// parseNumber parses an integer or a float, with Go's bases (0x, 0o, 0b, a leading 0 for octal)
// and _ digit separators.
fn (p mut Parser) parseNumber() !Arg {
	let start = p.pos
	if p.text[p.pos] == '-' {
		p.advance()
	}
	// A base prefix makes the rest of the digits base 2, 8 or 16.
	mut base = i64(10)
	mut digits = p.pos
	if p.pos+1 < len(p.text) && p.text[p.pos] == '0' {
		let d = p.text[p.pos+1]
		if d == 'x' || d == 'X' {
			base = 16
			digits = p.pos + 2
			p.advanceTo(digits)
		} else if d == 'o' || d == 'O' {
			base = 8
			digits = p.pos + 2
			p.advanceTo(digits)
		} else if d == 'b' || d == 'B' {
			base = 2
			digits = p.pos + 2
			p.advanceTo(digits)
		}
	}
	if base != 10 {
		let dstart = p.pos
		for p.pos < len(p.text) {
			let c = p.text[p.pos]
			if isDigitOf(c, base) || c == '_' {
				p.advance()
			} else {
				break
			}
		}
		if p.pos == dstart {
			fail p.failAt(say.Fmt("bad number %s", p.text[start:p.pos]))
		}
		let body = stripUnderscores(p.text[dstart:p.pos])
		let (v, err) = mint.ParseInt(body, base)
		if err != nil {
			fail p.failAt(say.Fmt("bad number %s", p.text[start:p.pos]))
		}
		return Arg.Int(v)
	}
	// A leading 0 alone is octal, as Go's literals are.
	if p.pos < len(p.text) && p.text[p.pos] == '0' && p.pos+1 < len(p.text) && p.text[p.pos+1] >= '0' && p.text[p.pos+1] <= '7' {
		mut j = p.pos + 1
		mut octal = true
		for j < len(p.text) && (p.text[j] >= '0' && p.text[j] <= '9' || p.text[j] == '_') {
			if p.text[j] > '7' {
				octal = false
			}
			j += 1
		}
		if octal && (j >= len(p.text) || p.text[j] != '.') {
			let body = stripUnderscores(p.text[p.pos:j])
			let (v, err) = mint.ParseInt(body, 8)
			if err != nil {
				fail p.failAt(say.Fmt("bad number %s", p.text[start:j]))
			}
			p.advanceTo(j)
			return Arg.Int(v)
		}
	}
	mut isFloat = false
	for p.pos < len(p.text) {
		let c = p.text[p.pos]
		if c >= '0' && c <= '9' || c == '_' {
			p.advance()
		} else if c == '.' && !isFloat {
			isFloat = true
			p.advance()
		} else if c == 'e' || c == 'E' {
			isFloat = true
			p.advance()
			if p.pos < len(p.text) && (p.text[p.pos] == '+' || p.text[p.pos] == '-') {
				p.advance()
			}
		} else {
			break
		}
	}
	let s = stripUnderscores(p.text[start:p.pos])
	if isFloat {
		let (f, err) = mint.ParseFloat(s)
		if err != nil {
			fail p.failAt(say.Fmt("bad number %s", s))
		}
		return Arg.Float(f)
	}
	let (v, err) = mint.Atoi(s)
	if err != nil {
		fail p.failAt(say.Fmt("bad number %s", s))
	}
	return Arg.Int(v)
}

// isDigitOf reports whether c is a digit of base (2, 8, 10 or 16).
fn isDigitOf(c u8, base i64) bool {
	if c >= '0' && c <= '9' {
		return i64(c)-'0' < base
	}
	if base == 16 && (c >= 'a' && c <= 'f' || c >= 'A' && c <= 'F') {
		return true
	}
	return false
}

// stripUnderscores removes the _ digit separators Go's number literals allow.
fn stripUnderscores(s str) str {
	mut out = ""
	for i in 0..len(s) {
		if s[i] != '_' {
			out += s[i:i+1]
		}
	}
	return out
}

// consumeWord consumes the current word, which must be word.
fn (p mut Parser) consumeWord(word str) ! {
	p.skipSpace()
	let got = p.peekWord()
	if got != word {
		fail p.failAt(say.Fmt("expected %s, found %s", word, got))
	}
	p.advanceTo(p.pos + len(word))
}

// expectClose consumes the closing }} (with the optional trim marker).
fn (p mut Parser) expectClose() ! {
	p.skipSpace()
	if p.rightTrimAt(p.pos) {
		p.advance()
		p.trimNext = true
	}
	if p.pos + 1 >= len(p.text) || p.text[p.pos] != '}' || p.text[p.pos+1] != '}' {
		fail p.failAt("expected }}")
	}
	p.advanceTo(p.pos + 2)
}

// indexOf returns the position of sub at or after pos, or -1.
fn (p Parser) indexOf(sub str) i64 {
	mut i = p.pos
	for i + len(sub) <= len(p.text) {
		if p.text[i:i+len(sub)] == sub {
			return i
		}
		i += 1
	}
	return -1
}

// skipSpace skips spaces, tabs and newlines, counting lines.
fn (p mut Parser) skipSpace() {
	for p.pos < len(p.text) {
		let c = p.text[p.pos]
		if c == ' ' || c == '\t' {
			p.advance()
		} else if c == '\n' {
			p.advance()
		} else {
			break
		}
	}
}

// advance moves one byte, tracking the line and column.
fn (p mut Parser) advance() {
	if p.pos < len(p.text) && p.text[p.pos] == '\n' {
		p.line += 1
		p.col = 1
	} else {
		p.col += 1
	}
	p.pos += 1
}

// advanceTo moves to pos, tracking the line and column.
fn (p mut Parser) advanceTo(to i64) {
	for p.pos < to {
		p.advance()
	}
}

// trimLeftSpace removes leading white space (spaces, tabs, carriage returns and newlines).
fn trimLeftSpace(s str) str {
	mut i = 0
	for i < len(s) && isTrimSpace(s[i]) {
		i += 1
	}
	return s[i:len(s)]
}

// trimRightSpace removes trailing white space (spaces, tabs, carriage returns and newlines).
fn trimRightSpace(s str) str {
	mut n = len(s)
	for n > 0 && (s[n-1] == ' ' || s[n-1] == '\t' || s[n-1] == '\n' || s[n-1] == '\r') {
		n -= 1
	}
	return s[0:n]
}
