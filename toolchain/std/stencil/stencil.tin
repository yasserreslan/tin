// Package stencil renders templates loaded at run time, like Go's text/template over a dynamic
// value tree: {{.user.name}}, {{if}}, {{range}}, {{with}}, pipelines with the builtins (len,
// index, slice, eq, ne, lt, le, gt, ge, and, or, not, printf, print, println, html, urlquery, js),
// {{define}}, {{template}} and {{block}}, and user functions registered with Func. Parse errors
// carry line and column; execution is bounded by a template recursion limit and a maximum output
// size. ParseHTML renders in HTML mode instead: an action's escaping follows its context in the
// surrounding markup (element text, attribute values, URL attributes and JavaScript inside
// <script>), and a context the mode cannot judge is a parse error rather than a guess.
//
// URL attributes (href, src, action, formaction, poster, background) are escaped by position, as Go's
// html/template does: at the start the scheme is filtered (only http, https, mailto and relative URLs
// pass, else #ZgotmplZ) and the value is percent-encoded where it leaves the URL grammar; after the start
// it is percent-encoded the same way; after a "?" or "#" every byte outside the unreserved set is
// percent-encoded, so a value cannot add query parameters. Hex digits are lower case, then the value is
// HTML-escaped.
//
// Execute keeps the data and the variables in a cell bound to a runtime slot (the pattern policy.Bind
// uses), so the stores happen inside the runtime.
package stencil

import "fault"
import "say"
import "twine"

// Value is the data a template renders: a tree of strings, numbers, booleans, lists and maps.
type Value struct {
	kind i64
	s    str
	n    i64
	f    f64
	b    bool
	xs    []Value
	m     map[str]Value
	trust i64
}

// The kinds of a Value.
const KindNone = 0

const KindStr = 1

const KindInt = 2

const KindFloat = 3

const KindBool = 4

const KindList = 5

const KindMap = 6

// None returns the absent value (a missing map key), printed as Go prints it.
fn None() Value {
	return Value{kind: KindNone, s: "", n: 0, f: 0, b: false, xs: []Value{}, m: make(map[str]Value), trust: 0}
}

// Str returns a string value.
fn Str(s str) Value {
	return Value{kind: KindStr, s: s, n: 0, f: 0, b: false, xs: []Value{}, m: make(map[str]Value), trust: 0}
}

// Int returns an integer value.
fn Int(n i64) Value {
	return Value{kind: KindInt, s: "", n: n, f: 0, b: false, xs: []Value{}, m: make(map[str]Value), trust: 0}
}

// Float returns a floating-point value.
fn Float(f f64) Value {
	return Value{kind: KindFloat, s: "", n: 0, f: f, b: false, xs: []Value{}, m: make(map[str]Value), trust: 0}
}

// Bool returns a boolean value.
fn Bool(b bool) Value {
	return Value{kind: KindBool, s: "", n: 0, f: 0, b: b, xs: []Value{}, m: make(map[str]Value), trust: 0}
}

// List returns a list value.
fn List(xs []Value) Value {
	return Value{kind: KindList, s: "", n: 0, f: 0, b: false, xs: xs, m: make(map[str]Value), trust: 0}
}

// Map returns a map value; the keys are strings, as {{.name}} looks them up.
fn Map(m map[str]Value) Value {
	return Value{kind: KindMap, s: "", n: 0, f: 0, b: false, xs: []Value{}, m: m, trust: 0}
}

// The trusted kinds of a string value: the contextual escapers pass a value of its own kind through, as Go's html/template
// does for template.HTML, template.JS, template.JSStr, template.CSS and template.URL.
const TrustNone = 0

// TrustHTML marks HTML that is already escaped or markup (template.HTML).
const TrustHTML = 1

// TrustJS marks a JavaScript expression (template.JS).
const TrustJS = 2

// TrustJSStr marks text that is already escaped for a JavaScript string (template.JSStr).
const TrustJSStr = 3

// TrustCSS marks a CSS declaration value (template.CSS).
const TrustCSS = 4

// TrustURL marks a URL (template.URL).
const TrustURL = 5

// Trusted returns the string s, of the trusted kind t (a Trust constant), which the contextual escapers pass through in
// that context. Only Go code makes one: template data from outside the program is never trusted.
fn Trusted(t i64, s str) Value {
	return Value{kind: KindStr, s: s, n: 0, f: 0, b: false, xs: []Value{}, m: make(map[str]Value), trust: t}
}

// Trust returns the trusted kind of a value (a Trust constant), or TrustNone for an ordinary value.
fn (v Value) Trust() i64 {
	return v.trust
}

// Kind returns the value's kind (one of the Kind constants), for code that inspects data.
fn (v Value) Kind() i64 {
	return v.kind
}

// String returns the string of a string value.
fn (v Value) String() str {
	return v.s
}

// Integer returns the integer of an integer value.
fn (v Value) Integer() i64 {
	return v.n
}

// Real returns the float of a floating-point value.
fn (v Value) Real() f64 {
	return v.f
}

// Boolean returns the boolean of a boolean value.
fn (v Value) Boolean() bool {
	return v.b
}

// Items returns the elements of a list value.
fn (v Value) Items() []Value {
	return v.xs
}

// Entries returns the map of a map value.
fn (v Value) Entries() map[str]Value {
	return v.m
}

// Template is a parsed template.
type Template struct {
	name  str
	root  []Node
	defs  map[str][]Node
	funcs map[str]fn([]Value) !Value
}

// Func registers f for {{name ...}} calls in this template.
fn (t mut Template) Func(name str, f fn([]Value) !Value) {
	t.funcs[name] = f
}

// Execute renders the template with data and returns the output.
fn (t Template) Execute(data Value) !str {
	mut b = twine.NewBuilder(256)
	try t.ExecuteTo(mut b, data)
	return b.String()
}

// ExecuteTo renders the template with data into w. The data and the variables live in a cell
// bound to a runtime slot for the call (the pattern policy.Bind uses).
fn (t Template) ExecuteTo(w mut twine.Builder, data Value) ! {
	mut cell0 = execCell{dot: data, vars: make(map[str]Value)}
	cell0.vars["$"] = data
	let key = cast(i64, cell0)
	rt_slot_bind(key, cast(i64, cell0))
	mut st = State{tpl: t, key: key, w: w, depth: 0}
	try st.walk(t.root)
}

// truthy is Go's template truth: false, 0, 0.0, "", an empty list or map, and None are false.
fn truthy(v Value) bool {
	if v.kind == KindNone {
		return false
	}
	if v.kind == KindBool {
		return v.b
	}
	if v.kind == KindInt {
		return v.n != 0
	}
	if v.kind == KindFloat {
		return v.f != 0
	}
	if v.kind == KindStr {
		return len(v.s) != 0
	}
	if v.kind == KindList {
		return len(v.xs) != 0
	}
	if v.kind == KindMap {
		return len(v.m) != 0
	}
	return false
}

// printValue is Go's %v of a template value; None is nil.
fn printValue(v Value) str {
	if v.kind == KindNone {
		return "<nil>"
	}
	if v.kind == KindStr {
		return v.s
	}
	if v.kind == KindInt {
		return say.Fmt("%d", v.n)
	}
	if v.kind == KindFloat {
		return say.Fmt("%g", v.f)
	}
	if v.kind == KindBool {
		if v.b {
			return "true"
		}
		return "false"
	}
	if v.kind == KindList {
		mut out = "["
		for i, item in v.xs {
			if i > 0 {
				out += " "
			}
			out += printValue(item)
		}
		return out + "]"
	}
	if v.kind == KindMap {
		mut out = "map["
		mut first = true
		for _, k in sortedKeys(v.m) {
			if !first {
				out += " "
			}
			first = false
			out += k + ":" + printValue(v.m[k])
		}
		return out + "]"
	}
	return "<nil>"
}

// kindName names a value's kind in error messages.
fn kindName(v Value) str {
	if v.kind == KindStr {
		return "string"
	}
	if v.kind == KindInt {
		return "integer"
	}
	if v.kind == KindFloat {
		return "float"
	}
	if v.kind == KindBool {
		return "bool"
	}
	if v.kind == KindList {
		return "list"
	}
	if v.kind == KindMap {
		return "map"
	}
	return "nil"
}

// printArgs is Go's fmt.Sprint over values: a space between two operands when neither is a string.
fn printArgs(args []Value) str {
	mut out = ""
	mut prevStr = false
	for i, a in args {
		let curStr = a.kind == KindStr
		if i > 0 && !prevStr && !curStr {
			out += " "
		}
		out += printValue(a)
		prevStr = curStr
	}
	return out
}

// escaperText is the text the html, js and urlquery builtins escape, Go's evalArgs: a single string
// as it is, else the operands printed as print does, a missing value printed "<no value>".
fn escaperText(args []Value) str {
	if len(args) == 1 && args[0].kind == KindStr {
		return args[0].s
	}
	mut vals = []Value{}
	for _, a in args {
		if a.kind == KindNone {
			vals = append(vals, Str("<no value>"))
		} else {
			vals = append(vals, a)
		}
	}
	return printArgs(vals)
}

// compare returns -1, 0 or 1 for the ordered values; ok is false for values Go does not order. As in
// Go, an integer and a float are different types and do not compare.
fn compare(a Value, b Value) (i64, bool) {
	if a.kind == KindInt {
		if b.kind == KindInt {
			return order(a.n, b.n), true
		}
		return 0, false
	}
	if a.kind == KindFloat {
		if b.kind == KindFloat {
			return orderF(a.f, b.f), true
		}
		return 0, false
	}
	if a.kind == KindStr {
		if b.kind == KindStr {
			if a.s < b.s {
				return -1, true
			}
			if a.s > b.s {
				return 1, true
			}
			return 0, true
		}
		return 0, false
	}
	if a.kind == KindBool {
		if b.kind == KindBool {
			if a.b == b.b {
				return 0, true
			}
			return 0, false
		}
		return 0, false
	}
	if a.kind == KindNone {
		if b.kind == KindNone {
			return 0, true
		}
		return 0, false
	}
	return 0, false
}

// order compares two i64s.
fn order(x i64, y i64) i64 {
	if x < y {
		return -1
	}
	if x > y {
		return 1
	}
	return 0
}

// orderF compares two f64s.
fn orderF(x f64, y f64) i64 {
	if x < y {
		return -1
	}
	if x > y {
		return 1
	}
	return 0
}

// equal is Go's eq of two values: values of different kinds are an error unless one is missing
// (then they differ), lists and maps are not comparable, and two missing values are equal.
fn equal(a Value, b Value) !bool {
	if a.kind != b.kind {
		if a.kind == KindNone || b.kind == KindNone {
			return false
		}
		fail say.Fault("stencil: incompatible types for comparison: %s and %s", kindName(a), kindName(b))
	}
	if a.kind == KindList || a.kind == KindMap {
		fail say.Fault("stencil: non-comparable type %s", kindName(a))
	}
	if a.kind == KindNone {
		return true
	}
	if a.kind == KindBool {
		return a.b == b.b
	}
	let (c, _) = compare(a, b)
	return c == 0
}

// less is Go's lt: integers, floats and strings of one kind; anything else is an error.
fn less(a Value, b Value) !bool {
	if a.kind != KindInt && a.kind != KindFloat && a.kind != KindStr || b.kind != KindInt && b.kind != KindFloat && b.kind != KindStr {
		fail say.Fault("stencil: invalid type for comparison")
	}
	if a.kind != b.kind {
		fail say.Fault("stencil: incompatible types for comparison: %s and %s", kindName(a), kindName(b))
	}
	let (c, _) = compare(a, b)
	return c < 0
}

// isBuiltin reports whether name is one of the builtins.
fn isBuiltin(name str) bool {
	return name == "len" || name == "index" || name == "eq" || name == "ne" || name == "lt" ||
		name == "le" || name == "gt" || name == "ge" || name == "and" || name == "or" ||
		name == "not" || name == "printf" || name == "print" || name == "println" ||
		name == "html" || name == "urlquery" || name == "js" || name == "slice"
}

// builtin calls one of the builtins.
fn builtin(name str, args []Value) !Value {
	if name == "len" {
		if len(args) != 1 {
			fail say.Fault("stencil: len needs one argument")
		}
		let v = args[0]
		if v.kind == KindStr {
			return Int(i64(len(v.s)))
		}
		if v.kind == KindList {
			return Int(i64(len(v.xs)))
		}
		if v.kind == KindMap {
			return Int(i64(len(v.m)))
		}
		fail say.Fault("stencil: len of a non-collection")
	}
	if name == "index" {
		return try builtinIndex(args)
	}
	if name == "eq" {
		let same = try allEqual(args)
		return Bool(same)
	}
	if name == "ne" {
		if len(args) != 2 {
			fail say.Fault("stencil: ne needs two arguments")
		}
		let same = try equal(args[0], args[1])
		return Bool(!same)
	}
	if name == "lt" || name == "le" || name == "gt" || name == "ge" {
		if len(args) != 2 {
			fail say.Fault("stencil: %s needs two arguments", name)
		}
		// Go's le is lt or eq, gt is not le, and ge is not lt.
		let lt = try less(args[0], args[1])
		if name == "lt" {
			return Bool(lt)
		}
		if name == "ge" {
			return Bool(!lt)
		}
		mut le = lt
		if !lt {
			le = try equal(args[0], args[1])
		}
		if name == "le" {
			return Bool(le)
		}
		return Bool(!le)
	}
	if (name == "and" || name == "or") && len(args) == 0 {
		fail say.Fault("stencil: wrong number of args for %s: want at least 1 got 0", name)
	}
	if name == "and" {
		mut last = None()
		for _, a in args {
			last = a
			if !truthy(a) {
				return a
			}
		}
		return last
	}
	if name == "or" {
		mut last = None()
		for _, a in args {
			last = a
			if truthy(a) {
				return a
			}
		}
		return last
	}
	if name == "not" {
		if len(args) != 1 {
			fail say.Fault("stencil: not needs one argument")
		}
		return Bool(!truthy(args[0]))
	}
	if name == "printf" {
		if len(args) == 0 {
			fail say.Fault("stencil: printf needs a format")
		}
		let f = args[0]
		if f.kind != KindStr {
			fail say.Fault("stencil: printf's first argument must be a string")
		}
		let text = try format(f.s, args[1:len(args)])
		return Str(text)
	}
	if name == "print" {
		// Go's fmt.Sprint adds a space between operands when neither is a string.
		return Str(printArgs(args))
	}
	if name == "println" {
		// Sprintln always adds the space and appends a newline.
		mut out = ""
		for i, a in args {
			if i > 0 {
				out += " "
			}
			out += printValue(a)
		}
		return Str(out + "\n")
	}
	if name == "html" {
		return Str(escapeHTML(escaperText(args)))
	}
	if name == "urlquery" {
		return Str(escapeURL(escaperText(args)))
	}
	if name == "js" {
		return Str(escapeJS(escaperText(args)))
	}
	if name == "slice" {
		return try builtinSlice(args)
	}
	fail say.Fault("stencil: no function %q", name)
}

// allEqual is Go's eq: two or more arguments, true when the first equals any of the others.
fn allEqual(args []Value) !bool {
	if len(args) < 2 {
		fail say.Fault("stencil: eq needs two or more arguments")
	}
	for i in 1..len(args) {
		let same = try equal(args[0], args[i])
		if same {
			return true
		}
	}
	return false
}

// builtinIndex is Go's index: index x k1 k2... walks lists, maps and strings (a string's byte is an
// integer); with no keys it is x itself.
fn builtinIndex(args []Value) !Value {
	if len(args) == 0 {
		fail say.Fault("stencil: wrong number of args for index: want at least 1 got 0")
	}
	mut cur = args[0]
	if cur.kind == KindNone {
		fail say.Fault("stencil: index of untyped nil")
	}
	for i in 1..len(args) {
		let key = args[i]
		if cur.kind == KindNone {
			fail say.Fault("stencil: index of untyped nil")
		}
		if cur.kind == KindStr {
			if key.kind != KindInt {
				fail say.Fault("stencil: cannot index a string with a %s", kindName(key))
			}
			if key.n < 0 || key.n >= i64(len(cur.s)) {
				fail say.Fault("stencil: index out of range: %d", key.n)
			}
			cur = Int(i64(cur.s[key.n]))
		} else if cur.kind == KindList {
			if key.kind != KindInt {
				fail say.Fault("stencil: a list index must be an integer")
			}
			if key.n < 0 || key.n >= i64(len(cur.xs)) {
				fail say.Fault("stencil: index out of range")
			}
			cur = cur.xs[key.n]
		} else if cur.kind == KindMap {
			if key.kind != KindStr {
				fail say.Fault("stencil: a map key must be a string")
			}
			let (v, ok) = cur.m[key.s]
			if !ok {
				cur = None()
			} else {
				cur = v
			}
		} else {
			fail say.Fault("stencil: index of a non-collection")
		}
	}
	return cur
}

// builtinSlice is Go's slice: slice x i j k on a list (up to three indices) or a string (up to two),
// with 0 <= i <= j <= k <= len; with no indices it is x itself.
fn builtinSlice(args []Value) !Value {
	if len(args) == 0 {
		fail say.Fault("stencil: wrong number of args for slice: want at least 1 got 0")
	}
	let item = args[0]
	if item.kind == KindNone {
		fail say.Fault("stencil: slice of untyped nil")
	}
	if item.kind != KindList && item.kind != KindStr {
		fail say.Fault("stencil: can't slice item of type %s", kindName(item))
	}
	let idx = args[1:len(args)]
	if len(idx) > 3 {
		fail say.Fault("stencil: too many slice indexes: %d", len(idx))
	}
	if item.kind == KindStr && len(idx) == 3 {
		fail say.Fault("stencil: cannot 3-index slice a string")
	}
	mut n = i64(len(item.xs))
	if item.kind == KindStr {
		n = i64(len(item.s))
	}
	mut at = []i64{0, n}
	for i, x in idx {
		if x.kind != KindInt {
			fail say.Fault("stencil: cannot index slice/array with type %s", kindName(x))
		}
		if x.n < 0 || x.n > n {
			fail say.Fault("stencil: index out of range: %d", x.n)
		}
		if i < 2 {
			at[i] = x.n
		}
	}
	if at[0] > at[1] {
		fail say.Fault("stencil: invalid slice index: %d > %d", at[0], at[1])
	}
	if len(idx) == 3 && at[1] > idx[2].n {
		fail say.Fault("stencil: invalid slice index: %d > %d", at[1], idx[2].n)
	}
	if item.kind == KindStr {
		return Str(item.s[at[0]:at[1]])
	}
	return List(item.xs[at[0]:at[1]])
}
