package stencil

// printf formatting for templates and the escapers the html, urlquery and js builtins use.

import "fault"
import "glyph"
import "say"

// format is Go's fmt.Sprintf over template values, for the verbs templates use: v, s, q, d, t,
// f, F, g, G, e, E, x, X, o, b and c, with flags, width and precision. Missing arguments and
// extra arguments are marked as Go marks them.
fn format(f str, args []Value) !str {
	mut out = ""
	mut argi = 0
	mut i = 0
	for i < len(f) {
		if f[i] != '%' {
			out += f[i:i+1]
			i += 1
			continue
		}
		i += 1
		if i < len(f) && f[i] == '%' {
			out += "%"
			i += 1
			continue
		}
		let specStart = i - 1
		for i < len(f) && isFlag(f[i]) {
			i += 1
		}
		for i < len(f) && f[i] >= '0' && f[i] <= '9' {
			i += 1
		}
		if i < len(f) && f[i] == '.' {
			i += 1
			for i < len(f) && f[i] >= '0' && f[i] <= '9' {
				i += 1
			}
		}
		if i >= len(f) {
			out += "%!(NOVERB)"
			break
		}
		let verb = f[i]
		i += 1
		let spec = f[specStart:i]
		if verb == '%' {
			// Go's %% ignores the flags, width and precision before it and takes no operand.
			out += "%"
			continue
		}
		if argi >= len(args) {
			out += say.Fmt("%%!%s(MISSING)", stringOf(verb))
			continue
		}
		let v = args[argi]
		argi += 1
		let piece = try formatOne(spec, verb, v)
		out += piece
	}
	if argi < len(args) {
		out += "%!(EXTRA "
		for k in argi..len(args) {
			if k > argi {
				out += ", "
			}
			if args[k].kind == KindNone {
				out += "<nil>"
			} else {
				out += kindOf(args[k]) + "=" + printValue(args[k])
			}
		}
		out += ")"
	}
	return out
}

// isFlag reports a printf flag byte.
fn isFlag(c u8) bool {
	return c == '-' || c == '+' || c == ' ' || c == '0' || c == '#'
}

// kindOf names a value's type as Go's %! marks do for the same data in Go (an int, a []any, a
// map[string]any).
fn kindOf(v Value) str {
	if v.kind == KindNone {
		return "<nil>"
	}
	if v.kind == KindStr {
		return "string"
	}
	if v.kind == KindInt {
		return "int"
	}
	if v.kind == KindFloat {
		return "float64"
	}
	if v.kind == KindBool {
		return "bool"
	}
	if v.kind == KindList {
		return "[]interface {{}}"
	}
	return "map[string]interface {{}}"
}

// formatOne formats one value with one verb, as Go's fmt does: a list or a map formats each element
// with the verb, and a verb that does not fit the value is marked %!verb(type=value).
fn formatOne(spec str, verb u8, v Value) !str {
	return formatDepth(spec, verb, v, 0)
}

// formatDepth is formatOne inside depth lists and maps, where a nil element prints as <nil>.
fn formatDepth(spec str, verb u8, v Value, depth i64) str {
	if verb == 'T' {
		return say.Fmt("%s", kindOf(v))
	}
	if v.kind == KindNone {
		if depth > 0 {
			return "<nil>"
		}
		if verb == 'v' {
			return say.Fmt(spec[0:len(spec)-1] + "s", "<nil>")
		}
		return say.Fmt("%%!%s(<nil>)", stringOf(verb))
	}
	if v.kind == KindList {
		mut out = "["
		for i, item in v.xs {
			if i > 0 {
				out += " "
			}
			out += formatDepth(spec, verb, item, depth + 1)
		}
		return out + "]"
	}
	if v.kind == KindMap {
		mut out = "map["
		for i, k in sortedKeys(v.m) {
			if i > 0 {
				out += " "
			}
			out += formatDepth(spec, verb, Str(k), depth + 1) + ":" + formatDepth(spec, verb, v.m[k], depth + 1)
		}
		return out + "]"
	}
	if !verbFits(verb, v.kind) {
		let vspec = spec[0:len(spec)-1] + "v"
		return say.Fmt("%%!%s(%s=%s)", stringOf(verb), kindOf(v), scalarFormat(vspec, v))
	}
	return scalarFormat(spec, v)
}

// verbFits reports whether Go's fmt formats a value of the kind with the verb.
fn verbFits(verb u8, kind i64) bool {
	if verb == 'v' {
		return true
	}
	if kind == KindStr {
		return verb == 's' || verb == 'q' || verb == 'x' || verb == 'X'
	}
	if kind == KindInt {
		return verb == 'd' || verb == 'b' || verb == 'o' || verb == 'O' || verb == 'x' || verb == 'X' || verb == 'c' || verb == 'q' || verb == 'U'
	}
	if kind == KindFloat {
		return verb == 'b' || verb == 'e' || verb == 'E' || verb == 'f' || verb == 'F' || verb == 'g' || verb == 'G' || verb == 'x' || verb == 'X'
	}
	if kind == KindBool {
		return verb == 't'
	}
	return false
}

// scalarFormat formats a string, number or bool with a printf spec.
fn scalarFormat(spec str, v Value) str {
	if v.kind == KindStr {
		return say.Fmt(spec, v.s)
	}
	if v.kind == KindInt {
		return say.Fmt(spec, v.n)
	}
	if v.kind == KindFloat {
		return say.Fmt(spec, v.f)
	}
	return say.Fmt(spec, v.b)
}

// escapeHTML escapes text for HTML element content, as Go's html escaper does.
fn escapeHTML(s str) str {
	mut out = ""
	for i in 0..len(s) {
		let c = s[i]
		if c == '&' {
			out += "&amp;"
		} else if c == '<' {
			out += "&lt;"
		} else if c == '>' {
			out += "&gt;"
		} else if c == '"' {
			out += "&#34;"
		} else if c == '\'' {
			out += "&#39;"
		} else if c == 0 {
			// U+FFFD, the replacement character, as Go writes it.
			out += replacementChar()
		} else {
			out += s[i:i+1]
		}
	}
	return out
}

// replacementChar is U+FFFD in UTF-8.
fn replacementChar() str {
	let b = []u8{0xEF, 0xBF, 0xBD}
	return rt_str_from_raw(cast(i64, b)[2], 3)
}

// escapeURL is Go's urlquery: percent-encoding with + for spaces.
fn escapeURL(s str) str {
	mut out = ""
	for i in 0..len(s) {
		let c = s[i]
		if isURLSafe(c) {
			out += s[i:i+1]
		} else if c == ' ' {
			out += "+"
		} else {
			out += say.Fmt("%%%02X", u64(c))
		}
	}
	return out
}

// isURLSafe reports the unreserved URL characters.
fn isURLSafe(c u8) bool {
	if c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' {
		return true
	}
	return c == '-' || c == '_' || c == '.' || c == '~'
}

// escapeJS escapes text for a JavaScript string, as Go's text/template js escaper
// (JSEscapeString) does: backslash, both quotes and <, >, & and = get short escapes, control
// characters and non-printable runes become \uXXXX, and printable runes stay, so </script>
// cannot end the element.
fn escapeJS(s str) str {
	mut out = ""
	mut i = 0
	for i < len(s) {
		let c = s[i]
		if c == '\\' {
			out += "\\\\"
			i += 1
		} else if c == '\'' {
			out += "\\'"
			i += 1
		} else if c == '"' {
			out += "\\\""
			i += 1
		} else if c == '<' {
			out += "\\u003C"
			i += 1
		} else if c == '>' {
			out += "\\u003E"
			i += 1
		} else if c == '&' {
			out += "\\u0026"
			i += 1
		} else if c == '=' {
			out += "\\u003D"
			i += 1
		} else if c < 0x20 {
			out += say.Fmt("\\u%04X", i64(c))
			i += 1
		} else if c < 0x7f {
			out += s[i:i+1]
			i += 1
		} else {
			let (r, n) = glyph.DecodeRune(s, i)
			if glyph.IsPrint(r) {
				out += s[i:i+n]
			} else {
				out += say.Fmt("\\u%04X", u64(r))
			}
			i += n
		}
	}
	return out
}

// escapeJSStr escapes text for a JavaScript string inside an HTML <script> element, as Go's
// html/template jsStrEscaper does: control characters as \u00xx (with the short \t, \n, \f and
// \r), the HTML specials as lowercase hex so the result also embeds in an attribute, "/" as \/
// and "\" as \\.
fn escapeJSStr(s str) str {
	mut out = ""
	mut i = 0
	for i < len(s) {
		let c = s[i]
		if c == '\t' {
			out += "\\t"
			i += 1
		} else if c == '\n' {
			out += "\\n"
			i += 1
		} else if c == '\f' {
			out += "\\f"
			i += 1
		} else if c == '\r' {
			out += "\\r"
			i += 1
		} else if c < 0x20 {
			out += say.Fmt("\\u%04x", i64(c))
			i += 1
		} else if c == '"' {
			out += "\\u0022"
			i += 1
		} else if c == '`' {
			out += "\\u0060"
			i += 1
		} else if c == '&' {
			out += "\\u0026"
			i += 1
		} else if c == '\'' {
			out += "\\u0027"
			i += 1
		} else if c == '+' {
			out += "\\u002b"
			i += 1
		} else if c == '/' {
			out += "\\/"
			i += 1
		} else if c == '<' {
			out += "\\u003c"
			i += 1
		} else if c == '>' {
			out += "\\u003e"
			i += 1
		} else if c == '\\' {
			out += "\\\\"
			i += 1
		} else if c < 0x7f {
			out += s[i:i+1]
			i += 1
		} else {
			let (r, n) = glyph.DecodeRune(s, i)
			if r == 0x2028 {
				out += "\\u2028"
			} else if r == 0x2029 {
				out += "\\u2029"
			} else {
				out += s[i:i+n]
			}
			i += n
		}
	}
	return out
}
