package seal

// ---- DES and triple DES (FIPS 46-3), as Go's crypto/des ----
// DES is broken (a 56-bit key) and triple DES is deprecated (64-bit blocks: Sweet32). They are here
// for the protocols that still name them (NTLM, MSCHAPv2, old TLS and Kerberos); use AES-GCM or
// ChaCha20-Poly1305 for anything new. The layout is Go's: the permutations are bit exchanges, the
// rounds look up S-box tables merged with the P permutation, and the subkeys are kept byte-aligned.
// The lookups are indexed by key and data, as Go's are, so DES is not constant-time.

// DES is the DES or triple-DES (EDE, three keys) block cipher with its key, as Go's des.NewCipher
// and des.NewTripleDESCipher; it satisfies Block. Broken or deprecated: legacy protocols only.
type DES struct {
	triple bool
	ks     []u64 // the subkeys: 16, or 48 for the three keys of triple DES
}

// desSBoxes are the eight S-boxes, 4 rows of 16 each.
let desSBoxes []u8 = []u8{
	14, 4, 13, 1, 2, 15, 11, 8, 3, 10, 6, 12, 5, 9, 0, 7,
	0, 15, 7, 4, 14, 2, 13, 1, 10, 6, 12, 11, 9, 5, 3, 8,
	4, 1, 14, 8, 13, 6, 2, 11, 15, 12, 9, 7, 3, 10, 5, 0,
	15, 12, 8, 2, 4, 9, 1, 7, 5, 11, 3, 14, 10, 0, 6, 13,
	15, 1, 8, 14, 6, 11, 3, 4, 9, 7, 2, 13, 12, 0, 5, 10,
	3, 13, 4, 7, 15, 2, 8, 14, 12, 0, 1, 10, 6, 9, 11, 5,
	0, 14, 7, 11, 10, 4, 13, 1, 5, 8, 12, 6, 9, 3, 2, 15,
	13, 8, 10, 1, 3, 15, 4, 2, 11, 6, 7, 12, 0, 5, 14, 9,
	10, 0, 9, 14, 6, 3, 15, 5, 1, 13, 12, 7, 11, 4, 2, 8,
	13, 7, 0, 9, 3, 4, 6, 10, 2, 8, 5, 14, 12, 11, 15, 1,
	13, 6, 4, 9, 8, 15, 3, 0, 11, 1, 2, 12, 5, 10, 14, 7,
	1, 10, 13, 0, 6, 9, 8, 7, 4, 15, 14, 3, 11, 5, 2, 12,
	7, 13, 14, 3, 0, 6, 9, 10, 1, 2, 8, 5, 11, 12, 4, 15,
	13, 8, 11, 5, 6, 15, 0, 3, 4, 7, 2, 12, 1, 10, 14, 9,
	10, 6, 9, 0, 12, 11, 7, 13, 15, 1, 3, 14, 5, 2, 8, 4,
	3, 15, 0, 6, 10, 1, 13, 8, 9, 4, 5, 11, 12, 7, 2, 14,
	2, 12, 4, 1, 7, 10, 11, 6, 8, 5, 3, 15, 13, 0, 14, 9,
	14, 11, 2, 12, 4, 7, 13, 1, 5, 0, 15, 10, 3, 9, 8, 6,
	4, 2, 1, 11, 10, 13, 7, 8, 15, 9, 12, 5, 6, 3, 0, 14,
	11, 8, 12, 7, 1, 14, 2, 13, 6, 15, 0, 9, 10, 4, 5, 3,
	12, 1, 10, 15, 9, 2, 6, 8, 0, 13, 3, 4, 14, 7, 5, 11,
	10, 15, 4, 2, 7, 12, 9, 5, 6, 1, 13, 14, 0, 11, 3, 8,
	9, 14, 15, 5, 2, 8, 12, 3, 7, 0, 4, 10, 1, 13, 11, 6,
	4, 3, 2, 12, 9, 5, 15, 10, 11, 14, 1, 7, 6, 0, 8, 13,
	4, 11, 2, 14, 15, 0, 8, 13, 3, 12, 9, 7, 5, 10, 6, 1,
	13, 0, 11, 7, 4, 9, 1, 10, 14, 3, 5, 12, 2, 15, 8, 6,
	1, 4, 11, 13, 12, 3, 7, 14, 10, 15, 6, 8, 0, 5, 9, 2,
	6, 11, 13, 8, 1, 4, 10, 7, 9, 5, 0, 15, 14, 2, 3, 12,
	13, 2, 8, 4, 6, 15, 11, 1, 10, 9, 3, 14, 5, 0, 12, 7,
	1, 15, 13, 8, 10, 3, 7, 4, 12, 5, 6, 11, 0, 14, 9, 2,
	7, 11, 4, 1, 9, 12, 14, 2, 0, 6, 10, 13, 15, 3, 5, 8,
	2, 1, 14, 7, 4, 10, 8, 13, 15, 12, 9, 0, 3, 5, 6, 11,
}

// desP is the permutation after the S-boxes, as the source bit of each output bit (bit 0 lowest).
let desP []u8 = []u8{16, 25, 12, 11, 3, 20, 4, 15, 31, 17, 9, 6, 27, 14, 1, 22, 30, 24, 8, 18, 0, 5, 29, 23, 13, 19, 2, 26, 10, 21, 28, 7}

// desPC1 picks the key's 56 bits; desPC2 picks each subkey's 48 bits from the rotated halves.
let desPC1 []u8 = []u8{7, 15, 23, 31, 39, 47, 55, 63, 6, 14, 22, 30, 38, 46, 54, 62, 5, 13, 21, 29, 37, 45, 53, 61, 4, 12, 20, 28, 1, 9, 17, 25, 33, 41, 49, 57, 2, 10, 18, 26, 34, 42, 50, 58, 3, 11, 19, 27, 35, 43, 51, 59, 36, 44, 52, 60}
let desPC2 []u8 = []u8{42, 39, 45, 32, 55, 51, 53, 28, 41, 50, 35, 46, 33, 37, 44, 52, 30, 48, 40, 49, 29, 36, 43, 54, 15, 4, 25, 19, 9, 1, 26, 16, 5, 11, 23, 8, 12, 7, 17, 0, 22, 3, 10, 14, 6, 20, 27, 24}

// desRotations is the key schedule's left rotation per round.
let desRotations []u8 = []u8{1, 1, 2, 2, 2, 2, 2, 2, 1, 2, 2, 2, 2, 2, 2, 1}

// desBox is each S-box merged with P (and the rounds' one-bit rotation): 8 tables of 64.
let desBox []u32 = des_build_box()

// des_permute picks bits of src: output bit len(perm)-1-k is src's bit perm[k].
fn des_permute(src u64, perm []u8) u64 {
	mut out = u64(0)
	let n = len(perm)
	for k in 0..n {
		out |= ((src >> u64(perm[k])) & 1) << u64(n-1-k)
	}
	return out
}

fn des_build_box() []u32 {
	let box = make([]u32, 8*64)
	for s in 0..8 {
		for i in 0..4 {
			for j in 0..16 {
				let v = u64(desSBoxes[64*s+16*i+j]) << u64(4*(7-s))
				let f = u32(des_permute(v, desP))
				// The row is the first and sixth bit, the column the middle four.
				let t = ((i & 2) << 4) | (i & 1) | (j << 1)
				box[64*s+t] = (f << 1) | (f >> 31)
			}
		}
	}
	return box
}

// des_rotate28 is the 16 rotated values of a 28-bit key half.
fn des_rotate28(x u32) []u32 {
	let out = make([]u32, 16)
	mut last = x
	for i in 0..16 {
		let r = u32(desRotations[i])
		last = ((last << (4 + r)) >> 4) | ((last << 4) >> (32 - r))
		out[i] = last
	}
	return out
}

// des_unpack spreads the 48 subkey bits as eight 6-bit groups, each at the bottom of a byte, in
// the order the rounds read them.
fn des_unpack(x u64) u64 {
	return ((x >> 6) & 0xff) | (((x >> 18) & 0xff) << 8) | (((x >> 30) & 0xff) << 16) | (((x >> 42) & 0xff) << 24) |
		((x & 0xff) << 32) | (((x >> 12) & 0xff) << 40) | (((x >> 24) & 0xff) << 48) | (((x >> 36) & 0xff) << 56)
}

// des_subkeys appends the 16 subkeys of the 8 key bytes at p.
fn des_subkeys(ks mut []u64, key []u8, at i64) {
	mut k = u64(0)
	for i in 0..8 {
		k = (k << 8) | u64(key[at+i])
	}
	let pk = des_permute(k, desPC1)
	let left = des_rotate28(u32(pk >> 28))
	let right = des_rotate28(u32(pk & 0x0fffffff))
	for i in 0..16 {
		let in56 = (u64(left[i]) << 28) | u64(right[i])
		ks = append(ks, des_unpack(des_permute(in56, desPC2)))
	}
}

// NewDES is DES with an 8-byte key, as Go's des.NewCipher (the parity bits are ignored); another
// length fails as Go's KeySizeError does. DES is broken: legacy protocols only.
fn NewDES(key secret []u8) !DES {
	if len(key) != 8 {
		fail "seal: invalid DES key size {len(key)}"
	}
	mut ks = make([]u64, 0, 16)
	des_subkeys(mut ks, key, 0)
	return DES{triple: false, ks: ks}
}

// NewTripleDES is triple DES (encrypt with the first 8 key bytes, decrypt with the next 8, encrypt
// with the last 8) with a 24-byte key, as Go's des.NewTripleDESCipher; another length fails as Go's
// KeySizeError does. Two-key 3DES is a key whose last 8 bytes repeat the first. Deprecated.
fn NewTripleDES(key secret []u8) !DES {
	if len(key) != 24 {
		fail "seal: invalid DES key size {len(key)}"
	}
	mut ks = make([]u64, 0, 48)
	des_subkeys(mut ks, key, 0)
	des_subkeys(mut ks, key, 8)
	des_subkeys(mut ks, key, 16)
	return DES{triple: true, ks: ks}
}

// BlockSize is DES's block length, 8 bytes.
fn (d DES) BlockSize() i64 {
	return 8
}

// Encrypt encrypts the first 8 bytes of src into dst (dst may be src).
fn (d DES) Encrypt(dst mut []u8, src []u8) {
	block_args("DES", 8, dst, src)
	d.crypt(cast(i64, dst)[2], cast(i64, src)[2], 1, false)
}

// Decrypt decrypts the first 8 bytes of src into dst (dst may be src).
fn (d DES) Decrypt(dst mut []u8, src []u8) {
	block_args("DES", 8, dst, src)
	d.crypt(cast(i64, dst)[2], cast(i64, src)[2], 1, true)
}

// EncryptBlocks encrypts every 8-byte block of src on its own into dst (the modes' batch form).
fn (d DES) EncryptBlocks(dst mut []u8, src []u8) {
	blocks_args("DES", 8, dst, src)
	if len(src) > 0 {
		d.crypt(cast(i64, dst)[2], cast(i64, src)[2], len(src)/8, false)
	}
}

// DecryptBlocks decrypts every 8-byte block of src on its own into dst (the modes' batch form).
fn (d DES) DecryptBlocks(dst mut []u8, src []u8) {
	blocks_args("DES", 8, dst, src)
	if len(src) > 0 {
		d.crypt(cast(i64, dst)[2], cast(i64, src)[2], len(src)/8, true)
	}
}

// crypt runs the n blocks at src through DES or triple DES into dst (dst may be src). Triple DES
// keeps the halves between its three passes: the final and initial permutations cancel.
fn (d DES) crypt(dst i64, src i64, n i64, decrypt bool) {
	for b in 0..n {
		let x = des_ip(bits_be64(src + 8*b))
		mut l = des_rotl1(u32(x >> 32))
		mut r = des_rotl1(u32(x & 0xffffffff))
		if !d.triple {
			l, r = des_rounds(d.ks, 0, l, r, decrypt)
		} else if !decrypt {
			l, r = des_rounds(d.ks, 0, l, r, false)
			r, l = des_rounds(d.ks, 16, r, l, true)
			l, r = des_rounds(d.ks, 32, l, r, false)
		} else {
			l, r = des_rounds(d.ks, 32, l, r, true)
			r, l = des_rounds(d.ks, 16, r, l, false)
			l, r = des_rounds(d.ks, 0, l, r, true)
		}
		let out = (u64(des_rotr1(r)) << 32) | u64(des_rotr1(l))
		put_be64(dst + 8*b, des_fp(out))
	}
}

fn des_rotl1(x u32) u32 {
	return (x << 1) | (x >> 31)
}

fn des_rotr1(x u32) u32 {
	return (x << 31) | (x >> 1)
}

fn bits_be64(p i64) u64 {
	mut x = u64(0)
	for i in 0..8 {
		x = (x << 8) | u64(load8(p + i))
	}
	return x
}

fn put_be64(p i64, x u64) {
	for i in 0..8 {
		store8(p+i, u8(x >> u64(56-8*i)))
	}
}

// des_rounds runs the 16 rounds of the subkeys at ks[at], forwards or (decrypting) backwards, two
// rounds per step as Go's feistel does.
fn des_rounds(ks []u64, at i64, l0 u32, r0 u32, decrypt bool) (u32, u32) {
	mut l = l0
	mut r = r0
	for i in 0..8 {
		mut k0 = ks[at+2*i]
		mut k1 = ks[at+2*i+1]
		if decrypt {
			k0 = ks[at+15-2*i]
			k1 = ks[at+14-2*i]
		}
		l ^= des_f(r, k0)
		r ^= des_f(l, k1)
	}
	return l, r
}

// des_f is the round function on the rotated half r: the expansion is two views of r, the subkey's
// groups line up with their bytes, and each table lookup does an S-box and P.
fn des_f(r u32, k u64) u32 {
	let t = r ^ u32(k >> 32)
	let u = ((r << 28) | (r >> 4)) ^ u32(k & 0xffffffff)
	return desBox[448+i64(t&0x3f)] ^ desBox[320+i64((t>>8)&0x3f)] ^ desBox[192+i64((t>>16)&0x3f)] ^ desBox[64+i64((t>>24)&0x3f)] ^
		desBox[384+i64(u&0x3f)] ^ desBox[256+i64((u>>8)&0x3f)] ^ desBox[128+i64((u>>16)&0x3f)] ^ desBox[i64((u>>24)&0x3f)]
}

// des_ip is the initial permutation as five bit exchanges.
fn des_ip(x u64) u64 {
	mut b = x
	mut b1 = b >> 48
	mut b2 = b << 48
	b ^= b1 ^ b2 ^ (b1 << 48) ^ (b2 >> 48)
	b1 = (b >> 32) & 0xff00ff
	b2 = b & 0xff00ff00
	b ^= (b1 << 32) ^ b2 ^ (b1 << 8) ^ (b2 << 24)
	b1 = b & 0x0f0f00000f0f0000
	b2 = b & 0x0000f0f00000f0f0
	b ^= b1 ^ b2 ^ (b1 >> 12) ^ (b2 << 12)
	b1 = b & 0x3300330033003300
	b2 = b & 0x00cc00cc00cc00cc
	b ^= b1 ^ b2 ^ (b1 >> 6) ^ (b2 << 6)
	b1 = b & 0xaaaaaaaa55555555
	b ^= b1 ^ (b1 >> 33) ^ (b1 << 33)
	return b
}

// des_fp is the final permutation: des_ip's exchanges in reverse order.
fn des_fp(x u64) u64 {
	mut b = x
	mut b1 = b & 0xaaaaaaaa55555555
	b ^= b1 ^ (b1 >> 33) ^ (b1 << 33)
	b1 = b & 0x3300330033003300
	mut b2 = b & 0x00cc00cc00cc00cc
	b ^= b1 ^ b2 ^ (b1 >> 6) ^ (b2 << 6)
	b1 = b & 0x0f0f00000f0f0000
	b2 = b & 0x0000f0f00000f0f0
	b ^= b1 ^ b2 ^ (b1 >> 12) ^ (b2 << 12)
	b1 = (b >> 32) & 0xff00ff
	b2 = b & 0xff00ff00
	b ^= (b1 << 32) ^ b2 ^ (b1 << 8) ^ (b2 << 24)
	b1 = b >> 48
	b2 = b << 48
	b ^= b1 ^ b2 ^ (b1 << 48) ^ (b2 >> 48)
	return b
}
