// seal on macOS: every Apple arm64 CPU has the SHA-256 instructions.
package seal

// hw_sha256 reports whether Sha256 may use the hardware path.
fn hw_sha256() bool {
	return true
}

// aes_hw reports whether AES-GCM may use the CPU's instructions: every Apple arm64 CPU has
// AESE/AESMC and PMULL.
fn aes_hw() bool {
	return true
}

// hw_mont is true when the assembly Montgomery multiplication may run (every arm64 CPU).
fn hw_mont() bool {
	return true
}
