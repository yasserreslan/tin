package seal

// Incremental SHA-256 and SHA-1 (#773): write the data in pieces, then Sum. They share the block functions
// (and SHA-256's hardware path) with Sha256 and Sha1, so a stream hashes at the same speed as one string.

// Hasher is an incremental SHA-256 or SHA-1; it satisfies io.Writer.
type Hasher struct {
	sha1 bool
	h    []u32
	w    []u32
	buf  []u8
	n    i64
}

// NewSha256 is an incremental SHA-256.
fn NewSha256() Hasher {
	mut x = Hasher{sha1: false, h: []u32{}, w: make([]u32, 64), buf: make([]u8, 0, 64), n: 0}
	x.Reset()
	return x
}

// NewSha1 is an incremental SHA-1; use it only where a protocol requires SHA-1.
fn NewSha1() Hasher {
	mut x = Hasher{sha1: true, h: []u32{}, w: make([]u32, 80), buf: make([]u8, 0, 64), n: 0}
	x.Reset()
	return x
}

// Reset forgets everything written, as if the hasher were new.
fn (x mut Hasher) Reset() {
	if x.sha1 {
		x.h = []u32{0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476, 0xc3d2e1f0}
	} else {
		x.h = []u32{0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19}
	}
	x.buf = x.buf[0:0]
	x.n = 0
}

// Size is the length of the digest: 32 for SHA-256, 20 for SHA-1.
fn (x Hasher) Size() i64 {
	if x.sha1 {
		return 20
	}
	return 32
}

// Len is the number of bytes written since the hasher was made or reset.
fn (x Hasher) Len() i64 {
	return x.n
}

// blocks compresses n whole blocks at address p into state h.
fn hasherBlocks(sha1 bool, h mut []u32, w mut []u32, p i64, n i64) {
	if n <= 0 {
		return
	}
	if sha1 {
		sha1_blocks(mut h, mut w, p, n)
	} else if sha_hw {
		hw_blocks(cast(i64, h)[2], p, n, cast(i64, k256)[2])
	} else {
		sha256_blocks(mut h, mut w, p, n)
	}
}

// absorb adds the n bytes at address p.
fn (x mut Hasher) absorb(p i64, n i64) {
	x.n += n
	mut i = 0
	if len(x.buf) > 0 {
		for i < n && len(x.buf) < 64 {
			x.buf = append(x.buf, load8(p + i))
			i += 1
		}
		if len(x.buf) < 64 {
			return
		}
		hasherBlocks(x.sha1, mut x.h, mut x.w, cast(i64, x.buf)[2], 1)
		x.buf = x.buf[0:0]
	}
	let whole = (n - i) / 64
	hasherBlocks(x.sha1, mut x.h, mut x.w, p + i, whole)
	i += whole * 64
	for i < n {
		x.buf = append(x.buf, load8(p + i))
		i += 1
	}
}

// Write adds data to the hash; it never fails, and returns len(data).
fn (x mut Hasher) Write(data []u8) !i64 {
	if len(data) > 0 {
		x.absorb(cast(i64, data)[2], len(data))
	}
	return len(data)
}

// WriteStr adds the bytes of s to the hash.
fn (x mut Hasher) WriteStr(s str) {
	if len(s) > 0 {
		x.absorb(cast(i64, s) + 8, len(s))
	}
}

// Sum is the digest of everything written so far; the hasher can go on taking data.
fn (x Hasher) Sum() []u8 {
	mut h = make([]u32, len(x.h))
	copy(h, x.h)
	mut w = make([]u32, len(x.w))
	let rest = len(x.buf)
	mut total = 64
	if rest >= 56 {
		total = 128
	}
	mut tail = make([]u8, total)
	for i in 0..rest {
		tail[i] = x.buf[i]
	}
	tail[rest] = 0x80
	let bitlen = u64(x.n) * 8
	for i in 0..8 {
		tail[total - 1 - i] = u8(bitlen >> u64(8 * i))
	}
	hasherBlocks(x.sha1, mut h, mut w, cast(i64, tail)[2], total / 64)
	return digest(h)
}
