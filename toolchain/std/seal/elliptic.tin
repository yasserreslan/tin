package seal

import "abacus"

// ---- crypto/elliptic: the Curve shape and the NIST curves P-224, P-256, P-384 and P-521 (#927) ----
// The curves are y^2 = x^3 - 3x + b over a prime field (a = -3 for all four), so the complete
// formulas of ec_add and ec_double (ecdsa_sign.tin's ec_mul_ct for scalar multiplication) serve
// every one. Points are affine (x, y) abacus integers, (0, 0) for the point at infinity, as in Go.
// Scalars are big-endian bytes of any length: k*P is computed from all of k's bits, which equals
// Go's (k mod N)*P because every point has order dividing N. Not a precomputed-table path: each
// call builds its own scratch.

// Curve is the operations of Go's crypto/elliptic.Curve that crypto/ecdsa uses. A point (x, y)
// is affine, and (0, 0) is the point at infinity. Add, Double and ScalarMult fail where Go
// panics: on a point that is off the curve or has a coordinate out of range.
shape Curve {
	IsOnCurve(x abacus.Int, y abacus.Int) bool
	Add(x1 abacus.Int, y1 abacus.Int, x2 abacus.Int, y2 abacus.Int) !(abacus.Int, abacus.Int)
	Double(x1 abacus.Int, y1 abacus.Int) !(abacus.Int, abacus.Int)
	ScalarMult(x1 abacus.Int, y1 abacus.Int, k []u8) !(abacus.Int, abacus.Int)
	ScalarBaseMult(k []u8) (abacus.Int, abacus.Int)
}

// ellipticCurve is one of the NIST curves as a Curve.
type ellipticCurve struct {
	c ecCurve
}

// Constants of the NIST curves, as hex (big-endian): P, N, B, Gx and Gy.
mut p224cache ?ecCurve
mut p256cache ?ecCurve
mut p521cache ?ecCurve

// p224_curve is P-224, built on first use.
fn p224_curve() !ecCurve {
	let c = p224cache
	if c != nil {
		return c
	}
	let built = try ec_new("P-224",
		"ffffffffffffffffffffffffffffffff000000000000000000000001",
		"ffffffffffffffffffffffffffff16a2e0b8f03e13dd29455c5c2a3d",
		"b4050a850c04b3abf54132565044b0b7d7bfd8ba270b39432355ffb4",
		"b70e0cbd6bb4bf7f321390b94a03c1d356c21122343280d6115c1d21",
		"bd376388b5f723fb4c22dfe6cd4375a05a07476444d5819985007e34")
	p224cache = keep(built)
	return built
}

// p256_curve is P-256 as a generic curve (the same constants p256.tin uses), built on first use.
fn p256_curve() !ecCurve {
	let c = p256cache
	if c != nil {
		return c
	}
	let built = try ec_new("P-256",
		"ffffffff00000001000000000000000000000000ffffffffffffffffffffffff",
		"ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551",
		"5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b",
		"6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296",
		"4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5")
	p256cache = keep(built)
	return built
}

// p521_curve is P-521, built on first use.
fn p521_curve() !ecCurve {
	let c = p521cache
	if c != nil {
		return c
	}
	let built = try ec_new("P-521",
		"1ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
		"1fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffa51868783bf2f966b7fcc0148f709a5d03bb5c9b8899c47aebb6fb71e91386409",
		"51953eb9618e1c9a1f929a21a0b68540eea2da725b99b315f3b8b489918ef109e156193951ec7e937b1652c0bd3bb1bf073573df883d2c34f1ef451fd46b503f00",
		"c6858e06b70404e9cd9e3ecb662395b4429c648139053fb521f828af606b4d3dbaa14b5e77efe75928fe1dc127a2ffa8de3348b3c1856a429bf97e7e31c2e5bd66",
		"11839296a789a3bc0045c8a5fb42c7d1bd998f54449579b446817afbd17273e662c97ee72995ef42640c550b9013fad0761353c7086a272c24088be94769fd16650")
	p521cache = keep(built)
	return built
}

// P224 is the NIST curve P-224 as a Curve. Its constants are fixed, so building it cannot fail.
fn P224() dyn Curve {
	let (c, err) = p224_curve()
	if err != nil {
		panic("seal: the P-224 constants are invalid")
	}
	return ellipticCurve{c: c}
}

// P256 is the NIST curve P-256 as a Curve.
fn P256() dyn Curve {
	let (c, err) = p256_curve()
	if err != nil {
		panic("seal: the P-256 constants are invalid")
	}
	return ellipticCurve{c: c}
}

// P384 is the NIST curve P-384 as a Curve.
fn P384() dyn Curve {
	let (c, err) = p384_curve()
	if err != nil {
		panic("seal: the P-384 constants are invalid")
	}
	return ellipticCurve{c: c}
}

// P521 is the NIST curve P-521 as a Curve.
fn P521() dyn Curve {
	let (c, err) = p521_curve()
	if err != nil {
		panic("seal: the P-521 constants are invalid")
	}
	return ellipticCurve{c: c}
}

// IsOnCurve reports whether (x, y) is a point of the curve, not the point at infinity (0, 0).
fn (e ellipticCurve) IsOnCurve(x abacus.Int, y abacus.Int) bool {
	if x.IsZero() && y.IsZero() {
		return false
	}
	let c = ec_scratch(e.c)
	let (_, err) = ec_point(mut c, x, y)
	return err == nil
}

// Add returns (x1, y1) + (x2, y2), and fails when either point is not on the curve.
fn (e ellipticCurve) Add(x1 abacus.Int, y1 abacus.Int, x2 abacus.Int, y2 abacus.Int) !(abacus.Int, abacus.Int) {
	let c = ec_scratch(e.c)
	let p = try ec_point(mut c, x1, y1) wrap "seal: Add was called on an invalid point"
	let q = try ec_point(mut c, x2, y2) wrap "seal: Add was called on an invalid point"
	mut r = ec_identity(c)
	ec_add(mut c, mut r, p, q)
	let (x, y) = ec_out(mut c, r)
	return x, y
}

// Double returns 2*(x, y), and fails when the point is not on the curve.
fn (e ellipticCurve) Double(x abacus.Int, y abacus.Int) !(abacus.Int, abacus.Int) {
	let c = ec_scratch(e.c)
	let p = try ec_point(mut c, x, y) wrap "seal: Double was called on an invalid point"
	mut r = ec_identity(c)
	ec_double(mut c, mut r, p)
	let (x, y) = ec_out(mut c, r)
	return x, y
}

// ScalarMult returns k*(x, y) for a big-endian scalar k of any length, and fails when the point is
// not on the curve. The time depends on the lengths of k and the curve, not on its bits.
fn (e ellipticCurve) ScalarMult(x abacus.Int, y abacus.Int, k []u8) !(abacus.Int, abacus.Int) {
	let c = ec_scratch(e.c)
	let p = try ec_point(mut c, x, y) wrap "seal: ScalarMult was called on an invalid point"
	let r = ec_mul_ct(mut c, p, k)
	let (x, y) = ec_out(mut c, r)
	return x, y
}

// ScalarBaseMult returns k*G for the curve's generator G and a big-endian scalar k of any length.
fn (e ellipticCurve) ScalarBaseMult(k []u8) (abacus.Int, abacus.Int) {
	let c = ec_scratch(e.c)
	let r = ec_mul_ct(mut c, ec_generator(c), k)
	let (x, y) = ec_out(mut c, r)
	return x, y
}

// ec_scratch is c with scratch buffers of its own, so a method call never shares them with another.
fn ec_scratch(c ecCurve) ecCurve {
	mut d = ecCurve{name: c.name, size: c.size, f: c.f, n: c.n, b: c.b, gx: c.gx, gy: c.gy}
	for i in 0..8 {
		d.t = append(d.t, c.f.elem())
	}
	return d
}

// ec_point reads the affine point (x, y) as Go's crypto/elliptic does: (0, 0) is the point at
// infinity, and a negative, overlong or off-curve coordinate fails.
fn ec_point(c mut ecCurve, x abacus.Int, y abacus.Int) !ecpt {
	if x.IsZero() && y.IsZero() {
		return ec_identity(c)
	}
	if x.Sign() < 0 || y.Sign() < 0 {
		fail "seal: " + c.name + " negative coordinate"
	}
	let xb = x.Bytes()
	let yb = y.Bytes()
	if len(xb) > c.size || len(yb) > c.size {
		fail "seal: " + c.name + " coordinate overflows"
	}
	mut buf = make([]u8, 0, 1+2*c.size)
	buf = append(buf, 4)
	buf = append(buf, fixed_be(xb, c.size)...)
	buf = append(buf, fixed_be(yb, c.size)...)
	return try ec_decode(mut c, buf)
}

// ec_out is p's affine (x, y) as abacus integers, (0, 0) for the point at infinity.
fn ec_out(c mut ecCurve, p ecpt) (abacus.Int, abacus.Int) {
	let (xb, yb, finite) = ec_affine(mut c, p)
	if finite == 0 {
		return abacus.FromI64(0), abacus.FromI64(0)
	}
	return abacus.FromBytes(xb), abacus.FromBytes(yb)
}

// ec_affine is p's affine x and y as c.size big-endian bytes each, and 1 unless p is the point at infinity.
fn ec_affine(c mut ecCurve, p ecpt) ([]u8, []u8, u64) {
	let zi = c.f.elem()
	c.f.inv(mut zi, p.z)
	let x = c.f.elem()
	let y = c.f.elem()
	c.f.mul(mut x, p.x, zi)
	c.f.mul(mut y, p.y, zi)
	let xb = c.f.to_bytes(x)
	let yb = c.f.to_bytes(y)
	return xb[len(xb)-c.size:], yb[len(yb)-c.size:], 1 ^ c.f.is_zero(p.z)
}

// fixed_be left-pads the big-endian b with zeros to size bytes; b must fit.
fn fixed_be(b []u8, size i64) []u8 {
	mut out = make([]u8, size)
	for i in 0..len(b) {
		out[size-len(b)+i] = b[i]
	}
	return out
}
