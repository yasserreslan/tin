package seal

// ---- block cipher modes over a Block, as Go's crypto/cipher ----
// CBC (BlockMode), CTR, CFB and OFB (Stream) over any Block (AES, DES), with Go's bytes and Go's
// rules: the IV is one block, CBC takes whole blocks, a stream keeps its place between calls, dst
// may be src but not a shifted view of it. Go panics on those misuses; here they are faults, so a
// length that came off the wire cannot take a server down. None of these modes authenticates: a
// changed ciphertext decrypts to changed plaintext without notice. Prefer AES-GCM or
// ChaCha20-Poly1305 (AEAD); CFB and OFB are deprecated in Go for CTR.

// BlockMode is a block cipher mode that works on whole blocks, as Go's cipher.BlockMode; CBC
// satisfies it.
shape BlockMode {
	BlockSize() i64
	mut CryptBlocks(dst mut []u8, src []u8) !
}

// Stream is a stream cipher, as Go's cipher.Stream: XORKeyStream XORs src with the keystream into
// dst, keeping its place between calls. BlockStream (CTR, CFB, OFB) and RC4 satisfy it.
shape Stream {
	mut XORKeyStream(dst mut []u8, src []u8) !
}

// modeChunk is how many blocks CBC decryption and CTR hand the block cipher at once.
const modeChunk = 32

// CBC is cipher block chaining over a Block, encrypting or decrypting, with its current IV; it
// satisfies BlockMode. CBC needs padding (Pkcs7Pad) and a MAC over the ciphertext: CBC decryption
// that reports bad padding is a padding oracle.
type CBC struct {
	b   dyn Block
	bs  i64
	enc bool
	iv  []u8 // the chaining block: the IV, then the last ciphertext block
	buf []u8 // scratch: a chunk of blocks
	nxt []u8 // scratch: the last ciphertext block of a chunk, kept before an in-place write
}

// cbc_new checks the IV and makes the mode.
fn cbc_new(b dyn Block, iv []u8, enc bool, name str) !CBC {
	let bs = b.BlockSize()
	if len(iv) != bs {
		fail "seal: {name}: IV length must equal block size"
	}
	let v = make([]u8, bs)
	copy(v, iv)
	return CBC{b: b, bs: bs, enc: enc, iv: v, buf: make([]u8, bs*modeChunk), nxt: make([]u8, bs)}
}

// NewCBCEncrypter is CBC encryption with b and a one-block IV, as Go's cipher.NewCBCEncrypter; an
// IV of another length is a fault. The IV must be unpredictable (RandomBytes) for each message.
fn NewCBCEncrypter(b dyn Block, iv []u8) !CBC {
	return try cbc_new(b, iv, true, "NewCBCEncrypter")
}

// NewCBCDecrypter is CBC decryption with b and a one-block IV, as Go's cipher.NewCBCDecrypter; an
// IV of another length is a fault.
fn NewCBCDecrypter(b dyn Block, iv []u8) !CBC {
	return try cbc_new(b, iv, false, "NewCBCDecrypter")
}

// BlockSize is the block length of the mode's cipher.
fn (c CBC) BlockSize() i64 {
	return c.bs
}

// SetIV starts a new message with iv, as Go's CBC SetIV; an IV of another length is a fault.
fn (c mut CBC) SetIV(iv []u8) ! {
	if len(iv) != c.bs {
		fail "seal: incorrect length IV"
	}
	copy(c.iv, iv)
}

// CryptBlocks encrypts or decrypts src into dst (dst may be src), carrying the chain into the
// next call. It fails, writing nothing, when src is not whole blocks, dst is shorter than src, or
// dst overlaps src shifted (Go's panics, in the same order).
fn (c mut CBC) CryptBlocks(dst mut []u8, src []u8) ! {
	let n = len(src)
	if n%c.bs != 0 {
		fail "seal: input not full blocks"
	}
	if len(dst) < n {
		fail "seal: output smaller than input"
	}
	let dp = cast(i64, dst)[2]
	let sp = cast(i64, src)[2]
	if inexact_overlap(dp, n, sp, n) {
		fail "seal: invalid buffer overlap"
	}
	if n == 0 {
		return
	}
	let bs = c.bs
	let ivp = cast(i64, c.iv)[2]
	let bp = cast(i64, c.buf)[2]
	if c.enc {
		// Each block waits for the one before: one block per call into the cipher.
		for off in (0..n).step(bs) {
			xor_bytes(bp, sp+off, ivp, bs)
			c.b.Encrypt(mut c.iv, c.buf)
			memcpy(dp+off, ivp, bs)
		}
		return
	}
	// Decryption is parallel: a chunk of blocks goes through the cipher at once, then each is XORed
	// with the ciphertext block before it, last first, so dst may be src.
	let np = cast(i64, c.nxt)[2]
	mut off = 0
	for off < n {
		let m = min(n-off, bs*modeChunk)
		memcpy(np, sp+off+m-bs, bs)
		memcpy(bp, sp+off, m)
		if m == len(c.buf) {
			c.b.DecryptBlocks(mut c.buf, c.buf)
		} else if m == bs {
			c.b.Decrypt(mut c.buf, c.buf)
		} else {
			c.b.DecryptBlocks(mut c.buf, c.buf[0:m])
		}
		mut k = m - bs
		for k > 0 {
			xor_bytes(dp+off+k, bp+k, sp+off+k-bs, bs)
			k -= bs
		}
		xor_bytes(dp+off, bp, ivp, bs)
		memcpy(ivp, np, bs)
		off += m
	}
}

// Pkcs7Pad is data followed by PKCS #7 padding for blocks of bs bytes (1 to 255): n bytes of value
// n, 1 <= n <= bs, so the result is whole blocks. It is a helper for CBC, not part of the mode.
fn Pkcs7Pad(data []u8, bs i64) ![]u8 {
	if bs < 1 || bs > 255 {
		fail "seal: PKCS #7 block size must be 1 to 255"
	}
	let p = bs - len(data)%bs
	let out = make([]u8, len(data)+p)
	copy(out, data)
	for i in len(data)..len(out) {
		out[i] = u8(p)
	}
	return out
}

// Pkcs7Unpad is data without its PKCS #7 padding for blocks of bs bytes (1 to 255), sharing data's
// memory. Empty data, data that is not whole blocks and wrong padding all fail with one fault, and
// the padding is read in time that depends only on bs. A CBC decryption that reports bad padding
// to an attacker who can send ciphertexts is a padding oracle: check a MAC first.
fn Pkcs7Unpad(data []u8, bs i64) ![]u8 {
	if bs < 1 || bs > 255 {
		fail "seal: PKCS #7 block size must be 1 to 255"
	}
	let n = len(data)
	if n == 0 || n%bs != 0 {
		fail "seal: invalid PKCS #7 padding"
	}
	let p = u64(data[n-1])
	// good stays 1 while 1 <= p <= bs and the last p bytes are all p; no branch on the bytes.
	mut good = ct_lt(0, p) & ct_lt(p, u64(bs)+1)
	for i in 0..bs {
		let b = u64(data[n-1-i])
		good &= 1 ^ (ct_lt(u64(i), p) & (1 ^ ct_eq(b, p)))
	}
	if good != 1 {
		fail "seal: invalid PKCS #7 padding"
	}
	return data[0:n-i64(p)]
}

// ct_lt is 1 when a < b, else 0, without a branch (a and b below 2^62).
fn ct_lt(a u64, b u64) u64 {
	return (a -% b) >> 63
}

// ct_eq is 1 when a == b, else 0, without a branch (a and b below 2^62).
fn ct_eq(a u64, b u64) u64 {
	return ((a ^ b) -% 1) >> 63
}

const streamCTR = 1
const streamCFBEncrypt = 2
const streamCFBDecrypt = 3
const streamOFB = 4

// BlockStream is a Block run as a stream cipher (CTR, CFB or OFB), with its place in the
// keystream; it satisfies Stream. Never use one key and IV for two messages.
type BlockStream struct {
	b     dyn Block
	bs    i64
	kind  i64
	reg   []u8 // CTR: the next counter block; CFB: the next block to encrypt; OFB: the last output
	ks    []u8 // the keystream: ks[used:avail] is not used yet
	ctrs  []u8 // CTR: a chunk of counter blocks
	used  i64
	avail i64
}

// stream_new checks the IV and makes the stream.
fn stream_new(b dyn Block, iv []u8, kind i64, name str) !BlockStream {
	let bs = b.BlockSize()
	if len(iv) != bs {
		fail "seal: {name}: IV length must equal block size"
	}
	let reg = make([]u8, bs)
	copy(reg, iv)
	mut ksn = bs
	mut ctrs = []u8{}
	if kind == streamCTR {
		ksn = bs * modeChunk
		ctrs = make([]u8, bs*modeChunk)
	}
	return BlockStream{b: b, bs: bs, kind: kind, reg: reg, ks: make([]u8, ksn), ctrs: ctrs, used: 0, avail: 0}
}

// NewCTR is counter mode with b and a one-block initial counter, as Go's cipher.NewCTR: the
// counter is the whole block, big-endian, wrapping to zero. An IV of another length is a fault.
fn NewCTR(b dyn Block, iv []u8) !BlockStream {
	return try stream_new(b, iv, streamCTR, "NewCTR")
}

// NewCFBEncrypter is full-block cipher feedback encryption with b and a one-block IV, as Go's
// cipher.NewCFBEncrypter (deprecated there: use CTR or an AEAD). An IV of another length is a fault.
fn NewCFBEncrypter(b dyn Block, iv []u8) !BlockStream {
	return try stream_new(b, iv, streamCFBEncrypt, "NewCFBEncrypter")
}

// NewCFBDecrypter is full-block cipher feedback decryption with b and a one-block IV, as Go's
// cipher.NewCFBDecrypter (deprecated there: use CTR or an AEAD). An IV of another length is a fault.
fn NewCFBDecrypter(b dyn Block, iv []u8) !BlockStream {
	return try stream_new(b, iv, streamCFBDecrypt, "NewCFBDecrypter")
}

// NewOFB is output feedback mode with b and a one-block IV, as Go's cipher.NewOFB (deprecated
// there: use CTR or an AEAD). An IV of another length is a fault.
fn NewOFB(b dyn Block, iv []u8) !BlockStream {
	return try stream_new(b, iv, streamOFB, "NewOFB")
}

// XORKeyStream XORs src with the keystream into dst (dst may be src), going on from where the
// last call stopped. It fails, writing nothing, when dst is shorter than src or overlaps it shifted.
fn (x mut BlockStream) XORKeyStream(dst mut []u8, src []u8) ! {
	let n = len(src)
	if len(dst) < n {
		fail "seal: output smaller than input"
	}
	let dp = cast(i64, dst)[2]
	let sp = cast(i64, src)[2]
	if inexact_overlap(dp, n, sp, n) {
		fail "seal: invalid buffer overlap"
	}
	let kp = cast(i64, x.ks)[2]
	let rp = cast(i64, x.reg)[2]
	mut pos = 0
	for pos < n {
		if x.used == x.avail {
			x.refill(n - pos)
		}
		let k = min(x.avail-x.used, n-pos)
		if x.kind == streamCFBDecrypt {
			// The ciphertext feeds back; copy it before dst (maybe src) is written.
			memcpy(rp+x.used, sp+pos, k)
		}
		xor_bytes(dp+pos, sp+pos, kp+x.used, k)
		if x.kind == streamCFBEncrypt {
			memcpy(rp+x.used, dp+pos, k)
		}
		x.used += k
		pos += k
	}
}

// refill makes keystream: for CTR as many blocks as rem bytes need (up to a chunk), for CFB and
// OFB the next block.
fn (x mut BlockStream) refill(rem i64) {
	let bs = x.bs
	x.used = 0
	if x.kind == streamOFB {
		x.b.Encrypt(mut x.reg, x.reg)
		copy(x.ks, x.reg)
		x.avail = bs
		return
	}
	if x.kind != streamCTR {
		x.b.Encrypt(mut x.ks, x.reg)
		x.avail = bs
		return
	}
	let blocks = min((rem+bs-1)/bs, modeChunk)
	let cp = cast(i64, x.ctrs)[2]
	for i in 0..blocks {
		memcpy(cp+bs*i, cast(i64, x.reg)[2], bs)
		// The counter is the whole block, big-endian; all ones wraps to zero.
		mut j = bs - 1
		for j >= 0 {
			x.reg[j] +%= 1
			if x.reg[j] != 0 {
				break
			}
			j -= 1
		}
	}
	if blocks == modeChunk {
		x.b.EncryptBlocks(mut x.ks, x.ctrs)
	} else if blocks == 1 {
		x.b.Encrypt(mut x.ks, x.ctrs)
	} else {
		x.b.EncryptBlocks(mut x.ks, x.ctrs[0:bs*blocks])
	}
	x.avail = bs * blocks
}

// xor_bytes sets the n bytes at dst to those at a XOR those at b (dst may be a or b).
fn xor_bytes(dst i64, a i64, b i64, n i64) {
	mut i = 0
	for i+8 <= n {
		__st(dst+i, __ld(a+i, 3) ^ __ld(b+i, 3), 3)
		i += 8
	}
	for i < n {
		store8(dst+i, load8(a+i)^load8(b+i))
		i += 1
	}
}
