package seal

// ---- MD5 (RFC 1321), as Go's crypto/md5 ----
// MD5 is broken: collisions are cheap to make. It is here for the protocols that still name
// it (PostgreSQL's md5 login, some checksums); use Sha256 for anything new.

let md5K []u32 = []u32{
	0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
	0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
	0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
	0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
	0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
	0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
	0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
	0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391,
}

// md5_blocks folds nblocks 64-byte blocks at p into h; MD5 computes modulo 2^32 (#362). The words
// are little-endian, as the targets are, so a block is read as sixteen 32-bit loads.
@wrap fn md5_blocks(h mut []u32, p i64, nblocks i64) {
	mut a0 = h[0]
	mut b0 = h[1]
	mut c0 = h[2]
	mut d0 = h[3]
	for blk in 0..nblocks {
		let q = p + 64*blk
		mut a = a0
		mut b = b0
		mut c = c0
		mut d = d0
		for i in 0..16 {
			let f = d ^ (b & (c ^ d))
			let x = a + f + md5K[i] + u32(__ld(q+4*i, 2))
			let r = u32(7 + 5*(i%4))
			a = d
			d = c
			c = b
			b += (x << r) | (x >> (32 - r))
		}
		for i in 16..32 {
			let f = c ^ (d & (b ^ c))
			let x = a + f + md5K[i] + u32(__ld(q+4*((5*i+1)%16), 2))
			let r = u32(md5R2[i%4])
			a = d
			d = c
			c = b
			b += (x << r) | (x >> (32 - r))
		}
		for i in 32..48 {
			let f = b ^ c ^ d
			let x = a + f + md5K[i] + u32(__ld(q+4*((3*i+5)%16), 2))
			let r = u32(md5R3[i%4])
			a = d
			d = c
			c = b
			b += (x << r) | (x >> (32 - r))
		}
		for i in 48..64 {
			let f = c ^ (b | ^d)
			let x = a + f + md5K[i] + u32(__ld(q+4*((7*i)%16), 2))
			let r = u32(md5R4[i%4])
			a = d
			d = c
			c = b
			b += (x << r) | (x >> (32 - r))
		}
		a0 += a
		b0 += b
		c0 += c
		d0 += d
	}
	h[0] = a0
	h[1] = b0
	h[2] = c0
	h[3] = d0
}

let md5R2 []i64 = []i64{5, 9, 14, 20}
let md5R3 []i64 = []i64{4, 11, 16, 23}
let md5R4 []i64 = []i64{6, 10, 15, 21}

// md5_digest is the state as the 16-byte digest (little-endian words).
fn md5_digest(h []u32) []u8 {
	let out = make([]u8, 16)
	for i in 0..4 {
		for j in 0..4 {
			out[4*i+j] = u8(h[i] >> u32(8*j))
		}
	}
	return out
}

// Md5 is the MD5 digest of s (16 bytes), as Go's md5.Sum; s may be secret. MD5 is broken: use it
// only where a protocol names it (PostgreSQL's md5 login), never for new designs.
fn Md5(s secret str) []u8 {
	let n = len(s)
	mut h = []u32{0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476}
	let whole = n / 64
	if whole > 0 {
		md5_blocks(mut h, cast(i64, s)+8, whole)
	}
	// The tail: the last partial block, 0x80, zeros and the bit length, little-endian.
	let rest = n - 64*whole
	mut total = 64
	if rest >= 56 {
		total = 128
	}
	let tail = make([]u8, total)
	let sp = cast(i64, s) + 8 + 64*whole
	for i in 0..rest {
		tail[i] = load8(sp + i)
	}
	tail[rest] = 0x80
	let bitlen = u64(n) *% 8
	for i in 0..8 {
		tail[total-8+i] = u8(bitlen >> u64(8*i))
	}
	md5_blocks(mut h, cast(i64, tail)[2], total/64)
	return md5_digest(h)
}

// Md5Hex is the MD5 digest of s in lower-case hex; s may be secret.
fn Md5Hex(s secret str) str {
	return Hex(Md5(s))
}
