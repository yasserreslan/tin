// Package cryptotest makes the buffers that constant-time comparison tests need: filled and seeded byte
// slices, copies that differ in one byte, and Equal, which is seal.Equal over byte slices. Go's
// testing/cryptotest seeds crypto/rand for a test; Tin has no process-wide random source to seed, so
// each buffer carries its own seed and the same seed gives the same bytes on every run.
//
//	import "crucible/cryptotest"
//	import "crucible"
//
//	let a = cryptotest.Seeded(7, 32)
//	let b = cryptotest.Flip(a, 31, 0x80)        // the last byte differs in its top bit
//	crucible.False("tag", cryptotest.Equal(a, b))
package cryptotest

import "dice"
import "seal"

// Filled returns n bytes, all of value b.
fn Filled(n i64, b u8) []u8 {
	mut out = make([]u8, 0, n)
	for i in 0..n {
		out = append(out, b)
	}
	return out
}

// Seeded returns n pseudo-random bytes from seed: the same bytes for the same seed.
fn Seeded(seed u64, n i64) []u8 {
	mut r = dice.New(seed)
	return r.Bytes(n)
}

// Flip returns a copy of b with the byte at index i xor-ed with mask, so the copy differs from b in
// the bits of mask (and is equal to it when mask is 0).
fn Flip(b []u8, i i64, mask u8) []u8 {
	mut out = make([]u8, len(b))
	for k in 0..len(b) {
		out[k] = b[k]
	}
	out[i] = out[i] ^ mask
	return out
}

// Equal reports whether a and b hold the same bytes, by seal.Equal: it takes time that depends only on
// their lengths, so it is what a secret comparison should use.
fn Equal(a []u8, b []u8) bool {
	return seal.Equal(str(a), str(b))
}
