// Package crucible is for tests and micro-benchmarks: labeled checks that collect failures,
// Done to report them (exit status 1 on failure), and Bench to time a function.
//
//	crucible.EqI("sum", 2 + 3, 5)
//	crucible.Done()
package crucible

import "constraints"
import "glyph"
import "lasso"
import "say"

mut checks i64
mut failures []str

fn fail_check(label str, detail str) {
	failures = append(failures, keep(say.Fmt("FAIL %s: %s", label, detail)))
}

// EqI checks two integers.
fn EqI(label str, got i64, want i64) {
	checks += 1
	if got != want {
		fail_check(label, say.Fmt("got %d, want %d", got, want))
	}
}

// EqU checks two unsigned integers.
fn EqU(label str, got u64, want u64) {
	checks += 1
	if got != want {
		fail_check(label, say.Fmt("got %d, want %d", got, want))
	}
}

// EqS checks two strings.
fn EqS(label str, got str, want str) {
	checks += 1
	if got != want {
		fail_check(label, say.Fmt("got %q, want %q", got, want))
	}
}

// EqB checks two bools.
fn EqB(label str, got bool, want bool) {
	checks += 1
	if got != want {
		fail_check(label, say.Fmt("got %v, want %v", got, want))
	}
}

// EqF checks two floats within eps.
fn EqF(label str, got f64, want f64, eps f64) {
	checks += 1
	mut d = got - want
	if d < 0 {
		d = -d
	}
	if !(d <= eps) {
		fail_check(label, say.Fmt("got %v, want %v (eps %v)", got, want, eps))
	}
}

// True checks that cond holds.
fn True(label str, cond bool) {
	checks += 1
	if !cond {
		fail_check(label, "expected true")
	}
}

// False checks that cond does not hold.
fn False(label str, cond bool) {
	checks += 1
	if cond {
		fail_check(label, "expected false")
	}
}

// NoFault checks that err is nil.
fn NoFault(label str, err fault) {
	checks += 1
	if err != nil {
		fail_check(label, say.Fmt("unexpected fault: %v", err))
	}
}

// HasFault checks that err is not nil.
fn HasFault(label str, err fault) {
	checks += 1
	if err == nil {
		fail_check(label, "expected a fault")
	}
}

// Failed reports whether any check failed so far.
fn Failed() bool {
	return len(failures) > 0
}

// Checks is the number of checks run so far.
fn Checks() i64 {
	return checks
}

// Done prints "ok N checks" or every failure, and exits with status 1 if any failed.
fn Done() {
	if len(failures) == 0 {
		say.Line("ok", checks, "checks")
		return
	}
	for _, f in failures {
		say.Line(f)
	}
	say.Line("FAILED", len(failures), "of", checks, "checks")
	rt_flush()
	rt_sys_exit(1)
}

// Bench runs f(i) for i in [0, n) and prints the time per call.
fn Bench(label str, n i64, f fn(i64)) {
	let t0 = rt_mono_ns()
	for i in 0..n {
		f(i)
	}
	let dt = rt_mono_ns() - t0
	say.Out("%s: %d ops, %.2f ns/op\n", label, n, f64(dt)/f64(n))
}

// ---- Go-style tests: tin test runs every TestXxx(t mut crucible.T) in *_test.tin files ----

// T is one running test: checks record failures in it, and the test continues.
type T struct {
	Name   str
	failed bool
	logs   []str
}

// B is one running benchmark: run the measured code b.N times.
type B struct {
	Name str
	N    i64
}

mut testsRun i64
mut testsFailed i64
mut jsonEvents bool
mut runFilter []lasso.Regexp

// Configure sets how tin test runs the tests: pattern (a lasso regular expression, "" for every test) picks
// the tests and benchmarks whose names match, and json prints one JSON event per line instead of text
// (toolchain/docs/TOOLING.md section 5.2). A pattern that is not a regular expression ends the run with status 2.
fn Configure(pattern str, json bool) {
	jsonEvents = json
	runFilter = []lasso.Regexp{}
	if len(pattern) > 0 {
		let re = lasso.Compile(pattern) catch _ {
			say.Line("tin: test: -run: bad pattern:", pattern)
			rt_flush()
			rt_sys_exit(2)
			return
		}
		runFilter = append(runFilter, re)
	}
}

// selected reports whether the test or benchmark called name is to run.
fn selected(name str) bool {
	return len(runFilter) == 0 || runFilter[0].Match(name)
}

// jsonText is s as a JSON string, escaped as Go's test2json does: control characters as \u00XX and a byte that is
// not UTF-8 as \ufffd, so the line is valid JSON whatever the test printed.
fn jsonText(s str) str {
	let hex = "0123456789abcdef"
	mut out = []u8{}
	out = append(out, '"')
	mut i = 0
	for i < len(s) {
		let c = s[i]
		if c >= 0x80 {
			let (r, size) = glyph.DecodeRune(s, i)
			if r == glyph.RuneError && size == 1 {
				let esc = "\\ufffd"
				for k in 0..len(esc) {
					out = append(out, esc[k])
				}
			} else {
				for k in 0..size {
					out = append(out, s[i+k])
				}
			}
			i += size
			continue
		}
		if c == '"' || c == '\\' {
			out = append(out, '\\')
			out = append(out, c)
		} else if c == '\n' {
			out = append(out, '\\')
			out = append(out, 'n')
		} else if c == '\t' {
			out = append(out, '\\')
			out = append(out, 't')
		} else if c < 32 {
			let esc = "\\u00"
			for k in 0..len(esc) {
				out = append(out, esc[k])
			}
			out = append(out, hex[c >> 4])
			out = append(out, hex[c & 15])
		} else {
			out = append(out, c)
		}
		i += 1
	}
	out = append(out, '"')
	return str(out)
}

// event prints one JSON event: {"event":kind,"test":name,...rest} (rest starts with a comma or is empty).
fn event(kind str, name str, rest str) {
	say.Line("{{\"event\":" + jsonText(kind) + ",\"test\":" + jsonText(name) + rest + "}}")
}

// takeOutput returns what the code run since the last call printed to standard output (the runtime's output
// buffer, 64 KiB at most; more is already on its way to the terminal as plain lines).
fn takeOutput() str {
	let n = rtOut[0]
	let text = rt_str_from_raw(rtOut[2], n)
	rtOut[0] = 0
	return text
}

// outputEvents reports each line of text as an output event of test name.
fn outputEvents(name str, text str) {
	mut start = 0
	for i in 0..len(text) {
		if text[i] == '\n' {
			event("output", name, ",\"message\":" + jsonText(text[start:i]))
			start = i + 1
		}
	}
	if start < len(text) {
		event("output", name, ",\"message\":" + jsonText(text[start:]))
	}
}

// Error marks the test failed with msg (it keeps running).
fn (t mut T) Error(msg str) {
	t.failed = true
	t.logs = append(t.logs, msg)
}

// Log records msg; it is printed only if the test fails.
fn (t mut T) Log(msg str) {
	t.logs = append(t.logs, msg)
}

// Failed reports whether the test has failed so far.
fn (t T) Failed() bool {
	return t.failed
}

// True fails the test with label unless cond holds.
fn (t mut T) True(label str, cond bool) {
	if !cond {
		t.Error("{label}: expected true")
	}
}

// False fails the test with label if cond holds.
fn (t mut T) False(label str, cond bool) {
	if cond {
		t.Error("{label}: expected false")
	}
}

// NoFault fails the test if err is not nil.
fn (t mut T) NoFault(label str, err fault) {
	if err != nil {
		t.Error("{label}: unexpected fault: {err}")
	}
}

// HasFault fails the test if err is nil.
fn (t mut T) HasFault(label str, err fault) {
	if err == nil {
		t.Error("{label}: expected a fault")
	}
}

// Equal fails the test unless got == want; both are printed on failure.
fn Equal[V constraints.Comparable](t mut T, label str, got V, want V) {
	if got != want {
		t.Error("{label}: got {got}, want {want}")
	}
}

// Run runs one test and prints its result like go test -v (or as JSON events, see Configure); a test that does
// not match the -run pattern is not run.
fn Run(name str, f fn(mut T)) {
	if !selected(name) {
		return
	}
	let t = T{Name: name, failed: false, logs: []str{}}
	if jsonEvents {
		event("run", name, "")
		rt_flush()
		takeOutput()
		let t0 = rt_mono_ns()
		rtOutHold = true // the test's lines stay in the buffer until they are taken (#747)
		f(mut t)
		let ms = (rt_mono_ns() - t0) / 1000000
		let printed = takeOutput()
		rtOutHold = false
		outputEvents(name, printed)
		for _, l in t.logs {
			event("output", name, ",\"message\":" + jsonText(l))
		}
		testsRun += 1
		if t.failed {
			testsFailed += 1
			event("fail", name, ",\"elapsed_ms\":" + say.Str(ms))
		} else {
			event("pass", name, ",\"elapsed_ms\":" + say.Str(ms))
		}
		return
	}
	f(mut t)
	testsRun += 1
	if t.failed {
		testsFailed += 1
		say.Line("--- FAIL:", name)
		for _, l in t.logs {
			say.Line("    " + l)
		}
	} else {
		say.Line("--- PASS:", name)
	}
}

// RunBench runs one benchmark with b.N doubling until it takes at least 1 s, then prints
// the time per operation.
fn RunBench(name str, f fn(mut B)) {
	if !selected(name) {
		return
	}
	mut n = 1
	for {
		let b = B{Name: name, N: n}
		let t0 = rt_mono_ns()
		f(mut b)
		let dt = rt_mono_ns() - t0
		if dt >= 1000000000 || n >= 1 << 40 {
			if jsonEvents {
				event("bench", name, ",\"n\":" + say.Str(n) + ",\"ns_per_op\":" + say.Str(dt / n))
				return
			}
			say.Out("%-30s %12d %12.1f ns/op\n", name, n, f64(dt)/f64(n))
			return
		}
		if dt < 1000000 {
			n *= 100
		} else {
			n *= 2
		}
	}
}

// Finish prints PASS or FAIL and exits with status 1 when a test failed.
fn Finish() {
	if jsonEvents {
		event("summary", "", ",\"pass\":" + say.Str(testsRun - testsFailed) + ",\"fail\":" + say.Str(testsFailed))
		if testsFailed > 0 {
			rt_flush()
			rt_sys_exit(1)
		}
		return
	}
	if testsFailed > 0 {
		say.Line("FAIL:", testsFailed, "of", testsRun, "tests failed")
		rt_flush()
		rt_sys_exit(1)
	}
	say.Line("PASS:", testsRun, "tests")
}
