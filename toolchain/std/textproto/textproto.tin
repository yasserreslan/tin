// Package textproto reads and writes the line-oriented framing used by Internet protocols.
package textproto

import "say"
import "twine"

// Reader reads CRLF-terminated lines and dot-framed bodies from a bounded string.
type Reader struct {
	data str
	pos  i64
}

// Writer builds line-oriented and dot-framed protocol data.
type Writer struct {
	data []u8
}

// DotReader reads a dot-decoded body from memory.
type DotReader struct {
	data str
	pos  i64
}

// DotWriter writes dot-stuffed bytes into a Writer.
type DotWriter struct {
	writer Writer
	state  i64 // dwBegin, dwBeginLine, dwCR or dwData, as Go's dotWriter
	closed bool
}

const dwBegin = 0
const dwBeginLine = 1
const dwCR = 2
const dwData = 3

// NewReader creates a reader over data.
fn NewReader(data str) Reader {
	return Reader{data: data}
}

// NewWriter creates an empty protocol writer.
fn NewWriter() Writer {
	return Writer{}
}

// ReadLine reads one CRLF or LF terminated line; the terminator is not returned.
fn (r mut Reader) ReadLine() !str {
	if r.pos >= len(r.data) {
		fail say.Fault("textproto: unexpected EOF")
	}
	let start = r.pos
	for r.pos < len(r.data) && r.data[r.pos] != '\n' {
		r.pos += 1
	}
	mut end = r.pos
	if r.pos < len(r.data) {
		r.pos += 1
		// Only a line ended by "\n" drops its "\r": a last line without one keeps it, as Go's
		// bufio.Reader.ReadLine does.
		if end > start && r.data[end-1] == '\r' {
			end -= 1
		}
	}
	return r.data[start:end]
}

// ReadContinuedLine joins a line and following whitespace-prefixed lines with single spaces,
// as Go's ReadContinuedLine: each part loses the spaces and tabs around it, and an empty first
// line has no continuation.
fn (r mut Reader) ReadContinuedLine() !str {
	let first = try r.ReadLine()
	if len(first) == 0 {
		return first
	}
	mut line = trimSpTab(first)
	for r.skipSpace() > 0 {
		line += " "
		let next = r.ReadLine() catch _ {
			break
		}
		line += trimSpTab(next)
	}
	return line
}

// skipSpace skips the spaces and tabs at the reader's position and returns how many.
fn (r mut Reader) skipSpace() i64 {
	mut n = 0
	for r.pos < len(r.data) && (r.data[r.pos] == ' ' || r.data[r.pos] == '\t') {
		r.pos += 1
		n += 1
	}
	return n
}

// trimSpTab is s without the spaces and tabs at either end (Go's textproto trim).
fn trimSpTab(s str) str {
	mut i = 0
	mut n = len(s)
	for i < n && (s[i] == ' ' || s[i] == '\t') {
		i += 1
	}
	for n > i && (s[n-1] == ' ' || s[n-1] == '\t') {
		n -= 1
	}
	return s[i:n]
}

// ReadDotBytes reads through the terminating dot line and decodes the body as Go's DotReader
// does: a leading dot is removed from every line, "\r\n" becomes "\n", and the body ends at a
// line that is only a dot. Input that ends before that line fails.
fn (r mut Reader) ReadDotBytes() !str {
	mut out = []u8{}
	// Go's states: 0 the start of a line, 1 a dot read there, 2 a dot and "\r", 3 a "\r" read,
	// 4 in a line.
	mut state = 0
	for r.pos < len(r.data) {
		let c = r.data[r.pos]
		r.pos += 1
		if state == 0 {
			if c == '.' {
				state = 1
				continue
			}
			if c == '\r' {
				state = 3
				continue
			}
			state = 4
		} else if state == 1 {
			if c == '\r' {
				state = 2
				continue
			}
			if c == '\n' {
				return str(out)
			}
			state = 4
		} else if state == 2 {
			if c == '\n' {
				return str(out)
			}
			// Not ".\r\n": the dot is dropped and the "\r" kept; c is read again.
			r.pos -= 1
			out = append(out, u8('\r'))
			state = 4
			continue
		} else if state == 3 {
			if c == '\n' {
				out = append(out, c)
				state = 0
				continue
			}
			r.pos -= 1
			out = append(out, u8('\r'))
			state = 4
			continue
		} else {
			if c == '\r' {
				state = 3
				continue
			}
			if c == '\n' {
				state = 0
			}
		}
		out = append(out, c)
	}
	fail say.Fault("textproto: unexpected EOF")
}

// ReadDotReader consumes a dot-framed body and returns a reader over its decoded bytes.
fn (r mut Reader) ReadDotReader() !DotReader {
	let body = try r.ReadDotBytes()
	return DotReader{data: body}
}

// Read returns the next decoded bytes, or 0 at the end of the dot body.
fn (r mut DotReader) Read(buf mut []u8) !i64 {
	if r.pos >= len(r.data) { return 0 }
	let n = min(len(buf), len(r.data)-r.pos)
	for i in 0..n { buf[i] = r.data[r.pos+i] }
	r.pos += n
	return n
}

// WriteLine appends one line and its CRLF terminator.
fn (w mut Writer) WriteLine(line str) {
	w.data = append(w.data, line...)
	w.data = append(w.data, u8('\r'), u8('\n'))
}

// DotWriter starts a dot-stuffed body writer.
fn (w Writer) DotWriter() DotWriter {
	return DotWriter{writer: w, state: dwBegin}
}

// Write dot-stuffs a chunk and appends it to the associated Writer, as Go's DotWriter: a
// leading dot is doubled and a bare "\n" becomes "\r\n".
fn (d mut DotWriter) Write(data []u8) !i64 {
	if d.closed {
		fail say.Fault("textproto: write to closed dot writer")
	}
	for c in data {
		if d.state == dwBegin || d.state == dwBeginLine {
			d.state = dwData
			if c == '.' {
				d.writer.data = append(d.writer.data, u8('.'))
			}
		}
		if d.state == dwData {
			if c == '\r' {
				d.state = dwCR
			}
			if c == '\n' {
				d.writer.data = append(d.writer.data, u8('\r'))
				d.state = dwBeginLine
			}
		} else if d.state == dwCR {
			d.state = dwData
			if c == '\n' {
				d.state = dwBeginLine
			}
		}
		d.writer.data = append(d.writer.data, c)
	}
	return len(data)
}

// Close ends the last line if it is open and writes the terminating dot line. With nothing
// written the body is one empty line, as Go's DotWriter writes it.
fn (d mut DotWriter) Close() ! {
	if d.closed {
		return
	}
	if d.state != dwCR && d.state != dwBeginLine {
		d.writer.data = append(d.writer.data, u8('\r'))
	}
	if d.state != dwBeginLine {
		d.writer.data = append(d.writer.data, u8('\n'))
	}
	d.writer.data = append(d.writer.data, u8('.'), u8('\r'), u8('\n'))
	d.closed = true
}

// WriteDotBytes writes a body with dot-stuffing and the terminating dot line.
fn (w mut Writer) WriteDotBytes(body str) {
	mut start = i64(0)
	for i in 0..len(body) {
		if body[i] == '\n' {
			mut end = i
			if i > start && body[i-1] == '\r' {
				end = i-1
			}
			w.writeDotLine(body[start:end])
			start = i + 1
		}
	}
	if start < len(body) {
		w.writeDotLine(body[start:len(body)])
	}
	w.data = append(w.data, u8('.'), u8('\r'), u8('\n'))
}

// writeDotLine emits one body line, doubling a leading dot.
fn (w mut Writer) writeDotLine(line str) {
	if twine.HasPrefix(line, ".") {
		w.data = append(w.data, u8('.'))
	}
	w.data = append(w.data, line...)
	w.data = append(w.data, u8('\r'), u8('\n'))
}

// String returns the bytes written so far.
fn (w Writer) String() str {
	return str(w.data)
}

// CanonicalMIMEHeaderKey returns the canonical capitalization of a header key.
fn CanonicalMIMEHeaderKey(key str) str {
	if len(key) == 0 {
		return ""
	}
	mut out = []u8{}
	mut upper = true
	for _, rune in key {
		let c = u8(rune)
		if !isTokenByte(c) {
			return key
		}
		if upper && c >= 'a' && c <= 'z' {
			out = append(out, u8(c-32))
		} else if !upper && c >= 'A' && c <= 'Z' {
			out = append(out, u8(c+32))
		} else {
			out = append(out, c)
		}
		upper = c == '-'
	}
	return str(out)
}

// isTokenByte reports whether a header key byte is an RFC token byte.
fn isTokenByte(c u8) bool {
	return c > ' ' && c < 0x7f && c != '(' && c != ')' && c != '<' && c != '>' && c != '@' && c != ',' && c != ';' && c != ':' && c != '\\' && c != '"' && c != '/' && c != '[' && c != ']' && c != '?' && c != '=' && c != '{' && c != '}'
}
