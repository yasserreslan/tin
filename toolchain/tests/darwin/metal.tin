package main

import "metal"
import "say"

// The GPU without a window: draw two rectangles into an offscreen texture and read pixels back (blue, green, red, alpha).
fn main() {
	let g = metal.Open()
	if g.Device == 0 {
		say.Line("no gpu:", g.Error)
		return
	}
	let t = metal.NewTarget(g, 8, 8)
	mut q = metal.Quads{}
	q.Add(0.0, 0.0, 4.0, 4.0, 1.0, 0.0, 0.0, 1.0)
	q.Add(4.0, 4.0, 4.0, 4.0, 0.0, 1.0, 0.0, 0.5)
	metal.Draw(g, t.Texture, 8, 8, q, 0.0, 0.0, 1.0, 1.0)
	let p = metal.Pixels(t)
	say.Line("red:", metal.Pixel(p, 0), metal.Pixel(p, 1), metal.Pixel(p, 2), metal.Pixel(p, 3))
	say.Line("blue:", metal.Pixel(p, 4 * 4), metal.Pixel(p, 4 * 4 + 1), metal.Pixel(p, 4 * 4 + 2), metal.Pixel(p, 4 * 4 + 3))
	let k = (5 * 8 + 5) * 4
	say.Line("green over blue:", metal.Pixel(p, k), metal.Pixel(p, k + 1), metal.Pixel(p, k + 2), metal.Pixel(p, k + 3))
}
