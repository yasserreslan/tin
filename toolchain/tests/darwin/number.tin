package main

import "appkit"
import "say"

// A double crosses into Objective-C as an argument (d0) and comes back as a result (objc_msgSend).
fn main() {
	say.Line("Foundation loaded:", appkit.LoadFoundation())
	let n = appkit.NumberWith(3.5)
	say.Line("round trip:", appkit.DoubleValue(n) == 3.5)
}
