package main

import "constraints"
import "say"
import "seal"

// secret T (#239): the checker tracks it and the runtime never sees it, so a secret
// computes exactly like its plain type; only reveal(x) gives the plain value back.

type Account struct {
	name  str
	token secret str
	pin   secret i64
	key   secret []u8
	notes map[str]secret str
}

fn (a Account) Label() str {
	return "account {a.name}"
}

// A parameter declared secret takes secrets and plain values alike.
fn bearer(tok secret str) secret str {
	return "Bearer {tok}"
}

fn checkToken(a Account, given secret str) bool {
	return seal.Equal(a.token, given)
}

fn lookup(k str) !secret str {
	if k == "" {
		fail "no key"
	}
	return "s3cr3t-{k}"
}

fn tokenLen(k str) !i64 {
	let v = try lookup(k)
	return len(v)
}

fn present(p ?secret str) i64 {
	if p != nil {
		return len(p)
	}
	return -1
}

fn pass[T constraints.Any](x T) T {
	return x
}

let fallback secret str = "per-core"

fn main() {
	mut a = Account{name: "ann", token: "t0k3n", pin: 1234, key: []u8{1, 2}, notes: map[str]secret str{}}
	say.Line(a.Label(), len(a.token))

	// Propagation: operators, concatenation, interpolation, conversions, indexing, slicing.
	let h = bearer(a.token)
	let joined = a.token + "-x"
	let pin2 = a.pin * 2 + 1
	let bytes = []u8(a.token)
	let first = a.token[0]
	let tail = a.token[1:]
	say.Line(reveal(h), reveal(joined), reveal(pin2))
	say.Line(len(bytes), reveal(first), reveal(tail), reveal(str(bytes)))
	let ratio secret f64 = 1.5
	let flag secret bool = true
	say.Line(reveal(ratio * 2.0), reveal(!flag), reveal(i64(ratio)))

	// Containers: append to a secret slice, secret map values, ranging over secrets.
	a.key = append(a.key, 3)
	a.notes["door"] = "4711"
	mut sum secret i64 = 0
	for b in a.key {
		sum += i64(b)
	}
	for k, v in a.notes {
		say.Line(k, reveal(v), len(v))
	}
	say.Line(len(a.key), reveal(sum), reveal(pass(a.pin)))

	// Comparison in constant time; library parameters declared secret.
	say.Line(checkToken(a, "t0k3n"), checkToken(a, "t0k3m"), seal.ConstantTimeEq(bytes, []u8("t0k3n")))
	say.Line(seal.Sha256Hex(a.token)[0:16], seal.Hex(seal.HmacSha256(a.token, "msg"))[0:16])

	// Optionals, fallible results and per-core globals.
	say.Line(present("abc"), present(nil), reveal(fallback))
	let n = tokenLen("u") catch err {
		say.Line("fault", err)
		0
	}
	let m = tokenLen("") catch err {
		say.Line("fault", err)
		0
	}
	say.Line(n, m)
}
