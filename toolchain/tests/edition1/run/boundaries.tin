package main

import "say"
import "tide"

mut log str = ""

fn note(s str) {
	log = keep(log + s)
}

fn pick(xs []i64, k i64) i64 {
	defer note("pick;")
	return xs[k]
}

fn load(n i64) !i64 {
	if n < 0 {
		fail "negative"
	}
	return n * 2
}

// hog holds k blocks of 8 MB at once: a loop's dropped blocks would go back each iteration (#633).
fn hog(k i64) i64 {
	defer note("hog;")
	mut held = [][]i64{}
	for i in 0..k {
		held = append(held, make([]i64, 1000000))
	}
	mut total i64 = 0
	for xs in held {
		total += len(xs)
	}
	return total
}

fn guarded(k i64) !i64 {
	let v = try guard {
		defer note("block;")
		let xs = []i64{1, 2, 3}
		pick(xs, k)
	}
	return v
}

fn main() {
	let a = guarded(1) catch err {
		say.Line("unexpected", err)
		0
	}
	say.Line("guard ok:", a)
	let b = guarded(7) catch err {
		say.Line("guard fault:", err)
		-1
	}
	say.Line("guard value:", b, "log:", log)
	guard {
		say.Line("no value")
	} catch err {
		say.Line("never", err)
	}
	let d = within 50ms {
		let x = try load(4)
		x + 1
	} catch err {
		say.Line("never", err)
		0
	}
	say.Line("within value:", d)
	let e = within 1h {
		try load(-1)
	} catch err {
		say.Line("within fault:", err)
		0
	}
	say.Line("within e:", e)
	let start = tide.Now()
	within 30ms {
		try tide.Wait(5s)
	} catch err {
		say.Line("within deadline:", err)
	}
	let ms = (tide.Now() - start) / tide.Millisecond
	say.Line("stopped early:", ms < 1000)
	let nested = within 1h {
		within 20ms {
			try tide.Wait(5s)
		} catch err {
			say.Line("inner:", err)
		}
		"outer ok"
	} catch _ {
		"outer fault"
	}
	say.Line("nested:", nested)
	let fits = limit memory 64mb {
		hog(2)
	} catch err {
		say.Line("never", err)
		0
	}
	say.Line("limit fits:", fits)
	log = ""
	let over = limit memory 16mb {
		hog(10)
	} catch err {
		say.Line("limit fault:", err)
		-1
	}
	say.Line("limit over:", over, "log:", log)
	let both = limit memory 16mb, tasks 4 {
		"ok"
	} catch _ {
		"never"
	}
	say.Line("limit both:", both)
}
