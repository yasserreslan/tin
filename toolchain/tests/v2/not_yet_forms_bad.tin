package main

import "say"

// Forms the parser reads and the checker does not build yet are E295, once each, instead of
// E990 INTERNAL or an error about something else (#558).

fn sum(xs ...i64) i64 {
	mut t = 0
	for x in xs {
		t += x
	}
	return t
}

fn main() {
	let s = []i64{1, 2}
	say.Line(sum(1, 2, 3), sum(s...))
}
