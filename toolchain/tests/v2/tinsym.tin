package main

import "say"
import "tinjson"
import "tinsym"
import "twine"

// The compiler's declarations and errors as JSON lines, and what an editor asks of them: which declaration a name is,
// and what can be written at a place.
fn sym(kind str, name str, pkg str, file str, line i64, recv str, sig str, members str) str {
	return "{{\"kind\":\"" + kind + "\",\"name\":\"" + name + "\",\"pkg\":\"" + pkg + "\",\"file\":\"" + file + "\",\"line\":" + say.Str(line) + ",\"col\":4,\"endCol\":9,\"recv\":\"" + recv + "\",\"exported\":" + exported(name) + ",\"sig\":\"" + sig + "\",\"doc\":\"\",\"members\":" + members + "}}\n"
}

fn exported(name str) str {
	if name[0] >= 'A' && name[0] <= 'Z' {
		return "true"
	}
	return "false"
}

fn names(items []tinsym.Item) str {
	mut out = ""
	for it in items {
		out = out + it.Kind + ":" + it.Label + " "
	}
	return out
}

fn found(syms []tinsym.Sym) str {
	mut out = ""
	for s in syms {
		out = out + s.File + ":" + say.Str(s.Line) + " "
	}
	return out
}

fn main() {
	// JSON values
	let (j, ok) = tinjson.Parse("{{\"a\":[1,2.5,\"x\\n\\u00e9\\ud83d\\ude42\"],\"b\":{{\"c\":true,\"d\":null}}}}")
	say.Line(ok, j.Get("a").Len(), j.Get("a").At(0).Int(), j.Get("a").At(2).Text(), j.Get("b").Get("c").Bool(), j.Get("b").Get("d").IsNull(), j.Get("zz").IsNull())
	let (_, bad) = tinjson.Parse("{{\"a\":")
	say.Line("bad json:", bad)
	say.Line(tinjson.Quote("a\"b\\c\nd\te"))

	// the lines of tinc -symbols -json
	let out = sym("fn", "main", "", "/p/main.tin", 5, "", "fn main()", "[]") +
		sym("fn", "helper", "", "/p/main.tin", 10, "", "fn helper(a i64) i64", "[]") +
		sym("method", "Dist", "", "/p/main.tin", 20, "Point", "fn (p Point) Dist() i64", "[]") +
		sym("type", "Point", "", "/p/main.tin", 5, "", "type Point struct", "[{{\"name\":\"X\",\"detail\":\"i64\"}},{{\"name\":\"Y\",\"detail\":\"i64\"}}]") +
		sym("fn", "Split", "twine", "/lib/twine/twine.tin", 7, "", "fn Split(s str, sep str) []str", "[]") +
		sym("fn", "hidden", "twine", "/lib/twine/twine.tin", 9, "", "fn hidden()", "[]") +
		sym("fn", "helper", "", "/lib/rt/runtime.tin", 3, "", "fn helper()", "[]") +
		"{{\"kind\":\"local\",\"name\":\"p\",\"pkg\":\"\",\"file\":\"/p/main.tin\",\"line\":6,\"col\":6,\"endCol\":7,\"fn\":\"main\",\"fnLine\":5,\"type\":\"mut Point\"}}\n" +
		"{{\"kind\":\"local\",\"name\":\"parts\",\"pkg\":\"\",\"file\":\"/p/main.tin\",\"line\":7,\"col\":6,\"endCol\":11,\"fn\":\"main\",\"fnLine\":5,\"type\":\"[]str\"}}\n" +
		"{{\"file\":\"/p/main.tin\",\"line\":12,\"col\":5,\"endLine\":12,\"endCol\":9,\"code\":\"E103\",\"name\":\"UNDEFINED\",\"severity\":\"error\",\"message\":\"undefined: x\",\"fix\":\"\"}}\n"
	let (syms, diags) = tinsym.Parse(out)
	say.Line(len(syms), len(diags), diags[0].Code, diags[0].Line, diags[0].EndCol, diags[0].Message)
	say.Line(syms[3].Members[1].Name, syms[3].Members[1].Detail, syms[2].Recv, syms[4].Exported)

	let text = "package main\n\nimport \"twine\"\n\nfn main() {{\n\tlet p = Point{{X: 1}}\n\tlet parts = twine.Split(\"a\", \",\")\n\thelper(p.Dist())\n}}\n"
	let path = "/p/main.tin"
	// Resolve: a name of the package (not the runtime's of the same name), a package's exported name, a method
	say.Line("plain:", found(tinsym.Resolve(syms, path, text, 7, 3)))
	say.Line("qualified:", found(tinsym.Resolve(syms, path, text, 6, 24)))
	say.Line("method:", found(tinsym.Resolve(syms, path, text, 7, 14)))
	say.Line("inside the name:", found(tinsym.Resolve(syms, path, text, 6, 21)))
	say.Line("nothing:", found(tinsym.Resolve(syms, path, text, 0, 1)))
	let (word, from, to) = tinsym.WordAt(text, 7, 3)
	say.Line(word, from, to)
	say.Line(tinsym.ImportsOf(text), tinsym.CurrentPkg(text) == "", tinsym.CurrentPkg("package geo\n"))

	// Complete: after a package, after a value's dot, and plain
	say.Line("after pkg:", names(tinsym.Complete(syms, path, text, 6, 23)))
	say.Line("after a local's dot:", names(tinsym.Complete(syms, path, text, 7, 12)))
	say.Line("a local:", found(tinsym.Resolve(syms, path, text, 7, 9)))
	say.Line("locals plain:", names(tinsym.Complete(syms, path, text, 7, 1))[:40])
	let (ty, nm) = tinsym.TypeParts("mut geo.Point")
	let (ty2, nm2) = tinsym.TypeParts("[]str")
	say.Line(ty, nm, "|", ty2, nm2, "|")
	let plain = names(tinsym.Complete(syms, path, text, 7, 1))
	say.Line("plain:", plain[:48])

	// a chain of fields: ln.From. is the members of Point, ln.name. and n. have none, ln. is the members of Line
	let local = "{{\"kind\":\"local\",\"name\":\"%s\",\"pkg\":\"\",\"file\":\"/p/c.tin\",\"line\":4,\"col\":6,\"endCol\":8,\"fn\":\"main\",\"fnLine\":3,\"type\":\"%s\"}}\n"
	let (cs, _) = tinsym.Parse(sym("fn", "main", "", "/p/c.tin", 3, "", "fn main()", "[]") +
			sym("type", "Point", "", "/p/c.tin", 20, "", "type Point struct", "[{{\"name\":\"X\",\"detail\":\"i64\"}},{{\"name\":\"Y\",\"detail\":\"i64\"}}]") +
			sym("method", "Dist", "", "/p/c.tin", 25, "Point", "fn (p Point) Dist() i64", "[]") +
			sym("type", "Line", "", "/p/c.tin", 30, "", "type Line struct", "[{{\"name\":\"From\",\"detail\":\"Point\"}},{{\"name\":\"name\",\"detail\":\"str\"}},{{\"name\":\"n\",\"detail\":\"i64  // count\"}}]") +
			fmtLocal(local, "ln", "mut Line") + fmtLocal(local, "n", "i64"))
	let src = "package main\n\nfn main() {{\n\tln.From.\n\tln.name.\n\tln.n.\n\tln.\n\tn.\n\tln.Bogus.\n}}\n"
	say.Line("chain From:", names(tinsym.Complete(cs, "/p/c.tin", src, 3, 9)))
	say.Line("chain name:", names(tinsym.Complete(cs, "/p/c.tin", src, 4, 9)))
	say.Line("chain n:", names(tinsym.Complete(cs, "/p/c.tin", src, 5, 7)))
	say.Line("local Line:", names(tinsym.Complete(cs, "/p/c.tin", src, 6, 4)))
	say.Line("local i64:", names(tinsym.Complete(cs, "/p/c.tin", src, 7, 3)))
	say.Line("unknown field:", len(tinsym.Complete(cs, "/p/c.tin", src, 8, 12)) > 5)

	// Resolve after a value's dot: its type's method, not every method of the name; its type's field; every method of the
	// name when the value's type is not known
	let (rs, _) = tinsym.Parse(sym("fn", "main", "", "/p/c.tin", 3, "", "fn main()", "[]") +
			sym("type", "Point", "", "/p/c.tin", 20, "", "type Point struct", "[{{\"name\":\"X\",\"detail\":\"i64\"}}]") +
			sym("method", "Dist", "", "/p/c.tin", 25, "Point", "fn (p Point) Dist() i64", "[]") +
			sym("method", "Dist", "", "/p/c.tin", 30, "Line", "fn (l Line) Dist() i64", "[]") +
			fmtLocal(local, "pt", "mut Point"))
	let calls = "package main\n\nfn main() {{\n\tpt.Dist()\n\tpt.X\n\tq.Dist()\n}}\n"
	say.Line("method by type:", found(tinsym.Resolve(rs, "/p/c.tin", calls, 3, 5)))
	let field = tinsym.Resolve(rs, "/p/c.tin", calls, 4, 4)
	say.Line("field:", found(field), field[0].Kind, field[0].Name, field[0].Recv, field[0].Sig)
	say.Line("type not known:", found(tinsym.Resolve(rs, "/p/c.tin", calls, 5, 4)))
}

// fmtLocal is a local variable's JSON line with its name and type filled in.
fn fmtLocal(template str, name str, ty str) str {
	return twine.Replace(twine.Replace(template, "%s", name, 1), "%s", ty, 1)
}
