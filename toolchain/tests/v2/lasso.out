match true true false
string (?P<key>\w+)=(?P<val>[^&]*)
groups 2 1 2 -1
find (?P<key>\w+)=(?P<val>[^&]*) k=v&x=y 0 3 true
subs (?P<key>\w+)=(?P<val>[^&]*) k=v&x=y  0 3 0 1 2 3
texts (?P<key>\w+)=(?P<val>[^&]*) k=v  "k=v" "k" "v"
