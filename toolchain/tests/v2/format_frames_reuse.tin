package main

import "hearth"
import "say"
import "tide"
import "twine"

// Format frames are reused from a per-core free list (#553). A frame that is still open
// (nested formatting, a task that waits while its interpolation is evaluated) must never be
// handed out again, and a reused frame starts clean.

type Point struct {
	x i64
	y f64
}

fn pad3(i i64) str {
	return say.Fmt("%03d", i)
}

fn inner(i i64) str {
	return "b{i}c{pad3(i)}"
}

fn slow(n i64) str {
	tide.Sleep(1 * tide.Millisecond)
	return "t-{n}"
}

fn tasks() ![]str {
	mut got = []str{}
	scope s {
		for t in 0..2 {
			s.spawn(fn() ! {
				for k in 0..3 {
					got = append(got, "task {t}: {slow(t)} {k} {k * 10}")
				}
			})
		}
	}
	return got
}

fn check(n i64) !i64 {
	if n > 2 {
		fail "too big: {n} > {2}"
	}
	return n
}

fn main() {
	// Nested: an interpolation inside the arguments of another format.
	for i in 0..3 {
		say.Line("outer", "a{inner(i)}d", say.Fmt("[%d|%s|%5.2f]", i, "s{inner(i)}", 1.5))
	}

	// Two tasks whose interpolations wait in the middle, so their frames interleave.
	let got = tasks() catch _ { []str{} }
	for g in got {
		say.Line(g)
	}

	// Faults built by interpolation.
	for n in 1..5 {
		let v = check(n) catch err {
			say.Line("fault:", err)
			continue
		}
		say.Line("ok", v)
	}

	// A large text grows a frame's buffer past what a free frame keeps; a long precision
	// grows its scratch space. Later small formats are still right.
	let big = twine.Repeat("x", 100000)
	let s1 = "<{big}>"
	say.Line("big", len(s1), s1[0:3], s1[len(s1)-3:])
	let p = say.Fmt("%.600f", 1.0 / 3.0)
	say.Line("prec", len(p), p[0:8])
	say.Line("small", "{1}+{2.5}", Point{x: 3, y: 0.25}, []i64{1, 2}, map[str]i64{"k": 7})

	// After the pool is reset, frames (which live in the heap) keep working.
	hearth.Reset()
	say.Line("after reset", "{42}", say.Fmt("%x %q %v", 255, "q", true))

	// Many formats on one frame chain stay correct.
	mut sum = 0
	for i in 0..100000 {
		sum += len("{i}")
	}
	say.Line("digits", sum)
}
