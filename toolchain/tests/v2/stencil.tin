package main

import "say"
import "stencil"
import "fault"

// m builds a map value for the tests.
fn m(pairs []str) stencil.Value {
	mut mm = make(map[str]stencil.Value)
	mut i = 0
	for i+1 < len(pairs) {
		mm[pairs[i]] = stencil.Str(pairs[i+1])
		i += 2
	}
	return stencil.Map(mm)
}

// run renders text with data and prints the result or the fault.
fn run(name str, text str, data stencil.Value) {
	let t = stencil.Parse(name, text) catch err {
		say.Line("parse", name, err)
		return
	}
	let out = t.Execute(data) catch err {
		say.Line("exec", name, err)
		return
	}
	say.Line("out", name, out)
}

fn main() {
	// The basic forms: {{.}}, fields, nested maps and a missing key.
	run("dot", `Hello, {{.}}!`, stencil.Str("world"))
	run("field", `{{.a}} {{.b.c}} {{.missing}}`, m([]str{"a", "1", "b", ""}))
	mut nested = make(map[str]stencil.Value)
	nested["c"] = stencil.Str("deep")
	mut inner = make(map[str]stencil.Value)
	inner["b"] = stencil.Map(nested)
	run("nested", `{{.b.c}}`, stencil.Map(inner))

	// if, else if, else and the truthiness of zero values.
	run("if", `{{if .x}}yes{{else}}no{{end}}`, m([]str{"x", "1"}))
	run("if empty", `{{if .x}}yes{{else}}no{{end}}`, m([]str{"x", ""}))
	run("else if", `{{if .a}}a{{else if .b}}b{{else}}c{{end}}`, m([]str{"b", "1"}))
	run("if zero", `{{if .n}}yes{{else}}no{{end}}`, stencil.Map(mapOfInt("n", 0)))
	run("if true", `{{if .n}}yes{{else}}no{{end}}`, stencil.Map(mapOfInt("n", 3)))

	// range over a list, with and without variables, and the else branch.
	let items = stencil.List([]stencil.Value{stencil.Str("a"), stencil.Str("b"), stencil.Str("c")})
	run("range", `{{range .}}{{.}}{{end}}`, items)
	run("range vars", `{{range $i, $v := .}}{{$i}}={{$v}};{{end}}`, items)
	run("range one var", `{{range $v := .}}[{{$v}}]{{end}}`, items)
	run("range else", `{{range .}}x{{else}}empty{{end}}`, stencil.List([]stencil.Value{}))
	run("range int", `{{range .}}{{.}}{{end}}`, stencil.Int(4))

	// with, and the dot inside it.
	run("with", `{{with .a}}[{{.}}]{{end}}`, m([]str{"a", "v"}))
	run("with else", `{{with .a}}x{{else}}none{{end}}`, m([]str{"a", ""}))
	run("with var", `{{with $x := .a}}{{$x}}{{end}}`, m([]str{"a", "v"}))

	// Pipelines and the builtins.
	run("pipe", `{{.a | len}}`, m([]str{"a", "hello"}))
	run("len", `{{len .}}`, items)
	run("index", `{{index . 1}}`, items)
	run("index map", `{{index .a}}`, m([]str{"a", "v"}))
	run("eq", `{{if eq .a .b}}same{{else}}differ{{end}}`, m([]str{"a", "x", "b", "x"}))
	run("ne", `{{ne .a .b}}`, m([]str{"a", "x", "b", "y"}))
	run("lt", `{{lt .a .b}}`, m([]str{"a", "a", "b", "b"}))
	run("and", `{{and .a .b}}`, m([]str{"a", "x", "b", "y"}))
	run("or", `{{or .a .b}}`, m([]str{"a", "", "b", "y"}))
	run("not", `{{not .a}}`, m([]str{"a", ""}))
	run("printf", `{{printf "%s-%d" .a .n}}`, m2([]str{"a", "x"}, "n", 7))
	run("printf float", `{{printf "%.2f" .f}}`, stencil.Map(mapOfFloat("f", 3.14159)))
	run("printf q", `{{printf "%q" .a}}`, m([]str{"a", "hi"}))
	run("print", `{{print .a .n}}`, m2([]str{"a", "x"}, "n", 7))

	// Comments and trim markers.
	run("comment", `a{{/* ignored */}}b`, stencil.None())
	run("trim", `a  {{- . }}  b`, stencil.Str("x"))
	run("trim right", `a {{ . -}}  b`, stencil.Str("x"))

	// define, template and block.
	let t = stencil.Parse("defs", `{{define "T"}}[{{.}}]{{end}}{{template "T" .a}}{{template "T" .b}}`) catch err {
		say.Line("parse defs", err)
		return
	}
	let out = t.Execute(m([]str{"a", "1", "b", "2"})) catch err {
		say.Line("exec defs", err)
		return
	}
	say.Line("out defs", out)
	run("block", `{{block "B" .}}[{{.}}]{{end}}`, stencil.Str("x"))

	// User functions.
	mut t2 = stencil.Parse("funcs", `{{shout .a}} {{twice 3}}`) catch err {
		say.Line("parse funcs", err)
		return
	}
	t2.Func("shout", fn(args []stencil.Value) !stencil.Value {
		if len(args) != 1 {
			fail say.Fault("shout needs one argument")
		}
		return stencil.Str(args[0].String() + "!")
	})
	t2.Func("twice", fn(args []stencil.Value) !stencil.Value {
		return stencil.Int(args[0].Integer() * 2)
	})
	let out2 = t2.Execute(m([]str{"a", "hey"})) catch err {
		say.Line("exec funcs", err)
		return
	}
	say.Line("out funcs", out2)

	// Parse errors carry the line and column.
	for _, bad in []str{`{{.a`, `{{if .a}}x`, `{{end}}`, `{{range}}`, `{{.a |}}`, `{{(}}`, `{{.a}}x{{else}}`} {
		say.Line("parse error", bad, parseErr("bad", bad))
	}
	// An unclosed action on the second line reports line 2.
	say.Line("parse error line", parseErr("bad2", "line one\n" + `{{.a`))

	// Go's text/template exec_test.go cases that map onto the value tree, with Go's expected
	// output. The data is tval() below, adapted from Go's tVal: the same fields with the same
	// values as a map tree (no methods or pointers), and two of its maps hold two entries rather
	// than three, so the len and range expectations adapt with them. Templates Go writes in
	// backticks use double quotes here, as a Tin backtick string cannot hold one. Cases that need
	// methods, pointers, call, the slice builtin or break/continue are not ported.
	let tv = tval()
	execCheck("empty", ``, ``, tv)
	execCheck("text", `some text`, `some text`, tv)
	execCheck(".X", `-{{.X}}-`, `-x-`, tv)
	execCheck(".U.V", `-{{.U.V}}-`, `-v-`, tv)
	execCheck("map .one", `{{.MSI.one}}`, `1`, tv)
	execCheck("map .two", `{{.MSI.two}}`, `2`, tv)
	execCheck("map .NO", `{{.MSI.NO}}`, `<no value>`, tv)
	execCheck("declare in action", `{{$x := $.U.V}}{{$x}}`, `v`, tv)
	execCheck("simple assignment", `{{$x := 2}}{{$x = 3}}{{$x}}`, `3`, tv)
	execCheck("nested assignment", `{{$x := 2}}{{if true}}{{$x = 3}}{{end}}{{$x}}`, `3`, tv)
	execCheck("nested assignment changes the last declaration", `{{$x := 1}}{{if true}}{{$x := 2}}{{if true}}{{$x = 3}}{{end}}{{end}}{{$x}}`, `1`, tv)
	execCheck("*[]int[1]", `{{index .PSI 1}}`, `22`, tv)
	execCheck("empty with int", `{{.Empty1}}`, `3`, tv)
	execCheck("empty with string", `{{.Empty2}}`, `empty2`, tv)
	execCheck("empty with slice", `{{.Empty3}}`, `[7 8]`, tv)
	execCheck("if true", `{{if true}}TRUE{{end}}`, `TRUE`, tv)
	execCheck("if false", `{{if false}}TRUE{{else}}FALSE{{end}}`, `FALSE`, tv)
	execCheck("if 1", `{{if 1}}NON-ZERO{{else}}ZERO{{end}}`, `NON-ZERO`, tv)
	execCheck("if 0", `{{if 0}}NON-ZERO{{else}}ZERO{{end}}`, `ZERO`, tv)
	execCheck("if 1.5", `{{if 1.5}}NON-ZERO{{else}}ZERO{{end}}`, `NON-ZERO`, tv)
	execCheck("if emptystring", `{{if ""}}NON-EMPTY{{else}}EMPTY{{end}}`, `EMPTY`, tv)
	execCheck("if string", `{{if "notempty"}}NON-EMPTY{{else}}EMPTY{{end}}`, `NON-EMPTY`, tv)
	execCheck("if emptyslice", `{{if .SIEmpty}}NON-EMPTY{{else}}EMPTY{{end}}`, `EMPTY`, tv)
	execCheck("if slice", `{{if .SI}}NON-EMPTY{{else}}EMPTY{{end}}`, `NON-EMPTY`, tv)
	execCheck("if emptymap", `{{if .MSIEmpty}}NON-EMPTY{{else}}EMPTY{{end}}`, `EMPTY`, tv)
	execCheck("if map", `{{if .MSI}}NON-EMPTY{{else}}EMPTY{{end}}`, `NON-EMPTY`, tv)
	execCheck("if $x with $y int", `{{if $x := true}}{{with $y := .I}}{{$x}},{{$y}}{{end}}{{end}}`, `true,17`, tv)
	execCheck("if $x with $x int", `{{if $x := true}}{{with $x := .I}}{{$x}},{{end}}{{$x}}{{end}}`, `17,true`, tv)
	execCheck("if else if", `{{if false}}FALSE{{else if true}}TRUE{{end}}`, `TRUE`, tv)
	execCheck("if else chain", `{{if eq 1 3}}1{{else if eq 2 3}}2{{else if eq 3 3}}3{{end}}`, `3`, tv)
	execCheck("print", `{{print "hello, print"}}`, `hello, print`, tv)
	execCheck("print 123", `{{print 1 2 3}}`, `1 2 3`, tv)
	execCheck("printf int", `{{printf "%04x" 127}}`, `007f`, tv)
	execCheck("printf float", `{{printf "%g" 3.5}}`, `3.5`, tv)
	execCheck("printf string", `{{printf "%s" "hello"}}`, `hello`, tv)
	execCheck("printf field", `{{printf "%s" .U.V}}`, `v`, tv)
	execCheck("printf dot", `{{with .I}}{{printf "%d" .}}{{end}}`, `17`, tv)
	execCheck("printf var", `{{with $x := .I}}{{printf "%d" $x}}{{end}}`, `17`, tv)
	execCheck("html", `{{html "<script>alert(\"XSS\");</script>"}}`, `&lt;script&gt;alert(&#34;XSS&#34;);&lt;/script&gt;`, tv)
	execCheck("html pipeline", `{{printf "<script>alert(\"XSS\");</script>" | html}}`, `&lt;script&gt;alert(&#34;XSS&#34;);&lt;/script&gt;`, tv)
	execCheck("not", `{{not true}} {{not false}}`, `false true`, tv)
	execCheck("and", `{{and false 0}} {{and 1 0}} {{and 0 true}} {{and 1 1}}`, `false 0 0 1`, tv)
	execCheck("or", `{{or 0 0}} {{or 1 0}} {{or 0 true}} {{or 1 1}}`, `0 1 true 1`, tv)
	execCheck("slice[0]", `{{index .SI 0}}`, `3`, tv)
	execCheck("slice[1]", `{{index .SI 1}}`, `4`, tv)
	execCheck("map[one]", `{{index .MSI "one"}}`, `1`, tv)
	execCheck("double index", `{{index .SMSI 1 "eleven"}}`, `11`, tv)
	execCheck("index of an interface field", `{{index .Empty3 0}}`, `7`, tv)
	execCheck("len slice", `{{len .SI}}`, `3`, tv)
	execCheck("len map", `{{len .MSI}}`, `2`, tv)
	execCheck("with true", `{{with true}}{{.}}{{end}}`, `true`, tv)
	execCheck("with false", `{{with false}}{{.}}{{else}}FALSE{{end}}`, `FALSE`, tv)
	execCheck("with 1", `{{with 1}}{{.}}{{else}}ZERO{{end}}`, `1`, tv)
	execCheck("with 0", `{{with 0}}{{.}}{{else}}ZERO{{end}}`, `ZERO`, tv)
	execCheck("with emptystring", `{{with ""}}{{.}}{{else}}EMPTY{{end}}`, `EMPTY`, tv)
	execCheck("with string", `{{with "notempty"}}{{.}}{{else}}EMPTY{{end}}`, `notempty`, tv)
	execCheck("with emptyslice", `{{with .SIEmpty}}{{.}}{{else}}EMPTY{{end}}`, `EMPTY`, tv)
	execCheck("with slice", `{{with .SI}}{{.}}{{else}}EMPTY{{end}}`, `[3 4 5]`, tv)
	execCheck("with emptymap", `{{with .MSIEmpty}}{{.}}{{else}}EMPTY{{end}}`, `EMPTY`, tv)
	execCheck("with $x int", `{{with $x := .I}}{{$x}}{{end}}`, `17`, tv)
	execCheck("with $x struct.U.V", `{{with $x := $}}{{$x.U.V}}{{end}}`, `v`, tv)
	execCheck("with variable and action", `{{with $x := $}}{{$y := $.U.V}}{{$y}}{{end}}`, `v`, tv)
	execCheck("with else with", `{{with 0}}{{.}}{{else with true}}{{.}}{{end}}`, `true`, tv)
	execCheck("with else with chain", `{{with 0}}{{.}}{{else with false}}{{.}}{{else with "notempty"}}{{.}}{{end}}`, `notempty`, tv)
	execCheck("range []int", `{{range .SI}}-{{.}}-{{end}}`, `-3--4--5-`, tv)
	execCheck("range empty no else", `{{range .SIEmpty}}-{{.}}-{{end}}`, ``, tv)
	execCheck("range []int else", `{{range .SI}}-{{.}}-{{else}}EMPTY{{end}}`, `-3--4--5-`, tv)
	execCheck("range empty else", `{{range .SIEmpty}}-{{.}}-{{else}}EMPTY{{end}}`, `EMPTY`, tv)
	execCheck("range []bool", `{{range .SB}}-{{.}}-{{end}}`, `-true--false-`, tv)
	execCheck("range map", `{{range .MSI}}-{{.}}-{{end}}`, `-1--2-`, tv)
	execCheck("range empty map else", `{{range .MSIEmpty}}-{{.}}-{{else}}EMPTY{{end}}`, `EMPTY`, tv)
	execCheck("range empty interface", `{{range .Empty3}}-{{.}}-{{else}}EMPTY{{end}}`, `-7--8-`, tv)
	execCheck("range $x SI", `{{range $x := .SI}}<{{$x}}>{{end}}`, `<3><4><5>`, tv)
	execCheck("range $x $y SI", `{{range $x, $y := .SI}}<{{$x}}={{$y}}>{{end}}`, `<0=3><1=4><2=5>`, tv)
	execCheck("range $x MSIone", `{{range $x := .MSIone}}<{{$x}}>{{end}}`, `<1>`, tv)
	execCheck("range $x $y MSIone", `{{range $x, $y := .MSIone}}<{{$x}}={{$y}}>{{end}}`, `<one=1>`, tv)
	execCheck("declare in range", `{{range $x := .PSI}}<{{$foo:=$x}}{{$x}}>{{end}}`, `<21><22><23>`, tv)
	execCheck("or as if true", `{{or .SI "slice is empty"}}`, `[3 4 5]`, tv)
	execCheck("or as if false", `{{or .SIEmpty "slice is empty"}}`, `slice is empty`, tv)
	execCheck("decimal", `{{print 1234}}`, `1234`, tv)
	execCheck("hex", `{{print 0x123}}`, `291`, tv)
	execCheck("float", `{{print 123.4}}`, `123.4`, tv)
	execCheck("dot int", `<{{.}}>`, `<13>`, stencil.Int(13))
	execCheck("dot string", `<{{.}}>`, `<hello>`, stencil.Str("hello"))
	execCheck("dot bool", `<{{.}}>`, `<true>`, stencil.Bool(true))
	execCheck("$ int", `{{$}}`, `123`, stencil.Int(123))
	execCheck("js", `{{js .}}`, `It\'d be nice.`, stencil.Str("It'd be nice."))
	execCheck("js unicode", `{{js .}}`, `café \u2028`, stencil.Str("caf\xc3\xa9 \xe2\x80\xa8"))
	execCheck("urlquery", `{{"http://www.example.org/"|urlquery}}`, `http%3A%2F%2Fwww.example.org%2F`, stencil.None())
	execCheck("bug9", `{{.cause}}`, `neglect`, m([]str{"cause", "neglect"}))

	// Execution bounds: the output limit and the template recursion limit.
	let many = stencil.Parse("many", `{{range .}}0123456789{{end}}`) catch err {
		say.Line("parse many", err)
		return
	}
	let big = stencil.List([]stencil.Value{})
	mut manyList = []stencil.Value{}
	for i in 0..7 {
		manyList = append(manyList, stencil.Int(i))
	}
	let bigOut = many.Execute(stencil.List(manyList)) catch err {
		say.Line("many failed", err)
		return
	}
	say.Line("many ok", len(bigOut))
	let deep = stencil.Parse("deep", `{{define "L"}}{{template "L" .}}{{end}}{{template "L" .}}`) catch err {
		say.Line("parse deep", err)
		return
	}
	let deepOut = deep.Execute(stencil.None()) catch err {
		say.Line("deep limit", fault.Is(err, fault.LimitExceeded))
		return
	}
	say.Line("deep ok", len(deepOut))

}

// execCheck renders text with data and prints whether the output is Go's expected output.
fn execCheck(name str, text str, want str, data stencil.Value) {
	let t = stencil.Parse(name, text) catch err {
		say.Line("case", name, "parse", err)
		return
	}
	let out = t.Execute(data) catch err {
		say.Line("case", name, "exec", err)
		return
	}
	if out == want {
		say.Line("case", name, "ok")
	} else {
		say.Line("case", name, "want", want, "got", out)
	}
}

// tval is the data of the ported exec_test.go cases, adapted from Go's tVal.
fn tval() stencil.Value {
	mut d = make(map[str]stencil.Value)
	d["X"] = stencil.Str("x")
	d["I"] = stencil.Int(17)
	d["S"] = stencil.Str("xyz")
	d["B"] = stencil.Bool(true)
	mut u = make(map[str]stencil.Value)
	u["V"] = stencil.Str("v")
	u["U16"] = stencil.Int(16)
	u["True"] = stencil.Bool(true)
	d["U"] = stencil.Map(u)
	mut msi = make(map[str]stencil.Value)
	msi["one"] = stencil.Int(1)
	msi["two"] = stencil.Int(2)
	d["MSI"] = stencil.Map(msi)
	d["MSIone"] = stencil.Map(mapOfInt("one", 1))
	d["MSIEmpty"] = stencil.Map(make(map[str]stencil.Value))
	d["SI"] = stencil.List([]stencil.Value{stencil.Int(3), stencil.Int(4), stencil.Int(5)})
	d["SIEmpty"] = stencil.List([]stencil.Value{})
	d["SB"] = stencil.List([]stencil.Value{stencil.Bool(true), stencil.Bool(false)})
	mut smsi = make(map[str]stencil.Value)
	smsi["eleven"] = stencil.Int(11)
	d["SMSI"] = stencil.List([]stencil.Value{stencil.Map(make(map[str]stencil.Value)), stencil.Map(smsi)})
	d["Empty1"] = stencil.Int(3)
	d["Empty2"] = stencil.Str("empty2")
	d["Empty3"] = stencil.List([]stencil.Value{stencil.Int(7), stencil.Int(8)})
	d["PI"] = stencil.Int(23)
	d["PS"] = stencil.Str("a string")
	d["PSI"] = stencil.List([]stencil.Value{stencil.Int(21), stencil.Int(22), stencil.Int(23)})
	d["FloatZero"] = stencil.Float(0.0)
	return stencil.Map(d)
}

// parseErr returns a parse error's text, or "parsed ok".
fn parseErr(name str, text str) str {
	let t = stencil.Parse(name, text) catch err {
		return say.Fmt("%s", err)
	}
	return "parsed ok"
}

// m2 builds a map of strings plus one integer entry.
fn m2(pairs []str, ik str, iv i64) stencil.Value {
	mut mm = make(map[str]stencil.Value)
	mut i = 0
	for i+1 < len(pairs) {
		mm[pairs[i]] = stencil.Str(pairs[i+1])
		i += 2
	}
	mm[ik] = stencil.Int(iv)
	return stencil.Map(mm)
}

// mapOfInt is a one-entry map with an integer value.
fn mapOfInt(k str, v i64) map[str]stencil.Value {
	mut mm = make(map[str]stencil.Value)
	mm[k] = stencil.Int(v)
	return mm
}

// mapOfFloat is a one-entry map with a float value.
fn mapOfFloat(k str, v f64) map[str]stencil.Value {
	mut mm = make(map[str]stencil.Value)
	mm[k] = stencil.Float(v)
	return mm
}
