package main

import "say"

// #669: what a value struct with references cannot do: an optional field has no ==, and a func
// field cannot be nil, so the value has no zero value, nor be copied out of an arena (#692; the
// region rules for a kept one are in value_refs_escape_bad and value_func_dyn_bad).

type Entry value struct {
	key  str
	note ?str
}

type Rows value struct {
	ids fn() i64
}

fn main() {
	let e = Entry{key: "a"}
	say.Line(e == e)
	mut r Rows
	_ = r
	let a = arena {
		Rows{ids: fn() i64 { return 1 }}
	}
	_ = a
}
