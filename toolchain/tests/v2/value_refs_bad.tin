package main

import "say"

// #669 step 1: a value struct with a str or pointer-optional field cannot reach long-lived
// memory yet, since nothing counts what its bytes point at: keep, a global, a capture by a
// function literal (a cell a kept closure would copy) and an arena block's value are E295. A
// slice field and a str in an inline array are E295 too, and an optional field still has no ==.

type Entry value struct {
	key  str
	note ?str
}

type Rows value struct {
	ids []i64
}

type Codes value struct {
	tags [2]str
}

mut saved Entry

mut all = []Entry{}

fn main() {
	let e = Entry{key: "a"}
	let k = keep(e)
	let f = fn() str {
		return e.key
	}
	let v = arena {
		Entry{key: "b"}
	}
	say.Line(k.key, f(), v.key, e == e)
}
