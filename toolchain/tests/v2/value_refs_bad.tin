package main

import "say"

// #669: what a value struct with a str field cannot do yet: a func field and a str in an inline
// array are E295, and an optional field has no == (the region rules for a kept one are in
// value_refs_escape_bad).

type Entry value struct {
	key  str
	note ?str
}

type Rows value struct {
	ids fn() i64
}

type Codes value struct {
	tags [2]str
}

fn main() {
	let e = Entry{key: "a"}
	say.Line(e == e)
}
