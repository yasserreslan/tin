package main

import "say"
import "sift"
import "twine"

type Acc struct {
	n    i64
	name str
}

// each iteration of a for loop has its own copy of the loop variable
fn loopVars() {
	mut fs = make([]fn() i64, 0, 3)
	for i in 0..3 {
		fs = append(fs, fn() i64 {
			return i * 10
		})
	}
	for _, f in fs {
		say.Line("loop", f())
	}
	mut gs = make([]fn() i64, 0, 3)
	for _, v in []i64{7, 8, 9} {
		gs = append(gs, fn() i64 {
			return v + 1
		})
	}
	for _, g in gs {
		say.Line("range", g())
	}
}

fn deferred() {
	mut n = 1
	defer fn() {
		say.Line("deferred sees", n)
	}()
	n = 5
	say.Line("body", n)
}

fn nested() i64 {
	mut a = 1
	let f = fn() fn() i64 {
		mut b = 10
		return fn() i64 {
			a += 1
			b += 1
			return a*100 + b
		}
	}
	let g = f()
	let h = f()
	say.Line("nested", g(), g(), h())
	return a
}

fn structs() {
	let a = Acc{n: 1, name: "x"}
	let inc = fn(by i64) {
		a.n += by
	}
	inc(2)
	inc(3)
	say.Line("struct", a.n, a.name)
	mut total = 0
	for _, s in []Acc{{n: 1, name: "a"}, {n: 2, name: "b"}} {
		let show = fn() str {
			total += s.n
			return s.name
		}
		say.Line("each", show())
	}
	say.Line("total", total)
}

fn shadow() {
	mut x = 1
	let f = fn() i64 {
		mut x = 100
		x += 1
		return x
	}
	say.Line("shadow", f(), x)
}

mut kept fn() i64

fn keepNested() {
	mut base = keep([]i64{1, 2, 3})
	kept = keep(fn() i64 {
		base = append(base, i64(len(base)))
		return i64(len(base))
	})
}

fn library() {
	let xs = []i64{5, 2, 8, 1, 9, 3, 7, 4, 6, 0, 15, 12, 11, 14, 13, 10}
	mut cmps = 0
	sift.SortFunc(mut xs, fn(a i64, b i64) i64 {
		cmps += 1
		if a < b {
			return -1
		}
		if a > b {
			return 1
		}
		return 0
	})
	say.Line("sorted", xs, cmps)
	let limit_ = 3
	mut seen = 0
	let out = twine.Map(fn(r i32) i32 {
		seen += 1
		if i64(seen) > i64(limit_) {
			return r - 32
		}
		return r
		}, "abcdefg")
	say.Line("map", out, seen)
	let sep i32 = 0x2c
	let parts = twine.FieldsFunc("a,b;;c,d", fn(r i32) bool {
		return r == sep || r == ';'
	})
	say.Line("fields", parts)
}

fn main() {
	loopVars()
	deferred()
	say.Line("outer a", nested())
	structs()
	shadow()
	keepNested()
	say.Line("kept", kept(), kept())
	library()
}
