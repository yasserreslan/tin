package main

// A method with a mut receiver satisfies only a mut shape method (#644): the error is at the
// call that picks Cursor, not an E701 inside the generic body, which is correct on its own.
shape Reader { Read(buf mut []u8) !i64 }

type Cursor struct { pos i64 }

fn (c mut Cursor) Read(buf mut []u8) !i64 {
	c.pos = c.pos + 1
	return c.pos
}

fn Use[R Reader](r R) i64 {
	let buf = make([]u8, 4)
	let n = r.Read(mut buf) catch _ { 0 }
	return n
}

fn main() {
	let c = Cursor{pos: 0}
	Use(c)
}
