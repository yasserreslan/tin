# #633: a struct literal whose local never leaves the function is a zeroed frame area, so a loop
# of them calls no allocator; one passed to a parameter that is returned still allocates.
[arm64]
CHECK: (?m)^_contained:
CHECK-NOT: rt_alloc
CHECK: (?m)^_escapes:
CHECK: bl _rt_alloc
CHECK: (?m)^_main\.main:

[amd64]
# The contained P values live inline in rbp-relative frame slots; their addresses are held in
# registers for field access. The escaping P is allocated, with its fields inline at offsets 0
# and 8 from the returned address.
CHECK: (?ms)# L(?P<c>[0-9]+): contained$.*?# L(?P<e>[0-9]+): escapes$.*?# L(?P<m>[0-9]+): main\.main$.*?^L(?P=c):\npush rbp\n(?:(?!rt_alloc)(?!^L(?P=e):$)[\s\S])*?lea r11,\[rbp-0x10\].*?mov r14,rsi.*?lea r11,\[rbp-0x20\].*?mov QWORD PTR \[rbp-0x28\],rsi.*?^L(?P=e):\n(?:(?!^L(?P=m):$)[\s\S])*?call S[0-9]+  # rt_alloc\nmov r12,rax\nmov QWORD PTR \[r12\],rbx\nmov QWORD PTR \[r12\+0x8\],rbx
