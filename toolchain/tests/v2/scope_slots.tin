		let f4_10 = fl + 10.25
		let e4 dyn Namer = Box{n: 4, tag: s4_0}
		let add4 = fn(x i64) i64 { return x + 4 }
		out = out + s4_0 + s4_1 + s4_2 + s4_3 + s4_4 + s4_5 + s4_6 + s4_7 + s4_8 + s4_9 + s4_10 + e4.Name() + d.Name()
		fl = (f4_0 + f4_1 + f4_2 + f4_3 + f4_4 + f4_5 + f4_6 + f4_7 + f4_8 + f4_9 + f4_10) / 11.0
		out = out + "{add4(n)};"
	}
	if n > 0 {
		let s5_0 = "x50"
		let f5_0 = fl + 0.25
