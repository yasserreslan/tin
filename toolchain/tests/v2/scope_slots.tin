		let f1_9 = fl + 9.25
		let s1_10 = "x110"
		let f1_10 = fl + 10.25
		let e1 dyn Namer = Box{n: 1, tag: s1_0}
		let add1 = fn(x i64) i64 { return x + 1 }
		out = out + s1_0 + s1_1 + s1_2 + s1_3 + s1_4 + s1_5 + s1_6 + s1_7 + s1_8 + s1_9 + s1_10 + e1.Name() + d.Name()
		fl = (f1_0 + f1_1 + f1_2 + f1_3 + f1_4 + f1_5 + f1_6 + f1_7 + f1_8 + f1_9 + f1_10) / 11.0
		out = out + "{add1(n)};"
	}
	if n > 0 {
		let s2_0 = "x20"
		let f2_0 = fl + 0.25
		let s2_1 = "x21"
		let f2_1 = fl + 1.25
		let s2_2 = "x22"
		let f2_2 = fl + 2.25
		let s2_3 = "x23"
		let f2_3 = fl + 3.25
