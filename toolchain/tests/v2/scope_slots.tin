		let f5_9 = fl + 9.25
		let s5_10 = "x510"
		let f5_10 = fl + 10.25
		let e5 dyn Namer = Box{n: 5, tag: s5_0}
		let add5 = fn(x i64) i64 { return x + 5 }
		out = out + s5_0 + s5_1 + s5_2 + s5_3 + s5_4 + s5_5 + s5_6 + s5_7 + s5_8 + s5_9 + s5_10 + e5.Name() + d.Name()
		fl = (f5_0 + f5_1 + f5_2 + f5_3 + f5_4 + f5_5 + f5_6 + f5_7 + f5_8 + f5_9 + f5_10) / 11.0
		out = out + "{add5(n)};"
