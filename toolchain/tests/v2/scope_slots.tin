fn loops(n i64) i64 {
	mut carry = 1
	mut prev = 7
	mut total = 0
	let f = twice
	for i in 0..n {
		if i % 5 == 4 {
			continue
		}
		let t0 = carry + i * 1 + prev
		let t1 = carry + i * 2 + prev
		let t2 = carry + i * 3 + prev
		let t3 = carry + i * 4 + prev
		let t4 = carry + i * 5 + prev
		let t5 = carry + i * 6 + prev
		let t6 = carry + i * 7 + prev
		let t7 = carry + i * 8 + prev
		let t8 = carry + i * 9 + prev
		let t9 = carry + i * 10 + prev
		let t10 = carry + i * 11 + prev
		let t11 = carry + i * 12 + prev
		let s = t0 + t1 + t2 + t3 + t4 + t5 + t6 + t7 + t8 + t9 + t10 + t11
		prev = carry
		carry = (carry * 31 + s) % 65521
		for k in 0..3 {
			let u0 = k * 3 + carry
			let u1 = k * 4 + carry
			let u2 = k * 5 + carry
			let u3 = k * 6 + carry
			let u4 = k * 7 + carry
			let u5 = k * 8 + carry
			let u6 = k * 9 + carry
			let u7 = k * 10 + carry
			let u8 = k * 11 + carry
			let u9 = k * 12 + carry
			total = (total + u0 + u1 + u2 + u3 + u4 + u5 + u6 + u7 + u8 + u9 + f(k)) % 1000003
			if k == 2 && i == n - 1 {
				break
			}
		}
		total = (total + sum(carry, prev, i) + f(total % 100)) % 1000003
	}
	return total + carry + prev
}

fn mixed(n i64) str {
	mut out = ""
	mut fl = 0.5
	let d dyn Namer = Box{n: n, tag: "d"}
	if n > 0 {
		let s0_0 = "x00"
		let f0_0 = fl + 0.25
		let s0_1 = "x01"
		let f0_1 = fl + 1.25
		let s0_2 = "x02"
		let f0_2 = fl + 2.25
		let s0_3 = "x03"
		let f0_3 = fl + 3.25
		let s0_4 = "x04"
		let f0_4 = fl + 4.25
		let s0_5 = "x05"
		let f0_5 = fl + 5.25
		let s0_6 = "x06"
		let f0_6 = fl + 6.25
		let s0_7 = "x07"
		let f0_7 = fl + 7.25
		let s0_8 = "x08"
		let f0_8 = fl + 8.25
		let s0_9 = "x09"
		let f0_9 = fl + 9.25
		let s0_10 = "x010"
		let f0_10 = fl + 10.25
		let e0 dyn Namer = Box{n: 0, tag: s0_0}
		let add0 = fn(x i64) i64 { return x + 0 }
		out = out + s0_0 + s0_1 + s0_2 + s0_3 + s0_4 + s0_5 + s0_6 + s0_7 + s0_8 + s0_9 + s0_10 + e0.Name() + d.Name()
		fl = (f0_0 + f0_1 + f0_2 + f0_3 + f0_4 + f0_5 + f0_6 + f0_7 + f0_8 + f0_9 + f0_10) / 11.0
		out = out + "{add0(n)};"
	}
	if n > 0 {
		let s1_0 = "x10"
		let f1_0 = fl + 0.25
		let s1_1 = "x11"
		let f1_1 = fl + 1.25
		let s1_2 = "x12"
		let f1_2 = fl + 2.25
