package main

import "say"

// Frame slots shared by locals whose live ranges do not meet (#570): blocks with more live
// locals than there are callee-saved registers spill, and later blocks reuse the slots.
// Values carried by loops, read by later iterations or after the loop, and used by indirect
// and variadic calls must keep their own slots while block temporaries come and go.
// Generated once by a script; main's compiler prints the same output.

shape Namer {
	Name() str
}

type Box struct {
	n i64
	tag str
}

fn (b Box) Name() str {
	return "box {b.n} {b.tag}"
}

fn sum(xs ...i64) i64 {
	mut t = 0
	for x in xs {
		t += x
	}
	return t
}

fn twice(x i64) i64 {
	return x * 2
}

fn blocks(seed i64) i64 {
	mut acc = seed
	if acc >= 0 {
		let b0_0 = acc % 97 + 0
		let b0_1 = acc % 98 + 1
		let b0_2 = acc % 99 + 2
		let b0_3 = acc % 100 + 3
		let b0_4 = acc % 101 + 4
