package main

import "say"

type Color i64

const Red Color = 0
const Green Color = 1
const Blue Color = 2

fn main() {
	{
		let x = 3
		if x > 2 {
			say.Line("ifinit", x)
		}
	}
	{
		let y = 5
		match true {
			true if (y > 3) => {
				say.Line("tagless")
			}
		}
	}
	mut n = 0
	for i in 0..3 {
		n += i
	}
	say.Line("range int", n)
	say.Line(0b101, 0o17, 1_000, 'a', "é", `raw\n`)
	mut (a, b) = 1, 2
	a, b = b, a
	say.Line(a, b, Green, Blue)
	mut arr [3]i64
	say.Line(len(arr))
	extra()
	board()
}

type Grid struct {
	cells [4]i64
	names [2]str
}

mut g [5]u8

fn extra() {
	let gr = Grid{}
	gr.cells[3] = 9
	say.Line(len(gr.cells), gr.cells, len(gr.names), gr.names[1] == "", len(g))
	mut m [2][3]i64
	say.Line(len(m), len(m[0]))
}

type Board struct {
	cells [3][3]u8
}

fn board() {
	let b = Board{}
	b.cells[1][2] = 7
	mut plain []i64
	say.Line(len(b.cells), len(b.cells[2]), b.cells[1], len(plain))
}
