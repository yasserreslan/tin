package main

import "say"

// Locals of disjoint scopes share frame slots (#570): 300 blocks of two locals each, with
// only a few live at a time, keep main's frame small (it was 4832 bytes on arm64). Each
// block's locals are live from their let to their last read, so the blocks reuse one or
// two slots. Generated once by a script.

