package main

import "say"

type User struct {
	Name str
	Tags []str
}

fn port(text str) !i64 {
	if text == "" {
		fail "empty port"
	}
	mut n = 0
	for i in 0..len(text) {
		let c = text[i]
		if c < '0' || c > '9' {
			fail "bad digit {str(c)} at {i} in {text:q}"
		}
		n = n*10 + i64(c-'0')
	}
	return n
}

fn main() {
	let n = 3
	let pi = 3.14159
	let u = User{Name: "ana", Tags: []str{"a", "b"}}
	let xs = []i64{10, 20, 30}
	let m = map[str]i64{"k": 7}
	say.Line("n={n} pi={pi} name={u.Name} tags={u.Tags} len={len(xs)}")
	say.Line("sum={xs[0] + xs[1]} slice={xs[1:]} map={m}")
	say.Line("fixed={pi:.2} hex={255:x} HEX={255:X} pad=[{n:5}] left=[{u.Name:-6}] zero=[{n:03}] e={pi:.3e}")
	say.Line("braces {{literal}} and 100% sure, {{n}} is not {n}")
	say.Line("quoted {u.Name:q} bool {n > 2} rune {'x'}")
	let s = "port {n}"
	say.Line(s, len(s))
	say.Line(`raw {n} stays`)
	let (_, err) = port("8a0")
	say.Line(err)
	let p = port("") catch e { say.Line("caught: {e}")
		0 }
	say.Line("p={p}")
}
