package main

import "say"
import "twine"

fn main() {
	let s = "hello, world"
	say.Line("contains", twine.Contains(s, "world"), twine.Contains(s, "World"), twine.Contains(s, ""), twine.Contains("", ""), twine.Contains("", "a"), twine.ContainsByte(s, ','), twine.ContainsByte(s, 'z'))
	say.Line("index", twine.Index(s, "l"), twine.Index(s, "lo"), twine.Index(s, "world"), twine.Index(s, "xyz"), twine.Index(s, ""), twine.Index("", "a"), twine.Index("aaab", "ab"), twine.Index("ab", "abc"))
	say.Line("lastindex", twine.LastIndex(s, "l"), twine.LastIndex(s, "o"), twine.LastIndex(s, "hello"), twine.LastIndex(s, ""), twine.LastIndex(s, "zz"), twine.LastIndex("abab", "ab"), twine.LastIndex("ab", "abc"))
	say.Line("indexbyte", twine.IndexByte(s, 'o'), twine.IndexByte(s, 'z'), twine.IndexByte("", 'a'), twine.LastIndexByte(s, 'o'), twine.LastIndexByte(s, 'z'))
	say.Line("indexbytefrom", twine.IndexByteFrom(s, 0, 'o'), twine.IndexByteFrom(s, 5, 'o'), twine.IndexByteFrom(s, 9, 'o'), twine.IndexByteFrom(s, -3, 'h'), twine.IndexByteFrom(s, 12, 'd'), twine.IndexByteFrom(s, 11, 'd'), twine.IndexByteFrom("", 0, 'a'))
	say.Line("prefix", twine.HasPrefix(s, "hell"), twine.HasPrefix(s, "world"), twine.HasPrefix(s, ""), twine.HasPrefix("", "a"))
	say.Line("suffix", twine.HasSuffix(s, "world"), twine.HasSuffix(s, "hello"), twine.HasSuffix(s, ""), twine.HasSuffix("d", "world"))

	say.Line("split", twine.Split("a,b,c", ","), twine.Split("a,b,c,", ","), twine.Split("abc", ","), len(twine.Split("", ",")), twine.Split("a--b--c", "--"))
	say.Line("split empty sep", twine.Split("héy", ""), len(twine.Split("", "")))
	say.Line("splitn", twine.SplitN("a,b,c,d", ",", 2), len(twine.SplitN("a,b,c,d", ",", 0)), twine.SplitN("a,b,c,d", ",", -1), twine.SplitN("a,b,c,d", ",", 10), twine.SplitN("abc", "", 2))
	say.Line("fields", twine.Fields("  foo bar\tbaz\n qux  "), len(twine.Fields("   ")), twine.Fields("one"))
	say.Line("join", say.Fmt("%q %q %q %q %q", twine.Join([]str{"a", "b", "c"}, ", "), twine.Join([]str{}, ","), twine.Join([]str{"solo"}, ","), twine.Join([]str{"", ""}, "-"), twine.Join([]str{"x", "y"}, "")))
	say.Line("repeat", say.Fmt("%q %q %q %q %q", twine.Repeat("ab", 3), twine.Repeat("x", 0), twine.Repeat("", 5), twine.Repeat("-", -1), twine.Repeat("one", 1)))

	say.Line("replace", say.Fmt("%q %q %q %q %q %q", twine.Replace("oink oink oink", "k", "ky", 2), twine.Replace("oink oink oink", "oink", "moo", -1), twine.Replace("abc", "", "-", -1), twine.Replace("abc", "", "-", 2), twine.Replace("aaa", "a", "b", 0), twine.Replace("aaa", "x", "y", -1)))
	say.Line("replaceall", say.Fmt("%q %q %q %q", twine.ReplaceAll("a.b.c", ".", "::"), twine.ReplaceAll("aaaa", "aa", "b"), twine.ReplaceAll("abc", "abc", ""), twine.ReplaceAll("héllo", "é", "e")))
	say.Line("case", say.Fmt("%q %q %q %q", twine.ToLower("Hello, WORLD! é"), twine.ToUpper("Hello, world! é"), twine.ToLower("already"), twine.ToUpper("123")))

	say.Line("trim", say.Fmt("%q %q %q %q %q %q", twine.Trim("xxhixx", "x"), twine.Trim("  hi  ", " "), twine.Trim("abcHIcba", "abc"), twine.Trim("hi", ""), twine.Trim("", "x"), twine.Trim("¡¡Hola!!", "!¡")))
	say.Line("trimspace", say.Fmt("%q %q %q %q", twine.TrimSpace("  \t hi there \n"), twine.TrimSpace("hi"), twine.TrimSpace("   "), twine.TrimSpace("\xc2\xa0x\xc2\xa0")))
	say.Line("trimleft", say.Fmt("%q %q %q", twine.TrimLeft("xxhixx", "x"), twine.TrimLeft("  hi", " "), twine.TrimLeft("hi", "hi")))
	say.Line("trimright", say.Fmt("%q %q %q", twine.TrimRight("xxhixx", "x"), twine.TrimRight("hi  ", " "), twine.TrimRight("héé", "é")))
	say.Line("trimprefix", twine.TrimPrefix("prefix-body", "prefix-"), twine.TrimPrefix("body", "prefix-"), twine.TrimPrefix("x", ""))
	say.Line("trimsuffix", twine.TrimSuffix("body.txt", ".txt"), twine.TrimSuffix("body", ".txt"), twine.TrimSuffix("x", ""))

	say.Line("count", twine.Count("cheese", "e"), twine.Count("five", ""), twine.Count("aaaa", "aa"), twine.Count("abc", "d"), twine.Count("", ""), twine.Count("héllo", ""), twine.Count("abcabc", "abc"))
	say.Line("equalfold", twine.EqualFold("Go", "GO"), twine.EqualFold("Go", "Gopher"), twine.EqualFold("é", "É"), twine.EqualFold("abc", "abd"), twine.EqualFold("", ""), twine.EqualFold("a", ""), twine.EqualFold("HÉllo", "héLLO"))

	say.Line("compare", twine.Compare("a", "b"), twine.Compare("b", "a"), twine.Compare("x", "x"), twine.Compare("", "a"), twine.Compare("ab", "a"), twine.Compare("", ""))
	say.Line("indexrune", twine.IndexRune("chicken", 'k'), twine.IndexRune("chicken", 'd'), twine.IndexRune("héllo", 0xe9), twine.IndexRune("héllo", 0x20ac), twine.ContainsRune("héllo", 0xe9), twine.ContainsRune("abc", 'z'))
	say.Line("indexany", twine.IndexAny("chicken", "kenc"), twine.IndexAny("chicken", "xyz"), twine.IndexAny("héllo", "é"), twine.IndexAny("abc", ""), twine.ContainsAny("failure", "ui"), twine.ContainsAny("foo", ""), twine.ContainsAny("", "x"))

	mut (before, after, found) = twine.Cut("key=value=x", "=")
	say.Line("cut1", before, after, found)
	before, after, found = twine.Cut("novalue", "=")
	say.Line("cut2", say.Fmt("%q %q", before, after), found)
	before, after, found = twine.Cut("=v", "=")
	say.Line("cut3", say.Fmt("%q %q", before, after), found)

	let b = twine.NewBuilder(8)
	b.Str("num=")
	b.Int(-42)
	b.Byte(' ')
	b.Int(0)
	b.Byte(' ')
	b.Int(9223372036854775807)
	b.Byte(' ')
	b.Int(-9223372036854775807 - 1)
	b.Rune(0x20ac)
	say.Line("builder", b.Len(), b.String())
	let bs = b.Bytes()
	say.Line("builder bytes", len(bs), bs[0], bs[len(bs)-1])
	b.Reset()
	say.Line("reset", b.Len(), say.Fmt("%q", b.String()))
	b.Str("again")
	b.Int(7)
	say.Line("reuse", b.String())
	let z = twine.Builder{}
	z.Str("zero")
	z.Byte('!')
	say.Line("zero builder", z.Len(), z.String())
}
