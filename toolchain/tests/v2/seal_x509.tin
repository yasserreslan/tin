package main

import "say"
import "seal"
import "quarry"
import "twine"

// Verifies every case of a test PKI made by bench/ref/x509_pki (default: the copy in
// toolchain/tests/data/x509; tools/ci/x509_check.tin passes a fresh one). Prints "NAME OK n" or
// "NAME FAIL class: fault"; bench/ref/seal_x509 is the Go twin (it prints the class only).

mut dir = "toolchain/tests/data/x509"

fn load(name str) !seal.Certificate {
	let text = try quarry.ReadFile(dir + "/certs/" + name + ".pem")
	let certs = try seal.ParseCertificatesPEM(text)
	return certs[0]
}

fn pool(list str) !seal.CertPool {
	let p = seal.NewCertPool()
	if list == "-" {
		return p
	}
	for _, n in twine.Split(list, ",") {
		let c = try load(n)
		p.Add(c)
	}
	return p
}

fn has(s str, part str) bool {
	return twine.Contains(s, part)
}

// class names the kind of failure from the fault's text, in the classes cases.txt uses.
fn class(msg str) str {
	if has(msg, "has expired") || has(msg, "not valid yet") {
		return "time"
	}
	if has(msg, "is valid for") || has(msg, "not valid for any") || has(msg, "contains a wildcard") {
		return "hostname"
	}
	if has(msg, "unknown authority") {
		return "unknown-authority"
	}
	if has(msg, "RSA key too small") {
		return "weak-key"
	}
	if has(msg, "SHA-1") {
		return "sha1"
	}
	if has(msg, "not a CA") || has(msg, "may not sign certificates") {
		return "not-ca"
	}
	if has(msg, "bad signature") {
		return "signature"
	}
	if has(msg, "too long") {
		return "too-long"
	}
	if has(msg, "path length") {
		return "pathlen"
	}
	if has(msg, "key usage") {
		return "eku"
	}
	if has(msg, "name constraints") {
		return "constraints"
	}
	if has(msg, "critical extension") {
		return "critical"
	}
	return "other"
}

fn run(f []str, now i64) ! {
	let leaf = try load(f[3])
	let inter = try pool(f[4])
	let roots = try pool(f[5])
	mut usage = []str{seal.ExtKeyUsageServerAuth}
	if f[2] == "client" {
		usage = []str{seal.ExtKeyUsageClientAuth}
	} else if f[2] == "any" {
		usage = []str{seal.ExtKeyUsageAny}
	}
	mut host = f[1]
	if host == "-" {
		host = ""
	}
	let (chain, err) = leaf.Verify(seal.VerifyOptions{DNSName: host, Roots: roots, Intermediates: inter, Now: now, KeyUsages: usage})
	if err != nil {
		let msg = say.Str(err)
		say.Line(f[0], "FAIL", class(msg) + ":", msg)
		return
	}
	say.Line(f[0], "OK", len(chain))
}

fn main() {
	let args = quarry.Args()
	if len(args) > 1 {
		dir = keep(args[1])
	}
	let text = quarry.ReadFile(dir + "/cases.txt") catch err {
		say.Line("cases.txt:", err)
		return
	}
	mut now = 0
	for _, ln in twine.Split(twine.TrimSpace(text), "\n") {
		let f = twine.Fields(ln)
		if f[0] == "now" {
			for i in 0..len(f[1]) {
				now = now*10 + i64(f[1][i]-'0')
			}
			continue
		}
		run(f, now) catch err {
			say.Line(f[0], "ERROR", err)
		}
	}
}
