package main

import "lasso"
import "say"

fn show(p str, s str) {
	let re = lasso.Compile(p) catch err {
		say.Line(p, "ERR", err)
		return
	}
	say.Line(p, re.FindAll(s, -1))
}

fn main() {
	show(`a{2}?`, "aaaa")
	show(`a{0}?b`, "ab")
	show(`a{2}?b`, "aab")
	show(`a{2,3}?`, "aaaa")
	show(`a+{2}`, "aaaa")
	show(`a{2}{2}`, "aaaaa")
	show(`a**`, "aa")
	show(`a+?{1,2}`, "aa")
	show(`a{,2}`, "a{{,2}}")
	show(`(a+)?`, "aa")
}
