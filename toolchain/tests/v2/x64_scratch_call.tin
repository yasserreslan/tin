package main

import "say"

// On amd64 a value computed past the temp registers sits in rax, which a call in the other operand overwrites: with nine
// live floats the left side (a ^ (b *% 31)) +% c of the sum was lost across the call to clampi (#811).

fn clampf(x f64) f64 {
	if x != x {
		return 0.5
	}
	if x > 1e12 {
		return 1e12
	}
	if x < -1e12 {
		return -1e12
	}
	return x
}
fn clampi(x f64) i64 {
	let y = clampf(x)
	return i64(y)
}
fn b2i(b bool) i64 {
	if b {
		return 1
	}
	return 0
}
fn h(a i64, b i64, c i64, x f64, y f64, z f64) i64 {
	return (a ^ (b *% 31)) +% c +% clampi(x * 3.0 - y + z)
}

fn run(seed i64) {
	mut i0 = seed *% 3 +% 0
	mut i5 = seed *% 38 +% 5
	mut f0 = f64(seed % 1000) * 0.1 + 0.25
	mut f1 = f64(seed % 1000) * 0.2 + 1.25
	mut f2 = f64(seed % 1000) * 0.3 + 2.25
	mut f3 = f64(seed % 1000) * 0.4 + 3.25
	mut f4 = f64(seed % 1000) * 0.5 + 4.25
	mut f5 = f64(seed % 1000) * 0.6 + 5.25
	mut f6 = f64(seed % 1000) * 0.7 + 6.25
	mut f7 = f64(seed % 1000) * 0.8 + 7.25
	mut f8 = f64(seed % 1000) * 0.9 + 8.25
	mut s1 = make([]i64, 5)
	for q in 0..5 {
		s1[q] = seed +% i64(q * 3)
	}
	s1[3] = i0 | (i5 +% b2i((i5 << u64(i5)) < h(i5, 37, i0, f3, f5, f0)))
	say.Line(i0, i5, f0, f1, f2, f3, f4, f5, f6, f7, f8, s1)
}

fn mix(seed i64) i64 {
	mut a = seed *% 7 +% 3
	mut b = seed *% 11 +% 5
	mut c = seed *% 13 +% 9
	mut f0 = f64(seed % 100) * 0.5 + 0.25
	mut f1 = f64(seed % 100) * 0.25 + 1.5
	mut f2 = f64(seed % 100) * 0.75 + 2.5
	mut f3 = f64(seed % 100) * 0.125 + 3.5
	mut f4 = f64(seed % 100) * 0.5 + 4.5
	mut f5 = f64(seed % 100) * 0.25 + 5.5
	mut f6 = f64(seed % 100) * 0.75 + 6.5
	mut f7 = f64(seed % 100) * 0.125 + 7.5
	mut f8 = f64(seed % 100) * 0.5 + 8.5
	let r = (a << u64(b & 7)) ^ ((b >> u64(c & 3)) +% c) +% h(a, b, c, f2, f4, f6) +% (clampi(f1 + f3) *% 3 +% h(c, a, b, f5, f7, f0)) +% clampi(f8 - f0)
	f0 = f0 + 1.0
	return r +% i64(f0 + f1 + f2 + f3 + f4 + f5 + f6 + f7 + f8)
}

fn main() {
	run(0)
	say.Line(mix(0), mix(1), mix(12345))
}
