package main

import "say"

// On amd64 the element address of s[i] past the fifth temporary was loaded into the register holding s, so s became its own
// data pointer: a slice local kept in a register survives an element access whose index holds a call (#811).

fn clampf(x f64) f64 {
	if x != x {
		return 0.5
	}
	if x > 1e12 {
		return 1e12
	}
	if x < -1e12 {
		return -1e12
	}
	return x
}

fn clampi(x f64) i64 {
	let y = clampf(x)
	return i64(y)
}

fn b2i(b bool) i64 {
	if b {
		return 1
	}
	return 0
}

fn h0(a i64, b i64, c i64, x f64, y f64, z f64) i64 {
	return (((b *% a) & (1 / ((a & 7) + 1))) +% (c +% 0))
}

fn h1(a i64, b i64, c i64, x f64, y f64, z f64) i64 {
	if (x < (f64(c) / (f64(y * y) + 1.5))) {
		return clampi((f64(a) / (f64(x * z) + 1.5)))
	}
	return (((c -% 23) << u64(a & 15)) -% b2i(((b2i((h0(c, b, b, f64(a), x, x) == b)) << u64(a & 15)) >= h0(b, 1000003, b, f64(b), f64(b), x))))
}

fn h2(a i64, b i64, c i64, x f64, y f64, z f64) i64 {
	return ((clampi(f64(c)) -% clampi(f64(a))) / ((((c -% c) +% (a +% a)) & 7) + 1))
}

fn h3(a i64, b i64, c i64, x f64, y f64, z f64) i64 {
	if (f64(((c +% 31) % 1000)) <= (y - z)) {
		return h2((c | c), (b >> u64(b & 15)), clampi(x), f64(((a +% c) % 1000)), f64(z * y), f64(f64(c) * y))
	}
	return h2(((b *% b) *% (c +% a)), (clampi(f64(b)) -% (a +% b)), (clampi(f64(b)) -% h2(1, 1000003, 4611686018427387905, f64(a), z, y)), (f64(((b +% b) % 1000)) / (f64(z * x) + 1.5)), f64((y + f64(b)) * (f64(b) + y)), ((f64(a) + z) - (y + y)))
}

fn h4(a i64, b i64, c i64, x f64, y f64, z f64) i64 {
	return b2i((((z + y) > (z / (f64(x * x) + 1.5))) && (f64(x * f64(b)) <= (f64(b) + f64(a)))))
}

fn fh0(a i64, x f64, y f64) f64 {
	return clampf((f64((x / (f64(x * y) + 1.5)) * (f64(a) + f64(a))) + f64((y + f64(a)) * f64(0.5 * y))))
}

fn fh1(a i64, x f64, y f64) f64 {
	return clampf((3.0 - y))
}





























































fn run46(seed i64) {
	mut i0 = seed *% 3 +% 1
	mut i1 = seed *% 4 +% 8
	mut i2 = seed *% 5 +% 15
	mut i3 = seed *% 6 +% 22
	mut i4 = seed *% 7 +% 29
	mut i5 = seed *% 8 +% 36
	mut i6 = seed *% 9 +% 43
	mut i7 = seed *% 10 +% 50
	mut f0 = f64(f64(seed % 1000) * 0.1) + 0.25
	mut f1 = f64(f64(seed % 1000) * 0.2) + 1.25
	mut f2 = f64(f64(seed % 1000) * 0.3) + 2.25
	mut f3 = f64(f64(seed % 1000) * 0.4) + 3.25
	mut f4 = f64(f64(seed % 1000) * 0.5) + 4.25
	mut f5 = f64(f64(seed % 1000) * 0.6) + 5.25
	mut f6 = f64(f64(seed % 1000) * 0.7) + 6.25
	mut f7 = f64(f64(seed % 1000) * 0.8) + 7.25
	mut f8 = f64(f64(seed % 1000) * 0.9) + 8.25
	mut s = make([]i64, 8)
	for q in 0..8 {
		s[q] = seed +% i64(q * 3)
	}
	s[1 & 7] = b2i((h0(1, s[1 & 7], s[1 & 7], 1.5, 1.5, 1.5) == clampi((f64(s[1 & 7]) + (1.5 - f64(s[i2 & 7]))))))
	say.Line("run46", i0, i1, i2, i3, i4, i5, i6, i7, f0, f1, f2, f3, f4, f5, f6, f7, f8, s)
}

fn main() {
	run46(0)
	run46(7)
	run46(123456789)
}
