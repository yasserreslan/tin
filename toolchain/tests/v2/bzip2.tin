package main

import "fault"
import "say"
import "squash"
import "stamp"

// squash.Bunzip2 (#754): streams made by libbzip2 (Python's bz2, as in toolchain/tests/data/bzip2) decode to their
// bytes; streams back to back decode as one; damaged, cut and foreign inputs fail with Go's compress/bzip2 messages;
// max bounds the output and a bzip2 bomb stays inside a small memory budget. The twin against Go is
// tools/ci/bzip2_check.tin.

const empty = "425a683917724538509000000000"
const one = "425a683131415926535919939b6b00000001002000200021184682ee48a70a120332736d60"
const hello = "425a683931415926535954a49784000002d180001040040644908020003100302068620049d4b21f3f17724538509054a49784"
const unicode = ""

// fib9 is the first 1,000,000 bytes of the Fibonacci word over "ab" at block size 9 (two blocks, the first a full
// 900 kB one), fib1 the first 250,000 at block size 1 (three blocks).
const fib9 = "425a6839314159265359fa12270e029f6d010030002000720a9a09a8d56caa0829b00241ac524ada81b2556d1b55a912810e6282b24ca6b34605795601661c020060004000e04026a32a292566c6cab645b08d6115b4045b45425b51154d8a52aad90524ae2ee48a70a120ae4de56c"
const fib1 = "425a6831314159265359e3652cc4004a9a8100300020005040148c4a0a9b2d889059a844d94a4d82b65a292157314159265359fa8392d7008db5010030002000721009a8d14a49589ad4a5b08ad9022d60242b6255496d2a51073141592653599650bd630006cd810030002000504026a36ca289b492a535a1495b112daa36615150e2ee48a70a121dd8657be0"

fn unhex(h str) str {
	mut b = make([]u8, 0, len(h)/2)
	for i in 0..len(h)/2 {
		b = append(b, u8(nib(h[2*i])<<4 | nib(h[2*i+1])))
	}
	return str(b)
}

fn nib(c u8) i64 {
	if c >= 'a' {
		return i64(c-'a') + 10
	}
	return i64(c - '0')
}

fn repeat(s str, n i64) str {
	mut b = make([]u8, 0, len(s)*n)
	for i in 0..n {
		b = append(b, s...)
	}
	return str(b)
}

// set is s with the byte at off replaced by v.
fn set(s str, off i64, v u8) str {
	mut b = []u8(s)
	b[off] = v
	return str(b)
}

// show prints what a stream decodes to: its length and CRC-32, and the text when it is short.
fn show(label str, data str, max i64) {
	let out = squash.Bunzip2(data, max) catch err {
		say.Line(label, "fault:", err, "| limit:", fault.Is(err, fault.LimitExceeded))
		return
	}
	if len(out) <= 40 {
		say.Line(label, len(out), say.Fmt("%08x", stamp.Crc32(out)), say.Fmt("%q", out))
	} else {
		say.Line(label, len(out), say.Fmt("%08x", stamp.Crc32(out)))
	}
}

fn main() {
	let h = unhex(hello)
	let f9 = unhex(fib9)

	// Whole streams.
	show("empty", unhex(empty), 1 << 20)
	show("one byte", unhex(one), 1 << 20)
	show("hello", h, 1 << 20)
	let u = squash.Bunzip2(unhex(unicode), 1 << 20) catch err {
		say.Line("unicode fault:", err)
		""
	}
	say.Line("unicode", len(u), u[0:55])
	show("fib9", f9, 1 << 30)
	show("fib1", unhex(fib1), 1 << 30)

	// Streams back to back, the block size changing between them.
	show("hello+one+empty", h + unhex(one) + unhex(empty), 1 << 20)
	show("fib1+hello+fib9", unhex(fib1) + h + f9, 1 << 30)

	// Not bzip2, cut short, or damaged.
	show("nothing", "", 1 << 20)
	show("zip", "PK\x03\x04", 1 << 20)
	show("header only", "BZh9", 1 << 20)
	show("not huffman", set(h, 2, 'x'), 1 << 20)
	show("level 0", set(h, 3, '0'), 1 << 20)
	show("cut", h[0:len(h)-1], 1 << 20)
	show("cut in a block", h[0:30], 1 << 20)
	show("block crc", set(h, 10, h[10] ^ 1), 1 << 20)
	show("stream crc", set(h, len(h)-1, h[len(h)-1] ^ 1), 1 << 20)
	show("randomized", set(h, 14, h[14] | 0x80), 1 << 20)
	show("trailing XY", h + "XY", 1 << 20)
	show("trailing B", h + "B", 1 << 20)
	show("trailing BZh", h + "BZh", 1 << 20)
	show("900k block in a 100k stream", set(f9, 3, '1'), 1 << 30)

	// The output bound, and a bomb: 200 copies of fib9 (22 kB, 200 MB of output) inside 32 MiB.
	show("fib9 max 1000000", f9, 1000000)
	show("fib9 max 999999", f9, 999999)
	let bomb = repeat(f9, 200)
	let n = limit memory 32mb {
		let out = try squash.Bunzip2(bomb, 4194304)
		len(out)
	} catch err {
		say.Line("bomb fault:", err, "| limit:", fault.Is(err, fault.LimitExceeded))
		-1
	}
	say.Line("bomb", len(bomb), "bytes in:", n)
	let all = limit memory 64mb {
		let out = try squash.Bunzip2(repeat(f9, 8), 1 << 30)
		len(out)
	} catch err {
		say.Line("8 x fib9 fault:", err)
		-1
	}
	say.Line("8 x fib9 within 64 MiB:", all)
}
