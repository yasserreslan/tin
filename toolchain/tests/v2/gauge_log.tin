package main

// The logarithms and their inverse-hyperbolic relatives, bit for bit (#942), on inputs where Go's arm64 and amd64 results
// agree, so one .out serves every platform. Each line is "name input-bits result-bits". The expected lines are math's
// (checked on darwin/arm64, linux/arm64 and linux/amd64 with the same loops): the subnormal and boundary inputs, where the
// two architectures differ, are in gauge_math and the number_check gauge twin instead.

import "gauge"
import "say"

// hex is the 16 lowercase hex digits of a float's bits.
fn hex(v f64) str {
	let alphabet = "0123456789abcdef"
	let b = gauge.F64bits(v)
	mut out = []u8{}
	for k in 0..16 {
		let shift = u64(4 * (15 - k))
		out = append(out, alphabet[(b>>shift)&15])
	}
	return str(out)
}

// row prints one result with its input.
fn row(name str, x f64, got f64) {
	say.Line(name, hex(x), hex(got))
}

fn main() {
	for x in []f64{2, 10, 0.5, 3, 0.001, 100, 1e300, 1.5, 0.75, 7.25, 123.456, 0.3, 1e-300, 2.5e-100, 1234567.0, 0.125, 1024} {
		row("log", x, gauge.Log(x))
		row("log10", x, gauge.Log10(x))
		row("log1p", x, gauge.Log1p(x))
		row("log1p-neg", -x/(x+1), gauge.Log1p(-x/(x+1)))
		row("asinh", x, gauge.Asinh(x))
		row("acosh", 1+x, gauge.Acosh(1+x))
		row("atanh", x/(x+1), gauge.Atanh(x/(x+1)))
	}
	for x in []f64{-1, 0, gauge.Inf(1), gauge.Inf(-1), gauge.NaN()} {
		row("logspecial", x, gauge.Log(x))
	}
}
