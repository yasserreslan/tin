# Integer-to-f32 conversions round directly in single precision (#732).

[arm64]
CHECK: _signed32:
CHECK: scvtf s[0-9]+, x[0-9]+
CHECK: fcvt d[0-9]+, s[0-9]+
CHECK: _unsigned32:
CHECK: ucvtf s[0-9]+, x[0-9]+
CHECK: fcvt d[0-9]+, s[0-9]+

[amd64]
# The listing opens with a table of every label, so the label names come before any code: they are
# matched first, then each function's code from its label, as div10_asm does.
CHECK: # L1: signed32
CHECK: # L2: unsigned32
CHECK: \nL1:\n
CHECK: cvtsi2ss xmm\w+,r\w+
CHECK: cvtss2sd xmm\w+,xmm\w+
CHECK: \nL2:\n
CHECK: cvtsi2ss xmm\w+,r\w+
CHECK: addss xmm\w+,xmm\w+
CHECK: cvtss2sd xmm\w+,xmm\w+
