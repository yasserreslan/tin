# Integer-to-f32 conversions round directly in single precision (#732).

[arm64]
CHECK: _signed32:
CHECK: scvtf s[0-9]+, x[0-9]+
CHECK: fcvt d[0-9]+, s[0-9]+
CHECK: _unsigned32:
CHECK: ucvtf s[0-9]+, x[0-9]+
CHECK: fcvt d[0-9]+, s[0-9]+

[amd64]
CHECK: # L[0-9]+: signed32
CHECK: cvtsi2ss xmm[0-9]+, r[0-9]+
CHECK: cvtss2sd xmm[0-9]+, xmm[0-9]+
CHECK: # L[0-9]+: unsigned32
CHECK: cvtsi2ss xmm[0-9]+, r[0-9]+
CHECK: addss xmm[0-9]+, xmm[0-9]+
CHECK: cvtss2sd xmm[0-9]+, xmm[0-9]+
