# arm64 fuses x*y + z into fmadd and keeps f64(x*y) + z as a multiply and an add; amd64 never fuses (#814).

[arm64]
CHECK: _fused:
CHECK: fmadd d0, d[0-9]+, d[0-9]+, d[0-9]+
CHECK: _rounded:
CHECK-NOT: fmadd
CHECK: fmul d0, d[0-9]+, d[0-9]+
CHECK: fadd d0, d0, d[0-9]+

[amd64]
CHECK: # L[0-9]+: rounded
CHECK-NOT: vfmadd
CHECK: mulsd xmm1,xmm9
CHECK: addsd xmm0,xmm10
