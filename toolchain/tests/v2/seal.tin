package main

import "say"
import "seal"

fn main() {
	let ins = []str{"", "abc", "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq", say.Fmt("%055d", 1), say.Fmt("%056d", 1), say.Fmt("%064d", 1), say.Fmt("%1000d", 5)}
	for _, s in ins {
		say.Line(len(s), seal.Sha256Hex(s), seal.Hex(seal.Sha1(s)))
	}
	say.Line("hmac", seal.Hex(seal.HmacSha256("Jefe", "what do ya want for nothing?")), seal.Hex(seal.HmacSha256(say.Fmt("%0100d", 3), "msg")))
	let data = []str{"", "f", "fo", "foo", "foob", "fooba", "foobar", "\xff\xfe\x00?>"}
	for _, d in data {
		let b = []u8(d)
		let std = seal.B64(b)
		let url = seal.B64URL(b)
		let (back, e1) = seal.B64Decode(std)
		let (back2, e2) = seal.B64URLDecode(url)
		let hx = seal.Hex(b)
		let (back3, e3) = seal.HexDecode(hx)
		say.Line(say.Fmt("%q", std), say.Fmt("%q", url), hx, str(back) == d, e1 == nil, str(back2) == d, e2 == nil, str(back3) == d, e3 == nil)
	}
	let bad = []str{"Zg=", "Zm9v!", "Zh==", "====", "Zg==Zg=="}
	for _, s in bad {
		let (_, err) = seal.B64Decode(s)
		say.Line("bad64", say.Fmt("%q", s), err != nil)
	}
	let (_, eh) = seal.HexDecode("abc")
	let (_, eh2) = seal.HexDecode("zz")
	say.Line("badhex", eh != nil, eh2 != nil)
	// Go's decoders skip "\r" and "\n" anywhere, so wrapped base64 decodes (#1244).
	for s in []str{"Zm9v\r\nYmFy", "Zm9v\nYg=\n=", "\r\n", "Zg=\r"} {
		let (b, err) = seal.B64Decode(s)
		say.Line(say.Fmt("wrapped64 %q %q %v", s, str(b), err != nil))
	}
	let (wu, ewu) = seal.B64URLDecode("Zm9v\nYmE")
	say.Line(say.Fmt("wrappedurl %q %v", str(wu), ewu != nil))
	say.Line("cteq", seal.ConstantTimeEq([]u8("abc"), []u8("abc")), seal.ConstantTimeEq([]u8("abc"), []u8("abd")), seal.ConstantTimeEq([]u8("a"), []u8("ab")))
	let r1 = seal.RandomBytes(32)
	let r2 = seal.RandomBytes(32)
	say.Line("random", len(r1), seal.ConstantTimeEq(r1, r2))
}
