package main

import "image"
import "image/color"
import "image/jpeg"
import "seal"
import "say"

// decodeHex decodes a hex-encoded JPEG.
fn decodeHex(s str) !dyn image.Image {
	let data = try seal.HexDecode(s)
	let img = try jpeg.Decode(str(data))
	return img
}

// rejects reports whether a hex-encoded JPEG fails to decode.
fn rejects(s str) bool {
	let img = decodeHex(s) catch _ { return true }
	let _ = img
	return false
}

// sameImage reports whether two decoded images have the same bounds and NRGBA64 pixels.
fn sameImage(a dyn image.Image, b dyn image.Image) bool {
	if a.Bounds() != b.Bounds() { return false }
	let pa = image.AsNRGBA64(a)
	let pb = image.AsNRGBA64(b)
	if pa == nil || pb == nil { return false }
	let r = a.Bounds()
	for y in r.Min.Y..r.Max.Y {
		for x in r.Min.X..r.Max.X {
			if pa.NRGBA64At(x, y) != pb.NRGBA64At(x, y) { return false }
		}
	}
	return true
}

// pattern is the 9x7 test colour at (x, y), shared by the round-trip checks.
fn pattern(x i64, y i64) color.RGBA {
	return color.RGBA{R: u8(x*29%256), G: u8(y*37%256), B: u8((x+y)*17%256), A: 255}
}

// roundTripWorst encodes the 9x7 pattern at a quality and returns the largest 8-bit channel error after decoding, or -1.
fn roundTripWorst(quality i64) i64 {
	mut src = image.NewRGBA(image.Rect(0, 0, 9, 7))
	for y in 0..7 {
		for x in 0..9 {
			src.SetRGBA(x, y, pattern(x, y))
		}
	}
	let decoded = jpeg.Decode(jpeg.Encode(src, quality)) catch _ { return -1 }
	let pixels = image.AsNRGBA64(decoded)
	if pixels == nil { return -1 }
	mut worst = i64(0)
	for y in 0..7 {
		for x in 0..9 {
			let got = pixels.NRGBA64At(x, y)
			let want = pattern(x, y)
			for d in []i64{i64(got.R>>8)-i64(want.R), i64(got.G>>8)-i64(want.G), i64(got.B>>8)-i64(want.B)} {
				let a = max(d, -d)
				if a > worst { worst = a }
			}
		}
	}
	return worst
}


fn main() {
	let encoded = seal.HexDecode("") catch err {
		say.Line("hex fault", err)
		return
	}
	let img = jpeg.Decode(str(encoded)) catch err {
		say.Line("jpeg decode fault", err)
		return
	}
	let bounds = img.Bounds()
	let pixels = image.AsNRGBA64(img)
	if pixels == nil { panic("JPEG image type mismatch") }
	if bounds.Dx() != 1 || bounds.Dy() != 1 || pixels.NRGBA64At(0, 0).R >> 8 > 4 {
		panic("JPEG baseline pixel mismatch")
	}
	say.Line("jpeg baseline decode 1x1")
	let gray = image.NewGray(image.Rect(0, 0, 1, 1))
	gray.SetGray(0, 0, color.Gray{Y: 127})
	let qualities = []i64{1, 25, 50, 75, 90, 100}
	for quality in qualities {
		let grayJpeg = jpeg.Encode(gray, quality)
		let grayRoundTrip = jpeg.Decode(grayJpeg) catch err {
			say.Line("jpeg gray encode fault", err)
			return
		}
		if grayRoundTrip.Bounds().Dx() != 1 || grayRoundTrip.Bounds().Dy() != 1 { panic("JPEG gray encode bounds mismatch") }
	}
	say.Line("jpeg encode gray 1x1")
	let rgba = image.NewRGBA(image.Rect(0, 0, 1, 1))
	rgba.SetRGBA(0, 0, color.RGBA{R: 90, G: 140, B: 210, A: 255})
	for quality in qualities {
		let colorJpeg = jpeg.Encode(rgba, quality)
		let colorRoundTrip = jpeg.Decode(colorJpeg) catch err {
			say.Line("jpeg color encode fault", err)
			return
		}
		if colorRoundTrip.Bounds().Dx() != 1 || colorRoundTrip.Bounds().Dy() != 1 { panic("JPEG color encode bounds mismatch") }
	}
	say.Line("jpeg encode color 1x1")
	// Progressive scans carry the coefficients of their baseline twins, so the same image must come out.
	let colorBase = decodeHex("") catch err {
		say.Line("jpeg color twin fault", err)
		return
	}
	let colorProgressive = decodeHex("") catch err {
		say.Line("jpeg progressive fault", err)
		return
	}
	if !sameImage(colorBase, colorProgressive) { panic("progressive color scans differ from the baseline twin") }
	say.Line("jpeg progressive color with restarts matches its baseline twin")
	let grayBase = decodeHex("") catch err {
		say.Line("jpeg gray twin fault", err)
		return
	}
	let grayProgressive = decodeHex("") catch err {
		say.Line("jpeg progressive gray fault", err)
		return
	}
	if !sameImage(grayBase, grayProgressive) { panic("progressive gray scans differ from the baseline twin") }
	say.Line("jpeg progressive gray matches its baseline twin")
	if sameImage(colorBase, grayBase) { panic("distinct images compare equal") }
	let cut = ""
	if !rejects(cut[:len(cut)/4*2]) { panic("truncated progressive JPEG accepted") }
	say.Line("truncated progressive JPEG rejected")
	let worst100 = roundTripWorst(100)
	let worst90 = roundTripWorst(90)
	if worst100 < 0 || worst90 < 0 || worst100 > 2 || worst90 > 12 { panic("JPEG round trip error above bound") }
	say.Line("jpeg round trip 9x7 within 2 at quality 100 and 12 at quality 90")
	let decoded = jpeg.Decode("bad") catch err {
		say.Line("jpeg baseline fault", err)
		return
	}
	let _ = decoded
	panic("invalid JPEG accepted")
}
