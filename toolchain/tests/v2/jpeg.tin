package main

import "image"
import "image/color"
import "image/jpeg"
import "seal"
import "say"

fn main() {
	let encoded = seal.HexDecode("") catch err {
		say.Line("hex fault", err)
		return
	}
	let img = jpeg.Decode(str(encoded)) catch err {
		say.Line("jpeg decode fault", err)
		return
	}
	let bounds = img.Bounds()
	let pixels = image.AsNRGBA64(img)
	if pixels == nil { panic("JPEG image type mismatch") }
	if bounds.Dx() != 1 || bounds.Dy() != 1 || pixels.NRGBA64At(0, 0).R >> 8 > 4 {
		panic("JPEG baseline pixel mismatch")
	}
	say.Line("jpeg baseline decode 1x1")
	let gray = image.NewGray(image.Rect(0, 0, 1, 1))
	gray.SetGray(0, 0, color.Gray{Y: 127})
	let qualities = []i64{1, 25, 50, 75, 90, 100}
	for quality in qualities {
		let grayJpeg = jpeg.Encode(gray, quality)
		let grayRoundTrip = jpeg.Decode(grayJpeg) catch err {
			say.Line("jpeg gray encode fault", err)
			return
		}
		if grayRoundTrip.Bounds().Dx() != 1 || grayRoundTrip.Bounds().Dy() != 1 { panic("JPEG gray encode bounds mismatch") }
	}
	say.Line("jpeg encode gray 1x1")
	let rgba = image.NewRGBA(image.Rect(0, 0, 1, 1))
	rgba.SetRGBA(0, 0, color.RGBA{R: 90, G: 140, B: 210, A: 255})
	for quality in qualities {
		let colorJpeg = jpeg.Encode(rgba, quality)
		let colorRoundTrip = jpeg.Decode(colorJpeg) catch err {
			say.Line("jpeg color encode fault", err)
			return
		}
		if colorRoundTrip.Bounds().Dx() != 1 || colorRoundTrip.Bounds().Dy() != 1 { panic("JPEG color encode bounds mismatch") }
	}
	say.Line("jpeg encode color 1x1")
	let decoded = jpeg.Decode("bad") catch err {
		say.Line("jpeg baseline fault", err)
		return
	}
	let _ = decoded
	panic("invalid JPEG accepted")
}
