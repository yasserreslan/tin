package main

import "say"

// #643: float map keys compare with ==, as in Go (bench/ref/map_float_keys is the twin): +0
// and -0 are one key, and a NaN equals no key, itself included, so each NaN stored is a new
// entry and none is ever found or deleted. Struct keys with float fields follow the same rule,
// and a map past 4096 entries (chunked) too.

type P struct {
	x f64
	n i64
}

fn main() {
	let z = 0.0
	let nz = -z
	say.Line(z == nz, nz)
	mut m = map[f64]str{}
	m[nz] = "neg"
	m[z] = "pos"
	say.Line(len(m), m[0.0], m[nz])
	let nan = z / z
	m[nan] = "nan"
	say.Line(nan == nan, len(m), m[nan])
	m[nan] = "nan2"
	say.Line(len(m))
	let (v, ok) = m[nan]
	say.Line(v == "", ok)
	delete(m, nan)
	delete(m, nz)
	say.Line(len(m))
	mut sm = map[P]i64{}
	sm[P{x: -0.0, n: 1}] = 1
	sm[P{x: 0.0, n: 1}] = 2
	sm[P{x: nan, n: 1}] = 3
	sm[P{x: nan, n: 1}] = 4
	let (w, found) = sm[P{x: nan, n: 1}]
	say.Line(len(sm), sm[P{x: 0.0, n: 1}], w, found)
	mut cnt = 0
	for k, val in sm {
		cnt += val
	}
	say.Line(cnt)
	mut big = map[f64]i64{}
	for i in 0..10000 {
		big[f64(i) * -1.0] = i
	}
	say.Line(len(big), big[0.0], big[-0.0], big[-9999.0])
}
