package main

import "gauge"
import "mint"
import "say"

fn main() {
	for _, s in []str{"-0", "5e-324", "2.2250738585072012e-308", "2.2250738585072014e-308", "1.7976931348623158e308", "9007199254740993", "0x1.00000000000008p0", "0x1.0000000000000801p0"} {
		let x = mint.ParseFloat(s) catch err { panic(err) }
		say.Line("bits", s, gauge.F64bits(x))
	}
	// Literal parsing uses the same exact core in the compiler at every bootstrap stage.
	say.Line("literals", gauge.F64bits(5e-324), gauge.F64bits(2.2250738585072012e-308), gauge.F64bits(1.00000000000000011102230246251565404236316680908203125))
	for _, x in []f64{0.125, 0.375, 2.5, -2.5, 9.99999, 1e-100, 1e100} {
		say.Line("round", mint.FormatFloat(x, 'f', 2), mint.FormatFloat(x, 'e', 0), mint.FormatFloat(x, 'G', 3))
		say.Line("flags", say.Fmt("%+012.2f|%-12.2f|%+.6e", x, x, x))
	}
	say.Line("precision", mint.FormatFloat(0.1, 'f', 40))
	say.Line("f32", f32(1.4e-45), f32(1.17549435e-38), f32(3.4028235e38), f32(1)/3)
}
