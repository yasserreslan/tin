package main

// A range over a map produces every entry that was there when it started and is not deleted,
// exactly once, even when its body inserts enough to make the map grow and the grow drops
// deleted entries (#1224). Entries added during the range may or may not be produced.

import "say"

// sweep makes a map of n keys, deletes those with k % drop != 0 (none when drop is 1), and
// ranges over it. Every every-th step inserts add new keys; with delCur the body also deletes
// the key it is on. It prints how many of the keys that should be produced were missed or
// produced twice, and whether any deleted key came back.
fn sweep(name str, n i64, drop i64, every i64, add i64, delCur bool) {
	mut m = make(map[i64]i64)
	for i in 0..n {
		m[i] = i * 3
	}
	for i in 0..n {
		if i%drop != 0 {
			delete(m, i)
		}
	}
	mut seen = make(map[i64]i64)
	mut next = 1000000000
	mut step = 0
	mut bad = 0
	for k, v in m {
		if k < n {
			seen[k] += 1
			if v != k*3 || k%drop != 0 {
				bad += 1
			}
		}
		if delCur {
			delete(m, k)
		}
		if step%every == 0 {
			for a in 0..add {
				m[next] = 0
				next += 1
			}
		}
		step += 1
	}
	mut missed = 0
	mut twice = 0
	for i in 0..n {
		if i%drop == 0 {
			let c = seen[i]
			if c == 0 {
				missed += 1
			} else if c > 1 {
				twice += 1
			}
		}
	}
	say.Line(name, "missed", missed, "twice", twice, "bad", bad)
}

// churn ranges part of a map, stops, and then inserts and deletes many keys: the entries the
// abandoned range passed are kept in place only until a range reaches the end again, and the
// map stays correct throughout.
fn churn() {
	mut m = make(map[i64]i64)
	for i in 0..1000 {
		m[i] = i
	}
	for i in 0..500 {
		delete(m, i)
	}
	mut c = 0
	for k, _ in m {
		c += 1
		if c == 10 {
			break
		}
		_ = k
	}
	for r in 0..200000 {
		m[2000+r] = r
		delete(m, 2000+r-50)
	}
	mut sum = 0
	mut cnt = 0
	for k, v in m {
		sum += v
		cnt += 1
		_ = k
	}
	say.Line("churn len", len(m), "range", cnt, "sum", sum)
}

fn main() {
	// The issue's example: the odd keys of 100, five inserts per step.
	sweep("flat", 100, 2, 1, 5, false)
	sweep("flat delete current", 100, 2, 1, 5, true)
	sweep("flat no deletes", 300, 1, 7, 40, false)
	// Into a chunked map (past 4096 entries) during the range.
	sweep("convert", 3000, 3, 1, 4, false)
	// A chunked map that rebuilds because most of its entries are dead.
	sweep("rebuild", 20000, 4, 1, 3, false)
	sweep("rebuild delete current", 20000, 4, 2, 9, true)
	sweep("chunked grows", 9000, 1, 1, 2, false)
	churn()
}
