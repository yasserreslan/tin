package main

import "say"
import "flume"
import "quarry"

fn write_file(path str, content str) ! {
	let w = try flume.Create(path)
	w.Str(content)
	return try w.Close()
}

fn main() {
	let path = "/tmp/tin-test-flume_test-{quarry.Pid()}.txt"
	let long = say.Fmt("%0100000d", 42)
	let err = write_file(path, "alpha\nbeta\r\n\ngamma\n" + long + "\nlast line no newline")
	say.Line("write", err == nil)
	let (r, e1) = flume.Open(path)
	say.Line("open", e1 == nil)
	mut n = 0
	for {
		let (line, ok, e2) = r.Line()
		if e2 != nil {
			say.Line("error", e2)
			break
		}
		if !ok {
			break
		}
		if len(line) > 50 {
			say.Line(n, "long", len(line), line[len(line)-2:])
		} else {
			say.Line(n, say.Fmt("%q", line))
		}
		n += 1
	}
	r.Close()
	let (all, e3) = flume.ReadFile(path)
	say.Line("readall", len(all), e3 == nil, all[:5])
	let r2 = flume.Open(path) catch err {
		say.Line(err)
		return
	}
	let (c1, ok1) = r2.Byte()
	let (c2, ok2) = r2.Byte()
	let rest = r2.ReadAll() catch err {
		say.Line(err)
		return
	}
	say.Line("bytes", str(c1), ok1, str(c2), ok2, len(rest))
	let (_, ok3) = r2.Byte()
	say.Line("eof byte", ok3)
	r2.Close()
	// Read is the io.Reader shape (ledger.NewStream): short buffers, all bytes, 0 at the end.
	let r4 = flume.Open(path) catch err {
		say.Line(err)
		return
	}
	mut buf = make([]u8, 7)
	mut nobuf = make([]u8, 0)
	mut chunks = 0
	mut total = 0
	mut sum = 0
	for {
		let k = r4.Read(mut buf) catch err {
			say.Line("read fault", err)
			return
		}
		if k == 0 {
			break
		}
		chunks += 1
		total += k
		for i in 0..k {
			sum = (sum * 31 + i64(buf[i]) + 1) % 1000003
		}
	}
	let zero = r4.Read(mut nobuf) catch err {
		say.Line("zero fault", err)
		return
	}
	r4.Close()
	say.Line("read", chunks > 0, total, sum, zero)
	let (_, e4) = flume.Open("/tmp/tin-test-no/such/file")
	say.Line("missing", e4)
	let empty = "/tmp/tin-test-flume_empty-{quarry.Pid()}.txt"
	let ee = write_file(empty, "")
	let r3 = flume.Open(empty) catch err {
		say.Line(err)
		return
	}
	let (_, ok4) = r3.Line() catch err {
		say.Line(err)
		return
	}
	say.Line("empty", ee == nil, ok4)
	r3.Close()
	let w = flume.Stdout()
	w.Str("stdout ")
	w.Int(-77)
	w.Line("!")
	say.Line("flush", w.Flush() == nil)
	quarry.Remove(path) catch _ {
	}
	quarry.Remove(empty) catch _ {
	}
}
