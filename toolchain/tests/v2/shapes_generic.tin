package main

import "constraints"
import "io"
import "say"

// Generic shapes (roadmap #141, "shape embedding and composition; shapes with generic
// parameters"): a shape instance as a constraint, an instance in a composition, a
// generic type's instance satisfying one, and the library's composed io.ReadWriteCloser
// satisfied by a type here.

shape Seq[T constraints.Any] { Next() ?T }

type Ints struct { n i64 }

fn (x Ints) Next() ?Ints {
	return nil
}

type Stack[T constraints.Any] struct { xs []T }

fn (s Stack[T]) Next() ?Stack[T] {
	return nil
}

type File struct { n i64 }

fn (f File) Read(buf mut []u8) !i64 {
	return 0
}

fn (f File) Write(data []u8) !i64 {
	return len(data)
}

fn (f File) Close() !i64 {
	return 0
}

// A shape instance as a constraint.
fn Drain[S Seq[Ints]](s S) i64 {
	return 1
}

// A composition that lists an instance of a generic shape.
shape Streams { Seq[Stack[i64]] }

fn Use[X Streams](x X) i64 {
	return 2
}

// The library's io.ReadWriteCloser (Reader, Writer and Closer), satisfied by File.
fn Wrap[RW io.ReadWriteCloser](rw RW) i64 {
	let n = rw.Read(mut make([]u8, 1)) catch _ { -1 }
	let m = rw.Write([]u8{1}) catch _ { -1 }
	let c = rw.Close() catch _ { -1 }
	return n + m + c
}

// A generic shape whose body lists another generic shape with its own parameter.
shape Getter[T constraints.Any] { Get() T }

shape PairGetter[U constraints.Any] { Getter[U] }

type Seven struct { n i64 }

fn (s Seven) Get() i64 {
	return 7
}

fn Pair[G PairGetter[i64]](g G) i64 {
	return g.Get()
}

// A later constraint may mention an earlier parameter: T is inferred from x.
fn Pick[T constraints.Any, S Seq[T]](s S, x T) i64 {
	return 1
}

// A generic shape whose listed instance has a constrained parameter: the constraint is
// checked at the instantiation, not at the declaration.
shape Limited[T i64 | str] { Get() T }

shape LimitedGetter[U constraints.Any] { Limited[U] }

// A generic shape with a map keyed by its parameter (a placeholder must be a valid key).
shape Indexed[T constraints.Any] { Lookup(m map[T]i64) i64 }

type Table struct { n i64 }

fn (t Table) Lookup(m map[str]i64) i64 {
	return 3
}

type Num struct { n i64 }

fn (n Num) Get() i64 {
	return 4
}

// A generic named union.
shape NumberOr[T constraints.Any] = i64 | T

fn Numbered[S NumberOr[Seven]](s S) i64 {
	return 2
}

// The constrained composition and the map-key shape, instantiated.
fn Limited[S LimitedGetter[i64]](s S) i64 {
	return 3
}

fn Lookup[S Indexed[str]](s S) i64 {
	return 4
}

fn main() {
	let x = Ints{n: 1}
	say.Line("seq: {Drain(x)}")
	let st = Stack[i64]{xs: []i64{}}
	say.Line("streams: {Use(st)}")
	let f = File{n: 1}
	say.Line("rwc: {Wrap(f)}")
	let s = Seven{n: 0}
	say.Line("pair: {Pair(s)}")
	say.Line("pick: {Pick(x, x)}")
	say.Line("limited: {Numbered(s)}")
	let n = Num{n: 0}
	say.Line("constraint: {Limited(n)}")
	let t = Table{n: 0}
	say.Line("lookup: {Lookup(t)}")
}
