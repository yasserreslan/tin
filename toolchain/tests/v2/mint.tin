package main

import "say"
import "mint"

fn pi(label str, v i64, err fault) {
	say.Line(label, v, err != nil)
}

fn pu(label str, v u64, err fault) {
	say.Line(label, v, err != nil)
}

fn pf(label str, v f64, err fault) {
	say.Line(label, v, err != nil)
}

fn pb(label str, v bool, err fault) {
	say.Line(label, v, err != nil)
}

fn ps(label str, v str, err fault) {
	say.Line(label, say.Fmt("%q", v), err != nil)
}

fn main() {
	say.Line("itoa", mint.Itoa(0), mint.Itoa(-5), mint.Itoa(9223372036854775807), mint.Itoa(-9223372036854775807-1))
	say.Line("formatint", mint.FormatInt(255, 2), mint.FormatInt(255, 16), mint.FormatInt(-255, 16), mint.FormatInt(123456789, 36))
	say.Line("formatuint", mint.FormatUint(18446744073709551615, 16), mint.FormatUint(18446744073709551615, 10))
	let ins = []str{"123", "-0", "+5", "9223372036854775807", "9223372036854775808", "-9223372036854775808", "abc", "", "12a", " 1"}
	for _, s in ins {
		let (v, err) = mint.Atoi(s)
		pi(say.Fmt("atoi %q", s), v, err)
	}
	let bases = []str{"0x1f", "-0b101", "0o17", "017", "1_000", "0x_1F", "zz"}
	for _, s in bases {
		let (v, err) = mint.ParseInt(s, 0)
		pi(say.Fmt("parseint0 %q", s), v, err)
	}
	let (v36, e36) = mint.ParseInt("zz", 36)
	pi("parseint36 zz", v36, e36)
	let (v16, e16) = mint.ParseInt("-FF", 16)
	pi("parseint16 -FF", v16, e16)
	let (u1, eu1) = mint.ParseUint("18446744073709551615", 10)
	pu("parseuint max", u1, eu1)
	let (u2, eu2) = mint.ParseUint("18446744073709551616", 10)
	pu("parseuint over", u2, eu2)
	let (u3, eu3) = mint.ParseUint("-1", 10)
	pu("parseuint neg", u3, eu3)
	let bools = []str{"true", "T", "1", "0", "FALSE", "x", ""}
	for _, s in bools {
		let (b, err) = mint.ParseBool(s)
		pb(say.Fmt("parsebool %q", s), b, err)
	}
	let floats = []str{"3.25", "-0.5", "1e10", "1e400", "-1e400", "0x1p-2", "1e", "", "inf", "+Inf", "1_000.5", ".5", "5."}
	for _, s in floats {
		let (f, err) = mint.ParseFloat(s)
		pf(say.Fmt("parsefloat %q", s), f, err)
	}
	say.Line("formatfloat", mint.FormatFloat(3.14159, 'f', 2), mint.FormatFloat(3.14159, 'e', 3), mint.FormatFloat(3.14159, 'g', -1))
	say.Line("formatfloat2", mint.FormatFloat(1e21, 'g', -1), mint.FormatFloat(-0.0001234, 'g', 3), mint.FormatFloat(100, 'f', -1), mint.FormatFloat(0.1, 'e', -1))
	// 'b' and 'x' as Go writes them (#718).
	say.Line("formatfloat bx", mint.FormatFloat(1.5, 'b', -1), mint.FormatFloat(0.0, 'b', -1), mint.FormatFloat(-0.1, 'x', -1), mint.FormatFloat(1.0, 'X', 3), mint.FormatFloat(1.96875, 'x', 1), mint.FormatFloat(5e-324, 'x', -1), mint.FormatFloat(1.5, 'q', -1))
	say.Line("quote", mint.Quote("hi\n\"x\" é\x01\\"), mint.QuoteRune('☺'), mint.QuoteRune('\''))
	let uqs = []str{"\"a\\tb\"", "'x'", "`raw\\n`", "\"bad", "\"\\u00e9\\x41\"", "'ab'", "\"\\q\""}
	for _, s in uqs {
		let (u, err) = mint.Unquote(s)
		ps(say.Fmt("unquote %s", s), u, err)
	}
	mut b = make([]u8, 0)
	b = mint.AppendInt(mut b, -42)
	b = mint.AppendQuote(mut b, "q")
	say.Line("append", str(b))
}
