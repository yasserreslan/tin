package main

import "say"

// A kept closure that captured a value struct wider than a word read garbage (#669): with no
// reference among its captures it got no generated keeper, and the runtime's copy moved one
// word of each cell. Its cells are now copied whole, here 24 bytes.

type P value struct {
	x i64
	y i64
	z i64
}

mut saved fn() i64 = fn() i64 {
	return 0
}

fn build(n i64) {
	let p = P{x: n, y: n * 2, z: n * 3}
	saved = keep(fn() i64 {
		return p.x + p.y + p.z
	})
}

fn main() {
	build(5)
	let junk = []i64{1, 2, 3, 4, 5, 6, 7, 8}
	say.Line(saved(), len(junk))
}
