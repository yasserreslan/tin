package main
import "say"
type Box struct { Items []str
	X i64 }
fn put(b mut Box, s str) { b.Items = append(b.Items, s)
	b.X += 1 }
fn twice(f fn(mut Box, str), b mut Box) { f(mut b, "a")
	f(mut b, say.Fmt("%d", 2)) }
fn main() {
	let f = put
	let b = Box{Items: []str{}}
	f(mut b, "x")
	twice(put, mut b)
	println(len(b.Items), b.X, b.Items[2])
}
