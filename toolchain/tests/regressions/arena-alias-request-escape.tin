package main

type W struct {
	n i64
	xs []i64
}

mut gw = W{xs: []i64{0}}

// An arena's store through the alias of a mut parameter is checked at the call, as the same store outside an arena is (#707).
fn fill(v []i64, w mut W) {
	let live = w
	arena {
		live.xs = v
	}
}

fn main() {
	fill([]i64{1, 2}, mut gw)
}
