package main

import "say"

// The main thread recursing through a 64 KiB frame (8000 locals, all live at once): the
// prologue touches each page on the way down, so the overflow meets the guard below the
// main stack and is reported as a stack overflow, not a fault somewhere else (#570). The
// task case is large-frame-task-overflow.tin.

