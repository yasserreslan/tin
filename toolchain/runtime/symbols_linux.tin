// Linker-emitted [count, start/end/name records] uses image-relative addresses.
fn rt_symbol_lookup(addr i64, info i64) i64 {
	let base = __image_base()
	let table = __tin_symbols()
	let pc = addr-base
	for i in i64(0)..table[0] {
		let rec = table+8+24*i
		if pc >= rec[0] && pc < rec[1] { info[2] = base+rec[2]
			return 1 }
	}
	info[2] = 0
	return 0
}
