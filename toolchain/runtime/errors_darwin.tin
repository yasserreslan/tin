// Stable Darwin errno messages; libSystem owns newer codes that vary by OS release.
extern fn strerror(e i64) i64
fn rt_os_error(e i64) str {
	match e {
		0 => { return "Undefined error: 0"
		}
		1 => { return "Operation not permitted"
		}
		2 => { return "No such file or directory"
		}
		3 => { return "No such process"
		}
		4 => { return "Interrupted system call"
		}
		5 => { return "Input/output error"
		}
		6 => { return "Device not configured"
		}
		7 => { return "Argument list too long"
		}
		8 => { return "Exec format error"
		}
		9 => { return "Bad file descriptor"
		}
		10 => { return "No child processes"
		}
		11 => { return "Resource deadlock avoided"
		}
		12 => { return "Cannot allocate memory"
		}
		13 => { return "Permission denied"
		}
		14 => { return "Bad address"
		}
		15 => { return "Block device required"
		}
		16 => { return "Resource busy"
		}
		17 => { return "File exists"
		}
		18 => { return "Cross-device link"
		}
		19 => { return "Operation not supported by device"
		}
		20 => { return "Not a directory"
		}
		21 => { return "Is a directory"
		}
		22 => { return "Invalid argument"
		}
		23 => { return "Too many open files in system"
		}
		24 => { return "Too many open files"
		}
		25 => { return "Inappropriate ioctl for device"
		}
		26 => { return "Text file busy"
		}
		27 => { return "File too large"
		}
		28 => { return "No space left on device"
		}
		29 => { return "Illegal seek"
		}
		30 => { return "Read-only file system"
		}
		31 => { return "Too many links"
		}
		32 => { return "Broken pipe"
		}
		33 => { return "Numerical argument out of domain"
		}
		34 => { return "Result too large"
		}
		35 => { return "Resource temporarily unavailable"
		}
		36 => { return "Operation now in progress"
		}
		37 => { return "Operation already in progress"
		}
		38 => { return "Socket operation on non-socket"
		}
		39 => { return "Destination address required"
		}
		40 => { return "Message too long"
		}
		41 => { return "Protocol wrong type for socket"
		}
		42 => { return "Protocol not available"
		}
		43 => { return "Protocol not supported"
		}
		44 => { return "Socket type not supported"
		}
		45 => { return "Operation not supported"
		}
		46 => { return "Protocol family not supported"
		}
		47 => { return "Address family not supported by protocol family"
		}
		48 => { return "Address already in use"
		}
		49 => { return "Can't assign requested address"
		}
		50 => { return "Network is down"
		}
		51 => { return "Network is unreachable"
		}
		52 => { return "Network dropped connection on reset"
		}
		53 => { return "Software caused connection abort"
		}
		54 => { return "Connection reset by peer"
		}
		55 => { return "No buffer space available"
		}
		56 => { return "Socket is already connected"
		}
		57 => { return "Socket is not connected"
		}
		58 => { return "Can't send after socket shutdown"
		}
		59 => { return "Too many references: can't splice"
		}
		60 => { return "Operation timed out"
		}
		61 => { return "Connection refused"
		}
		62 => { return "Too many levels of symbolic links"
		}
		63 => { return "File name too long"
		}
		64 => { return "Host is down"
		}
		65 => { return "No route to host"
		}
		66 => { return "Directory not empty"
		}
		67 => { return "Too many processes"
		}
		68 => { return "Too many users"
		}
		69 => { return "Disc quota exceeded"
		}
		70 => { return "Stale NFS file handle"
		}
		71 => { return "Too many levels of remote in path"
		}
		72 => { return "RPC struct is bad"
		}
		73 => { return "RPC version wrong"
		}
		74 => { return "RPC prog. not avail"
		}
		75 => { return "Program version wrong"
		}
		76 => { return "Bad procedure for program"
		}
		77 => { return "No locks available"
		}
		78 => { return "Function not implemented"
		}
		79 => { return "Inappropriate file type or format"
		}
		80 => { return "Authentication error"
		}
		81 => { return "Need authenticator"
		}
		82 => { return "Device power is off"
		}
		83 => { return "Device error"
		}
		84 => { return "Value too large to be stored in data type"
		}
		85 => { return "Bad executable (or shared library)"
		}
		86 => { return "Bad CPU type in executable"
		}
		87 => { return "Shared library version mismatch"
		}
		88 => { return "Malformed Mach-o file"
		}
		89 => { return "Operation canceled"
		}
		90 => { return "Identifier removed"
		}
		91 => { return "No message of desired type"
		}
		92 => { return "Illegal byte sequence"
		}
		93 => { return "Attribute not found"
		}
		94 => { return "Bad message"
		}
		95 => { return "EMULTIHOP (Reserved)"
		}
		96 => { return "No message available on STREAM"
		}
		97 => { return "ENOLINK (Reserved)"
		}
		98 => { return "No STREAM resources"
		}
		99 => { return "Not a STREAM"
		}
		100 => { return "Protocol error"
		}
		101 => { return "STREAM ioctl timeout"
		}
		102 => { return "Operation not supported on socket"
		}
		103 => { return "Policy not found"
		}
		104 => { return "State not recoverable"
		}
		105 => { return "Previous owner died"
		}
		106 => { return "Interface output queue is full"
		}
	}
	let p = strerror(e)
	return rt_str_from_raw(p, strlen(p))
}
