// Per-core workspace keeps number conversion allocation-free after its first use.
mut numberScratch i64

fn rt_number_scratch() i64 {
	if numberScratch == 0 {
		numberScratch = rt_ingot_alloc(4096)
	}
	return numberScratch
}

// rt_parse_float parses a NUL-terminated number with a correctly rounded result.
fn rt_parse_float(p i64, end i64) f64 {
	return cast(f64, num_parse_bits(p, rt_number_scratch(), end))
}

// rt_number_format writes a precision-controlled float to a caller-owned buffer.
fn rt_number_format(p i64, x f64, verb i64, prec i64) i64 {
	return num_format(cast(i64, x), p, verb, prec, rt_number_scratch())
}

fn rt_number_short(x f64, digits i64, bit32 bool) i64 {
	let a = rt_number_scratch()
	num_shortest(cast(i64, x), a, i64(bit32))
	fast_exp = a[1] - 1
	for i in 0..a[0] {
		store8(digits+i, i64(load8(a+40+i)))
	}
	return a[0]
}

// rt_decimal_integer parses the whitespace/sign/prefix behavior used by atoi.
fn rt_decimal_integer(p i64) i64 {
	for load8(p) == ' ' || load8(p) >= 9 && load8(p) <= 13 {
		p += 1
	}
	mut sign = i64(1)
	if load8(p) == '+' || load8(p) == '-' {
		if load8(p) == '-' { sign = -1 }
		p += 1
	}
	mut n = i64(0)
	for load8(p) >= '0' && load8(p) <= '9' {
		n = n*10 + i64(load8(p)) - '0'
		p += 1
	}
	return i64(i32(n*sign))
}

// rt_i64str formats a signed decimal integer without entering the formatter.
fn rt_i64str(v i64) str {
	let b = rt_alloc(32)
	mut n = i64(0)
	let neg = v < 0
	for {
		mut d = v%10
		if d < 0 { d = -d }
		store8(b+n, '0'+d)
		n += 1
		v /= 10
		if v == 0 { break }
	}
	if neg { store8(b+n, '-')
		n += 1 }
	for i in 0..n/2 {
		let d = load8(b+i)
		store8(b+i, i64(load8(b+n-1-i)))
		store8(b+n-1-i, i64(d))
	}
	return rt_str_from_raw(b, n)
}
