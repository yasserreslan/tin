// A window the system calls into, as Zed's does: the view and the delegate are Objective-C classes defined here, so AppKit
// delivers key and mouse events, menu choices and the close request as calls to Tin functions (the callbacks below), not as
// something the program has to look for. The window's contents are drawn on the GPU (metal).
//
// The callbacks only write down what happened, as numbers in a queue. The program's state lives in the plain variables of
// main, where the compiler can prove every store safe (a global would need keep() on each one); main takes the entries off
// the queue with Next and acts on them, between frames. Pump waits for AppKit's next event and lets it call the callbacks.
package gpuwin

import "appkit"
import "metal"

// What an entry of the queue is: an event (the payload is its NSEvent, kept until Release), a menu choice (the item's tag), a
// request to close the window or quit.
const KindEvent = 1
const KindCommand = 2
const KindQuit = 3

mut queue = []i64{}
mut head i64
mut gpu = metal.Gpu{}

fn push(kind i64, payload i64) {
	queue = append(queue, kind, payload)
}

// Next takes the oldest entry off the queue: its kind and payload, or kind 0 when the queue is empty.
fn Next() (i64, i64) {
	if head >= len(queue) {
		if head > 0 {
			queue = queue[0:0]
			head = 0
		}
		return 0, 0
	}
	let kind = queue[head]
	let payload = queue[head + 1]
	head += 2
	return kind, payload
}

// Release lets go of an event Next returned.
fn Release(e i64) {
	appkit.Send(e, "release")
}

@callback
fn viewEvent(self i64, cmd i64, e i64) {
	appkit.Send(e, "retain")
	push(KindEvent, e)
}

@callback
fn viewYes(self i64, cmd i64) i64 {
	return 1
}

// makeBackingLayer: the view's layer is a CAMetalLayer that presents what the GPU draws.
@callback
fn viewLayer(self i64, cmd i64) i64 {
	let layer = appkit.Send(appkit.Class("CAMetalLayer"), "layer")
	appkit.Send1(layer, "setDevice:", gpu.Device)
	// MTLPixelFormatBGRA8Unorm
	appkit.Send1(layer, "setPixelFormat:", 80)
	appkit.Send1(layer, "setFramebufferOnly:", 1)
	return layer
}

@callback
fn commandChosen(self i64, cmd i64, sender i64) {
	push(KindCommand, appkit.Send(sender, "tag"))
}

// windowShouldClose: the close button asks the program instead of closing the window
@callback
fn windowShouldClose(self i64, cmd i64, window i64) i64 {
	push(KindQuit, 0)
	return 0
}

// applicationShouldTerminate: Quit asks the program too, which ends the application by returning from main (NSTerminateNow is 1,
// NSTerminateCancel 0)
@callback
fn shouldTerminate(self i64, cmd i64, app i64) i64 {
	push(KindQuit, 0)
	return 0
}

@callback
fn terminateAfterLastWindow(self i64, cmd i64, app i64) i64 {
	return 1
}

// Window is the open window.
type Window struct {
	Win appkit.Window
	View i64
	Layer i64
	Delegate i64
}

mut classesMade bool

// Open shows a window of w by h points with a title, drawn by the GPU. Gpu.Device is 0 when there is no GPU.
fn Open(title str, w f64, h f64) (Window, metal.Gpu) {
	let win = Window{Win: appkit.Window{}}
	win.Win = appkit.OpenWindow(title, w, h)
	// the content reaches under the title bar, which shows only the window's buttons (the program draws its own title bar)
	appkit.Send1(win.Win.Win, "setStyleMask:", appkit.StyleTitled | appkit.StyleClosable | appkit.StyleMiniaturizable | appkit.StyleResizable | (1 << 15))
	appkit.Send1(win.Win.Win, "setTitlebarAppearsTransparent:", 1)
	appkit.Send1(win.Win.Win, "setTitleVisibility:", 1)
	gpu = keep(metal.Open())
	if gpu.Device == 0 {
		return win, gpu
	}
	appkit.InitCallbacks()
	if !classesMade {
		classesMade = true
		let view = appkit.NewClass("NSView", "TinView")
		appkit.AddMethod(view, "keyDown:", viewEvent, "v@:@")
		appkit.AddMethod(view, "keyUp:", viewEvent, "v@:@")
		appkit.AddMethod(view, "flagsChanged:", viewEvent, "v@:@")
		appkit.AddMethod(view, "mouseDown:", viewEvent, "v@:@")
		appkit.AddMethod(view, "mouseUp:", viewEvent, "v@:@")
		appkit.AddMethod(view, "mouseDragged:", viewEvent, "v@:@")
		appkit.AddMethod(view, "mouseMoved:", viewEvent, "v@:@")
		appkit.AddMethod(view, "rightMouseDown:", viewEvent, "v@:@")
		appkit.AddMethod(view, "scrollWheel:", viewEvent, "v@:@")
		appkit.AddMethod(view, "acceptsFirstResponder", viewYes, "B@:")
		appkit.AddMethod(view, "wantsUpdateLayer", viewYes, "B@:")
		appkit.AddMethod(view, "makeBackingLayer", viewLayer, "@@:")
		appkit.RegisterClass(view)
		let delegate = appkit.NewClass("NSObject", "TinDelegate")
		appkit.AddMethod(delegate, "windowShouldClose:", windowShouldClose, "B@:@")
		appkit.AddMethod(delegate, "applicationShouldTerminate:", shouldTerminate, "q@:@")
		appkit.AddMethod(delegate, "applicationShouldTerminateAfterLastWindowClosed:", terminateAfterLastWindow, "B@:@")
		appkit.AddMethod(delegate, "command:", commandChosen, "v@:@")
		appkit.RegisterClass(delegate)
	}
	let frame = appkit.SendD4(appkit.Send(appkit.Class("TinView"), "alloc"), "initWithFrame:", 0.0, 0.0, w, h)
	win.View = frame
	appkit.Send1(win.View, "setWantsLayer:", 1)
	appkit.Send1(win.Win.Win, "setContentView:", win.View)
	win.Layer = appkit.Send(win.View, "layer")
	// the appkit helpers (ContentSize, Scale) read the window's view and layer
	win.Win.View = win.View
	win.Win.Layer = win.Layer
	appkit.Send1(win.Win.Win, "makeFirstResponder:", win.View)
	appkit.Send1(win.Win.Win, "setAcceptsMouseMovedEvents:", 1)
	win.Delegate = appkit.Send(appkit.Send(appkit.Class("TinDelegate"), "alloc"), "init")
	appkit.Send1(win.Win.Win, "setDelegate:", win.Delegate)
	appkit.Send1(win.Win.App, "setDelegate:", win.Delegate)
	return win, gpu
}

// Size is the drawable size of the window in pixels.
fn Size(win Window) (i64, i64) {
	let scale = appkit.Scale(win.Win)
	let (w, h) = appkit.ContentSize(win.Win)
	return i64(w * scale), i64(h * scale)
}

// Draw shows a frame: the clear color and the scene.
fn Draw(win Window, scene metal.Scene, atlas metal.Atlas, r f64, g f64, b f64, a f64) {
	let (w, h) = Size(win)
	appkit.SendWithDouble(win.Layer, "setContentsScale:", appkit.Scale(win.Win))
	metal.DrawLayer(gpu, win.Layer, w, h, scene, atlas, r, g, b, a)
}

// Pump waits up to seconds for AppKit's next event and lets AppKit deal with it, which calls the callbacks above (a key or
// mouse event for the view, a menu choice for the delegate, the window's buttons). It reports whether there was an event.
fn Pump(win Window, seconds f64) bool {
	let e = appkit.WaitEvent(win.Win, seconds)
	if e == 0 {
		return false
	}
	appkit.Dispatch(win.Win, e)
	return true
}

// NewMenuBar makes the menu bar whose items call OnCommand with their tag.
fn NewMenuBar(win Window) appkit.Menu {
	return appkit.NewCallbackMenuBar(win.Win.App, win.Delegate, "command:")
}

// PopUp shows a context menu at the place of the mouse event e. Choosing an item arrives as a command (KindCommand) with the
// item's tag, like a menu bar item.
fn PopUp(win Window, e i64, titles []str, tags []i64) {
	let menu = appkit.Send1(appkit.Send(appkit.Class("NSMenu"), "alloc"), "initWithTitle:", appkit.NewString(""))
	for i in 0..len(titles) {
		if titles[i] == "-" {
			appkit.Send1(menu, "addItem:", appkit.Send(appkit.Class("NSMenuItem"), "separatorItem"))
			continue
		}
		let item = appkit.Send3(appkit.Send(appkit.Class("NSMenuItem"), "alloc"), "initWithTitle:action:keyEquivalent:", appkit.NewString(titles[i]), appkit.Sel("command:"), appkit.NewString(""))
		appkit.Send1(item, "setTarget:", win.Delegate)
		appkit.Send1(item, "setTag:", tags[i])
		appkit.Send1(menu, "addItem:", item)
	}
	appkit.Send3(appkit.Class("NSMenu"), "popUpContextMenu:withEvent:forView:", menu, e, win.View)
}
