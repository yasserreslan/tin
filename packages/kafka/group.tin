package kafka

import "fault"
import "sift"
import "tide"

// Consumer groups (the classic protocol): a member joins, the leader assigns partitions with
// the range or round-robin assignor, and Poll fetches from the member's partitions, heartbeats,
// follows rebalances and commits. Members are per core (design/design_kafka.md, section 3).

// Assignor is how a group's leader spreads partitions over its members.
type Assignor enum {
	Range      // per topic, consecutive partitions to each member (Java's default)
	RoundRobin // all partitions dealt in turn
}

// Start is where a member starts reading a partition the group has no offset for.
type Start enum {
	Latest   // only records written from now on (Java's default)
	Earliest // everything still in the partition
}

// GroupOptions describe a member.
type GroupOptions struct {
	Group        str
	Topics       []str
	InstanceID   str        // static membership: a restart with the same id keeps the assignment without a rebalance
	Session      i64        // ns the coordinator waits for a heartbeat before removing the member (default 45 s)
	Rebalance    i64        // ns a rebalance may take (default 60 s); in effect max.poll.interval: the coordinator removes a member that does not rejoin within it
	Heartbeat    i64        // ns between heartbeats (default 3 s); also how often the member checks whether its topics changed partitions
	Assignor     ?Assignor  // nil: Range (offered with RoundRobin)
	Start        ?Start     // nil: Latest
	CommitEvery  i64        // ns between auto-commits (0: 5 s, as Java); each Poll commits what earlier ones returned
	ManualCommit bool       // commit only on Commit (default: each Poll commits what the previous one returned)
}

// Group is this core's member of a consumer group.
type Group struct {
	c  Client
	id i64
}

// TopicPartition names a partition and an offset (a position or a committed offset).
type TopicPartition struct {
	Topic     str
	Partition i64
	Offset    i64
}

type position struct {
	topic     str
	partition i64
	offset    i64 // the next offset to fetch, -1 until known
	committed i64 // the last offset committed for it, -1 for none
}

// tcount is a subscribed topic's partition count as of the member's last look (-1 when the
// cluster had no metadata for it).
type tcount struct {
	topic str
	parts i64
}

type member struct {
	group       str
	topics      []str
	instance    str
	session     i64
	rebalance   i64
	heartbeat   i64
	assignors   []str
	earliest    bool
	autoCommit  bool
	commitEvery i64
	memberID    str
	generation  i64
	joined      bool
	rejoin      bool
	lastBeat    i64
	lastCommit  i64
	checked     i64
	counts      []tcount
	rot         i64
	assigned    []position
	closed      bool
}

const maxGroups = 256

// members holds this core's group members, by Group id.
let members = make([]?member, maxGroups)

// Group makes this core's member of a consumer group. It joins on the first Poll. A core holds
// at most 256 members; Close frees the slot again.
fn (c Client) Group(o GroupOptions) !Group {
	if o.Group == "" || len(o.Topics) == 0 {
		fail "kafka: a group member needs a group and topics"
	}
	mut id = -1
	for i in 0..maxGroups {
		if members[i] == nil {
			id = i
			break
		}
	}
	if id < 0 {
		fail "kafka: more than {maxGroups} group members on this core"
	}
	mut asg = []str{"range", "roundrobin"}
	let a = o.Assignor
	if a != nil {
		match a {
			RoundRobin => {
				asg = []str{"roundrobin", "range"}
			}
			Range => {
			}
		}
	}
	mut earliest = false
	let st = o.Start
	if st != nil {
		match st {
			Earliest => {
				earliest = true
			}
			Latest => {
			}
		}
	}
	let m = member{group: o.Group, topics: o.Topics, instance: o.InstanceID, session: dflt(o.Session, 45000000000), rebalance: dflt(o.Rebalance, 60000000000), heartbeat: dflt(o.Heartbeat, 3000000000), assignors: asg, earliest: earliest, autoCommit: !o.ManualCommit, commitEvery: dflt(o.CommitEvery, 5000000000), memberID: "", generation: -1, joined: false, rejoin: false, lastBeat: 0, lastCommit: 0, checked: 0, counts: []tcount{}, rot: 0, assigned: []position{}, closed: false}
	members[id] = keep(m)
	return Group{c: c, id: id}
}

fn dflt(v i64, d i64) i64 {
	if v > 0 {
		return v
	}
	return d
}

fn (g Group) get() !member {
	let m = members[g.id]
	if m == nil {
		fail "kafka: this group member is closed or belongs to another core"
	}
	return m
}

fn (g Group) put(m member) {
	members[g.id] = keep(m)
}

// MemberID is the id the coordinator gave this member ("" before it joined).
fn (g Group) MemberID() str {
	let m = g.get() catch _ {
		return ""
	}
	return m.memberID
}

// Generation is the group generation this member is in (-1 before it joined).
fn (g Group) Generation() i64 {
	let m = g.get() catch _ {
		return -1
	}
	return m.generation
}

// Assigned is the member's partitions with the offset each will be read from next (-1 until
// known).
fn (g Group) Assigned() []TopicPartition {
	let m = g.get() catch _ {
		return []TopicPartition{}
	}
	mut out = []TopicPartition{}
	let ps = m.assigned
	for _, p in ps {
		out = append(out, TopicPartition{Topic: p.topic, Partition: p.partition, Offset: p.offset})
	}
	return out
}

// Seek makes the next Poll read the member's partition from offset.
fn (g Group) Seek(topic str, partition i64, offset i64) ! {
	mut m = try g.get()
	mut ps = []position{}
	mut found = false
	let as = m.assigned
	for _, p in as {
		if p.topic == topic && p.partition == partition {
			ps = append(ps, position{topic: p.topic, partition: p.partition, offset: offset, committed: p.committed})
			found = true
		} else {
			ps = append(ps, p)
		}
	}
	if !found {
		fail "kafka: {topic}/{partition} is not assigned to this member"
	}
	m.assigned = ps
	g.put(m)
}

// ---- protocol helpers ----

fn subscription(topics []str) str {
	mut b = make([]u8, 0, 64)
	put16(mut b, 0)
	putStrs(mut b, topics)
	put32(mut b, -1) // no user data
	return str(b)
}

type assignment struct {
	member str
	parts  []TopicPartition
}

fn encodeAssignment(parts []TopicPartition) str {
	mut topics = []str{}
	for _, p in parts {
		mut seen = false
		for _, t in topics {
			if t == p.Topic {
				seen = true
			}
		}
		if !seen {
			topics = append(topics, p.Topic)
		}
	}
	mut b = make([]u8, 0, 64)
	put16(mut b, 0)
	put32(mut b, len(topics))
	for _, t in topics {
		putStr(mut b, t)
		mut ids = []i64{}
		for _, p in parts {
			if p.Topic == t {
				ids = append(ids, p.Partition)
			}
		}
		putInts(mut b, ids)
	}
	put32(mut b, -1)
	return str(b)
}

fn decodeAssignment(s str) ![]TopicPartition {
	mut out = []TopicPartition{}
	if len(s) == 0 {
		return out
	}
	mut d = newDec(s)
	d.i16() // version
	let nt = d.count()
	for i in 0..nt {
		let t = d.str()
		let ps = d.ints()
		for _, p in ps {
			out = append(out, TopicPartition{Topic: t, Partition: p, Offset: -1})
		}
	}
	if d.bad {
		fail damaged("group assignment")
	}
	return out
}

type subscriber struct {
	id       str // member id, or instance id when the member has one (the order Java sorts by)
	instance str // the member's instance id: a static member, or "" for a dynamic one
	member   str
	topics   []str
}

fn subscribed(s subscriber, topic str) bool {
	for _, t in s.topics {
		if t == topic {
			return true
		}
	}
	return false
}

// assign is the leader's assignment for the chosen protocol.
fn (c Client) assign(protocol str, subs []subscriber) ![]assignment {
	// Static members first, then dynamic ones by their member id (the order Java's assignor
	// sorts by), each group by its (instance or member) id.
	mut order = make([]subscriber, 0, len(subs))
	order = append(order, subs...)
	sift.SortFunc(mut order, fn(a subscriber, b subscriber) i64 {
		mut ai = 0
		if a.instance != "" {
			ai = -1
		}
		mut bi = 0
		if b.instance != "" {
			bi = -1
		}
		if ai != bi {
			return ai - bi
		}
		if a.id < b.id {
			return -1
		}
		if a.id > b.id {
			return 1
		}
		return 0
	})
	mut topics = []str{}
	for _, s in order {
		for _, t in s.topics {
			mut seen = false
			for _, x in topics {
				if x == t {
					seen = true
				}
			}
			if !seen {
				topics = append(topics, t)
			}
		}
	}
	sift.Strs(mut topics)
	// A subscribed topic the cluster has no metadata for (it does not exist yet, or this
	// principal may not read it) is skipped, as Java's assignor does: one missing topic must
	// not stop the whole group from being assigned (#444).
	mut live = []str{}
	for _, t in topics {
		let err = c.refresh([]str{t})
		if err == nil {
			live = append(live, t)
		}
	}
	mut out = make([]assignment, 0, len(order))
	for _, s in order {
		out = append(out, assignment{member: s.member, parts: []TopicPartition{}})
	}
	if protocol == "roundrobin" {
		mut next = 0
		for _, t in live {
			let n = c.partsKnown(t)
			for p in 0..n {
				// The next member, in turn, that subscribes to t.
				for k in 0..len(order) {
					let i = (next + k) % len(order)
					if subscribed(order[i], t) {
						out[i].parts = append(out[i].parts, TopicPartition{Topic: t, Partition: p, Offset: -1})
						next = i + 1
						break
					}
				}
			}
		}
		return out
	}
	for _, t in live {
		let n = c.partsKnown(t)
		mut who = []i64{}
		for i, s in order {
			if subscribed(s, t) {
				who = append(who, i)
			}
		}
		if len(who) == 0 || n <= 0 {
			continue
		}
		let per = n / len(who)
		let extra = n % len(who)
		for k, i in who {
			let start = per*k + min(k, extra)
			mut count = per
			if k < extra {
				count += 1
			}
			for p in start..start+count {
				out[i].parts = append(out[i].parts, TopicPartition{Topic: t, Partition: p, Offset: -1})
			}
		}
	}
	return out
}

// coordAddrs caches each key's coordinator address on this core, by client, kind and key: the
// FindCoordinator round trip is made once, not with every request, until the broker says it is
// not the coordinator (#444).
let coordAddrs = make(map[str]str)

// coordinator is the broker that coordinates group (or, with kind 1, a transactional id).
fn (c Client) coordinatorOf(key str, kind i64) !str {
	mut ck = "{c.rec[rID]} {kind} {key}"
	mut a = coordAddrs[ck]
	if a != "" {
		return a
	}
	mut body = make([]u8, 0, 32)
	putStr(mut body, key)
	put8(mut body, kind)
	for attempt in 0..coordAttempts {
		let (resp, err) = c.anyCall(apiFindCoordinator, body, 0)
		if err != nil {
			if !c.retry(err, "", attempt) {
				fail err
			}
			continue
		}
		mut d = newDec(resp)
		d.i32() // throttle
		let code = d.i16()
		d.str() // message
		d.i32() // node id
		let host = d.str()
		let port = d.i32()
		if d.bad {
			fail damaged("find coordinator")
		}
		if code == 0 {
			a = "{host}:{port}"
			coordAddrs[ck] = keep(a)
			return a
		}
		let kf = kerr(code, "coordinator of {key}")
		if !fault.Is(kf, ErrCoordinator) || attempt+1 >= coordAttempts || !backoff(attempt) {
			fail kf
		}
	}
	fail "kafka: no coordinator for {key}"
}

// dropCoordinator forgets key's cached coordinator, so the next request finds it again.
fn (c Client) dropCoordinator(key str, kind i64) {
	delete(coordAddrs, "{c.rec[rID]} {kind} {key}")
}

// coordCall sends a request to key's coordinator, finding it again and retrying while the
// coordinator is loading, moving or gone. check reads the response's error code (0 for none).
fn (c Client) coordCall(key str, kind i64, api i64, body []u8, extra i64, check fn(str) i64) !str {
	for attempt in 0..coordAttempts {
		let addr = try c.coordinatorOf(key, kind)
		mut group = ""
		if kind == 0 {
			group = key // a group's held requests go on its own lane (conn.tin)
		}
		let (resp, err) = c.call_in(addr, group, api, body, extra, false)
		if err != nil {
			if fault.Is(err, ErrNetwork) && attempt+1 < coordAttempts && backoff(attempt) {
				// The cached coordinator's broker may be gone: look for it again.
				c.dropCoordinator(key, kind)
				continue
			}
			fail err
		}
		let code = check(resp)
		if code == 14 || code == 15 || code == 16 {
			// Loading, not available, or not the coordinator: find it again.
			c.dropCoordinator(key, kind)
			if attempt+1 < coordAttempts && backoff(attempt) {
				continue
			}
		}
		return resp
	}
	fail "kafka: the coordinator of {key} did not answer"
}

// ---- joining ----

// join (re)joins the group and takes the assignment the leader made. It works on a kept copy
// of the member and stores it only once the join succeeded, so a failed join leaves no pointer
// into the calling task's pool behind (#444).
fn (g Group) join() ! {
	let c = g.c
	let stored = try g.get()
	mut m = keep(stored)
	for attempt in 0..coordAttempts {
		mut body = make([]u8, 0, 128)
		putStr(mut body, m.group)
		put32(mut body, m.session / 1000000)
		put32(mut body, m.rebalance / 1000000)
		putStr(mut body, m.memberID)
		putNullStr(mut body, m.instance)
		putStr(mut body, "consumer")
		put32(mut body, len(m.assignors))
		let sub = subscription(m.topics)
		for _, a in m.assignors {
			putStr(mut body, a)
			putBytes(mut body, sub)
		}
		let resp = try c.coordCall(m.group, 0, apiJoinGroup, body, m.rebalance, joinCode)
		mut d = newDec(resp)
		d.i32() // throttle
		let code = d.i16()
		let gen = d.i32()
		let protocol = d.str()
		let leader = d.str()
		let memberID = d.str()
		mut subs = []subscriber{}
		let nm = d.count()
		for i in 0..nm {
			let mid = d.str()
			let inst = d.str()
			let meta = d.bytes()
			mut md = newDec(meta)
			md.i16() // subscription version
			let ts = md.strs()
			mut key = mid
			if inst != "" {
				key = inst
			}
			subs = append(subs, subscriber{id: key, instance: inst, member: mid, topics: ts})
		}
		if d.bad {
			fail damaged("join group")
		}
		if code == 79 {
			// MEMBER_ID_REQUIRED: join again with the id the coordinator made for us.
			m.memberID = memberID
			continue
		}
		if code == 25 {
			m.memberID = ""
			continue
		}
		if code == 27 {
			continue
		}
		if code != 0 {
			fail kerr(code, "join group {m.group}")
		}
		m.memberID = memberID
		m.generation = gen
		// The leader assigns; everyone syncs.
		mut sync = make([]u8, 0, 128)
		putStr(mut sync, m.group)
		put32(mut sync, gen)
		putStr(mut sync, memberID)
		putNullStr(mut sync, m.instance)
		if leader == memberID {
			let asg = try c.assign(protocol, subs)
			put32(mut sync, len(asg))
			for _, a in asg {
				putStr(mut sync, a.member)
				putBytes(mut sync, encodeAssignment(a.parts))
			}
		} else {
			put32(mut sync, 0)
		}
		let sresp = try c.coordCall(m.group, 0, apiSyncGroup, sync, m.rebalance, syncCode)
		mut sd = newDec(sresp)
		sd.i32() // throttle
		let scode = sd.i16()
		let mine = sd.bytes()
		if sd.bad {
			fail damaged("sync group")
		}
		if scode == 27 || scode == 22 {
			continue
		}
		if scode == 25 {
			m.memberID = ""
			continue
		}
		if scode != 0 {
			fail kerr(scode, "sync group {m.group}")
		}
		let parts = try decodeAssignment(mine)
		mut ps = []position{}
		for _, p in parts {
			ps = append(ps, position{topic: p.Topic, partition: p.Partition, offset: -1, committed: -1})
		}
		m.assigned = ps
		m.rejoin = false
		m.lastBeat = tide.Now()
		m.lastCommit = tide.Now()
		m.checked = tide.Now()
		m.rot = 0
		m.counts = topicCounts(c, m.topics)
		g.put(m)
		// The positions load before the member counts as joined: a failed OffsetFetch or
		// ListOffsets leaves it rejoining, instead of fetching every partition at -1, which
		// jumps to the end of the log and loses the records in between (#444).
		try g.loadPositions()
		m = try g.get()
		m.joined = true
		g.put(m)
		return
	}
	fail fault.Wrap(ErrRebalance, "kafka: could not join group {m.group}")
}

// topicCounts is each topic's partition count as this core last saw it (-1 when the cluster had
// no metadata for it): the snapshot a later Poll compares against.
fn topicCounts(c Client, topics []str) []tcount {
	mut out = []tcount{}
	for _, t in topics {
		out = append(out, tcount{topic: t, parts: c.partsKnown(t)})
	}
	return out
}

// The error code of each coordinator response, for coordCall.
fn joinCode(r str) i64 {
	mut d = newDec(r)
	d.i32()
	return d.i16()
}

fn syncCode(r str) i64 {
	mut d = newDec(r)
	d.i32()
	return d.i16()
}

fn noCode(r str) i64 {
	return 0
}

// loadPositions sets the offset of each newly assigned partition: the group's committed offset,
// or the start policy's. A partition whose start offset cannot be listed yet (it has no leader)
// keeps -1: its fetch says why, and the next Poll asks again (#444).
fn (g Group) loadPositions() ! {
	let c = g.c
	mut m = try g.get()
	if len(m.assigned) == 0 {
		return
	}
	let committed = try c.committedAll(m.group, m.assigned)
	mut ps = []position{}
	let as = m.assigned
	for i, p in as {
		mut off = committed[i]
		if off < 0 {
			mut ts = -1
			if m.earliest {
				ts = -2
			}
			let (lo, lerr) = c.listOffset(p.topic, p.partition, ts)
			if lerr == nil {
				off = lo
			}
		}
		ps = append(ps, position{topic: p.topic, partition: p.partition, offset: off, committed: committed[i]})
	}
	m.assigned = ps
	g.put(m)
}

// committedAll is group's committed offset of each position's partition (-1 for none).
fn (c Client) committedAll(group str, ps []position) ![]i64 {
	mut topics = []str{}
	for _, p in ps {
		mut seen = false
		for _, t in topics {
			if t == p.topic {
				seen = true
			}
		}
		if !seen {
			topics = append(topics, p.topic)
		}
	}
	mut body = make([]u8, 0, 64)
	putStr(mut body, group)
	put32(mut body, len(topics))
	for _, t in topics {
		putStr(mut body, t)
		mut ids = []i64{}
		for _, p in ps {
			if p.topic == t {
				ids = append(ids, p.partition)
			}
		}
		putInts(mut body, ids)
	}
	let resp = try c.coordCall(group, 0, apiOffsetFetch, body, 0, offsetFetchCode)
	mut out = make([]i64, len(ps))
	for i in 0..len(ps) {
		out[i] = -1
	}
	mut d = newDec(resp)
	d.i32() // throttle
	let nt = d.count()
	for i in 0..nt {
		let t = d.str()
		let np = d.count()
		for j in 0..np {
			let part = d.i32()
			let off = d.i64()
			d.i32() // leader epoch
			d.str() // metadata
			let code = d.i16()
			if code != 0 {
				fail kerr(code, "committed offset of {group} at {t}/{part}")
			}
			for k, p in ps {
				if p.topic == t && p.partition == part {
					out[k] = off
				}
			}
		}
	}
	let top = d.i16()
	if d.bad {
		fail damaged("offset fetch")
	}
	if top != 0 {
		fail kerr(top, "committed offsets of {group}")
	}
	return out
}

fn offsetFetchCode(r str) i64 {
	// The top-level error comes last; a coordinator error there means "find it again".
	if len(r) >= 2 {
		return i64(i16(u16(r[len(r)-2])<<8 | u16(r[len(r)-1])))
	}
	return 0
}

// ---- polling ----

// checkTopics refreshes the subscribed topics' metadata and rejoins when one of their partition
// counts changed: a topic created after the join, partitions added to one, or a topic deleted
// (#444). Java's leader sees the same metadata snapshots.
fn (g Group) checkTopics() ! {
	let c = g.c
	mut m = try g.get()
	mut changed = false
	mut counts = []tcount{}
	for _, t in m.topics {
		let err = c.refresh([]str{t})
		mut n = -1
		if err == nil {
			n = c.partsKnown(t)
		}
		counts = append(counts, tcount{topic: t, parts: n})
		mut old = -2
		for _, x in m.counts {
			if x.topic == t {
				old = x.parts
			}
		}
		if n != old {
			changed = true
		}
	}
	m.counts = counts
	m.checked = tide.Now()
	if changed {
		m.rejoin = true
	}
	g.put(m)
}

// rotate puts the position at index k first, then the rest in order: the fetch order rotates
// between polls.
fn rotate(ps []position, k i64) []position {
	mut out = make([]position, 0, len(ps))
	if len(ps) == 0 {
		return out
	}
	mut at = k % i64(len(ps))
	if at < 0 {
		at = 0
	}
	for i in 0..len(ps) {
		out = append(out, ps[(at+i) % i64(len(ps))])
	}
	return out
}

// Heartbeat tells the coordinator the member is alive (Poll does it when due). A rebalance makes
// the next Poll rejoin.
fn (g Group) Heartbeat() ! {
	let c = g.c
	mut m = try g.get()
	if !m.joined {
		return
	}
	mut body = make([]u8, 0, 64)
	putStr(mut body, m.group)
	put32(mut body, m.generation)
	putStr(mut body, m.memberID)
	putNullStr(mut body, m.instance)
	let resp = try c.coordCall(m.group, 0, apiHeartbeat, body, 0, joinCode)
	mut d = newDec(resp)
	d.i32()
	let code = d.i16()
	// The beat time and the rejoin flag are plain fields of the stored member: they are
	// written in place, so a member polled for a long time holds no copy per heartbeat.
	m.lastBeat = tide.Now()
	if code == 27 || code == 22 {
		m.rejoin = true
	} else if code == 25 {
		m.rejoin = true
		m.memberID = ""
	} else if code != 0 {
		fail kerr(code, "heartbeat in group {m.group}")
	}
}

// Poll returns the next records of the member's partitions, waiting up to maxWait (less when a
// heartbeat falls due). It joins the group first, rejoins after a rebalance or a change in its
// topics' partitions, heartbeats, and unless ManualCommit is set commits every CommitEvery.
fn (g Group) Poll(maxWait i64) ![]Record {
	let c = g.c
	mut m = try g.get()
	if m.closed {
		fail "kafka: the group member is closed"
	}
	if m.joined && m.autoCommit && tide.Now()-m.lastCommit >= m.commitEvery {
		let cerr = g.Commit()
		if cerr != nil && !fault.Is(cerr, ErrRebalance) {
			fail cerr
		}
		m = try g.get()
	}
	if m.joined && tide.Now()-m.checked >= m.heartbeat {
		try g.checkTopics()
		m = try g.get()
	}
	if m.joined && tide.Now()-m.lastBeat >= m.heartbeat {
		try g.Heartbeat()
		m = try g.get()
	}
	if m.joined && m.rejoin && m.autoCommit {
		// A rejoin is coming: commit the positions first, as Java does when it revokes the
		// partitions, so the records the new assignment re-reads are not delivered twice.
		let cerr = g.Commit()
		if cerr != nil && !fault.Is(cerr, ErrRebalance) {
			fail cerr
		}
		m = try g.get()
	}
	if !m.joined || m.rejoin {
		try g.join()
		m = try g.get()
	}
	if len(m.assigned) == 0 {
		// Nothing assigned: wait (in heartbeat-sized steps) for a rebalance to give us work.
		// The topic check above notices a topic that appeared meanwhile.
		let wait = min(maxWait, m.heartbeat)
		if wait > 0 {
			try tide.Wait(wait)
		}
		return []Record{}
	}
	let left = m.heartbeat - (tide.Now() - m.lastBeat)
	let wait = max(min(maxWait, left), 0)
	// The partitions take turns at the head of the request: the per-partition and the request
	// limit are both FetchMax, so a lagging first partition would starve the rest (#444).
	let as = m.assigned
	let rw = rotate(as, m.rot)
	m.rot = (m.rot + 1) % i64(len(as))
	mut wants = []Want{}
	for _, p in rw {
		wants = append(wants, Want{Topic: p.topic, Partition: p.partition, Offset: p.offset})
	}
	let f = try c.FetchAll(wants, wait)
	// Move each position past what came back; an offset out of range restarts by the policy. A
	// partition the fetch could not reach (no leader, or the leader refused) keeps its position
	// and is asked again by the next Poll; the healthy partitions' records are not lost with it
	// (#444). Only the offsets change, so they are written in place: a consumer loop that never
	// ends would otherwise drop a kept copy of the member with every Poll (#446).
	for i, p in as {
		mut off = p.offset
		for _, pt in f.Parts {
			if pt.Topic != p.topic || pt.Partition != p.partition {
				continue
			}
			if pt.Err != nil {
				continue
			}
			if pt.OutOfRange {
				if m.earliest {
					off = pt.LogStart
				} else {
					off = pt.HighWatermark
				}
			} else {
				off = pt.Next
			}
		}
		if off != p.offset {
			as[i].offset = off
		}
	}
	return f.Records
}

// Commit stores the member's positions (the offsets after the records Poll returned) as the
// group's committed offsets. A rebalance in the meantime fails it with ErrRebalance.
fn (g Group) Commit() ! {
	let m = try g.get()
	mut parts = []TopicPartition{}
	let as = m.assigned
	for _, p in as {
		if p.offset >= 0 && p.offset != p.committed {
			parts = append(parts, TopicPartition{Topic: p.topic, Partition: p.partition, Offset: p.offset})
		}
	}
	try g.CommitOffsets(parts)
}

// CommitOffsets stores the given offsets (each the next offset to read) for the group.
fn (g Group) CommitOffsets(parts []TopicPartition) ! {
	if len(parts) == 0 {
		return
	}
	let c = g.c
	mut m = try g.get()
	let body = commitBody(m.group, m.generation, m.memberID, m.instance, parts)
	let resp = try c.coordCall(m.group, 0, apiOffsetCommit, body, 0, commitCode)
	let code = commitCode(resp)
	if code == 27 || code == 22 || code == 25 {
		m.rejoin = true
		if code == 25 {
			m.memberID = ""
		}
		g.put(m)
		fail kerr(code, "commit in group {m.group}")
	}
	if code != 0 {
		fail kerr(code, "commit in group {m.group}")
	}
	// The committed offsets and the commit time are plain fields of the stored member, written
	// in place: only the offsets change, and a long-running member holds no copy per commit.
	let as = m.assigned
	for i, p in as {
		mut committed = p.committed
		for _, q in parts {
			if q.Topic == p.topic && q.Partition == p.partition {
				committed = q.Offset
			}
		}
		if committed != p.committed {
			as[i].committed = committed
		}
	}
	m.lastCommit = tide.Now()
}

fn commitBody(group str, gen i64, memberID str, instance str, parts []TopicPartition) []u8 {
	mut topics = []str{}
	for _, p in parts {
		mut seen = false
		for _, t in topics {
			if t == p.Topic {
				seen = true
			}
		}
		if !seen {
			topics = append(topics, p.Topic)
		}
	}
	mut b = make([]u8, 0, 128)
	putStr(mut b, group)
	put32(mut b, gen)
	putStr(mut b, memberID)
	putNullStr(mut b, instance)
	put32(mut b, len(topics))
	for _, t in topics {
		putStr(mut b, t)
		mut n = 0
		for _, p in parts {
			if p.Topic == t {
				n += 1
			}
		}
		put32(mut b, n)
		for _, p in parts {
			if p.Topic != t {
				continue
			}
			put32(mut b, p.Partition)
			put64(mut b, p.Offset)
			put32(mut b, -1)  // leader epoch: unknown
			putNullStr(mut b, "")
		}
	}
	return b
}

// commitCode is the first nonzero partition error of an OffsetCommit response.
fn commitCode(r str) i64 {
	mut d = newDec(r)
	d.i32()
	let nt = d.count()
	for i in 0..nt {
		d.str()
		let np = d.count()
		for j in 0..np {
			d.i32()
			let code = d.i16()
			if code != 0 {
				return code
			}
		}
	}
	return 0
}

// Close commits (unless ManualCommit) and leaves the group, so its partitions move to the other
// members at once. A static member (InstanceID) does not leave: its session keeps its partitions
// for a restart. A harmless ErrRebalance from the commit (a rebalance is already on its way) is
// not reported as a failure, and the member's slot is free again (#444).
fn (g Group) Close() ! {
	let c = g.c
	mut m = try g.get()
	if m.closed {
		return
	}
	mut first fault = nil
	if m.joined && m.autoCommit {
		let err = g.Commit()
		if err != nil && !fault.Is(err, ErrRebalance) {
			first = err
		}
		m = try g.get()
	}
	if m.joined && m.instance == "" {
		mut body = make([]u8, 0, 64)
		putStr(mut body, m.group)
		put32(mut body, 1)
		putStr(mut body, m.memberID)
		putNullStr(mut body, "")
		let (_, err) = c.coordCall(m.group, 0, apiLeaveGroup, body, 0, joinCode)
		if err != nil && first == nil && !fault.Is(err, ErrRebalance) {
			first = err
		}
	}
	members[g.id] = nil
	if first != nil {
		fail first
	}
}

// ---- offsets without membership ----

// Commit stores offset as group's position in the partition, without being a member (the
// "simple consumer" commit: generation -1). The offset is the next one to read.
fn (c Client) Commit(group str, topic str, partition i64, offset i64) ! {
	let body = commitBody(group, -1, "", "", []TopicPartition{TopicPartition{Topic: topic, Partition: partition, Offset: offset}})
	let resp = try c.coordCall(group, 0, apiOffsetCommit, body, 0, commitCode)
	let code = commitCode(resp)
	if code != 0 {
		fail kerr(code, "commit of group {group} at {topic}/{partition}")
	}
}

// Committed is the offset group last committed for the partition, or -1 when it has none.
fn (c Client) Committed(group str, topic str, partition i64) !i64 {
	let offs = try c.committedAll(group, []position{position{topic: topic, partition: partition, offset: -1, committed: -1}})
	return offs[0]
}
