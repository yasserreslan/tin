package s3

import "seal"
import "sift"
import "tide"
import "twine"

// ---- AWS Signature Version 4 ----
//
// The rules are those of the AWS SDK for Go v2 (aws/signer/v4), which bench/ref/s3sig runs
// against this file: the path is signed as it goes on the wire (S3 escapes it once, with
// EscapePath), the query is sorted by name and then by value and escaped as RFC 3986 asks
// (a space is %20), header names are lower-cased and their values lose leading and trailing
// white space and runs of spaces, the host is signed without a default port, and
// Content-Length is signed when the body is not empty. Authorization, User-Agent, Expect,
// Transfer-Encoding and X-Amzn-Trace-Id are never signed.

// UnsignedPayload is the x-amz-content-sha256 value of a body that is not hashed: S3 then
// trusts the transport (TLS) for the body's integrity.
const UnsignedPayload = "UNSIGNED-PAYLOAD"

// EmptyHash is the SHA-256 of an empty body, in hex.
const EmptyHash = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"

// Request is one HTTP request to sign. Path is the URI path as it goes on the wire, already
// escaped (EscapePath); Query and Headers are name, value pairs, the query's unescaped.
type Request struct {
	Method        str
	Scheme        str // "http" or "https": the signed host drops the scheme's default port
	Host          str // host or host:port, as the Host field carries it
	Path          str
	Query         []str
	Headers       []str
	PayloadHash   str // hex SHA-256 of the body, or UnsignedPayload
	ContentLength i64 // signed as content-length when above 0
}

// Signed is a signed request: the fields to add to its headers (X-Amz-Date, the session token
// and Authorization, as name, value pairs) and its query string, escaped and in order.
type Signed struct {
	Headers       []str
	Query         str
	Authorization str
	Canonical     str // the canonical request, for debugging a signature a server refused (it holds the session token)
}

// hexDigit is the upper-case hex digit of v (0..15).
fn hexDigit(v u8) u8 {
	return "0123456789ABCDEF"[i64(v)]
}

// unreserved reports whether c stays as it is in a URI component (RFC 3986).
fn unreserved(c u8) bool {
	return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' || c == '.' || c == '_' || c == '~'
}

// escape is s with every byte but the unreserved ones (and '/' when keepSlash) as %XX.
fn escape(s str, keepSlash bool) str {
	mut plain = true
	for i in 0..len(s) {
		if !unreserved(s[i]) && !(keepSlash && s[i] == '/') {
			plain = false
			break
		}
	}
	if plain {
		return s
	}
	mut b = twine.NewBuilder(len(s) + 16)
	for i in 0..len(s) {
		let c = s[i]
		if unreserved(c) || (keepSlash && c == '/') {
			b.Byte(c)
		} else {
			b.Byte('%')
			b.Byte(hexDigit(c >> 4))
			b.Byte(hexDigit(c & 15))
		}
	}
	return b.String()
}

// EscapePath escapes an object key (or a whole path) for a URL path the way S3 signs it: every
// byte except A-Z a-z 0-9 - . _ ~ and / becomes %XX.
fn EscapePath(s str) str {
	return escape(s, true)
}

// EscapeQuery escapes a query parameter's name or value for a signed query: every byte except
// A-Z a-z 0-9 - . _ ~ becomes %XX (a space is %20, never +).
fn EscapeQuery(s str) str {
	return escape(s, false)
}

// stripSpaces is the AWS SDK's StripExcessSpaces: no leading or trailing spaces, and a run of
// spaces inside as one space (only ' ' counts).
fn stripSpaces(s str) str {
	mut j = len(s) - 1
	for j >= 0 && s[j] == ' ' {
		j -= 1
	}
	mut k = 0
	for k < j && s[k] == ' ' {
		k += 1
	}
	let t = s[k:j + 1]
	if twine.Index(t, "  ") < 0 {
		return t
	}
	mut b = twine.NewBuilder(len(t))
	mut spaces = 0
	for i in 0..len(t) {
		if t[i] == ' ' {
			if spaces == 0 {
				b.Byte(' ')
			}
			spaces += 1
		} else {
			spaces = 0
			b.Byte(t[i])
		}
	}
	return b.String()
}

// ignored reports whether a header (lower-case name) is never signed.
fn ignored(name str) bool {
	return name == "authorization" || name == "user-agent" || name == "x-amzn-trace-id" || name == "expect" || name == "transfer-encoding"
}

// signHost is the host as signed: without the scheme's default port.
fn signHost(scheme str, host str) str {
	let colon = twine.IndexByte(host, ':')
	if colon < 0 {
		return host
	}
	mut port = ""
	let br = twine.Index(host, "]:")
	if br >= 0 {
		port = host[br + 2:]
	} else if twine.ContainsByte(host, ']') {
		return host
	} else {
		port = host[colon + 1:]
	}
	let lower = twine.ToLower(scheme)
	if port == "" || (lower == "http" && port == "80") || (lower == "https" && port == "443") {
		let close = twine.IndexByte(host, ']')
		if close >= 0 {
			return twine.TrimPrefix(host[0:close], "[")
		}
		return host[0:colon]
	}
	return host
}

// canonicalQuery is the query pairs sorted by name, then by value, escaped and joined.
fn canonicalQuery(pairs []str) str {
	mut names = []str{}
	mut values = map[str][]str{}
	mut i = 0
	for i + 1 < len(pairs) {
		let k = pairs[i]
		let (vs, ok) = values[k]
		if !ok {
			names = append(names, k)
			values[k] = []str{pairs[i + 1]}
		} else {
			mut more = vs
			more = append(more, pairs[i + 1])
			values[k] = more
		}
		i += 2
	}
	sift.Strs(mut names)
	mut b = twine.NewBuilder(64)
	for name in names {
		mut vs = values[name]
		sift.Strs(mut vs)
		for v in vs {
			if b.Len() > 0 {
				b.Byte('&')
			}
			b.Str(EscapeQuery(name))
			b.Byte('=')
			b.Str(EscapeQuery(v))
		}
	}
	return b.String()
}

// amzDate is the instant as X-Amz-Date writes it: 20130524T000000Z.
fn amzDate(unix i64) str {
	let c = tide.UTCSec(unix)
	return pad(c.Year, 4) + pad(c.Month, 2) + pad(c.Day, 2) + "T" + pad(c.Hour, 2) + pad(c.Min, 2) + pad(c.Sec, 2) + "Z"
}

// pad is v in decimal with leading zeros to width digits.
fn pad(v i64, width i64) str {
	mut s = twine.NewBuilder(width)
	s.Int(v)
	mut t = s.String()
	for len(t) < width {
		t = "0" + t
	}
	return t
}

// signingKey is the key of one day, region and service, derived from the secret key.
fn signingKey(secretKey secret str, day str, region str, service str) str {
	let kDate = seal.Hmac(seal.Hash.SHA256, "AWS4" + secretKey, day)
	let kRegion = seal.Hmac(seal.Hash.SHA256, str(kDate), region)
	let kService = seal.Hmac(seal.Hash.SHA256, str(kRegion), service)
	return str(seal.Hmac(seal.Hash.SHA256, str(kService), "aws4_request"))
}

// canonicalHeaders gives the signed header names (joined by ;) and the canonical header block.
fn canonicalHeaders(host str, headers []str, contentLength i64) (str, str) {
	mut names = []str{"host"}
	mut values = map[str][]str{}
	values["host"] = []str{host}
	if contentLength > 0 {
		names = append(names, "content-length")
		values["content-length"] = []str{pad(contentLength, 1)}
	}
	mut i = 0
	for i + 1 < len(headers) {
		let name = twine.ToLower(headers[i])
		let v = headers[i + 1]
		i += 2
		if ignored(name) || name == "content-length" {
			continue
		}
		let (vs, ok) = values[name]
		if ok {
			mut more = vs
			more = append(more, v)
			values[name] = more
		} else {
			names = append(names, name)
			values[name] = []str{v}
		}
	}
	sift.Strs(mut names)
	mut b = twine.NewBuilder(256)
	for name in names {
		b.Str(name)
		b.Byte(':')
		if name == "host" {
			b.Str(stripSpaces(host))
		} else {
			let vs = values[name]
			for j, v in vs {
				if j > 0 {
					b.Byte(',')
				}
				b.Str(twine.TrimSpace(stripSpaces(v)))
			}
		}
		b.Byte('\n')
	}
	return twine.Join(names, ";"), b.String()
}

// SignRequest signs r with the credentials and region of cfg for service ("s3") at the instant
// unix (seconds): the X-Amz-Date, X-Amz-Security-Token (with a session token) and Authorization
// fields to send with r, and r's query in its signed form.
fn SignRequest(cfg Config, service str, r Request, unix i64) Signed {
	let date = amzDate(unix)
	let day = date[0:8]
	mut hs = []str{}
	for h in r.Headers {
		hs = append(hs, h)
	}
	mut add = []str{"X-Amz-Date", date}
	hs = append(hs, "X-Amz-Date", date)
	if len(reveal(cfg.Token)) > 0 {
		add = append(add, "X-Amz-Security-Token", reveal(cfg.Token))
		hs = append(hs, "X-Amz-Security-Token", reveal(cfg.Token))
	}
	let host = signHost(r.Scheme, r.Host)
	let (signedNames, block) = canonicalHeaders(host, hs, r.ContentLength)
	let query = canonicalQuery(r.Query)
	mut path = r.Path
	if len(path) == 0 {
		path = "/"
	}
	let canonical = r.Method + "\n" + path + "\n" + query + "\n" + block + "\n" + signedNames + "\n" + r.PayloadHash
	let scope = day + "/" + cfg.Region + "/" + service + "/aws4_request"
	let toSign = "AWS4-HMAC-SHA256\n" + date + "\n" + scope + "\n" + seal.Sha256Hex(canonical)
	let sig = seal.Hex(seal.Hmac(seal.Hash.SHA256, signingKey(cfg.SecretKey, day, cfg.Region, service), toSign))
	let auth = "AWS4-HMAC-SHA256 Credential=" + cfg.AccessKey + "/" + scope + ", SignedHeaders=" + signedNames + ", Signature=" + sig
	add = append(add, "Authorization", auth)
	return Signed{Headers: add, Query: query, Authorization: auth, Canonical: canonical}
}

// PresignRequest signs r in its query (a presigned URL) for expires seconds from unix and gives
// the query string to put after "?": r's parameters, the X-Amz-* ones and X-Amz-Signature last.
// Headers in r are signed as they are (none are moved to the query).
fn PresignRequest(cfg Config, service str, r Request, expires i64, unix i64) str {
	let date = amzDate(unix)
	let day = date[0:8]
	let scope = day + "/" + cfg.Region + "/" + service + "/aws4_request"
	let host = signHost(r.Scheme, r.Host)
	let (signedNames, block) = canonicalHeaders(host, r.Headers, r.ContentLength)
	mut q = []str{}
	for p in r.Query {
		q = append(q, p)
	}
	q = append(q, "X-Amz-Algorithm", "AWS4-HMAC-SHA256")
	q = append(q, "X-Amz-Credential", cfg.AccessKey + "/" + scope)
	q = append(q, "X-Amz-Date", date)
	q = append(q, "X-Amz-Expires", pad(expires, 1))
	q = append(q, "X-Amz-SignedHeaders", signedNames)
	if len(reveal(cfg.Token)) > 0 {
		q = append(q, "X-Amz-Security-Token", reveal(cfg.Token))
	}
	let query = canonicalQuery(q)
	mut path = r.Path
	if len(path) == 0 {
		path = "/"
	}
	let canonical = r.Method + "\n" + path + "\n" + query + "\n" + block + "\n" + signedNames + "\n" + r.PayloadHash
	let toSign = "AWS4-HMAC-SHA256\n" + date + "\n" + scope + "\n" + seal.Sha256Hex(canonical)
	let sig = seal.Hex(seal.Hmac(seal.Hash.SHA256, signingKey(cfg.SecretKey, day, cfg.Region, service), toSign))
	return query + "&X-Amz-Signature=" + sig
}
