package anvil

import "quarry"
import "tide"

// Static files with validators (#823): ServeFile answers a GET or HEAD for a file the way net/http's http.ServeContent does: Last-Modified and ETag,
// If-Match, If-Unmodified-Since, If-None-Match and If-Modified-Since (304 or 412), If-Range, and one byte range (206, or 416 when none fits).
// SendFile stays the plain "send these bytes" call.

// ServeFile sends the file at path as the response to request q. It sets Content-Type (from the extension, unless the handler set Type),
// Accept-Ranges, Last-Modified (the file's modification time) and ETag (the handler's own, if it set one, else a strong tag made of the
// time and the size), then decides as http.ServeContent does:
//
//   - If-Match that matches no tag, or If-Unmodified-Since before the file's time: 412 Precondition Failed;
//   - If-None-Match that matches (a weak comparison), or, without it, If-Modified-Since at or after the file's time: 304 Not Modified for
//     GET and HEAD (412 for other methods), with no body;
//   - Range: bytes=a-b, a- or -n (when If-Range, if given, matches the tag or the time): 206 Partial Content with Content-Range, or 416
//     Range Not Satisfiable (with Content-Range: bytes */size) when the range starts past the end or is malformed. Several ranges in one
//     request are answered with the whole file, which RFC 9110 allows;
//   - otherwise 200 with the file.
//
// The file is opened as SendFile does, never on the core thread; a missing file, a directory or anything but a regular file fails before
// anything is sent, so the handler can answer 404.
fn (w mut Out) ServeFile(q Req, path str) ! {
	let c = stream_conn()
	if c == 0 {
		fail "anvil: ServeFile outside a request"
	}
	if c[cHijack] != 0 {
		fail "anvil: the connection is hijacked"
	}
	let (fd, size, mtime) = try quarry.OpenRegularStat(path)
	if w.ctype == "text/plain; charset=utf-8" {
		w.Type(content_type_of(path))
	}
	mut etag = w.Header("etag")
	if len(etag) == 0 {
		etag = "\"" + hex_of(mtime) + "-" + hex_of(size) + "\""
		w.Head("ETag", etag)
	}
	let method = q.Method
	let code = check_preconditions(q, etag, mtime, method)
	if code == 304 {
		// With an ETag a 304 carries no Last-Modified (RFC 9110 15.4.5), as Go's writeNotModified.
		rt_sys_close(fd)
		w.Status(304)
		return
	}
	if mtime > 0 {
		w.Head("Last-Modified", tide.FormatHTTP(mtime))
	}
	if code == 412 {
		rt_sys_close(fd)
		w.Status(412)
		return
	}
	w.Head("Accept-Ranges", "bytes")
	mut start = 0
	mut count = size
	mut status = 200
	let rangeHeader = q.Header("range")
	if len(rangeHeader) > 0 {
		if if_range_ok(q, etag, mtime) {
			let (rs, rl, outcome) = parse_range(rangeHeader, size)
			if outcome == 2 {
				rt_sys_close(fd)
				w.Head("Content-Range", "bytes */" + str_int(size))
				w.Status(416)
				return
			}
			if outcome == 3 {
				rt_sys_close(fd)
				w.Status(416)
				return
			}
			if outcome == 1 {
				start = rs
				count = rl
				status = 206
				w.Head("Content-Range", "bytes " + str_int(rs) + "-" + str_int(rs+rl-1) + "/" + str_int(size))
			}
		}
	}
	w.Status(status)
	try w.send_fd(c, fd, start, count)
}

// hex_of is v in lower-case hexadecimal.
fn hex_of(v i64) str {
	if v == 0 {
		return "0"
	}
	let digits = "0123456789abcdef"
	mut b = make([]u8, 0, 16)
	mut x = v
	if x < 0 {
		x = 0 - x
	}
	for x > 0 {
		b = append(b, digits[x%16])
		x /= 16
	}
	for i in 0..len(b)/2 {
		let t = b[i]
		b[i] = b[len(b)-1-i]
		b[len(b)-1-i] = t
	}
	return str(b)
}

// parse_http_date is the Unix seconds of an HTTP date in any of its three formats (the IMF-fixdate, RFC 850 and asctime forms), or -1.
fn parse_http_date(v_in str) i64 {
	let v = trim_ows(v_in)
	let z = tide.UTCZone()
	for layout in []str{"Mon, 02 Jan 2006 15:04:05 GMT", "Monday, 02-Jan-06 15:04:05 GMT", "Mon Jan _2 15:04:05 2006"} {
		let ns = tide.Parse(layout, v, z) catch _ {
			continue
		}
		return ns / 1000000000
	}
	return -1
}

// etag_scan reads the entity tags of an If-Match or If-None-Match value: each is "W/"? then a quoted string; it reports the first tag
// at the start of s with the rest, or ok false.
fn etag_scan(s_in str) (str, str, bool) {
	let s = trim_ows(s_in)
	mut i = 0
	if len(s) >= 2 && s[0] == 'W' && s[1] == '/' {
		i = 2
	}
	if i >= len(s) || s[i] != '"' {
		return "", "", false
	}
	mut j = i + 1
	for j < len(s) {
		let c = s[j]
		if c == '"' {
			return s[:j+1], s[j+1:], true
		}
		if c == 0x21 || (c >= 0x23 && c != 0x7f) {
			j += 1
			continue
		}
		return "", "", false
	}
	return "", "", false
}

fn etag_weak(t str) bool {
	return len(t) >= 2 && t[0] == 'W' && t[1] == '/'
}

fn etag_value(t str) str {
	if etag_weak(t) {
		return t[2:]
	}
	return t
}

// etag_strong_match is the strong comparison of RFC 9110 8.8.3.2: both tags strong and equal.
fn etag_strong_match(a str, b str) bool {
	return !etag_weak(a) && !etag_weak(b) && a == b
}

// etag_weak_match compares the opaque tags only.
fn etag_weak_match(a str, b str) bool {
	return etag_value(a) == etag_value(b)
}

// cond_matches reports whether an If-Match / If-None-Match value lists the tag (or is "*"); strong picks the comparison.
fn cond_matches(header str, etag str, strong bool) bool {
	mut rest = trim_ows(header)
	for len(rest) > 0 {
		if rest[0] == ',' {
			rest = trim_ows(rest[1:])
			continue
		}
		if rest == "*" {
			return true
		}
		if rest[0] == '*' {
			return true
		}
		let (tag, after, ok) = etag_scan(rest)
		if !ok {
			return false
		}
		if strong && etag_strong_match(tag, etag) || !strong && etag_weak_match(tag, etag) {
			return true
		}
		rest = trim_ows(after)
	}
	return false
}

// check_preconditions is 0 to go on, 304 or 412, following net/http's checkPreconditions.
fn check_preconditions(q Req, etag str, mtime i64, method str) i64 {
	let ifMatch = q.Header("if-match")
	let ius = q.Header("if-unmodified-since")
	let inm = q.Header("if-none-match")
	let ims = q.Header("if-modified-since")
	// If-Match
	if len(ifMatch) > 0 {
		if !cond_matches(ifMatch, etag, true) {
			return 412
		}
	} else if len(ius) > 0 && mtime > 0 {
		let t = parse_http_date(ius)
		if t >= 0 && mtime > t {
			return 412
		}
	}
	// If-None-Match
	if len(inm) > 0 {
		if cond_matches(inm, etag, false) {
			if method == "GET" || method == "HEAD" {
				return 304
			}
			return 412
		}
	} else if len(ims) > 0 && (method == "GET" || method == "HEAD") && mtime > 0 {
		let t = parse_http_date(ims)
		if t >= 0 && mtime <= t {
			return 304
		}
	}
	return 0
}

// if_range_ok reports whether Range applies: there is no If-Range, or it names the current tag or time.
fn if_range_ok(q Req, etag str, mtime i64) bool {
	let ir = q.Header("if-range")
	if len(ir) == 0 || (q.Method != "GET" && q.Method != "HEAD") {
		return true
	}
	let (tag, _, ok) = etag_scan(ir)
	if ok {
		return etag_strong_match(tag, etag)
	}
	if mtime <= 0 {
		return false
	}
	let t = parse_http_date(ir)
	return t >= 0 && t == mtime
}

// parse_range reads a Range header against a file of size bytes, as net/http's parseRange: (start, length, 1) for one range, outcome 0 for
// several ranges or a total larger than the file (the whole file goes out), 2 when no range overlaps the file, 3 when the header is
// malformed.
fn parse_range(h str, size i64) (i64, i64, i64) {
	if len(h) < 6 || h[:6] != "bytes=" {
		return 0, 0, 3
	}
	mut rest = h[6:]
	mut ranges = 0
	mut rs = 0
	mut rl = 0
	mut total = 0
	mut noOverlap = false
	for len(rest) > 0 {
		mut one = rest
		let comma = index_byte(rest, ',')
		if comma >= 0 {
			one = rest[:comma]
			rest = rest[comma+1:]
		} else {
			rest = ""
		}
		one = trim_ows(one)
		if len(one) == 0 {
			continue
		}
		let dash = index_byte(one, '-')
		if dash < 0 {
			return 0, 0, 3
		}
		let a = trim_ows(one[:dash])
		let b = trim_ows(one[dash+1:])
		mut start = 0
		mut length = 0
		if len(a) == 0 {
			// -n: the last n bytes
			if len(b) == 0 || b[0] == '-' {
				return 0, 0, 3
			}
			let (parsed, ok) = parse_digits(b)
			if !ok {
				return 0, 0, 3
			}
			mut n = parsed
			if n > size {
				n = size
			}
			start = size - n
			length = size - start
		} else {
			let (i, ok) = parse_digits(a)
			if !ok {
				return 0, 0, 3
			}
			if i >= size {
				noOverlap = true
				continue
			}
			start = i
			if len(b) == 0 {
				length = size - start
			} else {
				let (e, ok2) = parse_digits(b)
				if !ok2 || start > e {
					return 0, 0, 3
				}
				mut end = e
				if end >= size {
					end = size - 1
				}
				length = end - start + 1
			}
		}
		ranges += 1
		rs = start
		rl = length
		total += length
	}
	if noOverlap && ranges == 0 {
		return 0, 0, 2
	}
	if ranges == 1 && total <= size {
		return rs, rl, 1
	}
	return 0, 0, 0
}

// parse_digits reads a non-negative decimal number (all of s), or ok false.
fn parse_digits(s str) (i64, bool) {
	if len(s) == 0 || len(s) > 18 {
		return 0, false
	}
	mut v = 0
	for i in 0..len(s) {
		let c = s[i]
		if c < '0' || c > '9' {
			return 0, false
		}
		v = v*10 + i64(c-'0')
	}
	return v, true
}

// content_type_of is the media type for a file name's extension (a small table; application/octet-stream when unknown).
fn content_type_of(path str) str {
	let dot = file_last(path, '.')
	let slash = file_last(path, '/')
	if dot < 0 || dot < slash {
		return "application/octet-stream"
	}
	let ext = file_lower(path[dot+1:])
	let types = []str{
		"html", "text/html; charset=utf-8", "htm", "text/html; charset=utf-8", "css", "text/css; charset=utf-8",
		"js", "text/javascript; charset=utf-8", "mjs", "text/javascript; charset=utf-8", "json", "application/json",
		"txt", "text/plain; charset=utf-8", "md", "text/markdown; charset=utf-8", "csv", "text/csv; charset=utf-8",
		"xml", "text/xml; charset=utf-8", "svg", "image/svg+xml", "png", "image/png", "jpg", "image/jpeg", "jpeg", "image/jpeg",
		"gif", "image/gif", "webp", "image/webp", "ico", "image/x-icon", "avif", "image/avif", "pdf", "application/pdf",
		"wasm", "application/wasm", "zip", "application/zip", "gz", "application/gzip", "tar", "application/x-tar",
		"woff", "font/woff", "woff2", "font/woff2", "ttf", "font/ttf", "otf", "font/otf",
		"mp4", "video/mp4", "webm", "video/webm", "mp3", "audio/mpeg", "ogg", "audio/ogg", "wav", "audio/wav",
	}
	mut i = 0
	for i+1 < len(types) {
		if types[i] == ext {
			return types[i+1]
		}
		i += 2
	}
	return "application/octet-stream"
}

fn file_lower(s str) str {
	mut b = make([]u8, 0, len(s))
	for i in 0..len(s) {
		b = append(b, lower(s[i]))
	}
	return str(b)
}

fn file_last(s str, c u8) i64 {
	mut i = len(s) - 1
	for i >= 0 {
		if s[i] == c {
			return i
		}
		i -= 1
	}
	return -1
}
