package anvil

import "say"
import "tide"

// Cookies, as net/http has them (#823): a request's Cookie header read with q.Cookie and q.Cookies, and
// a response's Set-Cookie written by w.SetCookie from a Cookie with Go's validation and escaping.

// Cookie is a Set-Cookie: the name, the value and the attributes. Expires is in Unix seconds and
// left out when 0; MaxAge in seconds is left out when 0 and, when negative, is written as Max-Age=0
// (delete the cookie). SameSite is "", "Lax", "Strict" or "None".
type Cookie struct {
	Name        str
	Value       str
	Path        str
	Domain      str
	Expires     i64
	MaxAge      i64
	Secure      bool
	HttpOnly    bool
	SameSite    str
	Partitioned bool
	Quoted      bool // write the value in double quotes even when it needs none
}

// Cookie returns the value of the request's cookie name, or "" when there is none (or it is not
// well formed): see Cookies.
fn (q Req) Cookie(name str) str {
	let all = q.Cookies()
	let (v, ok) = all[name]
	if ok {
		return v
	}
	return ""
}

// Cookies returns the request's cookies by name, as Go's Request.Cookies does: every Cookie header
// field is read (HTTP/2 joins its cookie fields with "; "), a pair splits at its first "=", a
// value may be wrapped in double quotes, and a pair with a bad name or value is skipped. When a
// name occurs twice, the first value wins.
fn (q Req) Cookies() map[str]str {
	mut out = map[str]str{}
	for line in header_lines(q.hp, q.hn, "cookie") {
		mut rest = trim_ows(line)
		for len(rest) > 0 {
			mut part = rest
			let semi = index_byte(rest, ';')
			if semi >= 0 {
				part = rest[:semi]
				rest = rest[semi+1:]
			} else {
				rest = ""
			}
			part = trim_ows(part)
			if len(part) == 0 {
				continue
			}
			mut name = part
			mut raw = ""
			let eq = index_byte(part, '=')
			if eq >= 0 {
				name = part[:eq]
				raw = part[eq+1:]
			}
			name = trim_ows(name)
			if !is_token(name) {
				continue
			}
			let (v, ok) = parse_cookie_value(raw)
			if !ok {
				continue
			}
			let (_, have) = out[name]
			if !have {
				out[name] = v
			}
		}
	}
	return out
}

// SetCookie adds a Set-Cookie header for c. A cookie whose name is not a token is dropped, a
// Domain that is not a valid domain name or IPv4 address is left out, and bytes that cannot be in
// the value or the path are removed, as Go's http.SetCookie does. Each call adds a header field of
// its own, so several cookies can be set in one response (HTTP/1.1 and HTTP/2).
fn (w mut Out) SetCookie(c Cookie) {
	let s = c.String()
	if len(s) > 0 {
		w.Head("Set-Cookie", s)
	}
}

// String is the Set-Cookie header value for c, or "" when its name is not a valid cookie name.
fn (c Cookie) String() str {
	if !is_token(c.Name) {
		return ""
	}
	mut b = c.Name + "="
	b += sanitize_cookie_value(c.Value, c.Quoted)
	if len(c.Path) > 0 {
		b += "; Path=" + keep_bytes(c.Path, false)
	}
	if len(c.Domain) > 0 && valid_cookie_domain(c.Domain) {
		mut d = c.Domain
		if d[0] == '.' {
			d = d[1:]
		}
		b += "; Domain=" + d
	}
	if c.Expires != 0 && c.Expires >= -11644473600 {
		// The year must not be less than 1601 (RFC 6265 5.1.1.5).
		b += "; Expires=" + tide.FormatHTTP(c.Expires)
	}
	if c.MaxAge > 0 {
		b += "; Max-Age=" + say.Fmt("%d", c.MaxAge)
	} else if c.MaxAge < 0 {
		b += "; Max-Age=0"
	}
	if c.HttpOnly {
		b += "; HttpOnly"
	}
	if c.Secure {
		b += "; Secure"
	}
	if c.SameSite == "None" {
		b += "; SameSite=None"
	} else if c.SameSite == "Lax" {
		b += "; SameSite=Lax"
	} else if c.SameSite == "Strict" {
		b += "; SameSite=Strict"
	}
	if c.Partitioned {
		b += "; Partitioned"
	}
	return b
}

// Headers returns the values of every response header field called k as set so far (Head adds one per call), in order:
// all the Set-Cookie fields of a response, for tests.
fn (w Out) Headers(k str) []str {
	if len(w.extra) == 0 {
		return []str{}
	}
	return header_lines(cast(i64, w.extra)[2], len(w.extra), k)
}

// header_lines are the values of every header field called name in the block [hp, hp+hn).
fn header_lines(hp i64, hn i64, name str) []str {
	mut out = []str{}
	mut p = hp
	let end = hp + hn
	for p < end {
		let e = memchr(p, '\n', end-p)
		if e == 0 {
			break
		}
		let l = e - p
		let k = memchr(p, ':', l)
		if k != 0 && k-p == len(name) {
			mut same = true
			for i in 0..len(name) {
				if lower(load8(p+i)) != lower(name[i]) {
					same = false
					break
				}
			}
			if same {
				mut v = k + 1
				for v < e && (load8(v) == ' ' || load8(v) == '\t') {
					v += 1
				}
				mut ve = e
				for ve > v && (load8(ve-1) == '\r' || load8(ve-1) == ' ') {
					ve -= 1
				}
				out = append(out, rt_str_from_raw(v, ve-v))
			}
		}
		p = e + 1
	}
	return out
}

fn index_byte(s str, c u8) i64 {
	for i in 0..len(s) {
		if s[i] == c {
			return i
		}
	}
	return -1
}

fn trim_ows(s str) str {
	mut a = 0
	mut b = len(s)
	for a < b && (s[a] == ' ' || s[a] == '\t') {
		a += 1
	}
	for b > a && (s[b-1] == ' ' || s[b-1] == '\t') {
		b -= 1
	}
	return s[a:b]
}

// valid_cookie_value_byte is a byte that may be in a cookie value: printable ASCII but the double
// quote, the semicolon and the backslash.
fn valid_cookie_value_byte(b u8) bool {
	return b >= 0x20 && b < 0x7f && b != '"' && b != ';' && b != '\\'
}

// parse_cookie_value strips the quotes of a quoted value and reports whether every byte is valid.
fn parse_cookie_value(raw_in str) (str, bool) {
	mut raw = raw_in
	if len(raw) > 1 && raw[0] == '"' && raw[len(raw)-1] == '"' {
		raw = raw[1:len(raw)-1]
	}
	for i in 0..len(raw) {
		if !valid_cookie_value_byte(raw[i]) {
			return "", false
		}
	}
	return raw, true
}

// keep_bytes is s without the bytes that cannot be in a cookie's value (value true) or path.
fn keep_bytes(s str, value bool) str {
	mut ok = true
	for i in 0..len(s) {
		let c = s[i]
		if value && !valid_cookie_value_byte(c) || !value && !(c >= 0x20 && c < 0x7f && c != ';') {
			ok = false
			break
		}
	}
	if ok {
		return s
	}
	mut out = []u8{}
	for i in 0..len(s) {
		let c = s[i]
		if value && valid_cookie_value_byte(c) || !value && c >= 0x20 && c < 0x7f && c != ';' {
			out = append(out, c)
		}
	}
	return str(out)
}

// sanitize_cookie_value drops the bytes a value cannot have and quotes a value with a space or a
// comma, as Go does.
fn sanitize_cookie_value(v_in str, quoted bool) str {
	let v = keep_bytes(v_in, true)
	if len(v) == 0 {
		return v
	}
	if quoted || index_byte(v, ' ') >= 0 || index_byte(v, ',') >= 0 {
		return "\"" + v + "\""
	}
	return v
}

// valid_cookie_domain reports a domain name (a leading dot allowed) or an IPv4 address.
fn valid_cookie_domain(v str) bool {
	if cookie_domain_name(v) {
		return true
	}
	return ipv4_text(v)
}

fn cookie_domain_name(s_in str) bool {
	mut s = s_in
	if len(s) == 0 || len(s) > 255 {
		return false
	}
	if s[0] == '.' {
		s = s[1:]
	}
	mut last = u8('.')
	mut ok = false
	mut partlen = 0
	for i in 0..len(s) {
		let c = s[i]
		if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') {
			ok = true
			partlen += 1
		} else if c >= '0' && c <= '9' {
			partlen += 1
		} else if c == '-' {
			if last == '.' {
				return false
			}
			partlen += 1
		} else if c == '.' {
			if last == '.' || last == '-' {
				return false
			}
			if partlen > 63 || partlen == 0 {
				return false
			}
			partlen = 0
		} else {
			return false
		}
		last = c
	}
	if last == '-' || partlen > 63 {
		return false
	}
	return ok
}

// ipv4_text reports four decimal parts of 0 to 255 (no leading zeros but "0") separated by dots.
fn ipv4_text(s str) bool {
	mut parts = 0
	mut n = 0
	mut digits = 0
	for i in 0..len(s) + 1 {
		if i == len(s) || s[i] == '.' {
			if digits == 0 {
				return false
			}
			parts += 1
			n = 0
			digits = 0
			continue
		}
		let c = s[i]
		if c < '0' || c > '9' {
			return false
		}
		if digits > 0 && n == 0 {
			return false
		}
		n = n*10 + i64(c-'0')
		digits += 1
		if n > 255 {
			return false
		}
	}
	return parts == 4
}
