// Package syslog writes messages to the system log and to collectors, as Go's log/syslog does: the local Unix socket (/dev/log and
// its fallbacks), Unix datagram and stream sockets, TCP and IPv4 UDP, the priorities and facilities, a collector for the receiving
// side, and a herald sink that writes a log record in the same wire format.
package syslog

import "herald"
import "mint"
import "quarry"
import "say"
import "tide"
import "twine"
import "wire"

// LogEmerg is severity 0: the system is unusable.
const LogEmerg = 0

// LogAlert is severity 1: action must be taken immediately.
const LogAlert = 1

// LogCrit is severity 2: critical conditions.
const LogCrit = 2

// LogErr is severity 3: error conditions.
const LogErr = 3

// LogWarning is severity 4: warning conditions.
const LogWarning = 4

// LogNotice is severity 5: normal but significant conditions.
const LogNotice = 5

// LogInfo is severity 6: informational messages.
const LogInfo = 6

// LogDebug is severity 7: debug-level messages.
const LogDebug = 7

// LogKern is the kernel messages facility.
const LogKern = 0

// LogUser is the user-level messages facility.
const LogUser = 8

// LogMail is the mail system facility.
const LogMail = 16

// LogDaemon is the system daemons facility.
const LogDaemon = 24

// LogAuth is the security and authorization facility.
const LogAuth = 32

// LogSyslog is the facility for messages generated by syslogd.
const LogSyslog = 40

// LogLpr is the line printer subsystem facility.
const LogLpr = 48

// LogNews is the network news subsystem facility.
const LogNews = 56

// LogUucp is the UUCP subsystem facility.
const LogUucp = 64

// LogCron is the clock daemon facility.
const LogCron = 72

// LogAuthpriv is the private security and authorization facility.
const LogAuthpriv = 80

// LogFtp is the FTP daemon facility.
const LogFtp = 88

// LogLocal0 is the first local-use facility.
const LogLocal0 = 128

// LogLocal1 is the second local-use facility.
const LogLocal1 = 136

// LogLocal2 is the third local-use facility.
const LogLocal2 = 144

// LogLocal3 is the fourth local-use facility.
const LogLocal3 = 152

// LogLocal4 is the fifth local-use facility.
const LogLocal4 = 160

// LogLocal5 is the sixth local-use facility.
const LogLocal5 = 168

// LogLocal6 is the seventh local-use facility.
const LogLocal6 = 176

// LogLocal7 is the eighth local-use facility.
const LogLocal7 = 184

const facilityMask = 0xf8
const severityMask = 0x07
const afUnix = 1
const afInet = 2
const sockStream = 1
const sockDgram = 2
const eintr = 4

// Writer is a connection to the system log or to a collector, and the priority, tag and host name of its messages. A Writer belongs
// to one core: give each core its own.
type Writer struct {
	priority i64
	tag      str
	hostname str
	network  str
	raddr    str
	local    bool
	fd       i64
	wc       ?wire.Conn
}

// Dial connects to the collector at raddr over network ("unixgram", "unix", "tcp" or "udp"), or to the local system log when
// network is "" (raddr is then ignored, and /dev/log is tried first). priority is a facility | severity; tag "" means the
// program's name. Like Go's Dial, it fails at once when no connection can be made.
fn Dial(network str, raddr str, priority i64, tag str) !Writer {
	if priority < 0 || priority > LogLocal7|LogDebug {
		fail "log/syslog: invalid priority"
	}
	mut name = tag
	if name == "" {
		let args = quarry.Args()
		if len(args) > 0 {
			name = args[0]
		}
	}
	mut host = quarry.Hostname() catch _ { "" }
	if host == "" {
		host = "localhost"
	}
	mut w = Writer{priority: priority, tag: name, hostname: host, network: network, raddr: raddr, local: true, fd: -1}
	try w.connect()
	return w
}

// New connects to the local system log with the given priority and tag (Go's New).
fn New(priority i64, tag str) !Writer {
	return try Dial("", "", priority, tag)
}

// Write sends b as one message at the writer's priority and returns len(b) (Go's Writer.Write).
fn (w mut Writer) Write(b []u8) !i64 {
	return try w.writeAndRetry(w.priority, str(b))
}

// Emerg sends m at severity LogEmerg.
fn (w mut Writer) Emerg(m str) ! {
	try w.writeAndRetry(LogEmerg, m)
}

// Alert sends m at severity LogAlert.
fn (w mut Writer) Alert(m str) ! {
	try w.writeAndRetry(LogAlert, m)
}

// Crit sends m at severity LogCrit.
fn (w mut Writer) Crit(m str) ! {
	try w.writeAndRetry(LogCrit, m)
}

// Err sends m at severity LogErr.
fn (w mut Writer) Err(m str) ! {
	try w.writeAndRetry(LogErr, m)
}

// Warning sends m at severity LogWarning.
fn (w mut Writer) Warning(m str) ! {
	try w.writeAndRetry(LogWarning, m)
}

// Notice sends m at severity LogNotice.
fn (w mut Writer) Notice(m str) ! {
	try w.writeAndRetry(LogNotice, m)
}

// Info sends m at severity LogInfo.
fn (w mut Writer) Info(m str) ! {
	try w.writeAndRetry(LogInfo, m)
}

// Debug sends m at severity LogDebug.
fn (w mut Writer) Debug(m str) ! {
	try w.writeAndRetry(LogDebug, m)
}

// Herald writes one herald record at the matching severity: LDebug is debug, LInfo info, LWarn warning and LError err. The
// message is the record's text with its key/value pairs, as HeraldMessage formats them.
fn (w mut Writer) Herald(level i64, msg str, kv []str) ! {
	try w.writeAndRetry(heraldSeverity(level), HeraldMessage(msg, kv))
}

// Close closes the connection; the next message connects again (Go's Writer.Close).
fn (w mut Writer) Close() {
	w.drop()
}

// HeraldMessage is a herald record's text without its timestamp, level or core: the message, then " key=value" for each pair. A
// value that is empty or holds a space, a quote, '=', a control byte or a non-ASCII byte is quoted with %q, as herald quotes it.
fn HeraldMessage(msg str, kv []str) str {
	mut b = msg
	mut i = 0
	for i+1 < len(kv) {
		let v = kv[i+1]
		b = b + " " + kv[i] + "="
		if needsQuote(v) {
			b = b + say.Fmt("%q", v)
		} else {
			b = b + v
		}
		i += 2
	}
	return b
}

// Frame returns one message in Go's wire format: "<PRI>TIME HOST TAG[PID]: MSG" for a network connection, and the same without
// HOST for a local one (local is true for the Unix sockets). A newline ends the message unless msg already has one.
fn Frame(local bool, pri i64, ts str, host str, tag str, pid i64, msg str) str {
	mut b = "<" + mint.Itoa(pri) + ">" + ts + " "
	if !local {
		b = b + host + " "
	}
	b = b + tag + "[" + mint.Itoa(pid) + "]: " + msg
	if !twine.HasSuffix(msg, "\n") {
		b = b + "\n"
	}
	return b
}

// heraldSeverity maps a herald level to the syslog severity Go's logger would use for it.
fn heraldSeverity(level i64) i64 {
	if level == herald.LDebug {
		return LogDebug
	}
	if level == herald.LInfo {
		return LogInfo
	}
	if level == herald.LWarn {
		return LogWarning
	}
	return LogErr
}

// needsQuote reports whether a herald pair value must be quoted.
fn needsQuote(v str) bool {
	if len(v) == 0 {
		return true
	}
	for i in 0..len(v) {
		let c = v[i]
		if c <= ' ' || c == '"' || c == '=' || c >= 0x7f {
			return true
		}
	}
	return false
}

// open reports whether the writer holds a connection.
fn (w Writer) open() bool {
	return w.fd >= 0 || w.wc != nil
}

// drop closes the connection, if there is one.
fn (w mut Writer) drop() {
	if w.fd >= 0 {
		rt_sys_close(w.fd)
		w.fd = -1
	}
	if let c = w.wc {
		w.wc = nil
		c.Close()
	}
}

// connect replaces the connection with a new one (Go's Writer.connect).
fn (w mut Writer) connect() ! {
	w.drop()
	if w.network == "" {
		w.fd = try unixSyslog()
		w.local = true
		return
	}
	if w.network == "unixgram" || w.network == "unix" {
		w.fd = try dialUnix(w.network == "unix", w.raddr)
		w.local = true
		return
	}
	if w.network == "udp" {
		w.fd = try dialUDP(w.raddr)
		w.local = false
		return
	}
	if w.network == "tcp" {
		w.wc = try wire.Dial(w.raddr)
		w.local = false
		return
	}
	fail "dial {w.network}: unknown network {w.network}"
}

// writeAndRetry sends msg at severity p over the open connection, or after reconnecting when that fails (Go's writeAndRetry).
fn (w mut Writer) writeAndRetry(p i64, msg str) !i64 {
	let pr = (w.priority & facilityMask) | (p & severityMask)
	if w.open() {
		if w.emit(pr, msg) {
			return i64(len(msg))
		}
	}
	try w.connect()
	if !w.emit(pr, msg) {
		fail "syslog: write failed"
	}
	return i64(len(msg))
}

// emit writes one framed message; it reports false when the connection refused it.
fn (w mut Writer) emit(pr i64, msg str) bool {
	let line = w.frame(pr, msg)
	w.send(line) catch _ {
		return false
	}
	return true
}

// frame formats msg at priority pr with the current time, in the local or network layout (Go's writeString).
fn (w Writer) frame(pr i64, msg str) str {
	let now = tide.Wall()
	let zone = tide.Local()
	if w.local {
		return Frame(true, pr, tide.Format(now, zone, tide.Stamp), w.hostname, w.tag, quarry.Pid(), msg)
	}
	return Frame(false, pr, tide.Format(now, zone, tide.RFC3339), w.hostname, w.tag, quarry.Pid(), msg)
}

// send writes all of data on the connection.
fn (w Writer) send(data str) ! {
	if let c = w.wc {
		try c.Write(data)
		return
	}
	try writeAll(w.fd, data)
}

// writeAll writes all of data to descriptor fd, retrying partial writes and interrupted calls.
fn writeAll(fd i64, data str) ! {
	mut off = 0
	for off < len(data) {
		let k = rt_sys_write(fd, cast(i64, data)+8+off, len(data)-off)
		if k < 0 {
			if rt_errno() == eintr {
				continue
			}
			fail "syslog: write failed"
		}
		off += k
	}
}

// unixSyslog connects to the local system log: datagram sockets first, then streams, each at /dev/log, /var/run/syslog and
// /var/run/log (Go's unixSyslog, on every Unix).
fn unixSyslog() !i64 {
	for network in []str{"unixgram", "unix"} {
		for path in []str{"/dev/log", "/var/run/syslog", "/var/run/log"} {
			let fd = dialUnix(network == "unix", path) catch _ {
				-1
			}
			if fd >= 0 {
				return fd
			}
		}
	}
	fail "Unix syslog delivery error"
}

// dialUnix connects a Unix socket to path: a stream when stream is true, else a datagram socket. A stream is set not to raise
// SIGPIPE, so a dropped collector is an error from the write.
fn dialUnix(stream bool, path str) !i64 {
	mut typ = sockDgram
	if stream {
		typ = sockStream
	}
	let fd = sysSocket(afUnix, typ, 0)
	if fd < 0 {
		fail "syslog: cannot create a socket for {path}"
	}
	let (sa, n) = try sockaddrUnix(path)
	defer free(sa)
	if sysConnect(fd, sa, n) < 0 {
		rt_sys_close(fd)
		fail "syslog: cannot connect to {path}"
	}
	if stream {
		rt_nosigpipe(fd)
	}
	return fd
}

// dialUDP connects an IPv4 datagram socket to addr ("a.b.c.d:port").
fn dialUDP(addr str) !i64 {
	let (sa, n) = try sockaddrInet(addr)
	defer free(sa)
	let fd = sysSocket(afInet, sockDgram, 0)
	if fd < 0 {
		fail "syslog: cannot create a UDP socket"
	}
	if sysConnect(fd, sa, n) < 0 {
		rt_sys_close(fd)
		fail "syslog: cannot connect to {addr}"
	}
	return fd
}

// sockaddrInet builds the IPv4 socket address of addr ("a.b.c.d:port"), a numeric address only (names are not resolved).
fn sockaddrInet(addr str) !(i64, i64) {
	let parts = twine.Split(addr, ":")
	if len(parts) != 2 {
		fail "syslog: address {addr} is not host:port"
	}
	let octets = twine.Split(parts[0], ".")
	if len(octets) != 4 {
		fail "syslog: {parts[0]} is not an IPv4 address (names are not resolved)"
	}
	mut ip = i64(0)
	for o in octets {
		let v = try mint.Atoi(o)
		if v < 0 || v > 255 {
			fail "syslog: {parts[0]} is not an IPv4 address"
		}
		ip = ip<<8 | v
	}
	let port = try mint.Atoi(parts[1])
	if port < 0 || port > 65535 {
		fail "syslog: port {parts[1]} is out of range"
	}
	let sa = calloc(1, 16)
	rt_sockaddr_in(sa, ip, port)
	return sa, rt_sockaddr_len(sa)
}
