// Region pass: request memory must never be reachable from long-lived memory.
//
// Every request allocates from its core's pool (ember), which is wiped when the request
// ends; globals and everything they hold live in the core's ingot heap. The pass gives
// each expression a set of region bits and rejects any store of a possibly-ember pointer
// into a container that may be long-lived, unless the value went through keep().
// A container that is not long-lived may still hold long-lived or parameter objects (a
// fresh slice holding a global's struct): the pass records, per type, the origins stored
// into such containers (rg_hold), and reads of that type out of them carry those origins.
// Functions are summarized (which parameters they store into and what they store, what
// their containers hold, and where their results come from) and the summaries are
// iterated to a fixed point.
const RG_FRESH = 1 // may be a fresh allocation from the current request's pool
const RG_INGOT = 2 // may be long-lived (a global or something reachable from one)
const RG_UNK = 4 // origin unknown: treated as long-lived when stored into
const RG_EMB = 8 // the value may point into request memory
const RG_OUT = 16 // in an arena's closure: made outside the arena (#236)
const RG_P0 = 256 // derived from parameter i: bit 8 + i
const RG_MAXP = 48

const F_REGSUM = 26 // [sink param bits, held pairs, result bits 0..7, sink records, store records]

shared mut rg_fn i64
shared mut rg_sum i64
shared mut rg_report i64
shared mut rg_changed i64 // a summary grew: another round is needed
shared mut rg_lchanged i64 // a local's bits grew
shared mut rg_nparams i64
shared mut rg_multi Vec[i64] // per-result bits of the last call (for ST_CALLMULTI)
shared mut rg_modrep i64 // parameters already reported as modified
shared mut rg_held Vec[i64] // [type, bits] pairs: origins held by containers that may not be long-lived
shared mut rg_fnsum i64 // the summaries of all functions used as values, joined (indirect calls)
shared mut rs_active i64 // the use-after-reset walk is running (rs_walk)
shared mut rs_dead Vec[i64] // locals that may hold request memory from before a hearth.Reset()
shared mut rs_said Vec[i64] // locals already reported
shared mut rs_cur Vec[i64] // [local, bits] of each local's latest assignment on the walk (else S_REGION)

fn has_ptr(t Ty) i64 {
	let k = kind_of(t)
	if k == K_OPT {
		return has_ptr(cast(Ty, t.elem))
	}
	if k == K_DYN {
		// A dyn value's bits are its object's; the table is static.
		return 1
	}
	return i64(k == K_STRING || k == K_STRUCT || k == K_SLICE || k == K_MAP || k == K_ERROR || k == K_FUNC)
}

fn rg_analyzable(f Fn) i64 {
	return i64(f.extern_ == 0 && f.body != 0 && f.generated == 0 && is_template(f) == 0)
}

fn is_keep_fn(f Fn) i64 {
	let n = f.qname
	return i64(n != 0 && i64(load8(n)) == 'k' && i64(load8(n + 1)) == 'e' && i64(load8(n + 2)) == 'e' && i64(load8(n + 3)) == 'p' && i64(load8(n + 4)) == '$')
}

fn region_check() {
	mut i = 0
	for i < prog_fns.len {
		let f = vec_get(prog_fns, i)
		if rg_analyzable(f) != 0 {
			f.regsum = rg_sum_new()
		}
		i = i + 1
	}
	rg_fnsum = rg_sum_new()
	mut round = 0
	rg_changed = 1
	for rg_changed != 0 && round < 60 {
		rg_changed = 0
		i = 0
		for i < prog_fns.len {
			let f = vec_get(prog_fns, i)
			if f.regsum != 0 && f.reach != 0 {
				rg_fn_pass(f, 0)
			}
			i = i + 1
		}
		round = round + 1
	}
	i = 0
	for i < prog_fns.len {
		let f = vec_get(prog_fns, i)
		if f.regsum != 0 && f.reach != 0 {
			rg_fn_pass(f, 1)
		}
		i = i + 1
	}
	with_body_check()
}

fn rg_sum_new() i64 {
	let sum = calloc(13, 8) // [12]: the function resets the request pool (hearth.Reset)
	sum[1] = cast(i64, vec_new[i64]())
	sum[10] = cast(i64, vec_new[i64]())
	sum[11] = cast(i64, vec_new[i64]())
	return sum
}

fn rg_fn_pass(f Fn, report i64) {
	rg_fn = cast(i64, f)
	rg_sum = f.regsum
	if is_keep_fn(f) != 0 {
		rg_sum[2] = RG_INGOT
		return
	}
	set_file(f.file)
	rg_report = 0
	let locals = cast(Vec[i64], f.locals)
	rg_nparams = cast(Vec[i64], f.params).len
	mut i = 0
	for i < locals.len {
		let s = cast(Sym, vec_get(locals, i))
		// A captured local also holds what frame-local closures stored into it.
		s.region = s.capbits
		if i < rg_nparams && has_ptr(cast(Ty, s.type_)) != 0 {
			s.region = RG_EMB | RG_UNK
			if i < RG_MAXP {
				s.region = RG_EMB | (RG_P0 << i)
			}
		}
		i = i + 1
	}
	rg_held = vec_new[i64]()
	mut iter = 0
	rg_lchanged = 1
	for rg_lchanged != 0 && iter < 30 {
		rg_lchanged = 0
		rg_stmts(cast(Block, f.body).stmts)
		iter = iter + 1
	}
	// Callers can reach what is held only through the parameters and results.
	i = 0
	for i < rg_held.len {
		let t = vec_get(rg_held, i)
		if rg_visible(f, t) != 0 && rg_merge(cast(Vec[i64], rg_sum[1]), t, vec_get(rg_held, i + 1)) != 0 {
			rg_changed = 1
		}
		i = i + 2
	}
	if report != 0 && vec_get(file_trusted, f.file) == 0 {
		rg_report = 1
		rg_modrep = 0
		rg_stmts(cast(Block, f.body).stmts)
		rg_detach_check(cast(i64, f))
		rg_report = 0
		if rg_sum[12] != 0 {
			rs_walk(f)
		}
	}
}

fn rg_stmts(v Vec[i64]) {
	mut i = 0
	for i < v.len {
		rg_stmt(vec_get(v, i))
		i = i + 1
	}
}

fn rg_local(s Sym, bits i64) {
	if has_ptr(cast(Ty, s.type_)) == 0 {
		return
	}
	if (s.region | bits) != s.region {
		s.region = s.region | bits
		rg_lchanged = 1
	}
}

fn rg_assign_sym(s Sym, bits i64, pos i64) {
	if s.kind == SYM_LOCAL {
		rg_local(s, bits)
	} else if s.kind == SYM_GLOBAL {
		rg_store(RG_INGOT, 0, 0, bits, 0, pos, s.name)
	}
}

fn rg_stmt(s i64) {
	let k = cast(Node, s).kind
	if k == ST_BLOCK {
		rg_stmts(cast(Block, s).stmts)
	} else if k == ST_LET {
		if cast(LetStmt, s).init != 0 {
			rg_local(cast(Sym, cast(LetStmt, s).sym), rg_expr(cast(LetStmt, s).init))
		}
	} else if k == ST_ASSIGN {
		let t = cast(AssignStmt, s).target
		let v = rg_expr(cast(AssignStmt, s).value)
		rg_note_kept(t, v)
		let tk = cast(Node, t).kind
		if tk == EX_IDENT {
			rg_assign_sym(cast(Sym, cast(IdentExpr, t).ref), v, cast(Node, s).pos)
		} else if rg_regrow(t, cast(AssignStmt, s).value) != 0 {
			// The slot gets back the object it held; the append checked what it added.
		} else if tk == EX_MEM && rg_cell_index(cast(MemExpr, t).base) >= 0 {
			rg_cell_store(rg_cell_index(cast(MemExpr, t).base), v, cast(Node, t).type_, cast(Node, s).pos)
		} else if tk == EX_MEM && rg_own_cell(t) != 0 {
			// The parent's own store into a variable it keeps in a cell.
			rg_local(cast(Sym, rg_own_cell(t)), v)
		} else if tk == EX_MEM {
			let c = rg_expr(cast(MemExpr, t).base)
			if cast(MemExpr, t).index != 0 {
				rg_expr(cast(MemExpr, t).index)
			}
			rg_store(c, rg_owner(cast(MemExpr, t).base), rg_key(cast(Node, cast(MemExpr, t).base).type_), v, cast(Node, t).type_, cast(Node, s).pos, 0)
		} else if tk == EX_ELEM {
			let c2 = rg_expr(cast(ElemExpr, t).seq)
			rg_expr(cast(ElemExpr, t).idx)
			rg_store(c2, rg_owner(cast(ElemExpr, t).seq), rg_key(cast(Node, cast(ElemExpr, t).seq).type_), v, cast(Node, t).type_, cast(Node, s).pos, 0)
		} else {
			rg_expr(t)
		}
	} else if k == ST_EXPR {
		rg_expr(cast(ExprStmt, s).x)
	} else if k == ST_IF {
		rg_expr(cast(IfStmt, s).cond)
		rg_stmts(cast(Block, cast(IfStmt, s).then).stmts)
		if cast(IfStmt, s).else_ != 0 {
			rg_stmt(cast(IfStmt, s).else_)
		}
	} else if k == ST_WHILE {
		rg_expr(cast(WhileStmt, s).cond)
		rg_stmts(cast(Block, cast(WhileStmt, s).body).stmts)
		if cast(WhileStmt, s).post != 0 {
			rg_stmt(cast(WhileStmt, s).post)
		}
	} else if k == ST_RETURN {
		if cast(ReturnStmt, s).value != 0 {
			rg_result(0, rg_expr(cast(ReturnStmt, s).value))
		}
		if cast(i64, cast(ReturnStmt, s).values) != 0 {
			mut i = 0
			for i < cast(ReturnStmt, s).values.len {
				rg_result(i, rg_expr(vec_get(cast(ReturnStmt, s).values, i)))
				i = i + 1
			}
		}
	} else if k == ST_CALLMULTI {
		rg_expr(cast(CallMultiStmt, s).call)
		let bits = rg_multi
		let syms = cast(CallMultiStmt, s).syms
		mut j = 0
		for j < syms.len {
			let sy = vec_get(syms, j)
			if cast(i64, sy) != 0 {
				mut b = RG_UNK | RG_EMB
				if cast(i64, bits) != 0 && j < 8 {
					b = vec_get(bits, j)
				}
				rg_assign_sym(cast(Sym, sy), b, cast(Node, s).pos)
			}
			j = j + 1
		}
	}
}

// rg_regrow reports whether x appends onto the slot target t names: append grows the
// header in place and returns it, so storing the result back changes nothing.
fn rg_regrow(t i64, x_in i64) i64 {
	mut x = x_in
	for cast(Node, x).kind == EX_CALL && cast(Call, x).name != 0 && (streq(cast(Call, x).name, cstr("rt_append")) != 0 || streq(cast(Call, x).name, cstr("rt_append_rc")) != 0 || streq(cast(Call, x).name, cstr("rt_slice_appendn")) != 0 || streq(cast(Call, x).name, cstr("rt_slice_appendn_rc")) != 0 || streq(cast(Call, x).name, cstr("rt_append_str")) != 0) {
		x = vec_get(cast(Call, x).args, 0)
	}
	return rg_same(t, x)
}

// rg_same reports whether two expressions name the same slot: one variable, or the same
// field or element of the same slot, indexed by one variable or constant.
fn rg_same(a i64, b i64) i64 {
	let k = cast(Node, a).kind
	if k != cast(Node, b).kind {
		return 0
	}
	if k == EX_IDENT {
		return i64(cast(IdentExpr, a).ref != 0 && cast(IdentExpr, a).ref == cast(IdentExpr, b).ref)
	}
	if k == EX_INT {
		return i64(cast(IntLit, a).val == cast(IntLit, b).val)
	}
	if k == EX_MEM {
		return i64(cast(MemExpr, a).index == 0 && cast(MemExpr, b).index == 0 && cast(MemExpr, a).off == cast(MemExpr, b).off && rg_same(cast(MemExpr, a).base, cast(MemExpr, b).base) != 0)
	}
	if k == EX_ELEM {
		return i64(rg_same(cast(ElemExpr, a).seq, cast(ElemExpr, b).seq) != 0 && rg_same(cast(ElemExpr, a).idx, cast(ElemExpr, b).idx) != 0)
	}
	return 0
}

fn rg_result(i i64, bits i64) {
	if i >= 8 {
		return
	}
	if (rg_sum[2 + i] | bits) != rg_sum[2 + i] {
		rg_sum[2 + i] = rg_sum[2 + i] | bits
		rg_changed = 1
	}
}

// rg_load is what a pointer of type t read out of a container with bits b may be: anything
// held by long-lived memory is long-lived (the pass keeps it so); anything else may be
// ember, or whatever such containers were given (rg_hold).
fn rg_load(b i64, t i64) i64 {
	mut r = b & ~RG_EMB
	if (b & ~RG_INGOT) != 0 {
		r = r | RG_EMB
	}
	if b != RG_INGOT {
		r = r | rg_lookup(rg_held, rg_key(t))
	}
	return r
}

// rg_key is the type held objects are filed under: an optional holds the same objects as
// its element. Strings and faults cannot be modified, so where they come from no longer
// matters once they are in a container: 0.
fn rg_key(t_in i64) i64 {
	mut t = cast(Ty, t_in)
	if kind_of(t) == K_OPT {
		t = cast(Ty, t.elem)
	}
	let k = kind_of(t)
	if k == K_STRUCT || k == K_SLICE || k == K_MAP || k == K_DYN {
		return cast(i64, t)
	}
	return 0
}

// rg_owner is the type of the object an expression reads out of (a field's struct, an
// element's slice), or 0 when the expression is not such a read.
fn rg_owner(e i64) i64 {
	let k = cast(Node, e).kind
	if k == EX_MEM && has_ptr(cast(Ty, cast(Node, cast(MemExpr, e).base).type_)) != 0 {
		return rg_key(cast(Node, cast(MemExpr, e).base).type_)
	}
	if k == EX_ELEM {
		return rg_key(cast(Node, cast(ElemExpr, e).seq).type_)
	}
	return 0
}

// rg_merge adds bits to type t's entry in the pair vector h and reports whether it grew.
fn rg_merge(h Vec[i64], t i64, bits i64) i64 {
	mut i = 0
	for i < h.len {
		if vec_get(h, i) == t {
			let old = vec_get(h, i + 1)
			h.data[i + 1] = old | bits
			return i64((old | bits) != old)
		}
		i = i + 2
	}
	vec_push(h, t)
	vec_push(h, bits)
	return 1
}

fn rg_lookup(h Vec[i64], t i64) i64 {
	mut i = 0
	for t != 0 && i < h.len {
		if vec_get(h, i) == t {
			return vec_get(h, i + 1)
		}
		i = i + 2
	}
	return 0
}

// rg_hold records that a container that may not be long-lived now holds a value of type t
// with bits v. Fresh and ember origins are what reads out of such a container give anyway;
// long-lived, unknown and parameter origins must come back out with the value.
fn rg_hold(t i64, v i64) {
	let k = rg_key(t)
	let b = v & ~(RG_FRESH | RG_EMB)
	if k != 0 && b != 0 && rg_merge(rg_held, k, b) != 0 {
		rg_lchanged = 1
	}
}

// rg_reaches reports whether a value of type from leads, through one or more fields,
// elements or map values, to an object of key type to (seen guards recursive types).
fn rg_reaches(from_in i64, to i64, seen Vec[i64]) i64 {
	mut from = cast(Ty, from_in)
	if kind_of(from) == K_OPT {
		from = cast(Ty, from.elem)
	}
	if vec_index(seen, cast(i64, from)) >= 0 {
		return 0
	}
	vec_push(seen, cast(i64, from))
	let k = kind_of(from)
	if k == K_SLICE || k == K_MAP {
		return i64(rg_key(from.elem) == to || rg_reaches(from.elem, to, seen) != 0)
	}
	mut i = 0
	for k == K_STRUCT && from.fields != 0 && i < cast(Vec[i64], from.fields).len {
		let t = field_type(from, i)
		if rg_key(t) == to || rg_reaches(t, to, seen) != 0 {
			return 1
		}
		i = i + 1
	}
	return 0
}

// rg_deep widens the bits b of an argument of type t with the held pairs reachable from t
// (what the containers inside it may hold) that lie on a way to an object of type v held
// by an object of type o (o 0: by anything; o and v 0: any object inside the argument).
fn rg_deep(b_in i64, t i64, o i64, v i64) i64 {
	mut b = b_in
	if b == RG_INGOT {
		// Long-lived memory holds only long-lived memory.
		return b
	}
	mut i = 0
	for i < rg_held.len {
		let h = vec_get(rg_held, i)
		mut on_ = i64((o == 0 && v == 0) || h == o || h == v)
		if on_ == 0 && o != 0 {
			on_ = rg_reaches(h, o, vec_new[i64]())
		} else if on_ == 0 {
			on_ = rg_reaches(h, v, vec_new[i64]())
		}
		if on_ != 0 && rg_reaches(t, h, vec_new[i64]()) != 0 {
			b = b | vec_get(rg_held, i + 1)
		}
		i = i + 2
	}
	return b
}

// rg_visible reports whether f's callers can reach objects of key type t: through its
// parameters or its results.
fn rg_visible(f Fn, t i64) i64 {
	mut i = 0
	for i < cast(Vec[i64], f.ptypes).len {
		let p = vec_get(cast(Vec[i64], f.ptypes), i)
		if rg_key(p) == t || rg_reaches(p, t, vec_new[i64]()) != 0 {
			return 1
		}
		i = i + 1
	}
	i = 0
	for i < cast(Vec[i64], f.rtypes).len {
		let r = vec_get(cast(Vec[i64], f.rtypes), i)
		if rg_key(r) == t || rg_reaches(r, t, vec_new[i64]()) != 0 {
			return 1
		}
		i = i + 1
	}
	return 0
}

// rg_record notes in recs, triples [param, holder type, type], that the function stores
// into an object of type t held by an object of type o (0: unknown) inside parameter i.
fn rg_record(recs Vec[i64], i i64, o i64, t i64) {
	mut j = 0
	for j < recs.len {
		if vec_get(recs, j) == i && vec_get(recs, j + 1) == o && vec_get(recs, j + 2) == t {
			return
		}
		j = j + 3
	}
	vec_push(recs, i)
	vec_push(recs, o)
	vec_push(recs, t)
	rg_changed = 1
}

fn rg_param_name(i i64) i64 {
	return vec_get(cast(Fn, rg_fn).locals, i).name
}

// rg_store checks a store of a value with bits v and type t into a container with bits c,
// an object of type ct held by an object of type co (see rg_record).
fn rg_store(c i64, co i64, ct i64, v i64, t i64, pos i64, gname i64) {
	mut i = 0
	for i < rg_nparams && i < RG_MAXP {
		if (c & (RG_P0 << i)) != 0 {
			if rg_report != 0 && vec_get(cast(Vec[i64], cast(Fn, rg_fn).muts), i) == 0 && (rg_modrep & (1 << i)) == 0 {
				rg_modrep = rg_modrep | (1 << i)
				err_code_quoted(pos, cstr("E701 NOT_MUT"), cstr("cannot modify parameter "), rg_param_name(i), cstr(": declare it mut"))
			}
			rg_record(cast(Vec[i64], rg_sum[11]), i, co, ct)
		}
		i = i + 1
	}
	if c != RG_INGOT {
		rg_hold(t, v)
	}
	if (v & RG_EMB) == 0 {
		return
	}
	if v != RG_EMB {
		// A call's stores (rg_pass gives them RG_EMB) are checked by rg_arena_call.
		rg_arena_store(c, v, pos)
	}
	if (c & (RG_INGOT | RG_UNK)) != 0 && rg_report != 0 {
		if gname != 0 {
			err_code_quoted(pos, cstr("E310 REQUEST_ESCAPE"), cstr("request memory stored into global "), gname, cstr(", which outlives the request: wrap the value in keep()"))
		} else {
			err_code_at(pos, cstr("E310 REQUEST_ESCAPE"), cstr("request memory stored into long-lived memory (it may be reachable from a global): wrap the value in keep()"))
		}
	}
	i = 0
	for i < rg_nparams && i < RG_MAXP {
		if (c & (RG_P0 << i)) != 0 {
			if (rg_sum[0] & (1 << i)) == 0 {
				rg_sum[0] = rg_sum[0] | (1 << i)
				rg_changed = 1
			}
			rg_record(cast(Vec[i64], rg_sum[10]), i, co, ct)
		}
		i = i + 1
	}
}

// rg_own_cell is the variable e reads or writes when e is the word of a cell the running
// function made for one of its own variables, which no closure that may be kept captures; or 0.
fn rg_own_cell(e i64) i64 {
	if cast(Node, e).kind != EX_MEM || cast(MemExpr, e).index != 0 || cast(MemExpr, e).off != 0 {
		return 0
	}
	let b = cast(MemExpr, e).base
	if cast(Node, b).kind != EX_IDENT || cast(IdentExpr, b).ref == 0 {
		return 0
	}
	let os = cast(Sym, cast(IdentExpr, b).ref).cell_of
	if os == 0 || cast(Sym, os).kept_cap != 0 {
		return 0
	}
	return os
}

// rg_cell_index is i when e is the address of captured variable i, read from the closure's
// environment ($env word 2 + i), or -1.
fn rg_cell_index(e i64) i64 {
	if cast(Fn, rg_fn).parent == 0 || cast(Fn, rg_fn).env_sym == 0 || cast(Node, e).kind != EX_MEM || cast(MemExpr, e).index != 0 {
		return -1
	}
	let b = cast(MemExpr, e).base
	if cast(Node, b).kind != EX_IDENT || cast(IdentExpr, b).ref != cast(Fn, rg_fn).env_sym || cast(MemExpr, e).off < 16 {
		return -1
	}
	return cast(MemExpr, e).off / 8 - 2
}

// rg_cell_bits is what captured variable i may hold. A closure that is only passed to functions
// that call it (sift.Each and the like) lives no longer than its parent's frame: the variable
// holds what the parent and such closures put there. Any other closure may be kept, which copies
// its variables into long-lived memory, so their origin is unknown.
fn rg_cell_bits(i i64) i64 {
	if cast(Fn, rg_fn).escapes != 0 {
		return RG_UNK | RG_EMB
	}
	let os = vec_get(cast(Fn, rg_fn).captures, i)
	if cast(i64, os) == 0 || os.captured != 0 {
		return RG_UNK | RG_EMB
	}
	if rg_is_arena(rg_fn) != 0 {
		// Made outside the arena: what it holds is not the arena's fresh memory.
		return ((os.region | os.capbits) & ~RG_FRESH) | RG_OUT
	}
	return os.region | os.capbits
}

// rg_cell_store checks an assignment of bits v to captured variable i. In a frame-local closure
// the variable is the parent's local: the bits join it. A closure that may be kept must not
// store request memory there: once kept, its variables are long-lived (#171).
fn rg_cell_store(i i64, v_in i64, t i64, pos i64) {
	mut v = v_in
	if rg_in_arena() != 0 {
		v = rg_arena_cell_store(i, v, t, pos)
	}
	if cast(Fn, rg_fn).escapes != 0 {
		if (v & RG_EMB) != 0 && has_ptr(cast(Ty, t)) != 0 && rg_report != 0 {
			let os = vec_get(cast(Fn, rg_fn).captures, i)
			mut name = cstr("a captured variable")
			if cast(i64, os) != 0 {
				name = os.name
			}
			err_code_quoted(pos, cstr("E311 CAPTURE_ESCAPE"), cstr("request memory stored into "), name, cstr(", a captured variable of a closure that may outlive the request (keep() copies its variables into long-lived memory): wrap the value in keep(), or pass the closure only to functions that call it"))
		}
		return
	}
	let os = vec_get(cast(Fn, rg_fn).captures, i)
	if cast(i64, os) != 0 && os.captured == 0 && (os.capbits | v) != os.capbits {
		os.capbits = os.capbits | v
		rg_changed = 1
	}
}

fn rg_expr(e i64) i64 {
	let k = cast(Node, e).kind
	if k == EX_IDENT {
		let s = cast(Sym, cast(IdentExpr, e).ref)
		if cast(i64, s) == 0 {
			return 0
		}
		if s.kind == SYM_LOCAL {
			if rs_active != 0 && vec_has(rs_dead, cast(i64, s)) != 0 && vec_has(rs_said, cast(i64, s)) == 0 {
				vec_push(rs_said, cast(i64, s))
				err_code_quoted(cast(Node, e).pos, cstr("E313 USE_AFTER_RESET"), cstr(""), s.name, cstr(" may hold request memory from before hearth.Reset(), which freed it, and is read after the reset: keep() the value before the reset, or create it after"))
			}
			return s.region
		}
		if s.kind == SYM_GLOBAL {
			return RG_INGOT
		}
		return 0
	}
	if k == EX_UNARY {
		rg_expr(cast(Unary, e).x)
		return 0
	}
	if k == EX_BINARY {
		rg_expr(cast(Binary, e).l)
		rg_expr(cast(Binary, e).r)
		if has_ptr(cast(Ty, cast(Node, e).type_)) != 0 {
			return RG_FRESH | RG_EMB
		}
		return 0
	}
	if k == EX_CONV {
		let x = rg_expr(cast(Conv, e).x)
		if cast(Conv, e).kind == CV_DYN_KEEP {
			return RG_INGOT
		}
		if has_ptr(cast(Ty, cast(Node, e).type_)) != 0 && has_ptr(cast(Ty, cast(Node, cast(Conv, e).x).type_)) == 0 {
			// A raw word turned into a reference (standard library only): origin unknown.
			return x | RG_UNK | RG_EMB
		}
		return x
	}
	if k == EX_MEM && rg_cell_index(e) >= 0 {
		rg_detach_read(rg_cell_index(e))
		return 0
	}
	if k == EX_MEM && rg_cell_index(cast(MemExpr, e).base) >= 0 {
		rg_detach_read(rg_cell_index(cast(MemExpr, e).base))
		if has_ptr(cast(Ty, cast(Node, e).type_)) == 0 {
			return 0
		}
		return rg_cell_bits(rg_cell_index(cast(MemExpr, e).base))
	}
	if k == EX_MEM && rg_own_cell(e) != 0 {
		// The parent reading a variable it keeps in a cell for closures that cannot outlive it
		// (frame-local ones and a scope's children): the variable holds what was stored in it.
		let os = cast(Sym, rg_own_cell(e))
		if has_ptr(cast(Ty, cast(Node, e).type_)) == 0 {
			return 0
		}
		return os.region | os.capbits
	}
	if k == EX_MEM {
		let b = rg_expr(cast(MemExpr, e).base)
		if cast(MemExpr, e).index != 0 {
			rg_expr(cast(MemExpr, e).index)
		}
		if cast(MemExpr, e).len != 0 {
			rg_expr(cast(MemExpr, e).len)
		}
		if has_ptr(cast(Ty, cast(Node, e).type_)) == 0 {
			return 0
		}
		if has_ptr(cast(Ty, cast(Node, cast(MemExpr, e).base).type_)) == 0 {
			return b | RG_UNK | RG_EMB
		}
		return rg_load(b, cast(Node, e).type_)
	}
	if k == EX_ELEM {
		let b2 = rg_expr(cast(ElemExpr, e).seq)
		rg_expr(cast(ElemExpr, e).idx)
		if has_ptr(cast(Ty, cast(Node, e).type_)) == 0 {
			return 0
		}
		return rg_load(b2, cast(Node, e).type_)
	}
	if k == EX_SEQ {
		if rs_active != 0 {
			// the reset walk: a let in the sequence is a fresh assignment, after any reset
			rs_stmts(cast(SeqExpr, e).stmts)
		} else {
			rg_stmts(cast(SeqExpr, e).stmts)
		}
		let v = rg_expr(cast(SeqExpr, e).value)
		if cast(Node, e).region == R_OWNED {
			return RG_INGOT
		}
		if has_ptr(cast(Ty, cast(Node, e).type_)) != 0 {
			return v | RG_FRESH | RG_EMB
		}
		return v
	}
	if k == EX_CALL {
		return rg_call(e)
	}
	if k == EX_FUNCREF && cast(Fn, cast(FuncRef, e).fn_).regsum != 0 {
		// A call through a function value may run this function.
		let g = cast(Fn, cast(FuncRef, e).fn_).regsum
		mut i = 0
		for i < cast(Vec[i64], g[1]).len {
			if rg_merge(cast(Vec[i64], rg_fnsum[1]), vec_get(cast(Vec[i64], g[1]), i), vec_get(cast(Vec[i64], g[1]), i + 1)) != 0 {
				rg_changed = 1
			}
			i = i + 2
		}
		i = 0
		for i < cast(Vec[i64], g[10]).len {
			rg_record(cast(Vec[i64], rg_fnsum[10]), vec_get(cast(Vec[i64], g[10]), i), vec_get(cast(Vec[i64], g[10]), i + 1), vec_get(cast(Vec[i64], g[10]), i + 2))
			i = i + 3
		}
		i = 0
		for i < cast(Vec[i64], g[11]).len {
			rg_record(cast(Vec[i64], rg_fnsum[11]), vec_get(cast(Vec[i64], g[11]), i), vec_get(cast(Vec[i64], g[11]), i + 1), vec_get(cast(Vec[i64], g[11]), i + 2))
			i = i + 3
		}
		return 0
	}
	if k == EX_INDEX {
		rg_expr(cast(IndexExpr, e).x)
		rg_expr(cast(IndexExpr, e).i)
		return 0
	}
	return 0
}

// ---- detach captures only long-lived memory (#232) ----
shared mut rg_in_keep i64 // evaluating keep()'s argument
shared mut rg_detach_raw Vec[i64] // [detached closure, bits]: captures it reads other than inside keep()
shared mut rg_kept_bits Vec[i64] // [variable a kept closure captures, what was stored into its cell]

// rg_detach_read notes that the running function, when a detach block, reads its capture i.
fn rg_detach_read(i_in i64) {
	mut i = i_in
	if rg_in_keep != 0 || cast(i64, ck_detached) == 0 || vec_has(cast(Vec[i64], ck_detached), rg_fn) == 0 {
		return
	}
	if cast(i64, rg_detach_raw) == 0 {
		rg_detach_raw = vec_new[i64]()
	}
	if i > 62 {
		i = 62
	}
	rg_merge(rg_detach_raw, rg_fn, 1 << i)
}

// rg_note_kept records what an assignment stores into the cell of a variable that a closure
// which may be kept captures (reads of it go through the cell, so its bits are not tracked).
fn rg_note_kept(t i64, v i64) {
	if cast(Node, t).kind != EX_MEM || cast(MemExpr, t).index != 0 || cast(MemExpr, t).off != 0 || cast(Node, cast(MemExpr, t).base).kind != EX_IDENT || cast(IdentExpr, cast(MemExpr, t).base).ref == 0 {
		return
	}
	let os = cast(Sym, cast(IdentExpr, cast(MemExpr, t).base).ref).cell_of
	if os == 0 || cast(Sym, os).kept_cap == 0 {
		return
	}
	if cast(i64, rg_kept_bits) == 0 {
		rg_kept_bits = vec_new[i64]()
	}
	rg_merge(rg_kept_bits, os, v)
}

// rg_capture_bits is what variable os of the running function (or its capture) may hold.
fn rg_capture_bits(os Sym) i64 {
	if os.captured != 0 {
		return rg_cell_bits(os.cap_idx)
	}
	mut b = os.region | os.capbits
	if cast(i64, rg_kept_bits) != 0 {
		b = b | rg_lookup(rg_kept_bits, cast(i64, os))
	}
	return b
}

// rg_detach_check reports what a detach block in f captures that may hold request memory:
// the detached task outlives the request, so the capture must be long-lived already
// (keep() it first), unless the block reads it only inside keep() (design_semantics §6).
fn rg_detach_check(f i64) {
	mut i = 0
	for cast(i64, ck_detached) != 0 && i < ck_detached.len {
		let d = cast(Fn, vec_get(cast(Vec[i64], ck_detached), i))
		let caps = cast(Vec[i64], d.captures)
		mut raw = 0
		if cast(i64, rg_detach_raw) != 0 {
			raw = rg_lookup(rg_detach_raw, cast(i64, d))
		}
		mut j = 0
		for cast(Fn, d).parent == f && cast(i64, caps) != 0 && j < caps.len {
			let os = cast(Sym, vec_get(caps, j))
			mut bit = 62
			if j < 62 {
				bit = j
			}
			if cast(i64, os) != 0 && (raw & (1 << bit)) != 0 && has_ptr(cast(Ty, os.type_)) != 0 && (rg_capture_bits(cast(Sym, os)) & RG_EMB) != 0 {
				err_code_quoted(d.pos, cstr("E314 DETACH_ESCAPE"), cstr("detach captures "), os.name, cstr(", which may hold request memory, but the detached task outlives the request: keep() it before the block (let v = keep(...)), or read it in the block only inside keep()"))
			}
			j = j + 1
		}
		i = i + 1
	}
}

// ---- arena: nothing made in it leaves it (#236, notes/interface_arena.md §7) ----
//
// An arena's closure reads its captured variables as RG_OUT (made outside the arena) instead
// of RG_FRESH, so fresh bits there are the arena's own memory. Storing that into an object
// from outside, or into a captured variable, is E315; so is growing (append, map insert) a
// slice or map from outside, since the new array or table would be allocated in the arena.
shared mut rg_grows Vec[i64] // [function, parameter bits]: the parameters (and what they hold) it may grow
shared mut rg_fstores Vec[i64] // [function, parameter bits]: the parameters it may store its own fresh memory into
shared mut rg_pstores Vec[i64] // [function, parameter i, parameter bits]: the parameters it may store into parameter i

fn rg_is_arena(f i64) i64 {
	return i64(cast(i64, ck_arenas) != 0 && vec_has(ck_arenas, f) != 0)
}

// rg_in_arena reports whether the running function is an arena's closure or one inside it.
fn rg_in_arena() i64 {
	mut f = cast(Fn, rg_fn)
	for cast(i64, f) != 0 {
		if rg_is_arena(cast(i64, f)) != 0 {
			return 1
		}
		f = cast(Fn, f.parent)
	}
	return 0
}

// rg_arena_made reports whether a value with bits v may be memory made in the arena.
fn rg_arena_made(v i64) i64 {
	return i64((v & RG_FRESH) != 0 || ((v & RG_EMB) != 0 && (v & RG_OUT) == 0))
}

fn rg_arena_escape(pos i64, name i64) {
	err_code_quoted(pos, cstr("E315 ARENA_ESCAPE"), cstr("memory made in an arena stored into "), name, cstr(", a variable from outside it, which outlives the arena: make the value the arena block's result (it is copied out), or keep() it"))
}

// rg_arena_cell_store checks a store of bits v into captured variable i inside an arena and
// returns the bits that join the variable (RG_OUT means nothing outside the arena).
fn rg_arena_cell_store(i i64, v i64, t i64, pos i64) i64 {
	let os = vec_get(cast(Fn, rg_fn).captures, i)
	let outside = i64(rg_is_arena(rg_fn) != 0 || (cast(i64, os) != 0 && os.captured != 0 && rg_is_arena(cast(Fn, rg_fn).parent) != 0))
	if outside != 0 && cast(Fn, rg_fn).escapes == 0 && has_ptr(cast(Ty, t)) != 0 && rg_arena_made(v) != 0 && rg_report != 0 {
		mut name = cstr("a captured variable")
		if cast(i64, os) != 0 {
			name = os.name
		}
		rg_arena_escape(pos, name)
	}
	return v & ~RG_OUT
}

fn rg_grows_op(name i64) i64 {
	return i64(streq(name, cstr("rt_append")) != 0 || streq(name, cstr("rt_append_rc")) != 0 || streq(name, cstr("rt_append_dyn")) != 0 || streq(name, cstr("rt_slice_appendn")) != 0 || streq(name, cstr("rt_slice_appendn_rc")) != 0 || streq(name, cstr("rt_append_str")) != 0 || streq(name, cstr("rt_map_set")) != 0 || streq(name, cstr("rt_map_setk")) != 0)
}

// rg_grow notes that the running function may grow the slice or map with bits b.
fn rg_grow(b i64, pos i64) {
	mut i = 0
	for i < rg_nparams && i < RG_MAXP {
		if (b & (RG_P0 << i)) != 0 {
			if cast(i64, rg_grows) == 0 {
				rg_grows = vec_new[i64]()
			}
			if rg_merge(rg_grows, rg_fn, 1 << i) != 0 {
				rg_changed = 1
			}
		}
		i = i + 1
	}
	if (b & RG_OUT) != 0 && (b & ~(RG_OUT | RG_INGOT)) != 0 && rg_report != 0 && rg_in_arena() != 0 {
		err_code_at(pos, cstr("E315 ARENA_ESCAPE"), cstr("a slice or map from outside an arena grows inside it (append or insert), so its new memory would be the arena's: grow it after the block, from the block's result"))
	}
}

// rg_arena_store notes a store of bits v into a container with bits c: in terms of the running
// function's parameters, for its callers, and as E315 when it takes arena memory outside.
fn rg_arena_store(c i64, v i64, pos i64) {
	mut i = 0
	for i < rg_nparams && i < RG_MAXP && i < 62 {
		if (c & (RG_P0 << i)) != 0 {
			if (v & RG_FRESH) != 0 {
				if cast(i64, rg_fstores) == 0 {
					rg_fstores = vec_new[i64]()
				}
				if rg_merge(rg_fstores, rg_fn, 1 << i) != 0 {
					rg_changed = 1
				}
			}
			mut j = 0
			mut from = 0
			for j < rg_nparams && j < RG_MAXP && j < 62 {
				if (v & (RG_P0 << j)) != 0 {
					from = from | (1 << j)
				}
				j = j + 1
			}
			if from != 0 && rg_pstore_add(i, from) != 0 {
				rg_changed = 1
			}
		}
		i = i + 1
	}
	if (c & (RG_INGOT | RG_UNK)) == 0 && (c & RG_OUT) != 0 && rg_report != 0 && rg_in_arena() != 0 && rg_arena_made(v) != 0 {
		err_code_at(pos, cstr("E315 ARENA_ESCAPE"), cstr("memory made in an arena stored into an object from outside it, which outlives the arena: make the value the arena block's result (it is copied out), or keep() it"))
	}
}

fn rg_pstore_add(i i64, from i64) i64 {
	if cast(i64, rg_pstores) == 0 {
		rg_pstores = vec_new[i64]()
	}
	mut k = 0
	for k < rg_pstores.len {
		if vec_get(cast(Vec[i64], rg_pstores), k) == rg_fn && vec_get(cast(Vec[i64], rg_pstores), k + 1) == i {
			let old = vec_get(cast(Vec[i64], rg_pstores), k + 2)
			cast(Vec[i64], rg_pstores).data[k + 2] = old | from
			return i64((old | from) != old)
		}
		k = k + 3
	}
	vec_push(cast(Vec[i64], rg_pstores), rg_fn)
	vec_push(cast(Vec[i64], rg_pstores), i)
	vec_push(cast(Vec[i64], rg_pstores), from)
	return 1
}

fn rg_pstore_get(f i64, i i64) i64 {
	mut k = 0
	for cast(i64, rg_pstores) != 0 && k < rg_pstores.len {
		if vec_get(cast(Vec[i64], rg_pstores), k) == f && vec_get(cast(Vec[i64], rg_pstores), k + 1) == i {
			return vec_get(cast(Vec[i64], rg_pstores), k + 2)
		}
		k = k + 3
	}
	return 0
}

// rg_arena_call applies what callee f may grow and store into its parameters to the call's
// arguments (bits b): its own fresh memory, or another argument.
fn rg_arena_call(f i64, b Vec[i64], pos i64) {
	mut g = 0
	mut fs = 0
	if cast(i64, rg_grows) != 0 {
		g = rg_lookup(rg_grows, f)
	}
	if cast(i64, rg_fstores) != 0 {
		fs = rg_lookup(rg_fstores, f)
	}
	mut i = 0
	for i < b.len && i < RG_MAXP && i < 62 {
		if (g & (1 << i)) != 0 {
			rg_grow(vec_get(b, i), pos)
		}
		mut v = 0
		if (fs & (1 << i)) != 0 {
			v = RG_FRESH | RG_EMB
		}
		let from = rg_pstore_get(f, i)
		mut j = 0
		for from != 0 && j < b.len && j < 62 {
			if (from & (1 << j)) != 0 {
				v = v | vec_get(b, j)
			}
			j = j + 1
		}
		if (v & RG_EMB) != 0 {
			rg_arena_store(vec_get(b, i), v, pos)
		}
		i = i + 1
	}
}

// ---- use after hearth.Reset() (#179) ----
// rg_resets notes that the function being analyzed resets the request pool (its callers do
// too), and in rs_walk marks every local that may hold request memory as freed.
fn rg_resets() {
	if rg_sum[12] == 0 {
		rg_sum[12] = 1
		rg_changed = 1
	}
	if rs_active == 0 {
		return
	}
	let locals = cast(Fn, rg_fn).locals
	mut i = 0
	for i < locals.len {
		let s = vec_get(locals, i)
		if has_ptr(cast(Ty, s.type_)) != 0 && (rs_bits(cast(Vec[Sym], rs_cur), s) & RG_EMB) != 0 && vec_has(rs_dead, cast(i64, s)) == 0 {
			vec_push(rs_dead, cast(i64, s))
		}
		i = i + 1
	}
}

// rs_bits is what local s may hold on the walk: its latest assignment's bits, else all of them.
fn rs_bits(cur Vec[Sym], s Sym) i64 {
	mut i = 0
	for i < cur.len {
		if vec_get(cur, i) == s {
			return cast(i64, vec_get(cur, i + 1))
		}
		i = i + 2
	}
	return s.region
}

fn rs_assign(s i64, bits i64) {
	mut i = 0
	for i < rs_cur.len {
		if vec_get(rs_cur, i) == s {
			rs_cur.data[i + 1] = bits
			vec_drop(rs_dead, s)
			return
		}
		i = i + 2
	}
	vec_push(rs_cur, s)
	vec_push(rs_cur, bits)
	vec_drop(rs_dead, s)
}

// rs_join merges two walk states: a local is freed if it is on either path, and may hold
// what either path assigned.
fn rs_join(dead_a Vec[i64], cur_a Vec[Sym], dead_b Vec[i64], cur_b Vec[Sym]) {
	vec_union(dead_a, dead_b)
	let out = vec_new[i64]()
	mut i = 0
	for i < cur_a.len {
		let s = vec_get(cur_a, i)
		vec_push(out, cast(i64, s))
		vec_push(out, cast(i64, vec_get(cur_a, i + 1)) | rs_bits(cur_b, s))
		i = i + 2
	}
	i = 0
	for i < cur_b.len {
		let s = vec_get(cur_b, i)
		if rs_bits(cast(Vec[Sym], cast(Vec[i64], out)), s) == s.region && rs_has_entry(cast(Vec[i64], out), cast(i64, s)) == 0 {
			vec_push(out, cast(i64, s))
			vec_push(out, cast(i64, vec_get(cur_b, i + 1)) | s.region)
		}
		i = i + 2
	}
	rs_dead = cast(Vec[i64], dead_a)
	rs_cur = cast(Vec[i64], out)
}

fn rs_has_entry(cur Vec[i64], s i64) i64 {
	mut i = 0
	for i < cur.len {
		if vec_get(cur, i) == s {
			return 1
		}
		i = i + 2
	}
	return 0
}

fn vec_has(v Vec[i64], x i64) i64 {
	mut i = 0
	for i < v.len {
		if vec_get(v, i) == x {
			return 1
		}
		i = i + 1
	}
	return 0
}

fn vec_drop(v Vec[i64], x i64) {
	mut i = 0
	for i < v.len {
		if vec_get(v, i) == x {
			v.data[i] = vec_get(v, v.len - 1)
			v.len = v.len - 1
			return
		}
		i = i + 1
	}
}

fn vec_union(a Vec[i64], b Vec[i64]) {
	mut i = 0
	for i < b.len {
		if vec_has(a, vec_get(b, i)) == 0 {
			vec_push(a, vec_get(b, i))
		}
		i = i + 1
	}
}

// rs_walk follows f's statements in order: after a reset, a local that may hold request
// memory is freed until it is assigned again; reading it then is an error. Loop bodies are
// walked twice so a read before the reset in the next iteration is seen; branches join.
fn rs_walk(f Fn) {
	rs_active = 1
	rs_dead = vec_new[i64]()
	rs_said = vec_new[i64]()
	rs_cur = vec_new[i64]()
	rs_stmts(cast(Block, f.body).stmts)
	rs_active = 0
}

fn rs_stmts(v Vec[i64]) {
	mut i = 0
	for i < v.len {
		rs_stmt(vec_get(v, i))
		i = i + 1
	}
}

fn rs_stmt(s i64) {
	let k = cast(Node, s).kind
	if k == ST_BLOCK {
		rs_stmts(cast(Block, s).stmts)
	} else if k == ST_LET {
		mut lb = 0
		if cast(LetStmt, s).init != 0 {
			lb = rg_expr(cast(LetStmt, s).init)
		}
		rs_assign(cast(LetStmt, s).sym, lb)
	} else if k == ST_ASSIGN {
		let ab = rg_expr(cast(AssignStmt, s).value)
		let t = cast(AssignStmt, s).target
		if cast(Node, t).kind == EX_IDENT && cast(IdentExpr, t).ref != 0 {
			rs_assign(cast(IdentExpr, t).ref, ab)
		} else {
			rg_expr(t)
		}
	} else if k == ST_EXPR {
		rg_expr(cast(ExprStmt, s).x)
	} else if k == ST_IF {
		rg_expr(cast(IfStmt, s).cond)
		let dead0 = vec_clone(rs_dead)
		let cur0 = vec_clone(rs_cur)
		rs_stmts(cast(Block, cast(IfStmt, s).then).stmts)
		let dead1 = rs_dead
		let cur1 = cast(Vec[i64], rs_cur)
		rs_dead = cast(Vec[i64], dead0)
		rs_cur = cast(Vec[i64], cur0)
		if cast(IfStmt, s).else_ != 0 {
			rs_stmt(cast(IfStmt, s).else_)
		}
		rs_join(rs_dead, cast(Vec[Sym], rs_cur), dead1, cast(Vec[Sym], cur1))
	} else if k == ST_WHILE {
		// Twice, so the next iteration sees what this one freed; then joined with the path
		// that skips the loop.
		let dead0 = vec_clone(rs_dead)
		let cur0 = vec_clone(rs_cur)
		mut pass = 0
		for pass < 2 {
			rg_expr(cast(WhileStmt, s).cond)
			rs_stmts(cast(Block, cast(WhileStmt, s).body).stmts)
			if cast(WhileStmt, s).post != 0 {
				rs_stmt(cast(WhileStmt, s).post)
			}
			pass = pass + 1
		}
		rs_join(rs_dead, cast(Vec[Sym], rs_cur), cast(Vec[i64], dead0), cast(Vec[Sym], cast(Vec[i64], cur0)))
	} else if k == ST_RETURN {
		if cast(ReturnStmt, s).value != 0 {
			rg_expr(cast(ReturnStmt, s).value)
		}
		if cast(i64, cast(ReturnStmt, s).values) != 0 {
			mut i = 0
			for i < cast(ReturnStmt, s).values.len {
				rg_expr(vec_get(cast(ReturnStmt, s).values, i))
				i = i + 1
			}
		}
	} else if k == ST_CALLMULTI {
		rg_expr(cast(CallMultiStmt, s).call)
		let syms = cast(CallMultiStmt, s).syms
		mut j = 0
		for j < syms.len {
			if cast(i64, vec_get(syms, j)) != 0 {
				rs_assign(cast(i64, vec_get(syms, j)), vec_get(syms, j).region)
			}
			j = j + 1
		}
	}
}

fn rg_call(e i64) i64 {
	if cast(Node, e).region == R_OWNED && rg_in_keep == 0 {
		// keep(x): a detached block that reads a capture only in here uses a copy (#232).
		rg_in_keep = 1
		let kb = rg_call(e)
		rg_in_keep = 0
		return kb
	}
	let args = cast(Call, e).args
	let n = args.len
	let b = vec_new[i64]()
	mut i = 0
	for i < n {
		vec_push(b, rg_expr(vec_get(args, i)))
		i = i + 1
	}
	rg_multi = cast(Vec[i64], 0)
	if cast(Call, e).intrinsic != 0 {
		return 0
	}
	let pos = cast(Node, e).pos
	if cast(Call, e).dyn_shape != 0 {
		return rg_dyn_call(e, cast(Vec[Node], args), cast(i64, b), pos)
	}
	if cast(Call, e).callee != 0 {
		rg_expr(cast(Call, e).callee)
		// The callee is unknown: a mut argument may be modified and may receive request
		// memory, and the call may do what any function used as a value does (rg_fnsum).
		let ct = cast(Ty, cast(Node, cast(Call, e).callee).type_)
		mut mask = 0
		if cast(i64, ct) != 0 && ct.kind == K_FUNC {
			mask = ct.key
		}
		i = 0
		for i < n && i < 63 {
			if (mask & (1 << i)) != 0 {
				let saved = rg_report
				if rg_report != 0 && ((vec_get(b, i) | rg_pass(cast(Vec[i64], rg_fnsum[10]), i, cast(Vec[Node], args), cast(Vec[i64], b), -1, pos)) & (RG_INGOT | RG_UNK)) != 0 {
					let m = err_code(pos, cstr("E312 ARG_ESCAPE"))
					buf_str(m, cstr("a call through a function value may store request memory into its mut argument "))
					buf_int(m, i + 1)
					buf_str(m, cstr(", which may be long-lived: call the function directly or pass request-owned memory"))
					err_end(cast(Buf, m))
					rg_report = 0
				}
				let a = cast(Node, vec_get(args, i))
				rg_store(vec_get(b, i), rg_owner(cast(i64, a)), rg_key(a.type_), RG_EMB, 0, pos, 0)
				rg_pass(cast(Vec[i64], rg_fnsum[10]), i, cast(Vec[Node], args), cast(Vec[i64], b), RG_EMB, pos)
				rg_pass(cast(Vec[i64], rg_fnsum[11]), i, cast(Vec[Node], args), cast(Vec[i64], b), 0, pos)
				rg_report = saved
			}
			i = i + 1
		}
		rg_import(cast(Vec[i64], rg_fnsum[1]), cast(Vec[i64], args), cast(Vec[i64], b))
		if has_ptr(cast(Ty, cast(Node, e).type_)) != 0 {
			return RG_UNK | RG_EMB
		}
		return 0
	}
	let f = cast(Fn, cast(Call, e).fn_)
	mut name = cast(Call, e).name
	if cast(i64, f) != 0 && f.qname != 0 {
		name = f.qname
	}
	if (name != 0 && streq(name, cstr("hearth.Reset")) != 0) || (cast(i64, f) != 0 && f.regsum != 0 && f.regsum[12] != 0 && vec_get(file_trusted, f.file) == 0) {
		rg_resets()
	}
	if cast(Node, e).region == R_OWNED || (cast(i64, f) != 0 && is_keep_fn(f) != 0) || (name != 0 && str_prefix(name, cstr("rt_keep")) != 0) {
		return RG_INGOT
	}
	if name != 0 && str_prefix(name, cstr("rt_")) != 0 {
		return rg_runtime_call(e, name, cast(Vec[i64], b), pos)
	}
	mut sum = 0
	if cast(i64, f) != 0 {
		sum = f.regsum
	}
	if sum == 0 {
		if has_ptr(cast(Ty, cast(Node, e).type_)) != 0 {
			return RG_UNK | RG_EMB
		}
		return 0
	}
	i = 0
	for i < n && i < RG_MAXP {
		let mutp = i64(f.muts != 0 && i < cast(Vec[i64], f.muts).len && vec_get(cast(Vec[i64], f.muts), i) != 0)
		if (sum[0] & (1 << i)) != 0 {
			let saved = rg_report
			if rg_report != 0 && (rg_pass(cast(Vec[i64], sum[10]), i, cast(Vec[Node], args), cast(Vec[i64], b), -1, pos) & (RG_INGOT | RG_UNK)) != 0 {
				let m = err_code(pos, cstr("E312 ARG_ESCAPE"))
				buf_str(m, name)
				buf_str(m, cstr(" stores request memory into its mut parameter '"))
				buf_str(m, cast(Sym, vec_get(cast(Vec[i64], f.locals), i)).name)
				if vec_get(file_trusted, f.file) != 0 {
					// The standard library cannot be changed by its caller: the argument must.
					buf_str(m, cstr("', but this argument may be long-lived: pass request memory (a local) instead"))
				} else {
					buf_str(m, cstr("', but this argument may be long-lived: keep() the stored values inside "))
					buf_str(m, name)
				}
				err_end(cast(Buf, m))
				rg_report = 0
			}
			rg_pass(cast(Vec[i64], sum[10]), i, cast(Vec[Node], args), cast(Vec[i64], b), RG_EMB, pos)
			rg_report = saved
		} else if mutp != 0 {
			let a = cast(Node, vec_get(args, i))
			rg_store(vec_get(b, i), rg_owner(cast(i64, a)), rg_key(a.type_), 0, 0, pos, 0)
		}
		if mutp != 0 {
			rg_pass(cast(Vec[i64], sum[11]), i, cast(Vec[Node], args), cast(Vec[i64], b), 0, pos)
		}
		i = i + 1
	}
	rg_arena_call(cast(i64, f), cast(Vec[i64], b), pos)
	rg_import(cast(Vec[i64], sum[1]), cast(Vec[i64], args), cast(Vec[i64], b))
	let res = vec_new[i64]()
	mut j = 0
	for j < 8 {
		mut rt = 0
		if j < cast(Vec[i64], f.rtypes).len {
			rt = vec_get(cast(Vec[i64], f.rtypes), j)
		}
		vec_push(res, rg_subst(sum[2 + j], cast(Vec[Node], args), cast(Vec[i64], b), rt))
		j = j + 1
	}
	rg_multi = cast(Vec[i64], res)
	if has_ptr(cast(Ty, cast(Node, e).type_)) == 0 {
		return 0
	}
	return vec_get(res, 0)
}

// A dyn call can target any concrete method table for its shape. Join the region
// summaries of those methods using each table's concrete receiver type.
fn rg_dyn_call(e i64, args Vec[Node], b i64, pos i64) i64 {
	let shape_ = cast(Call, e).dyn_shape
	let index = cast(Call, e).dyn_index - 1
	let saved_fn = cast(Call, e).fn_
	let saved_callee = cast(Call, e).callee
	let saved_shape = cast(Call, e).dyn_shape
	let saved_index = cast(Call, e).dyn_index
	let saved_type = vec_get(args, 0).type_
	let joined = vec_new[i64]()
	mut j = 0
	for j < 8 {
		vec_push(joined, 0)
		j = j + 1
	}
	mut result = 0
	mut found = 0
	mut i = 0
	for i < dyn_tables.len {
		let rec = cast(Vec[i64], vec_get(dyn_tables, i))
		let methods = cast(Vec[i64], vec_get(rec, 3))
		if vec_get(rec, 1) == shape_ && index >= 0 && index < methods.len {
			let f = vec_get(methods, index)
			if f != 0 {
				found = 1
				cast(Call, e).fn_ = f
				cast(Call, e).callee = 0
				cast(Call, e).dyn_shape = 0
				cast(Call, e).dyn_index = 0
				vec_get(args, 0).type_ = vec_get(rec, 0)
				result = result | rg_call(e)
				mut ri = 0
				for ri < 8 {
					cast(Vec[i64], joined).data[ri] = vec_get(joined, ri) | vec_get(rg_multi, ri)
					ri = ri + 1
				}
			}
		}
		i = i + 1
	}
	cast(Call, e).fn_ = saved_fn
	cast(Call, e).callee = saved_callee
	cast(Call, e).dyn_shape = saved_shape
	cast(Call, e).dyn_index = saved_index
	vec_get(args, 0).type_ = saved_type
	if found == 0 {
		if has_ptr(cast(Ty, cast(Node, e).type_)) != 0 {
			return RG_UNK | RG_EMB
		}
		return 0
	}
	rg_multi = cast(Vec[i64], joined)
	return result
}

// rg_pass applies a callee's records (rg_record) for argument i: each names an object
// inside the argument, whose bits (rg_deep) are joined into the result, and v (unless -1)
// is stored into each.
fn rg_pass(recs Vec[i64], i i64, args Vec[Node], b Vec[i64], v i64, pos i64) i64 {
	mut all = 0
	mut j = 0
	for j < recs.len {
		if vec_get(recs, j) == i {
			let o = vec_get(recs, j + 1)
			let t = vec_get(recs, j + 2)
			let c = rg_deep(vec_get(b, i), vec_get(args, i).type_, o, t)
			all = all | c
			if v != -1 {
				rg_store(c, o, t, v, 0, pos, 0)
			}
		}
		j = j + 3
	}
	return all
}

// rg_import adds a callee's held pairs to the caller's, in terms of the call's arguments.
fn rg_import(h Vec[i64], args Vec[i64], b Vec[i64]) {
	mut i = 0
	for i < h.len {
		let t = vec_get(h, i)
		rg_hold(t, rg_subst(vec_get(h, i + 1), cast(Vec[Node], args), b, t))
		i = i + 2
	}
}

// rg_subst replaces a summary's parameter bits with the bits of the call's arguments (b),
// for a value of type t: a parameter's bits stand for everything reachable from it, so
// they also take what the argument's containers hold on the way to a t (rg_deep).
fn rg_subst(r i64, args Vec[Node], b Vec[i64], t i64) i64 {
	let v = rg_key(t)
	mut out = r & 0xff
	mut i = 0
	for i < b.len && i < RG_MAXP {
		if (r & (RG_P0 << i)) != 0 {
			mut x = vec_get(b, i)
			if v != 0 || t == 0 {
				x = rg_deep(x, vec_get(args, i).type_, 0, v)
			}
			out = out | x
		}
		i = i + 1
	}
	return out
}

fn rg_runtime_call(e i64, name i64, b Vec[i64], pos i64) i64 {
	let n = b.len
	mut b0 = 0
	if n > 0 {
		b0 = vec_get(b, 0)
	}
	// Stores go into the object of argument 0.
	let args = cast(Call, e).args
	mut co = 0
	mut ct = 0
	if n > 0 {
		co = rg_owner(vec_get(args, 0))
		ct = rg_key(cast(Node, vec_get(args, 0)).type_)
	}
	if n > 0 && rg_grows_op(name) != 0 {
		rg_grow(b0, pos)
	}
	if streq(name, cstr("rt_map_set")) != 0 {
		rg_store(b0, co, ct, vec_get(b, 1), cast(Node, vec_get(args, 1)).type_, pos, 0)
		rg_store(b0, co, ct, vec_get(b, 2), cast(Node, vec_get(args, 2)).type_, pos, 0)
		return 0
	}
	if streq(name, cstr("rt_map_setk")) != 0 {
		// The encoded key is copied into the map's region; only the value is stored.
		rg_store(b0, co, ct, vec_get(b, 2), cast(Node, vec_get(args, 2)).type_, pos, 0)
		return 0
	}
	if streq(name, cstr("rt_append")) != 0 || streq(name, cstr("rt_append_rc")) != 0 {
		rg_store(b0, co, ct, vec_get(b, 1), cast(Node, vec_get(args, 1)).type_, pos, 0)
		return b0
	}
	if streq(name, cstr("rt_append_dyn")) != 0 {
		mut et = cast(Ty, cast(Node, vec_get(args, 0)).type_).elem
		rg_store(b0, co, ct, vec_get(b, 1), et, pos, 0)
		return b0
	}
	if streq(name, cstr("rt_slice_appendn")) != 0 || streq(name, cstr("rt_slice_copy")) != 0 || streq(name, cstr("rt_slice_appendn_rc")) != 0 || streq(name, cstr("rt_slice_copy_rc")) != 0 {
		mut et = 0
		let a1 = cast(Node, vec_get(args, 1))
		if kind_of(cast(Ty, a1.type_)) == K_SLICE {
			et = cast(Ty, a1.type_).elem
		}
		if has_ptr(cast(Ty, et)) != 0 {
			rg_store(b0, co, ct, rg_load(vec_get(b, 1), et), et, pos, 0)
		} else {
			rg_store(b0, co, ct, 0, 0, pos, 0)
		}
		return b0
	}
	if streq(name, cstr("rt_append_str")) != 0 || streq(name, cstr("rt_copy_str")) != 0 || streq(name, cstr("rt_map_del")) != 0 {
		rg_store(b0, co, ct, 0, 0, pos, 0)
		return b0
	}
	if streq(name, cstr("rt_map_get")) != 0 || streq(name, cstr("rt_map_key")) != 0 || streq(name, cstr("rt_map_val")) != 0 {
		if has_ptr(cast(Ty, cast(Node, e).type_)) != 0 {
			return rg_load(b0, cast(Node, e).type_)
		}
		return 0
	}
	if streq(name, cstr("rt_slice_sub")) != 0 {
		return b0 | RG_FRESH | RG_EMB
	}
	if has_ptr(cast(Ty, cast(Node, e).type_)) != 0 {
		return RG_FRESH | RG_EMB
	}
	return 0
}

fn str_prefix(s i64, p i64) i64 {
	mut i = 0
	for i64(load8(p + i)) != 0 {
		if i64(load8(s + i)) != i64(load8(p + i)) {
			return 0
		}
		i = i + 1
	}
	return 1
}

// ---- the body of a with policy (#237, notes/interface_policy.md §3) ----
//
// A with block's closure lives on its caller's frame, so the Run of its policy may only call
// body, or pass it to a parameter that obeys the same rule (checked here, recursively). Any
// other use in Run is reported there; a function Run passes body to is only judged.
shared mut wb_memo Vec[Fn] // [function, parameter, state]: 1 checking or fine, 2 may keep it
shared mut wb_fn i64 // the function being walked
shared mut wb_sym i64 // its parameter
shared mut wb_bad i64 // the parameter may be kept
shared mut wb_say i64 // report each bad use (the Run of a with), or only judge

fn with_body_check() {
	if cast(i64, with_runs) == 0 {
		return
	}
	wb_memo = cast(Vec[Fn], vec_new[i64]())
	mut i = 0
	for i < with_runs.len {
		wb_param_ok(cast(Fn, vec_get(cast(Vec[i64], with_runs), i)), 1, 1)
		i = i + 2
	}
}

// wb_param_ok reports whether parameter i of f is only called or passed on to such parameters.
fn wb_param_ok(f Fn, i i64, say i64) i64 {
	mut j = 0
	for j < wb_memo.len {
		if vec_get(wb_memo, j) == f && cast(i64, vec_get(wb_memo, j + 1)) == i {
			return i64(cast(i64, vec_get(wb_memo, j + 2)) == 1)
		}
		j = j + 3
	}
	if cast(i64, f) == 0 || f.extern_ != 0 || f.body == 0 || cast(i64, f.locals) == 0 || i >= cast(Vec[i64], f.params).len {
		return 0
	}
	vec_push(wb_memo, cast(Fn, f))
	vec_push(wb_memo, cast(Fn, i))
	let at = wb_memo.len
	vec_push(wb_memo, cast(Fn, 1))
	let saved_fn = wb_fn
	let saved_sym = wb_sym
	let saved_bad = wb_bad
	let saved_say = wb_say
	wb_fn = cast(i64, f)
	wb_sym = vec_get(cast(Vec[i64], f.locals), i)
	wb_bad = 0
	wb_say = say
	wb_stmts(cast(Block, f.body).stmts)
	let ok = i64(wb_bad == 0)
	if ok == 0 {
		wb_memo.data[at] = 2
	}
	wb_fn = saved_fn
	wb_sym = saved_sym
	wb_bad = saved_bad
	wb_say = saved_say
	return ok
}

// wb_keeps notes a use of the parameter other than a call; via names the function it was
// passed to, or is 0.
fn wb_keeps(pos i64, via i64) {
	if wb_say != 0 && wb_bad == 0 {
		let m = err_code(pos, cstr("E653 POLICY_BODY"))
		buf_str(m, cast(Fn, wb_fn).qname)
		if via != 0 {
			buf_str(m, cstr(" passes the body of a with block to "))
			buf_str(m, cast(Fn, via).qname)
			buf_str(m, cstr(", which may keep it"))
		} else {
			buf_str(m, cstr(" keeps the body of a with block"))
		}
		buf_str(m, cstr(": a policy may only call body, or pass it to a function that only calls it (the block's variables live on the caller's frame)"))
		err_end(cast(Buf, m))
	}
	wb_bad = 1
}

fn wb_stmts(v Vec[i64]) {
	mut i = 0
	for i < v.len {
		wb_stmt(vec_get(v, i))
		i = i + 1
	}
}

fn wb_stmt(s i64) {
	let k = cast(Node, s).kind
	if k == ST_BLOCK {
		wb_stmts(cast(Block, s).stmts)
	} else if k == ST_LET {
		wb_expr(cast(LetStmt, s).init)
	} else if k == ST_ASSIGN {
		if cast(Node, cast(AssignStmt, s).target).kind != EX_IDENT {
			wb_expr(cast(AssignStmt, s).target)
		}
		wb_expr(cast(AssignStmt, s).value)
	} else if k == ST_EXPR {
		wb_expr(cast(ExprStmt, s).x)
	} else if k == ST_IF {
		wb_expr(cast(IfStmt, s).cond)
		wb_stmts(cast(Block, cast(IfStmt, s).then).stmts)
		if cast(IfStmt, s).else_ != 0 {
			wb_stmt(cast(IfStmt, s).else_)
		}
	} else if k == ST_WHILE {
		wb_expr(cast(WhileStmt, s).cond)
		wb_stmts(cast(Block, cast(WhileStmt, s).body).stmts)
		if cast(WhileStmt, s).post != 0 {
			wb_stmt(cast(WhileStmt, s).post)
		}
	} else if k == ST_RETURN {
		wb_expr(cast(ReturnStmt, s).value)
		if cast(i64, cast(ReturnStmt, s).values) != 0 {
			wb_exprs(cast(ReturnStmt, s).values)
		}
	} else if k == ST_CALLMULTI {
		wb_expr(cast(CallMultiStmt, s).call)
	}
}

fn wb_exprs(v Vec[i64]) {
	mut i = 0
	for i < v.len {
		wb_expr(vec_get(v, i))
		i = i + 1
	}
}

fn wb_is_param(e i64) i64 {
	return i64(e != 0 && cast(Node, e).kind == EX_IDENT && cast(IdentExpr, e).ref == wb_sym)
}

fn wb_expr(e i64) {
	if e == 0 {
		return
	}
	let k = cast(Node, e).kind
	if k == EX_IDENT {
		if cast(IdentExpr, e).ref == wb_sym {
			wb_keeps(cast(Node, e).pos, 0)
		}
	} else if k == EX_UNARY {
		wb_expr(cast(Unary, e).x)
	} else if k == EX_BINARY {
		wb_expr(cast(Binary, e).l)
		wb_expr(cast(Binary, e).r)
	} else if k == EX_CONV {
		wb_expr(cast(Conv, e).x)
	} else if k == EX_MEM {
		wb_expr(cast(MemExpr, e).base)
		wb_expr(cast(MemExpr, e).index)
		wb_expr(cast(MemExpr, e).len)
	} else if k == EX_ELEM {
		wb_expr(cast(ElemExpr, e).seq)
		wb_expr(cast(ElemExpr, e).idx)
	} else if k == EX_SEQ {
		wb_stmts(cast(SeqExpr, e).stmts)
		wb_expr(cast(SeqExpr, e).value)
	} else if k == EX_INDEX {
		wb_expr(cast(IndexExpr, e).x)
		wb_expr(cast(IndexExpr, e).i)
	} else if k == EX_CALL {
		let callee = cast(Call, e).callee
		if wb_is_param(callee) == 0 {
			wb_expr(callee)
		}
		let args = cast(Call, e).args
		mut i = 0
		for i < args.len {
			let a = cast(Node, vec_get(args, i))
			if wb_is_param(cast(i64, a)) != 0 {
				let g = cast(Fn, cast(Call, e).fn_)
				if cast(i64, g) == 0 || callee != 0 || cast(Call, e).intrinsic != 0 {
					wb_keeps(a.pos, 0)
				} else if wb_param_ok(g, i, 0) == 0 && vec_get(file_trusted, g.file) != 0 && i64(load8(vec_get(file_pkgs, g.file))) == 0 {
					// A runtime helper (append, a store): the use itself keeps it.
					wb_keeps(a.pos, 0)
				} else if wb_param_ok(g, i, 0) == 0 {
					wb_keeps(a.pos, cast(i64, g))
				}
			} else {
				wb_expr(cast(i64, a))
			}
			i = i + 1
		}
	}
}

// ---- long-lived stores: the counts around them (#176, notes/interface_mem.md) ----
//
// rc_mark runs after region_check, when the bits on every local are final. It wraps each
// store whose destination is provably long-lived: an assignment to a global, and field
// or element stores whose base ident is a global or a local left at exactly RG_INGOT
// (one that can hold nothing else). The store keeps the value it had: the new value's
// count arrives and the old slot's count leaves, both before the store itself (the value
// is bound to a temporary first, so it is evaluated once).
//
// A store whose destination may be long-lived but is not provably so (through a
// parameter, a closure's cells, an element of an element) cannot be counted: the old
// slot may never have had a count. Its value is pinned instead (rt_rc_pinned), so the
// uncounted reference can leak the block but never outlive it. A store into a container
// the region pass proved request-local needs neither.
//
// Map entries and append elements count themselves in the runtime (rt_map_set,
// rt_append_rc, rt_slice_appendn_rc, rt_slice_copy_rc), which decide by the container's
// own region word and need no marking here. keep$N counts the fields, elements and
// entries of its copy itself, so lifted functions are left alone. __core_init is not
// visited: what a core makes while it initializes starts pinned (rt_ingot_alloc).
shared mut rc_fn i64
shared mut rc_reach_ok i64 // 1 once reachability is final: rc_*_call may mark what they add

fn rc_mark() {
	rc_reach_ok = 1
	let saved_fn = ck_fn
	let saved_marks = sc_marks
	let saved_syms = sc_syms
	let saved_cells = ck_escaping_cells
	// declare_local reads the current scope; give the wrapped temporaries one of their own.
	sc_marks = vec_new[i64]()
	vec_push(sc_marks, 0)
	sc_syms = cast(Vec[Sym], vec_new[i64]())
	ck_escaping_cells = vec_new[i64]()
	mut i = 0
	for i < prog_fns.len {
		let f = vec_get(prog_fns, i)
		if f.regsum != 0 && f.reach != 0 && f.lifted != 2 {
			rc_fn = cast(i64, f)
			ck_fn = cast(Fn, f)
			rc_stmts(cast(Block, f.body).stmts)
		}
		i = i + 1
	}
	ck_fn = saved_fn
	sc_marks = saved_marks
	sc_syms = saved_syms
	ck_escaping_cells = saved_cells
}

fn rc_stmts(v Vec[i64]) {
	mut i = 0
	for i < v.len {
		let s = vec_get(v, i)
		if s != 0 && cast(Node, s).kind == ST_ASSIGN {
			// The wrap leaves the store itself in place; skip it, the temporaries around
			// it carry the value expression (a composite literal's stores) instead.
			i = i + rc_assign(s, cast(Vec[i64], v), i) + 1
		} else if s != 0 && cast(Node, s).kind == ST_CALLMULTI {
			rc_seq(cast(CallMultiStmt, s).call)
			i = i + rc_callmulti(s, cast(Vec[i64], v), i) + 1
		} else {
			rc_walk(s)
			i = i + 1
		}
	}
}

// rc_walk reaches the stores nested in a statement (a composite literal carries them
// inside an EX_SEQ).
fn rc_walk(s i64) {
	if s == 0 {
		return
	}
	let k = cast(Node, s).kind
	if k == ST_BLOCK {
		rc_stmts(cast(Block, s).stmts)
	} else if k == ST_LIST {
		rc_stmts(cast(ListStmt, s).stmts)
	} else if k == ST_LET {
		rc_seq(cast(LetStmt, s).init)
	} else if k == ST_EXPR {
		rc_seq(cast(ExprStmt, s).x)
	} else if k == ST_IF {
		rc_stmts(cast(Block, cast(IfStmt, s).then).stmts)
		if cast(IfStmt, s).else_ != 0 {
			rc_walk(cast(IfStmt, s).else_)
		}
	} else if k == ST_WHILE {
		rc_stmts(cast(Block, cast(WhileStmt, s).body).stmts)
		if cast(WhileStmt, s).post != 0 {
			rc_walk(cast(WhileStmt, s).post)
		}
	} else if k == ST_RETURN {
		if cast(ReturnStmt, s).value != 0 {
			rc_seq(cast(ReturnStmt, s).value)
		}
	}
}

fn rc_seq(e i64) {
	if e != 0 && cast(Node, e).kind == EX_SEQ {
		rc_stmts(cast(SeqExpr, e).stmts)
		rc_seq(cast(SeqExpr, e).value)
	}
}

// rc_assign counts or pins the assignment at position i of stmts, by what its
// destination can be. It reports how many statements it spliced in before it.
fn rc_assign(s i64, stmts Vec[i64], i i64) i64 {
	let target = cast(AssignStmt, s).target
	let val = cast(AssignStmt, s).value
	if target == 0 || val == 0 {
		return 0
	}
	let pos = cast(Node, s).pos
	let t = cast(Node, target).type_
	if rc_counted(cast(Ty, t)) == 0 || vec_get(file_trusted, cast(Fn, rc_fn).file) == 2 {
		rc_seq(val)
		return 0
	}
	let k = cast(Node, target).kind
	if k == EX_IDENT {
		if cast(IdentExpr, target).ref != 0 && cast(Sym, cast(IdentExpr, target).ref).kind == SYM_GLOBAL {
			// xs = append(xs, v): the append counts its own element and returns the same
			// header, so the slot's count is already right.
			if rc_append_into(val, cast(IdentExpr, target)) != 0 {
				return 0
			}
			return rc_wrap(s, stmts, i, sym_ref_node(pos, cast(Sym, cast(IdentExpr, target).ref)), t, cast(Vec[i64], 0))
		}
		// A local: the variable itself is not long-lived storage.
		rc_seq(val)
		return 0
	}
	if k == EX_MEM {
		let base = cast(MemExpr, target).base
		if cast(MemExpr, target).index == 0 && rc_ingot_base(base) != 0 {
			return rc_wrap(s, stmts, i, rc_field_read(pos, cast(MemExpr, target), t), t, cast(Vec[i64], 0))
		}
		if rc_local_base(base) == 0 {
			rc_pin_value(s, t)
		}
		rc_seq(val)
		return 0
	}
	if k == EX_ELEM {
		// s[i] = v, already lowered to a bounds-checked element. The index is bound to a
		// temporary so the old value is read back from the very same index.
		let seq = cast(ElemExpr, target).seq
		if rc_ingot_base(seq) != 0 {
			let pre0 = vec_new[i64]()
			let idx = temp(pos, cast(ElemExpr, target).idx, ty_int)
			vec_push(pre0, cast(i64, idx))
			cast(ElemExpr, target).idx = sym_ref_node(pos, cast(Sym, idx.sym))
			return rc_wrap(s, stmts, i, rc_elem_read(pos, cast(ElemExpr, target), t), t, cast(Vec[i64], pre0))
		}
		if rc_local_base(seq) == 0 {
			rc_pin_value(s, t)
		}
		rc_seq(val)
		return 0
	}
	rc_seq(val)
	return 0
}

// rc_wrap binds the stored value, reads the old one, counts the new value, drops the old
// one's count (in that order: a value stored over itself is never queued) and leaves the
// store itself last. pre0 (0: none) holds statements the caller prepared (an index
// temporary). It reports how many statements it spliced in.
fn rc_wrap(s i64, stmts Vec[i64], i i64, oldRead i64, t i64, pre0 Vec[i64]) i64 {
	let pos = cast(Node, s).pos
	let val = cast(AssignStmt, s).value
	let pre = vec_new[i64]()
	if cast(i64, pre0) != 0 {
		mut p = 0
		for p < pre0.len {
			vec_push(pre, vec_get(pre0, p))
			p = p + 1
		}
	}
	let v = temp(pos, val, t)
	vec_push(pre, cast(i64, v))
	// The store reads the temporary now, so the value expression is evaluated once.
	cast(AssignStmt, s).value = sym_ref_node(pos, cast(Sym, v.sym))
	let old = temp(pos, oldRead, t)
	vec_push(pre, cast(i64, old))
	vec_push(pre, expr_stmt(rc_inc_call(pos, sym_ref_node(pos, cast(Sym, v.sym)))))
	vec_push(pre, expr_stmt(rc_dec_call(pos, sym_ref_node(pos, cast(Sym, old.sym)), drop_fn(t))))
	rc_splice(stmts, i, cast(Vec[i64], pre))
	// A composite literal's own stores travel inside the bound value.
	rc_stmts(cast(Vec[i64], pre))
	return cast(Vec[i64], pre).len
}

// rc_pin_value pins the value assignment s stores, in place: rt_rc_pinned returns its
// argument, so the evaluation order of the store does not change.
fn rc_pin_value(s i64, t i64) {
	let c = cast(Call, rt_call(cast(Node, s).pos, cstr("rt_rc_pinned"), args1(cast(AssignStmt, s).value), t))
	mark_reach(cast(Fn, c.fn_))
	cast(AssignStmt, s).value = cast(i64, c)
}

// rc_callmulti counts the globals a multiple assignment (a, g = f()) stores: each old
// value is read before the call and loses its count after it, once the new one has
// gained its own. It reports how many statements it spliced in around the call.
fn rc_callmulti(s i64, stmts Vec[i64], i i64) i64 {
	let pos = cast(Node, s).pos
	let syms = cast(CallMultiStmt, s).syms
	let pre = vec_new[i64]()
	let post = vec_new[i64]()
	mut j = 0
	for j < syms.len {
		let g = vec_get(syms, j)
		if cast(i64, g) != 0 && g.kind == SYM_GLOBAL && rc_counted(cast(Ty, g.type_)) != 0 {
			let old = temp(pos, sym_ref_node(pos, g), g.type_)
			vec_push(pre, cast(i64, old))
			vec_push(post, expr_stmt(rc_inc_call(pos, sym_ref_node(pos, g))))
			vec_push(post, expr_stmt(rc_dec_call(pos, sym_ref_node(pos, cast(Sym, old.sym)), drop_fn(g.type_))))
		}
		j = j + 1
	}
	rc_splice(stmts, i + 1, cast(Vec[i64], post))
	rc_splice(stmts, i, cast(Vec[i64], pre))
	return cast(Vec[i64], pre).len + cast(Vec[i64], post).len
}

// rc_splice puts pre before position i, moving the statements from i up.
fn rc_splice(stmts Vec[i64], i i64, pre Vec[i64]) {
	let n = stmts.len
	let k = pre.len
	if k == 0 {
		return
	}
	if n + k > stmts.cap {
		for n + k > stmts.cap {
			stmts.cap = stmts.cap * 2
		}
		stmts.data = realloc(stmts.data, stmts.cap * 8)
	}
	mut j = n - 1
	for j >= i {
		stmts.data[j + k] = stmts.data[j]
		j = j - 1
	}
	mut m = 0
	for m < k {
		stmts.data[i + m] = vec_get(pre, m)
		m = m + 1
	}
	stmts.len = n + k
}

// rc_ingot_base reports whether the ident e names a container that can hold nothing but
// long-lived values: a global, or a local the region pass left at exactly RG_INGOT.
fn rc_ingot_base(e i64) i64 {
	if cast(Node, e).kind != EX_IDENT || cast(IdentExpr, e).ref == 0 {
		return 0
	}
	let s = cast(Sym, cast(IdentExpr, e).ref)
	if s.kind == SYM_GLOBAL {
		return 1
	}
	if cast(i64, s) == cast(Fn, rc_fn).env_sym {
		return 0
	}
	return i64(s.region == RG_INGOT)
}

// rc_local_base reports whether the ident e names a container the region pass proved
// request-local: a local whose objects are all fresh from the pool.
fn rc_local_base(e i64) i64 {
	if cast(Node, e).kind != EX_IDENT || cast(IdentExpr, e).ref == 0 {
		return 0
	}
	let s = cast(Sym, cast(IdentExpr, e).ref)
	if s.kind == SYM_GLOBAL || cast(i64, s) == cast(Fn, rc_fn).env_sym {
		return 0
	}
	return i64(s.region != 0 && (s.region & ~(RG_FRESH | RG_EMB)) == 0)
}

// rc_field_read reads the field the store writes (the base is a named ident).
fn rc_field_read(pos i64, target MemExpr, t i64) i64 {
	let base = cast(IdentExpr, target.base)
	return mk_mem(pos, sym_ref_node(pos, cast(Sym, base.ref)), 0, 0, target.off, t)
}

// rc_elem_read reads the element the store writes; the slice and the index are names, so
// naming them twice costs nothing.
fn rc_elem_read(pos i64, target ElemExpr, t i64) i64 {
	let seq = cast(IdentExpr, target.seq)
	let n = node_new(EX_ELEM, pos)
	cast(ElemExpr, n).seq = sym_ref_node(pos, cast(Sym, seq.ref))
	cast(ElemExpr, n).idx = sym_ref_node(pos, cast(Sym, cast(IdentExpr, target.idx).ref))
	cast(ElemExpr, n).size = target.size
	cast(ElemExpr, n).str = target.str
	cast(Node, n).type_ = t
	return n
}

// rc_append_into reports whether xs = append(xs, v) grows the very global being assigned:
// rt_append_rc counted its element and returned the same header, so nothing else moves.
fn rc_append_into(v i64, target IdentExpr) i64 {
	if cast(Node, v).kind != EX_CALL || cast(Call, v).name == 0 || streq(cast(Call, v).name, cstr("rt_append_rc")) == 0 {
		return 0
	}
	let a0 = vec_get(cast(Call, v).args, 0)
	return i64(cast(Node, a0).kind == EX_IDENT && cast(IdentExpr, a0).ref == target.ref)
}

// ---- globals set on core 0 only (#343) ----
//
// Globals are per core and main runs on core 0, so a global that main (or a function main calls)
// assigns holds the new value on core 0 alone: the handlers of the other cores read their own
// copy, still the initializer's. In a program that starts cores (anvil.Serve, hearth.Run) that is
// an error. A global that only main's own code reads is fine: nothing else looks at it.
//
// cg_seen are the user functions main reaches by direct calls (a function used as a value, such
// as a handler, is not among them: it may run on any core). cg_stores are the [global, position]
// stores they make, cg_refs the per-core globals every other reachable function names.
shared mut cg_seen Vec[i64]
shared mut cg_stores Vec[i64]
shared mut cg_refs Vec[i64]
shared mut cg_in_main i64 // 1 while walking main's tree (record stores, follow calls), 0 while collecting names

fn core_global_check() {
	let run = find_fn(cstr("hearth.Run"))
	let m = find_fn(cstr("main"))
	if cast(i64, run) == 0 || cast(i64, run)[F_REACH] == 0 || cast(i64, m) == 0 || cast(i64, m)[F_BODY] == 0 {
		return
	}
	cg_seen = vec_new[i64]()
	cg_stores = vec_new[i64]()
	cg_refs = vec_new[i64]()
	cg_in_main = 1
	cg_visit(cast(i64, m))
	if cg_stores.len == 0 {
		return
	}
	cg_in_main = 0
	mut i = 0
	for i < prog_fns.len {
		let f = vec_get(prog_fns, i)
		if cast(i64, f)[F_REACH] != 0 && cast(i64, f)[F_EXTERN] == 0 && cast(i64, f)[F_BODY] != 0 && cast(i64, f)[F_GENERATED] == 0 && vec_has(cg_seen, cast(i64, f)) == 0 {
			cg_stmts(cast(Vec[i64], cast(i64, f)[F_BODY][BLK_STMTS]))
		}
		i = i + 1
	}
	i = 0
	for i < cg_stores.len {
		let g = vec_get(cg_stores, i)
		if vec_has(cg_refs, g) != 0 {
			err_code_quoted(vec_get(cg_stores, i + 1), cstr("E131 CORE_GLOBAL"), cstr("global "), g[S_NAME], cstr(" is assigned here, in code that runs on core 0 only (main and what it calls): the other cores keep the initializer's value. Assign it in its initializer, in `on core.start` or in `once`"))
		}
		i = i + 2
	}
}

// cg_visit walks f (main, or a user function reached from it) once. Library functions are
// trusted code: their own per-core state is theirs to manage, so they are not entered.
fn cg_visit(f i64) {
	if f == 0 || f[F_EXTERN] != 0 || f[F_BODY] == 0 || f[F_GENERATED] != 0 || vec_has(cg_seen, f) != 0 || vec_get(file_trusted, f[F_FILE]) != 0 {
		return
	}
	vec_push(cg_seen, f)
	cg_stmts(cast(Vec[i64], f[F_BODY][BLK_STMTS]))
}

// cg_root is the per-core global a store into e lands in (the ident itself, or the base of a
// field, element or index chain), or 0.
fn cg_root(e i64) i64 {
	for e != 0 {
		let k = e[N_KIND]
		if k == EX_IDENT {
			let s = e[ID_REF]
			if s != 0 && s[S_KIND] == SYM_GLOBAL && s[S_TLS] != 0 {
				return s
			}
			return 0
		}
		if k == EX_MEM {
			e = e[MEM_BASE]
		} else if k == EX_ELEM {
			e = e[ELEM_SEQ]
		} else if k == EX_INDEX {
			e = e[IX_X]
		} else if k == EX_CONV {
			e = e[CV_X]
		} else {
			return 0
		}
	}
	return 0
}

fn cg_store(target i64, pos i64) {
	let g = cg_root(target)
	if g != 0 {
		vec_push(cg_stores, g)
		vec_push(cg_stores, pos)
	}
}

fn cg_stmts(v Vec[i64]) {
	mut i = 0
	for i < v.len {
		cg_stmt(vec_get(v, i))
		i = i + 1
	}
}

fn cg_stmt(s i64) {
	if s == 0 {
		return
	}
	let k = s[N_KIND]
	if k == ST_BLOCK {
		cg_stmts(cast(Vec[i64], s[BLK_STMTS]))
	} else if k == ST_LET {
		cg_expr(s[LET_INIT])
	} else if k == ST_ASSIGN {
		if cg_in_main != 0 {
			cg_store(s[AS_TARGET], s[N_POS])
		}
		cg_expr(s[AS_TARGET])
		cg_expr(s[AS_VALUE])
	} else if k == ST_EXPR {
		cg_expr(s[ES_X])
	} else if k == ST_IF {
		cg_expr(s[IF_COND])
		cg_stmt(s[IF_THEN])
		cg_stmt(s[IF_ELSE])
	} else if k == ST_WHILE {
		cg_expr(s[WH_COND])
		cg_stmt(s[WH_BODY])
		cg_stmt(s[WH_POST])
	} else if k == ST_RETURN {
		cg_expr(s[RET_VALUE])
		if s[RET_VALUES] != 0 {
			cg_exprs(cast(Vec[i64], s[RET_VALUES]))
		}
	} else if k == ST_CALLMULTI {
		if cg_in_main != 0 {
			let syms = cast(Vec[i64], s[CM_SYMS])
			mut i = 0
			for i < syms.len {
				let t = vec_get(syms, i)
				if t != 0 && t[S_KIND] == SYM_GLOBAL && t[S_TLS] != 0 {
					vec_push(cg_stores, t)
					vec_push(cg_stores, s[N_POS])
				}
				i = i + 1
			}
		}
		cg_expr(s[CM_CALL])
	}
}

fn cg_exprs(v Vec[i64]) {
	mut i = 0
	for i < v.len {
		cg_expr(vec_get(v, i))
		i = i + 1
	}
}

fn cg_expr(e i64) {
	if e == 0 {
		return
	}
	let k = e[N_KIND]
	if k == EX_CALL {
		if cg_in_main != 0 {
			// A runtime call that stores into its first argument (a map insert, an in-place
			// append) writes the global that argument names.
			if e[CALL_STORE] != 0 && e[CALL_ARGS] != 0 && cast(Vec[i64], e[CALL_ARGS]).len > 0 {
				cg_store(vec_get(cast(Vec[i64], e[CALL_ARGS]), 0), e[N_POS])
			}
			cg_visit(e[CALL_FN])
		}
		cg_expr(e[CALL_CALLEE])
		cg_exprs(cast(Vec[i64], e[CALL_ARGS]))
	} else if k == EX_IDENT {
		let s = e[ID_REF]
		if cg_in_main == 0 && s != 0 && s[S_KIND] == SYM_GLOBAL && s[S_TLS] != 0 && vec_has(cg_refs, s) == 0 {
			vec_push(cg_refs, s)
		}
	} else if k == EX_UNARY {
		cg_expr(e[UN_X])
	} else if k == EX_BINARY {
		cg_expr(e[BIN_L])
		cg_expr(e[BIN_R])
	} else if k == EX_INDEX {
		cg_expr(e[IX_X])
		cg_expr(e[IX_I])
	} else if k == EX_CONV {
		cg_expr(e[CV_X])
	} else if k == EX_SEQ {
		cg_stmts(cast(Vec[i64], e[SEQ_STMTS]))
		cg_expr(e[SEQ_VALUE])
	} else if k == EX_MEM {
		cg_expr(e[MEM_BASE])
		cg_expr(e[MEM_INDEX])
		cg_expr(e[MEM_LEN])
	} else if k == EX_ELEM {
		cg_expr(e[ELEM_SEQ])
		cg_expr(e[ELEM_IDX])
	}
}
