// Parser: tokens to AST nodes. Accepts Tin v1 (fn/let/while, untyped words) and
// Tin v2 (Go syntax: func, :=, for, types, structs, methods, packages).

var prog_fns;
var prog_consts;
var prog_vars;
var prog_types;
var prog_shapes;
var prog_uses;
var prog_ons;
var file_pkgs;     // per file: package name, "" for main
var file_imports;  // per file: vec of [alias, path]
var file_v2;       // per file: 1 when it declares a package or uses func
var file_ed1;      // per file: 1 when parsed as edition 1 (generic instances re-parse with it)
var cur_file;

// Function declaration layout.
const F_POS = 0;
const F_NAME = 1;
const F_PARAMS = 2;
const F_EXTERN = 3;
const F_BODY = 4;
const F_SLOTS = 5;
const F_LOCALS = 6;  // params then lets, in declaration order (set by the checker)
const F_LEAF = 7;    // makes no calls (set by analysis)
const F_USED = 8;    // extern that is called, so it needs an import
const F_ADDR = 9;    // code address (set by the linker)
const F_GOT = 10;    // import index of an extern
const F_PTYPES = 11; // param type exprs, then resolved types
const F_RTYPES = 12; // result type exprs, then resolved types
const F_RECV = 13;   // method receiver type expr, then type
const F_RECVNAME = 14;
const F_FILE = 15;
const F_QNAME = 16;  // symbol name: pkg.Name, Type.Method
const F_LEGACY = 17; // declared with fn: untyped words, C strings
const F_VARIADIC = 18;
const F_REACH = 19;  // reachable from main (set by the checker)
const F_TYPE = 20;   // func type
const F_LIFTED = 21; // function literal lifted to top level
const F_INDEX = 22;  // position in prog_fns (set by codegen)
const F_TPARAMS = 28; // generic: type parameter names (0 for ordinary functions)
const F_TCONS = 29;   // generic: per type parameter, a vec of allowed types (0: unconstrained)
const F_TOKS = 30;    // generic: the tokens, re-parsed for each instance
const F_TOKAT = 31;
const F_TBIND = 32;   // instance: vec of [name, type] bindings
const F_INSTS = 33;   // generic: vec of [type args, instance]
const F_GENOF = 34;   // instance: its generic
const F_BANG = 35;   // results written !T: a return gives the values, fail the fault
const F_PARENT = 36; // enclosing function if this is a closure
const F_CAPTURES = 37; // vec of captured outer symbols
const F_OUTER_SYMS = 38; // snapshot of outer symbols at definition
const F_ENV_SYM = 39; // symbol for $env parameter
const F_DONE = 40; // checked already
const F_ESCAPES = 41; // whether closure escapes
const F_INSTCYCLE = 42; // generic: an endless instantiation was reported
const F_ATTRS = 43; // edition 1 attributes, in source order
const F_SIZE = 44;
const F_MUTRES = 24;  // result is a fresh (request-pool) value the caller may modify
const F_RECVMUT = 25; // method may modify its receiver (needs a fresh one)

// Const, var and type declaration layout.
const D_POS = 0;
const D_NAME = 1;
const D_INIT = 2;
const D_VAL = 3;
const D_TYPE = 4;
const D_FILE = 5;
const D_IOTA = 6;
const D_SYM = 7;
const D_SHARED = 8;  // shared var: one process-wide word (runtime only)
const D_TPARAMS = 9;  // generic type: parameter names
const D_TCONS = 10;
const D_INSTS = 11;   // generic type: vec of [type args, type]
const D_METHODS = 12; // generic type: its method templates
const D_SHAPE = 13;   // shape: vec of method signature nodes
const D_INITS = 14;   // const specification expressions, repeated by a bare grouped spec
const D_UNION = 15;   // shape: vec of the shapes it lists (composition), or of `= A | B`
const D_UNIONKIND = 16; // shape: 1 for the `= A | B` union form, 0 for a method set
const D_MUT = 17;     // edition 1 global binding mutability
const D_SIZE = 18;

var p_shared;

// Every AST node starts with its kind and position; expressions carry their type.
const N_KIND = 0;
const N_POS = 1;
const N_TYPE = 6;
const N_REGION = 9;   // region pass: where a reference value lives
const N_SIZE = 12;

const EX_INT = 1;
const EX_STR = 2;
const EX_IDENT = 3;
const EX_UNARY = 4;
const EX_BINARY = 5;
const EX_CALL = 6;
const EX_INDEX = 7;
const EX_REG = 8;      // codegen-only: a value already in a register
const EX_CONV = 9;     // checker-made conversion
const ST_BLOCK = 10;
const ST_LET = 11;
const ST_ASSIGN = 12;
const ST_EXPR = 13;
const ST_IF = 14;
const ST_WHILE = 15;
const ST_RETURN = 16;
const ST_BREAK = 17;
const ST_CONTINUE = 18;
const EX_FLOAT = 20;
const EX_NIL = 21;
const EX_SELECT = 22;
const EX_SLICE = 23;
const EX_COMPOSITE = 24;
const EX_TYPE = 25;
const EX_SEQ = 26;     // checker-made: run statements, then yield a value
const EX_FUNCREF = 27; // checker-made: address of a function
const EX_FUNCLIT = 28;
const EX_MEM = 29;     // checker-made: sized load/store at base + index*scale + off
const EX_ELEM = 39;    // checker-made: bounds-checked slice or string element
const EX_TRY = 48;
const EX_CATCH = 52;   // E catch name { body }
const ST_FAIL = 53;    // fail X
const EX_MUTARG = 54;  // mut x: an argument for a mut parameter
const EX_INTERP = 55;  // "text {x} {y:.2}": parts, values, format specs
const ST_CONST = 56;   // local constant declarations; field 2 is their declaration vector
const EX_MATCH = 58;    // edition 1 match expression or statement
const EX_UNIT = 59;     // edition 1 typed unit literal
const EX_COALESCE = 60; // edition 1 nil coalescing
const EX_WRAP = 61;     // edition 1 contextual fault message
const EX_BOUNDARY = 65; // edition 1 boundary expression
const ST_SELECT = 66;
const ST_SCOPE = 67;
const ST_DETACH = 68;
const ST_ONCE = 69;
const ST_USE = 70;
const ST_ON = 71;
const ST_BSTORE = 72; // checker-made: a boundary block's last expression, stored for its wrapper (ES_X)
const ST_MSTORE = 73; // checker-made: a match arm's value, stored in the match's value local (ES_X)
const ST_MULTI = 30;
const ST_RANGE = 31;
const ST_SWITCH = 32;
const ST_LIST = 33;    // statements spliced into the enclosing block
const ST_CALLMULTI = 34;
const ST_GO = 35;
const ST_DEFER = 36;
const TX_NAME = 40;
const TX_SLICE = 41;
const TX_MAP = 42;
const TX_PTR = 43;
const TX_FUNC = 44;
const TX_STRUCT = 45;
const TX_ARRAY = 46;
const TX_CHAN = 47;
const TX_OPT = 49;
const TX_DYN = 57;   // dyn Shape: a fat reference, TX_A holds the shape's type expr
const TX_SECRET = 62; // edition 1 sensitive type wrapper
const TX_MAX = 63;    // edition 1 bounded type wrapper
const TX_TUPLE = 64;  // edition 1 tuple type

// Node fields by kind.
const INT_VAL = 2;
const STR_PTR = 2;
const STR_LEN = 3;
const ID_NAME = 2;
const ID_REF = 3;
const UN_OP = 2;
const UN_X = 3;
const BIN_OP = 2;
const BIN_L = 3;
const BIN_R = 4;
const CALL_NAME = 2;
const CALL_ARGS = 3;
const CALL_INTRINSIC = 4;
const CALL_FN = 5;
const CALL_CALLEE = 7;
const REG_NUM = 2;
const IX_X = 2;
const IX_I = 3;
const IX_ARGS = 4;  // X[A, B] or X[[]T]: type arguments, when they cannot be an index
const IX_HDR = 7;     // a slice/string header field: invariant while a loop makes no calls
const CV_X = 2;
const CV_KIND = 3;
const FL_BITS = 2;
const FL_TEXT = 3;
const SEL_X = 2;
const SEL_NAME = 3;
const SL_X = 2;
const SL_LO = 3;
const SL_HI = 4;
const CL_TYPE = 2;
const CL_ELEMS = 3;
const CL_KEYS = 4;
const CL_ADDR = 5;
const TYX = 2;
const SEQ_STMTS = 2;
const SEQ_VALUE = 3;
const FR_FN = 2;
const FR_RAW = 3;
const LIT_FN = 2;
const LIT_ESCAPE = 3;
const LIT_SCOPED = 4; // checker: a closure passed to a scope's spawn (#232)
const BLK_STMTS = 2;
const LET_NAME = 2;
const LET_INIT = 3;
const LET_SYM = 4;
const LET_TYPE = 5;
const LET_MUT = 6;    // edition 1: the binding name may be reassigned
const AS_TARGET = 2;
const AS_VALUE = 3;
const ES_X = 2;
const IF_COND = 2;
const IF_THEN = 3;
const IF_ELSE = 4;
const IF_INIT = 5;
const WH_COND = 2;
const WH_BODY = 3;
const WH_POST = 4;
const WH_INIT = 5;
const WH_ONCE = 7;    // a switch: break leaves it, continue passes through
const WH_LABEL = 8;   // edition 1 loop label
const BR_LABEL = 2;
const CONT_LABEL = 2;
const RET_VALUE = 2;
const RET_VALUES = 3;
const MU_TARGETS = 2;
const MU_VALUES = 3;
const MU_DEFINE = 4;
const MU_MUT = 5;     // edition 1: mutability of names introduced by this binding
const RG_KEY = 2;
const RG_VAL = 3;
const RG_EXPR = 4;
const RG_BODY = 5;
const RG_DEFINE = 6;
const RG_LABEL = 7;
const SW_TAG = 2;
const SW_CASES = 3;
const SW_INIT = 5;
const LIST_STMTS = 2;
const CM_CALL = 2;
const CM_SYMS = 3;
const GO_CALL = 2;
const TX_A = 2;
const TX_B = 3;
const TX_ARGS = 4;  // Name[T1, T2]: type arguments
const MEM_BASE = 2;
const MEM_INDEX = 3;
const MEM_SCALE = 4;
const MEM_OFF = 5;
const MEM_HDR = 7;    // a header word: invariant while a loop makes no calls
const MEM_LEN = 8;    // bounds check: the index must be below this length (0: none)
const ELEM_SEQ = 2;
const ELEM_IDX = 3;
const ELEM_SIZE = 4;
const ELEM_STR = 5;
const ELEM_SAFE = 7;  // index proven in range: no bounds check
const TRY_X = 2;
const TRY_SOFT = 3; // checker: a parallel line, which may also be a plain value (#232)
const CATCH_X = 2;
const CATCH_NAME = 3;
const CATCH_BODY = 4;
const FAIL_X = 2;
const MUTARG_X = 2;
const INTERP_PARTS = 2;
const INTERP_ARGS = 3;
const INTERP_SPECS = 4;
const MATCH_SUBJECT = 2;
const MATCH_ARMS = 3;
const ARM_POS = 0;
const ARM_PATTERNS = 1;
const ARM_GUARD = 2;
const ARM_BODY = 3;
const ARM_BLOCK = 4;
const PAT_KIND = 0;
const PAT_POS = 1;
const PAT_A = 2;
const PAT_B = 3;
const PAT_NAME = 4;
const PAT_CHILDREN = 5;
const PAT_WILD = 1;
const PAT_LITERAL = 2;
const PAT_RANGE = 3;
const PAT_VARIANT = 4;
const PAT_NAME_KIND = 5;
const UNIT_VALUE = 2;
const UNIT_NAME = 3;
const UNIT_TEXT = 4;
const UNIT_FLOAT = 5;
const COAL_X = 2;
const COAL_FALLBACK = 3;
const WRAP_X = 2;
const WRAP_MESSAGE = 3;
const BOUND_KIND = 2;
const BOUND_ARGS = 3;
const BOUND_BODY = 4;
const BOUND_WITHIN = 1;
const BOUND_LIMIT = 2;
const BOUND_GUARD = 3;
const BOUND_ARENA = 4;
const BOUND_PARALLEL = 5;
const BOUND_WITH = 6;
const SELECT_ARMS = 2;
const SELECT_ARM_POS = 0;
const SELECT_ARM_NAME = 1;
const SELECT_ARM_WAIT = 2;
const SELECT_ARM_BODY = 3;
const SELECT_ARM_BLOCK = 4;
const SCOPE_NAME = 2;
const SCOPE_BODY = 3;
const USE_NAME = 2;
const USE_INIT = 3;
const ON_EVENT = 2;
const ON_BODY = 3;
const BODY_BLOCK = 2;
const BLK_FLAT = 3;   // a checker-made block that opens no scope
const CALL_STORE = 8; // a runtime call that stores into its first argument (region pass)
const CALL_METHOD = 9; // argument 0 is a method receiver (no call-site mut)
const CALL_DYN_SHAPE = 10; // shape whose method set can be called through this dyn value
const CALL_DYN_INDEX = 11; // method slot in its per-type table (keep is slot zero)
// Regions of reference values, for the ember/ingot rules.
const R_UNKNOWN = 0;
const R_EMBER = 1;    // lives in the current request's pool
const R_INGOT = 2;    // lives in the core's long-lived heap
const R_OWNED = 3;    // a fresh keep() copy, only storable into ingot memory
const R_STATIC = 4;   // string literals and other immortal data
const F_MUTS = 23;   // vec: 1 for each mut parameter

var p_toks;
var p_i;
var p_nolit;   // composite literals after a name are off in if/for/switch headers
var p_legacy;  // parsing a v1 fn body
var p_edition1;
var p_decl_mut;
var p_range_expr;
var p_pending_label;
var p_saw_package;
var p_saw_topdecl;
var p_mutres;  // the result list just parsed was marked mut
var p_bangres; // the result list just parsed was written !T

fn node_new(kind, pos) {
    let n = calloc(N_SIZE, 8);
    n[N_KIND] = kind;
    n[N_POS] = pos;
    return n;
}

fn decl_new(pos, name) {
    let d = calloc(D_SIZE, 8);
    d[D_POS] = pos;
    d[D_NAME] = name;
    d[D_FILE] = cur_file;
    d[D_SHARED] = p_shared;
    return d;
}

fn fn_new(pos, name) {
    let f = calloc(F_SIZE, 8);
    f[F_POS] = pos;
    f[F_NAME] = name;
    f[F_PARAMS] = vec_new();
    f[F_PTYPES] = vec_new();
    f[F_RTYPES] = vec_new();
    f[F_MUTS] = vec_new();
    f[F_FILE] = cur_file;
    return f;
}

fn parse_setup() {
    prog_fns = vec_new();
    prog_consts = vec_new();
    prog_vars = vec_new();
    prog_types = vec_new();
    prog_shapes = vec_new();
    prog_uses = vec_new();
    prog_ons = vec_new();
    file_pkgs = vec_new();
    file_imports = vec_new();
    file_v2 = vec_new();
    file_ed1 = vec_new();
}

// parse keeps the edition-0 entry point stable. Tin 1 callers select the new grammar explicitly.
fn parse(toks) {
    parse_mode(toks, 0);
}

fn parse_edition1(toks) {
    parse_mode(toks, 1);
}

// parse_mode reads one file's declarations; cur_file must be its index in files.
fn parse_mode(toks, edition) {
    p_toks = toks;
    p_i = 0;
    p_nolit = 0;
    p_edition1 = edition;
    p_decl_mut = 1;
    p_range_expr = 0;
    p_pending_label = 0;
    p_saw_package = 0;
    p_saw_topdecl = 0;
    vec_push(file_pkgs, "");
    vec_push(file_imports, vec_new());
    vec_push(file_v2, edition);
    vec_push(file_ed1, edition);
    while p_peek()[T_KIND] != TK_EOF {
        if p_edition1 && p_saw_topdecl && p_is("import") {
            p_fail_code(p_peek()[T_POS], "E002 IMPORT_ORDER", "imports must precede declarations");
        }
        if p_edition1 && !p_saw_package && !p_is("package") {
            p_fail_code(p_peek()[T_POS], "E001 PACKAGE_CLAUSE", "edition 1 files start with a package declaration");
        }
        if p_edition1 && !p_is(";") && !p_is("package") && !p_is("import") {
            p_saw_topdecl = 1;
        }
        if p_is(";") {
            p_next();
        } else if p_is("package") {
            if p_edition1 && p_saw_package {
                p_fail_code(p_peek()[T_POS], "E001 PACKAGE_CLAUSE", "a file has one package declaration");
            }
            p_next();
            file_pkgs[VEC_DATA][cur_file] = p_expect_ident()[T_TEXT];
            p_saw_package = 1;
            if streq(vec_get(file_pkgs, cur_file), "main") {
                file_pkgs[VEC_DATA][cur_file] = "";
            }
            file_v2[VEC_DATA][cur_file] = 1;
        } else if p_is("import") {
            p_next();
            if p_is("(") {
                if p_edition1 {
                    p_fail_code(p_peek()[T_POS], "E091 ONE_PER_DECLARATION", "edition 1 writes one import path per declaration");
                }
                p_next();
                while !p_is(")") {
                    if p_is(";") {
                        p_next();
                    } else {
                        parse_import();
                    }
                }
                p_next();
            } else {
                parse_import();
            }
        } else if p_edition1 && p_is("@") {
            let attrs = parse_attributes();
            if !p_is("fn") {
                p_fail_found_code(p_peek()[T_POS], "E040 ATTRIBUTE_PLACEMENT", "attributes here must precede a function", p_peek());
            }
            let f = parse_fn(0, 0);
            f[F_ATTRS] = attrs;
            vec_push(prog_fns, f);
        } else if p_is("fn") {
            vec_push(prog_fns, parse_fn(0, !p_edition1));
        } else if p_is("func") {
            if p_edition1 {
                p_fail_code(p_peek()[T_POS], "E090 OLD_SYNTAX", "edition 1 uses 'fn', not 'func'");
            }
            file_v2[VEC_DATA][cur_file] = 1;
            vec_push(prog_fns, parse_fn(0, 0));
        } else if p_is("extern") {
            if p_edition1 {
                p_fail_code(p_peek()[T_POS], "E090 OLD_SYNTAX", "edition 1 does not use extern declarations");
            }
            p_next();
            vec_push(prog_fns, parse_fn(1, p_is("fn")));
        } else if p_is("const") {
            p_next();
            if p_edition1 && p_is("(") {
                p_fail_code(p_peek()[T_POS], "E091 ONE_PER_DECLARATION", "edition 1 declares one constant per declaration");
            }
            parse_group(1, prog_consts);
        } else if p_edition1 && p_is("let") {
            p_next();
            p_decl_mut = 0;
            parse_group(0, prog_vars);
            p_decl_mut = 1;
        } else if p_edition1 && p_is("mut") {
            p_next();
            p_decl_mut = 1;
            parse_group(0, prog_vars);
        } else if p_is("var") {
            if p_edition1 {
                p_fail_code(p_peek()[T_POS], "E090 OLD_SYNTAX", "edition 1 uses 'let' or 'mut', not 'var'");
            }
            p_decl_mut = 1;
            p_next();
            parse_group(0, prog_vars);
        } else if p_word("shared") {
            p_next();
            if p_edition1 {
                p_expect("let");
                p_decl_mut = 0;
            } else {
                p_expect("var");
                p_decl_mut = 1;
            }
            p_shared = 1;
            parse_group(0, prog_vars);
            p_shared = 0;
        } else if p_is("type") {
            p_next();
            if p_is("(") {
                if p_edition1 {
                    p_fail_code(p_peek()[T_POS], "E091 ONE_PER_DECLARATION", "edition 1 declares one type per declaration");
                }
                p_next();
                while !p_is(")") {
                    if p_is(";") {
                        p_next();
                    } else {
                        parse_type_decl();
                    }
                }
                p_next();
            } else {
                parse_type_decl();
            }
        } else if p_word("shape") {
            file_v2[VEC_DATA][cur_file] = 1;
            vec_push(prog_shapes, parse_shape_decl());
        } else if p_edition1 && p_word("use") {
            vec_push(prog_uses, parse_use_decl());
        } else if p_edition1 && p_word("on") {
            vec_push(prog_ons, parse_on_decl());
        } else {
            if p_edition1 {
                p_fail_found_code(p_peek()[T_POS], "E020 UNEXPECTED", "expected a declaration (fn, const, let, mut, type, shape, use, on)", p_peek());
            }
            p_fail_found_code(p_peek()[T_POS], "E020 UNEXPECTED", "expected a declaration (func, var, const, type, shape)", p_peek());
        }
    }
    if p_edition1 && !p_saw_package {
        p_fail_code(p_peek()[T_POS], "E001 PACKAGE_CLAUSE", "edition 1 files start with a package declaration");
    }
}

fn parse_import() {
    let alias = 0;
    if !p_edition1 && p_peek()[T_KIND] == TK_IDENT {
        alias = p_next()[T_TEXT];
    }
    let t = p_next();
    if t[T_KIND] != TK_STRING {
        p_fail_found_code(t[T_POS], "E020 UNEXPECTED", "expected an import path", t);
    }
    let path = t[T_TEXT];
    if !alias {
        // The package name is the last path element: "net/http" is http.
        alias = path;
        let i = 0;
        while load8(path + i) != 0 {
            if load8(path + i) == '/' {
                alias = path + i + 1;
            }
            i = i + 1;
        }
    }
    let rec = vec_new();
    vec_push(rec, alias);
    vec_push(rec, path);
    vec_push(vec_get(file_imports, cur_file), rec);
    p_end();
}

fn parse_use_decl() {
    let u = node_new(ST_USE, p_next()[T_POS]);
    u[USE_NAME] = p_expect_ident()[T_TEXT];
    p_expect("=");
    u[USE_INIT] = parse_expr(1);
    p_end();
    return u;
}

fn parse_on_decl() {
    let pos = p_next()[T_POS];
    let on = node_new(ST_ON, pos);
    let saved = p_nolit;
    p_nolit = 1;
    on[ON_EVENT] = parse_expr(1);
    p_nolit = saved;
    on[ON_BODY] = parse_block();
    return on;
}

// parse_attributes reads the edition-1 attributes preceding a function or field.
fn parse_attributes() {
    let attrs = vec_new();
    while p_is("@") {
        let pos = p_next()[T_POS];
        let attr = vec_new();
        vec_push(attr, pos);
        vec_push(attr, p_expect_ident()[T_TEXT]);
        let args = vec_new();
        if p_is("(") {
            p_next();
            if !p_is(")") {
                args = parse_expr_list();
            }
            p_expect(")");
        }
        vec_push(attr, args);
        vec_push(attrs, attr);
    }
    return attrs;
}

// parse_group reads one const/var declaration or a parenthesized group of them.
fn parse_group(is_const, decls) {
    if !p_is("(") {
        parse_value_spec(is_const, 0, 0, 0, decls);
        return;
    }
    if p_edition1 {
        p_fail_code(p_peek()[T_POS], "E091 ONE_PER_DECLARATION", "edition 1 declares one name per declaration");
    }
    p_next();
    let iota = 0;
    let last_init = 0;
    let last_type = 0;
    while !p_is(")") {
        if p_is(";") {
            p_next();
        } else {
            let d = parse_value_spec(is_const, iota, last_init, last_type, decls);
            if is_const {
                last_init = d[D_INITS];
                last_type = d[D_TYPE];
            }
            iota = iota + 1;
        }
    }
    p_next();
}

fn parse_value_spec(is_const, iota, prev_init, prev_type, decls) {
    let pos = p_peek()[T_POS];
    let names = vec_new();
    vec_push(names, p_expect_ident()[T_TEXT]);
    while p_is(",") {
        p_next();
        vec_push(names, p_expect_ident()[T_TEXT]);
    }
    if p_edition1 && names[VEC_LEN] > 1 {
        p_fail_code(pos, "E091 ONE_PER_DECLARATION", "edition 1 declares one name per declaration");
    }
    let ty = 0;
    if !p_is("=") && !p_is(";") && !p_is(")") && !p_is("}") {
        ty = parse_type();
    }
    let inits = 0;
    if p_is("=") {
        p_next();
        inits = parse_expr_list();
    }
    if is_const {
        if !inits {
            if ty || !prev_init {
                p_fail_code(pos, "E021 CONST_VALUES", "missing constant value");
            }
            inits = prev_init;
            ty = prev_type;
        }
        if inits[VEC_LEN] != names[VEC_LEN] {
            p_fail_code(pos, "E021 CONST_VALUES", "constant declaration count mismatch");
        }
    }
    let first = 0;
    let i = 0;
    while i < names[VEC_LEN] {
        let d = decl_new(pos, vec_get(names, i));
        d[D_TYPE] = ty;
        d[D_IOTA] = iota;
        d[D_MUT] = !is_const && p_decl_mut;
        d[D_INITS] = inits;
        if inits && i < inits[VEC_LEN] {
            d[D_INIT] = vec_get(inits, i);
        }
        if is_const {
            if !d[D_INIT] {
                p_fail_code(pos, "E021 CONST_VALUES", "missing constant value");
            }
        }
        vec_push(decls, d);
        if !first {
            first = d;
        }
        i = i + 1;
    }
    p_end();
    return first;
}

fn parse_type_decl() {
    let pos = p_peek()[T_POS];
    let d = decl_new(pos, p_expect_ident()[T_TEXT]);
    // type Stack[T constraints.Any] ...: a name and a constraint after '[' (an array type has a length).
    if p_is("[") && p_peek2()[T_KIND] == TK_IDENT && !p_legacy {
        let save = p_i;
        p_next();
        p_next();
        let generic = !p_is("]");
        p_i = save;
        if generic {
            d[D_TPARAMS] = vec_new();
            d[D_TCONS] = vec_new();
            parse_tparams(d[D_TPARAMS], d[D_TCONS]);
        }
    }
    if p_is("=") {
        p_next();
        d[D_IOTA] = 1;
    }
    d[D_TYPE] = parse_type();
    vec_push(prog_types, d);
    p_end();
}

// ---- shapes ----

// parse_shape_decl reads a shape: shape Name { methods and listed shapes } or the
// named union shape Name = A | B | C. `shape` is a contextual word (like enum, fail
// and shared): it opens a declaration only at the top level, where no other form
// starts with that name, so a program may still use it as a name elsewhere. A method
// is a function node with no receiver and no body, so a shape signature and a func
// signature are parsed by the same code and cannot drift apart.
fn parse_shape_decl() {
    let pos = p_next()[T_POS];
    let d = decl_new(pos, p_expect_ident()[T_TEXT]);
    d[D_SHAPE] = vec_new();
    d[D_UNION] = vec_new();
    // shape Seq[T]: a shape may take type parameters, constrained like a generic type's.
    if p_is("[") {
        d[D_TPARAMS] = vec_new();
        d[D_TCONS] = vec_new();
        parse_tparams(d[D_TPARAMS], d[D_TCONS]);
    }
    if p_is("=") {
        p_next();
        d[D_UNIONKIND] = 1;
        d[D_UNION] = parse_type_union(parse_type());
        p_end();
        return d;
    }
    p_expect("{");
    while !p_is("}") {
        if p_is(";") {
            p_next();
            continue;
        }
        let mpos = p_peek()[T_POS];
        // Name( ... is a method signature; a bare name lists another shape (composition),
        // and `=` above already took the union form.
        if p_peek2()[T_KIND] == TK_PUNCT && streq(p_peek2()[T_TEXT], "(") {
            vec_push(d[D_SHAPE], parse_shape_method(mpos));
        } else {
            vec_push(d[D_UNION], parse_type());
        }
        p_end();
    }
    p_next();
    p_end();
    return d;
}

// parse_shape_method reads Name(params) results with no receiver and no body, keeping
// the mut marks, the variadic and the !T fault result a func declaration keeps.
fn parse_shape_method(pos) {
    let m = fn_new(pos, p_expect_ident()[T_TEXT]);
    parse_params(m);
    p_mutres = 0;
    p_bangres = 0;
    m[F_RTYPES] = parse_results();
    m[F_MUTRES] = p_mutres;
    m[F_BANG] = p_bangres;
    return m;
}

fn p_peek() {
    return vec_get(p_toks, p_i);
}

fn p_peek2() {
    if p_i + 1 < p_toks[VEC_LEN] {
        return vec_get(p_toks, p_i + 1);
    }
    return vec_get(p_toks, p_i);
}

fn p_next() {
    let t = p_peek();
    if t[T_KIND] != TK_EOF {
        p_i = p_i + 1;
    }
    return t;
}

// p_is reports whether the next token is the given keyword or punctuation.
fn p_is(text) {
    let t = p_peek();
    return (t[T_KIND] == TK_KEYWORD || t[T_KIND] == TK_PUNCT) && streq(t[T_TEXT], text);
}

// p_word recognizes contextual words and edition-1 keywords by spelling.
fn p_word(text) {
    let t = p_peek();
    return (t[T_KIND] == TK_IDENT || (p_edition1 && t[T_KIND] == TK_KEYWORD)) && streq(t[T_TEXT], text);
}

fn tok_is(t, text) {
    return (t[T_KIND] == TK_KEYWORD || t[T_KIND] == TK_PUNCT) && streq(t[T_TEXT], text);
}

// p_end finishes a statement or declaration: a semicolon, or nothing before } or ).
fn p_end() {
    if p_is(";") {
        p_next();
        return;
    }
    if p_is("}") || p_is(")") || p_peek()[T_KIND] == TK_EOF {
        return;
    }
    if p_edition1 {
        p_fail_found_code(p_peek()[T_POS], "E020 UNEXPECTED", "expected a newline or end of block", p_peek());
    }
    p_expect(";");
}

fn buf_describe(b, t) {
    let k = t[T_KIND];
    if k == TK_EOF {
        buf_str(b, "end of file");
    } else if k == TK_IDENT {
        buf_str(b, "name '");
        buf_str(b, t[T_TEXT]);
        buf_byte(b, '\'');
    } else if k == TK_INT || k == TK_FLOAT {
        buf_str(b, "a number");
    } else if k == TK_STRING {
        buf_str(b, "a string");
    } else if k == TK_PUNCT && streq(t[T_TEXT], ";") && t[T_VAL] {
        buf_str(b, "newline");
    } else {
        buf_byte(b, '\'');
        buf_str(b, t[T_TEXT]);
        buf_byte(b, '\'');
    }
}

fn p_fail_found(pos, msg, t) {
    let e = err_begin(pos);
    buf_str(e, msg);
    buf_str(e, ", found ");
    buf_describe(e, t);
    fatal(e);
}

fn p_fail(pos, msg) {
    let e = err_begin(pos);
    buf_str(e, msg);
    fatal(e);
}

// p_fail_code and p_fail_found_code stop with a coded error (docs/ERRORS.md).
fn p_fail_code(pos, code, msg) {
    let e = err_code(pos, code);
    buf_str(e, msg);
    fatal(e);
}

fn p_fail_found_code(pos, code, msg, t) {
    let e = err_code(pos, code);
    buf_str(e, msg);
    buf_str(e, ", found ");
    buf_describe(e, t);
    fatal(e);
}

fn p_expect(text) {
    if !p_is(text) {
        let e = err_code(p_peek()[T_POS], "E020 UNEXPECTED");
        buf_str(e, "expected '");
        buf_str(e, text);
        buf_str(e, "', found ");
        buf_describe(e, p_peek());
        fatal(e);
    }
    return p_next();
}

fn p_expect_ident() {
    if p_peek()[T_KIND] != TK_IDENT {
        p_fail_found_code(p_peek()[T_POS], "E020 UNEXPECTED", "expected a name", p_peek());
    }
    return p_next();
}

// ---- types ----

fn starts_type() {
    let t = p_peek();
    return t[T_KIND] == TK_IDENT || p_is("[") || p_is("map") || p_is("*") || p_is("func") || p_is("struct") || p_is("?") || p_is("mut") || (p_edition1 && p_word("secret"));
}

fn parse_type() {
    let ty = parse_type_base();
    if p_edition1 && p_word("max") {
        let bounded = node_new(TX_MAX, ty[N_POS]);
        bounded[TX_A] = ty;
        p_next();
        bounded[TX_B] = parse_expr(1);
        return bounded;
    }
    return ty;
}

fn parse_type_base() {
    let pos = p_peek()[T_POS];
    if p_edition1 && p_word("secret") {
        p_next();
        let secret = node_new(TX_SECRET, pos);
        secret[TX_A] = parse_type();
        return secret;
    }
    // Standard-library files are edition 0 and opt parameters in with secret too (#239).
    if !p_edition1 && vec_get(file_trusted, cur_file) && p_word("secret") && (p_peek2()[T_KIND] == TK_IDENT || tok_is(p_peek2(), "[") || tok_is(p_peek2(), "?")) {
        p_next();
        let libsecret = node_new(TX_SECRET, pos);
        libsecret[TX_A] = parse_type();
        return libsecret;
    }
    if p_is("[") {
        p_next();
        if p_is("]") {
            p_next();
            let s = node_new(TX_SLICE, pos);
            s[TX_A] = parse_type();
            return s;
        }
        let a = node_new(TX_ARRAY, pos);
        a[TX_A] = parse_expr(1);
        p_expect("]");
        a[TX_B] = parse_type();
        return a;
    }
    if p_is("map") {
        p_next();
        p_expect("[");
        let m = node_new(TX_MAP, pos);
        m[TX_A] = parse_type();
        p_expect("]");
        m[TX_B] = parse_type();
        return m;
    }
    if p_is("*") {
        if p_edition1 {
            p_fail_code(pos, "E090 OLD_SYNTAX", "edition 1 does not use pointer types");
        }
        p_next();
        let pt = node_new(TX_PTR, pos);
        pt[TX_A] = parse_type();
        return pt;
    }
    if p_is("?") {
        p_next();
        let ot = node_new(TX_OPT, pos);
        ot[TX_A] = parse_type();
        return ot;
    }
    if p_edition1 && p_is("(") {
        let tuple = node_new(TX_TUPLE, pos);
        ptl_muts = 0;
        tuple[TX_A] = parse_type_list();
        if tuple[TX_A][VEC_LEN] == 0 {
            p_fail_code(pos, "E043 EMPTY_TUPLE", "a tuple type needs at least one element type");
        }
        return tuple;
    }
    if p_is("func") || (p_edition1 && p_is("fn")) {
        if p_edition1 && p_is("func") {
            p_fail_code(pos, "E090 OLD_SYNTAX", "edition 1 uses 'fn' for function types");
        }
        p_next();
        let ft = node_new(TX_FUNC, pos);
        ptl_muts = 0;
        ft[TX_A] = parse_type_list();
        ft[TX_ARGS] = ptl_muts;
        ft[TX_B] = parse_results();
        return ft;
    }
    if p_is("struct") {
        p_next();
        return parse_struct_body(pos);
    }
    if p_word("enum") && tok_is(p_peek2(), "{") && !p_legacy {
        p_next();
        return parse_enum_body(pos);
    }
    // dyn Shape: a fat reference to anything satisfying Shape. Contextual: it is a
    // keyword in type position only when a shape name follows, so a type of its own
    // named `dyn` still resolves as a name.
    if p_word("dyn") && p_peek2()[T_KIND] == TK_IDENT && !p_legacy {
        p_next();
        let dy = node_new(TX_DYN, pos);
        dy[TX_A] = parse_type();
        return dy;
    }
    let t = p_expect_ident();
    if streq(t[T_TEXT], "chan") {
        if p_edition1 {
            p_fail_code(pos, "E090 OLD_SYNTAX", "edition 1 does not have channel types");
        }
        let c = node_new(TX_CHAN, pos);
        c[TX_A] = parse_type();
        return c;
    }
    let n = node_new(TX_NAME, pos);
    n[TX_B] = t[T_TEXT];
    if p_is(".") {
        p_next();
        n[TX_A] = t[T_TEXT];
        n[TX_B] = p_expect_ident()[T_TEXT];
    }
    if p_is("[") && !p_legacy {
        p_next();
        let args = vec_new();
        while !p_is("]") {
            vec_push(args, parse_type());
            if !p_is(",") {
                break;
            }
            p_next();
        }
        p_expect("]");
        n[TX_ARGS] = args;
    }
    return n;
}

// parse_tparams reads [T constraints.Any, U i64 | f64] into f's (or a type decl's) names and constraints.
fn parse_tparams(names, cons) {
    p_expect("[");
    while !p_is("]") {
        vec_push(names, p_expect_ident()[T_TEXT]);
        let c = 0;
        if !p_is(",") && !p_is("]") {
            let first = parse_type();
            c = parse_type_union(first);
        }
        vec_push(cons, c);
        if !p_is(",") {
            break;
        }
        p_next();
    }
    p_expect("]");
}

// parse_type_union reads the rest of a `A | B | C` union after its first member. A
// generic type parameter's constraint and a shape's named union are one grammar.
fn parse_type_union(first) {
    let c = vec_new();
    vec_push(c, first);
    while p_is("|") {
        p_next();
        vec_push(c, parse_type());
    }
    return c;
}

// parse_struct_attr reads the checked JSON field-name attribute.
fn parse_struct_attr(pos) {
    p_expect("@");
    let name = p_expect_ident()[T_TEXT];
    if !streq(name, "json") {
        p_fail_code(pos, "E041 UNKNOWN_ATTRIBUTE", "unknown struct attribute; supported attributes are @json(\"name\")");
    }
    p_expect("(");
    let value = p_next();
    if value[T_KIND] != TK_STRING {
        p_fail_code(pos, "E042 ATTRIBUTE_ARGS", "@json expects one string field name");
    }
    p_expect(")");
    return value[T_TEXT];
}

// parse_struct_body reads { a, b int; c string } into a vec of [name, type expr, json name].
// parse_enum_body reads enum { A(x T, y U), B, C }: a struct underneath, with a hidden tag
// field ($tag, the variant's index) and each variant's fields named Variant.field.
fn parse_enum_body(pos) {
    let st = node_new(TX_STRUCT, pos);
    let fields = vec_new();
    let variants = vec_new();
    let tag = vec_new();
    vec_push(tag, "$tag");
    let tt = node_new(TX_NAME, pos);
    tt[TX_B] = "i64";
    vec_push(tag, tt);
    vec_push(fields, tag);
    p_expect("{");
    while !p_is("}") {
        if p_is(";") || p_is(",") {
            p_next();
            continue;
        }
        let vname = p_expect_ident()[T_TEXT];
        let first = fields[VEC_LEN];
        if p_is("(") {
            p_next();
            if p_edition1 {
                let field_index = 0;
                while !p_is(")") {
                    let ty = parse_type();
                    let f = vec_new();
                    vec_push(f, enum_field_name(vname, field_index));
                    vec_push(f, ty);
                    vec_push(fields, f);
                    field_index = field_index + 1;
                    if !p_is(",") {
                        break;
                    }
                    p_next();
                }
            } else {
                let pending = vec_new();
                while !p_is(")") {
                    vec_push(pending, p_expect_ident()[T_TEXT]);
                    if p_is(",") {
                        p_next();
                        continue;
                    }
                    let ty = parse_type();
                    let i = 0;
                    while i < pending[VEC_LEN] {
                        let f = vec_new();
                        vec_push(f, str_cat3(vname, ".", vec_get(pending, i)));
                        vec_push(f, ty);
                        vec_push(fields, f);
                        i = i + 1;
                    }
                    pending = vec_new();
                    if p_is(",") {
                        p_next();
                    }
                }
                if pending[VEC_LEN] > 0 {
                    p_fail_code(pos, "E044 ENUM_FIELD_TYPES", "an enum variant's fields need types: Variant(name Type, ...)");
                }
            }
            p_next();
        }
        let v = vec_new();
        vec_push(v, vname);
        vec_push(v, first);
        vec_push(v, fields[VEC_LEN] - first);
        vec_push(variants, v);
    }
    p_next();
    if variants[VEC_LEN] == 0 {
        p_fail_code(pos, "E045 EMPTY_ENUM", "an enum needs at least one variant");
    }
    st[TX_A] = fields;
    st[TX_B] = variants;
    return st;
}

fn enum_field_name(variant, index) {
    let out = buf_new();
    buf_str(out, variant);
    buf_str(out, ".$");
    let digits = buf_new();
    let value = index;
    if value == 0 {
        buf_byte(digits, '0');
    } else {
        while value > 0 {
            buf_byte(digits, '0' + value % 10);
            value = value / 10;
        }
    }
    let i = digits[VEC_LEN] - 1;
    while i >= 0 {
        buf_byte(out, load8(digits[VEC_DATA] + i));
        i = i - 1;
    }
    buf_byte(out, 0);
    return out[VEC_DATA];
}

fn parse_struct_body(pos) {
    let st = node_new(TX_STRUCT, pos);
    let fields = vec_new();
    p_expect("{");
    while !p_is("}") {
        if p_is(";") {
            p_next();
            continue;
        }
        let attrs = 0;
        if p_edition1 && p_is("@") {
            attrs = parse_attributes();
        }
        let names = vec_new();
        vec_push(names, p_expect_ident()[T_TEXT]);
        while p_is(",") {
            p_next();
            vec_push(names, p_expect_ident()[T_TEXT]);
        }
        let ty = parse_type();
        let attr = 0;
        if p_edition1 {
            attr = struct_json_attr(attrs, pos);
        } else if p_is("@") {
            attr = parse_struct_attr(pos);
        }
        let i = 0;
        while i < names[VEC_LEN] {
            let f = vec_new();
            vec_push(f, vec_get(names, i));
            vec_push(f, ty);
            vec_push(f, attr);
            if p_edition1 {
                vec_push(f, attrs);
            }
            vec_push(fields, f);
            i = i + 1;
        }
        p_end();
    }
    p_next();
    st[TX_A] = fields;
    return st;
}

fn struct_json_attr(attrs, pos) {
    if !attrs {
        return 0;
    }
    let i = 0;
    while i < attrs[VEC_LEN] {
        let attr = vec_get(attrs, i);
        if streq(vec_get(attr, 1), "json") {
            let args = vec_get(attr, 2);
            if args[VEC_LEN] != 1 || vec_get(args, 0)[N_KIND] != EX_STR {
                p_fail_code(pos, "E042 ATTRIBUTE_ARGS", "@json expects one string field name");
            }
            return vec_get(args, 0)[STR_PTR];
        }
        i = i + 1;
    }
    return 0;
}

// parse_type_list reads (T1, T2) or (a T1, b T2) and returns the types.
var ptl_muts;  // parse_type_list: bit i set when parameter i was written `mut T`

fn parse_type_list() {
    let types = vec_new();
    p_expect("(");
    while !p_is(")") {
        if p_is("...") {
            p_next();
        }
        let t2 = p_peek2();
        if p_peek()[T_KIND] == TK_IDENT && !tok_is(t2, ",") && !tok_is(t2, ")") && !tok_is(t2, ".") && !p_is("mut") {
            p_next();
        }
        if p_is("mut") {
            p_next();
            ptl_muts = ptl_muts | (1 << types[VEC_LEN]);
        }
        vec_push(types, parse_type());
        if !p_is(",") {
            break;
        }
        p_next();
    }
    p_expect(")");
    return types;
}

// parse_results reads a func's result types: none, T, or (T1, T2) with optional names.
fn parse_results() {
    if p_is("!") {
        // !T, !(A, B) or ! alone: the results, then a fault.
        let bpos = p_next()[T_POS];
        p_bangres = 1;
        let br = vec_new();
        if p_is("(") {
            br = parse_type_list();
        } else if starts_type() && !p_is("{") {
            vec_push(br, parse_type());
        }
        let ft = node_new(TX_NAME, bpos);
        ft[TX_B] = "fault";
        vec_push(br, ft);
        return br;
    }
    if p_is("(") {
        return parse_type_list();
    }
    let r = vec_new();
    if p_is("mut") {
        p_next();
        p_mutres = 1;
    }
    if starts_type() && !p_is("{") {
        vec_push(r, parse_type());
    }
    return r;
}

// ---- declarations ----

// parse_fn reads fn/func declarations: receiver, grouped typed params, results, body.
fn parse_fn(is_extern, legacy) {
    let at = p_i;
    let pos = p_next()[T_POS];
    let f = fn_new(pos, 0);
    f[F_TOKS] = p_toks;
    f[F_TOKAT] = at;
    f[F_EXTERN] = is_extern;
    f[F_LEGACY] = legacy;
    if !legacy && p_is("(") {
        p_next();
        f[F_RECVNAME] = p_expect_ident()[T_TEXT];
        if p_is("mut") {
            p_next();
            f[F_RECVMUT] = 1;
        }
        f[F_RECV] = parse_type();
        p_expect(")");
    }
    f[F_NAME] = p_expect_ident()[T_TEXT];
    if !legacy && p_is("[") {
        f[F_TPARAMS] = vec_new();
        f[F_TCONS] = vec_new();
        parse_tparams(f[F_TPARAMS], f[F_TCONS]);
    }
    // A method of a generic type is generic over the type's parameters.
    let rx = f[F_RECV];
    if rx && rx[N_KIND] == TX_NAME && rx[TX_ARGS] {
        if !f[F_TPARAMS] {
            f[F_TPARAMS] = vec_new();
            f[F_TCONS] = vec_new();
        }
        let ri = 0;
        while ri < rx[TX_ARGS][VEC_LEN] {
            let a = vec_get(rx[TX_ARGS], ri);
            if a[N_KIND] != TX_NAME || a[TX_A] || a[TX_ARGS] {
                p_fail_code(pos, "E506 RECEIVER_TYPE_PARAMS", "a method's receiver lists its type's parameters by name, like (s Stack[T])");
            }
            vec_push(f[F_TPARAMS], a[TX_B]);
            vec_push(f[F_TCONS], 0);
            ri = ri + 1;
        }
    }
    parse_params(f);
    p_mutres = 0;
    p_bangres = 0;
    if legacy {
        let int_t = node_new(TX_NAME, pos);
        int_t[TX_B] = "int";
        vec_push(f[F_RTYPES], int_t);
    } else {
        f[F_RTYPES] = parse_results();
        f[F_MUTRES] = p_mutres;
        f[F_BANG] = p_bangres;
    }
    if is_extern {
        p_end();
        return f;
    }
    let saved = p_legacy;
    p_legacy = legacy;
    f[F_BODY] = parse_block();
    p_legacy = saved;
    return f;
}

fn parse_params(f) {
    p_expect("(");
    let pending = 0;
    while !p_is(")") {
        if p_is("...") {
            p_next();
            f[F_VARIADIC] = 1;
            if !p_is(")") {
                parse_type();
            }
            break;
        }
        if p_word("dyn") && p_peek2()[T_KIND] == TK_IDENT {
            // `dyn W` where a parameter name belongs: a dyn parameter needs a name.
            p_fail_code(p_peek()[T_POS], "E515 DYN_PARAM_NAME", "a parameter of type dyn S needs a name: write w dyn S");
        }
        vec_push(f[F_PARAMS], p_expect_ident()[T_TEXT]);
        vec_push(f[F_PTYPES], 0);
        vec_push(f[F_MUTS], 0);
        pending = pending + 1;
        if !p_is(",") && !p_is(")") {
            if p_is("...") {
                p_next();
                f[F_VARIADIC] = 1;
            }
            let ismut = 0;
            if p_is("mut") {
                p_next();
                ismut = 1;
            }
            let ty = parse_type();
            let i = f[F_PTYPES][VEC_LEN] - pending;
            while i < f[F_PTYPES][VEC_LEN] {
                f[F_PTYPES][VEC_DATA][i] = ty;
                f[F_MUTS][VEC_DATA][i] = ismut;
                i = i + 1;
            }
            pending = 0;
        }
        if !p_is(",") {
            break;
        }
        p_next();
    }
    p_expect(")");
}

// ---- statements ----

fn parse_block() {
    let b = node_new(ST_BLOCK, p_expect("{")[T_POS]);
    b[BLK_STMTS] = vec_new();
    while !p_is("}") {
        if p_peek()[T_KIND] == TK_EOF {
            p_fail_code(p_peek()[T_POS], "E020 UNEXPECTED", "expected '}', found end of file");
        }
        let s = parse_stmt();
        if s[N_KIND] == ST_LIST {
            let i = 0;
            while i < s[LIST_STMTS][VEC_LEN] {
                vec_push(b[BLK_STMTS], vec_get(s[LIST_STMTS], i));
                i = i + 1;
            }
        } else if s[N_KIND] != ST_BLOCK || s[BLK_STMTS][VEC_LEN] > 0 || s[N_POS] != 0 {
            vec_push(b[BLK_STMTS], s);
        }
    }
    p_next();
    return b;
}

fn empty_block(pos) {
    let b = node_new(ST_BLOCK, pos);
    b[BLK_STMTS] = vec_new();
    return b;
}

fn parse_stmt() {
    let pos = p_peek()[T_POS];
    if p_is(";") {
        p_next();
        return empty_block(0);
    }
    if p_edition1 && p_peek()[T_KIND] == TK_IDENT && tok_is(p_peek2(), ":") {
        let label = p_next()[T_TEXT];
        p_next();
        if !p_is("for") {
            p_fail_found_code(p_peek()[T_POS], "E050 LABEL_PLACEMENT", "a label must precede a loop", p_peek());
        }
        p_pending_label = label;
        return parse_for();
    }
    if p_is("let") {
        p_next();
        return parse_binding(pos, 0);
    }
    if p_edition1 && p_is("mut") {
        p_next();
        return parse_binding(pos, 1);
    }
    if p_edition1 && p_word("use") && p_peek2()[T_KIND] == TK_IDENT && tok_is(p_peek3(), "=") {
        return parse_use_decl();
    }
    if p_edition1 && p_word("scope") && p_peek2()[T_KIND] == TK_IDENT && tok_is(p_peek3(), "{") {
        p_next();
        let scope = node_new(ST_SCOPE, pos);
        scope[SCOPE_NAME] = p_expect_ident()[T_TEXT];
        scope[SCOPE_BODY] = parse_block();
        return scope;
    }
    if p_edition1 && p_word("detach") && tok_is(p_peek2(), "{") {
        p_next();
        let detach = node_new(ST_DETACH, pos);
        detach[BODY_BLOCK] = parse_block();
        return detach;
    }
    if p_edition1 && p_word("once") && tok_is(p_peek2(), "{") {
        p_next();
        let once = node_new(ST_ONCE, pos);
        once[BODY_BLOCK] = parse_block();
        return once;
    }
    if p_edition1 && p_word("select") && tok_is(p_peek2(), "{") {
        return parse_select();
    }
    if p_is("var") {
        if p_edition1 {
            p_fail_code(pos, "E090 OLD_SYNTAX", "edition 1 uses 'let' or 'mut', not 'var'");
        }
        p_next();
        return parse_local_var(pos);
    }
    if p_is("const") {
        if p_edition1 {
            p_fail_code(pos, "E090 OLD_SYNTAX", "edition 1 allows const only at package scope");
        }
        p_next();
        let c = node_new(ST_CONST, pos);
        c[2] = vec_new();
        parse_group(1, c[2]);
        return c;
    }
    if p_is("if") {
        return parse_if();
    }
    if p_is("while") {
        if p_edition1 {
            p_fail_code(pos, "E090 OLD_SYNTAX", "edition 1 uses 'for' loops, not 'while'");
        }
        p_next();
        let w = node_new(ST_WHILE, pos);
        let saved = p_nolit;
        p_nolit = 1;
        w[WH_COND] = parse_expr(1);
        p_nolit = saved;
        w[WH_BODY] = parse_block();
        return w;
    }
    if p_is("for") {
        return parse_for();
    }
    if p_is("switch") {
        if p_edition1 {
            p_fail_code(pos, "E090 OLD_SYNTAX", "edition 1 uses 'match', not 'switch'");
        }
        return parse_switch();
    }
    if p_is("return") {
        p_next();
        let r = node_new(ST_RETURN, pos);
        if !p_is(";") && !p_is("}") {
            let vals = parse_expr_list();
            if vals[VEC_LEN] == 1 {
                r[RET_VALUE] = vec_get(vals, 0);
            } else {
                r[RET_VALUES] = vals;
            }
        }
        p_end();
        return r;
    }
    if p_word("fail") && !p_legacy {
        let t2 = p_peek2();
        if !tok_is(t2, ":=") && !tok_is(t2, "=") && !tok_is(t2, ",") && !tok_is(t2, ".") {
            p_next();
            let fs = node_new(ST_FAIL, pos);
            fs[FAIL_X] = parse_expr(1);
            p_end();
            return fs;
        }
    }
    if p_is("break") {
        p_next();
        let b = node_new(ST_BREAK, pos);
        if p_edition1 && p_peek()[T_KIND] == TK_IDENT {
            b[BR_LABEL] = p_next()[T_TEXT];
        }
        p_end();
        return b;
    }
    if p_is("continue") {
        p_next();
        let c = node_new(ST_CONTINUE, pos);
        if p_edition1 && p_peek()[T_KIND] == TK_IDENT {
            c[CONT_LABEL] = p_next()[T_TEXT];
        }
        p_end();
        return c;
    }
    if p_is("go") || p_is("defer") {
        if p_edition1 && p_is("go") {
            p_fail_code(pos, "E090 OLD_SYNTAX", "edition 1 uses 'scope' or 'detach', not 'go'");
        }
        let kind = ST_GO;
        if p_is("defer") {
            kind = ST_DEFER;
        }
        p_next();
        let g = node_new(kind, pos);
        g[GO_CALL] = parse_expr(1);
        if g[GO_CALL][N_KIND] != EX_CALL {
            p_fail_code(pos, "E055 DEFER_CALL", "expected a function call");
        }
        p_end();
        return g;
    }
    if p_is("{") {
        return parse_block();
    }
    let s = parse_simple_stmt(parse_expr_list());
    p_end();
    return s;
}

fn parse_select() {
    let select = node_new(ST_SELECT, p_next()[T_POS]);
    select[SELECT_ARMS] = vec_new();
    p_expect("{");
    while !p_is("}") {
        if p_is(";") {
            p_next();
            continue;
        }
        let arm = vec_new();
        vec_push(arm, p_peek()[T_POS]);
        let name = 0;
        if p_is("let") {
            p_next();
            name = p_expect_ident()[T_TEXT];
            p_expect("=");
        }
        let saved = p_nolit;
        p_nolit = 1;
        let wait = parse_expr(1);
        p_nolit = saved;
        p_expect("=>");
        let body = 0;
        let is_block = 0;
        if p_is("{") {
            body = parse_block();
            is_block = 1;
        } else if p_is("return") || p_word("fail") || p_is("break") || p_is("continue") {
            body = parse_stmt();
        } else {
            body = parse_expr(1);
        }
        vec_push(arm, name);
        vec_push(arm, wait);
        vec_push(arm, body);
        vec_push(arm, is_block);
        vec_push(select[SELECT_ARMS], arm);
        if p_is(";") {
            p_next();
        }
    }
    if select[SELECT_ARMS][VEC_LEN] == 0 {
        p_fail_code(select[N_POS], "E051 EMPTY_SELECT", "select needs at least one arm");
    }
    p_next();
    return select;
}

// parse_binding reads a Tin 1 let/mut declaration. The target shape is intentionally
// represented with the existing ST_LET/ST_MULTI nodes so later compiler passes share one tree.
fn parse_binding(pos, is_mut) {
    if p_is("(") {
        p_next();
        let names = vec_new();
        vec_push(names, p_expect_ident()[T_TEXT]);
        while p_is(",") {
            p_next();
            vec_push(names, p_expect_ident()[T_TEXT]);
        }
        p_expect(")");
        p_expect("=");
        let m = node_new(ST_MULTI, pos);
        m[MU_TARGETS] = idents_of(pos, names);
        m[MU_VALUES] = parse_expr_list();
        m[MU_DEFINE] = 1;
        m[MU_MUT] = is_mut;
        p_end();
        return m;
    }
    let l = node_new(ST_LET, pos);
    l[LET_NAME] = p_expect_ident()[T_TEXT];
    if !p_is("=") {
        l[LET_TYPE] = parse_type();
    }
    p_expect("=");
    l[LET_INIT] = parse_catch(parse_expr(1));
    l[LET_MUT] = is_mut;
    p_end();
    return l;
}

fn parse_local_var(pos) {
    let names = vec_new();
    vec_push(names, p_expect_ident()[T_TEXT]);
    while p_is(",") {
        p_next();
        vec_push(names, p_expect_ident()[T_TEXT]);
    }
    let ty = 0;
    if !p_is("=") {
        ty = parse_type();
    }
    let inits = 0;
    if p_is("=") {
        p_next();
        inits = parse_expr_list();
    }
    p_end();
    if inits && inits[VEC_LEN] != names[VEC_LEN] {
        let m = node_new(ST_MULTI, pos);
        m[MU_TARGETS] = idents_of(pos, names);
        m[MU_VALUES] = inits;
        m[MU_DEFINE] = 1;
        return m;
    }
    let list = node_new(ST_LIST, pos);
    list[LIST_STMTS] = vec_new();
    let i = 0;
    while i < names[VEC_LEN] {
        let l = node_new(ST_LET, pos);
        l[LET_NAME] = vec_get(names, i);
        l[LET_TYPE] = ty;
        if inits {
            l[LET_INIT] = vec_get(inits, i);
        }
        vec_push(list[LIST_STMTS], l);
        i = i + 1;
    }
    return list;
}

fn idents_of(pos, names) {
    let v = vec_new();
    let i = 0;
    while i < names[VEC_LEN] {
        let id = node_new(EX_IDENT, pos);
        id[ID_NAME] = vec_get(names, i);
        vec_push(v, id);
        i = i + 1;
    }
    return v;
}

fn parse_expr_list() {
    let v = vec_new();
    vec_push(v, parse_catch(parse_expr(1)));
    while p_is(",") {
        p_next();
        vec_push(v, parse_catch(parse_expr(1)));
    }
    return v;
}

// callee_keeps_nothing reports whether a call's callee is a library function that only calls the
// function values it is given and never stores or returns them: sift's and atlas's *Func functions,
// sift.Each, Map, Filter and Reduce, and twine's *Func functions and Map.
fn callee_keeps_nothing(x) {
    if x[N_KIND] != EX_SELECT || x[SEL_X][N_KIND] != EX_IDENT {
        return 0;
    }
    let pkg = x[SEL_X][ID_NAME];
    let name = x[SEL_NAME];
    if !streq(pkg, "sift") && !streq(pkg, "twine") && !streq(pkg, "atlas") {
        return 0;
    }
    let n = strlen(name);
    if n >= 4 && streq(name + n - 4, "Func") {
        return 1;
    }
    if streq(name, "Each") || streq(name, "Map") || streq(name, "Filter") || streq(name, "Reduce") {
        return 1;
    }
    return 0;
}

fn has_brace(p, n) {
    let i = 0;
    while i < n {
        let c = load8(p + i);
        if c == '{' || c == '}' {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn str_node(pos, b) {
    let s = node_new(EX_STR, pos);
    s[STR_LEN] = b[VEC_LEN];
    buf_byte(b, 0);
    s[STR_PTR] = b[VEC_DATA];
    return s;
}

// parse_interp splits "text {x} more {y:spec}" into its text parts and values. {{ and }}
// are literal braces; spec is everything after the last top-level ':' in the braces.
fn parse_interp(t, pos) {
    let p = t[T_TEXT];
    let n = t[T_VAL];
    let parts = vec_new();
    let args = vec_new();
    let specs = vec_new();
    let cur = buf_new();
    let i = 0;
    while i < n {
        let c = load8(p + i);
        if c == '{' && i + 1 < n && load8(p + i + 1) == '{' {
            buf_byte(cur, '{');
            i = i + 2;
        } else if c == '}' && i + 1 < n && load8(p + i + 1) == '}' {
            buf_byte(cur, '}');
            i = i + 2;
        } else if c == '}' {
            p_fail_code(pos, "E030 INTERPOLATION", "a } in a string must be written }} (or use a `raw` string)");
        } else if c == '{' {
            let j = i + 1;
            let depth = 0;
            let colon = -1;
            while j < n && !(load8(p + j) == '}' && depth == 0) {
                let d = load8(p + j);
                if d == '(' || d == '[' {
                    depth = depth + 1;
                } else if d == ')' || d == ']' {
                    depth = depth - 1;
                } else if d == ':' && depth == 0 {
                    colon = j;
                }
                j = j + 1;
            }
            if j >= n {
                p_fail_code(pos, "E030 INTERPOLATION", "a { in a string starts a value: close it with }, or write {{ for a brace");
            }
            let ee = j;
            let spec = 0;
            if colon >= 0 {
                ee = colon;
                let sb = buf_new();
                let k = colon + 1;
                while k < j {
                    buf_byte(sb, load8(p + k));
                    k = k + 1;
                }
                buf_byte(sb, 0);
                spec = sb[VEC_DATA];
            }
            vec_push(parts, str_node(pos, cur));
            cur = buf_new();
            vec_push(args, interp_expr(p + i + 1, ee - i - 1, pos));
            vec_push(specs, spec);
            i = j + 1;
        } else {
            buf_byte(cur, c);
            i = i + 1;
        }
    }
    vec_push(parts, str_node(pos, cur));
    if args[VEC_LEN] == 0 {
        return vec_get(parts, 0);
    }
    let e = node_new(EX_INTERP, pos);
    e[INTERP_PARTS] = parts;
    e[INTERP_ARGS] = args;
    e[INTERP_SPECS] = specs;
    return e;
}

// interp_expr parses the n bytes at p (the inside of {...} in a string) as an expression.
fn interp_expr(p, n, pos) {
    let src = malloc(n + 1);
    memcpy(src, p, n);
    store8(src + n, 0);
    let toks = lex(0, src, n, p_edition1);
    let j = 0;
    while j < toks[VEC_LEN] {
        vec_get(toks, j)[T_POS] = pos;
        j = j + 1;
    }
    let saved_toks = p_toks;
    let saved_i = p_i;
    p_toks = toks;
    p_i = 0;
    if p_is(";") || p_peek()[T_KIND] == TK_EOF {
        p_fail_code(pos, "E030 INTERPOLATION", "empty {} in a string: write {{}} for braces");
    }
    let x = parse_expr(1);
    if p_is(";") {
        p_next();
    }
    if p_peek()[T_KIND] != TK_EOF {
        p_fail_code(pos, "E030 INTERPOLATION", "unexpected text inside {...} in a string: it holds one value (write {{ for a brace, or use a `raw` string)");
    }
    p_toks = saved_toks;
    p_i = saved_i;
    return x;
}

// parse_catch reads an optional `catch name { ... }` after x (strict code only).
fn parse_catch(x) {
    if !p_word("catch") || p_legacy {
        return parse_wrap(x);
    }
    let c = node_new(EX_CATCH, p_next()[T_POS]);
    c[CATCH_X] = x;
    c[CATCH_NAME] = p_expect_ident()[T_TEXT];
    c[CATCH_BODY] = parse_block();
    return parse_wrap(c);
}

fn parse_wrap(x) {
    if !p_edition1 || !p_word("wrap") {
        return x;
    }
    let pos = p_next()[T_POS];
    if p_peek()[T_KIND] != TK_STRING {
        p_fail_found_code(p_peek()[T_POS], "E020 UNEXPECTED", "wrap expects a string message", p_peek());
    }
    let msg = parse_primary();
    if msg[N_KIND] != EX_STR && msg[N_KIND] != EX_INTERP {
        p_fail_code(pos, "E020 UNEXPECTED", "wrap expects a string message");
    }
    let w = node_new(EX_WRAP, pos);
    w[WRAP_X] = x;
    w[WRAP_MESSAGE] = msg;
    return w;
}

fn is_assign_op(t) {
    if t[T_KIND] != TK_PUNCT {
        return 0;
    }
    let s = t[T_TEXT];
    let n = strlen(s);
    return n >= 2 && load8(s + n - 1) == '=' && !streq(s, "==") && !streq(s, "!=") && !streq(s, "<=") && !streq(s, ">=") && !streq(s, ":=");
}

// parse_simple_stmt finishes a statement that starts with the expression list xs.
fn parse_simple_stmt(xs) {
    let x = vec_get(xs, 0);
    let pos = x[N_POS];
    if p_is(":=") || (p_is("=") && xs[VEC_LEN] > 1) {
        if p_edition1 && p_is(":=") {
            p_fail_code(pos, "E090 OLD_SYNTAX", "edition 1 uses 'let' or 'mut', not ':='");
        }
        let define = p_is(":=");
        p_next();
        let vals = parse_expr_list();
        if define && xs[VEC_LEN] == 1 && vals[VEC_LEN] == 1 {
            if x[N_KIND] != EX_IDENT {
                p_fail_code(pos, "E020 UNEXPECTED", "expected a name before :=");
            }
            let l = node_new(ST_LET, pos);
            l[LET_NAME] = x[ID_NAME];
            l[LET_INIT] = vec_get(vals, 0);
            return l;
        }
        let m = node_new(ST_MULTI, pos);
        m[MU_TARGETS] = xs;
        m[MU_VALUES] = vals;
        m[MU_DEFINE] = define;
        return m;
    }
    if xs[VEC_LEN] > 1 {
        p_fail_found_code(p_peek()[T_POS], "E020 UNEXPECTED", "expected := or =", p_peek());
    }
    if p_is("=") {
        p_next();
        let a = node_new(ST_ASSIGN, pos);
        a[AS_TARGET] = x;
        a[AS_VALUE] = parse_catch(parse_expr(1));
        return a;
    }
    if is_assign_op(p_peek()) {
        // x op= e  is  x = x op e  (the target is evaluated twice).
        let t = p_next()[T_TEXT];
        let a = node_new(ST_ASSIGN, pos);
        a[AS_TARGET] = x;
        a[AS_VALUE] = binary_new(pos, str_slice(t, strlen(t) - 1), x, parse_expr(1));
        return a;
    }
    if p_is("++") || p_is("--") {
        if p_edition1 {
            p_fail_code(pos, "E090 OLD_SYNTAX", "edition 1 uses '+= 1' or '-= 1', not '++' or '--'");
        }
        let op = "+";
        if p_is("--") {
            op = "-";
        }
        p_next();
        let one = node_new(EX_INT, pos);
        one[INT_VAL] = 1;
        let inc = node_new(ST_ASSIGN, pos);
        inc[AS_TARGET] = x;
        inc[AS_VALUE] = binary_new(pos, op, x, one);
        return inc;
    }
    let s = node_new(ST_EXPR, pos);
    s[ES_X] = x;
    return s;
}

fn binary_new(pos, op, l, r) {
    let b = node_new(EX_BINARY, pos);
    b[BIN_OP] = op;
    b[BIN_L] = l;
    b[BIN_R] = r;
    return b;
}

fn parse_if() {
    let s = node_new(ST_IF, p_expect("if")[T_POS]);
    let saved = p_nolit;
    p_nolit = 1;
    if p_edition1 && p_is("let") {
        p_next();
        let binding = node_new(ST_LET, s[N_POS]);
        binding[LET_NAME] = p_expect_ident()[T_TEXT];
        p_expect("=");
        binding[LET_INIT] = parse_expr(1);
        binding[LET_MUT] = 0;
        s[IF_INIT] = binding;
        let id = node_new(EX_IDENT, s[N_POS]);
        id[ID_NAME] = binding[LET_NAME];
        s[IF_COND] = binary_new(s[N_POS], "!=", id, node_new(EX_NIL, s[N_POS]));
    } else {
        let first = parse_simple_stmt(parse_expr_list());
        if p_is(";") {
            p_next();
            s[IF_INIT] = first;
            s[IF_COND] = parse_expr(1);
        } else {
            if first[N_KIND] != ST_EXPR {
                p_fail_code(first[N_POS], "E020 UNEXPECTED", "expected a condition");
            }
            s[IF_COND] = first[ES_X];
        }
    }
    p_nolit = saved;
    s[IF_THEN] = parse_block();
    if p_is("else") {
        p_next();
        if p_is("if") {
            s[IF_ELSE] = parse_if();
        } else {
            s[IF_ELSE] = parse_block();
        }
    }
    return s;
}

fn true_node(pos) {
    let t = node_new(EX_IDENT, pos);
    t[ID_NAME] = "true";
    return t;
}

fn parse_for() {
    if p_edition1 {
        return parse_for_edition1();
    }
    let pos = p_expect("for")[T_POS];
    let w = node_new(ST_WHILE, pos);
    if p_is("{") {
        w[WH_COND] = true_node(pos);
        w[WH_BODY] = parse_block();
        return w;
    }
    let saved = p_nolit;
    p_nolit = 1;
    if p_is("range") {
        p_next();
        let r = node_new(ST_RANGE, pos);
        r[RG_EXPR] = parse_expr(1);
        p_nolit = saved;
        r[RG_BODY] = parse_block();
        return r;
    }
    let init = 0;
    if !p_is(";") {
        let xs = parse_expr_list();
        if (p_is(":=") || p_is("=")) && tok_is(p_peek2(), "range") {
            let r = node_new(ST_RANGE, pos);
            r[RG_DEFINE] = p_is(":=");
            p_next();
            p_next();
            r[RG_KEY] = vec_get(xs, 0);
            if xs[VEC_LEN] > 1 {
                r[RG_VAL] = vec_get(xs, 1);
            }
            r[RG_EXPR] = parse_expr(1);
            p_nolit = saved;
            r[RG_BODY] = parse_block();
            return r;
        }
        if p_is("{") && xs[VEC_LEN] == 1 {
            w[WH_COND] = vec_get(xs, 0);
            p_nolit = saved;
            w[WH_BODY] = parse_block();
            return w;
        }
        init = parse_simple_stmt(xs);
    }
    p_expect(";");
    w[WH_INIT] = init;
    if p_is(";") {
        w[WH_COND] = true_node(pos);
    } else {
        w[WH_COND] = parse_expr(1);
    }
    p_expect(";");
    if !p_is("{") {
        w[WH_POST] = parse_simple_stmt(parse_expr_list());
    }
    p_nolit = saved;
    w[WH_BODY] = parse_block();
    return w;
}

// parse_for_edition1 lowers each of Tin 1's four loop forms into the existing range/while
// nodes. Integer ranges use the same init/condition/post shape as a C-style loop, which keeps
// the bounds proof and code generation on their existing path.
fn parse_for_edition1() {
    let pos = p_expect("for")[T_POS];
    let label = p_pending_label;
    p_pending_label = 0;
    if p_is("{") {
        let forever = node_new(ST_WHILE, pos);
        forever[WH_COND] = true_node(pos);
        forever[WH_BODY] = parse_block();
        forever[WH_LABEL] = label;
        return forever;
    }
    let saved = p_nolit;
    p_nolit = 1;
    if p_peek()[T_KIND] == TK_IDENT && (p_word_at(1, "in") || tok_is(p_peek2(), ",")) {
        let names = vec_new();
        vec_push(names, p_expect_ident()[T_TEXT]);
        while p_is(",") {
            p_next();
            vec_push(names, p_expect_ident()[T_TEXT]);
        }
        if !p_word("in") {
            p_fail_found_code(p_peek()[T_POS], "E020 UNEXPECTED", "expected 'in' after loop binding", p_peek());
        }
        p_next();
        p_range_expr = 1;
        let src = parse_expr(1);
        p_range_expr = 0;
        let body = parse_block();
        p_nolit = saved;
        if src[N_KIND] == EX_BINARY && streq(src[BIN_OP], "..") {
            if names[VEC_LEN] != 1 {
                p_fail_code(pos, "E052 RANGE_LOOP", "an integer range loop has one binding");
            }
            let loop = make_index_loop(pos, vec_get(names, 0), src, 0, body);
            loop[WH_LABEL] = label;
            return loop;
        }
        if src[N_KIND] == EX_CALL && src[CALL_CALLEE] && src[CALL_CALLEE][N_KIND] == EX_SELECT && streq(src[CALL_CALLEE][SEL_NAME], "step") {
            let range_expr = src[CALL_CALLEE][SEL_X];
            if range_expr[N_KIND] == EX_BINARY && streq(range_expr[BIN_OP], "..") {
                if names[VEC_LEN] != 1 || src[CALL_ARGS][VEC_LEN] != 1 {
                    p_fail_code(pos, "E052 RANGE_LOOP", "a stepped integer range needs one binding and one step");
                }
                let loop = make_index_loop(pos, vec_get(names, 0), range_expr, vec_get(src[CALL_ARGS], 0), body);
                loop[WH_LABEL] = label;
                return loop;
            }
        }
        let r = node_new(ST_RANGE, pos);
        if names[VEC_LEN] > 1 {
            r[RG_KEY] = node_new(EX_IDENT, pos);
            r[RG_KEY][ID_NAME] = vec_get(names, 0);
            r[RG_VAL] = node_new(EX_IDENT, pos);
            r[RG_VAL][ID_NAME] = vec_get(names, 1);
        } else {
            r[RG_VAL] = node_new(EX_IDENT, pos);
            r[RG_VAL][ID_NAME] = vec_get(names, 0);
        }
        r[RG_DEFINE] = 1;
        r[RG_EXPR] = src;
        r[RG_BODY] = body;
        r[RG_LABEL] = label;
        return r;
    }
    let w = node_new(ST_WHILE, pos);
    p_range_expr = 0;
    w[WH_COND] = parse_expr(1);
    w[WH_BODY] = parse_block();
    p_nolit = saved;
    w[WH_LABEL] = label;
    return w;
}

fn parse_boundary() {
    let pos = p_peek()[T_POS];
    let word = p_next()[T_TEXT];
    let boundary = node_new(EX_BOUNDARY, pos);
    boundary[BOUND_ARGS] = vec_new();
    if streq(word, "within") {
        boundary[BOUND_KIND] = BOUND_WITHIN;
        let saved = p_nolit;
        p_nolit = 1;
        vec_push(boundary[BOUND_ARGS], parse_expr(1));
        p_nolit = saved;
    } else if streq(word, "limit") {
        boundary[BOUND_KIND] = BOUND_LIMIT;
        while !p_is("{") {
            let item = vec_new();
            vec_push(item, p_expect_ident()[T_TEXT]);
            vec_push(item, parse_expr(1));
            vec_push(boundary[BOUND_ARGS], item);
            if !p_is(",") {
                break;
            }
            p_next();
        }
        if boundary[BOUND_ARGS][VEC_LEN] == 0 {
            p_fail_code(pos, "E020 UNEXPECTED", "limit needs at least one bound");
        }
    } else if streq(word, "guard") {
        boundary[BOUND_KIND] = BOUND_GUARD;
    } else if streq(word, "arena") {
        boundary[BOUND_KIND] = BOUND_ARENA;
    } else if streq(word, "parallel") {
        boundary[BOUND_KIND] = BOUND_PARALLEL;
    } else {
        boundary[BOUND_KIND] = BOUND_WITH;
        let saved2 = p_nolit;
        p_nolit = 1;
        vec_push(boundary[BOUND_ARGS], parse_expr(1));
        p_nolit = saved2;
    }
    if !p_is("{") {
        p_fail_found_code(p_peek()[T_POS], "E020 UNEXPECTED", "expected a boundary block", p_peek());
    }
    boundary[BOUND_BODY] = parse_block();
    return boundary;
}

fn starts_boundary() {
    if !p_edition1 {
        return 0;
    }
    if p_word("guard") || p_word("arena") || p_word("parallel") {
        return tok_is(p_peek2(), "{");
    }
    if p_word("limit") {
        return p_peek2()[T_KIND] == TK_IDENT;
    }
    if p_word("within") {
        return p_peek2()[T_KIND] != TK_EOF && !tok_is(p_peek2(), "(") && !tok_is(p_peek2(), ";") && !tok_is(p_peek2(), "}");
    }
    if p_word("with") {
        if p_peek2()[T_KIND] == TK_IDENT {
            return 1;
        }
        if tok_is(p_peek2(), "(") {
            return with_parens_followed_by_block();
        }
    }
    return 0;
}

fn with_parens_followed_by_block() {
    let depth = 0;
    let i = p_i + 1;
    while i < p_toks[VEC_LEN] {
        let t = vec_get(p_toks, i);
        if tok_is(t, "(") {
            depth = depth + 1;
        } else if tok_is(t, ")") {
            depth = depth - 1;
            if depth == 0 {
                return i + 1 < p_toks[VEC_LEN] && tok_is(vec_get(p_toks, i + 1), "{");
            }
        }
        i = i + 1;
    }
    return 0;
}

fn p_word_at(off, text) {
    let t = p_peek();
    if off == 1 {
        t = p_peek2();
    } else if off == 2 {
        t = p_peek3();
    }
    return t[T_KIND] == TK_IDENT && streq(t[T_TEXT], text);
}

fn p_peek3() {
    if p_i + 2 < p_toks[VEC_LEN] {
        return vec_get(p_toks, p_i + 2);
    }
    return p_peek2();
}

fn make_index_loop(pos, name, range_expr, step, body) {
    let start = range_expr[BIN_L];
    let end = range_expr[BIN_R];
    let loop = node_new(ST_WHILE, pos);
    let init = node_new(ST_LET, pos);
    init[LET_NAME] = name;
    init[LET_INIT] = start;
    init[LET_MUT] = 1;
    loop[WH_INIT] = init;
    let id = node_new(EX_IDENT, pos);
    id[ID_NAME] = name;
    loop[WH_COND] = binary_new(pos, "<", id, end);
    let next = node_new(EX_IDENT, pos);
    next[ID_NAME] = name;
    let by = step;
    if !by {
        by = node_new(EX_INT, pos);
        by[INT_VAL] = 1;
    }
    let post = node_new(ST_ASSIGN, pos);
    let target = node_new(EX_IDENT, pos);
    target[ID_NAME] = name;
    post[AS_TARGET] = target;
    post[AS_VALUE] = binary_new(pos, "+", next, by);
    loop[WH_POST] = post;
    loop[WH_BODY] = body;
    return loop;
}

fn parse_switch() {
    let s = node_new(ST_SWITCH, p_expect("switch")[T_POS]);
    let saved = p_nolit;
    p_nolit = 1;
    if !p_is("{") {
        let first = parse_simple_stmt(parse_expr_list());
        if p_is(";") {
            p_next();
            s[SW_INIT] = first;
            if !p_is("{") {
                s[SW_TAG] = parse_expr(1);
            }
        } else {
            if first[N_KIND] != ST_EXPR {
                p_fail_code(first[N_POS], "E020 UNEXPECTED", "expected a switch tag");
            }
            s[SW_TAG] = first[ES_X];
        }
    }
    p_nolit = saved;
    p_expect("{");
    let cases = vec_new();
    while !p_is("}") {
        if p_is(";") {
            p_next();
            continue;
        }
        let c = vec_new();
        let cpos = p_peek()[T_POS];
        if p_is("case") {
            p_next();
            vec_push(c, parse_expr_list());
        } else {
            p_expect("default");
            vec_push(c, 0);
        }
        p_expect(":");
        let body = empty_block(cpos);
        while !p_is("case") && !p_is("default") && !p_is("}") {
            let st = parse_stmt();
            if st[N_KIND] == ST_LIST {
                let i = 0;
                while i < st[LIST_STMTS][VEC_LEN] {
                    vec_push(body[BLK_STMTS], vec_get(st[LIST_STMTS], i));
                    i = i + 1;
                }
            } else {
                vec_push(body[BLK_STMTS], st);
            }
        }
        vec_push(c, body);
        vec_push(cases, c);
    }
    p_next();
    s[SW_CASES] = cases;
    return s;
}

// ---- expressions ----

// bin_prec gives a binary operator's binding power (Go's levels), or 0.
fn bin_prec(t) {
    if t[T_KIND] != TK_PUNCT {
        return 0;
    }
    let s = t[T_TEXT];
    if streq(s, "||") {
        return 1;
    }
    if streq(s, "&&") {
        return 2;
    }
    if p_edition1 && p_range_expr && streq(s, "..") {
        return 3;
    }
    if streq(s, "==") || streq(s, "!=") || streq(s, "<") || streq(s, "<=") || streq(s, ">") || streq(s, ">=") {
        return 3;
    }
    if streq(s, "+") || streq(s, "-") || streq(s, "|") || streq(s, "^") {
        return 4;
    }
    if streq(s, "*") || streq(s, "/") || streq(s, "%") || streq(s, "<<") || streq(s, ">>") || streq(s, "&") {
        return 5;
    }
    return 0;
}

// parse_expr is a precedence-climbing parser for left-associative binary operators.
fn parse_expr(min_prec) {
    let left = parse_unary();
    while 1 {
        let t = p_peek();
        let prec = bin_prec(t);
        if prec == 0 || prec < min_prec {
            return parse_wrap(left);
        }
        p_next();
        let right = parse_expr(prec + 1);
        left = binary_new(t[T_POS], t[T_TEXT], left, right);
    }
}

fn parse_unary() {
    let t = p_peek();
    let s = t[T_TEXT];
    if p_is("try") {
        p_next();
        let tr = node_new(EX_TRY, t[T_POS]);
        tr[TRY_X] = parse_unary();
        return tr;
    }
    if t[T_KIND] == TK_PUNCT && (streq(s, "-") || streq(s, "!") || streq(s, "~") || streq(s, "&") || streq(s, "^") || streq(s, "*") || streq(s, "+")) {
        p_next();
        let x = parse_unary();
        if streq(s, "+") || streq(s, "*") {
            // +x is x; *p is p, since struct values are references.
            return x;
        }
        let u = node_new(EX_UNARY, t[T_POS]);
        u[UN_OP] = s;
        if streq(s, "^") {
            u[UN_OP] = "~";
        }
        u[UN_X] = x;
        return u;
    }
    return parse_postfix();
}

// type_operand reports whether a call to name takes a type as its first argument.
fn type_operand(name) {
    return streq(name, "make") || streq(name, "new") || streq(name, "cast");
}

fn parse_postfix() {
    let x = parse_primary();
    while 1 {
        if p_is("(") {
            let pos = p_next()[T_POS];
            let call = node_new(EX_CALL, x[N_POS]);
            call[CALL_ARGS] = vec_new();
            if x[N_KIND] == EX_IDENT {
                call[CALL_NAME] = x[ID_NAME];
            } else {
                call[CALL_CALLEE] = x;
            }
            let saved = p_nolit;
            p_nolit = 0;
            if !p_is(")") && x[N_KIND] == EX_IDENT && type_operand(x[ID_NAME]) {
                let tx = node_new(EX_TYPE, p_peek()[T_POS]);
                tx[TYX] = parse_type();
                vec_push(call[CALL_ARGS], tx);
                if p_is(",") {
                    p_next();
                }
            }
            while !p_is(")") {
                if p_is(";") {
                    p_next();
                    continue;
                }
                let mpos = p_peek()[T_POS];
                let marked = 0;
                if p_is("mut") && !p_legacy {
                    p_next();
                    marked = 1;
                }
                let a = parse_expr(1);
                if marked {
                    let ma = node_new(EX_MUTARG, mpos);
                    ma[MUTARG_X] = a;
                    a = ma;
                }
                if p_is("...") {
                    let spread = node_new(EX_UNARY, p_next()[T_POS]);
                    spread[UN_OP] = "...";
                    spread[UN_X] = a;
                    a = spread;
                }
                // A function literal passed to a function keeps its closure on the caller's frame only when
                // the callee is known not to keep it; any other call may store it, so it must outlive the frame.
                if a[N_KIND] == EX_FUNCLIT && callee_keeps_nothing(x) {
                    a[LIT_ESCAPE] = 0;
                } else if a[N_KIND] == EX_MUTARG && a[MUTARG_X][N_KIND] == EX_FUNCLIT && callee_keeps_nothing(x) {
                    a[MUTARG_X][LIT_ESCAPE] = 0;
                }
                vec_push(call[CALL_ARGS], a);
                if !p_is(",") {
                    break;
                }
                p_next();
            }
            p_nolit = saved;
            p_expect(")");
            x = call;
        } else if p_is("[") {
            let type_args = p_edition1 && bracket_followed_by_call();
            let pos = p_next()[T_POS];
            let saved = p_nolit;
            p_nolit = 0;
            let lo = 0;
            let targs = 0;
            if type_args {
                targs = vec_new();
                while !p_is("]") {
                    let tn = node_new(EX_TYPE, p_peek()[T_POS]);
                    tn[TYX] = parse_type();
                    vec_push(targs, tn);
                    if !p_is(",") {
                        break;
                    }
                    p_next();
                }
                p_expect("]");
                let ix = node_new(EX_INDEX, pos);
                ix[IX_X] = x;
                ix[IX_ARGS] = targs;
                p_nolit = saved;
                x = ix;
            } else {
                if p_is("[") || p_is("map") || p_is("?") || p_is("func") || p_word("dyn") {
                    lo = node_new(EX_TYPE, p_peek()[T_POS]);
                    lo[TYX] = parse_type();
                    targs = vec_new();
                    vec_push(targs, lo);
                } else if !p_is(":") {
                    lo = parse_expr(1);
                }
                if p_is(",") {
                    if !targs {
                        targs = vec_new();
                        vec_push(targs, lo);
                    }
                    while p_is(",") {
                        p_next();
                        if p_is("[") || p_is("map") || p_is("?") || p_is("func") || p_word("dyn") || (p_edition1 && p_is("fn")) {
                            let tn = node_new(EX_TYPE, p_peek()[T_POS]);
                            tn[TYX] = parse_type();
                            vec_push(targs, tn);
                        } else {
                            vec_push(targs, parse_expr(1));
                        }
                    }
                }
                if p_is(":") {
                    p_next();
                    let sl = node_new(EX_SLICE, pos);
                    sl[SL_X] = x;
                    sl[SL_LO] = lo;
                    if !p_is("]") {
                        sl[SL_HI] = parse_expr(1);
                    }
                    p_nolit = saved;
                    p_expect("]");
                    x = sl;
                } else {
                    p_nolit = saved;
                    p_expect("]");
                    let ix = node_new(EX_INDEX, pos);
                    ix[IX_X] = x;
                    ix[IX_I] = lo;
                    ix[IX_ARGS] = targs;
                    x = ix;
                }
            }
        } else if p_is(".") {
            let pos = p_next()[T_POS];
            let sel = node_new(EX_SELECT, pos);
            sel[SEL_X] = x;
            sel[SEL_NAME] = p_expect_ident()[T_TEXT];
            x = sel;
        } else if p_edition1 && p_is("??") {
            let pos = p_next()[T_POS];
            let coalesce = node_new(EX_COALESCE, pos);
            coalesce[COAL_X] = x;
            coalesce[COAL_FALLBACK] = parse_unary();
            x = coalesce;
        } else if p_is("{") && (x[N_KIND] == EX_TYPE || (!p_nolit && !p_legacy && (x[N_KIND] == EX_IDENT || (x[N_KIND] == EX_SELECT && x[SEL_X][N_KIND] == EX_IDENT) || (x[N_KIND] == EX_INDEX && (x[IX_X][N_KIND] == EX_IDENT || x[IX_X][N_KIND] == EX_SELECT))))) {
            x = parse_composite(x);
        } else {
            return x;
        }
    }
}

fn bracket_followed_by_call() {
    let depth = 0;
    let i = p_i;
    while i < p_toks[VEC_LEN] {
        let t = vec_get(p_toks, i);
        if tok_is(t, "[") {
            depth = depth + 1;
        } else if tok_is(t, "]") {
            depth = depth - 1;
            if depth == 0 {
                return i + 1 < p_toks[VEC_LEN] && tok_is(vec_get(p_toks, i + 1), "(");
            }
        }
        i = i + 1;
    }
    return 0;
}

// parse_composite reads T{...} with positional or key: value elements.
fn parse_composite(tyexpr) {
    let c = node_new(EX_COMPOSITE, tyexpr[N_POS]);
    c[CL_TYPE] = tyexpr;
    c[CL_ELEMS] = vec_new();
    c[CL_KEYS] = vec_new();
    p_expect("{");
    let saved = p_nolit;
    p_nolit = 0;
    while !p_is("}") {
        if p_is(";") {
            p_next();
            continue;
        }
        let v = parse_elem();
        let k = 0;
        if p_is(":") {
            p_next();
            k = v;
            v = parse_elem();
        } else if p_edition1 && composite_requires_keys(tyexpr) {
            p_fail_code(v[N_POS], "E090 OLD_SYNTAX", "edition 1 struct literals require field names");
        }
        vec_push(c[CL_KEYS], k);
        vec_push(c[CL_ELEMS], v);
        if !p_is(",") {
            break;
        }
        p_next();
    }
    p_nolit = saved;
    while p_is(";") {
        p_next();
    }
    p_expect("}");
    return c;
}

fn composite_requires_keys(tyexpr) {
    if tyexpr[N_KIND] != EX_TYPE {
        return 1;
    }
    let t = tyexpr[TYX];
    return t[N_KIND] == TX_STRUCT;
}

// parse_elem reads a composite element; a bare {...} takes its type from the context.
fn parse_elem() {
    if p_is("{") {
        let untyped = node_new(EX_TYPE, p_peek()[T_POS]);
        return parse_composite(untyped);
    }
    return parse_expr(1);
}

// parse_match stores ordered, source-positioned arms and patterns. Later semantic passes
// lower these nodes after checking guards and enum coverage.
fn parse_match() {
    let pos = p_next()[T_POS];
    let m = node_new(EX_MATCH, pos);
    let saved = p_nolit;
    p_nolit = 1;
    m[MATCH_SUBJECT] = parse_expr(1);
    p_nolit = saved;
    p_expect("{");
    m[MATCH_ARMS] = vec_new();
    while !p_is("}") {
        if p_is(";") || p_is(",") {
            p_next();
            continue;
        }
        let arm = vec_new();
        vec_push(arm, p_peek()[T_POS]);
        let patterns = vec_new();
        p_range_expr = 1;
        vec_push(patterns, parse_pattern());
        while p_is(",") {
            p_next();
            vec_push(patterns, parse_pattern());
        }
        p_range_expr = 0;
        vec_push(arm, patterns);
        let guard = 0;
        if p_is("if") {
            p_next();
            guard = parse_expr(1);
        }
        vec_push(arm, guard);
        p_expect("=>");
        let body = 0;
        let is_block = 0;
        if p_is("{") {
            body = parse_block();
            is_block = 1;
        } else if p_is("return") || p_is("break") || p_is("continue") || (p_word("fail") && !tok_is(p_peek2(), ":=") && !tok_is(p_peek2(), "=") && !tok_is(p_peek2(), ",") && !tok_is(p_peek2(), ".")) {
            // A statement arm (ErrNotFound => return 404) is a block of that statement.
            body = empty_block(p_peek()[T_POS]);
            vec_push(body[BLK_STMTS], parse_stmt());
            is_block = 1;
        } else {
            body = parse_expr(1);
            if p_is("=") || is_assign_op(p_peek()) {
                // An assignment arm (Rect(w, h) => area = w * h) is a block of that assignment.
                let target = vec_new();
                vec_push(target, body);
                let assign = parse_simple_stmt(target);
                body = empty_block(assign[N_POS]);
                vec_push(body[BLK_STMTS], assign);
                is_block = 1;
            }
        }
        vec_push(arm, body);
        vec_push(arm, is_block);
        vec_push(m[MATCH_ARMS], arm);
        if p_is(";") {
            p_next();
        }
    }
    if m[MATCH_ARMS][VEC_LEN] == 0 {
        p_fail_code(pos, "E053 EMPTY_MATCH", "match needs at least one arm");
    }
    p_next();
    return m;
}

fn parse_pattern() {
    let pos = p_peek()[T_POS];
    let x = parse_expr(1);
    return pattern_from_expr(x, pos);
}

fn pattern_from_expr(x, pos) {
    let pat = vec_new();
    if x[N_KIND] == EX_BINARY && streq(x[BIN_OP], "..") {
        if !pattern_is_literal(x[BIN_L]) || !pattern_is_literal(x[BIN_R]) {
            p_fail_code(pos, "E054 PATTERN", "range patterns need literal endpoints");
        }
        vec_push(pat, PAT_RANGE);
        vec_push(pat, pos);
        vec_push(pat, x[BIN_L]);
        vec_push(pat, x[BIN_R]);
        vec_push(pat, 0);
        vec_push(pat, 0);
        return pat;
    }
    if x[N_KIND] == EX_BINARY {
        p_fail_code(pos, "E054 PATTERN", "expected a literal, range, enum variant, or binding pattern");
    }
    if x[N_KIND] == EX_CALL {
        let name = x[CALL_NAME];
        if x[CALL_CALLEE] {
            name = x[CALL_CALLEE];
        } else {
            name = node_new(EX_IDENT, pos);
            name[ID_NAME] = x[CALL_NAME];
        }
        if !name || (name[N_KIND] != EX_IDENT && name[N_KIND] != EX_SELECT) {
            p_fail_code(pos, "E054 PATTERN", "enum variant patterns need a variant name");
        }
        let children = vec_new();
        let i = 0;
        while i < x[CALL_ARGS][VEC_LEN] {
            let child = vec_get(x[CALL_ARGS], i);
            vec_push(children, pattern_from_expr(child, child[N_POS]));
            i = i + 1;
        }
        vec_push(pat, PAT_VARIANT);
        vec_push(pat, pos);
        vec_push(pat, 0);
        vec_push(pat, 0);
        vec_push(pat, name);
        vec_push(pat, children);
        return pat;
    }
    if x[N_KIND] == EX_IDENT && streq(x[ID_NAME], "_") {
        vec_push(pat, PAT_WILD);
        vec_push(pat, pos);
        vec_push(pat, 0);
        vec_push(pat, 0);
        vec_push(pat, 0);
        vec_push(pat, 0);
        return pat;
    }
    if x[N_KIND] == EX_IDENT && !pattern_is_literal(x) {
        vec_push(pat, PAT_NAME_KIND);
        vec_push(pat, pos);
        vec_push(pat, 0);
        vec_push(pat, 0);
        vec_push(pat, x);
        vec_push(pat, 0);
        return pat;
    }
    if x[N_KIND] == EX_SELECT {
        vec_push(pat, PAT_NAME_KIND);
        vec_push(pat, pos);
        vec_push(pat, 0);
        vec_push(pat, 0);
        vec_push(pat, x);
        vec_push(pat, 0);
        return pat;
    }
    if !pattern_is_literal(x) {
        p_fail_code(pos, "E054 PATTERN", "expected a literal, range, enum variant, or binding pattern");
    }
    vec_push(pat, PAT_LITERAL);
    vec_push(pat, pos);
    vec_push(pat, x);
    vec_push(pat, 0);
    vec_push(pat, 0);
    vec_push(pat, 0);
    return pat;
}

fn pattern_is_literal(x) {
    if x[N_KIND] == EX_INT || x[N_KIND] == EX_FLOAT || x[N_KIND] == EX_STR || x[N_KIND] == EX_NIL || x[N_KIND] == EX_UNIT {
        return 1;
    }
    if x[N_KIND] == EX_IDENT && (streq(x[ID_NAME], "true") || streq(x[ID_NAME], "false")) {
        return 1;
    }
    if x[N_KIND] == EX_UNARY && streq(x[UN_OP], "-") {
        let operand = x[UN_X];
        return operand[N_KIND] == EX_INT || operand[N_KIND] == EX_FLOAT || operand[N_KIND] == EX_UNIT;
    }
    return 0;
}

fn parse_primary() {
    let t = p_peek();
    let k = t[T_KIND];
    let pos = t[T_POS];
    if starts_boundary() {
        return parse_boundary();
    }
    if p_edition1 && p_word("keep") {
        p_next();
        if !p_is("(") {
            p_fail_found_code(p_peek()[T_POS], "E020 UNEXPECTED", "keep needs a value in parentheses", p_peek());
        }
        let keep = node_new(EX_IDENT, pos);
        keep[ID_NAME] = "keep";
        return keep;
    }
    if p_edition1 && p_word("match") {
        return parse_match();
    }
    if k == TK_INT {
        p_next();
        if t[T_UNIT] {
            let unit = node_new(EX_UNIT, pos);
            unit[UNIT_VALUE] = t[T_VAL];
            unit[UNIT_NAME] = t[T_UNIT];
            unit[UNIT_TEXT] = t[T_TEXT];
            unit[UNIT_FLOAT] = 0;
            return unit;
        }
        let i = node_new(EX_INT, pos);
        i[INT_VAL] = t[T_VAL];
        // A literal above 2^63-1 (its bits look negative) only fits 64-bit types.
        if t[T_VAL] < 0 {
            i[8] = 1;
        }
        if load8(t[T_TEXT]) == '\'' {
            i[7] = 1;
        }
        return i;
    }
    if k == TK_FLOAT {
        p_next();
        if t[T_UNIT] {
            let unit = node_new(EX_UNIT, pos);
            unit[UNIT_VALUE] = t[T_VAL];
            unit[UNIT_NAME] = t[T_UNIT];
            unit[UNIT_TEXT] = t[T_TEXT];
            unit[UNIT_FLOAT] = 1;
            return unit;
        }
        let f = node_new(EX_FLOAT, pos);
        f[FL_BITS] = t[T_VAL];
        f[FL_TEXT] = t[T_TEXT];
        return f;
    }
    if k == TK_STRING {
        p_next();
        if !t[T_RAW] && !p_legacy && has_brace(t[T_TEXT], t[T_VAL]) {
            return parse_interp(t, pos);
        }
        if t[T_DBL] {
            // A legacy string is not interpolated: take the doubled brace back to one.
            let un = buf_new();
            let q = t[T_TEXT];
            let m = t[T_VAL];
            let u = 0;
            while u < m {
                buf_byte(un, load8(q + u));
                if (load8(q + u) == '{' || load8(q + u) == '}') && u + 1 < m && load8(q + u + 1) == load8(q + u) {
                    u = u + 1;
                }
                u = u + 1;
            }
            return str_node(pos, un);
        }
        let s = node_new(EX_STR, pos);
        s[STR_PTR] = t[T_TEXT];
        s[STR_LEN] = t[T_VAL];
        return s;
    }
    if k == TK_IDENT {
        p_next();
        let id = node_new(EX_IDENT, pos);
        id[ID_NAME] = t[T_TEXT];
        return id;
    }
    if p_is("true") || p_is("false") {
        p_next();
        let b = node_new(EX_IDENT, pos);
        b[ID_NAME] = t[T_TEXT];
        return b;
    }
    if p_is("nil") {
        p_next();
        return node_new(EX_NIL, pos);
    }
    if p_is("(") {
        p_next();
        let saved = p_nolit;
        p_nolit = 0;
        let x = parse_expr(1);
        p_nolit = saved;
        if p_word("catch") && !p_legacy {
            p_fail_code(p_peek()[T_POS], "E401 CATCH_PLACEMENT", "catch goes on a whole statement, initializer, assignment or return value, not inside an expression");
        }
        p_expect(")");
        return x;
    }
    if p_is("func") || (p_edition1 && p_is("fn")) {
        if p_edition1 && p_is("func") {
            p_fail_code(pos, "E090 OLD_SYNTAX", "edition 1 uses 'fn', not 'func'");
        }
        // A function literal, or a func type in a conversion.
        p_next();
        let f = fn_new(pos, "func");
        parse_params(f);
        p_bangres = 0;
        f[F_RTYPES] = parse_results();
        f[F_BANG] = p_bangres;
        if !p_is("{") {
            p_fail_code(pos, "E020 UNEXPECTED", "expected a function body");
        }
        let saved = p_nolit;
        p_nolit = 0;
        f[F_BODY] = parse_block();
        p_nolit = saved;
        let lit = node_new(EX_FUNCLIT, pos);
        lit[LIT_FN] = f;
        lit[LIT_ESCAPE] = 1;
        return lit;
    }
    if p_is("[") || p_is("map") || p_is("struct") {
        let ty = node_new(EX_TYPE, pos);
        ty[TYX] = parse_type();
        return ty;
    }
    p_next();
    p_fail_found_code(pos, "E020 UNEXPECTED", "expected an expression", t);
}
