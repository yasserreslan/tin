// Parser: tokens to AST nodes. Accepts Tin v1 (fn/let/while, untyped words) and
// Tin v2 (Go syntax: func, :=, for, types, structs, methods, packages).
shared mut prog_fns i64
shared mut prog_consts i64
shared mut prog_vars i64
shared mut prog_types i64
shared mut prog_shapes i64
shared mut prog_uses i64
shared mut prog_ons i64
shared mut file_pkgs i64 // per file: package name, "" for main
shared mut file_imports i64 // per file: vec of [alias, path]
shared mut file_v2 i64 // per file: 1 when it declares a package or uses func
shared mut file_ed1 i64 // per file: 1 when parsed as edition 1 (generic instances re-parse with it)
shared mut file_sources i64 // original byte buffers for the syntax-preserving edition-1 printer
shared mut file_tokens i64 // token vectors paired with file_sources
shared mut cur_file i64

// Function declaration layout.
const F_POS = 0
const F_NAME = 1
const F_PARAMS = 2
const F_EXTERN = 3
const F_BODY = 4
const F_SLOTS = 5
const F_LOCALS = 6 // params then lets, in declaration order (set by the checker)
const F_LEAF = 7 // makes no calls (set by analysis)
const F_USED = 8 // extern that is called, so it needs an import
const F_ADDR = 9 // code address (set by the linker)
const F_GOT = 10 // import index of an extern
const F_PTYPES = 11 // param type exprs, then resolved types
const F_RTYPES = 12 // result type exprs, then resolved types
const F_RECV = 13 // method receiver type expr, then type
const F_RECVNAME = 14
const F_FILE = 15
const F_QNAME = 16 // symbol name: pkg.Name, Type.Method
const F_LEGACY = 17 // declared with fn: untyped words, C strings
const F_VARIADIC = 18
const F_REACH = 19 // reachable from main (set by the checker)
const F_TYPE = 20 // func type
const F_LIFTED = 21 // function literal lifted to top level
const F_INDEX = 22 // position in prog_fns (set by codegen)
const F_TPARAMS = 28 // generic: type parameter names (0 for ordinary functions)
const F_TCONS = 29 // generic: per type parameter, a vec of allowed types (0: unconstrained)
const F_TOKS = 30 // generic: the tokens, re-parsed for each instance
const F_TOKAT = 31
const F_TBIND = 32 // instance: vec of [name, type] bindings
const F_INSTS = 33 // generic: vec of [type args, instance]
const F_GENOF = 34 // instance: its generic
const F_BANG = 35 // results written !T: a return gives the values, fail the fault
const F_PARENT = 36 // enclosing function if this is a closure
const F_CAPTURES = 37 // vec of captured outer symbols
const F_OUTER_SYMS = 38 // snapshot of outer symbols at definition
const F_ENV_SYM = 39 // symbol for $env parameter
const F_DONE = 40 // checked already
const F_ESCAPES = 41 // whether closure escapes
const F_INSTCYCLE = 42 // generic: an endless instantiation was reported
const F_ATTRS = 43 // edition 1 attributes, in source order
const F_SIZE = 44
const F_MUTRES = 24 // result is a fresh (request-pool) value the caller may modify
const F_RECVMUT = 25 // method may modify its receiver (needs a fresh one)

// Const, var and type declaration layout.
const D_POS = 0
const D_NAME = 1
const D_INIT = 2
const D_VAL = 3
const D_TYPE = 4
const D_FILE = 5
const D_IOTA = 6
const D_SYM = 7
const D_SHARED = 8 // shared var: one process-wide word (runtime only)
const D_TPARAMS = 9 // generic type: parameter names
const D_TCONS = 10
const D_INSTS = 11 // generic type: vec of [type args, type]
const D_METHODS = 12 // generic type: its method templates
const D_SHAPE = 13 // shape: vec of method signature nodes
const D_INITS = 14 // const specification expressions, repeated by a bare grouped spec
const D_UNION = 15 // shape: vec of the shapes it lists (composition), or of `= A | B`
const D_UNIONKIND = 16 // shape: 1 for the `= A | B` union form, 0 for a method set
const D_MUT = 17 // edition 1 global binding mutability
const D_SIZE = 18

shared mut p_shared i64

// Every AST node starts with its kind and position; expressions carry their type.
const N_KIND = 0
const N_POS = 1
const N_TYPE = 6
const N_REGION = 9 // region pass: where a reference value lives
const N_SIZE = 12

const EX_INT = 1
const EX_STR = 2
const EX_IDENT = 3
const EX_UNARY = 4
const EX_BINARY = 5
const EX_CALL = 6
const EX_INDEX = 7
const EX_REG = 8 // codegen-only: a value already in a register
const EX_CONV = 9 // checker-made conversion
const ST_BLOCK = 10
const ST_LET = 11
const ST_ASSIGN = 12
const ST_EXPR = 13
const ST_IF = 14
const ST_WHILE = 15
const ST_RETURN = 16
const ST_BREAK = 17
const ST_CONTINUE = 18
const EX_FLOAT = 20
const EX_NIL = 21
const EX_SELECT = 22
const EX_SLICE = 23
const EX_COMPOSITE = 24
const EX_TYPE = 25
const EX_SEQ = 26 // checker-made: run statements, then yield a value
const EX_FUNCREF = 27 // checker-made: address of a function
const EX_FUNCLIT = 28
const EX_MEM = 29 // checker-made: sized load/store at base + index*scale + off
const EX_ELEM = 39 // checker-made: bounds-checked slice or string element
const EX_TRY = 48
const EX_CATCH = 52 // E catch name { body }
const ST_FAIL = 53 // fail X
const EX_MUTARG = 54 // mut x: an argument for a mut parameter
const EX_INTERP = 55 // "text {x} {y:.2}": parts, values, format specs
const ST_CONST = 56 // local constant declarations; field 2 is their declaration vector
const EX_MATCH = 58 // edition 1 match expression or statement
const EX_UNIT = 59 // edition 1 typed unit literal
const EX_COALESCE = 60 // edition 1 nil coalescing
const EX_WRAP = 61 // edition 1 contextual fault message
const EX_BOUNDARY = 65 // edition 1 boundary expression
const ST_SELECT = 66
const ST_SCOPE = 67
const ST_DETACH = 68
const ST_ONCE = 69
const ST_USE = 70
const ST_ON = 71
const ST_BSTORE = 72 // checker-made: a boundary block's last expression, stored for its wrapper (ES_X)
const ST_MSTORE = 73 // checker-made: a match arm's value, stored in the match's value local (ES_X)
const ST_MULTI = 30
const ST_RANGE = 31
const ST_SWITCH = 32
const ST_LIST = 33 // statements spliced into the enclosing block
const ST_CALLMULTI = 34
const ST_GO = 35
const ST_DEFER = 36
const TX_NAME = 40
const TX_SLICE = 41
const TX_MAP = 42
const TX_PTR = 43
const TX_FUNC = 44
const TX_STRUCT = 45
const TX_ARRAY = 46
const TX_CHAN = 47
const TX_OPT = 49
const TX_DYN = 57 // dyn Shape: a fat reference, TX_A holds the shape's type expr
const TX_SECRET = 62 // edition 1 sensitive type wrapper
const TX_MAX = 63 // edition 1 bounded type wrapper
const TX_TUPLE = 64 // edition 1 tuple type

// Node fields by kind.
const INT_VAL = 2
const STR_PTR = 2
const STR_LEN = 3
const ID_NAME = 2
const ID_REF = 3
const UN_OP = 2
const UN_X = 3
const BIN_OP = 2
const BIN_L = 3
const BIN_R = 4
const CALL_NAME = 2
const CALL_ARGS = 3
const CALL_INTRINSIC = 4
const CALL_FN = 5
const CALL_CALLEE = 7
const REG_NUM = 2
const IX_X = 2
const IX_I = 3
const IX_ARGS = 4 // X[A, B] or X[[]T]: type arguments, when they cannot be an index
const IX_HDR = 7 // a slice/string header field: invariant while a loop makes no calls
const CV_X = 2
const CV_KIND = 3
const FL_BITS = 2
const FL_TEXT = 3
const SEL_X = 2
const SEL_NAME = 3
const SL_X = 2
const SL_LO = 3
const SL_HI = 4
const CL_TYPE = 2
const CL_ELEMS = 3
const CL_KEYS = 4
const CL_ADDR = 5
const TYX = 2
const SEQ_STMTS = 2
const SEQ_VALUE = 3
const FR_FN = 2
const FR_RAW = 3
const LIT_FN = 2
const LIT_ESCAPE = 3
const LIT_SCOPED = 4 // checker: a closure passed to a scope's spawn (#232)
const BLK_STMTS = 2
const LET_NAME = 2
const LET_INIT = 3
const LET_SYM = 4
const LET_TYPE = 5
const LET_MUT = 6 // edition 1: the binding name may be reassigned
const AS_TARGET = 2
const AS_VALUE = 3
const ES_X = 2
const IF_COND = 2
const IF_THEN = 3
const IF_ELSE = 4
const IF_INIT = 5
const WH_COND = 2
const WH_BODY = 3
const WH_POST = 4
const WH_INIT = 5
const WH_ONCE = 7 // a switch: break leaves it, continue passes through
const WH_LABEL = 8 // edition 1 loop label
const BR_LABEL = 2
const CONT_LABEL = 2
const RET_VALUE = 2
const RET_VALUES = 3
const MU_TARGETS = 2
const MU_VALUES = 3
const MU_DEFINE = 4
const MU_MUT = 5 // edition 1: mutability of names introduced by this binding
const RG_KEY = 2
const RG_VAL = 3
const RG_EXPR = 4
const RG_BODY = 5
const RG_DEFINE = 6
const RG_LABEL = 7
const SW_TAG = 2
const SW_CASES = 3
const SW_INIT = 5
const LIST_STMTS = 2
const CM_CALL = 2
const CM_SYMS = 3
const GO_CALL = 2
const TX_A = 2
const TX_B = 3
const TX_ARGS = 4 // Name[T1, T2]: type arguments
const MEM_BASE = 2
const MEM_INDEX = 3
const MEM_SCALE = 4
const MEM_OFF = 5
const MEM_HDR = 7 // a header word: invariant while a loop makes no calls
const MEM_LEN = 8 // bounds check: the index must be below this length (0: none)
const ELEM_SEQ = 2
const ELEM_IDX = 3
const ELEM_SIZE = 4
const ELEM_STR = 5
const ELEM_SAFE = 7 // index proven in range: no bounds check
const TRY_X = 2
const TRY_SOFT = 3 // checker: a parallel line, which may also be a plain value (#232)
const CATCH_X = 2
const CATCH_NAME = 3
const CATCH_BODY = 4
const FAIL_X = 2
const MUTARG_X = 2
const INTERP_PARTS = 2
const INTERP_ARGS = 3
const INTERP_SPECS = 4
const MATCH_SUBJECT = 2
const MATCH_ARMS = 3
const ARM_POS = 0
const ARM_PATTERNS = 1
const ARM_GUARD = 2
const ARM_BODY = 3
const ARM_BLOCK = 4
const PAT_KIND = 0
const PAT_POS = 1
const PAT_A = 2
const PAT_B = 3
const PAT_NAME = 4
const PAT_CHILDREN = 5
const PAT_WILD = 1
const PAT_LITERAL = 2
const PAT_RANGE = 3
const PAT_VARIANT = 4
const PAT_NAME_KIND = 5
const UNIT_VALUE = 2
const UNIT_NAME = 3
const UNIT_TEXT = 4
const UNIT_FLOAT = 5
const COAL_X = 2
const COAL_FALLBACK = 3
const WRAP_X = 2
const WRAP_MESSAGE = 3
const BOUND_KIND = 2
const BOUND_ARGS = 3
const BOUND_BODY = 4
const BOUND_WITHIN = 1
const BOUND_LIMIT = 2
const BOUND_GUARD = 3
const BOUND_ARENA = 4
const BOUND_PARALLEL = 5
const BOUND_WITH = 6
const SELECT_ARMS = 2
const SELECT_ARM_POS = 0
const SELECT_ARM_NAME = 1
const SELECT_ARM_WAIT = 2
const SELECT_ARM_BODY = 3
const SELECT_ARM_BLOCK = 4
const SCOPE_NAME = 2
const SCOPE_BODY = 3
const USE_NAME = 2
const USE_INIT = 3
const ON_EVENT = 2
const ON_BODY = 3
const USE_FILE = 4 // the file of a use or on declaration (#238)
const ON_FILE = 4
const USE_DECL = 7 // a package-level use: its global's declaration
const USE_STOP = 8 // a package-level use: its close function (checker)
const BODY_BLOCK = 2
const BLK_FLAT = 3 // a checker-made block that opens no scope
const CALL_STORE = 8 // a runtime call that stores into its first argument (region pass)
const CALL_METHOD = 9 // argument 0 is a method receiver (no call-site mut)
const CALL_DYN_SHAPE = 10 // shape whose method set can be called through this dyn value
const CALL_DYN_INDEX = 11 // method slot in its per-type table (keep is slot zero)
// Regions of reference values, for the ember/ingot rules.
const R_UNKNOWN = 0
const R_EMBER = 1 // lives in the current request's pool
const R_INGOT = 2 // lives in the core's long-lived heap
const R_OWNED = 3 // a fresh keep() copy, only storable into ingot memory
const R_STATIC = 4 // string literals and other immortal data
const F_MUTS = 23 // vec: 1 for each mut parameter

shared mut p_toks i64
shared mut p_i i64
shared mut p_nolit i64 // composite literals after a name are off in if/for/switch headers
shared mut p_legacy i64 // parsing a v1 fn body
shared mut p_edition1 i64
shared mut p_decl_mut i64
shared mut p_range_expr i64
shared mut p_pending_label i64
shared mut p_saw_package i64
shared mut p_saw_topdecl i64
shared mut p_mutres i64 // the result list just parsed was marked mut
shared mut p_bangres i64 // the result list just parsed was written !T

fn node_new(kind i64, pos i64) i64 {
	let n = calloc(N_SIZE, 8)
	n[N_KIND] = kind
	n[N_POS] = pos
	return n
}

fn decl_new(pos i64, name i64) i64 {
	let d = calloc(D_SIZE, 8)
	d[D_POS] = pos
	d[D_NAME] = name
	d[D_FILE] = cur_file
	d[D_SHARED] = p_shared
	return d
}

fn fn_new(pos i64, name i64) i64 {
	let f = calloc(F_SIZE, 8)
	f[F_POS] = pos
	f[F_NAME] = name
	f[F_PARAMS] = vec_new()
	f[F_PTYPES] = vec_new()
	f[F_RTYPES] = vec_new()
	f[F_MUTS] = vec_new()
	f[F_FILE] = cur_file
	return f
}

fn parse_setup() {
	prog_fns = vec_new()
	prog_consts = vec_new()
	prog_vars = vec_new()
	prog_types = vec_new()
	prog_shapes = vec_new()
	prog_uses = vec_new()
	prog_ons = vec_new()
	file_pkgs = vec_new()
	file_imports = vec_new()
	file_v2 = vec_new()
	file_ed1 = vec_new()
	file_sources = vec_new()
	file_tokens = vec_new()
}

// parse keeps the edition-0 entry point stable. Tin 1 callers select the new grammar explicitly.
fn parse(toks i64) {
	parse_mode(toks, 0)
}

fn parse_edition1(toks i64) {
	parse_mode(toks, 1)
}

// parse_mode reads one file's declarations; cur_file must be its index in files.
fn parse_mode(toks i64, edition i64) {
	p_toks = toks
	p_i = 0
	p_nolit = 0
	p_edition1 = edition
	p_decl_mut = 1
	p_range_expr = 0
	p_pending_label = 0
	p_saw_package = 0
	p_saw_topdecl = 0
	vec_push(file_pkgs, cstr(""))
	vec_push(file_imports, vec_new())
	vec_push(file_v2, edition)
	vec_push(file_ed1, edition)
	for p_peek()[T_KIND] != TK_EOF {
		if p_edition1 != 0 && p_saw_topdecl != 0 && p_is(cstr("import")) != 0 {
			p_fail_code(p_peek()[T_POS], cstr("E002 IMPORT_ORDER"), cstr("imports must precede declarations"))
		}
		if p_edition1 != 0 && p_saw_package == 0 && p_is(cstr("package")) == 0 && vec_get(file_trusted, cur_file) == 0 {
			p_fail_code(p_peek()[T_POS], cstr("E001 PACKAGE_CLAUSE"), cstr("edition 1 files start with a package declaration"))
		}
		if p_edition1 != 0 && p_is(cstr(";")) == 0 && p_is(cstr("package")) == 0 && p_is(cstr("import")) == 0 {
			p_saw_topdecl = 1
		}
		if p_is(cstr(";")) != 0 {
			p_next()
		} else if p_is(cstr("package")) != 0 {
			if p_edition1 != 0 && p_saw_package != 0 {
				p_fail_code(p_peek()[T_POS], cstr("E001 PACKAGE_CLAUSE"), cstr("a file has one package declaration"))
			}
			p_next()
			file_pkgs[VEC_DATA][cur_file] = p_expect_ident()[T_TEXT]
			p_saw_package = 1
			if streq(vec_get(file_pkgs, cur_file), cstr("main")) != 0 {
				file_pkgs[VEC_DATA][cur_file] = cstr("")
			}
			file_v2[VEC_DATA][cur_file] = 1
		} else if p_is(cstr("import")) != 0 {
			p_next()
			if p_is(cstr("(")) != 0 {
				if p_edition1 != 0 {
					p_fail_code(p_peek()[T_POS], cstr("E091 ONE_PER_DECLARATION"), cstr("edition 1 writes one import path per declaration"))
				}
				p_next()
				for p_is(cstr(")")) == 0 {
					if p_is(cstr(";")) != 0 {
						p_next()
					} else {
						parse_import()
					}
				}
				p_next()
			} else {
				parse_import()
			}
		} else if p_edition1 != 0 && p_is(cstr("@")) != 0 {
			let attrs = parse_attributes()
			if p_is(cstr("fn")) == 0 {
				p_fail_found_code(p_peek()[T_POS], cstr("E040 ATTRIBUTE_PLACEMENT"), cstr("attributes here must precede a function"), p_peek())
			}
			let f = parse_fn(0, 0)
			f[F_ATTRS] = attrs
			vec_push(prog_fns, f)
		} else if p_is(cstr("fn")) != 0 {
			vec_push(prog_fns, parse_fn(0, i64(p_edition1 == 0)))
		} else if p_is(cstr("func")) != 0 {
			if p_edition1 != 0 {
				p_fail_code(p_peek()[T_POS], cstr("E090 OLD_SYNTAX"), cstr("edition 1 uses 'fn', not 'func'"))
			}
			file_v2[VEC_DATA][cur_file] = 1
			vec_push(prog_fns, parse_fn(0, 0))
		} else if p_is(cstr("extern")) != 0 {
			// the standard library declares the OS functions it calls (macOS) and the
			// instructions it lowers inline; the check reports any other extern (E801)
			p_next()
			vec_push(prog_fns, parse_fn(1, i64(p_edition1 == 0 && p_is(cstr("fn")) != 0)))
		} else if p_is(cstr("const")) != 0 {
			p_next()
			if p_edition1 != 0 && p_is(cstr("(")) != 0 {
				p_fail_code(p_peek()[T_POS], cstr("E091 ONE_PER_DECLARATION"), cstr("edition 1 declares one constant per declaration"))
			}
			parse_group(1, prog_consts)
		} else if p_edition1 != 0 && p_is(cstr("let")) != 0 {
			p_next()
			p_decl_mut = 0
			parse_group(0, prog_vars)
			p_decl_mut = 1
		} else if p_edition1 != 0 && p_is(cstr("mut")) != 0 {
			p_next()
			p_decl_mut = 1
			parse_group(0, prog_vars)
		} else if p_is(cstr("var")) != 0 {
			if p_edition1 != 0 {
				p_fail_code(p_peek()[T_POS], cstr("E090 OLD_SYNTAX"), cstr("edition 1 uses 'let' or 'mut', not 'var'"))
			}
			p_decl_mut = 1
			p_next()
			parse_group(0, prog_vars)
		} else if p_word(cstr("shared")) != 0 {
			p_next()
			if p_edition1 != 0 && p_is(cstr("mut")) != 0 {
				// shared mutable state: the standard library only (the check reports E601)
				p_next()
				p_decl_mut = 1
			} else if p_edition1 != 0 {
				p_expect(cstr("let"))
				p_decl_mut = 0
			} else {
				p_expect(cstr("var"))
				p_decl_mut = 1
			}
			p_shared = 1
			parse_group(0, prog_vars)
			p_shared = 0
		} else if p_is(cstr("type")) != 0 {
			p_next()
			if p_is(cstr("(")) != 0 {
				if p_edition1 != 0 {
					p_fail_code(p_peek()[T_POS], cstr("E091 ONE_PER_DECLARATION"), cstr("edition 1 declares one type per declaration"))
				}
				p_next()
				for p_is(cstr(")")) == 0 {
					if p_is(cstr(";")) != 0 {
						p_next()
					} else {
						parse_type_decl()
					}
				}
				p_next()
			} else {
				parse_type_decl()
			}
		} else if p_word(cstr("shape")) != 0 {
			file_v2[VEC_DATA][cur_file] = 1
			vec_push(prog_shapes, parse_shape_decl())
		} else if p_edition1 != 0 && p_word(cstr("use")) != 0 {
			vec_push(prog_uses, parse_use_decl())
			use_global_decl(prog_uses)
		} else if p_edition1 != 0 && p_word(cstr("on")) != 0 {
			vec_push(prog_ons, parse_on_decl())
		} else {
			if p_edition1 != 0 {
				p_fail_found_code(p_peek()[T_POS], cstr("E020 UNEXPECTED"), cstr("expected a declaration (fn, const, let, mut, type, shape, use, on)"), p_peek())
			}
			p_fail_found_code(p_peek()[T_POS], cstr("E020 UNEXPECTED"), cstr("expected a declaration (func, var, const, type, shape)"), p_peek())
		}
	}
	if p_edition1 != 0 && p_saw_package == 0 && vec_get(file_trusted, cur_file) == 0 {
		p_fail_code(p_peek()[T_POS], cstr("E001 PACKAGE_CLAUSE"), cstr("edition 1 files start with a package declaration"))
	}
}

fn parse_import() {
	mut alias = 0
	if p_edition1 == 0 && p_peek()[T_KIND] == TK_IDENT {
		alias = p_next()[T_TEXT]
	}
	let t = p_next()
	if t[T_KIND] != TK_STRING {
		p_fail_found_code(t[T_POS], cstr("E020 UNEXPECTED"), cstr("expected an import path"), t)
	}
	let path = t[T_TEXT]
	if alias == 0 {
		// The package name is the last path element: "net/http" is http.
		alias = path
		mut i = 0
		for i64(load8(path + i)) != 0 {
			if i64(load8(path + i)) == '/' {
				alias = path + i + 1
			}
			i = i + 1
		}
	}
	let rec = vec_new()
	vec_push(rec, alias)
	vec_push(rec, path)
	vec_push(vec_get(file_imports, cur_file), rec)
	p_end()
}

fn parse_use_decl() i64 {
	let u = node_new(ST_USE, p_next()[T_POS])
	u[USE_NAME] = p_expect_ident()[T_TEXT]
	p_expect(cstr("="))
	u[USE_INIT] = parse_expr(1)
	u[USE_FILE] = cur_file
	p_end()
	return u
}

// use_global_decl declares the per-core global of the package-level use just parsed, in
// source order among the other globals (#238).
fn use_global_decl(uses i64) {
	let u = vec_get(uses, uses[VEC_LEN] - 1)
	let d = decl_new(u[N_POS], u[USE_NAME])
	d[D_INIT] = u[USE_INIT]
	u[USE_DECL] = d
	vec_push(prog_vars, d)
}

fn parse_on_decl() i64 {
	let pos = p_next()[T_POS]
	let on_ = node_new(ST_ON, pos)
	let saved = p_nolit
	p_nolit = 1
	on_[ON_EVENT] = parse_expr(1)
	p_nolit = saved
	on_[ON_BODY] = parse_block()
	on_[ON_FILE] = cur_file
	return on_
}

// parse_attributes reads the edition-1 attributes preceding a function or field.
fn parse_attributes() i64 {
	let attrs = vec_new()
	for p_is(cstr("@")) != 0 {
		let pos = p_next()[T_POS]
		let attr = vec_new()
		vec_push(attr, pos)
		vec_push(attr, p_expect_ident()[T_TEXT])
		mut args = vec_new()
		if p_is(cstr("(")) != 0 {
			p_next()
			if p_is(cstr(")")) == 0 {
				args = parse_expr_list()
			}
			p_expect(cstr(")"))
		}
		vec_push(attr, args)
		vec_push(attrs, attr)
	}
	return attrs
}

// parse_group reads one const/var declaration or a parenthesized group of them.
fn parse_group(is_const i64, decls i64) {
	if p_is(cstr("(")) == 0 {
		parse_value_spec(is_const, 0, 0, 0, decls)
		return
	}
	if p_edition1 != 0 {
		p_fail_code(p_peek()[T_POS], cstr("E091 ONE_PER_DECLARATION"), cstr("edition 1 declares one name per declaration"))
	}
	p_next()
	mut iota = 0
	mut last_init = 0
	mut last_type = 0
	for p_is(cstr(")")) == 0 {
		if p_is(cstr(";")) != 0 {
			p_next()
		} else {
			let d = parse_value_spec(is_const, iota, last_init, last_type, decls)
			if is_const != 0 {
				last_init = d[D_INITS]
				last_type = d[D_TYPE]
			}
			iota = iota + 1
		}
	}
	p_next()
}

fn parse_value_spec(is_const i64, iota i64, prev_init i64, prev_type i64, decls i64) i64 {
	let pos = p_peek()[T_POS]
	let names = vec_new()
	vec_push(names, p_expect_ident()[T_TEXT])
	for p_is(cstr(",")) != 0 {
		p_next()
		vec_push(names, p_expect_ident()[T_TEXT])
	}
	if p_edition1 != 0 && names[VEC_LEN] > 1 {
		p_fail_code(pos, cstr("E091 ONE_PER_DECLARATION"), cstr("edition 1 declares one name per declaration"))
	}
	mut ty = 0
	if p_is(cstr("=")) == 0 && p_is(cstr(";")) == 0 && p_is(cstr(")")) == 0 && p_is(cstr("}}")) == 0 {
		ty = parse_type()
	}
	mut inits = 0
	if p_is(cstr("=")) != 0 {
		p_next()
		inits = parse_expr_list()
	}
	if is_const != 0 {
		if inits == 0 {
			if ty != 0 || prev_init == 0 {
				p_fail_code(pos, cstr("E021 CONST_VALUES"), cstr("missing constant value"))
			}
			inits = prev_init
			ty = prev_type
		}
		if inits[VEC_LEN] != names[VEC_LEN] {
			p_fail_code(pos, cstr("E021 CONST_VALUES"), cstr("constant declaration count mismatch"))
		}
	}
	mut first = 0
	mut i = 0
	for i < names[VEC_LEN] {
		let d = decl_new(pos, vec_get(names, i))
		d[D_TYPE] = ty
		d[D_IOTA] = iota
		d[D_MUT] = i64(is_const == 0 && p_decl_mut != 0)
		d[D_INITS] = inits
		if inits != 0 && i < inits[VEC_LEN] {
			d[D_INIT] = vec_get(inits, i)
		}
		if is_const != 0 {
			if d[D_INIT] == 0 {
				p_fail_code(pos, cstr("E021 CONST_VALUES"), cstr("missing constant value"))
			}
		}
		vec_push(decls, d)
		if first == 0 {
			first = d
		}
		i = i + 1
	}
	p_end()
	return first
}

fn parse_type_decl() {
	let pos = p_peek()[T_POS]
	let d = decl_new(pos, p_expect_ident()[T_TEXT])
	// type Stack[T constraints.Any] ...: a name and a constraint after '[' (an array type has a length).
	if p_is(cstr("[")) != 0 && p_peek2()[T_KIND] == TK_IDENT && p_legacy == 0 {
		let save = p_i
		p_next()
		p_next()
		let generic = i64(p_is(cstr("]")) == 0)
		p_i = save
		if generic != 0 {
			d[D_TPARAMS] = vec_new()
			d[D_TCONS] = vec_new()
			parse_tparams(d[D_TPARAMS], d[D_TCONS])
		}
	}
	if p_is(cstr("=")) != 0 {
		p_next()
		d[D_IOTA] = 1
	}
	d[D_TYPE] = parse_type()
	vec_push(prog_types, d)
	p_end()
}

// ---- shapes ----
// parse_shape_decl reads a shape: shape Name { methods and listed shapes } or the
// named union shape Name = A | B | C. `shape` is a contextual word (like enum, fail
// and shared): it opens a declaration only at the top level, where no other form
// starts with that name, so a program may still use it as a name elsewhere. A method
// is a function node with no receiver and no body, so a shape signature and a func
// signature are parsed by the same code and cannot drift apart.
fn parse_shape_decl() i64 {
	let pos = p_next()[T_POS]
	let d = decl_new(pos, p_expect_ident()[T_TEXT])
	d[D_SHAPE] = vec_new()
	d[D_UNION] = vec_new()
	// shape Seq[T]: a shape may take type parameters, constrained like a generic type's.
	if p_is(cstr("[")) != 0 {
		d[D_TPARAMS] = vec_new()
		d[D_TCONS] = vec_new()
		parse_tparams(d[D_TPARAMS], d[D_TCONS])
	}
	if p_is(cstr("=")) != 0 {
		p_next()
		d[D_UNIONKIND] = 1
		d[D_UNION] = parse_type_union(parse_type())
		p_end()
		return d
	}
	p_expect(cstr("{{"))
	for p_is(cstr("}}")) == 0 {
		if p_is(cstr(";")) != 0 {
			p_next()
			continue
		}
		let mpos = p_peek()[T_POS]
		// Name( ... is a method signature; a bare name lists another shape (composition),
		// and `=` above already took the union form.
		if p_peek2()[T_KIND] == TK_PUNCT && streq(p_peek2()[T_TEXT], cstr("(")) != 0 {
			vec_push(d[D_SHAPE], parse_shape_method(mpos))
		} else {
			vec_push(d[D_UNION], parse_type())
		}
		p_end()
	}
	p_next()
	p_end()
	return d
}

// parse_shape_method reads Name(params) results with no receiver and no body, keeping
// the mut marks, the variadic and the !T fault result a func declaration keeps.
fn parse_shape_method(pos i64) i64 {
	let m = fn_new(pos, p_expect_ident()[T_TEXT])
	parse_params(m)
	p_mutres = 0
	p_bangres = 0
	m[F_RTYPES] = parse_results()
	m[F_MUTRES] = p_mutres
	m[F_BANG] = p_bangres
	return m
}

fn p_peek() i64 {
	return vec_get(p_toks, p_i)
}

fn p_peek2() i64 {
	if p_i + 1 < p_toks[VEC_LEN] {
		return vec_get(p_toks, p_i + 1)
	}
	return vec_get(p_toks, p_i)
}

fn p_next() i64 {
	let t = p_peek()
	if t[T_KIND] != TK_EOF {
		p_i = p_i + 1
	}
	return t
}

// p_is reports whether the next token is the given keyword or punctuation.
fn p_is(text i64) i64 {
	let t = p_peek()
	return i64((t[T_KIND] == TK_KEYWORD || t[T_KIND] == TK_PUNCT) && streq(t[T_TEXT], text) != 0)
}

// p_word recognizes contextual words and edition-1 keywords by spelling.
fn p_word(text i64) i64 {
	let t = p_peek()
	return i64((t[T_KIND] == TK_IDENT || (p_edition1 != 0 && t[T_KIND] == TK_KEYWORD)) && streq(t[T_TEXT], text) != 0)
}

fn tok_is(t i64, text i64) i64 {
	return i64((t[T_KIND] == TK_KEYWORD || t[T_KIND] == TK_PUNCT) && streq(t[T_TEXT], text) != 0)
}

// p_end finishes a statement or declaration: a semicolon, or nothing before } or ).
fn p_end() {
	if p_is(cstr(";")) != 0 {
		p_next()
		return
	}
	if p_is(cstr("}}")) != 0 || p_is(cstr(")")) != 0 || p_peek()[T_KIND] == TK_EOF {
		return
	}
	if p_edition1 != 0 {
		p_fail_found_code(p_peek()[T_POS], cstr("E020 UNEXPECTED"), cstr("expected a newline or end of block"), p_peek())
	}
	p_expect(cstr(";"))
}

fn buf_describe(b i64, t i64) {
	let k = t[T_KIND]
	if k == TK_EOF {
		buf_str(b, cstr("end of file"))
	} else if k == TK_IDENT {
		buf_str(b, cstr("name '"))
		buf_str(b, t[T_TEXT])
		buf_byte(b, '\'')
	} else if k == TK_INT || k == TK_FLOAT {
		buf_str(b, cstr("a number"))
	} else if k == TK_STRING {
		buf_str(b, cstr("a string"))
	} else if k == TK_PUNCT && streq(t[T_TEXT], cstr(";")) != 0 && t[T_VAL] != 0 {
		buf_str(b, cstr("newline"))
	} else {
		buf_byte(b, '\'')
		buf_str(b, t[T_TEXT])
		buf_byte(b, '\'')
	}
}

// p_fail_code and p_fail_found_code stop with a coded error (docs/ERRORS.md).
fn p_fail_code(pos i64, code i64, msg i64) {
	let e = err_code(pos, code)
	buf_str(e, msg)
	fatal(e)
}

fn p_fail_found_code(pos i64, code i64, msg i64, t i64) {
	let e = err_code(pos, code)
	buf_str(e, msg)
	buf_str(e, cstr(", found "))
	buf_describe(e, t)
	fatal(e)
}

fn p_expect(text i64) i64 {
	if p_is(text) == 0 {
		let e = err_code(p_peek()[T_POS], cstr("E020 UNEXPECTED"))
		buf_str(e, cstr("expected '"))
		buf_str(e, text)
		buf_str(e, cstr("', found "))
		buf_describe(e, p_peek())
		fatal(e)
	}
	return p_next()
}

fn p_expect_ident() i64 {
	if p_peek()[T_KIND] != TK_IDENT {
		p_fail_found_code(p_peek()[T_POS], cstr("E020 UNEXPECTED"), cstr("expected a name"), p_peek())
	}
	return p_next()
}

// ---- types ----
fn starts_type() i64 {
	let t = p_peek()
	return i64(t[T_KIND] == TK_IDENT || p_is(cstr("[")) != 0 || p_is(cstr("map")) != 0 || p_is(cstr("*")) != 0 || p_is(cstr("func")) != 0 || p_is(cstr("struct")) != 0 || p_is(cstr("?")) != 0 || p_is(cstr("mut")) != 0 || (p_edition1 != 0 && (p_word(cstr("secret")) != 0 || p_is(cstr("fn")) != 0)))
}

fn parse_type() i64 {
	let ty = parse_type_base()
	if p_edition1 != 0 && p_word(cstr("max")) != 0 {
		let bounded = node_new(TX_MAX, ty[N_POS])
		bounded[TX_A] = ty
		p_next()
		bounded[TX_B] = parse_expr(1)
		return bounded
	}
	return ty
}

fn parse_type_base() i64 {
	let pos = p_peek()[T_POS]
	if p_edition1 != 0 && p_word(cstr("secret")) != 0 {
		p_next()
		let secret_ = node_new(TX_SECRET, pos)
		secret_[TX_A] = parse_type()
		return secret_
	}
	// Standard-library files are edition 0 and opt parameters in with secret too (#239).
	if p_edition1 == 0 && vec_get(file_trusted, cur_file) != 0 && p_word(cstr("secret")) != 0 && (p_peek2()[T_KIND] == TK_IDENT || tok_is(p_peek2(), cstr("[")) != 0 || tok_is(p_peek2(), cstr("?")) != 0) {
		p_next()
		let libsecret = node_new(TX_SECRET, pos)
		libsecret[TX_A] = parse_type()
		return libsecret
	}
	if p_is(cstr("[")) != 0 {
		p_next()
		if p_is(cstr("]")) != 0 {
			p_next()
			let s = node_new(TX_SLICE, pos)
			s[TX_A] = parse_type()
			return s
		}
		let a = node_new(TX_ARRAY, pos)
		a[TX_A] = parse_expr(1)
		p_expect(cstr("]"))
		a[TX_B] = parse_type()
		return a
	}
	if p_is(cstr("map")) != 0 {
		p_next()
		p_expect(cstr("["))
		let m = node_new(TX_MAP, pos)
		m[TX_A] = parse_type()
		p_expect(cstr("]"))
		m[TX_B] = parse_type()
		return m
	}
	if p_is(cstr("*")) != 0 {
		if p_edition1 != 0 {
			p_fail_code(pos, cstr("E090 OLD_SYNTAX"), cstr("edition 1 does not use pointer types"))
		}
		p_next()
		let pt = node_new(TX_PTR, pos)
		pt[TX_A] = parse_type()
		return pt
	}
	if p_is(cstr("?")) != 0 {
		p_next()
		let ot = node_new(TX_OPT, pos)
		ot[TX_A] = parse_type()
		return ot
	}
	if p_edition1 != 0 && p_is(cstr("(")) != 0 {
		let tuple = node_new(TX_TUPLE, pos)
		ptl_muts = 0
		tuple[TX_A] = parse_type_list()
		if tuple[TX_A][VEC_LEN] == 0 {
			p_fail_code(pos, cstr("E043 EMPTY_TUPLE"), cstr("a tuple type needs at least one element type"))
		}
		return tuple
	}
	if p_is(cstr("func")) != 0 || (p_edition1 != 0 && p_is(cstr("fn")) != 0) {
		if p_edition1 != 0 && p_is(cstr("func")) != 0 {
			p_fail_code(pos, cstr("E090 OLD_SYNTAX"), cstr("edition 1 uses 'fn' for function types"))
		}
		p_next()
		let ft = node_new(TX_FUNC, pos)
		ptl_muts = 0
		ft[TX_A] = parse_type_list()
		ft[TX_ARGS] = ptl_muts
		ft[TX_B] = parse_results()
		return ft
	}
	if p_is(cstr("struct")) != 0 {
		p_next()
		return parse_struct_body(pos)
	}
	if p_word(cstr("enum")) != 0 && tok_is(p_peek2(), cstr("{{")) != 0 && p_legacy == 0 {
		p_next()
		return parse_enum_body(pos)
	}
	// dyn Shape: a fat reference to anything satisfying Shape. Contextual: it is a
	// keyword in type position only when a shape name follows, so a type of its own
	// named `dyn` still resolves as a name.
	if p_word(cstr("dyn")) != 0 && p_peek2()[T_KIND] == TK_IDENT && p_legacy == 0 {
		p_next()
		let dy = node_new(TX_DYN, pos)
		dy[TX_A] = parse_type()
		return dy
	}
	let t = p_expect_ident()
	if streq(t[T_TEXT], cstr("chan")) != 0 {
		if p_edition1 != 0 {
			p_fail_code(pos, cstr("E090 OLD_SYNTAX"), cstr("edition 1 does not have channel types"))
		}
		let c = node_new(TX_CHAN, pos)
		c[TX_A] = parse_type()
		return c
	}
	let n = node_new(TX_NAME, pos)
	n[TX_B] = t[T_TEXT]
	if p_is(cstr(".")) != 0 {
		p_next()
		n[TX_A] = t[T_TEXT]
		n[TX_B] = p_expect_ident()[T_TEXT]
	}
	if p_is(cstr("[")) != 0 && p_legacy == 0 {
		p_next()
		let args = vec_new()
		for p_is(cstr("]")) == 0 {
			vec_push(args, parse_type())
			if p_is(cstr(",")) == 0 {
				break
			}
			p_next()
		}
		p_expect(cstr("]"))
		n[TX_ARGS] = args
	}
	return n
}

// parse_tparams reads [T constraints.Any, U i64 | f64] into f's (or a type decl's) names and constraints.
fn parse_tparams(names i64, cons i64) {
	p_expect(cstr("["))
	for p_is(cstr("]")) == 0 {
		vec_push(names, p_expect_ident()[T_TEXT])
		mut c = 0
		if p_is(cstr(",")) == 0 && p_is(cstr("]")) == 0 {
			let first = parse_type()
			c = parse_type_union(first)
		}
		vec_push(cons, c)
		if p_is(cstr(",")) == 0 {
			break
		}
		p_next()
	}
	p_expect(cstr("]"))
}

// parse_type_union reads the rest of a `A | B | C` union after its first member. A
// generic type parameter's constraint and a shape's named union are one grammar.
fn parse_type_union(first i64) i64 {
	let c = vec_new()
	vec_push(c, first)
	for p_is(cstr("|")) != 0 {
		p_next()
		vec_push(c, parse_type())
	}
	return c
}

// parse_struct_attr reads the checked JSON field-name attribute.
fn parse_struct_attr(pos i64) i64 {
	p_expect(cstr("@"))
	let name = p_expect_ident()[T_TEXT]
	if streq(name, cstr("json")) == 0 {
		p_fail_code(pos, cstr("E041 UNKNOWN_ATTRIBUTE"), cstr("unknown struct attribute; supported attributes are @json(\"name\")"))
	}
	p_expect(cstr("("))
	let value = p_next()
	if value[T_KIND] != TK_STRING {
		p_fail_code(pos, cstr("E042 ATTRIBUTE_ARGS"), cstr("@json expects one string field name"))
	}
	p_expect(cstr(")"))
	return value[T_TEXT]
}

// parse_struct_body reads { a, b int; c string } into a vec of [name, type expr, json name].
// parse_enum_body reads enum { A(x T, y U), B, C }: a struct underneath, with a hidden tag
// field ($tag, the variant's index) and each variant's fields named Variant.field.
fn parse_enum_body(pos i64) i64 {
	let st = node_new(TX_STRUCT, pos)
	let fields = vec_new()
	let variants = vec_new()
	let tag = vec_new()
	vec_push(tag, cstr("$tag"))
	let tt = node_new(TX_NAME, pos)
	tt[TX_B] = cstr("i64")
	vec_push(tag, tt)
	vec_push(fields, tag)
	p_expect(cstr("{{"))
	for p_is(cstr("}}")) == 0 {
		if p_is(cstr(";")) != 0 || p_is(cstr(",")) != 0 {
			p_next()
			continue
		}
		let vname = p_expect_ident()[T_TEXT]
		let first = fields[VEC_LEN]
		if p_is(cstr("(")) != 0 {
			p_next()
			if p_edition1 != 0 && enum_fields_named() == 0 {
				mut field_index = 0
				for p_is(cstr(")")) == 0 {
					let ty = parse_type()
					let f = vec_new()
					vec_push(f, enum_field_name(vname, field_index))
					vec_push(f, ty)
					vec_push(fields, f)
					field_index = field_index + 1
					if p_is(cstr(",")) == 0 {
						break
					}
					p_next()
				}
			} else {
				mut pending = vec_new()
				for p_is(cstr(")")) == 0 {
					vec_push(pending, p_expect_ident()[T_TEXT])
					if p_is(cstr(",")) != 0 {
						p_next()
						continue
					}
					let ty = parse_type()
					mut i = 0
					for i < pending[VEC_LEN] {
						let f = vec_new()
						vec_push(f, str_cat3(vname, cstr("."), vec_get(pending, i)))
						vec_push(f, ty)
						vec_push(fields, f)
						i = i + 1
					}
					pending = vec_new()
					if p_is(cstr(",")) != 0 {
						p_next()
					}
				}
				if pending[VEC_LEN] > 0 {
					p_fail_code(pos, cstr("E044 ENUM_FIELD_TYPES"), cstr("an enum variant's fields need types: Variant(name Type, ...)"))
				}
			}
			p_next()
		}
		let v = vec_new()
		vec_push(v, vname)
		vec_push(v, first)
		vec_push(v, fields[VEC_LEN] - first)
		vec_push(variants, v)
	}
	p_next()
	if variants[VEC_LEN] == 0 {
		p_fail_code(pos, cstr("E045 EMPTY_ENUM"), cstr("an enum needs at least one variant"))
	}
	st[TX_A] = fields
	st[TX_B] = variants
	return st
}

// enum_fields_named reports a variant whose fields have names (Circle(r f64), Rect(w, h f64)),
// which edition 1 reads as edition 0 does: some field is a name followed by its type. Positional
// fields (Failed(str, i64)) are types alone.
fn enum_fields_named() i64 {
	mut depth = 0
	mut i = p_i
	for i + 1 < p_toks[VEC_LEN] {
		let t = vec_get(p_toks, i)
		if tok_is(t, cstr("(")) != 0 || tok_is(t, cstr("[")) != 0 {
			depth = depth + 1
		} else if tok_is(t, cstr(")")) != 0 || tok_is(t, cstr("]")) != 0 {
			if depth == 0 {
				return 0
			}
			depth = depth - 1
		} else if depth == 0 && t[T_KIND] == TK_IDENT {
			let n = vec_get(p_toks, i + 1)
			if n[T_KIND] == TK_IDENT || tok_is(n, cstr("[")) != 0 || tok_is(n, cstr("?")) != 0 || n[T_KIND] == TK_KEYWORD {
				let prev = vec_get(p_toks, i - 1)
				if tok_is(prev, cstr("(")) != 0 || tok_is(prev, cstr(",")) != 0 {
					return 1
				}
			}
		}
		i = i + 1
	}
	return 0
}

fn enum_field_name(variant i64, index i64) i64 {
	let out = buf_new()
	buf_str(out, variant)
	buf_str(out, cstr(".$"))
	let digits = buf_new()
	mut value = index
	if value == 0 {
		buf_byte(digits, '0')
	} else {
		for value > 0 {
			buf_byte(digits, '0' + value % 10)
			value = value / 10
		}
	}
	mut i = digits[VEC_LEN] - 1
	for i >= 0 {
		buf_byte(out, i64(load8(digits[VEC_DATA] + i)))
		i = i - 1
	}
	buf_byte(out, 0)
	return out[VEC_DATA]
}

fn parse_struct_body(pos i64) i64 {
	let st = node_new(TX_STRUCT, pos)
	let fields = vec_new()
	p_expect(cstr("{{"))
	for p_is(cstr("}}")) == 0 {
		if p_is(cstr(";")) != 0 {
			p_next()
			continue
		}
		mut attrs = 0
		if p_edition1 != 0 && p_is(cstr("@")) != 0 {
			attrs = parse_attributes()
		}
		let names = vec_new()
		vec_push(names, p_expect_ident()[T_TEXT])
		for p_is(cstr(",")) != 0 {
			p_next()
			vec_push(names, p_expect_ident()[T_TEXT])
		}
		let ty = parse_type()
		mut attr = 0
		if p_edition1 != 0 {
			attr = struct_json_attr(attrs, pos)
		} else if p_is(cstr("@")) != 0 {
			attr = parse_struct_attr(pos)
		}
		mut i = 0
		for i < names[VEC_LEN] {
			let f = vec_new()
			vec_push(f, vec_get(names, i))
			vec_push(f, ty)
			vec_push(f, attr)
			if p_edition1 != 0 {
				vec_push(f, attrs)
			}
			vec_push(fields, f)
			i = i + 1
		}
		p_end()
	}
	p_next()
	st[TX_A] = fields
	return st
}

fn struct_json_attr(attrs i64, pos i64) i64 {
	if attrs == 0 {
		return 0
	}
	mut i = 0
	for i < attrs[VEC_LEN] {
		let attr = vec_get(attrs, i)
		if streq(vec_get(attr, 1), cstr("json")) == 0 {
			p_fail_code(vec_get(attr, 0), cstr("E041 UNKNOWN_ATTRIBUTE"), cstr("unknown struct attribute; supported attributes are @json(\"name\")"))
		}
		if streq(vec_get(attr, 1), cstr("json")) != 0 {
			let args = vec_get(attr, 2)
			if args[VEC_LEN] != 1 || vec_get(args, 0)[N_KIND] != EX_STR {
				p_fail_code(pos, cstr("E042 ATTRIBUTE_ARGS"), cstr("@json expects one string field name"))
			}
			return vec_get(args, 0)[STR_PTR]
		}
		i = i + 1
	}
	return 0
}

// parse_type_list reads (T1, T2) or (a T1, b T2) and returns the types.
shared mut ptl_muts i64 // parse_type_list: bit i set when parameter i was written `mut T`

fn parse_type_list() i64 {
	let types = vec_new()
	p_expect(cstr("("))
	for p_is(cstr(")")) == 0 {
		if p_is(cstr("...")) != 0 {
			p_next()
		}
		let t2 = p_peek2()
		if p_peek()[T_KIND] == TK_IDENT && tok_is(t2, cstr(",")) == 0 && tok_is(t2, cstr(")")) == 0 && tok_is(t2, cstr(".")) == 0 && p_is(cstr("mut")) == 0 {
			p_next()
		}
		if p_is(cstr("mut")) != 0 {
			p_next()
			ptl_muts = ptl_muts | (1 << types[VEC_LEN])
		}
		vec_push(types, parse_type())
		if p_is(cstr(",")) == 0 {
			break
		}
		p_next()
	}
	p_expect(cstr(")"))
	return types
}

// parse_results reads a func's result types: none, T, or (T1, T2) with optional names.
fn parse_results() i64 {
	if p_is(cstr("!")) != 0 {
		// !T, !(A, B) or ! alone: the results, then a fault.
		let bpos = p_next()[T_POS]
		p_bangres = 1
		mut br = vec_new()
		if p_is(cstr("(")) != 0 {
			br = parse_type_list()
		} else if starts_type() != 0 && p_is(cstr("{{")) == 0 {
			vec_push(br, parse_type())
		}
		let ft = node_new(TX_NAME, bpos)
		ft[TX_B] = cstr("fault")
		vec_push(br, ft)
		return br
	}
	if p_is(cstr("(")) != 0 {
		return parse_type_list()
	}
	let r = vec_new()
	if p_is(cstr("mut")) != 0 {
		p_next()
		p_mutres = 1
	}
	if starts_type() != 0 && p_is(cstr("{{")) == 0 {
		vec_push(r, parse_type())
	}
	return r
}

// ---- declarations ----
// parse_fn reads fn/func declarations: receiver, grouped typed params, results, body.
fn parse_fn(is_extern i64, legacy i64) i64 {
	let at = p_i
	let pos = p_next()[T_POS]
	let f = fn_new(pos, 0)
	f[F_TOKS] = p_toks
	f[F_TOKAT] = at
	f[F_EXTERN] = is_extern
	f[F_LEGACY] = legacy
	if legacy == 0 && p_is(cstr("(")) != 0 {
		p_next()
		f[F_RECVNAME] = p_expect_ident()[T_TEXT]
		if p_is(cstr("mut")) != 0 {
			p_next()
			f[F_RECVMUT] = 1
		}
		f[F_RECV] = parse_type()
		p_expect(cstr(")"))
	}
	f[F_NAME] = p_expect_ident()[T_TEXT]
	if legacy == 0 && p_is(cstr("[")) != 0 {
		f[F_TPARAMS] = vec_new()
		f[F_TCONS] = vec_new()
		parse_tparams(f[F_TPARAMS], f[F_TCONS])
	}
	// A method of a generic type is generic over the type's parameters.
	let rx = f[F_RECV]
	if rx != 0 && rx[N_KIND] == TX_NAME && rx[TX_ARGS] != 0 {
		if f[F_TPARAMS] == 0 {
			f[F_TPARAMS] = vec_new()
			f[F_TCONS] = vec_new()
		}
		mut ri = 0
		for ri < rx[TX_ARGS][VEC_LEN] {
			let a = vec_get(rx[TX_ARGS], ri)
			if a[N_KIND] != TX_NAME || a[TX_A] != 0 || a[TX_ARGS] != 0 {
				p_fail_code(pos, cstr("E506 RECEIVER_TYPE_PARAMS"), cstr("a method's receiver lists its type's parameters by name, like (s Stack[T])"))
			}
			vec_push(f[F_TPARAMS], a[TX_B])
			vec_push(f[F_TCONS], 0)
			ri = ri + 1
		}
	}
	parse_params(f)
	p_mutres = 0
	p_bangres = 0
	if legacy != 0 {
		let int_t = node_new(TX_NAME, pos)
		int_t[TX_B] = cstr("int")
		vec_push(f[F_RTYPES], int_t)
	} else {
		f[F_RTYPES] = parse_results()
		f[F_MUTRES] = p_mutres
		f[F_BANG] = p_bangres
	}
	if is_extern != 0 {
		p_end()
		return f
	}
	let saved = p_legacy
	p_legacy = legacy
	f[F_BODY] = parse_block()
	p_legacy = saved
	return f
}

fn parse_params(f i64) {
	p_expect(cstr("("))
	mut pending = 0
	for p_is(cstr(")")) == 0 {
		if p_is(cstr("...")) != 0 {
			p_next()
			f[F_VARIADIC] = 1
			if p_is(cstr(")")) == 0 {
				parse_type()
			}
			break
		}
		if p_word(cstr("dyn")) != 0 && p_peek2()[T_KIND] == TK_IDENT {
			// `dyn W` where a parameter name belongs: a dyn parameter needs a name.
			p_fail_code(p_peek()[T_POS], cstr("E515 DYN_PARAM_NAME"), cstr("a parameter of type dyn S needs a name: write w dyn S"))
		}
		vec_push(f[F_PARAMS], p_expect_ident()[T_TEXT])
		vec_push(f[F_PTYPES], 0)
		vec_push(f[F_MUTS], 0)
		pending = pending + 1
		if p_is(cstr(",")) == 0 && p_is(cstr(")")) == 0 {
			if p_is(cstr("...")) != 0 {
				p_next()
				f[F_VARIADIC] = 1
			}
			mut ismut = 0
			if p_is(cstr("mut")) != 0 {
				p_next()
				ismut = 1
			}
			let ty = parse_type()
			mut i = f[F_PTYPES][VEC_LEN] - pending
			for i < f[F_PTYPES][VEC_LEN] {
				f[F_PTYPES][VEC_DATA][i] = ty
				f[F_MUTS][VEC_DATA][i] = ismut
				i = i + 1
			}
			pending = 0
		}
		if p_is(cstr(",")) == 0 {
			break
		}
		p_next()
	}
	p_expect(cstr(")"))
}

// ---- statements ----
fn parse_block() i64 {
	let b = node_new(ST_BLOCK, p_expect(cstr("{{"))[T_POS])
	b[BLK_STMTS] = vec_new()
	for p_is(cstr("}}")) == 0 {
		if p_peek()[T_KIND] == TK_EOF {
			p_fail_code(p_peek()[T_POS], cstr("E020 UNEXPECTED"), cstr("expected '}}', found end of file"))
		}
		let s = parse_stmt()
		if s[N_KIND] == ST_LIST {
			mut i = 0
			for i < s[LIST_STMTS][VEC_LEN] {
				vec_push(b[BLK_STMTS], vec_get(s[LIST_STMTS], i))
				i = i + 1
			}
		} else if s[N_KIND] != ST_BLOCK || s[BLK_STMTS][VEC_LEN] > 0 || s[N_POS] != 0 {
			vec_push(b[BLK_STMTS], s)
		}
	}
	p_next()
	return b
}

fn empty_block(pos i64) i64 {
	let b = node_new(ST_BLOCK, pos)
	b[BLK_STMTS] = vec_new()
	return b
}

fn parse_stmt() i64 {
	let pos = p_peek()[T_POS]
	if p_is(cstr(";")) != 0 {
		p_next()
		return empty_block(0)
	}
	if p_edition1 != 0 && p_peek()[T_KIND] == TK_IDENT && tok_is(p_peek2(), cstr(":")) != 0 {
		let label = p_next()[T_TEXT]
		p_next()
		if p_is(cstr("for")) == 0 {
			p_fail_found_code(p_peek()[T_POS], cstr("E050 LABEL_PLACEMENT"), cstr("a label must precede a loop"), p_peek())
		}
		p_pending_label = label
		return parse_for()
	}
	if p_is(cstr("let")) != 0 {
		p_next()
		return parse_binding(pos, 0)
	}
	if p_edition1 != 0 && p_is(cstr("mut")) != 0 {
		p_next()
		return parse_binding(pos, 1)
	}
	if p_edition1 != 0 && p_word(cstr("use")) != 0 && p_peek2()[T_KIND] == TK_IDENT && tok_is(p_peek3(), cstr("=")) != 0 {
		return parse_use_decl()
	}
	if p_edition1 != 0 && p_word(cstr("scope")) != 0 && p_peek2()[T_KIND] == TK_IDENT && tok_is(p_peek3(), cstr("{{")) != 0 {
		p_next()
		let scope_ = node_new(ST_SCOPE, pos)
		scope_[SCOPE_NAME] = p_expect_ident()[T_TEXT]
		scope_[SCOPE_BODY] = parse_block()
		return scope_
	}
	if p_edition1 != 0 && p_word(cstr("detach")) != 0 && tok_is(p_peek2(), cstr("{{")) != 0 {
		p_next()
		let detach_ = node_new(ST_DETACH, pos)
		detach_[BODY_BLOCK] = parse_block()
		return detach_
	}
	if p_edition1 != 0 && p_word(cstr("once")) != 0 && tok_is(p_peek2(), cstr("{{")) != 0 {
		p_next()
		let once_ = node_new(ST_ONCE, pos)
		once_[BODY_BLOCK] = parse_block()
		return once_
	}
	if p_edition1 != 0 && p_word(cstr("select")) != 0 && tok_is(p_peek2(), cstr("{{")) != 0 {
		return parse_select()
	}
	if p_is(cstr("var")) != 0 {
		if p_edition1 != 0 {
			p_fail_code(pos, cstr("E090 OLD_SYNTAX"), cstr("edition 1 uses 'let' or 'mut', not 'var'"))
		}
		p_next()
		return parse_local_var(pos)
	}
	if p_is(cstr("const")) != 0 {
		if p_edition1 != 0 {
			p_fail_code(pos, cstr("E090 OLD_SYNTAX"), cstr("edition 1 allows const only at package scope"))
		}
		p_next()
		let c = node_new(ST_CONST, pos)
		c[2] = vec_new()
		parse_group(1, c[2])
		return c
	}
	if p_is(cstr("if")) != 0 {
		return parse_if()
	}
	if p_is(cstr("while")) != 0 {
		if p_edition1 != 0 {
			p_fail_code(pos, cstr("E090 OLD_SYNTAX"), cstr("edition 1 uses 'for' loops, not 'while'"))
		}
		p_next()
		let w = node_new(ST_WHILE, pos)
		let saved = p_nolit
		p_nolit = 1
		w[WH_COND] = parse_expr(1)
		p_nolit = saved
		w[WH_BODY] = parse_block()
		return w
	}
	if p_is(cstr("for")) != 0 {
		return parse_for()
	}
	if p_is(cstr("switch")) != 0 {
		if p_edition1 != 0 {
			p_fail_code(pos, cstr("E090 OLD_SYNTAX"), cstr("edition 1 uses 'match', not 'switch'"))
		}
		return parse_switch()
	}
	if p_is(cstr("return")) != 0 {
		p_next()
		let r = node_new(ST_RETURN, pos)
		if p_is(cstr(";")) == 0 && p_is(cstr("}}")) == 0 {
			let vals = parse_expr_list()
			if vals[VEC_LEN] == 1 {
				r[RET_VALUE] = vec_get(vals, 0)
			} else {
				r[RET_VALUES] = vals
			}
		}
		p_end()
		return r
	}
	if p_word(cstr("fail")) != 0 && p_legacy == 0 {
		let t2 = p_peek2()
		if tok_is(t2, cstr(":=")) == 0 && tok_is(t2, cstr("=")) == 0 && tok_is(t2, cstr(",")) == 0 && tok_is(t2, cstr(".")) == 0 {
			p_next()
			let fs = node_new(ST_FAIL, pos)
			fs[FAIL_X] = parse_expr(1)
			p_end()
			return fs
		}
	}
	if p_is(cstr("break")) != 0 {
		p_next()
		let b = node_new(ST_BREAK, pos)
		if p_edition1 != 0 && p_peek()[T_KIND] == TK_IDENT {
			b[BR_LABEL] = p_next()[T_TEXT]
		}
		p_end()
		return b
	}
	if p_is(cstr("continue")) != 0 {
		p_next()
		let c = node_new(ST_CONTINUE, pos)
		if p_edition1 != 0 && p_peek()[T_KIND] == TK_IDENT {
			c[CONT_LABEL] = p_next()[T_TEXT]
		}
		p_end()
		return c
	}
	if p_is(cstr("go")) != 0 || p_is(cstr("defer")) != 0 {
		if p_edition1 != 0 && p_is(cstr("go")) != 0 {
			p_fail_code(pos, cstr("E090 OLD_SYNTAX"), cstr("edition 1 uses 'scope' or 'detach', not 'go'"))
		}
		mut kind = ST_GO
		if p_is(cstr("defer")) != 0 {
			kind = ST_DEFER
		}
		p_next()
		let g = node_new(kind, pos)
		g[GO_CALL] = parse_expr(1)
		if g[GO_CALL][N_KIND] != EX_CALL {
			p_fail_code(pos, cstr("E055 DEFER_CALL"), cstr("expected a function call"))
		}
		p_end()
		return g
	}
	if p_is(cstr("{{")) != 0 {
		return parse_block()
	}
	let s = parse_simple_stmt(parse_expr_list())
	p_end()
	return s
}

fn parse_select() i64 {
	let select_ = node_new(ST_SELECT, p_next()[T_POS])
	select_[SELECT_ARMS] = vec_new()
	p_expect(cstr("{{"))
	for p_is(cstr("}}")) == 0 {
		if p_is(cstr(";")) != 0 {
			p_next()
			continue
		}
		let arm = vec_new()
		vec_push(arm, p_peek()[T_POS])
		mut name = 0
		if p_is(cstr("let")) != 0 {
			p_next()
			name = p_expect_ident()[T_TEXT]
			p_expect(cstr("="))
		}
		let saved = p_nolit
		p_nolit = 1
		let wait = parse_expr(1)
		p_nolit = saved
		p_expect(cstr("=>"))
		mut body = 0
		mut is_block = 0
		if p_is(cstr("{{")) != 0 {
			body = parse_block()
			is_block = 1
		} else if p_is(cstr("return")) != 0 || p_word(cstr("fail")) != 0 || p_is(cstr("break")) != 0 || p_is(cstr("continue")) != 0 {
			body = parse_stmt()
		} else {
			body = parse_expr(1)
		}
		vec_push(arm, name)
		vec_push(arm, wait)
		vec_push(arm, body)
		vec_push(arm, is_block)
		vec_push(select_[SELECT_ARMS], arm)
		if p_is(cstr(";")) != 0 {
			p_next()
		}
	}
	if select_[SELECT_ARMS][VEC_LEN] == 0 {
		p_fail_code(select_[N_POS], cstr("E051 EMPTY_SELECT"), cstr("select needs at least one arm"))
	}
	p_next()
	return select_
}

// parse_binding reads a Tin 1 let/mut declaration. The target shape is intentionally
// represented with the existing ST_LET/ST_MULTI nodes so later compiler passes share one tree.
fn parse_binding(pos i64, is_mut i64) i64 {
	if p_is(cstr("(")) != 0 {
		p_next()
		let names = vec_new()
		vec_push(names, p_expect_ident()[T_TEXT])
		for p_is(cstr(",")) != 0 {
			p_next()
			vec_push(names, p_expect_ident()[T_TEXT])
		}
		p_expect(cstr(")"))
		p_expect(cstr("="))
		let m = node_new(ST_MULTI, pos)
		m[MU_TARGETS] = idents_of(pos, names)
		m[MU_VALUES] = parse_expr_list()
		m[MU_DEFINE] = 1
		m[MU_MUT] = is_mut
		p_end()
		return m
	}
	let l = node_new(ST_LET, pos)
	l[LET_NAME] = p_expect_ident()[T_TEXT]
	if p_is(cstr("=")) == 0 {
		l[LET_TYPE] = parse_type()
	}
	if p_is(cstr("=")) != 0 {
		p_next()
		l[LET_INIT] = parse_catch(parse_expr(1))
	} else if is_mut == 0 {
		p_fail_code(pos, cstr("E020 UNEXPECTED"), cstr("expected '=': a let needs a value (a mut without one starts at its zero value)"))
	}
	l[LET_MUT] = is_mut
	p_end()
	return l
}

fn parse_local_var(pos i64) i64 {
	let names = vec_new()
	vec_push(names, p_expect_ident()[T_TEXT])
	for p_is(cstr(",")) != 0 {
		p_next()
		vec_push(names, p_expect_ident()[T_TEXT])
	}
	mut ty = 0
	if p_is(cstr("=")) == 0 {
		ty = parse_type()
	}
	mut inits = 0
	if p_is(cstr("=")) != 0 {
		p_next()
		inits = parse_expr_list()
	}
	p_end()
	if inits != 0 && inits[VEC_LEN] != names[VEC_LEN] {
		let m = node_new(ST_MULTI, pos)
		m[MU_TARGETS] = idents_of(pos, names)
		m[MU_VALUES] = inits
		m[MU_DEFINE] = 1
		return m
	}
	let list = node_new(ST_LIST, pos)
	list[LIST_STMTS] = vec_new()
	mut i = 0
	for i < names[VEC_LEN] {
		let l = node_new(ST_LET, pos)
		l[LET_NAME] = vec_get(names, i)
		l[LET_TYPE] = ty
		if inits != 0 {
			l[LET_INIT] = vec_get(inits, i)
		}
		vec_push(list[LIST_STMTS], l)
		i = i + 1
	}
	return list
}

fn idents_of(pos i64, names i64) i64 {
	let v = vec_new()
	mut i = 0
	for i < names[VEC_LEN] {
		let id = node_new(EX_IDENT, pos)
		id[ID_NAME] = vec_get(names, i)
		vec_push(v, id)
		i = i + 1
	}
	return v
}

fn parse_expr_list() i64 {
	let v = vec_new()
	vec_push(v, parse_catch(parse_expr(1)))
	for p_is(cstr(",")) != 0 {
		p_next()
		vec_push(v, parse_catch(parse_expr(1)))
	}
	return v
}

// callee_keeps_nothing reports whether a call's callee is a library function that only calls the
// function values it is given and never stores or returns them: sift's and atlas's *Func functions,
// sift.Each, Map, Filter and Reduce, and twine's *Func functions and Map.
fn callee_keeps_nothing(x i64) i64 {
	if x[N_KIND] != EX_SELECT || x[SEL_X][N_KIND] != EX_IDENT {
		return 0
	}
	let pkg = x[SEL_X][ID_NAME]
	let name = x[SEL_NAME]
	if streq(pkg, cstr("sift")) == 0 && streq(pkg, cstr("twine")) == 0 && streq(pkg, cstr("atlas")) == 0 {
		return 0
	}
	let n = strlen(name)
	if n >= 4 && streq(name + n - 4, cstr("Func")) != 0 {
		return 1
	}
	if streq(name, cstr("Each")) != 0 || streq(name, cstr("Map")) != 0 || streq(name, cstr("Filter")) != 0 || streq(name, cstr("Reduce")) != 0 {
		return 1
	}
	return 0
}

fn has_brace(p i64, n i64) i64 {
	mut i = 0
	for i < n {
		let c = i64(load8(p + i))
		if c == '{' || c == '}' {
			return 1
		}
		i = i + 1
	}
	return 0
}

fn str_node(pos i64, b i64) i64 {
	let s = node_new(EX_STR, pos)
	s[STR_LEN] = b[VEC_LEN]
	buf_byte(b, 0)
	s[STR_PTR] = b[VEC_DATA]
	return s
}

// parse_interp splits "text {x} more {y:spec}" into its text parts and values. {{ and }}
// are literal braces; spec is everything after the last top-level ':' in the braces.
fn parse_interp(t i64, pos i64) i64 {
	let p = t[T_TEXT]
	let n = t[T_VAL]
	let parts = vec_new()
	let args = vec_new()
	let specs = vec_new()
	mut cur = buf_new()
	mut i = 0
	for i < n {
		let c = i64(load8(p + i))
		if c == '{' && i + 1 < n && i64(load8(p + i + 1)) == '{' {
			buf_byte(cur, '{')
			i = i + 2
		} else if c == '}' && i + 1 < n && i64(load8(p + i + 1)) == '}' {
			buf_byte(cur, '}')
			i = i + 2
		} else if c == '}' {
			p_fail_code(pos, cstr("E030 INTERPOLATION"), cstr("a }} in a string must be written }}}} (or use a `raw` string)"))
		} else if c == '{' {
			mut j = i + 1
			mut depth = 0
			mut colon = -1
			for j < n && !(i64(load8(p + j)) == '}' && depth == 0) {
				let d = i64(load8(p + j))
				if d == '(' || d == '[' {
					depth = depth + 1
				} else if d == ')' || d == ']' {
					depth = depth - 1
				} else if d == ':' && depth == 0 {
					colon = j
				}
				j = j + 1
			}
			if j >= n {
				p_fail_code(pos, cstr("E030 INTERPOLATION"), cstr("a {{ in a string starts a value: close it with }}, or write {{{{ for a brace"))
			}
			mut ee = j
			mut spec = 0
			if colon >= 0 {
				ee = colon
				let sb = buf_new()
				mut k = colon + 1
				for k < j {
					buf_byte(sb, i64(load8(p + k)))
					k = k + 1
				}
				buf_byte(sb, 0)
				spec = sb[VEC_DATA]
			}
			vec_push(parts, str_node(pos, cur))
			cur = buf_new()
			vec_push(args, interp_expr(p + i + 1, ee - i - 1, pos))
			vec_push(specs, spec)
			i = j + 1
		} else {
			buf_byte(cur, c)
			i = i + 1
		}
	}
	vec_push(parts, str_node(pos, cur))
	if args[VEC_LEN] == 0 {
		return vec_get(parts, 0)
	}
	let e = node_new(EX_INTERP, pos)
	e[INTERP_PARTS] = parts
	e[INTERP_ARGS] = args
	e[INTERP_SPECS] = specs
	return e
}

// interp_expr parses the n bytes at p (the inside of {...} in a string) as an expression.
fn interp_expr(p i64, n i64, pos i64) i64 {
	let src = malloc(n + 1)
	memcpy(src, p, n)
	store8(src + n, 0)
	let toks = lex(0, src, n, p_edition1)
	mut j = 0
	for j < toks[VEC_LEN] {
		vec_get(toks, j)[T_POS] = pos
		j = j + 1
	}
	let saved_toks = p_toks
	let saved_i = p_i
	p_toks = toks
	p_i = 0
	if p_is(cstr(";")) != 0 || p_peek()[T_KIND] == TK_EOF {
		p_fail_code(pos, cstr("E030 INTERPOLATION"), cstr("empty {{}} in a string: write {{{{}}}} for braces"))
	}
	let x = parse_expr(1)
	if p_is(cstr(";")) != 0 {
		p_next()
	}
	if p_peek()[T_KIND] != TK_EOF {
		p_fail_code(pos, cstr("E030 INTERPOLATION"), cstr("unexpected text inside {{...}} in a string: it holds one value (write {{{{ for a brace, or use a `raw` string)"))
	}
	p_toks = saved_toks
	p_i = saved_i
	return x
}

// parse_catch reads an optional `catch name { ... }` after x (strict code only).
fn parse_catch(x i64) i64 {
	if p_word(cstr("catch")) == 0 || p_legacy != 0 {
		return parse_wrap(x)
	}
	let c = node_new(EX_CATCH, p_next()[T_POS])
	c[CATCH_X] = x
	c[CATCH_NAME] = p_expect_ident()[T_TEXT]
	c[CATCH_BODY] = parse_block()
	return parse_wrap(c)
}

fn parse_wrap(x i64) i64 {
	if p_edition1 == 0 || p_word(cstr("wrap")) == 0 {
		return x
	}
	let pos = p_next()[T_POS]
	if p_peek()[T_KIND] != TK_STRING {
		p_fail_found_code(p_peek()[T_POS], cstr("E020 UNEXPECTED"), cstr("wrap expects a string message"), p_peek())
	}
	let msg = parse_primary()
	if msg[N_KIND] != EX_STR && msg[N_KIND] != EX_INTERP {
		p_fail_code(pos, cstr("E020 UNEXPECTED"), cstr("wrap expects a string message"))
	}
	let w = node_new(EX_WRAP, pos)
	w[WRAP_X] = x
	w[WRAP_MESSAGE] = msg
	return w
}

fn is_assign_op(t i64) i64 {
	if t[T_KIND] != TK_PUNCT {
		return 0
	}
	let s = t[T_TEXT]
	let n = strlen(s)
	return i64(n >= 2 && i64(load8(s + n - 1)) == '=' && streq(s, cstr("==")) == 0 && streq(s, cstr("!=")) == 0 && streq(s, cstr("<=")) == 0 && streq(s, cstr(">=")) == 0 && streq(s, cstr(":=")) == 0)
}

// parse_simple_stmt finishes a statement that starts with the expression list xs.
fn parse_simple_stmt(xs i64) i64 {
	let x = vec_get(xs, 0)
	let pos = x[N_POS]
	if p_is(cstr(":=")) != 0 || (p_is(cstr("=")) != 0 && xs[VEC_LEN] > 1) {
		if p_edition1 != 0 && p_is(cstr(":=")) != 0 {
			p_fail_code(pos, cstr("E090 OLD_SYNTAX"), cstr("edition 1 uses 'let' or 'mut', not ':='"))
		}
		let define = p_is(cstr(":="))
		p_next()
		let vals = parse_expr_list()
		if define != 0 && xs[VEC_LEN] == 1 && vals[VEC_LEN] == 1 {
			if x[N_KIND] != EX_IDENT {
				p_fail_code(pos, cstr("E020 UNEXPECTED"), cstr("expected a name before :="))
			}
			let l = node_new(ST_LET, pos)
			l[LET_NAME] = x[ID_NAME]
			l[LET_INIT] = vec_get(vals, 0)
			return l
		}
		let m = node_new(ST_MULTI, pos)
		m[MU_TARGETS] = xs
		m[MU_VALUES] = vals
		m[MU_DEFINE] = define
		return m
	}
	if xs[VEC_LEN] > 1 {
		p_fail_found_code(p_peek()[T_POS], cstr("E020 UNEXPECTED"), cstr("expected := or ="), p_peek())
	}
	if p_is(cstr("=")) != 0 {
		p_next()
		let a = node_new(ST_ASSIGN, pos)
		a[AS_TARGET] = x
		a[AS_VALUE] = parse_catch(parse_expr(1))
		return a
	}
	if is_assign_op(p_peek()) != 0 {
		// x op= e  is  x = x op e  (the target is evaluated twice).
		let t = p_next()[T_TEXT]
		let a = node_new(ST_ASSIGN, pos)
		a[AS_TARGET] = x
		a[AS_VALUE] = binary_new(pos, str_slice(t, strlen(t) - 1), x, parse_expr(1))
		return a
	}
	if p_is(cstr("++")) != 0 || p_is(cstr("--")) != 0 {
		if p_edition1 != 0 {
			p_fail_code(pos, cstr("E090 OLD_SYNTAX"), cstr("edition 1 uses '+= 1' or '-= 1', not '++' or '--'"))
		}
		mut op = cstr("+")
		if p_is(cstr("--")) != 0 {
			op = cstr("-")
		}
		p_next()
		let one = node_new(EX_INT, pos)
		one[INT_VAL] = 1
		let inc = node_new(ST_ASSIGN, pos)
		inc[AS_TARGET] = x
		inc[AS_VALUE] = binary_new(pos, op, x, one)
		return inc
	}
	let s = node_new(ST_EXPR, pos)
	s[ES_X] = x
	return s
}

fn binary_new(pos i64, op i64, l i64, r i64) i64 {
	let b = node_new(EX_BINARY, pos)
	b[BIN_OP] = op
	b[BIN_L] = l
	b[BIN_R] = r
	return b
}

fn parse_if() i64 {
	let s = node_new(ST_IF, p_expect(cstr("if"))[T_POS])
	let saved = p_nolit
	p_nolit = 1
	if p_edition1 != 0 && p_is(cstr("let")) != 0 {
		p_next()
		let binding = node_new(ST_LET, s[N_POS])
		binding[LET_NAME] = p_expect_ident()[T_TEXT]
		p_expect(cstr("="))
		binding[LET_INIT] = parse_expr(1)
		binding[LET_MUT] = 0
		s[IF_INIT] = binding
		let id = node_new(EX_IDENT, s[N_POS])
		id[ID_NAME] = binding[LET_NAME]
		s[IF_COND] = binary_new(s[N_POS], cstr("!="), id, node_new(EX_NIL, s[N_POS]))
	} else {
		let first = parse_simple_stmt(parse_expr_list())
		if p_is(cstr(";")) != 0 {
			p_next()
			s[IF_INIT] = first
			s[IF_COND] = parse_expr(1)
		} else {
			if first[N_KIND] != ST_EXPR {
				p_fail_code(first[N_POS], cstr("E020 UNEXPECTED"), cstr("expected a condition"))
			}
			s[IF_COND] = first[ES_X]
		}
	}
	p_nolit = saved
	s[IF_THEN] = parse_block()
	if p_is(cstr("else")) != 0 {
		p_next()
		if p_is(cstr("if")) != 0 {
			s[IF_ELSE] = parse_if()
		} else {
			s[IF_ELSE] = parse_block()
		}
	}
	return s
}

fn true_node(pos i64) i64 {
	let t = node_new(EX_IDENT, pos)
	t[ID_NAME] = cstr("true")
	return t
}

fn parse_for() i64 {
	if p_edition1 != 0 {
		return parse_for_edition1()
	}
	let pos = p_expect(cstr("for"))[T_POS]
	let w = node_new(ST_WHILE, pos)
	if p_is(cstr("{{")) != 0 {
		w[WH_COND] = true_node(pos)
		w[WH_BODY] = parse_block()
		return w
	}
	let saved = p_nolit
	p_nolit = 1
	if p_is(cstr("range")) != 0 {
		p_next()
		let r = node_new(ST_RANGE, pos)
		r[RG_EXPR] = parse_expr(1)
		p_nolit = saved
		r[RG_BODY] = parse_block()
		return r
	}
	mut init = 0
	if p_is(cstr(";")) == 0 {
		let xs = parse_expr_list()
		if (p_is(cstr(":=")) != 0 || p_is(cstr("=")) != 0) && tok_is(p_peek2(), cstr("range")) != 0 {
			let r = node_new(ST_RANGE, pos)
			r[RG_DEFINE] = p_is(cstr(":="))
			p_next()
			p_next()
			r[RG_KEY] = vec_get(xs, 0)
			if xs[VEC_LEN] > 1 {
				r[RG_VAL] = vec_get(xs, 1)
			}
			r[RG_EXPR] = parse_expr(1)
			p_nolit = saved
			r[RG_BODY] = parse_block()
			return r
		}
		if p_is(cstr("{{")) != 0 && xs[VEC_LEN] == 1 {
			w[WH_COND] = vec_get(xs, 0)
			p_nolit = saved
			w[WH_BODY] = parse_block()
			return w
		}
		init = parse_simple_stmt(xs)
	}
	p_expect(cstr(";"))
	w[WH_INIT] = init
	if p_is(cstr(";")) != 0 {
		w[WH_COND] = true_node(pos)
	} else {
		w[WH_COND] = parse_expr(1)
	}
	p_expect(cstr(";"))
	if p_is(cstr("{{")) == 0 {
		w[WH_POST] = parse_simple_stmt(parse_expr_list())
	}
	p_nolit = saved
	w[WH_BODY] = parse_block()
	return w
}

// parse_for_edition1 lowers each of Tin 1's four loop forms into the existing range/while
// nodes. Integer ranges use the same init/condition/post shape as a C-style loop, which keeps
// the bounds proof and code generation on their existing path.
fn parse_for_edition1() i64 {
	let pos = p_expect(cstr("for"))[T_POS]
	let label = p_pending_label
	p_pending_label = 0
	if p_is(cstr("{{")) != 0 {
		let forever = node_new(ST_WHILE, pos)
		forever[WH_COND] = true_node(pos)
		forever[WH_BODY] = parse_block()
		forever[WH_LABEL] = label
		return forever
	}
	let saved = p_nolit
	p_nolit = 1
	if p_peek()[T_KIND] == TK_IDENT && (p_word_at(1, cstr("in")) != 0 || tok_is(p_peek2(), cstr(",")) != 0) {
		let names = vec_new()
		vec_push(names, p_expect_ident()[T_TEXT])
		for p_is(cstr(",")) != 0 {
			p_next()
			vec_push(names, p_expect_ident()[T_TEXT])
		}
		if p_word(cstr("in")) == 0 {
			p_fail_found_code(p_peek()[T_POS], cstr("E020 UNEXPECTED"), cstr("expected 'in' after loop binding"), p_peek())
		}
		p_next()
		p_range_expr = 1
		let src = parse_expr(1)
		p_range_expr = 0
		p_nolit = saved // the body allows composite literals again
		let body = parse_block()
		p_nolit = saved
		if src[N_KIND] == EX_BINARY && streq(src[BIN_OP], cstr("..")) != 0 {
			if names[VEC_LEN] != 1 {
				p_fail_code(pos, cstr("E052 RANGE_LOOP"), cstr("an integer range loop has one binding"))
			}
			let loop_ = make_index_loop(pos, vec_get(names, 0), src, 0, body)
			loop_[WH_LABEL] = label
			return loop_
		}
		if src[N_KIND] == EX_CALL && src[CALL_CALLEE] != 0 && src[CALL_CALLEE][N_KIND] == EX_SELECT && streq(src[CALL_CALLEE][SEL_NAME], cstr("step")) != 0 {
			let range_expr = src[CALL_CALLEE][SEL_X]
			if range_expr[N_KIND] == EX_BINARY && streq(range_expr[BIN_OP], cstr("..")) != 0 {
				if names[VEC_LEN] != 1 || src[CALL_ARGS][VEC_LEN] != 1 {
					p_fail_code(pos, cstr("E052 RANGE_LOOP"), cstr("a stepped integer range needs one binding and one step"))
				}
				let loop_ = make_index_loop(pos, vec_get(names, 0), range_expr, vec_get(src[CALL_ARGS], 0), body)
				loop_[WH_LABEL] = label
				return loop_
			}
		}
		let r = node_new(ST_RANGE, pos)
		if names[VEC_LEN] > 1 {
			r[RG_KEY] = node_new(EX_IDENT, pos)
			r[RG_KEY][ID_NAME] = vec_get(names, 0)
			r[RG_VAL] = node_new(EX_IDENT, pos)
			r[RG_VAL][ID_NAME] = vec_get(names, 1)
		} else {
			r[RG_VAL] = node_new(EX_IDENT, pos)
			r[RG_VAL][ID_NAME] = vec_get(names, 0)
		}
		r[RG_DEFINE] = 1
		r[RG_EXPR] = src
		r[RG_BODY] = body
		r[RG_LABEL] = label
		return r
	}
	let w = node_new(ST_WHILE, pos)
	p_range_expr = 0
	w[WH_COND] = parse_expr(1)
	p_nolit = saved
	w[WH_BODY] = parse_block()
	p_nolit = saved
	w[WH_LABEL] = label
	return w
}

fn parse_boundary() i64 {
	let pos = p_peek()[T_POS]
	let word = p_next()[T_TEXT]
	let boundary = node_new(EX_BOUNDARY, pos)
	boundary[BOUND_ARGS] = vec_new()
	if streq(word, cstr("within")) != 0 {
		boundary[BOUND_KIND] = BOUND_WITHIN
		let saved = p_nolit
		p_nolit = 1
		vec_push(boundary[BOUND_ARGS], parse_expr(1))
		p_nolit = saved
	} else if streq(word, cstr("limit")) != 0 {
		boundary[BOUND_KIND] = BOUND_LIMIT
		for p_is(cstr("{{")) == 0 {
			let item = vec_new()
			vec_push(item, p_expect_ident()[T_TEXT])
			vec_push(item, parse_expr(1))
			vec_push(boundary[BOUND_ARGS], item)
			if p_is(cstr(",")) == 0 {
				break
			}
			p_next()
		}
		if boundary[BOUND_ARGS][VEC_LEN] == 0 {
			p_fail_code(pos, cstr("E020 UNEXPECTED"), cstr("limit needs at least one bound"))
		}
	} else if streq(word, cstr("guard")) != 0 {
		boundary[BOUND_KIND] = BOUND_GUARD
		if p_is(cstr("{{")) == 0 {
			// guard CALL (#142): the guard block { CALL } on one call.
			let call = parse_unary()
			mut inner = call
			if inner[N_KIND] == EX_TRY {
				inner = inner[TRY_X]
			}
			if inner[N_KIND] != EX_CALL {
				p_fail_code(call[N_POS], cstr("E020 UNEXPECTED"), cstr("guard needs a block or a call"))
			}
			let st = node_new(ST_EXPR, call[N_POS])
			st[ES_X] = call
			boundary[BOUND_BODY] = empty_block(call[N_POS])
			vec_push(boundary[BOUND_BODY][BLK_STMTS], st)
			return boundary
		}
	} else if streq(word, cstr("arena")) != 0 {
		boundary[BOUND_KIND] = BOUND_ARENA
	} else if streq(word, cstr("parallel")) != 0 {
		boundary[BOUND_KIND] = BOUND_PARALLEL
	} else {
		boundary[BOUND_KIND] = BOUND_WITH
		let saved2 = p_nolit
		p_nolit = 1
		vec_push(boundary[BOUND_ARGS], parse_expr(1))
		p_nolit = saved2
	}
	if p_is(cstr("{{")) == 0 {
		p_fail_found_code(p_peek()[T_POS], cstr("E020 UNEXPECTED"), cstr("expected a boundary block"), p_peek())
	}
	boundary[BOUND_BODY] = parse_block()
	return boundary
}

fn starts_boundary() i64 {
	if p_edition1 == 0 {
		return 0
	}
	if p_word(cstr("guard")) != 0 && (p_peek2()[T_KIND] == TK_IDENT || tok_is(p_peek2(), cstr("try")) != 0) {
		// guard CALL (#142).
		return 1
	}
	if p_word(cstr("guard")) != 0 || p_word(cstr("arena")) != 0 || p_word(cstr("parallel")) != 0 {
		return tok_is(p_peek2(), cstr("{{"))
	}
	if p_word(cstr("limit")) != 0 {
		return i64(p_peek2()[T_KIND] == TK_IDENT)
	}
	if p_word(cstr("within")) != 0 {
		return i64(p_peek2()[T_KIND] != TK_EOF && tok_is(p_peek2(), cstr("(")) == 0 && tok_is(p_peek2(), cstr(";")) == 0 && tok_is(p_peek2(), cstr("}}")) == 0)
	}
	if p_word(cstr("with")) != 0 {
		if p_peek2()[T_KIND] == TK_IDENT {
			return 1
		}
		if tok_is(p_peek2(), cstr("(")) != 0 {
			return with_parens_followed_by_block()
		}
	}
	return 0
}

fn with_parens_followed_by_block() i64 {
	mut depth = 0
	mut i = p_i + 1
	for i < p_toks[VEC_LEN] {
		let t = vec_get(p_toks, i)
		if tok_is(t, cstr("(")) != 0 {
			depth = depth + 1
		} else if tok_is(t, cstr(")")) != 0 {
			depth = depth - 1
			if depth == 0 {
				return i64(i + 1 < p_toks[VEC_LEN] && tok_is(vec_get(p_toks, i + 1), cstr("{{")) != 0)
			}
		}
		i = i + 1
	}
	return 0
}

fn p_word_at(off i64, text i64) i64 {
	mut t = p_peek()
	if off == 1 {
		t = p_peek2()
	} else if off == 2 {
		t = p_peek3()
	}
	return i64(t[T_KIND] == TK_IDENT && streq(t[T_TEXT], text) != 0)
}

fn p_peek3() i64 {
	if p_i + 2 < p_toks[VEC_LEN] {
		return vec_get(p_toks, p_i + 2)
	}
	return p_peek2()
}

fn make_index_loop(pos i64, name i64, range_expr i64, step i64, body i64) i64 {
	let start = range_expr[BIN_L]
	let end = range_expr[BIN_R]
	let loop_ = node_new(ST_WHILE, pos)
	let init = node_new(ST_LET, pos)
	init[LET_NAME] = name
	init[LET_INIT] = start
	init[LET_MUT] = 1
	loop_[WH_INIT] = init
	let id = node_new(EX_IDENT, pos)
	id[ID_NAME] = name
	loop_[WH_COND] = binary_new(pos, cstr("<"), id, end)
	let next = node_new(EX_IDENT, pos)
	next[ID_NAME] = name
	mut by = step
	if by == 0 {
		by = node_new(EX_INT, pos)
		by[INT_VAL] = 1
	}
	let post = node_new(ST_ASSIGN, pos)
	let target = node_new(EX_IDENT, pos)
	target[ID_NAME] = name
	post[AS_TARGET] = target
	post[AS_VALUE] = binary_new(pos, cstr("+"), next, by)
	loop_[WH_POST] = post
	loop_[WH_BODY] = body
	return loop_
}

fn parse_switch() i64 {
	let s = node_new(ST_SWITCH, p_expect(cstr("switch"))[T_POS])
	let saved = p_nolit
	p_nolit = 1
	if p_is(cstr("{{")) == 0 {
		let first = parse_simple_stmt(parse_expr_list())
		if p_is(cstr(";")) != 0 {
			p_next()
			s[SW_INIT] = first
			if p_is(cstr("{{")) == 0 {
				s[SW_TAG] = parse_expr(1)
			}
		} else {
			if first[N_KIND] != ST_EXPR {
				p_fail_code(first[N_POS], cstr("E020 UNEXPECTED"), cstr("expected a switch tag"))
			}
			s[SW_TAG] = first[ES_X]
		}
	}
	p_nolit = saved
	p_expect(cstr("{{"))
	let cases = vec_new()
	for p_is(cstr("}}")) == 0 {
		if p_is(cstr(";")) != 0 {
			p_next()
			continue
		}
		let c = vec_new()
		let cpos = p_peek()[T_POS]
		if p_is(cstr("case")) != 0 {
			p_next()
			vec_push(c, parse_expr_list())
		} else {
			p_expect(cstr("default"))
			vec_push(c, 0)
		}
		p_expect(cstr(":"))
		let body = empty_block(cpos)
		for p_is(cstr("case")) == 0 && p_is(cstr("default")) == 0 && p_is(cstr("}}")) == 0 {
			let st = parse_stmt()
			if st[N_KIND] == ST_LIST {
				mut i = 0
				for i < st[LIST_STMTS][VEC_LEN] {
					vec_push(body[BLK_STMTS], vec_get(st[LIST_STMTS], i))
					i = i + 1
				}
			} else {
				vec_push(body[BLK_STMTS], st)
			}
		}
		vec_push(c, body)
		vec_push(cases, c)
	}
	p_next()
	s[SW_CASES] = cases
	return s
}

// ---- expressions ----
// bin_prec gives a binary operator's binding power (Go's levels), or 0.
fn bin_prec(t i64) i64 {
	if t[T_KIND] != TK_PUNCT {
		return 0
	}
	let s = t[T_TEXT]
	if streq(s, cstr("||")) != 0 {
		return 1
	}
	if streq(s, cstr("&&")) != 0 {
		return 2
	}
	if p_edition1 != 0 && p_range_expr != 0 && streq(s, cstr("..")) != 0 {
		return 3
	}
	if streq(s, cstr("==")) != 0 || streq(s, cstr("!=")) != 0 || streq(s, cstr("<")) != 0 || streq(s, cstr("<=")) != 0 || streq(s, cstr(">")) != 0 || streq(s, cstr(">=")) != 0 {
		return 3
	}
	if streq(s, cstr("+")) != 0 || streq(s, cstr("-")) != 0 || streq(s, cstr("|")) != 0 || streq(s, cstr("^")) != 0 {
		return 4
	}
	if streq(s, cstr("*")) != 0 || streq(s, cstr("/")) != 0 || streq(s, cstr("%")) != 0 || streq(s, cstr("<<")) != 0 || streq(s, cstr(">>")) != 0 || streq(s, cstr("&")) != 0 {
		return 5
	}
	return 0
}

// parse_expr is a precedence-climbing parser for left-associative binary operators.
fn parse_expr(min_prec i64) i64 {
	mut left = parse_unary()
	for {
		let t = p_peek()
		let prec = bin_prec(t)
		if prec == 0 || prec < min_prec {
			return parse_wrap(left)
		}
		p_next()
		let right = parse_expr(prec + 1)
		left = binary_new(t[T_POS], t[T_TEXT], left, right)
	}
}

fn parse_unary() i64 {
	let t = p_peek()
	let s = t[T_TEXT]
	if p_is(cstr("try")) != 0 {
		p_next()
		let tr = node_new(EX_TRY, t[T_POS])
		tr[TRY_X] = parse_unary()
		return tr
	}
	if t[T_KIND] == TK_PUNCT && (streq(s, cstr("-")) != 0 || streq(s, cstr("!")) != 0 || streq(s, cstr("~")) != 0 || streq(s, cstr("&")) != 0 || streq(s, cstr("^")) != 0 || streq(s, cstr("*")) != 0 || streq(s, cstr("+")) != 0) {
		p_next()
		let x = parse_unary()
		if streq(s, cstr("+")) != 0 || streq(s, cstr("*")) != 0 {
			// +x is x; *p is p, since struct values are references.
			return x
		}
		let u = node_new(EX_UNARY, t[T_POS])
		u[UN_OP] = s
		if streq(s, cstr("^")) != 0 {
			u[UN_OP] = cstr("~")
		}
		u[UN_X] = x
		return u
	}
	return parse_postfix()
}

// type_operand reports whether a call to name takes a type as its first argument.
fn type_operand(name i64) i64 {
	return i64(streq(name, cstr("make")) != 0 || streq(name, cstr("new")) != 0 || streq(name, cstr("cast")) != 0)
}

fn parse_postfix() i64 {
	mut x = parse_primary()
	for {
		if p_is(cstr("(")) != 0 {
			let pos = p_next()[T_POS]
			let call = node_new(EX_CALL, x[N_POS])
			call[CALL_ARGS] = vec_new()
			if x[N_KIND] == EX_IDENT {
				call[CALL_NAME] = x[ID_NAME]
			} else {
				call[CALL_CALLEE] = x
			}
			let saved = p_nolit
			p_nolit = 0
			if p_is(cstr(")")) == 0 && x[N_KIND] == EX_IDENT && type_operand(x[ID_NAME]) != 0 {
				let tx = node_new(EX_TYPE, p_peek()[T_POS])
				tx[TYX] = parse_type()
				vec_push(call[CALL_ARGS], tx)
				if p_is(cstr(",")) != 0 {
					p_next()
				}
			}
			for p_is(cstr(")")) == 0 {
				if p_is(cstr(";")) != 0 {
					p_next()
					continue
				}
				let mpos = p_peek()[T_POS]
				mut marked = 0
				if p_is(cstr("mut")) != 0 && p_legacy == 0 {
					p_next()
					marked = 1
				}
				mut a = parse_expr(1)
				if marked != 0 {
					let ma = node_new(EX_MUTARG, mpos)
					ma[MUTARG_X] = a
					a = ma
				}
				if p_is(cstr("...")) != 0 {
					let spread = node_new(EX_UNARY, p_next()[T_POS])
					spread[UN_OP] = cstr("...")
					spread[UN_X] = a
					a = spread
				}
				// A function literal passed to a function keeps its closure on the caller's frame only when
				// the callee is known not to keep it; any other call may store it, so it must outlive the frame.
				if a[N_KIND] == EX_FUNCLIT && callee_keeps_nothing(x) != 0 {
					a[LIT_ESCAPE] = 0
				} else if a[N_KIND] == EX_MUTARG && a[MUTARG_X][N_KIND] == EX_FUNCLIT && callee_keeps_nothing(x) != 0 {
					a[MUTARG_X][LIT_ESCAPE] = 0
				}
				vec_push(call[CALL_ARGS], a)
				if p_is(cstr(",")) == 0 {
					break
				}
				p_next()
			}
			p_nolit = saved
			p_expect(cstr(")"))
			x = call
		} else if p_is(cstr("[")) != 0 {
			let type_args = i64(p_edition1 != 0 && bracket_followed_by_call() != 0)
			let pos = p_next()[T_POS]
			let saved = p_nolit
			p_nolit = 0
			mut lo = 0
			mut targs = 0
			if type_args != 0 {
				targs = vec_new()
				for p_is(cstr("]")) == 0 {
					let tn = node_new(EX_TYPE, p_peek()[T_POS])
					tn[TYX] = parse_type()
					vec_push(targs, tn)
					if p_is(cstr(",")) == 0 {
						break
					}
					p_next()
				}
				p_expect(cstr("]"))
				let ix = node_new(EX_INDEX, pos)
				ix[IX_X] = x
				ix[IX_ARGS] = targs
				p_nolit = saved
				x = ix
			} else {
				if p_is(cstr("[")) != 0 || p_is(cstr("map")) != 0 || p_is(cstr("?")) != 0 || p_is(cstr("func")) != 0 || p_word(cstr("dyn")) != 0 {
					lo = node_new(EX_TYPE, p_peek()[T_POS])
					lo[TYX] = parse_type()
					targs = vec_new()
					vec_push(targs, lo)
				} else if p_is(cstr(":")) == 0 {
					lo = parse_expr(1)
				}
				if p_is(cstr(",")) != 0 {
					if targs == 0 {
						targs = vec_new()
						vec_push(targs, lo)
					}
					for p_is(cstr(",")) != 0 {
						p_next()
						if p_is(cstr("[")) != 0 || p_is(cstr("map")) != 0 || p_is(cstr("?")) != 0 || p_is(cstr("func")) != 0 || p_word(cstr("dyn")) != 0 || (p_edition1 != 0 && p_is(cstr("fn")) != 0) {
							let tn = node_new(EX_TYPE, p_peek()[T_POS])
							tn[TYX] = parse_type()
							vec_push(targs, tn)
						} else {
							vec_push(targs, parse_expr(1))
						}
					}
				}
				if p_is(cstr(":")) != 0 {
					p_next()
					let sl = node_new(EX_SLICE, pos)
					sl[SL_X] = x
					sl[SL_LO] = lo
					if p_is(cstr("]")) == 0 {
						sl[SL_HI] = parse_expr(1)
					}
					p_nolit = saved
					p_expect(cstr("]"))
					x = sl
				} else {
					p_nolit = saved
					p_expect(cstr("]"))
					let ix = node_new(EX_INDEX, pos)
					ix[IX_X] = x
					ix[IX_I] = lo
					ix[IX_ARGS] = targs
					x = ix
				}
			}
		} else if p_is(cstr(".")) != 0 {
			let pos = p_next()[T_POS]
			let sel = node_new(EX_SELECT, pos)
			sel[SEL_X] = x
			sel[SEL_NAME] = p_expect_ident()[T_TEXT]
			x = sel
		} else if p_edition1 != 0 && p_is(cstr("??")) != 0 {
			let pos = p_next()[T_POS]
			let coalesce = node_new(EX_COALESCE, pos)
			coalesce[COAL_X] = x
			coalesce[COAL_FALLBACK] = parse_unary()
			x = coalesce
		} else if p_is(cstr("{{")) != 0 && (x[N_KIND] == EX_TYPE || (p_nolit == 0 && p_legacy == 0 && (x[N_KIND] == EX_IDENT || (x[N_KIND] == EX_SELECT && x[SEL_X][N_KIND] == EX_IDENT) || (x[N_KIND] == EX_INDEX && (x[IX_X][N_KIND] == EX_IDENT || x[IX_X][N_KIND] == EX_SELECT))))) {
			x = parse_composite(x)
		} else {
			return x
		}
	}
}

fn bracket_followed_by_call() i64 {
	// A literal cannot start a type: byName["x"]() indexes, then calls.
	if p_i + 1 < p_toks[VEC_LEN] {
		let k = vec_get(p_toks, p_i + 1)[T_KIND]
		if k == TK_STRING || k == TK_INT || k == TK_FLOAT {
			return 0
		}
	}
	mut depth = 0
	mut i = p_i
	for i < p_toks[VEC_LEN] {
		let t = vec_get(p_toks, i)
		if tok_is(t, cstr("[")) != 0 {
			depth = depth + 1
		} else if tok_is(t, cstr("]")) != 0 {
			depth = depth - 1
			if depth == 0 {
				return i64(i + 1 < p_toks[VEC_LEN] && tok_is(vec_get(p_toks, i + 1), cstr("(")) != 0)
			}
		}
		i = i + 1
	}
	return 0
}

// parse_composite reads T{...} with positional or key: value elements.
fn parse_composite(tyexpr i64) i64 {
	let c = node_new(EX_COMPOSITE, tyexpr[N_POS])
	c[CL_TYPE] = tyexpr
	c[CL_ELEMS] = vec_new()
	c[CL_KEYS] = vec_new()
	p_expect(cstr("{{"))
	let saved = p_nolit
	p_nolit = 0
	for p_is(cstr("}}")) == 0 {
		if p_is(cstr(";")) != 0 {
			p_next()
			continue
		}
		mut v = parse_elem()
		mut k = 0
		if p_is(cstr(":")) != 0 {
			p_next()
			k = v
			v = parse_elem()
		} else if p_edition1 != 0 && composite_requires_keys(tyexpr) != 0 {
			p_fail_code(v[N_POS], cstr("E090 OLD_SYNTAX"), cstr("edition 1 struct literals require field names"))
		}
		vec_push(c[CL_KEYS], k)
		vec_push(c[CL_ELEMS], v)
		if p_is(cstr(",")) == 0 {
			break
		}
		p_next()
	}
	p_nolit = saved
	for p_is(cstr(";")) != 0 {
		p_next()
	}
	p_expect(cstr("}}"))
	return c
}

fn composite_requires_keys(tyexpr i64) i64 {
	if tyexpr[N_KIND] != EX_TYPE {
		return 1
	}
	let t = tyexpr[TYX]
	// A bare {...} element takes its type from the composite around it: unknown here.
	return i64(t != 0 && t[N_KIND] == TX_STRUCT)
}

// parse_elem reads a composite element; a bare {...} takes its type from the context.
fn parse_elem() i64 {
	if p_is(cstr("{{")) != 0 {
		let untyped = node_new(EX_TYPE, p_peek()[T_POS])
		return parse_composite(untyped)
	}
	return parse_expr(1)
}

// parse_match stores ordered, source-positioned arms and patterns. Later semantic passes
// lower these nodes after checking guards and enum coverage.
fn parse_match() i64 {
	let pos = p_next()[T_POS]
	let m = node_new(EX_MATCH, pos)
	let saved = p_nolit
	p_nolit = 1
	m[MATCH_SUBJECT] = parse_expr(1)
	p_nolit = saved
	p_expect(cstr("{{"))
	m[MATCH_ARMS] = vec_new()
	for p_is(cstr("}}")) == 0 {
		if p_is(cstr(";")) != 0 || p_is(cstr(",")) != 0 {
			p_next()
			continue
		}
		let arm = vec_new()
		vec_push(arm, p_peek()[T_POS])
		let patterns = vec_new()
		p_range_expr = 1
		vec_push(patterns, parse_pattern())
		for p_is(cstr(",")) != 0 {
			p_next()
			vec_push(patterns, parse_pattern())
		}
		p_range_expr = 0
		vec_push(arm, patterns)
		mut guard_ = 0
		if p_is(cstr("if")) != 0 {
			p_next()
			guard_ = parse_expr(1)
		}
		vec_push(arm, guard_)
		p_expect(cstr("=>"))
		mut body = 0
		mut is_block = 0
		if p_is(cstr("{{")) != 0 {
			body = parse_block()
			is_block = 1
		} else if p_is(cstr("return")) != 0 || p_is(cstr("break")) != 0 || p_is(cstr("continue")) != 0 || (p_word(cstr("fail")) != 0 && tok_is(p_peek2(), cstr(":=")) == 0 && tok_is(p_peek2(), cstr("=")) == 0 && tok_is(p_peek2(), cstr(",")) == 0 && tok_is(p_peek2(), cstr(".")) == 0) {
			// A statement arm (ErrNotFound => return 404) is a block of that statement.
			body = empty_block(p_peek()[T_POS])
			vec_push(body[BLK_STMTS], parse_stmt())
			is_block = 1
		} else {
			body = parse_expr(1)
			if p_is(cstr("=")) != 0 || is_assign_op(p_peek()) != 0 {
				// An assignment arm (Rect(w, h) => area = w * h) is a block of that assignment.
				let target = vec_new()
				vec_push(target, body)
				let assign = parse_simple_stmt(target)
				body = empty_block(assign[N_POS])
				vec_push(body[BLK_STMTS], assign)
				is_block = 1
			}
		}
		vec_push(arm, body)
		vec_push(arm, is_block)
		vec_push(m[MATCH_ARMS], arm)
		if p_is(cstr(";")) != 0 {
			p_next()
		}
	}
	if m[MATCH_ARMS][VEC_LEN] == 0 {
		p_fail_code(pos, cstr("E053 EMPTY_MATCH"), cstr("match needs at least one arm"))
	}
	p_next()
	return m
}

fn parse_pattern() i64 {
	let pos = p_peek()[T_POS]
	let x = parse_expr(1)
	return pattern_from_expr(x, pos)
}

fn pattern_from_expr(x i64, pos i64) i64 {
	let pat = vec_new()
	if x[N_KIND] == EX_BINARY && streq(x[BIN_OP], cstr("..")) != 0 {
		if pattern_is_literal(x[BIN_L]) == 0 || pattern_is_literal(x[BIN_R]) == 0 {
			p_fail_code(pos, cstr("E054 PATTERN"), cstr("range patterns need literal endpoints"))
		}
		vec_push(pat, PAT_RANGE)
		vec_push(pat, pos)
		vec_push(pat, x[BIN_L])
		vec_push(pat, x[BIN_R])
		vec_push(pat, 0)
		vec_push(pat, 0)
		return pat
	}
	if x[N_KIND] == EX_BINARY {
		p_fail_code(pos, cstr("E054 PATTERN"), cstr("expected a literal, range, enum variant, or binding pattern"))
	}
	if x[N_KIND] == EX_CALL {
		mut name = x[CALL_NAME]
		if x[CALL_CALLEE] != 0 {
			name = x[CALL_CALLEE]
		} else {
			name = node_new(EX_IDENT, pos)
			name[ID_NAME] = x[CALL_NAME]
		}
		if name == 0 || (name[N_KIND] != EX_IDENT && name[N_KIND] != EX_SELECT) {
			p_fail_code(pos, cstr("E054 PATTERN"), cstr("enum variant patterns need a variant name"))
		}
		let children = vec_new()
		mut i = 0
		for i < x[CALL_ARGS][VEC_LEN] {
			let child = vec_get(x[CALL_ARGS], i)
			vec_push(children, pattern_from_expr(child, child[N_POS]))
			i = i + 1
		}
		vec_push(pat, PAT_VARIANT)
		vec_push(pat, pos)
		vec_push(pat, 0)
		vec_push(pat, 0)
		vec_push(pat, name)
		vec_push(pat, children)
		return pat
	}
	if x[N_KIND] == EX_IDENT && streq(x[ID_NAME], cstr("_")) != 0 {
		vec_push(pat, PAT_WILD)
		vec_push(pat, pos)
		vec_push(pat, 0)
		vec_push(pat, 0)
		vec_push(pat, 0)
		vec_push(pat, 0)
		return pat
	}
	if x[N_KIND] == EX_IDENT && pattern_is_literal(x) == 0 {
		vec_push(pat, PAT_NAME_KIND)
		vec_push(pat, pos)
		vec_push(pat, 0)
		vec_push(pat, 0)
		vec_push(pat, x)
		vec_push(pat, 0)
		return pat
	}
	if x[N_KIND] == EX_SELECT {
		vec_push(pat, PAT_NAME_KIND)
		vec_push(pat, pos)
		vec_push(pat, 0)
		vec_push(pat, 0)
		vec_push(pat, x)
		vec_push(pat, 0)
		return pat
	}
	if pattern_is_literal(x) == 0 {
		p_fail_code(pos, cstr("E054 PATTERN"), cstr("expected a literal, range, enum variant, or binding pattern"))
	}
	vec_push(pat, PAT_LITERAL)
	vec_push(pat, pos)
	vec_push(pat, x)
	vec_push(pat, 0)
	vec_push(pat, 0)
	vec_push(pat, 0)
	return pat
}

fn pattern_is_literal(x i64) i64 {
	if x[N_KIND] == EX_INT || x[N_KIND] == EX_FLOAT || x[N_KIND] == EX_STR || x[N_KIND] == EX_NIL || x[N_KIND] == EX_UNIT {
		return 1
	}
	if x[N_KIND] == EX_IDENT && (streq(x[ID_NAME], cstr("true")) != 0 || streq(x[ID_NAME], cstr("false")) != 0) {
		return 1
	}
	if x[N_KIND] == EX_UNARY && streq(x[UN_OP], cstr("-")) != 0 {
		let operand = x[UN_X]
		return i64(operand[N_KIND] == EX_INT || operand[N_KIND] == EX_FLOAT || operand[N_KIND] == EX_UNIT)
	}
	return 0
}

fn parse_primary() i64 {
	let t = p_peek()
	let k = t[T_KIND]
	let pos = t[T_POS]
	if starts_boundary() != 0 {
		return parse_boundary()
	}
	if p_edition1 != 0 && p_word(cstr("keep")) != 0 {
		p_next()
		if p_is(cstr("(")) == 0 {
			p_fail_found_code(p_peek()[T_POS], cstr("E020 UNEXPECTED"), cstr("keep needs a value in parentheses"), p_peek())
		}
		let keep_ = node_new(EX_IDENT, pos)
		keep_[ID_NAME] = cstr("keep")
		return keep_
	}
	if p_edition1 != 0 && p_word(cstr("fail")) != 0 && tok_is(p_peek2(), cstr("(")) != 0 {
		// fail("text") as a value makes a fault, as in edition 0 (fail X leaves).
		p_next()
		let f = node_new(EX_IDENT, pos)
		f[ID_NAME] = cstr("fail")
		return f
	}
	if p_edition1 != 0 && p_word(cstr("match")) != 0 {
		return parse_match()
	}
	if k == TK_INT {
		p_next()
		if t[T_UNIT] != 0 {
			let unit_ = node_new(EX_UNIT, pos)
			unit_[UNIT_VALUE] = t[T_VAL]
			unit_[UNIT_NAME] = t[T_UNIT]
			unit_[UNIT_TEXT] = t[T_TEXT]
			unit_[UNIT_FLOAT] = 0
			return unit_
		}
		let i = node_new(EX_INT, pos)
		i[INT_VAL] = t[T_VAL]
		// A literal above 2^63-1 (its bits look negative) only fits 64-bit types.
		if t[T_VAL] < 0 {
			i[8] = 1
		}
		if i64(load8(t[T_TEXT])) == '\'' {
			i[7] = 1
		}
		return i
	}
	if k == TK_FLOAT {
		p_next()
		if t[T_UNIT] != 0 {
			let unit_ = node_new(EX_UNIT, pos)
			unit_[UNIT_VALUE] = t[T_VAL]
			unit_[UNIT_NAME] = t[T_UNIT]
			unit_[UNIT_TEXT] = t[T_TEXT]
			unit_[UNIT_FLOAT] = 1
			return unit_
		}
		let f = node_new(EX_FLOAT, pos)
		f[FL_BITS] = t[T_VAL]
		f[FL_TEXT] = t[T_TEXT]
		return f
	}
	if k == TK_STRING {
		p_next()
		if t[T_RAW] == 0 && p_legacy == 0 && has_brace(t[T_TEXT], t[T_VAL]) != 0 {
			return parse_interp(t, pos)
		}
		if t[T_DBL] != 0 {
			// A legacy string is not interpolated: take the doubled brace back to one.
			let un = buf_new()
			let q = t[T_TEXT]
			let m = t[T_VAL]
			mut u = 0
			for u < m {
				buf_byte(un, i64(load8(q + u)))
				if (i64(load8(q + u)) == '{' || i64(load8(q + u)) == '}') && u + 1 < m && i64(load8(q + u + 1)) == i64(load8(q + u)) {
					u = u + 1
				}
				u = u + 1
			}
			return str_node(pos, un)
		}
		let s = node_new(EX_STR, pos)
		s[STR_PTR] = t[T_TEXT]
		s[STR_LEN] = t[T_VAL]
		return s
	}
	if k == TK_IDENT {
		p_next()
		let id = node_new(EX_IDENT, pos)
		id[ID_NAME] = t[T_TEXT]
		return id
	}
	if p_is(cstr("true")) != 0 || p_is(cstr("false")) != 0 {
		p_next()
		let b = node_new(EX_IDENT, pos)
		b[ID_NAME] = t[T_TEXT]
		return b
	}
	if p_is(cstr("nil")) != 0 {
		p_next()
		return node_new(EX_NIL, pos)
	}
	if p_is(cstr("(")) != 0 {
		p_next()
		let saved = p_nolit
		p_nolit = 0
		let x = parse_expr(1)
		p_nolit = saved
		if p_word(cstr("catch")) != 0 && p_legacy == 0 {
			p_fail_code(p_peek()[T_POS], cstr("E401 CATCH_PLACEMENT"), cstr("catch goes on a whole statement, initializer, assignment or return value, not inside an expression"))
		}
		p_expect(cstr(")"))
		return x
	}
	if p_is(cstr("func")) != 0 || (p_edition1 != 0 && p_is(cstr("fn")) != 0) {
		if p_edition1 != 0 && p_is(cstr("func")) != 0 {
			p_fail_code(pos, cstr("E090 OLD_SYNTAX"), cstr("edition 1 uses 'fn', not 'func'"))
		}
		// A function literal, or a func type in a conversion.
		p_next()
		let f = fn_new(pos, cstr("func"))
		parse_params(f)
		p_bangres = 0
		f[F_RTYPES] = parse_results()
		f[F_BANG] = p_bangres
		if p_is(cstr("{{")) == 0 {
			p_fail_code(pos, cstr("E020 UNEXPECTED"), cstr("expected a function body"))
		}
		let saved = p_nolit
		p_nolit = 0
		f[F_BODY] = parse_block()
		p_nolit = saved
		let lit = node_new(EX_FUNCLIT, pos)
		lit[LIT_FN] = f
		lit[LIT_ESCAPE] = 1
		return lit
	}
	if p_is(cstr("[")) != 0 || p_is(cstr("map")) != 0 || p_is(cstr("struct")) != 0 {
		let ty = node_new(EX_TYPE, pos)
		ty[TYX] = parse_type()
		return ty
	}
	p_next()
	p_fail_found_code(pos, cstr("E020 UNEXPECTED"), cstr("expected an expression"), t)
	return 0
}

// print_edition1 keeps source trivia byte-for-byte and changes only legacy token spans.
// The parser has already validated the file with the edition-0 grammar.
fn print_edition1(file i64, source i64, toks i64) i64 {
	let out = buf_new()
	let prefixes = vec_filled(toks[VEC_LEN], 0)
	let suffixes = vec_filled(toks[VEC_LEN], 0)
	let replacements = vec_filled(toks[VEC_LEN], 0)
	let deletes = vec_filled(toks[VEC_LEN], 0)
	fx_span = vec_filled(toks[VEC_LEN], 0)
	fx_triv = vec_filled(toks[VEC_LEN], 0)
	fx_lead = vec_filled(toks[VEC_LEN], 0)
	fx_ind = vec_filled(toks[VEC_LEN], 0)
	fx_hoisted = vec_new()
	fx_rep = replacements
	fx_pre = prefixes
	fx_suf = suffixes
	mut depth = 0
	mut top = 0
	mut i = 0
	for i < toks[VEC_LEN] {
		let t = vec_get(toks, i)
		// a declaration starts a line (a func in a parameter's type does not)
		if depth == 0 && (i == 0 || tok_is(vec_get(toks, i - 1), cstr(";")) != 0 || tok_is(vec_get(toks, i - 1), cstr("}}")) != 0) && (fx_kw(t, cstr("func")) != 0 || fx_kw(t, cstr("var")) != 0 || fx_kw(t, cstr("const")) != 0 || fx_kw(t, cstr("type")) != 0 || fx_kw(t, cstr("import")) != 0) {
			top = i
			fx_top = i
			if fx_kw(t, cstr("func")) != 0 {
				mut n = fx_next(toks, i)
				if n < toks[VEC_LEN] && tok_is(vec_get(toks, n), cstr("(")) != 0 {
					n = fx_next(toks, matching_paren(toks, n))
				}
				fx_fn_name = cstr("fn")
				if n < toks[VEC_LEN] && vec_get(toks, n)[T_KIND] == TK_IDENT {
					fx_fn_name = vec_get(toks, n)[T_TEXT]
				}
			}
		}
		if tok_is(t, cstr("{{")) != 0 {
			depth = depth + 1
		} else if tok_is(t, cstr("}}")) != 0 {
			depth = depth - 1
		}
		if t[T_KIND] == TK_KEYWORD && streq(t[T_TEXT], cstr("for")) != 0 {
			if rewrite_for_each(source, toks, i, replacements, suffixes) == 0 && rewrite_for_range(toks, i, replacements, deletes, prefixes, suffixes) == 0 {
				rewrite_for_fallback(source, toks, i, replacements, deletes, prefixes, suffixes)
			}
		} else if t[T_KIND] == TK_KEYWORD && streq(t[T_TEXT], cstr("while")) != 0 {
			rewrite_while(toks, i, replacements, deletes)
		} else if t[T_KIND] == TK_KEYWORD && streq(t[T_TEXT], cstr("switch")) != 0 {
			rewrite_switch(source, toks, i, replacements, deletes, prefixes, suffixes)
		} else if fx_kw(t, cstr("if")) != 0 {
			rewrite_if_init(source, toks, i, replacements, prefixes, suffixes)
		} else if fx_kw(t, cstr("const")) != 0 && depth > 0 {
			rewrite_local_const(source, toks, i, top, replacements, depth)
		} else if fx_kw(t, cstr("const")) != 0 && depth == 0 {
			rewrite_const_group(source, toks, i)
		} else if tok_is(t, cstr("@")) != 0 && depth > 0 {
			rewrite_field_attr(source, toks, i)
		} else if t[T_KIND] == TK_IDENT && streq(t[T_TEXT], cstr("tide")) != 0 && replacements[VEC_DATA][i] == 0 {
			rewrite_tide_unit(toks, i, replacements)
		} else if fx_reserved(toks, i) != 0 && replacements[VEC_DATA][i] == 0 {
			replacements[VEC_DATA][i] = str_cat3(t[T_TEXT], cstr("_"), cstr(""))
		} else if t[T_SYNTH] == 0 && tok_is(t, cstr(";")) != 0 && replacements[VEC_DATA][i] == 0 && deletes[VEC_DATA][i] == 0 {
			replacements[VEC_DATA][i] = cstr("\n")
		}
		i = i + 1
	}
	i = 0
	for i < toks[VEC_LEN] {
		let t = vec_get(toks, i)
		if t[T_SYNTH] == 0 && streq(t[T_TEXT], cstr(":=")) != 0 && replacements[VEC_DATA][i] == 0 {
			mut first = i - 1
			mut count = 1
			mut mutable = 0
			for first >= 2 && tok_is(vec_get(toks, first - 1), cstr(",")) != 0 && vec_get(toks, first - 2)[T_KIND] == TK_IDENT {
				first = first - 2
				count = count + 1
			}
			if first >= 0 && vec_get(toks, first)[T_KIND] == TK_IDENT {
				mut name_at = first
				for name_at < i {
					let name = vec_get(toks, name_at)
					if name[T_KIND] == TK_IDENT && token_name_assigned_after(toks, name[T_TEXT], i + 1) != 0 {
						mutable = 1
					}
					name_at = name_at + 1
				}
				if count == 1 {
					prefixes[VEC_DATA][first] = cstr("let ")
					if mutable != 0 {
						prefixes[VEC_DATA][first] = cstr("mut ")
					}
				} else {
					prefixes[VEC_DATA][first] = cstr("let (")
					if mutable != 0 {
						prefixes[VEC_DATA][first] = cstr("mut (")
					}
					suffixes[VEC_DATA][i - 1] = cstr(")")
				}
			}
		}
		i = i + 1
	}
	mut cursor = 0
	i = 0
	for i < toks[VEC_LEN] {
		let t = vec_get(toks, i)
		if t[T_SYNTH] != 0 || t[T_END] <= t[T_START] || t[T_START] < cursor {
			i = i + 1
			continue
		}
		fx_cur_ind = fx_ind[VEC_DATA][i]
		if fx_triv[VEC_DATA][i] != 0 {
			fx_put(out, fx_triv[VEC_DATA][i], strlen(fx_triv[VEC_DATA][i]))
			if fx_lead[VEC_DATA][i] != 0 {
				buf_str(out, fx_lead[VEC_DATA][i])
			}
		} else {
			fx_copy_trivia(out, source, cursor, t[T_START], fx_lead[VEC_DATA][i])
		}
		fx_cur_ind = 0
		if prefixes[VEC_DATA][i] != 0 {
			buf_str(out, prefixes[VEC_DATA][i])
		}
		mut replacement = replacements[VEC_DATA][i]
		if replacement == 0 && t[T_KIND] == TK_KEYWORD && streq(t[T_TEXT], cstr("func")) != 0 {
			replacement = cstr("fn")
		} else if replacement == 0 && t[T_KIND] == TK_KEYWORD && streq(t[T_TEXT], cstr("var")) != 0 {
			replacement = cstr("let")
			mut name_at = i + 1
			for name_at < toks[VEC_LEN] && vec_get(toks, name_at)[T_SYNTH] != 0 {
				name_at = name_at + 1
			}
			if name_at < toks[VEC_LEN] && vec_get(toks, name_at)[T_KIND] == TK_IDENT {
				let name = vec_get(toks, name_at)[T_TEXT]
				if token_name_assigned_after(toks, name, name_at + 1) != 0 || token_has_initializer(toks, name_at + 1) == 0 {
					replacement = cstr("mut")
				}
			} else {
				replacement = cstr("mut")
			}
		} else if replacement == 0 && t[T_KIND] == TK_PUNCT && streq(t[T_TEXT], cstr(":=")) != 0 {
			replacement = cstr("=")
		} else if replacement == 0 && t[T_KIND] == TK_PUNCT && streq(t[T_TEXT], cstr("++")) != 0 {
			replacement = cstr("+= 1")
			if t[T_START] == cursor {
				replacement = cstr(" += 1")
			}
		} else if replacement == 0 && t[T_KIND] == TK_PUNCT && streq(t[T_TEXT], cstr("--")) != 0 {
			replacement = cstr("-= 1")
			if t[T_START] == cursor {
				replacement = cstr(" -= 1")
			}
		}
		if deletes[VEC_DATA][i] != 0 {
			// The original token span is omitted; its surrounding trivia remains in source.
		} else if replacement != 0 {
			buf_str(out, replacement)
		} else {
			buf_bytes(out, source + t[T_START], t[T_END] - t[T_START])
		}
		mut last = i
		if fx_span[VEC_DATA][i] != 0 {
			last = fx_span[VEC_DATA][i] - 1
			if suffixes[VEC_DATA][i] != 0 {
				buf_str(out, suffixes[VEC_DATA][i])
			}
		}
		if suffixes[VEC_DATA][last] != 0 {
			buf_str(out, suffixes[VEC_DATA][last])
		}
		cursor = vec_get(toks, last)[T_END]
		i = last + 1
	}
	mut source_len = 0
	if toks[VEC_LEN] > 0 {
		source_len = vec_get(toks, toks[VEC_LEN] - 1)[T_END]
	}
	if cursor < source_len {
		fx_copy_comments(out, source, cursor, source_len)
	}
	return out
}

// matching_brace returns the closing brace paired with open_at, or -1 for invalid input.
fn matching_brace(toks i64, open_at i64) i64 {
	mut depth = 0
	mut i = open_at
	for i < toks[VEC_LEN] {
		let t = vec_get(toks, i)
		if tok_is(t, cstr("{{")) != 0 {
			depth = depth + 1
		} else if tok_is(t, cstr("}}")) != 0 {
			depth = depth - 1
			if depth == 0 {
				return i
			}
		}
		i = i + 1
	}
	return -1
}

// loop_body_open finds the body brace for a C-style, range, or condition loop.
fn loop_body_open(toks i64, loop_at i64) i64 {
	mut semi_count = 0
	mut parens = 0
	mut brackets = 0
	mut braces = 0
	mut i = loop_at + 1
	for i < toks[VEC_LEN] {
		let t = vec_get(toks, i)
		if tok_is(t, cstr("(")) != 0 {
			parens = parens + 1
		} else if tok_is(t, cstr(")")) != 0 {
			parens = parens - 1
		} else if tok_is(t, cstr("[")) != 0 {
			brackets = brackets + 1
		} else if tok_is(t, cstr("]")) != 0 {
			brackets = brackets - 1
		} else if tok_is(t, cstr("{{")) != 0 {
			if braces == 0 && parens == 0 && brackets == 0 && (semi_count == 0 || semi_count >= 2) {
				return i
			}
			braces = braces + 1
		} else if tok_is(t, cstr("}}")) != 0 && braces > 0 {
			braces = braces - 1
		} else if tok_is(t, cstr(";")) != 0 && parens == 0 && brackets == 0 && braces == 0 {
			semi_count = semi_count + 1
		}
		i = i + 1
	}
	return -1
}

// token_inside_nested_loop reports whether target is inside another loop nested in outer_at.
fn token_inside_nested_loop(toks i64, outer_at i64, body i64, close i64, target i64) i64 {
	mut i = body + 1
	for i < target {
		let t = vec_get(toks, i)
		if (t[T_KIND] == TK_KEYWORD && (streq(t[T_TEXT], cstr("for")) != 0 || streq(t[T_TEXT], cstr("while")) != 0)) && i != outer_at {
			let open = loop_body_open(toks, i)
			if open > i && open < target {
				let end = matching_brace(toks, open)
				if end > target {
					return 1
				}
			}
		}
		i = i + 1
	}
	return 0
}

// source_indent returns the whitespace before a token on its source line.
fn source_indent(source i64, token i64) i64 {
	let start = token[T_START]
	mut i = start - 1
	for i >= 0 && i64(load8(source + i)) != '\n' {
		i = i - 1
	}
	i = i + 1
	mut line = i
	for line < start && (i64(load8(source + line)) == ' ' || i64(load8(source + line)) == '\t') {
		line = line + 1
	}
	if line != start {
		return cstr("")
	}
	return str_slice(source + i, start - i)
}

// loop_post_text prints the post statement in edition-1 assignment syntax.
fn loop_post_text(source i64, toks i64, post_start i64, post_end i64, post_op_at i64) i64 {
	let b = buf_new()
	let name = vec_get(toks, post_start)[T_TEXT]
	let op = vec_get(toks, post_op_at)
	if tok_is(op, cstr("++")) != 0 {
		buf_str(b, name)
		buf_str(b, cstr(" += 1"))
	} else if tok_is(op, cstr("--")) != 0 {
		buf_str(b, name)
		buf_str(b, cstr(" -= 1"))
	} else if tok_is(op, cstr("+=")) != 0 || tok_is(op, cstr("-=")) != 0 {
		buf_str(b, name)
		buf_byte(b, ' ')
		buf_str(b, op[T_TEXT])
		buf_byte(b, ' ')
		let first = vec_get(toks, post_op_at + 1)[T_START]
		let last = vec_get(toks, post_end)[T_END]
		buf_bytes(b, source + first, last - first)
	} else {
		let first = vec_get(toks, post_start)[T_START]
		let last = vec_get(toks, post_end)[T_END]
		buf_bytes(b, source + first, last - first)
	}
	return str_slice(b[VEC_DATA], b[VEC_LEN])
}

// rewrite_for_fallback moves a C loop's init out and post into its body when it is not a range.
fn rewrite_for_fallback(source i64, toks i64, for_at i64, replacements i64, deletes i64, prefixes i64, suffixes i64) i64 {
	mut semi1 = -1
	mut semi2 = -1
	let body = loop_body_open(toks, for_at)
	if body < 0 {
		return 0
	}
	mut parens = 0
	mut brackets = 0
	mut braces = 0
	mut i = for_at + 1
	for i < body {
		let t = vec_get(toks, i)
		if tok_is(t, cstr("(")) != 0 {
			parens = parens + 1
		} else if tok_is(t, cstr(")")) != 0 {
			parens = parens - 1
		} else if tok_is(t, cstr("[")) != 0 {
			brackets = brackets + 1
		} else if tok_is(t, cstr("]")) != 0 {
			brackets = brackets - 1
		} else if tok_is(t, cstr("{{")) != 0 {
			braces = braces + 1
		} else if tok_is(t, cstr("}}")) != 0 && braces > 0 {
			braces = braces - 1
		} else if tok_is(t, cstr(";")) != 0 && parens == 0 && brackets == 0 && braces == 0 {
			if semi1 < 0 {
				semi1 = i
			} else {
				semi2 = i
			}
		}
		i = i + 1
	}
	if semi1 < 0 || semi2 < 0 {
		return 0
	}
	let init_start = for_at + 1
	let init_end = semi1 - 1
	let cond_start = semi1 + 1
	let cond_end = semi2 - 1
	let post_start = semi2 + 1
	let post_end = body - 1
	let has_init = i64(init_start <= init_end)
	let has_cond = i64(cond_start <= cond_end)
	let has_post = i64(post_start <= post_end)
	let body_close = matching_brace(toks, body)
	if body_close < 0 {
		return 0
	}
	mut post = cstr("")
	mut post_op_at = -1
	if has_post != 0 {
		if vec_get(toks, post_start)[T_KIND] == TK_IDENT && post_start + 1 <= post_end {
			post_op_at = post_start + 1
			post = loop_post_text(source, toks, post_start, post_end, post_op_at)
		} else {
			return 0
		}
	}
	let find = source_indent(source, vec_get(toks, for_at))
	if has_init != 0 {
		replacements[VEC_DATA][for_at] = str_cat3(cstr("{{\n"), find, cstr("\t"))
		fx_triv[VEC_DATA][init_start] = cstr("")
		if init_start + 1 <= init_end && tok_is(vec_get(toks, init_start + 1), cstr(":=")) != 0 {
			prefixes[VEC_DATA][init_start] = cstr("mut ")
			replacements[VEC_DATA][init_start + 1] = cstr("=")
		}
		replacements[VEC_DATA][semi1] = str_cat3(cstr("\n"), find, cstr("\tfor "))
		fx_triv[VEC_DATA][cond_start] = cstr("")
		suffixes[VEC_DATA][body_close] = str_cat3(cstr("\n"), find, cstr("}}"))
		fx_nest(body, body_close)
	} else if has_cond != 0 {
		replacements[VEC_DATA][semi1] = cstr("")
		fx_triv[VEC_DATA][cond_start] = cstr("")
	} else {
		replacements[VEC_DATA][semi1] = cstr("true")
	}
	deletes[VEC_DATA][semi2] = 1
	fx_triv[VEC_DATA][semi2] = cstr("")
	fx_triv[VEC_DATA][body] = cstr(" ")
	mut extra = cstr("")
	if has_init != 0 {
		extra = cstr("\t")
	}
	if has_post != 0 {
		i = post_start
		for i <= post_end {
			deletes[VEC_DATA][i] = 1
			fx_triv[VEC_DATA][i] = cstr("")
			i = i + 1
		}
		if has_cond != 0 {
			let close_token = vec_get(toks, body_close)
			let indent = source_indent(source, close_token)
			let b = buf_new()
			if source_has_newline(source, vec_get(toks, fx_prev(toks, body_close))[T_END], close_token[T_START]) != 0 {
				buf_byte(b, '\t')
			} else {
				buf_byte(b, '\n')
				buf_str(b, indent)
				buf_str(b, extra)
				buf_byte(b, '\t')
			}
			buf_str(b, post)
			buf_byte(b, '\n')
			buf_str(b, indent)
			buf_str(b, extra)
			prefixes[VEC_DATA][body_close] = str_slice(b[VEC_DATA], b[VEC_LEN])
			i = body + 1
			for i < body_close {
				let c = vec_get(toks, i)
				if c[T_KIND] == TK_KEYWORD && streq(c[T_TEXT], cstr("continue")) != 0 && token_inside_nested_loop(toks, for_at, body, body_close, i) == 0 {
					let next = i + 1
					if next >= toks[VEC_LEN] || vec_get(toks, next)[T_KIND] != TK_IDENT {
						let token = c
						let ind = source_indent(source, token)
						let before = buf_new()
						buf_str(before, post)
						buf_byte(before, '\n')
						buf_str(before, ind)
						buf_str(before, extra)
						prefixes[VEC_DATA][i] = str_slice(before[VEC_DATA], before[VEC_LEN])
					}
				}
				i = i + 1
			}
		}
	}
	return 1
}

// rewrite_while maps Go-style while conditions to edition-1 for loops.
fn rewrite_while(toks i64, at i64, replacements i64, deletes i64) i64 {
	replacements[VEC_DATA][at] = cstr("for")
	let next = at + 1
	if next < toks[VEC_LEN] && vec_get(toks, next)[T_KIND] == TK_INT && vec_get(toks, next)[T_VAL] == 1 && tok_is(vec_get(toks, next + 1), cstr("{{")) != 0 {
		deletes[VEC_DATA][next] = 1
	} else if next + 2 < toks[VEC_LEN] && tok_is(vec_get(toks, next), cstr("(")) != 0 && vec_get(toks, next + 1)[T_KIND] == TK_INT && vec_get(toks, next + 1)[T_VAL] == 1 && tok_is(vec_get(toks, next + 2), cstr(")")) != 0 {
		deletes[VEC_DATA][next] = 1
		deletes[VEC_DATA][next + 1] = 1
		deletes[VEC_DATA][next + 2] = 1
	}
	return 1
}

// rewrite_switch changes statement switches into block-valued match arms and removes their breaks.
fn rewrite_switch(source i64, toks i64, switch_at i64, replacements i64, deletes i64, prefixes i64, suffixes i64) i64 {
	mut body = -1
	mut close = -1
	mut direct_case = 0
	mut i = switch_at + 1
	mut parens = 0
	mut brackets = 0
	mut braces = 0
	for i < toks[VEC_LEN] {
		let t = vec_get(toks, i)
		if tok_is(t, cstr("(")) != 0 {
			parens = parens + 1
		} else if tok_is(t, cstr(")")) != 0 {
			parens = parens - 1
		} else if tok_is(t, cstr("[")) != 0 {
			brackets = brackets + 1
		} else if tok_is(t, cstr("]")) != 0 {
			brackets = brackets - 1
		} else if tok_is(t, cstr("{{")) != 0 {
			if braces == 0 && parens == 0 && brackets == 0 {
				let end = matching_brace(toks, i)
				if end < 0 {
					return 0
				}
				mut depth = 0
				mut j = i + 1
				for j < end {
					let c = vec_get(toks, j)
					if tok_is(c, cstr("{{")) != 0 {
						depth = depth + 1
					} else if tok_is(c, cstr("}}")) != 0 {
						depth = depth - 1
					} else if depth == 0 && c[T_KIND] == TK_KEYWORD && (streq(c[T_TEXT], cstr("case")) != 0 || streq(c[T_TEXT], cstr("default")) != 0) {
						direct_case = 1
					}
					j = j + 1
				}
				if direct_case != 0 {
					body = i
					close = end
					break
				}
			}
			braces = braces + 1
		} else if tok_is(t, cstr("}}")) != 0 && braces > 0 {
			braces = braces - 1
		}
		i = i + 1
	}
	if body < 0 {
		return 0
	}
	// switch init; subject { ... }: the init moves into a block around the match.
	let semi = vec_filled(1, 0)
	fx_body(toks, switch_at, semi)
	if semi[0] >= body {
		semi[0] = -1
	}
	mut subject = switch_at + 1
	if semi[0] >= 0 {
		subject = fx_next(toks, semi[0])
	}
	let expressionless = i64(body == subject)
	replacements[VEC_DATA][switch_at] = cstr("match")
	if expressionless != 0 {
		prefixes[VEC_DATA][body] = cstr("true ")
	}
	let arms = vec_new()
	mut depth = 0
	i = body + 1
	for i < close {
		let t = vec_get(toks, i)
		if tok_is(t, cstr("{{")) != 0 {
			depth = depth + 1
		} else if tok_is(t, cstr("}}")) != 0 {
			depth = depth - 1
		} else if depth == 0 && t[T_KIND] == TK_KEYWORD && (streq(t[T_TEXT], cstr("case")) != 0 || streq(t[T_TEXT], cstr("default")) != 0) {
			vec_push(arms, i)
		}
		i = i + 1
	}
	i = 0
	for i < arms[VEC_LEN] {
		let at = vec_get(arms, i)
		let is_default = streq(vec_get(toks, at)[T_TEXT], cstr("default"))
		mut next = close
		if i + 1 < arms[VEC_LEN] {
			next = vec_get(arms, i + 1)
		}
		mut par = 0
		mut bracket = 0
		mut curly = 0
		mut colon = -1
		mut j = at + 1
		for j < next {
			let c = vec_get(toks, j)
			if tok_is(c, cstr("(")) != 0 {
				par = par + 1
			} else if tok_is(c, cstr(")")) != 0 {
				par = par - 1
			} else if tok_is(c, cstr("[")) != 0 {
				bracket = bracket + 1
			} else if tok_is(c, cstr("]")) != 0 {
				bracket = bracket - 1
			} else if tok_is(c, cstr("{{")) != 0 {
				curly = curly + 1
			} else if tok_is(c, cstr("}}")) != 0 {
				curly = curly - 1
			} else if tok_is(c, cstr(":")) != 0 && par == 0 && bracket == 0 && curly == 0 {
				colon = j
				break
			}
			j = j + 1
		}
		if colon < 0 {
			return 0
		}
		fx_triv[VEC_DATA][fx_next(toks, at)] = cstr("")
		if is_default != 0 {
			replacements[VEC_DATA][at] = cstr("_")
			replacements[VEC_DATA][colon] = cstr(" => {{")
		} else if expressionless != 0 {
			replacements[VEC_DATA][at] = cstr("true if (")
			j = at + 1
			par = 0
			bracket = 0
			curly = 0
			for j < colon {
				let c = vec_get(toks, j)
				if tok_is(c, cstr("(")) != 0 {
					par = par + 1
				} else if tok_is(c, cstr(")")) != 0 {
					par = par - 1
				} else if tok_is(c, cstr("[")) != 0 {
					bracket = bracket + 1
				} else if tok_is(c, cstr("]")) != 0 {
					bracket = bracket - 1
				} else if tok_is(c, cstr("{{")) != 0 {
					curly = curly + 1
				} else if tok_is(c, cstr("}}")) != 0 {
					curly = curly - 1
				} else if tok_is(c, cstr(",")) != 0 && par == 0 && bracket == 0 && curly == 0 {
					replacements[VEC_DATA][j] = cstr("||")
				}
				j = j + 1
			}
			replacements[VEC_DATA][colon] = cstr(") => {{")
		} else {
			deletes[VEC_DATA][at] = 1
			replacements[VEC_DATA][colon] = cstr(" => {{")
		}
		if i > 0 {
			prefixes[VEC_DATA][at] = fx_arm_close(source, toks, at, cstr("}}\n"), cstr("\t"))
		}
		// Unlabelled breaks leave the switch in Go; each match arm already ends at its block.
		j = colon + 1
		for j < next {
			let c = vec_get(toks, j)
			if c[T_KIND] == TK_KEYWORD && streq(c[T_TEXT], cstr("break")) != 0 {
				mut following = j + 1
				for following < next && vec_get(toks, following)[T_SYNTH] != 0 {
					following = following + 1
				}
				if following >= next || vec_get(toks, following)[T_KIND] != TK_IDENT {
					deletes[VEC_DATA][j] = 1
				}
			}
			j = j + 1
		}
		i = i + 1
	}
	// match arms sit one level deeper than the switch's cases did
	fx_nest(body, close - 1)
	prefixes[VEC_DATA][close] = fx_arm_close(source, toks, close, cstr("\t}}\n"), cstr(""))
	if semi[0] >= 0 {
		rewrite_init(source, toks, switch_at, semi[0], close, cstr("match"))
	}
	return 1
}

// rewrite_for_range converts a simple ascending C loop into Tin 1's range form.
fn rewrite_for_range(toks i64, for_at i64, replacements i64, deletes i64, prefixes i64, suffixes i64) i64 {
	mut semi1 = -1
	mut semi2 = -1
	mut body = -1
	mut parens = 0
	mut brackets = 0
	mut braces = 0
	mut i = for_at + 1
	for i < toks[VEC_LEN] {
		let t = vec_get(toks, i)
		if tok_is(t, cstr("(")) != 0 {
			parens = parens + 1
		} else if tok_is(t, cstr(")")) != 0 {
			parens = parens - 1
		} else if tok_is(t, cstr("[")) != 0 {
			brackets = brackets + 1
		} else if tok_is(t, cstr("]")) != 0 {
			brackets = brackets - 1
		} else if tok_is(t, cstr("{{")) != 0 {
			if braces == 0 && parens == 0 && brackets == 0 && semi2 >= 0 {
				body = i
				break
			}
			braces = braces + 1
		} else if tok_is(t, cstr("}}")) != 0 && braces > 0 {
			braces = braces - 1
		} else if tok_is(t, cstr(";")) != 0 && parens == 0 && brackets == 0 && braces == 0 {
			if semi1 < 0 {
				semi1 = i
			} else {
				semi2 = i
			}
		}
		i = i + 1
	}
	if semi1 < 0 || semi2 < 0 || body < 0 || semi1 <= for_at + 2 {
		return 0
	}
	let init_name = vec_get(toks, for_at + 1)
	let init_op_at = for_at + 2
	let init_op = vec_get(toks, init_op_at)
	if init_name[T_KIND] != TK_IDENT || tok_is(init_op, cstr(":=")) == 0 {
		return 0
	}
	let cond_name_at = semi1 + 1
	let cond_op_at = cond_name_at + 1
	if cond_op_at >= semi2 || vec_get(toks, cond_name_at)[T_KIND] != TK_IDENT || tok_is(vec_get(toks, cond_op_at), cstr("<")) == 0 || streq(init_name[T_TEXT], vec_get(toks, cond_name_at)[T_TEXT]) == 0 || cond_op_at + 1 >= semi2 {
		return 0
	}
	let post_name_at = semi2 + 1
	if post_name_at >= body || vec_get(toks, post_name_at)[T_KIND] != TK_IDENT || streq(init_name[T_TEXT], vec_get(toks, post_name_at)[T_TEXT]) == 0 {
		return 0
	}
	let post_op_at = post_name_at + 1
	if post_op_at >= body {
		return 0
	}
	let post_op = vec_get(toks, post_op_at)
	mut step_start = -1
	mut negate_step = 0
	if tok_is(post_op, cstr("++")) != 0 {
		if post_op_at + 1 != body {
			return 0
		}
	} else if tok_is(post_op, cstr("+=")) != 0 || tok_is(post_op, cstr("-=")) != 0 {
		if post_op_at + 1 >= body {
			return 0
		}
		step_start = post_op_at + 1
		negate_step = tok_is(post_op, cstr("-="))
	} else if tok_is(post_op, cstr("=")) != 0 {
		if post_op_at + 3 >= body || vec_get(toks, post_op_at + 1)[T_KIND] != TK_IDENT || streq(init_name[T_TEXT], vec_get(toks, post_op_at + 1)[T_TEXT]) == 0 || (tok_is(vec_get(toks, post_op_at + 2), cstr("+")) == 0 && tok_is(vec_get(toks, post_op_at + 2), cstr("-")) == 0) {
			return 0
		}
		step_start = post_op_at + 3
		negate_step = tok_is(vec_get(toks, post_op_at + 2), cstr("-"))
	} else {
		return 0
	}
	if step_start >= 0 && step_start >= body {
		return 0
	}
	// A range evaluates its bound once and owns its variable: the C loop's shape converts
	// only when the body changes neither (else the fallback keeps the loop's meaning).
	let close = matching_brace(toks, body)
	if close < 0 || fx_assigns(toks, body, close, init_name[T_TEXT]) != 0 {
		return 0
	}
	// The bound is one operand of the `<`: a top-level &&, || or comparison belongs to the
	// condition, and a call other than len may give another value on the next iteration.
	mut b = cond_op_at + 1
	mut depth = 0
	for b < semi2 {
		let bt = vec_get(toks, b)
		if fx_open(bt) != 0 {
			depth = depth + 1
		} else if fx_close(bt) != 0 {
			depth = depth - 1
		} else if depth == 0 && (tok_is(bt, cstr("&&")) != 0 || tok_is(bt, cstr("||")) != 0 || tok_is(bt, cstr("==")) != 0 || tok_is(bt, cstr("!=")) != 0 || tok_is(bt, cstr("<")) != 0 || tok_is(bt, cstr("<=")) != 0 || tok_is(bt, cstr(">")) != 0 || tok_is(bt, cstr(">=")) != 0) {
			return 0
		}
		if tok_is(bt, cstr("(")) != 0 && b > cond_op_at + 1 {
			let callee = vec_get(toks, b - 1)
			if callee[T_KIND] == TK_IDENT && streq(callee[T_TEXT], cstr("len")) == 0 {
				return 0
			}
		}
		if bt[T_KIND] == TK_IDENT && fx_assigns(toks, body, close, bt[T_TEXT]) != 0 {
			return 0
		}
		b = b + 1
	}
	replacements[VEC_DATA][init_op_at] = cstr("in")
	replacements[VEC_DATA][semi1] = cstr("..")
	deletes[VEC_DATA][cond_name_at] = 1
	deletes[VEC_DATA][cond_op_at] = 1
	deletes[VEC_DATA][semi2] = 1
	deletes[VEC_DATA][post_name_at] = 1
	// no spaces around '..' and none where tokens went
	fx_triv[VEC_DATA][semi1] = cstr("")
	fx_triv[VEC_DATA][cond_name_at] = cstr("")
	fx_triv[VEC_DATA][cond_op_at] = cstr("")
	fx_triv[VEC_DATA][cond_op_at + 1] = cstr("")
	fx_triv[VEC_DATA][semi2] = cstr("")
	fx_triv[VEC_DATA][post_name_at] = cstr("")
	fx_triv[VEC_DATA][post_op_at] = cstr("")
	if post_op_at + 1 < body {
		fx_triv[VEC_DATA][post_op_at + 1] = cstr("")
	}
	mut unit_step = 0
	if step_start >= 0 && step_start + 1 == body {
		let step = vec_get(toks, step_start)
		unit_step = i64(step[T_KIND] == TK_INT && step[T_VAL] == 1 && negate_step == 0)
	}
	if step_start < 0 || unit_step != 0 {
		deletes[VEC_DATA][post_op_at] = 1
		if step_start >= 0 {
			if tok_is(post_op, cstr("=")) != 0 {
				deletes[VEC_DATA][post_op_at + 1] = 1
				deletes[VEC_DATA][post_op_at + 2] = 1
			}
			deletes[VEC_DATA][step_start] = 1
		}
		return 1
	}
	prefixes[VEC_DATA][init_op_at + 1] = cstr("(")
	suffixes[VEC_DATA][semi2 - 1] = cstr(")")
	if tok_is(post_op, cstr("=")) != 0 {
		replacements[VEC_DATA][post_op_at] = cstr(".step(")
		deletes[VEC_DATA][post_op_at + 1] = 1
		deletes[VEC_DATA][post_op_at + 2] = 1
	} else if negate_step != 0 {
		replacements[VEC_DATA][post_op_at] = cstr(".step(-")
	} else {
		replacements[VEC_DATA][post_op_at] = cstr(".step(")
	}
	suffixes[VEC_DATA][body - 1] = cstr(")")
	return 1
}

// token_name_assigned_after reports any later assignment to name in the parsed file.
// Over-marking a shadowed name as mutable is harmless to generated code; an assigned binding
// must never be printed as immutable.
fn token_name_assigned_after(toks i64, name i64, start i64) i64 {
	mut i = start
	mut depth = 0
	for i < toks[VEC_LEN] {
		let t = vec_get(toks, i)
		// the declaring block's end: a later function's variable of that name is another one
		if tok_is(t, cstr("{{")) != 0 {
			depth = depth + 1
		} else if tok_is(t, cstr("}}")) != 0 {
			depth = depth - 1
			if depth < 0 {
				return 0
			}
		}
		if t[T_SYNTH] == 0 && t[T_KIND] == TK_IDENT && streq(t[T_TEXT], name) != 0 {
			mut prev = i - 1
			for prev >= 0 && vec_get(toks, prev)[T_SYNTH] != 0 {
				prev = prev - 1
			}
			mut next = i + 1
			for next < toks[VEC_LEN] && vec_get(toks, next)[T_SYNTH] != 0 {
				next = next + 1
			}
			if (prev < 0 || tok_is(vec_get(toks, prev), cstr(".")) == 0) && next < toks[VEC_LEN] {
				let op = vec_get(toks, next)
				if tok_is(op, cstr("=")) != 0 || tok_is(op, cstr(":=")) != 0 || tok_is(op, cstr("++")) != 0 || tok_is(op, cstr("--")) != 0 || tok_is(op, cstr("+=")) != 0 || tok_is(op, cstr("-=")) != 0 || tok_is(op, cstr("*=")) != 0 || tok_is(op, cstr("/=")) != 0 || tok_is(op, cstr("%=")) != 0 || tok_is(op, cstr("&=")) != 0 || tok_is(op, cstr("|=")) != 0 || tok_is(op, cstr("^=")) != 0 || tok_is(op, cstr("<<=")) != 0 || tok_is(op, cstr(">>=")) != 0 {
					return 1
				}
			}
		}
		i = i + 1
	}
	return 0
}

// token_has_initializer reports whether a declaration's name is followed by '=' before its line ends.
fn token_has_initializer(toks i64, start i64) i64 {
	mut i = start
	for i < toks[VEC_LEN] {
		let t = vec_get(toks, i)
		if t[T_SYNTH] != 0 || tok_is(t, cstr(";")) != 0 || tok_is(t, cstr("}}")) != 0 {
			return 0
		}
		if tok_is(t, cstr("=")) != 0 {
			return 1
		}
		i = i + 1
	}
	return 0
}

// ---- the edition-1 translator's structural rewrites (#225) ----
//
// The printer above changes token spans in place. These rules also replace several tokens
// at once (fx_span), rewrite the trivia before a token (fx_triv), and put text into the
// trivia before a top-level declaration (fx_lead: hoisted local constants).
shared mut fx_span i64 // fx_span[i] = j + 1: tokens i..j print as token i's replacement alone (0: none)
shared mut fx_triv i64 // the trivia printed before token i instead of the source's (0: keep it)
shared mut fx_lead i64 // text put into the trivia before token i, after its last blank line
shared mut fx_ind i64 // tabs added after each newline in the trivia before token i (a block now nested)
shared mut fx_cur_ind i64 // fx_ind of the token whose trivia is being printed
shared mut fx_trusted i64 // the file is a trusted library file: `secret` before a type is the qualifier
shared mut fx_top i64 // the top-level declaration being printed
shared mut fx_path i64 // the translated file's path (set by main): its package's other files share names
shared mut fx_pkg_names i64 // the names the package's other files declare or hoist (read when first needed)
shared mut fx_hoisted i64 // [name, text] of the local constants already hoisted
shared mut fx_fn_name i64 // the name of the function being printed (prefixes a clashing local constant)
shared mut fx_rep i64 // the printer's replacements, prefixes and suffixes (print_edition1)
shared mut fx_pre i64
shared mut fx_suf i64

fn fx_add(v i64, i i64, text i64) {
	let old = v[VEC_DATA][i]
	if old != 0 {
		v[VEC_DATA][i] = str_cat3(old, text, cstr(""))
	} else {
		v[VEC_DATA][i] = text
	}
}

fn fx_next(toks i64, i i64) i64 {
	mut j = i + 1
	for j < toks[VEC_LEN] && vec_get(toks, j)[T_SYNTH] != 0 {
		j = j + 1
	}
	return j
}

fn fx_prev(toks i64, i i64) i64 {
	mut j = i - 1
	for j >= 0 && vec_get(toks, j)[T_SYNTH] != 0 {
		j = j - 1
	}
	return j
}

// fx_text is the source text from token a's start to token b's end.
fn fx_text(source i64, toks i64, a i64, b i64) i64 {
	let s = vec_get(toks, a)[T_START]
	let e = vec_get(toks, b)[T_END]
	return str_slice(source + s, e - s)
}

fn fx_kw(t i64, word i64) i64 {
	return i64(t[T_KIND] == TK_KEYWORD && streq(t[T_TEXT], word) != 0)
}

fn fx_open(t i64) i64 {
	return i64(tok_is(t, cstr("(")) != 0 || tok_is(t, cstr("[")) != 0 || tok_is(t, cstr("{{")) != 0)
}

fn fx_close(t i64) i64 {
	return i64(tok_is(t, cstr(")")) != 0 || tok_is(t, cstr("]")) != 0 || tok_is(t, cstr("}}")) != 0)
}

// fx_body finds the block of the statement starting at kw: the first '{' outside brackets.
// semi gets the first explicit ';' before it (an init statement), or -1.
fn fx_body(toks i64, kw i64, semi i64) i64 {
	semi[0] = -1
	mut depth = 0
	mut i = kw + 1
	for i < toks[VEC_LEN] {
		let t = vec_get(toks, i)
		if tok_is(t, cstr("{{")) != 0 && depth == 0 {
			return i
		}
		if fx_open(t) != 0 {
			depth = depth + 1
		} else if fx_close(t) != 0 {
			depth = depth - 1
		} else if depth == 0 && t[T_SYNTH] == 0 && tok_is(t, cstr(";")) != 0 && semi[0] < 0 {
			semi[0] = i
		}
		i = i + 1
	}
	return -1
}

// fx_chain_end is the last '}' of the if/else chain whose first block opens at body.
fn fx_chain_end(toks i64, body i64) i64 {
	mut end = matching_brace(toks, body)
	for end >= 0 {
		let e = fx_next(toks, end)
		if e >= toks[VEC_LEN] || fx_kw(vec_get(toks, e), cstr("else")) == 0 {
			return end
		}
		let n = fx_next(toks, e)
		if n < toks[VEC_LEN] && fx_kw(vec_get(toks, n), cstr("if")) != 0 {
			let semi = vec_filled(1, 0)
			let b = fx_body(toks, n, semi)
			if b < 0 {
				return -1
			}
			end = matching_brace(toks, b)
		} else {
			return matching_brace(toks, n)
		}
	}
	return end
}

// rewrite_init moves the init statement of `if init; cond {` (or a switch's) into a block of
// its own around the whole statement, so its names keep their scope:
// `{ let x = init; if cond { ... } }`. word is what the statement starts with afterwards.
fn rewrite_init(source i64, toks i64, kw i64, semi i64, end i64, word i64) {
	let ind = source_indent(source, vec_get(toks, kw))
	fx_add(fx_pre, kw, str_cat3(cstr("{{\n"), ind, cstr("\t")))
	fx_rep[VEC_DATA][kw] = cstr("")
	fx_triv[VEC_DATA][fx_next(toks, kw)] = cstr("")
	fx_rep[VEC_DATA][semi] = str_cat3(cstr("\n"), ind, str_cat3(cstr("\t"), word, cstr("")))
	fx_add(fx_suf, end, str_cat3(cstr("\n"), ind, cstr("}}")))
	fx_nest(semi, end)
}

fn rewrite_if_init(source i64, toks i64, at i64, replacements i64, prefixes i64, suffixes i64) i64 {
	let semi = vec_filled(1, 0)
	let body = fx_body(toks, at, semi)
	if body < 0 || semi[0] < 0 {
		return 0
	}
	let end = fx_chain_end(toks, body)
	if end < 0 {
		return 0
	}
	rewrite_init(source, toks, at, semi[0], end, cstr("if"))
	return 1
}

// rewrite_for_each turns `for k, v := range x` into `for k, v in x`. One name is the index
// or key alone, which edition 1 writes `for k, _ in x`; a range over an integer literal is
// the range 0..n. An assignment form (`for k = range x`) has no edition-1 spelling.
fn rewrite_for_each(source i64, toks i64, for_at i64, replacements i64, suffixes i64) i64 {
	let semi = vec_filled(1, 0)
	let body = fx_body(toks, for_at, semi)
	if body < 0 || semi[0] >= 0 {
		return 0
	}
	mut r = -1
	mut depth = 0
	mut i = for_at + 1
	for i < body {
		let t = vec_get(toks, i)
		if fx_open(t) != 0 {
			depth = depth + 1
		} else if fx_close(t) != 0 {
			depth = depth - 1
		} else if depth == 0 && fx_kw(t, cstr("range")) != 0 {
			r = i
			break
		}
		i = i + 1
	}
	if r < 0 {
		return 0
	}
	let x = fx_next(toks, r)
	let int_bound = i64(fx_next(toks, x) == body && vec_get(toks, x)[T_KIND] == TK_INT)
	if r == fx_next(toks, for_at) {
		replacements[VEC_DATA][r] = cstr("_ in")
		if int_bound != 0 {
			replacements[VEC_DATA][r] = cstr("_ in 0..")
			fx_triv[VEC_DATA][x] = cstr("")
		}
		return 1
	}
	let op = fx_prev(toks, r)
	if tok_is(vec_get(toks, op), cstr(":=")) == 0 {
		return 0
	}
	let k = fx_next(toks, for_at)
	mut names = 1
	if fx_next(toks, k) != op {
		names = 2
	}
	replacements[VEC_DATA][op] = cstr("in")
	fx_span[VEC_DATA][op] = r + 1
	if int_bound != 0 {
		if names != 1 {
			return 0
		}
		replacements[VEC_DATA][op] = cstr("in 0..")
		fx_triv[VEC_DATA][x] = cstr("")
	} else if names == 1 {
		fx_add(suffixes, k, cstr(", _"))
	}
	return 1
}

// rewrite_local_const hoists `const name = value` out of a function to package level,
// where edition 1 allows constants (a constant there compiles exactly as one inside). The
// declaration goes before the top-level declaration holding it; a name already declared
// at package level, or hoisted with another value, gets the function's name in front.
// Only a single-name constant in the function's own block moves: one in a nested block
// may shadow a name the hoisted one would hide, so it stays, and edition 1 reports it.
fn rewrite_local_const(source i64, toks i64, at i64, top i64, replacements i64, level i64) i64 {
	let name = fx_next(toks, at)
	if level != 1 || name >= toks[VEC_LEN] || vec_get(toks, name)[T_KIND] != TK_IDENT {
		return 0
	}
	if tok_is(vec_get(toks, fx_next(toks, name)), cstr(",")) != 0 {
		return 0
	}
	// the statement ends at the first semicolon outside brackets
	mut depth = 0
	mut last = name
	mut i = name
	for i < toks[VEC_LEN] {
		let t = vec_get(toks, i)
		if fx_open(t) != 0 {
			depth = depth + 1
		} else if fx_close(t) != 0 {
			if depth == 0 {
				break
			}
			depth = depth - 1
		} else if depth == 0 && tok_is(t, cstr(";")) != 0 {
			break
		}
		last = i
		i = i + 1
	}
	let nm = vec_get(toks, name)[T_TEXT]
	if streq(nm, cstr("_")) != 0 {
		fx_drop_statement(source, toks, at, last, replacements)
		return 1
	}
	mut rest = cstr("")
	if fx_next(toks, name) <= last {
		rest = fx_value_text(source, toks, fx_next(toks, name), last)
	}
	// the hoisted name: the same one unless the package level already has it, or another
	// function hoisted it with another value; then the function's name prefixes it
	mut new_ = fx_renamed(nm)
	mut conflict = fx_top_declares(toks, nm)
	mut k = 0
	for k < fx_hoisted[VEC_LEN] {
		let h = vec_get(fx_hoisted, k)
		if streq(vec_get(h, 0), new_) != 0 && streq(vec_get(h, 1), rest) == 0 {
			conflict = 1
		}
		k = k + 1
	}
	if conflict != 0 {
		let up = buf_new()
		buf_byte(up, i64(load8(nm)) - 32 * i64((i64(load8(nm)) >= 'a' && i64(load8(nm)) <= 'z')))
		buf_str(up, nm + 1)
		new_ = str_cat3(fx_fn_name, str_slice(up[VEC_DATA], up[VEC_LEN]), cstr(""))
	}
	if streq(new_, nm) == 0 {
		fx_rename_uses(toks, last + 1, nm, new_)
	}
	k = 0
	for k < fx_hoisted[VEC_LEN] {
		let h = vec_get(fx_hoisted, k)
		if streq(vec_get(h, 0), new_) != 0 {
			// already hoisted with this value: the statement goes, a comment on its line stays
			let next = fx_next(toks, last)
			let note = fx_take_line_comment(source, toks, last)
			if note != 0 {
				let ind = source_indent(source, vec_get(toks, at))
				fx_triv[VEC_DATA][next] = str_cat3(str_cat3(cstr("\n"), ind, note), fx_triv[VEC_DATA][next], cstr(""))
			}
			fx_drop_statement(source, toks, at, last, replacements)
			return 1
		}
		k = k + 1
	}
	let h = vec_new()
	vec_push(h, new_)
	vec_push(h, rest)
	vec_push(fx_hoisted, h)
	// a comment after the constant on its line moves with it
	let note = fx_take_line_comment(source, toks, last)
	if note != 0 {
		rest = str_cat3(rest, cstr(" "), note)
	}
	fx_add(fx_lead, top, str_cat3(cstr("const "), new_, str_cat3(cstr(" "), rest, cstr("\n\n"))))
	fx_drop_statement(source, toks, at, last, replacements)
	return 1
}

// fx_value_text is the source of tokens a..b as it reads at package level: names renamed
// so far (an earlier hoisted constant, a reserved word) are written with their new names.
fn fx_value_text(source i64, toks i64, a i64, b i64) i64 {
	let out = buf_new()
	mut cursor = vec_get(toks, a)[T_START]
	mut i = a
	for i <= b {
		let t = vec_get(toks, i)
		if t[T_SYNTH] == 0 {
			buf_bytes(out, source + cursor, t[T_START] - cursor)
			let p = fx_prev(toks, i)
			if fx_rep[VEC_DATA][i] != 0 {
				buf_str(out, fx_rep[VEC_DATA][i])
			} else if t[T_KIND] == TK_IDENT && (p < 0 || tok_is(vec_get(toks, p), cstr(".")) == 0) {
				buf_str(out, fx_renamed(t[T_TEXT]))
			} else {
				buf_bytes(out, source + t[T_START], t[T_END] - t[T_START])
			}
			cursor = t[T_END]
		}
		i = i + 1
	}
	return str_slice(out[VEC_DATA], out[VEC_LEN])
}

// fx_take_line_comment returns the // comment after token last on its line, or 0, and leaves
// it out of the next token's trivia.
fn fx_take_line_comment(source i64, toks i64, last i64) i64 {
	let next = fx_next(toks, last)
	if next >= toks[VEC_LEN] {
		return 0
	}
	mut i = vec_get(toks, last)[T_END]
	let end = vec_get(toks, next)[T_START]
	for i < end && (i64(load8(source + i)) == ' ' || i64(load8(source + i)) == '\t') {
		i = i + 1
	}
	if !(i + 1 < end && i64(load8(source + i)) == '/' && i64(load8(source + i + 1)) == '/') {
		return 0
	}
	let start = i
	for i < end && i64(load8(source + i)) != '\n' {
		i = i + 1
	}
	let note = str_slice(source + start, i - start)
	if fx_triv[VEC_DATA][next] == 0 {
		fx_triv[VEC_DATA][next] = str_slice(source + i, end - i)
	}
	return note
}

// fx_drop_statement removes tokens a..b and the line they stood on.
fn fx_drop_statement(source i64, toks i64, a i64, b i64, replacements i64) i64 {
	replacements[VEC_DATA][a] = cstr("")
	fx_span[VEC_DATA][a] = b + 1
	let set = fx_triv[VEC_DATA][a]
	if set != 0 {
		// trivia an earlier rewrite already chose (a moved comment left out): drop its last line
		mut n = strlen(set)
		for n > 0 && (i64(load8(set + n - 1)) == ' ' || i64(load8(set + n - 1)) == '\t') {
			n = n - 1
		}
		if n > 0 && i64(load8(set + n - 1)) == '\n' {
			fx_triv[VEC_DATA][a] = str_slice(set, n - 1)
		}
		return 0
	}
	let prev = fx_prev(toks, a)
	mut from = 0
	if prev >= 0 {
		from = vec_get(toks, prev)[T_END]
	}
	let to = vec_get(toks, a)[T_START]
	mut j = to
	for j > from && (i64(load8(source + j - 1)) == ' ' || i64(load8(source + j - 1)) == '\t') {
		j = j - 1
	}
	if j > from && i64(load8(source + j - 1)) == '\n' {
		fx_triv[VEC_DATA][a] = str_slice(source + from, j - 1 - from)
	}
	return 0
}

// fx_top_declares reports a package-level declaration of name in this file or in another
// file of its package (a library package: the files of a main directory are separate programs).
fn fx_top_declares(toks i64, name i64) i64 {
	if fx_file_declares(toks, name) != 0 {
		return 1
	}
	if fx_pkg_names == 0 {
		fx_pkg_names = fx_sibling_names(toks)
	}
	mut i = 0
	for i < fx_pkg_names[VEC_LEN] {
		if streq(vec_get(fx_pkg_names, i), name) != 0 {
			return 1
		}
		i = i + 1
	}
	return 0
}

// fx_sibling_names lists what the other .tin files in the translated file's directory declare
// at package level, and the local constants they would hoist there, when the package is not main.
fn fx_sibling_names(toks i64) i64 {
	let names = vec_new()
	mut p = 0
	for p + 1 < toks[VEC_LEN] && fx_kw(vec_get(toks, p), cstr("package")) == 0 {
		p = p + 1
	}
	if fx_path == 0 || p + 1 >= toks[VEC_LEN] || streq(vec_get(toks, p + 1)[T_TEXT], cstr("main")) != 0 {
		return names
	}
	let dir = dir_of(fx_path)
	let d = rt_sys_opendir(dir)
	if d == 0 {
		return names
	}
	let self = fx_base(fx_path)
	for {
		let ent = rt_sys_readdir(d)
		if ent == 0 {
			break
		}
		let name = host_dirent_name(ent)
		if ends_with(name, cstr(".tin")) != 0 && i64(load8(name)) != '.' && streq(name, self) == 0 {
			let src = try_read_file(cat_path(cat_path(dir, cstr("/")), name))
			if src != 0 {
				let stoks = lex(0, src[VEC_DATA], src[VEC_LEN], source_edition(src[VEC_DATA], src[VEC_LEN]))
				fx_collect_names(stoks, names)
			}
		}
	}
	rt_sys_closedir(d)
	return names
}

fn fx_base(path i64) i64 {
	let n = strlen(path)
	mut i = n
	for i > 0 && i64(load8(path + i - 1)) != '/' {
		i = i - 1
	}
	return path + i
}

// fx_collect_names adds the names declared at package level in toks (const groups included)
// and every constant declared inside a function.
fn fx_collect_names(toks i64, names i64) {
	mut depth = 0
	mut group = 0
	mut i = 0
	for i < toks[VEC_LEN] {
		let t = vec_get(toks, i)
		let n = fx_next(toks, i)
		if (fx_kw(t, cstr("const")) != 0 || fx_kw(t, cstr("var")) != 0) && n < toks[VEC_LEN] && tok_is(vec_get(toks, n), cstr("(")) != 0 && depth == 0 {
			group = 1
		} else if group != 0 && depth == 1 && t[T_KIND] == TK_IDENT && (i == 0 || tok_is(vec_get(toks, i - 1), cstr(";")) != 0 || tok_is(vec_get(toks, i - 1), cstr("(")) != 0) {
			vec_push(names, t[T_TEXT])
		}
		if tok_is(t, cstr("{{")) != 0 || tok_is(t, cstr("(")) != 0 || tok_is(t, cstr("[")) != 0 {
			depth = depth + 1
		} else if tok_is(t, cstr("}}")) != 0 || tok_is(t, cstr(")")) != 0 || tok_is(t, cstr("]")) != 0 {
			depth = depth - 1
			if depth == 0 {
				group = 0
			}
		} else if n < toks[VEC_LEN] && vec_get(toks, n)[T_KIND] == TK_IDENT && (fx_kw(t, cstr("const")) != 0 || (depth == 0 && (fx_kw(t, cstr("var")) != 0 || fx_kw(t, cstr("type")) != 0 || fx_kw(t, cstr("func")) != 0 || fx_kw(t, cstr("fn")) != 0 || fx_kw(t, cstr("let")) != 0 || fx_kw(t, cstr("mut")) != 0))) {
			vec_push(names, vec_get(toks, n)[T_TEXT])
		}
		i = i + 1
	}
}

// fx_file_declares reports a package-level declaration of name in this file.
fn fx_file_declares(toks i64, name i64) i64 {
	mut depth = 0
	mut i = 0
	for i < toks[VEC_LEN] {
		let t = vec_get(toks, i)
		if tok_is(t, cstr("{{")) != 0 || tok_is(t, cstr("(")) != 0 || tok_is(t, cstr("[")) != 0 {
			depth = depth + 1
		} else if tok_is(t, cstr("}}")) != 0 || tok_is(t, cstr(")")) != 0 || tok_is(t, cstr("]")) != 0 {
			depth = depth - 1
		} else if depth == 0 && (fx_kw(t, cstr("const")) != 0 || fx_kw(t, cstr("var")) != 0 || fx_kw(t, cstr("type")) != 0 || fx_kw(t, cstr("func")) != 0) {
			let n = fx_next(toks, i)
			if n < toks[VEC_LEN] && streq(vec_get(toks, n)[T_TEXT], name) != 0 {
				return 1
			}
		}
		i = i + 1
	}
	return 0
}

// fx_unit is the edition-1 unit of a tide duration constant, or 0.
fn fx_unit(name i64) i64 {
	if streq(name, cstr("Nanosecond")) != 0 {
		return cstr("ns")
	}
	if streq(name, cstr("Microsecond")) != 0 {
		return cstr("us")
	}
	if streq(name, cstr("Millisecond")) != 0 {
		return cstr("ms")
	}
	if streq(name, cstr("Second")) != 0 {
		return cstr("s")
	}
	if streq(name, cstr("Minute")) != 0 {
		return cstr("m")
	}
	if streq(name, cstr("Hour")) != 0 {
		return cstr("h")
	}
	return 0
}

// rewrite_tide_unit turns `n * tide.Millisecond` and `tide.Millisecond * n` (n an integer
// literal) into the unit literal `nms`, and a lone `tide.Second` into `1s`.
fn rewrite_tide_unit(toks i64, at i64, replacements i64) i64 {
	let dot = fx_next(toks, at)
	let name = fx_next(toks, dot)
	if name >= toks[VEC_LEN] || tok_is(vec_get(toks, dot), cstr(".")) == 0 || vec_get(toks, name)[T_KIND] != TK_IDENT {
		return 0
	}
	let unit_ = fx_unit(vec_get(toks, name)[T_TEXT])
	if unit_ == 0 {
		return 0
	}
	let prev = fx_prev(toks, at)
	if prev >= 0 && tok_is(vec_get(toks, prev), cstr(".")) != 0 {
		return 0
	}
	let star = fx_prev(toks, at)
	let lit = fx_prev(toks, star)
	if lit >= 0 && tok_is(vec_get(toks, star), cstr("*")) != 0 && vec_get(toks, lit)[T_KIND] == TK_INT && fx_binds_tighter(toks, fx_prev(toks, lit)) == 0 {
		replacements[VEC_DATA][lit] = str_cat3(fx_int_text(vec_get(toks, lit)), unit_, cstr(""))
		fx_span[VEC_DATA][lit] = name + 1
		return 1
	}
	let star2 = fx_next(toks, name)
	let lit2 = fx_next(toks, star2)
	if lit2 < toks[VEC_LEN] && tok_is(vec_get(toks, star2), cstr("*")) != 0 && vec_get(toks, lit2)[T_KIND] == TK_INT && fx_binds_tighter(toks, prev) == 0 && fx_binds_tighter(toks, fx_next(toks, lit2)) == 0 {
		replacements[VEC_DATA][at] = str_cat3(fx_int_text(vec_get(toks, lit2)), unit_, cstr(""))
		fx_span[VEC_DATA][at] = lit2 + 1
		return 1
	}
	if fx_binds_tighter(toks, prev) == 0 && fx_binds_tighter(toks, fx_next(toks, name)) == 0 {
		replacements[VEC_DATA][at] = str_cat3(cstr("1"), unit_, cstr(""))
		fx_span[VEC_DATA][at] = name + 1
		return 1
	}
	return 0
}

// fx_binds_tighter reports an operator next to a unit expression that binds more tightly
// than '*' would after the rewrite (a unary minus, '.', an index).
fn fx_binds_tighter(toks i64, i i64) i64 {
	if i < 0 || i >= toks[VEC_LEN] {
		return 0
	}
	let t = vec_get(toks, i)
	return i64(tok_is(t, cstr(".")) != 0 || tok_is(t, cstr("/")) != 0 || tok_is(t, cstr("%")) != 0 || tok_is(t, cstr("[")) != 0 || tok_is(t, cstr("<<")) != 0 || tok_is(t, cstr(">>")) != 0)
}

fn fx_int_text(t i64) i64 {
	let b = buf_new()
	buf_int(b, t[T_VAL])
	return str_slice(b[VEC_DATA], b[VEC_LEN])
}

// fx_copy_trivia copies the source between tokens, turning /* block comments */ into
// line comments and putting lead (if any) after the trivia's last blank line.
fn fx_copy_trivia(out i64, source i64, a i64, b i64, lead i64) {
	mut at = a
	if lead != 0 {
		mut k = b - 1
		at = -1
		for k > a {
			if i64(load8(source + k)) == '\n' && i64(load8(source + k - 1)) == '\n' {
				at = k + 1
				break
			}
			k = k - 1
		}
		if at < 0 {
			at = a
			for at < b && i64(load8(source + at)) != '\n' {
				at = at + 1
			}
			if at < b {
				at = at + 1
			}
		}
		fx_copy_comments(out, source, a, at)
		buf_str(out, lead)
	}
	fx_copy_comments(out, source, at, b)
}

fn fx_copy_comments(out i64, source i64, a i64, b i64) {
	mut i = a
	for i < b {
		let c = i64(load8(source + i))
		if c == '/' && i + 1 < b && i64(load8(source + i + 1)) == '/' {
			for i < b && i64(load8(source + i)) != '\n' {
				buf_byte(out, i64(load8(source + i)))
				i = i + 1
			}
		} else if c == '/' && i + 1 < b && i64(load8(source + i + 1)) == '*' {
			// the indentation of the comment's first line, for the lines after it
			mut ls = i
			for ls > 0 && i64(load8(source + ls - 1)) != '\n' {
				ls = ls - 1
			}
			let ind = buf_new()
			mut q = ls
			for q < i && (i64(load8(source + q)) == ' ' || i64(load8(source + q)) == '\t') {
				buf_byte(ind, i64(load8(source + q)))
				q = q + 1
			}
			i = i + 2
			buf_str(out, cstr("//"))
			for i < b && !(i64(load8(source + i)) == '*' && i + 1 < b && i64(load8(source + i + 1)) == '/') {
				let d = i64(load8(source + i))
				buf_byte(out, d)
				if d == '\n' {
					fx_put_tabs(out)
					buf_bytes(out, ind[VEC_DATA], ind[VEC_LEN])
					// skip the comment line's own indentation and a leading '*'
					i = i + 1
					for i < b && (i64(load8(source + i)) == ' ' || i64(load8(source + i)) == '\t') {
						i = i + 1
					}
					buf_str(out, cstr("//"))
					if i < b && i64(load8(source + i)) == '*' && !(i + 1 < b && i64(load8(source + i + 1)) == '/') {
						i = i + 1
					}
					if i < b && i64(load8(source + i)) != ' ' && i64(load8(source + i)) != '\n' && !(i64(load8(source + i)) == '*' && i + 1 < b && i64(load8(source + i + 1)) == '/') {
						buf_byte(out, ' ')
					}
					continue
				}
				i = i + 1
			}
			for out[VEC_LEN] > 0 && (i64(load8(out[VEC_DATA] + out[VEC_LEN] - 1)) == ' ' || i64(load8(out[VEC_DATA] + out[VEC_LEN] - 1)) == '\t') {
				out[VEC_LEN] = out[VEC_LEN] - 1
			}
			i = i + 2
			// code after the comment on the same line goes to a line of its own
			mut j = i
			for j < b && (i64(load8(source + j)) == ' ' || i64(load8(source + j)) == '\t') {
				j = j + 1
			}
			if j >= b || i64(load8(source + j)) != '\n' {
				buf_byte(out, '\n')
				fx_put_tabs(out)
				buf_bytes(out, ind[VEC_DATA], ind[VEC_LEN])
				i = j
			}
		} else {
			buf_byte(out, c)
			if c == '\n' && i + 1 < b && i64(load8(source + i + 1)) != '\n' {
				fx_put_tabs(out)
			}
			i = i + 1
		}
	}
}

// fx_reserved reports the words edition 1 reserves that edition-0 code may use as names
// (edition 0 has none of their constructs): such a name gets a trailing '_', the same in
// every file, so a package's files still agree.
fn fx_reserved(toks i64, i i64) i64 {
	let t = vec_get(toks, i)
	if t[T_KIND] != TK_IDENT {
		return 0
	}
	let s = t[T_TEXT]
	if streq(s, cstr("shared")) != 0 {
		let n = fx_next(toks, i)
		return i64(n >= toks[VEC_LEN] || fx_kw(vec_get(toks, n), cstr("var")) == 0)
	}
	if streq(s, cstr("enum")) != 0 {
		let n = fx_next(toks, i)
		return i64(n >= toks[VEC_LEN] || tok_is(vec_get(toks, n), cstr("{{")) == 0)
	}
	if streq(s, cstr("keep")) != 0 {
		// the builtin keep(x) stays; a name spelled the same is renamed, and so is every use
		// of it in a declaration that has such a name (a parameter called like a function)
		let n = fx_next(toks, i)
		if n >= toks[VEC_LEN] || tok_is(vec_get(toks, n), cstr("(")) == 0 {
			return 1
		}
		mut j = fx_top
		for j < i {
			let u = vec_get(toks, j)
			if u[T_KIND] == TK_IDENT && streq(u[T_TEXT], cstr("keep")) != 0 {
				let un = fx_next(toks, j)
				if un >= toks[VEC_LEN] || tok_is(vec_get(toks, un), cstr("(")) == 0 {
					return 1
				}
			}
			j = j + 1
		}
		return 0
	}
	if streq(s, cstr("secret")) != 0 && fx_trusted != 0 {
		// `name secret T`, `) secret T`, `[]secret T`: the qualifier, the same word in edition 1
		let n = fx_next(toks, i)
		let p = fx_prev(toks, i)
		if n < toks[VEC_LEN] && p >= 0 && (vec_get(toks, n)[T_KIND] == TK_IDENT || tok_is(vec_get(toks, n), cstr("[")) != 0 || tok_is(vec_get(toks, n), cstr("?")) != 0) && (vec_get(toks, p)[T_KIND] == TK_IDENT || tok_is(vec_get(toks, p), cstr(")")) != 0 || tok_is(vec_get(toks, p), cstr("]")) != 0) {
			return 0
		}
	}
	return i64(streq(s, cstr("match")) != 0 || streq(s, cstr("within")) != 0 || streq(s, cstr("limit")) != 0 || streq(s, cstr("guard")) != 0 || streq(s, cstr("parallel")) != 0 || streq(s, cstr("detach")) != 0 || streq(s, cstr("secret")) != 0)
}

// rewrite_field_attr moves a struct field's trailing attribute (`Name str @json("n")`)
// before the field, where edition 1 writes it (`@json("n") Name str`).
fn rewrite_field_attr(source i64, toks i64, at i64) i64 {
	// An attribute that starts its line (edition 1's place, after a synthetic ';') stays.
	let raw = at - 1
	if raw < 0 || tok_is(vec_get(toks, raw), cstr("{{")) != 0 || tok_is(vec_get(toks, raw), cstr(";")) != 0 || tok_is(vec_get(toks, raw), cstr("(")) != 0 {
		return 0
	}
	let prev = fx_prev(toks, at)
	let name = fx_next(toks, at)
	mut last = name
	let open = fx_next(toks, name)
	if open < toks[VEC_LEN] && tok_is(vec_get(toks, open), cstr("(")) != 0 {
		mut depth = 0
		mut j = open
		for j < toks[VEC_LEN] {
			let c = vec_get(toks, j)
			if tok_is(c, cstr("(")) != 0 {
				depth = depth + 1
			} else if tok_is(c, cstr(")")) != 0 {
				depth = depth - 1
				if depth == 0 {
					break
				}
			}
			j = j + 1
		}
		last = j
	}
	// the field starts after the previous line's ';' (a synthetic one too) or the '{'
	mut k = at - 1
	for k >= 0 && tok_is(vec_get(toks, k), cstr(";")) == 0 && tok_is(vec_get(toks, k), cstr("{{")) == 0 {
		k = k - 1
	}
	mut first = k + 1
	for first < at && vec_get(toks, first)[T_SYNTH] != 0 {
		first = first + 1
	}
	fx_add(fx_pre, first, str_cat3(fx_text(source, toks, at, last), cstr(" "), cstr("")))
	fx_rep[VEC_DATA][at] = cstr("")
	fx_span[VEC_DATA][at] = last + 1
	fx_triv[VEC_DATA][at] = cstr("")
	return 1
}

// rewrite_const_group expands `const ( A T = iota; B; C )` into one declaration per name:
// edition 1 has neither groups nor iota, so each value is written out with iota replaced
// by its index and an omitted value repeating the previous one.
fn rewrite_const_group(source i64, toks i64, at i64) i64 {
	let open = fx_next(toks, at)
	if open >= toks[VEC_LEN] || tok_is(vec_get(toks, open), cstr("(")) == 0 {
		return 0
	}
	mut close = open
	mut depth = 0
	for close < toks[VEC_LEN] {
		let c = vec_get(toks, close)
		if fx_open(c) != 0 {
			depth = depth + 1
		} else if fx_close(c) != 0 {
			depth = depth - 1
			if depth == 0 {
				break
			}
		}
		close = close + 1
	}
	let out = buf_new()
	mut spec_first = -1 // the previous spec's type-and-value tokens, for repetition
	mut spec_last = -1
	mut index = 0
	mut i = fx_next(toks, open)
	mut cursor = vec_get(toks, open)[T_END]
	for i < close {
		// one spec: Name [Type] [= Expr], ending at a ';'
		mut end = i
		mut d = 0
		for end < close {
			let c = vec_get(toks, end)
			if fx_open(c) != 0 {
				d = d + 1
			} else if fx_close(c) != 0 {
				d = d - 1
			} else if d == 0 && tok_is(c, cstr(";")) != 0 {
				break
			}
			end = end + 1
		}
		let last = fx_prev(toks, end)
		if last < i {
			i = fx_next(toks, end)
			continue
		}
		// trivia before the spec, one level less indented; the first starts the declaration
		if index == 0 {
			mut q = cursor
			for q < vec_get(toks, i)[T_START] && (i64(load8(source + q)) == ' ' || i64(load8(source + q)) == '\t') {
				q = q + 1
			}
			if i64(load8(source + q)) == '\n' {
				cursor = q + 1
				if i64(load8(source + cursor)) == '\t' {
					cursor = cursor + 1
				}
			}
		}
		fx_copy_dedent(out, source, cursor, vec_get(toks, i)[T_START])
		let name = vec_get(toks, i)
		buf_str(out, cstr("const "))
		buf_str(out, fx_renamed(name[T_TEXT]))
		let rest = fx_next(toks, i)
		if rest <= last {
			spec_first = rest
			spec_last = last
		}
		if spec_first < 0 {
			return 0
		}
		mut k = spec_first
		mut prev_end = vec_get(toks, i)[T_END]
		if rest > last {
			buf_byte(out, ' ')
			prev_end = vec_get(toks, spec_first)[T_START]
		}
		for k <= spec_last {
			let c = vec_get(toks, k)
			if c[T_SYNTH] == 0 {
				buf_bytes(out, source + prev_end, c[T_START] - prev_end)
				if c[T_KIND] == TK_IDENT && streq(c[T_TEXT], cstr("iota")) != 0 {
					buf_int(out, index)
				} else {
					buf_bytes(out, source + c[T_START], c[T_END] - c[T_START])
				}
				prev_end = c[T_END]
			}
			k = k + 1
		}
		cursor = vec_get(toks, last)[T_END]
		index = index + 1
		i = fx_next(toks, end)
	}
	fx_copy_dedent(out, source, cursor, vec_get(toks, close)[T_START])
	for out[VEC_LEN] > 0 && (i64(load8(out[VEC_DATA] + out[VEC_LEN] - 1)) == '\n' || i64(load8(out[VEC_DATA] + out[VEC_LEN] - 1)) == ' ' || i64(load8(out[VEC_DATA] + out[VEC_LEN] - 1)) == '\t') {
		out[VEC_LEN] = out[VEC_LEN] - 1
	}
	fx_rep[VEC_DATA][at] = str_slice(out[VEC_DATA], out[VEC_LEN])
	fx_span[VEC_DATA][at] = close + 1
	return 1
}

// fx_copy_dedent copies trivia with one tab less at each line start.
fn fx_copy_dedent(out i64, source i64, a i64, b i64) {
	mut i = a
	for i < b {
		let c = i64(load8(source + i))
		buf_byte(out, c)
		i = i + 1
		if c == '\n' && i < b && i64(load8(source + i)) == '\t' {
			i = i + 1
		}
	}
}

// fx_renamed is a name as the translator prints it: reserved words get a trailing '_'.
fn fx_renamed(name i64) i64 {
	if streq(name, cstr("match")) != 0 || streq(name, cstr("within")) != 0 || streq(name, cstr("limit")) != 0 || streq(name, cstr("guard")) != 0 || streq(name, cstr("parallel")) != 0 || streq(name, cstr("detach")) != 0 || streq(name, cstr("secret")) != 0 || streq(name, cstr("shared")) != 0 || streq(name, cstr("enum")) != 0 || streq(name, cstr("keep")) != 0 {
		return str_cat3(name, cstr("_"), cstr(""))
	}
	return name
}

// fx_rename_uses renames name to new in the function body after token from (up to the
// body's closing brace), except where it follows a '.' (a field or a package member).
fn fx_rename_uses(toks i64, from i64, name i64, new_ i64) i64 {
	mut depth = 0
	mut i = from
	for i < toks[VEC_LEN] {
		let t = vec_get(toks, i)
		if tok_is(t, cstr("{{")) != 0 {
			depth = depth + 1
		} else if tok_is(t, cstr("}}")) != 0 {
			if depth == 0 {
				return 0
			}
			depth = depth - 1
		} else if t[T_KIND] == TK_IDENT && streq(t[T_TEXT], name) != 0 {
			let p = fx_prev(toks, i)
			if p < 0 || tok_is(vec_get(toks, p), cstr(".")) == 0 {
				fx_rep[VEC_DATA][i] = new_
			}
		}
		i = i + 1
	}
	return 0
}

// matching_paren returns the ')' that closes the '(' at open, or the last token.
fn matching_paren(toks i64, open i64) i64 {
	mut depth = 0
	mut i = open
	for i < toks[VEC_LEN] {
		let t = vec_get(toks, i)
		if tok_is(t, cstr("(")) != 0 {
			depth = depth + 1
		} else if tok_is(t, cstr(")")) != 0 {
			depth = depth - 1
			if depth == 0 {
				return i
			}
		}
		i = i + 1
	}
	return toks[VEC_LEN] - 1
}

// fx_assigns reports a change to name between tokens a and b: an assignment or increment
// (name = ..., name += ..., name++), or name passed as mut.
fn fx_assigns(toks i64, a i64, b i64, name i64) i64 {
	mut i = a
	for i < b {
		let t = vec_get(toks, i)
		if t[T_KIND] == TK_IDENT && streq(t[T_TEXT], name) != 0 {
			let p = fx_prev(toks, i)
			mut pt = 0
			if p >= 0 {
				pt = vec_get(toks, p)
			}
			if pt != 0 && tok_is(pt, cstr("mut")) != 0 {
				return 1
			}
			if pt == 0 || tok_is(pt, cstr(".")) == 0 {
				let n = fx_next(toks, i)
				if n < toks[VEC_LEN] {
					let op = vec_get(toks, n)
					if tok_is(op, cstr("=")) != 0 || tok_is(op, cstr(":=")) != 0 || tok_is(op, cstr("++")) != 0 || tok_is(op, cstr("--")) != 0 || tok_is(op, cstr("+=")) != 0 || tok_is(op, cstr("-=")) != 0 || tok_is(op, cstr("*=")) != 0 || tok_is(op, cstr("/=")) != 0 || tok_is(op, cstr("%=")) != 0 || tok_is(op, cstr("&=")) != 0 || tok_is(op, cstr("|=")) != 0 || tok_is(op, cstr("^=")) != 0 || tok_is(op, cstr("<<=")) != 0 || tok_is(op, cstr(">>=")) != 0 {
						return 1
					}
				}
			}
		}
		i = i + 1
	}
	return 0
}

// fx_put writes n bytes of trivia, adding fx_cur_ind tabs after each newline that does not
// end an empty line.
fn fx_put(out i64, p i64, n i64) {
	mut i = 0
	for i < n {
		let c = i64(load8(p + i))
		buf_byte(out, c)
		if c == '\n' && i + 1 < n && i64(load8(p + i + 1)) != '\n' {
			fx_put_tabs(out)
		}
		i = i + 1
	}
}

// fx_arm_close is the text that closes a match arm before token at: on a line of its own when
// the token starts a line, else "} ".
fn fx_arm_close(source i64, toks i64, at i64, head i64, tail i64) i64 {
	let t = vec_get(toks, at)
	if source_has_newline(source, vec_get(toks, fx_prev(toks, at))[T_END], t[T_START]) != 0 {
		return str_cat3(head, source_indent(source, t), tail)
	}
	return cstr("}} ")
}

fn source_has_newline(source i64, a_in i64, b i64) i64 {
	mut a = a_in
	for a < b {
		if i64(load8(source + a)) == '\n' {
			return 1
		}
		a = a + 1
	}
	return 0
}

fn fx_put_tabs(out i64) {
	mut k = 0
	for k < fx_cur_ind {
		buf_byte(out, '\t')
		k = k + 1
	}
}

// fx_nest marks tokens a+1..b as one block deeper than in the source.
fn fx_nest(a i64, b i64) {
	mut i = a + 1
	for i <= b && i < fx_ind[VEC_LEN] {
		fx_ind[VEC_DATA][i] = fx_ind[VEC_DATA][i] + 1
		i = i + 1
	}
}
