// Parser: tokens to AST nodes. Accepts edition 1 (the syntax programs use) and edition 0 (the Go-like
// func/:= syntax that tin fix translates).
shared mut prog_fns []Fn
shared mut prog_consts []Decl
shared mut prog_vars []Decl
shared mut prog_types []Decl
shared mut prog_shapes []Decl
shared mut prog_uses []i64
shared mut prog_ons []i64
shared mut file_pkgs []str // per file: package name, "" for main
shared mut file_imports [][]Import // per file: its imports
shared mut file_ed1 []i64 // per file: 1 when parsed as edition 1 (generic instances re-parse with it)
shared mut file_sources []str // original byte buffers for the syntax-preserving edition-1 printer
shared mut file_tokens []i64 // token vectors paired with file_sources
shared mut cur_file i64

// Function declaration layout.
const F_INDEX = 22 // position in prog_fns (set by codegen)
const F_SIZE = 44

// Const, var and type declaration layout.
const D_SIZE = 18

shared mut p_shared i64

// Every AST node starts with its kind and position; expressions carry their type.
const N_TYPE = 6
const N_SIZE = 12

const EX_INT = 1
const EX_STR = 2
const EX_IDENT = 3
const EX_UNARY = 4
const EX_BINARY = 5
const EX_CALL = 6
const EX_INDEX = 7
const EX_REG = 8 // codegen-only: a value already in a register
const EX_CONV = 9 // checker-made conversion
const ST_BLOCK = 10
const ST_LET = 11
const ST_ASSIGN = 12
const ST_EXPR = 13
const ST_IF = 14
const ST_WHILE = 15
const ST_RETURN = 16
const ST_BREAK = 17
const ST_CONTINUE = 18
const EX_FLOAT = 20
const EX_NIL = 21
const EX_SELECT = 22
const EX_SLICE = 23
const EX_COMPOSITE = 24
const EX_TYPE = 25
const EX_SEQ = 26 // checker-made: run statements, then yield a value
const EX_FUNCREF = 27 // checker-made: address of a function
const EX_FUNCLIT = 28
const EX_MEM = 29 // checker-made: sized load/store at base + index*scale + off
const EX_ELEM = 39 // checker-made: bounds-checked slice or string element
const EX_TRY = 48
const EX_CATCH = 52 // E catch name { body }
const ST_FAIL = 53 // fail X
const EX_MUTARG = 54 // mut x: an argument for a mut parameter
const EX_INTERP = 55 // "text {x} {y:.2}": parts, values, format specs
const ST_CONST = 56 // local constant declarations; field 2 is their declaration vector
const EX_MATCH = 58 // edition 1 match expression or statement
const EX_UNIT = 59 // edition 1 typed unit literal
const EX_COALESCE = 60 // edition 1 nil coalescing
const EX_WRAP = 61 // edition 1 contextual fault message
const EX_BOUNDARY = 65 // edition 1 boundary expression
const ST_SELECT = 66
const ST_SCOPE = 67
const ST_DETACH = 68
const ST_ONCE = 69
const ST_USE = 70
const ST_ON = 71
const ST_BSTORE = 72 // checker-made: a boundary block's last expression, stored for its wrapper (ES_X)
const ST_MSTORE = 73 // checker-made: a match arm's value, stored in the match's value local (ES_X)
const ST_MULTI = 30
const ST_RANGE = 31
const ST_SWITCH = 32
const ST_LIST = 33 // statements spliced into the enclosing block
const ST_CALLMULTI = 34
const ST_GO = 35
const ST_DEFER = 36
const TX_NAME = 40
const TX_SLICE = 41
const TX_MAP = 42
const TX_PTR = 43
const TX_FUNC = 44
const TX_STRUCT = 45
const TX_ARRAY = 46
const TX_CHAN = 47
const TX_OPT = 49
const TX_DYN = 57 // dyn Shape: a fat reference, TX_A holds the shape's type expr
const TX_SECRET = 62 // edition 1 sensitive type wrapper
const TX_MAX = 63 // edition 1 bounded type wrapper
const TX_TUPLE = 64 // edition 1 tuple type

// Node fields by kind.
const TYX = 2
const ES_X = 2
const IF_INIT = 5
const TX_A = 2
const TX_B = 3
const ELEM_SAFE = 7 // index proven in range: no bounds check
// Binary.ovf and Unary.ovf (#362): wrapping by default for compiler-made nodes, checked when the checker says so.
const OVF_WRAP = -1 // written +%, -% or *%: arithmetic modulo 2^width
const OVF_NONE = 0 // no run-time check (compiler-made, @wrap, or proven in range)
const OVF_CHECK = 1 // panics when the result does not fit the type (or a shift count the width)
const ARM_POS = 0
const ARM_PATTERNS = 1
const ARM_GUARD = 2
const ARM_BODY = 3
const ARM_BLOCK = 4
const PAT_KIND = 0
const PAT_POS = 1
const PAT_A = 2
const PAT_B = 3
const PAT_NAME = 4
const PAT_CHILDREN = 5
const PAT_WILD = 1
const PAT_LITERAL = 2
const PAT_RANGE = 3
const PAT_VARIANT = 4
const PAT_NAME_KIND = 5
const BOUND_WITHIN = 1
const BOUND_LIMIT = 2
const BOUND_GUARD = 3
const BOUND_ARENA = 4
const BOUND_PARALLEL = 5
const BOUND_WITH = 6
const SELECT_ARM_POS = 0
const SELECT_ARM_NAME = 1
const SELECT_ARM_WAIT = 2
const SELECT_ARM_BODY = 3
const SELECT_ARM_BLOCK = 4
const CALL_METHOD = 9 // argument 0 is a method receiver (no call-site mut)
// Regions of reference values, for the ember/ingot rules.
const R_OWNED = 3 // a fresh keep() copy, only storable into ingot memory
const F_MUTS = 23 // vec: 1 for each mut parameter

shared mut p_toks []Token
shared mut p_i i64
shared mut p_nolit i64 // composite literals after a name are off in if/for/switch headers
shared mut p_edition1 i64
shared mut p_decl_mut i64
shared mut p_range_expr i64
shared mut p_pending_label str
shared mut p_saw_package i64
shared mut p_saw_topdecl i64
shared mut p_mutres i64 // the result list just parsed was marked mut
shared mut p_bangres i64 // the result list just parsed was written !T

fn node_new(kind i64, pos i64) i64 {
	let n = cast(Node, calloc(N_SIZE, 8))
	n.kind = kind
	n.pos = pos
	node_init_strs(n, kind)
	return cast(i64, n)
}

// node_init_strs gives the string fields of a new node of the given kind the empty string: a record
// is made zeroed, and a zero word is not a str.
fn node_init_strs(n Node, kind i64) {
	if kind == EX_IDENT || kind == EX_CALL || kind == EX_STR || kind == ST_LET || kind == EX_UNARY || kind == EX_BINARY || kind == ST_USE {
		cast(IdentExpr, n).name = ""
	} else if kind == EX_SELECT || kind == EX_FLOAT || kind == EX_CATCH {
		cast(SelectExpr, n).name = ""
	} else if kind == EX_FUNCLIT {
		cast(FuncLit, n).scoped = ""
	} else if kind == TX_NAME {
		cast(TypeName, n).pkg = ""
		cast(TypeName, n).name = ""
	} else if kind == ST_BREAK {
		cast(BreakStmt, n).label = ""
	} else if kind == ST_CONTINUE {
		cast(ContinueStmt, n).label = ""
	} else if kind == ST_RANGE {
		cast(RangeStmt, n).label = ""
	} else if kind == ST_WHILE {
		cast(WhileStmt, n).label = ""
	} else if kind == ST_SCOPE {
		cast(ScopeStmt, n).name = ""
	} else if kind == EX_UNIT {
		cast(UnitExpr, n).text = ""
		cast(UnitExpr, n).name = ""
	}
}

fn decl_new(pos i64, name str) Decl {
	let d = cast(Decl, calloc(D_SIZE, 8))
	d.pos = pos
	d.name = name
	d.file = cur_file
	d.shared_ = p_shared
	return cast(Decl, d)
}

fn fn_new(pos i64, name str) Fn {
	let f = cast(Fn, calloc(F_SIZE, 8))
	f.pos = pos
	f.name = name
	f.qname = ""
	f.recvname = ""
	f.params = []str{}
	f.ptypes = cast([]i64, cast(i64, []i64{}))
	f.rtypes = []i64{}
	f.muts = cast([]i64, cast(i64, []i64{}))
	f.file = cur_file
	return cast(Fn, f)
}

fn parse_setup() {
	prog_fns = cast([]Fn, []i64{})
	prog_consts = cast([]Decl, []i64{})
	prog_vars = cast([]Decl, []i64{})
	prog_types = cast([]Decl, []i64{})
	prog_shapes = cast([]Decl, []i64{})
	prog_uses = []i64{}
	prog_ons = []i64{}
	file_pkgs = []str{}
	file_imports = [][]Import{}
	file_ed1 = []i64{}
	file_sources = []str{}
	file_tokens = []i64{}
}

// parse keeps the edition-0 entry point stable. Tin 1 callers select the new grammar explicitly.
fn parse(toks []i64) {
	parse_mode(toks, 0)
}

fn parse_edition1(toks []i64) {
	parse_mode(toks, 1)
}

// parse_mode reads one file's declarations; cur_file must be its index in files.
fn parse_mode(toks []i64, edition i64) {
	p_toks = cast([]Token, cast([]i64, toks))
	p_i = 0
	p_nolit = 0
	p_edition1 = edition
	p_decl_mut = 1
	p_range_expr = 0
	p_pending_label = ""
	p_saw_package = 0
	p_saw_topdecl = 0
	file_pkgs = append(file_pkgs, "")
	file_imports = append(file_imports, []Import{})
	file_ed1 = append(file_ed1, edition)
	for p_peek().kind != TK_EOF {
		if p_edition1 != 0 && p_saw_topdecl != 0 && p_is("import") != 0 {
			p_fail_code(p_peek().pos, "E002 IMPORT_ORDER", "imports must precede declarations")
		}
		if p_edition1 != 0 && p_saw_package == 0 && p_is("package") == 0 && file_trusted[cur_file] == 0 {
			p_fail_code(p_peek().pos, "E001 PACKAGE_CLAUSE", "edition 1 files start with a package declaration")
		}
		if p_edition1 != 0 && p_is(";") == 0 && p_is("package") == 0 && p_is("import") == 0 {
			p_saw_topdecl = 1
		}
		if p_is(";") != 0 {
			p_next()
		} else if p_is("package") != 0 {
			if p_edition1 != 0 && p_saw_package != 0 {
				p_fail_code(p_peek().pos, "E001 PACKAGE_CLAUSE", "a file has one package declaration")
			}
			p_next()
			file_pkgs[cur_file] = p_expect_ident().text
			p_saw_package = 1
			if file_pkgs[cur_file] == "main" {
				file_pkgs[cur_file] = ""
			}
		} else if p_is("import") != 0 {
			p_next()
			if p_is("(") != 0 {
				if p_edition1 != 0 {
					p_fail_code(p_peek().pos, "E091 ONE_PER_DECLARATION", "edition 1 writes one import path per declaration")
				}
				p_next()
				for p_is(")") == 0 {
					if p_is(";") != 0 {
						p_next()
					} else {
						parse_import()
					}
				}
				p_next()
			} else {
				parse_import()
			}
		} else if p_edition1 != 0 && p_is("@") != 0 {
			let attrs = parse_attributes()
			if p_is("fn") == 0 {
				p_fail_found_code(p_peek().pos, "E040 ATTRIBUTE_PLACEMENT", "attributes here must precede a function", cast(i64, p_peek()))
			}
			let f = cast(Fn, parse_fn(0))
			f.attrs = cast([]i64, attrs)
			prog_fns = append(prog_fns, cast(Fn, f))
		} else if p_is("fn") != 0 {
			if p_edition1 == 0 {
				p_fail_code(p_peek().pos, "E090 OLD_SYNTAX", "this file is not edition 1 (the untyped fn dialect is gone): translate it with tin fix -edition 1")
			}
			prog_fns = append(prog_fns, cast(Fn, parse_fn(0)))
		} else if p_is("func") != 0 {
			if p_edition1 != 0 {
				p_fail_code(p_peek().pos, "E090 OLD_SYNTAX", "edition 1 uses 'fn', not 'func'")
			}
			prog_fns = append(prog_fns, cast(Fn, parse_fn(0)))
		} else if p_is("extern") != 0 {
			// the standard library declares the OS functions it calls (macOS) and the
			// instructions it lowers inline; the check reports any other extern (E801)
			p_next()
			prog_fns = append(prog_fns, cast(Fn, parse_fn(1)))
		} else if p_is("const") != 0 {
			p_next()
			if p_edition1 != 0 && p_is("(") != 0 {
				p_fail_code(p_peek().pos, "E091 ONE_PER_DECLARATION", "edition 1 declares one constant per declaration")
			}
			parse_group(1, cast([]i64, prog_consts))
		} else if p_edition1 != 0 && p_is("let") != 0 {
			p_next()
			p_decl_mut = 0
			parse_group(0, cast([]i64, prog_vars))
			p_decl_mut = 1
		} else if p_edition1 != 0 && p_is("mut") != 0 {
			p_next()
			p_decl_mut = 1
			parse_group(0, cast([]i64, prog_vars))
		} else if p_is("var") != 0 {
			if p_edition1 != 0 {
				p_fail_code(p_peek().pos, "E090 OLD_SYNTAX", "edition 1 uses 'let' or 'mut', not 'var'")
			}
			p_decl_mut = 1
			p_next()
			parse_group(0, cast([]i64, prog_vars))
		} else if p_word("shared") != 0 {
			p_next()
			if p_edition1 != 0 && p_is("mut") != 0 {
				// shared mutable state: the standard library only (the check reports E601)
				p_next()
				p_decl_mut = 1
			} else if p_edition1 != 0 {
				p_expect("let")
				p_decl_mut = 0
			} else {
				p_expect("var")
				p_decl_mut = 1
			}
			p_shared = 1
			parse_group(0, cast([]i64, prog_vars))
			p_shared = 0
		} else if p_is("type") != 0 {
			p_next()
			if p_is("(") != 0 {
				if p_edition1 != 0 {
					p_fail_code(p_peek().pos, "E091 ONE_PER_DECLARATION", "edition 1 declares one type per declaration")
				}
				p_next()
				for p_is(")") == 0 {
					if p_is(";") != 0 {
						p_next()
					} else {
						parse_type_decl()
					}
				}
				p_next()
			} else {
				parse_type_decl()
			}
		} else if p_word("shape") != 0 {
			prog_shapes = append(prog_shapes, cast(Decl, parse_shape_decl()))
		} else if p_edition1 != 0 && p_word("use") != 0 {
			prog_uses = append(prog_uses, parse_use_decl())
			use_global_decl(prog_uses)
		} else if p_edition1 != 0 && p_word("on") != 0 {
			prog_ons = append(prog_ons, parse_on_decl())
		} else {
			if p_edition1 != 0 {
				p_fail_found_code(p_peek().pos, "E020 UNEXPECTED", "expected a declaration (fn, const, let, mut, type, shape, use, on)", cast(i64, p_peek()))
			}
			p_fail_found_code(p_peek().pos, "E020 UNEXPECTED", "expected a declaration (func, var, const, type, shape)", cast(i64, p_peek()))
		}
	}
	if p_edition1 != 0 && p_saw_package == 0 && file_trusted[cur_file] == 0 {
		p_fail_code(p_peek().pos, "E001 PACKAGE_CLAUSE", "edition 1 files start with a package declaration")
	}
}

fn parse_import() {
	mut alias = ""
	if p_edition1 == 0 && p_peek().kind == TK_IDENT {
		alias = cast(Token, p_next()).text
	}
	let t = cast(Token, p_next())
	if t.kind != TK_STRING {
		p_fail_found_code(t.pos, "E020 UNEXPECTED", "expected an import path", cast(i64, t))
	}
	let path = t.text
	if len(alias) == 0 {
		// The package name is the last path element: "net/http" is http.
		alias = path
		mut i = 0
		for i < len(path) {
			if path[i] == '/' {
				alias = path[i + 1:]
			}
			i = i + 1
		}
	}
	let rec = cast(Import, calloc(2, 8))
	rec.alias = alias
	rec.path = path
	file_imports[cur_file] = append(file_imports[cur_file], rec)
	p_end()
}

fn parse_use_decl() i64 {
	let u = cast(UseStmt, node_new(ST_USE, cast(Token, p_next()).pos))
	u.name = p_expect_ident().text
	p_expect("=")
	u.init = parse_expr(1)
	u.file = cur_file
	p_end()
	return cast(i64, u)
}

// use_global_decl declares the per-core global of the package-level use just parsed, in
// source order among the other globals (#238).
fn use_global_decl(uses []i64) {
	let u = uses[len(uses) - 1]
	let d = decl_new(cast(Node, u).pos, cast(UseStmt, u).name)
	d.init = cast(UseStmt, u).init
	cast(UseStmt, u).decl = cast(i64, d)
	prog_vars = append(prog_vars, cast(Decl, d))
}

fn parse_on_decl() i64 {
	let pos = cast(Token, p_next()).pos
	let on_ = cast(OnStmt, node_new(ST_ON, pos))
	let saved = p_nolit
	p_nolit = 1
	on_.event = parse_expr(1)
	p_nolit = saved
	on_.body = parse_block()
	on_.file = cur_file
	return cast(i64, on_)
}

// parse_attributes reads the edition-1 attributes preceding a function or field.
fn parse_attributes() i64 {
	let attrs = []i64{}
	for p_is("@") != 0 {
		let pos = cast(Token, p_next()).pos
		let attr = cast(Attr, calloc(3, 8))
		attr.pos = pos
		attr.name = p_expect_ident().text
		mut args = []i64{}
		if p_is("(") != 0 {
			p_next()
			if p_is(")") == 0 {
				args = parse_expr_list()
			}
			p_expect(")")
		}
		attr.args = cast(i64, args)
		attrs = append(attrs, cast(i64, attr))
	}
	return cast(i64, attrs)
}

// parse_group reads one const/var declaration or a parenthesized group of them.
fn parse_group(is_const i64, decls []i64) {
	if p_is("(") == 0 {
		parse_value_spec(is_const, 0, cast([]i64, 0), 0, decls)
		return
	}
	if p_edition1 != 0 {
		p_fail_code(p_peek().pos, "E091 ONE_PER_DECLARATION", "edition 1 declares one name per declaration")
	}
	p_next()
	mut iota = 0
	mut last_init = cast([]i64, 0)
	mut last_type = 0
	for p_is(")") == 0 {
		if p_is(";") != 0 {
			p_next()
		} else {
			let d = cast(Decl, parse_value_spec(is_const, iota, last_init, last_type, decls))
			if is_const != 0 {
				last_init = d.inits
				last_type = d.type_
			}
			iota = iota + 1
		}
	}
	p_next()
}

fn parse_value_spec(is_const i64, iota i64, prev_init []i64, prev_type i64, decls []i64) i64 {
	let pos = p_peek().pos
	let names = []str{}
	names = append(names, p_expect_ident().text)
	for p_is(",") != 0 {
		p_next()
		names = append(names, p_expect_ident().text)
	}
	if p_edition1 != 0 && len(names) > 1 {
		p_fail_code(pos, "E091 ONE_PER_DECLARATION", "edition 1 declares one name per declaration")
	}
	mut ty = 0
	if p_is("=") == 0 && p_is(";") == 0 && p_is(")") == 0 && p_is("}}") == 0 {
		ty = parse_type()
	}
	mut inits = cast([]i64, 0)
	if p_is("=") != 0 {
		p_next()
		inits = parse_expr_list()
	}
	if is_const != 0 {
		if cast(i64, inits) == 0 {
			if ty != 0 || cast(i64, prev_init) == 0 {
				p_fail_code(pos, "E021 CONST_VALUES", "missing constant value")
			}
			inits = cast([]i64, prev_init)
			ty = prev_type
		}
		if len(inits) != len(names) {
			p_fail_code(pos, "E021 CONST_VALUES", "constant declaration count mismatch")
		}
	}
	mut first = 0
	mut i = 0
	for i < len(names) {
		let d = decl_new(pos, names[i])
		d.type_ = ty
		d.iota = iota
		d.mut_ = i64(is_const == 0 && p_decl_mut != 0)
		d.inits = cast([]i64, cast(i64, inits))
		if cast(i64, inits) != 0 && i < len(inits) {
			d.init = inits[i]
		}
		if is_const != 0 {
			if d.init == 0 {
				p_fail_code(pos, "E021 CONST_VALUES", "missing constant value")
			}
		}
		decls = append(decls, cast(i64, d))
		if first == 0 {
			first = cast(i64, d)
		}
		i = i + 1
	}
	p_end()
	return first
}

fn parse_type_decl() {
	let pos = p_peek().pos
	let d = decl_new(pos, p_expect_ident().text)
	// type Stack[T constraints.Any] ...: a name and a constraint after '[' (an array type has a length).
	if p_is("[") != 0 && p_peek2().kind == TK_IDENT {
		let save = p_i
		p_next()
		p_next()
		let generic = i64(p_is("]") == 0)
		p_i = save
		if generic != 0 {
			d.tparams = cast([]str, cast(i64, []i64{}))
			d.tcons = cast([]i64, cast(i64, []i64{}))
			parse_tparams(d.tparams, cast([]i64, d.tcons))
		}
	}
	if p_is("=") != 0 {
		p_next()
		d.iota = 1
	}
	d.type_ = parse_type()
	prog_types = append(prog_types, cast(Decl, d))
	p_end()
}

// ---- shapes ----
// parse_shape_decl reads a shape: shape Name { methods and listed shapes } or the
// named union shape Name = A | B | C. `shape` is a contextual word (like enum, fail
// and shared): it opens a declaration only at the top level, where no other form
// starts with that name, so a program may still use it as a name elsewhere. A method
// is a function node with no receiver and no body, so a shape signature and a func
// signature are parsed by the same code and cannot drift apart.
fn parse_shape_decl() i64 {
	let pos = cast(Token, p_next()).pos
	let d = decl_new(pos, p_expect_ident().text)
	d.shape_ = cast([]i64, cast(i64, []i64{}))
	d.union = cast([]i64, cast(i64, []i64{}))
	// shape Seq[T]: a shape may take type parameters, constrained like a generic type's.
	if p_is("[") != 0 {
		d.tparams = cast([]str, cast(i64, []i64{}))
		d.tcons = cast([]i64, cast(i64, []i64{}))
		parse_tparams(d.tparams, cast([]i64, d.tcons))
	}
	if p_is("=") != 0 {
		p_next()
		d.unionkind = 1
		d.union = cast([]i64, parse_type_union(parse_type()))
		p_end()
		return cast(i64, d)
	}
	p_expect("{{")
	for p_is("}}") == 0 {
		if p_is(";") != 0 {
			p_next()
			continue
		}
		let mpos = p_peek().pos
		// Name( ... is a method signature; a bare name lists another shape (composition),
		// and `=` above already took the union form.
		if p_peek2().kind == TK_PUNCT && p_peek2().text == "(" {
			d.shape_ = append(d.shape_, parse_shape_method(mpos))
		} else {
			d.union = append(d.union, parse_type())
		}
		p_end()
	}
	p_next()
	p_end()
	return cast(i64, d)
}

// parse_shape_method reads Name(params) results with no receiver and no body, keeping
// the mut marks, the variadic and the !T fault result a func declaration keeps.
fn parse_shape_method(pos i64) i64 {
	let m = fn_new(pos, p_expect_ident().text)
	parse_params(m)
	p_mutres = 0
	p_bangres = 0
	m.rtypes = parse_results()
	m.mutres = p_mutres
	m.bang = p_bangres
	return cast(i64, m)
}

fn p_peek() Token {
	return p_toks[p_i]
}

fn p_peek2() Token {
	if p_i + 1 < len(p_toks) {
		return p_toks[p_i + 1]
	}
	return p_toks[p_i]
}

fn p_next() i64 {
	let t = p_peek()
	if t.kind != TK_EOF {
		p_i = p_i + 1
	}
	return cast(i64, t)
}

// p_is reports whether the next token is the given keyword or punctuation.
fn p_is(text str) i64 {
	let t = p_peek()
	return i64((t.kind == TK_KEYWORD || t.kind == TK_PUNCT) && t.text == text)
}

// p_word recognizes contextual words and edition-1 keywords by spelling.
fn p_word(text str) i64 {
	let t = p_peek()
	return i64((t.kind == TK_IDENT || (p_edition1 != 0 && t.kind == TK_KEYWORD)) && t.text == text)
}

fn tok_is(t Token, text str) i64 {
	return i64((t.kind == TK_KEYWORD || t.kind == TK_PUNCT) && t.text == text)
}

// p_end finishes a statement or declaration: a semicolon, or nothing before } or ).
fn p_end() {
	if p_is(";") != 0 {
		p_next()
		return
	}
	if p_is("}}") != 0 || p_is(")") != 0 || p_peek().kind == TK_EOF {
		return
	}
	if p_edition1 != 0 {
		p_fail_found_code(p_peek().pos, "E020 UNEXPECTED", "expected a newline or end of block", cast(i64, p_peek()))
	}
	p_expect(";")
}

fn buf_describe(b []u8, t Token) {
	let k = t.kind
	if k == TK_EOF {
		buf_str(b, "end of file")
	} else if k == TK_IDENT {
		buf_str(b, "name '")
		buf_str(b, t.text)
		buf_byte(b, '\'')
	} else if k == TK_INT || k == TK_FLOAT {
		buf_str(b, "a number")
	} else if k == TK_STRING {
		buf_str(b, "a string")
	} else if k == TK_PUNCT && t.text == ";" && t.val != 0 {
		buf_str(b, "newline")
	} else {
		buf_byte(b, '\'')
		buf_str(b, t.text)
		buf_byte(b, '\'')
	}
}

// p_fail_code and p_fail_found_code stop with a coded error (docs/ERRORS.md).
fn p_fail_code(pos i64, code str, msg str) {
	let e = cast([]i64, err_code(pos, code))
	buf_str(cast([]u8, e), msg)
	fatal(cast([]u8, e))
}

fn p_fail_found_code(pos i64, code str, msg str, t i64) {
	let e = cast([]i64, err_code(pos, code))
	buf_str(cast([]u8, e), msg)
	buf_str(cast([]u8, e), ", found ")
	buf_describe(cast([]u8, e), cast(Token, t))
	fatal(cast([]u8, e))
}

fn p_expect(text str) i64 {
	if p_is(text) == 0 {
		let e = cast([]i64, err_code(p_peek().pos, "E020 UNEXPECTED"))
		buf_str(cast([]u8, e), "expected '")
		buf_str(cast([]u8, e), text)
		buf_str(cast([]u8, e), "', found ")
		buf_describe(cast([]u8, e), p_peek())
		fatal(cast([]u8, e))
	}
	return p_next()
}

fn p_expect_ident() Token {
	if p_peek().kind != TK_IDENT {
		p_fail_found_code(p_peek().pos, "E020 UNEXPECTED", "expected a name", cast(i64, p_peek()))
	}
	return cast(Token, p_next())
}

// ---- types ----
fn starts_type() i64 {
	let t = p_peek()
	return i64(t.kind == TK_IDENT || p_is("[") != 0 || p_is("map") != 0 || p_is("*") != 0 || p_is("func") != 0 || p_is("struct") != 0 || p_is("?") != 0 || p_is("mut") != 0 || (p_edition1 != 0 && (p_word("secret") != 0 || p_is("fn") != 0)))
}

fn parse_type() i64 {
	let ty = cast(Node, parse_type_base())
	if p_edition1 != 0 && p_word("max") != 0 {
		let bounded = cast(TypeExpr, node_new(TX_MAX, ty.pos))
		bounded.a = cast(i64, ty)
		p_next()
		bounded.b = parse_expr(1)
		return cast(i64, bounded)
	}
	return cast(i64, ty)
}

fn parse_type_base() i64 {
	let pos = p_peek().pos
	if p_edition1 != 0 && p_word("secret") != 0 {
		p_next()
		let secret_ = cast(TypeExpr, node_new(TX_SECRET, pos))
		secret_.a = parse_type()
		return cast(i64, secret_)
	}
	// Standard-library files are edition 0 and opt parameters in with secret too (#239).
	if p_edition1 == 0 && file_trusted[cur_file] != 0 && p_word("secret") != 0 && (p_peek2().kind == TK_IDENT || tok_is(p_peek2(), "[") != 0 || tok_is(p_peek2(), "?") != 0) {
		p_next()
		let libsecret = cast(TypeExpr, node_new(TX_SECRET, pos))
		libsecret.a = parse_type()
		return cast(i64, libsecret)
	}
	if p_is("[") != 0 {
		p_next()
		if p_is("]") != 0 {
			p_next()
			let s = cast(TypeExpr, node_new(TX_SLICE, pos))
			s.a = parse_type()
			return cast(i64, s)
		}
		let a = cast(TypeExpr, node_new(TX_ARRAY, pos))
		a.a = parse_expr(1)
		p_expect("]")
		a.b = parse_type()
		return cast(i64, a)
	}
	if p_is("map") != 0 {
		p_next()
		p_expect("[")
		let m = cast(TypeExpr, node_new(TX_MAP, pos))
		m.a = parse_type()
		p_expect("]")
		m.b = parse_type()
		return cast(i64, m)
	}
	if p_is("*") != 0 {
		if p_edition1 != 0 {
			p_fail_code(pos, "E090 OLD_SYNTAX", "edition 1 does not use pointer types")
		}
		p_next()
		let pt = cast(TypeExpr, node_new(TX_PTR, pos))
		pt.a = parse_type()
		return cast(i64, pt)
	}
	if p_is("?") != 0 {
		p_next()
		let ot = cast(TypeExpr, node_new(TX_OPT, pos))
		ot.a = parse_type()
		return cast(i64, ot)
	}
	if p_edition1 != 0 && p_is("(") != 0 {
		let tuple = cast(TypeExpr, node_new(TX_TUPLE, pos))
		ptl_muts = 0
		tuple.a = cast(i64, parse_type_list())
		if len(cast([]i64, tuple.a)) == 0 {
			p_fail_code(pos, "E043 EMPTY_TUPLE", "a tuple type needs at least one element type")
		}
		return cast(i64, tuple)
	}
	if p_is("func") != 0 || (p_edition1 != 0 && p_is("fn") != 0) {
		if p_edition1 != 0 && p_is("func") != 0 {
			p_fail_code(pos, "E090 OLD_SYNTAX", "edition 1 uses 'fn' for function types")
		}
		p_next()
		let ft = cast(TypeExpr, node_new(TX_FUNC, pos))
		ptl_muts = 0
		ft.a = cast(i64, parse_type_list())
		ft.args = cast(i64, cast([]i64, ptl_muts))
		ft.b = cast(i64, parse_results())
		return cast(i64, ft)
	}
	if p_is("struct") != 0 {
		p_next()
		return parse_struct_body(pos)
	}
	if p_word("enum") != 0 && tok_is(p_peek2(), "{{") != 0 {
		p_next()
		return parse_enum_body(pos)
	}
	// dyn Shape: a fat reference to anything satisfying Shape. Contextual: it is a
	// keyword in type position only when a shape name follows, so a type of its own
	// named `dyn` still resolves as a name.
	if p_word("dyn") != 0 && p_peek2().kind == TK_IDENT {
		p_next()
		let dy = cast(TypeExpr, node_new(TX_DYN, pos))
		dy.a = parse_type()
		return cast(i64, dy)
	}
	let t = p_expect_ident()
	if t.text == "chan" {
		if p_edition1 != 0 {
			p_fail_code(pos, "E090 OLD_SYNTAX", "edition 1 does not have channel types")
		}
		let c = cast(TypeExpr, node_new(TX_CHAN, pos))
		c.a = parse_type()
		return cast(i64, c)
	}
	let n = cast(TypeExpr, node_new(TX_NAME, pos))
	cast(TypeName, n).name = t.text
	if p_is(".") != 0 {
		p_next()
		cast(TypeName, n).pkg = t.text
		cast(TypeName, n).name = p_expect_ident().text
	}
	if p_is("[") != 0 {
		p_next()
		let args = []i64{}
		for p_is("]") == 0 {
			args = append(args, parse_type())
			if p_is(",") == 0 {
				break
			}
			p_next()
		}
		p_expect("]")
		n.args = cast(i64, cast([]i64, args))
	}
	return cast(i64, n)
}

// parse_tparams reads [T constraints.Any, U i64 | f64] into f's (or a type decl's) names and constraints.
fn parse_tparams(names []str, cons []i64) {
	p_expect("[")
	for p_is("]") == 0 {
		names = append(names, p_expect_ident().text)
		mut c = 0
		if p_is(",") == 0 && p_is("]") == 0 {
			let first = parse_type()
			c = parse_type_union(first)
		}
		cons = append(cons, c)
		if p_is(",") == 0 {
			break
		}
		p_next()
	}
	p_expect("]")
}

// parse_type_union reads the rest of a `A | B | C` union after its first member. A
// generic type parameter's constraint and a shape's named union are one grammar.
fn parse_type_union(first i64) i64 {
	let c = []i64{}
	c = append(c, first)
	for p_is("|") != 0 {
		p_next()
		c = append(c, parse_type())
	}
	return cast(i64, c)
}

// parse_struct_attr reads the checked JSON field-name attribute.
fn parse_struct_attr(pos i64) str {
	p_expect("@")
	let name = p_expect_ident().text
	if name != "json" {
		p_fail_code(pos, "E041 UNKNOWN_ATTRIBUTE", "unknown struct attribute; supported attributes are @json(\"name\")")
	}
	p_expect("(")
	let value = cast(Token, p_next())
	if value.kind != TK_STRING {
		p_fail_code(pos, "E042 ATTRIBUTE_ARGS", "@json expects one string field name")
	}
	p_expect(")")
	return value.text
}

// parse_struct_body reads { a, b int; c string } into a vec of [name, type expr, json name].
// parse_enum_body reads enum { A(x T, y U), B, C }: a struct underneath, with a hidden tag
// field ($tag, the variant's index) and each variant's fields named Variant.field.
fn parse_enum_body(pos i64) i64 {
	let st = cast(TypeExpr, node_new(TX_STRUCT, pos))
	let fields = []i64{}
	let variants = []EnumVariant{}
	let tag = cast(ParsedField, calloc(4, 8))
	tag.name = "$tag"
	let tt = cast(TypeExpr, node_new(TX_NAME, pos))
	cast(TypeName, tt).name = "i64"
	tag.ty = cast(i64, tt)
	tag.attr = ""
	fields = append(fields, cast(i64, tag))
	p_expect("{{")
	for p_is("}}") == 0 {
		if p_is(";") != 0 || p_is(",") != 0 {
			p_next()
			continue
		}
		let vname = p_expect_ident().text
		let first = len(cast([]i64, fields))
		if p_is("(") != 0 {
			p_next()
			if p_edition1 != 0 && enum_fields_named() == 0 {
				mut field_index = 0
				for p_is(")") == 0 {
					let ty = parse_type()
					let f = cast(ParsedField, calloc(4, 8))
					f.name = enum_field_name(vname, field_index)
					f.ty = ty
					f.attr = "" // no attributes
					fields = append(fields, cast(i64, f))
					field_index = field_index + 1
					if p_is(",") == 0 {
						break
					}
					p_next()
				}
			} else {
				mut pending = []str{}
				for p_is(")") == 0 {
					pending = append(pending, p_expect_ident().text)
					if p_is(",") != 0 {
						p_next()
						continue
					}
					let ty = parse_type()
					mut i = 0
					for i < len(pending) {
						let f = cast(ParsedField, calloc(4, 8))
						f.name = vname + "." + pending[i]
						f.ty = ty
						f.attr = "" // no attributes
						fields = append(fields, cast(i64, f))
						i = i + 1
					}
					pending = []str{}
					if p_is(",") != 0 {
						p_next()
					}
				}
				if len(pending) > 0 {
					p_fail_code(pos, "E044 ENUM_FIELD_TYPES", "an enum variant's fields need types: Variant(name Type, ...)")
				}
			}
			p_next()
		}
		let v = cast(EnumVariant, calloc(3, 8))
		v.name = vname
		v.first = first
		v.count = len(cast([]i64, fields)) - first
		variants = append(variants, v)
	}
	p_next()
	if len(variants) == 0 {
		p_fail_code(pos, "E045 EMPTY_ENUM", "an enum needs at least one variant")
	}
	st.a = cast(i64, fields)
	st.b = cast(i64, variants)
	return cast(i64, st)
}

// enum_fields_named reports a variant whose fields have names (Circle(r f64), Rect(w, h f64)),
// which edition 1 reads as edition 0 does: some field is a name followed by its type. Positional
// fields (Failed(str, i64)) are types alone.
fn enum_fields_named() i64 {
	mut depth = 0
	mut i = p_i
	for i + 1 < len(p_toks) {
		let t = p_toks[i]
		if tok_is(t, "(") != 0 || tok_is(t, "[") != 0 {
			depth = depth + 1
		} else if tok_is(t, ")") != 0 || tok_is(t, "]") != 0 {
			if depth == 0 {
				return 0
			}
			depth = depth - 1
		} else if depth == 0 && t.kind == TK_IDENT {
			let n = p_toks[i + 1]
			if n.kind == TK_IDENT || tok_is(n, "[") != 0 || tok_is(n, "?") != 0 || n.kind == TK_KEYWORD {
				let prev = p_toks[i - 1]
				if tok_is(cast(Token, prev), "(") != 0 || tok_is(cast(Token, prev), ",") != 0 {
					return 1
				}
			}
		}
		i = i + 1
	}
	return 0
}

fn enum_field_name(variant str, index i64) str {
	let out = buf_new()
	buf_str(out, variant)
	buf_str(out, ".$")
	let digits = buf_new()
	mut value = index
	if value == 0 {
		buf_byte(digits, '0')
	} else {
		for value > 0 {
			buf_byte(digits, '0' + value % 10)
			value = value / 10
		}
	}
	mut i = len(digits) - 1
	for i >= 0 {
		buf_byte(out, i64(digits[i]))
		i = i - 1
	}
	return str(out)
}

fn parse_struct_body(pos i64) i64 {
	let st = cast(TypeExpr, node_new(TX_STRUCT, pos))
	let fields = []i64{}
	p_expect("{{")
	for p_is("}}") == 0 {
		if p_is(";") != 0 {
			p_next()
			continue
		}
		mut attrs = cast([]i64, 0)
		if p_edition1 != 0 && p_is("@") != 0 {
			attrs = cast([]i64, parse_attributes())
		}
		let names = []str{}
		names = append(names, p_expect_ident().text)
		for p_is(",") != 0 {
			p_next()
			names = append(names, p_expect_ident().text)
		}
		let ty = parse_type()
		mut attr = ""
		if p_edition1 != 0 {
			attr = struct_json_attr(attrs, pos)
		} else if p_is("@") != 0 {
			attr = parse_struct_attr(pos)
		}
		mut i = 0
		for i < len(names) {
			let f = cast(ParsedField, calloc(4, 8))
			f.name = names[i]
			f.ty = ty
			f.attr = attr
			if p_edition1 != 0 {
				f.attrs = cast(i64, attrs)
			}
			fields = append(fields, cast(i64, f))
			i = i + 1
		}
		p_end()
	}
	p_next()
	st.a = cast(i64, fields)
	return cast(i64, st)
}

fn struct_json_attr(attrs []i64, pos i64) str {
	if cast(i64, attrs) == 0 {
		return ""
	}
	mut i = 0
	for i < len(attrs) {
		let attr = cast(Attr, attrs[i])
		if attr.name != "json" {
			p_fail_code(attr.pos, "E041 UNKNOWN_ATTRIBUTE", "unknown struct attribute; supported attributes are @json(\"name\")")
		}
		if attr.name == "json" {
			let args = cast([]i64, attr.args)
			if len(args) != 1 || cast(Node, args[0]).kind != EX_STR {
				p_fail_code(pos, "E042 ATTRIBUTE_ARGS", "@json expects one string field name")
			}
			return cast(StrLit, args[0]).ptr
		}
		i = i + 1
	}
	return ""
}

// parse_type_list reads (T1, T2) or (a T1, b T2) and returns the types.
shared mut ptl_muts i64 // parse_type_list: bit i set when parameter i was written `mut T`

fn parse_type_list() []i64 {
	let types = []i64{}
	p_expect("(")
	for p_is(")") == 0 {
		if p_is("...") != 0 {
			p_next()
		}
		let t2 = p_peek2()
		if p_peek().kind == TK_IDENT && tok_is(cast(Token, t2), ",") == 0 && tok_is(cast(Token, t2), ")") == 0 && tok_is(cast(Token, t2), ".") == 0 && p_is("mut") == 0 {
			p_next()
		}
		if p_is("mut") != 0 {
			p_next()
			ptl_muts = ptl_muts | (1 << len(types))
		}
		types = append(types, parse_type())
		if p_is(",") == 0 {
			break
		}
		p_next()
	}
	p_expect(")")
	return cast([]i64, types)
}

// parse_results reads a func's result types: none, T, or (T1, T2) with optional names.
fn parse_results() []i64 {
	if p_is("!") != 0 {
		// !T, !(A, B) or ! alone: the results, then a fault.
		let bpos = cast(Token, p_next()).pos
		p_bangres = 1
		mut br = []i64{}
		if p_is("(") != 0 {
			br = parse_type_list()
		} else if starts_type() != 0 && p_is("{{") == 0 {
			br = append(br, parse_type())
		}
		let ft = cast(TypeExpr, node_new(TX_NAME, bpos))
		cast(TypeName, ft).name = "fault"
		br = append(br, cast(i64, ft))
		return cast([]i64, br)
	}
	if p_is("(") != 0 {
		return parse_type_list()
	}
	let r = []i64{}
	if p_is("mut") != 0 {
		p_next()
		p_mutres = 1
	}
	if starts_type() != 0 && p_is("{{") == 0 {
		r = append(r, parse_type())
	}
	return cast([]i64, r)
}

// ---- declarations ----
// parse_fn reads fn/func declarations: receiver, grouped typed params, results, body.
fn parse_fn(is_extern i64) i64 {
	let at = p_i
	let pos = cast(Token, p_next()).pos
	let f = fn_new(pos, "")
	f.toks = cast([]i64, cast(i64, p_toks))
	f.tokat = at
	f.extern_ = is_extern
	if p_is("(") != 0 {
		p_next()
		f.recvname = p_expect_ident().text
		if p_is("mut") != 0 {
			p_next()
			f.recvmut = 1
		}
		f.recv = parse_type()
		p_expect(")")
	}
	f.name = p_expect_ident().text
	if p_is("[") != 0 {
		f.tparams = cast([]str, cast(i64, []i64{}))
		f.tcons = cast([]i64, cast(i64, []i64{}))
		parse_tparams(f.tparams, cast([]i64, f.tcons))
	}
	// A method of a generic type is generic over the type's parameters.
	let rx = f.recv
	if rx != 0 && cast(Node, rx).kind == TX_NAME && cast(TypeExpr, rx).args != 0 {
		if cast(i64, f.tparams) == 0 {
			f.tparams = cast([]str, cast(i64, []i64{}))
			f.tcons = cast([]i64, cast(i64, []i64{}))
		}
		mut ri = 0
		for ri < len(cast([]i64, cast(TypeExpr, rx).args)) {
			let a = cast([]i64, cast(TypeExpr, rx).args)[ri]
			if cast(Node, a).kind != TX_NAME || len(cast(TypeName, a).pkg) != 0 || cast(TypeExpr, a).args != 0 {
				p_fail_code(pos, "E506 RECEIVER_TYPE_PARAMS", "a method's receiver lists its type's parameters by name, like (s Stack[T])")
			}
			mut vs1 = f.tparams
			vs1 = append(vs1, cast(TypeName, a).name)
			mut vs2 = cast([]i64, f.tcons)
			vs2 = append(vs2, 0)
			ri = ri + 1
		}
	}
	parse_params(f)
	p_mutres = 0
	p_bangres = 0
	f.rtypes = parse_results()
	f.mutres = p_mutres
	f.bang = p_bangres
	if is_extern != 0 {
		p_end()
		return cast(i64, f)
	}
	f.body = parse_block()
	return cast(i64, f)
}

fn parse_params(f Fn) {
	p_expect("(")
	mut pending = 0
	for p_is(")") == 0 {
		if p_is("...") != 0 {
			p_next()
			f.variadic = 1
			if p_is(")") == 0 {
				parse_type()
			}
			break
		}
		if p_word("dyn") != 0 && p_peek2().kind == TK_IDENT {
			// `dyn W` where a parameter name belongs: a dyn parameter needs a name.
			p_fail_code(p_peek().pos, "E515 DYN_PARAM_NAME", "a parameter of type dyn S needs a name: write w dyn S")
		}
		f.params = append(f.params, p_expect_ident().text)
		f.ptypes = append(f.ptypes, 0)
		f.muts = append(f.muts, 0)
		pending = pending + 1
		if p_is(",") == 0 && p_is(")") == 0 {
			if p_is("...") != 0 {
				p_next()
				f.variadic = 1
			}
			mut ismut = 0
			if p_is("mut") != 0 {
				p_next()
				ismut = 1
			}
			let ty = parse_type()
			mut i = len(f.ptypes) - pending
			for i < len(f.ptypes) {
				f.ptypes[i] = ty
				f.muts[i] = ismut
				i = i + 1
			}
			pending = 0
		}
		if p_is(",") == 0 {
			break
		}
		p_next()
	}
	p_expect(")")
}

// ---- statements ----
fn parse_block() i64 {
	let b = cast(Block, node_new(ST_BLOCK, cast(Token, p_expect("{{")).pos))
	b.stmts = []i64{}
	for p_is("}}") == 0 {
		if p_peek().kind == TK_EOF {
			p_fail_code(p_peek().pos, "E020 UNEXPECTED", "expected '}}', found end of file")
		}
		let s = parse_stmt()
		if cast(Node, s).kind == ST_LIST {
			mut i = 0
			for i < len(cast(ListStmt, s).stmts) {
				b.stmts = append(b.stmts, cast(ListStmt, s).stmts[i])
				i = i + 1
			}
		} else if cast(Node, s).kind != ST_BLOCK || len(cast(Block, s).stmts) > 0 || cast(Node, s).pos != 0 {
			b.stmts = append(b.stmts, s)
		}
	}
	p_next()
	return cast(i64, b)
}

fn empty_block(pos i64) i64 {
	let b = cast(Block, node_new(ST_BLOCK, pos))
	b.stmts = []i64{}
	return cast(i64, b)
}

fn parse_stmt() i64 {
	let pos = p_peek().pos
	if p_is(";") != 0 {
		p_next()
		return empty_block(0)
	}
	if p_edition1 != 0 && p_peek().kind == TK_IDENT && tok_is(p_peek2(), ":") != 0 {
		let label = cast(Token, p_next()).text
		p_next()
		if p_is("for") == 0 {
			p_fail_found_code(p_peek().pos, "E050 LABEL_PLACEMENT", "a label must precede a loop", cast(i64, p_peek()))
		}
		p_pending_label = label
		return parse_for()
	}
	if p_is("let") != 0 {
		p_next()
		return parse_binding(pos, 0)
	}
	if p_edition1 != 0 && p_is("mut") != 0 {
		p_next()
		return parse_binding(pos, 1)
	}
	if p_edition1 != 0 && p_word("use") != 0 && p_peek2().kind == TK_IDENT && tok_is(p_peek3(), "=") != 0 {
		return parse_use_decl()
	}
	if p_edition1 != 0 && p_word("scope") != 0 && p_peek2().kind == TK_IDENT && tok_is(p_peek3(), "{{") != 0 {
		p_next()
		let scope_ = cast(ScopeStmt, node_new(ST_SCOPE, pos))
		scope_.name = p_expect_ident().text
		scope_.body = parse_block()
		return cast(i64, scope_)
	}
	if p_edition1 != 0 && p_word("detach") != 0 && tok_is(p_peek2(), "{{") != 0 {
		p_next()
		let detach_ = cast(BodyStmt, node_new(ST_DETACH, pos))
		detach_.block = parse_block()
		return cast(i64, detach_)
	}
	if p_edition1 != 0 && p_word("once") != 0 && tok_is(p_peek2(), "{{") != 0 {
		p_next()
		let once_ = cast(BodyStmt, node_new(ST_ONCE, pos))
		once_.block = parse_block()
		return cast(i64, once_)
	}
	if p_edition1 != 0 && p_word("select") != 0 && tok_is(p_peek2(), "{{") != 0 {
		return parse_select()
	}
	if p_is("var") != 0 {
		if p_edition1 != 0 {
			p_fail_code(pos, "E090 OLD_SYNTAX", "edition 1 uses 'let' or 'mut', not 'var'")
		}
		p_next()
		return parse_local_var(pos)
	}
	if p_is("const") != 0 {
		if p_edition1 != 0 {
			p_fail_code(pos, "E090 OLD_SYNTAX", "edition 1 allows const only at package scope")
		}
		p_next()
		let c = cast(ConstStmt, node_new(ST_CONST, pos))
		c.decls = []i64{}
		parse_group(1, c.decls)
		return cast(i64, c)
	}
	if p_is("if") != 0 {
		return parse_if()
	}
	if p_is("while") != 0 {
		if p_edition1 != 0 {
			p_fail_code(pos, "E090 OLD_SYNTAX", "edition 1 uses 'for' loops, not 'while'")
		}
		p_next()
		let w = cast(WhileStmt, node_new(ST_WHILE, pos))
		let saved = p_nolit
		p_nolit = 1
		w.cond = parse_expr(1)
		p_nolit = saved
		w.body = parse_block()
		return cast(i64, w)
	}
	if p_is("for") != 0 {
		return parse_for()
	}
	if p_is("switch") != 0 {
		if p_edition1 != 0 {
			p_fail_code(pos, "E090 OLD_SYNTAX", "edition 1 uses 'match', not 'switch'")
		}
		return parse_switch()
	}
	if p_is("return") != 0 {
		p_next()
		let r = cast(ReturnStmt, node_new(ST_RETURN, pos))
		if p_is(";") == 0 && p_is("}}") == 0 {
			let vals = parse_expr_list()
			if len(vals) == 1 {
				r.value = vals[0]
			} else {
				r.values = cast([]i64, vals)
			}
		}
		p_end()
		return cast(i64, r)
	}
	if p_word("fail") != 0 {
		let t2 = p_peek2()
		if tok_is(cast(Token, t2), ":=") == 0 && tok_is(cast(Token, t2), "=") == 0 && tok_is(cast(Token, t2), ",") == 0 && tok_is(cast(Token, t2), ".") == 0 {
			p_next()
			let fs = cast(FailStmt, node_new(ST_FAIL, pos))
			fs.x = parse_expr(1)
			p_end()
			return cast(i64, fs)
		}
	}
	if p_is("break") != 0 {
		p_next()
		let b = cast(BreakStmt, node_new(ST_BREAK, pos))
		if p_edition1 != 0 && p_peek().kind == TK_IDENT {
			b.label = cast(Token, p_next()).text
		}
		p_end()
		return cast(i64, b)
	}
	if p_is("continue") != 0 {
		p_next()
		let c = cast(ContinueStmt, node_new(ST_CONTINUE, pos))
		if p_edition1 != 0 && p_peek().kind == TK_IDENT {
			c.label = cast(Token, p_next()).text
		}
		p_end()
		return cast(i64, c)
	}
	if p_is("go") != 0 || p_is("defer") != 0 {
		if p_edition1 != 0 && p_is("go") != 0 {
			p_fail_code(pos, "E090 OLD_SYNTAX", "edition 1 uses 'scope' or 'detach', not 'go'")
		}
		mut kind = ST_GO
		if p_is("defer") != 0 {
			kind = ST_DEFER
		}
		p_next()
		let g = cast(GoStmt, node_new(kind, pos))
		g.call = parse_expr(1)
		if cast(Node, g.call).kind != EX_CALL {
			p_fail_code(pos, "E055 DEFER_CALL", "expected a function call")
		}
		p_end()
		return cast(i64, g)
	}
	if p_is("{{") != 0 {
		return parse_block()
	}
	let s = parse_simple_stmt(parse_expr_list())
	p_end()
	return s
}

fn parse_select() i64 {
	let select_ = node_new(ST_SELECT, cast(Token, p_next()).pos)
	cast(SelectStmt, select_).arms = []i64{}
	p_expect("{{")
	for p_is("}}") == 0 {
		if p_is(";") != 0 {
			p_next()
			continue
		}
		let arm = cast(SelectArm, calloc(5, 8))
		arm.pos = p_peek().pos
		mut name = ""
		if p_is("let") != 0 {
			p_next()
			name = p_expect_ident().text
			p_expect("=")
		}
		let saved = p_nolit
		p_nolit = 1
		let wait = parse_expr(1)
		p_nolit = saved
		p_expect("=>")
		mut body = 0
		mut is_block = 0
		if p_is("{{") != 0 {
			body = parse_block()
			is_block = 1
		} else if p_is("return") != 0 || p_word("fail") != 0 || p_is("break") != 0 || p_is("continue") != 0 {
			body = parse_stmt()
		} else {
			body = parse_expr(1)
		}
		arm.name = name
		arm.wait = wait
		arm.body = body
		arm.block = is_block
		cast(SelectStmt, select_).arms = append(cast(SelectStmt, select_).arms, cast(i64, arm))
		if p_is(";") != 0 {
			p_next()
		}
	}
	if len(cast(SelectStmt, select_).arms) == 0 {
		p_fail_code(cast(Node, select_).pos, "E051 EMPTY_SELECT", "select needs at least one arm")
	}
	p_next()
	return select_
}

// parse_binding reads a Tin 1 let/mut declaration. The target shape is intentionally
// represented with the existing ST_LET/ST_MULTI nodes so later compiler passes share one tree.
fn parse_binding(pos i64, is_mut i64) i64 {
	if p_is("(") != 0 {
		p_next()
		let names = []str{}
		names = append(names, p_expect_ident().text)
		for p_is(",") != 0 {
			p_next()
			names = append(names, p_expect_ident().text)
		}
		p_expect(")")
		p_expect("=")
		let m = cast(MultiStmt, node_new(ST_MULTI, pos))
		m.targets = cast([]i64, idents_of(pos, names))
		m.values = parse_expr_list()
		m.define = 1
		m.mut_ = is_mut
		p_end()
		return cast(i64, m)
	}
	let l = cast(LetStmt, node_new(ST_LET, pos))
	l.name = p_expect_ident().text
	if p_is("=") == 0 {
		l.type_ = parse_type()
	}
	if p_is("=") != 0 {
		p_next()
		l.init = parse_catch(parse_expr(1))
	} else if is_mut == 0 {
		p_fail_code(pos, "E020 UNEXPECTED", "expected '=': a let needs a value (a mut without one starts at its zero value)")
	}
	l.mut_ = is_mut
	p_end()
	return cast(i64, l)
}

fn parse_local_var(pos i64) i64 {
	let names = []str{}
	names = append(names, p_expect_ident().text)
	for p_is(",") != 0 {
		p_next()
		names = append(names, p_expect_ident().text)
	}
	mut ty = 0
	if p_is("=") == 0 {
		ty = parse_type()
	}
	mut inits = cast([]i64, 0)
	if p_is("=") != 0 {
		p_next()
		inits = parse_expr_list()
	}
	p_end()
	if cast(i64, inits) != 0 && len(inits) != len(names) {
		let m = cast(MultiStmt, node_new(ST_MULTI, pos))
		m.targets = cast([]i64, idents_of(pos, names))
		m.values = cast([]i64, inits)
		m.define = 1
		return cast(i64, m)
	}
	let list = cast(ListStmt, node_new(ST_LIST, pos))
	list.stmts = []i64{}
	mut i = 0
	for i < len(names) {
		let l = cast(LetStmt, node_new(ST_LET, pos))
		l.name = names[i]
		l.type_ = ty
		if cast(i64, inits) != 0 {
			l.init = inits[i]
		}
		list.stmts = append(list.stmts, cast(i64, l))
		i = i + 1
	}
	return cast(i64, list)
}

fn idents_of(pos i64, names []str) i64 {
	let v = []i64{}
	mut i = 0
	for i < len(names) {
		let id = cast(IdentExpr, node_new(EX_IDENT, pos))
		id.name = names[i]
		v = append(v, cast(i64, id))
		i = i + 1
	}
	return cast(i64, v)
}

fn parse_expr_list() []i64 {
	let v = []i64{}
	v = append(v, parse_catch(parse_expr(1)))
	for p_is(",") != 0 {
		p_next()
		v = append(v, parse_catch(parse_expr(1)))
	}
	return cast([]i64, v)
}

// callee_keeps_nothing reports whether a call's callee is a library function that only calls the
// function values it is given and never stores or returns them: sift's and atlas's *Func functions,
// sift.Each, Map, Filter and Reduce, and twine's *Func functions and Map.
fn callee_keeps_nothing(x i64) i64 {
	if cast(Node, x).kind != EX_SELECT || cast(Node, cast(SelectExpr, x).x).kind != EX_IDENT {
		return 0
	}
	let pkg = cast(IdentExpr, cast(SelectExpr, x).x).name
	let name = cast(SelectExpr, x).name
	if pkg != "sift" && pkg != "twine" && pkg != "atlas" {
		return 0
	}
	let n = len(name)
	if n >= 4 && name[n - 4:] == "Func" {
		return 1
	}
	if name == "Each" || name == "Map" || name == "Filter" || name == "Reduce" {
		return 1
	}
	return 0
}

fn has_brace(p str, n i64) i64 {
	mut i = 0
	for i < n {
		let c = i64(p[i])
		if c == '{' || c == '}' {
			return 1
		}
		i = i + 1
	}
	return 0
}

fn str_node(pos i64, b []u8) i64 {
	let s = cast(StrLit, node_new(EX_STR, pos))
	s.len = len(b)
	s.ptr = str(b)
	return cast(i64, s)
}

// parse_interp splits "text {x} more {y:spec}" into its text parts and values. {{ and }}
// are literal braces; spec is everything after the last top-level ':' in the braces.
fn parse_interp(t Token, pos i64) i64 {
	let p = t.text
	let n = t.val
	let parts = []i64{}
	let args = []i64{}
	let specs = []?str{}
	mut cur = buf_new()
	mut i = 0
	for i < n {
		let c = i64(p[i])
		if c == '{' && i + 1 < n && i64(p[i + 1]) == '{' {
			buf_byte(cur, '{')
			i = i + 2
		} else if c == '}' && i + 1 < n && i64(p[i + 1]) == '}' {
			buf_byte(cur, '}')
			i = i + 2
		} else if c == '}' {
			p_fail_code(pos, "E030 INTERPOLATION", "a }} in a string must be written }}}} (or use a `raw` string)")
		} else if c == '{' {
			mut j = i + 1
			mut depth = 0
			mut colon = -1
			for j < n && !(i64(p[j]) == '}' && depth == 0) {
				let d = i64(p[j])
				if d == '(' || d == '[' {
					depth = depth + 1
				} else if d == ')' || d == ']' {
					depth = depth - 1
				} else if d == ':' && depth == 0 {
					colon = j
				}
				j = j + 1
			}
			if j >= n {
				p_fail_code(pos, "E030 INTERPOLATION", "a {{ in a string starts a value: close it with }}, or write {{{{ for a brace")
			}
			mut ee = j
			mut spec ?str = nil
			if colon >= 0 {
				ee = colon
				let sb = buf_new()
				mut k = colon + 1
				for k < j {
					buf_byte(sb, i64(p[k]))
					k = k + 1
				}
				spec = str(sb)
			}
			parts = append(parts, str_node(pos, cast([]u8, cur)))
			cur = buf_new()
			args = append(args, interp_expr(p[i + 1:ee], pos))
			specs = append(specs, spec)
			i = j + 1
		} else {
			buf_byte(cur, c)
			i = i + 1
		}
	}
	parts = append(parts, str_node(pos, cast([]u8, cur)))
	if len(cast([]i64, args)) == 0 {
		return parts[0]
	}
	let e = cast(InterpExpr, node_new(EX_INTERP, pos))
	e.parts = cast([]i64, parts)
	e.args = cast([]i64, args)
	e.specs = specs
	return cast(i64, e)
}

// interp_expr parses the n bytes at p (the inside of {...} in a string) as an expression.
fn interp_expr(src str, pos i64) i64 {
	let toks = cast([]i64, lex(0, src, p_edition1))
	mut j = 0
	for j < len(toks) {
		cast(Token, toks[j]).pos = pos
		j = j + 1
	}
	let saved_toks = p_toks
	let saved_i = p_i
	p_toks = cast([]Token, cast([]i64, toks))
	p_i = 0
	if p_is(";") != 0 || p_peek().kind == TK_EOF {
		p_fail_code(pos, "E030 INTERPOLATION", "empty {{}} in a string: write {{{{}}}} for braces")
	}
	let x = parse_expr(1)
	if p_is(";") != 0 {
		p_next()
	}
	if p_peek().kind != TK_EOF {
		p_fail_code(pos, "E030 INTERPOLATION", "unexpected text inside {{...}} in a string: it holds one value (write {{{{ for a brace, or use a `raw` string)")
	}
	p_toks = saved_toks
	p_i = saved_i
	return x
}

// parse_catch reads an optional `catch name { ... }` after x (strict code only).
fn parse_catch(x i64) i64 {
	if p_word("catch") == 0 {
		return parse_wrap(x)
	}
	let c = cast(CatchExpr, node_new(EX_CATCH, cast(Token, p_next()).pos))
	c.x = x
	c.name = p_expect_ident().text
	c.body = parse_block()
	return parse_wrap(cast(i64, c))
}

fn parse_wrap(x i64) i64 {
	if p_edition1 == 0 || p_word("wrap") == 0 {
		return x
	}
	let pos = cast(Token, p_next()).pos
	if p_peek().kind != TK_STRING {
		p_fail_found_code(p_peek().pos, "E020 UNEXPECTED", "wrap expects a string message", cast(i64, p_peek()))
	}
	let msg = cast(Node, parse_primary())
	if msg.kind != EX_STR && msg.kind != EX_INTERP {
		p_fail_code(pos, "E020 UNEXPECTED", "wrap expects a string message")
	}
	let w = cast(WrapExpr, node_new(EX_WRAP, pos))
	w.x = x
	w.message = cast(i64, msg)
	return cast(i64, w)
}

fn is_assign_op(t Token) i64 {
	if t.kind != TK_PUNCT {
		return 0
	}
	let s = t.text
	let n = len(s)
	return i64(n >= 2 && i64(s[n - 1]) == '=' && s != "==" && s != "!=" && s != "<=" && s != ">=" && s != ":=")
}

// parse_simple_stmt finishes a statement that starts with the expression list xs.
fn parse_simple_stmt(xs []i64) i64 {
	let x = xs[0]
	let pos = cast(Node, x).pos
	if p_is(":=") != 0 || (p_is("=") != 0 && len(xs) > 1) {
		if p_edition1 != 0 && p_is(":=") != 0 {
			p_fail_code(pos, "E090 OLD_SYNTAX", "edition 1 uses 'let' or 'mut', not ':='")
		}
		let define = p_is(":=")
		p_next()
		let vals = parse_expr_list()
		if define != 0 && len(xs) == 1 && len(vals) == 1 {
			if cast(Node, x).kind != EX_IDENT {
				p_fail_code(pos, "E020 UNEXPECTED", "expected a name before :=")
			}
			let l = cast(LetStmt, node_new(ST_LET, pos))
			l.name = cast(IdentExpr, x).name
			l.init = vals[0]
			return cast(i64, l)
		}
		let m = cast(MultiStmt, node_new(ST_MULTI, pos))
		m.targets = cast([]i64, xs)
		m.values = cast([]i64, vals)
		m.define = define
		return cast(i64, m)
	}
	if len(xs) > 1 {
		p_fail_found_code(p_peek().pos, "E020 UNEXPECTED", "expected := or =", cast(i64, p_peek()))
	}
	if p_is("=") != 0 {
		p_next()
		let a = cast(AssignStmt, node_new(ST_ASSIGN, pos))
		a.target = x
		a.value = parse_catch(parse_expr(1))
		return cast(i64, a)
	}
	if is_assign_op(p_peek()) != 0 {
		// x op= e  is  x = x op e  (the target is evaluated twice).
		let t = cast(Token, p_next()).text
		let a = cast(AssignStmt, node_new(ST_ASSIGN, pos))
		a.target = x
		a.value = op_binary_new(pos, t[:len(t) - 1], x, parse_expr(1))
		return cast(i64, a)
	}
	if p_is("++") != 0 || p_is("--") != 0 {
		if p_edition1 != 0 {
			p_fail_code(pos, "E090 OLD_SYNTAX", "edition 1 uses '+= 1' or '-= 1', not '++' or '--'")
		}
		mut op = "+"
		if p_is("--") != 0 {
			op = "-"
		}
		p_next()
		let one = cast(IntLit, node_new(EX_INT, pos))
		one.val = 1
		let inc = cast(AssignStmt, node_new(ST_ASSIGN, pos))
		inc.target = x
		inc.value = binary_new(pos, op, x, cast(i64, one))
		return cast(i64, inc)
	}
	let s = cast(ExprStmt, node_new(ST_EXPR, pos))
	s.x = x
	return cast(i64, s)
}

fn binary_new(pos i64, op str, l i64, r i64) i64 {
	let b = cast(Binary, node_new(EX_BINARY, pos))
	b.op = op
	b.l = l
	b.r = r
	return cast(i64, b)
}

fn parse_if() i64 {
	let s = node_new(ST_IF, cast(Token, p_expect("if")).pos)
	let saved = p_nolit
	p_nolit = 1
	if p_edition1 != 0 && p_is("let") != 0 {
		p_next()
		let binding = cast(LetStmt, node_new(ST_LET, cast(Node, s).pos))
		binding.name = p_expect_ident().text
		p_expect("=")
		binding.init = parse_expr(1)
		binding.mut_ = 0
		cast(IfStmt, s).init = cast(i64, binding)
		let id = cast(IdentExpr, node_new(EX_IDENT, cast(Node, s).pos))
		id.name = binding.name
		cast(IfStmt, s).cond = binary_new(cast(Node, s).pos, "!=", cast(i64, id), node_new(EX_NIL, cast(Node, s).pos))
	} else {
		let first = parse_simple_stmt(parse_expr_list())
		if p_is(";") != 0 {
			p_next()
			cast(IfStmt, s).init = first
			cast(IfStmt, s).cond = parse_expr(1)
		} else {
			if cast(Node, first).kind != ST_EXPR {
				p_fail_code(cast(Node, first).pos, "E020 UNEXPECTED", "expected a condition")
			}
			cast(IfStmt, s).cond = cast(ExprStmt, first).x
		}
	}
	p_nolit = saved
	cast(IfStmt, s).then = parse_block()
	if p_is("else") != 0 {
		p_next()
		if p_is("if") != 0 {
			cast(IfStmt, s).else_ = parse_if()
		} else {
			cast(IfStmt, s).else_ = parse_block()
		}
	}
	return s
}

fn true_node(pos i64) i64 {
	let t = cast(IdentExpr, node_new(EX_IDENT, pos))
	t.name = "true"
	return cast(i64, t)
}

fn parse_for() i64 {
	if p_edition1 != 0 {
		return parse_for_edition1()
	}
	let pos = cast(Token, p_expect("for")).pos
	let w = cast(WhileStmt, node_new(ST_WHILE, pos))
	if p_is("{{") != 0 {
		w.cond = true_node(pos)
		w.body = parse_block()
		return cast(i64, w)
	}
	let saved = p_nolit
	p_nolit = 1
	if p_is("range") != 0 {
		p_next()
		let r = cast(RangeStmt, node_new(ST_RANGE, pos))
		r.expr = parse_expr(1)
		p_nolit = saved
		r.body = parse_block()
		return cast(i64, r)
	}
	mut init = 0
	if p_is(";") == 0 {
		let xs = parse_expr_list()
		if (p_is(":=") != 0 || p_is("=") != 0) && tok_is(p_peek2(), "range") != 0 {
			let r = cast(RangeStmt, node_new(ST_RANGE, pos))
			r.define = p_is(":=")
			p_next()
			p_next()
			r.key = xs[0]
			if len(xs) > 1 {
				r.val = xs[1]
			}
			r.expr = parse_expr(1)
			p_nolit = saved
			r.body = parse_block()
			return cast(i64, r)
		}
		if p_is("{{") != 0 && len(xs) == 1 {
			w.cond = xs[0]
			p_nolit = saved
			w.body = parse_block()
			return cast(i64, w)
		}
		init = parse_simple_stmt(xs)
	}
	p_expect(";")
	w.init = init
	if p_is(";") != 0 {
		w.cond = true_node(pos)
	} else {
		w.cond = parse_expr(1)
	}
	p_expect(";")
	if p_is("{{") == 0 {
		w.post = parse_simple_stmt(parse_expr_list())
	}
	p_nolit = saved
	w.body = parse_block()
	return cast(i64, w)
}

// parse_for_edition1 lowers each of Tin 1's four loop forms into the existing range/while
// nodes. Integer ranges use the same init/condition/post shape as a C-style loop, which keeps
// the bounds proof and code generation on their existing path.
fn parse_for_edition1() i64 {
	let pos = cast(Token, p_expect("for")).pos
	let label = p_pending_label
	p_pending_label = ""
	if p_is("{{") != 0 {
		let forever = cast(WhileStmt, node_new(ST_WHILE, pos))
		forever.cond = true_node(pos)
		forever.body = parse_block()
		forever.label = label
		return cast(i64, forever)
	}
	let saved = p_nolit
	p_nolit = 1
	if p_peek().kind == TK_IDENT && (p_word_at(1, "in") != 0 || tok_is(p_peek2(), ",") != 0) {
		let names = []str{}
		names = append(names, p_expect_ident().text)
		for p_is(",") != 0 {
			p_next()
			names = append(names, p_expect_ident().text)
		}
		if p_word("in") == 0 {
			p_fail_found_code(p_peek().pos, "E020 UNEXPECTED", "expected 'in' after loop binding", cast(i64, p_peek()))
		}
		p_next()
		p_range_expr = 1
		let src = parse_expr(1)
		p_range_expr = 0
		p_nolit = saved // the body allows composite literals again
		let body = parse_block()
		p_nolit = saved
		if cast(Node, src).kind == EX_BINARY && cast(Binary, src).op == ".." {
			if len(names) != 1 {
				p_fail_code(pos, "E052 RANGE_LOOP", "an integer range loop has one binding")
			}
			let loop_ = cast(WhileStmt, make_index_loop(pos, names[0], cast(Binary, src), 0, body))
			loop_.label = label
			return cast(i64, loop_)
		}
		if cast(Node, src).kind == EX_CALL && cast(Call, src).callee != 0 && cast(Node, cast(Call, src).callee).kind == EX_SELECT && cast(SelectExpr, cast(Call, src).callee).name == "step" {
			let range_expr = cast(SelectExpr, cast(Call, src).callee).x
			if cast(Node, range_expr).kind == EX_BINARY && cast(Binary, range_expr).op == ".." {
				if len(names) != 1 || len(cast(Call, src).args) != 1 {
					p_fail_code(pos, "E052 RANGE_LOOP", "a stepped integer range needs one binding and one step")
				}
				let loop_ = cast(WhileStmt, make_index_loop(pos, names[0], cast(Binary, range_expr), cast(Call, src).args[0], body))
				loop_.label = label
				return cast(i64, loop_)
			}
		}
		let r = cast(RangeStmt, node_new(ST_RANGE, pos))
		if len(names) > 1 {
			r.key = node_new(EX_IDENT, pos)
			cast(IdentExpr, r.key).name = names[0]
			r.val = node_new(EX_IDENT, pos)
			cast(IdentExpr, r.val).name = names[1]
		} else {
			r.val = node_new(EX_IDENT, pos)
			cast(IdentExpr, r.val).name = names[0]
		}
		r.define = 1
		r.expr = src
		r.body = body
		r.label = label
		return cast(i64, r)
	}
	let w = cast(WhileStmt, node_new(ST_WHILE, pos))
	p_range_expr = 0
	w.cond = parse_expr(1)
	p_nolit = saved
	w.body = parse_block()
	p_nolit = saved
	w.label = label
	return cast(i64, w)
}

fn parse_boundary() i64 {
	let pos = p_peek().pos
	let word = cast(Token, p_next()).text
	let boundary = cast(BoundaryStmt, node_new(EX_BOUNDARY, pos))
	boundary.args = []i64{}
	if word == "within" {
		boundary.kind = BOUND_WITHIN
		let saved = p_nolit
		p_nolit = 1
		boundary.args = append(boundary.args, parse_expr(1))
		p_nolit = saved
	} else if word == "limit" {
		boundary.kind = BOUND_LIMIT
		for p_is("{{") == 0 {
			let item = name_bind(p_expect_ident().text, parse_expr(1))
			boundary.args = append(boundary.args, item)
			if p_is(",") == 0 {
				break
			}
			p_next()
		}
		if len(boundary.args) == 0 {
			p_fail_code(pos, "E020 UNEXPECTED", "limit needs at least one bound")
		}
	} else if word == "guard" {
		boundary.kind = BOUND_GUARD
		if p_is("{{") == 0 {
			// guard CALL (#142): the guard block { CALL } on one call.
			let call = cast(Node, parse_unary())
			mut inner = call
			if cast(Node, inner).kind == EX_TRY {
				inner = cast(Node, cast(TryExpr, inner).x)
			}
			if cast(Node, inner).kind != EX_CALL {
				p_fail_code(call.pos, "E020 UNEXPECTED", "guard needs a block or a call")
			}
			let st = cast(ExprStmt, node_new(ST_EXPR, call.pos))
			st.x = cast(i64, call)
			boundary.body = empty_block(call.pos)
			mut vs3 = cast(Block, boundary.body).stmts
			vs3 = append(vs3, cast(i64, st))
			return cast(i64, boundary)
		}
	} else if word == "arena" {
		boundary.kind = BOUND_ARENA
	} else if word == "parallel" {
		boundary.kind = BOUND_PARALLEL
	} else {
		boundary.kind = BOUND_WITH
		let saved2 = p_nolit
		p_nolit = 1
		boundary.args = append(boundary.args, parse_expr(1))
		p_nolit = saved2
	}
	if p_is("{{") == 0 {
		p_fail_found_code(p_peek().pos, "E020 UNEXPECTED", "expected a boundary block", cast(i64, p_peek()))
	}
	boundary.body = parse_block()
	return cast(i64, boundary)
}

fn starts_boundary() i64 {
	if p_edition1 == 0 {
		return 0
	}
	if p_word("guard") != 0 && (p_peek2().kind == TK_IDENT || tok_is(p_peek2(), "try") != 0) {
		// guard CALL (#142).
		return 1
	}
	if p_word("guard") != 0 || p_word("arena") != 0 || p_word("parallel") != 0 {
		return tok_is(p_peek2(), "{{")
	}
	if p_word("limit") != 0 {
		return i64(p_peek2().kind == TK_IDENT)
	}
	if p_word("within") != 0 {
		return i64(p_peek2().kind != TK_EOF && tok_is(p_peek2(), "(") == 0 && tok_is(p_peek2(), ";") == 0 && tok_is(p_peek2(), "}}") == 0)
	}
	if p_word("with") != 0 {
		if p_peek2().kind == TK_IDENT {
			return 1
		}
		if tok_is(p_peek2(), "(") != 0 {
			return with_parens_followed_by_block()
		}
	}
	return 0
}

fn with_parens_followed_by_block() i64 {
	mut depth = 0
	mut i = p_i + 1
	for i < len(p_toks) {
		let t = p_toks[i]
		if tok_is(cast(Token, t), "(") != 0 {
			depth = depth + 1
		} else if tok_is(cast(Token, t), ")") != 0 {
			depth = depth - 1
			if depth == 0 {
				return i64(i + 1 < len(p_toks) && tok_is(p_toks[i + 1], "{{") != 0)
			}
		}
		i = i + 1
	}
	return 0
}

fn p_word_at(off i64, text str) i64 {
	mut t = p_peek()
	if off == 1 {
		t = p_peek2()
	} else if off == 2 {
		t = p_peek3()
	}
	return i64(t.kind == TK_IDENT && t.text == text)
}

fn p_peek3() Token {
	if p_i + 2 < len(p_toks) {
		return p_toks[p_i + 2]
	}
	return p_peek2()
}

fn make_index_loop(pos i64, name str, range_expr Binary, step i64, body i64) i64 {
	let start = range_expr.l
	let end = range_expr.r
	let loop_ = cast(WhileStmt, node_new(ST_WHILE, pos))
	let init = cast(LetStmt, node_new(ST_LET, pos))
	init.name = name
	init.init = start
	init.mut_ = 1
	loop_.init = cast(i64, init)
	let id = cast(IdentExpr, node_new(EX_IDENT, pos))
	id.name = name
	loop_.cond = binary_new(pos, "<", cast(i64, id), end)
	let next = cast(IdentExpr, node_new(EX_IDENT, pos))
	next.name = name
	mut by = cast(IntLit, step)
	if cast(i64, by) == 0 {
		by = cast(IntLit, node_new(EX_INT, pos))
		by.val = 1
	}
	let post = cast(AssignStmt, node_new(ST_ASSIGN, pos))
	let target = cast(IdentExpr, node_new(EX_IDENT, pos))
	target.name = name
	post.target = cast(i64, target)
	post.value = binary_new(pos, "+", cast(i64, next), cast(i64, by))
	loop_.post = cast(i64, post)
	loop_.body = body
	return cast(i64, loop_)
}

fn parse_switch() i64 {
	let s = cast(SwitchStmt, node_new(ST_SWITCH, cast(Token, p_expect("switch")).pos))
	let saved = p_nolit
	p_nolit = 1
	if p_is("{{") == 0 {
		let first = parse_simple_stmt(parse_expr_list())
		if p_is(";") != 0 {
			p_next()
			s.init = first
			if p_is("{{") == 0 {
				s.tag = parse_expr(1)
			}
		} else {
			if cast(Node, first).kind != ST_EXPR {
				p_fail_code(cast(Node, first).pos, "E020 UNEXPECTED", "expected a switch tag")
			}
			s.tag = cast(ExprStmt, first).x
		}
	}
	p_nolit = saved
	p_expect("{{")
	let cases = []i64{}
	for p_is("}}") == 0 {
		if p_is(";") != 0 {
			p_next()
			continue
		}
		let c = []i64{}
		let cpos = p_peek().pos
		if p_is("case") != 0 {
			p_next()
			c = append(c, cast(i64, parse_expr_list()))
		} else {
			p_expect("default")
			c = append(c, 0)
		}
		p_expect(":")
		let body = cast(Block, empty_block(cpos))
		for p_is("case") == 0 && p_is("default") == 0 && p_is("}}") == 0 {
			let st = parse_stmt()
			if cast(Node, st).kind == ST_LIST {
				mut i = 0
				for i < len(cast(ListStmt, st).stmts) {
					body.stmts = append(body.stmts, cast(ListStmt, st).stmts[i])
					i = i + 1
				}
			} else {
				body.stmts = append(body.stmts, st)
			}
		}
		c = append(c, cast(i64, body))
		cases = append(cases, cast(i64, c))
	}
	p_next()
	s.cases = cast([]i64, cases)
	return cast(i64, s)
}

// ---- expressions ----
// bin_prec gives a binary operator's binding power (Go's levels), or 0.
fn bin_prec(t Token) i64 {
	if t.kind != TK_PUNCT {
		return 0
	}
	let s = t.text
	if s == "||" {
		return 1
	}
	if s == "&&" {
		return 2
	}
	if p_edition1 != 0 && p_range_expr != 0 && s == ".." {
		return 3
	}
	if s == "==" || s == "!=" || s == "<" || s == "<=" || s == ">" || s == ">=" {
		return 3
	}
	if s == "+" || s == "-" || s == "|" || s == "^" {
		return 4
	}
	if s == "*" || s == "/" || s == "%" || s == "<<" || s == ">>" || s == "&" {
		return 5
	}
	if p_edition1 != 0 && (s == "+%" || s == "-%") {
		return 4
	}
	if p_edition1 != 0 && s == "*%" {
		return 5
	}
	return 0
}

// op_binary_new makes the binary node for operator text op: the wrapping forms +%, -% and *%
// are + - * marked OVF_WRAP (#362).
fn op_binary_new(pos i64, op str, l i64, r i64) i64 {
	if len(op) == 2 && op[1] == '%' {
		let b = cast(Binary, binary_new(pos, op[:1], l, r))
		b.ovf = OVF_WRAP
		return cast(i64, b)
	}
	return binary_new(pos, op, l, r)
}

// parse_expr is a precedence-climbing parser for left-associative binary operators.
fn parse_expr(min_prec i64) i64 {
	mut left = parse_unary()
	for {
		let t = p_peek()
		let prec = bin_prec(t)
		if prec == 0 || prec < min_prec {
			return parse_wrap(left)
		}
		p_next()
		let right = parse_expr(prec + 1)
		left = op_binary_new(t.pos, t.text, left, right)
	}
}

fn parse_unary() i64 {
	let t = p_peek()
	let s = t.text
	if p_is("try") != 0 {
		p_next()
		let tr = cast(TryExpr, node_new(EX_TRY, t.pos))
		tr.x = parse_unary()
		return cast(i64, tr)
	}
	if t.kind == TK_PUNCT && (s == "-" || s == "!" || s == "~" || s == "&" || s == "^" || s == "*" || s == "+") {
		p_next()
		let x = parse_unary()
		if s == "+" || s == "*" {
			// +x is x; *p is p, since struct values are references.
			return x
		}
		let u = cast(Unary, node_new(EX_UNARY, t.pos))
		u.op = s
		if s == "^" {
			u.op = "~"
		}
		u.x = x
		return cast(i64, u)
	}
	return parse_postfix()
}

// type_operand reports whether a call to name takes a type as its first argument.
fn type_operand(name str) i64 {
	return i64(name == "make" || name == "new" || name == "cast")
}

fn parse_postfix() i64 {
	mut x = parse_primary()
	for {
		if p_is("(") != 0 {
			let pos = cast(Token, p_next()).pos
			let call = cast(Call, node_new(EX_CALL, cast(Node, x).pos))
			call.args = []i64{}
			if cast(Node, x).kind == EX_IDENT {
				call.name = cast(IdentExpr, x).name
			} else {
				call.callee = x
			}
			let saved = p_nolit
			p_nolit = 0
			if p_is(")") == 0 && cast(Node, x).kind == EX_IDENT && type_operand(cast(IdentExpr, x).name) != 0 {
				let tx = node_new(EX_TYPE, p_peek().pos)
				tx[TYX] = parse_type()
				call.args = append(call.args, tx)
				if p_is(",") != 0 {
					p_next()
				}
			}
			for p_is(")") == 0 {
				if p_is(";") != 0 {
					p_next()
					continue
				}
				let mpos = p_peek().pos
				mut marked = 0
				if p_is("mut") != 0 {
					p_next()
					marked = 1
				}
				mut a = parse_expr(1)
				if marked != 0 {
					let ma = cast(MutArg, node_new(EX_MUTARG, mpos))
					ma.x = a
					a = cast(i64, ma)
				}
				if p_is("...") != 0 {
					let spread = cast(Unary, node_new(EX_UNARY, cast(Token, p_next()).pos))
					spread.op = "..."
					spread.x = a
					a = cast(i64, spread)
				}
				// A function literal passed to a function keeps its closure on the caller's frame only when
				// the callee is known not to keep it; any other call may store it, so it must outlive the frame.
				if cast(Node, a).kind == EX_FUNCLIT && callee_keeps_nothing(x) != 0 {
					cast(FuncLit, a).escape = 0
				} else if cast(Node, a).kind == EX_MUTARG && cast(Node, cast(MutArg, a).x).kind == EX_FUNCLIT && callee_keeps_nothing(x) != 0 {
					cast(FuncLit, cast(MutArg, a).x).escape = 0
				}
				call.args = append(call.args, a)
				if p_is(",") == 0 {
					break
				}
				p_next()
			}
			p_nolit = saved
			p_expect(")")
			x = cast(i64, call)
		} else if p_is("[") != 0 {
			let type_args = i64(p_edition1 != 0 && bracket_followed_by_call() != 0)
			let pos = cast(Token, p_next()).pos
			let saved = p_nolit
			p_nolit = 0
			mut lo = 0
			mut targs = cast([]i64, 0)
			if type_args != 0 {
				targs = []i64{}
				for p_is("]") == 0 {
					let tn = node_new(EX_TYPE, p_peek().pos)
					tn[TYX] = parse_type()
					targs = append(targs, tn)
					if p_is(",") == 0 {
						break
					}
					p_next()
				}
				p_expect("]")
				let ix = cast(IndexExpr, node_new(EX_INDEX, pos))
				ix.x = x
				ix.args = cast(i64, targs)
				p_nolit = saved
				x = cast(i64, ix)
			} else {
				if p_is("[") != 0 || p_is("map") != 0 || p_is("?") != 0 || p_is("func") != 0 || p_word("dyn") != 0 {
					lo = node_new(EX_TYPE, p_peek().pos)
					lo[TYX] = parse_type()
					targs = []i64{}
					targs = append(targs, lo)
				} else if p_is(":") == 0 {
					lo = parse_expr(1)
				}
				if p_is(",") != 0 {
					if cast(i64, targs) == 0 {
						targs = []i64{}
						targs = append(targs, lo)
					}
					for p_is(",") != 0 {
						p_next()
						if p_is("[") != 0 || p_is("map") != 0 || p_is("?") != 0 || p_is("func") != 0 || p_word("dyn") != 0 || (p_edition1 != 0 && p_is("fn") != 0) {
							let tn = node_new(EX_TYPE, p_peek().pos)
							tn[TYX] = parse_type()
							targs = append(targs, tn)
						} else {
							targs = append(targs, parse_expr(1))
						}
					}
				}
				if p_is(":") != 0 {
					p_next()
					let sl = cast(SliceExpr, node_new(EX_SLICE, pos))
					sl.x = x
					sl.lo = lo
					if p_is("]") == 0 {
						sl.hi = parse_expr(1)
					}
					p_nolit = saved
					p_expect("]")
					x = cast(i64, sl)
				} else {
					p_nolit = saved
					p_expect("]")
					let ix = cast(IndexExpr, node_new(EX_INDEX, pos))
					ix.x = x
					ix.i = lo
					ix.args = cast(i64, targs)
					x = cast(i64, ix)
				}
			}
		} else if p_is(".") != 0 {
			let pos = cast(Token, p_next()).pos
			let sel = cast(SelectExpr, node_new(EX_SELECT, pos))
			sel.x = x
			sel.name = p_expect_ident().text
			x = cast(i64, sel)
		} else if p_edition1 != 0 && p_is("??") != 0 {
			let pos = cast(Token, p_next()).pos
			let coalesce = cast(Coalesce, node_new(EX_COALESCE, pos))
			coalesce.x = x
			coalesce.fallback = parse_unary()
			x = cast(i64, coalesce)
		} else if p_is("{{") != 0 && (cast(Node, x).kind == EX_TYPE || (p_nolit == 0 && (cast(Node, x).kind == EX_IDENT || (cast(Node, x).kind == EX_SELECT && cast(Node, cast(SelectExpr, x).x).kind == EX_IDENT) || (cast(Node, x).kind == EX_INDEX && (cast(Node, cast(IndexExpr, x).x).kind == EX_IDENT || cast(Node, cast(IndexExpr, x).x).kind == EX_SELECT))))) {
			x = parse_composite(cast(Node, x))
		} else {
			return x
		}
	}
}

fn bracket_followed_by_call() i64 {
	// A literal cannot start a type: byName["x"]() indexes, then calls.
	if p_i + 1 < len(p_toks) {
		let k = p_toks[p_i + 1].kind
		if k == TK_STRING || k == TK_INT || k == TK_FLOAT {
			return 0
		}
	}
	mut depth = 0
	mut i = p_i
	for i < len(p_toks) {
		let t = p_toks[i]
		if tok_is(cast(Token, t), "[") != 0 {
			depth = depth + 1
		} else if tok_is(cast(Token, t), "]") != 0 {
			depth = depth - 1
			if depth == 0 {
				return i64(i + 1 < len(p_toks) && tok_is(p_toks[i + 1], "(") != 0)
			}
		}
		i = i + 1
	}
	return 0
}

// parse_composite reads T{...} with positional or key: value elements.
fn parse_composite(tyexpr Node) i64 {
	let c = cast(Composite, node_new(EX_COMPOSITE, tyexpr.pos))
	c.type_ = cast(i64, tyexpr)
	c.elems = []i64{}
	c.keys = []i64{}
	p_expect("{{")
	let saved = p_nolit
	p_nolit = 0
	for p_is("}}") == 0 {
		if p_is(";") != 0 {
			p_next()
			continue
		}
		mut v = cast(Node, parse_elem())
		mut k = 0
		if p_is(":") != 0 {
			p_next()
			k = cast(i64, v)
			v = cast(Node, parse_elem())
		} else if p_edition1 != 0 && composite_requires_keys(tyexpr) != 0 {
			p_fail_code(v.pos, "E090 OLD_SYNTAX", "edition 1 struct literals require field names")
		}
		c.keys = append(c.keys, k)
		c.elems = append(c.elems, cast(i64, v))
		if p_is(",") == 0 {
			break
		}
		p_next()
	}
	p_nolit = saved
	for p_is(";") != 0 {
		p_next()
	}
	p_expect("}}")
	return cast(i64, c)
}

fn composite_requires_keys(tyexpr Node) i64 {
	if tyexpr.kind != EX_TYPE {
		return 1
	}
	let t = cast(Node, cast(i64, tyexpr)[TYX])
	// A bare {...} element takes its type from the composite around it: unknown here.
	return i64(cast(i64, t) != 0 && t.kind == TX_STRUCT)
}

// parse_elem reads a composite element; a bare {...} takes its type from the context.
fn parse_elem() i64 {
	if p_is("{{") != 0 {
		let untyped = node_new(EX_TYPE, p_peek().pos)
		return parse_composite(cast(Node, untyped))
	}
	return parse_expr(1)
}

// parse_match stores ordered, source-positioned arms and patterns. Later semantic passes
// lower these nodes after checking guards and enum coverage.
fn parse_match() i64 {
	let pos = cast(Token, p_next()).pos
	let m = cast(MatchExpr, node_new(EX_MATCH, pos))
	let saved = p_nolit
	p_nolit = 1
	m.subject = parse_expr(1)
	p_nolit = saved
	p_expect("{{")
	m.arms = []i64{}
	for p_is("}}") == 0 {
		if p_is(";") != 0 || p_is(",") != 0 {
			p_next()
			continue
		}
		let arm = cast(MatchArm, calloc(5, 8))
		arm.pos = p_peek().pos
		let patterns = []i64{}
		p_range_expr = 1
		patterns = append(patterns, parse_pattern())
		for p_is(",") != 0 {
			p_next()
			patterns = append(patterns, parse_pattern())
		}
		p_range_expr = 0
		arm.patterns = patterns
		mut guard_ = 0
		if p_is("if") != 0 {
			p_next()
			guard_ = parse_expr(1)
		}
		arm.guard_ = guard_
		p_expect("=>")
		mut body = cast(Block, 0)
		mut is_block = 0
		if p_is("{{") != 0 {
			body = cast(Block, parse_block())
			is_block = 1
		} else if p_is("return") != 0 || p_is("break") != 0 || p_is("continue") != 0 || (p_word("fail") != 0 && tok_is(p_peek2(), ":=") == 0 && tok_is(p_peek2(), "=") == 0 && tok_is(p_peek2(), ",") == 0 && tok_is(p_peek2(), ".") == 0) {
			// A statement arm (ErrNotFound => return 404) is a block of that statement.
			body = cast(Block, empty_block(p_peek().pos))
			body.stmts = append(body.stmts, parse_stmt())
			is_block = 1
		} else {
			body = cast(Block, parse_expr(1))
			if p_is("=") != 0 || is_assign_op(p_peek()) != 0 {
				// An assignment arm (Rect(w, h) => area = w * h) is a block of that assignment.
				let target = []i64{}
				target = append(target, cast(i64, body))
				let assign = cast(Node, parse_simple_stmt(cast([]i64, target)))
				body = cast(Block, empty_block(assign.pos))
				body.stmts = append(body.stmts, cast(i64, assign))
				is_block = 1
			}
		}
		arm.body = cast(i64, body)
		arm.block = is_block
		m.arms = append(m.arms, cast(i64, arm))
		if p_is(";") != 0 {
			p_next()
		}
	}
	if len(m.arms) == 0 {
		p_fail_code(pos, "E053 EMPTY_MATCH", "match needs at least one arm")
	}
	p_next()
	return cast(i64, m)
}

fn parse_pattern() i64 {
	let pos = p_peek().pos
	let x = parse_expr(1)
	return pattern_from_expr(x, pos)
}

fn pattern_from_expr(x i64, pos i64) i64 {
	let pat = cast(Pattern, calloc(6, 8))
	if cast(Node, x).kind == EX_BINARY && cast(Binary, x).op == ".." {
		if pattern_is_literal(cast(Binary, x).l) == 0 || pattern_is_literal(cast(Binary, x).r) == 0 {
			p_fail_code(pos, "E054 PATTERN", "range patterns need literal endpoints")
		}
		pat.kind = PAT_RANGE
		pat.pos = pos
		pat.a = cast(Binary, x).l
		pat.b = cast(Binary, x).r
		return cast(i64, pat)
	}
	if cast(Node, x).kind == EX_BINARY {
		p_fail_code(pos, "E054 PATTERN", "expected a literal, range, enum variant, or binding pattern")
	}
	if cast(Node, x).kind == EX_CALL {
		mut name = 0
		if cast(Call, x).callee != 0 {
			name = cast(Call, x).callee
		} else {
			name = node_new(EX_IDENT, pos)
			cast(IdentExpr, name).name = cast(Call, x).name
		}
		if name == 0 || (cast(Node, name).kind != EX_IDENT && cast(Node, name).kind != EX_SELECT) {
			p_fail_code(pos, "E054 PATTERN", "enum variant patterns need a variant name")
		}
		let children = []i64{}
		mut i = 0
		for i < len(cast(Call, x).args) {
			let child = cast(Node, cast(Call, x).args[i])
			children = append(children, pattern_from_expr(cast(i64, child), child.pos))
			i = i + 1
		}
		pat.kind = PAT_VARIANT
		pat.pos = pos
		pat.name = name
		pat.children = cast([]i64, cast(i64, children))
		return cast(i64, pat)
	}
	if cast(Node, x).kind == EX_IDENT && cast(IdentExpr, x).name == "_" {
		pat.kind = PAT_WILD
		pat.pos = pos
		return cast(i64, pat)
	}
	if cast(Node, x).kind == EX_IDENT && pattern_is_literal(x) == 0 {
		pat.kind = PAT_NAME_KIND
		pat.pos = pos
		pat.name = x
		return cast(i64, pat)
	}
	if cast(Node, x).kind == EX_SELECT {
		pat.kind = PAT_NAME_KIND
		pat.pos = pos
		pat.name = x
		return cast(i64, pat)
	}
	if pattern_is_literal(x) == 0 {
		p_fail_code(pos, "E054 PATTERN", "expected a literal, range, enum variant, or binding pattern")
	}
	pat.kind = PAT_LITERAL
	pat.pos = pos
	pat.a = x
	return cast(i64, pat)
}

fn pattern_is_literal(x i64) i64 {
	if cast(Node, x).kind == EX_INT || cast(Node, x).kind == EX_FLOAT || cast(Node, x).kind == EX_STR || cast(Node, x).kind == EX_NIL || cast(Node, x).kind == EX_UNIT {
		return 1
	}
	if cast(Node, x).kind == EX_IDENT && (cast(IdentExpr, x).name == "true" || cast(IdentExpr, x).name == "false") {
		return 1
	}
	if cast(Node, x).kind == EX_UNARY && cast(Unary, x).op == "-" {
		let operand = cast(Node, cast(Unary, x).x)
		return i64(operand.kind == EX_INT || operand.kind == EX_FLOAT || operand.kind == EX_UNIT)
	}
	return 0
}

fn parse_primary() i64 {
	let t = p_peek()
	let k = t.kind
	let pos = t.pos
	if starts_boundary() != 0 {
		return parse_boundary()
	}
	if p_edition1 != 0 && p_word("keep") != 0 {
		p_next()
		if p_is("(") == 0 {
			p_fail_found_code(p_peek().pos, "E020 UNEXPECTED", "keep needs a value in parentheses", cast(i64, p_peek()))
		}
		let keep_ = cast(IdentExpr, node_new(EX_IDENT, pos))
		keep_.name = "keep"
		return cast(i64, keep_)
	}
	if p_edition1 != 0 && p_word("fail") != 0 && tok_is(p_peek2(), "(") != 0 {
		// fail("text") as a value makes a fault, as in edition 0 (fail X leaves).
		p_next()
		let f = node_new(EX_IDENT, pos)
		cast(IdentExpr, f).name = "fail"
		return f
	}
	if p_edition1 != 0 && p_word("match") != 0 {
		return parse_match()
	}
	if k == TK_INT {
		p_next()
		if len(t.unit) != 0 {
			let unit_ = cast(UnitExpr, node_new(EX_UNIT, pos))
			unit_.value = t.val
			unit_.name = t.unit
			unit_.text = t.text
			unit_.float = 0
			return cast(i64, unit_)
		}
		let i = cast(IntLit, node_new(EX_INT, pos))
		i.val = t.val
		// A literal above 2^63-1 (its bits look negative) only fits 64-bit types.
		if t.val < 0 {
			cast(IntLit, i).big = 1
		}
		if i64(byte_at(t.text, 0)) == '\'' {
			cast(IntLit, i).char_ = 1
		}
		return cast(i64, i)
	}
	if k == TK_FLOAT {
		p_next()
		if len(t.unit) != 0 {
			let unit_ = cast(UnitExpr, node_new(EX_UNIT, pos))
			unit_.value = t.val
			unit_.name = t.unit
			unit_.text = t.text
			unit_.float = 1
			return cast(i64, unit_)
		}
		let f = node_new(EX_FLOAT, pos)
		cast(FloatLit, f).bits = t.val
		cast(FloatLit, f).text = t.text
		return f
	}
	if k == TK_STRING {
		p_next()
		if t.raw == 0 && has_brace(t.text, t.val) != 0 {
			return parse_interp(t, pos)
		}
		let s = cast(StrLit, node_new(EX_STR, pos))
		s.ptr = t.text
		s.len = t.val
		return cast(i64, s)
	}
	if k == TK_IDENT {
		p_next()
		let id = cast(IdentExpr, node_new(EX_IDENT, pos))
		id.name = t.text
		return cast(i64, id)
	}
	if p_is("true") != 0 || p_is("false") != 0 {
		p_next()
		let b = cast(IdentExpr, node_new(EX_IDENT, pos))
		b.name = t.text
		return cast(i64, b)
	}
	if p_is("nil") != 0 {
		p_next()
		return node_new(EX_NIL, pos)
	}
	if p_is("(") != 0 {
		p_next()
		let saved = p_nolit
		p_nolit = 0
		let x = parse_expr(1)
		p_nolit = saved
		if p_word("catch") != 0 {
			p_fail_code(p_peek().pos, "E401 CATCH_PLACEMENT", "catch goes on a whole statement, initializer, assignment or return value, not inside an expression")
		}
		p_expect(")")
		return x
	}
	if p_is("func") != 0 || (p_edition1 != 0 && p_is("fn") != 0) {
		if p_edition1 != 0 && p_is("func") != 0 {
			p_fail_code(pos, "E090 OLD_SYNTAX", "edition 1 uses 'fn', not 'func'")
		}
		// A function literal, or a func type in a conversion.
		p_next()
		let f = fn_new(pos, "func")
		parse_params(cast(Fn, f))
		p_bangres = 0
		cast(Fn, f).rtypes = parse_results()
		cast(Fn, f).bang = p_bangres
		if p_is("{{") == 0 {
			p_fail_code(pos, "E020 UNEXPECTED", "expected a function body")
		}
		let saved = p_nolit
		p_nolit = 0
		cast(Fn, f).body = parse_block()
		p_nolit = saved
		let lit = cast(FuncLit, node_new(EX_FUNCLIT, pos))
		lit.fn_ = cast(i64, f)
		lit.escape = 1
		return cast(i64, lit)
	}
	if p_is("[") != 0 || p_is("map") != 0 || p_is("struct") != 0 {
		let ty = node_new(EX_TYPE, pos)
		ty[TYX] = parse_type()
		return ty
	}
	p_next()
	p_fail_found_code(pos, "E020 UNEXPECTED", "expected an expression", cast(i64, t))
	return 0
}

// print_edition1 keeps source trivia byte-for-byte and changes only edition 0 token spans.
// The parser has already validated the file with the edition-0 grammar.
fn print_edition1(file i64, source str, toks []Token) i64 {
	let out = buf_new()
	let prefixes = slice_filled[?str](len(toks), nil)
	let suffixes = slice_filled[?str](len(toks), nil)
	let replacements = slice_filled[?str](len(toks), nil)
	let deletes = slice_filled(len(toks), 0)
	fx_span = slice_filled(len(toks), 0)
	fx_triv = slice_filled[?str](len(toks), nil)
	fx_lead = slice_filled(len(toks), "")
	fx_ind = slice_filled(len(toks), 0)
	fx_hoisted = []Hoisted{}
	fx_rep = replacements
	fx_pre = prefixes
	fx_suf = suffixes
	mut depth = 0
	mut top = 0
	mut i = 0
	for i < len(toks) {
		let t = toks[i]
		// a declaration starts a line (a func in a parameter's type does not)
		if depth == 0 && (i == 0 || tok_is(toks[i - 1], ";") != 0 || tok_is(toks[i - 1], "}}") != 0) && (fx_kw(t, "func") != 0 || fx_kw(t, "var") != 0 || fx_kw(t, "const") != 0 || fx_kw(t, "type") != 0 || fx_kw(t, "import") != 0) {
			top = i
			fx_top = i
			if fx_kw(t, "func") != 0 {
				mut n = fx_next(toks, i)
				if n < len(toks) && tok_is(toks[n], "(") != 0 {
					n = fx_next(toks, matching_paren(cast([]i64, toks), n))
				}
				fx_fn_name = "fn"
				if n < len(toks) && toks[n].kind == TK_IDENT {
					fx_fn_name = toks[n].text
				}
			}
		}
		if tok_is(t, "{{") != 0 {
			depth = depth + 1
		} else if tok_is(t, "}}") != 0 {
			depth = depth - 1
		}
		if t.kind == TK_KEYWORD && t.text == "for" {
			if rewrite_for_each(source, toks, i, replacements, suffixes) == 0 && rewrite_for_range(toks, i, replacements, cast([]i64, deletes), prefixes, suffixes) == 0 {
				rewrite_for_fallback(source, toks, i, replacements, cast([]i64, deletes), prefixes, suffixes)
			}
		} else if t.kind == TK_KEYWORD && t.text == "while" {
			rewrite_while(toks, i, replacements, cast([]i64, deletes))
		} else if t.kind == TK_KEYWORD && t.text == "switch" {
			rewrite_switch(source, toks, i, replacements, cast([]i64, deletes), prefixes, suffixes)
		} else if fx_kw(t, "if") != 0 {
			rewrite_if_init(source, cast([]i64, toks), i, replacements, prefixes, suffixes)
		} else if fx_kw(t, "const") != 0 && depth > 0 {
			rewrite_local_const(source, toks, i, top, replacements, depth)
		} else if fx_kw(t, "const") != 0 && depth == 0 {
			rewrite_const_group(source, toks, i)
		} else if tok_is(t, "@") != 0 && depth > 0 {
			rewrite_field_attr(source, toks, i)
		} else if t.kind == TK_IDENT && t.text == "tide" && replacements[i] == nil {
			rewrite_tide_unit(toks, i, replacements)
		} else if fx_reserved(toks, i) != 0 && replacements[i] == nil {
			replacements[i] = t.text + "_"
		} else if t.synth == 0 && tok_is(t, ";") != 0 && replacements[i] == nil && cast([]i64, deletes)[i] == 0 {
			replacements[i] = "\n"
		}
		i = i + 1
	}
	i = 0
	for i < len(toks) {
		let t = toks[i]
		if t.synth == 0 && t.text == ":=" && replacements[i] == nil {
			mut first = i - 1
			mut count = 1
			mut mutable = 0
			for first >= 2 && tok_is(toks[first - 1], ",") != 0 && toks[first - 2].kind == TK_IDENT {
				first = first - 2
				count = count + 1
			}
			if first >= 0 && toks[first].kind == TK_IDENT {
				mut name_at = first
				for name_at < i {
					let name = toks[name_at]
					if name.kind == TK_IDENT && token_name_assigned_after(toks, name.text, i + 1) != 0 {
						mutable = 1
					}
					name_at = name_at + 1
				}
				if count == 1 {
					prefixes[first] = "let "
					if mutable != 0 {
						prefixes[first] = "mut "
					}
				} else {
					prefixes[first] = "let ("
					if mutable != 0 {
						prefixes[first] = "mut ("
					}
					suffixes[i - 1] = ")"
				}
			}
		}
		i = i + 1
	}
	mut cursor = 0
	i = 0
	for i < len(toks) {
		let t = toks[i]
		if t.synth != 0 || t.end <= t.start || t.start < cursor {
			i = i + 1
			continue
		}
		fx_cur_ind = fx_ind[i]
		if let tv = fx_triv[i] {
			fx_put(cast([]u8, out), tv)
			if len(fx_lead[i]) != 0 {
				buf_str(out, fx_lead[i])
			}
		} else {
			fx_copy_trivia(cast([]u8, out), source, cursor, t.start, fx_lead[i])
		}
		fx_cur_ind = 0
		if prefixes[i] != nil {
			buf_str(out, or_empty(prefixes[i]))
		}
		mut replacement = replacements[i]
		if replacement == nil && t.kind == TK_KEYWORD && t.text == "func" {
			replacement = "fn"
		} else if replacement == nil && t.kind == TK_KEYWORD && t.text == "var" {
			replacement = "let"
			mut name_at = i + 1
			for name_at < len(toks) && toks[name_at].synth != 0 {
				name_at = name_at + 1
			}
			if name_at < len(toks) && toks[name_at].kind == TK_IDENT {
				let name = toks[name_at].text
				if token_name_assigned_after(toks, name, name_at + 1) != 0 || token_has_initializer(toks, name_at + 1) == 0 {
					replacement = "mut"
				}
			} else {
				replacement = "mut"
			}
		} else if replacement == nil && t.kind == TK_PUNCT && t.text == ":=" {
			replacement = "="
		} else if replacement == nil && t.kind == TK_PUNCT && t.text == "++" {
			replacement = "+= 1"
			if t.start == cursor {
				replacement = " += 1"
			}
		} else if replacement == nil && t.kind == TK_PUNCT && t.text == "--" {
			replacement = "-= 1"
			if t.start == cursor {
				replacement = " -= 1"
			}
		}
		if cast([]i64, deletes)[i] != 0 {
			// The original token span is omitted; its surrounding trivia remains in source.
		} else if replacement != nil {
			buf_str(out, or_empty(replacement))
		} else {
			buf_str(out, source[t.start:t.start + t.end - t.start])
		}
		mut last = i
		if fx_span[i] != 0 {
			last = fx_span[i] - 1
			if suffixes[i] != nil {
				buf_str(out, or_empty(suffixes[i]))
			}
		}
		if suffixes[last] != nil {
			buf_str(out, or_empty(suffixes[last]))
		}
		cursor = toks[last].end
		i = last + 1
	}
	mut source_len = 0
	if len(toks) > 0 {
		source_len = toks[len(toks) - 1].end
	}
	if cursor < source_len {
		fx_copy_comments(cast([]u8, out), source, cursor, source_len)
	}
	return cast(i64, out)
}

// matching_brace returns the closing brace paired with open_at, or -1 for invalid input.
fn matching_brace(toks []i64, open_at i64) i64 {
	mut depth = 0
	mut i = open_at
	for i < len(toks) {
		let t = toks[i]
		if tok_is(cast(Token, t), "{{") != 0 {
			depth = depth + 1
		} else if tok_is(cast(Token, t), "}}") != 0 {
			depth = depth - 1
			if depth == 0 {
				return i
			}
		}
		i = i + 1
	}
	return -1
}

// loop_body_open finds the body brace for a C-style, range, or condition loop.
fn loop_body_open(toks []i64, loop_at i64) i64 {
	mut semi_count = 0
	mut parens = 0
	mut brackets = 0
	mut braces = 0
	mut i = loop_at + 1
	for i < len(toks) {
		let t = toks[i]
		if tok_is(cast(Token, t), "(") != 0 {
			parens = parens + 1
		} else if tok_is(cast(Token, t), ")") != 0 {
			parens = parens - 1
		} else if tok_is(cast(Token, t), "[") != 0 {
			brackets = brackets + 1
		} else if tok_is(cast(Token, t), "]") != 0 {
			brackets = brackets - 1
		} else if tok_is(cast(Token, t), "{{") != 0 {
			if braces == 0 && parens == 0 && brackets == 0 && (semi_count == 0 || semi_count >= 2) {
				return i
			}
			braces = braces + 1
		} else if tok_is(cast(Token, t), "}}") != 0 && braces > 0 {
			braces = braces - 1
		} else if tok_is(cast(Token, t), ";") != 0 && parens == 0 && brackets == 0 && braces == 0 {
			semi_count = semi_count + 1
		}
		i = i + 1
	}
	return -1
}

// token_inside_nested_loop reports whether target is inside another loop nested in outer_at.
fn token_inside_nested_loop(toks []Token, outer_at i64, body i64, close i64, target i64) i64 {
	mut i = body + 1
	for i < target {
		let t = toks[i]
		if (t.kind == TK_KEYWORD && (t.text == "for" || t.text == "while")) && i != outer_at {
			let open = loop_body_open(cast([]i64, toks), i)
			if open > i && open < target {
				let end = matching_brace(cast([]i64, toks), open)
				if end > target {
					return 1
				}
			}
		}
		i = i + 1
	}
	return 0
}

// source_indent returns the whitespace before a token on its source line.
fn source_indent(source str, token Token) str {
	let start = token.start
	mut i = start - 1
	for i >= 0 && i64(source[i]) != '\n' {
		i = i - 1
	}
	i = i + 1
	mut line = i
	for line < start && (i64(source[line]) == ' ' || i64(source[line]) == '\t') {
		line = line + 1
	}
	if line != start {
		return ""
	}
	return source[i:i + start - i]
}

// loop_post_text prints the post statement in edition-1 assignment syntax.
fn loop_post_text(source str, toks []Token, post_start i64, post_end i64, post_op_at i64) str {
	let b = buf_new()
	let name = toks[post_start].text
	let op = toks[post_op_at]
	if tok_is(op, "++") != 0 {
		buf_str(b, name)
		buf_str(b, " += 1")
	} else if tok_is(op, "--") != 0 {
		buf_str(b, name)
		buf_str(b, " -= 1")
	} else if tok_is(op, "+=") != 0 || tok_is(op, "-=") != 0 {
		buf_str(b, name)
		buf_byte(b, ' ')
		buf_str(b, op.text)
		buf_byte(b, ' ')
		let first = toks[post_op_at + 1].start
		let last = toks[post_end].end
		buf_str(b, source[first:first + last - first])
	} else {
		let first = toks[post_start].start
		let last = toks[post_end].end
		buf_str(b, source[first:first + last - first])
	}
	return str(b)
}

// rewrite_for_fallback moves a C loop's init out and post into its body when it is not a range.
fn rewrite_for_fallback(source str, toks []Token, for_at i64, replacements []?str, deletes []i64, prefixes []?str, suffixes []?str) i64 {
	mut semi1 = -1
	mut semi2 = -1
	let body = loop_body_open(cast([]i64, toks), for_at)
	if body < 0 {
		return 0
	}
	mut parens = 0
	mut brackets = 0
	mut braces = 0
	mut i = for_at + 1
	for i < body {
		let t = toks[i]
		if tok_is(cast(Token, t), "(") != 0 {
			parens = parens + 1
		} else if tok_is(cast(Token, t), ")") != 0 {
			parens = parens - 1
		} else if tok_is(cast(Token, t), "[") != 0 {
			brackets = brackets + 1
		} else if tok_is(cast(Token, t), "]") != 0 {
			brackets = brackets - 1
		} else if tok_is(cast(Token, t), "{{") != 0 {
			braces = braces + 1
		} else if tok_is(cast(Token, t), "}}") != 0 && braces > 0 {
			braces = braces - 1
		} else if tok_is(cast(Token, t), ";") != 0 && parens == 0 && brackets == 0 && braces == 0 {
			if semi1 < 0 {
				semi1 = i
			} else {
				semi2 = i
			}
		}
		i = i + 1
	}
	if semi1 < 0 || semi2 < 0 {
		return 0
	}
	let init_start = for_at + 1
	let init_end = semi1 - 1
	let cond_start = semi1 + 1
	let cond_end = semi2 - 1
	let post_start = semi2 + 1
	let post_end = body - 1
	let has_init = i64(init_start <= init_end)
	let has_cond = i64(cond_start <= cond_end)
	let has_post = i64(post_start <= post_end)
	let body_close = matching_brace(cast([]i64, toks), body)
	if body_close < 0 {
		return 0
	}
	mut post = ""
	mut post_op_at = -1
	if has_post != 0 {
		if toks[post_start].kind == TK_IDENT && post_start + 1 <= post_end {
			post_op_at = post_start + 1
			post = loop_post_text(source, toks, post_start, post_end, post_op_at)
		} else {
			return 0
		}
	}
	let find = source_indent(source, toks[for_at])
	if has_init != 0 {
		replacements[for_at] = "{{\n" + find + "\t"
		fx_triv[init_start] = ""
		if init_start + 1 <= init_end && tok_is(toks[init_start + 1], ":=") != 0 {
			prefixes[init_start] = "mut "
			replacements[init_start + 1] = "="
		}
		replacements[semi1] = "\n" + find + "\tfor "
		fx_triv[cond_start] = ""
		suffixes[body_close] = "\n" + find + "}}"
		fx_nest(body, body_close)
	} else if has_cond != 0 {
		replacements[semi1] = ""
		fx_triv[cond_start] = ""
	} else {
		replacements[semi1] = "true"
	}
	deletes[semi2] = 1
	fx_triv[semi2] = ""
	fx_triv[body] = " "
	mut extra = ""
	if has_init != 0 {
		extra = "\t"
	}
	if has_post != 0 {
		i = post_start
		for i <= post_end {
			deletes[i] = 1
			fx_triv[i] = ""
			i = i + 1
		}
		if has_cond != 0 {
			let close_token = toks[body_close]
			let indent = source_indent(source, close_token)
			let b = buf_new()
			if source_has_newline(source, toks[fx_prev(toks, body_close)].end, close_token.start) != 0 {
				buf_byte(b, '\t')
			} else {
				buf_byte(b, '\n')
				buf_str(b, indent)
				buf_str(b, extra)
				buf_byte(b, '\t')
			}
			buf_str(b, post)
			buf_byte(b, '\n')
			buf_str(b, indent)
			buf_str(b, extra)
			prefixes[body_close] = str(b)
			i = body + 1
			for i < body_close {
				let c = toks[i]
				if c.kind == TK_KEYWORD && c.text == "continue" && token_inside_nested_loop(toks, for_at, body, body_close, i) == 0 {
					let next = i + 1
					if next >= len(toks) || toks[next].kind != TK_IDENT {
						let token = c
						let ind = source_indent(source, token)
						let before = buf_new()
						buf_str(before, post)
						buf_byte(before, '\n')
						buf_str(before, ind)
						buf_str(before, extra)
						prefixes[i] = str(before)
					}
				}
				i = i + 1
			}
		}
	}
	return 1
}

// rewrite_while maps Go-style while conditions to edition-1 for loops.
fn rewrite_while(toks []Token, at i64, replacements []?str, deletes []i64) i64 {
	replacements[at] = "for"
	let next = at + 1
	if next < len(toks) && toks[next].kind == TK_INT && toks[next].val == 1 && tok_is(toks[next + 1], "{{") != 0 {
		deletes[next] = 1
	} else if next + 2 < len(toks) && tok_is(toks[next], "(") != 0 && toks[next + 1].kind == TK_INT && toks[next + 1].val == 1 && tok_is(toks[next + 2], ")") != 0 {
		deletes[next] = 1
		deletes[next + 1] = 1
		deletes[next + 2] = 1
	}
	return 1
}

// rewrite_switch changes statement switches into block-valued match arms and removes their breaks.
fn rewrite_switch(source str, toks []Token, switch_at i64, replacements []?str, deletes []i64, prefixes []?str, suffixes []?str) i64 {
	mut body = -1
	mut close = -1
	mut direct_case = 0
	mut i = switch_at + 1
	mut parens = 0
	mut brackets = 0
	mut braces = 0
	for i < len(toks) {
		let t = toks[i]
		if tok_is(t, "(") != 0 {
			parens = parens + 1
		} else if tok_is(t, ")") != 0 {
			parens = parens - 1
		} else if tok_is(t, "[") != 0 {
			brackets = brackets + 1
		} else if tok_is(t, "]") != 0 {
			brackets = brackets - 1
		} else if tok_is(t, "{{") != 0 {
			if braces == 0 && parens == 0 && brackets == 0 {
				let end = matching_brace(cast([]i64, toks), i)
				if end < 0 {
					return 0
				}
				mut depth = 0
				mut j = i + 1
				for j < end {
					let c = toks[j]
					if tok_is(c, "{{") != 0 {
						depth = depth + 1
					} else if tok_is(c, "}}") != 0 {
						depth = depth - 1
					} else if depth == 0 && c.kind == TK_KEYWORD && (c.text == "case" || c.text == "default") {
						direct_case = 1
					}
					j = j + 1
				}
				if direct_case != 0 {
					body = i
					close = end
					break
				}
			}
			braces = braces + 1
		} else if tok_is(t, "}}") != 0 && braces > 0 {
			braces = braces - 1
		}
		i = i + 1
	}
	if body < 0 {
		return 0
	}
	// switch init; subject { ... }: the init moves into a block around the match.
	let semi = slice_filled(1, 0)
	fx_body(toks, switch_at, cast([]i64, cast(i64, semi)))
	if semi[0] >= body {
		semi[0] = -1
	}
	mut subject = switch_at + 1
	if semi[0] >= 0 {
		subject = fx_next(toks, semi[0])
	}
	let expressionless = i64(body == subject)
	replacements[switch_at] = "match"
	if expressionless != 0 {
		prefixes[body] = "true "
	}
	let arms = []i64{}
	mut depth = 0
	i = body + 1
	for i < close {
		let t = toks[i]
		if tok_is(t, "{{") != 0 {
			depth = depth + 1
		} else if tok_is(t, "}}") != 0 {
			depth = depth - 1
		} else if depth == 0 && t.kind == TK_KEYWORD && (t.text == "case" || t.text == "default") {
			arms = append(arms, i)
		}
		i = i + 1
	}
	i = 0
	for i < len(arms) {
		let at = arms[i]
		let is_default = i64(toks[at].text == "default")
		mut next = close
		if i + 1 < len(arms) {
			next = arms[i + 1]
		}
		mut par = 0
		mut bracket = 0
		mut curly = 0
		mut colon = -1
		mut j = at + 1
		for j < next {
			let c = toks[j]
			if tok_is(c, "(") != 0 {
				par = par + 1
			} else if tok_is(c, ")") != 0 {
				par = par - 1
			} else if tok_is(c, "[") != 0 {
				bracket = bracket + 1
			} else if tok_is(c, "]") != 0 {
				bracket = bracket - 1
			} else if tok_is(c, "{{") != 0 {
				curly = curly + 1
			} else if tok_is(c, "}}") != 0 {
				curly = curly - 1
			} else if tok_is(c, ":") != 0 && par == 0 && bracket == 0 && curly == 0 {
				colon = j
				break
			}
			j = j + 1
		}
		if colon < 0 {
			return 0
		}
		fx_triv[fx_next(toks, at)] = ""
		if is_default != 0 {
			replacements[at] = "_"
			replacements[colon] = " => {{"
		} else if expressionless != 0 {
			replacements[at] = "true if ("
			j = at + 1
			par = 0
			bracket = 0
			curly = 0
			for j < colon {
				let c = toks[j]
				if tok_is(c, "(") != 0 {
					par = par + 1
				} else if tok_is(c, ")") != 0 {
					par = par - 1
				} else if tok_is(c, "[") != 0 {
					bracket = bracket + 1
				} else if tok_is(c, "]") != 0 {
					bracket = bracket - 1
				} else if tok_is(c, "{{") != 0 {
					curly = curly + 1
				} else if tok_is(c, "}}") != 0 {
					curly = curly - 1
				} else if tok_is(c, ",") != 0 && par == 0 && bracket == 0 && curly == 0 {
					replacements[j] = "||"
				}
				j = j + 1
			}
			replacements[colon] = ") => {{"
		} else {
			deletes[at] = 1
			replacements[colon] = " => {{"
		}
		if i > 0 {
			prefixes[at] = fx_arm_close(source, toks, at, "}}\n", "\t")
		}
		// Unlabelled breaks leave the switch in Go; each match arm already ends at its block.
		j = colon + 1
		for j < next {
			let c = toks[j]
			if c.kind == TK_KEYWORD && c.text == "break" {
				mut following = j + 1
				for following < next && toks[following].synth != 0 {
					following = following + 1
				}
				if following >= next || toks[following].kind != TK_IDENT {
					deletes[j] = 1
				}
			}
			j = j + 1
		}
		i = i + 1
	}
	// match arms sit one level deeper than the switch's cases did
	fx_nest(body, close - 1)
	prefixes[close] = fx_arm_close(source, toks, close, "\t}}\n", "")
	if semi[0] >= 0 {
		rewrite_init(source, toks, switch_at, semi[0], close, "match")
	}
	return 1
}

// rewrite_for_range converts a simple ascending C loop into Tin 1's range form.
fn rewrite_for_range(toks []Token, for_at i64, replacements []?str, deletes []i64, prefixes []?str, suffixes []?str) i64 {
	mut semi1 = -1
	mut semi2 = -1
	mut body = -1
	mut parens = 0
	mut brackets = 0
	mut braces = 0
	mut i = for_at + 1
	for i < len(toks) {
		let t = toks[i]
		if tok_is(cast(Token, t), "(") != 0 {
			parens = parens + 1
		} else if tok_is(cast(Token, t), ")") != 0 {
			parens = parens - 1
		} else if tok_is(cast(Token, t), "[") != 0 {
			brackets = brackets + 1
		} else if tok_is(cast(Token, t), "]") != 0 {
			brackets = brackets - 1
		} else if tok_is(cast(Token, t), "{{") != 0 {
			if braces == 0 && parens == 0 && brackets == 0 && semi2 >= 0 {
				body = i
				break
			}
			braces = braces + 1
		} else if tok_is(cast(Token, t), "}}") != 0 && braces > 0 {
			braces = braces - 1
		} else if tok_is(cast(Token, t), ";") != 0 && parens == 0 && brackets == 0 && braces == 0 {
			if semi1 < 0 {
				semi1 = i
			} else {
				semi2 = i
			}
		}
		i = i + 1
	}
	if semi1 < 0 || semi2 < 0 || body < 0 || semi1 <= for_at + 2 {
		return 0
	}
	let init_name = toks[for_at + 1]
	let init_op_at = for_at + 2
	let init_op = toks[init_op_at]
	if init_name.kind != TK_IDENT || tok_is(cast(Token, init_op), ":=") == 0 {
		return 0
	}
	let cond_name_at = semi1 + 1
	let cond_op_at = cond_name_at + 1
	if cond_op_at >= semi2 || toks[cond_name_at].kind != TK_IDENT || tok_is(toks[cond_op_at], "<") == 0 || init_name.text != toks[cond_name_at].text || cond_op_at + 1 >= semi2 {
		return 0
	}
	let post_name_at = semi2 + 1
	if post_name_at >= body || toks[post_name_at].kind != TK_IDENT || init_name.text != toks[post_name_at].text {
		return 0
	}
	let post_op_at = post_name_at + 1
	if post_op_at >= body {
		return 0
	}
	let post_op = toks[post_op_at]
	mut step_start = -1
	mut negate_step = 0
	if tok_is(cast(Token, post_op), "++") != 0 {
		if post_op_at + 1 != body {
			return 0
		}
	} else if tok_is(cast(Token, post_op), "+=") != 0 || tok_is(cast(Token, post_op), "-=") != 0 {
		if post_op_at + 1 >= body {
			return 0
		}
		step_start = post_op_at + 1
		negate_step = tok_is(cast(Token, post_op), "-=")
	} else if tok_is(cast(Token, post_op), "=") != 0 {
		if post_op_at + 3 >= body || toks[post_op_at + 1].kind != TK_IDENT || init_name.text != toks[post_op_at + 1].text || (tok_is(toks[post_op_at + 2], "+") == 0 && tok_is(toks[post_op_at + 2], "-") == 0) {
			return 0
		}
		step_start = post_op_at + 3
		negate_step = tok_is(toks[post_op_at + 2], "-")
	} else {
		return 0
	}
	if step_start >= 0 && step_start >= body {
		return 0
	}
	// A range evaluates its bound once and owns its variable: the C loop's shape converts
	// only when the body changes neither (else the fallback keeps the loop's meaning).
	let close = matching_brace(cast([]i64, toks), body)
	if close < 0 || fx_assigns(toks, body, close, init_name.text) != 0 {
		return 0
	}
	// The bound is one operand of the `<`: a top-level &&, || or comparison belongs to the
	// condition, and a call other than len may give another value on the next iteration.
	mut b = cond_op_at + 1
	mut depth = 0
	for b < semi2 {
		let bt = toks[b]
		if fx_open(cast(i64, bt)) != 0 {
			depth = depth + 1
		} else if fx_close(cast(i64, bt)) != 0 {
			depth = depth - 1
		} else if depth == 0 && (tok_is(bt, "&&") != 0 || tok_is(bt, "||") != 0 || tok_is(bt, "==") != 0 || tok_is(bt, "!=") != 0 || tok_is(bt, "<") != 0 || tok_is(bt, "<=") != 0 || tok_is(bt, ">") != 0 || tok_is(bt, ">=") != 0) {
			return 0
		}
		if tok_is(bt, "(") != 0 && b > cond_op_at + 1 {
			let callee = toks[b - 1]
			if callee.kind == TK_IDENT && callee.text != "len" {
				return 0
			}
		}
		if bt.kind == TK_IDENT && fx_assigns(toks, body, close, bt.text) != 0 {
			return 0
		}
		b = b + 1
	}
	replacements[init_op_at] = "in"
	replacements[semi1] = ".."
	deletes[cond_name_at] = 1
	deletes[cond_op_at] = 1
	deletes[semi2] = 1
	deletes[post_name_at] = 1
	// no spaces around '..' and none where tokens went
	fx_triv[semi1] = ""
	fx_triv[cond_name_at] = ""
	fx_triv[cond_op_at] = ""
	fx_triv[cond_op_at + 1] = ""
	fx_triv[semi2] = ""
	fx_triv[post_name_at] = ""
	fx_triv[post_op_at] = ""
	if post_op_at + 1 < body {
		fx_triv[post_op_at + 1] = ""
	}
	mut unit_step = 0
	if step_start >= 0 && step_start + 1 == body {
		let step = toks[step_start]
		unit_step = i64(step.kind == TK_INT && step.val == 1 && negate_step == 0)
	}
	if step_start < 0 || unit_step != 0 {
		deletes[post_op_at] = 1
		if step_start >= 0 {
			if tok_is(cast(Token, post_op), "=") != 0 {
				deletes[post_op_at + 1] = 1
				deletes[post_op_at + 2] = 1
			}
			deletes[step_start] = 1
		}
		return 1
	}
	prefixes[init_op_at + 1] = "("
	suffixes[semi2 - 1] = ")"
	if tok_is(cast(Token, post_op), "=") != 0 {
		replacements[post_op_at] = ".step("
		deletes[post_op_at + 1] = 1
		deletes[post_op_at + 2] = 1
	} else if negate_step != 0 {
		replacements[post_op_at] = ".step(-"
	} else {
		replacements[post_op_at] = ".step("
	}
	suffixes[body - 1] = ")"
	return 1
}

// token_name_assigned_after reports any later assignment to name in the parsed file.
// Over-marking a shadowed name as mutable is harmless to generated code; an assigned binding
// must never be printed as immutable.
fn token_name_assigned_after(toks []Token, name str, start i64) i64 {
	mut i = start
	mut depth = 0
	for i < len(toks) {
		let t = toks[i]
		// the declaring block's end: a later function's variable of that name is another one
		if tok_is(t, "{{") != 0 {
			depth = depth + 1
		} else if tok_is(t, "}}") != 0 {
			depth = depth - 1
			if depth < 0 {
				return 0
			}
		}
		if t.synth == 0 && t.kind == TK_IDENT && t.text == name {
			mut prev = i - 1
			for prev >= 0 && toks[prev].synth != 0 {
				prev = prev - 1
			}
			mut next = i + 1
			for next < len(toks) && toks[next].synth != 0 {
				next = next + 1
			}
			if (prev < 0 || tok_is(toks[prev], ".") == 0) && next < len(toks) {
				let op = toks[next]
				if tok_is(cast(Token, op), "=") != 0 || tok_is(cast(Token, op), ":=") != 0 || tok_is(cast(Token, op), "++") != 0 || tok_is(cast(Token, op), "--") != 0 || tok_is(cast(Token, op), "+=") != 0 || tok_is(cast(Token, op), "-=") != 0 || tok_is(cast(Token, op), "*=") != 0 || tok_is(cast(Token, op), "/=") != 0 || tok_is(cast(Token, op), "%=") != 0 || tok_is(cast(Token, op), "&=") != 0 || tok_is(cast(Token, op), "|=") != 0 || tok_is(cast(Token, op), "^=") != 0 || tok_is(cast(Token, op), "<<=") != 0 || tok_is(cast(Token, op), ">>=") != 0 {
					return 1
				}
			}
		}
		i = i + 1
	}
	return 0
}

// token_has_initializer reports whether a declaration's name is followed by '=' before its line ends.
fn token_has_initializer(toks []Token, start i64) i64 {
	mut i = start
	for i < len(toks) {
		let t = toks[i]
		if t.synth != 0 || tok_is(t, ";") != 0 || tok_is(t, "}}") != 0 {
			return 0
		}
		if tok_is(t, "=") != 0 {
			return 1
		}
		i = i + 1
	}
	return 0
}

// ---- the edition-1 translator's structural rewrites (#225) ----
//
// The printer above changes token spans in place. These rules also replace several tokens
// at once (fx_span), rewrite the trivia before a token (fx_triv), and put text into the
// trivia before a top-level declaration (fx_lead: hoisted local constants).
shared mut fx_span []i64 // fx_span[i] = j + 1: tokens i..j print as token i's replacement alone (0: none)
shared mut fx_triv []?str // the trivia printed before token i instead of the source's (0: keep it)
shared mut fx_lead []str // text put into the trivia before token i, after its last blank line
shared mut fx_ind []i64 // tabs added after each newline in the trivia before token i (a block now nested)
shared mut fx_cur_ind i64 // fx_ind of the token whose trivia is being printed
shared mut fx_trusted i64 // the file is a trusted library file: `secret` before a type is the qualifier
shared mut fx_top i64 // the top-level declaration being printed
shared mut fx_path str // the translated file's path (set by main): its package's other files share names
shared mut fx_pkg_names []str // the names the package's other files declare or hoist (read when first needed)
shared mut fx_hoisted []Hoisted // the local constants already hoisted
shared mut fx_fn_name str // the name of the function being printed (prefixes a clashing local constant)
shared mut fx_rep []?str // the printer's replacements, prefixes and suffixes (print_edition1)
shared mut fx_pre []?str
shared mut fx_suf []?str

fn fx_add(v []?str, i i64, text str) {
	if let old = v[i] {
		v[i] = old + text
	} else {
		v[i] = text
	}
}

fn fx_next(toks []Token, i i64) i64 {
	mut j = i + 1
	for j < len(toks) && toks[j].synth != 0 {
		j = j + 1
	}
	return j
}

fn fx_prev(toks []Token, i i64) i64 {
	mut j = i - 1
	for j >= 0 && toks[j].synth != 0 {
		j = j - 1
	}
	return j
}

// fx_text is the source text from token a's start to token b's end.
fn fx_text(source str, toks []Token, a i64, b i64) str {
	let s = toks[a].start
	let e = toks[b].end
	return source[s:s + e - s]
}

fn fx_kw(t Token, word str) i64 {
	return i64(t.kind == TK_KEYWORD && t.text == word)
}

fn fx_open(t i64) i64 {
	return i64(tok_is(cast(Token, t), "(") != 0 || tok_is(cast(Token, t), "[") != 0 || tok_is(cast(Token, t), "{{") != 0)
}

fn fx_close(t i64) i64 {
	return i64(tok_is(cast(Token, t), ")") != 0 || tok_is(cast(Token, t), "]") != 0 || tok_is(cast(Token, t), "}}") != 0)
}

// fx_body finds the block of the statement starting at kw: the first '{' outside brackets.
// semi gets the first explicit ';' before it (an init statement), or -1.
fn fx_body(toks []Token, kw i64, semi []i64) i64 {
	semi[0] = -1
	mut depth = 0
	mut i = kw + 1
	for i < len(toks) {
		let t = toks[i]
		if tok_is(t, "{{") != 0 && depth == 0 {
			return i
		}
		if fx_open(cast(i64, t)) != 0 {
			depth = depth + 1
		} else if fx_close(cast(i64, t)) != 0 {
			depth = depth - 1
		} else if depth == 0 && t.synth == 0 && tok_is(t, ";") != 0 && semi[0] < 0 {
			semi[0] = i
		}
		i = i + 1
	}
	return -1
}

// fx_chain_end is the last '}' of the if/else chain whose first block opens at body.
fn fx_chain_end(toks []Token, body i64) i64 {
	mut end = matching_brace(cast([]i64, toks), body)
	for end >= 0 {
		let e = fx_next(toks, end)
		if e >= len(toks) || fx_kw(toks[e], "else") == 0 {
			return end
		}
		let n = fx_next(toks, e)
		if n < len(toks) && fx_kw(toks[n], "if") != 0 {
			let semi = slice_filled(1, 0)
			let b = fx_body(toks, n, cast([]i64, cast(i64, semi)))
			if b < 0 {
				return -1
			}
			end = matching_brace(cast([]i64, toks), b)
		} else {
			return matching_brace(cast([]i64, toks), n)
		}
	}
	return end
}

// rewrite_init moves the init statement of `if init; cond {` (or a switch's) into a block of
// its own around the whole statement, so its names keep their scope:
// `{ let x = init; if cond { ... } }`. word is what the statement starts with afterwards.
fn rewrite_init(source str, toks []Token, kw i64, semi i64, end i64, word str) {
	let ind = source_indent(source, toks[kw])
	fx_add(fx_pre, kw, "{{\n" + ind + "\t")
	fx_rep[kw] = ""
	fx_triv[fx_next(toks, kw)] = ""
	fx_rep[semi] = "\n" + ind + "\t" + word
	fx_add(fx_suf, end, "\n" + ind + "}}")
	fx_nest(semi, end)
}

fn rewrite_if_init(source str, toks []i64, at i64, replacements []?str, prefixes []?str, suffixes []?str) i64 {
	let semi = slice_filled(1, 0)
	let body = fx_body(cast([]Token, toks), at, cast([]i64, cast(i64, semi)))
	if body < 0 || semi[0] < 0 {
		return 0
	}
	let end = fx_chain_end(cast([]Token, toks), body)
	if end < 0 {
		return 0
	}
	rewrite_init(source, cast([]Token, toks), at, semi[0], end, "if")
	return 1
}

// rewrite_for_each turns `for k, v := range x` into `for k, v in x`. One name is the index
// or key alone, which edition 1 writes `for k, _ in x`; a range over an integer literal is
// the range 0..n. An assignment form (`for k = range x`) has no edition-1 spelling.
fn rewrite_for_each(source str, toks []Token, for_at i64, replacements []?str, suffixes []?str) i64 {
	let semi = slice_filled(1, 0)
	let body = fx_body(toks, for_at, cast([]i64, cast(i64, semi)))
	if body < 0 || semi[0] >= 0 {
		return 0
	}
	mut r = -1
	mut depth = 0
	mut i = for_at + 1
	for i < body {
		let t = toks[i]
		if fx_open(cast(i64, t)) != 0 {
			depth = depth + 1
		} else if fx_close(cast(i64, t)) != 0 {
			depth = depth - 1
		} else if depth == 0 && fx_kw(cast(Token, t), "range") != 0 {
			r = i
			break
		}
		i = i + 1
	}
	if r < 0 {
		return 0
	}
	let x = fx_next(toks, r)
	let int_bound = i64(fx_next(toks, x) == body && toks[x].kind == TK_INT)
	if r == fx_next(toks, for_at) {
		replacements[r] = "_ in"
		if int_bound != 0 {
			replacements[r] = "_ in 0.."
			fx_triv[x] = ""
		}
		return 1
	}
	let op = fx_prev(toks, r)
	if tok_is(toks[op], ":=") == 0 {
		return 0
	}
	let k = fx_next(toks, for_at)
	mut names = 1
	if fx_next(toks, k) != op {
		names = 2
	}
	replacements[op] = "in"
	fx_span[op] = r + 1
	if int_bound != 0 {
		if names != 1 {
			return 0
		}
		replacements[op] = "in 0.."
		fx_triv[x] = ""
	} else if names == 1 {
		fx_add(suffixes, k, ", _")
	}
	return 1
}

// rewrite_local_const hoists `const name = value` out of a function to package level,
// where edition 1 allows constants (a constant there compiles exactly as one inside). The
// declaration goes before the top-level declaration holding it; a name already declared
// at package level, or hoisted with another value, gets the function's name in front.
// Only a single-name constant in the function's own block moves: one in a nested block
// may shadow a name the hoisted one would hide, so it stays, and edition 1 reports it.
fn rewrite_local_const(source str, toks []Token, at i64, top i64, replacements []?str, level i64) i64 {
	let name = fx_next(toks, at)
	if level != 1 || name >= len(toks) || toks[name].kind != TK_IDENT {
		return 0
	}
	if tok_is(toks[fx_next(toks, name)], ",") != 0 {
		return 0
	}
	// the statement ends at the first semicolon outside brackets
	mut depth = 0
	mut last = name
	mut i = name
	for i < len(toks) {
		let t = toks[i]
		if fx_open(cast(i64, t)) != 0 {
			depth = depth + 1
		} else if fx_close(cast(i64, t)) != 0 {
			if depth == 0 {
				break
			}
			depth = depth - 1
		} else if depth == 0 && tok_is(cast(Token, t), ";") != 0 {
			break
		}
		last = i
		i = i + 1
	}
	let nm = toks[name].text
	if nm == "_" {
		fx_drop_statement(source, toks, at, last, replacements)
		return 1
	}
	mut rest = ""
	if fx_next(toks, name) <= last {
		rest = fx_value_text(source, toks, fx_next(toks, name), last)
	}
	// the hoisted name: the same one unless the package level already has it, or another
	// function hoisted it with another value; then the function's name prefixes it
	mut new_ = fx_renamed(nm)
	mut conflict = fx_top_declares(cast([]i64, toks), nm)
	mut k = 0
	for k < len(fx_hoisted) {
		let h = fx_hoisted[k]
		if h.name == new_ && h.text != rest {
			conflict = 1
		}
		k = k + 1
	}
	if conflict != 0 {
		let up = buf_new()
		buf_byte(up, i64(byte_at(nm, 0)) - 32 * i64((i64(byte_at(nm, 0)) >= 'a' && i64(byte_at(nm, 0)) <= 'z')))
		buf_str(up, nm[1:])
		new_ = fx_fn_name + str(up)
	}
	if new_ != nm {
		fx_rename_uses(toks, last + 1, nm, new_)
	}
	k = 0
	for k < len(fx_hoisted) {
		let h = fx_hoisted[k]
		if h.name == new_ {
			// already hoisted with this value: the statement goes, a comment on its line stays
			let next = fx_next(toks, last)
			let note = fx_take_line_comment(source, toks, last)
			if len(note) != 0 {
				let ind = source_indent(source, toks[at])
				fx_triv[next] = "\n" + ind + note + or_empty(fx_triv[next])
			}
			fx_drop_statement(source, toks, at, last, replacements)
			return 1
		}
		k = k + 1
	}
	let h = cast(Hoisted, calloc(2, 8))
	h.name = new_
	h.text = rest
	fx_hoisted = append(fx_hoisted, h)
	// a comment after the constant on its line moves with it
	let note = fx_take_line_comment(source, toks, last)
	if len(note) != 0 {
		rest = rest + " " + note
	}
	fx_lead[top] = fx_lead[top] + "const " + new_ + " " + rest + "\n\n"
	fx_drop_statement(source, toks, at, last, replacements)
	return 1
}

// fx_value_text is the source of tokens a..b as it reads at package level: names renamed
// so far (an earlier hoisted constant, a reserved word) are written with their new names.
fn fx_value_text(source str, toks []Token, a i64, b i64) str {
	let out = buf_new()
	mut cursor = toks[a].start
	mut i = a
	for i <= b {
		let t = toks[i]
		if t.synth == 0 {
			buf_str(out, source[cursor:cursor + t.start - cursor])
			let p = fx_prev(toks, i)
			if let rp = fx_rep[i] {
				buf_str(out, rp)
			} else if t.kind == TK_IDENT && (p < 0 || tok_is(toks[p], ".") == 0) {
				buf_str(out, fx_renamed(t.text))
			} else {
				buf_str(out, source[t.start:t.start + t.end - t.start])
			}
			cursor = t.end
		}
		i = i + 1
	}
	return str(out)
}

// fx_take_line_comment returns the // comment after token last on its line, or 0, and leaves
// it out of the next token's trivia.
fn fx_take_line_comment(source str, toks []Token, last i64) str {
	let next = fx_next(toks, last)
	if next >= len(toks) {
		return ""
	}
	mut i = toks[last].end
	let end = toks[next].start
	for i < end && (i64(source[i]) == ' ' || i64(source[i]) == '\t') {
		i = i + 1
	}
	if !(i + 1 < end && i64(source[i]) == '/' && i64(source[i + 1]) == '/') {
		return ""
	}
	let start = i
	for i < end && i64(source[i]) != '\n' {
		i = i + 1
	}
	let note = source[start:start + i - start]
	if fx_triv[next] == nil {
		fx_triv[next] = source[i:i + end - i]
	}
	return note
}

// fx_drop_statement removes tokens a..b and the line they stood on.
fn fx_drop_statement(source str, toks []Token, a i64, b i64, replacements []?str) i64 {
	replacements[a] = ""
	fx_span[a] = b + 1
	if let set = fx_triv[a] {
		// trivia an earlier rewrite already chose (a moved comment left out): drop its last line
		mut n = len(set)
		for n > 0 && (i64(set[n - 1]) == ' ' || i64(set[n - 1]) == '\t') {
			n = n - 1
		}
		if n > 0 && i64(set[n - 1]) == '\n' {
			fx_triv[a] = set[:n - 1]
		}
		return 0
	}
	let prev = fx_prev(toks, a)
	mut from = 0
	if prev >= 0 {
		from = toks[prev].end
	}
	let to = toks[a].start
	mut j = to
	for j > from && (i64(source[j - 1]) == ' ' || i64(source[j - 1]) == '\t') {
		j = j - 1
	}
	if j > from && i64(source[j - 1]) == '\n' {
		fx_triv[a] = source[from:from + j - 1 - from]
	}
	return 0
}

// fx_top_declares reports a package-level declaration of name in this file or in another
// file of its package (a library package: the files of a main directory are separate programs).
fn fx_top_declares(toks []i64, name str) i64 {
	if fx_file_declares(cast([]Token, toks), name) != 0 {
		return 1
	}
	if cast(i64, fx_pkg_names) == 0 {
		fx_pkg_names = fx_sibling_names(cast([]Token, toks))
	}
	mut i = 0
	for i < len(fx_pkg_names) {
		if fx_pkg_names[i] == name {
			return 1
		}
		i = i + 1
	}
	return 0
}

// fx_sibling_names lists what the other .tin files in the translated file's directory declare
// at package level, and the local constants they would hoist there, when the package is not main.
fn fx_sibling_names(toks []Token) []str {
	let names = []str{}
	mut p = 0
	for p + 1 < len(toks) && fx_kw(toks[p], "package") == 0 {
		p = p + 1
	}
	if len(fx_path) == 0 || p + 1 >= len(toks) || toks[p + 1].text == "main" {
		return names
	}
	let dir = dir_of(fx_path)
	let d = host_opendir(dir)
	if d == 0 {
		return names
	}
	let self = fx_base(fx_path)
	for {
		let ent = rt_sys_readdir(d)
		if ent == 0 {
			break
		}
		let dname = host_dirent_name(ent)
		let name = host_str(dname)
		if ends_with(name, ".tin") != 0 && byte_at(name, 0) != '.' && name != self {
			let src = cast([]u8, cast([]i64, try_read_file(cat_path(cat_path(dir, "/"), name))))
			if cast(i64, src) != 0 {
				let srctext = str(src)
				let stoks = cast([]i64, lex(0, srctext, source_edition(srctext)))
				fx_collect_names(cast([]Token, stoks), names)
			}
		}
	}
	rt_sys_closedir(d)
	return names
}

fn fx_base(path str) str {
	mut i = len(path)
	for i > 0 && i64(path[i - 1]) != '/' {
		i = i - 1
	}
	return path[i:]
}

// fx_collect_names adds the names declared at package level in toks (const groups included)
// and every constant declared inside a function.
fn fx_collect_names(toks []Token, names []str) {
	mut depth = 0
	mut group = 0
	mut i = 0
	for i < len(toks) {
		let t = toks[i]
		let n = fx_next(toks, i)
		if (fx_kw(t, "const") != 0 || fx_kw(t, "var") != 0) && n < len(toks) && tok_is(toks[n], "(") != 0 && depth == 0 {
			group = 1
		} else if group != 0 && depth == 1 && t.kind == TK_IDENT && (i == 0 || tok_is(toks[i - 1], ";") != 0 || tok_is(toks[i - 1], "(") != 0) {
			names = append(names, t.text)
		}
		if tok_is(t, "{{") != 0 || tok_is(t, "(") != 0 || tok_is(t, "[") != 0 {
			depth = depth + 1
		} else if tok_is(t, "}}") != 0 || tok_is(t, ")") != 0 || tok_is(t, "]") != 0 {
			depth = depth - 1
			if depth == 0 {
				group = 0
			}
		} else if n < len(toks) && toks[n].kind == TK_IDENT && (fx_kw(t, "const") != 0 || (depth == 0 && (fx_kw(t, "var") != 0 || fx_kw(t, "type") != 0 || fx_kw(t, "func") != 0 || fx_kw(t, "fn") != 0 || fx_kw(t, "let") != 0 || fx_kw(t, "mut") != 0))) {
			names = append(names, toks[n].text)
		}
		i = i + 1
	}
}

// fx_file_declares reports a package-level declaration of name in this file.
fn fx_file_declares(toks []Token, name str) i64 {
	mut depth = 0
	mut i = 0
	for i < len(toks) {
		let t = toks[i]
		if tok_is(cast(Token, t), "{{") != 0 || tok_is(cast(Token, t), "(") != 0 || tok_is(cast(Token, t), "[") != 0 {
			depth = depth + 1
		} else if tok_is(cast(Token, t), "}}") != 0 || tok_is(cast(Token, t), ")") != 0 || tok_is(cast(Token, t), "]") != 0 {
			depth = depth - 1
		} else if depth == 0 && (fx_kw(cast(Token, t), "const") != 0 || fx_kw(cast(Token, t), "var") != 0 || fx_kw(cast(Token, t), "type") != 0 || fx_kw(cast(Token, t), "func") != 0) {
			let n = fx_next(toks, i)
			if n < len(toks) && toks[n].text == name {
				return 1
			}
		}
		i = i + 1
	}
	return 0
}

// fx_unit is the edition-1 unit of a tide duration constant, or 0.
fn fx_unit(name str) str {
	if name == "Nanosecond" {
		return "ns"
	}
	if name == "Microsecond" {
		return "us"
	}
	if name == "Millisecond" {
		return "ms"
	}
	if name == "Second" {
		return "s"
	}
	if name == "Minute" {
		return "m"
	}
	if name == "Hour" {
		return "h"
	}
	return ""
}

// rewrite_tide_unit turns `n * tide.Millisecond` and `tide.Millisecond * n` (n an integer
// literal) into the unit literal `nms`, and a lone `tide.Second` into `1s`.
fn rewrite_tide_unit(toks []Token, at i64, replacements []?str) i64 {
	let dot = fx_next(toks, at)
	let name = fx_next(toks, dot)
	if name >= len(toks) || tok_is(toks[dot], ".") == 0 || toks[name].kind != TK_IDENT {
		return 0
	}
	let unit_ = fx_unit(toks[name].text)
	if len(unit_) == 0 {
		return 0
	}
	let prev = fx_prev(toks, at)
	if prev >= 0 && tok_is(toks[prev], ".") != 0 {
		return 0
	}
	let star = fx_prev(toks, at)
	let lit = fx_prev(toks, star)
	if lit >= 0 && tok_is(toks[star], "*") != 0 && toks[lit].kind == TK_INT && fx_binds_tighter(cast([]i64, toks), fx_prev(toks, lit)) == 0 {
		replacements[lit] = fx_int_text(toks[lit]) + unit_
		fx_span[lit] = name + 1
		return 1
	}
	let star2 = fx_next(toks, name)
	let lit2 = fx_next(toks, star2)
	if lit2 < len(toks) && tok_is(toks[star2], "*") != 0 && toks[lit2].kind == TK_INT && fx_binds_tighter(cast([]i64, toks), prev) == 0 && fx_binds_tighter(cast([]i64, toks), fx_next(toks, lit2)) == 0 {
		replacements[at] = fx_int_text(toks[lit2]) + unit_
		fx_span[at] = lit2 + 1
		return 1
	}
	if fx_binds_tighter(cast([]i64, toks), prev) == 0 && fx_binds_tighter(cast([]i64, toks), fx_next(toks, name)) == 0 {
		replacements[at] = "1" + unit_
		fx_span[at] = name + 1
		return 1
	}
	return 0
}

// fx_binds_tighter reports an operator next to a unit expression that binds more tightly
// than '*' would after the rewrite (a unary minus, '.', an index).
fn fx_binds_tighter(toks []i64, i i64) i64 {
	if i < 0 || i >= len(toks) {
		return 0
	}
	let t = toks[i]
	return i64(tok_is(cast(Token, t), ".") != 0 || tok_is(cast(Token, t), "/") != 0 || tok_is(cast(Token, t), "%") != 0 || tok_is(cast(Token, t), "[") != 0 || tok_is(cast(Token, t), "<<") != 0 || tok_is(cast(Token, t), ">>") != 0)
}

fn fx_int_text(t Token) str {
	let b = buf_new()
	buf_int(b, t.val)
	return str(b)
}

// fx_copy_trivia copies the source between tokens, turning /* block comments */ into
// line comments and putting lead (if any) after the trivia's last blank line.
fn fx_copy_trivia(out []u8, source str, a i64, b i64, lead str) {
	mut at = a
	if len(lead) != 0 {
		mut k = b - 1
		at = -1
		for k > a {
			if i64(source[k]) == '\n' && i64(source[k - 1]) == '\n' {
				at = k + 1
				break
			}
			k = k - 1
		}
		if at < 0 {
			at = a
			for at < b && i64(source[at]) != '\n' {
				at = at + 1
			}
			if at < b {
				at = at + 1
			}
		}
		fx_copy_comments(out, source, a, at)
		buf_str(out, lead)
	}
	fx_copy_comments(out, source, at, b)
}

fn fx_copy_comments(out []u8, source str, a i64, b i64) {
	mut i = a
	for i < b {
		let c = i64(source[i])
		if c == '/' && i + 1 < b && i64(source[i + 1]) == '/' {
			for i < b && i64(source[i]) != '\n' {
				buf_byte(out, i64(source[i]))
				i = i + 1
			}
		} else if c == '/' && i + 1 < b && i64(source[i + 1]) == '*' {
			// the indentation of the comment's first line, for the lines after it
			mut ls = i
			for ls > 0 && i64(source[ls - 1]) != '\n' {
				ls = ls - 1
			}
			let ind = buf_new()
			mut q = ls
			for q < i && (i64(source[q]) == ' ' || i64(source[q]) == '\t') {
				buf_byte(ind, i64(source[q]))
				q = q + 1
			}
			i = i + 2
			buf_str(out, "//")
			for i < b && !(i64(source[i]) == '*' && i + 1 < b && i64(source[i + 1]) == '/') {
				let d = i64(source[i])
				buf_byte(out, d)
				if d == '\n' {
					fx_put_tabs(out)
					buf_bytes(out, slice_data(ind), len(ind))
					// skip the comment line's own indentation and a leading '*'
					i = i + 1
					for i < b && (i64(source[i]) == ' ' || i64(source[i]) == '\t') {
						i = i + 1
					}
					buf_str(out, "//")
					if i < b && i64(source[i]) == '*' && !(i + 1 < b && i64(source[i + 1]) == '/') {
						i = i + 1
					}
					if i < b && i64(source[i]) != ' ' && i64(source[i]) != '\n' && !(i64(source[i]) == '*' && i + 1 < b && i64(source[i + 1]) == '/') {
						buf_byte(out, ' ')
					}
					continue
				}
				i = i + 1
			}
			for len(out) > 0 && (i64(out[len(out) - 1]) == ' ' || i64(out[len(out) - 1]) == '\t') {
				slice_truncate(out, len(out) - 1)
			}
			i = i + 2
			// code after the comment on the same line goes to a line of its own
			mut j = i
			for j < b && (i64(source[j]) == ' ' || i64(source[j]) == '\t') {
				j = j + 1
			}
			if j >= b || i64(source[j]) != '\n' {
				buf_byte(out, '\n')
				fx_put_tabs(out)
				buf_bytes(out, slice_data(ind), len(ind))
				i = j
			}
		} else {
			buf_byte(out, c)
			if c == '\n' && i + 1 < b && i64(source[i + 1]) != '\n' {
				fx_put_tabs(out)
			}
			i = i + 1
		}
	}
}

// fx_reserved reports the words edition 1 reserves that edition-0 code may use as names
// (edition 0 has none of their constructs): such a name gets a trailing '_', the same in
// every file, so a package's files still agree.
fn fx_reserved(toks []Token, i i64) i64 {
	let t = toks[i]
	if t.kind != TK_IDENT {
		return 0
	}
	let s = t.text
	if s == "shared" {
		let n = fx_next(toks, i)
		return i64(n >= len(toks) || fx_kw(toks[n], "var") == 0)
	}
	if s == "enum" {
		let n = fx_next(toks, i)
		return i64(n >= len(toks) || tok_is(toks[n], "{{") == 0)
	}
	if s == "keep" {
		// the builtin keep(x) stays; a name spelled the same is renamed, and so is every use
		// of it in a declaration that has such a name (a parameter called like a function)
		let n = fx_next(toks, i)
		if n >= len(toks) || tok_is(toks[n], "(") == 0 {
			return 1
		}
		mut j = fx_top
		for j < i {
			let u = toks[j]
			if u.kind == TK_IDENT && u.text == "keep" {
				let un = fx_next(toks, j)
				if un >= len(toks) || tok_is(toks[un], "(") == 0 {
					return 1
				}
			}
			j = j + 1
		}
		return 0
	}
	if s == "secret" && fx_trusted != 0 {
		// `name secret T`, `) secret T`, `[]secret T`: the qualifier, the same word in edition 1
		let n = fx_next(toks, i)
		let p = fx_prev(toks, i)
		if n < len(toks) && p >= 0 && (toks[n].kind == TK_IDENT || tok_is(toks[n], "[") != 0 || tok_is(toks[n], "?") != 0) && (toks[p].kind == TK_IDENT || tok_is(toks[p], ")") != 0 || tok_is(toks[p], "]") != 0) {
			return 0
		}
	}
	return i64(s == "match" || s == "within" || s == "limit" || s == "guard" || s == "parallel" || s == "detach" || s == "secret")
}

// rewrite_field_attr moves a struct field's trailing attribute (`Name str @json("n")`)
// before the field, where edition 1 writes it (`@json("n") Name str`).
fn rewrite_field_attr(source str, toks []Token, at i64) i64 {
	// An attribute that starts its line (edition 1's place, after a synthetic ';') stays.
	let raw = at - 1
	if raw < 0 || tok_is(toks[raw], "{{") != 0 || tok_is(toks[raw], ";") != 0 || tok_is(toks[raw], "(") != 0 {
		return 0
	}
	let prev = fx_prev(toks, at)
	let name = fx_next(toks, at)
	mut last = name
	let open = fx_next(toks, name)
	if open < len(toks) && tok_is(toks[open], "(") != 0 {
		mut depth = 0
		mut j = open
		for j < len(toks) {
			let c = toks[j]
			if tok_is(cast(Token, c), "(") != 0 {
				depth = depth + 1
			} else if tok_is(cast(Token, c), ")") != 0 {
				depth = depth - 1
				if depth == 0 {
					break
				}
			}
			j = j + 1
		}
		last = j
	}
	// the field starts after the previous line's ';' (a synthetic one too) or the '{'
	mut k = at - 1
	for k >= 0 && tok_is(toks[k], ";") == 0 && tok_is(toks[k], "{{") == 0 {
		k = k - 1
	}
	mut first = k + 1
	for first < at && toks[first].synth != 0 {
		first = first + 1
	}
	fx_add(fx_pre, first, fx_text(source, toks, at, last) + " ")
	fx_rep[at] = ""
	fx_span[at] = last + 1
	fx_triv[at] = ""
	return 1
}

// rewrite_const_group expands `const ( A T = iota; B; C )` into one declaration per name:
// edition 1 has neither groups nor iota, so each value is written out with iota replaced
// by its index and an omitted value repeating the previous one.
fn rewrite_const_group(source str, toks []Token, at i64) i64 {
	let open = fx_next(toks, at)
	if open >= len(toks) || tok_is(toks[open], "(") == 0 {
		return 0
	}
	mut close = open
	mut depth = 0
	for close < len(toks) {
		let c = toks[close]
		if fx_open(cast(i64, c)) != 0 {
			depth = depth + 1
		} else if fx_close(cast(i64, c)) != 0 {
			depth = depth - 1
			if depth == 0 {
				break
			}
		}
		close = close + 1
	}
	let out = buf_new()
	mut spec_first = -1 // the previous spec's type-and-value tokens, for repetition
	mut spec_last = -1
	mut index = 0
	mut i = fx_next(toks, open)
	mut cursor = toks[open].end
	for i < close {
		// one spec: Name [Type] [= Expr], ending at a ';'
		mut end = i
		mut d = 0
		for end < close {
			let c = toks[end]
			if fx_open(cast(i64, c)) != 0 {
				d = d + 1
			} else if fx_close(cast(i64, c)) != 0 {
				d = d - 1
			} else if d == 0 && tok_is(c, ";") != 0 {
				break
			}
			end = end + 1
		}
		let last = fx_prev(toks, end)
		if last < i {
			i = fx_next(toks, end)
			continue
		}
		// trivia before the spec, one level less indented; the first starts the declaration
		if index == 0 {
			mut q = cursor
			for q < toks[i].start && (i64(source[q]) == ' ' || i64(source[q]) == '\t') {
				q = q + 1
			}
			if i64(source[q]) == '\n' {
				cursor = q + 1
				if i64(source[cursor]) == '\t' {
					cursor = cursor + 1
				}
			}
		}
		fx_copy_dedent(cast([]u8, out), source, cursor, toks[i].start)
		let name = toks[i]
		buf_str(out, "const ")
		buf_str(out, fx_renamed(name.text))
		let rest = fx_next(toks, i)
		if rest <= last {
			spec_first = rest
			spec_last = last
		}
		if spec_first < 0 {
			return 0
		}
		mut k = spec_first
		mut prev_end = toks[i].end
		if rest > last {
			buf_byte(out, ' ')
			prev_end = toks[spec_first].start
		}
		for k <= spec_last {
			let c = toks[k]
			if c.synth == 0 {
				buf_str(out, source[prev_end:prev_end + c.start - prev_end])
				if c.kind == TK_IDENT && c.text == "iota" {
					buf_int(out, index)
				} else {
					buf_str(out, source[c.start:c.start + c.end - c.start])
				}
				prev_end = c.end
			}
			k = k + 1
		}
		cursor = toks[last].end
		index = index + 1
		i = fx_next(toks, end)
	}
	fx_copy_dedent(cast([]u8, out), source, cursor, toks[close].start)
	for len(out) > 0 && (i64(out[len(out) - 1]) == '\n' || i64(out[len(out) - 1]) == ' ' || i64(out[len(out) - 1]) == '\t') {
		slice_truncate(out, len(out) - 1)
	}
	fx_rep[at] = str(out)
	fx_span[at] = close + 1
	return 1
}

// fx_copy_dedent copies trivia with one tab less at each line start.
fn fx_copy_dedent(out []u8, source str, a i64, b i64) {
	mut i = a
	for i < b {
		let c = i64(source[i])
		buf_byte(out, c)
		i = i + 1
		if c == '\n' && i < b && i64(source[i]) == '\t' {
			i = i + 1
		}
	}
}

// fx_renamed is a name as the translator prints it: reserved words get a trailing '_'.
fn fx_renamed(name str) str {
	if name == "match" || name == "within" || name == "limit" || name == "guard" || name == "parallel" || name == "detach" || name == "secret" || name == "shared" || name == "enum" || name == "keep" {
		return name + "_"
	}
	return name
}

// fx_rename_uses renames name to new in the function body after token from (up to the
// body's closing brace), except where it follows a '.' (a field or a package member).
fn fx_rename_uses(toks []Token, from i64, name str, new_ str) i64 {
	mut depth = 0
	mut i = from
	for i < len(toks) {
		let t = toks[i]
		if tok_is(t, "{{") != 0 {
			depth = depth + 1
		} else if tok_is(t, "}}") != 0 {
			if depth == 0 {
				return 0
			}
			depth = depth - 1
		} else if t.kind == TK_IDENT && t.text == name {
			let p = fx_prev(toks, i)
			if p < 0 || tok_is(toks[p], ".") == 0 {
				fx_rep[i] = new_
			}
		}
		i = i + 1
	}
	return 0
}

// matching_paren returns the ')' that closes the '(' at open, or the last token.
fn matching_paren(toks []i64, open i64) i64 {
	mut depth = 0
	mut i = open
	for i < len(toks) {
		let t = toks[i]
		if tok_is(cast(Token, t), "(") != 0 {
			depth = depth + 1
		} else if tok_is(cast(Token, t), ")") != 0 {
			depth = depth - 1
			if depth == 0 {
				return i
			}
		}
		i = i + 1
	}
	return len(toks) - 1
}

// fx_assigns reports a change to name between tokens a and b: an assignment or increment
// (name = ..., name += ..., name++), or name passed as mut.
fn fx_assigns(toks []Token, a i64, b i64, name str) i64 {
	mut i = a
	for i < b {
		let t = toks[i]
		if t.kind == TK_IDENT && t.text == name {
			let p = fx_prev(toks, i)
			mut pt = 0
			if p >= 0 {
				pt = cast(i64, toks[p])
			}
			if pt != 0 && tok_is(cast(Token, pt), "mut") != 0 {
				return 1
			}
			if pt == 0 || tok_is(cast(Token, pt), ".") == 0 {
				let n = fx_next(toks, i)
				if n < len(toks) {
					let op = toks[n]
					if tok_is(cast(Token, op), "=") != 0 || tok_is(cast(Token, op), ":=") != 0 || tok_is(cast(Token, op), "++") != 0 || tok_is(cast(Token, op), "--") != 0 || tok_is(cast(Token, op), "+=") != 0 || tok_is(cast(Token, op), "-=") != 0 || tok_is(cast(Token, op), "*=") != 0 || tok_is(cast(Token, op), "/=") != 0 || tok_is(cast(Token, op), "%=") != 0 || tok_is(cast(Token, op), "&=") != 0 || tok_is(cast(Token, op), "|=") != 0 || tok_is(cast(Token, op), "^=") != 0 || tok_is(cast(Token, op), "<<=") != 0 || tok_is(cast(Token, op), ">>=") != 0 {
						return 1
					}
				}
			}
		}
		i = i + 1
	}
	return 0
}

// fx_put writes n bytes of trivia, adding fx_cur_ind tabs after each newline that does not
// end an empty line.
fn fx_put(out []u8, s str) {
	mut i = 0
	for i < len(s) {
		let c = i64(s[i])
		buf_byte(out, c)
		if c == '\n' && i + 1 < len(s) && i64(s[i + 1]) != '\n' {
			fx_put_tabs(out)
		}
		i = i + 1
	}
}

// fx_arm_close is the text that closes a match arm before token at: on a line of its own when
// the token starts a line, else "} ".
fn fx_arm_close(source str, toks []Token, at i64, head str, tail str) str {
	let t = toks[at]
	if source_has_newline(source, toks[fx_prev(toks, at)].end, t.start) != 0 {
		return head + source_indent(source, t) + tail
	}
	return "}} "
}

fn source_has_newline(source str, a_in i64, b i64) i64 {
	mut a = a_in
	for a < b {
		if i64(source[a]) == '\n' {
			return 1
		}
		a = a + 1
	}
	return 0
}

fn fx_put_tabs(out []u8) {
	mut k = 0
	for k < fx_cur_ind {
		buf_byte(out, '\t')
		k = k + 1
	}
}

// fx_nest marks tokens a+1..b as one block deeper than in the source.
fn fx_nest(a i64, b i64) {
	mut i = a + 1
	for i <= b && i < len(fx_ind) {
		fx_ind[i] = fx_ind[i] + 1
		i = i + 1
	}
}
