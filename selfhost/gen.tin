const CTX_WORDS = 32 // runtime context words before the per-core globals (lib/runtime.tin ctxWords)

// Code generator: checked AST to the ARM64 instruction list in asm.tin.
//
// Locals whose address is never taken live in registers: callee-saved x19-x27 and
// d8-d15, or caller-saved x9-x15 and d16-d30 in leaf functions. Expressions evaluate
// into stacks of temporary registers (one per register class) indexed by depth, so
// memory is only touched by real loads and stores, values live across calls, and the
// rare expression too deep for the pool. x28 holds the thread context (like Go's g),
// x16/x17 and d31 are scratch.
const REG_SLOT = -1
const REG_DEAD = -2
const MAX_FRAME = 4095
const FPR = 64 // d0 is register 64
const FSCR = 95 // d31, float scratch

shared mut code i64 // the whole program
shared mut cg i64 // the current function body
shared mut g_labels i64
shared mut g_str_ptrs i64
shared mut g_str_lens i64
shared mut g_tstr_ptrs i64 // Tin string literals (length-prefixed)
shared mut g_tstr_lens i64
shared mut g_loops i64 // (continue, break) label pairs of the enclosing loops
shared mut t_regs i64 // integer temporaries of the current function, by depth
shared mut t_count i64
shared mut f_regs i64 // float temporaries, by depth
shared mut f_count i64
shared mut used_regs i64 // bitmask of integer registers the current function writes
shared mut used_fregs i64 // bitmask of float registers
shared mut cur_gen_fn i64
shared mut pl i64 // gen_pair results
shared mut pr i64
shared mut cmp_cc i64 // gen_compare result
shared mut am_base i64 // gen_addr8 results
shared mut am_index i64
shared mut am_off i64
shared mut mm_base i64 // gen_mem_addr results
shared mut mm_index i64
shared mut mm_off i64
shared mut trap_label i64 // the current function's bounds-failure stub, once used
shared mut trap_sites i64 // per failed-check site: [label, index reg (or -1), length reg, constant index]
shared mut incoming_stack_loads i64 // pairs: instruction index in cg, incoming argument byte offset

fn emit4(op i64, a i64, b i64, c i64, d i64) {
	vec_push(cg, op)
	vec_push(cg, a)
	vec_push(cg, b)
	vec_push(cg, c)
	vec_push(cg, d)
}

fn emit3(op i64, a i64, b i64, c i64) {
	emit4(op, a, b, c, 0)
}

fn emit2(op i64, a i64, b i64) {
	emit4(op, a, b, 0, 0)
}

fn emit1(op i64, a i64) {
	emit4(op, a, 0, 0, 0)
}

fn new_label() i64 {
	g_labels = g_labels + 1
	return g_labels
}

fn label(l i64) {
	emit1(I_LABEL, l)
}

fn is_fp(r i64) i64 {
	return i64(r >= FPR)
}

fn e_fp(e i64) i64 {
	return is_float_t(e[N_TYPE])
}

// mov copies between registers of either class (across classes it moves the bits).
fn mov(dst i64, src i64) {
	if dst == src {
		return
	}
	if is_fp(dst) != 0 && is_fp(src) != 0 {
		emit2(I_FMOV, dst, src)
	} else if is_fp(dst) != 0 {
		emit2(I_FMOVDX, dst, src)
	} else if is_fp(src) != 0 {
		emit2(I_FMOVXD, dst, src)
	} else {
		emit2(I_MOV, dst, src)
	}
}

fn treg(d i64) i64 {
	let r = vec_get(t_regs, d)
	used_regs = used_regs | (1 << r)
	return r
}

fn freg(d i64) i64 {
	let r = vec_get(f_regs, d)
	used_fregs = used_fregs | (1 << (r - FPR))
	return r
}

// next_depth is the first free temp depth once r holds a value computed at depth d.
fn next_depth(r i64, d i64) i64 {
	if d < t_count && r == vec_get(t_regs, d) {
		return d + 1
	}
	if d < f_count && r == vec_get(f_regs, d) {
		return d + 1
	}
	return d
}

fn room(d i64, fp i64) i64 {
	if fp != 0 {
		return i64(d < f_count)
	}
	return i64(d < t_count)
}

// ---- expression properties ----
fn is_const(e i64) i64 {
	let k = e[N_KIND]
	if k == EX_INT {
		return 1
	}
	if k == EX_IDENT {
		return i64(e[ID_REF] != 0 && e[ID_REF][S_KIND] == SYM_CONST)
	}
	if k == EX_UNARY {
		return i64(streq(e[UN_OP], cstr("&")) == 0 && e_fp(e) == 0 && fold_safe(e) != 0 && is_const(e[UN_X]) != 0)
	}
	if k == EX_BINARY {
		// A zero divisor (left by inlining) is not folded, so strict code reaches the panic.
		if (streq(e[BIN_OP], cstr("/")) != 0 || streq(e[BIN_OP], cstr("%")) != 0) && is_const(e[BIN_R]) != 0 && const_val(e[BIN_R]) == 0 {
			return 0
		}
		return i64(e_fp(e[BIN_L]) == 0 && fold_safe(e) != 0 && fold_safe(e[BIN_L]) != 0 && is_const(e[BIN_L]) != 0 && is_const(e[BIN_R]) != 0)
	}
	return 0
}

// fold_safe: signed 64-bit (or untyped) arithmetic folds like the machine does it.
fn fold_safe(e i64) i64 {
	let t = e[N_TYPE]
	if t == 0 {
		return 1
	}
	let k = t[TY_KIND]
	if k == K_BOOL {
		return 1
	}
	if k != K_INT {
		return 1
	}
	return i64(t[TY_SIGNED] != 0 && t[TY_WIDTH] == 8)
}

fn const_val(e i64) i64 {
	let k = e[N_KIND]
	if k == EX_INT {
		return e[INT_VAL]
	}
	if k == EX_IDENT {
		return e[ID_REF][S_VAL]
	}
	if k == EX_UNARY {
		return eval_unary(e[UN_OP], const_val(e[UN_X]))
	}
	return eval_binary(e[BIN_OP], const_val(e[BIN_L]), const_val(e[BIN_R]))
}

// may_panic reports whether binary e can panic by itself: integer / and % do unless the
// divisor is a nonzero constant, so moving them past their guards is unsafe.
fn may_panic(e i64) i64 {
	if e_fp(e) != 0 || (streq(e[BIN_OP], cstr("/")) == 0 && streq(e[BIN_OP], cstr("%")) == 0) {
		return 0
	}
	return i64(is_const(e[BIN_R]) == 0 || const_val(e[BIN_R]) == 0)
}

fn is_real_call(e i64) i64 {
	return i64(e[N_KIND] == EX_CALL && e[CALL_INTRINSIC] == 0)
}

fn stmts_have_call(stmts i64) i64 {
	mut i = 0
	for i < stmts[VEC_LEN] {
		if stmt_has_call(vec_get(stmts, i)) != 0 {
			return 1
		}
		i = i + 1
	}
	return 0
}

fn stmt_has_call(s i64) i64 {
	if s == 0 {
		return 0
	}
	let k = s[N_KIND]
	if k == ST_BLOCK {
		return stmts_have_call(s[BLK_STMTS])
	}
	if k == ST_LET {
		return contains_call(s[LET_INIT])
	}
	if k == ST_ASSIGN {
		return i64(contains_call(s[AS_TARGET]) != 0 || contains_call(s[AS_VALUE]) != 0)
	}
	if k == ST_EXPR {
		return contains_call(s[ES_X])
	}
	if k == ST_IF {
		return i64(contains_call(s[IF_COND]) != 0 || stmt_has_call(s[IF_THEN]) != 0 || stmt_has_call(s[IF_ELSE]) != 0)
	}
	if k == ST_WHILE {
		return i64(contains_call(s[WH_COND]) != 0 || stmt_has_call(s[WH_BODY]) != 0 || stmt_has_call(s[WH_POST]) != 0)
	}
	if k == ST_RETURN {
		return 1
	}
	if k == ST_CALLMULTI {
		return 1
	}
	return 0
}

fn contains_call(e i64) i64 {
	if e == 0 {
		return 0
	}
	let k = e[N_KIND]
	if k == EX_CALL {
		if e[CALL_INTRINSIC] == 0 {
			return 1
		}
		let args = e[CALL_ARGS]
		mut i = 0
		for i < args[VEC_LEN] {
			if contains_call(vec_get(args, i)) != 0 {
				return 1
			}
			i = i + 1
		}
		return 0
	}
	if k == EX_UNARY {
		return contains_call(e[UN_X])
	}
	if k == EX_BINARY {
		return i64(contains_call(e[BIN_L]) != 0 || contains_call(e[BIN_R]) != 0)
	}
	if k == EX_INDEX {
		return i64(contains_call(e[IX_X]) != 0 || contains_call(e[IX_I]) != 0)
	}
	if k == EX_CONV {
		return contains_call(e[CV_X])
	}
	if k == EX_MEM {
		return i64(contains_call(e[MEM_BASE]) != 0 || contains_call(e[MEM_INDEX]) != 0 || contains_call(e[MEM_LEN]) != 0)
	}
	if k == EX_ELEM {
		return i64(contains_call(e[ELEM_SEQ]) != 0 || contains_call(e[ELEM_IDX]) != 0)
	}
	if k == EX_SEQ {
		return 1
	}
	return 0
}

fn has_effects(e i64) i64 {
	let k = e[N_KIND]
	if k == EX_CALL {
		if e[CALL_INTRINSIC] == 0 || streq(e[CALL_NAME], cstr("load8")) == 0 {
			return 1
		}
		return has_effects(vec_get(e[CALL_ARGS], 0))
	}
	if k == EX_UNARY {
		return has_effects(e[UN_X])
	}
	if k == EX_BINARY {
		return i64(has_effects(e[BIN_L]) != 0 || has_effects(e[BIN_R]) != 0)
	}
	if k == EX_INDEX {
		return i64(has_effects(e[IX_X]) != 0 || has_effects(e[IX_I]) != 0)
	}
	if k == EX_CONV {
		return has_effects(e[CV_X])
	}
	if k == EX_MEM {
		return i64(has_effects(e[MEM_BASE]) != 0 || (e[MEM_INDEX] != 0 && has_effects(e[MEM_INDEX]) != 0))
	}
	if k == EX_ELEM {
		return i64(has_effects(e[ELEM_SEQ]) != 0 || has_effects(e[ELEM_IDX]) != 0)
	}
	if k == EX_SEQ {
		return 1
	}
	return 0
}

// expr_equal compares effect-free expressions structurally, types included: the same tree
// at another type (a conversion's target, a constant settled by context) is another value.
fn expr_equal(a i64, b i64) i64 {
	let k = a[N_KIND]
	if k != b[N_KIND] || a[N_TYPE] != b[N_TYPE] {
		return 0
	}
	if k == EX_INT {
		return i64(a[INT_VAL] == b[INT_VAL])
	}
	if k == EX_FLOAT {
		return i64(a[FL_BITS] == b[FL_BITS])
	}
	if k == EX_IDENT {
		return i64(a[ID_REF] == b[ID_REF])
	}
	if k == EX_UNARY {
		return i64(streq(a[UN_OP], b[UN_OP]) != 0 && expr_equal(a[UN_X], b[UN_X]) != 0)
	}
	if k == EX_BINARY {
		return i64(streq(a[BIN_OP], b[BIN_OP]) != 0 && expr_equal(a[BIN_L], b[BIN_L]) != 0 && expr_equal(a[BIN_R], b[BIN_R]) != 0)
	}
	if k == EX_INDEX {
		return i64(expr_equal(a[IX_X], b[IX_X]) != 0 && expr_equal(a[IX_I], b[IX_I]) != 0)
	}
	if k == EX_CONV {
		return i64(a[CV_KIND] == b[CV_KIND] && expr_equal(a[CV_X], b[CV_X]) != 0)
	}
	if k == EX_MEM {
		return i64(a[MEM_OFF] == b[MEM_OFF] && a[MEM_SCALE] == b[MEM_SCALE] && expr_equal(a[MEM_BASE], b[MEM_BASE]) != 0 && opt_equal(a[MEM_INDEX], b[MEM_INDEX]) != 0)
	}
	if k == EX_ELEM {
		return i64(expr_equal(a[ELEM_SEQ], b[ELEM_SEQ]) != 0 && expr_equal(a[ELEM_IDX], b[ELEM_IDX]) != 0)
	}
	return 0
}

fn opt_equal(a i64, b i64) i64 {
	if a == 0 || b == 0 {
		return i64(a == b)
	}
	return expr_equal(a, b)
}

// log2 of a positive power of two, else -1.
fn pow2_log(c i64) i64 {
	if c <= 0 || (c & (c - 1)) != 0 {
		return -1
	}
	mut k = 0
	for (1 << k) != c {
		k = k + 1
	}
	return k
}

// k when c == 2^k - 1 (k ones), else 0.
fn low_mask_bits(c i64) i64 {
	if c <= 0 || (c & (c + 1)) != 0 {
		return 0
	}
	mut k = 0
	for k < 63 && ((c >> k) & 1) != 0 {
		k = k + 1
	}
	return k
}

// ucond_code is the unsigned comparison's condition.
fn ucond_code(op i64) i64 {
	if streq(op, cstr("<")) != 0 {
		return C_LO
	}
	if streq(op, cstr("<=")) != 0 {
		return C_LS
	}
	if streq(op, cstr(">")) != 0 {
		return C_HI
	}
	if streq(op, cstr(">=")) != 0 {
		return C_HS
	}
	return cond_code(op)
}

fn cond_code(op i64) i64 {
	if streq(op, cstr("==")) != 0 {
		return C_EQ
	}
	if streq(op, cstr("!=")) != 0 {
		return C_NE
	}
	if streq(op, cstr("<")) != 0 {
		return C_LT
	}
	if streq(op, cstr("<=")) != 0 {
		return C_LE
	}
	if streq(op, cstr(">")) != 0 {
		return C_GT
	}
	if streq(op, cstr(">=")) != 0 {
		return C_GE
	}
	return -1
}

// After fcmp, MI and LS are the ordered < and <=, so NaN compares false like Go.
fn fcond_code(op i64) i64 {
	if streq(op, cstr("==")) != 0 {
		return C_EQ
	}
	if streq(op, cstr("!=")) != 0 {
		return C_NE
	}
	if streq(op, cstr("<")) != 0 {
		return C_MI
	}
	if streq(op, cstr("<=")) != 0 {
		return C_LS
	}
	if streq(op, cstr(">")) != 0 {
		return C_GT
	}
	return C_GE
}

// swap_cc is the condition for the same comparison with its operands exchanged.
fn swap_cc(cc i64) i64 {
	if cc == C_LT {
		return C_GT
	}
	if cc == C_GT {
		return C_LT
	}
	if cc == C_LE {
		return C_GE
	}
	if cc == C_GE {
		return C_LE
	}
	if cc == C_LO {
		return C_HI
	}
	if cc == C_HI {
		return C_LO
	}
	if cc == C_LS {
		return C_HS
	}
	if cc == C_HS {
		return C_LS
	}
	return cc
}

fn e_unsigned(e i64) i64 {
	return is_unsigned_t(e[N_TYPE])
}

fn string_index(p i64, n i64) i64 {
	mut i = 0
	for i < g_str_ptrs[VEC_LEN] {
		if vec_get(g_str_lens, i) == n && mem_eq(vec_get(g_str_ptrs, i), p, n) != 0 {
			return i
		}
		i = i + 1
	}
	vec_push(g_str_ptrs, p)
	vec_push(g_str_lens, n)
	return i
}

fn tstring_index(p i64, n i64) i64 {
	mut i = 0
	for i < g_tstr_ptrs[VEC_LEN] {
		if vec_get(g_tstr_lens, i) == n && mem_eq(vec_get(g_tstr_ptrs, i), p, n) != 0 {
			return i
		}
		i = i + 1
	}
	vec_push(g_tstr_ptrs, p)
	vec_push(g_tstr_lens, n)
	return i
}

// ---- expressions ----
fn load_imm(dst i64, v i64) {
	if is_fp(dst) != 0 {
		if v == 0 {
			emit2(I_FMOVDX, dst, ZR)
			return
		}
		load_imm(X17, v)
		emit2(I_FMOVDX, dst, X17)
		return
	}
	if v >= 0 && v <= 65535 {
		emit3(I_MOVZ, dst, v, 0)
		return
	}
	if v < 0 && v >= -65536 {
		emit3(I_MOVN, dst, ~v, 0)
		return
	}
	mut zeros = 0
	mut ones = 0
	mut s = 0
	for s < 64 {
		let h = (v >> s) & 0xffff
		if h == 0 {
			zeros = zeros + 1
		}
		if h == 0xffff {
			ones = ones + 1
		}
		s = s + 16
	}
	// Start from all ones (movn) or all zeros (movz), whichever leaves fewer movk.
	mut fill = 0
	if ones > zeros {
		fill = 0xffff
	}
	mut first = 1
	s = 0
	for s < 64 {
		let part = (v >> s) & 0xffff
		if part != fill {
			if first != 0 && fill != 0 {
				emit3(I_MOVN, dst, ~part & 0xffff, s)
			} else if first != 0 {
				emit3(I_MOVZ, dst, part, s)
			} else {
				emit3(I_MOVK, dst, part, s)
			}
			first = 0
		}
		s = s + 16
	}
}

// gen_val returns a register holding e: a local's own register, or temp depth d.
fn gen_val(e i64, d i64) i64 {
	let k = e[N_KIND]
	if k == EX_REG {
		return e[REG_NUM]
	}
	if k == EX_IDENT && e[ID_REF][S_KIND] == SYM_LOCAL && e[ID_REF][S_REG] >= 0 {
		return e[ID_REF][S_REG]
	}
	mut r = 0
	if e_fp(e) != 0 {
		r = freg(d)
	} else {
		r = treg(d)
	}
	gen_to(e, r, d)
	return r
}

// gen_to computes e into dst using temps from depth d up; dst is written last.
fn gen_dyn_mem_address(e i64, d i64) {
	if e[N_KIND] == EX_ELEM {
		gen_elem_addr(e, d)
	} else {
		gen_mem_addr(e, d)
	}
	if mm_index >= 0 {
		emit4(I_ADD, X16, mm_base, mm_index, SH_LSL + 4)
		if mm_off != 0 {
			add_imm(X16, X16, mm_off)
		}
	} else if mm_off != 0 {
		add_imm(X16, mm_base, mm_off)
	} else {
		mov(X16, mm_base)
	}
}

// gen_dyn_pair computes a dyn value into adjacent machine registers. In storage the two
// words are contiguous; globals use an explicit second data word because each declaration
// has its own linker slot.
fn gen_dyn_pair(e i64, obj i64, tab i64, d i64) {
	let k = e[N_KIND]
	if k == EX_CONV && e[CV_KIND] == CV_DYN_OBJECT {
		mut spare = X17
		if obj == X17 {
			spare = X16
		}
		gen_dyn_pair(e[CV_X], obj, spare, d)
		return
	}
	if k == EX_CONV && e[CV_KIND] == CV_DYN_TABLE_WORD {
		mut spare = X16
		if tab == X16 {
			spare = X17
		}
		gen_dyn_pair(e[CV_X], spare, tab, d)
		return
	}
	if k == EX_CONV && e[CV_KIND] == CV_DYN_DESC {
		gen_dyn_pair(e[CV_X], X16, X17, d)
		emit3(I_LDR, obj, X17, 8 * e[CV_DYN_INDEX])
		return
	}
	if k == EX_CONV && e[CV_KIND] == CV_DYN {
		gen_to(e[CV_X], obj, d)
		let rec = vec_get(dyn_tables, e[CV_DYN_TABLE])
		let sym = sym_ref(SK_VAR, vec_get(rec, 4))
		emit2(I_ADRP, tab, sym)
		emit3(I_ADDLO, tab, tab, sym)
		return
	}
	if k == EX_CONV && e[CV_KIND] == CV_DYN_KEEP {
		gen_dyn_pair(e[CV_X], obj, tab, d)
		let done = new_label()
		emit2(I_CBZ, obj, done)
		emit1(I_PUSH, tab)
		emit3(I_LDR, X16, tab, 0)
		emit3(I_LDR, X17, X16, 0)
		mov(0, obj)
		save_temps(d)
		emit1(I_BLR, X17)
		restore_temps(d)
		emit1(I_POP, tab)
		if obj != 0 {
			mov(obj, 0)
		}
		label(done)
		return
	}
	if k == EX_SEQ {
		gen_seq(e, -1, d)
		gen_dyn_pair(e[SEQ_VALUE], obj, tab, d)
		return
	}
	if k == EX_CALL {
		gen_call(e, d)
		if obj != 0 {
			mov(obj, 0)
		}
		if tab != 1 {
			mov(tab, 1)
		}
		return
	}
	if k == EX_CONV && e[CV_KIND] == CV_SAME {
		gen_dyn_pair(e[CV_X], obj, tab, d)
		return
	}
	if k == EX_IDENT {
		let s = e[ID_REF]
		if s[S_KIND] == SYM_LOCAL {
			emit3(I_LDR, obj, FP, s[S_OFF])
			emit3(I_LDR, tab, FP, s[S_OFF] + 8)
		} else if s[S_TLS] != 0 {
			emit3(I_LDR, obj, 28, tls_off(s))
			emit3(I_LDR, tab, 28, tls_off(s) + 8)
		} else {
			let first = sym_ref(SK_VAR, s[S_INDEX])
			let second = sym_ref(SK_VAR, s[S_WORDS])
			emit2(I_ADRP, X16, first)
			emit3(I_ADDLO, X16, X16, first)
			emit3(I_LDR, obj, X16, 0)
			emit2(I_ADRP, X16, second)
			emit3(I_ADDLO, X16, X16, second)
			emit3(I_LDR, tab, X16, 0)
		}
		return
	}
	if k == EX_MEM || k == EX_ELEM {
		gen_dyn_mem_address(e, d)
		emit3(I_LDR, obj, X16, 0)
		emit3(I_LDR, tab, X16, 8)
		return
	}
	if k == EX_INT && is_const(e) != 0 && const_val(e) == 0 {
		emit3(I_MOVZ, obj, 0, 0)
		emit3(I_MOVZ, tab, 0, 0)
		return
	}
	err_code_at(e[N_POS], cstr("E990 INTERNAL"), cstr("unsupported dyn value location in code generation"))
}

fn gen_to(e i64, dst i64, d i64) {
	let k = e[N_KIND]
	if k == EX_INT {
		load_imm(dst, e[INT_VAL])
	} else if k == EX_FLOAT {
		load_imm(dst, e[FL_BITS])
	} else if k == EX_STR {
		mut sym = 0
		if kind_of(e[N_TYPE]) == K_STRING {
			sym = sym_ref(SK_TSTR, tstring_index(e[STR_PTR], e[STR_LEN]))
		} else {
			sym = sym_ref(SK_STR, string_index(e[STR_PTR], e[STR_LEN]))
		}
		emit2(I_ADRP, dst, sym)
		emit3(I_ADDLO, dst, dst, sym)
	} else if k == EX_IDENT {
		gen_ident(e, dst)
	} else if k == EX_REG {
		mov(dst, e[REG_NUM])
	} else if k == EX_UNARY {
		gen_unary(e, dst, d)
	} else if k == EX_BINARY {
		gen_binary(e, dst, d)
	} else if k == EX_INDEX {
		gen_index_load(e, dst, d)
	} else if k == EX_CONV && (e[CV_KIND] == CV_DYN || e[CV_KIND] == CV_DYN_KEEP || e[CV_KIND] == CV_DYN_OBJECT || e[CV_KIND] == CV_DYN_DESC) {
		gen_dyn_pair(e, dst, X17, d)
	} else if k == EX_CONV && e[CV_KIND] == CV_DYN_TABLE_WORD {
		mut spare = X16
		if dst == X16 {
			spare = X17
		}
		gen_dyn_pair(e[CV_X], spare, dst, d)
	} else if k == EX_CONV && e[CV_KIND] == CV_SAME && is_dyn_value(e[N_TYPE]) != 0 {
		gen_dyn_pair(e, dst, X17, d)
	} else if k == EX_CONV {
		gen_conv(e, dst, d)
	} else if k == EX_MEM {
		if is_dyn_value(e[N_TYPE]) != 0 {
			gen_dyn_pair(e, dst, X17, d)
		} else {
			gen_mem_load(e, dst, d)
		}
	} else if k == EX_ELEM {
		if is_dyn_value(e[N_TYPE]) != 0 {
			gen_dyn_pair(e, dst, X17, d)
		} else {
			gen_elem_load(e, dst, d)
		}
	} else if k == EX_SEQ {
		gen_seq(e, dst, d)
	} else if k == EX_FUNCREF {
		mut kind = SK_FNDESC
		if e[FR_RAW] != 0 {
			kind = SK_FN
		}
		let fs = sym_ref(kind, e[FR_FN][F_INDEX])
		emit2(I_ADRP, dst, fs)
		emit3(I_ADDLO, dst, dst, fs)
	} else if e[CALL_INTRINSIC] != 0 {
		gen_intrinsic(e, dst, d)
	} else {
		gen_call(e, d)
		if is_fp(dst) != 0 {
			mov(dst, FPR)
		} else {
			mov(dst, 0)
		}
	}
}

// tls_off is a per-core global's offset from x28: the context words come first.
fn tls_off(s i64) i64 {
	return 8 * (CTX_WORDS + s[S_TLS] - 1)
}

fn gen_ident(e i64, dst i64) {
	let s = e[ID_REF]
	let k = s[S_KIND]
	if k == SYM_LOCAL {
		if s[S_REG] >= 0 {
			mov(dst, s[S_REG])
		} else if is_fp(dst) != 0 {
			emit3(I_LDRD, dst, FP, s[S_OFF])
		} else {
			emit3(I_LDR, dst, FP, s[S_OFF])
		}
	} else if k == SYM_GLOBAL && s[S_TLS] != 0 {
		if is_fp(dst) != 0 {
			emit3(I_LDRD, dst, 28, tls_off(s))
		} else {
			emit3(I_LDR, dst, 28, tls_off(s))
		}
	} else if k == SYM_GLOBAL {
		let sym = sym_ref(SK_VAR, s[S_INDEX])
		if is_fp(dst) != 0 {
			emit2(I_ADRP, X17, sym)
			emit3(I_LDRLO, X17, X17, sym)
			emit2(I_FMOVDX, dst, X17)
		} else {
			emit2(I_ADRP, dst, sym)
			emit3(I_LDRLO, dst, dst, sym)
		}
	} else {
		load_imm(dst, s[S_VAL])
	}
}

// gen_pair evaluates two operands into pl and pr. pr may be x0/d0 (a call result) or
// a scratch register (a spill), so the caller must consume both right away.
fn gen_pair(lexp i64, rexp i64, d i64) {
	let l = gen_val(lexp, d)
	let d2 = next_depth(l, d)
	let rfp = e_fp(rexp)
	mut r = 0
	if is_real_call(rexp) != 0 {
		gen_call(rexp, d2)
		if rfp != 0 {
			r = FPR
		}
	} else if room(d2, rfp) == 0 {
		if is_fp(l) != 0 {
			emit1(I_FPUSH, l)
		} else {
			emit1(I_PUSH, l)
		}
		let rr = gen_val(rexp, d)
		if rfp != 0 {
			mov(FSCR, rr)
			r = FSCR
		} else {
			mov(X17, rr)
			r = X17
		}
		if is_fp(l) != 0 {
			emit1(I_FPOP, l)
		} else {
			emit1(I_POP, l)
		}
	} else {
		r = gen_val(rexp, d2)
	}
	pl = l
	pr = r
}

fn gen_unary(e i64, dst i64, d i64) {
	let op = e[UN_OP]
	if streq(op, cstr("&")) != 0 {
		let s = e[UN_X][ID_REF]
		if s[S_KIND] == SYM_LOCAL {
			emit3(I_ADDI, dst, FP, s[S_OFF])
		} else if s[S_TLS] != 0 {
			load_imm(X17, tls_off(s))
			emit3(I_ADD, dst, 28, X17)
		} else {
			let sym = sym_ref(SK_VAR, s[S_INDEX])
			emit2(I_ADRP, dst, sym)
			emit3(I_ADDLO, dst, dst, sym)
		}
		return
	}
	if is_const(e) != 0 {
		load_imm(dst, const_val(e))
		return
	}
	let x = gen_val(e[UN_X], d)
	if is_fp(dst) != 0 {
		emit2(I_FNEG, dst, x)
		return
	}
	if streq(op, cstr("-")) != 0 {
		emit2(I_NEG, dst, x)
	} else if streq(op, cstr("~")) != 0 {
		emit2(I_MVN, dst, x)
	} else {
		emit2(I_CMPI, x, 0)
		emit2(I_CSET, dst, C_EQ)
		return
	}
	mask_byte(e, dst)
}

// mask_byte keeps narrow integer results canonical: sign-extended for i8/i16/i32,
// zero-extended for u8/u16/u32, so wrapping matches the declared width.
fn mask_byte(e i64, dst i64) {
	canon(e[N_TYPE], dst)
}

fn canon(t i64, r i64) {
	if t == 0 || t[TY_KIND] != K_INT || t[TY_WIDTH] == 8 || is_fp(r) != 0 {
		return
	}
	if t[TY_SIGNED] != 0 {
		emit3(I_SXT, r, r, width_log2(t[TY_WIDTH]))
	} else {
		emit3(I_ANDI, r, r, 8 * t[TY_WIDTH])
	}
}

fn is_plain_mul(e i64) i64 {
	return i64(e[N_KIND] == EX_BINARY && streq(e[BIN_OP], cstr("*")) != 0 && is_const(e[BIN_L]) == 0 && is_const(e[BIN_R]) == 0)
}

fn gen_binary(e i64, dst i64, d i64) {
	if is_const(e) != 0 {
		load_imm(dst, const_val(e))
		return
	}
	let op = e[BIN_OP]
	if streq(op, cstr("&&")) != 0 || streq(op, cstr("||")) != 0 {
		let f = new_label()
		let end = new_label()
		gen_cond(e, f, d)
		emit3(I_MOVZ, dst, 1, 0)
		emit1(I_B, end)
		label(f)
		emit3(I_MOVZ, dst, 0, 0)
		label(end)
		return
	}
	if cond_code(op) >= 0 {
		gen_compare(e, d)
		emit2(I_CSET, dst, cmp_cc)
		return
	}
	if is_fp(dst) != 0 {
		gen_fbinary(e, dst, d)
		return
	}
	mut l = e[BIN_L]
	mut r = e[BIN_R]
	let comm = i64(streq(op, cstr("+")) != 0 || streq(op, cstr("*")) != 0 || streq(op, cstr("&")) != 0 || streq(op, cstr("|")) != 0 || streq(op, cstr("^")) != 0)
	if comm != 0 && is_const(l) != 0 {
		let t = l
		l = r
		r = t
	}
	arith_unsigned = e_unsigned(e)
	if is_const(r) != 0 {
		let c = const_val(r)
		let lv = gen_val(l, d)
		arith_unsigned = e_unsigned(e)
		if arith_unsigned != 0 && gen_uconst(op, dst, lv, c) != 0 {
			mask_byte(e, dst)
			return
		}
		gen_binary_const(op, dst, lv, c)
		mask_byte(e, dst)
		return
	}
	if streq(op, cstr("+")) != 0 && d + 3 <= t_count {
		if is_plain_mul(r) != 0 {
			gen_madd(dst, l, r, d, I_MADD)
			mask_byte(e, dst)
			return
		}
		if is_plain_mul(l) != 0 && has_effects(l) == 0 && has_effects(r) == 0 {
			gen_madd(dst, r, l, d, I_MADD)
			mask_byte(e, dst)
			return
		}
	}
	gen_pair(l, r, d)
	arith_unsigned = e_unsigned(e)
	emit_arith(op, dst, pl, pr)
	mask_byte(e, dst)
}

// gen_uconst handles unsigned division, modulo and right shift by constants.
fn gen_uconst(op i64, dst i64, l i64, c i64) i64 {
	let k = pow2_log(c)
	if streq(op, cstr("/")) != 0 && k >= 0 {
		emit3(I_LSRI, dst, l, k)
		return 1
	}
	if streq(op, cstr("%")) != 0 && k > 0 {
		emit3(I_ANDI, dst, l, k)
		return 1
	}
	if streq(op, cstr(">>")) != 0 {
		emit3(I_LSRI, dst, l, c & 63)
		return 1
	}
	if streq(op, cstr("/")) != 0 || streq(op, cstr("%")) != 0 {
		load_imm(X17, c)
		emit_arith(op, dst, l, X17)
		return 1
	}
	return 0
}

fn gen_fbinary(e i64, dst i64, d i64) {
	let op = e[BIN_OP]
	let l = e[BIN_L]
	let r = e[BIN_R]
	if d + 3 <= f_count && (streq(op, cstr("+")) != 0 || streq(op, cstr("-")) != 0) {
		if is_fmul(r) != 0 {
			if streq(op, cstr("+")) != 0 {
				gen_madd(dst, l, r, d, I_FMADD)
			} else {
				gen_madd(dst, l, r, d, I_FMSUB)
			}
			return
		}
		if streq(op, cstr("+")) != 0 && is_fmul(l) != 0 && has_effects(l) == 0 && has_effects(r) == 0 {
			gen_madd(dst, r, l, d, I_FMADD)
			return
		}
	}
	gen_pair(l, r, d)
	mut ins = I_FADD
	if streq(op, cstr("-")) != 0 {
		ins = I_FSUB
	} else if streq(op, cstr("*")) != 0 {
		ins = I_FMUL
	} else if streq(op, cstr("/")) != 0 {
		ins = I_FDIV
	}
	emit3(ins, dst, pl, pr)
}

fn is_fmul(e i64) i64 {
	return i64(e[N_KIND] == EX_BINARY && streq(e[BIN_OP], cstr("*")) != 0 && e_fp(e) != 0)
}

fn gen_madd(dst i64, addend i64, m i64, d i64, ins i64) {
	let a = gen_val(addend, d)
	gen_pair(m[BIN_L], m[BIN_R], next_depth(a, d))
	emit4(ins, dst, pl, pr, a)
}

shared mut arith_unsigned i64
shared mut div_label i64 // the current function's divide-by-zero stub, once used

// div_check panics on a zero divisor in strict code (the hardware would return 0).
fn div_check(b i64) {
	if cur_gen_fn[F_GENERATED] != 0 {
		return
	}
	if div_label == 0 {
		div_label = new_label()
	}
	emit2(I_CBZ, b, div_label)
}

fn emit_arith(op i64, dst i64, a i64, b i64) {
	if streq(op, cstr("/")) != 0 || streq(op, cstr("%")) != 0 {
		div_check(b)
	}
	if arith_unsigned != 0 && streq(op, cstr("/")) != 0 {
		emit3(I_UDIV, dst, a, b)
		return
	}
	if arith_unsigned != 0 && streq(op, cstr("%")) != 0 {
		emit3(I_UDIV, X16, a, b)
		emit4(I_MSUB, dst, X16, b, a)
		return
	}
	if arith_unsigned != 0 && streq(op, cstr(">>")) != 0 {
		emit3(I_LSRV, dst, a, b)
		return
	}
	if streq(op, cstr("+")) != 0 {
		emit4(I_ADD, dst, a, b, 0)
	} else if streq(op, cstr("-")) != 0 {
		emit4(I_SUB, dst, a, b, 0)
	} else if streq(op, cstr("*")) != 0 {
		emit3(I_MUL, dst, a, b)
	} else if streq(op, cstr("/")) != 0 {
		emit3(I_SDIV, dst, a, b)
	} else if streq(op, cstr("%")) != 0 {
		emit3(I_SDIV, X16, a, b)
		emit4(I_MSUB, dst, X16, b, a)
	} else if streq(op, cstr("&")) != 0 {
		emit4(I_AND, dst, a, b, 0)
	} else if streq(op, cstr("|")) != 0 {
		emit4(I_ORR, dst, a, b, 0)
	} else if streq(op, cstr("^")) != 0 {
		emit4(I_EOR, dst, a, b, 0)
	} else if streq(op, cstr("<<")) != 0 {
		emit3(I_LSLV, dst, a, b)
	} else {
		emit3(I_ASRV, dst, a, b)
	}
}

fn add_imm(dst i64, l i64, c i64) {
	if c >= 0 && c < 4096 {
		emit3(I_ADDI, dst, l, c)
	} else if c < 0 && c > -4096 {
		emit3(I_SUBI, dst, l, -c)
	} else {
		load_imm(X17, c)
		emit4(I_ADD, dst, l, X17, 0)
	}
}

// round_bias leaves l + (2^k - 1 if l < 0) in x17, so an arithmetic shift by k
// rounds toward zero the way sdiv does.
fn round_bias(l i64, k i64) {
	if k == 1 {
		emit4(I_ADD, X17, l, l, SH_LSR + 63)
		return
	}
	emit3(I_ASRI, X17, l, 63)
	emit4(I_ADD, X17, l, X17, SH_LSR + 64 - k)
}

fn gen_binary_const(op i64, dst i64, l i64, c i64) {
	if streq(op, cstr("+")) != 0 {
		add_imm(dst, l, c)
	} else if streq(op, cstr("-")) != 0 && c != -9223372036854775807 - 1 {
		add_imm(dst, l, -c)
	} else if streq(op, cstr("*")) != 0 {
		let k = pow2_log(c)
		if c == 0 {
			emit3(I_MOVZ, dst, 0, 0)
		} else if c == 1 {
			mov(dst, l)
		} else if c == -1 {
			emit2(I_NEG, dst, l)
		} else if k >= 0 {
			emit3(I_LSLI, dst, l, k)
		} else if c > 2 && pow2_log(c - 1) >= 0 {
			emit4(I_ADD, dst, l, l, SH_LSL + pow2_log(c - 1))
		} else if c > 2 && pow2_log(c + 1) >= 0 {
			emit3(I_LSLI, X17, l, pow2_log(c + 1))
			emit4(I_SUB, dst, X17, l, 0)
		} else {
			load_imm(X17, c)
			emit3(I_MUL, dst, l, X17)
		}
	} else if streq(op, cstr("/")) != 0 {
		let k = pow2_log(c)
		if c == 1 {
			mov(dst, l)
		} else if c == -1 {
			emit2(I_NEG, dst, l)
		} else if c == 0 && cur_gen_fn[F_GENERATED] == 0 {
			div_check(ZR)
		} else if c == 0 {
			// sdiv by zero yields zero.
			emit3(I_MOVZ, dst, 0, 0)
		} else if k > 0 {
			round_bias(l, k)
			emit3(I_ASRI, dst, X17, k)
		} else {
			load_imm(X17, c)
			emit3(I_SDIV, dst, l, X17)
		}
	} else if streq(op, cstr("%")) != 0 {
		mut m = c
		if m < 0 && m != -9223372036854775807 - 1 {
			m = -m
		}
		let k = pow2_log(m)
		if m == 1 {
			emit3(I_MOVZ, dst, 0, 0)
		} else if c == 0 && cur_gen_fn[F_GENERATED] == 0 {
			div_check(ZR)
		} else if c == 0 {
			// x - (x / 0) * 0 == x
			mov(dst, l)
		} else if k > 0 {
			round_bias(l, k)
			emit3(I_ASRI, X17, X17, k)
			emit4(I_SUB, dst, l, X17, SH_LSL + k)
		} else {
			load_imm(X17, c)
			emit3(I_SDIV, X16, l, X17)
			emit4(I_MSUB, dst, X16, X17, l)
		}
	} else if streq(op, cstr("<<")) != 0 {
		emit3(I_LSLI, dst, l, c & 63)
	} else if streq(op, cstr(">>")) != 0 {
		emit3(I_ASRI, dst, l, c & 63)
	} else if streq(op, cstr("&")) != 0 && low_mask_bits(c) > 0 {
		emit3(I_ANDI, dst, l, low_mask_bits(c))
	} else if (streq(op, cstr("|")) != 0 || streq(op, cstr("^")) != 0) && c == 0 {
		mov(dst, l)
	} else {
		load_imm(X17, c)
		emit_arith(op, dst, l, X17)
	}
}

// gen_compare sets the flags for comparison e and leaves its condition in cmp_cc.
fn gen_compare(e i64, d i64) {
	mut l = e[BIN_L]
	mut r = e[BIN_R]
	if e_fp(l) != 0 || e_fp(r) != 0 {
		gen_pair(l, r, d)
		emit2(I_FCMP, pl, pr)
		cmp_cc = fcond_code(e[BIN_OP])
		return
	}
	mut cc = cond_code(e[BIN_OP])
	if e_unsigned(l) != 0 || e_unsigned(r) != 0 {
		cc = ucond_code(e[BIN_OP])
	}
	if is_const(l) != 0 {
		let t = l
		l = r
		r = t
		cc = swap_cc(cc)
	}
	if is_const(r) != 0 {
		let c = const_val(r)
		let a = gen_val(l, d)
		if c >= 0 && c < 4096 {
			emit2(I_CMPI, a, c)
		} else if c < 0 && c > -4096 {
			emit2(I_CMNI, a, -c)
		} else {
			load_imm(X17, c)
			emit2(I_CMP, a, X17)
		}
	} else {
		gen_pair(l, r, d)
		emit2(I_CMP, pl, pr)
	}
	cmp_cc = cc
}

fn gen_index_load(e i64, dst i64, d i64) {
	let ix = e[IX_I]
	let fpl = is_fp(dst)
	if is_const(ix) != 0 && const_val(ix) >= 0 && const_val(ix) < 4096 {
		let off = const_val(ix) * 8
		let base = gen_val(e[IX_X], d)
		if fpl != 0 {
			emit3(I_LDRD, dst, base, off)
		} else {
			emit3(I_LDR, dst, base, off)
		}
		return
	}
	gen_pair(e[IX_X], ix, d)
	if fpl != 0 {
		emit3(I_LDRDX, dst, pl, pr)
	} else {
		emit3(I_LDRX, dst, pl, pr)
	}
}

fn gen_conv(e i64, dst i64, d i64) {
	let k = e[CV_KIND]
	let x = e[CV_X]
	if k == CV_LEN || k == CV_CAP {
		// Header word 0 (len) or 1 (cap); a nil string, slice or map has length 0.
		let p = gen_val(x, d)
		mov(dst, p)
		let skip = new_label()
		emit2(I_CBZ, dst, skip)
		emit3(I_LDR, dst, dst, 8 * i64((k == CV_CAP)))
		label(skip)
		return
	}
	let v = gen_val(x, d)
	if k == CV_ROUND32 {
		emit2(I_FCVTSD, dst, v)
		emit2(I_FCVTDS, dst, dst)
		return
	}
	if k == CV_F2BITS32 {
		emit2(I_FCVTSD, FPR + 31, v)
		emit2(I_FMOVWS, dst, FPR + 31)
		return
	}
	if k == CV_I2F {
		if is_unsigned_t(x[N_TYPE]) != 0 && x[N_TYPE][TY_WIDTH] == 8 {
			emit2(I_UCVTF, dst, v)
		} else {
			emit2(I_SCVTF, dst, v)
		}
	} else if k == CV_F2I {
		if is_unsigned_t(e[N_TYPE]) != 0 {
			emit2(I_FCVTZU, dst, v)
		} else {
			emit2(I_FCVTZS, dst, v)
		}
		canon(e[N_TYPE], dst)
	} else if k == CV_TOBYTE {
		emit3(I_ANDI, dst, v, 8)
	} else if k == CV_INT {
		// Values are kept canonical, so widening is free; narrowing re-canonicalizes.
		mov(dst, v)
		if type_width(e[N_TYPE]) < type_width(x[N_TYPE]) || is_unsigned_t(e[N_TYPE]) != is_unsigned_t(x[N_TYPE]) {
			canon(e[N_TYPE], dst)
		}
	} else {
		mov(dst, v)
	}
}

// ---- sized memory ----
fn mem_kind(t i64) i64 {
	if is_f32(t) != 0 {
		return 2 | MK_FLOAT
	}
	if is_float_t(t) != 0 {
		return 3 | MK_FLOAT
	}
	let w = type_width(t)
	mut k = width_log2(w)
	if w < 8 && t[TY_KIND] == K_INT && t[TY_SIGNED] != 0 {
		k = k | MK_SIGNED
	}
	return k
}

// gen_mem_addr evaluates an EX_MEM address into mm_base plus mm_index (scaled to the
// access size) or plus the byte offset mm_off. Registers may be x16 (scratch), so the
// caller must use them at once.
fn gen_mem_addr(e i64, d i64) {
	let size = type_width(e[N_TYPE])
	mut base = gen_val(e[MEM_BASE], d)
	mut off = e[MEM_OFF]
	mut ix = e[MEM_INDEX]
	let scale = e[MEM_SCALE]
	// A checked constant index stays in a register for its bounds check.
	if ix != 0 && is_const(ix) != 0 && e[MEM_LEN] == 0 {
		off = off + const_val(ix) * scale
		ix = 0
	}
	if ix != 0 {
		let idx = gen_val(ix, next_depth(base, d))
		if e[MEM_LEN] != 0 {
			bounds_check(idx, e[MEM_LEN], next_depth(idx, next_depth(base, d)))
		}
		if off == 0 && scale == size {
			mm_base = base
			mm_index = idx
			mm_off = 0
			return
		}
		emit4(I_ADD, X16, base, idx, SH_LSL + width_log2(scale))
		base = X16
	}
	if off >= 0 && off % size == 0 && off / size < 4096 {
		mm_base = base
		mm_index = -1
		mm_off = off
		return
	}
	add_imm(X16, base, off)
	mm_base = X16
	mm_index = -1
	mm_off = 0
}

fn emit_load(dst i64, t i64) {
	let kind = mem_kind(t)
	if mm_index >= 0 {
		emit4(I_LDX, dst, mm_base, mm_index, kind | MK_SCALED)
	} else {
		emit4(I_LD, dst, mm_base, mm_off, kind)
	}
	if is_f32(t) != 0 && is_fp(dst) != 0 {
		// An f32 lives in registers as the f64 with the same value.
		emit2(I_FCVTDS, dst, dst)
	}
}

fn emit_store(v_in i64, t i64) {
	mut v = v_in
	let kind = mem_kind(t)
	if is_f32(t) != 0 && is_fp(v) != 0 {
		emit2(I_FCVTSD, FPR + 31, v)
		v = FPR + 31
	}
	if mm_index >= 0 {
		emit4(I_STX, v, mm_base, mm_index, kind | MK_SCALED)
	} else {
		emit4(I_ST, v, mm_base, mm_off, kind)
	}
}

fn gen_mem_load(e i64, dst i64, d i64) {
	gen_mem_addr(e, d)
	emit_load(dst, e[N_TYPE])
}

// bounds_check traps unless idx is below the length expression (an unsigned compare
// also catches negative indexes).
fn bounds_check(idx i64, lenexpr i64, d i64) {
	mut lr = 0
	if lenexpr[N_KIND] == EX_IDENT && lenexpr[ID_REF][S_KIND] == SYM_LOCAL && lenexpr[ID_REF][S_REG] >= 0 {
		lr = lenexpr[ID_REF][S_REG]
	} else {
		gen_to(lenexpr, X17, d)
		lr = X17
	}
	emit2(I_CMP, idx, lr)
	emit2(I_BCOND, C_HS, trap_at(idx, lr, 0))
}

fn get_trap() i64 {
	if trap_label == 0 {
		trap_label = new_label()
	}
	return trap_label
}

// trap_at is a cold stub for one bounds check that reports its index and length.
fn trap_at(idx i64, len_ i64, cidx i64) i64 {
	let l = new_label()
	let site = vec_new()
	vec_push(site, l)
	vec_push(site, idx)
	vec_push(site, len_)
	vec_push(site, cidx)
	vec_push(trap_sites, site)
	return l
}

// gen_elem_addr evaluates a slice or string element address (with its bounds check)
// into mm_base/mm_index/mm_off.
fn gen_elem_addr(e i64, d i64) {
	let h = gen_val(e[ELEM_SEQ], d)
	let d1 = next_depth(h, d)
	let size = e[ELEM_SIZE]
	let ix = e[ELEM_IDX]
	mut first = 16
	if e[ELEM_STR] != 0 {
		first = 8
	}
	if is_const(ix) != 0 {
		let c = const_val(ix)
		if e[ELEM_SAFE] == 0 {
			emit4(I_LD, X17, h, 0, 3)
			if c >= 0 && c < 4096 {
				emit2(I_CMPI, X17, c)
			} else {
				load_imm(X16, c)
				emit2(I_CMP, X17, X16)
			}
			emit2(I_BCOND, C_LS, trap_at(-1, X17, c))
		}
		if e[ELEM_STR] != 0 {
			mm_base = h
			mm_off = first + c * size
		} else {
			emit4(I_LD, X16, h, 16, 3)
			mm_base = X16
			mm_off = c * size
		}
		mm_index = -1
		if mm_off < 0 || mm_off / size >= 4096 {
			add_imm(X16, mm_base, mm_off)
			mm_base = X16
			mm_off = 0
		}
		return
	}
	let idx = gen_val(ix, d1)
	if e[ELEM_SAFE] == 0 {
		emit4(I_LD, X17, h, 0, 3)
		emit2(I_CMP, idx, X17)
		emit2(I_BCOND, C_HS, trap_at(idx, X17, 0))
	}
	if e[ELEM_STR] != 0 {
		emit3(I_ADDI, X16, h, 8)
	} else {
		emit4(I_LD, X16, h, 16, 3)
	}
	mm_base = X16
	mm_index = idx
	mm_off = 0
}

fn gen_elem_load(e i64, dst i64, d i64) {
	gen_elem_addr(e, d)
	emit_load(dst, e[N_TYPE])
}

// gen_seq runs a checker-made statement list, then computes its value. The statements
// use temps from depth 0, so live temps below d are saved around them.
fn gen_seq(e i64, dst i64, d i64) {
	mut i = 0
	for i < d {
		if i < t_count {
			emit1(I_PUSH, vec_get(t_regs, i))
		}
		if i < f_count {
			emit1(I_FPUSH, vec_get(f_regs, i))
		}
		i = i + 1
	}
	gen_stmts(e[SEQ_STMTS])
	i = d - 1
	for i >= 0 {
		if i < f_count {
			emit1(I_FPOP, vec_get(f_regs, i))
		}
		if i < t_count {
			emit1(I_POP, vec_get(t_regs, i))
		}
		i = i - 1
	}
	let v = e[SEQ_VALUE]
	if dst >= 0 && kind_of(e[N_TYPE]) != K_VOID {
		gen_to(v, dst, d)
	} else {
		gen_effect(v)
	}
}

// gen_addr8 picks a byte address mode for p: am_base plus am_index, or plus am_off.
fn gen_addr8(p i64, d i64) {
	if p[N_KIND] == EX_BINARY && streq(p[BIN_OP], cstr("+")) != 0 {
		let r = p[BIN_R]
		if is_const(r) != 0 && const_val(r) >= 0 && const_val(r) < 4096 {
			let c = const_val(r)
			am_base = gen_val(p[BIN_L], d)
			am_index = -1
			am_off = c
			return
		}
		gen_pair(p[BIN_L], r, d)
		am_base = pl
		am_index = pr
		return
	}
	am_base = gen_val(p, d)
	am_index = -1
	am_off = 0
}

fn float_intrinsic_op(name i64) i64 {
	if i64(load8(name)) != '_' || i64(load8(name + 1)) != '_' || i64(load8(name + 2)) != 'f' {
		return 0
	}
	if streq(name, cstr("__fsqrt")) != 0 {
		return I_FSQRT
	}
	if streq(name, cstr("__fabs")) != 0 {
		return I_FABS
	}
	if streq(name, cstr("__frintm")) != 0 {
		return I_FRINTM
	}
	if streq(name, cstr("__frintp")) != 0 {
		return I_FRINTP
	}
	if streq(name, cstr("__frintz")) != 0 {
		return I_FRINTZ
	}
	if streq(name, cstr("__frinta")) != 0 {
		return I_FRINTA
	}
	if streq(name, cstr("__frintn")) != 0 {
		return I_FRINTN
	}
	return 0
}

fn gen_intrinsic(e i64, dst i64, d i64) {
	let name = e[CALL_NAME]
	if streq(name, cstr("__prefetchw")) != 0 {
		gen_pair(vec_get(e[CALL_ARGS], 0), vec_get(e[CALL_ARGS], 1), d)
		emit3(I_PRFM, 16, pl, pr)
		return
	}
	if streq(name, cstr("load8")) != 0 {
		gen_addr8(vec_get(e[CALL_ARGS], 0), d)
		if am_index < 0 {
			emit3(I_LDRB, dst, am_base, am_off)
		} else {
			emit3(I_LDRBX, dst, am_base, am_index)
		}
		return
	}
	if gen_runtime_intrinsic(e, dst, d) != 0 {
		return
	}
	gen_store8(e, dst, d)
}

// Runtime intrinsics: the thread context register and atomics for lib/runtime.tin.
fn gen_runtime_intrinsic(e i64, dst i64, d i64) i64 {
	let name = e[CALL_NAME]
	let args = e[CALL_ARGS]
	if streq(name, cstr("__ctx")) != 0 {
		mov(dst, 28)
		return 1
	}
	if streq(name, cstr("__fp")) != 0 {
		mov(dst, FP)
		return 1
	}
	let fop = float_intrinsic_op(name)
	if fop != 0 {
		let fx = gen_val(vec_get(args, 0), d)
		emit2(fop, dst, fx)
		return 1
	}
	if streq(name, cstr("__st")) != 0 {
		// __st(p, v, sizelog2): a raw sized store for the runtime.
		gen_pair(vec_get(args, 0), vec_get(args, 1), d)
		emit4(I_ST, pr, pl, 0, const_val(vec_get(args, 2)))
		return 1
	}
	if streq(name, cstr("__ld")) != 0 {
		let p = gen_val(vec_get(args, 0), d)
		let k = vec_get(args, 1)
		if is_const(k) != 0 {
			emit4(I_LD, dst, p, 0, const_val(k))
		} else {
			emit4(I_LD, dst, p, 0, 3)
		}
		return 1
	}
	if streq(name, cstr("__tin_symbols")) != 0 || streq(name, cstr("__image_base")) != 0 {
		mut kind = SK_BTRACE
		if streq(name, cstr("__image_base")) != 0 {
			kind = SK_IMAGE
		}
		let symbol = sym_ref(kind, 0)
		emit2(I_ADRP, dst, symbol)
		emit3(I_ADDLO, dst, dst, symbol)
		return 1
	}
	if streq(name, cstr("__empty")) != 0 {
		let z = sym_ref(SK_ZERO, 0)
		emit2(I_ADRP, dst, z)
		emit3(I_ADDLO, dst, dst, z)
		return 1
	}
	if streq(name, cstr("__set_ctx")) != 0 {
		gen_to(vec_get(args, 0), 28, d)
		return 1
	}
	if streq(name, cstr("__atomic_add")) != 0 {
		// Returns the old value: ldaddal adds v to [p] atomically.
		gen_pair(vec_get(args, 0), vec_get(args, 1), d)
		emit3(I_LDADDAL, pr, X17, pl)
		if dst >= 0 {
			mov(dst, X17)
		}
		return 1
	}
	if streq(name, cstr("__atomic_cas")) != 0 {
		// __atomic_cas(p, old, new) returns the value found at p.
		let p = gen_val(vec_get(args, 0), d)
		let d1 = next_depth(p, d)
		let o = gen_val(vec_get(args, 1), d1)
		let d2 = next_depth(o, d1)
		let n = gen_val(vec_get(args, 2), d2)
		mov(X17, o)
		emit3(I_CASAL, X17, n, p)
		if dst >= 0 {
			mov(dst, X17)
		}
		return 1
	}
	if streq(name, cstr("__atomic_swap")) != 0 {
		gen_pair(vec_get(args, 0), vec_get(args, 1), d)
		emit3(I_SWPAL, pr, X17, pl)
		if dst >= 0 {
			mov(dst, X17)
		}
		return 1
	}
	if streq(name, cstr("__atomic_load")) != 0 {
		let p = gen_val(vec_get(args, 0), d)
		emit2(I_LDAR, dst, p)
		return 1
	}
	if streq(name, cstr("__atomic_store")) != 0 {
		gen_pair(vec_get(args, 0), vec_get(args, 1), d)
		emit2(I_STLR, pr, pl)
		return 1
	}
	if streq(name, cstr("__yield")) != 0 {
		emit1(I_YIELD, 0)
		return 1
	}
	return 0
}

// gen_store8 stores a byte and, when dst >= 0, also yields the stored value.
fn gen_store8(e i64, dst i64, d i64) {
	let p = vec_get(e[CALL_ARGS], 0)
	let v = vec_get(e[CALL_ARGS], 1)
	mut base = 0
	mut index = -1
	mut off = 0
	mut dv = d
	if p[N_KIND] == EX_BINARY && streq(p[BIN_OP], cstr("+")) != 0 && is_const(p[BIN_R]) != 0 && const_val(p[BIN_R]) >= 0 && const_val(p[BIN_R]) < 4096 {
		off = const_val(p[BIN_R])
		base = gen_val(p[BIN_L], d)
		dv = next_depth(base, d)
	} else if p[N_KIND] == EX_BINARY && streq(p[BIN_OP], cstr("+")) != 0 && d + 3 <= t_count {
		base = gen_val(p[BIN_L], d)
		index = gen_val(p[BIN_R], next_depth(base, d))
		dv = next_depth(index, next_depth(base, d))
	} else {
		base = gen_val(p, d)
		dv = next_depth(base, d)
	}
	mut val = 0
	if dv >= t_count {
		// Too deep for another temp: keep the address on the stack meanwhile.
		emit1(I_PUSH, base)
		mov(X17, gen_val(v, d))
		emit1(I_POP, base)
		val = X17
	} else if is_const(v) != 0 && const_val(v) == 0 {
		val = ZR
	} else {
		val = gen_val(v, dv)
	}
	if index >= 0 {
		emit3(I_STRBX, val, base, index)
	} else {
		emit3(I_STRB, val, base, off)
	}
	if dst >= 0 {
		mov(dst, val)
	}
}

// param_types are the parameter types a call passes, from its callee or func type.
fn call_ptypes(e i64) i64 {
	if e[CALL_FN] != 0 {
		return e[CALL_FN][F_PTYPES]
	}
	return e[CALL_CALLEE][N_TYPE][TY_FIELDS]
}

// arg_regs gives each argument its register: x0-x7 and d0-d7 counted separately,
// or -1 for a variadic argument that goes on the stack.
fn arg_regs(e i64) i64 {
	let ptypes = call_ptypes(e)
	let n = e[CALL_ARGS][VEC_LEN]
	let regs = vec_new()
	mut ni = 0
	mut nf = 0
	mut i = 0
	for i < n {
		if i >= ptypes[VEC_LEN] && tgt_linux == 0 {
			// Apple's arm64 ABI passes variadic arguments on the stack.
			vec_push(regs, -1)
		} else if i < ptypes[VEC_LEN] && is_dyn_value(vec_get(ptypes, i)) != 0 {
			if ni + 1 < 8 {
				vec_push(regs, ni)
				ni = ni + 2
			} else {
				vec_push(regs, -1)
				ni = 8
			}
		} else if i >= ptypes[VEC_LEN] && e_fp(vec_get(e[CALL_ARGS], i)) != 0 {
			// AAPCS64 (Linux) passes them in registers like any other argument.
			vec_push(regs, FPR + nf)
			nf = nf + 1
		} else if i >= ptypes[VEC_LEN] {
			vec_push(regs, ni)
			ni = ni + 1
		} else if is_float_t(vec_get(ptypes, i)) != 0 {
			vec_push(regs, FPR + nf)
			nf = nf + 1
		} else {
			vec_push(regs, ni)
			ni = ni + 1
		}
		i = i + 1
	}
	return regs
}

fn push_reg(r i64) {
	if is_fp(r) != 0 {
		emit1(I_FPUSH, r)
	} else {
		emit1(I_PUSH, r)
	}
}

fn pop_reg(r i64) {
	if is_fp(r) != 0 {
		emit1(I_FPOP, r)
	} else {
		emit1(I_POP, r)
	}
}

fn caller_saved(r i64) i64 {
	if is_fp(r) != 0 {
		return i64(r < FPR + 8 || r >= FPR + 16)
	}
	return i64(r < 19)
}

// gen_call leaves the result in x0 (or d0 for a float).
fn gen_call(e i64, d i64) {
	if e[N_KIND] == EX_SEQ {
		gen_seq(e, -1, d)
		return
	}
	let args = e[CALL_ARGS]
	let n = args[VEC_LEN]
	let areg = arg_regs(e)
	let f = e[CALL_FN]
	let callee = e[CALL_CALLEE]
	let variadic = i64(f != 0 && f[F_VARIADIC] != 0 && tgt_linux == 0)
	let stackoffs = vec_filled(n, -1)
	mut stack_words = 0
	mut has_stack = 0
	mut i = 0
	for i < n {
		let a = vec_get(args, i)
		if vec_get(areg, i) < 0 && variadic == 0 {
			has_stack = 1
			if is_dyn_value(a[N_TYPE]) != 0 {
				stack_words = align_up(stack_words, 2)
				stackoffs[VEC_DATA][i] = 8 * stack_words
				stack_words = stack_words + 2
			} else {
				stackoffs[VEC_DATA][i] = 8 * stack_words
				stack_words = stack_words + 1
			}
		}
		i = i + 1
	}
	let stack_area = align_up(8 * stack_words, 16)
	mut callee_reg = -1
	mut d0 = d
	if callee != 0 && contains_call(callee) != 0 {
		callee_reg = gen_val(callee, d)
		d0 = next_depth(callee_reg, d)
	}
	mut nested = variadic
	i = 0
	for i < n {
		if contains_call(vec_get(args, i)) != 0 || (has_stack != 0 && vec_get(areg, i) < 0) {
			nested = 1
		}
		i = i + 1
	}
	let regs = vec_filled(n, -1)
	let regs2 = vec_filled(n, -1)
	mut area = 0
	mut temps_saved = 0
	mut stack_stored = 0
	if nested == 0 {
		// Temps never use x0-x7/d0-d7 in a function that calls, so args go straight there.
		i = 0
		for i < n {
			let a = vec_get(args, i)
			let ar = vec_get(areg, i)
			if is_dyn_value(a[N_TYPE]) != 0 {
				if ar < 0 {
					err_code_at(a[N_POS], cstr("E990 INTERNAL"), cstr("a dyn argument needs two argument registers or the stack"))
				} else {
					gen_dyn_pair(a, ar, ar + 1, d0)
				}
			} else {
				gen_to(a, ar, d0)
			}
			i = i + 1
		}
	} else {
		mut words = n
		i = 0
		for i < n {
			if is_dyn_value(vec_get(args, i)[N_TYPE]) != 0 {
				words = words + 1
			}
			i = i + 1
		}
		mut has_fp = 0
		i = 0
		for i < n {
			if e_fp(vec_get(args, i)) != 0 {
				has_fp = 1
			}
			i = i + 1
		}
		if d0 + words <= t_count && (has_fp == 0 || d0 + words <= f_count) {
			// Arguments that call, load or may panic run first, in order; the rest are
			// effect-free and go straight into their registers afterwards.
			mut last = -1
			i = 0
			for i < n {
				if speculable(vec_get(args, i)) == 0 || vec_get(areg, i) < 0 || is_dyn_value(vec_get(args, i)[N_TYPE]) != 0 {
					last = i
				}
				i = i + 1
			}
			// dd counts the temps actually holding earlier arguments, so nested calls only
			// save what is live.
			mut dd = d0
			i = 0
			for i < n {
				let a = vec_get(args, i)
				if i == last && is_real_call(a) != 0 && vec_get(areg, i) >= 0 && variadic == 0 && is_dyn_value(a[N_TYPE]) == 0 {
					// Nothing runs between this call and ours, so the result moves right in.
					gen_call(a, dd)
					if e_fp(a) != 0 {
						mov(vec_get(areg, i), FPR)
					} else {
						mov(vec_get(areg, i), 0)
					}
					regs[VEC_DATA][i] = vec_get(areg, i)
				} else if is_dyn_value(a[N_TYPE]) != 0 {
					let r0 = treg(dd)
					let r1 = treg(dd + 1)
					gen_dyn_pair(a, r0, r1, dd)
					regs[VEC_DATA][i] = r0
					regs2[VEC_DATA][i] = r1
					dd = dd + 2
				} else if speculable(a) == 0 || vec_get(areg, i) < 0 {
					mut r = gen_val(a, dd)
					regs[VEC_DATA][i] = r
					dd = next_depth(r, dd)
				}
				i = i + 1
			}
		} else {
			if has_stack != 0 {
				save_temps(d)
				temps_saved = 1
				emit3(I_SUBI, SP, SP, stack_area)
				area = stack_area
			}
			i = 0
			for i < n {
				let a = vec_get(args, i)
				if is_dyn_value(a[N_TYPE]) != 0 {
					let r0 = treg(d0)
					let r1 = treg(d0 + 1)
					gen_dyn_pair(a, r0, r1, d0)
					push_reg(r0)
					push_reg(r1)
				} else {
					push_reg(gen_val(a, d0))
				}
				i = i + 1
			}
			i = n - 1
			for i >= 0 {
				mut r = vec_get(areg, i)
				if is_dyn_value(vec_get(args, i)[N_TYPE]) != 0 {
					if r < 0 {
						r = X16
						let r2 = X17
						pop_reg(r2)
						pop_reg(r)
						if has_stack != 0 {
							mut prior = 0
							mut pi = 0
							for pi < i {
								if is_dyn_value(vec_get(args, pi)[N_TYPE]) != 0 {
									prior = prior + 2
								} else {
									prior = prior + 1
								}
								pi = pi + 1
							}
							emit3(I_STR, r, SP, 16 * prior + vec_get(stackoffs, i))
							emit3(I_STR, r2, SP, 16 * prior + vec_get(stackoffs, i) + 8)
							stack_stored = 1
						}
						regs[VEC_DATA][i] = -2
						regs2[VEC_DATA][i] = -1
					} else {
						pop_reg(r + 1)
						pop_reg(r)
						regs[VEC_DATA][i] = r
						regs2[VEC_DATA][i] = r + 1
					}
				} else {
					if r < 0 {
						r = X16
						if e_fp(vec_get(args, i)) != 0 {
							r = FSCR
						}
					}
					pop_reg(r)
					if vec_get(areg, i) < 0 && has_stack != 0 {
						mut prior = 0
						mut pi = 0
						for pi < i {
							if is_dyn_value(vec_get(args, pi)[N_TYPE]) != 0 {
								prior = prior + 2
							} else {
								prior = prior + 1
							}
							pi = pi + 1
						}
						if e_fp(vec_get(args, i)) != 0 {
							emit3(I_STRD, r, SP, 16 * prior + vec_get(stackoffs, i))
						} else {
							emit3(I_STR, r, SP, 16 * prior + vec_get(stackoffs, i))
						}
						regs[VEC_DATA][i] = -2
						stack_stored = 1
					} else {
						regs[VEC_DATA][i] = r
					}
				}
				i = i - 1
			}
		}
	}
	// A variadic call stores its stack arguments while their temps are intact, and
	// saves live temps first so the pushes land above the argument area.
	if variadic != 0 {
		save_temps(d)
		temps_saved = 1
		area = store_varargs(f, regs, n)
	}
	if nested != 0 {
		i = 0
		for i < n {
			mut r = vec_get(regs, i)
			if r >= 0 && vec_get(areg, i) >= 0 {
				mov(vec_get(areg, i), r)
				if is_dyn_value(vec_get(args, i)[N_TYPE]) != 0 {
					mov(vec_get(areg, i) + 1, vec_get(regs2, i))
				}
			}
			i = i + 1
		}
		i = 0
		for i < n {
			if vec_get(regs, i) == -1 {
				// The temps above d are free again once moved into argument registers.
				if is_dyn_value(vec_get(args, i)[N_TYPE]) != 0 {
					mut r = vec_get(areg, i)
					if r < 0 {
						err_code_at(vec_get(args, i)[N_POS], cstr("E990 INTERNAL"), cstr("a dyn argument needs two argument registers or the stack"))
					} else {
						gen_dyn_pair(vec_get(args, i), r, r + 1, d0)
					}
				} else {
					gen_to(vec_get(args, i), vec_get(areg, i), d0)
				}
			}
			i = i + 1
		}
	}
	// With the args in place, a callee's parameter-only base case can be answered
	// without the call (fib's leaves), which Go never inlines for recursive functions.
	mut pat = 0
	if f != 0 && variadic == 0 {
		pat = exit_pattern(f)
	}
	mut done_l = 0
	if pat != 0 && has_stack == 0 && d0 + n + 2 <= t_count && d0 + n + 2 <= f_count {
		let homes = param_homes(f)
		with_params_in_args(f, 0)
		let call_l = new_label()
		done_l = new_label()
		gen_cond(pat[IF_COND], call_l, d0 + n)
		mut r = vec_get(pat[IF_THEN][BLK_STMTS], 0)
		if r[RET_VALUE] != 0 {
			if is_float_t(vec_get(f[F_RTYPES], 0)) != 0 {
				gen_to(r[RET_VALUE], FPR, d0 + n)
			} else {
				gen_to(r[RET_VALUE], 0, d0 + n)
			}
		} else {
			emit3(I_MOVZ, 0, 0, 0)
		}
		emit1(I_B, done_l)
		label(call_l)
		with_params_in_args(f, homes)
	}
	if variadic == 0 && temps_saved == 0 {
		save_temps(d)
		temps_saved = 1
	}
	if has_stack != 0 && stack_stored == 0 {
		if stack_area > 0 {
			emit3(I_SUBI, SP, SP, stack_area)
			area = stack_area
		}
		i = 0
		for i < n {
			if vec_get(areg, i) < 0 {
				mut r = vec_get(regs, i)
				if r < 0 {
					err_code_at(vec_get(args, i)[N_POS], cstr("E990 INTERNAL"), cstr("unable to stage a stack argument"))
				} else if is_dyn_value(vec_get(args, i)[N_TYPE]) != 0 {
					emit3(I_STR, r, SP, vec_get(stackoffs, i))
					emit3(I_STR, vec_get(regs2, i), SP, vec_get(stackoffs, i) + 8)
				} else if is_fp(vec_get(args, i)) != 0 {
					emit3(I_STRD, r, SP, vec_get(stackoffs, i))
				} else {
					emit3(I_STR, r, SP, vec_get(stackoffs, i))
				}
			}
			i = i + 1
		}
	}
	if f != 0 {
		emit1(I_BL, f)
		f[F_USED] = 1
	} else if callee_reg >= 0 {
		mov(X17, callee_reg)
		emit3(I_LDR, X16, X17, 0)
		emit1(I_BLR, X16)
	} else {
		gen_to(callee, X17, d0)
		emit3(I_LDR, X16, X17, 0)
		emit1(I_BLR, X16)
	}
	if area > 0 {
		emit3(I_ADDI, SP, SP, area)
	}
	if done_l != 0 {
		// Branch past the restores: the inline answer didn't spill anything.
		let after = new_label()
		restore_temps(d)
		emit1(I_B, after)
		label(done_l)
		label(after)
		return
	}
	restore_temps(d)
}

// save_temps pushes the live caller-saved temps below depth d before a call.
fn save_temps(d i64) {
	mut i = 0
	for i < d {
		if i < t_count && caller_saved(vec_get(t_regs, i)) != 0 {
			emit1(I_PUSH, vec_get(t_regs, i))
		}
		if i < f_count && caller_saved(vec_get(f_regs, i)) != 0 {
			emit1(I_FPUSH, vec_get(f_regs, i))
		}
		i = i + 1
	}
}

// store_varargs places a variadic call's extra arguments in 8-byte stack slots
// (Apple's ABI) and returns the bytes reserved.
fn store_varargs(f i64, regs i64, n i64) i64 {
	let first = f[F_PTYPES][VEC_LEN]
	let area = align_up(8 * (n - first), 16)
	if area > 0 {
		emit3(I_SUBI, SP, SP, area)
	}
	mut i = first
	for i < n {
		let r = vec_get(regs, i)
		let off = 8 * (i - first)
		if is_fp(r) != 0 {
			emit3(I_STRD, r, SP, off)
		} else {
			emit3(I_STR, r, SP, off)
		}
		i = i + 1
	}
	return area
}

fn restore_temps(d i64) {
	mut i = d - 1
	for i >= 0 {
		if i < f_count && caller_saved(vec_get(f_regs, i)) != 0 {
			emit1(I_FPOP, vec_get(f_regs, i))
		}
		if i < t_count && caller_saved(vec_get(t_regs, i)) != 0 {
			emit1(I_POP, vec_get(t_regs, i))
		}
		i = i - 1
	}
}

// ---- conditions ----
// low_bits_test returns k when e is (x % 2^k) or (x & (2^k - 1)), which is zero
// exactly when the low k bits of x are clear.
fn low_bits_test(e i64) i64 {
	if e[N_KIND] != EX_BINARY || is_const(e[BIN_R]) == 0 || has_effects(e[BIN_L]) != 0 || e_fp(e) != 0 {
		return 0
	}
	mut c = const_val(e[BIN_R])
	if streq(e[BIN_OP], cstr("%")) != 0 {
		if c < 0 && c != -9223372036854775807 - 1 {
			c = -c
		}
		let k = pow2_log(c)
		if k > 0 {
			return k
		}
		return 0
	}
	if streq(e[BIN_OP], cstr("&")) != 0 {
		return low_mask_bits(c)
	}
	return 0
}

// gen_cmp_branch branches to target when comparison e evaluates to when_true.
fn gen_cmp_branch(e i64, target i64, d i64, when_true i64) {
	if e_fp(e[BIN_L]) != 0 || e_fp(e[BIN_R]) != 0 {
		gen_compare(e, d)
		if when_true != 0 {
			emit2(I_BCOND, cmp_cc, target)
		} else {
			emit2(I_BCOND, cmp_cc ^ 1, target)
		}
		return
	}
	mut cc = cond_code(e[BIN_OP])
	mut l = e[BIN_L]
	mut r = e[BIN_R]
	let unsigned = i64(e_unsigned(l) != 0 || e_unsigned(r) != 0)
	if unsigned != 0 {
		cc = ucond_code(e[BIN_OP])
	}
	if is_const(l) != 0 {
		let t = l
		l = r
		r = t
		cc = swap_cc(cc)
	}
	if is_const(r) != 0 && const_val(r) == 0 && !(unsigned != 0 && cc != C_EQ && cc != C_NE) {
		if cc == C_EQ || cc == C_NE {
			let on_zero = i64(i64((cc == C_EQ)) == when_true)
			let k = low_bits_test(l)
			if k == 1 {
				let x = gen_val(l[BIN_L], d)
				if on_zero != 0 {
					emit3(I_TBZ, x, 0, target)
				} else {
					emit3(I_TBNZ, x, 0, target)
				}
				return
			}
			if k > 1 {
				emit2(I_TSTI, gen_val(l[BIN_L], d), k)
				if on_zero != 0 {
					emit2(I_BCOND, C_EQ, target)
				} else {
					emit2(I_BCOND, C_NE, target)
				}
				return
			}
			let z = gen_val(l, d)
			if on_zero != 0 {
				emit2(I_CBZ, z, target)
			} else {
				emit2(I_CBNZ, z, target)
			}
			return
		}
		if cc == C_LT || cc == C_GE {
			let on_neg = i64(i64((cc == C_LT)) == when_true)
			let s = gen_val(l, d)
			if on_neg != 0 {
				emit3(I_TBNZ, s, 63, target)
			} else {
				emit3(I_TBZ, s, 63, target)
			}
			return
		}
	}
	gen_compare(e, d)
	if when_true != 0 {
		emit2(I_BCOND, cmp_cc, target)
	} else {
		emit2(I_BCOND, cmp_cc ^ 1, target)
	}
}

// gen_cond branches to f when e is false and falls through when it is true.
fn gen_cond(e i64, f i64, d i64) {
	gen_branch(e, f, d, 0)
}

// gen_branch branches to target when e's truth equals when_true.
fn gen_branch(e i64, target i64, d i64, when_true i64) {
	if is_const(e) != 0 {
		if i64((const_val(e) != 0)) == when_true {
			emit1(I_B, target)
		}
		return
	}
	let k = e[N_KIND]
	if k == EX_SEQ {
		gen_stmts(e[SEQ_STMTS])
		gen_branch(e[SEQ_VALUE], target, d, when_true)
		return
	}
	if k == EX_UNARY && streq(e[UN_OP], cstr("!")) != 0 {
		gen_branch(e[UN_X], target, d, i64(when_true == 0))
		return
	}
	if k == EX_BINARY {
		let op = e[BIN_OP]
		let is_and = streq(op, cstr("&&"))
		if is_and != 0 || streq(op, cstr("||")) != 0 {
			// Branching on the operator's own sense chains; the other sense skips ahead.
			if is_and != when_true {
				gen_branch(e[BIN_L], target, d, when_true)
				gen_branch(e[BIN_R], target, d, when_true)
			} else {
				let skip = new_label()
				gen_branch(e[BIN_L], skip, d, i64(when_true == 0))
				gen_branch(e[BIN_R], target, d, when_true)
				label(skip)
			}
			return
		}
		if cond_code(op) >= 0 {
			gen_cmp_branch(e, target, d, when_true)
			return
		}
		if streq(op, cstr("&")) != 0 && is_const(e[BIN_R]) != 0 && pow2_log(const_val(e[BIN_R])) >= 0 {
			let bit = pow2_log(const_val(e[BIN_R]))
			let x = gen_val(e[BIN_L], d)
			if when_true != 0 {
				emit3(I_TBNZ, x, bit, target)
			} else {
				emit3(I_TBZ, x, bit, target)
			}
			return
		}
	}
	let v = gen_val(e, d)
	if is_fp(v) != 0 {
		emit2(I_FCMPZ, v, 0)
		if when_true != 0 {
			emit2(I_BCOND, C_NE, target)
		} else {
			emit2(I_BCOND, C_EQ, target)
		}
		return
	}
	if when_true != 0 {
		emit2(I_CBNZ, v, target)
	} else {
		emit2(I_CBZ, v, target)
	}
}

// ---- statements ----
fn gen_effect(e i64) {
	if has_effects(e) == 0 {
		return
	}
	if is_real_call(e) != 0 {
		gen_call(e, 0)
	} else if e[N_KIND] == EX_SEQ {
		gen_seq(e, -1, 0)
	} else if e[N_KIND] == EX_CALL && (streq(e[CALL_NAME], cstr("__prefetchw")) != 0 || streq(e[CALL_NAME], cstr("store8")) != 0) {
		gen_intrinsic(e, -1, 0)
	} else if e[N_KIND] == EX_CALL && e[CALL_INTRINSIC] != 0 {
		mut r = 0
		if e_fp(e) != 0 {
			r = freg(0)
		} else {
			r = treg(0)
		}
		gen_intrinsic(e, r, 0)
	} else {
		gen_val(e, 0)
	}
}

fn assign_local(s i64, v i64) {
	if is_dyn_value(s[S_TYPE]) != 0 {
		let r0 = treg(0)
		let r1 = treg(1)
		gen_dyn_pair(v, r0, r1, 0)
		if s[S_REG] == REG_SLOT {
			emit3(I_STR, r0, FP, s[S_OFF])
			emit3(I_STR, r1, FP, s[S_OFF] + 8)
		} else {
			err_code_at(s[S_POS], cstr("E990 INTERNAL"), cstr("dyn local is not in a two-word frame slot"))
		}
		return
	}
	if s[S_REG] >= 0 {
		gen_to(v, s[S_REG], 0)
	} else if s[S_REG] == REG_SLOT {
		let r = gen_val(v, 0)
		if is_fp(r) != 0 {
			emit3(I_STRD, r, FP, s[S_OFF])
		} else {
			emit3(I_STR, r, FP, s[S_OFF])
		}
	} else {
		gen_effect(v)
	}
}

fn node_copy(n i64) i64 {
	let c = malloc(8 * N_SIZE)
	mut i = 0
	for i < N_SIZE {
		c[i] = n[i]
		i = i + 1
	}
	return c
}

fn node_restore(n i64, c i64) {
	mut i = 0
	for i < N_SIZE {
		n[i] = c[i]
		i = i + 1
	}
}

// gen_store_mem stores v through an EX_MEM or EX_ELEM target. The address parts are
// computed into stable temps first; a[i] = a[i] op x loads the element only once.
fn gen_store_mem(t i64, v i64) {
	if is_dyn_value(t[N_TYPE]) != 0 {
		gen_dyn_mem_address(t, 0)
		emit1(I_PUSH, X16)
		let r0 = treg(0)
		let r1 = treg(1)
		gen_dyn_pair(v, r0, r1, 0)
		emit1(I_POP, X16)
		emit3(I_STR, r0, X16, 0)
		emit3(I_STR, r1, X16, 8)
		return
	}
	let fpv = e_fp(t)
	mut base = 0
	mut idx = -1
	mut off = 0
	mut d = 0
	let size = type_width(t[N_TYPE])
	if t[N_KIND] == EX_ELEM {
		let h = gen_val(t[ELEM_SEQ], 0)
		d = next_depth(h, 0)
		let ix = t[ELEM_IDX]
		if is_const(ix) != 0 && t[ELEM_SAFE] == 0 {
			idx = treg(d)
			load_imm(idx, const_val(ix))
			d = d + 1
		} else if is_const(ix) == 0 {
			idx = gen_val(ix, d)
			d = next_depth(idx, d)
		}
		if t[ELEM_SAFE] == 0 {
			emit4(I_LD, X17, h, 0, 3)
			emit2(I_CMP, idx, X17)
			emit2(I_BCOND, C_HS, trap_at(idx, X17, 0))
		}
		base = treg(d)
		d = d + 1
		if t[ELEM_STR] != 0 {
			emit3(I_ADDI, base, h, 8)
		} else {
			emit4(I_LD, base, h, 16, 3)
		}
		if is_const(ix) != 0 && t[ELEM_SAFE] != 0 {
			off = const_val(ix) * size
		} else if is_const(ix) != 0 {
			off = const_val(ix) * size
			idx = -1
		}
	} else {
		base = gen_val(t[MEM_BASE], 0)
		d = next_depth(base, 0)
		off = t[MEM_OFF]
		let ix = t[MEM_INDEX]
		if ix != 0 && is_const(ix) != 0 && t[MEM_LEN] == 0 {
			off = off + const_val(ix) * t[MEM_SCALE]
		} else if ix != 0 {
			idx = gen_val(ix, d)
			d = next_depth(idx, d)
			if t[MEM_LEN] != 0 {
				bounds_check(idx, t[MEM_LEN], d)
			}
			if t[MEM_SCALE] != size {
				let nb = treg(d)
				emit4(I_ADD, nb, base, idx, SH_LSL + width_log2(t[MEM_SCALE]))
				d = d + 1
				base = nb
				idx = -1
			}
		}
	}
	if idx >= 0 && off != 0 {
		let nb2 = treg(d)
		add_imm(nb2, base, off)
		d = d + 1
		base = nb2
		off = 0
	}
	if idx < 0 && (off < 0 || off % size != 0 || off / size >= 4096) {
		let nb3 = treg(d)
		add_imm(nb3, base, off)
		d = d + 1
		base = nb3
		off = 0
	}
	mut val = 0
	if v[N_KIND] == EX_BINARY && d + 2 < t_count && d + 2 < f_count && has_effects(t) == 0 && expr_equal(v[BIN_L], t) != 0 {
		mut cur = 0
		if fpv != 0 {
			cur = freg(d)
		} else {
			cur = treg(d)
		}
		mm_base = base
		mm_index = idx
		mm_off = off
		emit_load(cur, t[N_TYPE])
		let saved = node_copy(v[BIN_L])
		v[BIN_L][N_KIND] = EX_REG
		v[BIN_L][REG_NUM] = cur
		gen_to(v, cur, d + 1)
		node_restore(v[BIN_L], saved)
		val = cur
	} else if fpv == 0 && is_const(v) != 0 && const_val(v) == 0 {
		val = ZR
	} else {
		val = gen_val(v, d)
	}
	mm_base = base
	mm_index = idx
	mm_off = off
	emit_store(val, t[N_TYPE])
}

fn gen_store_index(t i64, v i64) {
	let base = gen_val(t[IX_X], 0)
	mut d = next_depth(base, 0)
	let ix = t[IX_I]
	mut index = -1
	mut off = 0
	if is_const(ix) != 0 && const_val(ix) >= 0 && const_val(ix) < 4096 {
		off = const_val(ix) * 8
	} else {
		index = gen_val(ix, d)
		d = next_depth(index, d)
	}
	let fpv = i64(e_fp(v) != 0 || e_fp(t) != 0)
	mut val = 0
	if v[N_KIND] == EX_BINARY && d + 1 < t_count && d + 1 < f_count && has_effects(t) == 0 && expr_equal(v[BIN_L], t) != 0 {
		// a[i] = a[i] op x: load the element once and update it in a register.
		mut cur = 0
		if fpv != 0 {
			cur = freg(d)
		} else {
			cur = treg(d)
		}
		if index < 0 {
			if fpv != 0 {
				emit3(I_LDRD, cur, base, off)
			} else {
				emit3(I_LDR, cur, base, off)
			}
		} else if fpv != 0 {
			emit3(I_LDRDX, cur, base, index)
		} else {
			emit3(I_LDRX, cur, base, index)
		}
		let saved = node_copy(v[BIN_L])
		v[BIN_L][N_KIND] = EX_REG
		v[BIN_L][REG_NUM] = cur
		gen_to(v, cur, d + 1)
		node_restore(v[BIN_L], saved)
		val = cur
	} else if fpv == 0 && is_const(v) != 0 && const_val(v) == 0 {
		val = ZR
	} else {
		val = gen_val(v, d)
	}
	if is_fp(val) != 0 {
		if index < 0 {
			emit3(I_STRD, val, base, off)
		} else {
			emit3(I_STRDX, val, base, index)
		}
		return
	}
	if index < 0 {
		emit3(I_STR, val, base, off)
	} else {
		emit3(I_STRX, val, base, index)
	}
}

fn gen_assign(s i64) {
	let t = s[AS_TARGET]
	let v = s[AS_VALUE]
	if t[N_KIND] == EX_INDEX {
		gen_store_index(t, v)
		return
	}
	if t[N_KIND] == EX_MEM || t[N_KIND] == EX_ELEM {
		gen_store_mem(t, v)
		return
	}
	let sym = t[ID_REF]
	if sym[S_KIND] == SYM_LOCAL {
		assign_local(sym, v)
		return
	}
	if is_dyn_value(sym[S_TYPE]) != 0 {
		let r0 = treg(0)
		let r1 = treg(1)
		gen_dyn_pair(v, r0, r1, 0)
		if sym[S_TLS] != 0 {
			emit3(I_STR, r0, 28, tls_off(sym))
			emit3(I_STR, r1, 28, tls_off(sym) + 8)
		} else {
			let first = sym_ref(SK_VAR, sym[S_INDEX])
			let second = sym_ref(SK_VAR, sym[S_WORDS])
			emit2(I_ADRP, X16, first)
			emit3(I_STRLO, r0, X16, first)
			emit2(I_ADRP, X16, second)
			emit3(I_STRLO, r1, X16, second)
		}
		return
	}
	mut r = gen_val(v, 0)
	if sym[S_TLS] != 0 {
		if is_fp(r) != 0 {
			emit3(I_STRD, r, 28, tls_off(sym))
		} else {
			emit3(I_STR, r, 28, tls_off(sym))
		}
		return
	}
	let g = sym_ref(SK_VAR, sym[S_INDEX])
	emit2(I_ADRP, X17, g)
	if is_fp(r) != 0 {
		emit2(I_FMOVXD, X16, r)
		r = X16
	}
	emit3(I_STRLO, r, X17, g)
}

fn gen_while(s i64) {
	let cond = s[WH_COND]
	let body_l = new_label()
	let cond_l = new_label()
	let post_l = new_label()
	let end_l = new_label()
	if s[WH_ONCE] != 0 {
		// A switch: break leaves it, continue goes to the enclosing loop.
		mut cont = -1
		if g_loops[VEC_LEN] >= 2 {
			cont = vec_get(g_loops, g_loops[VEC_LEN] - 2)
		}
		vec_push(g_loops, cont)
		vec_push(g_loops, end_l)
		gen_stmts(s[WH_BODY][BLK_STMTS])
		g_loops[VEC_LEN] = g_loops[VEC_LEN] - 2
		label(end_l)
		return
	}
	if is_const(cond) != 0 && const_val(cond) == 0 {
		return
	}
	let forever = is_const(cond)
	mut cont_l = cond_l
	if s[WH_POST] != 0 {
		cont_l = post_l
	} else if forever != 0 {
		cont_l = body_l
	}
	// Rotated loop: the test sits at the bottom, so each iteration takes one branch.
	if forever == 0 {
		emit1(I_B, cond_l)
	}
	label(body_l)
	gen_poll()
	vec_push(g_loops, cont_l)
	vec_push(g_loops, end_l)
	gen_stmts(s[WH_BODY][BLK_STMTS])
	g_loops[VEC_LEN] = g_loops[VEC_LEN] - 2
	label(post_l)
	if s[WH_POST] != 0 {
		gen_stmt(s[WH_POST])
	}
	if forever != 0 {
		emit1(I_B, body_l)
	} else {
		label(cond_l)
		gen_branch(cond, body_l, 0, 1)
	}
	label(end_l)
}

fn gen_stmts(stmts i64) {
	mut i = 0
	for i < stmts[VEC_LEN] {
		gen_stmt(vec_get(stmts, i))
		i = i + 1
	}
}

fn result_reg(f i64, i i64) i64 {
	if f[F_RTYPES][VEC_LEN] == 1 && is_float_t(vec_get(f[F_RTYPES], 0)) != 0 {
		return FPR
	}
	return i
}

fn gen_stmt(s i64) {
	let k = s[N_KIND]
	if k == ST_BLOCK {
		gen_stmts(s[BLK_STMTS])
	} else if k == ST_LET {
		assign_local(s[LET_SYM], s[LET_INIT])
	} else if k == ST_ASSIGN {
		gen_assign(s)
	} else if k == ST_EXPR {
		gen_effect(s[ES_X])
	} else if k == ST_IF && try_if_increment(s) != 0 {
		// The condition flags drive the backend's conditional increment.
	} else if k == ST_IF && try_select(s) != 0 {
		// done: both arms computed and picked with csel
	} else if k == ST_IF {
		let else_l = new_label()
		gen_cond(s[IF_COND], else_l, 0)
		gen_stmts(s[IF_THEN][BLK_STMTS])
		if s[IF_ELSE] != 0 {
			let end_l = new_label()
			emit1(I_B, end_l)
			label(else_l)
			gen_stmt(s[IF_ELSE])
			label(end_l)
		} else {
			label(else_l)
		}
	} else if k == ST_WHILE {
		gen_while(s)
	} else if k == ST_RETURN {
		gen_return(s)
	} else if k == ST_BREAK {
		emit1(I_B, vec_get(g_loops, g_loops[VEC_LEN] - 1))
	} else if k == ST_CONTINUE {
		// A switch block passes continue on to the loop around it.
		mut i = g_loops[VEC_LEN] - 2
		for vec_get(g_loops, i) < 0 {
			i = i - 2
		}
		emit1(I_B, vec_get(g_loops, i))
	} else if k == ST_CALLMULTI {
		gen_call(s[CM_CALL], 0)
		let syms = s[CM_SYMS]
		mut i = 0
		for i < syms[VEC_LEN] {
			let sym = vec_get(syms, i)
			if sym[S_REG] >= 0 {
				mov(sym[S_REG], i)
			} else if sym[S_REG] == REG_SLOT {
				emit3(I_STR, i, FP, sym[S_OFF])
			}
			i = i + 1
		}
	}
}

// Multiple results travel in x0-x7 (floats as bits); a single float result in d0.
fn gen_return(s i64) {
	let f = cur_gen_fn
	if s[RET_VALUES] != 0 {
		let vals = s[RET_VALUES]
		let lanes = vec_new()
		mut nlanes = 0
		mut i = 0
		for i < vals[VEC_LEN] {
			let v = vec_get(vals, i)
			vec_push(lanes, nlanes)
			if is_dyn_value(v[N_TYPE]) != 0 {
				let r0 = treg(i)
				let r1 = treg(i + 1)
				gen_dyn_pair(v, r0, r1, i)
				emit1(I_PUSH, r0)
				emit1(I_PUSH, r1)
				nlanes = nlanes + 2
			} else {
				push_reg(gen_val(v, i))
				nlanes = nlanes + 1
			}
			i = i + 1
		}
		i = 0
		mut lane_ = nlanes
		i = vals[VEC_LEN] - 1
		for i >= 0 {
			let v = vec_get(vals, i)
			let start = vec_get(lanes, i)
			if is_dyn_value(v[N_TYPE]) != 0 {
				lane_ = lane_ - 2
				emit1(I_POP, X16)
				emit1(I_POP, X17)
				mov(start, X17)
				mov(start + 1, X16)
			} else {
				lane_ = lane_ - 1
				if is_float_t(v[N_TYPE]) != 0 {
					emit1(I_FPOP, FPR)
					mov(start, FPR)
				} else {
					emit1(I_POP, start)
				}
			}
			i = i - 1
		}
	} else if s[RET_VALUE] != 0 {
		if is_dyn_value(s[RET_VALUE][N_TYPE]) != 0 {
			gen_dyn_pair(s[RET_VALUE], 0, 1, 0)
		} else {
			gen_to(s[RET_VALUE], result_reg(f, 0), 0)
		}
	} else {
		emit3(I_MOVZ, 0, 0, 0)
	}
	emit1(I_RET, 0)
}

// ---- if-conversion ----
// speculable reports whether e can be computed even on the path that doesn't need it:
// no calls, no memory access, no panics, and cheap enough to beat a mispredicted branch.
fn speculable(e i64) i64 {
	let k = e[N_KIND]
	if k == EX_INT || k == EX_STR || k == EX_FLOAT || k == EX_FUNCREF {
		return 1
	}
	if k == EX_IDENT {
		return i64(e[ID_REF][S_KIND] != SYM_GLOBAL)
	}
	if k == EX_UNARY {
		return speculable(e[UN_X])
	}
	if k == EX_BINARY {
		return i64(streq(e[BIN_OP], cstr("&&")) == 0 && streq(e[BIN_OP], cstr("||")) == 0 && may_panic(e) == 0 && speculable(e[BIN_L]) != 0 && speculable(e[BIN_R]) != 0)
	}
	if k == EX_CONV {
		return i64(e[CV_KIND] != CV_LEN && e[CV_KIND] != CV_CAP && speculable(e[CV_X]) != 0)
	}
	if k == EX_CALL && e[CALL_INTRINSIC] != 0 && streq(e[CALL_NAME], cstr("__empty")) != 0 {
		return 1
	}
	return 0
}

// single_reg_assign returns the register local assigned by a block of exactly one
// `x = e;`, or 0 if the block is anything else.
fn single_reg_assign(b i64) i64 {
	if b[BLK_STMTS][VEC_LEN] != 1 {
		return 0
	}
	let s = vec_get(b[BLK_STMTS], 0)
	if s[N_KIND] != ST_ASSIGN || s[AS_TARGET][N_KIND] != EX_IDENT {
		return 0
	}
	let sym = s[AS_TARGET][ID_REF]
	if sym[S_KIND] != SYM_LOCAL || sym[S_REG] < 0 || speculable(s[AS_VALUE]) == 0 {
		return 0
	}
	return s
}

// read_only_expr accepts pure expressions and checker-created sequences that only bind
// local temporaries. It excludes calls and writes so the conditional increment cannot
// reorder observable effects.
fn read_only_expr(e i64) i64 {
	if e == 0 {
		return 1
	}
	let k = e[N_KIND]
	if k == EX_INT || k == EX_STR || k == EX_FLOAT || k == EX_FUNCREF || k == EX_IDENT {
		return 1
	}
	if k == EX_UNARY {
		return read_only_expr(e[UN_X])
	}
	if k == EX_BINARY {
		return i64(read_only_expr(e[BIN_L]) != 0 && read_only_expr(e[BIN_R]) != 0)
	}
	if k == EX_CONV {
		return read_only_expr(e[CV_X])
	}
	if k == EX_MEM {
		return i64(read_only_expr(e[MEM_BASE]) != 0 && read_only_expr(e[MEM_INDEX]) != 0 && read_only_expr(e[MEM_LEN]) != 0)
	}
	if k == EX_ELEM {
		return i64(read_only_expr(e[ELEM_SEQ]) != 0 && read_only_expr(e[ELEM_IDX]) != 0)
	}
	if k == EX_INDEX {
		return i64(read_only_expr(e[IX_X]) != 0 && read_only_expr(e[IX_I]) != 0)
	}
	if k == EX_SEQ {
		let stmts = e[SEQ_STMTS]
		mut i = 0
		for i < stmts[VEC_LEN] {
			let st = vec_get(stmts, i)
			if st[N_KIND] != ST_LET || read_only_expr(st[LET_INIT]) == 0 {
				return 0
			}
			i = i + 1
		}
		return read_only_expr(e[SEQ_VALUE])
	}
	return 0
}

// if_increment_assignment returns the assignment in `if c { x++ }` when x is a
// register-held 64-bit integer and c cannot write through calls or assignments.
fn if_increment_assignment(s i64) i64 {
	if s[IF_ELSE] != 0 || read_only_expr(s[IF_COND]) == 0 {
		return 0
	}
	let body = s[IF_THEN]
	if body[BLK_STMTS][VEC_LEN] != 1 {
		return 0
	}
	let a = vec_get(body[BLK_STMTS], 0)
	if a[N_KIND] != ST_ASSIGN || a[AS_TARGET][N_KIND] != EX_IDENT {
		return 0
	}
	let x = a[AS_TARGET][ID_REF]
	let value = a[AS_VALUE]
	if x[S_KIND] != SYM_LOCAL || x[S_REG] < 0 || is_integer_t(x[S_TYPE]) == 0 || x[S_TYPE][TY_WIDTH] != 8 || value[N_KIND] != EX_BINARY || streq(value[BIN_OP], cstr("+")) == 0 || value[BIN_L][N_KIND] != EX_IDENT || value[BIN_L][ID_REF] != x || is_const(value[BIN_R]) == 0 || const_val(value[BIN_R]) != 1 {
		return 0
	}
	return a
}

// try_if_increment compiles `if c { x++ }` to a conditional increment on arm64.
fn try_if_increment(s i64) i64 {
	let a = if_increment_assignment(s)
	if a == 0 {
		return 0
	}
	let x = a[AS_TARGET][ID_REF]
	let cc = gen_flags(s[IF_COND], 0)
	emit3(I_CINC, x[S_REG], x[S_REG], cc)
	return 1
}

// gen_flags sets the flags for condition e and returns the condition code meaning true.
fn gen_flags(e i64, d i64) i64 {
	if e[N_KIND] == EX_UNARY && streq(e[UN_OP], cstr("!")) != 0 {
		return gen_flags(e[UN_X], d) ^ 1
	}
	if e[N_KIND] == EX_SEQ {
		mut i = 0
		for i < d {
			if i < t_count {
				emit1(I_PUSH, vec_get(t_regs, i))
			}
			if i < f_count {
				emit1(I_FPUSH, vec_get(f_regs, i))
			}
			i = i + 1
		}
		gen_stmts(e[SEQ_STMTS])
		i = d - 1
		for i >= 0 {
			if i < f_count {
				emit1(I_FPOP, vec_get(f_regs, i))
			}
			if i < t_count {
				emit1(I_POP, vec_get(t_regs, i))
			}
			i = i - 1
		}
		return gen_flags(e[SEQ_VALUE], d)
	}
	if e[N_KIND] == EX_BINARY {
		let cc = cond_code(e[BIN_OP])
		if (cc == C_EQ || cc == C_NE) && e_fp(e[BIN_L]) == 0 && is_const(e[BIN_R]) != 0 && const_val(e[BIN_R]) == 0 && low_bits_test(e[BIN_L]) > 0 {
			let l = e[BIN_L]
			emit2(I_TSTI, gen_val(l[BIN_L], d), low_bits_test(l))
			return cc
		}
		if cc >= 0 {
			gen_compare(e, d)
			return cmp_cc
		}
	}
	emit2(I_CMPI, gen_val(e, d), 0)
	return C_NE
}

// try_select compiles `if c { x = a; } else { x = b; }` as x = csel(c, a, b), like
// Go's branchelim: both values are cheap, so computing both beats a mispredicted branch.
fn try_select(s i64) i64 {
	let c = s[IF_COND]
	if has_effects(c) != 0 || contains_call(c) != 0 || is_const(c) != 0 || e_fp(c) != 0 {
		return 0
	}
	if c[N_KIND] == EX_BINARY && (streq(c[BIN_OP], cstr("&&")) != 0 || streq(c[BIN_OP], cstr("||")) != 0) {
		return 0
	}
	let ta = single_reg_assign(s[IF_THEN])
	if ta == 0 {
		return 0
	}
	let x = ta[AS_TARGET][ID_REF]
	mut fb = 0
	if s[IF_ELSE] != 0 {
		if s[IF_ELSE][N_KIND] != ST_BLOCK {
			return 0
		}
		fb = single_reg_assign(s[IF_ELSE])
		if fb == 0 || fb[AS_TARGET][ID_REF] != x {
			return 0
		}
	}
	if op_cost(ta[AS_VALUE]) > 6 || (fb != 0 && op_cost(fb[AS_VALUE]) > 6) || t_count < 4 || f_count < 4 {
		return 0
	}
	let a = gen_val(ta[AS_VALUE], 0)
	mut d = next_depth(a, 0)
	mut b = x[S_REG]
	if fb != 0 {
		b = gen_val(fb[AS_VALUE], d)
		d = next_depth(b, d)
	}
	let cc = gen_flags(c, d)
	if is_fp(x[S_REG]) != 0 {
		emit4(I_FCSEL, x[S_REG], a, b, cc)
	} else {
		emit4(I_CSEL, x[S_REG], a, b, cc)
	}
	return 1
}

// ---- functions ----
// param_only reports whether e reads nothing but parameters and constants, with no calls.
fn param_only(e i64, np i64) i64 {
	let k = e[N_KIND]
	if k == EX_INT || k == EX_FLOAT {
		return 1
	}
	if k == EX_IDENT {
		let s = e[ID_REF]
		return i64(s[S_KIND] == SYM_CONST || (s[S_KIND] == SYM_LOCAL && s[S_SLOT] < np))
	}
	if k == EX_UNARY {
		return i64(streq(e[UN_OP], cstr("&")) == 0 && param_only(e[UN_X], np) != 0)
	}
	if k == EX_BINARY {
		return i64(param_only(e[BIN_L], np) != 0 && param_only(e[BIN_R], np) != 0)
	}
	return 0
}

// exit_pattern returns f's leading `if c { return v; }` when c and v only read
// parameters, else 0.
fn exit_pattern(f i64) i64 {
	if f[F_EXTERN] != 0 || f[F_BODY] == 0 || f[F_RTYPES][VEC_LEN] > 1 {
		return 0
	}
	let stmts = f[F_BODY][BLK_STMTS]
	if stmts[VEC_LEN] < 2 {
		return 0
	}
	let s = vec_get(stmts, 0)
	if s[N_KIND] != ST_IF || s[IF_ELSE] != 0 || s[IF_THEN][BLK_STMTS][VEC_LEN] != 1 {
		return 0
	}
	let r = vec_get(s[IF_THEN][BLK_STMTS], 0)
	let np = f[F_PARAMS][VEC_LEN]
	if r[N_KIND] != ST_RETURN || r[RET_VALUES] != 0 || param_only(s[IF_COND], np) == 0 || (r[RET_VALUE] != 0 && param_only(r[RET_VALUE], np) == 0) {
		return 0
	}
	if op_cost(s[IF_COND]) > 4 || (r[RET_VALUE] != 0 && op_cost(r[RET_VALUE]) > 4) {
		return 0
	}
	return s
}

// with_params_in_args points f's parameters at x0-x7/d0-d7 (or back at their homes)
// while code is generated for f's exit pattern outside f's own frame.
fn with_params_in_args(f i64, homes i64) {
	let locals = f[F_LOCALS]
	mut ni = 0
	mut nf = 0
	mut i = 0
	for i < f[F_PARAMS][VEC_LEN] {
		let s = vec_get(locals, i)
		if homes != 0 {
			s[S_REG] = vec_get(homes, i)
		} else if is_float_t(vec_get(f[F_PTYPES], i)) != 0 {
			s[S_REG] = FPR + nf
			nf = nf + 1
		} else {
			s[S_REG] = ni
			ni = ni + 1
		}
		i = i + 1
	}
}

fn param_homes(f i64) i64 {
	let homes = vec_new()
	mut i = 0
	for i < f[F_PARAMS][VEC_LEN] {
		vec_push(homes, vec_get(f[F_LOCALS], i)[S_REG])
		i = i + 1
	}
	return homes
}

// early_exit handles a leading `if c { return v; }` that only reads parameters before
// the frame exists, so base cases (fib's n < 2) never pay for the prologue.
fn early_exit(f i64) i64 {
	let s = exit_pattern(f)
	if s == 0 {
		return 0
	}
	let r = vec_get(s[IF_THEN][BLK_STMTS], 0)
	// Parameters are still in x0-x7 here, and x9-x15 / d16-d23 are free for temps.
	let homes = param_homes(f)
	with_params_in_args(f, 0)
	let saved_t = t_regs
	let saved_n = t_count
	let saved_f = f_regs
	let saved_fn = f_count
	t_regs = vec_new()
	mut i = 9
	for i <= 15 {
		vec_push(t_regs, i)
		i = i + 1
	}
	t_count = 7
	f_regs = vec_new()
	i = 16
	for i <= 23 {
		vec_push(f_regs, FPR + i)
		i = i + 1
	}
	f_count = 8
	let body_l = new_label()
	gen_cond(s[IF_COND], body_l, 0)
	if r[RET_VALUE] != 0 {
		gen_to(r[RET_VALUE], result_reg(f, 0), 0)
	} else {
		emit3(I_MOVZ, 0, 0, 0)
	}
	emit1(I_RETX, 0)
	label(body_l)
	t_regs = saved_t
	t_count = saved_n
	f_regs = saved_f
	f_count = saved_fn
	with_params_in_args(f, homes)
	return 1
}

// holds_temp reports whether e's value would occupy a temp register (locals and
// constants are used in place).
fn holds_temp(e i64) i64 {
	let k = e[N_KIND]
	return i64(!(k == EX_IDENT && e[ID_REF][S_KIND] != SYM_GLOBAL) && is_const(e) == 0)
}

// cross_calls reports whether evaluating e keeps a temp alive across a call.
fn cross_calls(e i64) i64 {
	if e == 0 {
		return 0
	}
	let k = e[N_KIND]
	if k == EX_BINARY {
		if holds_temp(e[BIN_L]) != 0 && contains_call(e[BIN_R]) != 0 {
			return 1
		}
		return i64(cross_calls(e[BIN_L]) != 0 || cross_calls(e[BIN_R]) != 0)
	}
	if k == EX_INDEX {
		if holds_temp(e[IX_X]) != 0 && contains_call(e[IX_I]) != 0 {
			return 1
		}
		return i64(cross_calls(e[IX_X]) != 0 || cross_calls(e[IX_I]) != 0)
	}
	if k == EX_MEM {
		if holds_temp(e[MEM_BASE]) != 0 && (contains_call(e[MEM_INDEX]) != 0 || contains_call(e[MEM_LEN]) != 0) {
			return 1
		}
		return i64(cross_calls(e[MEM_BASE]) != 0 || cross_calls(e[MEM_INDEX]) != 0)
	}
	if k == EX_ELEM {
		if holds_temp(e[ELEM_SEQ]) != 0 && contains_call(e[ELEM_IDX]) != 0 {
			return 1
		}
		return i64(cross_calls(e[ELEM_SEQ]) != 0 || cross_calls(e[ELEM_IDX]) != 0)
	}
	if k == EX_UNARY {
		return cross_calls(e[UN_X])
	}
	if k == EX_CONV {
		return cross_calls(e[CV_X])
	}
	if k == EX_SEQ {
		return 1
	}
	if k == EX_CALL {
		let args = e[CALL_ARGS]
		mut calls = 0
		mut i = args[VEC_LEN] - 1
		for i >= 0 {
			let a = vec_get(args, i)
			if cross_calls(a) != 0 || (calls != 0 && speculable(a) == 0) {
				return 1
			}
			if contains_call(a) != 0 {
				calls = calls + 1
			}
			i = i - 1
		}
	}
	return 0
}

fn stmts_cross_calls(stmts i64) i64 {
	mut i = 0
	for i < stmts[VEC_LEN] {
		if stmt_cross_calls(vec_get(stmts, i)) != 0 {
			return 1
		}
		i = i + 1
	}
	return 0
}

fn stmt_cross_calls(s i64) i64 {
	if s == 0 {
		return 0
	}
	let k = s[N_KIND]
	if k == ST_LET {
		return cross_calls(s[LET_INIT])
	}
	if k == ST_ASSIGN {
		let t = s[AS_TARGET]
		return i64(cross_calls(s[AS_VALUE]) != 0 || ((t[N_KIND] == EX_INDEX || t[N_KIND] == EX_MEM || t[N_KIND] == EX_ELEM) && (cross_calls(t) != 0 || contains_call(s[AS_VALUE]) != 0)))
	}
	if k == ST_EXPR {
		return cross_calls(s[ES_X])
	}
	if k == ST_RETURN {
		if s[RET_VALUES] != 0 {
			return 1
		}
		return i64(s[RET_VALUE] != 0 && cross_calls(s[RET_VALUE]) != 0)
	}
	if k == ST_BLOCK {
		return stmts_cross_calls(s[BLK_STMTS])
	}
	if k == ST_IF {
		return i64(cross_calls(s[IF_COND]) != 0 || stmt_cross_calls(s[IF_THEN]) != 0 || stmt_cross_calls(s[IF_ELSE]) != 0)
	}
	if k == ST_WHILE {
		return i64(cross_calls(s[WH_COND]) != 0 || stmt_cross_calls(s[WH_BODY]) != 0 || stmt_cross_calls(s[WH_POST]) != 0)
	}
	return 0
}

// assign_homes gives each local a register or frame slot and builds the temp pools.
// It returns the number of frame slots.
fn assign_homes(f i64) i64 {
	let locals = f[F_LOCALS]
	let leaf = f[F_LEAF]
	let pool = vec_new()
	let fpool = vec_new()
	mut r = 0
	if leaf != 0 {
		r = 9
		for r <= 15 {
			vec_push(pool, r)
			r = r + 1
		}
		r = 16
		for r <= 30 {
			vec_push(fpool, FPR + r)
			r = r + 1
		}
	}
	r = 19
	for r <= 27 {
		vec_push(pool, r)
		r = r + 1
	}
	r = 8
	for r <= 15 {
		vec_push(fpool, FPR + r)
		r = r + 1
	}
	mut nslots = 0
	mut i = 0
	for i < locals[VEC_LEN] {
		let s = vec_get(locals, i)
		s[S_REG] = REG_DEAD
		if is_dyn_value(s[S_TYPE]) != 0 {
			s[S_ADDR] = 1
			s[S_WORDS] = 2
		}
		if s[S_ADDR] != 0 {
			s[S_REG] = REG_SLOT
			mut nw = 1
			if s[S_WORDS] > 1 {
				nw = s[S_WORDS]
			}
			s[S_OFF] = 16 + 8 * nslots
			nslots = nslots + nw
		}
		i = i + 1
	}
	// Hand out registers by descending loop-weighted use count.
	mut next = 0
	mut fnext = 0
	for {
		mut best = 0
		i = 0
		for i < locals[VEC_LEN] {
			let c = vec_get(locals, i)
			if c[S_REG] == REG_DEAD && c[S_USES] > 0 && (best == 0 || c[S_USES] > best[S_USES]) {
				best = c
			}
			i = i + 1
		}
		if best == 0 {
			break
		}
		if is_float_t(best[S_TYPE]) != 0 && fnext < fpool[VEC_LEN] {
			best[S_REG] = vec_get(fpool, fnext)
			used_fregs = used_fregs | (1 << (best[S_REG] - FPR))
			fnext = fnext + 1
		} else if is_float_t(best[S_TYPE]) == 0 && next < pool[VEC_LEN] {
			best[S_REG] = vec_get(pool, next)
			used_regs = used_regs | (1 << best[S_REG])
			next = next + 1
		} else {
			best[S_REG] = REG_SLOT
			best[S_OFF] = 16 + 8 * nslots
			nslots = nslots + 1
		}
	}
	let cross = i64(leaf == 0 && stmts_cross_calls(f[F_BODY][BLK_STMTS]) != 0)
	t_regs = vec_new()
	f_regs = vec_new()
	if leaf != 0 {
		r = 0
		for r <= 8 {
			vec_push(t_regs, r)
			r = r + 1
		}
		for next < pool[VEC_LEN] && vec_get(pool, next) <= 15 {
			vec_push(t_regs, vec_get(pool, next))
			next = next + 1
		}
		r = 0
		for r <= 7 {
			vec_push(f_regs, FPR + r)
			r = r + 1
		}
		for fnext < fpool[VEC_LEN] && vec_get(fpool, fnext) >= FPR + 16 {
			vec_push(f_regs, vec_get(fpool, fnext))
			fnext = fnext + 1
		}
	} else {
		// Leftover callee-saved registers survive calls for free; caller-saved ones
		// cost nothing in the prologue. Prefer whichever this function needs.
		if cross != 0 {
			for next < pool[VEC_LEN] {
				vec_push(t_regs, vec_get(pool, next))
				next = next + 1
			}
			for fnext < fpool[VEC_LEN] {
				vec_push(f_regs, vec_get(fpool, fnext))
				fnext = fnext + 1
			}
		}
		r = 9
		for r <= 15 {
			vec_push(t_regs, r)
			r = r + 1
		}
		vec_push(t_regs, 8)
		r = 16
		for r <= 30 {
			vec_push(f_regs, FPR + r)
			r = r + 1
		}
		for next < pool[VEC_LEN] {
			vec_push(t_regs, vec_get(pool, next))
			next = next + 1
		}
		for fnext < fpool[VEC_LEN] {
			vec_push(f_regs, vec_get(fpool, fnext))
			fnext = fnext + 1
		}
	}
	t_count = t_regs[VEC_LEN]
	f_count = f_regs[VEC_LEN]
	return nslots
}

// ---- hand-assembled functions ----
//
// seal.hw_blocks(state, data, nblocks, k) runs the SHA-256 compression function over
// nblocks 64-byte blocks with the ARMv8 SHA-256 instructions (every Apple Silicon core
// has them). Only caller-saved registers are used: x0-x3, v0-v7, v16-v20.
fn q_ldp(t1 i64, t2 i64, n i64, off i64) i64 {
	return 0xAD400000 | (((off >> 4) & 0x7f) << 15) | (t2 << 10) | (n << 5) | t1
}

fn q_stp(t1 i64, t2 i64, n i64, off i64) i64 {
	return 0xAD000000 | (((off >> 4) & 0x7f) << 15) | (t2 << 10) | (n << 5) | t1
}

fn q_ldr(t i64, n i64, off i64) i64 {
	return 0x3DC00000 | ((off >> 4) << 10) | (n << 5) | t
}

fn v3(op i64, d i64, n i64, m i64) i64 {
	return op | (m << 16) | (n << 5) | d
}

fn raw(v i64, word i64) {
	vec_push(v, word)
}

fn sha256_hw_words() i64 {
	let w = vec_new()
	raw(w, q_ldp(0, 1, 0, 0))
	let loop_ = w[VEC_LEN]
	raw(w, q_ldp(4, 5, 1, 0))
	raw(w, q_ldp(6, 7, 1, 32))
	raw(w, 0x91010021)
	mut r = 4
	for r <= 7 {
		raw(w, 0x6E200800 | (r << 5) | r)
		r = r + 1
	}
	raw(w, v3(0x4EA01C00, 16, 0, 0))
	raw(w, v3(0x4EA01C00, 17, 1, 1))
	mut i = 0
	for i < 16 {
		let wi = 4 + i % 4
		raw(w, q_ldr(20, 3, 16 * i))
		raw(w, v3(0x4EA08400, 20, 20, wi))
		if i < 12 {
			raw(w, 0x5E282800 | ((4 + (i + 1) % 4) << 5) | wi)
		}
		raw(w, v3(0x4EA01C00, 18, 0, 0))
		raw(w, v3(0x5E004000, 0, 1, 20))
		raw(w, v3(0x5E005000, 1, 18, 20))
		if i < 12 {
			raw(w, v3(0x5E006000, wi, 4 + (i + 2) % 4, 4 + (i + 3) % 4))
		}
		i = i + 1
	}
	raw(w, v3(0x4EA08400, 0, 0, 16))
	raw(w, v3(0x4EA08400, 1, 1, 17))
	raw(w, 0xF1000442)
	let back = (loop_ - w[VEC_LEN]) & 0x7ffff
	raw(w, 0x54000000 | (back << 5) | 1)
	raw(w, q_stp(0, 1, 0, 0))
	raw(w, 0xD65F03C0)
	return w
}

// gen_raw_fn emits f as the hand-assembled words.
fn gen_raw_fn(f i64, words i64) {
	out4(I_FUNC, f, 0, 0, 0)
	mut i = 0
	for i < words[VEC_LEN] {
		out4(I_RAW, vec_get(words, i), 0, 0, 0)
		i = i + 1
	}
}

fn gen_dyn_table_init() {
	mut i = 0
	for i < dyn_tables[VEC_LEN] {
		let rec = vec_get(dyn_tables, i)
		let keep_ = vec_get(rec, 2)
		let methods = vec_get(rec, 3)
		let start = vec_get(rec, 4)
		mut j = 0
		for j <= methods[VEC_LEN] {
			mut f = keep_
			if j > 0 {
				f = vec_get(methods, j - 1)
			}
			let desc = sym_ref(SK_FNDESC, f[F_INDEX])
			let slot = sym_ref(SK_VAR, start + j)
			emit2(I_ADRP, X16, desc)
			emit3(I_ADDLO, X16, X16, desc)
			emit2(I_ADRP, X17, slot)
			emit3(I_ADDLO, X17, X17, slot)
			emit3(I_STR, X16, X17, 0)
			j = j + 1
		}
		i = i + 1
	}
}

// task_swap_words is rt_task_swap(from x0, to x1): store x19-x27, x29, x30, sp and
// d8-d15 at from, load them from to, and return on the other stack.
fn task_swap_words() i64 {
	let w = vec_new()
	let hex = cstr("a9005013a9015815a9026017a9036819a904741b910003e9a905241e6d0624086d072c0a6d08340c6d093c0ea9405033a9415835a9426037a9436839a944743ba945243e9100013f6d4624286d472c2a6d48342c6d493c2ed65f03c0")
	mut i = 0
	for i64(load8(hex + i)) != 0 {
		vec_push(w, hex_word(hex + i))
		i = i + 8
	}
	return w
}

fn hex_word(p i64) i64 {
	mut v = 0
	mut i = 0
	for i < 8 {
		let c = i64(load8(p + i))
		mut d = c - '0'
		if c >= 'a' {
			d = c - 'a' + 10
		}
		v = v * 16 + d
		i = i + 1
	}
	return v
}

// Stack parameters are below the callee's frame. finish_fn patches the byte offset once
// it knows the complete frame size, which includes locals and saved registers.
fn gen_stack_param_load(dst i64, incoming_off i64) {
	let instruction = cg[VEC_LEN] / 5
	emit3(I_LDR, dst, FP, 0)
	vec_push(incoming_stack_loads, instruction)
	vec_push(incoming_stack_loads, incoming_off)
}

// The bulk memory loops preserve every callee-saved register and the core context.
fn memory_words(fill i64) i64 {
	let w = vec_new()
	if fill == 0 {
		raw(w, 0xb4000122)
		raw(w, 0xad400420)
		raw(w, 0xad410c22)
		raw(w, 0xad000400)
		raw(w, 0xad010c02)
		raw(w, 0x91010000)
		raw(w, 0x91010021)
		raw(w, 0xf1000442)
		raw(w, 0x54ffff21)
	} else {
		raw(w, 0xb40000e2)
		raw(w, 0x4e080c20)
		raw(w, 0xad000000)
		raw(w, 0xad010000)
		raw(w, 0x91010000)
		raw(w, 0xf1000442)
		raw(w, 0x54ffff81)
	}
	raw(w, 0xd65f03c0)
	return w
}

// Raw Linux leaves preserve the Tin context and all callee-saved registers.
fn syscall_words(restorer i64) i64 {
	let w = vec_new()
	if restorer != 0 {
		raw(w, 0xd2801168)
		raw(w, 0xd4000001)
		return w
	}
	raw(w, 0xaa0003e8)
	raw(w, 0xaa0103e0)
	raw(w, 0xaa0203e1)
	raw(w, 0xaa0303e2)
	raw(w, 0xaa0403e3)
	raw(w, 0xaa0503e4)
	raw(w, 0xaa0603e5)
	raw(w, 0xd4000001)
	raw(w, 0xd65f03c0)
	return w
}

// fn_polls keeps trusted runtime leaves and explicit @nopoll bodies uninterrupted.
shared mut compiler_polls i64

fn fn_polls(f i64) i64 {
	if compiler_polls == 0 || f == start_fn {
		return 0
	}
	let path = vec_get(files, f[F_FILE])
	mut i = 0
	let n = strlen(path)
	for i < n {
		if vec_get(file_trusted, f[F_FILE]) != 0 && ((i + 13 <= n && mem_eq(path + i, cstr("/lib/runtime/"), 13) != 0) || (i == 0 && n >= 12 && mem_eq(path, cstr("lib/runtime/"), 12) != 0)) {
			return 0
		}
		i = i + 1
	}
	let attrs = f[F_ATTRS]
	i = 0
	for attrs != 0 && i < attrs[VEC_LEN] {
		if streq(vec_get(vec_get(attrs, i), 1), cstr("nopoll")) != 0 {
			return 0
		}
		i = i + 1
	}
	return 1
}

shared mut poll_sites i64

// gen_poll branches to a cold stub; the ordinary path uses only the reserved scratch.
fn gen_poll() {
	if fn_polls(cur_gen_fn) == 0 {
		return
	}
	let slow = new_label()
	let resume = new_label()
	emit3(I_LDR, X16, 28, 96)
	emit2(I_CBNZ, X16, slow)
	label(resume)
	vec_push(poll_sites, slow)
	vec_push(poll_sites, resume)
}

// gen_poll_stubs preserves leaf homes too: a stale watchdog write may return normally.
fn gen_poll_stubs() {
	let f = find_fn(cstr("rt_bnd_poll"))
	mut i = 0
	for i < poll_sites[VEC_LEN] {
		label(vec_get(poll_sites, i))
		emit3(I_SUBI, SP, SP, 416)
		mut r = 0
		for r < 19 {
			emit3(I_STR, r, SP, 8 * r)
			r = r + 1
		}
		emit3(I_STR, LR, SP, 152)
		r = 0
		for r < 32 {
			emit3(I_STRD, FPR + r, SP, 160 + 8 * r)
			r = r + 1
		}
		emit1(I_BL, f)
		r = 0
		for r < 32 {
			emit3(I_LDRD, FPR + r, SP, 160 + 8 * r)
			r = r + 1
		}
		r = 0
		for r < 19 {
			emit3(I_LDR, r, SP, 8 * r)
			r = r + 1
		}
		emit3(I_LDR, LR, SP, 152)
		emit3(I_ADDI, SP, SP, 416)
		emit1(I_B, vec_get(poll_sites, i + 1))
		i = i + 2
	}
}

fn gen_fn(f i64) {
	if tgt_linux != 0 {
		let words = syscall_fast_arm64(f[F_QNAME])
		if words != 0 {
			out4(I_FUNC, f, 0, 0, 0)
			if streq(f[F_QNAME], cstr("rt_sys_clock_gettime")) != 0 {
				let s = lookup_global(cstr("rtVdsoClock"))
				let sym = sym_ref(SK_VAR, s[S_INDEX])
				out4(I_ADRP, 2, sym, 0, 0)
				out4(I_LDRLO, 2, 2, sym, 0)
			}
			mut i = 0
			for i < words[VEC_LEN] {
				out4(I_RAW, vec_get(words, i), 0, 0, 0)
				i = i + 1
			}
			return
		}
	}
	if streq(f[F_QNAME], cstr("memcpy")) != 0 || streq(f[F_QNAME], cstr("memmove")) != 0 || streq(f[F_QNAME], cstr("memset")) != 0 || streq(f[F_QNAME], cstr("memcmp")) != 0 || streq(f[F_QNAME], cstr("memchr")) != 0 {
		gen_raw_fn(f, memory_fast_arm64(f[F_QNAME]))
		return
	}

	if tgt_linux != 0 && (streq(f[F_QNAME], cstr("linux_raw")) != 0 || streq(f[F_QNAME], cstr("linux_restorer")) != 0) {
		gen_raw_fn(f, syscall_words(streq(f[F_QNAME], cstr("linux_restorer"))))
		return
	}
	if streq(f[F_QNAME], cstr("mem_copy64")) != 0 || streq(f[F_QNAME], cstr("mem_fill64")) != 0 {
		gen_raw_fn(f, memory_words(streq(f[F_QNAME], cstr("mem_fill64"))))
		return
	}
	if streq(f[F_QNAME], cstr("seal.hw_blocks")) != 0 {
		gen_raw_fn(f, sha256_hw_words())
		return
	}
	if aes_hw_arm64(f[F_QNAME]) != 0 {
		gen_raw_fn(f, aes_hw_arm64(f[F_QNAME]))
		return
	}
	if streq(f[F_QNAME], cstr("rt_task_swap")) != 0 {
		gen_raw_fn(f, task_swap_words())
		return
	}
	cur_gen_fn = f
	trap_label = 0
	div_label = 0
	trap_sites = vec_new()
	poll_sites = vec_new()
	if host_getenv(cstr("TINC_TRACE")) != 0 {
		let tb = buf_new()
		buf_str(tb, cstr("gen "))
		buf_str(tb, f[F_QNAME])
		buf_byte(tb, '\n')
		write_all(2, tb)
	}
	inline_appends(f)
	licm_fn(f)
	analyze_fn(f)
	used_regs = 0
	used_fregs = 0
	g_loops[VEC_LEN] = 0
	let nslots = assign_homes(f)
	cg = vec_new()
	incoming_stack_loads = vec_new()
	mut early = 0
	if fn_polls(f) == 0 {
		early = early_exit(f)
	}
	let pre = cg
	cg = vec_new()
	let locals = f[F_LOCALS]
	mut ni = 0
	mut nf = 0
	mut stack_words = 0
	mut i = 0
	for i < f[F_PARAMS][VEC_LEN] {
		let s = vec_get(locals, i)
		mut src = 0
		if is_dyn_value(vec_get(f[F_PTYPES], i)) != 0 {
			let stack = i64(ni + 1 >= 8)
			if stack != 0 {
				ni = 8
				stack_words = align_up(stack_words, 2)
				gen_stack_param_load(X16, 8 * stack_words)
				gen_stack_param_load(X17, 8 * stack_words + 8)
				stack_words = stack_words + 2
				src = X16
			} else {
				src = ni
				ni = ni + 2
			}
			if s[S_REG] == REG_SLOT {
				emit3(I_STR, src, FP, s[S_OFF])
				if stack != 0 {
					emit3(I_STR, X17, FP, s[S_OFF] + 8)
				} else {
					emit3(I_STR, src + 1, FP, s[S_OFF] + 8)
				}
			} else {
				err_code_at(s[S_POS], cstr("E990 INTERNAL"), cstr("dyn parameter is not in a two-word frame slot"))
			}
			i = i + 1
			continue
		} else if is_float_t(vec_get(f[F_PTYPES], i)) != 0 {
			src = FPR + nf
			nf = nf + 1
		} else {
			if ni >= 8 {
				gen_stack_param_load(X16, 8 * stack_words)
				stack_words = stack_words + 1
				src = X16
			} else {
				src = ni
				ni = ni + 1
			}
		}
		if s[S_REG] >= 0 {
			mov(s[S_REG], src)
		} else if s[S_REG] == REG_SLOT {
			if is_fp(src) != 0 {
				emit3(I_STRD, src, FP, s[S_OFF])
			} else {
				emit3(I_STR, src, FP, s[S_OFF])
			}
		}
		i = i + 1
	}
	if f[F_ENV_SYM] != 0 {
		let es = f[F_ENV_SYM]
		if es[S_REG] >= 0 {
			mov(es[S_REG], X17)
		} else if es[S_REG] == REG_SLOT {
			emit3(I_STR, X17, FP, es[S_OFF])
		}
	}
	let stmts = f[F_BODY][BLK_STMTS]
	if f == entry_fn() {
		mut di = 0
		for di < prog_fns[VEC_LEN] {
			let df = vec_get(prog_fns, di)
			if df[F_EXTERN] == 0 && df[F_REACH] != 0 {
				let code_sym = sym_ref(SK_FN, di)
				let desc_sym = sym_ref(SK_FNDESC, di)
				emit2(I_ADRP, X16, code_sym)
				emit3(I_ADDLO, X16, X16, code_sym)
				emit2(I_ADRP, X17, desc_sym)
				emit3(I_ADDLO, X17, X17, desc_sym)
				emit3(I_STR, X16, X17, 0)
			}
			di = di + 1
		}
		gen_dyn_table_init()
	}
	gen_poll()
	i = early
	for i < stmts[VEC_LEN] {
		gen_stmt(vec_get(stmts, i))
		i = i + 1
	}
	emit3(I_MOVZ, 0, 0, 0)
	emit1(I_RET, 0)
	if trap_label != 0 {
		// The cold path every failed bounds check jumps to.
		label(trap_label)
		let bf = find_fn(cstr("rt_bounds_fail"))
		if bf != 0 {
			emit1(I_BL, bf)
			bf[F_USED] = 1
		}
	}
	if div_label != 0 {
		label(div_label)
		let df = find_fn(cstr("rt_div_fail"))
		if df != 0 {
			emit1(I_BL, df)
			df[F_USED] = 1
		}
	}
	// Per-site stubs: the index and length go through the stack into x0/x1 (any registers).
	mut ts = 0
	let bf2 = find_fn(cstr("rt_bounds_fail2"))
	for ts < trap_sites[VEC_LEN] {
		let site = vec_get(trap_sites, ts)
		label(vec_get(site, 0))
		mut ireg = vec_get(site, 1)
		if ireg < 0 {
			load_imm(X16, vec_get(site, 3))
			ireg = X16
		}
		emit3(I_STPPRE, ireg, vec_get(site, 2), -16)
		emit3(I_LDR, 0, SP, 0)
		emit3(I_LDR, 1, SP, 8)
		if bf2 != 0 {
			emit1(I_BL, bf2)
			bf2[F_USED] = 1
		}
		ts = ts + 1
	}
	gen_poll_stubs()
	finish_fn(f, nslots, pre)
}

fn out4(op i64, a i64, b i64, c i64, d i64) {
	vec_push(code, op)
	vec_push(code, a)
	vec_push(code, b)
	vec_push(code, c)
	vec_push(code, d)
}

// save_regs stores (or, with load, reloads) callee-saved registers in pairs.
fn save_regs(saved i64, base i64, load i64) {
	mut i = 0
	for i < saved[VEC_LEN] {
		let off = base + 8 * i
		let r = vec_get(saved, i)
		let fp = is_fp(r)
		if i + 1 < saved[VEC_LEN] && off + 8 <= 504 && is_fp(vec_get(saved, i + 1)) == fp {
			mut op = I_STP
			if fp != 0 && load != 0 {
				op = I_LDPD
			} else if fp != 0 {
				op = I_STPD
			} else if load != 0 {
				op = I_LDP
			}
			out4(op, r, vec_get(saved, i + 1), FP, off)
			i = i + 2
		} else {
			mut op1 = I_STR
			if fp != 0 && load != 0 {
				op1 = I_LDRD
			} else if fp != 0 {
				op1 = I_STRD
			} else if load != 0 {
				op1 = I_LDR
			}
			out4(op1, r, FP, off, 0)
			i = i + 1
		}
	}
}

// branch_to_next reports whether the branch at instruction i only skips labels to reach its target.
fn branch_to_next(i i64, n i64) i64 {
	let target = vec_get(cg, 5 * i + 1)
	mut j = i + 1
	for j < n && vec_get(cg, 5 * j) == I_LABEL {
		if vec_get(cg, 5 * j + 1) == target {
			return 1
		}
		j = j + 1
	}
	return 0
}

// label_follows reports whether only labels separate instruction i from label l.
fn label_follows(i i64, n i64, l i64) i64 {
	mut j = i
	for j < n && vec_get(cg, 5 * j) == I_LABEL {
		if vec_get(cg, 5 * j + 1) == l {
			return 1
		}
		j = j + 1
	}
	return 0
}

// cond_branch_target returns the label of a conditional branch, or -1.
fn cond_branch_target(k i64) i64 {
	let op = vec_get(cg, k)
	if op == I_BCOND || op == I_CBZ || op == I_CBNZ {
		return vec_get(cg, k + 2)
	}
	if op == I_TBZ || op == I_TBNZ {
		return vec_get(cg, k + 3)
	}
	return -1
}

// emit_inverted copies conditional branch k with its sense flipped, aimed at label l.
fn emit_inverted(k i64, l i64) {
	let op = vec_get(cg, k)
	let a = vec_get(cg, k + 1)
	if op == I_BCOND {
		out4(I_BCOND, a ^ 1, l, 0, 0)
	} else if op == I_CBZ {
		out4(I_CBNZ, a, l, 0, 0)
	} else if op == I_CBNZ {
		out4(I_CBZ, a, l, 0, 0)
	} else if op == I_TBZ {
		out4(I_TBNZ, a, vec_get(cg, k + 2), l, 0)
	} else {
		out4(I_TBZ, a, vec_get(cg, k + 2), l, 0)
	}
}

// finish_fn wraps the body in its prologue and epilogues and drops unreachable code.
fn finish_fn(f i64, nslots i64, pre i64) {
	let saved = vec_new()
	mut r = 19
	for r <= 27 {
		if (used_regs >> r) & 1 != 0 {
			vec_push(saved, r)
		}
		r = r + 1
	}
	r = 8
	for r <= 15 {
		if (used_fregs >> r) & 1 != 0 {
			vec_push(saved, FPR + r)
		}
		r = r + 1
	}
	let slot_bytes = align_up(8 * nslots, 16)
	let frame = 16 + slot_bytes + align_up(8 * saved[VEC_LEN], 16)
	mut j = 0
	for j < incoming_stack_loads[VEC_LEN] {
		let instruction = vec_get(incoming_stack_loads, j)
		let incoming_off = vec_get(incoming_stack_loads, j + 1)
		cg[VEC_DATA][5 * instruction + 3] = frame + incoming_off
		j = j + 2
	}
	let frameless = i64(f[F_LEAF] != 0 && nslots == 0 && saved[VEC_LEN] == 0 && incoming_stack_loads[VEC_LEN] == 0)
	if frame > MAX_FRAME {
		err_code_quoted(f[F_POS], cstr("E905 TOO_MANY_LOCALS"), cstr("function "), f[F_NAME], cstr(" has too many local variables"))
	}
	out4(I_FUNC, f, 0, 0, 0)
	j = 0
	for j < pre[VEC_LEN] {
		out4(vec_get(pre, j), vec_get(pre, j + 1), vec_get(pre, j + 2), vec_get(pre, j + 3), vec_get(pre, j + 4))
		j = j + 5
	}
	if frameless == 0 {
		if frame <= 504 {
			out4(I_STPPRE, FP, LR, -frame, 0)
		} else {
			out4(I_SUBI, SP, SP, frame, 0)
			out4(I_STP, FP, LR, SP, 0)
		}
		out4(I_ADDI, FP, SP, 0, 0)
		save_regs(saved, 16 + slot_bytes, 0)
	}
	let n = cg[VEC_LEN] / 5
	mut dead = 0
	mut i = 0
	for i < n {
		let op = vec_get(cg, 5 * i)
		if op == I_LABEL {
			dead = 0
		}
		if dead != 0 || (op == I_B && branch_to_next(i, n) != 0) {
			i = i + 1
			continue
		}
		// b.cond L1; b L2; L1:  becomes  b.!cond L2; L1:
		let t1 = cond_branch_target(5 * i)
		if t1 >= 0 && i + 1 < n && vec_get(cg, 5 * (i + 1)) == I_B && label_follows(i + 2, n, t1) != 0 {
			emit_inverted(5 * i, vec_get(cg, 5 * (i + 1) + 1))
			i = i + 2
			continue
		}
		if op == I_RET {
			if frameless == 0 {
				save_regs(saved, 16 + slot_bytes, 1)
				if frame <= 504 {
					out4(I_LDPPOST, FP, LR, frame, 0)
				} else {
					out4(I_LDP, FP, LR, SP, 0)
					out4(I_ADDI, SP, SP, frame, 0)
				}
			}
			out4(I_RETX, 0, 0, 0, 0)
			dead = 1
		} else {
			let k = 5 * i
			out4(op, vec_get(cg, k + 1), vec_get(cg, k + 2), vec_get(cg, k + 3), vec_get(cg, k + 4))
			if op == I_B {
				dead = 1
			}
		}
		i = i + 1
	}
}

fn append_dyn_slot(name i64) i64 {
	let index = prog_vars[VEC_LEN]
	let d = calloc(D_SIZE, 8)
	let s = sym_new(SYM_GLOBAL, name, 0)
	s[S_INDEX] = index
	s[S_TYPE] = ty_int
	d[D_NAME] = name
	d[D_VAL] = 0
	d[D_SYM] = s
	vec_push(prog_vars, d)
	return index
}

// dyn_layout reserves the second word of global dyn values and lays out each static
// (concrete type, shape) method table as consecutive global words.
fn dyn_layout() {
	let original = prog_vars[VEC_LEN]
	mut i = 0
	for i < original {
		let v = vec_get(prog_vars, i)
		let s = v[D_SYM]
		if s != 0 && is_dyn_value(s[S_TYPE]) != 0 && s[S_TLS] == 0 {
			mut b = buf_new()
			buf_str(b, cstr("__dyn_global_"))
			buf_int(b, i)
			buf_str(b, cstr("_table"))
			buf_byte(b, 0)
			s[S_WORDS] = append_dyn_slot(b[VEC_DATA])
		}
		i = i + 1
	}
	i = 0
	for i < dyn_tables[VEC_LEN] {
		let rec = vec_get(dyn_tables, i)
		mut b = buf_new()
		buf_str(b, cstr("__dyn_table_"))
		buf_int(b, i)
		buf_byte(b, 0)
		rec[VEC_DATA][4] = prog_vars[VEC_LEN]
		append_dyn_slot(b[VEC_DATA])
		let fs = vec_get(rec, 3)
		mut j = 0
		for j < fs[VEC_LEN] {
			b = buf_new()
			buf_str(b, cstr("__dyn_table_"))
			buf_int(b, i)
			buf_byte(b, '_')
			buf_int(b, j + 1)
			buf_byte(b, 0)
			append_dyn_slot(b[VEC_DATA])
			j = j + 1
		}
		i = i + 1
	}
}

fn generate() {
	dyn_layout()
	if tgt_x64 != 0 {
		generate_x64()
		return
	}
	code = vec_new()
	g_labels = 0
	g_str_ptrs = vec_new()
	g_str_lens = vec_new()
	g_tstr_ptrs = vec_new()
	g_tstr_lens = vec_new()
	g_loops = vec_new()
	mut i = 0
	for i < prog_fns[VEC_LEN] {
		vec_get(prog_fns, i)[F_INDEX] = i
		i = i + 1
	}
	inline_small_calls()
	i = 0
	for i < prog_fns[VEC_LEN] {
		let f = vec_get(prog_fns, i)
		if f[F_EXTERN] == 0 && f[F_REACH] != 0 {
			gen_fn(f)
		}
		i = i + 1
	}
}

// print_asm renders the program as clang-compatible assembly (tinc -S).
fn print_asm() i64 {
	let b = buf_new()
	buf_str(b, cstr("\t.section\t__TEXT,__text,regular,pure_instructions\n"))
	mut i = 0
	for i < code[VEC_LEN] {
		print_ins(b, code[VEC_DATA] + 8 * i)
		i = i + 5
	}
	if prog_vars[VEC_LEN] > 0 || prog_fns[VEC_LEN] > 0 {
		buf_str(b, cstr("\t.section\t__DATA,__data\n\t.p2align\t3\n"))
		i = 0
		for i < prog_vars[VEC_LEN] {
			let v = vec_get(prog_vars, i)
			buf_str(b, cstr("_"))
			buf_str(b, var_label(v))
			buf_str(b, cstr(":\n\t.quad "))
			buf_int(b, v[D_VAL])
			buf_byte(b, '\n')
			i = i + 1
		}
		mut di = 0
		for di < prog_fns[VEC_LEN] {
			let df = vec_get(prog_fns, di)
			if df[F_EXTERN] == 0 && df[F_REACH] != 0 {
				buf_str(b, cstr("_"))
				buf_str(b, df[F_QNAME])
				buf_str(b, cstr("$desc:\n\t.space 16\n"))
			}
			di = di + 1
		}
	}
	if g_str_ptrs[VEC_LEN] > 0 {
		buf_str(b, cstr("\t.section\t__TEXT,__cstring,cstring_literals\n"))
		i = 0
		for i < g_str_ptrs[VEC_LEN] {
			buf_str(b, cstr("l_.str."))
			buf_int(b, i)
			buf_str(b, cstr(":\n\t.asciz \""))
			asm_escape(b, vec_get(g_str_ptrs, i), vec_get(g_str_lens, i))
			buf_str(b, cstr("\"\n"))
			i = i + 1
		}
	}
	buf_str(b, cstr("\t.section\t__TEXT,__const\n\t.p2align\t3\nl_.zero:\n\t.space 32\n"))
	if g_tstr_ptrs[VEC_LEN] > 0 {
		i = 0
		for i < g_tstr_ptrs[VEC_LEN] {
			buf_str(b, cstr("\t.p2align\t3\nl_.tstr."))
			buf_int(b, i)
			buf_str(b, cstr(":\n\t.quad "))
			buf_int(b, vec_get(g_tstr_lens, i))
			buf_str(b, cstr("\n\t.asciz \""))
			asm_escape(b, vec_get(g_tstr_ptrs, i), vec_get(g_tstr_lens, i))
			buf_str(b, cstr("\"\n"))
			i = i + 1
		}
	}
	return b
}

// var_label is a global's symbol name (package-qualified).
fn var_label(v i64) i64 {
	return v[D_SYM][S_NAME]
}

// asm_escape writes bytes the assembler's string syntax can't hold as octal escapes.
fn asm_escape(b i64, s i64, n i64) {
	mut i = 0
	for i < n {
		let c = i64(load8(s + i))
		if c == '"' || c == '\\' {
			buf_byte(b, '\\')
			buf_byte(b, c)
		} else if c >= 32 && c < 127 {
			buf_byte(b, c)
		} else {
			buf_byte(b, '\\')
			buf_byte(b, '0' + ((c >> 6) & 7))
			buf_byte(b, '0' + ((c >> 3) & 7))
			buf_byte(b, '0' + (c & 7))
		}
		i = i + 1
	}
}
