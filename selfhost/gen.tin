const CTX_WORDS = 32 // runtime context words before the per-core globals (lib/runtime.tin ctxWords)

// Code generator: checked AST to the ARM64 instruction list in asm.tin.
//
// Locals whose address is never taken live in registers: callee-saved x19-x27 and
// d8-d15, or caller-saved x9-x15 and d16-d30 in leaf functions. Expressions evaluate
// into stacks of temporary registers (one per register class) indexed by depth, so
// memory is only touched by real loads and stores, values live across calls, and the
// rare expression too deep for the pool. x28 holds the thread context (like Go's g),
// x16/x17 and d31 are scratch.
const REG_SLOT = -1
const REG_DEAD = -2
const MAX_FRAME = 4095
const FPR = 64 // d0 is register 64
const FSCR = 95 // d31, float scratch

shared mut code []Fn // the whole program
shared mut cg []i64 // the current function body
shared mut g_labels i64
shared mut g_str_ptrs []str
shared mut g_str_lens []i64
shared mut g_tstr_ptrs []str // Tin string literals (length-prefixed)
shared mut g_tstr_lens []i64
shared mut g_loops []i64 // (continue, break) label pairs of the enclosing loops
shared mut g_loop_labels []str // the source label of each g_loops pair ("": none)
shared mut t_regs []i64 // integer temporaries of the current function, by depth
shared mut t_count i64
shared mut f_regs []i64 // float temporaries, by depth
shared mut f_count i64
shared mut used_regs i64 // bitmask of integer registers the current function writes
shared mut used_fregs i64 // bitmask of float registers
shared mut cur_gen_fn i64
shared mut pl i64 // gen_pair results
shared mut pr i64
shared mut cmp_cc i64 // gen_compare result
shared mut am_base i64 // gen_addr8 results
shared mut am_index i64
shared mut am_off i64
shared mut mm_base i64 // gen_mem_addr results
shared mut mm_index i64
shared mut mm_off i64
shared mut trap_label i64 // the current function's bounds-failure stub, once used
shared mut trap_sites []i64 // per failed-check site
shared mut incoming_stack_loads []i64 // pairs: instruction index in cg, incoming argument byte offset

fn emit4(op i64, a i64, b i64, c i64, d i64) {
	cg = append(cg, op)
	cg = append(cg, a)
	cg = append(cg, b)
	cg = append(cg, c)
	cg = append(cg, d)
}

fn emit3(op i64, a i64, b i64, c i64) {
	emit4(op, a, b, c, 0)
}

fn emit2(op i64, a i64, b i64) {
	emit4(op, a, b, 0, 0)
}

fn emit1(op i64, a i64) {
	emit4(op, a, 0, 0, 0)
}

fn new_label() i64 {
	g_labels = g_labels + 1
	return g_labels
}

fn label(l i64) {
	emit1(I_LABEL, l)
}

fn is_fp(r i64) i64 {
	return i64(r >= FPR)
}

fn e_fp(e Node) i64 {
	return is_float_t(e.type_)
}

// mov copies between registers of either class (across classes it moves the bits).
fn mov(dst i64, src i64) {
	if dst == src {
		return
	}
	if is_fp(dst) != 0 && is_fp(src) != 0 {
		emit2(I_FMOV, dst, src)
	} else if is_fp(dst) != 0 {
		emit2(I_FMOVDX, dst, src)
	} else if is_fp(src) != 0 {
		emit2(I_FMOVXD, dst, src)
	} else {
		emit2(I_MOV, dst, src)
	}
}

// treg is temp depth d's register. Past the pool it is register 0, as the unchecked read always was
// (the amd64 back end reaches this from x_gen_elem_addr; see issue #460).
fn treg(d i64) i64 {
	mut r = 0
	if d < len(t_regs) {
		r = t_regs[d]
	}
	used_regs = used_regs | (1 << r)
	return r
}

fn freg(d i64) i64 {
	let r = f_regs[d]
	used_fregs = used_fregs | (1 << (r - FPR))
	return r
}

// next_depth is the first free temp depth once r holds a value computed at depth d.
fn next_depth(r i64, d i64) i64 {
	if d < t_count && r == t_regs[d] {
		return d + 1
	}
	if d < f_count && r == f_regs[d] {
		return d + 1
	}
	return d
}

fn room(d i64, fp i64) i64 {
	if fp != 0 {
		return i64(d < f_count)
	}
	return i64(d < t_count)
}

// ---- expression properties ----
fn is_const(e i64) i64 {
	let k = cast(Node, e).kind
	if k == EX_INT {
		return 1
	}
	if k == EX_IDENT {
		return i64(cast(IdentExpr, e).ref != 0 && cast(Sym, cast(IdentExpr, e).ref).kind == SYM_CONST)
	}
	if k == EX_UNARY {
		if cast(Unary, e).op != "&" && e_fp(cast(Node, e)) == 0 && fold_safe(cast(Node, e)) != 0 && is_const(cast(Unary, e).x) != 0 {
			// A checked negation of the most negative value is left to panic at run time (#362).
			return i64(cast(Unary, e).ovf != OVF_CHECK || cast(Unary, e).op != "-" || const_val(cast(Unary, e).x) != -9223372036854775807 - 1)
		}
		return 0
	}
	if k == EX_BINARY {
		// A zero divisor (left by inlining) is not folded, so strict code reaches the panic.
		if (cast(Binary, e).op == "/" || cast(Binary, e).op == "%") && is_const(cast(Binary, e).r) != 0 && const_val(cast(Binary, e).r) == 0 {
			return 0
		}
		return i64(e_fp(cast(Node, cast(Binary, e).l)) == 0 && fold_safe(cast(Node, e)) != 0 && fold_safe(cast(Node, cast(Binary, e).l)) != 0 && is_const(cast(Binary, e).l) != 0 && is_const(cast(Binary, e).r) != 0 && ovf_folds(cast(Binary, e)) != 0)
	}
	return 0
}

// ovf_folds reports whether constant operation e may be folded: a checked one only when its
// result fits (inlining can leave MAX + 1 behind, which must still panic, #362).
fn ovf_folds(e Binary) i64 {
	if e.ovf != OVF_CHECK {
		return 1
	}
	let a = const_val(e.l)
	let b = const_val(e.r)
	if is_ovf_op(e.op) != 0 {
		const_exact(e.op, a, 0, b, 0)
		return i64(cx_ovf == 0 && cx_big == 0)
	}
	if e.op == "/" {
		return i64(a != -9223372036854775807 - 1 || b != -1)
	}
	if e.op == "<<" || e.op == ">>" {
		return i64(b >= 0 && b < 64)
	}
	return 1
}

// fold_safe: signed 64-bit (or untyped) arithmetic folds like the machine does it.
fn fold_safe(e Node) i64 {
	let t = cast(Ty, e.type_)
	if cast(i64, t) == 0 {
		return 1
	}
	let k = t.kind
	if k == K_BOOL {
		return 1
	}
	if k != K_INT {
		return 1
	}
	return i64(t.signed != 0 && t.width == 8)
}

fn const_val(e i64) i64 {
	let k = cast(Node, e).kind
	if k == EX_INT {
		return cast(IntLit, e).val
	}
	if k == EX_IDENT {
		return cast(Sym, cast(IdentExpr, e).ref).val
	}
	if k == EX_UNARY {
		return eval_unary(cast(Unary, e).op, const_val(cast(Unary, e).x))
	}
	return eval_binary(cast(Binary, e).op, const_val(cast(Binary, e).l), const_val(cast(Binary, e).r))
}

// may_panic reports whether binary e can panic by itself: integer / and % do unless the
// divisor is a nonzero constant, so moving them past their guards is unsafe.
fn may_panic(e Binary) i64 {
	if e.ovf == OVF_CHECK && e_fp(cast(Node, e)) == 0 {
		// A checked + - * / or shift panics on overflow (#362).
		return 1
	}
	if e_fp(cast(Node, e)) != 0 || (e.op != "/" && e.op != "%") {
		return 0
	}
	return i64(is_const(e.r) == 0 || const_val(e.r) == 0)
}

fn is_real_call(e i64) i64 {
	return i64(cast(Node, e).kind == EX_CALL && cast(Call, e).intrinsic == 0)
}

fn stmts_have_call(stmts []i64) i64 {
	mut i = 0
	for i < len(stmts) {
		if stmt_has_call(stmts[i]) != 0 {
			return 1
		}
		i = i + 1
	}
	return 0
}

fn stmt_has_call(s i64) i64 {
	if s == 0 {
		return 0
	}
	let k = cast(Node, s).kind
	if k == ST_BLOCK {
		return stmts_have_call(cast(Block, s).stmts)
	}
	if k == ST_LET {
		return contains_call(cast(LetStmt, s).init)
	}
	if k == ST_ASSIGN {
		return i64(contains_call(cast(AssignStmt, s).target) != 0 || contains_call(cast(AssignStmt, s).value) != 0)
	}
	if k == ST_EXPR {
		return contains_call(cast(ExprStmt, s).x)
	}
	if k == ST_IF {
		return i64(contains_call(cast(IfStmt, s).cond) != 0 || stmt_has_call(cast(IfStmt, s).then) != 0 || stmt_has_call(cast(IfStmt, s).else_) != 0)
	}
	if k == ST_WHILE {
		return i64(contains_call(cast(WhileStmt, s).cond) != 0 || stmt_has_call(cast(WhileStmt, s).body) != 0 || stmt_has_call(cast(WhileStmt, s).post) != 0)
	}
	if k == ST_RETURN {
		return 1
	}
	if k == ST_CALLMULTI {
		return 1
	}
	return 0
}

fn contains_call(e i64) i64 {
	if e == 0 {
		return 0
	}
	let k = cast(Node, e).kind
	if k == EX_CALL {
		if cast(Call, e).intrinsic == 0 {
			return 1
		}
		let args = cast(Call, e).args
		mut i = 0
		for i < len(args) {
			if contains_call(args[i]) != 0 {
				return 1
			}
			i = i + 1
		}
		return 0
	}
	if k == EX_UNARY {
		return contains_call(cast(Unary, e).x)
	}
	if k == EX_BINARY {
		return i64(contains_call(cast(Binary, e).l) != 0 || contains_call(cast(Binary, e).r) != 0)
	}
	if k == EX_INDEX {
		return i64(contains_call(cast(IndexExpr, e).x) != 0 || contains_call(cast(IndexExpr, e).i) != 0)
	}
	if k == EX_CONV {
		return contains_call(cast(Conv, e).x)
	}
	if k == EX_MEM {
		return i64(contains_call(cast(MemExpr, e).base) != 0 || contains_call(cast(MemExpr, e).index) != 0 || contains_call(cast(MemExpr, e).len) != 0)
	}
	if k == EX_ELEM {
		return i64(contains_call(cast(ElemExpr, e).seq) != 0 || contains_call(cast(ElemExpr, e).idx) != 0)
	}
	if k == EX_SEQ {
		return 1
	}
	return 0
}

fn has_effects(e i64) i64 {
	let k = cast(Node, e).kind
	if k == EX_CALL {
		if cast(Call, e).intrinsic == 0 || cast(Call, e).name != "load8" {
			return 1
		}
		return has_effects(cast(Call, e).args[0])
	}
	if k == EX_UNARY {
		return has_effects(cast(Unary, e).x)
	}
	if k == EX_BINARY {
		return i64(has_effects(cast(Binary, e).l) != 0 || has_effects(cast(Binary, e).r) != 0)
	}
	if k == EX_INDEX {
		return i64(has_effects(cast(IndexExpr, e).x) != 0 || has_effects(cast(IndexExpr, e).i) != 0)
	}
	if k == EX_CONV {
		return has_effects(cast(Conv, e).x)
	}
	if k == EX_MEM {
		return i64(has_effects(cast(MemExpr, e).base) != 0 || (cast(MemExpr, e).index != 0 && has_effects(cast(MemExpr, e).index) != 0))
	}
	if k == EX_ELEM {
		return i64(has_effects(cast(ElemExpr, e).seq) != 0 || has_effects(cast(ElemExpr, e).idx) != 0)
	}
	if k == EX_SEQ {
		return 1
	}
	return 0
}

// expr_equal compares effect-free expressions structurally, types included: the same tree
// at another type (a conversion's target, a constant settled by context) is another value.
fn expr_equal(a i64, b i64) i64 {
	let k = cast(Node, a).kind
	if k != cast(Node, b).kind || cast(Node, a).type_ != cast(Node, b).type_ {
		return 0
	}
	if k == EX_INT {
		return i64(cast(IntLit, a).val == cast(IntLit, b).val)
	}
	if k == EX_FLOAT {
		return i64(cast(FloatLit, a).bits == cast(FloatLit, b).bits)
	}
	if k == EX_IDENT {
		return i64(cast(IdentExpr, a).ref == cast(IdentExpr, b).ref)
	}
	if k == EX_UNARY {
		return i64(cast(Unary, a).op == cast(Unary, b).op && expr_equal(cast(Unary, a).x, cast(Unary, b).x) != 0)
	}
	if k == EX_BINARY {
		return i64(cast(Binary, a).op == cast(Binary, b).op && expr_equal(cast(Binary, a).l, cast(Binary, b).l) != 0 && expr_equal(cast(Binary, a).r, cast(Binary, b).r) != 0)
	}
	if k == EX_INDEX {
		return i64(expr_equal(cast(IndexExpr, a).x, cast(IndexExpr, b).x) != 0 && expr_equal(cast(IndexExpr, a).i, cast(IndexExpr, b).i) != 0)
	}
	if k == EX_CONV {
		return i64(cast(Conv, a).kind == cast(Conv, b).kind && expr_equal(cast(Conv, a).x, cast(Conv, b).x) != 0)
	}
	if k == EX_MEM {
		return i64(cast(MemExpr, a).off == cast(MemExpr, b).off && cast(MemExpr, a).scale == cast(MemExpr, b).scale && expr_equal(cast(MemExpr, a).base, cast(MemExpr, b).base) != 0 && opt_equal(cast(MemExpr, a).index, cast(MemExpr, b).index) != 0)
	}
	if k == EX_ELEM {
		return i64(expr_equal(cast(ElemExpr, a).seq, cast(ElemExpr, b).seq) != 0 && expr_equal(cast(ElemExpr, a).idx, cast(ElemExpr, b).idx) != 0)
	}
	return 0
}

fn opt_equal(a i64, b i64) i64 {
	if a == 0 || b == 0 {
		return i64(a == b)
	}
	return expr_equal(a, b)
}

// log2 of a positive power of two, else -1.
fn pow2_log(c i64) i64 {
	if c <= 0 || (c & (c - 1)) != 0 {
		return -1
	}
	mut k = 0
	for (1 << k) != c {
		k = k + 1
	}
	return k
}

// k when c == 2^k - 1 (k ones), else 0.
fn low_mask_bits(c i64) i64 {
	if c <= 0 || (c & (c + 1)) != 0 {
		return 0
	}
	mut k = 0
	for k < 63 && ((c >> k) & 1) != 0 {
		k = k + 1
	}
	return k
}

// ucond_code is the unsigned comparison's condition.
fn ucond_code(op str) i64 {
	if op == "<" {
		return C_LO
	}
	if op == "<=" {
		return C_LS
	}
	if op == ">" {
		return C_HI
	}
	if op == ">=" {
		return C_HS
	}
	return cond_code(op)
}

fn cond_code(op str) i64 {
	if op == "==" {
		return C_EQ
	}
	if op == "!=" {
		return C_NE
	}
	if op == "<" {
		return C_LT
	}
	if op == "<=" {
		return C_LE
	}
	if op == ">" {
		return C_GT
	}
	if op == ">=" {
		return C_GE
	}
	return -1
}

// After fcmp, MI and LS are the ordered < and <=, so NaN compares false like Go.
fn fcond_code(op str) i64 {
	if op == "==" {
		return C_EQ
	}
	if op == "!=" {
		return C_NE
	}
	if op == "<" {
		return C_MI
	}
	if op == "<=" {
		return C_LS
	}
	if op == ">" {
		return C_GT
	}
	return C_GE
}

// swap_cc is the condition for the same comparison with its operands exchanged.
fn swap_cc(cc i64) i64 {
	if cc == C_LT {
		return C_GT
	}
	if cc == C_GT {
		return C_LT
	}
	if cc == C_LE {
		return C_GE
	}
	if cc == C_GE {
		return C_LE
	}
	if cc == C_LO {
		return C_HI
	}
	if cc == C_HI {
		return C_LO
	}
	if cc == C_LS {
		return C_HS
	}
	if cc == C_HS {
		return C_LS
	}
	return cc
}

fn e_unsigned(e Node) i64 {
	return is_unsigned_t(cast(Ty, e.type_))
}

fn string_index(p str, n i64) i64 {
	mut i = 0
	for i < len(g_str_ptrs) {
		if g_str_lens[i] == n && g_str_ptrs[i][:n] == p[:n] {
			return i
		}
		i = i + 1
	}
	g_str_ptrs = append(g_str_ptrs, p)
	g_str_lens = append(g_str_lens, n)
	return i
}

fn tstring_index(p str, n i64) i64 {
	mut i = 0
	for i < len(g_tstr_ptrs) {
		if g_tstr_lens[i] == n && g_tstr_ptrs[i][:n] == p[:n] {
			return i
		}
		i = i + 1
	}
	g_tstr_ptrs = append(g_tstr_ptrs, p)
	g_tstr_lens = append(g_tstr_lens, n)
	return i
}

// ---- expressions ----
fn load_imm(dst i64, v i64) {
	if is_fp(dst) != 0 {
		if v == 0 {
			emit2(I_FMOVDX, dst, ZR)
			return
		}
		load_imm(X17, v)
		emit2(I_FMOVDX, dst, X17)
		return
	}
	if v >= 0 && v <= 65535 {
		emit3(I_MOVZ, dst, v, 0)
		return
	}
	if v < 0 && v >= -65536 {
		emit3(I_MOVN, dst, ~v, 0)
		return
	}
	mut zeros = 0
	mut ones = 0
	mut s = 0
	for s < 64 {
		let h = (v >> s) & 0xffff
		if h == 0 {
			zeros = zeros + 1
		}
		if h == 0xffff {
			ones = ones + 1
		}
		s = s + 16
	}
	// Start from all ones (movn) or all zeros (movz), whichever leaves fewer movk.
	mut fill = 0
	if ones > zeros {
		fill = 0xffff
	}
	mut first = 1
	s = 0
	for s < 64 {
		let part = (v >> s) & 0xffff
		if part != fill {
			if first != 0 && fill != 0 {
				emit3(I_MOVN, dst, ~part & 0xffff, s)
			} else if first != 0 {
				emit3(I_MOVZ, dst, part, s)
			} else {
				emit3(I_MOVK, dst, part, s)
			}
			first = 0
		}
		s = s + 16
	}
}

// gen_val returns a register holding e: a local's own register, or temp depth d.
fn gen_val(e i64, d i64) i64 {
	let k = cast(Node, e).kind
	if k == EX_REG {
		return cast(RegExpr, e).num
	}
	if k == EX_IDENT && cast(Sym, cast(IdentExpr, e).ref).kind == SYM_LOCAL && cast(Sym, cast(IdentExpr, e).ref).reg >= 0 {
		return cast(Sym, cast(IdentExpr, e).ref).reg
	}
	mut r = 0
	if e_fp(cast(Node, e)) != 0 {
		r = freg(d)
	} else {
		r = treg(d)
	}
	gen_to(e, r, d)
	return r
}

// gen_to computes e into dst using temps from depth d up; dst is written last.
fn gen_dyn_mem_address(e Node, d i64) {
	if e.kind == EX_ELEM {
		gen_elem_addr(cast(ElemExpr, e), d)
	} else {
		gen_mem_addr(cast(i64, e), d)
	}
	if mm_index >= 0 {
		emit4(I_ADD, X16, mm_base, mm_index, SH_LSL + 4)
		if mm_off != 0 {
			add_imm(X16, X16, mm_off)
		}
	} else if mm_off != 0 {
		add_imm(X16, mm_base, mm_off)
	} else {
		mov(X16, mm_base)
	}
}

// gen_dyn_pair computes a dyn value into adjacent machine registers. In storage the two
// words are contiguous; globals use an explicit second data word because each declaration
// has its own linker slot.
fn gen_dyn_pair(e i64, obj i64, tab i64, d i64) {
	let k = cast(Node, e).kind
	if k == EX_CONV && cast(Conv, e).kind == CV_DYN_OBJECT {
		mut spare = X17
		if obj == X17 {
			spare = X16
		}
		gen_dyn_pair(cast(Conv, e).x, obj, spare, d)
		return
	}
	if k == EX_CONV && cast(Conv, e).kind == CV_DYN_TABLE_WORD {
		mut spare = X16
		if tab == X16 {
			spare = X17
		}
		gen_dyn_pair(cast(Conv, e).x, spare, tab, d)
		return
	}
	if k == EX_CONV && cast(Conv, e).kind == CV_DYN_DESC {
		gen_dyn_pair(cast(Conv, e).x, X16, X17, d)
		emit3(I_LDR, obj, X17, 8 * cast(Conv, e).dyn_index)
		return
	}
	if k == EX_CONV && cast(Conv, e).kind == CV_DYN {
		gen_to(cast(Conv, e).x, obj, d)
		let rec = cast(DynTable, dyn_tables[cast(Conv, e).dyn_table])
		let sym = sym_ref(SK_VAR, rec.slot)
		emit2(I_ADRP, tab, sym)
		emit3(I_ADDLO, tab, tab, sym)
		return
	}
	if k == EX_CONV && cast(Conv, e).kind == CV_DYN_KEEP {
		gen_dyn_pair(cast(Conv, e).x, obj, tab, d)
		let done = new_label()
		emit2(I_CBZ, obj, done)
		emit1(I_PUSH, tab)
		emit3(I_LDR, X16, tab, 0)
		emit3(I_LDR, X17, X16, 0)
		mov(0, obj)
		save_temps(d)
		emit1(I_BLR, X17)
		restore_temps(d)
		emit1(I_POP, tab)
		if obj != 0 {
			mov(obj, 0)
		}
		label(done)
		return
	}
	if k == EX_SEQ {
		gen_seq(e, -1, d)
		gen_dyn_pair(cast(SeqExpr, e).value, obj, tab, d)
		return
	}
	if k == EX_CALL {
		gen_call(e, d)
		if obj != 0 {
			mov(obj, 0)
		}
		if tab != 1 {
			mov(tab, 1)
		}
		return
	}
	if k == EX_CONV && cast(Conv, e).kind == CV_SAME {
		gen_dyn_pair(cast(Conv, e).x, obj, tab, d)
		return
	}
	if k == EX_IDENT {
		let s = cast(Sym, cast(IdentExpr, e).ref)
		if s.kind == SYM_LOCAL {
			emit3(I_LDR, obj, FP, s.off)
			emit3(I_LDR, tab, FP, s.off + 8)
		} else if s.tls != 0 {
			emit3(I_LDR, obj, 28, tls_off(s))
			emit3(I_LDR, tab, 28, tls_off(s) + 8)
		} else {
			let first = sym_ref(SK_VAR, s.index)
			let second = sym_ref(SK_VAR, s.words)
			emit2(I_ADRP, X16, first)
			emit3(I_ADDLO, X16, X16, first)
			emit3(I_LDR, obj, X16, 0)
			emit2(I_ADRP, X16, second)
			emit3(I_ADDLO, X16, X16, second)
			emit3(I_LDR, tab, X16, 0)
		}
		return
	}
	if k == EX_MEM || k == EX_ELEM {
		gen_dyn_mem_address(cast(Node, e), d)
		emit3(I_LDR, obj, X16, 0)
		emit3(I_LDR, tab, X16, 8)
		return
	}
	if k == EX_INT && is_const(e) != 0 && const_val(e) == 0 {
		emit3(I_MOVZ, obj, 0, 0)
		emit3(I_MOVZ, tab, 0, 0)
		return
	}
	err_code_at(cast(Node, e).pos, "E990 INTERNAL", "unsupported dyn value location in code generation")
}

fn gen_to(e i64, dst i64, d i64) {
	let k = cast(Node, e).kind
	if k == EX_INT {
		load_imm(dst, cast(IntLit, e).val)
	} else if k == EX_FLOAT {
		load_imm(dst, cast(FloatLit, e).bits)
	} else if k == EX_STR {
		mut sym = 0
		if kind_of(cast(Ty, cast(Node, e).type_)) == K_STRING {
			sym = sym_ref(SK_TSTR, tstring_index(cast(StrLit, e).ptr, cast(StrLit, e).len))
		} else {
			sym = sym_ref(SK_STR, string_index(cast(StrLit, e).ptr, cast(StrLit, e).len))
		}
		emit2(I_ADRP, dst, sym)
		emit3(I_ADDLO, dst, dst, sym)
	} else if k == EX_IDENT {
		gen_ident(cast(IdentExpr, e), dst)
	} else if k == EX_REG {
		mov(dst, cast(RegExpr, e).num)
	} else if k == EX_UNARY {
		gen_unary(cast(Unary, e), dst, d)
	} else if k == EX_BINARY {
		gen_binary(cast(Binary, e), dst, d)
	} else if k == EX_INDEX {
		gen_index_load(cast(IndexExpr, e), dst, d)
	} else if k == EX_CONV && (cast(Conv, e).kind == CV_DYN || cast(Conv, e).kind == CV_DYN_KEEP || cast(Conv, e).kind == CV_DYN_OBJECT || cast(Conv, e).kind == CV_DYN_DESC) {
		gen_dyn_pair(e, dst, X17, d)
	} else if k == EX_CONV && cast(Conv, e).kind == CV_DYN_TABLE_WORD {
		mut spare = X16
		if dst == X16 {
			spare = X17
		}
		gen_dyn_pair(cast(Conv, e).x, spare, dst, d)
	} else if k == EX_CONV && cast(Conv, e).kind == CV_SAME && is_dyn_value(cast(Ty, cast(Node, e).type_)) != 0 {
		gen_dyn_pair(e, dst, X17, d)
	} else if k == EX_CONV {
		gen_conv(e, dst, d)
	} else if k == EX_MEM {
		if is_dyn_value(cast(Ty, cast(Node, e).type_)) != 0 {
			gen_dyn_pair(e, dst, X17, d)
		} else {
			gen_mem_load(cast(Node, e), dst, d)
		}
	} else if k == EX_ELEM {
		if is_dyn_value(cast(Ty, cast(Node, e).type_)) != 0 {
			gen_dyn_pair(e, dst, X17, d)
		} else {
			gen_elem_load(cast(Node, e), dst, d)
		}
	} else if k == EX_SEQ {
		gen_seq(e, dst, d)
	} else if k == EX_FUNCREF {
		mut kind = SK_FNDESC
		if cast(FuncRef, e).raw != 0 {
			kind = SK_FN
		}
		let fs = sym_ref(kind, cast(Fn, cast(FuncRef, e).fn_).index)
		emit2(I_ADRP, dst, fs)
		emit3(I_ADDLO, dst, dst, fs)
	} else if cast(Call, e).intrinsic != 0 {
		gen_intrinsic(cast(Call, e), dst, d)
	} else {
		gen_call(e, d)
		if is_fp(dst) != 0 {
			mov(dst, FPR)
		} else {
			mov(dst, 0)
		}
	}
}

// tls_off is a per-core global's offset from x28: the context words come first.
fn tls_off(s Sym) i64 {
	return 8 * (CTX_WORDS + s.tls - 1)
}

fn gen_ident(e IdentExpr, dst i64) {
	let s = cast(Sym, e.ref)
	let k = s.kind
	if k == SYM_LOCAL {
		if s.reg >= 0 {
			mov(dst, s.reg)
		} else if is_fp(dst) != 0 {
			emit3(I_LDRD, dst, FP, s.off)
		} else {
			emit3(I_LDR, dst, FP, s.off)
		}
	} else if k == SYM_GLOBAL && s.tls != 0 {
		if is_fp(dst) != 0 {
			emit3(I_LDRD, dst, 28, tls_off(s))
		} else {
			emit3(I_LDR, dst, 28, tls_off(s))
		}
	} else if k == SYM_GLOBAL {
		let sym = sym_ref(SK_VAR, s.index)
		if is_fp(dst) != 0 {
			emit2(I_ADRP, X17, sym)
			emit3(I_LDRLO, X17, X17, sym)
			emit2(I_FMOVDX, dst, X17)
		} else {
			emit2(I_ADRP, dst, sym)
			emit3(I_LDRLO, dst, dst, sym)
		}
	} else {
		load_imm(dst, s.val)
	}
}

// gen_pair evaluates two operands into pl and pr. pr may be x0/d0 (a call result) or
// a scratch register (a spill), so the caller must consume both right away.
fn gen_pair(lexp i64, rexp i64, d i64) {
	let l = gen_val(lexp, d)
	let d2 = next_depth(l, d)
	let rfp = e_fp(cast(Node, rexp))
	mut r = 0
	if is_real_call(rexp) != 0 {
		gen_call(rexp, d2)
		if rfp != 0 {
			r = FPR
		}
	} else if room(d2, rfp) == 0 {
		if is_fp(l) != 0 {
			emit1(I_FPUSH, l)
		} else {
			emit1(I_PUSH, l)
		}
		let rr = gen_val(rexp, d)
		if rfp != 0 {
			mov(FSCR, rr)
			r = FSCR
		} else {
			mov(X17, rr)
			r = X17
		}
		if is_fp(l) != 0 {
			emit1(I_FPOP, l)
		} else {
			emit1(I_POP, l)
		}
	} else {
		r = gen_val(rexp, d2)
	}
	pl = l
	pr = r
}

fn gen_unary(e Unary, dst i64, d i64) {
	let op = e.op
	if op == "&" {
		let s = cast(Sym, cast(IdentExpr, e.x).ref)
		if s.kind == SYM_LOCAL {
			emit3(I_ADDI, dst, FP, s.off)
		} else if s.tls != 0 {
			load_imm(X17, tls_off(s))
			emit3(I_ADD, dst, 28, X17)
		} else {
			let sym = sym_ref(SK_VAR, s.index)
			emit2(I_ADRP, dst, sym)
			emit3(I_ADDLO, dst, dst, sym)
		}
		return
	}
	if is_const(cast(i64, e)) != 0 {
		load_imm(dst, const_val(cast(i64, e)))
		return
	}
	let x = gen_val(e.x, d)
	if is_fp(dst) != 0 {
		emit2(I_FNEG, dst, x)
		return
	}
	if op == "-" && e.ovf == OVF_CHECK {
		gen_checked_neg(cast(Ty, cast(Node, e).type_), dst, x)
		return
	}
	if op == "-" {
		emit2(I_NEG, dst, x)
	} else if op == "~" {
		emit2(I_MVN, dst, x)
	} else {
		emit2(I_CMPI, x, 0)
		emit2(I_CSET, dst, C_EQ)
		return
	}
	mask_byte(cast(Node, e), dst)
}

// mask_byte keeps narrow integer results canonical: sign-extended for i8/i16/i32,
// zero-extended for u8/u16/u32, so wrapping matches the declared width.
fn mask_byte(e Node, dst i64) {
	canon(cast(Ty, e.type_), dst)
}

fn canon(t Ty, r i64) {
	if cast(i64, t) == 0 || t.kind != K_INT || t.width == 8 || is_fp(r) != 0 {
		return
	}
	if t.signed != 0 {
		emit3(I_SXT, r, r, width_log2(t.width))
	} else {
		emit3(I_ANDI, r, r, 8 * t.width)
	}
}

fn is_plain_mul(e i64) i64 {
	return i64(cast(Node, e).kind == EX_BINARY && cast(Binary, e).op == "*" && is_const(cast(Binary, e).l) == 0 && is_const(cast(Binary, e).r) == 0)
}

fn gen_binary(e Binary, dst i64, d i64) {
	if is_const(cast(i64, e)) != 0 {
		load_imm(dst, const_val(cast(i64, e)))
		return
	}
	let op = e.op
	if op == "&&" || op == "||" {
		let f = new_label()
		let end = new_label()
		gen_cond(cast(i64, e), f, d)
		emit3(I_MOVZ, dst, 1, 0)
		emit1(I_B, end)
		label(f)
		emit3(I_MOVZ, dst, 0, 0)
		label(end)
		return
	}
	if cond_code(op) >= 0 {
		gen_compare(e, d)
		emit2(I_CSET, dst, cmp_cc)
		return
	}
	if is_fp(dst) != 0 {
		gen_fbinary(e, dst, d)
		return
	}
	if e.ovf == OVF_CHECK {
		gen_checked_binary(e, dst, d)
		return
	}
	mut l = e.l
	mut r = e.r
	let comm = i64(op == "+" || op == "*" || op == "&" || op == "|" || op == "^")
	if comm != 0 && is_const(l) != 0 {
		let t = l
		l = r
		r = t
	}
	arith_unsigned = e_unsigned(cast(Node, e))
	if is_const(r) != 0 {
		let c = const_val(r)
		let lv = gen_val(l, d)
		arith_unsigned = e_unsigned(cast(Node, e))
		if arith_unsigned != 0 && gen_uconst(op, dst, lv, c) != 0 {
			mask_byte(cast(Node, e), dst)
			return
		}
		gen_binary_const(op, dst, lv, c)
		mask_byte(cast(Node, e), dst)
		return
	}
	if op == "+" && d + 3 <= t_count {
		if is_plain_mul(r) != 0 {
			gen_madd(dst, l, cast(Binary, r), d, I_MADD)
			mask_byte(cast(Node, e), dst)
			return
		}
		if is_plain_mul(l) != 0 && has_effects(l) == 0 && has_effects(r) == 0 {
			gen_madd(dst, r, cast(Binary, l), d, I_MADD)
			mask_byte(cast(Node, e), dst)
			return
		}
	}
	gen_pair(l, r, d)
	arith_unsigned = e_unsigned(cast(Node, e))
	emit_arith(op, dst, pl, pr)
	mask_byte(cast(Node, e), dst)
}

// gen_uconst handles unsigned division, modulo and right shift by constants.
fn gen_uconst(op str, dst i64, l i64, c i64) i64 {
	let k = pow2_log(c)
	if op == "/" && k >= 0 {
		emit3(I_LSRI, dst, l, k)
		return 1
	}
	if op == "%" && k > 0 {
		emit3(I_ANDI, dst, l, k)
		return 1
	}
	if op == ">>" {
		emit3(I_LSRI, dst, l, c & 63)
		return 1
	}
	if op == "/" || op == "%" {
		load_imm(X17, c)
		emit_arith(op, dst, l, X17)
		return 1
	}
	return 0
}

fn gen_fbinary(e Binary, dst i64, d i64) {
	let op = e.op
	let l = e.l
	let r = e.r
	if d + 3 <= f_count && (op == "+" || op == "-") {
		if is_fmul(r) != 0 {
			if op == "+" {
				gen_madd(dst, l, cast(Binary, r), d, I_FMADD)
			} else {
				gen_madd(dst, l, cast(Binary, r), d, I_FMSUB)
			}
			return
		}
		if op == "+" && is_fmul(l) != 0 && has_effects(l) == 0 && has_effects(r) == 0 {
			gen_madd(dst, r, cast(Binary, l), d, I_FMADD)
			return
		}
	}
	gen_pair(l, r, d)
	mut ins = I_FADD
	if op == "-" {
		ins = I_FSUB
	} else if op == "*" {
		ins = I_FMUL
	} else if op == "/" {
		ins = I_FDIV
	}
	emit3(ins, dst, pl, pr)
}

fn is_fmul(e i64) i64 {
	return i64(cast(Node, e).kind == EX_BINARY && cast(Binary, e).op == "*" && e_fp(cast(Node, e)) != 0)
}

fn gen_madd(dst i64, addend i64, m Binary, d i64, ins i64) {
	let a = gen_val(addend, d)
	gen_pair(m.l, m.r, next_depth(a, d))
	emit4(ins, dst, pl, pr, a)
}

shared mut arith_unsigned i64
shared mut div_label i64 // the current function's divide-by-zero stub, once used

// div_check panics on a zero divisor in strict code (the hardware would return 0).
fn div_check(b i64) {
	if cast(Fn, cur_gen_fn).generated != 0 {
		return
	}
	if div_label == 0 {
		div_label = new_label()
	}
	emit2(I_CBZ, b, div_label)
}

// ---- checked integer arithmetic (#362) ----
// Each kind of failed check jumps to one cold stub per function that calls rt_overflow_fail(kind).
const OVK_ADD = 0
const OVK_SUB = 1
const OVK_MUL = 2
const OVK_NEG = 3
const OVK_DIV = 4
const OVK_SHIFT = 5
const OVK_CONV = 6
const OVK_COUNT = 7

shared mut ovf_labels []i64 // the current function's stub label per OVK_* kind, 0 until used

// ovf_stub is the label of the current function's cold stub for check kind k.
fn ovf_stub(k i64) i64 {
	if ovf_labels[k] == 0 {
		ovf_labels[k] = new_label()
	}
	return ovf_labels[k]
}

// ovf_kind is the OVK_* kind of operator op.
fn ovf_kind(op str) i64 {
	if op == "+" {
		return OVK_ADD
	}
	if op == "-" {
		return OVK_SUB
	}
	if op == "*" {
		return OVK_MUL
	}
	if op == "/" {
		return OVK_DIV
	}
	return OVK_SHIFT
}

// int_width is the byte width of integer type t (8 when t is untyped).
fn int_width(t Ty) i64 {
	if cast(i64, t) == 0 || t.kind != K_INT {
		return 8
	}
	return t.width
}

// narrow_check branches to the stub of kind k unless r, the exact 64-bit result of an operation
// on a narrow type, fits t; a result that fits is already canonical.
fn narrow_check(t Ty, r i64, k i64) {
	if t.signed != 0 {
		emit3(I_SXT, X16, r, width_log2(t.width))
		emit2(I_CMP, X16, r)
		emit2(I_BCOND, C_NE, ovf_stub(k))
	} else {
		emit3(I_LSRI, X16, r, 8 * t.width)
		emit2(I_CBNZ, X16, ovf_stub(k))
	}
}

// gen_checked_neg is dst = -x, panicking when the negation does not fit t.
fn gen_checked_neg(t Ty, dst i64, x i64) {
	if int_width(t) != 8 {
		emit2(I_NEG, dst, x)
		narrow_check(t, dst, OVK_NEG)
		return
	}
	emit4(I_SUBS, dst, ZR, x, 0)
	if t.signed != 0 {
		emit2(I_BCOND, C_VS, ovf_stub(OVK_NEG))
	} else {
		// 0 - x borrows for every x but 0.
		emit2(I_BCOND, C_LO, ovf_stub(OVK_NEG))
	}
}

// checked_rr is dst = a op b for + - * on registers, panicking on overflow of type t.
fn checked_rr(op str, dst i64, a i64, b i64, t Ty) {
	let k = ovf_kind(op)
	if int_width(t) != 8 {
		// Narrow operands are canonical, so the 64-bit result is exact: check its range.
		emit_arith(op, dst, a, b)
		narrow_check(t, dst, k)
		return
	}
	let signed = i64(cast(i64, t) == 0 || t.signed != 0)
	if k == OVK_MUL {
		if signed != 0 {
			emit3(I_SMULH, X16, a, b)
			emit3(I_MUL, dst, a, b)
			// The product fits when its high half is the sign of its low half.
			emit4(I_SUBS, ZR, X16, dst, SH_ASR + 63)
			emit2(I_BCOND, C_NE, ovf_stub(k))
		} else {
			emit3(I_UMULH, X16, a, b)
			emit3(I_MUL, dst, a, b)
			emit2(I_CBNZ, X16, ovf_stub(k))
		}
		return
	}
	if k == OVK_ADD {
		emit4(I_ADDS, dst, a, b, 0)
	} else {
		emit4(I_SUBS, dst, a, b, 0)
	}
	checked_flags(k, signed)
}

// checked_flags branches to the stub after adds/subs: on V for signed, on carry (add) or
// borrow (sub) for unsigned.
fn checked_flags(k i64, signed i64) {
	if signed != 0 {
		emit2(I_BCOND, C_VS, ovf_stub(k))
	} else if k == OVK_ADD {
		emit2(I_BCOND, C_HS, ovf_stub(k))
	} else {
		emit2(I_BCOND, C_LO, ovf_stub(k))
	}
}

// checked_const is dst = l op c for + - * with a constant, panicking on overflow of type t.
fn checked_const(op str, dst i64, l i64, c i64, t Ty) {
	let k = ovf_kind(op)
	if int_width(t) != 8 {
		gen_binary_const(op, dst, l, c)
		narrow_check(t, dst, k)
		return
	}
	let signed = i64(cast(i64, t) == 0 || t.signed != 0)
	if k == OVK_MUL {
		let p = pow2_log(c)
		if c == 0 {
			emit3(I_MOVZ, dst, 0, 0)
		} else if c == 1 {
			mov(dst, l)
		} else if c == -1 && signed != 0 {
			gen_checked_neg(t, dst, l)
		} else if p > 0 && c > 0 && signed != 0 {
			// l << p keeps every bit when shifting back gives l again.
			emit3(I_LSLI, X16, l, p)
			emit3(I_ASRI, X17, X16, p)
			emit2(I_CMP, X17, l)
			emit2(I_BCOND, C_NE, ovf_stub(k))
			mov(dst, X16)
		} else if p > 0 && c > 0 {
			emit3(I_LSRI, X16, l, 64 - p)
			emit2(I_CBNZ, X16, ovf_stub(k))
			emit3(I_LSLI, dst, l, p)
		} else {
			load_imm(X17, c)
			checked_rr(op, dst, l, X17, t)
		}
		return
	}
	if c == 0 {
		mov(dst, l)
		return
	}
	mut ins = I_ADDSI
	mut m = c
	if k == OVK_SUB {
		ins = I_SUBSI
	}
	if signed != 0 && c < 0 && c > -4096 {
		// x + (-5) is x - 5 and sets V the same way.
		m = -c
		if ins == I_ADDSI {
			ins = I_SUBSI
		} else {
			ins = I_ADDSI
		}
	}
	if m > 0 && m < 4096 {
		emit3(ins, dst, l, m)
		checked_flags(k, signed)
		return
	}
	load_imm(X17, c)
	checked_rr(op, dst, l, X17, t)
}

// gen_checked_binary generates a binary operation the checker marked OVF_CHECK: + - * that
// panic on overflow, signed / that panics on the most negative value / -1, and shifts whose
// count must be below the width.
fn gen_checked_binary(e Binary, dst i64, d i64) {
	let op = e.op
	let t = cast(Ty, cast(Node, e).type_)
	mut l = e.l
	mut r = e.r
	arith_unsigned = e_unsigned(cast(Node, e))
	if op == "<<" || op == ">>" {
		let bits = 8 * int_width(t)
		if is_const(r) != 0 {
			let c = const_val(r)
			if c < 0 || c >= bits {
				let lv = gen_val(l, d)
				emit1(I_B, ovf_stub(OVK_SHIFT))
				mov(dst, lv)
				return
			}
			let lv = gen_val(l, d)
			if arith_unsigned != 0 && gen_uconst(op, dst, lv, c) != 0 {
				mask_byte(cast(Node, e), dst)
				return
			}
			gen_binary_const(op, dst, lv, c)
			mask_byte(cast(Node, e), dst)
			return
		}
		gen_pair(l, r, d)
		arith_unsigned = e_unsigned(cast(Node, e))
		// One unsigned compare rejects negative counts too.
		emit2(I_CMPI, pr, bits)
		emit2(I_BCOND, C_HS, ovf_stub(OVK_SHIFT))
		emit_arith(op, dst, pl, pr)
		mask_byte(cast(Node, e), dst)
		return
	}
	if op == "/" {
		if is_const(r) != 0 && const_val(r) != -1 {
			let lv = gen_val(l, d)
			gen_binary_const(op, dst, lv, const_val(r))
			mask_byte(cast(Node, e), dst)
			return
		}
		gen_pair(l, r, d)
		arith_unsigned = e_unsigned(cast(Node, e))
		if int_width(t) == 8 {
			// Only the most negative value / -1 overflows: -l overflows exactly for that l.
			let ok = new_label()
			emit2(I_CMNI, pr, 1)
			emit2(I_BCOND, C_NE, ok)
			emit4(I_SUBS, ZR, ZR, pl, 0)
			emit2(I_BCOND, C_VS, ovf_stub(OVK_DIV))
			label(ok)
			emit_arith(op, dst, pl, pr)
			return
		}
		emit_arith(op, dst, pl, pr)
		narrow_check(t, dst, OVK_DIV)
		return
	}
	if (op == "+" || op == "*") && is_const(l) != 0 {
		let tmp = l
		l = r
		r = tmp
	}
	if is_const(r) != 0 {
		let lv = gen_val(l, d)
		checked_const(op, dst, lv, const_val(r), t)
		return
	}
	gen_pair(l, r, d)
	checked_rr(op, dst, pl, pr, t)
}

// f2i_check branches to the conversion stub unless float v truncates to a value of 64-bit range
// (-2^63 .. 2^63 for signed t, -1 .. 2^64 exclusive for unsigned t); NaN fails both compares.
fn f2i_check(t Ty, v i64) {
	if is_unsigned_t(t) != 0 {
		emit3(I_MOVZ, X17, 0x43f0, 48)
		emit2(I_FMOVDX, FSCR, X17)
		emit2(I_FCMP, v, FSCR)
		emit2(I_BCOND, C_PL, ovf_stub(OVK_CONV))
		emit3(I_MOVZ, X17, 0xbff0, 48)
		emit2(I_FMOVDX, FSCR, X17)
		emit2(I_FCMP, v, FSCR)
		emit2(I_BCOND, C_LE, ovf_stub(OVK_CONV))
		return
	}
	emit3(I_MOVZ, X17, 0x43e0, 48)
	emit2(I_FMOVDX, FSCR, X17)
	emit2(I_FCMP, v, FSCR)
	emit2(I_BCOND, C_PL, ovf_stub(OVK_CONV))
	emit3(I_MOVZ, X17, 0xc3e0, 48)
	emit2(I_FMOVDX, FSCR, X17)
	emit2(I_FCMP, v, FSCR)
	emit2(I_BCOND, C_MI, ovf_stub(OVK_CONV))
}

// gen_ovf_stubs emits the current function's cold overflow stubs: rt_overflow_fail(kind).
fn gen_ovf_stubs() {
	let of = find_fn("rt_overflow_fail")
	mut k = 0
	for k < OVK_COUNT {
		if ovf_labels[k] != 0 {
			label(ovf_labels[k])
			emit3(I_MOVZ, 0, k, 0)
			if cast(i64, of) != 0 {
				emit1(I_BL, cast(i64, of))
				of.used = 1
			}
		}
		k = k + 1
	}
}

fn emit_arith(op str, dst i64, a i64, b i64) {
	if op == "/" || op == "%" {
		div_check(b)
	}
	if arith_unsigned != 0 && op == "/" {
		emit3(I_UDIV, dst, a, b)
		return
	}
	if arith_unsigned != 0 && op == "%" {
		emit3(I_UDIV, X16, a, b)
		emit4(I_MSUB, dst, X16, b, a)
		return
	}
	if arith_unsigned != 0 && op == ">>" {
		emit3(I_LSRV, dst, a, b)
		return
	}
	if op == "+" {
		emit4(I_ADD, dst, a, b, 0)
	} else if op == "-" {
		emit4(I_SUB, dst, a, b, 0)
	} else if op == "*" {
		emit3(I_MUL, dst, a, b)
	} else if op == "/" {
		emit3(I_SDIV, dst, a, b)
	} else if op == "%" {
		emit3(I_SDIV, X16, a, b)
		emit4(I_MSUB, dst, X16, b, a)
	} else if op == "&" {
		emit4(I_AND, dst, a, b, 0)
	} else if op == "|" {
		emit4(I_ORR, dst, a, b, 0)
	} else if op == "^" {
		emit4(I_EOR, dst, a, b, 0)
	} else if op == "<<" {
		emit3(I_LSLV, dst, a, b)
	} else {
		emit3(I_ASRV, dst, a, b)
	}
}

fn add_imm(dst i64, l i64, c i64) {
	if c >= 0 && c < 4096 {
		emit3(I_ADDI, dst, l, c)
	} else if c < 0 && c > -4096 {
		emit3(I_SUBI, dst, l, -c)
	} else {
		load_imm(X17, c)
		emit4(I_ADD, dst, l, X17, 0)
	}
}

// round_bias leaves l + (2^k - 1 if l < 0) in x17, so an arithmetic shift by k
// rounds toward zero the way sdiv does.
fn round_bias(l i64, k i64) {
	if k == 1 {
		emit4(I_ADD, X17, l, l, SH_LSR + 63)
		return
	}
	emit3(I_ASRI, X17, l, 63)
	emit4(I_ADD, X17, l, X17, SH_LSR + 64 - k)
}

fn gen_binary_const(op str, dst i64, l i64, c i64) {
	if op == "+" {
		add_imm(dst, l, c)
	} else if op == "-" && c != -9223372036854775807 - 1 {
		add_imm(dst, l, -c)
	} else if op == "*" {
		let k = pow2_log(c)
		if c == 0 {
			emit3(I_MOVZ, dst, 0, 0)
		} else if c == 1 {
			mov(dst, l)
		} else if c == -1 {
			emit2(I_NEG, dst, l)
		} else if k >= 0 {
			emit3(I_LSLI, dst, l, k)
		} else if c > 2 && pow2_log(c - 1) >= 0 {
			emit4(I_ADD, dst, l, l, SH_LSL + pow2_log(c - 1))
		} else if c > 2 && pow2_log(c + 1) >= 0 {
			emit3(I_LSLI, X17, l, pow2_log(c + 1))
			emit4(I_SUB, dst, X17, l, 0)
		} else {
			load_imm(X17, c)
			emit3(I_MUL, dst, l, X17)
		}
	} else if op == "/" {
		let k = pow2_log(c)
		if c == 1 {
			mov(dst, l)
		} else if c == -1 {
			emit2(I_NEG, dst, l)
		} else if c == 0 && cast(Fn, cur_gen_fn).generated == 0 {
			div_check(ZR)
		} else if c == 0 {
			// sdiv by zero yields zero.
			emit3(I_MOVZ, dst, 0, 0)
		} else if k > 0 {
			round_bias(l, k)
			emit3(I_ASRI, dst, X17, k)
		} else {
			load_imm(X17, c)
			emit3(I_SDIV, dst, l, X17)
		}
	} else if op == "%" {
		mut m = c
		if m < 0 && m != -9223372036854775807 - 1 {
			m = -m
		}
		let k = pow2_log(m)
		if m == 1 {
			emit3(I_MOVZ, dst, 0, 0)
		} else if c == 0 && cast(Fn, cur_gen_fn).generated == 0 {
			div_check(ZR)
		} else if c == 0 {
			// x - (x / 0) * 0 == x
			mov(dst, l)
		} else if k > 0 {
			round_bias(l, k)
			emit3(I_ASRI, X17, X17, k)
			emit4(I_SUB, dst, l, X17, SH_LSL + k)
		} else {
			load_imm(X17, c)
			emit3(I_SDIV, X16, l, X17)
			emit4(I_MSUB, dst, X16, X17, l)
		}
	} else if op == "<<" {
		emit3(I_LSLI, dst, l, c & 63)
	} else if op == ">>" {
		emit3(I_ASRI, dst, l, c & 63)
	} else if op == "&" && low_mask_bits(c) > 0 {
		emit3(I_ANDI, dst, l, low_mask_bits(c))
	} else if (op == "|" || op == "^") && c == 0 {
		mov(dst, l)
	} else {
		load_imm(X17, c)
		emit_arith(op, dst, l, X17)
	}
}

// gen_compare sets the flags for comparison e and leaves its condition in cmp_cc.
fn gen_compare(e Binary, d i64) {
	mut l = e.l
	mut r = e.r
	if e_fp(cast(Node, l)) != 0 || e_fp(cast(Node, r)) != 0 {
		gen_pair(l, r, d)
		emit2(I_FCMP, pl, pr)
		cmp_cc = fcond_code(e.op)
		return
	}
	mut cc = cond_code(e.op)
	if e_unsigned(cast(Node, l)) != 0 || e_unsigned(cast(Node, r)) != 0 {
		cc = ucond_code(e.op)
	}
	if is_const(l) != 0 {
		let t = l
		l = r
		r = t
		cc = swap_cc(cc)
	}
	if is_const(r) != 0 {
		let c = const_val(r)
		let a = gen_val(l, d)
		if c >= 0 && c < 4096 {
			emit2(I_CMPI, a, c)
		} else if c < 0 && c > -4096 {
			emit2(I_CMNI, a, -c)
		} else {
			load_imm(X17, c)
			emit2(I_CMP, a, X17)
		}
	} else {
		gen_pair(l, r, d)
		emit2(I_CMP, pl, pr)
	}
	cmp_cc = cc
}

fn gen_index_load(e IndexExpr, dst i64, d i64) {
	let ix = e.i
	let fpl = is_fp(dst)
	if is_const(ix) != 0 && const_val(ix) >= 0 && const_val(ix) < 4096 {
		let off = const_val(ix) * 8
		let base = gen_val(e.x, d)
		if fpl != 0 {
			emit3(I_LDRD, dst, base, off)
		} else {
			emit3(I_LDR, dst, base, off)
		}
		return
	}
	gen_pair(e.x, ix, d)
	if fpl != 0 {
		emit3(I_LDRDX, dst, pl, pr)
	} else {
		emit3(I_LDRX, dst, pl, pr)
	}
}

fn gen_conv(e i64, dst i64, d i64) {
	let k = cast(Conv, e).kind
	let x = cast(Node, cast(Conv, e).x)
	if k == CV_LEN || k == CV_CAP {
		// Header word 0 (len) or 1 (cap); a nil string, slice or map has length 0.
		let p = gen_val(cast(i64, x), d)
		mov(dst, p)
		let skip = new_label()
		emit2(I_CBZ, dst, skip)
		emit3(I_LDR, dst, dst, 8 * i64((k == CV_CAP)))
		label(skip)
		return
	}
	let v = gen_val(cast(i64, x), d)
	if k == CV_ROUND32 {
		emit2(I_FCVTSD, dst, v)
		emit2(I_FCVTDS, dst, dst)
		return
	}
	if k == CV_F2BITS32 {
		emit2(I_FCVTSD, FPR + 31, v)
		emit2(I_FMOVWS, dst, FPR + 31)
		return
	}
	if k == CV_I2F {
		if is_unsigned_t(cast(Ty, x.type_)) != 0 && cast(Ty, x.type_).width == 8 {
			emit2(I_UCVTF, dst, v)
		} else {
			emit2(I_SCVTF, dst, v)
		}
	} else if k == CV_F2I {
		let ft = cast(Ty, cast(Node, e).type_)
		if cast(Conv, e).ovf == OVF_CHECK {
			f2i_check(ft, v)
		}
		if is_unsigned_t(ft) != 0 {
			emit2(I_FCVTZU, dst, v)
		} else {
			emit2(I_FCVTZS, dst, v)
		}
		if cast(Conv, e).ovf == OVF_CHECK && int_width(ft) != 8 {
			narrow_check(ft, dst, OVK_CONV)
		} else {
			canon(ft, dst)
		}
	} else if k == CV_TOBYTE {
		emit3(I_ANDI, dst, v, 8)
	} else if k == CV_INT {
		// Values are kept canonical, so widening is free; narrowing re-canonicalizes.
		mov(dst, v)
		if type_width(cast(Ty, cast(Node, e).type_)) < type_width(cast(Ty, x.type_)) || is_unsigned_t(cast(Ty, cast(Node, e).type_)) != is_unsigned_t(cast(Ty, x.type_)) {
			canon(cast(Ty, cast(Node, e).type_), dst)
		}
	} else {
		mov(dst, v)
	}
}

// ---- sized memory ----
fn mem_kind(t Ty) i64 {
	if is_f32(t) != 0 {
		return 2 | MK_FLOAT
	}
	if is_float_t(cast(i64, t)) != 0 {
		return 3 | MK_FLOAT
	}
	let w = type_width(t)
	mut k = width_log2(w)
	if w < 8 && t.kind == K_INT && t.signed != 0 {
		k = k | MK_SIGNED
	}
	return k
}

// gen_mem_addr evaluates an EX_MEM address into mm_base plus mm_index (scaled to the
// access size) or plus the byte offset mm_off. Registers may be x16 (scratch), so the
// caller must use them at once.
fn gen_mem_addr(e i64, d i64) {
	let size = type_width(cast(Ty, cast(Node, e).type_))
	mut base = gen_val(cast(MemExpr, e).base, d)
	mut off = cast(MemExpr, e).off
	mut ix = cast(MemExpr, e).index
	let scale = cast(MemExpr, e).scale
	// A checked constant index stays in a register for its bounds check.
	if ix != 0 && is_const(ix) != 0 && cast(MemExpr, e).len == 0 {
		off = off + const_val(ix) * scale
		ix = 0
	}
	if ix != 0 {
		let idx = gen_val(ix, next_depth(base, d))
		if cast(MemExpr, e).len != 0 {
			bounds_check(idx, cast(MemExpr, e).len, next_depth(idx, next_depth(base, d)))
		}
		if off == 0 && scale == size {
			mm_base = base
			mm_index = idx
			mm_off = 0
			return
		}
		emit4(I_ADD, X16, base, idx, SH_LSL + width_log2(scale))
		base = X16
	}
	if off >= 0 && off % size == 0 && off / size < 4096 {
		mm_base = base
		mm_index = -1
		mm_off = off
		return
	}
	add_imm(X16, base, off)
	mm_base = X16
	mm_index = -1
	mm_off = 0
}

fn emit_load(dst i64, t i64) {
	let kind = mem_kind(cast(Ty, t))
	if mm_index >= 0 {
		emit4(I_LDX, dst, mm_base, mm_index, kind | MK_SCALED)
	} else {
		emit4(I_LD, dst, mm_base, mm_off, kind)
	}
	if is_f32(cast(Ty, t)) != 0 && is_fp(dst) != 0 {
		// An f32 lives in registers as the f64 with the same value.
		emit2(I_FCVTDS, dst, dst)
	}
}

fn emit_store(v_in i64, t i64) {
	mut v = v_in
	let kind = mem_kind(cast(Ty, t))
	if is_f32(cast(Ty, t)) != 0 && is_fp(v) != 0 {
		emit2(I_FCVTSD, FPR + 31, v)
		v = FPR + 31
	}
	if mm_index >= 0 {
		emit4(I_STX, v, mm_base, mm_index, kind | MK_SCALED)
	} else {
		emit4(I_ST, v, mm_base, mm_off, kind)
	}
}

fn gen_mem_load(e Node, dst i64, d i64) {
	gen_mem_addr(cast(i64, e), d)
	emit_load(dst, e.type_)
}

// bounds_check traps unless idx is below the length expression (an unsigned compare
// also catches negative indexes).
fn bounds_check(idx i64, lenexpr i64, d i64) {
	mut lr = 0
	if cast(Node, lenexpr).kind == EX_IDENT && cast(Sym, cast(IdentExpr, lenexpr).ref).kind == SYM_LOCAL && cast(Sym, cast(IdentExpr, lenexpr).ref).reg >= 0 {
		lr = cast(Sym, cast(IdentExpr, lenexpr).ref).reg
	} else {
		gen_to(lenexpr, X17, d)
		lr = X17
	}
	emit2(I_CMP, idx, lr)
	emit2(I_BCOND, C_HS, trap_at(idx, lr, 0))
}

fn get_trap() i64 {
	if trap_label == 0 {
		trap_label = new_label()
	}
	return trap_label
}

// trap_at is a cold stub for one bounds check that reports its index and length.
fn trap_at(idx i64, len_ i64, cidx i64) i64 {
	let l = new_label()
	let site = cast(TrapSite, calloc(4, 8))
	site.label = l
	site.index_reg = idx
	site.len_reg = len_
	site.const_index = cidx
	trap_sites = append(trap_sites, cast(i64, site))
	return l
}

// gen_elem_addr evaluates a slice or string element address (with its bounds check)
// into mm_base/mm_index/mm_off.
fn gen_elem_addr(e ElemExpr, d i64) {
	let h = gen_val(e.seq, d)
	let d1 = next_depth(h, d)
	let size = e.size
	let ix = e.idx
	mut first = 16
	if e.str != 0 {
		first = 8
	}
	if is_const(ix) != 0 {
		let c = const_val(ix)
		if e.safe == 0 {
			emit4(I_LD, X17, h, 0, 3)
			if c >= 0 && c < 4096 {
				emit2(I_CMPI, X17, c)
			} else {
				load_imm(X16, c)
				emit2(I_CMP, X17, X16)
			}
			emit2(I_BCOND, C_LS, trap_at(-1, X17, c))
		}
		if e.str != 0 {
			mm_base = h
			mm_off = first + c * size
		} else {
			emit4(I_LD, X16, h, 16, 3)
			mm_base = X16
			mm_off = c * size
		}
		mm_index = -1
		if mm_off < 0 || mm_off / size >= 4096 {
			add_imm(X16, mm_base, mm_off)
			mm_base = X16
			mm_off = 0
		}
		return
	}
	let idx = gen_val(ix, d1)
	if e.safe == 0 {
		emit4(I_LD, X17, h, 0, 3)
		emit2(I_CMP, idx, X17)
		emit2(I_BCOND, C_HS, trap_at(idx, X17, 0))
	}
	if e.str != 0 {
		emit3(I_ADDI, X16, h, 8)
	} else {
		emit4(I_LD, X16, h, 16, 3)
	}
	mm_base = X16
	mm_index = idx
	mm_off = 0
}

fn gen_elem_load(e Node, dst i64, d i64) {
	gen_elem_addr(cast(ElemExpr, e), d)
	emit_load(dst, e.type_)
}

// gen_seq runs a checker-made statement list, then computes its value. The statements
// use temps from depth 0, so live temps below d are saved around them.
fn gen_seq(e i64, dst i64, d i64) {
	mut i = 0
	for i < d {
		if i < t_count {
			emit1(I_PUSH, t_regs[i])
		}
		if i < f_count {
			emit1(I_FPUSH, f_regs[i])
		}
		i = i + 1
	}
	gen_stmts(cast(SeqExpr, e).stmts)
	i = d - 1
	for i >= 0 {
		if i < f_count {
			emit1(I_FPOP, f_regs[i])
		}
		if i < t_count {
			emit1(I_POP, t_regs[i])
		}
		i = i - 1
	}
	let v = cast(SeqExpr, e).value
	if dst >= 0 && kind_of(cast(Ty, cast(Node, e).type_)) != K_VOID {
		gen_to(v, dst, d)
	} else {
		gen_effect(v)
	}
}

// gen_addr8 picks a byte address mode for p: am_base plus am_index, or plus am_off.
fn gen_addr8(p i64, d i64) {
	if cast(Node, p).kind == EX_BINARY && cast(Binary, p).op == "+" {
		let r = cast(Binary, p).r
		if is_const(r) != 0 && const_val(r) >= 0 && const_val(r) < 4096 {
			let c = const_val(r)
			am_base = gen_val(cast(Binary, p).l, d)
			am_index = -1
			am_off = c
			return
		}
		gen_pair(cast(Binary, p).l, r, d)
		am_base = pl
		am_index = pr
		return
	}
	am_base = gen_val(p, d)
	am_index = -1
	am_off = 0
}

fn float_intrinsic_op(name str) i64 {
	if i64(byte_at(name, 0)) != '_' || i64(byte_at(name, 1)) != '_' || i64(byte_at(name, 2)) != 'f' {
		return 0
	}
	if name == "__fsqrt" {
		return I_FSQRT
	}
	if name == "__fabs" {
		return I_FABS
	}
	if name == "__frintm" {
		return I_FRINTM
	}
	if name == "__frintp" {
		return I_FRINTP
	}
	if name == "__frintz" {
		return I_FRINTZ
	}
	if name == "__frinta" {
		return I_FRINTA
	}
	if name == "__frintn" {
		return I_FRINTN
	}
	return 0
}

fn gen_intrinsic(e Call, dst i64, d i64) {
	let name = e.name
	if name == "__prefetchw" {
		gen_pair(e.args[0], e.args[1], d)
		emit3(I_PRFM, 16, pl, pr)
		return
	}
	if name == "load8" {
		gen_addr8(e.args[0], d)
		if am_index < 0 {
			emit3(I_LDRB, dst, am_base, am_off)
		} else {
			emit3(I_LDRBX, dst, am_base, am_index)
		}
		return
	}
	if gen_runtime_intrinsic(e, dst, d) != 0 {
		return
	}
	gen_store8(e, dst, d)
}

// Runtime intrinsics: the thread context register and atomics for lib/runtime.tin.
fn gen_runtime_intrinsic(e Call, dst i64, d i64) i64 {
	let name = e.name
	let args = e.args
	if name == "__ctx" {
		mov(dst, 28)
		return 1
	}
	if name == "__fp" {
		mov(dst, FP)
		return 1
	}
	let fop = float_intrinsic_op(name)
	if fop != 0 {
		let fx = gen_val(args[0], d)
		emit2(fop, dst, fx)
		return 1
	}
	if name == "__st" {
		// __st(p, v, sizelog2): a raw sized store for the runtime.
		gen_pair(args[0], args[1], d)
		emit4(I_ST, pr, pl, 0, const_val(args[2]))
		return 1
	}
	if name == "__ld" {
		let p = gen_val(args[0], d)
		let k = args[1]
		if is_const(k) != 0 {
			emit4(I_LD, dst, p, 0, const_val(k))
		} else {
			emit4(I_LD, dst, p, 0, 3)
		}
		return 1
	}
	if name == "__tin_symbols" || name == "__image_base" {
		mut kind = SK_BTRACE
		if name == "__image_base" {
			kind = SK_IMAGE
		}
		let symbol = sym_ref(kind, 0)
		emit2(I_ADRP, dst, symbol)
		emit3(I_ADDLO, dst, dst, symbol)
		return 1
	}
	if name == "__empty" {
		let z = sym_ref(SK_ZERO, 0)
		emit2(I_ADRP, dst, z)
		emit3(I_ADDLO, dst, dst, z)
		return 1
	}
	if name == "__set_ctx" {
		gen_to(args[0], 28, d)
		return 1
	}
	if name == "__atomic_add" {
		// Returns the old value: ldaddal adds v to [p] atomically.
		gen_pair(args[0], args[1], d)
		emit3(I_LDADDAL, pr, X17, pl)
		if dst >= 0 {
			mov(dst, X17)
		}
		return 1
	}
	if name == "__atomic_cas" {
		// __atomic_cas(p, old, new) returns the value found at p.
		let p = gen_val(args[0], d)
		let d1 = next_depth(p, d)
		let o = gen_val(args[1], d1)
		let d2 = next_depth(o, d1)
		let n = gen_val(args[2], d2)
		mov(X17, o)
		emit3(I_CASAL, X17, n, p)
		if dst >= 0 {
			mov(dst, X17)
		}
		return 1
	}
	if name == "__atomic_swap" {
		gen_pair(args[0], args[1], d)
		emit3(I_SWPAL, pr, X17, pl)
		if dst >= 0 {
			mov(dst, X17)
		}
		return 1
	}
	if name == "__atomic_load" {
		let p = gen_val(args[0], d)
		emit2(I_LDAR, dst, p)
		return 1
	}
	if name == "__atomic_store" {
		gen_pair(args[0], args[1], d)
		emit2(I_STLR, pr, pl)
		return 1
	}
	if name == "__yield" {
		emit1(I_YIELD, 0)
		return 1
	}
	if name == "__mulhu" {
		// __mulhu(a, b): the high 64 bits of the unsigned 128-bit product (bits.Mul64, #474).
		gen_pair(args[0], args[1], d)
		if dst >= 0 {
			emit3(I_UMULH, dst, pl, pr)
		}
		return 1
	}
	return 0
}

// gen_store8 stores a byte and, when dst >= 0, also yields the stored value.
fn gen_store8(e Call, dst i64, d i64) {
	let p = e.args[0]
	let v = e.args[1]
	mut base = 0
	mut index = -1
	mut off = 0
	mut dv = d
	if cast(Node, p).kind == EX_BINARY && cast(Binary, p).op == "+" && is_const(cast(Binary, p).r) != 0 && const_val(cast(Binary, p).r) >= 0 && const_val(cast(Binary, p).r) < 4096 {
		off = const_val(cast(Binary, p).r)
		base = gen_val(cast(Binary, p).l, d)
		dv = next_depth(base, d)
	} else if cast(Node, p).kind == EX_BINARY && cast(Binary, p).op == "+" && d + 3 <= t_count {
		base = gen_val(cast(Binary, p).l, d)
		index = gen_val(cast(Binary, p).r, next_depth(base, d))
		dv = next_depth(index, next_depth(base, d))
	} else {
		base = gen_val(p, d)
		dv = next_depth(base, d)
	}
	mut val = 0
	if dv >= t_count {
		// Too deep for another temp: keep the address on the stack meanwhile.
		emit1(I_PUSH, base)
		mov(X17, gen_val(v, d))
		emit1(I_POP, base)
		val = X17
	} else if is_const(v) != 0 && const_val(v) == 0 {
		val = ZR
	} else {
		val = gen_val(v, dv)
	}
	if index >= 0 {
		emit3(I_STRBX, val, base, index)
	} else {
		emit3(I_STRB, val, base, off)
	}
	if dst >= 0 {
		mov(dst, val)
	}
}

// param_types are the parameter types a call passes, from its callee or func type.
fn call_ptypes(e Call) []i64 {
	if e.fn_ != 0 {
		return cast(Fn, e.fn_).ptypes
	}
	return cast(Ty, cast(Node, e.callee).type_).fields
}

// arg_regs gives each argument its register: x0-x7 and d0-d7 counted separately,
// or -1 for a variadic argument that goes on the stack.
fn arg_regs(e Call) i64 {
	let ptypes = call_ptypes(e)
	let n = len(e.args)
	let regs = []i64{}
	mut ni = 0
	mut nf = 0
	mut i = 0
	for i < n {
		if i >= len(ptypes) && tgt_linux == 0 {
			// Apple's arm64 ABI passes variadic arguments on the stack.
			regs = append(regs, -1)
		} else if i < len(ptypes) && is_dyn_value(cast(Ty, ptypes[i])) != 0 {
			if ni + 1 < 8 {
				regs = append(regs, ni)
				ni = ni + 2
			} else {
				regs = append(regs, -1)
				ni = 8
			}
		} else if i >= len(ptypes) && e_fp(cast(Node, e.args[i])) != 0 {
			// AAPCS64 (Linux) passes them in registers like any other argument.
			regs = append(regs, FPR + nf)
			nf = nf + 1
		} else if i >= len(ptypes) {
			regs = append(regs, ni)
			ni = ni + 1
		} else if is_float_t(ptypes[i]) != 0 {
			regs = append(regs, FPR + nf)
			nf = nf + 1
		} else {
			regs = append(regs, ni)
			ni = ni + 1
		}
		i = i + 1
	}
	return cast(i64, regs)
}

fn push_reg(r i64) {
	if is_fp(r) != 0 {
		emit1(I_FPUSH, r)
	} else {
		emit1(I_PUSH, r)
	}
}

fn pop_reg(r i64) {
	if is_fp(r) != 0 {
		emit1(I_FPOP, r)
	} else {
		emit1(I_POP, r)
	}
}

fn caller_saved(r i64) i64 {
	if is_fp(r) != 0 {
		return i64(r < FPR + 8 || r >= FPR + 16)
	}
	return i64(r < 19)
}

// gen_call leaves the result in x0 (or d0 for a float).
fn gen_call(e i64, d i64) {
	if cast(Node, e).kind == EX_SEQ {
		gen_seq(e, -1, d)
		return
	}
	let args = cast(Call, e).args
	let n = len(args)
	let areg = cast([]i64, arg_regs(cast(Call, e)))
	let f = cast(Fn, cast(Call, e).fn_)
	let callee = cast(Call, e).callee
	let variadic = i64(cast(i64, f) != 0 && f.variadic != 0 && tgt_linux == 0)
	let stackoffs = slice_filled(n, -1)
	mut stack_words = 0
	mut has_stack = 0
	mut i = 0
	for i < n {
		let a = cast(Node, args[i])
		if areg[i] < 0 && variadic == 0 {
			has_stack = 1
			if is_dyn_value(cast(Ty, a.type_)) != 0 {
				stack_words = align_up(stack_words, 2)
				stackoffs[i] = 8 * stack_words
				stack_words = stack_words + 2
			} else {
				stackoffs[i] = 8 * stack_words
				stack_words = stack_words + 1
			}
		}
		i = i + 1
	}
	let stack_area = align_up(8 * stack_words, 16)
	mut callee_reg = -1
	mut d0 = d
	if callee != 0 && contains_call(callee) != 0 {
		callee_reg = gen_val(callee, d)
		d0 = next_depth(callee_reg, d)
	}
	mut nested = variadic
	i = 0
	for i < n {
		if contains_call(args[i]) != 0 || (has_stack != 0 && areg[i] < 0) {
			nested = 1
		}
		i = i + 1
	}
	let regs = slice_filled(n, -1)
	let regs2 = slice_filled(n, -1)
	mut area = 0
	mut temps_saved = 0
	mut stack_stored = 0
	if nested == 0 {
		// Temps never use x0-x7/d0-d7 in a function that calls, so args go straight there.
		i = 0
		for i < n {
			let a = cast(Node, args[i])
			let ar = areg[i]
			if is_dyn_value(cast(Ty, a.type_)) != 0 {
				if ar < 0 {
					err_code_at(a.pos, "E990 INTERNAL", "a dyn argument needs two argument registers or the stack")
				} else {
					gen_dyn_pair(cast(i64, a), ar, ar + 1, d0)
				}
			} else {
				gen_to(cast(i64, a), ar, d0)
			}
			i = i + 1
		}
	} else {
		mut words = n
		i = 0
		for i < n {
			if is_dyn_value(cast(Ty, cast(Node, args[i]).type_)) != 0 {
				words = words + 1
			}
			i = i + 1
		}
		mut has_fp = 0
		i = 0
		for i < n {
			if e_fp(cast(Node, args[i])) != 0 {
				has_fp = 1
			}
			i = i + 1
		}
		if d0 + words <= t_count && (has_fp == 0 || d0 + words <= f_count) {
			// Arguments that call, load or may panic run first, in order; the rest are
			// effect-free and go straight into their registers afterwards.
			mut last = -1
			i = 0
			for i < n {
				if speculable(args[i]) == 0 || areg[i] < 0 || is_dyn_value(cast(Ty, cast(Node, args[i]).type_)) != 0 {
					last = i
				}
				i = i + 1
			}
			// dd counts the temps actually holding earlier arguments, so nested calls only
			// save what is live.
			mut dd = d0
			i = 0
			for i < n {
				let a = cast(Node, args[i])
				if i == last && is_real_call(cast(i64, a)) != 0 && areg[i] >= 0 && variadic == 0 && is_dyn_value(cast(Ty, a.type_)) == 0 {
					// Nothing runs between this call and ours, so the result moves right in.
					gen_call(cast(i64, a), dd)
					if e_fp(cast(Node, a)) != 0 {
						mov(areg[i], FPR)
					} else {
						mov(areg[i], 0)
					}
					cast([]i64, regs)[i] = areg[i]
				} else if is_dyn_value(cast(Ty, a.type_)) != 0 {
					let r0 = treg(dd)
					let r1 = treg(dd + 1)
					gen_dyn_pair(cast(i64, a), r0, r1, dd)
					cast([]i64, regs)[i] = r0
					regs2[i] = r1
					dd = dd + 2
				} else if speculable(cast(i64, a)) == 0 || areg[i] < 0 {
					mut r = cast(ReturnStmt, gen_val(cast(i64, a), dd))
					cast([]i64, regs)[i] = cast(i64, r)
					dd = next_depth(cast(i64, r), dd)
				}
				i = i + 1
			}
		} else {
			if has_stack != 0 {
				save_temps(d)
				temps_saved = 1
				emit3(I_SUBI, SP, SP, stack_area)
				area = stack_area
			}
			i = 0
			for i < n {
				let a = cast(Node, args[i])
				if is_dyn_value(cast(Ty, a.type_)) != 0 {
					let r0 = treg(d0)
					let r1 = treg(d0 + 1)
					gen_dyn_pair(cast(i64, a), r0, r1, d0)
					push_reg(r0)
					push_reg(r1)
				} else {
					push_reg(gen_val(cast(i64, a), d0))
				}
				i = i + 1
			}
			i = n - 1
			for i >= 0 {
				mut r = areg[i]
				if is_dyn_value(cast(Ty, cast(Node, args[i]).type_)) != 0 {
					if cast(i64, r) < 0 {
						r = X16
						let r2 = X17
						pop_reg(r2)
						pop_reg(cast(i64, r))
						if has_stack != 0 {
							mut prior = 0
							mut pi = 0
							for pi < i {
								if is_dyn_value(cast(Ty, cast(Node, args[pi]).type_)) != 0 {
									prior = prior + 2
								} else {
									prior = prior + 1
								}
								pi = pi + 1
							}
							emit3(I_STR, cast(i64, r), SP, 16 * prior + stackoffs[i])
							emit3(I_STR, r2, SP, 16 * prior + stackoffs[i] + 8)
							stack_stored = 1
						}
						cast([]i64, regs)[i] = -2
						regs2[i] = -1
					} else {
						pop_reg(cast(i64, r) + 1)
						pop_reg(cast(i64, r))
						cast([]i64, regs)[i] = cast(i64, r)
						regs2[i] = cast(i64, r) + 1
					}
				} else {
					if cast(i64, r) < 0 {
						r = X16
						if e_fp(cast(Node, args[i])) != 0 {
							r = FSCR
						}
					}
					pop_reg(cast(i64, r))
					if areg[i] < 0 && has_stack != 0 {
						mut prior = 0
						mut pi = 0
						for pi < i {
							if is_dyn_value(cast(Ty, cast(Node, args[pi]).type_)) != 0 {
								prior = prior + 2
							} else {
								prior = prior + 1
							}
							pi = pi + 1
						}
						if e_fp(cast(Node, args[i])) != 0 {
							emit3(I_STRD, cast(i64, r), SP, 16 * prior + stackoffs[i])
						} else {
							emit3(I_STR, cast(i64, r), SP, 16 * prior + stackoffs[i])
						}
						cast([]i64, regs)[i] = -2
						stack_stored = 1
					} else {
						cast([]i64, regs)[i] = cast(i64, r)
					}
				}
				i = i - 1
			}
		}
	}
	// A variadic call stores its stack arguments while their temps are intact, and
	// saves live temps first so the pushes land above the argument area.
	if variadic != 0 {
		save_temps(d)
		temps_saved = 1
		area = store_varargs(f, cast([]i64, regs), n)
	}
	if nested != 0 {
		i = 0
		for i < n {
			mut r = cast(ReturnStmt, regs[i])
			if cast(i64, r) >= 0 && areg[i] >= 0 {
				mov(areg[i], cast(i64, r))
				if is_dyn_value(cast(Ty, cast(Node, args[i]).type_)) != 0 {
					mov(areg[i] + 1, regs2[i])
				}
			}
			i = i + 1
		}
		i = 0
		for i < n {
			if regs[i] == -1 {
				// The temps above d are free again once moved into argument registers.
				if is_dyn_value(cast(Ty, cast(Node, args[i]).type_)) != 0 {
					mut r = cast(ReturnStmt, areg[i])
					if cast(i64, r) < 0 {
						err_code_at(cast(Node, args[i]).pos, "E990 INTERNAL", "a dyn argument needs two argument registers or the stack")
					} else {
						gen_dyn_pair(args[i], cast(i64, r), cast(i64, r) + 1, d0)
					}
				} else {
					gen_to(args[i], areg[i], d0)
				}
			}
			i = i + 1
		}
	}
	// With the args in place, a callee's parameter-only base case can be answered
	// without the call (fib's leaves), which Go never inlines for recursive functions.
	mut pat = cast(IfStmt, 0)
	if cast(i64, f) != 0 && variadic == 0 {
		pat = cast(IfStmt, exit_pattern(f))
	}
	mut done_l = 0
	if cast(i64, pat) != 0 && has_stack == 0 && d0 + n + 2 <= t_count && d0 + n + 2 <= f_count {
		let homes = cast([]i64, param_homes(f))
		with_params_in_args(f, cast([]i64, 0))
		let call_l = new_label()
		done_l = new_label()
		gen_cond(pat.cond, call_l, d0 + n)
		mut r = cast(ReturnStmt, cast(Block, pat.then).stmts[0])
		if r.value != 0 {
			if is_float_t(f.rtypes[0]) != 0 {
				gen_to(r.value, FPR, d0 + n)
			} else {
				gen_to(r.value, 0, d0 + n)
			}
		} else {
			emit3(I_MOVZ, 0, 0, 0)
		}
		emit1(I_B, done_l)
		label(call_l)
		with_params_in_args(f, homes)
	}
	if variadic == 0 && temps_saved == 0 {
		save_temps(d)
		temps_saved = 1
	}
	if has_stack != 0 && stack_stored == 0 {
		if stack_area > 0 {
			emit3(I_SUBI, SP, SP, stack_area)
			area = stack_area
		}
		i = 0
		for i < n {
			if areg[i] < 0 {
				mut r = regs[i]
				if cast(i64, r) < 0 {
					err_code_at(cast(Node, args[i]).pos, "E990 INTERNAL", "unable to stage a stack argument")
				} else if is_dyn_value(cast(Ty, cast(Node, args[i]).type_)) != 0 {
					emit3(I_STR, cast(i64, r), SP, stackoffs[i])
					emit3(I_STR, regs2[i], SP, stackoffs[i] + 8)
				} else if is_fp(args[i]) != 0 {
					emit3(I_STRD, cast(i64, r), SP, stackoffs[i])
				} else {
					emit3(I_STR, cast(i64, r), SP, stackoffs[i])
				}
			}
			i = i + 1
		}
	}
	if cast(i64, f) != 0 {
		emit1(I_BL, cast(i64, f))
		f.used = 1
	} else if callee_reg >= 0 {
		mov(X17, callee_reg)
		emit3(I_LDR, X16, X17, 0)
		emit1(I_BLR, X16)
	} else {
		gen_to(callee, X17, d0)
		emit3(I_LDR, X16, X17, 0)
		emit1(I_BLR, X16)
	}
	if area > 0 {
		emit3(I_ADDI, SP, SP, area)
	}
	if done_l != 0 {
		// Branch past the restores: the inline answer didn't spill anything.
		let after = new_label()
		restore_temps(d)
		emit1(I_B, after)
		label(done_l)
		label(after)
		return
	}
	restore_temps(d)
}

// save_temps pushes the live caller-saved temps below depth d before a call.
fn save_temps(d i64) {
	mut i = 0
	for i < d {
		if i < t_count && caller_saved(t_regs[i]) != 0 {
			emit1(I_PUSH, t_regs[i])
		}
		if i < f_count && caller_saved(f_regs[i]) != 0 {
			emit1(I_FPUSH, f_regs[i])
		}
		i = i + 1
	}
}

// store_varargs places a variadic call's extra arguments in 8-byte stack slots
// (Apple's ABI) and returns the bytes reserved.
fn store_varargs(f Fn, regs []i64, n i64) i64 {
	let first = len(f.ptypes)
	let area = align_up(8 * (n - first), 16)
	if area > 0 {
		emit3(I_SUBI, SP, SP, area)
	}
	mut i = first
	for i < n {
		let r = regs[i]
		let off = 8 * (i - first)
		if is_fp(r) != 0 {
			emit3(I_STRD, r, SP, off)
		} else {
			emit3(I_STR, r, SP, off)
		}
		i = i + 1
	}
	return area
}

fn restore_temps(d i64) {
	mut i = d - 1
	for i >= 0 {
		if i < f_count && caller_saved(f_regs[i]) != 0 {
			emit1(I_FPOP, f_regs[i])
		}
		if i < t_count && caller_saved(t_regs[i]) != 0 {
			emit1(I_POP, t_regs[i])
		}
		i = i - 1
	}
}

// ---- conditions ----
// low_bits_test returns k when e is (x % 2^k) or (x & (2^k - 1)), which is zero
// exactly when the low k bits of x are clear.
fn low_bits_test(e i64) i64 {
	if cast(Node, e).kind != EX_BINARY || is_const(cast(Binary, e).r) == 0 || has_effects(cast(Binary, e).l) != 0 || e_fp(cast(Node, e)) != 0 {
		return 0
	}
	mut c = const_val(cast(Binary, e).r)
	if cast(Binary, e).op == "%" {
		if c < 0 && c != -9223372036854775807 - 1 {
			c = -c
		}
		let k = pow2_log(c)
		if k > 0 {
			return k
		}
		return 0
	}
	if cast(Binary, e).op == "&" {
		return low_mask_bits(c)
	}
	return 0
}

// gen_cmp_branch branches to target when comparison e evaluates to when_true.
fn gen_cmp_branch(e Binary, target i64, d i64, when_true i64) {
	if e_fp(cast(Node, e.l)) != 0 || e_fp(cast(Node, e.r)) != 0 {
		gen_compare(e, d)
		if when_true != 0 {
			emit2(I_BCOND, cmp_cc, target)
		} else {
			emit2(I_BCOND, cmp_cc ^ 1, target)
		}
		return
	}
	mut cc = cond_code(e.op)
	mut l = e.l
	mut r = e.r
	let unsigned = i64(e_unsigned(cast(Node, l)) != 0 || e_unsigned(cast(Node, r)) != 0)
	if unsigned != 0 {
		cc = ucond_code(e.op)
	}
	if is_const(l) != 0 {
		let t = l
		l = r
		r = t
		cc = swap_cc(cc)
	}
	if is_const(r) != 0 && const_val(r) == 0 && !(unsigned != 0 && cc != C_EQ && cc != C_NE) {
		if cc == C_EQ || cc == C_NE {
			let on_zero = i64(i64((cc == C_EQ)) == when_true)
			let k = low_bits_test(l)
			if k == 1 {
				let x = gen_val(cast(Binary, l).l, d)
				if on_zero != 0 {
					emit3(I_TBZ, x, 0, target)
				} else {
					emit3(I_TBNZ, x, 0, target)
				}
				return
			}
			if k > 1 {
				emit2(I_TSTI, gen_val(cast(Binary, l).l, d), k)
				if on_zero != 0 {
					emit2(I_BCOND, C_EQ, target)
				} else {
					emit2(I_BCOND, C_NE, target)
				}
				return
			}
			let z = gen_val(l, d)
			if on_zero != 0 {
				emit2(I_CBZ, z, target)
			} else {
				emit2(I_CBNZ, z, target)
			}
			return
		}
		if cc == C_LT || cc == C_GE {
			let on_neg = i64(i64((cc == C_LT)) == when_true)
			let s = gen_val(l, d)
			if on_neg != 0 {
				emit3(I_TBNZ, s, 63, target)
			} else {
				emit3(I_TBZ, s, 63, target)
			}
			return
		}
	}
	gen_compare(e, d)
	if when_true != 0 {
		emit2(I_BCOND, cmp_cc, target)
	} else {
		emit2(I_BCOND, cmp_cc ^ 1, target)
	}
}

// gen_cond branches to f when e is false and falls through when it is true.
fn gen_cond(e i64, f i64, d i64) {
	gen_branch(e, f, d, 0)
}

// gen_branch branches to target when e's truth equals when_true.
fn gen_branch(e i64, target i64, d i64, when_true i64) {
	if is_const(e) != 0 {
		if i64((const_val(e) != 0)) == when_true {
			emit1(I_B, target)
		}
		return
	}
	let k = cast(Node, e).kind
	if k == EX_SEQ {
		// The statements start at depth 0: keep the temps below d, as gen_seq does (#492).
		mut i = 0
		for i < d {
			if i < t_count {
				emit1(I_PUSH, t_regs[i])
			}
			if i < f_count {
				emit1(I_FPUSH, f_regs[i])
			}
			i = i + 1
		}
		gen_stmts(cast(SeqExpr, e).stmts)
		i = d - 1
		for i >= 0 {
			if i < f_count {
				emit1(I_FPOP, f_regs[i])
			}
			if i < t_count {
				emit1(I_POP, t_regs[i])
			}
			i = i - 1
		}
		gen_branch(cast(SeqExpr, e).value, target, d, when_true)
		return
	}
	if k == EX_UNARY && cast(Unary, e).op == "!" {
		gen_branch(cast(Unary, e).x, target, d, i64(when_true == 0))
		return
	}
	if k == EX_BINARY {
		let op = cast(Binary, e).op
		let is_and = i64(op == "&&")
		if is_and != 0 || op == "||" {
			// Branching on the operator's own sense chains; the other sense skips ahead.
			if is_and != when_true {
				gen_branch(cast(Binary, e).l, target, d, when_true)
				gen_branch(cast(Binary, e).r, target, d, when_true)
			} else {
				let skip = new_label()
				gen_branch(cast(Binary, e).l, skip, d, i64(when_true == 0))
				gen_branch(cast(Binary, e).r, target, d, when_true)
				label(skip)
			}
			return
		}
		if cond_code(op) >= 0 {
			gen_cmp_branch(cast(Binary, e), target, d, when_true)
			return
		}
		if op == "&" && is_const(cast(Binary, e).r) != 0 && pow2_log(const_val(cast(Binary, e).r)) >= 0 {
			let bit = pow2_log(const_val(cast(Binary, e).r))
			let x = gen_val(cast(Binary, e).l, d)
			if when_true != 0 {
				emit3(I_TBNZ, x, bit, target)
			} else {
				emit3(I_TBZ, x, bit, target)
			}
			return
		}
	}
	let v = gen_val(e, d)
	if is_fp(v) != 0 {
		emit2(I_FCMPZ, v, 0)
		if when_true != 0 {
			emit2(I_BCOND, C_NE, target)
		} else {
			emit2(I_BCOND, C_EQ, target)
		}
		return
	}
	if when_true != 0 {
		emit2(I_CBNZ, v, target)
	} else {
		emit2(I_CBZ, v, target)
	}
}

// ---- statements ----
fn gen_effect(e i64) {
	if has_effects(e) == 0 {
		return
	}
	if is_real_call(e) != 0 {
		gen_call(e, 0)
	} else if cast(Node, e).kind == EX_SEQ {
		gen_seq(e, -1, 0)
	} else if cast(Node, e).kind == EX_CALL && (cast(Call, e).name == "__prefetchw" || cast(Call, e).name == "store8") {
		gen_intrinsic(cast(Call, e), -1, 0)
	} else if cast(Node, e).kind == EX_CALL && cast(Call, e).intrinsic != 0 {
		mut r = 0
		if e_fp(cast(Node, e)) != 0 {
			r = freg(0)
		} else {
			r = treg(0)
		}
		gen_intrinsic(cast(Call, e), r, 0)
	} else {
		gen_val(e, 0)
	}
}

fn assign_local(s Sym, v i64) {
	if is_dyn_value(cast(Ty, s.type_)) != 0 {
		let r0 = treg(0)
		let r1 = treg(1)
		gen_dyn_pair(v, r0, r1, 0)
		if s.reg == REG_SLOT {
			emit3(I_STR, r0, FP, s.off)
			emit3(I_STR, r1, FP, s.off + 8)
		} else {
			err_code_at(s.pos, "E990 INTERNAL", "dyn local is not in a two-word frame slot")
		}
		return
	}
	if s.reg >= 0 {
		gen_to(v, s.reg, 0)
	} else if s.reg == REG_SLOT {
		let r = gen_val(v, 0)
		if is_fp(r) != 0 {
			emit3(I_STRD, r, FP, s.off)
		} else {
			emit3(I_STR, r, FP, s.off)
		}
	} else {
		gen_effect(v)
	}
}

fn node_copy(n i64) i64 {
	let c = malloc(8 * N_SIZE)
	mut i = 0
	for i < N_SIZE {
		c[i] = n[i]
		i = i + 1
	}
	return c
}

fn node_restore(n i64, c i64) {
	mut i = 0
	for i < N_SIZE {
		n[i] = c[i]
		i = i + 1
	}
}

// gen_store_mem stores v through an EX_MEM or EX_ELEM target. The address parts are
// computed into stable temps first; a[i] = a[i] op x loads the element only once.
fn gen_store_mem(t i64, v i64) {
	if is_dyn_value(cast(Ty, cast(Node, t).type_)) != 0 {
		gen_dyn_mem_address(cast(Node, t), 0)
		emit1(I_PUSH, X16)
		let r0 = treg(0)
		let r1 = treg(1)
		gen_dyn_pair(v, r0, r1, 0)
		emit1(I_POP, X16)
		emit3(I_STR, r0, X16, 0)
		emit3(I_STR, r1, X16, 8)
		return
	}
	let fpv = e_fp(cast(Node, t))
	mut base = 0
	mut idx = -1
	mut off = 0
	mut d = 0
	let size = type_width(cast(Ty, cast(Node, t).type_))
	if cast(Node, t).kind == EX_ELEM {
		let h = gen_val(cast(ElemExpr, t).seq, 0)
		d = next_depth(h, 0)
		let ix = cast(ElemExpr, t).idx
		if is_const(ix) != 0 && cast(ElemExpr, t).safe == 0 {
			idx = treg(d)
			load_imm(idx, const_val(ix))
			d = d + 1
		} else if is_const(ix) == 0 {
			idx = gen_val(ix, d)
			d = next_depth(idx, d)
		}
		if cast(ElemExpr, t).safe == 0 {
			emit4(I_LD, X17, h, 0, 3)
			emit2(I_CMP, idx, X17)
			emit2(I_BCOND, C_HS, trap_at(idx, X17, 0))
		}
		base = treg(d)
		d = d + 1
		if cast(ElemExpr, t).str != 0 {
			emit3(I_ADDI, base, h, 8)
		} else {
			emit4(I_LD, base, h, 16, 3)
		}
		if is_const(ix) != 0 && cast(ElemExpr, t).safe != 0 {
			off = const_val(ix) * size
		} else if is_const(ix) != 0 {
			off = const_val(ix) * size
			idx = -1
		}
	} else {
		base = gen_val(cast(MemExpr, t).base, 0)
		d = next_depth(base, 0)
		off = cast(MemExpr, t).off
		let ix = cast(MemExpr, t).index
		if ix != 0 && is_const(ix) != 0 && cast(MemExpr, t).len == 0 {
			off = off + const_val(ix) * cast(MemExpr, t).scale
		} else if ix != 0 {
			idx = gen_val(ix, d)
			d = next_depth(idx, d)
			if cast(MemExpr, t).len != 0 {
				bounds_check(idx, cast(MemExpr, t).len, d)
			}
			if cast(MemExpr, t).scale != size {
				let nb = treg(d)
				emit4(I_ADD, nb, base, idx, SH_LSL + width_log2(cast(MemExpr, t).scale))
				d = d + 1
				base = nb
				idx = -1
			}
		}
	}
	if idx >= 0 && off != 0 {
		let nb2 = treg(d)
		add_imm(nb2, base, off)
		d = d + 1
		base = nb2
		off = 0
	}
	if idx < 0 && (off < 0 || off % size != 0 || off / size >= 4096) {
		let nb3 = treg(d)
		add_imm(nb3, base, off)
		d = d + 1
		base = nb3
		off = 0
	}
	mut val = 0
	if cast(Node, v).kind == EX_BINARY && d + 2 < t_count && d + 2 < f_count && has_effects(t) == 0 && expr_equal(cast(Binary, v).l, t) != 0 {
		mut cur = 0
		if fpv != 0 {
			cur = freg(d)
		} else {
			cur = treg(d)
		}
		mm_base = base
		mm_index = idx
		mm_off = off
		emit_load(cur, cast(Node, t).type_)
		let saved = node_copy(cast(Binary, v).l)
		cast(Node, cast(Binary, v).l).kind = EX_REG
		cast(RegExpr, cast(Binary, v).l).num = cur
		gen_to(v, cur, d + 1)
		node_restore(cast(Binary, v).l, saved)
		val = cur
	} else if fpv == 0 && is_const(v) != 0 && const_val(v) == 0 {
		val = ZR
	} else {
		val = gen_val(v, d)
	}
	mm_base = base
	mm_index = idx
	mm_off = off
	emit_store(val, cast(Node, t).type_)
}

fn gen_store_index(t IndexExpr, v i64) {
	let base = gen_val(t.x, 0)
	mut d = next_depth(base, 0)
	let ix = t.i
	mut index = -1
	mut off = 0
	if is_const(ix) != 0 && const_val(ix) >= 0 && const_val(ix) < 4096 {
		off = const_val(ix) * 8
	} else {
		index = gen_val(ix, d)
		d = next_depth(index, d)
	}
	let fpv = i64(e_fp(cast(Node, v)) != 0 || e_fp(cast(Node, t)) != 0)
	mut val = 0
	if cast(Node, v).kind == EX_BINARY && d + 1 < t_count && d + 1 < f_count && has_effects(cast(i64, t)) == 0 && expr_equal(cast(Binary, v).l, cast(i64, t)) != 0 {
		// a[i] = a[i] op x: load the element once and update it in a register.
		mut cur = 0
		if fpv != 0 {
			cur = freg(d)
		} else {
			cur = treg(d)
		}
		if index < 0 {
			if fpv != 0 {
				emit3(I_LDRD, cur, base, off)
			} else {
				emit3(I_LDR, cur, base, off)
			}
		} else if fpv != 0 {
			emit3(I_LDRDX, cur, base, index)
		} else {
			emit3(I_LDRX, cur, base, index)
		}
		let saved = node_copy(cast(Binary, v).l)
		cast(Node, cast(Binary, v).l).kind = EX_REG
		cast(RegExpr, cast(Binary, v).l).num = cur
		gen_to(v, cur, d + 1)
		node_restore(cast(Binary, v).l, saved)
		val = cur
	} else if fpv == 0 && is_const(v) != 0 && const_val(v) == 0 {
		val = ZR
	} else {
		val = gen_val(v, d)
	}
	if is_fp(val) != 0 {
		if index < 0 {
			emit3(I_STRD, val, base, off)
		} else {
			emit3(I_STRDX, val, base, index)
		}
		return
	}
	if index < 0 {
		emit3(I_STR, val, base, off)
	} else {
		emit3(I_STRX, val, base, index)
	}
}

fn gen_assign(s AssignStmt) {
	let t = s.target
	let v = s.value
	if cast(Node, t).kind == EX_INDEX {
		gen_store_index(cast(IndexExpr, t), v)
		return
	}
	if cast(Node, t).kind == EX_MEM || cast(Node, t).kind == EX_ELEM {
		gen_store_mem(t, v)
		return
	}
	let sym = cast(Sym, cast(IdentExpr, t).ref)
	if sym.kind == SYM_LOCAL {
		assign_local(sym, v)
		return
	}
	if is_dyn_value(cast(Ty, sym.type_)) != 0 {
		let r0 = treg(0)
		let r1 = treg(1)
		gen_dyn_pair(v, r0, r1, 0)
		if sym.tls != 0 {
			emit3(I_STR, r0, 28, tls_off(sym))
			emit3(I_STR, r1, 28, tls_off(sym) + 8)
		} else {
			let first = sym_ref(SK_VAR, sym.index)
			let second = sym_ref(SK_VAR, sym.words)
			emit2(I_ADRP, X16, first)
			emit3(I_STRLO, r0, X16, first)
			emit2(I_ADRP, X16, second)
			emit3(I_STRLO, r1, X16, second)
		}
		return
	}
	mut r = gen_val(v, 0)
	if sym.tls != 0 {
		if is_fp(r) != 0 {
			emit3(I_STRD, r, 28, tls_off(sym))
		} else {
			emit3(I_STR, r, 28, tls_off(sym))
		}
		return
	}
	let g = sym_ref(SK_VAR, sym.index)
	emit2(I_ADRP, X17, g)
	if is_fp(r) != 0 {
		emit2(I_FMOVXD, X16, r)
		r = X16
	}
	emit3(I_STRLO, r, X17, g)
}

// loop_with_label is the index of the innermost g_loops pair the label names; the checker has
// made sure there is one.
fn loop_with_label(name str) i64 {
	mut i = len(g_loop_labels) - 1
	for i >= 0 {
		let l = g_loop_labels[i]
		if len(l) != 0 && l == name {
			return i
		}
		i = i - 1
	}
	return len(g_loop_labels) - 1
}

fn gen_while(s WhileStmt) {
	let cond = s.cond
	let body_l = new_label()
	let cond_l = new_label()
	let post_l = new_label()
	let end_l = new_label()
	if s.once_ != 0 {
		// A switch: break leaves it, continue goes to the enclosing loop.
		mut cont = -1
		if len(g_loops) >= 2 {
			cont = g_loops[len(g_loops) - 2]
		}
		g_loops = append(g_loops, cont)
		g_loops = append(g_loops, end_l)
		g_loop_labels = append(g_loop_labels, "")
		gen_stmts(cast(Block, s.body).stmts)
		slice_truncate(g_loops, len(g_loops) - 2)
		slice_truncate(g_loop_labels, len(g_loop_labels) - 1)
		label(end_l)
		return
	}
	if is_const(cond) != 0 && const_val(cond) == 0 {
		return
	}
	let forever = is_const(cond)
	mut cont_l = cond_l
	if s.post != 0 {
		cont_l = post_l
	} else if forever != 0 {
		cont_l = body_l
	}
	// Rotated loop: the test sits at the bottom, so each iteration takes one branch.
	if forever == 0 {
		emit1(I_B, cond_l)
	}
	label(body_l)
	gen_poll()
	g_loops = append(g_loops, cont_l)
	g_loops = append(g_loops, end_l)
	g_loop_labels = append(g_loop_labels, s.label)
	gen_stmts(cast(Block, s.body).stmts)
	slice_truncate(g_loops, len(g_loops) - 2)
	slice_truncate(g_loop_labels, len(g_loop_labels) - 1)
	label(post_l)
	if s.post != 0 {
		gen_stmt(s.post)
	}
	if forever != 0 {
		emit1(I_B, body_l)
	} else {
		label(cond_l)
		gen_branch(cond, body_l, 0, 1)
	}
	label(end_l)
}

fn gen_stmts(stmts []i64) {
	mut i = 0
	for i < len(stmts) {
		gen_stmt(stmts[i])
		i = i + 1
	}
}

fn result_reg(f Fn, i i64) i64 {
	if len(f.rtypes) == 1 && is_float_t(f.rtypes[0]) != 0 {
		return FPR
	}
	return i
}

fn gen_stmt(s i64) {
	let k = cast(Node, s).kind
	if k == ST_BLOCK {
		gen_stmts(cast(Block, s).stmts)
	} else if k == ST_LET {
		assign_local(cast(Sym, cast(LetStmt, s).sym), cast(LetStmt, s).init)
	} else if k == ST_ASSIGN {
		gen_assign(cast(AssignStmt, s))
	} else if k == ST_EXPR {
		gen_effect(cast(ExprStmt, s).x)
	} else if k == ST_IF && try_if_increment(cast(IfStmt, s)) != 0 {
		// The condition flags drive the backend's conditional increment.
	} else if k == ST_IF && try_select(cast(IfStmt, s)) != 0 {
		// done: both arms computed and picked with csel
	} else if k == ST_IF {
		let else_l = new_label()
		gen_cond(cast(IfStmt, s).cond, else_l, 0)
		gen_stmts(cast(Block, cast(IfStmt, s).then).stmts)
		if cast(IfStmt, s).else_ != 0 {
			let end_l = new_label()
			emit1(I_B, end_l)
			label(else_l)
			gen_stmt(cast(IfStmt, s).else_)
			label(end_l)
		} else {
			label(else_l)
		}
	} else if k == ST_WHILE {
		gen_while(cast(WhileStmt, s))
	} else if k == ST_RETURN {
		gen_return(cast(ReturnStmt, s))
	} else if k == ST_BREAK && len(cast(BreakStmt, s).label) != 0 {
		emit1(I_B, g_loops[2 * loop_with_label(cast(BreakStmt, s).label) + 1])
	} else if k == ST_CONTINUE && len(cast(ContinueStmt, s).label) != 0 {
		emit1(I_B, g_loops[2 * loop_with_label(cast(ContinueStmt, s).label)])
	} else if k == ST_BREAK {
		emit1(I_B, g_loops[len(g_loops) - 1])
	} else if k == ST_CONTINUE {
		// A switch block passes continue on to the loop around it.
		mut i = len(g_loops) - 2
		for g_loops[i] < 0 {
			i = i - 2
		}
		emit1(I_B, g_loops[i])
	} else if k == ST_CALLMULTI {
		gen_call(cast(CallMultiStmt, s).call, 0)
		let syms = cast(CallMultiStmt, s).syms
		mut i = 0
		for i < len(syms) {
			let sym = syms[i]
			if sym.reg >= 0 {
				mov(sym.reg, i)
			} else if sym.reg == REG_SLOT {
				emit3(I_STR, i, FP, sym.off)
			}
			i = i + 1
		}
	}
}

// Multiple results travel in x0-x7 (floats as bits); a single float result in d0.
fn gen_return(s ReturnStmt) {
	let f = cur_gen_fn
	if cast(i64, s.values) != 0 {
		let vals = s.values
		let lanes = []i64{}
		mut nlanes = 0
		mut i = 0
		for i < len(vals) {
			let v = cast(Node, vals[i])
			lanes = append(lanes, nlanes)
			if is_dyn_value(cast(Ty, v.type_)) != 0 {
				let r0 = treg(i)
				let r1 = treg(i + 1)
				gen_dyn_pair(cast(i64, v), r0, r1, i)
				emit1(I_PUSH, r0)
				emit1(I_PUSH, r1)
				nlanes = nlanes + 2
			} else {
				push_reg(gen_val(cast(i64, v), i))
				nlanes = nlanes + 1
			}
			i = i + 1
		}
		i = 0
		mut lane_ = nlanes
		i = len(vals) - 1
		for i >= 0 {
			let v = cast(Node, vals[i])
			let start = lanes[i]
			if is_dyn_value(cast(Ty, v.type_)) != 0 {
				lane_ = lane_ - 2
				emit1(I_POP, X16)
				emit1(I_POP, X17)
				mov(start, X17)
				mov(start + 1, X16)
			} else {
				lane_ = lane_ - 1
				if is_float_t(v.type_) != 0 {
					emit1(I_FPOP, FPR)
					mov(start, FPR)
				} else {
					emit1(I_POP, start)
				}
			}
			i = i - 1
		}
	} else if s.value != 0 {
		if is_dyn_value(cast(Ty, cast(Node, s.value).type_)) != 0 {
			gen_dyn_pair(s.value, 0, 1, 0)
		} else {
			gen_to(s.value, result_reg(cast(Fn, f), 0), 0)
		}
	} else {
		emit3(I_MOVZ, 0, 0, 0)
	}
	emit1(I_RET, 0)
}

// ---- if-conversion ----
// speculable reports whether e can be computed even on the path that doesn't need it:
// no calls, no memory access, no panics, and cheap enough to beat a mispredicted branch.
fn speculable(e i64) i64 {
	let k = cast(Node, e).kind
	if k == EX_INT || k == EX_STR || k == EX_FLOAT || k == EX_FUNCREF {
		return 1
	}
	if k == EX_IDENT {
		return i64(cast(Sym, cast(IdentExpr, e).ref).kind != SYM_GLOBAL)
	}
	if k == EX_UNARY {
		return i64(cast(Unary, e).ovf != OVF_CHECK && speculable(cast(Unary, e).x) != 0)
	}
	if k == EX_BINARY {
		return i64(cast(Binary, e).op != "&&" && cast(Binary, e).op != "||" && may_panic(cast(Binary, e)) == 0 && speculable(cast(Binary, e).l) != 0 && speculable(cast(Binary, e).r) != 0)
	}
	if k == EX_CONV {
		return i64(cast(Conv, e).kind != CV_LEN && cast(Conv, e).kind != CV_CAP && cast(Conv, e).ovf != OVF_CHECK && speculable(cast(Conv, e).x) != 0)
	}
	if k == EX_CALL && cast(Call, e).intrinsic != 0 && cast(Call, e).name == "__empty" {
		return 1
	}
	return 0
}

// single_reg_assign returns the register local assigned by a block of exactly one
// `x = e;`, or 0 if the block is anything else.
fn single_reg_assign(b Block) AssignStmt {
	if len(b.stmts) != 1 {
		return cast(AssignStmt, 0)
	}
	let s = b.stmts[0]
	if cast(Node, s).kind != ST_ASSIGN || cast(Node, cast(AssignStmt, s).target).kind != EX_IDENT {
		return cast(AssignStmt, 0)
	}
	let sym = cast(Sym, cast(IdentExpr, cast(AssignStmt, s).target).ref)
	if sym.kind != SYM_LOCAL || sym.reg < 0 || speculable(cast(AssignStmt, s).value) == 0 {
		return cast(AssignStmt, 0)
	}
	return cast(AssignStmt, s)
}

// read_only_expr accepts pure expressions and checker-created sequences that only bind
// local temporaries. It excludes calls and writes so the conditional increment cannot
// reorder observable effects.
fn read_only_expr(e i64) i64 {
	if e == 0 {
		return 1
	}
	let k = cast(Node, e).kind
	if k == EX_INT || k == EX_STR || k == EX_FLOAT || k == EX_FUNCREF || k == EX_IDENT {
		return 1
	}
	if k == EX_UNARY {
		return read_only_expr(cast(Unary, e).x)
	}
	if k == EX_BINARY {
		return i64(read_only_expr(cast(Binary, e).l) != 0 && read_only_expr(cast(Binary, e).r) != 0)
	}
	if k == EX_CONV {
		return read_only_expr(cast(Conv, e).x)
	}
	if k == EX_MEM {
		return i64(read_only_expr(cast(MemExpr, e).base) != 0 && read_only_expr(cast(MemExpr, e).index) != 0 && read_only_expr(cast(MemExpr, e).len) != 0)
	}
	if k == EX_ELEM {
		return i64(read_only_expr(cast(ElemExpr, e).seq) != 0 && read_only_expr(cast(ElemExpr, e).idx) != 0)
	}
	if k == EX_INDEX {
		return i64(read_only_expr(cast(IndexExpr, e).x) != 0 && read_only_expr(cast(IndexExpr, e).i) != 0)
	}
	if k == EX_SEQ {
		let stmts = cast(SeqExpr, e).stmts
		mut i = 0
		for i < len(stmts) {
			let st = stmts[i]
			if cast(Node, st).kind != ST_LET || read_only_expr(cast(LetStmt, st).init) == 0 {
				return 0
			}
			i = i + 1
		}
		return read_only_expr(cast(SeqExpr, e).value)
	}
	return 0
}

// if_increment_assignment returns the assignment in `if c { x++ }` when x is a
// register-held 64-bit integer and c cannot write through calls or assignments.
fn if_increment_assignment(s IfStmt) i64 {
	if s.else_ != 0 || read_only_expr(s.cond) == 0 {
		return 0
	}
	let body = cast(Block, s.then)
	if len(body.stmts) != 1 {
		return 0
	}
	let a = body.stmts[0]
	if cast(Node, a).kind != ST_ASSIGN || cast(Node, cast(AssignStmt, a).target).kind != EX_IDENT {
		return 0
	}
	let x = cast(Sym, cast(IdentExpr, cast(AssignStmt, a).target).ref)
	let value = cast(AssignStmt, a).value
	if x.kind != SYM_LOCAL || x.reg < 0 || is_integer_t(x.type_) == 0 || cast(Ty, x.type_).width != 8 || cast(Node, value).kind != EX_BINARY || cast(Binary, value).op != "+" || cast(Node, cast(Binary, value).l).kind != EX_IDENT || cast(i64, cast(Sym, cast(IdentExpr, cast(Binary, value).l).ref)) != cast(i64, x) || is_const(cast(Binary, value).r) == 0 || const_val(cast(Binary, value).r) != 1 {
		return 0
	}
	return a
}

// try_if_increment compiles `if c { x++ }` to a conditional increment on arm64.
fn try_if_increment(s IfStmt) i64 {
	let a = cast(AssignStmt, if_increment_assignment(s))
	if cast(i64, a) == 0 {
		return 0
	}
	let x = cast(Sym, cast(IdentExpr, a.target).ref)
	let cc = gen_flags(s.cond, 0)
	if cast(Binary, a.value).ovf == OVF_CHECK {
		// Checked (#362): add the condition (0 or 1) with adds, still without a branch on it.
		emit2(I_CSET, X16, cc)
		emit4(I_ADDS, x.reg, x.reg, X16, 0)
		checked_flags(OVK_ADD, i64(is_unsigned_t(cast(Ty, x.type_)) == 0))
		return 1
	}
	emit3(I_CINC, x.reg, x.reg, cc)
	return 1
}

// gen_flags sets the flags for condition e and returns the condition code meaning true.
fn gen_flags(e i64, d i64) i64 {
	if cast(Node, e).kind == EX_UNARY && cast(Unary, e).op == "!" {
		return gen_flags(cast(Unary, e).x, d) ^ 1
	}
	if cast(Node, e).kind == EX_SEQ {
		mut i = 0
		for i < d {
			if i < t_count {
				emit1(I_PUSH, t_regs[i])
			}
			if i < f_count {
				emit1(I_FPUSH, f_regs[i])
			}
			i = i + 1
		}
		gen_stmts(cast(SeqExpr, e).stmts)
		i = d - 1
		for i >= 0 {
			if i < f_count {
				emit1(I_FPOP, f_regs[i])
			}
			if i < t_count {
				emit1(I_POP, t_regs[i])
			}
			i = i - 1
		}
		return gen_flags(cast(SeqExpr, e).value, d)
	}
	if cast(Node, e).kind == EX_BINARY {
		let cc = cond_code(cast(Binary, e).op)
		if (cc == C_EQ || cc == C_NE) && e_fp(cast(Node, cast(Binary, e).l)) == 0 && is_const(cast(Binary, e).r) != 0 && const_val(cast(Binary, e).r) == 0 && low_bits_test(cast(Binary, e).l) > 0 {
			let l = cast(Binary, e).l
			emit2(I_TSTI, gen_val(cast(Binary, l).l, d), low_bits_test(l))
			return cc
		}
		if cc >= 0 {
			gen_compare(cast(Binary, e), d)
			return cmp_cc
		}
	}
	emit2(I_CMPI, gen_val(e, d), 0)
	return C_NE
}

// try_select compiles `if c { x = a; } else { x = b; }` as x = csel(c, a, b), like
// Go's branchelim: both values are cheap, so computing both beats a mispredicted branch.
fn try_select(s IfStmt) i64 {
	let c = s.cond
	if has_effects(c) != 0 || contains_call(c) != 0 || is_const(c) != 0 || e_fp(cast(Node, c)) != 0 {
		return 0
	}
	if cast(Node, c).kind == EX_BINARY && (cast(Binary, c).op == "&&" || cast(Binary, c).op == "||") {
		return 0
	}
	let ta = single_reg_assign(cast(Block, s.then))
	if cast(i64, ta) == 0 {
		return 0
	}
	let x = cast(Sym, cast(IdentExpr, ta.target).ref)
	mut fb = cast(AssignStmt, 0)
	if s.else_ != 0 {
		if cast(Node, s.else_).kind != ST_BLOCK {
			return 0
		}
		fb = single_reg_assign(cast(Block, s.else_))
		if cast(i64, fb) == 0 || cast(i64, cast(Sym, cast(IdentExpr, fb.target).ref)) != cast(i64, x) {
			return 0
		}
	}
	if op_cost(ta.value) > 6 || (cast(i64, fb) != 0 && op_cost(fb.value) > 6) || t_count < 4 || f_count < 4 {
		return 0
	}
	let a = gen_val(ta.value, 0)
	mut d = next_depth(a, 0)
	mut b = x.reg
	if cast(i64, fb) != 0 {
		b = gen_val(fb.value, d)
		d = next_depth(b, d)
	}
	let cc = gen_flags(c, d)
	if is_fp(x.reg) != 0 {
		emit4(I_FCSEL, x.reg, a, b, cc)
	} else {
		emit4(I_CSEL, x.reg, a, b, cc)
	}
	return 1
}

// ---- functions ----
// param_only reports whether e reads nothing but parameters and constants, with no calls.
fn param_only(e i64, np i64) i64 {
	let k = cast(Node, e).kind
	if k == EX_INT || k == EX_FLOAT {
		return 1
	}
	if k == EX_IDENT {
		let s = cast(Sym, cast(IdentExpr, e).ref)
		return i64(s.kind == SYM_CONST || (s.kind == SYM_LOCAL && s.slot < np))
	}
	if k == EX_UNARY {
		return i64(cast(Unary, e).op != "&" && param_only(cast(Unary, e).x, np) != 0)
	}
	if k == EX_BINARY {
		return i64(param_only(cast(Binary, e).l, np) != 0 && param_only(cast(Binary, e).r, np) != 0)
	}
	return 0
}

// exit_pattern returns f's leading `if c { return v; }` when c and v only read
// parameters, else 0.
fn exit_pattern(f Fn) i64 {
	if f.extern_ != 0 || f.body == 0 || len(f.rtypes) > 1 {
		return 0
	}
	let stmts = cast(Block, f.body).stmts
	if len(stmts) < 2 {
		return 0
	}
	let s = stmts[0]
	if cast(Node, s).kind != ST_IF || cast(IfStmt, s).else_ != 0 || len(cast(Block, cast(IfStmt, s).then).stmts) != 1 {
		return 0
	}
	let r = cast(Block, cast(IfStmt, s).then).stmts[0]
	let np = len(f.params)
	if cast(Node, r).kind != ST_RETURN || cast(i64, cast(ReturnStmt, r).values) != 0 || param_only(cast(IfStmt, s).cond, np) == 0 || (cast(ReturnStmt, r).value != 0 && param_only(cast(ReturnStmt, r).value, np) == 0) {
		return 0
	}
	if op_cost(cast(IfStmt, s).cond) > 4 || (cast(ReturnStmt, r).value != 0 && op_cost(cast(ReturnStmt, r).value) > 4) {
		return 0
	}
	return s
}

// with_params_in_args points f's parameters at x0-x7/d0-d7 (or back at their homes)
// while code is generated for f's exit pattern outside f's own frame.
fn with_params_in_args(f Fn, homes []i64) {
	let locals = cast([]i64, f.locals)
	mut ni = 0
	mut nf = 0
	mut i = 0
	for i < len(f.params) {
		let s = cast(Sym, locals[i])
		if cast(i64, homes) != 0 {
			s.reg = homes[i]
		} else if is_float_t(f.ptypes[i]) != 0 {
			cast(Sym, s).reg = FPR + nf
			nf = nf + 1
		} else {
			cast(Sym, s).reg = ni
			ni = ni + 1
		}
		i = i + 1
	}
}

fn param_homes(f Fn) i64 {
	let homes = []i64{}
	mut i = 0
	for i < len(f.params) {
		homes = append(homes, cast(Sym, cast([]i64, f.locals)[i]).reg)
		i = i + 1
	}
	return cast(i64, homes)
}

// early_exit handles a leading `if c { return v; }` that only reads parameters before
// the frame exists, so base cases (fib's n < 2) never pay for the prologue.
fn early_exit(f i64) i64 {
	let s = cast(IfStmt, exit_pattern(cast(Fn, f)))
	if cast(i64, s) == 0 {
		return 0
	}
	let r = cast(ReturnStmt, cast(Block, s.then).stmts[0])
	// Parameters are still in x0-x7 here, and x9-x15 / d16-d23 are free for temps.
	let homes = cast([]i64, param_homes(cast(Fn, f)))
	with_params_in_args(cast(Fn, f), cast([]i64, 0))
	let saved_t = t_regs
	let saved_n = t_count
	let saved_f = f_regs
	let saved_fn = f_count
	t_regs = []i64{}
	mut i = 9
	for i <= 15 {
		t_regs = append(t_regs, i)
		i = i + 1
	}
	t_count = 7
	f_regs = []i64{}
	i = 16
	for i <= 23 {
		f_regs = append(f_regs, FPR + i)
		i = i + 1
	}
	f_count = 8
	let body_l = new_label()
	gen_cond(s.cond, body_l, 0)
	if r.value != 0 {
		gen_to(r.value, result_reg(cast(Fn, f), 0), 0)
	} else {
		emit3(I_MOVZ, 0, 0, 0)
	}
	emit1(I_RETX, 0)
	label(body_l)
	t_regs = saved_t
	t_count = saved_n
	f_regs = saved_f
	f_count = saved_fn
	with_params_in_args(cast(Fn, f), homes)
	return 1
}

// holds_temp reports whether e's value would occupy a temp register (locals and
// constants are used in place).
fn holds_temp(e i64) i64 {
	let k = cast(Node, e).kind
	return i64(!(k == EX_IDENT && cast(Sym, cast(IdentExpr, e).ref).kind != SYM_GLOBAL) && is_const(e) == 0)
}

// cross_calls reports whether evaluating e keeps a temp alive across a call.
fn cross_calls(e i64) i64 {
	if e == 0 {
		return 0
	}
	let k = cast(Node, e).kind
	if k == EX_BINARY {
		if holds_temp(cast(Binary, e).l) != 0 && contains_call(cast(Binary, e).r) != 0 {
			return 1
		}
		return i64(cross_calls(cast(Binary, e).l) != 0 || cross_calls(cast(Binary, e).r) != 0)
	}
	if k == EX_INDEX {
		if holds_temp(cast(IndexExpr, e).x) != 0 && contains_call(cast(IndexExpr, e).i) != 0 {
			return 1
		}
		return i64(cross_calls(cast(IndexExpr, e).x) != 0 || cross_calls(cast(IndexExpr, e).i) != 0)
	}
	if k == EX_MEM {
		if holds_temp(cast(MemExpr, e).base) != 0 && (contains_call(cast(MemExpr, e).index) != 0 || contains_call(cast(MemExpr, e).len) != 0) {
			return 1
		}
		return i64(cross_calls(cast(MemExpr, e).base) != 0 || cross_calls(cast(MemExpr, e).index) != 0)
	}
	if k == EX_ELEM {
		if holds_temp(cast(ElemExpr, e).seq) != 0 && contains_call(cast(ElemExpr, e).idx) != 0 {
			return 1
		}
		return i64(cross_calls(cast(ElemExpr, e).seq) != 0 || cross_calls(cast(ElemExpr, e).idx) != 0)
	}
	if k == EX_UNARY {
		return cross_calls(cast(Unary, e).x)
	}
	if k == EX_CONV {
		return cross_calls(cast(Conv, e).x)
	}
	if k == EX_SEQ {
		return 1
	}
	if k == EX_CALL {
		let args = cast(Call, e).args
		mut calls = 0
		mut i = len(args) - 1
		for i >= 0 {
			let a = args[i]
			if cross_calls(a) != 0 || (calls != 0 && speculable(a) == 0) {
				return 1
			}
			if contains_call(a) != 0 {
				calls = calls + 1
			}
			i = i - 1
		}
	}
	return 0
}

fn stmts_cross_calls(stmts []i64) i64 {
	mut i = 0
	for i < len(stmts) {
		if stmt_cross_calls(stmts[i]) != 0 {
			return 1
		}
		i = i + 1
	}
	return 0
}

fn stmt_cross_calls(s i64) i64 {
	if s == 0 {
		return 0
	}
	let k = cast(Node, s).kind
	if k == ST_LET {
		return cross_calls(cast(LetStmt, s).init)
	}
	if k == ST_ASSIGN {
		let t = cast(Node, cast(AssignStmt, s).target)
		return i64(cross_calls(cast(AssignStmt, s).value) != 0 || ((t.kind == EX_INDEX || t.kind == EX_MEM || t.kind == EX_ELEM) && (cross_calls(cast(i64, t)) != 0 || contains_call(cast(AssignStmt, s).value) != 0)))
	}
	if k == ST_EXPR {
		return cross_calls(cast(ExprStmt, s).x)
	}
	if k == ST_RETURN {
		if cast(i64, cast(ReturnStmt, s).values) != 0 {
			return 1
		}
		return i64(cast(ReturnStmt, s).value != 0 && cross_calls(cast(ReturnStmt, s).value) != 0)
	}
	if k == ST_BLOCK {
		return stmts_cross_calls(cast(Block, s).stmts)
	}
	if k == ST_IF {
		return i64(cross_calls(cast(IfStmt, s).cond) != 0 || stmt_cross_calls(cast(IfStmt, s).then) != 0 || stmt_cross_calls(cast(IfStmt, s).else_) != 0)
	}
	if k == ST_WHILE {
		return i64(cross_calls(cast(WhileStmt, s).cond) != 0 || stmt_cross_calls(cast(WhileStmt, s).body) != 0 || stmt_cross_calls(cast(WhileStmt, s).post) != 0)
	}
	return 0
}

// assign_homes gives each local a register or frame slot and builds the temp pools.
// It returns the number of frame slots.
fn assign_homes(f Fn) i64 {
	let locals = cast([]i64, f.locals)
	let leaf = f.leaf
	let pool = []i64{}
	let fpool = []i64{}
	mut r = 0
	if leaf != 0 {
		r = 9
		for r <= 15 {
			pool = append(pool, r)
			r = r + 1
		}
		r = 16
		for r <= 30 {
			fpool = append(fpool, FPR + r)
			r = r + 1
		}
	}
	r = 19
	for r <= 27 {
		pool = append(pool, r)
		r = r + 1
	}
	r = 8
	for r <= 15 {
		fpool = append(fpool, FPR + r)
		r = r + 1
	}
	mut nslots = 0
	mut i = 0
	for i < len(locals) {
		let s = cast(Sym, locals[i])
		s.reg = REG_DEAD
		if is_dyn_value(cast(Ty, s.type_)) != 0 {
			s.addr = 1
			cast(Sym, s).words = 2
		}
		if s.addr != 0 {
			cast(Sym, s).reg = REG_SLOT
			mut nw = 1
			if cast(Sym, s).words > 1 {
				nw = cast(Sym, s).words
			}
			s.off = 16 + 8 * nslots
			nslots = nslots + nw
		}
		i = i + 1
	}
	// Hand out registers by descending loop-weighted use count.
	mut next = 0
	mut fnext = 0
	for {
		mut best = cast(Sym, 0)
		i = 0
		for i < len(locals) {
			let c = cast(Sym, locals[i])
			if cast(Sym, c).reg == REG_DEAD && cast(Sym, c).uses > 0 && (cast(i64, best) == 0 || c.uses > best.uses) {
				best = cast(Sym, c)
			}
			i = i + 1
		}
		if cast(i64, best) == 0 {
			break
		}
		if is_float_t(best.type_) != 0 && fnext < len(fpool) {
			best.reg = fpool[fnext]
			used_fregs = used_fregs | (1 << (best.reg - FPR))
			fnext = fnext + 1
		} else if is_float_t(best.type_) == 0 && next < len(pool) {
			best.reg = pool[next]
			used_regs = used_regs | (1 << best.reg)
			next = next + 1
		} else {
			best.reg = REG_SLOT
			best.off = 16 + 8 * nslots
			nslots = nslots + 1
		}
	}
	let cross = i64(leaf == 0 && stmts_cross_calls(cast(Block, f.body).stmts) != 0)
	t_regs = []i64{}
	f_regs = []i64{}
	if leaf != 0 {
		r = 0
		for r <= 8 {
			t_regs = append(t_regs, r)
			r = r + 1
		}
		for next < len(pool) && pool[next] <= 15 {
			t_regs = append(t_regs, pool[next])
			next = next + 1
		}
		r = 0
		for r <= 7 {
			f_regs = append(f_regs, FPR + r)
			r = r + 1
		}
		for fnext < len(fpool) && fpool[fnext] >= FPR + 16 {
			f_regs = append(f_regs, fpool[fnext])
			fnext = fnext + 1
		}
	} else {
		// Leftover callee-saved registers survive calls for free; caller-saved ones
		// cost nothing in the prologue. Prefer whichever this function needs.
		if cross != 0 {
			for next < len(pool) {
				t_regs = append(t_regs, pool[next])
				next = next + 1
			}
			for fnext < len(fpool) {
				f_regs = append(f_regs, fpool[fnext])
				fnext = fnext + 1
			}
		}
		r = 9
		for r <= 15 {
			t_regs = append(t_regs, r)
			r = r + 1
		}
		t_regs = append(t_regs, 8)
		r = 16
		for r <= 30 {
			f_regs = append(f_regs, FPR + r)
			r = r + 1
		}
		for next < len(pool) {
			t_regs = append(t_regs, pool[next])
			next = next + 1
		}
		for fnext < len(fpool) {
			f_regs = append(f_regs, fpool[fnext])
			fnext = fnext + 1
		}
	}
	t_count = len(t_regs)
	f_count = len(f_regs)
	return nslots
}

// ---- hand-assembled functions ----
//
// seal.hw_blocks(state, data, nblocks, k) runs the SHA-256 compression function over
// nblocks 64-byte blocks with the ARMv8 SHA-256 instructions (every Apple Silicon core
// has them). Only caller-saved registers are used: x0-x3, v0-v7, v16-v20.
fn q_ldp(t1 i64, t2 i64, n i64, off i64) i64 {
	return 0xAD400000 | (((off >> 4) & 0x7f) << 15) | (t2 << 10) | (n << 5) | t1
}

fn q_stp(t1 i64, t2 i64, n i64, off i64) i64 {
	return 0xAD000000 | (((off >> 4) & 0x7f) << 15) | (t2 << 10) | (n << 5) | t1
}

fn q_ldr(t i64, n i64, off i64) i64 {
	return 0x3DC00000 | ((off >> 4) << 10) | (n << 5) | t
}

fn v3(op i64, d i64, n i64, m i64) i64 {
	return op | (m << 16) | (n << 5) | d
}

fn raw(v []i64, word i64) {
	v = append(v, word)
}

fn sha256_hw_words() i64 {
	let w = []i64{}
	raw(w, q_ldp(0, 1, 0, 0))
	let loop_ = len(w)
	raw(w, q_ldp(4, 5, 1, 0))
	raw(w, q_ldp(6, 7, 1, 32))
	raw(w, 0x91010021)
	mut r = 4
	for r <= 7 {
		raw(w, 0x6E200800 | (r << 5) | r)
		r = r + 1
	}
	raw(w, v3(0x4EA01C00, 16, 0, 0))
	raw(w, v3(0x4EA01C00, 17, 1, 1))
	mut i = 0
	for i < 16 {
		let wi = 4 + i % 4
		raw(w, q_ldr(20, 3, 16 * i))
		raw(w, v3(0x4EA08400, 20, 20, wi))
		if i < 12 {
			raw(w, 0x5E282800 | ((4 + (i + 1) % 4) << 5) | wi)
		}
		raw(w, v3(0x4EA01C00, 18, 0, 0))
		raw(w, v3(0x5E004000, 0, 1, 20))
		raw(w, v3(0x5E005000, 1, 18, 20))
		if i < 12 {
			raw(w, v3(0x5E006000, wi, 4 + (i + 2) % 4, 4 + (i + 3) % 4))
		}
		i = i + 1
	}
	raw(w, v3(0x4EA08400, 0, 0, 16))
	raw(w, v3(0x4EA08400, 1, 1, 17))
	raw(w, 0xF1000442)
	let back = (loop_ - len(w)) & 0x7ffff
	raw(w, 0x54000000 | (back << 5) | 1)
	raw(w, q_stp(0, 1, 0, 0))
	raw(w, 0xD65F03C0)
	return cast(i64, w)
}

// gen_raw_fn emits f as the hand-assembled words.
fn gen_raw_fn(f i64, words []i64) {
	out4(I_FUNC, f, 0, 0, 0)
	mut i = 0
	for i < len(words) {
		out4(I_RAW, words[i], 0, 0, 0)
		i = i + 1
	}
}

fn gen_dyn_table_init() {
	mut i = 0
	for i < len(dyn_tables) {
		let rec = cast(DynTable, dyn_tables[i])
		let keep_ = rec.keep_
		let methods = rec.fns
		let start = rec.slot
		mut j = 0
		for j <= len(methods) {
			mut f = cast(Fn, keep_)
			if j > 0 {
				f = cast(Fn, methods[j - 1])
			}
			let desc = sym_ref(SK_FNDESC, f.index)
			let slot = sym_ref(SK_VAR, start + j)
			emit2(I_ADRP, X16, desc)
			emit3(I_ADDLO, X16, X16, desc)
			emit2(I_ADRP, X17, slot)
			emit3(I_ADDLO, X17, X17, slot)
			emit3(I_STR, X16, X17, 0)
			j = j + 1
		}
		i = i + 1
	}
}

// task_swap_words is rt_task_swap(from x0, to x1): store x19-x27, x29, x30, sp and
// d8-d15 at from, load them from to, and return on the other stack.
fn task_swap_words() i64 {
	let w = []i64{}
	let hex = "a9005013a9015815a9026017a9036819a904741b910003e9a905241e6d0624086d072c0a6d08340c6d093c0ea9405033a9415835a9426037a9436839a944743ba945243e9100013f6d4624286d472c2a6d48342c6d493c2ed65f03c0"
	mut i = 0
	for i < len(hex) {
		w = append(w, hex_word(hex, i))
		i = i + 8
	}
	return cast(i64, w)
}

fn hex_word(s str, off i64) i64 {
	mut v = 0
	mut i = 0
	for i < 8 {
		let c = i64(s[off + i])
		mut d = c - '0'
		if c >= 'a' {
			d = c - 'a' + 10
		}
		v = v * 16 + d
		i = i + 1
	}
	return v
}

// Stack parameters are below the callee's frame. finish_fn patches the byte offset once
// it knows the complete frame size, which includes locals and saved registers.
fn gen_stack_param_load(dst i64, incoming_off i64) {
	let instruction = len(cg) / 5
	emit3(I_LDR, dst, FP, 0)
	incoming_stack_loads = append(incoming_stack_loads, instruction)
	incoming_stack_loads = append(incoming_stack_loads, incoming_off)
}

// The bulk memory loops preserve every callee-saved register and the core context.
fn memory_words(fill i64) i64 {
	let w = []i64{}
	if fill == 0 {
		raw(w, 0xb4000122)
		raw(w, 0xad400420)
		raw(w, 0xad410c22)
		raw(w, 0xad000400)
		raw(w, 0xad010c02)
		raw(w, 0x91010000)
		raw(w, 0x91010021)
		raw(w, 0xf1000442)
		raw(w, 0x54ffff21)
	} else {
		raw(w, 0xb40000e2)
		raw(w, 0x4e080c20)
		raw(w, 0xad000000)
		raw(w, 0xad010000)
		raw(w, 0x91010000)
		raw(w, 0xf1000442)
		raw(w, 0x54ffff81)
	}
	raw(w, 0xd65f03c0)
	return cast(i64, w)
}

// Raw Linux leaves preserve the Tin context and all callee-saved registers.
fn syscall_words(restorer i64) i64 {
	let w = []i64{}
	if restorer != 0 {
		raw(w, 0xd2801168)
		raw(w, 0xd4000001)
		return cast(i64, w)
	}
	raw(w, 0xaa0003e8)
	raw(w, 0xaa0103e0)
	raw(w, 0xaa0203e1)
	raw(w, 0xaa0303e2)
	raw(w, 0xaa0403e3)
	raw(w, 0xaa0503e4)
	raw(w, 0xaa0603e5)
	raw(w, 0xd4000001)
	raw(w, 0xd65f03c0)
	return cast(i64, w)
}

// fn_polls keeps trusted runtime leaves and explicit @nopoll bodies uninterrupted.
shared mut compiler_polls i64
shared mut polls_auto i64       // a program that starts cores gets polls without -polls (#341)
shared mut polls_user_only i64  // they were turned on that way: the standard library (lib/) does not poll

fn fn_polls(f Fn) i64 {
	if compiler_polls == 0 || cast(i64, f) == start_fn {
		return 0
	}
	if polls_user_only != 0 && file_in_lib(f.file) != 0 {
		return 0
	}
	let path = files[f.file]
	mut i = 0
	let n = len(path)
	for i < n {
		if file_trusted[f.file] != 0 && (str_has_at(path, i, "/lib/runtime/") || (i == 0 && str_has_at(path, 0, "lib/runtime/"))) {
			return 0
		}
		i = i + 1
	}
	let attrs = f.attrs
	i = 0
	for cast(i64, attrs) != 0 && i < len(attrs) {
		if cast(Attr, attrs[i]).name == "nopoll" {
			return 0
		}
		i = i + 1
	}
	return 1
}

shared mut poll_sites []i64
shared mut lib_files []i64 // per file: 1 in the standard library (<root>/lib/), 2 not, 0 not yet known

fn file_in_lib(file i64) i64 {
	if cast(i64, lib_files) == 0 {
		lib_files = slice_filled(len(files), 0)
	}
	if lib_files[file] == 0 {
		lib_files[file] = 2 - path_in_root_dir(files[file], "/lib/")
	}
	return i64(lib_files[file] == 1)
}

// gen_poll branches to a cold stub; the ordinary path uses only the reserved scratch.
fn gen_poll() {
	if fn_polls(cast(Fn, cur_gen_fn)) == 0 {
		return
	}
	let slow = new_label()
	let resume = new_label()
	emit3(I_LDR, X16, 28, 96)
	emit2(I_CBNZ, X16, slow)
	label(resume)
	poll_sites = append(poll_sites, slow)
	poll_sites = append(poll_sites, resume)
}

// gen_poll_stubs preserves leaf homes too: a stale watchdog write may return normally.
fn gen_poll_stubs() {
	let f = find_fn("rt_bnd_poll")
	mut i = 0
	for i < len(poll_sites) {
		label(poll_sites[i])
		emit3(I_SUBI, SP, SP, 416)
		mut r = 0
		for r < 19 {
			emit3(I_STR, r, SP, 8 * r)
			r = r + 1
		}
		emit3(I_STR, LR, SP, 152)
		r = 0
		for r < 32 {
			emit3(I_STRD, FPR + r, SP, 160 + 8 * r)
			r = r + 1
		}
		emit1(I_BL, cast(i64, f))
		r = 0
		for r < 32 {
			emit3(I_LDRD, FPR + r, SP, 160 + 8 * r)
			r = r + 1
		}
		r = 0
		for r < 19 {
			emit3(I_LDR, r, SP, 8 * r)
			r = r + 1
		}
		emit3(I_LDR, LR, SP, 152)
		emit3(I_ADDI, SP, SP, 416)
		emit1(I_B, poll_sites[i + 1])
		i = i + 2
	}
}

fn gen_fn(f Fn) {
	if tgt_linux != 0 {
		let words = cast([]i64, syscall_fast_arm64(f.qname))
		if cast(i64, words) != 0 {
			out4(I_FUNC, cast(i64, f), 0, 0, 0)
			if f.qname == "rt_sys_clock_gettime" {
				let s = lookup_global("rtVdsoClock")
				let sym = sym_ref(SK_VAR, s.index)
				out4(I_ADRP, 2, sym, 0, 0)
				out4(I_LDRLO, 2, 2, sym, 0)
			}
			mut i = 0
			for i < len(words) {
				out4(I_RAW, words[i], 0, 0, 0)
				i = i + 1
			}
			return
		}
	}
	if f.qname == "memcpy" || f.qname == "memmove" || f.qname == "memset" || f.qname == "memcmp" || f.qname == "memchr" {
		gen_raw_fn(cast(i64, f), cast([]i64, memory_fast_arm64(f.qname)))
		return
	}

	if tgt_linux != 0 && (f.qname == "linux_raw" || f.qname == "linux_restorer") {
		gen_raw_fn(cast(i64, f), cast([]i64, syscall_words(i64(f.qname == "linux_restorer"))))
		return
	}
	if f.qname == "mem_copy64" || f.qname == "mem_fill64" {
		gen_raw_fn(cast(i64, f), cast([]i64, memory_words(i64(f.qname == "mem_fill64"))))
		return
	}
	if f.qname == "seal.hw_blocks" {
		gen_raw_fn(cast(i64, f), cast([]i64, sha256_hw_words()))
		return
	}
	if aes_hw_arm64(f.qname) != 0 {
		gen_raw_fn(cast(i64, f), cast([]i64, aes_hw_arm64(f.qname)))
		return
	}
	if f.qname == "rt_task_swap" {
		gen_raw_fn(cast(i64, f), cast([]i64, task_swap_words()))
		return
	}
	cur_gen_fn = cast(i64, f)
	trap_label = 0
	div_label = 0
	trap_sites = []i64{}
	ovf_labels = make([]i64, OVK_COUNT)
	poll_sites = []i64{}
	if host_getenv("TINC_TRACE") != 0 {
		let tb = buf_new()
		buf_str(tb, "gen ")
		buf_str(tb, f.qname)
		buf_byte(tb, '\n')
		write_all(2, cast([]u8, cast([]i64, tb)))
	}
	inline_appends(f)
	ovf_elide_fn(f)
	licm_fn(f)
	analyze_fn(f)
	used_regs = 0
	used_fregs = 0
	slice_truncate(g_loops, 0)
	slice_truncate(g_loop_labels, 0)
	let nslots = assign_homes(f)
	cg = []i64{}
	incoming_stack_loads = []i64{}
	mut early = 0
	if fn_polls(f) == 0 {
		early = early_exit(cast(i64, f))
	}
	let pre = cast([]i64, cg)
	cg = []i64{}
	let locals = cast([]i64, f.locals)
	mut ni = 0
	mut nf = 0
	mut stack_words = 0
	mut i = 0
	for i < len(f.params) {
		let s = cast(Sym, locals[i])
		mut src = 0
		if is_dyn_value(cast(Ty, f.ptypes[i])) != 0 {
			let stack = i64(ni + 1 >= 8)
			if stack != 0 {
				ni = 8
				stack_words = align_up(stack_words, 2)
				gen_stack_param_load(X16, 8 * stack_words)
				gen_stack_param_load(X17, 8 * stack_words + 8)
				stack_words = stack_words + 2
				src = X16
			} else {
				src = ni
				ni = ni + 2
			}
			if s.reg == REG_SLOT {
				emit3(I_STR, src, FP, s.off)
				if stack != 0 {
					emit3(I_STR, X17, FP, s.off + 8)
				} else {
					emit3(I_STR, src + 1, FP, s.off + 8)
				}
			} else {
				err_code_at(s.pos, "E990 INTERNAL", "dyn parameter is not in a two-word frame slot")
			}
			i = i + 1
			continue
		} else if is_float_t(f.ptypes[i]) != 0 {
			src = FPR + nf
			nf = nf + 1
		} else {
			if ni >= 8 {
				gen_stack_param_load(X16, 8 * stack_words)
				stack_words = stack_words + 1
				src = X16
			} else {
				src = ni
				ni = ni + 1
			}
		}
		if cast(Sym, s).reg >= 0 {
			mov(cast(Sym, s).reg, src)
		} else if cast(Sym, s).reg == REG_SLOT {
			if is_fp(src) != 0 {
				emit3(I_STRD, src, FP, s.off)
			} else {
				emit3(I_STR, src, FP, s.off)
			}
		}
		i = i + 1
	}
	if f.env_sym != 0 {
		let es = cast(Sym, f.env_sym)
		if es.reg >= 0 {
			mov(es.reg, X17)
		} else if es.reg == REG_SLOT {
			emit3(I_STR, X17, FP, es.off)
		}
	}
	let stmts = cast(Block, f.body).stmts
	if cast(i64, cast(Fn, f)) == cast(i64, entry_fn()) {
		mut di = 0
		for di < len(prog_fns) {
			let df = prog_fns[di]
			if df.extern_ == 0 && df.reach != 0 {
				let code_sym = sym_ref(SK_FN, di)
				let desc_sym = sym_ref(SK_FNDESC, di)
				emit2(I_ADRP, X16, code_sym)
				emit3(I_ADDLO, X16, X16, code_sym)
				emit2(I_ADRP, X17, desc_sym)
				emit3(I_ADDLO, X17, X17, desc_sym)
				emit3(I_STR, X16, X17, 0)
			}
			di = di + 1
		}
		gen_dyn_table_init()
	}
	gen_poll()
	i = early
	for i < len(stmts) {
		gen_stmt(stmts[i])
		i = i + 1
	}
	emit3(I_MOVZ, 0, 0, 0)
	emit1(I_RET, 0)
	if trap_label != 0 {
		// The cold path every failed bounds check jumps to.
		label(trap_label)
		let bf = find_fn("rt_bounds_fail")
		if cast(i64, bf) != 0 {
			emit1(I_BL, cast(i64, bf))
			bf.used = 1
		}
	}
	if div_label != 0 {
		label(div_label)
		let df = find_fn("rt_div_fail")
		if cast(i64, df) != 0 {
			emit1(I_BL, cast(i64, df))
			df.used = 1
		}
	}
	gen_ovf_stubs()
	// Per-site stubs: the index and length go through the stack into x0/x1 (any registers).
	mut ts = 0
	let bf2 = find_fn("rt_bounds_fail2")
	for ts < len(trap_sites) {
		let site = cast(TrapSite, trap_sites[ts])
		label(site.label)
		mut ireg = site.index_reg
		if ireg < 0 {
			load_imm(X16, site.const_index)
			ireg = X16
		}
		emit3(I_STPPRE, ireg, site.len_reg, -16)
		emit3(I_LDR, 0, SP, 0)
		emit3(I_LDR, 1, SP, 8)
		if cast(i64, bf2) != 0 {
			emit1(I_BL, cast(i64, bf2))
			bf2.used = 1
		}
		ts = ts + 1
	}
	gen_poll_stubs()
	finish_fn(f, nslots, pre)
}

fn out4(op i64, a i64, b i64, c i64, d i64) {
	code = append(code, cast(Fn, op))
	code = append(code, cast(Fn, a))
	code = append(code, cast(Fn, b))
	code = append(code, cast(Fn, c))
	code = append(code, cast(Fn, d))
}

// save_regs stores (or, with load, reloads) callee-saved registers in pairs.
fn save_regs(saved []i64, base i64, load i64) {
	mut i = 0
	for i < len(saved) {
		let off = base + 8 * i
		let r = saved[i]
		let fp = is_fp(r)
		if i + 1 < len(saved) && off + 8 <= 504 && is_fp(saved[i + 1]) == fp {
			mut op = I_STP
			if fp != 0 && load != 0 {
				op = I_LDPD
			} else if fp != 0 {
				op = I_STPD
			} else if load != 0 {
				op = I_LDP
			}
			out4(op, r, saved[i + 1], FP, off)
			i = i + 2
		} else {
			mut op1 = I_STR
			if fp != 0 && load != 0 {
				op1 = I_LDRD
			} else if fp != 0 {
				op1 = I_STRD
			} else if load != 0 {
				op1 = I_LDR
			}
			out4(op1, r, FP, off, 0)
			i = i + 1
		}
	}
}

// branch_to_next reports whether the branch at instruction i only skips labels to reach its target.
fn branch_to_next(i i64, n i64) i64 {
	let target = cg[5 * i + 1]
	mut j = i + 1
	for j < n && cg[5 * j] == I_LABEL {
		if cg[5 * j + 1] == target {
			return 1
		}
		j = j + 1
	}
	return 0
}

// label_follows reports whether only labels separate instruction i from label l.
fn label_follows(i i64, n i64, l i64) i64 {
	mut j = i
	for j < n && cg[5 * j] == I_LABEL {
		if cg[5 * j + 1] == l {
			return 1
		}
		j = j + 1
	}
	return 0
}

// cond_branch_target returns the label of a conditional branch, or -1.
fn cond_branch_target(k i64) i64 {
	let op = cg[k]
	if op == I_BCOND || op == I_CBZ || op == I_CBNZ {
		return cg[k + 2]
	}
	if op == I_TBZ || op == I_TBNZ {
		return cg[k + 3]
	}
	return -1
}

// emit_inverted copies conditional branch k with its sense flipped, aimed at label l.
fn emit_inverted(k i64, l i64) {
	let op = cg[k]
	let a = cg[k + 1]
	if op == I_BCOND {
		out4(I_BCOND, a ^ 1, l, 0, 0)
	} else if op == I_CBZ {
		out4(I_CBNZ, a, l, 0, 0)
	} else if op == I_CBNZ {
		out4(I_CBZ, a, l, 0, 0)
	} else if op == I_TBZ {
		out4(I_TBNZ, a, cg[k + 2], l, 0)
	} else {
		out4(I_TBZ, a, cg[k + 2], l, 0)
	}
}

// finish_fn wraps the body in its prologue and epilogues and drops unreachable code.
fn finish_fn(f Fn, nslots i64, pre []i64) {
	let saved = []i64{}
	mut r = 19
	for r <= 27 {
		if (used_regs >> r) & 1 != 0 {
			saved = append(saved, r)
		}
		r = r + 1
	}
	r = 8
	for r <= 15 {
		if (used_fregs >> r) & 1 != 0 {
			saved = append(saved, FPR + r)
		}
		r = r + 1
	}
	let slot_bytes = align_up(8 * nslots, 16)
	let frame = 16 + slot_bytes + align_up(8 * len(cast([]i64, saved)), 16)
	mut j = 0
	for j < len(incoming_stack_loads) {
		let instruction = incoming_stack_loads[j]
		let incoming_off = incoming_stack_loads[j + 1]
		cg[5 * instruction + 3] = frame + incoming_off
		j = j + 2
	}
	let frameless = i64(f.leaf != 0 && nslots == 0 && len(cast([]i64, saved)) == 0 && len(incoming_stack_loads) == 0)
	if frame > MAX_FRAME {
		err_code_quoted(f.pos, "E905 TOO_MANY_LOCALS", "function ", f.name, " has too many local variables")
	}
	out4(I_FUNC, cast(i64, f), 0, 0, 0)
	j = 0
	for j < len(pre) {
		out4(pre[j], pre[j + 1], pre[j + 2], pre[j + 3], pre[j + 4])
		j = j + 5
	}
	if frameless == 0 {
		if frame <= 504 {
			out4(I_STPPRE, FP, LR, -frame, 0)
		} else {
			out4(I_SUBI, SP, SP, frame, 0)
			out4(I_STP, FP, LR, SP, 0)
		}
		out4(I_ADDI, FP, SP, 0, 0)
		save_regs(cast([]i64, saved), 16 + slot_bytes, 0)
	}
	let n = len(cg) / 5
	mut dead = 0
	mut i = 0
	for i < n {
		let op = cg[5 * i]
		if op == I_LABEL {
			dead = 0
		}
		if dead != 0 || (op == I_B && branch_to_next(i, n) != 0) {
			i = i + 1
			continue
		}
		// b.cond L1; b L2; L1:  becomes  b.!cond L2; L1:
		let t1 = cond_branch_target(5 * i)
		if t1 >= 0 && i + 1 < n && cg[5 * (i + 1)] == I_B && label_follows(i + 2, n, t1) != 0 {
			emit_inverted(5 * i, cg[5 * (i + 1) + 1])
			i = i + 2
			continue
		}
		if op == I_RET {
			if frameless == 0 {
				save_regs(cast([]i64, saved), 16 + slot_bytes, 1)
				if frame <= 504 {
					out4(I_LDPPOST, FP, LR, frame, 0)
				} else {
					out4(I_LDP, FP, LR, SP, 0)
					out4(I_ADDI, SP, SP, frame, 0)
				}
			}
			out4(I_RETX, 0, 0, 0, 0)
			dead = 1
		} else {
			let k = 5 * i
			out4(op, cg[k + 1], cg[k + 2], cg[k + 3], cg[k + 4])
			if op == I_B {
				dead = 1
			}
		}
		i = i + 1
	}
}

fn append_dyn_slot(name str) i64 {
	let index = len(prog_vars)
	let d = cast(Decl, calloc(D_SIZE, 8))
	let s = sym_new(SYM_GLOBAL, name, 0)
	s.index = index
	s.type_ = ty_int
	d.name = name
	d.val = 0
	d.sym = cast(i64, s)
	prog_vars = append(prog_vars, cast(Decl, d))
	return index
}

// dyn_layout reserves the second word of global dyn values and lays out each static
// (concrete type, shape) method table as consecutive global words.
fn dyn_layout() {
	let original = len(prog_vars)
	mut i = 0
	for i < original {
		let v = prog_vars[i]
		let s = cast(Sym, v.sym)
		if cast(i64, s) != 0 && is_dyn_value(cast(Ty, s.type_)) != 0 && s.tls == 0 {
			mut b = buf_new()
			buf_str(b, "__dyn_global_")
			buf_int(b, i)
			buf_str(b, "_table")
			s.words = append_dyn_slot(str(b))
		}
		i = i + 1
	}
	i = 0
	for i < len(dyn_tables) {
		let rec = cast(DynTable, dyn_tables[i])
		mut b = buf_new()
		buf_str(b, "__dyn_table_")
		buf_int(b, i)
		rec.slot = len(prog_vars)
		append_dyn_slot(str(b))
		let fs = rec.fns
		mut j = 0
		for j < len(fs) {
			b = buf_new()
			buf_str(b, "__dyn_table_")
			buf_int(b, i)
			buf_byte(b, '_')
			buf_int(b, j + 1)
			append_dyn_slot(str(b))
			j = j + 1
		}
		i = i + 1
	}
}

fn generate() {
	dyn_layout()
	if tgt_x64 != 0 {
		generate_x64()
		return
	}
	code = cast([]Fn, []i64{})
	g_labels = 0
	g_str_ptrs = []str{}
	g_str_lens = []i64{}
	g_tstr_ptrs = []str{}
	g_tstr_lens = []i64{}
	g_loops = []i64{}
	g_loop_labels = []str{}
	mut i = 0
	for i < len(prog_fns) {
		prog_fns[i].index = i
		i = i + 1
	}
	inline_small_calls()
	i = 0
	for i < len(prog_fns) {
		let f = prog_fns[i]
		if f.extern_ == 0 && f.reach != 0 {
			gen_fn(f)
		}
		i = i + 1
	}
}

// print_asm renders the program as clang-compatible assembly (tinc -S).
fn print_asm() i64 {
	let b = buf_new()
	buf_str(b, "\t.section\t__TEXT,__text,regular,pure_instructions\n")
	mut i = 0
	for i < len(code) {
		print_ins(cast([]u8, b), slice_data(code) + 8 * i)
		i = i + 5
	}
	if len(prog_vars) > 0 || len(prog_fns) > 0 {
		buf_str(b, "\t.section\t__DATA,__data\n\t.p2align\t3\n")
		i = 0
		for i < len(prog_vars) {
			let v = prog_vars[i]
			buf_str(b, "_")
			buf_str(b, var_label(v))
			buf_str(b, ":\n\t.quad ")
			buf_int(b, v.val)
			buf_byte(b, '\n')
			i = i + 1
		}
		mut di = 0
		for di < len(prog_fns) {
			let df = prog_fns[di]
			if df.extern_ == 0 && df.reach != 0 {
				buf_str(b, "_")
				buf_str(b, df.qname)
				buf_str(b, "$desc:\n\t.space 16\n")
			}
			di = di + 1
		}
	}
	if len(g_str_ptrs) > 0 {
		buf_str(b, "\t.section\t__TEXT,__cstring,cstring_literals\n")
		i = 0
		for i < len(g_str_ptrs) {
			buf_str(b, "l_.str.")
			buf_int(b, i)
			buf_str(b, ":\n\t.asciz \"")
			asm_escape(cast([]u8, b), g_str_ptrs[i], g_str_lens[i])
			buf_str(b, "\"\n")
			i = i + 1
		}
	}
	buf_str(b, "\t.section\t__TEXT,__const\n\t.p2align\t3\nl_.zero:\n\t.space 32\n")
	if len(g_tstr_ptrs) > 0 {
		i = 0
		for i < len(g_tstr_ptrs) {
			buf_str(b, "\t.p2align\t3\nl_.tstr.")
			buf_int(b, i)
			buf_str(b, ":\n\t.quad ")
			buf_int(b, g_tstr_lens[i])
			buf_str(b, "\n\t.asciz \"")
			asm_escape(cast([]u8, b), g_tstr_ptrs[i], g_tstr_lens[i])
			buf_str(b, "\"\n")
			i = i + 1
		}
	}
	return cast(i64, b)
}

// var_label is a global's symbol name (package-qualified).
fn var_label(v Decl) str {
	return cast(Sym, v.sym).name
}

// asm_escape writes bytes the assembler's string syntax can't hold as octal escapes.
fn asm_escape(b []u8, s str, n i64) {
	mut i = 0
	for i < n {
		let c = i64(s[i])
		if c == '"' || c == '\\' {
			buf_byte(b, '\\')
			buf_byte(b, c)
		} else if c >= 32 && c < 127 {
			buf_byte(b, c)
		} else {
			buf_byte(b, '\\')
			buf_byte(b, '0' + ((c >> 6) & 7))
			buf_byte(b, '0' + ((c >> 3) & 7))
			buf_byte(b, '0' + (c & 7))
		}
		i = i + 1
	}
}
