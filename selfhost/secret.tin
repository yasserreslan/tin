// secret T (design_semantics section 9, #239): a type qualifier the checker tracks and the
// runtime never sees. A secret type is a twin of its plain type: a copy of the type record
// that every back end reads exactly as the plain type, marked with TY_SECRET. The checker
// keeps twins away from sinks (formatting, logging, JSON, fault messages, panics and any
// parameter not declared secret), propagates them through expressions, and lets reveal(x)
// turn one back into its plain type. Every reveal, and every secret handed to a library
// parameter declared secret, is listed by `tin audit secrets` (tinc -audit-secrets).
//
// Diagnostics: every secret error is reported by one function below, so #244 can give each
// its code in one place.
//   secret_sink_error     SECRET_SINK     a sink would print, encode or carry a secret
//   secret_assign_error   SECRET_ASSIGN   a secret where a plain value is expected: a
//                                         parameter not declared secret, a variable, a result
//   secret_compare_error  SECRET_COMPARE  ==, != or an ordering on a secret (seal.Equal)
//   secret_reveal_error   SECRET_REVEAL   reveal of a value that is not secret
//   secret_type_error     SECRET_TYPE     secret of a type it cannot qualify; a secret map key

var saw_secret;      // a secret type exists: until then every check here is skipped
var secret_interp;   // chk_interp is lowering an interpolation: its values may be secret
var secret_call;     // chk_args: the call whose argument check_assignable is checking
var secret_argi;     // its index
var secret_argdesc;  // how it was written
var secret_audit;    // [pos, text], sorted by position: every place a secret leaves

// secret_of returns the secret twin of t, one per type. ?T becomes ?secret T, so narrowing
// an optional keeps the secret.
fn secret_of(t) {
    if !t || t[TY_SECRET] || is_untyped(t) {
        return t;
    }
    let k = t[TY_KIND];
    if k == K_VOID || k == K_TUPLE {
        return t;
    }
    if k == K_OPT {
        return opt_of(secret_of(t[TY_ELEM]));
    }
    if !ty_secrets {
        ty_secrets = vec_new();
    }
    let i = 0;
    while i < ty_secrets[VEC_LEN] {
        let s = vec_get(ty_secrets, i);
        if s[TY_SECRET] == t {
            return s;
        }
        i = i + 1;
    }
    let n = calloc(TY_MAX + 1, 8); // every type has the bounded words (#240)
    let j = 0;
    while j < TY_SECRET {
        n[j] = t[j];
        j = j + 1;
    }
    n[TY_SECRET] = t;
    vec_push(ty_secrets, n);
    saw_secret = 1;
    return n;
}

fn is_secret(t) {
    return t && t[TY_SECRET] != 0;
}

// plain_type is the type reveal gives: t without its secret qualifier.
fn plain_type(t) {
    if t && t[TY_SECRET] {
        return t[TY_SECRET];
    }
    return t;
}

// secret_like is t, made secret when src is: an element, a field or a result computed from
// a secret is secret.
fn secret_like(src, t) {
    if is_secret(src) {
        return secret_of(t);
    }
    return t;
}

// secret_join is the type of a binary operation on a secret and a plain operand of the same
// plain type (secret str + str is secret str), or 0 when the operands do not join.
fn secret_join(a, b) {
    if !saw_secret || !(is_secret(a) || is_secret(b)) {
        return 0;
    }
    if plain_type(a) != plain_type(b) {
        return 0;
    }
    return secret_of(plain_type(a));
}

// has_secret reports whether a value of t is or holds a secret: itself, a field, an element,
// a key or a variant's data.
fn has_secret(t) {
    if !saw_secret {
        return 0;
    }
    return has_secret_in(t, vec_new());
}

fn has_secret_in(t, seen) {
    if !t {
        return 0;
    }
    if t[TY_SECRET] {
        return 1;
    }
    let k = t[TY_KIND];
    if k == K_OPT || k == K_SLICE || k == K_CHAN {
        return has_secret_in(t[TY_ELEM], seen);
    }
    if k == K_MAP {
        return has_secret_in(t[TY_KEY], seen) || has_secret_in(t[TY_ELEM], seen);
    }
    if k == K_STRUCT || k == K_TUPLE {
        if vec_index(seen, t) >= 0 {
            return 0;
        }
        vec_push(seen, t);
        let fs = t[TY_FIELDS];
        let i = 0;
        while fs && i < fs[VEC_LEN] {
            let ft = vec_get(fs, i);
            if k == K_STRUCT {
                ft = field_type(t, i);
            }
            if has_secret_in(ft, seen) {
                return 1;
            }
            i = i + 1;
        }
    }
    return 0;
}

// secret_erase is t with every secret qualifier removed from it and from the optionals,
// slices and maps it is made of: what it would be if nothing were secret.
fn secret_erase(t) {
    if !saw_secret || !t {
        return t;
    }
    if t[TY_SECRET] {
        return secret_erase(t[TY_SECRET]);
    }
    let k = t[TY_KIND];
    if k == K_OPT {
        return opt_of(secret_erase(t[TY_ELEM]));
    }
    if k == K_SLICE {
        return slice_of(secret_erase(t[TY_ELEM]));
    }
    if k == K_MAP {
        return map_of(secret_erase(t[TY_KEY]), secret_erase(t[TY_ELEM]));
    }
    return t;
}

// secret_type resolves `secret T`. It qualifies values that are copied or compared by their
// content: numbers, bool, str, slices, maps and optionals of those. A struct is marked by
// its fields instead, so its methods, shapes and identity stay what they are.
fn secret_type(tx) {
    let inner = resolve_type(tx[TX_A]);
    let k = kind_of(plain_type(inner));
    if k == K_OPT {
        k = kind_of(plain_type(inner[TY_ELEM]));
    }
    if k != K_INT && k != K_BOOL && k != K_FLOAT && k != K_STRING && k != K_SLICE && k != K_MAP {
        secret_type_error(tx[N_POS], inner);
        return inner;
    }
    return secret_of(inner);
}

// secret_map_key rejects a secret map key: finding it compares it in time that depends on it.
fn secret_map_key(pos, kt) {
    if has_secret(kt) {
        let e = err_code(pos, "E244 SECRET_MAP_KEY");
        buf_str(e, "a map key cannot be secret: a lookup compares it in time that depends on its value (key the map by a hash of it, such as seal.Sha256Hex)");
        err_end(e);
    }
}

fn secret_type_error(pos, t) {
    let e = err_code(pos, "E240 SECRET_TYPE");
    buf_str(e, "secret qualifies numbers, bool, str, slices and maps, not ");
    type_name(e, t);
    if kind_of(t) == K_STRUCT {
        buf_str(e, ": mark the struct's fields secret instead");
    }
    err_end(e);
}

// ---- how a message names a value ----

// secret_desc is how expression e was written, for a message: a name, a field path, a call,
// an index or an interpolated string; 0 for anything else. Call it before e is checked.
fn secret_desc(e) {
    if !saw_secret || !e {
        return 0;
    }
    let b = buf_new();
    if !secret_render(b, e, 0) {
        return 0;
    }
    buf_byte(b, 0);
    return b[VEC_DATA];
}

fn secret_render(b, e, depth) {
    if !e || depth > 8 {
        return 0;
    }
    let k = e[N_KIND];
    if k == EX_IDENT {
        buf_str(b, e[ID_NAME]);
        return 1;
    }
    if k == EX_SELECT {
        if !secret_render(b, e[SEL_X], depth + 1) {
            return 0;
        }
        buf_byte(b, '.');
        buf_str(b, e[SEL_NAME]);
        return 1;
    }
    if k == EX_CALL {
        if e[CALL_NAME] {
            buf_str(b, e[CALL_NAME]);
        } else if !secret_render(b, e[CALL_CALLEE], depth + 1) {
            return 0;
        }
        buf_byte(b, '(');
        let args = e[CALL_ARGS];
        let i = 0;
        while args && i < args[VEC_LEN] {
            if i > 0 {
                buf_str(b, ", ");
            }
            if !secret_render(b, vec_get(args, i), depth + 1) {
                buf_str(b, "...");
            }
            i = i + 1;
        }
        buf_byte(b, ')');
        return 1;
    }
    if k == EX_TYPE {
        return secret_render_tx(b, e[TYX]);
    }
    if k == EX_INT && !e[N_TYPE] {
        buf_int(b, e[INT_VAL]);
        return 1;
    }
    if k == EX_FLOAT && e[FL_TEXT] {
        buf_str(b, e[FL_TEXT]);
        return 1;
    }
    if k == EX_STR {
        buf_byte(b, '"');
        buf_bytes(b, e[STR_PTR], e[STR_LEN]);
        buf_byte(b, '"');
        return 1;
    }
    if k == EX_UNARY && !streq(e[UN_OP], "...") {
        buf_str(b, e[UN_OP]);
        return secret_render(b, e[UN_X], depth + 1);
    }
    if k == EX_BINARY && load8(e[BIN_OP]) != '$' {
        if !secret_render(b, e[BIN_L], depth + 1) {
            return 0;
        }
        buf_byte(b, ' ');
        buf_str(b, e[BIN_OP]);
        buf_byte(b, ' ');
        return secret_render(b, e[BIN_R], depth + 1);
    }
    if k == EX_INDEX {
        if !secret_render(b, e[IX_X], depth + 1) {
            return 0;
        }
        buf_str(b, "[...]");
        return 1;
    }
    if k == EX_INTERP {
        let parts = e[INTERP_PARTS];
        let vals = e[INTERP_ARGS];
        buf_byte(b, '"');
        let i = 0;
        while i < parts[VEC_LEN] {
            let p = vec_get(parts, i);
            buf_bytes(b, p[STR_PTR], p[STR_LEN]);
            if i < vals[VEC_LEN] {
                buf_byte(b, '{');
                if !secret_render(b, vec_get(vals, i), depth + 1) {
                    buf_str(b, "...");
                }
                buf_byte(b, '}');
            }
            i = i + 1;
        }
        buf_byte(b, '"');
        return 1;
    }
    return 0;
}

// secret_render_tx appends a conversion's type: a name or a slice of one.
fn secret_render_tx(b, tx) {
    if !tx {
        return 0;
    }
    if tx[N_KIND] == TX_SLICE {
        buf_str(b, "[]");
        return secret_render_tx(b, tx[TX_A]);
    }
    if tx[N_KIND] == TX_NAME && !tx[TX_ARGS] {
        if tx[TX_A] {
            buf_str(b, tx[TX_A]);
            buf_byte(b, '.');
        }
        buf_str(b, tx[TX_B]);
        return 1;
    }
    return 0;
}

// secret_where appends where a value of t keeps its secret: "secret field main.User.token",
// or "a secret" when it is deeper than a field of the value itself.
fn secret_where(b, t) {
    let k = kind_of(t);
    if k == K_OPT || k == K_SLICE {
        secret_where(b, t[TY_ELEM]);
        return;
    }
    if k == K_STRUCT && !t[TY_ENUM] {
        let i = 0;
        while i < t[TY_FIELDS][VEC_LEN] {
            if is_secret(field_type(t, i)) {
                buf_str(b, "secret field ");
                type_name(b, t);
                buf_byte(b, '.');
                buf_str(b, vec_get(vec_get(t[TY_FIELDS], i), 0));
                return;
            }
            i = i + 1;
        }
    }
    buf_str(b, "a secret");
}

// secret_what appends how a message names a value: "secret value token", or for a value that
// holds a secret, "u, which holds secret field main.User.token,".
fn secret_what(b, desc, t) {
    if is_secret(t) {
        if desc {
            buf_str(b, "secret value ");
            buf_str(b, desc);
        } else {
            buf_str(b, "a value of type ");
            type_name(b, t);
        }
        return;
    }
    if desc {
        buf_str(b, desc);
    } else {
        buf_str(b, "a value of type ");
        type_name(b, t);
    }
    buf_str(b, ", which holds ");
    secret_where(b, t);
    buf_byte(b, ',');
}

// secret_fix appends how to get past a secret error on purpose.
fn secret_fix(b, desc, t) {
    if !is_secret(t) {
        buf_str(b, "use a value without the secret, or reveal it on purpose");
    } else if desc && load8(desc) != '"' {
        buf_str(b, "leave it out, or write reveal(");
        buf_str(b, desc);
        buf_str(b, ") on purpose");
    } else {
        buf_str(b, "leave it out, or reveal the secret on purpose");
    }
}

// ---- the checks ----

// secret_sink_error reports a sink that would print, encode or carry a secret:
// "<before><what><after>: <fix>", such as "say.Line would print secret value token: ...".
fn secret_sink_error(pos, before, after, desc, t) {
    let e = err_code(pos, "E241 SECRET_SINK");
    buf_str(e, before);
    secret_what(e, desc, t);
    if !is_secret(t) && load8(after) == 0 {
        // "..., which holds a secret," ends the sentence without the comma.
        e[VEC_LEN] = e[VEC_LEN] - 1;
    }
    buf_str(e, after);
    buf_str(e, ": ");
    secret_fix(e, desc, t);
    err_end(e);
}

// secret_sink checks one value bound for a sink; desc is how it was written (secret_desc).
fn secret_sink(pos, before, after, desc, t) {
    if has_secret(t) {
        secret_sink_error(pos, before, after, desc, t);
        return 1;
    }
    return 0;
}

// secret_say_args checks a say call's arguments (and its format) before they are formatted.
// An interpolation formats its values into a secret str instead (secret_interp_result).
fn secret_say_args(args, m) {
    if !saw_secret || secret_interp {
        return;
    }
    let before = "say.";
    if streq(m, "Fmt") || streq(m, "Str") {
        before = str_cat3("say.", m, " would format ");
    } else if streq(m, "Fault") {
        before = "say.Fault would put ";
    } else {
        before = str_cat3("say.", m, " would print ");
    }
    let after = "";
    if streq(m, "Fault") {
        after = " in a fault message";
    }
    let first = 0;
    if streq(m, "To") || streq(m, "LineTo") {
        first = 1;
    }
    let i = first;
    while i < args[VEC_LEN] {
        let a = vec_get(args, i);
        let desc = secret_desc(a);
        let want = 0;
        if i == first && (streq(m, "Out") || streq(m, "Fmt") || streq(m, "Fault") || streq(m, "To")) {
            want = ty_string;
        }
        secret_sink(a[N_POS], before, after, desc, chk(a, want));
        i = i + 1;
    }
}

// secret_interp_result lowers an interpolation whose values were just checked: one that
// holds a secret is a secret str (design_semantics section 9, propagation).
fn secret_interp_result(e, args, want) {
    let sec = 0;
    let i = 1;
    while saw_secret && i < args[VEC_LEN] {
        if has_secret(vec_get(args, i)[N_TYPE]) {
            sec = 1;
        }
        i = i + 1;
    }
    secret_interp = sec;
    let t = lower_say(e, "Fmt", want);
    secret_interp = 0;
    if sec {
        return secret_of(t);
    }
    return t;
}

// secret_compare_error rejects == and the orderings on a secret: comparing takes time that
// depends on where the values first differ, which leaks them byte by byte.
fn secret_compare_error(pos, op, lt, rt) {
    if !saw_secret || !(has_secret(lt) || has_secret(rt)) {
        return 0;
    }
    // Comparing an optional secret with nil says only whether it is there.
    if kind_of(lt) == K_OPT || kind_of(rt) == K_OPT {
        return 0;
    }
    let e = err_code(pos, "E243 SECRET_COMPARE");
    if streq(op, "==") || streq(op, "!=") {
        buf_str(e, "cannot compare secret values with ");
        buf_str(e, op);
        buf_str(e, ": use seal.Equal, which takes the same time whatever they hold");
    } else {
        buf_str(e, "cannot order secret values with ");
        buf_str(e, op);
        buf_str(e, ": the time it takes depends on what they hold (reveal them on purpose first)");
    }
    err_end(e);
    return 1;
}

// secret_arg remembers which argument check_assignable is about to check, so a secret passed
// to a parameter not declared secret is reported against the call (secret_assign_error).
// A secret passed to a library parameter declared secret is where it leaves the program's
// hands: tin audit secrets lists it.
fn secret_arg(e, i, desc, at, want) {
    if !saw_secret {
        return;
    }
    secret_call = e;
    secret_argi = i;
    secret_argdesc = desc;
    let f = e[CALL_FN];
    if f && is_secret(want) && has_secret(at) && vec_get(file_trusted, f[F_FILE]) && !ck_trusted {
        let b = buf_new();
        secret_what(b, desc, at);
        buf_str(b, " passed to ");
        buf_str(b, e[CALL_NAME]);
        buf_str(b, " (parameter ");
        buf_str(b, vec_get(f[F_PARAMS], i));
        buf_str(b, " is declared secret) in ");
        buf_str(b, ck_fn[F_QNAME]);
        buf_byte(b, 0);
        secret_audit_add(vec_get(e[CALL_ARGS], i)[N_POS], b[VEC_DATA]);
    }
}

fn secret_arg_done() {
    secret_call = 0;
}

// secret_assign_error reports a secret used where a plain value is expected, when that is
// why from is not assignable to to. It returns 1 when it reported.
fn secret_assign_error(x, from, to) {
    if !saw_secret || !has_secret(from) || !assignable(secret_erase(from), secret_erase(to)) {
        return 0;
    }
    let e = err_code(x[N_POS], "E242 SECRET_TO_PLAIN");
    let c = secret_call;
    if c {
        secret_call = 0;
        buf_str(e, "cannot pass ");
        secret_what(e, secret_argdesc, from);
        buf_str(e, " to ");
        if c[CALL_NAME] {
            buf_str(e, c[CALL_NAME]);
        } else {
            buf_str(e, "this function");
        }
        let f = c[CALL_FN];
        if f && secret_argi < f[F_PARAMS][VEC_LEN] {
            buf_str(e, ": its parameter ");
            buf_str(e, vec_get(f[F_PARAMS], secret_argi));
            buf_str(e, " is not declared secret");
        } else {
            buf_str(e, ": the parameter is not declared secret");
        }
        if f && !vec_get(file_trusted, f[F_FILE]) {
            buf_str(e, " (declare it secret, or ");
        } else {
            buf_str(e, " (");
        }
        if is_secret(from) && secret_argdesc && load8(secret_argdesc) != '"' {
            buf_str(e, "write reveal(");
            buf_str(e, secret_argdesc);
            buf_str(e, ") to pass it on purpose)");
        } else {
            buf_str(e, "reveal it on purpose)");
        }
        err_end(e);
        return 1;
    }
    buf_str(e, "cannot use ");
    type_name(e, from);
    buf_str(e, " as ");
    type_name(e, to);
    buf_str(e, ": a secret stays secret until reveal(x) declassifies it on purpose");
    err_end(e);
    return 1;
}

// secret_conversion converts to a numeric or str type when the value or the target is
// secret: the conversion of the plain value, and the result is secret.
fn secret_conversion(e, x, from, to) {
    if is_secret(from) {
        x[N_TYPE] = from[TY_SECRET];
    }
    return secret_of(chk_conversion(e, plain_type(to)));
}

// secret_reveal checks reveal(x): x must be secret, and the result is the same value with
// its plain type. Every reveal is recorded for tin audit secrets.
fn secret_reveal(e) {
    let pos = e[N_POS];
    let args = e[CALL_ARGS];
    if args[VEC_LEN] != 1 {
        err_code_at(pos, "E245 REVEAL", "reveal needs one secret value: reveal(x)");
        return ty_int;
    }
    let x = vec_get(args, 0);
    let desc = secret_desc(x);
    let t = chk(x, 0);
    if !is_secret(t) {
        secret_reveal_error(pos, t);
        replace_node(e, x);
        e[N_TYPE] = 0;
        return t;
    }
    let b = buf_new();
    buf_str(b, "reveal(");
    if desc {
        buf_str(b, desc);
    } else {
        type_name(b, t);
    }
    buf_str(b, ") in ");
    buf_str(b, ck_fn[F_QNAME]);
    buf_byte(b, 0);
    secret_audit_add(pos, b[VEC_DATA]);
    replace_node(e, x);
    e[N_TYPE] = 0;
    return t[TY_SECRET];
}

fn secret_reveal_error(pos, t) {
    let e = err_code(pos, "E245 REVEAL");
    buf_str(e, "reveal needs a secret value, not ");
    type_name(e, t);
    if has_secret(t) {
        buf_str(e, ": reveal the secret field itself");
    }
    err_end(e);
}

// secret_lib_param: inside a standard-library function a parameter declared secret is its
// plain type. The library opted in, and is reviewed for what it does with the value.
fn secret_lib_param(s) {
    if saw_secret && ck_trusted && has_secret(s[S_TYPE]) {
        s[S_TYPE] = secret_erase(s[S_TYPE]);
    }
}

// ---- tin audit secrets ----

fn secret_audit_add(pos, text) {
    if !secret_audit {
        secret_audit = vec_new();
    }
    let rec = vec_new();
    vec_push(rec, pos);
    vec_push(rec, text);
    vec_push(secret_audit, rec);
    // Keep the list sorted by position (file, line, column); insertion order breaks ties.
    let i = secret_audit[VEC_LEN] - 1;
    while i > 0 && vec_get(vec_get(secret_audit, i - 1), 0) > pos {
        secret_audit[VEC_DATA][i] = vec_get(secret_audit, i - 1);
        i = i - 1;
    }
    secret_audit[VEC_DATA][i] = rec;
}

// secret_audit_print writes every place a secret leaves the checker's protection: each
// reveal, and each secret passed to a library parameter declared secret.
fn secret_audit_print() {
    let b = buf_new();
    let reveals = 0;
    let passed = 0;
    let i = 0;
    while secret_audit && i < secret_audit[VEC_LEN] {
        let rec = vec_get(secret_audit, i);
        buf_pos(b, vec_get(rec, 0));
        buf_str(b, ": ");
        buf_str(b, vec_get(rec, 1));
        buf_byte(b, '\n');
        if load8(vec_get(rec, 1)) == 'r' {
            reveals = reveals + 1;
        } else {
            passed = passed + 1;
        }
        i = i + 1;
    }
    buf_int(b, reveals);
    if reveals == 1 {
        buf_str(b, " reveal, ");
    } else {
        buf_str(b, " reveals, ");
    }
    buf_int(b, passed);
    if passed == 1 {
        buf_str(b, " secret passed to a library parameter declared secret\n");
    } else {
        buf_str(b, " secrets passed to library parameters declared secret\n");
    }
    write_all(1, b);
}
