// secret T (design_semantics section 9, #239): a type qualifier the checker tracks and the
// runtime never sees. A secret type is a twin of its plain type: a copy of the type record
// that every back end reads exactly as the plain type, marked with TY_SECRET. The checker
// keeps twins away from sinks (formatting, logging, JSON, fault messages, panics and any
// parameter not declared secret), propagates them through expressions, and lets reveal(x)
// turn one back into its plain type. Every reveal, and every secret handed to a library
// parameter declared secret, is listed by `tin audit secrets` (tinc -audit-secrets).
//
// Diagnostics: every secret error is reported by one function below, so #244 can give each
// its code in one place.
//   secret_sink_error     SECRET_SINK     a sink would print, encode or carry a secret
//   secret_assign_error   SECRET_ASSIGN   a secret where a plain value is expected: a
//                                         parameter not declared secret, a variable, a result
//   secret_compare_error  SECRET_COMPARE  ==, != or an ordering on a secret (seal.Equal)
//   secret_reveal_error   SECRET_REVEAL   reveal of a value that is not secret
//   secret_type_error     SECRET_TYPE     secret of a type it cannot qualify; a secret map key
shared mut saw_secret i64 // a secret type exists: until then every check here is skipped
shared mut secret_interp i64 // chk_interp is lowering an interpolation: its values may be secret
shared mut secret_call i64 // chk_args: the call whose argument check_assignable is checking
shared mut secret_argi i64 // its index
shared mut secret_argdesc i64 // how it was written
shared mut secret_audit i64 // [pos, text], sorted by position: every place a secret leaves

// secret_of returns the secret twin of t, one per type. ?T becomes ?secret T, so narrowing
// an optional keeps the secret.
fn secret_of(t Ty) i64 {
	if cast(i64, t) == 0 || t.secret_ != 0 || is_untyped(cast(i64, t)) != 0 {
		return cast(i64, t)
	}
	let k = t.kind
	if k == K_VOID || k == K_TUPLE {
		return cast(i64, t)
	}
	if k == K_OPT {
		return opt_of(secret_of(cast(Ty, t.elem)))
	}
	if ty_secrets == 0 {
		ty_secrets = vec_new()
	}
	mut i = 0
	for i < ty_secrets[VEC_LEN] {
		let s = cast(Ty, vec_get(ty_secrets, i))
		if cast(Ty, s.secret_) == t {
			return cast(i64, s)
		}
		i = i + 1
	}
	let n = cast(Ty, calloc(TY_MAX + 1, 8)) // every type has the bounded words (#240)
	mut j = 0
	for j < TY_SECRET {
		cast(i64, n)[j] = cast(i64, t)[j]
		j = j + 1
	}
	n.secret_ = cast(i64, t)
	vec_push(ty_secrets, cast(i64, n))
	saw_secret = 1
	return cast(i64, n)
}

fn is_secret(t Ty) i64 {
	return i64(cast(i64, t) != 0 && t.secret_ != 0)
}

// plain_type is the type reveal gives: t without its secret qualifier.
fn plain_type(t Ty) i64 {
	if cast(i64, t) != 0 && t.secret_ != 0 {
		return t.secret_
	}
	return cast(i64, t)
}

// secret_like is t, made secret when src is: an element, a field or a result computed from
// a secret is secret.
fn secret_like(src i64, t i64) i64 {
	if is_secret(cast(Ty, src)) != 0 {
		return secret_of(cast(Ty, t))
	}
	return t
}

// secret_join is the type of a binary operation on a secret and a plain operand of the same
// plain type (secret str + str is secret str), or 0 when the operands do not join.
fn secret_join(a i64, b i64) i64 {
	if saw_secret == 0 || !(is_secret(cast(Ty, a)) != 0 || is_secret(cast(Ty, b)) != 0) {
		return 0
	}
	if plain_type(cast(Ty, a)) != plain_type(cast(Ty, b)) {
		return 0
	}
	return secret_of(cast(Ty, plain_type(cast(Ty, a))))
}

// has_secret reports whether a value of t is or holds a secret: itself, a field, an element,
// a key or a variant's data.
fn has_secret(t i64) i64 {
	if saw_secret == 0 {
		return 0
	}
	return has_secret_in(cast(Ty, t), vec_new())
}

fn has_secret_in(t Ty, seen i64) i64 {
	if cast(i64, t) == 0 {
		return 0
	}
	if t.secret_ != 0 {
		return 1
	}
	let k = t.kind
	if k == K_OPT || k == K_SLICE || k == K_CHAN {
		return has_secret_in(cast(Ty, t.elem), seen)
	}
	if k == K_MAP {
		return i64(has_secret_in(cast(Ty, t.key), seen) != 0 || has_secret_in(cast(Ty, t.elem), seen) != 0)
	}
	if k == K_STRUCT || k == K_TUPLE {
		if vec_index(seen, cast(i64, t)) >= 0 {
			return 0
		}
		vec_push(seen, cast(i64, t))
		let fs = t.fields
		mut i = 0
		for fs != 0 && i < fs[VEC_LEN] {
			mut ft = vec_get(fs, i)
			if k == K_STRUCT {
				ft = field_type(t, i)
			}
			if has_secret_in(cast(Ty, ft), seen) != 0 {
				return 1
			}
			i = i + 1
		}
	}
	return 0
}

// secret_erase is t with every secret qualifier removed from it and from the optionals,
// slices and maps it is made of: what it would be if nothing were secret.
fn secret_erase(t Ty) i64 {
	if saw_secret == 0 || cast(i64, t) == 0 {
		return cast(i64, t)
	}
	if t.secret_ != 0 {
		return secret_erase(cast(Ty, t.secret_))
	}
	let k = t.kind
	if k == K_OPT {
		return opt_of(secret_erase(cast(Ty, t.elem)))
	}
	if k == K_SLICE {
		return slice_of(secret_erase(cast(Ty, t.elem)))
	}
	if k == K_MAP {
		return map_of(secret_erase(cast(Ty, t.key)), secret_erase(cast(Ty, t.elem)))
	}
	return cast(i64, t)
}

// secret_type resolves `secret T`. It qualifies values that are copied or compared by their
// content: numbers, bool, str, slices, maps and optionals of those. A struct is marked by
// its fields instead, so its methods, shapes and identity stay what they are.
fn secret_type(tx i64) i64 {
	let inner = cast(Ty, resolve_type(cast(TypeExpr, tx).a))
	mut k = kind_of(cast(Ty, plain_type(inner)))
	if k == K_OPT {
		k = kind_of(cast(Ty, plain_type(cast(Ty, inner.elem))))
	}
	if k != K_INT && k != K_BOOL && k != K_FLOAT && k != K_STRING && k != K_SLICE && k != K_MAP {
		secret_type_error(cast(Node, tx).pos, cast(i64, inner))
		return cast(i64, inner)
	}
	return secret_of(inner)
}

// secret_map_key rejects a secret map key: finding it compares it in time that depends on it.
fn secret_map_key(pos i64, kt i64) {
	if has_secret(kt) != 0 {
		let e = err_code(pos, cstr("E244 SECRET_MAP_KEY"))
		buf_str(e, cstr("a map key cannot be secret: a lookup compares it in time that depends on its value (key the map by a hash of it, such as seal.Sha256Hex)"))
		err_end(e)
	}
}

fn secret_type_error(pos i64, t i64) {
	let e = err_code(pos, cstr("E240 SECRET_TYPE"))
	buf_str(e, cstr("secret qualifies numbers, bool, str, slices and maps, not "))
	type_name(e, cast(Ty, t))
	if kind_of(cast(Ty, t)) == K_STRUCT {
		buf_str(e, cstr(": mark the struct's fields secret instead"))
	}
	err_end(e)
}

// ---- how a message names a value ----
// secret_desc is how expression e was written, for a message: a name, a field path, a call,
// an index or an interpolated string; 0 for anything else. Call it before e is checked.
fn secret_desc(e i64) i64 {
	if saw_secret == 0 || e == 0 {
		return 0
	}
	let b = buf_new()
	if secret_render(b, e, 0) == 0 {
		return 0
	}
	buf_byte(b, 0)
	return b[VEC_DATA]
}

fn secret_render(b i64, e i64, depth i64) i64 {
	if e == 0 || depth > 8 {
		return 0
	}
	let k = cast(Node, e).kind
	if k == EX_IDENT {
		buf_str(b, cast(IdentExpr, e).name)
		return 1
	}
	if k == EX_SELECT {
		if secret_render(b, cast(SelectExpr, e).x, depth + 1) == 0 {
			return 0
		}
		buf_byte(b, '.')
		buf_str(b, cast(SelectExpr, e).name)
		return 1
	}
	if k == EX_CALL {
		if cast(Call, e).name != 0 {
			buf_str(b, cast(Call, e).name)
		} else if secret_render(b, cast(Call, e).callee, depth + 1) == 0 {
			return 0
		}
		buf_byte(b, '(')
		let args = cast(Call, e).args
		mut i = 0
		for args != 0 && i < args[VEC_LEN] {
			if i > 0 {
				buf_str(b, cstr(", "))
			}
			if secret_render(b, vec_get(args, i), depth + 1) == 0 {
				buf_str(b, cstr("..."))
			}
			i = i + 1
		}
		buf_byte(b, ')')
		return 1
	}
	if k == EX_TYPE {
		return secret_render_tx(b, e[TYX])
	}
	if k == EX_INT && cast(Node, e).type_ == 0 {
		buf_int(b, cast(IntLit, e).val)
		return 1
	}
	if k == EX_FLOAT && cast(FloatLit, e).text != 0 {
		buf_str(b, cast(FloatLit, e).text)
		return 1
	}
	if k == EX_STR {
		buf_byte(b, '"')
		buf_bytes(b, cast(StrLit, e).ptr, cast(StrLit, e).len)
		buf_byte(b, '"')
		return 1
	}
	if k == EX_UNARY && streq(cast(Unary, e).op, cstr("...")) == 0 {
		buf_str(b, cast(Unary, e).op)
		return secret_render(b, cast(Unary, e).x, depth + 1)
	}
	if k == EX_BINARY && i64(load8(cast(Binary, e).op)) != '$' {
		if secret_render(b, cast(Binary, e).l, depth + 1) == 0 {
			return 0
		}
		buf_byte(b, ' ')
		buf_str(b, cast(Binary, e).op)
		buf_byte(b, ' ')
		return secret_render(b, cast(Binary, e).r, depth + 1)
	}
	if k == EX_INDEX {
		if secret_render(b, cast(IndexExpr, e).x, depth + 1) == 0 {
			return 0
		}
		buf_str(b, cstr("[...]"))
		return 1
	}
	if k == EX_INTERP {
		let parts = cast(InterpExpr, e).parts
		let vals = cast(InterpExpr, e).args
		buf_byte(b, '"')
		mut i = 0
		for i < parts[VEC_LEN] {
			let p = cast(StrLit, vec_get(parts, i))
			buf_bytes(b, p.ptr, p.len)
			if i < vals[VEC_LEN] {
				buf_byte(b, '{')
				if secret_render(b, vec_get(vals, i), depth + 1) == 0 {
					buf_str(b, cstr("..."))
				}
				buf_byte(b, '}')
			}
			i = i + 1
		}
		buf_byte(b, '"')
		return 1
	}
	return 0
}

// secret_render_tx appends a conversion's type: a name or a slice of one.
fn secret_render_tx(b i64, tx i64) i64 {
	if tx == 0 {
		return 0
	}
	if cast(Node, tx).kind == TX_SLICE {
		buf_str(b, cstr("[]"))
		return secret_render_tx(b, cast(TypeExpr, tx).a)
	}
	if cast(Node, tx).kind == TX_NAME && cast(TypeExpr, tx).args == 0 {
		if cast(TypeExpr, tx).a != 0 {
			buf_str(b, cast(TypeExpr, tx).a)
			buf_byte(b, '.')
		}
		buf_str(b, cast(TypeExpr, tx).b)
		return 1
	}
	return 0
}

// secret_where appends where a value of t keeps its secret: "secret field main.User.token",
// or "a secret" when it is deeper than a field of the value itself.
fn secret_where(b i64, t Ty) {
	let k = kind_of(t)
	if k == K_OPT || k == K_SLICE {
		secret_where(b, cast(Ty, t.elem))
		return
	}
	if k == K_STRUCT && t.enum_ == 0 {
		mut i = 0
		for i < t.fields[VEC_LEN] {
			if is_secret(cast(Ty, field_type(t, i))) != 0 {
				buf_str(b, cstr("secret field "))
				type_name(b, t)
				buf_byte(b, '.')
				buf_str(b, vec_get(vec_get(t.fields, i), 0))
				return
			}
			i = i + 1
		}
	}
	buf_str(b, cstr("a secret"))
}

// secret_what appends how a message names a value: "secret value token", or for a value that
// holds a secret, "u, which holds secret field main.User.token,".
fn secret_what(b i64, desc i64, t i64) {
	if is_secret(cast(Ty, t)) != 0 {
		if desc != 0 {
			buf_str(b, cstr("secret value "))
			buf_str(b, desc)
		} else {
			buf_str(b, cstr("a value of type "))
			type_name(b, cast(Ty, t))
		}
		return
	}
	if desc != 0 {
		buf_str(b, desc)
	} else {
		buf_str(b, cstr("a value of type "))
		type_name(b, cast(Ty, t))
	}
	buf_str(b, cstr(", which holds "))
	secret_where(b, cast(Ty, t))
	buf_byte(b, ',')
}

// secret_fix appends how to get past a secret error on purpose.
fn secret_fix(b i64, desc i64, t i64) {
	if is_secret(cast(Ty, t)) == 0 {
		buf_str(b, cstr("use a value without the secret, or reveal it on purpose"))
	} else if desc != 0 && i64(load8(desc)) != '"' {
		buf_str(b, cstr("leave it out, or write reveal("))
		buf_str(b, desc)
		buf_str(b, cstr(") on purpose"))
	} else {
		buf_str(b, cstr("leave it out, or reveal the secret on purpose"))
	}
}

// ---- the checks ----
// secret_sink_error reports a sink that would print, encode or carry a secret:
// "<before><what><after>: <fix>", such as "say.Line would print secret value token: ...".
fn secret_sink_error(pos i64, before i64, after i64, desc i64, t i64) {
	let e = err_code(pos, cstr("E241 SECRET_SINK"))
	buf_str(e, before)
	secret_what(e, desc, t)
	if is_secret(cast(Ty, t)) == 0 && i64(load8(after)) == 0 {
		// "..., which holds a secret," ends the sentence without the comma.
		e[VEC_LEN] = e[VEC_LEN] - 1
	}
	buf_str(e, after)
	buf_str(e, cstr(": "))
	secret_fix(e, desc, t)
	err_end(e)
}

// secret_sink checks one value bound for a sink; desc is how it was written (secret_desc).
fn secret_sink(pos i64, before i64, after i64, desc i64, t i64) i64 {
	if has_secret(t) != 0 {
		secret_sink_error(pos, before, after, desc, t)
		return 1
	}
	return 0
}

// secret_say_args checks a say call's arguments (and its format) before they are formatted.
// An interpolation formats its values into a secret str instead (secret_interp_result).
fn secret_say_args(args i64, m i64) {
	if saw_secret == 0 || secret_interp != 0 {
		return
	}
	mut before = cstr("say.")
	if streq(m, cstr("Fmt")) != 0 || streq(m, cstr("Str")) != 0 {
		before = str_cat3(cstr("say."), m, cstr(" would format "))
	} else if streq(m, cstr("Fault")) != 0 {
		before = cstr("say.Fault would put ")
	} else {
		before = str_cat3(cstr("say."), m, cstr(" would print "))
	}
	mut after = cstr("")
	if streq(m, cstr("Fault")) != 0 {
		after = cstr(" in a fault message")
	}
	mut first = 0
	if streq(m, cstr("To")) != 0 || streq(m, cstr("LineTo")) != 0 {
		first = 1
	}
	mut i = first
	for i < args[VEC_LEN] {
		let a = cast(Node, vec_get(args, i))
		let desc = secret_desc(cast(i64, a))
		mut want = 0
		if i == first && (streq(m, cstr("Out")) != 0 || streq(m, cstr("Fmt")) != 0 || streq(m, cstr("Fault")) != 0 || streq(m, cstr("To")) != 0) {
			want = ty_string
		}
		secret_sink(a.pos, before, after, desc, chk(a, want))
		i = i + 1
	}
}

// secret_interp_result lowers an interpolation whose values were just checked: one that
// holds a secret is a secret str (design_semantics section 9, propagation).
fn secret_interp_result(e i64, args i64, want i64) i64 {
	mut sec = 0
	mut i = 1
	for saw_secret != 0 && i < args[VEC_LEN] {
		if has_secret(cast(Node, vec_get(args, i)).type_) != 0 {
			sec = 1
		}
		i = i + 1
	}
	secret_interp = sec
	let t = lower_say(e, cstr("Fmt"), want)
	secret_interp = 0
	if sec != 0 {
		return secret_of(cast(Ty, t))
	}
	return t
}

// secret_compare_error rejects == and the orderings on a secret: comparing takes time that
// depends on where the values first differ, which leaks them byte by byte.
fn secret_compare_error(pos i64, op i64, lt i64, rt i64) i64 {
	if saw_secret == 0 || !(has_secret(lt) != 0 || has_secret(rt) != 0) {
		return 0
	}
	// Comparing an optional secret with nil says only whether it is there.
	if kind_of(cast(Ty, lt)) == K_OPT || kind_of(cast(Ty, rt)) == K_OPT {
		return 0
	}
	let e = err_code(pos, cstr("E243 SECRET_COMPARE"))
	if streq(op, cstr("==")) != 0 || streq(op, cstr("!=")) != 0 {
		buf_str(e, cstr("cannot compare secret values with "))
		buf_str(e, op)
		buf_str(e, cstr(": use seal.Equal, which takes the same time whatever they hold"))
	} else {
		buf_str(e, cstr("cannot order secret values with "))
		buf_str(e, op)
		buf_str(e, cstr(": the time it takes depends on what they hold (reveal them on purpose first)"))
	}
	err_end(e)
	return 1
}

// secret_arg remembers which argument check_assignable is about to check, so a secret passed
// to a parameter not declared secret is reported against the call (secret_assign_error).
// A secret passed to a library parameter declared secret is where it leaves the program's
// hands: tin audit secrets lists it.
fn secret_arg(e Call, i i64, desc i64, at i64, want i64) {
	if saw_secret == 0 {
		return
	}
	secret_call = cast(i64, e)
	secret_argi = i
	secret_argdesc = desc
	let f = cast(Fn, e.fn_)
	if cast(i64, f) != 0 && is_secret(cast(Ty, want)) != 0 && has_secret(at) != 0 && vec_get(file_trusted, f.file) != 0 && ck_trusted == 0 {
		let b = buf_new()
		secret_what(b, desc, at)
		buf_str(b, cstr(" passed to "))
		buf_str(b, e.name)
		buf_str(b, cstr(" (parameter "))
		buf_str(b, vec_get(f.params, i))
		buf_str(b, cstr(" is declared secret) in "))
		buf_str(b, cast(Fn, ck_fn).qname)
		buf_byte(b, 0)
		secret_audit_add(cast(Node, vec_get(e.args, i)).pos, b[VEC_DATA])
	}
}

// secret_query_arg lets a secret value into a query literal as Args[i]: the value is sent as
// itself, and bit i of the query's Hidden tells a client to record its handle, never its text
// (notes/interface_replay.md 5.3). tin audit secrets lists it. It returns the bit, 0 past 64.
fn secret_query_arg(a Node, t i64, i i64) i64 {
	if i >= 64 {
		err_code_at(a.pos, cstr("E280 QUERY"), cstr("a query can carry secret values only in its first 64 values"))
		return 0
	}
	let b = buf_new()
	secret_what(b, secret_desc(cast(i64, a)), t)
	buf_str(b, cstr(" sent in a query in "))
	buf_str(b, cast(Fn, ck_fn).qname)
	buf_byte(b, 0)
	secret_audit_add(a.pos, b[VEC_DATA])
	vec_push(vec_get(secret_audit, secret_audit_at(a.pos, b[VEC_DATA])), 1) // a query, for the count
	return 1 << i
}

fn secret_arg_done() {
	secret_call = 0
}

// secret_assign_error reports a secret used where a plain value is expected, when that is
// why from is not assignable to to. It returns 1 when it reported.
fn secret_assign_error(x Node, from i64, to i64) i64 {
	if saw_secret == 0 || has_secret(from) == 0 || assignable(cast(Ty, secret_erase(cast(Ty, from))), cast(Ty, secret_erase(cast(Ty, to)))) == 0 {
		return 0
	}
	let e = err_code(x.pos, cstr("E242 SECRET_TO_PLAIN"))
	let c = cast(Call, secret_call)
	if cast(i64, c) != 0 {
		secret_call = 0
		buf_str(e, cstr("cannot pass "))
		secret_what(e, secret_argdesc, from)
		buf_str(e, cstr(" to "))
		if c.name != 0 {
			buf_str(e, c.name)
		} else {
			buf_str(e, cstr("this function"))
		}
		let f = cast(Fn, c.fn_)
		if cast(i64, f) != 0 && secret_argi < f.params[VEC_LEN] {
			buf_str(e, cstr(": its parameter "))
			buf_str(e, vec_get(f.params, secret_argi))
			buf_str(e, cstr(" is not declared secret"))
		} else {
			buf_str(e, cstr(": the parameter is not declared secret"))
		}
		if cast(i64, f) != 0 && vec_get(file_trusted, f.file) == 0 {
			buf_str(e, cstr(" (declare it secret, or "))
		} else {
			buf_str(e, cstr(" ("))
		}
		if is_secret(cast(Ty, from)) != 0 && secret_argdesc != 0 && i64(load8(secret_argdesc)) != '"' {
			buf_str(e, cstr("write reveal("))
			buf_str(e, secret_argdesc)
			buf_str(e, cstr(") to pass it on purpose)"))
		} else {
			buf_str(e, cstr("reveal it on purpose)"))
		}
		err_end(e)
		return 1
	}
	buf_str(e, cstr("cannot use "))
	type_name(e, cast(Ty, from))
	buf_str(e, cstr(" as "))
	type_name(e, cast(Ty, to))
	buf_str(e, cstr(": a secret stays secret until reveal(x) declassifies it on purpose"))
	err_end(e)
	return 1
}

// secret_conversion converts to a numeric or str type when the value or the target is
// secret: the conversion of the plain value, and the result is secret.
fn secret_conversion(e i64, x Node, from Ty, to i64) i64 {
	if is_secret(from) != 0 {
		x.type_ = from.secret_
	}
	return secret_of(cast(Ty, chk_conversion(e, cast(Ty, plain_type(cast(Ty, to))))))
}

// secret_reveal checks reveal(x): x must be secret, and the result is the same value with
// its plain type. Every reveal is recorded for tin audit secrets.
fn secret_reveal(e i64) i64 {
	let pos = cast(Node, e).pos
	let args = cast(Call, e).args
	if args[VEC_LEN] != 1 {
		err_code_at(pos, cstr("E245 REVEAL"), cstr("reveal needs one secret value: reveal(x)"))
		return ty_int
	}
	let x = vec_get(args, 0)
	let desc = secret_desc(x)
	let t = cast(Ty, chk(cast(Node, x), 0))
	if is_secret(t) == 0 {
		secret_reveal_error(pos, cast(i64, t))
		replace_node(e, x)
		cast(Node, e).type_ = 0
		return cast(i64, t)
	}
	let b = buf_new()
	buf_str(b, cstr("reveal("))
	if desc != 0 {
		buf_str(b, desc)
	} else {
		type_name(b, t)
	}
	buf_str(b, cstr(") in "))
	buf_str(b, cast(Fn, ck_fn).qname)
	buf_byte(b, 0)
	secret_audit_add(pos, b[VEC_DATA])
	replace_node(e, x)
	cast(Node, e).type_ = 0
	return t.secret_
}

fn secret_reveal_error(pos i64, t i64) {
	let e = err_code(pos, cstr("E245 REVEAL"))
	buf_str(e, cstr("reveal needs a secret value, not "))
	type_name(e, cast(Ty, t))
	if has_secret(t) != 0 {
		buf_str(e, cstr(": reveal the secret field itself"))
	}
	err_end(e)
}

// secret_lib_param: inside a standard-library function a parameter declared secret is its
// plain type. The library opted in, and is reviewed for what it does with the value.
fn secret_lib_param(s Sym) {
	if saw_secret != 0 && ck_trusted != 0 && has_secret(s.type_) != 0 {
		s.type_ = secret_erase(cast(Ty, s.type_))
	}
}

// ---- tin audit secrets ----
fn secret_audit_add(pos i64, text i64) {
	if secret_audit == 0 {
		secret_audit = vec_new()
	}
	let rec = vec_new()
	vec_push(rec, pos)
	vec_push(rec, text)
	vec_push(secret_audit, rec)
	// Keep the list sorted by position (file, line, column); insertion order breaks ties.
	mut i = secret_audit[VEC_LEN] - 1
	for i > 0 && vec_get(vec_get(secret_audit, i - 1), 0) > pos {
		secret_audit[VEC_DATA][i] = vec_get(secret_audit, i - 1)
		i = i - 1
	}
	secret_audit[VEC_DATA][i] = rec
}

// secret_audit_print writes every place a secret leaves the checker's protection: each
// reveal, and each secret passed to a library parameter declared secret.
// secret_audit_at is the index of the audit record at pos with text.
fn secret_audit_at(pos i64, text i64) i64 {
	mut i = secret_audit[VEC_LEN] - 1
	for i > 0 && (vec_get(vec_get(secret_audit, i), 0) != pos || vec_get(vec_get(secret_audit, i), 1) != text) {
		i = i - 1
	}
	return i
}

fn secret_audit_print() {
	let b = buf_new()
	mut reveals = 0
	mut passed = 0
	mut queries = 0
	mut i = 0
	for secret_audit != 0 && i < secret_audit[VEC_LEN] {
		let rec = vec_get(secret_audit, i)
		buf_pos(b, vec_get(rec, 0))
		buf_str(b, cstr(": "))
		buf_str(b, vec_get(rec, 1))
		buf_byte(b, '\n')
		if i64(load8(vec_get(rec, 1))) == 'r' {
			reveals = reveals + 1
		} else if rec[VEC_LEN] > 2 {
			queries = queries + 1
		} else {
			passed = passed + 1
		}
		i = i + 1
	}
	buf_int(b, reveals)
	if reveals == 1 {
		buf_str(b, cstr(" reveal, "))
	} else {
		buf_str(b, cstr(" reveals, "))
	}
	buf_int(b, passed)
	if passed == 1 {
		buf_str(b, cstr(" secret passed to a library parameter declared secret"))
	} else {
		buf_str(b, cstr(" secrets passed to library parameters declared secret"))
	}
	if queries == 1 {
		buf_str(b, cstr(", 1 secret sent in a query"))
	} else if queries > 1 {
		buf_str(b, cstr(", "))
		buf_int(b, queries)
		buf_str(b, cstr(" secrets sent in queries"))
	}
	buf_byte(b, '\n')
	write_all(1, b)
}
