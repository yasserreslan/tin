// Analysis for code generation: leaf functions, address-taken locals, loop-weighted uses.
shared mut an_fn i64
shared mut an_depth i64

fn analyze_fn(f i64) {
	an_fn = f
	an_depth = 0
	f[F_LEAF] = 1
	let locals = f[F_LOCALS]
	mut i = 0
	for i < locals[VEC_LEN] {
		let s = vec_get(locals, i)
		s[S_USES] = 0
		s[S_ADDR] = 0
		i = i + 1
	}
	an_stmts(f[F_BODY][BLK_STMTS])
}

// A use inside k nested loops counts 8^k, so inner-loop variables win registers.
fn an_use(s i64) {
	if s[S_KIND] != SYM_LOCAL {
		return
	}
	mut w = 512
	if an_depth < 3 {
		w = 1 << (3 * an_depth)
	}
	s[S_USES] = s[S_USES] + w
}

fn an_stmts(stmts i64) {
	mut i = 0
	for i < stmts[VEC_LEN] {
		an_stmt(vec_get(stmts, i))
		i = i + 1
	}
}

fn an_stmt(s i64) {
	let k = s[N_KIND]
	if k == ST_BLOCK {
		an_stmts(s[BLK_STMTS])
	} else if k == ST_LET {
		an_expr(s[LET_INIT])
		an_use(s[LET_SYM])
	} else if k == ST_ASSIGN {
		let t = s[AS_TARGET]
		if t[N_KIND] == EX_IDENT {
			an_use(t[ID_REF])
		} else {
			an_expr(t)
		}
		an_expr(s[AS_VALUE])
	} else if k == ST_EXPR {
		an_expr(s[ES_X])
	} else if k == ST_IF {
		an_expr(s[IF_COND])
		an_stmts(s[IF_THEN][BLK_STMTS])
		if s[IF_ELSE] != 0 {
			an_stmt(s[IF_ELSE])
		}
	} else if k == ST_WHILE {
		let loop_ = i64(s[WH_ONCE] == 0)
		an_depth = an_depth + loop_
		an_expr(s[WH_COND])
		an_stmts(s[WH_BODY][BLK_STMTS])
		if s[WH_POST] != 0 {
			an_stmt(s[WH_POST])
		}
		an_depth = an_depth - loop_
	} else if k == ST_RETURN {
		if s[RET_VALUE] != 0 {
			an_expr(s[RET_VALUE])
		}
		if s[RET_VALUES] != 0 {
			an_exprs(s[RET_VALUES])
		}
	} else if k == ST_CALLMULTI {
		an_expr(s[CM_CALL])
		mut i = 0
		for i < s[CM_SYMS][VEC_LEN] {
			an_use(vec_get(s[CM_SYMS], i))
			i = i + 1
		}
	}
}

fn an_exprs(v i64) {
	mut i = 0
	for i < v[VEC_LEN] {
		an_expr(vec_get(v, i))
		i = i + 1
	}
}

fn an_expr(e i64) {
	let k = e[N_KIND]
	if k == EX_IDENT {
		an_use(e[ID_REF])
	} else if k == EX_UNARY {
		let x = e[UN_X]
		if streq(e[UN_OP], cstr("&")) != 0 && x[ID_REF][S_KIND] == SYM_LOCAL {
			x[ID_REF][S_ADDR] = 1
		}
		an_expr(x)
	} else if k == EX_BINARY {
		an_expr(e[BIN_L])
		an_expr(e[BIN_R])
	} else if k == EX_INDEX {
		an_expr(e[IX_X])
		an_expr(e[IX_I])
	} else if k == EX_CONV {
		an_expr(e[CV_X])
	} else if k == EX_MEM {
		an_expr(e[MEM_BASE])
		if e[MEM_INDEX] != 0 {
			an_expr(e[MEM_INDEX])
		}
		if e[MEM_LEN] != 0 {
			an_expr(e[MEM_LEN])
		}
	} else if k == EX_ELEM {
		an_expr(e[ELEM_SEQ])
		an_expr(e[ELEM_IDX])
	} else if k == EX_SEQ {
		an_stmts(e[SEQ_STMTS])
		an_expr(e[SEQ_VALUE])
	} else if k == EX_CALL {
		if e[CALL_INTRINSIC] == 0 {
			an_fn[F_LEAF] = 0
		}
		if e[CALL_CALLEE] != 0 {
			an_expr(e[CALL_CALLEE])
		}
		let args = e[CALL_ARGS]
		mut i = 0
		for i < args[VEC_LEN] {
			an_expr(vec_get(args, i))
			i = i + 1
		}
	}
}

// ---- loop-invariant code motion ----
//
// Runs on the AST before analysis. An expression is invariant in a loop when it only
// reads constants and register-eligible locals the loop never assigns, and cannot panic
// (a division needs a nonzero constant divisor), so hoisting it ahead of the loop, even
// out of a guard or a loop that runs zero times, is always safe. Indexes
// of the form x[a + b] with x and a invariant become (x + a*8)[b], so the row address
// is computed once per loop instead of once per element.
shared mut lc_fn i64
shared mut lc_assigned i64
shared mut lc_exprs i64
shared mut lc_syms i64
shared mut lc_pre i64
shared mut lc_calls i64 // the loop makes calls, so headers may change under it

fn licm_fn(f i64) {
	analyze_fn(f)
	lc_fn = f
	prefetch_block(f[F_BODY][BLK_STMTS])
	licm_block(f[F_BODY])
}

// ---- strided prefetch ----
//
// An innermost loop that stores to x[j] while stepping j by a variable (or large)
// stride misses cache on nearly every iteration; the core can only track so many
// misses at once. Prefetching x[j + 4*step] keeps more of them in flight (sieve:
// 155ms -> 133ms). Go does not do this.
const PF_AHEAD = 4

fn prefetch_block(stmts i64) {
	mut i = 0
	for i < stmts[VEC_LEN] {
		let s = vec_get(stmts, i)
		let k = s[N_KIND]
		if k == ST_WHILE && s[WH_ONCE] != 0 {
			prefetch_block(s[WH_BODY][BLK_STMTS])
		} else if k == ST_WHILE {
			if has_loop(s[WH_BODY][BLK_STMTS]) != 0 {
				prefetch_block(s[WH_BODY][BLK_STMTS])
			} else {
				prefetch_loop(s)
			}
		} else if k == ST_BLOCK {
			prefetch_block(s[BLK_STMTS])
		} else if k == ST_IF {
			prefetch_block(s[IF_THEN][BLK_STMTS])
			mut els = s[IF_ELSE]
			for els != 0 && els[N_KIND] == ST_IF {
				prefetch_block(els[IF_THEN][BLK_STMTS])
				els = els[IF_ELSE]
			}
			if els != 0 {
				prefetch_block(els[BLK_STMTS])
			}
		}
		i = i + 1
	}
}

fn has_loop(stmts i64) i64 {
	mut i = 0
	for i < stmts[VEC_LEN] {
		let s = vec_get(stmts, i)
		let k = s[N_KIND]
		if k == ST_WHILE && s[WH_ONCE] == 0 {
			return 1
		}
		if k == ST_WHILE && has_loop(s[WH_BODY][BLK_STMTS]) != 0 {
			return 1
		}
		if k == ST_BLOCK && has_loop(s[BLK_STMTS]) != 0 {
			return 1
		}
		if k == ST_IF {
			if has_loop(s[IF_THEN][BLK_STMTS]) != 0 {
				return 1
			}
			if s[IF_ELSE] != 0 {
				let one = vec_new()
				vec_push(one, s[IF_ELSE])
				if has_loop(one) != 0 {
					return 1
				}
			}
		}
		i = i + 1
	}
	return 0
}

fn is_reg_local(e i64) i64 {
	return i64(e[N_KIND] == EX_IDENT && e[ID_REF][S_KIND] == SYM_LOCAL && e[ID_REF][S_ADDR] == 0)
}

fn prefetch_loop(w i64) {
	if w[WH_ONCE] != 0 {
		return
	}
	let body0 = w[WH_BODY][BLK_STMTS]
	let body = vec_new()
	mut bi = 0
	for bi < body0[VEC_LEN] {
		vec_push(body, vec_get(body0, bi))
		bi = bi + 1
	}
	if w[WH_POST] != 0 {
		vec_push(body, w[WH_POST])
	}
	lc_assigned = vec_new()
	lc_calls = stmts_have_call(body)
	collect_assigned(body)
	// The induction step: a top-level `j = j + step` with step invariant.
	mut j = 0
	mut step = 0
	mut i = 0
	for i < body[VEC_LEN] {
		let s = vec_get(body, i)
		if s[N_KIND] == ST_ASSIGN && is_reg_local(s[AS_TARGET]) != 0 {
			let v = s[AS_VALUE]
			let t = s[AS_TARGET][ID_REF]
			if v[N_KIND] == EX_BINARY && streq(v[BIN_OP], cstr("+")) != 0 && v[BIN_L][N_KIND] == EX_IDENT && v[BIN_L][ID_REF] == t && invariant(v[BIN_R]) != 0 {
				j = t
				step = v[BIN_R]
			}
		}
		i = i + 1
	}
	if j == 0 || count_assigns(body, j) != 1 {
		return
	}
	if is_const(step) != 0 && const_val(step) < 8 && const_val(step) > -8 {
		return
	}
	// The strided access: x[j] = ... with x invariant.
	mut target = 0
	i = 0
	for i < body[VEC_LEN] {
		let s = vec_get(body, i)
		if s[N_KIND] == ST_ASSIGN && s[AS_TARGET][N_KIND] == EX_INDEX {
			let ix = s[AS_TARGET]
			if (is_reg_local(ix[IX_X]) != 0 || ix[IX_X][IX_HDR] != 0) && invariant(ix[IX_X]) != 0 && ix[IX_I][N_KIND] == EX_IDENT && ix[IX_I][ID_REF] == j {
				target = ix
			}
		}
		if s[N_KIND] == ST_ASSIGN && s[AS_TARGET][N_KIND] == EX_ELEM {
			let el = s[AS_TARGET]
			if is_reg_local(el[ELEM_SEQ]) != 0 && invariant(el[ELEM_SEQ]) != 0 && el[ELEM_SIZE] == 8 && el[ELEM_IDX][N_KIND] == EX_IDENT && el[ELEM_IDX][ID_REF] == j {
				target = el
			}
		}
		i = i + 1
	}
	if target == 0 {
		return
	}
	let pos = w[N_POS]
	let ahead = node_new(EX_INT, pos)
	ahead[INT_VAL] = PF_AHEAD
	let jref = node_new(EX_IDENT, pos)
	jref[ID_NAME] = j[S_NAME]
	jref[ID_REF] = j
	let call = node_new(EX_CALL, pos)
	call[CALL_NAME] = cstr("__prefetchw")
	call[CALL_ARGS] = vec_new()
	call[CALL_INTRINSIC] = 1
	if target[N_KIND] == EX_ELEM {
		vec_push(call[CALL_ARGS], mk_hdr(pos, node_copy(target[ELEM_SEQ]), 2))
	} else {
		vec_push(call[CALL_ARGS], node_copy(target[IX_X]))
	}
	vec_push(call[CALL_ARGS], binary_node(pos, cstr("+"), jref, binary_node(pos, cstr("*"), node_copy(step), ahead)))
	let st = node_new(ST_EXPR, pos)
	st[ES_X] = call
	let nb = vec_new()
	vec_push(nb, st)
	i = 0
	for i < body0[VEC_LEN] {
		vec_push(nb, vec_get(body0, i))
		i = i + 1
	}
	w[WH_BODY][BLK_STMTS] = nb
}

fn count_assigns(stmts i64, sym i64) i64 {
	mut n = 0
	mut i = 0
	for i < lc_assigned[VEC_LEN] {
		if vec_get(lc_assigned, i) == sym {
			n = n + 1
		}
		i = i + 1
	}
	return n
}

fn licm_block(b i64) {
	let stmts = b[BLK_STMTS]
	let result = vec_new()
	mut i = 0
	for i < stmts[VEC_LEN] {
		let s = vec_get(stmts, i)
		licm_nested(s)
		if s[N_KIND] == ST_WHILE && s[WH_ONCE] == 0 {
			let pre = licm_loop(s)
			mut j = 0
			for j < pre[VEC_LEN] {
				vec_push(result, vec_get(pre, j))
				j = j + 1
			}
		}
		vec_push(result, s)
		i = i + 1
	}
	b[BLK_STMTS] = result
}

fn licm_nested(s i64) {
	let k = s[N_KIND]
	if k == ST_BLOCK {
		licm_block(s)
	} else if k == ST_IF {
		licm_block(s[IF_THEN])
		if s[IF_ELSE] != 0 {
			licm_nested(s[IF_ELSE])
		}
	} else if k == ST_WHILE {
		licm_block(s[WH_BODY])
	}
}

// licm_loop rewrites loop w in place and returns the lets to run before it.
fn licm_loop(w i64) i64 {
	lc_assigned = vec_new()
	lc_exprs = vec_new()
	lc_syms = vec_new()
	lc_pre = vec_new()
	lc_calls = i64(stmts_have_call(w[WH_BODY][BLK_STMTS]) != 0 || contains_call(w[WH_COND]) != 0 || stmt_has_call(w[WH_POST]) != 0)
	collect_assigned(w[WH_BODY][BLK_STMTS])
	if w[WH_POST] != 0 {
		let one = vec_new()
		vec_push(one, w[WH_POST])
		collect_assigned(one)
	}
	hoist_expr(w[WH_COND])
	hoist_stmts(w[WH_BODY][BLK_STMTS])
	if w[WH_POST] != 0 {
		let two = vec_new()
		vec_push(two, w[WH_POST])
		hoist_stmts(two)
	}
	return lc_pre
}

fn collect_assigned(stmts i64) {
	mut i = 0
	for i < stmts[VEC_LEN] {
		let s = vec_get(stmts, i)
		let k = s[N_KIND]
		if k == ST_LET {
			vec_push(lc_assigned, s[LET_SYM])
		} else if k == ST_ASSIGN && s[AS_TARGET][N_KIND] == EX_IDENT {
			vec_push(lc_assigned, s[AS_TARGET][ID_REF])
		} else if k == ST_BLOCK {
			collect_assigned(s[BLK_STMTS])
		} else if k == ST_IF {
			collect_assigned(s[IF_THEN][BLK_STMTS])
			mut els = s[IF_ELSE]
			for els != 0 && els[N_KIND] == ST_IF {
				collect_assigned(els[IF_THEN][BLK_STMTS])
				els = els[IF_ELSE]
			}
			if els != 0 {
				collect_assigned(els[BLK_STMTS])
			}
		} else if k == ST_WHILE {
			collect_assigned(s[WH_BODY][BLK_STMTS])
			if s[WH_POST] != 0 {
				let one = vec_new()
				vec_push(one, s[WH_POST])
				collect_assigned(one)
			}
		} else if k == ST_CALLMULTI {
			mut j = 0
			for j < s[CM_SYMS][VEC_LEN] {
				vec_push(lc_assigned, vec_get(s[CM_SYMS], j))
				j = j + 1
			}
		}
		i = i + 1
	}
}

fn is_assigned(s i64) i64 {
	mut i = 0
	for i < lc_assigned[VEC_LEN] {
		if vec_get(lc_assigned, i) == s {
			return 1
		}
		i = i + 1
	}
	return 0
}

fn invariant(e i64) i64 {
	let k = e[N_KIND]
	if k == EX_INT {
		return 1
	}
	if k == EX_IDENT {
		let s = e[ID_REF]
		if s[S_KIND] == SYM_CONST {
			return 1
		}
		return i64(s[S_KIND] == SYM_LOCAL && s[S_ADDR] == 0 && is_assigned(s) == 0)
	}
	if k == EX_UNARY {
		return i64(streq(e[UN_OP], cstr("&")) == 0 && invariant(e[UN_X]) != 0)
	}
	if k == EX_BINARY {
		return i64(streq(e[BIN_OP], cstr("&&")) == 0 && streq(e[BIN_OP], cstr("||")) == 0 && may_panic(e) == 0 && invariant(e[BIN_L]) != 0 && invariant(e[BIN_R]) != 0)
	}
	if k == EX_FLOAT {
		return 1
	}
	if k == EX_CONV {
		if (e[CV_KIND] == CV_LEN || e[CV_KIND] == CV_CAP) && lc_calls != 0 {
			return 0
		}
		return invariant(e[CV_X])
	}
	if k == EX_INDEX && e[IX_HDR] != 0 {
		// Slice and string headers only change through runtime calls.
		return i64(lc_calls == 0 && invariant(e[IX_X]) != 0)
	}
	if k == EX_MEM && e[MEM_HDR] != 0 {
		return i64(lc_calls == 0 && e[MEM_INDEX] == 0 && invariant(e[MEM_BASE]) != 0)
	}
	return 0
}

// op_cost estimates the instructions an expression needs; multiplies and divides count triple.
fn op_cost(e i64) i64 {
	let k = e[N_KIND]
	if k == EX_BINARY {
		let op = e[BIN_OP]
		mut c = 1
		if streq(op, cstr("*")) != 0 || streq(op, cstr("/")) != 0 || streq(op, cstr("%")) != 0 {
			c = 3
		}
		return c + op_cost(e[BIN_L]) + op_cost(e[BIN_R])
	}
	if k == EX_UNARY {
		return 1 + op_cost(e[UN_X])
	}
	if k == EX_CONV {
		return 1 + op_cost(e[CV_X])
	}
	if k == EX_INDEX {
		return 2 + op_cost(e[IX_X])
	}
	if k == EX_MEM {
		return 2 + op_cost(e[MEM_BASE])
	}
	if k == EX_FLOAT && e[FL_BITS] != 0 {
		return 2
	}
	return 0
}

fn hoist_stmts(stmts i64) {
	mut i = 0
	for i < stmts[VEC_LEN] {
		let s = vec_get(stmts, i)
		let k = s[N_KIND]
		if k == ST_LET {
			hoist_expr(s[LET_INIT])
		} else if k == ST_ASSIGN {
			hoist_expr(s[AS_TARGET])
			hoist_expr(s[AS_VALUE])
		} else if k == ST_EXPR {
			hoist_expr(s[ES_X])
		} else if k == ST_RETURN {
			if s[RET_VALUE] != 0 {
				hoist_expr(s[RET_VALUE])
			}
		} else if k == ST_BLOCK {
			hoist_stmts(s[BLK_STMTS])
		} else if k == ST_IF {
			hoist_expr(s[IF_COND])
			hoist_stmts(s[IF_THEN][BLK_STMTS])
			let els = s[IF_ELSE]
			if els != 0 && els[N_KIND] == ST_BLOCK {
				hoist_stmts(els[BLK_STMTS])
			} else if els != 0 {
				let one = vec_new()
				vec_push(one, els)
				hoist_stmts(one)
			}
		} else if k == ST_WHILE {
			hoist_expr(s[WH_COND])
			hoist_stmts(s[WH_BODY][BLK_STMTS])
			if s[WH_POST] != 0 {
				let one = vec_new()
				vec_push(one, s[WH_POST])
				hoist_stmts(one)
			}
		} else if k == ST_CALLMULTI {
			hoist_expr(s[CM_CALL])
		}
		i = i + 1
	}
}

fn hoist_expr(e i64) {
	if e == 0 {
		return
	}
	mut k = e[N_KIND]
	if (k == EX_BINARY || k == EX_UNARY || k == EX_CONV || k == EX_FLOAT || (k == EX_INDEX && e[IX_HDR] != 0) || (k == EX_MEM && e[MEM_HDR] != 0)) && invariant(e) != 0 && is_const(e) == 0 && op_cost(e) >= 2 {
		replace_with_temp(e)
		return
	}
	if k == EX_ELEM {
		elem_specialize(e)
		k = e[N_KIND]
	}
	if k == EX_INDEX {
		index_rewrite(e)
		hoist_expr(e[IX_X])
		hoist_expr(e[IX_I])
	} else if k == EX_MEM {
		mem_rewrite(e)
		hoist_expr(e[MEM_BASE])
		hoist_expr(e[MEM_INDEX])
		hoist_expr(e[MEM_LEN])
	} else if k == EX_ELEM {
		hoist_expr(e[ELEM_SEQ])
		hoist_expr(e[ELEM_IDX])
	} else if k == EX_UNARY {
		hoist_expr(e[UN_X])
	} else if k == EX_BINARY {
		hoist_expr(e[BIN_L])
		hoist_expr(e[BIN_R])
	} else if k == EX_CONV {
		hoist_expr(e[CV_X])
	} else if k == EX_CALL {
		let args = e[CALL_ARGS]
		mut i = 0
		for i < args[VEC_LEN] {
			hoist_expr(vec_get(args, i))
			i = i + 1
		}
	}
}

fn binary_node(pos i64, op i64, l i64, r i64) i64 {
	let b = node_new(EX_BINARY, pos)
	b[BIN_OP] = op
	b[BIN_L] = l
	b[BIN_R] = r
	return b
}

// index_rewrite turns x[a + b] into (x + (a << 3))[b] when x and a are invariant and b is not.
fn index_rewrite(e i64) {
	let ix = e[IX_I]
	if ix[N_KIND] != EX_BINARY || streq(ix[BIN_OP], cstr("+")) == 0 || invariant(e[IX_X]) == 0 {
		return
	}
	mut a = ix[BIN_L]
	mut b = ix[BIN_R]
	if invariant(b) != 0 && invariant(a) == 0 {
		a = ix[BIN_R]
		b = ix[BIN_L]
	}
	if invariant(a) == 0 || invariant(b) != 0 {
		return
	}
	let three = node_new(EX_INT, e[N_POS])
	three[INT_VAL] = 3
	e[IX_X] = binary_node(e[N_POS], cstr("+"), e[IX_X], binary_node(e[N_POS], cstr("<<"), a, three))
	e[IX_I] = b
}

// replace_with_temp moves e into a let before the loop and turns e into a read of it,
// reusing the temp of an identical expression hoisted earlier from the same loop.
fn replace_with_temp(e i64) {
	mut s = 0
	mut i = 0
	for i < lc_exprs[VEC_LEN] && s == 0 {
		if expr_equal(vec_get(lc_exprs, i), e) != 0 {
			s = vec_get(lc_syms, i)
		}
		i = i + 1
	}
	if s == 0 {
		let moved = node_copy(e)
		s = sym_new(SYM_LOCAL, cstr("licm"), e[N_POS])
		s[S_TYPE] = e[N_TYPE]
		s[S_SLOT] = lc_fn[F_SLOTS]
		lc_fn[F_SLOTS] = lc_fn[F_SLOTS] + 1
		vec_push(lc_fn[F_LOCALS], s)
		let l = node_new(ST_LET, e[N_POS])
		l[LET_NAME] = cstr("licm")
		l[LET_INIT] = moved
		l[LET_SYM] = s
		vec_push(lc_pre, l)
		vec_push(lc_exprs, moved)
		vec_push(lc_syms, s)
	}
	let t = e[N_TYPE]
	e[N_KIND] = EX_IDENT
	e[ID_NAME] = s[S_NAME]
	e[ID_REF] = s
	e[4] = 0
	e[5] = 0
	e[N_TYPE] = t
	e[7] = 0
}

// elem_specialize turns s[i] in a loop that cannot change s into a plain load from the
// hoisted data pointer, checked against the hoisted length.
fn elem_specialize(e i64) {
	let x = e[ELEM_SEQ]
	if lc_calls != 0 || invariant(x) == 0 || is_reg_local(x) == 0 {
		return
	}
	let pos = e[N_POS]
	mut data = 0
	if e[ELEM_STR] != 0 {
		data = binary_node(pos, cstr("+"), node_copy(x), int_node(pos, 8))
		data[N_TYPE] = ty_int
	} else {
		data = mk_hdr(pos, node_copy(x), 2)
	}
	mut lenx = 0
	if e[ELEM_SAFE] == 0 {
		lenx = mk_hdr(pos, node_copy(x), 0)
	}
	let idx = e[ELEM_IDX]
	let size = e[ELEM_SIZE]
	let t = e[N_TYPE]
	let m = mk_mem(pos, data, idx, size, 0, t)
	m[MEM_LEN] = lenx
	replace_node(e, m)
}

fn int_node(pos i64, v i64) i64 {
	let n = node_new(EX_INT, pos)
	n[INT_VAL] = v
	n[N_TYPE] = ty_int
	return n
}

// mem_rewrite turns base[a + b] (unchecked) with base and a invariant into
// (base + a*scale)[b], so the row address is computed once per loop.
fn mem_rewrite(e i64) {
	let ix = e[MEM_INDEX]
	if ix == 0 || e[MEM_LEN] != 0 || ix[N_KIND] != EX_BINARY || streq(ix[BIN_OP], cstr("+")) == 0 || invariant(e[MEM_BASE]) == 0 {
		return
	}
	mut a = ix[BIN_L]
	mut b = ix[BIN_R]
	if invariant(b) != 0 && invariant(a) == 0 {
		a = ix[BIN_R]
		b = ix[BIN_L]
	}
	if invariant(a) == 0 || invariant(b) != 0 {
		return
	}
	let sh = int_node(e[N_POS], width_log2(e[MEM_SCALE]))
	e[MEM_BASE] = binary_node(e[N_POS], cstr("+"), e[MEM_BASE], binary_node(e[N_POS], cstr("<<"), a, sh))
	e[MEM_INDEX] = b
}
