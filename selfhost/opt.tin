// Analysis for code generation: leaf functions, address-taken locals, loop-weighted uses.
shared mut an_fn i64
shared mut an_depth i64

fn analyze_fn(f Fn) {
	an_fn = cast(i64, f)
	an_depth = 0
	f.leaf = 1
	let locals = cast([]i64, f.locals)
	mut i = 0
	for i < len(locals) {
		let s = cast(Sym, locals[i])
		s.uses = 0
		s.addr = 0
		i = i + 1
	}
	an_stmts(cast(Block, f.body).stmts)
}

// A use inside k nested loops counts 8^k, so inner-loop variables win registers.
fn an_use(s Sym) {
	if s.kind != SYM_LOCAL {
		return
	}
	mut w = 512
	if an_depth < 3 {
		w = 1 << (3 * an_depth)
	}
	s.uses = s.uses + w
}

fn an_stmts(stmts []i64) {
	mut i = 0
	for i < len(stmts) {
		an_stmt(stmts[i])
		i = i + 1
	}
}

fn an_stmt(s i64) {
	let k = cast(Node, s).kind
	if k == ST_BLOCK {
		an_stmts(cast(Block, s).stmts)
	} else if k == ST_LET {
		an_expr(cast(LetStmt, s).init)
		an_use(cast(Sym, cast(LetStmt, s).sym))
	} else if k == ST_ASSIGN {
		let t = cast(AssignStmt, s).target
		if cast(Node, t).kind == EX_IDENT {
			an_use(cast(Sym, cast(IdentExpr, t).ref))
		} else {
			an_expr(t)
		}
		an_expr(cast(AssignStmt, s).value)
	} else if k == ST_EXPR {
		an_expr(cast(ExprStmt, s).x)
	} else if k == ST_IF {
		an_expr(cast(IfStmt, s).cond)
		an_stmts(cast(Block, cast(IfStmt, s).then).stmts)
		if cast(IfStmt, s).else_ != 0 {
			an_stmt(cast(IfStmt, s).else_)
		}
	} else if k == ST_WHILE {
		let loop_ = i64(cast(WhileStmt, s).once_ == 0)
		an_depth = an_depth + loop_
		an_expr(cast(WhileStmt, s).cond)
		an_stmts(cast(Block, cast(WhileStmt, s).body).stmts)
		if cast(WhileStmt, s).post != 0 {
			an_stmt(cast(WhileStmt, s).post)
		}
		an_depth = an_depth - loop_
	} else if k == ST_RETURN {
		if cast(ReturnStmt, s).value != 0 {
			an_expr(cast(ReturnStmt, s).value)
		}
		if cast(i64, cast(ReturnStmt, s).values) != 0 {
			an_exprs(cast(ReturnStmt, s).values)
		}
	} else if k == ST_CALLMULTI {
		an_expr(cast(CallMultiStmt, s).call)
		mut i = 0
		for i < len(cast(CallMultiStmt, s).syms) {
			an_use(cast(CallMultiStmt, s).syms[i])
			i = i + 1
		}
	}
}

fn an_exprs(v []i64) {
	mut i = 0
	for i < len(v) {
		an_expr(v[i])
		i = i + 1
	}
}

fn an_expr(e i64) {
	let k = cast(Node, e).kind
	if k == EX_IDENT {
		an_use(cast(Sym, cast(IdentExpr, e).ref))
	} else if k == EX_UNARY {
		let x = cast(IdentExpr, cast(Unary, e).x)
		if streq(cast(Unary, e).op, cstr("&")) != 0 && cast(Sym, x.ref).kind == SYM_LOCAL {
			cast(Sym, x.ref).addr = 1
		}
		an_expr(cast(i64, x))
	} else if k == EX_BINARY {
		an_expr(cast(Binary, e).l)
		an_expr(cast(Binary, e).r)
	} else if k == EX_INDEX {
		an_expr(cast(IndexExpr, e).x)
		an_expr(cast(IndexExpr, e).i)
	} else if k == EX_CONV {
		an_expr(cast(Conv, e).x)
	} else if k == EX_MEM {
		an_expr(cast(MemExpr, e).base)
		if cast(MemExpr, e).index != 0 {
			an_expr(cast(MemExpr, e).index)
		}
		if cast(MemExpr, e).len != 0 {
			an_expr(cast(MemExpr, e).len)
		}
	} else if k == EX_ELEM {
		an_expr(cast(ElemExpr, e).seq)
		an_expr(cast(ElemExpr, e).idx)
	} else if k == EX_SEQ {
		an_stmts(cast(SeqExpr, e).stmts)
		an_expr(cast(SeqExpr, e).value)
	} else if k == EX_CALL {
		if cast(Call, e).intrinsic == 0 {
			cast(Fn, an_fn).leaf = 0
		}
		if cast(Call, e).callee != 0 {
			an_expr(cast(Call, e).callee)
		}
		let args = cast(Call, e).args
		mut i = 0
		for i < len(args) {
			an_expr(args[i])
			i = i + 1
		}
	}
}

// ---- loop-invariant code motion ----
//
// Runs on the AST before analysis. An expression is invariant in a loop when it only
// reads constants and register-eligible locals the loop never assigns, and cannot panic
// (a division needs a nonzero constant divisor), so hoisting it ahead of the loop, even
// out of a guard or a loop that runs zero times, is always safe. Indexes
// of the form x[a + b] with x and a invariant become (x + a*8)[b], so the row address
// is computed once per loop instead of once per element.
shared mut lc_fn i64
shared mut lc_assigned []i64
shared mut lc_exprs []i64
shared mut lc_syms []Sym
shared mut lc_pre []i64
shared mut lc_calls i64 // the loop makes calls, so headers may change under it

fn licm_fn(f Fn) {
	analyze_fn(f)
	lc_fn = cast(i64, f)
	prefetch_block(cast(Block, f.body).stmts)
	licm_block(cast(Block, f.body))
}

// ---- strided prefetch ----
//
// An innermost loop that stores to x[j] while stepping j by a variable (or large)
// stride misses cache on nearly every iteration; the core can only track so many
// misses at once. Prefetching x[j + 4*step] keeps more of them in flight (sieve:
// 155ms -> 133ms). Go does not do this.
const PF_AHEAD = 4

fn prefetch_block(stmts []i64) {
	mut i = 0
	for i < len(stmts) {
		let s = stmts[i]
		let k = cast(Node, s).kind
		if k == ST_WHILE && cast(WhileStmt, s).once_ != 0 {
			prefetch_block(cast(Block, cast(WhileStmt, s).body).stmts)
		} else if k == ST_WHILE {
			if has_loop(cast(Block, cast(WhileStmt, s).body).stmts) != 0 {
				prefetch_block(cast(Block, cast(WhileStmt, s).body).stmts)
			} else {
				prefetch_loop(s)
			}
		} else if k == ST_BLOCK {
			prefetch_block(cast(Block, s).stmts)
		} else if k == ST_IF {
			prefetch_block(cast(Block, cast(IfStmt, s).then).stmts)
			mut els = cast(IfStmt, s).else_
			for els != 0 && cast(Node, els).kind == ST_IF {
				prefetch_block(cast(Block, cast(IfStmt, els).then).stmts)
				els = cast(IfStmt, els).else_
			}
			if els != 0 {
				prefetch_block(cast(Block, els).stmts)
			}
		}
		i = i + 1
	}
}

fn has_loop(stmts []i64) i64 {
	mut i = 0
	for i < len(stmts) {
		let s = stmts[i]
		let k = cast(Node, s).kind
		if k == ST_WHILE && cast(WhileStmt, s).once_ == 0 {
			return 1
		}
		if k == ST_WHILE && has_loop(cast(Block, cast(WhileStmt, s).body).stmts) != 0 {
			return 1
		}
		if k == ST_BLOCK && has_loop(cast(Block, s).stmts) != 0 {
			return 1
		}
		if k == ST_IF {
			if has_loop(cast(Block, cast(IfStmt, s).then).stmts) != 0 {
				return 1
			}
			if cast(IfStmt, s).else_ != 0 {
				let one = []i64{}
				one = append(one, cast(IfStmt, s).else_)
				if has_loop(cast([]i64, one)) != 0 {
					return 1
				}
			}
		}
		i = i + 1
	}
	return 0
}

fn is_reg_local(e i64) i64 {
	return i64(cast(Node, e).kind == EX_IDENT && cast(Sym, cast(IdentExpr, e).ref).kind == SYM_LOCAL && cast(Sym, cast(IdentExpr, e).ref).addr == 0)
}

fn prefetch_loop(w i64) {
	if cast(WhileStmt, w).once_ != 0 {
		return
	}
	let body0 = cast(Block, cast(WhileStmt, w).body).stmts
	let body = []i64{}
	mut bi = 0
	for bi < len(body0) {
		body = append(body, body0[bi])
		bi = bi + 1
	}
	if cast(WhileStmt, w).post != 0 {
		body = append(body, cast(WhileStmt, w).post)
	}
	lc_assigned = []i64{}
	lc_calls = stmts_have_call(cast([]i64, body))
	collect_assigned(cast([]i64, body))
	// The induction step: a top-level `j = j + step` with step invariant.
	mut j = cast(Sym, 0)
	mut step = 0
	mut i = 0
	for i < len(cast([]i64, body)) {
		let s = body[i]
		if cast(Node, s).kind == ST_ASSIGN && is_reg_local(cast(AssignStmt, s).target) != 0 {
			let v = cast(AssignStmt, s).value
			let t = cast(IdentExpr, cast(AssignStmt, s).target).ref
			if cast(Node, v).kind == EX_BINARY && streq(cast(Binary, v).op, cstr("+")) != 0 && cast(Node, cast(Binary, v).l).kind == EX_IDENT && cast(IdentExpr, cast(Binary, v).l).ref == t && invariant(cast(Binary, v).r) != 0 {
				j = cast(Sym, t)
				step = cast(Binary, v).r
			}
		}
		i = i + 1
	}
	if cast(i64, j) == 0 || count_assigns(cast(i64, body), cast(i64, j)) != 1 {
		return
	}
	if is_const(step) != 0 && const_val(step) < 8 && const_val(step) > -8 {
		return
	}
	// The strided access: x[j] = ... with x invariant.
	mut target = 0
	i = 0
	for i < len(cast([]i64, body)) {
		let s = body[i]
		if cast(Node, s).kind == ST_ASSIGN && cast(Node, cast(AssignStmt, s).target).kind == EX_INDEX {
			let ix = cast(IndexExpr, cast(AssignStmt, s).target)
			if (is_reg_local(ix.x) != 0 || cast(IndexExpr, ix.x).hdr != 0) && invariant(ix.x) != 0 && cast(Node, ix.i).kind == EX_IDENT && cast(i64, cast(Sym, cast(IdentExpr, ix.i).ref)) == cast(i64, j) {
				target = cast(i64, ix)
			}
		}
		if cast(Node, s).kind == ST_ASSIGN && cast(Node, cast(AssignStmt, s).target).kind == EX_ELEM {
			let el = cast(ElemExpr, cast(AssignStmt, s).target)
			if is_reg_local(el.seq) != 0 && invariant(el.seq) != 0 && el.size == 8 && cast(Node, el.idx).kind == EX_IDENT && cast(i64, cast(Sym, cast(IdentExpr, el.idx).ref)) == cast(i64, j) {
				target = cast(i64, el)
			}
		}
		i = i + 1
	}
	if target == 0 {
		return
	}
	let pos = cast(Node, w).pos
	let ahead = cast(IntLit, node_new(EX_INT, pos))
	ahead.val = PF_AHEAD
	let jref = cast(IdentExpr, node_new(EX_IDENT, pos))
	jref.name = j.name
	jref.ref = cast(i64, j)
	let call = cast(Call, node_new(EX_CALL, pos))
	call.name = cstr("__prefetchw")
	call.args = []i64{}
	call.intrinsic = 1
	if cast(Node, target).kind == EX_ELEM {
		call.args = append(call.args, mk_hdr(pos, node_copy(cast(ElemExpr, target).seq), 2))
	} else {
		call.args = append(call.args, node_copy(cast(IndexExpr, target).x))
	}
	call.args = append(call.args, binary_node(pos, cstr("+"), cast(i64, jref), binary_node(pos, cstr("*"), node_copy(step), cast(i64, ahead))))
	let st = cast(ExprStmt, node_new(ST_EXPR, pos))
	st.x = cast(i64, call)
	let nb = []i64{}
	nb = append(nb, cast(i64, st))
	i = 0
	for i < len(body0) {
		nb = append(nb, body0[i])
		i = i + 1
	}
	cast(Block, cast(WhileStmt, w).body).stmts = nb
}

fn count_assigns(stmts i64, sym i64) i64 {
	mut n = 0
	mut i = 0
	for i < len(lc_assigned) {
		if lc_assigned[i] == sym {
			n = n + 1
		}
		i = i + 1
	}
	return n
}

fn licm_block(b Block) {
	let stmts = b.stmts
	let result = []i64{}
	mut i = 0
	for i < len(stmts) {
		let s = stmts[i]
		licm_nested(s)
		if cast(Node, s).kind == ST_WHILE && cast(WhileStmt, s).once_ == 0 {
			let pre = cast([]i64, licm_loop(cast(WhileStmt, s)))
			mut j = 0
			for j < len(pre) {
				result = append(result, pre[j])
				j = j + 1
			}
		}
		result = append(result, s)
		i = i + 1
	}
	b.stmts = cast([]i64, result)
}

fn licm_nested(s i64) {
	let k = cast(Node, s).kind
	if k == ST_BLOCK {
		licm_block(cast(Block, s))
	} else if k == ST_IF {
		licm_block(cast(Block, cast(IfStmt, s).then))
		if cast(IfStmt, s).else_ != 0 {
			licm_nested(cast(IfStmt, s).else_)
		}
	} else if k == ST_WHILE {
		licm_block(cast(Block, cast(WhileStmt, s).body))
	}
}

// licm_loop rewrites loop w in place and returns the lets to run before it.
fn licm_loop(w WhileStmt) i64 {
	lc_assigned = []i64{}
	lc_exprs = []i64{}
	lc_syms = cast([]Sym, []i64{})
	lc_pre = []i64{}
	lc_calls = i64(stmts_have_call(cast(Block, w.body).stmts) != 0 || contains_call(w.cond) != 0 || stmt_has_call(w.post) != 0)
	collect_assigned(cast(Block, w.body).stmts)
	if w.post != 0 {
		let one = []i64{}
		one = append(one, w.post)
		collect_assigned(cast([]i64, one))
	}
	hoist_expr(w.cond)
	hoist_stmts(cast(Block, w.body).stmts)
	if w.post != 0 {
		let two = []i64{}
		two = append(two, w.post)
		hoist_stmts(cast([]i64, two))
	}
	return cast(i64, lc_pre)
}

fn collect_assigned(stmts []i64) {
	mut i = 0
	for i < len(stmts) {
		let s = stmts[i]
		let k = cast(Node, s).kind
		if k == ST_LET {
			lc_assigned = append(lc_assigned, cast(LetStmt, s).sym)
		} else if k == ST_ASSIGN && cast(Node, cast(AssignStmt, s).target).kind == EX_IDENT {
			lc_assigned = append(lc_assigned, cast(IdentExpr, cast(AssignStmt, s).target).ref)
		} else if k == ST_BLOCK {
			collect_assigned(cast(Block, s).stmts)
		} else if k == ST_IF {
			collect_assigned(cast(Block, cast(IfStmt, s).then).stmts)
			mut els = cast(IfStmt, s).else_
			for els != 0 && cast(Node, els).kind == ST_IF {
				collect_assigned(cast(Block, cast(IfStmt, els).then).stmts)
				els = cast(IfStmt, els).else_
			}
			if els != 0 {
				collect_assigned(cast(Block, els).stmts)
			}
		} else if k == ST_WHILE {
			collect_assigned(cast(Block, cast(WhileStmt, s).body).stmts)
			if cast(WhileStmt, s).post != 0 {
				let one = []i64{}
				one = append(one, cast(WhileStmt, s).post)
				collect_assigned(cast([]i64, one))
			}
		} else if k == ST_CALLMULTI {
			mut j = 0
			for j < len(cast(CallMultiStmt, s).syms) {
				lc_assigned = append(lc_assigned, cast(i64, cast(CallMultiStmt, s).syms[j]))
				j = j + 1
			}
		}
		i = i + 1
	}
}

fn is_assigned(s i64) i64 {
	mut i = 0
	for i < len(lc_assigned) {
		if lc_assigned[i] == s {
			return 1
		}
		i = i + 1
	}
	return 0
}

fn invariant(e i64) i64 {
	let k = cast(Node, e).kind
	if k == EX_INT {
		return 1
	}
	if k == EX_IDENT {
		let s = cast(Sym, cast(IdentExpr, e).ref)
		if s.kind == SYM_CONST {
			return 1
		}
		return i64(s.kind == SYM_LOCAL && s.addr == 0 && is_assigned(cast(i64, s)) == 0)
	}
	if k == EX_UNARY {
		return i64(streq(cast(Unary, e).op, cstr("&")) == 0 && invariant(cast(Unary, e).x) != 0)
	}
	if k == EX_BINARY {
		return i64(streq(cast(Binary, e).op, cstr("&&")) == 0 && streq(cast(Binary, e).op, cstr("||")) == 0 && may_panic(cast(Binary, e)) == 0 && invariant(cast(Binary, e).l) != 0 && invariant(cast(Binary, e).r) != 0)
	}
	if k == EX_FLOAT {
		return 1
	}
	if k == EX_CONV {
		if (cast(Conv, e).kind == CV_LEN || cast(Conv, e).kind == CV_CAP) && lc_calls != 0 {
			return 0
		}
		return invariant(cast(Conv, e).x)
	}
	if k == EX_INDEX && cast(IndexExpr, e).hdr != 0 {
		// Slice and string headers only change through runtime calls.
		return i64(lc_calls == 0 && invariant(cast(IndexExpr, e).x) != 0)
	}
	if k == EX_MEM && cast(MemExpr, e).hdr != 0 {
		return i64(lc_calls == 0 && cast(MemExpr, e).index == 0 && invariant(cast(MemExpr, e).base) != 0)
	}
	return 0
}

// op_cost estimates the instructions an expression needs; multiplies and divides count triple.
fn op_cost(e i64) i64 {
	let k = cast(Node, e).kind
	if k == EX_BINARY {
		let op = cast(Binary, e).op
		mut c = 1
		if streq(op, cstr("*")) != 0 || streq(op, cstr("/")) != 0 || streq(op, cstr("%")) != 0 {
			c = 3
		}
		return c + op_cost(cast(Binary, e).l) + op_cost(cast(Binary, e).r)
	}
	if k == EX_UNARY {
		return 1 + op_cost(cast(Unary, e).x)
	}
	if k == EX_CONV {
		return 1 + op_cost(cast(Conv, e).x)
	}
	if k == EX_INDEX {
		return 2 + op_cost(cast(IndexExpr, e).x)
	}
	if k == EX_MEM {
		return 2 + op_cost(cast(MemExpr, e).base)
	}
	if k == EX_FLOAT && cast(FloatLit, e).bits != 0 {
		return 2
	}
	return 0
}

fn hoist_stmts(stmts []i64) {
	mut i = 0
	for i < len(stmts) {
		let s = stmts[i]
		let k = cast(Node, s).kind
		if k == ST_LET {
			hoist_expr(cast(LetStmt, s).init)
		} else if k == ST_ASSIGN {
			hoist_expr(cast(AssignStmt, s).target)
			hoist_expr(cast(AssignStmt, s).value)
		} else if k == ST_EXPR {
			hoist_expr(cast(ExprStmt, s).x)
		} else if k == ST_RETURN {
			if cast(ReturnStmt, s).value != 0 {
				hoist_expr(cast(ReturnStmt, s).value)
			}
		} else if k == ST_BLOCK {
			hoist_stmts(cast(Block, s).stmts)
		} else if k == ST_IF {
			hoist_expr(cast(IfStmt, s).cond)
			hoist_stmts(cast(Block, cast(IfStmt, s).then).stmts)
			let els = cast(IfStmt, s).else_
			if els != 0 && cast(Node, els).kind == ST_BLOCK {
				hoist_stmts(cast(Block, els).stmts)
			} else if els != 0 {
				let one = []i64{}
				one = append(one, els)
				hoist_stmts(cast([]i64, one))
			}
		} else if k == ST_WHILE {
			hoist_expr(cast(WhileStmt, s).cond)
			hoist_stmts(cast(Block, cast(WhileStmt, s).body).stmts)
			if cast(WhileStmt, s).post != 0 {
				let one = []i64{}
				one = append(one, cast(WhileStmt, s).post)
				hoist_stmts(cast([]i64, one))
			}
		} else if k == ST_CALLMULTI {
			hoist_expr(cast(CallMultiStmt, s).call)
		}
		i = i + 1
	}
}

fn hoist_expr(e i64) {
	if e == 0 {
		return
	}
	mut k = cast(Node, e).kind
	if (k == EX_BINARY || k == EX_UNARY || k == EX_CONV || k == EX_FLOAT || (k == EX_INDEX && cast(IndexExpr, e).hdr != 0) || (k == EX_MEM && cast(MemExpr, e).hdr != 0)) && invariant(e) != 0 && is_const(e) == 0 && op_cost(e) >= 2 {
		replace_with_temp(e)
		return
	}
	if k == EX_ELEM {
		elem_specialize(e)
		k = cast(Node, e).kind
	}
	if k == EX_INDEX {
		index_rewrite(e)
		hoist_expr(cast(IndexExpr, e).x)
		hoist_expr(cast(IndexExpr, e).i)
	} else if k == EX_MEM {
		mem_rewrite(e)
		hoist_expr(cast(MemExpr, e).base)
		hoist_expr(cast(MemExpr, e).index)
		hoist_expr(cast(MemExpr, e).len)
	} else if k == EX_ELEM {
		hoist_expr(cast(ElemExpr, e).seq)
		hoist_expr(cast(ElemExpr, e).idx)
	} else if k == EX_UNARY {
		hoist_expr(cast(Unary, e).x)
	} else if k == EX_BINARY {
		hoist_expr(cast(Binary, e).l)
		hoist_expr(cast(Binary, e).r)
	} else if k == EX_CONV {
		hoist_expr(cast(Conv, e).x)
	} else if k == EX_CALL {
		let args = cast(Call, e).args
		mut i = 0
		for i < len(args) {
			hoist_expr(args[i])
			i = i + 1
		}
	}
}

fn binary_node(pos i64, op i64, l i64, r i64) i64 {
	let b = cast(Binary, node_new(EX_BINARY, pos))
	b.op = op
	b.l = l
	b.r = r
	return cast(i64, b)
}

// index_rewrite turns x[a + b] into (x + (a << 3))[b] when x and a are invariant and b is not.
fn index_rewrite(e i64) {
	let ix = cast(IndexExpr, e).i
	if cast(Node, ix).kind != EX_BINARY || streq(cast(Binary, ix).op, cstr("+")) == 0 || invariant(cast(IndexExpr, e).x) == 0 {
		return
	}
	mut a = cast(Binary, ix).l
	mut b = cast(Binary, ix).r
	if invariant(b) != 0 && invariant(a) == 0 {
		a = cast(Binary, ix).r
		b = cast(Binary, ix).l
	}
	if invariant(a) == 0 || invariant(b) != 0 {
		return
	}
	let three = cast(IntLit, node_new(EX_INT, cast(Node, e).pos))
	three.val = 3
	cast(IndexExpr, e).x = binary_node(cast(Node, e).pos, cstr("+"), cast(IndexExpr, e).x, binary_node(cast(Node, e).pos, cstr("<<"), a, cast(i64, three)))
	cast(IndexExpr, e).i = b
}

// replace_with_temp moves e into a let before the loop and turns e into a read of it,
// reusing the temp of an identical expression hoisted earlier from the same loop.
fn replace_with_temp(e i64) {
	mut s = cast(Sym, 0)
	mut i = 0
	for i < len(lc_exprs) && cast(i64, s) == 0 {
		if expr_equal(lc_exprs[i], e) != 0 {
			s = lc_syms[i]
		}
		i = i + 1
	}
	if cast(i64, s) == 0 {
		let moved = node_copy(e)
		s = sym_new(SYM_LOCAL, cstr("licm"), cast(Node, e).pos)
		s.type_ = cast(Node, e).type_
		s.slot = cast(Fn, lc_fn).slots
		cast(Fn, lc_fn).slots = cast(Fn, lc_fn).slots + 1
		cast(Fn, lc_fn).locals = append(cast(Fn, lc_fn).locals, cast(Sym, s))
		let l = cast(LetStmt, node_new(ST_LET, cast(Node, e).pos))
		l.name = cstr("licm")
		l.init = moved
		l.sym = cast(i64, s)
		lc_pre = append(lc_pre, cast(i64, l))
		lc_exprs = append(lc_exprs, moved)
		lc_syms = append(lc_syms, cast(Sym, s))
	}
	let t = cast(Node, e).type_
	cast(Node, e).kind = EX_IDENT
	cast(IdentExpr, e).name = s.name
	cast(IdentExpr, e).ref = cast(i64, s)
	cast(Node, e).w4 = 0
	cast(Node, e).w5 = 0
	cast(Node, e).type_ = t
	cast(Node, e).w7 = 0
}

// elem_specialize turns s[i] in a loop that cannot change s into a plain load from the
// hoisted data pointer, checked against the hoisted length.
fn elem_specialize(e i64) {
	let x = cast(ElemExpr, e).seq
	if lc_calls != 0 || invariant(x) == 0 || is_reg_local(x) == 0 {
		return
	}
	let pos = cast(Node, e).pos
	mut data = cast(Node, 0)
	if cast(ElemExpr, e).str != 0 {
		data = cast(Node, binary_node(pos, cstr("+"), node_copy(x), int_node(pos, 8)))
		data.type_ = ty_int
	} else {
		data = cast(Node, mk_hdr(pos, node_copy(x), 2))
	}
	mut lenx = 0
	if cast(ElemExpr, e).safe == 0 {
		lenx = mk_hdr(pos, node_copy(x), 0)
	}
	let idx = cast(ElemExpr, e).idx
	let size = cast(ElemExpr, e).size
	let t = cast(Node, e).type_
	let m = cast(MemExpr, mk_mem(pos, cast(i64, data), idx, size, 0, t))
	m.len = lenx
	replace_node(e, cast(i64, m))
}

fn int_node(pos i64, v i64) i64 {
	let n = node_new(EX_INT, pos)
	cast(IntLit, n).val = v
	cast(Node, n).type_ = ty_int
	return n
}

// mem_rewrite turns base[a + b] (unchecked) with base and a invariant into
// (base + a*scale)[b], so the row address is computed once per loop.
fn mem_rewrite(e i64) {
	let ix = cast(MemExpr, e).index
	if ix == 0 || cast(MemExpr, e).len != 0 || cast(Node, ix).kind != EX_BINARY || streq(cast(Binary, ix).op, cstr("+")) == 0 || invariant(cast(MemExpr, e).base) == 0 {
		return
	}
	mut a = cast(Binary, ix).l
	mut b = cast(Binary, ix).r
	if invariant(b) != 0 && invariant(a) == 0 {
		a = cast(Binary, ix).r
		b = cast(Binary, ix).l
	}
	if invariant(a) == 0 || invariant(b) != 0 {
		return
	}
	let sh = int_node(cast(Node, e).pos, width_log2(cast(MemExpr, e).scale))
	cast(MemExpr, e).base = binary_node(cast(Node, e).pos, cstr("+"), cast(MemExpr, e).base, binary_node(cast(Node, e).pos, cstr("<<"), a, sh))
	cast(MemExpr, e).index = b
}
