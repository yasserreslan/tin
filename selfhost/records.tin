// The compiler's records: structs laid over the word arrays its passes share. Each field sits at the
// offset its former constant named; `wN` fills a word no pass names.

type AssignStmt struct {
	w0 i64
	w1 i64
	target i64
	value i64
}

type Binary struct {
	w0 i64
	w1 i64
	op i64
	l i64
	r i64
}

type Block struct {
	w0 i64
	w1 i64
	stmts Vec[i64]
	flat i64
	cellsym i64 // a celled range variable: the cell's symbol
}

type BodyStmt struct {
	w0 i64
	w1 i64
	block i64
}

type BoundaryStmt struct {
	w0 i64
	w1 i64
	kind i64
	args Vec[i64]
	body i64
}

type BreakStmt struct {
	w0 i64
	w1 i64
	label i64
}

type Call struct {
	w0 i64
	w1 i64
	name i64
	args Vec[i64]
	intrinsic i64
	fn_ i64
	w6 i64
	callee i64
	store i64
	method i64
	dyn_shape i64
	dyn_index i64
}

type CatchExpr struct {
	w0 i64
	w1 i64
	x i64
	name i64
	body i64
}

type Composite struct {
	w0 i64
	w1 i64
	type_ i64
	elems Vec[i64]
	keys Vec[i64]
}

type CallMultiStmt struct {
	w0 i64
	w1 i64
	call i64
	syms Vec[Sym]
}

type Coalesce struct {
	w0 i64
	w1 i64
	x i64
	fallback i64
}

type ContinueStmt struct {
	w0 i64
	w1 i64
	label i64
}

type CapsRec struct {
	path i64
	caps i64
	manifest i64
}

type Conv struct {
	w0 i64
	w1 i64
	x i64
	kind i64
	w4 i64
	dyn_table i64
	w6 i64
	dyn_index i64
}

type Decl struct {
	pos i64
	name i64
	init i64
	val i64
	type_ i64
	file i64
	iota i64
	sym i64
	shared_ i64
	tparams i64
	tcons i64
	insts i64
	methods i64
	shape_ i64
	inits i64
	union i64
	unionkind i64
	mut_ i64
}

type ElemExpr struct {
	w0 i64
	w1 i64
	seq i64
	idx i64
	size i64
	str i64
	w6 i64
	safe i64
}

type ExprStmt struct {
	w0 i64
	w1 i64
	x i64
}

type Fn struct {
	pos i64
	name i64
	params Vec[i64]
	extern_ i64
	body i64
	slots i64
	locals Vec[Sym]
	leaf i64
	used i64
	addr i64
	got i64
	ptypes i64
	rtypes Vec[i64]
	recv i64
	recvname i64
	file i64
	qname i64
	generated i64
	variadic i64
	reach i64
	type_ i64
	lifted i64
	index i64
	muts i64
	mutres i64
	recvmut i64
	regsum i64
	initwalk i64
	tparams i64
	tcons i64
	toks i64
	tokat i64
	tbind i64
	insts i64
	genof i64
	bang i64
	parent i64
	captures Vec[Sym]
	outer_syms i64
	env_sym i64
	done i64
	escapes i64
	instcycle i64
	attrs i64
}

type FailStmt struct {
	w0 i64
	w1 i64
	x i64
}

type FloatLit struct {
	w0 i64
	w1 i64
	bits i64
	text i64
}

type FuncRef struct {
	w0 i64
	w1 i64
	fn_ i64
	raw i64
}

type GoStmt struct {
	w0 i64
	w1 i64
	call i64
}

type IdentExpr struct {
	w0 i64
	w1 i64
	name i64
	ref i64
}

type IfStmt struct {
	w0 i64
	w1 i64
	cond i64
	then i64
	else_ i64
	init i64
}

type IntLit struct {
	w0 i64
	w1 i64
	val i64
	w3 i64 // words a folded expression leaves behind: cleared when it becomes a literal
	w4 i64
	w5 i64
	w6 i64
	char_ i64 // written as a character literal
	big i64 // above 2^63-1: its bits look negative
}

type InterpExpr struct {
	w0 i64
	w1 i64
	parts Vec[i64]
	args Vec[i64]
	specs Vec[i64]
}

type IndexExpr struct {
	w0 i64
	w1 i64
	x i64
	i i64
	args i64
	w5 i64
	w6 i64
	hdr i64
}

