	init i64
	sym i64
	type_ i64
	mut_ i64
}

type ListStmt struct {
	w0 i64
	w1 i64
	stmts Vec[i64]
}

type FuncLit struct {
	w0 i64
	w1 i64
	fn_ i64
	escape i64
	scoped i64
}

type MatchExpr struct {
	w0 i64
	w1 i64
	subject i64
	arms Vec[i64]
}

type MemExpr struct {
	w0 i64
	w1 i64
	base i64
	index i64
	scale i64
	off i64
	w6 i64
	hdr i64
	len i64
}

type MatchStmtRec struct {
	w0 i64
	w1 i64
	w2 i64
	rec i64
}

type MultiStmt struct {
	w0 i64
	w1 i64
	targets Vec[i64]
	values Vec[i64]
	define i64
	mut_ i64
}

type MutArg struct {
	w0 i64
	w1 i64
	x i64
}

type Node struct {
	kind i64
	pos i64
	w2 i64
	w3 i64
	w4 i64
	w5 i64
	type_ i64
	w7 i64
	w8 i64
	region i64
}

type OnStmt struct {
	w0 i64
	w1 i64
	event i64
	body i64
	file i64
}

type RegExpr struct {
	w0 i64
	w1 i64
	num i64
}

type ReturnStmt struct {
	w0 i64
	w1 i64
	value i64
	values Vec[i64]
}

type RangeStmt struct {
	w0 i64
	w1 i64
	key i64
	val i64
	expr i64
