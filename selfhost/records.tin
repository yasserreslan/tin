}

type Sym struct {
	kind i64
	name i64
	pos i64
	slot i64
	val i64
	done i64
	fn_ i64
	index i64
	reg i64
	off i64
	uses i64
	addr i64
	type_ i64
	decl i64
	expr i64
	reads i64
	w16 i64
	mut_ i64
	region i64
	tls i64
	big i64
	uninit i64
	captured i64
	cap_idx i64
	cell i64
	cell_sym i64
	words i64
	capbits i64
	cell_of i64
	kept_cap i64
	scope_at i64
	alias i64    // the slice variable this one was copied from (x = y), or 0 (#352)
	alias2 i64   // a slice variable copied from this one
	stale i64    // where append grew the slice this one shares, since this one was last read
	stale_by i64 // the variable append grew
}

type ScopeStmt struct {
	w0 i64
	w1 i64
	name i64
	body i64
}

type SelectExpr struct {
	w0 i64
	w1 i64
	x i64
	name i64
}

type SelectStmt struct {
	w0 i64
	w1 i64
	arms Vec[i64]
}

type SeqExpr struct {
	w0 i64
	w1 i64
	stmts Vec[i64]
	value i64
}

type SliceExpr struct {
	w0 i64
	w1 i64
	x i64
	lo i64
	hi i64
}

type StrLit struct {
	w0 i64
	w1 i64
	ptr i64
	len i64
}

type SwitchStmt struct {
	w0 i64
	w1 i64
	tag i64
	cases Vec[i64]
	w4 i64
	init i64
}

type Token struct {
	kind i64
	text i64
	val i64
	pos i64
	raw i64
	dbl i64
	unit i64
	start i64
	end i64
	synth i64
}

type TryExpr struct {
	w0 i64
	w1 i64
	x i64
	soft i64
}

type TypeExpr struct {
	w0 i64
	w1 i64
	a i64
	b i64
	args i64
}

type Ty struct {
	kind i64
	elem i64
	key i64
	fields i64
	results i64
	name i64
	variadic i64
	width i64
	signed i64
	size i64
	targs i64
	gdecl i64
	enum_ i64
	secret_ i64
	bound i64
	max i64
}

