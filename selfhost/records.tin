}

type CkState struct {
	file i64
	fn_ Fn
	tbind Vec[i64]
}

type MatchArm struct {
	pos i64
	patterns Vec[i64]
	guard_ i64
	body i64
	block i64
}

type SelectArm struct {
	pos i64
	name i64
	wait i64
	body i64
	block i64
}

type Pattern struct {
	kind i64
	pos i64
