// The compiler's records: structs laid over the word arrays its passes share. Each field sits at the
// offset its former constant named; `wN` fills a word no pass names.

type AssignStmt struct {
	w0 i64
	w1 i64
	target i64
	value i64
}

type Binary struct {
	w0 i64
	w1 i64
	op str
	l i64
	r i64
	ovf i64 // OVF_* (#362): integer + - * / and shifts the checker marks for a run-time check.
}

type Block struct {
	w0 i64
	w1 i64
	stmts []i64
	flat i64
	cellsym i64 // a celled range variable: the cell's symbol
}

type BodyStmt struct {
	w0 i64
	w1 i64
	block i64
}

type BoundaryStmt struct {
	w0 i64
	w1 i64
	kind i64
	args []i64
	body i64
}

type BreakStmt struct {
	w0 i64
	w1 i64
	label str
}

type Call struct {
	w0 i64
	w1 i64
	name str
	args []i64
	intrinsic i64
	fn_ i64
	w6 i64
	callee i64
	store i64
	method i64
	dyn_shape i64
	dyn_index i64
}

type CatchExpr struct {
	w0 i64
	w1 i64
	x i64
	name str
	body i64
}

type Composite struct {
	w0 i64
	w1 i64
	type_ i64
	elems []i64
	keys []i64
}

type CallMultiStmt struct {
	w0 i64
	w1 i64
	call i64
	syms []Sym
}

type Coalesce struct {
	w0 i64
	w1 i64
	x i64
	fallback i64
}

type ContinueStmt struct {
	w0 i64
	w1 i64
	label str
}

type CapsRec struct {
	path str
	caps i64
	manifest str
}

type Conv struct {
	w0 i64
	w1 i64
	x i64
	kind i64
	ovf i64 // OVF_CHECK on a float to integer conversion that panics out of range (#362).
	dyn_table i64
	w6 i64
	dyn_index i64
}

type Decl struct {
	pos i64
	name str
	init i64
	val i64
	type_ i64
	file i64
	iota i64
	sym i64
	shared_ i64
	tparams []str
	tcons []i64
	insts []i64
	methods []i64
	shape_ []i64
	inits []i64
	union []i64
	unionkind i64
	mut_ i64
}

type ElemExpr struct {
	w0 i64
	w1 i64
	seq i64
	idx i64
	size i64
	str i64
	w6 i64
	safe i64
}

type ExprStmt struct {
	w0 i64
	w1 i64
	x i64
}

type Fn struct {
	pos i64
	name str
	params []str
	extern_ i64
	body i64
	slots i64
	locals []Sym
	leaf i64
	used i64
	addr i64
	got i64
	ptypes []i64
	rtypes []i64
	recv i64
	recvname str
	file i64
	qname str
	generated i64
	variadic i64
	reach i64
	type_ i64
	lifted i64
	index i64
	muts []i64
	mutres i64
	recvmut i64
	regsum i64
	initwalk i64
	tparams []str
	tcons []i64
	toks []i64
	tokat i64
	tbind []i64
	insts []i64
	genof i64
	bang i64
	parent i64
	captures []Sym
	outer_syms []i64
	env_sym i64
	done i64
	escapes i64
	instcycle i64
	attrs []i64
}

type FailStmt struct {
	w0 i64
	w1 i64
	x i64
}

type FloatLit struct {
	w0 i64
	w1 i64
	bits i64
	text str
}

type FuncRef struct {
	w0 i64
	w1 i64
	fn_ i64
	raw i64
}

type GoStmt struct {
	w0 i64
	w1 i64
	call i64
}

type IdentExpr struct {
	w0 i64
	w1 i64
	name str
	ref i64
}

type IfStmt struct {
	w0 i64
	w1 i64
	cond i64
	then i64
	else_ i64
	init i64
}

type IntLit struct {
	w0 i64
	w1 i64
	val i64
	w3 i64 // words a folded expression leaves behind: cleared when it becomes a literal
	w4 i64
	w5 i64
	w6 i64
	char_ i64 // written as a character literal
	big i64 // above 2^63-1: its bits look negative
}

type InterpExpr struct {
	w0 i64
	w1 i64
	parts []i64
	args []i64
	specs []?str
}

type IndexExpr struct {
	w0 i64
	w1 i64
	x i64
	i i64
	args i64
	w5 i64
	w6 i64
	hdr i64
}

type LetStmt struct {
	w0 i64
	w1 i64
	name str
	init i64
	sym i64
	type_ i64
	mut_ i64
}

type ListStmt struct {
	w0 i64
	w1 i64
	stmts []i64
}

type FuncLit struct {
	w0 i64
	w1 i64
	fn_ i64
	escape i64
	scoped str
}

type MatchExpr struct {
	w0 i64
	w1 i64
	subject i64
	arms []i64
}

type MemExpr struct {
	w0 i64
	w1 i64
	base i64
	index i64
	scale i64
	off i64
	w6 i64
	hdr i64
	len i64
}

type MatchStmtRec struct {
	w0 i64
	w1 i64
	w2 i64
	rec i64
}

type MultiStmt struct {
	w0 i64
	w1 i64
	targets []i64
	values []i64
	define i64
	mut_ i64
}

type MutArg struct {
	w0 i64
	w1 i64
	x i64
}

type Node struct {
	kind i64
	pos i64
	w2 i64
	w3 i64
	w4 i64
	w5 i64
	type_ i64
	w7 i64
	w8 i64
	region i64
}

type OnStmt struct {
	w0 i64
	w1 i64
	event i64
	body i64
	file i64
}

type RegExpr struct {
	w0 i64
	w1 i64
	num i64
}

type ReturnStmt struct {
	w0 i64
	w1 i64
	value i64
	values []i64
}

type RangeStmt struct {
	w0 i64
	w1 i64
	key i64
	val i64
	expr i64
	body i64
	define i64
	label str
}

type Sym struct {
	kind i64
	name str
	pos i64
	slot i64
	val i64
	done i64
	fn_ i64
	index i64
	reg i64
	off i64
	uses i64
	addr i64
	type_ i64
	decl i64
	expr i64
	reads i64
	defs i64 // definitions of a local, counted by the overflow-check elision (opt.tin, #362)
	mut_ i64
	region i64
	tls i64
	big i64
	uninit i64
	captured i64
	cap_idx i64
	cell i64
	cell_sym i64
	words i64
	capbits i64
	cell_of i64
	kept_cap i64
	scope_at i64
	alias i64    // the slice variable this one was copied from (x = y), or 0 (#352)
	alias2 i64   // a slice variable copied from this one
	stale i64    // where append grew the slice this one shares, since this one was last read
	stale_by i64 // the variable append grew
	unbox i64 // a narrowed ?number: the variable holds the box, reads load its field (#353)
}

type ScopeStmt struct {
	w0 i64
	w1 i64
	name str
	body i64
}

type SelectExpr struct {
	w0 i64
	w1 i64
	x i64
	name str
}

type SelectStmt struct {
	w0 i64
	w1 i64
	arms []i64
}

type SeqExpr struct {
	w0 i64
	w1 i64
	stmts []i64
	value i64
}

type SliceExpr struct {
	w0 i64
	w1 i64
	x i64
	lo i64
	hi i64
}

type StrLit struct {
	w0 i64
	w1 i64
	ptr str
	len i64
}

type SwitchStmt struct {
	w0 i64
	w1 i64
	tag i64
	cases []i64
	w4 i64
	init i64
}

type Token struct {
	kind i64
	text str
	val i64
	pos i64
	raw i64
	dbl i64
	unit str
	start i64
	end i64
	synth i64
}

type TryExpr struct {
	w0 i64
	w1 i64
	x i64
	soft i64
}

type TypeExpr struct {
	w0 i64
	w1 i64
	a i64
	b i64
	args i64
}

type Ty struct {
	kind i64
	elem i64
	key i64
	fields []i64
	results []i64
	name str
	variadic i64
	width i64
	signed i64
	size i64
	targs []i64
	gdecl i64
	enum_ []EnumVariant
	secret_ i64
	bound i64
	max i64
}

type Unary struct {
	w0 i64
	w1 i64
	op str
	x i64
	w4 i64
	ovf i64 // OVF_CHECK on a checked integer negation (#362).
}

type UnitExpr struct {
	w0 i64
	w1 i64
	value i64
	name str
	text str
	float i64
}

type UseStmt struct {
	w0 i64
	w1 i64
	name str
	init i64
	file i64
	w5 i64
	w6 i64
	decl i64
	stop i64
}

type WhileStmt struct {
	w0 i64
	w1 i64
	cond i64
	body i64
	post i64
	init i64
	w6 i64
	once_ i64
	label str
}

type WrapExpr struct {
	w0 i64
	w1 i64
	x i64
	message i64
}

shape Any {}


type ConstStmt struct {
	w0 i64
	w1 i64
	decls []i64
}

type CkState struct {
	file i64
	fn_ Fn
	tbind []i64
}

type MatchArm struct {
	pos i64
	patterns []i64
	guard_ i64
	body i64
	block i64
}

type SelectArm struct {
	pos i64
	name str
	wait i64
	body i64
	block i64
}

type Pattern struct {
	kind i64
	pos i64
	a i64
	b i64
	name i64
	children []i64
}

type MatchRec struct {
	sym i64
	mode i64
	hint i64
}

// SliceHdr is the header of every slice: the compiler resizes and re-points slices it builds by hand.
type SliceHdr struct {
	len i64
	cap i64
	data i64
}

// TypeName is a TypeExpr of kind TX_NAME: the package (empty when unqualified), the name and the type arguments.
type TypeName struct {
	w0 i64
	w1 i64
	pkg str
	name str
	args i64
}

// EnumVariant is one variant of an enum type: its name, the index of its first payload field in the type's fields, and how many fields it has.
type EnumVariant struct {
	name str
	first i64
	count i64
}

// LifeReg is a lifecycle handler or package-level use close: its kind, the function and the label.
type LifeReg struct {
	kind i64
	fn_ Fn
	label str
}

// EnumPat is the shape of an enum case pattern: the variant's name and the names it binds.
type EnumPat struct {
	name str
	names []str
}

// AuditEntry is one place a secret leaves the checker's protection.
type AuditEntry struct {
	pos i64
	text str
	query i64 // sent in a query
}

// Import is one import of a file: the name the package goes by in it and its path.
type Import struct {
	alias str
	path str
}

// NameBind is a name and the value bound to it: a type parameter and its type, a qualified name and its
// declaration. The value is a word of whatever the table holds (a type, a declaration).
type NameBind struct {
	name str
	val i64
}

// ShapeMethod is one method of a flattened shape: its name, its signature (shape_sig_of), the method,
// the bindings it was collected under and the shape that declares it.
type ShapeMethod struct {
	name str
	sig i64
	fn_ i64
	bind_ i64
	sd i64
}

// ParsedField is a struct or enum field as the parser reads it: its name, its type expression, the
// attribute text of a legacy @json("name") ("" when there is none) and the edition 1 attribute list.
type ParsedField struct {
	name str
	ty i64
	attr str
	attrs i64
}

// Field is a struct or enum field of a resolved type: its name, type and byte offset (layout_struct), the
// length and element words of an array field, and the JSON name of an @json attribute ("" when none).
type Field struct {
	name str
	ty i64
	off i64
	arr i64
	inner i64
	json str
}

// Attr is one edition 1 attribute (@name(args)): where it starts, its name and the list of its argument expressions.
type Attr struct {
	pos i64
	name str
	args i64
}

// Hoisted is a local constant tin fix moved to package level: its name and its value text.
type Hoisted struct {
	name str
	text str
}
