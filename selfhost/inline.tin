// Inline fast paths for the runtime's append calls, run per function before LICM.
//
// s = append(s, v) checks capacity and stores in place; only a full slice calls the
// runtime. The region pass has already seen the original calls, so rewriting them here
// changes no safety checks.
shared mut ia_fn i64

fn inline_appends(f Fn) {
	ia_fn = cast(i64, f)
	ia_stmts(cast(Block, f.body).stmts)
}

fn ia_local(t i64) i64 {
	let s = sym_new(SYM_LOCAL, cstr("$"), 0)
	s.type_ = t
	s.slot = cast(Fn, ia_fn).slots
	cast(Fn, ia_fn).slots = cast(Fn, ia_fn).slots + 1
	vec_push(cast(Fn, ia_fn).locals, cast(Sym, s))
	return cast(i64, s)
}

fn ia_stmts(v Vec[i64]) {
	mut i = 0
	for i < v.len {
		ia_stmt(vec_get(v, i))
		i = i + 1
	}
}

fn ia_stmt(s i64) {
	let k = cast(Node, s).kind
	if k == ST_BLOCK {
		ia_stmts(cast(Block, s).stmts)
	} else if k == ST_LET {
		if cast(LetStmt, s).init != 0 {
			ia_expr(cast(LetStmt, s).init)
		}
	} else if k == ST_ASSIGN {
		if cast(Node, cast(AssignStmt, s).target).kind != EX_IDENT {
			ia_expr(cast(AssignStmt, s).target)
		}
		ia_expr(cast(AssignStmt, s).value)
	} else if k == ST_EXPR {
		ia_expr(cast(ExprStmt, s).x)
	} else if k == ST_IF {
		ia_expr(cast(IfStmt, s).cond)
		ia_stmts(cast(Block, cast(IfStmt, s).then).stmts)
		if cast(IfStmt, s).else_ != 0 {
			ia_stmt(cast(IfStmt, s).else_)
		}
	} else if k == ST_WHILE {
		ia_expr(cast(WhileStmt, s).cond)
		ia_stmts(cast(Block, cast(WhileStmt, s).body).stmts)
		if cast(WhileStmt, s).post != 0 {
			ia_stmt(cast(WhileStmt, s).post)
		}
	} else if k == ST_RETURN {
		if cast(ReturnStmt, s).value != 0 {
			ia_expr(cast(ReturnStmt, s).value)
		}
		if cast(i64, cast(ReturnStmt, s).values) != 0 {
			ia_exprs(cast(ReturnStmt, s).values)
		}
	} else if k == ST_CALLMULTI {
		ia_expr(cast(CallMultiStmt, s).call)
	}
}

fn ia_exprs(v Vec[i64]) {
	mut i = 0
	for i < v.len {
		ia_expr(vec_get(v, i))
		i = i + 1
	}
}

fn ia_expr(e i64) {
	if e == 0 {
		return
	}
	let k = cast(Node, e).kind
	if k == EX_UNARY {
		ia_expr(cast(Unary, e).x)
	} else if k == EX_BINARY {
		ia_expr(cast(Binary, e).l)
		ia_expr(cast(Binary, e).r)
	} else if k == EX_CONV {
		ia_expr(cast(Conv, e).x)
	} else if k == EX_MEM {
		ia_expr(cast(MemExpr, e).base)
		ia_expr(cast(MemExpr, e).index)
		ia_expr(cast(MemExpr, e).len)
	} else if k == EX_ELEM {
		ia_expr(cast(ElemExpr, e).seq)
		ia_expr(cast(ElemExpr, e).idx)
	} else if k == EX_SEQ {
		ia_stmts(cast(SeqExpr, e).stmts)
		ia_expr(cast(SeqExpr, e).value)
	} else if k == EX_INDEX {
		ia_expr(cast(IndexExpr, e).x)
		ia_expr(cast(IndexExpr, e).i)
	} else if k == EX_CALL {
		ia_expr(cast(Call, e).callee)
		ia_exprs(cast(Call, e).args)
		let name = cast(Call, e).name
		if cast(Call, e).intrinsic == 0 && name != 0 && cast(Fn, ia_fn).generated == 0 {
			if (streq(name, cstr("rt_append")) != 0 || streq(name, cstr("rt_append_rc")) != 0) && cast(Call, e).args.len == 3 && cast(Node, vec_get(cast(Call, e).args, 2)).kind == EX_INT {
				ia_append(e)
			} else if streq(name, cstr("rt_append_str")) != 0 && cast(Call, e).args.len == 2 {
				ia_append_str(e)
			}
		}
	}
}

fn ia_ref(s i64) i64 {
	return sym_ref_node(0, cast(Sym, s))
}

fn ia_hdr(h i64, word i64) i64 {
	return mk_mem(0, ia_ref(h), 0, 0, 8 * word, ty_int)
}

fn elem_type_of_size(esz i64) i64 {
	if esz == 1 {
		return ty_byte
	}
	if esz == 2 {
		return ty_u16
	}
	if esz == 4 {
		return ty_u32
	}
	return ty_int
}

// ia_append: h := s; v := x; n := h.len; if n >= h.cap { h = rt_append(h, v, esz) }
// else { h.data[n] = v; h.len = n + 1 }; value h.
fn ia_append(e i64) {
	let pos = cast(Node, e).pos
	let args = cast(Call, e).args
	let st = cast(Node, e).type_
	let esz = cast(IntLit, vec_get(args, 2)).val
	mut vt = cast(Node, vec_get(args, 1)).type_
	if vt == 0 || is_float_t(vt) != 0 {
		vt = ty_int
	}
	let h = ia_local(st)
	let v = ia_local(vt)
	let n = ia_local(ty_int)
	let stmts = vec_new[i64]()
	vec_push(stmts, let_stmt(pos, cast(Sym, h), vec_get(args, 0)))
	vec_push(stmts, let_stmt(pos, cast(Sym, v), vec_get(args, 1)))
	vec_push(stmts, let_stmt(pos, cast(Sym, n), ia_hdr(h, 0)))
	let slow = node_new(EX_CALL, pos)
	cast(Call, slow).name = cast(Call, e).name
	cast(Call, slow).fn_ = cast(Call, e).fn_
	cast(Call, slow).args = cast(Vec[i64], args3(ia_ref(h), ia_ref(v), mk_int(pos, esz, ty_int)))
	cast(Node, slow).type_ = st
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = mk_bin(pos, cstr(">="), ia_ref(n), ia_hdr(h, 1), ty_bool)
	ifs.then = empty_block(pos)
	vec_push(cast(Block, ifs.then).stmts, assign_stmt(pos, ia_ref(h), slow))
	let els = cast(Block, empty_block(pos))
	let slot = mk_mem(pos, ia_hdr(h, 2), ia_ref(n), esz, 0, elem_type_of_size(esz))
	vec_push(cast(Vec[i64], els.stmts), assign_stmt(pos, slot, ia_ref(v)))
	vec_push(cast(Vec[i64], els.stmts), assign_stmt(pos, ia_hdr(h, 0), mk_bin(pos, cstr("+"), ia_ref(n), mk_int(pos, 1, ty_int), ty_int)))
	if streq(cast(Call, e).name, cstr("rt_append_rc")) != 0 {
		// A counted element in a long-lived slice gains its slot's count (#176).
		let lived = cast(IfStmt, node_new(ST_IF, pos))
		lived.cond = mk_bin(pos, cstr("!="), ia_hdr(h, 3), mk_int(pos, 0, ty_int), ty_bool)
		lived.then = empty_block(pos)
		vec_push(cast(Block, lived.then).stmts, expr_stmt(cast(Node, rt_call(pos, cstr("rt_rc_inc"), args1(ia_ref(v)), ty_void))))
		vec_push(cast(Vec[i64], els.stmts), cast(i64, lived))
	}
	ifs.else_ = cast(i64, els)
	vec_push(stmts, cast(i64, ifs))
	replace_node(e, mk_seq(pos, cast(i64, stmts), ia_ref(h), st))
}

fn ia_copy_str_chunk(pos i64, stmts Vec[i64], dst i64, src i64, off i64, lg i64) {
	let word = ia_local(ty_int)
	mut dst_at = dst
	mut src_at = src
	if off != 0 {
		dst_at = mk_bin(pos, cstr("+"), dst, mk_int(pos, off, ty_int), ty_int)
		src_at = mk_bin(pos, cstr("+"), src, mk_int(pos, off, ty_int), ty_int)
	}
	vec_push(stmts, let_stmt(pos, cast(Sym, word), intrinsic_call(pos, cstr("__ld"), args2(src_at, mk_int(pos, lg, ty_int)), ty_int)))
	vec_push(stmts, expr_stmt(cast(Node, intrinsic_call(pos, cstr("__st"), args3(dst_at, ia_ref(word), mk_int(pos, lg, ty_int)), ty_void))))
}

// ia_append_str: copy a one-byte string directly, and use memcpy for the rest.
// Only a full slice takes the runtime growth path.
fn ia_append_str(e i64) {
	let pos = cast(Node, e).pos
	let args = cast(Call, e).args
	mut st = cast(Node, e).type_
	if st == 0 || kind_of(cast(Ty, st)) != K_SLICE {
		st = slice_of(ty_byte)
	}
	let lit = vec_get(args, 1)
	if cast(Node, lit).kind == EX_STR && cast(StrLit, lit).len > 0 && cast(StrLit, lit).len <= 32 {
		ia_append_lit(e, cast(StrLit, lit))
		return
	}
	let memcpy_fn = find_fn(cstr("memcpy"))
	if cast(i64, memcpy_fn) == 0 {
		return
	}
	memcpy_fn.used = 1
	let h = ia_local(st)
	let t = ia_local(ty_string)
	let n = ia_local(ty_int)
	let m = ia_local(ty_int)
	let dst = ia_local(ty_int)
	let src = ia_local(ty_int)
	let word = ia_local(ty_int)
	let stmts = vec_new[i64]()
	vec_push(stmts, let_stmt(pos, cast(Sym, h), vec_get(args, 0)))
	vec_push(stmts, let_stmt(pos, cast(Sym, t), vec_get(args, 1)))
	vec_push(stmts, let_stmt(pos, cast(Sym, n), ia_hdr(h, 0)))
	vec_push(stmts, let_stmt(pos, cast(Sym, m), mk_mem(pos, ia_ref(t), 0, 0, 0, ty_int)))
	let slow = node_new(EX_CALL, pos)
	cast(Call, slow).name = cast(Call, e).name
	cast(Call, slow).fn_ = cast(Call, e).fn_
	cast(Call, slow).args = cast(Vec[i64], args2(ia_ref(h), ia_ref(t)))
	cast(Node, slow).type_ = st
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = mk_bin(pos, cstr(">"), mk_bin(pos, cstr("+"), ia_ref(n), ia_ref(m), ty_int), ia_hdr(h, 1), ty_bool)
	ifs.then = empty_block(pos)
	vec_push(cast(Block, ifs.then).stmts, assign_stmt(pos, ia_ref(h), slow))
	let els = cast(Block, empty_block(pos))

	let fallback = cast(Block, empty_block(pos))
	let cp = node_new(EX_CALL, pos)
	cast(Call, cp).name = cstr("memcpy")
	cast(Call, cp).fn_ = cast(i64, memcpy_fn)
	cast(Call, cp).args = cast(Vec[i64], args3(mk_bin(pos, cstr("+"), ia_hdr(h, 2), ia_ref(n), ty_int), mk_bin(pos, cstr("+"), mk_conv(pos, ia_ref(t), CV_SAME, ty_int), mk_int(pos, 8, ty_int), ty_int), ia_ref(m)))
	cast(Node, cp).type_ = ty_int
	vec_push(cast(Vec[i64], fallback.stmts), expr_stmt(cast(Node, cp)))
	// These lengths are common in builders. Avoid a libc call while keeping the
	// general copy path unchanged and limiting every raw access to its exact width.
	let short = cast(IfStmt, node_new(ST_IF, pos))
	short.cond = mk_bin(pos, cstr("=="), ia_ref(m), mk_int(pos, 1, ty_int), ty_bool)
	short.then = empty_block(pos)
	let sb = cast(Block, short.then).stmts
	vec_push(sb, let_stmt(pos, cast(Sym, dst), mk_bin(pos, cstr("+"), ia_hdr(h, 2), ia_ref(n), ty_int)))
	vec_push(sb, let_stmt(pos, cast(Sym, src), mk_bin(pos, cstr("+"), mk_conv(pos, ia_ref(t), CV_SAME, ty_int), mk_int(pos, 8, ty_int), ty_int)))
	vec_push(sb, let_stmt(pos, cast(Sym, word), intrinsic_call(pos, cstr("__ld"), args2(ia_ref(src), mk_int(pos, 0, ty_int)), ty_int)))
	vec_push(sb, expr_stmt(cast(Node, intrinsic_call(pos, cstr("__st"), args3(ia_ref(dst), ia_ref(word), mk_int(pos, 0, ty_int)), ty_void))))
	let two = cast(IfStmt, node_new(ST_IF, pos))
	two.cond = mk_bin(pos, cstr("=="), ia_ref(m), mk_int(pos, 2, ty_int), ty_bool)
	two.then = empty_block(pos)
	let two_dst = mk_bin(pos, cstr("+"), ia_hdr(h, 2), ia_ref(n), ty_int)
	let two_src = mk_bin(pos, cstr("+"), mk_conv(pos, ia_ref(t), CV_SAME, ty_int), mk_int(pos, 8, ty_int), ty_int)
	ia_copy_str_chunk(pos, cast(Block, two.then).stmts, two_dst, two_src, 0, 1)
	let six = cast(IfStmt, node_new(ST_IF, pos))
	six.cond = mk_bin(pos, cstr("=="), ia_ref(m), mk_int(pos, 6, ty_int), ty_bool)
	six.then = empty_block(pos)
	let six_dst = mk_bin(pos, cstr("+"), ia_hdr(h, 2), ia_ref(n), ty_int)
	let six_src = mk_bin(pos, cstr("+"), mk_conv(pos, ia_ref(t), CV_SAME, ty_int), mk_int(pos, 8, ty_int), ty_int)
	ia_copy_str_chunk(pos, cast(Block, six.then).stmts, six_dst, six_src, 0, 2)
	let tail_dst = mk_bin(pos, cstr("+"), ia_hdr(h, 2), ia_ref(n), ty_int)
	let tail_src = mk_bin(pos, cstr("+"), mk_conv(pos, ia_ref(t), CV_SAME, ty_int), mk_int(pos, 8, ty_int), ty_int)
	ia_copy_str_chunk(pos, cast(Block, six.then).stmts, tail_dst, tail_src, 4, 1)
	six.else_ = cast(i64, fallback)
	two.else_ = empty_block(pos)
	vec_push(cast(Block, two.else_).stmts, cast(i64, six))
	short.else_ = empty_block(pos)
	vec_push(cast(Block, short.else_).stmts, cast(i64, two))
	vec_push(cast(Vec[i64], els.stmts), cast(i64, short))
	vec_push(cast(Vec[i64], els.stmts), assign_stmt(pos, ia_hdr(h, 0), mk_bin(pos, cstr("+"), ia_ref(n), ia_ref(m), ty_int)))
	ifs.else_ = cast(i64, els)
	vec_push(stmts, cast(i64, ifs))
	replace_node(e, mk_seq(pos, cast(i64, stmts), ia_ref(h), st))
}

// ---- small function inlining ----
//
// A function whose body is a single `return expr` over its parameters is expanded at
// its call sites before any code is generated. Arguments that are constants or locals are
// substituted, and so are pure ones used once when the whole call is pure; others are
// evaluated once into temps, in order.
shared mut il_fn i64
shared mut il_depth i64
shared mut il_subst Vec[i64] // per callee param: the expression to use, or 0
shared mut il_callee i64

fn inline_small_calls() {
	mut i = 0
	for i < prog_fns.len {
		let f = vec_get(prog_fns, i)
		if f.extern_ == 0 && f.reach != 0 && f.generated == 0 && f.body != 0 {
			il_fn = cast(i64, f)
			il_depth = 0
			il_stmts(cast(Block, f.body).stmts)
		}
		i = i + 1
	}
}

fn il_stmts(v Vec[i64]) {
	mut i = 0
	for i < v.len {
		il_stmt(vec_get(v, i))
		i = i + 1
	}
}

fn il_stmt(s i64) {
	let k = cast(Node, s).kind
	if k == ST_BLOCK {
		il_stmts(cast(Block, s).stmts)
	} else if k == ST_LET {
		if cast(LetStmt, s).init != 0 {
			il_expr(cast(LetStmt, s).init)
		}
	} else if k == ST_ASSIGN {
		if cast(Node, cast(AssignStmt, s).target).kind != EX_IDENT {
			il_expr(cast(AssignStmt, s).target)
		}
		il_expr(cast(AssignStmt, s).value)
	} else if k == ST_EXPR {
		il_expr(cast(ExprStmt, s).x)
	} else if k == ST_IF {
		il_expr(cast(IfStmt, s).cond)
		il_stmts(cast(Block, cast(IfStmt, s).then).stmts)
		if cast(IfStmt, s).else_ != 0 {
			il_stmt(cast(IfStmt, s).else_)
		}
	} else if k == ST_WHILE {
		il_expr(cast(WhileStmt, s).cond)
		il_stmts(cast(Block, cast(WhileStmt, s).body).stmts)
		if cast(WhileStmt, s).post != 0 {
			il_stmt(cast(WhileStmt, s).post)
		}
	} else if k == ST_RETURN {
		if cast(ReturnStmt, s).value != 0 {
			il_expr(cast(ReturnStmt, s).value)
		}
		if cast(i64, cast(ReturnStmt, s).values) != 0 {
			mut i = 0
			for i < cast(ReturnStmt, s).values.len {
				il_expr(vec_get(cast(ReturnStmt, s).values, i))
				i = i + 1
			}
		}
	} else if k == ST_CALLMULTI {
		il_expr(cast(CallMultiStmt, s).call)
	}
}

fn il_expr(e i64) {
	if e == 0 {
		return
	}
	let k = cast(Node, e).kind
	if k == EX_UNARY {
		il_expr(cast(Unary, e).x)
	} else if k == EX_BINARY {
		il_expr(cast(Binary, e).l)
		il_expr(cast(Binary, e).r)
	} else if k == EX_CONV {
		il_expr(cast(Conv, e).x)
	} else if k == EX_MEM {
		il_expr(cast(MemExpr, e).base)
		il_expr(cast(MemExpr, e).index)
		il_expr(cast(MemExpr, e).len)
	} else if k == EX_ELEM {
		il_expr(cast(ElemExpr, e).seq)
		il_expr(cast(ElemExpr, e).idx)
	} else if k == EX_SEQ {
		il_stmts(cast(SeqExpr, e).stmts)
		il_expr(cast(SeqExpr, e).value)
	} else if k == EX_INDEX {
		il_expr(cast(IndexExpr, e).x)
		il_expr(cast(IndexExpr, e).i)
	} else if k == EX_CALL {
		il_expr(cast(Call, e).callee)
		let args = cast(Call, e).args
		mut i = 0
		for i < args.len {
			il_expr(vec_get(args, i))
			i = i + 1
		}
		let f = cast(Fn, cast(Call, e).fn_)
		if cast(Call, e).intrinsic == 0 && cast(Call, e).callee == 0 && cast(i64, f) != 0 {
			if f.extern_ != 0 {
				il_float_intrinsic(e, f)
			} else if il_depth < 4 && cast(i64, f) != il_fn && il_inlinable(f) != 0 {
				il_expand(e, f)
			}
		}
	}
	il_fold_reflexive_cmp(e)
	il_fold_boolean(e)
}

// For a non-float value x is always equal to itself. After generic inlining this removes
// the NaN checks from ordered comparisons specialized for integers and strings.
fn il_fold_reflexive_cmp(e i64) {
	if e == 0 || cast(Node, e).kind != EX_BINARY || (streq(cast(Binary, e).op, cstr("==")) == 0 && streq(cast(Binary, e).op, cstr("!=")) == 0) {
		return
	}
	let l = cast(Binary, e).l
	let r = cast(Binary, e).r
	if cast(Node, l).kind != EX_IDENT || cast(Node, r).kind != EX_IDENT || cast(IdentExpr, l).ref == 0 || cast(IdentExpr, l).ref != cast(IdentExpr, r).ref || cast(Sym, cast(IdentExpr, l).ref).kind != SYM_LOCAL || is_float_t(cast(Node, l).type_) != 0 {
		return
	}
	let value = streq(cast(Binary, e).op, cstr("=="))
	replace_node(e, mk_int(cast(Node, e).pos, value, ty_bool))
}

// Remove constant identities introduced by ordered comparisons, such as
// `x < y || (x != x && y == y)` specializing to an integer type.
fn il_fold_boolean(e i64) {
	if e == 0 || cast(Node, e).kind != EX_BINARY {
		return
	}
	let op = cast(Binary, e).op
	let l = cast(Binary, e).l
	let r = cast(Binary, e).r
	if streq(op, cstr("&&")) != 0 {
		if is_const(l) != 0 {
			if const_val(l) == 0 {
				replace_node(e, mk_int(cast(Node, e).pos, 0, ty_bool))
			} else {
				replace_node(e, r)
			}
		} else if is_const(r) != 0 && const_val(r) != 0 {
			replace_node(e, l)
		}
	} else if streq(op, cstr("||")) != 0 {
		if is_const(l) != 0 {
			if const_val(l) != 0 {
				replace_node(e, mk_int(cast(Node, e).pos, 1, ty_bool))
			} else {
				replace_node(e, r)
			}
		} else if is_const(r) != 0 && const_val(r) == 0 {
			replace_node(e, l)
		}
	}
}

// il_float_intrinsic turns libm calls the hardware does in one instruction into intrinsics.
fn il_float_intrinsic(e i64, f Fn) {
	if cast(Call, e).args.len != 1 || is_float_t(cast(Node, e).type_) == 0 {
		return
	}
	let name = f.name
	mut op = 0
	if streq(name, cstr("sqrt")) != 0 {
		op = cstr("__fsqrt")
	} else if streq(name, cstr("fabs")) != 0 {
		op = cstr("__fabs")
	} else if streq(name, cstr("floor")) != 0 {
		op = cstr("__frintm")
	} else if streq(name, cstr("ceil")) != 0 {
		op = cstr("__frintp")
	} else if streq(name, cstr("trunc")) != 0 {
		op = cstr("__frintz")
	} else if streq(name, cstr("round")) != 0 {
		op = cstr("__frinta")
	} else if streq(name, cstr("rint")) != 0 || streq(name, cstr("nearbyint")) != 0 {
		op = cstr("__frintn")
	}
	if op != 0 {
		cast(Call, e).name = op
		cast(Call, e).intrinsic = 1
		cast(Call, e).fn_ = 0
	}
}

fn il_inlinable(f Fn) i64 {
	if fn_polls(f) != 0 && fn_polls(cast(Fn, il_fn)) == 0 {
		return 0
	}
	if f.extern_ != 0 || f.body == 0 || f.generated != 0 || f.variadic != 0 || cast(Vec[i64], f.rtypes).len != 1 || f.env_sym != 0 {
		return 0
	}
	let stmts = cast(Block, f.body).stmts
	if stmts.len != 1 {
		return 0
	}
	let r = vec_get(stmts, 0)
	if cast(Node, r).kind != ST_RETURN || cast(ReturnStmt, r).value == 0 || cast(i64, cast(ReturnStmt, r).values) != 0 {
		return 0
	}
	if il_substituted(f) != 0 {
		return 0
	}
	il_callee = cast(i64, f)
	return i64(il_size(cast(ReturnStmt, r).value) <= 40)
}

// il_substituted reports a function whose body the back end replaces by hand-written code (linux_raw,
// the vector and syscall leaves, the AES and SHA-256 leaves, the task switch): its source body is only
// a placeholder, so inlining it would run the placeholder.
fn il_substituted(f Fn) i64 {
	let n = f.qname
	if streq(n, cstr("linux_raw")) != 0 || streq(n, cstr("linux_restorer")) != 0 || streq(n, cstr("mem_avx2_supported")) != 0 || streq(n, cstr("mem_copy64")) != 0 || streq(n, cstr("mem_fill64")) != 0 || streq(n, cstr("rt_task_swap")) != 0 || streq(n, cstr("seal.hw_blocks")) != 0 {
		return 1
	}
	if streq(n, cstr("memcpy")) != 0 || streq(n, cstr("memmove")) != 0 || streq(n, cstr("memset")) != 0 || streq(n, cstr("memcmp")) != 0 || streq(n, cstr("memchr")) != 0 {
		return 1
	}
	return i64(syscall_fast_arm64(n) != 0 || syscall_fast_amd64(n) != 0 || aes_hw_arm64(n) != 0 || aes_hw_amd64(n) != 0)
}

// il_size counts nodes, or returns a huge number for anything that cannot be copied.
fn il_size(e i64) i64 {
	if e == 0 {
		return 0
	}
	let k = cast(Node, e).kind
	if k == EX_INT || k == EX_FLOAT || k == EX_STR || k == EX_FUNCREF {
		return 1
	}
	if k == EX_IDENT {
		let s = cast(Sym, cast(IdentExpr, e).ref)
		if cast(i64, s) == 0 {
			return 1000
		}
		if s.kind == SYM_LOCAL && il_param_index(cast(i64, s)) < 0 {
			return 1000
		}
		return 1
	}
	if k == EX_UNARY {
		if streq(cast(Unary, e).op, cstr("&")) != 0 {
			return 1000
		}
		return 1 + il_size(cast(Unary, e).x)
	}
	if k == EX_BINARY {
		return 1 + il_size(cast(Binary, e).l) + il_size(cast(Binary, e).r)
	}
	if k == EX_CONV {
		return 1 + il_size(cast(Conv, e).x)
	}
	if k == EX_MEM {
		return 1 + il_size(cast(MemExpr, e).base) + il_size(cast(MemExpr, e).index) + il_size(cast(MemExpr, e).len)
	}
	if k == EX_ELEM {
		return 1 + il_size(cast(ElemExpr, e).seq) + il_size(cast(ElemExpr, e).idx)
	}
	if k == EX_CALL {
		if cast(Call, e).callee != 0 || cast(Call, e).fn_ == il_callee {
			return 1000
		}
		mut n = 3
		mut i = 0
		for i < cast(Call, e).args.len {
			n = n + il_size(vec_get(cast(Call, e).args, i))
			i = i + 1
		}
		return n
	}
	return 1000
}

fn il_param_index(s i64) i64 {
	let locals = cast(Fn, il_callee).locals
	let np = cast(Fn, il_callee).params.len
	mut i = 0
	for i < np {
		if cast(i64, vec_get(locals, i)) == s {
			return i
		}
		i = i + 1
	}
	return -1
}

fn il_uses(e i64, s i64) i64 {
	if e == 0 {
		return 0
	}
	let k = cast(Node, e).kind
	if k == EX_IDENT {
		return i64(cast(IdentExpr, e).ref == s)
	}
	if k == EX_UNARY {
		return il_uses(cast(Unary, e).x, s)
	}
	if k == EX_BINARY {
		return il_uses(cast(Binary, e).l, s) + il_uses(cast(Binary, e).r, s)
	}
	if k == EX_CONV {
		return il_uses(cast(Conv, e).x, s)
	}
	if k == EX_MEM {
		return il_uses(cast(MemExpr, e).base, s) + il_uses(cast(MemExpr, e).index, s) + il_uses(cast(MemExpr, e).len, s)
	}
	if k == EX_ELEM {
		return il_uses(cast(ElemExpr, e).seq, s) + il_uses(cast(ElemExpr, e).idx, s)
	}
	if k == EX_CALL {
		mut n = 0
		mut i = 0
		for i < cast(Call, e).args.len {
			n = n + il_uses(vec_get(cast(Call, e).args, i), s)
			i = i + 1
		}
		return n
	}
	return 0
}

fn il_pure(e i64) i64 {
	if e == 0 {
		return 1
	}
	let k = cast(Node, e).kind
	if k == EX_INT || k == EX_FLOAT || k == EX_STR || k == EX_FUNCREF {
		return 1
	}
	if k == EX_IDENT {
		return i64(cast(IdentExpr, e).ref != 0 && cast(Sym, cast(IdentExpr, e).ref).kind != SYM_GLOBAL)
	}
	if k == EX_UNARY {
		return i64(streq(cast(Unary, e).op, cstr("&")) == 0 && il_pure(cast(Unary, e).x) != 0)
	}
	if k == EX_BINARY {
		return i64(may_panic(cast(Binary, e)) == 0 && il_pure(cast(Binary, e).l) != 0 && il_pure(cast(Binary, e).r) != 0)
	}
	if k == EX_CONV {
		return il_pure(cast(Conv, e).x)
	}
	if k == EX_MEM {
		return i64(il_pure(cast(MemExpr, e).base) != 0 && il_pure(cast(MemExpr, e).index) != 0 && il_pure(cast(MemExpr, e).len) != 0)
	}
	return 0
}

fn il_expand(e i64, f Fn) {
	let pos = cast(Node, e).pos
	let args = cast(Call, e).args
	let body = cast(ReturnStmt, vec_get(cast(Block, f.body).stmts, 0)).value
	let np = cast(Vec[i64], f.params).len
	if args.len != np {
		return
	}
	// A substituted argument runs at its use: after the temps and inside the body. A call
	// in either may write what it reads or run before it traps, so unless the body and
	// all arguments are pure, only constants and locals are substituted.
	mut pure = il_pure(body)
	mut i = 0
	for i < np {
		pure = i64(pure != 0 && il_pure(vec_get(args, i)) != 0)
		i = i + 1
	}
	let stmts = vec_new[i64]()
	let subst = vec_filled(np, 0)
	i = 0
	for i < np {
		let a = vec_get(args, i)
		let p = cast(Sym, vec_get(cast(Vec[i64], f.locals), i))
		let ak = cast(Node, a).kind
		let simple = i64(ak == EX_INT || ak == EX_FLOAT || ak == EX_STR || (ak == EX_IDENT && cast(IdentExpr, a).ref != 0 && cast(Sym, cast(IdentExpr, a).ref).kind == SYM_LOCAL && cast(Sym, cast(IdentExpr, a).ref).addr == 0))
		if simple != 0 || (pure != 0 && il_uses(body, cast(i64, p)) == 1) {
			cast(Vec[i64], subst).data[i] = a
		} else {
			let t = ia_local_in(cast(Fn, il_fn), p.type_)
			vec_push(stmts, let_stmt(pos, cast(Sym, t), a))
			cast(Vec[i64], subst).data[i] = sym_ref_node(pos, cast(Sym, t))
		}
		i = i + 1
	}
	let saved = il_subst
	let saved_callee = il_callee
	il_subst = cast(Vec[i64], subst)
	il_callee = cast(i64, f)
	let copy_ = il_clone(body)
	il_subst = saved
	il_callee = saved_callee
	let t = cast(Node, e).type_
	if cast(Vec[i64], stmts).len > 0 {
		replace_node(e, mk_seq(pos, cast(i64, stmts), copy_, t))
	} else {
		replace_node(e, copy_)
		cast(Node, e).type_ = t
	}
	il_depth = il_depth + 1
	il_expr(e)
	il_depth = il_depth - 1
}

fn ia_local_in(f Fn, t i64) i64 {
	let s = sym_new(SYM_LOCAL, cstr("$"), 0)
	s.type_ = t
	s.slot = f.slots
	f.slots = f.slots + 1
	vec_push(cast(Vec[i64], f.locals), cast(i64, s))
	return cast(i64, s)
}

fn il_clone(e i64) i64 {
	if e == 0 {
		return 0
	}
	let k = cast(Node, e).kind
	if k == EX_IDENT && cast(IdentExpr, e).ref != 0 && cast(Sym, cast(IdentExpr, e).ref).kind == SYM_LOCAL {
		let pi = il_param_index(cast(IdentExpr, e).ref)
		if pi >= 0 {
			return il_dup(vec_get(il_subst, pi))
		}
	}
	let c = node_new(k, cast(Node, e).pos)
	replace_node(c, e)
	if k == EX_UNARY {
		cast(Unary, c).x = il_clone(cast(Unary, e).x)
	} else if k == EX_BINARY {
		cast(Binary, c).l = il_clone(cast(Binary, e).l)
		cast(Binary, c).r = il_clone(cast(Binary, e).r)
	} else if k == EX_CONV {
		cast(Conv, c).x = il_clone(cast(Conv, e).x)
	} else if k == EX_MEM {
		cast(MemExpr, c).base = il_clone(cast(MemExpr, e).base)
		cast(MemExpr, c).index = il_clone(cast(MemExpr, e).index)
		cast(MemExpr, c).len = il_clone(cast(MemExpr, e).len)
	} else if k == EX_ELEM {
		cast(ElemExpr, c).seq = il_clone(cast(ElemExpr, e).seq)
		cast(ElemExpr, c).idx = il_clone(cast(ElemExpr, e).idx)
	} else if k == EX_CALL {
		let args = vec_new[i64]()
		mut i = 0
		for i < cast(Call, e).args.len {
			vec_push(args, il_clone(vec_get(cast(Call, e).args, i)))
			i = i + 1
		}
		cast(Call, c).args = cast(Vec[i64], args)
	}
	return c
}

// il_dup copies an argument expression for one more use (it is pure or a single use).
fn il_dup(a i64) i64 {
	return il_clone_plain(a)
}

fn il_clone_plain(e i64) i64 {
	if e == 0 {
		return 0
	}
	let k = cast(Node, e).kind
	let c = node_new(k, cast(Node, e).pos)
	replace_node(c, e)
	if k == EX_UNARY {
		cast(Unary, c).x = il_clone_plain(cast(Unary, e).x)
	} else if k == EX_BINARY {
		cast(Binary, c).l = il_clone_plain(cast(Binary, e).l)
		cast(Binary, c).r = il_clone_plain(cast(Binary, e).r)
	} else if k == EX_CONV {
		cast(Conv, c).x = il_clone_plain(cast(Conv, e).x)
	} else if k == EX_MEM {
		cast(MemExpr, c).base = il_clone_plain(cast(MemExpr, e).base)
		cast(MemExpr, c).index = il_clone_plain(cast(MemExpr, e).index)
		cast(MemExpr, c).len = il_clone_plain(cast(MemExpr, e).len)
	} else if k == EX_ELEM {
		cast(ElemExpr, c).seq = il_clone_plain(cast(ElemExpr, e).seq)
		cast(ElemExpr, c).idx = il_clone_plain(cast(ElemExpr, e).idx)
	} else if k == EX_CALL {
		let args = vec_new[i64]()
		mut i = 0
		for i < cast(Call, e).args.len {
			vec_push(args, il_clone_plain(vec_get(cast(Call, e).args, i)))
			i = i + 1
		}
		cast(Call, c).args = cast(Vec[i64], args)
	}
	return c
}

// lit_word is the little-endian value of size bytes of literal lit at off.
fn lit_word(lit StrLit, off i64, size i64) i64 {
	mut v = 0
	mut i = size - 1
	for i >= 0 {
		v = (v << 8) | i64(load8(lit.ptr + off + i))
		i = i - 1
	}
	return v
}

// ia_append_lit appends a short string literal with constant stores: two to four
// instructions for a JSON key instead of a memcpy call.
fn ia_append_lit(e i64, lit StrLit) {
	let pos = cast(Node, e).pos
	let args = cast(Call, e).args
	mut st = cast(Node, e).type_
	if st == 0 || kind_of(cast(Ty, st)) != K_SLICE {
		st = slice_of(ty_byte)
	}
	let len_ = lit.len
	let h = ia_local(st)
	let n = ia_local(ty_int)
	let p = ia_local(ty_int)
	let stmts = vec_new[i64]()
	vec_push(stmts, let_stmt(pos, cast(Sym, h), vec_get(args, 0)))
	vec_push(stmts, let_stmt(pos, cast(Sym, n), ia_hdr(h, 0)))
	let slow = node_new(EX_CALL, pos)
	cast(Call, slow).name = cast(Call, e).name
	cast(Call, slow).fn_ = cast(Call, e).fn_
	cast(Call, slow).args = cast(Vec[i64], args2(ia_ref(h), cast(i64, lit)))
	cast(Node, slow).type_ = st
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = mk_bin(pos, cstr(">"), mk_bin(pos, cstr("+"), ia_ref(n), mk_int(pos, len_, ty_int), ty_int), ia_hdr(h, 1), ty_bool)
	ifs.then = empty_block(pos)
	vec_push(cast(Block, ifs.then).stmts, assign_stmt(pos, ia_ref(h), slow))
	let els = cast(Block, empty_block(pos))
	let eb = cast(Vec[i64], els.stmts)
	vec_push(eb, let_stmt(pos, cast(Sym, p), mk_bin(pos, cstr("+"), ia_hdr(h, 2), ia_ref(n), ty_int)))
	mut off = 0
	for off < len_ {
		mut size = 8
		mut lg = 3
		if len_ - off < 8 && len_ - off >= 4 {
			size = 4
			lg = 2
		} else if len_ - off < 4 && len_ - off >= 2 {
			size = 2
			lg = 1
		} else if len_ - off < 2 {
			size = 1
			lg = 0
		}
		let addr = mk_bin(pos, cstr("+"), ia_ref(p), mk_int(pos, off, ty_int), ty_int)
		let st3 = intrinsic_call(pos, cstr("__st"), args3(addr, mk_int(pos, lit_word(lit, off, size), ty_int), mk_int(pos, lg, ty_int)), ty_void)
		vec_push(eb, expr_stmt(cast(Node, st3)))
		off = off + size
	}
	vec_push(eb, assign_stmt(pos, ia_hdr(h, 0), mk_bin(pos, cstr("+"), ia_ref(n), mk_int(pos, len_, ty_int), ty_int)))
	ifs.else_ = cast(i64, els)
	vec_push(stmts, cast(i64, ifs))
	replace_node(e, mk_seq(pos, cast(i64, stmts), ia_ref(h), st))
}
