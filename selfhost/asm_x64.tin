// x86-64 instruction list for the x64 backend: the same five-word shape as asm.tin.
// Each instruction is five words: op, a, b, c, d. Register operands are 0-15 for rax-r15
// and XMM + n for xmm0-xmm15; every integer operation is 64 bits wide unless noted.

const X_LABEL = 1;         // a=label
const X_MOV_RR = 2;        // a=rd b=rs
const X_MOV_RI = 3;        // a=rd b=imm64 (mov r32, mov r64 sign-extended or movabs, whichever is shortest)
const X_LOAD = 4;          // a=rt b=mem c=kind: size log2 | XK_SIGNED (sizes below 8 zero- or sign-extend)
const X_STORE = 5;         // a=rt b=mem c=size log2
const X_LEA = 6;           // a=rd b=mem
const X_ADD = 7;           // a=rd b=rs
const X_SUB = 8;
const X_AND = 9;
const X_OR = 10;
const X_XOR = 11;
const X_CMP = 12;
const X_TEST = 13;
const X_ADDI = 14;         // a=rd b=imm32 (sign-extended to 64 bits)
const X_SUBI = 15;
const X_ANDI = 16;
const X_ORI = 17;
const X_XORI = 18;
const X_CMPI = 19;
const X_TESTI = 20;
const X_ADDM = 21;         // a=rd b=mem
const X_SUBM = 22;
const X_ANDM = 23;
const X_ORM = 24;
const X_XORM = 25;
const X_CMPM = 26;
const X_TESTM = 27;        // a=rs b=mem: test [mem], rs
const X_IMUL_RR = 28;      // a=rd b=rs
const X_IMUL_RRI = 29;     // a=rd b=rs c=imm32
const X_IDIV = 30;         // a=rs: rdx:rax / rs
const X_DIV = 31;
const X_CQO = 32;
const X_NEG = 33;          // a=rd
const X_NOT = 34;
const X_SHL = 35;          // a=rd: shift by cl
const X_SHR = 36;
const X_SAR = 37;
const X_SHLI = 38;         // a=rd b=imm8
const X_SHRI = 39;
const X_SARI = 40;
const X_SETCC = 41;        // a=rd b=cond: sets the low byte only
const X_CMOVCC = 42;       // a=rd b=rs c=cond
const X_JMP = 43;          // a=label; d is set to 1 by x64_layout when the rel8 form fits
const X_JCC = 44;          // a=cond b=label; d as for X_JMP
const X_CALL = 45;         // a=sym: call rel32
const X_CALL_R = 46;       // a=rs
const X_RET = 47;
const X_PUSH = 48;         // a=rs
const X_POP = 49;
const X_SXT = 50;          // a=rd b=rs c=size log2: sign-extend the low 8/16/32 bits
const X_ZXT = 51;          // a=rd b=rs c=size log2: zero-extend the low 8/16/32 bits
// SSE2 doubles.
const X_MOVSD = 52;        // a=xd b=xs
const X_MOVSD_LD = 53;     // a=xd b=mem
const X_MOVSD_ST = 54;     // a=xs b=mem
const X_ADDSD = 55;        // a=xd b=xs
const X_SUBSD = 56;
const X_MULSD = 57;
const X_DIVSD = 58;
const X_SQRTSD = 59;
const X_UCOMISD = 60;      // a=xn b=xm
const X_CVTSI2SD = 61;     // a=xd b=rs
const X_CVTTSD2SI = 62;    // a=rd b=xs
const X_MOVQ = 63;         // a=dst b=src: one xmm and one gpr, in either order
const X_XORPD = 64;        // a=xd b=xs
const X_ANDPD = 65;
const X_ROUNDSD = 66;      // a=xd b=xs c=mode (XR_*), SSE4.1
// Prefetch, atomics and fences.
const X_PREFETCHW = 67;    // a=mem
const X_PREFETCHT0 = 68;
const X_LOCK_XADD = 69;    // a=rs b=mem: rs = [mem]; [mem] += old rs
const X_XCHG = 70;         // a=rs b=mem: swap rs and [mem] (implicitly locked)
const X_LOCK_CMPXCHG = 71; // a=rs b=mem: if [mem] == rax then [mem] = rs else rax = [mem]
const X_MFENCE = 72;
const X_PAUSE = 73;
const X_UD2 = 74;
// SSE single precision (f32 is kept in registers as an f64; these cross the boundary).
const X_MOVSS_LD = 75;     // a=xd b=mem: low 32 bits
const X_MOVSS_ST = 76;     // a=xs b=mem
const X_CVTSD2SS = 77;     // a=xd b=xs
const X_CVTSS2SD = 78;     // a=xd b=xs
const X_MOVD_RX = 79;      // a=rd b=xs: r32 = low 32 bits of xs

const XK_SIGNED = 4;

// Registers: xmm registers are numbered XMM + n.
const XMM = 64;
const RAX = 0;
const RCX = 1;
const RDX = 2;
const RBX = 3;
const RSP = 4;
const RBP = 5;
const RSI = 6;
const RDI = 7;

// Condition codes, in hardware order.
const XC_O = 0;
const XC_NO = 1;
const XC_B = 2;
const XC_AE = 3;
const XC_E = 4;
const XC_NE = 5;
const XC_BE = 6;
const XC_A = 7;
const XC_S = 8;
const XC_NS = 9;
const XC_P = 10;
const XC_NP = 11;
const XC_L = 12;
const XC_GE = 13;
const XC_LE = 14;
const XC_G = 15;

// roundsd modes (bit 3 suppresses the precision exception).
const XR_NEAREST = 8;
const XR_FLOOR = 9;
const XR_CEIL = 10;
const XR_TRUNC = 11;

// A memory operand is one word: disp32 | base << 32 | index << 37 | scale log2 << 42.
// With a rip-relative base the disp field holds the label or symbol the operand refers to.
const XM_NONE = 16;    // no index register
const XM_RIP = 16;     // base: [rip + label]
const XM_RIPSYM = 17;  // base: [rip + sym]

// x64_mem builds [base + index*scale + disp]; scale is 1, 2, 4 or 8 and index may be XM_NONE.
fn x64_mem(base, index, scale, disp) {
    let log = 0;
    while index != XM_NONE && (1 << log) < scale {
        log = log + 1;
    }
    return (disp & 0xffffffff) | (base << 32) | (index << 37) | (log << 42);
}

fn x64_mem_rip(label) {
    return x64_mem(XM_RIP, XM_NONE, 1, label);
}

fn x64_mem_sym(sym) {
    return x64_mem(XM_RIPSYM, XM_NONE, 1, sym);
}

fn x64_mem_base(m) {
    return (m >> 32) & 31;
}

fn x64_mem_index(m) {
    return (m >> 37) & 31;
}

fn x64_mem_scale(m) {
    return (m >> 42) & 3;
}

fn x64_mem_disp(m) {
    let d = m & 0xffffffff;
    if d >= 0x80000000 {
        return d - 0x100000000;
    }
    return d;
}

// Label and symbol addresses: x64_labels is filled by x64_layout; symbols come from the
// x64_syms vector when it is set, else from x64_sym_hook (the linker's resolver).
// x64_relocs, when set, collects (address of disp32, sym, address the disp is relative to).
var x64_labels;
var x64_syms;
var x64_relocs;
var x64_base;      // address of byte 0 of the buffer being encoded into
var x64_scratch;   // buffer used to measure instructions
var x64_passes;    // relaxation passes the last x64_layout took

fn x64_label_addr(l) {
    if !x64_labels || l >= x64_labels[VEC_LEN] {
        return 0;
    }
    return vec_get(x64_labels, l);
}

fn x64_sym_addr(s) {
    if !x64_syms {
        return x64_sym_hook(s);
    }
    if s >= x64_syms[VEC_LEN] {
        return 0;
    }
    return vec_get(x64_syms, s);
}

fn x64_fail(msg) {
    let e = err_begin(NO_POS);
    buf_str(e, "x64: ");
    buf_str(e, msg);
    fatal(e);
}

// ---- text printer (Intel syntax, as objdump -M intel prints it) ----

fn x64_pr_hex(b, v) {
    buf_str(b, "0x");
    let k = 60;
    while k > 0 && ((v >> k) & 15) == 0 {
        k = k - 4;
    }
    while k >= 0 {
        buf_byte(b, load8("0123456789abcdef" + ((v >> k) & 15)));
        k = k - 4;
    }
}

// x64_pr_signed prints +0xN or -0xN as objdump does for displacements.
fn x64_pr_signed(b, v) {
    if v < 0 {
        buf_byte(b, '-');
        x64_pr_hex(b, -v);
    } else {
        buf_byte(b, '+');
        x64_pr_hex(b, v);
    }
}

// x64_pr_reg prints a register of the given size log2 (3 = 64 bits).
fn x64_pr_reg(b, r, size) {
    if r >= XMM {
        buf_str(b, "xmm");
        buf_int(b, r - XMM);
        return;
    }
    if r >= 8 {
        buf_byte(b, 'r');
        buf_int(b, r);
        if size == 2 {
            buf_byte(b, 'd');
        } else if size == 1 {
            buf_byte(b, 'w');
        } else if size == 0 {
            buf_byte(b, 'b');
        }
        return;
    }
    if size == 3 {
        buf_str(b, "rax\0rcx\0rdx\0rbx\0rsp\0rbp\0rsi\0rdi" + 4 * r);
    } else if size == 2 {
        buf_str(b, "eax\0ecx\0edx\0ebx\0esp\0ebp\0esi\0edi" + 4 * r);
    } else if size == 1 {
        buf_str(b, "ax\0\0cx\0\0dx\0\0bx\0\0sp\0\0bp\0\0si\0\0di" + 4 * r);
    } else {
        buf_str(b, "al\0\0cl\0\0dl\0\0bl\0\0spl\0bpl\0sil\0dil" + 4 * r);
    }
}

fn x64_pr_cond(b, c) {
    buf_str(b, "o\0\0no\0b\0\0ae\0e\0\0ne\0be\0a\0\0s\0\0ns\0p\0\0np\0l\0\0ge\0le\0g\0" + 3 * c);
}

fn x64_pr_ptr(b, size) {
    if size == 3 {
        buf_str(b, "QWORD PTR ");
    } else if size == 2 {
        buf_str(b, "DWORD PTR ");
    } else if size == 1 {
        buf_str(b, "WORD PTR ");
    } else {
        buf_str(b, "BYTE PTR ");
    }
}

// x64_pr_mem prints [base+index*scale+disp]; end is the address after the instruction,
// which rip-relative operands are measured from (negative: print the label instead).
fn x64_pr_mem(b, m, end) {
    let base = x64_mem_base(m);
    let index = x64_mem_index(m);
    let disp = x64_mem_disp(m);
    buf_byte(b, '[');
    if base >= XM_RIP {
        buf_str(b, "rip");
        if end < 0 {
            buf_byte(b, '+');
            if base == XM_RIP {
                buf_byte(b, 'L');
            } else {
                buf_byte(b, 'S');
            }
            buf_int(b, disp);
        } else {
            // objdump prints a negative rip displacement as its unsigned 64-bit value.
            buf_byte(b, '+');
            if base == XM_RIP {
                x64_pr_hex(b, x64_label_addr(disp) - end);
            } else {
                x64_pr_hex(b, x64_sym_addr(disp) - end);
            }
        }
        buf_byte(b, ']');
        return;
    }
    x64_pr_reg(b, base, 3);
    if index != XM_NONE {
        buf_byte(b, '+');
        x64_pr_reg(b, index, 3);
        buf_byte(b, '*');
        buf_int(b, 1 << x64_mem_scale(m));
    }
    if disp != 0 || (base & 7) == RBP {
        x64_pr_signed(b, disp);
    }
    buf_byte(b, ']');
}

fn x64_pr_rr(b, name, rd, rs, size) {
    buf_str(b, name);
    buf_byte(b, ' ');
    x64_pr_reg(b, rd, size);
    buf_byte(b, ',');
    x64_pr_reg(b, rs, size);
}

fn x64_pr_ri(b, name, rd, imm, size) {
    buf_str(b, name);
    buf_byte(b, ' ');
    x64_pr_reg(b, rd, size);
    buf_byte(b, ',');
    x64_pr_hex(b, imm);
}

// x64_pr_rm prints NAME reg,SIZE PTR [mem] (reg first) or NAME SIZE PTR [mem],reg.
fn x64_pr_rm(b, name, r, rsize, m, msize, reg_first, end) {
    buf_str(b, name);
    buf_byte(b, ' ');
    if reg_first {
        x64_pr_reg(b, r, rsize);
        buf_byte(b, ',');
    }
    x64_pr_ptr(b, msize);
    x64_pr_mem(b, m, end);
    if !reg_first {
        buf_byte(b, ',');
        x64_pr_reg(b, r, rsize);
    }
}

fn x64_pr_target(b, addr, label, pc) {
    if pc < 0 {
        buf_byte(b, 'L');
        buf_int(b, label);
    } else {
        x64_pr_hex(b, addr);
    }
}

// x64_fits8 reports whether v is representable as a sign-extended 8-bit immediate.
fn x64_fits8(v) {
    return v >= -128 && v <= 127;
}

fn x64_fits32(v) {
    return v >= -0x80000000 && v <= 0x7fffffff;
}

// x64_size returns the encoded length of ins at pc without recording relocations; branch
// sizes follow from their form alone, so labels still being placed are never range-checked.
fn x64_size(ins, pc) {
    if ins[0] == X_JMP || ins[0] == X_JCC {
        if ins[4] {
            return 2;
        }
        if ins[0] == X_JMP {
            return 5;
        }
        return 6;
    }
    if !x64_scratch {
        x64_scratch = buf_new();
    }
    let relocs = x64_relocs;
    x64_relocs = 0;
    x64_scratch[VEC_LEN] = 0;
    let n = x64_encode(ins, pc, x64_scratch);
    x64_relocs = relocs;
    return n;
}

// x64_print appends one line of Intel-syntax assembly for ins at pc (labels print nothing).
// With a negative pc branch targets and rip-relative operands print as L<label>/S<sym>.
fn x64_print(b, ins, pc) {
    let op = ins[0];
    let x = ins[1];
    let y = ins[2];
    let z = ins[3];
    let w = ins[4];
    if op == X_LABEL {
        if pc < 0 {
            buf_byte(b, 'L');
            buf_int(b, x);
            buf_str(b, ":\n");
        }
        return;
    }
    let end = -1;
    if pc >= 0 {
        end = pc + x64_size(ins, pc);
    }
    if op == X_MOV_RR {
        x64_pr_rr(b, "mov", x, y, 3);
    } else if op == X_MOV_RI {
        if y >= 0 && y <= 0xffffffff {
            x64_pr_ri(b, "mov", x, y, 2);
        } else if x64_fits32(y) {
            x64_pr_ri(b, "mov", x, y, 3);
        } else {
            x64_pr_ri(b, "movabs", x, y, 3);
        }
    } else if op == X_LOAD {
        x64_pr_load(b, x, y, z, end);
    } else if op == X_STORE {
        x64_pr_rm(b, "mov", x, z, y, z, 0, end);
    } else if op == X_LEA {
        buf_str(b, "lea ");
        x64_pr_reg(b, x, 3);
        buf_byte(b, ',');
        x64_pr_mem(b, y, end);
    } else if op >= X_ADD && op <= X_TEST {
        x64_pr_rr(b, x64_alu_name(op - X_ADD), x, y, 3);
    } else if op >= X_ADDI && op <= X_TESTI {
        x64_pr_ri(b, x64_alu_name(op - X_ADDI), x, y, 3);
    } else if op >= X_ADDM && op <= X_TESTM {
        x64_pr_rm(b, x64_alu_name(op - X_ADDM), x, 3, y, 3, op != X_TESTM, end);
    } else if op == X_IMUL_RR {
        x64_pr_rr(b, "imul", x, y, 3);
    } else if op == X_IMUL_RRI {
        x64_pr_rr(b, "imul", x, y, 3);
        buf_byte(b, ',');
        x64_pr_hex(b, z);
    } else if op == X_IDIV || op == X_DIV || op == X_NEG || op == X_NOT || op == X_CALL_R || op == X_PUSH || op == X_POP {
        buf_str(b, x64_unary_name(op));
        buf_byte(b, ' ');
        x64_pr_reg(b, x, 3);
    } else if op == X_CQO {
        buf_str(b, "cqo");
    } else if op >= X_SHL && op <= X_SAR {
        buf_str(b, "shl\0shr\0sar" + 4 * (op - X_SHL));
        buf_byte(b, ' ');
        x64_pr_reg(b, x, 3);
        buf_str(b, ",cl");
    } else if op >= X_SHLI && op <= X_SARI {
        x64_pr_ri(b, "shl\0shr\0sar" + 4 * (op - X_SHLI), x, y & 0xff, 3);
    } else if op == X_SETCC {
        buf_str(b, "set");
        x64_pr_cond(b, y);
        buf_byte(b, ' ');
        x64_pr_reg(b, x, 0);
    } else if op == X_CMOVCC {
        buf_str(b, "cmov");
        x64_pr_cond(b, z);
        buf_byte(b, ' ');
        x64_pr_reg(b, x, 3);
        buf_byte(b, ',');
        x64_pr_reg(b, y, 3);
    } else if op == X_JMP {
        buf_str(b, "jmp ");
        x64_pr_target(b, x64_label_addr(x), x, pc);
    } else if op == X_JCC {
        buf_byte(b, 'j');
        x64_pr_cond(b, x);
        buf_byte(b, ' ');
        x64_pr_target(b, x64_label_addr(y), y, pc);
    } else if op == X_CALL {
        buf_str(b, "call ");
        if pc < 0 {
            buf_byte(b, 'S');
            buf_int(b, x);
        } else {
            x64_pr_hex(b, x64_sym_addr(x));
        }
    } else if op == X_RET {
        buf_str(b, "ret");
    } else if op == X_SXT {
        if z == 2 {
            buf_str(b, "movsxd ");
        } else {
            buf_str(b, "movsx ");
        }
        x64_pr_reg(b, x, 3);
        buf_byte(b, ',');
        x64_pr_reg(b, y, z);
    } else if op == X_ZXT {
        if z == 2 {
            x64_pr_rr(b, "mov", x, y, 2);
        } else {
            buf_str(b, "movzx ");
            x64_pr_reg(b, x, 2);
            buf_byte(b, ',');
            x64_pr_reg(b, y, z);
        }
    } else if op >= X_MOVSD && op <= X_ANDPD {
        x64_pr_sse(b, op, x, y, end);
    } else if op == X_ROUNDSD {
        x64_pr_rr(b, "roundsd", x, y, 3);
        buf_byte(b, ',');
        x64_pr_hex(b, z);
    } else if op == X_PREFETCHW || op == X_PREFETCHT0 {
        if op == X_PREFETCHW {
            buf_str(b, "prefetchw BYTE PTR ");
        } else {
            buf_str(b, "prefetcht0 BYTE PTR ");
        }
        x64_pr_mem(b, x, end);
    } else if op == X_LOCK_XADD {
        x64_pr_rm(b, "lock xadd", x, 3, y, 3, 0, end);
    } else if op == X_XCHG {
        x64_pr_rm(b, "xchg", x, 3, y, 3, 0, end);
    } else if op == X_LOCK_CMPXCHG {
        x64_pr_rm(b, "lock cmpxchg", x, 3, y, 3, 0, end);
    } else if op == X_MFENCE {
        buf_str(b, "mfence");
    } else if op == X_PAUSE {
        buf_str(b, "pause");
    } else if op == X_UD2 {
        buf_str(b, "ud2");
    } else if op == X_MOVSS_LD {
        x64_pr_rm(b, "movss", x, 3, y, 2, 1, end);
    } else if op == X_MOVSS_ST {
        x64_pr_rm(b, "movss", x, 3, y, 2, 0, end);
    } else if op == X_CVTSD2SS {
        x64_pr_rr(b, "cvtsd2ss", x, y, 3);
    } else if op == X_CVTSS2SD {
        x64_pr_rr(b, "cvtss2sd", x, y, 3);
    } else if op == X_MOVD_RX {
        buf_str(b, "movd ");
        x64_pr_reg(b, x, 2);
        buf_byte(b, ',');
        x64_pr_reg(b, y, 3);
    } else {
        x64_fail("cannot print instruction");
    }
    buf_byte(b, '\n');
}

fn x64_alu_name(i) {
    return "add\0\0sub\0\0and\0\0or\0\0\0xor\0\0cmp\0\0test" + 5 * i;
}

fn x64_unary_name(op) {
    if op == X_IDIV {
        return "idiv";
    }
    if op == X_DIV {
        return "div";
    }
    if op == X_NEG {
        return "neg";
    }
    if op == X_NOT {
        return "not";
    }
    if op == X_CALL_R {
        return "call";
    }
    if op == X_PUSH {
        return "push";
    }
    return "pop";
}

// x64_pr_load prints the mov/movzx/movsx/movsxd form a sized load uses.
fn x64_pr_load(b, rt, m, kind, end) {
    let size = kind & 3;
    let signed = kind & XK_SIGNED;
    if size == 3 {
        x64_pr_rm(b, "mov", rt, 3, m, 3, 1, end);
    } else if signed && size == 2 {
        x64_pr_rm(b, "movsxd", rt, 3, m, 2, 1, end);
    } else if signed {
        x64_pr_rm(b, "movsx", rt, 3, m, size, 1, end);
    } else if size == 2 {
        x64_pr_rm(b, "mov", rt, 2, m, 2, 1, end);
    } else {
        x64_pr_rm(b, "movzx", rt, 2, m, size, 1, end);
    }
}

fn x64_pr_sse(b, op, x, y, end) {
    if op == X_MOVSD_LD {
        x64_pr_rm(b, "movsd", x, 3, y, 3, 1, end);
    } else if op == X_MOVSD_ST {
        x64_pr_rm(b, "movsd", x, 3, y, 3, 0, end);
    } else if op == X_MOVSD {
        x64_pr_rr(b, "movsd", x, y, 3);
    } else if op >= X_ADDSD && op <= X_SQRTSD {
        x64_pr_rr(b, "addsd\0\0subsd\0\0mulsd\0\0divsd\0\0sqrtsd" + 7 * (op - X_ADDSD), x, y, 3);
    } else if op == X_UCOMISD {
        x64_pr_rr(b, "ucomisd", x, y, 3);
    } else if op == X_CVTSI2SD {
        x64_pr_rr(b, "cvtsi2sd", x, y, 3);
    } else if op == X_CVTTSD2SI {
        x64_pr_rr(b, "cvttsd2si", x, y, 3);
    } else if op == X_MOVQ {
        x64_pr_rr(b, "movq", x, y, 3);
    } else if op == X_XORPD {
        x64_pr_rr(b, "xorpd", x, y, 3);
    } else {
        x64_pr_rr(b, "andpd", x, y, 3);
    }
}

// ---- encoder ----

// x64_rn maps a register operand to its 4-bit hardware number.
fn x64_rn(r) {
    if r >= XMM {
        return r - XMM;
    }
    return r;
}

// x64_byte_reg reports whether r, used as a byte register, needs a REX prefix (spl, bpl, sil, dil).
fn x64_byte_reg(r) {
    return r >= RSP && r <= RDI;
}

fn x64_imm32(out, v) {
    buf_byte(out, v);
    buf_byte(out, v >> 8);
    buf_byte(out, v >> 16);
    buf_byte(out, v >> 24);
}

fn x64_imm64(out, v) {
    x64_imm32(out, v);
    x64_imm32(out, v >> 32);
}

// x64_rex emits a REX prefix when any of W, R, X, B is set or force asks for an empty one.
fn x64_rex(out, w, r, x, b, force) {
    let rex = 0x40 | (w << 3) | (((r >> 3) & 1) << 2) | (((x >> 3) & 1) << 1) | ((b >> 3) & 1);
    if rex != 0x40 || force {
        buf_byte(out, rex);
    }
}

// x64_opcode emits a one-, two- (0F xx) or three-byte (0F 3A xx) opcode.
fn x64_opcode(out, opc) {
    if opc > 0xffff {
        buf_byte(out, opc >> 16);
    }
    if opc > 0xff {
        buf_byte(out, opc >> 8);
    }
    buf_byte(out, opc);
}

fn x64_prefix(out, pfx) {
    if pfx != 0 {
        buf_byte(out, pfx);
    }
}

// x64_rr emits PFX REX OPC ModRM for a register rm operand; reg may be a /digit.
fn x64_rr(out, pfx, w, opc, reg, rm, force) {
    let r = x64_rn(reg);
    let m = x64_rn(rm);
    x64_prefix(out, pfx);
    x64_rex(out, w, r, 0, m, force);
    x64_opcode(out, opc);
    buf_byte(out, 0xC0 | ((r & 7) << 3) | (m & 7));
}

// x64_rm emits PFX REX OPC ModRM [SIB] [disp] for a memory rm operand.
fn x64_rm(out, pfx, w, opc, reg, m, force) {
    let r = x64_rn(reg);
    let base = x64_mem_base(m);
    let index = x64_mem_index(m);
    x64_prefix(out, pfx);
    if base >= XM_RIP {
        x64_rex(out, w, r, 0, 0, force);
    } else {
        x64_rex(out, w, r, index, base, force);
    }
    x64_opcode(out, opc);
    x64_modrm_mem(out, r, m);
}

// x64_modrm_mem emits the ModRM byte, the SIB byte when needed and the displacement.
// rsp/r12 as base need a SIB byte; rbp/r13 as base always need a displacement.
fn x64_modrm_mem(out, r, m) {
    let base = x64_mem_base(m);
    let index = x64_mem_index(m);
    let disp = x64_mem_disp(m);
    let rfield = (r & 7) << 3;
    if base >= XM_RIP {
        buf_byte(out, rfield | 5);
        let here = x64_base + out[VEC_LEN];
        let target = 0;
        if base == XM_RIP {
            target = x64_label_addr(disp);
        } else {
            target = x64_sym_addr(disp);
            if x64_relocs {
                vec_push(x64_relocs, here);
                vec_push(x64_relocs, disp);
                vec_push(x64_relocs, here + 4);
            }
        }
        x64_imm32(out, target - (here + 4));
        return;
    }
    let mod = 0;
    if disp != 0 || (base & 7) == RBP {
        if x64_fits8(disp) {
            mod = 0x40;
        } else {
            mod = 0x80;
        }
    }
    if index != XM_NONE || (base & 7) == RSP {
        // Without an index the SIB index field is 100 and the scale must be 0.
        let sib = base & 7;
        if index == XM_NONE {
            sib = sib | (RSP << 3);
        } else {
            sib = sib | (x64_mem_scale(m) << 6) | ((index & 7) << 3);
        }
        buf_byte(out, mod | rfield | RSP);
        buf_byte(out, sib);
    } else {
        buf_byte(out, mod | rfield | (base & 7));
    }
    if mod == 0x40 {
        buf_byte(out, disp);
    } else if mod == 0x80 {
        x64_imm32(out, disp);
    }
}

// Opcodes of the ALU group in X_ADD..X_TEST order: r/m,r form, r,r/m form and the /digit.
fn x64_alu_mr(i) {
    return load8("\x01\x29\x21\x09\x31\x39\x85" + i);
}

fn x64_alu_rm(i) {
    return load8("\x03\x2b\x23\x0b\x33\x3b\x85" + i);
}

fn x64_alu_digit(i) {
    return load8("\x00\x05\x04\x01\x06\x07\x00" + i);
}

// x64_rel emits a rel8 or rel32 branch displacement to target from the end of the instruction.
fn x64_rel(out, target, short) {
    let here = x64_base + out[VEC_LEN];
    if short {
        let d = target - (here + 1);
        if !x64_fits8(d) {
            x64_fail("short branch out of range");
        }
        buf_byte(out, d);
    } else {
        x64_imm32(out, target - (here + 4));
    }
}

// x64_encode appends the machine code of ins at address pc to out and returns its length.
fn x64_encode(ins, pc, out) {
    let start = out[VEC_LEN];
    x64_base = pc - start;
    let op = ins[0];
    let x = ins[1];
    let y = ins[2];
    let z = ins[3];
    let w = ins[4];
    if op == X_LABEL {
        return 0;
    }
    if op == X_MOV_RR {
        x64_rr(out, 0, 1, 0x89, y, x, 0);
    } else if op == X_MOV_RI {
        if y >= 0 && y <= 0xffffffff {
            x64_rex(out, 0, 0, 0, x, 0);
            buf_byte(out, 0xB8 + (x & 7));
            x64_imm32(out, y);
        } else if x64_fits32(y) {
            x64_rr(out, 0, 1, 0xC7, 0, x, 0);
            x64_imm32(out, y);
        } else {
            x64_rex(out, 1, 0, 0, x, 0);
            buf_byte(out, 0xB8 + (x & 7));
            x64_imm64(out, y);
        }
    } else if op == X_LOAD {
        x64_enc_load(out, x, y, z);
    } else if op == X_STORE {
        if z == 3 {
            x64_rm(out, 0, 1, 0x89, x, y, 0);
        } else if z == 2 {
            x64_rm(out, 0, 0, 0x89, x, y, 0);
        } else if z == 1 {
            x64_rm(out, 0x66, 0, 0x89, x, y, 0);
        } else {
            x64_rm(out, 0, 0, 0x88, x, y, x64_byte_reg(x));
        }
    } else if op == X_LEA {
        x64_rm(out, 0, 1, 0x8D, x, y, 0);
    } else if op >= X_ADD && op <= X_TEST {
        x64_rr(out, 0, 1, x64_alu_mr(op - X_ADD), y, x, 0);
    } else if op >= X_ADDI && op <= X_TESTI {
        x64_enc_alu_imm(out, op - X_ADDI, x, y);
    } else if op >= X_ADDM && op <= X_TESTM {
        x64_rm(out, 0, 1, x64_alu_rm(op - X_ADDM), x, y, 0);
    } else if op == X_IMUL_RR {
        x64_rr(out, 0, 1, 0x0FAF, x, y, 0);
    } else if op == X_IMUL_RRI {
        if x64_fits8(z) {
            x64_rr(out, 0, 1, 0x6B, x, y, 0);
            buf_byte(out, z);
        } else {
            x64_rr(out, 0, 1, 0x69, x, y, 0);
            x64_imm32(out, z);
        }
    } else if op == X_IDIV {
        x64_rr(out, 0, 1, 0xF7, 7, x, 0);
    } else if op == X_DIV {
        x64_rr(out, 0, 1, 0xF7, 6, x, 0);
    } else if op == X_CQO {
        buf_byte(out, 0x48);
        buf_byte(out, 0x99);
    } else if op == X_NEG {
        x64_rr(out, 0, 1, 0xF7, 3, x, 0);
    } else if op == X_NOT {
        x64_rr(out, 0, 1, 0xF7, 2, x, 0);
    } else if op >= X_SHL && op <= X_SAR {
        x64_rr(out, 0, 1, 0xD3, x64_shift_digit(op - X_SHL), x, 0);
    } else if op >= X_SHLI && op <= X_SARI {
        x64_rr(out, 0, 1, 0xC1, x64_shift_digit(op - X_SHLI), x, 0);
        buf_byte(out, y);
    } else if op == X_SETCC {
        x64_rr(out, 0, 0, 0x0F90 + y, 0, x, x64_byte_reg(x));
    } else if op == X_CMOVCC {
        x64_rr(out, 0, 1, 0x0F40 + z, x, y, 0);
    } else if op == X_JMP {
        if w {
            buf_byte(out, 0xEB);
        } else {
            buf_byte(out, 0xE9);
        }
        x64_rel(out, x64_label_addr(x), w);
    } else if op == X_JCC {
        if w {
            buf_byte(out, 0x70 + x);
        } else {
            buf_byte(out, 0x0F);
            buf_byte(out, 0x80 + x);
        }
        x64_rel(out, x64_label_addr(y), w);
    } else if op == X_CALL {
        buf_byte(out, 0xE8);
        let here = x64_base + out[VEC_LEN];
        if x64_relocs {
            vec_push(x64_relocs, here);
            vec_push(x64_relocs, x);
            vec_push(x64_relocs, here + 4);
        }
        x64_imm32(out, x64_sym_addr(x) - (here + 4));
    } else if op == X_CALL_R {
        x64_rr(out, 0, 0, 0xFF, 2, x, 0);
    } else if op == X_RET {
        buf_byte(out, 0xC3);
    } else if op == X_PUSH {
        x64_rex(out, 0, 0, 0, x, 0);
        buf_byte(out, 0x50 + (x & 7));
    } else if op == X_POP {
        x64_rex(out, 0, 0, 0, x, 0);
        buf_byte(out, 0x58 + (x & 7));
    } else if op == X_SXT {
        if z == 0 {
            x64_rr(out, 0, 1, 0x0FBE, x, y, 0);
        } else if z == 1 {
            x64_rr(out, 0, 1, 0x0FBF, x, y, 0);
        } else {
            x64_rr(out, 0, 1, 0x63, x, y, 0);
        }
    } else if op == X_ZXT {
        if z == 0 {
            x64_rr(out, 0, 0, 0x0FB6, x, y, x64_byte_reg(y));
        } else if z == 1 {
            x64_rr(out, 0, 0, 0x0FB7, x, y, 0);
        } else {
            x64_rr(out, 0, 0, 0x89, y, x, 0);
        }
    } else if op == X_MOVSD {
        x64_rr(out, 0xF2, 0, 0x0F10, x, y, 0);
    } else if op == X_MOVSD_LD {
        x64_rm(out, 0xF2, 0, 0x0F10, x, y, 0);
    } else if op == X_MOVSD_ST {
        x64_rm(out, 0xF2, 0, 0x0F11, x, y, 0);
    } else if op >= X_ADDSD && op <= X_SQRTSD {
        x64_rr(out, 0xF2, 0, 0x0F00 | load8("\x58\x5c\x59\x5e\x51" + (op - X_ADDSD)), x, y, 0);
    } else if op == X_UCOMISD {
        x64_rr(out, 0x66, 0, 0x0F2E, x, y, 0);
    } else if op == X_CVTSI2SD {
        x64_rr(out, 0xF2, 1, 0x0F2A, x, y, 0);
    } else if op == X_CVTTSD2SI {
        x64_rr(out, 0xF2, 1, 0x0F2C, x, y, 0);
    } else if op == X_MOVQ {
        if x >= XMM {
            x64_rr(out, 0x66, 1, 0x0F6E, x, y, 0);
        } else {
            x64_rr(out, 0x66, 1, 0x0F7E, y, x, 0);
        }
    } else if op == X_XORPD {
        x64_rr(out, 0x66, 0, 0x0F57, x, y, 0);
    } else if op == X_ANDPD {
        x64_rr(out, 0x66, 0, 0x0F54, x, y, 0);
    } else if op == X_ROUNDSD {
        x64_rr(out, 0x66, 0, 0x0F3A0B, x, y, 0);
        buf_byte(out, z);
    } else if op == X_PREFETCHW {
        x64_rm(out, 0, 0, 0x0F0D, 1, x, 0);
    } else if op == X_PREFETCHT0 {
        x64_rm(out, 0, 0, 0x0F18, 1, x, 0);
    } else if op == X_LOCK_XADD {
        x64_rm(out, 0xF0, 1, 0x0FC1, x, y, 0);
    } else if op == X_XCHG {
        x64_rm(out, 0, 1, 0x87, x, y, 0);
    } else if op == X_LOCK_CMPXCHG {
        x64_rm(out, 0xF0, 1, 0x0FB1, x, y, 0);
    } else if op == X_MFENCE {
        buf_byte(out, 0x0F);
        buf_byte(out, 0xAE);
        buf_byte(out, 0xF0);
    } else if op == X_PAUSE {
        buf_byte(out, 0xF3);
        buf_byte(out, 0x90);
    } else if op == X_UD2 {
        buf_byte(out, 0x0F);
        buf_byte(out, 0x0B);
    } else if op == X_MOVSS_LD {
        x64_rm(out, 0xF3, 0, 0x0F10, x, y, 0);
    } else if op == X_MOVSS_ST {
        x64_rm(out, 0xF3, 0, 0x0F11, x, y, 0);
    } else if op == X_CVTSD2SS {
        x64_rr(out, 0xF2, 0, 0x0F5A, x, y, 0);
    } else if op == X_CVTSS2SD {
        x64_rr(out, 0xF3, 0, 0x0F5A, x, y, 0);
    } else if op == X_MOVD_RX {
        x64_rr(out, 0x66, 0, 0x0F7E, y, x, 0);
    } else {
        x64_fail("cannot encode instruction");
    }
    return out[VEC_LEN] - start;
}

fn x64_shift_digit(i) {
    return load8("\x04\x05\x07" + i);
}

// x64_enc_load picks mov, movzx, movsx or movsxd for a sized load into rt.
fn x64_enc_load(out, rt, m, kind) {
    let size = kind & 3;
    let signed = kind & XK_SIGNED;
    if size == 3 {
        x64_rm(out, 0, 1, 0x8B, rt, m, 0);
    } else if size == 2 && signed {
        x64_rm(out, 0, 1, 0x63, rt, m, 0);
    } else if size == 2 {
        x64_rm(out, 0, 0, 0x8B, rt, m, 0);
    } else if size == 1 && signed {
        x64_rm(out, 0, 1, 0x0FBF, rt, m, 0);
    } else if size == 1 {
        x64_rm(out, 0, 0, 0x0FB7, rt, m, 0);
    } else if signed {
        x64_rm(out, 0, 1, 0x0FBE, rt, m, 0);
    } else {
        x64_rm(out, 0, 0, 0x0FB6, rt, m, 0);
    }
}

// x64_enc_alu_imm emits the 83 ib form when the immediate fits a byte, else 81 id (test: F7 id).
fn x64_enc_alu_imm(out, i, rd, imm) {
    if i == X_TESTI - X_ADDI {
        x64_rr(out, 0, 1, 0xF7, 0, rd, 0);
        x64_imm32(out, imm);
    } else if x64_fits8(imm) {
        x64_rr(out, 0, 1, 0x83, x64_alu_digit(i), rd, 0);
        buf_byte(out, imm);
    } else {
        x64_rr(out, 0, 1, 0x81, x64_alu_digit(i), rd, 0);
        x64_imm32(out, imm);
    }
}

// ---- layout ----

// x64_place assigns every label its address with the current branch forms and returns the code size.
fn x64_place(code, base) {
    let pc = base;
    let i = 0;
    while i < code[VEC_LEN] {
        let ins = code[VEC_DATA] + 8 * i;
        if ins[0] == X_LABEL {
            x64_labels[VEC_DATA][ins[1]] = pc;
        } else {
            pc = pc + x64_size(ins, pc);
        }
        i = i + 5;
    }
    return pc - base;
}

// x64_relax shrinks every rel32 branch whose target is within rel8 range and returns whether any
// changed; distances all come from the placement before this pass (sizes are measured before a
// branch is flipped), and since shrinking only moves targets closer a branch that fits keeps fitting.
fn x64_relax(code, base) {
    let changed = 0;
    let pc = base;
    let i = 0;
    while i < code[VEC_LEN] {
        let ins = code[VEC_DATA] + 8 * i;
        let op = ins[0];
        let len = x64_size(ins, pc);
        if (op == X_JMP || op == X_JCC) && ins[4] == 0 {
            let target = 0;
            let long = 5;
            if op == X_JMP {
                target = x64_label_addr(ins[1]);
            } else {
                target = x64_label_addr(ins[2]);
                long = 6;
            }
            // A forward target moves back with the branch, so measure it from the long form's end.
            let d = target - (pc + 2);
            if target > pc {
                d = target - (pc + long);
            }
            if x64_fits8(d) {
                ins[4] = 1;
                changed = 1;
            }
        }
        pc = pc + len;
        i = i + 5;
    }
    return changed;
}

// x64_layout lays code (a flat vector of five-word instructions) out from base: it assigns
// label addresses into x64_labels, shrinks branches to rel8 until nothing changes and returns the size.
fn x64_layout(code, base) {
    let n = 0;
    let i = 0;
    while i < code[VEC_LEN] {
        let ins = code[VEC_DATA] + 8 * i;
        if ins[0] == X_LABEL && ins[1] >= n {
            n = ins[1] + 1;
        }
        i = i + 5;
    }
    x64_labels = vec_filled(n, 0);
    x64_passes = 0;
    let size = x64_place(code, base);
    while x64_relax(code, base) {
        size = x64_place(code, base);
        x64_passes = x64_passes + 1;
    }
    return size;
}

// x64_assemble lays code out at base and returns a buffer with its machine code; relocations
// against symbols are left in x64_relocs.
fn x64_assemble(code, base) {
    x64_layout(code, base);
    x64_relocs = vec_new();
    let out = buf_new();
    let pc = base;
    let i = 0;
    while i < code[VEC_LEN] {
        pc = pc + x64_encode(code[VEC_DATA] + 8 * i, pc, out);
        i = i + 5;
    }
    return out;
}
