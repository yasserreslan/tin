// ELF writer: a static Linux x86-64 executable, laid out like elf.tin: Tin's own _start, no
// interpreter, no dynamic section and no C library (#125).
//
// Layout (vaddr == file offset, segments 4 KiB aligned):
//   R   : ELF header, program headers, function names, backtrace records
//   RX  : _start, the program's code, C strings, Tin strings
//   RW  : globals, function descriptors
const EX64_ALIGN = 4096
const EX64_START_STATIC = 35
const EX64_STUB_SIZE = 6

// x64_sym_hook resolves a symbol id from gen_x64's table for the encoder: string and
// constant addresses, globals, GOT slots and functions (imports resolve to their stubs).
// Before the linker has placed anything the tables are empty and every address is 0,
// which is fine while x64_layout only measures instructions.
fn x64_sym_hook(id i64) i64 {
	let sym = vec_get(x_syms, id)
	let kind = sym >> 32
	let i = sym & 0xffffffff
	if kind == SK_STR {
		if lk_strs == 0 {
			return 0
		}
		return vec_get(lk_strs, i)
	}
	if kind == SK_VAR {
		return lk_data + 8 * i
	}
	if kind == SK_TSTR {
		if lk_tstrs == 0 {
			return 0
		}
		return vec_get(lk_tstrs, i)
	}
	if kind == SK_FN {
		let f = vec_get(prog_fns, i)
		if f[F_EXTERN] != 0 {
			return lk_stubs + EX64_STUB_SIZE * f[F_GOT]
		}
		return f[F_ADDR]
	}
	if kind == SK_BTRACE {
		return lk_btrace
	}
	if kind == SK_IMAGE {
		return 0
	}
	if kind == SK_ZERO {
		return lk_zero
	}
	if kind == SK_FNDESC {
		return lk_fndescs + 16 * i
	}
	return lk_got + 8 * i
}

// ex64_start_static writes the static _start at p (address at): main(argc, argv, envp) from
// the kernel's initial stack with rbp cleared and rsp aligned, then exit_group (231).
fn ex64_start_static(p i64, at i64, main_addr i64) {
	let code = cstr("31ed488b3c24488d742408488d54fe084883e4f0e800000000")
	mut i = 0
	for i64(load8(code + 2 * i)) != 0 {
		store8(p + i, num_digit(i64(load8(code + 2 * i))) * 16 + num_digit(i64(load8(code + 2 * i + 1))))
		i = i + 1
	}
	put32(p + 21, main_addr - (at + 25))
	store8(p + 25, 0x89)
	store8(p + 26, 0xc7)
	store8(p + 27, 0xb8)
	put32(p + 28, 231)
	store8(p + 32, 0x0f)
	store8(p + 33, 0x05)
	store8(p + 34, 0xf4)
}

fn write_elf_x64(path i64) {
	let nvars = prog_vars[VEC_LEN]
	el_check_static()
	lk_imports = vec_new()
	lk_strs = 0
	lk_tstrs = 0
	lk_stubs = 0
	lk_zero = 0
	lk_got = 0
	lk_data = 0

	// Function names (tin.<name>) and, after them, one backtrace record per function:
	// [start, end, name offset] (the runtime's symbol table).
	let dstr = buf_new()
	buf_byte(dstr, 0)
	let name_off = vec_new()
	let own = vec_new()
	mut i = 0
	for i < prog_fns[VEC_LEN] {
		let f = vec_get(prog_fns, i)
		if f[F_EXTERN] == 0 && f[F_REACH] != 0 {
			vec_push(own, f)
			vec_push(name_off, dstr[VEC_LEN])
			buf_str(dstr, cstr("tin."))
			buf_str(dstr, f[F_QNAME])
			buf_byte(dstr, 0)
		}
		i = i + 1
	}

	// Read-only segment: headers, names, backtrace records.
	let ph_off = 64
	let phnum = 5
	let dynstr_off = ph_off + 56 * phnum
	lk_btrace = align_up(dynstr_off + dstr[VEC_LEN], 8)
	let ro_end = lk_btrace + 8 + 24 * own[VEC_LEN]

	// Text segment: _start, code (laid out and relaxed first), strings, constants.
	let text_addr = align_up(ro_end, EX64_ALIGN)
	let start_addr = text_addr
	let code_addr = align_up(text_addr + EX64_START_STATIC, 16)
	x64_syms = 0
	x64_relocs = 0
	let code_size = x64_layout(code, code_addr)
	i = 0
	for i < own[VEC_LEN] {
		let f = vec_get(own, i)
		f[F_ADDR] = x64_label_addr(vec_get(x_fn_labels, f[F_INDEX]))
		i = i + 1
	}
	mut pc = code_addr + code_size
	lk_stubs = pc // the end of the code: there are no import stubs
	lk_strs = vec_new()
	i = 0
	for i < g_str_ptrs[VEC_LEN] {
		vec_push(lk_strs, pc)
		pc = pc + vec_get(g_str_lens, i) + 1
		i = i + 1
	}
	pc = align_up(pc, 8)
	lk_zero = pc
	pc = pc + 32
	lk_tstrs = vec_new()
	i = 0
	for i < g_tstr_ptrs[VEC_LEN] {
		vec_push(lk_tstrs, pc)
		pc = align_up(pc + 8 + vec_get(g_tstr_lens, i) + 1, 8)
		i = i + 1
	}
	let text_end = pc

	// Data segment: globals, then function descriptors.
	let data_addr = align_up(text_end, EX64_ALIGN)
	lk_got = data_addr
	lk_data = data_addr
	lk_fndescs = lk_data + 8 * nvars
	let data_end = lk_fndescs + 16 * prog_fns[VEC_LEN] + 8
	let extra = el_extra(data_end, own[VEC_LEN])
	let file_size = data_end + extra
	let img = calloc(file_size, 1)

	// ELF header.
	store8(img, 0x7f)
	store8(img + 1, 'E')
	store8(img + 2, 'L')
	store8(img + 3, 'F')
	store8(img + 4, 2)
	store8(img + 5, 1)
	store8(img + 6, 1)
	put32(img + 16, 3 | (62 << 16))
	put32(img + 20, 1)
	put64(img + 24, start_addr)
	put64(img + 32, ph_off)
	put64(img + 40, 0)
	put32(img + 48, 0)
	put32(img + 52, 64 | (56 << 16))
	put32(img + 56, phnum | (64 << 16))
	put32(img + 60, 0)

	// Program headers: PHDR, LOAD R, LOAD RX, LOAD RW, GNU_STACK.
	mut p = img + ph_off
	p = el_phdr(p, 6, 4, ph_off, ph_off, 56 * phnum, 56 * phnum, 8)
	p = el_phdr(p, 1, 4, 0, 0, ro_end, ro_end, EX64_ALIGN)
	p = el_phdr(p, 1, 5, text_addr, text_addr, text_end - text_addr, text_end - text_addr, EX64_ALIGN)
	p = el_phdr(p, 1, 6, data_addr, data_addr, data_end - data_addr, data_end - data_addr, EX64_ALIGN)
	p = el_phdr(p, 0x6474e551, 6, 0, 0, 0, 0, 16)

	memcpy(img + dynstr_off, dstr[VEC_DATA], dstr[VEC_LEN])
	put64(img + lk_btrace, own[VEC_LEN])
	i = 0
	for i < own[VEC_LEN] {
		let f = vec_get(own, i)
		mut end = lk_stubs
		if i + 1 < own[VEC_LEN] {
			end = vec_get(own, i + 1)[F_ADDR]
		}
		let rec = img + lk_btrace + 8 + 24 * i
		put64(rec, f[F_ADDR])
		put64(rec + 8, end)
		put64(rec + 16, dynstr_off + vec_get(name_off, i))
		i = i + 1
	}

	// _start, then the machine code.
	ex64_start_static(img + start_addr, start_addr, entry_fn()[F_ADDR])
	if extra != 0 {
		let lay = vec_new()
		vec_push(lay, data_end)
		vec_push(lay, dynstr_off)
		vec_push(lay, dstr[VEC_LEN])
		vec_push(lay, text_addr)
		vec_push(lay, lk_stubs)
		vec_push(lay, text_end)
		vec_push(lay, data_addr)
		el_symbols(img, own, name_off, lay)
	}
	let out = buf_new()
	pc = code_addr
	i = 0
	for i < code[VEC_LEN] {
		pc = pc + x64_encode(code[VEC_DATA] + 8 * i, pc, out)
		i = i + 5
	}
	if out[VEC_LEN] != code_size {
		link_fail(cstr("x86-64 code size changed between layout and encoding"))
	}
	memcpy(img + code_addr, out[VEC_DATA], out[VEC_LEN])

	i = 0
	for i < g_str_ptrs[VEC_LEN] {
		memcpy(img + vec_get(lk_strs, i), vec_get(g_str_ptrs, i), vec_get(g_str_lens, i))
		i = i + 1
	}
	i = 0
	for i < g_tstr_ptrs[VEC_LEN] {
		let at = img + vec_get(lk_tstrs, i)
		put64(at, vec_get(g_tstr_lens, i))
		memcpy(at + 8, vec_get(g_tstr_ptrs, i), vec_get(g_tstr_lens, i))
		i = i + 1
	}
	i = 0
	for i < nvars {
		put64(img + lk_data + 8 * i, vec_get(prog_vars, i)[D_VAL])
		i = i + 1
	}

	rt_sys_unlink(path)
	let fd = rt_sys_creat(path, 493)
	if (fd & 0x80000000) != 0 {
		let e = err_code(NO_POS, cstr("E904 CANNOT_CREATE"))
		buf_str(e, cstr("cannot create "))
		buf_str(e, path)
		fatal(e)
	}
	let w = malloc(24)
	w[VEC_LEN] = file_size
	w[VEC_CAP] = file_size
	w[VEC_DATA] = img
	write_all(fd, w)
	rt_sys_close(fd)
}
