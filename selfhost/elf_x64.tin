// ELF writer: a static Linux x86-64 executable, laid out like elf.tin: Tin's own _start, no
// interpreter, no dynamic section and no C library (#125).
//
// Layout (vaddr == file offset, segments 4 KiB aligned):
//   R   : ELF header, program headers, function names, backtrace records
//   RX  : _start, the program's code, C strings, Tin strings
//   RW  : globals, function descriptors
const EX64_ALIGN = 4096
const EX64_START_STATIC = 35
const EX64_STUB_SIZE = 6

// x64_sym_hook resolves a symbol id from gen_x64's table for the encoder: string and
// constant addresses, globals, GOT slots and functions (imports resolve to their stubs).
// Before the linker has placed anything the tables are empty and every address is 0,
// which is fine while x64_layout only measures instructions.
fn x64_sym_hook(id i64) i64 {
	let sym = x_syms[id]
	let kind = sym >> 32
	let i = sym & 0xffffffff
	if kind == SK_STR {
		if cast(i64, lk_strs) == 0 {
			return 0
		}
		return lk_strs[i]
	}
	if kind == SK_VAR {
		return lk_data + 8 * i
	}
	if kind == SK_TSTR {
		if cast(i64, lk_tstrs) == 0 {
			return 0
		}
		return lk_tstrs[i]
	}
	if kind == SK_FN {
		let f = prog_fns[i]
		if f.extern_ != 0 {
			return lk_stubs + EX64_STUB_SIZE * f.got
		}
		return f.addr
	}
	if kind == SK_BTRACE {
		return lk_btrace
	}
	if kind == SK_IMAGE {
		return 0
	}
	if kind == SK_ZERO {
		return lk_zero
	}
	if kind == SK_FNDESC {
		return lk_fndescs + 16 * i
	}
	return lk_got + 8 * i
}

// ex64_start_static writes the static _start at p (address at): main(argc, argv, envp) from
// the kernel's initial stack with rbp cleared and rsp aligned, then exit_group (231).
fn ex64_start_static(p i64, at i64, main_addr i64) {
	let code = "31ed488b3c24488d742408488d54fe084883e4f0e800000000"
	mut i = 0
	for 2 * i < len(code) {
		store8(p + i, num_digit(i64(code[2 * i])) * 16 + num_digit(i64(code[2 * i + 1])))
		i = i + 1
	}
	put32(p + 21, main_addr - (at + 25))
	store8(p + 25, 0x89)
	store8(p + 26, 0xc7)
	store8(p + 27, 0xb8)
	put32(p + 28, 231)
	store8(p + 32, 0x0f)
	store8(p + 33, 0x05)
	store8(p + 34, 0xf4)
}

fn write_elf_x64(path str) {
	let nvars = len(prog_vars)
	el_check_static()
	lk_imports = cast([]Fn, []i64{})
	lk_strs = cast([]i64, 0)
	lk_tstrs = cast([]i64, 0)
	lk_stubs = 0
	lk_zero = 0
	lk_got = 0
	lk_data = 0

	// Function names (tin.<name>) and, after them, one backtrace record per function:
	// [start, end, name offset] (the runtime's symbol table).
	let dstr = buf_new()
	buf_byte(dstr, 0)
	let name_off = []i64{}
	let own = []Fn{}
	mut i = 0
	for i < len(prog_fns) {
		let f = prog_fns[i]
		if f.extern_ == 0 && f.reach != 0 {
			own = append(own, cast(Fn, f))
			name_off = append(name_off, len(dstr))
			buf_str(dstr, "tin.")
			buf_str(dstr, f.qname)
			buf_byte(dstr, 0)
		}
		i = i + 1
	}

	// Read-only segment: headers, names, backtrace records.
	let ph_off = 64
	let phnum = 5
	let dynstr_off = ph_off + 56 * phnum
	lk_btrace = align_up(dynstr_off + len(dstr), 8)
	let ro_end = lk_btrace + 8 + 24 * len(cast([]i64, own))

	// Text segment: _start, code (laid out and relaxed first), strings, constants.
	let text_addr = align_up(ro_end, EX64_ALIGN)
	let start_addr = text_addr
	let code_addr = align_up(text_addr + EX64_START_STATIC, 16)
	x64_syms = cast([]i64, 0)
	x64_relocs = cast([]i64, 0)
	let code_size = x64_layout(cast([]i64, code), code_addr)
	i = 0
	for i < len(cast([]i64, own)) {
		let f = own[i]
		f.addr = x64_label_addr(x_fn_labels[f.index])
		i = i + 1
	}
	mut pc = code_addr + code_size
	lk_stubs = pc // the end of the code: there are no import stubs
	lk_strs = []i64{}
	i = 0
	for i < len(g_str_ptrs) {
		lk_strs = append(lk_strs, pc)
		pc = pc + g_str_lens[i] + 1
		i = i + 1
	}
	pc = align_up(pc, 8)
	lk_zero = pc
	pc = pc + 32
	lk_tstrs = []i64{}
	i = 0
	for i < len(g_tstr_ptrs) {
		lk_tstrs = append(lk_tstrs, pc)
		pc = align_up(pc + 8 + g_tstr_lens[i] + 1, 8)
		i = i + 1
	}
	let text_end = pc

	// Data segment: globals, then function descriptors.
	let data_addr = align_up(text_end, EX64_ALIGN)
	lk_got = data_addr
	lk_data = data_addr
	lk_fndescs = lk_data + 8 * nvars
	let data_end = lk_fndescs + 16 * len(prog_fns) + 8
	let extra = el_extra(data_end, len(cast([]i64, own)))
	let file_size = data_end + extra
	let img = calloc(file_size, 1)

	// ELF header.
	store8(img, 0x7f)
	store8(img + 1, 'E')
	store8(img + 2, 'L')
	store8(img + 3, 'F')
	store8(img + 4, 2)
	store8(img + 5, 1)
	store8(img + 6, 1)
	put32(img + 16, 3 | (62 << 16))
	put32(img + 20, 1)
	put64(img + 24, start_addr)
	put64(img + 32, ph_off)
	put64(img + 40, 0)
	put32(img + 48, 0)
	put32(img + 52, 64 | (56 << 16))
	put32(img + 56, phnum | (64 << 16))
	put32(img + 60, 0)

	// Program headers: PHDR, LOAD R, LOAD RX, LOAD RW, GNU_STACK.
	mut p = img + ph_off
	p = el_phdr(p, 6, 4, ph_off, ph_off, 56 * phnum, 56 * phnum, 8)
	p = el_phdr(p, 1, 4, 0, 0, ro_end, ro_end, EX64_ALIGN)
	p = el_phdr(p, 1, 5, text_addr, text_addr, text_end - text_addr, text_end - text_addr, EX64_ALIGN)
	p = el_phdr(p, 1, 6, data_addr, data_addr, data_end - data_addr, data_end - data_addr, EX64_ALIGN)
	p = el_phdr(p, 0x6474e551, 6, 0, 0, 0, 0, 16)

	memcpy(img + dynstr_off, slice_data(dstr), len(dstr))
	put64(img + lk_btrace, len(cast([]i64, own)))
	i = 0
	for i < len(cast([]i64, own)) {
		let f = own[i]
		mut end = lk_stubs
		if i + 1 < len(cast([]i64, own)) {
			end = own[i + 1].addr
		}
		let rec = img + lk_btrace + 8 + 24 * i
		put64(rec, f.addr)
		put64(rec + 8, end)
		put64(rec + 16, dynstr_off + name_off[i])
		i = i + 1
	}

	// _start, then the machine code.
	ex64_start_static(img + start_addr, start_addr, entry_fn().addr)
	if extra != 0 {
		let lay = []i64{}
		lay = append(lay, data_end)
		lay = append(lay, dynstr_off)
		lay = append(lay, len(dstr))
		lay = append(lay, text_addr)
		lay = append(lay, lk_stubs)
		lay = append(lay, text_end)
		lay = append(lay, data_addr)
		el_symbols(img, cast([]Fn, cast([]i64, own)), cast([]i64, name_off), cast([]i64, lay))
	}
	let out = buf_new()
	pc = code_addr
	i = 0
	for i < len(code) {
		pc = pc + x64_encode(slice_data(code) + 8 * i, pc, out)
		i = i + 5
	}
	if len(out) != code_size {
		link_fail("x86-64 code size changed between layout and encoding")
	}
	memcpy(img + code_addr, slice_data(out), len(out))

	i = 0
	for i < len(g_str_ptrs) {
		memcpy(img + lk_strs[i], rt_cstr(g_str_ptrs[i]), g_str_lens[i])
		i = i + 1
	}
	i = 0
	for i < len(g_tstr_ptrs) {
		let at = img + lk_tstrs[i]
		put64(at, g_tstr_lens[i])
		memcpy(at + 8, rt_cstr(g_tstr_ptrs[i]), g_tstr_lens[i])
		i = i + 1
	}
	i = 0
	for i < nvars {
		put64(img + lk_data + 8 * i, prog_vars[i].val)
		i = i + 1
	}

	host_unlink(path)
	let fd = host_creat(path, 493)
	if (fd & 0x80000000) != 0 {
		let e = cast([]i64, err_code(NO_POS, "E904 CANNOT_CREATE"))
		buf_str(cast([]u8, e), "cannot create ")
		buf_str(cast([]u8, e), path)
		fatal(cast([]u8, e))
	}
	let wh = cast(SliceHdr, malloc(24))
	wh.len = file_size
	wh.cap = file_size
	wh.data = img
	write_all(fd, cast([]u8, wh))
	rt_sys_close(fd)
}
