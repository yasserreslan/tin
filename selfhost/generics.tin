// Generics by monomorphization: each use of a generic function or type with new type
// arguments re-parses the declaration's tokens and checks the copy with the type
// parameters bound, so every instance is ordinary, fully specialized code.

var ck_tbind;       // vec of [name, type]: type parameters in scope
var ty_generics;    // vec of [qualified name, decl] for generic types
var gen_pending;    // [method template, type args] waiting for functions to be declared
var ck_decl_done;

fn tbind_lookup(name) {
    if !ck_tbind {
        return 0;
    }
    let i = 0;
    while i < ck_tbind[VEC_LEN] {
        let p = vec_get(ck_tbind, i);
        if streq(vec_get(p, 0), name) {
            return vec_get(p, 1);
        }
        i = i + 1;
    }
    return 0;
}

fn tbind_pairs(names, types) {
    let v = vec_new();
    let i = 0;
    while i < names[VEC_LEN] {
        vec_push(v, pair(vec_get(names, i), vec_get(types, i)));
        i = i + 1;
    }
    return v;
}

fn same_types(a, b) {
    if a[VEC_LEN] != b[VEC_LEN] {
        return 0;
    }
    let i = 0;
    while i < a[VEC_LEN] {
        if vec_get(a, i) != vec_get(b, i) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

// targs_name appends "[T1,T2]" to b.
fn targs_name(b, targs) {
    buf_byte(b, '[');
    let i = 0;
    while i < targs[VEC_LEN] {
        if i > 0 {
            buf_byte(b, ',');
        }
        type_name(b, vec_get(targs, i));
        i = i + 1;
    }
    buf_byte(b, ']');
}

// generics_init registers generic types and gives them their method templates.
fn generics_init() {
    ty_generics = vec_new();
    gen_pending = vec_new();
    ck_decl_done = 0;
    let i = 0;
    while i < prog_types[VEC_LEN] {
        let d = vec_get(prog_types, i);
        if d[D_TPARAMS] {
            set_file(d[D_FILE]);
            d[D_INSTS] = vec_new();
            d[D_METHODS] = vec_new();
            vec_push(ty_generics, pair(qual(ck_pkg, d[D_NAME]), d));
        }
        i = i + 1;
    }
    i = 0;
    while i < prog_fns[VEC_LEN] {
        let f = vec_get(prog_fns, i);
        let rx = f[F_RECV];
        if rx && rx[N_KIND] == TX_NAME && rx[TX_ARGS] {
            set_file(f[F_FILE]);
            let d = find_generic(qual(ck_pkg, rx[TX_B]));
            if !d {
                err_quoted(f[F_POS], "", rx[TX_B], " is not a generic type");
            } else {
                vec_push(d[D_METHODS], f);
            }
        }
        i = i + 1;
    }
}

fn find_generic(qname) {
    let i = 0;
    while i < ty_generics[VEC_LEN] {
        let p = vec_get(ty_generics, i);
        if streq(vec_get(p, 0), qname) {
            return vec_get(p, 1);
        }
        i = i + 1;
    }
    return 0;
}

fn is_template(f) {
    return f[F_TPARAMS] && !f[F_TBIND];
}

// generic_type_ref resolves Name[T...] in the current file.
fn generic_type_ref(tx) {
    let d = 0;
    if tx[TX_A] {
        let pkg = import_pkg(tx[TX_A]);
        if pkg {
            d = find_generic(str_cat3(pkg, ".", tx[TX_B]));
        }
    } else {
        if load8(ck_pkg) != 0 {
            d = find_generic(qual(ck_pkg, tx[TX_B]));
        }
        if !d {
            d = find_generic(tx[TX_B]);
        }
    }
    if !d {
        err_quoted(tx[N_POS], "", tx[TX_B], " is not a generic type");
        return ty_int;
    }
    let targs = resolve_types(tx[TX_ARGS]);
    if targs[VEC_LEN] != d[D_TPARAMS][VEC_LEN] {
        err_quoted(tx[N_POS], "wrong number of type arguments for ", tx[TX_B], "");
        return ty_int;
    }
    return instantiate_type(d, targs, tx[N_POS]);
}

// Checker state an instantiation must not disturb.
fn ck_state_save() {
    let s = vec_new();
    vec_push(s, ck_file);
    vec_push(s, ck_legacy);
    vec_push(s, ck_fn);
    vec_push(s, ck_tbind);
    return s;
}

fn ck_state_restore(s) {
    set_file(vec_get(s, 0));
    ck_legacy = vec_get(s, 1);
    ck_fn = vec_get(s, 2);
    ck_tbind = vec_get(s, 3);
}

fn check_constraints(pos, names, cons, targs, file) {
    let saved = ck_state_save();
    set_file(file);
    // A later constraint may mention an earlier parameter (`[T any, S Seq[T]]`), so the
    // type arguments in scope resolve while the constraints are checked.
    ck_tbind = tbind_pairs(names, targs);
    let i = 0;
    while i < names[VEC_LEN] {
        let c = vec_get(cons, i);
        if c {
            let t = vec_get(targs, i);
            let inst = 0;
            let handled = 0;
            let cx = vec_get(c, 0);
            if c[VEC_LEN] == 1 && cx[N_KIND] == TX_NAME {
                // A shape, with or without type arguments: Seq[i64] is an instance.
                inst = shape_inst(cx);
                // A name that is a shape but failed to instantiate was diagnosed there;
                // do not go on to read it as a union member.
                handled = shape_ref_name(cx) != 0;
            }
            if inst {
                check_shape(pos, t, vec_get(inst, 0), vec_get(inst, 1));
            } else if handled {
            } else {
                let ok = 0;
                let j = 0;
                while j < c[VEC_LEN] {
                    let mt = vec_get(c, j);
                    if shape_ref_name(mt) {
                        err_quoted(mt[N_POS], "", shape_member_name(mt), " is a shape: a union constraint lists concrete types, and a shape goes in the constraint alone");
                    } else if resolve_type(mt) == t {
                        ok = 1;
                    }
                    j = j + 1;
                }
                if !ok {
                    let m = err_begin(pos);
                    buf_str(m, "type ");
                    type_name(m, t);
                    buf_str(m, " does not satisfy the constraint of ");
                    buf_str(m, vec_get(names, i));
                    err_end(m);
                }
            }
        }
        i = i + 1;
    }
    ck_state_restore(saved);
}

fn instantiate_type(d, targs, pos) {
    let i = 0;
    while i < d[D_INSTS][VEC_LEN] {
        let inst = vec_get(d[D_INSTS], i);
        if same_types(vec_get(inst, 0), targs) {
            return vec_get(inst, 1);
        }
        i = i + 1;
    }
    check_constraints(pos, d[D_TPARAMS], d[D_TCONS], targs, d[D_FILE]);
    let saved = ck_state_save();
    set_file(d[D_FILE]);
    let nb = buf_new();
    buf_str(nb, qual(ck_pkg, d[D_NAME]));
    targs_name(nb, targs);
    buf_byte(nb, 0);
    let name = nb[VEC_DATA];
    let t = 0;
    if d[D_TYPE][N_KIND] == TX_STRUCT {
        t = ty_new(K_STRUCT, name);
        t[TY_TARGS] = targs;
        t[TY_GDECL] = d;
        name_type(name, t);
        vec_push(d[D_INSTS], pair(targs, t));
        ck_tbind = tbind_pairs(d[D_TPARAMS], targs);
        resolve_fields(t, d[D_TYPE]);
        layout_struct(t);
    } else {
        ck_tbind = tbind_pairs(d[D_TPARAMS], targs);
        t = resolve_type(d[D_TYPE]);
        vec_push(d[D_INSTS], pair(targs, t));
    }
    ck_state_restore(saved);
    let m = 0;
    while m < d[D_METHODS][VEC_LEN] {
        let tmpl = vec_get(d[D_METHODS], m);
        if ck_decl_done {
            instantiate_fn(tmpl, targs, pos);
        } else {
            vec_push(gen_pending, pair(tmpl, targs));
        }
        m = m + 1;
    }
    return t;
}

// generics_declared runs once every ordinary function is declared.
fn generics_declared() {
    ck_decl_done = 1;
    let i = 0;
    while i < gen_pending[VEC_LEN] {
        let p = vec_get(gen_pending, i);
        instantiate_fn(vec_get(p, 0), vec_get(p, 1), 0);
        i = i + 1;
    }
}

// instantiate_fn returns the instance of template g for targs, declaring it on first use;
// the main check loop checks its body later like any function's.
fn instantiate_fn(g, targs, pos) {
    if !g[F_INSTS] {
        g[F_INSTS] = vec_new();
    }
    let i = 0;
    while i < g[F_INSTS][VEC_LEN] {
        let inst = vec_get(g[F_INSTS], i);
        if same_types(vec_get(inst, 0), targs) {
            return vec_get(inst, 1);
        }
        i = i + 1;
    }
    if targs[VEC_LEN] != g[F_TPARAMS][VEC_LEN] {
        err_quoted(pos, "wrong number of type arguments for ", g[F_NAME], "");
        return g;
    }
    check_constraints(pos, g[F_TPARAMS], g[F_TCONS], targs, g[F_FILE]);
    let st_toks = p_toks;
    let st_i = p_i;
    let st_nolit = p_nolit;
    let st_legacy = p_legacy;
    let st_file = cur_file;
    p_toks = g[F_TOKS];
    p_i = g[F_TOKAT];
    p_nolit = 0;
    p_legacy = 0;
    cur_file = g[F_FILE];
    let nf = parse_fn(0, 0);
    p_toks = st_toks;
    p_i = st_i;
    p_nolit = st_nolit;
    p_legacy = st_legacy;
    cur_file = st_file;
    nf[F_TPARAMS] = g[F_TPARAMS];
    nf[F_TBIND] = tbind_pairs(g[F_TPARAMS], targs);
    nf[F_GENOF] = g;
    nf[F_FILE] = g[F_FILE];
    if !nf[F_RECV] {
        let nb = buf_new();
        buf_str(nb, nf[F_NAME]);
        targs_name(nb, targs);
        buf_byte(nb, 0);
        nf[F_NAME] = nb[VEC_DATA];
    }
    vec_push(g[F_INSTS], pair(targs, nf));
    vec_push(prog_fns, nf);
    let saved = ck_state_save();
    ck_tbind = nf[F_TBIND];
    declare_fn(nf);
    ck_state_restore(saved);
    return nf;
}

// unify binds g's type parameters by matching type expression tx against type t.
fn tunify(g, binds, tx, t, untyped_ok) {
    if !tx || !t {
        return;
    }
    let k = tx[N_KIND];
    if k == TX_NAME && !tx[TX_A] && !tx[TX_ARGS] {
        let i = 0;
        while i < g[F_TPARAMS][VEC_LEN] {
            if streq(vec_get(g[F_TPARAMS], i), tx[TX_B]) {
                if is_untyped(t) {
                    if untyped_ok && !vec_get(binds, i) {
                        binds[VEC_DATA][i] = default_type(t);
                    }
                } else if !vec_get(binds, i) {
                    binds[VEC_DATA][i] = t;
                }
                return;
            }
            i = i + 1;
        }
        return;
    }
    let tk = kind_of(t);
    if k == TX_SLICE && tk == K_SLICE {
        tunify(g, binds, tx[TX_A], t[TY_ELEM], untyped_ok);
    } else if k == TX_OPT && tk == K_OPT {
        tunify(g, binds, tx[TX_A], t[TY_ELEM], untyped_ok);
    } else if k == TX_MAP && tk == K_MAP {
        tunify(g, binds, tx[TX_A], t[TY_KEY], untyped_ok);
        tunify(g, binds, tx[TX_B], t[TY_ELEM], untyped_ok);
    } else if k == TX_FUNC && tk == K_FUNC {
        let ps = tx[TX_A];
        let rs = tx[TX_B];
        let j = 0;
        while ps && j < ps[VEC_LEN] && j < t[TY_FIELDS][VEC_LEN] {
            tunify(g, binds, vec_get(ps, j), vec_get(t[TY_FIELDS], j), untyped_ok);
            j = j + 1;
        }
        j = 0;
        while rs && j < rs[VEC_LEN] && j < t[TY_RESULTS][VEC_LEN] {
            tunify(g, binds, vec_get(rs, j), vec_get(t[TY_RESULTS], j), untyped_ok);
            j = j + 1;
        }
    } else if k == TX_NAME && tx[TX_ARGS] && t[TY_TARGS] {
        let j2 = 0;
        while j2 < tx[TX_ARGS][VEC_LEN] && j2 < t[TY_TARGS][VEC_LEN] {
            tunify(g, binds, vec_get(tx[TX_ARGS], j2), vec_get(t[TY_TARGS], j2), untyped_ok);
            j2 = j2 + 1;
        }
    }
}

// generic_call checks call e of template g: arguments first, then the inferred instance.
fn generic_call(e, g) {
    let args = e[CALL_ARGS];
    let atypes = vec_new();
    let i = 0;
    while i < args[VEC_LEN] {
        let a = vec_get(args, i);
        if a[N_KIND] == EX_MUTARG {
            // Infer from x in `mut x`; chk_args checks the mark after instantiation.
            a = a[MUTARG_X];
        }
        let at = chk(a, 0);
        check_value(a[N_POS], at);
        vec_push(atypes, at);
        i = i + 1;
    }
    let np = g[F_PTYPES][VEC_LEN];
    if args[VEC_LEN] != np {
        let m = err_begin(e[N_POS]);
        buf_str(m, g[F_NAME]);
        buf_str(m, " expects ");
        buf_int(m, np);
        buf_str(m, " arguments, got ");
        buf_int(m, args[VEC_LEN]);
        err_end(m);
        return ty_int;
    }
    let binds = vec_filled(g[F_TPARAMS][VEC_LEN], 0);
    let pass = 0;
    while pass < 2 {
        i = 0;
        while i < np {
            tunify(g, binds, vec_get(g[F_PTYPES], i), vec_get(atypes, i), pass);
            i = i + 1;
        }
        pass = pass + 1;
    }
    i = 0;
    while i < binds[VEC_LEN] {
        if !vec_get(binds, i) {
            err_quoted(e[N_POS], "cannot infer type parameter ", vec_get(g[F_TPARAMS], i), " (give it explicitly: F[T](...))");
            return ty_int;
        }
        i = i + 1;
    }
    let inst = instantiate_fn(g, binds, e[N_POS]);
    e[CALL_FN] = inst;
    e[CALL_CALLEE] = 0;
    e[CALL_NAME] = inst[F_QNAME];
    let ptypes = inst[F_PTYPES];
    let mask = mut_mask(inst[F_MUTS]);
    i = 0;
    while i < args[VEC_LEN] {
        let a = vec_get(args, i);
        let marked = unwrap_mut(a);
        if !ck_legacy && !(i == 0 && e[CALL_METHOD]) {
            let pm = i < 63 && (mask & (1 << i)) != 0;
            if pm && !marked {
                mut_arg_error(e, a, i, "is a mut parameter: write mut before the argument");
            } else if marked && !pm {
                mut_arg_error(e, a, i, "is not a mut parameter: remove mut");
            }
        }
        let want = vec_get(ptypes, i);
        let at = vec_get(atypes, i);
        check_assignable(a, at, want);
        if is_untyped(at) {
            reconvert(a, want);
        }
        i = i + 1;
    }
    return result_type(inst);
}

// expr_to_tx turns an expression that names a type (from X[A, B] or T[A]{...}) into a type expr.
fn expr_to_tx(e) {
    let k = e[N_KIND];
    if k == EX_TYPE {
        return e[TYX];
    }
    if k == EX_IDENT {
        let n = node_new(TX_NAME, e[N_POS]);
        n[TX_B] = e[ID_NAME];
        return n;
    }
    if k == EX_SELECT && e[SEL_X][N_KIND] == EX_IDENT {
        let n2 = node_new(TX_NAME, e[N_POS]);
        n2[TX_A] = e[SEL_X][ID_NAME];
        n2[TX_B] = e[SEL_NAME];
        return n2;
    }
    if k == EX_INDEX {
        let base = expr_to_tx(e[IX_X]);
        if !base || base[N_KIND] != TX_NAME {
            return 0;
        }
        base[TX_ARGS] = index_targs(e);
        return base;
    }
    return 0;
}

// index_targs is the type expression list of X[A, B].
fn index_targs(e) {
    let out = vec_new();
    let list = e[IX_ARGS];
    if !list {
        list = vec_new();
        vec_push(list, e[IX_I]);
    }
    let i = 0;
    while i < list[VEC_LEN] {
        let tx = expr_to_tx(vec_get(list, i));
        if !tx {
            err_at(vec_get(list, i)[N_POS], "expected a type argument");
            tx = node_new(TX_NAME, e[N_POS]);
            tx[TX_B] = "i64";
        }
        vec_push(out, tx);
        i = i + 1;
    }
    return out;
}

// explicit_generic returns the template a callee like F[T] or pkg.F[T] names, or 0.
fn explicit_generic(callee) {
    if callee[N_KIND] != EX_INDEX {
        return 0;
    }
    let x = callee[IX_X];
    if x[N_KIND] == EX_IDENT {
        if lookup_name_local(x[ID_NAME]) {
            return 0;
        }
        let s = lookup_name(x[ID_NAME]);
        if s && s[S_KIND] == SYM_FUNC && is_template(s[S_FN]) {
            return s[S_FN];
        }
        return 0;
    }
    if x[N_KIND] == EX_SELECT && x[SEL_X][N_KIND] == EX_IDENT && !lookup_name_local(x[SEL_X][ID_NAME]) {
        let pkg = import_pkg(x[SEL_X][ID_NAME]);
        if pkg {
            let s2 = pkg_member(pkg, x[SEL_NAME]);
            if s2 && s2[S_KIND] == SYM_FUNC && is_template(s2[S_FN]) {
                return s2[S_FN];
            }
        }
    }
    return 0;
}

// ---- shapes (#141) ----
//
// A shape is a set of method signatures. A type satisfies it structurally (no impl
// declaration), so satisfaction is checked where a shape is used as a type-parameter
// constraint: the type argument is concrete by then, and a call through the parameter
// is already a direct call on it. `dyn` and generic shapes are later steps; both get a
// diagnostic naming what is missing instead of being misread as ordinary types.

var ty_shapes;    // vec of [qualified name, shape decl], like ty_named for types
var sm_bind;      // bindings that resolve the candidate method's signature
var sm_declared;  // 1 when the candidate method has been declared (receiver prepended)
var shape_cycles; // shapes already reported in a composition cycle
var shape_validated; // shapes whose body has been validated (memo: composition is a DAG)
var shape_checking;  // shapes on the current satisfaction path (a cycle guard)
var shape_checked;   // shapes already checked in the current satisfaction tree
var shape_bad;       // shapes whose signature did not resolve (reported once)
var shape_collecting; // (shape, bindings) pairs collected in the current flattening
var shape_conflicts;  // errors the current flattening attributed to the owner shape
var shape_placeholders; // the fresh types shape_sym_bind made for symbolic validation

fn shapes_init() {
    shape_placeholders = vec_new();
    ty_shapes = vec_new();
    shape_cycles = vec_new();
    shape_validated = vec_new();
    shape_checking = vec_new();
    shape_checked = vec_new();
    shape_bad = vec_new();
    shape_collecting = vec_new();
    shape_conflicts = 0;
    let i = 0;
    while i < prog_shapes[VEC_LEN] {
        let d = vec_get(prog_shapes, i);
        set_file(d[D_FILE]);
        let q = qual(ck_pkg, d[D_NAME]);
        if find_shape(q) {
            err_quoted(d[D_POS], "", d[D_NAME], " is declared as a shape twice");
        } else {
            vec_push(ty_shapes, pair(q, d));
        }
        i = i + 1;
    }
    i = 0;
    while i < prog_shapes[VEC_LEN] {
        let d = vec_get(prog_shapes, i);
        if !shape_on_path(shape_cycles, d) {
            check_shape_decl(d, vec_new());
        }
        i = i + 1;
    }
}

fn find_shape(qname) {
    let i = ty_shapes[VEC_LEN] - 1;
    while i >= 0 {
        let rec = vec_get(ty_shapes, i);
        if streq(vec_get(rec, 0), qname) {
            return vec_get(rec, 1);
        }
        i = i - 1;
    }
    return 0;
}

// shapes_declared resolves every non-generic shape's signatures (and a named union's
// members) once the named types exist, so an unused shape still reports a `dyn` it
// cannot carry or a type that does not exist, instead of hiding it until first use. A
// shapes_declared resolves every shape's signatures (and a named union's members) once
// the named types exist, so an unused shape still reports a `dyn` it cannot carry or a
// type that does not exist, instead of hiding it until first use. A generic shape is
// validated with its parameters bound to fresh types, which catches a conflict or a
// `dyn` that does not depend on the instantiation. A shape whose types failed is
// remembered so satisfaction does not report them again.
fn shapes_declared() {
    let i = 0;
    while i < prog_shapes[VEC_LEN] {
        let d = vec_get(prog_shapes, i);
        if !shape_on_path(shape_bad, d) {
            let saved = ck_state_save();
            set_file(d[D_FILE]);
            let bind = 0;
            if d[D_TPARAMS] {
                bind = shape_sym_bind(d);
            }
            ck_tbind = bind;
            let before = error_count;
            let j = 0;
            if d[D_UNIONKIND] {
                // A member that names a shape was reported by check_shape_decl; resolving
                // it here would add a second, less useful message. The union is bad either
                // way, so satisfaction skips it.
                let bad = 0;
                while j < d[D_UNION][VEC_LEN] {
                    let m = vec_get(d[D_UNION], j);
                    if shape_ref_name(m) {
                        bad = 1;
                    } else {
                        resolve_type(m);
                    }
                    j = j + 1;
                }
                if error_count != before || bad {
                    if !shape_on_path(shape_bad, d) {
                        vec_push(shape_bad, d);
                    }
                }
            } else {
                while j < d[D_SHAPE][VEC_LEN] {
                    let m = vec_get(d[D_SHAPE], j);
                    let k = 0;
                    while k < m[F_PTYPES][VEC_LEN] {
                        resolve_type(vec_get(m[F_PTYPES], k));
                        k = k + 1;
                    }
                    k = 0;
                    while k < m[F_RTYPES][VEC_LEN] {
                        resolve_type(vec_get(m[F_RTYPES], k));
                        k = k + 1;
                    }
                    j = j + 1;
                }
                if error_count != before {
                    // d's own signature is what failed; conflicts are checked for the
                    // shapes that are still sound.
                    if !shape_on_path(shape_bad, d) {
                        vec_push(shape_bad, d);
                    }
                } else {
                    // A conflict or a duplicate is d's; a listed shape's signature
                    // failure was attributed to that shape by shape_collect.
                    if check_shape_conflicts(d, bind) > 0 && !shape_on_path(shape_bad, d) {
                        vec_push(shape_bad, d);
                    }
                }
            }
            ck_state_restore(saved);
        }
        i = i + 1;
    }
}

// shape_ref_name resolves a name (qualified or not) to a shape in scope, or 0. An
// unqualified name resolves in the current package only: a package's own type must not
// be shadowed by a shape of the same name in main, so there is no cross-package fallback.
fn shape_ref_name(tx) {
    if tx[TX_A] {
        let pkg = import_pkg(tx[TX_A]);
        if pkg {
            return find_shape(str_cat3(pkg, ".", tx[TX_B]));
        }
        return 0;
    }
    if load8(ck_pkg) != 0 {
        return find_shape(qual(ck_pkg, tx[TX_B]));
    }
    return find_shape(tx[TX_B]);
}

// shape_inst resolves a shape reference, with or without type arguments, to a vec of
// [decl, bindings]; bindings is 0 for a non-generic shape. Type arguments are resolved
// and the shape's own parameter constraints are checked, so `Seq[i64]` is an instance
// and `Seq` alone is an error. Returns 0 when the name is not a shape.
fn shape_inst(tx) {
    let d = shape_ref_name(tx);
    if !d {
        return 0;
    }
    if !d[D_TPARAMS] {
        if tx[TX_ARGS] {
            err_quoted(tx[N_POS], "shape ", tx[TX_B], " takes no type arguments");
            return 0;
        }
        return pair(d, 0);
    }
    if !tx[TX_ARGS] {
        let e = err_begin(tx[N_POS]);
        buf_str(e, "shape ");
        buf_str(e, tx[TX_B]);
        buf_str(e, " needs type arguments, like ");
        buf_str(e, tx[TX_B]);
        buf_str(e, "[...]");
        err_end(e);
        return 0;
    }
    if tx[TX_ARGS][VEC_LEN] != d[D_TPARAMS][VEC_LEN] {
        let e = err_begin(tx[N_POS]);
        buf_str(e, "wrong number of type arguments for shape ");
        buf_str(e, tx[TX_B]);
        buf_str(e, ": it takes ");
        buf_int(e, d[D_TPARAMS][VEC_LEN]);
        err_end(e);
        return 0;
    }
    let before = error_count;
    let targs = resolve_types(tx[TX_ARGS]);
    if error_count != before {
        // A type argument that did not resolve was reported; bindings built from the
        // fallback types would only add misleading errors.
        return 0;
    }
    let before_cons = error_count;
    check_constraints(tx[N_POS], d[D_TPARAMS], d[D_TCONS], targs, d[D_FILE]);
    if error_count != before_cons {
        // The arguments were reported; a pair built from them would only cause the same
        // error again at use.
        return 0;
    }
    return pair(d, tbind_pairs(d[D_TPARAMS], targs));
}

// shape_inst_decl is shape_inst for declaration validation: it checks the name and the
// arity but not the type arguments' constraints, which a symbolic parameter cannot meet.
fn shape_inst_decl(tx) {
    let d = shape_ref_name(tx);
    if !d {
        return 0;
    }
    if !d[D_TPARAMS] {
        if tx[TX_ARGS] {
            err_quoted(tx[N_POS], "shape ", tx[TX_B], " takes no type arguments");
            return 0;
        }
        return pair(d, 0);
    }
    if !tx[TX_ARGS] {
        let e = err_begin(tx[N_POS]);
        buf_str(e, "shape ");
        buf_str(e, tx[TX_B]);
        buf_str(e, " needs type arguments, like ");
        buf_str(e, tx[TX_B]);
        buf_str(e, "[...]");
        err_end(e);
        return 0;
    }
    if tx[TX_ARGS][VEC_LEN] != d[D_TPARAMS][VEC_LEN] {
        let e = err_begin(tx[N_POS]);
        buf_str(e, "wrong number of type arguments for shape ");
        buf_str(e, tx[TX_B]);
        buf_str(e, ": it takes ");
        buf_int(e, d[D_TPARAMS][VEC_LEN]);
        err_end(e);
        return 0;
    }
    return pair(d, 0);
}

// shape_member_symbolic reports whether any type argument of a listed member is one of
// the enclosing shape's parameters bound to a symbolic type, which is what makes an
// instance's own argument constraints impossible to check at declaration. A concrete
// argument (`shape G[T any] { A[f64] }`) and a parameter already bound to a real type
// (`shape C[V any] { A[V] }` used with `C[f64]`) are checked.
fn shape_member_symbolic(m, sd, bind) {
    if !m[TX_ARGS] || !bind {
        return 0;
    }
    let i = 0;
    while i < m[TX_ARGS][VEC_LEN] {
        let arg = vec_get(m[TX_ARGS], i);
        let j = 0;
        while j < sd[D_TPARAMS][VEC_LEN] {
            let name = vec_get(sd[D_TPARAMS], j);
            let one = vec_new();
            vec_push(one, name);
            if shape_tx_mentions(arg, one) {
                let value = shape_bind_value(bind, name);
                if value && shape_on_path(shape_placeholders, value) {
                    return 1;
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return 0;
}

fn shape_bind_value(bind, name) {
    let i = 0;
    while i < bind[VEC_LEN] {
        let p = vec_get(bind, i);
        if streq(vec_get(p, 0), name) {
            return vec_get(p, 1);
        }
        i = i + 1;
    }
    return 0;
}

fn shape_tx_mentions(tx, names) {
    if !tx {
        return 0;
    }
    let k = tx[N_KIND];
    if k == TX_NAME {
        let i = 0;
        while i < names[VEC_LEN] {
            if !tx[TX_A] && streq(tx[TX_B], vec_get(names, i)) {
                return 1;
            }
            i = i + 1;
        }
        let j = 0;
        while tx[TX_ARGS] && j < tx[TX_ARGS][VEC_LEN] {
            if shape_tx_mentions(vec_get(tx[TX_ARGS], j), names) {
                return 1;
            }
            j = j + 1;
        }
        return 0;
    }
    if k == TX_SLICE || k == TX_ARRAY {
        return shape_tx_mentions(tx[TX_A + (k == TX_ARRAY)], names);
    }
    if k == TX_MAP {
        return shape_tx_mentions(tx[TX_A], names) || shape_tx_mentions(tx[TX_B], names);
    }
    if k == TX_OPT || k == TX_PTR || k == TX_CHAN {
        return shape_tx_mentions(tx[TX_A], names);
    }
    if k == TX_FUNC {
        return shape_tx_list_mentions(tx[TX_A], names) || shape_tx_list_mentions(tx[TX_B], names);
    }
    if k == TX_STRUCT {
        let fields = tx[TX_A];
        let i = 0;
        while fields && i < fields[VEC_LEN] {
            if shape_tx_mentions(vec_get(vec_get(fields, i), 1), names) {
                return 1;
            }
            i = i + 1;
        }
        return 0;
    }
    return 0;
}

fn shape_tx_list_mentions(list, names) {
    let i = 0;
    while list && i < list[VEC_LEN] {
        if shape_tx_mentions(vec_get(list, i), names) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}
// shape_sym_bind binds each of a generic shape's parameters to a fresh struct type of its
// own, so a body can be validated at declaration: `shape B[U] { A[U] }` resolves U to B's
// parameter and two mentions of it compare equal, while `A[T]` against `B.M() i64` are
// different types and a conflict is reported. The fresh types are compared by identity
// only; nothing is named after them. A struct keeps `?T` well formed, as T must be a
// reference for that to be legal at an instantiation.
fn shape_sym_bind(d) {
    let bind = vec_new();
    let i = 0;
    while i < d[D_TPARAMS][VEC_LEN] {
        let ph = ty_new(K_STRUCT, vec_get(d[D_TPARAMS], i));
        // A struct with no fields, not a null one: key_valid walks a map key's fields.
        ph[TY_FIELDS] = vec_new();
        vec_push(shape_placeholders, ph);
        vec_push(bind, pair(vec_get(d[D_TPARAMS], i), ph));
        i = i + 1;
    }
    return bind;
}

// shape_inst_soft resolves a listed instance for declaration validation: it checks the
// name and the arity, binds the arguments, but does not check their constraints, because
// a symbolic parameter cannot satisfy a union or a shape. The constraints are checked
// again at every real instantiation.
fn shape_inst_soft(tx) {
    let d = shape_ref_name(tx);
    if !d {
        return 0;
    }
    if !d[D_TPARAMS] {
        if tx[TX_ARGS] {
            err_quoted(tx[N_POS], "shape ", tx[TX_B], " takes no type arguments");
            return 0;
        }
        return pair(d, 0);
    }
    if !tx[TX_ARGS] {
        let e = err_begin(tx[N_POS]);
        buf_str(e, "shape ");
        buf_str(e, tx[TX_B]);
        buf_str(e, " needs type arguments, like ");
        buf_str(e, tx[TX_B]);
        buf_str(e, "[...]");
        err_end(e);
        return 0;
    }
    if tx[TX_ARGS][VEC_LEN] != d[D_TPARAMS][VEC_LEN] {
        let e = err_begin(tx[N_POS]);
        buf_str(e, "wrong number of type arguments for shape ");
        buf_str(e, tx[TX_B]);
        buf_str(e, ": it takes ");
        buf_int(e, d[D_TPARAMS][VEC_LEN]);
        err_end(e);
        return 0;
    }
    let before = error_count;
    let targs = resolve_types(tx[TX_ARGS]);
    if error_count != before {
        return 0;
    }
    return pair(d, tbind_pairs(d[D_TPARAMS], targs));
}

// shape_collect_visited reports whether (shape, bindings) has been collected in the
// current flattening, so a diamond is walked once and a generic instance is not confused
// with another instance of the same shape.
fn shape_collect_visited(sd, bind) {
    let i = 0;
    while i < shape_collecting[VEC_LEN] {
        let p = vec_get(shape_collecting, i);
        if vec_get(p, 0) == sd && shape_bind_same(vec_get(p, 1), bind) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn shape_bind_same(a, b) {
    if !a || !b {
        return a == b;
    }
    if a[VEC_LEN] != b[VEC_LEN] {
        return 0;
    }
    let i = 0;
    while i < a[VEC_LEN] {
        if vec_get(vec_get(a, i), 1) != vec_get(vec_get(b, i), 1) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

// check_shape_conflicts flattens a shape's method set (its own methods and every listed
// shape's, with the instance's type arguments bound) and reports a name that two shapes
// give different signatures, or that one shape declares twice. Identical methods from
// different listed shapes are allowed, as in Go. It returns how many errors it attributed
// to the owner, so the caller can mark the owner bad without claiming a listed shape's.
fn check_shape_conflicts(d, bind) {
    shape_collecting = vec_new();
    shape_conflicts = 0;
    shape_collect(d, bind, vec_new(), d, vec_new());
    return shape_conflicts;
}

fn shape_collect(sd, bind, methods, owner, own) {
    if shape_on_path(shape_cycles, sd) || shape_collect_visited(sd, bind) || shape_on_path(shape_bad, sd) {
        return;
    }
    vec_push(shape_collecting, pair(sd, bind));
    let saved = ck_state_save();
    set_file(sd[D_FILE]);
    ck_tbind = bind;
    let i = 0;
    while i < sd[D_UNION][VEC_LEN] {
        let m = vec_get(sd[D_UNION], i);
        let base = shape_ref_name(m);
        // A member that check_shape_decl already rejected (a bare generic shape, a
        // non-generic one with arguments, a bad shape) is skipped so its error is not
        // reported once per listing.
        if base && !shape_on_path(shape_bad, base) && ((base[D_TPARAMS] && m[TX_ARGS]) || (!base[D_TPARAMS] && !m[TX_ARGS])) {
            // Under symbolic arguments the constraints cannot be checked here; with real
            // arguments (even inside a generic body) they can, and an error is sd's.
            let before_inst = error_count;
            let inst = 0;
            if shape_member_symbolic(m, sd, bind) {
                inst = shape_inst_soft(m);
            } else {
                inst = shape_inst(m);
            }
            if inst {
                shape_collect(vec_get(inst, 0), vec_get(inst, 1), methods, owner, vec_new());
            } else if error_count != before_inst && !shape_on_path(shape_bad, sd) {
                vec_push(shape_bad, sd);
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < sd[D_SHAPE][VEC_LEN] {
        let f = vec_get(sd[D_SHAPE], i);
        let before = error_count;
        let sig = shape_sig_of(f, 0, bind);
        if error_count != before {
            // The failing signature is sd's, not the owner's that listed it.
            if !shape_on_path(shape_bad, sd) {
                vec_push(shape_bad, sd);
            }
            ck_state_restore(saved);
            return;
        }
        if sd == owner {
            // The same shape declaring one name twice is an error even when the two
            // signatures are identical (a listed shape may repeat a method).
            let k = 0;
            while k < own[VEC_LEN] {
                if streq(vec_get(own, k), f[F_NAME]) {
                    let e0 = err_begin(f[F_POS]);
                    buf_str(e0, "shape ");
                    buf_str(e0, owner[D_NAME]);
                    buf_str(e0, " declares ");
                    buf_str(e0, f[F_NAME]);
                    buf_str(e0, " twice");
                    err_end(e0);
                    shape_conflicts = shape_conflicts + 1;
                }
                k = k + 1;
            }
            vec_push(own, f[F_NAME]);
        }
        let j = 0;
        while j < methods[VEC_LEN] {
            let prev = vec_get(methods, j);
            if streq(vec_get(prev, 0), f[F_NAME]) && !shape_sig_same(vec_get(prev, 1), sig) {
                let e = err_begin(f[F_POS]);
                buf_str(e, "shape ");
                buf_str(e, owner[D_NAME]);
                buf_str(e, " has two methods named ");
                buf_str(e, f[F_NAME]);
                buf_str(e, " with different signatures (one from a listed shape)");
                err_end(e);
                shape_conflicts = shape_conflicts + 1;
            }
            j = j + 1;
        }
        vec_push(methods, pair(f[F_NAME], sig));
        i = i + 1;
    }
    ck_state_restore(saved);
}

// check_shape_decl validates a registered shape: its body lists shapes only, its union
// lists types only, and the listed shapes do not form a cycle. path holds the shapes on
// the way down; a cycle is reported once, at the shape that closes it, and every shape
// in it is remembered so the walk over it does not recurse forever or report again.
// Each name is resolved in the file that declares the shape, and a validated shape is
// remembered, so a shared sub-shape is walked once and diamonds do not cost 2^depth.
// A generic shape's body is validated with its parameters bound to fresh types, so a
// listed instance may mention them (`shape B[U] { A[U] }`) and its own cycle is caught.
fn check_shape_decl(d, path) {
    if shape_on_path(shape_validated, d) {
        return;
    }
    let saved = ck_state_save();
    set_file(d[D_FILE]);
    vec_push(shape_validated, d);
    // Only an error about d's own members marks d bad; an error inside a listed shape is
    // that shape's, and marking d too would skip its own signature checks in
    // shapes_declared (and lose them).
    let mine = 0;
    let bind = 0;
    if d[D_TPARAMS] {
        bind = shape_sym_bind(d);
    }
    if d[D_UNIONKIND] {
        let i = 0;
        while i < d[D_UNION][VEC_LEN] {
            let m = vec_get(d[D_UNION], i);
            if shape_ref_name(m) {
                err_quoted(m[N_POS], "a named union lists concrete types, but ", shape_member_name(m), " is a shape: list shapes in a shape body instead");
                mine = 1;
            }
            i = i + 1;
        }
    } else {
        vec_push(path, d);
        ck_tbind = bind;
        let i = 0;
        while i < d[D_UNION][VEC_LEN] {
            let m = vec_get(d[D_UNION], i);
            let sub = shape_ref_name(m);
            if !sub {
                let nm = shape_member_name(m);
                if nm {
                    let e = err_begin(m[N_POS]);
                    buf_str(e, "shape ");
                    buf_str(e, d[D_NAME]);
                    buf_str(e, " lists ");
                    buf_str(e, nm);
                    buf_str(e, ", which is not a shape");
                    err_end(e);
                } else {
                    err_at(m[N_POS], "a shape lists another shape by name");
                }
                mine = 1;
            } else if shape_on_path(path, sub) {
                err_quoted(sub[D_POS], "shape ", sub[D_NAME], " is composed of itself (directly or through other shapes)");
                shape_mark_cycle(path, sub);
            } else {
                // Reports a missing type argument, a wrong count or extra arguments.
                let before_inst = error_count;
                let inst = shape_inst_decl(m);
                if inst {
                    check_shape_decl(sub, path);
                } else if error_count != before_inst {
                    mine = 1;
                }
            }
            i = i + 1;
        }
        ck_tbind = saved[3];
        path[VEC_LEN] = path[VEC_LEN] - 1;
    }
    if mine && !shape_on_path(shape_bad, d) {
        vec_push(shape_bad, d);
    }
    ck_state_restore(saved);
}

// shape_mark_cycle remembers the shapes from sub to the current top of path, the cycle
// itself, so no later walk reports them again.
fn shape_mark_cycle(path, sub) {
    let j = 0;
    let marking = 0;
    while j < path[VEC_LEN] {
        let on = vec_get(path, j);
        if on == sub {
            marking = 1;
        }
        if marking && !shape_on_path(shape_cycles, on) {
            vec_push(shape_cycles, on);
        }
        j = j + 1;
    }
}

// shape_member_name is a listed shape's name for diagnostics, or 0 when the member is
// not a plain or qualified name.
fn shape_member_name(m) {
    if m[N_KIND] != TX_NAME {
        return 0;
    }
    return m[TX_B];
}

fn shape_on_path(path, d) {
    let i = 0;
    while i < path[VEC_LEN] {
        if vec_get(path, i) == d {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// shape_seen reports whether the (shape, type, bindings) key is in a satisfaction set.
// The key matters: resolving a union member can check the same shape against a nested
// type while the outer check is in flight, and the outer type must not be suppressed by
// it; two instantiations of one shape are different keys.
fn shape_seen(v, sd, t, bind) {
    let i = 0;
    while i < v[VEC_LEN] {
        let p = vec_get(v, i);
        if vec_get(p, 0) == sd && vec_get(p, 1) == t && shape_bind_same(vec_get(p, 2), bind) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// shape_seen_type reports whether the (shape, type) part of a key is on the path, under
// any bindings.
fn shape_seen_type(v, sd, t) {
    let i = 0;
    while i < v[VEC_LEN] {
        let p = vec_get(v, i);
        if vec_get(p, 0) == sd && vec_get(p, 1) == t {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// shape_method returns the method t has under name, with the bindings that resolve its
// signature (sm_bind) and whether it is declared (sm_declared), or 0. A generic type's
// template is found through its declaration so satisfaction does not depend on the
// instance method having been declared already.
fn shape_method(t, name) {
    sm_bind = 0;
    sm_declared = 0;
    let d = t[TY_GDECL];
    if d {
        sm_bind = tbind_pairs(d[D_TPARAMS], t[TY_TARGS]);
        let i = 0;
        while i < d[D_METHODS][VEC_LEN] {
            let f = vec_get(d[D_METHODS], i);
            if streq(f[F_NAME], name) {
                return f;
            }
            i = i + 1;
        }
        return 0;
    }
    let f = find_fn(str_cat3(t[TY_NAME], ".", name));
    if f {
        sm_declared = 1;
        return f;
    }
    return find_method_by_recv(t, name);
}

// find_method_by_recv finds a method declared on t before declare_fn ran, as it has
// not when a type alias's instance is checked during type resolution. A generic
// method template is skipped: its receiver type mentions the type parameters, which
// have no bindings here (shape_method finds those through their declaration).
fn find_method_by_recv(t, name) {
    let i = 0;
    while i < prog_fns[VEC_LEN] {
        let f = vec_get(prog_fns, i);
        if f[F_RECV] && !f[F_TBIND] && !f[F_TPARAMS] && f[F_NAME] && streq(f[F_NAME], name) {
            let saved = ck_state_save();
            set_file(f[F_FILE]);
            let rt = resolve_type(f[F_RECV]);
            ck_state_restore(saved);
            if rt == t {
                return f;
            }
        }
        i = i + 1;
    }
    return 0;
}

// shape_sig_type resolves one signature type expression; a declared function's types
// are already resolved and are used as they are.
fn shape_sig_type(x, bind) {
    if x[N_KIND] < 40 {
        return x;
    }
    let saved = ck_tbind;
    ck_tbind = bind;
    let t = resolve_type(x);
    ck_tbind = saved;
    return t;
}

// shape_sig_of returns [param names, param types, param muts, result types, variadic,
// mut result, fault] for a method. A declared method's parameter zero is its receiver,
// which a shape's signature does not carry, so it is skipped; receiver mutability is
// not part of satisfaction, only the call site's `mut` mark is.
fn shape_sig_of(f, declared, bind) {
    let ns = vec_new();
    let ps = vec_new();
    let ms = vec_new();
    let i = 0;
    if declared {
        i = 1;
    }
    while i < f[F_PTYPES][VEC_LEN] {
        vec_push(ns, vec_get(f[F_PARAMS], i));
        vec_push(ps, shape_sig_type(vec_get(f[F_PTYPES], i), bind));
        vec_push(ms, vec_get(f[F_MUTS], i));
        i = i + 1;
    }
    let rs = vec_new();
    i = 0;
    while i < f[F_RTYPES][VEC_LEN] {
        vec_push(rs, shape_sig_type(vec_get(f[F_RTYPES], i), bind));
        i = i + 1;
    }
    let sig = vec_new();
    vec_push(sig, ns);
    vec_push(sig, ps);
    vec_push(sig, ms);
    vec_push(sig, rs);
    vec_push(sig, f[F_VARIADIC]);
    vec_push(sig, f[F_MUTRES]);
    vec_push(sig, f[F_BANG]);
    return sig;
}

// A signature is a vec of [param names, param types, param muts, result types,
// variadic, mut result, fault], read with vec_get like every other vec.

fn shape_sig_same(a, b) {
    let aps = vec_get(a, 1);
    let bps = vec_get(b, 1);
    if aps[VEC_LEN] != bps[VEC_LEN] || vec_get(a, 4) != vec_get(b, 4) || vec_get(a, 5) != vec_get(b, 5) || vec_get(a, 6) != vec_get(b, 6) {
        return 0;
    }
    let i = 0;
    while i < aps[VEC_LEN] {
        if vec_get(aps, i) != vec_get(bps, i) || vec_get(vec_get(a, 2), i) != vec_get(vec_get(b, 2), i) {
            return 0;
        }
        i = i + 1;
    }
    let ars = vec_get(a, 3);
    let brs = vec_get(b, 3);
    if ars[VEC_LEN] != brs[VEC_LEN] {
        return 0;
    }
    i = 0;
    while i < ars[VEC_LEN] {
        if vec_get(ars, i) != vec_get(brs, i) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

// shape_sig_str writes a method signature the way it would be declared, so the error
// can show both sides: `Read(buf mut []u8) !i64`.
fn shape_sig_str(b, name, sig) {
    let ns = vec_get(sig, 0);
    let ps = vec_get(sig, 1);
    let ms = vec_get(sig, 2);
    let rs = vec_get(sig, 3);
    let variadic = vec_get(sig, 4);
    buf_str(b, name);
    buf_byte(b, '(');
    let i = 0;
    while i < ps[VEC_LEN] {
        if i > 0 {
            buf_str(b, ", ");
        }
        let pn = vec_get(ns, i);
        if pn {
            buf_str(b, pn);
            buf_byte(b, ' ');
        }
        if variadic && i == ps[VEC_LEN] - 1 {
            buf_str(b, "...");
        } else if vec_get(ms, i) {
            buf_str(b, "mut ");
        }
        type_name(b, vec_get(ps, i));
        i = i + 1;
    }
    buf_byte(b, ')');
    let n = rs[VEC_LEN];
    if vec_get(sig, 6) {
        buf_str(b, " !");
        n = n - 1;
        if n == 1 {
            type_name(b, vec_get(rs, 0));
        } else if n > 1 {
            shape_result_list(b, rs, n);
        }
    } else if n == 1 {
        buf_byte(b, ' ');
        if vec_get(sig, 5) {
            buf_str(b, "mut ");
        }
        type_name(b, vec_get(rs, 0));
    } else if n > 1 {
        buf_byte(b, ' ');
        shape_result_list(b, rs, n);
    }
}

fn shape_result_list(b, rs, n) {
    buf_byte(b, '(');
    let i = 0;
    while i < n {
        if i > 0 {
            buf_str(b, ", ");
        }
        type_name(b, vec_get(rs, i));
        i = i + 1;
    }
    buf_byte(b, ')');
}

// check_shape reports why t does not satisfy sd, or nothing when it does. bind holds the
// type arguments of a generic shape instance (0 for a non-generic one), so `Seq[i64]`
// resolves its methods as i64. Composition is walked once per (shape, type, bindings) per
// satisfaction tree and never through a cycle, so a diamond costs its depth, not 2^depth,
// and a cycle reported at registration cannot recurse here.
fn check_shape(pos, t, sd, bind) {
    if shape_on_path(shape_bad, sd) || shape_on_path(shape_cycles, sd) {
        return;
    }
    if shape_checking[VEC_LEN] == 0 {
        shape_checked = vec_new();
    }
    if shape_seen(shape_checking, sd, t, bind) || shape_seen(shape_checked, sd, t, bind) {
        return;
    }
    // The same shape and type under a different instantiation means the composition
    // recurses through type arguments (`shape G[T] { G[Box[T]] }`); the cycle is reported
    // at declaration, and stopping here keeps the walk finite.
    if shape_seen_type(shape_checking, sd, t) {
        return;
    }
    vec_push(shape_checked, shape_key(sd, t, bind));
    vec_push(shape_checking, shape_key(sd, t, bind));
    let saved = ck_state_save();
    set_file(sd[D_FILE]);
    ck_tbind = bind;
    if sd[D_UNIONKIND] {
        let ok = 0;
        let j = 0;
        while j < sd[D_UNION][VEC_LEN] {
            if resolve_type(vec_get(sd[D_UNION], j)) == t {
                ok = 1;
            }
            j = j + 1;
        }
        if !ok {
            let m = err_begin(pos);
            buf_str(m, "type ");
            type_name(m, t);
            buf_str(m, " is not in shape ");
            buf_str(m, sd[D_NAME]);
            buf_str(m, ": want one of ");
            shape_union_str(m, sd);
            err_end(m);
        }
        shape_checking[VEC_LEN] = shape_checking[VEC_LEN] - 1;
        ck_state_restore(saved);
        return;
    }
    let j = 0;
    while j < sd[D_UNION][VEC_LEN] {
        let inst = shape_inst(vec_get(sd[D_UNION], j));
        if inst {
            check_shape(pos, t, vec_get(inst, 0), vec_get(inst, 1));
        }
        j = j + 1;
    }
    let i = 0;
    while i < sd[D_SHAPE][VEC_LEN] {
        if !check_shape_method(pos, t, sd, vec_get(sd[D_SHAPE], i), bind) {
            i = sd[D_SHAPE][VEC_LEN];
        } else {
            i = i + 1;
        }
    }
    shape_checking[VEC_LEN] = shape_checking[VEC_LEN] - 1;
    ck_state_restore(saved);
}

// shape_key is the (shape, type, bindings) triple a satisfaction tree is memoized on.
fn shape_key(sd, t, bind) {
    let k = vec_new();
    vec_push(k, sd);
    vec_push(k, t);
    vec_push(k, bind);
    return k;
}

fn shape_union_str(b, sd) {
    let i = 0;
    while i < sd[D_UNION][VEC_LEN] {
        if i > 0 {
            buf_str(b, " | ");
        }
        type_name(b, resolve_type(vec_get(sd[D_UNION], i)));
        i = i + 1;
    }
}

// check_shape_method reports whether t has want's method with want's signature. bind
// resolves a generic shape's method types. It returns 0 when the shape's own signature
// could not be resolved (already reported), so the caller stops rather than reporting
// the same missing type once per method.
fn check_shape_method(pos, t, sd, want, bind) {
    let before = error_count;
    let wsig = shape_sig_of(want, 0, bind);
    if error_count != before {
        if !shape_on_path(shape_bad, sd) {
            vec_push(shape_bad, sd);
        }
        return 0;
    }
    let cand = shape_method(t, want[F_NAME]);
    if !cand {
        let m = err_begin(pos);
        buf_str(m, "type ");
        type_name(m, t);
        buf_str(m, " does not satisfy shape ");
        buf_str(m, sd[D_NAME]);
        buf_str(m, ": it has no method ");
        shape_sig_str(m, want[F_NAME], wsig);
        err_end(m);
        return 1;
    }
    // The candidate's types belong to the file that declares the method, not the shape's.
    let saved = ck_state_save();
    set_file(cand[F_FILE]);
    let csig = shape_sig_of(cand, sm_declared, sm_bind);
    ck_state_restore(saved);
    if !shape_sig_same(wsig, csig) {
        let m = err_begin(pos);
        buf_str(m, "type ");
        type_name(m, t);
        buf_str(m, " does not satisfy shape ");
        buf_str(m, sd[D_NAME]);
        buf_str(m, ": method ");
        shape_sig_str(m, want[F_NAME], csig);
        buf_str(m, " has the wrong signature, want ");
        shape_sig_str(m, want[F_NAME], wsig);
        err_end(m);
    }
    return 1;
}

