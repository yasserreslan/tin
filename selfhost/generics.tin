// Generics by monomorphization: each use of a generic function or type with new type
// arguments re-parses the declaration's tokens and checks the copy with the type
// parameters bound, so every instance is ordinary, fully specialized code.
shared mut ck_tbind i64 // vec of [name, type]: type parameters in scope
shared mut ty_generics i64 // vec of [qualified name, decl] for generic types
shared mut gen_pending i64 // [method template, type args] waiting for functions to be declared
shared mut ck_decl_done i64

fn tbind_lookup(name i64) i64 {
	if ck_tbind == 0 {
		return 0
	}
	mut i = 0
	for i < ck_tbind[VEC_LEN] {
		let p = vec_get(ck_tbind, i)
		if streq(vec_get(p, 0), name) != 0 {
			return vec_get(p, 1)
		}
		i = i + 1
	}
	return 0
}

fn tbind_pairs(names i64, types i64) i64 {
	let v = vec_new()
	mut i = 0
	for i < names[VEC_LEN] {
		vec_push(v, pair(vec_get(names, i), vec_get(types, i)))
		i = i + 1
	}
	return v
}

fn same_types(a i64, b i64) i64 {
	if a[VEC_LEN] != b[VEC_LEN] {
		return 0
	}
	mut i = 0
	for i < a[VEC_LEN] {
		if vec_get(a, i) != vec_get(b, i) {
			return 0
		}
		i = i + 1
	}
	return 1
}

// targs_name appends "[T1,T2]" to b.
fn targs_name(b i64, targs i64) {
	buf_byte(b, '[')
	mut i = 0
	for i < targs[VEC_LEN] {
		if i > 0 {
			buf_byte(b, ',')
		}
		type_name(b, cast(Ty, vec_get(targs, i)))
		i = i + 1
	}
	buf_byte(b, ']')
}

// generics_init registers generic types and gives them their method templates.
fn generics_init() {
	ty_generics = vec_new()
	gen_pending = vec_new()
	ck_decl_done = 0
	mut i = 0
	for i < prog_types[VEC_LEN] {
		let d = cast(Decl, vec_get(prog_types, i))
		if d.tparams != 0 {
			set_file(d.file)
			d.insts = vec_new()
			d.methods = vec_new()
			vec_push(ty_generics, pair(qual(ck_pkg, d.name), cast(i64, d)))
		}
		i = i + 1
	}
	i = 0
	for i < prog_fns[VEC_LEN] {
		let f = cast(Fn, vec_get(prog_fns, i))
		let rx = f.recv
		if rx != 0 && cast(Node, rx).kind == TX_NAME && cast(TypeExpr, rx).args != 0 {
			set_file(f.file)
			let d = cast(Decl, find_generic(qual(ck_pkg, cast(TypeExpr, rx).b)))
			if cast(i64, d) == 0 {
				err_code_quoted(f.pos, cstr("E501 NOT_GENERIC"), cstr(""), cast(TypeExpr, rx).b, cstr(" is not a generic type"))
			} else {
				vec_push(d.methods, cast(i64, f))
			}
		}
		i = i + 1
	}
}

fn find_generic(qname i64) i64 {
	mut i = 0
	for i < ty_generics[VEC_LEN] {
		let p = vec_get(ty_generics, i)
		if streq(vec_get(p, 0), qname) != 0 {
			return vec_get(p, 1)
		}
		i = i + 1
	}
	return 0
}

fn is_template(f Fn) i64 {
	return i64(f.tparams != 0 && f.tbind == 0)
}

// generic_type_ref resolves Name[T...] in the current file.
fn generic_type_ref(tx i64) i64 {
	mut d = cast(Decl, 0)
	if cast(TypeExpr, tx).a != 0 {
		let pkg = import_pkg(cast(TypeExpr, tx).a)
		if pkg != 0 {
			d = cast(Decl, find_generic(str_cat3(pkg, cstr("."), cast(TypeExpr, tx).b)))
		}
	} else {
		if i64(load8(ck_pkg)) != 0 {
			d = cast(Decl, find_generic(qual(ck_pkg, cast(TypeExpr, tx).b)))
		}
		if cast(i64, d) == 0 {
			d = cast(Decl, find_generic(cast(TypeExpr, tx).b))
		}
	}
	if cast(i64, d) == 0 {
		err_code_quoted(cast(Node, tx).pos, cstr("E501 NOT_GENERIC"), cstr(""), cast(TypeExpr, tx).b, cstr(" is not a generic type"))
		return ty_int
	}
	let targs = resolve_types(cast(TypeExpr, tx).args)
	if targs[VEC_LEN] != d.tparams[VEC_LEN] {
		err_code_quoted(cast(Node, tx).pos, cstr("E502 TYPE_ARG_COUNT"), cstr("wrong number of type arguments for "), cast(TypeExpr, tx).b, cstr(""))
		return ty_int
	}
	return instantiate_type(d, targs, cast(Node, tx).pos)
}

// Checker state an instantiation must not disturb.
fn ck_state_save() i64 {
	let s = vec_new()
	vec_push(s, ck_file)
	vec_push(s, cast(i64, ck_fn))
	vec_push(s, ck_tbind)
	return s
}

fn ck_state_restore(s i64) {
	set_file(vec_get(s, 0))
	ck_fn = cast(Fn, vec_get(s, 1))
	ck_tbind = vec_get(s, 2)
}

fn check_constraints(pos i64, names i64, cons i64, targs i64, file i64) {
	let saved = ck_state_save()
	set_file(file)
	// A later constraint may mention an earlier parameter (`[T constraints.Any, S Seq[T]]`), so the
	// type arguments in scope resolve while the constraints are checked.
	ck_tbind = tbind_pairs(names, targs)
	mut i = 0
	for i < names[VEC_LEN] {
		let c = vec_get(cons, i)
		if c != 0 {
			let t = vec_get(targs, i)
			mut inst = 0
			mut handled = 0
			let cx = cast(Node, vec_get(c, 0))
			if c[VEC_LEN] == 1 && cx.kind == TX_DYN {
				err_code_at(cx.pos, cstr("E520 DYN_CONSTRAINT"), cstr("a dyn type is not a constraint: name the shape"))
				handled = 1
			}
			if handled == 0 && c[VEC_LEN] == 1 && cx.kind == TX_NAME {
				// A shape, with or without type arguments: Seq[i64] is an instance.
				inst = shape_inst(cast(i64, cx))
				// A name that is a shape but failed to instantiate was diagnosed there;
				// do not go on to read it as a union member.
				handled = i64(shape_ref_name(cast(TypeExpr, cx)) != 0)
			}
			if inst != 0 {
				check_shape(pos, cast(Ty, t), cast(Decl, vec_get(inst, 0)), vec_get(inst, 1))
			} else if handled != 0 {
			} else {
				mut ok = 0
				mut j = 0
				for j < c[VEC_LEN] {
					let mt = cast(Node, vec_get(c, j))
					if shape_ref_name(cast(TypeExpr, mt)) != 0 {
						err_code_quoted(mt.pos, cstr("E521 SHAPE_IN_UNION"), cstr(""), shape_member_name(cast(i64, mt)), cstr(" is a shape: a union constraint lists concrete types, and a shape goes in the constraint alone"))
					} else if resolve_type(cast(i64, mt)) == t {
						ok = 1
					}
					j = j + 1
				}
				if ok == 0 {
					let m = err_code(pos, cstr("E510 NOT_IN_UNION"))
					buf_str(m, cstr("type "))
					type_name(m, cast(Ty, t))
					buf_str(m, cstr(" does not satisfy the constraint of "))
					buf_str(m, vec_get(names, i))
					err_end(m)
				}
			}
		}
		i = i + 1
	}
	ck_state_restore(saved)
}

fn instantiate_type(d Decl, targs i64, pos i64) i64 {
	sb_targs(pos, targs)
	mut i = 0
	for i < d.insts[VEC_LEN] {
		let inst = vec_get(d.insts, i)
		if same_types(vec_get(inst, 0), targs) != 0 {
			return vec_get(inst, 1)
		}
		i = i + 1
	}
	check_constraints(pos, d.tparams, d.tcons, targs, d.file)
	let saved = ck_state_save()
	set_file(d.file)
	let nb = buf_new()
	buf_str(nb, qual(ck_pkg, d.name))
	targs_name(nb, targs)
	buf_byte(nb, 0)
	let name = nb[VEC_DATA]
	mut t = cast(Ty, 0)
	if cast(Node, d.type_).kind == TX_STRUCT {
		t = cast(Ty, ty_new(K_STRUCT, name))
		t.targs = targs
		t.gdecl = cast(i64, d)
		name_type(name, cast(i64, t))
		vec_push(d.insts, pair(targs, cast(i64, t)))
		ck_tbind = tbind_pairs(d.tparams, targs)
		resolve_fields(t, cast(TypeExpr, d.type_))
		layout_struct(t)
	} else {
		ck_tbind = tbind_pairs(d.tparams, targs)
		t = cast(Ty, resolve_type(d.type_))
		vec_push(d.insts, pair(targs, cast(i64, t)))
	}
	ck_state_restore(saved)
	mut m = 0
	for m < d.methods[VEC_LEN] {
		let tmpl = vec_get(d.methods, m)
		if ck_decl_done != 0 {
			instantiate_fn(cast(Fn, tmpl), targs, pos)
		} else {
			vec_push(gen_pending, pair(tmpl, targs))
		}
		m = m + 1
	}
	return cast(i64, t)
}

// generics_declared runs once every ordinary function is declared.
fn generics_declared() {
	ck_decl_done = 1
	mut i = 0
	for i < gen_pending[VEC_LEN] {
		let p = vec_get(gen_pending, i)
		instantiate_fn(cast(Fn, vec_get(p, 0)), vec_get(p, 1), 0)
		i = i + 1
	}
}

// instantiate_fn returns the instance of template g for targs, declaring it on first use;
// the main check loop checks its body later like any function's.
// type_depth is how deeply t nests types (slices, optionals, maps, generic instances).
fn type_depth(t Ty, n i64) i64 {
	if cast(i64, t) == 0 || n > 64 {
		return n
	}
	let k = kind_of(t)
	if k == K_SLICE || k == K_OPT {
		return type_depth(cast(Ty, t.elem), n + 1)
	}
	if k == K_MAP {
		let a = type_depth(cast(Ty, t.key), n + 1)
		let b = type_depth(cast(Ty, t.elem), n + 1)
		if a > b {
			return a
		}
		return b
	}
	if k == K_STRUCT && t.targs != 0 {
		mut best = n + 1
		mut i = 0
		for i < t.targs[VEC_LEN] {
			let x = type_depth(cast(Ty, vec_get(t.targs, i)), n + 1)
			if x > best {
				best = x
			}
			i = i + 1
		}
		return best
	}
	return n
}

fn instantiate_fn(g Fn, targs i64, pos i64) i64 {
	sb_targs(pos, targs)
	if g.insts == 0 {
		g.insts = vec_new()
	}
	mut i = 0
	for i < g.insts[VEC_LEN] {
		let inst = vec_get(g.insts, i)
		if same_types(vec_get(inst, 0), targs) != 0 {
			return vec_get(inst, 1)
		}
		i = i + 1
	}
	if targs[VEC_LEN] != g.tparams[VEC_LEN] {
		err_code_quoted(pos, cstr("E502 TYPE_ARG_COUNT"), cstr("wrong number of type arguments for "), g.name, cstr(""))
		return cast(i64, g)
	}
	// A generic that calls itself with a type built from its own type parameter (F[T] calling
	// F[[]T]) would be instantiated forever: stop at a depth no real program reaches (#98).
	mut d = 0
	mut k = 0
	for k < targs[VEC_LEN] {
		let dk = type_depth(cast(Ty, vec_get(targs, k)), 0)
		if dk > d {
			d = dk
		}
		k = k + 1
	}
	if d > 48 || g.insts[VEC_LEN] >= 4096 {
		if g.instcycle == 0 {
			g.instcycle = 1
			err_code_quoted(pos, cstr("E503 ENDLESS_INSTANTIATION"), cstr("instantiating "), g.name, cstr(" does not end: it is instantiated with ever deeper type arguments (a generic function calling itself with a type built from its type parameter, such as F[[]T] inside F[T])"))
		}
		return cast(i64, g)
	}
	check_constraints(pos, g.tparams, g.tcons, targs, g.file)
	let st_toks = p_toks
	let st_i = p_i
	let st_nolit = p_nolit
	let st_file = cur_file
	let st_ed1 = p_edition1
	p_toks = g.toks
	p_i = g.tokat
	p_nolit = 0
	cur_file = g.file
	// The template is read again in its own file's edition, not the last file parsed.
	p_edition1 = i64(g.file < file_ed1[VEC_LEN] && vec_get(file_ed1, g.file) != 0)
	let nf = cast(Fn, parse_fn(0))
	p_toks = st_toks
	p_i = st_i
	p_nolit = st_nolit
	cur_file = st_file
	p_edition1 = st_ed1
	nf.tparams = g.tparams
	nf.tbind = tbind_pairs(g.tparams, targs)
	nf.genof = cast(i64, g)
	nf.file = g.file
	if nf.recv == 0 {
		let nb = buf_new()
		buf_str(nb, nf.name)
		targs_name(nb, targs)
		buf_byte(nb, 0)
		nf.name = nb[VEC_DATA]
	}
	vec_push(g.insts, pair(targs, cast(i64, nf)))
	vec_push(prog_fns, cast(i64, nf))
	let saved = ck_state_save()
	ck_tbind = nf.tbind
	declare_fn(nf)
	ck_state_restore(saved)
	return cast(i64, nf)
}

// unify binds g's type parameters by matching type expression tx against type t.
fn tunify(g Fn, binds i64, tx i64, t Ty, untyped_ok i64) {
	if tx == 0 || cast(i64, t) == 0 {
		return
	}
	let k = cast(Node, tx).kind
	if k == TX_NAME && cast(TypeExpr, tx).a == 0 && cast(TypeExpr, tx).args == 0 {
		mut i = 0
		for i < g.tparams[VEC_LEN] {
			if streq(vec_get(g.tparams, i), cast(TypeExpr, tx).b) != 0 {
				if is_untyped(cast(i64, t)) != 0 {
					if untyped_ok != 0 && vec_get(binds, i) == 0 {
						binds[VEC_DATA][i] = default_type(cast(i64, t))
					}
				} else if vec_get(binds, i) == 0 {
					binds[VEC_DATA][i] = cast(i64, t)
				}
				return
			}
			i = i + 1
		}
		return
	}
	let tk = kind_of(t)
	if k == TX_SLICE && tk == K_SLICE {
		tunify(g, binds, cast(TypeExpr, tx).a, cast(Ty, t.elem), untyped_ok)
	} else if k == TX_OPT && tk == K_OPT {
		tunify(g, binds, cast(TypeExpr, tx).a, cast(Ty, t.elem), untyped_ok)
	} else if k == TX_MAP && tk == K_MAP {
		tunify(g, binds, cast(TypeExpr, tx).a, cast(Ty, t.key), untyped_ok)
		tunify(g, binds, cast(TypeExpr, tx).b, cast(Ty, t.elem), untyped_ok)
	} else if k == TX_FUNC && tk == K_FUNC {
		let ps = cast(TypeExpr, tx).a
		let rs = cast(TypeExpr, tx).b
		mut j = 0
		for ps != 0 && j < ps[VEC_LEN] && j < t.fields[VEC_LEN] {
			tunify(g, binds, vec_get(ps, j), cast(Ty, vec_get(t.fields, j)), untyped_ok)
			j = j + 1
		}
		j = 0
		for rs != 0 && j < rs[VEC_LEN] && j < t.results[VEC_LEN] {
			tunify(g, binds, vec_get(rs, j), cast(Ty, vec_get(t.results, j)), untyped_ok)
			j = j + 1
		}
	} else if k == TX_NAME && cast(TypeExpr, tx).args != 0 && t.targs != 0 && kind_of(t) != K_DYN {
		mut j2 = 0
		for j2 < cast(TypeExpr, tx).args[VEC_LEN] && j2 < t.targs[VEC_LEN] {
			tunify(g, binds, vec_get(cast(TypeExpr, tx).args, j2), cast(Ty, vec_get(t.targs, j2)), untyped_ok)
			j2 = j2 + 1
		}
	}
}

// generic_call checks call e of template g: arguments first, then the inferred instance.
fn generic_call(e i64, g Fn) i64 {
	let args = cast(Call, e).args
	let atypes = vec_new()
	mut i = 0
	for i < args[VEC_LEN] {
		mut a = vec_get(args, i)
		if cast(Node, a).kind == EX_MUTARG {
			// Infer from x in `mut x`; chk_args checks the mark after instantiation.
			a = cast(MutArg, a).x
		}
		let at = chk(cast(Node, a), 0)
		check_value(cast(Node, a).pos, at)
		vec_push(atypes, at)
		i = i + 1
	}
	let np = g.ptypes[VEC_LEN]
	if args[VEC_LEN] != np {
		let m = err_code(cast(Node, e).pos, cstr("E210 ARG_COUNT"))
		buf_str(m, g.name)
		buf_str(m, cstr(" expects "))
		buf_int(m, np)
		buf_str(m, cstr(" arguments, got "))
		buf_int(m, args[VEC_LEN])
		err_end(m)
		return ty_int
	}
	let binds = vec_filled(g.tparams[VEC_LEN], 0)
	mut pass = 0
	for pass < 2 {
		i = 0
		for i < np {
			tunify(g, binds, vec_get(g.ptypes, i), cast(Ty, vec_get(atypes, i)), pass)
			i = i + 1
		}
		pass = pass + 1
	}
	// with p { }: the type parameters a policy constructor's arguments leave open are the
	// block's type (#237, notes/interface_policy.md §2).
	if with_fill_calls != 0 && vec_index(with_fill_calls, e) >= 0 {
		i = 0
		for i < binds[VEC_LEN] {
			if vec_get(binds, i) == 0 {
				binds[VEC_DATA][i] = with_fill_t
			}
			i = i + 1
		}
	}
	i = 0
	for i < binds[VEC_LEN] {
		if vec_get(binds, i) == 0 {
			err_code_quoted(cast(Node, e).pos, cstr("E504 CANNOT_INFER"), cstr("cannot infer type parameter "), vec_get(g.tparams, i), cstr(" (give it explicitly: F[T](...))"))
			return ty_int
		}
		i = i + 1
	}
	let inst = cast(Fn, instantiate_fn(g, binds, cast(Node, e).pos))
	if inst == g && g.instcycle != 0 {
		// Reported already (an endless instantiation): no instance to check the call against;
		// an untyped int keeps the surrounding expression from adding errors in the usual case.
		return ty_uint
	}
	cast(Call, e).fn_ = cast(i64, inst)
	cast(Call, e).callee = 0
	cast(Call, e).name = inst.qname
	let ptypes = inst.ptypes
	let mask = mut_mask(inst.muts)
	i = 0
	for i < args[VEC_LEN] {
		mut a = vec_get(args, i)
		let marked = unwrap_mut(a)
		if !(i == 0 && cast(Call, e).method != 0) {
			let pm = i64(i < 63 && (mask & (1 << i)) != 0)
			if pm != 0 && marked == 0 {
				mut_arg_error(cast(Call, e), cast(Node, a), i, cstr("is a mut parameter: write mut before the argument"))
			} else if marked != 0 && pm == 0 {
				mut_arg_error(cast(Call, e), cast(Node, a), i, cstr("is not a mut parameter: remove mut"))
			}
		}
		let want = vec_get(ptypes, i)
		let at = vec_get(atypes, i)
		check_assignable(cast(Node, a), at, cast(Ty, want))
		if is_untyped(at) != 0 {
			reconvert(cast(Node, a), want)
		}
		i = i + 1
	}
	return result_type(inst)
}

// expr_to_tx turns an expression that names a type (from X[A, B] or T[A]{...}) into a type expr.
fn expr_to_tx(e i64) i64 {
	let k = cast(Node, e).kind
	if k == EX_TYPE {
		return e[TYX]
	}
	if k == EX_IDENT {
		let n = cast(TypeExpr, node_new(TX_NAME, cast(Node, e).pos))
		n.b = cast(IdentExpr, e).name
		return cast(i64, n)
	}
	if k == EX_SELECT && cast(Node, cast(SelectExpr, e).x).kind == EX_IDENT {
		let n2 = cast(TypeExpr, node_new(TX_NAME, cast(Node, e).pos))
		n2.a = cast(IdentExpr, cast(SelectExpr, e).x).name
		n2.b = cast(SelectExpr, e).name
		return cast(i64, n2)
	}
	if k == EX_INDEX {
		let base = expr_to_tx(cast(IndexExpr, e).x)
		if base == 0 || cast(Node, base).kind != TX_NAME {
			return 0
		}
		cast(TypeExpr, base).args = index_targs(e)
		return base
	}
	return 0
}

// index_targs is the type expression list of X[A, B].
fn index_targs(e i64) i64 {
	let out = vec_new()
	mut list = cast(IndexExpr, e).args
	if list == 0 {
		list = vec_new()
		vec_push(list, cast(IndexExpr, e).i)
	}
	mut i = 0
	for i < list[VEC_LEN] {
		mut tx = cast(TypeExpr, expr_to_tx(vec_get(list, i)))
		if cast(i64, tx) == 0 {
			err_code_at(cast(Node, vec_get(list, i)).pos, cstr("E505 NOT_A_TYPE_ARG"), cstr("expected a type argument"))
			tx = cast(TypeExpr, node_new(TX_NAME, cast(Node, e).pos))
			tx.b = cstr("i64")
		}
		vec_push(out, cast(i64, tx))
		i = i + 1
	}
	return out
}

// explicit_generic returns the template a callee like F[T] or pkg.F[T] names, or 0.
fn explicit_generic(callee i64) i64 {
	if cast(Node, callee).kind != EX_INDEX {
		return 0
	}
	let x = cast(IndexExpr, callee).x
	if cast(Node, x).kind == EX_IDENT {
		if lookup_name_local(cast(IdentExpr, x).name) != 0 {
			return 0
		}
		let s = cast(Sym, lookup_name(cast(IdentExpr, x).name))
		if cast(i64, s) != 0 && s.kind == SYM_FUNC && is_template(cast(Fn, s.fn_)) != 0 {
			return s.fn_
		}
		return 0
	}
	if cast(Node, x).kind == EX_SELECT && cast(Node, cast(SelectExpr, x).x).kind == EX_IDENT && lookup_name_local(cast(IdentExpr, cast(SelectExpr, x).x).name) == 0 {
		let pkg = import_pkg(cast(IdentExpr, cast(SelectExpr, x).x).name)
		if pkg != 0 {
			let s2 = cast(Sym, pkg_member(pkg, cast(SelectExpr, x).name))
			if cast(i64, s2) != 0 && s2.kind == SYM_FUNC && is_template(cast(Fn, s2.fn_)) != 0 {
				return s2.fn_
			}
		}
	}
	return 0
}

// ---- shapes (#141) ----
//
// A shape is a set of method signatures. A type satisfies it structurally (no impl
// declaration), so satisfaction is checked where a shape is used as a type-parameter
// constraint: the type argument is concrete by then, and a call through the parameter
// is already a direct call on it. `dyn` and generic shapes are later steps; both get a
// diagnostic naming what is missing instead of being misread as ordinary types.
shared mut ty_shapes i64 // vec of [qualified name, shape decl], like ty_named for types
shared mut sm_bind i64 // bindings that resolve the candidate method's signature
shared mut sm_declared i64 // 1 when the candidate method has been declared (receiver prepended)
shared mut shape_cycles i64 // shapes already reported in a composition cycle
shared mut shape_validated i64 // shapes whose body has been validated (memo: composition is a DAG)
shared mut shape_checking i64 // shapes on the current satisfaction path (a cycle guard)
shared mut shape_checked i64 // shapes already checked in the current satisfaction tree
shared mut shape_bad i64 // shapes whose signature did not resolve (reported once)
shared mut shape_collecting i64 // (shape, bindings) pairs collected in the current flattening
shared mut shape_conflicts i64 // errors the current flattening attributed to the owner shape
shared mut shape_placeholders i64 // the fresh types shape_sym_bind made for symbolic validation

fn shapes_init() {
	shape_placeholders = vec_new()
	ty_shapes = vec_new()
	shape_cycles = vec_new()
	shape_validated = vec_new()
	shape_checking = vec_new()
	shape_checked = vec_new()
	shape_bad = vec_new()
	shape_collecting = vec_new()
	shape_conflicts = 0
	mut i = 0
	for i < prog_shapes[VEC_LEN] {
		let d = cast(Decl, vec_get(prog_shapes, i))
		set_file(d.file)
		let q = qual(ck_pkg, d.name)
		if find_shape(q) != 0 {
			err_code_quoted(d.pos, cstr("E101 REDECLARED"), cstr(""), d.name, cstr(" is declared as a shape twice"))
		} else {
			vec_push(ty_shapes, pair(q, cast(i64, d)))
		}
		i = i + 1
	}
	i = 0
	for i < prog_shapes[VEC_LEN] {
		let d = cast(Decl, vec_get(prog_shapes, i))
		if shape_on_path(shape_cycles, cast(i64, d)) == 0 {
			check_shape_decl(d, vec_new())
		}
		i = i + 1
	}
}

fn find_shape(qname i64) i64 {
	mut i = ty_shapes[VEC_LEN] - 1
	for i >= 0 {
		let rec = vec_get(ty_shapes, i)
		if streq(vec_get(rec, 0), qname) != 0 {
			return vec_get(rec, 1)
		}
		i = i - 1
	}
	return 0
}

// shapes_declared resolves every non-generic shape's signatures (and a named union's
// members) once the named types exist, so an unused shape still reports a `dyn` it
// cannot carry or a type that does not exist, instead of hiding it until first use. A
// shapes_declared resolves every shape's signatures (and a named union's members) once
// the named types exist, so an unused shape still reports a `dyn` it cannot carry or a
// type that does not exist, instead of hiding it until first use. A generic shape is
// validated with its parameters bound to fresh types, which catches a conflict or a
// `dyn` that does not depend on the instantiation. A shape whose types failed is
// remembered so satisfaction does not report them again.
fn shapes_declared() {
	mut i = 0
	for i < prog_shapes[VEC_LEN] {
		let d = cast(Decl, vec_get(prog_shapes, i))
		if shape_on_path(shape_bad, cast(i64, d)) == 0 {
			let saved = ck_state_save()
			set_file(d.file)
			mut bind_ = 0
			if d.tparams != 0 {
				bind_ = shape_sym_bind(d)
			}
			ck_tbind = bind_
			let before = error_count
			mut j = 0
			if d.unionkind != 0 {
				// A member that names a shape was reported by check_shape_decl; resolving
				// it here would add a second, less useful message. The union is bad either
				// way, so satisfaction skips it.
				mut bad = 0
				for j < d.union[VEC_LEN] {
					let m = cast(Fn, vec_get(d.union, j))
					if shape_ref_name(cast(TypeExpr, m)) != 0 {
						bad = 1
					} else {
						resolve_type(cast(i64, m))
					}
					j = j + 1
				}
				if error_count != before || bad != 0 {
					if shape_on_path(shape_bad, cast(i64, d)) == 0 {
						vec_push(shape_bad, cast(i64, d))
					}
				}
			} else {
				for j < d.shape_[VEC_LEN] {
					let m = cast(Fn, vec_get(d.shape_, j))
					mut k = 0
					for k < m.ptypes[VEC_LEN] {
						resolve_type(vec_get(m.ptypes, k))
						k = k + 1
					}
					k = 0
					for k < m.rtypes[VEC_LEN] {
						resolve_type(vec_get(m.rtypes, k))
						k = k + 1
					}
					j = j + 1
				}
				if error_count != before {
					// d's own signature is what failed; conflicts are checked for the
					// shapes that are still sound.
					if shape_on_path(shape_bad, cast(i64, d)) == 0 {
						vec_push(shape_bad, cast(i64, d))
					}
				} else {
					// A conflict or a duplicate is d's; a listed shape's signature
					// failure was attributed to that shape by shape_collect.
					if check_shape_conflicts(cast(i64, d), bind_) > 0 && shape_on_path(shape_bad, cast(i64, d)) == 0 {
						vec_push(shape_bad, cast(i64, d))
					}
				}
			}
			ck_state_restore(saved)
		}
		i = i + 1
	}
}

// shape_ref_name resolves a name (qualified or not) to a shape in scope, or 0. An
// unqualified name resolves in the current package only: a package's own type must not
// be shadowed by a shape of the same name in main, so there is no cross-package fallback.
fn shape_ref_name(tx TypeExpr) i64 {
	if tx.a != 0 {
		let pkg = import_pkg(tx.a)
		if pkg != 0 {
			return find_shape(str_cat3(pkg, cstr("."), tx.b))
		}
		return 0
	}
	if i64(load8(ck_pkg)) != 0 {
		return find_shape(qual(ck_pkg, tx.b))
	}
	return find_shape(tx.b)
}

// shape_inst resolves a shape reference, with or without type arguments, to a vec of
// [decl, bindings]; bindings is 0 for a non-generic shape. Type arguments are resolved
// and the shape's own parameter constraints are checked, so `Seq[i64]` is an instance
// and `Seq` alone is an error. Returns 0 when the name is not a shape.
fn shape_inst(tx i64) i64 {
	let d = cast(Decl, shape_ref_name(cast(TypeExpr, tx)))
	if cast(i64, d) == 0 {
		return 0
	}
	if d.tparams == 0 {
		if cast(TypeExpr, tx).args != 0 {
			err_code_quoted(cast(Node, tx).pos, cstr("E501 NOT_GENERIC"), cstr("shape "), cast(TypeExpr, tx).b, cstr(" takes no type arguments"))
			return 0
		}
		return pair(cast(i64, d), 0)
	}
	if cast(TypeExpr, tx).args == 0 {
		let e = err_code(cast(Node, tx).pos, cstr("E502 TYPE_ARG_COUNT"))
		buf_str(e, cstr("shape "))
		buf_str(e, cast(TypeExpr, tx).b)
		buf_str(e, cstr(" needs type arguments, like "))
		buf_str(e, cast(TypeExpr, tx).b)
		buf_str(e, cstr("[...]"))
		err_end(e)
		return 0
	}
	if cast(TypeExpr, tx).args[VEC_LEN] != d.tparams[VEC_LEN] {
		let e = err_code(cast(Node, tx).pos, cstr("E502 TYPE_ARG_COUNT"))
		buf_str(e, cstr("wrong number of type arguments for shape "))
		buf_str(e, cast(TypeExpr, tx).b)
		buf_str(e, cstr(": it takes "))
		buf_int(e, d.tparams[VEC_LEN])
		err_end(e)
		return 0
	}
	let before = error_count
	let targs = resolve_types(cast(TypeExpr, tx).args)
	if error_count != before {
		// A type argument that did not resolve was reported; bindings built from the
		// fallback types would only add misleading errors.
		return 0
	}
	let before_cons = error_count
	check_constraints(cast(Node, tx).pos, d.tparams, d.tcons, targs, d.file)
	if error_count != before_cons {
		// The arguments were reported; a pair built from them would only cause the same
		// error again at use.
		return 0
	}
	return pair(cast(i64, d), tbind_pairs(d.tparams, targs))
}

// shape_inst_decl is shape_inst for declaration validation: it checks the name and the
// arity but not the type arguments' constraints, which a symbolic parameter cannot meet.
fn shape_inst_decl(tx i64) i64 {
	let d = cast(Decl, shape_ref_name(cast(TypeExpr, tx)))
	if cast(i64, d) == 0 {
		return 0
	}
	if d.tparams == 0 {
		if cast(TypeExpr, tx).args != 0 {
			err_code_quoted(cast(Node, tx).pos, cstr("E501 NOT_GENERIC"), cstr("shape "), cast(TypeExpr, tx).b, cstr(" takes no type arguments"))
			return 0
		}
		return pair(cast(i64, d), 0)
	}
	if cast(TypeExpr, tx).args == 0 {
		let e = err_code(cast(Node, tx).pos, cstr("E502 TYPE_ARG_COUNT"))
		buf_str(e, cstr("shape "))
		buf_str(e, cast(TypeExpr, tx).b)
		buf_str(e, cstr(" needs type arguments, like "))
		buf_str(e, cast(TypeExpr, tx).b)
		buf_str(e, cstr("[...]"))
		err_end(e)
		return 0
	}
	if cast(TypeExpr, tx).args[VEC_LEN] != d.tparams[VEC_LEN] {
		let e = err_code(cast(Node, tx).pos, cstr("E502 TYPE_ARG_COUNT"))
		buf_str(e, cstr("wrong number of type arguments for shape "))
		buf_str(e, cast(TypeExpr, tx).b)
		buf_str(e, cstr(": it takes "))
		buf_int(e, d.tparams[VEC_LEN])
		err_end(e)
		return 0
	}
	return pair(cast(i64, d), 0)
}

// shape_member_symbolic reports whether any type argument of a listed member is one of
// the enclosing shape's parameters bound to a symbolic type, which is what makes an
// instance's own argument constraints impossible to check at declaration. A concrete
// argument (`shape G[T constraints.Any] { A[f64] }`) and a parameter already bound to a real type
// (`shape C[V constraints.Any] { A[V] }` used with `C[f64]`) are checked.
fn shape_member_symbolic(m TypeExpr, sd Decl, bind_ i64) i64 {
	if m.args == 0 || bind_ == 0 {
		return 0
	}
	mut i = 0
	for i < m.args[VEC_LEN] {
		let arg = vec_get(m.args, i)
		mut j = 0
		for j < sd.tparams[VEC_LEN] {
			let name = vec_get(sd.tparams, j)
			let one = vec_new()
			vec_push(one, name)
			if shape_tx_mentions(arg, one) != 0 {
				let value = shape_bind_value(bind_, name)
				if value != 0 && shape_on_path(shape_placeholders, value) != 0 {
					return 1
				}
			}
			j = j + 1
		}
		i = i + 1
	}
	return 0
}

fn shape_bind_value(bind_ i64, name i64) i64 {
	mut i = 0
	for i < bind_[VEC_LEN] {
		let p = vec_get(bind_, i)
		if streq(vec_get(p, 0), name) != 0 {
			return vec_get(p, 1)
		}
		i = i + 1
	}
	return 0
}

fn shape_tx_mentions(tx i64, names i64) i64 {
	if tx == 0 {
		return 0
	}
	let k = cast(Node, tx).kind
	if k == TX_NAME {
		mut i = 0
		for i < names[VEC_LEN] {
			if cast(TypeExpr, tx).a == 0 && streq(cast(TypeExpr, tx).b, vec_get(names, i)) != 0 {
				return 1
			}
			i = i + 1
		}
		mut j = 0
		for cast(TypeExpr, tx).args != 0 && j < cast(TypeExpr, tx).args[VEC_LEN] {
			if shape_tx_mentions(vec_get(cast(TypeExpr, tx).args, j), names) != 0 {
				return 1
			}
			j = j + 1
		}
		return 0
	}
	if k == TX_SLICE || k == TX_ARRAY {
		return shape_tx_mentions(tx[TX_A + i64((k == TX_ARRAY))], names)
	}
	if k == TX_MAP {
		return i64(shape_tx_mentions(cast(TypeExpr, tx).a, names) != 0 || shape_tx_mentions(cast(TypeExpr, tx).b, names) != 0)
	}
	if k == TX_OPT || k == TX_PTR || k == TX_CHAN {
		return shape_tx_mentions(cast(TypeExpr, tx).a, names)
	}
	if k == TX_FUNC {
		return i64(shape_tx_list_mentions(cast(TypeExpr, tx).a, names) != 0 || shape_tx_list_mentions(cast(TypeExpr, tx).b, names) != 0)
	}
	if k == TX_STRUCT {
		let fields = cast(TypeExpr, tx).a
		mut i = 0
		for fields != 0 && i < fields[VEC_LEN] {
			if shape_tx_mentions(vec_get(vec_get(fields, i), 1), names) != 0 {
				return 1
			}
			i = i + 1
		}
		return 0
	}
	return 0
}

fn shape_tx_list_mentions(list i64, names i64) i64 {
	mut i = 0
	for list != 0 && i < list[VEC_LEN] {
		if shape_tx_mentions(vec_get(list, i), names) != 0 {
			return 1
		}
		i = i + 1
	}
	return 0
}

// shape_sym_bind binds each of a generic shape's parameters to a fresh struct type of its
// own, so a body can be validated at declaration: `shape B[U] { A[U] }` resolves U to B's
// parameter and two mentions of it compare equal, while `A[T]` against `B.M() i64` are
// different types and a conflict is reported. The fresh types are compared by identity
// only; nothing is named after them. A struct keeps `?T` well formed, as T must be a
// reference for that to be legal at an instantiation.
fn shape_sym_bind(d Decl) i64 {
	let bind_ = vec_new()
	mut i = 0
	for i < d.tparams[VEC_LEN] {
		let ph = cast(Ty, ty_new(K_STRUCT, vec_get(d.tparams, i)))
		// A struct with no fields, not a null one: key_valid walks a map key's fields.
		ph.fields = vec_new()
		vec_push(shape_placeholders, cast(i64, ph))
		vec_push(bind_, pair(vec_get(d.tparams, i), cast(i64, ph)))
		i = i + 1
	}
	return bind_
}

// shape_inst_soft resolves a listed instance for declaration validation: it checks the
// name and the arity, binds the arguments, but does not check their constraints, because
// a symbolic parameter cannot satisfy a union or a shape. The constraints are checked
// again at every real instantiation.
fn shape_inst_soft(tx i64) i64 {
	let d = cast(Decl, shape_ref_name(cast(TypeExpr, tx)))
	if cast(i64, d) == 0 {
		return 0
	}
	if d.tparams == 0 {
		if cast(TypeExpr, tx).args != 0 {
			err_code_quoted(cast(Node, tx).pos, cstr("E501 NOT_GENERIC"), cstr("shape "), cast(TypeExpr, tx).b, cstr(" takes no type arguments"))
			return 0
		}
		return pair(cast(i64, d), 0)
	}
	if cast(TypeExpr, tx).args == 0 {
		let e = err_code(cast(Node, tx).pos, cstr("E502 TYPE_ARG_COUNT"))
		buf_str(e, cstr("shape "))
		buf_str(e, cast(TypeExpr, tx).b)
		buf_str(e, cstr(" needs type arguments, like "))
		buf_str(e, cast(TypeExpr, tx).b)
		buf_str(e, cstr("[...]"))
		err_end(e)
		return 0
	}
	if cast(TypeExpr, tx).args[VEC_LEN] != d.tparams[VEC_LEN] {
		let e = err_code(cast(Node, tx).pos, cstr("E502 TYPE_ARG_COUNT"))
		buf_str(e, cstr("wrong number of type arguments for shape "))
		buf_str(e, cast(TypeExpr, tx).b)
		buf_str(e, cstr(": it takes "))
		buf_int(e, d.tparams[VEC_LEN])
		err_end(e)
		return 0
	}
	let before = error_count
	let targs = resolve_types(cast(TypeExpr, tx).args)
	if error_count != before {
		return 0
	}
	return pair(cast(i64, d), tbind_pairs(d.tparams, targs))
}

// shape_collect_visited reports whether (shape, bindings) has been collected in the
// current flattening, so a diamond is walked once and a generic instance is not confused
// with another instance of the same shape.
fn shape_collect_visited(sd i64, bind_ i64) i64 {
	mut i = 0
	for i < shape_collecting[VEC_LEN] {
		let p = vec_get(shape_collecting, i)
		if vec_get(p, 0) == sd && shape_bind_same(vec_get(p, 1), bind_) != 0 {
			return 1
		}
		i = i + 1
	}
	return 0
}

fn shape_bind_same(a i64, b i64) i64 {
	if a == 0 || b == 0 {
		return i64(a == b)
	}
	if a[VEC_LEN] != b[VEC_LEN] {
		return 0
	}
	mut i = 0
	for i < a[VEC_LEN] {
		if vec_get(vec_get(a, i), 1) != vec_get(vec_get(b, i), 1) {
			return 0
		}
		i = i + 1
	}
	return 1
}

// check_shape_conflicts flattens a shape's method set (its own methods and every listed
// shape's, with the instance's type arguments bound) and reports a name that two shapes
// give different signatures, or that one shape declares twice. Identical methods from
// different listed shapes are allowed, as in Go. It returns how many errors it attributed
// to the owner, so the caller can mark the owner bad without claiming a listed shape's.
fn check_shape_conflicts(d i64, bind_ i64) i64 {
	shape_collecting = vec_new()
	shape_conflicts = 0
	shape_collect(cast(Decl, d), bind_, vec_new(), cast(Decl, d), vec_new())
	return shape_conflicts
}

fn shape_collect(sd Decl, bind_ i64, methods i64, owner Decl, own i64) {
	if shape_on_path(shape_cycles, cast(i64, sd)) != 0 || shape_collect_visited(cast(i64, sd), bind_) != 0 || shape_on_path(shape_bad, cast(i64, sd)) != 0 {
		return
	}
	vec_push(shape_collecting, pair(cast(i64, sd), bind_))
	let saved = ck_state_save()
	set_file(sd.file)
	ck_tbind = bind_
	mut i = 0
	for i < sd.union[VEC_LEN] {
		let m = cast(TypeExpr, vec_get(sd.union, i))
		let base = cast(Decl, shape_ref_name(m))
		// A member that check_shape_decl already rejected (a bare generic shape, a
		// non-generic one with arguments, a bad shape) is skipped so its error is not
		// reported once per listing.
		if cast(i64, base) != 0 && shape_on_path(shape_bad, cast(i64, base)) == 0 && ((base.tparams != 0 && m.args != 0) || (base.tparams == 0 && m.args == 0)) {
			// Under symbolic arguments the constraints cannot be checked here; with real
			// arguments (even inside a generic body) they can, and an error is sd's.
			let before_inst = error_count
			mut inst = 0
			if shape_member_symbolic(m, sd, bind_) != 0 {
				inst = shape_inst_soft(cast(i64, m))
			} else {
				inst = shape_inst(cast(i64, m))
			}
			if inst != 0 {
				shape_collect(cast(Decl, vec_get(inst, 0)), vec_get(inst, 1), methods, owner, vec_new())
			} else if error_count != before_inst && shape_on_path(shape_bad, cast(i64, sd)) == 0 {
				vec_push(shape_bad, cast(i64, sd))
			}
		}
		i = i + 1
	}
	i = 0
	for i < sd.shape_[VEC_LEN] {
		let f = cast(Fn, vec_get(sd.shape_, i))
		let before = error_count
		let sig = shape_sig_of(f, 0, bind_)
		if error_count != before {
			// The failing signature is sd's, not the owner's that listed it.
			if shape_on_path(shape_bad, cast(i64, sd)) == 0 {
				vec_push(shape_bad, cast(i64, sd))
			}
			ck_state_restore(saved)
			return
		}
		if sd == owner {
			// The same shape declaring one name twice is an error even when the two
			// signatures are identical (a listed shape may repeat a method).
			mut k = 0
			for k < own[VEC_LEN] {
				if streq(vec_get(own, k), f.name) != 0 {
					let e0 = err_code(f.pos, cstr("E524 SHAPE_METHOD_TWICE"))
					buf_str(e0, cstr("shape "))
					buf_str(e0, owner.name)
					buf_str(e0, cstr(" declares "))
					buf_str(e0, f.name)
					buf_str(e0, cstr(" twice"))
					err_end(e0)
					shape_conflicts = shape_conflicts + 1
				}
				k = k + 1
			}
			vec_push(own, f.name)
		}
		mut j = 0
		for j < methods[VEC_LEN] {
			let prev = vec_get(methods, j)
			if streq(vec_get(prev, 0), f.name) != 0 && shape_sig_same(vec_get(prev, 1), sig) == 0 {
				let e = err_code(f.pos, cstr("E525 SHAPE_METHOD_CONFLICT"))
				buf_str(e, cstr("shape "))
				buf_str(e, owner.name)
				buf_str(e, cstr(" has two methods named "))
				buf_str(e, f.name)
				buf_str(e, cstr(" with different signatures (one from a listed shape)"))
				err_end(e)
				shape_conflicts = shape_conflicts + 1
			}
			j = j + 1
		}
		let rec = vec_new()
		vec_push(rec, f.name)
		vec_push(rec, sig)
		vec_push(rec, cast(i64, f))
		vec_push(rec, bind_)
		vec_push(rec, cast(i64, sd))
		vec_push(methods, rec)
		i = i + 1
	}
	ck_state_restore(saved)
}

// dyn_table_add records the concrete methods behind one dyn shape. Its order is the
// flattened shape order with repeated identical methods emitted once.
fn dyn_table_add(t Ty, dt Ty, pos i64) i64 {
	mut i = 0
	for i < dyn_tables[VEC_LEN] {
		let old = vec_get(dyn_tables, i)
		if cast(Ty, vec_get(old, 0)) == t && cast(Ty, vec_get(old, 1)) == dt {
			return i
		}
		i = i + 1
	}
	let sd = dt.gdecl
	let bind_ = dt.targs
	let flat = vec_new()
	shape_collecting = vec_new()
	shape_collect(cast(Decl, sd), bind_, flat, cast(Decl, sd), vec_new())
	let names = vec_new()
	let fns = vec_new()
	i = 0
	for i < flat[VEC_LEN] {
		let item = vec_get(flat, i)
		let name = vec_get(item, 0)
		if vec_has_str(names, name) == 0 {
			mut f = shape_method(t, name)
			if f != 0 && is_template(cast(Fn, f)) != 0 {
				f = instantiate_fn(cast(Fn, f), t.targs, pos)
			}
			if f != 0 {
				vec_push(names, name)
				vec_push(fns, f)
			}
		}
		i = i + 1
	}
	let rec = vec_new()
	vec_push(rec, cast(i64, t))
	vec_push(rec, cast(i64, dt))
	vec_push(rec, keep_fn(t))
	vec_push(rec, fns)
	vec_push(rec, -1)
	vec_push(dyn_tables, rec)
	return dyn_tables[VEC_LEN] - 1
}

// dyn_shape_method returns [table method index, flattened signature] for a method on a
// dyn shape. Slot zero is reserved for keep, so method indices start at one.
fn dyn_shape_method(dt Ty, name i64) i64 {
	let sd = dt.gdecl
	let bind_ = dt.targs
	let flat = vec_new()
	shape_collecting = vec_new()
	shape_collect(cast(Decl, sd), bind_, flat, cast(Decl, sd), vec_new())
	let names = vec_new()
	mut i = 0
	for i < flat[VEC_LEN] {
		let item = vec_get(flat, i)
		let method = vec_get(item, 0)
		if vec_has_str(names, method) == 0 {
			if streq(method, name) != 0 {
				return pair(names[VEC_LEN] + 1, vec_get(item, 1))
			}
			vec_push(names, method)
		}
		i = i + 1
	}
	return 0
}

fn dyn_table_mark(i i64) {
	if i < 0 || i >= dyn_tables[VEC_LEN] {
		return
	}
	let rec = vec_get(dyn_tables, i)
	mark_reach(cast(Fn, vec_get(rec, 2)))
	let fns = vec_get(rec, 3)
	mut j = 0
	for j < fns[VEC_LEN] {
		mark_reach(cast(Fn, vec_get(fns, j)))
		j = j + 1
	}
}

// check_shape_decl validates a registered shape: its body lists shapes only, its union
// lists types only, and the listed shapes do not form a cycle. path holds the shapes on
// the way down; a cycle is reported once, at the shape that closes it, and every shape
// in it is remembered so the walk over it does not recurse forever or report again.
// Each name is resolved in the file that declares the shape, and a validated shape is
// remembered, so a shared sub-shape is walked once and diamonds do not cost 2^depth.
// A generic shape's body is validated with its parameters bound to fresh types, so a
// listed instance may mention them (`shape B[U] { A[U] }`) and its own cycle is caught.
fn check_shape_decl(d Decl, path i64) {
	if shape_on_path(shape_validated, cast(i64, d)) != 0 {
		return
	}
	let saved = ck_state_save()
	set_file(d.file)
	vec_push(shape_validated, cast(i64, d))
	// Only an error about d's own members marks d bad; an error inside a listed shape is
	// that shape's, and marking d too would skip its own signature checks in
	// shapes_declared (and lose them).
	mut mine = 0
	mut bind_ = 0
	if d.tparams != 0 {
		bind_ = shape_sym_bind(d)
	}
	if d.unionkind != 0 {
		mut i = 0
		for i < d.union[VEC_LEN] {
			let m = cast(Node, vec_get(d.union, i))
			if shape_ref_name(cast(TypeExpr, m)) != 0 {
				err_code_quoted(m.pos, cstr("E521 SHAPE_IN_UNION"), cstr("a named union lists concrete types, but "), shape_member_name(cast(i64, m)), cstr(" is a shape: list shapes in a shape body instead"))
				mine = 1
			}
			i = i + 1
		}
	} else {
		vec_push(path, cast(i64, d))
		ck_tbind = bind_
		mut i = 0
		for i < d.union[VEC_LEN] {
			let m = cast(Node, vec_get(d.union, i))
			let sub = cast(Decl, shape_ref_name(cast(TypeExpr, m)))
			if cast(i64, sub) == 0 {
				let nm = shape_member_name(cast(i64, m))
				if nm != 0 {
					let e = err_code(m.pos, cstr("E522 NOT_A_SHAPE"))
					buf_str(e, cstr("shape "))
					buf_str(e, d.name)
					buf_str(e, cstr(" lists "))
					buf_str(e, nm)
					buf_str(e, cstr(", which is not a shape"))
					err_end(e)
				} else {
					err_code_at(m.pos, cstr("E522 NOT_A_SHAPE"), cstr("a shape lists another shape by name"))
				}
				mine = 1
			} else if shape_on_path(path, cast(i64, sub)) != 0 {
				err_code_quoted(sub.pos, cstr("E523 SHAPE_CYCLE"), cstr("shape "), sub.name, cstr(" is composed of itself (directly or through other shapes)"))
				shape_mark_cycle(path, cast(i64, sub))
			} else {
				// Reports a missing type argument, a wrong count or extra arguments.
				let before_inst = error_count
				let inst = shape_inst_decl(cast(i64, m))
				if inst != 0 {
					check_shape_decl(sub, path)
				} else if error_count != before_inst {
					mine = 1
				}
			}
			i = i + 1
		}
		ck_tbind = saved[3]
		path[VEC_LEN] = path[VEC_LEN] - 1
	}
	if mine != 0 && shape_on_path(shape_bad, cast(i64, d)) == 0 {
		vec_push(shape_bad, cast(i64, d))
	}
	ck_state_restore(saved)
}

// shape_mark_cycle remembers the shapes from sub to the current top of path, the cycle
// itself, so no later walk reports them again.
fn shape_mark_cycle(path i64, sub i64) {
	mut j = 0
	mut marking = 0
	for j < path[VEC_LEN] {
		let on_ = vec_get(path, j)
		if on_ == sub {
			marking = 1
		}
		if marking != 0 && shape_on_path(shape_cycles, on_) == 0 {
			vec_push(shape_cycles, on_)
		}
		j = j + 1
	}
}

// shape_member_name is a listed shape's name for diagnostics, or 0 when the member is
// not a plain or qualified name.
fn shape_member_name(m i64) i64 {
	if cast(Node, m).kind != TX_NAME {
		return 0
	}
	return cast(TypeExpr, m).b
}

fn shape_on_path(path i64, d i64) i64 {
	mut i = 0
	for i < path[VEC_LEN] {
		if vec_get(path, i) == d {
			return 1
		}
		i = i + 1
	}
	return 0
}

// shape_seen reports whether the (shape, type, bindings) key is in a satisfaction set.
// The key matters: resolving a union member can check the same shape against a nested
// type while the outer check is in flight, and the outer type must not be suppressed by
// it; two instantiations of one shape are different keys.
fn shape_seen(v i64, sd i64, t i64, bind_ i64) i64 {
	mut i = 0
	for i < v[VEC_LEN] {
		let p = vec_get(v, i)
		if vec_get(p, 0) == sd && vec_get(p, 1) == t && shape_bind_same(vec_get(p, 2), bind_) != 0 {
			return 1
		}
		i = i + 1
	}
	return 0
}

// shape_seen_type reports whether the (shape, type) part of a key is on the path, under
// any bindings.
fn shape_seen_type(v i64, sd i64, t i64) i64 {
	mut i = 0
	for i < v[VEC_LEN] {
		let p = vec_get(v, i)
		if vec_get(p, 0) == sd && vec_get(p, 1) == t {
			return 1
		}
		i = i + 1
	}
	return 0
}

// shape_method returns the method t has under name, with the bindings that resolve its
// signature (sm_bind) and whether it is declared (sm_declared), or 0. A generic type's
// template is found through its declaration so satisfaction does not depend on the
// instance method having been declared already.
fn shape_method(t Ty, name i64) i64 {
	sm_bind = 0
	sm_declared = 0
	if kind_of(t) == K_DYN {
		// A dyn value's methods live in its table; check_shape handles it.
		return 0
	}
	if t.name == 0 {
		// An unnamed type (a slice, map, func, tuple, optional) has no methods; asking
		// for one must not build a qualified name from a null string.
		return 0
	}
	let d = cast(Decl, t.gdecl)
	if cast(i64, d) != 0 {
		sm_bind = tbind_pairs(d.tparams, t.targs)
		mut i = 0
		for i < d.methods[VEC_LEN] {
			let f = cast(Fn, vec_get(d.methods, i))
			if streq(f.name, name) != 0 {
				return cast(i64, f)
			}
			i = i + 1
		}
		return 0
	}
	let f = cast(Fn, find_fn(str_cat3(t.name, cstr("."), name)))
	if cast(i64, f) != 0 {
		sm_declared = 1
		return cast(i64, f)
	}
	return find_method_by_recv(cast(i64, t), name)
}

// find_method_by_recv finds a method declared on t before declare_fn ran, as it has
// not when a type alias's instance is checked during type resolution. A generic
// method template is skipped: its receiver type mentions the type parameters, which
// have no bindings here (shape_method finds those through their declaration).
fn find_method_by_recv(t i64, name i64) i64 {
	mut i = 0
	for i < prog_fns[VEC_LEN] {
		let f = cast(Fn, vec_get(prog_fns, i))
		if f.recv != 0 && f.tbind == 0 && f.tparams == 0 && f.name != 0 && streq(f.name, name) != 0 {
			let saved = ck_state_save()
			set_file(f.file)
			let rt = resolve_type(f.recv)
			ck_state_restore(saved)
			if rt == t {
				return cast(i64, f)
			}
		}
		i = i + 1
	}
	return 0
}

// shape_sig_type resolves one signature type expression; a declared function's types
// are already resolved and are used as they are.
fn shape_sig_type(x Node, bind_ i64) i64 {
	if x.kind < 40 {
		return cast(i64, x)
	}
	let saved = ck_tbind
	ck_tbind = bind_
	let t = resolve_type(cast(i64, x))
	ck_tbind = saved
	return t
}

// shape_sig_of returns [param names, param types, param muts, result types, variadic,
// mut result, fault] for a method. A declared method's parameter zero is its receiver,
// which a shape's signature does not carry, so it is skipped; receiver mutability is
// not part of satisfaction, only the call site's `mut` mark is.
fn shape_sig_of(f Fn, declared i64, bind_ i64) i64 {
	let ns = vec_new()
	let ps = vec_new()
	let ms = vec_new()
	mut i = 0
	if declared != 0 {
		i = 1
	}
	for i < f.ptypes[VEC_LEN] {
		vec_push(ns, vec_get(f.params, i))
		vec_push(ps, shape_sig_type(cast(Node, vec_get(f.ptypes, i)), bind_))
		vec_push(ms, vec_get(f.muts, i))
		i = i + 1
	}
	let rs = vec_new()
	i = 0
	for i < f.rtypes[VEC_LEN] {
		vec_push(rs, shape_sig_type(cast(Node, vec_get(f.rtypes, i)), bind_))
		i = i + 1
	}
	let sig = vec_new()
	vec_push(sig, ns)
	vec_push(sig, ps)
	vec_push(sig, ms)
	vec_push(sig, rs)
	vec_push(sig, f.variadic)
	vec_push(sig, f.mutres)
	vec_push(sig, f.bang)
	return sig
}

// A signature is a vec of [param names, param types, param muts, result types,
// variadic, mut result, fault], read with vec_get like every other vec.
fn shape_sig_same(a i64, b i64) i64 {
	let aps = vec_get(a, 1)
	let bps = vec_get(b, 1)
	if aps[VEC_LEN] != bps[VEC_LEN] || vec_get(a, 4) != vec_get(b, 4) || vec_get(a, 5) != vec_get(b, 5) || vec_get(a, 6) != vec_get(b, 6) {
		return 0
	}
	mut i = 0
	for i < aps[VEC_LEN] {
		if vec_get(aps, i) != vec_get(bps, i) || vec_get(vec_get(a, 2), i) != vec_get(vec_get(b, 2), i) {
			return 0
		}
		i = i + 1
	}
	let ars = vec_get(a, 3)
	let brs = vec_get(b, 3)
	if ars[VEC_LEN] != brs[VEC_LEN] {
		return 0
	}
	i = 0
	for i < ars[VEC_LEN] {
		if vec_get(ars, i) != vec_get(brs, i) {
			return 0
		}
		i = i + 1
	}
	return 1
}

// shape_sig_str writes a method signature the way it would be declared, so the error
// can show both sides: `Read(buf mut []u8) !i64`.
fn shape_sig_str(b i64, name i64, sig i64) {
	let ns = vec_get(sig, 0)
	let ps = vec_get(sig, 1)
	let ms = vec_get(sig, 2)
	let rs = vec_get(sig, 3)
	let variadic = vec_get(sig, 4)
	buf_str(b, name)
	buf_byte(b, '(')
	mut i = 0
	for i < ps[VEC_LEN] {
		if i > 0 {
			buf_str(b, cstr(", "))
		}
		let pn = vec_get(ns, i)
		if pn != 0 {
			buf_str(b, pn)
			buf_byte(b, ' ')
		}
		if variadic != 0 && i == ps[VEC_LEN] - 1 {
			buf_str(b, cstr("..."))
		} else if vec_get(ms, i) != 0 {
			buf_str(b, cstr("mut "))
		}
		type_name(b, cast(Ty, vec_get(ps, i)))
		i = i + 1
	}
	buf_byte(b, ')')
	mut n = rs[VEC_LEN]
	if vec_get(sig, 6) != 0 {
		buf_str(b, cstr(" !"))
		n = n - 1
		if n == 1 {
			type_name(b, cast(Ty, vec_get(rs, 0)))
		} else if n > 1 {
			shape_result_list(b, rs, n)
		}
	} else if n == 1 {
		buf_byte(b, ' ')
		if vec_get(sig, 5) != 0 {
			buf_str(b, cstr("mut "))
		}
		type_name(b, cast(Ty, vec_get(rs, 0)))
	} else if n > 1 {
		buf_byte(b, ' ')
		shape_result_list(b, rs, n)
	}
}

fn shape_result_list(b i64, rs i64, n i64) {
	buf_byte(b, '(')
	mut i = 0
	for i < n {
		if i > 0 {
			buf_str(b, cstr(", "))
		}
		type_name(b, cast(Ty, vec_get(rs, i)))
		i = i + 1
	}
	buf_byte(b, ')')
}

// check_shape reports why t does not satisfy sd, or nothing when it does. bind holds the
// type arguments of a generic shape instance (0 for a non-generic one), so `Seq[i64]`
// resolves its methods as i64. Composition is walked once per (shape, type, bindings) per
// satisfaction tree and never through a cycle, so a diamond costs its depth, not 2^depth,
// and a cycle reported at registration cannot recurse here.
// The constraints package exposes Any as an empty structural shape and Comparable as a
// compiler-checked property constraint. Keep the property named in the library API rather
// than treating the word as generic-parameter syntax.
fn constraints_shape(sd Decl, name i64) i64 {
	return i64(streq(vec_get(file_pkgs, sd.file), cstr("constraints")) != 0 && streq(sd.name, name) != 0)
}

fn check_shape(pos i64, t Ty, sd Decl, bind_ i64) {
	if shape_on_path(shape_bad, cast(i64, sd)) != 0 || shape_on_path(shape_cycles, cast(i64, sd)) != 0 {
		return
	}
	if constraints_shape(sd, cstr("Comparable")) != 0 {
		if key_valid(t, vec_new()) != 0 {
			return
		}
		let m = err_code(pos, cstr("E511 NOT_COMPARABLE"))
		buf_str(m, cstr("type "))
		type_name(m, t)
		buf_str(m, cstr(" does not satisfy shape Comparable: it is not comparable"))
		err_end(m)
		return
	}
	if kind_of(t) == K_DYN {
		if cast(Decl, t.gdecl) == sd && shape_bind_same(t.targs, bind_) != 0 {
			return
		}
		if constraints_shape(sd, cstr("Any")) != 0 {
			return
		}
		err_code_at(pos, cstr("E514 DYN_WIDENING"), cstr("a dyn value satisfies its own shape only; dyn-to-dyn widening is the next step (#141)"))
		return
	}
	if shape_checking[VEC_LEN] == 0 {
		shape_checked = vec_new()
	}
	if shape_seen(shape_checking, cast(i64, sd), cast(i64, t), bind_) != 0 || shape_seen(shape_checked, cast(i64, sd), cast(i64, t), bind_) != 0 {
		return
	}
	// The same shape and type under a different instantiation means the composition
	// recurses through type arguments (`shape G[T] { G[Box[T]] }`); the cycle is reported
	// at declaration, and stopping here keeps the walk finite.
	if shape_seen_type(shape_checking, cast(i64, sd), cast(i64, t)) != 0 {
		return
	}
	vec_push(shape_checked, shape_key(cast(i64, sd), cast(i64, t), bind_))
	vec_push(shape_checking, shape_key(cast(i64, sd), cast(i64, t), bind_))
	let saved = ck_state_save()
	set_file(sd.file)
	ck_tbind = bind_
	if sd.unionkind != 0 {
		mut ok = 0
		mut j = 0
		for j < sd.union[VEC_LEN] {
			if cast(Ty, resolve_type(vec_get(sd.union, j))) == t {
				ok = 1
			}
			j = j + 1
		}
		if ok == 0 {
			let m = err_code(pos, cstr("E510 NOT_IN_UNION"))
			buf_str(m, cstr("type "))
			type_name(m, t)
			buf_str(m, cstr(" is not in shape "))
			buf_str(m, sd.name)
			buf_str(m, cstr(": want one of "))
			shape_union_str(m, sd)
			err_end(m)
		}
		shape_checking[VEC_LEN] = shape_checking[VEC_LEN] - 1
		ck_state_restore(saved)
		return
	}
	mut j = 0
	for j < sd.union[VEC_LEN] {
		let inst = shape_inst(vec_get(sd.union, j))
		if inst != 0 {
			check_shape(pos, t, cast(Decl, vec_get(inst, 0)), vec_get(inst, 1))
		}
		j = j + 1
	}
	mut i = 0
	for i < sd.shape_[VEC_LEN] {
		if check_shape_method(pos, cast(i64, t), sd, cast(Fn, vec_get(sd.shape_, i)), bind_) == 0 {
			i = sd.shape_[VEC_LEN]
		} else {
			i = i + 1
		}
	}
	shape_checking[VEC_LEN] = shape_checking[VEC_LEN] - 1
	ck_state_restore(saved)
}

// shape_key is the (shape, type, bindings) triple a satisfaction tree is memoized on.
fn shape_key(sd i64, t i64, bind_ i64) i64 {
	let k = vec_new()
	vec_push(k, sd)
	vec_push(k, t)
	vec_push(k, bind_)
	return k
}

fn shape_union_str(b i64, sd Decl) {
	mut i = 0
	for i < sd.union[VEC_LEN] {
		if i > 0 {
			buf_str(b, cstr(" | "))
		}
		type_name(b, cast(Ty, resolve_type(vec_get(sd.union, i))))
		i = i + 1
	}
}

// check_shape_method reports whether t has want's method with want's signature. bind
// resolves a generic shape's method types. It returns 0 when the shape's own signature
// could not be resolved (already reported), so the caller stops rather than reporting
// the same missing type once per method.
fn check_shape_method(pos i64, t i64, sd Decl, want Fn, bind_ i64) i64 {
	let before = error_count
	let wsig = shape_sig_of(want, 0, bind_)
	if error_count != before {
		if shape_on_path(shape_bad, cast(i64, sd)) == 0 {
			vec_push(shape_bad, cast(i64, sd))
		}
		return 0
	}
	let cand = cast(Fn, shape_method(cast(Ty, t), want.name))
	if cast(i64, cand) == 0 {
		let m = err_code(pos, cstr("E512 MISSING_METHOD"))
		buf_str(m, cstr("type "))
		type_name(m, cast(Ty, t))
		buf_str(m, cstr(" does not satisfy shape "))
		buf_str(m, sd.name)
		buf_str(m, cstr(": it has no method "))
		shape_sig_str(m, want.name, wsig)
		buf_str(m, cstr("; fix-it: add method "))
		shape_sig_str(m, want.name, wsig)
		err_end(m)
		return 1
	}
	// The candidate's types belong to the file that declares the method, not the shape's.
	let saved = ck_state_save()
	set_file(cand.file)
	let csig = shape_sig_of(cand, sm_declared, sm_bind)
	ck_state_restore(saved)
	if shape_sig_same(wsig, csig) == 0 {
		let m = err_code(pos, cstr("E513 METHOD_SIGNATURE"))
		buf_str(m, cstr("type "))
		type_name(m, cast(Ty, t))
		buf_str(m, cstr(" does not satisfy shape "))
		buf_str(m, sd.name)
		buf_str(m, cstr(": method "))
		shape_sig_str(m, want.name, csig)
		buf_str(m, cstr(" has the wrong signature, want "))
		shape_sig_str(m, want.name, wsig)
		buf_str(m, cstr("; fix-it: change the method signature to "))
		shape_sig_str(m, want.name, wsig)
		err_end(m)
	}
	return 1
}
