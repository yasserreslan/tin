// tinc: the self-hosted Tin compiler.
// Usage: tinc [-o OUT] FILE.tin...   write a native executable (default a.out)
//        tinc -S FILE.tin...         print assembly instead

extern fn getenv(name);
extern fn realpath(path, resolved);
extern fn opendir(path);
extern fn readdir(dir);
extern fn closedir(dir);
extern fn strcmp(a, b);
extern fn uname(buf);

var lib_root;

// read_file returns a buffer holding the whole file, or 0 if it cannot be opened.
fn try_read_file(path) {
    let fd = open(path, 0);
    // open returns a C int: only the low 32 bits of x0 are defined.
    if (fd & 0x80000000) != 0 {
        return 0;
    }
    let b = buf_new();
    while 1 {
        buf_reserve(b, 65536);
        let n = read(fd, b[VEC_DATA] + b[VEC_LEN], 65536);
        if n <= 0 {
            break;
        }
        b[VEC_LEN] = b[VEC_LEN] + n;
    }
    close(fd);
    return b;
}

fn read_file(path) {
    let b = try_read_file(path);
    if !b {
        let e = err_begin(NO_POS);
        buf_str(e, "cannot open ");
        buf_str(e, path);
        fatal(e);
    }
    return b;
}

// os_suffix is the file-name suffix of the target's OS-specific library files.
fn os_suffix() {
    if tgt_linux {
        return "_linux";
    }
    return "_darwin";
}

// arch_suffix is the file-name suffix of the target's CPU-specific library files.
fn arch_suffix() {
    if tgt_x64 {
        return "_amd64";
    }
    return "_arm64";
}

// host_is_linux asks uname which kernel the compiler is running on.
fn host_is_linux() {
    let u = calloc(1280, 1);
    uname(u);
    return load8(u) == 'L';
}

// host_is_x64 asks uname whether a Linux host's CPU is x86-64 (machine is the fifth 65-byte field).
fn host_is_x64() {
    let u = calloc(1280, 1);
    uname(u);
    return load8(u) == 'L' && streq(u + 4 * 65, "x86_64");
}

// set_target parses darwin-arm64, linux-arm64 or linux-amd64.
fn set_target(t) {
    if streq(t, "darwin-arm64") {
        tgt_linux = 0;
        tgt_x64 = 0;
    } else if streq(t, "linux-arm64") {
        tgt_linux = 1;
        tgt_x64 = 0;
    } else if streq(t, "linux-amd64") {
        tgt_linux = 1;
        tgt_x64 = 1;
    } else {
        let e = err_begin(NO_POS);
        buf_str(e, "unknown target ");
        buf_str(e, t);
        buf_str(e, " (darwin-arm64, linux-arm64, linux-amd64)");
        fatal(e);
    }
}

fn usage() {
    let u = buf_new();
    buf_str(u, "usage: tinc [-S] [-o OUT] [-target darwin-arm64|linux-arm64|linux-amd64] FILE.tin...\n");
    write_all(2, u);
    return 2;
}

// find_root locates the Tin tree (with lib/) from $TIN_ROOT or this executable's path.
fn find_root() {
    let env = getenv("TIN_ROOT");
    if env {
        return env;
    }
    let raw = calloc(4096, 1);
    host_exe_path(raw, 4096);
    let real = calloc(4096, 1);
    if !realpath(raw, real) {
        return ".";
    }
    // .../bin/tinc -> ...
    let n = strlen(real);
    let cut = 0;
    let i = n - 1;
    while i > 0 && cut < 2 {
        if load8(real + i) == '/' {
            cut = cut + 1;
            store8(real + i, 0);
        }
        i = i - 1;
    }
    return real;
}

fn load_file(path) {
    load_file_trusted(path, 0);
}

// Standard library files may use the runtime's raw memory operations.
fn load_file_trusted(path, trusted) {
    let src = read_file(path);
    vec_push(files, path);
    vec_push(file_trusted, trusted);
    cur_file = files[VEC_LEN] - 1;
    parse(lex(cur_file, src[VEC_DATA], src[VEC_LEN]));
}

fn is_loaded(path) {
    let i = 0;
    while i < files[VEC_LEN] {
        if streq(vec_get(files, i), path) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// lib_path is root/lib/<import path>.tin.
fn lib_path(ipath) {
    let b = buf_new();
    buf_str(b, lib_root);
    buf_str(b, "/lib/");
    buf_str(b, ipath);
    buf_str(b, ".tin");
    buf_byte(b, 0);
    return b[VEC_DATA];
}

fn cat_path(a, b) {
    let p = buf_new();
    buf_str(p, a);
    buf_str(p, b);
    buf_byte(p, 0);
    return p[VEC_DATA];
}

// dir_of is the directory part of a file path ("." when there is none).
fn dir_of(path) {
    let n = strlen(path);
    let i = n - 1;
    while i >= 0 && load8(path + i) != '/' {
        i = i - 1;
    }
    if i < 0 {
        return ".";
    }
    let b = buf_new();
    let j = 0;
    while j < i {
        buf_byte(b, load8(path + j));
        j = j + 1;
    }
    buf_byte(b, 0);
    return b[VEC_DATA];
}

fn ends_with(s, suffix) {
    let n = strlen(s);
    let m = strlen(suffix);
    return n >= m && streq(s + n - m, suffix);
}

// package_files returns the files of the package at base: base.tin, or every .tin file in
// the directory base (tests excluded), sorted; 0 if neither exists.
fn package_files(base) {
    let single = cat_path(base, ".tin");
    let probe = try_read_file(single);
    if probe {
        let one = vec_new();
        vec_push(one, single);
        // name_linux.tin / name_darwin.tin: the target OS's part of the package.
        let osf = cat_path(cat_path(base, os_suffix()), ".tin");
        if try_read_file(osf) {
            vec_push(one, osf);
        }
        // name_linux_amd64.tin: the part that depends on the CPU too (struct layouts).
        let archf = cat_path(cat_path(cat_path(base, os_suffix()), arch_suffix()), ".tin");
        if try_read_file(archf) {
            vec_push(one, archf);
        }
        return one;
    }
    let d = opendir(base);
    if !d {
        return 0;
    }
    let out = vec_new();
    while 1 {
        let ent = readdir(d);
        if !ent {
            break;
        }
        let name = host_dirent_name(ent);
        if ends_with(name, ".tin") && !ends_with(name, "_test.tin") && load8(name) != '.' && !other_os_file(name) {
            vec_push(out, cat_path(cat_path(base, "/"), name));
        }
    }
    closedir(d);
    // Sorted, so builds do not depend on directory order.
    let i = 1;
    while i < out[VEC_LEN] {
        let j = i;
        while j > 0 && c_positive(strcmp(vec_get(out, j - 1), vec_get(out, j))) {
            let t = vec_get(out, j);
            out[VEC_DATA][j] = vec_get(out, j - 1);
            out[VEC_DATA][j - 1] = t;
            j = j - 1;
        }
        i = i + 1;
    }
    if out[VEC_LEN] == 0 {
        return 0;
    }
    return out;
}

// resolve_import finds an import's files: ./x and ../x next to the importing file,
// otherwise the standard library, then the main program's directory.
fn resolve_import(ipath, from) {
    if load8(ipath) == '.' {
        return package_files(cat_path(cat_path(dir_of(from), "/"), ipath));
    }
    let std = package_files(cat_path(cat_path(lib_root, "/lib/"), ipath));
    if std {
        return std;
    }
    return package_files(cat_path(cat_path(dir_of(vec_get(files, 0)), "/"), ipath));
}

// load_imports parses every package any loaded file imports, transitively.
fn load_imports() {
    let f = 0;
    while f < files[VEC_LEN] {
        let imps = vec_get(file_imports, f);
        let i = 0;
        while i < imps[VEC_LEN] {
            let ipath = vec_get(vec_get(imps, i), 1);
            let found = resolve_import(ipath, vec_get(files, f));
            if !found {
                let e = err_begin(NO_POS);
                buf_str(e, "unknown package \"");
                buf_str(e, ipath);
                buf_str(e, "\" (looked in the standard library, next to the importing file and in the program's directory)");
                fatal(e);
            }
            let k = 0;
            while k < found[VEC_LEN] {
                let path = vec_get(found, k);
                if !is_loaded(path) {
                    // Only the standard library may use the raw operations.
                    load_file_trusted(path, starts_with(path, cat_path(lib_root, "/lib/")));
                }
                k = k + 1;
            }
            i = i + 1;
        }
        f = f + 1;
    }
}

// other_os_file reports whether a file belongs to the other OS (x_linux.tin on macOS).
fn other_os_file(name) {
    if tgt_linux {
        return ends_with(name, "_darwin.tin") || ends_with(name, other_arch_suffix());
    }
    return ends_with(name, "_linux.tin") || ends_with(name, "_linux_arm64.tin") || ends_with(name, "_linux_amd64.tin");
}

fn other_arch_suffix() {
    if tgt_x64 {
        return "_arm64.tin";
    }
    return "_amd64.tin";
}

// c_positive reports whether a C int result (low 32 bits) is above zero.
fn c_positive(r) {
    let w = r & 0xffffffff;
    return w != 0 && (w & 0x80000000) == 0;
}

fn starts_with(s, prefix) {
    let i = 0;
    while load8(prefix + i) != 0 {
        if load8(s + i) != load8(prefix + i) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

fn main(argc, argv) {
    files = vec_new();
    file_trusted = vec_new();
    parse_setup();
    types_init();
    let asm_only = 0;
    let out_path = "a.out";
    tgt_linux = host_is_linux();
    tgt_x64 = host_is_x64();
    let i = 1;
    while i < argc {
        let a = argv[i];
        if streq(a, "-target") && i + 1 < argc {
            i = i + 1;
            set_target(argv[i]);
        } else if streq(a, "-S") {
            asm_only = 1;
        } else if streq(a, "-o") && i + 1 < argc {
            i = i + 1;
            out_path = argv[i];
        } else {
            load_file(a);
        }
        i = i + 1;
    }
    if files[VEC_LEN] == 0 {
        return usage();
    }
    let v2 = 0;
    i = 0;
    while i < file_v2[VEC_LEN] {
        if vec_get(file_v2, i) {
            v2 = 1;
        }
        i = i + 1;
    }
    if v2 {
        lib_root = find_root();
        let rt = lib_path("runtime");
        if !is_loaded(rt) {
            load_file_trusted(rt, 1);
            let rtos = lib_path(cat_path("runtime", os_suffix()));
            if try_read_file(rtos) && !is_loaded(rtos) {
                load_file_trusted(rtos, 1);
            }
            let rtarch = lib_path(cat_path(cat_path("runtime", os_suffix()), arch_suffix()));
            if try_read_file(rtarch) && !is_loaded(rtarch) {
                load_file_trusted(rtarch, 1);
            }
        }
        load_imports();
    }
    check();
    if error_count > 0 {
        return 1;
    }
    if v2 {
        region_check();
        if error_count > 0 {
            return 1;
        }
    }
    generate();
    if error_count > 0 {
        return 1;
    }
    if asm_only && tgt_x64 {
        write_all(1, print_asm_x64());
    } else if asm_only {
        write_all(1, print_asm());
    } else if tgt_x64 {
        write_elf_x64(out_path);
    } else if tgt_linux {
        write_elf(out_path);
    } else {
        write_executable(out_path);
    }
    return 0;
}
