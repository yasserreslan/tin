// The compiler's own Linux host calls (see host_darwin.tin).


fn host_exe_path(buf, n) {
    let k = rt_sys_readlink("/proc/self/exe", buf, n - 1);
    if (k & 0x80000000) != 0 {
        k = 0;
    }
    store8(buf + (k & 0xffffffff), 0);
}

fn host_dirent_name(ent) {
    return ent + 19;
}

extern fn sysconf(name);
fn host_mem_flags() { return 0x22; }
fn host_mem_page() { return sysconf(30); }

var hostError;
fn linux_set_errno(e) { hostError=e; }
fn linux_get_errno() { return hostError; }
fn linux_restorer_ptr() { return 0; }
fn linux_vdso_clock(id,ts) { return linux_raw(linux_nr_clock_gettime(),id,ts,0,0,0,0); }
