// The compiler's own Linux host calls (see host_darwin.tin).
fn host_exe_path(buf i64, n i64) {
	mut k = rt_sys_readlink(rt_cstr("/proc/self/exe"), buf, n - 1)
	if (k & 0x80000000) != 0 {
		k = 0
	}
	store8(buf + (k & 0xffffffff), 0)
}

fn host_dirent_name(ent i64) i64 {
	return ent + 19
}

// The environment and the auxiliary vector follow argv's NULL on the initial stack (the same
// layout under glibc's start and Tin's own _start); host_start records where, first thing in
// main, so the compiler needs no libc getenv or getauxval (#125).
shared mut host_envp i64
shared mut host_auxv i64

fn host_start(argc i64, argv i64) {
	let env = argv + 8 * (argc + 1)
	mut n = 0
	for env[n] != 0 {
		n = n + 1
	}
	host_envp = env
	host_auxv = env + 8 * (n + 1)
}

// host_getenv is the value of the C string name as a C string, or 0 when it is unset.
fn host_getenv(name str) i64 {
	if host_envp == 0 {
		return 0
	}
	mut i = 0
	for host_envp[i] != 0 {
		let e = host_envp[i]
		mut k = 0
		for k < len(name) && i64(load8(e + k)) == i64(name[k]) {
			k = k + 1
		}
		if k == len(name) && i64(load8(e + k)) == '=' {
			return e + k + 1
		}
		i = i + 1
	}
	return 0
}

// host_auxval is the auxv value of key (6: AT_PAGESZ), or 0 when absent.
fn host_auxval(key i64) i64 {
	if host_auxv == 0 {
		return 0
	}
	mut p = host_auxv
	for p[0] != 0 {
		if p[0] == key {
			return p[1]
		}
		p = p + 16
	}
	return 0
}

// Canonicalization follows Linux symlinks before reducing .., with PATH_MAX and hop bounds.
fn host_realpath_work(path i64, resolved i64, pending i64, target i64, merged i64, st i64) i64 {
	let n = host_c_len(path)
	if n == 0 || n >= 4096 {
		return 0
	}
	if i64(load8(path)) == '/' {
		memcpy(pending, path, n + 1)
	} else {
		if rt_sys_getcwd(target, 4096) == 0 {
			return 0
		}
		let cwd = host_c_len(target)
		if cwd + n + 1 >= 4096 {
			return 0
		}
		memcpy(pending, target, cwd)
		store8(pending + cwd, '/')
		memcpy(pending + cwd + 1, path, n + 1)
	}
	mut used = 1
	store8(resolved, '/')
	store8(resolved + 1, 0)
	mut cursor = 0
	mut hops = 0
	for {
		for i64(load8(pending + cursor)) == '/' {
			cursor = cursor + 1
		}
		if i64(load8(pending + cursor)) == 0 {
			return resolved
		}
		let begin = cursor
		for i64(load8(pending + cursor)) != 0 && i64(load8(pending + cursor)) != '/' {
			cursor = cursor + 1
		}
		let len_ = cursor - begin
		if len_ == 1 && i64(load8(pending + begin)) == '.' {
			continue
		}
		if len_ == 2 && i64(load8(pending + begin)) == '.' && i64(load8(pending + begin + 1)) == '.' {
			for used > 1 && i64(load8(resolved + used - 1)) != '/' {
				used = used - 1
			}
			if used > 1 {
				used = used - 1
			}
			store8(resolved + used, 0)
			continue
		}
		let parent = used
		if used > 1 {
			store8(resolved + used, '/')
			used = used + 1
		}
		if used + len_ >= 4096 {
			return 0
		}
		memcpy(resolved + used, pending + begin, len_)
		used = used + len_
		store8(resolved + used, 0)
		if rt_sys_lstat(resolved, st) != 0 {
			return 0
		}
		let kind = linux_stat_type(st)
		if kind == 10 {
			hops = hops + 1
			if hops > 40 {
				return 0
			}
			let k = rt_sys_readlink(resolved, target, 4096)
			if k <= 0 || k >= 4096 {
				return 0
			}
			store8(target + k, 0)
			let rest = host_c_len(pending + cursor)
			if k + rest >= 4096 {
				return 0
			}
			memcpy(merged, target, k)
			memcpy(merged + k, pending + cursor, rest + 1)
			memcpy(pending, merged, k + rest + 1)
			cursor = 0
			used = parent
			if i64(load8(target)) == '/' {
				used = 1
			}
			store8(resolved + used, 0)
		} else if i64(load8(pending + cursor)) != 0 && kind != 4 {
			return 0
		}
	}
	return 0
}

fn host_realpath(path str, resolved i64) i64 {
	let pending = calloc(4096, 1)
	let target = calloc(4096, 1)
	let merged = calloc(4096, 1)
	let st = calloc(256, 1)
	let result = host_realpath_work(rt_cstr(path), resolved, pending, target, merged, st)
	free(pending)
	free(target)
	free(merged)
	free(st)
	return result
}

// host_str is the compiler string for the C string at p, which the operating system or the C library
// handed back (an argument, an environment value, a directory entry name, a resolved path).
fn host_str(p i64) str {
	return rt_str_from_raw(p, host_c_len(p))
}

// host_c_len is the length of the C string at p.
fn host_c_len(p i64) i64 {
	mut n = 0
	for i64(load8(p + n)) != 0 {
		n = n + 1
	}
	return n
}

fn host_creat(path str, mode i64) i64 {
	return rt_sys_creat(rt_cstr(path), mode)
}

fn host_unlink(path str) i64 {
	return rt_sys_unlink(rt_cstr(path))
}

fn host_opendir(path str) i64 {
	return rt_sys_opendir(rt_cstr(path))
}
