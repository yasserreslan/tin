// x86-64 code generator: checked AST to the asm_x64.tin instruction list, mirroring gen.tin.
//
// System V ABI: arguments in rdi, rsi, rdx, rcx, r8, r9 and xmm0-xmm7, results in rax and
// xmm0 (several results travel in rax, rdx, rcx, rsi, rdi, r8, r9, r10 as bits). Locals
// whose address is never taken live in the callee-saved rbx, r12, r13, r14 (floats in
// xmm8-xmm14 when calls stay outside loops, else in frame slots); expressions evaluate into the
// temporaries rsi, rdi, r8, r9, r10 and leftover callee-saved registers, indexed by depth.
// rax, rcx, rdx, r11 and xmm15 are scratch (rax/rdx for division, rcx for shift counts),
// so they are never allocated. r15 holds the thread context, rbp the frame pointer.
// Pushes reserve 16 bytes so the stack stays aligned at every call.
const R8 = 8
const R9 = 9
const R10 = 10
const R11 = 11
const R12 = 12
const R13 = 13
const R14 = 14
const R15 = 15
const XSCR = 11 // r11: the first scratch register (gen.tin's x16)
const XSCR2 = 1 // rcx: the second scratch register (gen.tin's x17)
const XCTX = 15 // r15: the thread context (gen.tin's x28)
const XFSCR = 79 // xmm15: float scratch
const XP_RET = 100 // pseudo return, expanded into the epilogue by x_finish_fn

shared mut mm_scale i64 // x_gen_mem_addr result: the index scale (1, 2, 4 or 8)
shared mut cmp_unord i64 // x_gen_compare result: 1 when unordered means false, 2 when true
shared mut x_syms []i64 // symbol table: id -> sym_ref word (memory operands only hold 32 bits)
shared mut x_fn_labels []i64 // function index -> entry label
shared mut x_nstack i64 // stack parameters of the current function
shared mut x_div_label i64 // the current function's divide-by-zero stub, once used
shared mut x_ovf_labels []i64 // the current function's overflow stub per OVK_* kind, 0 until used (#362)

fn x_label(l i64) {
	emit1(X_LABEL, l)
}

// x_sym registers a sym_ref word and returns the id instructions refer to it by.
fn x_sym(kind i64, index i64) i64 {
	x_syms = append(x_syms, sym_ref(kind, index))
	return len(x_syms) - 1
}

// x64_fn_name returns the name of the function a direct call's symbol id refers to, for
// the -S listing; 0 for any other symbol kind or an unset table. x_syms is owned here,
// so asm_x64.tin (which the encoder fuzzer builds alone) only sees the wrapper.
fn x64_fn_name(id i64) str {
	if cast(i64, x_syms) == 0 || id < 0 || id >= len(x_syms) {
		return ""
	}
	let sym = cast([]i64, x_syms)[id]
	if sym >> 32 != SK_FN {
		return ""
	}
	let index = sym & 0xffffffff
	if index >= len(prog_fns) {
		return ""
	}
	let f = prog_fns[index]
	if len(f.qname) != 0 {
		return f.qname
	}
	return ""
}

fn x_mem1(base i64, off i64) i64 {
	return x64_mem(base, XM_NONE, 1, off)
}

// x_mov copies between registers of either class (across classes it moves the bits).
fn x_mov(dst i64, src i64) {
	if dst == src {
		return
	}
	if is_fp(dst) != 0 && is_fp(src) != 0 {
		emit2(X_MOVSD, dst, src)
	} else if is_fp(dst) != 0 || is_fp(src) != 0 {
		emit2(X_MOVQ, dst, src)
	} else {
		emit2(X_MOV_RR, dst, src)
	}
}

fn x_load_imm(dst i64, v i64) {
	if is_fp(dst) != 0 {
		if v == 0 {
			emit2(X_XORPD, dst, dst)
		} else {
			emit2(X_MOV_RI, XSCR, v)
			emit2(X_MOVQ, dst, XSCR)
		}
		return
	}
	emit2(X_MOV_RI, dst, v)
}

// x_ld loads from memory operand m: a sized integer load (kind as X_LOAD) or a double.
fn x_ld(dst i64, m i64, kind i64) {
	if is_fp(dst) != 0 && (kind & 3) == 2 {
		// An f32 in memory becomes the f64 with the same value in a register.
		emit2(X_MOVSS_LD, dst, m)
		emit2(X_CVTSS2SD, dst, dst)
	} else if is_fp(dst) != 0 {
		emit2(X_MOVSD_LD, dst, m)
	} else {
		emit3(X_LOAD, dst, m, kind)
	}
}

fn x_st(src i64, m i64, size i64) {
	if is_fp(src) != 0 && size == 2 {
		emit2(X_CVTSD2SS, XFSCR, src)
		emit2(X_MOVSS_ST, XFSCR, m)
	} else if is_fp(src) != 0 {
		emit2(X_MOVSD_ST, src, m)
	} else {
		emit3(X_STORE, src, m, size)
	}
}

// x_push and x_pop spill through 16-byte slots so rsp stays 16-byte aligned.
fn x_push(r i64) {
	emit2(X_SUBI, RSP, 16)
	x_st(r, x_mem1(RSP, 0), 3)
}

fn x_pop(r i64) {
	x_ld(r, x_mem1(RSP, 0), 3)
	emit2(X_ADDI, RSP, 16)
}

fn x_slot_load(dst i64, off i64) {
	x_ld(dst, x_mem1(RBP, off), 3)
}

fn x_slot_store(r i64, off i64) {
	x_st(r, x_mem1(RBP, off), 3)
}

// ---- conditions ----
fn x_cond(op str) i64 {
	if op == "==" {
		return XC_E
	}
	if op == "!=" {
		return XC_NE
	}
	if op == "<" {
		return XC_L
	}
	if op == "<=" {
		return XC_LE
	}
	if op == ">" {
		return XC_G
	}
	if op == ">=" {
		return XC_GE
	}
	return -1
}

fn x_ucond(op str) i64 {
	if op == "<" {
		return XC_B
	}
	if op == "<=" {
		return XC_BE
	}
	if op == ">" {
		return XC_A
	}
	if op == ">=" {
		return XC_AE
	}
	return x_cond(op)
}

// x_swap_cc is the condition for the same comparison with its operands exchanged.
fn x_swap_cc(cc i64) i64 {
	if cc == XC_L {
		return XC_G
	}
	if cc == XC_G {
		return XC_L
	}
	if cc == XC_LE {
		return XC_GE
	}
	if cc == XC_GE {
		return XC_LE
	}
	if cc == XC_B {
		return XC_A
	}
	if cc == XC_A {
		return XC_B
	}
	if cc == XC_BE {
		return XC_AE
	}
	if cc == XC_AE {
		return XC_BE
	}
	return cc
}

// x_jcc branches to target when cc holds; after a float compare (unord != 0) an unordered
// result makes == false and != true, which takes a parity check as well.
fn x_jcc(cc i64, unord i64, target i64) {
	if unord == 0 || (cc != XC_E && cc != XC_NE) {
		emit2(X_JCC, cc, target)
	} else if cc == XC_E {
		let skip = new_label()
		emit2(X_JCC, XC_P, skip)
		emit2(X_JCC, XC_E, target)
		x_label(skip)
	} else {
		emit2(X_JCC, XC_P, target)
		emit2(X_JCC, XC_NE, target)
	}
}

// x_setcc materializes cc as 0 or 1 in dst.
fn x_setcc(dst i64, cc i64, unord i64) {
	emit2(X_SETCC, dst, cc)
	emit3(X_ZXT, dst, dst, 0)
	if unord != 0 && cc == XC_E {
		emit2(X_SETCC, XSCR, XC_NP)
		emit3(X_ZXT, XSCR, XSCR, 0)
		emit2(X_AND, dst, XSCR)
	} else if unord != 0 && cc == XC_NE {
		emit2(X_SETCC, XSCR, XC_P)
		emit3(X_ZXT, XSCR, XSCR, 0)
		emit2(X_OR, dst, XSCR)
	}
}

fn x_cmp_imm(a i64, c i64) {
	if x64_fits32(c) != 0 {
		emit2(X_CMPI, a, c)
	} else {
		x_load_imm(XSCR, c)
		emit2(X_CMP, a, XSCR)
	}
}

// x_test_imm tests a against a mask (an imm32 is sign-extended, so big masks go through r11).
fn x_test_imm(a i64, mask i64) {
	if mask >= 0 && mask <= 0x7fffffff {
		emit2(X_TESTI, a, mask)
	} else {
		x_load_imm(XSCR, mask)
		emit2(X_TEST, a, XSCR)
	}
}

// ---- arithmetic ----
// x_binop emits dst = a op b with a two-operand instruction; the scratch register of the
// class covers dst aliasing the right operand of a non-commutative operation.
fn x_binop(op i64, dst i64, a i64, b i64, comm i64) {
	if dst == a {
		emit2(op, dst, b)
		return
	}
	if dst == b {
		if comm != 0 {
			emit2(op, dst, a)
			return
		}
		mut scr = XSCR
		if is_fp(dst) != 0 {
			scr = XFSCR
		}
		x_mov(scr, b)
		x_mov(dst, a)
		emit2(op, dst, scr)
		return
	}
	x_mov(dst, a)
	emit2(op, dst, b)
}

// x_shift emits dst = a shifted by the count in register b (the count must be in cl).
fn x_shift(op i64, dst i64, a_in i64, b i64) {
	mut a = a_in
	if b == RCX {
		if dst == RCX {
			x_mov(XSCR, a)
			emit1(op, XSCR)
			x_mov(RCX, XSCR)
		} else {
			x_mov(dst, a)
			emit1(op, dst)
		}
		return
	}
	if dst == RCX {
		x_mov(XSCR, a)
		x_mov(RCX, b)
		emit1(op, XSCR)
		x_mov(RCX, XSCR)
		return
	}
	if a == RCX {
		x_mov(XSCR, a)
		a = XSCR
	}
	x_mov(RCX, b)
	x_mov(dst, a)
	emit1(op, dst)
}

// x_div_stub is the label of the current function's divide-by-zero panic stub.
fn x_div_stub() i64 {
	if x_div_label == 0 {
		x_div_label = new_label()
	}
	return x_div_label
}

// x_divide emits dst = a / b (or a % b with rem) through rdx:rax, panicking on a zero divisor
// except in the compiler-generated start-up functions (they get 0, or a for the remainder) and giving the wrapped result
// for the most negative value / -1, as the arm64 instructions do.
fn x_divide(dst i64, a i64, b_in i64, unsigned i64, rem i64) {
	mut b = b_in
	if b == RAX || b == RDX {
		x_mov(RCX, b)
		b = RCX
	}
	let strict = i64(cast(Fn, cur_gen_fn).generated == 0)
	mut zero_l = 0
	if strict != 0 {
		zero_l = x_div_stub()
	} else {
		zero_l = new_label()
	}
	let done_l = new_label()
	mut neg_l = 0
	if unsigned == 0 {
		neg_l = new_label()
		emit2(X_CMPI, b, -1)
		emit2(X_JCC, XC_E, neg_l)
	}
	emit2(X_TEST, b, b)
	emit2(X_JCC, XC_E, zero_l)
	x_mov(RAX, a)
	if unsigned != 0 {
		emit2(X_XOR, RDX, RDX)
		emit1(X_DIV, b)
	} else {
		emit1(X_CQO, 0)
		emit1(X_IDIV, b)
	}
	if rem != 0 {
		x_mov(dst, RDX)
	} else {
		x_mov(dst, RAX)
	}
	emit1(X_JMP, done_l)
	if unsigned == 0 {
		x_label(neg_l)
		if rem != 0 {
			x_load_imm(dst, 0)
		} else {
			x_mov(dst, a)
			emit1(X_NEG, dst)
		}
		emit1(X_JMP, done_l)
	}
	if strict == 0 {
		x_label(zero_l)
		if rem != 0 {
			x_mov(dst, a)
		} else {
			x_load_imm(dst, 0)
		}
	}
	x_label(done_l)
}

// ---- checked integer arithmetic (#362), mirroring gen.tin ----
// x_ovf_stub is the label of the current function's cold stub for check kind k.
fn x_ovf_stub(k i64) i64 {
	if x_ovf_labels[k] == 0 {
		x_ovf_labels[k] = new_label()
	}
	return x_ovf_labels[k]
}

// x_narrow_check jumps to the stub of kind k unless r, the exact 64-bit result of an operation
// on a narrow type, fits t.
fn x_narrow_check(t Ty, r i64, k i64) {
	if t.signed != 0 {
		emit3(X_SXT, XSCR, r, width_log2(t.width))
		emit2(X_CMP, XSCR, r)
	} else {
		x_mov(XSCR, r)
		emit2(X_SHRI, XSCR, 8 * t.width)
	}
	emit2(X_JCC, XC_NE, x_ovf_stub(k))
}

// x_checked_flags jumps to the stub after add/sub/imul: on OF for signed, CF for unsigned.
fn x_checked_flags(k i64, signed i64) {
	if signed != 0 {
		emit2(X_JCC, XC_O, x_ovf_stub(k))
	} else {
		emit2(X_JCC, XC_B, x_ovf_stub(k))
	}
}

// x_checked_neg is dst = -x, panicking when the negation does not fit t.
fn x_checked_neg(t Ty, dst i64, x i64) {
	x_mov(dst, x)
	emit1(X_NEG, dst)
	if int_width(t) != 8 {
		x_narrow_check(t, dst, OVK_NEG)
		return
	}
	// neg sets OF for the most negative value and CF for every value but 0.
	x_checked_flags(OVK_NEG, t.signed)
}

// x_checked_rr is dst = a op b for + - * on registers, panicking on overflow of type t.
fn x_checked_rr(op str, dst i64, a i64, b i64, t Ty) {
	let k = ovf_kind(op)
	if int_width(t) != 8 {
		x_arith(op, dst, a, b)
		x_narrow_check(t, dst, k)
		return
	}
	let signed = i64(cast(i64, t) == 0 || t.signed != 0)
	if k == OVK_MUL && signed == 0 {
		// mul leaves the high half in rdx and sets CF when it is not zero.
		x_mov(RAX, a)
		emit1(X_MULU, b)
		emit2(X_JCC, XC_B, x_ovf_stub(k))
		x_mov(dst, RAX)
		return
	}
	x_arith(op, dst, a, b)
	x_checked_flags(k, signed)
}

// x_checked_const is dst = l op c for + - * with a constant, panicking on overflow of type t.
fn x_checked_const(op str, dst i64, l i64, c i64, t Ty) {
	let k = ovf_kind(op)
	if int_width(t) != 8 {
		x_binary_const(op, dst, l, c)
		x_narrow_check(t, dst, k)
		return
	}
	let signed = i64(cast(i64, t) == 0 || t.signed != 0)
	if k == OVK_MUL {
		if c == 0 {
			x_load_imm(dst, 0)
		} else if c == 1 {
			x_mov(dst, l)
		} else if c == -1 && signed != 0 {
			x_checked_neg(t, dst, l)
		} else if signed != 0 && x64_fits32(c) != 0 {
			emit3(X_IMUL_RRI, dst, l, c)
			x_checked_flags(k, signed)
		} else {
			x_load_imm(XSCR, c)
			x_checked_rr(op, dst, l, XSCR, t)
		}
		return
	}
	if c == 0 {
		x_mov(dst, l)
		return
	}
	if x64_fits32(c) != 0 && (c > 0 || signed != 0) && c != -2147483648 {
		x_mov(dst, l)
		if k == OVK_ADD {
			emit2(X_ADDI, dst, c)
		} else {
			emit2(X_SUBI, dst, c)
		}
		x_checked_flags(k, signed)
		return
	}
	x_load_imm(XSCR, c)
	x_checked_rr(op, dst, l, XSCR, t)
}

// x_gen_checked_binary generates a binary operation the checker marked OVF_CHECK (see gen.tin).
fn x_gen_checked_binary(e Binary, dst i64, d i64) {
	let op = e.op
	let t = cast(Ty, cast(Node, e).type_)
	mut l = e.l
	mut r = e.r
	arith_unsigned = e_unsigned(cast(Node, e))
	if op == "<<" || op == ">>" {
		let bits = 8 * int_width(t)
		if is_const(r) != 0 {
			let c = const_val(r)
			let lv = x_gen_val(l, d)
			if c < 0 || c >= bits {
				emit1(X_JMP, x_ovf_stub(OVK_SHIFT))
				x_mov(dst, lv)
				return
			}
			arith_unsigned = e_unsigned(cast(Node, e))
			if arith_unsigned != 0 && x_uconst(op, dst, lv, c) != 0 {
				x_mask(cast(Node, e), dst)
				return
			}
			x_binary_const(op, dst, lv, c)
			x_mask(cast(Node, e), dst)
			return
		}
		x_gen_pair(l, r, d)
		arith_unsigned = e_unsigned(cast(Node, e))
		// One unsigned compare rejects negative counts too.
		emit2(X_CMPI, pr, bits)
		emit2(X_JCC, XC_AE, x_ovf_stub(OVK_SHIFT))
		x_arith(op, dst, pl, pr)
		x_mask(cast(Node, e), dst)
		return
	}
	if op == "/" {
		if is_const(r) != 0 && const_val(r) != -1 {
			let lv = x_gen_val(l, d)
			arith_unsigned = e_unsigned(cast(Node, e))
			x_binary_const(op, dst, lv, const_val(r))
			x_mask(cast(Node, e), dst)
			return
		}
		x_gen_pair(l, r, d)
		arith_unsigned = e_unsigned(cast(Node, e))
		if int_width(t) == 8 {
			// Only the most negative value / -1 overflows: negating it sets OF.
			let ok = new_label()
			emit2(X_CMPI, pr, -1)
			emit2(X_JCC, XC_NE, ok)
			x_mov(XSCR, pl)
			emit1(X_NEG, XSCR)
			emit2(X_JCC, XC_O, x_ovf_stub(OVK_DIV))
			x_label(ok)
			x_arith(op, dst, pl, pr)
			return
		}
		x_arith(op, dst, pl, pr)
		x_narrow_check(t, dst, OVK_DIV)
		return
	}
	if (op == "+" || op == "*") && is_const(l) != 0 {
		let tmp = l
		l = r
		r = tmp
	}
	if is_const(r) != 0 {
		let lv = x_gen_val(l, d)
		x_checked_const(op, dst, lv, const_val(r), t)
		return
	}
	x_gen_pair(l, r, d)
	x_checked_rr(op, dst, pl, pr, t)
}

// x_f2i_check jumps to the conversion stub unless float v truncates into the 64-bit range of t
// (see f2i_check in gen.tin); ucomisd marks NaN with PF.
fn x_f2i_check(t Ty, v i64) {
	mut hi = 0x43e0000000000000
	mut lo = 0xc3e0000000000000
	mut below = XC_B
	if is_unsigned_t(t) != 0 {
		hi = 0x43f0000000000000
		lo = 0xbff0000000000000
		below = XC_BE
	}
	x_load_imm(XSCR, hi)
	emit2(X_MOVQ, XFSCR, XSCR)
	emit2(X_UCOMISD, v, XFSCR)
	emit2(X_JCC, XC_P, x_ovf_stub(OVK_CONV))
	emit2(X_JCC, XC_AE, x_ovf_stub(OVK_CONV))
	x_load_imm(XSCR, lo)
	emit2(X_MOVQ, XFSCR, XSCR)
	emit2(X_UCOMISD, v, XFSCR)
	emit2(X_JCC, below, x_ovf_stub(OVK_CONV))
}

// x_gen_ovf_stubs emits the current function's cold overflow stubs (stack realigned, since a
// frameless leaf may jump here): rt_overflow_fail(kind).
fn x_gen_ovf_stubs() {
	let of = find_fn("rt_overflow_fail")
	mut k = 0
	for k < OVK_COUNT {
		if x_ovf_labels[k] != 0 {
			x_label(x_ovf_labels[k])
			emit2(X_ANDI, RSP, -16)
			x_load_imm(RDI, k)
			if cast(i64, of) != 0 {
				emit1(X_CALL, x_sym(SK_FN, of.index))
				of.used = 1
			}
		}
		k = k + 1
	}
}

// x_arith emits dst = a op b for integer registers (arith_unsigned picks the unsigned forms).
fn x_arith(op str, dst i64, a i64, b i64) {
	if op == "+" {
		x_binop(X_ADD, dst, a, b, 1)
	} else if op == "-" {
		x_binop(X_SUB, dst, a, b, 0)
	} else if op == "*" {
		x_binop(X_IMUL_RR, dst, a, b, 1)
	} else if op == "/" {
		x_divide(dst, a, b, arith_unsigned, 0)
	} else if op == "%" {
		x_divide(dst, a, b, arith_unsigned, 1)
	} else if op == "&" {
		x_binop(X_AND, dst, a, b, 1)
	} else if op == "|" {
		x_binop(X_OR, dst, a, b, 1)
	} else if op == "^" {
		x_binop(X_XOR, dst, a, b, 1)
	} else if op == "<<" {
		x_shift(X_SHL, dst, a, b)
	} else if arith_unsigned != 0 {
		x_shift(X_SHR, dst, a, b)
	} else {
		x_shift(X_SAR, dst, a, b)
	}
}

fn x_add_imm(dst i64, l i64, c i64) {
	if c == 0 {
		x_mov(dst, l)
	} else if x64_fits32(c) != 0 && dst == l {
		emit2(X_ADDI, dst, c)
	} else if x64_fits32(c) != 0 {
		emit2(X_LEA, dst, x_mem1(l, c))
	} else {
		x_load_imm(XSCR, c)
		x_binop(X_ADD, dst, l, XSCR, 1)
	}
}

// x_round_bias leaves l + (2^k - 1 if l < 0) in r11, so an arithmetic shift by k rounds
// toward zero the way idiv does.
fn x_round_bias(l i64, k i64) {
	x_mov(XSCR, l)
	emit2(X_SARI, XSCR, 63)
	emit2(X_SHRI, XSCR, 64 - k)
	emit2(X_ADD, XSCR, l)
}

// x_shift_imm emits dst = l shifted by the constant k.
fn x_shift_imm(op i64, dst i64, l i64, k i64) {
	x_mov(dst, l)
	if k != 0 {
		emit2(op, dst, k)
	}
}

// x_signed_div10 mirrors the exact signed multiply-high sequence used by Go.
fn x_signed_div10(op str, dst i64, l i64, c i64) {
	x_mov(RAX, l)
	x_load_imm(XSCR, -3689348814741910323)
	emit1(X_IMULH, XSCR)
	x_binop(X_ADD, RDX, RDX, l, 1)
	emit2(X_SARI, RDX, 3)
	x_mov(XSCR, l)
	emit2(X_SARI, XSCR, 63)
	emit2(X_SUB, RDX, XSCR)
	if op == "/" {
		x_mov(dst, RDX)
		if c < 0 {
			emit1(X_NEG, dst)
		}
	} else {
		mut q10 = XSCR2
		if dst == q10 {
			q10 = RAX
		}
		emit3(X_IMUL_RRI, q10, RDX, 10)
		x_mov(dst, l)
		emit2(X_SUB, dst, q10)
	}
}

fn x_binary_const(op str, dst i64, l i64, c i64) {
	if arith_unsigned == 0 && (op == "/" || op == "%") && (c == 10 || c == -10) {
		x_signed_div10(op, dst, l, c)
	} else if op == "+" {
		x_add_imm(dst, l, c)
	} else if op == "-" && c != -9223372036854775807 - 1 {
		x_add_imm(dst, l, -c)
	} else if op == "*" {
		let k = pow2_log(c)
		if c == 0 {
			x_load_imm(dst, 0)
		} else if c == 1 {
			x_mov(dst, l)
		} else if c == -1 {
			x_mov(dst, l)
			emit1(X_NEG, dst)
		} else if k >= 0 {
			x_shift_imm(X_SHLI, dst, l, k)
		} else if x64_fits32(c) != 0 {
			emit3(X_IMUL_RRI, dst, l, c)
		} else {
			x_load_imm(XSCR, c)
			x_binop(X_IMUL_RR, dst, l, XSCR, 1)
		}
	} else if op == "/" {
		let k = pow2_log(c)
		if c == 1 {
			x_mov(dst, l)
		} else if c == -1 {
			x_mov(dst, l)
			emit1(X_NEG, dst)
		} else if c == 0 && cast(Fn, cur_gen_fn).generated == 0 {
			emit1(X_JMP, x_div_stub())
		} else if c == 0 {
			x_load_imm(dst, 0)
		} else if k > 0 {
			x_round_bias(l, k)
			emit2(X_SARI, XSCR, k)
			x_mov(dst, XSCR)
		} else {
			x_load_imm(XSCR2, c)
			x_divide(dst, l, XSCR2, 0, 0)
		}
	} else if op == "%" {
		mut m = c
		if m < 0 && m != -9223372036854775807 - 1 {
			m = -m
		}
		let k = pow2_log(m)
		if m == 1 {
			x_load_imm(dst, 0)
		} else if c == 0 && cast(Fn, cur_gen_fn).generated == 0 {
			emit1(X_JMP, x_div_stub())
		} else if c == 0 {
			x_mov(dst, l)
		} else if k > 0 {
			x_round_bias(l, k)
			emit2(X_SARI, XSCR, k)
			emit2(X_SHLI, XSCR, k)
			x_mov(dst, l)
			emit2(X_SUB, dst, XSCR)
		} else {
			x_load_imm(XSCR2, c)
			x_divide(dst, l, XSCR2, 0, 1)
		}
	} else if op == "<<" {
		x_shift_imm(X_SHLI, dst, l, c & 63)
	} else if op == ">>" {
		x_shift_imm(X_SARI, dst, l, c & 63)
	} else if op == "&" && x64_fits32(c) != 0 {
		x_mov(dst, l)
		emit2(X_ANDI, dst, c)
	} else if (op == "|" || op == "^") && c == 0 {
		x_mov(dst, l)
	} else if (op == "|" || op == "^") && x64_fits32(c) != 0 {
		x_mov(dst, l)
		if op == "|" {
			emit2(X_ORI, dst, c)
		} else {
			emit2(X_XORI, dst, c)
		}
	} else {
		x_load_imm(XSCR2, c)
		x_arith(op, dst, l, XSCR2)
	}
}

// x_uconst handles unsigned division, modulo and right shift by constants.
fn x_uconst(op str, dst i64, l i64, c i64) i64 {
	let k = pow2_log(c)
	if op == "/" && k >= 0 {
		x_shift_imm(X_SHRI, dst, l, k)
		return 1
	}
	if op == "%" && k > 0 {
		x_mov(dst, l)
		if k <= 31 {
			emit2(X_ANDI, dst, (1 << k) - 1)
		} else {
			x_load_imm(XSCR, (1 << k) - 1)
			emit2(X_AND, dst, XSCR)
		}
		return 1
	}
	if op == ">>" {
		x_shift_imm(X_SHRI, dst, l, c & 63)
		return 1
	}
	if op == "/" || op == "%" {
		x_load_imm(XSCR2, c)
		x_arith(op, dst, l, XSCR2)
		return 1
	}
	return 0
}

// x_canon keeps narrow integer results canonical: sign-extended for i8/i16/i32,
// zero-extended for u8/u16/u32, so wrapping matches the declared width.
fn x_canon(t Ty, r i64) {
	if cast(i64, t) == 0 || t.kind != K_INT || t.width == 8 || is_fp(r) != 0 {
		return
	}
	if t.signed != 0 {
		emit3(X_SXT, r, r, width_log2(t.width))
	} else {
		emit3(X_ZXT, r, r, width_log2(t.width))
	}
}

fn x_mask(e Node, dst i64) {
	x_canon(cast(Ty, e.type_), dst)
}

// ---- expressions ----
// x_gen_val returns a register holding e: a local's own register, or temp depth d.
fn x_gen_val(e i64, d i64) i64 {
	let k = cast(Node, e).kind
	if k == EX_REG {
		return cast(RegExpr, e).num
	}
	if k == EX_IDENT && cast(Sym, cast(IdentExpr, e).ref).kind == SYM_LOCAL && cast(Sym, cast(IdentExpr, e).ref).reg >= 0 {
		return cast(Sym, cast(IdentExpr, e).ref).reg
	}
	mut r = 0
	if e_fp(cast(Node, e)) != 0 {
		r = freg(d)
	} else {
		r = treg(d)
	}
	x_gen_to(e, r, d)
	return r
}

// x_gen_to computes e into dst using temps from depth d up; dst is written last.
fn x_gen_to(e i64, dst i64, d i64) {
	let k = cast(Node, e).kind
	if k == EX_INT {
		x_load_imm(dst, cast(IntLit, e).val)
	} else if k == EX_FLOAT {
		x_load_imm(dst, cast(FloatLit, e).bits)
	} else if k == EX_STR {
		mut sym = 0
		if kind_of(cast(Ty, cast(Node, e).type_)) == K_STRING {
			sym = x_sym(SK_TSTR, tstring_index(cast(StrLit, e).ptr, cast(StrLit, e).len))
		} else {
			sym = x_sym(SK_STR, string_index(cast(StrLit, e).ptr, cast(StrLit, e).len))
		}
		emit2(X_LEA, dst, x64_mem_sym(sym))
	} else if k == EX_IDENT {
		x_gen_ident(cast(IdentExpr, e), dst)
	} else if k == EX_REG {
		x_mov(dst, cast(RegExpr, e).num)
	} else if k == EX_UNARY {
		x_gen_unary(cast(Unary, e), dst, d)
	} else if k == EX_BINARY {
		x_gen_binary(cast(Binary, e), dst, d)
	} else if k == EX_INDEX {
		x_gen_index_load(cast(IndexExpr, e), dst, d)
	} else if k == EX_CONV && (cast(Conv, e).kind == CV_DYN || cast(Conv, e).kind == CV_DYN_KEEP || cast(Conv, e).kind == CV_DYN_OBJECT || cast(Conv, e).kind == CV_DYN_DESC || (cast(Conv, e).kind == CV_SAME && is_dyn_value(cast(Ty, cast(Node, e).type_)) != 0)) {
		x_gen_dyn_pair(e, dst, XSCR2, d)
	} else if k == EX_CONV && cast(Conv, e).kind == CV_DYN_TABLE_WORD {
		mut spare = XSCR
		if dst == XSCR {
			spare = XSCR2
		}
		x_gen_dyn_pair(cast(Conv, e).x, spare, dst, d)
	} else if k == EX_CONV {
		x_gen_conv(e, dst, d)
	} else if k == EX_MEM {
		if is_dyn_value(cast(Ty, cast(Node, e).type_)) != 0 {
			x_gen_dyn_pair(e, dst, XSCR2, d)
		} else {
			x_gen_mem_addr(cast(MemExpr, e), d)
			x_emit_load(dst, cast(Node, e).type_)
		}
	} else if k == EX_ELEM {
		if is_dyn_value(cast(Ty, cast(Node, e).type_)) != 0 {
			x_gen_dyn_pair(e, dst, XSCR2, d)
		} else {
			x_gen_elem_addr(cast(ElemExpr, e), d)
			x_emit_load(dst, cast(Node, e).type_)
		}
	} else if k == EX_SEQ {
		x_gen_seq(e, dst, d)
	} else if k == EX_FUNCREF {
		mut kind = SK_FNDESC
		if cast(FuncRef, e).raw != 0 {
			kind = SK_FN
		}
		emit2(X_LEA, dst, x64_mem_sym(x_sym(kind, cast(Fn, cast(FuncRef, e).fn_).index)))
	} else if cast(Call, e).intrinsic != 0 {
		x_gen_intrinsic(cast(Call, e), dst, d)
	} else {
		x_gen_call(e, d)
		if is_fp(dst) != 0 {
			x_mov(dst, XMM)
		} else {
			x_mov(dst, RAX)
		}
	}
}

// x_gen_dyn_addr computes the address of a two-word field or slice element. x86 has no
// addressing mode for a scale of 16, so a dyn slice index is multiplied explicitly.
fn x_gen_dyn_addr(e Node, d i64) {
	if e.kind == EX_ELEM {
		x_gen_elem_addr(cast(ElemExpr, e), d)
	} else {
		x_gen_mem_addr(cast(MemExpr, e), d)
	}
	mut base = mm_base
	let idx = mm_index
	let scale = mm_scale
	let off = mm_off
	if idx >= 0 {
		if base == XSCR {
			x_mov(XSCR2, base)
			base = XSCR2
		}
		emit3(X_IMUL_RRI, XSCR, idx, scale)
		emit2(X_ADD, XSCR, base)
		if off != 0 {
			x_add_imm(XSCR, XSCR, off)
		}
	} else {
		emit2(X_LEA, XSCR, x_mem1(base, off))
	}
}

// x_gen_dyn_pair computes a dyn value as adjacent object and table words.
fn x_gen_dyn_pair(e i64, obj i64, tab i64, d i64) {
	let k = cast(Node, e).kind
	if k == EX_CONV && cast(Conv, e).kind == CV_DYN_OBJECT {
		mut spare = XSCR2
		if obj == XSCR2 {
			spare = XSCR
		}
		x_gen_dyn_pair(cast(Conv, e).x, obj, spare, d)
		return
	}
	if k == EX_CONV && cast(Conv, e).kind == CV_DYN_TABLE_WORD {
		mut spare = XSCR
		if tab == XSCR {
			spare = XSCR2
		}
		x_gen_dyn_pair(cast(Conv, e).x, spare, tab, d)
		return
	}
	if k == EX_CONV && cast(Conv, e).kind == CV_DYN_DESC {
		x_gen_dyn_pair(cast(Conv, e).x, RAX, RDX, d)
		x_ld(obj, x_mem1(RDX, 8 * cast(Conv, e).dyn_index), 3)
		return
	}
	if k == EX_CONV && cast(Conv, e).kind == CV_DYN {
		x_gen_to(cast(Conv, e).x, obj, d)
		let rec = cast([]i64, dyn_tables[cast(Conv, e).dyn_table])
		emit2(X_LEA, tab, x64_mem_sym(x_sym(SK_VAR, rec[4])))
		return
	}
	if k == EX_CONV && cast(Conv, e).kind == CV_DYN_KEEP {
		x_gen_dyn_pair(cast(Conv, e).x, obj, tab, d)
		let done = new_label()
		emit2(X_TEST, obj, obj)
		emit2(X_JCC, XC_E, done)
		x_push(tab)
		x_ld(XSCR, x_mem1(tab, 0), 3)
		x_ld(XSCR2, x_mem1(XSCR, 0), 3)
		x_save_temps(d)
		x_mov(x_int_arg(0), obj)
		emit1(X_CALL_R, XSCR2)
		x_restore_temps(d)
		x_mov(obj, RAX)
		x_pop(tab)
		x_label(done)
		return
	}
	if k == EX_SEQ {
		x_gen_seq(e, -1, d)
		x_gen_dyn_pair(cast(SeqExpr, e).value, obj, tab, d)
		return
	}
	if k == EX_CALL {
		x_gen_call(e, d)
		x_mov(obj, RAX)
		x_mov(tab, RDX)
		return
	}
	if k == EX_CONV && cast(Conv, e).kind == CV_SAME {
		x_gen_dyn_pair(cast(Conv, e).x, obj, tab, d)
		return
	}
	if k == EX_IDENT {
		let s = cast(Sym, cast(IdentExpr, e).ref)
		if s.kind == SYM_LOCAL {
			x_slot_load(obj, s.off)
			x_slot_load(tab, s.off + 8)
		} else if s.tls != 0 {
			x_ld(obj, x_mem1(XCTX, tls_off(s)), 3)
			x_ld(tab, x_mem1(XCTX, tls_off(s) + 8), 3)
		} else {
			x_ld(obj, x64_mem_sym(x_sym(SK_VAR, s.index)), 3)
			x_ld(tab, x64_mem_sym(x_sym(SK_VAR, s.words)), 3)
		}
		return
	}
	if k == EX_MEM || k == EX_ELEM {
		x_gen_dyn_addr(cast(Node, e), d)
		x_ld(obj, x_mem1(XSCR, 0), 3)
		x_ld(tab, x_mem1(XSCR, 8), 3)
		return
	}
	if k == EX_INT && is_const(e) != 0 && const_val(e) == 0 {
		x_load_imm(obj, 0)
		x_load_imm(tab, 0)
		return
	}
	err_code_at(cast(Node, e).pos, "E990 INTERNAL", "unsupported dyn value location in amd64 code generation")
}

fn x_gen_ident(e IdentExpr, dst i64) {
	let s = cast(Sym, e.ref)
	let k = s.kind
	if k == SYM_LOCAL {
		if s.reg >= 0 {
			x_mov(dst, s.reg)
		} else {
			x_slot_load(dst, s.off)
		}
	} else if k == SYM_GLOBAL && s.tls != 0 {
		x_ld(dst, x_mem1(XCTX, tls_off(s)), 3)
	} else if k == SYM_GLOBAL {
		x_ld(dst, x64_mem_sym(x_sym(SK_VAR, s.index)), 3)
	} else {
		x_load_imm(dst, s.val)
	}
}

// x_gen_pair evaluates two operands into pl and pr. pr may be rax/xmm0 (a call result) or
// a scratch register (a spill), so the caller must consume both right away.
fn x_gen_pair(lexp i64, rexp i64, d i64) {
	let l = x_gen_val(lexp, d)
	let d2 = next_depth(l, d)
	let rfp = e_fp(cast(Node, rexp))
	mut r = 0
	if is_real_call(rexp) != 0 {
		x_gen_call(rexp, d2)
		if rfp != 0 {
			r = XMM
		} else {
			r = RAX
		}
	} else if room(d2, rfp) == 0 {
		x_push(l)
		let rr = x_gen_val(rexp, d)
		if rfp != 0 {
			x_mov(XFSCR, rr)
			r = XFSCR
		} else {
			x_mov(XSCR, rr)
			r = XSCR
		}
		x_pop(l)
	} else {
		r = x_gen_val(rexp, d2)
	}
	pl = l
	pr = r
}

fn x_gen_unary(e Unary, dst i64, d i64) {
	let op = e.op
	if op == "&" {
		let s = cast(Sym, cast(IdentExpr, e.x).ref)
		if s.kind == SYM_LOCAL {
			emit2(X_LEA, dst, x_mem1(RBP, s.off))
		} else if s.tls != 0 {
			emit2(X_LEA, dst, x_mem1(XCTX, tls_off(s)))
		} else {
			emit2(X_LEA, dst, x64_mem_sym(x_sym(SK_VAR, s.index)))
		}
		return
	}
	if is_const(cast(i64, e)) != 0 {
		x_load_imm(dst, const_val(cast(i64, e)))
		return
	}
	let x = x_gen_val(e.x, d)
	if is_fp(dst) != 0 {
		// Negation flips the sign bit.
		x_load_imm(XSCR, 1 << 63)
		emit2(X_MOVQ, XFSCR, XSCR)
		x_mov(dst, x)
		emit2(X_XORPD, dst, XFSCR)
		return
	}
	if op == "-" && e.ovf == OVF_CHECK {
		x_checked_neg(cast(Ty, cast(Node, e).type_), dst, x)
		return
	}
	if op == "-" {
		x_mov(dst, x)
		emit1(X_NEG, dst)
	} else if op == "~" {
		x_mov(dst, x)
		emit1(X_NOT, dst)
	} else {
		emit2(X_TEST, x, x)
		x_setcc(dst, XC_E, 0)
		return
	}
	x_mask(cast(Node, e), dst)
}

fn x_gen_binary(e Binary, dst i64, d i64) {
	if is_const(cast(i64, e)) != 0 {
		x_load_imm(dst, const_val(cast(i64, e)))
		return
	}
	let op = e.op
	if op == "&&" || op == "||" {
		let f = new_label()
		let end = new_label()
		x_gen_cond(cast(i64, e), f, d)
		x_load_imm(dst, 1)
		emit1(X_JMP, end)
		x_label(f)
		x_load_imm(dst, 0)
		x_label(end)
		return
	}
	if x_cond(op) >= 0 {
		x_gen_compare(e, d)
		x_setcc(dst, cmp_cc, cmp_unord)
		return
	}
	if is_fp(dst) != 0 {
		x_gen_fbinary(e, dst, d)
		return
	}
	if e.ovf == OVF_CHECK {
		x_gen_checked_binary(e, dst, d)
		return
	}
	mut l = e.l
	mut r = e.r
	let comm = i64(op == "+" || op == "*" || op == "&" || op == "|" || op == "^")
	if comm != 0 && is_const(l) != 0 {
		let t = l
		l = r
		r = t
	}
	if is_const(r) != 0 {
		let c = const_val(r)
		let lv = x_gen_val(l, d)
		arith_unsigned = e_unsigned(cast(Node, e))
		if arith_unsigned != 0 && x_uconst(op, dst, lv, c) != 0 {
			x_mask(cast(Node, e), dst)
			return
		}
		x_binary_const(op, dst, lv, c)
		x_mask(cast(Node, e), dst)
		return
	}
	x_gen_pair(l, r, d)
	arith_unsigned = e_unsigned(cast(Node, e))
	x_arith(op, dst, pl, pr)
	x_mask(cast(Node, e), dst)
}

fn x_gen_fbinary(e Binary, dst i64, d i64) {
	let op = e.op
	x_gen_pair(e.l, e.r, d)
	if op == "+" {
		x_binop(X_ADDSD, dst, pl, pr, 1)
	} else if op == "-" {
		x_binop(X_SUBSD, dst, pl, pr, 0)
	} else if op == "*" {
		x_binop(X_MULSD, dst, pl, pr, 1)
	} else {
		x_binop(X_DIVSD, dst, pl, pr, 0)
	}
}

// x_gen_compare sets the flags for comparison e and leaves its condition in cmp_cc (and
// cmp_unord, see x_jcc). Float operands are compared so that NaN compares false like Go:
// ucomisd leaves CF set when unordered, so < and <= test the swapped operands with a/ae.
fn x_gen_compare(e Binary, d i64) {
	mut l = e.l
	mut r = e.r
	let op = e.op
	if e_fp(cast(Node, l)) != 0 || e_fp(cast(Node, r)) != 0 {
		x_gen_pair(l, r, d)
		// Set after the operands, which may contain comparisons of their own.
		cmp_unord = 0
		if op == "<" || op == "<=" {
			emit2(X_UCOMISD, pr, pl)
		} else {
			emit2(X_UCOMISD, pl, pr)
		}
		if op == "<" || op == ">" {
			cmp_cc = XC_A
		} else if op == "<=" || op == ">=" {
			cmp_cc = XC_AE
		} else if op == "==" {
			cmp_cc = XC_E
			cmp_unord = 1
		} else {
			cmp_cc = XC_NE
			cmp_unord = 2
		}
		return
	}
	mut cc = x_cond(op)
	if e_unsigned(cast(Node, l)) != 0 || e_unsigned(cast(Node, r)) != 0 {
		cc = x_ucond(op)
	}
	if is_const(l) != 0 {
		let t = l
		l = r
		r = t
		cc = x_swap_cc(cc)
	}
	if is_const(r) != 0 {
		let a = x_gen_val(l, d)
		x_cmp_imm(a, const_val(r))
	} else {
		x_gen_pair(l, r, d)
		emit2(X_CMP, pl, pr)
	}
	cmp_cc = cc
	cmp_unord = 0
}

fn x_gen_index_load(e IndexExpr, dst i64, d i64) {
	let ix = e.i
	if is_const(ix) != 0 && x64_fits32(const_val(ix) * 8) != 0 {
		let base = x_gen_val(e.x, d)
		x_ld(dst, x_mem1(base, const_val(ix) * 8), 3)
		return
	}
	x_gen_pair(e.x, ix, d)
	x_ld(dst, x64_mem(pl, pr, 8, 0), 3)
}

fn x_gen_conv(e i64, dst i64, d i64) {
	let k = cast(Conv, e).kind
	let x = cast(Node, cast(Conv, e).x)
	if k == CV_LEN || k == CV_CAP {
		// Header word 0 (len) or 1 (cap); a nil string, slice or map has length 0.
		let p = x_gen_val(cast(i64, x), d)
		x_mov(dst, p)
		let skip = new_label()
		emit2(X_TEST, dst, dst)
		emit2(X_JCC, XC_E, skip)
		x_ld(dst, x_mem1(dst, 8 * i64((k == CV_CAP))), 3)
		x_label(skip)
		return
	}
	let v = x_gen_val(cast(i64, x), d)
	if k == CV_ROUND32 {
		emit2(X_CVTSD2SS, dst, v)
		emit2(X_CVTSS2SD, dst, dst)
		return
	}
	if k == CV_F2BITS32 {
		emit2(X_CVTSD2SS, XFSCR, v)
		emit2(X_MOVD_RX, dst, XFSCR)
		return
	}
	if k == CV_I2F {
		if is_unsigned_t(cast(Ty, x.type_)) != 0 && cast(Ty, x.type_).width == 8 {
			x_cvt_u2f(dst, v)
		} else {
			emit2(X_CVTSI2SD, dst, v)
		}
	} else if k == CV_F2I {
		let ft = cast(Ty, cast(Node, e).type_)
		if cast(Conv, e).ovf == OVF_CHECK {
			x_f2i_check(ft, v)
		}
		if is_unsigned_t(ft) != 0 && ft.width == 8 {
			x_cvt_f2u(dst, v)
		} else {
			emit2(X_CVTTSD2SI, dst, v)
		}
		if cast(Conv, e).ovf == OVF_CHECK && int_width(ft) != 8 {
			x_narrow_check(ft, dst, OVK_CONV)
		} else {
			x_canon(ft, dst)
		}
	} else if k == CV_TOBYTE {
		emit3(X_ZXT, dst, v, 0)
	} else if k == CV_INT {
		// Values are kept canonical, so widening is free; narrowing re-canonicalizes.
		x_mov(dst, v)
		if type_width(cast(Ty, cast(Node, e).type_)) < type_width(cast(Ty, x.type_)) || is_unsigned_t(cast(Ty, cast(Node, e).type_)) != is_unsigned_t(cast(Ty, x.type_)) {
			x_canon(cast(Ty, cast(Node, e).type_), dst)
		}
	} else {
		x_mov(dst, v)
	}
}

// x_cvt_u2f converts an unsigned 64-bit value: a negative word is halved (keeping the low
// bit for rounding), converted and doubled.
fn x_cvt_u2f(dst i64, v i64) {
	let neg_l = new_label()
	let done_l = new_label()
	emit2(X_TEST, v, v)
	emit2(X_JCC, XC_S, neg_l)
	emit2(X_CVTSI2SD, dst, v)
	emit1(X_JMP, done_l)
	x_label(neg_l)
	x_mov(XSCR, v)
	emit2(X_SHRI, XSCR, 1)
	x_mov(XSCR2, v)
	emit2(X_ANDI, XSCR2, 1)
	emit2(X_OR, XSCR, XSCR2)
	emit2(X_CVTSI2SD, dst, XSCR)
	emit2(X_ADDSD, dst, dst)
	x_label(done_l)
}

// x_cvt_f2u truncates to an unsigned 64-bit value: from 2^63 up, half the value is
// converted and doubled (such doubles are even integers, so nothing is lost).
fn x_cvt_f2u(dst i64, v i64) {
	let small_l = new_label()
	let done_l = new_label()
	x_load_imm(XSCR, 0x43e0000000000000)
	emit2(X_MOVQ, XFSCR, XSCR)
	emit2(X_UCOMISD, v, XFSCR)
	emit2(X_JCC, XC_B, small_l)
	x_load_imm(XSCR, 0x3fe0000000000000)
	emit2(X_MOVQ, XFSCR, XSCR)
	emit2(X_MULSD, XFSCR, v)
	emit2(X_CVTTSD2SI, dst, XFSCR)
	emit2(X_SHLI, dst, 1)
	emit1(X_JMP, done_l)
	x_label(small_l)
	emit2(X_CVTTSD2SI, dst, v)
	x_label(done_l)
}

// ---- sized memory ----
// x_mem_kind is the X_LOAD kind of a type: size log2, with XK_SIGNED for narrow signed ints.
fn x_mem_kind(t Ty) i64 {
	let w = type_width(t)
	mut k = width_log2(w)
	if w < 8 && t.kind == K_INT && t.signed != 0 {
		k = k | XK_SIGNED
	}
	return k
}

// x_mem_operand packs the address parts left by x_gen_mem_addr or x_gen_elem_addr.
fn x_mem_operand() i64 {
	if mm_index < 0 {
		return x_mem1(mm_base, mm_off)
	}
	return x64_mem(mm_base, mm_index, mm_scale, mm_off)
}

fn x_emit_load(dst i64, t i64) {
	x_ld(dst, x_mem_operand(), x_mem_kind(cast(Ty, t)))
}

fn x_emit_store(v i64, t i64) {
	x_st(v, x_mem_operand(), width_log2(type_width(cast(Ty, t))))
}

fn x_scale_ok(s i64) i64 {
	return i64(s == 1 || s == 2 || s == 4 || s == 8)
}

// x_gen_mem_addr evaluates an EX_MEM address into mm_base plus mm_index * mm_scale plus
// mm_off. Registers may be r11 (scratch), so the caller must use them at once.
fn x_gen_mem_addr(e MemExpr, d i64) {
	mut base = x_gen_val(e.base, d)
	mut off = e.off
	mut ix = e.index
	let scale = e.scale
	// A checked constant index stays in a register for its bounds check.
	if ix != 0 && is_const(ix) != 0 && e.len == 0 {
		off = off + const_val(ix) * scale
		ix = 0
	}
	// The address parts are set last: the index and length may contain other accesses.
	mut mi = -1
	mut ms = 1
	if ix != 0 {
		let idx = x_gen_val(ix, next_depth(base, d))
		if e.len != 0 {
			x_bounds_check(idx, e.len, next_depth(idx, next_depth(base, d)))
		}
		if x_scale_ok(scale) != 0 {
			mi = idx
			ms = scale
		} else {
			emit3(X_IMUL_RRI, XSCR, idx, scale)
			emit2(X_ADD, XSCR, base)
			base = XSCR
		}
	}
	mm_base = base
	mm_index = mi
	mm_scale = ms
	mm_off = off
}

// x_bounds_check traps unless idx is below the length expression (an unsigned compare
// also catches negative indexes).
fn x_bounds_check(idx i64, lenexpr i64, d i64) {
	mut lr = 0
	if cast(Node, lenexpr).kind == EX_IDENT && cast(Sym, cast(IdentExpr, lenexpr).ref).kind == SYM_LOCAL && cast(Sym, cast(IdentExpr, lenexpr).ref).reg >= 0 {
		lr = cast(Sym, cast(IdentExpr, lenexpr).ref).reg
	} else {
		x_gen_to(lenexpr, XSCR2, d)
		lr = XSCR2
	}
	emit2(X_CMP, idx, lr)
	emit2(X_JCC, XC_AE, trap_at(idx, lr, 0))
}

// x_gen_elem_addr evaluates a slice or string element address (with its bounds check)
// into mm_base/mm_index/mm_scale/mm_off.
fn x_gen_elem_addr(e ElemExpr, d i64) {
	let h = x_gen_val(e.seq, d)
	let d1 = next_depth(h, d)
	let size = e.size
	let ix = e.idx
	mut first = 0
	if e.str != 0 {
		first = 8
	}
	if is_const(ix) != 0 {
		let c = const_val(ix)
		if e.safe == 0 {
			x_ld(XSCR2, x_mem1(h, 0), 3)
			x_cmp_imm(XSCR2, c)
			emit2(X_JCC, XC_BE, trap_at(-1, XSCR2, c))
		}
		if e.str != 0 {
			mm_base = h
		} else {
			x_ld(XSCR, x_mem1(h, 16), 3)
			mm_base = XSCR
		}
		mm_index = -1
		mm_scale = size
		mm_off = first + c * size
		return
	}
	let idx = x_gen_val(ix, d1)
	if e.safe == 0 {
		x_ld(XSCR2, x_mem1(h, 0), 3)
		emit2(X_CMP, idx, XSCR2)
		emit2(X_JCC, XC_AE, trap_at(idx, XSCR2, 0))
	}
	if e.str != 0 {
		mm_base = h
	} else {
		x_ld(XSCR, x_mem1(h, 16), 3)
		mm_base = XSCR
	}
	// Set after generating the index, which may itself be an element or field access.
	mm_index = idx
	mm_scale = size
	mm_off = first
}

// x_gen_seq runs a checker-made statement list, then computes its value. The statements
// use temps from depth 0, so live temps below d are saved around them.
fn x_gen_seq(e i64, dst i64, d i64) {
	mut i = 0
	for i < d {
		if i < t_count {
			x_push(t_regs[i])
		}
		if i < f_count {
			x_push(f_regs[i])
		}
		i = i + 1
	}
	x_gen_stmts(cast(SeqExpr, e).stmts)
	i = d - 1
	for i >= 0 {
		if i < f_count {
			x_pop(f_regs[i])
		}
		if i < t_count {
			x_pop(t_regs[i])
		}
		i = i - 1
	}
	let v = cast(SeqExpr, e).value
	if dst >= 0 && kind_of(cast(Ty, cast(Node, e).type_)) != K_VOID {
		x_gen_to(v, dst, d)
	} else {
		x_gen_effect(v)
	}
}

// x_gen_addr8 picks a byte address for p: am_base plus am_index, or plus am_off.
fn x_gen_addr8(p i64, d i64) {
	if cast(Node, p).kind == EX_BINARY && cast(Binary, p).op == "+" {
		let r = cast(Binary, p).r
		if is_const(r) != 0 && x64_fits32(const_val(r)) != 0 {
			am_base = x_gen_val(cast(Binary, p).l, d)
			am_index = -1
			am_off = const_val(r)
			return
		}
		x_gen_pair(cast(Binary, p).l, r, d)
		am_base = pl
		am_index = pr
		return
	}
	am_base = x_gen_val(p, d)
	am_index = -1
	am_off = 0
}

fn x_am_operand() i64 {
	if am_index < 0 {
		return x_mem1(am_base, am_off)
	}
	return x64_mem(am_base, am_index, 1, 0)
}

fn x_gen_intrinsic(e Call, dst i64, d i64) {
	let name = e.name
	if name == "__prefetchw" {
		x_gen_pair(e.args[0], e.args[1], d)
		emit1(X_PREFETCHW, x64_mem(pl, pr, 8, 0))
		return
	}
	if name == "load8" {
		x_gen_addr8(e.args[0], d)
		emit3(X_LOAD, dst, x_am_operand(), 0)
		return
	}
	if x_gen_runtime_intrinsic(e, dst, d) != 0 {
		return
	}
	x_gen_store8(e, dst, d)
}

// x_float_intrinsic emits the float intrinsics: sqrtsd, andpd with the sign mask for
// __fabs, roundsd for the rounding modes it has, and a trunc-and-adjust sequence for
// __frinta (round half away from zero).
fn x_float_intrinsic(name str, dst i64, x i64) i64 {
	if name == "__fsqrt" {
		emit2(X_SQRTSD, dst, x)
		return 1
	}
	if name == "__fabs" {
		x_load_imm(XSCR, 0x7fffffffffffffff)
		emit2(X_MOVQ, XFSCR, XSCR)
		x_mov(dst, x)
		emit2(X_ANDPD, dst, XFSCR)
		return 1
	}
	if name == "__frintm" {
		emit3(X_ROUNDSD, dst, x, XR_FLOOR)
		return 1
	}
	if name == "__frintp" {
		emit3(X_ROUNDSD, dst, x, XR_CEIL)
		return 1
	}
	if name == "__frintz" {
		emit3(X_ROUNDSD, dst, x, XR_TRUNC)
		return 1
	}
	if name == "__frintn" {
		emit3(X_ROUNDSD, dst, x, XR_NEAREST)
		return 1
	}
	if name == "__frinta" {
		// t = trunc(x); if |x - t| >= 0.5 then t += sign(x) * 1.0.
		let done_l = new_label()
		x_mov(XFSCR, x)
		emit3(X_ROUNDSD, dst, x, XR_TRUNC)
		emit2(X_SUBSD, XFSCR, dst)
		emit2(X_MOVQ, XSCR, XFSCR)
		x_load_imm(XSCR2, 0x7fffffffffffffff)
		emit2(X_AND, XSCR2, XSCR)
		x_load_imm(RAX, 0x3fe0000000000000)
		emit2(X_CMP, XSCR2, RAX)
		emit2(X_JCC, XC_B, done_l)
		x_load_imm(XSCR2, 1 << 63)
		emit2(X_AND, XSCR, XSCR2)
		x_load_imm(XSCR2, 0x3ff0000000000000)
		emit2(X_OR, XSCR, XSCR2)
		emit2(X_MOVQ, XFSCR, XSCR)
		emit2(X_ADDSD, dst, XFSCR)
		x_label(done_l)
		return 1
	}
	return 0
}

// Runtime intrinsics: the thread context register and atomics for lib/runtime.tin.
fn x_gen_runtime_intrinsic(e Call, dst i64, d i64) i64 {
	let name = e.name
	let args = e.args
	if name == "__ctx" {
		x_mov(dst, XCTX)
		return 1
	}
	if name == "__fp" {
		x_mov(dst, RBP)
		return 1
	}
	if i64(byte_at(name, 0)) == '_' && i64(name[1]) == '_' && i64(name[2]) == 'f' {
		let fx = x_gen_val(args[0], d)
		if x_float_intrinsic(name, dst, fx) != 0 {
			return 1
		}
	}
	if name == "__mulhu" {
		// __mulhu(a, b): the high 64 bits of the unsigned 128-bit product, which mul leaves in
		// rdx (bits.Mul64, #474).
		x_gen_pair(args[0], args[1], d)
		mut b = pr
		if b == RAX || b == RDX {
			x_mov(RCX, b)
			b = RCX
		}
		x_mov(RAX, pl)
		emit1(X_MULU, b)
		if dst >= 0 {
			x_mov(dst, RDX)
		}
		return 1
	}
	if name == "__st" {
		// __st(p, v, sizelog2): a raw sized store for the runtime.
		x_gen_pair(args[0], args[1], d)
		emit3(X_STORE, pr, x_mem1(pl, 0), const_val(args[2]))
		return 1
	}
	if name == "__ld" {
		let p = x_gen_val(args[0], d)
		let k = args[1]
		if is_const(k) != 0 {
			emit3(X_LOAD, dst, x_mem1(p, 0), const_val(k))
		} else {
			emit3(X_LOAD, dst, x_mem1(p, 0), 3)
		}
		return 1
	}
	if name == "__tin_symbols" || name == "__image_base" {
		mut kind = SK_BTRACE
		if name == "__image_base" {
			kind = SK_IMAGE
		}
		emit2(X_LEA, dst, x64_mem_sym(x_sym(kind, 0)))
		return 1
	}
	if name == "__empty" {
		emit2(X_LEA, dst, x64_mem_sym(x_sym(SK_ZERO, 0)))
		return 1
	}
	if name == "__set_ctx" {
		x_gen_to(args[0], XCTX, d)
		return 1
	}
	if name == "__atomic_add" {
		// Returns the old value: lock xadd adds r11 to [p] and leaves the old value in r11.
		x_gen_pair(args[0], args[1], d)
		x_mov(XSCR, pr)
		emit2(X_LOCK_XADD, XSCR, x_mem1(pl, 0))
		if dst >= 0 {
			x_mov(dst, XSCR)
		}
		return 1
	}
	if name == "__atomic_cas" {
		// __atomic_cas(p, old, new) returns the value found at p.
		let p = x_gen_val(args[0], d)
		let d1 = next_depth(p, d)
		let o = x_gen_val(args[1], d1)
		let d2 = next_depth(o, d1)
		mut n = x_gen_val(args[2], d2)
		if n == RAX {
			x_mov(XSCR, n)
			n = XSCR
		}
		x_mov(RAX, o)
		emit2(X_LOCK_CMPXCHG, n, x_mem1(p, 0))
		if dst >= 0 {
			x_mov(dst, RAX)
		}
		return 1
	}
	if name == "__atomic_swap" {
		x_gen_pair(args[0], args[1], d)
		x_mov(XSCR, pr)
		emit2(X_XCHG, XSCR, x_mem1(pl, 0))
		if dst >= 0 {
			x_mov(dst, XSCR)
		}
		return 1
	}
	if name == "__atomic_load" {
		let p = x_gen_val(args[0], d)
		emit3(X_LOAD, dst, x_mem1(p, 0), 3)
		return 1
	}
	if name == "__atomic_store" {
		// xchg is a full barrier, like stlr.
		x_gen_pair(args[0], args[1], d)
		x_mov(XSCR, pr)
		emit2(X_XCHG, XSCR, x_mem1(pl, 0))
		return 1
	}
	if name == "__yield" {
		emit1(X_PAUSE, 0)
		return 1
	}
	return 0
}

// x_gen_store8 stores a byte and, when dst >= 0, also yields the stored value.
fn x_gen_store8(e Call, dst i64, d i64) {
	let p = e.args[0]
	let v = e.args[1]
	mut base = 0
	mut index = -1
	mut off = 0
	mut dv = d
	if cast(Node, p).kind == EX_BINARY && cast(Binary, p).op == "+" && is_const(cast(Binary, p).r) != 0 && x64_fits32(const_val(cast(Binary, p).r)) != 0 {
		off = const_val(cast(Binary, p).r)
		base = x_gen_val(cast(Binary, p).l, d)
		dv = next_depth(base, d)
	} else if cast(Node, p).kind == EX_BINARY && cast(Binary, p).op == "+" && d + 3 <= t_count {
		base = x_gen_val(cast(Binary, p).l, d)
		index = x_gen_val(cast(Binary, p).r, next_depth(base, d))
		dv = next_depth(index, next_depth(base, d))
	} else {
		base = x_gen_val(p, d)
		dv = next_depth(base, d)
	}
	mut val = 0
	if dv >= t_count {
		// Too deep for another temp: keep the address on the stack meanwhile.
		x_push(base)
		x_mov(XSCR, x_gen_val(v, d))
		x_pop(base)
		val = XSCR
	} else if is_const(v) != 0 && const_val(v) == 0 {
		x_load_imm(XSCR, 0)
		val = XSCR
	} else {
		val = x_gen_val(v, dv)
	}
	if index >= 0 {
		emit3(X_STORE, val, x64_mem(base, index, 1, 0), 0)
	} else {
		emit3(X_STORE, val, x_mem1(base, off), 0)
	}
	if dst >= 0 {
		x_mov(dst, val)
	}
}

// ---- calls ----
fn x_int_arg(i i64) i64 {
	return i64("\x07\x06\x02\x01\x08\x09"[i])
}

// x_res_reg is where result i of a call with several results travels.
fn x_res_reg(i i64) i64 {
	return i64("\x00\x02\x01\x06\x07\x08\x09\x0a"[i])
}

// x_arg_regs gives each argument its register: rdi, rsi, rdx, rcx, r8, r9 and xmm0-xmm7
// counted separately, or -1 for an argument that goes on the stack.
fn x_arg_regs(e Call) i64 {
	let ptypes = call_ptypes(e)
	let n = len(e.args)
	let regs = []i64{}
	mut ni = 0
	mut nf = 0
	mut i = 0
	for i < n {
		let t = cast(Node, e.args[i]).type_
		mut fp = i64(i < len(ptypes) && is_float_t(ptypes[i]) != 0)
		if i >= len(ptypes) {
			fp = e_fp(cast(Node, e.args[i]))
		}
		if i < len(ptypes) && is_dyn_value(cast(Ty, t)) != 0 {
			if ni + 1 < 6 {
				regs = append(regs, x_int_arg(ni))
				ni = ni + 2
			} else {
				regs = append(regs, -1)
				ni = 6
			}
		} else if fp != 0 {
			if nf < 8 {
				regs = append(regs, XMM + nf)
			} else {
				regs = append(regs, -1)
			}
			nf = nf + 1
		} else {
			if ni < 6 {
				regs = append(regs, x_int_arg(ni))
			} else {
				regs = append(regs, -1)
			}
			ni = ni + 1
		}
		i = i + 1
	}
	return cast(i64, regs)
}

fn x_arg_regs2(e Call, areg []i64) i64 {
	let ptypes = call_ptypes(e)
	let n = len(e.args)
	let regs = slice_filled(n, -1)
	mut ni = 0
	mut nf = 0
	mut i = 0
	for i < n {
		mut fp = i64(i < len(ptypes) && is_float_t(ptypes[i]) != 0)
		if i >= len(ptypes) {
			fp = e_fp(cast(Node, e.args[i]))
		}
		if i < len(ptypes) && is_dyn_value(cast(Ty, cast(Node, e.args[i]).type_)) != 0 {
			if areg[i] >= 0 {
				regs[i] = x_int_arg(ni + 1)
			}
			ni = ni + 2
		} else if fp != 0 {
			nf = nf + 1
		} else {
			ni = ni + 1
		}
		i = i + 1
	}
	return cast(i64, regs)
}

// x_caller_saved reports whether a call clobbers r (homes are the callee-saved rbx, r12-r14).
fn x_caller_saved(r i64) i64 {
	if is_fp(r) != 0 {
		return 1
	}
	return i64(r != RBX && (r < R12 || r > R14))
}

// x_save_local_fp_homes preserves local float values assigned to caller-saved XMM8-XMM14.
fn x_save_local_fp_homes() {
	let locals = cast(Fn, cur_gen_fn).locals
	mut i = 0
	for i < len(locals) {
		let s = locals[i]
		if is_float_t(s.type_) != 0 && s.reg >= XMM + 8 && s.reg <= XMM + 14 {
			x_push(s.reg)
		}
		i = i + 1
	}
}

fn x_restore_local_fp_homes() {
	let locals = cast(Fn, cur_gen_fn).locals
	mut i = len(locals) - 1
	for i >= 0 {
		let s = locals[i]
		if is_float_t(s.type_) != 0 && s.reg >= XMM + 8 && s.reg <= XMM + 14 {
			x_pop(s.reg)
		}
		i = i - 1
	}
}

// x_save_temps pushes the live caller-saved temps and local float homes before a call.
fn x_save_temps(d i64) {
	mut i = 0
	for i < d {
		if i < t_count && x_caller_saved(t_regs[i]) != 0 {
			x_push(t_regs[i])
		}
		if i < f_count {
			x_push(f_regs[i])
		}
		i = i + 1
	}
	x_save_local_fp_homes()
}

fn x_restore_temps(d i64) {
	x_restore_local_fp_homes()
	mut i = d - 1
	for i >= 0 {
		if i < f_count {
			x_pop(f_regs[i])
		}
		if i < t_count && x_caller_saved(t_regs[i]) != 0 {
			x_pop(t_regs[i])
		}
		i = i - 1
	}
}

// x_gen_call leaves the result in rax (or xmm0 for a float). Live temps are saved first;
// then the callee and every argument are evaluated left to right and pushed, and popped in
// reverse into their registers (or copied into the stack-argument area reserved below the
// pushes), so evaluating one argument can never clobber another.
fn x_gen_call(e i64, d i64) {
	if cast(Node, e).kind == EX_SEQ {
		x_gen_seq(e, -1, d)
		return
	}
	let args = cast(Call, e).args
	let n = len(args)
	let areg = cast([]i64, x_arg_regs(cast(Call, e)))
	let areg2 = cast([]i64, x_arg_regs2(cast(Call, e), areg))
	let f = cast(Fn, cast(Call, e).fn_)
	x_save_temps(d)
	let stackoffs = slice_filled(n, -1)
	let pushslots = slice_filled(n, -1)
	mut stack_words = 0
	mut stage_slot = 0
	if cast(i64, f) == 0 {
		stage_slot = 1
	}
	mut nvec = 0
	mut i = 0
	for i < n {
		let a = cast(Node, args[i])
		pushslots[i] = stage_slot
		if is_dyn_value(cast(Ty, a.type_)) != 0 {
			stage_slot = stage_slot + 2
		} else {
			stage_slot = stage_slot + 1
		}
		if areg[i] < 0 {
			if is_dyn_value(cast(Ty, a.type_)) != 0 {
				stack_words = align_up(stack_words, 2)
				stackoffs[i] = 8 * stack_words
				stack_words = stack_words + 2
			} else {
				stackoffs[i] = 8 * stack_words
				stack_words = stack_words + 1
			}
		} else if areg[i] >= XMM {
			nvec = nvec + 1
		}
		i = i + 1
	}
	let area = align_up(8 * stack_words, 16)
	if area > 0 {
		emit2(X_SUBI, RSP, area)
	}
	mut callee_slot = 0
	if cast(i64, f) == 0 {
		x_push(x_gen_val(cast(Call, e).callee, d))
		callee_slot = 16
	}
	i = 0
	for i < n {
		let a = cast(Node, args[i])
		if is_dyn_value(cast(Ty, a.type_)) != 0 {
			let r0 = treg(d)
			let r1 = treg(d + 1)
			x_gen_dyn_pair(cast(i64, a), r0, r1, d)
			x_push(r0)
			x_push(r1)
		} else {
			x_push(x_gen_val(cast(i64, a), d))
		}
		i = i + 1
	}
	i = n - 1
	for i >= 0 {
		let a = cast(Node, args[i])
		let r = areg[i]
		let pushslot = pushslots[i]
		if is_dyn_value(cast(Ty, a.type_)) != 0 {
			if r >= 0 {
				x_pop(areg2[i])
				x_pop(r)
			} else {
				x_pop(XSCR)
				x_st(XSCR, x_mem1(RSP, 16 * (pushslot + 1) + stackoffs[i] + 8), 3)
				x_pop(XSCR)
				x_st(XSCR, x_mem1(RSP, 16 * pushslot + stackoffs[i]), 3)
			}
		} else if r >= 0 {
			x_pop(r)
		} else {
			x_pop(XSCR)
			x_st(XSCR, x_mem1(RSP, 16 * pushslot + stackoffs[i]), 3)
		}
		i = i - 1
	}
	if cast(i64, f) == 0 {
		x_pop(RAX)
	}
	if cast(i64, f) != 0 {
		if f.extern_ != 0 {
			// al counts the vector registers a variadic callee must save.
			x_load_imm(RAX, nvec)
		}
		emit1(X_CALL, x_sym(SK_FN, f.index))
		f.used = 1
	} else {
		emit2(X_MOV_RR, R11, RAX)
		x_ld(RAX, x_mem1(R11, 0), 3)
		emit1(X_CALL_R, RAX)
	}
	if area > 0 {
		emit2(X_ADDI, RSP, area)
	}
	x_restore_temps(d)
}

// ---- conditions ----
// x_gen_cmp_branch branches to target when comparison e evaluates to when_true.
fn x_gen_cmp_branch(e Binary, target i64, d i64, when_true i64) {
	if e_fp(cast(Node, e.l)) != 0 || e_fp(cast(Node, e.r)) != 0 {
		x_gen_compare(e, d)
		if when_true != 0 {
			x_jcc(cmp_cc, cmp_unord, target)
		} else {
			x_jcc(cmp_cc ^ 1, cmp_unord, target)
		}
		return
	}
	mut cc = x_cond(e.op)
	mut l = e.l
	mut r = e.r
	let unsigned = i64(e_unsigned(cast(Node, l)) != 0 || e_unsigned(cast(Node, r)) != 0)
	if unsigned != 0 {
		cc = x_ucond(e.op)
	}
	if is_const(l) != 0 {
		let t = l
		l = r
		r = t
		cc = x_swap_cc(cc)
	}
	if is_const(r) != 0 && const_val(r) == 0 && !(unsigned != 0 && cc != XC_E && cc != XC_NE) {
		if cc == XC_E || cc == XC_NE {
			let on_zero = i64(i64((cc == XC_E)) == when_true)
			let k = low_bits_test(l)
			if k > 0 {
				x_test_imm(x_gen_val(cast(Binary, l).l, d), (1 << k) - 1)
			} else {
				let z = x_gen_val(l, d)
				emit2(X_TEST, z, z)
			}
			if on_zero != 0 {
				emit2(X_JCC, XC_E, target)
			} else {
				emit2(X_JCC, XC_NE, target)
			}
			return
		}
		if cc == XC_L || cc == XC_GE {
			let on_neg = i64(i64((cc == XC_L)) == when_true)
			let s = x_gen_val(l, d)
			emit2(X_TEST, s, s)
			if on_neg != 0 {
				emit2(X_JCC, XC_S, target)
			} else {
				emit2(X_JCC, XC_NS, target)
			}
			return
		}
	}
	x_gen_compare(e, d)
	if when_true != 0 {
		emit2(X_JCC, cmp_cc, target)
	} else {
		emit2(X_JCC, cmp_cc ^ 1, target)
	}
}

// x_gen_cond branches to f when e is false and falls through when it is true.
fn x_gen_cond(e i64, f i64, d i64) {
	x_gen_branch(e, f, d, 0)
}

// x_gen_branch branches to target when e's truth equals when_true.
fn x_gen_branch(e i64, target i64, d i64, when_true i64) {
	if is_const(e) != 0 {
		if i64((const_val(e) != 0)) == when_true {
			emit1(X_JMP, target)
		}
		return
	}
	let k = cast(Node, e).kind
	if k == EX_SEQ {
		// The statements start at depth 0: keep the temps below d, as x_gen_seq does (#492).
		mut i = 0
		for i < d {
			if i < t_count {
				x_push(t_regs[i])
			}
			if i < f_count {
				x_push(f_regs[i])
			}
			i = i + 1
		}
		x_gen_stmts(cast(SeqExpr, e).stmts)
		i = d - 1
		for i >= 0 {
			if i < f_count {
				x_pop(f_regs[i])
			}
			if i < t_count {
				x_pop(t_regs[i])
			}
			i = i - 1
		}
		x_gen_branch(cast(SeqExpr, e).value, target, d, when_true)
		return
	}
	if k == EX_UNARY && cast(Unary, e).op == "!" {
		x_gen_branch(cast(Unary, e).x, target, d, i64(when_true == 0))
		return
	}
	if k == EX_BINARY {
		let op = cast(Binary, e).op
		let is_and = i64(op == "&&")
		if is_and != 0 || op == "||" {
			// Branching on the operator's own sense chains; the other sense skips ahead.
			if is_and != when_true {
				x_gen_branch(cast(Binary, e).l, target, d, when_true)
				x_gen_branch(cast(Binary, e).r, target, d, when_true)
			} else {
				let skip = new_label()
				x_gen_branch(cast(Binary, e).l, skip, d, i64(when_true == 0))
				x_gen_branch(cast(Binary, e).r, target, d, when_true)
				x_label(skip)
			}
			return
		}
		if x_cond(op) >= 0 {
			x_gen_cmp_branch(cast(Binary, e), target, d, when_true)
			return
		}
		if op == "&" && is_const(cast(Binary, e).r) != 0 && pow2_log(const_val(cast(Binary, e).r)) >= 0 {
			x_test_imm(x_gen_val(cast(Binary, e).l, d), const_val(cast(Binary, e).r))
			if when_true != 0 {
				emit2(X_JCC, XC_NE, target)
			} else {
				emit2(X_JCC, XC_E, target)
			}
			return
		}
	}
	let v = x_gen_val(e, d)
	if is_fp(v) != 0 {
		emit2(X_XORPD, XFSCR, XFSCR)
		emit2(X_UCOMISD, v, XFSCR)
	} else {
		emit2(X_TEST, v, v)
	}
	if when_true != 0 {
		emit2(X_JCC, XC_NE, target)
	} else {
		emit2(X_JCC, XC_E, target)
	}
}

// ---- statements ----
fn x_gen_effect(e i64) {
	if has_effects(e) == 0 {
		return
	}
	if is_real_call(e) != 0 {
		x_gen_call(e, 0)
	} else if cast(Node, e).kind == EX_SEQ {
		x_gen_seq(e, -1, 0)
	} else if cast(Node, e).kind == EX_CALL && (cast(Call, e).name == "__prefetchw" || cast(Call, e).name == "store8") {
		x_gen_intrinsic(cast(Call, e), -1, 0)
	} else if cast(Node, e).kind == EX_CALL && cast(Call, e).intrinsic != 0 {
		mut r = 0
		if e_fp(cast(Node, e)) != 0 {
			r = freg(0)
		} else {
			r = treg(0)
		}
		x_gen_intrinsic(cast(Call, e), r, 0)
	} else {
		x_gen_val(e, 0)
	}
}

fn x_assign_local(s Sym, v i64) {
	if is_dyn_value(cast(Ty, s.type_)) != 0 {
		let r0 = treg(0)
		let r1 = treg(1)
		x_gen_dyn_pair(v, r0, r1, 0)
		if s.reg == REG_SLOT {
			x_slot_store(r0, s.off)
			x_slot_store(r1, s.off + 8)
		} else {
			err_code_at(s.pos, "E990 INTERNAL", "dyn local is not in a two-word frame slot")
		}
		return
	}
	if s.reg >= 0 {
		x_gen_to(v, s.reg, 0)
	} else if s.reg == REG_SLOT {
		x_slot_store(x_gen_val(v, 0), s.off)
	} else {
		x_gen_effect(v)
	}
}

// x_gen_store_mem stores v through an EX_MEM or EX_ELEM target. The address parts are
// computed into stable temps first; a[i] = a[i] op x loads the element only once.
fn x_gen_store_mem(t i64, v i64) {
	if is_dyn_value(cast(Ty, cast(Node, t).type_)) != 0 {
		x_gen_dyn_addr(cast(Node, t), 0)
		x_push(XSCR)
		let r0 = treg(0)
		let r1 = treg(1)
		x_gen_dyn_pair(v, r0, r1, 0)
		x_pop(XSCR)
		x_st(r0, x_mem1(XSCR, 0), 3)
		x_st(r1, x_mem1(XSCR, 8), 3)
		return
	}
	let fpv = e_fp(cast(Node, t))
	mut base = 0
	mut idx = -1
	mut scale = 1
	mut off = 0
	mut d = 0
	let size = type_width(cast(Ty, cast(Node, t).type_))
	if cast(Node, t).kind == EX_ELEM {
		let h = x_gen_val(cast(ElemExpr, t).seq, 0)
		d = next_depth(h, 0)
		let ix = cast(ElemExpr, t).idx
		if is_const(ix) != 0 && cast(ElemExpr, t).safe == 0 {
			idx = treg(d)
			x_load_imm(idx, const_val(ix))
			d = d + 1
		} else if is_const(ix) == 0 {
			idx = x_gen_val(ix, d)
			d = next_depth(idx, d)
		}
		if cast(ElemExpr, t).safe == 0 {
			x_ld(XSCR2, x_mem1(h, 0), 3)
			emit2(X_CMP, idx, XSCR2)
			emit2(X_JCC, XC_AE, trap_at(idx, XSCR2, 0))
		}
		scale = size
		if cast(ElemExpr, t).str != 0 {
			base = h
			off = 8
		} else {
			base = treg(d)
			d = d + 1
			x_ld(base, x_mem1(h, 16), 3)
		}
		if is_const(ix) != 0 {
			off = off + const_val(ix) * size
			idx = -1
		}
	} else {
		base = x_gen_val(cast(MemExpr, t).base, 0)
		d = next_depth(base, 0)
		off = cast(MemExpr, t).off
		let ix = cast(MemExpr, t).index
		if ix != 0 && is_const(ix) != 0 && cast(MemExpr, t).len == 0 {
			off = off + const_val(ix) * cast(MemExpr, t).scale
		} else if ix != 0 {
			idx = x_gen_val(ix, d)
			d = next_depth(idx, d)
			if cast(MemExpr, t).len != 0 {
				x_bounds_check(idx, cast(MemExpr, t).len, d)
			}
			if x_scale_ok(cast(MemExpr, t).scale) != 0 {
				scale = cast(MemExpr, t).scale
			} else {
				let nb = treg(d)
				d = d + 1
				emit3(X_IMUL_RRI, nb, idx, cast(MemExpr, t).scale)
				emit2(X_ADD, nb, base)
				base = nb
				idx = -1
			}
		}
	}
	mut val = 0
	if cast(Node, v).kind == EX_BINARY && d + 2 < t_count && d + 2 < f_count && has_effects(t) == 0 && expr_equal(cast(Binary, v).l, t) != 0 {
		mut cur = 0
		if fpv != 0 {
			cur = freg(d)
		} else {
			cur = treg(d)
		}
		mm_base = base
		mm_index = idx
		mm_scale = scale
		mm_off = off
		x_emit_load(cur, cast(Node, t).type_)
		let saved = node_copy(cast(Binary, v).l)
		cast(Node, cast(Binary, v).l).kind = EX_REG
		cast(RegExpr, cast(Binary, v).l).num = cur
		x_gen_to(v, cur, d + 1)
		node_restore(cast(Binary, v).l, saved)
		val = cur
	} else if fpv == 0 && is_const(v) != 0 && const_val(v) == 0 {
		x_load_imm(XSCR, 0)
		val = XSCR
	} else {
		val = x_gen_val(v, d)
	}
	mm_base = base
	mm_index = idx
	mm_scale = scale
	mm_off = off
	x_emit_store(val, cast(Node, t).type_)
}

fn x_gen_store_index(t IndexExpr, v i64) {
	let base = x_gen_val(t.x, 0)
	mut d = next_depth(base, 0)
	let ix = t.i
	mut index = -1
	mut off = 0
	if is_const(ix) != 0 && x64_fits32(const_val(ix) * 8) != 0 {
		off = const_val(ix) * 8
	} else {
		index = x_gen_val(ix, d)
		d = next_depth(index, d)
	}
	mut m = 0
	if index < 0 {
		m = x_mem1(base, off)
	} else {
		m = x64_mem(base, index, 8, 0)
	}
	let fpv = i64(e_fp(cast(Node, v)) != 0 || e_fp(cast(Node, t)) != 0)
	mut val = 0
	if cast(Node, v).kind == EX_BINARY && d + 1 < t_count && d + 1 < f_count && has_effects(cast(i64, t)) == 0 && expr_equal(cast(Binary, v).l, cast(i64, t)) != 0 {
		// a[i] = a[i] op x: load the element once and update it in a register.
		mut cur = 0
		if fpv != 0 {
			cur = freg(d)
		} else {
			cur = treg(d)
		}
		x_ld(cur, m, 3)
		let saved = node_copy(cast(Binary, v).l)
		cast(Node, cast(Binary, v).l).kind = EX_REG
		cast(RegExpr, cast(Binary, v).l).num = cur
		x_gen_to(v, cur, d + 1)
		node_restore(cast(Binary, v).l, saved)
		val = cur
	} else if fpv == 0 && is_const(v) != 0 && const_val(v) == 0 {
		x_load_imm(XSCR, 0)
		val = XSCR
	} else {
		val = x_gen_val(v, d)
	}
	x_st(val, m, 3)
}

fn x_gen_assign(s AssignStmt) {
	let t = s.target
	let v = s.value
	if cast(Node, t).kind == EX_INDEX {
		x_gen_store_index(cast(IndexExpr, t), v)
		return
	}
	if cast(Node, t).kind == EX_MEM || cast(Node, t).kind == EX_ELEM {
		x_gen_store_mem(t, v)
		return
	}
	let sym = cast(Sym, cast(IdentExpr, t).ref)
	if sym.kind == SYM_LOCAL {
		x_assign_local(sym, v)
		return
	}
	if is_dyn_value(cast(Ty, sym.type_)) != 0 {
		let r0 = treg(0)
		let r1 = treg(1)
		x_gen_dyn_pair(v, r0, r1, 0)
		if sym.tls != 0 {
			x_st(r0, x_mem1(XCTX, tls_off(sym)), 3)
			x_st(r1, x_mem1(XCTX, tls_off(sym) + 8), 3)
		} else {
			x_st(r0, x64_mem_sym(x_sym(SK_VAR, sym.index)), 3)
			x_st(r1, x64_mem_sym(x_sym(SK_VAR, sym.words)), 3)
		}
		return
	}
	let r = x_gen_val(v, 0)
	if sym.tls != 0 {
		x_st(r, x_mem1(XCTX, tls_off(sym)), 3)
		return
	}
	x_st(r, x64_mem_sym(x_sym(SK_VAR, sym.index)), 3)
}

fn x_gen_while(s WhileStmt) {
	let cond = s.cond
	let body_l = new_label()
	let cond_l = new_label()
	let post_l = new_label()
	let end_l = new_label()
	if s.once_ != 0 {
		// A switch: break leaves it, continue goes to the enclosing loop.
		mut cont = -1
		if len(g_loops) >= 2 {
			cont = g_loops[len(g_loops) - 2]
		}
		g_loops = append(g_loops, cont)
		g_loops = append(g_loops, end_l)
		g_loop_labels = append(g_loop_labels, "")
		x_gen_stmts(cast(Block, s.body).stmts)
		slice_truncate(g_loops, len(g_loops) - 2)
		slice_truncate(g_loop_labels, len(g_loop_labels) - 1)
		x_label(end_l)
		return
	}
	if is_const(cond) != 0 && const_val(cond) == 0 {
		return
	}
	let forever = is_const(cond)
	mut cont_l = cond_l
	if s.post != 0 {
		cont_l = post_l
	} else if forever != 0 {
		cont_l = body_l
	}
	// Rotated loop: the test sits at the bottom, so each iteration takes one branch.
	if forever == 0 {
		emit1(X_JMP, cond_l)
	}
	x_label(body_l)
	x_gen_poll()
	g_loops = append(g_loops, cont_l)
	g_loops = append(g_loops, end_l)
	g_loop_labels = append(g_loop_labels, s.label)
	x_gen_stmts(cast(Block, s.body).stmts)
	slice_truncate(g_loops, len(g_loops) - 2)
	slice_truncate(g_loop_labels, len(g_loop_labels) - 1)
	x_label(post_l)
	if s.post != 0 {
		x_gen_stmt(s.post)
	}
	if forever != 0 {
		emit1(X_JMP, body_l)
	} else {
		x_label(cond_l)
		x_gen_branch(cond, body_l, 0, 1)
	}
	x_label(end_l)
}

fn x_gen_stmts(stmts []i64) {
	mut i = 0
	for i < len(stmts) {
		x_gen_stmt(stmts[i])
		i = i + 1
	}
}

fn x_result_reg(f Fn) i64 {
	if len(f.rtypes) == 1 && is_float_t(f.rtypes[0]) != 0 {
		return XMM
	}
	return RAX
}

fn x_gen_stmt(s i64) {
	let k = cast(Node, s).kind
	if k == ST_BLOCK {
		x_gen_stmts(cast(Block, s).stmts)
	} else if k == ST_LET {
		x_assign_local(cast(Sym, cast(LetStmt, s).sym), cast(LetStmt, s).init)
	} else if k == ST_ASSIGN {
		x_gen_assign(cast(AssignStmt, s))
	} else if k == ST_EXPR {
		x_gen_effect(cast(ExprStmt, s).x)
	} else if k == ST_IF && x_try_if_increment(cast(IfStmt, s)) != 0 {
		// The condition flags drive a conditional move of x + 1.
	} else if k == ST_IF && x_try_select(cast(IfStmt, s)) != 0 {
		// Done: both arms computed and picked with cmov.
	} else if k == ST_IF {
		let else_l = new_label()
		x_gen_cond(cast(IfStmt, s).cond, else_l, 0)
		x_gen_stmts(cast(Block, cast(IfStmt, s).then).stmts)
		if cast(IfStmt, s).else_ != 0 {
			let end_l = new_label()
			emit1(X_JMP, end_l)
			x_label(else_l)
			x_gen_stmt(cast(IfStmt, s).else_)
			x_label(end_l)
		} else {
			x_label(else_l)
		}
	} else if k == ST_WHILE {
		x_gen_while(cast(WhileStmt, s))
	} else if k == ST_RETURN {
		x_gen_return(cast(ReturnStmt, s))
	} else if k == ST_BREAK && len(cast(BreakStmt, s).label) != 0 {
		emit1(X_JMP, g_loops[2 * loop_with_label(cast(BreakStmt, s).label) + 1])
	} else if k == ST_CONTINUE && len(cast(ContinueStmt, s).label) != 0 {
		emit1(X_JMP, g_loops[2 * loop_with_label(cast(ContinueStmt, s).label)])
	} else if k == ST_BREAK {
		emit1(X_JMP, g_loops[len(g_loops) - 1])
	} else if k == ST_CONTINUE {
		// A switch block passes continue on to the loop around it.
		mut i = len(g_loops) - 2
		for g_loops[i] < 0 {
			i = i - 2
		}
		emit1(X_JMP, g_loops[i])
	} else if k == ST_CALLMULTI {
		x_gen_call(cast(CallMultiStmt, s).call, 0)
		let syms = cast(CallMultiStmt, s).syms
		mut i = 0
		for i < len(syms) {
			let sym = syms[i]
			if sym.reg >= 0 {
				x_mov(sym.reg, x_res_reg(i))
			} else if sym.reg == REG_SLOT {
				x_slot_store(x_res_reg(i), sym.off)
			}
			i = i + 1
		}
	}
}

// Several results are pushed in order and popped into rax, rdx, rcx, rsi, rdi, r8, r9, r10
// (floats as bits); a single result goes to rax or xmm0.
fn x_gen_return(s ReturnStmt) {
	let f = cur_gen_fn
	if cast(i64, s.values) != 0 {
		let vals = s.values
		let lanes = []i64{}
		mut nlanes = 0
		mut i = 0
		for i < len(vals) {
			let v = cast(Node, vals[i])
			lanes = append(lanes, nlanes)
			if is_dyn_value(cast(Ty, v.type_)) != 0 {
				let r0 = treg(0)
				let r1 = treg(1)
				x_gen_dyn_pair(cast(i64, v), r0, r1, 0)
				x_push(r0)
				x_push(r1)
				nlanes = nlanes + 2
			} else {
				x_push(x_gen_val(cast(i64, v), 0))
				nlanes = nlanes + 1
			}
			i = i + 1
		}
		i = len(vals) - 1
		for i >= 0 {
			let v = cast(Node, vals[i])
			let start = lanes[i]
			if is_dyn_value(cast(Ty, v.type_)) != 0 {
				x_pop(x_res_reg(start + 1))
				x_pop(x_res_reg(start))
			} else {
				x_pop(x_res_reg(start))
			}
			i = i - 1
		}
	} else if s.value != 0 {
		if is_dyn_value(cast(Ty, cast(Node, s.value).type_)) != 0 {
			x_gen_dyn_pair(s.value, RAX, RDX, 0)
		} else {
			x_gen_to(s.value, x_result_reg(cast(Fn, f)), 0)
		}
	} else {
		x_load_imm(RAX, 0)
	}
	emit1(XP_RET, 0)
}

// ---- if-conversion ----
// x_gen_flags sets the flags for condition e and returns the condition code meaning true.
fn x_gen_flags(e i64, d i64) i64 {
	if cast(Node, e).kind == EX_UNARY && cast(Unary, e).op == "!" {
		return x_gen_flags(cast(Unary, e).x, d) ^ 1
	}
	if cast(Node, e).kind == EX_SEQ {
		mut i = 0
		for i < d {
			if i < t_count {
				x_push(t_regs[i])
			}
			if i < f_count {
				x_push(f_regs[i])
			}
			i = i + 1
		}
		x_gen_stmts(cast(SeqExpr, e).stmts)
		i = d - 1
		for i >= 0 {
			if i < f_count {
				x_pop(f_regs[i])
			}
			if i < t_count {
				x_pop(t_regs[i])
			}
			i = i - 1
		}
		return x_gen_flags(cast(SeqExpr, e).value, d)
	}
	if cast(Node, e).kind == EX_BINARY {
		let cc = x_cond(cast(Binary, e).op)
		if (cc == XC_E || cc == XC_NE) && e_fp(cast(Node, cast(Binary, e).l)) == 0 && is_const(cast(Binary, e).r) != 0 && const_val(cast(Binary, e).r) == 0 && low_bits_test(cast(Binary, e).l) > 0 {
			let l = cast(Binary, e).l
			x_test_imm(x_gen_val(cast(Binary, l).l, d), (1 << low_bits_test(l)) - 1)
			return cc
		}
		if cc >= 0 {
			x_gen_compare(cast(Binary, e), d)
			return cmp_cc
		}
	}
	let v = x_gen_val(e, d)
	emit2(X_TEST, v, v)
	return XC_NE
}

fn x_try_if_increment(s IfStmt) i64 {
	if x_float_cmp(s.cond) != 0 {
		return 0
	}
	let a = cast(AssignStmt, if_increment_assignment(s))
	if cast(i64, a) == 0 {
		return 0
	}
	let x = cast(Sym, cast(IdentExpr, a.target).ref)
	let cc = x_gen_flags(s.cond, 0)
	// LEA preserves the flags set by the condition and avoids spilling x + 1 while
	// compiler-created condition sequences are evaluated.
	if cast(Binary, a.value).ovf == OVF_CHECK {
		// Checked (#362): add the condition (0 or 1) with add, which sets OF and CF.
		x_setcc(XSCR, cc, 0)
		emit2(X_ADD, x.reg, XSCR)
		x_checked_flags(OVK_ADD, i64(is_unsigned_t(cast(Ty, x.type_)) == 0))
		return 1
	}
	emit2(X_LEA, XSCR, x_mem1(x.reg, 1))
	emit3(X_CMOVCC, x.reg, XSCR, cc)
	return 1
}

// x_float_cmp reports whether c (under any number of !) compares floats, which cmov cannot
// select on because of the unordered case.
fn x_float_cmp(c_in i64) i64 {
	mut c = c_in
	for cast(Node, c).kind == EX_UNARY && cast(Unary, c).op == "!" {
		c = cast(Unary, c).x
	}
	if cast(Node, c).kind == EX_SEQ {
		return x_float_cmp(cast(SeqExpr, c).value)
	}
	return i64(cast(Node, c).kind == EX_BINARY && x_cond(cast(Binary, c).op) >= 0 && (e_fp(cast(Node, cast(Binary, c).l)) != 0 || e_fp(cast(Node, cast(Binary, c).r)) != 0))
}

// x_try_select compiles `if c { x = a; } else { x = b; }` as x = cmov(c, a, b), like
// Go's branchelim: both values are cheap, so computing both beats a mispredicted branch.
fn x_try_select(s IfStmt) i64 {
	let c = s.cond
	if has_effects(c) != 0 || contains_call(c) != 0 || is_const(c) != 0 || e_fp(cast(Node, c)) != 0 {
		return 0
	}
	if cast(Node, c).kind == EX_BINARY && (cast(Binary, c).op == "&&" || cast(Binary, c).op == "||") {
		return 0
	}
	if x_float_cmp(c) != 0 {
		return 0
	}
	let ta = single_reg_assign(cast(Block, s.then))
	if cast(i64, ta) == 0 {
		return 0
	}
	let x = cast(Sym, cast(IdentExpr, ta.target).ref)
	if is_fp(x.reg) != 0 {
		return 0
	}
	mut fb = cast(AssignStmt, 0)
	if s.else_ != 0 {
		if cast(Node, s.else_).kind != ST_BLOCK {
			return 0
		}
		fb = single_reg_assign(cast(Block, s.else_))
		if cast(i64, fb) == 0 || cast(i64, cast(Sym, cast(IdentExpr, fb.target).ref)) != cast(i64, x) {
			return 0
		}
	}
	if op_cost(ta.value) > 6 || (cast(i64, fb) != 0 && op_cost(fb.value) > 6) || t_count < 4 || f_count < 4 {
		return 0
	}
	let a = x_gen_val(ta.value, 0)
	mut d = next_depth(a, 0)
	mut b = x.reg
	if cast(i64, fb) != 0 {
		b = x_gen_val(fb.value, d)
		d = next_depth(b, d)
	}
	let cc = x_gen_flags(c, d)
	let xr = x.reg
	if xr == a {
		emit3(X_CMOVCC, xr, b, cc ^ 1)
	} else if xr == b {
		emit3(X_CMOVCC, xr, a, cc)
	} else {
		emit2(X_MOV_RR, xr, b)
		emit3(X_CMOVCC, xr, a, cc)
	}
	return 1
}

// ---- functions ----
// x_par_move performs the moves dsts[i] = srcs[i] in parallel: a destination is written
// only once no pending move still reads it, and a cycle is broken through a scratch register.
fn x_par_move(dsts []i64, srcs []i64) {
	let n = len(dsts)
	let done = slice_filled(n, 0)
	mut left = n
	for left > 0 {
		mut progress = 0
		mut i = 0
		for i < n {
			if done[i] == 0 {
				let dst = dsts[i]
				if dst == srcs[i] || x_pending_src(srcs, cast([]i64, done), dst) == 0 {
					x_mov(dst, srcs[i])
					cast([]i64, done)[i] = 1
					left = left - 1
					progress = 1
				}
			}
			i = i + 1
		}
		if left > 0 && progress == 0 {
			i = 0
			for done[i] != 0 {
				i = i + 1
			}
			let blocked = dsts[i]
			mut scr = XSCR
			if is_fp(blocked) != 0 {
				scr = XFSCR
			}
			x_mov(scr, blocked)
			mut j = 0
			for j < n {
				if done[j] == 0 && srcs[j] == blocked {
					srcs[j] = scr
				}
				j = j + 1
			}
		}
	}
}

fn x_pending_src(srcs []i64, done []i64, r i64) i64 {
	mut j = 0
	for j < len(srcs) {
		if done[j] == 0 && srcs[j] == r {
			return 1
		}
		j = j + 1
	}
	return 0
}

// A non-leaf function can use caller-saved XMM homes when its calls stay outside loops.
// x_save_temps preserves those homes around each call; keeping calls out of loops avoids
// adding spills to a hot iteration.
fn x_stmts_calls_in_loop(stmts []i64) i64 {
	mut i = 0
	for i < len(stmts) {
		if x_stmt_calls_in_loop(stmts[i]) != 0 {
			return 1
		}
		i = i + 1
	}
	return 0
}

fn x_stmt_calls_in_loop(s i64) i64 {
	if s == 0 {
		return 0
	}
	let k = cast(Node, s).kind
	if k == ST_BLOCK {
		return x_stmts_calls_in_loop(cast(Block, s).stmts)
	}
	if k == ST_IF {
		return i64(x_stmt_calls_in_loop(cast(IfStmt, s).then) != 0 || x_stmt_calls_in_loop(cast(IfStmt, s).else_) != 0)
	}
	if k == ST_WHILE {
		return stmt_has_call(s)
	}
	return 0
}

// x_assign_homes gives each local a register or frame slot and builds the temp pools.
// It returns the number of frame slots.
fn x_assign_homes(f Fn) i64 {
	let locals = cast([]i64, f.locals)
	let leaf = f.leaf
	let fp_homes = i64(leaf != 0 || x_stmts_calls_in_loop(cast(Block, f.body).stmts) == 0)
	let pool = []i64{}
	pool = append(pool, RBX)
	pool = append(pool, R12)
	pool = append(pool, R13)
	pool = append(pool, R14)
	let fpool = []i64{}
	mut r = 8
	for fp_homes != 0 && r <= 14 {
		fpool = append(fpool, XMM + r)
		r = r + 1
	}
	mut nslots = 0
	mut i = 0
	for i < len(locals) {
		let s = cast(Sym, locals[i])
		s.reg = REG_DEAD
		if is_dyn_value(cast(Ty, s.type_)) != 0 {
			s.addr = 1
			cast(Sym, s).words = 2
		}
		if s.addr != 0 {
			cast(Sym, s).reg = REG_SLOT
			mut nw = 1
			if cast(Sym, s).words > 1 {
				nw = cast(Sym, s).words
			}
			nslots = nslots + nw
			s.off = -8 * nslots
		}
		i = i + 1
	}
	// Hand out registers by descending loop-weighted use count.
	mut next = 0
	mut fnext = 0
	for {
		mut best = cast(Sym, 0)
		i = 0
		for i < len(locals) {
			let c = cast(Sym, locals[i])
			if cast(Sym, c).reg == REG_DEAD && cast(Sym, c).uses > 0 && (cast(i64, best) == 0 || c.uses > best.uses) {
				best = cast(Sym, c)
			}
			i = i + 1
		}
		if cast(i64, best) == 0 {
			break
		}
		if is_float_t(best.type_) != 0 && fnext < len(fpool) {
			best.reg = fpool[fnext]
			used_fregs = used_fregs | (1 << (best.reg - XMM))
			fnext = fnext + 1
		} else if is_float_t(best.type_) == 0 && next < len(pool) {
			best.reg = pool[next]
			used_regs = used_regs | (1 << best.reg)
			next = next + 1
		} else {
			best.reg = REG_SLOT
			best.off = -8 - 8 * nslots
			nslots = nslots + 1
		}
	}
	// Leftover callee-saved registers survive calls for free; caller-saved ones cost
	// nothing in the prologue. Prefer whichever this function needs.
	let cross = i64(leaf == 0 && stmts_cross_calls(cast(Block, f.body).stmts) != 0)
	t_regs = []i64{}
	f_regs = []i64{}
	if cross != 0 {
		for next < len(pool) {
			t_regs = append(t_regs, pool[next])
			next = next + 1
		}
	}
	t_regs = append(t_regs, RSI)
	t_regs = append(t_regs, RDI)
	t_regs = append(t_regs, R8)
	t_regs = append(t_regs, R9)
	t_regs = append(t_regs, R10)
	for next < len(pool) {
		t_regs = append(t_regs, pool[next])
		next = next + 1
	}
	r = 1
	for r <= 7 {
		f_regs = append(f_regs, XMM + r)
		r = r + 1
	}
	if fp_homes != 0 {
		for fnext < len(fpool) {
			f_regs = append(f_regs, fpool[fnext])
			fnext = fnext + 1
		}
	} else {
		r = 8
		for r <= 14 {
			f_regs = append(f_regs, XMM + r)
			r = r + 1
		}
	}
	t_count = len(t_regs)
	f_count = len(f_regs)
	return nslots
}

// x_entry_moves moves the parameters from their argument registers (or stack slots at
// [rbp + 16 + 8k]) into their homes; register moves run in parallel.
fn x_entry_moves(f Fn) {
	let locals = cast([]i64, f.locals)
	let dsts = []i64{}
	let srcs = []i64{}
	let stack_syms = []i64{}
	mut ni = 0
	mut nf = 0
	x_nstack = 0
	mut i = 0
	for i < len(f.params) {
		let s = cast(Sym, locals[i])
		let pt = f.ptypes[i]
		if is_dyn_value(cast(Ty, pt)) != 0 {
			if ni + 1 < 6 {
				let r0 = x_int_arg(ni)
				let r1 = x_int_arg(ni + 1)
				ni = ni + 2
				if s.reg == REG_SLOT {
					x_slot_store(r0, s.off)
					x_slot_store(r1, s.off + 8)
				} else {
					err_code_at(s.pos, "E990 INTERNAL", "dyn parameter is not in a two-word frame slot")
				}
			} else {
				ni = 6
				x_nstack = align_up(x_nstack, 2)
				x_slot_load(XSCR, 16 + 8 * x_nstack)
				x_slot_load(XSCR2, 24 + 8 * x_nstack)
				if cast(Sym, s).reg == REG_SLOT {
					x_slot_store(XSCR, s.off)
					x_slot_store(XSCR2, s.off + 8)
				} else {
					err_code_at(s.pos, "E990 INTERNAL", "dyn parameter is not in a two-word frame slot")
				}
				x_nstack = x_nstack + 2
			}
			i = i + 1
			continue
		}
		mut src = -1
		if is_float_t(pt) != 0 {
			if nf < 8 {
				src = XMM + nf
			}
			nf = nf + 1
		} else {
			if ni < 6 {
				src = x_int_arg(ni)
			}
			ni = ni + 1
		}
		if src < 0 {
			stack_syms = append(stack_syms, cast(i64, s))
			stack_syms = append(stack_syms, 16 + 8 * x_nstack)
			x_nstack = x_nstack + 1
		} else if cast(Sym, s).reg >= 0 {
			dsts = append(dsts, cast(Sym, s).reg)
			srcs = append(srcs, src)
		} else if cast(Sym, s).reg == REG_SLOT {
			x_slot_store(src, s.off)
		}
		i = i + 1
	}
	x_par_move(cast([]i64, dsts), cast([]i64, srcs))
	i = 0
	for i < len(stack_syms) {
		let s = cast(Sym, stack_syms[i])
		let off = stack_syms[i + 1]
		if s.reg >= 0 {
			x_slot_load(cast(Sym, s).reg, cast(i64, off))
		} else if cast(Sym, s).reg == REG_SLOT {
			x_slot_load(XSCR, cast(i64, off))
			x_slot_store(XSCR, s.off)
		}
		i = i + 2
	}
	if f.env_sym != 0 {
		let es = cast(Sym, f.env_sym)
		if es.reg >= 0 {
			x_mov(es.reg, R11)
		} else if es.reg == REG_SLOT {
			x_slot_store(R11, es.off)
		}
	}
}

// rt_task_swap(from rdi, to rsi): store rbx, rbp, r12-r14 and rsp at from, load them from
// to, and return on the other stack (r15, the core context, is the same on both).
fn x_task_swap_bytes() i64 {
	let hex = "48891f48896f084c8967104c896f184c89772048896728488b1e488b6e084c8b66104c8b6e184c8b7620488b6628c3"
	let v = []i64{}
	mut i = 0
	for i < len(hex) {
		mut hi = i64(hex[i]) - '0'
		if i64(hex[i]) >= 'a' {
			hi = i64(hex[i]) - 'a' + 10
		}
		mut lo = i64(hex[i + 1]) - '0'
		if i64(hex[i + 1]) >= 'a' {
			lo = i64(hex[i + 1]) - 'a' + 10
		}
		v = append(v, hi * 16 + lo)
		i = i + 2
	}
	return cast(i64, v)
}

// REP bulk memory loops preserve all callee-saved registers and r15.
fn x_memory_bytes(fill i64) i64 {
	mut hex = "4889d148c1e106f3a4c3"
	if fill != 0 {
		hex = "4889f04889d148c1e106f3aac3"
	}
	let v = []i64{}
	mut i = 0
	for i < len(hex) {
		v = append(v, num_digit(i64(hex[i])) * 16 + num_digit(i64(hex[i + 1])))
		i = i + 2
	}
	return cast(i64, v)
}

fn x_syscall_bytes(restorer i64) i64 {
	mut hex = "4889f84889f74889d64889ca4d89c24d89c84c8b4c24080f05c3"
	if restorer != 0 {
		hex = "48c7c00f0000000f05"
	}
	let v = []i64{}
	mut i = 0
	for i < len(hex) {
		v = append(v, num_digit(i64(hex[i])) * 16 + num_digit(i64(hex[i + 1])))
		i = i + 2
	}
	return cast(i64, v)
}

// x_gen_poll is the r15 context load and cold, normally untaken branch.
fn x_gen_poll() {
	if fn_polls(cast(Fn, cur_gen_fn)) == 0 {
		return
	}
	let slow = new_label()
	let resume = new_label()
	x_ld(XSCR, x_mem1(R15, 96), 3)
	emit2(X_TEST, XSCR, XSCR)
	emit2(X_JCC, XC_NE, slow)
	x_label(resume)
	poll_sites = append(poll_sites, slow)
	poll_sites = append(poll_sites, resume)
}

// x_gen_poll_stubs realigns even frameless leaves and preserves their register homes.
fn x_gen_poll_stubs() {
	let f = find_fn("rt_bnd_poll")
	mut i = 0
	for i < len(poll_sites) {
		x_label(poll_sites[i])
		mut r = 0
		for r < 16 {
			if x_caller_saved(r) != 0 && r != RSP {
				emit1(X_PUSH, r)
			}
			r = r + 1
		}
		x_mov(XSCR, RSP)
		emit2(X_ANDI, RSP, -16)
		emit2(X_SUBI, RSP, 144)
		x_st(XSCR, x_mem1(RSP, 128), 3)
		r = 0
		for r < 16 {
			emit2(X_MOVSD_ST, FPR + r, x_mem1(RSP, 8 * r))
			r = r + 1
		}
		emit1(X_CALL, x_sym(SK_FN, f.index))
		r = 0
		for r < 16 {
			emit2(X_MOVSD_LD, FPR + r, x_mem1(RSP, 8 * r))
			r = r + 1
		}
		x_ld(RSP, x_mem1(RSP, 128), 3)
		r = 15
		for r >= 0 {
			if x_caller_saved(r) != 0 && r != RSP {
				emit1(X_POP, r)
			}
			r = r - 1
		}
		emit1(X_JMP, poll_sites[i + 1])
		i = i + 2
	}
}

fn x_gen_fn(f Fn) {
	if tgt_linux != 0 {
		let bytes = cast([]i64, syscall_fast_amd64(f.qname))
		if cast(i64, bytes) != 0 {
			x_out4(X_LABEL, x_fn_labels[f.index], 0, 0, 0)
			if f.qname == "rt_sys_clock_gettime" {
				let s = lookup_global("rtVdsoClock")
				x_out4(X_LOAD, RDX, x64_mem_sym(x_sym(SK_VAR, s.index)), 3, 0)
			}
			mut i = 0
			for i < len(bytes) {
				x_out4(X_RAWB, bytes[i], 0, 0, 0)
				i = i + 1
			}
			return
		}
	}
	if f.qname == "memcpy" || f.qname == "memmove" || f.qname == "memset" || f.qname == "memcmp" || f.qname == "memchr" || f.qname == "mem_avx2_supported" {
		x_out4(X_LABEL, x_fn_labels[f.index], 0, 0, 0)
		let bs = cast([]i64, memory_fast_amd64(f.qname))
		mut i = 0
		for i < len(bs) {
			x_out4(X_RAWB, bs[i], 0, 0, 0)
			i = i + 1
		}
		return
	}

	if tgt_linux != 0 && (f.qname == "linux_raw" || f.qname == "linux_restorer") {
		x_out4(X_LABEL, x_fn_labels[f.index], 0, 0, 0)
		let bs = cast([]i64, x_syscall_bytes(i64(f.qname == "linux_restorer")))
		mut i = 0
		for i < len(bs) {
			x_out4(X_RAWB, bs[i], 0, 0, 0)
			i = i + 1
		}
		return
	}
	if f.qname == "mem_copy64" || f.qname == "mem_fill64" {
		x_out4(X_LABEL, x_fn_labels[f.index], 0, 0, 0)
		let bs = cast([]i64, x_memory_bytes(i64(f.qname == "mem_fill64")))
		mut i = 0
		for i < len(bs) {
			x_out4(X_RAWB, bs[i], 0, 0, 0)
			i = i + 1
		}
		return
	}
	if aes_hw_amd64(f.qname) != 0 {
		x_out4(X_LABEL, x_fn_labels[f.index], 0, 0, 0)
		let bs = cast([]i64, aes_hw_amd64(f.qname))
		mut i = 0
		for i < len(bs) {
			x_out4(X_RAWB, bs[i], 0, 0, 0)
			i = i + 1
		}
		return
	}
	if f.qname == "rt_task_swap" {
		x_out4(X_LABEL, x_fn_labels[f.index], 0, 0, 0)
		let bs = cast([]i64, x_task_swap_bytes())
		mut i = 0
		for i < len(bs) {
			x_out4(X_RAWB, bs[i], 0, 0, 0)
			i = i + 1
		}
		return
	}
	cur_gen_fn = cast(i64, f)
	trap_label = 0
	x_div_label = 0
	trap_sites = []i64{}
	x_ovf_labels = make([]i64, OVK_COUNT)
	poll_sites = []i64{}
	if host_getenv("TINC_TRACE") != 0 {
		let tb = buf_new()
		buf_str(tb, "gen ")
		buf_str(tb, f.qname)
		buf_byte(tb, '\n')
		write_all(2, cast([]u8, cast([]i64, tb)))
	}
	inline_appends(f)
	ovf_elide_fn(f)
	licm_fn(f)
	analyze_fn(f)
	used_regs = 0
	used_fregs = 0
	slice_truncate(g_loops, 0)
	slice_truncate(g_loop_labels, 0)
	let nslots = x_assign_homes(f)
	cg = []i64{}
	x_entry_moves(f)
	if cast(i64, cast(Fn, f)) == cast(i64, entry_fn()) {
		mut di = 0
		for di < len(prog_fns) {
			let df = prog_fns[di]
			if df.extern_ == 0 && df.reach != 0 {
				emit2(X_LEA, RAX, x64_mem_sym(x_sym(SK_FN, di)))
				emit2(X_LEA, RDX, x64_mem_sym(x_sym(SK_FNDESC, di)))
				x_st(RAX, x_mem1(RDX, 0), 3)
			}
			di = di + 1
		}
		x_gen_dyn_table_init()
	}
	x_gen_poll()
	let stmts = cast(Block, f.body).stmts
	mut i = 0
	for i < len(stmts) {
		x_gen_stmt(stmts[i])
		i = i + 1
	}
	x_load_imm(RAX, 0)
	emit1(XP_RET, 0)
	if trap_label != 0 {
		// The cold path every failed bounds check jumps to.
		x_label(trap_label)
		let bf = find_fn("rt_bounds_fail")
		if cast(i64, bf) != 0 {
			emit1(X_CALL, x_sym(SK_FN, bf.index))
			bf.used = 1
		}
	}
	if x_div_label != 0 {
		// The cold path every zero divisor in strict code jumps to (realigned like the stubs below).
		x_label(x_div_label)
		emit2(X_ANDI, RSP, -16)
		let df = find_fn("rt_div_fail")
		if cast(i64, df) != 0 {
			emit1(X_CALL, x_sym(SK_FN, df.index))
			df.used = 1
		}
	}
	x_gen_ovf_stubs()
	// Per-site stubs: the index and length go through the stack into rdi/rsi (any registers),
	// and the stack is realigned since a frameless leaf may jump here.
	mut ts = 0
	let bf2 = find_fn("rt_bounds_fail2")
	for ts < len(trap_sites) {
		let site = cast([]i64, trap_sites[ts])
		x_label(site[0])
		mut ireg = site[1]
		if ireg < 0 {
			x_load_imm(XSCR, site[3])
			ireg = XSCR
		}
		emit2(X_SUBI, RSP, 16)
		x_st(ireg, x_mem1(RSP, 0), 3)
		x_st(site[2], x_mem1(RSP, 8), 3)
		x_ld(RDI, x_mem1(RSP, 0), 3)
		x_ld(RSI, x_mem1(RSP, 8), 3)
		emit2(X_ANDI, RSP, -16)
		if cast(i64, bf2) != 0 {
			emit1(X_CALL, x_sym(SK_FN, bf2.index))
			bf2.used = 1
		}
		ts = ts + 1
	}
	x_gen_poll_stubs()
	x_finish_fn(f, nslots)
}

fn x_gen_dyn_table_init() {
	mut i = 0
	for i < len(dyn_tables) {
		let rec = cast([]i64, dyn_tables[i])
		let base = rec[4]
		let fns = []Fn{}
		fns = append(fns, cast(Fn, rec[2]))
		let methods = cast([]i64, rec[3])
		mut j = 0
		for j < len(methods) {
			fns = append(fns, cast(Fn, methods[j]))
			j = j + 1
		}
		j = 0
		for j < len(fns) {
			let f = fns[j]
			if cast(i64, f) != 0 {
				emit2(X_LEA, RAX, x64_mem_sym(x_sym(SK_FNDESC, f.index)))
				x_st(RAX, x64_mem_sym(x_sym(SK_VAR, base + j)), 3)
			}
			j = j + 1
		}
		i = i + 1
	}
}

fn x_out4(op i64, a i64, b i64, c i64, d i64) {
	code = append(code, cast(Fn, op))
	code = append(code, cast(Fn, a))
	code = append(code, cast(Fn, b))
	code = append(code, cast(Fn, c))
	code = append(code, cast(Fn, d))
}

// x_branch_to_next reports whether the jump at instruction i only skips labels to reach its target.
fn x_branch_to_next(i i64, n i64) i64 {
	let target = cg[5 * i + 1]
	mut j = i + 1
	for j < n && cg[5 * j] == X_LABEL {
		if cg[5 * j + 1] == target {
			return 1
		}
		j = j + 1
	}
	return 0
}

// x_label_follows reports whether only labels separate instruction i from label l.
fn x_label_follows(i i64, n i64, l i64) i64 {
	mut j = i
	for j < n && cg[5 * j] == X_LABEL {
		if cg[5 * j + 1] == l {
			return 1
		}
		j = j + 1
	}
	return 0
}

// x_finish_fn wraps the body in its prologue and epilogues and drops unreachable code.
fn x_finish_fn(f Fn, nslots i64) {
	let saved = []i64{}
	mut r = 0
	for r < 16 {
		if ((used_regs >> r) & 1) != 0 && x_caller_saved(r) == 0 {
			saved = append(saved, r)
		}
		r = r + 1
	}
	let frame = align_up(8 * (nslots + len(saved)), 16)
	let frameless = i64(f.leaf != 0 && nslots == 0 && len(saved) == 0 && x_nstack == 0)
	x_out4(X_LABEL, x_fn_labels[f.index], 0, 0, 0)
	if frameless == 0 {
		x_out4(X_PUSH, RBP, 0, 0, 0)
		x_out4(X_MOV_RR, RBP, RSP, 0, 0)
		if frame > 0 {
			x_out4(X_SUBI, RSP, frame, 0, 0)
		}
		mut j = 0
		for j < len(saved) {
			x_out4(X_STORE, saved[j], x_mem1(RBP, -8 * (nslots + j + 1)), 3, 0)
			j = j + 1
		}
	}
	let n = len(cg) / 5
	mut dead = 0
	mut i = 0
	for i < n {
		let op = cg[5 * i]
		if op == X_LABEL {
			dead = 0
		}
		if dead != 0 || (op == X_JMP && x_branch_to_next(i, n) != 0) {
			i = i + 1
			continue
		}
		// jcc L1; jmp L2; L1:  becomes  j!cc L2; L1:
		if op == X_JCC && i + 1 < n && cg[5 * (i + 1)] == X_JMP && x_label_follows(i + 2, n, cg[5 * i + 2]) != 0 {
			x_out4(X_JCC, cg[5 * i + 1] ^ 1, cg[5 * (i + 1) + 1], 0, 0)
			i = i + 2
			continue
		}
		if op == XP_RET {
			if frameless == 0 {
				mut j = 0
				for j < len(saved) {
					x_out4(X_LOAD, saved[j], x_mem1(RBP, -8 * (nslots + j + 1)), 3, 0)
					j = j + 1
				}
				x_out4(X_MOV_RR, RSP, RBP, 0, 0)
				x_out4(X_POP, RBP, 0, 0, 0)
			}
			x_out4(X_RET, 0, 0, 0, 0)
			dead = 1
		} else {
			let k = 5 * i
			x_out4(op, cg[k + 1], cg[k + 2], cg[k + 3], cg[k + 4])
			if op == X_JMP {
				dead = 1
			}
		}
		i = i + 1
	}
}

fn generate_x64() {
	code = cast([]Fn, []i64{})
	g_labels = 0
	g_str_ptrs = []str{}
	g_str_lens = []i64{}
	g_tstr_ptrs = []str{}
	g_tstr_lens = []i64{}
	g_loops = []i64{}
	g_loop_labels = []str{}
	x_syms = []i64{}
	x_fn_labels = []i64{}
	mut i = 0
	for i < len(prog_fns) {
		prog_fns[i].index = i
		x_fn_labels = append(x_fn_labels, new_label())
		i = i + 1
	}
	inline_small_calls()
	i = 0
	for i < len(prog_fns) {
		let f = prog_fns[i]
		if f.extern_ == 0 && f.reach != 0 {
			x_gen_fn(f)
		}
		i = i + 1
	}
}

// print_asm_x64 renders the program as Intel-syntax assembly with symbolic labels (tinc -S).
fn print_asm_x64() i64 {
	let b = buf_new()
	mut i = 0
	for i < len(prog_fns) {
		let f = prog_fns[i]
		if f.extern_ == 0 && f.reach != 0 {
			buf_str(b, "# L")
			buf_int(b, x_fn_labels[i])
			buf_str(b, ": ")
			buf_str(b, f.qname)
			buf_byte(b, '\n')
		}
		i = i + 1
	}
	i = 0
	for i < len(code) {
		x64_print(b, slice_data(code) + 8 * i, -1)
		i = i + 5
	}
	return cast(i64, b)
}
