// Tin values are one 64-bit word except for dyn, which is an object/table pair. The
// static type decides which instructions and runtime calls the compiler uses on them.
// Reference types (string, struct, slice, map, func, error, chan) are pointers, and 0 is
// their nil.
const TY_KIND = 0
const TY_ELEM = 1 // slice/chan element, map value
const TY_KEY = 2 // map key
const TY_FIELDS = 3 // struct: vec of [name, type]; func: param types
const TY_RESULTS = 4 // func: result types
const TY_NAME = 5 // display name
const TY_VARIADIC = 6
const TY_WIDTH = 7 // integers: size in bytes (1, 2, 4, 8)
const TY_SIGNED = 8 // integers: 1 when signed
const TY_SIZE = 9 // structs: object size in bytes
const TY_TARGS = 10 // generic instance: its type arguments
const TY_GDECL = 11 // generic instance: its declaration
const TY_ENUM = 12 // enum (a struct underneath): vec of [variant name, first field, field count]
const TY_SECRET = 13 // secret T: the plain T this twin qualifies (selfhost/secret.tin)
const TY_BOUND = 14 // bounded type (#240): the unbounded type it refines
const TY_MAX = 15 // bounded type: the largest length a value may have

const K_INT = 1
const K_BOOL = 2
const K_BYTE = 3
const K_FLOAT = 4
const K_STRING = 5
const K_STRUCT = 6
const K_SLICE = 7
const K_MAP = 8
const K_FUNC = 9
const K_VOID = 10
const K_TUPLE = 11
const K_NIL = 12
const K_UINT = 13 // untyped integer constant
const K_UFLOAT = 14 // untyped float constant
const K_ERROR = 15
const K_CHAN = 16
const K_UBOOL = 17 // untyped boolean (comparison results, true/false)
const K_OPT = 18 // ?T: a struct reference that may be nil
const K_DYN = 19 // dyn S: a two-word value (object, method table)

shared mut ty_int i64
shared mut ty_bool i64
shared mut ty_byte i64
shared mut ty_float i64
shared mut ty_f32 i64
shared mut ty_string i64
shared mut ty_void i64
shared mut ty_nil i64
shared mut ty_uint i64
shared mut ty_ufloat i64
shared mut ty_ubool i64
shared mut ty_error i64
shared mut ty_i8 i64
shared mut ty_i16 i64
shared mut ty_i32 i64
shared mut ty_u16 i64
shared mut ty_u32 i64
shared mut ty_u64 i64
shared mut ty_interned i64 // slice, map, chan and func types, shared by structure
shared mut ty_named i64 // [qualified name, type]
shared mut saw_dyn i64 // a dyn type was built: the back ends refuse it until step 3
shared mut saw_dyn_pos i64 // where the first dyn type was written, for the back ends' message
shared mut ty_secrets i64 // secret twins, one per plain type (secret_of)

fn ty_new(kind i64, name i64) i64 {
	let t = calloc(TY_MAX + 1, 8)
	t[TY_KIND] = kind
	t[TY_NAME] = name
	t[TY_WIDTH] = 8
	return t
}

fn int_type(name i64, width i64, signed i64) i64 {
	let t = ty_new(K_INT, name)
	t[TY_WIDTH] = width
	t[TY_SIGNED] = signed
	name_type(name, t)
	return t
}

fn types_init() {
	ty_named = vec_new()
	ty_interned = vec_new()
	ty_int = int_type(cstr("i64"), 8, 1)
	ty_i8 = int_type(cstr("i8"), 1, 1)
	ty_i16 = int_type(cstr("i16"), 2, 1)
	ty_i32 = int_type(cstr("i32"), 4, 1)
	ty_byte = int_type(cstr("u8"), 1, 0)
	ty_u16 = int_type(cstr("u16"), 2, 0)
	ty_u32 = int_type(cstr("u32"), 4, 0)
	ty_u64 = int_type(cstr("u64"), 8, 0)
	ty_bool = ty_new(K_BOOL, cstr("bool"))
	ty_bool[TY_WIDTH] = 1
	ty_float = ty_new(K_FLOAT, cstr("f64"))
	ty_f32 = ty_new(K_FLOAT, cstr("f32"))
	ty_f32[TY_WIDTH] = 4
	ty_string = ty_new(K_STRING, cstr("str"))
	ty_void = ty_new(K_VOID, cstr("void"))
	ty_nil = ty_new(K_NIL, cstr("nil"))
	ty_uint = ty_new(K_UINT, cstr("untyped int"))
	ty_ufloat = ty_new(K_UFLOAT, cstr("untyped float"))
	ty_ubool = ty_new(K_UBOOL, cstr("untyped bool"))
	ty_error = ty_new(K_ERROR, cstr("fault"))
	name_type(cstr("bool"), ty_bool)
	name_type(cstr("f64"), ty_float)
	name_type(cstr("f32"), ty_f32)
	name_type(cstr("str"), ty_string)
	name_type(cstr("fault"), ty_error)
}

fn name_type(name i64, t i64) {
	let rec = vec_new()
	vec_push(rec, name)
	vec_push(rec, t)
	vec_push(ty_named, rec)
}

fn find_type(name i64) i64 {
	mut i = ty_named[VEC_LEN] - 1
	for i >= 0 {
		let rec = vec_get(ty_named, i)
		if streq(vec_get(rec, 0), name) != 0 {
			return vec_get(rec, 1)
		}
		i = i - 1
	}
	return 0
}

fn types_equal_vec(a i64, b i64) i64 {
	if a[VEC_LEN] != b[VEC_LEN] {
		return 0
	}
	mut i = 0
	for i < a[VEC_LEN] {
		if vec_get(a, i) != vec_get(b, i) {
			return 0
		}
		i = i + 1
	}
	return 1
}

// interned returns the shared type with this structure, creating it on first use.
fn interned(kind i64, elem i64, key i64, params i64, results i64, variadic i64) i64 {
	mut i = 0
	for i < ty_interned[VEC_LEN] {
		let t = vec_get(ty_interned, i)
		if t[TY_KIND] == kind && t[TY_ELEM] == elem && t[TY_KEY] == key && t[TY_VARIADIC] == variadic {
			if kind != K_FUNC || (types_equal_vec(t[TY_FIELDS], params) != 0 && types_equal_vec(t[TY_RESULTS], results) != 0) {
				return t
			}
		}
		i = i + 1
	}
	let n = ty_new(kind, 0)
	n[TY_ELEM] = elem
	n[TY_KEY] = key
	n[TY_FIELDS] = params
	n[TY_RESULTS] = results
	n[TY_VARIADIC] = variadic
	vec_push(ty_interned, n)
	return n
}

fn slice_of(elem i64) i64 {
	return interned(K_SLICE, elem, 0, 0, 0, 0)
}

fn map_of(key i64, val i64) i64 {
	return interned(K_MAP, val, key, 0, 0, 0)
}

fn chan_of(elem i64) i64 {
	return interned(K_CHAN, elem, 0, 0, 0, 0)
}

fn opt_of(elem i64) i64 {
	return interned(K_OPT, elem, 0, 0, 0, 0)
}

// dyn_of is the type of a dyn S value: the shape declaration in TY_GDECL and the
// instance's bindings in TY_TARGS (0 for a non-generic shape). It is two words, and
// saw_dyn makes the back ends refuse the program until size-16 values are generated
// (notes/design_dyn.md, staging step 2).
fn dyn_of(sd i64, bind_ i64) i64 {
	mut i = 0
	for i < ty_interned[VEC_LEN] {
		let t = vec_get(ty_interned, i)
		if t[TY_KIND] == K_DYN && t[TY_GDECL] == sd && shape_bind_same(t[TY_TARGS], bind_) != 0 {
			return t
		}
		i = i + 1
	}
	let n = ty_new(K_DYN, 0)
	n[TY_GDECL] = sd
	n[TY_TARGS] = bind_
	vec_push(ty_interned, n)
	saw_dyn = 1
	return n
}

fn func_of(params i64, results i64, variadic i64) i64 {
	return interned(K_FUNC, 0, 0, params, results, variadic)
}

// func_of_m is func_of for a function whose parameters in mask (bit i: parameter i) are mut.
fn func_of_m(params i64, results i64, variadic i64, mask i64) i64 {
	return interned(K_FUNC, 0, mask, params, results, variadic)
}

// mut_mask turns a function's F_MUTS flags into a func type's mut mask.
fn mut_mask(muts i64) i64 {
	mut m = 0
	mut i = 0
	for muts != 0 && i < muts[VEC_LEN] && i < 63 {
		if vec_get(muts, i) != 0 {
			m = m | (1 << i)
		}
		i = i + 1
	}
	return m
}

fn tuple_of(types i64) i64 {
	let t = ty_new(K_TUPLE, 0)
	t[TY_FIELDS] = types
	return t
}

fn kind_of(t i64) i64 {
	if t == 0 {
		return K_INT
	}
	return t[TY_KIND]
}

// dyn values, including optionals, occupy an object word and a table word.
fn is_dyn_value(t i64) i64 {
	let k = kind_of(t)
	return i64(k == K_DYN || (k == K_OPT && kind_of(t[TY_ELEM]) == K_DYN))
}

fn dyn_type(t i64) i64 {
	if kind_of(t) == K_OPT {
		return t[TY_ELEM]
	}
	return t
}

fn is_float_t(t i64) i64 {
	let k = kind_of(t)
	return i64(k == K_FLOAT || k == K_UFLOAT)
}

// is_f32 reports whether t is f32 (kept in registers as an f64 holding an f32 value).
fn is_f32(t i64) i64 {
	return i64(t != 0 && t[TY_KIND] == K_FLOAT && t[TY_WIDTH] == 4)
}

// round_f32_bits rounds the f64 with bits b to the nearest f32 (ties to even) and returns
// that value's f64 bits: how an f32 constant is folded without float arithmetic.
fn round_f32_bits(b i64) i64 {
	let sign = b & (1 << 63)
	let e = (b >> 52) & 0x7ff
	let m = b & 0xfffffffffffff
	if e == 0x7ff {
		return b
	}
	if e == 0 {
		return sign
	}
	mut ue = e - 1023
	let full = m | (1 << 52)
	if ue > 127 {
		return sign | (0x7ff << 52)
	}
	if ue >= -126 {
		mut r = round_shift(full, 29)
		if r == (1 << 24) {
			r = 1 << 23
			ue = ue + 1
			if ue > 127 {
				return sign | (0x7ff << 52)
			}
		}
		return sign | ((ue + 1023) << 52) | ((r - (1 << 23)) << 29)
	}
	let s = -97 - ue
	if s > 54 {
		return sign
	}
	let k = round_shift(full, s)
	if k == 0 {
		return sign
	}
	mut p = 0
	for (k >> (p + 1)) != 0 {
		p = p + 1
	}
	return sign | ((p - 149 + 1023) << 52) | ((k << (52 - p)) & 0xfffffffffffff)
}

// round_shift is x >> s rounded to nearest, ties to even (x below 2^55).
fn round_shift(x i64, s i64) i64 {
	mut q = x >> s
	let rem = x & ((1 << s) - 1)
	let half = 1 << (s - 1)
	if rem > half || (rem == half && (q & 1) != 0) {
		q = q + 1
	}
	return q
}

fn is_integer_t(t i64) i64 {
	let k = kind_of(t)
	return i64(k == K_INT || k == K_UINT)
}

fn is_unsigned_t(t i64) i64 {
	return i64(t != 0 && t[TY_KIND] == K_INT && t[TY_SIGNED] == 0)
}

// type_width is a value's size in memory: struct fields and slice elements use it.
fn type_width(t i64) i64 {
	if t == 0 {
		return 8
	}
	let k = t[TY_KIND]
	if k == K_INT || k == K_BOOL || k == K_FLOAT {
		return t[TY_WIDTH]
	}
	if is_dyn_value(t) != 0 {
		return 16
	}
	return 8
}

fn width_log2(w i64) i64 {
	if w == 1 {
		return 0
	}
	if w == 2 {
		return 1
	}
	if w == 4 {
		return 2
	}
	if w == 16 {
		return 4
	}
	return 3
}

fn is_numeric_t(t i64) i64 {
	return i64(is_integer_t(t) != 0 || is_float_t(t) != 0)
}

fn is_bool_t(t i64) i64 {
	let k = kind_of(t)
	return i64(k == K_BOOL || k == K_UBOOL)
}

fn is_untyped(t i64) i64 {
	let k = kind_of(t)
	return i64(k == K_UINT || k == K_UFLOAT || k == K_UBOOL || k == K_NIL)
}

// nilable types may hold nil: optionals, faults and channels. References are never nil.
fn nilable(t i64) i64 {
	let k = kind_of(t)
	return i64(k == K_OPT || k == K_ERROR || k == K_NIL || k == K_FUNC)
}

// is_ref reports whether values of t are pointers to heap or static memory.
fn is_ref(t i64) i64 {
	let k = kind_of(t)
	return i64(k == K_STRING || k == K_STRUCT || k == K_SLICE || k == K_MAP || k == K_FUNC || k == K_ERROR || k == K_CHAN || k == K_OPT)
}

// default_type is the type an untyped constant gets when nothing else decides it.
fn default_type(t i64) i64 {
	let k = kind_of(t)
	if k == K_UINT {
		return ty_int
	}
	if k == K_UFLOAT {
		return ty_float
	}
	if k == K_UBOOL {
		return ty_bool
	}
	return t
}

// assignable reports whether a value of type from can be stored where to is expected.
fn assignable(from i64, to i64) i64 {
	if from == to || to == 0 {
		return 1
	}
	// A plain value may become secret (secret_of); a secret never becomes plain without reveal.
	if to[TY_SECRET] != 0 {
		if from != 0 && from[TY_SECRET] != 0 {
			return assignable(from[TY_SECRET], to[TY_SECRET])
		}
		return assignable(from, to[TY_SECRET])
	}
	if to[TY_KIND] == K_OPT && is_secret(to[TY_ELEM]) != 0 && from != 0 && from[TY_SECRET] == 0 && kind_of(from) != K_OPT && kind_of(from) != K_NIL {
		return assignable(from, to[TY_ELEM])
	}
	if to[TY_BOUND] != 0 || (from != 0 && from[TY_BOUND] != 0) {
		return bounded_assignable(from, to)
	}
	let fk = kind_of(from)
	let tk = kind_of(to)
	if fk == K_UINT {
		return i64(tk == K_INT || tk == K_FLOAT)
	}
	if tk == K_OPT && from == to[TY_ELEM] {
		return 1
	}
	if fk == K_UFLOAT {
		return i64(tk == K_FLOAT)
	}
	if fk == K_UBOOL {
		return i64(tk == K_BOOL)
	}
	if fk == K_NIL {
		return nilable(to)
	}
	return 0
}

fn type_name(b i64, t i64) {
	if t == 0 {
		buf_str(b, cstr("int"))
		return
	}
	if t[TY_SECRET] != 0 {
		buf_str(b, cstr("secret "))
		type_name(b, t[TY_SECRET])
		return
	}
	let k = t[TY_KIND]
	if k == K_DYN {
		buf_str(b, cstr("dyn "))
		let sd = t[TY_GDECL]
		if sd != 0 {
			buf_str(b, sd[D_NAME])
		}
		let bind_ = t[TY_TARGS]
		if bind_ != 0 {
			buf_byte(b, '[')
			mut i = 0
			for i < bind_[VEC_LEN] {
				if i > 0 {
					buf_byte(b, ',')
				}
				type_name(b, vec_get(vec_get(bind_, i), 1))
				i = i + 1
			}
			buf_byte(b, ']')
		}
		return
	}
	if t[TY_NAME] != 0 {
		buf_str(b, t[TY_NAME])
	} else if k == K_SLICE {
		buf_str(b, cstr("[]"))
		type_name(b, t[TY_ELEM])
	} else if k == K_CHAN {
		buf_str(b, cstr("chan "))
		type_name(b, t[TY_ELEM])
	} else if k == K_OPT {
		buf_byte(b, '?')
		type_name(b, t[TY_ELEM])
	} else if k == K_MAP {
		buf_str(b, cstr("map["))
		type_name(b, t[TY_KEY])
		buf_byte(b, ']')
		type_name(b, t[TY_ELEM])
	} else if k == K_FUNC || k == K_TUPLE {
		if k == K_FUNC {
			buf_str(b, cstr("func"))
		}
		buf_byte(b, '(')
		let ps = t[TY_FIELDS]
		mut i = 0
		for i < ps[VEC_LEN] {
			if i > 0 {
				buf_str(b, cstr(", "))
			}
			if k == K_FUNC && i < 63 && (t[TY_KEY] & (1 << i)) != 0 {
				buf_str(b, cstr("mut "))
			}
			type_name(b, vec_get(ps, i))
			i = i + 1
		}
		buf_byte(b, ')')
		if k == K_FUNC && t[TY_RESULTS][VEC_LEN] == 1 {
			buf_byte(b, ' ')
			type_name(b, vec_get(t[TY_RESULTS], 0))
		} else if k == K_FUNC && t[TY_RESULTS][VEC_LEN] > 1 {
			buf_byte(b, ' ')
			type_name(b, tuple_of(t[TY_RESULTS]))
		}
	} else {
		buf_str(b, cstr("?"))
	}
}

// struct_field returns the index of field name in struct type t, or -1.
fn struct_field(t i64, name i64) i64 {
	let fs = t[TY_FIELDS]
	mut i = 0
	for i < fs[VEC_LEN] {
		if streq(vec_get(vec_get(fs, i), 0), name) != 0 {
			return i
		}
		i = i + 1
	}
	return -1
}

fn field_type(t i64, i i64) i64 {
	return vec_get(vec_get(t[TY_FIELDS], i), 1)
}

fn field_offset(t i64, i i64) i64 {
	return vec_get(vec_get(t[TY_FIELDS], i), 2)
}

// layout_struct assigns field offsets: widest fields first, each naturally aligned, so
// structs pack without padding holes; the object size rounds up to 8.
fn layout_struct(t i64) {
	let fs = t[TY_FIELDS]
	mut off = 0
	mut w = 16
	for w >= 1 {
		mut i = 0
		for i < fs[VEC_LEN] {
			let f = vec_get(fs, i)
			if type_width(vec_get(f, 1)) == w {
				for f[VEC_LEN] < 3 {
					vec_push(f, 0)
				}
				f[VEC_DATA][2] = off
				off = off + w
			}
			i = i + 1
		}
		w = w / 2
	}
	t[TY_SIZE] = align_up(off + i64((off == 0)), 8)
}

// elem_size is the size in bytes of one slice element.
fn elem_size(t i64) i64 {
	return type_width(t[TY_ELEM])
}

// int_to_float_bits converts an integer constant to IEEE-754 bits, rounding to nearest even.
fn int_to_float_bits(v i64) i64 {
	if v == 0 {
		return 0
	}
	mut sign = 0
	mut m = v
	if v < 0 {
		sign = 1
		m = -v
	}
	// m is now the magnitude, read as unsigned (the most negative int stays 2^63).
	mut top = 63
	for ((m >> top) & 1) == 0 {
		top = top - 1
	}
	mut mant = 0
	if top <= 52 {
		mant = m << (52 - top)
	} else {
		let shift = top - 52
		mant = (m >> shift) & ((1 << (64 - shift)) - 1)
		if shift == 63 {
			mant = 1
		}
		let rest = m & ((1 << shift) - 1)
		let half = 1 << (shift - 1)
		if rest > half || (rest == half && (mant & 1) != 0) {
			mant = mant + 1
			if mant == (1 << 53) {
				mant = mant >> 1
				top = top + 1
			}
		}
	}
	return (sign << 63) | ((top + 1023) << 52) | (mant & ((1 << 52) - 1))
}

// ---- bounded types (#240): str max 100, []Item max 1000, map[str]T max 50 ----
//
// A bounded type is a twin of its unbounded type (same kind and layout) that also records
// a largest length. It is assignable to its unbounded type; the reverse needs bound(x).
shared mut ty_bounds i64 // [unbounded type, max, bounded type]

// bounded_of is t refined to values of length at most max.
fn bounded_of(t_in i64, max_ i64) i64 {
	mut t = t_in
	if t[TY_BOUND] != 0 {
		t = t[TY_BOUND]
	}
	if ty_bounds == 0 {
		ty_bounds = vec_new()
	}
	mut i = 0
	for i < ty_bounds[VEC_LEN] {
		let r = vec_get(ty_bounds, i)
		if vec_get(r, 0) == t && vec_get(r, 1) == max_ {
			return vec_get(r, 2)
		}
		i = i + 1
	}
	let b = ty_new(t[TY_KIND], 0)
	mut w = 0
	for w < TY_SECRET {
		b[w] = t[w]
		w = w + 1
	}
	b[TY_BOUND] = t
	b[TY_MAX] = max_
	let nb = buf_new()
	type_name(nb, t)
	buf_str(nb, cstr(" max "))
	buf_int(nb, max_)
	buf_byte(nb, 0)
	b[TY_NAME] = nb[VEC_DATA]
	let r = vec_new()
	vec_push(r, t)
	vec_push(r, max_)
	vec_push(r, b)
	vec_push(ty_bounds, r)
	return b
}

// unbounded is t without its bound.
fn unbounded(t i64) i64 {
	if t != 0 && t[TY_BOUND] != 0 {
		return t[TY_BOUND]
	}
	return t
}

// bounded_assignable: a bounded value goes where its unbounded type (or a looser bound of
// it) is expected; nothing else becomes bounded without bound(x).
fn bounded_assignable(from i64, to i64) i64 {
	if to[TY_BOUND] == 0 {
		return assignable(from[TY_BOUND], to)
	}
	if from != 0 && from[TY_BOUND] != 0 && from[TY_MAX] <= to[TY_MAX] {
		return assignable(from[TY_BOUND], to[TY_BOUND])
	}
	return 0
}
