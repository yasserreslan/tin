// Tin values are one 64-bit word except for dyn, which is an object/table pair. The
// static type decides which instructions and runtime calls the compiler uses on them.
// Reference types (string, struct, slice, map, func, error, chan) are pointers, and 0 is
// their nil.

const K_INT = 1
const K_BOOL = 2
const K_BYTE = 3
const K_FLOAT = 4
const K_STRING = 5
const K_STRUCT = 6
const K_SLICE = 7
const K_MAP = 8
const K_FUNC = 9
const K_VOID = 10
const K_TUPLE = 11
const K_NIL = 12
const K_UINT = 13 // untyped integer constant
const K_UFLOAT = 14 // untyped float constant
const K_ERROR = 15
const K_CHAN = 16
const K_UBOOL = 17 // untyped boolean (comparison results, true/false)
const K_OPT = 18 // ?T: a struct reference that may be nil
const K_DYN = 19 // dyn S: a two-word value (object, method table)

shared mut ty_int i64
shared mut ty_bool i64
shared mut ty_byte i64
shared mut ty_float i64
shared mut ty_f32 i64
shared mut ty_string i64
shared mut ty_void i64
shared mut ty_nil i64
shared mut ty_uint i64
shared mut ty_ufloat i64
shared mut ty_ubool i64
shared mut ty_error i64
shared mut ty_i8 i64
shared mut ty_i16 i64
shared mut ty_i32 i64
shared mut ty_u16 i64
shared mut ty_u32 i64
shared mut ty_u64 i64
shared mut ty_interned []Ty // slice, map, chan and func types, shared by structure
shared mut ty_named []i64 // [qualified name, type]
shared mut saw_dyn i64 // a dyn type was built: the back ends refuse it until step 3
shared mut saw_dyn_pos i64 // where the first dyn type was written, for the back ends' message
shared mut ty_secrets []i64 // secret twins, one per plain type (secret_of)

fn ty_new(kind i64, name str) i64 {
	let t = cast(Ty, calloc(TY_WORDS, 8))
	t.kind = kind
	t.name = name
	t.width = 8
	return cast(i64, t)
}

fn int_type(name str, width i64, signed i64) i64 {
	let t = cast(Ty, ty_new(K_INT, name))
	t.width = width
	t.signed = signed
	name_type(name, cast(i64, t))
	return cast(i64, t)
}

fn types_init() {
	ty_named = []i64{}
	ty_interned = cast([]Ty, []i64{})
	ty_int = int_type("i64", 8, 1)
	ty_i8 = int_type("i8", 1, 1)
	ty_i16 = int_type("i16", 2, 1)
	ty_i32 = int_type("i32", 4, 1)
	ty_byte = int_type("u8", 1, 0)
	ty_u16 = int_type("u16", 2, 0)
	ty_u32 = int_type("u32", 4, 0)
	ty_u64 = int_type("u64", 8, 0)
	ty_bool = ty_new(K_BOOL, "bool")
	cast(Ty, ty_bool).width = 1
	ty_float = ty_new(K_FLOAT, "f64")
	ty_f32 = ty_new(K_FLOAT, "f32")
	cast(Ty, ty_f32).width = 4
	ty_string = ty_new(K_STRING, "str")
	ty_void = ty_new(K_VOID, "void")
	ty_nil = ty_new(K_NIL, "nil")
	ty_uint = ty_new(K_UINT, "untyped int")
	ty_ufloat = ty_new(K_UFLOAT, "untyped float")
	ty_ubool = ty_new(K_UBOOL, "untyped bool")
	ty_error = ty_new(K_ERROR, "fault")
	name_type("bool", ty_bool)
	name_type("f64", ty_float)
	name_type("f32", ty_f32)
	name_type("str", ty_string)
	name_type("fault", ty_error)
}

fn name_type(name str, t i64) {
	ty_named = append(ty_named, name_bind(name, t))
}

fn find_type(name str) i64 {
	mut i = len(ty_named) - 1
	for i >= 0 {
		let rec = cast(NameBind, ty_named[i])
		if rec.name == name {
			return rec.val
		}
		i = i - 1
	}
	return 0
}

fn types_equal_vec(a []i64, b []i64) i64 {
	if len(a) != len(b) {
		return 0
	}
	mut i = 0
	for i < len(a) {
		if a[i] != b[i] {
			return 0
		}
		i = i + 1
	}
	return 1
}

// interned returns the shared type with this structure, creating it on first use.
fn interned(kind i64, elem i64, key i64, params []i64, results []i64, variadic i64) i64 {
	mut i = 0
	for i < len(ty_interned) {
		let t = ty_interned[i]
		if t.kind == kind && t.elem == elem && t.key == key && t.variadic == variadic {
			if kind != K_FUNC || (types_equal_vec(t.fields, params) != 0 && types_equal_vec(t.results, results) != 0) {
				return cast(i64, t)
			}
		}
		i = i + 1
	}
	let n = cast(Ty, ty_new(kind, ""))
	n.elem = elem
	n.key = key
	n.fields = cast([]i64, cast(i64, params))
	n.results = cast([]i64, cast(i64, results))
	n.variadic = variadic
	ty_interned = append(ty_interned, cast(Ty, n))
	return cast(i64, n)
}

fn slice_of(elem i64) i64 {
	return interned(K_SLICE, elem, 0, cast([]i64, 0), cast([]i64, 0), 0)
}

fn map_of(key i64, val i64) i64 {
	return interned(K_MAP, val, key, cast([]i64, 0), cast([]i64, 0), 0)
}

fn chan_of(elem i64) i64 {
	return interned(K_CHAN, elem, 0, cast([]i64, 0), cast([]i64, 0), 0)
}

fn opt_of(elem i64) i64 {
	if scalar_optionable(cast(Ty, elem)) != 0 {
		return interned(K_OPT, box_of(elem), 0, cast([]i64, 0), cast([]i64, 0), 0)
	}
	return interned(K_OPT, elem, 0, cast([]i64, 0), cast([]i64, 0), 0)
}

// ---- optional numbers and bools (#353) ----
// ?i64, ?f64, ?bool and the like are an optional of a hidden one-field struct, the box that holds
// the value: nil is no box. A number converts to the optional by making a box (check_assignable),
// and a variable narrowed by `x != nil` reads the box's field back (Sym.unbox).
shared mut box_scalars []i64
shared mut box_structs []i64

// scalar_optionable reports whether ?t is an optional number or bool.
fn scalar_optionable(t Ty) i64 {
	let k = kind_of(t)
	return i64((k == K_INT || k == K_FLOAT || k == K_BOOL) && is_secret(t) == 0 && t.bound == 0)
}

// box_of is the struct that holds a value of the number or bool type s.
fn box_of(s i64) i64 {
	if cast(i64, box_scalars) == 0 {
		box_scalars = []i64{}
		box_structs = []i64{}
	}
	mut i = 0
	for i < len(box_scalars) {
		if box_scalars[i] == s {
			return box_structs[i]
		}
		i = i + 1
	}
	let t = cast(Ty, ty_new(K_STRUCT, cast(Ty, s).name))
	mut fs = []i64{}
	let rec = cast(Field, calloc(6, 8))
	rec.name = "v"
	rec.ty = s
	rec.json = ""
	fs = append(fs, cast(i64, rec))
	t.fields = fs
	layout_struct(t)
	box_scalars = append(box_scalars, s)
	box_structs = append(box_structs, cast(i64, t))
	return cast(i64, t)
}

// box_scalar is the number or bool type that the struct t boxes, or 0.
fn box_scalar(t Ty) i64 {
	if cast(i64, box_structs) == 0 {
		return 0
	}
	mut i = 0
	for i < len(box_structs) {
		if box_structs[i] == cast(i64, t) {
			return box_scalars[i]
		}
		i = i + 1
	}
	return 0
}

// opt_scalar is s in the optional ?s of a number or bool, else 0.
fn opt_scalar(t Ty) i64 {
	if cast(i64, t) == 0 || kind_of(t) != K_OPT {
		return 0
	}
	return box_scalar(cast(Ty, t.elem))
}

// dyn_of is the type of a dyn S value: the shape declaration in gdecl and the
// instance's bindings in targs (0 for a non-generic shape). It is two words, and
// saw_dyn makes the back ends refuse the program until size-16 values are generated
// (design/design_dyn.md, staging step 2).
fn dyn_of(sd i64, bind_ []i64) i64 {
	mut i = 0
	for i < len(ty_interned) {
		let t = ty_interned[i]
		if t.kind == K_DYN && t.gdecl == sd && shape_bind_same(t.targs, bind_) != 0 {
			return cast(i64, t)
		}
		i = i + 1
	}
	let n = cast(Ty, ty_new(K_DYN, ""))
	n.gdecl = sd
	n.targs = cast([]i64, cast(i64, bind_))
	ty_interned = append(ty_interned, cast(Ty, n))
	saw_dyn = 1
	return cast(i64, n)
}

fn func_of(params []i64, results []i64, variadic i64) i64 {
	return interned(K_FUNC, 0, 0, params, results, variadic)
}

// func_of_m is func_of for a function whose parameters in mask (bit i: parameter i) are mut.
fn func_of_m(params []i64, results []i64, variadic i64, mask i64) i64 {
	return interned(K_FUNC, 0, mask, params, results, variadic)
}

// mut_mask turns a function's muts flags into a func type's mut mask.
fn mut_mask(muts []i64) i64 {
	mut m = 0
	mut i = 0
	for cast(i64, muts) != 0 && i < len(muts) && i < 63 {
		if muts[i] != 0 {
			m = m | (1 << i)
		}
		i = i + 1
	}
	return m
}

fn tuple_of(types i64) i64 {
	let t = cast(Ty, ty_new(K_TUPLE, ""))
	t.fields = cast([]i64, types)
	return cast(i64, t)
}

fn kind_of(t Ty) i64 {
	if cast(i64, t) == 0 {
		return K_INT
	}
	return t.kind
}

// dyn values, including optionals, occupy an object word and a table word.
fn is_dyn_value(t Ty) i64 {
	let k = kind_of(t)
	return i64(k == K_DYN || (k == K_OPT && kind_of(cast(Ty, t.elem)) == K_DYN))
}

fn dyn_type(t Ty) i64 {
	if kind_of(t) == K_OPT {
		return t.elem
	}
	return cast(i64, t)
}

fn is_float_t(t i64) i64 {
	let k = kind_of(cast(Ty, t))
	return i64(k == K_FLOAT || k == K_UFLOAT)
}

// is_f32 reports whether t is f32 (kept in registers as an f64 holding an f32 value).
fn is_f32(t Ty) i64 {
	return i64(cast(i64, t) != 0 && t.kind == K_FLOAT && t.width == 4)
}

// round_f32_bits rounds the f64 with bits b to the nearest f32 (ties to even) and returns
// that value's f64 bits: how an f32 constant is folded without float arithmetic.
fn round_f32_bits(b i64) i64 {
	let sign = b & (1 << 63)
	let e = (b >> 52) & 0x7ff
	let m = b & 0xfffffffffffff
	if e == 0x7ff {
		return b
	}
	if e == 0 {
		return sign
	}
	mut ue = e - 1023
	let full = m | (1 << 52)
	if ue > 127 {
		return sign | (0x7ff << 52)
	}
	if ue >= -126 {
		mut r = round_shift(full, 29)
		if r == (1 << 24) {
			r = 1 << 23
			ue = ue + 1
			if ue > 127 {
				return sign | (0x7ff << 52)
			}
		}
		return sign | ((ue + 1023) << 52) | ((r - (1 << 23)) << 29)
	}
	let s = -97 - ue
	if s > 54 {
		return sign
	}
	let k = round_shift(full, s)
	if k == 0 {
		return sign
	}
	mut p = 0
	for (k >> (p + 1)) != 0 {
		p = p + 1
	}
	return sign | ((p - 149 + 1023) << 52) | ((k << (52 - p)) & 0xfffffffffffff)
}

// round_shift is x >> s rounded to nearest, ties to even (x below 2^55).
fn round_shift(x i64, s i64) i64 {
	mut q = x >> s
	let rem = x & ((1 << s) - 1)
	let half = 1 << (s - 1)
	if rem > half || (rem == half && (q & 1) != 0) {
		q = q + 1
	}
	return q
}

fn is_integer_t(t i64) i64 {
	let k = kind_of(cast(Ty, t))
	return i64(k == K_INT || k == K_UINT)
}

fn is_unsigned_t(t Ty) i64 {
	return i64(cast(i64, t) != 0 && t.kind == K_INT && t.signed == 0)
}

// type_width is a value's size in memory: struct fields and slice elements use it.
fn type_width(t Ty) i64 {
	if cast(i64, t) == 0 {
		return 8
	}
	let k = t.kind
	if k == K_INT || k == K_BOOL || k == K_FLOAT {
		return t.width
	}
	if is_dyn_value(t) != 0 {
		return 16
	}
	return 8
}

fn width_log2(w i64) i64 {
	if w == 1 {
		return 0
	}
	if w == 2 {
		return 1
	}
	if w == 4 {
		return 2
	}
	if w == 16 {
		return 4
	}
	return 3
}

fn is_numeric_t(t i64) i64 {
	return i64(is_integer_t(t) != 0 || is_float_t(t) != 0)
}

fn is_bool_t(t i64) i64 {
	let k = kind_of(cast(Ty, t))
	return i64(k == K_BOOL || k == K_UBOOL)
}

fn is_untyped(t i64) i64 {
	let k = kind_of(cast(Ty, t))
	return i64(k == K_UINT || k == K_UFLOAT || k == K_UBOOL || k == K_NIL)
}

// nilable types may hold nil: optionals, faults and channels. References are never nil.
fn nilable(t i64) i64 {
	let k = kind_of(cast(Ty, t))
	return i64(k == K_OPT || k == K_ERROR || k == K_NIL || k == K_FUNC)
}

// is_ref reports whether values of t are pointers to heap or static memory.
fn is_ref(t i64) i64 {
	let k = kind_of(cast(Ty, t))
	return i64(k == K_STRING || k == K_STRUCT || k == K_SLICE || k == K_MAP || k == K_FUNC || k == K_ERROR || k == K_CHAN || k == K_OPT)
}

// default_type is the type an untyped constant gets when nothing else decides it.
fn default_type(t i64) i64 {
	let k = kind_of(cast(Ty, t))
	if k == K_UINT {
		return ty_int
	}
	if k == K_UFLOAT {
		return ty_float
	}
	if k == K_UBOOL {
		return ty_bool
	}
	return t
}

// assignable reports whether a value of type from can be stored where to is expected.
fn assignable(from Ty, to Ty) i64 {
	if cast(i64, from) == cast(i64, to) || cast(i64, to) == 0 {
		return 1
	}
	// A plain value may become secret (secret_of); a secret never becomes plain without reveal.
	if to.secret_ != 0 {
		if cast(i64, from) != 0 && from.secret_ != 0 {
			return assignable(cast(Ty, from.secret_), cast(Ty, to.secret_))
		}
		return assignable(from, cast(Ty, to.secret_))
	}
	if to.kind == K_OPT && is_secret(cast(Ty, to.elem)) != 0 && cast(i64, from) != 0 && from.secret_ == 0 && kind_of(from) != K_OPT && kind_of(from) != K_NIL {
		return assignable(from, cast(Ty, to.elem))
	}
	if to.bound != 0 || (cast(i64, from) != 0 && from.bound != 0) {
		return bounded_assignable(from, to)
	}
	let fk = kind_of(from)
	let tk = kind_of(to)
	if fk == K_UINT {
		return i64(tk == K_INT || tk == K_FLOAT)
	}
	if tk == K_OPT && cast(i64, from) == to.elem {
		return 1
	}
	if tk == K_OPT && opt_scalar(to) != 0 && fk != K_OPT && fk != K_NIL {
		return assignable(from, cast(Ty, opt_scalar(to)))
	}
	if fk == K_UFLOAT {
		return i64(tk == K_FLOAT)
	}
	if fk == K_UBOOL {
		return i64(tk == K_BOOL)
	}
	if fk == K_NIL {
		return nilable(cast(i64, to))
	}
	return 0
}

fn type_name(b []u8, t Ty) {
	if cast(i64, t) == 0 {
		buf_str(b, "int")
		return
	}
	if t.secret_ != 0 {
		buf_str(b, "secret ")
		type_name(b, cast(Ty, t.secret_))
		return
	}
	let k = t.kind
	if k == K_DYN {
		buf_str(b, "dyn ")
		let sd = cast(Decl, t.gdecl)
		if cast(i64, sd) != 0 {
			buf_str(b, sd.name)
		}
		let bind_ = t.targs
		if cast(i64, bind_) != 0 {
			buf_byte(b, '[')
			mut i = 0
			for i < len(bind_) {
				if i > 0 {
					buf_byte(b, ',')
				}
				type_name(b, cast(Ty, cast(NameBind, bind_[i]).val))
				i = i + 1
			}
			buf_byte(b, ']')
		}
		return
	}
	if len(t.name) != 0 {
		buf_str(b, t.name)
	} else if k == K_SLICE {
		buf_str(b, "[]")
		type_name(b, cast(Ty, t.elem))
	} else if k == K_CHAN {
		buf_str(b, "chan ")
		type_name(b, cast(Ty, t.elem))
	} else if k == K_OPT {
		buf_byte(b, '?')
		if opt_scalar(t) != 0 {
			type_name(b, cast(Ty, opt_scalar(t)))
		} else {
			type_name(b, cast(Ty, t.elem))
		}
	} else if k == K_MAP {
		buf_str(b, "map[")
		type_name(b, cast(Ty, t.key))
		buf_byte(b, ']')
		type_name(b, cast(Ty, t.elem))
	} else if k == K_FUNC || k == K_TUPLE {
		if k == K_FUNC {
			buf_str(b, "func")
		}
		buf_byte(b, '(')
		let ps = t.fields
		mut i = 0
		for i < len(ps) {
			if i > 0 {
				buf_str(b, ", ")
			}
			if k == K_FUNC && i < 63 && (t.key & (1 << i)) != 0 {
				buf_str(b, "mut ")
			}
			type_name(b, cast(Ty, ps[i]))
			i = i + 1
		}
		buf_byte(b, ')')
		if k == K_FUNC && len(t.results) == 1 {
			buf_byte(b, ' ')
			type_name(b, cast(Ty, t.results[0]))
		} else if k == K_FUNC && len(t.results) > 1 {
			buf_byte(b, ' ')
			type_name(b, cast(Ty, tuple_of(cast(i64, t.results))))
		}
	} else {
		buf_str(b, "?")
	}
}

// struct_field returns the index of field name in struct type t, or -1.
fn struct_field(t Ty, name str) i64 {
	let fs = t.fields
	mut i = 0
	for i < len(fs) {
		if cast(Field, fs[i]).name == name {
			return i
		}
		i = i + 1
	}
	return -1
}

fn field_type(t Ty, i i64) i64 {
	return cast(Field, t.fields[i]).ty
}

fn field_offset(t Ty, i i64) i64 {
	return cast(Field, t.fields[i]).off
}

// layout_struct assigns field offsets: widest fields first, each naturally aligned, so
// structs pack without padding holes; the object size rounds up to 8.
fn layout_struct(t Ty) {
	let fs = t.fields
	mut off = 0
	mut w = 16
	for w >= 1 {
		mut i = 0
		for i < len(fs) {
			let f = cast(Field, fs[i])
			if type_width(cast(Ty, f.ty)) == w {
				f.off = off
				off = off + w
			}
			i = i + 1
		}
		w = w / 2
	}
	t.size = align_up(off + i64((off == 0)), 8)
}

// elem_size is the size in bytes of one slice element.
fn elem_size(t Ty) i64 {
	return type_width(cast(Ty, t.elem))
}

// int_to_float_bits converts an integer constant to IEEE-754 bits, rounding to nearest even.
fn int_to_float_bits(v i64) i64 {
	if v == 0 {
		return 0
	}
	mut sign = 0
	mut m = v
	if v < 0 {
		sign = 1
		m = -v
	}
	// m is now the magnitude, read as unsigned (the most negative int stays 2^63).
	mut top = 63
	for ((m >> top) & 1) == 0 {
		top = top - 1
	}
	mut mant = 0
	if top <= 52 {
		mant = m << (52 - top)
	} else {
		let shift = top - 52
		mant = (m >> shift) & ((1 << (64 - shift)) - 1)
		if shift == 63 {
			mant = 1
		}
		let rest = m & ((1 << shift) - 1)
		let half = 1 << (shift - 1)
		if rest > half || (rest == half && (mant & 1) != 0) {
			mant = mant + 1
			if mant == (1 << 53) {
				mant = mant >> 1
				top = top + 1
			}
		}
	}
	return (sign << 63) | ((top + 1023) << 52) | (mant & ((1 << 52) - 1))
}

// ---- bounded types (#240): str max 100, []Item max 1000, map[str]T max 50 ----
//
// A bounded type is a twin of its unbounded type (same kind and layout) that also records
// a largest length. It is assignable to its unbounded type; the reverse needs bound(x).
shared mut ty_bounds []i64 // [unbounded type, max, bounded type]

// bounded_of is t refined to values of length at most max.
fn bounded_of(t_in i64, max_ i64) i64 {
	mut t = cast(Ty, t_in)
	if t.bound != 0 {
		t = cast(Ty, t.bound)
	}
	if cast(i64, ty_bounds) == 0 {
		ty_bounds = []i64{}
	}
	mut i = 0
	for i < len(ty_bounds) {
		let r = cast(Pair, cast([]i64, ty_bounds)[i])
		if r.a == cast(i64, t) && r.b == max_ {
			return r.c
		}
		i = i + 1
	}
	let b = cast(Ty, ty_new(t.kind, ""))
	ty_copy(b, t)
	b.bound = cast(i64, t)
	b.max = max_
	let nb = buf_new()
	type_name(cast([]u8, nb), t)
	buf_str(nb, " max ")
	buf_int(nb, max_)
	b.name = str(nb)
	let r = cast(Pair, calloc(3, 8))
	r.a = cast(i64, t)
	r.b = max_
	r.c = cast(i64, b)
	mut vs1 = cast([]i64, ty_bounds)
	vs1 = append(vs1, cast(i64, r))
	return cast(i64, b)
}

// unbounded is t without its bound.
fn unbounded(t Ty) i64 {
	if cast(i64, t) != 0 && t.bound != 0 {
		return t.bound
	}
	return cast(i64, t)
}

// bounded_assignable: a bounded value goes where its unbounded type (or a looser bound of
// it) is expected; nothing else becomes bounded without bound(x).
fn bounded_assignable(from Ty, to Ty) i64 {
	if to.bound == 0 {
		return assignable(cast(Ty, from.bound), to)
	}
	if cast(i64, from) != 0 && from.bound != 0 && from.max <= to.max {
		return assignable(cast(Ty, from.bound), cast(Ty, to.bound))
	}
	return 0
}

const TY_WORDS = 16 // the words of a Ty record, bounded types and secret twins included

// ty_copy copies the words that describe a type (everything before secret_, bound and max) from src into dst.
fn ty_copy(dst Ty, src Ty) {
	dst.kind = src.kind
	dst.elem = src.elem
	dst.key = src.key
	dst.fields = src.fields
	dst.results = src.results
	dst.name = src.name
	dst.variadic = src.variadic
	dst.width = src.width
	dst.signed = src.signed
	dst.size = src.size
	dst.targs = src.targs
	dst.gdecl = src.gdecl
	dst.enum_ = src.enum_
}
