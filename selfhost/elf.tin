// ELF writer: a position-independent Linux arm64 executable linked against glibc.
//
// Layout (vaddr == file offset, segments 64 KiB aligned so any kernel page size works):
//   R   : ELF header, program headers, interpreter path, dynsym, dynstr, hash, rela
//   RX  : _start, the program's code, import stubs, C strings, Tin strings, constants
//   RW  : dynamic section, GOT, globals
// Imports are bound at load time (BIND_NOW) by R_AARCH64_GLOB_DAT relocations on the
// same GOT the Mach-O writer uses; there is no PLT and no code signature.

const E_ALIGN = 65536;
const E_PHNUM = 7;
const E_START_WORDS = 13;
const R_AARCH64_GLOB_DAT = 1025;

var el_start_fn;   // the __libc_start_main import

fn el_hash(name) {
    let h = 0;
    let i = 0;
    while load8(name + i) != 0 {
        h = ((h << 4) + load8(name + i)) & 0xffffffff;
        let g = h & 0xf0000000;
        if g != 0 {
            h = h ^ (g >> 24);
        }
        h = h & (~g) & 0xffffffff;
        i = i + 1;
    }
    return h;
}

fn el_phdr(p, typ, flags, off, vaddr, filesz, memsz, align) {
    put32(p, typ);
    put32(p + 4, flags);
    put64(p + 8, off);
    put64(p + 16, vaddr);
    put64(p + 24, vaddr);
    put64(p + 32, filesz);
    put64(p + 40, memsz);
    put64(p + 48, align);
    return p + 56;
}

fn el_dyn(p, tag, val) {
    put64(p, tag);
    put64(p + 8, val);
    return p + 16;
}

// el_import returns the extern __libc_start_main, creating it when the program has none.
fn el_import(name) {
    let i = 0;
    while i < prog_fns[VEC_LEN] {
        let f = vec_get(prog_fns, i);
        if f[F_EXTERN] && streq(f[F_NAME], name) {
            f[F_USED] = 1;
            return f;
        }
        i = i + 1;
    }
    let nf = fn_new(NO_POS, name);
    nf[F_EXTERN] = 1;
    nf[F_USED] = 1;
    nf[F_QNAME] = name;
    vec_push(prog_fns, nf);
    return nf;
}

// is_libm_symbol reports whether name is a function of the math library (libm.so.6). Everything
// else the programs import is in libc.so.6, so a program that imports none of these does not need
// libm at all: the math package is written in Tin, and the instructions the hardware has (sqrt,
// floor, ceil, trunc, round, rint) are compiled inline.
fn is_libm_symbol(name) {
    let names = "acos asin atan atan2 acosh asinh atanh cbrt ceil copysign cos cosh erf erfc exp exp2 expm1 fabs floor fmax fmin fmod frexp hypot ldexp lgamma log log10 log1p log2 modf nearbyint pow rint round sin sinh sqrt tan tanh tgamma trunc ";
    let n = strlen(name);
    let i = 0;
    while load8(names + i) {
        let j = 0;
        while j < n && load8(names + i + j) == load8(name + j) {
            j = j + 1;
        }
        // A whole-word match: all of name, then the separating space.
        if j == n && load8(names + i + n) == ' ' {
            return 1;
        }
        // Skip to the start of the next word.
        while load8(names + i) != ' ' {
            i = i + 1;
        }
        i = i + 1;
    }
    return 0;
}

// imports_libm reports whether any imported function lives in libm.
fn imports_libm(imports) {
    let i = 0;
    while i < imports[VEC_LEN] {
        if is_libm_symbol(vec_get(imports, i)[F_NAME]) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn w_adrp(rd, pc, target) {
    let imm = (target >> 12) - (pc >> 12);
    return 0x90000000 | ((imm & 3) << 29) | (((imm >> 2) & 0x7ffff) << 5) | rd;
}

fn write_elf(path) {
    let nvars = prog_vars[VEC_LEN];
    el_start_fn = el_import("__libc_start_main");
    lk_imports = vec_new();
    let i = 0;
    while i < prog_fns[VEC_LEN] {
        let f = vec_get(prog_fns, i);
        if f[F_EXTERN] && f[F_USED] {
            f[F_GOT] = lk_imports[VEC_LEN];
            vec_push(lk_imports, f);
        }
        i = i + 1;
    }
    let nimp = lk_imports[VEC_LEN];

    // Dynamic symbols: null, the imports, then our functions (as tin.<name>, for backtraces).
    let dstr = buf_new();
    buf_byte(dstr, 0);
    let libc_at = dstr[VEC_LEN];
    buf_str(dstr, "libc.so.6");
    buf_byte(dstr, 0);
    // libm is listed only when the program imports one of its functions.
    let libm_at = 0;
    let uses_libm = imports_libm(lk_imports);
    if uses_libm {
        libm_at = dstr[VEC_LEN];
        buf_str(dstr, "libm.so.6");
        buf_byte(dstr, 0);
    }
    let interp = "/lib/ld-linux-aarch64.so.1";
    let names = vec_new();
    let name_off = vec_new();
    vec_push(names, "");
    vec_push(name_off, 0);
    i = 0;
    while i < nimp {
        let nm = vec_get(lk_imports, i)[F_NAME];
        vec_push(names, nm);
        vec_push(name_off, dstr[VEC_LEN]);
        buf_str(dstr, nm);
        buf_byte(dstr, 0);
        i = i + 1;
    }
    let own = vec_new();
    i = 0;
    while i < prog_fns[VEC_LEN] {
        let f = vec_get(prog_fns, i);
        if !f[F_EXTERN] && f[F_REACH] {
            vec_push(own, f);
            let b = buf_new();
            buf_str(b, "tin.");
            buf_str(b, f[F_QNAME]);
            buf_byte(b, 0);
            vec_push(names, b[VEC_DATA]);
            vec_push(name_off, dstr[VEC_LEN]);
            buf_str(dstr, b[VEC_DATA]);
            buf_byte(dstr, 0);
        }
        i = i + 1;
    }
    let nsym = names[VEC_LEN];

    // Read-only segment contents and their offsets.
    let ph_off = 64;
    let interp_off = ph_off + 56 * E_PHNUM;
    let dynsym_off = align_up(interp_off + strlen(interp) + 1, 8);
    let dynstr_off = dynsym_off + 24 * nsym;
    let hash_off = align_up(dynstr_off + dstr[VEC_LEN], 8);
    let nbucket = nsym / 2 + 1;
    let hash_size = 4 * (2 + nbucket + nsym);
    let rela_off = align_up(hash_off + hash_size, 8);
    let rela_size = 24 * nimp;
    let ro_end = rela_off + rela_size;

    // Text segment: _start, code, stubs, strings, constants.
    let text_addr = align_up(ro_end, E_ALIGN);
    let start_addr = text_addr;
    let pc = text_addr + 4 * E_START_WORDS;
    lk_labels = vec_filled(g_labels + 1, 0);
    i = 0;
    while i < code[VEC_LEN] {
        let op = vec_get(code, i);
        if op == I_LABEL {
            lk_labels[VEC_DATA][vec_get(code, i + 1)] = pc;
        } else if op == I_FUNC {
            vec_get(code, i + 1)[F_ADDR] = pc;
        } else {
            pc = pc + 4;
        }
        i = i + 5;
    }
    lk_stubs = pc;
    pc = pc + 12 * nimp;
    lk_strs = vec_new();
    i = 0;
    while i < g_str_ptrs[VEC_LEN] {
        vec_push(lk_strs, pc);
        pc = pc + vec_get(g_str_lens, i) + 1;
        i = i + 1;
    }
    pc = align_up(pc, 8);
    lk_zero = pc;
    pc = pc + 32;
    lk_tstrs = vec_new();
    i = 0;
    while i < g_tstr_ptrs[VEC_LEN] {
        vec_push(lk_tstrs, pc);
        pc = align_up(pc + 8 + vec_get(g_tstr_lens, i) + 1, 8);
        i = i + 1;
    }
    let text_end = pc;

    // Data segment: dynamic section, GOT, globals.
    let data_addr = align_up(text_end, E_ALIGN);
    let ndyn = 16;
    let dyn_addr = data_addr;
    lk_got = dyn_addr + 16 * ndyn;
    lk_data = lk_got + 8 * nimp;
    lk_fndescs = lk_data + 8 * nvars;
    let data_end = lk_fndescs + 16 * prog_fns[VEC_LEN] + 8;
    let file_size = data_end;
    let img = calloc(file_size, 1);

    // ELF header.
    store8(img, 0x7f);
    store8(img + 1, 'E');
    store8(img + 2, 'L');
    store8(img + 3, 'F');
    store8(img + 4, 2);
    store8(img + 5, 1);
    store8(img + 6, 1);
    put32(img + 16, 3 | (183 << 16));
    put32(img + 20, 1);
    put64(img + 24, start_addr);
    put64(img + 32, ph_off);
    put64(img + 40, 0);
    put32(img + 48, 0);
    put32(img + 52, 64 | (56 << 16));
    put32(img + 56, E_PHNUM | (64 << 16));
    put32(img + 60, 0);

    // Program headers: PHDR, INTERP, LOAD R, LOAD RX, LOAD RW, DYNAMIC, GNU_STACK.
    let p = img + ph_off;
    p = el_phdr(p, 6, 4, ph_off, ph_off, 56 * E_PHNUM, 56 * E_PHNUM, 8);
    p = el_phdr(p, 3, 4, interp_off, interp_off, strlen(interp) + 1, strlen(interp) + 1, 1);
    p = el_phdr(p, 1, 4, 0, 0, ro_end, ro_end, E_ALIGN);
    p = el_phdr(p, 1, 5, text_addr, text_addr, text_end - text_addr, text_end - text_addr, E_ALIGN);
    p = el_phdr(p, 1, 6, data_addr, data_addr, data_end - data_addr, data_end - data_addr, E_ALIGN);
    p = el_phdr(p, 2, 6, dyn_addr, dyn_addr, 16 * ndyn, 16 * ndyn, 8);
    p = el_phdr(p, 0x6474e551, 6, 0, 0, 0, 0, 16);
    memcpy(img + interp_off, interp, strlen(interp));

    // Dynamic symbols (24 bytes each).
    i = 1;
    while i < nsym {
        let s = img + dynsym_off + 24 * i;
        put32(s, vec_get(name_off, i));
        if i <= nimp {
            store8(s + 4, 0x12);
        } else {
            // dladdr only matches addresses inside [st_value, st_value + st_size).
            let oi = i - 1 - nimp;
            let f = vec_get(own, oi);
            let end = lk_stubs;
            if oi + 1 < own[VEC_LEN] {
                end = vec_get(own, oi + 1)[F_ADDR];
            }
            store8(s + 4, 0x12);
            store8(s + 6, 1);
            put64(s + 8, f[F_ADDR]);
            put64(s + 16, end - f[F_ADDR]);
        }
        i = i + 1;
    }
    memcpy(img + dynstr_off, dstr[VEC_DATA], dstr[VEC_LEN]);

    // SysV hash table over every dynamic symbol.
    let hp = img + hash_off;
    put32(hp, nbucket);
    put32(hp + 4, nsym);
    let buckets = hp + 8;
    let chains = buckets + 4 * nbucket;
    i = 1;
    while i < nsym {
        let b = el_hash(vec_get(names, i)) % nbucket;
        put32(chains + 4 * i, load32(buckets + 4 * b));
        put32(buckets + 4 * b, i);
        i = i + 1;
    }

    // One GLOB_DAT relocation per GOT slot.
    i = 0;
    while i < nimp {
        let r = img + rela_off + 24 * i;
        put64(r, lk_got + 8 * i);
        put64(r + 8, ((i + 1) << 32) | R_AARCH64_GLOB_DAT);
        put64(r + 16, 0);
        i = i + 1;
    }

    // Dynamic section.
    let d = img + dyn_addr;
    d = el_dyn(d, 1, libc_at);
    if uses_libm {
        d = el_dyn(d, 1, libm_at);
    }
    d = el_dyn(d, 4, hash_off);
    d = el_dyn(d, 5, dynstr_off);
    d = el_dyn(d, 6, dynsym_off);
    d = el_dyn(d, 10, dstr[VEC_LEN]);
    d = el_dyn(d, 11, 24);
    d = el_dyn(d, 7, rela_off);
    d = el_dyn(d, 8, rela_size);
    d = el_dyn(d, 9, 24);
    d = el_dyn(d, 30, 8);
    d = el_dyn(d, 0x6ffffffb, 0x08000001);
    d = el_dyn(d, 21, 0);
    d = el_dyn(d, 0, 0);

    // _start: __libc_start_main(main, argc, argv, 0, 0, rtld_fini, stack_end).
    let main_addr = entry_fn()[F_ADDR];
    let q = img + start_addr;
    let spc = start_addr;
    put32(q, 0xD280001D);
    put32(q + 4, 0xD280001E);
    put32(q + 8, 0xAA0003E5);
    put32(q + 12, 0xF94003E1);
    put32(q + 16, 0x910023E2);
    put32(q + 20, 0x910003E6);
    put32(q + 24, w_adrp(0, spc + 24, main_addr));
    put32(q + 28, 0x91000000 | ((main_addr & 0xfff) << 10));
    put32(q + 32, 0xD2800003);
    put32(q + 36, 0xD2800004);
    let stub_at = lk_stubs + 12 * el_start_fn[F_GOT];
    put32(q + 40, 0x94000000 | (((stub_at - (spc + 40)) >> 2) & 0x3ffffff));
    put32(q + 44, 0xD4200000);
    put32(q + 48, 0xD4200000);

    // Machine code and import stubs (adrp x16, got; ldr x16, [x16, got]; br x16).
    q = img + start_addr + 4 * E_START_WORDS;
    pc = start_addr + 4 * E_START_WORDS;
    i = 0;
    while i < code[VEC_LEN] {
        let op = vec_get(code, i);
        if op != I_LABEL && op != I_FUNC {
            put32(q, encode(code[VEC_DATA] + 8 * i, pc));
            q = q + 4;
            pc = pc + 4;
        }
        i = i + 5;
    }
    let stub = vec_new();
    vec_push(stub, I_ADRP);
    vec_push(stub, X16);
    vec_push(stub, 0);
    vec_push(stub, 0);
    vec_push(stub, 0);
    i = 0;
    while i < nimp {
        let got = sym_ref(SK_GOT, i);
        stub[VEC_DATA][0] = I_ADRP;
        stub[VEC_DATA][1] = X16;
        stub[VEC_DATA][2] = got;
        put32(q, encode(stub[VEC_DATA], pc));
        stub[VEC_DATA][0] = I_LDRLO;
        stub[VEC_DATA][2] = X16;
        stub[VEC_DATA][3] = got;
        put32(q + 4, encode(stub[VEC_DATA], pc + 4));
        put32(q + 8, 0xD61F0200);
        q = q + 12;
        pc = pc + 12;
        i = i + 1;
    }
    i = 0;
    while i < g_str_ptrs[VEC_LEN] {
        memcpy(img + vec_get(lk_strs, i), vec_get(g_str_ptrs, i), vec_get(g_str_lens, i));
        i = i + 1;
    }
    i = 0;
    while i < g_tstr_ptrs[VEC_LEN] {
        let at = img + vec_get(lk_tstrs, i);
        put64(at, vec_get(g_tstr_lens, i));
        memcpy(at + 8, vec_get(g_tstr_ptrs, i), vec_get(g_tstr_lens, i));
        i = i + 1;
    }
    i = 0;
    while i < nvars {
        put64(img + lk_data + 8 * i, vec_get(prog_vars, i)[D_VAL]);
        i = i + 1;
    }

    rt_sys_unlink(path);
    let fd = rt_sys_creat(path, 493);
    if (fd & 0x80000000) != 0 {
        let e = err_begin(NO_POS);
        buf_str(e, "cannot create ");
        buf_str(e, path);
        fatal(e);
    }
    let out = malloc(24);
    out[VEC_LEN] = file_size;
    out[VEC_CAP] = file_size;
    out[VEC_DATA] = img;
    write_all(fd, out);
    rt_sys_close(fd);
}
