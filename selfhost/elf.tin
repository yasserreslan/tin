// ELF writer: a static position-independent Linux arm64 executable. Tin's own _start reads
// argc, argv and envp from the kernel's initial stack: there is no interpreter, no dynamic
// section and no C library (#125).
//
// Layout (vaddr == file offset, segments 64 KiB aligned so any kernel page size works):
//   R   : ELF header, program headers, function names, backtrace records
//   RX  : _start, the program's code, C strings, Tin strings, constants
//   RW  : globals, function descriptors
const E_ALIGN = 65536
const E_START_WORDS = 13

fn el_phdr(p i64, typ i64, flags i64, off i64, vaddr i64, filesz i64, memsz i64, align i64) i64 {
	put32(p, typ)
	put32(p + 4, flags)
	put64(p + 8, off)
	put64(p + 16, vaddr)
	put64(p + 24, vaddr)
	put64(p + 32, filesz)
	put64(p + 40, memsz)
	put64(p + 48, align)
	return p + 56
}

shared mut link_strip i64 // -strip: no section headers or symbol table (#351)

// el_extra is what the symbol table of nfn functions, the section names and six section
// headers add after the loaded image, which ends at data_end; 0 with -strip (#351).
fn el_extra(data_end i64, nfn i64) i64 {
	if link_strip != 0 {
		return 0
	}
	let sh = align_up(align_up(data_end, 8) + 24 * (nfn + 1) + 39, 8)
	return sh + 64 * 6 - data_end
}

fn el_shdr(p i64, name i64, typ i64, flags i64, addr i64, off i64, size i64) {
	put32(p, name)
	put32(p + 4, typ)
	put64(p + 8, flags)
	put64(p + 16, addr)
	put64(p + 24, off)
	put64(p + 32, size)
}

fn el_shdr_link(p i64, link i64, info i64, align i64, entsize i64) {
	put32(p + 40, link)
	put32(p + 44, info)
	put64(p + 48, align)
	put64(p + 56, entsize)
}

// el_symbols writes, after the loaded image, a symbol table of the functions own (their
// names are the backtrace names without "tin.", at name_off in the name table), the
// section names, and the section headers .text, .data, .symtab, .strtab and .shstrtab, so
// nm, perf and gdb name the functions of a running Linux service (#351). lay is
// [data_end, names offset, names length, text start, code end, text end, data start].
fn el_symbols(img i64, own []Fn, name_off []i64, lay []i64) {
	let data_end = lay[0]
	let sym = align_up(data_end, 8)
	let n = len(own)
	mut i = 0
	for i < n {
		let f = own[i]
		mut end = lay[4]
		if i + 1 < n {
			end = own[i + 1].addr
		}
		let s = img + sym + 24 * (i + 1)
		put32(s, name_off[i] + 4)
		store8(s + 4, 0x12)
		store8(s + 6, 1)
		put64(s + 8, f.addr)
		put64(s + 16, end - f.addr)
		i = i + 1
	}
	let shstr = sym + 24 * (n + 1)
	let names = buf_new()
	buf_byte(names, 0)
	buf_str(names, cstr(".text"))
	buf_byte(names, 0)
	buf_str(names, cstr(".data"))
	buf_byte(names, 0)
	buf_str(names, cstr(".symtab"))
	buf_byte(names, 0)
	buf_str(names, cstr(".strtab"))
	buf_byte(names, 0)
	buf_str(names, cstr(".shstrtab"))
	buf_byte(names, 0)
	memcpy(img + shstr, slice_data(names), len(names))
	let sh = align_up(shstr + 39, 8)
	mut p = img + sh + 64
	el_shdr(p, 1, 1, 6, lay[3], lay[3], lay[5] - lay[3])
	el_shdr_link(p, 0, 0, 16, 0)
	p = p + 64
	el_shdr(p, 7, 1, 3, lay[6], lay[6], data_end - lay[6])
	el_shdr_link(p, 0, 0, 8, 0)
	p = p + 64
	el_shdr(p, 13, 2, 0, 0, sym, 24 * (n + 1))
	el_shdr_link(p, 4, 1, 8, 24)
	p = p + 64
	el_shdr(p, 21, 3, 0, 0, lay[1], lay[2])
	el_shdr_link(p, 0, 0, 1, 0)
	p = p + 64
	el_shdr(p, 29, 3, 0, 0, shstr, 39)
	el_shdr_link(p, 0, 0, 1, 0)
	put64(img + 40, sh)
	put32(img + 60, 6 | (5 << 16))
}

// el_check_static stops the link when the program would import a function: a Linux
// executable is static, and only the macOS runtime files declare externs (#125).
fn el_check_static() {
	mut i = 0
	for i < len(prog_fns) {
		let f = prog_fns[i]
		if f.extern_ != 0 && f.used != 0 {
			let b = buf_new()
			buf_str(b, cstr("a Linux executable is static, but the program imports "))
			buf_str(b, f.name)
			buf_byte(b, 0)
			link_fail(slice_data(b))
		}
		i = i + 1
	}
}

// el_start_static writes the static _start at p (address at): main(argc, argv, envp) from the
// kernel's initial stack, with no frame or link register, then exit_group (94) with its result.
fn el_start_static(p i64, at i64, main_addr i64) {
	put32(p, 0xD280001D)
	put32(p + 4, 0xD280001E)
	put32(p + 8, 0xF94003E0)
	put32(p + 12, 0x910023E1)
	put32(p + 16, 0x8B000C22)
	put32(p + 20, 0x91002042)
	put32(p + 24, 0x94000000 | (((main_addr - (at + 24)) >> 2) & 0x3ffffff))
	put32(p + 28, 0xD2800BC8)
	put32(p + 32, 0xD4000001)
	put32(p + 36, 0xD4200000)
	put32(p + 40, 0xD4200000)
	put32(p + 44, 0xD4200000)
	put32(p + 48, 0xD4200000)
}

fn write_elf(path i64) {
	let nvars = len(prog_vars)
	el_check_static()
	lk_imports = cast([]Fn, []i64{})

	// Function names (tin.<name>) and, after them, one backtrace record per function:
	// [start, end, name offset] (the runtime's symbol table).
	let dstr = buf_new()
	buf_byte(dstr, 0)
	let name_off = []i64{}
	let own = []Fn{}
	mut i = 0
	for i < len(prog_fns) {
		let f = prog_fns[i]
		if f.extern_ == 0 && f.reach != 0 {
			own = append(own, cast(Fn, f))
			name_off = append(name_off, len(dstr))
			buf_str(dstr, cstr("tin."))
			buf_str(dstr, f.qname)
			buf_byte(dstr, 0)
		}
		i = i + 1
	}

	// Read-only segment: headers, names, backtrace records.
	let ph_off = 64
	let phnum = 5
	let dynstr_off = ph_off + 56 * phnum
	lk_btrace = align_up(dynstr_off + len(dstr), 8)
	let ro_end = lk_btrace + 8 + 24 * len(cast([]i64, own))

	// Text segment: _start, code, strings, constants.
	let text_addr = align_up(ro_end, E_ALIGN)
	let start_addr = text_addr
	mut pc = text_addr + 4 * E_START_WORDS
	lk_labels = slice_filled(g_labels + 1, 0)
	i = 0
	for i < len(code) {
		let op = code[i]
		if cast(i64, op) == I_LABEL {
			lk_labels[cast(i64, code[i + 1])] = pc
		} else if cast(i64, op) == I_FUNC {
			code[i + 1].addr = pc
		} else {
			pc = pc + 4
		}
		i = i + 5
	}
	lk_stubs = pc // the end of the code: there are no import stubs
	lk_strs = []i64{}
	i = 0
	for i < len(g_str_ptrs) {
		lk_strs = append(lk_strs, pc)
		pc = pc + g_str_lens[i] + 1
		i = i + 1
	}
	pc = align_up(pc, 8)
	lk_zero = pc
	pc = pc + 32
	lk_tstrs = []i64{}
	i = 0
	for i < len(g_tstr_ptrs) {
		lk_tstrs = append(lk_tstrs, pc)
		pc = align_up(pc + 8 + g_tstr_lens[i] + 1, 8)
		i = i + 1
	}
	let text_end = pc

	// Data segment: globals, then function descriptors.
	let data_addr = align_up(text_end, E_ALIGN)
	lk_got = data_addr
	lk_data = data_addr
	lk_fndescs = lk_data + 8 * nvars
	let data_end = lk_fndescs + 16 * len(prog_fns) + 8
	let extra = el_extra(data_end, len(cast([]i64, own)))
	let file_size = data_end + extra
	let img = calloc(file_size, 1)

	// ELF header.
	store8(img, 0x7f)
	store8(img + 1, 'E')
	store8(img + 2, 'L')
	store8(img + 3, 'F')
	store8(img + 4, 2)
	store8(img + 5, 1)
	store8(img + 6, 1)
	put32(img + 16, 3 | (183 << 16))
	put32(img + 20, 1)
	put64(img + 24, start_addr)
	put64(img + 32, ph_off)
	put64(img + 40, 0)
	put32(img + 48, 0)
	put32(img + 52, 64 | (56 << 16))
	put32(img + 56, phnum | (64 << 16))
	put32(img + 60, 0)

	// Program headers: PHDR, LOAD R, LOAD RX, LOAD RW, GNU_STACK.
	mut p = img + ph_off
	p = el_phdr(p, 6, 4, ph_off, ph_off, 56 * phnum, 56 * phnum, 8)
	p = el_phdr(p, 1, 4, 0, 0, ro_end, ro_end, E_ALIGN)
	p = el_phdr(p, 1, 5, text_addr, text_addr, text_end - text_addr, text_end - text_addr, E_ALIGN)
	p = el_phdr(p, 1, 6, data_addr, data_addr, data_end - data_addr, data_end - data_addr, E_ALIGN)
	p = el_phdr(p, 0x6474e551, 6, 0, 0, 0, 0, 16)

	memcpy(img + dynstr_off, slice_data(dstr), len(dstr))
	put64(img + lk_btrace, len(cast([]i64, own)))
	i = 0
	for i < len(cast([]i64, own)) {
		let f = own[i]
		mut end = lk_stubs
		if i + 1 < len(cast([]i64, own)) {
			end = own[i + 1].addr
		}
		let rec = img + lk_btrace + 8 + 24 * i
		put64(rec, f.addr)
		put64(rec + 8, end)
		put64(rec + 16, dynstr_off + name_off[i])
		i = i + 1
	}

	el_start_static(img + start_addr, start_addr, entry_fn().addr)
	if extra != 0 {
		let lay = []i64{}
		lay = append(lay, data_end)
		lay = append(lay, dynstr_off)
		lay = append(lay, len(dstr))
		lay = append(lay, text_addr)
		lay = append(lay, lk_stubs)
		lay = append(lay, text_end)
		lay = append(lay, data_addr)
		el_symbols(img, cast([]Fn, cast([]i64, own)), cast([]i64, name_off), cast([]i64, lay))
	}

	// Machine code.
	mut q = img + start_addr + 4 * E_START_WORDS
	pc = start_addr + 4 * E_START_WORDS
	i = 0
	for i < len(code) {
		let op = code[i]
		if cast(i64, op) != I_LABEL && cast(i64, op) != I_FUNC {
			put32(q, encode(slice_data(code) + 8 * i, pc))
			q = q + 4
			pc = pc + 4
		}
		i = i + 5
	}
	i = 0
	for i < len(g_str_ptrs) {
		memcpy(img + lk_strs[i], g_str_ptrs[i], g_str_lens[i])
		i = i + 1
	}
	i = 0
	for i < len(g_tstr_ptrs) {
		let at = img + lk_tstrs[i]
		put64(at, g_tstr_lens[i])
		memcpy(at + 8, g_tstr_ptrs[i], g_tstr_lens[i])
		i = i + 1
	}
	i = 0
	for i < nvars {
		put64(img + lk_data + 8 * i, prog_vars[i].val)
		i = i + 1
	}

	rt_sys_unlink(path)
	let fd = rt_sys_creat(path, 493)
	if (fd & 0x80000000) != 0 {
		let e = cast([]i64, err_code(NO_POS, cstr("E904 CANNOT_CREATE")))
		buf_str(cast([]u8, e), cstr("cannot create "))
		buf_str(cast([]u8, e), path)
		fatal(cast([]u8, e))
	}
	let outh = cast(SliceHdr, malloc(24))
	outh.len = file_size
	outh.cap = file_size
	outh.data = img
	write_all(fd, cast([]u8, outh))
	rt_sys_close(fd)
}
