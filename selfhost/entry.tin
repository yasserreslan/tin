package main

// The compiler is a strict program: the runtime starts it and calls main, which hands the
// arguments to the untyped driver (compiler_main in main.tin) and exits with its status.
// See design/design_typed_compiler.md.
fn main() {
	let status = compiler_main(rtArgc, rtArgv)
	rt_flush()
	rt_sys_exit(status)
}
