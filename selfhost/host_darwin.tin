// The compiler's own macOS host calls (the Makefile builds tinc with this file or
// host_linux.tin, whichever matches the machine tinc will run on).

extern fn _NSGetExecutablePath(buf, size);

fn host_exe_path(buf, n) {
    let size = n;
    _NSGetExecutablePath(buf, &size);
}

// host_dirent_name is the name in a struct dirent from readdir.
fn host_dirent_name(ent) {
    return ent + 21;
}

extern fn getenv(name);
fn host_start(argc, argv) {}
fn host_getenv(name) { return getenv(name); }


extern fn creat(path,mode);
extern fn unlink(path);
extern fn opendir(path);
extern fn readdir(dir);
extern fn closedir(dir);
extern fn uname(buf);
fn rt_sys_creat(path,mode) { return creat(path,mode); }
fn rt_sys_unlink(path) { return unlink(path); }
fn rt_sys_opendir(path) { return opendir(path); }
fn rt_sys_readdir(dir) { return readdir(dir); }
fn rt_sys_closedir(dir) { return closedir(dir); }
fn rt_sys_uname(buf) { return uname(buf); }

extern fn realpath(path,resolved);
fn host_realpath(path,resolved) { return realpath(path,resolved); }
