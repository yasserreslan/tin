// The compiler's own macOS host calls (the Makefile builds tinc with this file or
// host_linux.tin, whichever matches the machine tinc will run on).

extern fn _NSGetExecutablePath(buf, size);

fn host_exe_path(buf, n) {
    let size = n;
    _NSGetExecutablePath(buf, &size);
}

// host_dirent_name is the name in a struct dirent from readdir.
fn host_dirent_name(ent) {
    return ent + 21;
}

extern fn sysconf(name);
fn host_mem_flags() { return 0x1002; }
fn host_mem_page() { return sysconf(29); }

extern fn write(fd,buf,n);
extern fn read(fd,buf,n);
extern fn open(path,flags,mode);
extern fn close(fd);
extern fn exit(code);
extern fn _exit(code);
extern fn creat(path,mode);
extern fn unlink(path);
extern fn mmap(addr,n,prot,flags,fd,off);
extern fn munmap(addr,n);
extern fn opendir(path);
extern fn readdir(dir);
extern fn closedir(dir);
extern fn uname(buf);
fn rt_sys_write(fd,buf,n) { return write(fd,buf,n); }
fn rt_sys_read(fd,buf,n) { return read(fd,buf,n); }
fn rt_sys_open(path,flags,mode) { return open(path,flags,mode); }
fn rt_sys_close(fd) { return close(fd); }
fn rt_sys_exit(code) { return exit(code); }
fn rt_sys__exit(code) { return _exit(code); }
fn rt_sys_creat(path,mode) { return creat(path,mode); }
fn rt_sys_unlink(path) { return unlink(path); }
fn rt_sys_mmap(addr,n,prot,flags,fd,off) { return mmap(addr,n,prot,flags,fd,off); }
fn rt_sys_munmap(addr,n) { return munmap(addr,n); }
fn rt_sys_opendir(path) { return opendir(path); }
fn rt_sys_readdir(dir) { return readdir(dir); }
fn rt_sys_closedir(dir) { return closedir(dir); }
fn rt_sys_uname(buf) { return uname(buf); }
