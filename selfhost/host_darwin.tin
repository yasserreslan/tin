// The compiler's own macOS host calls (the Makefile builds tinc with this file or
// host_linux.tin, whichever matches the machine tinc will run on).
extern fn _NSGetExecutablePath(buf i64, size i64) i64

fn host_exe_path(buf i64, n i64) {
	mut size = n
	_NSGetExecutablePath(buf, &size)
}

// host_dirent_name is the name in a struct dirent from readdir.
fn host_dirent_name(ent i64) i64 {
	return ent + 21
}

extern fn getenv(name i64) i64

fn host_start(argc i64, argv i64) {

}

fn host_getenv(name str) i64 {
	return getenv(rt_cstr(name))
}

extern fn creat(path i64, mode i64) i64
extern fn unlink(path i64) i64
extern fn opendir(path i64) i64
extern fn readdir(dir i64) i64
extern fn closedir(dir i64) i64
extern fn uname(buf i64) i64

fn host_creat(path str, mode i64) i64 {
	return creat(rt_cstr(path), mode)
}

fn host_unlink(path str) i64 {
	return unlink(rt_cstr(path))
}

fn host_opendir(path str) i64 {
	return opendir(rt_cstr(path))
}

fn rt_sys_readdir(dir i64) i64 {
	return readdir(dir)
}

fn rt_sys_closedir(dir i64) i64 {
	return closedir(dir)
}

fn rt_sys_uname(buf i64) i64 {
	return uname(buf)
}

extern fn realpath(path i64, resolved i64) i64

fn host_realpath(path str, resolved i64) i64 {
	return realpath(rt_cstr(path), resolved)
}

// host_str is the compiler string for the C string at p, which the operating system or the C library
// handed back (an argument, an environment value, a directory entry name, a resolved path).
fn host_str(p i64) str {
	return rt_str_from_raw(p, host_c_len(p))
}

// host_c_len is the length of the C string at p.
fn host_c_len(p i64) i64 {
	mut n = 0
	for i64(load8(p + n)) != 0 {
		n = n + 1
	}
	return n
}
