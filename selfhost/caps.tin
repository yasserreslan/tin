// Package capabilities (#146, docs/PACKAGES.md): a vendored package's tin.mod declares what
// it may do (net, files, spawn, exec, unsafe); the standard library's entry points to the
// operating system are tagged with the capability they need, and a call from a vendored
// package that can reach a capability its manifest does not declare is a compile error.
const CAP_NET = 1
const CAP_FILES = 2
const CAP_SPAWN = 4
const CAP_EXEC = 8
const CAP_UNSAFE = 16

// A vendored package: its import path, declared capabilities and manifest (0 when it has none).

shared mut file_cap_pkg []CapsRec // per loaded file: its vendored package record, or 0 (not restricted)
shared mut cap_pkgs []CapsRec // the vendored package records, one per import path
shared mut cap_edges []i64 // per function (by Fn.index during the pass): vec of [callee, position]
shared mut cap_masks []i64 // per function: the capabilities it can reach
shared mut cap_cur []i64 // the edge list being filled by cap_walk_*
shared mut caps_report i64 // tinc -caps: print each package's capabilities instead of building

fn cap_name(bit i64) str {
	if bit == CAP_NET {
		return "net"
	}
	if bit == CAP_FILES {
		return "files"
	}
	if bit == CAP_SPAWN {
		return "spawn"
	}
	if bit == CAP_EXEC {
		return "exec"
	}
	return "unsafe"
}

fn cap_bit(name str) i64 {
	mut bit = 1
	for bit <= CAP_UNSAFE {
		if name == cap_name(bit) {
			return bit
		}
		bit = bit * 2
	}
	return 0
}

// cap_list appends the capabilities in mask in their fixed order, separated by sep.
fn cap_list(b []u8, mask i64, sep str) {
	mut bit = 1
	mut first = 1
	for bit <= CAP_UNSAFE {
		if mask & bit != 0 {
			if first == 0 {
				buf_str(b, sep)
			}
			buf_str(b, cap_name(bit))
			first = 0
		}
		bit = bit * 2
	}
}

// ---- manifests ----
// cap_words splits a line into its words (separated by spaces, tabs and carriage returns).
fn cap_words(line str) []str {
	let words = []str{}
	mut i = 0
	for i < len(line) {
		for i < len(line) && (line[i] == ' ' || line[i] == '\t' || line[i] == '\r') {
			i = i + 1
		}
		let start = i
		for i < len(line) && line[i] != ' ' && line[i] != '\t' && line[i] != '\r' {
			i = i + 1
		}
		if i > start {
			words = append(words, line[start:i])
		}
	}
	return words
}

fn manifest_error(path str, line_no i64, msg str, word str) {
	let e = buf_new()
	buf_str(e, path)
	buf_byte(e, ':')
	buf_int(e, line_no)
	// A tin.mod is not a loaded source file, so its position is written here.
	buf_str(e, ": error ")
	buf_str(e, "E114 MANIFEST")
	buf_str(e, ": ")
	buf_str(e, msg)
	if len(word) != 0 {
		buf_str(e, " '")
		buf_str(e, word)
		buf_byte(e, '\'')
	}
	buf_str(e, " (a tin.mod line is module PATH, require PATH SOURCE or caps net files spawn exec unsafe)")
	fatal(e)
}

// manifest_caps reads a tin.mod and returns the capabilities its caps lines declare.
fn manifest_caps(src []u8, path str) i64 {
	let text = str(src)
	mut caps = 0
	mut line_no = 0
	mut i = 0
	for i < len(text) {
		line_no = line_no + 1
		mut end = i
		for end < len(text) && text[end] != '\n' {
			end = end + 1
		}
		let words = cap_words(text[i:end])
		if len(words) > 0 && starts_with(words[0], "//") == 0 {
			if words[0] == "caps" {
				mut k = 1
				for k < len(words) {
					let bit = cap_bit(words[k])
					if bit == 0 {
						manifest_error(path, line_no, "unknown capability", words[k])
					}
					caps = caps | bit
					k = k + 1
				}
			} else if words[0] == "module" || words[0] == "require" {
				if len(words) < 2 {
					manifest_error(path, line_no, "missing path after", words[0])
				}
			} else {
				manifest_error(path, line_no, "unknown line", words[0])
			}
		}
		i = end + 1
	}
	return caps
}

// lock_caps_line returns tin.lock's "caps PATH ..." line for an import path, or "".
fn lock_caps_line(ipath str) str {
	let text = str(project_lock)
	let head = "caps " + ipath
	mut i = 0
	for i < len(text) {
		mut end = i
		for end < len(text) && text[end] != '\n' {
			end = end + 1
		}
		if end - i >= len(head) && text[i:i + len(head)] == head && (end - i == len(head) || text[i + len(head)] == ' ') {
			return text[i:end]
		}
		i = end + 1
	}
	return ""
}

// vendored_package returns the record of the package an import resolved to when it is under
// the project's vendor/ (reading and locking its tin.mod the first time), or 0.
fn vendored_package(ipath str, found []str) i64 {
	let first = found[0]
	let vroot = vendor_dir()
	if starts_with(first, vroot) == 0 {
		return 0
	}
	mut i = 0
	for i < len(cap_pkgs) {
		if cap_pkgs[i].path == ipath {
			return cast(i64, cap_pkgs[i])
		}
		i = i + 1
	}
	let rec = cast(CapsRec, calloc(3, 8))
	rec.path = ipath
	rec.manifest = ""
	let manifest = cat_path(dir_of(first), "/tin.mod")
	let src = cast([]i64, try_read_file(manifest))
	if cast(i64, src) != 0 {
		rec.manifest = manifest
		// The manifest is vendored source too: the lock pins it like the code.
		lock_has(manifest)
		rec.caps = manifest_caps(cast([]u8, src), manifest)
	}
	// The lock shows a reviewer each package's capabilities; it must say what the manifest says.
	if cast(i64, project_lock) != 0 {
		let want = buf_new()
		buf_str(want, "caps ")
		buf_str(want, ipath)
		if rec.caps != 0 {
			buf_byte(want, ' ')
			cap_list(cast([]u8, want), rec.caps, " ")
		}
		let got = lock_caps_line(ipath)
		if (len(got) != 0 || cast(i64, src) != 0) && !(len(got) != 0 && got == str(want)) {
			let e = cast([]i64, err_code(NO_POS, "E115 LOCK_CAPS"))
			buf_str(cast([]u8, e), "tin.lock ")
			if len(got) != 0 {
				buf_str(cast([]u8, e), "says \"")
				buf_str(cast([]u8, e), got)
				buf_str(cast([]u8, e), "\"")
			} else {
				buf_str(cast([]u8, e), "has no caps line")
			}
			buf_str(cast([]u8, e), " for ")
			buf_str(cast([]u8, e), ipath)
			buf_str(cast([]u8, e), ", its manifest declares \"")
			buf_str(cast([]u8, e), str(want))
			buf_str(cast([]u8, e), "\" (run tin vendor)")
			fatal(cast([]u8, e))
		}
	}
	cap_pkgs = append(cap_pkgs, cast(CapsRec, rec))
	return cast(i64, rec)
}

// ---- tags ----
// cap_sealed is 1 + the capabilities of a standard-library function whose internals are
// part of what it does, or 0: the DNS resolver reads /etc/hosts and /etc/resolv.conf as part
// of net, and a server keeps a spare descriptor open on /dev/null to shed connections when
// it runs out of them. What a sealed function calls is not followed.
fn cap_sealed(f Fn) i64 {
	if file_trusted[f.file] == 0 || f.extern_ != 0 {
		return 0
	}
	let name = f.qname
	if name == "wire.resolve" || name == "anvil.serve_on" {
		return 1 + CAP_NET
	}
	if name == "anvil.drop_one" {
		return 1
	}
	return 0
}

// cap_tag is the capability a standard-library function needs by itself: the operating
// system entry points (the runtime's rt_sys_* calls and the C functions lib/ declares extern)
// that open a connection or a file, start a process or replace it. A tag is final.
fn cap_tag(f Fn) i64 {
	if file_trusted[f.file] == 0 {
		return 0
	}
	let sealed = cap_sealed(f)
	if sealed != 0 {
		return sealed - 1
	}
	// On macOS some packages wrap their own C calls as rt_sys_* (quarry.rt_sys_open): the
	// declared name is what counts, so every target tags the same entry points.
	mut name = f.name
	if f.extern_ == 0 {
		if starts_with(name, "rt_sys_") == 0 {
			return 0
		}
		name = name[7:]
	}
	if name == "socket" || name == "connect" || name == "bind" || name == "listen" || name == "accept" || name == "getaddrinfo" {
		return CAP_NET
	}
	if name == "open" || name == "creat" || name == "opendir" || name == "mkdir" || name == "rmdir" || name == "unlink" || name == "rename" || name == "stat" || name == "lstat" || name == "chdir" || name == "readlink" {
		return CAP_FILES
	}
	if name == "fork" || name == "vfork" || name == "posix_spawn" || name == "posix_spawnp" {
		return CAP_SPAWN
	}
	if name == "execve" || name == "execv" || name == "execvp" {
		return CAP_EXEC
	}
	return 0
}

// cap_final reports a function whose capabilities are its tag alone: an entry point or a
// sealed function.
fn cap_final(f i64) i64 {
	return i64(cap_sealed(cast(Fn, f)) != 0 || cap_tag(cast(Fn, f)) != 0)
}

// cap_runtime reports a function of the runtime package: its internal file reads (cgroup
// limits, /proc) are not the program's, so only its tagged entry points carry a capability.
fn cap_runtime(f Fn) i64 {
	return i64(file_trusted[f.file] != 0 && i64(byte_at(file_pkgs[f.file], 0)) == 0)
}

// ---- the call graph ----
fn cap_edge(g i64, pos i64) {
	if g == 0 {
		return
	}
	cap_cur = append(cap_cur, pair(g, pos))
}

fn cap_walk_stmts(v []i64) {
	mut i = 0
	for i < len(v) {
		cap_walk_stmt(v[i])
		i = i + 1
	}
}

// cap_walk_stmt follows reach_stmt: the statements the checker leaves for the backend.
fn cap_walk_stmt(s i64) {
	if s == 0 {
		return
	}
	let k = cast(Node, s).kind
	if k == ST_BLOCK {
		cap_walk_stmts(cast(Block, s).stmts)
	} else if k == ST_LET {
		cap_walk_expr(cast(LetStmt, s).init)
	} else if k == ST_ASSIGN {
		cap_walk_expr(cast(AssignStmt, s).target)
		cap_walk_expr(cast(AssignStmt, s).value)
	} else if k == ST_EXPR {
		cap_walk_expr(cast(ExprStmt, s).x)
	} else if k == ST_IF {
		cap_walk_expr(cast(IfStmt, s).cond)
		cap_walk_stmt(cast(IfStmt, s).then)
		cap_walk_stmt(cast(IfStmt, s).else_)
	} else if k == ST_WHILE {
		cap_walk_expr(cast(WhileStmt, s).cond)
		cap_walk_stmt(cast(WhileStmt, s).body)
		cap_walk_stmt(cast(WhileStmt, s).post)
	} else if k == ST_RETURN {
		cap_walk_expr(cast(ReturnStmt, s).value)
		if cast(i64, cast(ReturnStmt, s).values) != 0 {
			cap_walk_exprs(cast(ReturnStmt, s).values)
		}
	} else if k == ST_CALLMULTI {
		cap_walk_expr(cast(CallMultiStmt, s).call)
	}
}

fn cap_walk_exprs(v []i64) {
	mut i = 0
	for i < len(v) {
		cap_walk_expr(v[i])
		i = i + 1
	}
}

// cap_walk_expr records every function a body calls or refers to (a function value or a dyn
// table's methods can be called later, so referring counts as calling).
fn cap_walk_expr(e i64) {
	if e == 0 {
		return
	}
	let k = cast(Node, e).kind
	if k == EX_CALL {
		cap_edge(cast(Call, e).fn_, cast(Node, e).pos)
		cap_walk_expr(cast(Call, e).callee)
		cap_walk_exprs(cast(Call, e).args)
	} else if k == EX_FUNCREF {
		cap_edge(cast(FuncRef, e).fn_, cast(Node, e).pos)
	} else if k == EX_UNARY {
		cap_walk_expr(cast(Unary, e).x)
	} else if k == EX_BINARY {
		cap_walk_expr(cast(Binary, e).l)
		cap_walk_expr(cast(Binary, e).r)
	} else if k == EX_INDEX {
		cap_walk_expr(cast(IndexExpr, e).x)
		cap_walk_expr(cast(IndexExpr, e).i)
	} else if k == EX_CONV {
		if cast(Conv, e).kind == CV_DYN && cast(Conv, e).dyn_table >= 0 && cast(Conv, e).dyn_table < len(dyn_tables) {
			let rec = cast(DynTable, dyn_tables[cast(Conv, e).dyn_table])
			cap_edge(rec.keep_, cast(Node, e).pos)
			let fns = rec.fns
			mut j = 0
			for j < len(fns) {
				cap_edge(fns[j], cast(Node, e).pos)
				j = j + 1
			}
		}
		cap_walk_expr(cast(Conv, e).x)
	} else if k == EX_SEQ {
		cap_walk_stmts(cast(SeqExpr, e).stmts)
		cap_walk_expr(cast(SeqExpr, e).value)
	} else if k == EX_MEM {
		cap_walk_expr(cast(MemExpr, e).base)
		cap_walk_expr(cast(MemExpr, e).index)
		cap_walk_expr(cast(MemExpr, e).len)
	} else if k == EX_ELEM {
		cap_walk_expr(cast(ElemExpr, e).seq)
		cap_walk_expr(cast(ElemExpr, e).idx)
	}
}

// cap_index is a function's position in prog_fns during the pass, or -1.
fn cap_index(f Fn) i64 {
	let i = f.index
	if i >= 0 && i < len(prog_fns) && cast(i64, prog_fns[i]) == cast(i64, f) {
		return i
	}
	return -1
}

fn cap_mask_of(f i64) i64 {
	let i = cap_index(cast(Fn, f))
	if i < 0 {
		return cap_tag(cast(Fn, f))
	}
	return cap_masks[i]
}

// cap_pkg_of is the vendored package that declares f, by its position: a function the
// compiler generates (an encoder, the start code) has no line and belongs to no package.
fn cap_pkg_of(f Fn) CapsRec {
	let pos = f.pos
	if pos <= 0 || ((pos >> 16) & 0xffffffff) == 0 || (pos >> 48) >= len(file_cap_pkg) {
		return cast(CapsRec, 0)
	}
	return file_cap_pkg[pos >> 48]
}

// cap_own is what a function needs by itself: its tag, or unsafe in a package that declares it.
fn cap_own(f i64) i64 {
	let p = cap_pkg_of(cast(Fn, f))
	if cast(i64, p) != 0 && (p.caps & CAP_UNSAFE) != 0 {
		return cap_tag(cast(Fn, f)) | CAP_UNSAFE
	}
	return cap_tag(cast(Fn, f))
}

// cap_graph records every function's calls and computes what each can reach.
fn cap_graph() {
	cap_edges = []i64{}
	cap_masks = []i64{}
	let n = len(prog_fns)
	mut i = 0
	for i < n {
		let f = prog_fns[i]
		f.index = i
		cap_cur = []i64{}
		if f.body != 0 && f.extern_ == 0 && is_template(f) == 0 && cap_final(cast(i64, f)) == 0 {
			cap_walk_stmts(cast(Block, f.body).stmts)
		}
		cap_edges = append(cap_edges, cast(i64, cap_cur))
		cap_masks = append(cap_masks, cap_own(cast(i64, f)))
		i = i + 1
	}
	// Reachability to a fixed point; tagged functions and the runtime's own do not inherit.
	mut changed = 1
	for changed != 0 {
		changed = 0
		i = 0
		for i < n {
			let f = prog_fns[i]
			if cap_final(cast(i64, f)) == 0 && cap_runtime(f) == 0 {
				mut m = cap_masks[i]
				let es = cast([]i64, cap_edges[i])
				mut j = 0
				for j < len(es) {
					m = m | cap_mask_of(cast(Pair, es[j]).a)
					j = j + 1
				}
				if m != cap_masks[i] {
					cap_masks[i] = m
					changed = 1
				}
			}
			i = i + 1
		}
	}
}

// cap_path appends how g reaches the capability bit: g -> ... -> the tagged entry point.
fn cap_path(b []u8, g i64, bit i64) {
	let path = []Fn{}
	let found = cap_find(g, bit, cast([]i64, path))
	if len(cast([]i64, path)) == 0 {
		path = append(path, cast(Fn, g))
	}
	mut i = 0
	for i < len(cast([]i64, path)) {
		let f = path[i]
		if i > 0 {
			buf_str(b, " -> ")
		}
		if cap_tag(f) != 0 && cap_sealed(f) == 0 {
			buf_str(b, f.name)
		} else {
			buf_str(b, f.qname)
		}
		i = i + 1
	}
	if found == 2 {
		buf_str(b, " -> ...")
	}
}

// cap_find extends path from g to a function that owns the capability bit, trying g's calls in
// order and never following a function already on the path (a cycle, such as an effect's
// live call reaching back into its public function, #241): 1 found, 2 cut at 12 steps, 0 none.
fn cap_find(g i64, bit i64, path []i64) i64 {
	path = append(path, g)
	if (cap_own(g) & bit) != 0 || cap_index(cast(Fn, g)) < 0 || cap_final(g) != 0 {
		return 1
	}
	let es = cast([]i64, cap_edges[cap_index(cast(Fn, g))])
	mut j = 0
	for j < len(es) {
		let c = cast(Pair, es[j]).a
		if c != g && (cap_mask_of(c) & bit) != 0 && slice_has(path, c) == 0 {
			if len(path) >= 12 {
				return 2
			}
			let r = cap_find(c, bit, path)
			if r != 0 {
				return r
			}
		}
		j = j + 1
	}
	slice_truncate(path, len(path) - 1)
	return 0
}

fn cap_violation(pos i64, p CapsRec, g Fn, need i64) {
	mut bit = 1
	for (need & bit) == 0 {
		bit = bit * 2
	}
	let e = err_code(pos, "E804 CAPABILITY")
	buf_str(e, g.qname)
	buf_str(e, " needs capability ")
	buf_str(e, cap_name(bit))
	buf_str(e, " (")
	cap_path(cast([]u8, e), cast(i64, g), bit)
	buf_str(e, "), which package ")
	buf_str(e, p.path)
	buf_str(e, " does not declare in its tin.mod (caps: ")
	if p.caps != 0 {
		cap_list(cast([]u8, e), p.caps, " ")
	} else {
		buf_str(e, "none")
	}
	buf_byte(e, ')')
	err_end(cast([]u8, e))
}

// cap_check_edges reports each call from package p, at site positions, that leaves the
// package for code needing a capability p does not declare.
fn cap_check_edges(p CapsRec, es []i64) {
	mut j = 0
	for j < len(es) {
		let rec = cast(Pair, es[j])
		let g = rec.a
		let m = cap_mask_of(g)
		let need = m - (m & p.caps)
		if need != 0 && cast(i64, cap_pkg_of(cast(Fn, g))) != cast(i64, p) {
			cap_violation(rec.b, p, cast(Fn, g), need)
		}
		j = j + 1
	}
}

// cap_check_inits checks the package-level initializers of restricted packages.
fn cap_check_inits(stmts []i64) {
	mut i = 0
	for i < len(stmts) {
		let a = stmts[i]
		mut pos = cast(Node, a).pos
		if cast(Node, a).kind == ST_ASSIGN && cast(AssignStmt, a).value != 0 {
			pos = cast(Node, cast(AssignStmt, a).value).pos
		}
		if pos != NO_POS && pos >= 0 {
			let p = file_cap_pkg[pos >> 48]
			if cast(i64, p) != 0 {
				cap_cur = []i64{}
				cap_walk_stmt(a)
				cap_check_edges(cast(CapsRec, p), cap_cur)
			}
		}
		i = i + 1
	}
}

// check_capabilities runs after the checker when a vendored package is loaded (or for tinc
// -caps): every call from a vendored package must stay within its declared capabilities.
fn check_capabilities() {
	mut any = 0
	mut i = 0
	for i < len(file_cap_pkg) {
		if cast(i64, file_cap_pkg[i]) != 0 {
			any = 1
		}
		i = i + 1
	}
	if any == 0 && caps_report == 0 {
		return
	}
	cap_graph()
	i = 0
	for i < len(prog_fns) {
		let f = prog_fns[i]
		let p = cap_pkg_of(cast(Fn, f))
		if cast(i64, p) != 0 {
			cap_check_edges(cast(CapsRec, p), cast([]i64, cap_edges[i]))
		}
		i = i + 1
	}
	cap_check_inits(init_stmts)
	cap_check_inits(core_stmts)
}

// cap_exported reports a function others can call: an exported function or method, or any
// function of the program's own package.
fn cap_exported(f Fn) i64 {
	if i64(byte_at(file_pkgs[f.pos >> 48], 0)) == 0 {
		return 1
	}
	let c = i64(byte_at(f.name, 0))
	return i64(c >= 'A' && c <= 'Z')
}

// print_capabilities prints the capabilities each package's exported functions can reach, one
// "package caps" line each in name order ("main" for the program; the runtime is left out).
fn print_capabilities() {
	let names = []str{}
	let masks = []i64{}
	mut i = 0
	for i < len(prog_fns) {
		let f = prog_fns[i]
		let pos = f.pos
		if pos > 0 && ((pos >> 16) & 0xffffffff) != 0 && (pos >> 48) < len(files) && cap_runtime(f) == 0 && cap_exported(f) != 0 {
			mut name = file_pkgs[pos >> 48]
			if i64(byte_at(name, 0)) == 0 {
				name = "main"
			}
			let p = cap_pkg_of(f)
			if cast(i64, p) != 0 {
				name = p.path
			}
			mut k = 0
			for k < len(names) && names[k] != name {
				k = k + 1
			}
			if k == len(names) {
				names = append(names, name)
				masks = append(masks, 0)
			}
			masks[k] = masks[k] | cap_masks[i]
		}
		i = i + 1
	}
	let order = []i64{}
	i = 0
	for i < len(names) {
		order = append(order, i)
		mut j = len(order) - 1
		for j > 0 && names[order[j - 1]] > names[order[j]] {
			let t = order[j]
			order[j] = order[j - 1]
			order[j - 1] = t
			j = j - 1
		}
		i = i + 1
	}
	let out = buf_new()
	i = 0
	for i < len(order) {
		mut k = order[i]
		buf_str(out, names[k])
		if masks[k] != 0 {
			buf_byte(out, ' ')
			cap_list(cast([]u8, out), masks[k], " ")
		}
		buf_byte(out, '\n')
		i = i + 1
	}
	write_all(1, cast([]u8, out))
}
