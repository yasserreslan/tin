// Expression checking and lowering. chk(e, want) types e and rewrites it in place into
// core nodes; want is the type the context expects (it settles untyped constants and
// elided composite types). A node is checked once: N_TYPE marks it done.
//
// Strict rules for package code: operands must have identical types (constants adapt
// and must fit), conditions are bool, references are never nil (?T may be), faults must
// be handled, and every slice/string index is bounds-checked unless proven safe.
// Legacy fn code keeps its untyped word semantics.
fn chk(e Node, want i64) i64 {
	if e.type_ != 0 {
		return e.type_
	}
	mut t = chk_kind(cast(i64, e), want)
	if t == 0 {
		t = ty_int
	}
	e.type_ = t
	return t
}

fn chk_kind(e i64, want i64) i64 {
	let k = cast(Node, e).kind
	if k == EX_INT {
		return adapt_int(e, want)
	}
	if k == EX_FLOAT {
		if is_f32(cast(Ty, want)) != 0 {
			// An f32 constant: fold the rounding into the bits.
			cast(FloatLit, e).bits = round_f32_bits(cast(FloatLit, e).bits)
			return ty_f32
		}
		return ty_float
	}
	if k == EX_STR {
		if is_query_t(cast(Ty, want)) != 0 {
			return chk_query(e, want)
		}
		return ty_string
	}
	if k == EX_NIL {
		cast(Node, e).kind = EX_INT
		cast(IntLit, e).val = 0
		if nilable(want) != 0 {
			return want
		}
		err_code_at(cast(Node, e).pos, cstr("E233 UNTYPED_NIL"), cstr("nil needs an optional (?T) or fault type"))
		return ty_nil
	}
	if k == EX_IDENT {
		return chk_ident(e, want)
	}
	if k == EX_UNARY {
		if fold_const(e) != 0 {
			return adapt_int(e, want)
		}
		return chk_unary(e, want)
	}
	if k == EX_BINARY {
		if fold_const(e) != 0 {
			return adapt_int(e, want)
		}
		if fold_compare(e) != 0 {
			return ty_bool
		}
		return chk_binary(e, want)
	}
	if k == EX_CALL {
		return chk_call(e, want)
	}
	if k == EX_INDEX {
		return chk_index(e)
	}
	if k == EX_SLICE {
		return chk_slice(e)
	}
	if k == EX_SELECT {
		return chk_select(e, want)
	}
	if k == EX_COMPOSITE {
		return chk_composite(e, want)
	}
	if k == EX_FUNCLIT {
		return chk_funclit(e)
	}
	if k == EX_BOUNDARY {
		return chk_boundary(e)
	}
	if k == EX_MATCH {
		return chk_match(e, want)
	}
	if k == EX_UNIT {
		return chk_unit(e, want)
	}
	if k == EX_TYPE {
		err_code_at(cast(Node, e).pos, cstr("E235 NOT_A_VALUE"), cstr("type used as a value"))
		return ty_int
	}
	if k == EX_TRY {
		err_code_at(cast(Node, e).pos, cstr("E403 TRY_PLACEMENT"), cstr("try is only allowed as a statement, an initializer, an assignment or a return"))
		return ty_int
	}
	if k == EX_CATCH {
		err_code_at(cast(Node, e).pos, cstr("E401 CATCH_PLACEMENT"), cstr("catch is only allowed on a whole statement, initializer, assignment or return value"))
		return ty_int
	}
	if k == EX_INTERP {
		if is_query_t(cast(Ty, want)) != 0 {
			return chk_query(e, want)
		}
		return chk_interp(e, want)
	}
	if k == EX_MUTARG {
		err_code_at(cast(Node, e).pos, cstr("E705 MUT_ARG"), cstr("mut here does nothing: only an argument for a mut parameter takes mut"))
		return chk(cast(Node, cast(MutArg, e).x), want)
	}
	err_code_at(cast(Node, e).pos, cstr("E990 INTERNAL"), cstr("unexpected expression"))
	return ty_int
}

// int_fits reports whether constant v is representable in integer type t.
fn int_fits(v i64, t Ty, big i64) i64 {
	let w = t.width
	if w == 8 {
		return i64(t.signed != 0 || v >= 0 || big != 0)
	}
	if big != 0 {
		return 0
	}
	let bits = 8 * w
	if t.signed != 0 {
		let lim = 1 << (bits - 1)
		return i64(v >= -lim && v < lim)
	}
	return i64(v >= 0 && v < (1 << bits))
}

// fold_compare turns a comparison of two integer constants into a bool (unsigned when
// either is above 2^63-1).
fn fold_compare(e i64) i64 {
	let op = cast(Binary, e).op
	if !(streq(op, cstr("<")) != 0 || streq(op, cstr("<=")) != 0 || streq(op, cstr(">")) != 0 || streq(op, cstr(">=")) != 0 || streq(op, cstr("==")) != 0 || streq(op, cstr("!=")) != 0) {
		return 0
	}
	let l = cast(Binary, e).l
	let r = cast(Binary, e).r
	if fold_const(l) == 0 || fold_const(r) == 0 || cast(Node, l).kind != EX_INT || cast(Node, r).kind != EX_INT || cast(IntLit, l).char_ != 0 || cast(IntLit, r).char_ != 0 {
		return 0
	}
	mut a = cast(IntLit, l).val
	mut b = cast(IntLit, r).val
	if cast(IntLit, l).big != 0 || cast(IntLit, r).big != 0 {
		a = a ^ (1 << 63)
		b = b ^ (1 << 63)
	}
	replace_node(e, mk_int(cast(Node, e).pos, eval_binary(op, a, b), ty_bool))
	return 1
}

// fold_const evaluates an expression made only of integer literals, turning e into one literal.
fn fold_const(e i64) i64 {
	let k = cast(Node, e).kind
	if k == EX_INT {
		return 1
	}
	if k == EX_IDENT {
		// An untyped integer constant folds like the literal it stands for.
		let s = lookup_name(cast(IdentExpr, e).name)
		if cast(i64, s) == 0 || s.kind != SYM_CONST || s.done == 0 || s.expr != 0 || kind_of(cast(Ty, s.type_)) != K_UINT {
			return 0
		}
		mut big = s.big
		replace_node(e, mk_int(cast(Node, e).pos, s.val, 0))
		cast(IntLit, e).big = big
		return 1
	}
	mut v = 0
	if k == EX_UNARY {
		let op = cast(Unary, e).op
		let x = cast(IntLit, cast(Unary, e).x)
		if !(streq(op, cstr("-")) != 0 || streq(op, cstr("^")) != 0 || streq(op, cstr("+")) != 0) || fold_const(cast(i64, x)) == 0 {
			return 0
		}
		v = x.val
		if streq(op, cstr("-")) != 0 {
			v = 0 - v
		} else if streq(op, cstr("^")) != 0 {
			v = ~v
		}
	} else if k == EX_BINARY {
		let op = cast(Binary, e).op
		let l = cast(IntLit, cast(Binary, e).l)
		let r = cast(IntLit, cast(Binary, e).r)
		if fold_const(cast(i64, l)) == 0 || fold_const(cast(i64, r)) == 0 {
			return 0
		}
		let a = l.val
		let b = r.val
		let ub = i64(cast(IntLit, l).big != 0 || cast(IntLit, r).big != 0)
		if ub != 0 && (streq(op, cstr(">>")) != 0 || streq(op, cstr("/")) != 0 || streq(op, cstr("%")) != 0) {
			if (streq(op, cstr("/")) != 0 || streq(op, cstr("%")) != 0) && b == 0 {
				return 0
			}
			v = eval_unsigned(op, a, b)
			cast(Node, e).kind = EX_INT
			cast(IntLit, e).val = v
			cast(IntLit, e).w3 = 0
			cast(IntLit, e).w4 = 0
			cast(IntLit, e).char_ = 0
			cast(IntLit, e).big = i64(v < 0)
			return 1
		}
		if streq(op, cstr("+")) != 0 {
			v = a + b
		} else if streq(op, cstr("-")) != 0 {
			v = a - b
		} else if streq(op, cstr("*")) != 0 {
			v = a * b
		} else if (streq(op, cstr("/")) != 0 || streq(op, cstr("%")) != 0) && b != 0 {
			if streq(op, cstr("/")) != 0 {
				v = a / b
			} else {
				v = a % b
			}
		} else if streq(op, cstr("&")) != 0 {
			v = a & b
		} else if streq(op, cstr("|")) != 0 {
			v = a | b
		} else if streq(op, cstr("^")) != 0 {
			v = a ^ b
		} else if streq(op, cstr("<<")) != 0 && b >= 0 && b < 64 {
			v = a << b
		} else if streq(op, cstr(">>")) != 0 && b >= 0 && b < 64 {
			v = a >> b
		} else {
			return 0
		}
	} else {
		return 0
	}
	mut big = 0
	if k == EX_BINARY {
		big = i64((cast(IntLit, cast(Binary, e).l).big != 0 || cast(IntLit, cast(Binary, e).r).big != 0) && v < 0)
	}
	cast(Node, e).kind = EX_INT
	cast(IntLit, e).val = v
	cast(IntLit, e).w3 = 0
	cast(IntLit, e).w4 = 0
	cast(IntLit, e).char_ = 0
	cast(IntLit, e).big = big
	return 1
}

// adapt_int gives an integer literal the expected type, checking that it fits.
fn adapt_int(e i64, want_in i64) i64 {
	mut want = want_in
	if want == 0 {
		want = ty_int
	}
	if is_float_t(want) != 0 {
		cast(Node, e).kind = EX_FLOAT
		cast(FloatLit, e).bits = int_to_float_bits(cast(IntLit, e).val)
		if is_f32(cast(Ty, want)) != 0 {
			cast(FloatLit, e).bits = round_f32_bits(cast(FloatLit, e).bits)
			return ty_f32
		}
		return ty_float
	}
	if kind_of(cast(Ty, want)) == K_INT {
		if int_fits(cast(IntLit, e).val, cast(Ty, want), cast(IntLit, e).big) == 0 {
			let m = err_code(cast(Node, e).pos, cstr("E223 CONST_OVERFLOW"))
			buf_str(m, cstr("constant "))
			buf_int(m, cast(IntLit, e).val)
			buf_str(m, cstr(" overflows "))
			type_name(cast([]u8, m), cast(Ty, want))
			err_end(cast([]u8, m))
		}
		return want
	}
	return ty_uint
}

fn chk_ident(e i64, want i64) i64 {
	let name = cast(IdentExpr, e).name
	if streq(name, cstr("true")) != 0 || streq(name, cstr("false")) != 0 {
		replace_node(e, mk_int(cast(Node, e).pos, streq(name, cstr("true")), 0))
		return ty_bool
	}
	let s = lookup_name(name)
	if cast(i64, s) == 0 {
		if import_pkg(name) != 0 {
			err_code_quoted(cast(Node, e).pos, cstr("E235 NOT_A_VALUE"), cstr("use of package "), name, cstr(" without a selector"))
		} else {
			let u = err_code(cast(Node, e).pos, cstr("E103 UNDEFINED"))
			buf_str(u, cstr("undefined: "))
			buf_str(u, name)
			err_end(cast([]u8, u))
		}
		return ty_int
	}
	return use_sym(e, cast(Sym, s), want)
}

// starts_select reports whether name is one of the rt_select_ helpers select lowers to.
fn starts_select(name i64) i64 {
	let p = cstr("rt_select_")
	mut i = 0
	for i64(load8(p + i)) != 0 {
		if i64(load8(name + i)) != i64(load8(p + i)) {
			return 0
		}
		i = i + 1
	}
	return 1
}

// runtime_use rejects user code naming a function only the standard library may use: a C
// extern or one of the runtime's own (the trusted files outside any package).
fn runtime_use(pos i64, f Fn, name i64) {
	if ck_trusted != 0 || streq(name, cstr("rt_pool_used")) != 0 || streq(name, cstr("rt_once")) != 0 || streq(name, cstr("rt_scope_open")) != 0 || streq(name, cstr("rt_scope_close")) != 0 || streq(name, cstr("rt_detach")) != 0 || (i64(load8(name)) == 'r' && starts_select(name) != 0) {
		return
	}
	if f.extern_ != 0 || (file_trusted[f.file] != 0 && i64(load8(file_pkgs[f.file])) == 0) {
		err_code_quoted(pos, cstr("E802 RUNTIME_INTERNAL"), cstr(""), name, cstr(" is internal to the runtime"))
	}
}

// use_sym turns a resolved name into a variable read, a constant or a function value.
fn use_sym(e i64, s Sym, want i64) i64 {
	let k = s.kind
	if k == SYM_LOCAL && s.stale != 0 {
		alias_read(cast(Node, e).pos, s)
	}
	if k == SYM_FUNC {
		let f = cast(Fn, s.fn_)
		runtime_use(cast(Node, e).pos, f, cast(IdentExpr, e).name)
		cast(Node, e).kind = EX_FUNCREF
		cast(FuncRef, e).fn_ = cast(i64, f)
		return f.type_
	}
	if k == SYM_CONST {
		if s.done == 0 {
			err_code_quoted(cast(Node, e).pos, cstr("E130 INIT_ORDER"), cstr("constant "), cast(IdentExpr, e).name, cstr(" used before its definition"))
			return ty_int
		}
		if s.expr != 0 {
			replace_node(e, expr_clone(s.expr))
			return s.type_
		}
		let v = s.val
		let t = s.type_
		replace_node(e, mk_int(cast(Node, e).pos, v, 0))
		cast(IdentExpr, e).ref = cast(i64, s)
		cast(IntLit, e).big = s.big
		if kind_of(cast(Ty, t)) == K_UINT {
			return chk_kind(e, want)
		}
		if is_float_t(t) != 0 {
			cast(Node, e).kind = EX_FLOAT
			cast(FloatLit, e).bits = int_to_float_bits(v)
		}
		return t
	}
	if s.captured != 0 {
		let env_ref = sym_ref_node(cast(Node, e).pos, cast(Sym, cast(Fn, ck_fn).env_sym))
		let cell_addr = mk_mem(cast(Node, e).pos, env_ref, 0, 0, 8 * (2 + s.cap_idx), ty_int)
		let val = mk_mem(cast(Node, e).pos, cell_addr, 0, 0, 0, s.type_)
		replace_node(e, val)
		return s.type_
	}
	if s.cell != 0 {
		let cell_ref = sym_ref_node(cast(Node, e).pos, cast(Sym, s.cell_sym))
		let val = mk_mem(cast(Node, e).pos, cell_ref, 0, 0, 0, s.type_)
		replace_node(e, val)
		return s.type_
	}
	cast(IdentExpr, e).ref = cast(i64, s)
	s.reads = s.reads + 1
	if s.type_ == 0 {
		return ty_int
	}
	return s.type_
}

fn chk_unary(e i64, want i64) i64 {
	let op = cast(Unary, e).op
	let x = cast(Unary, e).x
	if streq(op, cstr("&")) != 0 {
		if cast(Node, x).kind == EX_COMPOSITE {
			let ct = chk(cast(Node, x), want)
			replace_node(e, x)
			return ct
		}
		if cast(Node, x).kind != EX_IDENT {
			err_code_at(cast(Node, e).pos, cstr("E803 ADDRESS_OF"), cstr("'&' needs a variable name"))
			chk(cast(Node, x), 0)
			return ty_int
		}
		let xname = cast(IdentExpr, x).name
		let xt = chk(cast(Node, x), 0)
		if cast(IdentExpr, x).ref != 0 && cast(Sym, cast(IdentExpr, x).ref).captured != 0 {
			let s = cast(Sym, cast(IdentExpr, x).ref)
			let env_ref = sym_ref_node(cast(Node, e).pos, cast(Sym, cast(Fn, ck_fn).env_sym))
			let cell_addr = mk_mem(cast(Node, e).pos, env_ref, 0, 0, 8 * (2 + s.cap_idx), ty_int)
			replace_node(e, cell_addr)
			return ty_int
		}
		if cast(IdentExpr, x).ref != 0 && cast(Sym, cast(IdentExpr, x).ref).cell != 0 {
			let s = cast(Sym, cast(IdentExpr, x).ref)
			replace_node(e, sym_ref_node(cast(Node, e).pos, cast(Sym, s.cell_sym)))
			return ty_int
		}
		if cast(Node, x).kind != EX_IDENT || cast(IdentExpr, x).ref == 0 {
			err_code_quoted(cast(Node, e).pos, cstr("E803 ADDRESS_OF"), cstr("cannot take the address of constant "), xname, cstr(""))
			return ty_int
		}
		if kind_of(cast(Ty, xt)) == K_STRUCT {
			replace_node(e, x)
			return xt
		}
		if ck_trusted == 0 {
			err_code_at(cast(Node, e).pos, cstr("E801 TRUSTED_ONLY"), cstr("'&' on a variable is only allowed in the standard library"))
		}
		return ty_int
	}
	if streq(op, cstr("...")) != 0 {
		err_code_at(cast(Node, e).pos, cstr("E211 VARIADIC_ARG"), cstr("... is only allowed on the last argument of a call"))
		return ty_int
	}
	let t = chk(cast(Node, x), want)
	if streq(op, cstr("!")) != 0 {
		if is_bool_t(t) == 0 {
			err_code_type(cast(Node, e).pos, cstr("E236 OPERATOR"), cstr("operator ! needs a bool, not "), t, cstr(""))
		}
		if is_secret(cast(Ty, t)) != 0 {
			return t
		}
		return ty_bool
	}
	if streq(op, cstr("-")) != 0 {
		if is_numeric_t(t) == 0 {
			err_code_type(cast(Node, e).pos, cstr("E236 OPERATOR"), cstr("operator - needs a number, not "), t, cstr(""))
		}
		if cast(Node, x).kind == EX_FLOAT {
			replace_node(e, x)
			cast(FloatLit, e).bits = cast(FloatLit, e).bits ^ (1 << 63)
			cast(Node, e).type_ = 0
			return ty_float
		}
		if cast(Node, x).kind == EX_INT && (kind_of(cast(Ty, t)) == K_UINT) {
			replace_node(e, mk_int(cast(Node, e).pos, -cast(IntLit, x).val, 0))
			return t
		}
		return t
	}
	if is_integer_t(t) == 0 {
		err_code_type(cast(Node, e).pos, cstr("E236 OPERATOR"), cstr("operator ^ needs an integer, not "), t, cstr(""))
	}
	if cast(Node, x).kind == EX_INT && kind_of(cast(Ty, t)) == K_UINT {
		replace_node(e, mk_int(cast(Node, e).pos, ~cast(IntLit, x).val, 0))
		return ty_uint
	}
	return t
}

fn is_cmp_op(op i64) i64 {
	return i64(streq(op, cstr("==")) != 0 || streq(op, cstr("!=")) != 0 || streq(op, cstr("<")) != 0 || streq(op, cstr("<=")) != 0 || streq(op, cstr(">")) != 0 || streq(op, cstr(">=")) != 0)
}

fn is_untyped_lit(e i64) i64 {
	let k = cast(Node, e).kind
	return i64(k == EX_INT || k == EX_NIL || k == EX_FLOAT || (k == EX_UNARY && is_untyped_lit(cast(Unary, e).x) != 0) || (k == EX_BINARY && is_untyped_lit(cast(Binary, e).l) != 0 && is_untyped_lit(cast(Binary, e).r) != 0))
}

// unify checks both operands of a binary operator and returns their common type:
// identical types, or an untyped constant adapted to the other side.
fn unify(l Node, r i64, want i64) i64 {
	mut lt = 0
	mut rt = 0
	if is_untyped_lit(cast(i64, l)) == 0 || is_untyped_lit(r) != 0 {
		lt = chk(l, want)
		rt = chk(cast(Node, r), default_or(lt, want))
	} else {
		rt = chk(cast(Node, r), want)
		lt = chk(l, default_or(rt, want))
	}
	if kind_of(cast(Ty, lt)) == K_UINT && is_untyped(rt) == 0 {
		lt = reconvert(l, rt)
	} else if kind_of(cast(Ty, rt)) == K_UINT && is_untyped(lt) == 0 {
		rt = reconvert(cast(Node, r), lt)
	}
	if kind_of(cast(Ty, lt)) == K_NIL && nilable(rt) != 0 {
		reconvert(l, rt)
		return rt
	}
	if kind_of(cast(Ty, rt)) == K_NIL && nilable(lt) != 0 {
		reconvert(cast(Node, r), lt)
		return lt
	}
	if kind_of(cast(Ty, lt)) == K_UINT && kind_of(cast(Ty, rt)) == K_UINT {
		return ty_uint
	}
	// A bounded operand counts as its unbounded type: the result may be longer (#240).
	lt = unbounded(cast(Ty, lt))
	rt = unbounded(cast(Ty, rt))
	// An operation on a secret and a plain value of the same type is secret.
	if lt != rt && secret_join(lt, rt) != 0 {
		return secret_join(lt, rt)
	}
	if lt != rt {
		err_code_types(l.pos, cstr("E230 TYPE_MISMATCH"), cstr("mismatched types "), lt, cstr(" and "), rt)
	}
	return lt
}

fn default_or(t i64, want i64) i64 {
	if is_untyped(t) != 0 {
		return want
	}
	return t
}

// reconvert gives an untyped constant node the concrete type to.
fn reconvert(e Node, to i64) i64 {
	let k = kind_of(cast(Ty, e.type_))
	if k == K_UINT {
		if e.kind == EX_INT {
			e.type_ = 0
			let t = adapt_int(cast(i64, e), to)
			e.type_ = t
			return t
		}
		retype_untyped(cast(i64, e), to)
		return to
	}
	if k == K_NIL && nilable(to) != 0 {
		e.type_ = to
		return to
	}
	return e.type_
}

fn retype_untyped(e i64, to i64) {
	if kind_of(cast(Ty, cast(Node, e).type_)) != K_UINT {
		return
	}
	cast(Node, e).type_ = to
	let k = cast(Node, e).kind
	if k == EX_UNARY {
		retype_untyped(cast(Unary, e).x, to)
	} else if k == EX_BINARY && is_cmp_op(cast(Binary, e).op) == 0 {
		retype_untyped(cast(Binary, e).l, to)
		retype_untyped(cast(Binary, e).r, to)
	}
}

fn chk_binary(e i64, want i64) i64 {
	let op = cast(Binary, e).op
	let l = cast(Binary, e).l
	let r = cast(Binary, e).r
	let pos = cast(Node, e).pos
	if streq(op, cstr("$is")) != 0 {
		// A case of switch err { ... }: fault.Is, walking the chain and comparing identity.
		let ft = unify(cast(Node, l), r, ty_error)
		if kind_of(cast(Ty, ft)) == K_ERROR {
			replace_node(e, rt_call(pos, cstr("rt_fault_is"), args2(l, r), ty_bool))
			cast(Node, e).type_ = 0
		}
		return ty_bool
	}
	if streq(op, cstr("&&")) != 0 || streq(op, cstr("||")) != 0 {
		let a = chk(cast(Node, l), ty_bool)
		// x != nil && x.f: the right side sees x narrowed.
		mut narrowed = cast([]i64, 0)
		if streq(op, cstr("&&")) != 0 {
			narrowed = narrow_begin(l, 1)
		}
		let b = chk(cast(Node, r), ty_bool)
		narrow_end(cast([]Sym, narrowed))
		if is_bool_t(a) == 0 || is_bool_t(b) == 0 {
			err_code_at(pos, cstr("E236 OPERATOR"), cstr("operands of && and || must be bool"))
		}
		return ty_bool
	}
	if streq(op, cstr("<<")) != 0 || streq(op, cstr(">>")) != 0 {
		let st = chk(cast(Node, l), want)
		let ct = chk(cast(Node, r), ty_int)
		if is_integer_t(st) == 0 {
			err_code_type(pos, cstr("E236 OPERATOR"), cstr("cannot shift "), st, cstr(""))
		}
		if is_integer_t(ct) == 0 {
			err_code_type(pos, cstr("E236 OPERATOR"), cstr("shift count must be an integer, not "), ct, cstr(""))
		}
		if kind_of(cast(Ty, ct)) == K_UINT {
			reconvert(cast(Node, r), ty_int)
		}
		if cast(Node, l).kind == EX_INT && cast(Node, r).kind == EX_INT && kind_of(cast(Ty, st)) == K_UINT {
			replace_node(e, mk_int(pos, eval_binary(op, cast(IntLit, l).val, cast(IntLit, r).val), 0))
			return ty_uint
		}
		if is_secret(cast(Ty, ct)) != 0 && is_untyped(st) == 0 {
			return secret_of(cast(Ty, st))
		}
		return st
	}
	let t = cast(Ty, unify(cast(Node, l), r, want))
	if is_cmp_op(op) != 0 && secret_compare_error(pos, op, cast(Node, l).type_, cast(Node, r).type_) != 0 {
		return ty_bool
	}
	if is_cmp_op(op) != 0 && kind_of(t) == K_DYN {
		err_code_at(pos, cstr("E237 COMPARE"), cstr("cannot compare dyn values: use a method on the shape (?dyn compares against nil)"))
		return ty_bool
	}
	if is_cmp_op(op) != 0 {
		let ordered = i64(streq(op, cstr("==")) == 0 && streq(op, cstr("!=")) == 0)
		if ordered == 0 && kind_of(t) == K_STRUCT {
			return lower_enum_eq(cast(Node, e), op, l, r, cast(i64, t))
		}
		if kind_of(t) == K_STRING {
			lower_str_cmp(cast(Node, e), op, l, r)
			return ty_bool
		}
		if cast(Node, l).kind == EX_INT && cast(Node, r).kind == EX_INT && kind_of(t) == K_UINT {
			replace_node(e, mk_int(pos, eval_binary(op, cast(IntLit, l).val, cast(IntLit, r).val), 0))
			return ty_bool
		}
		if ordered != 0 && is_numeric_t(cast(i64, t)) == 0 {
			err_code_type(pos, cstr("E236 OPERATOR"), cstr("cannot order values of type "), cast(i64, t), cstr(""))
		}
		if kind_of(t) == K_UINT {
			reconvert(cast(Node, l), ty_int)
			reconvert(cast(Node, r), ty_int)
		}
		return ty_bool
	}
	let k = kind_of(t)
	if k == K_STRING {
		if streq(op, cstr("+")) == 0 {
			err_code_quoted(pos, cstr("E236 OPERATOR"), cstr("operator "), op, cstr(" is not defined on str"))
		}
		replace_node(e, rt_call(pos, cstr("rt_str_cat"), args2(l, r), ty_string))
		cast(Node, e).type_ = 0
		if is_secret(t) != 0 {
			return cast(i64, t)
		}
		return ty_string
	}
	if is_numeric_t(cast(i64, t)) == 0 {
		err_code_type(pos, cstr("E236 OPERATOR"), cstr("arithmetic on "), cast(i64, t), cstr(""))
	}
	if is_float_t(cast(i64, t)) != 0 && (streq(op, cstr("%")) != 0 || streq(op, cstr("&")) != 0 || streq(op, cstr("|")) != 0 || streq(op, cstr("^")) != 0) {
		err_code_quoted(pos, cstr("E236 OPERATOR"), cstr("operator "), op, cstr(" is not defined on floats"))
	}
	if k == K_UINT && cast(Node, l).kind == EX_INT && cast(Node, r).kind == EX_INT {
		if (streq(op, cstr("/")) != 0 || streq(op, cstr("%")) != 0) && cast(IntLit, r).val == 0 {
			err_code_at(pos, cstr("E222 DIVISION_BY_ZERO"), cstr("division by zero"))
			return ty_uint
		}
		replace_node(e, mk_int(pos, eval_binary(op, cast(IntLit, l).val, cast(IntLit, r).val), 0))
		return ty_uint
	}
	if k == K_INT && is_const_zero(r) != 0 && (streq(op, cstr("/")) != 0 || streq(op, cstr("%")) != 0) {
		err_code_at(pos, cstr("E222 DIVISION_BY_ZERO"), cstr("division by zero"))
	}
	if is_f32(t) != 0 {
		// f32 arithmetic is f64 arithmetic rounded to f32 after each step (exact for + - * /).
		let inner = cast(Node, node_copy(e))
		inner.type_ = cast(i64, t)
		replace_node(e, mk_conv(pos, cast(i64, inner), CV_ROUND32, cast(i64, t)))
	}
	return cast(i64, t)
}

// enum_incomparable returns a payload type of enum t without value equality (slices, maps,
// structs, funcs, optionals), or 0 when every variant compares by value.
fn enum_incomparable(t Ty) i64 {
	return value_incomparable(t, 0)
}

// value_incomparable is the first type inside the struct or enum t that has no value equality
// (a slice, map, function, dyn value, optional), or 0. Numbers, bool, str and faults compare;
// structs and enums compare field by field (depth bounds a recursive enum).
fn value_incomparable(t Ty, depth i64) i64 {
	if depth > 6 {
		return 0
	}
	let fs = cast([]i64, t.fields)
	mut i = 0
	if cast(i64, t.enum_) != 0 {
		i = 1
	}
	for i < len(fs) {
		let ft = cast(Ty, field_type(t, i))
		let k = kind_of(ft)
		if k == K_STRUCT {
			if cast(i64, ft) != cast(i64, t) {
				let inner = value_incomparable(ft, depth + 1)
				if inner != 0 {
					return inner
				}
			}
		} else if !(is_integer_t(cast(i64, ft)) != 0 || is_float_t(cast(i64, ft)) != 0 || k == K_BOOL || k == K_STRING || k == K_ERROR) {
			return cast(i64, ft)
		}
		i = i + 1
	}
	return 0
}

shared mut enum_eq_types []i64
shared mut enum_eq_fns []i64

// lower_enum_eq compares two enum or struct values by value (same variant and equal fields, or
// equal fields) through a generated eq function per type, so recursive enums compare without
// expanding forever.
fn lower_enum_eq(e Node, op i64, l i64, r i64, t i64) i64 {
	let pos = e.pos
	let bad = value_incomparable(cast(Ty, t), 0)
	if bad != 0 {
		let u = err_code(pos, cstr("E237 COMPARE"))
		buf_str(u, cstr("cannot compare "))
		type_name(u, cast(Ty, t))
		if cast(i64, cast(Ty, t).enum_) != 0 {
			buf_str(u, cstr(" values: a variant holds "))
		} else {
			buf_str(u, cstr(" values: a field holds "))
		}
		type_name(u, cast(Ty, bad))
		buf_str(u, cstr(", which has no value equality"))
		err_end(cast([]u8, u))
		return ty_bool
	}
	mut x = call_fn(pos, cast(Fn, enum_eq_fn(cast(Ty, t))), args2(l, r), ty_bool)
	if streq(op, cstr("!=")) != 0 {
		let n = node_new(EX_UNARY, pos)
		cast(Unary, n).op = cstr("!")
		cast(Unary, n).x = cast(i64, x)
		cast(Node, n).type_ = ty_bool
		x = cast(Node, n)
	}
	replace_node(cast(i64, e), cast(i64, x))
	return ty_bool
}

fn enum_eq_fn(t Ty) i64 {
	if cast(i64, enum_eq_types) == 0 {
		enum_eq_types = []i64{}
		enum_eq_fns = []i64{}
	}
	mut i = 0
	for i < len(enum_eq_types) {
		if cast(i64, cast(Ty, cast([]i64, enum_eq_types)[i])) == cast(i64, t) {
			return enum_eq_fns[i]
		}
		i = i + 1
	}
	let names = []i64{}
	names = append(names, cstr("a"))
	names = append(names, cstr("b"))
	let types = []i64{}
	types = append(types, cast(i64, t))
	types = append(types, cast(i64, t))
	let rts = []i64{}
	rts = append(rts, ty_bool)
	let f = lifted_fn(cstr("eq"), names, cast([]i64, types), cast(i64, rts))
	mut vs1 = cast([]i64, enum_eq_types)
	vs1 = append(vs1, cast(i64, t))
	enum_eq_fns = append(enum_eq_fns, cast(i64, f))
	let saved_fn = ck_fn
	ck_fn = cast(Fn, f)
	let pos = 0
	let ls = cast([]i64, f.locals)[0]
	let rs = cast([]i64, f.locals)[1]
	let tag0 = field_offset(t, 0)
	if cast(i64, t.enum_) == 0 {
		// A struct is equal when every field is.
		mut sx = mk_int(pos, 1, ty_bool)
		mut sf = 0
		for sf < len(cast([]i64, t.fields)) {
			let sft = field_type(t, sf)
			let sa = mk_mem(pos, sym_ref_node(pos, cast(Sym, ls)), 0, 0, field_offset(t, sf), sft)
			let sb = mk_mem(pos, sym_ref_node(pos, cast(Sym, rs)), 0, 0, field_offset(t, sf), sft)
			let sc = binary_new(pos, cstr("=="), sa, sb)
			chk(cast(Node, sc), ty_bool)
			if sf == 0 {
				sx = sc
			} else {
				sx = mk_bin(pos, cstr("&&"), sx, sc, ty_bool)
			}
			sf = sf + 1
		}
		let sret = cast(ReturnStmt, node_new(ST_RETURN, pos))
		sret.value = sx
		mut vs1 = cast(Block, f.body).stmts
		vs1 = append(vs1, cast(i64, sret))
		ck_fn = saved_fn
		return cast(i64, f)
	}
	mut x = mk_bin(pos, cstr("=="), mk_mem(pos, sym_ref_node(pos, cast(Sym, ls)), 0, 0, tag0, ty_int), mk_mem(pos, sym_ref_node(pos, cast(Sym, rs)), 0, 0, tag0, ty_int), ty_bool)
	let vs = t.enum_
	mut vi = 0
	for vi < len(vs) {
		let v = cast([]i64, vs[vi])
		mut fe = 0
		mut k = 0
		for k < v[2] {
			let fi = v[1] + k
			let ft = field_type(t, fi)
			let a = mk_mem(pos, sym_ref_node(pos, cast(Sym, ls)), 0, 0, field_offset(t, fi), ft)
			let b = mk_mem(pos, sym_ref_node(pos, cast(Sym, rs)), 0, 0, field_offset(t, fi), ft)
			let c = binary_new(pos, cstr("=="), a, b)
			chk(cast(Node, c), ty_bool)
			if fe != 0 {
				fe = mk_bin(pos, cstr("&&"), fe, c, ty_bool)
			} else {
				fe = c
			}
			k = k + 1
		}
		if fe != 0 {
			let other = mk_bin(pos, cstr("!="), mk_mem(pos, sym_ref_node(pos, cast(Sym, ls)), 0, 0, tag0, ty_int), mk_int(pos, vi, ty_int), ty_bool)
			x = mk_bin(pos, cstr("&&"), x, mk_bin(pos, cstr("||"), other, fe, ty_bool), ty_bool)
		}
		vi = vi + 1
	}
	let ret = cast(ReturnStmt, node_new(ST_RETURN, pos))
	ret.value = x
	mut vs2 = cast(Block, f.body).stmts
	vs2 = append(vs2, cast(i64, ret))
	ck_fn = saved_fn
	return cast(i64, f)
}

// elem_bits is value v as the bits a slice element of type et holds (4 bytes for f32).
fn elem_bits(v Node, et i64) i64 {
	if is_f32(cast(Ty, et)) != 0 {
		return mk_conv(v.pos, cast(i64, v), CV_F2BITS32, ty_int)
	}
	return to_bits(v)
}

fn is_const_zero(e i64) i64 {
	return i64(cast(Node, e).kind == EX_INT && cast(IntLit, e).val == 0)
}

fn lower_str_cmp(e Node, op i64, l i64, r i64) {
	let pos = e.pos
	if streq(op, cstr("==")) != 0 || streq(op, cstr("!=")) != 0 {
		mut eq = rt_call(pos, cstr("rt_str_eq"), args2(l, r), ty_bool)
		if streq(op, cstr("!=")) != 0 {
			let n = node_new(EX_UNARY, pos)
			cast(Unary, n).op = cstr("!")
			cast(Unary, n).x = eq
			cast(Node, n).type_ = ty_bool
			eq = n
		}
		replace_node(cast(i64, e), eq)
		e.type_ = 0
		return
	}
	replace_node(cast(i64, e), mk_bin(pos, op, rt_call(pos, cstr("rt_str_cmp"), args2(l, r), ty_int), mk_int(pos, 0, ty_int), 0))
}

// ---- memory access ----
// mk_mem is a load or store of type t at base + index*scale + off.
fn mk_mem(pos i64, base i64, index i64, scale i64, off i64, t i64) i64 {
	let n = node_new(EX_MEM, pos)
	cast(MemExpr, n).base = base
	cast(MemExpr, n).index = index
	cast(MemExpr, n).scale = scale
	cast(MemExpr, n).off = off
	cast(Node, n).type_ = t
	return n
}

// ---- map keys: struct and enum keys are encoded to bytes, so they compare by value ----
fn key_composite(t i64) i64 {
	return i64(kind_of(cast(Ty, t)) == K_STRUCT)
}

// map_str_keys reports whether a map with key type kt keeps str keys inside.
fn map_str_keys(kt i64) i64 {
	return i64(kind_of(cast(Ty, kt)) == K_STRING || key_composite(kt) != 0)
}

// key_in is key e as the word the runtime stores (bits, a str, or an encoded struct/enum).
fn key_in(e Node, kt i64) i64 {
	if key_composite(kt) == 0 {
		return to_bits(e)
	}
	let pos = e.pos
	let stmts = []i64{}
	let b = temp(pos, rt_call(pos, cstr("rt_kb_new"), cast(i64, []i64{}), ty_int), ty_int)
	stmts = append(stmts, cast(i64, b))
	stmts = append(stmts, assign_stmt(pos, sym_ref_node(pos, cast(Sym, b.sym)), cast(i64, call_fn(pos, cast(Fn, key_enc_fn(cast(Ty, kt))), args2(sym_ref_node(pos, cast(Sym, b.sym)), cast(i64, e)), ty_int))))
	return mk_seq(pos, cast(i64, stmts), rt_call(pos, cstr("rt_kb_done"), args1(sym_ref_node(pos, cast(Sym, b.sym))), ty_string), ty_string)
}

// key_out turns a stored key word back into a key of type kt.
fn key_out(e Node, kt i64) i64 {
	if key_composite(kt) == 0 {
		return from_bits(e, kt)
	}
	let pos = e.pos
	let stmts = []i64{}
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, cstr("rt_kd_begin"), cast(i64, []i64{}), ty_void))))
	return mk_seq(pos, cast(i64, stmts), cast(i64, call_fn(pos, cast(Fn, key_dec_fn(cast(Ty, kt))), args1(mk_conv(pos, cast(i64, e), CV_SAME, ty_string)), kt)), kt)
}

// map_set_call stores v under key k in map m.
fn map_set_call(pos i64, m i64, k i64, v i64, kt i64) i64 {
	if key_composite(kt) != 0 {
		return rt_call(pos, cstr("rt_map_setk"), args3(m, key_in(cast(Node, k), kt), to_bits(cast(Node, v))), ty_void)
	}
	// dup: the caller keeps no reference to the key it passes.
	return rt_call(pos, cstr("rt_map_set"), args4(m, to_bits(cast(Node, k)), to_bits(cast(Node, v)), mk_int(pos, 1, ty_int)), ty_void)
}

// map_make_call makes a map of type t (#176): counted sides carry their drops, so the
// runtime counts the entries of a long-lived map by itself (its m[9] decides).
fn map_make_call(pos i64, t Ty) i64 {
	let counted = rc_map_bits(t)
	let isstr = mk_int(pos, map_str_keys(t.key), ty_int)
	if counted == 0 {
		return rt_call(pos, cstr("rt_map_make"), args1(isstr), cast(i64, t))
	}
	return rt_call(pos, cstr("rt_map_make_rc"), args3(isstr, fn_ref_node(pos, cast(Fn, rc_map_drop(t))), mk_int(pos, counted, ty_int)), cast(i64, t))
}

// key_valid reports whether t can be a map key: str, numbers, bool, or structs and enums
// made of those (compared by value).
fn key_valid(t Ty, path []Ty) i64 {
	let k = kind_of(t)
	if k == K_STRING || k == K_BOOL || is_integer_t(cast(i64, t)) != 0 || is_float_t(cast(i64, t)) != 0 {
		return 1
	}
	if k != K_STRUCT {
		return 0
	}
	mut i = 0
	for i < len(path) {
		if cast(i64, path[i]) == cast(i64, t) {
			return i64(cast(i64, t.enum_) != 0)
		}
		i = i + 1
	}
	path = append(path, cast(Ty, t))
	mut ok = 1
	mut fi = 0
	for fi < len(t.fields) && ok != 0 {
		ok = key_valid(cast(Ty, field_type(t, fi)), path)
		fi = fi + 1
	}
	slice_truncate(path, len(path) - 1)
	return ok
}

shared mut key_enc_types []i64
shared mut key_enc_fns []i64
shared mut key_dec_types []i64
shared mut key_dec_fns []i64

// key_enc_fn returns keyenc$N(b, x) b: x's bytes appended to byte slice b.
fn key_enc_fn(t Ty) i64 {
	if cast(i64, key_enc_types) == 0 {
		key_enc_types = []i64{}
		key_enc_fns = []i64{}
	}
	mut i = 0
	for i < len(key_enc_types) {
		if cast(i64, cast(Ty, cast([]i64, key_enc_types)[i])) == cast(i64, t) {
			return key_enc_fns[i]
		}
		i = i + 1
	}
	let names = []i64{}
	names = append(names, cstr("b"))
	names = append(names, cstr("x"))
	let types = []i64{}
	types = append(types, ty_int)
	types = append(types, cast(i64, t))
	let rts = []i64{}
	rts = append(rts, ty_int)
	let f = lifted_fn(cstr("keyenc"), names, cast([]i64, types), cast(i64, rts))
	mut vs1 = cast([]i64, key_enc_types)
	vs1 = append(vs1, cast(i64, t))
	key_enc_fns = append(key_enc_fns, cast(i64, f))
	let saved_fn = ck_fn
	ck_fn = cast(Fn, f)
	let pos = 0
	let b = cast([]i64, f.locals)[0]
	let x = cast([]i64, f.locals)[1]
	let body = cast(Block, f.body).stmts
	if cast(i64, t.enum_) != 0 {
		key_enc_field(pos, body, b, x, cast(i64, t), 0)
		let vs = t.enum_
		mut vi = 0
		for vi < len(vs) {
			let v = cast([]i64, vs[vi])
			let ifs = cast(IfStmt, node_new(ST_IF, pos))
			ifs.cond = mk_bin(pos, cstr("=="), mk_mem(pos, sym_ref_node(pos, cast(Sym, x)), 0, 0, field_offset(t, 0), ty_int), mk_int(pos, vi, ty_int), ty_bool)
			ifs.then = empty_block(pos)
			mut k = 0
			for k < v[2] {
				key_enc_field(pos, cast(Block, ifs.then).stmts, b, x, cast(i64, t), v[1] + k)
				k = k + 1
			}
			body = append(body, cast(i64, ifs))
			vi = vi + 1
		}
	} else {
		mut fi = 0
		for fi < len(t.fields) {
			key_enc_field(pos, body, b, x, cast(i64, t), fi)
			fi = fi + 1
		}
	}
	let ret = cast(ReturnStmt, node_new(ST_RETURN, pos))
	ret.value = sym_ref_node(pos, cast(Sym, b))
	body = append(body, cast(i64, ret))
	ck_fn = saved_fn
	return cast(i64, f)
}

// key_enc_field appends `b = <field fi of x, encoded>` to body.
fn key_enc_field(pos i64, body []i64, b i64, x i64, t i64, fi i64) {
	let ft = field_type(cast(Ty, t), fi)
	let fv = mk_mem(pos, sym_ref_node(pos, cast(Sym, x)), 0, 0, field_offset(cast(Ty, t), fi), ft)
	let k = kind_of(cast(Ty, ft))
	mut nb = 0
	if k == K_BOOL {
		nb = rt_call(pos, cstr("rt_kb_word"), args2(sym_ref_node(pos, cast(Sym, b)), mk_conv(pos, fv, CV_SAME, ty_int)), ty_int)
	} else if k == K_STRING {
		nb = rt_call(pos, cstr("rt_kb_str"), args2(sym_ref_node(pos, cast(Sym, b)), fv), ty_int)
	} else if is_float_t(ft) != 0 {
		nb = rt_call(pos, cstr("rt_kb_word"), args2(sym_ref_node(pos, cast(Sym, b)), mk_conv(pos, fv, CV_F2BITS, ty_int)), ty_int)
	} else if k == K_STRUCT {
		nb = cast(i64, call_fn(pos, cast(Fn, key_enc_fn(cast(Ty, ft))), args2(sym_ref_node(pos, cast(Sym, b)), fv), ty_int))
	} else {
		nb = rt_call(pos, cstr("rt_kb_word"), args2(sym_ref_node(pos, cast(Sym, b)), mk_conv(pos, fv, CV_INT, ty_int)), ty_int)
	}
	body = append(body, assign_stmt(pos, sym_ref_node(pos, cast(Sym, b)), nb))
}

// key_dec_fn returns keydec$N(s) T: the key encoded in s, read from rt_kd's offset.
fn key_dec_fn(t Ty) i64 {
	if cast(i64, key_dec_types) == 0 {
		key_dec_types = []i64{}
		key_dec_fns = []i64{}
	}
	mut i = 0
	for i < len(key_dec_types) {
		if cast(i64, cast(Ty, cast([]i64, key_dec_types)[i])) == cast(i64, t) {
			return key_dec_fns[i]
		}
		i = i + 1
	}
	let names = []i64{}
	names = append(names, cstr("s"))
	let types = []i64{}
	types = append(types, ty_string)
	let rts = []i64{}
	rts = append(rts, cast(i64, t))
	let f = lifted_fn(cstr("keydec"), names, cast([]i64, types), cast(i64, rts))
	mut vs1 = cast([]i64, key_dec_types)
	vs1 = append(vs1, cast(i64, t))
	key_dec_fns = append(key_dec_fns, cast(i64, f))
	let saved_fn = ck_fn
	ck_fn = cast(Fn, f)
	let pos = 0
	let s = cast([]i64, f.locals)[0]
	let body = cast(Block, f.body).stmts
	let obj = temp(pos, rt_call(pos, cstr("rt_alloc"), args1(mk_int(pos, t.size, ty_int)), cast(i64, t)), cast(i64, t))
	body = append(body, cast(i64, obj))
	if cast(i64, t.enum_) != 0 {
		key_dec_field(pos, body, s, obj.sym, cast(i64, t), 0)
		let vs = t.enum_
		mut vi = 0
		for vi < len(vs) {
			let v = cast([]i64, vs[vi])
			let ifs = cast(IfStmt, node_new(ST_IF, pos))
			ifs.cond = mk_bin(pos, cstr("=="), mk_mem(pos, sym_ref_node(pos, cast(Sym, obj.sym)), 0, 0, field_offset(t, 0), ty_int), mk_int(pos, vi, ty_int), ty_bool)
			ifs.then = empty_block(pos)
			mut k = 0
			for k < v[2] {
				key_dec_field(pos, cast(Block, ifs.then).stmts, s, obj.sym, cast(i64, t), v[1] + k)
				k = k + 1
			}
			body = append(body, cast(i64, ifs))
			vi = vi + 1
		}
	} else {
		mut fi = 0
		for fi < len(t.fields) {
			key_dec_field(pos, body, s, obj.sym, cast(i64, t), fi)
			fi = fi + 1
		}
	}
	let ret = cast(ReturnStmt, node_new(ST_RETURN, pos))
	ret.value = sym_ref_node(pos, cast(Sym, obj.sym))
	body = append(body, cast(i64, ret))
	ck_fn = saved_fn
	return cast(i64, f)
}

fn key_dec_field(pos i64, body []i64, s i64, obj i64, t i64, fi i64) {
	let ft = field_type(cast(Ty, t), fi)
	let k = kind_of(cast(Ty, ft))
	mut v = 0
	if k == K_BOOL {
		v = mk_conv(pos, rt_call(pos, cstr("rt_kd_word"), args1(sym_ref_node(pos, cast(Sym, s))), ty_int), CV_SAME, ft)
	} else if k == K_STRING {
		v = rt_call(pos, cstr("rt_kd_str"), args1(sym_ref_node(pos, cast(Sym, s))), ty_string)
	} else if is_float_t(ft) != 0 {
		v = mk_conv(pos, rt_call(pos, cstr("rt_kd_word"), args1(sym_ref_node(pos, cast(Sym, s))), ty_int), CV_BITS2F, ft)
	} else if k == K_STRUCT {
		v = cast(i64, call_fn(pos, cast(Fn, key_dec_fn(cast(Ty, ft))), args1(sym_ref_node(pos, cast(Sym, s))), ft))
	} else {
		v = mk_conv(pos, rt_call(pos, cstr("rt_kd_word"), args1(sym_ref_node(pos, cast(Sym, s))), ty_int), CV_INT, ft)
	}
	body = append(body, assign_stmt(pos, field_store(pos, sym_ref_node(pos, cast(Sym, obj)), t, fi), v))
}

// map_read is m[k]: a missing key reads as the value type's zero, and a str, slice, map
// or struct zero is a real (never nil) value.
fn map_read(pos i64, m Node, k i64, vt i64) i64 {
	let get = from_bits(cast(Node, rt_call(pos, cstr("rt_map_get"), args2(cast(i64, m), key_in(cast(Node, k), cast(Ty, m.type_).key)), ty_int)), vt)
	let vk = kind_of(cast(Ty, vt))
	if !(vk == K_STRING || vk == K_SLICE || vk == K_MAP || vk == K_STRUCT) {
		return get
	}
	let stmts = []i64{}
	let tmp = temp(pos, get, vt)
	stmts = append(stmts, cast(i64, tmp))
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = mk_unot(pos, rt_call(pos, cstr("rt_map_found"), cast(i64, []i64{}), ty_bool))
	ifs.then = empty_block(pos)
	mut alt = 0
	if vk == K_STRING {
		alt = lit_string(pos, cstr(""))
	} else if vk == K_SLICE {
		alt = intrinsic_call(pos, cstr("__empty"), cast(i64, []i64{}), vt)
	} else {
		alt = argo_new(pos, cast(Block, ifs.then).stmts, cast(Ty, vt))
	}
	mut vs1 = cast(Block, ifs.then).stmts
	vs1 = append(vs1, assign_stmt(pos, sym_ref_node(pos, cast(Sym, tmp.sym)), alt))
	stmts = append(stmts, cast(i64, ifs))
	return mk_seq(pos, cast(i64, stmts), sym_ref_node(pos, cast(Sym, tmp.sym)), vt)
}

// mk_elem indexes a slice or string; the backend checks the index against the length
// unless ELEM_SAFE is set (the checker proved it in range).
fn mk_elem(pos i64, seq i64, index i64, t i64, isstr i64) ElemExpr {
	let n = node_new(EX_ELEM, pos)
	cast(ElemExpr, n).seq = seq
	cast(ElemExpr, n).idx = index
	cast(ElemExpr, n).size = type_width(cast(Ty, t))
	cast(ElemExpr, n).str = isstr
	cast(Node, n).type_ = t
	return cast(ElemExpr, n)
}

fn chk_index(e i64) i64 {
	let pos = cast(Node, e).pos
	let x = cast(IndexExpr, e).x
	let xt = cast(Ty, chk(cast(Node, x), 0))
	let k = kind_of(xt)
	if (k == K_INT && ck_trusted != 0) {
		// Raw word indexing: trusted code (the runtime's own memory management, the compiler's records).
		chk(cast(Node, cast(IndexExpr, e).i), ty_int)
		reconvert(cast(Node, cast(IndexExpr, e).i), ty_int)
		return ty_int
	}
	if k == K_MAP {
		let kt = chk(cast(Node, cast(IndexExpr, e).i), xt.key)
		check_assignable(cast(Node, cast(IndexExpr, e).i), kt, cast(Ty, xt.key))
		if is_untyped(kt) != 0 {
			reconvert(cast(Node, cast(IndexExpr, e).i), xt.key)
		}
		replace_node(e, map_read(pos, cast(Node, x), cast(IndexExpr, e).i, xt.elem))
		cast(Node, e).type_ = 0
		if is_secret(xt) != 0 {
			return secret_of(cast(Ty, xt.elem))
		}
		return xt.elem
	}
	let it = chk(cast(Node, cast(IndexExpr, e).i), ty_int)
	if is_integer_t(it) == 0 {
		err_code_type(pos, cstr("E238 INDEX"), cstr("index must be an integer, not "), it, cstr(""))
	}
	if kind_of(cast(Ty, it)) == K_UINT {
		reconvert(cast(Node, cast(IndexExpr, e).i), ty_int)
	}
	if k == K_STRING {
		replace_node(e, cast(i64, mk_elem(pos, x, cast(IndexExpr, e).i, ty_byte, 1)))
		mark_safe_index(cast(ElemExpr, e))
		cast(Node, e).type_ = 0
		if is_secret(xt) != 0 || is_secret(cast(Ty, it)) != 0 {
			return secret_of(cast(Ty, ty_byte))
		}
		return ty_byte
	}
	if k == K_SLICE {
		replace_node(e, cast(i64, mk_elem(pos, x, cast(IndexExpr, e).i, xt.elem, 0)))
		mark_safe_index(cast(ElemExpr, e))
		cast(Node, e).type_ = 0
		if is_secret(xt) != 0 || is_secret(cast(Ty, it)) != 0 {
			return secret_of(cast(Ty, xt.elem))
		}
		return xt.elem
	}
	err_code_type(pos, cstr("E238 INDEX"), cstr("cannot index "), cast(i64, xt), cstr(""))
	return ty_int
}

fn chk_slice(e i64) i64 {
	let pos = cast(Node, e).pos
	let x = cast(SliceExpr, e).x
	let xt = chk(cast(Node, x), 0)
	mut lo = cast(SliceExpr, e).lo
	mut hi = cast(SliceExpr, e).hi
	if lo != 0 {
		chk(cast(Node, lo), ty_int)
		reconvert(cast(Node, lo), ty_int)
	} else {
		lo = mk_int(pos, 0, ty_int)
	}
	// has_hi tells the runtime whether an upper bound was written (a negative one must panic).
	let has_hi = mk_int(pos, i64(hi != 0), ty_int)
	if hi != 0 {
		chk(cast(Node, hi), ty_int)
		reconvert(cast(Node, hi), ty_int)
	} else {
		hi = mk_int(pos, 0, ty_int)
	}
	if kind_of(cast(Ty, xt)) == K_STRING {
		replace_node(e, rt_call(pos, cstr("rt_str_sub"), args4(x, lo, hi, has_hi), ty_string))
		cast(Node, e).type_ = 0
		if is_secret(cast(Ty, xt)) != 0 {
			return xt
		}
		return ty_string
	}
	if kind_of(cast(Ty, xt)) == K_SLICE {
		replace_node(e, rt_call(pos, cstr("rt_slice_sub"), args5(x, lo, hi, mk_int(pos, elem_size(cast(Ty, xt)), ty_int), has_hi), xt))
		cast(Node, e).type_ = 0
		return xt
	}
	err_code_type(pos, cstr("E238 INDEX"), cstr("cannot slice "), xt, cstr(""))
	return ty_int
}

// pkg_member resolves pkg.name to its global symbol, or 0.
fn pkg_member(pkg i64, name i64) i64 {
	return cast(i64, lookup_global(str_cat3(pkg, cstr("."), name)))
}

// is_private reports whether name is private to its package (not capitalized).
fn is_private(name i64) i64 {
	let c = i64(load8(name))
	return i64((c >= 'a' && c <= 'z') || c == '_')
}

// foreign_type reports whether struct type t was declared in a package other than the one
// being checked (its name is pkg.Name with pkg not the current package).
fn foreign_type(t Ty) i64 {
	let n = t.name
	if n == 0 {
		return 0
	}
	mut i = 0
	for i64(load8(n + i)) != 0 && i64(load8(n + i)) != '.' && i64(load8(n + i)) != '[' {
		i = i + 1
	}
	if i64(load8(n + i)) != '.' {
		return 0
	}
	mut j = 0
	for j < i {
		if i64(load8(ck_pkg + j)) != i64(load8(n + j)) {
			return 1
		}
		j = j + 1
	}
	return i64(i64(load8(ck_pkg + i)) != 0)
}

// private_use reports (once) a private name of another package used here.
fn private_use(pos i64, what i64, name i64, owner i64) {
	let m = err_code(pos, cstr("E104 PRIVATE"))
	buf_str(m, what)
	buf_str(m, cstr(" "))
	buf_str(m, name)
	buf_str(m, cstr(" is private to "))
	buf_str(m, owner)
	buf_str(m, cstr(": only capitalized names are exported"))
	err_end(cast([]u8, m))
}

// type_pkg is the package part of struct type t's name (for messages).
fn type_pkg(t Ty) i64 {
	let n = t.name
	mut i = 0
	for i64(load8(n + i)) != 0 && i64(load8(n + i)) != '.' {
		i = i + 1
	}
	return str_slice(n, i)
}

// enum_type_of returns the enum type x names (Shape, geo.Shape, Option[i64]), or 0.
fn enum_type_of(x i64) i64 {
	mut t = cast(Ty, 0)
	if cast(Node, x).kind == EX_IDENT {
		if lookup_name_local(cast(IdentExpr, x).name) != 0 || import_pkg(cast(IdentExpr, x).name) != 0 {
			return 0
		}
		let s = lookup_name(cast(IdentExpr, x).name)
		if cast(i64, s) != 0 {
			return 0
		}
		t = cast(Ty, find_type_name(cast(IdentExpr, x).name))
	} else if cast(Node, x).kind == EX_SELECT {
		let px = cast(SelectExpr, x).x
		if cast(Node, px).kind != EX_IDENT || lookup_name_local(cast(IdentExpr, px).name) != 0 || import_pkg(cast(IdentExpr, px).name) == 0 {
			return 0
		}
		t = cast(Ty, find_type(str_cat3(import_pkg(cast(IdentExpr, px).name), cstr("."), cast(SelectExpr, x).name)))
	} else if cast(Node, x).kind == EX_INDEX {
		// Option[i64].Some(3): only when the base names a type, not a value.
		let base = cast(IndexExpr, x).x
		if cast(Node, base).kind != EX_IDENT || lookup_name_local(cast(IdentExpr, base).name) != 0 || cast(i64, lookup_name(cast(IdentExpr, base).name)) != 0 || !(cast(i64, find_generic(cast(IdentExpr, base).name)) != 0 || (i64(load8(ck_pkg)) != 0 && cast(i64, find_generic(qual(ck_pkg, cast(IdentExpr, base).name))) != 0)) {
			return 0
		}
		let gtx = expr_to_tx(x)
		if gtx != 0 {
			t = cast(Ty, resolve_type(gtx))
		}
	}
	if cast(i64, t) != 0 && kind_of(t) == K_STRUCT && cast(i64, t.enum_) != 0 {
		return cast(i64, t)
	}
	return 0
}

// enum_variant is the index of variant name in enum t, or -1.
fn enum_variant(t Ty, name i64) i64 {
	let vs = t.enum_
	mut i = 0
	for i < len(vs) {
		if streq(cast([]i64, vs[i])[0], name) != 0 {
			return i
		}
		i = i + 1
	}
	return -1
}

// enum_construct builds Shape.Circle(2.0): a tagged object whose other variants' fields
// hold their zero values.
fn enum_construct(e Node, t Ty, name i64, args []i64) i64 {
	let pos = e.pos
	let vi = enum_variant(t, name)
	if vi < 0 {
		let u = err_code(pos, cstr("E239 VARIANT"))
		type_name(cast([]u8, u), t)
		buf_str(u, cstr(" has no variant "))
		buf_str(u, name)
		err_end(cast([]u8, u))
		return cast(i64, t)
	}
	if is_private(name) != 0 && foreign_type(t) != 0 {
		private_use(pos, cstr("variant"), name, type_pkg(t))
	}
	let v = cast([]i64, t.enum_[vi])
	let first = v[1]
	let nf = v[2]
	if len(args) != nf {
		let u = err_code(pos, cstr("E239 VARIANT"))
		type_name(cast([]u8, u), t)
		buf_byte(u, '.')
		buf_str(u, name)
		buf_str(u, cstr(" takes "))
		buf_int(u, nf)
		if nf == 1 {
			buf_str(u, cstr(" value, got "))
		} else {
			buf_str(u, cstr(" values, got "))
		}
		buf_int(u, len(args))
		err_end(cast([]u8, u))
		return cast(i64, t)
	}
	let stmts = []i64{}
	let obj = temp(pos, rt_call(pos, cstr("rt_alloc"), args1(mk_int(pos, t.size, ty_int)), cast(i64, t)), cast(i64, t))
	stmts = append(stmts, cast(i64, obj))
	stmts = append(stmts, assign_stmt(pos, field_store(pos, sym_ref_node(pos, cast(Sym, obj.sym)), cast(i64, t), 0), mk_int(pos, vi, ty_int)))
	let total = len(t.fields)
	mut i = 1
	for i < total {
		if i >= first && i < first + nf {
			let a = args[i - first]
			unwrap_mut(a)
			let ft = field_type(t, i)
			let at = chk(cast(Node, a), ft)
			check_assignable(cast(Node, a), at, cast(Ty, ft))
			if is_untyped(at) != 0 {
				reconvert(cast(Node, a), ft)
			}
			stmts = append(stmts, assign_stmt(pos, field_store(pos, sym_ref_node(pos, cast(Sym, obj.sym)), cast(i64, t), i), a))
		}
		// Other variants' fields stay empty: only a switch on the tag can reach them.
		i = i + 1
	}
	replace_node(cast(i64, e), mk_seq(pos, cast(i64, stmts), sym_ref_node(pos, cast(Sym, obj.sym)), 0))
	return cast(i64, t)
}

fn chk_select(e i64, want i64) i64 {
	let pos = cast(Node, e).pos
	let x = cast(SelectExpr, e).x
	let name = cast(SelectExpr, e).name
	let et = enum_type_of(x)
	if et != 0 {
		return enum_construct(cast(Node, e), cast(Ty, et), name, []i64{})
	}
	if cast(Node, x).kind == EX_IDENT && lookup_name_local(cast(IdentExpr, x).name) == 0 {
		let pkg = import_pkg(cast(IdentExpr, x).name)
		if pkg != 0 {
			let s = pkg_member(pkg, name)
			if s == 0 {
				let u = err_code(pos, cstr("E103 UNDEFINED"))
				buf_str(u, cstr("undefined: "))
				buf_str(u, cast(IdentExpr, x).name)
				buf_byte(u, '.')
				buf_str(u, name)
				err_end(cast([]u8, u))
				return ty_int
			}
			if is_private(name) != 0 {
				private_use(pos, cstr("name"), name, pkg)
			}
			replace_node(e, node_new(EX_IDENT, pos))
			cast(IdentExpr, e).name = name
			return use_sym(e, cast(Sym, s), want)
		}
	}
	let xt = cast(Ty, chk(cast(Node, x), 0))
	if kind_of(xt) == K_OPT {
		err_code_type(pos, cstr("E421 UNCHECKED_OPTIONAL"), cstr("cannot use a field of optional "), cast(i64, xt), cstr(" before checking it against nil"))
		return ty_int
	}
	if kind_of(xt) == K_STRUCT && cast(i64, xt.enum_) != 0 {
		err_code_type(pos, cstr("E213 FIELD"), cstr("an enum's data is read with switch, not as a field of "), cast(i64, xt), cstr(""))
		return ty_int
	}
	if kind_of(xt) == K_DYN {
		err_code_at(pos, cstr("E530 DYN_NOT_YET"), cstr("a method value on a dyn value needs the table: the next step (#141)"))
		return ty_int
	}
	if kind_of(xt) == K_STRUCT {
		let i = struct_field(xt, name)
		if i < 0 {
			let u = err_code(pos, cstr("E213 FIELD"))
			type_name(cast([]u8, u), xt)
			buf_str(u, cstr(" has no field "))
			buf_str(u, name)
			err_end(cast([]u8, u))
			return ty_int
		}
		if is_private(name) != 0 && foreign_type(xt) != 0 {
			private_use(pos, cstr("field"), name, type_pkg(xt))
		}
		replace_node(e, mk_mem(pos, x, 0, 0, field_offset(xt, i), 0))
		return field_type(xt, i)
	}
	err_code_type(pos, cstr("E213 FIELD"), cstr("cannot select a field of "), cast(i64, xt), cstr(""))
	return ty_int
}

fn lookup_name_local(name i64) i64 {
	mut i = len(sc_syms) - 1
	for i >= 0 {
		if streq(sc_syms[i].name, name) != 0 {
			return cast(i64, sc_syms[i])
		}
		i = i - 1
	}
	return 0
}

// field_store builds the target for storing into field fi of struct object obj.
fn field_store(pos i64, obj i64, t i64, fi i64) i64 {
	return mk_mem(pos, obj, 0, 0, field_offset(cast(Ty, t), fi), field_type(cast(Ty, t), fi))
}

// chk_composite allocates a struct, slice or map and fills it, as an EX_SEQ.
fn chk_composite(e i64, want i64) i64 {
	let pos = cast(Node, e).pos
	let tx = cast(Composite, e).type_
	mut t = cast(Ty, want)
	if kind_of(t) == K_OPT {
		t = cast(Ty, t.elem)
	}
	if cast(Node, tx).kind == EX_TYPE && tx[TYX] != 0 {
		t = cast(Ty, resolve_type(tx[TYX]))
	} else if cast(Node, tx).kind == EX_INDEX {
		let gtx = expr_to_tx(tx)
		if gtx != 0 {
			t = cast(Ty, resolve_type(gtx))
		}
	} else if cast(Node, tx).kind == EX_IDENT || cast(Node, tx).kind == EX_SELECT {
		let tn = cast(TypeExpr, node_new(TX_NAME, pos))
		if cast(Node, tx).kind == EX_IDENT {
			tn.b = cast(i64, cast([]i64, cast(IdentExpr, tx).name))
		} else {
			tn.a = cast(i64, cast([]i64, cast(IdentExpr, cast(SelectExpr, tx).x).name))
			tn.b = cast(i64, cast([]i64, cast(SelectExpr, tx).name))
		}
		t = cast(Ty, resolve_type(cast(i64, tn)))
	}
	if cast(i64, t) == 0 {
		err_code_at(pos, cstr("E216 COMPOSITE"), cstr("missing type in composite literal"))
		return ty_int
	}
	let elems = cast(Composite, e).elems
	let keys = cast(Composite, e).keys
	let stmts = []i64{}
	let k = kind_of(t)
	if k == K_STRUCT && cast(i64, t.enum_) != 0 {
		err_code_type(pos, cstr("E216 COMPOSITE"), cstr("build an enum with one of its variants ("), cast(i64, t), cstr(".Variant(...)), not a composite literal"))
		return cast(i64, t)
	}
	if k == K_STRUCT {
		let nf = len(t.fields)
		let obj = temp(pos, rt_call(pos, cstr("rt_alloc"), args1(mk_int(pos, t.size, ty_int)), cast(i64, t)), cast(i64, t))
		stmts = append(stmts, cast(i64, obj))
		let set = slice_filled(nf, 0)
		mut i = 0
		for i < len(elems) {
			mut fi = i
			let key = keys[i]
			if key != 0 {
				if cast(Node, key).kind != EX_IDENT {
					err_code_at(cast(Node, key).pos, cstr("E216 COMPOSITE"), cstr("expected a field name"))
					return cast(i64, t)
				}
				fi = struct_field(t, cast(IdentExpr, key).name)
				if fi < 0 {
					err_code_quoted(cast(Node, key).pos, cstr("E216 COMPOSITE"), cstr("unknown field "), cast(IdentExpr, key).name, cstr(""))
					return cast(i64, t)
				}
				if is_private(cast(IdentExpr, key).name) != 0 && foreign_type(t) != 0 {
					private_use(cast(Node, key).pos, cstr("field"), cast(IdentExpr, key).name, type_pkg(t))
				}
			} else if fi >= nf {
				err_code_at(pos, cstr("E216 COMPOSITE"), cstr("too many values in struct literal"))
				return cast(i64, t)
			} else if foreign_type(t) != 0 && is_private(cast([]i64, t.fields[fi])[0]) != 0 {
				// A positional value sets the field as surely as its name would (#96).
				private_use(cast(Node, elems[i]).pos, cstr("field"), cast([]i64, t.fields[fi])[0], type_pkg(t))
			}
			set[fi] = 1
			let ft = field_type(t, fi)
			let v = elems[i]
			let vt = chk(cast(Node, v), ft)
			check_assignable(cast(Node, v), vt, cast(Ty, ft))
			if is_untyped(vt) != 0 {
				reconvert(cast(Node, v), ft)
			}
			if !(is_const_zero(cast(i64, v)) != 0 && is_ref(ft) == 0) {
				stmts = append(stmts, assign_stmt(pos, field_store(pos, sym_ref_node(pos, cast(Sym, obj.sym)), cast(i64, t), fi), cast(i64, v)))
			}
			i = i + 1
		}
		// Fields left out get their zero value; references that cannot be nil must be set.
		i = 0
		for i < nf {
			if set[i] == 0 {
				init_zero_field(pos, cast([]i64, stmts), obj.sym, t, i)
			}
			i = i + 1
		}
		replace_node(e, mk_seq(pos, cast(i64, stmts), sym_ref_node(pos, cast(Sym, obj.sym)), 0))
		return cast(i64, t)
	}
	if k == K_SLICE {
		let n = len(elems)
		let et = t.elem
		let sl = temp(pos, rt_call(pos, cstr("rt_slice_make"), args3(mk_int(pos, n, ty_int), mk_int(pos, n, ty_int), mk_int(pos, elem_size(t), ty_int)), cast(i64, t)), cast(i64, t))
		stmts = append(stmts, cast(i64, sl))
		let data = temp(pos, mk_hdr(pos, sym_ref_node(pos, cast(Sym, sl.sym)), 2), ty_int)
		stmts = append(stmts, cast(i64, data))
		mut i = 0
		for i < n {
			let v = elems[i]
			let vt = chk(cast(Node, v), et)
			check_assignable(cast(Node, v), vt, cast(Ty, et))
			if is_untyped(vt) != 0 {
				reconvert(cast(Node, v), et)
			}
			stmts = append(stmts, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, cast(Sym, data.sym)), 0, 0, i * type_width(cast(Ty, et)), et), cast(i64, v)))
			i = i + 1
		}
		replace_node(e, mk_seq(pos, cast(i64, stmts), sym_ref_node(pos, cast(Sym, sl.sym)), 0))
		return cast(i64, t)
	}
	if k == K_MAP {
		let m = temp(pos, map_make_call(pos, t), cast(i64, t))
		stmts = append(stmts, cast(i64, m))
		mut i = 0
		for i < len(elems) {
			let key = keys[i]
			let v = cast(Node, elems[i])
			if key == 0 {
				err_code_at(v.pos, cstr("E216 COMPOSITE"), cstr("missing key in map literal"))
				return cast(i64, t)
			}
			let kt = chk(cast(Node, key), t.key)
			check_assignable(cast(Node, key), kt, cast(Ty, t.key))
			if is_untyped(kt) != 0 {
				reconvert(cast(Node, key), t.key)
			}
			let vt = chk(cast(Node, v), t.elem)
			check_assignable(cast(Node, v), vt, cast(Ty, t.elem))
			if is_untyped(vt) != 0 {
				reconvert(cast(Node, v), t.elem)
			}
			stmts = append(stmts, expr_stmt(cast(Node, map_set_call(pos, sym_ref_node(pos, cast(Sym, m.sym)), key, cast(i64, v), t.key))))
			i = i + 1
		}
		replace_node(e, mk_seq(pos, cast(i64, stmts), sym_ref_node(pos, cast(Sym, m.sym)), 0))
		return cast(i64, t)
	}
	err_code_type(pos, cstr("E216 COMPOSITE"), cstr("cannot build a composite literal of type "), cast(i64, t), cstr(""))
	return ty_int
}

// init_zero_field stores the zero value of a field the literal left out. Memory is
// already zeroed, so only references need work: "" and empty slices are static
// objects, and structs, maps and funcs have no zero value at all.
fn init_zero_field(pos i64, stmts []i64, obj i64, t Ty, fi i64) {
	let ft = field_type(t, fi)
	let k = kind_of(cast(Ty, ft))
	let rec = cast([]i64, t.fields[fi])
	if k == K_SLICE && len(rec) > 4 && rec[3] > 0 {
		array_inner = rec[4]
		stmts = append(stmts, assign_stmt(pos, field_store(pos, sym_ref_node(pos, cast(Sym, obj)), cast(i64, t), fi), array_make(pos, cast(Ty, ft), rec[3])))
		return
	}
	if k == K_STRING || k == K_SLICE {
		stmts = append(stmts, assign_stmt(pos, field_store(pos, sym_ref_node(pos, cast(Sym, obj)), cast(i64, t), fi), zero_value(pos, ft)))
	} else if k == K_STRUCT || k == K_MAP || k == K_FUNC || k == K_DYN {
		let m = err_code(pos, cstr("E203 NO_ZERO_VALUE"))
		buf_str(m, cstr("field "))
		buf_str(m, cast([]i64, t.fields[fi])[0])
		buf_str(m, cstr(" of type "))
		type_name(cast([]u8, m), cast(Ty, ft))
		if k == K_DYN {
			buf_str(m, cstr(" must be set (a dyn value has no zero; the table comes with the next step, #141)"))
		} else {
			buf_str(m, cstr(" must be set (it cannot be nil; declare it ?T to allow that)"))
		}
		err_end(cast([]u8, m))
	}
}

fn get_cell_addr(pos i64, os Sym) i64 {
	if os.captured != 0 {
		return mk_mem(pos, sym_ref_node(pos, cast(Sym, cast(Fn, ck_fn).env_sym)), 0, 0, 8 * (2 + os.cap_idx), ty_int)
	}
	if os.cell != 0 {
		return sym_ref_node(pos, cast(Sym, os.cell_sym))
	}
	os.addr = 1
	return mk_unary(pos, cstr("&"), sym_ref_node(pos, os))
}

// closure_keeper builds keep$N(d), which copies closure descriptor d and its captured
// variables into the long-lived heap, each value kept by its type (a str, slice, struct or
// closure deeply), so a kept closure never reads request memory (#170). It returns 0 when
// no captured variable holds a reference.
fn closure_keeper(pos i64, cf Fn) i64 {
	let caps = cast([]i64, cf.captures)
	let k = len(caps)
	mut refs = 0
	mut i = 0
	for i < k {
		let ct = cast(Sym, caps[i]).type_
		if is_ref(ct) != 0 || is_dyn_value(cast(Ty, ct)) != 0 {
			refs = 1
		}
		i = i + 1
	}
	if refs == 0 {
		return 0
	}
	lifted_count = lifted_count + 1
	let f = fn_new(pos, cstr("keep"))
	let nb = buf_new()
	buf_str(nb, cstr("keep$"))
	buf_int(nb, lifted_count)
	buf_byte(nb, 0)
	f.qname = slice_data(nb)
	f.name = slice_data(nb)
	f.lifted = 2
	f.file = cf.file
	f.params = append(f.params, cstr("d"))
	f.ptypes = append(f.ptypes, ty_int)
	f.rtypes = append(f.rtypes, ty_int)
	f.type_ = func_of(f.ptypes, f.rtypes, 0)
	f.locals = cast([]Sym, []i64{})
	f.body = empty_block(pos)
	prog_fns = append(prog_fns, cast(Fn, f))
	let saved_fn = ck_fn
	ck_fn = cast(Fn, f)
	let d = sym_new(SYM_LOCAL, cstr("d"), pos)
	d.type_ = ty_int
	d.slot = 0
	f.slots = 1
	mut vs4 = cast([]i64, f.locals)
	vs4 = append(vs4, cast(i64, d))
	let body = cast(Block, f.body).stmts
	let nd = temp(pos, rt_call(pos, cstr("rt_ingot_alloc"), args1(mk_int(pos, 8 * (3 + k), ty_int)), ty_int), ty_int)
	body = append(body, cast(i64, nd))
	mut w = 0
	for w < 2 {
		body = append(body, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, cast(Sym, nd.sym)), 0, 0, 8 * w, ty_int), mk_mem(pos, sym_ref_node(pos, d), 0, 0, 8 * w, ty_int)))
		w = w + 1
	}
	body = append(body, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, cast(Sym, nd.sym)), 0, 0, 8 * (2 + k), ty_int), mk_mem(pos, sym_ref_node(pos, d), 0, 0, 8 * (2 + k), ty_int)))
	i = 0
	for i < k {
		let ct = cast(Sym, caps[i]).type_
		let cell = temp(pos, rt_call(pos, cstr("rt_ingot_alloc"), args1(mk_int(pos, 8, ty_int)), ty_int), ty_int)
		body = append(body, cast(i64, cell))
		let old = mk_mem(pos, mk_mem(pos, sym_ref_node(pos, d), 0, 0, 8 * (2 + i), ty_int), 0, 0, 0, ct)
		mut val = old
		if is_ref(ct) != 0 || is_dyn_value(cast(Ty, ct)) != 0 {
			val = keep_call(pos, keep_fn(cast(Ty, ct)), old, ct)
		}
		body = append(body, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, cast(Sym, cell.sym)), 0, 0, 0, ct), val))
		body = append(body, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, cast(Sym, nd.sym)), 0, 0, 8 * (2 + i), ty_int), sym_ref_node(pos, cast(Sym, cell.sym))))
		i = i + 1
	}
	let ret = cast(ReturnStmt, node_new(ST_RETURN, pos))
	ret.value = sym_ref_node(pos, cast(Sym, nd.sym))
	body = append(body, cast(i64, ret))
	ck_fn = saved_fn
	return cast(i64, f)
}

// chk_funclit lifts a function literal to a top-level function. Literals may capture
// variables from enclosing scopes: non-escaping closures allocate frame descriptors
// and cells on stack (0 bytes allocated), while escaping closures allocate region objects.
fn chk_funclit(e i64) i64 {
	let f = cast(Fn, cast(FuncLit, e).fn_)
	lifted_count = lifted_count + 1
	let b = buf_new()
	buf_str(b, cstr("func$"))
	buf_int(b, lifted_count)
	buf_byte(b, 0)
	f.name = slice_data(b)
	f.file = ck_file
	f.lifted = 1
	f.qname = f.name
	f.parent = cast(i64, ck_fn)
	f.captures = cast([]Sym, []i64{})
	f.outer_syms = cast([]i64, cast(i64, slice_clone(sc_syms)))
	f.escapes = cast(FuncLit, e).escape
	if cast(FuncLit, e).scoped != 0 {
		f.escapes = 0
	}

	let saved_fn = ck_fn
	declare_fn(f)
	ck_fn = saved_fn

	check_fn_closure(cast(i64, f))
	sb_captures(e, f)
	f.done = 1
	prog_fns = append(prog_fns, cast(Fn, f))

	let k = len(cast([]i64, f.captures))
	if k == 0 {
		replace_node(e, node_new(EX_FUNCREF, cast(Node, e).pos))
		cast(FuncRef, e).fn_ = cast(i64, f)
		return f.type_
	}

	let pos = cast(Node, e).pos
	let fn_ref = node_new(EX_FUNCREF, pos)
	cast(FuncRef, fn_ref).fn_ = cast(i64, f)
	cast(FuncRef, fn_ref).raw = 1
	cast(Node, fn_ref).type_ = ty_int

	let stmts = []i64{}
	mut desc_val = 0

	if cast(FuncLit, e).escape == 0 {
		let desc_sym = cast(Sym, declare_local(pos, cstr("$desc"), ty_int))
		desc_sym.addr = 1
		desc_sym.words = 3 + k
		let desc_addr = mk_unary(pos, cstr("&"), sym_ref_node(pos, desc_sym))
		let dptr = temp(pos, desc_addr, ty_int)
		stmts = append(stmts, cast(i64, dptr))
		let dref = sym_ref_node(pos, cast(Sym, dptr.sym))

		stmts = append(stmts, assign_stmt(pos, mk_mem(pos, dref, 0, 0, 0, ty_int), fn_ref))
		stmts = append(stmts, assign_stmt(pos, mk_mem(pos, dref, 0, 0, 8, ty_int), mk_int(pos, k, ty_int)))

		mut i = 0
		for i < k {
			let os = cast([]i64, f.captures)[i]
			let cell_expr = get_cell_addr(pos, cast(Sym, os))
			stmts = append(stmts, assign_stmt(pos, mk_mem(pos, dref, 0, 0, 8 * (2 + i), ty_int), cell_expr))
			i = i + 1
		}
		// A frame descriptor is never kept (the closure is only called): no keeper.
		stmts = append(stmts, assign_stmt(pos, mk_mem(pos, dref, 0, 0, 8 * (2 + k), ty_int), mk_int(pos, 0, ty_int)))
		desc_val = dref
	} else {
		let alloc_call = rt_call(pos, cstr("rt_alloc"), args1(mk_int(pos, 8 * (3 + k), ty_int)), ty_int)
		let obj = temp(pos, alloc_call, ty_int)
		stmts = append(stmts, cast(i64, obj))
		let dref = sym_ref_node(pos, cast(Sym, obj.sym))

		stmts = append(stmts, assign_stmt(pos, mk_mem(pos, dref, 0, 0, 0, ty_int), fn_ref))
		stmts = append(stmts, assign_stmt(pos, mk_mem(pos, dref, 0, 0, 8, ty_int), mk_int(pos, k, ty_int)))

		mut i = 0
		for i < k {
			let os = cast([]i64, f.captures)[i]
			let cell_expr = get_cell_addr(pos, cast(Sym, os))
			stmts = append(stmts, assign_stmt(pos, mk_mem(pos, dref, 0, 0, 8 * (2 + i), ty_int), cell_expr))
			i = i + 1
		}
		// Word 2 + k: the function keep() calls to copy this closure deeply (0: no captured
		// variable holds a reference, so copying the words is enough).
		let keeper = closure_keeper(pos, f)
		mut kv = mk_int(pos, 0, ty_int)
		if keeper != 0 {
			kv = node_new(EX_FUNCREF, pos)
			cast(FuncRef, kv).fn_ = keeper
			cast(Node, kv).type_ = ty_int
		}
		stmts = append(stmts, assign_stmt(pos, mk_mem(pos, dref, 0, 0, 8 * (2 + k), ty_int), kv))
		desc_val = dref
	}

	let seq = mk_seq(pos, cast(i64, stmts), desc_val, f.type_)
	replace_node(e, seq)
	return f.type_
}

// chk_unit turns an edition 1 unit literal (200ms, 4mb) into its integer constant:
// nanoseconds for a duration, bytes for a size (design_syntax §2).
fn chk_unit(e i64, want i64) i64 {
	let pos = cast(Node, e).pos
	let u = cast(UnitExpr, e).name
	if cast(UnitExpr, e).float != 0 {
		err_code_at(pos, cstr("E012 NUMERIC_UNIT"), cstr("a fractional unit literal is not supported yet: write it in a smaller unit (2500ms, not 2.5s)"))
		return ty_int
	}
	mut scale = 1
	if streq(u, cstr("us")) != 0 {
		scale = 1000
	} else if streq(u, cstr("ms")) != 0 {
		scale = 1000000
	} else if streq(u, cstr("s")) != 0 {
		scale = 1000000000
	} else if streq(u, cstr("m")) != 0 {
		scale = 60000000000
	} else if streq(u, cstr("h")) != 0 {
		scale = 3600000000000
	} else if streq(u, cstr("kb")) != 0 {
		scale = 1024
	} else if streq(u, cstr("mb")) != 0 {
		scale = 1048576
	} else if streq(u, cstr("gb")) != 0 {
		scale = 1073741824
	}
	let v = cast(UnitExpr, e).value
	if v < 0 || (v > 0 && v > 9223372036854775807 / scale) {
		err_code_at(pos, cstr("E012 NUMERIC_UNIT"), cstr("unit literal out of range"))
		return ty_int
	}
	let n = cast(IntLit, node_new(EX_INT, pos))
	n.val = v * scale
	replace_node(e, cast(i64, n))
	return chk(cast(Node, e), want)
}

// ---- boundary blocks: guard (#230), within (#233) and limit (#235) ----
//
// The block becomes a closure func($r i64) ! whose last expression is stored through $r, so
// fail and try leave the block with a fault. A generated boundary$N(c, a) !T runs it inside
// the boundary (a guard stack, or a boundary record with a deadline) and returns the value.
fn chk_boundary(e i64) i64 {
	let pos = cast(Node, e).pos
	let kind = cast(BoundaryStmt, e).kind
	if kind == BOUND_PARALLEL {
		return chk_parallel(e)
	}
	if kind == BOUND_WITH {
		return chk_with(e)
	}
	if kind == BOUND_ARENA {
		return chk_arena(e)
	}
	if (kind != BOUND_WITHIN && kind != BOUND_GUARD && kind != BOUND_LIMIT) {
		err_code_at(pos, cstr("E650 BOUNDARY"), cstr("this boundary block is not supported yet"))
		return ty_int
	}
	mut arg = mk_int(pos, 0, ty_int)
	mut arg2 = mk_int(pos, 0, ty_int)
	if kind == BOUND_WITHIN {
		arg = bound_int_arg(cast(BoundaryStmt, e).args[0])
	}
	if kind == BOUND_LIMIT {
		// limit memory n, tasks k: each bound at most once.
		mut i = 0
		for i < len(cast(BoundaryStmt, e).args) {
			let item = cast([]i64, cast(BoundaryStmt, e).args[i])
			let name = item[0]
			let v = bound_int_arg(item[1])
			if streq(name, cstr("memory")) != 0 {
				arg = v
			} else if streq(name, cstr("tasks")) != 0 {
				arg2 = v
			} else {
				err_code_quoted(pos, cstr("E650 BOUNDARY"), cstr("limit bounds are memory and tasks, not "), name, cstr(""))
			}
			i = i + 1
		}
	}
	let body = cast(Block, cast(BoundaryStmt, e).body)
	bound_leaves(body.stmts)
	let f = fn_new(pos, cstr("func"))
	f.params = append(f.params, cstr("$r"))
	let it = cast(TypeExpr, node_new(TX_NAME, pos))
	it.b = cast(i64, cast([]i64, cstr("i64")))
	f.ptypes = append(f.ptypes, cast(i64, it))
	let ft = cast(TypeExpr, node_new(TX_NAME, pos))
	ft.b = cast(i64, cast([]i64, cstr("fault")))
	f.rtypes = append(f.rtypes, cast(i64, ft))
	f.bang = 1
	let stmts = body.stmts
	let n = len(stmts)
	if n > 0 && cast(Node, stmts[n - 1]).kind == ST_EXPR {
		let last = stmts[n - 1]
		let bs = cast(ExprStmt, node_new(ST_BSTORE, cast(Node, last).pos))
		bs.x = cast(ExprStmt, last).x
		stmts[n - 1] = cast(i64, bs)
	}
	f.body = cast(i64, body)
	let lit = cast(FuncLit, node_new(EX_FUNCLIT, pos))
	lit.fn_ = cast(i64, f)
	lit.escape = 0
	let saved_t = bound_t
	bound_t = ty_void
	let ct = chk_funclit(cast(i64, lit))
	let vt = bound_t
	bound_t = saved_t
	let w = cast(Fn, boundary_wrapper(pos, kind, ct, vt))
	let c = node_new(EX_CALL, pos)
	cast(Call, c).name = w.name
	cast(Call, c).fn_ = cast(i64, w)
	let cargs = cast([]i64, args2(cast(i64, lit), arg))
	cargs = append(cargs, arg2)
	cast(Call, c).args = cast([]i64, cargs)
	let results = []i64{}
	if kind_of(cast(Ty, vt)) != K_VOID {
		results = append(results, vt)
	}
	results = append(results, ty_error)
	mut rt = ty_error
	if len(cast([]i64, results)) > 1 {
		rt = tuple_of(cast(i64, results))
	}
	cast(Node, c).type_ = rt
	replace_node(e, c)
	return rt
}

// chk_parallel lowers parallel { e1 \n e2 ... } (#232): each line is a closure run as a child
// of an implicit scope, storing its value (a fault leaves the scope, cancelling the others);
// a generated parallel$N(c1, c2, ...) waits for them and returns the tuple of values.
fn chk_parallel(e i64) i64 {
	let pos = cast(Node, e).pos
	let stmts = cast(Block, cast(BoundaryStmt, e).body).stmts
	let lits = []i64{}
	let vts = []i64{}
	mut i = 0
	for i < len(stmts) {
		let st = stmts[i]
		if cast(Node, st).kind != ST_EXPR {
			err_code_at(cast(Node, st).pos, cstr("E651 PARALLEL"), cstr("each line of parallel is an expression that runs as a child task"))
			return ty_int
		}
		mut x = cast(Node, cast(ExprStmt, st).x)
		if x.kind != EX_TRY && x.kind != EX_CATCH {
			let tr = cast(TryExpr, node_new(EX_TRY, x.pos))
			tr.x = cast(i64, x)
			tr.soft = 1
			x = cast(Node, tr)
		}
		let bs = cast(ExprStmt, node_new(ST_BSTORE, cast(Node, st).pos))
		bs.x = cast(i64, x)
		let body = cast(Block, empty_block(cast(Node, st).pos))
		body.stmts = append(body.stmts, cast(i64, bs))
		let f = fn_new(cast(Node, st).pos, cstr("func"))
		f.params = append(f.params, cstr("$r"))
		let it = cast(TypeExpr, node_new(TX_NAME, pos))
		it.b = cast(i64, cast([]i64, cstr("i64")))
		f.ptypes = append(f.ptypes, cast(i64, it))
		let ft = cast(TypeExpr, node_new(TX_NAME, pos))
		ft.b = cast(i64, cast([]i64, cstr("fault")))
		f.rtypes = append(f.rtypes, cast(i64, ft))
		f.bang = 1
		f.body = cast(i64, body)
		let lit = cast(FuncLit, node_new(EX_FUNCLIT, cast(Node, st).pos))
		lit.fn_ = cast(i64, f)
		lit.escape = 0
		let saved_t = bound_t
		bound_t = ty_void
		let ct = chk_funclit(cast(i64, lit))
		if kind_of(cast(Ty, bound_t)) == K_VOID {
			err_code_at(cast(Node, st).pos, cstr("E651 PARALLEL"), cstr("a parallel line must give a value"))
		}
		vts = append(vts, bound_t)
		bound_t = saved_t
		lits = append(lits, pair(cast(i64, lit), ct))
		i = i + 1
	}
	if len(cast([]i64, lits)) < 2 {
		err_code_at(pos, cstr("E651 PARALLEL"), cstr("parallel needs at least two lines"))
		return ty_int
	}
	let w = cast(Fn, parallel_wrapper(pos, cast([]i64, lits), cast([]i64, vts)))
	let c = node_new(EX_CALL, pos)
	cast(Call, c).name = w.name
	cast(Call, c).fn_ = cast(i64, w)
	let args = []i64{}
	i = 0
	for i < len(cast([]i64, lits)) {
		args = append(args, cast([]i64, lits[i])[0])
		i = i + 1
	}
	cast(Call, c).args = cast([]i64, args)
	let results = []i64{}
	i = 0
	for i < len(cast([]i64, vts)) {
		results = append(results, vts[i])
		i = i + 1
	}
	results = append(results, ty_error)
	let rt = tuple_of(cast(i64, results))
	cast(Node, c).type_ = rt
	replace_node(e, c)
	return rt
}

// parallel_wrapper builds parallel$N(c1..cn) (T1..Tn, fault): it spawns each ci with its own
// 16-byte result cell in an implicit scope, waits for all of them, and returns the values.
fn parallel_wrapper(pos i64, lits []i64, vts []i64) i64 {
	lifted_count = lifted_count + 1
	let f = fn_new(pos, cstr("parallel"))
	let nb = buf_new()
	buf_str(nb, cstr("parallel$"))
	buf_int(nb, lifted_count)
	buf_byte(nb, 0)
	f.qname = slice_data(nb)
	f.name = slice_data(nb)
	f.lifted = 2
	f.file = ck_file
	f.bang = 1
	let n = len(lits)
	mut i = 0
	for i < n {
		f.params = append(f.params, cstr("c"))
		f.ptypes = append(f.ptypes, cast([]i64, lits[i])[1])
		f.rtypes = append(f.rtypes, vts[i])
		i = i + 1
	}
	f.rtypes = append(f.rtypes, ty_error)
	f.type_ = func_of(f.ptypes, f.rtypes, 0)
	f.locals = cast([]Sym, []i64{})
	f.body = empty_block(pos)
	prog_fns = append(prog_fns, cast(Fn, f))
	let saved_fn = ck_fn
	ck_fn = cast(Fn, f)
	let syms = []Sym{}
	i = 0
	for i < n {
		let cs = sym_new(SYM_LOCAL, cstr("c"), pos)
		cs.type_ = cast([]i64, lits[i])[1]
		cs.slot = i
		mut vs5 = cast([]i64, f.locals)
		vs5 = append(vs5, cast(i64, cs))
		syms = append(syms, cast(Sym, cs))
		i = i + 1
	}
	f.slots = n
	let body = cast(Block, f.body).stmts
	let r = temp(pos, rt_call(pos, cstr("rt_alloc"), args1(mk_int(pos, 16 * n, ty_int)), ty_int), ty_int)
	body = append(body, cast(i64, r))
	let sc = temp(pos, rt_call(pos, cstr("rt_scope_open_word"), cast(i64, []i64{}), ty_int), ty_int)
	body = append(body, cast(i64, sc))
	i = 0
	for i < n {
		let at = mk_bin(pos, cstr("+"), sym_ref_node(pos, cast(Sym, r.sym)), mk_int(pos, 16 * i, ty_int), ty_int)
		let sa = cast([]i64, args2(sym_ref_node(pos, cast(Sym, sc.sym)), sym_ref_node(pos, syms[i])))
		sa = append(sa, at)
		body = append(body, expr_stmt(cast(Node, rt_call(pos, cstr("rt_scope_spawn_arg"), cast(i64, sa), ty_void))))
		i = i + 1
	}
	let fe = temp(pos, rt_call(pos, cstr("rt_scope_close_word"), args1(sym_ref_node(pos, cast(Sym, sc.sym))), ty_error), ty_error)
	body = append(body, cast(i64, fe))
	cast(Sym, fe.sym).reads = 1
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = mk_bin(pos, cstr("!="), sym_ref_node(pos, cast(Sym, fe.sym)), mk_int(pos, 0, ty_error), ty_bool)
	ifs.then = empty_block(pos)
	mut vs6 = cast(Block, ifs.then).stmts
	vs6 = append(vs6, fault_return(pos, cast(Block, ifs.then).stmts, sym_ref_node(pos, cast(Sym, fe.sym))))
	body = append(body, cast(i64, ifs))
	let ret = cast(ReturnStmt, node_new(ST_RETURN, pos))
	let rv = []i64{}
	i = 0
	for i < n {
		rv = append(rv, mk_mem(pos, sym_ref_node(pos, cast(Sym, r.sym)), 0, 0, 16 * i, vts[i]))
		i = i + 1
	}
	rv = append(rv, mk_int(pos, 0, ty_error))
	ret.values = cast([]i64, rv)
	body = append(body, cast(i64, ret))
	ck_fn = saved_fn
	return cast(i64, f)
}

// bound_int_arg checks a boundary argument (a duration or a size) as an i64.
fn bound_int_arg(a i64) i64 {
	let at = chk(cast(Node, a), ty_int)
	check_assignable(cast(Node, a), at, cast(Ty, ty_int))
	if is_untyped(at) != 0 {
		reconvert(cast(Node, a), ty_int)
	}
	return a
}

// bound_leaves rejects a return that would leave a boundary block from inside it.
fn bound_leaves(v []i64) {
	mut i = 0
	for i < len(v) {
		let s = v[i]
		let k = cast(Node, s).kind
		if k == ST_RETURN {
			err_code_at(cast(Node, s).pos, cstr("E650 BOUNDARY"), cstr("return cannot leave a boundary block: its value is its last expression (use fail to leave it with a fault)"))
		} else if k == ST_BLOCK {
			bound_leaves(cast(Block, s).stmts)
		} else if k == ST_IF {
			bound_leaves(cast(Block, cast(IfStmt, s).then).stmts)
			if cast(IfStmt, s).else_ != 0 {
				bound_leaves(cast([]i64, one_elem_slice(cast(IfStmt, s).else_)))
			}
		} else if k == ST_WHILE {
			bound_leaves(cast(Block, cast(WhileStmt, s).body).stmts)
		} else if k == ST_RANGE {
			bound_leaves(cast(Block, cast(RangeStmt, s).body).stmts)
		} else if mt_stmt_expr(s) != 0 && cast(Node, mt_stmt_expr(s)).kind == EX_MATCH {
			let arms = cast(MatchExpr, mt_stmt_expr(s)).arms
			mut ai = 0
			for ai < len(arms) {
				if cast(MatchArm, cast([]i64, arms[ai])).block != 0 {
					bound_leaves(cast(Block, cast(MatchArm, cast([]i64, arms[ai])).body).stmts)
				}
				ai = ai + 1
			}
		}
		i = i + 1
	}
}

fn one_elem_slice(x i64) i64 {
	let v = []i64{}
	v = append(v, x)
	return cast(i64, v)
}

// boundary_wrapper builds boundary$N(c, a): it runs closure c (type ct) with a 16-byte result
// cell inside the boundary and returns the value of type vt (ty_void: none) or the fault.
fn boundary_wrapper(pos i64, kind i64, ct i64, vt i64) i64 {
	lifted_count = lifted_count + 1
	let f = fn_new(pos, cstr("boundary"))
	let nb = buf_new()
	buf_str(nb, cstr("boundary$"))
	buf_int(nb, lifted_count)
	buf_byte(nb, 0)
	f.qname = slice_data(nb)
	f.name = slice_data(nb)
	f.lifted = 2
	f.file = ck_file
	f.bang = 1
	f.params = append(f.params, cstr("c"))
	f.ptypes = append(f.ptypes, ct)
	f.params = append(f.params, cstr("a"))
	f.ptypes = append(f.ptypes, ty_int)
	f.params = append(f.params, cstr("a2"))
	f.ptypes = append(f.ptypes, ty_int)
	if kind_of(cast(Ty, vt)) != K_VOID {
		f.rtypes = append(f.rtypes, vt)
	}
	f.rtypes = append(f.rtypes, ty_error)
	f.type_ = func_of(f.ptypes, f.rtypes, 0)
	f.locals = cast([]Sym, []i64{})
	f.body = empty_block(pos)
	prog_fns = append(prog_fns, cast(Fn, f))
	let saved_fn = ck_fn
	ck_fn = cast(Fn, f)
	let cs = sym_new(SYM_LOCAL, cstr("c"), pos)
	cs.type_ = ct
	cs.slot = 0
	let asym = sym_new(SYM_LOCAL, cstr("a"), pos)
	asym.type_ = ty_int
	asym.slot = 1
	let a2sym = sym_new(SYM_LOCAL, cstr("a2"), pos)
	a2sym.type_ = ty_int
	a2sym.slot = 2
	f.slots = 3
	mut vs9 = cast([]i64, f.locals)
	vs9 = append(vs9, cast(i64, cs))
	mut vs10 = cast([]i64, f.locals)
	vs10 = append(vs10, cast(i64, asym))
	mut vs11 = cast([]i64, f.locals)
	vs11 = append(vs11, cast(i64, a2sym))
	let body = cast(Block, f.body).stmts
	let r = temp(pos, rt_call(pos, cstr("rt_alloc"), args1(mk_int(pos, 16, ty_int)), ty_int), ty_int)
	body = append(body, cast(i64, r))
	let rref = sym_ref_node(pos, cast(Sym, r.sym))
	mut fe = cast(LetStmt, 0)
	if kind == BOUND_GUARD {
		fe = temp(pos, rt_call(pos, cstr("rt_guard_call"), args2(sym_ref_node(pos, cs), rref), ty_error), ty_error)
		body = append(body, cast(i64, fe))
	} else if kind == BOUND_LIMIT {
		let la = cast([]i64, args2(sym_ref_node(pos, cs), sym_ref_node(pos, cast(Sym, r.sym))))
		la = append(la, sym_ref_node(pos, asym))
		la = append(la, sym_ref_node(pos, a2sym))
		fe = temp(pos, rt_call(pos, cstr("rt_limit_call"), cast(i64, la), ty_error), ty_error)
		body = append(body, cast(i64, fe))
	} else {
		let wa = cast([]i64, args2(sym_ref_node(pos, cs), sym_ref_node(pos, cast(Sym, r.sym))))
		wa = append(wa, sym_ref_node(pos, asym))
		fe = temp(pos, rt_call(pos, cstr("rt_within_call"), cast(i64, wa), ty_error), ty_error)
		body = append(body, cast(i64, fe))
	}
	cast(Sym, fe.sym).reads = 1
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = mk_bin(pos, cstr("!="), sym_ref_node(pos, cast(Sym, fe.sym)), mk_int(pos, 0, ty_error), ty_bool)
	ifs.then = empty_block(pos)
	mut vs12 = cast(Block, ifs.then).stmts
	vs12 = append(vs12, fault_return(pos, cast(Block, ifs.then).stmts, sym_ref_node(pos, cast(Sym, fe.sym))))
	body = append(body, cast(i64, ifs))
	let ret = cast(ReturnStmt, node_new(ST_RETURN, pos))
	if kind_of(cast(Ty, vt)) == K_VOID {
		ret.value = mk_int(pos, 0, ty_error)
	} else {
		let rv = []i64{}
		rv = append(rv, mk_mem(pos, sym_ref_node(pos, cast(Sym, r.sym)), 0, 0, 0, vt))
		rv = append(rv, mk_int(pos, 0, ty_error))
		ret.values = cast([]i64, rv)
	}
	body = append(body, cast(i64, ret))
	ck_fn = saved_fn
	return cast(i64, f)
}

// ---- arena (#236, notes/interface_arena.md) ----
//
// arena { body } becomes arena$N(c): c is the block's closure func($r i64) !, as for the other
// boundary blocks. arena$N opens the arena, runs c, switches back to the parent pool, copies
// the fault and the value there (arenacopy$N) and frees the arena. A block whose body cannot
// fail has the type of its value; one that can is a !T, used with try or catch.
shared mut ck_arenas []i64 // the closures arena blocks became (region.tin: nothing else leaves them)
shared mut arena_check_fn i64 // the arena closure being checked
shared mut arena_fail_count i64 // fault returns made in it (fault_return)

fn chk_arena(e i64) i64 {
	let pos = cast(Node, e).pos
	let body = cast(Block, cast(BoundaryStmt, e).body)
	bound_leaves(body.stmts)
	let f = fn_new(pos, cstr("func"))
	f.params = append(f.params, cstr("$r"))
	let it = cast(TypeExpr, node_new(TX_NAME, pos))
	it.b = cast(i64, cast([]i64, cstr("i64")))
	f.ptypes = append(f.ptypes, cast(i64, it))
	let ft = cast(TypeExpr, node_new(TX_NAME, pos))
	ft.b = cast(i64, cast([]i64, cstr("fault")))
	f.rtypes = append(f.rtypes, cast(i64, ft))
	f.bang = 1
	let stmts = body.stmts
	let n = len(stmts)
	if n > 0 && cast(Node, stmts[n - 1]).kind == ST_EXPR {
		let last = stmts[n - 1]
		let bs = cast(ExprStmt, node_new(ST_BSTORE, cast(Node, last).pos))
		bs.x = cast(ExprStmt, last).x
		stmts[n - 1] = cast(i64, bs)
	}
	f.body = cast(i64, body)
	if cast(i64, ck_arenas) == 0 {
		ck_arenas = []i64{}
	}
	ck_arenas = append(ck_arenas, cast(i64, f))
	let lit = cast(FuncLit, node_new(EX_FUNCLIT, pos))
	lit.fn_ = cast(i64, f)
	lit.escape = 0
	let saved_t = bound_t
	let saved_fn = arena_check_fn
	let saved_count = arena_fail_count
	bound_t = ty_void
	arena_check_fn = cast(i64, f)
	arena_fail_count = 0
	let ct = chk_funclit(cast(i64, lit))
	let vt = bound_t
	let fails = i64(arena_fail_count > 0)
	bound_t = saved_t
	arena_check_fn = saved_fn
	arena_fail_count = saved_count
	arena_value_check(pos, vt)
	let w = cast(Fn, arena_wrapper(pos, ct, vt, fails))
	let c = node_new(EX_CALL, pos)
	cast(Call, c).name = w.name
	cast(Call, c).fn_ = cast(i64, w)
	cast(Call, c).args = cast([]i64, args1(cast(i64, lit)))
	let results = []i64{}
	if kind_of(cast(Ty, vt)) != K_VOID {
		results = append(results, vt)
	}
	if fails != 0 {
		results = append(results, ty_error)
	}
	mut rt = ty_void
	if len(cast([]i64, results)) == 1 {
		rt = results[0]
	} else if len(cast([]i64, results)) > 1 {
		rt = tuple_of(cast(i64, results))
	}
	cast(Node, c).type_ = rt
	replace_node(e, c)
	return rt
}

// arena_value_check reports a value type the arena cannot copy out: one holding a func or dyn
// value (their objects are not described by the type), or a recursive one.
fn arena_value_check(pos i64, vt i64) {
	mut bad = cstr("")
	if arena_copyable(cast(Ty, vt), []i64{}) == 0 {
		bad = cstr(" holds a func or dyn value, which cannot be copied: return the data it needs instead")
	} else if type_cycle(cast(Ty, vt), cast([]Ty, []i64{})) != 0 {
		bad = cstr(" is recursive, so it cannot be copied: return a value of a non-recursive type")
	}
	if i64(load8(bad)) != 0 {
		let m = err_code(pos, cstr("E316 ARENA_VALUE"))
		buf_str(m, cstr("an arena block's value is copied out of the arena, but type "))
		type_name(cast([]u8, m), cast(Ty, vt))
		buf_str(m, bad)
		err_end(cast([]u8, m))
	}
}

// arena_wrapper builds arena$N(c): it runs closure c (type ct) with a 16-byte result cell in
// a new arena and returns the copied value of type vt (ty_void: none), and the fault if fails.
fn arena_wrapper(pos i64, ct i64, vt i64, fails i64) i64 {
	lifted_count = lifted_count + 1
	let f = fn_new(pos, cstr("arena"))
	let nb = buf_new()
	buf_str(nb, cstr("arena$"))
	buf_int(nb, lifted_count)
	buf_byte(nb, 0)
	f.qname = slice_data(nb)
	f.name = slice_data(nb)
	f.lifted = 2
	f.file = ck_file
	f.bang = fails
	f.params = append(f.params, cstr("c"))
	f.ptypes = append(f.ptypes, ct)
	if kind_of(cast(Ty, vt)) != K_VOID {
		f.rtypes = append(f.rtypes, vt)
	}
	if fails != 0 {
		f.rtypes = append(f.rtypes, ty_error)
	}
	f.type_ = func_of(f.ptypes, f.rtypes, 0)
	f.locals = cast([]Sym, []i64{})
	f.body = empty_block(pos)
	prog_fns = append(prog_fns, cast(Fn, f))
	let saved_fn = ck_fn
	ck_fn = cast(Fn, f)
	let cs = sym_new(SYM_LOCAL, cstr("c"), pos)
	cs.type_ = ct
	cs.slot = 0
	f.slots = 1
	mut vs5 = cast([]i64, f.locals)
	vs5 = append(vs5, cast(i64, cs))
	let body = cast(Block, f.body).stmts
	let r = temp(pos, rt_call(pos, cstr("rt_alloc"), args1(mk_int(pos, 16, ty_int)), ty_int), ty_int)
	body = append(body, cast(i64, r))
	let a = temp(pos, rt_call(pos, cstr("rt_arena_open"), cast(i64, []i64{}), ty_int), ty_int)
	body = append(body, cast(i64, a))
	let fe = temp(pos, rt_call(pos, cstr("rt_arena_run"), args2(sym_ref_node(pos, cs), sym_ref_node(pos, cast(Sym, r.sym))), ty_error), ty_error)
	body = append(body, cast(i64, fe))
	cast(Sym, fe.sym).reads = 1
	body = append(body, expr_stmt(cast(Node, rt_call(pos, cstr("rt_arena_out"), args1(sym_ref_node(pos, cast(Sym, a.sym))), ty_void))))
	body = append(body, assign_stmt(pos, sym_ref_node(pos, cast(Sym, fe.sym)), rt_call(pos, cstr("rt_arena_fault"), args1(sym_ref_node(pos, cast(Sym, fe.sym))), ty_error)))
	if is_ref(vt) != 0 {
		let ifs = cast(IfStmt, node_new(ST_IF, pos))
		ifs.cond = mk_bin(pos, cstr("=="), sym_ref_node(pos, cast(Sym, fe.sym)), mk_int(pos, 0, ty_error), ty_bool)
		ifs.then = empty_block(pos)
		let src = mk_mem(pos, sym_ref_node(pos, cast(Sym, r.sym)), 0, 0, 0, vt)
		mut vs6 = cast(Block, ifs.then).stmts
		vs6 = append(vs6, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, cast(Sym, r.sym)), 0, 0, 0, vt), keep_call(pos, arenacopy_fn(cast(Ty, vt)), src, vt)))
		body = append(body, cast(i64, ifs))
	}
	body = append(body, expr_stmt(cast(Node, rt_call(pos, cstr("rt_arena_close"), args1(sym_ref_node(pos, cast(Sym, a.sym))), ty_void))))
	if fails != 0 {
		let ifs2 = cast(IfStmt, node_new(ST_IF, pos))
		ifs2.cond = mk_bin(pos, cstr("!="), sym_ref_node(pos, cast(Sym, fe.sym)), mk_int(pos, 0, ty_error), ty_bool)
		ifs2.then = empty_block(pos)
		mut vs7 = cast(Block, ifs2.then).stmts
		vs7 = append(vs7, fault_return(pos, cast(Block, ifs2.then).stmts, sym_ref_node(pos, cast(Sym, fe.sym))))
		body = append(body, cast(i64, ifs2))
	}
	let ret = cast(ReturnStmt, node_new(ST_RETURN, pos))
	let rv = []i64{}
	if kind_of(cast(Ty, vt)) != K_VOID {
		rv = append(rv, mk_mem(pos, sym_ref_node(pos, cast(Sym, r.sym)), 0, 0, 0, vt))
	}
	if fails != 0 {
		rv = append(rv, mk_int(pos, 0, ty_error))
	}
	if len(cast([]i64, rv)) == 1 {
		ret.value = rv[0]
	} else if len(cast([]i64, rv)) > 1 {
		ret.values = cast([]i64, rv)
	}
	body = append(body, cast(i64, ret))
	ck_fn = saved_fn
	return cast(i64, f)
}

// ---- with policies (#237, notes/interface_policy.md) ----
//
// with p { body } is with$N(c, p): c is the block's closure func($r i64) !, as for the other
// boundary blocks. with$N enters a bkWith boundary, calls p.Run with an adapter func() !T that
// runs c and gives the value c stored, leaves the boundary and returns what Run gave.
shared mut with_fill_calls []i64 // the policy calls whose open type parameters take with_fill_t (generic_call)
shared mut with_fill_t i64
shared mut with_runs []i64 // [Run method, with position] pairs: Run may only call its body (region.tin)

fn chk_with(e i64) i64 {
	let pos = cast(Node, e).pos
	let body = cast(Block, cast(BoundaryStmt, e).body)
	bound_leaves(body.stmts)
	let f = fn_new(pos, cstr("func"))
	f.params = append(f.params, cstr("$r"))
	let it = cast(TypeExpr, node_new(TX_NAME, pos))
	it.b = cast(i64, cast([]i64, cstr("i64")))
	f.ptypes = append(f.ptypes, cast(i64, it))
	let ft = cast(TypeExpr, node_new(TX_NAME, pos))
	ft.b = cast(i64, cast([]i64, cstr("fault")))
	f.rtypes = append(f.rtypes, cast(i64, ft))
	f.bang = 1
	let stmts = body.stmts
	let n = len(stmts)
	if n > 0 && cast(Node, stmts[n - 1]).kind == ST_EXPR {
		let last = stmts[n - 1]
		let bs = cast(ExprStmt, node_new(ST_BSTORE, cast(Node, last).pos))
		bs.x = cast(ExprStmt, last).x
		stmts[n - 1] = cast(i64, bs)
	}
	f.body = cast(i64, body)
	let lit = cast(FuncLit, node_new(EX_FUNCLIT, pos))
	lit.fn_ = cast(i64, f)
	lit.escape = 0
	let saved_t = bound_t
	bound_t = ty_void
	let ct = chk_funclit(cast(i64, lit))
	let vt = bound_t
	bound_t = saved_t
	// The policy, after the block: the type parameters its constructor (and the calls whose
	// receiver it is) leave open are the block's type, u8 for a block without a value.
	let pe = cast(Node, cast(BoundaryStmt, e).args[0])
	let saved_calls = with_fill_calls
	let saved_fill = with_fill_t
	with_fill_calls = []i64{}
	with_fill_t = vt
	if kind_of(cast(Ty, vt)) == K_VOID {
		with_fill_t = ty_byte
	}
	mut x = pe
	for cast(Node, x).kind == EX_CALL {
		with_fill_calls = append(with_fill_calls, cast(i64, x))
		let cx = cast(Call, x).callee
		if cx == 0 || cast(Node, cx).kind != EX_SELECT {
			break
		}
		x = cast(Node, cast(SelectExpr, cx).x)
	}
	let pt = cast(Ty, chk(cast(Node, pe), 0))
	with_fill_calls = saved_calls
	with_fill_t = saved_fill
	if kind_of(pt) == K_DYN {
		err_code_type(pe.pos, cstr("E652 POLICY"), cstr("a with policy is called directly so that its Run can be checked: use the concrete type, not "), cast(i64, pt), cstr(""))
		return with_failed(cast(Node, e), vt)
	}
	mut run = cast(Fn, 0)
	if kind_of(pt) == K_STRUCT {
		run = find_fn(str_cat3(pt.name, cstr("."), cstr("Run")))
	}
	if cast(i64, run) == 0 {
		err_code_type(pe.pos, cstr("E652 POLICY"), cstr(""), cast(i64, pt), cstr(" is not a policy: with needs a value with a method Run(body func() !T) !T"))
		return with_failed(cast(Node, e), vt)
	}
	// Run(body func() !T) !T, or Run(body func() !) !: the body has Run's own results.
	let rps = run.ptypes
	let rrs = run.rtypes
	let bt = func_of([]i64{}, cast([]i64, rrs), 0)
	mut tt = ty_void
	if len(rrs) == 2 {
		tt = rrs[0]
	}
	let shaped = i64(run.bang != 0 && len(rps) == 2 && rps[1] == bt && run.muts[1] == 0)
	if shaped == 0 || len(rrs) < 1 || len(rrs) > 2 || kind_of(cast(Ty, rrs[len(rrs) - 1])) != K_ERROR {
		err_code_type(pe.pos, cstr("E652 POLICY"), cstr(""), cast(i64, pt), cstr(" is not a policy: its Run must be Run(body func() !T) !T"))
		return with_failed(cast(Node, e), vt)
	}
	if kind_of(cast(Ty, vt)) != K_VOID && kind_of(cast(Ty, tt)) == K_VOID {
		with_error(pos, cstr("the block gives a "), vt, cstr(", but the Run of its policy "), cast(i64, pt), cstr(" runs a body without a value"))
		return with_failed(cast(Node, e), vt)
	}
	if kind_of(cast(Ty, vt)) != K_VOID && tt != vt {
		err_code_types(pos, cstr("E652 POLICY"), cstr("the block gives a "), vt, cstr(", but its policy runs a body of type "), bt)
		return with_failed(cast(Node, e), vt)
	}
	if kind_of(cast(Ty, vt)) == K_VOID && kind_of(cast(Ty, tt)) != K_VOID && with_scalar(tt) == 0 {
		with_error(pos, cstr("the block gives no value, but its policy "), cast(i64, pt), cstr(" needs one of type "), tt, cstr(""))
		return with_failed(cast(Node, e), vt)
	}
	let w = cast(Fn, with_wrapper(pos, ct, cast(i64, pt), bt, tt, vt))
	let c = node_new(EX_CALL, pos)
	cast(Call, c).name = w.name
	cast(Call, c).fn_ = cast(i64, w)
	cast(Call, c).args = cast([]i64, args2(cast(i64, lit), cast(i64, pe)))
	mut rt = ty_error
	if kind_of(cast(Ty, vt)) != K_VOID {
		let results = []i64{}
		results = append(results, vt)
		results = append(results, ty_error)
		rt = tuple_of(cast(i64, results))
	}
	cast(Node, c).type_ = rt
	replace_node(e, c)
	return rt
}

// with_failed stands in for a with that was rejected: a call of the type the with would have,
// so its catch or try reports nothing more.
fn with_failed(e Node, vt i64) i64 {
	mut rt = ty_error
	if kind_of(cast(Ty, vt)) != K_VOID {
		let results = []i64{}
		results = append(results, vt)
		results = append(results, ty_error)
		rt = tuple_of(cast(i64, results))
	}
	let c = node_new(EX_CALL, e.pos)
	cast(Call, c).name = cstr("with")
	cast(Call, c).args = []i64{}
	cast(Node, c).type_ = rt
	replace_node(cast(i64, e), c)
	return rt
}

// with_error reports a with block whose value does not fit its policy.
fn with_error(pos i64, a i64, ta i64, b i64, tb i64, c i64) {
	let m = err_code(pos, cstr("E652 POLICY"))
	buf_str(m, a)
	type_name(cast([]u8, m), cast(Ty, ta))
	buf_str(m, b)
	type_name(cast([]u8, m), cast(Ty, tb))
	buf_str(m, c)
	err_end(cast([]u8, m))
}

// with_scalar reports whether a body without a value can give t's zero to its policy.
fn with_scalar(t i64) i64 {
	let k = kind_of(cast(Ty, t))
	return i64(k == K_INT || k == K_BYTE || k == K_BOOL || is_float_t(t) != 0)
}

// with_wrapper builds with$N(c, p) for policy type pt, whose Run takes a body of type bt
// giving tt (ty_void: none); the with gives vt (ty_void: none). The adapter's descriptor
// [code, 2, c, cell, 0] and the value cell live on with$N's frame, which outlives every run
// of the body because Run cannot keep it (notes/interface_policy.md §3). p is mut so that a
// Run with a mut receiver may change it; the region pass judges the with's own policy value.
fn with_wrapper(pos i64, ct i64, pt i64, bt i64, tt i64, vt i64) i64 {
	let rmut = 1
	lifted_count = lifted_count + 1
	let f = fn_new(pos, cstr("with"))
	let nb = buf_new()
	buf_str(nb, cstr("with$"))
	buf_int(nb, lifted_count)
	buf_byte(nb, 0)
	f.qname = slice_data(nb)
	f.name = slice_data(nb)
	f.lifted = 2
	f.done = 1
	f.file = ck_file
	f.bang = 1
	f.params = append(f.params, cstr("c"))
	f.ptypes = append(f.ptypes, ct)
	f.muts = append(f.muts, 0)
	f.params = append(f.params, cstr("$p"))
	f.ptypes = append(f.ptypes, pt)
	f.muts = append(f.muts, rmut)
	if kind_of(cast(Ty, vt)) != K_VOID {
		f.rtypes = append(f.rtypes, vt)
	}
	f.rtypes = append(f.rtypes, ty_error)
	f.type_ = func_of_m(f.ptypes, f.rtypes, 0, mut_mask(f.muts))
	f.locals = cast([]Sym, []i64{})
	f.body = empty_block(pos)
	prog_fns = append(prog_fns, cast(Fn, f))
	let adapt = with_adapter(pos, f, ct, cast(Ty, bt), tt, vt)
	let saved_fn = ck_fn
	ck_fn = cast(Fn, f)
	let cs = sym_new(SYM_LOCAL, cstr("c"), pos)
	cs.type_ = ct
	cs.slot = 0
	cs.reads = 1
	let ps = sym_new(SYM_LOCAL, cstr("$p"), pos)
	ps.type_ = pt
	ps.slot = 1
	ps.mut_ = rmut
	ps.reads = 1
	f.slots = 2
	mut vs9 = cast([]i64, f.locals)
	vs9 = append(vs9, cast(i64, cs))
	mut vs10 = cast([]i64, f.locals)
	vs10 = append(vs10, cast(i64, ps))
	let body = cast(Block, f.body).stmts
	let cell = cast(Sym, declare_local(pos, cstr("$cell"), ty_int))
	cell.addr = 1
	cell.words = 2
	let desc = cast(Sym, declare_local(pos, cstr("$desc"), ty_int))
	desc.addr = 1
	desc.words = 5
	let da = temp(pos, mk_unary(pos, cstr("&"), sym_ref_node(pos, desc)), ty_int)
	body = append(body, cast(i64, da))
	let code = node_new(EX_FUNCREF, pos)
	cast(FuncRef, code).fn_ = adapt
	cast(FuncRef, code).raw = 1
	cast(Node, code).type_ = ty_int
	body = append(body, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, cast(Sym, da.sym)), 0, 0, 0, ty_int), code))
	body = append(body, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, cast(Sym, da.sym)), 0, 0, 8, ty_int), mk_int(pos, 2, ty_int)))
	body = append(body, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, cast(Sym, da.sym)), 0, 0, 16, ct), sym_ref_node(pos, cs)))
	body = append(body, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, cast(Sym, da.sym)), 0, 0, 24, ty_int), mk_unary(pos, cstr("&"), sym_ref_node(pos, cell))))
	body = append(body, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, cast(Sym, da.sym)), 0, 0, 32, ty_int), mk_int(pos, 0, ty_int)))
	let dv = temp(pos, sym_ref_node(pos, cast(Sym, da.sym)), bt)
	body = append(body, cast(i64, dv))
	let bd = temp(pos, rt_call(pos, cstr("rt_bnd_enter"), args1(mk_int(pos, 10, ty_int)), ty_int), ty_int)
	body = append(body, cast(i64, bd))
	// p.Run(adapter), checked like any method call.
	let sel = cast(SelectExpr, node_new(EX_SELECT, pos))
	sel.x = sym_ref_node(pos, ps)
	sel.name = cstr("Run")
	let call = node_new(EX_CALL, pos)
	cast(Call, call).callee = cast(i64, sel)
	cast(Call, call).args = cast([]i64, args1(sym_ref_node(pos, cast(Sym, dv.sym))))
	chk(cast(Node, call), 0)
	if cast(i64, with_runs) == 0 {
		with_runs = []i64{}
	}
	mut vs11 = cast([]i64, with_runs)
	vs11 = append(vs11, cast(Call, call).fn_)
	mut vs12 = cast([]i64, with_runs)
	vs12 = append(vs12, pos)
	mut vs = 0
	mut fes = cast(Sym, 0)
	if kind_of(cast(Ty, tt)) != K_VOID {
		let cm = cast(CallMultiStmt, node_new(ST_CALLMULTI, pos))
		cm.call = call
		cm.syms = cast([]Sym, []i64{})
		vs = declare_local(pos, cstr("$"), tt)
		fes = cast(Sym, declare_local(pos, cstr("$"), ty_error))
		mut vs13 = cast([]i64, cm.syms)
		vs13 = append(vs13, vs)
		mut vs14 = cast([]i64, cm.syms)
		vs14 = append(vs14, cast(i64, fes))
		cast(Node, call).type_ = ty_void
		body = append(body, cast(i64, cm))
	} else {
		let fe = temp(pos, call, ty_error)
		body = append(body, cast(i64, fe))
		fes = cast(Sym, fe.sym)
	}
	fes.reads = 1
	body = append(body, expr_stmt(cast(Node, rt_call(pos, cstr("rt_bnd_leave"), args1(sym_ref_node(pos, cast(Sym, bd.sym))), ty_void))))
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = mk_bin(pos, cstr("!="), sym_ref_node(pos, fes), mk_int(pos, 0, ty_error), ty_bool)
	ifs.then = empty_block(pos)
	mut vs15 = cast(Block, ifs.then).stmts
	vs15 = append(vs15, fault_return(pos, cast(Block, ifs.then).stmts, sym_ref_node(pos, fes)))
	body = append(body, cast(i64, ifs))
	let ret = cast(ReturnStmt, node_new(ST_RETURN, pos))
	if kind_of(cast(Ty, vt)) == K_VOID {
		ret.value = mk_int(pos, 0, ty_error)
	} else {
		let rv = []i64{}
		rv = append(rv, sym_ref_node(pos, cast(Sym, vs)))
		rv = append(rv, mk_int(pos, 0, ty_error))
		ret.values = cast([]i64, rv)
	}
	body = append(body, cast(i64, ret))
	ck_fn = saved_fn
	return cast(i64, f)
}

// with_adapter builds with$N$body, the func() !T a policy runs: its closure environment (X17)
// is with$N's descriptor; it calls the block's closure with the cell and gives the value.
fn with_adapter(pos i64, w Fn, ct i64, bt Ty, tt i64, vt i64) i64 {
	let a = fn_new(pos, cstr("func"))
	let nb = buf_new()
	buf_str(nb, w.name)
	buf_str(nb, cstr("$body"))
	buf_byte(nb, 0)
	a.qname = slice_data(nb)
	a.name = slice_data(nb)
	a.lifted = 2
	a.done = 1
	a.file = ck_file
	a.bang = 1
	mut i = 0
	for i < len(bt.results) {
		a.rtypes = append(a.rtypes, bt.results[i])
		i = i + 1
	}
	a.type_ = cast(i64, bt)
	a.locals = cast([]Sym, []i64{})
	a.body = empty_block(pos)
	prog_fns = append(prog_fns, cast(Fn, a))
	let saved_fn = ck_fn
	ck_fn = cast(Fn, a)
	let env = cast(Sym, declare_local(pos, cstr("$env"), ty_int))
	env.reads = 1
	a.env_sym = cast(i64, env)
	let body = cast(Block, a.body).stmts
	let call = cast(Call, node_new(EX_CALL, pos))
	call.callee = mk_mem(pos, sym_ref_node(pos, env), 0, 0, 16, ct)
	call.args = cast([]i64, args1(mk_mem(pos, sym_ref_node(pos, env), 0, 0, 24, ty_int)))
	chk(cast(Node, call), 0)
	let fe = temp(pos, cast(i64, call), ty_error)
	body = append(body, cast(i64, fe))
	cast(Sym, fe.sym).reads = 1
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = mk_bin(pos, cstr("!="), sym_ref_node(pos, cast(Sym, fe.sym)), mk_int(pos, 0, ty_error), ty_bool)
	ifs.then = empty_block(pos)
	mut vs2 = cast(Block, ifs.then).stmts
	vs2 = append(vs2, fault_return(pos, cast(Block, ifs.then).stmts, sym_ref_node(pos, cast(Sym, fe.sym))))
	body = append(body, cast(i64, ifs))
	let ret = cast(ReturnStmt, node_new(ST_RETURN, pos))
	if kind_of(cast(Ty, tt)) == K_VOID {
		ret.value = mk_int(pos, 0, ty_error)
	} else {
		let rv = []i64{}
		if kind_of(cast(Ty, vt)) == K_VOID && is_float_t(tt) != 0 {
			rv = append(rv, zero_value(pos, tt))
		} else if kind_of(cast(Ty, vt)) == K_VOID {
			rv = append(rv, mk_int(pos, 0, tt))
		} else {
			rv = append(rv, mk_mem(pos, mk_mem(pos, sym_ref_node(pos, env), 0, 0, 24, ty_int), 0, 0, 0, vt))
		}
		rv = append(rv, mk_int(pos, 0, ty_error))
		ret.values = cast([]i64, rv)
	}
	body = append(body, cast(i64, ret))
	ck_fn = saved_fn
	return cast(i64, a)
}

// ---- calls ----
// mask has bit i set when parameter i is mut: its argument must be written `mut x`
// (a method's receiver, argument 0 of a CALL_METHOD call, is exempt).
fn chk_args(e i64, ptypes []i64, variadic i64, mask i64) {
	let args = cast(Call, e).args
	let n = len(ptypes)
	if len(args) != n && !(variadic != 0 && len(args) >= n) {
		let a = err_code(cast(Node, e).pos, cstr("E210 ARG_COUNT"))
		if cast(Call, e).name != 0 {
			buf_str(cast([]u8, a), cast(Call, e).name)
		} else {
			buf_str(cast([]u8, a), cstr("function"))
		}
		buf_str(cast([]u8, a), cstr(" expects "))
		buf_int(cast([]u8, a), n)
		buf_str(cast([]u8, a), cstr(" arguments, got "))
		buf_int(cast([]u8, a), len(args))
		err_end(cast([]u8, a))
	}
	mut i = 0
	for i < len(args) {
		let a = args[i]
		let marked = unwrap_mut(a)
		if !(i == 0 && cast(Call, e).method != 0) {
			let pm = i64(i < n && i < 63 && (mask & (1 << i)) != 0)
			if pm != 0 && marked == 0 {
				mut_arg_error(cast(Call, e), cast(Node, a), i, cstr("is a mut parameter: write mut before the argument"))
			} else if marked != 0 && pm == 0 {
				mut_arg_error(cast(Call, e), cast(Node, a), i, cstr("is not a mut parameter: remove mut"))
			}
		}
		mut want = 0
		if i < n {
			want = ptypes[i]
		}
		let adesc = secret_desc(a)
		let at = chk(cast(Node, a), want)
		if i < n {
			secret_arg(cast(Call, e), i, adesc, at, want)
			check_assignable(cast(Node, a), at, cast(Ty, want))
			secret_arg_done()
			if is_untyped(at) != 0 {
				reconvert(cast(Node, a), want)
			}
		}
		if i >= n && is_untyped(at) != 0 {
			reconvert(cast(Node, a), default_type(at))
		}
		i = i + 1
	}
}

// unwrap_mut turns `mut x` back into x and reports whether it was marked.
fn unwrap_mut(a i64) i64 {
	if cast(Node, a).kind != EX_MUTARG {
		return 0
	}
	shared_let_write(cast(Node, a).pos, cast(MutArg, a).x)
	replace_node(a, cast(MutArg, a).x)
	return 1
}

fn mut_arg_error(e Call, a Node, i i64, what i64) {
	let m = err_code(a.pos, cstr("E705 MUT_ARG"))
	buf_str(m, cstr("argument "))
	if e.method != 0 {
		buf_int(m, i)
	} else {
		buf_int(m, i + 1)
	}
	buf_str(m, cstr(" of "))
	if e.name != 0 {
		buf_str(m, e.name)
	} else {
		buf_str(m, cstr("this call"))
	}
	buf_byte(m, ' ')
	buf_str(m, what)
	err_end(cast([]u8, m))
}

fn result_type(f Fn) i64 {
	let rs = f.rtypes
	if len(rs) == 0 {
		return ty_void
	}
	if len(rs) == 1 {
		return rs[0]
	}
	return tuple_of(cast(i64, rs))
}

fn func_result(ft Ty) i64 {
	let rs = ft.results
	if len(rs) == 0 {
		return ty_void
	}
	if len(rs) == 1 {
		return rs[0]
	}
	return tuple_of(cast(i64, rs))
}

fn direct_call(e Call, f Fn) i64 {
	if is_template(f) != 0 {
		return generic_call(cast(i64, e), f)
	}
	e.fn_ = cast(i64, f)
	e.callee = 0
	chk_args(cast(i64, e), f.ptypes, f.variadic, mut_mask(f.muts))
	return result_type(f)
}

fn chk_call(e i64, want i64) i64 {
	sb_call(cast(Call, e))
	let name = cast(Call, e).name
	let callee = cast(Call, e).callee
	if name != 0 {
		let s = lookup_name(name)
		if cast(i64, s) != 0 && s.kind == SYM_FUNC {
			runtime_use(cast(Node, e).pos, cast(Fn, s.fn_), name)
			return direct_call(cast(Call, e), cast(Fn, s.fn_))
		}
		if cast(i64, s) != 0 && (s.kind == SYM_LOCAL || s.kind == SYM_GLOBAL) && kind_of(cast(Ty, s.type_)) == K_FUNC {
			let id = cast(IdentExpr, node_new(EX_IDENT, cast(Node, e).pos))
			id.name = name
			cast(Call, e).callee = cast(i64, id)
			cast(Call, e).name = 0
			return indirect_call(e)
		}
		if cast(i64, s) == 0 {
			let n = intrinsic_arity(name)
			if n >= 0 {
				if ck_trusted == 0 {
					err_code_quoted(cast(Node, e).pos, cstr("E802 RUNTIME_INTERNAL"), cstr(""), name, cstr(" is internal to the runtime"))
				}
				cast(Call, e).intrinsic = 1
				if len(cast(Call, e).args) != n {
					arity_error(e, n)
				}
				mut i = 0
				for i < len(cast(Call, e).args) {
					let a = cast(Call, e).args[i]
					chk(cast(Node, a), ty_int)
					reconvert(cast(Node, a), ty_int)
					i = i + 1
				}
				if streq(name, cstr("load8")) != 0 {
					return ty_byte
				}
				return ty_int
			}
			let bt = chk_builtin(e, name, want)
			if bt != 0 {
				return bt
			}
			let tt = find_type_name(name)
			if tt != 0 {
				return chk_conversion(e, cast(Ty, tt))
			}
			let u = err_code(cast(Node, e).pos, cstr("E103 UNDEFINED"))
			buf_str(u, cstr("undefined function: "))
			buf_str(u, name)
			err_end(cast([]u8, u))
			return ty_int
		}
		err_code_quoted(cast(Node, e).pos, cstr("E215 NOT_CALLABLE"), cstr(""), name, cstr(" is not a function"))
		return ty_int
	}
	let gx = explicit_generic(callee)
	if gx != 0 {
		let inst = instantiate_fn(cast(Fn, gx), cast([]Ty, resolve_types(cast([]i64, index_targs(callee)))), cast(Node, e).pos)
		cast(Call, e).name = inst.qname
		return direct_call(cast(Call, e), inst)
	}
	if cast(Node, callee).kind == EX_SELECT {
		let x = cast(SelectExpr, callee).x
		let m = cast(SelectExpr, callee).name
		let et = enum_type_of(x)
		if et != 0 {
			return enum_construct(cast(Node, e), cast(Ty, et), m, cast(Call, e).args)
		}
		if cast(Node, x).kind == EX_IDENT && lookup_name_local(cast(IdentExpr, x).name) == 0 && import_pkg(cast(IdentExpr, x).name) != 0 {
			let pkg = import_pkg(cast(IdentExpr, x).name)
			if streq(pkg, cstr("say")) != 0 && is_say_func(m) != 0 {
				return lower_say(e, m, want)
			}
			if streq(pkg, cstr("argo")) != 0 && streq(m, cstr("Put")) != 0 {
				return lower_argo_put(e)
			}
			if streq(pkg, cstr("argo")) != 0 && streq(m, cstr("Get")) != 0 {
				return lower_argo_get(e, 0)
			}
			if streq(pkg, cstr("argo")) != 0 && streq(m, cstr("GetStrict")) != 0 {
				return lower_argo_get(e, 1)
			}
			let s = cast(Sym, pkg_member(pkg, m))
			if cast(i64, s) != 0 && is_private(m) != 0 {
				private_use(cast(Node, e).pos, cstr("function"), m, pkg)
			}
			if cast(i64, s) != 0 && s.kind == SYM_FUNC {
				cast(Call, e).name = s.name
				return direct_call(cast(Call, e), cast(Fn, s.fn_))
			}
			let pt = find_type(str_cat3(pkg, cstr("."), m))
			if pt != 0 {
				return chk_conversion(e, cast(Ty, pt))
			}
			let ov = cast(Fn, overload(pkg, m, cast(Call, e)))
			if cast(i64, ov) != 0 {
				cast(Call, e).name = ov.qname
				return direct_call(cast(Call, e), ov)
			}
			let u = err_code(cast(Node, e).pos, cstr("E103 UNDEFINED"))
			buf_str(u, cstr("undefined: "))
			buf_str(u, cast(IdentExpr, x).name)
			buf_byte(u, '.')
			buf_str(u, m)
			err_end(cast([]u8, u))
			return ty_int
		}
		let xt = cast(Ty, chk(cast(Node, x), 0))
		if kind_of(xt) == K_OPT {
			err_code_type(cast(Node, e).pos, cstr("E421 UNCHECKED_OPTIONAL"), cstr("cannot call a method of optional "), cast(i64, xt), cstr(" before checking it against nil"))
			return ty_int
		}
		if kind_of(xt) == K_STRUCT {
			// s.spawn(f) for f with a value gives a spawnedOf[T] (#232).
			let sv = spawn_value(e, x, cast(i64, xt), m)
			if sv != 0 {
				return sv
			}
			let mf = find_fn(str_cat3(xt.name, cstr("."), m))
			if cast(i64, mf) != 0 && is_private(m) != 0 && foreign_type(xt) != 0 {
				private_use(cast(Node, e).pos, cstr("method"), m, type_pkg(xt))
			}
			if cast(i64, mf) != 0 {
				let args = []i64{}
				args = append(args, x)
				mut i = 0
				for i < len(cast(Call, e).args) {
					args = append(args, cast(Call, e).args[i])
					i = i + 1
				}
				cast(Call, e).args = cast([]i64, args)
				cast(Call, e).name = mf.qname
				cast(Call, e).method = 1
				return direct_call(cast(Call, e), mf)
			}
			let fi = struct_field(xt, m)
			if fi >= 0 && kind_of(cast(Ty, field_type(xt, fi))) == K_FUNC {
				cast(Call, e).callee = mk_mem(cast(Node, e).pos, x, 0, 0, field_offset(xt, fi), field_type(xt, fi))
				return indirect_call(e)
			}
			let u = err_code(cast(Node, e).pos, cstr("E214 METHOD"))
			type_name(cast([]u8, u), xt)
			buf_str(u, cstr(" has no method "))
			buf_str(u, m)
			err_end(cast([]u8, u))
			return ty_int
		}
		if kind_of(xt) == K_ERROR && streq(m, cstr("Error")) != 0 {
			replace_node(e, rt_call(cast(Node, e).pos, cstr("rt_err_str"), args1(x), ty_string))
			cast(Node, e).type_ = 0
			return ty_string
		}
		if kind_of(xt) == K_DYN {
			return lower_dyn_method_call(e, x, xt, m)
		}
		err_code_type(cast(Node, e).pos, cstr("E214 METHOD"), cstr("cannot call a method on "), cast(i64, xt), cstr(""))
		return ty_int
	}
	if cast(Node, callee).kind == EX_TYPE {
		return chk_conversion(e, cast(Ty, resolve_type(callee[TYX])))
	}
	return indirect_call(e)
}

// lower_dyn_method_call checks the explicit arguments against the flattened shape
// signature, then builds an ordinary indirect call whose first ABI argument is the
// object word and whose callee is the method descriptor loaded from the table.
fn lower_dyn_method_call(e i64, receiver i64, dt Ty, name i64) i64 {
	let pos = cast(Node, e).pos
	let info = cast([]i64, dyn_shape_method(dt, name))
	if cast(i64, info) == 0 {
		let m = err_code(pos, cstr("E214 METHOD"))
		buf_str(m, cstr("dyn shape "))
		buf_str(m, cast(Decl, dt.gdecl).name)
		buf_str(m, cstr(" has no method "))
		buf_str(m, name)
		err_end(cast([]u8, m))
		return ty_int
	}
	let sig = cast([]i64, info[1])
	let names = sig[0]
	let ps = cast([]i64, sig[1])
	let ms = cast([]i64, sig[2])
	let rs = cast([]i64, sig[3])
	let variadic = sig[4]
	mut mutmask = 0
	mut i = 0
	for i < len(ms) && i < 63 {
		if ms[i] != 0 {
			mutmask = mutmask | (1 << i)
		}
		i = i + 1
	}
	cast(Call, e).name = name
	chk_args(e, ps, variadic, mutmask)

	// A method receiver may itself be an expression with effects. Store its pair once;
	// both the object argument and descriptor lookup then read the same value.
	let receiver_temp = temp(pos, receiver, cast(i64, dt))
	let receiver_ref = sym_ref_node(pos, cast(Sym, receiver_temp.sym))
	let object = mk_conv(pos, receiver_ref, CV_DYN_OBJECT, ty_int)
	let desc_params = []i64{}
	desc_params = append(desc_params, ty_int)
	i = 0
	for i < len(ps) {
		desc_params = append(desc_params, ps[i])
		i = i + 1
	}
	mut desc_mask = 0
	i = 0
	for i < len(ms) && i < 62 {
		if ms[i] != 0 {
			desc_mask = desc_mask | (1 << (i + 1))
		}
		i = i + 1
	}
	let ft = func_of_m(cast([]i64, desc_params), rs, variadic, desc_mask)
	let desc = cast(Conv, mk_conv(pos, receiver_ref, CV_DYN_DESC, ft))
	desc.dyn_index = info[0]

	let inner = node_new(EX_CALL, pos)
	cast(Call, inner).name = name
	cast(Call, inner).args = cast([]i64, args1(object))
	i = 0
	for i < len(cast(Call, e).args) {
		cast(Call, inner).args = append(cast(Call, inner).args, cast(Call, e).args[i])
		i = i + 1
	}
	cast(Call, inner).callee = cast(i64, desc)
	cast(Call, inner).method = 1
	cast(Call, inner).dyn_shape = cast(i64, dt)
	cast(Call, inner).dyn_index = info[0]
	cast(Node, inner).type_ = func_result(cast(Ty, ft))
	let stmts = []i64{}
	stmts = append(stmts, cast(i64, receiver_temp))
	replace_node(e, mk_seq(pos, cast(i64, stmts), inner, cast(Node, inner).type_))
	return cast(Node, inner).type_
}

// overload picks pkg.Name__suffix by the first argument's element type, the stand-in
// for generics in library functions like sift.Sort.
fn overload(pkg i64, name i64, e Call) i64 {
	let args = e.args
	if len(args) == 0 {
		return 0
	}
	mut t = cast(Ty, chk(cast(Node, args[0]), 0))
	if kind_of(t) == K_SLICE {
		t = cast(Ty, t.elem)
	}
	let b = buf_new()
	buf_str(b, pkg)
	buf_byte(b, '.')
	buf_str(b, name)
	buf_str(b, cstr("__"))
	type_name(cast([]u8, b), cast(Ty, default_type(cast(i64, t))))
	buf_byte(b, 0)
	return cast(i64, find_fn(slice_data(b)))
}

fn indirect_call(e i64) i64 {
	let callee = cast(Call, e).callee
	let ft = cast(Ty, chk(cast(Node, callee), 0))
	if kind_of(ft) != K_FUNC {
		err_code_type(cast(Node, e).pos, cstr("E215 NOT_CALLABLE"), cstr("cannot call a value of type "), cast(i64, ft), cstr(""))
		return ty_int
	}
	cast(Call, e).fn_ = 0
	chk_args(e, ft.fields, 0, ft.key)
	return func_result(ft)
}

// lower_append_dyn passes the object and table as separate scalar arguments to the
// runtime append helper. The pair temporary evaluates a conversion or other expression
// once, and the region pass still sees its object bits through both projections.
fn lower_append_dyn(pos i64, slice i64, value i64, st Ty) i64 {
	let et = st.elem
	let saved = temp(pos, value, et)
	let ref_ = sym_ref_node(pos, cast(Sym, saved.sym))
	let object = mk_conv(pos, ref_, CV_DYN_OBJECT, ty_int)
	let table = mk_conv(pos, ref_, CV_DYN_TABLE_WORD, ty_int)
	let call = rt_call(pos, cstr("rt_append_dyn"), args3(slice, object, table), cast(i64, st))
	let stmts = []i64{}
	stmts = append(stmts, cast(i64, saved))
	return mk_seq(pos, cast(i64, stmts), call, cast(i64, st))
}

fn find_type_name(name i64) i64 {
	if i64(load8(ck_pkg)) != 0 {
		let t = find_type(qual(ck_pkg, name))
		if t != 0 {
			return t
		}
	}
	return find_type(name)
}

fn arg0(e Call) i64 {
	return e.args[0]
}

fn chk_conversion(e i64, to Ty) i64 {
	let pos = cast(Node, e).pos
	if len(cast(Call, e).args) != 1 {
		err_code_type(pos, cstr("E210 ARG_COUNT"), cstr("conversion to "), cast(i64, to), cstr(" needs exactly one argument"))
		return cast(i64, to)
	}
	let x = arg0(cast(Call, e))
	let from = cast(Ty, chk(cast(Node, x), cast(i64, to)))
	if saw_secret != 0 && (is_secret(from) != 0 || is_secret(to) != 0) {
		return secret_conversion(e, cast(Node, x), from, cast(i64, to))
	}
	let fk = kind_of(from)
	let tk = kind_of(to)
	if cast(i64, from) == cast(i64, to) || (is_untyped(cast(i64, from)) != 0 && assignable(from, to) != 0) {
		if is_untyped(cast(i64, from)) != 0 {
			reconvert(cast(Node, x), cast(i64, to))
		}
		replace_node(e, x)
		return cast(i64, to)
	}
	if tk == K_FLOAT && is_integer_t(cast(i64, from)) != 0 {
		if is_untyped(cast(i64, from)) != 0 {
			reconvert(cast(Node, x), ty_int)
		}
		if is_f32(to) != 0 {
			replace_node(e, mk_conv(pos, mk_conv(pos, x, CV_I2F, ty_float), CV_ROUND32, ty_f32))
			return ty_f32
		}
		replace_node(e, mk_conv(pos, x, CV_I2F, ty_float))
		return ty_float
	}
	if tk == K_FLOAT && fk == K_FLOAT {
		// f64 -> f32 rounds; f32 -> f64 is exact (the register already holds an f64).
		if is_f32(to) != 0 {
			replace_node(e, mk_conv(pos, x, CV_ROUND32, ty_f32))
		} else {
			replace_node(e, mk_conv(pos, x, CV_SAME, cast(i64, to)))
		}
		return cast(i64, to)
	}
	if tk == K_INT && fk == K_FLOAT {
		replace_node(e, mk_conv(pos, x, CV_F2I, cast(i64, to)))
		return cast(i64, to)
	}
	if tk == K_INT && is_integer_t(cast(i64, from)) != 0 {
		// Integer conversions truncate or extend to the target width.
		replace_node(e, mk_conv(pos, x, CV_INT, cast(i64, to)))
		return cast(i64, to)
	}
	if tk == K_INT && fk == K_BOOL {
		replace_node(e, mk_conv(pos, x, CV_SAME, cast(i64, to)))
		return cast(i64, to)
	}
	if tk == K_STRING && is_integer_t(cast(i64, from)) != 0 {
		replace_node(e, rt_call(pos, cstr("rt_str_from_rune"), args1(x), ty_string))
		return ty_string
	}
	if tk == K_STRING && fk == K_SLICE && from.elem == ty_byte {
		replace_node(e, rt_call(pos, cstr("rt_str_from_bytes"), args1(x), ty_string))
		return ty_string
	}
	if tk == K_SLICE && to.elem == ty_byte && fk == K_STRING {
		replace_node(e, rt_call(pos, cstr("rt_bytes_from_str"), args1(x), cast(i64, to)))
		return cast(i64, to)
	}
	if tk == K_OPT && cast(i64, from) == to.elem {
		replace_node(e, mk_conv(pos, x, CV_SAME, cast(i64, to)))
		return cast(i64, to)
	}
	err_code_types(pos, cstr("E231 CONVERSION"), cstr("cannot convert "), cast(i64, from), cstr(" to "), cast(i64, to))
	return cast(i64, to)
}

// chk_builtin handles the predeclared functions; it returns 0 for other names.
fn chk_builtin(e i64, name i64, want i64) i64 {
	let pos = cast(Node, e).pos
	let args = cast(Call, e).args
	let n = len(args)
	if streq(name, cstr("bound")) != 0 {
		return chk_bound(e, cast(Ty, want))
	}
	if streq(name, cstr("len")) != 0 || streq(name, cstr("cap")) != 0 {
		if n != 1 {
			err_code_quoted(pos, cstr("E210 ARG_COUNT"), cstr(""), name, cstr(" expects 1 argument"))
			return ty_int
		}
		let t = cast(Ty, chk(cast(Node, arg0(cast(Call, e))), 0))
		let k = kind_of(t)
		if k != K_STRING && k != K_SLICE && k != K_MAP {
			err_code_type(pos, cstr("E217 BUILTIN_ARGS"), cstr("invalid argument for len: "), cast(i64, t), cstr(""))
		}
		mut word = 0
		if streq(name, cstr("cap")) != 0 {
			word = 1
		}
		replace_node(e, mk_hdr(pos, arg0(cast(Call, e)), word))
		cast(Node, e).type_ = 0
		return ty_int
	}
	if streq(name, cstr("append")) != 0 {
		if n == 0 {
			err_code_at(pos, cstr("E217 BUILTIN_ARGS"), cstr("append needs a slice"))
			return ty_int
		}
		shared_let_write(pos, arg0(cast(Call, e)))
		mut st = cast(Ty, chk(cast(Node, arg0(cast(Call, e))), want))
		if cast(Node, arg0(cast(Call, e))).kind == EX_IDENT {
			alias_grown(pos, lookup_name(cast(IdentExpr, arg0(cast(Call, e))).name))
		}
		// append can grow a bounded slice past its bound: the result is unbounded (#240).
		st = cast(Ty, unbounded(st))
		if kind_of(st) != K_SLICE {
			err_code_type(pos, cstr("E217 BUILTIN_ARGS"), cstr("first argument to append must be a slice, not "), cast(i64, st), cstr(""))
			return ty_int
		}
		let et = st.elem
		mut acc = arg0(cast(Call, e))
		mut i = 1
		for i < n {
			let a = args[i]
			if cast(Node, a).kind == EX_UNARY && streq(cast(Unary, a).op, cstr("...")) != 0 {
				let at = chk(cast(Node, cast(Unary, a).x), cast(i64, st))
				if kind_of(cast(Ty, at)) == K_STRING && et == ty_byte && is_secret(cast(Ty, at)) != 0 && is_secret(st) == 0 {
					secret_sink_error(cast(Node, a).pos, cstr("append would put "), cstr(" into a slice that is not secret"), 0, at)
				}
				if kind_of(cast(Ty, at)) == K_STRING && et == ty_byte {
					acc = rt_call(pos, cstr("rt_append_str"), args2(acc, cast(Unary, a).x), cast(i64, st))
				} else {
					check_assignable(cast(Node, cast(Unary, a).x), at, st)
					mut appendn = cstr("rt_slice_appendn")
					if rc_counted(cast(Ty, et)) != 0 {
						// The elements' new slots own them (#176): a long-lived slice counts them.
						appendn = cstr("rt_slice_appendn_rc")
					}
					acc = rt_call(pos, appendn, args3(acc, cast(Unary, a).x, mk_int(pos, elem_size(st), ty_int)), cast(i64, st))
				}
			} else {
				let vt = chk(cast(Node, a), et)
				check_assignable(cast(Node, a), vt, cast(Ty, secret_like(cast(i64, st), et)))
				if is_untyped(vt) != 0 {
					reconvert(cast(Node, a), et)
				}
				if is_dyn_value(cast(Ty, et)) != 0 {
					acc = lower_append_dyn(pos, acc, a, st)
				} else if rc_counted(cast(Ty, et)) != 0 {
					// The element's slot owns it (#176): a long-lived slice counts it.
					acc = rt_call(pos, cstr("rt_append_rc"), args3(acc, elem_bits(cast(Node, a), st.elem), mk_int(pos, elem_size(st), ty_int)), cast(i64, st))
				} else {
					acc = rt_call(pos, cstr("rt_append"), args3(acc, elem_bits(cast(Node, a), st.elem), mk_int(pos, elem_size(st), ty_int)), cast(i64, st))
				}
			}
			i = i + 1
		}
		replace_node(e, acc)
		cast(Node, e).type_ = 0
		return cast(i64, st)
	}
	if streq(name, cstr("make")) != 0 {
		if n < 1 || cast(Node, arg0(cast(Call, e))).kind != EX_TYPE {
			err_code_at(pos, cstr("E217 BUILTIN_ARGS"), cstr("make needs a slice or map type: make([]T, n), make([]T, n, capacity) or make(map[K]V)"))
			return ty_int
		}
		let t = cast(Ty, resolve_type(arg0(cast(Call, e))[TYX]))
		let k = kind_of(t)
		if k == K_SLICE {
			if n < 2 {
				err_code_at(pos, cstr("E217 BUILTIN_ARGS"), cstr("make of a slice needs a length"))
				return cast(i64, t)
			}
			chk(cast(Node, args[1]), ty_int)
			reconvert(cast(Node, args[1]), ty_int)
			// Without a capacity pass 0 (the runtime raises it to the length), so the length
			// expression is evaluated once.
			mut c = mk_int(pos, 0, ty_int)
			if n > 2 {
				c = args[2]
				chk(cast(Node, c), ty_int)
				reconvert(cast(Node, c), ty_int)
			}
			let ek = kind_of(cast(Ty, t.elem))
			let len0 = args[1]
			let zero_len = i64(cast(Node, len0).kind == EX_INT && cast(IntLit, len0).val == 0)
			if zero_len == 0 && (ek == K_STRUCT || ek == K_MAP || ek == K_FUNC || ek == K_DYN) {
				err_code_type(pos, cstr("E203 NO_ZERO_VALUE"), cstr("make with a length would fill the slice with nil "), t.elem, cstr(" values: use make([]T, 0, n) and append (or []?T)"))
				return cast(i64, t)
			}
			if zero_len == 0 && ek == K_STRING {
				// Elements start as "" (a str is never nil).
				replace_node(e, rt_call(pos, cstr("rt_slice_make_str"), args2(args[1], c), cast(i64, t)))
				return cast(i64, t)
			}
			if zero_len == 0 && ek == K_SLICE {
				replace_node(e, rt_call(pos, cstr("rt_slice_make_nest"), args3(args[1], c, mk_int(pos, elem_size(cast(Ty, t.elem)), ty_int)), cast(i64, t)))
				return cast(i64, t)
			}
			replace_node(e, rt_call(pos, cstr("rt_slice_make"), args3(args[1], c, mk_int(pos, elem_size(t), ty_int)), cast(i64, t)))
			return cast(i64, t)
		}
		if k == K_MAP {
			replace_node(e, map_make_call(pos, t))
			return cast(i64, t)
		}
		err_code_type(pos, cstr("E217 BUILTIN_ARGS"), cstr("cannot make "), cast(i64, t), cstr(""))
		return cast(i64, t)
	}
	if streq(name, cstr("new")) != 0 {
		if n != 1 || cast(Node, arg0(cast(Call, e))).kind != EX_TYPE {
			err_code_at(pos, cstr("E217 BUILTIN_ARGS"), cstr("new needs one struct type: new(T)"))
			return ty_int
		}
		let t = cast(Ty, resolve_type(arg0(cast(Call, e))[TYX]))
		if kind_of(t) != K_STRUCT {
			err_code_type(pos, cstr("E217 BUILTIN_ARGS"), cstr("new needs a struct type, not "), cast(i64, t), cstr(""))
			return cast(i64, t)
		}
		// new(T) is T{}: fields that cannot be nil must still be set.
		let lit = cast(Composite, node_new(EX_COMPOSITE, pos))
		let tyx = node_new(EX_TYPE, pos)
		tyx[TYX] = arg0(cast(Call, e))[TYX]
		lit.type_ = tyx
		lit.elems = []i64{}
		lit.keys = []i64{}
		replace_node(e, cast(i64, lit))
		cast(Node, e).type_ = 0
		return chk_kind(e, cast(i64, t))
	}
	if streq(name, cstr("cast")) != 0 {
		if ck_trusted == 0 {
			err_code_at(pos, cstr("E802 RUNTIME_INTERNAL"), cstr("cast is internal to the runtime"))
		}
		if n != 2 || cast(Node, arg0(cast(Call, e))).kind != EX_TYPE {
			err_code_at(pos, cstr("E217 BUILTIN_ARGS"), cstr("cast needs a type and a value"))
			return ty_int
		}
		let t = cast(Ty, resolve_type(arg0(cast(Call, e))[TYX]))
		let x = args[1]
		let from = chk(cast(Node, x), 0)
		if is_untyped(from) != 0 {
			reconvert(cast(Node, x), ty_int)
		}
		if is_float_t(cast(i64, t)) != 0 && is_float_t(from) == 0 {
			replace_node(e, mk_conv(pos, x, CV_BITS2F, cast(i64, t)))
		} else if is_float_t(cast(i64, t)) == 0 && is_float_t(from) != 0 {
			replace_node(e, mk_conv(pos, x, CV_F2BITS, cast(i64, t)))
		} else {
			// Same bits, new static type: the operand keeps its own type.
			if is_integer_t(cast(i64, t)) != 0 && cast(Node, x).kind == EX_FUNCREF {
				cast(FuncRef, x).raw = 1
			}
			replace_node(e, mk_conv(pos, x, CV_SAME, cast(i64, t)))
		}
		return cast(i64, t)
	}
	if streq(name, cstr("delete")) != 0 {
		if n != 2 {
			err_code_at(pos, cstr("E217 BUILTIN_ARGS"), cstr("delete needs a map and a key"))
			return ty_void
		}
		shared_let_write(pos, arg0(cast(Call, e)))
		let mt = cast(Ty, chk(cast(Node, arg0(cast(Call, e))), 0))
		if kind_of(mt) != K_MAP || n != 2 {
			err_code_at(pos, cstr("E217 BUILTIN_ARGS"), cstr("delete needs a map and a key"))
			return ty_void
		}
		let kt = chk(cast(Node, args[1]), mt.key)
		check_assignable(cast(Node, args[1]), kt, cast(Ty, mt.key))
		if is_untyped(kt) != 0 {
			reconvert(cast(Node, args[1]), mt.key)
		}
		replace_node(e, rt_call(pos, cstr("rt_map_del"), args2(arg0(cast(Call, e)), key_in(cast(Node, args[1]), mt.key)), ty_void))
		return ty_void
	}
	if streq(name, cstr("copy")) != 0 {
		if n != 2 {
			err_code_at(pos, cstr("E217 BUILTIN_ARGS"), cstr("copy needs a destination slice and a source (a slice or a str)"))
			return ty_int
		}
		shared_let_write(pos, arg0(cast(Call, e)))
		let dt = cast(Ty, chk(cast(Node, arg0(cast(Call, e))), 0))
		let cdesc = secret_desc(args[1])
		mut st = cast(Ty, chk(cast(Node, args[1]), 0))
		if has_secret(cast(i64, st)) != 0 && has_secret(cast(i64, dt)) == 0 {
			secret_sink_error(cast(Node, args[1]).pos, cstr("copy would put "), cstr(" into a slice that is not secret"), cdesc, cast(i64, st))
		}
		if kind_of(st) == K_STRING {
			replace_node(e, rt_call(pos, cstr("rt_copy_str"), args2(arg0(cast(Call, e)), args[1]), ty_int))
		} else if kind_of(dt) == K_SLICE && rc_counted(cast(Ty, dt.elem)) != 0 {
			// Copied values gain their slots' counts and replaced ones lose theirs (#176).
			let cargs = cast([]i64, args3(arg0(cast(Call, e)), args[1], mk_int(pos, elem_size(dt), ty_int)))
			cargs = append(cargs, fn_ref_node(pos, cast(Fn, drop_fn(dt.elem))))
			replace_node(e, rt_call(pos, cstr("rt_slice_copy_rc"), cast(i64, cargs), ty_int))
		} else {
			replace_node(e, rt_call(pos, cstr("rt_slice_copy"), args3(arg0(cast(Call, e)), args[1], mk_int(pos, elem_size(dt), ty_int)), ty_int))
		}
		return ty_int
	}
	if streq(name, cstr("panic")) != 0 {
		if n != 1 {
			err_code_at(pos, cstr("E217 BUILTIN_ARGS"), cstr("panic needs one value: panic(\"message\") or panic(err)"))
			return ty_void
		}
		let pdesc = secret_desc(arg0(cast(Call, e)))
		let pt = chk(cast(Node, arg0(cast(Call, e))), ty_string)
		secret_sink(cast(Node, arg0(cast(Call, e))).pos, cstr("panic would print "), cstr(""), pdesc, pt)
		mut msg = arg0(cast(Call, e))
		if kind_of(cast(Ty, pt)) == K_ERROR {
			msg = rt_call(pos, cstr("rt_err_str"), args1(msg), ty_string)
		} else if kind_of(cast(Ty, pt)) != K_STRING {
			msg = say_text(pos, cast([]Node, args), 0)
		}
		replace_node(e, rt_call(pos, cstr("rt_panic"), args1(msg), ty_void))
		return ty_void
	}
	if streq(name, cstr("fail")) != 0 {
		if n != 1 {
			err_code_at(pos, cstr("E416 FAIL_VALUE"), cstr("fail needs a message"))
			return ty_error
		}
		let fdesc = secret_desc(arg0(cast(Call, e)))
		let ft = chk(cast(Node, arg0(cast(Call, e))), ty_string)
		secret_sink(cast(Node, arg0(cast(Call, e))).pos, cstr("fail would put "), cstr(" in a fault message"), fdesc, ft)
		if kind_of(cast(Ty, ft)) != K_STRING {
			err_code_type(pos, cstr("E416 FAIL_VALUE"), cstr("fail needs a str message, not "), ft, cstr(""))
		}
		replace_node(e, rt_call(pos, cstr("rt_fail"), args1(arg0(cast(Call, e))), ty_error))
		cast(Node, e).type_ = 0
		return ty_error
	}
	if streq(name, cstr("fault")) != 0 {
		// var ErrX = fault("msg") declares a sentinel: one identity per declaration (fault.Is).
		if n != 1 {
			err_code_at(pos, cstr("E417 SENTINEL"), cstr("fault needs a message: var ErrX = fault(\"...\")"))
			return ty_error
		}
		if ck_sentinel != e {
			err_code_at(pos, cstr("E417 SENTINEL"), cstr("fault(\"...\") declares a sentinel: write it at package level as var ErrX = fault(\"msg\"), or use fail(\"msg\") for a one-off fault"))
			return ty_error
		}
		let sdesc = secret_desc(arg0(cast(Call, e)))
		mut st = cast(Ty, chk(cast(Node, arg0(cast(Call, e))), ty_string))
		secret_sink(cast(Node, arg0(cast(Call, e))).pos, cstr("fault would put "), cstr(" in a fault message"), sdesc, cast(i64, st))
		if kind_of(st) != K_STRING {
			err_code_type(pos, cstr("E417 SENTINEL"), cstr("fault needs a str message, not "), cast(i64, st), cstr(""))
		}
		sentinel_seq = sentinel_seq + 1
		replace_node(e, rt_call(pos, cstr("rt_fault_sentinel"), args2(arg0(cast(Call, e)), mk_int(pos, 63 + sentinel_seq, ty_int)), ty_error))
		cast(Node, e).type_ = 0
		return ty_error
	}
	if streq(name, cstr("same")) != 0 {
		if n != 2 {
			err_code_at(pos, cstr("E217 BUILTIN_ARGS"), cstr("same needs two values"))
			return ty_bool
		}
		let sa = chk(cast(Node, arg0(cast(Call, e))), 0)
		let sb = chk(cast(Node, args[1]), sa)
		let sk = kind_of(cast(Ty, sa))
		if (sk != K_STRUCT && sk != K_SLICE && sk != K_MAP) || cast(i64, sa) != sb {
			err_code_at(pos, cstr("E217 BUILTIN_ARGS"), cstr("same compares two structs, slices or maps of one type for identity (the same object)"))
			return ty_bool
		}
		replace_node(e, mk_bin(pos, cstr("=="), mk_conv(pos, arg0(cast(Call, e)), CV_SAME, ty_int), mk_conv(pos, args[1], CV_SAME, ty_int), ty_bool))
		return ty_bool
	}
	if streq(name, cstr("keep")) != 0 {
		if n != 1 {
			err_code_at(pos, cstr("E217 BUILTIN_ARGS"), cstr("keep needs one value"))
			return ty_int
		}
		return lower_keep(cast(Node, e), want)
	}
	if streq(name, cstr("reveal")) != 0 {
		return secret_reveal(e)
	}
	if streq(name, cstr("print")) != 0 || streq(name, cstr("println")) != 0 {
		if streq(name, cstr("println")) != 0 {
			return lower_say(e, cstr("Line"), want)
		}
		return lower_say(e, cstr("Text"), want)
	}
	if streq(name, cstr("min")) != 0 || streq(name, cstr("max")) != 0 {
		return lower_minmax(e, name, want)
	}
	return 0
}

fn lower_minmax(e i64, name i64, want i64) i64 {
	let pos = cast(Node, e).pos
	let args = cast(Call, e).args
	let n = len(args)
	if n == 0 {
		err_code_quoted(pos, cstr("E210 ARG_COUNT"), cstr(""), name, cstr(" needs arguments"))
		return ty_int
	}
	chk(cast(Node, arg0(cast(Call, e))), want)
	mut i = 1
	for i < n {
		unify(cast(Node, arg0(cast(Call, e))), args[i], want)
		i = i + 1
	}
	let t = default_type(cast(Node, arg0(cast(Call, e))).type_)
	i = 0
	for i < n {
		reconvert(cast(Node, args[i]), t)
		i = i + 1
	}
	secret_compare_error(pos, name, t, t)
	if is_numeric_t(t) == 0 && kind_of(cast(Ty, t)) != K_STRING {
		err_code_type(pos, cstr("E237 COMPARE"), cstr("cannot compare "), t, cstr(""))
	}
	// acc := a; if b < acc { acc = b }  (compiled to csel)
	let stmts = []i64{}
	let acc = temp(pos, arg0(cast(Call, e)), t)
	stmts = append(stmts, cast(i64, acc))
	mut op = cstr("<")
	if streq(name, cstr("max")) != 0 {
		op = cstr(">")
	}
	i = 1
	for i < n {
		let v = temp(pos, args[i], t)
		stmts = append(stmts, cast(i64, v))
		mut cond = mk_bin(pos, op, sym_ref_node(pos, cast(Sym, v.sym)), sym_ref_node(pos, cast(Sym, acc.sym)), ty_bool)
		if kind_of(cast(Ty, t)) == K_STRING {
			cond = mk_bin(pos, op, rt_call(pos, cstr("rt_str_cmp"), args2(sym_ref_node(pos, cast(Sym, v.sym)), sym_ref_node(pos, cast(Sym, acc.sym))), ty_int), mk_int(pos, 0, ty_int), ty_bool)
		}
		let ifs = cast(IfStmt, node_new(ST_IF, pos))
		ifs.cond = cond
		ifs.then = empty_block(pos)
		mut vs1 = cast(Block, ifs.then).stmts
		vs1 = append(vs1, assign_stmt(pos, sym_ref_node(pos, cast(Sym, acc.sym)), sym_ref_node(pos, cast(Sym, v.sym))))
		stmts = append(stmts, cast(i64, ifs))
		i = i + 1
	}
	replace_node(e, mk_seq(pos, cast(i64, stmts), sym_ref_node(pos, cast(Sym, acc.sym)), t))
	return t
}

// lower_keep deep-copies a value into the core's long-lived ingot heap. The result may
// only be stored straight into long-lived memory (checked by the region pass).
// type_has_dyn reports whether a value of t holds a dyn value (a dyn field, element or
// optional), depth-limited so a recursive type stays finite.
fn type_has_dyn(t Ty, depth i64) i64 {
	if depth > 8 {
		return 0
	}
	let k = kind_of(t)
	if k == K_DYN {
		return 1
	}
	if k == K_OPT || k == K_SLICE {
		return type_has_dyn(cast(Ty, t.elem), depth + 1)
	}
	if k == K_MAP {
		return i64(type_has_dyn(cast(Ty, t.key), depth + 1) != 0 || type_has_dyn(cast(Ty, t.elem), depth + 1) != 0)
	}
	if k == K_STRUCT {
		mut i = 0
		for i < len(t.fields) {
			if type_has_dyn(cast(Ty, field_type(t, i)), depth + 1) != 0 {
				return 1
			}
			i = i + 1
		}
	}
	return 0
}

fn lower_keep(e Node, want i64) i64 {
	let pos = e.pos
	let x = arg0(cast(Call, e))
	mut t = chk(cast(Node, x), want)
	if is_untyped(t) != 0 {
		t = reconvert(cast(Node, x), default_type(t))
	}
	if kind_of(cast(Ty, t)) == K_DYN || type_has_dyn(cast(Ty, t), 0) != 0 {
		let f = keep_fn(cast(Ty, t))
		let c = node_new(EX_CALL, pos)
		cast(Call, c).name = f.qname
		cast(Call, c).args = cast([]i64, args1(x))
		cast(Call, c).fn_ = cast(i64, f)
		cast(Node, c).type_ = t
		cast(Node, c).region = R_OWNED
		replace_node(cast(i64, e), c)
		return t
	}
	if kind_of(cast(Ty, t)) == K_FUNC {
		let c = rt_call(pos, cstr("rt_keep_closure"), args1(x), t)
		cast(Node, c).region = R_OWNED
		replace_node(cast(i64, e), c)
		return t
	}
	if is_ref(t) == 0 {
		replace_node(cast(i64, e), x)
		return t
	}
	let f = keep_fn(cast(Ty, t))
	let c = node_new(EX_CALL, pos)
	cast(Call, c).name = f.qname
	cast(Call, c).args = cast([]i64, args1(x))
	cast(Call, c).fn_ = cast(i64, f)
	cast(Node, c).type_ = t
	cast(Node, c).region = R_OWNED
	replace_node(cast(i64, e), c)
	return t
}

// ---- argo: a JSON encoder generated for each type ----
shared mut argo_types []i64
shared mut argo_fns []i64

fn lower_argo_put(e i64) i64 {
	let pos = cast(Node, e).pos
	let args = cast(Call, e).args
	if len(args) != 2 {
		err_code_at(pos, cstr("E281 ARGO"), cstr("argo.Put takes a []u8 buffer and a value"))
		return ty_void
	}
	let b = cast(Node, args[0])
	if unwrap_mut(cast(i64, b)) == 0 {
		err_code_at(b.pos, cstr("E281 ARGO"), cstr("argo.Put appends to its buffer: write mut before it"))
	}
	let bt = cast(Ty, chk(cast(Node, b), 0))
	if kind_of(bt) != K_SLICE || bt.elem != ty_byte {
		err_code_type(pos, cstr("E281 ARGO"), cstr("argo.Put writes into a []u8, not "), cast(i64, bt), cstr(""))
		return ty_void
	}
	let v = cast(Node, args[1])
	let vdesc = secret_desc(cast(i64, v))
	mut t = chk(cast(Node, v), 0)
	if secret_sink(v.pos, cstr("argo.Put would encode "), cstr(" as JSON"), vdesc, t) != 0 {
		return ty_void
	}
	if is_untyped(t) != 0 {
		t = reconvert(cast(Node, v), default_type(t))
	}
	let f = argo_fn(pos, cast(Ty, t))
	if f == 0 {
		return ty_void
	}
	replace_node(e, cast(i64, call_fn(pos, cast(Fn, f), args2(cast(i64, b), cast(i64, v)), ty_void)))
	return ty_void
}

fn call_fn(pos i64, f Fn, args i64, t i64) Node {
	let c = node_new(EX_CALL, pos)
	cast(Call, c).name = f.qname
	cast(Call, c).args = cast([]i64, args)
	cast(Call, c).fn_ = cast(i64, f)
	cast(Node, c).type_ = t
	return cast(Node, c)
}

fn argo_lib(pos i64, name i64) Fn {
	let f = find_fn(name)
	if cast(i64, f) == 0 {
		err_code_quoted(pos, cstr("E281 ARGO"), cstr("argo.Put needs package argo ("), name, cstr(" is missing): import \"argo\""))
	}
	return f
}

// argo_emit appends a call that writes x (of type t) to buffer b.
fn argo_emit(pos i64, body []i64, b i64, x i64, t Ty) {
	let k = kind_of(t)
	let bref = sym_ref_node(pos, cast(Sym, b))
	if k == K_STRING {
		body = append(body, expr_stmt(call_fn(pos, argo_lib(pos, cstr("argo.wstr")), args2(bref, x), ty_void)))
	} else if k == K_BOOL {
		body = append(body, expr_stmt(call_fn(pos, argo_lib(pos, cstr("argo.wbool")), args2(bref, x), ty_void)))
	} else if is_f32(t) != 0 {
		body = append(body, expr_stmt(call_fn(pos, argo_lib(pos, cstr("argo.wfloat32")), args2(bref, x), ty_void)))
	} else if is_float_t(cast(i64, t)) != 0 {
		body = append(body, expr_stmt(call_fn(pos, argo_lib(pos, cstr("argo.wfloat")), args2(bref, x), ty_void)))
	} else if k == K_INT && t.signed == 0 {
		body = append(body, expr_stmt(call_fn(pos, argo_lib(pos, cstr("argo.wuint")), args2(bref, mk_conv(pos, x, CV_SAME, ty_u64)), ty_void)))
	} else if k == K_INT {
		body = append(body, expr_stmt(call_fn(pos, argo_lib(pos, cstr("argo.wint")), args2(bref, mk_conv(pos, x, CV_SAME, ty_int)), ty_void)))
	} else {
		let f = argo_fn(pos, t)
		if f != 0 {
			body = append(body, expr_stmt(call_fn(pos, cast(Fn, f), args2(bref, x), ty_void)))
		}
	}
}

fn argo_raw(pos i64, body []i64, b i64, text i64) {
	body = append(body, expr_stmt(cast(Node, rt_call(pos, cstr("rt_append_str"), args2(sym_ref_node(pos, cast(Sym, b)), lit_string(pos, text)), ty_byte_slice()))))
}

fn ty_byte_slice() i64 {
	return slice_of(ty_byte)
}

// argo_fn returns (generating on first use) argo$N(b mut []u8, x T), the encoder for T.
fn argo_fn(pos i64, t Ty) i64 {
	if cast(i64, argo_types) == 0 {
		argo_types = []i64{}
		argo_fns = []i64{}
	}
	mut i = 0
	for i < len(argo_types) {
		if cast(i64, cast(Ty, cast([]i64, argo_types)[i])) == cast(i64, t) {
			return argo_fns[i]
		}
		i = i + 1
	}
	let k = kind_of(t)
	if !(k == K_STRUCT || k == K_SLICE || k == K_MAP || k == K_OPT || k == K_ERROR || k == K_STRING || k == K_INT || k == K_BOOL || is_float_t(cast(i64, t)) != 0) {
		err_code_type(pos, cstr("E281 ARGO"), cstr("argo cannot encode values of type "), cast(i64, t), cstr(""))
		return 0
	}
	if k == K_MAP && kind_of(cast(Ty, t.key)) != K_STRING && kind_of(cast(Ty, t.key)) != K_INT {
		err_code_type(pos, cstr("E281 ARGO"), cstr("argo encodes maps with str or integer keys, not "), cast(i64, t), cstr(""))
		return 0
	}
	lifted_count = lifted_count + 1
	let f = fn_new(0, cstr("argo"))
	let nb = buf_new()
	buf_str(nb, cstr("argo$"))
	buf_int(nb, lifted_count)
	buf_byte(nb, 0)
	f.qname = slice_data(nb)
	f.name = slice_data(nb)
	f.lifted = 2
	let bt = ty_byte_slice()
	f.params = append(f.params, cstr("b"))
	f.params = append(f.params, cstr("x"))
	f.ptypes = append(f.ptypes, bt)
	f.ptypes = append(f.ptypes, cast(i64, t))
	f.muts = append(f.muts, 1)
	f.muts = append(f.muts, 0)
	f.type_ = func_of(f.ptypes, f.rtypes, 0)
	f.locals = cast([]Sym, []i64{})
	f.body = empty_block(0)
	mut vs7 = cast([]i64, argo_types)
	vs7 = append(vs7, cast(i64, t))
	argo_fns = append(argo_fns, cast(i64, f))
	prog_fns = append(prog_fns, cast(Fn, f))
	let saved_fn = ck_fn
	ck_fn = cast(Fn, f)
	let b = sym_new(SYM_LOCAL, cstr("b"), 0)
	b.type_ = bt
	b.slot = 0
	b.mut_ = 1
	let x = sym_new(SYM_LOCAL, cstr("x"), 0)
	x.type_ = cast(i64, t)
	x.slot = 1
	f.slots = 2
	mut vs8 = cast([]i64, f.locals)
	vs8 = append(vs8, cast(i64, b))
	mut vs9 = cast([]i64, f.locals)
	vs9 = append(vs9, cast(i64, x))
	let body = cast(Block, f.body).stmts
	if k == K_STRUCT && cast(i64, t.enum_) != 0 {
		// "Name" for a variant without data, {"Name":{"field":...}} for one with data.
		let vs = t.enum_
		mut vi = 0
		for vi < len(vs) {
			let v = cast([]i64, vs[vi])
			let ifs = cast(IfStmt, node_new(ST_IF, pos))
			ifs.cond = mk_bin(pos, cstr("=="), mk_mem(pos, sym_ref_node(pos, x), 0, 0, field_offset(t, 0), ty_int), mk_int(pos, vi, ty_int), ty_bool)
			ifs.then = empty_block(pos)
			let vb = cast(Block, ifs.then).stmts
			let vn = v[0]
			let nfv = v[2]
			let head = buf_new()
			if nfv == 0 {
				buf_byte(head, '"')
				buf_str(head, vn)
				buf_byte(head, '"')
				buf_byte(head, 0)
				argo_raw(pos, vb, cast(i64, b), slice_data(head))
			} else {
				buf_str(head, cstr("{{\""))
				buf_str(head, vn)
				buf_str(head, cstr("\":"))
				buf_byte(head, 0)
				argo_raw(pos, vb, cast(i64, b), slice_data(head))
				mut kk = 0
				for kk < nfv {
					let fi2 = v[1] + kk
					let full = cast([]i64, t.fields[fi2])[0]
					let piece = buf_new()
					if kk == 0 {
						buf_byte(piece, '{')
					} else {
						buf_byte(piece, ',')
					}
					buf_byte(piece, '"')
					buf_str(piece, full + strlen(vn) + 1)
					buf_str(piece, cstr("\":"))
					buf_byte(piece, 0)
					argo_raw(pos, vb, cast(i64, b), slice_data(piece))
					let ft2 = field_type(t, fi2)
					argo_emit(pos, vb, cast(i64, b), mk_mem(pos, sym_ref_node(pos, x), 0, 0, field_offset(t, fi2), ft2), cast(Ty, ft2))
					kk = kk + 1
				}
				argo_raw(pos, vb, cast(i64, b), cstr("}}}}"))
			}
			body = append(body, cast(i64, ifs))
			vi = vi + 1
		}
	} else if k == K_STRUCT {
		let nf = len(t.fields)
		mut fi = 0
		mut lead = cstr("{{")
		for fi < nf {
			mut fname = cast([]i64, t.fields[fi])[0]
			let json_name = cast([]i64, t.fields[fi])[5]
			if json_name != 0 {
				fname = json_name
			}
			let ft = field_type(t, fi)
			let piece = buf_new()
			buf_str(piece, lead)
			buf_byte(piece, '"')
			buf_str(piece, fname)
			buf_str(piece, cstr("\":"))
			buf_byte(piece, 0)
			argo_raw(pos, body, cast(i64, b), slice_data(piece))
			argo_emit(pos, body, cast(i64, b), mk_mem(pos, sym_ref_node(pos, x), 0, 0, field_offset(t, fi), ft), cast(Ty, ft))
			lead = cstr(",")
			fi = fi + 1
		}
		if nf == 0 {
			argo_raw(pos, body, cast(i64, b), cstr("{{}}"))
		} else {
			argo_raw(pos, body, cast(i64, b), cstr("}}"))
		}
	} else if k == K_OPT || k == K_ERROR {
		let ifs = cast(IfStmt, node_new(ST_IF, pos))
		ifs.cond = mk_bin(pos, cstr("=="), sym_ref_node(pos, x), mk_int(pos, 0, cast(i64, t)), ty_bool)
		ifs.then = empty_block(pos)
		argo_raw(pos, cast(Block, ifs.then).stmts, cast(i64, b), cstr("null"))
		let els = cast(Block, empty_block(pos))
		ifs.else_ = cast(i64, els)
		if k == K_ERROR {
			argo_emit(pos, els.stmts, cast(i64, b), mk_conv(pos, sym_ref_node(pos, x), CV_SAME, ty_string), cast(Ty, ty_string))
		} else {
			argo_emit(pos, els.stmts, cast(i64, b), mk_conv(pos, sym_ref_node(pos, x), CV_SAME, t.elem), cast(Ty, t.elem))
		}
		body = append(body, cast(i64, ifs))
	} else if k == K_SLICE {
		let et = t.elem
		argo_raw(pos, body, cast(i64, b), cstr("["))
		let n = temp(pos, mk_hdr(pos, sym_ref_node(pos, x), 0), ty_int)
		body = append(body, cast(i64, n))
		let j = declare_local(pos, cstr("$"), ty_int)
		body = append(body, let_stmt(pos, cast(Sym, j), mk_int(pos, 0, ty_int)))
		let w = cast(WhileStmt, node_new(ST_WHILE, pos))
		w.cond = mk_bin(pos, cstr("<"), sym_ref_node(pos, cast(Sym, j)), sym_ref_node(pos, cast(Sym, n.sym)), ty_bool)
		w.post = assign_stmt(pos, sym_ref_node(pos, cast(Sym, j)), mk_bin(pos, cstr("+"), sym_ref_node(pos, cast(Sym, j)), mk_int(pos, 1, ty_int), ty_int))
		let wb = cast(Block, empty_block(pos))
		w.body = cast(i64, wb)
		let comma = cast(IfStmt, node_new(ST_IF, pos))
		comma.cond = mk_bin(pos, cstr(">"), sym_ref_node(pos, cast(Sym, j)), mk_int(pos, 0, ty_int), ty_bool)
		comma.then = empty_block(pos)
		argo_raw(pos, cast(Block, comma.then).stmts, cast(i64, b), cstr(","))
		wb.stmts = append(wb.stmts, cast(i64, comma))
		let el = mk_elem(pos, sym_ref_node(pos, x), sym_ref_node(pos, cast(Sym, j)), et, 0)
		el.safe = 1
		argo_emit(pos, wb.stmts, cast(i64, b), cast(i64, el), cast(Ty, et))
		body = append(body, cast(i64, w))
		argo_raw(pos, body, cast(i64, b), cstr("]"))
	} else if k == K_MAP {
		argo_raw(pos, body, cast(i64, b), cstr("{{"))
		let first = declare_local(pos, cstr("$"), ty_bool)
		body = append(body, let_stmt(pos, cast(Sym, first), mk_int(pos, 1, ty_bool)))
		let slots = temp(pos, rt_call(pos, cstr("rt_map_slots"), args1(sym_ref_node(pos, x)), ty_int), ty_int)
		body = append(body, cast(i64, slots))
		let j2 = declare_local(pos, cstr("$"), ty_int)
		body = append(body, let_stmt(pos, cast(Sym, j2), mk_int(pos, 0, ty_int)))
		let w2 = cast(WhileStmt, node_new(ST_WHILE, pos))
		w2.cond = mk_bin(pos, cstr("<"), sym_ref_node(pos, cast(Sym, j2)), sym_ref_node(pos, cast(Sym, slots.sym)), ty_bool)
		w2.post = assign_stmt(pos, sym_ref_node(pos, cast(Sym, j2)), mk_bin(pos, cstr("+"), sym_ref_node(pos, cast(Sym, j2)), mk_int(pos, 1, ty_int), ty_int))
		let wb2 = cast(Block, empty_block(pos))
		w2.body = cast(i64, wb2)
		let live = cast(IfStmt, node_new(ST_IF, pos))
		live.cond = rt_call(pos, cstr("rt_map_live"), args2(sym_ref_node(pos, x), sym_ref_node(pos, cast(Sym, j2))), ty_bool)
		live.then = empty_block(pos)
		let lb = cast(Block, live.then).stmts
		let sep = cast(IfStmt, node_new(ST_IF, pos))
		sep.cond = sym_ref_node(pos, cast(Sym, first))
		sep.then = empty_block(pos)
		mut vs11 = cast(Block, sep.then).stmts
		vs11 = append(vs11, assign_stmt(pos, sym_ref_node(pos, cast(Sym, first)), mk_int(pos, 0, ty_bool)))
		sep.else_ = empty_block(pos)
		argo_raw(pos, cast(Block, sep.else_).stmts, cast(i64, b), cstr(","))
		lb = append(lb, cast(i64, sep))
		let kt = t.key
		let kv = from_bits(cast(Node, rt_call(pos, cstr("rt_map_key"), args2(sym_ref_node(pos, x), sym_ref_node(pos, cast(Sym, j2))), ty_int)), kt)
		if kind_of(cast(Ty, kt)) == K_STRING {
			argo_emit(pos, lb, cast(i64, b), kv, cast(Ty, kt))
		} else {
			argo_raw(pos, lb, cast(i64, b), cstr("\""))
			argo_emit(pos, lb, cast(i64, b), kv, cast(Ty, kt))
			argo_raw(pos, lb, cast(i64, b), cstr("\""))
		}
		argo_raw(pos, lb, cast(i64, b), cstr(":"))
		let vt = t.elem
		let vv = from_bits(cast(Node, rt_call(pos, cstr("rt_map_val"), args2(sym_ref_node(pos, x), sym_ref_node(pos, cast(Sym, j2))), ty_int)), vt)
		argo_emit(pos, lb, cast(i64, b), vv, cast(Ty, vt))
		wb2.stmts = append(wb2.stmts, cast(i64, live))
		body = append(body, cast(i64, w2))
		argo_raw(pos, body, cast(i64, b), cstr("}}"))
	} else {
		argo_emit(pos, body, cast(i64, b), sym_ref_node(pos, x), t)
	}
	ck_fn = saved_fn
	return cast(i64, f)
}

// ---- argo.Get: a JSON decoder generated for each type ----
shared mut argo_dtypes []i64
shared mut argo_dfns []i64
shared mut argo_ptype i64

// lower_argo_get lowers argo.Get and argo.GetStrict (strict != 0). A slice target is filled
// in place and cut back to its length on a fault. Any other target is validated first (a
// pass that stores nothing) and filled only when that succeeds, so a fault leaves the
// target as it was.
fn lower_argo_get(e i64, strict i64) i64 {
	let pos = cast(Node, e).pos
	let args = cast(Call, e).args
	if len(args) != 2 {
		err_code_at(pos, cstr("E281 ARGO"), cstr("argo.Get takes the JSON text and a struct, slice or map to fill"))
		return ty_error
	}
	if unwrap_mut(args[1]) == 0 {
		err_code_at(cast(Node, args[1]).pos, cstr("E281 ARGO"), cstr("argo.Get fills its target: write mut before it"))
	}
	let s = args[0]
	let st = chk(cast(Node, s), ty_string)
	if kind_of(cast(Ty, st)) != K_STRING {
		err_code_type(pos, cstr("E281 ARGO"), cstr("argo.Get reads JSON from a str, not "), st, cstr(""))
		return ty_error
	}
	let v = args[1]
	let t = chk(cast(Node, v), 0)
	let k = kind_of(cast(Ty, t))
	if k != K_STRUCT && k != K_SLICE && k != K_MAP {
		err_code_type(pos, cstr("E281 ARGO"), cstr("argo.Get fills a struct, slice or map (passed by reference), not "), t, cstr(""))
		return ty_error
	}
	let pt = argo_parser_type(pos)
	let df = argo_dfn(pos, cast(Ty, t))
	if pt == 0 || df == 0 {
		return ty_error
	}
	let stmts = []i64{}
	mut ctor = cstr("argo.parser")
	if strict != 0 {
		ctor = cstr("argo.strictly")
	}
	let p = temp(pos, cast(i64, call_fn(pos, argo_lib(pos, ctor), args1(s), pt)), pt)
	stmts = append(stmts, cast(i64, p))
	let ps = sym_ref_node(pos, cast(Sym, p.sym))
	if k == K_SLICE {
		// A slice only gains elements at its end: decode in place and cut it back on a fault.
		let n0 = temp(pos, mk_hdr(pos, v, 0), ty_int)
		stmts = append(stmts, cast(i64, n0))
		stmts = append(stmts, expr_stmt(call_fn(pos, cast(Fn, df), args2(ps, v), ty_void)))
		let r1 = temp(pos, cast(i64, call_fn(pos, argo_lib(pos, cstr("argo.finish")), args1(sym_ref_node(pos, cast(Sym, p.sym))), ty_error)), ty_error)
		stmts = append(stmts, cast(i64, r1))
		let cut = cast(IfStmt, node_new(ST_IF, pos))
		cut.cond = mk_bin(pos, cstr("!="), sym_ref_node(pos, cast(Sym, r1.sym)), mk_int(pos, 0, ty_error), ty_bool)
		cut.then = empty_block(pos)
		mut vs1 = cast(Block, cut.then).stmts
		vs1 = append(vs1, expr_stmt(call_fn(pos, argo_lib(pos, cstr("argo.cut")), args2(mk_conv(pos, v, CV_SAME, ty_int), sym_ref_node(pos, cast(Sym, n0.sym))), ty_void)))
		stmts = append(stmts, cast(i64, cut))
		replace_node(e, mk_seq(pos, cast(i64, stmts), sym_ref_node(pos, cast(Sym, r1.sym)), ty_error))
		return ty_error
	}
	// Pass one only validates: input that fails never touches the target.
	let vf = argo_vfn(pos, cast(Ty, t))
	if vf == 0 {
		return ty_error
	}
	stmts = append(stmts, expr_stmt(call_fn(pos, cast(Fn, vf), args1(ps), ty_void)))
	let r = temp(pos, cast(i64, call_fn(pos, argo_lib(pos, cstr("argo.finish")), args1(sym_ref_node(pos, cast(Sym, p.sym))), ty_error)), ty_error)
	stmts = append(stmts, cast(i64, r))
	// Pass two: the text is valid for this type, so it fills the target.
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = mk_bin(pos, cstr("=="), sym_ref_node(pos, cast(Sym, r.sym)), mk_int(pos, 0, ty_error), ty_bool)
	ifs.then = empty_block(pos)
	let tb = cast(Block, ifs.then).stmts
	tb = append(tb, expr_stmt(call_fn(pos, argo_lib(pos, cstr("argo.rewind")), args1(sym_ref_node(pos, cast(Sym, p.sym))), ty_void)))
	tb = append(tb, expr_stmt(call_fn(pos, cast(Fn, df), args2(sym_ref_node(pos, cast(Sym, p.sym)), v), ty_void)))
	tb = append(tb, assign_stmt(pos, sym_ref_node(pos, cast(Sym, r.sym)), cast(i64, call_fn(pos, argo_lib(pos, cstr("argo.finish")), args1(sym_ref_node(pos, cast(Sym, p.sym))), ty_error))))
	stmts = append(stmts, cast(i64, ifs))
	replace_node(e, mk_seq(pos, cast(i64, stmts), sym_ref_node(pos, cast(Sym, r.sym)), ty_error))
	return ty_error
}

fn argo_parser_type(pos i64) i64 {
	if argo_ptype == 0 {
		argo_ptype = find_type(cstr("argo.Parser"))
		if argo_ptype == 0 {
			err_code_at(pos, cstr("E281 ARGO"), cstr("argo.Get needs package argo: import \"argo\""))
		}
	}
	return argo_ptype
}

// argo_rd is a call of reader name on parser p, of type t.
fn argo_rd(pos i64, p i64, name i64, t i64) i64 {
	return cast(i64, call_fn(pos, argo_lib(pos, name), args1(sym_ref_node(pos, cast(Sym, p))), t))
}

fn argo_err_return(pos i64, body []i64, p i64) {
	let pt = argo_ptype
	let fi = struct_field(cast(Ty, pt), cstr("err"))
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = mk_bin(pos, cstr("!="), mk_mem(pos, sym_ref_node(pos, cast(Sym, p)), 0, 0, field_offset(cast(Ty, pt), fi), ty_error), mk_int(pos, 0, ty_error), ty_bool)
	ifs.then = empty_block(pos)
	mut vs1 = cast(Block, ifs.then).stmts
	vs1 = append(vs1, node_new(ST_RETURN, pos))
	body = append(body, cast(i64, ifs))
}

// argo_new is a fresh value of type t with every reference field made (decode target).
fn argo_new(pos i64, body []i64, t Ty) i64 {
	let k = kind_of(t)
	if k == K_STRING {
		return lit_string(pos, cstr(""))
	}
	if k == K_SLICE {
		return rt_call(pos, cstr("rt_slice_make"), args3(mk_int(pos, 0, ty_int), mk_int(pos, 0, ty_int), mk_int(pos, elem_size(t), ty_int)), cast(i64, t))
	}
	if k == K_MAP {
		return map_make_call(pos, t)
	}
	if k != K_STRUCT {
		return mk_int(pos, 0, cast(i64, t))
	}
	if cast(i64, t.enum_) != 0 {
		return enum_zero(pos, body, t)
	}
	let obj = temp(pos, rt_call(pos, cstr("rt_alloc"), args1(mk_int(pos, t.size, ty_int)), cast(i64, t)), cast(i64, t))
	body = append(body, cast(i64, obj))
	mut fi = 0
	for fi < len(t.fields) {
		let ft = field_type(t, fi)
		let fk = kind_of(cast(Ty, ft))
		if fk == K_STRING || fk == K_SLICE || fk == K_MAP || fk == K_STRUCT {
			body = append(body, assign_stmt(pos, field_store(pos, sym_ref_node(pos, cast(Sym, obj.sym)), cast(i64, t), fi), argo_new(pos, body, cast(Ty, ft))))
		}
		fi = fi + 1
	}
	return sym_ref_node(pos, cast(Sym, obj.sym))
}

shared mut enum_zeroing []i64 // enums whose zero value is being built (a recursion guard)

// enum_zero is an enum's zero value: its first variant without data, else variant 0 with
// zero fields (an enum whose every variant holds itself has no finite zero value).
fn enum_zero(pos i64, body []i64, t Ty) i64 {
	if cast(i64, enum_zeroing) == 0 {
		enum_zeroing = []i64{}
	}
	let vs = t.enum_
	mut vi = 0
	for vi < len(vs) && cast([]i64, vs[vi])[2] > 0 {
		vi = vi + 1
	}
	if vi == len(vs) {
		vi = 0
	}
	let obj = temp(pos, rt_call(pos, cstr("rt_alloc"), args1(mk_int(pos, t.size, ty_int)), cast(i64, t)), cast(i64, t))
	body = append(body, cast(i64, obj))
	body = append(body, assign_stmt(pos, field_store(pos, sym_ref_node(pos, cast(Sym, obj.sym)), cast(i64, t), 0), mk_int(pos, vi, ty_int)))
	let v = cast([]i64, vs[vi])
	mut i = 0
	for i < len(enum_zeroing) {
		if cast(i64, cast(Ty, cast([]i64, enum_zeroing)[i])) == cast(i64, t) {
			err_code_type(pos, cstr("E281 ARGO"), cstr("enum "), cast(i64, t), cstr(" has no zero value: give it a variant without data"))
			return sym_ref_node(pos, cast(Sym, obj.sym))
		}
		i = i + 1
	}
	mut vs1 = cast([]i64, enum_zeroing)
	vs1 = append(vs1, cast(i64, t))
	mut k = 0
	for k < v[2] {
		let fi = v[1] + k
		let ft = field_type(t, fi)
		let fk = kind_of(cast(Ty, ft))
		if fk == K_STRING || fk == K_SLICE || fk == K_MAP || fk == K_STRUCT {
			body = append(body, assign_stmt(pos, field_store(pos, sym_ref_node(pos, cast(Sym, obj.sym)), cast(i64, t), fi), argo_new(pos, body, cast(Ty, ft))))
		}
		k = k + 1
	}
	slice_truncate(enum_zeroing, len(enum_zeroing) - 1)
	return sym_ref_node(pos, cast(Sym, obj.sym))
}

// argo_value appends statements that decode one value of type t and returns it, or 0
// when t cannot be decoded (an error is reported).
fn argo_value(pos i64, body []i64, p i64, t Ty) i64 {
	let k = kind_of(t)
	if k == K_STRING && t.bound != 0 {
		// A str max n stops reading at the bound (#240).
		return cast(i64, call_fn(pos, argo_lib(pos, cstr("argo.rstrmax")), args2(sym_ref_node(pos, cast(Sym, p)), mk_int(pos, t.max, ty_int)), ty_string))
	}
	if k == K_STRING {
		return argo_rd(pos, p, cstr("argo.rstr"), ty_string)
	}
	if k == K_BOOL {
		return argo_rd(pos, p, cstr("argo.rbool"), ty_bool)
	}
	if is_f32(t) != 0 {
		return argo_rd(pos, p, cstr("argo.rfloat32"), ty_f32)
	}
	if is_float_t(cast(i64, t)) != 0 {
		return argo_rd(pos, p, cstr("argo.rfloat"), ty_float)
	}
	if k == K_INT {
		let w = t.width
		if w == 8 && t.signed != 0 {
			return argo_rd(pos, p, cstr("argo.rint"), ty_int)
		}
		if w == 8 {
			return argo_rd(pos, p, cstr("argo.ruint"), ty_u64)
		}
		mut lo = 0
		mut hi = (1 << (8 * w)) - 1
		if t.signed != 0 {
			lo = 0 - (1 << (8 * w - 1))
			hi = (1 << (8 * w - 1)) - 1
		}
		let c = call_fn(pos, argo_lib(pos, cstr("argo.rintr")), args3(sym_ref_node(pos, cast(Sym, p)), mk_int(pos, lo, ty_int), mk_int(pos, hi, ty_int)), ty_int)
		return mk_conv(pos, cast(i64, c), CV_INT, cast(i64, t))
	}
	if k == K_STRUCT || k == K_SLICE || k == K_MAP {
		let obj = temp(pos, argo_new(pos, body, t), cast(i64, t))
		body = append(body, cast(i64, obj))
		let df = argo_dfn(pos, t)
		if df == 0 {
			return 0
		}
		body = append(body, expr_stmt(call_fn(pos, cast(Fn, df), args2(sym_ref_node(pos, cast(Sym, p)), sym_ref_node(pos, cast(Sym, obj.sym))), ty_void)))
		return sym_ref_node(pos, cast(Sym, obj.sym))
	}
	if k == K_OPT {
		let et = t.elem
		if is_ref(et) == 0 || kind_of(cast(Ty, et)) == K_FUNC {
			err_code_type(pos, cstr("E281 ARGO"), cstr("argo.Get decodes optionals of references only, not "), cast(i64, t), cstr(""))
			return 0
		}
		let out = declare_local(pos, cstr("$"), cast(i64, t))
		body = append(body, let_stmt(pos, cast(Sym, out), mk_int(pos, 0, cast(i64, t))))
		let ifs = cast(IfStmt, node_new(ST_IF, pos))
		ifs.cond = mk_unot(pos, argo_rd(pos, p, cstr("argo.rnull"), ty_bool))
		ifs.then = empty_block(pos)
		let inner = argo_value(pos, cast(Block, ifs.then).stmts, p, cast(Ty, et))
		if inner == 0 {
			return 0
		}
		mut vs1 = cast(Block, ifs.then).stmts
		vs1 = append(vs1, assign_stmt(pos, sym_ref_node(pos, cast(Sym, out)), mk_conv(pos, inner, CV_SAME, cast(i64, t))))
		body = append(body, cast(i64, ifs))
		return sym_ref_node(pos, cast(Sym, out))
	}
	err_code_type(pos, cstr("E281 ARGO"), cstr("argo.Get cannot decode values of type "), cast(i64, t), cstr(""))
	return 0
}

fn mk_unot(pos i64, x i64) i64 {
	let u = node_new(EX_UNARY, pos)
	cast(Unary, u).op = cstr("!")
	cast(Unary, u).x = x
	cast(Node, u).type_ = ty_bool
	return u
}

fn forever(pos i64) WhileStmt {
	let w = cast(WhileStmt, node_new(ST_WHILE, pos))
	w.cond = mk_int(pos, 1, ty_bool)
	w.body = empty_block(pos)
	return cast(WhileStmt, w)
}

// argo_more ends a loop body: if !argo.rmore(p, close) { break }.
fn argo_more(pos i64, body []i64, p i64, close i64) {
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = mk_unot(pos, cast(i64, call_fn(pos, argo_lib(pos, cstr("argo.rmore")), args2(sym_ref_node(pos, cast(Sym, p)), mk_int(pos, close, ty_byte)), ty_bool)))
	ifs.then = empty_block(pos)
	mut vs1 = cast(Block, ifs.then).stmts
	vs1 = append(vs1, node_new(ST_BREAK, pos))
	body = append(body, cast(i64, ifs))
}

// argo_denum decodes into enum x: renum gives the variant name (and whether it came as
// {"Name": payload}); the tag is set and the payload's fields are read by name.
fn argo_denum(pos i64, body []i64, p i64, x i64, t Ty) {
	let cm = cast(CallMultiStmt, node_new(ST_CALLMULTI, pos))
	cm.call = cast(i64, call_fn(pos, argo_lib(pos, cstr("argo.renum")), args1(sym_ref_node(pos, cast(Sym, p))), ty_void))
	let nm = declare_local(pos, cstr("$"), ty_string)
	let boxed = declare_local(pos, cstr("$"), ty_bool)
	cm.syms = cast([]Sym, []i64{})
	mut vs1 = cast([]i64, cm.syms)
	vs1 = append(vs1, nm)
	mut vs2 = cast([]i64, cm.syms)
	vs2 = append(vs2, boxed)
	body = append(body, cast(i64, cm))
	argo_err_return(pos, body, p)
	let vs = t.enum_
	mut first = 0
	mut last = cast(IfStmt, 0)
	mut vi = 0
	for vi < len(vs) {
		let v = cast([]i64, vs[vi])
		let vn = v[0]
		let nfv = v[2]
		let br = cast(IfStmt, node_new(ST_IF, pos))
		br.cond = rt_call(pos, cstr("rt_str_eq"), args2(sym_ref_node(pos, cast(Sym, nm)), lit_string(pos, vn)), ty_bool)
		br.then = empty_block(pos)
		let bb = cast(Block, br.then).stmts
		bb = append(bb, assign_stmt(pos, field_store(pos, sym_ref_node(pos, cast(Sym, x)), cast(i64, t), 0), mk_int(pos, vi, ty_int)))
		mut z = 0
		for z < nfv {
			let zf = v[1] + z
			let zt = field_type(t, zf)
			let zk = kind_of(cast(Ty, zt))
			if zk == K_STRING || zk == K_SLICE || zk == K_MAP || zk == K_STRUCT {
				bb = append(bb, assign_stmt(pos, field_store(pos, sym_ref_node(pos, cast(Sym, x)), cast(i64, t), zf), argo_new(pos, bb, cast(Ty, zt))))
			}
			z = z + 1
		}
		if nfv == 0 {
			// A bare "Name"; {"Name": anything} skips the payload.
			let ib = cast(IfStmt, node_new(ST_IF, pos))
			ib.cond = sym_ref_node(pos, cast(Sym, boxed))
			ib.then = empty_block(pos)
			mut vs3 = cast(Block, ib.then).stmts
			vs3 = append(vs3, expr_stmt(call_fn(pos, argo_lib(pos, cstr("argo.rskip")), args1(sym_ref_node(pos, cast(Sym, p))), ty_void)))
			mut vs4 = cast(Block, ib.then).stmts
			vs4 = append(vs4, expr_stmt(call_fn(pos, argo_lib(pos, cstr("argo.rclose")), args1(sym_ref_node(pos, cast(Sym, p))), ty_void)))
			bb = append(bb, cast(i64, ib))
		} else {
			let nb = cast(IfStmt, node_new(ST_IF, pos))
			nb.cond = mk_unot(pos, sym_ref_node(pos, cast(Sym, boxed)))
			nb.then = empty_block(pos)
			mut vs5 = cast(Block, nb.then).stmts
			vs5 = append(vs5, expr_stmt(call_fn(pos, argo_lib(pos, cstr("argo.rvariant")), args2(sym_ref_node(pos, cast(Sym, p)), sym_ref_node(pos, cast(Sym, nm))), ty_void)))
			mut vs6 = cast(Block, nb.then).stmts
			vs6 = append(vs6, node_new(ST_RETURN, pos))
			bb = append(bb, cast(i64, nb))
			let ob = cast(IfStmt, node_new(ST_IF, pos))
			ob.cond = argo_rd(pos, p, cstr("argo.robj"), ty_bool)
			ob.then = empty_block(pos)
			let w = forever(pos)
			mut vs7 = cast(Block, ob.then).stmts
			vs7 = append(vs7, cast(i64, w))
			let wb = cast(Block, w.body).stmts
			let key = temp(pos, argo_rd(pos, p, cstr("argo.rkey"), ty_string), ty_string)
			wb = append(wb, cast(i64, key))
			argo_err_return(pos, wb, p)
			mut chain = 0
			mut lastf = cast(IfStmt, 0)
			mut kk = 0
			for kk < nfv {
				let fi = v[1] + kk
				let full = cast([]i64, t.fields[fi])[0]
				let ft = field_type(t, fi)
				let fb = cast(IfStmt, node_new(ST_IF, pos))
				fb.cond = rt_call(pos, cstr("rt_str_eq"), args2(sym_ref_node(pos, cast(Sym, key.sym)), lit_string(pos, full + strlen(vn) + 1)), ty_bool)
				fb.then = empty_block(pos)
				let fbb = cast(Block, fb.then).stmts
				let fk = kind_of(cast(Ty, ft))
				if fk == K_STRUCT || fk == K_SLICE || fk == K_MAP {
					let df = argo_dfn(pos, cast(Ty, ft))
					if df != 0 {
						fbb = append(fbb, expr_stmt(call_fn(pos, cast(Fn, df), args2(sym_ref_node(pos, cast(Sym, p)), mk_mem(pos, sym_ref_node(pos, cast(Sym, x)), 0, 0, field_offset(t, fi), ft)), ty_void)))
					}
				} else {
					let val = argo_value(pos, fbb, p, cast(Ty, ft))
					if val != 0 {
						fbb = append(fbb, assign_stmt(pos, field_store(pos, sym_ref_node(pos, cast(Sym, x)), cast(i64, t), fi), val))
					}
				}
				if cast(i64, lastf) != 0 {
					let eb = cast(Block, empty_block(pos))
					eb.stmts = append(eb.stmts, cast(i64, fb))
					lastf.else_ = cast(i64, eb)
				} else {
					chain = cast(i64, fb)
				}
				lastf = fb
				kk = kk + 1
			}
			let sb = cast(Block, empty_block(pos))
			sb.stmts = append(sb.stmts, expr_stmt(call_fn(pos, argo_lib(pos, cstr("argo.runknown")), args2(sym_ref_node(pos, cast(Sym, p)), sym_ref_node(pos, cast(Sym, key.sym))), ty_void)))
			lastf.else_ = cast(i64, sb)
			wb = append(wb, chain)
			argo_more(pos, wb, p, '}')
			bb = append(bb, cast(i64, ob))
			bb = append(bb, expr_stmt(call_fn(pos, argo_lib(pos, cstr("argo.rclose")), args1(sym_ref_node(pos, cast(Sym, p))), ty_void)))
		}
		if cast(i64, last) != 0 {
			let eb2 = cast(Block, empty_block(pos))
			eb2.stmts = append(eb2.stmts, cast(i64, br))
			last.else_ = cast(i64, eb2)
		} else {
			first = cast(i64, br)
		}
		last = br
		vi = vi + 1
	}
	let unk = cast(Block, empty_block(pos))
	unk.stmts = append(unk.stmts, expr_stmt(call_fn(pos, argo_lib(pos, cstr("argo.rvariant")), args2(sym_ref_node(pos, cast(Sym, p)), sym_ref_node(pos, cast(Sym, nm))), ty_void)))
	last.else_ = cast(i64, unk)
	body = append(body, first)
}

// argo_bound stops decoding a bounded slice or map x before an element past its bound:
// if len(x) >= max { argo.over(p, max); return } (#240).
fn argo_bound(pos i64, body []i64, p i64, x i64, t Ty) {
	if t.bound == 0 {
		return
	}
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = mk_bin(pos, cstr(">="), mk_hdr(pos, sym_ref_node(pos, cast(Sym, x)), 0), mk_int(pos, t.max, ty_int), ty_bool)
	ifs.then = empty_block(pos)
	mut vs1 = cast(Block, ifs.then).stmts
	vs1 = append(vs1, expr_stmt(call_fn(pos, argo_lib(pos, cstr("argo.over")), args2(sym_ref_node(pos, cast(Sym, p)), mk_int(pos, t.max, ty_int)), ty_void)))
	mut vs2 = cast(Block, ifs.then).stmts
	vs2 = append(vs2, node_new(ST_RETURN, pos))
	body = append(body, cast(i64, ifs))
}

// argo_dfn returns (generating on first use) argo$dN(p mut argo.Parser, x mut T), which
// fills x from the JSON value at p.
fn argo_dfn(pos i64, t Ty) i64 {
	if cast(i64, argo_dtypes) == 0 {
		argo_dtypes = []i64{}
		argo_dfns = []i64{}
	}
	mut i = 0
	for i < len(argo_dtypes) {
		if cast(i64, cast(Ty, cast([]i64, argo_dtypes)[i])) == cast(i64, t) {
			return argo_dfns[i]
		}
		i = i + 1
	}
	let pt = argo_parser_type(pos)
	if pt == 0 {
		return 0
	}
	let k = kind_of(t)
	if k == K_MAP && kind_of(cast(Ty, t.key)) != K_STRING {
		err_code_type(pos, cstr("E281 ARGO"), cstr("argo.Get decodes maps with str keys, not "), cast(i64, t), cstr(""))
		return 0
	}
	lifted_count = lifted_count + 1
	let f = fn_new(0, cstr("argo"))
	let nb = buf_new()
	buf_str(nb, cstr("argo$d"))
	buf_int(nb, lifted_count)
	buf_byte(nb, 0)
	f.qname = slice_data(nb)
	f.name = slice_data(nb)
	f.lifted = 2
	f.params = append(f.params, cstr("p"))
	f.params = append(f.params, cstr("x"))
	f.ptypes = append(f.ptypes, pt)
	f.ptypes = append(f.ptypes, cast(i64, t))
	f.muts = append(f.muts, 1)
	f.muts = append(f.muts, 1)
	f.type_ = func_of(f.ptypes, f.rtypes, 0)
	f.locals = cast([]Sym, []i64{})
	f.body = empty_block(0)
	mut vs7 = cast([]i64, argo_dtypes)
	vs7 = append(vs7, cast(i64, t))
	argo_dfns = append(argo_dfns, cast(i64, f))
	prog_fns = append(prog_fns, cast(Fn, f))
	let saved_fn = ck_fn
	ck_fn = cast(Fn, f)
	let p = sym_new(SYM_LOCAL, cstr("p"), 0)
	p.type_ = pt
	p.slot = 0
	p.mut_ = 1
	let x = sym_new(SYM_LOCAL, cstr("x"), 0)
	x.type_ = cast(i64, t)
	x.slot = 1
	x.mut_ = 1
	f.slots = 2
	mut vs8 = cast([]i64, f.locals)
	vs8 = append(vs8, cast(i64, p))
	mut vs9 = cast([]i64, f.locals)
	vs9 = append(vs9, cast(i64, x))
	let body = cast(Block, f.body).stmts
	if k == K_STRUCT && cast(i64, t.enum_) != 0 {
		argo_denum(pos, body, cast(i64, p), cast(i64, x), t)
	} else if k == K_STRUCT {
		let ifs = cast(IfStmt, node_new(ST_IF, pos))
		ifs.cond = mk_unot(pos, argo_rd(pos, cast(i64, p), cstr("argo.robj"), ty_bool))
		ifs.then = empty_block(pos)
		mut vs10 = cast(Block, ifs.then).stmts
		vs10 = append(vs10, node_new(ST_RETURN, pos))
		body = append(body, cast(i64, ifs))
		let w = forever(pos)
		body = append(body, cast(i64, w))
		let wb = cast(Block, w.body).stmts
		let key = temp(pos, argo_rd(pos, cast(i64, p), cstr("argo.rkey"), ty_string), ty_string)
		wb = append(wb, cast(i64, key))
		argo_err_return(pos, wb, cast(i64, p))
		mut chain = 0
		mut last = cast(IfStmt, 0)
		mut fi = 0
		for fi < len(t.fields) {
			mut fname = cast([]i64, t.fields[fi])[0]
			let json_name = cast([]i64, t.fields[fi])[5]
			if json_name != 0 {
				fname = json_name
			}
			let ft = field_type(t, fi)
			let br = cast(IfStmt, node_new(ST_IF, pos))
			br.cond = rt_call(pos, cstr("rt_str_eq"), args2(sym_ref_node(pos, cast(Sym, key.sym)), lit_string(pos, fname)), ty_bool)
			br.then = empty_block(pos)
			let bb = cast(Block, br.then).stmts
			let fk = kind_of(cast(Ty, ft))
			if fk == K_STRUCT || fk == K_SLICE || fk == K_MAP {
				// Fill the object the field already holds.
				let df = argo_dfn(pos, cast(Ty, ft))
				if df != 0 {
					bb = append(bb, expr_stmt(call_fn(pos, cast(Fn, df), args2(sym_ref_node(pos, p), mk_mem(pos, sym_ref_node(pos, x), 0, 0, field_offset(t, fi), ft)), ty_void)))
				}
			} else {
				let val = argo_value(pos, bb, cast(i64, p), cast(Ty, ft))
				if val != 0 {
					bb = append(bb, assign_stmt(pos, field_store(pos, sym_ref_node(pos, x), cast(i64, t), fi), val))
				}
			}
			if cast(i64, last) != 0 {
				let eb = cast(Block, empty_block(pos))
				eb.stmts = append(eb.stmts, cast(i64, br))
				last.else_ = cast(i64, eb)
			} else {
				chain = cast(i64, br)
			}
			last = br
			fi = fi + 1
		}
		let skip = expr_stmt(call_fn(pos, argo_lib(pos, cstr("argo.runknown")), args2(sym_ref_node(pos, p), sym_ref_node(pos, cast(Sym, key.sym))), ty_void))
		if cast(i64, last) != 0 {
			let sb = cast(Block, empty_block(pos))
			sb.stmts = append(sb.stmts, skip)
			last.else_ = cast(i64, sb)
			wb = append(wb, chain)
		} else {
			wb = append(wb, skip)
		}
		argo_more(pos, wb, cast(i64, p), '}')
	} else if k == K_SLICE {
		let et = t.elem
		let ifs2 = cast(IfStmt, node_new(ST_IF, pos))
		ifs2.cond = mk_unot(pos, argo_rd(pos, cast(i64, p), cstr("argo.rarr"), ty_bool))
		ifs2.then = empty_block(pos)
		mut vs13 = cast(Block, ifs2.then).stmts
		vs13 = append(vs13, node_new(ST_RETURN, pos))
		body = append(body, cast(i64, ifs2))
		let w2 = forever(pos)
		body = append(body, cast(i64, w2))
		let wb2 = cast(Block, w2.body).stmts
		argo_bound(pos, wb2, cast(i64, p), cast(i64, x), t)
		let ev = argo_value(pos, wb2, cast(i64, p), cast(Ty, et))
		if ev != 0 {
			wb2 = append(wb2, expr_stmt(cast(Node, rt_call(pos, cstr("rt_append"), args3(sym_ref_node(pos, x), elem_bits(cast(Node, ev), t.elem), mk_int(pos, elem_size(t), ty_int)), cast(i64, t)))))
		}
		argo_err_return(pos, wb2, cast(i64, p))
		argo_more(pos, wb2, cast(i64, p), ']')
	} else if k == K_MAP {
		let ifs3 = cast(IfStmt, node_new(ST_IF, pos))
		ifs3.cond = mk_unot(pos, argo_rd(pos, cast(i64, p), cstr("argo.robj"), ty_bool))
		ifs3.then = empty_block(pos)
		mut vs14 = cast(Block, ifs3.then).stmts
		vs14 = append(vs14, node_new(ST_RETURN, pos))
		body = append(body, cast(i64, ifs3))
		let w3 = forever(pos)
		body = append(body, cast(i64, w3))
		let wb3 = cast(Block, w3.body).stmts
		argo_bound(pos, wb3, cast(i64, p), cast(i64, x), t)
		let mk = temp(pos, argo_rd(pos, cast(i64, p), cstr("argo.rkey"), ty_string), ty_string)
		wb3 = append(wb3, cast(i64, mk))
		argo_err_return(pos, wb3, cast(i64, p))
		let mv = argo_value(pos, wb3, cast(i64, p), cast(Ty, t.elem))
		if mv != 0 {
			wb3 = append(wb3, expr_stmt(cast(Node, rt_call(pos, cstr("rt_map_set"), args4(sym_ref_node(pos, x), sym_ref_node(pos, cast(Sym, mk.sym)), to_bits(cast(Node, mv)), mk_int(pos, 1, ty_int)), ty_void))))
		}
		argo_err_return(pos, wb3, cast(i64, p))
		argo_more(pos, wb3, cast(i64, p), '}')
	}
	ck_fn = saved_fn
	return cast(i64, f)
}

// ---- argo.Get pass one: a validator generated for each type ----
// argo$vN(p mut argo.Parser) reads the JSON value at p the way argo$dN does, with the same
// faults, but stores nothing: Get runs it first, so a fault never leaves the target half
// filled, and decoding then cannot fail.
shared mut argo_vtypes []i64
shared mut argo_vfns []i64

// argo_vval validates one value of type t at p (a Sym).
fn argo_vval(pos i64, body []i64, p i64, t Ty) {
	let k = kind_of(t)
	if k == K_STRUCT || k == K_SLICE || k == K_MAP {
		let vf = argo_vfn(pos, t)
		if vf != 0 {
			body = append(body, expr_stmt(call_fn(pos, cast(Fn, vf), args1(sym_ref_node(pos, cast(Sym, p))), ty_void)))
		}
		return
	}
	if k == K_OPT {
		let et = t.elem
		if is_ref(et) == 0 || kind_of(cast(Ty, et)) == K_FUNC {
			return
		}
		let ifs = cast(IfStmt, node_new(ST_IF, pos))
		ifs.cond = mk_unot(pos, argo_rd(pos, p, cstr("argo.rnull"), ty_bool))
		ifs.then = empty_block(pos)
		argo_vval(pos, cast(Block, ifs.then).stmts, p, cast(Ty, et))
		body = append(body, cast(i64, ifs))
		return
	}
	if is_f32(t) != 0 || is_float_t(cast(i64, t)) != 0 {
		// The grammar and the range, without converting (most numbers cannot overflow).
		mut width = 300
		if is_f32(t) != 0 {
			width = 38
		}
		body = append(body, expr_stmt(call_fn(pos, argo_lib(pos, cstr("argo.vfloat")), args2(sym_ref_node(pos, cast(Sym, p)), mk_int(pos, width, ty_int)), ty_void)))
		return
	}
	let val = argo_value(pos, body, p, t)
	if val != 0 {
		body = append(body, expr_stmt(cast(Node, val)))
	}
}

// argo_vbound is argo_bound for a validator: cnt counts the elements read so far.
fn argo_vbound(pos i64, body []i64, p i64, cnt i64, t Ty) {
	if t.bound == 0 {
		return
	}
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = mk_bin(pos, cstr(">="), sym_ref_node(pos, cast(Sym, cnt)), mk_int(pos, t.max, ty_int), ty_bool)
	ifs.then = empty_block(pos)
	mut vs1 = cast(Block, ifs.then).stmts
	vs1 = append(vs1, expr_stmt(call_fn(pos, argo_lib(pos, cstr("argo.over")), args2(sym_ref_node(pos, cast(Sym, p)), mk_int(pos, t.max, ty_int)), ty_void)))
	mut vs2 = cast(Block, ifs.then).stmts
	vs2 = append(vs2, node_new(ST_RETURN, pos))
	body = append(body, cast(i64, ifs))
	body = append(body, assign_stmt(pos, sym_ref_node(pos, cast(Sym, cnt)), mk_bin(pos, cstr("+"), sym_ref_node(pos, cast(Sym, cnt)), mk_int(pos, 1, ty_int), ty_int)))
}

// argo_vfn returns (generating on first use) argo$vN(p mut argo.Parser) for type t, or 0
// when t cannot be decoded (argo_dfn reports that).
fn argo_vfn(pos i64, t Ty) i64 {
	if cast(i64, argo_vtypes) == 0 {
		argo_vtypes = []i64{}
		argo_vfns = []i64{}
	}
	mut i = 0
	for i < len(argo_vtypes) {
		if cast(i64, cast(Ty, argo_vtypes[i])) == cast(i64, t) {
			return argo_vfns[i]
		}
		i = i + 1
	}
	let pt = argo_parser_type(pos)
	let k = kind_of(t)
	if pt == 0 || (k == K_MAP && kind_of(cast(Ty, t.key)) != K_STRING) {
		return 0
	}
	lifted_count = lifted_count + 1
	let f = fn_new(0, cstr("argo"))
	let nb = buf_new()
	buf_str(nb, cstr("argo$v"))
	buf_int(nb, lifted_count)
	buf_byte(nb, 0)
	f.qname = slice_data(nb)
	f.name = slice_data(nb)
	f.lifted = 2
	f.params = append(f.params, cstr("p"))
	f.ptypes = append(f.ptypes, pt)
	f.muts = append(f.muts, 1)
	f.type_ = func_of(f.ptypes, f.rtypes, 0)
	f.locals = cast([]Sym, []i64{})
	f.body = empty_block(0)
	argo_vtypes = append(argo_vtypes, cast(i64, t))
	argo_vfns = append(argo_vfns, cast(i64, f))
	prog_fns = append(prog_fns, cast(Fn, f))
	let saved_fn = ck_fn
	ck_fn = cast(Fn, f)
	let ps = sym_new(SYM_LOCAL, cstr("p"), 0)
	ps.type_ = pt
	ps.slot = 0
	ps.mut_ = 1
	f.slots = 1
	mut vs4 = cast([]i64, f.locals)
	vs4 = append(vs4, cast(i64, ps))
	let p = cast(i64, ps)
	let body = cast(Block, f.body).stmts
	if k == K_STRUCT && cast(i64, t.enum_) != 0 {
		// An enum's payload shapes are decoded into a scratch value.
		let df = argo_dfn(pos, t)
		if df != 0 {
			let obj = temp(pos, argo_new(pos, body, t), cast(i64, t))
			body = append(body, cast(i64, obj))
			body = append(body, expr_stmt(call_fn(pos, cast(Fn, df), args2(sym_ref_node(pos, ps), sym_ref_node(pos, cast(Sym, obj.sym))), ty_void)))
		}
	} else if k == K_STRUCT {
		let ifs = cast(IfStmt, node_new(ST_IF, pos))
		ifs.cond = mk_unot(pos, argo_rd(pos, p, cstr("argo.robj"), ty_bool))
		ifs.then = empty_block(pos)
		mut vs5 = cast(Block, ifs.then).stmts
		vs5 = append(vs5, node_new(ST_RETURN, pos))
		body = append(body, cast(i64, ifs))
		let w = forever(pos)
		body = append(body, cast(i64, w))
		let wb = cast(Block, w.body).stmts
		let key = temp(pos, argo_rd(pos, p, cstr("argo.rkey"), ty_string), ty_string)
		wb = append(wb, cast(i64, key))
		argo_err_return(pos, wb, p)
		mut chain = 0
		mut last = cast(IfStmt, 0)
		mut fi = 0
		for fi < len(t.fields) {
			mut fname = cast([]i64, t.fields[fi])[0]
			let json_name = cast([]i64, t.fields[fi])[5]
			if json_name != 0 {
				fname = json_name
			}
			let br = cast(IfStmt, node_new(ST_IF, pos))
			br.cond = rt_call(pos, cstr("rt_str_eq"), args2(sym_ref_node(pos, cast(Sym, key.sym)), lit_string(pos, fname)), ty_bool)
			br.then = empty_block(pos)
			argo_vval(pos, cast(Block, br.then).stmts, p, cast(Ty, field_type(t, fi)))
			if cast(i64, last) != 0 {
				let eb = cast(Block, empty_block(pos))
				eb.stmts = append(eb.stmts, cast(i64, br))
				last.else_ = cast(i64, eb)
			} else {
				chain = cast(i64, br)
			}
			last = br
			fi = fi + 1
		}
		let skip = expr_stmt(call_fn(pos, argo_lib(pos, cstr("argo.runknown")), args2(sym_ref_node(pos, ps), sym_ref_node(pos, cast(Sym, key.sym))), ty_void))
		if cast(i64, last) != 0 {
			let sb = cast(Block, empty_block(pos))
			sb.stmts = append(sb.stmts, skip)
			last.else_ = cast(i64, sb)
			wb = append(wb, chain)
		} else {
			wb = append(wb, skip)
		}
		argo_more(pos, wb, p, '}')
	} else if k == K_SLICE || k == K_MAP {
		let ifs = cast(IfStmt, node_new(ST_IF, pos))
		mut opener = cstr("argo.rarr")
		mut close = ']'
		if k == K_MAP {
			opener = cstr("argo.robj")
			close = '}'
		}
		ifs.cond = mk_unot(pos, argo_rd(pos, p, opener, ty_bool))
		ifs.then = empty_block(pos)
		mut vs8 = cast(Block, ifs.then).stmts
		vs8 = append(vs8, node_new(ST_RETURN, pos))
		body = append(body, cast(i64, ifs))
		let cnt = declare_local(pos, cstr("$"), ty_int)
		body = append(body, let_stmt(pos, cast(Sym, cnt), mk_int(pos, 0, ty_int)))
		let w = forever(pos)
		body = append(body, cast(i64, w))
		let wb = cast(Block, w.body).stmts
		argo_vbound(pos, wb, p, cnt, t)
		if k == K_MAP {
			wb = append(wb, expr_stmt(cast(Node, argo_rd(pos, p, cstr("argo.rkey"), ty_string))))
			argo_err_return(pos, wb, p)
		}
		argo_vval(pos, wb, p, cast(Ty, t.elem))
		argo_err_return(pos, wb, p)
		argo_more(pos, wb, p, close)
	}
	ck_fn = saved_fn
	return cast(i64, f)
}

// ---- say: formatting without interfaces ----
fn is_say_func(m i64) i64 {
	return i64(streq(m, cstr("Line")) != 0 || streq(m, cstr("Text")) != 0 || streq(m, cstr("Out")) != 0 || streq(m, cstr("Fmt")) != 0 || streq(m, cstr("Str")) != 0 || streq(m, cstr("Fault")) != 0 || streq(m, cstr("To")) != 0 || streq(m, cstr("LineTo")) != 0)
}

// say_arg formats one argument by its static type: prefix + "i", "s", "f", ...
// say_type_has_dyn reports whether a struct's fields (or a container's element) hold a
// dyn value, which has no formatter until the table lands. The depth limit keeps a
// recursive type (an enum holding itself) finite; a deeper dyn is still caught by
// say_arg when the recursion reaches it.
fn say_type_has_dyn(t i64) i64 {
	return say_type_has_dyn_at(cast(Ty, t), 0)
}

fn say_type_has_dyn_at(t Ty, depth i64) i64 {
	if depth > 8 {
		return 0
	}
	let k = kind_of(t)
	if k == K_DYN {
		return 1
	}
	if k == K_OPT || k == K_SLICE {
		return say_type_has_dyn_at(cast(Ty, t.elem), depth + 1)
	}
	if k == K_MAP {
		return i64(say_type_has_dyn_at(cast(Ty, t.key), depth + 1) != 0 || say_type_has_dyn_at(cast(Ty, t.elem), depth + 1) != 0)
	}
	if k == K_STRUCT {
		mut i = 0
		for i < len(t.fields) {
			if say_type_has_dyn_at(cast(Ty, field_type(t, i)), depth + 1) != 0 {
				return 1
			}
			i = i + 1
		}
	}
	return 0
}

fn say_arg(a Node, prefix i64) Node {
	let pos = a.pos
	let t = cast(Ty, default_type(chk(a, 0)))
	check_value(pos, cast(i64, t))
	if is_untyped(a.type_) != 0 {
		reconvert(a, cast(i64, t))
	}
	let k = kind_of(t)
	mut suffix = cstr("i")
	if k == K_STRING {
		suffix = cstr("s")
	} else if k == K_FLOAT {
		suffix = cstr("f")
		if is_f32(t) != 0 {
			suffix = cstr("f32")
		}
	} else if k == K_BOOL {
		suffix = cstr("b")
	} else if k == K_ERROR {
		suffix = cstr("e")
	} else if is_unsigned_t(t) != 0 {
		suffix = cstr("u")
	} else if k == K_SLICE {
		let et = t.elem
		let ek = kind_of(cast(Ty, et))
		if say_type_has_dyn(et) != 0 {
			err_code_at(pos, cstr("E530 DYN_NOT_YET"), cstr("cannot format a slice of dyn values: give the shape a method that formats (#141)"))
			return cast(Node, ty_void)
		}
		if ek == K_STRING {
			suffix = cstr("sls")
		} else if ek == K_FLOAT {
			suffix = cstr("slf")
			if is_f32(cast(Ty, et)) != 0 {
				suffix = cstr("slf32")
			}
		} else if ek == K_BOOL {
			suffix = cstr("slt")
		} else if ek == K_INT {
			return cast(Node, rt_call(pos, str_cat3(prefix, cstr("slint"), cstr("")), args3(cast(i64, a), mk_int(pos, type_width(cast(Ty, et)), ty_int), mk_int(pos, cast(Ty, et).signed, ty_int)), ty_void))
		} else if ek == K_STRUCT && cast(i64, cast(Ty, et).enum_) != 0 {
			return cast(Node, say_enum_slice(a, t, prefix))
		} else if ek == K_STRUCT {
			return cast(Node, say_struct_slice(a, t, prefix))
		} else {
			suffix = cstr("slp")
		}
	} else if k == K_OPT && kind_of(cast(Ty, t.elem)) != K_STRUCT && kind_of(cast(Ty, t.elem)) != K_DYN {
		return cast(Node, say_opt(a, t, prefix))
	} else if k == K_STRUCT || k == K_OPT {
		mut st = t
		if k == K_OPT {
			if kind_of(cast(Ty, t.elem)) == K_DYN {
				err_code_at(pos, cstr("E530 DYN_NOT_YET"), cstr("cannot format a dyn value: give the shape a method that formats (#141)"))
				return cast(Node, ty_void)
			}
			st = cast(Ty, t.elem)
		}
		if say_type_has_dyn(cast(i64, st)) != 0 {
			err_code_at(pos, cstr("E530 DYN_NOT_YET"), cstr("cannot format a value holding a dyn value: give the shape a method that formats (#141)"))
			return cast(Node, ty_void)
		}
		return cast(Node, say_struct(a, st, prefix))
	} else if k == K_MAP && key_composite(t.key) != 0 {
		return cast(Node, say_map_keyed(a, t, prefix))
	} else if k == K_MAP {
		return cast(Node, say_map_sorted(a, t, prefix))
	} else if k == K_DYN {
		err_code_at(pos, cstr("E530 DYN_NOT_YET"), cstr("cannot format a dyn value: give the shape a method that formats (#141)"))
		return cast(Node, ty_void)
	} else if k != K_INT && k != K_UINT {
		suffix = cstr("p")
	}
	mut x = a
	if type_width(t) < 8 && k == K_INT {
		x = cast(Node, mk_conv(pos, cast(i64, a), CV_SAME, ty_int))
	}
	return cast(Node, rt_call(pos, str_cat3(prefix, suffix, cstr("")), args1(cast(i64, x)), ty_void))
}

// say_opt prints an optional str, slice or map: <nil>, or its value as that type prints.
fn say_opt(a Node, t Ty, prefix i64) i64 {
	let pos = a.pos
	let stmts = []i64{}
	let obj = temp(pos, mk_conv(pos, cast(i64, a), CV_SAME, ty_int), ty_int)
	stmts = append(stmts, cast(i64, obj))
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = mk_bin(pos, cstr("=="), sym_ref_node(pos, cast(Sym, obj.sym)), mk_int(pos, 0, ty_int), ty_bool)
	ifs.then = empty_block(pos)
	mut vs1 = cast(Block, ifs.then).stmts
	vs1 = append(vs1, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("argsep"), cstr("")), cast(i64, []i64{}), ty_void))))
	mut vs2 = cast(Block, ifs.then).stmts
	vs2 = append(vs2, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr("<nil>"))), ty_void))))
	mut vs3 = cast(Block, ifs.then).stmts
	vs3 = append(vs3, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("argend"), cstr("")), cast(i64, []i64{}), ty_void))))
	ifs.else_ = empty_block(pos)
	mut vs4 = cast(Block, ifs.else_).stmts
	vs4 = append(vs4, expr_stmt(say_arg(cast(Node, mk_conv(pos, sym_ref_node(pos, cast(Sym, obj.sym)), CV_SAME, t.elem)), prefix)))
	stmts = append(stmts, cast(i64, ifs))
	return mk_seq(pos, cast(i64, stmts), mk_int(pos, 0, ty_int), ty_void)
}

// say_struct prints {a b c} by formatting each field in turn (nil optionals print <nil>).
fn say_struct(a Node, t Ty, prefix i64) i64 {
	if cast(i64, t.enum_) != 0 {
		return say_enum(a, cast(i64, t), prefix)
	}
	let pos = a.pos
	let stmts = []i64{}
	let obj = temp(pos, mk_conv(pos, cast(i64, a), CV_SAME, ty_int), ty_int)
	stmts = append(stmts, cast(i64, obj))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("argsep"), cstr("")), cast(i64, []i64{}), ty_void))))
	let nonnil = cast(IfStmt, node_new(ST_IF, pos))
	nonnil.cond = mk_bin(pos, cstr("=="), sym_ref_node(pos, cast(Sym, obj.sym)), mk_int(pos, 0, ty_int), ty_bool)
	nonnil.then = empty_block(pos)
	mut vs1 = cast(Block, nonnil.then).stmts
	vs1 = append(vs1, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr("<nil>"))), ty_void))))
	let body = cast(Block, empty_block(pos))
	nonnil.else_ = cast(i64, body)
	body.stmts = append(body.stmts, expr_stmt(call_fn(pos, say_struct_fn(t, prefix), args1(mk_conv(pos, sym_ref_node(pos, cast(Sym, obj.sym)), CV_SAME, cast(i64, t))), ty_void)))
	stmts = append(stmts, cast(i64, nonnil))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("argend"), cstr("")), cast(i64, []i64{}), ty_void))))
	return mk_seq(pos, cast(i64, stmts), mk_int(pos, 0, ty_int), ty_void)
}

shared mut say_struct_keys []i64 // [type, prefix] of each generated struct printer
shared mut say_struct_fns []Fn

// field_name is the declared name of field i of struct type t.
fn field_name(t Ty, i i64) i64 {
	return cast([]i64, t.fields[i])[0]
}

// say_struct_fn returns the generated function that prints one (non-nil) struct of type t as
// {v1 v2 ...}, or {name:v1 name:v2 ...} under %+v. It is a function of its own, not inline code, so
// a struct that holds itself through a slice (Node with kids []Node) terminates: the printer is
// registered before its body is built, and the recursion happens when the program runs. A field
// of struct or enum type is printed by the printer of its own type, a slice of structs element by
// element; an optional field (a pointer in effect) stays an address, as Go prints a pointer field.
fn say_struct_fn(t Ty, prefix i64) Fn {
	if cast(i64, say_struct_keys) == 0 {
		say_struct_keys = []i64{}
		say_struct_fns = cast([]Fn, []i64{})
	}
	mut i = 0
	for i < len(say_struct_keys) {
		let kp = cast([]i64, cast([]i64, say_struct_keys)[i])
		if cast(i64, cast(Ty, kp[0])) == cast(i64, t) && streq(kp[1], prefix) != 0 {
			return say_struct_fns[i]
		}
		i = i + 1
	}
	let names = []i64{}
	names = append(names, cstr("x"))
	let types = []i64{}
	types = append(types, cast(i64, t))
	let f = lifted_fn(cstr("say"), names, cast([]i64, types), cast(i64, []i64{}))
	let kp2 = []i64{}
	kp2 = append(kp2, cast(i64, t))
	kp2 = append(kp2, prefix)
	mut vs1 = cast([]i64, say_struct_keys)
	vs1 = append(vs1, cast(i64, kp2))
	say_struct_fns = append(say_struct_fns, cast(Fn, f))
	let saved_fn = ck_fn
	ck_fn = cast(Fn, f)
	let pos = 0
	let x = cast([]i64, f.locals)[0]
	let body = cast(Block, f.body).stmts
	body = append(body, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr("{{"))), ty_void))))
	let fs = t.fields
	i = 0
	for i < len(fs) {
		if i > 0 {
			body = append(body, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr(" "))), ty_void))))
		}
		let named = cast(IfStmt, node_new(ST_IF, pos))
		named.cond = rt_call(pos, cstr("rt_fmt_plusv"), cast(i64, []i64{}), ty_bool)
		named.then = empty_block(pos)
		mut vs2 = cast(Block, named.then).stmts
		vs2 = append(vs2, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, str_cat3(field_name(t, i), cstr(":"), cstr("")))), ty_void))))
		body = append(body, cast(i64, named))
		let ft = cast(Ty, field_type(t, i))
		let fv = mk_mem(pos, sym_ref_node(pos, cast(Sym, x)), 0, 0, field_offset(t, i), cast(i64, ft))
		if kind_of(ft) == K_STRUCT && cast(i64, ft.enum_) != 0 {
			body = append(body, expr_stmt(call_fn(pos, say_enum_fn(ft, prefix), args1(fv), ty_void)))
		} else if kind_of(ft) == K_STRUCT {
			body = append(body, expr_stmt(call_fn(pos, say_struct_fn(ft, prefix), args1(fv), ty_void)))
		} else if kind_of(ft) == K_OPT && kind_of(cast(Ty, ft.elem)) != K_STRUCT && kind_of(cast(Ty, ft.elem)) != K_DYN {
			body = append(body, expr_stmt(cast(Node, say_opt(cast(Node, fv), ft, prefix))))
		} else if kind_of(ft) == K_OPT {
			body = append(body, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("p"), cstr("")), args1(mk_conv(pos, fv, CV_SAME, ty_int)), ty_void))))
		} else {
			body = append(body, expr_stmt(say_arg(cast(Node, fv), prefix)))
		}
		i = i + 1
	}
	body = append(body, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr("}}"))), ty_void))))
	ck_fn = saved_fn
	return cast(Fn, f)
}

// say_struct_slice prints [{...} {...}] with each element through its struct's printer.
fn say_struct_slice(a Node, t Ty, prefix i64) i64 {
	let pos = a.pos
	let et = t.elem
	let stmts = []i64{}
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("argsep"), cstr("")), cast(i64, []i64{}), ty_void))))
	let sl = temp(pos, cast(i64, a), cast(i64, t))
	stmts = append(stmts, cast(i64, sl))
	let n = temp(pos, mk_hdr(pos, sym_ref_node(pos, cast(Sym, sl.sym)), 0), ty_int)
	stmts = append(stmts, cast(i64, n))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr("["))), ty_void))))
	let j = declare_local(pos, cstr("$"), ty_int)
	stmts = append(stmts, let_stmt(pos, cast(Sym, j), mk_int(pos, 0, ty_int)))
	let w = cast(WhileStmt, node_new(ST_WHILE, pos))
	w.cond = mk_bin(pos, cstr("<"), sym_ref_node(pos, cast(Sym, j)), sym_ref_node(pos, cast(Sym, n.sym)), ty_bool)
	w.post = assign_stmt(pos, sym_ref_node(pos, cast(Sym, j)), mk_bin(pos, cstr("+"), sym_ref_node(pos, cast(Sym, j)), mk_int(pos, 1, ty_int), ty_int))
	let wb = cast(Block, empty_block(pos))
	w.body = cast(i64, wb)
	let sep = cast(IfStmt, node_new(ST_IF, pos))
	sep.cond = mk_bin(pos, cstr(">"), sym_ref_node(pos, cast(Sym, j)), mk_int(pos, 0, ty_int), ty_bool)
	sep.then = empty_block(pos)
	mut vs1 = cast(Block, sep.then).stmts
	vs1 = append(vs1, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr(" "))), ty_void))))
	wb.stmts = append(wb.stmts, cast(i64, sep))
	let el = mk_elem(pos, sym_ref_node(pos, cast(Sym, sl.sym)), sym_ref_node(pos, cast(Sym, j)), et, 0)
	el.safe = 1
	wb.stmts = append(wb.stmts, expr_stmt(call_fn(pos, say_struct_fn(cast(Ty, et), prefix), args1(cast(i64, el)), ty_void)))
	stmts = append(stmts, cast(i64, w))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr("]"))), ty_void))))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("argend"), cstr("")), cast(i64, []i64{}), ty_void))))
	return mk_seq(pos, cast(i64, stmts), mk_int(pos, 0, ty_int), ty_void)
}

shared mut say_enum_keys []i64 // [type, prefix] of each generated enum printer
shared mut say_enum_fns []Fn

// lifted_fn starts a generated function name$N with params (names, types) and results.
fn lifted_fn(base i64, names []i64, types []i64, rtypes i64) Fn {
	lifted_count = lifted_count + 1
	let f = fn_new(0, base)
	let nb = buf_new()
	buf_str(nb, base)
	buf_byte(nb, '$')
	buf_int(nb, lifted_count)
	buf_byte(nb, 0)
	f.qname = slice_data(nb)
	f.name = slice_data(nb)
	f.lifted = 2
	f.locals = cast([]Sym, []i64{})
	mut i = 0
	for i < len(names) {
		f.params = append(f.params, names[i])
		f.ptypes = append(f.ptypes, types[i])
		f.muts = append(f.muts, 0)
		let ps = sym_new(SYM_LOCAL, names[i], 0)
		ps.type_ = types[i]
		ps.slot = i
		mut vs4 = cast([]i64, f.locals)
		vs4 = append(vs4, cast(i64, ps))
		i = i + 1
	}
	f.slots = len(names)
	f.rtypes = cast([]i64, rtypes)
	f.type_ = func_of(f.ptypes, f.rtypes, 0)
	f.body = empty_block(0)
	prog_fns = append(prog_fns, cast(Fn, f))
	return cast(Fn, f)
}

// say_enum prints a variant like Circle(2) or Rect(3 4), and a variant without data as its
// name, through a generated printer per enum (so recursive enums print without expanding
// forever).
fn say_enum(a Node, t i64, prefix i64) i64 {
	let pos = a.pos
	let stmts = []i64{}
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("argsep"), cstr("")), cast(i64, []i64{}), ty_void))))
	stmts = append(stmts, expr_stmt(call_fn(pos, say_enum_fn(cast(Ty, t), prefix), args1(cast(i64, a)), ty_void)))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("argend"), cstr("")), cast(i64, []i64{}), ty_void))))
	return mk_seq(pos, cast(i64, stmts), mk_int(pos, 0, ty_int), ty_void)
}

// map_key_kind is the kind rt_map_order sorts a map's key words by: 0 signed integers, 1 str,
// 2 f64, 3 unsigned integers and bool.
fn map_key_kind(kt i64) i64 {
	let k = kind_of(cast(Ty, kt))
	if k == K_STRING {
		return 1
	}
	if k == K_FLOAT {
		return 2
	}
	if k == K_BOOL || is_unsigned_t(cast(Ty, kt)) != 0 {
		return 3
	}
	return 0
}

// say_map_sorted prints a map with str, number or bool keys as map[k:v ...], the entries in the
// order Go prints them (by key), and each key and value through its own static type, so a float
// key reads as a float and a slice or map value prints its elements.
fn say_map_sorted(a Node, t Ty, prefix i64) i64 {
	let pos = a.pos
	let kt = t.key
	let stmts = []i64{}
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("argsep"), cstr("")), cast(i64, []i64{}), ty_void))))
	let m = temp(pos, cast(i64, a), cast(i64, t))
	stmts = append(stmts, cast(i64, m))
	let ord = temp(pos, rt_call(pos, cstr("rt_map_order"), args2(sym_ref_node(pos, cast(Sym, m.sym)), mk_int(pos, map_key_kind(kt), ty_int)), ty_int), ty_int)
	stmts = append(stmts, cast(i64, ord))
	let n = temp(pos, rt_call(pos, cstr("rt_map_len"), args1(sym_ref_node(pos, cast(Sym, m.sym))), ty_int), ty_int)
	stmts = append(stmts, cast(i64, n))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr("map["))), ty_void))))
	let j = declare_local(pos, cstr("$"), ty_int)
	stmts = append(stmts, let_stmt(pos, cast(Sym, j), mk_int(pos, 0, ty_int)))
	let w = cast(WhileStmt, node_new(ST_WHILE, pos))
	w.cond = mk_bin(pos, cstr("<"), sym_ref_node(pos, cast(Sym, j)), sym_ref_node(pos, cast(Sym, n.sym)), ty_bool)
	w.post = assign_stmt(pos, sym_ref_node(pos, cast(Sym, j)), mk_bin(pos, cstr("+"), sym_ref_node(pos, cast(Sym, j)), mk_int(pos, 1, ty_int), ty_int))
	let wb = cast(Block, empty_block(pos))
	w.body = cast(i64, wb)
	let sep = cast(IfStmt, node_new(ST_IF, pos))
	sep.cond = mk_bin(pos, cstr(">"), sym_ref_node(pos, cast(Sym, j)), mk_int(pos, 0, ty_int), ty_bool)
	sep.then = empty_block(pos)
	mut vs1 = cast(Block, sep.then).stmts
	vs1 = append(vs1, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr(" "))), ty_void))))
	wb.stmts = append(wb.stmts, cast(i64, sep))
	let slot = temp(pos, rt_call(pos, cstr("rt_order_at"), args2(sym_ref_node(pos, cast(Sym, ord.sym)), sym_ref_node(pos, cast(Sym, j))), ty_int), ty_int)
	wb.stmts = append(wb.stmts, cast(i64, slot))
	let kv = from_bits(cast(Node, rt_call(pos, cstr("rt_map_key"), args2(sym_ref_node(pos, cast(Sym, m.sym)), sym_ref_node(pos, cast(Sym, slot.sym))), ty_int)), kt)
	wb.stmts = append(wb.stmts, expr_stmt(say_arg(cast(Node, kv), prefix)))
	wb.stmts = append(wb.stmts, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr(":"))), ty_void))))
	let vv = from_bits(cast(Node, rt_call(pos, cstr("rt_map_val"), args2(sym_ref_node(pos, cast(Sym, m.sym)), sym_ref_node(pos, cast(Sym, slot.sym))), ty_int)), t.elem)
	wb.stmts = append(wb.stmts, expr_stmt(say_arg(cast(Node, vv), prefix)))
	stmts = append(stmts, cast(i64, w))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr("]"))), ty_void))))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("argend"), cstr("")), cast(i64, []i64{}), ty_void))))
	return mk_seq(pos, cast(i64, stmts), mk_int(pos, 0, ty_int), ty_void)
}

// say_map_keyed prints a map with struct or enum keys as map[k:v ...] in insertion order.
fn say_map_keyed(a Node, t Ty, prefix i64) i64 {
	let pos = a.pos
	let stmts = []i64{}
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("argsep"), cstr("")), cast(i64, []i64{}), ty_void))))
	let m = temp(pos, cast(i64, a), cast(i64, t))
	stmts = append(stmts, cast(i64, m))
	let n = temp(pos, rt_call(pos, cstr("rt_map_slots"), args1(sym_ref_node(pos, cast(Sym, m.sym))), ty_int), ty_int)
	stmts = append(stmts, cast(i64, n))
	let first = declare_local(pos, cstr("$"), ty_bool)
	stmts = append(stmts, let_stmt(pos, cast(Sym, first), mk_int(pos, 1, ty_bool)))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr("map["))), ty_void))))
	let j = declare_local(pos, cstr("$"), ty_int)
	stmts = append(stmts, let_stmt(pos, cast(Sym, j), mk_int(pos, 0, ty_int)))
	let w = cast(WhileStmt, node_new(ST_WHILE, pos))
	w.cond = mk_bin(pos, cstr("<"), sym_ref_node(pos, cast(Sym, j)), sym_ref_node(pos, cast(Sym, n.sym)), ty_bool)
	w.post = assign_stmt(pos, sym_ref_node(pos, cast(Sym, j)), mk_bin(pos, cstr("+"), sym_ref_node(pos, cast(Sym, j)), mk_int(pos, 1, ty_int), ty_int))
	let wb = cast(Block, empty_block(pos))
	w.body = cast(i64, wb)
	let live = cast(IfStmt, node_new(ST_IF, pos))
	live.cond = rt_call(pos, cstr("rt_map_live"), args2(sym_ref_node(pos, cast(Sym, m.sym)), sym_ref_node(pos, cast(Sym, j))), ty_bool)
	live.then = empty_block(pos)
	let lb = cast(Block, live.then).stmts
	let sep = cast(IfStmt, node_new(ST_IF, pos))
	sep.cond = mk_unot(pos, sym_ref_node(pos, cast(Sym, first)))
	sep.then = empty_block(pos)
	mut vs1 = cast(Block, sep.then).stmts
	vs1 = append(vs1, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr(" "))), ty_void))))
	lb = append(lb, cast(i64, sep))
	lb = append(lb, assign_stmt(pos, sym_ref_node(pos, cast(Sym, first)), mk_int(pos, 0, ty_bool)))
	let kt = t.key
	let kv = key_out(cast(Node, rt_call(pos, cstr("rt_map_key"), args2(sym_ref_node(pos, cast(Sym, m.sym)), sym_ref_node(pos, cast(Sym, j))), ty_int)), kt)
	if cast(i64, cast(Ty, kt).enum_) != 0 {
		lb = append(lb, expr_stmt(call_fn(pos, say_enum_fn(cast(Ty, kt), prefix), args1(kv), ty_void)))
	} else {
		lb = append(lb, expr_stmt(cast(Node, say_struct(cast(Node, kv), cast(Ty, kt), prefix))))
	}
	lb = append(lb, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr(":"))), ty_void))))
	let vv = from_bits(cast(Node, rt_call(pos, cstr("rt_map_val"), args2(sym_ref_node(pos, cast(Sym, m.sym)), sym_ref_node(pos, cast(Sym, j))), ty_int)), t.elem)
	lb = append(lb, expr_stmt(say_arg(cast(Node, vv), prefix)))
	wb.stmts = append(wb.stmts, cast(i64, live))
	stmts = append(stmts, cast(i64, w))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr("]"))), ty_void))))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("argend"), cstr("")), cast(i64, []i64{}), ty_void))))
	return mk_seq(pos, cast(i64, stmts), mk_int(pos, 0, ty_int), ty_void)
}

// say_enum_slice prints [A B C] with each element through its enum's printer.
fn say_enum_slice(a Node, t Ty, prefix i64) i64 {
	let pos = a.pos
	let et = t.elem
	let stmts = []i64{}
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("argsep"), cstr("")), cast(i64, []i64{}), ty_void))))
	let sl = temp(pos, cast(i64, a), cast(i64, t))
	stmts = append(stmts, cast(i64, sl))
	let n = temp(pos, mk_hdr(pos, sym_ref_node(pos, cast(Sym, sl.sym)), 0), ty_int)
	stmts = append(stmts, cast(i64, n))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr("["))), ty_void))))
	let j = declare_local(pos, cstr("$"), ty_int)
	stmts = append(stmts, let_stmt(pos, cast(Sym, j), mk_int(pos, 0, ty_int)))
	let w = cast(WhileStmt, node_new(ST_WHILE, pos))
	w.cond = mk_bin(pos, cstr("<"), sym_ref_node(pos, cast(Sym, j)), sym_ref_node(pos, cast(Sym, n.sym)), ty_bool)
	w.post = assign_stmt(pos, sym_ref_node(pos, cast(Sym, j)), mk_bin(pos, cstr("+"), sym_ref_node(pos, cast(Sym, j)), mk_int(pos, 1, ty_int), ty_int))
	let wb = cast(Block, empty_block(pos))
	w.body = cast(i64, wb)
	let sep = cast(IfStmt, node_new(ST_IF, pos))
	sep.cond = mk_bin(pos, cstr(">"), sym_ref_node(pos, cast(Sym, j)), mk_int(pos, 0, ty_int), ty_bool)
	sep.then = empty_block(pos)
	mut vs1 = cast(Block, sep.then).stmts
	vs1 = append(vs1, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr(" "))), ty_void))))
	wb.stmts = append(wb.stmts, cast(i64, sep))
	let el = mk_elem(pos, sym_ref_node(pos, cast(Sym, sl.sym)), sym_ref_node(pos, cast(Sym, j)), et, 0)
	el.safe = 1
	wb.stmts = append(wb.stmts, expr_stmt(call_fn(pos, say_enum_fn(cast(Ty, et), prefix), args1(cast(i64, el)), ty_void)))
	stmts = append(stmts, cast(i64, w))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr("]"))), ty_void))))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("argend"), cstr("")), cast(i64, []i64{}), ty_void))))
	return mk_seq(pos, cast(i64, stmts), mk_int(pos, 0, ty_int), ty_void)
}

fn say_enum_fn(t Ty, prefix i64) Fn {
	if cast(i64, say_enum_keys) == 0 {
		say_enum_keys = []i64{}
		say_enum_fns = cast([]Fn, []i64{})
	}
	mut i = 0
	for i < len(say_enum_keys) {
		let kp = cast([]i64, cast([]i64, say_enum_keys)[i])
		if cast(i64, cast(Ty, kp[0])) == cast(i64, t) && streq(kp[1], prefix) != 0 {
			return say_enum_fns[i]
		}
		i = i + 1
	}
	let names = []i64{}
	names = append(names, cstr("x"))
	let types = []i64{}
	types = append(types, cast(i64, t))
	let f = lifted_fn(cstr("say"), names, cast([]i64, types), cast(i64, []i64{}))
	let kp2 = []i64{}
	kp2 = append(kp2, cast(i64, t))
	kp2 = append(kp2, prefix)
	mut vs1 = cast([]i64, say_enum_keys)
	vs1 = append(vs1, cast(i64, kp2))
	say_enum_fns = append(say_enum_fns, cast(Fn, f))
	let saved_fn = ck_fn
	ck_fn = cast(Fn, f)
	let pos = 0
	let x = cast([]i64, f.locals)[0]
	let body = cast(Block, f.body).stmts
	let vs = t.enum_
	mut vi = 0
	for vi < len(vs) {
		let v = cast([]i64, vs[vi])
		let ifs = cast(IfStmt, node_new(ST_IF, pos))
		ifs.cond = mk_bin(pos, cstr("=="), mk_mem(pos, sym_ref_node(pos, cast(Sym, x)), 0, 0, field_offset(t, 0), ty_int), mk_int(pos, vi, ty_int), ty_bool)
		ifs.then = empty_block(pos)
		let b = cast(Block, ifs.then).stmts
		b = append(b, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, v[0])), ty_void))))
		let nf = v[2]
		if nf > 0 {
			b = append(b, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr("("))), ty_void))))
			mut k = 0
			for k < nf {
				if k > 0 {
					b = append(b, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr(" "))), ty_void))))
				}
				let fi = v[1] + k
				let ft = cast(Ty, field_type(t, fi))
				let fv = mk_mem(pos, sym_ref_node(pos, cast(Sym, x)), 0, 0, field_offset(t, fi), cast(i64, ft))
				if kind_of(ft) == K_STRUCT && cast(i64, ft.enum_) != 0 {
					b = append(b, expr_stmt(call_fn(pos, say_enum_fn(ft, prefix), args1(fv), ty_void)))
				} else {
					b = append(b, expr_stmt(say_arg(cast(Node, fv), prefix)))
				}
				k = k + 1
			}
			b = append(b, expr_stmt(cast(Node, rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr(")"))), ty_void))))
		}
		body = append(body, cast(i64, ifs))
		vi = vi + 1
	}
	ck_fn = saved_fn
	return cast(Fn, f)
}

fn lit_string(pos i64, s i64) i64 {
	let n = node_new(EX_STR, pos)
	cast(StrLit, n).ptr = s
	cast(StrLit, n).len = strlen(s)
	cast(Node, n).type_ = ty_string
	return n
}

shared mut say_temps i64 // hidden locals say_hoist has made, for their names

// say_hoist evaluates the arguments from first on that are more than a literal or a name into
// hidden locals before the formatting frame opens: the frame is the core's, so a call that
// runs other tasks (anvil.Serve in say.Line) must not run while it is open (#347).
fn say_hoist(pos i64, args []Node, first i64, stmts []i64) i64 {
	mut i = first
	for i < len(args) {
		let a = args[i]
		let k = a.kind
		if k != EX_INT && k != EX_STR && k != EX_IDENT && k != EX_FLOAT && k != EX_NIL {
			let t = default_type(chk(a, 0))
			let tk = kind_of(cast(Ty, t))
			if tk != K_VOID && tk != K_TUPLE {
				if is_untyped(a.type_) != 0 {
					reconvert(a, t)
				}
				// a name of its own: the lifetime checks tell hidden locals apart by name
				say_temps = say_temps + 1
				let nb = buf_new()
				buf_str(nb, cstr("$say"))
				buf_int(nb, say_temps)
				buf_byte(nb, 0)
				let s = declare_local(a.pos, slice_data(nb), t)
				stmts = append(stmts, let_stmt(a.pos, cast(Sym, s), cast(i64, a)))
				args[i] = cast(Node, sym_ref_node(a.pos, cast(Sym, s)))
			}
		}
		i = i + 1
	}
	return 0
}

// say_text formats args like say.Str (Line spacing when ln) and returns the str.
fn say_text(pos i64, args []Node, ln i64) i64 {
	let stmts = []i64{}
	say_hoist(pos, args, 0, cast([]i64, stmts))
	stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, cstr("rt_fmt_begin_v"), args1(mk_int(pos, ln, ty_int)), ty_void))))
	mut i = 0
	for i < len(args) {
		stmts = append(stmts, expr_stmt(say_arg(args[i], cstr("rt_fmt_"))))
		i = i + 1
	}
	return mk_seq(pos, cast(i64, stmts), rt_call(pos, cstr("rt_fmt_end"), cast(i64, []i64{}), ty_string), ty_string)
}

// lower_say compiles say calls into typed runtime calls: begin, one call per argument,
// then end. No interfaces or reflection are needed.
//   say.Line(a...)        print, spaces between, newline
//   say.Text(a...)        print, Go's Print spacing
//   say.Out(f, a...)      printf
//   say.Fmt(f, a...) str  sprintf
//   say.Str(a...) str     sprint
//   say.Fault(f, a...)    a fault with a formatted message
//   say.To(w, f, a...)    printf into w.Write(str)
//   say.LineTo(w, a...)   println into w.Write(str)
// chk_interp turns "a {x} b {y:.2}" into say.Fmt("a %v b %.2f", x, y): the verb comes from
// the spec (its last letter), else %v, or %f for a float with a precision.
// is_query_t reports whether t is the runtime's query type.
fn is_query_t(t Ty) i64 {
	return i64(cast(i64, t) != 0 && t.kind == K_STRUCT && t.name != 0 && streq(t.name, cstr("query")) != 0)
}

fn tx_named(pos i64, name i64) i64 {
	let n = cast(TypeExpr, node_new(TX_NAME, pos))
	n.b = cast(i64, cast([]i64, name))
	return cast(i64, n)
}

fn tx_slice_of(pos i64, name i64) i64 {
	let n = cast(TypeExpr, node_new(TX_SLICE, pos))
	n.a = cast(i64, cast([]i64, tx_named(pos, name)))
	return cast(i64, n)
}

fn ident_node(pos i64, name i64) i64 {
	let n = cast(IdentExpr, node_new(EX_IDENT, pos))
	n.name = name
	return cast(i64, n)
}

fn composite_of(tyx Node, elems i64, keys i64) i64 {
	let c = cast(Composite, node_new(EX_COMPOSITE, tyx.pos))
	c.type_ = cast(i64, tyx)
	c.elems = cast([]i64, elems)
	c.keys = cast([]i64, keys)
	return cast(i64, c)
}

// query_arg wraps a checked value in the qarg variant for its type: integers become
// Int(i64(x)), floats Float(f64(x)), then Str, Bool and Bytes ([]u8).
fn query_arg(a Node, t Ty) i64 {
	let pos = a.pos
	mut variant = 0
	mut conv = 0
	if is_integer_t(cast(i64, t)) != 0 {
		variant = cstr("Int")
		if cast(i64, t) != ty_int {
			conv = cstr("i64")
		}
	} else if is_float_t(cast(i64, t)) != 0 {
		variant = cstr("Float")
		if cast(i64, t) != ty_float {
			conv = cstr("f64")
		}
	} else if kind_of(t) == K_STRING {
		variant = cstr("Str")
	} else if kind_of(t) == K_BOOL || kind_of(t) == K_UBOOL {
		variant = cstr("Bool")
	} else if kind_of(t) == K_SLICE && t.elem == ty_byte {
		variant = cstr("Bytes")
	} else {
		err_code_type(pos, cstr("E280 QUERY"), cstr("a query value must be an integer, a float, a str, a bool or []u8, not "), cast(i64, t), cstr(""))
		return 0
	}
	mut v = cast(Call, a)
	if conv != 0 {
		v = cast(Call, node_new(EX_CALL, pos))
		v.name = conv
		v.args = cast([]i64, args1(cast(i64, a)))
	}
	let sel = cast(SelectExpr, node_new(EX_SELECT, pos))
	sel.x = ident_node(pos, cstr("qarg"))
	sel.name = variant
	let call = cast(Call, node_new(EX_CALL, pos))
	call.callee = cast(i64, sel)
	call.args = cast([]i64, args1(cast(i64, v)))
	return cast(i64, call)
}

// chk_query turns a literal where a query is wanted into query{Parts, Args}: "GET user:{id}"
// keeps "GET user:" and "" as text and id as a value, so a value is never parsed as text.
fn chk_query(e i64, want i64) i64 {
	let pos = cast(Node, e).pos
	mut parts = []i64{}
	let args = []i64{}
	mut hidden = 0
	if cast(Node, e).kind == EX_STR {
		let s = cast(StrLit, node_new(EX_STR, pos))
		s.ptr = cast(StrLit, e).ptr
		s.len = cast(StrLit, e).len
		parts = append(parts, cast(i64, s))
	} else {
		parts = cast(InterpExpr, e).parts
		let vals = cast(InterpExpr, e).args
		let specs = cast(InterpExpr, e).specs
		mut i = 0
		for i < len(vals) {
			if specs[i] != 0 {
				err_code_at(pos, cstr("E280 QUERY"), cstr("a query value takes no format spec: it is sent as it is"))
			}
			let a = cast(Node, vals[i])
			mut at = chk(cast(Node, a), 0)
			if is_secret(cast(Ty, at)) != 0 {
				// Sent as itself; a replay key holds its handle instead (query.Hidden, #241).
				hidden = hidden | secret_query_arg(cast(Node, a), at, len(cast([]i64, args)))
				at = cast(i64, plain_type(cast(Ty, at)))
				a.type_ = at
			}
			let qa = query_arg(cast(Node, a), cast(Ty, at))
			if qa != 0 {
				args = append(args, qa)
			}
			i = i + 1
		}
	}
	let nokeys = []i64{}
	mut i = 0
	for i < len(cast([]i64, parts)) {
		nokeys = append(nokeys, 0)
		i = i + 1
	}
	let akeys = []i64{}
	i = 0
	for i < len(cast([]i64, args)) {
		akeys = append(akeys, 0)
		i = i + 1
	}
	let elems = []i64{}
	elems = append(elems, composite_of(cast(Node, tx_slice_of(pos, cstr("str"))), cast(i64, parts), cast(i64, nokeys)))
	elems = append(elems, composite_of(cast(Node, tx_slice_of(pos, cstr("qarg"))), cast(i64, args), cast(i64, akeys)))
	let keys = []i64{}
	keys = append(keys, ident_node(pos, cstr("Parts")))
	keys = append(keys, ident_node(pos, cstr("Args")))
	if hidden != 0 {
		elems = append(elems, mk_int(pos, hidden, ty_u64))
		keys = append(keys, ident_node(pos, cstr("Hidden")))
	}
	let c = composite_of(cast(Node, tx_named(pos, cstr("query"))), cast(i64, elems), cast(i64, keys))
	replace_node(e, c)
	cast(Node, e).type_ = 0
	return chk_kind(e, want)
}

// interp_name_known reports whether a name inside {...} in a string resolves: chk_ident
// would not report it undefined.
fn interp_name_known(name i64) i64 {
	return i64(streq(name, cstr("true")) != 0 || streq(name, cstr("false")) != 0 || cast(i64, lookup_name(name)) != 0 || import_pkg(name) != 0)
}

fn chk_interp(e i64, want i64) i64 {
	let pos = cast(Node, e).pos
	let parts = cast(InterpExpr, e).parts
	let vals = cast(InterpExpr, e).args
	let specs = cast(InterpExpr, e).specs
	let f = buf_new()
	let args = []i64{}
	args = append(args, 0)
	mut i = 0
	for i < len(parts) {
		let part = cast(StrLit, parts[i])
		mut k = 0
		for k < part.len {
			let c = i64(load8(cast(StrLit, part).ptr + k))
			if c == '%' {
				buf_byte(f, '%')
			}
			buf_byte(f, c)
			k = k + 1
		}
		if i < len(vals) {
			let a = vals[i]
			if cast(Node, a).kind == EX_IDENT && interp_name_known(cast(IdentExpr, a).name) == 0 {
				// Often meant as literal text, like a route pattern's {id}.
				let u = err_code(cast(Node, a).pos, cstr("E103 UNDEFINED"))
				buf_str(u, cstr("undefined: "))
				buf_str(u, cast(IdentExpr, a).name)
				buf_str(u, cstr(" (in a string, {{"))
				buf_str(u, cast(IdentExpr, a).name)
				buf_str(u, cstr("}} is a value: write {{{{ for a brace, or use a `raw` string)"))
				err_end(cast([]u8, u))
				replace_node(a, mk_int(cast(Node, a).pos, 0, 0))
			}
			let t = chk(cast(Node, a), 0)
			let spec = specs[i]
			buf_byte(f, '%')
			if spec == 0 {
				buf_byte(f, 'v')
			} else {
				buf_str(f, spec)
				let sl = strlen(spec)
				mut last = 0
				if sl > 0 {
					last = i64(load8(spec + sl - 1))
				}
				if !((last >= 'a' && last <= 'z') || (last >= 'A' && last <= 'Z')) {
					mut dot = 0
					mut q = 0
					for q < sl {
						if i64(load8(spec + q)) == '.' {
							dot = 1
						}
						q = q + 1
					}
					if dot != 0 && is_float_t(t) != 0 {
						buf_byte(f, 'f')
					} else {
						buf_byte(f, 'v')
					}
				}
			}
			args = append(args, a)
		}
		i = i + 1
	}
	let fs = cast(StrLit, node_new(EX_STR, pos))
	fs.len = len(f)
	buf_byte(f, 0)
	fs.ptr = slice_data(f)
	cast([]i64, args)[0] = cast(i64, fs)
	let call = cast(Call, node_new(EX_CALL, pos))
	call.args = cast([]i64, args)
	replace_node(e, cast(i64, call))
	cast(Node, e).type_ = 0
	return secret_interp_result(e, cast([]Node, cast([]i64, args)), want)
}

fn lower_say(e i64, m i64, want i64) i64 {
	let pos = cast(Node, e).pos
	let args = cast(Call, e).args
	mut first = 0
	mut writer = 0
	if streq(m, cstr("To")) != 0 || streq(m, cstr("LineTo")) != 0 {
		writer = arg0(cast(Call, e))
		first = 1
	}
	let printf = i64(streq(m, cstr("Out")) != 0 || streq(m, cstr("Fmt")) != 0 || streq(m, cstr("Fault")) != 0 || streq(m, cstr("To")) != 0)
	let ln = i64(streq(m, cstr("Line")) != 0 || streq(m, cstr("LineTo")) != 0)
	let stmts = []i64{}
	secret_say_args(cast([]Node, args), m)
	if printf != 0 {
		say_hoist(pos, cast([]Node, args), first + 1, cast([]i64, stmts))
	} else {
		say_hoist(pos, cast([]Node, args), first, cast([]i64, stmts))
	}
	if printf != 0 {
		if len(args) <= first {
			err_code_at(pos, cstr("E282 FORMAT"), cstr("missing format"))
			return ty_void
		}
		let f = cast(Node, args[first])
		let ft = chk(cast(Node, f), ty_string)
		if kind_of(cast(Ty, ft)) != K_STRING {
			err_code_at(f.pos, cstr("E282 FORMAT"), cstr("format must be a str"))
		}
		stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, cstr("rt_fmt_begin"), args1(cast(i64, f)), ty_void))))
		first = first + 1
	} else {
		stmts = append(stmts, expr_stmt(cast(Node, rt_call(pos, cstr("rt_fmt_begin_v"), args1(mk_int(pos, ln, ty_int)), ty_void))))
	}
	mut i = first
	for i < len(args) {
		stmts = append(stmts, expr_stmt(say_arg(cast(Node, args[i]), cstr("rt_fmt_"))))
		i = i + 1
	}
	mut tail = 0
	mut t = ty_void
	if writer != 0 {
		let ws = cast(SelectExpr, node_new(EX_SELECT, pos))
		ws.x = writer
		ws.name = cstr("Write")
		tail = node_new(EX_CALL, pos)
		cast(Call, tail).callee = cast(i64, ws)
		cast(Call, tail).args = cast([]i64, args1(rt_call(pos, cstr("rt_fmt_end"), cast(i64, []i64{}), ty_string)))
		chk(cast(Node, tail), 0)
		cast(Node, tail).type_ = ty_void
	} else if streq(m, cstr("Fmt")) != 0 || streq(m, cstr("Str")) != 0 {
		tail = rt_call(pos, cstr("rt_fmt_end"), cast(i64, []i64{}), ty_string)
		t = ty_string
	} else if streq(m, cstr("Fault")) != 0 {
		tail = rt_call(pos, cstr("rt_fmt_err"), cast(i64, []i64{}), ty_error)
		t = ty_error
	} else {
		tail = rt_call(pos, cstr("rt_fmt_out"), cast(i64, []i64{}), ty_void)
	}
	replace_node(e, mk_seq(pos, cast(i64, stmts), tail, t))
	cast(Node, e).type_ = 0
	return t
}

fn arity_error(e i64, want i64) {
	let a = err_code(cast(Node, e).pos, cstr("E210 ARG_COUNT"))
	buf_str(a, cast(Call, e).name)
	buf_str(a, cstr(" expects "))
	buf_int(a, want)
	buf_str(a, cstr(" arguments, got "))
	buf_int(a, len(cast(Call, e).args))
	err_end(cast([]u8, a))
}

// ---- bound(x) !T (#240) ----
//
// bound(x) checks x against the bounded type its destination has (let v str max 100 = try
// bound(x), an assignment or a return): a generated bound$N(x) gives x as that type, or
// fails with fault.LimitExceeded when x is longer than the bound.
fn chk_bound(e i64, want Ty) i64 {
	let pos = cast(Node, e).pos
	mut target = cast(Ty, bound_want)
	bound_want = 0
	if (cast(i64, target) == 0 || target.bound == 0) && cast(i64, want) != 0 && want.bound != 0 {
		target = want
	}
	if len(cast(Call, e).args) != 1 {
		err_code_at(pos, cstr("E252 BOUND_CALL"), cstr("bound takes one value"))
		return ty_error
	}
	if cast(i64, target) == 0 || target.bound == 0 {
		err_code_at(pos, cstr("E252 BOUND_CALL"), cstr("bound needs a bounded destination to check against: write its type (let v str max 100 = try bound(x))"))
		return ty_error
	}
	let plain = target.bound
	let x = arg0(cast(Call, e))
	mut xt = chk(cast(Node, x), plain)
	// q.Body() into a bounded type checks the body's length before copying it: the call
	// becomes q.BodyBound(n), which gives the body or fault.LimitExceeded (#240).
	if kind_of(cast(Ty, plain)) == K_STRING && cast(Node, x).kind == EX_CALL && cast(Call, x).name != 0 && streq(cast(Call, x).name, cstr("anvil.Req.Body")) != 0 {
		let bb = find_fn(cstr("anvil.Req.BodyBound"))
		if cast(i64, bb) != 0 {
			cast(Call, e).name = bb.qname
			cast(Call, e).fn_ = cast(i64, bb)
			cast(Call, e).method = 1
			cast(Call, e).args = cast([]i64, args2(arg0(cast(Call, x)), mk_int(pos, target.max, ty_int)))
			let brts = []i64{}
			brts = append(brts, cast(i64, target))
			brts = append(brts, ty_error)
			cast(Node, e).type_ = tuple_of(cast(i64, brts))
			return cast(Node, e).type_
		}
	}
	if is_untyped(xt) != 0 {
		reconvert(cast(Node, x), plain)
		xt = plain
	}
	if assignable(cast(Ty, xt), cast(Ty, plain)) == 0 {
		err_code_types(pos, cstr("E252 BOUND_CALL"), cstr("bound cannot check "), xt, cstr(" against "), cast(i64, target))
		return ty_error
	}
	let w = cast(Fn, bound_wrapper(pos, target))
	cast(Call, e).name = w.name
	cast(Call, e).fn_ = cast(i64, w)
	let rts = []i64{}
	rts = append(rts, cast(i64, target))
	rts = append(rts, ty_error)
	let rt = tuple_of(cast(i64, rts))
	cast(Node, e).type_ = rt
	return rt
}

// bound_wrapper builds bound$N(x T) (T max n, fault): x itself, or fault.LimitExceeded.
fn bound_wrapper(pos i64, target Ty) i64 {
	lifted_count = lifted_count + 1
	let f = fn_new(pos, cstr("bound"))
	let nb = buf_new()
	buf_str(nb, cstr("bound$"))
	buf_int(nb, lifted_count)
	buf_byte(nb, 0)
	f.qname = slice_data(nb)
	f.name = slice_data(nb)
	f.lifted = 2
	f.file = ck_file
	let plain = target.bound
	f.params = append(f.params, cstr("x"))
	f.ptypes = append(f.ptypes, plain)
	f.rtypes = append(f.rtypes, cast(i64, target))
	f.rtypes = append(f.rtypes, ty_error)
	f.type_ = func_of(f.ptypes, f.rtypes, 0)
	f.locals = cast([]Sym, []i64{})
	f.body = empty_block(pos)
	prog_fns = append(prog_fns, cast(Fn, f))
	let saved_fn = ck_fn
	ck_fn = cast(Fn, f)
	let xs = sym_new(SYM_LOCAL, cstr("x"), pos)
	xs.type_ = plain
	xs.slot = 0
	mut vs5 = cast([]i64, f.locals)
	vs5 = append(vs5, cast(i64, xs))
	f.slots = 1
	let body = cast(Block, f.body).stmts
	let over = cast(IfStmt, node_new(ST_IF, pos))
	let n = mk_hdr(pos, sym_ref_node(pos, xs), 0)
	over.cond = mk_bin(pos, cstr(">"), n, mk_int(pos, target.max, ty_int), ty_bool)
	over.then = empty_block(pos)
	let ob = cast(Block, over.then).stmts
	let fx = rt_call(pos, cstr("rt_fault_over"), args2(mk_hdr(pos, sym_ref_node(pos, xs), 0), mk_int(pos, target.max, ty_int)), ty_error)
	ob = append(ob, fault_return(pos, cast([]i64, ob), fx))
	body = append(body, cast(i64, over))
	let ret = cast(ReturnStmt, node_new(ST_RETURN, pos))
	let v = cast(Node, sym_ref_node(pos, xs))
	v.type_ = cast(i64, target)
	ret.values = cast([]i64, args2(cast(i64, v), mk_int(pos, 0, ty_error)))
	body = append(body, cast(i64, ret))
	ck_fn = saved_fn
	return cast(i64, f)
}
