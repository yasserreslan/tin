// Expression checking and lowering. chk(e, want) types e and rewrites it in place into
// core nodes; want is the type the context expects (it settles untyped constants and
// elided composite types). A node is checked once: N_TYPE marks it done.
//
// Strict rules for package code: operands must have identical types (constants adapt
// and must fit), conditions are bool, references are never nil (?T may be), faults must
// be handled, and every slice/string index is bounds-checked unless proven safe.
// Legacy fn code keeps its untyped word semantics.

fn chk(e, want) {
    if e[N_TYPE] {
        return e[N_TYPE];
    }
    let t = chk_kind(e, want);
    if !t {
        t = ty_int;
    }
    e[N_TYPE] = t;
    return t;
}

fn chk_kind(e, want) {
    let k = e[N_KIND];
    if k == EX_INT {
        if ck_legacy {
            return ty_int;
        }
        return adapt_int(e, want);
    }
    if k == EX_FLOAT {
        if is_f32(want) {
            // An f32 constant: fold the rounding into the bits.
            e[FL_BITS] = round_f32_bits(e[FL_BITS]);
            return ty_f32;
        }
        return ty_float;
    }
    if k == EX_STR {
        if ck_legacy {
            return ty_int;
        }
        if is_query_t(want) {
            return chk_query(e, want);
        }
        return ty_string;
    }
    if k == EX_NIL {
        e[N_KIND] = EX_INT;
        e[INT_VAL] = 0;
        if nilable(want) {
            return want;
        }
        if !ck_legacy {
            err_at(e[N_POS], "nil needs an optional (?T) or fault type");
        }
        return ty_nil;
    }
    if k == EX_IDENT {
        return chk_ident(e, want);
    }
    if k == EX_UNARY {
        if !ck_legacy && fold_const(e) {
            return adapt_int(e, want);
        }
        return chk_unary(e, want);
    }
    if k == EX_BINARY {
        if !ck_legacy && fold_const(e) {
            return adapt_int(e, want);
        }
        if !ck_legacy && fold_compare(e) {
            return ty_bool;
        }
        return chk_binary(e, want);
    }
    if k == EX_CALL {
        return chk_call(e, want);
    }
    if k == EX_INDEX {
        return chk_index(e);
    }
    if k == EX_SLICE {
        return chk_slice(e);
    }
    if k == EX_SELECT {
        return chk_select(e, want);
    }
    if k == EX_COMPOSITE {
        return chk_composite(e, want);
    }
    if k == EX_FUNCLIT {
        return chk_funclit(e);
    }
    if k == EX_TYPE {
        err_at(e[N_POS], "type used as a value");
        return ty_int;
    }
    if k == EX_TRY {
        err_at(e[N_POS], "try is only allowed as a statement, an initializer, an assignment or a return");
        return ty_int;
    }
    if k == EX_CATCH {
        err_at(e[N_POS], "catch is only allowed on a whole statement, initializer, assignment or return value");
        return ty_int;
    }
    if k == EX_INTERP {
        if is_query_t(want) {
            return chk_query(e, want);
        }
        return chk_interp(e, want);
    }
    if k == EX_MUTARG {
        err_at(e[N_POS], "mut here does nothing: only an argument for a mut parameter takes mut");
        return chk(e[MUTARG_X], want);
    }
    err_at(e[N_POS], "unexpected expression");
    return ty_int;
}

// int_fits reports whether constant v is representable in integer type t.
fn int_fits(v, t, big) {
    let w = t[TY_WIDTH];
    if w == 8 {
        return t[TY_SIGNED] || v >= 0 || big;
    }
    if big {
        return 0;
    }
    let bits = 8 * w;
    if t[TY_SIGNED] {
        let lim = 1 << (bits - 1);
        return v >= -lim && v < lim;
    }
    return v >= 0 && v < (1 << bits);
}

// fold_compare turns a comparison of two integer constants into a bool (unsigned when
// either is above 2^63-1).
fn fold_compare(e) {
    let op = e[BIN_OP];
    if !(streq(op, "<") || streq(op, "<=") || streq(op, ">") || streq(op, ">=") || streq(op, "==") || streq(op, "!=")) {
        return 0;
    }
    let l = e[BIN_L];
    let r = e[BIN_R];
    if !fold_const(l) || !fold_const(r) || l[N_KIND] != EX_INT || r[N_KIND] != EX_INT || l[7] || r[7] {
        return 0;
    }
    let a = l[INT_VAL];
    let b = r[INT_VAL];
    if l[8] || r[8] {
        a = a ^ (1 << 63);
        b = b ^ (1 << 63);
    }
    replace_node(e, mk_int(e[N_POS], eval_binary(op, a, b), ty_bool));
    return 1;
}

// fold_const evaluates an expression made only of integer literals, turning e into one literal.
fn fold_const(e) {
    let k = e[N_KIND];
    if k == EX_INT {
        return 1;
    }
    if k == EX_IDENT {
        // An untyped integer constant folds like the literal it stands for.
        let s = lookup_name(e[ID_NAME]);
        if !s || s[S_KIND] != SYM_CONST || !s[S_DONE] || s[S_EXPR] || kind_of(s[S_TYPE]) != K_UINT {
            return 0;
        }
        let big = s[S_BIG];
        replace_node(e, mk_int(e[N_POS], s[S_VAL], 0));
        e[8] = big;
        return 1;
    }
    let v = 0;
    if k == EX_UNARY {
        let op = e[UN_OP];
        let x = e[UN_X];
        if !(streq(op, "-") || streq(op, "^") || streq(op, "+")) || !fold_const(x) {
            return 0;
        }
        v = x[INT_VAL];
        if streq(op, "-") {
            v = 0 - v;
        } else if streq(op, "^") {
            v = ~v;
        }
    } else if k == EX_BINARY {
        let op = e[BIN_OP];
        let l = e[BIN_L];
        let r = e[BIN_R];
        if !fold_const(l) || !fold_const(r) {
            return 0;
        }
        let a = l[INT_VAL];
        let b = r[INT_VAL];
        let ub = l[8] || r[8];
        if ub && (streq(op, ">>") || streq(op, "/") || streq(op, "%")) {
            if (streq(op, "/") || streq(op, "%")) && b == 0 {
                return 0;
            }
            v = eval_unsigned(op, a, b);
            e[N_KIND] = EX_INT;
            e[INT_VAL] = v;
            e[3] = 0;
            e[4] = 0;
            e[7] = 0;
            e[8] = v < 0;
            return 1;
        }
        if streq(op, "+") {
            v = a + b;
        } else if streq(op, "-") {
            v = a - b;
        } else if streq(op, "*") {
            v = a * b;
        } else if (streq(op, "/") || streq(op, "%")) && b != 0 {
            if streq(op, "/") {
                v = a / b;
            } else {
                v = a % b;
            }
        } else if streq(op, "&") {
            v = a & b;
        } else if streq(op, "|") {
            v = a | b;
        } else if streq(op, "^") {
            v = a ^ b;
        } else if streq(op, "<<") && b >= 0 && b < 64 {
            v = a << b;
        } else if streq(op, ">>") && b >= 0 && b < 64 {
            v = a >> b;
        } else {
            return 0;
        }
    } else {
        return 0;
    }
    let big = 0;
    if k == EX_BINARY {
        big = (e[BIN_L][8] || e[BIN_R][8]) && v < 0;
    }
    e[N_KIND] = EX_INT;
    e[INT_VAL] = v;
    e[3] = 0;
    e[4] = 0;
    e[7] = 0;
    e[8] = big;
    return 1;
}

// adapt_int gives an integer literal the expected type, checking that it fits.
fn adapt_int(e, want) {
    if !want {
        want = ty_int;
    }
    if is_float_t(want) {
        e[N_KIND] = EX_FLOAT;
        e[FL_BITS] = int_to_float_bits(e[INT_VAL]);
        if is_f32(want) {
            e[FL_BITS] = round_f32_bits(e[FL_BITS]);
            return ty_f32;
        }
        return ty_float;
    }
    if kind_of(want) == K_INT {
        if !int_fits(e[INT_VAL], want, e[8]) {
            let m = err_begin(e[N_POS]);
            buf_str(m, "constant ");
            buf_int(m, e[INT_VAL]);
            buf_str(m, " overflows ");
            type_name(m, want);
            err_end(m);
        }
        return want;
    }
    return ty_uint;
}

fn chk_ident(e, want) {
    let name = e[ID_NAME];
    if streq(name, "true") || streq(name, "false") {
        replace_node(e, mk_int(e[N_POS], streq(name, "true"), 0));
        return ty_bool;
    }
    let s = lookup_name(name);
    if !s {
        if import_pkg(name) {
            err_quoted(e[N_POS], "use of package ", name, " without a selector");
        } else {
            let u = err_begin(e[N_POS]);
            buf_str(u, "undefined: ");
            buf_str(u, name);
            err_end(u);
        }
        return ty_int;
    }
    return use_sym(e, s, want);
}

// runtime_use rejects user code naming a function only the standard library may use: a C
// extern or one of the runtime's own (the trusted files outside any package).
fn runtime_use(pos, f, name) {
    if ck_legacy || ck_trusted || streq(name, "rt_pool_used") {
        return;
    }
    if f[F_EXTERN] || (vec_get(file_trusted, f[F_FILE]) && load8(vec_get(file_pkgs, f[F_FILE])) == 0) {
        err_quoted(pos, "", name, " is internal to the runtime");
    }
}

// use_sym turns a resolved name into a variable read, a constant or a function value.
fn use_sym(e, s, want) {
    let k = s[S_KIND];
    if k == SYM_FUNC {
        if ck_legacy || s[S_FN][F_LEGACY] {
            err_quoted(e[N_POS], "function ", e[ID_NAME], " used as a value");
            return ty_int;
        }
        let f = s[S_FN];
        runtime_use(e[N_POS], f, e[ID_NAME]);
        e[N_KIND] = EX_FUNCREF;
        e[FR_FN] = f;
        return f[F_TYPE];
    }
    if k == SYM_CONST {
        if !s[S_DONE] {
            err_quoted(e[N_POS], "constant ", e[ID_NAME], " used before its definition");
            return ty_int;
        }
        if s[S_EXPR] {
            replace_node(e, expr_clone(s[S_EXPR]));
            return s[S_TYPE];
        }
        let v = s[S_VAL];
        let t = s[S_TYPE];
        replace_node(e, mk_int(e[N_POS], v, 0));
        e[ID_REF] = s;
        e[8] = s[S_BIG];
        if kind_of(t) == K_UINT {
            return chk_kind(e, want);
        }
        if is_float_t(t) {
            e[N_KIND] = EX_FLOAT;
            e[FL_BITS] = int_to_float_bits(v);
        }
        return t;
    }
    if s[S_CAPTURED] {
        let env_ref = sym_ref_node(e[N_POS], ck_fn[F_ENV_SYM]);
        let cell_addr = mk_mem(e[N_POS], env_ref, 0, 0, 8 * (2 + s[S_CAP_IDX]), ty_int);
        let val = mk_mem(e[N_POS], cell_addr, 0, 0, 0, s[S_TYPE]);
        replace_node(e, val);
        return s[S_TYPE];
    }
    if s[S_CELL] {
        let cell_ref = sym_ref_node(e[N_POS], s[S_CELL_SYM]);
        let val = mk_mem(e[N_POS], cell_ref, 0, 0, 0, s[S_TYPE]);
        replace_node(e, val);
        return s[S_TYPE];
    }
    e[ID_REF] = s;
    s[S_READS] = s[S_READS] + 1;
    if !s[S_TYPE] {
        return ty_int;
    }
    return s[S_TYPE];
}

fn chk_unary(e, want) {
    let op = e[UN_OP];
    let x = e[UN_X];
    if streq(op, "&") {
        if x[N_KIND] == EX_COMPOSITE {
            let ct = chk(x, want);
            replace_node(e, x);
            return ct;
        }
        if x[N_KIND] != EX_IDENT {
            err_at(e[N_POS], "'&' needs a variable name");
            chk(x, 0);
            return ty_int;
        }
        let xname = x[ID_NAME];
        let xt = chk(x, 0);
        if x[ID_REF] && x[ID_REF][S_CAPTURED] {
            let s = x[ID_REF];
            let env_ref = sym_ref_node(e[N_POS], ck_fn[F_ENV_SYM]);
            let cell_addr = mk_mem(e[N_POS], env_ref, 0, 0, 8 * (2 + s[S_CAP_IDX]), ty_int);
            replace_node(e, cell_addr);
            return ty_int;
        }
        if x[ID_REF] && x[ID_REF][S_CELL] {
            let s = x[ID_REF];
            replace_node(e, sym_ref_node(e[N_POS], s[S_CELL_SYM]));
            return ty_int;
        }
        if x[N_KIND] != EX_IDENT || !x[ID_REF] {
            err_quoted(e[N_POS], "cannot take the address of constant ", xname, "");
            return ty_int;
        }
        if kind_of(xt) == K_STRUCT {
            replace_node(e, x);
            return xt;
        }
        if !ck_legacy && !ck_trusted {
            err_at(e[N_POS], "'&' on a variable is only allowed in the standard library");
        }
        return ty_int;
    }
    if streq(op, "...") {
        err_at(e[N_POS], "... is only allowed on the last argument of a call");
        return ty_int;
    }
    let t = chk(x, want);
    if streq(op, "!") {
        if ck_legacy {
            return ty_int;
        }
        if !is_bool_t(t) {
            err_type(e[N_POS], "operator ! needs a bool, not ", t, "");
        }
        return ty_bool;
    }
    if streq(op, "-") {
        if !is_numeric_t(t) && !ck_legacy {
            err_type(e[N_POS], "operator - needs a number, not ", t, "");
        }
        if x[N_KIND] == EX_FLOAT {
            replace_node(e, x);
            e[FL_BITS] = e[FL_BITS] ^ (1 << 63);
            e[N_TYPE] = 0;
            return ty_float;
        }
        if x[N_KIND] == EX_INT && (kind_of(t) == K_UINT || ck_legacy) {
            replace_node(e, mk_int(e[N_POS], -x[INT_VAL], 0));
            return t;
        }
        return t;
    }
    if !is_integer_t(t) && !ck_legacy {
        err_type(e[N_POS], "operator ^ needs an integer, not ", t, "");
    }
    if x[N_KIND] == EX_INT && kind_of(t) == K_UINT {
        replace_node(e, mk_int(e[N_POS], ~x[INT_VAL], 0));
        return ty_uint;
    }
    return t;
}

fn is_cmp_op(op) {
    return streq(op, "==") || streq(op, "!=") || streq(op, "<") || streq(op, "<=") || streq(op, ">") || streq(op, ">=");
}

fn is_untyped_lit(e) {
    let k = e[N_KIND];
    return k == EX_INT || k == EX_NIL || k == EX_FLOAT || (k == EX_UNARY && is_untyped_lit(e[UN_X])) || (k == EX_BINARY && is_untyped_lit(e[BIN_L]) && is_untyped_lit(e[BIN_R]));
}

// unify checks both operands of a binary operator and returns their common type:
// identical types, or an untyped constant adapted to the other side.
fn unify(l, r, want) {
    let lt = 0;
    let rt = 0;
    if !is_untyped_lit(l) || is_untyped_lit(r) {
        lt = chk(l, want);
        rt = chk(r, default_or(lt, want));
    } else {
        rt = chk(r, want);
        lt = chk(l, default_or(rt, want));
    }
    if kind_of(lt) == K_UINT && !is_untyped(rt) {
        lt = reconvert(l, rt);
    } else if kind_of(rt) == K_UINT && !is_untyped(lt) {
        rt = reconvert(r, lt);
    }
    if kind_of(lt) == K_NIL && nilable(rt) {
        reconvert(l, rt);
        return rt;
    }
    if kind_of(rt) == K_NIL && nilable(lt) {
        reconvert(r, lt);
        return lt;
    }
    if kind_of(lt) == K_UINT && kind_of(rt) == K_UINT {
        return ty_uint;
    }
    if lt != rt && !ck_legacy {
        err_types(l[N_POS], "mismatched types ", lt, " and ", rt);
    }
    return lt;
}

fn default_or(t, want) {
    if is_untyped(t) {
        return want;
    }
    return t;
}

// reconvert gives an untyped constant node the concrete type to.
fn reconvert(e, to) {
    let k = kind_of(e[N_TYPE]);
    if k == K_UINT {
        if e[N_KIND] == EX_INT {
            e[N_TYPE] = 0;
            let t = adapt_int(e, to);
            e[N_TYPE] = t;
            return t;
        }
        retype_untyped(e, to);
        return to;
    }
    if k == K_NIL && nilable(to) {
        e[N_TYPE] = to;
        return to;
    }
    return e[N_TYPE];
}

fn retype_untyped(e, to) {
    if kind_of(e[N_TYPE]) != K_UINT {
        return;
    }
    e[N_TYPE] = to;
    let k = e[N_KIND];
    if k == EX_UNARY {
        retype_untyped(e[UN_X], to);
    } else if k == EX_BINARY && !is_cmp_op(e[BIN_OP]) {
        retype_untyped(e[BIN_L], to);
        retype_untyped(e[BIN_R], to);
    }
}

fn chk_binary(e, want) {
    let op = e[BIN_OP];
    let l = e[BIN_L];
    let r = e[BIN_R];
    let pos = e[N_POS];
    if streq(op, "&&") || streq(op, "||") {
        let a = chk(l, ty_bool);
        // x != nil && x.f: the right side sees x narrowed.
        let narrowed = 0;
        if streq(op, "&&") {
            narrowed = narrow_begin(l, 1);
        }
        let b = chk(r, ty_bool);
        narrow_end(narrowed);
        if ck_legacy {
            return ty_int;
        }
        if !is_bool_t(a) || !is_bool_t(b) {
            err_at(pos, "operands of && and || must be bool");
        }
        return ty_bool;
    }
    if streq(op, "<<") || streq(op, ">>") {
        let st = chk(l, want);
        let ct = chk(r, ty_int);
        if !is_integer_t(st) && !ck_legacy {
            err_type(pos, "cannot shift ", st, "");
        }
        if !is_integer_t(ct) && !ck_legacy {
            err_type(pos, "shift count must be an integer, not ", ct, "");
        }
        if kind_of(ct) == K_UINT {
            reconvert(r, ty_int);
        }
        if l[N_KIND] == EX_INT && r[N_KIND] == EX_INT && kind_of(st) == K_UINT {
            replace_node(e, mk_int(pos, eval_binary(op, l[INT_VAL], r[INT_VAL]), 0));
            return ty_uint;
        }
        return st;
    }
    let t = unify(l, r, want);
    if is_cmp_op(op) && kind_of(t) == K_DYN {
        err_at(pos, "cannot compare dyn values: use a method on the shape (?dyn compares against nil)");
        return ty_bool;
    }
    if is_cmp_op(op) {
        let ordered = !streq(op, "==") && !streq(op, "!=");
        if !ordered && kind_of(t) == K_STRUCT && t[TY_ENUM] && !ck_legacy {
            return lower_enum_eq(e, op, l, r, t);
        }
        if kind_of(t) == K_STRING {
            lower_str_cmp(e, op, l, r);
            if ck_legacy {
                return ty_int;
            }
            return ty_bool;
        }
        if l[N_KIND] == EX_INT && r[N_KIND] == EX_INT && kind_of(t) == K_UINT {
            replace_node(e, mk_int(pos, eval_binary(op, l[INT_VAL], r[INT_VAL]), 0));
            if ck_legacy {
                return ty_int;
            }
            return ty_bool;
        }
        if ck_legacy {
            return ty_int;
        }
        if ordered && !is_numeric_t(t) {
            err_type(pos, "cannot order values of type ", t, "");
        }
        if kind_of(t) == K_UINT {
            reconvert(l, ty_int);
            reconvert(r, ty_int);
        }
        return ty_bool;
    }
    let k = kind_of(t);
    if k == K_STRING {
        if !streq(op, "+") {
            err_quoted(pos, "operator ", op, " is not defined on str");
        }
        replace_node(e, rt_call(pos, "rt_str_cat", args2(l, r), ty_string));
        e[N_TYPE] = 0;
        return ty_string;
    }
    if ck_legacy {
        return ty_int;
    }
    if !is_numeric_t(t) {
        err_type(pos, "arithmetic on ", t, "");
    }
    if is_float_t(t) && (streq(op, "%") || streq(op, "&") || streq(op, "|") || streq(op, "^")) {
        err_quoted(pos, "operator ", op, " is not defined on floats");
    }
    if k == K_UINT && l[N_KIND] == EX_INT && r[N_KIND] == EX_INT {
        if (streq(op, "/") || streq(op, "%")) && r[INT_VAL] == 0 {
            err_at(pos, "division by zero");
            return ty_uint;
        }
        replace_node(e, mk_int(pos, eval_binary(op, l[INT_VAL], r[INT_VAL]), 0));
        return ty_uint;
    }
    if k == K_INT && is_const_zero(r) && (streq(op, "/") || streq(op, "%")) {
        err_at(pos, "division by zero");
    }
    if is_f32(t) {
        // f32 arithmetic is f64 arithmetic rounded to f32 after each step (exact for + - * /).
        let inner = node_copy(e);
        inner[N_TYPE] = t;
        replace_node(e, mk_conv(pos, inner, CV_ROUND32, t));
    }
    return t;
}

// enum_incomparable returns a payload type of enum t without value equality (slices, maps,
// structs, funcs, optionals), or 0 when every variant compares by value.
fn enum_incomparable(t) {
    let fs = t[TY_FIELDS];
    let i = 1;
    while i < fs[VEC_LEN] {
        let ft = field_type(t, i);
        let k = kind_of(ft);
        if k == K_STRUCT && ft[TY_ENUM] {
            if ft != t {
                let inner = enum_incomparable(ft);
                if inner {
                    return inner;
                }
            }
        } else if !(is_integer_t(ft) || is_float_t(ft) || k == K_BOOL || k == K_STRING || k == K_ERROR) {
            return ft;
        }
        i = i + 1;
    }
    return 0;
}

var enum_eq_types;
var enum_eq_fns;

// lower_enum_eq compares two enum values by value (same variant, equal fields) through a
// generated eq function per enum, so recursive enums compare without expanding forever.
fn lower_enum_eq(e, op, l, r, t) {
    let pos = e[N_POS];
    let bad = enum_incomparable(t);
    if bad {
        let u = err_begin(pos);
        buf_str(u, "cannot compare ");
        type_name(u, t);
        buf_str(u, " values: a variant holds ");
        type_name(u, bad);
        buf_str(u, ", which has no value equality");
        err_end(u);
        return ty_bool;
    }
    let x = call_fn(pos, enum_eq_fn(t), args2(l, r), ty_bool);
    if streq(op, "!=") {
        let n = node_new(EX_UNARY, pos);
        n[UN_OP] = "!";
        n[UN_X] = x;
        n[N_TYPE] = ty_bool;
        x = n;
    }
    replace_node(e, x);
    return ty_bool;
}

fn enum_eq_fn(t) {
    if !enum_eq_types {
        enum_eq_types = vec_new();
        enum_eq_fns = vec_new();
    }
    let i = 0;
    while i < enum_eq_types[VEC_LEN] {
        if vec_get(enum_eq_types, i) == t {
            return vec_get(enum_eq_fns, i);
        }
        i = i + 1;
    }
    let names = vec_new();
    vec_push(names, "a");
    vec_push(names, "b");
    let types = vec_new();
    vec_push(types, t);
    vec_push(types, t);
    let rts = vec_new();
    vec_push(rts, ty_bool);
    let f = lifted_fn("eq", names, types, rts);
    vec_push(enum_eq_types, t);
    vec_push(enum_eq_fns, f);
    let saved_fn = ck_fn;
    let saved_legacy = ck_legacy;
    ck_fn = f;
    ck_legacy = 0;
    let pos = 0;
    let ls = vec_get(f[F_LOCALS], 0);
    let rs = vec_get(f[F_LOCALS], 1);
    let tag0 = field_offset(t, 0);
    let x = mk_bin(pos, "==", mk_mem(pos, sym_ref_node(pos, ls), 0, 0, tag0, ty_int), mk_mem(pos, sym_ref_node(pos, rs), 0, 0, tag0, ty_int), ty_bool);
    let vs = t[TY_ENUM];
    let vi = 0;
    while vi < vs[VEC_LEN] {
        let v = vec_get(vs, vi);
        let fe = 0;
        let k = 0;
        while k < vec_get(v, 2) {
            let fi = vec_get(v, 1) + k;
            let ft = field_type(t, fi);
            let a = mk_mem(pos, sym_ref_node(pos, ls), 0, 0, field_offset(t, fi), ft);
            let b = mk_mem(pos, sym_ref_node(pos, rs), 0, 0, field_offset(t, fi), ft);
            let c = binary_new(pos, "==", a, b);
            chk(c, ty_bool);
            if fe {
                fe = mk_bin(pos, "&&", fe, c, ty_bool);
            } else {
                fe = c;
            }
            k = k + 1;
        }
        if fe {
            let other = mk_bin(pos, "!=", mk_mem(pos, sym_ref_node(pos, ls), 0, 0, tag0, ty_int), mk_int(pos, vi, ty_int), ty_bool);
            x = mk_bin(pos, "&&", x, mk_bin(pos, "||", other, fe, ty_bool), ty_bool);
        }
        vi = vi + 1;
    }
    let ret = node_new(ST_RETURN, pos);
    ret[RET_VALUE] = x;
    vec_push(f[F_BODY][BLK_STMTS], ret);
    ck_fn = saved_fn;
    ck_legacy = saved_legacy;
    return f;
}

// elem_bits is value v as the bits a slice element of type et holds (4 bytes for f32).
fn elem_bits(v, et) {
    if is_f32(et) {
        return mk_conv(v[N_POS], v, CV_F2BITS32, ty_int);
    }
    return to_bits(v);
}

fn is_const_zero(e) {
    return e[N_KIND] == EX_INT && e[INT_VAL] == 0;
}

fn lower_str_cmp(e, op, l, r) {
    let pos = e[N_POS];
    if streq(op, "==") || streq(op, "!=") {
        let eq = rt_call(pos, "rt_str_eq", args2(l, r), ty_bool);
        if streq(op, "!=") {
            let n = node_new(EX_UNARY, pos);
            n[UN_OP] = "!";
            n[UN_X] = eq;
            n[N_TYPE] = ty_bool;
            eq = n;
        }
        replace_node(e, eq);
        e[N_TYPE] = 0;
        return;
    }
    replace_node(e, mk_bin(pos, op, rt_call(pos, "rt_str_cmp", args2(l, r), ty_int), mk_int(pos, 0, ty_int), 0));
}

// ---- memory access ----

// mk_mem is a load or store of type t at base + index*scale + off.
fn mk_mem(pos, base, index, scale, off, t) {
    let n = node_new(EX_MEM, pos);
    n[MEM_BASE] = base;
    n[MEM_INDEX] = index;
    n[MEM_SCALE] = scale;
    n[MEM_OFF] = off;
    n[N_TYPE] = t;
    return n;
}

// ---- map keys: struct and enum keys are encoded to bytes, so they compare by value ----

fn key_composite(t) {
    return kind_of(t) == K_STRUCT;
}

// map_str_keys reports whether a map with key type kt keeps str keys inside.
fn map_str_keys(kt) {
    return kind_of(kt) == K_STRING || key_composite(kt);
}

// key_in is key e as the word the runtime stores (bits, a str, or an encoded struct/enum).
fn key_in(e, kt) {
    if !key_composite(kt) {
        return to_bits(e);
    }
    let pos = e[N_POS];
    let stmts = vec_new();
    let b = temp(pos, rt_call(pos, "rt_kb_new", vec_new(), ty_int), ty_int);
    vec_push(stmts, b);
    vec_push(stmts, assign_stmt(pos, sym_ref_node(pos, b[LET_SYM]), call_fn(pos, key_enc_fn(kt), args2(sym_ref_node(pos, b[LET_SYM]), e), ty_int)));
    return mk_seq(pos, stmts, rt_call(pos, "rt_kb_done", args1(sym_ref_node(pos, b[LET_SYM])), ty_string), ty_string);
}

// key_out turns a stored key word back into a key of type kt.
fn key_out(e, kt) {
    if !key_composite(kt) {
        return from_bits(e, kt);
    }
    let pos = e[N_POS];
    let stmts = vec_new();
    vec_push(stmts, expr_stmt(rt_call(pos, "rt_kd_begin", vec_new(), ty_void)));
    return mk_seq(pos, stmts, call_fn(pos, key_dec_fn(kt), args1(mk_conv(pos, e, CV_SAME, ty_string)), kt), kt);
}

// map_set_call stores v under key k in map m.
fn map_set_call(pos, m, k, v, kt) {
    if key_composite(kt) {
        return rt_call(pos, "rt_map_setk", args3(m, key_in(k, kt), to_bits(v)), ty_void);
    }
    return rt_call(pos, "rt_map_set", args3(m, to_bits(k), to_bits(v)), ty_void);
}

// key_valid reports whether t can be a map key: str, numbers, bool, or structs and enums
// made of those (compared by value).
fn key_valid(t, path) {
    let k = kind_of(t);
    if k == K_STRING || k == K_BOOL || is_integer_t(t) || is_float_t(t) {
        return 1;
    }
    if k != K_STRUCT {
        return 0;
    }
    let i = 0;
    while i < path[VEC_LEN] {
        if vec_get(path, i) == t {
            return t[TY_ENUM] != 0;
        }
        i = i + 1;
    }
    vec_push(path, t);
    let ok = 1;
    let fi = 0;
    while fi < t[TY_FIELDS][VEC_LEN] && ok {
        ok = key_valid(field_type(t, fi), path);
        fi = fi + 1;
    }
    path[VEC_LEN] = path[VEC_LEN] - 1;
    return ok;
}

var key_enc_types;
var key_enc_fns;
var key_dec_types;
var key_dec_fns;

// key_enc_fn returns keyenc$N(b, x) b: x's bytes appended to byte slice b.
fn key_enc_fn(t) {
    if !key_enc_types {
        key_enc_types = vec_new();
        key_enc_fns = vec_new();
    }
    let i = 0;
    while i < key_enc_types[VEC_LEN] {
        if vec_get(key_enc_types, i) == t {
            return vec_get(key_enc_fns, i);
        }
        i = i + 1;
    }
    let names = vec_new();
    vec_push(names, "b");
    vec_push(names, "x");
    let types = vec_new();
    vec_push(types, ty_int);
    vec_push(types, t);
    let rts = vec_new();
    vec_push(rts, ty_int);
    let f = lifted_fn("keyenc", names, types, rts);
    vec_push(key_enc_types, t);
    vec_push(key_enc_fns, f);
    let saved_fn = ck_fn;
    ck_fn = f;
    let pos = 0;
    let b = vec_get(f[F_LOCALS], 0);
    let x = vec_get(f[F_LOCALS], 1);
    let body = f[F_BODY][BLK_STMTS];
    if t[TY_ENUM] {
        key_enc_field(pos, body, b, x, t, 0);
        let vs = t[TY_ENUM];
        let vi = 0;
        while vi < vs[VEC_LEN] {
            let v = vec_get(vs, vi);
            let ifs = node_new(ST_IF, pos);
            ifs[IF_COND] = mk_bin(pos, "==", mk_mem(pos, sym_ref_node(pos, x), 0, 0, field_offset(t, 0), ty_int), mk_int(pos, vi, ty_int), ty_bool);
            ifs[IF_THEN] = empty_block(pos);
            let k = 0;
            while k < vec_get(v, 2) {
                key_enc_field(pos, ifs[IF_THEN][BLK_STMTS], b, x, t, vec_get(v, 1) + k);
                k = k + 1;
            }
            vec_push(body, ifs);
            vi = vi + 1;
        }
    } else {
        let fi = 0;
        while fi < t[TY_FIELDS][VEC_LEN] {
            key_enc_field(pos, body, b, x, t, fi);
            fi = fi + 1;
        }
    }
    let ret = node_new(ST_RETURN, pos);
    ret[RET_VALUE] = sym_ref_node(pos, b);
    vec_push(body, ret);
    ck_fn = saved_fn;
    return f;
}

// key_enc_field appends `b = <field fi of x, encoded>` to body.
fn key_enc_field(pos, body, b, x, t, fi) {
    let ft = field_type(t, fi);
    let fv = mk_mem(pos, sym_ref_node(pos, x), 0, 0, field_offset(t, fi), ft);
    let k = kind_of(ft);
    let nb = 0;
    if k == K_BOOL {
        nb = rt_call(pos, "rt_kb_word", args2(sym_ref_node(pos, b), mk_conv(pos, fv, CV_SAME, ty_int)), ty_int);
    } else if k == K_STRING {
        nb = rt_call(pos, "rt_kb_str", args2(sym_ref_node(pos, b), fv), ty_int);
    } else if is_float_t(ft) {
        nb = rt_call(pos, "rt_kb_word", args2(sym_ref_node(pos, b), mk_conv(pos, fv, CV_F2BITS, ty_int)), ty_int);
    } else if k == K_STRUCT {
        nb = call_fn(pos, key_enc_fn(ft), args2(sym_ref_node(pos, b), fv), ty_int);
    } else {
        nb = rt_call(pos, "rt_kb_word", args2(sym_ref_node(pos, b), mk_conv(pos, fv, CV_INT, ty_int)), ty_int);
    }
    vec_push(body, assign_stmt(pos, sym_ref_node(pos, b), nb));
}

// key_dec_fn returns keydec$N(s) T: the key encoded in s, read from rt_kd's offset.
fn key_dec_fn(t) {
    if !key_dec_types {
        key_dec_types = vec_new();
        key_dec_fns = vec_new();
    }
    let i = 0;
    while i < key_dec_types[VEC_LEN] {
        if vec_get(key_dec_types, i) == t {
            return vec_get(key_dec_fns, i);
        }
        i = i + 1;
    }
    let names = vec_new();
    vec_push(names, "s");
    let types = vec_new();
    vec_push(types, ty_string);
    let rts = vec_new();
    vec_push(rts, t);
    let f = lifted_fn("keydec", names, types, rts);
    vec_push(key_dec_types, t);
    vec_push(key_dec_fns, f);
    let saved_fn = ck_fn;
    ck_fn = f;
    let pos = 0;
    let s = vec_get(f[F_LOCALS], 0);
    let body = f[F_BODY][BLK_STMTS];
    let obj = temp(pos, rt_call(pos, "rt_alloc", args1(mk_int(pos, t[TY_SIZE], ty_int)), t), t);
    vec_push(body, obj);
    if t[TY_ENUM] {
        key_dec_field(pos, body, s, obj[LET_SYM], t, 0);
        let vs = t[TY_ENUM];
        let vi = 0;
        while vi < vs[VEC_LEN] {
            let v = vec_get(vs, vi);
            let ifs = node_new(ST_IF, pos);
            ifs[IF_COND] = mk_bin(pos, "==", mk_mem(pos, sym_ref_node(pos, obj[LET_SYM]), 0, 0, field_offset(t, 0), ty_int), mk_int(pos, vi, ty_int), ty_bool);
            ifs[IF_THEN] = empty_block(pos);
            let k = 0;
            while k < vec_get(v, 2) {
                key_dec_field(pos, ifs[IF_THEN][BLK_STMTS], s, obj[LET_SYM], t, vec_get(v, 1) + k);
                k = k + 1;
            }
            vec_push(body, ifs);
            vi = vi + 1;
        }
    } else {
        let fi = 0;
        while fi < t[TY_FIELDS][VEC_LEN] {
            key_dec_field(pos, body, s, obj[LET_SYM], t, fi);
            fi = fi + 1;
        }
    }
    let ret = node_new(ST_RETURN, pos);
    ret[RET_VALUE] = sym_ref_node(pos, obj[LET_SYM]);
    vec_push(body, ret);
    ck_fn = saved_fn;
    return f;
}

fn key_dec_field(pos, body, s, obj, t, fi) {
    let ft = field_type(t, fi);
    let k = kind_of(ft);
    let v = 0;
    if k == K_BOOL {
        v = mk_conv(pos, rt_call(pos, "rt_kd_word", args1(sym_ref_node(pos, s)), ty_int), CV_SAME, ft);
    } else if k == K_STRING {
        v = rt_call(pos, "rt_kd_str", args1(sym_ref_node(pos, s)), ty_string);
    } else if is_float_t(ft) {
        v = mk_conv(pos, rt_call(pos, "rt_kd_word", args1(sym_ref_node(pos, s)), ty_int), CV_BITS2F, ft);
    } else if k == K_STRUCT {
        v = call_fn(pos, key_dec_fn(ft), args1(sym_ref_node(pos, s)), ft);
    } else {
        v = mk_conv(pos, rt_call(pos, "rt_kd_word", args1(sym_ref_node(pos, s)), ty_int), CV_INT, ft);
    }
    vec_push(body, assign_stmt(pos, field_store(pos, sym_ref_node(pos, obj), t, fi), v));
}

// map_read is m[k]: a missing key reads as the value type's zero, and a str, slice, map
// or struct zero is a real (never nil) value.
fn map_read(pos, m, k, vt) {
    let get = from_bits(rt_call(pos, "rt_map_get", args2(m, key_in(k, m[N_TYPE][TY_KEY])), ty_int), vt);
    let vk = kind_of(vt);
    if ck_legacy || !(vk == K_STRING || vk == K_SLICE || vk == K_MAP || vk == K_STRUCT) {
        return get;
    }
    let stmts = vec_new();
    let tmp = temp(pos, get, vt);
    vec_push(stmts, tmp);
    let ifs = node_new(ST_IF, pos);
    ifs[IF_COND] = mk_unot(pos, rt_call(pos, "rt_map_found", vec_new(), ty_bool));
    ifs[IF_THEN] = empty_block(pos);
    let alt = 0;
    if vk == K_STRING {
        alt = lit_string(pos, "");
    } else if vk == K_SLICE {
        alt = intrinsic_call(pos, "__empty", vec_new(), vt);
    } else {
        alt = argo_new(pos, ifs[IF_THEN][BLK_STMTS], vt);
    }
    vec_push(ifs[IF_THEN][BLK_STMTS], assign_stmt(pos, sym_ref_node(pos, tmp[LET_SYM]), alt));
    vec_push(stmts, ifs);
    return mk_seq(pos, stmts, sym_ref_node(pos, tmp[LET_SYM]), vt);
}

// mk_elem indexes a slice or string; the backend checks the index against the length
// unless ELEM_SAFE is set (the checker proved it in range).
fn mk_elem(pos, seq, index, t, isstr) {
    let n = node_new(EX_ELEM, pos);
    n[ELEM_SEQ] = seq;
    n[ELEM_IDX] = index;
    n[ELEM_SIZE] = type_width(t);
    n[ELEM_STR] = isstr;
    n[N_TYPE] = t;
    return n;
}

fn chk_index(e) {
    let pos = e[N_POS];
    let x = e[IX_X];
    let xt = chk(x, 0);
    let k = kind_of(xt);
    if ck_legacy || (k == K_INT && ck_trusted) {
        // Raw word indexing: legacy code and the runtime's own memory management.
        chk(e[IX_I], ty_int);
        reconvert(e[IX_I], ty_int);
        return ty_int;
    }
    if k == K_MAP {
        let kt = chk(e[IX_I], xt[TY_KEY]);
        check_assignable(e[IX_I], kt, xt[TY_KEY]);
        if is_untyped(kt) {
            reconvert(e[IX_I], xt[TY_KEY]);
        }
        replace_node(e, map_read(pos, x, e[IX_I], xt[TY_ELEM]));
        e[N_TYPE] = 0;
        return xt[TY_ELEM];
    }
    let it = chk(e[IX_I], ty_int);
    if !is_integer_t(it) {
        err_type(pos, "index must be an integer, not ", it, "");
    }
    if kind_of(it) == K_UINT {
        reconvert(e[IX_I], ty_int);
    }
    if k == K_STRING {
        replace_node(e, mk_elem(pos, x, e[IX_I], ty_byte, 1));
        mark_safe_index(e);
        e[N_TYPE] = 0;
        return ty_byte;
    }
    if k == K_SLICE {
        replace_node(e, mk_elem(pos, x, e[IX_I], xt[TY_ELEM], 0));
        mark_safe_index(e);
        e[N_TYPE] = 0;
        return xt[TY_ELEM];
    }
    err_type(pos, "cannot index ", xt, "");
    return ty_int;
}

fn chk_slice(e) {
    let pos = e[N_POS];
    let x = e[SL_X];
    let xt = chk(x, 0);
    let lo = e[SL_LO];
    let hi = e[SL_HI];
    if lo {
        chk(lo, ty_int);
        reconvert(lo, ty_int);
    } else {
        lo = mk_int(pos, 0, ty_int);
    }
    // has_hi tells the runtime whether an upper bound was written (a negative one must panic).
    let has_hi = mk_int(pos, hi != 0, ty_int);
    if hi {
        chk(hi, ty_int);
        reconvert(hi, ty_int);
    } else {
        hi = mk_int(pos, 0, ty_int);
    }
    if kind_of(xt) == K_STRING {
        replace_node(e, rt_call(pos, "rt_str_sub", args4(x, lo, hi, has_hi), ty_string));
        e[N_TYPE] = 0;
        return ty_string;
    }
    if kind_of(xt) == K_SLICE {
        replace_node(e, rt_call(pos, "rt_slice_sub", args5(x, lo, hi, mk_int(pos, elem_size(xt), ty_int), has_hi), xt));
        e[N_TYPE] = 0;
        return xt;
    }
    err_type(pos, "cannot slice ", xt, "");
    return ty_int;
}

// pkg_member resolves pkg.name to its global symbol, or 0.
fn pkg_member(pkg, name) {
    return lookup_global(str_cat3(pkg, ".", name));
}

// is_private reports whether name is private to its package (not capitalized).
fn is_private(name) {
    let c = load8(name);
    return (c >= 'a' && c <= 'z') || c == '_';
}

// foreign_type reports whether struct type t was declared in a package other than the one
// being checked (its name is pkg.Name with pkg not the current package).
fn foreign_type(t) {
    let n = t[TY_NAME];
    if !n {
        return 0;
    }
    let i = 0;
    while load8(n + i) != 0 && load8(n + i) != '.' && load8(n + i) != '[' {
        i = i + 1;
    }
    if load8(n + i) != '.' {
        return 0;
    }
    let j = 0;
    while j < i {
        if load8(ck_pkg + j) != load8(n + j) {
            return 1;
        }
        j = j + 1;
    }
    return load8(ck_pkg + i) != 0;
}

// private_use reports (once) a private name of another package used here.
fn private_use(pos, what, name, owner) {
    if ck_legacy {
        return;
    }
    let m = err_begin(pos);
    buf_str(m, what);
    buf_str(m, " ");
    buf_str(m, name);
    buf_str(m, " is private to ");
    buf_str(m, owner);
    buf_str(m, ": only capitalized names are exported");
    err_end(m);
}

// type_pkg is the package part of struct type t's name (for messages).
fn type_pkg(t) {
    let n = t[TY_NAME];
    let i = 0;
    while load8(n + i) != 0 && load8(n + i) != '.' {
        i = i + 1;
    }
    return str_slice(n, i);
}

// enum_type_of returns the enum type x names (Shape, geo.Shape, Option[i64]), or 0.
fn enum_type_of(x) {
    let t = 0;
    if x[N_KIND] == EX_IDENT {
        if lookup_name_local(x[ID_NAME]) || import_pkg(x[ID_NAME]) {
            return 0;
        }
        let s = lookup_name(x[ID_NAME]);
        if s {
            return 0;
        }
        t = find_type_name(x[ID_NAME]);
    } else if x[N_KIND] == EX_SELECT {
        let px = x[SEL_X];
        if px[N_KIND] != EX_IDENT || lookup_name_local(px[ID_NAME]) || !import_pkg(px[ID_NAME]) {
            return 0;
        }
        t = find_type(str_cat3(import_pkg(px[ID_NAME]), ".", x[SEL_NAME]));
    } else if x[N_KIND] == EX_INDEX {
        // Option[i64].Some(3): only when the base names a type, not a value.
        let base = x[IX_X];
        if base[N_KIND] != EX_IDENT || lookup_name_local(base[ID_NAME]) || lookup_name(base[ID_NAME]) || !(find_generic(base[ID_NAME]) || (load8(ck_pkg) != 0 && find_generic(qual(ck_pkg, base[ID_NAME])))) {
            return 0;
        }
        let gtx = expr_to_tx(x);
        if gtx {
            t = resolve_type(gtx);
        }
    }
    if t && kind_of(t) == K_STRUCT && t[TY_ENUM] {
        return t;
    }
    return 0;
}

// enum_variant is the index of variant name in enum t, or -1.
fn enum_variant(t, name) {
    let vs = t[TY_ENUM];
    let i = 0;
    while i < vs[VEC_LEN] {
        if streq(vec_get(vec_get(vs, i), 0), name) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// enum_construct builds Shape.Circle(2.0): a tagged object whose other variants' fields
// hold their zero values.
fn enum_construct(e, t, name, args) {
    let pos = e[N_POS];
    let vi = enum_variant(t, name);
    if vi < 0 {
        let u = err_begin(pos);
        type_name(u, t);
        buf_str(u, " has no variant ");
        buf_str(u, name);
        err_end(u);
        return t;
    }
    if is_private(name) && foreign_type(t) {
        private_use(pos, "variant", name, type_pkg(t));
    }
    let v = vec_get(t[TY_ENUM], vi);
    let first = vec_get(v, 1);
    let nf = vec_get(v, 2);
    if args[VEC_LEN] != nf {
        let u = err_begin(pos);
        type_name(u, t);
        buf_byte(u, '.');
        buf_str(u, name);
        buf_str(u, " takes ");
        buf_int(u, nf);
        if nf == 1 {
            buf_str(u, " value, got ");
        } else {
            buf_str(u, " values, got ");
        }
        buf_int(u, args[VEC_LEN]);
        err_end(u);
        return t;
    }
    let stmts = vec_new();
    let obj = temp(pos, rt_call(pos, "rt_alloc", args1(mk_int(pos, t[TY_SIZE], ty_int)), t), t);
    vec_push(stmts, obj);
    vec_push(stmts, assign_stmt(pos, field_store(pos, sym_ref_node(pos, obj[LET_SYM]), t, 0), mk_int(pos, vi, ty_int)));
    let total = t[TY_FIELDS][VEC_LEN];
    let i = 1;
    while i < total {
        if i >= first && i < first + nf {
            let a = vec_get(args, i - first);
            unwrap_mut(a);
            let ft = field_type(t, i);
            let at = chk(a, ft);
            check_assignable(a, at, ft);
            if is_untyped(at) {
                reconvert(a, ft);
            }
            vec_push(stmts, assign_stmt(pos, field_store(pos, sym_ref_node(pos, obj[LET_SYM]), t, i), a));
        }
        // Other variants' fields stay empty: only a switch on the tag can reach them.
        i = i + 1;
    }
    replace_node(e, mk_seq(pos, stmts, sym_ref_node(pos, obj[LET_SYM]), 0));
    return t;
}

fn chk_select(e, want) {
    let pos = e[N_POS];
    let x = e[SEL_X];
    let name = e[SEL_NAME];
    let et = enum_type_of(x);
    if et {
        return enum_construct(e, et, name, vec_new());
    }
    if x[N_KIND] == EX_IDENT && !lookup_name_local(x[ID_NAME]) {
        let pkg = import_pkg(x[ID_NAME]);
        if pkg {
            let s = pkg_member(pkg, name);
            if !s {
                let u = err_begin(pos);
                buf_str(u, "undefined: ");
                buf_str(u, x[ID_NAME]);
                buf_byte(u, '.');
                buf_str(u, name);
                err_end(u);
                return ty_int;
            }
            if is_private(name) {
                private_use(pos, "name", name, pkg);
            }
            replace_node(e, node_new(EX_IDENT, pos));
            e[ID_NAME] = name;
            return use_sym(e, s, want);
        }
    }
    let xt = chk(x, 0);
    if kind_of(xt) == K_OPT {
        err_type(pos, "cannot use a field of optional ", xt, " before checking it against nil");
        return ty_int;
    }
    if kind_of(xt) == K_STRUCT && xt[TY_ENUM] {
        err_type(pos, "an enum's data is read with switch, not as a field of ", xt, "");
        return ty_int;
    }
    if kind_of(xt) == K_DYN {
        err_at(pos, "a method value on a dyn value needs the table: the next step (#141)");
        return ty_int;
    }
    if kind_of(xt) == K_STRUCT {
        let i = struct_field(xt, name);
        if i < 0 {
            let u = err_begin(pos);
            type_name(u, xt);
            buf_str(u, " has no field ");
            buf_str(u, name);
            err_end(u);
            return ty_int;
        }
        if is_private(name) && foreign_type(xt) {
            private_use(pos, "field", name, type_pkg(xt));
        }
        replace_node(e, mk_mem(pos, x, 0, 0, field_offset(xt, i), 0));
        return field_type(xt, i);
    }
    err_type(pos, "cannot select a field of ", xt, "");
    return ty_int;
}

fn lookup_name_local(name) {
    let i = sc_syms[VEC_LEN] - 1;
    while i >= 0 {
        if streq(vec_get(sc_syms, i)[S_NAME], name) {
            return vec_get(sc_syms, i);
        }
        i = i - 1;
    }
    return 0;
}

// field_store builds the target for storing into field fi of struct object obj.
fn field_store(pos, obj, t, fi) {
    return mk_mem(pos, obj, 0, 0, field_offset(t, fi), field_type(t, fi));
}

// chk_composite allocates a struct, slice or map and fills it, as an EX_SEQ.
fn chk_composite(e, want) {
    let pos = e[N_POS];
    let tx = e[CL_TYPE];
    let t = want;
    if kind_of(t) == K_OPT {
        t = t[TY_ELEM];
    }
    if tx[N_KIND] == EX_TYPE && tx[TYX] {
        t = resolve_type(tx[TYX]);
    } else if tx[N_KIND] == EX_INDEX {
        let gtx = expr_to_tx(tx);
        if gtx {
            t = resolve_type(gtx);
        }
    } else if tx[N_KIND] == EX_IDENT || tx[N_KIND] == EX_SELECT {
        let tn = node_new(TX_NAME, pos);
        if tx[N_KIND] == EX_IDENT {
            tn[TX_B] = tx[ID_NAME];
        } else {
            tn[TX_A] = tx[SEL_X][ID_NAME];
            tn[TX_B] = tx[SEL_NAME];
        }
        t = resolve_type(tn);
    }
    if !t {
        err_at(pos, "missing type in composite literal");
        return ty_int;
    }
    let elems = e[CL_ELEMS];
    let keys = e[CL_KEYS];
    let stmts = vec_new();
    let k = kind_of(t);
    if k == K_STRUCT && t[TY_ENUM] {
        err_type(pos, "build an enum with one of its variants (", t, ".Variant(...)), not a composite literal");
        return t;
    }
    if k == K_STRUCT {
        let nf = t[TY_FIELDS][VEC_LEN];
        let obj = temp(pos, rt_call(pos, "rt_alloc", args1(mk_int(pos, t[TY_SIZE], ty_int)), t), t);
        vec_push(stmts, obj);
        let set = vec_filled(nf, 0);
        let i = 0;
        while i < elems[VEC_LEN] {
            let fi = i;
            let key = vec_get(keys, i);
            if key {
                if key[N_KIND] != EX_IDENT {
                    err_at(key[N_POS], "expected a field name");
                    return t;
                }
                fi = struct_field(t, key[ID_NAME]);
                if fi < 0 {
                    err_quoted(key[N_POS], "unknown field ", key[ID_NAME], "");
                    return t;
                }
                if is_private(key[ID_NAME]) && foreign_type(t) {
                    private_use(key[N_POS], "field", key[ID_NAME], type_pkg(t));
                }
            } else if fi >= nf {
                err_at(pos, "too many values in struct literal");
                return t;
            }
            set[VEC_DATA][fi] = 1;
            let ft = field_type(t, fi);
            let v = vec_get(elems, i);
            let vt = chk(v, ft);
            check_assignable(v, vt, ft);
            if is_untyped(vt) {
                reconvert(v, ft);
            }
            if !(is_const_zero(v) && !is_ref(ft)) {
                vec_push(stmts, assign_stmt(pos, field_store(pos, sym_ref_node(pos, obj[LET_SYM]), t, fi), v));
            }
            i = i + 1;
        }
        // Fields left out get their zero value; references that cannot be nil must be set.
        i = 0;
        while i < nf {
            if !vec_get(set, i) {
                init_zero_field(pos, stmts, obj[LET_SYM], t, i);
            }
            i = i + 1;
        }
        replace_node(e, mk_seq(pos, stmts, sym_ref_node(pos, obj[LET_SYM]), 0));
        return t;
    }
    if k == K_SLICE {
        let n = elems[VEC_LEN];
        let et = t[TY_ELEM];
        let sl = temp(pos, rt_call(pos, "rt_slice_make", args3(mk_int(pos, n, ty_int), mk_int(pos, n, ty_int), mk_int(pos, elem_size(t), ty_int)), t), t);
        vec_push(stmts, sl);
        let data = temp(pos, mk_hdr(pos, sym_ref_node(pos, sl[LET_SYM]), 2), ty_int);
        vec_push(stmts, data);
        let i = 0;
        while i < n {
            let v = vec_get(elems, i);
            let vt = chk(v, et);
            check_assignable(v, vt, et);
            if is_untyped(vt) {
                reconvert(v, et);
            }
            vec_push(stmts, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, data[LET_SYM]), 0, 0, i * type_width(et), et), v));
            i = i + 1;
        }
        replace_node(e, mk_seq(pos, stmts, sym_ref_node(pos, sl[LET_SYM]), 0));
        return t;
    }
    if k == K_MAP {
        let m = temp(pos, rt_call(pos, "rt_map_make", args1(mk_int(pos, map_str_keys(t[TY_KEY]), ty_int)), t), t);
        vec_push(stmts, m);
        let i = 0;
        while i < elems[VEC_LEN] {
            let key = vec_get(keys, i);
            let v = vec_get(elems, i);
            if !key {
                err_at(v[N_POS], "missing key in map literal");
                return t;
            }
            let kt = chk(key, t[TY_KEY]);
            check_assignable(key, kt, t[TY_KEY]);
            if is_untyped(kt) {
                reconvert(key, t[TY_KEY]);
            }
            let vt = chk(v, t[TY_ELEM]);
            check_assignable(v, vt, t[TY_ELEM]);
            if is_untyped(vt) {
                reconvert(v, t[TY_ELEM]);
            }
            vec_push(stmts, expr_stmt(map_set_call(pos, sym_ref_node(pos, m[LET_SYM]), key, v, t[TY_KEY])));
            i = i + 1;
        }
        replace_node(e, mk_seq(pos, stmts, sym_ref_node(pos, m[LET_SYM]), 0));
        return t;
    }
    err_type(pos, "cannot build a composite literal of type ", t, "");
    return ty_int;
}

// init_zero_field stores the zero value of a field the literal left out. Memory is
// already zeroed, so only references need work: "" and empty slices are static
// objects, and structs, maps and funcs have no zero value at all.
fn init_zero_field(pos, stmts, obj, t, fi) {
    let ft = field_type(t, fi);
    let k = kind_of(ft);
    let rec = vec_get(t[TY_FIELDS], fi);
    if k == K_SLICE && rec[VEC_LEN] > 4 && vec_get(rec, 3) > 0 {
        array_inner = vec_get(rec, 4);
        vec_push(stmts, assign_stmt(pos, field_store(pos, sym_ref_node(pos, obj), t, fi), array_make(pos, ft, vec_get(rec, 3))));
        return;
    }
    if k == K_STRING || k == K_SLICE {
        vec_push(stmts, assign_stmt(pos, field_store(pos, sym_ref_node(pos, obj), t, fi), zero_value(pos, ft)));
    } else if k == K_STRUCT || k == K_MAP || k == K_FUNC || k == K_DYN {
        let m = err_begin(pos);
        buf_str(m, "field ");
        buf_str(m, vec_get(vec_get(t[TY_FIELDS], fi), 0));
        buf_str(m, " of type ");
        type_name(m, ft);
        if k == K_DYN {
            buf_str(m, " must be set (a dyn value has no zero; the table comes with the next step, #141)");
        } else {
            buf_str(m, " must be set (it cannot be nil; declare it ?T to allow that)");
        }
        err_end(m);
    }
}

fn get_cell_addr(pos, os) {
    if os[S_CAPTURED] {
        return mk_mem(pos, sym_ref_node(pos, ck_fn[F_ENV_SYM]), 0, 0, 8 * (2 + os[S_CAP_IDX]), ty_int);
    }
    if os[S_CELL] {
        return sym_ref_node(pos, os[S_CELL_SYM]);
    }
    os[S_ADDR] = 1;
    return mk_unary(pos, "&", sym_ref_node(pos, os));
}

// closure_keeper builds keep$N(d), which copies closure descriptor d and its captured
// variables into the long-lived heap, each value kept by its type (a str, slice, struct or
// closure deeply), so a kept closure never reads request memory (#170). It returns 0 when
// no captured variable holds a reference.
fn closure_keeper(pos, cf) {
    let caps = cf[F_CAPTURES];
    let k = caps[VEC_LEN];
    let refs = 0;
    let i = 0;
    while i < k {
        let ct = vec_get(caps, i)[S_TYPE];
        if is_ref(ct) || is_dyn_value(ct) {
            refs = 1;
        }
        i = i + 1;
    }
    if !refs {
        return 0;
    }
    lifted_count = lifted_count + 1;
    let f = fn_new(pos, "keep");
    let nb = buf_new();
    buf_str(nb, "keep$");
    buf_int(nb, lifted_count);
    buf_byte(nb, 0);
    f[F_QNAME] = nb[VEC_DATA];
    f[F_NAME] = nb[VEC_DATA];
    f[F_LIFTED] = 2;
    f[F_FILE] = cf[F_FILE];
    vec_push(f[F_PARAMS], "d");
    vec_push(f[F_PTYPES], ty_int);
    vec_push(f[F_RTYPES], ty_int);
    f[F_TYPE] = func_of(f[F_PTYPES], f[F_RTYPES], 0);
    f[F_LOCALS] = vec_new();
    f[F_BODY] = empty_block(pos);
    vec_push(prog_fns, f);
    let saved_fn = ck_fn;
    ck_fn = f;
    let d = sym_new(SYM_LOCAL, "d", pos);
    d[S_TYPE] = ty_int;
    d[S_SLOT] = 0;
    f[F_SLOTS] = 1;
    vec_push(f[F_LOCALS], d);
    let body = f[F_BODY][BLK_STMTS];
    let nd = temp(pos, rt_call(pos, "rt_ingot_alloc", args1(mk_int(pos, 8 * (3 + k), ty_int)), ty_int), ty_int);
    vec_push(body, nd);
    let w = 0;
    while w < 2 {
        vec_push(body, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, nd[LET_SYM]), 0, 0, 8 * w, ty_int), mk_mem(pos, sym_ref_node(pos, d), 0, 0, 8 * w, ty_int)));
        w = w + 1;
    }
    vec_push(body, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, nd[LET_SYM]), 0, 0, 8 * (2 + k), ty_int), mk_mem(pos, sym_ref_node(pos, d), 0, 0, 8 * (2 + k), ty_int)));
    i = 0;
    while i < k {
        let ct = vec_get(caps, i)[S_TYPE];
        let cell = temp(pos, rt_call(pos, "rt_ingot_alloc", args1(mk_int(pos, 8, ty_int)), ty_int), ty_int);
        vec_push(body, cell);
        let old = mk_mem(pos, mk_mem(pos, sym_ref_node(pos, d), 0, 0, 8 * (2 + i), ty_int), 0, 0, 0, ct);
        let val = old;
        if is_ref(ct) || is_dyn_value(ct) {
            val = keep_call(pos, keep_fn(ct), old, ct);
        }
        vec_push(body, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, cell[LET_SYM]), 0, 0, 0, ct), val));
        vec_push(body, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, nd[LET_SYM]), 0, 0, 8 * (2 + i), ty_int), sym_ref_node(pos, cell[LET_SYM])));
        i = i + 1;
    }
    let ret = node_new(ST_RETURN, pos);
    ret[RET_VALUE] = sym_ref_node(pos, nd[LET_SYM]);
    vec_push(body, ret);
    ck_fn = saved_fn;
    return f;
}

// chk_funclit lifts a function literal to a top-level function. Literals may capture
// variables from enclosing scopes: non-escaping closures allocate frame descriptors
// and cells on stack (0 bytes allocated), while escaping closures allocate region objects.
fn chk_funclit(e) {
    let f = e[LIT_FN];
    lifted_count = lifted_count + 1;
    let b = buf_new();
    buf_str(b, "func$");
    buf_int(b, lifted_count);
    buf_byte(b, 0);
    f[F_NAME] = b[VEC_DATA];
    f[F_FILE] = ck_file;
    f[F_LIFTED] = 1;
    f[F_QNAME] = f[F_NAME];
    f[F_PARENT] = ck_fn;
    f[F_CAPTURES] = vec_new();
    f[F_OUTER_SYMS] = vec_clone(sc_syms);
    f[F_ESCAPES] = e[LIT_ESCAPE];

    let saved_fn = ck_fn;
    let saved_legacy = ck_legacy;
    declare_fn(f);
    ck_fn = saved_fn;
    ck_legacy = saved_legacy;

    check_fn_closure(f);
    f[F_DONE] = 1;
    vec_push(prog_fns, f);

    let k = f[F_CAPTURES][VEC_LEN];
    if k == 0 {
        replace_node(e, node_new(EX_FUNCREF, e[N_POS]));
        e[FR_FN] = f;
        return f[F_TYPE];
    }

    let pos = e[N_POS];
    let fn_ref = node_new(EX_FUNCREF, pos);
    fn_ref[FR_FN] = f;
    fn_ref[FR_RAW] = 1;
    fn_ref[N_TYPE] = ty_int;

    let stmts = vec_new();
    let desc_val = 0;

    if e[LIT_ESCAPE] == 0 {
        let desc_sym = declare_local(pos, "$desc", ty_int);
        desc_sym[S_ADDR] = 1;
        desc_sym[S_WORDS] = 3 + k;
        let desc_addr = mk_unary(pos, "&", sym_ref_node(pos, desc_sym));
        let dptr = temp(pos, desc_addr, ty_int);
        vec_push(stmts, dptr);
        let dref = sym_ref_node(pos, dptr[LET_SYM]);

        vec_push(stmts, assign_stmt(pos, mk_mem(pos, dref, 0, 0, 0, ty_int), fn_ref));
        vec_push(stmts, assign_stmt(pos, mk_mem(pos, dref, 0, 0, 8, ty_int), mk_int(pos, k, ty_int)));

        let i = 0;
        while i < k {
            let os = vec_get(f[F_CAPTURES], i);
            let cell_expr = get_cell_addr(pos, os);
            vec_push(stmts, assign_stmt(pos, mk_mem(pos, dref, 0, 0, 8 * (2 + i), ty_int), cell_expr));
            i = i + 1;
        }
        // A frame descriptor is never kept (the closure is only called): no keeper.
        vec_push(stmts, assign_stmt(pos, mk_mem(pos, dref, 0, 0, 8 * (2 + k), ty_int), mk_int(pos, 0, ty_int)));
        desc_val = dref;
    } else {
        let alloc_call = rt_call(pos, "rt_alloc", args1(mk_int(pos, 8 * (3 + k), ty_int)), ty_int);
        let obj = temp(pos, alloc_call, ty_int);
        vec_push(stmts, obj);
        let dref = sym_ref_node(pos, obj[LET_SYM]);

        vec_push(stmts, assign_stmt(pos, mk_mem(pos, dref, 0, 0, 0, ty_int), fn_ref));
        vec_push(stmts, assign_stmt(pos, mk_mem(pos, dref, 0, 0, 8, ty_int), mk_int(pos, k, ty_int)));

        let i = 0;
        while i < k {
            let os = vec_get(f[F_CAPTURES], i);
            let cell_expr = get_cell_addr(pos, os);
            vec_push(stmts, assign_stmt(pos, mk_mem(pos, dref, 0, 0, 8 * (2 + i), ty_int), cell_expr));
            i = i + 1;
        }
        // Word 2 + k: the function keep() calls to copy this closure deeply (0: no captured
        // variable holds a reference, so copying the words is enough).
        let keeper = closure_keeper(pos, f);
        let kv = mk_int(pos, 0, ty_int);
        if keeper {
            kv = node_new(EX_FUNCREF, pos);
            kv[FR_FN] = keeper;
            kv[N_TYPE] = ty_int;
        }
        vec_push(stmts, assign_stmt(pos, mk_mem(pos, dref, 0, 0, 8 * (2 + k), ty_int), kv));
        desc_val = dref;
    }

    let seq = mk_seq(pos, stmts, desc_val, f[F_TYPE]);
    replace_node(e, seq);
    return f[F_TYPE];
}

// ---- calls ----

// mask has bit i set when parameter i is mut: its argument must be written `mut x`
// (a method's receiver, argument 0 of a CALL_METHOD call, is exempt).
fn chk_args(e, ptypes, variadic, legacy, mask) {
    let args = e[CALL_ARGS];
    let n = ptypes[VEC_LEN];
    if args[VEC_LEN] != n && !(variadic && args[VEC_LEN] >= n) {
        let a = err_begin(e[N_POS]);
        if e[CALL_NAME] {
            buf_str(a, e[CALL_NAME]);
        } else {
            buf_str(a, "function");
        }
        buf_str(a, " expects ");
        buf_int(a, n);
        buf_str(a, " arguments, got ");
        buf_int(a, args[VEC_LEN]);
        err_end(a);
    }
    let i = 0;
    while i < args[VEC_LEN] {
        let a = vec_get(args, i);
        let marked = unwrap_mut(a);
        if !legacy && !ck_legacy && !(i == 0 && e[CALL_METHOD]) {
            let pm = i < n && i < 63 && (mask & (1 << i)) != 0;
            if pm && !marked {
                mut_arg_error(e, a, i, "is a mut parameter: write mut before the argument");
            } else if marked && !pm {
                mut_arg_error(e, a, i, "is not a mut parameter: remove mut");
            }
        }
        let want = 0;
        if i < n {
            want = vec_get(ptypes, i);
        }
        let at = chk(a, want);
        if i < n && !legacy {
            check_assignable(a, at, want);
            if is_untyped(at) {
                reconvert(a, want);
            }
        } else if i < n && legacy && is_float_t(at) {
            err_at(a[N_POS], "cannot pass a f64 to an untyped (fn) parameter");
        }
        if i >= n && is_untyped(at) {
            reconvert(a, default_type(at));
        }
        i = i + 1;
    }
}

// unwrap_mut turns `mut x` back into x and reports whether it was marked.
fn unwrap_mut(a) {
    if a[N_KIND] != EX_MUTARG {
        return 0;
    }
    replace_node(a, a[MUTARG_X]);
    return 1;
}

fn mut_arg_error(e, a, i, what) {
    let m = err_begin(a[N_POS]);
    buf_str(m, "argument ");
    if e[CALL_METHOD] {
        buf_int(m, i);
    } else {
        buf_int(m, i + 1);
    }
    buf_str(m, " of ");
    if e[CALL_NAME] {
        buf_str(m, e[CALL_NAME]);
    } else {
        buf_str(m, "this call");
    }
    buf_byte(m, ' ');
    buf_str(m, what);
    err_end(m);
}

fn result_type(f) {
    let rs = f[F_RTYPES];
    if rs[VEC_LEN] == 0 {
        return ty_void;
    }
    if rs[VEC_LEN] == 1 {
        return vec_get(rs, 0);
    }
    return tuple_of(rs);
}

fn func_result(ft) {
    let rs = ft[TY_RESULTS];
    if rs[VEC_LEN] == 0 {
        return ty_void;
    }
    if rs[VEC_LEN] == 1 {
        return vec_get(rs, 0);
    }
    return tuple_of(rs);
}

fn direct_call(e, f) {
    if is_template(f) {
        return generic_call(e, f);
    }
    e[CALL_FN] = f;
    e[CALL_CALLEE] = 0;
    chk_args(e, f[F_PTYPES], f[F_VARIADIC], f[F_LEGACY], mut_mask(f[F_MUTS]));
    return result_type(f);
}

fn chk_call(e, want) {
    let name = e[CALL_NAME];
    let callee = e[CALL_CALLEE];
    if name {
        let s = lookup_name(name);
        if s && s[S_KIND] == SYM_FUNC {
            runtime_use(e[N_POS], s[S_FN], name);
            return direct_call(e, s[S_FN]);
        }
        if s && (s[S_KIND] == SYM_LOCAL || s[S_KIND] == SYM_GLOBAL) && kind_of(s[S_TYPE]) == K_FUNC {
            let id = node_new(EX_IDENT, e[N_POS]);
            id[ID_NAME] = name;
            e[CALL_CALLEE] = id;
            e[CALL_NAME] = 0;
            return indirect_call(e);
        }
        if !s {
            let n = intrinsic_arity(name);
            if n >= 0 {
                if !ck_legacy && !ck_trusted {
                    err_quoted(e[N_POS], "", name, " is internal to the runtime");
                }
                e[CALL_INTRINSIC] = 1;
                if e[CALL_ARGS][VEC_LEN] != n {
                    arity_error(e, n);
                }
                let i = 0;
                while i < e[CALL_ARGS][VEC_LEN] {
                    let a = vec_get(e[CALL_ARGS], i);
                    chk(a, ty_int);
                    reconvert(a, ty_int);
                    i = i + 1;
                }
                if streq(name, "load8") && !ck_legacy {
                    return ty_byte;
                }
                return ty_int;
            }
            let bt = chk_builtin(e, name, want);
            if bt {
                return bt;
            }
            let tt = find_type_name(name);
            if tt {
                return chk_conversion(e, tt);
            }
            let u = err_begin(e[N_POS]);
            buf_str(u, "undefined function: ");
            buf_str(u, name);
            err_end(u);
            return ty_int;
        }
        err_quoted(e[N_POS], "", name, " is not a function");
        return ty_int;
    }
    let gx = explicit_generic(callee);
    if gx {
        let inst = instantiate_fn(gx, resolve_types(index_targs(callee)), e[N_POS]);
        e[CALL_NAME] = inst[F_QNAME];
        return direct_call(e, inst);
    }
    if callee[N_KIND] == EX_SELECT {
        let x = callee[SEL_X];
        let m = callee[SEL_NAME];
        let et = enum_type_of(x);
        if et {
            return enum_construct(e, et, m, e[CALL_ARGS]);
        }
        if x[N_KIND] == EX_IDENT && !lookup_name_local(x[ID_NAME]) && import_pkg(x[ID_NAME]) {
            let pkg = import_pkg(x[ID_NAME]);
            if streq(pkg, "say") && is_say_func(m) {
                return lower_say(e, m, want);
            }
            if streq(pkg, "argo") && streq(m, "Put") {
                return lower_argo_put(e);
            }
            if streq(pkg, "argo") && streq(m, "Get") {
                return lower_argo_get(e);
            }
            let s = pkg_member(pkg, m);
            if s && is_private(m) {
                private_use(e[N_POS], "function", m, pkg);
            }
            if s && s[S_KIND] == SYM_FUNC {
                e[CALL_NAME] = s[S_NAME];
                return direct_call(e, s[S_FN]);
            }
            let pt = find_type(str_cat3(pkg, ".", m));
            if pt {
                return chk_conversion(e, pt);
            }
            let ov = overload(pkg, m, e);
            if ov {
                e[CALL_NAME] = ov[F_QNAME];
                return direct_call(e, ov);
            }
            let u = err_begin(e[N_POS]);
            buf_str(u, "undefined: ");
            buf_str(u, x[ID_NAME]);
            buf_byte(u, '.');
            buf_str(u, m);
            err_end(u);
            return ty_int;
        }
        let xt = chk(x, 0);
        if kind_of(xt) == K_OPT {
            err_type(e[N_POS], "cannot call a method of optional ", xt, " before checking it against nil");
            return ty_int;
        }
        if kind_of(xt) == K_STRUCT {
            let mf = find_fn(str_cat3(xt[TY_NAME], ".", m));
            if mf && is_private(m) && foreign_type(xt) {
                private_use(e[N_POS], "method", m, type_pkg(xt));
            }
            if mf {
                let args = vec_new();
                vec_push(args, x);
                let i = 0;
                while i < e[CALL_ARGS][VEC_LEN] {
                    vec_push(args, vec_get(e[CALL_ARGS], i));
                    i = i + 1;
                }
                e[CALL_ARGS] = args;
                e[CALL_NAME] = mf[F_QNAME];
                e[CALL_METHOD] = 1;
                return direct_call(e, mf);
            }
            let fi = struct_field(xt, m);
            if fi >= 0 && kind_of(field_type(xt, fi)) == K_FUNC {
                e[CALL_CALLEE] = mk_mem(e[N_POS], x, 0, 0, field_offset(xt, fi), field_type(xt, fi));
                return indirect_call(e);
            }
            let u = err_begin(e[N_POS]);
            type_name(u, xt);
            buf_str(u, " has no method ");
            buf_str(u, m);
            err_end(u);
            return ty_int;
        }
        if kind_of(xt) == K_ERROR && streq(m, "Error") {
            replace_node(e, rt_call(e[N_POS], "rt_err_str", args1(x), ty_string));
            e[N_TYPE] = 0;
            return ty_string;
        }
        if kind_of(xt) == K_DYN {
            return lower_dyn_method_call(e, x, xt, m);
        }
        err_type(e[N_POS], "cannot call a method on ", xt, "");
        return ty_int;
    }
    if callee[N_KIND] == EX_TYPE {
        return chk_conversion(e, resolve_type(callee[TYX]));
    }
    return indirect_call(e);
}

// lower_dyn_method_call checks the explicit arguments against the flattened shape
// signature, then builds an ordinary indirect call whose first ABI argument is the
// object word and whose callee is the method descriptor loaded from the table.
fn lower_dyn_method_call(e, receiver, dt, name) {
    let pos = e[N_POS];
    let info = dyn_shape_method(dt, name);
    if !info {
        let m = err_begin(pos);
        buf_str(m, "dyn shape ");
        buf_str(m, dt[TY_GDECL][D_NAME]);
        buf_str(m, " has no method ");
        buf_str(m, name);
        err_end(m);
        return ty_int;
    }
    let sig = vec_get(info, 1);
    let names = vec_get(sig, 0);
    let ps = vec_get(sig, 1);
    let ms = vec_get(sig, 2);
    let rs = vec_get(sig, 3);
    let variadic = vec_get(sig, 4);
    let mutmask = 0;
    let i = 0;
    while i < ms[VEC_LEN] && i < 63 {
        if vec_get(ms, i) {
            mutmask = mutmask | (1 << i);
        }
        i = i + 1;
    }
    e[CALL_NAME] = name;
    chk_args(e, ps, variadic, 0, mutmask);

    // A method receiver may itself be an expression with effects. Store its pair once;
    // both the object argument and descriptor lookup then read the same value.
    let receiver_temp = temp(pos, receiver, dt);
    let receiver_ref = sym_ref_node(pos, receiver_temp[LET_SYM]);
    let object = mk_conv(pos, receiver_ref, CV_DYN_OBJECT, ty_int);
    let desc_params = vec_new();
    vec_push(desc_params, ty_int);
    i = 0;
    while i < ps[VEC_LEN] {
        vec_push(desc_params, vec_get(ps, i));
        i = i + 1;
    }
    let desc_mask = 0;
    i = 0;
    while i < ms[VEC_LEN] && i < 62 {
        if vec_get(ms, i) {
            desc_mask = desc_mask | (1 << (i + 1));
        }
        i = i + 1;
    }
    let ft = func_of_m(desc_params, rs, variadic, desc_mask);
    let desc = mk_conv(pos, receiver_ref, CV_DYN_DESC, ft);
    desc[CV_DYN_INDEX] = vec_get(info, 0);

    let inner = node_new(EX_CALL, pos);
    inner[CALL_NAME] = name;
    inner[CALL_ARGS] = args1(object);
    i = 0;
    while i < e[CALL_ARGS][VEC_LEN] {
        vec_push(inner[CALL_ARGS], vec_get(e[CALL_ARGS], i));
        i = i + 1;
    }
    inner[CALL_CALLEE] = desc;
    inner[CALL_METHOD] = 1;
    inner[CALL_DYN_SHAPE] = dt;
    inner[CALL_DYN_INDEX] = vec_get(info, 0);
    inner[N_TYPE] = func_result(ft);
    let stmts = vec_new();
    vec_push(stmts, receiver_temp);
    replace_node(e, mk_seq(pos, stmts, inner, inner[N_TYPE]));
    return inner[N_TYPE];
}

// overload picks pkg.Name__suffix by the first argument's element type, the stand-in
// for generics in library functions like sift.Sort.
fn overload(pkg, name, e) {
    let args = e[CALL_ARGS];
    if args[VEC_LEN] == 0 {
        return 0;
    }
    let t = chk(vec_get(args, 0), 0);
    if kind_of(t) == K_SLICE {
        t = t[TY_ELEM];
    }
    let b = buf_new();
    buf_str(b, pkg);
    buf_byte(b, '.');
    buf_str(b, name);
    buf_str(b, "__");
    type_name(b, default_type(t));
    buf_byte(b, 0);
    return find_fn(b[VEC_DATA]);
}

fn indirect_call(e) {
    let callee = e[CALL_CALLEE];
    let ft = chk(callee, 0);
    if kind_of(ft) != K_FUNC {
        err_type(e[N_POS], "cannot call a value of type ", ft, "");
        return ty_int;
    }
    e[CALL_FN] = 0;
    chk_args(e, ft[TY_FIELDS], 0, 0, ft[TY_KEY]);
    return func_result(ft);
}

// lower_append_dyn passes the object and table as separate scalar arguments to the
// runtime append helper. The pair temporary evaluates a conversion or other expression
// once, and the region pass still sees its object bits through both projections.
fn lower_append_dyn(pos, slice, value, st) {
    let et = st[TY_ELEM];
    let saved = temp(pos, value, et);
    let ref = sym_ref_node(pos, saved[LET_SYM]);
    let object = mk_conv(pos, ref, CV_DYN_OBJECT, ty_int);
    let table = mk_conv(pos, ref, CV_DYN_TABLE_WORD, ty_int);
    let call = rt_call(pos, "rt_append_dyn", args3(slice, object, table), st);
    let stmts = vec_new();
    vec_push(stmts, saved);
    return mk_seq(pos, stmts, call, st);
}

fn find_type_name(name) {
    if load8(ck_pkg) != 0 {
        let t = find_type(qual(ck_pkg, name));
        if t {
            return t;
        }
    }
    return find_type(name);
}

fn arg0(e) {
    return vec_get(e[CALL_ARGS], 0);
}

fn chk_conversion(e, to) {
    let pos = e[N_POS];
    if e[CALL_ARGS][VEC_LEN] != 1 {
        err_type(pos, "conversion to ", to, " needs exactly one argument");
        return to;
    }
    let x = arg0(e);
    let from = chk(x, to);
    let fk = kind_of(from);
    let tk = kind_of(to);
    if from == to || (is_untyped(from) && assignable(from, to)) {
        if is_untyped(from) {
            reconvert(x, to);
        }
        replace_node(e, x);
        return to;
    }
    if tk == K_FLOAT && is_integer_t(from) {
        if is_untyped(from) {
            reconvert(x, ty_int);
        }
        if is_f32(to) {
            replace_node(e, mk_conv(pos, mk_conv(pos, x, CV_I2F, ty_float), CV_ROUND32, ty_f32));
            return ty_f32;
        }
        replace_node(e, mk_conv(pos, x, CV_I2F, ty_float));
        return ty_float;
    }
    if tk == K_FLOAT && fk == K_FLOAT {
        // f64 -> f32 rounds; f32 -> f64 is exact (the register already holds an f64).
        if is_f32(to) {
            replace_node(e, mk_conv(pos, x, CV_ROUND32, ty_f32));
        } else {
            replace_node(e, mk_conv(pos, x, CV_SAME, to));
        }
        return to;
    }
    if tk == K_INT && fk == K_FLOAT {
        replace_node(e, mk_conv(pos, x, CV_F2I, to));
        return to;
    }
    if tk == K_INT && is_integer_t(from) {
        // Integer conversions truncate or extend to the target width.
        replace_node(e, mk_conv(pos, x, CV_INT, to));
        return to;
    }
    if tk == K_INT && fk == K_BOOL {
        replace_node(e, mk_conv(pos, x, CV_SAME, to));
        return to;
    }
    if tk == K_STRING && is_integer_t(from) {
        replace_node(e, rt_call(pos, "rt_str_from_rune", args1(x), ty_string));
        return ty_string;
    }
    if tk == K_STRING && fk == K_SLICE && from[TY_ELEM] == ty_byte {
        replace_node(e, rt_call(pos, "rt_str_from_bytes", args1(x), ty_string));
        return ty_string;
    }
    if tk == K_SLICE && to[TY_ELEM] == ty_byte && fk == K_STRING {
        replace_node(e, rt_call(pos, "rt_bytes_from_str", args1(x), to));
        return to;
    }
    if tk == K_OPT && from == to[TY_ELEM] {
        replace_node(e, mk_conv(pos, x, CV_SAME, to));
        return to;
    }
    err_types(pos, "cannot convert ", from, " to ", to);
    return to;
}

// chk_builtin handles the predeclared functions; it returns 0 for other names.
fn chk_builtin(e, name, want) {
    let pos = e[N_POS];
    let args = e[CALL_ARGS];
    let n = args[VEC_LEN];
    if streq(name, "len") || streq(name, "cap") {
        if n != 1 {
            err_quoted(pos, "", name, " expects 1 argument");
            return ty_int;
        }
        let t = chk(arg0(e), 0);
        let k = kind_of(t);
        if k != K_STRING && k != K_SLICE && k != K_MAP {
            err_type(pos, "invalid argument for len: ", t, "");
        }
        let word = 0;
        if streq(name, "cap") {
            word = 1;
        }
        replace_node(e, mk_hdr(pos, arg0(e), word));
        e[N_TYPE] = 0;
        return ty_int;
    }
    if streq(name, "append") {
        if n == 0 {
            err_at(pos, "append needs a slice");
            return ty_int;
        }
        let st = chk(arg0(e), want);
        if kind_of(st) != K_SLICE {
            err_type(pos, "first argument to append must be a slice, not ", st, "");
            return ty_int;
        }
        let et = st[TY_ELEM];
        let acc = arg0(e);
        let i = 1;
        while i < n {
            let a = vec_get(args, i);
            if a[N_KIND] == EX_UNARY && streq(a[UN_OP], "...") {
                let at = chk(a[UN_X], st);
                if kind_of(at) == K_STRING && et == ty_byte {
                    acc = rt_call(pos, "rt_append_str", args2(acc, a[UN_X]), st);
                } else {
                    check_assignable(a[UN_X], at, st);
                    acc = rt_call(pos, "rt_slice_appendn", args3(acc, a[UN_X], mk_int(pos, elem_size(st), ty_int)), st);
                }
            } else {
                let vt = chk(a, et);
                check_assignable(a, vt, et);
                if is_untyped(vt) {
                    reconvert(a, et);
                }
                if is_dyn_value(et) {
                    acc = lower_append_dyn(pos, acc, a, st);
                } else {
                    acc = rt_call(pos, "rt_append", args3(acc, elem_bits(a, st[TY_ELEM]), mk_int(pos, elem_size(st), ty_int)), st);
                }
            }
            i = i + 1;
        }
        replace_node(e, acc);
        e[N_TYPE] = 0;
        return st;
    }
    if streq(name, "make") {
        let t = resolve_type(arg0(e)[TYX]);
        let k = kind_of(t);
        if k == K_SLICE {
            if n < 2 {
                err_at(pos, "make of a slice needs a length");
                return t;
            }
            chk(vec_get(args, 1), ty_int);
            reconvert(vec_get(args, 1), ty_int);
            // Without a capacity pass 0 (the runtime raises it to the length), so the length
            // expression is evaluated once.
            let c = mk_int(pos, 0, ty_int);
            if n > 2 {
                c = vec_get(args, 2);
                chk(c, ty_int);
                reconvert(c, ty_int);
            }
            let ek = kind_of(t[TY_ELEM]);
            let len0 = vec_get(args, 1);
            let zero_len = len0[N_KIND] == EX_INT && len0[INT_VAL] == 0;
            if !ck_legacy && !zero_len && (ek == K_STRUCT || ek == K_MAP || ek == K_FUNC || ek == K_DYN) {
                err_type(pos, "make with a length would fill the slice with nil ", t[TY_ELEM], " values: use make([]T, 0, n) and append (or []?T)");
                return t;
            }
            if !ck_legacy && !zero_len && ek == K_STRING {
                // Elements start as "" (a str is never nil).
                replace_node(e, rt_call(pos, "rt_slice_make_str", args2(vec_get(args, 1), c), t));
                return t;
            }
            if !ck_legacy && !zero_len && ek == K_SLICE {
                replace_node(e, rt_call(pos, "rt_slice_make_nest", args3(vec_get(args, 1), c, mk_int(pos, elem_size(t[TY_ELEM]), ty_int)), t));
                return t;
            }
            replace_node(e, rt_call(pos, "rt_slice_make", args3(vec_get(args, 1), c, mk_int(pos, elem_size(t), ty_int)), t));
            return t;
        }
        if k == K_MAP {
            replace_node(e, rt_call(pos, "rt_map_make", args1(mk_int(pos, map_str_keys(t[TY_KEY]), ty_int)), t));
            return t;
        }
        err_type(pos, "cannot make ", t, "");
        return t;
    }
    if streq(name, "new") {
        let t = resolve_type(arg0(e)[TYX]);
        if kind_of(t) != K_STRUCT {
            err_type(pos, "new needs a struct type, not ", t, "");
            return t;
        }
        // new(T) is T{}: fields that cannot be nil must still be set.
        let lit = node_new(EX_COMPOSITE, pos);
        let tyx = node_new(EX_TYPE, pos);
        tyx[TYX] = arg0(e)[TYX];
        lit[CL_TYPE] = tyx;
        lit[CL_ELEMS] = vec_new();
        lit[CL_KEYS] = vec_new();
        replace_node(e, lit);
        e[N_TYPE] = 0;
        return chk_kind(e, t);
    }
    if streq(name, "cast") {
        if !ck_legacy && !ck_trusted {
            err_at(pos, "cast is internal to the runtime");
        }
        let t = resolve_type(arg0(e)[TYX]);
        let x = vec_get(args, 1);
        let from = chk(x, 0);
        if is_untyped(from) {
            reconvert(x, ty_int);
        }
        if is_float_t(t) && !is_float_t(from) {
            replace_node(e, mk_conv(pos, x, CV_BITS2F, t));
        } else if !is_float_t(t) && is_float_t(from) {
            replace_node(e, mk_conv(pos, x, CV_F2BITS, t));
        } else {
            // Same bits, new static type: the operand keeps its own type.
            if is_integer_t(t) && x[N_KIND] == EX_FUNCREF {
                x[FR_RAW] = 1;
            }
            replace_node(e, mk_conv(pos, x, CV_SAME, t));
        }
        return t;
    }
    if streq(name, "delete") {
        let mt = chk(arg0(e), 0);
        if kind_of(mt) != K_MAP || n != 2 {
            err_at(pos, "delete needs a map and a key");
            return ty_void;
        }
        let kt = chk(vec_get(args, 1), mt[TY_KEY]);
        check_assignable(vec_get(args, 1), kt, mt[TY_KEY]);
        if is_untyped(kt) {
            reconvert(vec_get(args, 1), mt[TY_KEY]);
        }
        replace_node(e, rt_call(pos, "rt_map_del", args2(arg0(e), key_in(vec_get(args, 1), mt[TY_KEY])), ty_void));
        return ty_void;
    }
    if streq(name, "copy") {
        let dt = chk(arg0(e), 0);
        let st = chk(vec_get(args, 1), 0);
        if kind_of(st) == K_STRING {
            replace_node(e, rt_call(pos, "rt_copy_str", args2(arg0(e), vec_get(args, 1)), ty_int));
        } else {
            replace_node(e, rt_call(pos, "rt_slice_copy", args3(arg0(e), vec_get(args, 1), mk_int(pos, elem_size(dt), ty_int)), ty_int));
        }
        return ty_int;
    }
    if streq(name, "panic") {
        let pt = chk(arg0(e), ty_string);
        let msg = arg0(e);
        if kind_of(pt) == K_ERROR {
            msg = rt_call(pos, "rt_err_str", args1(msg), ty_string);
        } else if kind_of(pt) != K_STRING {
            msg = say_text(pos, args, 0);
        }
        replace_node(e, rt_call(pos, "rt_panic", args1(msg), ty_void));
        return ty_void;
    }
    if streq(name, "fail") {
        if n != 1 {
            err_at(pos, "fail needs a message");
            return ty_error;
        }
        let ft = chk(arg0(e), ty_string);
        if kind_of(ft) != K_STRING {
            err_type(pos, "fail needs a str message, not ", ft, "");
        }
        replace_node(e, rt_call(pos, "rt_fail", args1(arg0(e)), ty_error));
        e[N_TYPE] = 0;
        return ty_error;
    }
    if streq(name, "keep") {
        if n != 1 {
            err_at(pos, "keep needs one value");
            return ty_int;
        }
        return lower_keep(e, want);
    }
    if streq(name, "print") || streq(name, "println") {
        if streq(name, "println") {
            return lower_say(e, "Line", want);
        }
        return lower_say(e, "Text", want);
    }
    if streq(name, "min") || streq(name, "max") {
        return lower_minmax(e, name, want);
    }
    return 0;
}

fn lower_minmax(e, name, want) {
    let pos = e[N_POS];
    let args = e[CALL_ARGS];
    let n = args[VEC_LEN];
    if n == 0 {
        err_quoted(pos, "", name, " needs arguments");
        return ty_int;
    }
    chk(arg0(e), want);
    let i = 1;
    while i < n {
        unify(arg0(e), vec_get(args, i), want);
        i = i + 1;
    }
    let t = default_type(arg0(e)[N_TYPE]);
    i = 0;
    while i < n {
        reconvert(vec_get(args, i), t);
        i = i + 1;
    }
    if !is_numeric_t(t) && kind_of(t) != K_STRING {
        err_type(pos, "cannot compare ", t, "");
    }
    // acc := a; if b < acc { acc = b }  (compiled to csel)
    let stmts = vec_new();
    let acc = temp(pos, arg0(e), t);
    vec_push(stmts, acc);
    let op = "<";
    if streq(name, "max") {
        op = ">";
    }
    i = 1;
    while i < n {
        let v = temp(pos, vec_get(args, i), t);
        vec_push(stmts, v);
        let cond = mk_bin(pos, op, sym_ref_node(pos, v[LET_SYM]), sym_ref_node(pos, acc[LET_SYM]), ty_bool);
        if kind_of(t) == K_STRING {
            cond = mk_bin(pos, op, rt_call(pos, "rt_str_cmp", args2(sym_ref_node(pos, v[LET_SYM]), sym_ref_node(pos, acc[LET_SYM])), ty_int), mk_int(pos, 0, ty_int), ty_bool);
        }
        let ifs = node_new(ST_IF, pos);
        ifs[IF_COND] = cond;
        ifs[IF_THEN] = empty_block(pos);
        vec_push(ifs[IF_THEN][BLK_STMTS], assign_stmt(pos, sym_ref_node(pos, acc[LET_SYM]), sym_ref_node(pos, v[LET_SYM])));
        vec_push(stmts, ifs);
        i = i + 1;
    }
    replace_node(e, mk_seq(pos, stmts, sym_ref_node(pos, acc[LET_SYM]), t));
    return t;
}

// lower_keep deep-copies a value into the core's long-lived ingot heap. The result may
// only be stored straight into long-lived memory (checked by the region pass).
// type_has_dyn reports whether a value of t holds a dyn value (a dyn field, element or
// optional), depth-limited so a recursive type stays finite.
fn type_has_dyn(t, depth) {
    if depth > 8 {
        return 0;
    }
    let k = kind_of(t);
    if k == K_DYN {
        return 1;
    }
    if k == K_OPT || k == K_SLICE {
        return type_has_dyn(t[TY_ELEM], depth + 1);
    }
    if k == K_MAP {
        return type_has_dyn(t[TY_KEY], depth + 1) || type_has_dyn(t[TY_ELEM], depth + 1);
    }
    if k == K_STRUCT {
        let i = 0;
        while i < t[TY_FIELDS][VEC_LEN] {
            if type_has_dyn(field_type(t, i), depth + 1) {
                return 1;
            }
            i = i + 1;
        }
    }
    return 0;
}

fn lower_keep(e, want) {
    let pos = e[N_POS];
    let x = arg0(e);
    let t = chk(x, want);
    if is_untyped(t) {
        t = reconvert(x, default_type(t));
    }
    if kind_of(t) == K_DYN || type_has_dyn(t, 0) {
        let f = keep_fn(t);
        let c = node_new(EX_CALL, pos);
        c[CALL_NAME] = f[F_QNAME];
        c[CALL_ARGS] = args1(x);
        c[CALL_FN] = f;
        c[N_TYPE] = t;
        c[N_REGION] = R_OWNED;
        replace_node(e, c);
        return t;
    }
    if kind_of(t) == K_FUNC {
        let c = rt_call(pos, "rt_keep_closure", args1(x), t);
        c[N_REGION] = R_OWNED;
        replace_node(e, c);
        return t;
    }
    if !is_ref(t) {
        replace_node(e, x);
        return t;
    }
    let f = keep_fn(t);
    let c = node_new(EX_CALL, pos);
    c[CALL_NAME] = f[F_QNAME];
    c[CALL_ARGS] = args1(x);
    c[CALL_FN] = f;
    c[N_TYPE] = t;
    c[N_REGION] = R_OWNED;
    replace_node(e, c);
    return t;
}

// ---- argo: a JSON encoder generated for each type ----

var argo_types;
var argo_fns;

fn lower_argo_put(e) {
    let pos = e[N_POS];
    let args = e[CALL_ARGS];
    if args[VEC_LEN] != 2 {
        err_at(pos, "argo.Put takes a []u8 buffer and a value");
        return ty_void;
    }
    let b = vec_get(args, 0);
    if !unwrap_mut(b) && !ck_legacy {
        err_at(b[N_POS], "argo.Put appends to its buffer: write mut before it");
    }
    let bt = chk(b, 0);
    if kind_of(bt) != K_SLICE || bt[TY_ELEM] != ty_byte {
        err_type(pos, "argo.Put writes into a []u8, not ", bt, "");
        return ty_void;
    }
    let v = vec_get(args, 1);
    let t = chk(v, 0);
    if is_untyped(t) {
        t = reconvert(v, default_type(t));
    }
    let f = argo_fn(pos, t);
    if !f {
        return ty_void;
    }
    replace_node(e, call_fn(pos, f, args2(b, v), ty_void));
    return ty_void;
}

fn call_fn(pos, f, args, t) {
    let c = node_new(EX_CALL, pos);
    c[CALL_NAME] = f[F_QNAME];
    c[CALL_ARGS] = args;
    c[CALL_FN] = f;
    c[N_TYPE] = t;
    return c;
}

fn argo_lib(pos, name) {
    let f = find_fn(name);
    if !f {
        err_quoted(pos, "argo.Put needs package argo (", name, " is missing): import \"argo\"");
    }
    return f;
}

// argo_emit appends a call that writes x (of type t) to buffer b.
fn argo_emit(pos, body, b, x, t) {
    let k = kind_of(t);
    let bref = sym_ref_node(pos, b);
    if k == K_STRING {
        vec_push(body, expr_stmt(call_fn(pos, argo_lib(pos, "argo.wstr"), args2(bref, x), ty_void)));
    } else if k == K_BOOL {
        vec_push(body, expr_stmt(call_fn(pos, argo_lib(pos, "argo.wbool"), args2(bref, x), ty_void)));
    } else if is_f32(t) {
        vec_push(body, expr_stmt(call_fn(pos, argo_lib(pos, "argo.wfloat32"), args2(bref, x), ty_void)));
    } else if is_float_t(t) {
        vec_push(body, expr_stmt(call_fn(pos, argo_lib(pos, "argo.wfloat"), args2(bref, x), ty_void)));
    } else if k == K_INT && !t[TY_SIGNED] {
        vec_push(body, expr_stmt(call_fn(pos, argo_lib(pos, "argo.wuint"), args2(bref, mk_conv(pos, x, CV_SAME, ty_u64)), ty_void)));
    } else if k == K_INT {
        vec_push(body, expr_stmt(call_fn(pos, argo_lib(pos, "argo.wint"), args2(bref, mk_conv(pos, x, CV_SAME, ty_int)), ty_void)));
    } else {
        let f = argo_fn(pos, t);
        if f {
            vec_push(body, expr_stmt(call_fn(pos, f, args2(bref, x), ty_void)));
        }
    }
}

fn argo_raw(pos, body, b, text) {
    vec_push(body, expr_stmt(rt_call(pos, "rt_append_str", args2(sym_ref_node(pos, b), lit_string(pos, text)), ty_byte_slice())));
}

fn ty_byte_slice() {
    return slice_of(ty_byte);
}

// argo_fn returns (generating on first use) argo$N(b mut []u8, x T), the encoder for T.
fn argo_fn(pos, t) {
    if !argo_types {
        argo_types = vec_new();
        argo_fns = vec_new();
    }
    let i = 0;
    while i < argo_types[VEC_LEN] {
        if vec_get(argo_types, i) == t {
            return vec_get(argo_fns, i);
        }
        i = i + 1;
    }
    let k = kind_of(t);
    if !(k == K_STRUCT || k == K_SLICE || k == K_MAP || k == K_OPT || k == K_ERROR || k == K_STRING || k == K_INT || k == K_BOOL || is_float_t(t)) {
        err_type(pos, "argo cannot encode values of type ", t, "");
        return 0;
    }
    if k == K_MAP && kind_of(t[TY_KEY]) != K_STRING && kind_of(t[TY_KEY]) != K_INT {
        err_type(pos, "argo encodes maps with str or integer keys, not ", t, "");
        return 0;
    }
    lifted_count = lifted_count + 1;
    let f = fn_new(0, "argo");
    let nb = buf_new();
    buf_str(nb, "argo$");
    buf_int(nb, lifted_count);
    buf_byte(nb, 0);
    f[F_QNAME] = nb[VEC_DATA];
    f[F_NAME] = nb[VEC_DATA];
    f[F_LIFTED] = 2;
    let bt = ty_byte_slice();
    vec_push(f[F_PARAMS], "b");
    vec_push(f[F_PARAMS], "x");
    vec_push(f[F_PTYPES], bt);
    vec_push(f[F_PTYPES], t);
    vec_push(f[F_MUTS], 1);
    vec_push(f[F_MUTS], 0);
    f[F_TYPE] = func_of(f[F_PTYPES], f[F_RTYPES], 0);
    f[F_LOCALS] = vec_new();
    f[F_BODY] = empty_block(0);
    vec_push(argo_types, t);
    vec_push(argo_fns, f);
    vec_push(prog_fns, f);
    let saved_fn = ck_fn;
    ck_fn = f;
    let b = sym_new(SYM_LOCAL, "b", 0);
    b[S_TYPE] = bt;
    b[S_SLOT] = 0;
    b[S_MUT] = 1;
    let x = sym_new(SYM_LOCAL, "x", 0);
    x[S_TYPE] = t;
    x[S_SLOT] = 1;
    f[F_SLOTS] = 2;
    vec_push(f[F_LOCALS], b);
    vec_push(f[F_LOCALS], x);
    let body = f[F_BODY][BLK_STMTS];
    if k == K_STRUCT && t[TY_ENUM] {
        // "Name" for a variant without data, {"Name":{"field":...}} for one with data.
        let vs = t[TY_ENUM];
        let vi = 0;
        while vi < vs[VEC_LEN] {
            let v = vec_get(vs, vi);
            let ifs = node_new(ST_IF, pos);
            ifs[IF_COND] = mk_bin(pos, "==", mk_mem(pos, sym_ref_node(pos, x), 0, 0, field_offset(t, 0), ty_int), mk_int(pos, vi, ty_int), ty_bool);
            ifs[IF_THEN] = empty_block(pos);
            let vb = ifs[IF_THEN][BLK_STMTS];
            let vn = vec_get(v, 0);
            let nfv = vec_get(v, 2);
            let head = buf_new();
            if nfv == 0 {
                buf_byte(head, '"');
                buf_str(head, vn);
                buf_byte(head, '"');
                buf_byte(head, 0);
                argo_raw(pos, vb, b, head[VEC_DATA]);
            } else {
                buf_str(head, "{\"");
                buf_str(head, vn);
                buf_str(head, "\":");
                buf_byte(head, 0);
                argo_raw(pos, vb, b, head[VEC_DATA]);
                let kk = 0;
                while kk < nfv {
                    let fi2 = vec_get(v, 1) + kk;
                    let full = vec_get(vec_get(t[TY_FIELDS], fi2), 0);
                    let piece = buf_new();
                    if kk == 0 {
                        buf_byte(piece, '{');
                    } else {
                        buf_byte(piece, ',');
                    }
                    buf_byte(piece, '"');
                    buf_str(piece, full + strlen(vn) + 1);
                    buf_str(piece, "\":");
                    buf_byte(piece, 0);
                    argo_raw(pos, vb, b, piece[VEC_DATA]);
                    let ft2 = field_type(t, fi2);
                    argo_emit(pos, vb, b, mk_mem(pos, sym_ref_node(pos, x), 0, 0, field_offset(t, fi2), ft2), ft2);
                    kk = kk + 1;
                }
                argo_raw(pos, vb, b, "}}");
            }
            vec_push(body, ifs);
            vi = vi + 1;
        }
    } else if k == K_STRUCT {
        let nf = t[TY_FIELDS][VEC_LEN];
        let fi = 0;
        let lead = "{";
        while fi < nf {
            let fname = vec_get(vec_get(t[TY_FIELDS], fi), 0);
            let ft = field_type(t, fi);
            let piece = buf_new();
            buf_str(piece, lead);
            buf_byte(piece, '"');
            buf_str(piece, fname);
            buf_str(piece, "\":");
            buf_byte(piece, 0);
            argo_raw(pos, body, b, piece[VEC_DATA]);
            argo_emit(pos, body, b, mk_mem(pos, sym_ref_node(pos, x), 0, 0, field_offset(t, fi), ft), ft);
            lead = ",";
            fi = fi + 1;
        }
        if nf == 0 {
            argo_raw(pos, body, b, "{}");
        } else {
            argo_raw(pos, body, b, "}");
        }
    } else if k == K_OPT || k == K_ERROR {
        let ifs = node_new(ST_IF, pos);
        ifs[IF_COND] = mk_bin(pos, "==", sym_ref_node(pos, x), mk_int(pos, 0, t), ty_bool);
        ifs[IF_THEN] = empty_block(pos);
        argo_raw(pos, ifs[IF_THEN][BLK_STMTS], b, "null");
        let els = empty_block(pos);
        ifs[IF_ELSE] = els;
        if k == K_ERROR {
            argo_emit(pos, els[BLK_STMTS], b, mk_conv(pos, sym_ref_node(pos, x), CV_SAME, ty_string), ty_string);
        } else {
            argo_emit(pos, els[BLK_STMTS], b, mk_conv(pos, sym_ref_node(pos, x), CV_SAME, t[TY_ELEM]), t[TY_ELEM]);
        }
        vec_push(body, ifs);
    } else if k == K_SLICE {
        let et = t[TY_ELEM];
        argo_raw(pos, body, b, "[");
        let n = temp(pos, mk_hdr(pos, sym_ref_node(pos, x), 0), ty_int);
        vec_push(body, n);
        let j = declare_local(pos, "$", ty_int);
        vec_push(body, let_stmt(pos, j, mk_int(pos, 0, ty_int)));
        let w = node_new(ST_WHILE, pos);
        w[WH_COND] = mk_bin(pos, "<", sym_ref_node(pos, j), sym_ref_node(pos, n[LET_SYM]), ty_bool);
        w[WH_POST] = assign_stmt(pos, sym_ref_node(pos, j), mk_bin(pos, "+", sym_ref_node(pos, j), mk_int(pos, 1, ty_int), ty_int));
        let wb = empty_block(pos);
        w[WH_BODY] = wb;
        let comma = node_new(ST_IF, pos);
        comma[IF_COND] = mk_bin(pos, ">", sym_ref_node(pos, j), mk_int(pos, 0, ty_int), ty_bool);
        comma[IF_THEN] = empty_block(pos);
        argo_raw(pos, comma[IF_THEN][BLK_STMTS], b, ",");
        vec_push(wb[BLK_STMTS], comma);
        let el = mk_elem(pos, sym_ref_node(pos, x), sym_ref_node(pos, j), et, 0);
        el[ELEM_SAFE] = 1;
        argo_emit(pos, wb[BLK_STMTS], b, el, et);
        vec_push(body, w);
        argo_raw(pos, body, b, "]");
    } else if k == K_MAP {
        argo_raw(pos, body, b, "{");
        let first = declare_local(pos, "$", ty_bool);
        vec_push(body, let_stmt(pos, first, mk_int(pos, 1, ty_bool)));
        let slots = temp(pos, rt_call(pos, "rt_map_slots", args1(sym_ref_node(pos, x)), ty_int), ty_int);
        vec_push(body, slots);
        let j2 = declare_local(pos, "$", ty_int);
        vec_push(body, let_stmt(pos, j2, mk_int(pos, 0, ty_int)));
        let w2 = node_new(ST_WHILE, pos);
        w2[WH_COND] = mk_bin(pos, "<", sym_ref_node(pos, j2), sym_ref_node(pos, slots[LET_SYM]), ty_bool);
        w2[WH_POST] = assign_stmt(pos, sym_ref_node(pos, j2), mk_bin(pos, "+", sym_ref_node(pos, j2), mk_int(pos, 1, ty_int), ty_int));
        let wb2 = empty_block(pos);
        w2[WH_BODY] = wb2;
        let live = node_new(ST_IF, pos);
        live[IF_COND] = rt_call(pos, "rt_map_live", args2(sym_ref_node(pos, x), sym_ref_node(pos, j2)), ty_bool);
        live[IF_THEN] = empty_block(pos);
        let lb = live[IF_THEN][BLK_STMTS];
        let sep = node_new(ST_IF, pos);
        sep[IF_COND] = sym_ref_node(pos, first);
        sep[IF_THEN] = empty_block(pos);
        vec_push(sep[IF_THEN][BLK_STMTS], assign_stmt(pos, sym_ref_node(pos, first), mk_int(pos, 0, ty_bool)));
        sep[IF_ELSE] = empty_block(pos);
        argo_raw(pos, sep[IF_ELSE][BLK_STMTS], b, ",");
        vec_push(lb, sep);
        let kt = t[TY_KEY];
        let kv = from_bits(rt_call(pos, "rt_map_key", args2(sym_ref_node(pos, x), sym_ref_node(pos, j2)), ty_int), kt);
        if kind_of(kt) == K_STRING {
            argo_emit(pos, lb, b, kv, kt);
        } else {
            argo_raw(pos, lb, b, "\"");
            argo_emit(pos, lb, b, kv, kt);
            argo_raw(pos, lb, b, "\"");
        }
        argo_raw(pos, lb, b, ":");
        let vt = t[TY_ELEM];
        let vv = from_bits(rt_call(pos, "rt_map_val", args2(sym_ref_node(pos, x), sym_ref_node(pos, j2)), ty_int), vt);
        argo_emit(pos, lb, b, vv, vt);
        vec_push(wb2[BLK_STMTS], live);
        vec_push(body, w2);
        argo_raw(pos, body, b, "}");
    } else {
        argo_emit(pos, body, b, sym_ref_node(pos, x), t);
    }
    ck_fn = saved_fn;
    return f;
}

// ---- argo.Get: a JSON decoder generated for each type ----

var argo_dtypes;
var argo_dfns;
var argo_ptype;

fn lower_argo_get(e) {
    let pos = e[N_POS];
    let args = e[CALL_ARGS];
    if args[VEC_LEN] != 2 {
        err_at(pos, "argo.Get takes the JSON text and a struct, slice or map to fill");
        return ty_error;
    }
    if !unwrap_mut(vec_get(args, 1)) && !ck_legacy {
        err_at(vec_get(args, 1)[N_POS], "argo.Get fills its target: write mut before it");
    }
    let s = vec_get(args, 0);
    let st = chk(s, ty_string);
    if kind_of(st) != K_STRING {
        err_type(pos, "argo.Get reads JSON from a str, not ", st, "");
        return ty_error;
    }
    let v = vec_get(args, 1);
    let t = chk(v, 0);
    let k = kind_of(t);
    if k != K_STRUCT && k != K_SLICE && k != K_MAP {
        err_type(pos, "argo.Get fills a struct, slice or map (passed by reference), not ", t, "");
        return ty_error;
    }
    let pt = argo_parser_type(pos);
    let df = argo_dfn(pos, t);
    if !pt || !df {
        return ty_error;
    }
    let stmts = vec_new();
    let p = temp(pos, call_fn(pos, argo_lib(pos, "argo.parser"), args1(s), pt), pt);
    vec_push(stmts, p);
    vec_push(stmts, expr_stmt(call_fn(pos, df, args2(sym_ref_node(pos, p[LET_SYM]), v), ty_void)));
    let fin = call_fn(pos, argo_lib(pos, "argo.finish"), args1(sym_ref_node(pos, p[LET_SYM])), ty_error);
    replace_node(e, mk_seq(pos, stmts, fin, ty_error));
    return ty_error;
}

fn argo_parser_type(pos) {
    if !argo_ptype {
        argo_ptype = find_type("argo.Parser");
        if !argo_ptype {
            err_at(pos, "argo.Get needs package argo: import \"argo\"");
        }
    }
    return argo_ptype;
}

// argo_rd is a call of reader name on parser p, of type t.
fn argo_rd(pos, p, name, t) {
    return call_fn(pos, argo_lib(pos, name), args1(sym_ref_node(pos, p)), t);
}

fn argo_err_return(pos, body, p) {
    let pt = argo_ptype;
    let fi = struct_field(pt, "err");
    let ifs = node_new(ST_IF, pos);
    ifs[IF_COND] = mk_bin(pos, "!=", mk_mem(pos, sym_ref_node(pos, p), 0, 0, field_offset(pt, fi), ty_error), mk_int(pos, 0, ty_error), ty_bool);
    ifs[IF_THEN] = empty_block(pos);
    vec_push(ifs[IF_THEN][BLK_STMTS], node_new(ST_RETURN, pos));
    vec_push(body, ifs);
}

// argo_new is a fresh value of type t with every reference field made (decode target).
fn argo_new(pos, body, t) {
    let k = kind_of(t);
    if k == K_STRING {
        return lit_string(pos, "");
    }
    if k == K_SLICE {
        return rt_call(pos, "rt_slice_make", args3(mk_int(pos, 0, ty_int), mk_int(pos, 0, ty_int), mk_int(pos, elem_size(t), ty_int)), t);
    }
    if k == K_MAP {
        return rt_call(pos, "rt_map_make", args1(mk_int(pos, map_str_keys(t[TY_KEY]), ty_int)), t);
    }
    if k != K_STRUCT {
        return mk_int(pos, 0, t);
    }
    if t[TY_ENUM] {
        return enum_zero(pos, body, t);
    }
    let obj = temp(pos, rt_call(pos, "rt_alloc", args1(mk_int(pos, t[TY_SIZE], ty_int)), t), t);
    vec_push(body, obj);
    let fi = 0;
    while fi < t[TY_FIELDS][VEC_LEN] {
        let ft = field_type(t, fi);
        let fk = kind_of(ft);
        if fk == K_STRING || fk == K_SLICE || fk == K_MAP || fk == K_STRUCT {
            vec_push(body, assign_stmt(pos, field_store(pos, sym_ref_node(pos, obj[LET_SYM]), t, fi), argo_new(pos, body, ft)));
        }
        fi = fi + 1;
    }
    return sym_ref_node(pos, obj[LET_SYM]);
}

var enum_zeroing;  // enums whose zero value is being built (a recursion guard)

// enum_zero is an enum's zero value: its first variant without data, else variant 0 with
// zero fields (an enum whose every variant holds itself has no finite zero value).
fn enum_zero(pos, body, t) {
    if !enum_zeroing {
        enum_zeroing = vec_new();
    }
    let vs = t[TY_ENUM];
    let vi = 0;
    while vi < vs[VEC_LEN] && vec_get(vec_get(vs, vi), 2) > 0 {
        vi = vi + 1;
    }
    if vi == vs[VEC_LEN] {
        vi = 0;
    }
    let obj = temp(pos, rt_call(pos, "rt_alloc", args1(mk_int(pos, t[TY_SIZE], ty_int)), t), t);
    vec_push(body, obj);
    vec_push(body, assign_stmt(pos, field_store(pos, sym_ref_node(pos, obj[LET_SYM]), t, 0), mk_int(pos, vi, ty_int)));
    let v = vec_get(vs, vi);
    let i = 0;
    while i < enum_zeroing[VEC_LEN] {
        if vec_get(enum_zeroing, i) == t {
            err_type(pos, "enum ", t, " has no zero value: give it a variant without data");
            return sym_ref_node(pos, obj[LET_SYM]);
        }
        i = i + 1;
    }
    vec_push(enum_zeroing, t);
    let k = 0;
    while k < vec_get(v, 2) {
        let fi = vec_get(v, 1) + k;
        let ft = field_type(t, fi);
        let fk = kind_of(ft);
        if fk == K_STRING || fk == K_SLICE || fk == K_MAP || fk == K_STRUCT {
            vec_push(body, assign_stmt(pos, field_store(pos, sym_ref_node(pos, obj[LET_SYM]), t, fi), argo_new(pos, body, ft)));
        }
        k = k + 1;
    }
    enum_zeroing[VEC_LEN] = enum_zeroing[VEC_LEN] - 1;
    return sym_ref_node(pos, obj[LET_SYM]);
}

// argo_value appends statements that decode one value of type t and returns it, or 0
// when t cannot be decoded (an error is reported).
fn argo_value(pos, body, p, t) {
    let k = kind_of(t);
    if k == K_STRING {
        return argo_rd(pos, p, "argo.rstr", ty_string);
    }
    if k == K_BOOL {
        return argo_rd(pos, p, "argo.rbool", ty_bool);
    }
    if is_f32(t) {
        return argo_rd(pos, p, "argo.rfloat32", ty_f32);
    }
    if is_float_t(t) {
        return argo_rd(pos, p, "argo.rfloat", ty_float);
    }
    if k == K_INT {
        let w = t[TY_WIDTH];
        if w == 8 && t[TY_SIGNED] {
            return argo_rd(pos, p, "argo.rint", ty_int);
        }
        if w == 8 {
            return argo_rd(pos, p, "argo.ruint", ty_u64);
        }
        let lo = 0;
        let hi = (1 << (8 * w)) - 1;
        if t[TY_SIGNED] {
            lo = 0 - (1 << (8 * w - 1));
            hi = (1 << (8 * w - 1)) - 1;
        }
        let c = call_fn(pos, argo_lib(pos, "argo.rintr"), args3(sym_ref_node(pos, p), mk_int(pos, lo, ty_int), mk_int(pos, hi, ty_int)), ty_int);
        return mk_conv(pos, c, CV_INT, t);
    }
    if k == K_STRUCT || k == K_SLICE || k == K_MAP {
        let obj = temp(pos, argo_new(pos, body, t), t);
        vec_push(body, obj);
        let df = argo_dfn(pos, t);
        if !df {
            return 0;
        }
        vec_push(body, expr_stmt(call_fn(pos, df, args2(sym_ref_node(pos, p), sym_ref_node(pos, obj[LET_SYM])), ty_void)));
        return sym_ref_node(pos, obj[LET_SYM]);
    }
    if k == K_OPT {
        let et = t[TY_ELEM];
        if !is_ref(et) || kind_of(et) == K_FUNC {
            err_type(pos, "argo.Get decodes optionals of references only, not ", t, "");
            return 0;
        }
        let out = declare_local(pos, "$", t);
        vec_push(body, let_stmt(pos, out, mk_int(pos, 0, t)));
        let ifs = node_new(ST_IF, pos);
        ifs[IF_COND] = mk_unot(pos, argo_rd(pos, p, "argo.rnull", ty_bool));
        ifs[IF_THEN] = empty_block(pos);
        let inner = argo_value(pos, ifs[IF_THEN][BLK_STMTS], p, et);
        if !inner {
            return 0;
        }
        vec_push(ifs[IF_THEN][BLK_STMTS], assign_stmt(pos, sym_ref_node(pos, out), mk_conv(pos, inner, CV_SAME, t)));
        vec_push(body, ifs);
        return sym_ref_node(pos, out);
    }
    err_type(pos, "argo.Get cannot decode values of type ", t, "");
    return 0;
}

fn mk_unot(pos, x) {
    let u = node_new(EX_UNARY, pos);
    u[UN_OP] = "!";
    u[UN_X] = x;
    u[N_TYPE] = ty_bool;
    return u;
}

fn forever(pos) {
    let w = node_new(ST_WHILE, pos);
    w[WH_COND] = mk_int(pos, 1, ty_bool);
    w[WH_BODY] = empty_block(pos);
    return w;
}

// argo_more ends a loop body: if !argo.rmore(p, close) { break }.
fn argo_more(pos, body, p, close) {
    let ifs = node_new(ST_IF, pos);
    ifs[IF_COND] = mk_unot(pos, call_fn(pos, argo_lib(pos, "argo.rmore"), args2(sym_ref_node(pos, p), mk_int(pos, close, ty_byte)), ty_bool));
    ifs[IF_THEN] = empty_block(pos);
    vec_push(ifs[IF_THEN][BLK_STMTS], node_new(ST_BREAK, pos));
    vec_push(body, ifs);
}

// argo_denum decodes into enum x: renum gives the variant name (and whether it came as
// {"Name": payload}); the tag is set and the payload's fields are read by name.
fn argo_denum(pos, body, p, x, t) {
    let cm = node_new(ST_CALLMULTI, pos);
    cm[CM_CALL] = call_fn(pos, argo_lib(pos, "argo.renum"), args1(sym_ref_node(pos, p)), ty_void);
    let nm = declare_local(pos, "$", ty_string);
    let boxed = declare_local(pos, "$", ty_bool);
    cm[CM_SYMS] = vec_new();
    vec_push(cm[CM_SYMS], nm);
    vec_push(cm[CM_SYMS], boxed);
    vec_push(body, cm);
    argo_err_return(pos, body, p);
    let vs = t[TY_ENUM];
    let first = 0;
    let last = 0;
    let vi = 0;
    while vi < vs[VEC_LEN] {
        let v = vec_get(vs, vi);
        let vn = vec_get(v, 0);
        let nfv = vec_get(v, 2);
        let br = node_new(ST_IF, pos);
        br[IF_COND] = rt_call(pos, "rt_str_eq", args2(sym_ref_node(pos, nm), lit_string(pos, vn)), ty_bool);
        br[IF_THEN] = empty_block(pos);
        let bb = br[IF_THEN][BLK_STMTS];
        vec_push(bb, assign_stmt(pos, field_store(pos, sym_ref_node(pos, x), t, 0), mk_int(pos, vi, ty_int)));
        let z = 0;
        while z < nfv {
            let zf = vec_get(v, 1) + z;
            let zt = field_type(t, zf);
            let zk = kind_of(zt);
            if zk == K_STRING || zk == K_SLICE || zk == K_MAP || zk == K_STRUCT {
                vec_push(bb, assign_stmt(pos, field_store(pos, sym_ref_node(pos, x), t, zf), argo_new(pos, bb, zt)));
            }
            z = z + 1;
        }
        if nfv == 0 {
            // A bare "Name"; {"Name": anything} skips the payload.
            let ib = node_new(ST_IF, pos);
            ib[IF_COND] = sym_ref_node(pos, boxed);
            ib[IF_THEN] = empty_block(pos);
            vec_push(ib[IF_THEN][BLK_STMTS], expr_stmt(call_fn(pos, argo_lib(pos, "argo.rskip"), args1(sym_ref_node(pos, p)), ty_void)));
            vec_push(ib[IF_THEN][BLK_STMTS], expr_stmt(call_fn(pos, argo_lib(pos, "argo.rclose"), args1(sym_ref_node(pos, p)), ty_void)));
            vec_push(bb, ib);
        } else {
            let nb = node_new(ST_IF, pos);
            nb[IF_COND] = mk_unot(pos, sym_ref_node(pos, boxed));
            nb[IF_THEN] = empty_block(pos);
            vec_push(nb[IF_THEN][BLK_STMTS], expr_stmt(call_fn(pos, argo_lib(pos, "argo.rvariant"), args2(sym_ref_node(pos, p), sym_ref_node(pos, nm)), ty_void)));
            vec_push(nb[IF_THEN][BLK_STMTS], node_new(ST_RETURN, pos));
            vec_push(bb, nb);
            let ob = node_new(ST_IF, pos);
            ob[IF_COND] = argo_rd(pos, p, "argo.robj", ty_bool);
            ob[IF_THEN] = empty_block(pos);
            let w = forever(pos);
            vec_push(ob[IF_THEN][BLK_STMTS], w);
            let wb = w[WH_BODY][BLK_STMTS];
            let key = temp(pos, argo_rd(pos, p, "argo.rkey", ty_string), ty_string);
            vec_push(wb, key);
            argo_err_return(pos, wb, p);
            let chain = 0;
            let lastf = 0;
            let kk = 0;
            while kk < nfv {
                let fi = vec_get(v, 1) + kk;
                let full = vec_get(vec_get(t[TY_FIELDS], fi), 0);
                let ft = field_type(t, fi);
                let fb = node_new(ST_IF, pos);
                fb[IF_COND] = rt_call(pos, "rt_str_eq", args2(sym_ref_node(pos, key[LET_SYM]), lit_string(pos, full + strlen(vn) + 1)), ty_bool);
                fb[IF_THEN] = empty_block(pos);
                let fbb = fb[IF_THEN][BLK_STMTS];
                let fk = kind_of(ft);
                if fk == K_STRUCT || fk == K_SLICE || fk == K_MAP {
                    let df = argo_dfn(pos, ft);
                    if df {
                        vec_push(fbb, expr_stmt(call_fn(pos, df, args2(sym_ref_node(pos, p), mk_mem(pos, sym_ref_node(pos, x), 0, 0, field_offset(t, fi), ft)), ty_void)));
                    }
                } else {
                    let val = argo_value(pos, fbb, p, ft);
                    if val {
                        vec_push(fbb, assign_stmt(pos, field_store(pos, sym_ref_node(pos, x), t, fi), val));
                    }
                }
                if lastf {
                    let eb = empty_block(pos);
                    vec_push(eb[BLK_STMTS], fb);
                    lastf[IF_ELSE] = eb;
                } else {
                    chain = fb;
                }
                lastf = fb;
                kk = kk + 1;
            }
            let sb = empty_block(pos);
            vec_push(sb[BLK_STMTS], expr_stmt(call_fn(pos, argo_lib(pos, "argo.rskip"), args1(sym_ref_node(pos, p)), ty_void)));
            lastf[IF_ELSE] = sb;
            vec_push(wb, chain);
            argo_more(pos, wb, p, '}');
            vec_push(bb, ob);
            vec_push(bb, expr_stmt(call_fn(pos, argo_lib(pos, "argo.rclose"), args1(sym_ref_node(pos, p)), ty_void)));
        }
        if last {
            let eb2 = empty_block(pos);
            vec_push(eb2[BLK_STMTS], br);
            last[IF_ELSE] = eb2;
        } else {
            first = br;
        }
        last = br;
        vi = vi + 1;
    }
    let unk = empty_block(pos);
    vec_push(unk[BLK_STMTS], expr_stmt(call_fn(pos, argo_lib(pos, "argo.rvariant"), args2(sym_ref_node(pos, p), sym_ref_node(pos, nm)), ty_void)));
    last[IF_ELSE] = unk;
    vec_push(body, first);
}

// argo_dfn returns (generating on first use) argo$dN(p mut argo.Parser, x mut T), which
// fills x from the JSON value at p.
fn argo_dfn(pos, t) {
    if !argo_dtypes {
        argo_dtypes = vec_new();
        argo_dfns = vec_new();
    }
    let i = 0;
    while i < argo_dtypes[VEC_LEN] {
        if vec_get(argo_dtypes, i) == t {
            return vec_get(argo_dfns, i);
        }
        i = i + 1;
    }
    let pt = argo_parser_type(pos);
    if !pt {
        return 0;
    }
    let k = kind_of(t);
    if k == K_MAP && kind_of(t[TY_KEY]) != K_STRING {
        err_type(pos, "argo.Get decodes maps with str keys, not ", t, "");
        return 0;
    }
    lifted_count = lifted_count + 1;
    let f = fn_new(0, "argo");
    let nb = buf_new();
    buf_str(nb, "argo$d");
    buf_int(nb, lifted_count);
    buf_byte(nb, 0);
    f[F_QNAME] = nb[VEC_DATA];
    f[F_NAME] = nb[VEC_DATA];
    f[F_LIFTED] = 2;
    vec_push(f[F_PARAMS], "p");
    vec_push(f[F_PARAMS], "x");
    vec_push(f[F_PTYPES], pt);
    vec_push(f[F_PTYPES], t);
    vec_push(f[F_MUTS], 1);
    vec_push(f[F_MUTS], 1);
    f[F_TYPE] = func_of(f[F_PTYPES], f[F_RTYPES], 0);
    f[F_LOCALS] = vec_new();
    f[F_BODY] = empty_block(0);
    vec_push(argo_dtypes, t);
    vec_push(argo_dfns, f);
    vec_push(prog_fns, f);
    let saved_fn = ck_fn;
    ck_fn = f;
    let p = sym_new(SYM_LOCAL, "p", 0);
    p[S_TYPE] = pt;
    p[S_SLOT] = 0;
    p[S_MUT] = 1;
    let x = sym_new(SYM_LOCAL, "x", 0);
    x[S_TYPE] = t;
    x[S_SLOT] = 1;
    x[S_MUT] = 1;
    f[F_SLOTS] = 2;
    vec_push(f[F_LOCALS], p);
    vec_push(f[F_LOCALS], x);
    let body = f[F_BODY][BLK_STMTS];
    if k == K_STRUCT && t[TY_ENUM] {
        argo_denum(pos, body, p, x, t);
    } else if k == K_STRUCT {
        let ifs = node_new(ST_IF, pos);
        ifs[IF_COND] = mk_unot(pos, argo_rd(pos, p, "argo.robj", ty_bool));
        ifs[IF_THEN] = empty_block(pos);
        vec_push(ifs[IF_THEN][BLK_STMTS], node_new(ST_RETURN, pos));
        vec_push(body, ifs);
        let w = forever(pos);
        vec_push(body, w);
        let wb = w[WH_BODY][BLK_STMTS];
        let key = temp(pos, argo_rd(pos, p, "argo.rkey", ty_string), ty_string);
        vec_push(wb, key);
        argo_err_return(pos, wb, p);
        let chain = 0;
        let last = 0;
        let fi = 0;
        while fi < t[TY_FIELDS][VEC_LEN] {
            let fname = vec_get(vec_get(t[TY_FIELDS], fi), 0);
            let ft = field_type(t, fi);
            let br = node_new(ST_IF, pos);
            br[IF_COND] = rt_call(pos, "rt_str_eq", args2(sym_ref_node(pos, key[LET_SYM]), lit_string(pos, fname)), ty_bool);
            br[IF_THEN] = empty_block(pos);
            let bb = br[IF_THEN][BLK_STMTS];
            let fk = kind_of(ft);
            if fk == K_STRUCT || fk == K_SLICE || fk == K_MAP {
                // Fill the object the field already holds.
                let df = argo_dfn(pos, ft);
                if df {
                    vec_push(bb, expr_stmt(call_fn(pos, df, args2(sym_ref_node(pos, p), mk_mem(pos, sym_ref_node(pos, x), 0, 0, field_offset(t, fi), ft)), ty_void)));
                }
            } else {
                let val = argo_value(pos, bb, p, ft);
                if val {
                    vec_push(bb, assign_stmt(pos, field_store(pos, sym_ref_node(pos, x), t, fi), val));
                }
            }
            if last {
                let eb = empty_block(pos);
                vec_push(eb[BLK_STMTS], br);
                last[IF_ELSE] = eb;
            } else {
                chain = br;
            }
            last = br;
            fi = fi + 1;
        }
        let skip = expr_stmt(call_fn(pos, argo_lib(pos, "argo.rskip"), args1(sym_ref_node(pos, p)), ty_void));
        if last {
            let sb = empty_block(pos);
            vec_push(sb[BLK_STMTS], skip);
            last[IF_ELSE] = sb;
            vec_push(wb, chain);
        } else {
            vec_push(wb, skip);
        }
        argo_more(pos, wb, p, '}');
    } else if k == K_SLICE {
        let et = t[TY_ELEM];
        let ifs2 = node_new(ST_IF, pos);
        ifs2[IF_COND] = mk_unot(pos, argo_rd(pos, p, "argo.rarr", ty_bool));
        ifs2[IF_THEN] = empty_block(pos);
        vec_push(ifs2[IF_THEN][BLK_STMTS], node_new(ST_RETURN, pos));
        vec_push(body, ifs2);
        let w2 = forever(pos);
        vec_push(body, w2);
        let wb2 = w2[WH_BODY][BLK_STMTS];
        let ev = argo_value(pos, wb2, p, et);
        if ev {
            vec_push(wb2, expr_stmt(rt_call(pos, "rt_append", args3(sym_ref_node(pos, x), elem_bits(ev, t[TY_ELEM]), mk_int(pos, elem_size(t), ty_int)), t)));
        }
        argo_err_return(pos, wb2, p);
        argo_more(pos, wb2, p, ']');
    } else if k == K_MAP {
        let ifs3 = node_new(ST_IF, pos);
        ifs3[IF_COND] = mk_unot(pos, argo_rd(pos, p, "argo.robj", ty_bool));
        ifs3[IF_THEN] = empty_block(pos);
        vec_push(ifs3[IF_THEN][BLK_STMTS], node_new(ST_RETURN, pos));
        vec_push(body, ifs3);
        let w3 = forever(pos);
        vec_push(body, w3);
        let wb3 = w3[WH_BODY][BLK_STMTS];
        let mk = temp(pos, argo_rd(pos, p, "argo.rkey", ty_string), ty_string);
        vec_push(wb3, mk);
        argo_err_return(pos, wb3, p);
        let mv = argo_value(pos, wb3, p, t[TY_ELEM]);
        if mv {
            vec_push(wb3, expr_stmt(rt_call(pos, "rt_map_set", args3(sym_ref_node(pos, x), sym_ref_node(pos, mk[LET_SYM]), to_bits(mv)), ty_void)));
        }
        argo_err_return(pos, wb3, p);
        argo_more(pos, wb3, p, '}');
    }
    ck_fn = saved_fn;
    return f;
}

// ---- say: formatting without interfaces ----

fn is_say_func(m) {
    return streq(m, "Line") || streq(m, "Text") || streq(m, "Out") || streq(m, "Fmt") || streq(m, "Str") || streq(m, "Fault") || streq(m, "To") || streq(m, "LineTo");
}

// say_arg formats one argument by its static type: prefix + "i", "s", "f", ...
// say_type_has_dyn reports whether a struct's fields (or a container's element) hold a
// dyn value, which has no formatter until the table lands. The depth limit keeps a
// recursive type (an enum holding itself) finite; a deeper dyn is still caught by
// say_arg when the recursion reaches it.
fn say_type_has_dyn(t) {
    return say_type_has_dyn_at(t, 0);
}

fn say_type_has_dyn_at(t, depth) {
    if depth > 8 {
        return 0;
    }
    let k = kind_of(t);
    if k == K_DYN {
        return 1;
    }
    if k == K_OPT || k == K_SLICE {
        return say_type_has_dyn_at(t[TY_ELEM], depth + 1);
    }
    if k == K_MAP {
        return say_type_has_dyn_at(t[TY_KEY], depth + 1) || say_type_has_dyn_at(t[TY_ELEM], depth + 1);
    }
    if k == K_STRUCT {
        let i = 0;
        while i < t[TY_FIELDS][VEC_LEN] {
            if say_type_has_dyn_at(field_type(t, i), depth + 1) {
                return 1;
            }
            i = i + 1;
        }
    }
    return 0;
}

fn say_arg(a, prefix) {
    let pos = a[N_POS];
    let t = default_type(chk(a, 0));
    check_value(pos, t);
    if is_untyped(a[N_TYPE]) {
        reconvert(a, t);
    }
    let k = kind_of(t);
    let suffix = "i";
    if k == K_STRING {
        suffix = "s";
    } else if k == K_FLOAT {
        suffix = "f";
        if is_f32(t) {
            suffix = "f32";
        }
    } else if k == K_BOOL {
        suffix = "b";
    } else if k == K_ERROR {
        suffix = "e";
    } else if is_unsigned_t(t) {
        suffix = "u";
    } else if k == K_SLICE {
        let et = t[TY_ELEM];
        let ek = kind_of(et);
        if say_type_has_dyn(et) {
            err_at(pos, "cannot format a slice of dyn values: give the shape a method that formats (#141)");
            return ty_void;
        }
        if ek == K_STRING {
            suffix = "sls";
        } else if ek == K_FLOAT {
            suffix = "slf";
            if is_f32(et) {
                suffix = "slf32";
            }
        } else if ek == K_BOOL {
            suffix = "slt";
        } else if ek == K_INT {
            return rt_call(pos, str_cat3(prefix, "slint", ""), args3(a, mk_int(pos, type_width(et), ty_int), mk_int(pos, et[TY_SIGNED], ty_int)), ty_void);
        } else if ek == K_STRUCT && et[TY_ENUM] {
            return say_enum_slice(a, t, prefix);
        } else if ek == K_STRUCT {
            return say_struct_slice(a, t, prefix);
        } else {
            suffix = "slp";
        }
    } else if k == K_STRUCT || k == K_OPT {
        let st = t;
        if k == K_OPT {
            if kind_of(t[TY_ELEM]) == K_DYN {
                err_at(pos, "cannot format a dyn value: give the shape a method that formats (#141)");
                return ty_void;
            }
            st = t[TY_ELEM];
        }
        if say_type_has_dyn(st) {
            err_at(pos, "cannot format a value holding a dyn value: give the shape a method that formats (#141)");
            return ty_void;
        }
        return say_struct(a, st, prefix);
    } else if k == K_MAP && key_composite(t[TY_KEY]) {
        return say_map_keyed(a, t, prefix);
    } else if k == K_MAP {
        return say_map_sorted(a, t, prefix);
    } else if k == K_DYN {
        err_at(pos, "cannot format a dyn value: give the shape a method that formats (#141)");
        return ty_void;
    } else if k != K_INT && k != K_UINT {
        suffix = "p";
    }
    let x = a;
    if type_width(t) < 8 && k == K_INT {
        x = mk_conv(pos, a, CV_SAME, ty_int);
    }
    return rt_call(pos, str_cat3(prefix, suffix, ""), args1(x), ty_void);
}

// say_struct prints {a b c} by formatting each field in turn (nil optionals print <nil>).
fn say_struct(a, t, prefix) {
    if t[TY_ENUM] {
        return say_enum(a, t, prefix);
    }
    let pos = a[N_POS];
    let stmts = vec_new();
    let obj = temp(pos, mk_conv(pos, a, CV_SAME, ty_int), ty_int);
    vec_push(stmts, obj);
    vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, "argsep", ""), vec_new(), ty_void)));
    let nonnil = node_new(ST_IF, pos);
    nonnil[IF_COND] = mk_bin(pos, "==", sym_ref_node(pos, obj[LET_SYM]), mk_int(pos, 0, ty_int), ty_bool);
    nonnil[IF_THEN] = empty_block(pos);
    vec_push(nonnil[IF_THEN][BLK_STMTS], expr_stmt(rt_call(pos, str_cat3(prefix, "raw", ""), args1(lit_string(pos, "<nil>")), ty_void)));
    let body = empty_block(pos);
    nonnil[IF_ELSE] = body;
    vec_push(body[BLK_STMTS], expr_stmt(call_fn(pos, say_struct_fn(t, prefix), args1(mk_conv(pos, sym_ref_node(pos, obj[LET_SYM]), CV_SAME, t)), ty_void)));
    vec_push(stmts, nonnil);
    vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, "argend", ""), vec_new(), ty_void)));
    return mk_seq(pos, stmts, mk_int(pos, 0, ty_int), ty_void);
}

var say_struct_keys;  // [type, prefix] of each generated struct printer
var say_struct_fns;

// field_name is the declared name of field i of struct type t.
fn field_name(t, i) {
    return vec_get(vec_get(t[TY_FIELDS], i), 0);
}

// say_struct_fn returns the generated function that prints one (non-nil) struct of type t as
// {v1 v2 ...}, or {name:v1 name:v2 ...} under %+v. It is a function of its own, not inline code, so
// a struct that holds itself through a slice (Node with kids []Node) terminates: the printer is
// registered before its body is built, and the recursion happens when the program runs. A field
// of struct or enum type is printed by the printer of its own type, a slice of structs element by
// element; an optional field (a pointer in effect) stays an address, as Go prints a pointer field.
fn say_struct_fn(t, prefix) {
    if !say_struct_keys {
        say_struct_keys = vec_new();
        say_struct_fns = vec_new();
    }
    let i = 0;
    while i < say_struct_keys[VEC_LEN] {
        let kp = vec_get(say_struct_keys, i);
        if vec_get(kp, 0) == t && streq(vec_get(kp, 1), prefix) {
            return vec_get(say_struct_fns, i);
        }
        i = i + 1;
    }
    let names = vec_new();
    vec_push(names, "x");
    let types = vec_new();
    vec_push(types, t);
    let f = lifted_fn("say", names, types, vec_new());
    let kp2 = vec_new();
    vec_push(kp2, t);
    vec_push(kp2, prefix);
    vec_push(say_struct_keys, kp2);
    vec_push(say_struct_fns, f);
    let saved_fn = ck_fn;
    ck_fn = f;
    let pos = 0;
    let x = vec_get(f[F_LOCALS], 0);
    let body = f[F_BODY][BLK_STMTS];
    vec_push(body, expr_stmt(rt_call(pos, str_cat3(prefix, "raw", ""), args1(lit_string(pos, "{")), ty_void)));
    let fs = t[TY_FIELDS];
    i = 0;
    while i < fs[VEC_LEN] {
        if i > 0 {
            vec_push(body, expr_stmt(rt_call(pos, str_cat3(prefix, "raw", ""), args1(lit_string(pos, " ")), ty_void)));
        }
        let named = node_new(ST_IF, pos);
        named[IF_COND] = rt_call(pos, "rt_fmt_plusv", vec_new(), ty_bool);
        named[IF_THEN] = empty_block(pos);
        vec_push(named[IF_THEN][BLK_STMTS], expr_stmt(rt_call(pos, str_cat3(prefix, "raw", ""), args1(lit_string(pos, str_cat3(field_name(t, i), ":", ""))), ty_void)));
        vec_push(body, named);
        let ft = field_type(t, i);
        let fv = mk_mem(pos, sym_ref_node(pos, x), 0, 0, field_offset(t, i), ft);
        if kind_of(ft) == K_STRUCT && ft[TY_ENUM] {
            vec_push(body, expr_stmt(call_fn(pos, say_enum_fn(ft, prefix), args1(fv), ty_void)));
        } else if kind_of(ft) == K_STRUCT {
            vec_push(body, expr_stmt(call_fn(pos, say_struct_fn(ft, prefix), args1(fv), ty_void)));
        } else if kind_of(ft) == K_OPT {
            vec_push(body, expr_stmt(rt_call(pos, str_cat3(prefix, "p", ""), args1(mk_conv(pos, fv, CV_SAME, ty_int)), ty_void)));
        } else {
            vec_push(body, expr_stmt(say_arg(fv, prefix)));
        }
        i = i + 1;
    }
    vec_push(body, expr_stmt(rt_call(pos, str_cat3(prefix, "raw", ""), args1(lit_string(pos, "}")), ty_void)));
    ck_fn = saved_fn;
    return f;
}

// say_struct_slice prints [{...} {...}] with each element through its struct's printer.
fn say_struct_slice(a, t, prefix) {
    let pos = a[N_POS];
    let et = t[TY_ELEM];
    let stmts = vec_new();
    vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, "argsep", ""), vec_new(), ty_void)));
    let sl = temp(pos, a, t);
    vec_push(stmts, sl);
    let n = temp(pos, mk_hdr(pos, sym_ref_node(pos, sl[LET_SYM]), 0), ty_int);
    vec_push(stmts, n);
    vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, "raw", ""), args1(lit_string(pos, "[")), ty_void)));
    let j = declare_local(pos, "$", ty_int);
    vec_push(stmts, let_stmt(pos, j, mk_int(pos, 0, ty_int)));
    let w = node_new(ST_WHILE, pos);
    w[WH_COND] = mk_bin(pos, "<", sym_ref_node(pos, j), sym_ref_node(pos, n[LET_SYM]), ty_bool);
    w[WH_POST] = assign_stmt(pos, sym_ref_node(pos, j), mk_bin(pos, "+", sym_ref_node(pos, j), mk_int(pos, 1, ty_int), ty_int));
    let wb = empty_block(pos);
    w[WH_BODY] = wb;
    let sep = node_new(ST_IF, pos);
    sep[IF_COND] = mk_bin(pos, ">", sym_ref_node(pos, j), mk_int(pos, 0, ty_int), ty_bool);
    sep[IF_THEN] = empty_block(pos);
    vec_push(sep[IF_THEN][BLK_STMTS], expr_stmt(rt_call(pos, str_cat3(prefix, "raw", ""), args1(lit_string(pos, " ")), ty_void)));
    vec_push(wb[BLK_STMTS], sep);
    let el = mk_elem(pos, sym_ref_node(pos, sl[LET_SYM]), sym_ref_node(pos, j), et, 0);
    el[ELEM_SAFE] = 1;
    vec_push(wb[BLK_STMTS], expr_stmt(call_fn(pos, say_struct_fn(et, prefix), args1(el), ty_void)));
    vec_push(stmts, w);
    vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, "raw", ""), args1(lit_string(pos, "]")), ty_void)));
    vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, "argend", ""), vec_new(), ty_void)));
    return mk_seq(pos, stmts, mk_int(pos, 0, ty_int), ty_void);
}

var say_enum_keys;  // [type, prefix] of each generated enum printer
var say_enum_fns;

// lifted_fn starts a generated function name$N with params (names, types) and results.
fn lifted_fn(base, names, types, rtypes) {
    lifted_count = lifted_count + 1;
    let f = fn_new(0, base);
    let nb = buf_new();
    buf_str(nb, base);
    buf_byte(nb, '$');
    buf_int(nb, lifted_count);
    buf_byte(nb, 0);
    f[F_QNAME] = nb[VEC_DATA];
    f[F_NAME] = nb[VEC_DATA];
    f[F_LIFTED] = 2;
    f[F_LOCALS] = vec_new();
    let i = 0;
    while i < names[VEC_LEN] {
        vec_push(f[F_PARAMS], vec_get(names, i));
        vec_push(f[F_PTYPES], vec_get(types, i));
        vec_push(f[F_MUTS], 0);
        let ps = sym_new(SYM_LOCAL, vec_get(names, i), 0);
        ps[S_TYPE] = vec_get(types, i);
        ps[S_SLOT] = i;
        vec_push(f[F_LOCALS], ps);
        i = i + 1;
    }
    f[F_SLOTS] = names[VEC_LEN];
    f[F_RTYPES] = rtypes;
    f[F_TYPE] = func_of(f[F_PTYPES], f[F_RTYPES], 0);
    f[F_BODY] = empty_block(0);
    vec_push(prog_fns, f);
    return f;
}

// say_enum prints a variant like Circle(2) or Rect(3 4), and a variant without data as its
// name, through a generated printer per enum (so recursive enums print without expanding
// forever).
fn say_enum(a, t, prefix) {
    let pos = a[N_POS];
    let stmts = vec_new();
    vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, "argsep", ""), vec_new(), ty_void)));
    vec_push(stmts, expr_stmt(call_fn(pos, say_enum_fn(t, prefix), args1(a), ty_void)));
    vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, "argend", ""), vec_new(), ty_void)));
    return mk_seq(pos, stmts, mk_int(pos, 0, ty_int), ty_void);
}

// map_key_kind is the kind rt_map_order sorts a map's key words by: 0 signed integers, 1 str,
// 2 f64, 3 unsigned integers and bool.
fn map_key_kind(kt) {
    let k = kind_of(kt);
    if k == K_STRING {
        return 1;
    }
    if k == K_FLOAT {
        return 2;
    }
    if k == K_BOOL || is_unsigned_t(kt) {
        return 3;
    }
    return 0;
}

// say_map_sorted prints a map with str, number or bool keys as map[k:v ...], the entries in the
// order Go prints them (by key), and each key and value through its own static type, so a float
// key reads as a float and a slice or map value prints its elements.
fn say_map_sorted(a, t, prefix) {
    let pos = a[N_POS];
    let kt = t[TY_KEY];
    let stmts = vec_new();
    vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, "argsep", ""), vec_new(), ty_void)));
    let m = temp(pos, a, t);
    vec_push(stmts, m);
    let ord = temp(pos, rt_call(pos, "rt_map_order", args2(sym_ref_node(pos, m[LET_SYM]), mk_int(pos, map_key_kind(kt), ty_int)), ty_int), ty_int);
    vec_push(stmts, ord);
    let n = temp(pos, rt_call(pos, "rt_map_len", args1(sym_ref_node(pos, m[LET_SYM])), ty_int), ty_int);
    vec_push(stmts, n);
    vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, "raw", ""), args1(lit_string(pos, "map[")), ty_void)));
    let j = declare_local(pos, "$", ty_int);
    vec_push(stmts, let_stmt(pos, j, mk_int(pos, 0, ty_int)));
    let w = node_new(ST_WHILE, pos);
    w[WH_COND] = mk_bin(pos, "<", sym_ref_node(pos, j), sym_ref_node(pos, n[LET_SYM]), ty_bool);
    w[WH_POST] = assign_stmt(pos, sym_ref_node(pos, j), mk_bin(pos, "+", sym_ref_node(pos, j), mk_int(pos, 1, ty_int), ty_int));
    let wb = empty_block(pos);
    w[WH_BODY] = wb;
    let sep = node_new(ST_IF, pos);
    sep[IF_COND] = mk_bin(pos, ">", sym_ref_node(pos, j), mk_int(pos, 0, ty_int), ty_bool);
    sep[IF_THEN] = empty_block(pos);
    vec_push(sep[IF_THEN][BLK_STMTS], expr_stmt(rt_call(pos, str_cat3(prefix, "raw", ""), args1(lit_string(pos, " ")), ty_void)));
    vec_push(wb[BLK_STMTS], sep);
    let slot = temp(pos, rt_call(pos, "rt_order_at", args2(sym_ref_node(pos, ord[LET_SYM]), sym_ref_node(pos, j)), ty_int), ty_int);
    vec_push(wb[BLK_STMTS], slot);
    let kv = from_bits(rt_call(pos, "rt_map_key", args2(sym_ref_node(pos, m[LET_SYM]), sym_ref_node(pos, slot[LET_SYM])), ty_int), kt);
    vec_push(wb[BLK_STMTS], expr_stmt(say_arg(kv, prefix)));
    vec_push(wb[BLK_STMTS], expr_stmt(rt_call(pos, str_cat3(prefix, "raw", ""), args1(lit_string(pos, ":")), ty_void)));
    let vv = from_bits(rt_call(pos, "rt_map_val", args2(sym_ref_node(pos, m[LET_SYM]), sym_ref_node(pos, slot[LET_SYM])), ty_int), t[TY_ELEM]);
    vec_push(wb[BLK_STMTS], expr_stmt(say_arg(vv, prefix)));
    vec_push(stmts, w);
    vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, "raw", ""), args1(lit_string(pos, "]")), ty_void)));
    vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, "argend", ""), vec_new(), ty_void)));
    return mk_seq(pos, stmts, mk_int(pos, 0, ty_int), ty_void);
}

// say_map_keyed prints a map with struct or enum keys as map[k:v ...] in insertion order.
fn say_map_keyed(a, t, prefix) {
    let pos = a[N_POS];
    let stmts = vec_new();
    vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, "argsep", ""), vec_new(), ty_void)));
    let m = temp(pos, a, t);
    vec_push(stmts, m);
    let n = temp(pos, rt_call(pos, "rt_map_slots", args1(sym_ref_node(pos, m[LET_SYM])), ty_int), ty_int);
    vec_push(stmts, n);
    let first = declare_local(pos, "$", ty_bool);
    vec_push(stmts, let_stmt(pos, first, mk_int(pos, 1, ty_bool)));
    vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, "raw", ""), args1(lit_string(pos, "map[")), ty_void)));
    let j = declare_local(pos, "$", ty_int);
    vec_push(stmts, let_stmt(pos, j, mk_int(pos, 0, ty_int)));
    let w = node_new(ST_WHILE, pos);
    w[WH_COND] = mk_bin(pos, "<", sym_ref_node(pos, j), sym_ref_node(pos, n[LET_SYM]), ty_bool);
    w[WH_POST] = assign_stmt(pos, sym_ref_node(pos, j), mk_bin(pos, "+", sym_ref_node(pos, j), mk_int(pos, 1, ty_int), ty_int));
    let wb = empty_block(pos);
    w[WH_BODY] = wb;
    let live = node_new(ST_IF, pos);
    live[IF_COND] = rt_call(pos, "rt_map_live", args2(sym_ref_node(pos, m[LET_SYM]), sym_ref_node(pos, j)), ty_bool);
    live[IF_THEN] = empty_block(pos);
    let lb = live[IF_THEN][BLK_STMTS];
    let sep = node_new(ST_IF, pos);
    sep[IF_COND] = mk_unot(pos, sym_ref_node(pos, first));
    sep[IF_THEN] = empty_block(pos);
    vec_push(sep[IF_THEN][BLK_STMTS], expr_stmt(rt_call(pos, str_cat3(prefix, "raw", ""), args1(lit_string(pos, " ")), ty_void)));
    vec_push(lb, sep);
    vec_push(lb, assign_stmt(pos, sym_ref_node(pos, first), mk_int(pos, 0, ty_bool)));
    let kt = t[TY_KEY];
    let kv = key_out(rt_call(pos, "rt_map_key", args2(sym_ref_node(pos, m[LET_SYM]), sym_ref_node(pos, j)), ty_int), kt);
    if kt[TY_ENUM] {
        vec_push(lb, expr_stmt(call_fn(pos, say_enum_fn(kt, prefix), args1(kv), ty_void)));
    } else {
        vec_push(lb, expr_stmt(say_struct(kv, kt, prefix)));
    }
    vec_push(lb, expr_stmt(rt_call(pos, str_cat3(prefix, "raw", ""), args1(lit_string(pos, ":")), ty_void)));
    let vv = from_bits(rt_call(pos, "rt_map_val", args2(sym_ref_node(pos, m[LET_SYM]), sym_ref_node(pos, j)), ty_int), t[TY_ELEM]);
    vec_push(lb, expr_stmt(say_arg(vv, prefix)));
    vec_push(wb[BLK_STMTS], live);
    vec_push(stmts, w);
    vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, "raw", ""), args1(lit_string(pos, "]")), ty_void)));
    vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, "argend", ""), vec_new(), ty_void)));
    return mk_seq(pos, stmts, mk_int(pos, 0, ty_int), ty_void);
}

// say_enum_slice prints [A B C] with each element through its enum's printer.
fn say_enum_slice(a, t, prefix) {
    let pos = a[N_POS];
    let et = t[TY_ELEM];
    let stmts = vec_new();
    vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, "argsep", ""), vec_new(), ty_void)));
    let sl = temp(pos, a, t);
    vec_push(stmts, sl);
    let n = temp(pos, mk_hdr(pos, sym_ref_node(pos, sl[LET_SYM]), 0), ty_int);
    vec_push(stmts, n);
    vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, "raw", ""), args1(lit_string(pos, "[")), ty_void)));
    let j = declare_local(pos, "$", ty_int);
    vec_push(stmts, let_stmt(pos, j, mk_int(pos, 0, ty_int)));
    let w = node_new(ST_WHILE, pos);
    w[WH_COND] = mk_bin(pos, "<", sym_ref_node(pos, j), sym_ref_node(pos, n[LET_SYM]), ty_bool);
    w[WH_POST] = assign_stmt(pos, sym_ref_node(pos, j), mk_bin(pos, "+", sym_ref_node(pos, j), mk_int(pos, 1, ty_int), ty_int));
    let wb = empty_block(pos);
    w[WH_BODY] = wb;
    let sep = node_new(ST_IF, pos);
    sep[IF_COND] = mk_bin(pos, ">", sym_ref_node(pos, j), mk_int(pos, 0, ty_int), ty_bool);
    sep[IF_THEN] = empty_block(pos);
    vec_push(sep[IF_THEN][BLK_STMTS], expr_stmt(rt_call(pos, str_cat3(prefix, "raw", ""), args1(lit_string(pos, " ")), ty_void)));
    vec_push(wb[BLK_STMTS], sep);
    let el = mk_elem(pos, sym_ref_node(pos, sl[LET_SYM]), sym_ref_node(pos, j), et, 0);
    el[ELEM_SAFE] = 1;
    vec_push(wb[BLK_STMTS], expr_stmt(call_fn(pos, say_enum_fn(et, prefix), args1(el), ty_void)));
    vec_push(stmts, w);
    vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, "raw", ""), args1(lit_string(pos, "]")), ty_void)));
    vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, "argend", ""), vec_new(), ty_void)));
    return mk_seq(pos, stmts, mk_int(pos, 0, ty_int), ty_void);
}

fn say_enum_fn(t, prefix) {
    if !say_enum_keys {
        say_enum_keys = vec_new();
        say_enum_fns = vec_new();
    }
    let i = 0;
    while i < say_enum_keys[VEC_LEN] {
        let kp = vec_get(say_enum_keys, i);
        if vec_get(kp, 0) == t && streq(vec_get(kp, 1), prefix) {
            return vec_get(say_enum_fns, i);
        }
        i = i + 1;
    }
    let names = vec_new();
    vec_push(names, "x");
    let types = vec_new();
    vec_push(types, t);
    let f = lifted_fn("say", names, types, vec_new());
    let kp2 = vec_new();
    vec_push(kp2, t);
    vec_push(kp2, prefix);
    vec_push(say_enum_keys, kp2);
    vec_push(say_enum_fns, f);
    let saved_fn = ck_fn;
    ck_fn = f;
    let pos = 0;
    let x = vec_get(f[F_LOCALS], 0);
    let body = f[F_BODY][BLK_STMTS];
    let vs = t[TY_ENUM];
    let vi = 0;
    while vi < vs[VEC_LEN] {
        let v = vec_get(vs, vi);
        let ifs = node_new(ST_IF, pos);
        ifs[IF_COND] = mk_bin(pos, "==", mk_mem(pos, sym_ref_node(pos, x), 0, 0, field_offset(t, 0), ty_int), mk_int(pos, vi, ty_int), ty_bool);
        ifs[IF_THEN] = empty_block(pos);
        let b = ifs[IF_THEN][BLK_STMTS];
        vec_push(b, expr_stmt(rt_call(pos, str_cat3(prefix, "raw", ""), args1(lit_string(pos, vec_get(v, 0))), ty_void)));
        let nf = vec_get(v, 2);
        if nf > 0 {
            vec_push(b, expr_stmt(rt_call(pos, str_cat3(prefix, "raw", ""), args1(lit_string(pos, "(")), ty_void)));
            let k = 0;
            while k < nf {
                if k > 0 {
                    vec_push(b, expr_stmt(rt_call(pos, str_cat3(prefix, "raw", ""), args1(lit_string(pos, " ")), ty_void)));
                }
                let fi = vec_get(v, 1) + k;
                let ft = field_type(t, fi);
                let fv = mk_mem(pos, sym_ref_node(pos, x), 0, 0, field_offset(t, fi), ft);
                if kind_of(ft) == K_STRUCT && ft[TY_ENUM] {
                    vec_push(b, expr_stmt(call_fn(pos, say_enum_fn(ft, prefix), args1(fv), ty_void)));
                } else {
                    vec_push(b, expr_stmt(say_arg(fv, prefix)));
                }
                k = k + 1;
            }
            vec_push(b, expr_stmt(rt_call(pos, str_cat3(prefix, "raw", ""), args1(lit_string(pos, ")")), ty_void)));
        }
        vec_push(body, ifs);
        vi = vi + 1;
    }
    ck_fn = saved_fn;
    return f;
}

fn lit_string(pos, s) {
    let n = node_new(EX_STR, pos);
    n[STR_PTR] = s;
    n[STR_LEN] = strlen(s);
    n[N_TYPE] = ty_string;
    return n;
}

// say_text formats args like say.Str (Line spacing when ln) and returns the str.
fn say_text(pos, args, ln) {
    let stmts = vec_new();
    vec_push(stmts, expr_stmt(rt_call(pos, "rt_fmt_begin_v", args1(mk_int(pos, ln, ty_int)), ty_void)));
    let i = 0;
    while i < args[VEC_LEN] {
        vec_push(stmts, expr_stmt(say_arg(vec_get(args, i), "rt_fmt_")));
        i = i + 1;
    }
    return mk_seq(pos, stmts, rt_call(pos, "rt_fmt_end", vec_new(), ty_string), ty_string);
}

// lower_say compiles say calls into typed runtime calls: begin, one call per argument,
// then end. No interfaces or reflection are needed.
//   say.Line(a...)        print, spaces between, newline
//   say.Text(a...)        print, Go's Print spacing
//   say.Out(f, a...)      printf
//   say.Fmt(f, a...) str  sprintf
//   say.Str(a...) str     sprint
//   say.Fault(f, a...)    a fault with a formatted message
//   say.To(w, f, a...)    printf into w.Write(str)
//   say.LineTo(w, a...)   println into w.Write(str)
// chk_interp turns "a {x} b {y:.2}" into say.Fmt("a %v b %.2f", x, y): the verb comes from
// the spec (its last letter), else %v, or %f for a float with a precision.
// is_query_t reports whether t is the runtime's query type.
fn is_query_t(t) {
    return t && t[TY_KIND] == K_STRUCT && t[TY_NAME] && streq(t[TY_NAME], "query");
}

fn tx_named(pos, name) {
    let n = node_new(TX_NAME, pos);
    n[TX_B] = name;
    return n;
}

fn tx_slice_of(pos, name) {
    let n = node_new(TX_SLICE, pos);
    n[TX_A] = tx_named(pos, name);
    return n;
}

fn ident_node(pos, name) {
    let n = node_new(EX_IDENT, pos);
    n[ID_NAME] = name;
    return n;
}

fn composite_of(tyx, elems, keys) {
    let c = node_new(EX_COMPOSITE, tyx[N_POS]);
    c[CL_TYPE] = tyx;
    c[CL_ELEMS] = elems;
    c[CL_KEYS] = keys;
    return c;
}

// query_arg wraps a checked value in the qarg variant for its type: integers become
// Int(i64(x)), floats Float(f64(x)), then Str, Bool and Bytes ([]u8).
fn query_arg(a, t) {
    let pos = a[N_POS];
    let variant = 0;
    let conv = 0;
    if is_integer_t(t) {
        variant = "Int";
        if t != ty_int {
            conv = "i64";
        }
    } else if is_float_t(t) {
        variant = "Float";
        if t != ty_float {
            conv = "f64";
        }
    } else if kind_of(t) == K_STRING {
        variant = "Str";
    } else if kind_of(t) == K_BOOL || kind_of(t) == K_UBOOL {
        variant = "Bool";
    } else if kind_of(t) == K_SLICE && t[TY_ELEM] == ty_byte {
        variant = "Bytes";
    } else {
        err_type(pos, "a query value must be an integer, a float, a str, a bool or []u8, not ", t, "");
        return 0;
    }
    let v = a;
    if conv {
        v = node_new(EX_CALL, pos);
        v[CALL_NAME] = conv;
        v[CALL_ARGS] = args1(a);
    }
    let sel = node_new(EX_SELECT, pos);
    sel[SEL_X] = ident_node(pos, "qarg");
    sel[SEL_NAME] = variant;
    let call = node_new(EX_CALL, pos);
    call[CALL_CALLEE] = sel;
    call[CALL_ARGS] = args1(v);
    return call;
}

// chk_query turns a literal where a query is wanted into query{Parts, Args}: "GET user:{id}"
// keeps "GET user:" and "" as text and id as a value, so a value is never parsed as text.
fn chk_query(e, want) {
    let pos = e[N_POS];
    let parts = vec_new();
    let args = vec_new();
    if e[N_KIND] == EX_STR {
        let s = node_new(EX_STR, pos);
        s[STR_PTR] = e[STR_PTR];
        s[STR_LEN] = e[STR_LEN];
        vec_push(parts, s);
    } else {
        parts = e[INTERP_PARTS];
        let vals = e[INTERP_ARGS];
        let specs = e[INTERP_SPECS];
        let i = 0;
        while i < vals[VEC_LEN] {
            if vec_get(specs, i) {
                err_at(pos, "a query value takes no format spec: it is sent as it is");
            }
            let a = vec_get(vals, i);
            let qa = query_arg(a, chk(a, 0));
            if qa {
                vec_push(args, qa);
            }
            i = i + 1;
        }
    }
    let nokeys = vec_new();
    let i = 0;
    while i < parts[VEC_LEN] {
        vec_push(nokeys, 0);
        i = i + 1;
    }
    let akeys = vec_new();
    i = 0;
    while i < args[VEC_LEN] {
        vec_push(akeys, 0);
        i = i + 1;
    }
    let elems = vec_new();
    vec_push(elems, composite_of(tx_slice_of(pos, "str"), parts, nokeys));
    vec_push(elems, composite_of(tx_slice_of(pos, "qarg"), args, akeys));
    let keys = vec_new();
    vec_push(keys, ident_node(pos, "Parts"));
    vec_push(keys, ident_node(pos, "Args"));
    let c = composite_of(tx_named(pos, "query"), elems, keys);
    replace_node(e, c);
    e[N_TYPE] = 0;
    return chk_kind(e, want);
}

// interp_name_known reports whether a name inside {...} in a string resolves: chk_ident
// would not report it undefined.
fn interp_name_known(name) {
    return streq(name, "true") || streq(name, "false") || lookup_name(name) || import_pkg(name);
}

fn chk_interp(e, want) {
    let pos = e[N_POS];
    let parts = e[INTERP_PARTS];
    let vals = e[INTERP_ARGS];
    let specs = e[INTERP_SPECS];
    let f = buf_new();
    let args = vec_new();
    vec_push(args, 0);
    let i = 0;
    while i < parts[VEC_LEN] {
        let part = vec_get(parts, i);
        let k = 0;
        while k < part[STR_LEN] {
            let c = load8(part[STR_PTR] + k);
            if c == '%' {
                buf_byte(f, '%');
            }
            buf_byte(f, c);
            k = k + 1;
        }
        if i < vals[VEC_LEN] {
            let a = vec_get(vals, i);
            if a[N_KIND] == EX_IDENT && !interp_name_known(a[ID_NAME]) {
                // Often meant as literal text, like a route pattern's {id}.
                let u = err_begin(a[N_POS]);
                buf_str(u, "undefined: ");
                buf_str(u, a[ID_NAME]);
                buf_str(u, " (in a string, {");
                buf_str(u, a[ID_NAME]);
                buf_str(u, "} is a value: write {{ for a brace, or use a `raw` string)");
                err_end(u);
                replace_node(a, mk_int(a[N_POS], 0, 0));
            }
            let t = chk(a, 0);
            let spec = vec_get(specs, i);
            buf_byte(f, '%');
            if !spec {
                buf_byte(f, 'v');
            } else {
                buf_str(f, spec);
                let sl = strlen(spec);
                let last = 0;
                if sl > 0 {
                    last = load8(spec + sl - 1);
                }
                if !((last >= 'a' && last <= 'z') || (last >= 'A' && last <= 'Z')) {
                    let dot = 0;
                    let q = 0;
                    while q < sl {
                        if load8(spec + q) == '.' {
                            dot = 1;
                        }
                        q = q + 1;
                    }
                    if dot && is_float_t(t) {
                        buf_byte(f, 'f');
                    } else {
                        buf_byte(f, 'v');
                    }
                }
            }
            vec_push(args, a);
        }
        i = i + 1;
    }
    let fs = node_new(EX_STR, pos);
    fs[STR_LEN] = f[VEC_LEN];
    buf_byte(f, 0);
    fs[STR_PTR] = f[VEC_DATA];
    args[VEC_DATA][0] = fs;
    let call = node_new(EX_CALL, pos);
    call[CALL_ARGS] = args;
    replace_node(e, call);
    e[N_TYPE] = 0;
    return lower_say(e, "Fmt", want);
}

fn lower_say(e, m, want) {
    let pos = e[N_POS];
    let args = e[CALL_ARGS];
    let first = 0;
    let writer = 0;
    if streq(m, "To") || streq(m, "LineTo") {
        writer = arg0(e);
        first = 1;
    }
    let printf = streq(m, "Out") || streq(m, "Fmt") || streq(m, "Fault") || streq(m, "To");
    let ln = streq(m, "Line") || streq(m, "LineTo");
    let stmts = vec_new();
    if printf {
        if args[VEC_LEN] <= first {
            err_at(pos, "missing format");
            return ty_void;
        }
        let f = vec_get(args, first);
        let ft = chk(f, ty_string);
        if kind_of(ft) != K_STRING {
            err_at(f[N_POS], "format must be a str");
        }
        vec_push(stmts, expr_stmt(rt_call(pos, "rt_fmt_begin", args1(f), ty_void)));
        first = first + 1;
    } else {
        vec_push(stmts, expr_stmt(rt_call(pos, "rt_fmt_begin_v", args1(mk_int(pos, ln, ty_int)), ty_void)));
    }
    let i = first;
    while i < args[VEC_LEN] {
        vec_push(stmts, expr_stmt(say_arg(vec_get(args, i), "rt_fmt_")));
        i = i + 1;
    }
    let tail = 0;
    let t = ty_void;
    if writer {
        let ws = node_new(EX_SELECT, pos);
        ws[SEL_X] = writer;
        ws[SEL_NAME] = "Write";
        tail = node_new(EX_CALL, pos);
        tail[CALL_CALLEE] = ws;
        tail[CALL_ARGS] = args1(rt_call(pos, "rt_fmt_end", vec_new(), ty_string));
        chk(tail, 0);
        tail[N_TYPE] = ty_void;
    } else if streq(m, "Fmt") || streq(m, "Str") {
        tail = rt_call(pos, "rt_fmt_end", vec_new(), ty_string);
        t = ty_string;
    } else if streq(m, "Fault") {
        tail = rt_call(pos, "rt_fmt_err", vec_new(), ty_error);
        t = ty_error;
    } else {
        tail = rt_call(pos, "rt_fmt_out", vec_new(), ty_void);
    }
    replace_node(e, mk_seq(pos, stmts, tail, t));
    e[N_TYPE] = 0;
    return t;
}

fn arity_error(e, want) {
    let a = err_begin(e[N_POS]);
    buf_str(a, e[CALL_NAME]);
    buf_str(a, " expects ");
    buf_int(a, want);
    buf_str(a, " arguments, got ");
    buf_int(a, e[CALL_ARGS][VEC_LEN]);
    err_end(a);
}
