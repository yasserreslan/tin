// Expression checking and lowering. chk(e, want) types e and rewrites it in place into
// core nodes; want is the type the context expects (it settles untyped constants and
// elided composite types). A node is checked once: N_TYPE marks it done.
//
// Strict rules for package code: operands must have identical types (constants adapt
// and must fit), conditions are bool, references are never nil (?T may be), faults must
// be handled, and every slice/string index is bounds-checked unless proven safe.
// Legacy fn code keeps its untyped word semantics.
fn chk(e i64, want i64) i64 {
	if e[N_TYPE] != 0 {
		return e[N_TYPE]
	}
	mut t = chk_kind(e, want)
	if t == 0 {
		t = ty_int
	}
	e[N_TYPE] = t
	return t
}

fn chk_kind(e i64, want i64) i64 {
	let k = e[N_KIND]
	if k == EX_INT {
		return adapt_int(e, want)
	}
	if k == EX_FLOAT {
		if is_f32(want) != 0 {
			// An f32 constant: fold the rounding into the bits.
			e[FL_BITS] = round_f32_bits(e[FL_BITS])
			return ty_f32
		}
		return ty_float
	}
	if k == EX_STR {
		if is_query_t(want) != 0 {
			return chk_query(e, want)
		}
		return ty_string
	}
	if k == EX_NIL {
		e[N_KIND] = EX_INT
		e[INT_VAL] = 0
		if nilable(want) != 0 {
			return want
		}
		err_code_at(e[N_POS], cstr("E233 UNTYPED_NIL"), cstr("nil needs an optional (?T) or fault type"))
		return ty_nil
	}
	if k == EX_IDENT {
		return chk_ident(e, want)
	}
	if k == EX_UNARY {
		if fold_const(e) != 0 {
			return adapt_int(e, want)
		}
		return chk_unary(e, want)
	}
	if k == EX_BINARY {
		if fold_const(e) != 0 {
			return adapt_int(e, want)
		}
		if fold_compare(e) != 0 {
			return ty_bool
		}
		return chk_binary(e, want)
	}
	if k == EX_CALL {
		return chk_call(e, want)
	}
	if k == EX_INDEX {
		return chk_index(e)
	}
	if k == EX_SLICE {
		return chk_slice(e)
	}
	if k == EX_SELECT {
		return chk_select(e, want)
	}
	if k == EX_COMPOSITE {
		return chk_composite(e, want)
	}
	if k == EX_FUNCLIT {
		return chk_funclit(e)
	}
	if k == EX_BOUNDARY {
		return chk_boundary(e)
	}
	if k == EX_MATCH {
		return chk_match(e, want)
	}
	if k == EX_UNIT {
		return chk_unit(e, want)
	}
	if k == EX_TYPE {
		err_code_at(e[N_POS], cstr("E235 NOT_A_VALUE"), cstr("type used as a value"))
		return ty_int
	}
	if k == EX_TRY {
		err_code_at(e[N_POS], cstr("E403 TRY_PLACEMENT"), cstr("try is only allowed as a statement, an initializer, an assignment or a return"))
		return ty_int
	}
	if k == EX_CATCH {
		err_code_at(e[N_POS], cstr("E401 CATCH_PLACEMENT"), cstr("catch is only allowed on a whole statement, initializer, assignment or return value"))
		return ty_int
	}
	if k == EX_INTERP {
		if is_query_t(want) != 0 {
			return chk_query(e, want)
		}
		return chk_interp(e, want)
	}
	if k == EX_MUTARG {
		err_code_at(e[N_POS], cstr("E705 MUT_ARG"), cstr("mut here does nothing: only an argument for a mut parameter takes mut"))
		return chk(e[MUTARG_X], want)
	}
	err_code_at(e[N_POS], cstr("E990 INTERNAL"), cstr("unexpected expression"))
	return ty_int
}

// int_fits reports whether constant v is representable in integer type t.
fn int_fits(v i64, t i64, big i64) i64 {
	let w = t[TY_WIDTH]
	if w == 8 {
		return i64(t[TY_SIGNED] != 0 || v >= 0 || big != 0)
	}
	if big != 0 {
		return 0
	}
	let bits = 8 * w
	if t[TY_SIGNED] != 0 {
		let lim = 1 << (bits - 1)
		return i64(v >= -lim && v < lim)
	}
	return i64(v >= 0 && v < (1 << bits))
}

// fold_compare turns a comparison of two integer constants into a bool (unsigned when
// either is above 2^63-1).
fn fold_compare(e i64) i64 {
	let op = e[BIN_OP]
	if !(streq(op, cstr("<")) != 0 || streq(op, cstr("<=")) != 0 || streq(op, cstr(">")) != 0 || streq(op, cstr(">=")) != 0 || streq(op, cstr("==")) != 0 || streq(op, cstr("!=")) != 0) {
		return 0
	}
	let l = e[BIN_L]
	let r = e[BIN_R]
	if fold_const(l) == 0 || fold_const(r) == 0 || l[N_KIND] != EX_INT || r[N_KIND] != EX_INT || l[7] != 0 || r[7] != 0 {
		return 0
	}
	mut a = l[INT_VAL]
	mut b = r[INT_VAL]
	if l[8] != 0 || r[8] != 0 {
		a = a ^ (1 << 63)
		b = b ^ (1 << 63)
	}
	replace_node(e, mk_int(e[N_POS], eval_binary(op, a, b), ty_bool))
	return 1
}

// fold_const evaluates an expression made only of integer literals, turning e into one literal.
fn fold_const(e i64) i64 {
	let k = e[N_KIND]
	if k == EX_INT {
		return 1
	}
	if k == EX_IDENT {
		// An untyped integer constant folds like the literal it stands for.
		let s = lookup_name(e[ID_NAME])
		if s == 0 || s[S_KIND] != SYM_CONST || s[S_DONE] == 0 || s[S_EXPR] != 0 || kind_of(s[S_TYPE]) != K_UINT {
			return 0
		}
		mut big = s[S_BIG]
		replace_node(e, mk_int(e[N_POS], s[S_VAL], 0))
		e[8] = big
		return 1
	}
	mut v = 0
	if k == EX_UNARY {
		let op = e[UN_OP]
		let x = e[UN_X]
		if !(streq(op, cstr("-")) != 0 || streq(op, cstr("^")) != 0 || streq(op, cstr("+")) != 0) || fold_const(x) == 0 {
			return 0
		}
		v = x[INT_VAL]
		if streq(op, cstr("-")) != 0 {
			v = 0 - v
		} else if streq(op, cstr("^")) != 0 {
			v = ~v
		}
	} else if k == EX_BINARY {
		let op = e[BIN_OP]
		let l = e[BIN_L]
		let r = e[BIN_R]
		if fold_const(l) == 0 || fold_const(r) == 0 {
			return 0
		}
		let a = l[INT_VAL]
		let b = r[INT_VAL]
		let ub = i64(l[8] != 0 || r[8] != 0)
		if ub != 0 && (streq(op, cstr(">>")) != 0 || streq(op, cstr("/")) != 0 || streq(op, cstr("%")) != 0) {
			if (streq(op, cstr("/")) != 0 || streq(op, cstr("%")) != 0) && b == 0 {
				return 0
			}
			v = eval_unsigned(op, a, b)
			e[N_KIND] = EX_INT
			e[INT_VAL] = v
			e[3] = 0
			e[4] = 0
			e[7] = 0
			e[8] = i64(v < 0)
			return 1
		}
		if streq(op, cstr("+")) != 0 {
			v = a + b
		} else if streq(op, cstr("-")) != 0 {
			v = a - b
		} else if streq(op, cstr("*")) != 0 {
			v = a * b
		} else if (streq(op, cstr("/")) != 0 || streq(op, cstr("%")) != 0) && b != 0 {
			if streq(op, cstr("/")) != 0 {
				v = a / b
			} else {
				v = a % b
			}
		} else if streq(op, cstr("&")) != 0 {
			v = a & b
		} else if streq(op, cstr("|")) != 0 {
			v = a | b
		} else if streq(op, cstr("^")) != 0 {
			v = a ^ b
		} else if streq(op, cstr("<<")) != 0 && b >= 0 && b < 64 {
			v = a << b
		} else if streq(op, cstr(">>")) != 0 && b >= 0 && b < 64 {
			v = a >> b
		} else {
			return 0
		}
	} else {
		return 0
	}
	mut big = 0
	if k == EX_BINARY {
		big = i64((e[BIN_L][8] != 0 || e[BIN_R][8] != 0) && v < 0)
	}
	e[N_KIND] = EX_INT
	e[INT_VAL] = v
	e[3] = 0
	e[4] = 0
	e[7] = 0
	e[8] = big
	return 1
}

// adapt_int gives an integer literal the expected type, checking that it fits.
fn adapt_int(e i64, want_in i64) i64 {
	mut want = want_in
	if want == 0 {
		want = ty_int
	}
	if is_float_t(want) != 0 {
		e[N_KIND] = EX_FLOAT
		e[FL_BITS] = int_to_float_bits(e[INT_VAL])
		if is_f32(want) != 0 {
			e[FL_BITS] = round_f32_bits(e[FL_BITS])
			return ty_f32
		}
		return ty_float
	}
	if kind_of(want) == K_INT {
		if int_fits(e[INT_VAL], want, e[8]) == 0 {
			let m = err_code(e[N_POS], cstr("E223 CONST_OVERFLOW"))
			buf_str(m, cstr("constant "))
			buf_int(m, e[INT_VAL])
			buf_str(m, cstr(" overflows "))
			type_name(m, want)
			err_end(m)
		}
		return want
	}
	return ty_uint
}

fn chk_ident(e i64, want i64) i64 {
	let name = e[ID_NAME]
	if streq(name, cstr("true")) != 0 || streq(name, cstr("false")) != 0 {
		replace_node(e, mk_int(e[N_POS], streq(name, cstr("true")), 0))
		return ty_bool
	}
	let s = lookup_name(name)
	if s == 0 {
		if import_pkg(name) != 0 {
			err_code_quoted(e[N_POS], cstr("E235 NOT_A_VALUE"), cstr("use of package "), name, cstr(" without a selector"))
		} else {
			let u = err_code(e[N_POS], cstr("E103 UNDEFINED"))
			buf_str(u, cstr("undefined: "))
			buf_str(u, name)
			err_end(u)
		}
		return ty_int
	}
	return use_sym(e, s, want)
}

// starts_select reports whether name is one of the rt_select_ helpers select lowers to.
fn starts_select(name i64) i64 {
	let p = cstr("rt_select_")
	mut i = 0
	for i64(load8(p + i)) != 0 {
		if i64(load8(name + i)) != i64(load8(p + i)) {
			return 0
		}
		i = i + 1
	}
	return 1
}

// runtime_use rejects user code naming a function only the standard library may use: a C
// extern or one of the runtime's own (the trusted files outside any package).
fn runtime_use(pos i64, f i64, name i64) {
	if ck_trusted != 0 || streq(name, cstr("rt_pool_used")) != 0 || streq(name, cstr("rt_once")) != 0 || streq(name, cstr("rt_scope_open")) != 0 || streq(name, cstr("rt_scope_close")) != 0 || streq(name, cstr("rt_detach")) != 0 || (i64(load8(name)) == 'r' && starts_select(name) != 0) {
		return
	}
	if f[F_EXTERN] != 0 || (vec_get(file_trusted, f[F_FILE]) != 0 && i64(load8(vec_get(file_pkgs, f[F_FILE]))) == 0) {
		err_code_quoted(pos, cstr("E802 RUNTIME_INTERNAL"), cstr(""), name, cstr(" is internal to the runtime"))
	}
}

// use_sym turns a resolved name into a variable read, a constant or a function value.
fn use_sym(e i64, s i64, want i64) i64 {
	let k = s[S_KIND]
	if k == SYM_FUNC {
		let f = s[S_FN]
		runtime_use(e[N_POS], f, e[ID_NAME])
		e[N_KIND] = EX_FUNCREF
		e[FR_FN] = f
		return f[F_TYPE]
	}
	if k == SYM_CONST {
		if s[S_DONE] == 0 {
			err_code_quoted(e[N_POS], cstr("E130 INIT_ORDER"), cstr("constant "), e[ID_NAME], cstr(" used before its definition"))
			return ty_int
		}
		if s[S_EXPR] != 0 {
			replace_node(e, expr_clone(s[S_EXPR]))
			return s[S_TYPE]
		}
		let v = s[S_VAL]
		let t = s[S_TYPE]
		replace_node(e, mk_int(e[N_POS], v, 0))
		e[ID_REF] = s
		e[8] = s[S_BIG]
		if kind_of(t) == K_UINT {
			return chk_kind(e, want)
		}
		if is_float_t(t) != 0 {
			e[N_KIND] = EX_FLOAT
			e[FL_BITS] = int_to_float_bits(v)
		}
		return t
	}
	if s[S_CAPTURED] != 0 {
		let env_ref = sym_ref_node(e[N_POS], ck_fn[F_ENV_SYM])
		let cell_addr = mk_mem(e[N_POS], env_ref, 0, 0, 8 * (2 + s[S_CAP_IDX]), ty_int)
		let val = mk_mem(e[N_POS], cell_addr, 0, 0, 0, s[S_TYPE])
		replace_node(e, val)
		return s[S_TYPE]
	}
	if s[S_CELL] != 0 {
		let cell_ref = sym_ref_node(e[N_POS], s[S_CELL_SYM])
		let val = mk_mem(e[N_POS], cell_ref, 0, 0, 0, s[S_TYPE])
		replace_node(e, val)
		return s[S_TYPE]
	}
	e[ID_REF] = s
	s[S_READS] = s[S_READS] + 1
	if s[S_TYPE] == 0 {
		return ty_int
	}
	return s[S_TYPE]
}

fn chk_unary(e i64, want i64) i64 {
	let op = e[UN_OP]
	let x = e[UN_X]
	if streq(op, cstr("&")) != 0 {
		if x[N_KIND] == EX_COMPOSITE {
			let ct = chk(x, want)
			replace_node(e, x)
			return ct
		}
		if x[N_KIND] != EX_IDENT {
			err_code_at(e[N_POS], cstr("E803 ADDRESS_OF"), cstr("'&' needs a variable name"))
			chk(x, 0)
			return ty_int
		}
		let xname = x[ID_NAME]
		let xt = chk(x, 0)
		if x[ID_REF] != 0 && x[ID_REF][S_CAPTURED] != 0 {
			let s = x[ID_REF]
			let env_ref = sym_ref_node(e[N_POS], ck_fn[F_ENV_SYM])
			let cell_addr = mk_mem(e[N_POS], env_ref, 0, 0, 8 * (2 + s[S_CAP_IDX]), ty_int)
			replace_node(e, cell_addr)
			return ty_int
		}
		if x[ID_REF] != 0 && x[ID_REF][S_CELL] != 0 {
			let s = x[ID_REF]
			replace_node(e, sym_ref_node(e[N_POS], s[S_CELL_SYM]))
			return ty_int
		}
		if x[N_KIND] != EX_IDENT || x[ID_REF] == 0 {
			err_code_quoted(e[N_POS], cstr("E803 ADDRESS_OF"), cstr("cannot take the address of constant "), xname, cstr(""))
			return ty_int
		}
		if kind_of(xt) == K_STRUCT {
			replace_node(e, x)
			return xt
		}
		if ck_trusted == 0 {
			err_code_at(e[N_POS], cstr("E801 TRUSTED_ONLY"), cstr("'&' on a variable is only allowed in the standard library"))
		}
		return ty_int
	}
	if streq(op, cstr("...")) != 0 {
		err_code_at(e[N_POS], cstr("E211 VARIADIC_ARG"), cstr("... is only allowed on the last argument of a call"))
		return ty_int
	}
	let t = chk(x, want)
	if streq(op, cstr("!")) != 0 {
		if is_bool_t(t) == 0 {
			err_code_type(e[N_POS], cstr("E236 OPERATOR"), cstr("operator ! needs a bool, not "), t, cstr(""))
		}
		if is_secret(t) != 0 {
			return t
		}
		return ty_bool
	}
	if streq(op, cstr("-")) != 0 {
		if is_numeric_t(t) == 0 {
			err_code_type(e[N_POS], cstr("E236 OPERATOR"), cstr("operator - needs a number, not "), t, cstr(""))
		}
		if x[N_KIND] == EX_FLOAT {
			replace_node(e, x)
			e[FL_BITS] = e[FL_BITS] ^ (1 << 63)
			e[N_TYPE] = 0
			return ty_float
		}
		if x[N_KIND] == EX_INT && (kind_of(t) == K_UINT) {
			replace_node(e, mk_int(e[N_POS], -x[INT_VAL], 0))
			return t
		}
		return t
	}
	if is_integer_t(t) == 0 {
		err_code_type(e[N_POS], cstr("E236 OPERATOR"), cstr("operator ^ needs an integer, not "), t, cstr(""))
	}
	if x[N_KIND] == EX_INT && kind_of(t) == K_UINT {
		replace_node(e, mk_int(e[N_POS], ~x[INT_VAL], 0))
		return ty_uint
	}
	return t
}

fn is_cmp_op(op i64) i64 {
	return i64(streq(op, cstr("==")) != 0 || streq(op, cstr("!=")) != 0 || streq(op, cstr("<")) != 0 || streq(op, cstr("<=")) != 0 || streq(op, cstr(">")) != 0 || streq(op, cstr(">=")) != 0)
}

fn is_untyped_lit(e i64) i64 {
	let k = e[N_KIND]
	return i64(k == EX_INT || k == EX_NIL || k == EX_FLOAT || (k == EX_UNARY && is_untyped_lit(e[UN_X]) != 0) || (k == EX_BINARY && is_untyped_lit(e[BIN_L]) != 0 && is_untyped_lit(e[BIN_R]) != 0))
}

// unify checks both operands of a binary operator and returns their common type:
// identical types, or an untyped constant adapted to the other side.
fn unify(l i64, r i64, want i64) i64 {
	mut lt = 0
	mut rt = 0
	if is_untyped_lit(l) == 0 || is_untyped_lit(r) != 0 {
		lt = chk(l, want)
		rt = chk(r, default_or(lt, want))
	} else {
		rt = chk(r, want)
		lt = chk(l, default_or(rt, want))
	}
	if kind_of(lt) == K_UINT && is_untyped(rt) == 0 {
		lt = reconvert(l, rt)
	} else if kind_of(rt) == K_UINT && is_untyped(lt) == 0 {
		rt = reconvert(r, lt)
	}
	if kind_of(lt) == K_NIL && nilable(rt) != 0 {
		reconvert(l, rt)
		return rt
	}
	if kind_of(rt) == K_NIL && nilable(lt) != 0 {
		reconvert(r, lt)
		return lt
	}
	if kind_of(lt) == K_UINT && kind_of(rt) == K_UINT {
		return ty_uint
	}
	// A bounded operand counts as its unbounded type: the result may be longer (#240).
	lt = unbounded(lt)
	rt = unbounded(rt)
	// An operation on a secret and a plain value of the same type is secret.
	if lt != rt && secret_join(lt, rt) != 0 {
		return secret_join(lt, rt)
	}
	if lt != rt {
		err_code_types(l[N_POS], cstr("E230 TYPE_MISMATCH"), cstr("mismatched types "), lt, cstr(" and "), rt)
	}
	return lt
}

fn default_or(t i64, want i64) i64 {
	if is_untyped(t) != 0 {
		return want
	}
	return t
}

// reconvert gives an untyped constant node the concrete type to.
fn reconvert(e i64, to i64) i64 {
	let k = kind_of(e[N_TYPE])
	if k == K_UINT {
		if e[N_KIND] == EX_INT {
			e[N_TYPE] = 0
			let t = adapt_int(e, to)
			e[N_TYPE] = t
			return t
		}
		retype_untyped(e, to)
		return to
	}
	if k == K_NIL && nilable(to) != 0 {
		e[N_TYPE] = to
		return to
	}
	return e[N_TYPE]
}

fn retype_untyped(e i64, to i64) {
	if kind_of(e[N_TYPE]) != K_UINT {
		return
	}
	e[N_TYPE] = to
	let k = e[N_KIND]
	if k == EX_UNARY {
		retype_untyped(e[UN_X], to)
	} else if k == EX_BINARY && is_cmp_op(e[BIN_OP]) == 0 {
		retype_untyped(e[BIN_L], to)
		retype_untyped(e[BIN_R], to)
	}
}

fn chk_binary(e i64, want i64) i64 {
	let op = e[BIN_OP]
	let l = e[BIN_L]
	let r = e[BIN_R]
	let pos = e[N_POS]
	if streq(op, cstr("$is")) != 0 {
		// A case of switch err { ... }: fault.Is, walking the chain and comparing identity.
		let ft = unify(l, r, ty_error)
		if kind_of(ft) == K_ERROR {
			replace_node(e, rt_call(pos, cstr("rt_fault_is"), args2(l, r), ty_bool))
			e[N_TYPE] = 0
		}
		return ty_bool
	}
	if streq(op, cstr("&&")) != 0 || streq(op, cstr("||")) != 0 {
		let a = chk(l, ty_bool)
		// x != nil && x.f: the right side sees x narrowed.
		mut narrowed = 0
		if streq(op, cstr("&&")) != 0 {
			narrowed = narrow_begin(l, 1)
		}
		let b = chk(r, ty_bool)
		narrow_end(narrowed)
		if is_bool_t(a) == 0 || is_bool_t(b) == 0 {
			err_code_at(pos, cstr("E236 OPERATOR"), cstr("operands of && and || must be bool"))
		}
		return ty_bool
	}
	if streq(op, cstr("<<")) != 0 || streq(op, cstr(">>")) != 0 {
		let st = chk(l, want)
		let ct = chk(r, ty_int)
		if is_integer_t(st) == 0 {
			err_code_type(pos, cstr("E236 OPERATOR"), cstr("cannot shift "), st, cstr(""))
		}
		if is_integer_t(ct) == 0 {
			err_code_type(pos, cstr("E236 OPERATOR"), cstr("shift count must be an integer, not "), ct, cstr(""))
		}
		if kind_of(ct) == K_UINT {
			reconvert(r, ty_int)
		}
		if l[N_KIND] == EX_INT && r[N_KIND] == EX_INT && kind_of(st) == K_UINT {
			replace_node(e, mk_int(pos, eval_binary(op, l[INT_VAL], r[INT_VAL]), 0))
			return ty_uint
		}
		if is_secret(ct) != 0 && is_untyped(st) == 0 {
			return secret_of(st)
		}
		return st
	}
	let t = unify(l, r, want)
	if is_cmp_op(op) != 0 && secret_compare_error(pos, op, l[N_TYPE], r[N_TYPE]) != 0 {
		return ty_bool
	}
	if is_cmp_op(op) != 0 && kind_of(t) == K_DYN {
		err_code_at(pos, cstr("E237 COMPARE"), cstr("cannot compare dyn values: use a method on the shape (?dyn compares against nil)"))
		return ty_bool
	}
	if is_cmp_op(op) != 0 {
		let ordered = i64(streq(op, cstr("==")) == 0 && streq(op, cstr("!=")) == 0)
		if ordered == 0 && kind_of(t) == K_STRUCT && t[TY_ENUM] != 0 {
			return lower_enum_eq(e, op, l, r, t)
		}
		if kind_of(t) == K_STRING {
			lower_str_cmp(e, op, l, r)
			return ty_bool
		}
		if l[N_KIND] == EX_INT && r[N_KIND] == EX_INT && kind_of(t) == K_UINT {
			replace_node(e, mk_int(pos, eval_binary(op, l[INT_VAL], r[INT_VAL]), 0))
			return ty_bool
		}
		if ordered != 0 && is_numeric_t(t) == 0 {
			err_code_type(pos, cstr("E236 OPERATOR"), cstr("cannot order values of type "), t, cstr(""))
		}
		if kind_of(t) == K_UINT {
			reconvert(l, ty_int)
			reconvert(r, ty_int)
		}
		return ty_bool
	}
	let k = kind_of(t)
	if k == K_STRING {
		if streq(op, cstr("+")) == 0 {
			err_code_quoted(pos, cstr("E236 OPERATOR"), cstr("operator "), op, cstr(" is not defined on str"))
		}
		replace_node(e, rt_call(pos, cstr("rt_str_cat"), args2(l, r), ty_string))
		e[N_TYPE] = 0
		if is_secret(t) != 0 {
			return t
		}
		return ty_string
	}
	if is_numeric_t(t) == 0 {
		err_code_type(pos, cstr("E236 OPERATOR"), cstr("arithmetic on "), t, cstr(""))
	}
	if is_float_t(t) != 0 && (streq(op, cstr("%")) != 0 || streq(op, cstr("&")) != 0 || streq(op, cstr("|")) != 0 || streq(op, cstr("^")) != 0) {
		err_code_quoted(pos, cstr("E236 OPERATOR"), cstr("operator "), op, cstr(" is not defined on floats"))
	}
	if k == K_UINT && l[N_KIND] == EX_INT && r[N_KIND] == EX_INT {
		if (streq(op, cstr("/")) != 0 || streq(op, cstr("%")) != 0) && r[INT_VAL] == 0 {
			err_code_at(pos, cstr("E222 DIVISION_BY_ZERO"), cstr("division by zero"))
			return ty_uint
		}
		replace_node(e, mk_int(pos, eval_binary(op, l[INT_VAL], r[INT_VAL]), 0))
		return ty_uint
	}
	if k == K_INT && is_const_zero(r) != 0 && (streq(op, cstr("/")) != 0 || streq(op, cstr("%")) != 0) {
		err_code_at(pos, cstr("E222 DIVISION_BY_ZERO"), cstr("division by zero"))
	}
	if is_f32(t) != 0 {
		// f32 arithmetic is f64 arithmetic rounded to f32 after each step (exact for + - * /).
		let inner = node_copy(e)
		inner[N_TYPE] = t
		replace_node(e, mk_conv(pos, inner, CV_ROUND32, t))
	}
	return t
}

// enum_incomparable returns a payload type of enum t without value equality (slices, maps,
// structs, funcs, optionals), or 0 when every variant compares by value.
fn enum_incomparable(t i64) i64 {
	let fs = t[TY_FIELDS]
	mut i = 1
	for i < fs[VEC_LEN] {
		let ft = field_type(t, i)
		let k = kind_of(ft)
		if k == K_STRUCT && ft[TY_ENUM] != 0 {
			if ft != t {
				let inner = enum_incomparable(ft)
				if inner != 0 {
					return inner
				}
			}
		} else if !(is_integer_t(ft) != 0 || is_float_t(ft) != 0 || k == K_BOOL || k == K_STRING || k == K_ERROR) {
			return ft
		}
		i = i + 1
	}
	return 0
}

shared mut enum_eq_types i64
shared mut enum_eq_fns i64

// lower_enum_eq compares two enum values by value (same variant, equal fields) through a
// generated eq function per enum, so recursive enums compare without expanding forever.
fn lower_enum_eq(e i64, op i64, l i64, r i64, t i64) i64 {
	let pos = e[N_POS]
	let bad = enum_incomparable(t)
	if bad != 0 {
		let u = err_code(pos, cstr("E237 COMPARE"))
		buf_str(u, cstr("cannot compare "))
		type_name(u, t)
		buf_str(u, cstr(" values: a variant holds "))
		type_name(u, bad)
		buf_str(u, cstr(", which has no value equality"))
		err_end(u)
		return ty_bool
	}
	mut x = call_fn(pos, enum_eq_fn(t), args2(l, r), ty_bool)
	if streq(op, cstr("!=")) != 0 {
		let n = node_new(EX_UNARY, pos)
		n[UN_OP] = cstr("!")
		n[UN_X] = x
		n[N_TYPE] = ty_bool
		x = n
	}
	replace_node(e, x)
	return ty_bool
}

fn enum_eq_fn(t i64) i64 {
	if enum_eq_types == 0 {
		enum_eq_types = vec_new()
		enum_eq_fns = vec_new()
	}
	mut i = 0
	for i < enum_eq_types[VEC_LEN] {
		if vec_get(enum_eq_types, i) == t {
			return vec_get(enum_eq_fns, i)
		}
		i = i + 1
	}
	let names = vec_new()
	vec_push(names, cstr("a"))
	vec_push(names, cstr("b"))
	let types = vec_new()
	vec_push(types, t)
	vec_push(types, t)
	let rts = vec_new()
	vec_push(rts, ty_bool)
	let f = lifted_fn(cstr("eq"), names, types, rts)
	vec_push(enum_eq_types, t)
	vec_push(enum_eq_fns, f)
	let saved_fn = ck_fn
	ck_fn = f
	let pos = 0
	let ls = vec_get(f[F_LOCALS], 0)
	let rs = vec_get(f[F_LOCALS], 1)
	let tag0 = field_offset(t, 0)
	mut x = mk_bin(pos, cstr("=="), mk_mem(pos, sym_ref_node(pos, ls), 0, 0, tag0, ty_int), mk_mem(pos, sym_ref_node(pos, rs), 0, 0, tag0, ty_int), ty_bool)
	let vs = t[TY_ENUM]
	mut vi = 0
	for vi < vs[VEC_LEN] {
		let v = vec_get(vs, vi)
		mut fe = 0
		mut k = 0
		for k < vec_get(v, 2) {
			let fi = vec_get(v, 1) + k
			let ft = field_type(t, fi)
			let a = mk_mem(pos, sym_ref_node(pos, ls), 0, 0, field_offset(t, fi), ft)
			let b = mk_mem(pos, sym_ref_node(pos, rs), 0, 0, field_offset(t, fi), ft)
			let c = binary_new(pos, cstr("=="), a, b)
			chk(c, ty_bool)
			if fe != 0 {
				fe = mk_bin(pos, cstr("&&"), fe, c, ty_bool)
			} else {
				fe = c
			}
			k = k + 1
		}
		if fe != 0 {
			let other = mk_bin(pos, cstr("!="), mk_mem(pos, sym_ref_node(pos, ls), 0, 0, tag0, ty_int), mk_int(pos, vi, ty_int), ty_bool)
			x = mk_bin(pos, cstr("&&"), x, mk_bin(pos, cstr("||"), other, fe, ty_bool), ty_bool)
		}
		vi = vi + 1
	}
	let ret = node_new(ST_RETURN, pos)
	ret[RET_VALUE] = x
	vec_push(f[F_BODY][BLK_STMTS], ret)
	ck_fn = saved_fn
	return f
}

// elem_bits is value v as the bits a slice element of type et holds (4 bytes for f32).
fn elem_bits(v i64, et i64) i64 {
	if is_f32(et) != 0 {
		return mk_conv(v[N_POS], v, CV_F2BITS32, ty_int)
	}
	return to_bits(v)
}

fn is_const_zero(e i64) i64 {
	return i64(e[N_KIND] == EX_INT && e[INT_VAL] == 0)
}

fn lower_str_cmp(e i64, op i64, l i64, r i64) {
	let pos = e[N_POS]
	if streq(op, cstr("==")) != 0 || streq(op, cstr("!=")) != 0 {
		mut eq = rt_call(pos, cstr("rt_str_eq"), args2(l, r), ty_bool)
		if streq(op, cstr("!=")) != 0 {
			let n = node_new(EX_UNARY, pos)
			n[UN_OP] = cstr("!")
			n[UN_X] = eq
			n[N_TYPE] = ty_bool
			eq = n
		}
		replace_node(e, eq)
		e[N_TYPE] = 0
		return
	}
	replace_node(e, mk_bin(pos, op, rt_call(pos, cstr("rt_str_cmp"), args2(l, r), ty_int), mk_int(pos, 0, ty_int), 0))
}

// ---- memory access ----
// mk_mem is a load or store of type t at base + index*scale + off.
fn mk_mem(pos i64, base i64, index i64, scale i64, off i64, t i64) i64 {
	let n = node_new(EX_MEM, pos)
	n[MEM_BASE] = base
	n[MEM_INDEX] = index
	n[MEM_SCALE] = scale
	n[MEM_OFF] = off
	n[N_TYPE] = t
	return n
}

// ---- map keys: struct and enum keys are encoded to bytes, so they compare by value ----
fn key_composite(t i64) i64 {
	return i64(kind_of(t) == K_STRUCT)
}

// map_str_keys reports whether a map with key type kt keeps str keys inside.
fn map_str_keys(kt i64) i64 {
	return i64(kind_of(kt) == K_STRING || key_composite(kt) != 0)
}

// key_in is key e as the word the runtime stores (bits, a str, or an encoded struct/enum).
fn key_in(e i64, kt i64) i64 {
	if key_composite(kt) == 0 {
		return to_bits(e)
	}
	let pos = e[N_POS]
	let stmts = vec_new()
	let b = temp(pos, rt_call(pos, cstr("rt_kb_new"), vec_new(), ty_int), ty_int)
	vec_push(stmts, b)
	vec_push(stmts, assign_stmt(pos, sym_ref_node(pos, b[LET_SYM]), call_fn(pos, key_enc_fn(kt), args2(sym_ref_node(pos, b[LET_SYM]), e), ty_int)))
	return mk_seq(pos, stmts, rt_call(pos, cstr("rt_kb_done"), args1(sym_ref_node(pos, b[LET_SYM])), ty_string), ty_string)
}

// key_out turns a stored key word back into a key of type kt.
fn key_out(e i64, kt i64) i64 {
	if key_composite(kt) == 0 {
		return from_bits(e, kt)
	}
	let pos = e[N_POS]
	let stmts = vec_new()
	vec_push(stmts, expr_stmt(rt_call(pos, cstr("rt_kd_begin"), vec_new(), ty_void)))
	return mk_seq(pos, stmts, call_fn(pos, key_dec_fn(kt), args1(mk_conv(pos, e, CV_SAME, ty_string)), kt), kt)
}

// map_set_call stores v under key k in map m.
fn map_set_call(pos i64, m i64, k i64, v i64, kt i64) i64 {
	if key_composite(kt) != 0 {
		return rt_call(pos, cstr("rt_map_setk"), args3(m, key_in(k, kt), to_bits(v)), ty_void)
	}
	// dup: the caller keeps no reference to the key it passes.
	return rt_call(pos, cstr("rt_map_set"), args4(m, to_bits(k), to_bits(v), mk_int(pos, 1, ty_int)), ty_void)
}

// map_make_call makes a map of type t (#176): counted sides carry their drops, so the
// runtime counts the entries of a long-lived map by itself (its m[9] decides).
fn map_make_call(pos i64, t i64) i64 {
	let counted = rc_map_bits(t)
	let isstr = mk_int(pos, map_str_keys(t[TY_KEY]), ty_int)
	if counted == 0 {
		return rt_call(pos, cstr("rt_map_make"), args1(isstr), t)
	}
	return rt_call(pos, cstr("rt_map_make_rc"), args3(isstr, fn_ref_node(pos, rc_map_drop(t)), mk_int(pos, counted, ty_int)), t)
}

// key_valid reports whether t can be a map key: str, numbers, bool, or structs and enums
// made of those (compared by value).
fn key_valid(t i64, path i64) i64 {
	let k = kind_of(t)
	if k == K_STRING || k == K_BOOL || is_integer_t(t) != 0 || is_float_t(t) != 0 {
		return 1
	}
	if k != K_STRUCT {
		return 0
	}
	mut i = 0
	for i < path[VEC_LEN] {
		if vec_get(path, i) == t {
			return i64(t[TY_ENUM] != 0)
		}
		i = i + 1
	}
	vec_push(path, t)
	mut ok = 1
	mut fi = 0
	for fi < t[TY_FIELDS][VEC_LEN] && ok != 0 {
		ok = key_valid(field_type(t, fi), path)
		fi = fi + 1
	}
	path[VEC_LEN] = path[VEC_LEN] - 1
	return ok
}

shared mut key_enc_types i64
shared mut key_enc_fns i64
shared mut key_dec_types i64
shared mut key_dec_fns i64

// key_enc_fn returns keyenc$N(b, x) b: x's bytes appended to byte slice b.
fn key_enc_fn(t i64) i64 {
	if key_enc_types == 0 {
		key_enc_types = vec_new()
		key_enc_fns = vec_new()
	}
	mut i = 0
	for i < key_enc_types[VEC_LEN] {
		if vec_get(key_enc_types, i) == t {
			return vec_get(key_enc_fns, i)
		}
		i = i + 1
	}
	let names = vec_new()
	vec_push(names, cstr("b"))
	vec_push(names, cstr("x"))
	let types = vec_new()
	vec_push(types, ty_int)
	vec_push(types, t)
	let rts = vec_new()
	vec_push(rts, ty_int)
	let f = lifted_fn(cstr("keyenc"), names, types, rts)
	vec_push(key_enc_types, t)
	vec_push(key_enc_fns, f)
	let saved_fn = ck_fn
	ck_fn = f
	let pos = 0
	let b = vec_get(f[F_LOCALS], 0)
	let x = vec_get(f[F_LOCALS], 1)
	let body = f[F_BODY][BLK_STMTS]
	if t[TY_ENUM] != 0 {
		key_enc_field(pos, body, b, x, t, 0)
		let vs = t[TY_ENUM]
		mut vi = 0
		for vi < vs[VEC_LEN] {
			let v = vec_get(vs, vi)
			let ifs = node_new(ST_IF, pos)
			ifs[IF_COND] = mk_bin(pos, cstr("=="), mk_mem(pos, sym_ref_node(pos, x), 0, 0, field_offset(t, 0), ty_int), mk_int(pos, vi, ty_int), ty_bool)
			ifs[IF_THEN] = empty_block(pos)
			mut k = 0
			for k < vec_get(v, 2) {
				key_enc_field(pos, ifs[IF_THEN][BLK_STMTS], b, x, t, vec_get(v, 1) + k)
				k = k + 1
			}
			vec_push(body, ifs)
			vi = vi + 1
		}
	} else {
		mut fi = 0
		for fi < t[TY_FIELDS][VEC_LEN] {
			key_enc_field(pos, body, b, x, t, fi)
			fi = fi + 1
		}
	}
	let ret = node_new(ST_RETURN, pos)
	ret[RET_VALUE] = sym_ref_node(pos, b)
	vec_push(body, ret)
	ck_fn = saved_fn
	return f
}

// key_enc_field appends `b = <field fi of x, encoded>` to body.
fn key_enc_field(pos i64, body i64, b i64, x i64, t i64, fi i64) {
	let ft = field_type(t, fi)
	let fv = mk_mem(pos, sym_ref_node(pos, x), 0, 0, field_offset(t, fi), ft)
	let k = kind_of(ft)
	mut nb = 0
	if k == K_BOOL {
		nb = rt_call(pos, cstr("rt_kb_word"), args2(sym_ref_node(pos, b), mk_conv(pos, fv, CV_SAME, ty_int)), ty_int)
	} else if k == K_STRING {
		nb = rt_call(pos, cstr("rt_kb_str"), args2(sym_ref_node(pos, b), fv), ty_int)
	} else if is_float_t(ft) != 0 {
		nb = rt_call(pos, cstr("rt_kb_word"), args2(sym_ref_node(pos, b), mk_conv(pos, fv, CV_F2BITS, ty_int)), ty_int)
	} else if k == K_STRUCT {
		nb = call_fn(pos, key_enc_fn(ft), args2(sym_ref_node(pos, b), fv), ty_int)
	} else {
		nb = rt_call(pos, cstr("rt_kb_word"), args2(sym_ref_node(pos, b), mk_conv(pos, fv, CV_INT, ty_int)), ty_int)
	}
	vec_push(body, assign_stmt(pos, sym_ref_node(pos, b), nb))
}

// key_dec_fn returns keydec$N(s) T: the key encoded in s, read from rt_kd's offset.
fn key_dec_fn(t i64) i64 {
	if key_dec_types == 0 {
		key_dec_types = vec_new()
		key_dec_fns = vec_new()
	}
	mut i = 0
	for i < key_dec_types[VEC_LEN] {
		if vec_get(key_dec_types, i) == t {
			return vec_get(key_dec_fns, i)
		}
		i = i + 1
	}
	let names = vec_new()
	vec_push(names, cstr("s"))
	let types = vec_new()
	vec_push(types, ty_string)
	let rts = vec_new()
	vec_push(rts, t)
	let f = lifted_fn(cstr("keydec"), names, types, rts)
	vec_push(key_dec_types, t)
	vec_push(key_dec_fns, f)
	let saved_fn = ck_fn
	ck_fn = f
	let pos = 0
	let s = vec_get(f[F_LOCALS], 0)
	let body = f[F_BODY][BLK_STMTS]
	let obj = temp(pos, rt_call(pos, cstr("rt_alloc"), args1(mk_int(pos, t[TY_SIZE], ty_int)), t), t)
	vec_push(body, obj)
	if t[TY_ENUM] != 0 {
		key_dec_field(pos, body, s, obj[LET_SYM], t, 0)
		let vs = t[TY_ENUM]
		mut vi = 0
		for vi < vs[VEC_LEN] {
			let v = vec_get(vs, vi)
			let ifs = node_new(ST_IF, pos)
			ifs[IF_COND] = mk_bin(pos, cstr("=="), mk_mem(pos, sym_ref_node(pos, obj[LET_SYM]), 0, 0, field_offset(t, 0), ty_int), mk_int(pos, vi, ty_int), ty_bool)
			ifs[IF_THEN] = empty_block(pos)
			mut k = 0
			for k < vec_get(v, 2) {
				key_dec_field(pos, ifs[IF_THEN][BLK_STMTS], s, obj[LET_SYM], t, vec_get(v, 1) + k)
				k = k + 1
			}
			vec_push(body, ifs)
			vi = vi + 1
		}
	} else {
		mut fi = 0
		for fi < t[TY_FIELDS][VEC_LEN] {
			key_dec_field(pos, body, s, obj[LET_SYM], t, fi)
			fi = fi + 1
		}
	}
	let ret = node_new(ST_RETURN, pos)
	ret[RET_VALUE] = sym_ref_node(pos, obj[LET_SYM])
	vec_push(body, ret)
	ck_fn = saved_fn
	return f
}

fn key_dec_field(pos i64, body i64, s i64, obj i64, t i64, fi i64) {
	let ft = field_type(t, fi)
	let k = kind_of(ft)
	mut v = 0
	if k == K_BOOL {
		v = mk_conv(pos, rt_call(pos, cstr("rt_kd_word"), args1(sym_ref_node(pos, s)), ty_int), CV_SAME, ft)
	} else if k == K_STRING {
		v = rt_call(pos, cstr("rt_kd_str"), args1(sym_ref_node(pos, s)), ty_string)
	} else if is_float_t(ft) != 0 {
		v = mk_conv(pos, rt_call(pos, cstr("rt_kd_word"), args1(sym_ref_node(pos, s)), ty_int), CV_BITS2F, ft)
	} else if k == K_STRUCT {
		v = call_fn(pos, key_dec_fn(ft), args1(sym_ref_node(pos, s)), ft)
	} else {
		v = mk_conv(pos, rt_call(pos, cstr("rt_kd_word"), args1(sym_ref_node(pos, s)), ty_int), CV_INT, ft)
	}
	vec_push(body, assign_stmt(pos, field_store(pos, sym_ref_node(pos, obj), t, fi), v))
}

// map_read is m[k]: a missing key reads as the value type's zero, and a str, slice, map
// or struct zero is a real (never nil) value.
fn map_read(pos i64, m i64, k i64, vt i64) i64 {
	let get = from_bits(rt_call(pos, cstr("rt_map_get"), args2(m, key_in(k, m[N_TYPE][TY_KEY])), ty_int), vt)
	let vk = kind_of(vt)
	if !(vk == K_STRING || vk == K_SLICE || vk == K_MAP || vk == K_STRUCT) {
		return get
	}
	let stmts = vec_new()
	let tmp = temp(pos, get, vt)
	vec_push(stmts, tmp)
	let ifs = node_new(ST_IF, pos)
	ifs[IF_COND] = mk_unot(pos, rt_call(pos, cstr("rt_map_found"), vec_new(), ty_bool))
	ifs[IF_THEN] = empty_block(pos)
	mut alt = 0
	if vk == K_STRING {
		alt = lit_string(pos, cstr(""))
	} else if vk == K_SLICE {
		alt = intrinsic_call(pos, cstr("__empty"), vec_new(), vt)
	} else {
		alt = argo_new(pos, ifs[IF_THEN][BLK_STMTS], vt)
	}
	vec_push(ifs[IF_THEN][BLK_STMTS], assign_stmt(pos, sym_ref_node(pos, tmp[LET_SYM]), alt))
	vec_push(stmts, ifs)
	return mk_seq(pos, stmts, sym_ref_node(pos, tmp[LET_SYM]), vt)
}

// mk_elem indexes a slice or string; the backend checks the index against the length
// unless ELEM_SAFE is set (the checker proved it in range).
fn mk_elem(pos i64, seq i64, index i64, t i64, isstr i64) i64 {
	let n = node_new(EX_ELEM, pos)
	n[ELEM_SEQ] = seq
	n[ELEM_IDX] = index
	n[ELEM_SIZE] = type_width(t)
	n[ELEM_STR] = isstr
	n[N_TYPE] = t
	return n
}

fn chk_index(e i64) i64 {
	let pos = e[N_POS]
	let x = e[IX_X]
	let xt = chk(x, 0)
	let k = kind_of(xt)
	if (k == K_INT && ck_trusted != 0) {
		// Raw word indexing: trusted code (the runtime's own memory management, the compiler's records).
		chk(e[IX_I], ty_int)
		reconvert(e[IX_I], ty_int)
		return ty_int
	}
	if k == K_MAP {
		let kt = chk(e[IX_I], xt[TY_KEY])
		check_assignable(e[IX_I], kt, xt[TY_KEY])
		if is_untyped(kt) != 0 {
			reconvert(e[IX_I], xt[TY_KEY])
		}
		replace_node(e, map_read(pos, x, e[IX_I], xt[TY_ELEM]))
		e[N_TYPE] = 0
		if is_secret(xt) != 0 {
			return secret_of(xt[TY_ELEM])
		}
		return xt[TY_ELEM]
	}
	let it = chk(e[IX_I], ty_int)
	if is_integer_t(it) == 0 {
		err_code_type(pos, cstr("E238 INDEX"), cstr("index must be an integer, not "), it, cstr(""))
	}
	if kind_of(it) == K_UINT {
		reconvert(e[IX_I], ty_int)
	}
	if k == K_STRING {
		replace_node(e, mk_elem(pos, x, e[IX_I], ty_byte, 1))
		mark_safe_index(e)
		e[N_TYPE] = 0
		if is_secret(xt) != 0 || is_secret(it) != 0 {
			return secret_of(ty_byte)
		}
		return ty_byte
	}
	if k == K_SLICE {
		replace_node(e, mk_elem(pos, x, e[IX_I], xt[TY_ELEM], 0))
		mark_safe_index(e)
		e[N_TYPE] = 0
		if is_secret(xt) != 0 || is_secret(it) != 0 {
			return secret_of(xt[TY_ELEM])
		}
		return xt[TY_ELEM]
	}
	err_code_type(pos, cstr("E238 INDEX"), cstr("cannot index "), xt, cstr(""))
	return ty_int
}

fn chk_slice(e i64) i64 {
	let pos = e[N_POS]
	let x = e[SL_X]
	let xt = chk(x, 0)
	mut lo = e[SL_LO]
	mut hi = e[SL_HI]
	if lo != 0 {
		chk(lo, ty_int)
		reconvert(lo, ty_int)
	} else {
		lo = mk_int(pos, 0, ty_int)
	}
	// has_hi tells the runtime whether an upper bound was written (a negative one must panic).
	let has_hi = mk_int(pos, i64(hi != 0), ty_int)
	if hi != 0 {
		chk(hi, ty_int)
		reconvert(hi, ty_int)
	} else {
		hi = mk_int(pos, 0, ty_int)
	}
	if kind_of(xt) == K_STRING {
		replace_node(e, rt_call(pos, cstr("rt_str_sub"), args4(x, lo, hi, has_hi), ty_string))
		e[N_TYPE] = 0
		if is_secret(xt) != 0 {
			return xt
		}
		return ty_string
	}
	if kind_of(xt) == K_SLICE {
		replace_node(e, rt_call(pos, cstr("rt_slice_sub"), args5(x, lo, hi, mk_int(pos, elem_size(xt), ty_int), has_hi), xt))
		e[N_TYPE] = 0
		return xt
	}
	err_code_type(pos, cstr("E238 INDEX"), cstr("cannot slice "), xt, cstr(""))
	return ty_int
}

// pkg_member resolves pkg.name to its global symbol, or 0.
fn pkg_member(pkg i64, name i64) i64 {
	return lookup_global(str_cat3(pkg, cstr("."), name))
}

// is_private reports whether name is private to its package (not capitalized).
fn is_private(name i64) i64 {
	let c = i64(load8(name))
	return i64((c >= 'a' && c <= 'z') || c == '_')
}

// foreign_type reports whether struct type t was declared in a package other than the one
// being checked (its name is pkg.Name with pkg not the current package).
fn foreign_type(t i64) i64 {
	let n = t[TY_NAME]
	if n == 0 {
		return 0
	}
	mut i = 0
	for i64(load8(n + i)) != 0 && i64(load8(n + i)) != '.' && i64(load8(n + i)) != '[' {
		i = i + 1
	}
	if i64(load8(n + i)) != '.' {
		return 0
	}
	mut j = 0
	for j < i {
		if i64(load8(ck_pkg + j)) != i64(load8(n + j)) {
			return 1
		}
		j = j + 1
	}
	return i64(i64(load8(ck_pkg + i)) != 0)
}

// private_use reports (once) a private name of another package used here.
fn private_use(pos i64, what i64, name i64, owner i64) {
	let m = err_code(pos, cstr("E104 PRIVATE"))
	buf_str(m, what)
	buf_str(m, cstr(" "))
	buf_str(m, name)
	buf_str(m, cstr(" is private to "))
	buf_str(m, owner)
	buf_str(m, cstr(": only capitalized names are exported"))
	err_end(m)
}

// type_pkg is the package part of struct type t's name (for messages).
fn type_pkg(t i64) i64 {
	let n = t[TY_NAME]
	mut i = 0
	for i64(load8(n + i)) != 0 && i64(load8(n + i)) != '.' {
		i = i + 1
	}
	return str_slice(n, i)
}

// enum_type_of returns the enum type x names (Shape, geo.Shape, Option[i64]), or 0.
fn enum_type_of(x i64) i64 {
	mut t = 0
	if x[N_KIND] == EX_IDENT {
		if lookup_name_local(x[ID_NAME]) != 0 || import_pkg(x[ID_NAME]) != 0 {
			return 0
		}
		let s = lookup_name(x[ID_NAME])
		if s != 0 {
			return 0
		}
		t = find_type_name(x[ID_NAME])
	} else if x[N_KIND] == EX_SELECT {
		let px = x[SEL_X]
		if px[N_KIND] != EX_IDENT || lookup_name_local(px[ID_NAME]) != 0 || import_pkg(px[ID_NAME]) == 0 {
			return 0
		}
		t = find_type(str_cat3(import_pkg(px[ID_NAME]), cstr("."), x[SEL_NAME]))
	} else if x[N_KIND] == EX_INDEX {
		// Option[i64].Some(3): only when the base names a type, not a value.
		let base = x[IX_X]
		if base[N_KIND] != EX_IDENT || lookup_name_local(base[ID_NAME]) != 0 || lookup_name(base[ID_NAME]) != 0 || !(find_generic(base[ID_NAME]) != 0 || (i64(load8(ck_pkg)) != 0 && find_generic(qual(ck_pkg, base[ID_NAME])) != 0)) {
			return 0
		}
		let gtx = expr_to_tx(x)
		if gtx != 0 {
			t = resolve_type(gtx)
		}
	}
	if t != 0 && kind_of(t) == K_STRUCT && t[TY_ENUM] != 0 {
		return t
	}
	return 0
}

// enum_variant is the index of variant name in enum t, or -1.
fn enum_variant(t i64, name i64) i64 {
	let vs = t[TY_ENUM]
	mut i = 0
	for i < vs[VEC_LEN] {
		if streq(vec_get(vec_get(vs, i), 0), name) != 0 {
			return i
		}
		i = i + 1
	}
	return -1
}

// enum_construct builds Shape.Circle(2.0): a tagged object whose other variants' fields
// hold their zero values.
fn enum_construct(e i64, t i64, name i64, args i64) i64 {
	let pos = e[N_POS]
	let vi = enum_variant(t, name)
	if vi < 0 {
		let u = err_code(pos, cstr("E239 VARIANT"))
		type_name(u, t)
		buf_str(u, cstr(" has no variant "))
		buf_str(u, name)
		err_end(u)
		return t
	}
	if is_private(name) != 0 && foreign_type(t) != 0 {
		private_use(pos, cstr("variant"), name, type_pkg(t))
	}
	let v = vec_get(t[TY_ENUM], vi)
	let first = vec_get(v, 1)
	let nf = vec_get(v, 2)
	if args[VEC_LEN] != nf {
		let u = err_code(pos, cstr("E239 VARIANT"))
		type_name(u, t)
		buf_byte(u, '.')
		buf_str(u, name)
		buf_str(u, cstr(" takes "))
		buf_int(u, nf)
		if nf == 1 {
			buf_str(u, cstr(" value, got "))
		} else {
			buf_str(u, cstr(" values, got "))
		}
		buf_int(u, args[VEC_LEN])
		err_end(u)
		return t
	}
	let stmts = vec_new()
	let obj = temp(pos, rt_call(pos, cstr("rt_alloc"), args1(mk_int(pos, t[TY_SIZE], ty_int)), t), t)
	vec_push(stmts, obj)
	vec_push(stmts, assign_stmt(pos, field_store(pos, sym_ref_node(pos, obj[LET_SYM]), t, 0), mk_int(pos, vi, ty_int)))
	let total = t[TY_FIELDS][VEC_LEN]
	mut i = 1
	for i < total {
		if i >= first && i < first + nf {
			let a = vec_get(args, i - first)
			unwrap_mut(a)
			let ft = field_type(t, i)
			let at = chk(a, ft)
			check_assignable(a, at, ft)
			if is_untyped(at) != 0 {
				reconvert(a, ft)
			}
			vec_push(stmts, assign_stmt(pos, field_store(pos, sym_ref_node(pos, obj[LET_SYM]), t, i), a))
		}
		// Other variants' fields stay empty: only a switch on the tag can reach them.
		i = i + 1
	}
	replace_node(e, mk_seq(pos, stmts, sym_ref_node(pos, obj[LET_SYM]), 0))
	return t
}

fn chk_select(e i64, want i64) i64 {
	let pos = e[N_POS]
	let x = e[SEL_X]
	let name = e[SEL_NAME]
	let et = enum_type_of(x)
	if et != 0 {
		return enum_construct(e, et, name, vec_new())
	}
	if x[N_KIND] == EX_IDENT && lookup_name_local(x[ID_NAME]) == 0 {
		let pkg = import_pkg(x[ID_NAME])
		if pkg != 0 {
			let s = pkg_member(pkg, name)
			if s == 0 {
				let u = err_code(pos, cstr("E103 UNDEFINED"))
				buf_str(u, cstr("undefined: "))
				buf_str(u, x[ID_NAME])
				buf_byte(u, '.')
				buf_str(u, name)
				err_end(u)
				return ty_int
			}
			if is_private(name) != 0 {
				private_use(pos, cstr("name"), name, pkg)
			}
			replace_node(e, node_new(EX_IDENT, pos))
			e[ID_NAME] = name
			return use_sym(e, s, want)
		}
	}
	let xt = chk(x, 0)
	if kind_of(xt) == K_OPT {
		err_code_type(pos, cstr("E421 UNCHECKED_OPTIONAL"), cstr("cannot use a field of optional "), xt, cstr(" before checking it against nil"))
		return ty_int
	}
	if kind_of(xt) == K_STRUCT && xt[TY_ENUM] != 0 {
		err_code_type(pos, cstr("E213 FIELD"), cstr("an enum's data is read with switch, not as a field of "), xt, cstr(""))
		return ty_int
	}
	if kind_of(xt) == K_DYN {
		err_code_at(pos, cstr("E530 DYN_NOT_YET"), cstr("a method value on a dyn value needs the table: the next step (#141)"))
		return ty_int
	}
	if kind_of(xt) == K_STRUCT {
		let i = struct_field(xt, name)
		if i < 0 {
			let u = err_code(pos, cstr("E213 FIELD"))
			type_name(u, xt)
			buf_str(u, cstr(" has no field "))
			buf_str(u, name)
			err_end(u)
			return ty_int
		}
		if is_private(name) != 0 && foreign_type(xt) != 0 {
			private_use(pos, cstr("field"), name, type_pkg(xt))
		}
		replace_node(e, mk_mem(pos, x, 0, 0, field_offset(xt, i), 0))
		return field_type(xt, i)
	}
	err_code_type(pos, cstr("E213 FIELD"), cstr("cannot select a field of "), xt, cstr(""))
	return ty_int
}

fn lookup_name_local(name i64) i64 {
	mut i = sc_syms[VEC_LEN] - 1
	for i >= 0 {
		if streq(vec_get(sc_syms, i)[S_NAME], name) != 0 {
			return vec_get(sc_syms, i)
		}
		i = i - 1
	}
	return 0
}

// field_store builds the target for storing into field fi of struct object obj.
fn field_store(pos i64, obj i64, t i64, fi i64) i64 {
	return mk_mem(pos, obj, 0, 0, field_offset(t, fi), field_type(t, fi))
}

// chk_composite allocates a struct, slice or map and fills it, as an EX_SEQ.
fn chk_composite(e i64, want i64) i64 {
	let pos = e[N_POS]
	let tx = e[CL_TYPE]
	mut t = want
	if kind_of(t) == K_OPT {
		t = t[TY_ELEM]
	}
	if tx[N_KIND] == EX_TYPE && tx[TYX] != 0 {
		t = resolve_type(tx[TYX])
	} else if tx[N_KIND] == EX_INDEX {
		let gtx = expr_to_tx(tx)
		if gtx != 0 {
			t = resolve_type(gtx)
		}
	} else if tx[N_KIND] == EX_IDENT || tx[N_KIND] == EX_SELECT {
		let tn = node_new(TX_NAME, pos)
		if tx[N_KIND] == EX_IDENT {
			tn[TX_B] = tx[ID_NAME]
		} else {
			tn[TX_A] = tx[SEL_X][ID_NAME]
			tn[TX_B] = tx[SEL_NAME]
		}
		t = resolve_type(tn)
	}
	if t == 0 {
		err_code_at(pos, cstr("E216 COMPOSITE"), cstr("missing type in composite literal"))
		return ty_int
	}
	let elems = e[CL_ELEMS]
	let keys = e[CL_KEYS]
	let stmts = vec_new()
	let k = kind_of(t)
	if k == K_STRUCT && t[TY_ENUM] != 0 {
		err_code_type(pos, cstr("E216 COMPOSITE"), cstr("build an enum with one of its variants ("), t, cstr(".Variant(...)), not a composite literal"))
		return t
	}
	if k == K_STRUCT {
		let nf = t[TY_FIELDS][VEC_LEN]
		let obj = temp(pos, rt_call(pos, cstr("rt_alloc"), args1(mk_int(pos, t[TY_SIZE], ty_int)), t), t)
		vec_push(stmts, obj)
		let set = vec_filled(nf, 0)
		mut i = 0
		for i < elems[VEC_LEN] {
			mut fi = i
			let key = vec_get(keys, i)
			if key != 0 {
				if key[N_KIND] != EX_IDENT {
					err_code_at(key[N_POS], cstr("E216 COMPOSITE"), cstr("expected a field name"))
					return t
				}
				fi = struct_field(t, key[ID_NAME])
				if fi < 0 {
					err_code_quoted(key[N_POS], cstr("E216 COMPOSITE"), cstr("unknown field "), key[ID_NAME], cstr(""))
					return t
				}
				if is_private(key[ID_NAME]) != 0 && foreign_type(t) != 0 {
					private_use(key[N_POS], cstr("field"), key[ID_NAME], type_pkg(t))
				}
			} else if fi >= nf {
				err_code_at(pos, cstr("E216 COMPOSITE"), cstr("too many values in struct literal"))
				return t
			} else if foreign_type(t) != 0 && is_private(vec_get(vec_get(t[TY_FIELDS], fi), 0)) != 0 {
				// A positional value sets the field as surely as its name would (#96).
				private_use(vec_get(elems, i)[N_POS], cstr("field"), vec_get(vec_get(t[TY_FIELDS], fi), 0), type_pkg(t))
			}
			set[VEC_DATA][fi] = 1
			let ft = field_type(t, fi)
			let v = vec_get(elems, i)
			let vt = chk(v, ft)
			check_assignable(v, vt, ft)
			if is_untyped(vt) != 0 {
				reconvert(v, ft)
			}
			if !(is_const_zero(v) != 0 && is_ref(ft) == 0) {
				vec_push(stmts, assign_stmt(pos, field_store(pos, sym_ref_node(pos, obj[LET_SYM]), t, fi), v))
			}
			i = i + 1
		}
		// Fields left out get their zero value; references that cannot be nil must be set.
		i = 0
		for i < nf {
			if vec_get(set, i) == 0 {
				init_zero_field(pos, stmts, obj[LET_SYM], t, i)
			}
			i = i + 1
		}
		replace_node(e, mk_seq(pos, stmts, sym_ref_node(pos, obj[LET_SYM]), 0))
		return t
	}
	if k == K_SLICE {
		let n = elems[VEC_LEN]
		let et = t[TY_ELEM]
		let sl = temp(pos, rt_call(pos, cstr("rt_slice_make"), args3(mk_int(pos, n, ty_int), mk_int(pos, n, ty_int), mk_int(pos, elem_size(t), ty_int)), t), t)
		vec_push(stmts, sl)
		let data = temp(pos, mk_hdr(pos, sym_ref_node(pos, sl[LET_SYM]), 2), ty_int)
		vec_push(stmts, data)
		mut i = 0
		for i < n {
			let v = vec_get(elems, i)
			let vt = chk(v, et)
			check_assignable(v, vt, et)
			if is_untyped(vt) != 0 {
				reconvert(v, et)
			}
			vec_push(stmts, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, data[LET_SYM]), 0, 0, i * type_width(et), et), v))
			i = i + 1
		}
		replace_node(e, mk_seq(pos, stmts, sym_ref_node(pos, sl[LET_SYM]), 0))
		return t
	}
	if k == K_MAP {
		let m = temp(pos, map_make_call(pos, t), t)
		vec_push(stmts, m)
		mut i = 0
		for i < elems[VEC_LEN] {
			let key = vec_get(keys, i)
			let v = vec_get(elems, i)
			if key == 0 {
				err_code_at(v[N_POS], cstr("E216 COMPOSITE"), cstr("missing key in map literal"))
				return t
			}
			let kt = chk(key, t[TY_KEY])
			check_assignable(key, kt, t[TY_KEY])
			if is_untyped(kt) != 0 {
				reconvert(key, t[TY_KEY])
			}
			let vt = chk(v, t[TY_ELEM])
			check_assignable(v, vt, t[TY_ELEM])
			if is_untyped(vt) != 0 {
				reconvert(v, t[TY_ELEM])
			}
			vec_push(stmts, expr_stmt(map_set_call(pos, sym_ref_node(pos, m[LET_SYM]), key, v, t[TY_KEY])))
			i = i + 1
		}
		replace_node(e, mk_seq(pos, stmts, sym_ref_node(pos, m[LET_SYM]), 0))
		return t
	}
	err_code_type(pos, cstr("E216 COMPOSITE"), cstr("cannot build a composite literal of type "), t, cstr(""))
	return ty_int
}

// init_zero_field stores the zero value of a field the literal left out. Memory is
// already zeroed, so only references need work: "" and empty slices are static
// objects, and structs, maps and funcs have no zero value at all.
fn init_zero_field(pos i64, stmts i64, obj i64, t i64, fi i64) {
	let ft = field_type(t, fi)
	let k = kind_of(ft)
	let rec = vec_get(t[TY_FIELDS], fi)
	if k == K_SLICE && rec[VEC_LEN] > 4 && vec_get(rec, 3) > 0 {
		array_inner = vec_get(rec, 4)
		vec_push(stmts, assign_stmt(pos, field_store(pos, sym_ref_node(pos, obj), t, fi), array_make(pos, ft, vec_get(rec, 3))))
		return
	}
	if k == K_STRING || k == K_SLICE {
		vec_push(stmts, assign_stmt(pos, field_store(pos, sym_ref_node(pos, obj), t, fi), zero_value(pos, ft)))
	} else if k == K_STRUCT || k == K_MAP || k == K_FUNC || k == K_DYN {
		let m = err_code(pos, cstr("E203 NO_ZERO_VALUE"))
		buf_str(m, cstr("field "))
		buf_str(m, vec_get(vec_get(t[TY_FIELDS], fi), 0))
		buf_str(m, cstr(" of type "))
		type_name(m, ft)
		if k == K_DYN {
			buf_str(m, cstr(" must be set (a dyn value has no zero; the table comes with the next step, #141)"))
		} else {
			buf_str(m, cstr(" must be set (it cannot be nil; declare it ?T to allow that)"))
		}
		err_end(m)
	}
}

fn get_cell_addr(pos i64, os i64) i64 {
	if os[S_CAPTURED] != 0 {
		return mk_mem(pos, sym_ref_node(pos, ck_fn[F_ENV_SYM]), 0, 0, 8 * (2 + os[S_CAP_IDX]), ty_int)
	}
	if os[S_CELL] != 0 {
		return sym_ref_node(pos, os[S_CELL_SYM])
	}
	os[S_ADDR] = 1
	return mk_unary(pos, cstr("&"), sym_ref_node(pos, os))
}

// closure_keeper builds keep$N(d), which copies closure descriptor d and its captured
// variables into the long-lived heap, each value kept by its type (a str, slice, struct or
// closure deeply), so a kept closure never reads request memory (#170). It returns 0 when
// no captured variable holds a reference.
fn closure_keeper(pos i64, cf i64) i64 {
	let caps = cf[F_CAPTURES]
	let k = caps[VEC_LEN]
	mut refs = 0
	mut i = 0
	for i < k {
		let ct = vec_get(caps, i)[S_TYPE]
		if is_ref(ct) != 0 || is_dyn_value(ct) != 0 {
			refs = 1
		}
		i = i + 1
	}
	if refs == 0 {
		return 0
	}
	lifted_count = lifted_count + 1
	let f = fn_new(pos, cstr("keep"))
	let nb = buf_new()
	buf_str(nb, cstr("keep$"))
	buf_int(nb, lifted_count)
	buf_byte(nb, 0)
	f[F_QNAME] = nb[VEC_DATA]
	f[F_NAME] = nb[VEC_DATA]
	f[F_LIFTED] = 2
	f[F_FILE] = cf[F_FILE]
	vec_push(f[F_PARAMS], cstr("d"))
	vec_push(f[F_PTYPES], ty_int)
	vec_push(f[F_RTYPES], ty_int)
	f[F_TYPE] = func_of(f[F_PTYPES], f[F_RTYPES], 0)
	f[F_LOCALS] = vec_new()
	f[F_BODY] = empty_block(pos)
	vec_push(prog_fns, f)
	let saved_fn = ck_fn
	ck_fn = f
	let d = sym_new(SYM_LOCAL, cstr("d"), pos)
	d[S_TYPE] = ty_int
	d[S_SLOT] = 0
	f[F_SLOTS] = 1
	vec_push(f[F_LOCALS], d)
	let body = f[F_BODY][BLK_STMTS]
	let nd = temp(pos, rt_call(pos, cstr("rt_ingot_alloc"), args1(mk_int(pos, 8 * (3 + k), ty_int)), ty_int), ty_int)
	vec_push(body, nd)
	mut w = 0
	for w < 2 {
		vec_push(body, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, nd[LET_SYM]), 0, 0, 8 * w, ty_int), mk_mem(pos, sym_ref_node(pos, d), 0, 0, 8 * w, ty_int)))
		w = w + 1
	}
	vec_push(body, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, nd[LET_SYM]), 0, 0, 8 * (2 + k), ty_int), mk_mem(pos, sym_ref_node(pos, d), 0, 0, 8 * (2 + k), ty_int)))
	i = 0
	for i < k {
		let ct = vec_get(caps, i)[S_TYPE]
		let cell = temp(pos, rt_call(pos, cstr("rt_ingot_alloc"), args1(mk_int(pos, 8, ty_int)), ty_int), ty_int)
		vec_push(body, cell)
		let old = mk_mem(pos, mk_mem(pos, sym_ref_node(pos, d), 0, 0, 8 * (2 + i), ty_int), 0, 0, 0, ct)
		mut val = old
		if is_ref(ct) != 0 || is_dyn_value(ct) != 0 {
			val = keep_call(pos, keep_fn(ct), old, ct)
		}
		vec_push(body, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, cell[LET_SYM]), 0, 0, 0, ct), val))
		vec_push(body, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, nd[LET_SYM]), 0, 0, 8 * (2 + i), ty_int), sym_ref_node(pos, cell[LET_SYM])))
		i = i + 1
	}
	let ret = node_new(ST_RETURN, pos)
	ret[RET_VALUE] = sym_ref_node(pos, nd[LET_SYM])
	vec_push(body, ret)
	ck_fn = saved_fn
	return f
}

// chk_funclit lifts a function literal to a top-level function. Literals may capture
// variables from enclosing scopes: non-escaping closures allocate frame descriptors
// and cells on stack (0 bytes allocated), while escaping closures allocate region objects.
fn chk_funclit(e i64) i64 {
	let f = e[LIT_FN]
	lifted_count = lifted_count + 1
	let b = buf_new()
	buf_str(b, cstr("func$"))
	buf_int(b, lifted_count)
	buf_byte(b, 0)
	f[F_NAME] = b[VEC_DATA]
	f[F_FILE] = ck_file
	f[F_LIFTED] = 1
	f[F_QNAME] = f[F_NAME]
	f[F_PARENT] = ck_fn
	f[F_CAPTURES] = vec_new()
	f[F_OUTER_SYMS] = vec_clone(sc_syms)
	f[F_ESCAPES] = e[LIT_ESCAPE]
	if e[LIT_SCOPED] != 0 {
		f[F_ESCAPES] = 0
	}

	let saved_fn = ck_fn
	declare_fn(f)
	ck_fn = saved_fn

	check_fn_closure(f)
	sb_captures(e, f)
	f[F_DONE] = 1
	vec_push(prog_fns, f)

	let k = f[F_CAPTURES][VEC_LEN]
	if k == 0 {
		replace_node(e, node_new(EX_FUNCREF, e[N_POS]))
		e[FR_FN] = f
		return f[F_TYPE]
	}

	let pos = e[N_POS]
	let fn_ref = node_new(EX_FUNCREF, pos)
	fn_ref[FR_FN] = f
	fn_ref[FR_RAW] = 1
	fn_ref[N_TYPE] = ty_int

	let stmts = vec_new()
	mut desc_val = 0

	if e[LIT_ESCAPE] == 0 {
		let desc_sym = declare_local(pos, cstr("$desc"), ty_int)
		desc_sym[S_ADDR] = 1
		desc_sym[S_WORDS] = 3 + k
		let desc_addr = mk_unary(pos, cstr("&"), sym_ref_node(pos, desc_sym))
		let dptr = temp(pos, desc_addr, ty_int)
		vec_push(stmts, dptr)
		let dref = sym_ref_node(pos, dptr[LET_SYM])

		vec_push(stmts, assign_stmt(pos, mk_mem(pos, dref, 0, 0, 0, ty_int), fn_ref))
		vec_push(stmts, assign_stmt(pos, mk_mem(pos, dref, 0, 0, 8, ty_int), mk_int(pos, k, ty_int)))

		mut i = 0
		for i < k {
			let os = vec_get(f[F_CAPTURES], i)
			let cell_expr = get_cell_addr(pos, os)
			vec_push(stmts, assign_stmt(pos, mk_mem(pos, dref, 0, 0, 8 * (2 + i), ty_int), cell_expr))
			i = i + 1
		}
		// A frame descriptor is never kept (the closure is only called): no keeper.
		vec_push(stmts, assign_stmt(pos, mk_mem(pos, dref, 0, 0, 8 * (2 + k), ty_int), mk_int(pos, 0, ty_int)))
		desc_val = dref
	} else {
		let alloc_call = rt_call(pos, cstr("rt_alloc"), args1(mk_int(pos, 8 * (3 + k), ty_int)), ty_int)
		let obj = temp(pos, alloc_call, ty_int)
		vec_push(stmts, obj)
		let dref = sym_ref_node(pos, obj[LET_SYM])

		vec_push(stmts, assign_stmt(pos, mk_mem(pos, dref, 0, 0, 0, ty_int), fn_ref))
		vec_push(stmts, assign_stmt(pos, mk_mem(pos, dref, 0, 0, 8, ty_int), mk_int(pos, k, ty_int)))

		mut i = 0
		for i < k {
			let os = vec_get(f[F_CAPTURES], i)
			let cell_expr = get_cell_addr(pos, os)
			vec_push(stmts, assign_stmt(pos, mk_mem(pos, dref, 0, 0, 8 * (2 + i), ty_int), cell_expr))
			i = i + 1
		}
		// Word 2 + k: the function keep() calls to copy this closure deeply (0: no captured
		// variable holds a reference, so copying the words is enough).
		let keeper = closure_keeper(pos, f)
		mut kv = mk_int(pos, 0, ty_int)
		if keeper != 0 {
			kv = node_new(EX_FUNCREF, pos)
			kv[FR_FN] = keeper
			kv[N_TYPE] = ty_int
		}
		vec_push(stmts, assign_stmt(pos, mk_mem(pos, dref, 0, 0, 8 * (2 + k), ty_int), kv))
		desc_val = dref
	}

	let seq = mk_seq(pos, stmts, desc_val, f[F_TYPE])
	replace_node(e, seq)
	return f[F_TYPE]
}

// chk_unit turns an edition 1 unit literal (200ms, 4mb) into its integer constant:
// nanoseconds for a duration, bytes for a size (design_syntax §2).
fn chk_unit(e i64, want i64) i64 {
	let pos = e[N_POS]
	let u = e[UNIT_NAME]
	if e[UNIT_FLOAT] != 0 {
		err_code_at(pos, cstr("E012 NUMERIC_UNIT"), cstr("a fractional unit literal is not supported yet: write it in a smaller unit (2500ms, not 2.5s)"))
		return ty_int
	}
	mut scale = 1
	if streq(u, cstr("us")) != 0 {
		scale = 1000
	} else if streq(u, cstr("ms")) != 0 {
		scale = 1000000
	} else if streq(u, cstr("s")) != 0 {
		scale = 1000000000
	} else if streq(u, cstr("m")) != 0 {
		scale = 60000000000
	} else if streq(u, cstr("h")) != 0 {
		scale = 3600000000000
	} else if streq(u, cstr("kb")) != 0 {
		scale = 1024
	} else if streq(u, cstr("mb")) != 0 {
		scale = 1048576
	} else if streq(u, cstr("gb")) != 0 {
		scale = 1073741824
	}
	let v = e[UNIT_VALUE]
	if v < 0 || (v > 0 && v > 9223372036854775807 / scale) {
		err_code_at(pos, cstr("E012 NUMERIC_UNIT"), cstr("unit literal out of range"))
		return ty_int
	}
	let n = node_new(EX_INT, pos)
	n[INT_VAL] = v * scale
	replace_node(e, n)
	return chk(e, want)
}

// ---- boundary blocks: guard (#230), within (#233) and limit (#235) ----
//
// The block becomes a closure func($r i64) ! whose last expression is stored through $r, so
// fail and try leave the block with a fault. A generated boundary$N(c, a) !T runs it inside
// the boundary (a guard stack, or a boundary record with a deadline) and returns the value.
fn chk_boundary(e i64) i64 {
	let pos = e[N_POS]
	let kind = e[BOUND_KIND]
	if kind == BOUND_PARALLEL {
		return chk_parallel(e)
	}
	if kind == BOUND_WITH {
		return chk_with(e)
	}
	if kind == BOUND_ARENA {
		return chk_arena(e)
	}
	if (kind != BOUND_WITHIN && kind != BOUND_GUARD && kind != BOUND_LIMIT) {
		err_code_at(pos, cstr("E650 BOUNDARY"), cstr("this boundary block is not supported yet"))
		return ty_int
	}
	mut arg = mk_int(pos, 0, ty_int)
	mut arg2 = mk_int(pos, 0, ty_int)
	if kind == BOUND_WITHIN {
		arg = bound_int_arg(vec_get(e[BOUND_ARGS], 0))
	}
	if kind == BOUND_LIMIT {
		// limit memory n, tasks k: each bound at most once.
		mut i = 0
		for i < e[BOUND_ARGS][VEC_LEN] {
			let item = vec_get(e[BOUND_ARGS], i)
			let name = vec_get(item, 0)
			let v = bound_int_arg(vec_get(item, 1))
			if streq(name, cstr("memory")) != 0 {
				arg = v
			} else if streq(name, cstr("tasks")) != 0 {
				arg2 = v
			} else {
				err_code_quoted(pos, cstr("E650 BOUNDARY"), cstr("limit bounds are memory and tasks, not "), name, cstr(""))
			}
			i = i + 1
		}
	}
	let body = e[BOUND_BODY]
	bound_leaves(body[BLK_STMTS])
	let f = fn_new(pos, cstr("func"))
	vec_push(f[F_PARAMS], cstr("$r"))
	let it = node_new(TX_NAME, pos)
	it[TX_B] = cstr("i64")
	vec_push(f[F_PTYPES], it)
	let ft = node_new(TX_NAME, pos)
	ft[TX_B] = cstr("fault")
	vec_push(f[F_RTYPES], ft)
	f[F_BANG] = 1
	let stmts = body[BLK_STMTS]
	let n = stmts[VEC_LEN]
	if n > 0 && vec_get(stmts, n - 1)[N_KIND] == ST_EXPR {
		let last = vec_get(stmts, n - 1)
		let bs = node_new(ST_BSTORE, last[N_POS])
		bs[ES_X] = last[ES_X]
		stmts[VEC_DATA][n - 1] = bs
	}
	f[F_BODY] = body
	let lit = node_new(EX_FUNCLIT, pos)
	lit[LIT_FN] = f
	lit[LIT_ESCAPE] = 0
	let saved_t = bound_t
	bound_t = ty_void
	let ct = chk_funclit(lit)
	let vt = bound_t
	bound_t = saved_t
	let w = boundary_wrapper(pos, kind, ct, vt)
	let c = node_new(EX_CALL, pos)
	c[CALL_NAME] = w[F_NAME]
	c[CALL_FN] = w
	let cargs = args2(lit, arg)
	vec_push(cargs, arg2)
	c[CALL_ARGS] = cargs
	let results = vec_new()
	if kind_of(vt) != K_VOID {
		vec_push(results, vt)
	}
	vec_push(results, ty_error)
	mut rt = ty_error
	if results[VEC_LEN] > 1 {
		rt = tuple_of(results)
	}
	c[N_TYPE] = rt
	replace_node(e, c)
	return rt
}

// chk_parallel lowers parallel { e1 \n e2 ... } (#232): each line is a closure run as a child
// of an implicit scope, storing its value (a fault leaves the scope, cancelling the others);
// a generated parallel$N(c1, c2, ...) waits for them and returns the tuple of values.
fn chk_parallel(e i64) i64 {
	let pos = e[N_POS]
	let stmts = e[BOUND_BODY][BLK_STMTS]
	let lits = vec_new()
	let vts = vec_new()
	mut i = 0
	for i < stmts[VEC_LEN] {
		let st = vec_get(stmts, i)
		if st[N_KIND] != ST_EXPR {
			err_code_at(st[N_POS], cstr("E651 PARALLEL"), cstr("each line of parallel is an expression that runs as a child task"))
			return ty_int
		}
		mut x = st[ES_X]
		if x[N_KIND] != EX_TRY && x[N_KIND] != EX_CATCH {
			let tr = node_new(EX_TRY, x[N_POS])
			tr[TRY_X] = x
			tr[TRY_SOFT] = 1
			x = tr
		}
		let bs = node_new(ST_BSTORE, st[N_POS])
		bs[ES_X] = x
		let body = empty_block(st[N_POS])
		vec_push(body[BLK_STMTS], bs)
		let f = fn_new(st[N_POS], cstr("func"))
		vec_push(f[F_PARAMS], cstr("$r"))
		let it = node_new(TX_NAME, pos)
		it[TX_B] = cstr("i64")
		vec_push(f[F_PTYPES], it)
		let ft = node_new(TX_NAME, pos)
		ft[TX_B] = cstr("fault")
		vec_push(f[F_RTYPES], ft)
		f[F_BANG] = 1
		f[F_BODY] = body
		let lit = node_new(EX_FUNCLIT, st[N_POS])
		lit[LIT_FN] = f
		lit[LIT_ESCAPE] = 0
		let saved_t = bound_t
		bound_t = ty_void
		let ct = chk_funclit(lit)
		if kind_of(bound_t) == K_VOID {
			err_code_at(st[N_POS], cstr("E651 PARALLEL"), cstr("a parallel line must give a value"))
		}
		vec_push(vts, bound_t)
		bound_t = saved_t
		vec_push(lits, pair(lit, ct))
		i = i + 1
	}
	if lits[VEC_LEN] < 2 {
		err_code_at(pos, cstr("E651 PARALLEL"), cstr("parallel needs at least two lines"))
		return ty_int
	}
	let w = parallel_wrapper(pos, lits, vts)
	let c = node_new(EX_CALL, pos)
	c[CALL_NAME] = w[F_NAME]
	c[CALL_FN] = w
	let args = vec_new()
	i = 0
	for i < lits[VEC_LEN] {
		vec_push(args, vec_get(vec_get(lits, i), 0))
		i = i + 1
	}
	c[CALL_ARGS] = args
	let results = vec_new()
	i = 0
	for i < vts[VEC_LEN] {
		vec_push(results, vec_get(vts, i))
		i = i + 1
	}
	vec_push(results, ty_error)
	let rt = tuple_of(results)
	c[N_TYPE] = rt
	replace_node(e, c)
	return rt
}

// parallel_wrapper builds parallel$N(c1..cn) (T1..Tn, fault): it spawns each ci with its own
// 16-byte result cell in an implicit scope, waits for all of them, and returns the values.
fn parallel_wrapper(pos i64, lits i64, vts i64) i64 {
	lifted_count = lifted_count + 1
	let f = fn_new(pos, cstr("parallel"))
	let nb = buf_new()
	buf_str(nb, cstr("parallel$"))
	buf_int(nb, lifted_count)
	buf_byte(nb, 0)
	f[F_QNAME] = nb[VEC_DATA]
	f[F_NAME] = nb[VEC_DATA]
	f[F_LIFTED] = 2
	f[F_FILE] = ck_file
	f[F_BANG] = 1
	let n = lits[VEC_LEN]
	mut i = 0
	for i < n {
		vec_push(f[F_PARAMS], cstr("c"))
		vec_push(f[F_PTYPES], vec_get(vec_get(lits, i), 1))
		vec_push(f[F_RTYPES], vec_get(vts, i))
		i = i + 1
	}
	vec_push(f[F_RTYPES], ty_error)
	f[F_TYPE] = func_of(f[F_PTYPES], f[F_RTYPES], 0)
	f[F_LOCALS] = vec_new()
	f[F_BODY] = empty_block(pos)
	vec_push(prog_fns, f)
	let saved_fn = ck_fn
	ck_fn = f
	let syms = vec_new()
	i = 0
	for i < n {
		let cs = sym_new(SYM_LOCAL, cstr("c"), pos)
		cs[S_TYPE] = vec_get(vec_get(lits, i), 1)
		cs[S_SLOT] = i
		vec_push(f[F_LOCALS], cs)
		vec_push(syms, cs)
		i = i + 1
	}
	f[F_SLOTS] = n
	let body = f[F_BODY][BLK_STMTS]
	let r = temp(pos, rt_call(pos, cstr("rt_alloc"), args1(mk_int(pos, 16 * n, ty_int)), ty_int), ty_int)
	vec_push(body, r)
	let sc = temp(pos, rt_call(pos, cstr("rt_scope_open_word"), vec_new(), ty_int), ty_int)
	vec_push(body, sc)
	i = 0
	for i < n {
		let at = mk_bin(pos, cstr("+"), sym_ref_node(pos, r[LET_SYM]), mk_int(pos, 16 * i, ty_int), ty_int)
		let sa = args2(sym_ref_node(pos, sc[LET_SYM]), sym_ref_node(pos, vec_get(syms, i)))
		vec_push(sa, at)
		vec_push(body, expr_stmt(rt_call(pos, cstr("rt_scope_spawn_arg"), sa, ty_void)))
		i = i + 1
	}
	let fe = temp(pos, rt_call(pos, cstr("rt_scope_close_word"), args1(sym_ref_node(pos, sc[LET_SYM])), ty_error), ty_error)
	vec_push(body, fe)
	fe[LET_SYM][S_READS] = 1
	let ifs = node_new(ST_IF, pos)
	ifs[IF_COND] = mk_bin(pos, cstr("!="), sym_ref_node(pos, fe[LET_SYM]), mk_int(pos, 0, ty_error), ty_bool)
	ifs[IF_THEN] = empty_block(pos)
	vec_push(ifs[IF_THEN][BLK_STMTS], fault_return(pos, ifs[IF_THEN][BLK_STMTS], sym_ref_node(pos, fe[LET_SYM])))
	vec_push(body, ifs)
	let ret = node_new(ST_RETURN, pos)
	let rv = vec_new()
	i = 0
	for i < n {
		vec_push(rv, mk_mem(pos, sym_ref_node(pos, r[LET_SYM]), 0, 0, 16 * i, vec_get(vts, i)))
		i = i + 1
	}
	vec_push(rv, mk_int(pos, 0, ty_error))
	ret[RET_VALUES] = rv
	vec_push(body, ret)
	ck_fn = saved_fn
	return f
}

// bound_int_arg checks a boundary argument (a duration or a size) as an i64.
fn bound_int_arg(a i64) i64 {
	let at = chk(a, ty_int)
	check_assignable(a, at, ty_int)
	if is_untyped(at) != 0 {
		reconvert(a, ty_int)
	}
	return a
}

// bound_leaves rejects a return that would leave a boundary block from inside it.
fn bound_leaves(v i64) {
	mut i = 0
	for i < v[VEC_LEN] {
		let s = vec_get(v, i)
		let k = s[N_KIND]
		if k == ST_RETURN {
			err_code_at(s[N_POS], cstr("E650 BOUNDARY"), cstr("return cannot leave a boundary block: its value is its last expression (use fail to leave it with a fault)"))
		} else if k == ST_BLOCK {
			bound_leaves(s[BLK_STMTS])
		} else if k == ST_IF {
			bound_leaves(s[IF_THEN][BLK_STMTS])
			if s[IF_ELSE] != 0 {
				bound_leaves(vec_new_with(s[IF_ELSE]))
			}
		} else if k == ST_WHILE {
			bound_leaves(s[WH_BODY][BLK_STMTS])
		} else if k == ST_RANGE {
			bound_leaves(s[RG_BODY][BLK_STMTS])
		} else if mt_stmt_expr(s) != 0 && mt_stmt_expr(s)[N_KIND] == EX_MATCH {
			let arms = mt_stmt_expr(s)[MATCH_ARMS]
			mut ai = 0
			for ai < arms[VEC_LEN] {
				if vec_get(vec_get(arms, ai), ARM_BLOCK) != 0 {
					bound_leaves(vec_get(vec_get(arms, ai), ARM_BODY)[BLK_STMTS])
				}
				ai = ai + 1
			}
		}
		i = i + 1
	}
}

fn vec_new_with(x i64) i64 {
	let v = vec_new()
	vec_push(v, x)
	return v
}

// boundary_wrapper builds boundary$N(c, a): it runs closure c (type ct) with a 16-byte result
// cell inside the boundary and returns the value of type vt (ty_void: none) or the fault.
fn boundary_wrapper(pos i64, kind i64, ct i64, vt i64) i64 {
	lifted_count = lifted_count + 1
	let f = fn_new(pos, cstr("boundary"))
	let nb = buf_new()
	buf_str(nb, cstr("boundary$"))
	buf_int(nb, lifted_count)
	buf_byte(nb, 0)
	f[F_QNAME] = nb[VEC_DATA]
	f[F_NAME] = nb[VEC_DATA]
	f[F_LIFTED] = 2
	f[F_FILE] = ck_file
	f[F_BANG] = 1
	vec_push(f[F_PARAMS], cstr("c"))
	vec_push(f[F_PTYPES], ct)
	vec_push(f[F_PARAMS], cstr("a"))
	vec_push(f[F_PTYPES], ty_int)
	vec_push(f[F_PARAMS], cstr("a2"))
	vec_push(f[F_PTYPES], ty_int)
	if kind_of(vt) != K_VOID {
		vec_push(f[F_RTYPES], vt)
	}
	vec_push(f[F_RTYPES], ty_error)
	f[F_TYPE] = func_of(f[F_PTYPES], f[F_RTYPES], 0)
	f[F_LOCALS] = vec_new()
	f[F_BODY] = empty_block(pos)
	vec_push(prog_fns, f)
	let saved_fn = ck_fn
	ck_fn = f
	let cs = sym_new(SYM_LOCAL, cstr("c"), pos)
	cs[S_TYPE] = ct
	cs[S_SLOT] = 0
	let asym = sym_new(SYM_LOCAL, cstr("a"), pos)
	asym[S_TYPE] = ty_int
	asym[S_SLOT] = 1
	let a2sym = sym_new(SYM_LOCAL, cstr("a2"), pos)
	a2sym[S_TYPE] = ty_int
	a2sym[S_SLOT] = 2
	f[F_SLOTS] = 3
	vec_push(f[F_LOCALS], cs)
	vec_push(f[F_LOCALS], asym)
	vec_push(f[F_LOCALS], a2sym)
	let body = f[F_BODY][BLK_STMTS]
	let r = temp(pos, rt_call(pos, cstr("rt_alloc"), args1(mk_int(pos, 16, ty_int)), ty_int), ty_int)
	vec_push(body, r)
	let rref = sym_ref_node(pos, r[LET_SYM])
	mut fe = 0
	if kind == BOUND_GUARD {
		fe = temp(pos, rt_call(pos, cstr("rt_guard_call"), args2(sym_ref_node(pos, cs), rref), ty_error), ty_error)
		vec_push(body, fe)
	} else if kind == BOUND_LIMIT {
		let la = args2(sym_ref_node(pos, cs), sym_ref_node(pos, r[LET_SYM]))
		vec_push(la, sym_ref_node(pos, asym))
		vec_push(la, sym_ref_node(pos, a2sym))
		fe = temp(pos, rt_call(pos, cstr("rt_limit_call"), la, ty_error), ty_error)
		vec_push(body, fe)
	} else {
		let wa = args2(sym_ref_node(pos, cs), sym_ref_node(pos, r[LET_SYM]))
		vec_push(wa, sym_ref_node(pos, asym))
		fe = temp(pos, rt_call(pos, cstr("rt_within_call"), wa, ty_error), ty_error)
		vec_push(body, fe)
	}
	fe[LET_SYM][S_READS] = 1
	let ifs = node_new(ST_IF, pos)
	ifs[IF_COND] = mk_bin(pos, cstr("!="), sym_ref_node(pos, fe[LET_SYM]), mk_int(pos, 0, ty_error), ty_bool)
	ifs[IF_THEN] = empty_block(pos)
	vec_push(ifs[IF_THEN][BLK_STMTS], fault_return(pos, ifs[IF_THEN][BLK_STMTS], sym_ref_node(pos, fe[LET_SYM])))
	vec_push(body, ifs)
	let ret = node_new(ST_RETURN, pos)
	if kind_of(vt) == K_VOID {
		ret[RET_VALUE] = mk_int(pos, 0, ty_error)
	} else {
		let rv = vec_new()
		vec_push(rv, mk_mem(pos, sym_ref_node(pos, r[LET_SYM]), 0, 0, 0, vt))
		vec_push(rv, mk_int(pos, 0, ty_error))
		ret[RET_VALUES] = rv
	}
	vec_push(body, ret)
	ck_fn = saved_fn
	return f
}

// ---- arena (#236, notes/interface_arena.md) ----
//
// arena { body } becomes arena$N(c): c is the block's closure func($r i64) !, as for the other
// boundary blocks. arena$N opens the arena, runs c, switches back to the parent pool, copies
// the fault and the value there (arenacopy$N) and frees the arena. A block whose body cannot
// fail has the type of its value; one that can is a !T, used with try or catch.
shared mut ck_arenas i64 // the closures arena blocks became (region.tin: nothing else leaves them)
shared mut arena_check_fn i64 // the arena closure being checked
shared mut arena_fail_count i64 // fault returns made in it (fault_return)

fn chk_arena(e i64) i64 {
	let pos = e[N_POS]
	let body = e[BOUND_BODY]
	bound_leaves(body[BLK_STMTS])
	let f = fn_new(pos, cstr("func"))
	vec_push(f[F_PARAMS], cstr("$r"))
	let it = node_new(TX_NAME, pos)
	it[TX_B] = cstr("i64")
	vec_push(f[F_PTYPES], it)
	let ft = node_new(TX_NAME, pos)
	ft[TX_B] = cstr("fault")
	vec_push(f[F_RTYPES], ft)
	f[F_BANG] = 1
	let stmts = body[BLK_STMTS]
	let n = stmts[VEC_LEN]
	if n > 0 && vec_get(stmts, n - 1)[N_KIND] == ST_EXPR {
		let last = vec_get(stmts, n - 1)
		let bs = node_new(ST_BSTORE, last[N_POS])
		bs[ES_X] = last[ES_X]
		stmts[VEC_DATA][n - 1] = bs
	}
	f[F_BODY] = body
	if ck_arenas == 0 {
		ck_arenas = vec_new()
	}
	vec_push(ck_arenas, f)
	let lit = node_new(EX_FUNCLIT, pos)
	lit[LIT_FN] = f
	lit[LIT_ESCAPE] = 0
	let saved_t = bound_t
	let saved_fn = arena_check_fn
	let saved_count = arena_fail_count
	bound_t = ty_void
	arena_check_fn = f
	arena_fail_count = 0
	let ct = chk_funclit(lit)
	let vt = bound_t
	let fails = i64(arena_fail_count > 0)
	bound_t = saved_t
	arena_check_fn = saved_fn
	arena_fail_count = saved_count
	arena_value_check(pos, vt)
	let w = arena_wrapper(pos, ct, vt, fails)
	let c = node_new(EX_CALL, pos)
	c[CALL_NAME] = w[F_NAME]
	c[CALL_FN] = w
	c[CALL_ARGS] = args1(lit)
	let results = vec_new()
	if kind_of(vt) != K_VOID {
		vec_push(results, vt)
	}
	if fails != 0 {
		vec_push(results, ty_error)
	}
	mut rt = ty_void
	if results[VEC_LEN] == 1 {
		rt = vec_get(results, 0)
	} else if results[VEC_LEN] > 1 {
		rt = tuple_of(results)
	}
	c[N_TYPE] = rt
	replace_node(e, c)
	return rt
}

// arena_value_check reports a value type the arena cannot copy out: one holding a func or dyn
// value (their objects are not described by the type), or a recursive one.
fn arena_value_check(pos i64, vt i64) {
	mut bad = cstr("")
	if arena_copyable(vt, vec_new()) == 0 {
		bad = cstr(" holds a func or dyn value, which cannot be copied: return the data it needs instead")
	} else if type_cycle(vt, vec_new()) != 0 {
		bad = cstr(" is recursive, so it cannot be copied: return a value of a non-recursive type")
	}
	if i64(load8(bad)) != 0 {
		let m = err_code(pos, cstr("E316 ARENA_VALUE"))
		buf_str(m, cstr("an arena block's value is copied out of the arena, but type "))
		type_name(m, vt)
		buf_str(m, bad)
		err_end(m)
	}
}

// arena_wrapper builds arena$N(c): it runs closure c (type ct) with a 16-byte result cell in
// a new arena and returns the copied value of type vt (ty_void: none), and the fault if fails.
fn arena_wrapper(pos i64, ct i64, vt i64, fails i64) i64 {
	lifted_count = lifted_count + 1
	let f = fn_new(pos, cstr("arena"))
	let nb = buf_new()
	buf_str(nb, cstr("arena$"))
	buf_int(nb, lifted_count)
	buf_byte(nb, 0)
	f[F_QNAME] = nb[VEC_DATA]
	f[F_NAME] = nb[VEC_DATA]
	f[F_LIFTED] = 2
	f[F_FILE] = ck_file
	f[F_BANG] = fails
	vec_push(f[F_PARAMS], cstr("c"))
	vec_push(f[F_PTYPES], ct)
	if kind_of(vt) != K_VOID {
		vec_push(f[F_RTYPES], vt)
	}
	if fails != 0 {
		vec_push(f[F_RTYPES], ty_error)
	}
	f[F_TYPE] = func_of(f[F_PTYPES], f[F_RTYPES], 0)
	f[F_LOCALS] = vec_new()
	f[F_BODY] = empty_block(pos)
	vec_push(prog_fns, f)
	let saved_fn = ck_fn
	ck_fn = f
	let cs = sym_new(SYM_LOCAL, cstr("c"), pos)
	cs[S_TYPE] = ct
	cs[S_SLOT] = 0
	f[F_SLOTS] = 1
	vec_push(f[F_LOCALS], cs)
	let body = f[F_BODY][BLK_STMTS]
	let r = temp(pos, rt_call(pos, cstr("rt_alloc"), args1(mk_int(pos, 16, ty_int)), ty_int), ty_int)
	vec_push(body, r)
	let a = temp(pos, rt_call(pos, cstr("rt_arena_open"), vec_new(), ty_int), ty_int)
	vec_push(body, a)
	let fe = temp(pos, rt_call(pos, cstr("rt_arena_run"), args2(sym_ref_node(pos, cs), sym_ref_node(pos, r[LET_SYM])), ty_error), ty_error)
	vec_push(body, fe)
	fe[LET_SYM][S_READS] = 1
	vec_push(body, expr_stmt(rt_call(pos, cstr("rt_arena_out"), args1(sym_ref_node(pos, a[LET_SYM])), ty_void)))
	vec_push(body, assign_stmt(pos, sym_ref_node(pos, fe[LET_SYM]), rt_call(pos, cstr("rt_arena_fault"), args1(sym_ref_node(pos, fe[LET_SYM])), ty_error)))
	if is_ref(vt) != 0 {
		let ifs = node_new(ST_IF, pos)
		ifs[IF_COND] = mk_bin(pos, cstr("=="), sym_ref_node(pos, fe[LET_SYM]), mk_int(pos, 0, ty_error), ty_bool)
		ifs[IF_THEN] = empty_block(pos)
		let src = mk_mem(pos, sym_ref_node(pos, r[LET_SYM]), 0, 0, 0, vt)
		vec_push(ifs[IF_THEN][BLK_STMTS], assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, r[LET_SYM]), 0, 0, 0, vt), keep_call(pos, arenacopy_fn(vt), src, vt)))
		vec_push(body, ifs)
	}
	vec_push(body, expr_stmt(rt_call(pos, cstr("rt_arena_close"), args1(sym_ref_node(pos, a[LET_SYM])), ty_void)))
	if fails != 0 {
		let ifs2 = node_new(ST_IF, pos)
		ifs2[IF_COND] = mk_bin(pos, cstr("!="), sym_ref_node(pos, fe[LET_SYM]), mk_int(pos, 0, ty_error), ty_bool)
		ifs2[IF_THEN] = empty_block(pos)
		vec_push(ifs2[IF_THEN][BLK_STMTS], fault_return(pos, ifs2[IF_THEN][BLK_STMTS], sym_ref_node(pos, fe[LET_SYM])))
		vec_push(body, ifs2)
	}
	let ret = node_new(ST_RETURN, pos)
	let rv = vec_new()
	if kind_of(vt) != K_VOID {
		vec_push(rv, mk_mem(pos, sym_ref_node(pos, r[LET_SYM]), 0, 0, 0, vt))
	}
	if fails != 0 {
		vec_push(rv, mk_int(pos, 0, ty_error))
	}
	if rv[VEC_LEN] == 1 {
		ret[RET_VALUE] = vec_get(rv, 0)
	} else if rv[VEC_LEN] > 1 {
		ret[RET_VALUES] = rv
	}
	vec_push(body, ret)
	ck_fn = saved_fn
	return f
}

// ---- with policies (#237, notes/interface_policy.md) ----
//
// with p { body } is with$N(c, p): c is the block's closure func($r i64) !, as for the other
// boundary blocks. with$N enters a bkWith boundary, calls p.Run with an adapter func() !T that
// runs c and gives the value c stored, leaves the boundary and returns what Run gave.
shared mut with_fill_calls i64 // the policy calls whose open type parameters take with_fill_t (generic_call)
shared mut with_fill_t i64
shared mut with_runs i64 // [Run method, with position] pairs: Run may only call its body (region.tin)

fn chk_with(e i64) i64 {
	let pos = e[N_POS]
	let body = e[BOUND_BODY]
	bound_leaves(body[BLK_STMTS])
	let f = fn_new(pos, cstr("func"))
	vec_push(f[F_PARAMS], cstr("$r"))
	let it = node_new(TX_NAME, pos)
	it[TX_B] = cstr("i64")
	vec_push(f[F_PTYPES], it)
	let ft = node_new(TX_NAME, pos)
	ft[TX_B] = cstr("fault")
	vec_push(f[F_RTYPES], ft)
	f[F_BANG] = 1
	let stmts = body[BLK_STMTS]
	let n = stmts[VEC_LEN]
	if n > 0 && vec_get(stmts, n - 1)[N_KIND] == ST_EXPR {
		let last = vec_get(stmts, n - 1)
		let bs = node_new(ST_BSTORE, last[N_POS])
		bs[ES_X] = last[ES_X]
		stmts[VEC_DATA][n - 1] = bs
	}
	f[F_BODY] = body
	let lit = node_new(EX_FUNCLIT, pos)
	lit[LIT_FN] = f
	lit[LIT_ESCAPE] = 0
	let saved_t = bound_t
	bound_t = ty_void
	let ct = chk_funclit(lit)
	let vt = bound_t
	bound_t = saved_t
	// The policy, after the block: the type parameters its constructor (and the calls whose
	// receiver it is) leave open are the block's type, u8 for a block without a value.
	let pe = vec_get(e[BOUND_ARGS], 0)
	let saved_calls = with_fill_calls
	let saved_fill = with_fill_t
	with_fill_calls = vec_new()
	with_fill_t = vt
	if kind_of(vt) == K_VOID {
		with_fill_t = ty_byte
	}
	mut x = pe
	for x[N_KIND] == EX_CALL {
		vec_push(with_fill_calls, x)
		let cx = x[CALL_CALLEE]
		if cx == 0 || cx[N_KIND] != EX_SELECT {
			break
		}
		x = cx[SEL_X]
	}
	let pt = chk(pe, 0)
	with_fill_calls = saved_calls
	with_fill_t = saved_fill
	if kind_of(pt) == K_DYN {
		err_code_type(pe[N_POS], cstr("E652 POLICY"), cstr("a with policy is called directly so that its Run can be checked: use the concrete type, not "), pt, cstr(""))
		return with_failed(e, vt)
	}
	mut run = 0
	if kind_of(pt) == K_STRUCT {
		run = find_fn(str_cat3(pt[TY_NAME], cstr("."), cstr("Run")))
	}
	if run == 0 {
		err_code_type(pe[N_POS], cstr("E652 POLICY"), cstr(""), pt, cstr(" is not a policy: with needs a value with a method Run(body func() !T) !T"))
		return with_failed(e, vt)
	}
	// Run(body func() !T) !T, or Run(body func() !) !: the body has Run's own results.
	let rps = run[F_PTYPES]
	let rrs = run[F_RTYPES]
	let bt = func_of(vec_new(), rrs, 0)
	mut tt = ty_void
	if rrs[VEC_LEN] == 2 {
		tt = vec_get(rrs, 0)
	}
	let shaped = i64(run[F_BANG] != 0 && rps[VEC_LEN] == 2 && vec_get(rps, 1) == bt && vec_get(run[F_MUTS], 1) == 0)
	if shaped == 0 || rrs[VEC_LEN] < 1 || rrs[VEC_LEN] > 2 || kind_of(vec_get(rrs, rrs[VEC_LEN] - 1)) != K_ERROR {
		err_code_type(pe[N_POS], cstr("E652 POLICY"), cstr(""), pt, cstr(" is not a policy: its Run must be Run(body func() !T) !T"))
		return with_failed(e, vt)
	}
	if kind_of(vt) != K_VOID && kind_of(tt) == K_VOID {
		with_error(pos, cstr("the block gives a "), vt, cstr(", but the Run of its policy "), pt, cstr(" runs a body without a value"))
		return with_failed(e, vt)
	}
	if kind_of(vt) != K_VOID && tt != vt {
		err_code_types(pos, cstr("E652 POLICY"), cstr("the block gives a "), vt, cstr(", but its policy runs a body of type "), bt)
		return with_failed(e, vt)
	}
	if kind_of(vt) == K_VOID && kind_of(tt) != K_VOID && with_scalar(tt) == 0 {
		with_error(pos, cstr("the block gives no value, but its policy "), pt, cstr(" needs one of type "), tt, cstr(""))
		return with_failed(e, vt)
	}
	let w = with_wrapper(pos, ct, pt, bt, tt, vt)
	let c = node_new(EX_CALL, pos)
	c[CALL_NAME] = w[F_NAME]
	c[CALL_FN] = w
	c[CALL_ARGS] = args2(lit, pe)
	mut rt = ty_error
	if kind_of(vt) != K_VOID {
		let results = vec_new()
		vec_push(results, vt)
		vec_push(results, ty_error)
		rt = tuple_of(results)
	}
	c[N_TYPE] = rt
	replace_node(e, c)
	return rt
}

// with_failed stands in for a with that was rejected: a call of the type the with would have,
// so its catch or try reports nothing more.
fn with_failed(e i64, vt i64) i64 {
	mut rt = ty_error
	if kind_of(vt) != K_VOID {
		let results = vec_new()
		vec_push(results, vt)
		vec_push(results, ty_error)
		rt = tuple_of(results)
	}
	let c = node_new(EX_CALL, e[N_POS])
	c[CALL_NAME] = cstr("with")
	c[CALL_ARGS] = vec_new()
	c[N_TYPE] = rt
	replace_node(e, c)
	return rt
}

// with_error reports a with block whose value does not fit its policy.
fn with_error(pos i64, a i64, ta i64, b i64, tb i64, c i64) {
	let m = err_code(pos, cstr("E652 POLICY"))
	buf_str(m, a)
	type_name(m, ta)
	buf_str(m, b)
	type_name(m, tb)
	buf_str(m, c)
	err_end(m)
}

// with_scalar reports whether a body without a value can give t's zero to its policy.
fn with_scalar(t i64) i64 {
	let k = kind_of(t)
	return i64(k == K_INT || k == K_BYTE || k == K_BOOL || is_float_t(t) != 0)
}

// with_wrapper builds with$N(c, p) for policy type pt, whose Run takes a body of type bt
// giving tt (ty_void: none); the with gives vt (ty_void: none). The adapter's descriptor
// [code, 2, c, cell, 0] and the value cell live on with$N's frame, which outlives every run
// of the body because Run cannot keep it (notes/interface_policy.md §3). p is mut so that a
// Run with a mut receiver may change it; the region pass judges the with's own policy value.
fn with_wrapper(pos i64, ct i64, pt i64, bt i64, tt i64, vt i64) i64 {
	let rmut = 1
	lifted_count = lifted_count + 1
	let f = fn_new(pos, cstr("with"))
	let nb = buf_new()
	buf_str(nb, cstr("with$"))
	buf_int(nb, lifted_count)
	buf_byte(nb, 0)
	f[F_QNAME] = nb[VEC_DATA]
	f[F_NAME] = nb[VEC_DATA]
	f[F_LIFTED] = 2
	f[F_DONE] = 1
	f[F_FILE] = ck_file
	f[F_BANG] = 1
	vec_push(f[F_PARAMS], cstr("c"))
	vec_push(f[F_PTYPES], ct)
	vec_push(f[F_MUTS], 0)
	vec_push(f[F_PARAMS], cstr("$p"))
	vec_push(f[F_PTYPES], pt)
	vec_push(f[F_MUTS], rmut)
	if kind_of(vt) != K_VOID {
		vec_push(f[F_RTYPES], vt)
	}
	vec_push(f[F_RTYPES], ty_error)
	f[F_TYPE] = func_of_m(f[F_PTYPES], f[F_RTYPES], 0, mut_mask(f[F_MUTS]))
	f[F_LOCALS] = vec_new()
	f[F_BODY] = empty_block(pos)
	vec_push(prog_fns, f)
	let adapt = with_adapter(pos, f, ct, bt, tt, vt)
	let saved_fn = ck_fn
	ck_fn = f
	let cs = sym_new(SYM_LOCAL, cstr("c"), pos)
	cs[S_TYPE] = ct
	cs[S_SLOT] = 0
	cs[S_READS] = 1
	let ps = sym_new(SYM_LOCAL, cstr("$p"), pos)
	ps[S_TYPE] = pt
	ps[S_SLOT] = 1
	ps[S_MUT] = rmut
	ps[S_READS] = 1
	f[F_SLOTS] = 2
	vec_push(f[F_LOCALS], cs)
	vec_push(f[F_LOCALS], ps)
	let body = f[F_BODY][BLK_STMTS]
	let cell = declare_local(pos, cstr("$cell"), ty_int)
	cell[S_ADDR] = 1
	cell[S_WORDS] = 2
	let desc = declare_local(pos, cstr("$desc"), ty_int)
	desc[S_ADDR] = 1
	desc[S_WORDS] = 5
	let da = temp(pos, mk_unary(pos, cstr("&"), sym_ref_node(pos, desc)), ty_int)
	vec_push(body, da)
	let code = node_new(EX_FUNCREF, pos)
	code[FR_FN] = adapt
	code[FR_RAW] = 1
	code[N_TYPE] = ty_int
	vec_push(body, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, da[LET_SYM]), 0, 0, 0, ty_int), code))
	vec_push(body, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, da[LET_SYM]), 0, 0, 8, ty_int), mk_int(pos, 2, ty_int)))
	vec_push(body, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, da[LET_SYM]), 0, 0, 16, ct), sym_ref_node(pos, cs)))
	vec_push(body, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, da[LET_SYM]), 0, 0, 24, ty_int), mk_unary(pos, cstr("&"), sym_ref_node(pos, cell))))
	vec_push(body, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, da[LET_SYM]), 0, 0, 32, ty_int), mk_int(pos, 0, ty_int)))
	let dv = temp(pos, sym_ref_node(pos, da[LET_SYM]), bt)
	vec_push(body, dv)
	let bd = temp(pos, rt_call(pos, cstr("rt_bnd_enter"), args1(mk_int(pos, 10, ty_int)), ty_int), ty_int)
	vec_push(body, bd)
	// p.Run(adapter), checked like any method call.
	let sel = node_new(EX_SELECT, pos)
	sel[SEL_X] = sym_ref_node(pos, ps)
	sel[SEL_NAME] = cstr("Run")
	let call = node_new(EX_CALL, pos)
	call[CALL_CALLEE] = sel
	call[CALL_ARGS] = args1(sym_ref_node(pos, dv[LET_SYM]))
	chk(call, 0)
	if with_runs == 0 {
		with_runs = vec_new()
	}
	vec_push(with_runs, call[CALL_FN])
	vec_push(with_runs, pos)
	mut vs = 0
	mut fes = 0
	if kind_of(tt) != K_VOID {
		let cm = node_new(ST_CALLMULTI, pos)
		cm[CM_CALL] = call
		cm[CM_SYMS] = vec_new()
		vs = declare_local(pos, cstr("$"), tt)
		fes = declare_local(pos, cstr("$"), ty_error)
		vec_push(cm[CM_SYMS], vs)
		vec_push(cm[CM_SYMS], fes)
		call[N_TYPE] = ty_void
		vec_push(body, cm)
	} else {
		let fe = temp(pos, call, ty_error)
		vec_push(body, fe)
		fes = fe[LET_SYM]
	}
	fes[S_READS] = 1
	vec_push(body, expr_stmt(rt_call(pos, cstr("rt_bnd_leave"), args1(sym_ref_node(pos, bd[LET_SYM])), ty_void)))
	let ifs = node_new(ST_IF, pos)
	ifs[IF_COND] = mk_bin(pos, cstr("!="), sym_ref_node(pos, fes), mk_int(pos, 0, ty_error), ty_bool)
	ifs[IF_THEN] = empty_block(pos)
	vec_push(ifs[IF_THEN][BLK_STMTS], fault_return(pos, ifs[IF_THEN][BLK_STMTS], sym_ref_node(pos, fes)))
	vec_push(body, ifs)
	let ret = node_new(ST_RETURN, pos)
	if kind_of(vt) == K_VOID {
		ret[RET_VALUE] = mk_int(pos, 0, ty_error)
	} else {
		let rv = vec_new()
		vec_push(rv, sym_ref_node(pos, vs))
		vec_push(rv, mk_int(pos, 0, ty_error))
		ret[RET_VALUES] = rv
	}
	vec_push(body, ret)
	ck_fn = saved_fn
	return f
}

// with_adapter builds with$N$body, the func() !T a policy runs: its closure environment (X17)
// is with$N's descriptor; it calls the block's closure with the cell and gives the value.
fn with_adapter(pos i64, w i64, ct i64, bt i64, tt i64, vt i64) i64 {
	let a = fn_new(pos, cstr("func"))
	let nb = buf_new()
	buf_str(nb, w[F_NAME])
	buf_str(nb, cstr("$body"))
	buf_byte(nb, 0)
	a[F_QNAME] = nb[VEC_DATA]
	a[F_NAME] = nb[VEC_DATA]
	a[F_LIFTED] = 2
	a[F_DONE] = 1
	a[F_FILE] = ck_file
	a[F_BANG] = 1
	mut i = 0
	for i < bt[TY_RESULTS][VEC_LEN] {
		vec_push(a[F_RTYPES], vec_get(bt[TY_RESULTS], i))
		i = i + 1
	}
	a[F_TYPE] = bt
	a[F_LOCALS] = vec_new()
	a[F_BODY] = empty_block(pos)
	vec_push(prog_fns, a)
	let saved_fn = ck_fn
	ck_fn = a
	let env = declare_local(pos, cstr("$env"), ty_int)
	env[S_READS] = 1
	a[F_ENV_SYM] = env
	let body = a[F_BODY][BLK_STMTS]
	let call = node_new(EX_CALL, pos)
	call[CALL_CALLEE] = mk_mem(pos, sym_ref_node(pos, env), 0, 0, 16, ct)
	call[CALL_ARGS] = args1(mk_mem(pos, sym_ref_node(pos, env), 0, 0, 24, ty_int))
	chk(call, 0)
	let fe = temp(pos, call, ty_error)
	vec_push(body, fe)
	fe[LET_SYM][S_READS] = 1
	let ifs = node_new(ST_IF, pos)
	ifs[IF_COND] = mk_bin(pos, cstr("!="), sym_ref_node(pos, fe[LET_SYM]), mk_int(pos, 0, ty_error), ty_bool)
	ifs[IF_THEN] = empty_block(pos)
	vec_push(ifs[IF_THEN][BLK_STMTS], fault_return(pos, ifs[IF_THEN][BLK_STMTS], sym_ref_node(pos, fe[LET_SYM])))
	vec_push(body, ifs)
	let ret = node_new(ST_RETURN, pos)
	if kind_of(tt) == K_VOID {
		ret[RET_VALUE] = mk_int(pos, 0, ty_error)
	} else {
		let rv = vec_new()
		if kind_of(vt) == K_VOID && is_float_t(tt) != 0 {
			vec_push(rv, zero_value(pos, tt))
		} else if kind_of(vt) == K_VOID {
			vec_push(rv, mk_int(pos, 0, tt))
		} else {
			vec_push(rv, mk_mem(pos, mk_mem(pos, sym_ref_node(pos, env), 0, 0, 24, ty_int), 0, 0, 0, vt))
		}
		vec_push(rv, mk_int(pos, 0, ty_error))
		ret[RET_VALUES] = rv
	}
	vec_push(body, ret)
	ck_fn = saved_fn
	return a
}

// ---- calls ----
// mask has bit i set when parameter i is mut: its argument must be written `mut x`
// (a method's receiver, argument 0 of a CALL_METHOD call, is exempt).
fn chk_args(e i64, ptypes i64, variadic i64, mask i64) {
	let args = e[CALL_ARGS]
	let n = ptypes[VEC_LEN]
	if args[VEC_LEN] != n && !(variadic != 0 && args[VEC_LEN] >= n) {
		let a = err_code(e[N_POS], cstr("E210 ARG_COUNT"))
		if e[CALL_NAME] != 0 {
			buf_str(a, e[CALL_NAME])
		} else {
			buf_str(a, cstr("function"))
		}
		buf_str(a, cstr(" expects "))
		buf_int(a, n)
		buf_str(a, cstr(" arguments, got "))
		buf_int(a, args[VEC_LEN])
		err_end(a)
	}
	mut i = 0
	for i < args[VEC_LEN] {
		let a = vec_get(args, i)
		let marked = unwrap_mut(a)
		if !(i == 0 && e[CALL_METHOD] != 0) {
			let pm = i64(i < n && i < 63 && (mask & (1 << i)) != 0)
			if pm != 0 && marked == 0 {
				mut_arg_error(e, a, i, cstr("is a mut parameter: write mut before the argument"))
			} else if marked != 0 && pm == 0 {
				mut_arg_error(e, a, i, cstr("is not a mut parameter: remove mut"))
			}
		}
		mut want = 0
		if i < n {
			want = vec_get(ptypes, i)
		}
		let adesc = secret_desc(a)
		let at = chk(a, want)
		if i < n {
			secret_arg(e, i, adesc, at, want)
			check_assignable(a, at, want)
			secret_arg_done()
			if is_untyped(at) != 0 {
				reconvert(a, want)
			}
		}
		if i >= n && is_untyped(at) != 0 {
			reconvert(a, default_type(at))
		}
		i = i + 1
	}
}

// unwrap_mut turns `mut x` back into x and reports whether it was marked.
fn unwrap_mut(a i64) i64 {
	if a[N_KIND] != EX_MUTARG {
		return 0
	}
	replace_node(a, a[MUTARG_X])
	return 1
}

fn mut_arg_error(e i64, a i64, i i64, what i64) {
	let m = err_code(a[N_POS], cstr("E705 MUT_ARG"))
	buf_str(m, cstr("argument "))
	if e[CALL_METHOD] != 0 {
		buf_int(m, i)
	} else {
		buf_int(m, i + 1)
	}
	buf_str(m, cstr(" of "))
	if e[CALL_NAME] != 0 {
		buf_str(m, e[CALL_NAME])
	} else {
		buf_str(m, cstr("this call"))
	}
	buf_byte(m, ' ')
	buf_str(m, what)
	err_end(m)
}

fn result_type(f i64) i64 {
	let rs = f[F_RTYPES]
	if rs[VEC_LEN] == 0 {
		return ty_void
	}
	if rs[VEC_LEN] == 1 {
		return vec_get(rs, 0)
	}
	return tuple_of(rs)
}

fn func_result(ft i64) i64 {
	let rs = ft[TY_RESULTS]
	if rs[VEC_LEN] == 0 {
		return ty_void
	}
	if rs[VEC_LEN] == 1 {
		return vec_get(rs, 0)
	}
	return tuple_of(rs)
}

fn direct_call(e i64, f i64) i64 {
	if is_template(f) != 0 {
		return generic_call(e, f)
	}
	e[CALL_FN] = f
	e[CALL_CALLEE] = 0
	chk_args(e, f[F_PTYPES], f[F_VARIADIC], mut_mask(f[F_MUTS]))
	return result_type(f)
}

fn chk_call(e i64, want i64) i64 {
	sb_call(e)
	let name = e[CALL_NAME]
	let callee = e[CALL_CALLEE]
	if name != 0 {
		let s = lookup_name(name)
		if s != 0 && s[S_KIND] == SYM_FUNC {
			runtime_use(e[N_POS], s[S_FN], name)
			return direct_call(e, s[S_FN])
		}
		if s != 0 && (s[S_KIND] == SYM_LOCAL || s[S_KIND] == SYM_GLOBAL) && kind_of(s[S_TYPE]) == K_FUNC {
			let id = node_new(EX_IDENT, e[N_POS])
			id[ID_NAME] = name
			e[CALL_CALLEE] = id
			e[CALL_NAME] = 0
			return indirect_call(e)
		}
		if s == 0 {
			let n = intrinsic_arity(name)
			if n >= 0 {
				if ck_trusted == 0 {
					err_code_quoted(e[N_POS], cstr("E802 RUNTIME_INTERNAL"), cstr(""), name, cstr(" is internal to the runtime"))
				}
				e[CALL_INTRINSIC] = 1
				if e[CALL_ARGS][VEC_LEN] != n {
					arity_error(e, n)
				}
				mut i = 0
				for i < e[CALL_ARGS][VEC_LEN] {
					let a = vec_get(e[CALL_ARGS], i)
					chk(a, ty_int)
					reconvert(a, ty_int)
					i = i + 1
				}
				if streq(name, cstr("load8")) != 0 {
					return ty_byte
				}
				return ty_int
			}
			let bt = chk_builtin(e, name, want)
			if bt != 0 {
				return bt
			}
			let tt = find_type_name(name)
			if tt != 0 {
				return chk_conversion(e, tt)
			}
			let u = err_code(e[N_POS], cstr("E103 UNDEFINED"))
			buf_str(u, cstr("undefined function: "))
			buf_str(u, name)
			err_end(u)
			return ty_int
		}
		err_code_quoted(e[N_POS], cstr("E215 NOT_CALLABLE"), cstr(""), name, cstr(" is not a function"))
		return ty_int
	}
	let gx = explicit_generic(callee)
	if gx != 0 {
		let inst = instantiate_fn(gx, resolve_types(index_targs(callee)), e[N_POS])
		e[CALL_NAME] = inst[F_QNAME]
		return direct_call(e, inst)
	}
	if callee[N_KIND] == EX_SELECT {
		let x = callee[SEL_X]
		let m = callee[SEL_NAME]
		let et = enum_type_of(x)
		if et != 0 {
			return enum_construct(e, et, m, e[CALL_ARGS])
		}
		if x[N_KIND] == EX_IDENT && lookup_name_local(x[ID_NAME]) == 0 && import_pkg(x[ID_NAME]) != 0 {
			let pkg = import_pkg(x[ID_NAME])
			if streq(pkg, cstr("say")) != 0 && is_say_func(m) != 0 {
				return lower_say(e, m, want)
			}
			if streq(pkg, cstr("argo")) != 0 && streq(m, cstr("Put")) != 0 {
				return lower_argo_put(e)
			}
			if streq(pkg, cstr("argo")) != 0 && streq(m, cstr("Get")) != 0 {
				return lower_argo_get(e)
			}
			let s = pkg_member(pkg, m)
			if s != 0 && is_private(m) != 0 {
				private_use(e[N_POS], cstr("function"), m, pkg)
			}
			if s != 0 && s[S_KIND] == SYM_FUNC {
				e[CALL_NAME] = s[S_NAME]
				return direct_call(e, s[S_FN])
			}
			let pt = find_type(str_cat3(pkg, cstr("."), m))
			if pt != 0 {
				return chk_conversion(e, pt)
			}
			let ov = overload(pkg, m, e)
			if ov != 0 {
				e[CALL_NAME] = ov[F_QNAME]
				return direct_call(e, ov)
			}
			let u = err_code(e[N_POS], cstr("E103 UNDEFINED"))
			buf_str(u, cstr("undefined: "))
			buf_str(u, x[ID_NAME])
			buf_byte(u, '.')
			buf_str(u, m)
			err_end(u)
			return ty_int
		}
		let xt = chk(x, 0)
		if kind_of(xt) == K_OPT {
			err_code_type(e[N_POS], cstr("E421 UNCHECKED_OPTIONAL"), cstr("cannot call a method of optional "), xt, cstr(" before checking it against nil"))
			return ty_int
		}
		if kind_of(xt) == K_STRUCT {
			// s.spawn(f) for f with a value gives a spawnedOf[T] (#232).
			let sv = spawn_value(e, x, xt, m)
			if sv != 0 {
				return sv
			}
			let mf = find_fn(str_cat3(xt[TY_NAME], cstr("."), m))
			if mf != 0 && is_private(m) != 0 && foreign_type(xt) != 0 {
				private_use(e[N_POS], cstr("method"), m, type_pkg(xt))
			}
			if mf != 0 {
				let args = vec_new()
				vec_push(args, x)
				mut i = 0
				for i < e[CALL_ARGS][VEC_LEN] {
					vec_push(args, vec_get(e[CALL_ARGS], i))
					i = i + 1
				}
				e[CALL_ARGS] = args
				e[CALL_NAME] = mf[F_QNAME]
				e[CALL_METHOD] = 1
				return direct_call(e, mf)
			}
			let fi = struct_field(xt, m)
			if fi >= 0 && kind_of(field_type(xt, fi)) == K_FUNC {
				e[CALL_CALLEE] = mk_mem(e[N_POS], x, 0, 0, field_offset(xt, fi), field_type(xt, fi))
				return indirect_call(e)
			}
			let u = err_code(e[N_POS], cstr("E214 METHOD"))
			type_name(u, xt)
			buf_str(u, cstr(" has no method "))
			buf_str(u, m)
			err_end(u)
			return ty_int
		}
		if kind_of(xt) == K_ERROR && streq(m, cstr("Error")) != 0 {
			replace_node(e, rt_call(e[N_POS], cstr("rt_err_str"), args1(x), ty_string))
			e[N_TYPE] = 0
			return ty_string
		}
		if kind_of(xt) == K_DYN {
			return lower_dyn_method_call(e, x, xt, m)
		}
		err_code_type(e[N_POS], cstr("E214 METHOD"), cstr("cannot call a method on "), xt, cstr(""))
		return ty_int
	}
	if callee[N_KIND] == EX_TYPE {
		return chk_conversion(e, resolve_type(callee[TYX]))
	}
	return indirect_call(e)
}

// lower_dyn_method_call checks the explicit arguments against the flattened shape
// signature, then builds an ordinary indirect call whose first ABI argument is the
// object word and whose callee is the method descriptor loaded from the table.
fn lower_dyn_method_call(e i64, receiver i64, dt i64, name i64) i64 {
	let pos = e[N_POS]
	let info = dyn_shape_method(dt, name)
	if info == 0 {
		let m = err_code(pos, cstr("E214 METHOD"))
		buf_str(m, cstr("dyn shape "))
		buf_str(m, dt[TY_GDECL][D_NAME])
		buf_str(m, cstr(" has no method "))
		buf_str(m, name)
		err_end(m)
		return ty_int
	}
	let sig = vec_get(info, 1)
	let names = vec_get(sig, 0)
	let ps = vec_get(sig, 1)
	let ms = vec_get(sig, 2)
	let rs = vec_get(sig, 3)
	let variadic = vec_get(sig, 4)
	mut mutmask = 0
	mut i = 0
	for i < ms[VEC_LEN] && i < 63 {
		if vec_get(ms, i) != 0 {
			mutmask = mutmask | (1 << i)
		}
		i = i + 1
	}
	e[CALL_NAME] = name
	chk_args(e, ps, variadic, mutmask)

	// A method receiver may itself be an expression with effects. Store its pair once;
	// both the object argument and descriptor lookup then read the same value.
	let receiver_temp = temp(pos, receiver, dt)
	let receiver_ref = sym_ref_node(pos, receiver_temp[LET_SYM])
	let object = mk_conv(pos, receiver_ref, CV_DYN_OBJECT, ty_int)
	let desc_params = vec_new()
	vec_push(desc_params, ty_int)
	i = 0
	for i < ps[VEC_LEN] {
		vec_push(desc_params, vec_get(ps, i))
		i = i + 1
	}
	mut desc_mask = 0
	i = 0
	for i < ms[VEC_LEN] && i < 62 {
		if vec_get(ms, i) != 0 {
			desc_mask = desc_mask | (1 << (i + 1))
		}
		i = i + 1
	}
	let ft = func_of_m(desc_params, rs, variadic, desc_mask)
	let desc = mk_conv(pos, receiver_ref, CV_DYN_DESC, ft)
	desc[CV_DYN_INDEX] = vec_get(info, 0)

	let inner = node_new(EX_CALL, pos)
	inner[CALL_NAME] = name
	inner[CALL_ARGS] = args1(object)
	i = 0
	for i < e[CALL_ARGS][VEC_LEN] {
		vec_push(inner[CALL_ARGS], vec_get(e[CALL_ARGS], i))
		i = i + 1
	}
	inner[CALL_CALLEE] = desc
	inner[CALL_METHOD] = 1
	inner[CALL_DYN_SHAPE] = dt
	inner[CALL_DYN_INDEX] = vec_get(info, 0)
	inner[N_TYPE] = func_result(ft)
	let stmts = vec_new()
	vec_push(stmts, receiver_temp)
	replace_node(e, mk_seq(pos, stmts, inner, inner[N_TYPE]))
	return inner[N_TYPE]
}

// overload picks pkg.Name__suffix by the first argument's element type, the stand-in
// for generics in library functions like sift.Sort.
fn overload(pkg i64, name i64, e i64) i64 {
	let args = e[CALL_ARGS]
	if args[VEC_LEN] == 0 {
		return 0
	}
	mut t = chk(vec_get(args, 0), 0)
	if kind_of(t) == K_SLICE {
		t = t[TY_ELEM]
	}
	let b = buf_new()
	buf_str(b, pkg)
	buf_byte(b, '.')
	buf_str(b, name)
	buf_str(b, cstr("__"))
	type_name(b, default_type(t))
	buf_byte(b, 0)
	return find_fn(b[VEC_DATA])
}

fn indirect_call(e i64) i64 {
	let callee = e[CALL_CALLEE]
	let ft = chk(callee, 0)
	if kind_of(ft) != K_FUNC {
		err_code_type(e[N_POS], cstr("E215 NOT_CALLABLE"), cstr("cannot call a value of type "), ft, cstr(""))
		return ty_int
	}
	e[CALL_FN] = 0
	chk_args(e, ft[TY_FIELDS], 0, ft[TY_KEY])
	return func_result(ft)
}

// lower_append_dyn passes the object and table as separate scalar arguments to the
// runtime append helper. The pair temporary evaluates a conversion or other expression
// once, and the region pass still sees its object bits through both projections.
fn lower_append_dyn(pos i64, slice i64, value i64, st i64) i64 {
	let et = st[TY_ELEM]
	let saved = temp(pos, value, et)
	let ref_ = sym_ref_node(pos, saved[LET_SYM])
	let object = mk_conv(pos, ref_, CV_DYN_OBJECT, ty_int)
	let table = mk_conv(pos, ref_, CV_DYN_TABLE_WORD, ty_int)
	let call = rt_call(pos, cstr("rt_append_dyn"), args3(slice, object, table), st)
	let stmts = vec_new()
	vec_push(stmts, saved)
	return mk_seq(pos, stmts, call, st)
}

fn find_type_name(name i64) i64 {
	if i64(load8(ck_pkg)) != 0 {
		let t = find_type(qual(ck_pkg, name))
		if t != 0 {
			return t
		}
	}
	return find_type(name)
}

fn arg0(e i64) i64 {
	return vec_get(e[CALL_ARGS], 0)
}

fn chk_conversion(e i64, to i64) i64 {
	let pos = e[N_POS]
	if e[CALL_ARGS][VEC_LEN] != 1 {
		err_code_type(pos, cstr("E210 ARG_COUNT"), cstr("conversion to "), to, cstr(" needs exactly one argument"))
		return to
	}
	let x = arg0(e)
	let from = chk(x, to)
	if saw_secret != 0 && (is_secret(from) != 0 || is_secret(to) != 0) {
		return secret_conversion(e, x, from, to)
	}
	let fk = kind_of(from)
	let tk = kind_of(to)
	if from == to || (is_untyped(from) != 0 && assignable(from, to) != 0) {
		if is_untyped(from) != 0 {
			reconvert(x, to)
		}
		replace_node(e, x)
		return to
	}
	if tk == K_FLOAT && is_integer_t(from) != 0 {
		if is_untyped(from) != 0 {
			reconvert(x, ty_int)
		}
		if is_f32(to) != 0 {
			replace_node(e, mk_conv(pos, mk_conv(pos, x, CV_I2F, ty_float), CV_ROUND32, ty_f32))
			return ty_f32
		}
		replace_node(e, mk_conv(pos, x, CV_I2F, ty_float))
		return ty_float
	}
	if tk == K_FLOAT && fk == K_FLOAT {
		// f64 -> f32 rounds; f32 -> f64 is exact (the register already holds an f64).
		if is_f32(to) != 0 {
			replace_node(e, mk_conv(pos, x, CV_ROUND32, ty_f32))
		} else {
			replace_node(e, mk_conv(pos, x, CV_SAME, to))
		}
		return to
	}
	if tk == K_INT && fk == K_FLOAT {
		replace_node(e, mk_conv(pos, x, CV_F2I, to))
		return to
	}
	if tk == K_INT && is_integer_t(from) != 0 {
		// Integer conversions truncate or extend to the target width.
		replace_node(e, mk_conv(pos, x, CV_INT, to))
		return to
	}
	if tk == K_INT && fk == K_BOOL {
		replace_node(e, mk_conv(pos, x, CV_SAME, to))
		return to
	}
	if tk == K_STRING && is_integer_t(from) != 0 {
		replace_node(e, rt_call(pos, cstr("rt_str_from_rune"), args1(x), ty_string))
		return ty_string
	}
	if tk == K_STRING && fk == K_SLICE && from[TY_ELEM] == ty_byte {
		replace_node(e, rt_call(pos, cstr("rt_str_from_bytes"), args1(x), ty_string))
		return ty_string
	}
	if tk == K_SLICE && to[TY_ELEM] == ty_byte && fk == K_STRING {
		replace_node(e, rt_call(pos, cstr("rt_bytes_from_str"), args1(x), to))
		return to
	}
	if tk == K_OPT && from == to[TY_ELEM] {
		replace_node(e, mk_conv(pos, x, CV_SAME, to))
		return to
	}
	err_code_types(pos, cstr("E231 CONVERSION"), cstr("cannot convert "), from, cstr(" to "), to)
	return to
}

// chk_builtin handles the predeclared functions; it returns 0 for other names.
fn chk_builtin(e i64, name i64, want i64) i64 {
	let pos = e[N_POS]
	let args = e[CALL_ARGS]
	let n = args[VEC_LEN]
	if streq(name, cstr("bound")) != 0 {
		return chk_bound(e, want)
	}
	if streq(name, cstr("len")) != 0 || streq(name, cstr("cap")) != 0 {
		if n != 1 {
			err_code_quoted(pos, cstr("E210 ARG_COUNT"), cstr(""), name, cstr(" expects 1 argument"))
			return ty_int
		}
		let t = chk(arg0(e), 0)
		let k = kind_of(t)
		if k != K_STRING && k != K_SLICE && k != K_MAP {
			err_code_type(pos, cstr("E217 BUILTIN_ARGS"), cstr("invalid argument for len: "), t, cstr(""))
		}
		mut word = 0
		if streq(name, cstr("cap")) != 0 {
			word = 1
		}
		replace_node(e, mk_hdr(pos, arg0(e), word))
		e[N_TYPE] = 0
		return ty_int
	}
	if streq(name, cstr("append")) != 0 {
		if n == 0 {
			err_code_at(pos, cstr("E217 BUILTIN_ARGS"), cstr("append needs a slice"))
			return ty_int
		}
		mut st = chk(arg0(e), want)
		// append can grow a bounded slice past its bound: the result is unbounded (#240).
		st = unbounded(st)
		if kind_of(st) != K_SLICE {
			err_code_type(pos, cstr("E217 BUILTIN_ARGS"), cstr("first argument to append must be a slice, not "), st, cstr(""))
			return ty_int
		}
		let et = st[TY_ELEM]
		mut acc = arg0(e)
		mut i = 1
		for i < n {
			let a = vec_get(args, i)
			if a[N_KIND] == EX_UNARY && streq(a[UN_OP], cstr("...")) != 0 {
				let at = chk(a[UN_X], st)
				if kind_of(at) == K_STRING && et == ty_byte && is_secret(at) != 0 && is_secret(st) == 0 {
					secret_sink_error(a[N_POS], cstr("append would put "), cstr(" into a slice that is not secret"), 0, at)
				}
				if kind_of(at) == K_STRING && et == ty_byte {
					acc = rt_call(pos, cstr("rt_append_str"), args2(acc, a[UN_X]), st)
				} else {
					check_assignable(a[UN_X], at, st)
					mut appendn = cstr("rt_slice_appendn")
					if rc_counted(et) != 0 {
						// The elements' new slots own them (#176): a long-lived slice counts them.
						appendn = cstr("rt_slice_appendn_rc")
					}
					acc = rt_call(pos, appendn, args3(acc, a[UN_X], mk_int(pos, elem_size(st), ty_int)), st)
				}
			} else {
				let vt = chk(a, et)
				check_assignable(a, vt, secret_like(st, et))
				if is_untyped(vt) != 0 {
					reconvert(a, et)
				}
				if is_dyn_value(et) != 0 {
					acc = lower_append_dyn(pos, acc, a, st)
				} else if rc_counted(et) != 0 {
					// The element's slot owns it (#176): a long-lived slice counts it.
					acc = rt_call(pos, cstr("rt_append_rc"), args3(acc, elem_bits(a, st[TY_ELEM]), mk_int(pos, elem_size(st), ty_int)), st)
				} else {
					acc = rt_call(pos, cstr("rt_append"), args3(acc, elem_bits(a, st[TY_ELEM]), mk_int(pos, elem_size(st), ty_int)), st)
				}
			}
			i = i + 1
		}
		replace_node(e, acc)
		e[N_TYPE] = 0
		return st
	}
	if streq(name, cstr("make")) != 0 {
		if n < 1 || arg0(e)[N_KIND] != EX_TYPE {
			err_code_at(pos, cstr("E217 BUILTIN_ARGS"), cstr("make needs a slice or map type: make([]T, n), make([]T, n, capacity) or make(map[K]V)"))
			return ty_int
		}
		let t = resolve_type(arg0(e)[TYX])
		let k = kind_of(t)
		if k == K_SLICE {
			if n < 2 {
				err_code_at(pos, cstr("E217 BUILTIN_ARGS"), cstr("make of a slice needs a length"))
				return t
			}
			chk(vec_get(args, 1), ty_int)
			reconvert(vec_get(args, 1), ty_int)
			// Without a capacity pass 0 (the runtime raises it to the length), so the length
			// expression is evaluated once.
			mut c = mk_int(pos, 0, ty_int)
			if n > 2 {
				c = vec_get(args, 2)
				chk(c, ty_int)
				reconvert(c, ty_int)
			}
			let ek = kind_of(t[TY_ELEM])
			let len0 = vec_get(args, 1)
			let zero_len = i64(len0[N_KIND] == EX_INT && len0[INT_VAL] == 0)
			if zero_len == 0 && (ek == K_STRUCT || ek == K_MAP || ek == K_FUNC || ek == K_DYN) {
				err_code_type(pos, cstr("E203 NO_ZERO_VALUE"), cstr("make with a length would fill the slice with nil "), t[TY_ELEM], cstr(" values: use make([]T, 0, n) and append (or []?T)"))
				return t
			}
			if zero_len == 0 && ek == K_STRING {
				// Elements start as "" (a str is never nil).
				replace_node(e, rt_call(pos, cstr("rt_slice_make_str"), args2(vec_get(args, 1), c), t))
				return t
			}
			if zero_len == 0 && ek == K_SLICE {
				replace_node(e, rt_call(pos, cstr("rt_slice_make_nest"), args3(vec_get(args, 1), c, mk_int(pos, elem_size(t[TY_ELEM]), ty_int)), t))
				return t
			}
			replace_node(e, rt_call(pos, cstr("rt_slice_make"), args3(vec_get(args, 1), c, mk_int(pos, elem_size(t), ty_int)), t))
			return t
		}
		if k == K_MAP {
			replace_node(e, map_make_call(pos, t))
			return t
		}
		err_code_type(pos, cstr("E217 BUILTIN_ARGS"), cstr("cannot make "), t, cstr(""))
		return t
	}
	if streq(name, cstr("new")) != 0 {
		if n != 1 || arg0(e)[N_KIND] != EX_TYPE {
			err_code_at(pos, cstr("E217 BUILTIN_ARGS"), cstr("new needs one struct type: new(T)"))
			return ty_int
		}
		let t = resolve_type(arg0(e)[TYX])
		if kind_of(t) != K_STRUCT {
			err_code_type(pos, cstr("E217 BUILTIN_ARGS"), cstr("new needs a struct type, not "), t, cstr(""))
			return t
		}
		// new(T) is T{}: fields that cannot be nil must still be set.
		let lit = node_new(EX_COMPOSITE, pos)
		let tyx = node_new(EX_TYPE, pos)
		tyx[TYX] = arg0(e)[TYX]
		lit[CL_TYPE] = tyx
		lit[CL_ELEMS] = vec_new()
		lit[CL_KEYS] = vec_new()
		replace_node(e, lit)
		e[N_TYPE] = 0
		return chk_kind(e, t)
	}
	if streq(name, cstr("cast")) != 0 {
		if ck_trusted == 0 {
			err_code_at(pos, cstr("E802 RUNTIME_INTERNAL"), cstr("cast is internal to the runtime"))
		}
		if n != 2 || arg0(e)[N_KIND] != EX_TYPE {
			err_code_at(pos, cstr("E217 BUILTIN_ARGS"), cstr("cast needs a type and a value"))
			return ty_int
		}
		let t = resolve_type(arg0(e)[TYX])
		let x = vec_get(args, 1)
		let from = chk(x, 0)
		if is_untyped(from) != 0 {
			reconvert(x, ty_int)
		}
		if is_float_t(t) != 0 && is_float_t(from) == 0 {
			replace_node(e, mk_conv(pos, x, CV_BITS2F, t))
		} else if is_float_t(t) == 0 && is_float_t(from) != 0 {
			replace_node(e, mk_conv(pos, x, CV_F2BITS, t))
		} else {
			// Same bits, new static type: the operand keeps its own type.
			if is_integer_t(t) != 0 && x[N_KIND] == EX_FUNCREF {
				x[FR_RAW] = 1
			}
			replace_node(e, mk_conv(pos, x, CV_SAME, t))
		}
		return t
	}
	if streq(name, cstr("delete")) != 0 {
		if n != 2 {
			err_code_at(pos, cstr("E217 BUILTIN_ARGS"), cstr("delete needs a map and a key"))
			return ty_void
		}
		let mt = chk(arg0(e), 0)
		if kind_of(mt) != K_MAP || n != 2 {
			err_code_at(pos, cstr("E217 BUILTIN_ARGS"), cstr("delete needs a map and a key"))
			return ty_void
		}
		let kt = chk(vec_get(args, 1), mt[TY_KEY])
		check_assignable(vec_get(args, 1), kt, mt[TY_KEY])
		if is_untyped(kt) != 0 {
			reconvert(vec_get(args, 1), mt[TY_KEY])
		}
		replace_node(e, rt_call(pos, cstr("rt_map_del"), args2(arg0(e), key_in(vec_get(args, 1), mt[TY_KEY])), ty_void))
		return ty_void
	}
	if streq(name, cstr("copy")) != 0 {
		if n != 2 {
			err_code_at(pos, cstr("E217 BUILTIN_ARGS"), cstr("copy needs a destination slice and a source (a slice or a str)"))
			return ty_int
		}
		let dt = chk(arg0(e), 0)
		let cdesc = secret_desc(vec_get(args, 1))
		mut st = chk(vec_get(args, 1), 0)
		if has_secret(st) != 0 && has_secret(dt) == 0 {
			secret_sink_error(vec_get(args, 1)[N_POS], cstr("copy would put "), cstr(" into a slice that is not secret"), cdesc, st)
		}
		if kind_of(st) == K_STRING {
			replace_node(e, rt_call(pos, cstr("rt_copy_str"), args2(arg0(e), vec_get(args, 1)), ty_int))
		} else if kind_of(dt) == K_SLICE && rc_counted(dt[TY_ELEM]) != 0 {
			// Copied values gain their slots' counts and replaced ones lose theirs (#176).
			let cargs = args3(arg0(e), vec_get(args, 1), mk_int(pos, elem_size(dt), ty_int))
			vec_push(cargs, fn_ref_node(pos, drop_fn(dt[TY_ELEM])))
			replace_node(e, rt_call(pos, cstr("rt_slice_copy_rc"), cargs, ty_int))
		} else {
			replace_node(e, rt_call(pos, cstr("rt_slice_copy"), args3(arg0(e), vec_get(args, 1), mk_int(pos, elem_size(dt), ty_int)), ty_int))
		}
		return ty_int
	}
	if streq(name, cstr("panic")) != 0 {
		if n != 1 {
			err_code_at(pos, cstr("E217 BUILTIN_ARGS"), cstr("panic needs one value: panic(\"message\") or panic(err)"))
			return ty_void
		}
		let pdesc = secret_desc(arg0(e))
		let pt = chk(arg0(e), ty_string)
		secret_sink(arg0(e)[N_POS], cstr("panic would print "), cstr(""), pdesc, pt)
		mut msg = arg0(e)
		if kind_of(pt) == K_ERROR {
			msg = rt_call(pos, cstr("rt_err_str"), args1(msg), ty_string)
		} else if kind_of(pt) != K_STRING {
			msg = say_text(pos, args, 0)
		}
		replace_node(e, rt_call(pos, cstr("rt_panic"), args1(msg), ty_void))
		return ty_void
	}
	if streq(name, cstr("fail")) != 0 {
		if n != 1 {
			err_code_at(pos, cstr("E416 FAIL_VALUE"), cstr("fail needs a message"))
			return ty_error
		}
		let fdesc = secret_desc(arg0(e))
		let ft = chk(arg0(e), ty_string)
		secret_sink(arg0(e)[N_POS], cstr("fail would put "), cstr(" in a fault message"), fdesc, ft)
		if kind_of(ft) != K_STRING {
			err_code_type(pos, cstr("E416 FAIL_VALUE"), cstr("fail needs a str message, not "), ft, cstr(""))
		}
		replace_node(e, rt_call(pos, cstr("rt_fail"), args1(arg0(e)), ty_error))
		e[N_TYPE] = 0
		return ty_error
	}
	if streq(name, cstr("fault")) != 0 {
		// var ErrX = fault("msg") declares a sentinel: one identity per declaration (fault.Is).
		if n != 1 {
			err_code_at(pos, cstr("E417 SENTINEL"), cstr("fault needs a message: var ErrX = fault(\"...\")"))
			return ty_error
		}
		if ck_sentinel != e {
			err_code_at(pos, cstr("E417 SENTINEL"), cstr("fault(\"...\") declares a sentinel: write it at package level as var ErrX = fault(\"msg\"), or use fail(\"msg\") for a one-off fault"))
			return ty_error
		}
		let sdesc = secret_desc(arg0(e))
		mut st = chk(arg0(e), ty_string)
		secret_sink(arg0(e)[N_POS], cstr("fault would put "), cstr(" in a fault message"), sdesc, st)
		if kind_of(st) != K_STRING {
			err_code_type(pos, cstr("E417 SENTINEL"), cstr("fault needs a str message, not "), st, cstr(""))
		}
		sentinel_seq = sentinel_seq + 1
		replace_node(e, rt_call(pos, cstr("rt_fault_sentinel"), args2(arg0(e), mk_int(pos, 63 + sentinel_seq, ty_int)), ty_error))
		e[N_TYPE] = 0
		return ty_error
	}
	if streq(name, cstr("keep")) != 0 {
		if n != 1 {
			err_code_at(pos, cstr("E217 BUILTIN_ARGS"), cstr("keep needs one value"))
			return ty_int
		}
		return lower_keep(e, want)
	}
	if streq(name, cstr("reveal")) != 0 {
		return secret_reveal(e)
	}
	if streq(name, cstr("print")) != 0 || streq(name, cstr("println")) != 0 {
		if streq(name, cstr("println")) != 0 {
			return lower_say(e, cstr("Line"), want)
		}
		return lower_say(e, cstr("Text"), want)
	}
	if streq(name, cstr("min")) != 0 || streq(name, cstr("max")) != 0 {
		return lower_minmax(e, name, want)
	}
	return 0
}

fn lower_minmax(e i64, name i64, want i64) i64 {
	let pos = e[N_POS]
	let args = e[CALL_ARGS]
	let n = args[VEC_LEN]
	if n == 0 {
		err_code_quoted(pos, cstr("E210 ARG_COUNT"), cstr(""), name, cstr(" needs arguments"))
		return ty_int
	}
	chk(arg0(e), want)
	mut i = 1
	for i < n {
		unify(arg0(e), vec_get(args, i), want)
		i = i + 1
	}
	let t = default_type(arg0(e)[N_TYPE])
	i = 0
	for i < n {
		reconvert(vec_get(args, i), t)
		i = i + 1
	}
	secret_compare_error(pos, name, t, t)
	if is_numeric_t(t) == 0 && kind_of(t) != K_STRING {
		err_code_type(pos, cstr("E237 COMPARE"), cstr("cannot compare "), t, cstr(""))
	}
	// acc := a; if b < acc { acc = b }  (compiled to csel)
	let stmts = vec_new()
	let acc = temp(pos, arg0(e), t)
	vec_push(stmts, acc)
	mut op = cstr("<")
	if streq(name, cstr("max")) != 0 {
		op = cstr(">")
	}
	i = 1
	for i < n {
		let v = temp(pos, vec_get(args, i), t)
		vec_push(stmts, v)
		mut cond = mk_bin(pos, op, sym_ref_node(pos, v[LET_SYM]), sym_ref_node(pos, acc[LET_SYM]), ty_bool)
		if kind_of(t) == K_STRING {
			cond = mk_bin(pos, op, rt_call(pos, cstr("rt_str_cmp"), args2(sym_ref_node(pos, v[LET_SYM]), sym_ref_node(pos, acc[LET_SYM])), ty_int), mk_int(pos, 0, ty_int), ty_bool)
		}
		let ifs = node_new(ST_IF, pos)
		ifs[IF_COND] = cond
		ifs[IF_THEN] = empty_block(pos)
		vec_push(ifs[IF_THEN][BLK_STMTS], assign_stmt(pos, sym_ref_node(pos, acc[LET_SYM]), sym_ref_node(pos, v[LET_SYM])))
		vec_push(stmts, ifs)
		i = i + 1
	}
	replace_node(e, mk_seq(pos, stmts, sym_ref_node(pos, acc[LET_SYM]), t))
	return t
}

// lower_keep deep-copies a value into the core's long-lived ingot heap. The result may
// only be stored straight into long-lived memory (checked by the region pass).
// type_has_dyn reports whether a value of t holds a dyn value (a dyn field, element or
// optional), depth-limited so a recursive type stays finite.
fn type_has_dyn(t i64, depth i64) i64 {
	if depth > 8 {
		return 0
	}
	let k = kind_of(t)
	if k == K_DYN {
		return 1
	}
	if k == K_OPT || k == K_SLICE {
		return type_has_dyn(t[TY_ELEM], depth + 1)
	}
	if k == K_MAP {
		return i64(type_has_dyn(t[TY_KEY], depth + 1) != 0 || type_has_dyn(t[TY_ELEM], depth + 1) != 0)
	}
	if k == K_STRUCT {
		mut i = 0
		for i < t[TY_FIELDS][VEC_LEN] {
			if type_has_dyn(field_type(t, i), depth + 1) != 0 {
				return 1
			}
			i = i + 1
		}
	}
	return 0
}

fn lower_keep(e i64, want i64) i64 {
	let pos = e[N_POS]
	let x = arg0(e)
	mut t = chk(x, want)
	if is_untyped(t) != 0 {
		t = reconvert(x, default_type(t))
	}
	if kind_of(t) == K_DYN || type_has_dyn(t, 0) != 0 {
		let f = keep_fn(t)
		let c = node_new(EX_CALL, pos)
		c[CALL_NAME] = f[F_QNAME]
		c[CALL_ARGS] = args1(x)
		c[CALL_FN] = f
		c[N_TYPE] = t
		c[N_REGION] = R_OWNED
		replace_node(e, c)
		return t
	}
	if kind_of(t) == K_FUNC {
		let c = rt_call(pos, cstr("rt_keep_closure"), args1(x), t)
		c[N_REGION] = R_OWNED
		replace_node(e, c)
		return t
	}
	if is_ref(t) == 0 {
		replace_node(e, x)
		return t
	}
	let f = keep_fn(t)
	let c = node_new(EX_CALL, pos)
	c[CALL_NAME] = f[F_QNAME]
	c[CALL_ARGS] = args1(x)
	c[CALL_FN] = f
	c[N_TYPE] = t
	c[N_REGION] = R_OWNED
	replace_node(e, c)
	return t
}

// ---- argo: a JSON encoder generated for each type ----
shared mut argo_types i64
shared mut argo_fns i64

fn lower_argo_put(e i64) i64 {
	let pos = e[N_POS]
	let args = e[CALL_ARGS]
	if args[VEC_LEN] != 2 {
		err_code_at(pos, cstr("E281 ARGO"), cstr("argo.Put takes a []u8 buffer and a value"))
		return ty_void
	}
	let b = vec_get(args, 0)
	if unwrap_mut(b) == 0 {
		err_code_at(b[N_POS], cstr("E281 ARGO"), cstr("argo.Put appends to its buffer: write mut before it"))
	}
	let bt = chk(b, 0)
	if kind_of(bt) != K_SLICE || bt[TY_ELEM] != ty_byte {
		err_code_type(pos, cstr("E281 ARGO"), cstr("argo.Put writes into a []u8, not "), bt, cstr(""))
		return ty_void
	}
	let v = vec_get(args, 1)
	let vdesc = secret_desc(v)
	mut t = chk(v, 0)
	if secret_sink(v[N_POS], cstr("argo.Put would encode "), cstr(" as JSON"), vdesc, t) != 0 {
		return ty_void
	}
	if is_untyped(t) != 0 {
		t = reconvert(v, default_type(t))
	}
	let f = argo_fn(pos, t)
	if f == 0 {
		return ty_void
	}
	replace_node(e, call_fn(pos, f, args2(b, v), ty_void))
	return ty_void
}

fn call_fn(pos i64, f i64, args i64, t i64) i64 {
	let c = node_new(EX_CALL, pos)
	c[CALL_NAME] = f[F_QNAME]
	c[CALL_ARGS] = args
	c[CALL_FN] = f
	c[N_TYPE] = t
	return c
}

fn argo_lib(pos i64, name i64) i64 {
	let f = find_fn(name)
	if f == 0 {
		err_code_quoted(pos, cstr("E281 ARGO"), cstr("argo.Put needs package argo ("), name, cstr(" is missing): import \"argo\""))
	}
	return f
}

// argo_emit appends a call that writes x (of type t) to buffer b.
fn argo_emit(pos i64, body i64, b i64, x i64, t i64) {
	let k = kind_of(t)
	let bref = sym_ref_node(pos, b)
	if k == K_STRING {
		vec_push(body, expr_stmt(call_fn(pos, argo_lib(pos, cstr("argo.wstr")), args2(bref, x), ty_void)))
	} else if k == K_BOOL {
		vec_push(body, expr_stmt(call_fn(pos, argo_lib(pos, cstr("argo.wbool")), args2(bref, x), ty_void)))
	} else if is_f32(t) != 0 {
		vec_push(body, expr_stmt(call_fn(pos, argo_lib(pos, cstr("argo.wfloat32")), args2(bref, x), ty_void)))
	} else if is_float_t(t) != 0 {
		vec_push(body, expr_stmt(call_fn(pos, argo_lib(pos, cstr("argo.wfloat")), args2(bref, x), ty_void)))
	} else if k == K_INT && t[TY_SIGNED] == 0 {
		vec_push(body, expr_stmt(call_fn(pos, argo_lib(pos, cstr("argo.wuint")), args2(bref, mk_conv(pos, x, CV_SAME, ty_u64)), ty_void)))
	} else if k == K_INT {
		vec_push(body, expr_stmt(call_fn(pos, argo_lib(pos, cstr("argo.wint")), args2(bref, mk_conv(pos, x, CV_SAME, ty_int)), ty_void)))
	} else {
		let f = argo_fn(pos, t)
		if f != 0 {
			vec_push(body, expr_stmt(call_fn(pos, f, args2(bref, x), ty_void)))
		}
	}
}

fn argo_raw(pos i64, body i64, b i64, text i64) {
	vec_push(body, expr_stmt(rt_call(pos, cstr("rt_append_str"), args2(sym_ref_node(pos, b), lit_string(pos, text)), ty_byte_slice())))
}

fn ty_byte_slice() i64 {
	return slice_of(ty_byte)
}

// argo_fn returns (generating on first use) argo$N(b mut []u8, x T), the encoder for T.
fn argo_fn(pos i64, t i64) i64 {
	if argo_types == 0 {
		argo_types = vec_new()
		argo_fns = vec_new()
	}
	mut i = 0
	for i < argo_types[VEC_LEN] {
		if vec_get(argo_types, i) == t {
			return vec_get(argo_fns, i)
		}
		i = i + 1
	}
	let k = kind_of(t)
	if !(k == K_STRUCT || k == K_SLICE || k == K_MAP || k == K_OPT || k == K_ERROR || k == K_STRING || k == K_INT || k == K_BOOL || is_float_t(t) != 0) {
		err_code_type(pos, cstr("E281 ARGO"), cstr("argo cannot encode values of type "), t, cstr(""))
		return 0
	}
	if k == K_MAP && kind_of(t[TY_KEY]) != K_STRING && kind_of(t[TY_KEY]) != K_INT {
		err_code_type(pos, cstr("E281 ARGO"), cstr("argo encodes maps with str or integer keys, not "), t, cstr(""))
		return 0
	}
	lifted_count = lifted_count + 1
	let f = fn_new(0, cstr("argo"))
	let nb = buf_new()
	buf_str(nb, cstr("argo$"))
	buf_int(nb, lifted_count)
	buf_byte(nb, 0)
	f[F_QNAME] = nb[VEC_DATA]
	f[F_NAME] = nb[VEC_DATA]
	f[F_LIFTED] = 2
	let bt = ty_byte_slice()
	vec_push(f[F_PARAMS], cstr("b"))
	vec_push(f[F_PARAMS], cstr("x"))
	vec_push(f[F_PTYPES], bt)
	vec_push(f[F_PTYPES], t)
	vec_push(f[F_MUTS], 1)
	vec_push(f[F_MUTS], 0)
	f[F_TYPE] = func_of(f[F_PTYPES], f[F_RTYPES], 0)
	f[F_LOCALS] = vec_new()
	f[F_BODY] = empty_block(0)
	vec_push(argo_types, t)
	vec_push(argo_fns, f)
	vec_push(prog_fns, f)
	let saved_fn = ck_fn
	ck_fn = f
	let b = sym_new(SYM_LOCAL, cstr("b"), 0)
	b[S_TYPE] = bt
	b[S_SLOT] = 0
	b[S_MUT] = 1
	let x = sym_new(SYM_LOCAL, cstr("x"), 0)
	x[S_TYPE] = t
	x[S_SLOT] = 1
	f[F_SLOTS] = 2
	vec_push(f[F_LOCALS], b)
	vec_push(f[F_LOCALS], x)
	let body = f[F_BODY][BLK_STMTS]
	if k == K_STRUCT && t[TY_ENUM] != 0 {
		// "Name" for a variant without data, {"Name":{"field":...}} for one with data.
		let vs = t[TY_ENUM]
		mut vi = 0
		for vi < vs[VEC_LEN] {
			let v = vec_get(vs, vi)
			let ifs = node_new(ST_IF, pos)
			ifs[IF_COND] = mk_bin(pos, cstr("=="), mk_mem(pos, sym_ref_node(pos, x), 0, 0, field_offset(t, 0), ty_int), mk_int(pos, vi, ty_int), ty_bool)
			ifs[IF_THEN] = empty_block(pos)
			let vb = ifs[IF_THEN][BLK_STMTS]
			let vn = vec_get(v, 0)
			let nfv = vec_get(v, 2)
			let head = buf_new()
			if nfv == 0 {
				buf_byte(head, '"')
				buf_str(head, vn)
				buf_byte(head, '"')
				buf_byte(head, 0)
				argo_raw(pos, vb, b, head[VEC_DATA])
			} else {
				buf_str(head, cstr("{{\""))
				buf_str(head, vn)
				buf_str(head, cstr("\":"))
				buf_byte(head, 0)
				argo_raw(pos, vb, b, head[VEC_DATA])
				mut kk = 0
				for kk < nfv {
					let fi2 = vec_get(v, 1) + kk
					let full = vec_get(vec_get(t[TY_FIELDS], fi2), 0)
					let piece = buf_new()
					if kk == 0 {
						buf_byte(piece, '{')
					} else {
						buf_byte(piece, ',')
					}
					buf_byte(piece, '"')
					buf_str(piece, full + strlen(vn) + 1)
					buf_str(piece, cstr("\":"))
					buf_byte(piece, 0)
					argo_raw(pos, vb, b, piece[VEC_DATA])
					let ft2 = field_type(t, fi2)
					argo_emit(pos, vb, b, mk_mem(pos, sym_ref_node(pos, x), 0, 0, field_offset(t, fi2), ft2), ft2)
					kk = kk + 1
				}
				argo_raw(pos, vb, b, cstr("}}}}"))
			}
			vec_push(body, ifs)
			vi = vi + 1
		}
	} else if k == K_STRUCT {
		let nf = t[TY_FIELDS][VEC_LEN]
		mut fi = 0
		mut lead = cstr("{{")
		for fi < nf {
			mut fname = vec_get(vec_get(t[TY_FIELDS], fi), 0)
			let json_name = vec_get(vec_get(t[TY_FIELDS], fi), 5)
			if json_name != 0 {
				fname = json_name
			}
			let ft = field_type(t, fi)
			let piece = buf_new()
			buf_str(piece, lead)
			buf_byte(piece, '"')
			buf_str(piece, fname)
			buf_str(piece, cstr("\":"))
			buf_byte(piece, 0)
			argo_raw(pos, body, b, piece[VEC_DATA])
			argo_emit(pos, body, b, mk_mem(pos, sym_ref_node(pos, x), 0, 0, field_offset(t, fi), ft), ft)
			lead = cstr(",")
			fi = fi + 1
		}
		if nf == 0 {
			argo_raw(pos, body, b, cstr("{{}}"))
		} else {
			argo_raw(pos, body, b, cstr("}}"))
		}
	} else if k == K_OPT || k == K_ERROR {
		let ifs = node_new(ST_IF, pos)
		ifs[IF_COND] = mk_bin(pos, cstr("=="), sym_ref_node(pos, x), mk_int(pos, 0, t), ty_bool)
		ifs[IF_THEN] = empty_block(pos)
		argo_raw(pos, ifs[IF_THEN][BLK_STMTS], b, cstr("null"))
		let els = empty_block(pos)
		ifs[IF_ELSE] = els
		if k == K_ERROR {
			argo_emit(pos, els[BLK_STMTS], b, mk_conv(pos, sym_ref_node(pos, x), CV_SAME, ty_string), ty_string)
		} else {
			argo_emit(pos, els[BLK_STMTS], b, mk_conv(pos, sym_ref_node(pos, x), CV_SAME, t[TY_ELEM]), t[TY_ELEM])
		}
		vec_push(body, ifs)
	} else if k == K_SLICE {
		let et = t[TY_ELEM]
		argo_raw(pos, body, b, cstr("["))
		let n = temp(pos, mk_hdr(pos, sym_ref_node(pos, x), 0), ty_int)
		vec_push(body, n)
		let j = declare_local(pos, cstr("$"), ty_int)
		vec_push(body, let_stmt(pos, j, mk_int(pos, 0, ty_int)))
		let w = node_new(ST_WHILE, pos)
		w[WH_COND] = mk_bin(pos, cstr("<"), sym_ref_node(pos, j), sym_ref_node(pos, n[LET_SYM]), ty_bool)
		w[WH_POST] = assign_stmt(pos, sym_ref_node(pos, j), mk_bin(pos, cstr("+"), sym_ref_node(pos, j), mk_int(pos, 1, ty_int), ty_int))
		let wb = empty_block(pos)
		w[WH_BODY] = wb
		let comma = node_new(ST_IF, pos)
		comma[IF_COND] = mk_bin(pos, cstr(">"), sym_ref_node(pos, j), mk_int(pos, 0, ty_int), ty_bool)
		comma[IF_THEN] = empty_block(pos)
		argo_raw(pos, comma[IF_THEN][BLK_STMTS], b, cstr(","))
		vec_push(wb[BLK_STMTS], comma)
		let el = mk_elem(pos, sym_ref_node(pos, x), sym_ref_node(pos, j), et, 0)
		el[ELEM_SAFE] = 1
		argo_emit(pos, wb[BLK_STMTS], b, el, et)
		vec_push(body, w)
		argo_raw(pos, body, b, cstr("]"))
	} else if k == K_MAP {
		argo_raw(pos, body, b, cstr("{{"))
		let first = declare_local(pos, cstr("$"), ty_bool)
		vec_push(body, let_stmt(pos, first, mk_int(pos, 1, ty_bool)))
		let slots = temp(pos, rt_call(pos, cstr("rt_map_slots"), args1(sym_ref_node(pos, x)), ty_int), ty_int)
		vec_push(body, slots)
		let j2 = declare_local(pos, cstr("$"), ty_int)
		vec_push(body, let_stmt(pos, j2, mk_int(pos, 0, ty_int)))
		let w2 = node_new(ST_WHILE, pos)
		w2[WH_COND] = mk_bin(pos, cstr("<"), sym_ref_node(pos, j2), sym_ref_node(pos, slots[LET_SYM]), ty_bool)
		w2[WH_POST] = assign_stmt(pos, sym_ref_node(pos, j2), mk_bin(pos, cstr("+"), sym_ref_node(pos, j2), mk_int(pos, 1, ty_int), ty_int))
		let wb2 = empty_block(pos)
		w2[WH_BODY] = wb2
		let live = node_new(ST_IF, pos)
		live[IF_COND] = rt_call(pos, cstr("rt_map_live"), args2(sym_ref_node(pos, x), sym_ref_node(pos, j2)), ty_bool)
		live[IF_THEN] = empty_block(pos)
		let lb = live[IF_THEN][BLK_STMTS]
		let sep = node_new(ST_IF, pos)
		sep[IF_COND] = sym_ref_node(pos, first)
		sep[IF_THEN] = empty_block(pos)
		vec_push(sep[IF_THEN][BLK_STMTS], assign_stmt(pos, sym_ref_node(pos, first), mk_int(pos, 0, ty_bool)))
		sep[IF_ELSE] = empty_block(pos)
		argo_raw(pos, sep[IF_ELSE][BLK_STMTS], b, cstr(","))
		vec_push(lb, sep)
		let kt = t[TY_KEY]
		let kv = from_bits(rt_call(pos, cstr("rt_map_key"), args2(sym_ref_node(pos, x), sym_ref_node(pos, j2)), ty_int), kt)
		if kind_of(kt) == K_STRING {
			argo_emit(pos, lb, b, kv, kt)
		} else {
			argo_raw(pos, lb, b, cstr("\""))
			argo_emit(pos, lb, b, kv, kt)
			argo_raw(pos, lb, b, cstr("\""))
		}
		argo_raw(pos, lb, b, cstr(":"))
		let vt = t[TY_ELEM]
		let vv = from_bits(rt_call(pos, cstr("rt_map_val"), args2(sym_ref_node(pos, x), sym_ref_node(pos, j2)), ty_int), vt)
		argo_emit(pos, lb, b, vv, vt)
		vec_push(wb2[BLK_STMTS], live)
		vec_push(body, w2)
		argo_raw(pos, body, b, cstr("}}"))
	} else {
		argo_emit(pos, body, b, sym_ref_node(pos, x), t)
	}
	ck_fn = saved_fn
	return f
}

// ---- argo.Get: a JSON decoder generated for each type ----
shared mut argo_dtypes i64
shared mut argo_dfns i64
shared mut argo_ptype i64

fn lower_argo_get(e i64) i64 {
	let pos = e[N_POS]
	let args = e[CALL_ARGS]
	if args[VEC_LEN] != 2 {
		err_code_at(pos, cstr("E281 ARGO"), cstr("argo.Get takes the JSON text and a struct, slice or map to fill"))
		return ty_error
	}
	if unwrap_mut(vec_get(args, 1)) == 0 {
		err_code_at(vec_get(args, 1)[N_POS], cstr("E281 ARGO"), cstr("argo.Get fills its target: write mut before it"))
	}
	let s = vec_get(args, 0)
	let st = chk(s, ty_string)
	if kind_of(st) != K_STRING {
		err_code_type(pos, cstr("E281 ARGO"), cstr("argo.Get reads JSON from a str, not "), st, cstr(""))
		return ty_error
	}
	let v = vec_get(args, 1)
	let t = chk(v, 0)
	let k = kind_of(t)
	if k != K_STRUCT && k != K_SLICE && k != K_MAP {
		err_code_type(pos, cstr("E281 ARGO"), cstr("argo.Get fills a struct, slice or map (passed by reference), not "), t, cstr(""))
		return ty_error
	}
	let pt = argo_parser_type(pos)
	let df = argo_dfn(pos, t)
	if pt == 0 || df == 0 {
		return ty_error
	}
	let stmts = vec_new()
	let p = temp(pos, call_fn(pos, argo_lib(pos, cstr("argo.parser")), args1(s), pt), pt)
	vec_push(stmts, p)
	vec_push(stmts, expr_stmt(call_fn(pos, df, args2(sym_ref_node(pos, p[LET_SYM]), v), ty_void)))
	let fin = call_fn(pos, argo_lib(pos, cstr("argo.finish")), args1(sym_ref_node(pos, p[LET_SYM])), ty_error)
	replace_node(e, mk_seq(pos, stmts, fin, ty_error))
	return ty_error
}

fn argo_parser_type(pos i64) i64 {
	if argo_ptype == 0 {
		argo_ptype = find_type(cstr("argo.Parser"))
		if argo_ptype == 0 {
			err_code_at(pos, cstr("E281 ARGO"), cstr("argo.Get needs package argo: import \"argo\""))
		}
	}
	return argo_ptype
}

// argo_rd is a call of reader name on parser p, of type t.
fn argo_rd(pos i64, p i64, name i64, t i64) i64 {
	return call_fn(pos, argo_lib(pos, name), args1(sym_ref_node(pos, p)), t)
}

fn argo_err_return(pos i64, body i64, p i64) {
	let pt = argo_ptype
	let fi = struct_field(pt, cstr("err"))
	let ifs = node_new(ST_IF, pos)
	ifs[IF_COND] = mk_bin(pos, cstr("!="), mk_mem(pos, sym_ref_node(pos, p), 0, 0, field_offset(pt, fi), ty_error), mk_int(pos, 0, ty_error), ty_bool)
	ifs[IF_THEN] = empty_block(pos)
	vec_push(ifs[IF_THEN][BLK_STMTS], node_new(ST_RETURN, pos))
	vec_push(body, ifs)
}

// argo_new is a fresh value of type t with every reference field made (decode target).
fn argo_new(pos i64, body i64, t i64) i64 {
	let k = kind_of(t)
	if k == K_STRING {
		return lit_string(pos, cstr(""))
	}
	if k == K_SLICE {
		return rt_call(pos, cstr("rt_slice_make"), args3(mk_int(pos, 0, ty_int), mk_int(pos, 0, ty_int), mk_int(pos, elem_size(t), ty_int)), t)
	}
	if k == K_MAP {
		return map_make_call(pos, t)
	}
	if k != K_STRUCT {
		return mk_int(pos, 0, t)
	}
	if t[TY_ENUM] != 0 {
		return enum_zero(pos, body, t)
	}
	let obj = temp(pos, rt_call(pos, cstr("rt_alloc"), args1(mk_int(pos, t[TY_SIZE], ty_int)), t), t)
	vec_push(body, obj)
	mut fi = 0
	for fi < t[TY_FIELDS][VEC_LEN] {
		let ft = field_type(t, fi)
		let fk = kind_of(ft)
		if fk == K_STRING || fk == K_SLICE || fk == K_MAP || fk == K_STRUCT {
			vec_push(body, assign_stmt(pos, field_store(pos, sym_ref_node(pos, obj[LET_SYM]), t, fi), argo_new(pos, body, ft)))
		}
		fi = fi + 1
	}
	return sym_ref_node(pos, obj[LET_SYM])
}

shared mut enum_zeroing i64 // enums whose zero value is being built (a recursion guard)

// enum_zero is an enum's zero value: its first variant without data, else variant 0 with
// zero fields (an enum whose every variant holds itself has no finite zero value).
fn enum_zero(pos i64, body i64, t i64) i64 {
	if enum_zeroing == 0 {
		enum_zeroing = vec_new()
	}
	let vs = t[TY_ENUM]
	mut vi = 0
	for vi < vs[VEC_LEN] && vec_get(vec_get(vs, vi), 2) > 0 {
		vi = vi + 1
	}
	if vi == vs[VEC_LEN] {
		vi = 0
	}
	let obj = temp(pos, rt_call(pos, cstr("rt_alloc"), args1(mk_int(pos, t[TY_SIZE], ty_int)), t), t)
	vec_push(body, obj)
	vec_push(body, assign_stmt(pos, field_store(pos, sym_ref_node(pos, obj[LET_SYM]), t, 0), mk_int(pos, vi, ty_int)))
	let v = vec_get(vs, vi)
	mut i = 0
	for i < enum_zeroing[VEC_LEN] {
		if vec_get(enum_zeroing, i) == t {
			err_code_type(pos, cstr("E281 ARGO"), cstr("enum "), t, cstr(" has no zero value: give it a variant without data"))
			return sym_ref_node(pos, obj[LET_SYM])
		}
		i = i + 1
	}
	vec_push(enum_zeroing, t)
	mut k = 0
	for k < vec_get(v, 2) {
		let fi = vec_get(v, 1) + k
		let ft = field_type(t, fi)
		let fk = kind_of(ft)
		if fk == K_STRING || fk == K_SLICE || fk == K_MAP || fk == K_STRUCT {
			vec_push(body, assign_stmt(pos, field_store(pos, sym_ref_node(pos, obj[LET_SYM]), t, fi), argo_new(pos, body, ft)))
		}
		k = k + 1
	}
	enum_zeroing[VEC_LEN] = enum_zeroing[VEC_LEN] - 1
	return sym_ref_node(pos, obj[LET_SYM])
}

// argo_value appends statements that decode one value of type t and returns it, or 0
// when t cannot be decoded (an error is reported).
fn argo_value(pos i64, body i64, p i64, t i64) i64 {
	let k = kind_of(t)
	if k == K_STRING && t[TY_BOUND] != 0 {
		// A str max n stops reading at the bound (#240).
		return call_fn(pos, argo_lib(pos, cstr("argo.rstrmax")), args2(sym_ref_node(pos, p), mk_int(pos, t[TY_MAX], ty_int)), ty_string)
	}
	if k == K_STRING {
		return argo_rd(pos, p, cstr("argo.rstr"), ty_string)
	}
	if k == K_BOOL {
		return argo_rd(pos, p, cstr("argo.rbool"), ty_bool)
	}
	if is_f32(t) != 0 {
		return argo_rd(pos, p, cstr("argo.rfloat32"), ty_f32)
	}
	if is_float_t(t) != 0 {
		return argo_rd(pos, p, cstr("argo.rfloat"), ty_float)
	}
	if k == K_INT {
		let w = t[TY_WIDTH]
		if w == 8 && t[TY_SIGNED] != 0 {
			return argo_rd(pos, p, cstr("argo.rint"), ty_int)
		}
		if w == 8 {
			return argo_rd(pos, p, cstr("argo.ruint"), ty_u64)
		}
		mut lo = 0
		mut hi = (1 << (8 * w)) - 1
		if t[TY_SIGNED] != 0 {
			lo = 0 - (1 << (8 * w - 1))
			hi = (1 << (8 * w - 1)) - 1
		}
		let c = call_fn(pos, argo_lib(pos, cstr("argo.rintr")), args3(sym_ref_node(pos, p), mk_int(pos, lo, ty_int), mk_int(pos, hi, ty_int)), ty_int)
		return mk_conv(pos, c, CV_INT, t)
	}
	if k == K_STRUCT || k == K_SLICE || k == K_MAP {
		let obj = temp(pos, argo_new(pos, body, t), t)
		vec_push(body, obj)
		let df = argo_dfn(pos, t)
		if df == 0 {
			return 0
		}
		vec_push(body, expr_stmt(call_fn(pos, df, args2(sym_ref_node(pos, p), sym_ref_node(pos, obj[LET_SYM])), ty_void)))
		return sym_ref_node(pos, obj[LET_SYM])
	}
	if k == K_OPT {
		let et = t[TY_ELEM]
		if is_ref(et) == 0 || kind_of(et) == K_FUNC {
			err_code_type(pos, cstr("E281 ARGO"), cstr("argo.Get decodes optionals of references only, not "), t, cstr(""))
			return 0
		}
		let out = declare_local(pos, cstr("$"), t)
		vec_push(body, let_stmt(pos, out, mk_int(pos, 0, t)))
		let ifs = node_new(ST_IF, pos)
		ifs[IF_COND] = mk_unot(pos, argo_rd(pos, p, cstr("argo.rnull"), ty_bool))
		ifs[IF_THEN] = empty_block(pos)
		let inner = argo_value(pos, ifs[IF_THEN][BLK_STMTS], p, et)
		if inner == 0 {
			return 0
		}
		vec_push(ifs[IF_THEN][BLK_STMTS], assign_stmt(pos, sym_ref_node(pos, out), mk_conv(pos, inner, CV_SAME, t)))
		vec_push(body, ifs)
		return sym_ref_node(pos, out)
	}
	err_code_type(pos, cstr("E281 ARGO"), cstr("argo.Get cannot decode values of type "), t, cstr(""))
	return 0
}

fn mk_unot(pos i64, x i64) i64 {
	let u = node_new(EX_UNARY, pos)
	u[UN_OP] = cstr("!")
	u[UN_X] = x
	u[N_TYPE] = ty_bool
	return u
}

fn forever(pos i64) i64 {
	let w = node_new(ST_WHILE, pos)
	w[WH_COND] = mk_int(pos, 1, ty_bool)
	w[WH_BODY] = empty_block(pos)
	return w
}

// argo_more ends a loop body: if !argo.rmore(p, close) { break }.
fn argo_more(pos i64, body i64, p i64, close i64) {
	let ifs = node_new(ST_IF, pos)
	ifs[IF_COND] = mk_unot(pos, call_fn(pos, argo_lib(pos, cstr("argo.rmore")), args2(sym_ref_node(pos, p), mk_int(pos, close, ty_byte)), ty_bool))
	ifs[IF_THEN] = empty_block(pos)
	vec_push(ifs[IF_THEN][BLK_STMTS], node_new(ST_BREAK, pos))
	vec_push(body, ifs)
}

// argo_denum decodes into enum x: renum gives the variant name (and whether it came as
// {"Name": payload}); the tag is set and the payload's fields are read by name.
fn argo_denum(pos i64, body i64, p i64, x i64, t i64) {
	let cm = node_new(ST_CALLMULTI, pos)
	cm[CM_CALL] = call_fn(pos, argo_lib(pos, cstr("argo.renum")), args1(sym_ref_node(pos, p)), ty_void)
	let nm = declare_local(pos, cstr("$"), ty_string)
	let boxed = declare_local(pos, cstr("$"), ty_bool)
	cm[CM_SYMS] = vec_new()
	vec_push(cm[CM_SYMS], nm)
	vec_push(cm[CM_SYMS], boxed)
	vec_push(body, cm)
	argo_err_return(pos, body, p)
	let vs = t[TY_ENUM]
	mut first = 0
	mut last = 0
	mut vi = 0
	for vi < vs[VEC_LEN] {
		let v = vec_get(vs, vi)
		let vn = vec_get(v, 0)
		let nfv = vec_get(v, 2)
		let br = node_new(ST_IF, pos)
		br[IF_COND] = rt_call(pos, cstr("rt_str_eq"), args2(sym_ref_node(pos, nm), lit_string(pos, vn)), ty_bool)
		br[IF_THEN] = empty_block(pos)
		let bb = br[IF_THEN][BLK_STMTS]
		vec_push(bb, assign_stmt(pos, field_store(pos, sym_ref_node(pos, x), t, 0), mk_int(pos, vi, ty_int)))
		mut z = 0
		for z < nfv {
			let zf = vec_get(v, 1) + z
			let zt = field_type(t, zf)
			let zk = kind_of(zt)
			if zk == K_STRING || zk == K_SLICE || zk == K_MAP || zk == K_STRUCT {
				vec_push(bb, assign_stmt(pos, field_store(pos, sym_ref_node(pos, x), t, zf), argo_new(pos, bb, zt)))
			}
			z = z + 1
		}
		if nfv == 0 {
			// A bare "Name"; {"Name": anything} skips the payload.
			let ib = node_new(ST_IF, pos)
			ib[IF_COND] = sym_ref_node(pos, boxed)
			ib[IF_THEN] = empty_block(pos)
			vec_push(ib[IF_THEN][BLK_STMTS], expr_stmt(call_fn(pos, argo_lib(pos, cstr("argo.rskip")), args1(sym_ref_node(pos, p)), ty_void)))
			vec_push(ib[IF_THEN][BLK_STMTS], expr_stmt(call_fn(pos, argo_lib(pos, cstr("argo.rclose")), args1(sym_ref_node(pos, p)), ty_void)))
			vec_push(bb, ib)
		} else {
			let nb = node_new(ST_IF, pos)
			nb[IF_COND] = mk_unot(pos, sym_ref_node(pos, boxed))
			nb[IF_THEN] = empty_block(pos)
			vec_push(nb[IF_THEN][BLK_STMTS], expr_stmt(call_fn(pos, argo_lib(pos, cstr("argo.rvariant")), args2(sym_ref_node(pos, p), sym_ref_node(pos, nm)), ty_void)))
			vec_push(nb[IF_THEN][BLK_STMTS], node_new(ST_RETURN, pos))
			vec_push(bb, nb)
			let ob = node_new(ST_IF, pos)
			ob[IF_COND] = argo_rd(pos, p, cstr("argo.robj"), ty_bool)
			ob[IF_THEN] = empty_block(pos)
			let w = forever(pos)
			vec_push(ob[IF_THEN][BLK_STMTS], w)
			let wb = w[WH_BODY][BLK_STMTS]
			let key = temp(pos, argo_rd(pos, p, cstr("argo.rkey"), ty_string), ty_string)
			vec_push(wb, key)
			argo_err_return(pos, wb, p)
			mut chain = 0
			mut lastf = 0
			mut kk = 0
			for kk < nfv {
				let fi = vec_get(v, 1) + kk
				let full = vec_get(vec_get(t[TY_FIELDS], fi), 0)
				let ft = field_type(t, fi)
				let fb = node_new(ST_IF, pos)
				fb[IF_COND] = rt_call(pos, cstr("rt_str_eq"), args2(sym_ref_node(pos, key[LET_SYM]), lit_string(pos, full + strlen(vn) + 1)), ty_bool)
				fb[IF_THEN] = empty_block(pos)
				let fbb = fb[IF_THEN][BLK_STMTS]
				let fk = kind_of(ft)
				if fk == K_STRUCT || fk == K_SLICE || fk == K_MAP {
					let df = argo_dfn(pos, ft)
					if df != 0 {
						vec_push(fbb, expr_stmt(call_fn(pos, df, args2(sym_ref_node(pos, p), mk_mem(pos, sym_ref_node(pos, x), 0, 0, field_offset(t, fi), ft)), ty_void)))
					}
				} else {
					let val = argo_value(pos, fbb, p, ft)
					if val != 0 {
						vec_push(fbb, assign_stmt(pos, field_store(pos, sym_ref_node(pos, x), t, fi), val))
					}
				}
				if lastf != 0 {
					let eb = empty_block(pos)
					vec_push(eb[BLK_STMTS], fb)
					lastf[IF_ELSE] = eb
				} else {
					chain = fb
				}
				lastf = fb
				kk = kk + 1
			}
			let sb = empty_block(pos)
			vec_push(sb[BLK_STMTS], expr_stmt(call_fn(pos, argo_lib(pos, cstr("argo.rskip")), args1(sym_ref_node(pos, p)), ty_void)))
			lastf[IF_ELSE] = sb
			vec_push(wb, chain)
			argo_more(pos, wb, p, '}')
			vec_push(bb, ob)
			vec_push(bb, expr_stmt(call_fn(pos, argo_lib(pos, cstr("argo.rclose")), args1(sym_ref_node(pos, p)), ty_void)))
		}
		if last != 0 {
			let eb2 = empty_block(pos)
			vec_push(eb2[BLK_STMTS], br)
			last[IF_ELSE] = eb2
		} else {
			first = br
		}
		last = br
		vi = vi + 1
	}
	let unk = empty_block(pos)
	vec_push(unk[BLK_STMTS], expr_stmt(call_fn(pos, argo_lib(pos, cstr("argo.rvariant")), args2(sym_ref_node(pos, p), sym_ref_node(pos, nm)), ty_void)))
	last[IF_ELSE] = unk
	vec_push(body, first)
}

// argo_bound stops decoding a bounded slice or map x before an element past its bound:
// if len(x) >= max { argo.over(p, max); return } (#240).
fn argo_bound(pos i64, body i64, p i64, x i64, t i64) {
	if t[TY_BOUND] == 0 {
		return
	}
	let ifs = node_new(ST_IF, pos)
	ifs[IF_COND] = mk_bin(pos, cstr(">="), mk_hdr(pos, sym_ref_node(pos, x), 0), mk_int(pos, t[TY_MAX], ty_int), ty_bool)
	ifs[IF_THEN] = empty_block(pos)
	vec_push(ifs[IF_THEN][BLK_STMTS], expr_stmt(call_fn(pos, argo_lib(pos, cstr("argo.over")), args2(sym_ref_node(pos, p), mk_int(pos, t[TY_MAX], ty_int)), ty_void)))
	vec_push(ifs[IF_THEN][BLK_STMTS], node_new(ST_RETURN, pos))
	vec_push(body, ifs)
}

// argo_dfn returns (generating on first use) argo$dN(p mut argo.Parser, x mut T), which
// fills x from the JSON value at p.
fn argo_dfn(pos i64, t i64) i64 {
	if argo_dtypes == 0 {
		argo_dtypes = vec_new()
		argo_dfns = vec_new()
	}
	mut i = 0
	for i < argo_dtypes[VEC_LEN] {
		if vec_get(argo_dtypes, i) == t {
			return vec_get(argo_dfns, i)
		}
		i = i + 1
	}
	let pt = argo_parser_type(pos)
	if pt == 0 {
		return 0
	}
	let k = kind_of(t)
	if k == K_MAP && kind_of(t[TY_KEY]) != K_STRING {
		err_code_type(pos, cstr("E281 ARGO"), cstr("argo.Get decodes maps with str keys, not "), t, cstr(""))
		return 0
	}
	lifted_count = lifted_count + 1
	let f = fn_new(0, cstr("argo"))
	let nb = buf_new()
	buf_str(nb, cstr("argo$d"))
	buf_int(nb, lifted_count)
	buf_byte(nb, 0)
	f[F_QNAME] = nb[VEC_DATA]
	f[F_NAME] = nb[VEC_DATA]
	f[F_LIFTED] = 2
	vec_push(f[F_PARAMS], cstr("p"))
	vec_push(f[F_PARAMS], cstr("x"))
	vec_push(f[F_PTYPES], pt)
	vec_push(f[F_PTYPES], t)
	vec_push(f[F_MUTS], 1)
	vec_push(f[F_MUTS], 1)
	f[F_TYPE] = func_of(f[F_PTYPES], f[F_RTYPES], 0)
	f[F_LOCALS] = vec_new()
	f[F_BODY] = empty_block(0)
	vec_push(argo_dtypes, t)
	vec_push(argo_dfns, f)
	vec_push(prog_fns, f)
	let saved_fn = ck_fn
	ck_fn = f
	let p = sym_new(SYM_LOCAL, cstr("p"), 0)
	p[S_TYPE] = pt
	p[S_SLOT] = 0
	p[S_MUT] = 1
	let x = sym_new(SYM_LOCAL, cstr("x"), 0)
	x[S_TYPE] = t
	x[S_SLOT] = 1
	x[S_MUT] = 1
	f[F_SLOTS] = 2
	vec_push(f[F_LOCALS], p)
	vec_push(f[F_LOCALS], x)
	let body = f[F_BODY][BLK_STMTS]
	if k == K_STRUCT && t[TY_ENUM] != 0 {
		argo_denum(pos, body, p, x, t)
	} else if k == K_STRUCT {
		let ifs = node_new(ST_IF, pos)
		ifs[IF_COND] = mk_unot(pos, argo_rd(pos, p, cstr("argo.robj"), ty_bool))
		ifs[IF_THEN] = empty_block(pos)
		vec_push(ifs[IF_THEN][BLK_STMTS], node_new(ST_RETURN, pos))
		vec_push(body, ifs)
		let w = forever(pos)
		vec_push(body, w)
		let wb = w[WH_BODY][BLK_STMTS]
		let key = temp(pos, argo_rd(pos, p, cstr("argo.rkey"), ty_string), ty_string)
		vec_push(wb, key)
		argo_err_return(pos, wb, p)
		mut chain = 0
		mut last = 0
		mut fi = 0
		for fi < t[TY_FIELDS][VEC_LEN] {
			mut fname = vec_get(vec_get(t[TY_FIELDS], fi), 0)
			let json_name = vec_get(vec_get(t[TY_FIELDS], fi), 5)
			if json_name != 0 {
				fname = json_name
			}
			let ft = field_type(t, fi)
			let br = node_new(ST_IF, pos)
			br[IF_COND] = rt_call(pos, cstr("rt_str_eq"), args2(sym_ref_node(pos, key[LET_SYM]), lit_string(pos, fname)), ty_bool)
			br[IF_THEN] = empty_block(pos)
			let bb = br[IF_THEN][BLK_STMTS]
			let fk = kind_of(ft)
			if fk == K_STRUCT || fk == K_SLICE || fk == K_MAP {
				// Fill the object the field already holds.
				let df = argo_dfn(pos, ft)
				if df != 0 {
					vec_push(bb, expr_stmt(call_fn(pos, df, args2(sym_ref_node(pos, p), mk_mem(pos, sym_ref_node(pos, x), 0, 0, field_offset(t, fi), ft)), ty_void)))
				}
			} else {
				let val = argo_value(pos, bb, p, ft)
				if val != 0 {
					vec_push(bb, assign_stmt(pos, field_store(pos, sym_ref_node(pos, x), t, fi), val))
				}
			}
			if last != 0 {
				let eb = empty_block(pos)
				vec_push(eb[BLK_STMTS], br)
				last[IF_ELSE] = eb
			} else {
				chain = br
			}
			last = br
			fi = fi + 1
		}
		let skip = expr_stmt(call_fn(pos, argo_lib(pos, cstr("argo.rskip")), args1(sym_ref_node(pos, p)), ty_void))
		if last != 0 {
			let sb = empty_block(pos)
			vec_push(sb[BLK_STMTS], skip)
			last[IF_ELSE] = sb
			vec_push(wb, chain)
		} else {
			vec_push(wb, skip)
		}
		argo_more(pos, wb, p, '}')
	} else if k == K_SLICE {
		let et = t[TY_ELEM]
		let ifs2 = node_new(ST_IF, pos)
		ifs2[IF_COND] = mk_unot(pos, argo_rd(pos, p, cstr("argo.rarr"), ty_bool))
		ifs2[IF_THEN] = empty_block(pos)
		vec_push(ifs2[IF_THEN][BLK_STMTS], node_new(ST_RETURN, pos))
		vec_push(body, ifs2)
		let w2 = forever(pos)
		vec_push(body, w2)
		let wb2 = w2[WH_BODY][BLK_STMTS]
		argo_bound(pos, wb2, p, x, t)
		let ev = argo_value(pos, wb2, p, et)
		if ev != 0 {
			vec_push(wb2, expr_stmt(rt_call(pos, cstr("rt_append"), args3(sym_ref_node(pos, x), elem_bits(ev, t[TY_ELEM]), mk_int(pos, elem_size(t), ty_int)), t)))
		}
		argo_err_return(pos, wb2, p)
		argo_more(pos, wb2, p, ']')
	} else if k == K_MAP {
		let ifs3 = node_new(ST_IF, pos)
		ifs3[IF_COND] = mk_unot(pos, argo_rd(pos, p, cstr("argo.robj"), ty_bool))
		ifs3[IF_THEN] = empty_block(pos)
		vec_push(ifs3[IF_THEN][BLK_STMTS], node_new(ST_RETURN, pos))
		vec_push(body, ifs3)
		let w3 = forever(pos)
		vec_push(body, w3)
		let wb3 = w3[WH_BODY][BLK_STMTS]
		argo_bound(pos, wb3, p, x, t)
		let mk = temp(pos, argo_rd(pos, p, cstr("argo.rkey"), ty_string), ty_string)
		vec_push(wb3, mk)
		argo_err_return(pos, wb3, p)
		let mv = argo_value(pos, wb3, p, t[TY_ELEM])
		if mv != 0 {
			vec_push(wb3, expr_stmt(rt_call(pos, cstr("rt_map_set"), args4(sym_ref_node(pos, x), sym_ref_node(pos, mk[LET_SYM]), to_bits(mv), mk_int(pos, 1, ty_int)), ty_void)))
		}
		argo_err_return(pos, wb3, p)
		argo_more(pos, wb3, p, '}')
	}
	ck_fn = saved_fn
	return f
}

// ---- say: formatting without interfaces ----
fn is_say_func(m i64) i64 {
	return i64(streq(m, cstr("Line")) != 0 || streq(m, cstr("Text")) != 0 || streq(m, cstr("Out")) != 0 || streq(m, cstr("Fmt")) != 0 || streq(m, cstr("Str")) != 0 || streq(m, cstr("Fault")) != 0 || streq(m, cstr("To")) != 0 || streq(m, cstr("LineTo")) != 0)
}

// say_arg formats one argument by its static type: prefix + "i", "s", "f", ...
// say_type_has_dyn reports whether a struct's fields (or a container's element) hold a
// dyn value, which has no formatter until the table lands. The depth limit keeps a
// recursive type (an enum holding itself) finite; a deeper dyn is still caught by
// say_arg when the recursion reaches it.
fn say_type_has_dyn(t i64) i64 {
	return say_type_has_dyn_at(t, 0)
}

fn say_type_has_dyn_at(t i64, depth i64) i64 {
	if depth > 8 {
		return 0
	}
	let k = kind_of(t)
	if k == K_DYN {
		return 1
	}
	if k == K_OPT || k == K_SLICE {
		return say_type_has_dyn_at(t[TY_ELEM], depth + 1)
	}
	if k == K_MAP {
		return i64(say_type_has_dyn_at(t[TY_KEY], depth + 1) != 0 || say_type_has_dyn_at(t[TY_ELEM], depth + 1) != 0)
	}
	if k == K_STRUCT {
		mut i = 0
		for i < t[TY_FIELDS][VEC_LEN] {
			if say_type_has_dyn_at(field_type(t, i), depth + 1) != 0 {
				return 1
			}
			i = i + 1
		}
	}
	return 0
}

fn say_arg(a i64, prefix i64) i64 {
	let pos = a[N_POS]
	let t = default_type(chk(a, 0))
	check_value(pos, t)
	if is_untyped(a[N_TYPE]) != 0 {
		reconvert(a, t)
	}
	let k = kind_of(t)
	mut suffix = cstr("i")
	if k == K_STRING {
		suffix = cstr("s")
	} else if k == K_FLOAT {
		suffix = cstr("f")
		if is_f32(t) != 0 {
			suffix = cstr("f32")
		}
	} else if k == K_BOOL {
		suffix = cstr("b")
	} else if k == K_ERROR {
		suffix = cstr("e")
	} else if is_unsigned_t(t) != 0 {
		suffix = cstr("u")
	} else if k == K_SLICE {
		let et = t[TY_ELEM]
		let ek = kind_of(et)
		if say_type_has_dyn(et) != 0 {
			err_code_at(pos, cstr("E530 DYN_NOT_YET"), cstr("cannot format a slice of dyn values: give the shape a method that formats (#141)"))
			return ty_void
		}
		if ek == K_STRING {
			suffix = cstr("sls")
		} else if ek == K_FLOAT {
			suffix = cstr("slf")
			if is_f32(et) != 0 {
				suffix = cstr("slf32")
			}
		} else if ek == K_BOOL {
			suffix = cstr("slt")
		} else if ek == K_INT {
			return rt_call(pos, str_cat3(prefix, cstr("slint"), cstr("")), args3(a, mk_int(pos, type_width(et), ty_int), mk_int(pos, et[TY_SIGNED], ty_int)), ty_void)
		} else if ek == K_STRUCT && et[TY_ENUM] != 0 {
			return say_enum_slice(a, t, prefix)
		} else if ek == K_STRUCT {
			return say_struct_slice(a, t, prefix)
		} else {
			suffix = cstr("slp")
		}
	} else if k == K_OPT && kind_of(t[TY_ELEM]) != K_STRUCT && kind_of(t[TY_ELEM]) != K_DYN {
		return say_opt(a, t, prefix)
	} else if k == K_STRUCT || k == K_OPT {
		mut st = t
		if k == K_OPT {
			if kind_of(t[TY_ELEM]) == K_DYN {
				err_code_at(pos, cstr("E530 DYN_NOT_YET"), cstr("cannot format a dyn value: give the shape a method that formats (#141)"))
				return ty_void
			}
			st = t[TY_ELEM]
		}
		if say_type_has_dyn(st) != 0 {
			err_code_at(pos, cstr("E530 DYN_NOT_YET"), cstr("cannot format a value holding a dyn value: give the shape a method that formats (#141)"))
			return ty_void
		}
		return say_struct(a, st, prefix)
	} else if k == K_MAP && key_composite(t[TY_KEY]) != 0 {
		return say_map_keyed(a, t, prefix)
	} else if k == K_MAP {
		return say_map_sorted(a, t, prefix)
	} else if k == K_DYN {
		err_code_at(pos, cstr("E530 DYN_NOT_YET"), cstr("cannot format a dyn value: give the shape a method that formats (#141)"))
		return ty_void
	} else if k != K_INT && k != K_UINT {
		suffix = cstr("p")
	}
	mut x = a
	if type_width(t) < 8 && k == K_INT {
		x = mk_conv(pos, a, CV_SAME, ty_int)
	}
	return rt_call(pos, str_cat3(prefix, suffix, cstr("")), args1(x), ty_void)
}

// say_opt prints an optional str, slice or map: <nil>, or its value as that type prints.
fn say_opt(a i64, t i64, prefix i64) i64 {
	let pos = a[N_POS]
	let stmts = vec_new()
	let obj = temp(pos, mk_conv(pos, a, CV_SAME, ty_int), ty_int)
	vec_push(stmts, obj)
	let ifs = node_new(ST_IF, pos)
	ifs[IF_COND] = mk_bin(pos, cstr("=="), sym_ref_node(pos, obj[LET_SYM]), mk_int(pos, 0, ty_int), ty_bool)
	ifs[IF_THEN] = empty_block(pos)
	vec_push(ifs[IF_THEN][BLK_STMTS], expr_stmt(rt_call(pos, str_cat3(prefix, cstr("argsep"), cstr("")), vec_new(), ty_void)))
	vec_push(ifs[IF_THEN][BLK_STMTS], expr_stmt(rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr("<nil>"))), ty_void)))
	vec_push(ifs[IF_THEN][BLK_STMTS], expr_stmt(rt_call(pos, str_cat3(prefix, cstr("argend"), cstr("")), vec_new(), ty_void)))
	ifs[IF_ELSE] = empty_block(pos)
	vec_push(ifs[IF_ELSE][BLK_STMTS], expr_stmt(say_arg(mk_conv(pos, sym_ref_node(pos, obj[LET_SYM]), CV_SAME, t[TY_ELEM]), prefix)))
	vec_push(stmts, ifs)
	return mk_seq(pos, stmts, mk_int(pos, 0, ty_int), ty_void)
}

// say_struct prints {a b c} by formatting each field in turn (nil optionals print <nil>).
fn say_struct(a i64, t i64, prefix i64) i64 {
	if t[TY_ENUM] != 0 {
		return say_enum(a, t, prefix)
	}
	let pos = a[N_POS]
	let stmts = vec_new()
	let obj = temp(pos, mk_conv(pos, a, CV_SAME, ty_int), ty_int)
	vec_push(stmts, obj)
	vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, cstr("argsep"), cstr("")), vec_new(), ty_void)))
	let nonnil = node_new(ST_IF, pos)
	nonnil[IF_COND] = mk_bin(pos, cstr("=="), sym_ref_node(pos, obj[LET_SYM]), mk_int(pos, 0, ty_int), ty_bool)
	nonnil[IF_THEN] = empty_block(pos)
	vec_push(nonnil[IF_THEN][BLK_STMTS], expr_stmt(rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr("<nil>"))), ty_void)))
	let body = empty_block(pos)
	nonnil[IF_ELSE] = body
	vec_push(body[BLK_STMTS], expr_stmt(call_fn(pos, say_struct_fn(t, prefix), args1(mk_conv(pos, sym_ref_node(pos, obj[LET_SYM]), CV_SAME, t)), ty_void)))
	vec_push(stmts, nonnil)
	vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, cstr("argend"), cstr("")), vec_new(), ty_void)))
	return mk_seq(pos, stmts, mk_int(pos, 0, ty_int), ty_void)
}

shared mut say_struct_keys i64 // [type, prefix] of each generated struct printer
shared mut say_struct_fns i64

// field_name is the declared name of field i of struct type t.
fn field_name(t i64, i i64) i64 {
	return vec_get(vec_get(t[TY_FIELDS], i), 0)
}

// say_struct_fn returns the generated function that prints one (non-nil) struct of type t as
// {v1 v2 ...}, or {name:v1 name:v2 ...} under %+v. It is a function of its own, not inline code, so
// a struct that holds itself through a slice (Node with kids []Node) terminates: the printer is
// registered before its body is built, and the recursion happens when the program runs. A field
// of struct or enum type is printed by the printer of its own type, a slice of structs element by
// element; an optional field (a pointer in effect) stays an address, as Go prints a pointer field.
fn say_struct_fn(t i64, prefix i64) i64 {
	if say_struct_keys == 0 {
		say_struct_keys = vec_new()
		say_struct_fns = vec_new()
	}
	mut i = 0
	for i < say_struct_keys[VEC_LEN] {
		let kp = vec_get(say_struct_keys, i)
		if vec_get(kp, 0) == t && streq(vec_get(kp, 1), prefix) != 0 {
			return vec_get(say_struct_fns, i)
		}
		i = i + 1
	}
	let names = vec_new()
	vec_push(names, cstr("x"))
	let types = vec_new()
	vec_push(types, t)
	let f = lifted_fn(cstr("say"), names, types, vec_new())
	let kp2 = vec_new()
	vec_push(kp2, t)
	vec_push(kp2, prefix)
	vec_push(say_struct_keys, kp2)
	vec_push(say_struct_fns, f)
	let saved_fn = ck_fn
	ck_fn = f
	let pos = 0
	let x = vec_get(f[F_LOCALS], 0)
	let body = f[F_BODY][BLK_STMTS]
	vec_push(body, expr_stmt(rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr("{{"))), ty_void)))
	let fs = t[TY_FIELDS]
	i = 0
	for i < fs[VEC_LEN] {
		if i > 0 {
			vec_push(body, expr_stmt(rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr(" "))), ty_void)))
		}
		let named = node_new(ST_IF, pos)
		named[IF_COND] = rt_call(pos, cstr("rt_fmt_plusv"), vec_new(), ty_bool)
		named[IF_THEN] = empty_block(pos)
		vec_push(named[IF_THEN][BLK_STMTS], expr_stmt(rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, str_cat3(field_name(t, i), cstr(":"), cstr("")))), ty_void)))
		vec_push(body, named)
		let ft = field_type(t, i)
		let fv = mk_mem(pos, sym_ref_node(pos, x), 0, 0, field_offset(t, i), ft)
		if kind_of(ft) == K_STRUCT && ft[TY_ENUM] != 0 {
			vec_push(body, expr_stmt(call_fn(pos, say_enum_fn(ft, prefix), args1(fv), ty_void)))
		} else if kind_of(ft) == K_STRUCT {
			vec_push(body, expr_stmt(call_fn(pos, say_struct_fn(ft, prefix), args1(fv), ty_void)))
		} else if kind_of(ft) == K_OPT && kind_of(ft[TY_ELEM]) != K_STRUCT && kind_of(ft[TY_ELEM]) != K_DYN {
			vec_push(body, expr_stmt(say_opt(fv, ft, prefix)))
		} else if kind_of(ft) == K_OPT {
			vec_push(body, expr_stmt(rt_call(pos, str_cat3(prefix, cstr("p"), cstr("")), args1(mk_conv(pos, fv, CV_SAME, ty_int)), ty_void)))
		} else {
			vec_push(body, expr_stmt(say_arg(fv, prefix)))
		}
		i = i + 1
	}
	vec_push(body, expr_stmt(rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr("}}"))), ty_void)))
	ck_fn = saved_fn
	return f
}

// say_struct_slice prints [{...} {...}] with each element through its struct's printer.
fn say_struct_slice(a i64, t i64, prefix i64) i64 {
	let pos = a[N_POS]
	let et = t[TY_ELEM]
	let stmts = vec_new()
	vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, cstr("argsep"), cstr("")), vec_new(), ty_void)))
	let sl = temp(pos, a, t)
	vec_push(stmts, sl)
	let n = temp(pos, mk_hdr(pos, sym_ref_node(pos, sl[LET_SYM]), 0), ty_int)
	vec_push(stmts, n)
	vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr("["))), ty_void)))
	let j = declare_local(pos, cstr("$"), ty_int)
	vec_push(stmts, let_stmt(pos, j, mk_int(pos, 0, ty_int)))
	let w = node_new(ST_WHILE, pos)
	w[WH_COND] = mk_bin(pos, cstr("<"), sym_ref_node(pos, j), sym_ref_node(pos, n[LET_SYM]), ty_bool)
	w[WH_POST] = assign_stmt(pos, sym_ref_node(pos, j), mk_bin(pos, cstr("+"), sym_ref_node(pos, j), mk_int(pos, 1, ty_int), ty_int))
	let wb = empty_block(pos)
	w[WH_BODY] = wb
	let sep = node_new(ST_IF, pos)
	sep[IF_COND] = mk_bin(pos, cstr(">"), sym_ref_node(pos, j), mk_int(pos, 0, ty_int), ty_bool)
	sep[IF_THEN] = empty_block(pos)
	vec_push(sep[IF_THEN][BLK_STMTS], expr_stmt(rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr(" "))), ty_void)))
	vec_push(wb[BLK_STMTS], sep)
	let el = mk_elem(pos, sym_ref_node(pos, sl[LET_SYM]), sym_ref_node(pos, j), et, 0)
	el[ELEM_SAFE] = 1
	vec_push(wb[BLK_STMTS], expr_stmt(call_fn(pos, say_struct_fn(et, prefix), args1(el), ty_void)))
	vec_push(stmts, w)
	vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr("]"))), ty_void)))
	vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, cstr("argend"), cstr("")), vec_new(), ty_void)))
	return mk_seq(pos, stmts, mk_int(pos, 0, ty_int), ty_void)
}

shared mut say_enum_keys i64 // [type, prefix] of each generated enum printer
shared mut say_enum_fns i64

// lifted_fn starts a generated function name$N with params (names, types) and results.
fn lifted_fn(base i64, names i64, types i64, rtypes i64) i64 {
	lifted_count = lifted_count + 1
	let f = fn_new(0, base)
	let nb = buf_new()
	buf_str(nb, base)
	buf_byte(nb, '$')
	buf_int(nb, lifted_count)
	buf_byte(nb, 0)
	f[F_QNAME] = nb[VEC_DATA]
	f[F_NAME] = nb[VEC_DATA]
	f[F_LIFTED] = 2
	f[F_LOCALS] = vec_new()
	mut i = 0
	for i < names[VEC_LEN] {
		vec_push(f[F_PARAMS], vec_get(names, i))
		vec_push(f[F_PTYPES], vec_get(types, i))
		vec_push(f[F_MUTS], 0)
		let ps = sym_new(SYM_LOCAL, vec_get(names, i), 0)
		ps[S_TYPE] = vec_get(types, i)
		ps[S_SLOT] = i
		vec_push(f[F_LOCALS], ps)
		i = i + 1
	}
	f[F_SLOTS] = names[VEC_LEN]
	f[F_RTYPES] = rtypes
	f[F_TYPE] = func_of(f[F_PTYPES], f[F_RTYPES], 0)
	f[F_BODY] = empty_block(0)
	vec_push(prog_fns, f)
	return f
}

// say_enum prints a variant like Circle(2) or Rect(3 4), and a variant without data as its
// name, through a generated printer per enum (so recursive enums print without expanding
// forever).
fn say_enum(a i64, t i64, prefix i64) i64 {
	let pos = a[N_POS]
	let stmts = vec_new()
	vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, cstr("argsep"), cstr("")), vec_new(), ty_void)))
	vec_push(stmts, expr_stmt(call_fn(pos, say_enum_fn(t, prefix), args1(a), ty_void)))
	vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, cstr("argend"), cstr("")), vec_new(), ty_void)))
	return mk_seq(pos, stmts, mk_int(pos, 0, ty_int), ty_void)
}

// map_key_kind is the kind rt_map_order sorts a map's key words by: 0 signed integers, 1 str,
// 2 f64, 3 unsigned integers and bool.
fn map_key_kind(kt i64) i64 {
	let k = kind_of(kt)
	if k == K_STRING {
		return 1
	}
	if k == K_FLOAT {
		return 2
	}
	if k == K_BOOL || is_unsigned_t(kt) != 0 {
		return 3
	}
	return 0
}

// say_map_sorted prints a map with str, number or bool keys as map[k:v ...], the entries in the
// order Go prints them (by key), and each key and value through its own static type, so a float
// key reads as a float and a slice or map value prints its elements.
fn say_map_sorted(a i64, t i64, prefix i64) i64 {
	let pos = a[N_POS]
	let kt = t[TY_KEY]
	let stmts = vec_new()
	vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, cstr("argsep"), cstr("")), vec_new(), ty_void)))
	let m = temp(pos, a, t)
	vec_push(stmts, m)
	let ord = temp(pos, rt_call(pos, cstr("rt_map_order"), args2(sym_ref_node(pos, m[LET_SYM]), mk_int(pos, map_key_kind(kt), ty_int)), ty_int), ty_int)
	vec_push(stmts, ord)
	let n = temp(pos, rt_call(pos, cstr("rt_map_len"), args1(sym_ref_node(pos, m[LET_SYM])), ty_int), ty_int)
	vec_push(stmts, n)
	vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr("map["))), ty_void)))
	let j = declare_local(pos, cstr("$"), ty_int)
	vec_push(stmts, let_stmt(pos, j, mk_int(pos, 0, ty_int)))
	let w = node_new(ST_WHILE, pos)
	w[WH_COND] = mk_bin(pos, cstr("<"), sym_ref_node(pos, j), sym_ref_node(pos, n[LET_SYM]), ty_bool)
	w[WH_POST] = assign_stmt(pos, sym_ref_node(pos, j), mk_bin(pos, cstr("+"), sym_ref_node(pos, j), mk_int(pos, 1, ty_int), ty_int))
	let wb = empty_block(pos)
	w[WH_BODY] = wb
	let sep = node_new(ST_IF, pos)
	sep[IF_COND] = mk_bin(pos, cstr(">"), sym_ref_node(pos, j), mk_int(pos, 0, ty_int), ty_bool)
	sep[IF_THEN] = empty_block(pos)
	vec_push(sep[IF_THEN][BLK_STMTS], expr_stmt(rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr(" "))), ty_void)))
	vec_push(wb[BLK_STMTS], sep)
	let slot = temp(pos, rt_call(pos, cstr("rt_order_at"), args2(sym_ref_node(pos, ord[LET_SYM]), sym_ref_node(pos, j)), ty_int), ty_int)
	vec_push(wb[BLK_STMTS], slot)
	let kv = from_bits(rt_call(pos, cstr("rt_map_key"), args2(sym_ref_node(pos, m[LET_SYM]), sym_ref_node(pos, slot[LET_SYM])), ty_int), kt)
	vec_push(wb[BLK_STMTS], expr_stmt(say_arg(kv, prefix)))
	vec_push(wb[BLK_STMTS], expr_stmt(rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr(":"))), ty_void)))
	let vv = from_bits(rt_call(pos, cstr("rt_map_val"), args2(sym_ref_node(pos, m[LET_SYM]), sym_ref_node(pos, slot[LET_SYM])), ty_int), t[TY_ELEM])
	vec_push(wb[BLK_STMTS], expr_stmt(say_arg(vv, prefix)))
	vec_push(stmts, w)
	vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr("]"))), ty_void)))
	vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, cstr("argend"), cstr("")), vec_new(), ty_void)))
	return mk_seq(pos, stmts, mk_int(pos, 0, ty_int), ty_void)
}

// say_map_keyed prints a map with struct or enum keys as map[k:v ...] in insertion order.
fn say_map_keyed(a i64, t i64, prefix i64) i64 {
	let pos = a[N_POS]
	let stmts = vec_new()
	vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, cstr("argsep"), cstr("")), vec_new(), ty_void)))
	let m = temp(pos, a, t)
	vec_push(stmts, m)
	let n = temp(pos, rt_call(pos, cstr("rt_map_slots"), args1(sym_ref_node(pos, m[LET_SYM])), ty_int), ty_int)
	vec_push(stmts, n)
	let first = declare_local(pos, cstr("$"), ty_bool)
	vec_push(stmts, let_stmt(pos, first, mk_int(pos, 1, ty_bool)))
	vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr("map["))), ty_void)))
	let j = declare_local(pos, cstr("$"), ty_int)
	vec_push(stmts, let_stmt(pos, j, mk_int(pos, 0, ty_int)))
	let w = node_new(ST_WHILE, pos)
	w[WH_COND] = mk_bin(pos, cstr("<"), sym_ref_node(pos, j), sym_ref_node(pos, n[LET_SYM]), ty_bool)
	w[WH_POST] = assign_stmt(pos, sym_ref_node(pos, j), mk_bin(pos, cstr("+"), sym_ref_node(pos, j), mk_int(pos, 1, ty_int), ty_int))
	let wb = empty_block(pos)
	w[WH_BODY] = wb
	let live = node_new(ST_IF, pos)
	live[IF_COND] = rt_call(pos, cstr("rt_map_live"), args2(sym_ref_node(pos, m[LET_SYM]), sym_ref_node(pos, j)), ty_bool)
	live[IF_THEN] = empty_block(pos)
	let lb = live[IF_THEN][BLK_STMTS]
	let sep = node_new(ST_IF, pos)
	sep[IF_COND] = mk_unot(pos, sym_ref_node(pos, first))
	sep[IF_THEN] = empty_block(pos)
	vec_push(sep[IF_THEN][BLK_STMTS], expr_stmt(rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr(" "))), ty_void)))
	vec_push(lb, sep)
	vec_push(lb, assign_stmt(pos, sym_ref_node(pos, first), mk_int(pos, 0, ty_bool)))
	let kt = t[TY_KEY]
	let kv = key_out(rt_call(pos, cstr("rt_map_key"), args2(sym_ref_node(pos, m[LET_SYM]), sym_ref_node(pos, j)), ty_int), kt)
	if kt[TY_ENUM] != 0 {
		vec_push(lb, expr_stmt(call_fn(pos, say_enum_fn(kt, prefix), args1(kv), ty_void)))
	} else {
		vec_push(lb, expr_stmt(say_struct(kv, kt, prefix)))
	}
	vec_push(lb, expr_stmt(rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr(":"))), ty_void)))
	let vv = from_bits(rt_call(pos, cstr("rt_map_val"), args2(sym_ref_node(pos, m[LET_SYM]), sym_ref_node(pos, j)), ty_int), t[TY_ELEM])
	vec_push(lb, expr_stmt(say_arg(vv, prefix)))
	vec_push(wb[BLK_STMTS], live)
	vec_push(stmts, w)
	vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr("]"))), ty_void)))
	vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, cstr("argend"), cstr("")), vec_new(), ty_void)))
	return mk_seq(pos, stmts, mk_int(pos, 0, ty_int), ty_void)
}

// say_enum_slice prints [A B C] with each element through its enum's printer.
fn say_enum_slice(a i64, t i64, prefix i64) i64 {
	let pos = a[N_POS]
	let et = t[TY_ELEM]
	let stmts = vec_new()
	vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, cstr("argsep"), cstr("")), vec_new(), ty_void)))
	let sl = temp(pos, a, t)
	vec_push(stmts, sl)
	let n = temp(pos, mk_hdr(pos, sym_ref_node(pos, sl[LET_SYM]), 0), ty_int)
	vec_push(stmts, n)
	vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr("["))), ty_void)))
	let j = declare_local(pos, cstr("$"), ty_int)
	vec_push(stmts, let_stmt(pos, j, mk_int(pos, 0, ty_int)))
	let w = node_new(ST_WHILE, pos)
	w[WH_COND] = mk_bin(pos, cstr("<"), sym_ref_node(pos, j), sym_ref_node(pos, n[LET_SYM]), ty_bool)
	w[WH_POST] = assign_stmt(pos, sym_ref_node(pos, j), mk_bin(pos, cstr("+"), sym_ref_node(pos, j), mk_int(pos, 1, ty_int), ty_int))
	let wb = empty_block(pos)
	w[WH_BODY] = wb
	let sep = node_new(ST_IF, pos)
	sep[IF_COND] = mk_bin(pos, cstr(">"), sym_ref_node(pos, j), mk_int(pos, 0, ty_int), ty_bool)
	sep[IF_THEN] = empty_block(pos)
	vec_push(sep[IF_THEN][BLK_STMTS], expr_stmt(rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr(" "))), ty_void)))
	vec_push(wb[BLK_STMTS], sep)
	let el = mk_elem(pos, sym_ref_node(pos, sl[LET_SYM]), sym_ref_node(pos, j), et, 0)
	el[ELEM_SAFE] = 1
	vec_push(wb[BLK_STMTS], expr_stmt(call_fn(pos, say_enum_fn(et, prefix), args1(el), ty_void)))
	vec_push(stmts, w)
	vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr("]"))), ty_void)))
	vec_push(stmts, expr_stmt(rt_call(pos, str_cat3(prefix, cstr("argend"), cstr("")), vec_new(), ty_void)))
	return mk_seq(pos, stmts, mk_int(pos, 0, ty_int), ty_void)
}

fn say_enum_fn(t i64, prefix i64) i64 {
	if say_enum_keys == 0 {
		say_enum_keys = vec_new()
		say_enum_fns = vec_new()
	}
	mut i = 0
	for i < say_enum_keys[VEC_LEN] {
		let kp = vec_get(say_enum_keys, i)
		if vec_get(kp, 0) == t && streq(vec_get(kp, 1), prefix) != 0 {
			return vec_get(say_enum_fns, i)
		}
		i = i + 1
	}
	let names = vec_new()
	vec_push(names, cstr("x"))
	let types = vec_new()
	vec_push(types, t)
	let f = lifted_fn(cstr("say"), names, types, vec_new())
	let kp2 = vec_new()
	vec_push(kp2, t)
	vec_push(kp2, prefix)
	vec_push(say_enum_keys, kp2)
	vec_push(say_enum_fns, f)
	let saved_fn = ck_fn
	ck_fn = f
	let pos = 0
	let x = vec_get(f[F_LOCALS], 0)
	let body = f[F_BODY][BLK_STMTS]
	let vs = t[TY_ENUM]
	mut vi = 0
	for vi < vs[VEC_LEN] {
		let v = vec_get(vs, vi)
		let ifs = node_new(ST_IF, pos)
		ifs[IF_COND] = mk_bin(pos, cstr("=="), mk_mem(pos, sym_ref_node(pos, x), 0, 0, field_offset(t, 0), ty_int), mk_int(pos, vi, ty_int), ty_bool)
		ifs[IF_THEN] = empty_block(pos)
		let b = ifs[IF_THEN][BLK_STMTS]
		vec_push(b, expr_stmt(rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, vec_get(v, 0))), ty_void)))
		let nf = vec_get(v, 2)
		if nf > 0 {
			vec_push(b, expr_stmt(rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr("("))), ty_void)))
			mut k = 0
			for k < nf {
				if k > 0 {
					vec_push(b, expr_stmt(rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr(" "))), ty_void)))
				}
				let fi = vec_get(v, 1) + k
				let ft = field_type(t, fi)
				let fv = mk_mem(pos, sym_ref_node(pos, x), 0, 0, field_offset(t, fi), ft)
				if kind_of(ft) == K_STRUCT && ft[TY_ENUM] != 0 {
					vec_push(b, expr_stmt(call_fn(pos, say_enum_fn(ft, prefix), args1(fv), ty_void)))
				} else {
					vec_push(b, expr_stmt(say_arg(fv, prefix)))
				}
				k = k + 1
			}
			vec_push(b, expr_stmt(rt_call(pos, str_cat3(prefix, cstr("raw"), cstr("")), args1(lit_string(pos, cstr(")"))), ty_void)))
		}
		vec_push(body, ifs)
		vi = vi + 1
	}
	ck_fn = saved_fn
	return f
}

fn lit_string(pos i64, s i64) i64 {
	let n = node_new(EX_STR, pos)
	n[STR_PTR] = s
	n[STR_LEN] = strlen(s)
	n[N_TYPE] = ty_string
	return n
}

shared mut say_temps i64 // hidden locals say_hoist has made, for their names

// say_hoist evaluates the arguments from first on that are more than a literal or a name into
// hidden locals before the formatting frame opens: the frame is the core's, so a call that
// runs other tasks (anvil.Serve in say.Line) must not run while it is open (#347).
fn say_hoist(pos i64, args i64, first i64, stmts i64) i64 {
	mut i = first
	for i < args[VEC_LEN] {
		let a = vec_get(args, i)
		let k = a[N_KIND]
		if k != EX_INT && k != EX_STR && k != EX_IDENT && k != EX_FLOAT && k != EX_NIL {
			let t = default_type(chk(a, 0))
			let tk = kind_of(t)
			if tk != K_VOID && tk != K_TUPLE {
				if is_untyped(a[N_TYPE]) != 0 {
					reconvert(a, t)
				}
				// a name of its own: the lifetime checks tell hidden locals apart by name
				say_temps = say_temps + 1
				let nb = buf_new()
				buf_str(nb, cstr("$say"))
				buf_int(nb, say_temps)
				buf_byte(nb, 0)
				let s = declare_local(a[N_POS], nb[VEC_DATA], t)
				vec_push(stmts, let_stmt(a[N_POS], s, a))
				args[VEC_DATA][i] = sym_ref_node(a[N_POS], s)
			}
		}
		i = i + 1
	}
	return 0
}

// say_text formats args like say.Str (Line spacing when ln) and returns the str.
fn say_text(pos i64, args i64, ln i64) i64 {
	let stmts = vec_new()
	say_hoist(pos, args, 0, stmts)
	vec_push(stmts, expr_stmt(rt_call(pos, cstr("rt_fmt_begin_v"), args1(mk_int(pos, ln, ty_int)), ty_void)))
	mut i = 0
	for i < args[VEC_LEN] {
		vec_push(stmts, expr_stmt(say_arg(vec_get(args, i), cstr("rt_fmt_"))))
		i = i + 1
	}
	return mk_seq(pos, stmts, rt_call(pos, cstr("rt_fmt_end"), vec_new(), ty_string), ty_string)
}

// lower_say compiles say calls into typed runtime calls: begin, one call per argument,
// then end. No interfaces or reflection are needed.
//   say.Line(a...)        print, spaces between, newline
//   say.Text(a...)        print, Go's Print spacing
//   say.Out(f, a...)      printf
//   say.Fmt(f, a...) str  sprintf
//   say.Str(a...) str     sprint
//   say.Fault(f, a...)    a fault with a formatted message
//   say.To(w, f, a...)    printf into w.Write(str)
//   say.LineTo(w, a...)   println into w.Write(str)
// chk_interp turns "a {x} b {y:.2}" into say.Fmt("a %v b %.2f", x, y): the verb comes from
// the spec (its last letter), else %v, or %f for a float with a precision.
// is_query_t reports whether t is the runtime's query type.
fn is_query_t(t i64) i64 {
	return i64(t != 0 && t[TY_KIND] == K_STRUCT && t[TY_NAME] != 0 && streq(t[TY_NAME], cstr("query")) != 0)
}

fn tx_named(pos i64, name i64) i64 {
	let n = node_new(TX_NAME, pos)
	n[TX_B] = name
	return n
}

fn tx_slice_of(pos i64, name i64) i64 {
	let n = node_new(TX_SLICE, pos)
	n[TX_A] = tx_named(pos, name)
	return n
}

fn ident_node(pos i64, name i64) i64 {
	let n = node_new(EX_IDENT, pos)
	n[ID_NAME] = name
	return n
}

fn composite_of(tyx i64, elems i64, keys i64) i64 {
	let c = node_new(EX_COMPOSITE, tyx[N_POS])
	c[CL_TYPE] = tyx
	c[CL_ELEMS] = elems
	c[CL_KEYS] = keys
	return c
}

// query_arg wraps a checked value in the qarg variant for its type: integers become
// Int(i64(x)), floats Float(f64(x)), then Str, Bool and Bytes ([]u8).
fn query_arg(a i64, t i64) i64 {
	let pos = a[N_POS]
	mut variant = 0
	mut conv = 0
	if is_integer_t(t) != 0 {
		variant = cstr("Int")
		if t != ty_int {
			conv = cstr("i64")
		}
	} else if is_float_t(t) != 0 {
		variant = cstr("Float")
		if t != ty_float {
			conv = cstr("f64")
		}
	} else if kind_of(t) == K_STRING {
		variant = cstr("Str")
	} else if kind_of(t) == K_BOOL || kind_of(t) == K_UBOOL {
		variant = cstr("Bool")
	} else if kind_of(t) == K_SLICE && t[TY_ELEM] == ty_byte {
		variant = cstr("Bytes")
	} else {
		err_code_type(pos, cstr("E280 QUERY"), cstr("a query value must be an integer, a float, a str, a bool or []u8, not "), t, cstr(""))
		return 0
	}
	mut v = a
	if conv != 0 {
		v = node_new(EX_CALL, pos)
		v[CALL_NAME] = conv
		v[CALL_ARGS] = args1(a)
	}
	let sel = node_new(EX_SELECT, pos)
	sel[SEL_X] = ident_node(pos, cstr("qarg"))
	sel[SEL_NAME] = variant
	let call = node_new(EX_CALL, pos)
	call[CALL_CALLEE] = sel
	call[CALL_ARGS] = args1(v)
	return call
}

// chk_query turns a literal where a query is wanted into query{Parts, Args}: "GET user:{id}"
// keeps "GET user:" and "" as text and id as a value, so a value is never parsed as text.
fn chk_query(e i64, want i64) i64 {
	let pos = e[N_POS]
	mut parts = vec_new()
	let args = vec_new()
	mut hidden = 0
	if e[N_KIND] == EX_STR {
		let s = node_new(EX_STR, pos)
		s[STR_PTR] = e[STR_PTR]
		s[STR_LEN] = e[STR_LEN]
		vec_push(parts, s)
	} else {
		parts = e[INTERP_PARTS]
		let vals = e[INTERP_ARGS]
		let specs = e[INTERP_SPECS]
		mut i = 0
		for i < vals[VEC_LEN] {
			if vec_get(specs, i) != 0 {
				err_code_at(pos, cstr("E280 QUERY"), cstr("a query value takes no format spec: it is sent as it is"))
			}
			let a = vec_get(vals, i)
			mut at = chk(a, 0)
			if is_secret(at) != 0 {
				// Sent as itself; a replay key holds its handle instead (query.Hidden, #241).
				hidden = hidden | secret_query_arg(a, at, args[VEC_LEN])
				at = plain_type(at)
				a[N_TYPE] = at
			}
			let qa = query_arg(a, at)
			if qa != 0 {
				vec_push(args, qa)
			}
			i = i + 1
		}
	}
	let nokeys = vec_new()
	mut i = 0
	for i < parts[VEC_LEN] {
		vec_push(nokeys, 0)
		i = i + 1
	}
	let akeys = vec_new()
	i = 0
	for i < args[VEC_LEN] {
		vec_push(akeys, 0)
		i = i + 1
	}
	let elems = vec_new()
	vec_push(elems, composite_of(tx_slice_of(pos, cstr("str")), parts, nokeys))
	vec_push(elems, composite_of(tx_slice_of(pos, cstr("qarg")), args, akeys))
	let keys = vec_new()
	vec_push(keys, ident_node(pos, cstr("Parts")))
	vec_push(keys, ident_node(pos, cstr("Args")))
	if hidden != 0 {
		vec_push(elems, mk_int(pos, hidden, ty_u64))
		vec_push(keys, ident_node(pos, cstr("Hidden")))
	}
	let c = composite_of(tx_named(pos, cstr("query")), elems, keys)
	replace_node(e, c)
	e[N_TYPE] = 0
	return chk_kind(e, want)
}

// interp_name_known reports whether a name inside {...} in a string resolves: chk_ident
// would not report it undefined.
fn interp_name_known(name i64) i64 {
	return i64(streq(name, cstr("true")) != 0 || streq(name, cstr("false")) != 0 || lookup_name(name) != 0 || import_pkg(name) != 0)
}

fn chk_interp(e i64, want i64) i64 {
	let pos = e[N_POS]
	let parts = e[INTERP_PARTS]
	let vals = e[INTERP_ARGS]
	let specs = e[INTERP_SPECS]
	let f = buf_new()
	let args = vec_new()
	vec_push(args, 0)
	mut i = 0
	for i < parts[VEC_LEN] {
		let part = vec_get(parts, i)
		mut k = 0
		for k < part[STR_LEN] {
			let c = i64(load8(part[STR_PTR] + k))
			if c == '%' {
				buf_byte(f, '%')
			}
			buf_byte(f, c)
			k = k + 1
		}
		if i < vals[VEC_LEN] {
			let a = vec_get(vals, i)
			if a[N_KIND] == EX_IDENT && interp_name_known(a[ID_NAME]) == 0 {
				// Often meant as literal text, like a route pattern's {id}.
				let u = err_code(a[N_POS], cstr("E103 UNDEFINED"))
				buf_str(u, cstr("undefined: "))
				buf_str(u, a[ID_NAME])
				buf_str(u, cstr(" (in a string, {{"))
				buf_str(u, a[ID_NAME])
				buf_str(u, cstr("}} is a value: write {{{{ for a brace, or use a `raw` string)"))
				err_end(u)
				replace_node(a, mk_int(a[N_POS], 0, 0))
			}
			let t = chk(a, 0)
			let spec = vec_get(specs, i)
			buf_byte(f, '%')
			if spec == 0 {
				buf_byte(f, 'v')
			} else {
				buf_str(f, spec)
				let sl = strlen(spec)
				mut last = 0
				if sl > 0 {
					last = i64(load8(spec + sl - 1))
				}
				if !((last >= 'a' && last <= 'z') || (last >= 'A' && last <= 'Z')) {
					mut dot = 0
					mut q = 0
					for q < sl {
						if i64(load8(spec + q)) == '.' {
							dot = 1
						}
						q = q + 1
					}
					if dot != 0 && is_float_t(t) != 0 {
						buf_byte(f, 'f')
					} else {
						buf_byte(f, 'v')
					}
				}
			}
			vec_push(args, a)
		}
		i = i + 1
	}
	let fs = node_new(EX_STR, pos)
	fs[STR_LEN] = f[VEC_LEN]
	buf_byte(f, 0)
	fs[STR_PTR] = f[VEC_DATA]
	args[VEC_DATA][0] = fs
	let call = node_new(EX_CALL, pos)
	call[CALL_ARGS] = args
	replace_node(e, call)
	e[N_TYPE] = 0
	return secret_interp_result(e, args, want)
}

fn lower_say(e i64, m i64, want i64) i64 {
	let pos = e[N_POS]
	let args = e[CALL_ARGS]
	mut first = 0
	mut writer = 0
	if streq(m, cstr("To")) != 0 || streq(m, cstr("LineTo")) != 0 {
		writer = arg0(e)
		first = 1
	}
	let printf = i64(streq(m, cstr("Out")) != 0 || streq(m, cstr("Fmt")) != 0 || streq(m, cstr("Fault")) != 0 || streq(m, cstr("To")) != 0)
	let ln = i64(streq(m, cstr("Line")) != 0 || streq(m, cstr("LineTo")) != 0)
	let stmts = vec_new()
	secret_say_args(args, m)
	if printf != 0 {
		say_hoist(pos, args, first + 1, stmts)
	} else {
		say_hoist(pos, args, first, stmts)
	}
	if printf != 0 {
		if args[VEC_LEN] <= first {
			err_code_at(pos, cstr("E282 FORMAT"), cstr("missing format"))
			return ty_void
		}
		let f = vec_get(args, first)
		let ft = chk(f, ty_string)
		if kind_of(ft) != K_STRING {
			err_code_at(f[N_POS], cstr("E282 FORMAT"), cstr("format must be a str"))
		}
		vec_push(stmts, expr_stmt(rt_call(pos, cstr("rt_fmt_begin"), args1(f), ty_void)))
		first = first + 1
	} else {
		vec_push(stmts, expr_stmt(rt_call(pos, cstr("rt_fmt_begin_v"), args1(mk_int(pos, ln, ty_int)), ty_void)))
	}
	mut i = first
	for i < args[VEC_LEN] {
		vec_push(stmts, expr_stmt(say_arg(vec_get(args, i), cstr("rt_fmt_"))))
		i = i + 1
	}
	mut tail = 0
	mut t = ty_void
	if writer != 0 {
		let ws = node_new(EX_SELECT, pos)
		ws[SEL_X] = writer
		ws[SEL_NAME] = cstr("Write")
		tail = node_new(EX_CALL, pos)
		tail[CALL_CALLEE] = ws
		tail[CALL_ARGS] = args1(rt_call(pos, cstr("rt_fmt_end"), vec_new(), ty_string))
		chk(tail, 0)
		tail[N_TYPE] = ty_void
	} else if streq(m, cstr("Fmt")) != 0 || streq(m, cstr("Str")) != 0 {
		tail = rt_call(pos, cstr("rt_fmt_end"), vec_new(), ty_string)
		t = ty_string
	} else if streq(m, cstr("Fault")) != 0 {
		tail = rt_call(pos, cstr("rt_fmt_err"), vec_new(), ty_error)
		t = ty_error
	} else {
		tail = rt_call(pos, cstr("rt_fmt_out"), vec_new(), ty_void)
	}
	replace_node(e, mk_seq(pos, stmts, tail, t))
	e[N_TYPE] = 0
	return t
}

fn arity_error(e i64, want i64) {
	let a = err_code(e[N_POS], cstr("E210 ARG_COUNT"))
	buf_str(a, e[CALL_NAME])
	buf_str(a, cstr(" expects "))
	buf_int(a, want)
	buf_str(a, cstr(" arguments, got "))
	buf_int(a, e[CALL_ARGS][VEC_LEN])
	err_end(a)
}

// ---- bound(x) !T (#240) ----
//
// bound(x) checks x against the bounded type its destination has (let v str max 100 = try
// bound(x), an assignment or a return): a generated bound$N(x) gives x as that type, or
// fails with fault.LimitExceeded when x is longer than the bound.
fn chk_bound(e i64, want i64) i64 {
	let pos = e[N_POS]
	mut target = bound_want
	bound_want = 0
	if (target == 0 || target[TY_BOUND] == 0) && want != 0 && want[TY_BOUND] != 0 {
		target = want
	}
	if e[CALL_ARGS][VEC_LEN] != 1 {
		err_code_at(pos, cstr("E252 BOUND_CALL"), cstr("bound takes one value"))
		return ty_error
	}
	if target == 0 || target[TY_BOUND] == 0 {
		err_code_at(pos, cstr("E252 BOUND_CALL"), cstr("bound needs a bounded destination to check against: write its type (let v str max 100 = try bound(x))"))
		return ty_error
	}
	let plain = target[TY_BOUND]
	let x = arg0(e)
	mut xt = chk(x, plain)
	// q.Body() into a bounded type checks the body's length before copying it: the call
	// becomes q.BodyBound(n), which gives the body or fault.LimitExceeded (#240).
	if kind_of(plain) == K_STRING && x[N_KIND] == EX_CALL && x[CALL_NAME] != 0 && streq(x[CALL_NAME], cstr("anvil.Req.Body")) != 0 {
		let bb = find_fn(cstr("anvil.Req.BodyBound"))
		if bb != 0 {
			e[CALL_NAME] = bb[F_QNAME]
			e[CALL_FN] = bb
			e[CALL_METHOD] = 1
			e[CALL_ARGS] = args2(arg0(x), mk_int(pos, target[TY_MAX], ty_int))
			let brts = vec_new()
			vec_push(brts, target)
			vec_push(brts, ty_error)
			e[N_TYPE] = tuple_of(brts)
			return e[N_TYPE]
		}
	}
	if is_untyped(xt) != 0 {
		reconvert(x, plain)
		xt = plain
	}
	if assignable(xt, plain) == 0 {
		err_code_types(pos, cstr("E252 BOUND_CALL"), cstr("bound cannot check "), xt, cstr(" against "), target)
		return ty_error
	}
	let w = bound_wrapper(pos, target)
	e[CALL_NAME] = w[F_NAME]
	e[CALL_FN] = w
	let rts = vec_new()
	vec_push(rts, target)
	vec_push(rts, ty_error)
	let rt = tuple_of(rts)
	e[N_TYPE] = rt
	return rt
}

// bound_wrapper builds bound$N(x T) (T max n, fault): x itself, or fault.LimitExceeded.
fn bound_wrapper(pos i64, target i64) i64 {
	lifted_count = lifted_count + 1
	let f = fn_new(pos, cstr("bound"))
	let nb = buf_new()
	buf_str(nb, cstr("bound$"))
	buf_int(nb, lifted_count)
	buf_byte(nb, 0)
	f[F_QNAME] = nb[VEC_DATA]
	f[F_NAME] = nb[VEC_DATA]
	f[F_LIFTED] = 2
	f[F_FILE] = ck_file
	let plain = target[TY_BOUND]
	vec_push(f[F_PARAMS], cstr("x"))
	vec_push(f[F_PTYPES], plain)
	vec_push(f[F_RTYPES], target)
	vec_push(f[F_RTYPES], ty_error)
	f[F_TYPE] = func_of(f[F_PTYPES], f[F_RTYPES], 0)
	f[F_LOCALS] = vec_new()
	f[F_BODY] = empty_block(pos)
	vec_push(prog_fns, f)
	let saved_fn = ck_fn
	ck_fn = f
	let xs = sym_new(SYM_LOCAL, cstr("x"), pos)
	xs[S_TYPE] = plain
	xs[S_SLOT] = 0
	vec_push(f[F_LOCALS], xs)
	f[F_SLOTS] = 1
	let body = f[F_BODY][BLK_STMTS]
	let over = node_new(ST_IF, pos)
	let n = mk_hdr(pos, sym_ref_node(pos, xs), 0)
	over[IF_COND] = mk_bin(pos, cstr(">"), n, mk_int(pos, target[TY_MAX], ty_int), ty_bool)
	over[IF_THEN] = empty_block(pos)
	let ob = over[IF_THEN][BLK_STMTS]
	let fx = rt_call(pos, cstr("rt_fault_over"), args2(mk_hdr(pos, sym_ref_node(pos, xs), 0), mk_int(pos, target[TY_MAX], ty_int)), ty_error)
	vec_push(ob, fault_return(pos, ob, fx))
	vec_push(body, over)
	let ret = node_new(ST_RETURN, pos)
	let v = sym_ref_node(pos, xs)
	v[N_TYPE] = target
	ret[RET_VALUES] = args2(v, mk_int(pos, 0, ty_error))
	vec_push(body, ret)
	ck_fn = saved_fn
	return f
}
