// cstr is the address of a string literal's bytes: the untyped C-string word the compiler's records hold.
fn cstr(s str) i64 {
	return cast(i64, s) + 8
}

// streq reports whether two C strings are equal (1 or 0).
fn streq(a i64, b i64) i64 {
	mut i = 0
	for i64(load8(a + i)) == i64(load8(b + i)) {
		if i64(load8(a + i)) == 0 {
			return 1
		}
		i = i + 1
	}
	return 0
}

// Data structures for the self-hosted compiler: word vectors, byte buffers, positions, errors.
// Vectors and buffers share one header layout; vectors count words, buffers count bytes.

fn vec_new[T Any]() Vec[T] {
	let v = cast(Vec[T], malloc(24))
	v.len = 0
	v.cap = 8
	v.data = malloc(64)
	return v
}

fn vec_push[T Any](v Vec[T], x T) {
	if v.len == v.cap {
		v.cap = v.cap * 2
		v.data = realloc(v.data, v.cap * 8)
	}
	let d = v.data
	d[v.len] = cast(i64, x)
	v.len = v.len + 1
}

fn vec_get[T Any](v Vec[T], i i64) T {
	let d = v.data
	return cast(T, d[i])
}

fn vec_filled[T Any](n i64, x T) Vec[T] {
	let v = vec_new[T]()
	mut i = 0
	for i < n {
		vec_push(v, x)
		i = i + 1
	}
	return v
}

fn vec_clone[T Any](v Vec[T]) Vec[T] {
	let out = vec_new[T]()
	if cast(i64, v) == 0 {
		return out
	}
	mut i = 0
	for i < v.len {
		vec_push(out, vec_get(v, i))
		i = i + 1
	}
	return out
}

fn buf_new() Buf {
	let b = cast(Vec[i64], malloc(24))
	b.len = 0
	b.cap = 256
	b.data = malloc(256)
	return cast(Buf, b)
}

fn buf_reserve(b Buf, n i64) {
	for b.len + n > b.cap {
		b.cap = b.cap * 2
		b.data = realloc(b.data, b.cap)
	}
}

fn buf_byte(b Buf, c i64) {
	buf_reserve(b, 1)
	store8(b.data + b.len, c)
	b.len = b.len + 1
}

fn buf_bytes(b Buf, s i64, n i64) {
	buf_reserve(b, n)
	memcpy(b.data + b.len, s, n)
	b.len = b.len + n
}

fn buf_str(b Buf, s i64) {
	buf_bytes(b, s, strlen(s))
}

fn buf_int(b Buf, n i64) {
	if n < 0 {
		buf_byte(b, '-')
		if n / 10 != 0 {
			buf_int(b, -(n / 10))
		}
		buf_byte(b, '0' - n % 10)
		return
	}
	if n >= 10 {
		buf_int(b, n / 10)
	}
	buf_byte(b, '0' + n % 10)
}

// str_slice copies n bytes into a new NUL-terminated string.
fn str_slice(s i64, n i64) i64 {
	let r = malloc(n + 1)
	mut i = 0
	for i < n {
		store8(r + i, i64(load8(s + i)))
		i = i + 1
	}
	store8(r + n, 0)
	return r
}

fn mem_eq(a i64, b i64, n i64) i64 {
	mut i = 0
	for i < n {
		if i64(load8(a + i)) != i64(load8(b + i)) {
			return 0
		}
		i = i + 1
	}
	return 1
}

fn write_all(fd i64, b Vec[i64]) {
	mut done = 0
	for done < b.len {
		let n = rt_sys_write(fd, b.data + done, b.len - done)
		if n <= 0 {
			rt_sys_exit(1)
		}
		done = done + n
	}
}

// A position packs file index, line and column into one word.
const NO_POS = -1

shared mut files Vec[i64]
shared mut tgt_linux i64 // the target OS is Linux (else macOS)
shared mut tgt_x64 i64 // the target CPU is x86-64 (else arm64)
shared mut error_count i64

fn pos_make(file i64, line i64, col i64) i64 {
	return (file << 48) | (line << 16) | col
}

fn buf_pos(b Buf, pos i64) {
	buf_str(b, vec_get(files, pos >> 48))
	buf_byte(b, ':')
	buf_int(b, (pos >> 16) & 0xffffffff)
	buf_byte(b, ':')
	buf_int(b, pos & 0xffff)
}

fn err_end(b Buf) {
	buf_byte(b, '\n')
	write_all(2, cast(Vec[i64], b))
	error_count = error_count + 1
}

fn fatal(b Vec[i64]) {
	err_end(cast(Buf, b))
	rt_sys_exit(1)
}

// err_code starts an error with its code and name from docs/ERRORS.md, such as
// "E502 TYPE_ARG_COUNT"; finish it with err_end (keep going) or fatal (stop).
fn err_code(pos i64, code i64) Buf {
	let b = buf_new()
	if pos != NO_POS {
		buf_pos(b, pos)
		buf_str(b, cstr(": "))
	}
	buf_str(b, cstr("error "))
	buf_str(b, code)
	buf_str(b, cstr(": "))
	return cast(Buf, b)
}

// err_code_at reports a coded error whose whole message is MSG.
fn err_code_at(pos i64, code i64, msg i64) {
	let e = err_code(pos, code)
	buf_str(e, msg)
	err_end(cast(Buf, e))
}

// err_code_quoted reports a coded PREFIX 'NAME' SUFFIX.
fn err_code_quoted(pos i64, code i64, prefix i64, name i64, suffix i64) {
	let e = err_code(pos, code)
	buf_str(e, prefix)
	buf_byte(e, '\'')
	buf_str(e, name)
	buf_byte(e, '\'')
	buf_str(e, suffix)
	err_end(cast(Buf, e))
}

// Little- and big-endian stores into a byte array.
fn put32(p i64, v i64) {
	store8(p, v)
	store8(p + 1, v >> 8)
	store8(p + 2, v >> 16)
	store8(p + 3, v >> 24)
}

fn put64(p i64, v i64) {
	put32(p, v)
	put32(p + 4, v >> 32)
}

fn load32(p i64) i64 {
	return i64(load8(p)) | (i64(load8(p + 1)) << 8) | (i64(load8(p + 2)) << 16) | (i64(load8(p + 3)) << 24)
}

fn put32be(p i64, v i64) {
	store8(p, v >> 24)
	store8(p + 1, v >> 16)
	store8(p + 2, v >> 8)
	store8(p + 3, v)
}

fn put64be(p i64, v i64) {
	put32be(p, v >> 32)
	put32be(p + 4, v)
}

fn align_up(n i64, a i64) i64 {
	return (n + a - 1) & ~(a - 1)
}
