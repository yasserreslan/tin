// Checker: resolves names across packages, infers and checks types, evaluates constants,
// and lowers Go-level constructs (strings, slices, maps, structs, range, switch,
// multiple assignment, fmt) into the core AST that the optimizer and backend handle.
const SYM_LOCAL = 0
const SYM_GLOBAL = 1
const SYM_CONST = 2
const SYM_FUNC = 3

// Symbol layout.
const S_REGION = 18
const S_SCOPE_AT = 30 // how many scope blocks enclose its declaration (#232): task handles stay inside theirs

const MAX_PARAMS = 8

shared mut globals Vec[Sym]
shared mut sc_syms Vec[Sym]
shared mut sc_marks Vec[i64]
shared mut ck_fn Fn
shared mut ck_loops i64
shared mut ck_breaks i64 // loops plus switches
shared mut ck_labels Vec[i64] // the label of each enclosing loop of this function (0: none)
shared mut ck_file i64
shared mut ck_pkg i64
shared mut init_stmts Vec[i64] // global initializers run by __start
shared mut lifted_count i64
shared mut start_fn i64
shared mut core_fn Fn // __core_init: per-core global initializers, run on every core
shared mut core_stmts Vec[i64]
shared mut tls_count i64
shared mut ck_trusted i64 // the file is part of the standard library
shared mut file_trusted Vec[i64]
shared mut safe_pairs Vec[i64] // [index sym, slice sym] proven in range in the current loop body
shared mut len_aliases Vec[i64] // [local length sym, slice/string sym] for unchanged len locals
shared mut dyn_tables Vec[i64] // [concrete type, dyn type, keep function, methods, data slot index]
shared mut ck_escaping_cells Vec[i64] // variable names that must be allocated in heap cells

fn sym_new(kind i64, name i64, pos i64) Sym {
	let s = cast(Sym, calloc(31, 8))
	s.kind = kind
	s.name = name
	s.pos = pos
	return cast(Sym, s)
}

fn intrinsic_arity(name i64) i64 {
	if streq(name, cstr("load8")) != 0 || streq(name, cstr("__set_ctx")) != 0 || streq(name, cstr("__atomic_load")) != 0 {
		return 1
	}
	if streq(name, cstr("store8")) != 0 || streq(name, cstr("__atomic_add")) != 0 || streq(name, cstr("__atomic_swap")) != 0 || streq(name, cstr("__atomic_store")) != 0 {
		return 2
	}
	if streq(name, cstr("__atomic_cas")) != 0 || streq(name, cstr("__st")) != 0 {
		return 3
	}
	if streq(name, cstr("__ld")) != 0 {
		return 2
	}
	if streq(name, cstr("__ctx")) != 0 || streq(name, cstr("__yield")) != 0 || streq(name, cstr("__empty")) != 0 || streq(name, cstr("__fp")) != 0 || streq(name, cstr("__tin_symbols")) != 0 || streq(name, cstr("__image_base")) != 0 {
		return 0
	}
	return -1
}

// err_code_type and err_code_types report a coded error naming one or two types (docs/ERRORS.md).
fn err_code_type(pos i64, code i64, prefix i64, t i64, suffix i64) {
	let e = err_code(pos, code)
	buf_str(e, prefix)
	type_name(cast(Buf, e), cast(Ty, t))
	buf_str(e, suffix)
	err_end(cast(Buf, e))
}

fn err_code_types(pos i64, code i64, prefix i64, a i64, mid i64, b i64) {
	let e = err_code(pos, code)
	buf_str(e, prefix)
	type_name(cast(Buf, e), cast(Ty, a))
	buf_str(e, mid)
	type_name(cast(Buf, e), cast(Ty, b))
	err_end(cast(Buf, e))
}

fn str_cat3(a i64, b i64, c i64) i64 {
	let s = buf_new()
	buf_str(s, a)
	buf_str(s, b)
	buf_str(s, c)
	buf_byte(s, 0)
	return s.data
}

// qual is the symbol name of a top-level name declared in package pkg.
fn qual(pkg i64, name i64) i64 {
	if i64(load8(pkg)) == 0 {
		return name
	}
	return str_cat3(pkg, cstr("."), name)
}

// The global names are indexed by an open-addressing table (power-of-two size, at most half
// full) so that a lookup costs one hash and about one string compare instead of a scan of
// every global: the checker resolves a name for almost every expression it visits.
shared mut gtab i64 // slots hold the Sym, 0 when free
shared mut gtab_size i64
shared mut gtab_used i64

fn name_hash(s i64) i64 {
	mut h = 1469598103934665603
	mut i = 0
	for {
		let c = i64(load8(s + i))
		if c == 0 {
			break
		}
		h = (h ^ c) * 1099511628211
		i = i + 1
	}
	return h ^ (h >> 29)
}

fn gtab_slot(name i64) i64 {
	mut i = name_hash(name) & (gtab_size - 1)
	for gtab[i] != 0 {
		if streq(cast(Sym, gtab[i]).name, name) != 0 {
			return i
		}
		i = (i + 1) & (gtab_size - 1)
	}
	return i
}

fn gtab_add(s i64) {
	if gtab_size == 0 || (gtab_used + 1) * 2 > gtab_size {
		let old = gtab
		let old_size = gtab_size
		gtab_size = 1024
		if old_size * 2 > gtab_size {
			gtab_size = old_size * 2
		}
		gtab = calloc(gtab_size, 8)
		gtab_used = 0
		mut j = 0
		for j < old_size {
			if old[j] != 0 {
				gtab_add(old[j])
			}
			j = j + 1
		}
		if old != 0 {
			free(old)
		}
	}
	let i = gtab_slot(cast(Sym, s).name)
	gtab[i] = s
	gtab_used = gtab_used + 1
}

fn lookup_global(name i64) Sym {
	if gtab_size == 0 {
		return cast(Sym, 0)
	}
	return cast(Sym, gtab[gtab_slot(name)])
}

fn find_fn(name i64) Fn {
	let s = lookup_global(name)
	if cast(i64, s) != 0 && s.kind == SYM_FUNC {
		return cast(Fn, s.fn_)
	}
	return cast(Fn, 0)
}

fn declare_global(s Sym) {
	if intrinsic_arity(s.name) >= 0 {
		err_code_quoted(s.pos, cstr("E102 BUILTIN_NAME"), cstr(""), s.name, cstr(" is a builtin and cannot be redeclared"))
		return
	}
	let prev = lookup_global(s.name)
	if cast(i64, prev) != 0 {
		let e = err_code(s.pos, cstr("E101 REDECLARED"))
		buf_byte(e, '\'')
		buf_str(e, s.name)
		buf_str(e, cstr("' redeclared (previous declaration at "))
		buf_pos(e, prev.pos)
		buf_byte(e, ')')
		err_end(cast(Buf, e))
		return
	}
	vec_push(globals, cast(Sym, s))
	gtab_add(cast(i64, s))
}

fn set_file(f i64) {
	ck_file = f
	ck_pkg = vec_get(file_pkgs, f)
	ck_trusted = vec_get(file_trusted, f)
}

// import_pkg returns the package name an alias in the current file refers to, or 0.
fn import_pkg(alias i64) i64 {
	let imps = cast(Vec[i64], vec_get(file_imports, ck_file))
	mut i = 0
	for i < imps.len {
		let rec = cast(Vec[i64], vec_get(imps, i))
		if streq(vec_get(rec, 0), alias) != 0 {
			return path_pkg(vec_get(rec, 1))
		}
		i = i + 1
	}
	return 0
}

// path_pkg is the package an import path names: its last element.
fn path_pkg(path i64) i64 {
	mut name = path
	mut j = 0
	for i64(load8(path + j)) != 0 {
		if i64(load8(path + j)) == '/' {
			name = path + j + 1
		}
		j = j + 1
	}
	return name
}

// ---- types ----
fn resolve_type(tx i64) i64 {
	if tx == 0 {
		return ty_int
	}
	if cast(Ty, tx).kind < 40 && cast(Node, tx).kind == 0 {
		return tx
	}
	let k = cast(Node, tx).kind
	if k == TX_NAME && cast(i64, cast(TypeExpr, tx).args) != 0 {
		return generic_type_ref(tx)
	}
	if k == TX_NAME && cast(i64, cast(TypeExpr, tx).a) == 0 {
		let bound = tbind_lookup(cast(i64, cast(TypeExpr, tx).b))
		if bound != 0 {
			return bound
		}
	}
	if k == TX_NAME {
		mut t = 0
		if cast(i64, cast(TypeExpr, tx).a) != 0 {
			let pkg = import_pkg(cast(i64, cast(TypeExpr, tx).a))
			if pkg == 0 {
				err_code_quoted(cast(Node, tx).pos, cstr("E103 UNDEFINED"), cstr("undefined package "), cast(i64, cast(TypeExpr, tx).a), cstr(""))
				return ty_int
			}
			t = find_type(str_cat3(pkg, cstr("."), cast(i64, cast(TypeExpr, tx).b)))
			if t != 0 && is_private(cast(i64, cast(TypeExpr, tx).b)) != 0 {
				private_use(cast(Node, tx).pos, cstr("type"), cast(i64, cast(TypeExpr, tx).b), pkg)
			}
		} else {
			if i64(load8(ck_pkg)) != 0 {
				t = find_type(qual(ck_pkg, cast(i64, cast(TypeExpr, tx).b)))
			}
			if t == 0 {
				t = find_type(cast(i64, cast(TypeExpr, tx).b))
			}
		}
		if t == 0 {
			err_code_quoted(cast(Node, tx).pos, cstr("E103 UNDEFINED"), cstr("undefined type "), cast(i64, cast(TypeExpr, tx).b), cstr(""))
			return ty_int
		}
		return t
	}
	if (k == TX_SLICE || k == TX_ARRAY || k == TX_MAP) && bounded_elem(cast(Node, tx)) != 0 {
		return bounded_type(bounded_elem(cast(Node, tx)))
	}
	if k == TX_SLICE || k == TX_ARRAY {
		let et = resolve_type(tx[TX_A + i64((k == TX_ARRAY))])
		if k == TX_ARRAY && kind_of(cast(Ty, et)) == K_DYN {
			let e = err_code(cast(Node, tx).pos, cstr("E203 NO_ZERO_VALUE"))
			buf_str(e, cstr("an array of "))
			type_name(cast(Buf, e), cast(Ty, et))
			buf_str(e, cstr(" has no zero element: use []dyn and append"))
			err_end(cast(Buf, e))
		}
		return slice_of(et)
	}
	if k == TX_MAP {
		let mkt = resolve_type(cast(i64, cast(TypeExpr, tx).a))
		secret_map_key(cast(Node, tx).pos, mkt)
		if key_valid(cast(Ty, mkt), cast(Vec[Ty], vec_new[i64]())) == 0 {
			err_code_type(cast(Node, tx).pos, cstr("E201 MAP_KEY"), cstr("a map key must compare by value (str, numbers, bool, or structs and enums of those), not "), mkt, cstr(""))
		}
		let mvt = resolve_type(cast(i64, cast(TypeExpr, tx).b))
		if is_dyn_value(cast(Ty, mvt)) != 0 {
			err_code_at(cast(Node, tx).pos, cstr("E530 DYN_NOT_YET"), cstr("a map value of type dyn is the next step: the map stores 16-byte slots with the table (#141)"))
		}
		return map_of(mkt, mvt)
	}
	if k == TX_PTR {
		return resolve_type(cast(i64, cast(TypeExpr, tx).a))
	}
	if k == TX_OPT {
		let inner = resolve_type(cast(i64, cast(TypeExpr, tx).a))
		let ik = kind_of(cast(Ty, inner))
		if ik != K_STRUCT && ik != K_DYN && ik != K_STRING && ik != K_SLICE && ik != K_MAP {
			err_code_type(cast(Node, tx).pos, cstr("E420 OPTIONAL_TYPE"), cstr("only references (str, slices, maps, structs, dyn) can be optional, not "), inner, cstr(""))
			return inner
		}
		return opt_of(inner)
	}
	if k == TX_MAX {
		return bounded_type(tx)
	}
	if k == TX_CHAN {
		return chan_of(resolve_type(cast(i64, cast(TypeExpr, tx).a)))
	}
	if k == TX_FUNC {
		return func_of_m(resolve_types(cast(Vec[i64], cast(TypeExpr, tx).a)), resolve_types(cast(Vec[i64], cast(TypeExpr, tx).b)), 0, cast(i64, cast(TypeExpr, tx).args))
	}
	if k == TX_STRUCT {
		let st = ty_new(K_STRUCT, cstr("struct"))
		resolve_fields(cast(Ty, st), cast(TypeExpr, tx))
		layout_struct(cast(Ty, st))
		return st
	}
	if k == TX_DYN {
		let inst = shape_inst(cast(i64, cast(TypeExpr, tx).a))
		if cast(i64, inst) == 0 {
			if cast(i64, shape_ref_name(cast(TypeExpr, cast(TypeExpr, tx).a))) == 0 {
				// Not a shape (an undefined name, a type, a package member): never typed
				// as an ordinary type.
				let e = err_code(cast(Node, cast(TypeExpr, tx).a).pos, cstr("E522 NOT_A_SHAPE"))
				buf_str(e, cstr("dyn needs a shape"))
				if cast(Node, cast(TypeExpr, tx).a).kind == TX_NAME {
					buf_str(e, cstr(", not "))
					if cast(i64, cast(TypeExpr, cast(TypeExpr, tx).a).a) != 0 {
						buf_str(e, cast(i64, cast(TypeExpr, cast(TypeExpr, tx).a).a))
						buf_byte(e, '.')
					}
					buf_str(e, cast(i64, cast(TypeExpr, cast(TypeExpr, tx).a).b))
				}
				err_end(cast(Buf, e))
			}
			return ty_int
		}
		if saw_dyn == 0 {
			saw_dyn_pos = cast(Node, tx).pos
		}
		return dyn_of(vec_get(inst, 0), cast(Vec[i64], vec_get(inst, 1)))
	}
	if k == TX_SECRET {
		return secret_type(tx)
	}
	err_code_at(cast(Node, tx).pos, cstr("E990 INTERNAL"), cstr("invalid type"))
	return ty_int
}

fn resolve_types(v Vec[i64]) Vec[i64] {
	let r = vec_new[i64]()
	mut i = 0
	for i < v.len {
		vec_push(r, resolve_type(vec_get(v, i)))
		i = i + 1
	}
	return cast(Vec[i64], r)
}

// ---- bounded types (#240) ----
// bounded_type resolves T max N: N is a constant length, T a str, slice or map.
fn bounded_type(tx i64) i64 {
	let t = cast(Ty, resolve_type(cast(i64, cast(TypeExpr, tx).a)))
	let k = kind_of(t)
	if k != K_STRING && k != K_SLICE && k != K_MAP {
		err_code_type(cast(Node, tx).pos, cstr("E250 BOUND_TYPE"), cstr("max bounds the length of a str, a slice or a map, not "), cast(i64, t), cstr(""))
		return cast(i64, t)
	}
	let x = cast(Node, cast(TypeExpr, tx).b)
	if x.kind == EX_UNIT {
		chk_unit(cast(i64, x), ty_int)
	}
	let n = const_value(cast(i64, x), 0)
	if n < 0 {
		err_code_at(x.pos, cstr("E250 BOUND_TYPE"), cstr("a bound must not be negative"))
		return cast(i64, t)
	}
	if t.secret_ != 0 {
		// secret T max n: the bound goes inside, so the value stays secret.
		return secret_of(cast(Ty, bounded_of(t.secret_, n)))
	}
	return bounded_of(cast(i64, t), n)
}

// bounded_elem reads []T max n and map[K]V max n, whose max the parser gave the element, as
// the bounded slice or map (design_syntax: Type "max" Expr); 0 when the element has none.
// A slice of bounded values is written with a named element type ([]Name).
fn bounded_elem(tx Node) i64 {
	mut ei = TX_B
	if tx.kind == TX_SLICE {
		ei = TX_A
	}
	let el = cast(i64, tx)[ei]
	if el == 0 || cast(Node, el).kind != TX_MAX {
		return 0
	}
	let inner = node_new(tx.kind, tx.pos)
	replace_node(inner, cast(i64, tx))
	inner[ei] = cast(i64, cast(TypeExpr, el).a)
	let outer = cast(TypeExpr, node_new(TX_MAX, tx.pos))
	outer.a = cast(i64, cast(Vec[i64], inner))
	outer.b = cast(TypeExpr, el).b
	return cast(i64, outer)
}

// bounded_value handles a value for a bounded type: a str literal within the bound fits;
// an unbounded value of the same type is reported (reports whether it handled e).
fn bounded_value(e i64, from Ty, to Ty) i64 {
	if cast(i64, to) == 0 || to.bound == 0 || (cast(i64, from) != 0 && from.bound != 0) {
		return 0
	}
	if cast(Node, e).kind == EX_STR && kind_of(to) == K_STRING {
		if cast(StrLit, e).len > to.max {
			let m = err_code(cast(Node, e).pos, cstr("E251 UNCHECKED_BOUND"))
			buf_str(m, cstr("this str is "))
			buf_int(m, cast(StrLit, e).len)
			buf_str(m, cstr(" bytes long, over the bound of "))
			type_name(cast(Buf, m), to)
			err_end(cast(Buf, m))
		}
		return 1
	}
	if assignable(from, cast(Ty, to.bound)) != 0 {
		let m = err_code(cast(Node, e).pos, cstr("E251 UNCHECKED_BOUND"))
		buf_str(m, cstr("cannot use "))
		type_name(cast(Buf, m), from)
		buf_str(m, cstr(" as "))
		type_name(cast(Buf, m), to)
		buf_str(m, cstr(": its length is unchecked (check it with bound(x), which fails with fault.LimitExceeded)"))
		err_end(cast(Buf, m))
		return 1
	}
	return 0
}

shared mut bound_want i64 // the bounded type a bound(x) call being checked must produce

// bound_target is the type the destination of try/catch statement s gives a bound(x) call.
fn bound_target(s AssignStmt, call i64, mode i64, declared i64) i64 {
	if cast(Node, call).kind != EX_CALL || cast(Call, call).name == 0 || streq(cast(Call, call).name, cstr("bound")) == 0 {
		return 0
	}
	if mode == 1 {
		return declared
	}
	if mode == 4 && cast(Fn, ck_fn).rtypes.len == 2 {
		return vec_get(cast(Fn, ck_fn).rtypes, 0)
	}
	if mode == 2 {
		let tg = s.target
		if cast(Node, tg).kind == EX_IDENT {
			let sy = lookup_name(cast(IdentExpr, tg).name)
			if cast(i64, sy) != 0 {
				return sy.type_
			}
		} else if cast(Node, tg).kind == EX_SELECT {
			return chk(cast(Node, expr_clone(tg)), 0)
		}
	}
	return 0
}

// array_len is N for an [N]T type expression, else 0 ([N]T is a []T that starts with N
// zero elements).
fn array_len(tx i64) i64 {
	if tx == 0 || cast(Node, tx).kind != TX_ARRAY {
		return 0
	}
	let n = const_value(cast(i64, cast(TypeExpr, tx).a), 0)
	if n < 0 {
		err_code_at(cast(Node, tx).pos, cstr("E202 ARRAY_TYPE"), cstr("array length must not be negative"))
		return 0
	}
	// [N][M]T: remember M, so every row starts with M zero elements.
	array_inner = array_len(cast(i64, cast(TypeExpr, tx).b))
	return n
}

shared mut array_inner i64 // the row length of the last [N][M]T array_len saw

// array_make is the starting value of an [n]T: n zero elements.
fn array_make(pos i64, t Ty, n i64) i64 {
	let ek = kind_of(cast(Ty, t.elem))
	let nn = mk_int(pos, n, ty_int)
	let inner = array_inner
	array_inner = 0
	if ek == K_SLICE && inner > 0 {
		let ik = kind_of(cast(Ty, cast(Ty, t.elem).elem))
		if ik == K_STRUCT || ik == K_MAP || ik == K_FUNC || ik == K_SLICE {
			err_code_type(pos, cstr("E202 ARRAY_TYPE"), cstr("an array of "), t.elem, cstr(" rows is limited to numbers, bools and strs"))
		}
		let args = vec_new[i64]()
		vec_push(args, nn)
		vec_push(args, mk_int(pos, inner, ty_int))
		vec_push(args, mk_int(pos, elem_size(cast(Ty, t.elem)), ty_int))
		vec_push(args, mk_int(pos, i64(ik == K_STRING), ty_int))
		return rt_call(pos, cstr("rt_slice_make_grid"), cast(i64, args), cast(i64, t))
	}
	if ek == K_STRUCT || ek == K_MAP || ek == K_FUNC {
		err_code_type(pos, cstr("E203 NO_ZERO_VALUE"), cstr("an array of "), t.elem, cstr(" would start with nil elements: use a slice and append"))
	}
	if ek == K_STRING {
		return rt_call(pos, cstr("rt_slice_make_str"), args2(nn, mk_int(pos, n, ty_int)), cast(i64, t))
	}
	if ek == K_SLICE {
		return rt_call(pos, cstr("rt_slice_make_nest"), args3(nn, mk_int(pos, n, ty_int), mk_int(pos, elem_size(cast(Ty, t.elem)), ty_int)), cast(i64, t))
	}
	return rt_call(pos, cstr("rt_slice_make"), args3(nn, mk_int(pos, n, ty_int), mk_int(pos, elem_size(t), ty_int)), cast(i64, t))
}

fn resolve_fields(st Ty, tx TypeExpr) {
	let fs = vec_new[i64]()
	let src = cast(Vec[i64], tx.a)
	mut i = 0
	for i < src.len {
		let f = cast(Vec[i64], vec_get(src, i))
		let rec = vec_new[i64]()
		vec_push(rec, vec_get(f, 0))
		vec_push(rec, resolve_type(vec_get(f, 1)))
		if cast(Ty, vec_get(f, 1)).kind >= TX_NAME {
			sb_forbid(cast(Node, vec_get(f, 1)).pos, vec_get(rec, 1), cstr("a struct or enum field cannot hold "))
		}
		// Slot 2 is the offset (layout_struct); [N]T fields start with N zero elements.
		vec_push(rec, 0)
		vec_push(rec, array_len(vec_get(f, 1)))
		vec_push(rec, array_inner)
		array_inner = 0
		// Field metadata is compile-time only; it never enters the object layout.
		vec_push(rec, vec_get(f, 2))
		vec_push(fs, cast(i64, rec))
		i = i + 1
	}
	st.fields = cast(i64, fs)
	st.enum_ = cast(i64, tx.b)
}

// ---- declarations ----
fn check() {
	globals = cast(Vec[Sym], vec_new[i64]())
	sc_syms = cast(Vec[Sym], vec_new[i64]())
	sc_marks = vec_new[i64]()
	init_stmts = vec_new[i64]()
	safe_pairs = vec_new[i64]()
	len_aliases = vec_new[i64]()
	dyn_tables = vec_new[i64]()
	gtab = 0
	gtab_size = 0
	gtab_used = 0
	generics_init()
	shapes_init()
	// Named types: structs first, so fields and aliases can refer to any of them.
	mut i = 0
	for i < prog_types.len {
		let d = vec_get(prog_types, i)
		set_file(d.file)
		let q = qual(ck_pkg, d.name)
		if d.tparams != 0 {
		} else if cast(Node, d.type_).kind == TX_STRUCT {
			name_type(q, ty_new(K_STRUCT, q))
		}
		i = i + 1
	}
	i = 0
	for i < prog_types.len {
		let d = vec_get(prog_types, i)
		set_file(d.file)
		let q = qual(ck_pkg, d.name)
		if d.tparams != 0 {
		} else if cast(Node, d.type_).kind == TX_STRUCT {
			resolve_fields(cast(Ty, find_type(q)), cast(TypeExpr, d.type_))
			layout_struct(cast(Ty, find_type(q)))
		} else {
			name_type(q, resolve_type(d.type_))
		}
		i = i + 1
	}
	// A type and a shape may not share a name: the two would be ambiguous wherever a
	// name can be either (a constraint) and confusing everywhere else. A generic type's
	// name lives in ty_generics until it is instantiated, so both are checked.
	i = 0
	for i < prog_shapes.len {
		let sd = vec_get(prog_shapes, i)
		set_file(sd.file)
		let q = qual(ck_pkg, sd.name)
		if find_type(q) != 0 || cast(i64, find_generic(q)) != 0 {
			err_code_quoted(sd.pos, cstr("E101 REDECLARED"), cstr(""), sd.name, cstr(" is declared as a type and as a shape"))
		}
		i = i + 1
	}
	shapes_declared()
	lifecycle_decls()
	i = 0
	let ndecl = prog_fns.len
	for i < ndecl {
		let df = vec_get(prog_fns, i)
		if is_template(cast(Fn, df)) != 0 {
			declare_template(cast(Fn, df))
		} else {
			declare_fn(cast(Fn, df))
		}
		i = i + 1
	}
	generics_declared()
	i = 0
	for i < prog_consts.len {
		let c = vec_get(prog_consts, i)
		set_file(c.file)
		let cs = sym_new(SYM_CONST, qual(ck_pkg, c.name), c.pos)
		cs.decl = cast(i64, c)
		c.sym = cast(i64, cs)
		declare_global(cs)
		i = i + 1
	}
	i = 0
	for i < prog_vars.len {
		let v = vec_get(prog_vars, i)
		set_file(v.file)
		let vs = sym_new(SYM_GLOBAL, qual(ck_pkg, v.name), v.pos)
		vs.index = i
		vs.type_ = 0
		if v.shared_ == 0 {
			tls_count = tls_count + 1
			vs.tls = tls_count
		} else if v.shared_ != 0 && vec_get(file_trusted, ck_file) == 0 {
			err_code_at(v.pos, cstr("E601 SHARED_GLOBAL"), cstr("shared mutable state across cores is not allowed: globals are per core (use const, or relay messages)"))
		}
		if v.type_ != 0 {
			vs.type_ = resolve_type(v.type_)
		}
		v.sym = cast(i64, vs)
		declare_global(vs)
		i = i + 1
	}
	i = 0
	for i < prog_consts.len {
		check_const(vec_get(prog_consts, i))
		i = i + 1
	}
	start_fn = cast(i64, fn_new(0, cstr("__start")))
	cast(Fn, start_fn).locals = cast(Vec[Sym], vec_new[i64]())
	core_fn = fn_new(0, cstr("__core_init"))
	cast(Fn, core_fn).locals = cast(Vec[Sym], vec_new[i64]())
	cast(Fn, core_fn).qname = cstr("__core_init")
	cast(Fn, core_fn).generated = 1
	core_fn.type_ = func_of(cast(Vec[i64], cast(Fn, core_fn).ptypes), cast(Fn, core_fn).rtypes, 0)
	core_stmts = vec_new[i64]()
	let pkgs_done = vec_new[i64]()
	i = 0
	for i < file_pkgs.len {
		check_pkg_vars(vec_get(file_pkgs, i), cast(Vec[i64], pkgs_done))
		i = i + 1
	}
	// Function literals are lifted onto prog_fns while bodies are checked.
	i = 0
	for i < prog_fns.len {
		let fd = vec_get(prog_fns, i)
		if fd.done != 0 {
			i = i + 1
			continue
		}
		if fd.extern_ == 0 && fd.lifted != 2 && is_template(fd) == 0 {
			check_fn(fd)
		}
		i = i + 1
	}
	mut m = cast(Sym, 0)
	if entry_name != 0 {
		m = lookup_global(entry_name)
		let um = lookup_global(cstr("main"))
		if cast(i64, um) != 0 && um.kind == SYM_FUNC && um != m {
			// The program's own main is not the entry: keep its symbol out of the C name.
			cast(Fn, um.fn_).qname = cstr("main.main$unused")
		}
		if cast(i64, m) == 0 || m.kind != SYM_FUNC {
			let e0 = err_code(NO_POS, cstr("E120 NO_MAIN"))
			buf_str(e0, cstr("no entry function "))
			buf_str(e0, entry_name)
			err_end(cast(Buf, e0))
			return
		}
	} else {
		m = lookup_global(cstr("main"))
	}
	if cast(i64, m) == 0 || m.kind != SYM_FUNC {
		let e = err_code(NO_POS, cstr("E120 NO_MAIN"))
		buf_str(e, cstr("no main function"))
		err_end(cast(Buf, e))
		return
	}
	if cast(Fn, m.fn_).extern_ != 0 {
		let e2 = err_code(m.pos, cstr("E121 MAIN_SIGNATURE"))
		buf_str(e2, cstr("main cannot be extern"))
		err_end(cast(Buf, e2))
	} else if cast(Fn, m.fn_).params.len != 0 {
		let e3 = err_code(m.pos, cstr("E121 MAIN_SIGNATURE"))
		buf_str(e3, cstr("main takes no parameters"))
		err_end(cast(Buf, e3))
	}
	make_start(cast(Fn, m.fn_))
	mark_reach(cast(Fn, start_fn))
	// Bounds-check traps call it from code the backend generates.
	mark_reach(find_fn(cstr("rt_bounds_fail")))
	mark_reach(find_fn(cstr("rt_bounds_fail2")))
	mark_reach(find_fn(cstr("rt_div_fail")))
	if compiler_polls != 0 {
		mark_reach(find_fn(cstr("rt_bnd_poll")))
	}
	check_init_order()
}

// declare_template makes a generic function's name callable; instances are declared on use.
fn declare_template(f Fn) {
	set_file(f.file)
	if f.recv != 0 {
		f.qname = str_cat3(qual(ck_pkg, cast(i64, cast(TypeExpr, f.recv).b)), cstr("[]."), f.name)
		return
	}
	let name = qual(ck_pkg, f.name)
	f.qname = name
	let fs = sym_new(SYM_FUNC, name, f.pos)
	fs.fn_ = cast(i64, f)
	declare_global(fs)
}

fn declare_fn(f Fn) {
	set_file(f.file)
	if f.extern_ != 0 && ck_trusted == 0 {
		// Legacy files keep their externs. This one is not declared, so it cannot replace
		// the runtime's C function of the same name.
		err_code_at(f.pos, cstr("E801 TRUSTED_ONLY"), cstr("extern is only allowed in the standard library"))
		return
	}
	let np = cast(Vec[i64], f.params).len
	mut ptypes = vec_new[i64]()
	mut i = 0
	for i < np {
		vec_push(ptypes, resolve_type(vec_get(cast(Vec[i64], f.ptypes), i)))
		i = i + 1
	}
	let rtypes = resolve_types(cast(Vec[i64], f.rtypes))
	mut sbi = 0
	for f.genof == 0 && sbi < rtypes.len {
		// (A generic's instance: its type arguments were checked where it was used.)
		sb_forbid(f.pos, vec_get(rtypes, sbi), cstr("a function cannot return "))
		sbi = sbi + 1
	}
	if f.extern_ == 0 && f.bang != 0 {
		mut ri = 0
		for ri < rtypes.len {
			if kind_of(cast(Ty, vec_get(rtypes, ri))) == K_DYN {
				err_code_at(f.pos, cstr("E530 DYN_NOT_YET"), cstr("a !dyn result is the next step: fail would need the zero pair (#141)"))
			}
			ri = ri + 1
		}
	}
	if f.extern_ == 0 && f.bang == 0 && rtypes.len > 0 && kind_of(cast(Ty, vec_get(rtypes, rtypes.len - 1))) == K_ERROR {
		err_code_at(f.pos, cstr("E402 FAULT_RESULT"), cstr("write a result that can fail as !T (or ! when there is no value), not with a fault result"))
	}
	mut name = qual(ck_pkg, f.name)
	if f.extern_ != 0 {
		// C symbols are global: every package's extern of the same name is one function.
		name = f.name
	}
	if f.recv != 0 {
		let rt = cast(Ty, resolve_type(f.recv))
		if kind_of(rt) != K_STRUCT {
			err_code_type(f.pos, cstr("E140 RECEIVER"), cstr("methods need a struct receiver, not "), cast(i64, rt), cstr(""))
		}
		name = str_cat3(rt.name, cstr("."), f.name)
		// The receiver is passed as parameter zero.
		let params = vec_new[i64]()
		vec_push(params, f.recvname)
		let pt = vec_new[i64]()
		vec_push(pt, cast(i64, rt))
		let muts = vec_new[i64]()
		vec_push(muts, f.recvmut)
		i = 0
		for i < np {
			vec_push(params, vec_get(cast(Vec[i64], f.params), i))
			vec_push(pt, vec_get(ptypes, i))
			vec_push(muts, vec_get(cast(Vec[i64], f.muts), i))
			i = i + 1
		}
		f.params = cast(Vec[i64], params)
		f.muts = cast(i64, muts)
		ptypes = pt
	}
	f.ptypes = cast(i64, ptypes)
	f.rtypes = cast(Vec[i64], rtypes)
	f.qname = name
	f.type_ = func_of_m(cast(Vec[i64], ptypes), cast(Vec[i64], rtypes), f.variadic, mut_mask(cast(Vec[i64], f.muts)))
	mut ints = 0
	mut floats = 0
	i = 0
	for i < cast(Vec[i64], ptypes).len {
		if is_float_t(vec_get(ptypes, i)) != 0 {
			floats = floats + 1
		} else {
			ints = ints + 1
		}
		i = i + 1
	}
	if ints > MAX_PARAMS || floats > MAX_PARAMS {
		let e = err_code(f.pos, cstr("E907 TOO_MANY_PARAMS"))
		buf_str(e, cstr("function '"))
		buf_str(e, f.name)
		buf_str(e, cstr("' has "))
		buf_int(e, cast(Vec[i64], ptypes).len)
		buf_str(e, cstr(" parameters, the limit is 8"))
		err_end(cast(Buf, e))
	}
	if rtypes.len > 8 {
		err_code_at(f.pos, cstr("E907 TOO_MANY_PARAMS"), cstr("too many results"))
	}
	if f.lifted != 0 {
		return
	}
	let prev = lookup_global(name)
	if f.extern_ != 0 && cast(i64, prev) != 0 && prev.kind == SYM_FUNC && cast(Fn, prev.fn_).extern_ != 0 {
		return
	}
	let fs = sym_new(SYM_FUNC, name, f.pos)
	fs.fn_ = cast(i64, f)
	declare_global(fs)
}

fn check_const(c Decl) {
	set_file(c.file)
	ck_fn = cast(Fn, 0)
	check_const_value(c)
}

// Evaluate in the caller's lexical scope; local declarations keep the current function.
fn check_const_value(c Decl) {
	let s = cast(Sym, c.sym)
	if cast(Decl, s.decl) != c {
		return
	}
	mut want = 0
	if c.type_ != 0 {
		want = resolve_type(c.type_)
	}
	let init = cast(Node, c.init)
	if is_int_const_expr(cast(i64, init)) != 0 {
		let v = const_value(cast(i64, init), c.iota)
		s.big = cv_big
		s.val = v
		s.type_ = ty_uint
		if want != 0 {
			if is_integer_t(want) == 0 && is_float_t(want) == 0 {
				err_code_type(c.pos, cstr("E221 CONST_TYPE"), cstr("cannot use an integer constant as "), want, cstr(""))
			}
			s.type_ = want
			if is_integer_t(want) != 0 {
				let value = mk_int(c.pos, v, 0)
				cast(IntLit, value).big = s.big
				adapt_int(value, want)
			}
		}
	} else {
		let copy_ = expr_clone(cast(i64, init))
		let t = chk(cast(Node, copy_), want)
		if want != 0 {
			check_assignable(cast(Node, copy_), t, cast(Ty, want))
		}
		if is_const_value(copy_) == 0 {
			err_code_at(init.pos, cstr("E220 NOT_CONSTANT"), cstr("expression is not a constant"))
		}
		s.expr = copy_
		s.type_ = t
	}
	s.done = 1
}

// is_const_value accepts the checked forms a non-integer constant may take.
fn is_const_value(e i64) i64 {
	let k = cast(Node, e).kind
	return i64(k == EX_FLOAT || k == EX_STR || k == EX_INT || (k == EX_UNARY && is_const_value(cast(Unary, e).x) != 0))
}

// is_int_const_expr reports whether e is built only from integer literals and constants.
fn is_int_const_expr(e i64) i64 {
	let k = cast(Node, e).kind
	if k == EX_INT {
		return 1
	}
	if k == EX_IDENT {
		if streq(cast(IdentExpr, e).name, cstr("iota")) != 0 {
			return 1
		}
		let s = lookup_name(cast(IdentExpr, e).name)
		if cast(i64, s) != 0 && s.kind == SYM_CONST {
			let d = s.decl
			return i64(s.done == 0 || s.expr == 0)
		}
		return 0
	}
	if k == EX_UNARY {
		return i64(streq(cast(Unary, e).op, cstr("&")) == 0 && is_int_const_expr(cast(Unary, e).x) != 0)
	}
	if k == EX_BINARY {
		return i64(is_int_const_expr(cast(Binary, e).l) != 0 && is_int_const_expr(cast(Binary, e).r) != 0)
	}
	return 0
}

// const_value evaluates an integer constant expression; iota is the group position.
shared mut cv_big i64 // the last const_value result is an unsigned value above 2^63-1

// eval_unsigned is >>, / or % on 64-bit patterns read as unsigned.
fn eval_unsigned(op i64, a i64, b i64) i64 {
	if streq(op, cstr(">>")) != 0 {
		if b <= 0 {
			return a
		}
		if b >= 64 {
			return 0
		}
		return (a >> b) & ((1 << (64 - b)) - 1)
	}
	mut q = 0
	if b < 0 {
		// A divisor of 2^63 or more goes into a at most once.
		if (a ^ (1 << 63)) >= (b ^ (1 << 63)) {
			q = 1
		}
	} else if a >= 0 {
		q = a / b
	} else {
		q = (((a >> 1) & 0x7fffffffffffffff) / b) << 1
		let rem = a - q * b
		if (rem ^ (1 << 63)) >= (b ^ (1 << 63)) {
			q = q + 1
		}
	}
	if streq(op, cstr("/")) != 0 {
		return q
	}
	return a - q * b
}

fn const_value(e i64, iota i64) i64 {
	let v = const_value_b(e, iota)
	return v
}

fn const_value_b(e i64, iota i64) i64 {
	let k = cast(Node, e).kind
	cv_big = 0
	if k == EX_INT {
		cv_big = cast(IntLit, e).big
		return cast(IntLit, e).val
	}
	if k == EX_IDENT {
		if streq(cast(IdentExpr, e).name, cstr("iota")) != 0 {
			return iota
		}
		let s = lookup_name(cast(IdentExpr, e).name)
		if cast(i64, s) == 0 || s.kind != SYM_CONST {
			err_code_quoted(cast(Node, e).pos, cstr("E220 NOT_CONSTANT"), cstr(""), cast(IdentExpr, e).name, cstr(" is not a constant"))
			return 0
		}
		if s.done == 0 {
			err_code_quoted(cast(Node, e).pos, cstr("E130 INIT_ORDER"), cstr("constant "), cast(IdentExpr, e).name, cstr(" used before its definition"))
			return 0
		}
		cast(IdentExpr, e).ref = cast(i64, s)
		cv_big = s.big
		return s.val
	}
	if k == EX_UNARY && streq(cast(Unary, e).op, cstr("&")) == 0 {
		let uv = eval_unary(cast(Unary, e).op, const_value_b(cast(Unary, e).x, iota))
		cv_big = i64(cv_big != 0 && uv < 0 && streq(cast(Unary, e).op, cstr("-")) == 0)
		return uv
	}
	if k == EX_BINARY {
		let before = error_count
		let l = const_value_b(cast(Binary, e).l, iota)
		let lb = cv_big
		let r = const_value_b(cast(Binary, e).r, iota)
		let ub = i64(lb != 0 || cv_big != 0)
		cv_big = 0
		if error_count != before {
			return 0
		}
		let op = cast(Binary, e).op
		if (streq(op, cstr("/")) != 0 || streq(op, cstr("%")) != 0) && r == 0 {
			err_code_at(cast(Node, e).pos, cstr("E222 DIVISION_BY_ZERO"), cstr("division by zero in constant expression"))
			return 0
		}
		mut res = 0
		if ub != 0 && (streq(op, cstr(">>")) != 0 || streq(op, cstr("/")) != 0 || streq(op, cstr("%")) != 0) {
			res = eval_unsigned(op, l, r)
		} else if ub != 0 && (streq(op, cstr("<")) != 0 || streq(op, cstr("<=")) != 0 || streq(op, cstr(">")) != 0 || streq(op, cstr(">=")) != 0) {
			res = eval_binary(op, l ^ (1 << 63), r ^ (1 << 63))
			return res
		} else {
			res = eval_binary(op, l, r)
		}
		cv_big = i64(ub != 0 && res < 0)
		return res
	}
	err_code_at(cast(Node, e).pos, cstr("E220 NOT_CONSTANT"), cstr("expression is not a constant"))
	return 0
}

fn eval_unary(op i64, v i64) i64 {
	if streq(op, cstr("-")) != 0 {
		return -v
	}
	if streq(op, cstr("~")) != 0 {
		return ~v
	}
	return i64(v == 0)
}

// eval_binary matches the ARM64 instructions codegen emits (shift counts wrap at 64).
fn eval_binary(op i64, l i64, r i64) i64 {
	if streq(op, cstr("+")) != 0 {
		return l + r
	}
	if streq(op, cstr("-")) != 0 {
		return l - r
	}
	if streq(op, cstr("*")) != 0 {
		return l * r
	}
	if streq(op, cstr("/")) != 0 {
		return l / r
	}
	if streq(op, cstr("%")) != 0 {
		return l % r
	}
	if streq(op, cstr("&")) != 0 {
		return l & r
	}
	if streq(op, cstr("|")) != 0 {
		return l | r
	}
	if streq(op, cstr("^")) != 0 {
		return l ^ r
	}
	if streq(op, cstr("<<")) != 0 {
		return l << r
	}
	if streq(op, cstr(">>")) != 0 {
		return l >> r
	}
	if streq(op, cstr("==")) != 0 {
		return i64(l == r)
	}
	if streq(op, cstr("!=")) != 0 {
		return i64(l != r)
	}
	if streq(op, cstr("<")) != 0 {
		return i64(l < r)
	}
	if streq(op, cstr("<=")) != 0 {
		return i64(l <= r)
	}
	if streq(op, cstr(">")) != 0 {
		return i64(l > r)
	}
	if streq(op, cstr(">=")) != 0 {
		return i64(l >= r)
	}
	if streq(op, cstr("&&")) != 0 {
		return i64(l != 0 && r != 0)
	}
	return i64(l != 0 || r != 0)
}

// check_pkg_vars checks package pkg's globals after those of the packages it imports, so
// their initializers run first; done lists the packages already checked.
fn check_pkg_vars(pkg i64, done Vec[i64]) {
	mut i = 0
	for i < done.len {
		if streq(vec_get(done, i), pkg) != 0 {
			return
		}
		i = i + 1
	}
	vec_push(done, pkg)
	i = 0
	for i < file_pkgs.len {
		if streq(vec_get(file_pkgs, i), pkg) != 0 {
			let imps = cast(Vec[i64], vec_get(file_imports, i))
			mut j = 0
			for j < imps.len {
				check_pkg_vars(path_pkg(vec_get(cast(Vec[i64], vec_get(imps, j)), 1)), done)
				j = j + 1
			}
		}
		i = i + 1
	}
	i = 0
	for i < prog_vars.len {
		let v = vec_get(prog_vars, i)
		if streq(vec_get(file_pkgs, v.file), pkg) != 0 {
			check_var(v)
		}
		i = i + 1
	}
}

shared mut ck_sentinel i64 // the initializer of the package-level var being checked: fault("...") there is a sentinel
shared mut sentinel_seq i64 // numbers sentinel identities (the runtime's own are below 64)

fn check_var(v Decl) {
	set_file(v.file)
	ck_fn = cast(Fn, 0)
	let s = cast(Sym, v.sym)
	if s.index != vec_index(cast(Vec[i64], prog_vars), cast(i64, v)) {
		return
	}
	if v.type_ != 0 {
		sb_forbid(v.pos, s.type_, cstr("a global cannot hold "))
	}
	let pu = use_global_of(cast(i64, v))
	if pu != 0 {
		check_use_global(v, s, cast(UseStmt, pu))
		return
	}
	mut init = v.init
	if init == 0 && s.tls != 0 && array_len(v.type_) > 0 {
		init = array_make(v.pos, cast(Ty, s.type_), array_len(v.type_))
	}
	if init == 0 && s.tls != 0 && s.type_ != 0 && is_ref(s.type_) != 0 && kind_of(cast(Ty, s.type_)) != K_OPT && kind_of(cast(Ty, s.type_)) != K_ERROR && kind_of(cast(Ty, s.type_)) != K_FUNC {
		init = zero_value(v.pos, s.type_)
	}
	if init == 0 {
		if s.type_ == 0 {
			s.type_ = ty_int
		}
		if kind_of(cast(Ty, s.type_)) == K_DYN {
			zero_value(v.pos, s.type_)
		}
		return
	}
	if (is_int_const_expr(init) != 0) && s.tls == 0 {
		v.val = const_value(init, 0)
		if s.type_ == 0 {
			s.type_ = ty_int
		}
		if is_float_t(s.type_) != 0 {
			v.val = int_to_float_bits(v.val)
		}
		return
	}
	// Anything else runs at startup, in the order checked, inside __start.
	start_scope()
	ck_fn = cast(Fn, start_fn)
	if s.tls != 0 {
		ck_fn = core_fn
	}
	ck_sentinel = init
	let t = chk(cast(Node, init), s.type_)
	ck_sentinel = 0
	if s.type_ == 0 {
		s.type_ = default_type(t)
		sb_forbid(v.pos, s.type_, cstr("a global cannot hold "))
	}
	check_assignable(cast(Node, init), t, cast(Ty, s.type_))
	if is_untyped(t) != 0 {
		reconvert(cast(Node, init), s.type_)
	}
	let target = node_new(EX_IDENT, v.pos)
	cast(IdentExpr, target).name = s.name
	cast(IdentExpr, target).ref = cast(i64, s)
	cast(Node, target).type_ = s.type_
	let a = cast(AssignStmt, node_new(ST_ASSIGN, v.pos))
	a.target = target
	a.value = init
	s.uninit = 1
	if s.tls != 0 {
		vec_push(core_stmts, cast(i64, a))
	} else {
		vec_push(init_stmts, cast(i64, a))
	}
}

fn vec_index(v Vec[i64], x i64) i64 {
	mut i = 0
	for i < v.len {
		if vec_get(v, i) == x {
			return i
		}
		i = i + 1
	}
	return -1
}

shared mut entry_name i64 // -entry: the function the program starts at (0: main)

// make_start builds __start: runtime setup, global initializers, main, flush and exit.
fn make_start(main_fn Fn) {
	let pos = main_fn.pos
	let f = cast(Fn, start_fn)
	f.pos = pos
	// __start takes the C entry name; the program's own main becomes main.main.
	f.qname = cstr("main")
	main_fn.qname = cstr("main.main")
	f.generated = 1
	vec_push(cast(Vec[i64], f.params), cstr("argc"))
	vec_push(cast(Vec[i64], f.params), cstr("argv"))
	f.ptypes = cast(i64, vec_new[i64]())
	vec_push(cast(Vec[i64], f.ptypes), ty_int)
	vec_push(cast(Vec[i64], f.ptypes), ty_int)
	f.rtypes = vec_new[i64]()
	vec_push(cast(Vec[i64], f.rtypes), ty_int)
	f.type_ = func_of(cast(Vec[i64], f.ptypes), cast(Vec[i64], f.rtypes), 0)
	let body = cast(Block, empty_block(pos))
	f.body = cast(i64, body)
	ck_fn = cast(Fn, f)
	sc_syms.len = 0
	sc_marks.len = 0
	vec_push(sc_marks, 0)
	// The parameters must be the first locals; initializer temps follow them.
	let olds = cast(Vec[i64], f.locals)
	f.locals = cast(Vec[Sym], vec_new[i64]())
	f.slots = 0
	let a0 = declare_local(pos, cstr("argc"), ty_int)
	let a1 = declare_local(pos, cstr("argv"), ty_int)
	mut oi = 0
	for oi < olds.len {
		vec_push(cast(Vec[i64], f.locals), vec_get(olds, oi))
		oi = oi + 1
	}
	let cb = cast(Block, empty_block(pos))
	mut ci = 0
	for ci < core_stmts.len {
		vec_push(cast(Vec[i64], cb.stmts), vec_get(core_stmts, ci))
		ci = ci + 1
	}
	core_fn.body = cast(i64, cb)
	core_fn.pos = pos
	vec_push(prog_fns, cast(Fn, core_fn))
	let cref = node_new(EX_FUNCREF, pos)
	cast(FuncRef, cref).fn_ = cast(i64, core_fn)
	cast(Node, cref).type_ = core_fn.type_
	let args = vec_new[i64]()
	vec_push(args, sym_ref_node(pos, cast(Sym, a0)))
	vec_push(args, sym_ref_node(pos, cast(Sym, a1)))
	vec_push(args, mk_int(pos, tls_count, ty_int))
	vec_push(args, cref)
	vec_push(cast(Vec[i64], body.stmts), expr_stmt(cast(Node, rt_call(pos, cstr("rt_init"), cast(i64, args), ty_void))))
	if compiler_polls != 0 {
		vec_push(cast(Vec[i64], body.stmts), expr_stmt(cast(Node, rt_call(pos, cstr("rt_poll_enable"), cast(i64, vec_new[i64]()), ty_void))))
	}
	mut i = 0
	for i < init_stmts.len {
		vec_push(cast(Vec[i64], body.stmts), vec_get(init_stmts, i))
		i = i + 1
	}
	let cc = node_new(EX_CALL, pos)
	cast(Call, cc).name = cstr("__core_init")
	cast(Call, cc).args = vec_new[i64]()
	cast(Call, cc).fn_ = cast(i64, core_fn)
	cast(Node, cc).type_ = ty_void
	vec_push(cast(Vec[i64], body.stmts), expr_stmt(cast(Node, cc)))
	vec_push(cast(Vec[i64], body.stmts), expr_stmt(cast(Node, rt_call(pos, cstr("rt_main_begin"), cast(i64, vec_new[i64]()), ty_void))))
	life_start(pos, body)
	let call = node_new(EX_CALL, pos)
	cast(Call, call).name = cstr("main")
	cast(Call, call).args = vec_new[i64]()
	cast(Call, call).fn_ = cast(i64, main_fn)
	cast(Node, call).type_ = ty_void
	vec_push(cast(Vec[i64], body.stmts), expr_stmt(cast(Node, call)))
	life_stop(pos, body)
	vec_push(cast(Vec[i64], body.stmts), expr_stmt(cast(Node, rt_call(pos, cstr("rt_exit"), cast(i64, vec_new[i64]()), ty_void))))
	vec_push(prog_fns, cast(Fn, f))
	start_fn = cast(i64, f)
}

// ---- reachability ----
shared mut reach_init Sym // the global whose initializer check_init_order walks (0: reachability)

fn mark_reach(f Fn) {
	if cast(i64, f) == 0 {
		return
	}
	if cast(i64, reach_init) != 0 {
		if f.initwalk != 0 {
			return
		}
		f.initwalk = 1
	} else if f.reach != 0 {
		return
	} else {
		f.reach = 1
	}
	// The Linux raw leaves replace their seed fallback bodies, so those imports are dead.
	if tgt_linux != 0 && (streq(f.qname, cstr("linux_raw")) != 0 || streq(f.qname, cstr("linux_restorer")) != 0) {
		return
	}
	if f.body != 0 {
		reach_stmts(cast(Block, f.body).stmts)
	}
}

// check_init_order rejects an initializer that can use a global whose initializer has not
// run yet (it would see nil), directly or through the functions it calls or refers to.
// Shared globals are initialized in __start, before the per-core ones in __core_init.
// Each function is walked once, for the first initializer that reaches it: later ones have
// fewer globals pending.
fn check_init_order() {
	walk_inits(cast(Vec[AssignStmt], init_stmts))
	walk_inits(cast(Vec[AssignStmt], core_stmts))
	reach_init = cast(Sym, 0)
}

fn walk_inits(stmts Vec[AssignStmt]) {
	mut i = 0
	for i < stmts.len {
		let a = vec_get(stmts, i)
		reach_init = cast(Sym, cast(IdentExpr, a.target).ref)
		reach_expr(a.value)
		cast(Sym, reach_init).uninit = 0
		i = i + 1
	}
}

fn reach_stmts(v Vec[i64]) {
	mut i = 0
	for i < v.len {
		reach_stmt(vec_get(v, i))
		i = i + 1
	}
}

fn reach_stmt(s i64) {
	if s == 0 {
		return
	}
	let k = cast(Node, s).kind
	if k == ST_BLOCK {
		reach_stmts(cast(Block, s).stmts)
	} else if k == ST_LET {
		reach_expr(cast(LetStmt, s).init)
	} else if k == ST_ASSIGN {
		reach_expr(cast(AssignStmt, s).target)
		reach_expr(cast(AssignStmt, s).value)
	} else if k == ST_EXPR {
		reach_expr(cast(ExprStmt, s).x)
	} else if k == ST_IF {
		reach_expr(cast(IfStmt, s).cond)
		reach_stmt(cast(IfStmt, s).then)
		reach_stmt(cast(IfStmt, s).else_)
	} else if k == ST_WHILE {
		reach_expr(cast(WhileStmt, s).cond)
		reach_stmt(cast(WhileStmt, s).body)
		reach_stmt(cast(WhileStmt, s).post)
	} else if k == ST_RETURN {
		reach_expr(cast(ReturnStmt, s).value)
		if cast(i64, cast(ReturnStmt, s).values) != 0 {
			reach_exprs(cast(ReturnStmt, s).values)
		}
	} else if k == ST_CALLMULTI {
		reach_expr(cast(CallMultiStmt, s).call)
	}
}

fn reach_exprs(v Vec[i64]) {
	mut i = 0
	for i < v.len {
		reach_expr(vec_get(v, i))
		i = i + 1
	}
}

fn reach_expr(e i64) {
	if e == 0 {
		return
	}
	let k = cast(Node, e).kind
	if k == EX_CALL {
		mark_reach(cast(Fn, cast(Call, e).fn_))
		reach_expr(cast(Call, e).callee)
		reach_exprs(cast(Call, e).args)
	} else if k == EX_FUNCREF {
		mark_reach(cast(Fn, cast(FuncRef, e).fn_))
	} else if k == EX_IDENT {
		let s = cast(Sym, cast(IdentExpr, e).ref)
		if cast(i64, reach_init) != 0 && cast(i64, s) != 0 && s.uninit != 0 {
			let b = err_code(cast(Node, e).pos, cstr("E130 INIT_ORDER"))
			buf_str(b, cstr("the initializer of '"))
			buf_str(b, reach_init.name)
			buf_str(b, cstr("' uses '"))
			buf_str(b, s.name)
			buf_str(b, cstr("' before it is initialized (globals are initialized in declaration order)"))
			err_end(cast(Buf, b))
		}
	} else if k == EX_UNARY {
		reach_expr(cast(Unary, e).x)
	} else if k == EX_BINARY {
		reach_expr(cast(Binary, e).l)
		reach_expr(cast(Binary, e).r)
	} else if k == EX_INDEX {
		reach_expr(cast(IndexExpr, e).x)
		reach_expr(cast(IndexExpr, e).i)
	} else if k == EX_CONV {
		if cast(Conv, e).kind == CV_DYN {
			dyn_table_mark(cast(Conv, e).dyn_table)
		}
		reach_expr(cast(Conv, e).x)
	} else if k == EX_SEQ {
		reach_stmts(cast(SeqExpr, e).stmts)
		reach_expr(cast(SeqExpr, e).value)
	} else if k == EX_MEM {
		reach_expr(cast(MemExpr, e).base)
		reach_expr(cast(MemExpr, e).index)
		reach_expr(cast(MemExpr, e).len)
	} else if k == EX_ELEM {
		reach_expr(cast(ElemExpr, e).seq)
		reach_expr(cast(ElemExpr, e).idx)
	}
}

// ---- scopes ----
fn start_scope() {
	sc_syms.len = 0
	sc_marks.len = 0
	vec_push(sc_marks, 0)
}

// mut_capable reports whether a parameter of type t can be mut: the callee may modify the
// contents of a struct, a slice or a map (or an optional of one) through it. A number, a bool, a
// str or a fault is passed by value, so there is nothing for mut to let it modify.
fn mut_capable(t i64) i64 {
	let k = kind_of(cast(Ty, t))
	return i64(k == K_STRUCT || k == K_SLICE || k == K_MAP || k == K_OPT || k == K_DYN)
}

fn collect_local_decls(stmts Vec[i64], names Vec[i64]) {
	if cast(i64, stmts) == 0 {
		return
	}
	mut i = 0
	for i < stmts.len {
		let s = vec_get(stmts, i)
		let k = cast(Node, s).kind
		if k == ST_LET {
			vec_push(names, cast(LetStmt, s).name)
		} else if k == ST_USE {
			vec_push(names, cast(UseStmt, s).name)
		} else if k == ST_MULTI && cast(MultiStmt, s).define != 0 {
			let tg = cast(MultiStmt, s).targets
			mut j = 0
			for j < tg.len {
				let t = vec_get(tg, j)
				if cast(Node, t).kind == EX_IDENT {
					vec_push(names, cast(IdentExpr, t).name)
				}
				j = j + 1
			}
		} else if k == ST_BLOCK {
			collect_local_decls(cast(Block, s).stmts, names)
		} else if k == ST_SCOPE {
			vec_push(names, cast(ScopeStmt, s).name)
			collect_local_decls(cast(Block, cast(ScopeStmt, s).body).stmts, names)
		} else if k == ST_DETACH {
			collect_local_decls(cast(Block, cast(BodyStmt, s).block).stmts, names)
		} else if k == ST_LIST {
			collect_local_decls(cast(ListStmt, s).stmts, names)
		} else if mt_stmt_expr(s) != 0 && cast(Node, mt_stmt_expr(s)).kind == EX_MATCH {
			mt_collect_decls(cast(MatchExpr, mt_stmt_expr(s)), cast(Vec[i64], names))
		} else if k == ST_IF {
			if cast(IfStmt, s).init != 0 {
				let tmp = vec_new[i64]()
				vec_push(tmp, cast(IfStmt, s).init)
				collect_local_decls(cast(Vec[i64], tmp), names)
			}
			collect_local_decls(cast(Block, cast(IfStmt, s).then).stmts, names)
			if cast(IfStmt, s).else_ != 0 {
				if cast(Node, cast(IfStmt, s).else_).kind == ST_BLOCK {
					collect_local_decls(cast(Block, cast(IfStmt, s).else_).stmts, names)
				} else {
					let tmp = vec_new[i64]()
					vec_push(tmp, cast(IfStmt, s).else_)
					collect_local_decls(cast(Vec[i64], tmp), names)
				}
			}
		} else if k == ST_WHILE {
			if cast(WhileStmt, s).init != 0 {
				let tmp = vec_new[i64]()
				vec_push(tmp, cast(WhileStmt, s).init)
				collect_local_decls(cast(Vec[i64], tmp), names)
			}
			collect_local_decls(cast(Block, cast(WhileStmt, s).body).stmts, names)
		} else if k == ST_RANGE {
			if cast(RangeStmt, s).define != 0 {
				if cast(RangeStmt, s).key != 0 && cast(Node, cast(RangeStmt, s).key).kind == EX_IDENT {
					vec_push(names, cast(IdentExpr, cast(RangeStmt, s).key).name)
				}
				if cast(RangeStmt, s).val != 0 && cast(Node, cast(RangeStmt, s).val).kind == EX_IDENT {
					vec_push(names, cast(IdentExpr, cast(RangeStmt, s).val).name)
				}
			}
			collect_local_decls(cast(Block, cast(RangeStmt, s).body).stmts, names)
		} else if k == ST_SWITCH {
			if cast(SwitchStmt, s).init != 0 {
				let tmp = vec_new[i64]()
				vec_push(tmp, cast(SwitchStmt, s).init)
				collect_local_decls(cast(Vec[i64], tmp), names)
			}
			let cases = cast(SwitchStmt, s).cases
			if cast(i64, cases) != 0 {
				mut ci = 0
				for ci < cases.len {
					let c = cast(Vec[i64], vec_get(cases, ci))
					let body = cast(Block, vec_get(c, 1))
					if cast(i64, body) != 0 {
						collect_local_decls(cast(Vec[i64], body.stmts), names)
					}
					ci = ci + 1
				}
			}
		}
		i = i + 1
	}
}

fn scan_funclit_escaping_idents(lf Fn, outer_names Vec[i64], cells Vec[i64]) {
	if cast(i64, lf) == 0 || lf.body == 0 {
		return
	}
	let inner_params = cast(Vec[i64], lf.params)
	scan_idents_in_block(cast(Block, lf.body), inner_params, outer_names, cells)
}

fn scan_idents_in_block(b Block, inner_params Vec[i64], outer_names Vec[i64], cells Vec[i64]) {
	if cast(i64, b) == 0 || cast(i64, b.stmts) == 0 {
		return
	}
	let stmts = cast(Vec[i64], b.stmts)
	mut i = 0
	for i < stmts.len {
		scan_idents_in_stmt(vec_get(stmts, i), inner_params, outer_names, cells)
		i = i + 1
	}
}

fn scan_idents_in_stmt(s i64, inner_params Vec[i64], outer_names Vec[i64], cells Vec[i64]) {
	if s == 0 {
		return
	}
	let k = cast(Node, s).kind
	if k == ST_LET {
		scan_idents_in_expr(cast(LetStmt, s).init, inner_params, outer_names, cells)
	} else if k == ST_USE {
		scan_idents_in_expr(cast(UseStmt, s).init, inner_params, outer_names, cells)
	} else if k == ST_ASSIGN {
		scan_idents_in_expr(cast(AssignStmt, s).target, inner_params, outer_names, cells)
		scan_idents_in_expr(cast(AssignStmt, s).value, inner_params, outer_names, cells)
	} else if k == ST_MULTI {
		let vals = cast(MultiStmt, s).values
		if cast(i64, vals) != 0 {
			mut i = 0
			for i < vals.len {
				scan_idents_in_expr(vec_get(vals, i), inner_params, outer_names, cells)
				i = i + 1
			}
		}
	} else if k == ST_EXPR {
		scan_idents_in_expr(cast(ExprStmt, s).x, inner_params, outer_names, cells)
	} else if k == ST_IF {
		if cast(IfStmt, s).init != 0 {
			scan_idents_in_stmt(cast(IfStmt, s).init, inner_params, outer_names, cells)
		}
		scan_idents_in_expr(cast(IfStmt, s).cond, inner_params, outer_names, cells)
		scan_idents_in_block(cast(Block, cast(IfStmt, s).then), cast(Vec[i64], inner_params), cast(Vec[i64], outer_names), cast(Vec[i64], cells))
		if cast(IfStmt, s).else_ != 0 {
			if cast(Node, cast(IfStmt, s).else_).kind == ST_BLOCK {
				scan_idents_in_block(cast(Block, cast(IfStmt, s).else_), cast(Vec[i64], inner_params), cast(Vec[i64], outer_names), cast(Vec[i64], cells))
			} else {
				scan_idents_in_stmt(cast(IfStmt, s).else_, inner_params, outer_names, cells)
			}
		}
	} else if k == ST_WHILE {
		if cast(WhileStmt, s).init != 0 {
			scan_idents_in_stmt(cast(WhileStmt, s).init, inner_params, outer_names, cells)
		}
		scan_idents_in_expr(cast(WhileStmt, s).cond, inner_params, outer_names, cells)
		scan_idents_in_block(cast(Block, cast(WhileStmt, s).body), cast(Vec[i64], inner_params), cast(Vec[i64], outer_names), cast(Vec[i64], cells))
		scan_idents_in_stmt(cast(WhileStmt, s).post, inner_params, outer_names, cells)
	} else if k == ST_RANGE {
		scan_idents_in_expr(cast(RangeStmt, s).expr, inner_params, outer_names, cells)
		scan_idents_in_block(cast(Block, cast(RangeStmt, s).body), cast(Vec[i64], inner_params), cast(Vec[i64], outer_names), cast(Vec[i64], cells))
	} else if k == ST_SWITCH {
		if cast(SwitchStmt, s).init != 0 {
			scan_idents_in_stmt(cast(SwitchStmt, s).init, inner_params, outer_names, cells)
		}
		if cast(SwitchStmt, s).tag != 0 {
			scan_idents_in_expr(cast(SwitchStmt, s).tag, inner_params, outer_names, cells)
		}
		let cases = cast(SwitchStmt, s).cases
		if cast(i64, cases) != 0 {
			mut ci = 0
			for ci < cases.len {
				let c = cast(Vec[i64], vec_get(cases, ci))
				let exprs = cast(Vec[i64], vec_get(c, 0))
				if cast(i64, exprs) != 0 {
					mut j = 0
					for j < exprs.len {
						scan_idents_in_expr(vec_get(exprs, j), inner_params, outer_names, cells)
						j = j + 1
					}
				}
				let body = vec_get(c, 1)
				if body != 0 {
					scan_idents_in_block(cast(Block, body), cast(Vec[i64], inner_params), cast(Vec[i64], outer_names), cast(Vec[i64], cells))
				}
				ci = ci + 1
			}
		}
	} else if k == ST_RETURN {
		scan_idents_in_expr(cast(ReturnStmt, s).value, inner_params, outer_names, cells)
		let vals = cast(ReturnStmt, s).values
		if cast(i64, vals) != 0 {
			mut i = 0
			for i < vals.len {
				scan_idents_in_expr(vec_get(vals, i), inner_params, outer_names, cells)
				i = i + 1
			}
		}
	} else if k == ST_DEFER || k == ST_GO {
		scan_idents_in_expr(cast(GoStmt, s).call, inner_params, outer_names, cells)
	} else if k == ST_FAIL {
		scan_idents_in_expr(cast(FailStmt, s).x, inner_params, outer_names, cells)
	} else if k == ST_CALLMULTI {
		scan_idents_in_expr(cast(CallMultiStmt, s).call, inner_params, outer_names, cells)
	} else if k == ST_BLOCK {
		scan_idents_in_block(cast(Block, s), cast(Vec[i64], inner_params), cast(Vec[i64], outer_names), cast(Vec[i64], cells))
	} else if k == ST_SCOPE {
		scan_idents_in_block(cast(Block, cast(ScopeStmt, s).body), cast(Vec[i64], inner_params), cast(Vec[i64], outer_names), cast(Vec[i64], cells))
	} else if k == ST_DETACH {
		scan_funclit_escaping_idents(cast(Fn, detach_fn(s)), cast(Vec[i64], outer_names), cast(Vec[i64], cells))
	} else if k == ST_LIST {
		let stmts = cast(ListStmt, s).stmts
		mut i = 0
		for i < stmts.len {
			scan_idents_in_stmt(vec_get(stmts, i), inner_params, outer_names, cells)
			i = i + 1
		}
	}
}

fn scan_idents_in_expr(e i64, inner_params Vec[i64], outer_names Vec[i64], cells Vec[i64]) {
	if e == 0 {
		return
	}
	let k = cast(Node, e).kind
	if k == EX_IDENT {
		let name = cast(IdentExpr, e).name
		if vec_has_str(inner_params, name) == 0 && vec_has_str(outer_names, name) != 0 {
			if vec_has_str(cells, name) == 0 {
				vec_push(cells, name)
			}
		}
	} else if k == EX_CALL {
		scan_idents_in_expr(cast(Call, e).callee, inner_params, outer_names, cells)
		let args = cast(Call, e).args
		if cast(i64, args) != 0 {
			mut i = 0
			for i < args.len {
				scan_idents_in_expr(vec_get(args, i), inner_params, outer_names, cells)
				i = i + 1
			}
		}
	} else if k == EX_BINARY {
		scan_idents_in_expr(cast(Binary, e).l, inner_params, outer_names, cells)
		scan_idents_in_expr(cast(Binary, e).r, inner_params, outer_names, cells)
	} else if k == EX_UNARY {
		scan_idents_in_expr(cast(Unary, e).x, inner_params, outer_names, cells)
	} else if k == EX_SELECT {
		scan_idents_in_expr(cast(SelectExpr, e).x, inner_params, outer_names, cells)
	} else if k == EX_INDEX {
		scan_idents_in_expr(cast(IndexExpr, e).x, inner_params, outer_names, cells)
		scan_idents_in_expr(cast(IndexExpr, e).i, inner_params, outer_names, cells)
	} else if k == EX_CONV {
		scan_idents_in_expr(cast(Conv, e).x, inner_params, outer_names, cells)
	} else if k == EX_MUTARG {
		scan_idents_in_expr(cast(MutArg, e).x, inner_params, outer_names, cells)
	} else if k == EX_SLICE {
		scan_idents_in_expr(cast(SliceExpr, e).x, inner_params, outer_names, cells)
		scan_idents_in_expr(cast(SliceExpr, e).lo, inner_params, outer_names, cells)
		scan_idents_in_expr(cast(SliceExpr, e).hi, inner_params, outer_names, cells)
	} else if k == EX_TRY {
		scan_idents_in_expr(cast(TryExpr, e).x, inner_params, outer_names, cells)
	} else if k == EX_WRAP {
		scan_idents_in_expr(cast(WrapExpr, e).x, inner_params, outer_names, cells)
		scan_idents_in_expr(cast(WrapExpr, e).message, inner_params, outer_names, cells)
	} else if k == EX_CATCH {
		scan_idents_in_expr(cast(CatchExpr, e).x, inner_params, outer_names, cells)
		scan_idents_in_block(cast(Block, cast(CatchExpr, e).body), cast(Vec[i64], inner_params), cast(Vec[i64], outer_names), cast(Vec[i64], cells))
	} else if k == EX_INTERP {
		let ia = cast(InterpExpr, e).args
		if cast(i64, ia) != 0 {
			mut ii = 0
			for ii < ia.len {
				scan_idents_in_expr(vec_get(ia, ii), inner_params, outer_names, cells)
				ii = ii + 1
			}
		}
	} else if k == EX_COMPOSITE {
		let elems = cast(Composite, e).elems
		if cast(i64, elems) != 0 {
			mut i = 0
			for i < elems.len {
				scan_idents_in_expr(vec_get(elems, i), inner_params, outer_names, cells)
				i = i + 1
			}
		}
	} else if k == EX_FUNCLIT {
		scan_funclit_escaping_idents(cast(Fn, cast(FuncLit, e).fn_), cast(Vec[i64], outer_names), cast(Vec[i64], cells))
	} else if k == EX_BOUNDARY {
		if cast(BoundaryStmt, e).kind == BOUND_WITH {
			// The policy is evaluated where the with is (#237).
			scan_idents_in_expr(vec_get(cast(BoundaryStmt, e).args, 0), inner_params, outer_names, cells)
		}
		scan_idents_in_block(cast(Block, cast(BoundaryStmt, e).body), cast(Vec[i64], inner_params), cast(Vec[i64], outer_names), cast(Vec[i64], cells))
	} else if k == EX_MATCH {
		scan_idents_in_expr(cast(MatchExpr, e).subject, inner_params, outer_names, cells)
		let arms = cast(MatchExpr, e).arms
		mut ai = 0
		for ai < arms.len {
			let arm = cast(Vec[i64], vec_get(arms, ai))
			scan_idents_in_expr(cast(MatchArm, arm).guard_, inner_params, outer_names, cells)
			if cast(MatchArm, arm).block != 0 {
				scan_idents_in_block(cast(Block, cast(MatchArm, arm).body), cast(Vec[i64], inner_params), cast(Vec[i64], outer_names), cast(Vec[i64], cells))
			} else {
				scan_idents_in_expr(cast(MatchArm, arm).body, inner_params, outer_names, cells)
			}
			ai = ai + 1
		}
	}
}

fn scan_captures(f Fn, cells i64) {
	if cast(i64, f) == 0 || f.body == 0 {
		return
	}
	let outer_names = vec_new[i64]()
	mut i = 0
	for i < cast(Vec[i64], f.params).len {
		vec_push(outer_names, vec_get(cast(Vec[i64], f.params), i))
		i = i + 1
	}
	collect_local_decls(cast(Block, f.body).stmts, cast(Vec[i64], outer_names))
	scan_funclits_in_block(cast(Block, f.body), cast(i64, outer_names), cells)
}

fn scan_funclits_in_block(b Block, outer_names i64, cells i64) {
	if cast(i64, b) == 0 || cast(i64, b.stmts) == 0 {
		return
	}
	let stmts = cast(Vec[i64], b.stmts)
	mut i = 0
	for i < stmts.len {
		scan_funclits_in_stmt(vec_get(stmts, i), outer_names, cast(Vec[i64], cells))
		i = i + 1
	}
}

fn scan_funclits_in_stmt(s i64, outer_names i64, cells Vec[i64]) {
	if s == 0 {
		return
	}
	let k = cast(Node, s).kind
	if k == ST_LET {
		scan_funclits_in_expr(cast(LetStmt, s).init, outer_names, cells)
	} else if k == ST_USE {
		scan_funclits_in_expr(cast(UseStmt, s).init, outer_names, cells)
	} else if k == ST_ASSIGN {
		scan_funclits_in_expr(cast(AssignStmt, s).target, outer_names, cells)
		scan_funclits_in_expr(cast(AssignStmt, s).value, outer_names, cells)
	} else if k == ST_MULTI {
		let vals = cast(MultiStmt, s).values
		if cast(i64, vals) != 0 {
			mut i = 0
			for i < vals.len {
				scan_funclits_in_expr(vec_get(vals, i), outer_names, cells)
				i = i + 1
			}
		}
	} else if k == ST_EXPR {
		scan_funclits_in_expr(cast(ExprStmt, s).x, outer_names, cells)
	} else if k == ST_IF {
		if cast(IfStmt, s).init != 0 {
			scan_funclits_in_stmt(cast(IfStmt, s).init, outer_names, cells)
		}
		scan_funclits_in_expr(cast(IfStmt, s).cond, outer_names, cells)
		scan_funclits_in_block(cast(Block, cast(IfStmt, s).then), outer_names, cast(i64, cells))
		if cast(IfStmt, s).else_ != 0 {
			if cast(Node, cast(IfStmt, s).else_).kind == ST_BLOCK {
				scan_funclits_in_block(cast(Block, cast(IfStmt, s).else_), outer_names, cast(i64, cells))
			} else {
				scan_funclits_in_stmt(cast(IfStmt, s).else_, outer_names, cells)
			}
		}
	} else if k == ST_WHILE {
		if cast(WhileStmt, s).init != 0 {
			scan_funclits_in_stmt(cast(WhileStmt, s).init, outer_names, cells)
		}
		scan_funclits_in_expr(cast(WhileStmt, s).cond, outer_names, cells)
		scan_funclits_in_block(cast(Block, cast(WhileStmt, s).body), outer_names, cast(i64, cells))
		scan_funclits_in_stmt(cast(WhileStmt, s).post, outer_names, cells)
	} else if k == ST_RANGE {
		scan_funclits_in_expr(cast(RangeStmt, s).expr, outer_names, cells)
		scan_funclits_in_block(cast(Block, cast(RangeStmt, s).body), outer_names, cast(i64, cells))
	} else if k == ST_SWITCH {
		if cast(SwitchStmt, s).init != 0 {
			scan_funclits_in_stmt(cast(SwitchStmt, s).init, outer_names, cells)
		}
		if cast(SwitchStmt, s).tag != 0 {
			scan_funclits_in_expr(cast(SwitchStmt, s).tag, outer_names, cells)
		}
		let cases = cast(SwitchStmt, s).cases
		if cast(i64, cases) != 0 {
			mut ci = 0
			for ci < cases.len {
				let c = cast(Vec[i64], vec_get(cases, ci))
				let exprs = cast(Vec[i64], vec_get(c, 0))
				if cast(i64, exprs) != 0 {
					mut j = 0
					for j < exprs.len {
						scan_funclits_in_expr(vec_get(exprs, j), outer_names, cells)
						j = j + 1
					}
				}
				let body = vec_get(c, 1)
				if body != 0 {
					scan_funclits_in_block(cast(Block, body), outer_names, cast(i64, cells))
				}
				ci = ci + 1
			}
		}
	} else if k == ST_RETURN {
		scan_funclits_in_expr(cast(ReturnStmt, s).value, outer_names, cells)
		let vals = cast(ReturnStmt, s).values
		if cast(i64, vals) != 0 {
			mut i = 0
			for i < vals.len {
				scan_funclits_in_expr(vec_get(vals, i), outer_names, cells)
				i = i + 1
			}
		}
	} else if k == ST_DEFER || k == ST_GO {
		scan_funclits_in_expr(cast(GoStmt, s).call, outer_names, cells)
	} else if k == ST_FAIL {
		scan_funclits_in_expr(cast(FailStmt, s).x, outer_names, cells)
	} else if k == ST_CALLMULTI {
		scan_funclits_in_expr(cast(CallMultiStmt, s).call, outer_names, cells)
	} else if k == ST_BLOCK {
		scan_funclits_in_block(cast(Block, s), outer_names, cast(i64, cells))
	} else if k == ST_SCOPE {
		scan_funclits_in_block(cast(Block, cast(ScopeStmt, s).body), outer_names, cast(i64, cells))
	} else if k == ST_DETACH {
		scan_funclit_escaping_idents(cast(Fn, detach_fn(s)), cast(Vec[i64], outer_names), cells)
	} else if k == ST_LIST {
		let stmts = cast(ListStmt, s).stmts
		mut i = 0
		for i < stmts.len {
			scan_funclits_in_stmt(vec_get(stmts, i), outer_names, cells)
			i = i + 1
		}
	}
}

fn scan_funclits_in_expr(e i64, outer_names i64, cells Vec[i64]) {
	if e == 0 {
		return
	}
	let k = cast(Node, e).kind
	if k == EX_FUNCLIT {
		if cast(FuncLit, e).escape != 0 {
			scan_funclit_escaping_idents(cast(Fn, cast(FuncLit, e).fn_), cast(Vec[i64], outer_names), cells)
		}
	} else if k == EX_CALL {
		scan_funclits_in_expr(cast(Call, e).callee, outer_names, cells)
		let args = cast(Call, e).args
		if cast(i64, args) != 0 {
			mut i = 0
			for i < args.len {
				scan_funclits_in_expr(vec_get(args, i), outer_names, cells)
				i = i + 1
			}
		}
	} else if k == EX_BINARY {
		scan_funclits_in_expr(cast(Binary, e).l, outer_names, cells)
		scan_funclits_in_expr(cast(Binary, e).r, outer_names, cells)
	} else if k == EX_UNARY {
		scan_funclits_in_expr(cast(Unary, e).x, outer_names, cells)
	} else if k == EX_SELECT {
		scan_funclits_in_expr(cast(SelectExpr, e).x, outer_names, cells)
	} else if k == EX_INDEX {
		scan_funclits_in_expr(cast(IndexExpr, e).x, outer_names, cells)
		scan_funclits_in_expr(cast(IndexExpr, e).i, outer_names, cells)
	} else if k == EX_CONV {
		scan_funclits_in_expr(cast(Conv, e).x, outer_names, cells)
	} else if k == EX_MUTARG {
		scan_funclits_in_expr(cast(MutArg, e).x, outer_names, cells)
	} else if k == EX_SLICE {
		scan_funclits_in_expr(cast(SliceExpr, e).x, outer_names, cells)
		scan_funclits_in_expr(cast(SliceExpr, e).lo, outer_names, cells)
		scan_funclits_in_expr(cast(SliceExpr, e).hi, outer_names, cells)
	} else if k == EX_TRY {
		scan_funclits_in_expr(cast(TryExpr, e).x, outer_names, cells)
	} else if k == EX_WRAP {
		scan_funclits_in_expr(cast(WrapExpr, e).x, outer_names, cells)
		scan_funclits_in_expr(cast(WrapExpr, e).message, outer_names, cells)
	} else if k == EX_CATCH {
		scan_funclits_in_expr(cast(CatchExpr, e).x, outer_names, cells)
		scan_funclits_in_block(cast(Block, cast(CatchExpr, e).body), outer_names, cast(i64, cells))
	} else if k == EX_BOUNDARY {
		if cast(BoundaryStmt, e).kind == BOUND_WITH {
			scan_funclits_in_expr(vec_get(cast(BoundaryStmt, e).args, 0), outer_names, cells)
		}
		scan_funclits_in_block(cast(Block, cast(BoundaryStmt, e).body), outer_names, cast(i64, cells))
	} else if k == EX_MATCH {
		scan_funclits_in_expr(cast(MatchExpr, e).subject, outer_names, cells)
		let arms = cast(MatchExpr, e).arms
		mut ai = 0
		for ai < arms.len {
			let arm = cast(Vec[i64], vec_get(arms, ai))
			scan_funclits_in_expr(cast(MatchArm, arm).guard_, outer_names, cells)
			if cast(MatchArm, arm).block != 0 {
				scan_funclits_in_block(cast(Block, cast(MatchArm, arm).body), outer_names, cast(i64, cells))
			} else {
				scan_funclits_in_expr(cast(MatchArm, arm).body, outer_names, cells)
			}
			ai = ai + 1
		}
	} else if k == EX_INTERP {
		let ia = cast(InterpExpr, e).args
		if cast(i64, ia) != 0 {
			mut ii = 0
			for ii < ia.len {
				scan_funclits_in_expr(vec_get(ia, ii), outer_names, cells)
				ii = ii + 1
			}
		}
	} else if k == EX_COMPOSITE {
		let elems = cast(Composite, e).elems
		if cast(i64, elems) != 0 {
			mut i = 0
			for i < elems.len {
				scan_funclits_in_expr(vec_get(elems, i), outer_names, cells)
				i = i + 1
			}
		}
	}
}

fn check_fn_closure(f i64) {
	let saved_file = ck_file
	let saved_fn = ck_fn
	let saved_tbind = ck_tbind
	let saved_loops = ck_loops
	let saved_breaks = ck_breaks
	let saved_labels = ck_labels
	let saved_defers = ck_defers
	let saved_mark = ck_defer_mark
	let saved_syms = vec_clone(sc_syms)
	let saved_marks = vec_clone(sc_marks)
	let saved_safe = safe_pairs
	let saved_len_aliases = len_aliases
	let saved_cells = ck_escaping_cells
	let saved_depth = ck_scope_depth
	let saved_base = ck_fn_base
	// A closure's own variables (and its parameters, which a caller may fill with handles of
	// scopes the closure never sees) count as deeper than anything it captures (#232).
	ck_scope_depth = ck_scope_depth + 65536
	ck_fn_base = ck_scope_depth

	check_fn(cast(Fn, f))

	set_file(saved_file)
	ck_fn = saved_fn
	ck_tbind = saved_tbind
	ck_loops = saved_loops
	ck_breaks = saved_breaks
	ck_labels = saved_labels
	ck_defers = saved_defers
	ck_defer_mark = saved_mark
	sc_syms = cast(Vec[Sym], cast(Vec[i64], saved_syms))
	sc_marks = cast(Vec[i64], saved_marks)
	safe_pairs = saved_safe
	len_aliases = saved_len_aliases
	ck_escaping_cells = saved_cells
	ck_scope_depth = saved_depth
	ck_fn_base = saved_base
}

fn check_fn(f Fn) {
	set_file(f.file)
	if f.parent == 0 {
		ck_scope_depth = 0
		ck_fn_base = 0
	}
	ck_tbind = cast(Vec[i64], f.tbind)
	ck_fn = cast(Fn, f)
	ck_loops = 0
	ck_breaks = 0
	ck_labels = vec_new[i64]()
	ck_escaping_cells = vec_new[i64]()
	len_aliases = vec_new[i64]()
	if f.body != 0 {
		mark_spawns(cast(Block, f.body).stmts, cast(Vec[i64], sb_scope_params(f)))
		scan_captures(f, cast(i64, ck_escaping_cells))
	}
	start_scope()
	f.slots = 0
	f.locals = cast(Vec[Sym], vec_new[i64]())
	let params = cast(Vec[i64], f.params)
	mut i = 0
	ck_params_only = 1
	for i < params.len {
		let ps = cast(Sym, declare_local(f.pos, vec_get(params, i), vec_get(cast(Vec[i64], f.ptypes), i)))
		ps.reads = 1
		secret_lib_param(ps)
		if f.muts != 0 && i < cast(Vec[i64], f.muts).len {
			ps.mut_ = vec_get(cast(Vec[i64], f.muts), i)
			if ps.mut_ != 0 && mut_capable(vec_get(cast(Vec[i64], f.ptypes), i)) == 0 {
				err_code_type(f.pos, cstr("E702 MUT_VALUE_PARAM"), str_cat3(cstr("parameter '"), vec_get(params, i), cstr("' is mut, but a value of type ")), vec_get(cast(Vec[i64], f.ptypes), i), cstr(" is passed by value: only structs, slices and maps can be modified through a parameter, so remove mut"))
			}
		}
		i = i + 1
	}
	ck_params_only = 0
	i = 0
	for i < params.len {
		let pn = vec_get(params, i)
		if cast(i64, ck_escaping_cells) != 0 && vec_has_str(ck_escaping_cells, pn) != 0 {
			give_cell(cast(Sym, vec_get(cast(Vec[i64], f.locals), i)), f.pos, pn)
		}
		i = i + 1
	}
	if f.parent != 0 {
		let env_sym = cast(Sym, declare_local(f.pos, cstr("$env"), ty_int))
		env_sym.reads = 1
		f.env_sym = cast(i64, env_sym)
	}
	let cell_inits = vec_new[i64]()
	i = 0
	for i < params.len {
		let ps = cast(Sym, vec_get(cast(Vec[i64], f.locals), i))
		if ps.cell != 0 {
			let alloc_call = rt_call(f.pos, cstr("rt_alloc"), args1(mk_int(f.pos, 8, ty_int)), ty_int)
			let let_cell = let_stmt(f.pos, cast(Sym, cast(Sym, ps).cell_sym), alloc_call)
			let store_cell = assign_stmt(f.pos, mk_mem(f.pos, sym_ref_node(f.pos, cast(Sym, cast(Sym, ps).cell_sym)), 0, 0, 0, ps.type_), sym_ref_node(f.pos, cast(Sym, ps)))
			vec_push(cell_inits, let_cell)
			vec_push(cell_inits, store_cell)
		}
		i = i + 1
	}
	// The body shares the parameters' scope, so `let x` cannot silently hide parameter x.
	ck_defers = cast(Vec[i64], 0)
	ck_defer_mark = 0
	check_stmts(cast(Block, f.body).stmts)
	// Captured parameters move into their cells first. These statements are already typed:
	// checking them would declare a second $cell_ local, so they go in after the body is checked.
	if cell_inits.len > 0 {
		let new_stmts = vec_new[i64]()
		i = 0
		for i < cell_inits.len {
			vec_push(new_stmts, vec_get(cell_inits, i))
			i = i + 1
		}
		i = 0
		let old_stmts = cast(Block, f.body).stmts
		for i < old_stmts.len {
			vec_push(new_stmts, vec_get(old_stmts, i))
			i = i + 1
		}
		cast(Block, f.body).stmts = cast(Vec[i64], new_stmts)
	}
	if f.bang != 0 && cast(Vec[i64], f.rtypes).len == 1 && ends_in_return(cast(Block, f.body).stmts) == 0 {
		// A ! function that runs off its end succeeds.
		let r = cast(ReturnStmt, node_new(ST_RETURN, f.pos))
		r.value = mk_int(f.pos, 0, ty_error)
		vec_push(cast(Block, f.body).stmts, cast(i64, r))
	}
	if cast(i64, ck_defers) != 0 {
		finish_defers(f)
		ck_defers = cast(Vec[i64], 0)
		ck_defer_mark = 0
	}
	if cast(Vec[i64], f.rtypes).len > 0 && ends_in_return(cast(Block, f.body).stmts) == 0 {
		err_code_quoted(f.pos, cstr("E260 MISSING_RETURN"), cstr("function "), f.name, cstr(" is missing a return at the end"))
	}
	// A fault that is assigned but never looked at is an ignored error.
	let locals = cast(Vec[i64], f.locals)
	i = 0
	for i < locals.len {
		let l = cast(Sym, vec_get(locals, i))
		if kind_of(cast(Ty, l.type_)) == K_ERROR && cast(Sym, l).reads == 0 && i64(load8(l.name)) != '$' {
			err_code_quoted(l.pos, cstr("E410 UNCHECKED_FAULT"), cstr("fault "), l.name, cstr(" is never checked"))
		}
		i = i + 1
	}
}

// ends_in_return is Go's terminating-statement rule, simplified.
fn ends_in_return(stmts Vec[i64]) i64 {
	if stmts.len == 0 {
		return 0
	}
	let s = vec_get(stmts, stmts.len - 1)
	let k = cast(Node, s).kind
	if k == ST_RETURN {
		return 1
	}
	if k == ST_EXPR && cast(Node, cast(ExprStmt, s).x).kind == EX_CALL && cast(Call, cast(ExprStmt, s).x).name != 0 && (streq(cast(Call, cast(ExprStmt, s).x).name, cstr("panic")) != 0 || streq(cast(Call, cast(ExprStmt, s).x).name, cstr("rt_panic")) != 0) {
		return 1
	}
	if k == ST_BLOCK {
		return ends_in_return(cast(Block, s).stmts)
	}
	if k == ST_IF {
		if cast(IfStmt, s).else_ == 0 || ends_in_return(cast(Block, cast(IfStmt, s).then).stmts) == 0 {
			return 0
		}
		let one = vec_new[i64]()
		vec_push(one, cast(IfStmt, s).else_)
		return ends_in_return(cast(Vec[i64], one))
	}
	if k == ST_WHILE {
		return i64(cast(WhileStmt, s).once_ == 0 && is_true_lit(cast(WhileStmt, s).cond) != 0 && has_break(cast(Block, cast(WhileStmt, s).body).stmts) == 0)
	}
	return 0
}

fn is_true_lit(e i64) i64 {
	return i64(cast(Node, e).kind == EX_INT && cast(IntLit, e).val != 0)
}

fn has_break(stmts Vec[i64]) i64 {
	mut i = 0
	for i < stmts.len {
		let s = vec_get(stmts, i)
		let k = cast(Node, s).kind
		if k == ST_BREAK {
			return 1
		}
		if k == ST_BLOCK && has_break(cast(Block, s).stmts) != 0 {
			return 1
		}
		if k == ST_IF {
			if has_break(cast(Block, cast(IfStmt, s).then).stmts) != 0 {
				return 1
			}
			if cast(IfStmt, s).else_ != 0 {
				let one = vec_new[i64]()
				vec_push(one, cast(IfStmt, s).else_)
				if has_break(cast(Vec[i64], one)) != 0 {
					return 1
				}
			}
		}
		i = i + 1
	}
	return 0
}

fn declare_scoped(s Sym) {
	let pos = s.pos
	let name = s.name
	let start = vec_get(sc_marks, sc_marks.len - 1)
	if i64(load8(name)) != '$' {
		mut i = sc_syms.len - 1
		for i >= start {
			let prev = vec_get(sc_syms, i)
			if streq(prev.name, name) != 0 {
				let e = err_code(pos, cstr("E101 REDECLARED"))
				buf_byte(e, '\'')
				buf_str(e, name)
				buf_str(e, cstr("' redeclared in this scope (previous declaration at "))
				buf_pos(e, prev.pos)
				buf_byte(e, ')')
				err_end(cast(Buf, e))
				break
			}
			i = i - 1
		}
	}
	vec_push(sc_syms, cast(Sym, s))
}

fn declare_local(pos i64, name i64, t i64) i64 {
	let s = sym_new(SYM_LOCAL, name, pos)
	s.type_ = t
	s.scope_at = ck_scope_depth
	declare_scoped(s)
	s.slot = cast(Fn, ck_fn).slots
	cast(Fn, ck_fn).slots = cast(Fn, ck_fn).slots + 1
	vec_push(cast(Fn, ck_fn).locals, cast(Sym, s))
	if cast(i64, ck_escaping_cells) != 0 && vec_has_str(ck_escaping_cells, name) != 0 && ck_params_only == 0 {
		give_cell(s, pos, name)
	}
	return cast(i64, s)
}

shared mut ck_params_only i64 // declaring parameters: their cells come after all of them (locals 0..n-1 are the parameters)

// give_cell makes local s a cell: a hidden local holds the address of its pool word.
fn give_cell(s Sym, pos i64, name i64) {
	if cast(i64, s) != 0 {
		s.cell = 1
		let csym = sym_new(SYM_LOCAL, str_cat3(cstr("$cell_"), name, cstr("")), pos)
		csym.type_ = ty_int
		csym.reads = 1
		csym.slot = cast(Fn, ck_fn).slots
		cast(Fn, ck_fn).slots = cast(Fn, ck_fn).slots + 1
		vec_push(cast(Fn, ck_fn).locals, cast(Sym, csym))
		s.cell_sym = cast(i64, csym)
		csym.cell_of = cast(i64, s)
	}
}

fn in_current_scope(name i64) i64 {
	let start = vec_get(sc_marks, sc_marks.len - 1)
	mut i = sc_syms.len - 1
	for i >= start {
		let s = vec_get(sc_syms, i)
		if streq(s.name, name) != 0 {
			return cast(i64, s)
		}
		i = i - 1
	}
	return 0
}

fn vec_has_str(v Vec[i64], s i64) i64 {
	if cast(i64, v) == 0 {
		return 0
	}
	mut i = 0
	for i < v.len {
		if streq(vec_get(v, i), s) != 0 {
			return 1
		}
		i = i + 1
	}
	return 0
}

fn lookup_outer(f Fn, name i64) i64 {
	let p = f.parent
	if p == 0 {
		return 0
	}
	let syms = cast(Vec[i64], f.outer_syms)
	if cast(i64, syms) != 0 {
		mut i = syms.len - 1
		for i >= 0 {
			let s = cast(Sym, vec_get(syms, i))
			if streq(s.name, name) != 0 {
				return cast(i64, s)
			}
			i = i - 1
		}
	}
	if cast(Fn, p).parent != 0 {
		let os = lookup_outer(cast(Fn, p), name)
		if os != 0 {
			return capture_sym(cast(Fn, p), cast(Sym, os))
		}
	}
	return 0
}

fn capture_sym(f Fn, os Sym) i64 {
	let caps = cast(Vec[i64], f.captures)
	mut ci = -1
	mut i = 0
	for i < caps.len {
		if cast(Sym, vec_get(caps, i)) == os {
			ci = i
			break
		}
		i = i + 1
	}
	if ci < 0 {
		if os.mut_ != 0 {
			err_code_at(f.pos, cstr("E703 CAPTURE_MUT"), str_cat3(cstr("a function literal cannot capture the mut parameter '"), os.name, cstr("': copy it into a local first, or pass it as an argument")))
		}
		ci = caps.len
		vec_push(caps, cast(i64, os))
		os.addr = 1
		if f.escapes != 0 {
			os.cell = 1
			os.kept_cap = 1
		}
	}
	if cast(Fn, f) == ck_fn {
		mut j = sc_syms.len - 1
		for j >= 0 {
			let s = vec_get(sc_syms, j)
			if s.captured != 0 && s.cap_idx == ci {
				return cast(i64, s)
			}
			j = j - 1
		}
		let cs = sym_new(SYM_LOCAL, os.name, os.pos)
		cs.type_ = os.type_
		cs.captured = 1
		cs.cap_idx = ci
		cs.reads = 1
		cs.scope_at = os.scope_at
		vec_push(sc_syms, cast(Sym, cs))
		return cast(i64, cs)
	}
	let cs = sym_new(SYM_LOCAL, os.name, os.pos)
	cs.type_ = os.type_
	cs.captured = 1
	cs.cap_idx = ci
	cs.reads = 1
	cs.scope_at = os.scope_at
	return cast(i64, cs)
}

// lookup_name searches the open scopes innermost first, then outer closures, then this package, then the universe.
fn lookup_name(name i64) Sym {
	mut i = sc_syms.len - 1
	for i >= 0 {
		let s = vec_get(sc_syms, i)
		if streq(s.name, name) != 0 {
			return cast(Sym, s)
		}
		i = i - 1
	}
	if cast(i64, ck_fn) != 0 && cast(Fn, ck_fn).parent != 0 {
		let os = lookup_outer(cast(Fn, ck_fn), name)
		if os != 0 {
			return cast(Sym, capture_sym(cast(Fn, ck_fn), cast(Sym, os)))
		}
	}
	if i64(load8(ck_pkg)) != 0 {
		let q = lookup_global(qual(ck_pkg, name))
		if cast(i64, q) != 0 {
			return q
		}
	}
	return lookup_global(name)
}

fn push_scope() {
	vec_push(sc_marks, sc_syms.len)
}

fn pop_scope() {
	sc_syms.len = vec_get(sc_marks, sc_marks.len - 1)
	sc_marks.len = sc_marks.len - 1
}

fn check_scoped(b Block) {
	push_scope()
	check_stmts(cast(Vec[i64], b.stmts))
	pop_scope()
}

fn check_stmts(stmts Vec[i64]) {
	let narrowed = vec_new[i64]()
	mut i = 0
	for i < stmts.len {
		let s = vec_get(stmts, i)
		check_stmt(s)
		// if x == nil { return } narrows x to non-nil for the rest of the block.
		if cast(Node, s).kind == ST_IF && cast(IfStmt, s).else_ == 0 && ends_in_jump(cast(Vec[Node], cast(Block, cast(IfStmt, s).then).stmts)) != 0 {
			let nw = narrow_begin(cast(IfStmt, s).cond, 0)
			if cast(i64, nw) != 0 {
				vec_push(narrowed, cast(i64, nw))
			}
		}
		i = i + 1
	}
	i = narrowed.len - 1
	for i >= 0 {
		narrow_end(cast(Vec[Sym], cast(Vec[i64], vec_get(narrowed, i))))
		i = i - 1
	}
}

// ends_in_jump reports whether a block always leaves: return, break, continue, panic.
fn ends_in_jump(stmts Vec[Node]) i64 {
	if stmts.len == 0 {
		return 0
	}
	let last = vec_get(stmts, stmts.len - 1)
	let k = last.kind
	return i64(k == ST_RETURN || k == ST_BREAK || k == ST_CONTINUE || k == ST_FAIL || ends_in_return(cast(Vec[i64], stmts)) != 0)
}

fn replace_node(e i64, n i64) {
	mut i = 0
	for i < N_SIZE {
		e[i] = n[i]
		i = i + 1
	}
}

fn expr_clone(e i64) i64 {
	if e == 0 {
		return 0
	}
	let c = node_new(cast(Node, e).kind, cast(Node, e).pos)
	replace_node(c, e)
	let k = cast(Node, e).kind
	if k == EX_UNARY {
		cast(Unary, c).x = expr_clone(cast(Unary, e).x)
	} else if k == EX_BINARY {
		cast(Binary, c).l = expr_clone(cast(Binary, e).l)
		cast(Binary, c).r = expr_clone(cast(Binary, e).r)
	} else if k == EX_INDEX {
		cast(IndexExpr, c).x = expr_clone(cast(IndexExpr, e).x)
		cast(IndexExpr, c).i = expr_clone(cast(IndexExpr, e).i)
	} else if k == EX_CONV {
		cast(Conv, c).x = expr_clone(cast(Conv, e).x)
	} else if k == EX_CALL {
		let args = vec_new[i64]()
		mut i = 0
		for i < cast(Call, e).args.len {
			vec_push(args, expr_clone(vec_get(cast(Call, e).args, i)))
			i = i + 1
		}
		cast(Call, c).args = cast(Vec[i64], args)
		cast(Call, c).callee = expr_clone(cast(Call, e).callee)
	} else if k == EX_SELECT {
		cast(SelectExpr, c).x = expr_clone(cast(SelectExpr, e).x)
	}
	return c
}

fn mk_int(pos i64, v i64, t i64) i64 {
	let n = node_new(EX_INT, pos)
	cast(IntLit, n).val = v
	cast(Node, n).type_ = t
	return n
}

fn mk_bin(pos i64, op i64, l i64, r i64, t i64) i64 {
	let b = cast(Node, binary_new(pos, op, l, r))
	b.type_ = t
	return cast(i64, b)
}

fn mk_index(pos i64, x i64, i i64, t i64) i64 {
	let n = node_new(EX_INDEX, pos)
	cast(IndexExpr, n).x = x
	cast(IndexExpr, n).i = i
	cast(Node, n).type_ = t
	return n
}

// mk_hdr loads word k of a string, slice or map header (all are non-nil).
fn mk_hdr(pos i64, x i64, k i64) i64 {
	let n = node_new(EX_MEM, pos)
	cast(MemExpr, n).base = x
	cast(MemExpr, n).off = 8 * k
	cast(MemExpr, n).hdr = 1
	cast(Node, n).type_ = ty_int
	return n
}

fn mk_conv(pos i64, x i64, kind i64, t i64) i64 {
	let n = node_new(EX_CONV, pos)
	cast(Conv, n).x = x
	cast(Conv, n).kind = kind
	cast(Node, n).type_ = t
	return n
}

const CV_SAME = 8 // retype only: same bits
const CV_ROUND32 = 10 // f64 value rounded to the nearest f32 (still in an f64 register)
const CV_F2BITS32 = 11 // f32 value (in an f64 register) to its 32-bit pattern
const CV_INT = 9 // integer to integer: truncate or extend to the target width
const CV_I2F = 1
const CV_F2I = 2
const CV_BITS2F = 3
const CV_F2BITS = 4
const CV_TOBYTE = 5
const CV_LEN = 6 // null-safe header word 0 (len of string, slice, map)
const CV_CAP = 7 // null-safe header word 1
const CV_DYN = 12 // concrete struct reference plus its (type, shape) table
const CV_DYN_KEEP = 13 // call the table's keep entry and preserve its table word
const CV_DYN_OBJECT = 14 // the object word of a checked dyn value
const CV_DYN_DESC = 15 // a method descriptor loaded from a dyn value's table
const CV_DYN_TABLE_WORD = 16 // the table word of a checked dyn value

fn intrinsic_call(pos i64, name i64, args i64, t i64) i64 {
	let c = node_new(EX_CALL, pos)
	cast(Call, c).name = name
	cast(Call, c).args = cast(Vec[i64], args)
	cast(Call, c).intrinsic = 1
	cast(Node, c).type_ = t
	return c
}

fn args1(a i64) i64 {
	let v = vec_new[i64]()
	vec_push(v, a)
	return cast(i64, v)
}

fn args2(a i64, b i64) i64 {
	let v = cast(Vec[i64], args1(a))
	vec_push(v, b)
	return cast(i64, v)
}

fn args3(a i64, b i64, c i64) i64 {
	let v = cast(Vec[i64], args2(a, b))
	vec_push(v, c)
	return cast(i64, v)
}

fn args4(a i64, b i64, c i64, d i64) i64 {
	let v = cast(Vec[i64], args3(a, b, c))
	vec_push(v, d)
	return cast(i64, v)
}

fn args5(a i64, b i64, c i64, d i64, f i64) i64 {
	let v = cast(Vec[i64], args4(a, b, c, d))
	vec_push(v, f)
	return cast(i64, v)
}

fn mk_load8(pos i64, addr i64) i64 {
	return intrinsic_call(pos, cstr("load8"), args1(addr), ty_byte)
}

// rt_call calls a runtime function by name; the runtime is loaded for every program.
fn rt_call(pos i64, name i64, args i64, t i64) i64 {
	let f = find_fn(name)
	if cast(i64, f) == 0 {
		err_code_quoted(pos, cstr("E990 INTERNAL"), cstr("runtime function "), name, cstr(" is missing (is lib/runtime.tin loaded?)"))
	}
	let c = node_new(EX_CALL, pos)
	cast(Call, c).name = name
	cast(Call, c).args = cast(Vec[i64], args)
	cast(Call, c).fn_ = cast(i64, f)
	cast(Node, c).type_ = t
	return c
}

fn sym_ref_node(pos i64, s Sym) i64 {
	let n = node_new(EX_IDENT, pos)
	cast(IdentExpr, n).name = s.name
	cast(IdentExpr, n).ref = cast(i64, s)
	cast(Node, n).type_ = s.type_
	return n
}

fn expr_stmt(e Node) i64 {
	let s = cast(ExprStmt, node_new(ST_EXPR, e.pos))
	s.x = cast(i64, e)
	return cast(i64, s)
}

fn let_stmt(pos i64, s Sym, init i64) i64 {
	let l = cast(LetStmt, node_new(ST_LET, pos))
	l.name = s.name
	l.init = init
	l.sym = cast(i64, s)
	return cast(i64, l)
}

fn assign_stmt(pos i64, target i64, value i64) i64 {
	let a = cast(AssignStmt, node_new(ST_ASSIGN, pos))
	a.target = target
	a.value = value
	return cast(i64, a)
}

// temp declares a hidden local holding init (already checked) and returns its let.
fn temp(pos i64, init i64, t i64) LetStmt {
	let s = declare_local(pos, cstr("$"), t)
	return cast(LetStmt, let_stmt(pos, cast(Sym, s), init))
}

fn mk_seq(pos i64, stmts i64, value i64, t i64) i64 {
	let n = node_new(EX_SEQ, pos)
	cast(SeqExpr, n).stmts = cast(Vec[i64], stmts)
	cast(SeqExpr, n).value = value
	cast(Node, n).type_ = t
	return n
}

fn mk_unary(pos i64, op i64, x i64) i64 {
	let u = node_new(EX_UNARY, pos)
	cast(Unary, u).op = op
	cast(Unary, u).x = x
	cast(Node, u).type_ = ty_int
	return u
}

// zero_value is the value a declaration without initializer starts with. Strings and
// slices start empty (static objects, never nil); structs, maps and funcs have none.
fn zero_value(pos i64, t i64) i64 {
	let k = kind_of(cast(Ty, t))
	if is_float_t(t) != 0 {
		let f = cast(Node, node_new(EX_FLOAT, pos))
		f.type_ = ty_float
		return cast(i64, f)
	}
	if k == K_STRING {
		return lit_string(pos, cstr(""))
	}
	if k == K_SLICE {
		// A real header, made in the current region, so append never has to pick one.
		return rt_call(pos, cstr("rt_slice_make"), args3(mk_int(pos, 0, ty_int), mk_int(pos, 0, ty_int), mk_int(pos, elem_size(cast(Ty, t)), ty_int)), t)
	}
	if (k == K_STRUCT || k == K_MAP || k == K_FUNC || k == K_DYN) {
		err_code_type(pos, cstr("E203 NO_ZERO_VALUE"), cstr("a variable of type "), t, cstr(" needs an initializer (it cannot be nil; use ?T for an optional)"))
	}
	return mk_int(pos, 0, t)
}

fn to_bits(e Node) i64 {
	if is_float_t(e.type_) != 0 {
		return mk_conv(e.pos, cast(i64, e), CV_F2BITS, ty_int)
	}
	return cast(i64, e)
}

fn from_bits(e Node, t i64) i64 {
	if is_float_t(t) != 0 {
		return mk_conv(e.pos, cast(i64, e), CV_BITS2F, t)
	}
	e.type_ = t
	return cast(i64, e)
}

// ---- statements ----
fn check_stmt(s i64) {
	// A mut argument or a call through a closure can change a captured slice header.
	// Clear cached len aliases before proving any later indexed access safe.
	if stmt_may_change_slice(s, cstr("")) != 0 {
		len_aliases = vec_new[i64]()
	}
	let k = cast(Node, s).kind
	if k == ST_CONST {
		check_local_consts(cast(Node, s))
	} else if k == ST_LET {
		check_let(s)
	} else if k == ST_ASSIGN {
		check_assign(s)
	} else if k == ST_MULTI {
		check_multi(s)
	} else if k == ST_FAIL {
		check_fail(s)
	} else if k == ST_EXPR {
		let x = cast(Node, cast(ExprStmt, s).x)
		if (x.kind == EX_TRY || x.kind == EX_CATCH || x.kind == EX_WRAP) {
			lower_try_stmt(s, cast(i64, x), 0, 0)
			return
		}
		if x.kind == EX_MATCH {
			lower_match_stmt(s, cast(i64, x))
			return
		}
		let t = cast(Ty, chk(x, 0))
		if (kind_of(t) == K_ERROR || (kind_of(t) == K_TUPLE && kind_of(cast(Ty, vec_get(cast(Vec[i64], t.fields), cast(Vec[i64], t.fields).len - 1))) == K_ERROR)) {
			err_code_at(cast(Node, s).pos, cstr("E410 UNCHECKED_FAULT"), cstr("the fault this call returns is ignored (check it, or use try)"))
		}
		if kind_of(t) == K_TUPLE && x.kind == EX_CALL {
			x.type_ = ty_void
		}
	} else if k == ST_IF {
		if cast(IfStmt, s).init != 0 {
			lower_with_init(cast(Node, s), IF_INIT)
			return
		}
		check_cond(cast(Node, cast(IfStmt, s).cond))
		let narrowed = narrow_begin(cast(IfStmt, s).cond, 1)
		let saved = vec_len_of(safe_pairs)
		add_len_fact(cast(IfStmt, s).cond, cast(IfStmt, s).then)
		check_scoped(cast(Block, cast(IfStmt, s).then))
		safe_pairs.len = saved
		narrow_end(cast(Vec[Sym], narrowed))
		let els = cast(Node, cast(IfStmt, s).else_)
		if cast(i64, els) != 0 {
			let narrowed2 = narrow_begin(cast(IfStmt, s).cond, 0)
			if els.kind == ST_BLOCK {
				check_scoped(cast(Block, els))
			} else {
				check_stmt(cast(i64, els))
			}
			narrow_end(cast(Vec[Sym], narrowed2))
		}
	} else if k == ST_WHILE {
		if cast(WhileStmt, s).init != 0 {
			lower_for_init(s)
			return
		}
		check_cond(cast(Node, cast(WhileStmt, s).cond))
		ck_loops = ck_loops + 1
		ck_breaks = ck_breaks + 1
		vec_push(ck_labels, cast(WhileStmt, s).label)
		check_scoped(cast(Block, cast(WhileStmt, s).body))
		if cast(WhileStmt, s).post != 0 {
			push_scope()
			check_stmt(cast(WhileStmt, s).post)
			pop_scope()
		}
		ck_labels.len = ck_labels.len - 1
		ck_loops = ck_loops - 1
		ck_breaks = ck_breaks - 1
	} else if k == ST_RANGE {
		lower_range(s)
	} else if k == ST_SWITCH {
		lower_switch(s)
	} else if k == ST_RETURN {
		check_return(s)
	} else if k == ST_BREAK {
		if ck_breaks == 0 {
			err_code_at(cast(Node, s).pos, cstr("E261 OUTSIDE_LOOP"), cstr("break outside a loop"))
		} else if cast(BreakStmt, s).label != 0 {
			check_loop_label(cast(Node, s).pos, cstr("break"), cast(BreakStmt, s).label)
		}
	} else if k == ST_CONTINUE {
		if ck_loops == 0 {
			err_code_at(cast(Node, s).pos, cstr("E261 OUTSIDE_LOOP"), cstr("continue outside a loop"))
		} else if cast(ContinueStmt, s).label != 0 {
			check_loop_label(cast(Node, s).pos, cstr("continue"), cast(ContinueStmt, s).label)
		}
	} else if k == ST_BLOCK && cast(Block, s).flat != 0 {
		check_stmts(cast(Block, s).stmts)
	} else if k == ST_BLOCK {
		check_scoped(cast(Block, s))
	} else if k == ST_GO {
		err_code_at(cast(Node, s).pos, cstr("E602 GO"), cstr("go is not allowed: cores share nothing (run work per core with hearth, talk across cores with relay)"))
	} else if k == ST_ONCE {
		lower_once(s)
	} else if k == ST_SCOPE {
		lower_scope(s)
	} else if k == ST_DETACH {
		lower_detach(s)
	} else if k == ST_SELECT {
		lower_select(s)
	} else if k == ST_USE {
		lower_use(s)
	} else if k == ST_DEFER {
		lower_defer(s)
	} else if k == ST_BSTORE {
		check_bstore(s)
	} else if k == ST_MSTORE {
		check_mstore(s)
	}
}

// check_bstore checks the last expression of a boundary block's closure and stores its value
// through the closure's parameter $r; bound_t records its type (ty_void: no value).
fn check_bstore(s i64) {
	let pos = cast(Node, s).pos
	let x = cast(Node, cast(ExprStmt, s).x)
	if x.kind == EX_TRY || x.kind == EX_CATCH || x.kind == EX_WRAP {
		lower_try_stmt(s, cast(i64, x), 5, 0)
		return
	}
	if x.kind == EX_MATCH {
		check_match_tail(cast(Node, s), cast(i64, x))
		return
	}
	mut t = cast(Ty, chk(x, 0))
	if kind_of(t) == K_VOID {
		bound_t = ty_void
		replace_node(s, expr_stmt(x))
		return
	}
	// A last call that can fail is a statement like any other: its fault must be handled, not
	// become the block's value (#233: an inner within's deadline was lost that way).
	if kind_of(t) == K_ERROR || (kind_of(t) == K_TUPLE && kind_of(cast(Ty, vec_get(cast(Vec[i64], t.fields), cast(Vec[i64], t.fields).len - 1))) == K_ERROR) {
		err_code_at(pos, cstr("E410 UNCHECKED_FAULT"), cstr("the fault this call returns is ignored (check it, or use try)"))
		bound_t = ty_void
		if kind_of(t) == K_TUPLE && cast(Vec[i64], t.fields).len == 2 {
			bound_t = vec_get(cast(Vec[i64], t.fields), 0)
		}
		replace_node(s, expr_stmt(x))
		return
	}
	if is_untyped(cast(i64, t)) != 0 {
		t = cast(Ty, default_type(cast(i64, t)))
		reconvert(x, cast(i64, t))
	}
	bound_t = cast(i64, t)
	replace_node(s, bound_store(pos, cast(i64, x), cast(i64, t)))
}

shared mut bound_t i64 // the value type of the boundary block being checked

// bound_store writes v (of type t) through the boundary closure's parameter $r.
fn bound_store(pos i64, v i64, t i64) i64 {
	let r = vec_get(cast(Fn, ck_fn).locals, 0)
	return assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, cast(Sym, r)), 0, 0, 0, t), v)
}

// Constants become literals at their uses and require no stack slot or runtime work.
fn check_local_consts(stmt Node) {
	let decls = cast(ConstStmt, stmt).decls
	mut i = 0
	for i < decls.len {
		mut start = i
		let pos = cast(Decl, vec_get(decls, i)).pos
		// Names in one specification enter scope together, after all initializers.
		for i < decls.len && cast(Decl, vec_get(decls, i)).pos == pos {
			let d = cast(Decl, vec_get(decls, i))
			let s = sym_new(SYM_CONST, d.name, d.pos)
			s.decl = cast(i64, d)
			d.sym = cast(i64, s)
			check_const_value(cast(Decl, d))
			i = i + 1
		}
		for start < i {
			let d = cast(Decl, vec_get(decls, start))
			if streq(d.name, cstr("_")) == 0 {
				declare_scoped(cast(Sym, d.sym))
			}
			start = start + 1
		}
	}
	replace_node(cast(i64, stmt), empty_block(stmt.pos))
}

// ---- once (#236) ----
//
// once { body } is if rt_once(N) { body }: the block runs the first time each core reaches it
// (globals are per core, so this is the unit that matters; app-wide work is on app.start).
shared mut once_seq i64

fn lower_once(s i64) {
	let pos = cast(Node, s).pos
	once_seq = once_seq + 1
	let c = cast(Call, node_new(EX_CALL, pos))
	c.name = cstr("rt_once")
	c.args = vec_new[i64]()
	let n = cast(IntLit, node_new(EX_INT, pos))
	n.val = once_seq
	vec_push(cast(Vec[i64], c.args), cast(i64, n))
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = cast(i64, c)
	ifs.then = cast(BodyStmt, s).block
	replace_node(s, cast(i64, ifs))
	check_stmt(s)
}

// ---- scope (#232) ----
//
// scope s { body } is { let s = rt_scope_open(); { body }; try rt_scope_close(s) }: the
// scope's end waits for its children and leaves with the first child's fault.
fn lower_scope(s i64) {
	let pos = cast(Node, s).pos
	let name = cast(ScopeStmt, s).name
	let body = cast(Block, cast(ScopeStmt, s).body)
	let b = cast(Block, empty_block(pos))
	let l = cast(LetStmt, node_new(ST_LET, pos))
	l.name = name
	let open = cast(Call, node_new(EX_CALL, pos))
	open.args = vec_new[i64]()
	open.name = cstr("rt_scope_open")
	l.init = cast(i64, open)
	vec_push(cast(Vec[i64], b.stmts), cast(i64, l))
	vec_push(cast(Vec[i64], b.stmts), cast(ScopeStmt, s).body)
	let close = cast(Call, node_new(EX_CALL, pos))
	close.name = cstr("rt_scope_close")
	let id = cast(IdentExpr, node_new(EX_IDENT, pos))
	id.name = name
	close.args = vec_new[i64]()
	vec_push(cast(Vec[i64], close.args), cast(i64, id))
	let tr = cast(TryExpr, node_new(EX_TRY, pos))
	tr.x = cast(i64, close)
	vec_push(cast(Vec[i64], b.stmts), expr_stmt(cast(Node, tr)))
	replace_node(s, cast(i64, b))
	ck_scope_depth = ck_scope_depth + 1
	check_scoped(cast(Block, s))
	ck_scope_depth = ck_scope_depth - 1
	if l.sym != 0 {
		scope_exits(cast(Vec[i64], body.stmts), l.sym)
	}
}

// scope_exits makes every return out of a scope body (a try's fault is one) leave the scope
// first: its value is computed, rt_scope_exit cancels and joins the children and leaves the
// boundary, then it returns. An inner scope's exits come first, as they were made first.
fn scope_exits(v Vec[i64], sc i64) {
	mut i = 0
	for i < v.len {
		scope_exit_stmt(vec_get(v, i), sc)
		i = i + 1
	}
}

fn scope_exit_stmt(s i64, sc i64) {
	let k = cast(Node, s).kind
	if k == ST_BLOCK {
		scope_exits(cast(Block, s).stmts, sc)
	} else if k == ST_IF {
		scope_exits(cast(Block, cast(IfStmt, s).then).stmts, sc)
		if cast(IfStmt, s).else_ != 0 {
			scope_exit_stmt(cast(IfStmt, s).else_, sc)
		}
	} else if k == ST_WHILE {
		scope_exits(cast(Block, cast(WhileStmt, s).body).stmts, sc)
	} else if k == ST_RETURN {
		let pos = cast(Node, s).pos
		let b = cast(Block, empty_block(pos))
		b.flat = 1
		let r = cast(ReturnStmt, node_new(ST_RETURN, pos))
		if cast(ReturnStmt, s).value != 0 {
			let t = temp(pos, cast(ReturnStmt, s).value, cast(Node, cast(ReturnStmt, s).value).type_)
			vec_push(cast(Vec[i64], b.stmts), cast(i64, t))
			r.value = sym_ref_node(pos, cast(Sym, t.sym))
		}
		if cast(i64, cast(ReturnStmt, s).values) != 0 {
			let vals = vec_new[i64]()
			mut i = 0
			for i < cast(ReturnStmt, s).values.len {
				let rv = cast(Node, vec_get(cast(ReturnStmt, s).values, i))
				let t2 = temp(pos, cast(i64, rv), rv.type_)
				vec_push(cast(Vec[i64], b.stmts), cast(i64, t2))
				vec_push(vals, sym_ref_node(pos, cast(Sym, t2.sym)))
				i = i + 1
			}
			r.values = cast(Vec[i64], vals)
		}
		vec_push(cast(Vec[i64], b.stmts), expr_stmt(cast(Node, rt_call(pos, cstr("rt_scope_exit"), args1(sym_ref_node(pos, cast(Sym, sc))), ty_void))))
		vec_push(cast(Vec[i64], b.stmts), cast(i64, r))
		replace_node(s, cast(i64, b))
	}
}

// detach { body } is rt_detach(keep(fn() ! { body })): a task in the core's background
// boundary, outliving the request, so everything it captures is copied to the long-lived heap.
// What it captures must already be long-lived (design_semantics §6): the region pass reports a
// capture that may hold request memory unless the block reads it only inside keep()
// (rg_detach_check), and the checker any task handle or scope (sb_captures).
shared mut ck_detached Vec[i64] // the closures detach blocks became

fn lower_detach(s i64) {
	let pos = cast(Node, s).pos
	let f = fn_new(pos, cstr("func"))
	if cast(i64, ck_detached) == 0 {
		ck_detached = vec_new[i64]()
	}
	vec_push(cast(Vec[i64], ck_detached), cast(i64, f))
	let ft = cast(TypeExpr, node_new(TX_NAME, pos))
	ft.b = cast(i64, cast(Vec[i64], cstr("fault")))
	vec_push(cast(Vec[i64], f.rtypes), cast(i64, ft))
	f.bang = 1
	f.body = cast(BodyStmt, s).block
	let lit = cast(FuncLit, node_new(EX_FUNCLIT, pos))
	lit.fn_ = cast(i64, f)
	lit.escape = 1
	let kc = cast(Call, node_new(EX_CALL, pos))
	kc.name = cstr("keep")
	kc.args = vec_new[i64]()
	vec_push(cast(Vec[i64], kc.args), cast(i64, lit))
	let dc = cast(Call, node_new(EX_CALL, pos))
	dc.name = cstr("rt_detach")
	dc.args = vec_new[i64]()
	vec_push(cast(Vec[i64], dc.args), cast(i64, kc))
	replace_node(s, expr_stmt(cast(Node, dc)))
	check_stmt(s)
}

// detach_fn is a stand-in for the closure a detach block becomes, for the capture scan.
fn detach_fn(s i64) i64 {
	let f = fn_new(cast(Node, s).pos, cstr("func"))
	f.body = cast(BodyStmt, s).block
	return cast(i64, f)
}

// ---- use and on: resources and lifecycle events (#238) ----
//
// on EVENT { body } becomes a function on$N() ! { body }. A package-level use x = e is a
// per-core global whose initializer opens it on cores only (not helper threads), a fault
// ending startup, and a function use$stop$N() ! { try x.Close() }. __start registers both
// with rt_life_add in declaration order and runs the start events before main and the stop
// events after it (rt_life_start, rt_life_stop); the runtime runs a core's own around its
// entry. A function-level use x = e is let x = try e and a deferred use$close$N(x, cell)
// whose fault every return joins into the function's fault (rt_use_take).
const LIFE_APP_START = 1
const LIFE_APP_STOP = 2
const LIFE_CORE_START = 3
const LIFE_CORE_STOP = 4
const LIFE_USE_CLOSE = 5
const LIFE_OVERLOAD = 6
const LIFE_RECOVERED = 7

shared mut life_regs Vec[i64] // [kind, function, label] for each handler and package-level use
shared mut use_cells Vec[i64] // [function, cell local] for each function with a function-level use

fn life_name(prefix i64, i i64) i64 {
	let nb = buf_new()
	buf_str(nb, prefix)
	buf_int(nb, i)
	buf_byte(nb, 0)
	return nb.data
}

// life_event is the kind of an event expression (app.start ...), or 0 after an error.
fn life_event(e i64) i64 {
	if cast(Node, e).kind == EX_SELECT && cast(Node, cast(SelectExpr, e).x).kind == EX_IDENT {
		let a = cast(IdentExpr, cast(SelectExpr, e).x).name
		let b = cast(SelectExpr, e).name
		if streq(a, cstr("app")) != 0 && streq(b, cstr("start")) != 0 {
			return LIFE_APP_START
		}
		if streq(a, cstr("app")) != 0 && streq(b, cstr("stop")) != 0 {
			return LIFE_APP_STOP
		}
		if streq(a, cstr("core")) != 0 && streq(b, cstr("start")) != 0 {
			return LIFE_CORE_START
		}
		if streq(a, cstr("core")) != 0 && streq(b, cstr("stop")) != 0 {
			return LIFE_CORE_STOP
		}
		if streq(a, cstr("server")) != 0 && streq(b, cstr("overload")) != 0 {
			return LIFE_OVERLOAD
		}
		if streq(a, cstr("server")) != 0 && streq(b, cstr("recovered")) != 0 {
			return LIFE_RECOVERED
		}
	}
	err_code_at(cast(Node, e).pos, cstr("E610 UNKNOWN_EVENT"), cstr("unknown event: on takes app.start, app.stop, core.start, core.stop, server.overload or server.recovered"))
	return 0
}

// life_fn declares a lifecycle function NAME() ! { body } of file.
fn life_fn(pos i64, file i64, name i64, body i64) i64 {
	let f = fn_new(pos, name)
	f.file = file
	let ft = cast(TypeExpr, node_new(TX_NAME, pos))
	ft.b = cast(i64, cast(Vec[i64], cstr("fault")))
	vec_push(cast(Vec[i64], f.rtypes), cast(i64, ft))
	f.bang = 1
	f.body = body
	vec_push(prog_fns, cast(Fn, f))
	return cast(i64, f)
}

fn life_reg(kind i64, f i64, label i64) {
	let r = vec_new[i64]()
	vec_push(r, kind)
	vec_push(r, f)
	vec_push(r, label)
	vec_push(life_regs, cast(i64, r))
}

// lifecycle_decls makes the functions of on handlers and package-level use closes, before
// functions are declared.
fn lifecycle_decls() {
	life_regs = vec_new[i64]()
	use_cells = vec_new[i64]()
	mut i = 0
	for i < prog_ons.len {
		let on_ = vec_get(prog_ons, i)
		set_file(cast(OnStmt, on_).file)
		let kind = life_event(cast(OnStmt, on_).event)
		if kind != 0 {
			let f = life_fn(cast(Node, on_).pos, cast(OnStmt, on_).file, life_name(cstr("on$"), i), cast(OnStmt, on_).body)
			let e = cast(SelectExpr, cast(OnStmt, on_).event)
			life_reg(kind, f, str_cat3(cstr("on "), str_cat3(cast(IdentExpr, e.x).name, cstr("."), e.name), cstr("")))
		}
		i = i + 1
	}
	i = 0
	for i < prog_uses.len {
		let u = vec_get(prog_uses, i)
		let pos = cast(Node, u).pos
		let x = cast(SelectExpr, node_new(EX_SELECT, pos))
		x.x = node_new(EX_IDENT, pos)
		cast(IdentExpr, x.x).name = cast(UseStmt, u).name
		x.name = cstr("Close")
		let c = cast(Call, node_new(EX_CALL, pos))
		c.callee = cast(i64, x)
		c.args = vec_new[i64]()
		let tr = cast(TryExpr, node_new(EX_TRY, pos))
		tr.x = cast(i64, c)
		let body = cast(Block, empty_block(pos))
		vec_push(cast(Vec[i64], body.stmts), expr_stmt(cast(Node, tr)))
		let f = life_fn(pos, cast(UseStmt, u).file, life_name(cstr("use$stop$"), i), cast(i64, body))
		cast(UseStmt, u).stop = f
		life_reg(LIFE_USE_CLOSE, f, str_cat3(cstr("use "), cast(UseStmt, u).name, cstr("")))
		i = i + 1
	}
}

// use_global_of is the package-level use whose global v is, or 0.
fn use_global_of(v i64) i64 {
	if cast(i64, prog_uses) == 0 {
		return 0
	}
	mut i = 0
	for i < prog_uses.len {
		let u = cast(UseStmt, vec_get(cast(Vec[i64], prog_uses), i))
		if u.decl == v {
			return cast(i64, u)
		}
		i = i + 1
	}
	return 0
}

// use_resource is T for a use initializer of type !T (else 0, reported).
fn use_resource(pos i64, t Ty) i64 {
	if kind_of(t) == K_TUPLE && cast(Vec[i64], t.fields).len == 2 && kind_of(cast(Ty, vec_get(cast(Vec[i64], t.fields), 1))) == K_ERROR {
		return vec_get(cast(Vec[i64], t.fields), 0)
	}
	err_code_at(pos, cstr("E620 USE_RESOURCE"), cstr("use needs a call that opens a resource and can fail (a function returning !T)"))
	return 0
}

// use_check_close reports whether rt satisfies shape Resource { Close() ! }.
fn use_check_close(pos i64, rt i64) i64 {
	if kind_of(cast(Ty, rt)) == K_DYN {
		return 1
	}
	let m = cast(Fn, shape_method(cast(Ty, rt), cstr("Close")))
	if cast(i64, m) == 0 {
		err_code_type(pos, cstr("E620 USE_RESOURCE"), cstr("use needs a resource: "), rt, cstr(" has no method Close() !"))
		return 0
	}
	if sm_declared != 0 && (cast(Vec[i64], m.params).len != 1 || cast(Vec[i64], m.rtypes).len != 1 || kind_of(cast(Ty, vec_get(cast(Vec[i64], m.rtypes), 0))) != K_ERROR) {
		err_code_type(pos, cstr("E620 USE_RESOURCE"), cstr("use needs a resource: the Close method of "), rt, cstr(" must take nothing and return a fault (Close() !)"))
		return 0
	}
	return 1
}

// check_use_global types package-level use x = e: x = { $v; if rt_life_here() { $v, $f = e;
// if $f != nil { rt_use_fail("use x", $f) } }; $v } in the core's initializer.
fn check_use_global(v Decl, s Sym, u UseStmt) {
	let pos = v.pos
	let e = cast(Node, v.init)
	start_scope()
	ck_fn = core_fn
	let t = chk(e, 0)
	mut rt = use_resource(pos, cast(Ty, t))
	s.type_ = ty_int
	if rt == 0 || use_check_close(pos, rt) == 0 {
		cast(Block, cast(Fn, u.stop).body).stmts.len = 0
		return
	}
	s.type_ = rt
	let vs = declare_local(pos, cstr("$"), rt)
	let fs = cast(Sym, declare_local(pos, cstr("$"), ty_error))
	fs.reads = 1
	mut zero = mk_int(pos, 0, rt)
	if is_float_t(rt) != 0 {
		zero = zero_value(pos, rt)
	}
	let stmts = vec_new[i64]()
	vec_push(stmts, let_stmt(pos, cast(Sym, vs), zero))
	let cm = cast(CallMultiStmt, node_new(ST_CALLMULTI, pos))
	cm.call = cast(i64, e)
	cm.syms = cast(Vec[Sym], vec_new[i64]())
	vec_push(cast(Vec[i64], cm.syms), vs)
	vec_push(cast(Vec[i64], cm.syms), cast(i64, fs))
	e.type_ = ty_void
	let failed = cast(IfStmt, node_new(ST_IF, pos))
	failed.cond = mk_bin(pos, cstr("!="), sym_ref_node(pos, fs), mk_int(pos, 0, ty_error), ty_bool)
	failed.then = empty_block(pos)
	let label = lit_string(pos, str_cat3(cstr("use "), v.name, cstr("")))
	vec_push(cast(Block, failed.then).stmts, expr_stmt(cast(Node, rt_call(pos, cstr("rt_use_fail"), args2(label, sym_ref_node(pos, fs)), ty_void))))
	let here = cast(IfStmt, node_new(ST_IF, pos))
	here.cond = rt_call(pos, cstr("rt_life_here"), cast(i64, vec_new[i64]()), ty_bool)
	here.then = empty_block(pos)
	vec_push(cast(Block, here.then).stmts, cast(i64, cm))
	vec_push(cast(Block, here.then).stmts, cast(i64, failed))
	vec_push(stmts, cast(i64, here))
	let target = node_new(EX_IDENT, pos)
	cast(IdentExpr, target).name = s.name
	cast(IdentExpr, target).ref = cast(i64, s)
	cast(Node, target).type_ = rt
	let a = cast(AssignStmt, node_new(ST_ASSIGN, pos))
	a.target = target
	a.value = mk_seq(pos, cast(i64, stmts), sym_ref_node(pos, cast(Sym, vs)), rt)
	s.uninit = 1
	vec_push(core_stmts, cast(i64, a))
}

// lower_use lowers a function-level use x = e (see the section comment).
fn lower_use(s i64) {
	let pos = cast(Node, s).pos
	if ck_loops > 0 {
		err_code_at(pos, cstr("E621 USE_PLACEMENT"), cstr("use inside a loop would close once per function, not per iteration: move the loop body into a function"))
		return
	}
	let frs = cast(Fn, ck_fn).rtypes
	if frs.len == 0 || kind_of(cast(Ty, vec_get(frs, frs.len - 1))) != K_ERROR {
		err_code_at(pos, cstr("E411 NO_FAULT_RESULT"), cstr("use needs the enclosing function to return a fault (write its result as !T): opening and closing a resource can fail"))
		return
	}
	let name = cast(UseStmt, s).name
	let tr = cast(TryExpr, node_new(EX_TRY, pos))
	tr.x = cast(UseStmt, s).init
	let l = cast(LetStmt, node_new(ST_LET, pos))
	l.name = name
	l.init = cast(i64, tr)
	let out = cast(Block, empty_block(pos))
	out.flat = 1
	vec_push(cast(Vec[i64], out.stmts), cast(i64, l))
	replace_node(s, cast(i64, out))
	let before = cast(Fn, ck_fn).locals.len
	check_stmt(cast(i64, l))
	let xs = cast(Sym, lookup_name_local(name))
	if cast(i64, xs) == 0 || vec_index(cast(Vec[i64], cast(Fn, ck_fn).locals), cast(i64, xs)) < before {
		return
	}
	let rt = xs.type_
	if use_check_close(pos, rt) == 0 {
		return
	}
	let cf = cast(Fn, use_close_fn(pos, rt))
	if cast(i64, cf) == 0 {
		return
	}
	let xa = cast(IdentExpr, node_new(EX_IDENT, pos))
	xa.name = name
	chk(cast(Node, xa), 0)
	let call = node_new(EX_CALL, pos)
	cast(Call, call).name = cf.name
	cast(Call, call).fn_ = cast(i64, cf)
	cast(Call, call).args = cast(Vec[i64], args2(cast(i64, xa), sym_ref_node(pos, cast(Sym, use_cell(pos)))))
	cast(Node, call).type_ = ty_void
	// As lower_defer, for a call already checked.
	let b = cast(Block, empty_block(pos))
	b.flat = 1
	let args = cast(Call, call).args
	mut i = 0
	for i < args.len {
		let a = cast(Node, vec_get(args, i))
		let at = temp(pos, cast(i64, a), a.type_)
		vec_push(cast(Vec[i64], b.stmts), cast(i64, at))
		args.data[i] = sym_ref_node(pos, cast(Sym, at.sym))
		i = i + 1
	}
	let flag = declare_local(pos, cstr("$"), ty_bool)
	if cast(i64, ck_defers) == 0 {
		ck_defers = vec_new[i64]()
		ck_defer_mark = declare_local(pos, cstr("$"), ty_int)
	}
	defer_record(pos, b, cast(Call, call))
	vec_push(cast(Vec[i64], ck_defers), pair(flag, call))
	vec_push(cast(Vec[i64], out.stmts), cast(i64, b))
}

// use_close_fn builds use$close$N($r T, $c i64) { rt_use_note($c, $r.Close()) }.
fn use_close_fn(pos i64, rt i64) i64 {
	lifted_count = lifted_count + 1
	let name = life_name(cstr("use$close$"), lifted_count)
	let f = fn_new(pos, name)
	f.qname = name
	f.lifted = 2
	f.done = 1
	f.file = ck_fn.file
	vec_push(cast(Vec[i64], f.params), cstr("$r"))
	vec_push(cast(Vec[i64], f.params), cstr("$c"))
	vec_push(cast(Vec[i64], f.ptypes), rt)
	vec_push(cast(Vec[i64], f.ptypes), ty_int)
	vec_push(cast(Vec[i64], f.muts), mut_capable(rt))
	vec_push(cast(Vec[i64], f.muts), 0)
	f.type_ = func_of(cast(Vec[i64], f.ptypes), cast(Vec[i64], f.rtypes), 0)
	f.locals = cast(Vec[Sym], vec_new[i64]())
	f.slots = 0
	let saved = ck_fn
	ck_fn = cast(Fn, f)
	push_scope()
	let rs = cast(Sym, declare_local(pos, cstr("$r"), rt))
	rs.reads = 1
	rs.mut_ = mut_capable(rt)
	let cs = cast(Sym, declare_local(pos, cstr("$c"), ty_int))
	cs.reads = 1
	let x = cast(SelectExpr, node_new(EX_SELECT, pos))
	x.x = node_new(EX_IDENT, pos)
	cast(IdentExpr, x.x).name = cstr("$r")
	x.name = cstr("Close")
	let c = cast(Call, node_new(EX_CALL, pos))
	c.callee = cast(i64, x)
	c.args = vec_new[i64]()
	let t = chk(cast(Node, c), 0)
	pop_scope()
	ck_fn = saved
	if kind_of(cast(Ty, t)) != K_ERROR {
		err_code_type(pos, cstr("E620 USE_RESOURCE"), cstr("use needs a resource: the Close method of "), rt, cstr(" must return a fault (Close() !)"))
		return 0
	}
	f.body = empty_block(pos)
	vec_push(cast(Block, f.body).stmts, expr_stmt(cast(Node, rt_call(pos, cstr("rt_use_note"), args2(sym_ref_node(pos, cs), cast(i64, c)), ty_void))))
	vec_push(prog_fns, cast(Fn, f))
	return cast(i64, f)
}

// use_cell_of is the cell local of function f's uses, or 0.
fn use_cell_of(f i64) i64 {
	if cast(i64, use_cells) == 0 {
		return 0
	}
	mut i = 0
	for i < use_cells.len {
		let p = cast(Vec[i64], vec_get(cast(Vec[i64], use_cells), i))
		if vec_get(p, 0) == f {
			return vec_get(p, 1)
		}
		i = i + 1
	}
	return 0
}

fn use_cell(pos i64) i64 {
	mut c = cast(Sym, use_cell_of(cast(i64, ck_fn)))
	if cast(i64, c) == 0 {
		c = cast(Sym, declare_local(pos, cstr("$uc"), ty_int))
		c.reads = 1
		vec_push(use_cells, pair(cast(i64, ck_fn), cast(i64, c)))
	}
	return cast(i64, c)
}

// use_cell_init starts function f with its cell (finish_defers).
fn use_cell_init(f Fn, init Vec[i64]) {
	let c = use_cell_of(cast(i64, f))
	if c != 0 {
		vec_push(init, let_stmt(f.pos, cast(Sym, c), rt_call(f.pos, cstr("rt_use_cell"), cast(i64, vec_new[i64]()), ty_int)))
	}
}

// use_return makes return r (in block b, after the deferred calls ran) return the faults the
// closes gave, joined after the function's own (defer_stmt).
fn use_return(pos i64, b Block, r ReturnStmt) {
	let c = use_cell_of(cast(i64, ck_fn))
	if c == 0 {
		return
	}
	mut old = r.value
	if cast(i64, r.values) != 0 {
		old = vec_get(cast(Vec[i64], r.values), cast(Vec[i64], r.values).len - 1)
	}
	let cf = temp(pos, rt_call(pos, cstr("rt_use_take"), args1(sym_ref_node(pos, cast(Sym, c))), ty_error), ty_error)
	cast(Sym, cf.sym).reads = 1
	vec_push(cast(Vec[i64], b.stmts), cast(i64, cf))
	mut prev = mk_int(pos, 0, ty_error)
	if old != 0 && cast(Node, old).kind == EX_IDENT && cast(IdentExpr, old).ref != 0 {
		prev = sym_ref_node(pos, cast(Sym, cast(IdentExpr, old).ref))
	}
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = mk_bin(pos, cstr("!="), sym_ref_node(pos, cast(Sym, cf.sym)), mk_int(pos, 0, ty_error), ty_bool)
	ifs.then = empty_block(pos)
	let joined = rt_call(pos, cstr("rt_use_join"), args2(prev, sym_ref_node(pos, cast(Sym, cf.sym))), ty_error)
	vec_push(cast(Block, ifs.then).stmts, fault_return(pos, cast(Block, ifs.then).stmts, joined))
	vec_push(cast(Vec[i64], b.stmts), cast(i64, ifs))
}

// life_start registers the handlers and closes, then runs the start events (make_start).
fn life_start(pos i64, body Block) {
	if cast(i64, life_regs) == 0 || life_regs.len == 0 {
		return
	}
	mut i = 0
	for i < life_regs.len {
		let r = cast(Vec[i64], vec_get(cast(Vec[i64], life_regs), i))
		let f = cast(Fn, vec_get(r, 1))
		let ref_ = node_new(EX_FUNCREF, pos)
		cast(FuncRef, ref_).fn_ = cast(i64, f)
		cast(Node, ref_).type_ = f.type_
		let args = args3(mk_int(pos, vec_get(r, 0), ty_int), ref_, lit_string(pos, vec_get(r, 2)))
		vec_push(cast(Vec[i64], body.stmts), expr_stmt(cast(Node, rt_call(pos, cstr("rt_life_add"), args, ty_void))))
		i = i + 1
	}
	vec_push(cast(Vec[i64], body.stmts), expr_stmt(cast(Node, rt_call(pos, cstr("rt_life_start"), cast(i64, vec_new[i64]()), ty_void))))
}

// life_stop runs the stop events after main returns (make_start).
fn life_stop(pos i64, body Block) {
	if cast(i64, life_regs) != 0 && life_regs.len > 0 {
		vec_push(cast(Vec[i64], body.stmts), expr_stmt(cast(Node, rt_call(pos, cstr("rt_life_stop"), cast(i64, vec_new[i64]()), ty_void))))
	}
}

// mark_spawns keeps the closures passed to s.spawn inside scope s on the parent's frame (the
// scope outlives its children, as for sift.Each), before captures are scanned.
fn mark_spawns(v Vec[i64], names Vec[i64]) {
	mut i = 0
	for i < v.len {
		let s = vec_get(v, i)
		let k = cast(Node, s).kind
		if k == ST_SCOPE {
			let inner = vec_clone(names)
			vec_push(inner, cast(ScopeStmt, s).name)
			mark_spawns(cast(Block, cast(ScopeStmt, s).body).stmts, cast(Vec[i64], inner))
		} else if k == ST_BLOCK {
			mark_spawns(cast(Block, s).stmts, names)
		} else if k == ST_IF {
			mark_spawns(cast(Block, cast(IfStmt, s).then).stmts, names)
			if cast(IfStmt, s).else_ != 0 {
				let ev = vec_new[i64]()
				vec_push(ev, cast(IfStmt, s).else_)
				mark_spawns(cast(Vec[i64], ev), names)
			}
		} else if k == ST_WHILE {
			mark_spawns(cast(Block, cast(WhileStmt, s).body).stmts, names)
		} else if k == ST_RANGE {
			mark_spawns(cast(Block, cast(RangeStmt, s).body).stmts, names)
		} else if mt_stmt_expr(s) != 0 && cast(Node, mt_stmt_expr(s)).kind == EX_MATCH {
			let arms = cast(MatchExpr, mt_stmt_expr(s)).arms
			mut ai = 0
			for ai < arms.len {
				let arm = cast(Vec[i64], vec_get(arms, ai))
				if cast(MatchArm, arm).block != 0 {
					mark_spawns(cast(Vec[i64], cast(Block, cast(MatchArm, arm).body).stmts), names)
				} else {
					mark_spawn_call(cast(MatchArm, arm).body, names)
				}
				ai = ai + 1
			}
		} else if k == ST_EXPR {
			mark_spawn_call(cast(ExprStmt, s).x, names)
		} else if k == ST_LET {
			mark_spawn_call(cast(LetStmt, s).init, names)
		}
		i = i + 1
	}
}

fn mark_spawn_call(e_in i64, names Vec[i64]) {
	mut e = e_in
	if e == 0 || names.len == 0 {
		return
	}
	if cast(Node, e).kind == EX_TRY {
		e = cast(TryExpr, e).x
	}
	if cast(Node, e).kind != EX_CALL || cast(Call, e).callee == 0 {
		return
	}
	let x = cast(Call, e).callee
	if cast(Node, x).kind != EX_SELECT || cast(Node, cast(SelectExpr, x).x).kind != EX_IDENT || streq(cast(SelectExpr, x).name, cstr("spawn")) == 0 || vec_has_str(names, cast(IdentExpr, cast(SelectExpr, x).x).name) == 0 {
		return
	}
	let args = cast(Call, e).args
	if args.len == 1 && cast(Node, vec_get(args, 0)).kind == EX_FUNCLIT {
		// Its cells are made per spawn (pool memory, like any kept closure), but the scope
		// ends before the request does, so request memory may be stored in them. The mark is
		// the scope's name: the child may use task handles of that scope or an outer one.
		cast(FuncLit, vec_get(args, 0)).scoped = cast(IdentExpr, cast(SelectExpr, x).x).name
	}
}

// ---- select (#232) ----
//
// select { let x = w => body ... } checks the arms in source order (ties go to the first) and,
// when none is ready, watches every source and parks until one wakes it; then the winning
// arm takes its value (which cannot wait: nothing ran since it was ready) and its body runs.
// Arms are lane receives (l.Recv()), task handles (t.wait()), after(d) and canceled().
fn sel_ident(pos i64, name i64) i64 {
	let id = cast(IdentExpr, node_new(EX_IDENT, pos))
	id.name = name
	return cast(i64, id)
}

fn sel_call(pos i64, name i64, args i64) i64 {
	let c = cast(Call, node_new(EX_CALL, pos))
	c.name = name
	c.args = cast(Vec[i64], args)
	return cast(i64, c)
}

fn sel_method(pos i64, recv i64, name i64) Node {
	let x = cast(SelectExpr, node_new(EX_SELECT, pos))
	x.x = sel_ident(pos, recv)
	x.name = name
	let c = cast(Call, node_new(EX_CALL, pos))
	c.callee = cast(i64, x)
	c.args = vec_new[i64]()
	return cast(Node, c)
}

fn sel_let(pos i64, name i64, init i64) i64 {
	let l = cast(LetStmt, node_new(ST_LET, pos))
	l.name = name
	l.init = init
	return cast(i64, l)
}

fn sel_set(pos i64, name i64, v i64) i64 {
	let a = cast(AssignStmt, node_new(ST_ASSIGN, pos))
	a.target = sel_ident(pos, name)
	let n = cast(IntLit, node_new(EX_INT, pos))
	n.val = v
	a.value = cast(i64, n)
	return cast(i64, a)
}

fn sel_cmp(pos i64, name i64, op i64, v i64) i64 {
	let b = cast(Binary, node_new(EX_BINARY, pos))
	b.op = op
	b.l = sel_ident(pos, name)
	let n = cast(IntLit, node_new(EX_INT, pos))
	n.val = v
	if v < 0 {
		n.val = -v
		let u = cast(Unary, node_new(EX_UNARY, pos))
		u.op = cstr("-")
		u.x = cast(i64, n)
		b.r = cast(i64, u)
	} else {
		b.r = cast(i64, n)
	}
	return cast(i64, b)
}

fn sel_name(pos i64, kind i64, i i64) i64 {
	let nb = buf_new()
	buf_str(nb, kind)
	buf_int(nb, sel_seq)
	buf_byte(nb, '_')
	buf_int(nb, i)
	buf_byte(nb, 0)
	return nb.data
}

shared mut sel_seq i64

// sel_site is a select's replay key (#243): its file's base name, ":" and its line.
fn sel_site(pos i64) i64 {
	let f = vec_get(files, pos >> 48)
	mut i = 0
	mut base = 0
	for i64(load8(f + i)) != 0 {
		if i64(load8(f + i)) == '/' {
			base = i + 1
		}
		i = i + 1
	}
	let b = buf_new()
	buf_str(b, f + base)
	buf_byte(b, ':')
	buf_int(b, (pos >> 16) & 0xffffffff)
	return str_node(pos, cast(Buf, b))
}

// sel_gate is arm i's replay gate (#243): $selr < 0 (not replaying) || $selr == i.
fn sel_gate(pos i64, r i64, i i64) i64 {
	return binary_new(pos, cstr("||"), sel_cmp(pos, r, cstr("<"), 0), sel_cmp(pos, r, cstr("=="), i))
}

// sel_gated runs stmt only when arm i's replay gate is open.
fn sel_gated(pos i64, r i64, i i64, stmt i64) i64 {
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = sel_gate(pos, r, i)
	ifs.then = empty_block(pos)
	vec_push(cast(Block, ifs.then).stmts, stmt)
	return cast(i64, ifs)
}

fn lower_select(s i64) {
	let pos = cast(Node, s).pos
	sel_seq = sel_seq + 1
	let arms = cast(SelectStmt, s).arms
	let n = arms.len
	let out = cast(Block, empty_block(pos))
	let st = cast(Vec[i64], out.stmts)
	let kinds = vec_new[i64]() // 1 lane, 2 handle, 3 after, 4 canceled
	let srcs = vec_new[i64]()
	let armv = sel_name(pos, cstr("$sel"), 0 - 1)
	mut i = 0
	for i < n {
		let arm = cast(Vec[i64], vec_get(arms, i))
		let w = cast(SelectArm, arm).wait
		let apos = cast(SelectArm, arm).pos
		mut kind = 0
		mut src = 0
		if cast(Node, w).kind == EX_CALL && cast(Call, w).callee != 0 && cast(Node, cast(Call, w).callee).kind == EX_SELECT && cast(Call, w).args.len == 0 {
			let m = cast(SelectExpr, cast(Call, w).callee).name
			if streq(m, cstr("Recv")) != 0 || streq(m, cstr("recv")) != 0 {
				kind = 1
			} else if streq(m, cstr("wait")) != 0 || streq(m, cstr("Wait")) != 0 {
				kind = 2
			}
			if kind != 0 {
				// A plain variable is used as is; anything else is evaluated once, first.
				let rx = cast(SelectExpr, cast(Call, w).callee).x
				if cast(Node, rx).kind == EX_IDENT {
					src = cast(IdentExpr, rx).name
				} else {
					src = sel_name(pos, cstr("$sels"), i)
					vec_push(st, sel_let(apos, src, rx))
				}
			}
		} else if cast(Node, w).kind == EX_CALL && cast(Call, w).name != 0 && streq(cast(Call, w).name, cstr("after")) != 0 && cast(Call, w).args.len == 1 {
			kind = 3
			src = sel_name(pos, cstr("$sels"), i)
			vec_push(st, sel_let(apos, src, sel_call(apos, cstr("rt_select_deadline"), cast(i64, cast(Call, w).args))))
		} else if cast(Node, w).kind == EX_CALL && cast(Call, w).name != 0 && streq(cast(Call, w).name, cstr("canceled")) != 0 && cast(Call, w).args.len == 0 {
			kind = 4
		}
		if kind == 0 {
			err_code_at(apos, cstr("E630 SELECT_ARM"), cstr("a select arm waits on l.Recv(), t.wait(), after(d) or canceled()"))
			return
		}
		if kind >= 2 && cast(SelectArm, arm).name != 0 && kind != 2 {
			err_code_at(apos, cstr("E630 SELECT_ARM"), cstr("after(d) and canceled() give no value to bind"))
			return
		}
		vec_push(kinds, kind)
		vec_push(srcs, src)
		i = i + 1
	}
	let m1 = cast(Unary, node_new(EX_UNARY, pos))
	m1.op = cstr("-")
	let one = cast(IntLit, node_new(EX_INT, pos))
	one.val = 1
	m1.x = cast(i64, one)
	vec_push(st, sel_let(pos, armv, cast(i64, m1)))
	// Replay (#243): -1 off, -2 recording the winner, else the recorded arm, the only one taken.
	let selr = sel_name(pos, cstr("$selr"), 0)
	let rargs = vec_new[i64]()
	vec_push(rargs, sel_site(pos))
	let nlit = cast(IntLit, node_new(EX_INT, pos))
	nlit.val = n
	vec_push(rargs, cast(i64, nlit))
	vec_push(st, sel_let(pos, selr, sel_call(pos, cstr("rt_select_begin"), cast(i64, rargs))))
	// $selnow: replaying, the recorded select did not wait, so its after(d) arm is due now.
	let selnow = sel_name(pos, cstr("$seln"), 0)
	let nargs = vec_new[i64]()
	vec_push(nargs, sel_site(pos))
	vec_push(st, sel_let(pos, selnow, binary_new(pos, cstr("&&"), sel_cmp(pos, selr, cstr(">="), 0), sel_call(pos, cstr("rt_select_now"), cast(i64, nargs)))))
	// for $sel < 0 { readiness checks in order; else watch, park, unwatch }
	let loop_ = cast(WhileStmt, node_new(ST_WHILE, pos))
	loop_.cond = sel_cmp(pos, armv, cstr("<"), 0)
	loop_.body = empty_block(pos)
	let lb = cast(Block, loop_.body).stmts
	let dl = sel_name(pos, cstr("$seld"), 0)
	vec_push(lb, sel_let(pos, dl, node_new(EX_INT, pos)))
	mut chain = 0
	mut last = cast(IfStmt, 0)
	i = 0
	for i < n {
		let k = vec_get(kinds, i)
		mut cond = 0
		if k == 1 {
			cond = cast(i64, sel_method(pos, vec_get(srcs, i), cstr("Ready")))
		} else if k == 2 {
			cond = cast(i64, sel_method(pos, vec_get(srcs, i), cstr("ready")))
		} else if k == 3 {
			let args = vec_new[i64]()
			vec_push(args, sel_ident(pos, vec_get(srcs, i)))
			cond = binary_new(pos, cstr("||"), sel_ident(pos, selnow), sel_call(pos, cstr("rt_select_due"), cast(i64, args)))
		} else {
			cond = sel_call(pos, cstr("rt_select_canceled"), cast(i64, vec_new[i64]()))
		}
		let ifs = cast(IfStmt, node_new(ST_IF, pos))
		ifs.cond = binary_new(pos, cstr("&&"), sel_gate(pos, selr, i), cond)
		ifs.then = empty_block(pos)
		vec_push(cast(Block, ifs.then).stmts, sel_set(pos, armv, i))
		if cast(i64, last) != 0 {
			let eb = cast(Block, empty_block(pos))
			vec_push(cast(Vec[i64], eb.stmts), cast(i64, ifs))
			last.else_ = cast(i64, eb)
		} else {
			chain = cast(i64, ifs)
		}
		last = ifs
		i = i + 1
	}
	// A cancelled boundary with no canceled() arm ends the select with its fault.
	let cifs = cast(IfStmt, node_new(ST_IF, pos))
	cifs.cond = sel_call(pos, cstr("rt_select_canceled"), cast(i64, vec_new[i64]()))
	cifs.then = empty_block(pos)
	vec_push(cast(Block, cifs.then).stmts, sel_set(pos, armv, n))
	let eb = cast(Block, empty_block(pos))
	vec_push(cast(Vec[i64], eb.stmts), cast(i64, cifs))
	last.else_ = cast(i64, eb)
	vec_push(lb, chain)
	let wait = cast(IfStmt, node_new(ST_IF, pos))
	wait.cond = sel_cmp(pos, armv, cstr("<"), 0)
	wait.then = empty_block(pos)
	let wb = cast(Block, wait.then).stmts
	i = 0
	for i < n {
		let k = vec_get(kinds, i)
		if k == 1 {
			vec_push(wb, sel_gated(pos, selr, i, expr_stmt(sel_method(pos, vec_get(srcs, i), cstr("Watch")))))
		} else if k == 2 {
			vec_push(wb, sel_gated(pos, selr, i, expr_stmt(sel_method(pos, vec_get(srcs, i), cstr("watch")))))
		} else if k == 3 {
			let a = cast(AssignStmt, node_new(ST_ASSIGN, pos))
			a.target = sel_ident(pos, dl)
			let args = vec_new[i64]()
			vec_push(args, sel_ident(pos, dl))
			vec_push(args, sel_ident(pos, vec_get(srcs, i)))
			a.value = sel_call(pos, cstr("rt_select_min"), cast(i64, args))
			vec_push(wb, sel_gated(pos, selr, i, cast(i64, a)))
		}
		i = i + 1
	}
	let pargs = vec_new[i64]()
	vec_push(pargs, sel_ident(pos, dl))
	vec_push(wb, expr_stmt(cast(Node, sel_call(pos, cstr("rt_select_park"), cast(i64, pargs)))))
	i = 0
	for i < n {
		let k = vec_get(kinds, i)
		if k == 1 {
			vec_push(wb, sel_gated(pos, selr, i, expr_stmt(sel_method(pos, vec_get(srcs, i), cstr("Unwatch")))))
		} else if k == 2 {
			vec_push(wb, sel_gated(pos, selr, i, expr_stmt(sel_method(pos, vec_get(srcs, i), cstr("unwatch")))))
		}
		i = i + 1
	}
	vec_push(lb, cast(i64, wait))
	vec_push(st, cast(i64, loop_))
	// if $selr != -1 { rt_select_end(site, $selr, $sel) }: record the winner, or check it.
	let rec = cast(IfStmt, node_new(ST_IF, pos))
	rec.cond = sel_cmp(pos, selr, cstr("!="), 0 - 1)
	rec.then = empty_block(pos)
	let eargs = vec_new[i64]()
	vec_push(eargs, sel_site(pos))
	vec_push(eargs, sel_ident(pos, selr))
	vec_push(eargs, sel_ident(pos, armv))
	vec_push(cast(Block, rec.then).stmts, expr_stmt(cast(Node, sel_call(pos, cstr("rt_select_end"), cast(i64, eargs)))))
	vec_push(st, cast(i64, rec))
	// Then the winning arm: take its value and run its body.
	i = 0
	for i <= n {
		let ifs = cast(IfStmt, node_new(ST_IF, pos))
		ifs.cond = sel_cmp(pos, armv, cstr("=="), i)
		ifs.then = empty_block(pos)
		let tb = cast(Block, ifs.then).stmts
		if i == n {
			let tr = cast(TryExpr, node_new(EX_TRY, pos))
			tr.x = sel_call(pos, cstr("rt_select_fail"), cast(i64, vec_new[i64]()))
			vec_push(tb, expr_stmt(cast(Node, tr)))
		} else {
			let arm = cast(Vec[i64], vec_get(arms, i))
			let k = vec_get(kinds, i)
			let name = cast(SelectArm, arm).name
			if k == 1 || k == 2 {
				mut take = 0
				if k == 1 {
					take = cast(i64, sel_method(pos, vec_get(srcs, i), cstr("Recv")))
				} else {
					take = cast(i64, sel_method(pos, vec_get(srcs, i), cstr("wait")))
				}
				let tr = cast(TryExpr, node_new(EX_TRY, pos))
				tr.x = take
				if name != 0 {
					vec_push(tb, sel_let(pos, name, cast(i64, tr)))
				} else {
					if k == 1 {
						vec_push(tb, sel_let(pos, cstr("_"), cast(i64, tr)))
					} else {
						vec_push(tb, expr_stmt(cast(Node, tr)))
					}
				}
			}
			let body = cast(Node, cast(SelectArm, arm).body)
			if cast(SelectArm, arm).block != 0 {
				vec_push(tb, cast(i64, body))
			} else if is_stmt_kind(body.kind) != 0 {
				vec_push(tb, cast(i64, body))
			} else {
				vec_push(tb, expr_stmt(cast(Node, body)))
			}
		}
		vec_push(st, cast(i64, ifs))
		i = i + 1
	}
	replace_node(s, cast(i64, out))
	check_scoped(cast(Block, s))
}

// is_stmt_kind tells a select arm's statement body (return, fail, break, continue) from an
// expression body.
fn is_stmt_kind(k i64) i64 {
	return i64(k == ST_RETURN || k == ST_FAIL || k == ST_BREAK || k == ST_CONTINUE || k == ST_EXPR)
}

// ---- task handles stay in their scope (#232) ----
//
// A scope frees its children's records when it ends, so neither a task handle (spawned) nor
// the scope itself may be reachable after the scope block. They are second-class values: they
// live in local variables and parameters (and local slices, maps and optionals of them), never
// in a global, a struct field, a result, a type argument or a dyn value. Every local remembers
// how many scope blocks enclose its declaration (S_SCOPE_AT); a value is as deep as the deepest
// such variable it reads, and may only be stored where it lives no longer: by an assignment,
// through an argument for a mut parameter or a scope parameter (the callee may spawn children
// that capture the other arguments), and by append and copy. A closure that may outlive the
// scope (a kept or detached one) cannot capture one, a child spawned on scope s only those of s
// or of a scope around it, and a deferred call none from a scope that ends before it runs.
shared mut ck_scope_depth i64 // scope blocks around the code being checked (a closure starts 65536 deeper)
shared mut ck_fn_base i64 // ck_scope_depth where the current function's body starts
shared mut sb_types Vec[i64] // [scope, spawned, spawnedOf]: the runtime's types, once looked up

// sb_type reports whether a value of type t is, or holds, a task handle or a scope.
fn sb_type(t Ty) i64 {
	if cast(i64, t) == 0 {
		return 0
	}
	let k = kind_of(t)
	if k == K_OPT || k == K_SLICE {
		return sb_type(cast(Ty, t.elem))
	}
	if k == K_MAP {
		return i64(sb_type(cast(Ty, t.key)) != 0 || sb_type(cast(Ty, t.elem)) != 0)
	}
	if k != K_STRUCT {
		return 0
	}
	if cast(i64, sb_types) == 0 {
		let sc = find_type(cstr("scope"))
		let sp = find_type(cstr("spawned"))
		if sc == 0 || sp == 0 {
			return 0
		}
		sb_types = vec_new[i64]()
		vec_push(sb_types, sc)
		vec_push(sb_types, sp)
		vec_push(sb_types, cast(i64, find_generic(cstr("spawnedOf"))))
	}
	if t.gdecl != 0 && t.gdecl == vec_get(sb_types, 2) {
		// The handle of a child with a value.
		return 1
	}
	return i64(cast(i64, t) == vec_get(sb_types, 0) || cast(i64, t) == vec_get(sb_types, 1))
}

// sb_noun names what an sb_type holds, for diagnostics.
fn sb_noun(t Ty) i64 {
	let k = kind_of(t)
	if k == K_OPT || k == K_SLICE {
		return sb_noun(cast(Ty, t.elem))
	}
	if k == K_MAP {
		if sb_type(cast(Ty, t.key)) != 0 {
			return sb_noun(cast(Ty, t.key))
		}
		return sb_noun(cast(Ty, t.elem))
	}
	if cast(i64, sb_types) != 0 && cast(i64, t) == vec_get(sb_types, 0) {
		return cstr("a scope")
	}
	return cstr("a task handle")
}

// sb_forbid reports a task handle or scope of type t kept where it could outlive its scope.
fn sb_forbid(pos i64, t i64, what i64) {
	if ck_trusted != 0 || sb_type(cast(Ty, t)) == 0 {
		return
	}
	let e = err_code(pos, cstr("E640 SCOPE_ESCAPE"))
	buf_str(e, what)
	buf_str(e, sb_noun(cast(Ty, t)))
	buf_str(e, cstr(" ("))
	type_name(cast(Buf, e), cast(Ty, t))
	buf_str(e, cstr("): it must not outlive its scope block, so it lives only in local variables and parameters"))
	err_end(cast(Buf, e))
}

// sb_targs rejects task handles and scopes as type arguments (a generic could keep them).
fn sb_targs(pos i64, targs Vec[i64]) {
	mut i = 0
	for cast(i64, targs) != 0 && i < targs.len {
		sb_forbid(pos, vec_get(targs, i), cstr("a type argument cannot be "))
		i = i + 1
	}
}

// sb_scope_params names f's scope parameters: a closure spawned on one is the scope's child.
fn sb_scope_params(f Fn) i64 {
	let names = vec_new[i64]()
	mut i = 0
	for i < cast(Vec[i64], f.params).len && i < sb_len(cast(Vec[i64], f.ptypes)) {
		let t = cast(Ty, vec_get(cast(Vec[i64], f.ptypes), i))
		if cast(i64, t) != 0 && t.kind < TX_NAME && sb_type(cast(Ty, t)) != 0 && cast(i64, t) == vec_get(sb_types, 0) {
			vec_push(names, vec_get(cast(Vec[i64], f.params), i))
		}
		i = i + 1
	}
	return cast(i64, names)
}

// sb_lookup finds the variable a name means here without capturing it (lookup_name would).
fn sb_lookup(name i64) i64 {
	mut i = sc_syms.len - 1
	for i >= 0 {
		let s = vec_get(sc_syms, i)
		if streq(s.name, name) != 0 {
			return cast(i64, s)
		}
		i = i - 1
	}
	mut f = cast(Fn, ck_fn)
	for cast(i64, f) != 0 && f.parent != 0 {
		let syms = cast(Vec[i64], f.outer_syms)
		mut j = sb_len(syms) - 1
		for j >= 0 {
			let os = cast(Sym, vec_get(syms, j))
			if streq(os.name, name) != 0 {
				return cast(i64, os)
			}
			j = j - 1
		}
		f = cast(Fn, f.parent)
	}
	return 0
}

// sb_sym_depth is how deep the handles variable s holds may be: its declaration's depth.
fn sb_sym_depth(s Sym) i64 {
	if cast(i64, s) != 0 && s.kind == SYM_LOCAL && sb_type(cast(Ty, s.type_)) != 0 {
		return s.scope_at
	}
	return 0
}

fn sb_max(a i64, b i64) i64 {
	if a > b {
		return a
	}
	return b
}

fn sb_list_depth(v Vec[i64]) i64 {
	mut d = 0
	mut i = 0
	for cast(i64, v) != 0 && i < v.len {
		d = sb_max(d, sb_depth(vec_get(v, i)))
		i = i + 1
	}
	return d
}

fn sb_len(v Vec[i64]) i64 {
	if cast(i64, v) == 0 {
		return 0
	}
	return v.len
}

fn sb_block_depth(b Block) i64 {
	mut d = 0
	mut i = 0
	for cast(i64, b) != 0 && i < cast(Vec[i64], b.stmts).len {
		d = sb_max(d, sb_stmt_depth(vec_get(cast(Vec[i64], b.stmts), i)))
		i = i + 1
	}
	return d
}

fn sb_stmt_depth(st i64) i64 {
	if st == 0 {
		return 0
	}
	let k = cast(Node, st).kind
	if k == ST_EXPR || k == ST_BSTORE {
		return sb_depth(cast(ExprStmt, st).x)
	}
	if k == ST_LET {
		return sb_depth(cast(LetStmt, st).init)
	}
	if k == ST_ASSIGN {
		return sb_depth(cast(AssignStmt, st).value)
	}
	if k == ST_RETURN {
		return sb_depth(cast(ReturnStmt, st).value)
	}
	if k == ST_IF {
		return sb_max(sb_depth(cast(IfStmt, st).cond), sb_max(sb_block_depth(cast(Block, cast(IfStmt, st).then)), sb_stmt_depth(cast(IfStmt, st).else_)))
	}
	if k == ST_BLOCK {
		return sb_block_depth(cast(Block, st))
	}
	if k == ST_FAIL || k == ST_BREAK || k == ST_CONTINUE {
		return 0
	}
	return ck_scope_depth
}

// sb_depth is the depth of the deepest task handle or scope expression e may give (0: none). It
// takes unchecked and checked nodes; one it does not know is as deep as the code around it.
fn sb_depth(e i64) i64 {
	if e == 0 {
		return 0
	}
	let k = cast(Node, e).kind
	if k == EX_INT || k == EX_FLOAT || k == EX_STR || k == EX_NIL || k == EX_INTERP || k == EX_UNIT || k == EX_TYPE || k == EX_FUNCLIT || k == EX_FUNCREF {
		return 0
	}
	if k == EX_IDENT {
		if cast(IdentExpr, e).ref != 0 {
			return sb_sym_depth(cast(Sym, cast(IdentExpr, e).ref))
		}
		return sb_sym_depth(cast(Sym, sb_lookup(cast(IdentExpr, e).name)))
	}
	if k == ST_BLOCK {
		return sb_block_depth(cast(Block, e))
	}
	if k == EX_SELECT {
		return sb_depth(cast(SelectExpr, e).x)
	}
	if k == EX_UNARY {
		return sb_depth(cast(Unary, e).x)
	}
	if k == EX_MUTARG {
		return sb_depth(cast(MutArg, e).x)
	}
	if k == EX_TRY {
		return sb_depth(cast(TryExpr, e).x)
	}
	if k == EX_WRAP {
		return sb_depth(cast(WrapExpr, e).x)
	}
	if k == EX_CONV {
		return sb_depth(cast(Conv, e).x)
	}
	if k == EX_BINARY {
		return sb_max(sb_depth(cast(Binary, e).l), sb_depth(cast(Binary, e).r))
	}
	if k == EX_INDEX {
		return sb_max(sb_depth(cast(IndexExpr, e).x), sb_depth(cast(IndexExpr, e).i))
	}
	if k == EX_SLICE {
		return sb_max(sb_depth(cast(SliceExpr, e).x), sb_max(sb_depth(cast(SliceExpr, e).lo), sb_depth(cast(SliceExpr, e).hi)))
	}
	if k == EX_COALESCE {
		return sb_max(sb_depth(cast(Coalesce, e).x), sb_depth(cast(Coalesce, e).fallback))
	}
	if k == EX_CATCH {
		return sb_max(sb_depth(cast(CatchExpr, e).x), sb_block_depth(cast(Block, cast(CatchExpr, e).body)))
	}
	if k == EX_BOUNDARY {
		return sb_max(sb_list_depth(cast(BoundaryStmt, e).args), sb_block_depth(cast(Block, cast(BoundaryStmt, e).body)))
	}
	if k == EX_CALL {
		return sb_max(sb_depth(cast(Call, e).callee), sb_list_depth(cast(Call, e).args))
	}
	if k == EX_COMPOSITE {
		return sb_max(sb_list_depth(cast(Composite, e).elems), sb_list_depth(cast(Composite, e).keys))
	}
	if k == EX_MEM && cast(MemExpr, e).index == 0 && cast(MemExpr, e).off == 0 && cast(Node, cast(MemExpr, e).base).kind == EX_IDENT && cast(IdentExpr, cast(MemExpr, e).base).ref != 0 && cast(Sym, cast(IdentExpr, cast(MemExpr, e).base).ref).cell_of != 0 {
		// A variable kept in a cell.
		return sb_sym_depth(cast(Sym, cast(Sym, cast(IdentExpr, cast(MemExpr, e).base).ref).cell_of))
	}
	if k == EX_MEM && cast(MemExpr, e).index == 0 && cast(MemExpr, e).off == 0 && sb_env_index(cast(MemExpr, e).base) >= 0 {
		// A captured variable, read through the closure's environment.
		return sb_sym_depth(vec_get(cast(Fn, ck_fn).captures, sb_env_index(cast(MemExpr, e).base)))
	}
	return ck_scope_depth
}

// sb_env_index is i when e reads the cell address of the current closure's capture i, or -1.
fn sb_env_index(e i64) i64 {
	if cast(i64, ck_fn) == 0 || cast(Fn, ck_fn).env_sym == 0 || cast(Node, e).kind != EX_MEM || cast(MemExpr, e).index != 0 || cast(MemExpr, e).off < 16 {
		return -1
	}
	let b = cast(MemExpr, e).base
	if cast(Node, b).kind != EX_IDENT || cast(IdentExpr, b).ref != cast(Fn, ck_fn).env_sym || cast(MemExpr, e).off / 8 - 2 >= sb_len(cast(Vec[i64], cast(Fn, ck_fn).captures)) {
		return -1
	}
	return cast(MemExpr, e).off / 8 - 2
}

// sb_root is the variable a target or argument stores into (x, x[i], x.f), or 0.
fn sb_root(e i64) Sym {
	let k = cast(Node, e).kind
	if k == EX_IDENT {
		if cast(IdentExpr, e).ref != 0 {
			return cast(Sym, cast(IdentExpr, e).ref)
		}
		return cast(Sym, sb_lookup(cast(IdentExpr, e).name))
	}
	if k == EX_INDEX {
		return sb_root(cast(IndexExpr, e).x)
	}
	if k == EX_SELECT {
		return sb_root(cast(SelectExpr, e).x)
	}
	if k == EX_MUTARG {
		return sb_root(cast(MutArg, e).x)
	}
	return cast(Sym, 0)
}

// sb_store reports storing a value as deep as d into variable s, when s outlives the value.
fn sb_store(pos i64, s Sym, d i64) {
	if cast(i64, s) == 0 || s.kind != SYM_LOCAL || sb_type(cast(Ty, s.type_)) == 0 || d <= s.scope_at {
		return
	}
	let e = err_code(pos, cstr("E640 SCOPE_ESCAPE"))
	buf_str(e, sb_noun(cast(Ty, s.type_)))
	buf_str(e, cstr(" cannot outlive its scope: '"))
	buf_str(e, s.name)
	buf_str(e, cstr("' is declared outside the scope this value belongs to, which ends first; declare it inside that scope"))
	err_end(cast(Buf, e))
}

// sb_assign checks target = value (before either is checked).
fn sb_assign(pos i64, target i64, v i64) {
	if ck_trusted != 0 || v == 0 || cast(Node, v).type_ != 0 {
		// Checked values are the checker's own temporaries, checked where they were made.
		return
	}
	let root = sb_root(target)
	if cast(i64, root) == 0 || sb_type(cast(Ty, root.type_)) == 0 {
		return
	}
	if cast(Node, v).kind == EX_CALL && cast(Call, v).name != 0 && streq(cast(Call, v).name, cstr("append")) != 0 && sb_len(cast(Call, v).args) > 0 && sb_root(vec_get(cast(Call, v).args, 0)) == root {
		// xs = append(xs, ...): the call's own check covers what goes into xs.
		return
	}
	sb_store(pos, root, sb_depth(v))
}

// sb_holder is the variable argument a of a call keeps the other arguments in (i: its place,
// counting a method's receiver as 0 when it has one), or 0.
fn sb_holder(e Call, a Node, i i64) i64 {
	if a.kind == EX_MUTARG {
		let r = sb_root(cast(i64, a))
		if cast(i64, r) != 0 && sb_type(cast(Ty, r.type_)) != 0 {
			return cast(i64, r)
		}
		return 0
	}
	let r = sb_root(cast(i64, a))
	if cast(i64, r) == 0 || r.kind != SYM_LOCAL || sb_type(cast(Ty, r.type_)) == 0 {
		return 0
	}
	if cast(i64, sb_types) != 0 && r.type_ == vec_get(sb_types, 0) && a.kind == EX_IDENT {
		return cast(i64, r)
	}
	if i == 0 && e.name != 0 && (streq(e.name, cstr("append")) != 0 || streq(e.name, cstr("copy")) != 0) {
		return cast(i64, r)
	}
	return 0
}

// sb_call checks a call before it is checked: no argument may hand a holder (sb_holder) a
// task handle or scope that ends before the holder does.
fn sb_call(e Call) {
	if ck_trusted != 0 {
		return
	}
	let xs = vec_new[Node]()
	let x = e.callee
	if x != 0 && cast(Node, x).kind == EX_SELECT {
		vec_push(xs, cast(Node, cast(SelectExpr, x).x))
	}
	let args = cast(Vec[i64], e.args)
	mut i = 0
	for cast(i64, args) != 0 && i < args.len {
		vec_push(xs, cast(Node, vec_get(args, i)))
		i = i + 1
	}
	if xs.len < 2 {
		return
	}
	let off = xs.len - sb_len(args)
	i = 0
	for i < xs.len {
		let h = cast(Sym, sb_holder(e, vec_get(xs, i), i - off))
		mut j = 0
		for cast(i64, h) != 0 && j < xs.len {
			let a = vec_get(xs, j)
			if j != i && sb_depth(cast(i64, a)) > h.scope_at {
				let m = err_code(a.pos, cstr("E640 SCOPE_ESCAPE"))
				buf_str(m, cstr("a task handle cannot outlive its scope: this argument belongs to a scope that ends before '"))
				buf_str(m, h.name)
				buf_str(m, cstr("', which the call may keep it in"))
				err_end(cast(Buf, m))
			}
			j = j + 1
		}
		i = i + 1
	}
}

// sb_captures checks what closure f (made by literal e) captures: one that may outlive the
// scope (kept or detached) no task handle or scope at all, and a child spawned on scope s only
// those of s or of a scope around it.
fn sb_captures(e i64, f Fn) {
	if ck_trusted != 0 {
		return
	}
	mut limit_ = -1
	if cast(FuncLit, e).scoped != 0 {
		limit_ = 0
		let ss = cast(Sym, sb_lookup(cast(FuncLit, e).scoped))
		if cast(i64, ss) != 0 {
			limit_ = ss.scope_at
		}
	} else if f.escapes == 0 {
		// Called only while its maker runs: it may use everything its maker sees.
		return
	}
	let caps = cast(Vec[i64], f.captures)
	mut i = 0
	for i < sb_len(caps) {
		let os = cast(Sym, vec_get(caps, i))
		if cast(i64, os) != 0 && sb_type(cast(Ty, os.type_)) != 0 && (limit_ < 0 || os.scope_at > limit_) {
			let m = err_code(cast(Node, e).pos, cstr("E640 SCOPE_ESCAPE"))
			if limit_ >= 0 {
				buf_str(m, cstr("a child of scope '"))
				buf_str(m, cast(FuncLit, e).scoped)
				buf_str(m, cstr("' cannot capture '"))
				buf_str(m, os.name)
				buf_str(m, cstr("', "))
				buf_str(m, sb_noun(cast(Ty, os.type_)))
				buf_str(m, cstr(" of a scope inside it: the child may outlive that scope"))
			} else if cast(i64, ck_detached) != 0 && vec_has(cast(Vec[i64], ck_detached), cast(i64, f)) != 0 {
				buf_str(m, cstr("detach cannot capture '"))
				buf_str(m, os.name)
				buf_str(m, cstr("', "))
				buf_str(m, sb_noun(cast(Ty, os.type_)))
				buf_str(m, cstr(": a detached task outlives every scope"))
			} else {
				buf_str(m, cstr("a closure that may be kept cannot capture '"))
				buf_str(m, os.name)
				buf_str(m, cstr("', "))
				buf_str(m, sb_noun(cast(Ty, os.type_)))
				buf_str(m, cstr(", which must not outlive its scope block: use it in a child spawned on the scope, or in a closure only passed to a call that runs it"))
			}
			err_end(cast(Buf, m))
		}
		i = i + 1
	}
}

// sb_defer checks a deferred call (already checked): it runs when the function returns, after
// every scope inside the function has ended.
fn sb_defer(pos i64, call Call) {
	if ck_trusted != 0 || ck_scope_depth == ck_fn_base {
		return
	}
	mut d = sb_depth(call.callee)
	let args = cast(Vec[i64], call.args)
	mut i = 0
	for cast(i64, args) != 0 && i < args.len {
		let a = cast(Node, vec_get(args, i))
		if sb_type(cast(Ty, a.type_)) != 0 {
			d = sb_max(d, sb_depth(cast(i64, a)))
		}
		i = i + 1
	}
	if d > ck_fn_base {
		err_code_at(pos, cstr("E640 SCOPE_ESCAPE"), cstr("defer runs when the function returns, after the scope of the task handle it uses has ended: make the call inside the scope instead"))
	}
}

// spawn_value lowers s.spawn(f), for f a function with a value (func() !T), to
// rt_spawn_value[T](s, f): its handle, a spawnedOf[T], gives the value through wait() !T
// (#232). It gives 0 when the call is not one, and the method call is checked as usual.
fn spawn_value(e i64, x i64, xt i64, m i64) i64 {
	if streq(m, cstr("spawn")) == 0 || sb_type(cast(Ty, xt)) == 0 || xt != vec_get(sb_types, 0) || cast(Call, e).args.len != 1 {
		return 0
	}
	let a = vec_get(cast(Call, e).args, 0)
	let ft = cast(Ty, chk(cast(Node, a), 0))
	if kind_of(ft) != K_FUNC || cast(Vec[i64], ft.results).len != 2 || kind_of(cast(Ty, vec_get(cast(Vec[i64], ft.results), 1))) != K_ERROR || cast(Vec[i64], ft.fields).len != 0 {
		return 0
	}
	let g = find_fn(cstr("rt_spawn_value"))
	if cast(i64, g) == 0 {
		return 0
	}
	let targs = vec_new[i64]()
	vec_push(targs, vec_get(cast(Vec[i64], ft.results), 0))
	let inst = instantiate_fn(cast(Fn, g), cast(Vec[Ty], cast(Vec[i64], targs)), cast(Node, e).pos)
	cast(Call, e).args = cast(Vec[i64], args2(x, a))
	cast(Call, e).callee = 0
	cast(Call, e).name = inst.qname
	return direct_call(cast(Call, e), inst)
}

// ---- defer ----
//
// defer f(a, b) evaluates f, a and b now and sets a flag; every return (including the
// ones try makes) and the end of the function then run the flagged calls, last first.
shared mut ck_defers Vec[i64] // the current function's defers: [flag, call]
shared mut ck_defer_mark i64 // the current function's defer chain mark ($m), when its defers use the chain

// The defer chain (#230): each defer stores its callee and arguments in a record that a
// generated defer$N(r) calls, pushed on the task's chain; returns run the chain down to the
// function's mark, and a panic runs it too, so deferred calls also run while a panic unwinds.
fn lower_defer(s i64) {
	let pos = cast(Node, s).pos
	if ck_loops > 0 {
		err_code_at(pos, cstr("E270 DEFER"), cstr("defer inside a loop would run once per function, not per iteration: move the loop body into a function"))
		return
	}
	let call = cast(GoStmt, s).call
	let t = chk(cast(Node, call), 0)
	let tk = kind_of(cast(Ty, t))
	if tk == K_ERROR || (tk == K_TUPLE && tuple_has_fault(cast(Ty, t)) != 0) {
		err_code_at(pos, cstr("E270 DEFER"), cstr("defer would ignore the fault this call returns: defer a function that handles it"))
		return
	}
	if cast(Node, call).kind != EX_CALL || cast(Call, call).intrinsic != 0 {
		err_code_at(pos, cstr("E055 DEFER_CALL"), cstr("defer needs a plain function call (wrap anything else in a function)"))
		return
	}
	sb_defer(pos, cast(Call, call))
	let b = cast(Block, empty_block(pos))
	b.flat = 1
	if cast(Call, call).callee != 0 {
		let ct = temp(pos, cast(Call, call).callee, cast(Node, cast(Call, call).callee).type_)
		vec_push(cast(Vec[i64], b.stmts), cast(i64, ct))
		cast(Call, call).callee = sym_ref_node(pos, cast(Sym, ct.sym))
	}
	let args = cast(Call, call).args
	mut i = 0
	for i < args.len {
		let a = cast(Node, vec_get(args, i))
		let at = temp(pos, cast(i64, a), a.type_)
		vec_push(cast(Vec[i64], b.stmts), cast(i64, at))
		args.data[i] = sym_ref_node(pos, cast(Sym, at.sym))
		i = i + 1
	}
	let flag = declare_local(pos, cstr("$"), ty_bool)
	if cast(i64, ck_defers) == 0 {
		ck_defers = vec_new[i64]()
		ck_defer_mark = declare_local(pos, cstr("$"), ty_int)
	}
	defer_record(pos, b, cast(Call, call))
	vec_push(cast(Vec[i64], ck_defers), pair(flag, call))
	replace_node(s, cast(i64, b))
}

// defer_record stores call's callee and arguments (already in temps) in a chain record and
// pushes it with a generated defer$N that makes the call from the record.
fn defer_record(pos i64, b Block, call Call) {
	let args = cast(Vec[i64], call.args)
	mut n = args.len
	if call.callee != 0 {
		n = n + 1
	}
	let rec = temp(pos, rt_call(pos, cstr("rt_defer_rec"), args1(mk_int(pos, 2 * n, ty_int)), ty_int), ty_int)
	vec_push(cast(Vec[i64], b.stmts), cast(i64, rec))
	mut slot = 0
	if call.callee != 0 {
		let ct = cast(Sym, cast(IdentExpr, call.callee).ref).type_
		vec_push(cast(Vec[i64], b.stmts), assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, cast(Sym, rec.sym)), 0, 0, 16 + 16 * slot, ct), sym_ref_node(pos, cast(Sym, cast(IdentExpr, call.callee).ref))))
		slot = slot + 1
	}
	mut i = 0
	for i < args.len {
		let a = cast(Sym, cast(IdentExpr, vec_get(args, i)).ref)
		vec_push(cast(Vec[i64], b.stmts), assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, cast(Sym, rec.sym)), 0, 0, 16 + 16 * slot, a.type_), sym_ref_node(pos, a)))
		slot = slot + 1
		i = i + 1
	}
	let thunk = cast(Fn, defer_thunk(pos, call))
	let ref_ = node_new(EX_FUNCREF, pos)
	cast(FuncRef, ref_).fn_ = cast(i64, thunk)
	cast(Node, ref_).type_ = thunk.type_
	vec_push(cast(Vec[i64], b.stmts), expr_stmt(cast(Node, rt_call(pos, cstr("rt_defer_push"), args2(sym_ref_node(pos, cast(Sym, rec.sym)), ref_), ty_void))))
}

// defer_thunk builds defer$N(r), which makes call with the callee and arguments in record r.
fn defer_thunk(pos i64, call Call) i64 {
	lifted_count = lifted_count + 1
	let f = fn_new(pos, cstr("defer"))
	let nb = buf_new()
	buf_str(nb, cstr("defer$"))
	buf_int(nb, lifted_count)
	buf_byte(nb, 0)
	f.qname = nb.data
	f.name = nb.data
	f.lifted = 2
	f.file = ck_fn.file
	vec_push(cast(Vec[i64], f.params), cstr("r"))
	vec_push(cast(Vec[i64], f.ptypes), ty_int)
	f.type_ = func_of(cast(Vec[i64], f.ptypes), cast(Vec[i64], f.rtypes), 0)
	f.locals = cast(Vec[Sym], vec_new[i64]())
	f.body = empty_block(pos)
	vec_push(prog_fns, cast(Fn, f))
	let r = sym_new(SYM_LOCAL, cstr("r"), pos)
	r.type_ = ty_int
	r.slot = 0
	f.slots = 1
	vec_push(cast(Vec[i64], f.locals), cast(i64, r))
	let c = cast(Call, node_new(EX_CALL, pos))
	replace_node(cast(i64, c), cast(i64, call))
	mut slot = 0
	if call.callee != 0 {
		c.callee = mk_mem(pos, sym_ref_node(pos, r), 0, 0, 16 + 16 * slot, cast(Sym, cast(IdentExpr, call.callee).ref).type_)
		slot = slot + 1
	}
	let args = vec_new[i64]()
	mut i = 0
	for i < cast(Vec[i64], call.args).len {
		let a = cast(Sym, cast(IdentExpr, vec_get(cast(Vec[i64], call.args), i)).ref)
		vec_push(args, mk_mem(pos, sym_ref_node(pos, r), 0, 0, 16 + 16 * slot, a.type_))
		slot = slot + 1
		i = i + 1
	}
	c.args = cast(Vec[i64], args)
	vec_push(cast(Block, f.body).stmts, expr_stmt(cast(Node, c)))
	return cast(i64, f)
}

fn tuple_has_fault(t Ty) i64 {
	mut i = 0
	for i < cast(Vec[i64], t.fields).len {
		if kind_of(cast(Ty, vec_get(cast(Vec[i64], t.fields), i))) == K_ERROR {
			return 1
		}
		i = i + 1
	}
	return 0
}

// defer_calls appends the flagged deferred calls to stmts, last deferred first.
fn defer_calls(pos i64, stmts Vec[i64]) {
	if ck_defer_mark != 0 {
		vec_push(stmts, expr_stmt(cast(Node, rt_call(pos, cstr("rt_defer_run"), args1(sym_ref_node(pos, cast(Sym, ck_defer_mark))), ty_void))))
		return
	}
	mut j = ck_defers.len - 1
	for j >= 0 {
		let d = cast(Vec[i64], vec_get(ck_defers, j))
		let call = cast(Call, vec_get(d, 1))
		let c = cast(Call, node_new(EX_CALL, pos))
		replace_node(cast(i64, c), cast(i64, call))
		let args = vec_new[i64]()
		mut i = 0
		for i < cast(Vec[i64], call.args).len {
			vec_push(args, sym_ref_node(pos, cast(Sym, cast(IdentExpr, vec_get(cast(Vec[i64], call.args), i)).ref)))
			i = i + 1
		}
		c.args = cast(Vec[i64], args)
		if cast(Call, call).callee != 0 {
			c.callee = sym_ref_node(pos, cast(Sym, cast(IdentExpr, cast(Call, call).callee).ref))
		}
		let ifs = cast(IfStmt, node_new(ST_IF, pos))
		ifs.cond = sym_ref_node(pos, cast(Sym, vec_get(d, 0)))
		ifs.then = empty_block(pos)
		vec_push(cast(Block, ifs.then).stmts, expr_stmt(cast(Node, c)))
		vec_push(stmts, cast(i64, ifs))
		j = j - 1
	}
}

fn finish_defers(f Fn) {
	let body = cast(Block, f.body)
	defer_returns(cast(Vec[i64], body.stmts))
	let pos = f.pos
	let init = vec_new[i64]()
	mut i = 0
	for i < ck_defers.len {
		vec_push(init, let_stmt(pos, cast(Sym, vec_get(cast(Vec[i64], vec_get(ck_defers, i)), 0)), mk_int(pos, 0, ty_bool)))
		i = i + 1
	}
	if ck_defer_mark != 0 {
		vec_push(init, let_stmt(pos, cast(Sym, ck_defer_mark), rt_call(pos, cstr("rt_defer_mark"), cast(i64, vec_new[i64]()), ty_int)))
	}
	use_cell_init(f, cast(Vec[i64], init))
	i = 0
	for i < cast(Vec[i64], body.stmts).len {
		vec_push(init, vec_get(cast(Vec[i64], body.stmts), i))
		i = i + 1
	}
	if ends_in_return(cast(Vec[i64], body.stmts)) == 0 {
		defer_calls(pos, cast(Vec[i64], init))
	}
	body.stmts = cast(Vec[i64], init)
}

fn defer_returns(v Vec[i64]) {
	mut i = 0
	for i < v.len {
		defer_stmt(vec_get(v, i))
		i = i + 1
	}
}

fn defer_stmt(s i64) {
	let k = cast(Node, s).kind
	if k == ST_BLOCK {
		defer_returns(cast(Block, s).stmts)
	} else if k == ST_IF {
		defer_returns(cast(Block, cast(IfStmt, s).then).stmts)
		if cast(IfStmt, s).else_ != 0 {
			defer_stmt(cast(IfStmt, s).else_)
		}
	} else if k == ST_WHILE {
		defer_returns(cast(Block, cast(WhileStmt, s).body).stmts)
	} else if k == ST_RETURN {
		let pos = cast(Node, s).pos
		let b = cast(Block, empty_block(pos))
		b.flat = 1
		let r = cast(ReturnStmt, node_new(ST_RETURN, pos))
		if cast(ReturnStmt, s).value != 0 {
			let v = cast(Node, cast(ReturnStmt, s).value)
			if kind_of(cast(Ty, v.type_)) == K_TUPLE {
				err_code_at(pos, cstr("E270 DEFER"), cstr("in a function with defer, assign a multi-value call's results before returning them"))
			}
			let t = temp(pos, cast(i64, v), v.type_)
			vec_push(cast(Vec[i64], b.stmts), cast(i64, t))
			r.value = sym_ref_node(pos, cast(Sym, t.sym))
		}
		if cast(i64, cast(ReturnStmt, s).values) != 0 {
			let vals = vec_new[i64]()
			mut i = 0
			for i < cast(ReturnStmt, s).values.len {
				let rv = cast(Node, vec_get(cast(ReturnStmt, s).values, i))
				let t2 = temp(pos, cast(i64, rv), rv.type_)
				vec_push(cast(Vec[i64], b.stmts), cast(i64, t2))
				vec_push(vals, sym_ref_node(pos, cast(Sym, t2.sym)))
				i = i + 1
			}
			r.values = cast(Vec[i64], vals)
		}
		defer_calls(pos, cast(Vec[i64], b.stmts))
		use_return(pos, b, r)
		vec_push(cast(Vec[i64], b.stmts), cast(i64, r))
		replace_node(s, cast(i64, b))
	}
}

fn vec_len_of(v Vec[i64]) i64 {
	return v.len
}

// lower_with_init turns `if init; c {}` / `for init; c; post {}` into { init; stmt }.
fn lower_with_init(s Node, field i64) {
	let init = cast(i64, s)[field]
	let inner = node_new(s.kind, s.pos)
	replace_node(inner, cast(i64, s))
	inner[field] = 0
	let b = cast(Block, empty_block(s.pos))
	vec_push(cast(Vec[i64], b.stmts), init)
	vec_push(cast(Vec[i64], b.stmts), inner)
	replace_node(cast(i64, s), cast(i64, b))
	check_scoped(cast(Block, s))
}

fn check_cond(c Node) {
	let t = chk(c, ty_bool)
	if is_bool_t(t) == 0 {
		err_code_type(c.pos, cstr("E232 CONDITION"), cstr("condition must be a bool, not "), t, cstr(""))
	}
}

fn check_let(s i64) {
	let pos = cast(Node, s).pos
	mut t = 0
	if cast(LetStmt, s).type_ != 0 {
		t = resolve_type(cast(LetStmt, s).type_)
	}
	let init = cast(Node, cast(LetStmt, s).init)
	if cast(i64, init) != 0 && (init.kind == EX_TRY || init.kind == EX_CATCH || init.kind == EX_WRAP) {
		lower_try_stmt(s, cast(i64, init), 1, t)
		return
	}
	if cast(i64, init) != 0 && init.kind == EX_MATCH {
		check_match_let(s, init, t)
		return
	}
	if cast(i64, init) != 0 {
		let it = chk(init, t)
		check_value(pos, it)
		if t != 0 {
			check_assignable(init, it, cast(Ty, t))
			if is_untyped(it) != 0 {
				reconvert(init, t)
			}
		} else {
			t = default_type(it)
			if kind_of(cast(Ty, t)) == K_NIL {
				err_code_at(init.pos, cstr("E233 UNTYPED_NIL"), cstr("use of untyped nil"))
			}
			if is_untyped(it) != 0 {
				reconvert(init, t)
			}
		}
	} else if array_len(cast(LetStmt, s).type_) > 0 {
		cast(LetStmt, s).init = array_make(pos, cast(Ty, t), array_len(cast(LetStmt, s).type_))
	} else {
		cast(LetStmt, s).init = zero_value(pos, t)
	}
	if streq(cast(LetStmt, s).name, cstr("_")) != 0 {
		if kind_of(cast(Ty, t)) == K_ERROR {
			err_code_at(pos, cstr("E410 UNCHECKED_FAULT"), cstr("a fault cannot be discarded with _"))
		}
		replace_node(s, expr_stmt(cast(Node, cast(LetStmt, s).init)))
		return
	}
	cast(LetStmt, s).sym = declare_local(pos, cast(LetStmt, s).name, t)
	len_alias_remember(cast(Sym, cast(LetStmt, s).sym), cast(i64, init))
	if cast(Sym, cast(LetStmt, s).sym).cell != 0 {
		let sym = cast(Sym, cast(LetStmt, s).sym)
		let csym = sym.cell_sym
		let alloc_call = rt_call(pos, cstr("rt_alloc"), args1(mk_int(pos, 8, ty_int)), ty_int)
		let stmts = vec_new[i64]()
		vec_push(stmts, let_stmt(pos, cast(Sym, csym), alloc_call))
		vec_push(stmts, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, cast(Sym, csym)), 0, 0, 0, t), cast(LetStmt, s).init))
		let blk = cast(Block, node_new(ST_BLOCK, pos))
		blk.stmts = cast(Vec[i64], stmts)
		blk.flat = 1
		replace_node(s, cast(i64, blk))
	}
}

// check_target checks an assignment target and returns its type; it rewrites slice
// elements and fields into word accesses and leaves map/byte stores to the caller.
fn check_target(t i64) i64 {
	let k = cast(Node, t).kind
	if k == EX_IDENT {
		let s = lookup_name(cast(IdentExpr, t).name)
		if cast(i64, s) == 0 {
			let u = err_code(cast(Node, t).pos, cstr("E103 UNDEFINED"))
			buf_str(u, cstr("undefined: "))
			buf_str(u, cast(IdentExpr, t).name)
			err_end(cast(Buf, u))
			return ty_int
		}
		if s.kind == SYM_CONST {
			err_code_quoted(cast(Node, t).pos, cstr("E710 NOT_ASSIGNABLE"), cstr("cannot assign to constant "), cast(IdentExpr, t).name, cstr(""))
		} else if s.kind == SYM_FUNC {
			err_code_quoted(cast(Node, t).pos, cstr("E710 NOT_ASSIGNABLE"), cstr("cannot assign to function "), cast(IdentExpr, t).name, cstr(""))
		}
		if s.mut_ != 0 {
			// The caller passed the struct, optional or map itself: assigning the parameter
			// variable would only rebind the callee's copy and be silently lost (as mut on a
			// str is rejected). Slices stay assignable for `xs = append(xs, v)`.
			let mk = kind_of(cast(Ty, s.type_))
			if mk == K_STRUCT || mk == K_OPT || mk == K_MAP || mk == K_DYN {
				let u = err_code(cast(Node, t).pos, cstr("E704 MUT_PARAM_REBIND"))
				buf_str(u, cstr("cannot assign to mut parameter '"))
				buf_str(u, cast(IdentExpr, t).name)
				buf_str(u, cstr("': it would rebind only this function's copy, and the caller would not see it; modify its fields or elements, or return the new value"))
				err_end(cast(Buf, u))
			}
		}
		if s.captured != 0 {
			let env_ref = sym_ref_node(cast(Node, t).pos, cast(Sym, cast(Fn, ck_fn).env_sym))
			let cell_addr = mk_mem(cast(Node, t).pos, env_ref, 0, 0, 8 * (2 + s.cap_idx), ty_int)
			let val = mk_mem(cast(Node, t).pos, cell_addr, 0, 0, 0, s.type_)
			replace_node(t, val)
			return s.type_
		}
		if s.cell != 0 {
			let cell_ref = sym_ref_node(cast(Node, t).pos, cast(Sym, s.cell_sym))
			let val = mk_mem(cast(Node, t).pos, cell_ref, 0, 0, 0, s.type_)
			replace_node(t, val)
			return s.type_
		}
		cast(IdentExpr, t).ref = cast(i64, s)
		cast(Node, t).type_ = s.type_
		return s.type_
	}
	if k == EX_INDEX || k == EX_SELECT {
		return chk(cast(Node, t), 0)
	}
	if k == EX_MEM {
		return cast(Node, t).type_
	}
	err_code_at(cast(Node, t).pos, cstr("E710 NOT_ASSIGNABLE"), cstr("cannot assign to this expression"))
	return ty_int
}

fn check_assign(s i64) {
	let target = cast(AssignStmt, s).target
	let v = cast(Node, cast(AssignStmt, s).value)
	sb_assign(cast(Node, s).pos, target, cast(i64, v))
	if (v.kind == EX_TRY || v.kind == EX_CATCH || v.kind == EX_WRAP) {
		lower_try_stmt(s, cast(i64, v), 2, 0)
		return
	}
	if v.kind == EX_MATCH {
		check_match_assign(cast(Node, s), target, cast(i64, v))
		return
	}
	if cast(Node, target).kind == EX_IDENT && streq(cast(IdentExpr, target).name, cstr("_")) != 0 {
		let vt = chk(v, 0)
		if (kind_of(cast(Ty, vt)) == K_ERROR || (kind_of(cast(Ty, vt)) == K_TUPLE && tuple_has_fault(cast(Ty, vt)) != 0)) {
			err_code_at(cast(Node, s).pos, cstr("E410 UNCHECKED_FAULT"), cstr("a fault cannot be discarded with _"))
		} else {
			check_value(cast(Node, s).pos, vt)
		}
		replace_node(s, expr_stmt(v))
		return
	}
	// Map stores become runtime calls. x op= v shares the target node with v, so take
	// the target's parts before checking v.
	if cast(Node, target).kind == EX_INDEX {
		let tx = cast(IndexExpr, target).x
		let ti = cast(IndexExpr, target).i
		let xt = cast(Ty, chk(cast(Node, tx), 0))
		if kind_of(xt) == K_MAP {
			let kt = chk(cast(Node, ti), xt.key)
			check_assignable(cast(Node, ti), kt, cast(Ty, xt.key))
			if is_untyped(kt) != 0 {
				reconvert(cast(Node, ti), xt.key)
			}
			let vt = chk(v, xt.elem)
			check_assignable(v, vt, cast(Ty, xt.elem))
			if is_untyped(vt) != 0 {
				reconvert(v, xt.elem)
			}
			let store = cast(Call, map_set_call(cast(Node, s).pos, tx, ti, cast(i64, v), xt.key))
			store.store = 1
			replace_node(s, expr_stmt(cast(Node, store)))
			return
		}
		if kind_of(xt) == K_STRING {
			err_code_at(cast(Node, target).pos, cstr("E710 NOT_ASSIGNABLE"), cstr("cannot assign to a str index (strings are immutable)"))
			return
		}
	}
	let tt = check_target(target)
	let vt = chk(v, tt)
	check_assignable(v, vt, cast(Ty, tt))
	if is_untyped(vt) != 0 {
		reconvert(v, tt)
	}
	narrow_kill(target)
	if cast(Node, target).kind == EX_IDENT {
		len_alias_invalidate(cast(IdentExpr, target).ref)
	}
}

fn check_assignable(e Node, from i64, to Ty) {
	if kind_of(to) == K_DYN || (kind_of(to) == K_OPT && kind_of(cast(Ty, to.elem)) == K_DYN) {
		sb_forbid(e.pos, from, cstr("a dyn value cannot hold "))
	}
	// Concrete objects convert to dyn S implicitly where they satisfy the shape. A dyn
	// value keeps its exact shape; optionality can be added, but never removed.
	if is_dyn_value(to) != 0 && is_dyn_value(cast(Ty, from)) != 0 {
		if dyn_type(cast(Ty, from)) != dyn_type(to) {
			err_code_at(e.pos, cstr("E514 DYN_WIDENING"), cstr("dyn values do not widen (no downcast, no dyn-to-dyn): convert from the concrete value"))
		}
		return
	}
	if kind_of(to) == K_DYN && kind_of(cast(Ty, from)) != K_DYN {
		if kind_of(cast(Ty, from)) != K_STRUCT {
			err_code_type(e.pos, cstr("E516 DYN_OBJECT"), cstr("only a struct or enum can be a dyn object, not "), from, cstr(""))
			return
		}
		let before = error_count
		check_shape(e.pos, cast(Ty, from), cast(Decl, to.gdecl), cast(Vec[i64], to.targs))
		if error_count == before {
			let x = expr_clone(cast(i64, e))
			let cv = cast(Conv, mk_conv(e.pos, x, CV_DYN, cast(i64, to)))
			cv.dyn_table = dyn_table_add(cast(Ty, from), cast(Ty, dyn_type(to)), e.pos)
			replace_node(cast(i64, e), cast(i64, cv))
		}
		return
	}
	if kind_of(to) == K_OPT && kind_of(cast(Ty, to.elem)) == K_DYN && kind_of(cast(Ty, from)) != K_DYN && kind_of(cast(Ty, from)) != K_OPT && kind_of(cast(Ty, from)) != K_NIL {
		if kind_of(cast(Ty, from)) != K_STRUCT {
			err_code_type(e.pos, cstr("E516 DYN_OBJECT"), cstr("only a struct or enum can be a dyn object, not "), from, cstr(""))
			return
		}
		let before = error_count
		check_shape(e.pos, cast(Ty, from), cast(Decl, cast(Ty, to.elem).gdecl), cast(Vec[i64], cast(Ty, to.elem).targs))
		if error_count == before {
			let x = expr_clone(cast(i64, e))
			let cv = cast(Conv, mk_conv(e.pos, x, CV_DYN, cast(i64, to)))
			cv.dyn_table = dyn_table_add(cast(Ty, from), cast(Ty, dyn_type(to)), e.pos)
			replace_node(cast(i64, e), cast(i64, cv))
		}
		return
	}
	if bounded_value(cast(i64, e), cast(Ty, from), to) != 0 {
		return
	}
	if assignable(cast(Ty, from), to) == 0 {
		if is_query_t(to) != 0 && kind_of(cast(Ty, from)) == K_STRING {
			err_code_at(e.pos, cstr("E280 QUERY"), cstr("a query takes a string literal: put values in {{...}} so they are sent apart from the text, never pasted into it"))
			return
		}
		if secret_assign_error(e, from, cast(i64, to)) != 0 {
			return
		}
		err_code_types(e.pos, cstr("E230 TYPE_MISMATCH"), cstr("cannot use "), from, cstr(" as "), cast(i64, to))
	}
}

// check_value rejects a call with no result, or several, where one value is needed.
fn check_value(pos i64, t i64) {
	if kind_of(cast(Ty, t)) == K_VOID || kind_of(cast(Ty, t)) == K_TUPLE {
		err_code_type(pos, cstr("E230 TYPE_MISMATCH"), cstr("cannot use "), t, cstr(" as a value"))
	}
}

fn check_multi(s i64) {
	// Multi-assignment lowers through generated temporaries and can rebind either a
	// remembered length or its source slice. Drop these local facts conservatively.
	len_aliases = vec_new[i64]()
	let pos = cast(Node, s).pos
	let targets = cast(MultiStmt, s).targets
	let values = cast(MultiStmt, s).values
	let define = cast(MultiStmt, s).define
	let out = cast(Block, node_new(ST_BLOCK, pos))
	out.stmts = vec_new[i64]()
	out.flat = 1
	let stmts = cast(Vec[i64], out.stmts)
	let n = targets.len
	let temps = vec_new[i64]()
	if define == 0 && values.len == n {
		// The pairs go through temporaries: check each value against its target here.
		mut si = 0
		for si < n {
			sb_assign(pos, vec_get(targets, si), vec_get(values, si))
			si = si + 1
		}
	}
	if values.len == 1 && n > 1 {
		let v = vec_get(values, 0)
		if (cast(Node, v).kind == EX_TRY || cast(Node, v).kind == EX_CATCH || cast(Node, v).kind == EX_WRAP) {
			lower_try_stmt(s, v, 3, 0)
			return
		}
		// v, ok := m[k]
		if cast(Node, v).kind == EX_INDEX && n == 2 {
			let mt = cast(Ty, chk(cast(Node, cast(IndexExpr, v).x), 0))
			if kind_of(mt) == K_MAP {
				let kt = chk(cast(Node, cast(IndexExpr, v).i), mt.key)
				if is_untyped(kt) != 0 {
					reconvert(cast(Node, cast(IndexExpr, v).i), mt.key)
				}
				let get = map_read(pos, cast(Node, cast(IndexExpr, v).x), cast(IndexExpr, v).i, mt.elem)
				vec_push(stmts, cast(i64, temp(pos, get, mt.elem)))
				vec_push(temps, cast(LetStmt, vec_get(stmts, 0)).sym)
				vec_push(stmts, cast(i64, temp(pos, rt_call(pos, cstr("rt_map_found"), cast(i64, vec_new[i64]()), ty_bool), ty_bool)))
				vec_push(temps, cast(LetStmt, vec_get(stmts, 1)).sym)
				bind_targets(pos, targets, cast(Vec[Sym], cast(Vec[i64], temps)), define, stmts)
				replace_node(s, cast(i64, out))
				return
			}
		}
		let t = cast(Ty, chk(cast(Node, v), 0))
		if kind_of(t) != K_TUPLE || cast(Vec[i64], t.fields).len != n {
			err_code_at(pos, cstr("E234 VALUE_COUNT"), cstr("assignment count mismatch"))
			return
		}
		let cm = cast(CallMultiStmt, node_new(ST_CALLMULTI, pos))
		cm.call = v
		cm.syms = cast(Vec[Sym], vec_new[i64]())
		mut i = 0
		for i < n {
			let ts = declare_local(pos, cstr("$"), vec_get(cast(Vec[i64], t.fields), i))
			vec_push(cast(Vec[i64], cm.syms), ts)
			vec_push(temps, ts)
			i = i + 1
		}
		cast(Node, v).type_ = ty_void
		vec_push(stmts, cast(i64, cm))
		bind_targets(pos, targets, cast(Vec[Sym], cast(Vec[i64], temps)), define, stmts)
		replace_node(s, cast(i64, out))
		return
	}
	if values.len != n {
		err_code_at(pos, cstr("E234 VALUE_COUNT"), cstr("assignment count mismatch"))
		return
	}
	// Evaluate every value first, then assign: a, b = b, a swaps.
	mut i = 0
	for i < n {
		let v = vec_get(values, i)
		mut want = 0
		let tg = vec_get(targets, i)
		if define == 0 && !(cast(Node, tg).kind == EX_IDENT && streq(cast(IdentExpr, tg).name, cstr("_")) != 0) {
			want = check_target_type(tg)
		}
		mut vt = chk(cast(Node, v), want)
		check_value(cast(Node, v).pos, vt)
		if is_untyped(vt) != 0 {
			vt = reconvert(cast(Node, v), default_type(vt))
		}
		let l = temp(pos, v, default_type(vt))
		vec_push(stmts, cast(i64, l))
		vec_push(temps, l.sym)
		i = i + 1
	}
	bind_targets(pos, targets, cast(Vec[Sym], cast(Vec[i64], temps)), define, stmts)
	replace_node(s, cast(i64, out))
}

// check_target_type reports a target's type without rewriting it.
fn check_target_type(t i64) i64 {
	if cast(Node, t).kind == EX_IDENT {
		let s = lookup_name(cast(IdentExpr, t).name)
		if cast(i64, s) != 0 {
			return s.type_
		}
	}
	return 0
}

fn splice_list(s Node, block i64) {
	let l = node_new(ST_LIST, s.pos)
	replace_node(cast(i64, s), block)
}

// bind_targets assigns (or, for :=, declares) each target from its temp.
fn bind_targets(pos i64, targets Vec[i64], temps Vec[Sym], define i64, stmts Vec[i64]) {
	mut i = 0
	for i < targets.len {
		let tg = vec_get(targets, i)
		let ts = vec_get(temps, i)
		if cast(Node, tg).kind == EX_IDENT && streq(cast(IdentExpr, tg).name, cstr("_")) != 0 {
			if kind_of(cast(Ty, ts.type_)) == K_ERROR {
				err_code_at(cast(Node, tg).pos, cstr("E410 UNCHECKED_FAULT"), cstr("a fault cannot be discarded with _"))
			}
			i = i + 1
			continue
		}
		if define != 0 {
			if cast(Node, tg).kind != EX_IDENT {
				err_code_at(cast(Node, tg).pos, cstr("E020 UNEXPECTED"), cstr("expected a name before :="))
			} else if in_current_scope(cast(IdentExpr, tg).name) == 0 {
				let l = cast(LetStmt, node_new(ST_LET, pos))
				l.name = cast(IdentExpr, tg).name
				l.init = sym_ref_node(pos, ts)
				let sym = cast(Sym, declare_local(pos, cast(IdentExpr, tg).name, ts.type_))
				l.sym = cast(i64, sym)
				if sym.cell != 0 {
					let csym = sym.cell_sym
					let alloc_call = rt_call(pos, cstr("rt_alloc"), args1(mk_int(pos, 8, ty_int)), ty_int)
					vec_push(stmts, let_stmt(pos, cast(Sym, csym), alloc_call))
					vec_push(stmts, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, cast(Sym, csym)), 0, 0, 0, ts.type_), sym_ref_node(pos, ts)))
					i = i + 1
					continue
				}
				vec_push(stmts, cast(i64, l))
				i = i + 1
				continue
			}
		}
		let a = assign_stmt(pos, tg, sym_ref_node(pos, ts))
		check_assign(a)
		vec_push(stmts, a)
		i = i + 1
	}
}

fn check_return(s i64) {
	let f = cast(Fn, ck_fn)
	let want = cast(Vec[i64], f.rtypes)
	let pos = cast(Node, s).pos
	if cast(ReturnStmt, s).value != 0 && (cast(Node, cast(ReturnStmt, s).value).kind == EX_TRY || cast(Node, cast(ReturnStmt, s).value).kind == EX_CATCH || cast(Node, cast(ReturnStmt, s).value).kind == EX_WRAP) {
		lower_try_stmt(s, cast(ReturnStmt, s).value, 4, 0)
		return
	}
	if cast(ReturnStmt, s).value != 0 && cast(Node, cast(ReturnStmt, s).value).kind == EX_MATCH {
		// return match ...: each arm returns its value (#225).
		replace_node(s, lower_match(cast(ReturnStmt, s).value, MATCH_RETURN, cast(Vec[Sym], cast(Vec[i64], 0))))
		return
	}
	if f.bang != 0 {
		// In a !T function, return gives the values; the fault slot is filled with nil.
		let nw = want.len - 1
		if cast(i64, cast(ReturnStmt, s).values) != 0 {
			if cast(ReturnStmt, s).values.len == want.len {
				err_code_at(pos, cstr("E412 RETURN_FAULT"), cstr("a !T function returns only its values: use fail to return a fault"))
				return
			}
			if cast(ReturnStmt, s).values.len == nw {
				vec_push(cast(ReturnStmt, s).values, mk_int(pos, 0, ty_error))
			}
		} else if cast(ReturnStmt, s).value != 0 {
			if nw == 0 {
				err_code_at(pos, cstr("E412 RETURN_FAULT"), cstr("a ! function returns no value: use fail to return a fault"))
				return
			}
			if nw == 1 {
				let rv = vec_new[i64]()
				vec_push(rv, cast(ReturnStmt, s).value)
				vec_push(rv, mk_int(pos, 0, ty_error))
				cast(ReturnStmt, s).values = cast(Vec[i64], rv)
				cast(ReturnStmt, s).value = 0
			}
		} else if nw == 0 {
			cast(ReturnStmt, s).value = mk_int(pos, 0, ty_error)
			return
		}
	}
	if cast(i64, cast(ReturnStmt, s).values) != 0 {
		let vals = cast(ReturnStmt, s).values
		if vals.len != want.len {
			err_code_at(pos, cstr("E262 RETURN_COUNT"), cstr("wrong number of return values"))
			return
		}
		mut i = 0
		for i < vals.len {
			let v = vec_get(vals, i)
			let vt = chk(cast(Node, v), vec_get(want, i))
			check_assignable(cast(Node, v), vt, cast(Ty, vec_get(want, i)))
			if is_untyped(vt) != 0 {
				reconvert(cast(Node, v), vec_get(want, i))
			}
			i = i + 1
		}
		return
	}
	let v = cast(Node, cast(ReturnStmt, s).value)
	if cast(i64, v) == 0 {
		if want.len > 0 {
			err_code_at(pos, cstr("E262 RETURN_COUNT"), cstr("missing return value"))
		}
		return
	}
	if want.len == 0 {
		err_code_at(v.pos, cstr("E262 RETURN_COUNT"), cstr("too many return values"))
		chk(v, 0)
		return
	}
	if want.len > 1 {
		// return f() where f returns as many values: pass them through.
		let t = cast(Ty, chk(v, 0))
		if kind_of(t) != K_TUPLE || cast(Vec[i64], t.fields).len != want.len {
			err_code_at(pos, cstr("E262 RETURN_COUNT"), cstr("wrong number of return values"))
			return
		}
		let out = cast(Block, empty_block(pos))
		out.flat = 1
		let cm = cast(CallMultiStmt, node_new(ST_CALLMULTI, pos))
		cm.call = cast(i64, v)
		cm.syms = cast(Vec[Sym], vec_new[i64]())
		let vals2 = vec_new[i64]()
		mut i = 0
		for i < want.len {
			let ts = declare_local(pos, cstr("$"), vec_get(cast(Vec[i64], t.fields), i))
			vec_push(cast(Vec[i64], cm.syms), ts)
			vec_push(vals2, sym_ref_node(pos, cast(Sym, ts)))
			i = i + 1
		}
		v.type_ = ty_void
		vec_push(cast(Vec[i64], out.stmts), cast(i64, cm))
		let r = cast(ReturnStmt, node_new(ST_RETURN, pos))
		r.values = cast(Vec[i64], vals2)
		vec_push(cast(Vec[i64], out.stmts), cast(i64, r))
		replace_node(s, cast(i64, out))
		return
	}
	let vt = chk(v, vec_get(want, 0))
	check_assignable(v, vt, cast(Ty, vec_get(want, 0)))
	if is_untyped(vt) != 0 {
		reconvert(v, vec_get(want, 0))
	}
}

// lower_try_stmt compiles the five places try may appear:
//   0 try f()   1 x := try f()   2 x = try f()   3 a, b := try f()   4 return try f()
// into: results := f(); if fault != nil { return zero values..., fault }; then use them.
// With tr an EX_CATCH (E catch name { ... }) the fault runs the catch block instead of
// returning; a value catch assigns the block's last expression to the result.
fn lower_try_stmt(s i64, tr_in i64, mode i64, declared i64) {
	mut tr = tr_in
	let pos = cast(Node, s).pos
	// try E wrap "msg" (edition 1): the fault passed upward is fault.Wrap(err, msg).
	mut wrapmsg = cast(Node, 0)
	if cast(Node, tr).kind == EX_WRAP {
		wrapmsg = cast(Node, cast(WrapExpr, tr).message)
		if cast(Node, cast(WrapExpr, tr).x).kind != EX_TRY {
			err_code_at(cast(Node, tr).pos, cstr("E413 WRAP"), cstr("wrap adds context to the fault try passes upward: write try E wrap \"msg\""))
			return
		}
		tr = cast(WrapExpr, tr).x
	}
	let call = cast(Node, cast(TryExpr, tr).x)
	mut handler = 0
	if cast(Node, tr).kind == EX_CATCH {
		handler = tr
	}
	let f = cast(Fn, ck_fn)
	let frs = cast(Vec[i64], f.rtypes)
	let hasf = i64(frs.len > 0 && kind_of(cast(Ty, vec_get(frs, frs.len - 1))) == K_ERROR)
	if handler == 0 && hasf == 0 {
		err_code_at(pos, cstr("E411 NO_FAULT_RESULT"), cstr("try needs the enclosing function to return a fault (write its result as !T)"))
		return
	}
	bound_want = bound_target(cast(AssignStmt, s), cast(i64, call), mode, declared)
	let t = cast(Ty, chk(call, 0))
	bound_want = 0
	mut results = vec_new[Ty]()
	if kind_of(t) == K_TUPLE {
		results = cast(Vec[Ty], cast(Vec[i64], t.fields))
	} else if kind_of(t) != K_VOID {
		vec_push(results, cast(Ty, t))
	}
	if mode == 5 && handler == 0 && cast(TryExpr, tr).soft != 0 && (results.len == 0 || kind_of(vec_get(results, results.len - 1)) != K_ERROR) {
		// A parallel line that cannot fail: its value, if any, is stored as is.
		bound_t = ty_void
		if results.len == 1 {
			bound_t = default_type(cast(i64, t))
			if is_untyped(cast(i64, t)) != 0 {
				reconvert(call, bound_t)
			}
			replace_node(s, bound_store(pos, cast(i64, call), bound_t))
		} else if results.len == 0 {
			replace_node(s, expr_stmt(call))
		} else {
			err_code_at(pos, cstr("E234 VALUE_COUNT"), cstr("a parallel line gives one value"))
		}
		return
	}
	if results.len == 0 || kind_of(vec_get(results, results.len - 1)) != K_ERROR {
		if handler != 0 {
			err_code_at(pos, cstr("E414 NOT_FALLIBLE"), cstr("catch needs a call whose result can be a fault (!T)"))
		} else {
			err_code_at(pos, cstr("E414 NOT_FALLIBLE"), cstr("try needs a call whose last result is a fault"))
		}
		return
	}
	let out = cast(Block, empty_block(pos))
	out.flat = 1
	let stmts = cast(Vec[i64], out.stmts)
	let temps = vec_new[Sym]()
	if results.len == 1 {
		let tl = temp(pos, cast(i64, call), ty_error)
		vec_push(stmts, cast(i64, tl))
		vec_push(temps, cast(Sym, tl.sym))
	} else {
		let cm = cast(CallMultiStmt, node_new(ST_CALLMULTI, pos))
		cm.call = cast(i64, call)
		cm.syms = cast(Vec[Sym], vec_new[i64]())
		mut i = 0
		for i < results.len {
			let ts = cast(Sym, declare_local(pos, cstr("$"), cast(i64, vec_get(results, i))))
			vec_push(cast(Vec[i64], cm.syms), cast(i64, ts))
			vec_push(temps, cast(Sym, ts))
			i = i + 1
		}
		call.type_ = ty_void
		vec_push(stmts, cast(i64, cm))
	}
	let errsym = vec_get(temps, cast(Vec[i64], temps).len - 1)
	errsym.reads = 1
	let nvals = cast(Vec[i64], temps).len - 1
	// if fault != nil { return zero..., fault }   (or, with catch: { the catch block })
	let ifs = cast(IfStmt, node_new(ST_IF, pos))
	ifs.cond = mk_bin(pos, cstr("!="), sym_ref_node(pos, errsym), mk_int(pos, 0, ty_error), ty_bool)
	ifs.then = empty_block(pos)
	if handler != 0 {
		let needv = i64((mode == 1 || mode == 2 || mode == 4) && nvals == 1)
		if nvals >= 1 {
			// The block's value is assigned by name: give the value temp a name of its own.
			catch_seq = catch_seq + 1
			let nb = buf_new()
			buf_str(nb, cstr("$catch"))
			buf_int(nb, catch_seq)
			buf_byte(nb, 0)
			vec_get(temps, 0).name = nb.data
		}
		if (mode == 3 || ((mode == 4 || mode == 1 || mode == 2) && nvals > 1)) && ends_in_jump(cast(Vec[Node], cast(Block, cast(CatchExpr, handler).body).stmts)) == 0 {
			err_code_at(cast(Node, handler).pos, cstr("E415 CATCH_VALUE"), cstr("this catch block must leave (return, break, continue or fail): there is no single value to give"))
			return
		}
		cast(Block, ifs.then).stmts = cast(Vec[i64], catch_body(pos, handler, cast(Vec[Sym], cast(Vec[i64], temps)), cast(i64, errsym), needv))
	} else {
		mut fx = sym_ref_node(pos, errsym)
		if cast(i64, wrapmsg) != 0 {
			// The message is evaluated only on the fault path.
			let wdesc = secret_desc(cast(i64, wrapmsg))
			let mt = chk(wrapmsg, ty_string)
			secret_sink(wrapmsg.pos, cstr("wrap would put "), cstr(" in a fault message"), wdesc, mt)
			if kind_of(cast(Ty, mt)) != K_STRING {
				err_code_type(wrapmsg.pos, cstr("E413 WRAP"), cstr("wrap needs a str message, not "), mt, cstr(""))
			}
			fx = rt_call(pos, cstr("rt_fault_wrap"), args2(fx, cast(i64, wrapmsg)), ty_error)
		}
		vec_push(cast(Block, ifs.then).stmts, fault_return(pos, cast(Block, ifs.then).stmts, fx))
	}
	vec_push(stmts, cast(i64, ifs))
	if mode == 5 {
		// A boundary block's last expression: its value, if any, goes through $r.
		bound_t = ty_void
		if nvals == 1 {
			bound_t = vec_get(temps, 0).type_
			vec_push(stmts, bound_store(pos, sym_ref_node(pos, vec_get(temps, 0)), bound_t))
		} else if nvals > 1 {
			err_code_at(pos, cstr("E234 VALUE_COUNT"), cstr("a boundary block's last expression gives one value"))
		}
	} else if mode == 1 {
		if nvals != 1 {
			err_code_at(pos, cstr("E234 VALUE_COUNT"), cstr("try here needs a call with exactly one result besides the fault"))
			return
		}
		let vs = vec_get(temps, 0)
		if declared != 0 {
			check_assignable(cast(Node, s), vs.type_, cast(Ty, declared))
		}
		if streq(cast(LetStmt, s).name, cstr("_")) != 0 {
			replace_node(s, cast(i64, out))
			return
		}
		let l = cast(LetStmt, node_new(ST_LET, pos))
		l.name = cast(LetStmt, s).name
		l.init = sym_ref_node(pos, vs)
		l.sym = declare_local(pos, cast(LetStmt, s).name, vs.type_)
		vec_push(stmts, cast(i64, l))
	} else if mode == 2 {
		if nvals != 1 {
			err_code_at(pos, cstr("E234 VALUE_COUNT"), cstr("try here needs a call with exactly one result besides the fault"))
			return
		}
		let a = assign_stmt(pos, cast(AssignStmt, s).target, sym_ref_node(pos, vec_get(temps, 0)))
		check_assign(a)
		vec_push(stmts, a)
	} else if mode == 3 {
		let targets = cast(MultiStmt, s).targets
		if targets.len != nvals {
			err_code_at(pos, cstr("E234 VALUE_COUNT"), cstr("assignment count mismatch"))
			return
		}
		let vals = vec_new[i64]()
		mut i = 0
		for i < nvals {
			vec_push(vals, cast(i64, vec_get(temps, i)))
			i = i + 1
		}
		bind_targets(pos, targets, cast(Vec[Sym], cast(Vec[i64], vals)), cast(MultiStmt, s).define, stmts)
	} else if mode == 4 && hasf == 0 {
		// return f() catch ... in a function that cannot fail: return just the values.
		if nvals != frs.len {
			err_code_at(pos, cstr("E262 RETURN_COUNT"), cstr("wrong number of return values"))
			return
		}
		let r = cast(ReturnStmt, node_new(ST_RETURN, pos))
		if nvals == 1 {
			check_assignable(cast(Node, s), vec_get(temps, 0).type_, cast(Ty, vec_get(frs, 0)))
			r.value = sym_ref_node(pos, vec_get(temps, 0))
		} else {
			let rv3 = vec_new[i64]()
			mut i = 0
			for i < nvals {
				check_assignable(cast(Node, s), vec_get(temps, i).type_, cast(Ty, vec_get(frs, i)))
				vec_push(rv3, sym_ref_node(pos, vec_get(temps, i)))
				i = i + 1
			}
			r.values = cast(Vec[i64], rv3)
		}
		vec_push(stmts, cast(i64, r))
	} else if mode == 4 {
		if nvals != frs.len - 1 {
			err_code_at(pos, cstr("E262 RETURN_COUNT"), cstr("wrong number of return values"))
			return
		}
		let r = cast(ReturnStmt, node_new(ST_RETURN, pos))
		if frs.len == 1 {
			r.value = mk_int(pos, 0, ty_error)
		} else {
			let rv2 = vec_new[i64]()
			mut i = 0
			for i < nvals {
				let ts = vec_get(temps, i)
				check_assignable(cast(Node, s), ts.type_, cast(Ty, vec_get(frs, i)))
				vec_push(rv2, sym_ref_node(pos, ts))
				i = i + 1
			}
			vec_push(rv2, mk_int(pos, 0, ty_error))
			r.values = cast(Vec[i64], rv2)
		}
		vec_push(stmts, cast(i64, r))
	}
	replace_node(s, cast(i64, out))
}

shared mut catch_seq i64 // numbers the value temps of catch blocks

// fault_return is `return zero values..., fault` for the current function; statements that
// build zero values (a struct's fields) go into body before it.
fn fault_return(pos i64, body Vec[i64], fault i64) i64 {
	if cast(i64, ck_fn) == arena_check_fn {
		arena_fail_count = arena_fail_count + 1
	}
	let frs = cast(Fn, ck_fn).rtypes
	let ret = cast(ReturnStmt, node_new(ST_RETURN, pos))
	if frs.len == 1 {
		ret.value = fault
		return cast(i64, ret)
	}
	let rv = vec_new[i64]()
	mut i = 0
	for i < frs.len - 1 {
		let rt = vec_get(frs, i)
		let rk = kind_of(cast(Ty, rt))
		if is_float_t(rt) != 0 {
			vec_push(rv, zero_value(pos, ty_float))
		} else if (rk == K_STRING || rk == K_SLICE || rk == K_MAP || rk == K_STRUCT) {
			// A str, slice, map or struct is never nil, even next to a fault.
			vec_push(rv, argo_new(pos, body, cast(Ty, rt)))
		} else {
			vec_push(rv, mk_int(pos, 0, rt))
		}
		i = i + 1
	}
	vec_push(rv, fault)
	ret.values = cast(Vec[i64], rv)
	return cast(i64, ret)
}

// catch_body checks a catch block with its fault bound to name (unless _). With needv the
// block's last expression becomes the value: it is assigned to the call's first result.
fn catch_body(pos i64, c i64, temps Vec[Sym], errsym i64, needv i64) i64 {
	let user = cast(Block, cast(CatchExpr, c).body).stmts
	let n = user.len
	mut valued = i64(needv != 0 && ends_in_jump(cast(Vec[Node], user)) == 0)
	if valued != 0 && (n == 0 || cast(Node, vec_get(user, n - 1)).kind != ST_EXPR) {
		err_code_at(cast(Node, c).pos, cstr("E415 CATCH_VALUE"), cstr("a catch block must end with the value to use, or leave (return, break, continue or fail)"))
		return cast(i64, vec_new[i64]())
	}
	if valued != 0 && cast(Node, cast(ExprStmt, vec_get(user, n - 1)).x).kind == EX_MATCH {
		// A match as the block's value: its arms assign the value temp, and may leave (#225).
		let ml = vec_get(user, n - 1)
		user.data[n - 1] = assign_stmt(cast(Node, ml).pos, sym_ref_node(cast(Node, ml).pos, vec_get(temps, 0)), cast(ExprStmt, ml).x)
		valued = 0
	}
	let out = vec_new[i64]()
	push_scope()
	if streq(cast(CatchExpr, c).name, cstr("_")) == 0 {
		let es = declare_local(pos, cast(CatchExpr, c).name, ty_error)
		vec_push(out, let_stmt(pos, cast(Sym, es), sym_ref_node(pos, cast(Sym, errsym))))
	}
	if valued != 0 {
		// Everything before the last statement runs; the last one is the value.
		let last = vec_get(user, n - 1)
		user.len = n - 1
		check_stmts(user)
		user.len = n
		let vt = vec_get(temps, 0)
		let lt = chk(cast(Node, cast(ExprStmt, last).x), vt.type_)
		if kind_of(cast(Ty, lt)) == K_VOID {
			err_code_at(cast(Node, last).pos, cstr("E415 CATCH_VALUE"), cstr("a catch block must end with the value to use, or leave (return, break, continue or fail)"))
		} else {
			let a = assign_stmt(cast(Node, last).pos, sym_ref_node(cast(Node, last).pos, vt), cast(ExprStmt, last).x)
			check_assign(a)
			user.data[n - 1] = a
		}
	} else {
		check_stmts(user)
	}
	pop_scope()
	mut i = 0
	for i < user.len {
		vec_push(out, vec_get(user, i))
		i = i + 1
	}
	return cast(i64, out)
}

// check_fail lowers `fail X` to `return zero values..., fault`, X a str message or a fault.
fn check_fail(s i64) {
	let pos = cast(Node, s).pos
	let frs = cast(Fn, ck_fn).rtypes
	if frs.len == 0 || kind_of(cast(Ty, vec_get(frs, frs.len - 1))) != K_ERROR {
		err_code_at(pos, cstr("E411 NO_FAULT_RESULT"), cstr("fail needs the enclosing function to return a fault (write its result as !T)"))
		return
	}
	mut x = cast(Node, cast(FailStmt, s).x)
	let fdesc = secret_desc(cast(i64, x))
	let t = chk(x, 0)
	secret_sink(x.pos, cstr("fail would put "), cstr(" in a fault message"), fdesc, t)
	if kind_of(cast(Ty, t)) == K_STRING {
		x = cast(Node, rt_call(pos, cstr("rt_fail"), args1(cast(i64, x)), ty_error))
	} else if kind_of(cast(Ty, t)) != K_ERROR {
		err_code_type(pos, cstr("E416 FAIL_VALUE"), cstr("fail needs a str message or a fault, not "), t, cstr(""))
		return
	}
	let out = cast(Block, empty_block(pos))
	out.flat = 1
	vec_push(cast(Vec[i64], out.stmts), fault_return(pos, cast(Vec[i64], out.stmts), cast(i64, x)))
	replace_node(s, cast(i64, out))
}

// lower_range rewrites a range loop as a counted (or map-slot) loop and checks it.
// Element reads it generates, and the body's own x[i] on the ranged slice, skip the
// bounds check: the counter stays below the length captured before the loop.
fn lower_range(s i64) {
	let pos = cast(Node, s).pos
	let x = cast(RangeStmt, s).expr
	mut xname = 0
	if cast(Node, x).kind == EX_IDENT {
		xname = cast(IdentExpr, x).name
	}
	let xt = cast(Ty, chk(cast(Node, x), 0))
	let k = kind_of(xt)
	let out = cast(Block, empty_block(pos))
	let stmts = cast(Vec[i64], out.stmts)
	push_scope()
	let src = temp(pos, x, cast(i64, xt))
	vec_push(stmts, cast(i64, src))
	let ss = src.sym
	let key = cast(RangeStmt, s).key
	let val = cast(RangeStmt, s).val
	let body = cast(RangeStmt, s).body
	let pre = vec_new[i64]()
	let w = cast(WhileStmt, node_new(ST_WHILE, pos))
	mut it = ty_int
	if is_integer_t(cast(i64, xt)) != 0 {
		it = default_type(cast(i64, xt))
		if is_untyped(cast(i64, xt)) != 0 {
			reconvert(cast(Node, x), ty_int)
		}
	}
	let i = declare_local(pos, cstr("$"), it)
	vec_push(stmts, let_stmt(pos, cast(Sym, i), mk_int(pos, 0, it)))
	mut limit_ = 0
	mut step = mk_bin(pos, cstr("+"), sym_ref_node(pos, cast(Sym, i)), mk_int(pos, 1, it), it)
	let keysym = 0
	if is_integer_t(cast(i64, xt)) != 0 {
		limit_ = sym_ref_node(pos, cast(Sym, ss))
		if key != 0 {
			vec_push(pre, range_bind(pos, key, sym_ref_node(pos, cast(Sym, i)), it, cast(RangeStmt, s).define))
		}
	} else if k == K_SLICE || k == K_STRING {
		let n = temp(pos, mk_hdr(pos, sym_ref_node(pos, cast(Sym, ss)), 0), ty_int)
		vec_push(stmts, cast(i64, n))
		limit_ = sym_ref_node(pos, cast(Sym, n.sym))
		if key != 0 {
			vec_push(pre, range_bind(pos, key, sym_ref_node(pos, cast(Sym, i)), ty_int, cast(RangeStmt, s).define))
		}
		if k == K_SLICE && val != 0 {
			let et = secret_like(cast(i64, xt), xt.elem)
			let elem = mk_elem(pos, sym_ref_node(pos, cast(Sym, ss)), sym_ref_node(pos, cast(Sym, i)), et, 0)
			elem.safe = 1
			vec_push(pre, range_bind(pos, val, cast(i64, elem), et, cast(RangeStmt, s).define))
		}
		if k == K_STRING {
			// Strings range over runes: rt_utf8 packs the rune and its width.
			let packed = temp(pos, rt_call(pos, cstr("rt_utf8"), args2(sym_ref_node(pos, cast(Sym, ss)), sym_ref_node(pos, cast(Sym, i))), ty_int), ty_int)
			vec_push(pre, cast(i64, packed))
			let nexti = temp(pos, mk_bin(pos, cstr("+"), sym_ref_node(pos, cast(Sym, i)), mk_bin(pos, cstr(">>"), sym_ref_node(pos, cast(Sym, packed.sym)), mk_int(pos, 32, ty_int), ty_int), ty_int), ty_int)
			vec_push(pre, cast(i64, nexti))
			step = sym_ref_node(pos, cast(Sym, nexti.sym))
			if val != 0 {
				let rune = mk_conv(pos, mk_bin(pos, cstr("&"), sym_ref_node(pos, cast(Sym, packed.sym)), mk_int(pos, 0xffffffff, ty_int), ty_int), CV_INT, ty_i32)
				vec_push(pre, range_bind(pos, val, rune, secret_like(cast(i64, xt), ty_i32), cast(RangeStmt, s).define))
			}
		}
	} else if k == K_MAP {
		let cap_ = temp(pos, rt_call(pos, cstr("rt_map_slots"), args1(sym_ref_node(pos, cast(Sym, ss))), ty_int), ty_int)
		vec_push(stmts, cast(i64, cap_))
		limit_ = sym_ref_node(pos, cast(Sym, cap_.sym))
		// Only live slots run the body.
		let live = cast(IfStmt, node_new(ST_IF, pos))
		live.cond = mk_bin(pos, cstr("=="), rt_call(pos, cstr("rt_map_live"), args2(sym_ref_node(pos, cast(Sym, ss)), sym_ref_node(pos, cast(Sym, i))), ty_int), mk_int(pos, 0, ty_int), ty_bool)
		let skip = cast(Block, empty_block(pos))
		vec_push(cast(Vec[i64], skip.stmts), node_new(ST_CONTINUE, pos))
		live.then = cast(i64, skip)
		vec_push(pre, cast(i64, live))
		if key != 0 {
			let kv = key_out(cast(Node, rt_call(pos, cstr("rt_map_key"), args2(sym_ref_node(pos, cast(Sym, ss)), sym_ref_node(pos, cast(Sym, i))), ty_int)), xt.key)
			vec_push(pre, range_bind(pos, key, kv, secret_like(cast(i64, xt), xt.key), cast(RangeStmt, s).define))
		}
		if val != 0 {
			let vv = from_bits(cast(Node, rt_call(pos, cstr("rt_map_val"), args2(sym_ref_node(pos, cast(Sym, ss)), sym_ref_node(pos, cast(Sym, i))), ty_int)), xt.elem)
			vec_push(pre, range_bind(pos, val, vv, secret_like(cast(i64, xt), xt.elem), cast(RangeStmt, s).define))
		}
	} else {
		err_code_type(pos, cstr("E263 RANGE"), cstr("cannot range over "), cast(i64, xt), cstr(""))
		pop_scope()
		return
	}
	w.cond = mk_bin(pos, cstr("<"), sym_ref_node(pos, cast(Sym, i)), limit_, ty_bool)
	w.post = assign_stmt(pos, sym_ref_node(pos, cast(Sym, i)), step)
	w.label = cast(RangeStmt, s).label
	let nb = cast(Block, empty_block(pos))
	mut j = 0
	for j < pre.len {
		vec_push(cast(Vec[i64], nb.stmts), vec_get(pre, j))
		j = j + 1
	}
	vec_push(cast(Vec[i64], nb.stmts), body)
	w.body = cast(i64, nb)
	vec_push(stmts, cast(i64, w))
	replace_node(s, cast(i64, out))
	// The body's s[key] on the ranged slice is safe while neither name is reassigned.
	let saved = safe_pairs.len
	ck_loops = ck_loops + 1
	ck_breaks = ck_breaks + 1
	vec_push(ck_labels, w.label)
	push_scope()
	check_pre_stmts(cast(Vec[i64], nb.stmts))
	if (k == K_SLICE || k == K_STRING) && key != 0 && cast(Node, key).kind == EX_IDENT && cast(RangeStmt, s).define != 0 && xname != 0 && names_assigned(body, xname, cast(IdentExpr, key).name) == 0 {
		let ks = lookup_name_local(cast(IdentExpr, key).name)
		let xs = lookup_name(xname)
		if ks != 0 && cast(i64, xs) != 0 && xs.kind == SYM_LOCAL {
			vec_push(safe_pairs, pair(ks, cast(i64, xs)))
		}
	}
	check_stmt(body)
	safe_pairs.len = saved
	pop_scope()
	ck_labels.len = ck_labels.len - 1
	ck_loops = ck_loops - 1
	ck_breaks = ck_breaks - 1
	pop_scope()
}

// check_loop_label reports a labeled break or continue whose label names no enclosing loop.
fn check_loop_label(pos i64, what i64, name i64) {
	mut i = ck_labels.len - 1
	for i >= 0 {
		let l = vec_get(ck_labels, i)
		if l != 0 && streq(l, name) != 0 {
			return
		}
		i = i - 1
	}
	err_code_at(pos, cstr("E261 OUTSIDE_LOOP"), str_cat3(what, cstr(" names no enclosing loop: "), name))
}

// check_pre_stmts declares the already-checked lets a lowered loop puts before its
// body, so the body can see them; the body itself is checked by the caller.
fn check_pre_stmts(stmts Vec[i64]) {
	mut i = 0
	for i < stmts.len - 1 {
		let s = vec_get(stmts, i)
		if cast(Node, s).kind == ST_LET && cast(LetStmt, s).sym != 0 {
			vec_push(sc_syms, cast(Sym, cast(LetStmt, s).sym))
		} else if cast(Node, s).kind == ST_BLOCK && cast(Block, s).flat != 0 && cast(Block, s).cellsym != 0 {
			// a celled range variable: its cell sym is already a local, the variable itself enters scope
			vec_push(sc_syms, cast(Sym, cast(Block, s).cellsym))
		} else if cast(Node, s).kind == ST_IF && cast(Node, cast(IfStmt, s).cond).type_ != 0 {
		} else {
			check_stmt(s)
		}
		i = i + 1
	}
}

// range_bind binds a range key or value: a new variable for :=, else an assignment.
fn range_bind(pos i64, target i64, value i64, t i64, define i64) i64 {
	if cast(Node, target).kind == EX_IDENT && streq(cast(IdentExpr, target).name, cstr("_")) != 0 {
		return empty_block(pos)
	}
	if define != 0 {
		let l = cast(LetStmt, node_new(ST_LET, pos))
		l.name = cast(IdentExpr, target).name
		l.init = value
		l.sym = cast(i64, sym_new(SYM_LOCAL, cast(IdentExpr, target).name, pos))
		cast(Sym, l.sym).type_ = t
		cast(Sym, l.sym).slot = cast(Fn, ck_fn).slots
		cast(Fn, ck_fn).slots = cast(Fn, ck_fn).slots + 1
		vec_push(cast(Fn, ck_fn).locals, cast(Sym, l.sym))
		if cast(i64, ck_escaping_cells) != 0 && vec_has_str(ck_escaping_cells, cast(IdentExpr, target).name) != 0 {
			// A variable a closure captures lives in a cell, and each iteration allocates its own.
			let sym = cast(Sym, l.sym)
			sym.cell = 1
			let csym = sym_new(SYM_LOCAL, str_cat3(cstr("$cell_"), cast(IdentExpr, target).name, cstr("")), pos)
			csym.type_ = ty_int
			csym.reads = 1
			csym.slot = cast(Fn, ck_fn).slots
			cast(Fn, ck_fn).slots = cast(Fn, ck_fn).slots + 1
			vec_push(cast(Fn, ck_fn).locals, cast(Sym, csym))
			sym.cell_sym = cast(i64, csym)
			let alloc_call = rt_call(pos, cstr("rt_alloc"), args1(mk_int(pos, 8, ty_int)), ty_int)
			let blk = cast(Block, node_new(ST_BLOCK, pos))
			blk.stmts = vec_new[i64]()
			vec_push(cast(Vec[i64], blk.stmts), let_stmt(pos, csym, alloc_call))
			vec_push(cast(Vec[i64], blk.stmts), assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, csym), 0, 0, 0, t), value))
			blk.flat = 1
			blk.cellsym = cast(i64, sym)
			return cast(i64, blk)
		}
		return cast(i64, l)
	}
	let a = assign_stmt(pos, target, value)
	return a
}

// lower_switch turns a switch into an if-chain inside a block that break can leave.
fn lower_switch(s i64) {
	let pos = cast(Node, s).pos
	if cast(SwitchStmt, s).tag != 0 && cast(SwitchStmt, s).init != 0 {
		// switch init; x { ... }  is  { init; switch x { ... } }.
		let blk = empty_block(pos)
		vec_push(cast(Block, blk).stmts, cast(SwitchStmt, s).init)
		let inner = cast(SwitchStmt, node_new(ST_SWITCH, pos))
		inner.tag = cast(SwitchStmt, s).tag
		inner.cases = cast(SwitchStmt, s).cases
		vec_push(cast(Block, blk).stmts, cast(i64, inner))
		replace_node(s, blk)
		check_scoped(cast(Block, s))
		return
	}
	if cast(SwitchStmt, s).tag != 0 {
		let tt = cast(Ty, chk(cast(Node, cast(SwitchStmt, s).tag), 0))
		if kind_of(tt) == K_STRUCT && tt.enum_ != 0 {
			lower_enum_switch(s, tt)
			return
		}
	}
	// switch err { case ErrX: } compares each case with fault.Is (design_semantics section 2).
	let faultsw = i64(cast(SwitchStmt, s).tag != 0 && kind_of(cast(Ty, chk(cast(Node, cast(SwitchStmt, s).tag), 0))) == K_ERROR)
	let out = cast(Block, empty_block(pos))
	if cast(SwitchStmt, s).init != 0 {
		vec_push(cast(Vec[i64], out.stmts), cast(SwitchStmt, s).init)
	}
	let w = cast(WhileStmt, node_new(ST_WHILE, pos))
	w.once_ = 1
	w.cond = mk_int(pos, 1, ty_bool)
	let body = cast(Block, empty_block(pos))
	w.body = cast(i64, body)
	let tag = cast(SwitchStmt, s).tag
	mut tagname = cast(IdentExpr, 0)
	if tag != 0 {
		// switch x { case a, b: }  compares a hidden copy of x.
		tagname = cast(IdentExpr, node_new(EX_IDENT, pos))
		tagname.name = cstr("$sw")
		let l = cast(LetStmt, node_new(ST_LET, pos))
		l.name = cstr("$sw")
		l.init = tag
		vec_push(cast(Vec[i64], body.stmts), cast(i64, l))
	}
	mut first = 0
	mut last = cast(IfStmt, 0)
	mut deflt = 0
	let cases = cast(SwitchStmt, s).cases
	mut i = 0
	for i < cases.len {
		let c = cast(Vec[i64], vec_get(cases, i))
		let exprs = cast(Vec[i64], vec_get(c, 0))
		let blk = vec_get(c, 1)
		if cast(i64, exprs) == 0 {
			deflt = blk
		} else {
			mut cond = 0
			mut j = 0
			for j < exprs.len {
				mut e = vec_get(exprs, j)
				if tag != 0 {
					let id = node_new(EX_IDENT, pos)
					cast(IdentExpr, id).name = cstr("$sw")
					e = binary_new(cast(Node, e).pos, cstr("=="), id, e)
					if faultsw != 0 {
						cast(Binary, e).op = cstr("$is")
						cast(Node, id).pos = cast(Node, cast(Binary, e).r).pos
					}
				}
				if cond != 0 {
					cond = binary_new(cast(Node, e).pos, cstr("||"), cond, e)
				} else {
					cond = e
				}
				j = j + 1
			}
			let ifs = cast(IfStmt, node_new(ST_IF, cast(Node, blk).pos))
			ifs.cond = cond
			ifs.then = blk
			if cast(i64, last) != 0 {
				last.else_ = cast(i64, ifs)
			} else {
				first = cast(i64, ifs)
			}
			last = ifs
		}
		i = i + 1
	}
	if deflt != 0 {
		if cast(i64, last) != 0 {
			last.else_ = deflt
		} else {
			first = deflt
		}
	}
	if first != 0 {
		vec_push(cast(Vec[i64], body.stmts), first)
	}
	vec_push(cast(Vec[i64], out.stmts), cast(i64, w))
	replace_node(s, cast(i64, out))
	push_scope()
	mut k = 0
	for k < cast(Vec[i64], out.stmts).len - 1 {
		check_stmt(vec_get(cast(Vec[i64], out.stmts), k))
		k = k + 1
	}
	ck_breaks = ck_breaks + 1
	check_scoped(body)
	ck_breaks = ck_breaks - 1
	pop_scope()
}

// enum_pattern reads a case pattern: Variant, Variant(a, b) or Shape.Variant(a, b). It
// returns [name, binding names] or 0.
fn enum_pattern(e i64) i64 {
	let r = vec_new[i64]()
	let names = vec_new[i64]()
	let k = cast(Node, e).kind
	if k == EX_IDENT {
		vec_push(r, cast(IdentExpr, e).name)
	} else if k == EX_SELECT {
		vec_push(r, cast(SelectExpr, e).name)
	} else if k == EX_CALL {
		if cast(Call, e).name != 0 {
			vec_push(r, cast(Call, e).name)
		} else if cast(Call, e).callee != 0 && cast(Node, cast(Call, e).callee).kind == EX_SELECT {
			vec_push(r, cast(SelectExpr, cast(Call, e).callee).name)
		} else {
			return 0
		}
		let args = cast(Call, e).args
		mut i = 0
		for i < args.len {
			let a = vec_get(args, i)
			if cast(Node, a).kind != EX_IDENT {
				return 0
			}
			vec_push(names, cast(IdentExpr, a).name)
			i = i + 1
		}
	} else {
		return 0
	}
	vec_push(r, cast(i64, names))
	return cast(i64, r)
}

// lower_enum_switch compiles switch s { case Circle(r): ... } on an enum: one branch per
// variant tag, binding the variant's fields; every variant must be covered (or default).
fn lower_enum_switch(s i64, t Ty) {
	let pos = cast(Node, s).pos
	let vs = cast(Vec[i64], t.enum_)
	let out = cast(Block, empty_block(pos))
	push_scope()
	let tmp = temp(pos, cast(SwitchStmt, s).tag, cast(i64, t))
	vec_push(cast(Vec[i64], out.stmts), cast(i64, tmp))
	let w = cast(WhileStmt, node_new(ST_WHILE, pos))
	w.once_ = 1
	w.cond = mk_int(pos, 1, ty_bool)
	let body = cast(Block, empty_block(pos))
	w.body = cast(i64, body)
	let seen = vec_filled(vs.len, 0)
	mut first = 0
	mut last = cast(IfStmt, 0)
	mut deflt = 0
	let cases = cast(SwitchStmt, s).cases
	mut i = 0
	for i < cases.len {
		let c = cast(Vec[i64], vec_get(cases, i))
		let exprs = cast(Vec[i64], vec_get(c, 0))
		let blk = vec_get(c, 1)
		if cast(i64, exprs) == 0 {
			deflt = blk
		} else {
			mut cond = 0
			let binds = vec_new[i64]()
			mut j = 0
			for j < exprs.len {
				let e = cast(Node, vec_get(exprs, j))
				let pat = cast(Vec[i64], enum_pattern(cast(i64, e)))
				if cast(i64, pat) == 0 {
					err_code_type(e.pos, cstr("E290 MATCH_PATTERN"), cstr("a case of a switch on "), cast(i64, t), cstr(" is a variant, like Name or Name(a, b)"))
					pop_scope()
					return
				}
				let vi = enum_variant(t, vec_get(pat, 0))
				if vi < 0 {
					let u = err_code(e.pos, cstr("E290 MATCH_PATTERN"))
					type_name(cast(Buf, u), t)
					buf_str(u, cstr(" has no variant "))
					buf_str(u, vec_get(pat, 0))
					err_end(cast(Buf, u))
					pop_scope()
					return
				}
				if vec_get(seen, vi) != 0 {
					err_code_quoted(e.pos, cstr("E292 MATCH_UNREACHABLE"), cstr("variant "), vec_get(pat, 0), cstr(" is already handled by an earlier case"))
				}
				cast(Vec[i64], seen).data[vi] = 1
				let v = cast(Vec[i64], vec_get(vs, vi))
				let names = cast(Vec[i64], vec_get(pat, 1))
				if names.len > 0 {
					if exprs.len > 1 {
						err_code_at(e.pos, cstr("E290 MATCH_PATTERN"), cstr("a case that binds a variant's values lists only that variant"))
					} else if names.len != vec_get(v, 2) {
						let u = err_code(e.pos, cstr("E290 MATCH_PATTERN"))
						buf_str(u, vec_get(pat, 0))
						buf_str(u, cstr(" has "))
						buf_int(u, vec_get(v, 2))
						buf_str(u, cstr(" values, the case binds "))
						buf_int(u, names.len)
						err_end(cast(Buf, u))
					} else {
						mut k = 0
						for k < names.len {
							let nm = vec_get(names, k)
							if streq(nm, cstr("_")) == 0 {
								let fi = vec_get(v, 1) + k
								let l = cast(LetStmt, node_new(ST_LET, e.pos))
								l.name = nm
								l.init = mk_mem(e.pos, sym_ref_node(pos, cast(Sym, tmp.sym)), 0, 0, field_offset(t, fi), field_type(t, fi))
								vec_push(binds, cast(i64, l))
							}
							k = k + 1
						}
					}
				}
				let tagv = mk_mem(e.pos, sym_ref_node(pos, cast(Sym, tmp.sym)), 0, 0, field_offset(t, 0), ty_int)
				let ce = mk_bin(e.pos, cstr("=="), tagv, mk_int(e.pos, vi, ty_int), ty_bool)
				if cond != 0 {
					cond = mk_bin(e.pos, cstr("||"), cond, ce, ty_bool)
				} else {
					cond = ce
				}
				j = j + 1
			}
			if cast(Vec[i64], binds).len > 0 {
				let st = cast(Block, blk).stmts
				mut k2 = 0
				for k2 < st.len {
					vec_push(binds, vec_get(st, k2))
					k2 = k2 + 1
				}
				cast(Block, blk).stmts = cast(Vec[i64], binds)
			}
			let ifs = cast(IfStmt, node_new(ST_IF, cast(Node, blk).pos))
			ifs.cond = cond
			ifs.then = blk
			if cast(i64, last) != 0 {
				last.else_ = cast(i64, ifs)
			} else {
				first = cast(i64, ifs)
			}
			last = ifs
		}
		i = i + 1
	}
	if deflt == 0 {
		let missing = buf_new()
		mut n = 0
		mut m = 0
		for m < vs.len {
			if vec_get(seen, m) == 0 {
				if n > 0 {
					buf_str(missing, cstr(", "))
				}
				buf_str(missing, vec_get(cast(Vec[i64], vec_get(vs, m)), 0))
				n = n + 1
			}
			m = m + 1
		}
		if n > 0 {
			let u = err_code(pos, cstr("E291 MATCH_EXHAUSTIVE"))
			buf_str(u, cstr("switch on "))
			type_name(cast(Buf, u), t)
			buf_str(u, cstr(" does not handle "))
			buf_byte(missing, 0)
			buf_str(u, missing.data)
			buf_str(u, cstr(" (add the cases, or a default)"))
			err_end(cast(Buf, u))
		}
	} else if cast(i64, last) != 0 {
		last.else_ = deflt
	} else {
		first = deflt
	}
	if first != 0 {
		vec_push(cast(Vec[i64], body.stmts), first)
	}
	vec_push(cast(Vec[i64], out.stmts), cast(i64, w))
	// Every variant handled and every branch returns: nothing runs after the switch.
	mut all_return = i64(first != 0)
	mut ci = 0
	for ci < cases.len {
		if ends_in_return(cast(Vec[i64], cast(Block, vec_get(cast(Vec[i64], vec_get(cases, ci)), 1)).stmts)) == 0 {
			all_return = 0
		}
		ci = ci + 1
	}
	replace_node(s, cast(i64, out))
	ck_breaks = ck_breaks + 1
	check_scoped(body)
	ck_breaks = ck_breaks - 1
	pop_scope()
	if all_return != 0 && (deflt != 0 || all_seen(cast(Vec[i64], seen)) != 0) {
		vec_push(cast(Block, s).stmts, expr_stmt(cast(Node, rt_call(pos, cstr("rt_panic"), args1(lit_string(pos, cstr("unreachable enum switch"))), ty_void))))
	}
}

fn all_seen(seen Vec[i64]) i64 {
	mut i = 0
	for i < seen.len {
		if vec_get(seen, i) == 0 {
			return 0
		}
		i = i + 1
	}
	return 1
}

// ---- match (edition 1, #225) ----
//
// A match is lowered where it stands: as a statement, a let or assignment value, a return
// value, or a catch or boundary block's last expression, where its arms may also leave
// (return, break, continue, fail, try); inside any other expression it is an EX_SEQ whose
// arms are expressions. A statement match a switch can express (constant, sentinel and
// variant arms, `_` last, no guards, no break in an arm), or `match true { true if c => }`,
// the translator's tagless switch, is lowered as that switch, so translated code keeps its
// instructions. Any other match is an if-else chain over the subject: each arm tests its
// patterns, declares its bindings, then runs its guard. A guarded arm that binds splits the
// chain: the rest runs under a flag the arm clears when it is taken. break and continue in
// an arm apply to the enclosing loop. A name in a pattern compares with a package-level
// constant or variable (a sentinel), names a variant of an enum subject, or else binds;
// naming a local variable is an error (compare with a guard).
const MATCH_STMT = 0 // no value
const MATCH_VALUE = 1 // each arm stores its value in the record's local
const MATCH_RETURN = 2 // each arm returns its value
const MATCH_TAIL = 3 // a boundary block's last expression: a value, or none
const MATCH_EXPR = 4 // inside an expression: as MATCH_VALUE, with expression arms only
const MR_SYM = 0 // record: the value local
const MR_MODE = 1 // record: the mode
const MR_HINT = 2 // record: the type the context expects (MATCH_EXPR), or 0

shared mut mt_seq i64 // numbers the match locals that are assigned by name
shared mut mt_variant i64 // the enum variant a pattern matches whole, or -1
shared mut mt_bool i64 // a pattern's bool literal: 1 true, 2 false, 0 neither

fn mt_name(prefix i64) i64 {
	mt_seq = mt_seq + 1
	let nb = buf_new()
	buf_str(nb, prefix)
	buf_int(nb, mt_seq)
	buf_byte(nb, 0)
	return nb.data
}

fn mt_record(vs i64, mode i64, hint i64) i64 {
	let rec = cast(MatchRec, calloc(3, 8))
	rec.sym = vs
	rec.mode = mode
	rec.hint = hint
	return cast(i64, rec)
}

// mt_stmt_expr is the expression a statement carries at its top (a match or catch may be one).
fn mt_stmt_expr(s i64) i64 {
	let k = cast(Node, s).kind
	if k == ST_EXPR {
		return cast(ExprStmt, s).x
	}
	if k == ST_LET {
		return cast(LetStmt, s).init
	}
	if k == ST_ASSIGN {
		return cast(AssignStmt, s).value
	}
	if k == ST_RETURN {
		return cast(ReturnStmt, s).value
	}
	return 0
}

// mt_breaks reports a break in stmts outside any loop of theirs: in a match arm it leaves
// the enclosing loop, where a switch would take it for its own end.
fn mt_breaks(v Vec[i64]) i64 {
	mut i = 0
	for i < v.len {
		let s = vec_get(v, i)
		let k = cast(Node, s).kind
		if k == ST_BREAK {
			return 1
		}
		if k == ST_BLOCK && mt_breaks(cast(Block, s).stmts) != 0 {
			return 1
		}
		if k == ST_IF && (mt_breaks(cast(Block, cast(IfStmt, s).then).stmts) != 0 || (cast(IfStmt, s).else_ != 0 && mt_breaks(cast(Vec[i64], vec_new_with(cast(IfStmt, s).else_))) != 0)) {
			return 1
		}
		let x = mt_stmt_expr(s)
		if x != 0 && cast(Node, x).kind == EX_CATCH && mt_breaks(cast(Block, cast(CatchExpr, x).body).stmts) != 0 {
			return 1
		}
		if x != 0 && cast(Node, x).kind == EX_MATCH && mt_arms_break(cast(MatchExpr, x)) != 0 {
			return 1
		}
		i = i + 1
	}
	return 0
}

fn mt_arms_break(m MatchExpr) i64 {
	let arms = cast(Vec[i64], m.arms)
	mut i = 0
	for i < arms.len {
		let arm = cast(Vec[i64], vec_get(arms, i))
		if cast(MatchArm, arm).block != 0 && mt_breaks(cast(Vec[i64], cast(Block, cast(MatchArm, arm).body).stmts)) != 0 {
			return 1
		}
		i = i + 1
	}
	return 0
}

// mt_names_assigned reports whether an arm of m (or of a match nested in one) assigns a or b.
fn mt_names_assigned(m MatchExpr, a i64, b i64) i64 {
	let arms = cast(Vec[i64], m.arms)
	mut i = 0
	for i < arms.len {
		let arm = cast(Vec[i64], vec_get(arms, i))
		let body = cast(Node, cast(MatchArm, arm).body)
		if cast(MatchArm, arm).block != 0 && names_assigned(cast(i64, body), a, b) != 0 {
			return 1
		}
		if cast(MatchArm, arm).block == 0 && body.kind == EX_MATCH && mt_names_assigned(cast(MatchExpr, body), a, b) != 0 {
			return 1
		}
		i = i + 1
	}
	return 0
}

// mt_collect_decls adds the names m's arms bind or declare (closures may capture them).
fn mt_collect_decls(m MatchExpr, names Vec[i64]) {
	let arms = cast(Vec[i64], m.arms)
	mut i = 0
	for i < arms.len {
		let arm = cast(Vec[i64], vec_get(arms, i))
		let pats = cast(Vec[i64], cast(MatchArm, arm).patterns)
		mut j = 0
		for j < pats.len {
			mt_pattern_names(cast(Vec[i64], vec_get(pats, j)), names)
			j = j + 1
		}
		let body = cast(MatchArm, arm).body
		if cast(MatchArm, arm).block != 0 {
			collect_local_decls(cast(Block, body).stmts, names)
		} else if cast(Node, body).kind == EX_MATCH {
			mt_collect_decls(cast(MatchExpr, body), names)
		}
		i = i + 1
	}
}

fn mt_pattern_names(p Vec[i64], names Vec[i64]) {
	if cast(Pattern, p).kind == PAT_NAME_KIND && cast(Node, cast(Pattern, p).name).kind == EX_IDENT {
		vec_push(names, cast(IdentExpr, cast(Pattern, p).name).name)
	}
	if cast(Pattern, p).kind == PAT_VARIANT {
		let kids = cast(Vec[i64], cast(Pattern, p).children)
		mut j = 0
		for j < kids.len {
			mt_pattern_names(cast(Vec[i64], vec_get(kids, j)), names)
			j = j + 1
		}
	}
}

// mt_arm_block is an arm's body as a block: its own, or one holding its expression.
fn mt_arm_block(arm Vec[Node]) i64 {
	let b = cast(MatchArm, arm).body
	if cast(i64, cast(MatchArm, arm).block) != 0 {
		return cast(i64, b)
	}
	let blk = cast(Block, empty_block(cast(Node, b).pos))
	vec_push(cast(Vec[i64], blk.stmts), expr_stmt(cast(Node, b)))
	return cast(i64, blk)
}

// match_as_switch lowers a statement match that a switch expresses as that switch; it
// returns 0, having changed nothing, for any other match.
fn match_as_switch(s i64, m MatchExpr) i64 {
	let arms = cast(Vec[i64], m.arms)
	let subj = m.subject
	if mt_arms_break(m) != 0 {
		return 0
	}
	let tagless = i64(cast(Node, subj).kind == EX_IDENT && streq(cast(IdentExpr, subj).name, cstr("true")) != 0)
	mut t = cast(Ty, 0)
	mut vs = cast(Vec[i64], 0)
	if tagless == 0 {
		t = cast(Ty, chk(cast(Node, subj), 0))
		if kind_of(t) == K_OPT || is_untyped(cast(i64, t)) != 0 {
			return 0
		}
		if kind_of(t) == K_STRUCT && t.enum_ != 0 {
			vs = cast(Vec[i64], t.enum_)
		}
	}
	mut seen = cast(Vec[i64], 0)
	if cast(i64, vs) != 0 {
		seen = vec_filled(vs.len, 0)
	}
	mut deflt = 0
	let cases = vec_new[i64]()
	let n = arms.len
	mut i = 0
	for i < n {
		let arm = cast(Vec[i64], vec_get(arms, i))
		let pats = cast(Vec[i64], cast(MatchArm, arm).patterns)
		let guard_ = cast(MatchArm, arm).guard_
		let p0 = cast(Vec[i64], vec_get(pats, 0))
		mut exprs = vec_new[i64]()
		if pats.len == 1 && cast(Pattern, p0).kind == PAT_WILD && guard_ == 0 {
			if i != n - 1 {
				return 0
			}
			exprs = cast(Vec[i64], 0)
			deflt = 1
		} else if tagless != 0 {
			let x = cast(Pattern, p0).a
			if guard_ == 0 || pats.len != 1 || cast(Pattern, p0).kind != PAT_LITERAL || cast(Node, x).kind != EX_IDENT || streq(cast(IdentExpr, x).name, cstr("true")) == 0 {
				return 0
			}
			vec_push(exprs, guard_)
		} else {
			if guard_ != 0 {
				return 0
			}
			mut j = 0
			for j < pats.len {
				let e = match_case_expr(cast(Vec[i64], vec_get(pats, j)), t, seen, pats.len)
				if e == 0 {
					return 0
				}
				vec_push(exprs, e)
				j = j + 1
			}
		}
		vec_push(cases, pair(cast(i64, exprs), mt_arm_block(cast(Vec[Node], arm))))
		i = i + 1
	}
	if cast(i64, seen) != 0 && deflt == 0 && all_seen(seen) == 0 {
		return 0
	}
	// A match that ends its function and leaves from every arm needs no return after it.
	let body = cast(Block, ck_fn.body).stmts
	let frs = cast(Fn, ck_fn).rtypes
	let last = i64(body.len > 0 && vec_get(body, body.len - 1) == s && frs.len > 0 && !(cast(Fn, ck_fn).bang != 0 && frs.len == 1))
	let pos = cast(Node, s).pos
	cast(Node, s).kind = ST_SWITCH
	cast(SwitchStmt, s).tag = subj
	if tagless != 0 {
		cast(SwitchStmt, s).tag = 0
	}
	cast(SwitchStmt, s).cases = cast(Vec[i64], cases)
	cast(SwitchStmt, s).init = 0
	lower_switch(s)
	mut all_return = i64(deflt != 0 && cast(i64, seen) == 0)
	i = 0
	for i < cast(Vec[i64], cases).len {
		if ends_in_return(cast(Vec[i64], cast(Block, vec_get(cast(Vec[i64], vec_get(cases, i)), 1)).stmts)) == 0 {
			all_return = 0
		}
		i = i + 1
	}
	if last != 0 && all_return != 0 && cast(Node, s).kind == ST_BLOCK && ends_in_return(cast(Block, s).stmts) == 0 {
		vec_push(cast(Block, s).stmts, expr_stmt(cast(Node, rt_call(pos, cstr("rt_panic"), args1(lit_string(pos, cstr("unreachable match"))), ty_void))))
	}
	return 1
}

// match_case_expr is the switch case for pattern p of a match on t, or 0 when a switch
// would read it differently. seen marks the enum variants already handled.
fn match_case_expr(p Vec[i64], t Ty, seen Vec[i64], npats i64) i64 {
	let k = cast(Pattern, p).kind
	if k == PAT_LITERAL {
		if cast(i64, seen) != 0 {
			return 0
		}
		return cast(Pattern, p).a
	}
	if k == PAT_NAME_KIND {
		let x = cast(Pattern, p).name
		if cast(i64, seen) != 0 {
			mut name = cast(SelectExpr, x).name
			if cast(Node, x).kind == EX_IDENT {
				name = cast(IdentExpr, x).name
			}
			let vi = enum_variant(t, name)
			if vi < 0 || vec_get(seen, vi) != 0 {
				return 0
			}
			seen.data[vi] = 1
			return x
		}
		if cast(Node, x).kind == EX_SELECT {
			return x
		}
		let sym = lookup_name(cast(IdentExpr, x).name)
		if cast(i64, sym) == 0 || (sym.kind != SYM_GLOBAL && sym.kind != SYM_CONST) {
			return 0
		}
		return x
	}
	if k != PAT_VARIANT || cast(i64, seen) == 0 {
		return 0
	}
	let nm = cast(Pattern, p).name
	mut name = cast(SelectExpr, nm).name
	if cast(Node, nm).kind == EX_IDENT {
		name = cast(IdentExpr, nm).name
	}
	let vi = enum_variant(t, name)
	if vi < 0 || vec_get(seen, vi) != 0 {
		return 0
	}
	let v = cast(Vec[i64], vec_get(cast(Vec[i64], t.enum_), vi))
	let kids = cast(Vec[i64], cast(Pattern, p).children)
	if kids.len > 0 && kids.len != vec_get(v, 2) {
		return 0
	}
	let args = vec_new[i64]()
	mut j = 0
	for j < kids.len {
		let kid = cast(Vec[i64], vec_get(kids, j))
		mut a = cast(IdentExpr, 0)
		if cast(Pattern, kid).kind == PAT_WILD {
			a = cast(IdentExpr, node_new(EX_IDENT, cast(Pattern, kid).pos))
			a.name = cstr("_")
		} else if cast(Pattern, kid).kind == PAT_NAME_KIND && cast(Node, cast(Pattern, kid).name).kind == EX_IDENT && npats == 1 {
			a = cast(IdentExpr, cast(Pattern, kid).name)
			let ft = cast(Ty, field_type(t, vec_get(v, 1) + j))
			if kind_of(ft) == K_STRUCT && ft.enum_ != 0 && enum_variant(ft, a.name) >= 0 {
				return 0
			}
		} else {
			return 0
		}
		vec_push(args, cast(i64, a))
		j = j + 1
	}
	seen.data[vi] = 1
	let c = cast(Call, node_new(EX_CALL, cast(Pattern, p).pos))
	if cast(Node, nm).kind == EX_IDENT {
		c.name = cast(IdentExpr, nm).name
	} else {
		c.callee = nm
	}
	c.args = cast(Vec[i64], args)
	return cast(i64, c)
}

// lower_match_stmt lowers a match statement; its arms' values, if any, are dropped.
fn lower_match_stmt(s i64, m i64) {
	if match_as_switch(s, cast(MatchExpr, m)) != 0 {
		return
	}
	replace_node(s, lower_match(m, MATCH_STMT, cast(Vec[Sym], cast(Vec[i64], 0))))
}

// match_valued lowers a match whose arms store into local vs, and returns the statements
// that declare vs and run the match (vs has no type when every arm leaves).
fn match_valued(pos i64, m i64, vs Sym, mode i64, hint i64) Vec[i64] {
	let out = lower_match(m, mode, cast(Vec[Sym], cast(Vec[i64], mt_record(cast(i64, vs), mode, hint))))
	let stmts = vec_new[i64]()
	let t = vs.type_
	if t != 0 && kind_of(cast(Ty, t)) != K_VOID {
		mut zero = mk_int(pos, 0, t)
		if is_float_t(t) != 0 || kind_of(cast(Ty, t)) == K_STRING {
			zero = zero_value(pos, t)
		}
		vec_push(stmts, let_stmt(pos, vs, zero))
	}
	vec_push(stmts, out)
	return cast(Vec[i64], stmts)
}

fn flat_block(pos i64, stmts i64) i64 {
	let b = cast(Block, empty_block(pos))
	b.flat = 1
	b.stmts = cast(Vec[i64], stmts)
	return cast(i64, b)
}

// check_match_let lowers let x [T] = match ...: the arms store into a hidden local, x takes it.
fn check_match_let(s i64, m Node, t i64) {
	let pos = cast(Node, s).pos
	let vs = cast(Sym, declare_local(pos, mt_name(cstr("$match")), t))
	let stmts = match_valued(pos, cast(i64, m), vs, MATCH_VALUE, 0)
	let l = cast(LetStmt, node_new(ST_LET, pos))
	l.name = cast(LetStmt, s).name
	l.type_ = cast(LetStmt, s).type_
	l.mut_ = cast(LetStmt, s).mut_
	if vs.type_ != 0 {
		l.init = sym_ref_node(pos, vs)
	} else if t == 0 {
		err_code_at(m.pos, cstr("E293 MATCH_VALUE"), cstr("this match gives no value: every arm leaves"))
		replace_node(s, flat_block(pos, cast(i64, stmts)))
		return
	}
	vec_push(stmts, cast(i64, l))
	check_let(cast(i64, l))
	replace_node(s, flat_block(pos, cast(i64, stmts)))
}

// check_match_assign lowers target = match ...: the arms store into a hidden local first.
fn check_match_assign(s Node, target i64, m i64) {
	let pos = s.pos
	mut t = 0
	if cast(Node, target).kind == EX_IDENT && cast(Node, target).type_ != 0 {
		t = cast(Node, target).type_
	} else if cast(Node, target).kind == EX_IDENT && streq(cast(IdentExpr, target).name, cstr("_")) == 0 {
		let sym = lookup_name(cast(IdentExpr, target).name)
		if cast(i64, sym) != 0 && sym.kind != SYM_FUNC {
			t = sym.type_
		}
	}
	let vs = cast(Sym, declare_local(pos, mt_name(cstr("$match")), t))
	let stmts = match_valued(pos, m, vs, MATCH_VALUE, 0)
	if vs.type_ != 0 {
		let a = assign_stmt(pos, target, sym_ref_node(pos, vs))
		vec_push(stmts, a)
		check_assign(a)
	}
	replace_node(cast(i64, s), flat_block(pos, cast(i64, stmts)))
}

// check_match_tail lowers a match that ends a boundary block: its value, if any, is the block's.
fn check_match_tail(s Node, m i64) {
	let pos = s.pos
	let vs = cast(Sym, declare_local(pos, mt_name(cstr("$match")), 0))
	let stmts = match_valued(pos, m, vs, MATCH_TAIL, 0)
	let t = vs.type_
	bound_t = ty_void
	if t != 0 && kind_of(cast(Ty, t)) != K_VOID {
		bound_t = t
		vec_push(stmts, bound_store(pos, sym_ref_node(pos, vs), t))
	}
	replace_node(cast(i64, s), flat_block(pos, cast(i64, stmts)))
}

// chk_match lowers a match inside an expression to an EX_SEQ yielding its value.
fn chk_match(e i64, want i64) i64 {
	let pos = cast(Node, e).pos
	let arms = cast(MatchExpr, e).arms
	mut i = 0
	for i < arms.len {
		let arm = cast(Vec[i64], vec_get(arms, i))
		if cast(MatchArm, arm).block != 0 {
			err_code_at(cast(Node, cast(MatchArm, arm).body).pos, cstr("E293 MATCH_VALUE"), cstr("a match inside an expression has expression arms: give it a statement of its own (let v = match ...)"))
			return ty_int
		}
		i = i + 1
	}
	mut hint = want
	if hint != 0 && (is_untyped(hint) != 0 || kind_of(cast(Ty, hint)) == K_VOID) {
		hint = 0
	}
	let vs = cast(Sym, declare_local(pos, mt_name(cstr("$match")), 0))
	let stmts = match_valued(pos, e, vs, MATCH_EXPR, hint)
	let t = vs.type_
	if t == 0 {
		return ty_int
	}
	replace_node(e, mk_seq(pos, cast(i64, stmts), sym_ref_node(pos, vs), t))
	cast(Node, e).type_ = 0
	return t
}

// check_mstore checks an arm's value and stores it in its match's local; the first value
// gives the local its type unless the context did.
fn check_mstore(s i64) {
	let pos = cast(Node, s).pos
	let x = cast(Node, cast(ExprStmt, s).x)
	let rec = cast(Vec[i64], cast(MatchStmtRec, s).rec)
	let vs = cast(Sym, cast(MatchRec, rec).sym)
	let mode = cast(MatchRec, rec).mode
	mut t = vs.type_
	let k = x.kind
	if k == EX_MATCH && mode != MATCH_EXPR {
		// A match as an arm's value stores into the same local.
		replace_node(s, lower_match(cast(i64, x), mode, cast(Vec[Sym], rec)))
		return
	}
	if (k == EX_TRY || k == EX_CATCH || k == EX_WRAP) && mode != MATCH_EXPR {
		// try in an arm: its value goes through a let of its own, then into the local.
		let l = node_new(ST_LET, pos)
		cast(LetStmt, l).name = cstr("$")
		cast(LetStmt, l).init = cast(i64, x)
		if t != 0 && kind_of(cast(Ty, t)) == K_VOID {
			err_code_at(pos, cstr("E293 MATCH_VALUE"), cstr("the arms of this match must all give a value, or none"))
			return
		}
		lower_try_stmt(l, cast(i64, x), 1, t)
		if cast(Node, l).kind != ST_BLOCK {
			return
		}
		let ls = vec_get(cast(Block, l).stmts, cast(Block, l).stmts.len - 1)
		if cast(Node, ls).kind != ST_LET {
			return
		}
		if t == 0 {
			vs.type_ = cast(Sym, cast(LetStmt, ls).sym).type_
		}
		let a = assign_stmt(pos, sym_ref_node(pos, cast(Sym, vs)), sym_ref_node(pos, cast(Sym, cast(LetStmt, ls).sym)))
		vec_push(cast(Block, l).stmts, a)
		check_assign(a)
		replace_node(s, l)
		return
	}
	mut hint = t
	if hint == 0 {
		hint = cast(MatchRec, rec).hint
	}
	if t != 0 && kind_of(cast(Ty, t)) == K_VOID {
		hint = 0
	}
	let vt = chk(x, hint)
	if kind_of(cast(Ty, vt)) == K_VOID {
		if mode == MATCH_TAIL && (t == 0 || kind_of(cast(Ty, t)) == K_VOID) {
			vs.type_ = ty_void
			replace_node(s, expr_stmt(x))
			return
		}
		err_code_at(pos, cstr("E293 MATCH_VALUE"), cstr("this arm gives no value"))
		return
	}
	if t != 0 && kind_of(cast(Ty, t)) == K_VOID {
		err_code_at(pos, cstr("E293 MATCH_VALUE"), cstr("the arms of this match must all give a value, or none"))
		return
	}
	check_value(pos, vt)
	if t == 0 {
		t = default_type(vt)
		if kind_of(cast(Ty, t)) == K_NIL {
			err_code_at(x.pos, cstr("E233 UNTYPED_NIL"), cstr("use of untyped nil: give the match a type (let v ?T = match ...)"))
			return
		}
		vs.type_ = t
	}
	let a = assign_stmt(pos, sym_ref_node(pos, cast(Sym, vs)), cast(i64, x))
	check_assign(a)
	replace_node(s, a)
}

// mt_void_arm notes a boundary-tail arm block that ends without a value.
fn mt_void_arm(rec MatchRec, pos i64) {
	let vs = cast(Sym, rec.sym)
	if vs.type_ != 0 && kind_of(cast(Ty, vs.type_)) != K_VOID {
		err_code_at(pos, cstr("E293 MATCH_VALUE"), cstr("the arms of this match must all give a value, or none"))
		return
	}
	vs.type_ = ty_void
}

// mt_arm_body is an arm's body block for the mode: its value is stored, returned or dropped.
fn mt_arm_body(arm Vec[i64], mode i64, rec Vec[i64]) i64 {
	let b = cast(MatchArm, arm).body
	if cast(MatchArm, arm).block == 0 {
		let blk = cast(Block, empty_block(cast(Node, b).pos))
		vec_push(cast(Vec[i64], blk.stmts), mt_value(cast(Node, b).pos, b, mode, cast(i64, rec)))
		return cast(i64, blk)
	}
	if mode == MATCH_STMT {
		return b
	}
	let stmts = cast(Block, b).stmts
	let n = stmts.len
	if n > 0 && cast(Node, vec_get(stmts, n - 1)).kind == ST_EXPR {
		let last = vec_get(stmts, n - 1)
		stmts.data[n - 1] = mt_value(cast(Node, last).pos, cast(ExprStmt, last).x, mode, cast(i64, rec))
	} else if ends_in_jump(cast(Vec[Node], stmts)) != 0 {
		return b
	} else if mode == MATCH_TAIL {
		mt_void_arm(cast(MatchRec, cast(Vec[Sym], rec)), cast(Node, b).pos)
	} else {
		err_code_at(cast(Node, b).pos, cstr("E293 MATCH_VALUE"), cstr("a match arm that gives a value ends with it, or leaves (return, break, continue or fail)"))
	}
	return b
}

fn mt_value(pos i64, x i64, mode i64, rec i64) i64 {
	if mode == MATCH_STMT {
		return expr_stmt(cast(Node, x))
	}
	if mode == MATCH_RETURN {
		let r = cast(ReturnStmt, node_new(ST_RETURN, pos))
		r.value = x
		return cast(i64, r)
	}
	let ms = node_new(ST_MSTORE, pos)
	cast(ExprStmt, ms).x = x
	cast(MatchStmtRec, ms).rec = rec
	return ms
}

// A path is how a pattern reaches its value: [local name or 0, symbol, [[offset, type]...]].
fn mt_path(name i64, sym i64) Vec[i64] {
	let p = vec_new[i64]()
	vec_push(p, name)
	vec_push(p, sym)
	vec_push(p, cast(i64, vec_new[i64]()))
	return cast(Vec[i64], p)
}

fn mt_step(path Vec[i64], off i64, t i64) i64 {
	let steps = vec_clone(cast(Vec[i64], vec_get(path, 2)))
	vec_push(steps, pair(off, t))
	let p = vec_new[i64]()
	vec_push(p, vec_get(path, 0))
	vec_push(p, vec_get(path, 1))
	vec_push(p, cast(i64, steps))
	return cast(i64, p)
}

// mt_node reads the value at path. A named local is read by name, so nil arms narrow it.
fn mt_node(pos i64, path Vec[Sym]) i64 {
	mut n = cast(IdentExpr, 0)
	if cast(i64, vec_get(path, 0)) != 0 {
		n = cast(IdentExpr, node_new(EX_IDENT, pos))
		n.name = cast(i64, vec_get(path, 0))
	} else {
		n = cast(IdentExpr, sym_ref_node(pos, vec_get(path, 1)))
	}
	let steps = cast(Vec[i64], vec_get(path, 2))
	mut i = 0
	for i < steps.len {
		let st = cast(Vec[i64], vec_get(steps, i))
		n = cast(IdentExpr, mk_mem(pos, cast(i64, n), 0, 0, vec_get(st, 0), vec_get(st, 1)))
		i = i + 1
	}
	return cast(i64, n)
}

fn mt_is_enum(t Ty) i64 {
	return i64(kind_of(t) == K_STRUCT && t.enum_ != 0)
}

fn mt_compare(pos i64, path Vec[i64], t i64, x i64) i64 {
	let c = cast(Binary, binary_new(pos, cstr("=="), mt_node(pos, cast(Vec[Sym], path)), x))
	if kind_of(cast(Ty, t)) == K_ERROR {
		// A fault arm compares with fault.Is, walking the chain (notes/interface_faults.md).
		c.op = cstr("$is")
	}
	return cast(i64, c)
}

// mt_pattern returns the condition under which pattern p matches the value at path (of type
// t), or 0 when it always does; its bindings are added to binds. top is 0 inside a variant,
// where a bare name always binds, as in a switch case. It sets mt_variant and mt_bool.
fn mt_pattern(p Vec[i64], path Vec[i64], t i64, binds Vec[i64], top i64) i64 {
	let pos = cast(Pattern, p).pos
	let k = cast(Pattern, p).kind
	mt_variant = -1
	mt_bool = 0
	if k == PAT_WILD {
		return 0
	}
	if k == PAT_LITERAL {
		let x = cast(Pattern, p).a
		if mt_is_enum(cast(Ty, t)) != 0 {
			err_code_type(pos, cstr("E290 MATCH_PATTERN"), cstr("an arm of a match on "), t, cstr(" is a variant, like Name or Name(a, b)"))
			return 0
		}
		if cast(Node, x).kind == EX_IDENT && kind_of(cast(Ty, t)) == K_BOOL {
			mt_bool = 1
			if streq(cast(IdentExpr, x).name, cstr("false")) != 0 {
				mt_bool = 2
			}
		}
		return mt_compare(pos, path, t, x)
	}
	if k == PAT_RANGE {
		if is_numeric_t(t) == 0 && kind_of(cast(Ty, t)) != K_STRING {
			err_code_type(pos, cstr("E290 MATCH_PATTERN"), cstr("a range pattern needs a number or a str, not "), t, cstr(""))
			return 0
		}
		let lo = binary_new(pos, cstr(">="), mt_node(pos, cast(Vec[Sym], path)), cast(Pattern, p).a)
		let hi = binary_new(pos, cstr("<"), mt_node(pos, cast(Vec[Sym], path)), cast(Pattern, p).b)
		return binary_new(pos, cstr("&&"), lo, hi)
	}
	let x = cast(Pattern, p).name
	mut name = cast(SelectExpr, x).name
	if cast(Node, x).kind == EX_IDENT {
		name = cast(IdentExpr, x).name
	}
	if k == PAT_VARIANT {
		if mt_is_enum(cast(Ty, t)) == 0 {
			err_code_type(pos, cstr("E290 MATCH_PATTERN"), cstr("a variant pattern needs an enum value, not "), t, cstr(""))
			return 0
		}
		return mt_variant_test(pos, path, cast(Ty, t), name, cast(Vec[i64], cast(Pattern, p).children), cast(Vec[i64], binds))
	}
	if cast(Node, x).kind == EX_SELECT {
		if mt_is_enum(cast(Ty, t)) != 0 {
			return mt_variant_test(pos, path, cast(Ty, t), name, cast(Vec[i64], 0), cast(Vec[i64], binds))
		}
		return mt_compare(pos, path, t, x)
	}
	if mt_is_enum(cast(Ty, t)) != 0 && enum_variant(cast(Ty, t), name) >= 0 {
		return mt_variant_test(pos, path, cast(Ty, t), name, cast(Vec[i64], 0), cast(Vec[i64], binds))
	}
	if top != 0 {
		let sym = lookup_name(name)
		if cast(i64, sym) != 0 && (sym.kind == SYM_GLOBAL || sym.kind == SYM_CONST) {
			return mt_compare(pos, path, t, x)
		}
		if cast(i64, sym) != 0 && sym.kind == SYM_LOCAL {
			let u = err_code(pos, cstr("E290 MATCH_PATTERN"))
			buf_str(u, cstr("'"))
			buf_str(u, name)
			buf_str(u, cstr("' is a variable, and a name in a pattern binds a new one: compare with a guard (v if v == "))
			buf_str(u, name)
			buf_str(u, cstr(")"))
			err_end(cast(Buf, u))
			return 0
		}
		if mt_is_enum(cast(Ty, t)) != 0 && i64(load8(name)) >= 'A' && i64(load8(name)) <= 'Z' {
			let u = err_code(pos, cstr("E290 MATCH_PATTERN"))
			type_name(cast(Buf, u), cast(Ty, t))
			buf_str(u, cstr(" has no variant "))
			buf_str(u, name)
			err_end(cast(Buf, u))
			return 0
		}
	}
	let l = cast(LetStmt, node_new(ST_LET, pos))
	l.name = name
	l.init = mt_node(pos, cast(Vec[Sym], path))
	vec_push(binds, cast(i64, l))
	return 0
}

// mt_variant_test tests the tag of the enum value at path, then its values' patterns.
fn mt_variant_test(pos i64, path Vec[i64], t Ty, name i64, kids Vec[i64], binds Vec[i64]) i64 {
	let vi = enum_variant(t, name)
	if vi < 0 {
		let u = err_code(pos, cstr("E290 MATCH_PATTERN"))
		type_name(cast(Buf, u), t)
		buf_str(u, cstr(" has no variant "))
		buf_str(u, name)
		err_end(cast(Buf, u))
		return 0
	}
	let v = cast(Vec[i64], vec_get(cast(Vec[i64], t.enum_), vi))
	let tag = mk_mem(pos, mt_node(pos, cast(Vec[Sym], path)), 0, 0, field_offset(t, 0), ty_int)
	mut cond = mk_bin(pos, cstr("=="), tag, mk_int(pos, vi, ty_int), ty_bool)
	mut whole = 1
	if cast(i64, kids) != 0 && kids.len > 0 {
		if kids.len != vec_get(v, 2) {
			let u = err_code(pos, cstr("E290 MATCH_PATTERN"))
			buf_str(u, name)
			buf_str(u, cstr(" has "))
			buf_int(u, vec_get(v, 2))
			buf_str(u, cstr(" values, the pattern has "))
			buf_int(u, kids.len)
			err_end(cast(Buf, u))
			return cond
		}
		mut j = 0
		for j < kids.len {
			let fi = vec_get(v, 1) + j
			let ft = field_type(t, fi)
			let c = mt_pattern(cast(Vec[i64], vec_get(kids, j)), cast(Vec[i64], mt_step(path, field_offset(t, fi), ft)), ft, binds, 0)
			if c != 0 {
				whole = 0
				cond = binary_new(pos, cstr("&&"), cond, c)
			}
			j = j + 1
		}
	}
	mt_variant = -1
	if whole != 0 {
		mt_variant = vi
	}
	mt_bool = 0
	return cond
}

// lower_match lowers match m to a checked block. rec is the value record (MATCH_VALUE,
// MATCH_TAIL, MATCH_EXPR), or 0.
fn lower_match(m i64, mode i64, rec Vec[Sym]) i64 {
	let pos = cast(Node, m).pos
	let arms = cast(MatchExpr, m).arms
	let subj = cast(MatchExpr, m).subject
	let out = cast(Block, empty_block(pos))
	push_scope()
	mut st = cast(Ty, chk(cast(Node, subj), 0))
	if is_untyped(cast(i64, st)) != 0 {
		st = cast(Ty, default_type(cast(i64, st)))
		if kind_of(st) == K_NIL {
			err_code_at(cast(Node, subj).pos, cstr("E233 UNTYPED_NIL"), cstr("use of untyped nil"))
			pop_scope()
			return cast(i64, out)
		}
		reconvert(cast(Node, subj), cast(i64, st))
	}
	if kind_of(st) == K_VOID || kind_of(st) == K_TUPLE {
		err_code_type(cast(Node, subj).pos, cstr("E290 MATCH_PATTERN"), cstr("cannot match on "), cast(i64, st), cstr(""))
		pop_scope()
		return cast(i64, out)
	}
	// The subject is read once into a hidden local, or, a local optional, read in place, so
	// that a nil arm narrows it for the arms after; optionals are read by name to narrow.
	mut path = cast(Vec[i64], 0)
	if kind_of(st) == K_OPT && cast(Node, subj).kind == EX_IDENT && cast(IdentExpr, subj).ref != 0 && cast(Sym, cast(IdentExpr, subj).ref).kind == SYM_LOCAL {
		path = mt_path(cast(IdentExpr, subj).name, 0)
	} else if kind_of(st) == K_OPT {
		let tmp = declare_local(pos, mt_name(cstr("$subject")), cast(i64, st))
		vec_push(cast(Vec[i64], out.stmts), let_stmt(pos, cast(Sym, tmp), subj))
		path = mt_path(cast(Sym, tmp).name, 0)
	} else {
		let tmp = temp(pos, subj, cast(i64, st))
		vec_push(cast(Vec[i64], out.stmts), cast(i64, tmp))
		path = mt_path(0, cast(LetStmt, tmp).sym)
	}
	mut covered = cast(Vec[i64], 0)
	if mt_is_enum(st) != 0 {
		covered = vec_filled(cast(Vec[i64], st.enum_).len, 0)
	}
	mut seen_true = 0
	mut seen_false = 0
	mut catchall = 0
	mut goflag = 0
	let bodies = vec_new[Block]()
	let chain = cast(Block, empty_block(pos))
	mut dest = cast(Vec[i64], chain.stmts)
	mut last_if = cast(IfStmt, 0)
	mut i = 0
	for i < arms.len {
		let arm = cast(Vec[i64], vec_get(arms, i))
		let apos = cast(MatchArm, arm).pos
		let pats = cast(Vec[i64], cast(MatchArm, arm).patterns)
		let guard_ = cast(MatchArm, arm).guard_
		if catchall != 0 {
			err_code_at(apos, cstr("E292 MATCH_UNREACHABLE"), cstr("this arm is never reached: an earlier arm matches every value"))
			break
		}
		let binds = vec_new[i64]()
		mut test = 0
		mut always = 0
		mut j = 0
		for j < pats.len {
			let p = cast(Vec[i64], vec_get(pats, j))
			let errs = error_count
			mut c = mt_pattern(p, path, cast(i64, st), cast(Vec[i64], binds), 1)
			if c == 0 && error_count > errs {
				// A pattern in error matches nothing, so the arms after it are not reported.
				c = mk_int(apos, 0, ty_bool)
			}
			if mt_variant >= 0 {
				if vec_get(covered, mt_variant) != 0 {
					err_code_quoted(cast(Pattern, p).pos, cstr("E292 MATCH_UNREACHABLE"), cstr("variant "), vec_get(cast(Vec[i64], vec_get(cast(Vec[i64], st.enum_), mt_variant)), 0), cstr(" is already handled by an earlier arm"))
				}
				if guard_ == 0 {
					covered.data[mt_variant] = 1
				}
			}
			if guard_ == 0 && mt_bool == 1 {
				seen_true = 1
			}
			if guard_ == 0 && mt_bool == 2 {
				seen_false = 1
			}
			if c == 0 {
				always = 1
			} else if test != 0 {
				test = binary_new(apos, cstr("||"), test, c)
			} else {
				test = c
			}
			j = j + 1
		}
		if always != 0 {
			test = 0
		}
		if pats.len > 1 && cast(Vec[i64], binds).len > 0 {
			err_code_at(apos, cstr("E290 MATCH_PATTERN"), cstr("an arm with several patterns cannot bind names: give each its own arm"))
		}
		let body = cast(Block, mt_arm_body(arm, mode, cast(Vec[i64], rec)))
		vec_push(bodies, cast(Block, body))
		// The bindings come first in the arm's block.
		if cast(Vec[i64], binds).len > 0 && guard_ == 0 {
			mut k2 = 0
			for k2 < cast(Vec[i64], body.stmts).len {
				vec_push(binds, vec_get(cast(Vec[i64], body.stmts), k2))
				k2 = k2 + 1
			}
			body.stmts = cast(Vec[i64], binds)
		}
		mut stmt = cast(IfStmt, 0)
		if guard_ != 0 && cast(Vec[i64], binds).len > 0 {
			// if test { binds; if guard { $go = false; body } }  if $go { the other arms }
			if goflag == 0 {
				goflag = declare_local(pos, mt_name(cstr("$go")), ty_bool)
				vec_push(cast(Vec[i64], out.stmts), let_stmt(pos, cast(Sym, goflag), mk_int(pos, 1, ty_bool)))
			}
			let clear_ = assign_stmt(apos, sym_ref_node(apos, cast(Sym, goflag)), mk_int(apos, 0, ty_bool))
			let taken = vec_new[i64]()
			vec_push(taken, clear_)
			mut k3 = 0
			for k3 < cast(Vec[i64], body.stmts).len {
				vec_push(taken, vec_get(cast(Vec[i64], body.stmts), k3))
				k3 = k3 + 1
			}
			body.stmts = cast(Vec[i64], taken)
			let gif = cast(IfStmt, node_new(ST_IF, apos))
			gif.cond = guard_
			gif.then = cast(i64, body)
			let inner = cast(Block, empty_block(apos))
			vec_push(binds, cast(i64, gif))
			inner.stmts = cast(Vec[i64], binds)
			stmt = cast(IfStmt, inner)
			if test != 0 {
				stmt = cast(IfStmt, node_new(ST_IF, apos))
				stmt.cond = test
				stmt.then = cast(i64, inner)
			}
			let rest = cast(IfStmt, node_new(ST_IF, apos))
			rest.cond = sym_ref_node(apos, cast(Sym, goflag))
			rest.then = empty_block(apos)
			let wrap_ = cast(Block, empty_block(apos))
			vec_push(cast(Vec[i64], wrap_.stmts), cast(i64, stmt))
			vec_push(cast(Vec[i64], wrap_.stmts), cast(i64, rest))
			if cast(i64, last_if) != 0 {
				last_if.else_ = cast(i64, wrap_)
			} else {
				vec_push(dest, cast(i64, wrap_))
			}
			dest = cast(Block, rest.then).stmts
			last_if = cast(IfStmt, 0)
		} else {
			mut cond = test
			if guard_ != 0 && cond != 0 {
				cond = binary_new(apos, cstr("&&"), cond, guard_)
			} else if guard_ != 0 {
				cond = guard_
			}
			stmt = cast(IfStmt, body)
			if cond != 0 {
				stmt = cast(IfStmt, node_new(ST_IF, apos))
				stmt.cond = cond
				stmt.then = cast(i64, body)
			} else {
				catchall = 1
			}
			if cast(i64, last_if) != 0 {
				last_if.else_ = cast(i64, stmt)
			} else {
				vec_push(dest, cast(i64, stmt))
			}
			last_if = cast(IfStmt, 0)
			if cond != 0 {
				last_if = stmt
			}
		}
		i = i + 1
	}
	let exhaustive = i64(catchall != 0 || (cast(i64, covered) != 0 && all_seen(covered) != 0) || (seen_true != 0 && seen_false != 0))
	if cast(i64, covered) != 0 && catchall == 0 && all_seen(covered) == 0 {
		let missing = buf_new()
		mut n = 0
		mut v = 0
		for v < covered.len {
			if vec_get(covered, v) == 0 {
				if n > 0 {
					buf_str(missing, cstr(", "))
				}
				buf_str(missing, vec_get(cast(Vec[i64], vec_get(cast(Vec[i64], st.enum_), v)), 0))
				n = n + 1
			}
			v = v + 1
		}
		buf_byte(missing, 0)
		let u = err_code(pos, cstr("E291 MATCH_EXHAUSTIVE"))
		buf_str(u, cstr("match on "))
		type_name(cast(Buf, u), st)
		buf_str(u, cstr(" does not handle "))
		buf_str(u, missing.data)
		buf_str(u, cstr(" (add the arms, or _)"))
		err_end(cast(Buf, u))
	} else if exhaustive == 0 && (mode == MATCH_VALUE || mode == MATCH_RETURN || mode == MATCH_EXPR) {
		err_code_at(pos, cstr("E291 MATCH_EXHAUSTIVE"), cstr("a match that gives a value must handle every value: add a _ arm"))
	}
	vec_push(cast(Vec[i64], out.stmts), cast(i64, chain))
	check_stmt(cast(i64, chain))
	pop_scope()
	if mode == MATCH_TAIL && exhaustive == 0 {
		let vt = cast(Sym, cast(MatchRec, rec).sym).type_
		if vt != 0 && kind_of(cast(Ty, vt)) != K_VOID {
			err_code_at(pos, cstr("E291 MATCH_EXHAUSTIVE"), cstr("a match that gives a value must handle every value: add a _ arm"))
		}
	}
	// Every value handled and every arm leaves: nothing runs after the match. (A return
	// match that misses a value is an error already.)
	mut leaves = i64(exhaustive != 0 || mode == MATCH_RETURN)
	mut b = 0
	for b < bodies.len {
		if ends_in_jump(cast(Vec[Node], vec_get(bodies, b).stmts)) == 0 {
			leaves = 0
		}
		b = b + 1
	}
	if leaves != 0 && ends_in_return(cast(Vec[i64], out.stmts)) == 0 {
		vec_push(cast(Vec[i64], out.stmts), expr_stmt(cast(Node, rt_call(pos, cstr("rt_panic"), args1(lit_string(pos, cstr("unreachable match"))), ty_void))))
	}
	return cast(i64, out)
}

fn pair(a i64, b i64) i64 {
	let v = vec_new[i64]()
	vec_push(v, a)
	vec_push(v, b)
	return cast(i64, v)
}

fn len_alias_remember(sym Sym, init i64) {
	if cast(i64, sym) == 0 || sym.kind != SYM_LOCAL || sym.cell != 0 || init == 0 || cast(Node, init).kind != EX_MEM || cast(MemExpr, init).hdr == 0 || cast(MemExpr, init).off != 0 {
		return
	}
	let base = cast(MemExpr, init).base
	if cast(Node, base).kind != EX_IDENT {
		return
	}
	let source = cast(Sym, cast(IdentExpr, base).ref)
	if cast(i64, source) == 0 || source.kind != SYM_LOCAL || source.cell != 0 || (kind_of(cast(Ty, source.type_)) != K_SLICE && kind_of(cast(Ty, source.type_)) != K_STRING) {
		return
	}
	vec_push(len_aliases, pair(cast(i64, sym), cast(i64, source)))
}

fn len_alias_source(sym i64) i64 {
	mut i = len_aliases.len - 1
	for i >= 0 {
		let p = cast(Vec[i64], vec_get(len_aliases, i))
		if vec_get(p, 0) == sym {
			return vec_get(p, 1)
		}
		i = i - 1
	}
	return 0
}

fn len_alias_invalidate(sym i64) {
	if sym == 0 {
		return
	}
	let n = len_aliases.len
	mut i = 0
	for i < n {
		let p = cast(Vec[i64], vec_get(len_aliases, i))
		let alias = vec_get(p, 0)
		if alias == sym || vec_get(p, 1) == sym {
			vec_push(len_aliases, pair(alias, 0))
		}
		i = i + 1
	}
}

// stmt_may_change_slice is conservative: explicit mut arguments and calls through
// local function values can change a captured slice header, so they invalidate len facts.
fn stmt_may_change_slice(s i64, name i64) i64 {
	if s == 0 {
		return 0
	}
	let k = cast(Node, s).kind
	if k == ST_BLOCK || k == ST_LIST {
		mut stmts = cast(Block, s).stmts
		if k == ST_LIST {
			stmts = cast(ListStmt, s).stmts
		}
		mut i = 0
		for i < stmts.len {
			if stmt_may_change_slice(vec_get(stmts, i), name) != 0 {
				return 1
			}
			i = i + 1
		}
		return 0
	}
	if k == ST_LET {
		return expr_may_change_slice(cast(LetStmt, s).init, name)
	}
	if k == ST_ASSIGN {
		return i64(expr_may_change_slice(cast(AssignStmt, s).target, name) != 0 || expr_may_change_slice(cast(AssignStmt, s).value, name) != 0)
	}
	if k == ST_MULTI {
		let vals = cast(MultiStmt, s).values
		mut i = 0
		for cast(i64, vals) != 0 && i < vals.len {
			if expr_may_change_slice(vec_get(vals, i), name) != 0 {
				return 1
			}
			i = i + 1
		}
		let targets = cast(MultiStmt, s).targets
		i = 0
		for cast(i64, targets) != 0 && i < targets.len {
			if expr_may_change_slice(vec_get(targets, i), name) != 0 {
				return 1
			}
			i = i + 1
		}
		return 0
	}
	if k == ST_EXPR {
		return expr_may_change_slice(cast(ExprStmt, s).x, name)
	}
	if k == ST_IF {
		return i64(stmt_may_change_slice(cast(IfStmt, s).init, name) != 0 || expr_may_change_slice(cast(IfStmt, s).cond, name) != 0 || stmt_may_change_slice(cast(IfStmt, s).then, name) != 0 || stmt_may_change_slice(cast(IfStmt, s).else_, name) != 0)
	}
	if k == ST_WHILE {
		return i64(stmt_may_change_slice(cast(WhileStmt, s).init, name) != 0 || expr_may_change_slice(cast(WhileStmt, s).cond, name) != 0 || stmt_may_change_slice(cast(WhileStmt, s).post, name) != 0 || stmt_may_change_slice(cast(WhileStmt, s).body, name) != 0)
	}
	if k == ST_RANGE {
		return i64(expr_may_change_slice(cast(RangeStmt, s).expr, name) != 0 || stmt_may_change_slice(cast(RangeStmt, s).body, name) != 0)
	}
	if k == ST_CALLMULTI {
		return expr_may_change_slice(cast(CallMultiStmt, s).call, name)
	}
	if k == ST_RETURN || k == ST_BREAK || k == ST_CONTINUE || k == ST_CONST {
		return 0
	}
	// Switch, defer and other less common control forms keep the existing checks.
	return 1
}

fn expr_may_change_slice(e i64, name i64) i64 {
	if e == 0 {
		return 0
	}
	let k = cast(Node, e).kind
	if k == EX_CALL {
		let callee = cast(Call, e).callee
		if callee != 0 {
			if cast(Node, callee).kind == EX_IDENT {
				let target = lookup_name(cast(IdentExpr, callee).name)
				if cast(i64, target) != 0 && cast(Sym, target).kind == SYM_LOCAL && kind_of(cast(Ty, cast(Sym, target).type_)) == K_FUNC {
					return 1
				}
			} else if cast(Node, callee).kind == EX_SELECT {
				let base = cast(SelectExpr, callee).x
				if cast(Node, base).kind != EX_IDENT {
					return 1
				}
				let target = lookup_name(cast(IdentExpr, base).name)
				if cast(i64, target) != 0 && cast(Sym, target).kind == SYM_LOCAL {
					return 1
				}
			} else {
				return 1
			}
		} else if cast(Call, e).name != 0 {
			let target = lookup_name(cast(Call, e).name)
			if cast(i64, target) != 0 && cast(Sym, target).kind == SYM_LOCAL && kind_of(cast(Ty, cast(Sym, target).type_)) == K_FUNC {
				return 1
			}
		}
		let args = cast(Call, e).args
		mut i = 0
		for cast(i64, args) != 0 && i < args.len {
			let a = vec_get(args, i)
			if cast(Node, a).kind == EX_MUTARG {
				let target = cast(MutArg, a).x
				if name == 0 || (cast(Node, target).kind == EX_IDENT && streq(cast(IdentExpr, target).name, name) != 0) {
					return 1
				}
			}
			if expr_may_change_slice(a, name) != 0 {
				return 1
			}
			i = i + 1
		}
		return expr_may_change_slice(callee, name)
	}
	if k == EX_BINARY {
		return i64(expr_may_change_slice(cast(Binary, e).l, name) != 0 || expr_may_change_slice(cast(Binary, e).r, name) != 0)
	}
	if k == EX_UNARY {
		return expr_may_change_slice(cast(Unary, e).x, name)
	}
	if k == EX_CONV {
		return expr_may_change_slice(cast(Conv, e).x, name)
	}
	if k == EX_SELECT {
		return expr_may_change_slice(cast(SelectExpr, e).x, name)
	}
	if k == EX_INDEX {
		return i64(expr_may_change_slice(cast(IndexExpr, e).x, name) != 0 || expr_may_change_slice(cast(IndexExpr, e).i, name) != 0)
	}
	if k == EX_SLICE {
		return i64(expr_may_change_slice(cast(SliceExpr, e).x, name) != 0 || expr_may_change_slice(cast(SliceExpr, e).lo, name) != 0 || expr_may_change_slice(cast(SliceExpr, e).hi, name) != 0)
	}
	if k == EX_MEM {
		return i64(expr_may_change_slice(cast(MemExpr, e).base, name) != 0 || expr_may_change_slice(cast(MemExpr, e).index, name) != 0 || expr_may_change_slice(cast(MemExpr, e).len, name) != 0)
	}
	if k == EX_ELEM {
		return i64(expr_may_change_slice(cast(ElemExpr, e).seq, name) != 0 || expr_may_change_slice(cast(ElemExpr, e).idx, name) != 0)
	}
	if k == EX_MUTARG {
		let target = cast(MutArg, e).x
		return i64(name == 0 || (cast(Node, target).kind == EX_IDENT && streq(cast(IdentExpr, target).name, name) != 0) || expr_may_change_slice(target, name) != 0)
	}
	if k == EX_INT || k == EX_STR || k == EX_IDENT || k == EX_FLOAT || k == EX_NIL || k == EX_TYPE || k == EX_FUNCREF || k == EX_REG {
		return 0
	}
	// Sequence, closure, composite, try/catch and unknown expressions are not proven pure here.
	return 1
}

// names_assigned reports whether any statement under s assigns to a variable named
// a or b (shadowing declarations are fine: they make different symbols).
fn names_assigned(s i64, a i64, b i64) i64 {
	if s == 0 {
		return 0
	}
	let mx = cast(Node, mt_stmt_expr(s))
	if cast(i64, mx) != 0 && mx.kind == EX_MATCH && mt_names_assigned(cast(MatchExpr, mx), a, b) != 0 {
		return 1
	}
	let k = cast(Node, s).kind
	if k == ST_ASSIGN {
		let t = cast(AssignStmt, s).target
		if cast(Node, t).kind == EX_IDENT && (streq(cast(IdentExpr, t).name, a) != 0 || streq(cast(IdentExpr, t).name, b) != 0) {
			return 1
		}
		return 0
	}
	if k == ST_MULTI && cast(MultiStmt, s).define == 0 {
		let ts = cast(MultiStmt, s).targets
		mut i = 0
		for i < ts.len {
			let t = vec_get(ts, i)
			if cast(Node, t).kind == EX_IDENT && (streq(cast(IdentExpr, t).name, a) != 0 || streq(cast(IdentExpr, t).name, b) != 0) {
				return 1
			}
			i = i + 1
		}
		return 0
	}
	if k == ST_BLOCK {
		mut i = 0
		for i < cast(Block, s).stmts.len {
			if names_assigned(vec_get(cast(Block, s).stmts, i), a, b) != 0 {
				return 1
			}
			i = i + 1
		}
		return 0
	}
	if k == ST_IF {
		return i64(names_assigned(cast(IfStmt, s).init, a, b) != 0 || names_assigned(cast(IfStmt, s).then, a, b) != 0 || names_assigned(cast(IfStmt, s).else_, a, b) != 0)
	}
	if k == ST_WHILE {
		return i64(names_assigned(cast(WhileStmt, s).init, a, b) != 0 || names_assigned(cast(WhileStmt, s).body, a, b) != 0 || names_assigned(cast(WhileStmt, s).post, a, b) != 0)
	}
	if k == ST_RANGE {
		if cast(RangeStmt, s).define == 0 && ((cast(RangeStmt, s).key != 0 && cast(Node, cast(RangeStmt, s).key).kind == EX_IDENT && (streq(cast(IdentExpr, cast(RangeStmt, s).key).name, a) != 0 || streq(cast(IdentExpr, cast(RangeStmt, s).key).name, b) != 0)) || (cast(RangeStmt, s).val != 0 && cast(Node, cast(RangeStmt, s).val).kind == EX_IDENT && (streq(cast(IdentExpr, cast(RangeStmt, s).val).name, a) != 0 || streq(cast(IdentExpr, cast(RangeStmt, s).val).name, b) != 0))) {
			return 1
		}
		return names_assigned(cast(RangeStmt, s).body, a, b)
	}
	if k == ST_SWITCH {
		if names_assigned(cast(SwitchStmt, s).init, a, b) != 0 {
			return 1
		}
		let cs = cast(SwitchStmt, s).cases
		mut i = 0
		for i < cs.len {
			if names_assigned(vec_get(cast(Vec[i64], vec_get(cs, i)), 1), a, b) != 0 {
				return 1
			}
			i = i + 1
		}
	}
	return 0
}

// mark_safe_index drops the bounds check of x[i] when a loop or condition proved i is
// within x's length.
fn mark_safe_index(e ElemExpr) {
	let x = e.seq
	let i = e.idx
	if cast(Node, x).kind != EX_IDENT || cast(Node, i).kind != EX_IDENT {
		return
	}
	mut j = 0
	for j < safe_pairs.len {
		let p = cast(Vec[i64], vec_get(safe_pairs, j))
		if vec_get(p, 0) == cast(IdentExpr, i).ref && vec_get(p, 1) == cast(IdentExpr, x).ref {
			e.safe = 1
			return
		}
		j = j + 1
	}
}

// len_bound matches `i < len(x)` or `i < n` where n remembers len(x), and
// returns [i sym, x sym, remembered length sym], or 0.
fn len_bound(c i64) Vec[i64] {
	if cast(Node, c).kind != EX_BINARY || streq(cast(Binary, c).op, cstr("<")) == 0 {
		return cast(Vec[i64], 0)
	}
	let l = cast(Binary, c).l
	let r = cast(Binary, c).r
	if cast(Node, l).kind != EX_IDENT {
		return cast(Vec[i64], 0)
	}
	let is = cast(Sym, cast(IdentExpr, l).ref)
	mut xs = cast(Sym, 0)
	mut length = 0
	if cast(Node, r).kind == EX_MEM && cast(MemExpr, r).hdr != 0 && cast(MemExpr, r).off == 0 && cast(Node, cast(MemExpr, r).base).kind == EX_IDENT {
		xs = cast(Sym, cast(IdentExpr, cast(MemExpr, r).base).ref)
	} else if cast(Node, r).kind == EX_IDENT {
		length = cast(IdentExpr, r).ref
		if length != 0 {
			xs = cast(Sym, len_alias_source(length))
		}
	}
	if cast(i64, is) == 0 || cast(i64, xs) == 0 || is.kind != SYM_LOCAL || xs.kind != SYM_LOCAL {
		return cast(Vec[i64], 0)
	}
	let b = cast(Vec[i64], pair(cast(i64, is), cast(i64, xs)))
	vec_push(b, length)
	return cast(Vec[i64], b)
}

// add_len_fact makes x[i] unchecked inside `if i < len(x) {...}` when i cannot be
// negative (unsigned, or `i >= 0 &&` first) and the block reassigns neither.
fn add_len_fact(c i64, then i64) {
	mut b = len_bound(c)
	mut nonneg = 0
	if cast(i64, b) == 0 && cast(Node, c).kind == EX_BINARY && streq(cast(Binary, c).op, cstr("&&")) != 0 {
		let lo = cast(Binary, c).l
		b = len_bound(cast(Binary, c).r)
		if cast(i64, b) != 0 && cast(Node, lo).kind == EX_BINARY && streq(cast(Binary, lo).op, cstr(">=")) != 0 && cast(Node, cast(Binary, lo).l).kind == EX_IDENT && cast(IdentExpr, cast(Binary, lo).l).ref == vec_get(b, 0) && is_const_zero(cast(Binary, lo).r) != 0 {
			nonneg = 1
		}
	}
	if cast(i64, b) == 0 {
		return
	}
	let is = cast(Sym, vec_get(b, 0))
	if is_unsigned_t(cast(Ty, is.type_)) != 0 {
		nonneg = 1
	}
	let xs = cast(Sym, vec_get(b, 1))
	let length = cast(Sym, vec_get(b, 2))
	mut stable = i64(names_assigned(then, is.name, xs.name) == 0 && stmt_may_change_slice(then, xs.name) == 0)
	if cast(i64, length) != 0 && names_assigned(then, length.name, cstr("")) != 0 {
		stable = 0
	}
	if nonneg != 0 && stable != 0 {
		vec_push(safe_pairs, cast(i64, b))
	}
}

// lower_for_init checks `for init; cond; post {}` as { init; for cond; post {} },
// proving `for i := c; i < len(x); i++` keeps i in range for x[i] in the body.
fn lower_for_init(s i64) {
	let init = cast(WhileStmt, s).init
	mut init_name = 0
	if cast(Node, init).kind == ST_LET {
		init_name = cast(LetStmt, init).name
	}
	let s_pos = cast(Node, s).pos
	let inner = cast(WhileStmt, node_new(ST_WHILE, cast(Node, s).pos))
	replace_node(cast(i64, inner), s)
	inner.init = 0
	let b = cast(Block, empty_block(cast(Node, s).pos))
	vec_push(cast(Vec[i64], b.stmts), init)
	vec_push(cast(Vec[i64], b.stmts), cast(i64, inner))
	replace_node(s, cast(i64, b))
	push_scope()
	check_stmt(init)
	check_cond(cast(Node, inner.cond))
	let saved = safe_pairs.len
	let bound = len_bound(inner.cond)
	if cast(i64, bound) != 0 && cast(Node, init).kind == ST_LET && cast(LetStmt, init).sym == vec_get(bound, 0) && cast(Node, cast(LetStmt, init).init).kind == EX_INT && cast(IntLit, cast(LetStmt, init).init).val >= 0 && is_increment(inner.post, cast(LetStmt, init).name) != 0 {
		let xs = cast(Sym, vec_get(bound, 1))
		let length = cast(Sym, vec_get(bound, 2))
		mut stable = i64(names_assigned(inner.body, cast(LetStmt, init).name, xs.name) == 0 && stmt_may_change_slice(inner.body, xs.name) == 0)
		if cast(i64, length) != 0 {
			if names_assigned(inner.body, length.name, xs.name) != 0 || names_assigned(inner.post, length.name, xs.name) != 0 || names_assigned(inner.post, xs.name, cstr("")) != 0 || stmt_may_change_slice(inner.post, xs.name) != 0 {
				stable = 0
			}
		}
		if stable != 0 {
			vec_push(safe_pairs, pair(vec_get(bound, 0), cast(i64, xs)))
		}
	}
	ck_loops = ck_loops + 1
	ck_breaks = ck_breaks + 1
	vec_push(ck_labels, inner.label)
	check_scoped(cast(Block, inner.body))
	safe_pairs.len = saved
	if inner.post != 0 {
		push_scope()
		check_stmt(inner.post)
		pop_scope()
		// A loop variable a closure captures is a fresh variable in each iteration: before the post
		// statement, move its current value into a new cell, so closures made earlier keep the old one.
		if cast(Node, init).kind == ST_BLOCK || cast(Node, init).kind == ST_LET {
			mut lv = cast(Sym, 0)
			if init_name != 0 {
				lv = cast(Sym, lookup_name_local(init_name))
			}
			if cast(i64, lv) != 0 && lv.cell != 0 {
				let pos = s_pos
				let t = lv.type_
				let csym = lv.cell_sym
				let old_val = temp(pos, mk_mem(pos, sym_ref_node(pos, cast(Sym, csym)), 0, 0, 0, t), t)
				let nb = cast(Block, node_new(ST_BLOCK, pos))
				nb.stmts = vec_new[i64]()
				nb.flat = 1
				vec_push(cast(Vec[i64], nb.stmts), cast(i64, old_val))
				vec_push(cast(Vec[i64], nb.stmts), assign_stmt(pos, sym_ref_node(pos, cast(Sym, csym)), rt_call(pos, cstr("rt_alloc"), args1(mk_int(pos, 8, ty_int)), ty_int)))
				vec_push(cast(Vec[i64], nb.stmts), assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, cast(Sym, csym)), 0, 0, 0, t), sym_ref_node(pos, cast(Sym, old_val.sym))))
				vec_push(cast(Vec[i64], nb.stmts), inner.post)
				inner.post = cast(i64, nb)
			}
		}
	}
	ck_labels.len = ck_labels.len - 1
	ck_loops = ck_loops - 1
	ck_breaks = ck_breaks - 1
	pop_scope()
}

// is_increment matches the unchecked post statement `i = i + c` (i++, i += c) with c > 0.
// is_increment reports whether post adds a positive constant to name. The step is at most 2^32:
// with the counter below a length (far under 2^62), counter + step cannot wrap past MaxInt64
// to a negative index, which the bounds proof relies on (#95).
fn is_increment(post i64, name i64) i64 {
	if post == 0 || cast(Node, post).kind != ST_ASSIGN {
		return 0
	}
	let t = cast(AssignStmt, post).target
	let v = cast(AssignStmt, post).value
	return i64(cast(Node, t).kind == EX_IDENT && streq(cast(IdentExpr, t).name, name) != 0 && cast(Node, v).kind == EX_BINARY && streq(cast(Binary, v).op, cstr("+")) != 0 && cast(Node, cast(Binary, v).l).kind == EX_IDENT && streq(cast(IdentExpr, cast(Binary, v).l).name, name) != 0 && cast(Node, cast(Binary, v).r).kind == EX_INT && cast(IntLit, cast(Binary, v).r).val > 0 && cast(IntLit, cast(Binary, v).r).val <= 4294967296)
}

// ---- optional narrowing ----
// narrow_begin narrows x from ?T to T where the condition proves x != nil (sense 1:
// the condition holds; sense 0: it failed). It returns what narrow_end restores.
fn narrow_begin(c i64, sense i64) Vec[i64] {
	if cast(Node, c).kind != EX_BINARY {
		return cast(Vec[i64], 0)
	}
	let op = cast(Binary, c).op
	// a != nil && b != nil holds, or a == nil || b == nil failed: both are narrowed.
	if (streq(op, cstr("&&")) != 0 && sense != 0) || (streq(op, cstr("||")) != 0 && sense == 0) {
		let ra = narrow_begin(cast(Binary, c).l, sense)
		let rb = narrow_begin(cast(Binary, c).r, sense)
		if cast(i64, ra) == 0 {
			return rb
		}
		if cast(i64, rb) == 0 {
			return ra
		}
		let both = vec_new[i64]()
		vec_push(both, 0)
		vec_push(both, cast(i64, ra))
		vec_push(both, cast(i64, rb))
		return cast(Vec[i64], both)
	}
	mut x = cast(Binary, c).l
	mut other = cast(Binary, c).r
	if cast(Node, x).kind != EX_IDENT {
		x = cast(Binary, c).r
		other = cast(Binary, c).l
	}
	if cast(Node, x).kind != EX_IDENT || cast(IdentExpr, x).ref == 0 || cast(Node, other).kind != EX_INT || cast(IntLit, other).val != 0 {
		return cast(Vec[i64], 0)
	}
	let s = cast(Sym, cast(IdentExpr, x).ref)
	if s.kind != SYM_LOCAL || kind_of(cast(Ty, s.type_)) != K_OPT {
		return cast(Vec[i64], 0)
	}
	let nonnil = i64((streq(op, cstr("!=")) != 0 && sense != 0) || (streq(op, cstr("==")) != 0 && sense == 0))
	if nonnil == 0 {
		return cast(Vec[i64], 0)
	}
	let rec = pair(cast(i64, s), s.type_)
	s.type_ = cast(Ty, s.type_).elem
	return cast(Vec[i64], rec)
}

fn narrow_end(rec Vec[Sym]) {
	if cast(i64, rec) != 0 && cast(i64, vec_get(rec, 0)) == 0 {
		narrow_end(cast(Vec[Sym], cast(Vec[i64], vec_get(rec, 2))))
		narrow_end(cast(Vec[Sym], cast(Vec[i64], vec_get(rec, 1))))
	} else if cast(i64, rec) != 0 {
		vec_get(rec, 0).type_ = cast(i64, vec_get(rec, 1))
	}
}

// narrow_kill is where assigning to a narrowed variable would end the narrowing; a
// narrowed x has type T there, so assigning nil to it is already a type error.
fn narrow_kill(target i64) {
}

// ---- keep: deep copies into the long-lived heap ----
shared mut keep_types Vec[i64]
shared mut keep_fns Vec[Fn]

// keep_fn returns (generating on first use) keep$N(x T) T, which copies x and everything
// it references into the core's ingot heap.
fn keep_fn(t Ty) Fn {
	if cast(i64, keep_types) == 0 {
		keep_types = vec_new[i64]()
		keep_fns = cast(Vec[Fn], vec_new[i64]())
	}
	mut i = 0
	for i < keep_types.len {
		if cast(Ty, vec_get(cast(Vec[i64], keep_types), i)) == t {
			return vec_get(keep_fns, i)
		}
		i = i + 1
	}
	if type_cycle(t, cast(Vec[Ty], vec_new[i64]())) != 0 {
		err_code_type(0, cstr("E320 KEEP_TYPE"), cstr("keep cannot copy the recursive type "), cast(i64, t), cstr(""))
	}
	lifted_count = lifted_count + 1
	let pos = 0
	let f = fn_new(pos, cstr("keep"))
	let nb = buf_new()
	buf_str(nb, cstr("keep$"))
	buf_int(nb, lifted_count)
	buf_byte(nb, 0)
	f.qname = nb.data
	f.name = nb.data
	f.lifted = 2
	vec_push(cast(Vec[i64], f.params), cstr("x"))
	vec_push(cast(Vec[i64], f.ptypes), cast(i64, t))
	vec_push(cast(Vec[i64], f.rtypes), cast(i64, t))
	f.type_ = func_of(cast(Vec[i64], f.ptypes), cast(Vec[i64], f.rtypes), 0)
	f.locals = cast(Vec[Sym], vec_new[i64]())
	f.body = empty_block(pos)
	vec_push(cast(Vec[i64], keep_types), cast(i64, t))
	vec_push(keep_fns, cast(Fn, f))
	vec_push(prog_fns, cast(Fn, f))
	let saved_fn = ck_fn
	ck_fn = cast(Fn, f)
	let x = sym_new(SYM_LOCAL, cstr("x"), pos)
	x.type_ = cast(i64, t)
	x.slot = 0
	f.slots = 1
	vec_push(cast(Vec[i64], f.locals), cast(i64, x))
	let body = cast(Block, f.body).stmts
	let k = kind_of(t)
	let ret = cast(ReturnStmt, node_new(ST_RETURN, pos))
	if k == K_DYN {
		ret.value = mk_conv(pos, sym_ref_node(pos, x), CV_DYN_KEEP, cast(i64, t))
	} else if k == K_ERROR {
		// A fault record with its chain (cause, joined faults, trace), identities kept.
		ret.value = rt_call(pos, cstr("rt_keep_fault"), args1(sym_ref_node(pos, x)), cast(i64, t))
	} else if k == K_STRING {
		ret.value = rt_call(pos, cstr("rt_keep_str"), args1(sym_ref_node(pos, x)), cast(i64, t))
	} else if k == K_FUNC {
		// A closure: its descriptor and captured variables, deep (rt_keep_closure, #170).
		ret.value = rt_call(pos, cstr("rt_keep_closure"), args1(sym_ref_node(pos, x)), cast(i64, t))
	} else if k == K_OPT {
		let ifs = cast(IfStmt, node_new(ST_IF, pos))
		ifs.cond = mk_bin(pos, cstr("=="), sym_ref_node(pos, x), mk_int(pos, 0, cast(i64, t)), ty_bool)
		ifs.then = empty_block(pos)
		let r0 = cast(ReturnStmt, node_new(ST_RETURN, pos))
		r0.value = mk_int(pos, 0, cast(i64, t))
		vec_push(cast(Block, ifs.then).stmts, cast(i64, r0))
		vec_push(body, cast(i64, ifs))
		let inner = keep_fn(cast(Ty, t.elem))
		ret.value = keep_call(pos, cast(Fn, inner), sym_ref_node(pos, x), cast(i64, t))
	} else if k == K_SLICE {
		let et = t.elem
		let out = temp(pos, rt_call(pos, cstr("rt_keep_slice"), args2(sym_ref_node(pos, x), mk_int(pos, type_width(cast(Ty, et)), ty_int)), cast(i64, t)), cast(i64, t))
		vec_push(body, cast(i64, out))
		if is_ref(et) != 0 || is_dyn_value(cast(Ty, et)) != 0 {
			keep_each(pos, body, out.sym, et)
		}
		ret.value = sym_ref_node(pos, cast(Sym, out.sym))
	} else if k == K_STRUCT && t.enum_ != 0 {
		// Copy the object, then keep only the active variant's references.
		let out = temp(pos, rt_call(pos, cstr("rt_keep_raw"), args2(sym_ref_node(pos, x), mk_int(pos, t.size, ty_int)), cast(i64, t)), cast(i64, t))
		vec_push(body, cast(i64, out))
		let vs = cast(Vec[i64], t.enum_)
		mut vi = 0
		for vi < vs.len {
			let v = cast(Vec[i64], vec_get(vs, vi))
			let ifs = cast(IfStmt, node_new(ST_IF, pos))
			ifs.cond = mk_bin(pos, cstr("=="), mk_mem(pos, sym_ref_node(pos, cast(Sym, out.sym)), 0, 0, field_offset(t, 0), ty_int), mk_int(pos, vi, ty_int), ty_bool)
			ifs.then = empty_block(pos)
			mut kk = 0
			for kk < vec_get(v, 2) {
				mut fi = vec_get(v, 1) + kk
				let ft = field_type(t, fi)
				if is_ref(ft) != 0 || is_dyn_value(cast(Ty, ft)) != 0 {
					let src = mk_mem(pos, sym_ref_node(pos, cast(Sym, out.sym)), 0, 0, field_offset(t, fi), ft)
					vec_push(cast(Block, ifs.then).stmts, assign_stmt(pos, field_store(pos, sym_ref_node(pos, cast(Sym, out.sym)), cast(i64, t), fi), keep_call(pos, keep_fn(cast(Ty, ft)), src, ft)))
					// The kept copy's slot owns what it holds (#176).
					if rc_counted(cast(Ty, ft)) != 0 {
						vec_push(cast(Block, ifs.then).stmts, expr_stmt(rc_inc_call(pos, mk_mem(pos, sym_ref_node(pos, cast(Sym, out.sym)), 0, 0, field_offset(t, fi), ft))))
					}
				}
				kk = kk + 1
			}
			vec_push(body, cast(i64, ifs))
			vi = vi + 1
		}
		ret.value = sym_ref_node(pos, cast(Sym, out.sym))
	} else if k == K_STRUCT {
		let out = temp(pos, rt_call(pos, cstr("rt_keep_raw"), args2(sym_ref_node(pos, x), mk_int(pos, t.size, ty_int)), cast(i64, t)), cast(i64, t))
		vec_push(body, cast(i64, out))
		mut fi = 0
		for fi < cast(Vec[i64], t.fields).len {
			let ft = field_type(t, fi)
			if is_ref(ft) != 0 || is_dyn_value(cast(Ty, ft)) != 0 {
				let src = mk_mem(pos, sym_ref_node(pos, cast(Sym, out.sym)), 0, 0, field_offset(t, fi), ft)
				vec_push(body, assign_stmt(pos, field_store(pos, sym_ref_node(pos, cast(Sym, out.sym)), cast(i64, t), fi), keep_call(pos, keep_fn(cast(Ty, ft)), src, ft)))
				// The kept copy's slot owns what it holds (#176).
				if rc_counted(cast(Ty, ft)) != 0 {
					vec_push(body, expr_stmt(rc_inc_call(pos, mk_mem(pos, sym_ref_node(pos, cast(Sym, out.sym)), 0, 0, field_offset(t, fi), ft))))
				}
			}
			fi = fi + 1
		}
		ret.value = sym_ref_node(pos, cast(Sym, out.sym))
	} else if k == K_MAP {
		// A new ingot map, filled entry by entry with kept keys and values. Its counted
		// sides carry their drops, so rt_map_set owns the entries' counts itself (#176).
		let out = temp(pos, rt_call(pos, cstr("rt_keep_map_new"), args3(sym_ref_node(pos, x), fn_ref_node(pos, cast(Fn, rc_map_drop(t))), mk_int(pos, rc_map_bits(t), ty_int)), cast(i64, t)), cast(i64, t))
		vec_push(body, cast(i64, out))
		let slots = temp(pos, rt_call(pos, cstr("rt_map_slots"), args1(sym_ref_node(pos, x)), ty_int), ty_int)
		vec_push(body, cast(i64, slots))
		let j = declare_local(pos, cstr("$"), ty_int)
		vec_push(body, let_stmt(pos, cast(Sym, j), mk_int(pos, 0, ty_int)))
		let w = cast(WhileStmt, node_new(ST_WHILE, pos))
		w.cond = mk_bin(pos, cstr("<"), sym_ref_node(pos, cast(Sym, j)), sym_ref_node(pos, cast(Sym, slots.sym)), ty_bool)
		w.post = assign_stmt(pos, sym_ref_node(pos, cast(Sym, j)), mk_bin(pos, cstr("+"), sym_ref_node(pos, cast(Sym, j)), mk_int(pos, 1, ty_int), ty_int))
		let wb = cast(Block, empty_block(pos))
		w.body = cast(i64, wb)
		let live = cast(IfStmt, node_new(ST_IF, pos))
		live.cond = rt_call(pos, cstr("rt_map_live"), args2(sym_ref_node(pos, x), sym_ref_node(pos, cast(Sym, j))), ty_bool)
		live.then = empty_block(pos)
		mut kv = from_bits(cast(Node, rt_call(pos, cstr("rt_map_key"), args2(sym_ref_node(pos, x), sym_ref_node(pos, cast(Sym, j))), ty_int)), t.key)
		mut vv = from_bits(cast(Node, rt_call(pos, cstr("rt_map_val"), args2(sym_ref_node(pos, x), sym_ref_node(pos, cast(Sym, j))), ty_int)), t.elem)
		let kc = key_composite(t.key)
		if kc != 0 {
			// An encoded key: rt_map_setk copies its bytes into the kept map.
			kv = from_bits(cast(Node, rt_call(pos, cstr("rt_map_key"), args2(sym_ref_node(pos, x), sym_ref_node(pos, cast(Sym, j))), ty_int)), ty_string)
		} else if is_ref(t.key) != 0 {
			kv = keep_call(pos, keep_fn(cast(Ty, t.key)), kv, t.key)
		}
		if is_ref(t.elem) != 0 || is_dyn_value(cast(Ty, t.elem)) != 0 {
			vv = keep_call(pos, keep_fn(cast(Ty, t.elem)), vv, t.elem)
		}
		if kc != 0 {
			vec_push(cast(Block, live.then).stmts, expr_stmt(cast(Node, rt_call(pos, cstr("rt_map_setk"), args3(sym_ref_node(pos, cast(Sym, out.sym)), to_bits(cast(Node, kv)), to_bits(cast(Node, vv))), ty_void))))
		} else {
			let setargs = args4(sym_ref_node(pos, cast(Sym, out.sym)), to_bits(cast(Node, kv)), to_bits(cast(Node, vv)), mk_int(pos, 1, ty_int))
			vec_push(cast(Block, live.then).stmts, expr_stmt(cast(Node, rt_call(pos, cstr("rt_map_set"), setargs, ty_void))))
		}
		vec_push(cast(Vec[i64], wb.stmts), cast(i64, live))
		vec_push(body, cast(i64, w))
		ret.value = sym_ref_node(pos, cast(Sym, out.sym))
	} else {
		ret.value = sym_ref_node(pos, x)
	}
	vec_push(body, cast(i64, ret))
	ck_fn = saved_fn
	return cast(Fn, f)
}

fn keep_call(pos i64, f Fn, arg i64, t i64) i64 {
	let c = node_new(EX_CALL, pos)
	cast(Call, c).name = f.qname
	cast(Call, c).args = cast(Vec[i64], args1(arg))
	cast(Call, c).fn_ = cast(i64, f)
	cast(Node, c).type_ = t
	return c
}

// ---- drops: what a kept object's slots own (#176, notes/interface_mem.md) ----
// rc_counted reports whether values of t own long-lived counts: str, slice, map, struct
// (an enum with payloads is one) and opt of those. Func values (code pointers and kept
// closures), faults and dyn objects are not counted yet (known gaps: they leak, never
// corrupt).
fn rc_counted(t Ty) i64 {
	let k = kind_of(t)
	if k == K_STRING || k == K_SLICE || k == K_MAP || k == K_STRUCT {
		return 1
	}
	if k == K_OPT {
		return rc_counted(cast(Ty, t.elem))
	}
	return 0
}

// fn_ref_node is f as a func value argument (the runtime calls it with one word).
fn fn_ref_node(pos i64, f Fn) i64 {
	let n = node_new(EX_FUNCREF, pos)
	cast(FuncRef, n).fn_ = cast(i64, f)
	cast(Node, n).type_ = f.type_
	// A drop can be lifted after the reachability pass (rc_mark), so mark it here.
	if rc_reach_ok != 0 {
		mark_reach(f)
	}
	return n
}

// rc_inc_call emits rt_rc_inc(v).
fn rc_inc_call(pos i64, v i64) Node {
	let c = cast(Call, rt_call(pos, cstr("rt_rc_inc"), args1(v), ty_void))
	if rc_reach_ok != 0 {
		mark_reach(cast(Fn, c.fn_))
	}
	return cast(Node, c)
}

// rc_dec_call emits rt_rc_dec(v, drop).
fn rc_dec_call(pos i64, v i64, drop i64) Node {
	let c = cast(Call, rt_call(pos, cstr("rt_rc_dec"), args2(v, fn_ref_node(pos, cast(Fn, drop))), ty_void))
	if rc_reach_ok != 0 {
		mark_reach(cast(Fn, c.fn_))
	}
	return cast(Node, c)
}

// rc_none is the runtime's own no-op drop: the drop of childless blocks.
fn rc_none() i64 {
	return cast(i64, find_fn(cstr("rt_rc_drop_none")))
}

// rc_map_bits is a map type's counted sides (#176): bit 0 the key side (str keys and
// encoded struct or enum keys), bit 1 the value side.
fn rc_map_bits(t Ty) i64 {
	mut b = 0
	if map_str_keys(t.key) != 0 {
		b = b | 1
	}
	if rc_counted(cast(Ty, t.elem)) != 0 {
		b = b | 2
	}
	return b
}

// rc_map_drop is the value side's drop of a map type (the runtime's no-op when that
// side is not counted).
fn rc_map_drop(t Ty) i64 {
	if rc_counted(cast(Ty, t.elem)) != 0 {
		return drop_fn(t.elem)
	}
	return rc_none()
}

shared mut drop_types Vec[i64]
shared mut drop_fns Vec[i64]
shared mut arrdrop_types Vec[i64]
shared mut arrdrop_fns Vec[i64]

// drop_fn returns (generating on first use) drop$N(x T), the drop of blocks of type T:
// one long-lived count leaves every counted child of x (fields, elements, entries); the
// block itself rt_rc_dec already queued. A str has no children, so the runtime's own
// no-op drop serves and map[str]str lifts no function at all.
fn drop_fn(t i64) i64 {
	if kind_of(cast(Ty, t)) == K_STRING {
		return rc_none()
	}
	if cast(i64, drop_types) == 0 {
		drop_types = vec_new[i64]()
		drop_fns = vec_new[i64]()
	}
	mut i = 0
	for i < drop_types.len {
		if vec_get(cast(Vec[i64], drop_types), i) == t {
			return vec_get(drop_fns, i)
		}
		i = i + 1
	}
	let names = vec_new[i64]()
	vec_push(names, cstr("x"))
	let types = vec_new[i64]()
	vec_push(types, t)
	let f = lifted_fn(cstr("drop"), cast(Vec[i64], names), cast(Vec[i64], types), cast(i64, vec_new[i64]()))
	vec_push(cast(Vec[i64], drop_types), t)
	vec_push(drop_fns, cast(i64, f))
	let saved_fn = ck_fn
	ck_fn = cast(Fn, f)
	let pos = 0
	let x = vec_get(cast(Vec[i64], f.locals), 0)
	rc_drop_body(pos, cast(Block, f.body).stmts, sym_ref_node(pos, cast(Sym, x)), cast(Ty, t))
	ck_fn = saved_fn
	return cast(i64, f)
}

// rc_drop_body appends the releases of x's children to body: what one long-lived
// reference to a value of type t holds.
fn rc_drop_body(pos i64, body Vec[i64], x i64, t Ty) {
	let k = kind_of(t)
	if k == K_SLICE {
		let data = mk_hdr(pos, x, 2)
		vec_push(body, expr_stmt(rc_dec_call(pos, data, arrdrop_fn(t.elem))))
	} else if k == K_MAP {
		let slots = temp(pos, rt_call(pos, cstr("rt_map_slots"), args1(x), ty_int), ty_int)
		vec_push(body, cast(i64, slots))
		let j = declare_local(pos, cstr("$"), ty_int)
		vec_push(body, let_stmt(pos, cast(Sym, j), mk_int(pos, 0, ty_int)))
		let w = cast(WhileStmt, node_new(ST_WHILE, pos))
		w.cond = mk_bin(pos, cstr("<"), sym_ref_node(pos, cast(Sym, j)), sym_ref_node(pos, cast(Sym, slots.sym)), ty_bool)
		w.post = assign_stmt(pos, sym_ref_node(pos, cast(Sym, j)), mk_bin(pos, cstr("+"), sym_ref_node(pos, cast(Sym, j)), mk_int(pos, 1, ty_int), ty_int))
		let wb = cast(Block, empty_block(pos))
		w.body = cast(i64, wb)
		let live = cast(IfStmt, node_new(ST_IF, pos))
		live.cond = rt_call(pos, cstr("rt_map_live"), args2(x, sym_ref_node(pos, cast(Sym, j))), ty_bool)
		live.then = empty_block(pos)
		if (rc_map_bits(t) & 1) != 0 {
			mut kt = t.key
			if key_composite(kt) != 0 {
				kt = ty_string
			}
			vec_push(cast(Block, live.then).stmts, expr_stmt(rc_dec_call(pos, from_bits(cast(Node, rt_call(pos, cstr("rt_map_key"), args2(x, sym_ref_node(pos, cast(Sym, j))), ty_int)), kt), rc_none())))
		}
		if rc_counted(cast(Ty, t.elem)) != 0 {
			vec_push(cast(Block, live.then).stmts, expr_stmt(rc_dec_call(pos, from_bits(cast(Node, rt_call(pos, cstr("rt_map_val"), args2(x, sym_ref_node(pos, cast(Sym, j))), ty_int)), t.elem), drop_fn(t.elem))))
		}
		vec_push(cast(Vec[i64], wb.stmts), cast(i64, live))
		vec_push(body, cast(i64, w))
		// The map is dead by now (drop runs at release): its tables go with it.
		let rel = cast(Call, rt_call(pos, cstr("rt_map_release"), args1(x), ty_void))
		if rc_reach_ok != 0 {
			mark_reach(cast(Fn, rel.fn_))
		}
		vec_push(body, expr_stmt(cast(Node, rel)))
	} else if k == K_OPT {
		let ifs = cast(IfStmt, node_new(ST_IF, pos))
		ifs.cond = mk_bin(pos, cstr("!="), x, mk_int(pos, 0, cast(i64, t)), ty_bool)
		ifs.then = empty_block(pos)
		vec_push(cast(Block, ifs.then).stmts, expr_stmt(call_fn(pos, cast(Fn, drop_fn(t.elem)), args1(x), ty_void)))
		vec_push(body, cast(i64, ifs))
	} else if k == K_STRUCT && t.enum_ != 0 {
		let vs = cast(Vec[i64], t.enum_)
		mut vi = 0
		for vi < vs.len {
			let v = cast(Vec[i64], vec_get(vs, vi))
			let ifs = cast(IfStmt, node_new(ST_IF, pos))
			ifs.cond = mk_bin(pos, cstr("=="), mk_mem(pos, x, 0, 0, field_offset(t, 0), ty_int), mk_int(pos, vi, ty_int), ty_bool)
			ifs.then = empty_block(pos)
			mut kk = 0
			for kk < vec_get(v, 2) {
				mut fi = vec_get(v, 1) + kk
				let ft = field_type(t, fi)
				if rc_counted(cast(Ty, ft)) != 0 {
					vec_push(cast(Block, ifs.then).stmts, expr_stmt(rc_dec_call(pos, mk_mem(pos, x, 0, 0, field_offset(t, fi), ft), drop_fn(ft))))
				}
				kk = kk + 1
			}
			vec_push(body, cast(i64, ifs))
			vi = vi + 1
		}
	} else if k == K_STRUCT {
		mut fi = 0
		for fi < cast(Vec[i64], t.fields).len {
			let ft = field_type(t, fi)
			if rc_counted(cast(Ty, ft)) != 0 {
				vec_push(body, expr_stmt(rc_dec_call(pos, mk_mem(pos, x, 0, 0, field_offset(t, fi), ft), drop_fn(ft))))
			}
			fi = fi + 1
		}
	}
}

// arrdrop_fn returns (generating on first use) arrdrop$N(p i64), the drop of a slice
// backing array of element type T: each element block loses its slot's count. Elements
// of an uncounted type never had one: the no-op drop serves.
fn arrdrop_fn(et i64) i64 {
	if rc_counted(cast(Ty, et)) == 0 {
		return rc_none()
	}
	if cast(i64, arrdrop_types) == 0 {
		arrdrop_types = vec_new[i64]()
		arrdrop_fns = vec_new[i64]()
	}
	mut i = 0
	for i < arrdrop_types.len {
		if vec_get(cast(Vec[i64], arrdrop_types), i) == et {
			return vec_get(arrdrop_fns, i)
		}
		i = i + 1
	}
	let names = vec_new[i64]()
	vec_push(names, cstr("p"))
	let types = vec_new[i64]()
	vec_push(types, ty_int)
	let f = lifted_fn(cstr("arrdrop"), cast(Vec[i64], names), cast(Vec[i64], types), cast(i64, vec_new[i64]()))
	vec_push(cast(Vec[i64], arrdrop_types), et)
	vec_push(arrdrop_fns, cast(i64, f))
	let saved_fn = ck_fn
	ck_fn = cast(Fn, f)
	let pos = 0
	let p = vec_get(cast(Vec[i64], f.locals), 0)
	let body = cast(Block, f.body).stmts
	let n = temp(pos, rt_call(pos, cstr("rt_rc_arr_n"), args2(sym_ref_node(pos, cast(Sym, p)), mk_int(pos, type_width(cast(Ty, et)), ty_int)), ty_int), ty_int)
	vec_push(body, cast(i64, n))
	let j = declare_local(pos, cstr("$"), ty_int)
	vec_push(body, let_stmt(pos, cast(Sym, j), mk_int(pos, 0, ty_int)))
	let w = cast(WhileStmt, node_new(ST_WHILE, pos))
	w.cond = mk_bin(pos, cstr("<"), sym_ref_node(pos, cast(Sym, j)), sym_ref_node(pos, cast(Sym, n.sym)), ty_bool)
	w.post = assign_stmt(pos, sym_ref_node(pos, cast(Sym, j)), mk_bin(pos, cstr("+"), sym_ref_node(pos, cast(Sym, j)), mk_int(pos, 1, ty_int), ty_int))
	let wb = cast(Block, empty_block(pos))
	w.body = cast(i64, wb)
	let cell = mk_mem(pos, sym_ref_node(pos, cast(Sym, p)), sym_ref_node(pos, cast(Sym, j)), type_width(cast(Ty, et)), 0, et)
	vec_push(cast(Vec[i64], wb.stmts), expr_stmt(rc_dec_call(pos, cell, drop_fn(et))))
	vec_push(body, cast(i64, w))
	ck_fn = saved_fn
	return cast(i64, f)
}

// keep_each replaces every element of the (already copied) ingot slice out by a kept copy
// whose slot owns it (#176).
fn keep_each(pos i64, body Vec[i64], out i64, et i64) {
	let n = temp(pos, mk_hdr(pos, sym_ref_node(pos, cast(Sym, out)), 0), ty_int)
	vec_push(body, cast(i64, n))
	let data = temp(pos, mk_hdr(pos, sym_ref_node(pos, cast(Sym, out)), 2), ty_int)
	vec_push(body, cast(i64, data))
	let j = declare_local(pos, cstr("$"), ty_int)
	vec_push(body, let_stmt(pos, cast(Sym, j), mk_int(pos, 0, ty_int)))
	let w = cast(WhileStmt, node_new(ST_WHILE, pos))
	w.cond = mk_bin(pos, cstr("<"), sym_ref_node(pos, cast(Sym, j)), sym_ref_node(pos, cast(Sym, n.sym)), ty_bool)
	w.post = assign_stmt(pos, sym_ref_node(pos, cast(Sym, j)), mk_bin(pos, cstr("+"), sym_ref_node(pos, cast(Sym, j)), mk_int(pos, 1, ty_int), ty_int))
	let wb = cast(Block, empty_block(pos))
	let cell = mk_mem(pos, sym_ref_node(pos, cast(Sym, data.sym)), sym_ref_node(pos, cast(Sym, j)), type_width(cast(Ty, et)), 0, et)
	let cell2 = mk_mem(pos, sym_ref_node(pos, cast(Sym, data.sym)), sym_ref_node(pos, cast(Sym, j)), type_width(cast(Ty, et)), 0, et)
	vec_push(cast(Vec[i64], wb.stmts), assign_stmt(pos, cell, keep_call(pos, keep_fn(cast(Ty, et)), cell2, et)))
	if rc_counted(cast(Ty, et)) != 0 {
		let cell3 = mk_mem(pos, sym_ref_node(pos, cast(Sym, data.sym)), sym_ref_node(pos, cast(Sym, j)), type_width(cast(Ty, et)), 0, et)
		vec_push(cast(Vec[i64], wb.stmts), expr_stmt(rc_inc_call(pos, cell3)))
	}
	w.body = cast(i64, wb)
	vec_push(body, cast(i64, w))
}

// ---- arena results: deep copies into the parent pool (#236, notes/interface_arena.md) ----
shared mut acopy_types Vec[i64]
shared mut acopy_fns Vec[Fn]

// arena_copyable reports whether a value of type t can be copied out of an arena: func and
// dyn values cannot (their objects are not described by their type).
fn arena_copyable(t Ty, seen Vec[i64]) i64 {
	let k = kind_of(t)
	if k == K_FUNC || k == K_DYN {
		return 0
	}
	if k != K_STRUCT && k != K_SLICE && k != K_MAP && k != K_OPT {
		return 1
	}
	if vec_index(seen, cast(i64, t)) >= 0 {
		return 1
	}
	vec_push(seen, cast(i64, t))
	if k == K_STRUCT {
		mut fi = 0
		for fi < cast(Vec[i64], t.fields).len {
			if arena_copyable(cast(Ty, field_type(t, fi)), seen) == 0 {
				return 0
			}
			fi = fi + 1
		}
		return 1
	}
	if k == K_MAP && arena_copyable(cast(Ty, t.key), seen) == 0 {
		return 0
	}
	return arena_copyable(cast(Ty, t.elem), seen)
}

// arenacopy_fn returns (generating on first use) arenacopy$N(x T) T, which copies x and
// everything it references into the current pool, as keep$N does into the ingot heap.
fn arenacopy_fn(t Ty) Fn {
	if cast(i64, acopy_types) == 0 {
		acopy_types = vec_new[i64]()
		acopy_fns = cast(Vec[Fn], vec_new[i64]())
	}
	mut i = 0
	for i < acopy_types.len {
		if cast(Ty, vec_get(cast(Vec[i64], acopy_types), i)) == t {
			return vec_get(acopy_fns, i)
		}
		i = i + 1
	}
	lifted_count = lifted_count + 1
	let pos = 0
	let f = fn_new(pos, cstr("arenacopy"))
	let nb = buf_new()
	buf_str(nb, cstr("arenacopy$"))
	buf_int(nb, lifted_count)
	buf_byte(nb, 0)
	f.qname = nb.data
	f.name = nb.data
	f.lifted = 2
	vec_push(cast(Vec[i64], f.params), cstr("x"))
	vec_push(cast(Vec[i64], f.ptypes), cast(i64, t))
	vec_push(cast(Vec[i64], f.rtypes), cast(i64, t))
	f.type_ = func_of(cast(Vec[i64], f.ptypes), cast(Vec[i64], f.rtypes), 0)
	f.locals = cast(Vec[Sym], vec_new[i64]())
	f.body = empty_block(pos)
	vec_push(cast(Vec[i64], acopy_types), cast(i64, t))
	vec_push(acopy_fns, cast(Fn, f))
	vec_push(prog_fns, cast(Fn, f))
	let saved_fn = ck_fn
	ck_fn = cast(Fn, f)
	let x = sym_new(SYM_LOCAL, cstr("x"), pos)
	x.type_ = cast(i64, t)
	x.slot = 0
	f.slots = 1
	vec_push(cast(Vec[i64], f.locals), cast(i64, x))
	let body = cast(Block, f.body).stmts
	let k = kind_of(t)
	let ret = cast(ReturnStmt, node_new(ST_RETURN, pos))
	if k == K_ERROR {
		ret.value = rt_call(pos, cstr("rt_arena_fault"), args1(sym_ref_node(pos, x)), cast(i64, t))
	} else if k == K_STRING {
		ret.value = rt_call(pos, cstr("rt_arena_str"), args1(sym_ref_node(pos, x)), cast(i64, t))
	} else if k == K_OPT {
		let ifs = cast(IfStmt, node_new(ST_IF, pos))
		ifs.cond = mk_bin(pos, cstr("=="), sym_ref_node(pos, x), mk_int(pos, 0, cast(i64, t)), ty_bool)
		ifs.then = empty_block(pos)
		let r0 = cast(ReturnStmt, node_new(ST_RETURN, pos))
		r0.value = mk_int(pos, 0, cast(i64, t))
		vec_push(cast(Block, ifs.then).stmts, cast(i64, r0))
		vec_push(body, cast(i64, ifs))
		ret.value = keep_call(pos, arenacopy_fn(cast(Ty, t.elem)), sym_ref_node(pos, x), cast(i64, t))
	} else if k == K_SLICE {
		let et = t.elem
		let out = temp(pos, rt_call(pos, cstr("rt_arena_slice"), args2(sym_ref_node(pos, x), mk_int(pos, type_width(cast(Ty, et)), ty_int)), cast(i64, t)), cast(i64, t))
		vec_push(body, cast(i64, out))
		if is_ref(et) != 0 {
			let n = temp(pos, mk_hdr(pos, sym_ref_node(pos, cast(Sym, out.sym)), 0), ty_int)
			vec_push(body, cast(i64, n))
			let data = temp(pos, mk_hdr(pos, sym_ref_node(pos, cast(Sym, out.sym)), 2), ty_int)
			vec_push(body, cast(i64, data))
			let j = declare_local(pos, cstr("$"), ty_int)
			vec_push(body, let_stmt(pos, cast(Sym, j), mk_int(pos, 0, ty_int)))
			let w = cast(WhileStmt, node_new(ST_WHILE, pos))
			w.cond = mk_bin(pos, cstr("<"), sym_ref_node(pos, cast(Sym, j)), sym_ref_node(pos, cast(Sym, n.sym)), ty_bool)
			w.post = assign_stmt(pos, sym_ref_node(pos, cast(Sym, j)), mk_bin(pos, cstr("+"), sym_ref_node(pos, cast(Sym, j)), mk_int(pos, 1, ty_int), ty_int))
			let wb = cast(Block, empty_block(pos))
			let cell = mk_mem(pos, sym_ref_node(pos, cast(Sym, data.sym)), sym_ref_node(pos, cast(Sym, j)), type_width(cast(Ty, et)), 0, et)
			let cell2 = mk_mem(pos, sym_ref_node(pos, cast(Sym, data.sym)), sym_ref_node(pos, cast(Sym, j)), type_width(cast(Ty, et)), 0, et)
			vec_push(cast(Vec[i64], wb.stmts), assign_stmt(pos, cell, keep_call(pos, arenacopy_fn(cast(Ty, et)), cell2, et)))
			w.body = cast(i64, wb)
			vec_push(body, cast(i64, w))
		}
		ret.value = sym_ref_node(pos, cast(Sym, out.sym))
	} else if k == K_STRUCT && t.enum_ != 0 {
		let out = temp(pos, rt_call(pos, cstr("rt_arena_raw"), args2(sym_ref_node(pos, x), mk_int(pos, t.size, ty_int)), cast(i64, t)), cast(i64, t))
		vec_push(body, cast(i64, out))
		let vs = cast(Vec[i64], t.enum_)
		mut vi = 0
		for vi < vs.len {
			let v = cast(Vec[i64], vec_get(vs, vi))
			let ifs = cast(IfStmt, node_new(ST_IF, pos))
			ifs.cond = mk_bin(pos, cstr("=="), mk_mem(pos, sym_ref_node(pos, cast(Sym, out.sym)), 0, 0, field_offset(t, 0), ty_int), mk_int(pos, vi, ty_int), ty_bool)
			ifs.then = empty_block(pos)
			mut kk = 0
			for kk < vec_get(v, 2) {
				mut fi = vec_get(v, 1) + kk
				let ft = field_type(t, fi)
				if is_ref(ft) != 0 {
					let src = mk_mem(pos, sym_ref_node(pos, cast(Sym, out.sym)), 0, 0, field_offset(t, fi), ft)
					vec_push(cast(Block, ifs.then).stmts, assign_stmt(pos, field_store(pos, sym_ref_node(pos, cast(Sym, out.sym)), cast(i64, t), fi), keep_call(pos, arenacopy_fn(cast(Ty, ft)), src, ft)))
				}
				kk = kk + 1
			}
			vec_push(body, cast(i64, ifs))
			vi = vi + 1
		}
		ret.value = sym_ref_node(pos, cast(Sym, out.sym))
	} else if k == K_STRUCT {
		let out = temp(pos, rt_call(pos, cstr("rt_arena_raw"), args2(sym_ref_node(pos, x), mk_int(pos, t.size, ty_int)), cast(i64, t)), cast(i64, t))
		vec_push(body, cast(i64, out))
		mut fi = 0
		for fi < cast(Vec[i64], t.fields).len {
			let ft = field_type(t, fi)
			if is_ref(ft) != 0 {
				let src = mk_mem(pos, sym_ref_node(pos, cast(Sym, out.sym)), 0, 0, field_offset(t, fi), ft)
				vec_push(body, assign_stmt(pos, field_store(pos, sym_ref_node(pos, cast(Sym, out.sym)), cast(i64, t), fi), keep_call(pos, arenacopy_fn(cast(Ty, ft)), src, ft)))
			}
			fi = fi + 1
		}
		ret.value = sym_ref_node(pos, cast(Sym, out.sym))
	} else if k == K_MAP {
		// A new pool map, filled entry by entry with copied keys and values.
		let out = temp(pos, rt_call(pos, cstr("rt_arena_map_new"), args1(sym_ref_node(pos, x)), cast(i64, t)), cast(i64, t))
		vec_push(body, cast(i64, out))
		let slots = temp(pos, rt_call(pos, cstr("rt_map_slots"), args1(sym_ref_node(pos, x)), ty_int), ty_int)
		vec_push(body, cast(i64, slots))
		let j = declare_local(pos, cstr("$"), ty_int)
		vec_push(body, let_stmt(pos, cast(Sym, j), mk_int(pos, 0, ty_int)))
		let w = cast(WhileStmt, node_new(ST_WHILE, pos))
		w.cond = mk_bin(pos, cstr("<"), sym_ref_node(pos, cast(Sym, j)), sym_ref_node(pos, cast(Sym, slots.sym)), ty_bool)
		w.post = assign_stmt(pos, sym_ref_node(pos, cast(Sym, j)), mk_bin(pos, cstr("+"), sym_ref_node(pos, cast(Sym, j)), mk_int(pos, 1, ty_int), ty_int))
		let wb = cast(Block, empty_block(pos))
		w.body = cast(i64, wb)
		let live = cast(IfStmt, node_new(ST_IF, pos))
		live.cond = rt_call(pos, cstr("rt_map_live"), args2(sym_ref_node(pos, x), sym_ref_node(pos, cast(Sym, j))), ty_bool)
		live.then = empty_block(pos)
		mut kv = from_bits(cast(Node, rt_call(pos, cstr("rt_map_key"), args2(sym_ref_node(pos, x), sym_ref_node(pos, cast(Sym, j))), ty_int)), t.key)
		mut vv = from_bits(cast(Node, rt_call(pos, cstr("rt_map_val"), args2(sym_ref_node(pos, x), sym_ref_node(pos, cast(Sym, j))), ty_int)), t.elem)
		let kc = key_composite(t.key)
		if kc != 0 {
			// An encoded key: rt_map_setk copies its bytes into the new map.
			kv = from_bits(cast(Node, rt_call(pos, cstr("rt_map_key"), args2(sym_ref_node(pos, x), sym_ref_node(pos, cast(Sym, j))), ty_int)), ty_string)
		} else if is_ref(t.key) != 0 {
			kv = keep_call(pos, arenacopy_fn(cast(Ty, t.key)), kv, t.key)
		}
		if is_ref(t.elem) != 0 {
			vv = keep_call(pos, arenacopy_fn(cast(Ty, t.elem)), vv, t.elem)
		}
		mut setname = cstr("rt_map_set")
		if kc != 0 {
			setname = cstr("rt_map_setk")
		}
		vec_push(cast(Block, live.then).stmts, expr_stmt(cast(Node, rt_call(pos, setname, args3(sym_ref_node(pos, cast(Sym, out.sym)), to_bits(cast(Node, kv)), to_bits(cast(Node, vv))), ty_void))))
		vec_push(cast(Vec[i64], wb.stmts), cast(i64, live))
		vec_push(body, cast(i64, w))
		ret.value = sym_ref_node(pos, cast(Sym, out.sym))
	} else {
		ret.value = sym_ref_node(pos, x)
	}
	vec_push(body, cast(i64, ret))
	ck_fn = saved_fn
	return cast(Fn, f)
}

// type_cycle reports whether t can reach itself through references (keep would not end).
fn type_cycle(t Ty, path Vec[Ty]) i64 {
	let k = kind_of(t)
	if k != K_STRUCT && k != K_SLICE && k != K_MAP && k != K_OPT {
		return 0
	}
	mut i = 0
	for i < path.len {
		if vec_get(path, i) == t {
			// Enum values are built bottom-up and never change, so a cycle made only of
			// enums (a tree) cannot loop; one through a struct, slice or map can.
			mut j = i
			for j < path.len {
				let pj = vec_get(path, j)
				if !(kind_of(pj) == K_STRUCT && pj.enum_ != 0) {
					return 1
				}
				j = j + 1
			}
			return 0
		}
		i = i + 1
	}
	vec_push(path, cast(Ty, t))
	mut found = 0
	if k == K_STRUCT {
		mut fi = 0
		for fi < cast(Vec[i64], t.fields).len && found == 0 {
			found = type_cycle(cast(Ty, field_type(t, fi)), path)
			fi = fi + 1
		}
	} else if k == K_MAP {
		found = i64(type_cycle(cast(Ty, t.key), path) != 0 || type_cycle(cast(Ty, t.elem), path) != 0)
	} else {
		found = type_cycle(cast(Ty, t.elem), path)
	}
	path.len = path.len - 1
	return found
}
