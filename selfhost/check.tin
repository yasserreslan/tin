// Checker: resolves names across packages, infers and checks types, evaluates constants,
// and lowers Go-level constructs (strings, slices, maps, structs, range, switch,
// multiple assignment, fmt) into the core AST that the optimizer and backend handle.
const SYM_LOCAL = 0
const SYM_GLOBAL = 1
const SYM_CONST = 2
const SYM_FUNC = 3

// Symbol layout.
const S_KIND = 0
const S_NAME = 1
const S_POS = 2
const S_SLOT = 3
const S_VAL = 4
const S_DONE = 5
const S_FN = 6
const S_INDEX = 7 // global var: index in prog_vars
const S_REG = 8 // local home: register, REG_SLOT or REG_DEAD (set by codegen)
const S_OFF = 9 // local home: frame offset when in a slot
const S_USES = 10 // loop-weighted use count (set by analysis)
const S_ADDR = 11 // address taken with &
const S_TYPE = 12
const S_DECL = 13 // const: its declaration
const S_EXPR = 14 // non-integer const: its checked value expression
const S_READS = 15 // times the variable is read (faults must be read)
const S_SAFE = 16 // index proven within this slice's bounds (range/loop proofs)
const S_MUT = 17 // mut parameter
const S_REGION = 18
const S_TLS = 19 // per-core global: slot + 1 in the core's context block
const S_BIG = 20 // integer constant above 2^63-1 (its bits look negative)
const S_UNINIT = 21 // global: its startup initializer has not run yet (check_init_order)
const S_CAPTURED = 22 // captured variable proxy symbol inside closure
const S_CAP_IDX = 23 // capture index in enclosing closure's capture list
const S_CELL = 24 // symbol needs a heap cell (allocated via rt_alloc)
const S_CELL_SYM = 25 // local symbol holding the cell address pointer
const S_WORDS = 26 // multi-word local slot allocation size (default 1)
const S_CAPBITS = 27 // region bits frame-local closures stored into this captured local (region pass)
const S_CELL_OF = 28 // a $cell_ local: the variable whose cell it holds
const S_KEPT_CAP = 29 // captured by a closure that may be kept (its cell's contents are unknown)
const S_SCOPE_AT = 30 // how many scope blocks enclose its declaration (#232): task handles stay inside theirs

const MAX_PARAMS = 8

shared mut globals i64
shared mut sc_syms i64
shared mut sc_marks i64
shared mut ck_fn i64
shared mut ck_loops i64
shared mut ck_breaks i64 // loops plus switches
shared mut ck_file i64
shared mut ck_pkg i64
shared mut ck_legacy i64
shared mut init_stmts i64 // global initializers run by __start
shared mut lifted_count i64
shared mut any_v2 i64
shared mut start_fn i64
shared mut core_fn i64 // __core_init: per-core global initializers, run on every core
shared mut core_stmts i64
shared mut tls_count i64
shared mut ck_trusted i64 // the file is part of the standard library
shared mut file_trusted i64
shared mut safe_pairs i64 // [index sym, slice sym] proven in range in the current loop body
shared mut len_aliases i64 // [local length sym, slice/string sym] for unchanged len locals
shared mut dyn_tables i64 // [concrete type, dyn type, keep function, methods, data slot index]
shared mut ck_escaping_cells i64 // variable names that must be allocated in heap cells

fn sym_new(kind i64, name i64, pos i64) i64 {
	let s = calloc(31, 8)
	s[S_KIND] = kind
	s[S_NAME] = name
	s[S_POS] = pos
	return s
}

fn intrinsic_arity(name i64) i64 {
	if streq(name, cstr("load8")) != 0 || streq(name, cstr("__set_ctx")) != 0 || streq(name, cstr("__atomic_load")) != 0 {
		return 1
	}
	if streq(name, cstr("store8")) != 0 || streq(name, cstr("__atomic_add")) != 0 || streq(name, cstr("__atomic_swap")) != 0 || streq(name, cstr("__atomic_store")) != 0 {
		return 2
	}
	if streq(name, cstr("__atomic_cas")) != 0 || streq(name, cstr("__st")) != 0 {
		return 3
	}
	if streq(name, cstr("__ld")) != 0 {
		return 2
	}
	if streq(name, cstr("__ctx")) != 0 || streq(name, cstr("__yield")) != 0 || streq(name, cstr("__empty")) != 0 || streq(name, cstr("__fp")) != 0 || streq(name, cstr("__tin_symbols")) != 0 || streq(name, cstr("__image_base")) != 0 {
		return 0
	}
	return -1
}

// err_code_type and err_code_types report a coded error naming one or two types (docs/ERRORS.md).
fn err_code_type(pos i64, code i64, prefix i64, t i64, suffix i64) {
	let e = err_code(pos, code)
	buf_str(e, prefix)
	type_name(e, t)
	buf_str(e, suffix)
	err_end(e)
}

fn err_code_types(pos i64, code i64, prefix i64, a i64, mid i64, b i64) {
	let e = err_code(pos, code)
	buf_str(e, prefix)
	type_name(e, a)
	buf_str(e, mid)
	type_name(e, b)
	err_end(e)
}

fn str_cat3(a i64, b i64, c i64) i64 {
	let s = buf_new()
	buf_str(s, a)
	buf_str(s, b)
	buf_str(s, c)
	buf_byte(s, 0)
	return s[VEC_DATA]
}

// qual is the symbol name of a top-level name declared in package pkg.
fn qual(pkg i64, name i64) i64 {
	if i64(load8(pkg)) == 0 {
		return name
	}
	return str_cat3(pkg, cstr("."), name)
}

fn lookup_global(name i64) i64 {
	mut i = 0
	for i < globals[VEC_LEN] {
		let s = vec_get(globals, i)
		if streq(s[S_NAME], name) != 0 {
			return s
		}
		i = i + 1
	}
	return 0
}

fn find_fn(name i64) i64 {
	let s = lookup_global(name)
	if s != 0 && s[S_KIND] == SYM_FUNC {
		return s[S_FN]
	}
	return 0
}

fn declare_global(s i64) {
	if intrinsic_arity(s[S_NAME]) >= 0 {
		err_code_quoted(s[S_POS], cstr("E102 BUILTIN_NAME"), cstr(""), s[S_NAME], cstr(" is a builtin and cannot be redeclared"))
		return
	}
	let prev = lookup_global(s[S_NAME])
	if prev != 0 {
		let e = err_code(s[S_POS], cstr("E101 REDECLARED"))
		buf_byte(e, '\'')
		buf_str(e, s[S_NAME])
		buf_str(e, cstr("' redeclared (previous declaration at "))
		buf_pos(e, prev[S_POS])
		buf_byte(e, ')')
		err_end(e)
		return
	}
	vec_push(globals, s)
}

fn set_file(f i64) {
	ck_file = f
	ck_pkg = vec_get(file_pkgs, f)
	ck_trusted = vec_get(file_trusted, f)
}

// import_pkg returns the package name an alias in the current file refers to, or 0.
fn import_pkg(alias i64) i64 {
	let imps = vec_get(file_imports, ck_file)
	mut i = 0
	for i < imps[VEC_LEN] {
		let rec = vec_get(imps, i)
		if streq(vec_get(rec, 0), alias) != 0 {
			return path_pkg(vec_get(rec, 1))
		}
		i = i + 1
	}
	return 0
}

// path_pkg is the package an import path names: its last element.
fn path_pkg(path i64) i64 {
	mut name = path
	mut j = 0
	for i64(load8(path + j)) != 0 {
		if i64(load8(path + j)) == '/' {
			name = path + j + 1
		}
		j = j + 1
	}
	return name
}

// ---- types ----
fn resolve_type(tx i64) i64 {
	if tx == 0 {
		return ty_int
	}
	if tx[TY_KIND] < 40 && tx[N_KIND] == 0 {
		return tx
	}
	let k = tx[N_KIND]
	if k == TX_NAME && tx[TX_ARGS] != 0 {
		return generic_type_ref(tx)
	}
	if k == TX_NAME && tx[TX_A] == 0 {
		let bound = tbind_lookup(tx[TX_B])
		if bound != 0 {
			return bound
		}
	}
	if k == TX_NAME {
		mut t = 0
		if tx[TX_A] != 0 {
			let pkg = import_pkg(tx[TX_A])
			if pkg == 0 {
				err_code_quoted(tx[N_POS], cstr("E103 UNDEFINED"), cstr("undefined package "), tx[TX_A], cstr(""))
				return ty_int
			}
			t = find_type(str_cat3(pkg, cstr("."), tx[TX_B]))
			if t != 0 && is_private(tx[TX_B]) != 0 {
				private_use(tx[N_POS], cstr("type"), tx[TX_B], pkg)
			}
		} else {
			if i64(load8(ck_pkg)) != 0 {
				t = find_type(qual(ck_pkg, tx[TX_B]))
			}
			if t == 0 {
				t = find_type(tx[TX_B])
			}
			if t == 0 && vec_get(file_v2, ck_file) == 0 {
				if streq(tx[TX_B], cstr("int")) != 0 {
					t = ty_int
				} else if streq(tx[TX_B], cstr("float")) != 0 {
					t = ty_float
				} else if streq(tx[TX_B], cstr("string")) != 0 {
					t = ty_string
				}
			}
		}
		if t == 0 {
			err_code_quoted(tx[N_POS], cstr("E103 UNDEFINED"), cstr("undefined type "), tx[TX_B], cstr(""))
			return ty_int
		}
		return t
	}
	if (k == TX_SLICE || k == TX_ARRAY || k == TX_MAP) && bounded_elem(tx) != 0 {
		return bounded_type(bounded_elem(tx))
	}
	if k == TX_SLICE || k == TX_ARRAY {
		let et = resolve_type(tx[TX_A + i64((k == TX_ARRAY))])
		if k == TX_ARRAY && kind_of(et) == K_DYN {
			let e = err_code(tx[N_POS], cstr("E203 NO_ZERO_VALUE"))
			buf_str(e, cstr("an array of "))
			type_name(e, et)
			buf_str(e, cstr(" has no zero element: use []dyn and append"))
			err_end(e)
		}
		return slice_of(et)
	}
	if k == TX_MAP {
		let mkt = resolve_type(tx[TX_A])
		secret_map_key(tx[N_POS], mkt)
		if ck_legacy == 0 && key_valid(mkt, vec_new()) == 0 {
			err_code_type(tx[N_POS], cstr("E201 MAP_KEY"), cstr("a map key must compare by value (str, numbers, bool, or structs and enums of those), not "), mkt, cstr(""))
		}
		let mvt = resolve_type(tx[TX_B])
		if is_dyn_value(mvt) != 0 && ck_legacy == 0 {
			err_code_at(tx[N_POS], cstr("E530 DYN_NOT_YET"), cstr("a map value of type dyn is the next step: the map stores 16-byte slots with the table (#141)"))
		}
		return map_of(mkt, mvt)
	}
	if k == TX_PTR {
		return resolve_type(tx[TX_A])
	}
	if k == TX_OPT {
		let inner = resolve_type(tx[TX_A])
		let ik = kind_of(inner)
		if ik != K_STRUCT && ik != K_DYN && ik != K_STRING && ik != K_SLICE && ik != K_MAP {
			err_code_type(tx[N_POS], cstr("E420 OPTIONAL_TYPE"), cstr("only references (str, slices, maps, structs, dyn) can be optional, not "), inner, cstr(""))
			return inner
		}
		return opt_of(inner)
	}
	if k == TX_MAX {
		return bounded_type(tx)
	}
	if k == TX_CHAN {
		return chan_of(resolve_type(tx[TX_A]))
	}
	if k == TX_FUNC {
		return func_of_m(resolve_types(tx[TX_A]), resolve_types(tx[TX_B]), 0, tx[TX_ARGS])
	}
	if k == TX_STRUCT {
		let st = ty_new(K_STRUCT, cstr("struct"))
		resolve_fields(st, tx)
		layout_struct(st)
		return st
	}
	if k == TX_DYN {
		let inst = shape_inst(tx[TX_A])
		if inst == 0 {
			if shape_ref_name(tx[TX_A]) == 0 {
				// Not a shape (an undefined name, a type, a package member): never typed
				// as an ordinary type.
				let e = err_code(tx[TX_A][N_POS], cstr("E522 NOT_A_SHAPE"))
				buf_str(e, cstr("dyn needs a shape"))
				if tx[TX_A][N_KIND] == TX_NAME {
					buf_str(e, cstr(", not "))
					if tx[TX_A][TX_A] != 0 {
						buf_str(e, tx[TX_A][TX_A])
						buf_byte(e, '.')
					}
					buf_str(e, tx[TX_A][TX_B])
				}
				err_end(e)
			}
			return ty_int
		}
		if saw_dyn == 0 {
			saw_dyn_pos = tx[N_POS]
		}
		return dyn_of(vec_get(inst, 0), vec_get(inst, 1))
	}
	if k == TX_SECRET {
		return secret_type(tx)
	}
	err_code_at(tx[N_POS], cstr("E990 INTERNAL"), cstr("invalid type"))
	return ty_int
}

fn resolve_types(v i64) i64 {
	let r = vec_new()
	mut i = 0
	for i < v[VEC_LEN] {
		vec_push(r, resolve_type(vec_get(v, i)))
		i = i + 1
	}
	return r
}

// ---- bounded types (#240) ----
// bounded_type resolves T max N: N is a constant length, T a str, slice or map.
fn bounded_type(tx i64) i64 {
	let t = resolve_type(tx[TX_A])
	let k = kind_of(t)
	if k != K_STRING && k != K_SLICE && k != K_MAP {
		err_code_type(tx[N_POS], cstr("E250 BOUND_TYPE"), cstr("max bounds the length of a str, a slice or a map, not "), t, cstr(""))
		return t
	}
	let x = tx[TX_B]
	if x[N_KIND] == EX_UNIT {
		chk_unit(x, ty_int)
	}
	let n = const_value(x, 0)
	if n < 0 {
		err_code_at(x[N_POS], cstr("E250 BOUND_TYPE"), cstr("a bound must not be negative"))
		return t
	}
	if t[TY_SECRET] != 0 {
		// secret T max n: the bound goes inside, so the value stays secret.
		return secret_of(bounded_of(t[TY_SECRET], n))
	}
	return bounded_of(t, n)
}

// bounded_elem reads []T max n and map[K]V max n, whose max the parser gave the element, as
// the bounded slice or map (design_syntax: Type "max" Expr); 0 when the element has none.
// A slice of bounded values is written with a named element type ([]Name).
fn bounded_elem(tx i64) i64 {
	mut ei = TX_B
	if tx[N_KIND] == TX_SLICE {
		ei = TX_A
	}
	let el = tx[ei]
	if el == 0 || el[N_KIND] != TX_MAX {
		return 0
	}
	let inner = node_new(tx[N_KIND], tx[N_POS])
	replace_node(inner, tx)
	inner[ei] = el[TX_A]
	let outer = node_new(TX_MAX, tx[N_POS])
	outer[TX_A] = inner
	outer[TX_B] = el[TX_B]
	return outer
}

// bounded_value handles a value for a bounded type: a str literal within the bound fits;
// an unbounded value of the same type is reported (reports whether it handled e).
fn bounded_value(e i64, from i64, to i64) i64 {
	if ck_legacy != 0 || to == 0 || to[TY_BOUND] == 0 || (from != 0 && from[TY_BOUND] != 0) {
		return 0
	}
	if e[N_KIND] == EX_STR && kind_of(to) == K_STRING {
		if e[STR_LEN] > to[TY_MAX] {
			let m = err_code(e[N_POS], cstr("E251 UNCHECKED_BOUND"))
			buf_str(m, cstr("this str is "))
			buf_int(m, e[STR_LEN])
			buf_str(m, cstr(" bytes long, over the bound of "))
			type_name(m, to)
			err_end(m)
		}
		return 1
	}
	if assignable(from, to[TY_BOUND]) != 0 {
		let m = err_code(e[N_POS], cstr("E251 UNCHECKED_BOUND"))
		buf_str(m, cstr("cannot use "))
		type_name(m, from)
		buf_str(m, cstr(" as "))
		type_name(m, to)
		buf_str(m, cstr(": its length is unchecked (check it with bound(x), which fails with fault.LimitExceeded)"))
		err_end(m)
		return 1
	}
	return 0
}

shared mut bound_want i64 // the bounded type a bound(x) call being checked must produce

// bound_target is the type the destination of try/catch statement s gives a bound(x) call.
fn bound_target(s i64, call i64, mode i64, declared i64) i64 {
	if call[N_KIND] != EX_CALL || call[CALL_NAME] == 0 || streq(call[CALL_NAME], cstr("bound")) == 0 {
		return 0
	}
	if mode == 1 {
		return declared
	}
	if mode == 4 && ck_fn[F_RTYPES][VEC_LEN] == 2 {
		return vec_get(ck_fn[F_RTYPES], 0)
	}
	if mode == 2 {
		let tg = s[AS_TARGET]
		if tg[N_KIND] == EX_IDENT {
			let sy = lookup_name(tg[ID_NAME])
			if sy != 0 {
				return sy[S_TYPE]
			}
		} else if tg[N_KIND] == EX_SELECT {
			return chk(expr_clone(tg), 0)
		}
	}
	return 0
}

// array_len is N for an [N]T type expression, else 0 ([N]T is a []T that starts with N
// zero elements).
fn array_len(tx i64) i64 {
	if tx == 0 || tx[N_KIND] != TX_ARRAY {
		return 0
	}
	let n = const_value(tx[TX_A], 0)
	if n < 0 {
		err_code_at(tx[N_POS], cstr("E202 ARRAY_TYPE"), cstr("array length must not be negative"))
		return 0
	}
	// [N][M]T: remember M, so every row starts with M zero elements.
	array_inner = array_len(tx[TX_B])
	return n
}

shared mut array_inner i64 // the row length of the last [N][M]T array_len saw

// array_make is the starting value of an [n]T: n zero elements.
fn array_make(pos i64, t i64, n i64) i64 {
	let ek = kind_of(t[TY_ELEM])
	let nn = mk_int(pos, n, ty_int)
	let inner = array_inner
	array_inner = 0
	if ek == K_SLICE && inner > 0 {
		let ik = kind_of(t[TY_ELEM][TY_ELEM])
		if ik == K_STRUCT || ik == K_MAP || ik == K_FUNC || ik == K_SLICE {
			err_code_type(pos, cstr("E202 ARRAY_TYPE"), cstr("an array of "), t[TY_ELEM], cstr(" rows is limited to numbers, bools and strs"))
		}
		let args = vec_new()
		vec_push(args, nn)
		vec_push(args, mk_int(pos, inner, ty_int))
		vec_push(args, mk_int(pos, elem_size(t[TY_ELEM]), ty_int))
		vec_push(args, mk_int(pos, i64(ik == K_STRING), ty_int))
		return rt_call(pos, cstr("rt_slice_make_grid"), args, t)
	}
	if ek == K_STRUCT || ek == K_MAP || ek == K_FUNC {
		err_code_type(pos, cstr("E203 NO_ZERO_VALUE"), cstr("an array of "), t[TY_ELEM], cstr(" would start with nil elements: use a slice and append"))
	}
	if ek == K_STRING {
		return rt_call(pos, cstr("rt_slice_make_str"), args2(nn, mk_int(pos, n, ty_int)), t)
	}
	if ek == K_SLICE {
		return rt_call(pos, cstr("rt_slice_make_nest"), args3(nn, mk_int(pos, n, ty_int), mk_int(pos, elem_size(t[TY_ELEM]), ty_int)), t)
	}
	return rt_call(pos, cstr("rt_slice_make"), args3(nn, mk_int(pos, n, ty_int), mk_int(pos, elem_size(t), ty_int)), t)
}

fn resolve_fields(st i64, tx i64) {
	let fs = vec_new()
	let src = tx[TX_A]
	mut i = 0
	for i < src[VEC_LEN] {
		let f = vec_get(src, i)
		let rec = vec_new()
		vec_push(rec, vec_get(f, 0))
		vec_push(rec, resolve_type(vec_get(f, 1)))
		if vec_get(f, 1)[N_KIND] >= TX_NAME {
			sb_forbid(vec_get(f, 1)[N_POS], vec_get(rec, 1), cstr("a struct or enum field cannot hold "))
		}
		// Slot 2 is the offset (layout_struct); [N]T fields start with N zero elements.
		vec_push(rec, 0)
		vec_push(rec, array_len(vec_get(f, 1)))
		vec_push(rec, array_inner)
		array_inner = 0
		// Field metadata is compile-time only; it never enters the object layout.
		vec_push(rec, vec_get(f, 2))
		vec_push(fs, rec)
		i = i + 1
	}
	st[TY_FIELDS] = fs
	st[TY_ENUM] = tx[TX_B]
}

// ---- declarations ----
fn check() {
	globals = vec_new()
	sc_syms = vec_new()
	sc_marks = vec_new()
	init_stmts = vec_new()
	safe_pairs = vec_new()
	len_aliases = vec_new()
	dyn_tables = vec_new()
	mut i = 0
	for i < file_v2[VEC_LEN] {
		if vec_get(file_v2, i) != 0 {
			any_v2 = 1
		}
		i = i + 1
	}
	generics_init()
	shapes_init()
	// Named types: structs first, so fields and aliases can refer to any of them.
	i = 0
	for i < prog_types[VEC_LEN] {
		let d = vec_get(prog_types, i)
		set_file(d[D_FILE])
		let q = qual(ck_pkg, d[D_NAME])
		if d[D_TPARAMS] != 0 {
		} else if d[D_TYPE][N_KIND] == TX_STRUCT {
			name_type(q, ty_new(K_STRUCT, q))
		}
		i = i + 1
	}
	i = 0
	for i < prog_types[VEC_LEN] {
		let d = vec_get(prog_types, i)
		set_file(d[D_FILE])
		let q = qual(ck_pkg, d[D_NAME])
		if d[D_TPARAMS] != 0 {
		} else if d[D_TYPE][N_KIND] == TX_STRUCT {
			resolve_fields(find_type(q), d[D_TYPE])
			layout_struct(find_type(q))
		} else {
			name_type(q, resolve_type(d[D_TYPE]))
		}
		i = i + 1
	}
	// A type and a shape may not share a name: the two would be ambiguous wherever a
	// name can be either (a constraint) and confusing everywhere else. A generic type's
	// name lives in ty_generics until it is instantiated, so both are checked.
	i = 0
	for i < prog_shapes[VEC_LEN] {
		let sd = vec_get(prog_shapes, i)
		set_file(sd[D_FILE])
		let q = qual(ck_pkg, sd[D_NAME])
		if find_type(q) != 0 || find_generic(q) != 0 {
			err_code_quoted(sd[D_POS], cstr("E101 REDECLARED"), cstr(""), sd[D_NAME], cstr(" is declared as a type and as a shape"))
		}
		i = i + 1
	}
	shapes_declared()
	lifecycle_decls()
	i = 0
	let ndecl = prog_fns[VEC_LEN]
	for i < ndecl {
		let df = vec_get(prog_fns, i)
		if is_template(df) != 0 {
			declare_template(df)
		} else {
			declare_fn(df)
		}
		i = i + 1
	}
	generics_declared()
	i = 0
	for i < prog_consts[VEC_LEN] {
		let c = vec_get(prog_consts, i)
		set_file(c[D_FILE])
		let cs = sym_new(SYM_CONST, qual(ck_pkg, c[D_NAME]), c[D_POS])
		cs[S_DECL] = c
		c[D_SYM] = cs
		declare_global(cs)
		i = i + 1
	}
	i = 0
	for i < prog_vars[VEC_LEN] {
		let v = vec_get(prog_vars, i)
		set_file(v[D_FILE])
		let vs = sym_new(SYM_GLOBAL, qual(ck_pkg, v[D_NAME]), v[D_POS])
		vs[S_INDEX] = i
		vs[S_TYPE] = 0
		if vec_get(file_v2, ck_file) != 0 && v[D_SHARED] == 0 {
			tls_count = tls_count + 1
			vs[S_TLS] = tls_count
		} else if v[D_SHARED] != 0 && vec_get(file_trusted, ck_file) == 0 {
			err_code_at(v[D_POS], cstr("E601 SHARED_GLOBAL"), cstr("shared mutable state across cores is not allowed: globals are per core (use const, or relay messages)"))
		}
		if v[D_TYPE] != 0 {
			vs[S_TYPE] = resolve_type(v[D_TYPE])
		}
		v[D_SYM] = vs
		declare_global(vs)
		i = i + 1
	}
	i = 0
	for i < prog_consts[VEC_LEN] {
		check_const(vec_get(prog_consts, i))
		i = i + 1
	}
	start_fn = fn_new(0, cstr("__start"))
	start_fn[F_LOCALS] = vec_new()
	core_fn = fn_new(0, cstr("__core_init"))
	core_fn[F_LOCALS] = vec_new()
	core_fn[F_QNAME] = cstr("__core_init")
	core_fn[F_LEGACY] = 1
	core_fn[F_TYPE] = func_of(core_fn[F_PTYPES], core_fn[F_RTYPES], 0)
	core_stmts = vec_new()
	let pkgs_done = vec_new()
	i = 0
	for i < file_pkgs[VEC_LEN] {
		check_pkg_vars(vec_get(file_pkgs, i), pkgs_done)
		i = i + 1
	}
	// Function literals are lifted onto prog_fns while bodies are checked.
	i = 0
	for i < prog_fns[VEC_LEN] {
		let fd = vec_get(prog_fns, i)
		if fd[F_DONE] != 0 {
			i = i + 1
			continue
		}
		if fd[F_EXTERN] == 0 && fd[F_LIFTED] != 2 && is_template(fd) == 0 {
			check_fn(fd)
		}
		i = i + 1
	}
	mut m = 0
	if entry_name != 0 {
		m = lookup_global(entry_name)
		let um = lookup_global(cstr("main"))
		if um != 0 && um[S_KIND] == SYM_FUNC && um != m {
			// The program's own main is not the entry: keep its symbol out of the C name.
			um[S_FN][F_QNAME] = cstr("main.main$unused")
		}
		if m == 0 || m[S_KIND] != SYM_FUNC {
			let e0 = err_code(NO_POS, cstr("E120 NO_MAIN"))
			buf_str(e0, cstr("no entry function "))
			buf_str(e0, entry_name)
			err_end(e0)
			return
		}
	} else {
		m = lookup_global(cstr("main"))
	}
	if m == 0 || m[S_KIND] != SYM_FUNC {
		let e = err_code(NO_POS, cstr("E120 NO_MAIN"))
		buf_str(e, cstr("no main function"))
		err_end(e)
		return
	}
	if m[S_FN][F_EXTERN] != 0 {
		let e2 = err_code(m[S_POS], cstr("E121 MAIN_SIGNATURE"))
		buf_str(e2, cstr("main cannot be extern"))
		err_end(e2)
	} else if m[S_FN][F_PARAMS][VEC_LEN] != 0 && m[S_FN][F_PARAMS][VEC_LEN] != 2 {
		let e3 = err_code(m[S_POS], cstr("E121 MAIN_SIGNATURE"))
		buf_str(e3, cstr("main takes no parameters or (argc, argv)"))
		err_end(e3)
	}
	if any_v2 != 0 {
		make_start(m[S_FN])
		mark_reach(start_fn)
		// Bounds-check traps call it from code the backend generates.
		mark_reach(find_fn(cstr("rt_bounds_fail")))
		mark_reach(find_fn(cstr("rt_bounds_fail2")))
		mark_reach(find_fn(cstr("rt_div_fail")))
		if compiler_polls != 0 {
			mark_reach(find_fn(cstr("rt_bnd_poll")))
		}
		check_init_order()
	} else {
		mark_reach(m[S_FN])
	}
}

// declare_template makes a generic function's name callable; instances are declared on use.
fn declare_template(f i64) {
	set_file(f[F_FILE])
	if f[F_RECV] != 0 {
		f[F_QNAME] = str_cat3(qual(ck_pkg, f[F_RECV][TX_B]), cstr("[]."), f[F_NAME])
		return
	}
	let name = qual(ck_pkg, f[F_NAME])
	f[F_QNAME] = name
	let fs = sym_new(SYM_FUNC, name, f[F_POS])
	fs[S_FN] = f
	declare_global(fs)
}

fn declare_fn(f i64) {
	set_file(f[F_FILE])
	ck_legacy = f[F_LEGACY]
	if f[F_EXTERN] != 0 && vec_get(file_v2, ck_file) != 0 && ck_trusted == 0 {
		// Legacy files keep their externs. This one is not declared, so it cannot replace
		// the runtime's C function of the same name.
		err_code_at(f[F_POS], cstr("E801 TRUSTED_ONLY"), cstr("extern is only allowed in the standard library"))
		return
	}
	let np = f[F_PARAMS][VEC_LEN]
	mut ptypes = vec_new()
	mut i = 0
	for i < np {
		if f[F_LEGACY] != 0 {
			vec_push(ptypes, ty_int)
		} else {
			vec_push(ptypes, resolve_type(vec_get(f[F_PTYPES], i)))
		}
		i = i + 1
	}
	let rtypes = resolve_types(f[F_RTYPES])
	mut sbi = 0
	for f[F_GENOF] == 0 && sbi < rtypes[VEC_LEN] {
		// (A generic's instance: its type arguments were checked where it was used.)
		sb_forbid(f[F_POS], vec_get(rtypes, sbi), cstr("a function cannot return "))
		sbi = sbi + 1
	}
	if ck_legacy == 0 && f[F_EXTERN] == 0 && f[F_BANG] != 0 {
		mut ri = 0
		for ri < rtypes[VEC_LEN] {
			if kind_of(vec_get(rtypes, ri)) == K_DYN {
				err_code_at(f[F_POS], cstr("E530 DYN_NOT_YET"), cstr("a !dyn result is the next step: fail would need the zero pair (#141)"))
			}
			ri = ri + 1
		}
	}
	if ck_legacy == 0 && f[F_EXTERN] == 0 && f[F_BANG] == 0 && rtypes[VEC_LEN] > 0 && kind_of(vec_get(rtypes, rtypes[VEC_LEN] - 1)) == K_ERROR {
		err_code_at(f[F_POS], cstr("E402 FAULT_RESULT"), cstr("write a result that can fail as !T (or ! when there is no value), not with a fault result"))
	}
	mut name = qual(ck_pkg, f[F_NAME])
	if f[F_EXTERN] != 0 {
		// C symbols are global: every package's extern of the same name is one function.
		name = f[F_NAME]
	}
	if f[F_RECV] != 0 {
		let rt = resolve_type(f[F_RECV])
		if kind_of(rt) != K_STRUCT {
			err_code_type(f[F_POS], cstr("E140 RECEIVER"), cstr("methods need a struct receiver, not "), rt, cstr(""))
		}
		name = str_cat3(rt[TY_NAME], cstr("."), f[F_NAME])
		// The receiver is passed as parameter zero.
		let params = vec_new()
		vec_push(params, f[F_RECVNAME])
		let pt = vec_new()
		vec_push(pt, rt)
		let muts = vec_new()
		vec_push(muts, f[F_RECVMUT])
		i = 0
		for i < np {
			vec_push(params, vec_get(f[F_PARAMS], i))
			vec_push(pt, vec_get(ptypes, i))
			vec_push(muts, vec_get(f[F_MUTS], i))
			i = i + 1
		}
		f[F_PARAMS] = params
		f[F_MUTS] = muts
		ptypes = pt
	}
	f[F_PTYPES] = ptypes
	f[F_RTYPES] = rtypes
	f[F_QNAME] = name
	f[F_TYPE] = func_of_m(ptypes, rtypes, f[F_VARIADIC], mut_mask(f[F_MUTS]))
	mut ints = 0
	mut floats = 0
	i = 0
	for i < ptypes[VEC_LEN] {
		if is_float_t(vec_get(ptypes, i)) != 0 {
			floats = floats + 1
		} else {
			ints = ints + 1
		}
		i = i + 1
	}
	if ints > MAX_PARAMS || floats > MAX_PARAMS {
		let e = err_code(f[F_POS], cstr("E907 TOO_MANY_PARAMS"))
		buf_str(e, cstr("function '"))
		buf_str(e, f[F_NAME])
		buf_str(e, cstr("' has "))
		buf_int(e, ptypes[VEC_LEN])
		buf_str(e, cstr(" parameters, the limit is 8"))
		err_end(e)
	}
	if rtypes[VEC_LEN] > 8 {
		err_code_at(f[F_POS], cstr("E907 TOO_MANY_PARAMS"), cstr("too many results"))
	}
	if f[F_LIFTED] != 0 {
		return
	}
	let prev = lookup_global(name)
	if f[F_EXTERN] != 0 && prev != 0 && prev[S_KIND] == SYM_FUNC && prev[S_FN][F_EXTERN] != 0 {
		return
	}
	let fs = sym_new(SYM_FUNC, name, f[F_POS])
	fs[S_FN] = f
	declare_global(fs)
}

fn check_const(c i64) {
	set_file(c[D_FILE])
	ck_legacy = i64(vec_get(file_v2, ck_file) == 0)
	ck_fn = 0
	check_const_value(c)
}

// Evaluate in the caller's lexical scope; local declarations keep the current function.
fn check_const_value(c i64) {
	let s = c[D_SYM]
	if s[S_DECL] != c {
		return
	}
	mut want = 0
	if c[D_TYPE] != 0 {
		want = resolve_type(c[D_TYPE])
	}
	let init = c[D_INIT]
	if is_int_const_expr(init) != 0 {
		let v = const_value(init, c[D_IOTA])
		s[S_BIG] = cv_big
		s[S_VAL] = v
		s[S_TYPE] = ty_uint
		if want != 0 {
			if is_integer_t(want) == 0 && is_float_t(want) == 0 {
				err_code_type(c[D_POS], cstr("E221 CONST_TYPE"), cstr("cannot use an integer constant as "), want, cstr(""))
			}
			s[S_TYPE] = want
			if ck_legacy == 0 && is_integer_t(want) != 0 {
				let value = mk_int(c[D_POS], v, 0)
				value[8] = s[S_BIG]
				adapt_int(value, want)
			}
		}
		if ck_legacy != 0 {
			s[S_TYPE] = ty_int
		}
	} else {
		if ck_legacy != 0 {
			err_code_at(init[N_POS], cstr("E220 NOT_CONSTANT"), cstr("expression is not a constant"))
		}
		let copy_ = expr_clone(init)
		let t = chk(copy_, want)
		if want != 0 {
			check_assignable(copy_, t, want)
		}
		if is_const_value(copy_) == 0 {
			err_code_at(init[N_POS], cstr("E220 NOT_CONSTANT"), cstr("expression is not a constant"))
		}
		s[S_EXPR] = copy_
		s[S_TYPE] = t
	}
	s[S_DONE] = 1
}

// is_const_value accepts the checked forms a non-integer constant may take.
fn is_const_value(e i64) i64 {
	let k = e[N_KIND]
	return i64(k == EX_FLOAT || k == EX_STR || k == EX_INT || (k == EX_UNARY && is_const_value(e[UN_X]) != 0))
}

// is_int_const_expr reports whether e is built only from integer literals and constants.
fn is_int_const_expr(e i64) i64 {
	let k = e[N_KIND]
	if k == EX_INT {
		return 1
	}
	if k == EX_IDENT {
		if streq(e[ID_NAME], cstr("iota")) != 0 {
			return 1
		}
		let s = lookup_name(e[ID_NAME])
		if s != 0 && s[S_KIND] == SYM_CONST {
			let d = s[S_DECL]
			return i64(s[S_DONE] == 0 || s[S_EXPR] == 0)
		}
		return 0
	}
	if k == EX_UNARY {
		return i64(streq(e[UN_OP], cstr("&")) == 0 && is_int_const_expr(e[UN_X]) != 0)
	}
	if k == EX_BINARY {
		return i64(is_int_const_expr(e[BIN_L]) != 0 && is_int_const_expr(e[BIN_R]) != 0)
	}
	return 0
}

// const_value evaluates an integer constant expression; iota is the group position.
shared mut cv_big i64 // the last const_value result is an unsigned value above 2^63-1

// eval_unsigned is >>, / or % on 64-bit patterns read as unsigned.
fn eval_unsigned(op i64, a i64, b i64) i64 {
	if streq(op, cstr(">>")) != 0 {
		if b <= 0 {
			return a
		}
		if b >= 64 {
			return 0
		}
		return (a >> b) & ((1 << (64 - b)) - 1)
	}
	mut q = 0
	if b < 0 {
		// A divisor of 2^63 or more goes into a at most once.
		if (a ^ (1 << 63)) >= (b ^ (1 << 63)) {
			q = 1
		}
	} else if a >= 0 {
		q = a / b
	} else {
		q = (((a >> 1) & 0x7fffffffffffffff) / b) << 1
		let rem = a - q * b
		if (rem ^ (1 << 63)) >= (b ^ (1 << 63)) {
			q = q + 1
		}
	}
	if streq(op, cstr("/")) != 0 {
		return q
	}
	return a - q * b
}

fn const_value(e i64, iota i64) i64 {
	let v = const_value_b(e, iota)
	return v
}

fn const_value_b(e i64, iota i64) i64 {
	let k = e[N_KIND]
	cv_big = 0
	if k == EX_INT {
		cv_big = e[8]
		return e[INT_VAL]
	}
	if k == EX_IDENT {
		if streq(e[ID_NAME], cstr("iota")) != 0 {
			return iota
		}
		let s = lookup_name(e[ID_NAME])
		if s == 0 || s[S_KIND] != SYM_CONST {
			err_code_quoted(e[N_POS], cstr("E220 NOT_CONSTANT"), cstr(""), e[ID_NAME], cstr(" is not a constant"))
			return 0
		}
		if s[S_DONE] == 0 {
			err_code_quoted(e[N_POS], cstr("E130 INIT_ORDER"), cstr("constant "), e[ID_NAME], cstr(" used before its definition"))
			return 0
		}
		e[ID_REF] = s
		cv_big = s[S_BIG]
		return s[S_VAL]
	}
	if k == EX_UNARY && streq(e[UN_OP], cstr("&")) == 0 {
		let uv = eval_unary(e[UN_OP], const_value_b(e[UN_X], iota))
		cv_big = i64(cv_big != 0 && uv < 0 && streq(e[UN_OP], cstr("-")) == 0)
		return uv
	}
	if k == EX_BINARY {
		let before = error_count
		let l = const_value_b(e[BIN_L], iota)
		let lb = cv_big
		let r = const_value_b(e[BIN_R], iota)
		let ub = i64(lb != 0 || cv_big != 0)
		cv_big = 0
		if error_count != before {
			return 0
		}
		let op = e[BIN_OP]
		if (streq(op, cstr("/")) != 0 || streq(op, cstr("%")) != 0) && r == 0 {
			err_code_at(e[N_POS], cstr("E222 DIVISION_BY_ZERO"), cstr("division by zero in constant expression"))
			return 0
		}
		mut res = 0
		if ub != 0 && (streq(op, cstr(">>")) != 0 || streq(op, cstr("/")) != 0 || streq(op, cstr("%")) != 0) {
			res = eval_unsigned(op, l, r)
		} else if ub != 0 && (streq(op, cstr("<")) != 0 || streq(op, cstr("<=")) != 0 || streq(op, cstr(">")) != 0 || streq(op, cstr(">=")) != 0) {
			res = eval_binary(op, l ^ (1 << 63), r ^ (1 << 63))
			return res
		} else {
			res = eval_binary(op, l, r)
		}
		cv_big = i64(ub != 0 && res < 0)
		return res
	}
	err_code_at(e[N_POS], cstr("E220 NOT_CONSTANT"), cstr("expression is not a constant"))
	return 0
}

fn eval_unary(op i64, v i64) i64 {
	if streq(op, cstr("-")) != 0 {
		return -v
	}
	if streq(op, cstr("~")) != 0 {
		return ~v
	}
	return i64(v == 0)
}

// eval_binary matches the ARM64 instructions codegen emits (shift counts wrap at 64).
fn eval_binary(op i64, l i64, r i64) i64 {
	if streq(op, cstr("+")) != 0 {
		return l + r
	}
	if streq(op, cstr("-")) != 0 {
		return l - r
	}
	if streq(op, cstr("*")) != 0 {
		return l * r
	}
	if streq(op, cstr("/")) != 0 {
		return l / r
	}
	if streq(op, cstr("%")) != 0 {
		return l % r
	}
	if streq(op, cstr("&")) != 0 {
		return l & r
	}
	if streq(op, cstr("|")) != 0 {
		return l | r
	}
	if streq(op, cstr("^")) != 0 {
		return l ^ r
	}
	if streq(op, cstr("<<")) != 0 {
		return l << r
	}
	if streq(op, cstr(">>")) != 0 {
		return l >> r
	}
	if streq(op, cstr("==")) != 0 {
		return i64(l == r)
	}
	if streq(op, cstr("!=")) != 0 {
		return i64(l != r)
	}
	if streq(op, cstr("<")) != 0 {
		return i64(l < r)
	}
	if streq(op, cstr("<=")) != 0 {
		return i64(l <= r)
	}
	if streq(op, cstr(">")) != 0 {
		return i64(l > r)
	}
	if streq(op, cstr(">=")) != 0 {
		return i64(l >= r)
	}
	if streq(op, cstr("&&")) != 0 {
		return i64(l != 0 && r != 0)
	}
	return i64(l != 0 || r != 0)
}

// check_pkg_vars checks package pkg's globals after those of the packages it imports, so
// their initializers run first; done lists the packages already checked.
fn check_pkg_vars(pkg i64, done i64) {
	mut i = 0
	for i < done[VEC_LEN] {
		if streq(vec_get(done, i), pkg) != 0 {
			return
		}
		i = i + 1
	}
	vec_push(done, pkg)
	i = 0
	for i < file_pkgs[VEC_LEN] {
		if streq(vec_get(file_pkgs, i), pkg) != 0 {
			let imps = vec_get(file_imports, i)
			mut j = 0
			for j < imps[VEC_LEN] {
				check_pkg_vars(path_pkg(vec_get(vec_get(imps, j), 1)), done)
				j = j + 1
			}
		}
		i = i + 1
	}
	i = 0
	for i < prog_vars[VEC_LEN] {
		let v = vec_get(prog_vars, i)
		if streq(vec_get(file_pkgs, v[D_FILE]), pkg) != 0 {
			check_var(v)
		}
		i = i + 1
	}
}

shared mut ck_sentinel i64 // the initializer of the package-level var being checked: fault("...") there is a sentinel
shared mut sentinel_seq i64 // numbers sentinel identities (the runtime's own are below 64)

fn check_var(v i64) {
	set_file(v[D_FILE])
	ck_legacy = i64(vec_get(file_v2, ck_file) == 0)
	ck_fn = 0
	let s = v[D_SYM]
	if s[S_INDEX] != vec_index(prog_vars, v) {
		return
	}
	if v[D_TYPE] != 0 {
		sb_forbid(v[D_POS], s[S_TYPE], cstr("a global cannot hold "))
	}
	let pu = use_global_of(v)
	if pu != 0 {
		check_use_global(v, s, pu)
		return
	}
	mut init = v[D_INIT]
	if init == 0 && s[S_TLS] != 0 && array_len(v[D_TYPE]) > 0 {
		init = array_make(v[D_POS], s[S_TYPE], array_len(v[D_TYPE]))
	}
	if init == 0 && s[S_TLS] != 0 && s[S_TYPE] != 0 && is_ref(s[S_TYPE]) != 0 && kind_of(s[S_TYPE]) != K_OPT && kind_of(s[S_TYPE]) != K_ERROR && kind_of(s[S_TYPE]) != K_FUNC {
		init = zero_value(v[D_POS], s[S_TYPE])
	}
	if init == 0 {
		if s[S_TYPE] == 0 {
			s[S_TYPE] = ty_int
		}
		if kind_of(s[S_TYPE]) == K_DYN && ck_legacy == 0 {
			zero_value(v[D_POS], s[S_TYPE])
		}
		return
	}
	if (ck_legacy != 0 || is_int_const_expr(init) != 0) && s[S_TLS] == 0 {
		v[D_VAL] = const_value(init, 0)
		if s[S_TYPE] == 0 {
			s[S_TYPE] = ty_int
		}
		if is_float_t(s[S_TYPE]) != 0 {
			v[D_VAL] = int_to_float_bits(v[D_VAL])
		}
		return
	}
	// Anything else runs at startup, in the order checked, inside __start.
	start_scope()
	ck_fn = start_fn
	if s[S_TLS] != 0 {
		ck_fn = core_fn
	}
	ck_sentinel = init
	let t = chk(init, s[S_TYPE])
	ck_sentinel = 0
	if s[S_TYPE] == 0 {
		s[S_TYPE] = default_type(t)
		sb_forbid(v[D_POS], s[S_TYPE], cstr("a global cannot hold "))
	}
	if ck_legacy == 0 {
		check_assignable(init, t, s[S_TYPE])
		if is_untyped(t) != 0 {
			reconvert(init, s[S_TYPE])
		}
	} else if assignable(t, s[S_TYPE]) == 0 {
		err_code_types(init[N_POS], cstr("E230 TYPE_MISMATCH"), cstr("cannot use "), t, cstr(" as "), s[S_TYPE])
	}
	let target = node_new(EX_IDENT, v[D_POS])
	target[ID_NAME] = s[S_NAME]
	target[ID_REF] = s
	target[N_TYPE] = s[S_TYPE]
	let a = node_new(ST_ASSIGN, v[D_POS])
	a[AS_TARGET] = target
	a[AS_VALUE] = init
	s[S_UNINIT] = 1
	if s[S_TLS] != 0 {
		vec_push(core_stmts, a)
	} else {
		vec_push(init_stmts, a)
	}
}

fn vec_index(v i64, x i64) i64 {
	mut i = 0
	for i < v[VEC_LEN] {
		if vec_get(v, i) == x {
			return i
		}
		i = i + 1
	}
	return -1
}

shared mut entry_name i64 // -entry: the function the program starts at (0: main)

// make_start builds __start: runtime setup, global initializers, main, flush and exit.
fn make_start(main_fn i64) {
	let pos = main_fn[F_POS]
	let f = start_fn
	f[F_POS] = pos
	// __start takes the C entry name; the program's own main becomes main.main.
	f[F_QNAME] = cstr("main")
	main_fn[F_QNAME] = cstr("main.main")
	f[F_LEGACY] = 1
	vec_push(f[F_PARAMS], cstr("argc"))
	vec_push(f[F_PARAMS], cstr("argv"))
	f[F_PTYPES] = vec_new()
	vec_push(f[F_PTYPES], ty_int)
	vec_push(f[F_PTYPES], ty_int)
	f[F_RTYPES] = vec_new()
	vec_push(f[F_RTYPES], ty_int)
	f[F_TYPE] = func_of(f[F_PTYPES], f[F_RTYPES], 0)
	let body = empty_block(pos)
	f[F_BODY] = body
	ck_fn = f
	sc_syms[VEC_LEN] = 0
	sc_marks[VEC_LEN] = 0
	vec_push(sc_marks, 0)
	// The parameters must be the first locals; initializer temps follow them.
	let olds = f[F_LOCALS]
	f[F_LOCALS] = vec_new()
	f[F_SLOTS] = 0
	let a0 = declare_local(pos, cstr("argc"), ty_int)
	let a1 = declare_local(pos, cstr("argv"), ty_int)
	mut oi = 0
	for oi < olds[VEC_LEN] {
		vec_push(f[F_LOCALS], vec_get(olds, oi))
		oi = oi + 1
	}
	let cb = empty_block(pos)
	mut ci = 0
	for ci < core_stmts[VEC_LEN] {
		vec_push(cb[BLK_STMTS], vec_get(core_stmts, ci))
		ci = ci + 1
	}
	core_fn[F_BODY] = cb
	core_fn[F_POS] = pos
	vec_push(prog_fns, core_fn)
	let cref = node_new(EX_FUNCREF, pos)
	cref[FR_FN] = core_fn
	cref[N_TYPE] = core_fn[F_TYPE]
	let args = vec_new()
	vec_push(args, sym_ref_node(pos, a0))
	vec_push(args, sym_ref_node(pos, a1))
	vec_push(args, mk_int(pos, tls_count, ty_int))
	vec_push(args, cref)
	vec_push(body[BLK_STMTS], expr_stmt(rt_call(pos, cstr("rt_init"), args, ty_void)))
	if compiler_polls != 0 {
		vec_push(body[BLK_STMTS], expr_stmt(rt_call(pos, cstr("rt_poll_enable"), vec_new(), ty_void)))
	}
	mut i = 0
	for i < init_stmts[VEC_LEN] {
		vec_push(body[BLK_STMTS], vec_get(init_stmts, i))
		i = i + 1
	}
	let cc = node_new(EX_CALL, pos)
	cc[CALL_NAME] = cstr("__core_init")
	cc[CALL_ARGS] = vec_new()
	cc[CALL_FN] = core_fn
	cc[N_TYPE] = ty_void
	vec_push(body[BLK_STMTS], expr_stmt(cc))
	vec_push(body[BLK_STMTS], expr_stmt(rt_call(pos, cstr("rt_main_begin"), vec_new(), ty_void)))
	life_start(pos, body)
	let call = node_new(EX_CALL, pos)
	call[CALL_NAME] = cstr("main")
	call[CALL_ARGS] = vec_new()
	call[CALL_FN] = main_fn
	call[N_TYPE] = ty_void
	vec_push(body[BLK_STMTS], expr_stmt(call))
	life_stop(pos, body)
	vec_push(body[BLK_STMTS], expr_stmt(rt_call(pos, cstr("rt_exit"), vec_new(), ty_void)))
	vec_push(prog_fns, f)
	start_fn = f
}

// ---- reachability ----
const F_INITWALK = 27 // walked by check_init_order
shared mut reach_init i64 // the global whose initializer check_init_order walks (0: reachability)

fn mark_reach(f i64) {
	if f == 0 {
		return
	}
	if reach_init != 0 {
		if f[F_INITWALK] != 0 {
			return
		}
		f[F_INITWALK] = 1
	} else if f[F_REACH] != 0 {
		return
	} else {
		f[F_REACH] = 1
	}
	// The Linux raw leaves replace their seed fallback bodies, so those imports are dead.
	if tgt_linux != 0 && (streq(f[F_QNAME], cstr("linux_raw")) != 0 || streq(f[F_QNAME], cstr("linux_restorer")) != 0) {
		return
	}
	if f[F_BODY] != 0 {
		reach_stmts(f[F_BODY][BLK_STMTS])
	}
}

// check_init_order rejects an initializer that can use a global whose initializer has not
// run yet (it would see nil), directly or through the functions it calls or refers to.
// Shared globals are initialized in __start, before the per-core ones in __core_init.
// Each function is walked once, for the first initializer that reaches it: later ones have
// fewer globals pending.
fn check_init_order() {
	walk_inits(init_stmts)
	walk_inits(core_stmts)
	reach_init = 0
}

fn walk_inits(stmts i64) {
	mut i = 0
	for i < stmts[VEC_LEN] {
		let a = vec_get(stmts, i)
		reach_init = a[AS_TARGET][ID_REF]
		reach_expr(a[AS_VALUE])
		reach_init[S_UNINIT] = 0
		i = i + 1
	}
}

fn reach_stmts(v i64) {
	mut i = 0
	for i < v[VEC_LEN] {
		reach_stmt(vec_get(v, i))
		i = i + 1
	}
}

fn reach_stmt(s i64) {
	if s == 0 {
		return
	}
	let k = s[N_KIND]
	if k == ST_BLOCK {
		reach_stmts(s[BLK_STMTS])
	} else if k == ST_LET {
		reach_expr(s[LET_INIT])
	} else if k == ST_ASSIGN {
		reach_expr(s[AS_TARGET])
		reach_expr(s[AS_VALUE])
	} else if k == ST_EXPR {
		reach_expr(s[ES_X])
	} else if k == ST_IF {
		reach_expr(s[IF_COND])
		reach_stmt(s[IF_THEN])
		reach_stmt(s[IF_ELSE])
	} else if k == ST_WHILE {
		reach_expr(s[WH_COND])
		reach_stmt(s[WH_BODY])
		reach_stmt(s[WH_POST])
	} else if k == ST_RETURN {
		reach_expr(s[RET_VALUE])
		if s[RET_VALUES] != 0 {
			reach_exprs(s[RET_VALUES])
		}
	} else if k == ST_CALLMULTI {
		reach_expr(s[CM_CALL])
	}
}

fn reach_exprs(v i64) {
	mut i = 0
	for i < v[VEC_LEN] {
		reach_expr(vec_get(v, i))
		i = i + 1
	}
}

fn reach_expr(e i64) {
	if e == 0 {
		return
	}
	let k = e[N_KIND]
	if k == EX_CALL {
		mark_reach(e[CALL_FN])
		reach_expr(e[CALL_CALLEE])
		reach_exprs(e[CALL_ARGS])
	} else if k == EX_FUNCREF {
		mark_reach(e[FR_FN])
	} else if k == EX_IDENT {
		let s = e[ID_REF]
		if reach_init != 0 && s != 0 && s[S_UNINIT] != 0 {
			let b = err_code(e[N_POS], cstr("E130 INIT_ORDER"))
			buf_str(b, cstr("the initializer of '"))
			buf_str(b, reach_init[S_NAME])
			buf_str(b, cstr("' uses '"))
			buf_str(b, s[S_NAME])
			buf_str(b, cstr("' before it is initialized (globals are initialized in declaration order)"))
			err_end(b)
		}
	} else if k == EX_UNARY {
		reach_expr(e[UN_X])
	} else if k == EX_BINARY {
		reach_expr(e[BIN_L])
		reach_expr(e[BIN_R])
	} else if k == EX_INDEX {
		reach_expr(e[IX_X])
		reach_expr(e[IX_I])
	} else if k == EX_CONV {
		if e[CV_KIND] == CV_DYN {
			dyn_table_mark(e[CV_DYN_TABLE])
		}
		reach_expr(e[CV_X])
	} else if k == EX_SEQ {
		reach_stmts(e[SEQ_STMTS])
		reach_expr(e[SEQ_VALUE])
	} else if k == EX_MEM {
		reach_expr(e[MEM_BASE])
		reach_expr(e[MEM_INDEX])
		reach_expr(e[MEM_LEN])
	} else if k == EX_ELEM {
		reach_expr(e[ELEM_SEQ])
		reach_expr(e[ELEM_IDX])
	}
}

// ---- scopes ----
fn start_scope() {
	sc_syms[VEC_LEN] = 0
	sc_marks[VEC_LEN] = 0
	vec_push(sc_marks, 0)
}

// mut_capable reports whether a parameter of type t can be mut: the callee may modify the
// contents of a struct, a slice or a map (or an optional of one) through it. A number, a bool, a
// str or a fault is passed by value, so there is nothing for mut to let it modify.
fn mut_capable(t i64) i64 {
	let k = kind_of(t)
	return i64(k == K_STRUCT || k == K_SLICE || k == K_MAP || k == K_OPT || k == K_DYN)
}

fn collect_local_decls(stmts i64, names i64) {
	if stmts == 0 {
		return
	}
	mut i = 0
	for i < stmts[VEC_LEN] {
		let s = vec_get(stmts, i)
		let k = s[N_KIND]
		if k == ST_LET {
			vec_push(names, s[LET_NAME])
		} else if k == ST_USE {
			vec_push(names, s[USE_NAME])
		} else if k == ST_MULTI && s[MU_DEFINE] != 0 {
			let tg = s[MU_TARGETS]
			mut j = 0
			for j < tg[VEC_LEN] {
				let t = vec_get(tg, j)
				if t[N_KIND] == EX_IDENT {
					vec_push(names, t[ID_NAME])
				}
				j = j + 1
			}
		} else if k == ST_BLOCK {
			collect_local_decls(s[BLK_STMTS], names)
		} else if k == ST_SCOPE {
			vec_push(names, s[SCOPE_NAME])
			collect_local_decls(s[SCOPE_BODY][BLK_STMTS], names)
		} else if k == ST_DETACH {
			collect_local_decls(s[BODY_BLOCK][BLK_STMTS], names)
		} else if k == ST_LIST {
			collect_local_decls(s[LIST_STMTS], names)
		} else if mt_stmt_expr(s) != 0 && mt_stmt_expr(s)[N_KIND] == EX_MATCH {
			mt_collect_decls(mt_stmt_expr(s), names)
		} else if k == ST_IF {
			if s[IF_INIT] != 0 {
				let tmp = vec_new()
				vec_push(tmp, s[IF_INIT])
				collect_local_decls(tmp, names)
			}
			collect_local_decls(s[IF_THEN][BLK_STMTS], names)
			if s[IF_ELSE] != 0 {
				if s[IF_ELSE][N_KIND] == ST_BLOCK {
					collect_local_decls(s[IF_ELSE][BLK_STMTS], names)
				} else {
					let tmp = vec_new()
					vec_push(tmp, s[IF_ELSE])
					collect_local_decls(tmp, names)
				}
			}
		} else if k == ST_WHILE {
			if s[WH_INIT] != 0 {
				let tmp = vec_new()
				vec_push(tmp, s[WH_INIT])
				collect_local_decls(tmp, names)
			}
			collect_local_decls(s[WH_BODY][BLK_STMTS], names)
		} else if k == ST_RANGE {
			if s[RG_DEFINE] != 0 {
				if s[RG_KEY] != 0 && s[RG_KEY][N_KIND] == EX_IDENT {
					vec_push(names, s[RG_KEY][ID_NAME])
				}
				if s[RG_VAL] != 0 && s[RG_VAL][N_KIND] == EX_IDENT {
					vec_push(names, s[RG_VAL][ID_NAME])
				}
			}
			collect_local_decls(s[RG_BODY][BLK_STMTS], names)
		} else if k == ST_SWITCH {
			if s[SW_INIT] != 0 {
				let tmp = vec_new()
				vec_push(tmp, s[SW_INIT])
				collect_local_decls(tmp, names)
			}
			let cases = s[SW_CASES]
			if cases != 0 {
				mut ci = 0
				for ci < cases[VEC_LEN] {
					let c = vec_get(cases, ci)
					let body = vec_get(c, 1)
					if body != 0 {
						collect_local_decls(body[BLK_STMTS], names)
					}
					ci = ci + 1
				}
			}
		}
		i = i + 1
	}
}

fn scan_funclit_escaping_idents(lf i64, outer_names i64, cells i64) {
	if lf == 0 || lf[F_BODY] == 0 {
		return
	}
	let inner_params = lf[F_PARAMS]
	scan_idents_in_block(lf[F_BODY], inner_params, outer_names, cells)
}

fn scan_idents_in_block(b i64, inner_params i64, outer_names i64, cells i64) {
	if b == 0 || b[BLK_STMTS] == 0 {
		return
	}
	let stmts = b[BLK_STMTS]
	mut i = 0
	for i < stmts[VEC_LEN] {
		scan_idents_in_stmt(vec_get(stmts, i), inner_params, outer_names, cells)
		i = i + 1
	}
}

fn scan_idents_in_stmt(s i64, inner_params i64, outer_names i64, cells i64) {
	if s == 0 {
		return
	}
	let k = s[N_KIND]
	if k == ST_LET {
		scan_idents_in_expr(s[LET_INIT], inner_params, outer_names, cells)
	} else if k == ST_USE {
		scan_idents_in_expr(s[USE_INIT], inner_params, outer_names, cells)
	} else if k == ST_ASSIGN {
		scan_idents_in_expr(s[AS_TARGET], inner_params, outer_names, cells)
		scan_idents_in_expr(s[AS_VALUE], inner_params, outer_names, cells)
	} else if k == ST_MULTI {
		let vals = s[MU_VALUES]
		if vals != 0 {
			mut i = 0
			for i < vals[VEC_LEN] {
				scan_idents_in_expr(vec_get(vals, i), inner_params, outer_names, cells)
				i = i + 1
			}
		}
	} else if k == ST_EXPR {
		scan_idents_in_expr(s[ES_X], inner_params, outer_names, cells)
	} else if k == ST_IF {
		if s[IF_INIT] != 0 {
			scan_idents_in_stmt(s[IF_INIT], inner_params, outer_names, cells)
		}
		scan_idents_in_expr(s[IF_COND], inner_params, outer_names, cells)
		scan_idents_in_block(s[IF_THEN], inner_params, outer_names, cells)
		if s[IF_ELSE] != 0 {
			if s[IF_ELSE][N_KIND] == ST_BLOCK {
				scan_idents_in_block(s[IF_ELSE], inner_params, outer_names, cells)
			} else {
				scan_idents_in_stmt(s[IF_ELSE], inner_params, outer_names, cells)
			}
		}
	} else if k == ST_WHILE {
		if s[WH_INIT] != 0 {
			scan_idents_in_stmt(s[WH_INIT], inner_params, outer_names, cells)
		}
		scan_idents_in_expr(s[WH_COND], inner_params, outer_names, cells)
		scan_idents_in_block(s[WH_BODY], inner_params, outer_names, cells)
		scan_idents_in_stmt(s[WH_POST], inner_params, outer_names, cells)
	} else if k == ST_RANGE {
		scan_idents_in_expr(s[RG_EXPR], inner_params, outer_names, cells)
		scan_idents_in_block(s[RG_BODY], inner_params, outer_names, cells)
	} else if k == ST_SWITCH {
		if s[SW_INIT] != 0 {
			scan_idents_in_stmt(s[SW_INIT], inner_params, outer_names, cells)
		}
		if s[SW_TAG] != 0 {
			scan_idents_in_expr(s[SW_TAG], inner_params, outer_names, cells)
		}
		let cases = s[SW_CASES]
		if cases != 0 {
			mut ci = 0
			for ci < cases[VEC_LEN] {
				let c = vec_get(cases, ci)
				let exprs = vec_get(c, 0)
				if exprs != 0 {
					mut j = 0
					for j < exprs[VEC_LEN] {
						scan_idents_in_expr(vec_get(exprs, j), inner_params, outer_names, cells)
						j = j + 1
					}
				}
				let body = vec_get(c, 1)
				if body != 0 {
					scan_idents_in_block(body, inner_params, outer_names, cells)
				}
				ci = ci + 1
			}
		}
	} else if k == ST_RETURN {
		scan_idents_in_expr(s[RET_VALUE], inner_params, outer_names, cells)
		let vals = s[RET_VALUES]
		if vals != 0 {
			mut i = 0
			for i < vals[VEC_LEN] {
				scan_idents_in_expr(vec_get(vals, i), inner_params, outer_names, cells)
				i = i + 1
			}
		}
	} else if k == ST_DEFER || k == ST_GO {
		scan_idents_in_expr(s[GO_CALL], inner_params, outer_names, cells)
	} else if k == ST_FAIL {
		scan_idents_in_expr(s[FAIL_X], inner_params, outer_names, cells)
	} else if k == ST_CALLMULTI {
		scan_idents_in_expr(s[CM_CALL], inner_params, outer_names, cells)
	} else if k == ST_BLOCK {
		scan_idents_in_block(s, inner_params, outer_names, cells)
	} else if k == ST_SCOPE {
		scan_idents_in_block(s[SCOPE_BODY], inner_params, outer_names, cells)
	} else if k == ST_DETACH {
		scan_funclit_escaping_idents(detach_fn(s), outer_names, cells)
	} else if k == ST_LIST {
		let stmts = s[LIST_STMTS]
		mut i = 0
		for i < stmts[VEC_LEN] {
			scan_idents_in_stmt(vec_get(stmts, i), inner_params, outer_names, cells)
			i = i + 1
		}
	}
}

fn scan_idents_in_expr(e i64, inner_params i64, outer_names i64, cells i64) {
	if e == 0 {
		return
	}
	let k = e[N_KIND]
	if k == EX_IDENT {
		let name = e[ID_NAME]
		if vec_has_str(inner_params, name) == 0 && vec_has_str(outer_names, name) != 0 {
			if vec_has_str(cells, name) == 0 {
				vec_push(cells, name)
			}
		}
	} else if k == EX_CALL {
		scan_idents_in_expr(e[CALL_CALLEE], inner_params, outer_names, cells)
		let args = e[CALL_ARGS]
		if args != 0 {
			mut i = 0
			for i < args[VEC_LEN] {
				scan_idents_in_expr(vec_get(args, i), inner_params, outer_names, cells)
				i = i + 1
			}
		}
	} else if k == EX_BINARY {
		scan_idents_in_expr(e[BIN_L], inner_params, outer_names, cells)
		scan_idents_in_expr(e[BIN_R], inner_params, outer_names, cells)
	} else if k == EX_UNARY {
		scan_idents_in_expr(e[UN_X], inner_params, outer_names, cells)
	} else if k == EX_SELECT {
		scan_idents_in_expr(e[SEL_X], inner_params, outer_names, cells)
	} else if k == EX_INDEX {
		scan_idents_in_expr(e[IX_X], inner_params, outer_names, cells)
		scan_idents_in_expr(e[IX_I], inner_params, outer_names, cells)
	} else if k == EX_CONV {
		scan_idents_in_expr(e[CV_X], inner_params, outer_names, cells)
	} else if k == EX_MUTARG {
		scan_idents_in_expr(e[MUTARG_X], inner_params, outer_names, cells)
	} else if k == EX_SLICE {
		scan_idents_in_expr(e[SL_X], inner_params, outer_names, cells)
		scan_idents_in_expr(e[SL_LO], inner_params, outer_names, cells)
		scan_idents_in_expr(e[SL_HI], inner_params, outer_names, cells)
	} else if k == EX_TRY {
		scan_idents_in_expr(e[TRY_X], inner_params, outer_names, cells)
	} else if k == EX_WRAP {
		scan_idents_in_expr(e[WRAP_X], inner_params, outer_names, cells)
		scan_idents_in_expr(e[WRAP_MESSAGE], inner_params, outer_names, cells)
	} else if k == EX_CATCH {
		scan_idents_in_expr(e[CATCH_X], inner_params, outer_names, cells)
		scan_idents_in_block(e[CATCH_BODY], inner_params, outer_names, cells)
	} else if k == EX_INTERP {
		let ia = e[INTERP_ARGS]
		if ia != 0 {
			mut ii = 0
			for ii < ia[VEC_LEN] {
				scan_idents_in_expr(vec_get(ia, ii), inner_params, outer_names, cells)
				ii = ii + 1
			}
		}
	} else if k == EX_COMPOSITE {
		let elems = e[CL_ELEMS]
		if elems != 0 {
			mut i = 0
			for i < elems[VEC_LEN] {
				scan_idents_in_expr(vec_get(elems, i), inner_params, outer_names, cells)
				i = i + 1
			}
		}
	} else if k == EX_FUNCLIT {
		scan_funclit_escaping_idents(e[LIT_FN], outer_names, cells)
	} else if k == EX_BOUNDARY {
		if e[BOUND_KIND] == BOUND_WITH {
			// The policy is evaluated where the with is (#237).
			scan_idents_in_expr(vec_get(e[BOUND_ARGS], 0), inner_params, outer_names, cells)
		}
		scan_idents_in_block(e[BOUND_BODY], inner_params, outer_names, cells)
	} else if k == EX_MATCH {
		scan_idents_in_expr(e[MATCH_SUBJECT], inner_params, outer_names, cells)
		let arms = e[MATCH_ARMS]
		mut ai = 0
		for ai < arms[VEC_LEN] {
			let arm = vec_get(arms, ai)
			scan_idents_in_expr(vec_get(arm, ARM_GUARD), inner_params, outer_names, cells)
			if vec_get(arm, ARM_BLOCK) != 0 {
				scan_idents_in_block(vec_get(arm, ARM_BODY), inner_params, outer_names, cells)
			} else {
				scan_idents_in_expr(vec_get(arm, ARM_BODY), inner_params, outer_names, cells)
			}
			ai = ai + 1
		}
	}
}

fn scan_captures(f i64, cells i64) {
	if f == 0 || f[F_BODY] == 0 {
		return
	}
	let outer_names = vec_new()
	mut i = 0
	for i < f[F_PARAMS][VEC_LEN] {
		vec_push(outer_names, vec_get(f[F_PARAMS], i))
		i = i + 1
	}
	collect_local_decls(f[F_BODY][BLK_STMTS], outer_names)
	scan_funclits_in_block(f[F_BODY], outer_names, cells)
}

fn scan_funclits_in_block(b i64, outer_names i64, cells i64) {
	if b == 0 || b[BLK_STMTS] == 0 {
		return
	}
	let stmts = b[BLK_STMTS]
	mut i = 0
	for i < stmts[VEC_LEN] {
		scan_funclits_in_stmt(vec_get(stmts, i), outer_names, cells)
		i = i + 1
	}
}

fn scan_funclits_in_stmt(s i64, outer_names i64, cells i64) {
	if s == 0 {
		return
	}
	let k = s[N_KIND]
	if k == ST_LET {
		scan_funclits_in_expr(s[LET_INIT], outer_names, cells)
	} else if k == ST_USE {
		scan_funclits_in_expr(s[USE_INIT], outer_names, cells)
	} else if k == ST_ASSIGN {
		scan_funclits_in_expr(s[AS_TARGET], outer_names, cells)
		scan_funclits_in_expr(s[AS_VALUE], outer_names, cells)
	} else if k == ST_MULTI {
		let vals = s[MU_VALUES]
		if vals != 0 {
			mut i = 0
			for i < vals[VEC_LEN] {
				scan_funclits_in_expr(vec_get(vals, i), outer_names, cells)
				i = i + 1
			}
		}
	} else if k == ST_EXPR {
		scan_funclits_in_expr(s[ES_X], outer_names, cells)
	} else if k == ST_IF {
		if s[IF_INIT] != 0 {
			scan_funclits_in_stmt(s[IF_INIT], outer_names, cells)
		}
		scan_funclits_in_expr(s[IF_COND], outer_names, cells)
		scan_funclits_in_block(s[IF_THEN], outer_names, cells)
		if s[IF_ELSE] != 0 {
			if s[IF_ELSE][N_KIND] == ST_BLOCK {
				scan_funclits_in_block(s[IF_ELSE], outer_names, cells)
			} else {
				scan_funclits_in_stmt(s[IF_ELSE], outer_names, cells)
			}
		}
	} else if k == ST_WHILE {
		if s[WH_INIT] != 0 {
			scan_funclits_in_stmt(s[WH_INIT], outer_names, cells)
		}
		scan_funclits_in_expr(s[WH_COND], outer_names, cells)
		scan_funclits_in_block(s[WH_BODY], outer_names, cells)
		scan_funclits_in_stmt(s[WH_POST], outer_names, cells)
	} else if k == ST_RANGE {
		scan_funclits_in_expr(s[RG_EXPR], outer_names, cells)
		scan_funclits_in_block(s[RG_BODY], outer_names, cells)
	} else if k == ST_SWITCH {
		if s[SW_INIT] != 0 {
			scan_funclits_in_stmt(s[SW_INIT], outer_names, cells)
		}
		if s[SW_TAG] != 0 {
			scan_funclits_in_expr(s[SW_TAG], outer_names, cells)
		}
		let cases = s[SW_CASES]
		if cases != 0 {
			mut ci = 0
			for ci < cases[VEC_LEN] {
				let c = vec_get(cases, ci)
				let exprs = vec_get(c, 0)
				if exprs != 0 {
					mut j = 0
					for j < exprs[VEC_LEN] {
						scan_funclits_in_expr(vec_get(exprs, j), outer_names, cells)
						j = j + 1
					}
				}
				let body = vec_get(c, 1)
				if body != 0 {
					scan_funclits_in_block(body, outer_names, cells)
				}
				ci = ci + 1
			}
		}
	} else if k == ST_RETURN {
		scan_funclits_in_expr(s[RET_VALUE], outer_names, cells)
		let vals = s[RET_VALUES]
		if vals != 0 {
			mut i = 0
			for i < vals[VEC_LEN] {
				scan_funclits_in_expr(vec_get(vals, i), outer_names, cells)
				i = i + 1
			}
		}
	} else if k == ST_DEFER || k == ST_GO {
		scan_funclits_in_expr(s[GO_CALL], outer_names, cells)
	} else if k == ST_FAIL {
		scan_funclits_in_expr(s[FAIL_X], outer_names, cells)
	} else if k == ST_CALLMULTI {
		scan_funclits_in_expr(s[CM_CALL], outer_names, cells)
	} else if k == ST_BLOCK {
		scan_funclits_in_block(s, outer_names, cells)
	} else if k == ST_SCOPE {
		scan_funclits_in_block(s[SCOPE_BODY], outer_names, cells)
	} else if k == ST_DETACH {
		scan_funclit_escaping_idents(detach_fn(s), outer_names, cells)
	} else if k == ST_LIST {
		let stmts = s[LIST_STMTS]
		mut i = 0
		for i < stmts[VEC_LEN] {
			scan_funclits_in_stmt(vec_get(stmts, i), outer_names, cells)
			i = i + 1
		}
	}
}

fn scan_funclits_in_expr(e i64, outer_names i64, cells i64) {
	if e == 0 {
		return
	}
	let k = e[N_KIND]
	if k == EX_FUNCLIT {
		if e[LIT_ESCAPE] != 0 {
			scan_funclit_escaping_idents(e[LIT_FN], outer_names, cells)
		}
	} else if k == EX_CALL {
		scan_funclits_in_expr(e[CALL_CALLEE], outer_names, cells)
		let args = e[CALL_ARGS]
		if args != 0 {
			mut i = 0
			for i < args[VEC_LEN] {
				scan_funclits_in_expr(vec_get(args, i), outer_names, cells)
				i = i + 1
			}
		}
	} else if k == EX_BINARY {
		scan_funclits_in_expr(e[BIN_L], outer_names, cells)
		scan_funclits_in_expr(e[BIN_R], outer_names, cells)
	} else if k == EX_UNARY {
		scan_funclits_in_expr(e[UN_X], outer_names, cells)
	} else if k == EX_SELECT {
		scan_funclits_in_expr(e[SEL_X], outer_names, cells)
	} else if k == EX_INDEX {
		scan_funclits_in_expr(e[IX_X], outer_names, cells)
		scan_funclits_in_expr(e[IX_I], outer_names, cells)
	} else if k == EX_CONV {
		scan_funclits_in_expr(e[CV_X], outer_names, cells)
	} else if k == EX_MUTARG {
		scan_funclits_in_expr(e[MUTARG_X], outer_names, cells)
	} else if k == EX_SLICE {
		scan_funclits_in_expr(e[SL_X], outer_names, cells)
		scan_funclits_in_expr(e[SL_LO], outer_names, cells)
		scan_funclits_in_expr(e[SL_HI], outer_names, cells)
	} else if k == EX_TRY {
		scan_funclits_in_expr(e[TRY_X], outer_names, cells)
	} else if k == EX_WRAP {
		scan_funclits_in_expr(e[WRAP_X], outer_names, cells)
		scan_funclits_in_expr(e[WRAP_MESSAGE], outer_names, cells)
	} else if k == EX_CATCH {
		scan_funclits_in_expr(e[CATCH_X], outer_names, cells)
		scan_funclits_in_block(e[CATCH_BODY], outer_names, cells)
	} else if k == EX_BOUNDARY {
		if e[BOUND_KIND] == BOUND_WITH {
			scan_funclits_in_expr(vec_get(e[BOUND_ARGS], 0), outer_names, cells)
		}
		scan_funclits_in_block(e[BOUND_BODY], outer_names, cells)
	} else if k == EX_MATCH {
		scan_funclits_in_expr(e[MATCH_SUBJECT], outer_names, cells)
		let arms = e[MATCH_ARMS]
		mut ai = 0
		for ai < arms[VEC_LEN] {
			let arm = vec_get(arms, ai)
			scan_funclits_in_expr(vec_get(arm, ARM_GUARD), outer_names, cells)
			if vec_get(arm, ARM_BLOCK) != 0 {
				scan_funclits_in_block(vec_get(arm, ARM_BODY), outer_names, cells)
			} else {
				scan_funclits_in_expr(vec_get(arm, ARM_BODY), outer_names, cells)
			}
			ai = ai + 1
		}
	} else if k == EX_INTERP {
		let ia = e[INTERP_ARGS]
		if ia != 0 {
			mut ii = 0
			for ii < ia[VEC_LEN] {
				scan_funclits_in_expr(vec_get(ia, ii), outer_names, cells)
				ii = ii + 1
			}
		}
	} else if k == EX_COMPOSITE {
		let elems = e[CL_ELEMS]
		if elems != 0 {
			mut i = 0
			for i < elems[VEC_LEN] {
				scan_funclits_in_expr(vec_get(elems, i), outer_names, cells)
				i = i + 1
			}
		}
	}
}

fn check_fn_closure(f i64) {
	let saved_file = ck_file
	let saved_legacy = ck_legacy
	let saved_fn = ck_fn
	let saved_tbind = ck_tbind
	let saved_loops = ck_loops
	let saved_breaks = ck_breaks
	let saved_defers = ck_defers
	let saved_mark = ck_defer_mark
	let saved_syms = vec_clone(sc_syms)
	let saved_marks = vec_clone(sc_marks)
	let saved_safe = safe_pairs
	let saved_len_aliases = len_aliases
	let saved_cells = ck_escaping_cells
	let saved_depth = ck_scope_depth
	let saved_base = ck_fn_base
	// A closure's own variables (and its parameters, which a caller may fill with handles of
	// scopes the closure never sees) count as deeper than anything it captures (#232).
	ck_scope_depth = ck_scope_depth + 65536
	ck_fn_base = ck_scope_depth

	check_fn(f)

	set_file(saved_file)
	ck_legacy = saved_legacy
	ck_fn = saved_fn
	ck_tbind = saved_tbind
	ck_loops = saved_loops
	ck_breaks = saved_breaks
	ck_defers = saved_defers
	ck_defer_mark = saved_mark
	sc_syms = saved_syms
	sc_marks = saved_marks
	safe_pairs = saved_safe
	len_aliases = saved_len_aliases
	ck_escaping_cells = saved_cells
	ck_scope_depth = saved_depth
	ck_fn_base = saved_base
}

fn check_fn(f i64) {
	set_file(f[F_FILE])
	if f[F_PARENT] == 0 {
		ck_scope_depth = 0
		ck_fn_base = 0
	}
	ck_tbind = f[F_TBIND]
	ck_fn = f
	ck_legacy = f[F_LEGACY]
	ck_loops = 0
	ck_breaks = 0
	ck_escaping_cells = vec_new()
	len_aliases = vec_new()
	if f[F_BODY] != 0 {
		if ck_legacy == 0 {
			mark_spawns(f[F_BODY][BLK_STMTS], sb_scope_params(f))
		}
		scan_captures(f, ck_escaping_cells)
	}
	start_scope()
	f[F_SLOTS] = 0
	f[F_LOCALS] = vec_new()
	let params = f[F_PARAMS]
	mut i = 0
	ck_params_only = 1
	for i < params[VEC_LEN] {
		let ps = declare_local(f[F_POS], vec_get(params, i), vec_get(f[F_PTYPES], i))
		ps[S_READS] = 1
		secret_lib_param(ps)
		if f[F_MUTS] != 0 && i < f[F_MUTS][VEC_LEN] {
			ps[S_MUT] = vec_get(f[F_MUTS], i)
			if ps[S_MUT] != 0 && ck_legacy == 0 && mut_capable(vec_get(f[F_PTYPES], i)) == 0 {
				err_code_type(f[F_POS], cstr("E702 MUT_VALUE_PARAM"), str_cat3(cstr("parameter '"), vec_get(params, i), cstr("' is mut, but a value of type ")), vec_get(f[F_PTYPES], i), cstr(" is passed by value: only structs, slices and maps can be modified through a parameter, so remove mut"))
			}
		}
		i = i + 1
	}
	ck_params_only = 0
	i = 0
	for i < params[VEC_LEN] {
		let pn = vec_get(params, i)
		if ck_escaping_cells != 0 && vec_has_str(ck_escaping_cells, pn) != 0 {
			give_cell(vec_get(f[F_LOCALS], i), f[F_POS], pn)
		}
		i = i + 1
	}
	if f[F_PARENT] != 0 {
		let env_sym = declare_local(f[F_POS], cstr("$env"), ty_int)
		env_sym[S_READS] = 1
		f[F_ENV_SYM] = env_sym
	}
	let cell_inits = vec_new()
	i = 0
	for i < params[VEC_LEN] {
		let ps = vec_get(f[F_LOCALS], i)
		if ps[S_CELL] != 0 {
			let alloc_call = rt_call(f[F_POS], cstr("rt_alloc"), args1(mk_int(f[F_POS], 8, ty_int)), ty_int)
			let let_cell = let_stmt(f[F_POS], ps[S_CELL_SYM], alloc_call)
			let store_cell = assign_stmt(f[F_POS], mk_mem(f[F_POS], sym_ref_node(f[F_POS], ps[S_CELL_SYM]), 0, 0, 0, ps[S_TYPE]), sym_ref_node(f[F_POS], ps))
			vec_push(cell_inits, let_cell)
			vec_push(cell_inits, store_cell)
		}
		i = i + 1
	}
	// The body shares the parameters' scope, so `let x` cannot silently hide parameter x.
	ck_defers = 0
	ck_defer_mark = 0
	check_stmts(f[F_BODY][BLK_STMTS])
	// Captured parameters move into their cells first. These statements are already typed:
	// checking them would declare a second $cell_ local, so they go in after the body is checked.
	if cell_inits[VEC_LEN] > 0 {
		let new_stmts = vec_new()
		i = 0
		for i < cell_inits[VEC_LEN] {
			vec_push(new_stmts, vec_get(cell_inits, i))
			i = i + 1
		}
		i = 0
		let old_stmts = f[F_BODY][BLK_STMTS]
		for i < old_stmts[VEC_LEN] {
			vec_push(new_stmts, vec_get(old_stmts, i))
			i = i + 1
		}
		f[F_BODY][BLK_STMTS] = new_stmts
	}
	if f[F_BANG] != 0 && ck_legacy == 0 && f[F_RTYPES][VEC_LEN] == 1 && ends_in_return(f[F_BODY][BLK_STMTS]) == 0 {
		// A ! function that runs off its end succeeds.
		let r = node_new(ST_RETURN, f[F_POS])
		r[RET_VALUE] = mk_int(f[F_POS], 0, ty_error)
		vec_push(f[F_BODY][BLK_STMTS], r)
	}
	if ck_defers != 0 {
		finish_defers(f)
		ck_defers = 0
		ck_defer_mark = 0
	}
	if ck_legacy == 0 && f[F_RTYPES][VEC_LEN] > 0 && ends_in_return(f[F_BODY][BLK_STMTS]) == 0 {
		err_code_quoted(f[F_POS], cstr("E260 MISSING_RETURN"), cstr("function "), f[F_NAME], cstr(" is missing a return at the end"))
	}
	if ck_legacy == 0 {
		// A fault that is assigned but never looked at is an ignored error.
		let locals = f[F_LOCALS]
		i = 0
		for i < locals[VEC_LEN] {
			let l = vec_get(locals, i)
			if kind_of(l[S_TYPE]) == K_ERROR && l[S_READS] == 0 && i64(load8(l[S_NAME])) != '$' {
				err_code_quoted(l[S_POS], cstr("E410 UNCHECKED_FAULT"), cstr("fault "), l[S_NAME], cstr(" is never checked"))
			}
			i = i + 1
		}
	}
}

// ends_in_return is Go's terminating-statement rule, simplified.
fn ends_in_return(stmts i64) i64 {
	if stmts[VEC_LEN] == 0 {
		return 0
	}
	let s = vec_get(stmts, stmts[VEC_LEN] - 1)
	let k = s[N_KIND]
	if k == ST_RETURN {
		return 1
	}
	if k == ST_EXPR && s[ES_X][N_KIND] == EX_CALL && s[ES_X][CALL_NAME] != 0 && (streq(s[ES_X][CALL_NAME], cstr("panic")) != 0 || streq(s[ES_X][CALL_NAME], cstr("rt_panic")) != 0) {
		return 1
	}
	if k == ST_BLOCK {
		return ends_in_return(s[BLK_STMTS])
	}
	if k == ST_IF {
		if s[IF_ELSE] == 0 || ends_in_return(s[IF_THEN][BLK_STMTS]) == 0 {
			return 0
		}
		let one = vec_new()
		vec_push(one, s[IF_ELSE])
		return ends_in_return(one)
	}
	if k == ST_WHILE {
		return i64(s[WH_ONCE] == 0 && is_true_lit(s[WH_COND]) != 0 && has_break(s[WH_BODY][BLK_STMTS]) == 0)
	}
	return 0
}

fn is_true_lit(e i64) i64 {
	return i64(e[N_KIND] == EX_INT && e[INT_VAL] != 0)
}

fn has_break(stmts i64) i64 {
	mut i = 0
	for i < stmts[VEC_LEN] {
		let s = vec_get(stmts, i)
		let k = s[N_KIND]
		if k == ST_BREAK {
			return 1
		}
		if k == ST_BLOCK && has_break(s[BLK_STMTS]) != 0 {
			return 1
		}
		if k == ST_IF {
			if has_break(s[IF_THEN][BLK_STMTS]) != 0 {
				return 1
			}
			if s[IF_ELSE] != 0 {
				let one = vec_new()
				vec_push(one, s[IF_ELSE])
				if has_break(one) != 0 {
					return 1
				}
			}
		}
		i = i + 1
	}
	return 0
}

fn declare_scoped(s i64) {
	let pos = s[S_POS]
	let name = s[S_NAME]
	let start = vec_get(sc_marks, sc_marks[VEC_LEN] - 1)
	if i64(load8(name)) != '$' {
		mut i = sc_syms[VEC_LEN] - 1
		for i >= start {
			let prev = vec_get(sc_syms, i)
			if streq(prev[S_NAME], name) != 0 {
				let e = err_code(pos, cstr("E101 REDECLARED"))
				buf_byte(e, '\'')
				buf_str(e, name)
				buf_str(e, cstr("' redeclared in this scope (previous declaration at "))
				buf_pos(e, prev[S_POS])
				buf_byte(e, ')')
				err_end(e)
				break
			}
			i = i - 1
		}
	}
	vec_push(sc_syms, s)
}

fn declare_local(pos i64, name i64, t i64) i64 {
	let s = sym_new(SYM_LOCAL, name, pos)
	s[S_TYPE] = t
	s[S_SCOPE_AT] = ck_scope_depth
	declare_scoped(s)
	s[S_SLOT] = ck_fn[F_SLOTS]
	ck_fn[F_SLOTS] = ck_fn[F_SLOTS] + 1
	vec_push(ck_fn[F_LOCALS], s)
	if ck_escaping_cells != 0 && vec_has_str(ck_escaping_cells, name) != 0 && ck_params_only == 0 {
		give_cell(s, pos, name)
	}
	return s
}

shared mut ck_params_only i64 // declaring parameters: their cells come after all of them (locals 0..n-1 are the parameters)

// give_cell makes local s a cell: a hidden local holds the address of its pool word.
fn give_cell(s i64, pos i64, name i64) {
	if s != 0 {
		s[S_CELL] = 1
		let csym = sym_new(SYM_LOCAL, str_cat3(cstr("$cell_"), name, cstr("")), pos)
		csym[S_TYPE] = ty_int
		csym[S_READS] = 1
		csym[S_SLOT] = ck_fn[F_SLOTS]
		ck_fn[F_SLOTS] = ck_fn[F_SLOTS] + 1
		vec_push(ck_fn[F_LOCALS], csym)
		s[S_CELL_SYM] = csym
		csym[S_CELL_OF] = s
	}
}

fn in_current_scope(name i64) i64 {
	let start = vec_get(sc_marks, sc_marks[VEC_LEN] - 1)
	mut i = sc_syms[VEC_LEN] - 1
	for i >= start {
		let s = vec_get(sc_syms, i)
		if streq(s[S_NAME], name) != 0 {
			return s
		}
		i = i - 1
	}
	return 0
}

fn vec_has_str(v i64, s i64) i64 {
	if v == 0 {
		return 0
	}
	mut i = 0
	for i < v[VEC_LEN] {
		if streq(vec_get(v, i), s) != 0 {
			return 1
		}
		i = i + 1
	}
	return 0
}

fn lookup_outer(f i64, name i64) i64 {
	let p = f[F_PARENT]
	if p == 0 {
		return 0
	}
	let syms = f[F_OUTER_SYMS]
	if syms != 0 {
		mut i = syms[VEC_LEN] - 1
		for i >= 0 {
			let s = vec_get(syms, i)
			if streq(s[S_NAME], name) != 0 {
				return s
			}
			i = i - 1
		}
	}
	if p[F_PARENT] != 0 {
		let os = lookup_outer(p, name)
		if os != 0 {
			return capture_sym(p, os)
		}
	}
	return 0
}

fn capture_sym(f i64, os i64) i64 {
	let caps = f[F_CAPTURES]
	mut ci = -1
	mut i = 0
	for i < caps[VEC_LEN] {
		if vec_get(caps, i) == os {
			ci = i
			break
		}
		i = i + 1
	}
	if ci < 0 {
		if os[S_MUT] != 0 {
			err_code_at(f[F_POS], cstr("E703 CAPTURE_MUT"), str_cat3(cstr("a function literal cannot capture the mut parameter '"), os[S_NAME], cstr("': copy it into a local first, or pass it as an argument")))
		}
		ci = caps[VEC_LEN]
		vec_push(caps, os)
		os[S_ADDR] = 1
		if f[F_ESCAPES] != 0 {
			os[S_CELL] = 1
			os[S_KEPT_CAP] = 1
		}
	}
	if f == ck_fn {
		mut j = sc_syms[VEC_LEN] - 1
		for j >= 0 {
			let s = vec_get(sc_syms, j)
			if s[S_CAPTURED] != 0 && s[S_CAP_IDX] == ci {
				return s
			}
			j = j - 1
		}
		let cs = sym_new(SYM_LOCAL, os[S_NAME], os[S_POS])
		cs[S_TYPE] = os[S_TYPE]
		cs[S_CAPTURED] = 1
		cs[S_CAP_IDX] = ci
		cs[S_READS] = 1
		cs[S_SCOPE_AT] = os[S_SCOPE_AT]
		vec_push(sc_syms, cs)
		return cs
	}
	let cs = sym_new(SYM_LOCAL, os[S_NAME], os[S_POS])
	cs[S_TYPE] = os[S_TYPE]
	cs[S_CAPTURED] = 1
	cs[S_CAP_IDX] = ci
	cs[S_READS] = 1
	cs[S_SCOPE_AT] = os[S_SCOPE_AT]
	return cs
}

// lookup_name searches the open scopes innermost first, then outer closures, then this package, then the universe.
fn lookup_name(name i64) i64 {
	mut i = sc_syms[VEC_LEN] - 1
	for i >= 0 {
		let s = vec_get(sc_syms, i)
		if streq(s[S_NAME], name) != 0 {
			return s
		}
		i = i - 1
	}
	if ck_fn != 0 && ck_fn[F_PARENT] != 0 {
		let os = lookup_outer(ck_fn, name)
		if os != 0 {
			return capture_sym(ck_fn, os)
		}
	}
	if i64(load8(ck_pkg)) != 0 {
		let q = lookup_global(qual(ck_pkg, name))
		if q != 0 {
			return q
		}
	}
	return lookup_global(name)
}

fn push_scope() {
	vec_push(sc_marks, sc_syms[VEC_LEN])
}

fn pop_scope() {
	sc_syms[VEC_LEN] = vec_get(sc_marks, sc_marks[VEC_LEN] - 1)
	sc_marks[VEC_LEN] = sc_marks[VEC_LEN] - 1
}

fn check_scoped(b i64) {
	push_scope()
	check_stmts(b[BLK_STMTS])
	pop_scope()
}

fn check_stmts(stmts i64) {
	let narrowed = vec_new()
	mut i = 0
	for i < stmts[VEC_LEN] {
		let s = vec_get(stmts, i)
		check_stmt(s)
		// if x == nil { return } narrows x to non-nil for the rest of the block.
		if s[N_KIND] == ST_IF && s[IF_ELSE] == 0 && ends_in_jump(s[IF_THEN][BLK_STMTS]) != 0 {
			let nw = narrow_begin(s[IF_COND], 0)
			if nw != 0 {
				vec_push(narrowed, nw)
			}
		}
		i = i + 1
	}
	i = narrowed[VEC_LEN] - 1
	for i >= 0 {
		narrow_end(vec_get(narrowed, i))
		i = i - 1
	}
}

// ends_in_jump reports whether a block always leaves: return, break, continue, panic.
fn ends_in_jump(stmts i64) i64 {
	if stmts[VEC_LEN] == 0 {
		return 0
	}
	let last = vec_get(stmts, stmts[VEC_LEN] - 1)
	let k = last[N_KIND]
	return i64(k == ST_RETURN || k == ST_BREAK || k == ST_CONTINUE || k == ST_FAIL || ends_in_return(stmts) != 0)
}

fn replace_node(e i64, n i64) {
	mut i = 0
	for i < N_SIZE {
		e[i] = n[i]
		i = i + 1
	}
}

fn expr_clone(e i64) i64 {
	if e == 0 {
		return 0
	}
	let c = node_new(e[N_KIND], e[N_POS])
	replace_node(c, e)
	let k = e[N_KIND]
	if k == EX_UNARY {
		c[UN_X] = expr_clone(e[UN_X])
	} else if k == EX_BINARY {
		c[BIN_L] = expr_clone(e[BIN_L])
		c[BIN_R] = expr_clone(e[BIN_R])
	} else if k == EX_INDEX {
		c[IX_X] = expr_clone(e[IX_X])
		c[IX_I] = expr_clone(e[IX_I])
	} else if k == EX_CONV {
		c[CV_X] = expr_clone(e[CV_X])
	} else if k == EX_CALL {
		let args = vec_new()
		mut i = 0
		for i < e[CALL_ARGS][VEC_LEN] {
			vec_push(args, expr_clone(vec_get(e[CALL_ARGS], i)))
			i = i + 1
		}
		c[CALL_ARGS] = args
		c[CALL_CALLEE] = expr_clone(e[CALL_CALLEE])
	} else if k == EX_SELECT {
		c[SEL_X] = expr_clone(e[SEL_X])
	}
	return c
}

fn mk_int(pos i64, v i64, t i64) i64 {
	let n = node_new(EX_INT, pos)
	n[INT_VAL] = v
	n[N_TYPE] = t
	return n
}

fn mk_bin(pos i64, op i64, l i64, r i64, t i64) i64 {
	let b = binary_new(pos, op, l, r)
	b[N_TYPE] = t
	return b
}

fn mk_index(pos i64, x i64, i i64, t i64) i64 {
	let n = node_new(EX_INDEX, pos)
	n[IX_X] = x
	n[IX_I] = i
	n[N_TYPE] = t
	return n
}

// mk_hdr loads word k of a string, slice or map header (all are non-nil).
fn mk_hdr(pos i64, x i64, k i64) i64 {
	let n = node_new(EX_MEM, pos)
	n[MEM_BASE] = x
	n[MEM_OFF] = 8 * k
	n[MEM_HDR] = 1
	n[N_TYPE] = ty_int
	return n
}

fn mk_conv(pos i64, x i64, kind i64, t i64) i64 {
	let n = node_new(EX_CONV, pos)
	n[CV_X] = x
	n[CV_KIND] = kind
	n[N_TYPE] = t
	return n
}

const CV_SAME = 8 // retype only: same bits
const CV_ROUND32 = 10 // f64 value rounded to the nearest f32 (still in an f64 register)
const CV_F2BITS32 = 11 // f32 value (in an f64 register) to its 32-bit pattern
const CV_INT = 9 // integer to integer: truncate or extend to the target width
const CV_I2F = 1
const CV_F2I = 2
const CV_BITS2F = 3
const CV_F2BITS = 4
const CV_TOBYTE = 5
const CV_LEN = 6 // null-safe header word 0 (len of string, slice, map)
const CV_CAP = 7 // null-safe header word 1
const CV_DYN = 12 // concrete struct reference plus its (type, shape) table
const CV_DYN_KEEP = 13 // call the table's keep entry and preserve its table word
const CV_DYN_TABLE = 5 // registered table index for CV_DYN
const CV_DYN_OBJECT = 14 // the object word of a checked dyn value
const CV_DYN_DESC = 15 // a method descriptor loaded from a dyn value's table
const CV_DYN_INDEX = 7 // method slot in a CV_DYN_DESC table
const CV_DYN_TABLE_WORD = 16 // the table word of a checked dyn value

fn intrinsic_call(pos i64, name i64, args i64, t i64) i64 {
	let c = node_new(EX_CALL, pos)
	c[CALL_NAME] = name
	c[CALL_ARGS] = args
	c[CALL_INTRINSIC] = 1
	c[N_TYPE] = t
	return c
}

fn args1(a i64) i64 {
	let v = vec_new()
	vec_push(v, a)
	return v
}

fn args2(a i64, b i64) i64 {
	let v = args1(a)
	vec_push(v, b)
	return v
}

fn args3(a i64, b i64, c i64) i64 {
	let v = args2(a, b)
	vec_push(v, c)
	return v
}

fn args4(a i64, b i64, c i64, d i64) i64 {
	let v = args3(a, b, c)
	vec_push(v, d)
	return v
}

fn args5(a i64, b i64, c i64, d i64, f i64) i64 {
	let v = args4(a, b, c, d)
	vec_push(v, f)
	return v
}

fn mk_load8(pos i64, addr i64) i64 {
	return intrinsic_call(pos, cstr("load8"), args1(addr), ty_byte)
}

// rt_call calls a runtime function by name; the runtime is loaded for every v2 program.
fn rt_call(pos i64, name i64, args i64, t i64) i64 {
	let f = find_fn(name)
	if f == 0 {
		err_code_quoted(pos, cstr("E990 INTERNAL"), cstr("runtime function "), name, cstr(" is missing (is lib/runtime.tin loaded?)"))
	}
	let c = node_new(EX_CALL, pos)
	c[CALL_NAME] = name
	c[CALL_ARGS] = args
	c[CALL_FN] = f
	c[N_TYPE] = t
	return c
}

fn sym_ref_node(pos i64, s i64) i64 {
	let n = node_new(EX_IDENT, pos)
	n[ID_NAME] = s[S_NAME]
	n[ID_REF] = s
	n[N_TYPE] = s[S_TYPE]
	return n
}

fn expr_stmt(e i64) i64 {
	let s = node_new(ST_EXPR, e[N_POS])
	s[ES_X] = e
	return s
}

fn let_stmt(pos i64, s i64, init i64) i64 {
	let l = node_new(ST_LET, pos)
	l[LET_NAME] = s[S_NAME]
	l[LET_INIT] = init
	l[LET_SYM] = s
	return l
}

fn assign_stmt(pos i64, target i64, value i64) i64 {
	let a = node_new(ST_ASSIGN, pos)
	a[AS_TARGET] = target
	a[AS_VALUE] = value
	return a
}

// temp declares a hidden local holding init (already checked) and returns its let.
fn temp(pos i64, init i64, t i64) i64 {
	let s = declare_local(pos, cstr("$"), t)
	return let_stmt(pos, s, init)
}

fn mk_seq(pos i64, stmts i64, value i64, t i64) i64 {
	let n = node_new(EX_SEQ, pos)
	n[SEQ_STMTS] = stmts
	n[SEQ_VALUE] = value
	n[N_TYPE] = t
	return n
}

fn mk_unary(pos i64, op i64, x i64) i64 {
	let u = node_new(EX_UNARY, pos)
	u[UN_OP] = op
	u[UN_X] = x
	u[N_TYPE] = ty_int
	return u
}

// zero_value is the value a declaration without initializer starts with. Strings and
// slices start empty (static objects, never nil); structs, maps and funcs have none.
fn zero_value(pos i64, t i64) i64 {
	let k = kind_of(t)
	if is_float_t(t) != 0 {
		let f = node_new(EX_FLOAT, pos)
		f[N_TYPE] = ty_float
		return f
	}
	if k == K_STRING {
		return lit_string(pos, cstr(""))
	}
	if k == K_SLICE {
		if ck_legacy != 0 {
			return intrinsic_call(pos, cstr("__empty"), vec_new(), t)
		}
		// A real header, made in the current region, so append never has to pick one.
		return rt_call(pos, cstr("rt_slice_make"), args3(mk_int(pos, 0, ty_int), mk_int(pos, 0, ty_int), mk_int(pos, elem_size(t), ty_int)), t)
	}
	if (k == K_STRUCT || k == K_MAP || k == K_FUNC || k == K_DYN) && ck_legacy == 0 {
		err_code_type(pos, cstr("E203 NO_ZERO_VALUE"), cstr("a variable of type "), t, cstr(" needs an initializer (it cannot be nil; use ?T for an optional)"))
	}
	return mk_int(pos, 0, t)
}

fn to_bits(e i64) i64 {
	if is_float_t(e[N_TYPE]) != 0 {
		return mk_conv(e[N_POS], e, CV_F2BITS, ty_int)
	}
	return e
}

fn from_bits(e i64, t i64) i64 {
	if is_float_t(t) != 0 {
		return mk_conv(e[N_POS], e, CV_BITS2F, t)
	}
	e[N_TYPE] = t
	return e
}

// ---- statements ----
fn check_stmt(s i64) {
	// A mut argument or a call through a closure can change a captured slice header.
	// Clear cached len aliases before proving any later indexed access safe.
	if stmt_may_change_slice(s, cstr("")) != 0 {
		len_aliases = vec_new()
	}
	let k = s[N_KIND]
	if k == ST_CONST {
		check_local_consts(s)
	} else if k == ST_LET {
		check_let(s)
	} else if k == ST_ASSIGN {
		check_assign(s)
	} else if k == ST_MULTI {
		check_multi(s)
	} else if k == ST_FAIL {
		check_fail(s)
	} else if k == ST_EXPR {
		let x = s[ES_X]
		if (x[N_KIND] == EX_TRY || x[N_KIND] == EX_CATCH || x[N_KIND] == EX_WRAP) && ck_legacy == 0 {
			lower_try_stmt(s, x, 0, 0)
			return
		}
		if x[N_KIND] == EX_MATCH && ck_legacy == 0 {
			lower_match_stmt(s, x)
			return
		}
		let t = chk(x, 0)
		if ck_legacy == 0 && (kind_of(t) == K_ERROR || (kind_of(t) == K_TUPLE && kind_of(vec_get(t[TY_FIELDS], t[TY_FIELDS][VEC_LEN] - 1)) == K_ERROR)) {
			err_code_at(s[N_POS], cstr("E410 UNCHECKED_FAULT"), cstr("the fault this call returns is ignored (check it, or use try)"))
		}
		if kind_of(t) == K_TUPLE && x[N_KIND] == EX_CALL {
			x[N_TYPE] = ty_void
		}
	} else if k == ST_IF {
		if s[IF_INIT] != 0 {
			lower_with_init(s, IF_INIT)
			return
		}
		check_cond(s[IF_COND])
		let narrowed = narrow_begin(s[IF_COND], 1)
		let saved = vec_len_of(safe_pairs)
		add_len_fact(s[IF_COND], s[IF_THEN])
		check_scoped(s[IF_THEN])
		safe_pairs[VEC_LEN] = saved
		narrow_end(narrowed)
		let els = s[IF_ELSE]
		if els != 0 {
			let narrowed2 = narrow_begin(s[IF_COND], 0)
			if els[N_KIND] == ST_BLOCK {
				check_scoped(els)
			} else {
				check_stmt(els)
			}
			narrow_end(narrowed2)
		}
	} else if k == ST_WHILE {
		if s[WH_INIT] != 0 {
			lower_for_init(s)
			return
		}
		check_cond(s[WH_COND])
		ck_loops = ck_loops + 1
		ck_breaks = ck_breaks + 1
		check_scoped(s[WH_BODY])
		if s[WH_POST] != 0 {
			push_scope()
			check_stmt(s[WH_POST])
			pop_scope()
		}
		ck_loops = ck_loops - 1
		ck_breaks = ck_breaks - 1
	} else if k == ST_RANGE {
		lower_range(s)
	} else if k == ST_SWITCH {
		lower_switch(s)
	} else if k == ST_RETURN {
		check_return(s)
	} else if k == ST_BREAK {
		if ck_breaks == 0 {
			err_code_at(s[N_POS], cstr("E261 OUTSIDE_LOOP"), cstr("break outside a loop"))
		}
	} else if k == ST_CONTINUE {
		if ck_loops == 0 {
			err_code_at(s[N_POS], cstr("E261 OUTSIDE_LOOP"), cstr("continue outside a loop"))
		}
	} else if k == ST_BLOCK && s[BLK_FLAT] != 0 {
		check_stmts(s[BLK_STMTS])
	} else if k == ST_BLOCK {
		check_scoped(s)
	} else if k == ST_GO {
		if ck_legacy == 0 {
			err_code_at(s[N_POS], cstr("E602 GO"), cstr("go is not allowed: cores share nothing (run work per core with hearth, talk across cores with relay)"))
		} else {
			lower_go(s)
		}
	} else if k == ST_ONCE {
		lower_once(s)
	} else if k == ST_SCOPE {
		lower_scope(s)
	} else if k == ST_DETACH {
		lower_detach(s)
	} else if k == ST_SELECT {
		lower_select(s)
	} else if k == ST_USE {
		lower_use(s)
	} else if k == ST_DEFER {
		lower_defer(s)
	} else if k == ST_BSTORE {
		check_bstore(s)
	} else if k == ST_MSTORE {
		check_mstore(s)
	}
}

// check_bstore checks the last expression of a boundary block's closure and stores its value
// through the closure's parameter $r; bound_t records its type (ty_void: no value).
fn check_bstore(s i64) {
	let pos = s[N_POS]
	let x = s[ES_X]
	if x[N_KIND] == EX_TRY || x[N_KIND] == EX_CATCH || x[N_KIND] == EX_WRAP {
		lower_try_stmt(s, x, 5, 0)
		return
	}
	if x[N_KIND] == EX_MATCH {
		check_match_tail(s, x)
		return
	}
	mut t = chk(x, 0)
	if kind_of(t) == K_VOID {
		bound_t = ty_void
		replace_node(s, expr_stmt(x))
		return
	}
	// A last call that can fail is a statement like any other: its fault must be handled, not
	// become the block's value (#233: an inner within's deadline was lost that way).
	if kind_of(t) == K_ERROR || (kind_of(t) == K_TUPLE && kind_of(vec_get(t[TY_FIELDS], t[TY_FIELDS][VEC_LEN] - 1)) == K_ERROR) {
		err_code_at(pos, cstr("E410 UNCHECKED_FAULT"), cstr("the fault this call returns is ignored (check it, or use try)"))
		bound_t = ty_void
		if kind_of(t) == K_TUPLE && t[TY_FIELDS][VEC_LEN] == 2 {
			bound_t = vec_get(t[TY_FIELDS], 0)
		}
		replace_node(s, expr_stmt(x))
		return
	}
	if is_untyped(t) != 0 {
		t = default_type(t)
		reconvert(x, t)
	}
	bound_t = t
	replace_node(s, bound_store(pos, x, t))
}

shared mut bound_t i64 // the value type of the boundary block being checked

// bound_store writes v (of type t) through the boundary closure's parameter $r.
fn bound_store(pos i64, v i64, t i64) i64 {
	let r = vec_get(ck_fn[F_LOCALS], 0)
	return assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, r), 0, 0, 0, t), v)
}

// Constants become literals at their uses and require no stack slot or runtime work.
fn check_local_consts(stmt i64) {
	let decls = stmt[2]
	mut i = 0
	for i < decls[VEC_LEN] {
		mut start = i
		let pos = vec_get(decls, i)[D_POS]
		// Names in one specification enter scope together, after all initializers.
		for i < decls[VEC_LEN] && vec_get(decls, i)[D_POS] == pos {
			let d = vec_get(decls, i)
			let s = sym_new(SYM_CONST, d[D_NAME], d[D_POS])
			s[S_DECL] = d
			d[D_SYM] = s
			check_const_value(d)
			i = i + 1
		}
		for start < i {
			let d = vec_get(decls, start)
			if streq(d[D_NAME], cstr("_")) == 0 {
				declare_scoped(d[D_SYM])
			}
			start = start + 1
		}
	}
	replace_node(stmt, empty_block(stmt[N_POS]))
}

// ---- once (#236) ----
//
// once { body } is if rt_once(N) { body }: the block runs the first time each core reaches it
// (globals are per core, so this is the unit that matters; app-wide work is on app.start).
shared mut once_seq i64

fn lower_once(s i64) {
	let pos = s[N_POS]
	once_seq = once_seq + 1
	let c = node_new(EX_CALL, pos)
	c[CALL_NAME] = cstr("rt_once")
	c[CALL_ARGS] = vec_new()
	let n = node_new(EX_INT, pos)
	n[INT_VAL] = once_seq
	vec_push(c[CALL_ARGS], n)
	let ifs = node_new(ST_IF, pos)
	ifs[IF_COND] = c
	ifs[IF_THEN] = s[BODY_BLOCK]
	replace_node(s, ifs)
	check_stmt(s)
}

// ---- scope (#232) ----
//
// scope s { body } is { let s = rt_scope_open(); { body }; try rt_scope_close(s) }: the
// scope's end waits for its children and leaves with the first child's fault.
fn lower_scope(s i64) {
	let pos = s[N_POS]
	let name = s[SCOPE_NAME]
	let body = s[SCOPE_BODY]
	let b = empty_block(pos)
	let l = node_new(ST_LET, pos)
	l[LET_NAME] = name
	let open = node_new(EX_CALL, pos)
	open[CALL_ARGS] = vec_new()
	open[CALL_NAME] = cstr("rt_scope_open")
	l[LET_INIT] = open
	vec_push(b[BLK_STMTS], l)
	vec_push(b[BLK_STMTS], s[SCOPE_BODY])
	let close = node_new(EX_CALL, pos)
	close[CALL_NAME] = cstr("rt_scope_close")
	let id = node_new(EX_IDENT, pos)
	id[ID_NAME] = name
	close[CALL_ARGS] = vec_new()
	vec_push(close[CALL_ARGS], id)
	let tr = node_new(EX_TRY, pos)
	tr[TRY_X] = close
	vec_push(b[BLK_STMTS], expr_stmt(tr))
	replace_node(s, b)
	ck_scope_depth = ck_scope_depth + 1
	check_scoped(s)
	ck_scope_depth = ck_scope_depth - 1
	if l[LET_SYM] != 0 {
		scope_exits(body[BLK_STMTS], l[LET_SYM])
	}
}

// scope_exits makes every return out of a scope body (a try's fault is one) leave the scope
// first: its value is computed, rt_scope_exit cancels and joins the children and leaves the
// boundary, then it returns. An inner scope's exits come first, as they were made first.
fn scope_exits(v i64, sc i64) {
	mut i = 0
	for i < v[VEC_LEN] {
		scope_exit_stmt(vec_get(v, i), sc)
		i = i + 1
	}
}

fn scope_exit_stmt(s i64, sc i64) {
	let k = s[N_KIND]
	if k == ST_BLOCK {
		scope_exits(s[BLK_STMTS], sc)
	} else if k == ST_IF {
		scope_exits(s[IF_THEN][BLK_STMTS], sc)
		if s[IF_ELSE] != 0 {
			scope_exit_stmt(s[IF_ELSE], sc)
		}
	} else if k == ST_WHILE {
		scope_exits(s[WH_BODY][BLK_STMTS], sc)
	} else if k == ST_RETURN {
		let pos = s[N_POS]
		let b = empty_block(pos)
		b[BLK_FLAT] = 1
		let r = node_new(ST_RETURN, pos)
		if s[RET_VALUE] != 0 {
			let t = temp(pos, s[RET_VALUE], s[RET_VALUE][N_TYPE])
			vec_push(b[BLK_STMTS], t)
			r[RET_VALUE] = sym_ref_node(pos, t[LET_SYM])
		}
		if s[RET_VALUES] != 0 {
			let vals = vec_new()
			mut i = 0
			for i < s[RET_VALUES][VEC_LEN] {
				let rv = vec_get(s[RET_VALUES], i)
				let t2 = temp(pos, rv, rv[N_TYPE])
				vec_push(b[BLK_STMTS], t2)
				vec_push(vals, sym_ref_node(pos, t2[LET_SYM]))
				i = i + 1
			}
			r[RET_VALUES] = vals
		}
		vec_push(b[BLK_STMTS], expr_stmt(rt_call(pos, cstr("rt_scope_exit"), args1(sym_ref_node(pos, sc)), ty_void)))
		vec_push(b[BLK_STMTS], r)
		replace_node(s, b)
	}
}

// detach { body } is rt_detach(keep(fn() ! { body })): a task in the core's background
// boundary, outliving the request, so everything it captures is copied to the long-lived heap.
// What it captures must already be long-lived (design_semantics §6): the region pass reports a
// capture that may hold request memory unless the block reads it only inside keep()
// (rg_detach_check), and the checker any task handle or scope (sb_captures).
shared mut ck_detached i64 // the closures detach blocks became

fn lower_detach(s i64) {
	let pos = s[N_POS]
	let f = fn_new(pos, cstr("func"))
	if ck_detached == 0 {
		ck_detached = vec_new()
	}
	vec_push(ck_detached, f)
	let ft = node_new(TX_NAME, pos)
	ft[TX_B] = cstr("fault")
	vec_push(f[F_RTYPES], ft)
	f[F_BANG] = 1
	f[F_BODY] = s[BODY_BLOCK]
	let lit = node_new(EX_FUNCLIT, pos)
	lit[LIT_FN] = f
	lit[LIT_ESCAPE] = 1
	let kc = node_new(EX_CALL, pos)
	kc[CALL_NAME] = cstr("keep")
	kc[CALL_ARGS] = vec_new()
	vec_push(kc[CALL_ARGS], lit)
	let dc = node_new(EX_CALL, pos)
	dc[CALL_NAME] = cstr("rt_detach")
	dc[CALL_ARGS] = vec_new()
	vec_push(dc[CALL_ARGS], kc)
	replace_node(s, expr_stmt(dc))
	check_stmt(s)
}

// detach_fn is a stand-in for the closure a detach block becomes, for the capture scan.
fn detach_fn(s i64) i64 {
	let f = fn_new(s[N_POS], cstr("func"))
	f[F_BODY] = s[BODY_BLOCK]
	return f
}

// ---- use and on: resources and lifecycle events (#238) ----
//
// on EVENT { body } becomes a function on$N() ! { body }. A package-level use x = e is a
// per-core global whose initializer opens it on cores only (not helper threads), a fault
// ending startup, and a function use$stop$N() ! { try x.Close() }. __start registers both
// with rt_life_add in declaration order and runs the start events before main and the stop
// events after it (rt_life_start, rt_life_stop); the runtime runs a core's own around its
// entry. A function-level use x = e is let x = try e and a deferred use$close$N(x, cell)
// whose fault every return joins into the function's fault (rt_use_take).
const LIFE_APP_START = 1
const LIFE_APP_STOP = 2
const LIFE_CORE_START = 3
const LIFE_CORE_STOP = 4
const LIFE_USE_CLOSE = 5
const LIFE_OVERLOAD = 6
const LIFE_RECOVERED = 7

shared mut life_regs i64 // [kind, function, label] for each handler and package-level use
shared mut use_cells i64 // [function, cell local] for each function with a function-level use

fn life_name(prefix i64, i i64) i64 {
	let nb = buf_new()
	buf_str(nb, prefix)
	buf_int(nb, i)
	buf_byte(nb, 0)
	return nb[VEC_DATA]
}

// life_event is the kind of an event expression (app.start ...), or 0 after an error.
fn life_event(e i64) i64 {
	if e[N_KIND] == EX_SELECT && e[SEL_X][N_KIND] == EX_IDENT {
		let a = e[SEL_X][ID_NAME]
		let b = e[SEL_NAME]
		if streq(a, cstr("app")) != 0 && streq(b, cstr("start")) != 0 {
			return LIFE_APP_START
		}
		if streq(a, cstr("app")) != 0 && streq(b, cstr("stop")) != 0 {
			return LIFE_APP_STOP
		}
		if streq(a, cstr("core")) != 0 && streq(b, cstr("start")) != 0 {
			return LIFE_CORE_START
		}
		if streq(a, cstr("core")) != 0 && streq(b, cstr("stop")) != 0 {
			return LIFE_CORE_STOP
		}
		if streq(a, cstr("server")) != 0 && streq(b, cstr("overload")) != 0 {
			return LIFE_OVERLOAD
		}
		if streq(a, cstr("server")) != 0 && streq(b, cstr("recovered")) != 0 {
			return LIFE_RECOVERED
		}
	}
	err_code_at(e[N_POS], cstr("E610 UNKNOWN_EVENT"), cstr("unknown event: on takes app.start, app.stop, core.start, core.stop, server.overload or server.recovered"))
	return 0
}

// life_fn declares a lifecycle function NAME() ! { body } of file.
fn life_fn(pos i64, file i64, name i64, body i64) i64 {
	let f = fn_new(pos, name)
	f[F_FILE] = file
	let ft = node_new(TX_NAME, pos)
	ft[TX_B] = cstr("fault")
	vec_push(f[F_RTYPES], ft)
	f[F_BANG] = 1
	f[F_BODY] = body
	vec_push(prog_fns, f)
	return f
}

fn life_reg(kind i64, f i64, label i64) {
	let r = vec_new()
	vec_push(r, kind)
	vec_push(r, f)
	vec_push(r, label)
	vec_push(life_regs, r)
}

// lifecycle_decls makes the functions of on handlers and package-level use closes, before
// functions are declared.
fn lifecycle_decls() {
	life_regs = vec_new()
	use_cells = vec_new()
	mut i = 0
	for i < prog_ons[VEC_LEN] {
		let on_ = vec_get(prog_ons, i)
		set_file(on_[ON_FILE])
		let kind = life_event(on_[ON_EVENT])
		if kind != 0 {
			let f = life_fn(on_[N_POS], on_[ON_FILE], life_name(cstr("on$"), i), on_[ON_BODY])
			let e = on_[ON_EVENT]
			life_reg(kind, f, str_cat3(cstr("on "), str_cat3(e[SEL_X][ID_NAME], cstr("."), e[SEL_NAME]), cstr("")))
		}
		i = i + 1
	}
	i = 0
	for i < prog_uses[VEC_LEN] {
		let u = vec_get(prog_uses, i)
		let pos = u[N_POS]
		let x = node_new(EX_SELECT, pos)
		x[SEL_X] = node_new(EX_IDENT, pos)
		x[SEL_X][ID_NAME] = u[USE_NAME]
		x[SEL_NAME] = cstr("Close")
		let c = node_new(EX_CALL, pos)
		c[CALL_CALLEE] = x
		c[CALL_ARGS] = vec_new()
		let tr = node_new(EX_TRY, pos)
		tr[TRY_X] = c
		let body = empty_block(pos)
		vec_push(body[BLK_STMTS], expr_stmt(tr))
		let f = life_fn(pos, u[USE_FILE], life_name(cstr("use$stop$"), i), body)
		u[USE_STOP] = f
		life_reg(LIFE_USE_CLOSE, f, str_cat3(cstr("use "), u[USE_NAME], cstr("")))
		i = i + 1
	}
}

// use_global_of is the package-level use whose global v is, or 0.
fn use_global_of(v i64) i64 {
	if prog_uses == 0 {
		return 0
	}
	mut i = 0
	for i < prog_uses[VEC_LEN] {
		let u = vec_get(prog_uses, i)
		if u[USE_DECL] == v {
			return u
		}
		i = i + 1
	}
	return 0
}

// use_resource is T for a use initializer of type !T (else 0, reported).
fn use_resource(pos i64, t i64) i64 {
	if kind_of(t) == K_TUPLE && t[TY_FIELDS][VEC_LEN] == 2 && kind_of(vec_get(t[TY_FIELDS], 1)) == K_ERROR {
		return vec_get(t[TY_FIELDS], 0)
	}
	err_code_at(pos, cstr("E620 USE_RESOURCE"), cstr("use needs a call that opens a resource and can fail (a function returning !T)"))
	return 0
}

// use_check_close reports whether rt satisfies shape Resource { Close() ! }.
fn use_check_close(pos i64, rt i64) i64 {
	if kind_of(rt) == K_DYN {
		return 1
	}
	let m = shape_method(rt, cstr("Close"))
	if m == 0 {
		err_code_type(pos, cstr("E620 USE_RESOURCE"), cstr("use needs a resource: "), rt, cstr(" has no method Close() !"))
		return 0
	}
	if sm_declared != 0 && (m[F_PARAMS][VEC_LEN] != 1 || m[F_RTYPES][VEC_LEN] != 1 || kind_of(vec_get(m[F_RTYPES], 0)) != K_ERROR) {
		err_code_type(pos, cstr("E620 USE_RESOURCE"), cstr("use needs a resource: the Close method of "), rt, cstr(" must take nothing and return a fault (Close() !)"))
		return 0
	}
	return 1
}

// check_use_global types package-level use x = e: x = { $v; if rt_life_here() { $v, $f = e;
// if $f != nil { rt_use_fail("use x", $f) } }; $v } in the core's initializer.
fn check_use_global(v i64, s i64, u i64) {
	let pos = v[D_POS]
	let e = v[D_INIT]
	start_scope()
	ck_fn = core_fn
	let t = chk(e, 0)
	mut rt = use_resource(pos, t)
	s[S_TYPE] = ty_int
	if s[S_TLS] == 0 {
		err_code_at(pos, cstr("E092 NEWER_SYNTAX"), cstr("a package-level use is per core: it needs an edition 1 file"))
		rt = 0
	}
	if rt == 0 || use_check_close(pos, rt) == 0 {
		u[USE_STOP][F_BODY][BLK_STMTS][VEC_LEN] = 0
		return
	}
	s[S_TYPE] = rt
	let vs = declare_local(pos, cstr("$"), rt)
	let fs = declare_local(pos, cstr("$"), ty_error)
	fs[S_READS] = 1
	mut zero = mk_int(pos, 0, rt)
	if is_float_t(rt) != 0 {
		zero = zero_value(pos, rt)
	}
	let stmts = vec_new()
	vec_push(stmts, let_stmt(pos, vs, zero))
	let cm = node_new(ST_CALLMULTI, pos)
	cm[CM_CALL] = e
	cm[CM_SYMS] = vec_new()
	vec_push(cm[CM_SYMS], vs)
	vec_push(cm[CM_SYMS], fs)
	e[N_TYPE] = ty_void
	let failed = node_new(ST_IF, pos)
	failed[IF_COND] = mk_bin(pos, cstr("!="), sym_ref_node(pos, fs), mk_int(pos, 0, ty_error), ty_bool)
	failed[IF_THEN] = empty_block(pos)
	let label = lit_string(pos, str_cat3(cstr("use "), v[D_NAME], cstr("")))
	vec_push(failed[IF_THEN][BLK_STMTS], expr_stmt(rt_call(pos, cstr("rt_use_fail"), args2(label, sym_ref_node(pos, fs)), ty_void)))
	let here = node_new(ST_IF, pos)
	here[IF_COND] = rt_call(pos, cstr("rt_life_here"), vec_new(), ty_bool)
	here[IF_THEN] = empty_block(pos)
	vec_push(here[IF_THEN][BLK_STMTS], cm)
	vec_push(here[IF_THEN][BLK_STMTS], failed)
	vec_push(stmts, here)
	let target = node_new(EX_IDENT, pos)
	target[ID_NAME] = s[S_NAME]
	target[ID_REF] = s
	target[N_TYPE] = rt
	let a = node_new(ST_ASSIGN, pos)
	a[AS_TARGET] = target
	a[AS_VALUE] = mk_seq(pos, stmts, sym_ref_node(pos, vs), rt)
	s[S_UNINIT] = 1
	vec_push(core_stmts, a)
}

// lower_use lowers a function-level use x = e (see the section comment).
fn lower_use(s i64) {
	let pos = s[N_POS]
	if ck_legacy != 0 {
		err_code_at(pos, cstr("E092 NEWER_SYNTAX"), cstr("use needs edition 1"))
		return
	}
	if ck_loops > 0 {
		err_code_at(pos, cstr("E621 USE_PLACEMENT"), cstr("use inside a loop would close once per function, not per iteration: move the loop body into a function"))
		return
	}
	let frs = ck_fn[F_RTYPES]
	if frs[VEC_LEN] == 0 || kind_of(vec_get(frs, frs[VEC_LEN] - 1)) != K_ERROR {
		err_code_at(pos, cstr("E411 NO_FAULT_RESULT"), cstr("use needs the enclosing function to return a fault (write its result as !T): opening and closing a resource can fail"))
		return
	}
	let name = s[USE_NAME]
	let tr = node_new(EX_TRY, pos)
	tr[TRY_X] = s[USE_INIT]
	let l = node_new(ST_LET, pos)
	l[LET_NAME] = name
	l[LET_INIT] = tr
	let out = empty_block(pos)
	out[BLK_FLAT] = 1
	vec_push(out[BLK_STMTS], l)
	replace_node(s, out)
	let before = ck_fn[F_LOCALS][VEC_LEN]
	check_stmt(l)
	let xs = lookup_name_local(name)
	if xs == 0 || vec_index(ck_fn[F_LOCALS], xs) < before {
		return
	}
	let rt = xs[S_TYPE]
	if use_check_close(pos, rt) == 0 {
		return
	}
	let cf = use_close_fn(pos, rt)
	if cf == 0 {
		return
	}
	let xa = node_new(EX_IDENT, pos)
	xa[ID_NAME] = name
	chk(xa, 0)
	let call = node_new(EX_CALL, pos)
	call[CALL_NAME] = cf[F_NAME]
	call[CALL_FN] = cf
	call[CALL_ARGS] = args2(xa, sym_ref_node(pos, use_cell(pos)))
	call[N_TYPE] = ty_void
	// As lower_defer, for a call already checked.
	let b = empty_block(pos)
	b[BLK_FLAT] = 1
	let args = call[CALL_ARGS]
	mut i = 0
	for i < args[VEC_LEN] {
		let a = vec_get(args, i)
		let at = temp(pos, a, a[N_TYPE])
		vec_push(b[BLK_STMTS], at)
		args[VEC_DATA][i] = sym_ref_node(pos, at[LET_SYM])
		i = i + 1
	}
	let flag = declare_local(pos, cstr("$"), ty_bool)
	if ck_defers == 0 {
		ck_defers = vec_new()
		ck_defer_mark = declare_local(pos, cstr("$"), ty_int)
	}
	defer_record(pos, b, call)
	vec_push(ck_defers, pair(flag, call))
	vec_push(out[BLK_STMTS], b)
}

// use_close_fn builds use$close$N($r T, $c i64) { rt_use_note($c, $r.Close()) }.
fn use_close_fn(pos i64, rt i64) i64 {
	lifted_count = lifted_count + 1
	let name = life_name(cstr("use$close$"), lifted_count)
	let f = fn_new(pos, name)
	f[F_QNAME] = name
	f[F_LIFTED] = 2
	f[F_DONE] = 1
	f[F_FILE] = ck_fn[F_FILE]
	vec_push(f[F_PARAMS], cstr("$r"))
	vec_push(f[F_PARAMS], cstr("$c"))
	vec_push(f[F_PTYPES], rt)
	vec_push(f[F_PTYPES], ty_int)
	vec_push(f[F_MUTS], mut_capable(rt))
	vec_push(f[F_MUTS], 0)
	f[F_TYPE] = func_of(f[F_PTYPES], f[F_RTYPES], 0)
	f[F_LOCALS] = vec_new()
	f[F_SLOTS] = 0
	let saved = ck_fn
	ck_fn = f
	push_scope()
	let rs = declare_local(pos, cstr("$r"), rt)
	rs[S_READS] = 1
	rs[S_MUT] = mut_capable(rt)
	let cs = declare_local(pos, cstr("$c"), ty_int)
	cs[S_READS] = 1
	let x = node_new(EX_SELECT, pos)
	x[SEL_X] = node_new(EX_IDENT, pos)
	x[SEL_X][ID_NAME] = cstr("$r")
	x[SEL_NAME] = cstr("Close")
	let c = node_new(EX_CALL, pos)
	c[CALL_CALLEE] = x
	c[CALL_ARGS] = vec_new()
	let t = chk(c, 0)
	pop_scope()
	ck_fn = saved
	if kind_of(t) != K_ERROR {
		err_code_type(pos, cstr("E620 USE_RESOURCE"), cstr("use needs a resource: the Close method of "), rt, cstr(" must return a fault (Close() !)"))
		return 0
	}
	f[F_BODY] = empty_block(pos)
	vec_push(f[F_BODY][BLK_STMTS], expr_stmt(rt_call(pos, cstr("rt_use_note"), args2(sym_ref_node(pos, cs), c), ty_void)))
	vec_push(prog_fns, f)
	return f
}

// use_cell_of is the cell local of function f's uses, or 0.
fn use_cell_of(f i64) i64 {
	if use_cells == 0 {
		return 0
	}
	mut i = 0
	for i < use_cells[VEC_LEN] {
		let p = vec_get(use_cells, i)
		if vec_get(p, 0) == f {
			return vec_get(p, 1)
		}
		i = i + 1
	}
	return 0
}

fn use_cell(pos i64) i64 {
	mut c = use_cell_of(ck_fn)
	if c == 0 {
		c = declare_local(pos, cstr("$uc"), ty_int)
		c[S_READS] = 1
		vec_push(use_cells, pair(ck_fn, c))
	}
	return c
}

// use_cell_init starts function f with its cell (finish_defers).
fn use_cell_init(f i64, init i64) {
	let c = use_cell_of(f)
	if c != 0 {
		vec_push(init, let_stmt(f[F_POS], c, rt_call(f[F_POS], cstr("rt_use_cell"), vec_new(), ty_int)))
	}
}

// use_return makes return r (in block b, after the deferred calls ran) return the faults the
// closes gave, joined after the function's own (defer_stmt).
fn use_return(pos i64, b i64, r i64) {
	let c = use_cell_of(ck_fn)
	if c == 0 {
		return
	}
	mut old = r[RET_VALUE]
	if r[RET_VALUES] != 0 {
		old = vec_get(r[RET_VALUES], r[RET_VALUES][VEC_LEN] - 1)
	}
	let cf = temp(pos, rt_call(pos, cstr("rt_use_take"), args1(sym_ref_node(pos, c)), ty_error), ty_error)
	cf[LET_SYM][S_READS] = 1
	vec_push(b[BLK_STMTS], cf)
	mut prev = mk_int(pos, 0, ty_error)
	if old != 0 && old[N_KIND] == EX_IDENT && old[ID_REF] != 0 {
		prev = sym_ref_node(pos, old[ID_REF])
	}
	let ifs = node_new(ST_IF, pos)
	ifs[IF_COND] = mk_bin(pos, cstr("!="), sym_ref_node(pos, cf[LET_SYM]), mk_int(pos, 0, ty_error), ty_bool)
	ifs[IF_THEN] = empty_block(pos)
	let joined = rt_call(pos, cstr("rt_use_join"), args2(prev, sym_ref_node(pos, cf[LET_SYM])), ty_error)
	vec_push(ifs[IF_THEN][BLK_STMTS], fault_return(pos, ifs[IF_THEN][BLK_STMTS], joined))
	vec_push(b[BLK_STMTS], ifs)
}

// life_start registers the handlers and closes, then runs the start events (make_start).
fn life_start(pos i64, body i64) {
	if life_regs == 0 || life_regs[VEC_LEN] == 0 {
		return
	}
	mut i = 0
	for i < life_regs[VEC_LEN] {
		let r = vec_get(life_regs, i)
		let f = vec_get(r, 1)
		let ref_ = node_new(EX_FUNCREF, pos)
		ref_[FR_FN] = f
		ref_[N_TYPE] = f[F_TYPE]
		let args = args3(mk_int(pos, vec_get(r, 0), ty_int), ref_, lit_string(pos, vec_get(r, 2)))
		vec_push(body[BLK_STMTS], expr_stmt(rt_call(pos, cstr("rt_life_add"), args, ty_void)))
		i = i + 1
	}
	vec_push(body[BLK_STMTS], expr_stmt(rt_call(pos, cstr("rt_life_start"), vec_new(), ty_void)))
}

// life_stop runs the stop events after main returns (make_start).
fn life_stop(pos i64, body i64) {
	if life_regs != 0 && life_regs[VEC_LEN] > 0 {
		vec_push(body[BLK_STMTS], expr_stmt(rt_call(pos, cstr("rt_life_stop"), vec_new(), ty_void)))
	}
}

// mark_spawns keeps the closures passed to s.spawn inside scope s on the parent's frame (the
// scope outlives its children, as for sift.Each), before captures are scanned.
fn mark_spawns(v i64, names i64) {
	mut i = 0
	for i < v[VEC_LEN] {
		let s = vec_get(v, i)
		let k = s[N_KIND]
		if k == ST_SCOPE {
			let inner = vec_clone(names)
			vec_push(inner, s[SCOPE_NAME])
			mark_spawns(s[SCOPE_BODY][BLK_STMTS], inner)
		} else if k == ST_BLOCK {
			mark_spawns(s[BLK_STMTS], names)
		} else if k == ST_IF {
			mark_spawns(s[IF_THEN][BLK_STMTS], names)
			if s[IF_ELSE] != 0 {
				let ev = vec_new()
				vec_push(ev, s[IF_ELSE])
				mark_spawns(ev, names)
			}
		} else if k == ST_WHILE {
			mark_spawns(s[WH_BODY][BLK_STMTS], names)
		} else if k == ST_RANGE {
			mark_spawns(s[RG_BODY][BLK_STMTS], names)
		} else if mt_stmt_expr(s) != 0 && mt_stmt_expr(s)[N_KIND] == EX_MATCH {
			let arms = mt_stmt_expr(s)[MATCH_ARMS]
			mut ai = 0
			for ai < arms[VEC_LEN] {
				let arm = vec_get(arms, ai)
				if vec_get(arm, ARM_BLOCK) != 0 {
					mark_spawns(vec_get(arm, ARM_BODY)[BLK_STMTS], names)
				} else {
					mark_spawn_call(vec_get(arm, ARM_BODY), names)
				}
				ai = ai + 1
			}
		} else if k == ST_EXPR {
			mark_spawn_call(s[ES_X], names)
		} else if k == ST_LET {
			mark_spawn_call(s[LET_INIT], names)
		}
		i = i + 1
	}
}

fn mark_spawn_call(e_in i64, names i64) {
	mut e = e_in
	if e == 0 || names[VEC_LEN] == 0 {
		return
	}
	if e[N_KIND] == EX_TRY {
		e = e[TRY_X]
	}
	if e[N_KIND] != EX_CALL || e[CALL_CALLEE] == 0 {
		return
	}
	let x = e[CALL_CALLEE]
	if x[N_KIND] != EX_SELECT || x[SEL_X][N_KIND] != EX_IDENT || streq(x[SEL_NAME], cstr("spawn")) == 0 || vec_has_str(names, x[SEL_X][ID_NAME]) == 0 {
		return
	}
	let args = e[CALL_ARGS]
	if args[VEC_LEN] == 1 && vec_get(args, 0)[N_KIND] == EX_FUNCLIT {
		// Its cells are made per spawn (pool memory, like any kept closure), but the scope
		// ends before the request does, so request memory may be stored in them. The mark is
		// the scope's name: the child may use task handles of that scope or an outer one.
		vec_get(args, 0)[LIT_SCOPED] = x[SEL_X][ID_NAME]
	}
}

// ---- select (#232) ----
//
// select { let x = w => body ... } checks the arms in source order (ties go to the first) and,
// when none is ready, watches every source and parks until one wakes it; then the winning
// arm takes its value (which cannot wait: nothing ran since it was ready) and its body runs.
// Arms are lane receives (l.Recv()), task handles (t.wait()), after(d) and canceled().
fn sel_ident(pos i64, name i64) i64 {
	let id = node_new(EX_IDENT, pos)
	id[ID_NAME] = name
	return id
}

fn sel_call(pos i64, name i64, args i64) i64 {
	let c = node_new(EX_CALL, pos)
	c[CALL_NAME] = name
	c[CALL_ARGS] = args
	return c
}

fn sel_method(pos i64, recv i64, name i64) i64 {
	let x = node_new(EX_SELECT, pos)
	x[SEL_X] = sel_ident(pos, recv)
	x[SEL_NAME] = name
	let c = node_new(EX_CALL, pos)
	c[CALL_CALLEE] = x
	c[CALL_ARGS] = vec_new()
	return c
}

fn sel_let(pos i64, name i64, init i64) i64 {
	let l = node_new(ST_LET, pos)
	l[LET_NAME] = name
	l[LET_INIT] = init
	return l
}

fn sel_set(pos i64, name i64, v i64) i64 {
	let a = node_new(ST_ASSIGN, pos)
	a[AS_TARGET] = sel_ident(pos, name)
	let n = node_new(EX_INT, pos)
	n[INT_VAL] = v
	a[AS_VALUE] = n
	return a
}

fn sel_cmp(pos i64, name i64, op i64, v i64) i64 {
	let b = node_new(EX_BINARY, pos)
	b[BIN_OP] = op
	b[BIN_L] = sel_ident(pos, name)
	let n = node_new(EX_INT, pos)
	n[INT_VAL] = v
	if v < 0 {
		n[INT_VAL] = -v
		let u = node_new(EX_UNARY, pos)
		u[UN_OP] = cstr("-")
		u[UN_X] = n
		b[BIN_R] = u
	} else {
		b[BIN_R] = n
	}
	return b
}

fn sel_name(pos i64, kind i64, i i64) i64 {
	let nb = buf_new()
	buf_str(nb, kind)
	buf_int(nb, sel_seq)
	buf_byte(nb, '_')
	buf_int(nb, i)
	buf_byte(nb, 0)
	return nb[VEC_DATA]
}

shared mut sel_seq i64

// sel_site is a select's replay key (#243): its file's base name, ":" and its line.
fn sel_site(pos i64) i64 {
	let f = vec_get(files, pos >> 48)
	mut i = 0
	mut base = 0
	for i64(load8(f + i)) != 0 {
		if i64(load8(f + i)) == '/' {
			base = i + 1
		}
		i = i + 1
	}
	let b = buf_new()
	buf_str(b, f + base)
	buf_byte(b, ':')
	buf_int(b, (pos >> 16) & 0xffffffff)
	return str_node(pos, b)
}

// sel_gate is arm i's replay gate (#243): $selr < 0 (not replaying) || $selr == i.
fn sel_gate(pos i64, r i64, i i64) i64 {
	return binary_new(pos, cstr("||"), sel_cmp(pos, r, cstr("<"), 0), sel_cmp(pos, r, cstr("=="), i))
}

// sel_gated runs stmt only when arm i's replay gate is open.
fn sel_gated(pos i64, r i64, i i64, stmt i64) i64 {
	let ifs = node_new(ST_IF, pos)
	ifs[IF_COND] = sel_gate(pos, r, i)
	ifs[IF_THEN] = empty_block(pos)
	vec_push(ifs[IF_THEN][BLK_STMTS], stmt)
	return ifs
}

fn lower_select(s i64) {
	let pos = s[N_POS]
	sel_seq = sel_seq + 1
	let arms = s[SELECT_ARMS]
	let n = arms[VEC_LEN]
	let out = empty_block(pos)
	let st = out[BLK_STMTS]
	let kinds = vec_new() // 1 lane, 2 handle, 3 after, 4 canceled
	let srcs = vec_new()
	let armv = sel_name(pos, cstr("$sel"), 0 - 1)
	mut i = 0
	for i < n {
		let arm = vec_get(arms, i)
		let w = vec_get(arm, SELECT_ARM_WAIT)
		let apos = vec_get(arm, SELECT_ARM_POS)
		mut kind = 0
		mut src = 0
		if w[N_KIND] == EX_CALL && w[CALL_CALLEE] != 0 && w[CALL_CALLEE][N_KIND] == EX_SELECT && w[CALL_ARGS][VEC_LEN] == 0 {
			let m = w[CALL_CALLEE][SEL_NAME]
			if streq(m, cstr("Recv")) != 0 || streq(m, cstr("recv")) != 0 {
				kind = 1
			} else if streq(m, cstr("wait")) != 0 || streq(m, cstr("Wait")) != 0 {
				kind = 2
			}
			if kind != 0 {
				// A plain variable is used as is; anything else is evaluated once, first.
				let rx = w[CALL_CALLEE][SEL_X]
				if rx[N_KIND] == EX_IDENT {
					src = rx[ID_NAME]
				} else {
					src = sel_name(pos, cstr("$sels"), i)
					vec_push(st, sel_let(apos, src, rx))
				}
			}
		} else if w[N_KIND] == EX_CALL && w[CALL_NAME] != 0 && streq(w[CALL_NAME], cstr("after")) != 0 && w[CALL_ARGS][VEC_LEN] == 1 {
			kind = 3
			src = sel_name(pos, cstr("$sels"), i)
			vec_push(st, sel_let(apos, src, sel_call(apos, cstr("rt_select_deadline"), w[CALL_ARGS])))
		} else if w[N_KIND] == EX_CALL && w[CALL_NAME] != 0 && streq(w[CALL_NAME], cstr("canceled")) != 0 && w[CALL_ARGS][VEC_LEN] == 0 {
			kind = 4
		}
		if kind == 0 {
			err_code_at(apos, cstr("E630 SELECT_ARM"), cstr("a select arm waits on l.Recv(), t.wait(), after(d) or canceled()"))
			return
		}
		if kind >= 2 && vec_get(arm, SELECT_ARM_NAME) != 0 && kind != 2 {
			err_code_at(apos, cstr("E630 SELECT_ARM"), cstr("after(d) and canceled() give no value to bind"))
			return
		}
		vec_push(kinds, kind)
		vec_push(srcs, src)
		i = i + 1
	}
	let m1 = node_new(EX_UNARY, pos)
	m1[UN_OP] = cstr("-")
	let one = node_new(EX_INT, pos)
	one[INT_VAL] = 1
	m1[UN_X] = one
	vec_push(st, sel_let(pos, armv, m1))
	// Replay (#243): -1 off, -2 recording the winner, else the recorded arm, the only one taken.
	let selr = sel_name(pos, cstr("$selr"), 0)
	let rargs = vec_new()
	vec_push(rargs, sel_site(pos))
	let nlit = node_new(EX_INT, pos)
	nlit[INT_VAL] = n
	vec_push(rargs, nlit)
	vec_push(st, sel_let(pos, selr, sel_call(pos, cstr("rt_select_begin"), rargs)))
	// $selnow: replaying, the recorded select did not wait, so its after(d) arm is due now.
	let selnow = sel_name(pos, cstr("$seln"), 0)
	let nargs = vec_new()
	vec_push(nargs, sel_site(pos))
	vec_push(st, sel_let(pos, selnow, binary_new(pos, cstr("&&"), sel_cmp(pos, selr, cstr(">="), 0), sel_call(pos, cstr("rt_select_now"), nargs))))
	// for $sel < 0 { readiness checks in order; else watch, park, unwatch }
	let loop_ = node_new(ST_WHILE, pos)
	loop_[WH_COND] = sel_cmp(pos, armv, cstr("<"), 0)
	loop_[WH_BODY] = empty_block(pos)
	let lb = loop_[WH_BODY][BLK_STMTS]
	let dl = sel_name(pos, cstr("$seld"), 0)
	vec_push(lb, sel_let(pos, dl, node_new(EX_INT, pos)))
	mut chain = 0
	mut last = 0
	i = 0
	for i < n {
		let k = vec_get(kinds, i)
		mut cond = 0
		if k == 1 {
			cond = sel_method(pos, vec_get(srcs, i), cstr("Ready"))
		} else if k == 2 {
			cond = sel_method(pos, vec_get(srcs, i), cstr("ready"))
		} else if k == 3 {
			let args = vec_new()
			vec_push(args, sel_ident(pos, vec_get(srcs, i)))
			cond = binary_new(pos, cstr("||"), sel_ident(pos, selnow), sel_call(pos, cstr("rt_select_due"), args))
		} else {
			cond = sel_call(pos, cstr("rt_select_canceled"), vec_new())
		}
		let ifs = node_new(ST_IF, pos)
		ifs[IF_COND] = binary_new(pos, cstr("&&"), sel_gate(pos, selr, i), cond)
		ifs[IF_THEN] = empty_block(pos)
		vec_push(ifs[IF_THEN][BLK_STMTS], sel_set(pos, armv, i))
		if last != 0 {
			let eb = empty_block(pos)
			vec_push(eb[BLK_STMTS], ifs)
			last[IF_ELSE] = eb
		} else {
			chain = ifs
		}
		last = ifs
		i = i + 1
	}
	// A cancelled boundary with no canceled() arm ends the select with its fault.
	let cifs = node_new(ST_IF, pos)
	cifs[IF_COND] = sel_call(pos, cstr("rt_select_canceled"), vec_new())
	cifs[IF_THEN] = empty_block(pos)
	vec_push(cifs[IF_THEN][BLK_STMTS], sel_set(pos, armv, n))
	let eb = empty_block(pos)
	vec_push(eb[BLK_STMTS], cifs)
	last[IF_ELSE] = eb
	vec_push(lb, chain)
	let wait = node_new(ST_IF, pos)
	wait[IF_COND] = sel_cmp(pos, armv, cstr("<"), 0)
	wait[IF_THEN] = empty_block(pos)
	let wb = wait[IF_THEN][BLK_STMTS]
	i = 0
	for i < n {
		let k = vec_get(kinds, i)
		if k == 1 {
			vec_push(wb, sel_gated(pos, selr, i, expr_stmt(sel_method(pos, vec_get(srcs, i), cstr("Watch")))))
		} else if k == 2 {
			vec_push(wb, sel_gated(pos, selr, i, expr_stmt(sel_method(pos, vec_get(srcs, i), cstr("watch")))))
		} else if k == 3 {
			let a = node_new(ST_ASSIGN, pos)
			a[AS_TARGET] = sel_ident(pos, dl)
			let args = vec_new()
			vec_push(args, sel_ident(pos, dl))
			vec_push(args, sel_ident(pos, vec_get(srcs, i)))
			a[AS_VALUE] = sel_call(pos, cstr("rt_select_min"), args)
			vec_push(wb, sel_gated(pos, selr, i, a))
		}
		i = i + 1
	}
	let pargs = vec_new()
	vec_push(pargs, sel_ident(pos, dl))
	vec_push(wb, expr_stmt(sel_call(pos, cstr("rt_select_park"), pargs)))
	i = 0
	for i < n {
		let k = vec_get(kinds, i)
		if k == 1 {
			vec_push(wb, sel_gated(pos, selr, i, expr_stmt(sel_method(pos, vec_get(srcs, i), cstr("Unwatch")))))
		} else if k == 2 {
			vec_push(wb, sel_gated(pos, selr, i, expr_stmt(sel_method(pos, vec_get(srcs, i), cstr("unwatch")))))
		}
		i = i + 1
	}
	vec_push(lb, wait)
	vec_push(st, loop_)
	// if $selr != -1 { rt_select_end(site, $selr, $sel) }: record the winner, or check it.
	let rec = node_new(ST_IF, pos)
	rec[IF_COND] = sel_cmp(pos, selr, cstr("!="), 0 - 1)
	rec[IF_THEN] = empty_block(pos)
	let eargs = vec_new()
	vec_push(eargs, sel_site(pos))
	vec_push(eargs, sel_ident(pos, selr))
	vec_push(eargs, sel_ident(pos, armv))
	vec_push(rec[IF_THEN][BLK_STMTS], expr_stmt(sel_call(pos, cstr("rt_select_end"), eargs)))
	vec_push(st, rec)
	// Then the winning arm: take its value and run its body.
	i = 0
	for i <= n {
		let ifs = node_new(ST_IF, pos)
		ifs[IF_COND] = sel_cmp(pos, armv, cstr("=="), i)
		ifs[IF_THEN] = empty_block(pos)
		let tb = ifs[IF_THEN][BLK_STMTS]
		if i == n {
			let tr = node_new(EX_TRY, pos)
			tr[TRY_X] = sel_call(pos, cstr("rt_select_fail"), vec_new())
			vec_push(tb, expr_stmt(tr))
		} else {
			let arm = vec_get(arms, i)
			let k = vec_get(kinds, i)
			let name = vec_get(arm, SELECT_ARM_NAME)
			if k == 1 || k == 2 {
				mut take = 0
				if k == 1 {
					take = sel_method(pos, vec_get(srcs, i), cstr("Recv"))
				} else {
					take = sel_method(pos, vec_get(srcs, i), cstr("wait"))
				}
				let tr = node_new(EX_TRY, pos)
				tr[TRY_X] = take
				if name != 0 {
					vec_push(tb, sel_let(pos, name, tr))
				} else {
					if k == 1 {
						vec_push(tb, sel_let(pos, cstr("_"), tr))
					} else {
						vec_push(tb, expr_stmt(tr))
					}
				}
			}
			let body = vec_get(arm, SELECT_ARM_BODY)
			if vec_get(arm, SELECT_ARM_BLOCK) != 0 {
				vec_push(tb, body)
			} else if is_stmt_kind(body[N_KIND]) != 0 {
				vec_push(tb, body)
			} else {
				vec_push(tb, expr_stmt(body))
			}
		}
		vec_push(st, ifs)
		i = i + 1
	}
	replace_node(s, out)
	check_scoped(s)
}

// is_stmt_kind tells a select arm's statement body (return, fail, break, continue) from an
// expression body.
fn is_stmt_kind(k i64) i64 {
	return i64(k == ST_RETURN || k == ST_FAIL || k == ST_BREAK || k == ST_CONTINUE || k == ST_EXPR)
}

// ---- task handles stay in their scope (#232) ----
//
// A scope frees its children's records when it ends, so neither a task handle (spawned) nor
// the scope itself may be reachable after the scope block. They are second-class values: they
// live in local variables and parameters (and local slices, maps and optionals of them), never
// in a global, a struct field, a result, a type argument or a dyn value. Every local remembers
// how many scope blocks enclose its declaration (S_SCOPE_AT); a value is as deep as the deepest
// such variable it reads, and may only be stored where it lives no longer: by an assignment,
// through an argument for a mut parameter or a scope parameter (the callee may spawn children
// that capture the other arguments), and by append and copy. A closure that may outlive the
// scope (a kept or detached one) cannot capture one, a child spawned on scope s only those of s
// or of a scope around it, and a deferred call none from a scope that ends before it runs.
shared mut ck_scope_depth i64 // scope blocks around the code being checked (a closure starts 65536 deeper)
shared mut ck_fn_base i64 // ck_scope_depth where the current function's body starts
shared mut sb_types i64 // [scope, spawned, spawnedOf]: the runtime's types, once looked up

// sb_type reports whether a value of type t is, or holds, a task handle or a scope.
fn sb_type(t i64) i64 {
	if t == 0 {
		return 0
	}
	let k = kind_of(t)
	if k == K_OPT || k == K_SLICE {
		return sb_type(t[TY_ELEM])
	}
	if k == K_MAP {
		return i64(sb_type(t[TY_KEY]) != 0 || sb_type(t[TY_ELEM]) != 0)
	}
	if k != K_STRUCT {
		return 0
	}
	if sb_types == 0 {
		let sc = find_type(cstr("scope"))
		let sp = find_type(cstr("spawned"))
		if sc == 0 || sp == 0 {
			return 0
		}
		sb_types = vec_new()
		vec_push(sb_types, sc)
		vec_push(sb_types, sp)
		vec_push(sb_types, find_generic(cstr("spawnedOf")))
	}
	if t[TY_GDECL] != 0 && t[TY_GDECL] == vec_get(sb_types, 2) {
		// The handle of a child with a value.
		return 1
	}
	return i64(t == vec_get(sb_types, 0) || t == vec_get(sb_types, 1))
}

// sb_noun names what an sb_type holds, for diagnostics.
fn sb_noun(t i64) i64 {
	let k = kind_of(t)
	if k == K_OPT || k == K_SLICE {
		return sb_noun(t[TY_ELEM])
	}
	if k == K_MAP {
		if sb_type(t[TY_KEY]) != 0 {
			return sb_noun(t[TY_KEY])
		}
		return sb_noun(t[TY_ELEM])
	}
	if sb_types != 0 && t == vec_get(sb_types, 0) {
		return cstr("a scope")
	}
	return cstr("a task handle")
}

// sb_forbid reports a task handle or scope of type t kept where it could outlive its scope.
fn sb_forbid(pos i64, t i64, what i64) {
	if ck_legacy != 0 || ck_trusted != 0 || sb_type(t) == 0 {
		return
	}
	let e = err_code(pos, cstr("E640 SCOPE_ESCAPE"))
	buf_str(e, what)
	buf_str(e, sb_noun(t))
	buf_str(e, cstr(" ("))
	type_name(e, t)
	buf_str(e, cstr("): it must not outlive its scope block, so it lives only in local variables and parameters"))
	err_end(e)
}

// sb_targs rejects task handles and scopes as type arguments (a generic could keep them).
fn sb_targs(pos i64, targs i64) {
	mut i = 0
	for targs != 0 && i < targs[VEC_LEN] {
		sb_forbid(pos, vec_get(targs, i), cstr("a type argument cannot be "))
		i = i + 1
	}
}

// sb_scope_params names f's scope parameters: a closure spawned on one is the scope's child.
fn sb_scope_params(f i64) i64 {
	let names = vec_new()
	mut i = 0
	for i < f[F_PARAMS][VEC_LEN] && i < sb_len(f[F_PTYPES]) {
		let t = vec_get(f[F_PTYPES], i)
		if t != 0 && t[TY_KIND] < TX_NAME && sb_type(t) != 0 && t == vec_get(sb_types, 0) {
			vec_push(names, vec_get(f[F_PARAMS], i))
		}
		i = i + 1
	}
	return names
}

// sb_lookup finds the variable a name means here without capturing it (lookup_name would).
fn sb_lookup(name i64) i64 {
	mut i = sc_syms[VEC_LEN] - 1
	for i >= 0 {
		let s = vec_get(sc_syms, i)
		if streq(s[S_NAME], name) != 0 {
			return s
		}
		i = i - 1
	}
	mut f = ck_fn
	for f != 0 && f[F_PARENT] != 0 {
		let syms = f[F_OUTER_SYMS]
		mut j = sb_len(syms) - 1
		for j >= 0 {
			let os = vec_get(syms, j)
			if streq(os[S_NAME], name) != 0 {
				return os
			}
			j = j - 1
		}
		f = f[F_PARENT]
	}
	return 0
}

// sb_sym_depth is how deep the handles variable s holds may be: its declaration's depth.
fn sb_sym_depth(s i64) i64 {
	if s != 0 && s[S_KIND] == SYM_LOCAL && sb_type(s[S_TYPE]) != 0 {
		return s[S_SCOPE_AT]
	}
	return 0
}

fn sb_max(a i64, b i64) i64 {
	if a > b {
		return a
	}
	return b
}

fn sb_list_depth(v i64) i64 {
	mut d = 0
	mut i = 0
	for v != 0 && i < v[VEC_LEN] {
		d = sb_max(d, sb_depth(vec_get(v, i)))
		i = i + 1
	}
	return d
}

fn sb_len(v i64) i64 {
	if v == 0 {
		return 0
	}
	return v[VEC_LEN]
}

fn sb_block_depth(b i64) i64 {
	mut d = 0
	mut i = 0
	for b != 0 && i < b[BLK_STMTS][VEC_LEN] {
		d = sb_max(d, sb_stmt_depth(vec_get(b[BLK_STMTS], i)))
		i = i + 1
	}
	return d
}

fn sb_stmt_depth(st i64) i64 {
	if st == 0 {
		return 0
	}
	let k = st[N_KIND]
	if k == ST_EXPR || k == ST_BSTORE {
		return sb_depth(st[ES_X])
	}
	if k == ST_LET {
		return sb_depth(st[LET_INIT])
	}
	if k == ST_ASSIGN {
		return sb_depth(st[AS_VALUE])
	}
	if k == ST_RETURN {
		return sb_depth(st[RET_VALUE])
	}
	if k == ST_IF {
		return sb_max(sb_depth(st[IF_COND]), sb_max(sb_block_depth(st[IF_THEN]), sb_stmt_depth(st[IF_ELSE])))
	}
	if k == ST_BLOCK {
		return sb_block_depth(st)
	}
	if k == ST_FAIL || k == ST_BREAK || k == ST_CONTINUE {
		return 0
	}
	return ck_scope_depth
}

// sb_depth is the depth of the deepest task handle or scope expression e may give (0: none). It
// takes unchecked and checked nodes; one it does not know is as deep as the code around it.
fn sb_depth(e i64) i64 {
	if e == 0 {
		return 0
	}
	let k = e[N_KIND]
	if k == EX_INT || k == EX_FLOAT || k == EX_STR || k == EX_NIL || k == EX_INTERP || k == EX_UNIT || k == EX_TYPE || k == EX_FUNCLIT || k == EX_FUNCREF {
		return 0
	}
	if k == EX_IDENT {
		if e[ID_REF] != 0 {
			return sb_sym_depth(e[ID_REF])
		}
		return sb_sym_depth(sb_lookup(e[ID_NAME]))
	}
	if k == ST_BLOCK {
		return sb_block_depth(e)
	}
	if k == EX_SELECT {
		return sb_depth(e[SEL_X])
	}
	if k == EX_UNARY {
		return sb_depth(e[UN_X])
	}
	if k == EX_MUTARG {
		return sb_depth(e[MUTARG_X])
	}
	if k == EX_TRY {
		return sb_depth(e[TRY_X])
	}
	if k == EX_WRAP {
		return sb_depth(e[WRAP_X])
	}
	if k == EX_CONV {
		return sb_depth(e[CV_X])
	}
	if k == EX_BINARY {
		return sb_max(sb_depth(e[BIN_L]), sb_depth(e[BIN_R]))
	}
	if k == EX_INDEX {
		return sb_max(sb_depth(e[IX_X]), sb_depth(e[IX_I]))
	}
	if k == EX_SLICE {
		return sb_max(sb_depth(e[SL_X]), sb_max(sb_depth(e[SL_LO]), sb_depth(e[SL_HI])))
	}
	if k == EX_COALESCE {
		return sb_max(sb_depth(e[COAL_X]), sb_depth(e[COAL_FALLBACK]))
	}
	if k == EX_CATCH {
		return sb_max(sb_depth(e[CATCH_X]), sb_block_depth(e[CATCH_BODY]))
	}
	if k == EX_BOUNDARY {
		return sb_max(sb_list_depth(e[BOUND_ARGS]), sb_block_depth(e[BOUND_BODY]))
	}
	if k == EX_CALL {
		return sb_max(sb_depth(e[CALL_CALLEE]), sb_list_depth(e[CALL_ARGS]))
	}
	if k == EX_COMPOSITE {
		return sb_max(sb_list_depth(e[CL_ELEMS]), sb_list_depth(e[CL_KEYS]))
	}
	if k == EX_MEM && e[MEM_INDEX] == 0 && e[MEM_OFF] == 0 && e[MEM_BASE][N_KIND] == EX_IDENT && e[MEM_BASE][ID_REF] != 0 && e[MEM_BASE][ID_REF][S_CELL_OF] != 0 {
		// A variable kept in a cell.
		return sb_sym_depth(e[MEM_BASE][ID_REF][S_CELL_OF])
	}
	if k == EX_MEM && e[MEM_INDEX] == 0 && e[MEM_OFF] == 0 && sb_env_index(e[MEM_BASE]) >= 0 {
		// A captured variable, read through the closure's environment.
		return sb_sym_depth(vec_get(ck_fn[F_CAPTURES], sb_env_index(e[MEM_BASE])))
	}
	return ck_scope_depth
}

// sb_env_index is i when e reads the cell address of the current closure's capture i, or -1.
fn sb_env_index(e i64) i64 {
	if ck_fn == 0 || ck_fn[F_ENV_SYM] == 0 || e[N_KIND] != EX_MEM || e[MEM_INDEX] != 0 || e[MEM_OFF] < 16 {
		return -1
	}
	let b = e[MEM_BASE]
	if b[N_KIND] != EX_IDENT || b[ID_REF] != ck_fn[F_ENV_SYM] || e[MEM_OFF] / 8 - 2 >= sb_len(ck_fn[F_CAPTURES]) {
		return -1
	}
	return e[MEM_OFF] / 8 - 2
}

// sb_root is the variable a target or argument stores into (x, x[i], x.f), or 0.
fn sb_root(e i64) i64 {
	let k = e[N_KIND]
	if k == EX_IDENT {
		if e[ID_REF] != 0 {
			return e[ID_REF]
		}
		return sb_lookup(e[ID_NAME])
	}
	if k == EX_INDEX {
		return sb_root(e[IX_X])
	}
	if k == EX_SELECT {
		return sb_root(e[SEL_X])
	}
	if k == EX_MUTARG {
		return sb_root(e[MUTARG_X])
	}
	return 0
}

// sb_store reports storing a value as deep as d into variable s, when s outlives the value.
fn sb_store(pos i64, s i64, d i64) {
	if s == 0 || s[S_KIND] != SYM_LOCAL || sb_type(s[S_TYPE]) == 0 || d <= s[S_SCOPE_AT] {
		return
	}
	let e = err_code(pos, cstr("E640 SCOPE_ESCAPE"))
	buf_str(e, sb_noun(s[S_TYPE]))
	buf_str(e, cstr(" cannot outlive its scope: '"))
	buf_str(e, s[S_NAME])
	buf_str(e, cstr("' is declared outside the scope this value belongs to, which ends first; declare it inside that scope"))
	err_end(e)
}

// sb_assign checks target = value (before either is checked).
fn sb_assign(pos i64, target i64, v i64) {
	if ck_legacy != 0 || ck_trusted != 0 || v == 0 || v[N_TYPE] != 0 {
		// Checked values are the checker's own temporaries, checked where they were made.
		return
	}
	let root = sb_root(target)
	if root == 0 || sb_type(root[S_TYPE]) == 0 {
		return
	}
	if v[N_KIND] == EX_CALL && v[CALL_NAME] != 0 && streq(v[CALL_NAME], cstr("append")) != 0 && sb_len(v[CALL_ARGS]) > 0 && sb_root(vec_get(v[CALL_ARGS], 0)) == root {
		// xs = append(xs, ...): the call's own check covers what goes into xs.
		return
	}
	sb_store(pos, root, sb_depth(v))
}

// sb_holder is the variable argument a of a call keeps the other arguments in (i: its place,
// counting a method's receiver as 0 when it has one), or 0.
fn sb_holder(e i64, a i64, i i64) i64 {
	if a[N_KIND] == EX_MUTARG {
		let r = sb_root(a)
		if r != 0 && sb_type(r[S_TYPE]) != 0 {
			return r
		}
		return 0
	}
	let r = sb_root(a)
	if r == 0 || r[S_KIND] != SYM_LOCAL || sb_type(r[S_TYPE]) == 0 {
		return 0
	}
	if sb_types != 0 && r[S_TYPE] == vec_get(sb_types, 0) && a[N_KIND] == EX_IDENT {
		return r
	}
	if i == 0 && e[CALL_NAME] != 0 && (streq(e[CALL_NAME], cstr("append")) != 0 || streq(e[CALL_NAME], cstr("copy")) != 0) {
		return r
	}
	return 0
}

// sb_call checks a call before it is checked: no argument may hand a holder (sb_holder) a
// task handle or scope that ends before the holder does.
fn sb_call(e i64) {
	if ck_legacy != 0 || ck_trusted != 0 {
		return
	}
	let xs = vec_new()
	let x = e[CALL_CALLEE]
	if x != 0 && x[N_KIND] == EX_SELECT {
		vec_push(xs, x[SEL_X])
	}
	let args = e[CALL_ARGS]
	mut i = 0
	for args != 0 && i < args[VEC_LEN] {
		vec_push(xs, vec_get(args, i))
		i = i + 1
	}
	if xs[VEC_LEN] < 2 {
		return
	}
	let off = xs[VEC_LEN] - sb_len(args)
	i = 0
	for i < xs[VEC_LEN] {
		let h = sb_holder(e, vec_get(xs, i), i - off)
		mut j = 0
		for h != 0 && j < xs[VEC_LEN] {
			let a = vec_get(xs, j)
			if j != i && sb_depth(a) > h[S_SCOPE_AT] {
				let m = err_code(a[N_POS], cstr("E640 SCOPE_ESCAPE"))
				buf_str(m, cstr("a task handle cannot outlive its scope: this argument belongs to a scope that ends before '"))
				buf_str(m, h[S_NAME])
				buf_str(m, cstr("', which the call may keep it in"))
				err_end(m)
			}
			j = j + 1
		}
		i = i + 1
	}
}

// sb_captures checks what closure f (made by literal e) captures: one that may outlive the
// scope (kept or detached) no task handle or scope at all, and a child spawned on scope s only
// those of s or of a scope around it.
fn sb_captures(e i64, f i64) {
	if ck_legacy != 0 || ck_trusted != 0 {
		return
	}
	mut limit_ = -1
	if e[LIT_SCOPED] != 0 {
		limit_ = 0
		let ss = sb_lookup(e[LIT_SCOPED])
		if ss != 0 {
			limit_ = ss[S_SCOPE_AT]
		}
	} else if f[F_ESCAPES] == 0 {
		// Called only while its maker runs: it may use everything its maker sees.
		return
	}
	let caps = f[F_CAPTURES]
	mut i = 0
	for i < sb_len(caps) {
		let os = vec_get(caps, i)
		if os != 0 && sb_type(os[S_TYPE]) != 0 && (limit_ < 0 || os[S_SCOPE_AT] > limit_) {
			let m = err_code(e[N_POS], cstr("E640 SCOPE_ESCAPE"))
			if limit_ >= 0 {
				buf_str(m, cstr("a child of scope '"))
				buf_str(m, e[LIT_SCOPED])
				buf_str(m, cstr("' cannot capture '"))
				buf_str(m, os[S_NAME])
				buf_str(m, cstr("', "))
				buf_str(m, sb_noun(os[S_TYPE]))
				buf_str(m, cstr(" of a scope inside it: the child may outlive that scope"))
			} else if ck_detached != 0 && vec_has(ck_detached, f) != 0 {
				buf_str(m, cstr("detach cannot capture '"))
				buf_str(m, os[S_NAME])
				buf_str(m, cstr("', "))
				buf_str(m, sb_noun(os[S_TYPE]))
				buf_str(m, cstr(": a detached task outlives every scope"))
			} else {
				buf_str(m, cstr("a closure that may be kept cannot capture '"))
				buf_str(m, os[S_NAME])
				buf_str(m, cstr("', "))
				buf_str(m, sb_noun(os[S_TYPE]))
				buf_str(m, cstr(", which must not outlive its scope block: use it in a child spawned on the scope, or in a closure only passed to a call that runs it"))
			}
			err_end(m)
		}
		i = i + 1
	}
}

// sb_defer checks a deferred call (already checked): it runs when the function returns, after
// every scope inside the function has ended.
fn sb_defer(pos i64, call i64) {
	if ck_legacy != 0 || ck_trusted != 0 || ck_scope_depth == ck_fn_base {
		return
	}
	mut d = sb_depth(call[CALL_CALLEE])
	let args = call[CALL_ARGS]
	mut i = 0
	for args != 0 && i < args[VEC_LEN] {
		let a = vec_get(args, i)
		if sb_type(a[N_TYPE]) != 0 {
			d = sb_max(d, sb_depth(a))
		}
		i = i + 1
	}
	if d > ck_fn_base {
		err_code_at(pos, cstr("E640 SCOPE_ESCAPE"), cstr("defer runs when the function returns, after the scope of the task handle it uses has ended: make the call inside the scope instead"))
	}
}

// spawn_value lowers s.spawn(f), for f a function with a value (func() !T), to
// rt_spawn_value[T](s, f): its handle, a spawnedOf[T], gives the value through wait() !T
// (#232). It gives 0 when the call is not one, and the method call is checked as usual.
fn spawn_value(e i64, x i64, xt i64, m i64) i64 {
	if streq(m, cstr("spawn")) == 0 || sb_type(xt) == 0 || xt != vec_get(sb_types, 0) || e[CALL_ARGS][VEC_LEN] != 1 {
		return 0
	}
	let a = vec_get(e[CALL_ARGS], 0)
	let ft = chk(a, 0)
	if kind_of(ft) != K_FUNC || ft[TY_RESULTS][VEC_LEN] != 2 || kind_of(vec_get(ft[TY_RESULTS], 1)) != K_ERROR || ft[TY_FIELDS][VEC_LEN] != 0 {
		return 0
	}
	let g = find_fn(cstr("rt_spawn_value"))
	if g == 0 {
		return 0
	}
	let targs = vec_new()
	vec_push(targs, vec_get(ft[TY_RESULTS], 0))
	let inst = instantiate_fn(g, targs, e[N_POS])
	e[CALL_ARGS] = args2(x, a)
	e[CALL_CALLEE] = 0
	e[CALL_NAME] = inst[F_QNAME]
	return direct_call(e, inst)
}

// ---- defer ----
//
// defer f(a, b) evaluates f, a and b now and sets a flag; every return (including the
// ones try makes) and the end of the function then run the flagged calls, last first.
shared mut ck_defers i64 // the current function's defers: [flag, call]
shared mut ck_defer_mark i64 // the current function's defer chain mark ($m), when its defers use the chain

// The defer chain (#230): each defer stores its callee and arguments in a record that a
// generated defer$N(r) calls, pushed on the task's chain; returns run the chain down to the
// function's mark, and a panic runs it too, so deferred calls also run while a panic unwinds.
fn lower_defer(s i64) {
	let pos = s[N_POS]
	if ck_legacy != 0 {
		err_code_at(pos, cstr("E092 NEWER_SYNTAX"), cstr("defer needs func syntax"))
		return
	}
	if ck_loops > 0 {
		err_code_at(pos, cstr("E270 DEFER"), cstr("defer inside a loop would run once per function, not per iteration: move the loop body into a function"))
		return
	}
	let call = s[GO_CALL]
	let t = chk(call, 0)
	let tk = kind_of(t)
	if tk == K_ERROR || (tk == K_TUPLE && tuple_has_fault(t) != 0) {
		err_code_at(pos, cstr("E270 DEFER"), cstr("defer would ignore the fault this call returns: defer a function that handles it"))
		return
	}
	if call[N_KIND] != EX_CALL || call[CALL_INTRINSIC] != 0 {
		err_code_at(pos, cstr("E055 DEFER_CALL"), cstr("defer needs a plain function call (wrap anything else in a function)"))
		return
	}
	sb_defer(pos, call)
	let b = empty_block(pos)
	b[BLK_FLAT] = 1
	if call[CALL_CALLEE] != 0 {
		let ct = temp(pos, call[CALL_CALLEE], call[CALL_CALLEE][N_TYPE])
		vec_push(b[BLK_STMTS], ct)
		call[CALL_CALLEE] = sym_ref_node(pos, ct[LET_SYM])
	}
	let args = call[CALL_ARGS]
	mut i = 0
	for i < args[VEC_LEN] {
		let a = vec_get(args, i)
		let at = temp(pos, a, a[N_TYPE])
		vec_push(b[BLK_STMTS], at)
		args[VEC_DATA][i] = sym_ref_node(pos, at[LET_SYM])
		i = i + 1
	}
	let flag = declare_local(pos, cstr("$"), ty_bool)
	if ck_defers == 0 {
		ck_defers = vec_new()
		ck_defer_mark = declare_local(pos, cstr("$"), ty_int)
	}
	defer_record(pos, b, call)
	vec_push(ck_defers, pair(flag, call))
	replace_node(s, b)
}

// defer_record stores call's callee and arguments (already in temps) in a chain record and
// pushes it with a generated defer$N that makes the call from the record.
fn defer_record(pos i64, b i64, call i64) {
	let args = call[CALL_ARGS]
	mut n = args[VEC_LEN]
	if call[CALL_CALLEE] != 0 {
		n = n + 1
	}
	let rec = temp(pos, rt_call(pos, cstr("rt_defer_rec"), args1(mk_int(pos, 2 * n, ty_int)), ty_int), ty_int)
	vec_push(b[BLK_STMTS], rec)
	mut slot = 0
	if call[CALL_CALLEE] != 0 {
		let ct = call[CALL_CALLEE][ID_REF][S_TYPE]
		vec_push(b[BLK_STMTS], assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, rec[LET_SYM]), 0, 0, 16 + 16 * slot, ct), sym_ref_node(pos, call[CALL_CALLEE][ID_REF])))
		slot = slot + 1
	}
	mut i = 0
	for i < args[VEC_LEN] {
		let a = vec_get(args, i)[ID_REF]
		vec_push(b[BLK_STMTS], assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, rec[LET_SYM]), 0, 0, 16 + 16 * slot, a[S_TYPE]), sym_ref_node(pos, a)))
		slot = slot + 1
		i = i + 1
	}
	let thunk = defer_thunk(pos, call)
	let ref_ = node_new(EX_FUNCREF, pos)
	ref_[FR_FN] = thunk
	ref_[N_TYPE] = thunk[F_TYPE]
	vec_push(b[BLK_STMTS], expr_stmt(rt_call(pos, cstr("rt_defer_push"), args2(sym_ref_node(pos, rec[LET_SYM]), ref_), ty_void)))
}

// defer_thunk builds defer$N(r), which makes call with the callee and arguments in record r.
fn defer_thunk(pos i64, call i64) i64 {
	lifted_count = lifted_count + 1
	let f = fn_new(pos, cstr("defer"))
	let nb = buf_new()
	buf_str(nb, cstr("defer$"))
	buf_int(nb, lifted_count)
	buf_byte(nb, 0)
	f[F_QNAME] = nb[VEC_DATA]
	f[F_NAME] = nb[VEC_DATA]
	f[F_LIFTED] = 2
	f[F_FILE] = ck_fn[F_FILE]
	vec_push(f[F_PARAMS], cstr("r"))
	vec_push(f[F_PTYPES], ty_int)
	f[F_TYPE] = func_of(f[F_PTYPES], f[F_RTYPES], 0)
	f[F_LOCALS] = vec_new()
	f[F_BODY] = empty_block(pos)
	vec_push(prog_fns, f)
	let r = sym_new(SYM_LOCAL, cstr("r"), pos)
	r[S_TYPE] = ty_int
	r[S_SLOT] = 0
	f[F_SLOTS] = 1
	vec_push(f[F_LOCALS], r)
	let c = node_new(EX_CALL, pos)
	replace_node(c, call)
	mut slot = 0
	if call[CALL_CALLEE] != 0 {
		c[CALL_CALLEE] = mk_mem(pos, sym_ref_node(pos, r), 0, 0, 16 + 16 * slot, call[CALL_CALLEE][ID_REF][S_TYPE])
		slot = slot + 1
	}
	let args = vec_new()
	mut i = 0
	for i < call[CALL_ARGS][VEC_LEN] {
		let a = vec_get(call[CALL_ARGS], i)[ID_REF]
		vec_push(args, mk_mem(pos, sym_ref_node(pos, r), 0, 0, 16 + 16 * slot, a[S_TYPE]))
		slot = slot + 1
		i = i + 1
	}
	c[CALL_ARGS] = args
	vec_push(f[F_BODY][BLK_STMTS], expr_stmt(c))
	return f
}

fn tuple_has_fault(t i64) i64 {
	mut i = 0
	for i < t[TY_FIELDS][VEC_LEN] {
		if kind_of(vec_get(t[TY_FIELDS], i)) == K_ERROR {
			return 1
		}
		i = i + 1
	}
	return 0
}

// defer_calls appends the flagged deferred calls to stmts, last deferred first.
fn defer_calls(pos i64, stmts i64) {
	if ck_defer_mark != 0 {
		vec_push(stmts, expr_stmt(rt_call(pos, cstr("rt_defer_run"), args1(sym_ref_node(pos, ck_defer_mark)), ty_void)))
		return
	}
	mut j = ck_defers[VEC_LEN] - 1
	for j >= 0 {
		let d = vec_get(ck_defers, j)
		let call = vec_get(d, 1)
		let c = node_new(EX_CALL, pos)
		replace_node(c, call)
		let args = vec_new()
		mut i = 0
		for i < call[CALL_ARGS][VEC_LEN] {
			vec_push(args, sym_ref_node(pos, vec_get(call[CALL_ARGS], i)[ID_REF]))
			i = i + 1
		}
		c[CALL_ARGS] = args
		if call[CALL_CALLEE] != 0 {
			c[CALL_CALLEE] = sym_ref_node(pos, call[CALL_CALLEE][ID_REF])
		}
		let ifs = node_new(ST_IF, pos)
		ifs[IF_COND] = sym_ref_node(pos, vec_get(d, 0))
		ifs[IF_THEN] = empty_block(pos)
		vec_push(ifs[IF_THEN][BLK_STMTS], expr_stmt(c))
		vec_push(stmts, ifs)
		j = j - 1
	}
}

fn finish_defers(f i64) {
	let body = f[F_BODY]
	defer_returns(body[BLK_STMTS])
	let pos = f[F_POS]
	let init = vec_new()
	mut i = 0
	for i < ck_defers[VEC_LEN] {
		vec_push(init, let_stmt(pos, vec_get(vec_get(ck_defers, i), 0), mk_int(pos, 0, ty_bool)))
		i = i + 1
	}
	if ck_defer_mark != 0 {
		vec_push(init, let_stmt(pos, ck_defer_mark, rt_call(pos, cstr("rt_defer_mark"), vec_new(), ty_int)))
	}
	use_cell_init(f, init)
	i = 0
	for i < body[BLK_STMTS][VEC_LEN] {
		vec_push(init, vec_get(body[BLK_STMTS], i))
		i = i + 1
	}
	if ends_in_return(body[BLK_STMTS]) == 0 {
		defer_calls(pos, init)
	}
	body[BLK_STMTS] = init
}

fn defer_returns(v i64) {
	mut i = 0
	for i < v[VEC_LEN] {
		defer_stmt(vec_get(v, i))
		i = i + 1
	}
}

fn defer_stmt(s i64) {
	let k = s[N_KIND]
	if k == ST_BLOCK {
		defer_returns(s[BLK_STMTS])
	} else if k == ST_IF {
		defer_returns(s[IF_THEN][BLK_STMTS])
		if s[IF_ELSE] != 0 {
			defer_stmt(s[IF_ELSE])
		}
	} else if k == ST_WHILE {
		defer_returns(s[WH_BODY][BLK_STMTS])
	} else if k == ST_RETURN {
		let pos = s[N_POS]
		let b = empty_block(pos)
		b[BLK_FLAT] = 1
		let r = node_new(ST_RETURN, pos)
		if s[RET_VALUE] != 0 {
			let v = s[RET_VALUE]
			if kind_of(v[N_TYPE]) == K_TUPLE {
				err_code_at(pos, cstr("E270 DEFER"), cstr("in a function with defer, assign a multi-value call's results before returning them"))
			}
			let t = temp(pos, v, v[N_TYPE])
			vec_push(b[BLK_STMTS], t)
			r[RET_VALUE] = sym_ref_node(pos, t[LET_SYM])
		}
		if s[RET_VALUES] != 0 {
			let vals = vec_new()
			mut i = 0
			for i < s[RET_VALUES][VEC_LEN] {
				let rv = vec_get(s[RET_VALUES], i)
				let t2 = temp(pos, rv, rv[N_TYPE])
				vec_push(b[BLK_STMTS], t2)
				vec_push(vals, sym_ref_node(pos, t2[LET_SYM]))
				i = i + 1
			}
			r[RET_VALUES] = vals
		}
		defer_calls(pos, b[BLK_STMTS])
		use_return(pos, b, r)
		vec_push(b[BLK_STMTS], r)
		replace_node(s, b)
	}
}

fn vec_len_of(v i64) i64 {
	return v[VEC_LEN]
}

// lower_with_init turns `if init; c {}` / `for init; c; post {}` into { init; stmt }.
fn lower_with_init(s i64, field i64) {
	let init = s[field]
	let inner = node_new(s[N_KIND], s[N_POS])
	replace_node(inner, s)
	inner[field] = 0
	let b = empty_block(s[N_POS])
	vec_push(b[BLK_STMTS], init)
	vec_push(b[BLK_STMTS], inner)
	replace_node(s, b)
	check_scoped(s)
}

fn check_cond(c i64) {
	let t = chk(c, ty_bool)
	if ck_legacy != 0 {
		return
	}
	if is_bool_t(t) == 0 {
		err_code_type(c[N_POS], cstr("E232 CONDITION"), cstr("condition must be a bool, not "), t, cstr(""))
	}
}

fn check_let(s i64) {
	let pos = s[N_POS]
	mut t = 0
	if s[LET_TYPE] != 0 {
		t = resolve_type(s[LET_TYPE])
	}
	let init = s[LET_INIT]
	if init != 0 && (init[N_KIND] == EX_TRY || init[N_KIND] == EX_CATCH || init[N_KIND] == EX_WRAP) && ck_legacy == 0 {
		lower_try_stmt(s, init, 1, t)
		return
	}
	if init != 0 && init[N_KIND] == EX_MATCH && ck_legacy == 0 {
		check_match_let(s, init, t)
		return
	}
	if init != 0 {
		let it = chk(init, t)
		check_value(pos, it)
		if t != 0 {
			check_assignable(init, it, t)
			if is_untyped(it) != 0 {
				reconvert(init, t)
			}
		} else {
			t = default_type(it)
			if kind_of(t) == K_NIL {
				err_code_at(init[N_POS], cstr("E233 UNTYPED_NIL"), cstr("use of untyped nil"))
			}
			if is_untyped(it) != 0 {
				reconvert(init, t)
			}
		}
	} else if ck_legacy == 0 && array_len(s[LET_TYPE]) > 0 {
		s[LET_INIT] = array_make(pos, t, array_len(s[LET_TYPE]))
	} else {
		s[LET_INIT] = zero_value(pos, t)
	}
	if streq(s[LET_NAME], cstr("_")) != 0 {
		if kind_of(t) == K_ERROR && ck_legacy == 0 {
			err_code_at(pos, cstr("E410 UNCHECKED_FAULT"), cstr("a fault cannot be discarded with _"))
		}
		replace_node(s, expr_stmt(s[LET_INIT]))
		return
	}
	s[LET_SYM] = declare_local(pos, s[LET_NAME], t)
	len_alias_remember(s[LET_SYM], init)
	if s[LET_SYM][S_CELL] != 0 {
		let sym = s[LET_SYM]
		let csym = sym[S_CELL_SYM]
		let alloc_call = rt_call(pos, cstr("rt_alloc"), args1(mk_int(pos, 8, ty_int)), ty_int)
		let stmts = vec_new()
		vec_push(stmts, let_stmt(pos, csym, alloc_call))
		vec_push(stmts, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, csym), 0, 0, 0, t), s[LET_INIT]))
		let blk = node_new(ST_BLOCK, pos)
		blk[BLK_STMTS] = stmts
		blk[BLK_FLAT] = 1
		replace_node(s, blk)
	}
}

// check_target checks an assignment target and returns its type; it rewrites slice
// elements and fields into word accesses and leaves map/byte stores to the caller.
fn check_target(t i64) i64 {
	let k = t[N_KIND]
	if k == EX_IDENT {
		let s = lookup_name(t[ID_NAME])
		if s == 0 {
			let u = err_code(t[N_POS], cstr("E103 UNDEFINED"))
			buf_str(u, cstr("undefined: "))
			buf_str(u, t[ID_NAME])
			err_end(u)
			return ty_int
		}
		if s[S_KIND] == SYM_CONST {
			err_code_quoted(t[N_POS], cstr("E710 NOT_ASSIGNABLE"), cstr("cannot assign to constant "), t[ID_NAME], cstr(""))
		} else if s[S_KIND] == SYM_FUNC {
			err_code_quoted(t[N_POS], cstr("E710 NOT_ASSIGNABLE"), cstr("cannot assign to function "), t[ID_NAME], cstr(""))
		}
		if s[S_MUT] != 0 && ck_legacy == 0 {
			// The caller passed the struct, optional or map itself: assigning the parameter
			// variable would only rebind the callee's copy and be silently lost (as mut on a
			// str is rejected). Slices stay assignable for `xs = append(xs, v)`.
			let mk = kind_of(s[S_TYPE])
			if mk == K_STRUCT || mk == K_OPT || mk == K_MAP || mk == K_DYN {
				let u = err_code(t[N_POS], cstr("E704 MUT_PARAM_REBIND"))
				buf_str(u, cstr("cannot assign to mut parameter '"))
				buf_str(u, t[ID_NAME])
				buf_str(u, cstr("': it would rebind only this function's copy, and the caller would not see it; modify its fields or elements, or return the new value"))
				err_end(u)
			}
		}
		if s[S_CAPTURED] != 0 {
			let env_ref = sym_ref_node(t[N_POS], ck_fn[F_ENV_SYM])
			let cell_addr = mk_mem(t[N_POS], env_ref, 0, 0, 8 * (2 + s[S_CAP_IDX]), ty_int)
			let val = mk_mem(t[N_POS], cell_addr, 0, 0, 0, s[S_TYPE])
			replace_node(t, val)
			return s[S_TYPE]
		}
		if s[S_CELL] != 0 {
			let cell_ref = sym_ref_node(t[N_POS], s[S_CELL_SYM])
			let val = mk_mem(t[N_POS], cell_ref, 0, 0, 0, s[S_TYPE])
			replace_node(t, val)
			return s[S_TYPE]
		}
		t[ID_REF] = s
		t[N_TYPE] = s[S_TYPE]
		return s[S_TYPE]
	}
	if k == EX_INDEX || k == EX_SELECT {
		return chk(t, 0)
	}
	if k == EX_MEM {
		return t[N_TYPE]
	}
	err_code_at(t[N_POS], cstr("E710 NOT_ASSIGNABLE"), cstr("cannot assign to this expression"))
	return ty_int
}

fn check_assign(s i64) {
	let target = s[AS_TARGET]
	let v = s[AS_VALUE]
	sb_assign(s[N_POS], target, v)
	if (v[N_KIND] == EX_TRY || v[N_KIND] == EX_CATCH || v[N_KIND] == EX_WRAP) && ck_legacy == 0 {
		lower_try_stmt(s, v, 2, 0)
		return
	}
	if v[N_KIND] == EX_MATCH && ck_legacy == 0 {
		check_match_assign(s, target, v)
		return
	}
	if target[N_KIND] == EX_IDENT && streq(target[ID_NAME], cstr("_")) != 0 {
		let vt = chk(v, 0)
		if (kind_of(vt) == K_ERROR || (kind_of(vt) == K_TUPLE && tuple_has_fault(vt) != 0)) && ck_legacy == 0 {
			err_code_at(s[N_POS], cstr("E410 UNCHECKED_FAULT"), cstr("a fault cannot be discarded with _"))
		} else {
			check_value(s[N_POS], vt)
		}
		replace_node(s, expr_stmt(v))
		return
	}
	// Map stores become runtime calls. x op= v shares the target node with v, so take
	// the target's parts before checking v.
	if target[N_KIND] == EX_INDEX && ck_legacy == 0 {
		let tx = target[IX_X]
		let ti = target[IX_I]
		let xt = chk(tx, 0)
		if kind_of(xt) == K_MAP {
			let kt = chk(ti, xt[TY_KEY])
			check_assignable(ti, kt, xt[TY_KEY])
			if is_untyped(kt) != 0 {
				reconvert(ti, xt[TY_KEY])
			}
			let vt = chk(v, xt[TY_ELEM])
			check_assignable(v, vt, xt[TY_ELEM])
			if is_untyped(vt) != 0 {
				reconvert(v, xt[TY_ELEM])
			}
			let store = map_set_call(s[N_POS], tx, ti, v, xt[TY_KEY])
			store[CALL_STORE] = 1
			replace_node(s, expr_stmt(store))
			return
		}
		if kind_of(xt) == K_STRING {
			err_code_at(target[N_POS], cstr("E710 NOT_ASSIGNABLE"), cstr("cannot assign to a str index (strings are immutable)"))
			return
		}
	}
	let tt = check_target(target)
	let vt = chk(v, tt)
	if ck_legacy == 0 {
		check_assignable(v, vt, tt)
		if is_untyped(vt) != 0 {
			reconvert(v, tt)
		}
		narrow_kill(target)
	}
	if target[N_KIND] == EX_IDENT {
		len_alias_invalidate(target[ID_REF])
	}
}

fn check_assignable(e i64, from i64, to i64) {
	if kind_of(to) == K_DYN || (kind_of(to) == K_OPT && kind_of(to[TY_ELEM]) == K_DYN) {
		sb_forbid(e[N_POS], from, cstr("a dyn value cannot hold "))
	}
	// Concrete objects convert to dyn S implicitly where they satisfy the shape. A dyn
	// value keeps its exact shape; optionality can be added, but never removed.
	if is_dyn_value(to) != 0 && is_dyn_value(from) != 0 {
		if dyn_type(from) != dyn_type(to) {
			err_code_at(e[N_POS], cstr("E514 DYN_WIDENING"), cstr("dyn values do not widen (no downcast, no dyn-to-dyn): convert from the concrete value"))
		}
		return
	}
	if kind_of(to) == K_DYN && kind_of(from) != K_DYN {
		if kind_of(from) != K_STRUCT {
			err_code_type(e[N_POS], cstr("E516 DYN_OBJECT"), cstr("only a struct or enum can be a dyn object, not "), from, cstr(""))
			return
		}
		let before = error_count
		check_shape(e[N_POS], from, to[TY_GDECL], to[TY_TARGS])
		if error_count == before {
			let x = expr_clone(e)
			let cv = mk_conv(e[N_POS], x, CV_DYN, to)
			cv[CV_DYN_TABLE] = dyn_table_add(from, dyn_type(to), e[N_POS])
			replace_node(e, cv)
		}
		return
	}
	if kind_of(to) == K_OPT && kind_of(to[TY_ELEM]) == K_DYN && kind_of(from) != K_DYN && kind_of(from) != K_OPT && kind_of(from) != K_NIL {
		if kind_of(from) != K_STRUCT {
			err_code_type(e[N_POS], cstr("E516 DYN_OBJECT"), cstr("only a struct or enum can be a dyn object, not "), from, cstr(""))
			return
		}
		let before = error_count
		check_shape(e[N_POS], from, to[TY_ELEM][TY_GDECL], to[TY_ELEM][TY_TARGS])
		if error_count == before {
			let x = expr_clone(e)
			let cv = mk_conv(e[N_POS], x, CV_DYN, to)
			cv[CV_DYN_TABLE] = dyn_table_add(from, dyn_type(to), e[N_POS])
			replace_node(e, cv)
		}
		return
	}
	if bounded_value(e, from, to) != 0 {
		return
	}
	if assignable(from, to) == 0 && ck_legacy == 0 {
		if is_query_t(to) != 0 && kind_of(from) == K_STRING {
			err_code_at(e[N_POS], cstr("E280 QUERY"), cstr("a query takes a string literal: put values in {{...}} so they are sent apart from the text, never pasted into it"))
			return
		}
		if secret_assign_error(e, from, to) != 0 {
			return
		}
		err_code_types(e[N_POS], cstr("E230 TYPE_MISMATCH"), cstr("cannot use "), from, cstr(" as "), to)
	}
}

// check_value rejects a call with no result, or several, where one value is needed.
fn check_value(pos i64, t i64) {
	if kind_of(t) == K_VOID || kind_of(t) == K_TUPLE {
		err_code_type(pos, cstr("E230 TYPE_MISMATCH"), cstr("cannot use "), t, cstr(" as a value"))
	}
}

fn check_multi(s i64) {
	// Multi-assignment lowers through generated temporaries and can rebind either a
	// remembered length or its source slice. Drop these local facts conservatively.
	len_aliases = vec_new()
	let pos = s[N_POS]
	let targets = s[MU_TARGETS]
	let values = s[MU_VALUES]
	let define = s[MU_DEFINE]
	let out = node_new(ST_BLOCK, pos)
	out[BLK_STMTS] = vec_new()
	out[BLK_FLAT] = 1
	let stmts = out[BLK_STMTS]
	let n = targets[VEC_LEN]
	let temps = vec_new()
	if define == 0 && values[VEC_LEN] == n {
		// The pairs go through temporaries: check each value against its target here.
		mut si = 0
		for si < n {
			sb_assign(pos, vec_get(targets, si), vec_get(values, si))
			si = si + 1
		}
	}
	if values[VEC_LEN] == 1 && n > 1 {
		let v = vec_get(values, 0)
		if (v[N_KIND] == EX_TRY || v[N_KIND] == EX_CATCH || v[N_KIND] == EX_WRAP) && ck_legacy == 0 {
			lower_try_stmt(s, v, 3, 0)
			return
		}
		// v, ok := m[k]
		if v[N_KIND] == EX_INDEX && n == 2 {
			let mt = chk(v[IX_X], 0)
			if kind_of(mt) == K_MAP {
				let kt = chk(v[IX_I], mt[TY_KEY])
				if is_untyped(kt) != 0 {
					reconvert(v[IX_I], mt[TY_KEY])
				}
				let get = map_read(pos, v[IX_X], v[IX_I], mt[TY_ELEM])
				vec_push(stmts, temp(pos, get, mt[TY_ELEM]))
				vec_push(temps, vec_get(stmts, 0)[LET_SYM])
				vec_push(stmts, temp(pos, rt_call(pos, cstr("rt_map_found"), vec_new(), ty_bool), ty_bool))
				vec_push(temps, vec_get(stmts, 1)[LET_SYM])
				bind_targets(pos, targets, temps, define, stmts)
				replace_node(s, out)
				return
			}
		}
		let t = chk(v, 0)
		if kind_of(t) != K_TUPLE || t[TY_FIELDS][VEC_LEN] != n {
			err_code_at(pos, cstr("E234 VALUE_COUNT"), cstr("assignment count mismatch"))
			return
		}
		let cm = node_new(ST_CALLMULTI, pos)
		cm[CM_CALL] = v
		cm[CM_SYMS] = vec_new()
		mut i = 0
		for i < n {
			let ts = declare_local(pos, cstr("$"), vec_get(t[TY_FIELDS], i))
			vec_push(cm[CM_SYMS], ts)
			vec_push(temps, ts)
			i = i + 1
		}
		v[N_TYPE] = ty_void
		vec_push(stmts, cm)
		bind_targets(pos, targets, temps, define, stmts)
		replace_node(s, out)
		return
	}
	if values[VEC_LEN] != n {
		err_code_at(pos, cstr("E234 VALUE_COUNT"), cstr("assignment count mismatch"))
		return
	}
	// Evaluate every value first, then assign: a, b = b, a swaps.
	mut i = 0
	for i < n {
		let v = vec_get(values, i)
		mut want = 0
		let tg = vec_get(targets, i)
		if define == 0 && !(tg[N_KIND] == EX_IDENT && streq(tg[ID_NAME], cstr("_")) != 0) {
			want = check_target_type(tg)
		}
		mut vt = chk(v, want)
		check_value(v[N_POS], vt)
		if is_untyped(vt) != 0 {
			vt = reconvert(v, default_type(vt))
		}
		let l = temp(pos, v, default_type(vt))
		vec_push(stmts, l)
		vec_push(temps, l[LET_SYM])
		i = i + 1
	}
	bind_targets(pos, targets, temps, define, stmts)
	replace_node(s, out)
}

// check_target_type reports a target's type without rewriting it.
fn check_target_type(t i64) i64 {
	if t[N_KIND] == EX_IDENT {
		let s = lookup_name(t[ID_NAME])
		if s != 0 {
			return s[S_TYPE]
		}
	}
	return 0
}

fn splice_list(s i64, block i64) {
	let l = node_new(ST_LIST, s[N_POS])
	replace_node(s, block)
}

// bind_targets assigns (or, for :=, declares) each target from its temp.
fn bind_targets(pos i64, targets i64, temps i64, define i64, stmts i64) {
	mut i = 0
	for i < targets[VEC_LEN] {
		let tg = vec_get(targets, i)
		let ts = vec_get(temps, i)
		if tg[N_KIND] == EX_IDENT && streq(tg[ID_NAME], cstr("_")) != 0 {
			if kind_of(ts[S_TYPE]) == K_ERROR && ck_legacy == 0 {
				err_code_at(tg[N_POS], cstr("E410 UNCHECKED_FAULT"), cstr("a fault cannot be discarded with _"))
			}
			i = i + 1
			continue
		}
		if define != 0 {
			if tg[N_KIND] != EX_IDENT {
				err_code_at(tg[N_POS], cstr("E020 UNEXPECTED"), cstr("expected a name before :="))
			} else if in_current_scope(tg[ID_NAME]) == 0 {
				let l = node_new(ST_LET, pos)
				l[LET_NAME] = tg[ID_NAME]
				l[LET_INIT] = sym_ref_node(pos, ts)
				let sym = declare_local(pos, tg[ID_NAME], ts[S_TYPE])
				l[LET_SYM] = sym
				if sym[S_CELL] != 0 {
					let csym = sym[S_CELL_SYM]
					let alloc_call = rt_call(pos, cstr("rt_alloc"), args1(mk_int(pos, 8, ty_int)), ty_int)
					vec_push(stmts, let_stmt(pos, csym, alloc_call))
					vec_push(stmts, assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, csym), 0, 0, 0, ts[S_TYPE]), sym_ref_node(pos, ts)))
					i = i + 1
					continue
				}
				vec_push(stmts, l)
				i = i + 1
				continue
			}
		}
		let a = assign_stmt(pos, tg, sym_ref_node(pos, ts))
		check_assign(a)
		vec_push(stmts, a)
		i = i + 1
	}
}

fn check_return(s i64) {
	let f = ck_fn
	let want = f[F_RTYPES]
	let pos = s[N_POS]
	if s[RET_VALUE] != 0 && (s[RET_VALUE][N_KIND] == EX_TRY || s[RET_VALUE][N_KIND] == EX_CATCH || s[RET_VALUE][N_KIND] == EX_WRAP) && ck_legacy == 0 {
		lower_try_stmt(s, s[RET_VALUE], 4, 0)
		return
	}
	if s[RET_VALUE] != 0 && s[RET_VALUE][N_KIND] == EX_MATCH && ck_legacy == 0 {
		// return match ...: each arm returns its value (#225).
		replace_node(s, lower_match(s[RET_VALUE], MATCH_RETURN, 0))
		return
	}
	if f[F_BANG] != 0 && ck_legacy == 0 {
		// In a !T function, return gives the values; the fault slot is filled with nil.
		let nw = want[VEC_LEN] - 1
		if s[RET_VALUES] != 0 {
			if s[RET_VALUES][VEC_LEN] == want[VEC_LEN] {
				err_code_at(pos, cstr("E412 RETURN_FAULT"), cstr("a !T function returns only its values: use fail to return a fault"))
				return
			}
			if s[RET_VALUES][VEC_LEN] == nw {
				vec_push(s[RET_VALUES], mk_int(pos, 0, ty_error))
			}
		} else if s[RET_VALUE] != 0 {
			if nw == 0 {
				err_code_at(pos, cstr("E412 RETURN_FAULT"), cstr("a ! function returns no value: use fail to return a fault"))
				return
			}
			if nw == 1 {
				let rv = vec_new()
				vec_push(rv, s[RET_VALUE])
				vec_push(rv, mk_int(pos, 0, ty_error))
				s[RET_VALUES] = rv
				s[RET_VALUE] = 0
			}
		} else if nw == 0 {
			s[RET_VALUE] = mk_int(pos, 0, ty_error)
			return
		}
	}
	if s[RET_VALUES] != 0 {
		let vals = s[RET_VALUES]
		if vals[VEC_LEN] != want[VEC_LEN] {
			err_code_at(pos, cstr("E262 RETURN_COUNT"), cstr("wrong number of return values"))
			return
		}
		mut i = 0
		for i < vals[VEC_LEN] {
			let v = vec_get(vals, i)
			let vt = chk(v, vec_get(want, i))
			check_assignable(v, vt, vec_get(want, i))
			if is_untyped(vt) != 0 {
				reconvert(v, vec_get(want, i))
			}
			i = i + 1
		}
		return
	}
	let v = s[RET_VALUE]
	if v == 0 {
		if want[VEC_LEN] > 0 && ck_legacy == 0 {
			err_code_at(pos, cstr("E262 RETURN_COUNT"), cstr("missing return value"))
		}
		return
	}
	if want[VEC_LEN] == 0 {
		err_code_at(v[N_POS], cstr("E262 RETURN_COUNT"), cstr("too many return values"))
		chk(v, 0)
		return
	}
	if want[VEC_LEN] > 1 {
		// return f() where f returns as many values: pass them through.
		let t = chk(v, 0)
		if kind_of(t) != K_TUPLE || t[TY_FIELDS][VEC_LEN] != want[VEC_LEN] {
			err_code_at(pos, cstr("E262 RETURN_COUNT"), cstr("wrong number of return values"))
			return
		}
		let out = empty_block(pos)
		out[BLK_FLAT] = 1
		let cm = node_new(ST_CALLMULTI, pos)
		cm[CM_CALL] = v
		cm[CM_SYMS] = vec_new()
		let vals2 = vec_new()
		mut i = 0
		for i < want[VEC_LEN] {
			let ts = declare_local(pos, cstr("$"), vec_get(t[TY_FIELDS], i))
			vec_push(cm[CM_SYMS], ts)
			vec_push(vals2, sym_ref_node(pos, ts))
			i = i + 1
		}
		v[N_TYPE] = ty_void
		vec_push(out[BLK_STMTS], cm)
		let r = node_new(ST_RETURN, pos)
		r[RET_VALUES] = vals2
		vec_push(out[BLK_STMTS], r)
		replace_node(s, out)
		return
	}
	let vt = chk(v, vec_get(want, 0))
	check_assignable(v, vt, vec_get(want, 0))
	if is_untyped(vt) != 0 {
		reconvert(v, vec_get(want, 0))
	}
}

// lower_try_stmt compiles the five places try may appear:
//   0 try f()   1 x := try f()   2 x = try f()   3 a, b := try f()   4 return try f()
// into: results := f(); if fault != nil { return zero values..., fault }; then use them.
// With tr an EX_CATCH (E catch name { ... }) the fault runs the catch block instead of
// returning; a value catch assigns the block's last expression to the result.
fn lower_try_stmt(s i64, tr_in i64, mode i64, declared i64) {
	mut tr = tr_in
	let pos = s[N_POS]
	// try E wrap "msg" (edition 1): the fault passed upward is fault.Wrap(err, msg).
	mut wrapmsg = 0
	if tr[N_KIND] == EX_WRAP {
		wrapmsg = tr[WRAP_MESSAGE]
		if tr[WRAP_X][N_KIND] != EX_TRY {
			err_code_at(tr[N_POS], cstr("E413 WRAP"), cstr("wrap adds context to the fault try passes upward: write try E wrap \"msg\""))
			return
		}
		tr = tr[WRAP_X]
	}
	let call = tr[TRY_X]
	mut handler = 0
	if tr[N_KIND] == EX_CATCH {
		handler = tr
	}
	let f = ck_fn
	let frs = f[F_RTYPES]
	let hasf = i64(frs[VEC_LEN] > 0 && kind_of(vec_get(frs, frs[VEC_LEN] - 1)) == K_ERROR)
	if handler == 0 && hasf == 0 {
		err_code_at(pos, cstr("E411 NO_FAULT_RESULT"), cstr("try needs the enclosing function to return a fault (write its result as !T)"))
		return
	}
	bound_want = bound_target(s, call, mode, declared)
	let t = chk(call, 0)
	bound_want = 0
	mut results = vec_new()
	if kind_of(t) == K_TUPLE {
		results = t[TY_FIELDS]
	} else if kind_of(t) != K_VOID {
		vec_push(results, t)
	}
	if mode == 5 && handler == 0 && tr[TRY_SOFT] != 0 && (results[VEC_LEN] == 0 || kind_of(vec_get(results, results[VEC_LEN] - 1)) != K_ERROR) {
		// A parallel line that cannot fail: its value, if any, is stored as is.
		bound_t = ty_void
		if results[VEC_LEN] == 1 {
			bound_t = default_type(t)
			if is_untyped(t) != 0 {
				reconvert(call, bound_t)
			}
			replace_node(s, bound_store(pos, call, bound_t))
		} else if results[VEC_LEN] == 0 {
			replace_node(s, expr_stmt(call))
		} else {
			err_code_at(pos, cstr("E234 VALUE_COUNT"), cstr("a parallel line gives one value"))
		}
		return
	}
	if results[VEC_LEN] == 0 || kind_of(vec_get(results, results[VEC_LEN] - 1)) != K_ERROR {
		if handler != 0 {
			err_code_at(pos, cstr("E414 NOT_FALLIBLE"), cstr("catch needs a call whose result can be a fault (!T)"))
		} else {
			err_code_at(pos, cstr("E414 NOT_FALLIBLE"), cstr("try needs a call whose last result is a fault"))
		}
		return
	}
	let out = empty_block(pos)
	out[BLK_FLAT] = 1
	let stmts = out[BLK_STMTS]
	let temps = vec_new()
	if results[VEC_LEN] == 1 {
		let tl = temp(pos, call, ty_error)
		vec_push(stmts, tl)
		vec_push(temps, tl[LET_SYM])
	} else {
		let cm = node_new(ST_CALLMULTI, pos)
		cm[CM_CALL] = call
		cm[CM_SYMS] = vec_new()
		mut i = 0
		for i < results[VEC_LEN] {
			let ts = declare_local(pos, cstr("$"), vec_get(results, i))
			vec_push(cm[CM_SYMS], ts)
			vec_push(temps, ts)
			i = i + 1
		}
		call[N_TYPE] = ty_void
		vec_push(stmts, cm)
	}
	let errsym = vec_get(temps, temps[VEC_LEN] - 1)
	errsym[S_READS] = 1
	let nvals = temps[VEC_LEN] - 1
	// if fault != nil { return zero..., fault }   (or, with catch: { the catch block })
	let ifs = node_new(ST_IF, pos)
	ifs[IF_COND] = mk_bin(pos, cstr("!="), sym_ref_node(pos, errsym), mk_int(pos, 0, ty_error), ty_bool)
	ifs[IF_THEN] = empty_block(pos)
	if handler != 0 {
		let needv = i64((mode == 1 || mode == 2 || mode == 4) && nvals == 1)
		if nvals >= 1 {
			// The block's value is assigned by name: give the value temp a name of its own.
			catch_seq = catch_seq + 1
			let nb = buf_new()
			buf_str(nb, cstr("$catch"))
			buf_int(nb, catch_seq)
			buf_byte(nb, 0)
			vec_get(temps, 0)[S_NAME] = nb[VEC_DATA]
		}
		if (mode == 3 || ((mode == 4 || mode == 1 || mode == 2) && nvals > 1)) && ends_in_jump(handler[CATCH_BODY][BLK_STMTS]) == 0 {
			err_code_at(handler[N_POS], cstr("E415 CATCH_VALUE"), cstr("this catch block must leave (return, break, continue or fail): there is no single value to give"))
			return
		}
		ifs[IF_THEN][BLK_STMTS] = catch_body(pos, handler, temps, errsym, needv)
	} else {
		mut fx = sym_ref_node(pos, errsym)
		if wrapmsg != 0 {
			// The message is evaluated only on the fault path.
			let wdesc = secret_desc(wrapmsg)
			let mt = chk(wrapmsg, ty_string)
			secret_sink(wrapmsg[N_POS], cstr("wrap would put "), cstr(" in a fault message"), wdesc, mt)
			if kind_of(mt) != K_STRING {
				err_code_type(wrapmsg[N_POS], cstr("E413 WRAP"), cstr("wrap needs a str message, not "), mt, cstr(""))
			}
			fx = rt_call(pos, cstr("rt_fault_wrap"), args2(fx, wrapmsg), ty_error)
		}
		vec_push(ifs[IF_THEN][BLK_STMTS], fault_return(pos, ifs[IF_THEN][BLK_STMTS], fx))
	}
	vec_push(stmts, ifs)
	if mode == 5 {
		// A boundary block's last expression: its value, if any, goes through $r.
		bound_t = ty_void
		if nvals == 1 {
			bound_t = vec_get(temps, 0)[S_TYPE]
			vec_push(stmts, bound_store(pos, sym_ref_node(pos, vec_get(temps, 0)), bound_t))
		} else if nvals > 1 {
			err_code_at(pos, cstr("E234 VALUE_COUNT"), cstr("a boundary block's last expression gives one value"))
		}
	} else if mode == 1 {
		if nvals != 1 {
			err_code_at(pos, cstr("E234 VALUE_COUNT"), cstr("try here needs a call with exactly one result besides the fault"))
			return
		}
		let vs = vec_get(temps, 0)
		if declared != 0 {
			check_assignable(s, vs[S_TYPE], declared)
		}
		if streq(s[LET_NAME], cstr("_")) != 0 {
			replace_node(s, out)
			return
		}
		let l = node_new(ST_LET, pos)
		l[LET_NAME] = s[LET_NAME]
		l[LET_INIT] = sym_ref_node(pos, vs)
		l[LET_SYM] = declare_local(pos, s[LET_NAME], vs[S_TYPE])
		vec_push(stmts, l)
	} else if mode == 2 {
		if nvals != 1 {
			err_code_at(pos, cstr("E234 VALUE_COUNT"), cstr("try here needs a call with exactly one result besides the fault"))
			return
		}
		let a = assign_stmt(pos, s[AS_TARGET], sym_ref_node(pos, vec_get(temps, 0)))
		check_assign(a)
		vec_push(stmts, a)
	} else if mode == 3 {
		let targets = s[MU_TARGETS]
		if targets[VEC_LEN] != nvals {
			err_code_at(pos, cstr("E234 VALUE_COUNT"), cstr("assignment count mismatch"))
			return
		}
		let vals = vec_new()
		mut i = 0
		for i < nvals {
			vec_push(vals, vec_get(temps, i))
			i = i + 1
		}
		bind_targets(pos, targets, vals, s[MU_DEFINE], stmts)
	} else if mode == 4 && hasf == 0 {
		// return f() catch ... in a function that cannot fail: return just the values.
		if nvals != frs[VEC_LEN] {
			err_code_at(pos, cstr("E262 RETURN_COUNT"), cstr("wrong number of return values"))
			return
		}
		let r = node_new(ST_RETURN, pos)
		if nvals == 1 {
			check_assignable(s, vec_get(temps, 0)[S_TYPE], vec_get(frs, 0))
			r[RET_VALUE] = sym_ref_node(pos, vec_get(temps, 0))
		} else {
			let rv3 = vec_new()
			mut i = 0
			for i < nvals {
				check_assignable(s, vec_get(temps, i)[S_TYPE], vec_get(frs, i))
				vec_push(rv3, sym_ref_node(pos, vec_get(temps, i)))
				i = i + 1
			}
			r[RET_VALUES] = rv3
		}
		vec_push(stmts, r)
	} else if mode == 4 {
		if nvals != frs[VEC_LEN] - 1 {
			err_code_at(pos, cstr("E262 RETURN_COUNT"), cstr("wrong number of return values"))
			return
		}
		let r = node_new(ST_RETURN, pos)
		if frs[VEC_LEN] == 1 {
			r[RET_VALUE] = mk_int(pos, 0, ty_error)
		} else {
			let rv2 = vec_new()
			mut i = 0
			for i < nvals {
				let ts = vec_get(temps, i)
				check_assignable(s, ts[S_TYPE], vec_get(frs, i))
				vec_push(rv2, sym_ref_node(pos, ts))
				i = i + 1
			}
			vec_push(rv2, mk_int(pos, 0, ty_error))
			r[RET_VALUES] = rv2
		}
		vec_push(stmts, r)
	}
	replace_node(s, out)
}

shared mut catch_seq i64 // numbers the value temps of catch blocks

// fault_return is `return zero values..., fault` for the current function; statements that
// build zero values (a struct's fields) go into body before it.
fn fault_return(pos i64, body i64, fault i64) i64 {
	if ck_fn == arena_check_fn {
		arena_fail_count = arena_fail_count + 1
	}
	let frs = ck_fn[F_RTYPES]
	let ret = node_new(ST_RETURN, pos)
	if frs[VEC_LEN] == 1 {
		ret[RET_VALUE] = fault
		return ret
	}
	let rv = vec_new()
	mut i = 0
	for i < frs[VEC_LEN] - 1 {
		let rt = vec_get(frs, i)
		let rk = kind_of(rt)
		if is_float_t(rt) != 0 {
			vec_push(rv, zero_value(pos, ty_float))
		} else if ck_legacy == 0 && (rk == K_STRING || rk == K_SLICE || rk == K_MAP || rk == K_STRUCT) {
			// A str, slice, map or struct is never nil, even next to a fault.
			vec_push(rv, argo_new(pos, body, rt))
		} else {
			vec_push(rv, mk_int(pos, 0, rt))
		}
		i = i + 1
	}
	vec_push(rv, fault)
	ret[RET_VALUES] = rv
	return ret
}

// catch_body checks a catch block with its fault bound to name (unless _). With needv the
// block's last expression becomes the value: it is assigned to the call's first result.
fn catch_body(pos i64, c i64, temps i64, errsym i64, needv i64) i64 {
	let user = c[CATCH_BODY][BLK_STMTS]
	let n = user[VEC_LEN]
	mut valued = i64(needv != 0 && ends_in_jump(user) == 0)
	if valued != 0 && (n == 0 || vec_get(user, n - 1)[N_KIND] != ST_EXPR) {
		err_code_at(c[N_POS], cstr("E415 CATCH_VALUE"), cstr("a catch block must end with the value to use, or leave (return, break, continue or fail)"))
		return vec_new()
	}
	if valued != 0 && vec_get(user, n - 1)[ES_X][N_KIND] == EX_MATCH {
		// A match as the block's value: its arms assign the value temp, and may leave (#225).
		let ml = vec_get(user, n - 1)
		user[VEC_DATA][n - 1] = assign_stmt(ml[N_POS], sym_ref_node(ml[N_POS], vec_get(temps, 0)), ml[ES_X])
		valued = 0
	}
	let out = vec_new()
	push_scope()
	if streq(c[CATCH_NAME], cstr("_")) == 0 {
		let es = declare_local(pos, c[CATCH_NAME], ty_error)
		vec_push(out, let_stmt(pos, es, sym_ref_node(pos, errsym)))
	}
	if valued != 0 {
		// Everything before the last statement runs; the last one is the value.
		let last = vec_get(user, n - 1)
		user[VEC_LEN] = n - 1
		check_stmts(user)
		user[VEC_LEN] = n
		let vt = vec_get(temps, 0)
		let lt = chk(last[ES_X], vt[S_TYPE])
		if kind_of(lt) == K_VOID {
			err_code_at(last[N_POS], cstr("E415 CATCH_VALUE"), cstr("a catch block must end with the value to use, or leave (return, break, continue or fail)"))
		} else {
			let a = assign_stmt(last[N_POS], sym_ref_node(last[N_POS], vt), last[ES_X])
			check_assign(a)
			user[VEC_DATA][n - 1] = a
		}
	} else {
		check_stmts(user)
	}
	pop_scope()
	mut i = 0
	for i < user[VEC_LEN] {
		vec_push(out, vec_get(user, i))
		i = i + 1
	}
	return out
}

// check_fail lowers `fail X` to `return zero values..., fault`, X a str message or a fault.
fn check_fail(s i64) {
	let pos = s[N_POS]
	let frs = ck_fn[F_RTYPES]
	if frs[VEC_LEN] == 0 || kind_of(vec_get(frs, frs[VEC_LEN] - 1)) != K_ERROR {
		err_code_at(pos, cstr("E411 NO_FAULT_RESULT"), cstr("fail needs the enclosing function to return a fault (write its result as !T)"))
		return
	}
	mut x = s[FAIL_X]
	let fdesc = secret_desc(x)
	let t = chk(x, 0)
	secret_sink(x[N_POS], cstr("fail would put "), cstr(" in a fault message"), fdesc, t)
	if kind_of(t) == K_STRING {
		x = rt_call(pos, cstr("rt_fail"), args1(x), ty_error)
	} else if kind_of(t) != K_ERROR {
		err_code_type(pos, cstr("E416 FAIL_VALUE"), cstr("fail needs a str message or a fault, not "), t, cstr(""))
		return
	}
	let out = empty_block(pos)
	out[BLK_FLAT] = 1
	vec_push(out[BLK_STMTS], fault_return(pos, out[BLK_STMTS], x))
	replace_node(s, out)
}

// lower_range rewrites a range loop as a counted (or map-slot) loop and checks it.
// Element reads it generates, and the body's own x[i] on the ranged slice, skip the
// bounds check: the counter stays below the length captured before the loop.
fn lower_range(s i64) {
	let pos = s[N_POS]
	let x = s[RG_EXPR]
	mut xname = 0
	if x[N_KIND] == EX_IDENT {
		xname = x[ID_NAME]
	}
	let xt = chk(x, 0)
	let k = kind_of(xt)
	let out = empty_block(pos)
	let stmts = out[BLK_STMTS]
	push_scope()
	let src = temp(pos, x, xt)
	vec_push(stmts, src)
	let ss = src[LET_SYM]
	let key = s[RG_KEY]
	let val = s[RG_VAL]
	let body = s[RG_BODY]
	let pre = vec_new()
	let w = node_new(ST_WHILE, pos)
	mut it = ty_int
	if is_integer_t(xt) != 0 {
		it = default_type(xt)
		if is_untyped(xt) != 0 {
			reconvert(x, ty_int)
		}
	}
	let i = declare_local(pos, cstr("$"), it)
	vec_push(stmts, let_stmt(pos, i, mk_int(pos, 0, it)))
	mut limit_ = 0
	mut step = mk_bin(pos, cstr("+"), sym_ref_node(pos, i), mk_int(pos, 1, it), it)
	let keysym = 0
	if is_integer_t(xt) != 0 {
		limit_ = sym_ref_node(pos, ss)
		if key != 0 {
			vec_push(pre, range_bind(pos, key, sym_ref_node(pos, i), it, s[RG_DEFINE]))
		}
	} else if k == K_SLICE || k == K_STRING {
		let n = temp(pos, mk_hdr(pos, sym_ref_node(pos, ss), 0), ty_int)
		vec_push(stmts, n)
		limit_ = sym_ref_node(pos, n[LET_SYM])
		if key != 0 {
			vec_push(pre, range_bind(pos, key, sym_ref_node(pos, i), ty_int, s[RG_DEFINE]))
		}
		if k == K_SLICE && val != 0 {
			let et = secret_like(xt, xt[TY_ELEM])
			let elem = mk_elem(pos, sym_ref_node(pos, ss), sym_ref_node(pos, i), et, 0)
			elem[ELEM_SAFE] = 1
			vec_push(pre, range_bind(pos, val, elem, et, s[RG_DEFINE]))
		}
		if k == K_STRING {
			// Strings range over runes: rt_utf8 packs the rune and its width.
			let packed = temp(pos, rt_call(pos, cstr("rt_utf8"), args2(sym_ref_node(pos, ss), sym_ref_node(pos, i)), ty_int), ty_int)
			vec_push(pre, packed)
			let nexti = temp(pos, mk_bin(pos, cstr("+"), sym_ref_node(pos, i), mk_bin(pos, cstr(">>"), sym_ref_node(pos, packed[LET_SYM]), mk_int(pos, 32, ty_int), ty_int), ty_int), ty_int)
			vec_push(pre, nexti)
			step = sym_ref_node(pos, nexti[LET_SYM])
			if val != 0 {
				let rune = mk_conv(pos, mk_bin(pos, cstr("&"), sym_ref_node(pos, packed[LET_SYM]), mk_int(pos, 0xffffffff, ty_int), ty_int), CV_INT, ty_i32)
				vec_push(pre, range_bind(pos, val, rune, secret_like(xt, ty_i32), s[RG_DEFINE]))
			}
		}
	} else if k == K_MAP {
		let cap_ = temp(pos, rt_call(pos, cstr("rt_map_slots"), args1(sym_ref_node(pos, ss)), ty_int), ty_int)
		vec_push(stmts, cap_)
		limit_ = sym_ref_node(pos, cap_[LET_SYM])
		// Only live slots run the body.
		let live = node_new(ST_IF, pos)
		live[IF_COND] = mk_bin(pos, cstr("=="), rt_call(pos, cstr("rt_map_live"), args2(sym_ref_node(pos, ss), sym_ref_node(pos, i)), ty_int), mk_int(pos, 0, ty_int), ty_bool)
		let skip = empty_block(pos)
		vec_push(skip[BLK_STMTS], node_new(ST_CONTINUE, pos))
		live[IF_THEN] = skip
		vec_push(pre, live)
		if key != 0 {
			let kv = key_out(rt_call(pos, cstr("rt_map_key"), args2(sym_ref_node(pos, ss), sym_ref_node(pos, i)), ty_int), xt[TY_KEY])
			vec_push(pre, range_bind(pos, key, kv, secret_like(xt, xt[TY_KEY]), s[RG_DEFINE]))
		}
		if val != 0 {
			let vv = from_bits(rt_call(pos, cstr("rt_map_val"), args2(sym_ref_node(pos, ss), sym_ref_node(pos, i)), ty_int), xt[TY_ELEM])
			vec_push(pre, range_bind(pos, val, vv, secret_like(xt, xt[TY_ELEM]), s[RG_DEFINE]))
		}
	} else {
		err_code_type(pos, cstr("E263 RANGE"), cstr("cannot range over "), xt, cstr(""))
		pop_scope()
		return
	}
	w[WH_COND] = mk_bin(pos, cstr("<"), sym_ref_node(pos, i), limit_, ty_bool)
	w[WH_POST] = assign_stmt(pos, sym_ref_node(pos, i), step)
	let nb = empty_block(pos)
	mut j = 0
	for j < pre[VEC_LEN] {
		vec_push(nb[BLK_STMTS], vec_get(pre, j))
		j = j + 1
	}
	vec_push(nb[BLK_STMTS], body)
	w[WH_BODY] = nb
	vec_push(stmts, w)
	replace_node(s, out)
	// The body's s[key] on the ranged slice is safe while neither name is reassigned.
	let saved = safe_pairs[VEC_LEN]
	ck_loops = ck_loops + 1
	ck_breaks = ck_breaks + 1
	push_scope()
	check_pre_stmts(nb[BLK_STMTS])
	if (k == K_SLICE || k == K_STRING) && key != 0 && key[N_KIND] == EX_IDENT && s[RG_DEFINE] != 0 && xname != 0 && names_assigned(body, xname, key[ID_NAME]) == 0 {
		let ks = lookup_name_local(key[ID_NAME])
		let xs = lookup_name(xname)
		if ks != 0 && xs != 0 && xs[S_KIND] == SYM_LOCAL {
			vec_push(safe_pairs, pair(ks, xs))
		}
	}
	check_stmt(body)
	safe_pairs[VEC_LEN] = saved
	pop_scope()
	ck_loops = ck_loops - 1
	ck_breaks = ck_breaks - 1
	pop_scope()
}

// check_pre_stmts declares the already-checked lets a lowered loop puts before its
// body, so the body can see them; the body itself is checked by the caller.
fn check_pre_stmts(stmts i64) {
	mut i = 0
	for i < stmts[VEC_LEN] - 1 {
		let s = vec_get(stmts, i)
		if s[N_KIND] == ST_LET && s[LET_SYM] != 0 {
			vec_push(sc_syms, s[LET_SYM])
		} else if s[N_KIND] == ST_BLOCK && s[BLK_FLAT] != 0 && s[4] != 0 {
			// a celled range variable: its cell sym is already a local, the variable itself enters scope
			vec_push(sc_syms, s[4])
		} else if s[N_KIND] == ST_IF && s[IF_COND][N_TYPE] != 0 {
		} else {
			check_stmt(s)
		}
		i = i + 1
	}
}

// range_bind binds a range key or value: a new variable for :=, else an assignment.
fn range_bind(pos i64, target i64, value i64, t i64, define i64) i64 {
	if target[N_KIND] == EX_IDENT && streq(target[ID_NAME], cstr("_")) != 0 {
		return empty_block(pos)
	}
	if define != 0 {
		let l = node_new(ST_LET, pos)
		l[LET_NAME] = target[ID_NAME]
		l[LET_INIT] = value
		l[LET_SYM] = sym_new(SYM_LOCAL, target[ID_NAME], pos)
		l[LET_SYM][S_TYPE] = t
		l[LET_SYM][S_SLOT] = ck_fn[F_SLOTS]
		ck_fn[F_SLOTS] = ck_fn[F_SLOTS] + 1
		vec_push(ck_fn[F_LOCALS], l[LET_SYM])
		if ck_escaping_cells != 0 && vec_has_str(ck_escaping_cells, target[ID_NAME]) != 0 {
			// A variable a closure captures lives in a cell, and each iteration allocates its own.
			let sym = l[LET_SYM]
			sym[S_CELL] = 1
			let csym = sym_new(SYM_LOCAL, str_cat3(cstr("$cell_"), target[ID_NAME], cstr("")), pos)
			csym[S_TYPE] = ty_int
			csym[S_READS] = 1
			csym[S_SLOT] = ck_fn[F_SLOTS]
			ck_fn[F_SLOTS] = ck_fn[F_SLOTS] + 1
			vec_push(ck_fn[F_LOCALS], csym)
			sym[S_CELL_SYM] = csym
			let alloc_call = rt_call(pos, cstr("rt_alloc"), args1(mk_int(pos, 8, ty_int)), ty_int)
			let blk = node_new(ST_BLOCK, pos)
			blk[BLK_STMTS] = vec_new()
			vec_push(blk[BLK_STMTS], let_stmt(pos, csym, alloc_call))
			vec_push(blk[BLK_STMTS], assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, csym), 0, 0, 0, t), value))
			blk[BLK_FLAT] = 1
			blk[4] = sym
			return blk
		}
		return l
	}
	let a = assign_stmt(pos, target, value)
	return a
}

// lower_switch turns a switch into an if-chain inside a block that break can leave.
fn lower_switch(s i64) {
	let pos = s[N_POS]
	if s[SW_TAG] != 0 && s[SW_INIT] != 0 {
		// switch init; x { ... }  is  { init; switch x { ... } }.
		let blk = empty_block(pos)
		vec_push(blk[BLK_STMTS], s[SW_INIT])
		let inner = node_new(ST_SWITCH, pos)
		inner[SW_TAG] = s[SW_TAG]
		inner[SW_CASES] = s[SW_CASES]
		vec_push(blk[BLK_STMTS], inner)
		replace_node(s, blk)
		check_scoped(s)
		return
	}
	if s[SW_TAG] != 0 {
		let tt = chk(s[SW_TAG], 0)
		if kind_of(tt) == K_STRUCT && tt[TY_ENUM] != 0 {
			lower_enum_switch(s, tt)
			return
		}
	}
	// switch err { case ErrX: } compares each case with fault.Is (design_semantics section 2).
	let faultsw = i64(s[SW_TAG] != 0 && ck_legacy == 0 && kind_of(chk(s[SW_TAG], 0)) == K_ERROR)
	let out = empty_block(pos)
	if s[SW_INIT] != 0 {
		vec_push(out[BLK_STMTS], s[SW_INIT])
	}
	let w = node_new(ST_WHILE, pos)
	w[WH_ONCE] = 1
	w[WH_COND] = mk_int(pos, 1, ty_bool)
	let body = empty_block(pos)
	w[WH_BODY] = body
	let tag = s[SW_TAG]
	mut tagname = 0
	if tag != 0 {
		// switch x { case a, b: }  compares a hidden copy of x.
		tagname = node_new(EX_IDENT, pos)
		tagname[ID_NAME] = cstr("$sw")
		let l = node_new(ST_LET, pos)
		l[LET_NAME] = cstr("$sw")
		l[LET_INIT] = tag
		vec_push(body[BLK_STMTS], l)
	}
	mut first = 0
	mut last = 0
	mut deflt = 0
	let cases = s[SW_CASES]
	mut i = 0
	for i < cases[VEC_LEN] {
		let c = vec_get(cases, i)
		let exprs = vec_get(c, 0)
		let blk = vec_get(c, 1)
		if exprs == 0 {
			deflt = blk
		} else {
			mut cond = 0
			mut j = 0
			for j < exprs[VEC_LEN] {
				mut e = vec_get(exprs, j)
				if tag != 0 {
					let id = node_new(EX_IDENT, pos)
					id[ID_NAME] = cstr("$sw")
					e = binary_new(e[N_POS], cstr("=="), id, e)
					if faultsw != 0 {
						e[BIN_OP] = cstr("$is")
						id[N_POS] = e[BIN_R][N_POS]
					}
				}
				if cond != 0 {
					cond = binary_new(e[N_POS], cstr("||"), cond, e)
				} else {
					cond = e
				}
				j = j + 1
			}
			let ifs = node_new(ST_IF, blk[N_POS])
			ifs[IF_COND] = cond
			ifs[IF_THEN] = blk
			if last != 0 {
				last[IF_ELSE] = ifs
			} else {
				first = ifs
			}
			last = ifs
		}
		i = i + 1
	}
	if deflt != 0 {
		if last != 0 {
			last[IF_ELSE] = deflt
		} else {
			first = deflt
		}
	}
	if first != 0 {
		vec_push(body[BLK_STMTS], first)
	}
	vec_push(out[BLK_STMTS], w)
	replace_node(s, out)
	push_scope()
	mut k = 0
	for k < out[BLK_STMTS][VEC_LEN] - 1 {
		check_stmt(vec_get(out[BLK_STMTS], k))
		k = k + 1
	}
	ck_breaks = ck_breaks + 1
	check_scoped(body)
	ck_breaks = ck_breaks - 1
	pop_scope()
}

// enum_pattern reads a case pattern: Variant, Variant(a, b) or Shape.Variant(a, b). It
// returns [name, binding names] or 0.
fn enum_pattern(e i64) i64 {
	let r = vec_new()
	let names = vec_new()
	let k = e[N_KIND]
	if k == EX_IDENT {
		vec_push(r, e[ID_NAME])
	} else if k == EX_SELECT {
		vec_push(r, e[SEL_NAME])
	} else if k == EX_CALL {
		if e[CALL_NAME] != 0 {
			vec_push(r, e[CALL_NAME])
		} else if e[CALL_CALLEE] != 0 && e[CALL_CALLEE][N_KIND] == EX_SELECT {
			vec_push(r, e[CALL_CALLEE][SEL_NAME])
		} else {
			return 0
		}
		let args = e[CALL_ARGS]
		mut i = 0
		for i < args[VEC_LEN] {
			let a = vec_get(args, i)
			if a[N_KIND] != EX_IDENT {
				return 0
			}
			vec_push(names, a[ID_NAME])
			i = i + 1
		}
	} else {
		return 0
	}
	vec_push(r, names)
	return r
}

// lower_enum_switch compiles switch s { case Circle(r): ... } on an enum: one branch per
// variant tag, binding the variant's fields; every variant must be covered (or default).
fn lower_enum_switch(s i64, t i64) {
	let pos = s[N_POS]
	let vs = t[TY_ENUM]
	let out = empty_block(pos)
	push_scope()
	let tmp = temp(pos, s[SW_TAG], t)
	vec_push(out[BLK_STMTS], tmp)
	let w = node_new(ST_WHILE, pos)
	w[WH_ONCE] = 1
	w[WH_COND] = mk_int(pos, 1, ty_bool)
	let body = empty_block(pos)
	w[WH_BODY] = body
	let seen = vec_filled(vs[VEC_LEN], 0)
	mut first = 0
	mut last = 0
	mut deflt = 0
	let cases = s[SW_CASES]
	mut i = 0
	for i < cases[VEC_LEN] {
		let c = vec_get(cases, i)
		let exprs = vec_get(c, 0)
		let blk = vec_get(c, 1)
		if exprs == 0 {
			deflt = blk
		} else {
			mut cond = 0
			let binds = vec_new()
			mut j = 0
			for j < exprs[VEC_LEN] {
				let e = vec_get(exprs, j)
				let pat = enum_pattern(e)
				if pat == 0 {
					err_code_type(e[N_POS], cstr("E290 MATCH_PATTERN"), cstr("a case of a switch on "), t, cstr(" is a variant, like Name or Name(a, b)"))
					pop_scope()
					return
				}
				let vi = enum_variant(t, vec_get(pat, 0))
				if vi < 0 {
					let u = err_code(e[N_POS], cstr("E290 MATCH_PATTERN"))
					type_name(u, t)
					buf_str(u, cstr(" has no variant "))
					buf_str(u, vec_get(pat, 0))
					err_end(u)
					pop_scope()
					return
				}
				if vec_get(seen, vi) != 0 {
					err_code_quoted(e[N_POS], cstr("E292 MATCH_UNREACHABLE"), cstr("variant "), vec_get(pat, 0), cstr(" is already handled by an earlier case"))
				}
				seen[VEC_DATA][vi] = 1
				let v = vec_get(vs, vi)
				let names = vec_get(pat, 1)
				if names[VEC_LEN] > 0 {
					if exprs[VEC_LEN] > 1 {
						err_code_at(e[N_POS], cstr("E290 MATCH_PATTERN"), cstr("a case that binds a variant's values lists only that variant"))
					} else if names[VEC_LEN] != vec_get(v, 2) {
						let u = err_code(e[N_POS], cstr("E290 MATCH_PATTERN"))
						buf_str(u, vec_get(pat, 0))
						buf_str(u, cstr(" has "))
						buf_int(u, vec_get(v, 2))
						buf_str(u, cstr(" values, the case binds "))
						buf_int(u, names[VEC_LEN])
						err_end(u)
					} else {
						mut k = 0
						for k < names[VEC_LEN] {
							let nm = vec_get(names, k)
							if streq(nm, cstr("_")) == 0 {
								let fi = vec_get(v, 1) + k
								let l = node_new(ST_LET, e[N_POS])
								l[LET_NAME] = nm
								l[LET_INIT] = mk_mem(e[N_POS], sym_ref_node(pos, tmp[LET_SYM]), 0, 0, field_offset(t, fi), field_type(t, fi))
								vec_push(binds, l)
							}
							k = k + 1
						}
					}
				}
				let tagv = mk_mem(e[N_POS], sym_ref_node(pos, tmp[LET_SYM]), 0, 0, field_offset(t, 0), ty_int)
				let ce = mk_bin(e[N_POS], cstr("=="), tagv, mk_int(e[N_POS], vi, ty_int), ty_bool)
				if cond != 0 {
					cond = mk_bin(e[N_POS], cstr("||"), cond, ce, ty_bool)
				} else {
					cond = ce
				}
				j = j + 1
			}
			if binds[VEC_LEN] > 0 {
				let st = blk[BLK_STMTS]
				mut k2 = 0
				for k2 < st[VEC_LEN] {
					vec_push(binds, vec_get(st, k2))
					k2 = k2 + 1
				}
				blk[BLK_STMTS] = binds
			}
			let ifs = node_new(ST_IF, blk[N_POS])
			ifs[IF_COND] = cond
			ifs[IF_THEN] = blk
			if last != 0 {
				last[IF_ELSE] = ifs
			} else {
				first = ifs
			}
			last = ifs
		}
		i = i + 1
	}
	if deflt == 0 {
		let missing = buf_new()
		mut n = 0
		mut m = 0
		for m < vs[VEC_LEN] {
			if vec_get(seen, m) == 0 {
				if n > 0 {
					buf_str(missing, cstr(", "))
				}
				buf_str(missing, vec_get(vec_get(vs, m), 0))
				n = n + 1
			}
			m = m + 1
		}
		if n > 0 {
			let u = err_code(pos, cstr("E291 MATCH_EXHAUSTIVE"))
			buf_str(u, cstr("switch on "))
			type_name(u, t)
			buf_str(u, cstr(" does not handle "))
			buf_byte(missing, 0)
			buf_str(u, missing[VEC_DATA])
			buf_str(u, cstr(" (add the cases, or a default)"))
			err_end(u)
		}
	} else if last != 0 {
		last[IF_ELSE] = deflt
	} else {
		first = deflt
	}
	if first != 0 {
		vec_push(body[BLK_STMTS], first)
	}
	vec_push(out[BLK_STMTS], w)
	// Every variant handled and every branch returns: nothing runs after the switch.
	mut all_return = i64(first != 0)
	mut ci = 0
	for ci < cases[VEC_LEN] {
		if ends_in_return(vec_get(vec_get(cases, ci), 1)[BLK_STMTS]) == 0 {
			all_return = 0
		}
		ci = ci + 1
	}
	replace_node(s, out)
	ck_breaks = ck_breaks + 1
	check_scoped(body)
	ck_breaks = ck_breaks - 1
	pop_scope()
	if all_return != 0 && (deflt != 0 || all_seen(seen) != 0) {
		vec_push(s[BLK_STMTS], expr_stmt(rt_call(pos, cstr("rt_panic"), args1(lit_string(pos, cstr("unreachable enum switch"))), ty_void)))
	}
}

fn all_seen(seen i64) i64 {
	mut i = 0
	for i < seen[VEC_LEN] {
		if vec_get(seen, i) == 0 {
			return 0
		}
		i = i + 1
	}
	return 1
}

// ---- match (edition 1, #225) ----
//
// A match is lowered where it stands: as a statement, a let or assignment value, a return
// value, or a catch or boundary block's last expression, where its arms may also leave
// (return, break, continue, fail, try); inside any other expression it is an EX_SEQ whose
// arms are expressions. A statement match a switch can express (constant, sentinel and
// variant arms, `_` last, no guards, no break in an arm), or `match true { true if c => }`,
// the translator's tagless switch, is lowered as that switch, so translated code keeps its
// instructions. Any other match is an if-else chain over the subject: each arm tests its
// patterns, declares its bindings, then runs its guard. A guarded arm that binds splits the
// chain: the rest runs under a flag the arm clears when it is taken. break and continue in
// an arm apply to the enclosing loop. A name in a pattern compares with a package-level
// constant or variable (a sentinel), names a variant of an enum subject, or else binds;
// naming a local variable is an error (compare with a guard).
const MATCH_STMT = 0 // no value
const MATCH_VALUE = 1 // each arm stores its value in the record's local
const MATCH_RETURN = 2 // each arm returns its value
const MATCH_TAIL = 3 // a boundary block's last expression: a value, or none
const MATCH_EXPR = 4 // inside an expression: as MATCH_VALUE, with expression arms only
const MR_SYM = 0 // record: the value local
const MR_MODE = 1 // record: the mode
const MR_HINT = 2 // record: the type the context expects (MATCH_EXPR), or 0
const MS_REC = 3 // ST_MSTORE: the record of its match (ES_X is the value)

shared mut mt_seq i64 // numbers the match locals that are assigned by name
shared mut mt_variant i64 // the enum variant a pattern matches whole, or -1
shared mut mt_bool i64 // a pattern's bool literal: 1 true, 2 false, 0 neither

fn mt_name(prefix i64) i64 {
	mt_seq = mt_seq + 1
	let nb = buf_new()
	buf_str(nb, prefix)
	buf_int(nb, mt_seq)
	buf_byte(nb, 0)
	return nb[VEC_DATA]
}

fn mt_record(vs i64, mode i64, hint i64) i64 {
	let rec = vec_new()
	vec_push(rec, vs)
	vec_push(rec, mode)
	vec_push(rec, hint)
	return rec
}

// mt_stmt_expr is the expression a statement carries at its top (a match or catch may be one).
fn mt_stmt_expr(s i64) i64 {
	let k = s[N_KIND]
	if k == ST_EXPR {
		return s[ES_X]
	}
	if k == ST_LET {
		return s[LET_INIT]
	}
	if k == ST_ASSIGN {
		return s[AS_VALUE]
	}
	if k == ST_RETURN {
		return s[RET_VALUE]
	}
	return 0
}

// mt_breaks reports a break in stmts outside any loop of theirs: in a match arm it leaves
// the enclosing loop, where a switch would take it for its own end.
fn mt_breaks(v i64) i64 {
	mut i = 0
	for i < v[VEC_LEN] {
		let s = vec_get(v, i)
		let k = s[N_KIND]
		if k == ST_BREAK {
			return 1
		}
		if k == ST_BLOCK && mt_breaks(s[BLK_STMTS]) != 0 {
			return 1
		}
		if k == ST_IF && (mt_breaks(s[IF_THEN][BLK_STMTS]) != 0 || (s[IF_ELSE] != 0 && mt_breaks(vec_new_with(s[IF_ELSE])) != 0)) {
			return 1
		}
		let x = mt_stmt_expr(s)
		if x != 0 && x[N_KIND] == EX_CATCH && mt_breaks(x[CATCH_BODY][BLK_STMTS]) != 0 {
			return 1
		}
		if x != 0 && x[N_KIND] == EX_MATCH && mt_arms_break(x) != 0 {
			return 1
		}
		i = i + 1
	}
	return 0
}

fn mt_arms_break(m i64) i64 {
	let arms = m[MATCH_ARMS]
	mut i = 0
	for i < arms[VEC_LEN] {
		let arm = vec_get(arms, i)
		if vec_get(arm, ARM_BLOCK) != 0 && mt_breaks(vec_get(arm, ARM_BODY)[BLK_STMTS]) != 0 {
			return 1
		}
		i = i + 1
	}
	return 0
}

// mt_names_assigned reports whether an arm of m (or of a match nested in one) assigns a or b.
fn mt_names_assigned(m i64, a i64, b i64) i64 {
	let arms = m[MATCH_ARMS]
	mut i = 0
	for i < arms[VEC_LEN] {
		let arm = vec_get(arms, i)
		let body = vec_get(arm, ARM_BODY)
		if vec_get(arm, ARM_BLOCK) != 0 && names_assigned(body, a, b) != 0 {
			return 1
		}
		if vec_get(arm, ARM_BLOCK) == 0 && body[N_KIND] == EX_MATCH && mt_names_assigned(body, a, b) != 0 {
			return 1
		}
		i = i + 1
	}
	return 0
}

// mt_collect_decls adds the names m's arms bind or declare (closures may capture them).
fn mt_collect_decls(m i64, names i64) {
	let arms = m[MATCH_ARMS]
	mut i = 0
	for i < arms[VEC_LEN] {
		let arm = vec_get(arms, i)
		let pats = vec_get(arm, ARM_PATTERNS)
		mut j = 0
		for j < pats[VEC_LEN] {
			mt_pattern_names(vec_get(pats, j), names)
			j = j + 1
		}
		let body = vec_get(arm, ARM_BODY)
		if vec_get(arm, ARM_BLOCK) != 0 {
			collect_local_decls(body[BLK_STMTS], names)
		} else if body[N_KIND] == EX_MATCH {
			mt_collect_decls(body, names)
		}
		i = i + 1
	}
}

fn mt_pattern_names(p i64, names i64) {
	if vec_get(p, PAT_KIND) == PAT_NAME_KIND && vec_get(p, PAT_NAME)[N_KIND] == EX_IDENT {
		vec_push(names, vec_get(p, PAT_NAME)[ID_NAME])
	}
	if vec_get(p, PAT_KIND) == PAT_VARIANT {
		let kids = vec_get(p, PAT_CHILDREN)
		mut j = 0
		for j < kids[VEC_LEN] {
			mt_pattern_names(vec_get(kids, j), names)
			j = j + 1
		}
	}
}

// mt_arm_block is an arm's body as a block: its own, or one holding its expression.
fn mt_arm_block(arm i64) i64 {
	let b = vec_get(arm, ARM_BODY)
	if vec_get(arm, ARM_BLOCK) != 0 {
		return b
	}
	let blk = empty_block(b[N_POS])
	vec_push(blk[BLK_STMTS], expr_stmt(b))
	return blk
}

// match_as_switch lowers a statement match that a switch expresses as that switch; it
// returns 0, having changed nothing, for any other match.
fn match_as_switch(s i64, m i64) i64 {
	let arms = m[MATCH_ARMS]
	let subj = m[MATCH_SUBJECT]
	if mt_arms_break(m) != 0 {
		return 0
	}
	let tagless = i64(subj[N_KIND] == EX_IDENT && streq(subj[ID_NAME], cstr("true")) != 0)
	mut t = 0
	mut vs = 0
	if tagless == 0 {
		t = chk(subj, 0)
		if kind_of(t) == K_OPT || is_untyped(t) != 0 {
			return 0
		}
		if kind_of(t) == K_STRUCT && t[TY_ENUM] != 0 {
			vs = t[TY_ENUM]
		}
	}
	mut seen = 0
	if vs != 0 {
		seen = vec_filled(vs[VEC_LEN], 0)
	}
	mut deflt = 0
	let cases = vec_new()
	let n = arms[VEC_LEN]
	mut i = 0
	for i < n {
		let arm = vec_get(arms, i)
		let pats = vec_get(arm, ARM_PATTERNS)
		let guard_ = vec_get(arm, ARM_GUARD)
		let p0 = vec_get(pats, 0)
		mut exprs = vec_new()
		if pats[VEC_LEN] == 1 && vec_get(p0, PAT_KIND) == PAT_WILD && guard_ == 0 {
			if i != n - 1 {
				return 0
			}
			exprs = 0
			deflt = 1
		} else if tagless != 0 {
			let x = vec_get(p0, PAT_A)
			if guard_ == 0 || pats[VEC_LEN] != 1 || vec_get(p0, PAT_KIND) != PAT_LITERAL || x[N_KIND] != EX_IDENT || streq(x[ID_NAME], cstr("true")) == 0 {
				return 0
			}
			vec_push(exprs, guard_)
		} else {
			if guard_ != 0 {
				return 0
			}
			mut j = 0
			for j < pats[VEC_LEN] {
				let e = match_case_expr(vec_get(pats, j), t, seen, pats[VEC_LEN])
				if e == 0 {
					return 0
				}
				vec_push(exprs, e)
				j = j + 1
			}
		}
		vec_push(cases, pair(exprs, mt_arm_block(arm)))
		i = i + 1
	}
	if seen != 0 && deflt == 0 && all_seen(seen) == 0 {
		return 0
	}
	// A match that ends its function and leaves from every arm needs no return after it.
	let body = ck_fn[F_BODY][BLK_STMTS]
	let frs = ck_fn[F_RTYPES]
	let last = i64(body[VEC_LEN] > 0 && vec_get(body, body[VEC_LEN] - 1) == s && frs[VEC_LEN] > 0 && !(ck_fn[F_BANG] != 0 && frs[VEC_LEN] == 1))
	let pos = s[N_POS]
	s[N_KIND] = ST_SWITCH
	s[SW_TAG] = subj
	if tagless != 0 {
		s[SW_TAG] = 0
	}
	s[SW_CASES] = cases
	s[SW_INIT] = 0
	lower_switch(s)
	mut all_return = i64(deflt != 0 && seen == 0)
	i = 0
	for i < cases[VEC_LEN] {
		if ends_in_return(vec_get(vec_get(cases, i), 1)[BLK_STMTS]) == 0 {
			all_return = 0
		}
		i = i + 1
	}
	if last != 0 && all_return != 0 && s[N_KIND] == ST_BLOCK && ends_in_return(s[BLK_STMTS]) == 0 {
		vec_push(s[BLK_STMTS], expr_stmt(rt_call(pos, cstr("rt_panic"), args1(lit_string(pos, cstr("unreachable match"))), ty_void)))
	}
	return 1
}

// match_case_expr is the switch case for pattern p of a match on t, or 0 when a switch
// would read it differently. seen marks the enum variants already handled.
fn match_case_expr(p i64, t i64, seen i64, npats i64) i64 {
	let k = vec_get(p, PAT_KIND)
	if k == PAT_LITERAL {
		if seen != 0 {
			return 0
		}
		return vec_get(p, PAT_A)
	}
	if k == PAT_NAME_KIND {
		let x = vec_get(p, PAT_NAME)
		if seen != 0 {
			mut name = x[SEL_NAME]
			if x[N_KIND] == EX_IDENT {
				name = x[ID_NAME]
			}
			let vi = enum_variant(t, name)
			if vi < 0 || vec_get(seen, vi) != 0 {
				return 0
			}
			seen[VEC_DATA][vi] = 1
			return x
		}
		if x[N_KIND] == EX_SELECT {
			return x
		}
		let sym = lookup_name(x[ID_NAME])
		if sym == 0 || (sym[S_KIND] != SYM_GLOBAL && sym[S_KIND] != SYM_CONST) {
			return 0
		}
		return x
	}
	if k != PAT_VARIANT || seen == 0 {
		return 0
	}
	let nm = vec_get(p, PAT_NAME)
	mut name = nm[SEL_NAME]
	if nm[N_KIND] == EX_IDENT {
		name = nm[ID_NAME]
	}
	let vi = enum_variant(t, name)
	if vi < 0 || vec_get(seen, vi) != 0 {
		return 0
	}
	let v = vec_get(t[TY_ENUM], vi)
	let kids = vec_get(p, PAT_CHILDREN)
	if kids[VEC_LEN] > 0 && kids[VEC_LEN] != vec_get(v, 2) {
		return 0
	}
	let args = vec_new()
	mut j = 0
	for j < kids[VEC_LEN] {
		let kid = vec_get(kids, j)
		mut a = 0
		if vec_get(kid, PAT_KIND) == PAT_WILD {
			a = node_new(EX_IDENT, vec_get(kid, PAT_POS))
			a[ID_NAME] = cstr("_")
		} else if vec_get(kid, PAT_KIND) == PAT_NAME_KIND && vec_get(kid, PAT_NAME)[N_KIND] == EX_IDENT && npats == 1 {
			a = vec_get(kid, PAT_NAME)
			let ft = field_type(t, vec_get(v, 1) + j)
			if kind_of(ft) == K_STRUCT && ft[TY_ENUM] != 0 && enum_variant(ft, a[ID_NAME]) >= 0 {
				return 0
			}
		} else {
			return 0
		}
		vec_push(args, a)
		j = j + 1
	}
	seen[VEC_DATA][vi] = 1
	let c = node_new(EX_CALL, vec_get(p, PAT_POS))
	if nm[N_KIND] == EX_IDENT {
		c[CALL_NAME] = nm[ID_NAME]
	} else {
		c[CALL_CALLEE] = nm
	}
	c[CALL_ARGS] = args
	return c
}

// lower_match_stmt lowers a match statement; its arms' values, if any, are dropped.
fn lower_match_stmt(s i64, m i64) {
	if match_as_switch(s, m) != 0 {
		return
	}
	replace_node(s, lower_match(m, MATCH_STMT, 0))
}

// match_valued lowers a match whose arms store into local vs, and returns the statements
// that declare vs and run the match (vs has no type when every arm leaves).
fn match_valued(pos i64, m i64, vs i64, mode i64, hint i64) i64 {
	let out = lower_match(m, mode, mt_record(vs, mode, hint))
	let stmts = vec_new()
	let t = vs[S_TYPE]
	if t != 0 && kind_of(t) != K_VOID {
		mut zero = mk_int(pos, 0, t)
		if is_float_t(t) != 0 || kind_of(t) == K_STRING {
			zero = zero_value(pos, t)
		}
		vec_push(stmts, let_stmt(pos, vs, zero))
	}
	vec_push(stmts, out)
	return stmts
}

fn flat_block(pos i64, stmts i64) i64 {
	let b = empty_block(pos)
	b[BLK_FLAT] = 1
	b[BLK_STMTS] = stmts
	return b
}

// check_match_let lowers let x [T] = match ...: the arms store into a hidden local, x takes it.
fn check_match_let(s i64, m i64, t i64) {
	let pos = s[N_POS]
	let vs = declare_local(pos, mt_name(cstr("$match")), t)
	let stmts = match_valued(pos, m, vs, MATCH_VALUE, 0)
	let l = node_new(ST_LET, pos)
	l[LET_NAME] = s[LET_NAME]
	l[LET_TYPE] = s[LET_TYPE]
	l[LET_MUT] = s[LET_MUT]
	if vs[S_TYPE] != 0 {
		l[LET_INIT] = sym_ref_node(pos, vs)
	} else if t == 0 {
		err_code_at(m[N_POS], cstr("E293 MATCH_VALUE"), cstr("this match gives no value: every arm leaves"))
		replace_node(s, flat_block(pos, stmts))
		return
	}
	vec_push(stmts, l)
	check_let(l)
	replace_node(s, flat_block(pos, stmts))
}

// check_match_assign lowers target = match ...: the arms store into a hidden local first.
fn check_match_assign(s i64, target i64, m i64) {
	let pos = s[N_POS]
	mut t = 0
	if target[N_KIND] == EX_IDENT && target[N_TYPE] != 0 {
		t = target[N_TYPE]
	} else if target[N_KIND] == EX_IDENT && streq(target[ID_NAME], cstr("_")) == 0 {
		let sym = lookup_name(target[ID_NAME])
		if sym != 0 && sym[S_KIND] != SYM_FUNC {
			t = sym[S_TYPE]
		}
	}
	let vs = declare_local(pos, mt_name(cstr("$match")), t)
	let stmts = match_valued(pos, m, vs, MATCH_VALUE, 0)
	if vs[S_TYPE] != 0 {
		let a = assign_stmt(pos, target, sym_ref_node(pos, vs))
		vec_push(stmts, a)
		check_assign(a)
	}
	replace_node(s, flat_block(pos, stmts))
}

// check_match_tail lowers a match that ends a boundary block: its value, if any, is the block's.
fn check_match_tail(s i64, m i64) {
	let pos = s[N_POS]
	let vs = declare_local(pos, mt_name(cstr("$match")), 0)
	let stmts = match_valued(pos, m, vs, MATCH_TAIL, 0)
	let t = vs[S_TYPE]
	bound_t = ty_void
	if t != 0 && kind_of(t) != K_VOID {
		bound_t = t
		vec_push(stmts, bound_store(pos, sym_ref_node(pos, vs), t))
	}
	replace_node(s, flat_block(pos, stmts))
}

// chk_match lowers a match inside an expression to an EX_SEQ yielding its value.
fn chk_match(e i64, want i64) i64 {
	let pos = e[N_POS]
	let arms = e[MATCH_ARMS]
	mut i = 0
	for i < arms[VEC_LEN] {
		let arm = vec_get(arms, i)
		if vec_get(arm, ARM_BLOCK) != 0 {
			err_code_at(vec_get(arm, ARM_BODY)[N_POS], cstr("E293 MATCH_VALUE"), cstr("a match inside an expression has expression arms: give it a statement of its own (let v = match ...)"))
			return ty_int
		}
		i = i + 1
	}
	mut hint = want
	if hint != 0 && (is_untyped(hint) != 0 || kind_of(hint) == K_VOID) {
		hint = 0
	}
	let vs = declare_local(pos, mt_name(cstr("$match")), 0)
	let stmts = match_valued(pos, e, vs, MATCH_EXPR, hint)
	let t = vs[S_TYPE]
	if t == 0 {
		return ty_int
	}
	replace_node(e, mk_seq(pos, stmts, sym_ref_node(pos, vs), t))
	e[N_TYPE] = 0
	return t
}

// check_mstore checks an arm's value and stores it in its match's local; the first value
// gives the local its type unless the context did.
fn check_mstore(s i64) {
	let pos = s[N_POS]
	let x = s[ES_X]
	let rec = s[MS_REC]
	let vs = vec_get(rec, MR_SYM)
	let mode = vec_get(rec, MR_MODE)
	mut t = vs[S_TYPE]
	let k = x[N_KIND]
	if k == EX_MATCH && mode != MATCH_EXPR {
		// A match as an arm's value stores into the same local.
		replace_node(s, lower_match(x, mode, rec))
		return
	}
	if (k == EX_TRY || k == EX_CATCH || k == EX_WRAP) && mode != MATCH_EXPR {
		// try in an arm: its value goes through a let of its own, then into the local.
		let l = node_new(ST_LET, pos)
		l[LET_NAME] = cstr("$")
		l[LET_INIT] = x
		if t != 0 && kind_of(t) == K_VOID {
			err_code_at(pos, cstr("E293 MATCH_VALUE"), cstr("the arms of this match must all give a value, or none"))
			return
		}
		lower_try_stmt(l, x, 1, t)
		if l[N_KIND] != ST_BLOCK {
			return
		}
		let ls = vec_get(l[BLK_STMTS], l[BLK_STMTS][VEC_LEN] - 1)
		if ls[N_KIND] != ST_LET {
			return
		}
		if t == 0 {
			vs[S_TYPE] = ls[LET_SYM][S_TYPE]
		}
		let a = assign_stmt(pos, sym_ref_node(pos, vs), sym_ref_node(pos, ls[LET_SYM]))
		vec_push(l[BLK_STMTS], a)
		check_assign(a)
		replace_node(s, l)
		return
	}
	mut hint = t
	if hint == 0 {
		hint = vec_get(rec, MR_HINT)
	}
	if t != 0 && kind_of(t) == K_VOID {
		hint = 0
	}
	let vt = chk(x, hint)
	if kind_of(vt) == K_VOID {
		if mode == MATCH_TAIL && (t == 0 || kind_of(t) == K_VOID) {
			vs[S_TYPE] = ty_void
			replace_node(s, expr_stmt(x))
			return
		}
		err_code_at(pos, cstr("E293 MATCH_VALUE"), cstr("this arm gives no value"))
		return
	}
	if t != 0 && kind_of(t) == K_VOID {
		err_code_at(pos, cstr("E293 MATCH_VALUE"), cstr("the arms of this match must all give a value, or none"))
		return
	}
	check_value(pos, vt)
	if t == 0 {
		t = default_type(vt)
		if kind_of(t) == K_NIL {
			err_code_at(x[N_POS], cstr("E233 UNTYPED_NIL"), cstr("use of untyped nil: give the match a type (let v ?T = match ...)"))
			return
		}
		vs[S_TYPE] = t
	}
	let a = assign_stmt(pos, sym_ref_node(pos, vs), x)
	check_assign(a)
	replace_node(s, a)
}

// mt_void_arm notes a boundary-tail arm block that ends without a value.
fn mt_void_arm(rec i64, pos i64) {
	let vs = vec_get(rec, MR_SYM)
	if vs[S_TYPE] != 0 && kind_of(vs[S_TYPE]) != K_VOID {
		err_code_at(pos, cstr("E293 MATCH_VALUE"), cstr("the arms of this match must all give a value, or none"))
		return
	}
	vs[S_TYPE] = ty_void
}

// mt_arm_body is an arm's body block for the mode: its value is stored, returned or dropped.
fn mt_arm_body(arm i64, mode i64, rec i64) i64 {
	let b = vec_get(arm, ARM_BODY)
	if vec_get(arm, ARM_BLOCK) == 0 {
		let blk = empty_block(b[N_POS])
		vec_push(blk[BLK_STMTS], mt_value(b[N_POS], b, mode, rec))
		return blk
	}
	if mode == MATCH_STMT {
		return b
	}
	let stmts = b[BLK_STMTS]
	let n = stmts[VEC_LEN]
	if n > 0 && vec_get(stmts, n - 1)[N_KIND] == ST_EXPR {
		let last = vec_get(stmts, n - 1)
		stmts[VEC_DATA][n - 1] = mt_value(last[N_POS], last[ES_X], mode, rec)
	} else if ends_in_jump(stmts) != 0 {
		return b
	} else if mode == MATCH_TAIL {
		mt_void_arm(rec, b[N_POS])
	} else {
		err_code_at(b[N_POS], cstr("E293 MATCH_VALUE"), cstr("a match arm that gives a value ends with it, or leaves (return, break, continue or fail)"))
	}
	return b
}

fn mt_value(pos i64, x i64, mode i64, rec i64) i64 {
	if mode == MATCH_STMT {
		return expr_stmt(x)
	}
	if mode == MATCH_RETURN {
		let r = node_new(ST_RETURN, pos)
		r[RET_VALUE] = x
		return r
	}
	let ms = node_new(ST_MSTORE, pos)
	ms[ES_X] = x
	ms[MS_REC] = rec
	return ms
}

// A path is how a pattern reaches its value: [local name or 0, symbol, [[offset, type]...]].
fn mt_path(name i64, sym i64) i64 {
	let p = vec_new()
	vec_push(p, name)
	vec_push(p, sym)
	vec_push(p, vec_new())
	return p
}

fn mt_step(path i64, off i64, t i64) i64 {
	let steps = vec_clone(vec_get(path, 2))
	vec_push(steps, pair(off, t))
	let p = vec_new()
	vec_push(p, vec_get(path, 0))
	vec_push(p, vec_get(path, 1))
	vec_push(p, steps)
	return p
}

// mt_node reads the value at path. A named local is read by name, so nil arms narrow it.
fn mt_node(pos i64, path i64) i64 {
	mut n = 0
	if vec_get(path, 0) != 0 {
		n = node_new(EX_IDENT, pos)
		n[ID_NAME] = vec_get(path, 0)
	} else {
		n = sym_ref_node(pos, vec_get(path, 1))
	}
	let steps = vec_get(path, 2)
	mut i = 0
	for i < steps[VEC_LEN] {
		let st = vec_get(steps, i)
		n = mk_mem(pos, n, 0, 0, vec_get(st, 0), vec_get(st, 1))
		i = i + 1
	}
	return n
}

fn mt_is_enum(t i64) i64 {
	return i64(kind_of(t) == K_STRUCT && t[TY_ENUM] != 0)
}

fn mt_compare(pos i64, path i64, t i64, x i64) i64 {
	let c = binary_new(pos, cstr("=="), mt_node(pos, path), x)
	if kind_of(t) == K_ERROR {
		// A fault arm compares with fault.Is, walking the chain (notes/interface_faults.md).
		c[BIN_OP] = cstr("$is")
	}
	return c
}

// mt_pattern returns the condition under which pattern p matches the value at path (of type
// t), or 0 when it always does; its bindings are added to binds. top is 0 inside a variant,
// where a bare name always binds, as in a switch case. It sets mt_variant and mt_bool.
fn mt_pattern(p i64, path i64, t i64, binds i64, top i64) i64 {
	let pos = vec_get(p, PAT_POS)
	let k = vec_get(p, PAT_KIND)
	mt_variant = -1
	mt_bool = 0
	if k == PAT_WILD {
		return 0
	}
	if k == PAT_LITERAL {
		let x = vec_get(p, PAT_A)
		if mt_is_enum(t) != 0 {
			err_code_type(pos, cstr("E290 MATCH_PATTERN"), cstr("an arm of a match on "), t, cstr(" is a variant, like Name or Name(a, b)"))
			return 0
		}
		if x[N_KIND] == EX_IDENT && kind_of(t) == K_BOOL {
			mt_bool = 1
			if streq(x[ID_NAME], cstr("false")) != 0 {
				mt_bool = 2
			}
		}
		return mt_compare(pos, path, t, x)
	}
	if k == PAT_RANGE {
		if is_numeric_t(t) == 0 && kind_of(t) != K_STRING {
			err_code_type(pos, cstr("E290 MATCH_PATTERN"), cstr("a range pattern needs a number or a str, not "), t, cstr(""))
			return 0
		}
		let lo = binary_new(pos, cstr(">="), mt_node(pos, path), vec_get(p, PAT_A))
		let hi = binary_new(pos, cstr("<"), mt_node(pos, path), vec_get(p, PAT_B))
		return binary_new(pos, cstr("&&"), lo, hi)
	}
	let x = vec_get(p, PAT_NAME)
	mut name = x[SEL_NAME]
	if x[N_KIND] == EX_IDENT {
		name = x[ID_NAME]
	}
	if k == PAT_VARIANT {
		if mt_is_enum(t) == 0 {
			err_code_type(pos, cstr("E290 MATCH_PATTERN"), cstr("a variant pattern needs an enum value, not "), t, cstr(""))
			return 0
		}
		return mt_variant_test(pos, path, t, name, vec_get(p, PAT_CHILDREN), binds)
	}
	if x[N_KIND] == EX_SELECT {
		if mt_is_enum(t) != 0 {
			return mt_variant_test(pos, path, t, name, 0, binds)
		}
		return mt_compare(pos, path, t, x)
	}
	if mt_is_enum(t) != 0 && enum_variant(t, name) >= 0 {
		return mt_variant_test(pos, path, t, name, 0, binds)
	}
	if top != 0 {
		let sym = lookup_name(name)
		if sym != 0 && (sym[S_KIND] == SYM_GLOBAL || sym[S_KIND] == SYM_CONST) {
			return mt_compare(pos, path, t, x)
		}
		if sym != 0 && sym[S_KIND] == SYM_LOCAL {
			let u = err_code(pos, cstr("E290 MATCH_PATTERN"))
			buf_str(u, cstr("'"))
			buf_str(u, name)
			buf_str(u, cstr("' is a variable, and a name in a pattern binds a new one: compare with a guard (v if v == "))
			buf_str(u, name)
			buf_str(u, cstr(")"))
			err_end(u)
			return 0
		}
		if mt_is_enum(t) != 0 && i64(load8(name)) >= 'A' && i64(load8(name)) <= 'Z' {
			let u = err_code(pos, cstr("E290 MATCH_PATTERN"))
			type_name(u, t)
			buf_str(u, cstr(" has no variant "))
			buf_str(u, name)
			err_end(u)
			return 0
		}
	}
	let l = node_new(ST_LET, pos)
	l[LET_NAME] = name
	l[LET_INIT] = mt_node(pos, path)
	vec_push(binds, l)
	return 0
}

// mt_variant_test tests the tag of the enum value at path, then its values' patterns.
fn mt_variant_test(pos i64, path i64, t i64, name i64, kids i64, binds i64) i64 {
	let vi = enum_variant(t, name)
	if vi < 0 {
		let u = err_code(pos, cstr("E290 MATCH_PATTERN"))
		type_name(u, t)
		buf_str(u, cstr(" has no variant "))
		buf_str(u, name)
		err_end(u)
		return 0
	}
	let v = vec_get(t[TY_ENUM], vi)
	let tag = mk_mem(pos, mt_node(pos, path), 0, 0, field_offset(t, 0), ty_int)
	mut cond = mk_bin(pos, cstr("=="), tag, mk_int(pos, vi, ty_int), ty_bool)
	mut whole = 1
	if kids != 0 && kids[VEC_LEN] > 0 {
		if kids[VEC_LEN] != vec_get(v, 2) {
			let u = err_code(pos, cstr("E290 MATCH_PATTERN"))
			buf_str(u, name)
			buf_str(u, cstr(" has "))
			buf_int(u, vec_get(v, 2))
			buf_str(u, cstr(" values, the pattern has "))
			buf_int(u, kids[VEC_LEN])
			err_end(u)
			return cond
		}
		mut j = 0
		for j < kids[VEC_LEN] {
			let fi = vec_get(v, 1) + j
			let ft = field_type(t, fi)
			let c = mt_pattern(vec_get(kids, j), mt_step(path, field_offset(t, fi), ft), ft, binds, 0)
			if c != 0 {
				whole = 0
				cond = binary_new(pos, cstr("&&"), cond, c)
			}
			j = j + 1
		}
	}
	mt_variant = -1
	if whole != 0 {
		mt_variant = vi
	}
	mt_bool = 0
	return cond
}

// lower_match lowers match m to a checked block. rec is the value record (MATCH_VALUE,
// MATCH_TAIL, MATCH_EXPR), or 0.
fn lower_match(m i64, mode i64, rec i64) i64 {
	let pos = m[N_POS]
	let arms = m[MATCH_ARMS]
	let subj = m[MATCH_SUBJECT]
	let out = empty_block(pos)
	push_scope()
	mut st = chk(subj, 0)
	if is_untyped(st) != 0 {
		st = default_type(st)
		if kind_of(st) == K_NIL {
			err_code_at(subj[N_POS], cstr("E233 UNTYPED_NIL"), cstr("use of untyped nil"))
			pop_scope()
			return out
		}
		reconvert(subj, st)
	}
	if kind_of(st) == K_VOID || kind_of(st) == K_TUPLE {
		err_code_type(subj[N_POS], cstr("E290 MATCH_PATTERN"), cstr("cannot match on "), st, cstr(""))
		pop_scope()
		return out
	}
	// The subject is read once into a hidden local, or, a local optional, read in place, so
	// that a nil arm narrows it for the arms after; optionals are read by name to narrow.
	mut path = 0
	if kind_of(st) == K_OPT && subj[N_KIND] == EX_IDENT && subj[ID_REF] != 0 && subj[ID_REF][S_KIND] == SYM_LOCAL {
		path = mt_path(subj[ID_NAME], 0)
	} else if kind_of(st) == K_OPT {
		let tmp = declare_local(pos, mt_name(cstr("$subject")), st)
		vec_push(out[BLK_STMTS], let_stmt(pos, tmp, subj))
		path = mt_path(tmp[S_NAME], 0)
	} else {
		let tmp = temp(pos, subj, st)
		vec_push(out[BLK_STMTS], tmp)
		path = mt_path(0, tmp[LET_SYM])
	}
	mut covered = 0
	if mt_is_enum(st) != 0 {
		covered = vec_filled(st[TY_ENUM][VEC_LEN], 0)
	}
	mut seen_true = 0
	mut seen_false = 0
	mut catchall = 0
	mut goflag = 0
	let bodies = vec_new()
	let chain = empty_block(pos)
	mut dest = chain[BLK_STMTS]
	mut last_if = 0
	mut i = 0
	for i < arms[VEC_LEN] {
		let arm = vec_get(arms, i)
		let apos = vec_get(arm, ARM_POS)
		let pats = vec_get(arm, ARM_PATTERNS)
		let guard_ = vec_get(arm, ARM_GUARD)
		if catchall != 0 {
			err_code_at(apos, cstr("E292 MATCH_UNREACHABLE"), cstr("this arm is never reached: an earlier arm matches every value"))
			break
		}
		let binds = vec_new()
		mut test = 0
		mut always = 0
		mut j = 0
		for j < pats[VEC_LEN] {
			let p = vec_get(pats, j)
			let errs = error_count
			mut c = mt_pattern(p, path, st, binds, 1)
			if c == 0 && error_count > errs {
				// A pattern in error matches nothing, so the arms after it are not reported.
				c = mk_int(apos, 0, ty_bool)
			}
			if mt_variant >= 0 {
				if vec_get(covered, mt_variant) != 0 {
					err_code_quoted(vec_get(p, PAT_POS), cstr("E292 MATCH_UNREACHABLE"), cstr("variant "), vec_get(vec_get(st[TY_ENUM], mt_variant), 0), cstr(" is already handled by an earlier arm"))
				}
				if guard_ == 0 {
					covered[VEC_DATA][mt_variant] = 1
				}
			}
			if guard_ == 0 && mt_bool == 1 {
				seen_true = 1
			}
			if guard_ == 0 && mt_bool == 2 {
				seen_false = 1
			}
			if c == 0 {
				always = 1
			} else if test != 0 {
				test = binary_new(apos, cstr("||"), test, c)
			} else {
				test = c
			}
			j = j + 1
		}
		if always != 0 {
			test = 0
		}
		if pats[VEC_LEN] > 1 && binds[VEC_LEN] > 0 {
			err_code_at(apos, cstr("E290 MATCH_PATTERN"), cstr("an arm with several patterns cannot bind names: give each its own arm"))
		}
		let body = mt_arm_body(arm, mode, rec)
		vec_push(bodies, body)
		// The bindings come first in the arm's block.
		if binds[VEC_LEN] > 0 && guard_ == 0 {
			mut k2 = 0
			for k2 < body[BLK_STMTS][VEC_LEN] {
				vec_push(binds, vec_get(body[BLK_STMTS], k2))
				k2 = k2 + 1
			}
			body[BLK_STMTS] = binds
		}
		mut stmt = 0
		if guard_ != 0 && binds[VEC_LEN] > 0 {
			// if test { binds; if guard { $go = false; body } }  if $go { the other arms }
			if goflag == 0 {
				goflag = declare_local(pos, mt_name(cstr("$go")), ty_bool)
				vec_push(out[BLK_STMTS], let_stmt(pos, goflag, mk_int(pos, 1, ty_bool)))
			}
			let clear_ = assign_stmt(apos, sym_ref_node(apos, goflag), mk_int(apos, 0, ty_bool))
			let taken = vec_new()
			vec_push(taken, clear_)
			mut k3 = 0
			for k3 < body[BLK_STMTS][VEC_LEN] {
				vec_push(taken, vec_get(body[BLK_STMTS], k3))
				k3 = k3 + 1
			}
			body[BLK_STMTS] = taken
			let gif = node_new(ST_IF, apos)
			gif[IF_COND] = guard_
			gif[IF_THEN] = body
			let inner = empty_block(apos)
			vec_push(binds, gif)
			inner[BLK_STMTS] = binds
			stmt = inner
			if test != 0 {
				stmt = node_new(ST_IF, apos)
				stmt[IF_COND] = test
				stmt[IF_THEN] = inner
			}
			let rest = node_new(ST_IF, apos)
			rest[IF_COND] = sym_ref_node(apos, goflag)
			rest[IF_THEN] = empty_block(apos)
			let wrap_ = empty_block(apos)
			vec_push(wrap_[BLK_STMTS], stmt)
			vec_push(wrap_[BLK_STMTS], rest)
			if last_if != 0 {
				last_if[IF_ELSE] = wrap_
			} else {
				vec_push(dest, wrap_)
			}
			dest = rest[IF_THEN][BLK_STMTS]
			last_if = 0
		} else {
			mut cond = test
			if guard_ != 0 && cond != 0 {
				cond = binary_new(apos, cstr("&&"), cond, guard_)
			} else if guard_ != 0 {
				cond = guard_
			}
			stmt = body
			if cond != 0 {
				stmt = node_new(ST_IF, apos)
				stmt[IF_COND] = cond
				stmt[IF_THEN] = body
			} else {
				catchall = 1
			}
			if last_if != 0 {
				last_if[IF_ELSE] = stmt
			} else {
				vec_push(dest, stmt)
			}
			last_if = 0
			if cond != 0 {
				last_if = stmt
			}
		}
		i = i + 1
	}
	let exhaustive = i64(catchall != 0 || (covered != 0 && all_seen(covered) != 0) || (seen_true != 0 && seen_false != 0))
	if covered != 0 && catchall == 0 && all_seen(covered) == 0 {
		let missing = buf_new()
		mut n = 0
		mut v = 0
		for v < covered[VEC_LEN] {
			if vec_get(covered, v) == 0 {
				if n > 0 {
					buf_str(missing, cstr(", "))
				}
				buf_str(missing, vec_get(vec_get(st[TY_ENUM], v), 0))
				n = n + 1
			}
			v = v + 1
		}
		buf_byte(missing, 0)
		let u = err_code(pos, cstr("E291 MATCH_EXHAUSTIVE"))
		buf_str(u, cstr("match on "))
		type_name(u, st)
		buf_str(u, cstr(" does not handle "))
		buf_str(u, missing[VEC_DATA])
		buf_str(u, cstr(" (add the arms, or _)"))
		err_end(u)
	} else if exhaustive == 0 && (mode == MATCH_VALUE || mode == MATCH_RETURN || mode == MATCH_EXPR) {
		err_code_at(pos, cstr("E291 MATCH_EXHAUSTIVE"), cstr("a match that gives a value must handle every value: add a _ arm"))
	}
	vec_push(out[BLK_STMTS], chain)
	check_stmt(chain)
	pop_scope()
	if mode == MATCH_TAIL && exhaustive == 0 {
		let vt = vec_get(rec, MR_SYM)[S_TYPE]
		if vt != 0 && kind_of(vt) != K_VOID {
			err_code_at(pos, cstr("E291 MATCH_EXHAUSTIVE"), cstr("a match that gives a value must handle every value: add a _ arm"))
		}
	}
	// Every value handled and every arm leaves: nothing runs after the match. (A return
	// match that misses a value is an error already.)
	mut leaves = i64(exhaustive != 0 || mode == MATCH_RETURN)
	mut b = 0
	for b < bodies[VEC_LEN] {
		if ends_in_jump(vec_get(bodies, b)[BLK_STMTS]) == 0 {
			leaves = 0
		}
		b = b + 1
	}
	if leaves != 0 && ends_in_return(out[BLK_STMTS]) == 0 {
		vec_push(out[BLK_STMTS], expr_stmt(rt_call(pos, cstr("rt_panic"), args1(lit_string(pos, cstr("unreachable match"))), ty_void)))
	}
	return out
}

// lower_go starts a thread running a call: the arguments are evaluated now and handed
// to a lifted thunk that unpacks them on the new thread.
fn lower_go(s i64) {
	let pos = s[N_POS]
	let call = s[GO_CALL]
	chk(call, 0)
	if call[N_KIND] != EX_CALL || call[CALL_INTRINSIC] != 0 || call[CALL_FN] == 0 {
		err_code_at(pos, cstr("E602 GO"), cstr("go needs a direct function call"))
		return
	}
	let target = call[CALL_FN]
	let args = call[CALL_ARGS]
	let n = args[VEC_LEN]
	let stmts = vec_new()
	let blk = temp(pos, rt_call(pos, cstr("rt_alloc"), args1(mk_int(pos, 8 * n + 8, ty_int)), ty_int), ty_int)
	vec_push(stmts, blk)
	mut i = 0
	for i < n {
		let a = vec_get(args, i)
		vec_push(stmts, assign_stmt(pos, mk_index(pos, sym_ref_node(pos, blk[LET_SYM]), mk_int(pos, i, ty_int), a[N_TYPE]), a))
		i = i + 1
	}
	// The thunk: fn thunk(blk) { target(blk[0], blk[1], ...); }
	lifted_count = lifted_count + 1
	let th = fn_new(pos, cstr("go"))
	let tb = buf_new()
	buf_str(tb, cstr("go$"))
	buf_int(tb, lifted_count)
	buf_byte(tb, 0)
	th[F_QNAME] = tb[VEC_DATA]
	th[F_LEGACY] = 1
	vec_push(th[F_PARAMS], cstr("blk"))
	vec_push(th[F_PTYPES], ty_int)
	vec_push(th[F_RTYPES], ty_int)
	th[F_TYPE] = func_of(th[F_PTYPES], th[F_RTYPES], 0)
	th[F_LOCALS] = vec_new()
	let ps = sym_new(SYM_LOCAL, cstr("blk"), pos)
	ps[S_TYPE] = ty_int
	vec_push(th[F_LOCALS], ps)
	th[F_SLOTS] = 1
	let inner = node_new(EX_CALL, pos)
	inner[CALL_NAME] = target[F_QNAME]
	inner[CALL_FN] = target
	inner[CALL_ARGS] = vec_new()
	inner[N_TYPE] = ty_void
	i = 0
	for i < n {
		let pt = vec_get(target[F_PTYPES], i)
		vec_push(inner[CALL_ARGS], mk_index(pos, sym_ref_node(pos, ps), mk_int(pos, i, ty_int), pt))
		i = i + 1
	}
	th[F_BODY] = empty_block(pos)
	vec_push(th[F_BODY][BLK_STMTS], expr_stmt(inner))
	vec_push(th[F_BODY][BLK_STMTS], expr_stmt(rt_call(pos, cstr("rt_thread_exit"), vec_new(), ty_void)))
	th[F_LIFTED] = 2
	vec_push(prog_fns, th)
	let ref_ = node_new(EX_FUNCREF, pos)
	ref_[FR_FN] = th
	ref_[N_TYPE] = th[F_TYPE]
	vec_push(stmts, expr_stmt(rt_call(pos, cstr("rt_go"), args2(ref_, sym_ref_node(pos, blk[LET_SYM])), ty_void)))
	let b = empty_block(pos)
	b[BLK_STMTS] = stmts
	replace_node(s, b)
}

fn pair(a i64, b i64) i64 {
	let v = vec_new()
	vec_push(v, a)
	vec_push(v, b)
	return v
}

fn len_alias_remember(sym i64, init i64) {
	if sym == 0 || sym[S_KIND] != SYM_LOCAL || sym[S_CELL] != 0 || init == 0 || init[N_KIND] != EX_MEM || init[MEM_HDR] == 0 || init[MEM_OFF] != 0 {
		return
	}
	let base = init[MEM_BASE]
	if base[N_KIND] != EX_IDENT {
		return
	}
	let source = base[ID_REF]
	if source == 0 || source[S_KIND] != SYM_LOCAL || source[S_CELL] != 0 || (kind_of(source[S_TYPE]) != K_SLICE && kind_of(source[S_TYPE]) != K_STRING) {
		return
	}
	vec_push(len_aliases, pair(sym, source))
}

fn len_alias_source(sym i64) i64 {
	mut i = len_aliases[VEC_LEN] - 1
	for i >= 0 {
		let p = vec_get(len_aliases, i)
		if vec_get(p, 0) == sym {
			return vec_get(p, 1)
		}
		i = i - 1
	}
	return 0
}

fn len_alias_invalidate(sym i64) {
	if sym == 0 {
		return
	}
	let n = len_aliases[VEC_LEN]
	mut i = 0
	for i < n {
		let p = vec_get(len_aliases, i)
		let alias = vec_get(p, 0)
		if alias == sym || vec_get(p, 1) == sym {
			vec_push(len_aliases, pair(alias, 0))
		}
		i = i + 1
	}
}

// stmt_may_change_slice is conservative: explicit mut arguments and calls through
// local function values can change a captured slice header, so they invalidate len facts.
fn stmt_may_change_slice(s i64, name i64) i64 {
	if s == 0 {
		return 0
	}
	let k = s[N_KIND]
	if k == ST_BLOCK || k == ST_LIST {
		mut stmts = s[BLK_STMTS]
		if k == ST_LIST {
			stmts = s[LIST_STMTS]
		}
		mut i = 0
		for i < stmts[VEC_LEN] {
			if stmt_may_change_slice(vec_get(stmts, i), name) != 0 {
				return 1
			}
			i = i + 1
		}
		return 0
	}
	if k == ST_LET {
		return expr_may_change_slice(s[LET_INIT], name)
	}
	if k == ST_ASSIGN {
		return i64(expr_may_change_slice(s[AS_TARGET], name) != 0 || expr_may_change_slice(s[AS_VALUE], name) != 0)
	}
	if k == ST_MULTI {
		let vals = s[MU_VALUES]
		mut i = 0
		for vals != 0 && i < vals[VEC_LEN] {
			if expr_may_change_slice(vec_get(vals, i), name) != 0 {
				return 1
			}
			i = i + 1
		}
		let targets = s[MU_TARGETS]
		i = 0
		for targets != 0 && i < targets[VEC_LEN] {
			if expr_may_change_slice(vec_get(targets, i), name) != 0 {
				return 1
			}
			i = i + 1
		}
		return 0
	}
	if k == ST_EXPR {
		return expr_may_change_slice(s[ES_X], name)
	}
	if k == ST_IF {
		return i64(stmt_may_change_slice(s[IF_INIT], name) != 0 || expr_may_change_slice(s[IF_COND], name) != 0 || stmt_may_change_slice(s[IF_THEN], name) != 0 || stmt_may_change_slice(s[IF_ELSE], name) != 0)
	}
	if k == ST_WHILE {
		return i64(stmt_may_change_slice(s[WH_INIT], name) != 0 || expr_may_change_slice(s[WH_COND], name) != 0 || stmt_may_change_slice(s[WH_POST], name) != 0 || stmt_may_change_slice(s[WH_BODY], name) != 0)
	}
	if k == ST_RANGE {
		return i64(expr_may_change_slice(s[RG_EXPR], name) != 0 || stmt_may_change_slice(s[RG_BODY], name) != 0)
	}
	if k == ST_CALLMULTI {
		return expr_may_change_slice(s[CM_CALL], name)
	}
	if k == ST_RETURN || k == ST_BREAK || k == ST_CONTINUE || k == ST_CONST {
		return 0
	}
	// Switch, defer and other less common control forms keep the existing checks.
	return 1
}

fn expr_may_change_slice(e i64, name i64) i64 {
	if e == 0 {
		return 0
	}
	let k = e[N_KIND]
	if k == EX_CALL {
		let callee = e[CALL_CALLEE]
		if callee != 0 {
			if callee[N_KIND] == EX_IDENT {
				let target = lookup_name(callee[ID_NAME])
				if target != 0 && target[S_KIND] == SYM_LOCAL && kind_of(target[S_TYPE]) == K_FUNC {
					return 1
				}
			} else if callee[N_KIND] == EX_SELECT {
				let base = callee[SEL_X]
				if base[N_KIND] != EX_IDENT {
					return 1
				}
				let target = lookup_name(base[ID_NAME])
				if target != 0 && target[S_KIND] == SYM_LOCAL {
					return 1
				}
			} else {
				return 1
			}
		} else if e[CALL_NAME] != 0 {
			let target = lookup_name(e[CALL_NAME])
			if target != 0 && target[S_KIND] == SYM_LOCAL && kind_of(target[S_TYPE]) == K_FUNC {
				return 1
			}
		}
		let args = e[CALL_ARGS]
		mut i = 0
		for args != 0 && i < args[VEC_LEN] {
			let a = vec_get(args, i)
			if a[N_KIND] == EX_MUTARG {
				let target = a[MUTARG_X]
				if name == 0 || (target[N_KIND] == EX_IDENT && streq(target[ID_NAME], name) != 0) {
					return 1
				}
			}
			if expr_may_change_slice(a, name) != 0 {
				return 1
			}
			i = i + 1
		}
		return expr_may_change_slice(callee, name)
	}
	if k == EX_BINARY {
		return i64(expr_may_change_slice(e[BIN_L], name) != 0 || expr_may_change_slice(e[BIN_R], name) != 0)
	}
	if k == EX_UNARY {
		return expr_may_change_slice(e[UN_X], name)
	}
	if k == EX_CONV {
		return expr_may_change_slice(e[CV_X], name)
	}
	if k == EX_SELECT {
		return expr_may_change_slice(e[SEL_X], name)
	}
	if k == EX_INDEX {
		return i64(expr_may_change_slice(e[IX_X], name) != 0 || expr_may_change_slice(e[IX_I], name) != 0)
	}
	if k == EX_SLICE {
		return i64(expr_may_change_slice(e[SL_X], name) != 0 || expr_may_change_slice(e[SL_LO], name) != 0 || expr_may_change_slice(e[SL_HI], name) != 0)
	}
	if k == EX_MEM {
		return i64(expr_may_change_slice(e[MEM_BASE], name) != 0 || expr_may_change_slice(e[MEM_INDEX], name) != 0 || expr_may_change_slice(e[MEM_LEN], name) != 0)
	}
	if k == EX_ELEM {
		return i64(expr_may_change_slice(e[ELEM_SEQ], name) != 0 || expr_may_change_slice(e[ELEM_IDX], name) != 0)
	}
	if k == EX_MUTARG {
		let target = e[MUTARG_X]
		return i64(name == 0 || (target[N_KIND] == EX_IDENT && streq(target[ID_NAME], name) != 0) || expr_may_change_slice(target, name) != 0)
	}
	if k == EX_INT || k == EX_STR || k == EX_IDENT || k == EX_FLOAT || k == EX_NIL || k == EX_TYPE || k == EX_FUNCREF || k == EX_REG {
		return 0
	}
	// Sequence, closure, composite, try/catch and unknown expressions are not proven pure here.
	return 1
}

// names_assigned reports whether any statement under s assigns to a variable named
// a or b (shadowing declarations are fine: they make different symbols).
fn names_assigned(s i64, a i64, b i64) i64 {
	if s == 0 {
		return 0
	}
	let mx = mt_stmt_expr(s)
	if mx != 0 && mx[N_KIND] == EX_MATCH && mt_names_assigned(mx, a, b) != 0 {
		return 1
	}
	let k = s[N_KIND]
	if k == ST_ASSIGN {
		let t = s[AS_TARGET]
		if t[N_KIND] == EX_IDENT && (streq(t[ID_NAME], a) != 0 || streq(t[ID_NAME], b) != 0) {
			return 1
		}
		return 0
	}
	if k == ST_MULTI && s[MU_DEFINE] == 0 {
		let ts = s[MU_TARGETS]
		mut i = 0
		for i < ts[VEC_LEN] {
			let t = vec_get(ts, i)
			if t[N_KIND] == EX_IDENT && (streq(t[ID_NAME], a) != 0 || streq(t[ID_NAME], b) != 0) {
				return 1
			}
			i = i + 1
		}
		return 0
	}
	if k == ST_BLOCK {
		mut i = 0
		for i < s[BLK_STMTS][VEC_LEN] {
			if names_assigned(vec_get(s[BLK_STMTS], i), a, b) != 0 {
				return 1
			}
			i = i + 1
		}
		return 0
	}
	if k == ST_IF {
		return i64(names_assigned(s[IF_INIT], a, b) != 0 || names_assigned(s[IF_THEN], a, b) != 0 || names_assigned(s[IF_ELSE], a, b) != 0)
	}
	if k == ST_WHILE {
		return i64(names_assigned(s[WH_INIT], a, b) != 0 || names_assigned(s[WH_BODY], a, b) != 0 || names_assigned(s[WH_POST], a, b) != 0)
	}
	if k == ST_RANGE {
		if s[RG_DEFINE] == 0 && ((s[RG_KEY] != 0 && s[RG_KEY][N_KIND] == EX_IDENT && (streq(s[RG_KEY][ID_NAME], a) != 0 || streq(s[RG_KEY][ID_NAME], b) != 0)) || (s[RG_VAL] != 0 && s[RG_VAL][N_KIND] == EX_IDENT && (streq(s[RG_VAL][ID_NAME], a) != 0 || streq(s[RG_VAL][ID_NAME], b) != 0))) {
			return 1
		}
		return names_assigned(s[RG_BODY], a, b)
	}
	if k == ST_SWITCH {
		if names_assigned(s[SW_INIT], a, b) != 0 {
			return 1
		}
		let cs = s[SW_CASES]
		mut i = 0
		for i < cs[VEC_LEN] {
			if names_assigned(vec_get(vec_get(cs, i), 1), a, b) != 0 {
				return 1
			}
			i = i + 1
		}
	}
	return 0
}

// mark_safe_index drops the bounds check of x[i] when a loop or condition proved i is
// within x's length.
fn mark_safe_index(e i64) {
	let x = e[ELEM_SEQ]
	let i = e[ELEM_IDX]
	if x[N_KIND] != EX_IDENT || i[N_KIND] != EX_IDENT {
		return
	}
	mut j = 0
	for j < safe_pairs[VEC_LEN] {
		let p = vec_get(safe_pairs, j)
		if vec_get(p, 0) == i[ID_REF] && vec_get(p, 1) == x[ID_REF] {
			e[ELEM_SAFE] = 1
			return
		}
		j = j + 1
	}
}

// len_bound matches `i < len(x)` or `i < n` where n remembers len(x), and
// returns [i sym, x sym, remembered length sym], or 0.
fn len_bound(c i64) i64 {
	if c[N_KIND] != EX_BINARY || streq(c[BIN_OP], cstr("<")) == 0 {
		return 0
	}
	let l = c[BIN_L]
	let r = c[BIN_R]
	if l[N_KIND] != EX_IDENT {
		return 0
	}
	let is = l[ID_REF]
	mut xs = 0
	mut length = 0
	if r[N_KIND] == EX_MEM && r[MEM_HDR] != 0 && r[MEM_OFF] == 0 && r[MEM_BASE][N_KIND] == EX_IDENT {
		xs = r[MEM_BASE][ID_REF]
	} else if r[N_KIND] == EX_IDENT {
		length = r[ID_REF]
		if length != 0 {
			xs = len_alias_source(length)
		}
	}
	if is == 0 || xs == 0 || is[S_KIND] != SYM_LOCAL || xs[S_KIND] != SYM_LOCAL {
		return 0
	}
	let b = pair(is, xs)
	vec_push(b, length)
	return b
}

// add_len_fact makes x[i] unchecked inside `if i < len(x) {...}` when i cannot be
// negative (unsigned, or `i >= 0 &&` first) and the block reassigns neither.
fn add_len_fact(c i64, then i64) {
	mut b = len_bound(c)
	mut nonneg = 0
	if b == 0 && c[N_KIND] == EX_BINARY && streq(c[BIN_OP], cstr("&&")) != 0 {
		let lo = c[BIN_L]
		b = len_bound(c[BIN_R])
		if b != 0 && lo[N_KIND] == EX_BINARY && streq(lo[BIN_OP], cstr(">=")) != 0 && lo[BIN_L][N_KIND] == EX_IDENT && lo[BIN_L][ID_REF] == vec_get(b, 0) && is_const_zero(lo[BIN_R]) != 0 {
			nonneg = 1
		}
	}
	if b == 0 {
		return
	}
	let is = vec_get(b, 0)
	if is_unsigned_t(is[S_TYPE]) != 0 {
		nonneg = 1
	}
	let xs = vec_get(b, 1)
	let length = vec_get(b, 2)
	mut stable = i64(names_assigned(then, is[S_NAME], xs[S_NAME]) == 0 && stmt_may_change_slice(then, xs[S_NAME]) == 0)
	if length != 0 && names_assigned(then, length[S_NAME], cstr("")) != 0 {
		stable = 0
	}
	if nonneg != 0 && stable != 0 {
		vec_push(safe_pairs, b)
	}
}

// lower_for_init checks `for init; cond; post {}` as { init; for cond; post {} },
// proving `for i := c; i < len(x); i++` keeps i in range for x[i] in the body.
fn lower_for_init(s i64) {
	let init = s[WH_INIT]
	mut init_name = 0
	if init[N_KIND] == ST_LET {
		init_name = init[LET_NAME]
	}
	let s_pos = s[N_POS]
	let inner = node_new(ST_WHILE, s[N_POS])
	replace_node(inner, s)
	inner[WH_INIT] = 0
	let b = empty_block(s[N_POS])
	vec_push(b[BLK_STMTS], init)
	vec_push(b[BLK_STMTS], inner)
	replace_node(s, b)
	push_scope()
	check_stmt(init)
	check_cond(inner[WH_COND])
	let saved = safe_pairs[VEC_LEN]
	let bound = len_bound(inner[WH_COND])
	if bound != 0 && ck_legacy == 0 && init[N_KIND] == ST_LET && init[LET_SYM] == vec_get(bound, 0) && init[LET_INIT][N_KIND] == EX_INT && init[LET_INIT][INT_VAL] >= 0 && is_increment(inner[WH_POST], init[LET_NAME]) != 0 {
		let xs = vec_get(bound, 1)
		let length = vec_get(bound, 2)
		mut stable = i64(names_assigned(inner[WH_BODY], init[LET_NAME], xs[S_NAME]) == 0 && stmt_may_change_slice(inner[WH_BODY], xs[S_NAME]) == 0)
		if length != 0 {
			if names_assigned(inner[WH_BODY], length[S_NAME], xs[S_NAME]) != 0 || names_assigned(inner[WH_POST], length[S_NAME], xs[S_NAME]) != 0 || names_assigned(inner[WH_POST], xs[S_NAME], cstr("")) != 0 || stmt_may_change_slice(inner[WH_POST], xs[S_NAME]) != 0 {
				stable = 0
			}
		}
		if stable != 0 {
			vec_push(safe_pairs, pair(vec_get(bound, 0), xs))
		}
	}
	ck_loops = ck_loops + 1
	ck_breaks = ck_breaks + 1
	check_scoped(inner[WH_BODY])
	safe_pairs[VEC_LEN] = saved
	if inner[WH_POST] != 0 {
		push_scope()
		check_stmt(inner[WH_POST])
		pop_scope()
		// A loop variable a closure captures is a fresh variable in each iteration: before the post
		// statement, move its current value into a new cell, so closures made earlier keep the old one.
		if init[N_KIND] == ST_BLOCK || init[N_KIND] == ST_LET {
			mut lv = 0
			if init_name != 0 {
				lv = lookup_name_local(init_name)
			}
			if lv != 0 && lv[S_CELL] != 0 {
				let pos = s_pos
				let t = lv[S_TYPE]
				let csym = lv[S_CELL_SYM]
				let old_val = temp(pos, mk_mem(pos, sym_ref_node(pos, csym), 0, 0, 0, t), t)
				let nb = node_new(ST_BLOCK, pos)
				nb[BLK_STMTS] = vec_new()
				nb[BLK_FLAT] = 1
				vec_push(nb[BLK_STMTS], old_val)
				vec_push(nb[BLK_STMTS], assign_stmt(pos, sym_ref_node(pos, csym), rt_call(pos, cstr("rt_alloc"), args1(mk_int(pos, 8, ty_int)), ty_int)))
				vec_push(nb[BLK_STMTS], assign_stmt(pos, mk_mem(pos, sym_ref_node(pos, csym), 0, 0, 0, t), sym_ref_node(pos, old_val[LET_SYM])))
				vec_push(nb[BLK_STMTS], inner[WH_POST])
				inner[WH_POST] = nb
			}
		}
	}
	ck_loops = ck_loops - 1
	ck_breaks = ck_breaks - 1
	pop_scope()
}

// is_increment matches the unchecked post statement `i = i + c` (i++, i += c) with c > 0.
// is_increment reports whether post adds a positive constant to name. The step is at most 2^32:
// with the counter below a length (far under 2^62), counter + step cannot wrap past MaxInt64
// to a negative index, which the bounds proof relies on (#95).
fn is_increment(post i64, name i64) i64 {
	if post == 0 || post[N_KIND] != ST_ASSIGN {
		return 0
	}
	let t = post[AS_TARGET]
	let v = post[AS_VALUE]
	return i64(t[N_KIND] == EX_IDENT && streq(t[ID_NAME], name) != 0 && v[N_KIND] == EX_BINARY && streq(v[BIN_OP], cstr("+")) != 0 && v[BIN_L][N_KIND] == EX_IDENT && streq(v[BIN_L][ID_NAME], name) != 0 && v[BIN_R][N_KIND] == EX_INT && v[BIN_R][INT_VAL] > 0 && v[BIN_R][INT_VAL] <= 4294967296)
}

// ---- optional narrowing ----
// narrow_begin narrows x from ?T to T where the condition proves x != nil (sense 1:
// the condition holds; sense 0: it failed). It returns what narrow_end restores.
fn narrow_begin(c i64, sense i64) i64 {
	if ck_legacy != 0 || c[N_KIND] != EX_BINARY {
		return 0
	}
	let op = c[BIN_OP]
	// a != nil && b != nil holds, or a == nil || b == nil failed: both are narrowed.
	if (streq(op, cstr("&&")) != 0 && sense != 0) || (streq(op, cstr("||")) != 0 && sense == 0) {
		let ra = narrow_begin(c[BIN_L], sense)
		let rb = narrow_begin(c[BIN_R], sense)
		if ra == 0 {
			return rb
		}
		if rb == 0 {
			return ra
		}
		let both = vec_new()
		vec_push(both, 0)
		vec_push(both, ra)
		vec_push(both, rb)
		return both
	}
	mut x = c[BIN_L]
	mut other = c[BIN_R]
	if x[N_KIND] != EX_IDENT {
		x = c[BIN_R]
		other = c[BIN_L]
	}
	if x[N_KIND] != EX_IDENT || x[ID_REF] == 0 || other[N_KIND] != EX_INT || other[INT_VAL] != 0 {
		return 0
	}
	let s = x[ID_REF]
	if s[S_KIND] != SYM_LOCAL || kind_of(s[S_TYPE]) != K_OPT {
		return 0
	}
	let nonnil = i64((streq(op, cstr("!=")) != 0 && sense != 0) || (streq(op, cstr("==")) != 0 && sense == 0))
	if nonnil == 0 {
		return 0
	}
	let rec = pair(s, s[S_TYPE])
	s[S_TYPE] = s[S_TYPE][TY_ELEM]
	return rec
}

fn narrow_end(rec i64) {
	if rec != 0 && vec_get(rec, 0) == 0 {
		narrow_end(vec_get(rec, 2))
		narrow_end(vec_get(rec, 1))
	} else if rec != 0 {
		vec_get(rec, 0)[S_TYPE] = vec_get(rec, 1)
	}
}

// narrow_kill is where assigning to a narrowed variable would end the narrowing; a
// narrowed x has type T there, so assigning nil to it is already a type error.
fn narrow_kill(target i64) {
}

// ---- keep: deep copies into the long-lived heap ----
shared mut keep_types i64
shared mut keep_fns i64

// keep_fn returns (generating on first use) keep$N(x T) T, which copies x and everything
// it references into the core's ingot heap.
fn keep_fn(t i64) i64 {
	if keep_types == 0 {
		keep_types = vec_new()
		keep_fns = vec_new()
	}
	mut i = 0
	for i < keep_types[VEC_LEN] {
		if vec_get(keep_types, i) == t {
			return vec_get(keep_fns, i)
		}
		i = i + 1
	}
	if type_cycle(t, vec_new()) != 0 {
		err_code_type(0, cstr("E320 KEEP_TYPE"), cstr("keep cannot copy the recursive type "), t, cstr(""))
	}
	lifted_count = lifted_count + 1
	let pos = 0
	let f = fn_new(pos, cstr("keep"))
	let nb = buf_new()
	buf_str(nb, cstr("keep$"))
	buf_int(nb, lifted_count)
	buf_byte(nb, 0)
	f[F_QNAME] = nb[VEC_DATA]
	f[F_NAME] = nb[VEC_DATA]
	f[F_LIFTED] = 2
	vec_push(f[F_PARAMS], cstr("x"))
	vec_push(f[F_PTYPES], t)
	vec_push(f[F_RTYPES], t)
	f[F_TYPE] = func_of(f[F_PTYPES], f[F_RTYPES], 0)
	f[F_LOCALS] = vec_new()
	f[F_BODY] = empty_block(pos)
	vec_push(keep_types, t)
	vec_push(keep_fns, f)
	vec_push(prog_fns, f)
	let saved_fn = ck_fn
	ck_fn = f
	let x = sym_new(SYM_LOCAL, cstr("x"), pos)
	x[S_TYPE] = t
	x[S_SLOT] = 0
	f[F_SLOTS] = 1
	vec_push(f[F_LOCALS], x)
	let body = f[F_BODY][BLK_STMTS]
	let k = kind_of(t)
	let ret = node_new(ST_RETURN, pos)
	if k == K_DYN {
		ret[RET_VALUE] = mk_conv(pos, sym_ref_node(pos, x), CV_DYN_KEEP, t)
	} else if k == K_ERROR {
		// A fault record with its chain (cause, joined faults, trace), identities kept.
		ret[RET_VALUE] = rt_call(pos, cstr("rt_keep_fault"), args1(sym_ref_node(pos, x)), t)
	} else if k == K_STRING {
		ret[RET_VALUE] = rt_call(pos, cstr("rt_keep_str"), args1(sym_ref_node(pos, x)), t)
	} else if k == K_FUNC {
		// A closure: its descriptor and captured variables, deep (rt_keep_closure, #170).
		ret[RET_VALUE] = rt_call(pos, cstr("rt_keep_closure"), args1(sym_ref_node(pos, x)), t)
	} else if k == K_OPT {
		let ifs = node_new(ST_IF, pos)
		ifs[IF_COND] = mk_bin(pos, cstr("=="), sym_ref_node(pos, x), mk_int(pos, 0, t), ty_bool)
		ifs[IF_THEN] = empty_block(pos)
		let r0 = node_new(ST_RETURN, pos)
		r0[RET_VALUE] = mk_int(pos, 0, t)
		vec_push(ifs[IF_THEN][BLK_STMTS], r0)
		vec_push(body, ifs)
		let inner = keep_fn(t[TY_ELEM])
		ret[RET_VALUE] = keep_call(pos, inner, sym_ref_node(pos, x), t)
	} else if k == K_SLICE {
		let et = t[TY_ELEM]
		let out = temp(pos, rt_call(pos, cstr("rt_keep_slice"), args2(sym_ref_node(pos, x), mk_int(pos, type_width(et), ty_int)), t), t)
		vec_push(body, out)
		if is_ref(et) != 0 || is_dyn_value(et) != 0 {
			keep_each(pos, body, out[LET_SYM], et)
		}
		ret[RET_VALUE] = sym_ref_node(pos, out[LET_SYM])
	} else if k == K_STRUCT && t[TY_ENUM] != 0 {
		// Copy the object, then keep only the active variant's references.
		let out = temp(pos, rt_call(pos, cstr("rt_keep_raw"), args2(sym_ref_node(pos, x), mk_int(pos, t[TY_SIZE], ty_int)), t), t)
		vec_push(body, out)
		let vs = t[TY_ENUM]
		mut vi = 0
		for vi < vs[VEC_LEN] {
			let v = vec_get(vs, vi)
			let ifs = node_new(ST_IF, pos)
			ifs[IF_COND] = mk_bin(pos, cstr("=="), mk_mem(pos, sym_ref_node(pos, out[LET_SYM]), 0, 0, field_offset(t, 0), ty_int), mk_int(pos, vi, ty_int), ty_bool)
			ifs[IF_THEN] = empty_block(pos)
			mut kk = 0
			for kk < vec_get(v, 2) {
				mut fi = vec_get(v, 1) + kk
				let ft = field_type(t, fi)
				if is_ref(ft) != 0 || is_dyn_value(ft) != 0 {
					let src = mk_mem(pos, sym_ref_node(pos, out[LET_SYM]), 0, 0, field_offset(t, fi), ft)
					vec_push(ifs[IF_THEN][BLK_STMTS], assign_stmt(pos, field_store(pos, sym_ref_node(pos, out[LET_SYM]), t, fi), keep_call(pos, keep_fn(ft), src, ft)))
					// The kept copy's slot owns what it holds (#176).
					if rc_counted(ft) != 0 {
						vec_push(ifs[IF_THEN][BLK_STMTS], expr_stmt(rc_inc_call(pos, mk_mem(pos, sym_ref_node(pos, out[LET_SYM]), 0, 0, field_offset(t, fi), ft))))
					}
				}
				kk = kk + 1
			}
			vec_push(body, ifs)
			vi = vi + 1
		}
		ret[RET_VALUE] = sym_ref_node(pos, out[LET_SYM])
	} else if k == K_STRUCT {
		let out = temp(pos, rt_call(pos, cstr("rt_keep_raw"), args2(sym_ref_node(pos, x), mk_int(pos, t[TY_SIZE], ty_int)), t), t)
		vec_push(body, out)
		mut fi = 0
		for fi < t[TY_FIELDS][VEC_LEN] {
			let ft = field_type(t, fi)
			if is_ref(ft) != 0 || is_dyn_value(ft) != 0 {
				let src = mk_mem(pos, sym_ref_node(pos, out[LET_SYM]), 0, 0, field_offset(t, fi), ft)
				vec_push(body, assign_stmt(pos, field_store(pos, sym_ref_node(pos, out[LET_SYM]), t, fi), keep_call(pos, keep_fn(ft), src, ft)))
				// The kept copy's slot owns what it holds (#176).
				if rc_counted(ft) != 0 {
					vec_push(body, expr_stmt(rc_inc_call(pos, mk_mem(pos, sym_ref_node(pos, out[LET_SYM]), 0, 0, field_offset(t, fi), ft))))
				}
			}
			fi = fi + 1
		}
		ret[RET_VALUE] = sym_ref_node(pos, out[LET_SYM])
	} else if k == K_MAP {
		// A new ingot map, filled entry by entry with kept keys and values. Its counted
		// sides carry their drops, so rt_map_set owns the entries' counts itself (#176).
		let out = temp(pos, rt_call(pos, cstr("rt_keep_map_new"), args3(sym_ref_node(pos, x), fn_ref_node(pos, rc_map_drop(t)), mk_int(pos, rc_map_bits(t), ty_int)), t), t)
		vec_push(body, out)
		let slots = temp(pos, rt_call(pos, cstr("rt_map_slots"), args1(sym_ref_node(pos, x)), ty_int), ty_int)
		vec_push(body, slots)
		let j = declare_local(pos, cstr("$"), ty_int)
		vec_push(body, let_stmt(pos, j, mk_int(pos, 0, ty_int)))
		let w = node_new(ST_WHILE, pos)
		w[WH_COND] = mk_bin(pos, cstr("<"), sym_ref_node(pos, j), sym_ref_node(pos, slots[LET_SYM]), ty_bool)
		w[WH_POST] = assign_stmt(pos, sym_ref_node(pos, j), mk_bin(pos, cstr("+"), sym_ref_node(pos, j), mk_int(pos, 1, ty_int), ty_int))
		let wb = empty_block(pos)
		w[WH_BODY] = wb
		let live = node_new(ST_IF, pos)
		live[IF_COND] = rt_call(pos, cstr("rt_map_live"), args2(sym_ref_node(pos, x), sym_ref_node(pos, j)), ty_bool)
		live[IF_THEN] = empty_block(pos)
		mut kv = from_bits(rt_call(pos, cstr("rt_map_key"), args2(sym_ref_node(pos, x), sym_ref_node(pos, j)), ty_int), t[TY_KEY])
		mut vv = from_bits(rt_call(pos, cstr("rt_map_val"), args2(sym_ref_node(pos, x), sym_ref_node(pos, j)), ty_int), t[TY_ELEM])
		let kc = key_composite(t[TY_KEY])
		if kc != 0 {
			// An encoded key: rt_map_setk copies its bytes into the kept map.
			kv = from_bits(rt_call(pos, cstr("rt_map_key"), args2(sym_ref_node(pos, x), sym_ref_node(pos, j)), ty_int), ty_string)
		} else if is_ref(t[TY_KEY]) != 0 {
			kv = keep_call(pos, keep_fn(t[TY_KEY]), kv, t[TY_KEY])
		}
		if is_ref(t[TY_ELEM]) != 0 || is_dyn_value(t[TY_ELEM]) != 0 {
			vv = keep_call(pos, keep_fn(t[TY_ELEM]), vv, t[TY_ELEM])
		}
		if kc != 0 {
			vec_push(live[IF_THEN][BLK_STMTS], expr_stmt(rt_call(pos, cstr("rt_map_setk"), args3(sym_ref_node(pos, out[LET_SYM]), to_bits(kv), to_bits(vv)), ty_void)))
		} else {
			let setargs = args4(sym_ref_node(pos, out[LET_SYM]), to_bits(kv), to_bits(vv), mk_int(pos, 1, ty_int))
			vec_push(live[IF_THEN][BLK_STMTS], expr_stmt(rt_call(pos, cstr("rt_map_set"), setargs, ty_void)))
		}
		vec_push(wb[BLK_STMTS], live)
		vec_push(body, w)
		ret[RET_VALUE] = sym_ref_node(pos, out[LET_SYM])
	} else {
		ret[RET_VALUE] = sym_ref_node(pos, x)
	}
	vec_push(body, ret)
	ck_fn = saved_fn
	return f
}

fn keep_call(pos i64, f i64, arg i64, t i64) i64 {
	let c = node_new(EX_CALL, pos)
	c[CALL_NAME] = f[F_QNAME]
	c[CALL_ARGS] = args1(arg)
	c[CALL_FN] = f
	c[N_TYPE] = t
	return c
}

// ---- drops: what a kept object's slots own (#176, notes/interface_mem.md) ----
// rc_counted reports whether values of t own long-lived counts: str, slice, map, struct
// (an enum with payloads is one) and opt of those. Func values (code pointers and kept
// closures), faults and dyn objects are not counted yet (known gaps: they leak, never
// corrupt).
fn rc_counted(t i64) i64 {
	let k = kind_of(t)
	if k == K_STRING || k == K_SLICE || k == K_MAP || k == K_STRUCT {
		return 1
	}
	if k == K_OPT {
		return rc_counted(t[TY_ELEM])
	}
	return 0
}

// fn_ref_node is f as a func value argument (the runtime calls it with one word).
fn fn_ref_node(pos i64, f i64) i64 {
	let n = node_new(EX_FUNCREF, pos)
	n[FR_FN] = f
	n[N_TYPE] = f[F_TYPE]
	// A drop can be lifted after the reachability pass (rc_mark), so mark it here.
	if rc_reach_ok != 0 {
		mark_reach(f)
	}
	return n
}

// rc_inc_call emits rt_rc_inc(v).
fn rc_inc_call(pos i64, v i64) i64 {
	let c = rt_call(pos, cstr("rt_rc_inc"), args1(v), ty_void)
	if rc_reach_ok != 0 {
		mark_reach(c[CALL_FN])
	}
	return c
}

// rc_dec_call emits rt_rc_dec(v, drop).
fn rc_dec_call(pos i64, v i64, drop i64) i64 {
	let c = rt_call(pos, cstr("rt_rc_dec"), args2(v, fn_ref_node(pos, drop)), ty_void)
	if rc_reach_ok != 0 {
		mark_reach(c[CALL_FN])
	}
	return c
}

// rc_none is the runtime's own no-op drop: the drop of childless blocks.
fn rc_none() i64 {
	return find_fn(cstr("rt_rc_drop_none"))
}

// rc_map_bits is a map type's counted sides (#176): bit 0 the key side (str keys and
// encoded struct or enum keys), bit 1 the value side.
fn rc_map_bits(t i64) i64 {
	mut b = 0
	if map_str_keys(t[TY_KEY]) != 0 {
		b = b | 1
	}
	if rc_counted(t[TY_ELEM]) != 0 {
		b = b | 2
	}
	return b
}

// rc_map_drop is the value side's drop of a map type (the runtime's no-op when that
// side is not counted).
fn rc_map_drop(t i64) i64 {
	if rc_counted(t[TY_ELEM]) != 0 {
		return drop_fn(t[TY_ELEM])
	}
	return rc_none()
}

shared mut drop_types i64
shared mut drop_fns i64
shared mut arrdrop_types i64
shared mut arrdrop_fns i64

// drop_fn returns (generating on first use) drop$N(x T), the drop of blocks of type T:
// one long-lived count leaves every counted child of x (fields, elements, entries); the
// block itself rt_rc_dec already queued. A str has no children, so the runtime's own
// no-op drop serves and map[str]str lifts no function at all.
fn drop_fn(t i64) i64 {
	if kind_of(t) == K_STRING {
		return rc_none()
	}
	if drop_types == 0 {
		drop_types = vec_new()
		drop_fns = vec_new()
	}
	mut i = 0
	for i < drop_types[VEC_LEN] {
		if vec_get(drop_types, i) == t {
			return vec_get(drop_fns, i)
		}
		i = i + 1
	}
	let names = vec_new()
	vec_push(names, cstr("x"))
	let types = vec_new()
	vec_push(types, t)
	let f = lifted_fn(cstr("drop"), names, types, vec_new())
	vec_push(drop_types, t)
	vec_push(drop_fns, f)
	let saved_fn = ck_fn
	ck_fn = f
	let pos = 0
	let x = vec_get(f[F_LOCALS], 0)
	rc_drop_body(pos, f[F_BODY][BLK_STMTS], sym_ref_node(pos, x), t)
	ck_fn = saved_fn
	return f
}

// rc_drop_body appends the releases of x's children to body: what one long-lived
// reference to a value of type t holds.
fn rc_drop_body(pos i64, body i64, x i64, t i64) {
	let k = kind_of(t)
	if k == K_SLICE {
		let data = mk_hdr(pos, x, 2)
		vec_push(body, expr_stmt(rc_dec_call(pos, data, arrdrop_fn(t[TY_ELEM]))))
	} else if k == K_MAP {
		let slots = temp(pos, rt_call(pos, cstr("rt_map_slots"), args1(x), ty_int), ty_int)
		vec_push(body, slots)
		let j = declare_local(pos, cstr("$"), ty_int)
		vec_push(body, let_stmt(pos, j, mk_int(pos, 0, ty_int)))
		let w = node_new(ST_WHILE, pos)
		w[WH_COND] = mk_bin(pos, cstr("<"), sym_ref_node(pos, j), sym_ref_node(pos, slots[LET_SYM]), ty_bool)
		w[WH_POST] = assign_stmt(pos, sym_ref_node(pos, j), mk_bin(pos, cstr("+"), sym_ref_node(pos, j), mk_int(pos, 1, ty_int), ty_int))
		let wb = empty_block(pos)
		w[WH_BODY] = wb
		let live = node_new(ST_IF, pos)
		live[IF_COND] = rt_call(pos, cstr("rt_map_live"), args2(x, sym_ref_node(pos, j)), ty_bool)
		live[IF_THEN] = empty_block(pos)
		if (rc_map_bits(t) & 1) != 0 {
			mut kt = t[TY_KEY]
			if key_composite(kt) != 0 {
				kt = ty_string
			}
			vec_push(live[IF_THEN][BLK_STMTS], expr_stmt(rc_dec_call(pos, from_bits(rt_call(pos, cstr("rt_map_key"), args2(x, sym_ref_node(pos, j)), ty_int), kt), rc_none())))
		}
		if rc_counted(t[TY_ELEM]) != 0 {
			vec_push(live[IF_THEN][BLK_STMTS], expr_stmt(rc_dec_call(pos, from_bits(rt_call(pos, cstr("rt_map_val"), args2(x, sym_ref_node(pos, j)), ty_int), t[TY_ELEM]), drop_fn(t[TY_ELEM]))))
		}
		vec_push(wb[BLK_STMTS], live)
		vec_push(body, w)
		// The map is dead by now (drop runs at release): its tables go with it.
		let rel = rt_call(pos, cstr("rt_map_release"), args1(x), ty_void)
		if rc_reach_ok != 0 {
			mark_reach(rel[CALL_FN])
		}
		vec_push(body, expr_stmt(rel))
	} else if k == K_OPT {
		let ifs = node_new(ST_IF, pos)
		ifs[IF_COND] = mk_bin(pos, cstr("!="), x, mk_int(pos, 0, t), ty_bool)
		ifs[IF_THEN] = empty_block(pos)
		vec_push(ifs[IF_THEN][BLK_STMTS], expr_stmt(call_fn(pos, drop_fn(t[TY_ELEM]), args1(x), ty_void)))
		vec_push(body, ifs)
	} else if k == K_STRUCT && t[TY_ENUM] != 0 {
		let vs = t[TY_ENUM]
		mut vi = 0
		for vi < vs[VEC_LEN] {
			let v = vec_get(vs, vi)
			let ifs = node_new(ST_IF, pos)
			ifs[IF_COND] = mk_bin(pos, cstr("=="), mk_mem(pos, x, 0, 0, field_offset(t, 0), ty_int), mk_int(pos, vi, ty_int), ty_bool)
			ifs[IF_THEN] = empty_block(pos)
			mut kk = 0
			for kk < vec_get(v, 2) {
				mut fi = vec_get(v, 1) + kk
				let ft = field_type(t, fi)
				if rc_counted(ft) != 0 {
					vec_push(ifs[IF_THEN][BLK_STMTS], expr_stmt(rc_dec_call(pos, mk_mem(pos, x, 0, 0, field_offset(t, fi), ft), drop_fn(ft))))
				}
				kk = kk + 1
			}
			vec_push(body, ifs)
			vi = vi + 1
		}
	} else if k == K_STRUCT {
		mut fi = 0
		for fi < t[TY_FIELDS][VEC_LEN] {
			let ft = field_type(t, fi)
			if rc_counted(ft) != 0 {
				vec_push(body, expr_stmt(rc_dec_call(pos, mk_mem(pos, x, 0, 0, field_offset(t, fi), ft), drop_fn(ft))))
			}
			fi = fi + 1
		}
	}
}

// arrdrop_fn returns (generating on first use) arrdrop$N(p i64), the drop of a slice
// backing array of element type T: each element block loses its slot's count. Elements
// of an uncounted type never had one: the no-op drop serves.
fn arrdrop_fn(et i64) i64 {
	if rc_counted(et) == 0 {
		return rc_none()
	}
	if arrdrop_types == 0 {
		arrdrop_types = vec_new()
		arrdrop_fns = vec_new()
	}
	mut i = 0
	for i < arrdrop_types[VEC_LEN] {
		if vec_get(arrdrop_types, i) == et {
			return vec_get(arrdrop_fns, i)
		}
		i = i + 1
	}
	let names = vec_new()
	vec_push(names, cstr("p"))
	let types = vec_new()
	vec_push(types, ty_int)
	let f = lifted_fn(cstr("arrdrop"), names, types, vec_new())
	vec_push(arrdrop_types, et)
	vec_push(arrdrop_fns, f)
	let saved_fn = ck_fn
	ck_fn = f
	let pos = 0
	let p = vec_get(f[F_LOCALS], 0)
	let body = f[F_BODY][BLK_STMTS]
	let n = temp(pos, rt_call(pos, cstr("rt_rc_arr_n"), args2(sym_ref_node(pos, p), mk_int(pos, type_width(et), ty_int)), ty_int), ty_int)
	vec_push(body, n)
	let j = declare_local(pos, cstr("$"), ty_int)
	vec_push(body, let_stmt(pos, j, mk_int(pos, 0, ty_int)))
	let w = node_new(ST_WHILE, pos)
	w[WH_COND] = mk_bin(pos, cstr("<"), sym_ref_node(pos, j), sym_ref_node(pos, n[LET_SYM]), ty_bool)
	w[WH_POST] = assign_stmt(pos, sym_ref_node(pos, j), mk_bin(pos, cstr("+"), sym_ref_node(pos, j), mk_int(pos, 1, ty_int), ty_int))
	let wb = empty_block(pos)
	w[WH_BODY] = wb
	let cell = mk_mem(pos, sym_ref_node(pos, p), sym_ref_node(pos, j), type_width(et), 0, et)
	vec_push(wb[BLK_STMTS], expr_stmt(rc_dec_call(pos, cell, drop_fn(et))))
	vec_push(body, w)
	ck_fn = saved_fn
	return f
}

// keep_each replaces every element of the (already copied) ingot slice out by a kept copy
// whose slot owns it (#176).
fn keep_each(pos i64, body i64, out i64, et i64) {
	let n = temp(pos, mk_hdr(pos, sym_ref_node(pos, out), 0), ty_int)
	vec_push(body, n)
	let data = temp(pos, mk_hdr(pos, sym_ref_node(pos, out), 2), ty_int)
	vec_push(body, data)
	let j = declare_local(pos, cstr("$"), ty_int)
	vec_push(body, let_stmt(pos, j, mk_int(pos, 0, ty_int)))
	let w = node_new(ST_WHILE, pos)
	w[WH_COND] = mk_bin(pos, cstr("<"), sym_ref_node(pos, j), sym_ref_node(pos, n[LET_SYM]), ty_bool)
	w[WH_POST] = assign_stmt(pos, sym_ref_node(pos, j), mk_bin(pos, cstr("+"), sym_ref_node(pos, j), mk_int(pos, 1, ty_int), ty_int))
	let wb = empty_block(pos)
	let cell = mk_mem(pos, sym_ref_node(pos, data[LET_SYM]), sym_ref_node(pos, j), type_width(et), 0, et)
	let cell2 = mk_mem(pos, sym_ref_node(pos, data[LET_SYM]), sym_ref_node(pos, j), type_width(et), 0, et)
	vec_push(wb[BLK_STMTS], assign_stmt(pos, cell, keep_call(pos, keep_fn(et), cell2, et)))
	if rc_counted(et) != 0 {
		let cell3 = mk_mem(pos, sym_ref_node(pos, data[LET_SYM]), sym_ref_node(pos, j), type_width(et), 0, et)
		vec_push(wb[BLK_STMTS], expr_stmt(rc_inc_call(pos, cell3)))
	}
	w[WH_BODY] = wb
	vec_push(body, w)
}

// ---- arena results: deep copies into the parent pool (#236, notes/interface_arena.md) ----
shared mut acopy_types i64
shared mut acopy_fns i64

// arena_copyable reports whether a value of type t can be copied out of an arena: func and
// dyn values cannot (their objects are not described by their type).
fn arena_copyable(t i64, seen i64) i64 {
	let k = kind_of(t)
	if k == K_FUNC || k == K_DYN {
		return 0
	}
	if k != K_STRUCT && k != K_SLICE && k != K_MAP && k != K_OPT {
		return 1
	}
	if vec_index(seen, t) >= 0 {
		return 1
	}
	vec_push(seen, t)
	if k == K_STRUCT {
		mut fi = 0
		for fi < t[TY_FIELDS][VEC_LEN] {
			if arena_copyable(field_type(t, fi), seen) == 0 {
				return 0
			}
			fi = fi + 1
		}
		return 1
	}
	if k == K_MAP && arena_copyable(t[TY_KEY], seen) == 0 {
		return 0
	}
	return arena_copyable(t[TY_ELEM], seen)
}

// arenacopy_fn returns (generating on first use) arenacopy$N(x T) T, which copies x and
// everything it references into the current pool, as keep$N does into the ingot heap.
fn arenacopy_fn(t i64) i64 {
	if acopy_types == 0 {
		acopy_types = vec_new()
		acopy_fns = vec_new()
	}
	mut i = 0
	for i < acopy_types[VEC_LEN] {
		if vec_get(acopy_types, i) == t {
			return vec_get(acopy_fns, i)
		}
		i = i + 1
	}
	lifted_count = lifted_count + 1
	let pos = 0
	let f = fn_new(pos, cstr("arenacopy"))
	let nb = buf_new()
	buf_str(nb, cstr("arenacopy$"))
	buf_int(nb, lifted_count)
	buf_byte(nb, 0)
	f[F_QNAME] = nb[VEC_DATA]
	f[F_NAME] = nb[VEC_DATA]
	f[F_LIFTED] = 2
	vec_push(f[F_PARAMS], cstr("x"))
	vec_push(f[F_PTYPES], t)
	vec_push(f[F_RTYPES], t)
	f[F_TYPE] = func_of(f[F_PTYPES], f[F_RTYPES], 0)
	f[F_LOCALS] = vec_new()
	f[F_BODY] = empty_block(pos)
	vec_push(acopy_types, t)
	vec_push(acopy_fns, f)
	vec_push(prog_fns, f)
	let saved_fn = ck_fn
	ck_fn = f
	let x = sym_new(SYM_LOCAL, cstr("x"), pos)
	x[S_TYPE] = t
	x[S_SLOT] = 0
	f[F_SLOTS] = 1
	vec_push(f[F_LOCALS], x)
	let body = f[F_BODY][BLK_STMTS]
	let k = kind_of(t)
	let ret = node_new(ST_RETURN, pos)
	if k == K_ERROR {
		ret[RET_VALUE] = rt_call(pos, cstr("rt_arena_fault"), args1(sym_ref_node(pos, x)), t)
	} else if k == K_STRING {
		ret[RET_VALUE] = rt_call(pos, cstr("rt_arena_str"), args1(sym_ref_node(pos, x)), t)
	} else if k == K_OPT {
		let ifs = node_new(ST_IF, pos)
		ifs[IF_COND] = mk_bin(pos, cstr("=="), sym_ref_node(pos, x), mk_int(pos, 0, t), ty_bool)
		ifs[IF_THEN] = empty_block(pos)
		let r0 = node_new(ST_RETURN, pos)
		r0[RET_VALUE] = mk_int(pos, 0, t)
		vec_push(ifs[IF_THEN][BLK_STMTS], r0)
		vec_push(body, ifs)
		ret[RET_VALUE] = keep_call(pos, arenacopy_fn(t[TY_ELEM]), sym_ref_node(pos, x), t)
	} else if k == K_SLICE {
		let et = t[TY_ELEM]
		let out = temp(pos, rt_call(pos, cstr("rt_arena_slice"), args2(sym_ref_node(pos, x), mk_int(pos, type_width(et), ty_int)), t), t)
		vec_push(body, out)
		if is_ref(et) != 0 {
			let n = temp(pos, mk_hdr(pos, sym_ref_node(pos, out[LET_SYM]), 0), ty_int)
			vec_push(body, n)
			let data = temp(pos, mk_hdr(pos, sym_ref_node(pos, out[LET_SYM]), 2), ty_int)
			vec_push(body, data)
			let j = declare_local(pos, cstr("$"), ty_int)
			vec_push(body, let_stmt(pos, j, mk_int(pos, 0, ty_int)))
			let w = node_new(ST_WHILE, pos)
			w[WH_COND] = mk_bin(pos, cstr("<"), sym_ref_node(pos, j), sym_ref_node(pos, n[LET_SYM]), ty_bool)
			w[WH_POST] = assign_stmt(pos, sym_ref_node(pos, j), mk_bin(pos, cstr("+"), sym_ref_node(pos, j), mk_int(pos, 1, ty_int), ty_int))
			let wb = empty_block(pos)
			let cell = mk_mem(pos, sym_ref_node(pos, data[LET_SYM]), sym_ref_node(pos, j), type_width(et), 0, et)
			let cell2 = mk_mem(pos, sym_ref_node(pos, data[LET_SYM]), sym_ref_node(pos, j), type_width(et), 0, et)
			vec_push(wb[BLK_STMTS], assign_stmt(pos, cell, keep_call(pos, arenacopy_fn(et), cell2, et)))
			w[WH_BODY] = wb
			vec_push(body, w)
		}
		ret[RET_VALUE] = sym_ref_node(pos, out[LET_SYM])
	} else if k == K_STRUCT && t[TY_ENUM] != 0 {
		let out = temp(pos, rt_call(pos, cstr("rt_arena_raw"), args2(sym_ref_node(pos, x), mk_int(pos, t[TY_SIZE], ty_int)), t), t)
		vec_push(body, out)
		let vs = t[TY_ENUM]
		mut vi = 0
		for vi < vs[VEC_LEN] {
			let v = vec_get(vs, vi)
			let ifs = node_new(ST_IF, pos)
			ifs[IF_COND] = mk_bin(pos, cstr("=="), mk_mem(pos, sym_ref_node(pos, out[LET_SYM]), 0, 0, field_offset(t, 0), ty_int), mk_int(pos, vi, ty_int), ty_bool)
			ifs[IF_THEN] = empty_block(pos)
			mut kk = 0
			for kk < vec_get(v, 2) {
				mut fi = vec_get(v, 1) + kk
				let ft = field_type(t, fi)
				if is_ref(ft) != 0 {
					let src = mk_mem(pos, sym_ref_node(pos, out[LET_SYM]), 0, 0, field_offset(t, fi), ft)
					vec_push(ifs[IF_THEN][BLK_STMTS], assign_stmt(pos, field_store(pos, sym_ref_node(pos, out[LET_SYM]), t, fi), keep_call(pos, arenacopy_fn(ft), src, ft)))
				}
				kk = kk + 1
			}
			vec_push(body, ifs)
			vi = vi + 1
		}
		ret[RET_VALUE] = sym_ref_node(pos, out[LET_SYM])
	} else if k == K_STRUCT {
		let out = temp(pos, rt_call(pos, cstr("rt_arena_raw"), args2(sym_ref_node(pos, x), mk_int(pos, t[TY_SIZE], ty_int)), t), t)
		vec_push(body, out)
		mut fi = 0
		for fi < t[TY_FIELDS][VEC_LEN] {
			let ft = field_type(t, fi)
			if is_ref(ft) != 0 {
				let src = mk_mem(pos, sym_ref_node(pos, out[LET_SYM]), 0, 0, field_offset(t, fi), ft)
				vec_push(body, assign_stmt(pos, field_store(pos, sym_ref_node(pos, out[LET_SYM]), t, fi), keep_call(pos, arenacopy_fn(ft), src, ft)))
			}
			fi = fi + 1
		}
		ret[RET_VALUE] = sym_ref_node(pos, out[LET_SYM])
	} else if k == K_MAP {
		// A new pool map, filled entry by entry with copied keys and values.
		let out = temp(pos, rt_call(pos, cstr("rt_arena_map_new"), args1(sym_ref_node(pos, x)), t), t)
		vec_push(body, out)
		let slots = temp(pos, rt_call(pos, cstr("rt_map_slots"), args1(sym_ref_node(pos, x)), ty_int), ty_int)
		vec_push(body, slots)
		let j = declare_local(pos, cstr("$"), ty_int)
		vec_push(body, let_stmt(pos, j, mk_int(pos, 0, ty_int)))
		let w = node_new(ST_WHILE, pos)
		w[WH_COND] = mk_bin(pos, cstr("<"), sym_ref_node(pos, j), sym_ref_node(pos, slots[LET_SYM]), ty_bool)
		w[WH_POST] = assign_stmt(pos, sym_ref_node(pos, j), mk_bin(pos, cstr("+"), sym_ref_node(pos, j), mk_int(pos, 1, ty_int), ty_int))
		let wb = empty_block(pos)
		w[WH_BODY] = wb
		let live = node_new(ST_IF, pos)
		live[IF_COND] = rt_call(pos, cstr("rt_map_live"), args2(sym_ref_node(pos, x), sym_ref_node(pos, j)), ty_bool)
		live[IF_THEN] = empty_block(pos)
		mut kv = from_bits(rt_call(pos, cstr("rt_map_key"), args2(sym_ref_node(pos, x), sym_ref_node(pos, j)), ty_int), t[TY_KEY])
		mut vv = from_bits(rt_call(pos, cstr("rt_map_val"), args2(sym_ref_node(pos, x), sym_ref_node(pos, j)), ty_int), t[TY_ELEM])
		let kc = key_composite(t[TY_KEY])
		if kc != 0 {
			// An encoded key: rt_map_setk copies its bytes into the new map.
			kv = from_bits(rt_call(pos, cstr("rt_map_key"), args2(sym_ref_node(pos, x), sym_ref_node(pos, j)), ty_int), ty_string)
		} else if is_ref(t[TY_KEY]) != 0 {
			kv = keep_call(pos, arenacopy_fn(t[TY_KEY]), kv, t[TY_KEY])
		}
		if is_ref(t[TY_ELEM]) != 0 {
			vv = keep_call(pos, arenacopy_fn(t[TY_ELEM]), vv, t[TY_ELEM])
		}
		mut setname = cstr("rt_map_set")
		if kc != 0 {
			setname = cstr("rt_map_setk")
		}
		vec_push(live[IF_THEN][BLK_STMTS], expr_stmt(rt_call(pos, setname, args3(sym_ref_node(pos, out[LET_SYM]), to_bits(kv), to_bits(vv)), ty_void)))
		vec_push(wb[BLK_STMTS], live)
		vec_push(body, w)
		ret[RET_VALUE] = sym_ref_node(pos, out[LET_SYM])
	} else {
		ret[RET_VALUE] = sym_ref_node(pos, x)
	}
	vec_push(body, ret)
	ck_fn = saved_fn
	return f
}

// type_cycle reports whether t can reach itself through references (keep would not end).
fn type_cycle(t i64, path i64) i64 {
	let k = kind_of(t)
	if k != K_STRUCT && k != K_SLICE && k != K_MAP && k != K_OPT {
		return 0
	}
	mut i = 0
	for i < path[VEC_LEN] {
		if vec_get(path, i) == t {
			// Enum values are built bottom-up and never change, so a cycle made only of
			// enums (a tree) cannot loop; one through a struct, slice or map can.
			mut j = i
			for j < path[VEC_LEN] {
				let pj = vec_get(path, j)
				if !(kind_of(pj) == K_STRUCT && pj[TY_ENUM] != 0) {
					return 1
				}
				j = j + 1
			}
			return 0
		}
		i = i + 1
	}
	vec_push(path, t)
	mut found = 0
	if k == K_STRUCT {
		mut fi = 0
		for fi < t[TY_FIELDS][VEC_LEN] && found == 0 {
			found = type_cycle(field_type(t, fi), path)
			fi = fi + 1
		}
	} else if k == K_MAP {
		found = i64(type_cycle(t[TY_KEY], path) != 0 || type_cycle(t[TY_ELEM], path) != 0)
	} else {
		found = type_cycle(t[TY_ELEM], path)
	}
	path[VEC_LEN] = path[VEC_LEN] - 1
	return found
}
