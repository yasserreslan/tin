// A self-timing tour: primes, sorting, hashing, JSON and maps, each step timed in seconds.
package main

import "say"
import "tide"
import "sift"
import "seal"
import "argo"

type User struct {
	id    i64
	name  str
	email str
	score f64
	tags  []str
}

func seconds(t0 i64) f64 {
	return f64(tide.Since(t0)) / 1e9
}

// primes counts the primes below n with a sieve of Eratosthenes.
func primes(n i64) i64 {
	composite := make([]u8, n)
	count := 0
	for i := 2; i < n; i++ {
		if composite[i] == 0 {
			count++
			for j := i * i; j < n; j += i {
				composite[j] = 1
			}
		}
	}
	return count
}

func main() {
	total := tide.Now()

	t := tide.Now()
	p := primes(50000000)
	say.Out("primes below 50M:     %d  (%.3f s)\n", p, seconds(t))

	t = tide.Now()
	xs := make([]i64, 0, 5000000)
	x := u64(88172645463325252)
	for i := 0; i < 5000000; i++ {
		x ^= x << 13
		x ^= x >> 7
		x ^= x << 17
		xs = append(xs, i64(x>>1))
	}
	sift.Ints(mut xs)
	say.Out("sort 5M numbers:      sorted=%v  (%.3f s)\n", sift.IsSortedInts(xs), seconds(t))

	t = tide.Now()
	block := say.Fmt("%01048576d", 0)
	digest := ""
	for i := 0; i < 100; i++ {
		digest = seal.Sha256Hex(block)
	}
	say.Out("sha256 of 100 MB:     %s...  (%.3f s)\n", digest[:16], seconds(t))

	t = tide.Now()
	users := make([]User, 0, 200000)
	for i := 0; i < 200000; i++ {
		users = append(users, User{id: i, name: say.Fmt("user%d", i), email: say.Fmt("u%d@example.com", i), score: f64(i) * 0.5, tags: []str{"a", "b"}})
	}
	buf := make([]u8, 0, 1<<24)
	argo.Put(mut buf, users)
	back := []User{}
	err := argo.Get(str(buf), mut back)
	say.Out("json 200k users:      %d MB, decoded %d, ok=%v  (%.3f s)\n", len(buf)>>20, len(back), err == nil, seconds(t))

	t = tide.Now()
	m := make(map[i64]i64)
	for i := 0; i < 2000000; i++ {
		m[i*7] = i
	}
	hits := 0
	for i := 0; i < 4000000; i++ {
		_, ok := m[i*7]
		if ok {
			hits++
		}
	}
	say.Out("map 2M inserts, 4M lookups: hits=%d  (%.3f s)\n", hits, seconds(t))

	say.Out("total:                %.3f s\n", seconds(total))
}
