package main

import "say"
import "argo"
import "anvil"

type Message struct {
	message str
}

type Echo struct {
	path   str
	query  str
	name   str
	agent  str
	length i64
}

var hits i64

func handle(q anvil.Req, w mut anvil.Out) {
	hits++
	if q.Path == "/json" {
		w.Json()
		argo.Put(mut w.Body, Message{message: "Hello, World!"})
		return
	}
	if q.Path == "/plaintext" {
		w.Text("Hello, World!")
		return
	}
	if q.Path == "/echo" {
		w.Json()
		b := q.Body()
		argo.Put(mut w.Body, Echo{path: q.Path, query: q.Query, name: q.Param("name"), agent: q.Header("user-agent"), length: len(b)})
		return
	}
	if q.Path == "/hits" {
		w.Text(say.Fmt("%d", hits))
		return
	}
	if q.Path == "/healthz" {
		w.Text("ok")
		return
	}
	w.Status(404)
	w.Text("not found")
}

func main() {
	err := anvil.Serve(":9180", handle)
	if err != nil {
		say.Line("server:", err)
	}
}
