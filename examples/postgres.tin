package main

import "anvil"
import "argo"
import "mint"
import "postgres"
import "quarry"
import "say"

// A users service over PostgreSQL (POSTGRES_ADDR, POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DATABASE):
//   GET /setup             creates the users table
//   GET /add?name=N        adds a user, answers its id
//   GET /user?id=N         the user as JSON, or 404
//   GET /count             how many users there are
//   GET /sleep?ms=N        a statement that takes N ms (SELECT pg_sleep)
type User struct {
	id   i64
	name str
}

// Pool is the connections per core (0: max(2, 64/cores), so about 64 for the process whatever the core
// count); MaxTotal caps all cores together (0: no cap). A pod that shares a server with others sets
// MaxTotal so that pods x MaxTotal stays under the server's max_connections.
let db = postgres.Open(postgres.Options{
	Addr:     quarry.Getenv("POSTGRES_ADDR"),
	User:     quarry.Getenv("POSTGRES_USER"),
	Password: quarry.Getenv("POSTGRES_PASSWORD"),
	Database: quarry.Getenv("POSTGRES_DATABASE"),
	Pool:     env_int("POSTGRES_POOL"),
	MaxTotal: env_int("POSTGRES_MAX_TOTAL"),
	Timeout:  env_int("POSTGRES_TIMEOUT_MS")*1000000,
	SSLMode:  quarry.Getenv("POSTGRES_SSLMODE"),
})

fn env_int(name str) i64 {
	let n = mint.Atoi(quarry.Getenv(name)) catch _ { 0 }
	return n
}

fn fail_with(w mut anvil.Out, err fault) {
	w.Status(502)
	w.Text("{err}")
}

fn handle(q anvil.Req, w mut anvil.Out) {
	if q.Path == "/user" {
		let id = mint.Atoi(q.Param("id")) catch _ { -1 }
		let rows = db.Query("SELECT id, name FROM users WHERE id = {id}") catch err {
			fail_with(mut w, err)
			return
		}
		if len(rows.Rows) == 0 {
			w.Status(404)
			w.Text("no user {id}")
			return
		}
		let r = rows.Rows[0]
		w.Json()
		argo.Put(mut w.Body, User{id: r[0].Int(), name: r[1].Text()})
		return
	}
	if q.Path == "/add" {
		let name = q.Param("name")
		let res = db.Query("INSERT INTO users (name) VALUES ({name}) RETURNING id") catch err {
			fail_with(mut w, err)
			return
		}
		w.Text("{res.Rows[0][0].Int()}")
		return
	}
	if q.Path == "/count" {
		let rows = db.Query("SELECT COUNT(*) FROM users") catch err {
			fail_with(mut w, err)
			return
		}
		w.Text(rows.Rows[0][0].Text())
		return
	}
	if q.Path == "/sleep" {
		let ms = mint.Atoi(q.Param("ms")) catch _ { 100 }
		let secs = f64(ms) / 1000.0
		_ = db.Query("SELECT pg_sleep({secs})") catch err {
			fail_with(mut w, err)
			return
		}
		w.Text("slept")
		return
	}
	if q.Path == "/setup" {
		_ = db.Exec("CREATE TABLE IF NOT EXISTS users (id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, name VARCHAR(255) NOT NULL)") catch err {
			fail_with(mut w, err)
			return
		}
		w.Text("ok")
		return
	}
	w.Status(404)
	w.Text("no route {q.Path}")
}

fn main() {
	let err = anvil.Serve(":9185", handle)
	say.Line("server:", err)
}
