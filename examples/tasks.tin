package main

import "anvil"
import "mint"
import "quarry"
import "say"
import "tide"
import "wire"

// A server where some requests wait while others answer at once. On one core:
//   GET /slow?ms=N   waits N ms (tide.Wait)
//   GET /proxy?ms=N  calls this same server's /slow with wire (non-blocking inside a task)
//   GET /file        writes and reads a file (on a helper thread)
//   GET /fast        answers at once
fn slow(q anvil.Req, w mut anvil.Out) {
	let ms = mint.Atoi(q.Param("ms")) catch _ { 100 }
	let t0 = tide.Now()
	let err = tide.Wait(ms * 1ms)
	if err != nil {
		w.Status(504)
		w.Text("gave up: {err}")
		return
	}
	w.Text("slept {tide.Milliseconds(tide.Since(t0))} ms")
}

fn proxy(q anvil.Req, w mut anvil.Out) {
	mut port = q.Param("port")
	if port == "" {
		port = quarry.Getenv("PORT")
	}
	if port == "" {
		port = "9183"
	}
	mut host = q.Param("host")
	if host == "" {
		host = "127.0.0.1"
	}
	let ms = q.Param("ms")
	// The service calls itself: a connection kept for the next call would be an idle connection of
	// its own server, and hold up its graceful stop (MaxIdle -1: no keep-alive).
	let r = wire.DoWith("GET", "http://{host}:{port}/slow?ms={ms}", []str{}, "", wire.Options{Timeout: 0, MaxBody: 0, MaxIdle: -1}) catch err {
		w.Status(502)
		w.Text("upstream: {err}")
		return
	}
	w.Text("via proxy: {r.Body}")
}

fn file(q anvil.Req, w mut anvil.Out) {
	let n = q.Param("n")
	let path = "/tmp/tin-test-tasks-{n}.txt"
	quarry.WriteFile(path, "hello from a helper thread") catch err {
		w.Status(500)
		w.Text("write: {err}")
		return
	}
	let data = quarry.ReadFile(path) catch err {
		w.Status(500)
		w.Text("read: {err}")
		return
	}
	w.Text("file: {data}")
}

fn fast(q anvil.Req, w mut anvil.Out) {
	w.Text("fast")
}

fn no_route(q anvil.Req, w mut anvil.Out) {
	w.Text("no route {q.Path}")
}

fn main() {
	let r = anvil.NewRouter()
	r.Get("/slow", slow)
	r.Get("/proxy", proxy)
	r.Get("/file", file)
	r.Get("/fast", fast)
	r.NotFound(no_route)
	let err = r.Serve(":9183")
	say.Line("server:", err)
}
