package main

import "anvil"
import "mint"
import "say"
import "tide"

// A server where some requests wait (GET /slow?ms=N) while others answer at once
// (GET /fast). On one core, a waiting request does not delay the others.
func handle(q anvil.Req, w mut anvil.Out) {
	if q.Path == "/slow" {
		ms := mint.Atoi(q.Param("ms")) catch _ { 100 }
		t0 := tide.Now()
		err := tide.Wait(ms * tide.Millisecond)
		if err != nil {
			w.Status(504)
			w.Text("gave up: {err}")
			return
		}
		w.Text("slept {tide.Milliseconds(tide.Since(t0))} ms")
		return
	}
	if q.Path == "/fast" {
		w.Text("fast")
		return
	}
	w.Status(404)
	w.Text("no route {q.Path}")
}

func main() {
	err := anvil.Serve(":9183", handle)
	say.Line("server:", err)
}
