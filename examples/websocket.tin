package main

import "anvil"
import "say"
import "tide"
import "websocket"

// WebSocket endpoints:
//   /echo    sends each message back ("echo: " before text)
//   /ticks   sends "tick N" every 100 ms, ten times, then closes
//   /        a plain HTTP page
func handle(q anvil.Req, w mut anvil.Out) {
	if q.Path == "/echo" {
		ws := websocket.Accept(q, mut w) catch _ { return }
		for {
			m := ws.Read() catch _ { return }
			if m.Text {
				ws.WriteText("echo: {m.Data}") catch _ { return }
			} else {
				ws.WriteBinary([]u8(m.Data)) catch _ { return }
			}
		}
	}
	if q.Path == "/ticks" {
		ws := websocket.Accept(q, mut w) catch _ { return }
		for i := 1; i <= 10; i++ {
			tide.Wait(100 * tide.Millisecond) catch _ { return }
			ws.WriteText("tick {i}") catch _ { return }
		}
		ws.Close()
		return
	}
	w.Text("websocket demo: connect to /echo or /ticks")
}

func main() {
	err := anvil.Serve(":9186", handle)
	say.Line("server:", err)
}
