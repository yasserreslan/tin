package main

import "quarry"
import "say"
import "websocket"

// A WebSocket client for examples/websocket.tin: run it with the server's ws:// base URL.
fn main() {
	mut base = "ws://127.0.0.1:9186"
	if len(quarry.Args()) > 1 {
		base = quarry.Args()[1]
	}
	let c = websocket.Dial(base + "/echo") catch err {
		say.Line("dial:", err)
		return
	}
	c.WriteText("hi from tin") catch err { say.Line(err) }
	let m = c.Read() catch err { say.Line(err)
		return }
	say.Line(m.Text, m.Data)
	let big = make([]u8, 100000)
	for i in 0..len(big) {
		big[i] = u8(i % 251)
	}
	c.WriteBinary(big) catch err { say.Line(err) }
	let m2 = c.Read() catch err { say.Line(err)
		return }
	mut same = len(m2.Data) == len(big)
	{
		mut i = 0
		for same && i < len(big) {
			same = m2.Data[i] == big[i]
			i += 1
		}
	}
	say.Line(m2.Text, len(m2.Data), same)
	c.Close()
	let t = websocket.Dial(base + "/ticks") catch err { say.Line(err)
		return }
	mut n = 0
	for {
		let x = t.Read() catch err {
			say.Line("end:", err, websocket.IsClosed(err))
			break
		}
		n += 1
		if n == 1 {
			say.Line(x.Data)
		}
	}
	say.Line("ticks", n)
	_ = websocket.Dial(base + "/") catch err { say.Line(err)
		t }
}
