package main

import "quarry"
import "say"
import "websocket"

// A WebSocket client for examples/websocket.tin: run it with the server's ws:// base URL.
func main() {
	base := "ws://127.0.0.1:9186"
	if len(quarry.Args()) > 1 {
		base = quarry.Args()[1]
	}
	c := websocket.Dial(base + "/echo") catch err {
		say.Line("dial:", err)
		return
	}
	c.WriteText("hi from tin") catch err { say.Line(err) }
	m := c.Read() catch err { say.Line(err); return }
	say.Line(m.Text, m.Data)
	big := make([]u8, 100000)
	for i := 0; i < len(big); i++ {
		big[i] = u8(i % 251)
	}
	c.WriteBinary(big) catch err { say.Line(err) }
	m2 := c.Read() catch err { say.Line(err); return }
	same := len(m2.Data) == len(big)
	for i := 0; same && i < len(big); i++ {
		same = m2.Data[i] == big[i]
	}
	say.Line(m2.Text, len(m2.Data), same)
	c.Close()
	t := websocket.Dial(base + "/ticks") catch err { say.Line(err); return }
	n := 0
	for {
		x := t.Read() catch err {
			say.Line("end:", err, websocket.IsClosed(err))
			break
		}
		n++
		if n == 1 {
			say.Line(x.Data)
		}
	}
	say.Line("ticks", n)
	_ = websocket.Dial(base + "/") catch err { say.Line(err); t }
}
