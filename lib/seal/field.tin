package seal

// ---- constant-time arithmetic modulo an odd number, in Montgomery form ----
// An element is a []u64 of n 64-bit limbs, least significant first, holding x*R mod m with
// R = 2^(64n). Every function here runs in time that depends only on n and on public
// exponents: no branch or index depends on an element's value. A carry or borrow is a
// comparison turned into 0 or 1 (cmp and cset on arm64, cmp and setb on x86-64, no branch), and
// the high word of a product is __mulhu (umulh, mul: #474). P-256 (p256.tin) uses it for its
// field and its scalars, P-384 and RSA through monty_new (bignum.tin).

// monty is a modulus with its Montgomery constants and scratch space.
type monty struct {
	m    []u64 // the modulus
	rr   []u64 // R^2 mod m
	one  []u64 // R mod m (1 in Montgomery form)
	minv u64   // -m^-1 mod 2^64
	n    i64   // limbs
	t    []u64 // n+2 words of scratch
	u    []u64 // n words of scratch
	w    []u64 // 2n words of scratch (sqr)
}

fn new_monty(m []u64, rr []u64, one []u64, minv u64) monty {
	let n = len(m)
	return monty{m: m, rr: rr, one: one, minv: minv, n: n, t: make([]u64, n+2), u: make([]u64, n), w: make([]u64, 2*n)}
}

// elem returns a new zero element of f.
fn (f monty) elem() []u64 {
	return make([]u64, f.n)
}

// size is the length in bytes of f's elements as from_bytes and to_bytes take them: 8 per limb.
fn (f monty) size() i64 {
	return 8 * f.n
}

// The arithmetic below is @wrap (#362): sums and differences wrap modulo 2^64 by design, their
// carries and borrows are computed from the operands, and constant-time code takes no
// value-dependent branch.

// mulhi is the high 64 bits of the 128-bit product of a and b.
@wrap fn mulhi(a u64, b u64) u64 {
	return u64(__mulhu(i64(a), i64(b)))
}

// lt is 1 when a < b, else 0, as cset (no branch): the carry of s = a + b (wrapped) is lt(s, a),
// and a - b borrows when lt(a, b).
@wrap fn lt(a u64, b u64) u64 {
	return u64(i64(a < b))
}

// mul sets z = x*y/R mod m; z may alias x or y. Each round adds x*y[i] and mm*m (mm chosen so
// that the low limb becomes zero) to t in one pass with two carries (FIOS), then drops the low
// limb. The limbs are read and written by address (#474): every element is checked to have n
// limbs first, so no index can leave its slice.
@wrap fn (f mut monty) mul(z mut []u64, x []u64, y []u64) {
	let n = f.n
	if n == 4 {
		m4_mul(mut z, x, y, f.m, f.minv)
		return
	}
	let t = f.t
	if len(x) != n || len(y) != n || len(z) != n || len(f.m) != n || len(t) != n+2 {
		rt_panic("seal: a field element has the wrong number of limbs")
	}
	let xp = cast(i64, x)[2]
	let yp = cast(i64, y)[2]
	let mp = cast(i64, f.m)[2]
	let tp = cast(i64, t)[2]
	for i in 0..n+1 {
		__st(tp+8*i, 0, 3)
	}
	let minv = f.minv
	let m0 = u64(__ld(mp, 3))
	let x0 = u64(__ld(xp, 3))
	for i in 0..n {
		let yi = u64(__ld(yp+8*i, 3))
		let t0 = u64(__ld(tp, 3))
		// Limb 0: t0 + x0*yi, then mm*m0 makes it zero.
		mut lo = x0 * yi
		mut hi = mulhi(x0, yi)
		lo += t0
		hi += lt(lo, t0)
		mut c1 = hi
		let mm = lo * minv
		mut lo2 = mm * m0
		mut hi2 = mulhi(mm, m0)
		lo2 += lo
		hi2 += lt(lo2, lo)
		mut c2 = hi2
		for j in 1..n {
			let xj = u64(__ld(xp+8*j, 3))
			let tj = u64(__ld(tp+8*j, 3))
			let mj = u64(__ld(mp+8*j, 3))
			lo = xj * yi
			hi = mulhi(xj, yi)
			lo += tj
			hi += lt(lo, tj)
			lo += c1
			hi += lt(lo, c1)
			c1 = hi
			lo2 = mj * mm
			hi2 = mulhi(mj, mm)
			lo2 += lo
			hi2 += lt(lo2, lo)
			lo2 += c2
			hi2 += lt(lo2, c2)
			c2 = hi2
			__st(tp+8*(j-1), i64(lo2), 3)
		}
		let tn = u64(__ld(tp+8*n, 3))
		let s1 = tn + c1
		let k1 = lt(s1, c1)
		let s2 = s1 + c2
		let k2 = lt(s2, c2)
		__st(tp+8*(n-1), i64(s2), 3)
		__st(tp+8*n, i64(k1+k2), 3)
	}
	f.reduce(mut z, t, t[n])
}

// sqr sets z = x*x/R mod m, as mul(z, x, x) does, in about three quarters of its
// multiplications (#488); z may alias x. The square adds each cross product x[i]*x[j] (i < j)
// once, doubles the sum and adds the squares x[i]*x[i]: n(n+1)/2 products where mul takes n*n.
// A Montgomery reduction of the 2n-word square (n*n more) then divides it by R. RSA's
// exponentiations square in four of every five multiplications.
@wrap fn (f mut monty) sqr(z mut []u64, x []u64) {
	let n = f.n
	if n == 4 {
		m4_mul(mut z, x, x, f.m, f.minv)
		return
	}
	let w = f.w
	let t = f.t
	if len(x) != n || len(z) != n || len(f.m) != n || len(w) != 2*n || len(t) != n+2 {
		rt_panic("seal: a field element has the wrong number of limbs")
	}
	let xp = cast(i64, x)[2]
	let mp = cast(i64, f.m)[2]
	let wp = cast(i64, w)[2]
	let tp = cast(i64, t)[2]
	for i in 0..2*n {
		__st(wp+8*i, 0, 3)
	}
	// The cross products, each once. Row i adds x[i]*x[j] at words i+j and leaves its carry at
	// word i+n, which no earlier row reached.
	for i in 0..n-1 {
		let xi = u64(__ld(xp+8*i, 3))
		mut c = u64(0)
		for j in i+1..n {
			let xj = u64(__ld(xp+8*j, 3))
			let wk = u64(__ld(wp+8*(i+j), 3))
			mut lo = xi * xj
			mut hi = mulhi(xi, xj)
			lo += wk
			hi += lt(lo, wk)
			lo += c
			hi += lt(lo, c)
			c = hi
			__st(wp+8*(i+j), i64(lo), 3)
		}
		__st(wp+8*(i+n), i64(c), 3)
	}
	// Doubled: one bit to the left across the 2n words (the cross sum is below 2^(128n-1)).
	mut top = u64(0)
	for k in 0..2*n {
		let v = u64(__ld(wp+8*k, 3))
		__st(wp+8*k, i64(v<<1|top), 3)
		top = v >> 63
	}
	// The squares at words 2i and 2i+1. A square's high word is at most 2^64-2, so adding two
	// carries to it cannot wrap; the last carry out is 0 since x*x < 2^(128n).
	mut c = u64(0)
	for i in 0..n {
		let xi = u64(__ld(xp+8*i, 3))
		let w0 = u64(__ld(wp+16*i, 3))
		let w1 = u64(__ld(wp+16*i+8, 3))
		mut lo = xi * xi
		mut hi = mulhi(xi, xi)
		lo += w0
		hi += lt(lo, w0)
		lo += c
		hi += lt(lo, c)
		let s = w1 + hi
		c = lt(s, hi)
		__st(wp+16*i, i64(lo), 3)
		__st(wp+16*i+8, i64(s), 3)
	}
	// Montgomery reduction: round i adds mm*m at word i, mm chosen to clear that word, and its
	// carry at word i+n; top carries past it into the next round. The high half is then below 2m.
	let minv = f.minv
	top = 0
	for i in 0..n {
		let mm = u64(__ld(wp+8*i, 3)) * minv
		mut c2 = u64(0)
		for j in 0..n {
			let mj = u64(__ld(mp+8*j, 3))
			let wk = u64(__ld(wp+8*(i+j), 3))
			mut lo = mm * mj
			mut hi = mulhi(mm, mj)
			lo += wk
			hi += lt(lo, wk)
			lo += c2
			hi += lt(lo, c2)
			c2 = hi
			__st(wp+8*(i+j), i64(lo), 3)
		}
		let wn = u64(__ld(wp+8*(i+n), 3))
		let s1 = wn + c2
		let k1 = lt(s1, c2)
		let s2 = s1 + top
		let k2 = lt(s2, top)
		__st(wp+8*(i+n), i64(s2), 3)
		top = k1 + k2
	}
	for j in 0..n {
		__st(tp+8*j, __ld(wp+8*(n+j), 3), 3)
	}
	f.reduce(mut z, t, top)
}

// m4_mul is mul for four limbs (256-bit moduli: P-256's field and order, Ed25519's order),
// unrolled into registers.
@wrap fn m4_mul(z mut []u64, x []u64, y []u64, m []u64, minv u64) {
	let x0 = x[0]
	let x1 = x[1]
	let x2 = x[2]
	let x3 = x[3]
	let m0 = m[0]
	let m1 = m[1]
	let m2 = m[2]
	let m3 = m[3]
	mut t0 = u64(0)
	mut t1 = u64(0)
	mut t2 = u64(0)
	mut t3 = u64(0)
	mut t4 = u64(0)
	for i in 0..4 {
		let yi = y[i]
		// t += x*yi
		mut lo = x0 * yi
		mut hi = mulhi(x0, yi)
		lo += t0
		hi += lt(lo, t0)
		t0 = lo
		mut c = hi
		lo = x1 * yi
		hi = mulhi(x1, yi)
		lo += t1
		hi += lt(lo, t1)
		lo += c
		hi += lt(lo, c)
		t1 = lo
		c = hi
		lo = x2 * yi
		hi = mulhi(x2, yi)
		lo += t2
		hi += lt(lo, t2)
		lo += c
		hi += lt(lo, c)
		t2 = lo
		c = hi
		lo = x3 * yi
		hi = mulhi(x3, yi)
		lo += t3
		hi += lt(lo, t3)
		lo += c
		hi += lt(lo, c)
		t3 = lo
		c = hi
		let s = t4 + c
		let t5 = lt(s, c)
		t4 = s
		// t = (t + mm*m) / 2^64
		let mm = t0 * minv
		lo = mm * m0
		hi = mulhi(mm, m0)
		lo += t0
		hi += lt(lo, t0)
		c = hi
		lo = mm * m1
		hi = mulhi(mm, m1)
		lo += t1
		hi += lt(lo, t1)
		lo += c
		hi += lt(lo, c)
		t0 = lo
		c = hi
		lo = mm * m2
		hi = mulhi(mm, m2)
		lo += t2
		hi += lt(lo, t2)
		lo += c
		hi += lt(lo, c)
		t1 = lo
		c = hi
		lo = mm * m3
		hi = mulhi(mm, m3)
		lo += t3
		hi += lt(lo, t3)
		lo += c
		hi += lt(lo, c)
		t2 = lo
		c = hi
		let s2 = t4 + c
		t3 = s2
		t4 = t5 + lt(s2, c)
	}
	// t < 2m: subtract m once unless that borrows past the top word.
	let d0 = t0 - m0
	mut b = lt(t0, m0)
	let e1 = t1 - m1
	let d1 = e1 - b
	b = lt(t1, m1) | lt(e1, b)
	let e2 = t2 - m2
	let d2 = e2 - b
	b = lt(t2, m2) | lt(e2, b)
	let e3 = t3 - m3
	let d3 = e3 - b
	b = lt(t3, m3) | lt(e3, b)
	let mask = u64(0) - (b & (1 ^ t4))
	z[0] = (t0 & mask) | (d0 & ^mask)
	z[1] = (t1 & mask) | (d1 & ^mask)
	z[2] = (t2 & mask) | (d2 & ^mask)
	z[3] = (t3 & mask) | (d3 & ^mask)
}

// reduce sets z = t - m if the n+1-word value (t[:n], top) is at least m, else t, in constant
// time; t < 2m.
@wrap fn (f mut monty) reduce(z mut []u64, t []u64, top u64) {
	let n = f.n
	let d = f.u
	mut b = u64(0)
	for j in 0..n {
		let tj = t[j]
		let mj = f.m[j]
		let e = tj - mj
		d[j] = e - b
		b = lt(tj, mj) | lt(e, b)
	}
	// Keep t only when the subtraction borrowed past the top word.
	let keep_ = b & (1 ^ top)
	let mask = u64(0) - keep_
	for j in 0..n {
		z[j] = (t[j] & mask) | (d[j] & ^mask)
	}
}

// add sets z = x + y mod m; z may alias x or y.
@wrap fn (f mut monty) add(z mut []u64, x []u64, y []u64) {
	let n = f.n
	let t = f.t
	mut c = u64(0)
	for j in 0..n {
		let a = x[j]
		let s = a + y[j]
		let s2 = s + c
		c = lt(s, a) | lt(s2, s)
		t[j] = s2
	}
	f.reduce(mut z, t, c)
}

// sub sets z = x - y mod m; z may alias x or y.
@wrap fn (f mut monty) sub(z mut []u64, x []u64, y []u64) {
	let n = f.n
	let t = f.t
	mut b = u64(0)
	for j in 0..n {
		let a = x[j]
		let yj = y[j]
		let e = a - yj
		t[j] = e - b
		b = lt(a, yj) | lt(e, b)
	}
	// Add m back when it borrowed.
	let mask = u64(0) - b
	mut c = u64(0)
	for j in 0..n {
		let a = t[j]
		let s = a + (f.m[j] & mask)
		let s2 = s + c
		c = lt(s, a) | lt(s2, s)
		z[j] = s2
	}
}

// set copies x into z.
fn (f monty) set(z mut []u64, x []u64) {
	for j in 0..f.n {
		z[j] = x[j]
	}
}

// sel sets z = a when bit is 1 and z = b when bit is 0, in constant time.
@wrap fn (f monty) sel(z mut []u64, a []u64, b []u64, bit u64) {
	let mask = u64(0) - bit
	for j in 0..f.n {
		z[j] = (a[j] & mask) | (b[j] & ^mask)
	}
}

// is_zero is 1 when x is zero, else 0, in constant time.
@wrap fn (f monty) is_zero(x []u64) u64 {
	mut v = u64(0)
	for j in 0..f.n {
		v |= x[j]
	}
	return 1 ^ ((v | (u64(0) - v)) >> 63)
}

// equal is 1 when x == y, else 0, in constant time.
@wrap fn (f monty) equal(x []u64, y []u64) u64 {
	mut v = u64(0)
	for j in 0..f.n {
		v |= x[j] ^ y[j]
	}
	return 1 ^ ((v | (u64(0) - v)) >> 63)
}

// exp sets z = x^e (e big-endian and public) in Montgomery form; z may alias x. It uses 4-bit
// windows: x^1..x^15 first, then per digit four squarings and one multiplication, skipped for a
// zero digit (e is public, so branching on it reveals nothing): an inversion mod a 256-bit
// prime takes about 64 multiplications instead of one per set bit (#474).
@wrap fn (f mut monty) exp(z mut []u64, x []u64, e []u8) {
	mut table = make([][]u64, 0, 16)
	table = append(table, f.elem())
	f.set(mut table[0], f.one)
	for k in 1..16 {
		let t = f.elem()
		f.mul(mut t, table[k-1], x)
		table = append(table, t)
	}
	let acc = f.elem()
	f.set(mut acc, f.one)
	mut started = false
	for i in 0..2*len(e) {
		let w = i64(e[i/2] >> u8(4-4*(i%2))) & 15
		if started {
			for s in 0..4 {
				f.sqr(mut acc, acc)
			}
		}
		if w != 0 {
			if started {
				f.mul(mut acc, acc, table[w])
			} else {
				f.set(mut acc, table[w])
				started = true
			}
		}
	}
	f.set(mut z, acc)
}

// inv sets z = x^-1 (x^(m-2), m prime; 0 for x = 0); z may alias x.
@wrap fn (f mut monty) inv(z mut []u64, x []u64) {
	let e = f.elem()
	mut b = u64(2)
	for j in 0..f.n {
		let mj = f.m[j]
		e[j] = mj - b
		b = lt(mj, b)
	}
	f.exp(mut z, x, limbs_to_be(e))
}

// limbs_from_be reads big-endian b into n little-endian 64-bit limbs; the bytes past 8n (on the
// left) are dropped, so b must fit.
@wrap fn limbs_from_be(b secret []u8, n i64) []u64 {
	let out = make([]u64, n)
	for i in 0..len(b) {
		let k = len(b) - 1 - i
		if k/8 < n {
			out[k/8] |= u64(b[i]) << u64(8*(k%8))
		}
	}
	return out
}

// limbs_to_be writes little-endian 64-bit limbs as big-endian bytes, 8 per limb.
@wrap fn limbs_to_be(x []u64) []u8 {
	let n = len(x)
	let out = make([]u8, 8*n)
	for j in 0..n {
		let w = x[j]
		let k = 8*n - 8*j
		for b in 0..8 {
			out[k-1-b] = u8(w >> u64(8*b))
		}
	}
	return out
}

// from_bytes sets z to the big-endian value b in Montgomery form and returns 1, or returns 0
// (z unchanged) when b is not f.size() bytes or not below m. Only the result is public.
@wrap fn (f mut monty) from_bytes(z mut []u64, b []u8) u64 {
	let n = f.n
	if len(b) != 8*n {
		return 0
	}
	let x = limbs_from_be(b, n)
	// x < m exactly when x - m borrows.
	mut bw = u64(0)
	for j in 0..n {
		let xj = x[j]
		let mj = f.m[j]
		bw = lt(xj, mj) | lt(xj - mj, bw)
	}
	if bw == 0 {
		return 0
	}
	f.mul(mut z, x, f.rr)
	return 1
}

// to_bytes is x (in Montgomery form) as f.size() big-endian bytes.
fn (f mut monty) to_bytes(x []u64) []u8 {
	let one = f.elem()
	one[0] = 1
	let y = f.elem()
	f.mul(mut y, x, one)
	return limbs_to_be(y)
}
