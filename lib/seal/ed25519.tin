package seal

import "say"

// ---- Ed25519 signature verification (RFC 8032), on x25519.tin's field ----
// Verification sees only public values, so it is not constant time. Points are extended
// twisted Edwards coordinates (X:Y:Z:T), x = X/Z, y = Y/Z, xy = T/Z, with the unified
// addition formula (Hisil, Wong, Carter and Dawson 2008), which also doubles. As in Go's
// crypto/ed25519 the check is cofactorless: [S]B - [k]A must encode to R exactly, and S must be
// below the group order L.

// edpt is a point in extended coordinates; each coordinate is a field element (fe_new).
type edpt struct {
	x []u64
	y []u64
	z []u64
	t []u64
}

// ed_fe reads a 32-byte little-endian constant.
fn ed_fe(hexle str) []u64 {
	let b = HexDecode(hexle) catch err {
		rt_panic("seal: bad Ed25519 constant: " + say.Str(err))
		[]u8{}
	}
	let f = fe_new()
	fe_frombytes(mut f, b)
	return f
}

// d2 is 2d (d = -121665/121666), sqrtm1 a square root of -1, both little-endian.
let ed_d = ed_fe("a3785913ca4deb75abd841414d0a700098e879777940c78c73fe6f2bee6c0352")
let ed_d2 = ed_fe("59f1b226949bd6eb56b183829a14e00030d1f3eef2808e19e7fcdf56dcd90624")
let ed_sqrtm1 = ed_fe("b0a00e4a271beec478e42fad0618432fa7d7fb3d99004d2b0bdfc14f8024832b")

// The group order L, big-endian.
const edOrder = "1000000000000000000000000000000014def9dea2f79cd65812631a5cf5d3ed"

fn ed_identity() edpt {
	let p = edpt{x: fe_new(), y: fe_new(), z: fe_new(), t: fe_new()}
	p.y[0] = 1
	p.z[0] = 1
	return p
}

// ed_add sets r = p + q (unified: also correct for p == q and the identity); r may alias p or q.
fn ed_add(r mut edpt, p edpt, q edpt) {
	let a = fe_new()
	let b = fe_new()
	let c = fe_new()
	let d = fe_new()
	let t = fe_new()
	fe_sub(mut a, p.y, p.x)
	fe_sub(mut t, q.y, q.x)
	fe_mul(mut a, a, t)
	fe_add(mut b, p.y, p.x)
	fe_add(mut t, q.y, q.x)
	fe_mul(mut b, b, t)
	fe_mul(mut c, p.t, ed_d2)
	fe_mul(mut c, c, q.t)
	fe_mul(mut d, p.z, q.z)
	fe_add(mut d, d, d)
	let e = fe_new()
	let f = fe_new()
	let g = fe_new()
	let h = fe_new()
	fe_sub(mut e, b, a)
	fe_sub(mut f, d, c)
	fe_add(mut g, d, c)
	fe_add(mut h, b, a)
	fe_mul(mut r.x, e, f)
	fe_mul(mut r.y, g, h)
	fe_mul(mut r.t, e, h)
	fe_mul(mut r.z, f, g)
}

fn ed_neg(p edpt) edpt {
	let r = ed_identity()
	let zero = fe_new()
	fe_sub(mut r.x, zero, p.x)
	fe_copy(mut r.y, p.y)
	fe_copy(mut r.z, p.z)
	fe_sub(mut r.t, zero, p.t)
	return r
}

// fe_pow22523 sets out = z^((p-5)/8) = z^(2^252-3).
fn fe_pow22523(out mut []u64, z []u64) {
	let t0 = fe_new()
	let t1 = fe_new()
	let t2 = fe_new()
	fe_sq(mut t0, z)
	fe_sq(mut t1, t0)
	fe_sq(mut t1, t1)
	fe_mul(mut t1, z, t1)
	fe_mul(mut t0, t0, t1)
	fe_sq(mut t0, t0)
	fe_mul(mut t0, t1, t0)
	fe_sq(mut t1, t0)
	for i in 1..5 {
		fe_sq(mut t1, t1)
	}
	fe_mul(mut t0, t1, t0)
	fe_sq(mut t1, t0)
	for i in 1..10 {
		fe_sq(mut t1, t1)
	}
	fe_mul(mut t1, t1, t0)
	fe_sq(mut t2, t1)
	for i in 1..20 {
		fe_sq(mut t2, t2)
	}
	fe_mul(mut t1, t2, t1)
	fe_sq(mut t1, t1)
	for i in 1..10 {
		fe_sq(mut t1, t1)
	}
	fe_mul(mut t0, t1, t0)
	fe_sq(mut t1, t0)
	for i in 1..50 {
		fe_sq(mut t1, t1)
	}
	fe_mul(mut t1, t1, t0)
	fe_sq(mut t2, t1)
	for i in 1..100 {
		fe_sq(mut t2, t2)
	}
	fe_mul(mut t1, t2, t1)
	fe_sq(mut t1, t1)
	for i in 1..50 {
		fe_sq(mut t1, t1)
	}
	fe_mul(mut t0, t1, t0)
	fe_sq(mut t0, t0)
	fe_sq(mut t0, t0)
	fe_mul(mut out, t0, z)
}

fn fe_equal(a []u64, b []u64) bool {
	return nat_bytes_eq(fe_tobytes(a), fe_tobytes(b))
}

// ed_decode decompresses a 32-byte point encoding (RFC 8032 section 5.1.3). As Go's
// edwards25519 does, a y at or above p is read mod p.
fn ed_decode(b []u8) !edpt {
	if len(b) != 32 {
		fail "seal: Ed25519 point must be 32 bytes"
	}
	let sign = i64(b[31] >> 7)
	let p = ed_identity()
	fe_frombytes(mut p.y, b)
	let y2 = fe_new()
	fe_sq(mut y2, p.y)
	let u = fe_new()
	let v = fe_new()
	let one = fe_new()
	one[0] = 1
	fe_sub(mut u, y2, one)
	fe_mul(mut v, y2, ed_d)
	fe_add(mut v, v, one)
	// x = u v^3 (u v^7)^((p-5)/8).
	let v3 = fe_new()
	fe_sq(mut v3, v)
	fe_mul(mut v3, v3, v)
	let x = fe_new()
	fe_sq(mut x, v3)
	fe_mul(mut x, x, v)
	fe_mul(mut x, x, u)
	fe_pow22523(mut x, x)
	fe_mul(mut x, x, v3)
	fe_mul(mut x, x, u)
	let vx2 = fe_new()
	fe_sq(mut vx2, x)
	fe_mul(mut vx2, vx2, v)
	let negu = fe_new()
	let zero = fe_new()
	fe_sub(mut negu, zero, u)
	if !fe_equal(vx2, u) {
		if !fe_equal(vx2, negu) {
			fail "seal: Ed25519 point is not on the curve"
		}
		fe_mul(mut x, x, ed_sqrtm1)
	}
	let xb = fe_tobytes(x)
	if xb[0]&1 != u8(sign) {
		if fe_equal(x, zero) {
			fail "seal: invalid Ed25519 point encoding"
		}
		fe_sub(mut x, zero, x)
	}
	fe_copy(mut p.x, x)
	fe_mul(mut p.t, p.x, p.y)
	return p
}

// ed_encode is p's 32-byte encoding: y with the low bit of x in the top bit.
fn ed_encode(p edpt) []u8 {
	let zi = fe_new()
	fe_invert(mut zi, p.z)
	let x = fe_new()
	let y = fe_new()
	fe_mul(mut x, p.x, zi)
	fe_mul(mut y, p.y, zi)
	let out = fe_tobytes(y)
	out[31] |= (fe_tobytes(x)[0] & 1) << 7
	return out
}

// ed_le_to_be reverses little-endian bytes.
fn ed_le_to_be(b []u8) []u8 {
	let out = make([]u8, len(b))
	for i in 0..len(b) {
		out[i] = b[len(b)-1-i]
	}
	return out
}

// ed_table is the 16 multiples 0..15 of p.
fn ed_table(p edpt) []edpt {
	mut t = make([]edpt, 0, 16)
	t = append(t, ed_identity())
	for i in 1..16 {
		let e = ed_identity()
		ed_add(mut e, t[i-1], p)
		t = append(t, e)
	}
	return t
}

let ed_base_enc = "5866666666666666666666666666666666666666666666666666666666666666"

// VerifyEd25519 checks an Ed25519 signature (64 bytes) of msg by the public key pub (32 bytes).
fn VerifyEd25519(pub []u8, msg []u8, sig []u8) ! {
	if len(pub) != 32 || len(sig) != 64 {
		fail "seal: Ed25519 key or signature has the wrong length"
	}
	let lb = try HexDecode(edOrder)
	let l = try monty_new(lb)
	let s = l.elem()
	if l.from_bytes(mut s, monty_bytes(l, ed_le_to_be(sig[32:]))) == 0 {
		fail "seal: Ed25519 signature verification failed"
	}
	let a = try ed_decode(pub)
	let bb = try HexDecode(ed_base_enc)
	let base = try ed_decode(bb)
	mut hin = make([]u8, 0, 64+len(msg))
	hin = append(hin, sig[:32]...)
	hin = append(hin, pub...)
	hin = append(hin, msg...)
	let k = l.elem()
	monty_reduce(mut l, mut k, ed_le_to_be(Sha512(str(hin))))
	let kb = l.to_bytes(k)
	mut sb = ed_le_to_be(sig[32:])
	sb = monty_bytes(l, sb)
	let tb = ed_table(base)
	let ta = ed_table(ed_neg(a))
	let acc = ed_identity()
	for i in 0..2*len(kb) {
		if i > 0 {
			for j in 0..4 {
				ed_add(mut acc, acc, acc)
			}
		}
		let w1 = ecdsa_nibble(sb, i)
		let w2 = ecdsa_nibble(kb, i)
		if w1 != 0 {
			ed_add(mut acc, acc, tb[w1])
		}
		if w2 != 0 {
			ed_add(mut acc, acc, ta[w2])
		}
	}
	if !nat_bytes_eq(ed_encode(acc), sig[:32]) {
		fail "seal: Ed25519 signature verification failed"
	}
}
