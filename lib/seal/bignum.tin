package seal

// Montgomery constants computed at run time, so field.tin's monty serves any odd modulus (RSA
// moduli and curve primes without precomputed constants). monty_new takes time that depends only
// on the modulus's limb count and bit length, never on its value beyond that.

// monty_new prepares field.tin's Montgomery arithmetic modulo the odd big-endian number mod
// (more than 64 bits; leading zero bytes are ignored).
fn monty_new(mod []u8) !monty {
	mut at = 0
	for at < len(mod) && mod[at] == 0 {
		at += 1
	}
	let b = mod[at:]
	if len(b) < 9 || b[len(b)-1]&1 == 0 {
		fail "seal: modulus must be odd and longer than 64 bits"
	}
	let n = (len(b) + 7) / 8
	let m = limbs_from_be(b, n)
	// Newton's iteration doubles the correct low bits of m[0]^-1 mod 2^64 each step (an odd m[0]
	// is its own inverse mod 8: 3, 6, 12, 24, 48, 96 bits).
	mut x = m[0]
	for i in 0..5 {
		x = x *% (2 -% m[0]*%x)
	}
	let f = new_monty(m, make([]u64, n), make([]u64, n), 0-%x)
	// R mod m: start from 2^(bits-1) < m and double up to 2^(64n), reducing each time.
	mut bits = 64 * n
	for (m[n-1]>>u64(63-(64*n-bits)))&1 == 0 {
		bits -= 1
	}
	let acc = f.elem()
	acc[(bits-1)/64] = u64(1) << u64((bits-1)%64)
	for i in bits - 1..64*n {
		f.add(mut acc, acc, acc)
	}
	f.set(mut f.one, acc)
	// R^2 mod m is 2^(64n) in Montgomery form: raise 2R mod m (2 in Montgomery form) to 64n.
	f.add(mut acc, acc, acc)
	let e = 64 * n
	mut eb = []u8{}
	{
		mut k = 24
		for k >= 0 {
			if len(eb) > 0 || (e>>u64(k))&0xff != 0 {
				eb = append(eb, u8(e>>u64(k)))
			}
			k -= 8
		}
	}
	f.exp(mut f.rr, acc, eb)
	return f
}

// monty_bytes pads big-endian b with leading zeros to the f.size() bytes from_bytes takes; b
// must fit.
fn monty_bytes(f monty, b secret []u8) []u8 {
	let size = f.size()
	if len(b) == size {
		return b
	}
	let out = make([]u8, size)
	{
		mut i = 0
		for i < len(b) && i < size {
			out[size-1-i] = b[len(b)-1-i]
			i += 1
		}
	}
	return out
}

// ---- constant-time helpers for private keys (RSA CRT, ECDSA signing) ----

// monty_exp_ct sets z = x^e in Montgomery form with 4-bit fixed windows: every window squares
// four times, reads all 16 table entries and multiplies once, so the time depends only on
// len(e) and f.n, not on e or x. z may alias x.
@wrap fn monty_exp_ct(f mut monty, z mut []u64, x []u64, e secret []u8) {
	let n = f.n
	let table = make([]u64, 16*n)
	let prev = f.elem()
	f.set(mut prev, f.one)
	for j in 0..n {
		table[j] = prev[j]
	}
	for k in 1..16 {
		f.mul(mut prev, prev, x)
		for j in 0..n {
			table[k*n+j] = prev[j]
		}
	}
	let acc = f.elem()
	f.set(mut acc, f.one)
	let sel = f.elem()
	for i in 0..len(e)*2 {
		for s in 0..4 {
			f.sqr(mut acc, acc)
		}
		let w = u64(e[i/2]>>u8(4-4*(i%2))) & 15
		for j in 0..n {
			sel[j] = 0
		}
		for k in 0..16 {
			let d = u64(k) ^ w
			let mask = ((d | (0 -% d)) >> 63) -% 1
			for j in 0..n {
				sel[j] |= table[k*n+j] & mask
			}
		}
		f.mul(mut acc, acc, sel)
	}
	f.set(mut z, acc)
}

// monty_reduce sets z to the big-endian number b (any length) mod m, in Montgomery form, in
// time that depends only on len(b) and f.n: Horner's rule over 64-bit limbs, multiplying by
// 2^64 with one Montgomery multiplication per limb, and adding each limb (below 2^64 < m).
@wrap fn monty_reduce(f mut monty, z mut []u64, b secret []u8) {
	let shift = f.elem()
	let two64 = []u8{1, 0, 0, 0, 0, 0, 0, 0, 0}
	f.from_bytes(mut shift, monty_bytes(f, two64))
	let acc = f.elem()
	let limb = f.elem()
	let pad = (8 - len(b)%8) % 8
	for i in (0..len(b)+pad).step(8) {
		f.mul(mut acc, acc, shift)
		mut v = u64(0)
		for k in 0..8 {
			let at = i + k - pad
			mut c = u64(0)
			if at >= 0 {
				c = u64(b[at])
			}
			v = v<<8 | c
		}
		limb[0] = v
		f.add(mut acc, acc, limb)
	}
	f.mul(mut z, acc, f.rr)
}

// nat_mul_ct is the full product of little-endian 64-bit limb numbers a and b, with fixed loops.
@wrap fn nat_mul_ct(a []u64, b []u64) []u64 {
	let out = make([]u64, len(a)+len(b))
	for i in 0..len(a) {
		let ai = a[i]
		mut c = u64(0)
		for j in 0..len(b) {
			let bj = b[j]
			let o = out[i+j]
			mut lo = ai * bj
			mut hi = mulhi(ai, bj)
			lo += o
			hi += lt(lo, o)
			lo += c
			hi += lt(lo, c)
			out[i+j] = lo
			c = hi
		}
		out[i+len(b)] = c
	}
	return out
}

// nat_add_ct adds b into a (len(b) <= len(a)) with fixed loops; the carry out of a is dropped.
@wrap fn nat_add_ct(a mut []u64, b []u64) {
	mut c = u64(0)
	for j in 0..len(a) {
		mut bj = u64(0)
		if j < len(b) {
			bj = b[j]
		}
		let x = a[j]
		let s = x + bj
		let s2 = s + c
		c = lt(s, x) | lt(s2, s)
		a[j] = s2
	}
}

// monty_plain is x (Montgomery form) out of Montgomery form, as f.n limbs.
@wrap fn monty_plain(f mut monty, x []u64) []u64 {
	let one = f.elem()
	one[0] = 1
	let y = f.elem()
	f.mul(mut y, x, one)
	return y
}
