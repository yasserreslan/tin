// seal on Linux: the arm64 SHA-256 instructions are optional (Cortex-A72 lacks them).
package seal

// hw_sha256 is true on an x86-64 CPU with the SHA extensions (CPUID), and on arm64 tests HWCAP_SHA2
// (bit 6 of AT_HWCAP, 16).
fn hw_sha256() bool {
	if TARGET_X64 {
		return sha_hw_cpu() == 1
	}
	return rt_getauxval(16)&64 != 0
}

// aes_hw reports whether AES-GCM may use the CPU's instructions: on x86-64 AES-NI and
// PCLMULQDQ (CPUID); on arm64 HWCAP_AES and HWCAP_PMULL (bits 3 and 4 of AT_HWCAP).
fn aes_hw() bool {
	if TARGET_X64 {
		return aes_hw_cpu() == 1
	}
	return rt_getauxval(16)&24 == 24
}
