package seal

import "say"

// ---- ECDSA signing on P-256 and P-384 with RFC 6979 deterministic nonces ----
// Constant time in the private key and the nonce: the nonce comes from HMAC (constant time in
// its key), k*G uses fixed 4-bit windows with full-table reads (p256_mul, ec_mul_ct), and k^-1
// is k^(n-2) with the public exponent n-2 (monty.exp branches only on the exponent).

// ec_mul_ct sets r = k*p for a big-endian scalar k of c.size bytes, in time that does not depend
// on k or p (as p256_mul does for P-256).
@wrap fn ec_mul_ct(c mut ecCurve, p ecpt, k secret []u8) ecpt {
	mut table = make([]ecpt, 0, 16)
	table = append(table, ec_identity(c))
	for i in 1..16 {
		let e = ec_identity(c)
		ec_add(mut c, mut e, table[i-1], p)
		table = append(table, e)
	}
	let acc = ec_identity(c)
	let sel = ec_identity(c)
	for i in 0..2*len(k) {
		if i > 0 {
			for s in 0..4 {
				ec_double(mut c, mut acc, acc)
			}
		}
		mut w = u64(k[i/2])
		if i%2 == 0 {
			w = w >> 4
		}
		w = w & 15
		for j in 0..16 {
			let d = u64(j) ^ w
			let bit = 1 ^ ((d | (u64(0) -% d)) >> 63)
			let e = table[j]
			c.f.sel(mut sel.x, e.x, sel.x, bit)
			c.f.sel(mut sel.y, e.y, sel.y, bit)
			c.f.sel(mut sel.z, e.z, sel.z, bit)
		}
		ec_add(mut c, mut acc, acc, sel)
	}
	return acc
}

// ec_encode is p's uncompressed encoding (0x04 x y), or fails for the identity.
fn ec_encode(c mut ecCurve, p ecpt) ![]u8 {
	let zi = c.f.elem()
	c.f.inv(mut zi, p.z)
	let x = c.f.elem()
	let y = c.f.elem()
	c.f.mul(mut x, p.x, zi)
	c.f.mul(mut y, p.y, zi)
	if c.f.is_zero(p.z) == 1 {
		fail "seal: " + c.name + " point at infinity"
	}
	let xb = c.f.to_bytes(x)
	let yb = c.f.to_bytes(y)
	mut out = make([]u8, 0, 1+2*c.size)
	out = append(out, 4)
	out = append(out, xb[len(xb)-c.size:]...)
	out = append(out, yb[len(yb)-c.size:]...)
	return out
}

// ec_scalar_ok is 1 when d is size bytes in [1, n-1].
fn ec_scalar_ok(n mut monty, size i64, d secret []u8) u64 {
	if len(d) != size {
		return 0
	}
	let s = n.elem()
	if n.from_bytes(mut s, monty_bytes(n, d)) == 0 {
		return 0
	}
	return 1 ^ n.is_zero(s)
}

// ec_public is the uncompressed public point d*G of a private scalar on curve.
fn ec_public(curve str, d secret []u8) ![]u8 {
	if curve == "P-256" {
		return try P256PublicKey(d)
	}
	let c = try p384_curve()
	if ec_scalar_ok(mut c.n, c.size, d) == 0 {
		fail "seal: invalid P-384 private key"
	}
	let r = ec_mul_ct(mut c, ec_generator(c), d)
	return try ec_encode(mut c, r)
}

// rfc6979_nonce is RFC 6979's deterministic k for private scalar x and digest over the order n
// (size bytes; the order's bit length is 8*size for P-256 and P-384), with HMAC over h.
fn rfc6979_nonce(n mut monty, size i64, h Hash, x secret []u8, digest []u8) []u8 {
	mut e = digest
	if len(e) > size {
		e = e[:size]
	}
	mut h1 = limbs_to_be(ecdsa_reduce(n, monty_bytes(n, e)))
	h1 = h1[len(h1)-size:]
	let hlen = Size(h)
	mut v = make([]u8, hlen)
	mut kk = make([]u8, hlen)
	for i in 0..hlen {
		v[i] = 1
	}
	for round in 0..2 {
		mut m = make([]u8, 0, hlen+1+2*size)
		m = append(m, v...)
		m = append(m, u8(round))
		m = append(m, x...)
		m = append(m, h1...)
		kk = Hmac(h, str(kk), str(m))
		v = Hmac(h, str(kk), str(v))
	}
	for {
		mut t = make([]u8, 0, size+hlen)
		for len(t) < size {
			v = Hmac(h, str(kk), str(v))
			t = append(t, v...)
		}
		let cand = t[:size]
		if ec_scalar_ok(mut n, size, cand) == 1 {
			return cand
		}
		mut m = make([]u8, 0, hlen+1)
		m = append(m, v...)
		m = append(m, 0)
		kk = Hmac(h, str(kk), str(m))
		v = Hmac(h, str(kk), str(v))
	}
	return []u8{}
}

// der_int appends a DER INTEGER holding the non-negative big-endian value b.
fn der_int(out []u8, b []u8) []u8 {
	mut at = 0
	for at < len(b)-1 && b[at] == 0 {
		at += 1
	}
	let v = b[at:]
	mut pad = 0
	if v[0]&0x80 != 0 {
		pad = 1
	}
	out = append(out, derInteger, u8(len(v)+pad))
	if pad == 1 {
		out = append(out, 0)
	}
	return append(out, v...)
}

// SignECDSA signs digest (a hash of the message, made with h) with k and returns a DER
// ECDSA-Sig-Value. The nonce is RFC 6979's, derived with HMAC over h, so equal inputs give equal
// signatures.
fn SignECDSA(k ECPrivateKey, h Hash, digest []u8) ![]u8 {
	mut size = 32
	mut n = p256n
	if k.Curve == "P-384" {
		let c = try p384_curve()
		n = c.n
		size = 48
	} else if k.Curve != "P-256" {
		fail "seal: ECDSA signing on " + k.Curve + " is not supported"
	}
	let nonce = rfc6979_nonce(mut n, size, h, k.d, digest)
	mut xr = []u8{}
	if size == 32 {
		let r = p256_identity()
		p256_mul_base(mut r, nonce)
		let (x, _, ok) = p256_affine(r)
		if ok == 0 {
			fail "seal: ECDSA nonce gave the point at infinity"
		}
		xr = x
	} else {
		let c = try p384_curve()
		let r = ec_mul_ct(mut c, ec_generator(c), nonce)
		let (x, ok) = ec_affine_x(mut c, r)
		if ok == 0 {
			fail "seal: ECDSA nonce gave the point at infinity"
		}
		xr = x
	}
	let rl = ecdsa_reduce(n, monty_bytes(n, xr))
	let rm = n.elem()
	n.mul(mut rm, rl, n.rr)
	if n.is_zero(rm) == 1 {
		fail "seal: ECDSA r is zero"
	}
	mut e = digest
	if len(e) > size {
		e = e[:size]
	}
	let em = n.elem()
	n.mul(mut em, ecdsa_reduce(n, monty_bytes(n, e)), n.rr)
	let km = n.elem()
	let dm = n.elem()
	n.from_bytes(mut km, monty_bytes(n, nonce))
	n.from_bytes(mut dm, monty_bytes(n, k.d))
	let s = n.elem()
	n.mul(mut s, rm, dm)
	n.add(mut s, s, em)
	n.inv(mut km, km)
	n.mul(mut s, s, km)
	if n.is_zero(s) == 1 {
		fail "seal: ECDSA s is zero"
	}
	let rb = n.to_bytes(rm)
	let sb = n.to_bytes(s)
	mut body = der_int([]u8{}, rb)
	body = der_int(body, sb)
	let out = []u8{derSequence, u8(len(body))}
	return append(out, body...)
}

// SignTLS signs msg (the bytes a TLS 1.3 CertificateVerify covers) with k under scheme: RSA-PSS
// 0x0804-0x0806 for RSA keys, 0x0403 for P-256 and 0x0503 for P-384.
fn (k PrivateKey) SignTLS(scheme i64, msg []u8) ![]u8 {
	mut h = Hash.SHA256
	if scheme == 0x0805 || scheme == 0x0503 {
		h = Hash.SHA384
	} else if scheme == 0x0806 {
		h = Hash.SHA512
	}
	let r = k.RSA
	if r != nil && scheme >= 0x0804 && scheme <= 0x0806 {
		return try SignPSS(mut r, h, Sum(h, str(msg)))
	}
	let e = k.EC
	if e != nil && ((scheme == 0x0403 && e.Curve == "P-256") || (scheme == 0x0503 && e.Curve == "P-384")) {
		return try SignECDSA(e, h, Sum(h, str(msg)))
	}
	let ed = k.Ed
	if ed != nil && scheme == 0x0807 {
		return try SignEd25519(ed.seed, msg)
	}
	fail say.Fault("seal: the key cannot sign with TLS signature scheme 0x%04x", scheme)
}
