package seal

// ---- authenticated encryption with associated data ----

// AEAD is an authenticated cipher with its key (AES-GCM or ChaCha20-Poly1305): Seal encrypts
// and appends a 16-byte tag, Open checks the tag in constant time and decrypts.
type AEAD struct {
	kind i64
	key  []u8  // ChaCha20-Poly1305: the key
	rk   []u64 // AES in software: the bitsliced round keys
	rkb  []u8  // AES on the CPU's instructions: the round keys as bytes
	nr   i64   // AES: the number of rounds
	hw   bool  // AES-GCM runs on the CPU's instructions
	hb   []u8  // GCM on the CPU's instructions: H in GCM's byte order
	h0   u64   // GCM: H with its bits reversed, low half
	h1   u64   // GCM: high half
	tmp  []u8  // GCM on the CPU's instructions: SealTo's counter, tag and partial blocks
}

const aeadChaCha = 1
const aeadAESGCM = 2

// NewChaCha20Poly1305 is the RFC 8439 AEAD with a 32-byte key.
fn NewChaCha20Poly1305(key secret []u8) !AEAD {
	if len(key) != 32 {
		fail "seal: ChaCha20-Poly1305 needs a 32-byte key"
	}
	let k = make([]u8, 32)
	copy(k, key)
	return AEAD{kind: aeadChaCha, key: k}
}

// NonceSize is the nonce length in bytes (12).
fn (a AEAD) NonceSize() i64 {
	return 12
}

// Overhead is the tag length in bytes (16).
fn (a AEAD) Overhead() i64 {
	return 16
}

// Seal encrypts plaintext and authenticates it with aad under a 12-byte nonce, returning the
// ciphertext followed by the tag. A nonce must never be used twice with one key.
fn (a AEAD) Seal(nonce []u8, plaintext secret []u8, aad []u8) ![]u8 {
	if len(nonce) != 12 {
		fail "seal: AEAD nonce must be 12 bytes"
	}
	if a.kind == aeadAESGCM {
		return gcm_seal(a, nonce, plaintext, aad)
	}
	return chacha_seal(a.key, nonce, plaintext, aad)
}

// SealTo is Seal into raw memory: it encrypts the n bytes at src into dst and writes the 16-byte
// tag after them (dst may be src, to seal in place). Nothing it allocates grows with n, so a
// connection that streams can seal into a buffer of its own instead of its request's pool;
// AES-GCM on the CPU's instructions allocates nothing at all.
fn (a AEAD) SealTo(nonce []u8, src i64, n i64, aad []u8, dst i64) ! {
	if len(nonce) != 12 {
		fail "seal: AEAD nonce must be 12 bytes"
	}
	if a.kind == aeadAESGCM {
		if a.hw && len(a.tmp) >= 80 {
			gcm_seal_hw_to(a, nonce, src, n, aad, dst)
			return
		}
		if n > 0 {
			gcm_ctr(a, dst, src, n, mut gcm_counter(nonce))
		}
		let tag = gcm_tag(a, nonce, aad, dst, n)
		memcpy(dst+n, cast(i64, tag)[2], 16)
		return
	}
	if n > 0 {
		chacha20_xor(dst, src, n, cast(i64, a.key)[2], cast(i64, nonce)[2], 1)
	}
	let pk = chacha_poly_key(a.key, nonce)
	let tag = poly1305_aead(cast(i64, pk)[2], aad, dst, n)
	memcpy(dst+n, cast(i64, tag)[2], 16)
}

// Open checks the tag of sealed (ciphertext then tag) against aad and the nonce and returns the
// plaintext; it fails, revealing nothing else, when anything was changed.
fn (a AEAD) Open(nonce []u8, sealed []u8, aad []u8) ![]u8 {
	if len(nonce) != 12 {
		fail "seal: AEAD nonce must be 12 bytes"
	}
	if a.kind == aeadAESGCM {
		return try gcm_open(a, nonce, sealed, aad)
	}
	return try chacha_open(a.key, nonce, sealed, aad)
}

// Rekey replaces a's key with key, of the same algorithm and length, reusing a's memory: an
// AEAD kept in long-lived memory (a connection's state) can change keys without allocating
// there.
fn (a mut AEAD) Rekey(key secret []u8) ! {
	if a.kind == aeadChaCha {
		if len(key) != 32 {
			fail "seal: Rekey needs a key of the same length"
		}
		copy(a.key, key)
		return
	}
	if len(key) != 4*(a.nr-6) {
		fail "seal: Rekey needs a key of the same length"
	}
	let b = try NewAESGCM(key)
	if a.hw {
		copy(a.rkb, b.rkb)
		copy(a.hb, b.hb)
		return
	}
	copy(a.rk, b.rk)
	a.h0 = b.h0
	a.h1 = b.h1
}
