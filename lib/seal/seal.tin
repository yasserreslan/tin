// Package seal has cryptographic hashes (SHA-256, SHA-384, SHA-512, SHA-1, SHA3-256, SHA3-512, and
// SHAKE128 and SHAKE256), HMAC over any of the SHA-2 hashes, HKDF, PBKDF2-HMAC-SHA-256, P-256
// ECDH, ML-KEM-768 (FIPS 203), RSA signature verification (PKCS #1 v1.5 and PSS), X.509
// certificates with chain and host name verification, constant-time comparison, secure random
// bytes, the hex, base64 and PEM encodings, and RSA-OAEP encryption with a public key.
package seal

import "say"


let k256 []u32 = []u32{
	0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
	0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
	0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
	0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
	0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
	0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
	0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
	0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
}

fn rotr(x u32, n u32) u32 {
	return (x >> n) | (x << (32 - n))
}

fn rotl(x u32, n u32) u32 {
	return (x << n) | (x >> (32 - n))
}

fn be32(p i64) u32 {
	return u32(load8(p))<<24 | u32(load8(p+1))<<16 | u32(load8(p+2))<<8 | u32(load8(p+3))
}

// pad returns the message's tail blocks: the last partial block, 0x80, zeros, bit length.
fn pad(s str, full i64) []u8 {
	let n = len(s)
	let rest = n - full
	mut total = 64
	if rest >= 56 {
		total = 128
	}
	let b = make([]u8, total)
	for i in 0..rest {
		b[i] = s[full+i]
	}
	b[rest] = 0x80
	let bitlen = u64(n) * 8
	for i in 0..8 {
		b[total-1-i] = u8(bitlen >> u64(8*i))
	}
	return b
}

// sha256_blocks computes modulo 2^32, as SHA-256 is defined (#362).
@wrap fn sha256_blocks(h mut []u32, w mut []u32, p i64, nblocks i64) {
	for blk in 0..nblocks {
		let q = p + blk*64
		for i in 0..16 {
			w[i] = be32(q + 4*i)
		}
		for i in 16..64 {
			let a = w[i-15]
			let b = w[i-2]
			let s0 = rotr(a, 7) ^ rotr(a, 18) ^ (a >> 3)
			let s1 = rotr(b, 17) ^ rotr(b, 19) ^ (b >> 10)
			w[i] = w[i-16] + s0 + w[i-7] + s1
		}
		mut a = h[0]
		mut b = h[1]
		mut c = h[2]
		mut d = h[3]
		mut e = h[4]
		mut f = h[5]
		mut g = h[6]
		mut hh = h[7]
		for i in 0..64 {
			let s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
			let ch = (e & f) ^ (^e & g)
			let t1 = hh + s1 + ch + k256[i] + w[i]
			let s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
			let maj = (a & b) ^ (a & c) ^ (b & c)
			let t2 = s0 + maj
			hh = g
			g = f
			f = e
			e = d + t1
			d = c
			c = b
			b = a
			a = t1 + t2
		}
		h[0] += a
		h[1] += b
		h[2] += c
		h[3] += d
		h[4] += e
		h[5] += f
		h[6] += g
		h[7] += hh
	}
}

fn digest(h []u32) []u8 {
	mut out = make([]u8, 0, 4*len(h))
	for _, x in h {
		out = append(out, u8(x>>24), u8(x>>16), u8(x>>8), u8(x))
	}
	return out
}

// hw_blocks compresses n >= 1 blocks at data into state with the CPU's SHA-256
// instructions; the compiler replaces this body with hand-assembled code.
fn hw_blocks(state i64, data i64, n i64, k i64) {
	rt_panic("seal: hardware SHA-256 is not available for this target")
}

// Sha256 is the SHA-256 digest of s (32 bytes); s may be secret.
fn Sha256(s secret str) []u8 {
	// The hardware path exists only on arm64 CPUs with the SHA-256 instructions (seal_<os>.tin).
	if !hw_sha256() {
		return Sha256Soft(s)
	}
	let h = []u32{0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19}
	let hp = cast(i64, h)[2]
	let kp = cast(i64, k256)[2]
	let full = len(s) / 64 * 64
	if full > 0 {
		hw_blocks(hp, cast(i64, s)+8, full/64, kp)
	}
	let tail = pad(s, full)
	hw_blocks(hp, cast(i64, tail)[2], len(tail)/64, kp)
	return digest(h)
}

// Sha256Soft is SHA-256 in portable code (the reference the hardware path is tested against).
fn Sha256Soft(s str) []u8 {
	let h = []u32{0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19}
	let w = make([]u32, 64)
	let full = len(s) / 64 * 64
	sha256_blocks(mut h, mut w, cast(i64, s)+8, full/64)
	let tail = pad(s, full)
	sha256_blocks(mut h, mut w, cast(i64, tail)[2], len(tail)/64)
	return digest(h)
}

// Sha256Hex is the SHA-256 digest of s in lower-case hex; s may be secret.
fn Sha256Hex(s secret str) str {
	return Hex(Sha256(s))
}

// Sha1 is the SHA-1 digest of s (20 bytes); use it only where a protocol requires it.
fn Sha1(s str) []u8 {
	let h = []u32{0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476, 0xc3d2e1f0}
	let w = make([]u32, 80)
	let full = len(s) / 64 * 64
	sha1_blocks(mut h, mut w, cast(i64, s)+8, full/64)
	let tail = pad(s, full)
	sha1_blocks(mut h, mut w, cast(i64, tail)[2], len(tail)/64)
	return digest(h)
}

// sha1_blocks computes modulo 2^32, as SHA-1 is defined (#362).
@wrap fn sha1_blocks(h mut []u32, w mut []u32, p i64, nblocks i64) {
	for blk in 0..nblocks {
		let q = p + blk*64
		for i in 0..16 {
			w[i] = be32(q + 4*i)
		}
		for i in 16..80 {
			w[i] = rotl(w[i-3]^w[i-8]^w[i-14]^w[i-16], 1)
		}
		mut a = h[0]
		mut b = h[1]
		mut c = h[2]
		mut d = h[3]
		mut e = h[4]
		for i in 0..80 {
			mut f = u32(0)
			mut k = u32(0)
			if i < 20 {
				f = (b & c) | (^b & d)
				k = 0x5a827999
			} else if i < 40 {
				f = b ^ c ^ d
				k = 0x6ed9eba1
			} else if i < 60 {
				f = (b & c) | (b & d) | (c & d)
				k = 0x8f1bbcdc
			} else {
				f = b ^ c ^ d
				k = 0xca62c1d6
			}
			let t = rotl(a, 5) + f + e + k + w[i]
			e = d
			d = c
			c = rotl(b, 30)
			b = a
			a = t
		}
		h[0] += a
		h[1] += b
		h[2] += c
		h[3] += d
		h[4] += e
	}
}

// HmacSha256 is the HMAC-SHA256 of msg under key (32 bytes); key may be secret.
fn HmacSha256(key secret str, msg str) []u8 {
	mut k = []u8(key)
	if len(k) > 64 {
		k = Sha256(key)
	}
	mut ipad = make([]u8, 64, 64+len(msg))
	mut opad = make([]u8, 64, 96)
	for i in 0..64 {
		mut x = u8(0)
		if i < len(k) {
			x = k[i]
		}
		ipad[i] = x ^ 0x36
		opad[i] = x ^ 0x5c
	}
	ipad = append(ipad, msg...)
	let inner = Sha256(str(ipad))
	opad = append(opad, inner...)
	return Sha256(str(opad))
}

// Pbkdf2Sha256 derives length bytes using PBKDF2-HMAC-SHA-256. Iterations must be
// positive; length must be between 0 and 1 MiB. Temporary storage is reused between
// rounds, so memory usage does not grow with iterations. Choose the work factor for
// your protocol or password policy (this function does not choose one). The password may
// be secret.
fn Pbkdf2Sha256(password secret str, salt str, iterations i64, length i64) ![]u8 {
	return try Pbkdf2Sha256Timeout(password, salt, iterations, length, 0)
}

// Pbkdf2Sha256Timeout derives bytes like Pbkdf2Sha256, with a timeout in nanoseconds
// (<= 0: no limit). Both forms honor request deadlines and let other tasks run between
// batches of rounds. Scratch storage is released before any timeout fault returns.
fn Pbkdf2Sha256Timeout(password secret str, salt str, iterations i64, length i64, timeout i64) ![]u8 {
	mut until = 0
	if timeout > 0 { until = rt_mono_ns()+timeout }
	if iterations <= 0 || length < 0 || length > 1048576 {
		fail "seal: invalid PBKDF2 iterations or length"
	}
	mut key = password
	if len(key) > 64 {
		key = str(Sha256(key))
	}
	let out = make([]u8, length)
	let u = make([]u8, 32)
	let t = make([]u8, 32)
	let first = make([]u8, len(salt)+4)
	for i in 0..len(salt) {
		first[i] = salt[i]
	}
	let scope = rt_pool_enter()
	{
		mut block = 0
		for block*32 < length {
			mut status = pbkdf_budget(until)
			if status != 0 {
				rt_pool_leave(scope)
				if status == waitDeadline { fail cast(fault, rt_wait_fault()) }
				fail "seal: PBKDF2 timed out"
			}
			for i in 0..4 {
				first[len(salt)+i] = u8((block+1) >> (24-8*i))
			}
			mut v = HmacSha256(key, str(first))
			for i in 0..32 {
				u[i] = v[i]
				t[i] = v[i]
			}
			rt_pool_scope_reset(scope)
			for round in 1..iterations {
				v = HmacSha256(key, str(u))
				for i in 0..32 {
					u[i] = v[i]
					t[i] ^= v[i]
				}
				rt_pool_scope_reset(scope)
				if round%128 == 0 {
					status = pbkdf_budget(until)
					if status != 0 {
						rt_pool_leave(scope)
						if status == waitDeadline { fail cast(fault, rt_wait_fault()) }
						fail "seal: PBKDF2 timed out"
					}
				}
			}
			{
			mut i = 0
			for i < 32 && block*32+i < length {
					out[block*32+i] = t[i]
					i += 1
			}
		}
			block += 1
		}
	}
	rt_pool_leave(scope)
	return out
}

fn pbkdf_budget(until i64) i64 {
	rt_task_defer()
	let now = rt_mono_ns()
	let t = rt_task_current()
	if t != 0 && ((t[tDeadline] > 0 && now >= t[tDeadline]) || rt_bnd_stopped()) { return waitDeadline }
	if until > 0 && now >= until { return waitTimeout }
	return waitReady
}

// ConstantTimeEq compares a and b in time that depends only on their lengths; they may be
// secret.
fn ConstantTimeEq(a secret []u8, b secret []u8) bool {
	if len(a) != len(b) {
		return false
	}
	mut v = u8(0)
	for i in 0..len(a) {
		v |= a[i] ^ b[i]
	}
	return v == 0
}

// Equal reports whether a and b hold the same bytes, in time that depends only on their
// lengths. It is how secrets are compared: == on a secret is a compile error.
fn Equal(a secret str, b secret str) bool {
	if len(a) != len(b) {
		return false
	}
	mut v = u8(0)
	for i in 0..len(a) {
		v |= a[i] ^ b[i]
	}
	return v == 0
}

// RandomBytes returns n cryptographically secure random bytes.
fn RandomBytes(n i64) []u8 {
	let b = make([]u8, n)
	if n > 0 {
		rt_random(cast(i64, b)[2], n)
	}
	let tp = rt_tape()
	if tp != 0 {
		return []u8(rt_effect_bytes(tp, "seal.random@1", rt_i64str(n), str(b))) // recorded for replay (#241)
	}
	return b
}

const hexDigits = "0123456789abcdef"

// Hex encodes b in lower-case hexadecimal.
fn Hex(b []u8) str {
	mut out = make([]u8, 0, 2*len(b))
	for _, c in b {
		out = append(out, hexDigits[i64(c>>4)], hexDigits[i64(c&15)])
	}
	return str(out)
}

fn unhex(c u8) i64 {
	if c >= '0' && c <= '9' {
		return i64(c - '0')
	}
	if c >= 'a' && c <= 'f' {
		return i64(c-'a') + 10
	}
	if c >= 'A' && c <= 'F' {
		return i64(c-'A') + 10
	}
	return -1
}

// HexDecode decodes hexadecimal text.
fn HexDecode(s str) ![]u8 {
	if len(s)%2 != 0 {
		fail "seal: odd length hex string"
	}
	mut out = make([]u8, 0, len(s)/2)
	for i in (0..len(s)).step(2) {
		let a = unhex(s[i])
		let b = unhex(s[i+1])
		if a < 0 || b < 0 {
			fail say.Fault("seal: invalid hex byte at offset %d", i)
		}
		out = append(out, u8(a*16+b))
	}
	return out
}

const b64std = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
const b64url = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

fn b64enc(b []u8, alphabet str, padded bool) str {
	mut out = make([]u8, 0, (len(b)+2)/3*4)
	mut i = 0
	for i+3 <= len(b) {
		let v = i64(b[i])<<16 | i64(b[i+1])<<8 | i64(b[i+2])
		out = append(out, alphabet[v>>18], alphabet[(v>>12)&63], alphabet[(v>>6)&63], alphabet[v&63])
		i += 3
	}
	let rest = len(b) - i
	if rest == 1 {
		let v = i64(b[i]) << 16
		out = append(out, alphabet[v>>18], alphabet[(v>>12)&63])
		if padded {
			out = append(out, '=', '=')
		}
	} else if rest == 2 {
		let v = i64(b[i])<<16 | i64(b[i+1])<<8
		out = append(out, alphabet[v>>18], alphabet[(v>>12)&63], alphabet[(v>>6)&63])
		if padded {
			out = append(out, '=')
		}
	}
	return str(out)
}

fn b64val(c u8, url bool) i64 {
	if c >= 'A' && c <= 'Z' {
		return i64(c - 'A')
	}
	if c >= 'a' && c <= 'z' {
		return i64(c-'a') + 26
	}
	if c >= '0' && c <= '9' {
		return i64(c-'0') + 52
	}
	if (c == '+' && !url) || (c == '-' && url) {
		return 62
	}
	if (c == '/' && !url) || (c == '_' && url) {
		return 63
	}
	return -1
}

fn b64dec(s str, url bool, padded bool) ![]u8 {
	mut n = len(s)
	if padded {
		if n%4 != 0 {
			fail "seal: base64 length is not a multiple of 4"
		}
		for n > 0 && s[n-1] == '=' && len(s)-n < 2 {
			n -= 1
		}
	} else if n%4 == 1 {
		fail "seal: illegal base64 length"
	}
	mut out = make([]u8, 0, n*3/4)
	mut acc = 0
	mut bitsn = 0
	for i in 0..n {
		let v = b64val(s[i], url)
		if v < 0 {
			fail say.Fault("seal: illegal base64 data at input byte %d", i)
		}
		acc = acc<<6 | v
		bitsn += 6
		if bitsn >= 8 {
			bitsn -= 8
			out = append(out, u8(acc>>bitsn))
		}
	}
	// Unused low bits must be zero, as Go's strict decoding requires.
	if acc&((1<<bitsn)-1) != 0 {
		fail "seal: base64 has non-zero trailing bits"
	}
	return out
}

// B64 encodes b as standard padded base64.
fn B64(b []u8) str {
	return b64enc(b, b64std, true)
}

// B64Decode decodes standard padded base64.
fn B64Decode(s str) ![]u8 {
	return try b64dec(s, false, true)
}

// B64URL encodes b as unpadded URL-safe base64 (as in JWTs).
fn B64URL(b []u8) str {
	return b64enc(b, b64url, false)
}

// B64URLDecode decodes unpadded URL-safe base64.
fn B64URLDecode(s str) ![]u8 {
	return try b64dec(s, true, false)
}

// ---- RSA public-key encryption (RSA-OAEP), for protocols that need it ----

// RSAPublicKey is an RSA public key: modulus N and exponent E, as big-endian bytes.
type RSAPublicKey struct {
	N []u8
	E []u8
}

// der_item reads the DER item at b[at]: its tag, where its contents start and end.
fn der_item(b []u8, at i64) !(u8, i64, i64) {
	if at+2 > len(b) {
		fail "seal: truncated DER"
	}
	let tag = b[at]
	mut n = i64(b[at+1])
	at += 2
	if n >= 0x80 {
		let k = n - 0x80
		if k < 1 || k > 4 || at+k > len(b) {
			fail "seal: bad DER length"
		}
		n = 0
		for i in 0..k {
			n = n<<8 | i64(b[at+i])
		}
		at += k
	}
	if at+n > len(b) {
		fail "seal: truncated DER"
	}
	return tag, at, at + n
}

fn der_uint(b []u8, at i64) !([]u8, i64) {
	mut (tag, from, to) = try der_item(b, at)
	if tag != 0x02 {
		fail "seal: expected a DER integer"
	}
	for from < to-1 && b[from] == 0 {
		from += 1
	}
	return b[from:to], to
}

// ParseRSAPublicKeyPEM reads a PEM "PUBLIC KEY" (SubjectPublicKeyInfo) or "RSA PUBLIC KEY"
// (PKCS #1) block.
fn ParseRSAPublicKeyPEM(pem str) !RSAPublicKey {
	mut body = []u8{}
	mut pkcs1 = false
	mut inside = false
	mut start = 0
	{
		mut i = 0
		for i <= len(pem) {
			if i < len(pem) && pem[i] != '\n' {
				i += 1
				continue
			}
			mut ln = pem[start:i]
			start = i + 1
			if len(ln) > 0 && ln[len(ln)-1] == '\r' {
				ln = ln[:len(ln)-1]
			}
			if len(ln) >= 5 && ln[:5] == "-----" {
				if !inside {
					inside = true
					pkcs1 = len(ln) > 25 && ln[11:25] == "RSA PUBLIC KEY"
				} else {
					break
				}
				i += 1
				continue
			}
			if inside {
				for j in 0..len(ln) {
					body = append(body, ln[j])
				}
			}
			i += 1
		}
	}
	let der = try B64Decode(str(body))
	mut at = 0
	if !pkcs1 {
		mut (tag, from, _) = try der_item(der, 0)
		if tag != 0x30 {
			fail "seal: not a public key"
		}
		mut (tag2, _, algEnd) = try der_item(der, from)
		if tag2 != 0x30 {
			fail "seal: not a public key"
		}
		let (tag3, bitFrom, _) = try der_item(der, algEnd)
		if tag3 != 0x03 || bitFrom >= len(der) || der[bitFrom] != 0 {
			fail "seal: not a public key"
		}
		at = bitFrom + 1
	}
	mut (tag, from, _) = try der_item(der, at)
	if tag != 0x30 {
		fail "seal: not an RSA public key"
	}
	let (n, next) = try der_uint(der, from)
	let (e, _) = try der_uint(der, next)
	return RSAPublicKey{N: n, E: e}
}

// Big numbers: little-endian 32-bit limbs in u64s.

fn big_from(b []u8) []u64 {
	let out = make([]u64, (len(b)+3)/4)
	for i in 0..len(b) {
		let k = len(b) - 1 - i
		out[k/4] |= u64(b[i]) << u64(8*(k%4))
	}
	return out
}

fn big_bytes(x []u64, n i64) []u8 {
	let out = make([]u8, n)
	for k in 0..n {
		if k/4 < len(x) {
			out[n-1-k] = u8(x[k/4] >> u64(8*(k%4)))
		}
	}
	return out
}

fn big_mul(a []u64, b []u64) []u64 {
	let out = make([]u64, len(a)+len(b))
	for i in 0..len(a) {
		mut carry = u64(0)
		for j in 0..len(b) {
			let t = a[i]*b[j] + out[i+j] + carry
			out[i+j] = t & 0xffffffff
			carry = t >> 32
		}
		mut k = i + len(b)
		for carry != 0 {
			let t = out[k] + carry
			out[k] = t & 0xffffffff
			carry = t >> 32
			k += 1
		}
	}
	return out
}

// big_mod is p mod m, bit by bit: rem doubles, takes the next bit, and drops m when it can.
fn big_mod(p []u64, m []u64) []u64 {
	let n = len(m) + 1
	let rem = make([]u64, n)
	{
		mut i = len(p)*32 - 1
		for i >= 0 {
			mut carry = (p[i/32] >> u64(i%32)) & 1
			for k in 0..n {
				let t = rem[k]<<1 | carry
				rem[k] = t & 0xffffffff
				carry = t >> 32
			}
			mut ge = true
			{
			mut k = n - 1
			for k >= 0 {
					mut mk = u64(0)
					if k < len(m) {
						mk = m[k]
					}
					if rem[k] != mk {
						ge = rem[k] > mk
						break
					}
					k -= 1
			}
		}
			if ge {
				mut borrow = u64(0)
				for k in 0..n {
					mut mk = u64(0)
					if k < len(m) {
						mk = m[k]
					}
					let d = rem[k] -% mk -% borrow
					if rem[k] < mk+borrow {
						borrow = 1
					} else {
						borrow = 0
					}
					rem[k] = d & 0xffffffff
				}
			}
			i -= 1
		}
	}
	return rem[:len(m)]
}

// big_powmod is x^e mod m, by squaring from the top bit of e.
fn big_powmod(x []u64, e []u8, m []u64) []u64 {
	mut r = []u64{1}
	mut started = false
	for i in 0..len(e)*8 {
		let bit = (e[i/8] >> u8(7-i%8)) & 1
		if started {
			r = big_mod(big_mul(r, r), m)
		}
		if bit == 1 {
			r = big_mod(big_mul(r, x), m)
			started = true
		}
	}
	return r
}

fn mgf1_sha1(seed []u8, n i64) []u8 {
	mut out = make([]u8, 0, n+20)
	{
		mut c = 0
		for len(out) < n {
			mut b = make([]u8, 0, len(seed)+4)
			for _, x in seed {
				b = append(b, x)
			}
			b = append(b, u8(c>>24), u8(c>>16), u8(c>>8), u8(c))
			for _, x in Sha1(str(b)) {
				out = append(out, x)
			}
			c += 1
		}
	}
	return out[:n]
}

// EncryptOAEPSha1 encrypts msg for key with RSA-OAEP (SHA-1, MGF1-SHA-1, empty label), as
// MySQL's caching_sha2_password and sha256_password expect.
fn EncryptOAEPSha1(key RSAPublicKey, msg []u8) ![]u8 {
	let k = len(key.N)
	if k < 64 || len(msg) > k-42 {
		fail "seal: message too long for the RSA key"
	}
	mut db = make([]u8, 0, k-21)
	for _, x in Sha1("") {
		db = append(db, x)
	}
	for i in 0..k-len(msg)-42 {
		db = append(db, 0)
	}
	db = append(db, 1)
	for _, x in msg {
		db = append(db, x)
	}
	let seed = RandomBytes(20)
	let dbMask = mgf1_sha1(seed, k-21)
	for i in 0..len(db) {
		db[i] ^= dbMask[i]
	}
	let seedMask = mgf1_sha1(db, 20)
	mut em = make([]u8, 0, k)
	em = append(em, 0)
	for i in 0..20 {
		em = append(em, seed[i]^seedMask[i])
	}
	for _, x in db {
		em = append(em, x)
	}
	let c = big_powmod(big_from(em), key.E, big_from(key.N))
	return big_bytes(c, k)
}
