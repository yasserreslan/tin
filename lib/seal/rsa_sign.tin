package seal

import "say"

// ---- RSA signing (PKCS #1 v1.5 and PSS) with CRT and blinding ----
// Constant time in the private key and the message representative: the exponentiations use
// monty_exp_ct with exponents padded to the primes' length, reductions use monty_reduce, and
// the input is blinded by r^e for a random r, removed with r^-1 computed by Fermat inversion in
// each prime (also monty_exp_ct). The pair (r^e, r^-1) is kept with the key and squared after
// each signature, which keeps it a valid pair at the cost of two multiplications instead of two
// inversions; a fresh r replaces it every rsaBlindUses signatures (#474). Every signature is
// checked with the public key before it is returned, so a fault in the arithmetic cannot leak
// a factor of n.

const rsaBlindUses = 32

// rsa_inv_prime sets z = x^-1 mod the prime of f (x^(p-2)), in constant time.
fn rsa_inv_prime(f mut monty, z mut []u64, x []u64, p secret []u8) {
	let e = make([]u8, f.size())
	let pb = monty_bytes(f, p)
	mut borrow = 2
	{
		mut i = len(pb) - 1
		for i >= 0 {
			mut v = i64(pb[i]) - borrow
			borrow = 0
			if v < 0 {
				v += 256
				borrow = 1
			}
			e[i] = u8(v)
			i -= 1
		}
	}
	monty_exp_ct(mut f, mut z, x, e)
}

// rsa_crt_join returns m2 + q*(qinv*(m1 - m2) mod p) as nn limbs; m1 is mod p and m2 mod q,
// both in Montgomery form of their fields.
fn rsa_crt_join(k mut RSAPrivateKey, m1 []u64, m2 []u64) []u64 {
	let m2plain = monty_plain(mut k.fq, m2)
	let m2p = k.fp.elem()
	monty_reduce(mut k.fp, mut m2p, limbs_to_be(m2plain))
	let h = k.fp.elem()
	k.fp.sub(mut h, m1, m2p)
	let qi = k.fp.elem()
	monty_reduce(mut k.fp, mut qi, k.qinv)
	k.fp.mul(mut h, h, qi)
	let hplain = monty_plain(mut k.fp, h)
	let m = nat_mul_ct(limbs_from_be(k.q, k.fq.n), hplain)
	nat_add_ct(mut m, m2plain)
	let out = make([]u64, k.fnm.n)
	{
		mut j = 0
		for j < k.fnm.n && j < len(m) {
			out[j] = m[j]
			j += 1
		}
	}
	return out
}

// rsa_blind_new sets k's blinding pair from a fresh random r in [1, n): r^e, and r^-1 joined
// from r^-1 mod p and mod q (Fermat inversions, monty_exp_ct).
fn rsa_blind_new(k mut RSAPrivateKey) {
	let fnm = k.fnm
	let r = fnm.elem()
	for {
		monty_reduce(mut fnm, mut r, RandomBytes(fnm.size()+16))
		if fnm.is_zero(r) == 0 {
			break
		}
	}
	mut at = 0
	for at < len(k.Public.E) && k.Public.E[at] == 0 {
		at += 1
	}
	fnm.set(mut k.bl, r)
	rsa_exp_pub(mut fnm, mut k.bl, k.Public.E[at:])
	let rb = fnm.to_bytes(r)
	let rp = k.fp.elem()
	let rq = k.fq.elem()
	monty_reduce(mut k.fp, mut rp, rb)
	monty_reduce(mut k.fq, mut rq, rb)
	rsa_inv_prime(mut k.fp, mut rp, rp, k.p)
	rsa_inv_prime(mut k.fq, mut rq, rq, k.q)
	let rinv = rsa_crt_join(mut k, rp, rq)
	fnm.mul(mut k.unbl, rinv, fnm.rr)
	k.blUses = 0
}

// rsa_private is em^d mod n, k bytes, for em < n.
fn rsa_private(k mut RSAPrivateKey, em secret []u8) ![]u8 {
	let size = (RSAKeyBits(k.Public) + 7) / 8
	let fnm = k.fnm
	let c = fnm.elem()
	if fnm.from_bytes(mut c, monty_bytes(fnm, em)) == 0 {
		fail "seal: RSA message representative out of range"
	}
	if k.blUses == 0 || k.blUses >= rsaBlindUses {
		rsa_blind_new(mut k)
	}
	// Blind: c' = c * r^e.
	fnm.mul(mut c, c, k.bl)
	let cb = fnm.to_bytes(c)
	// CRT: m1 = c'^dp mod p, m2 = c'^dq mod q.
	let cp = k.fp.elem()
	let cq = k.fq.elem()
	monty_reduce(mut k.fp, mut cp, cb)
	monty_reduce(mut k.fq, mut cq, cb)
	let m1 = k.fp.elem()
	let m2 = k.fq.elem()
	monty_exp_ct(mut k.fp, mut m1, cp, k.dp)
	monty_exp_ct(mut k.fq, mut m2, cq, k.dq)
	let mb = rsa_crt_join(mut k, m1, m2)
	// Unblind with r^-1, then square the pair for the next signature.
	let mm = fnm.elem()
	fnm.mul(mut mm, mb, fnm.rr)
	fnm.mul(mut mm, mm, k.unbl)
	fnm.mul(mut k.bl, k.bl, k.bl)
	fnm.mul(mut k.unbl, k.unbl, k.unbl)
	k.blUses += 1
	mut sig = fnm.to_bytes(mm)
	sig = sig[len(sig)-size:]
	// Check with the public key before releasing anything.
	let back = rsa_public(k.Public, sig) catch err {
		fail say.Fault("seal: RSA signature self-check failed (%s)", err)
	}
	if !ConstantTimeEq(back, monty_bytes_len(em, size)) {
		fail "seal: RSA signature self-check failed"
	}
	return sig
}

// monty_bytes_len pads big-endian b with leading zeros to n bytes.
fn monty_bytes_len(b []u8, n i64) []u8 {
	if len(b) >= n {
		return b[len(b)-n:]
	}
	let out = make([]u8, n)
	for i in 0..len(b) {
		out[n-len(b)+i] = b[i]
	}
	return out
}

// SignPKCS1v15 signs digest, a hash made with h, with RSASSA-PKCS1-v1_5 (deterministic).
fn SignPKCS1v15(k mut RSAPrivateKey, h Hash, digest []u8) ![]u8 {
	if len(digest) != Size(h) {
		fail "seal: digest length does not match the hash"
	}
	let size = (RSAKeyBits(k.Public) + 7) / 8
	let prefix = rsa_digest_info(h)
	let tlen = len(prefix) + len(digest)
	if size < tlen+11 {
		fail "seal: RSA key too short for the digest"
	}
	let em = make([]u8, size)
	em[1] = 1
	for i in 2..size-tlen-1 {
		em[i] = 0xff
	}
	for i in 0..len(prefix) {
		em[size-tlen+i] = prefix[i]
	}
	for i in 0..len(digest) {
		em[size-len(digest)+i] = digest[i]
	}
	return try rsa_private(mut k, em)
}

// SignPSS signs digest, a hash made with h, with RSASSA-PSS: MGF1 over h and a random salt as
// long as the digest (what TLS 1.3 requires).
fn SignPSS(k mut RSAPrivateKey, h Hash, digest []u8) ![]u8 {
	let hlen = Size(h)
	if len(digest) != hlen {
		fail "seal: digest length does not match the hash"
	}
	let embits = RSAKeyBits(k.Public) - 1
	let emlen = (embits + 7) / 8
	if emlen < 2*hlen+2 {
		fail "seal: RSA key too short for PSS with this hash"
	}
	let salt = RandomBytes(hlen)
	mut mp = make([]u8, 8, 8+2*hlen)
	mp = append(mp, digest...)
	mp = append(mp, salt...)
	let hh = Sum(h, str(mp))
	let dblen = emlen - hlen - 1
	let db = make([]u8, dblen)
	db[dblen-hlen-1] = 1
	for i in 0..hlen {
		db[dblen-hlen+i] = salt[i]
	}
	let mask = mgf1(h, hh, dblen)
	for i in 0..dblen {
		db[i] ^= mask[i]
	}
	db[0] &= u8(0xff >> u8(8*emlen-embits))
	mut em = make([]u8, 0, emlen)
	em = append(em, db...)
	em = append(em, hh...)
	em = append(em, 0xbc)
	return try rsa_private(mut k, em)
}
