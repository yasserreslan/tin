package seal

// ---- SHA-3 and SHAKE (FIPS 202), for ML-KEM (#479) ----
// Keccak-f[1600] on 25 64-bit lanes, in portable code. A sponge absorbs its input `rate` bytes at
// a time, little-endian into the lanes, then pads with the domain bits (0x06 for SHA-3, 0x1f for
// SHAKE) and 0x80 at the end of the block. Every step is data-independent, so secrets (ML-KEM
// seeds) take the same time whatever their value.

let keccakRC []u64 = []u64{
	0x0000000000000001, 0x0000000000008082, 0x800000000000808a, 0x8000000080008000,
	0x000000000000808b, 0x0000000080000001, 0x8000000080008081, 0x8000000000008009,
	0x000000000000008a, 0x0000000000000088, 0x0000000080008009, 0x000000008000000a,
	0x000000008000808b, 0x800000000000008b, 0x8000000000008089, 0x8000000000008003,
	0x8000000000008002, 0x8000000000000080, 0x000000000000800a, 0x800000008000000a,
	0x8000000080008081, 0x8000000000008080, 0x0000000080000001, 0x8000000080008008,
}

// keccak_f permutes the 25 lanes of a (Keccak-f[1600], 24 rounds), in place. Each round computes
// theta's column parities, then the new state one row at a time: the row's five lanes after rho
// and pi, then chi, written back over the five lanes it read (iota on the first). Keeping only a
// row live suits the registers of both CPUs. Writing a row over its own sources moves the lanes
// around the array; with row y's outputs rotated by y places, the lanes are back at their
// indexes after four rounds, so four rounds are written out with the indexes they have then.
@wrap fn keccak_f(a mut []u64) {
	if len(a) != 25 {
		rt_panic("seal: a Keccak state has 25 lanes")
	}
	let p = cast(i64, a)[2]
	// The same few locals serve every row and round, so they can all live in registers: b0..b4
	// hold theta's column parities until d0..d4 are made from them.
	mut d0 = u64(0)
	mut d1 = u64(0)
	mut d2 = u64(0)
	mut d3 = u64(0)
	mut d4 = u64(0)
	mut b0 = u64(0)
	mut b1 = u64(0)
	mut b2 = u64(0)
	mut b3 = u64(0)
	mut b4 = u64(0)
	mut t = u64(0)
	for r in (0..24).step(4) {
		// round r+0
		b0 = u64(__ld(p, 3)) ^ u64(__ld(p+40, 3)) ^ u64(__ld(p+80, 3)) ^ u64(__ld(p+120, 3)) ^ u64(__ld(p+160, 3))
		b1 = u64(__ld(p+8, 3)) ^ u64(__ld(p+48, 3)) ^ u64(__ld(p+88, 3)) ^ u64(__ld(p+128, 3)) ^ u64(__ld(p+168, 3))
		b2 = u64(__ld(p+16, 3)) ^ u64(__ld(p+56, 3)) ^ u64(__ld(p+96, 3)) ^ u64(__ld(p+136, 3)) ^ u64(__ld(p+176, 3))
		b3 = u64(__ld(p+24, 3)) ^ u64(__ld(p+64, 3)) ^ u64(__ld(p+104, 3)) ^ u64(__ld(p+144, 3)) ^ u64(__ld(p+184, 3))
		b4 = u64(__ld(p+32, 3)) ^ u64(__ld(p+72, 3)) ^ u64(__ld(p+112, 3)) ^ u64(__ld(p+152, 3)) ^ u64(__ld(p+192, 3))
		d0 = b4 ^ (b1<<1 | b1>>63)
		d1 = b0 ^ (b2<<1 | b2>>63)
		d2 = b1 ^ (b3<<1 | b3>>63)
		d3 = b2 ^ (b4<<1 | b4>>63)
		d4 = b3 ^ (b0<<1 | b0>>63)
		b0 = u64(__ld(p, 3)) ^ d0
		t = u64(__ld(p+48, 3)) ^ d1
		b1 = t<<44 | t>>20
		t = u64(__ld(p+96, 3)) ^ d2
		b2 = t<<43 | t>>21
		t = u64(__ld(p+144, 3)) ^ d3
		b3 = t<<21 | t>>43
		t = u64(__ld(p+192, 3)) ^ d4
		b4 = t<<14 | t>>50
		__st(p, i64(b0 ^ (^b1 & b2) ^ keccakRC[r]), 3)
		__st(p+48, i64(b1 ^ (^b2 & b3)), 3)
		__st(p+96, i64(b2 ^ (^b3 & b4)), 3)
		__st(p+144, i64(b3 ^ (^b4 & b0)), 3)
		__st(p+192, i64(b4 ^ (^b0 & b1)), 3)
		t = u64(__ld(p+24, 3)) ^ d3
		b0 = t<<28 | t>>36
		t = u64(__ld(p+72, 3)) ^ d4
		b1 = t<<20 | t>>44
		t = u64(__ld(p+80, 3)) ^ d0
		b2 = t<<3 | t>>61
		t = u64(__ld(p+128, 3)) ^ d1
		b3 = t<<45 | t>>19
		t = u64(__ld(p+176, 3)) ^ d2
		b4 = t<<61 | t>>3
		__st(p+72, i64(b0 ^ (^b1 & b2)), 3)
		__st(p+80, i64(b1 ^ (^b2 & b3)), 3)
		__st(p+128, i64(b2 ^ (^b3 & b4)), 3)
		__st(p+176, i64(b3 ^ (^b4 & b0)), 3)
		__st(p+24, i64(b4 ^ (^b0 & b1)), 3)
		t = u64(__ld(p+8, 3)) ^ d1
		b0 = t<<1 | t>>63
		t = u64(__ld(p+56, 3)) ^ d2
		b1 = t<<6 | t>>58
		t = u64(__ld(p+104, 3)) ^ d3
		b2 = t<<25 | t>>39
		t = u64(__ld(p+152, 3)) ^ d4
		b3 = t<<8 | t>>56
		t = u64(__ld(p+160, 3)) ^ d0
		b4 = t<<18 | t>>46
		__st(p+104, i64(b0 ^ (^b1 & b2)), 3)
		__st(p+152, i64(b1 ^ (^b2 & b3)), 3)
		__st(p+160, i64(b2 ^ (^b3 & b4)), 3)
		__st(p+8, i64(b3 ^ (^b4 & b0)), 3)
		__st(p+56, i64(b4 ^ (^b0 & b1)), 3)
		t = u64(__ld(p+32, 3)) ^ d4
		b0 = t<<27 | t>>37
		t = u64(__ld(p+40, 3)) ^ d0
		b1 = t<<36 | t>>28
		t = u64(__ld(p+88, 3)) ^ d1
		b2 = t<<10 | t>>54
		t = u64(__ld(p+136, 3)) ^ d2
		b3 = t<<15 | t>>49
		t = u64(__ld(p+184, 3)) ^ d3
		b4 = t<<56 | t>>8
		__st(p+136, i64(b0 ^ (^b1 & b2)), 3)
		__st(p+184, i64(b1 ^ (^b2 & b3)), 3)
		__st(p+32, i64(b2 ^ (^b3 & b4)), 3)
		__st(p+40, i64(b3 ^ (^b4 & b0)), 3)
		__st(p+88, i64(b4 ^ (^b0 & b1)), 3)
		t = u64(__ld(p+16, 3)) ^ d2
		b0 = t<<62 | t>>2
		t = u64(__ld(p+64, 3)) ^ d3
		b1 = t<<55 | t>>9
		t = u64(__ld(p+112, 3)) ^ d4
		b2 = t<<39 | t>>25
		t = u64(__ld(p+120, 3)) ^ d0
		b3 = t<<41 | t>>23
		t = u64(__ld(p+168, 3)) ^ d1
		b4 = t<<2 | t>>62
		__st(p+168, i64(b0 ^ (^b1 & b2)), 3)
		__st(p+16, i64(b1 ^ (^b2 & b3)), 3)
		__st(p+64, i64(b2 ^ (^b3 & b4)), 3)
		__st(p+112, i64(b3 ^ (^b4 & b0)), 3)
		__st(p+120, i64(b4 ^ (^b0 & b1)), 3)
		// round r+1
		b0 = u64(__ld(p, 3)) ^ u64(__ld(p+72, 3)) ^ u64(__ld(p+104, 3)) ^ u64(__ld(p+136, 3)) ^ u64(__ld(p+168, 3))
		b1 = u64(__ld(p+48, 3)) ^ u64(__ld(p+80, 3)) ^ u64(__ld(p+152, 3)) ^ u64(__ld(p+184, 3)) ^ u64(__ld(p+16, 3))
		b2 = u64(__ld(p+96, 3)) ^ u64(__ld(p+128, 3)) ^ u64(__ld(p+160, 3)) ^ u64(__ld(p+32, 3)) ^ u64(__ld(p+64, 3))
		b3 = u64(__ld(p+144, 3)) ^ u64(__ld(p+176, 3)) ^ u64(__ld(p+8, 3)) ^ u64(__ld(p+40, 3)) ^ u64(__ld(p+112, 3))
		b4 = u64(__ld(p+192, 3)) ^ u64(__ld(p+24, 3)) ^ u64(__ld(p+56, 3)) ^ u64(__ld(p+88, 3)) ^ u64(__ld(p+120, 3))
		d0 = b4 ^ (b1<<1 | b1>>63)
		d1 = b0 ^ (b2<<1 | b2>>63)
		d2 = b1 ^ (b3<<1 | b3>>63)
		d3 = b2 ^ (b4<<1 | b4>>63)
		d4 = b3 ^ (b0<<1 | b0>>63)
		b0 = u64(__ld(p, 3)) ^ d0
		t = u64(__ld(p+80, 3)) ^ d1
		b1 = t<<44 | t>>20
		t = u64(__ld(p+160, 3)) ^ d2
		b2 = t<<43 | t>>21
		t = u64(__ld(p+40, 3)) ^ d3
		b3 = t<<21 | t>>43
		t = u64(__ld(p+120, 3)) ^ d4
		b4 = t<<14 | t>>50
		__st(p, i64(b0 ^ (^b1 & b2) ^ keccakRC[r+1]), 3)
		__st(p+80, i64(b1 ^ (^b2 & b3)), 3)
		__st(p+160, i64(b2 ^ (^b3 & b4)), 3)
		__st(p+40, i64(b3 ^ (^b4 & b0)), 3)
		__st(p+120, i64(b4 ^ (^b0 & b1)), 3)
		t = u64(__ld(p+144, 3)) ^ d3
		b0 = t<<28 | t>>36
		t = u64(__ld(p+24, 3)) ^ d4
		b1 = t<<20 | t>>44
		t = u64(__ld(p+104, 3)) ^ d0
		b2 = t<<3 | t>>61
		t = u64(__ld(p+184, 3)) ^ d1
		b3 = t<<45 | t>>19
		t = u64(__ld(p+64, 3)) ^ d2
		b4 = t<<61 | t>>3
		__st(p+24, i64(b0 ^ (^b1 & b2)), 3)
		__st(p+104, i64(b1 ^ (^b2 & b3)), 3)
		__st(p+184, i64(b2 ^ (^b3 & b4)), 3)
		__st(p+64, i64(b3 ^ (^b4 & b0)), 3)
		__st(p+144, i64(b4 ^ (^b0 & b1)), 3)
		t = u64(__ld(p+48, 3)) ^ d1
		b0 = t<<1 | t>>63
		t = u64(__ld(p+128, 3)) ^ d2
		b1 = t<<6 | t>>58
		t = u64(__ld(p+8, 3)) ^ d3
		b2 = t<<25 | t>>39
		t = u64(__ld(p+88, 3)) ^ d4
		b3 = t<<8 | t>>56
		t = u64(__ld(p+168, 3)) ^ d0
		b4 = t<<18 | t>>46
		__st(p+8, i64(b0 ^ (^b1 & b2)), 3)
		__st(p+88, i64(b1 ^ (^b2 & b3)), 3)
		__st(p+168, i64(b2 ^ (^b3 & b4)), 3)
		__st(p+48, i64(b3 ^ (^b4 & b0)), 3)
		__st(p+128, i64(b4 ^ (^b0 & b1)), 3)
		t = u64(__ld(p+192, 3)) ^ d4
		b0 = t<<27 | t>>37
		t = u64(__ld(p+72, 3)) ^ d0
		b1 = t<<36 | t>>28
		t = u64(__ld(p+152, 3)) ^ d1
		b2 = t<<10 | t>>54
		t = u64(__ld(p+32, 3)) ^ d2
		b3 = t<<15 | t>>49
		t = u64(__ld(p+112, 3)) ^ d3
		b4 = t<<56 | t>>8
		__st(p+32, i64(b0 ^ (^b1 & b2)), 3)
		__st(p+112, i64(b1 ^ (^b2 & b3)), 3)
		__st(p+192, i64(b2 ^ (^b3 & b4)), 3)
		__st(p+72, i64(b3 ^ (^b4 & b0)), 3)
		__st(p+152, i64(b4 ^ (^b0 & b1)), 3)
		t = u64(__ld(p+96, 3)) ^ d2
		b0 = t<<62 | t>>2
		t = u64(__ld(p+176, 3)) ^ d3
		b1 = t<<55 | t>>9
		t = u64(__ld(p+56, 3)) ^ d4
		b2 = t<<39 | t>>25
		t = u64(__ld(p+136, 3)) ^ d0
		b3 = t<<41 | t>>23
		t = u64(__ld(p+16, 3)) ^ d1
		b4 = t<<2 | t>>62
		__st(p+16, i64(b0 ^ (^b1 & b2)), 3)
		__st(p+96, i64(b1 ^ (^b2 & b3)), 3)
		__st(p+176, i64(b2 ^ (^b3 & b4)), 3)
		__st(p+56, i64(b3 ^ (^b4 & b0)), 3)
		__st(p+136, i64(b4 ^ (^b0 & b1)), 3)
		// round r+2
		b0 = u64(__ld(p, 3)) ^ u64(__ld(p+24, 3)) ^ u64(__ld(p+8, 3)) ^ u64(__ld(p+32, 3)) ^ u64(__ld(p+16, 3))
		b1 = u64(__ld(p+80, 3)) ^ u64(__ld(p+104, 3)) ^ u64(__ld(p+88, 3)) ^ u64(__ld(p+112, 3)) ^ u64(__ld(p+96, 3))
		b2 = u64(__ld(p+160, 3)) ^ u64(__ld(p+184, 3)) ^ u64(__ld(p+168, 3)) ^ u64(__ld(p+192, 3)) ^ u64(__ld(p+176, 3))
		b3 = u64(__ld(p+40, 3)) ^ u64(__ld(p+64, 3)) ^ u64(__ld(p+48, 3)) ^ u64(__ld(p+72, 3)) ^ u64(__ld(p+56, 3))
		b4 = u64(__ld(p+120, 3)) ^ u64(__ld(p+144, 3)) ^ u64(__ld(p+128, 3)) ^ u64(__ld(p+152, 3)) ^ u64(__ld(p+136, 3))
		d0 = b4 ^ (b1<<1 | b1>>63)
		d1 = b0 ^ (b2<<1 | b2>>63)
		d2 = b1 ^ (b3<<1 | b3>>63)
		d3 = b2 ^ (b4<<1 | b4>>63)
		d4 = b3 ^ (b0<<1 | b0>>63)
		b0 = u64(__ld(p, 3)) ^ d0
		t = u64(__ld(p+104, 3)) ^ d1
		b1 = t<<44 | t>>20
		t = u64(__ld(p+168, 3)) ^ d2
		b2 = t<<43 | t>>21
		t = u64(__ld(p+72, 3)) ^ d3
		b3 = t<<21 | t>>43
		t = u64(__ld(p+136, 3)) ^ d4
		b4 = t<<14 | t>>50
		__st(p, i64(b0 ^ (^b1 & b2) ^ keccakRC[r+2]), 3)
		__st(p+104, i64(b1 ^ (^b2 & b3)), 3)
		__st(p+168, i64(b2 ^ (^b3 & b4)), 3)
		__st(p+72, i64(b3 ^ (^b4 & b0)), 3)
		__st(p+136, i64(b4 ^ (^b0 & b1)), 3)
		t = u64(__ld(p+40, 3)) ^ d3
		b0 = t<<28 | t>>36
		t = u64(__ld(p+144, 3)) ^ d4
		b1 = t<<20 | t>>44
		t = u64(__ld(p+8, 3)) ^ d0
		b2 = t<<3 | t>>61
		t = u64(__ld(p+112, 3)) ^ d1
		b3 = t<<45 | t>>19
		t = u64(__ld(p+176, 3)) ^ d2
		b4 = t<<61 | t>>3
		__st(p+144, i64(b0 ^ (^b1 & b2)), 3)
		__st(p+8, i64(b1 ^ (^b2 & b3)), 3)
		__st(p+112, i64(b2 ^ (^b3 & b4)), 3)
		__st(p+176, i64(b3 ^ (^b4 & b0)), 3)
		__st(p+40, i64(b4 ^ (^b0 & b1)), 3)
		t = u64(__ld(p+80, 3)) ^ d1
		b0 = t<<1 | t>>63
		t = u64(__ld(p+184, 3)) ^ d2
		b1 = t<<6 | t>>58
		t = u64(__ld(p+48, 3)) ^ d3
		b2 = t<<25 | t>>39
		t = u64(__ld(p+152, 3)) ^ d4
		b3 = t<<8 | t>>56
		t = u64(__ld(p+16, 3)) ^ d0
		b4 = t<<18 | t>>46
		__st(p+48, i64(b0 ^ (^b1 & b2)), 3)
		__st(p+152, i64(b1 ^ (^b2 & b3)), 3)
		__st(p+16, i64(b2 ^ (^b3 & b4)), 3)
		__st(p+80, i64(b3 ^ (^b4 & b0)), 3)
		__st(p+184, i64(b4 ^ (^b0 & b1)), 3)
		t = u64(__ld(p+120, 3)) ^ d4
		b0 = t<<27 | t>>37
		t = u64(__ld(p+24, 3)) ^ d0
		b1 = t<<36 | t>>28
		t = u64(__ld(p+88, 3)) ^ d1
		b2 = t<<10 | t>>54
		t = u64(__ld(p+192, 3)) ^ d2
		b3 = t<<15 | t>>49
		t = u64(__ld(p+56, 3)) ^ d3
		b4 = t<<56 | t>>8
		__st(p+192, i64(b0 ^ (^b1 & b2)), 3)
		__st(p+56, i64(b1 ^ (^b2 & b3)), 3)
		__st(p+120, i64(b2 ^ (^b3 & b4)), 3)
		__st(p+24, i64(b3 ^ (^b4 & b0)), 3)
		__st(p+88, i64(b4 ^ (^b0 & b1)), 3)
		t = u64(__ld(p+160, 3)) ^ d2
		b0 = t<<62 | t>>2
		t = u64(__ld(p+64, 3)) ^ d3
		b1 = t<<55 | t>>9
		t = u64(__ld(p+128, 3)) ^ d4
		b2 = t<<39 | t>>25
		t = u64(__ld(p+32, 3)) ^ d0
		b3 = t<<41 | t>>23
		t = u64(__ld(p+96, 3)) ^ d1
		b4 = t<<2 | t>>62
		__st(p+96, i64(b0 ^ (^b1 & b2)), 3)
		__st(p+160, i64(b1 ^ (^b2 & b3)), 3)
		__st(p+64, i64(b2 ^ (^b3 & b4)), 3)
		__st(p+128, i64(b3 ^ (^b4 & b0)), 3)
		__st(p+32, i64(b4 ^ (^b0 & b1)), 3)
		// round r+3
		b0 = u64(__ld(p, 3)) ^ u64(__ld(p+144, 3)) ^ u64(__ld(p+48, 3)) ^ u64(__ld(p+192, 3)) ^ u64(__ld(p+96, 3))
		b1 = u64(__ld(p+104, 3)) ^ u64(__ld(p+8, 3)) ^ u64(__ld(p+152, 3)) ^ u64(__ld(p+56, 3)) ^ u64(__ld(p+160, 3))
		b2 = u64(__ld(p+168, 3)) ^ u64(__ld(p+112, 3)) ^ u64(__ld(p+16, 3)) ^ u64(__ld(p+120, 3)) ^ u64(__ld(p+64, 3))
		b3 = u64(__ld(p+72, 3)) ^ u64(__ld(p+176, 3)) ^ u64(__ld(p+80, 3)) ^ u64(__ld(p+24, 3)) ^ u64(__ld(p+128, 3))
		b4 = u64(__ld(p+136, 3)) ^ u64(__ld(p+40, 3)) ^ u64(__ld(p+184, 3)) ^ u64(__ld(p+88, 3)) ^ u64(__ld(p+32, 3))
		d0 = b4 ^ (b1<<1 | b1>>63)
		d1 = b0 ^ (b2<<1 | b2>>63)
		d2 = b1 ^ (b3<<1 | b3>>63)
		d3 = b2 ^ (b4<<1 | b4>>63)
		d4 = b3 ^ (b0<<1 | b0>>63)
		b0 = u64(__ld(p, 3)) ^ d0
		t = u64(__ld(p+8, 3)) ^ d1
		b1 = t<<44 | t>>20
		t = u64(__ld(p+16, 3)) ^ d2
		b2 = t<<43 | t>>21
		t = u64(__ld(p+24, 3)) ^ d3
		b3 = t<<21 | t>>43
		t = u64(__ld(p+32, 3)) ^ d4
		b4 = t<<14 | t>>50
		__st(p, i64(b0 ^ (^b1 & b2) ^ keccakRC[r+3]), 3)
		__st(p+8, i64(b1 ^ (^b2 & b3)), 3)
		__st(p+16, i64(b2 ^ (^b3 & b4)), 3)
		__st(p+24, i64(b3 ^ (^b4 & b0)), 3)
		__st(p+32, i64(b4 ^ (^b0 & b1)), 3)
		t = u64(__ld(p+72, 3)) ^ d3
		b0 = t<<28 | t>>36
		t = u64(__ld(p+40, 3)) ^ d4
		b1 = t<<20 | t>>44
		t = u64(__ld(p+48, 3)) ^ d0
		b2 = t<<3 | t>>61
		t = u64(__ld(p+56, 3)) ^ d1
		b3 = t<<45 | t>>19
		t = u64(__ld(p+64, 3)) ^ d2
		b4 = t<<61 | t>>3
		__st(p+40, i64(b0 ^ (^b1 & b2)), 3)
		__st(p+48, i64(b1 ^ (^b2 & b3)), 3)
		__st(p+56, i64(b2 ^ (^b3 & b4)), 3)
		__st(p+64, i64(b3 ^ (^b4 & b0)), 3)
		__st(p+72, i64(b4 ^ (^b0 & b1)), 3)
		t = u64(__ld(p+104, 3)) ^ d1
		b0 = t<<1 | t>>63
		t = u64(__ld(p+112, 3)) ^ d2
		b1 = t<<6 | t>>58
		t = u64(__ld(p+80, 3)) ^ d3
		b2 = t<<25 | t>>39
		t = u64(__ld(p+88, 3)) ^ d4
		b3 = t<<8 | t>>56
		t = u64(__ld(p+96, 3)) ^ d0
		b4 = t<<18 | t>>46
		__st(p+80, i64(b0 ^ (^b1 & b2)), 3)
		__st(p+88, i64(b1 ^ (^b2 & b3)), 3)
		__st(p+96, i64(b2 ^ (^b3 & b4)), 3)
		__st(p+104, i64(b3 ^ (^b4 & b0)), 3)
		__st(p+112, i64(b4 ^ (^b0 & b1)), 3)
		t = u64(__ld(p+136, 3)) ^ d4
		b0 = t<<27 | t>>37
		t = u64(__ld(p+144, 3)) ^ d0
		b1 = t<<36 | t>>28
		t = u64(__ld(p+152, 3)) ^ d1
		b2 = t<<10 | t>>54
		t = u64(__ld(p+120, 3)) ^ d2
		b3 = t<<15 | t>>49
		t = u64(__ld(p+128, 3)) ^ d3
		b4 = t<<56 | t>>8
		__st(p+120, i64(b0 ^ (^b1 & b2)), 3)
		__st(p+128, i64(b1 ^ (^b2 & b3)), 3)
		__st(p+136, i64(b2 ^ (^b3 & b4)), 3)
		__st(p+144, i64(b3 ^ (^b4 & b0)), 3)
		__st(p+152, i64(b4 ^ (^b0 & b1)), 3)
		t = u64(__ld(p+168, 3)) ^ d2
		b0 = t<<62 | t>>2
		t = u64(__ld(p+176, 3)) ^ d3
		b1 = t<<55 | t>>9
		t = u64(__ld(p+184, 3)) ^ d4
		b2 = t<<39 | t>>25
		t = u64(__ld(p+192, 3)) ^ d0
		b3 = t<<41 | t>>23
		t = u64(__ld(p+160, 3)) ^ d1
		b4 = t<<2 | t>>62
		__st(p+160, i64(b0 ^ (^b1 & b2)), 3)
		__st(p+168, i64(b1 ^ (^b2 & b3)), 3)
		__st(p+176, i64(b2 ^ (^b3 & b4)), 3)
		__st(p+184, i64(b3 ^ (^b4 & b0)), 3)
		__st(p+192, i64(b4 ^ (^b0 & b1)), 3)

	}
}

// sponge is a Keccak state with its rate in bytes; it absorbs, then squeezes.
type sponge struct {
	a    []u64
	rate i64
	out  []u8 // the current output block
	pos  i64  // bytes of out already read
}

// absorb_block xors rate bytes of p (from at) into the lanes and permutes. Lanes are
// little-endian, as both CPUs are, so each is one 8-byte load (unaligned loads are allowed on both).
@wrap fn (s mut sponge) absorb_block(p []u8, at i64) {
	let n = s.rate / 8
	if at < 0 || at+8*n > len(p) || len(s.a) != 25 || n > 25 {
		rt_panic("seal: a Keccak block is out of range")
	}
	let pp = cast(i64, p)[2] + at
	let ap = cast(i64, s.a)[2]
	for i in 0..n {
		__st(ap+8*i, __ld(ap+8*i, 3) ^ __ld(pp+8*i, 3), 3)
	}
	keccak_f(mut s.a)
}

// sponge_new absorbs msg and pads it with the domain byte: the sponge is ready to squeeze.
fn sponge_new(rate i64, msg []u8, domain u8) sponge {
	mut s = sponge{a: make([]u64, 25), rate: rate, out: make([]u8, rate), pos: 0}
	let full = len(msg) / rate * rate
	for at in (0..full).step(rate) {
		s.absorb_block(msg, at)
	}
	let last = make([]u8, rate)
	for i in 0..len(msg)-full {
		last[i] = msg[full+i]
	}
	last[len(msg)-full] = domain
	last[rate-1] = last[rate-1] | 0x80
	s.absorb_block(last, 0)
	s.lanes_out()
	return s
}

// lanes_out copies the rate's lanes into out, little-endian (the CPUs' order), for squeezing.
@wrap fn (s mut sponge) lanes_out() {
	let n = s.rate / 8
	if 8*n > len(s.out) || len(s.a) != 25 || n > 25 {
		rt_panic("seal: a Keccak block is out of range")
	}
	let op = cast(i64, s.out)[2]
	let ap = cast(i64, s.a)[2]
	for i in 0..n {
		__st(op+8*i, __ld(ap+8*i, 3), 3)
	}
	s.pos = 0
}

// squeeze appends the next n output bytes to dst, a block's worth at a time.
fn (s mut sponge) squeeze(dst mut []u8, n i64) {
	mut left = n
	for left > 0 {
		if s.pos == s.rate {
			keccak_f(mut s.a)
			s.lanes_out()
		}
		mut k = s.rate - s.pos
		if k > left {
			k = left
		}
		dst = append(dst, s.out[s.pos:s.pos+k]...)
		s.pos += k
		left -= k
	}
}

// sponge_sum is the first n bytes the sponge of msg gives.
fn sponge_sum(rate i64, msg []u8, domain u8, n i64) []u8 {
	mut s = sponge_new(rate, msg, domain)
	mut out = make([]u8, 0, n)
	s.squeeze(mut out, n)
	return out
}

// Sha3_256 is the SHA3-256 digest of s (32 bytes); s may be secret.
fn Sha3_256(s secret str) []u8 {
	return sponge_sum(136, []u8(s), 0x06, 32)
}

// Sha3_512 is the SHA3-512 digest of s (64 bytes); s may be secret.
fn Sha3_512(s secret str) []u8 {
	return sponge_sum(72, []u8(s), 0x06, 64)
}

// Shake128 is the first n bytes of SHAKE128 of s; s may be secret.
fn Shake128(s secret str, n i64) []u8 {
	return sponge_sum(168, []u8(s), 0x1f, n)
}

// Shake256 is the first n bytes of SHAKE256 of s; s may be secret.
fn Shake256(s secret str, n i64) []u8 {
	return sponge_sum(136, []u8(s), 0x1f, n)
}
