package seal

// ---- X25519 (RFC 7748) ----
// Field elements mod p = 2^255 - 19 are five unsigned limbs in radix 2^51, each below 2^52
// between operations (#474): fe_mul and fe_sq (generated, fe25519.tin) accumulate 128-bit
// products with mulhi, and every other operation ends with a carry. The ladder swaps with
// masks, never branches on the scalar, and every field operation runs the same instructions
// whatever the values: X25519 is constant-time in the scalar and the point. The field and
// ladder functions are @wrap (#362): the limb bounds keep every sum in u64, and a checked
// operation would branch on secret data.

const mask51 = 0x7ffffffffffff // the low 51 bits

fn fe_new() []u64 {
	return make([]u64, 5)
}

// fe_carry stores in h the limbs l0..l4, each below 2^63, carried back below 2^52.
@wrap fn fe_carry(h mut []u64, l0 u64, l1 u64, l2 u64, l3 u64, l4 u64) {
	h[0] = (l0 & mask51) + (l4>>51)*19
	h[1] = (l1 & mask51) + (l0 >> 51)
	h[2] = (l2 & mask51) + (l1 >> 51)
	h[3] = (l3 & mask51) + (l2 >> 51)
	h[4] = (l4 & mask51) + (l3 >> 51)
}

// fe_mul121665 sets h = 121665*f; each limb's product has 69 bits, so its high part is carried
// from the 128-bit product.
@wrap fn fe_mul121665(h mut []u64, f []u64) {
	let k = u64(121665)
	let p0 = f[0] * k
	let p1 = f[1] * k
	let p2 = f[2] * k
	let p3 = f[3] * k
	let p4 = f[4] * k
	let c0 = (mulhi(f[0], k) << 13) | (p0 >> 51)
	let c1 = (mulhi(f[1], k) << 13) | (p1 >> 51)
	let c2 = (mulhi(f[2], k) << 13) | (p2 >> 51)
	let c3 = (mulhi(f[3], k) << 13) | (p3 >> 51)
	let c4 = (mulhi(f[4], k) << 13) | (p4 >> 51)
	h[0] = (p0 & mask51) + c4*19
	h[1] = (p1 & mask51) + c0
	h[2] = (p2 & mask51) + c1
	h[3] = (p3 & mask51) + c2
	h[4] = (p4 & mask51) + c3
}

@wrap fn fe_add(h mut []u64, f []u64, g []u64) {
	fe_carry(mut h, f[0]+g[0], f[1]+g[1], f[2]+g[2], f[3]+g[3], f[4]+g[4])
}

// fe_sub sets h = f - g, computed as (f + 2p) - g so that no limb goes below zero.
@wrap fn fe_sub(h mut []u64, f []u64, g []u64) {
	fe_carry(mut h, (f[0]+0xfffffffffffda)-g[0], (f[1]+0xffffffffffffe)-g[1], (f[2]+0xffffffffffffe)-g[2],
		(f[3]+0xffffffffffffe)-g[3], (f[4]+0xffffffffffffe)-g[4])
}

fn fe_copy(h mut []u64, f []u64) {
	for i in 0..5 {
		h[i] = f[i]
	}
}

// fe_cswap swaps f and g when b is 1, in constant time.
@wrap fn fe_cswap(f mut []u64, g mut []u64, b i64) {
	let mask = u64(0) - u64(b)
	for i in 0..5 {
		let x = (f[i] ^ g[i]) & mask
		f[i] ^= x
		g[i] ^= x
	}
}

// le64 is the little-endian 64-bit word at s[at:at+8].
fn le64(s []u8, at i64) u64 {
	mut v = u64(0)
	for j in 0..8 {
		v |= u64(s[at+j]) << u64(8*j)
	}
	return v
}

// fe_frombytes reads 32 little-endian bytes, ignoring the top bit.
@wrap fn fe_frombytes(h mut []u64, s []u8) {
	h[0] = le64(s, 0) & mask51
	h[1] = (le64(s, 6) >> 3) & mask51
	h[2] = (le64(s, 12) >> 6) & mask51
	h[3] = (le64(s, 19) >> 1) & mask51
	h[4] = (le64(s, 24) >> 12) & mask51
}

// fe_tobytes is f reduced mod p, as 32 little-endian bytes.
@wrap fn fe_tobytes(f []u64) []u8 {
	let h = fe_new()
	fe_carry(mut h, f[0], f[1], f[2], f[3], f[4])
	// Now h < 2^255 + 2^13*19. q is 1 when h >= p, that is when h + 19 reaches 2^255.
	mut q = (h[0] + 19) >> 51
	q = (h[1] + q) >> 51
	q = (h[2] + q) >> 51
	q = (h[3] + q) >> 51
	q = (h[4] + q) >> 51
	h[0] += 19 * q
	h[1] += h[0] >> 51
	h[0] &= mask51
	h[2] += h[1] >> 51
	h[1] &= mask51
	h[3] += h[2] >> 51
	h[2] &= mask51
	h[4] += h[3] >> 51
	h[3] &= mask51
	h[4] &= mask51
	let out = make([]u8, 32)
	for i in 0..5 {
		let off = 51 * i
		let w = h[i] << u64(off%8)
		for j in 0..8 {
			let at = off/8 + j
			if at < 32 {
				out[at] |= u8(w >> u64(8*j))
			}
		}
	}
	return out
}

// fe_invert sets out = z^(p-2) with the usual chain of 254 squarings and 11 multiplications.
@wrap fn fe_invert(out mut []u64, z []u64) {
	let t0 = fe_new()
	let t1 = fe_new()
	let t2 = fe_new()
	let t3 = fe_new()
	fe_sq(mut t0, z)
	fe_sq(mut t1, t0)
	fe_sq(mut t1, t1)
	fe_mul(mut t1, z, t1)
	fe_mul(mut t0, t0, t1)
	fe_sq(mut t2, t0)
	fe_mul(mut t1, t1, t2)
	fe_sq(mut t2, t1)
	for i in 1..5 {
		fe_sq(mut t2, t2)
	}
	fe_mul(mut t1, t2, t1)
	fe_sq(mut t2, t1)
	for i in 1..10 {
		fe_sq(mut t2, t2)
	}
	fe_mul(mut t2, t2, t1)
	fe_sq(mut t3, t2)
	for i in 1..20 {
		fe_sq(mut t3, t3)
	}
	fe_mul(mut t2, t3, t2)
	fe_sq(mut t2, t2)
	for i in 1..10 {
		fe_sq(mut t2, t2)
	}
	fe_mul(mut t1, t2, t1)
	fe_sq(mut t2, t1)
	for i in 1..50 {
		fe_sq(mut t2, t2)
	}
	fe_mul(mut t2, t2, t1)
	fe_sq(mut t3, t2)
	for i in 1..100 {
		fe_sq(mut t3, t3)
	}
	fe_mul(mut t2, t3, t2)
	fe_sq(mut t2, t2)
	for i in 1..50 {
		fe_sq(mut t2, t2)
	}
	fe_mul(mut t1, t2, t1)
	fe_sq(mut t1, t1)
	for i in 1..5 {
		fe_sq(mut t1, t1)
	}
	fe_mul(mut out, t1, t0)
}

// x25519 is the X25519 function of a 32-byte scalar and u-coordinate (no zero check).
@wrap fn x25519(scalar []u8, point []u8) []u8 {
	let e = make([]u8, 32)
	for i in 0..32 {
		e[i] = scalar[i]
	}
	e[0] &= 248
	e[31] &= 127
	e[31] |= 64
	let x1 = fe_new()
	fe_frombytes(mut x1, point)
	let x2 = fe_new()
	x2[0] = 1
	let z2 = fe_new()
	let x3 = fe_new()
	fe_copy(mut x3, x1)
	let z3 = fe_new()
	z3[0] = 1
	let a = fe_new()
	let aa = fe_new()
	let b = fe_new()
	let bb = fe_new()
	let ee = fe_new()
	let c = fe_new()
	let d = fe_new()
	let da = fe_new()
	let cb = fe_new()
	mut swap = 0
	{
		mut pos = 254
		for pos >= 0 {
			let bit = i64((e[pos/8] >> u8(pos&7)) & 1)
			swap ^= bit
			fe_cswap(mut x2, mut x3, swap)
			fe_cswap(mut z2, mut z3, swap)
			swap = bit
			fe_add(mut a, x2, z2)
			fe_sq(mut aa, a)
			fe_sub(mut b, x2, z2)
			fe_sq(mut bb, b)
			fe_sub(mut ee, aa, bb)
			fe_add(mut c, x3, z3)
			fe_sub(mut d, x3, z3)
			fe_mul(mut da, d, a)
			fe_mul(mut cb, c, b)
			fe_add(mut x3, da, cb)
			fe_sq(mut x3, x3)
			fe_sub(mut z3, da, cb)
			fe_sq(mut z3, z3)
			fe_mul(mut z3, z3, x1)
			fe_mul(mut x2, aa, bb)
			fe_mul121665(mut z2, ee)
			fe_add(mut z2, z2, aa)
			fe_mul(mut z2, z2, ee)
			pos -= 1
		}
	}
	fe_cswap(mut x2, mut x3, swap)
	fe_cswap(mut z2, mut z3, swap)
	fe_invert(mut z2, z2)
	fe_mul(mut x2, x2, z2)
	return fe_tobytes(x2)
}

// X25519 is the RFC 7748 function: the shared secret of a 32-byte private scalar and a
// peer's 32-byte public key. It fails for wrong lengths and when the result is all zeros
// (a low-order peer key), as TLS 1.3 requires. Constant-time in the scalar and the point.
fn X25519(scalar secret []u8, point []u8) ![]u8 {
	if len(scalar) != 32 || len(point) != 32 {
		fail "seal: X25519 needs a 32-byte scalar and point"
	}
	let out = x25519(scalar, point)
	mut v = u8(0)
	for i in 0..32 {
		v |= out[i]
	}
	if v == 0 {
		fail "seal: X25519 shared secret is zero (low-order public key)"
	}
	return out
}

// X25519NewPrivateKey returns 32 random bytes to use as an X25519 private key.
fn X25519NewPrivateKey() []u8 {
	return RandomBytes(32)
}

// X25519PublicKey is the public key (32 bytes) of a 32-byte X25519 private key.
fn X25519PublicKey(priv secret []u8) ![]u8 {
	if len(priv) != 32 {
		fail "seal: X25519 needs a 32-byte private key"
	}
	let base = make([]u8, 32)
	base[0] = 9
	return x25519(priv, base)
}
