package seal

import "say"

// ---- Private keys: PKCS #8, PKCS #1 (RSA) and SEC 1 (EC) in DER or PEM, for the TLS server ----
// Parsing is not constant time in the key's encoding (lengths, tags), which is public in
// practice; the arithmetic that uses the keys is (rsa_sign.tin, ecdsa_sign.tin).

// RSAPrivateKey is an RSA key with its CRT values; the private parts can only be read by seal.
type RSAPrivateKey struct {
	Public RSAPublicKey
	p secret []u8
	q secret []u8
	dp secret []u8
	dq secret []u8
	qinv secret []u8
	fp monty
	fq monty
	fnm monty
	// The blinding pair (#474): r^e and r^-1 mod n in Montgomery form, both squared after each
	// signature and replaced by a fresh random r every rsaBlindUses signatures.
	bl []u64
	unbl []u64
	blUses i64
}

// ECPrivateKey is an ECDSA key on P-256 or P-384: the curve, the scalar and the uncompressed public point.
type ECPrivateKey struct {
	Curve str
	Public []u8
	d secret []u8
}

// PrivateKey is an RSA, ECDSA or Ed25519 private key, as ParsePrivateKeyPEM reads it.
type PrivateKey struct {
	Algorithm PublicKeyAlgorithm
	RSA ?RSAPrivateKey
	EC ?ECPrivateKey
	Ed ?Ed25519PrivateKey
}

// keys_rsa_pkcs1 parses an RSAPrivateKey (PKCS #1): two primes only.
fn keys_rsa_pkcs1(der []u8, from i64, to i64) !RSAPrivateKey {
	let (sf, st) = try der_expect(der, from, to, derSequence, "an RSA private key")
	if st != to {
		fail "seal: trailing data after the RSA private key"
	}
	mut (ver, p) = try der_small_int(der, sf, st)
	if ver != 0 {
		fail "seal: multi-prime RSA keys are not supported"
	}
	mut vals = [][]u8{}
	for i in 0..8 {
		let (v, next) = try der_posint(der, p, st)
		vals = append(vals, v)
		p = next
	}
	if p != st {
		fail "seal: trailing data in the RSA private key"
	}
	let key = RSAPublicKey{N: vals[0], E: vals[1]}
	let bits = RSAKeyBits(key)
	if bits < 2048 || bits > 8192 {
		fail say.Fault("seal: RSA key size %d is not supported (2048 to 8192 bits)", bits)
	}
	let fp = try monty_new(vals[3])
	let fq = try monty_new(vals[4])
	let fnm = try monty_new(vals[0])
	let k = RSAPrivateKey{Public: key, p: vals[3], q: vals[4], dp: monty_bytes(fp, vals[5]), dq: monty_bytes(fq, vals[6]),
		qinv: vals[7], fp: fp, fq: fq, fnm: fnm, bl: fnm.elem(), unbl: fnm.elem(), blUses: 0}
	try rsa_check_private(mut k)
	return k
}

// rsa_check_private checks that p*q = n and that a test signature verifies.
fn rsa_check_private(k mut RSAPrivateKey) ! {
	let pl = limbs_from_be(k.p, k.fp.n)
	let ql = limbs_from_be(k.q, k.fq.n)
	let prod = nat_mul_ct(pl, ql)
	let nl = limbs_from_be(k.Public.N, len(prod))
	if !nat_eq(prod, nl) {
		fail "seal: RSA private key: p*q is not n"
	}
	let digest = Sha256("seal: RSA private key check")
	let sig = try SignPKCS1v15(mut k, Hash.SHA256, digest)
	VerifyPKCS1v15(k.Public, Hash.SHA256, digest, sig) catch err {
		fail say.Fault("seal: RSA private key does not match its public key (%s)", err)
	}
}

// keys_ec parses an ECPrivateKey (SEC 1); curve is the curve the PKCS #8 wrapper named, or "".
fn keys_ec(der []u8, from i64, to i64, curve str) !ECPrivateKey {
	let (sf, st) = try der_expect(der, from, to, derSequence, "an EC private key")
	if st != to {
		fail "seal: trailing data after the EC private key"
	}
	mut (ver, p) = try der_small_int(der, sf, st)
	if ver != 1 {
		fail "seal: bad EC private key version"
	}
	let (df, dt) = try der_expect(der, p, st, derOctetString, "the private scalar")
	p = dt
	mut named = curve
	mut pub = []u8{}
	if p < st && der[p] == 0xa0 {
		let (_, cf, ct) = try der_read(der, p, st)
		let (oid, end) = try der_oid(der, cf, ct)
		if end != ct {
			fail "seal: bad EC private key parameters"
		}
		mut c = ""
		if oid == oidP256 {
			c = "P-256"
		} else if oid == oidP384 {
			c = "P-384"
		} else {
			fail "seal: unsupported curve " + oid + " in the EC private key"
		}
		if named != "" && named != c {
			fail "seal: EC private key names two curves"
		}
		named = c
		p = ct
	}
	if p < st && der[p] == 0xa1 {
		let (_, bf, bt) = try der_read(der, p, st)
		let (bits, end) = try der_bits(der, bf, bt)
		if end != bt {
			fail "seal: bad EC public key in the private key"
		}
		pub = bits
		p = bt
	}
	if p != st {
		fail "seal: trailing data in the EC private key"
	}
	if named == "" {
		fail "seal: EC private key without a curve"
	}
	mut size = 32
	if named == "P-384" {
		size = 48
	}
	if dt-df != size {
		fail "seal: EC private scalar has the wrong length"
	}
	let d = der[df:dt]
	let computed = try ec_public(named, d)
	if len(pub) > 0 && !nat_bytes_eq(pub, computed) {
		fail "seal: EC private key does not match its public key"
	}
	return ECPrivateKey{Curve: named, Public: computed, d: d}
}

fn nat_bytes_eq(a []u8, b []u8) bool {
	if len(a) != len(b) {
		return false
	}
	for i in 0..len(a) {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

// ParsePrivateKeyDER reads a PKCS #8 PrivateKeyInfo, a PKCS #1 RSAPrivateKey or a SEC 1 ECPrivateKey.
fn ParsePrivateKeyDER(der []u8) !PrivateKey {
	let (sf, st) = try der_expect(der, 0, len(der), derSequence, "a private key")
	if st != len(der) {
		fail "seal: trailing data after the private key"
	}
	mut (_, p) = try der_small_int(der, sf, st)
	let (tag, _, _) = try der_read(der, p, st)
	if tag == derSequence {
		// PKCS #8: version, algorithm, OCTET STRING with the key.
		let (af, at) = try der_expect(der, p, st, derSequence, "an algorithm identifier")
		let (oid, q) = try der_oid(der, af, at)
		let (kf, kt) = try der_expect(der, at, st, derOctetString, "the private key")
		if oid == oidRSA {
			let k = try keys_rsa_pkcs1(der, kf, kt)
			return PrivateKey{Algorithm: PublicKeyAlgorithm.RSA, RSA: k}
		}
		if oid == oidECPublicKey {
			let (curve, end) = try der_oid(der, q, at)
			if end != at {
				fail "seal: bad EC key parameters"
			}
			mut c = ""
			if curve == oidP256 {
				c = "P-256"
			} else if curve == oidP384 {
				c = "P-384"
			} else {
				fail "seal: unsupported curve " + curve
			}
			let k = try keys_ec(der, kf, kt, c)
			return PrivateKey{Algorithm: PublicKeyAlgorithm.ECDSA, EC: k}
		}
		if oid == oidEd25519 {
			// RFC 8410: the key is an OCTET STRING holding the 32-byte seed.
			let (sf2, st2) = try der_expect(der, kf, kt, derOctetString, "an Ed25519 private key")
			if st2 != kt || st2-sf2 != 32 {
				fail "seal: an Ed25519 private key is a 32-byte seed"
			}
			let seed = der[sf2:st2]
			let pub = try Ed25519PublicKey(seed)
			return PrivateKey{Algorithm: PublicKeyAlgorithm.Ed25519, Ed: Ed25519PrivateKey{Public: pub, seed: seed}}
		}
		fail "seal: unsupported private key algorithm " + oid
	}
	if tag == derOctetString {
		let k = try keys_ec(der, 0, len(der), "")
		return PrivateKey{Algorithm: PublicKeyAlgorithm.ECDSA, EC: k}
	}
	let k = try keys_rsa_pkcs1(der, 0, len(der))
	return PrivateKey{Algorithm: PublicKeyAlgorithm.RSA, RSA: k}
}

// ParsePrivateKeyPEM reads the first "PRIVATE KEY", "RSA PRIVATE KEY" or "EC PRIVATE KEY" block of pem.
fn ParsePrivateKeyPEM(pem str) !PrivateKey {
	let blocks = try DecodePEM(pem)
	for _, b in blocks {
		if b.Type == "PRIVATE KEY" || b.Type == "RSA PRIVATE KEY" || b.Type == "EC PRIVATE KEY" {
			return try ParsePrivateKeyDER(b.Bytes)
		}
		if b.Type == "ENCRYPTED PRIVATE KEY" {
			fail "seal: encrypted private keys are not supported"
		}
	}
	fail "seal: no private key in PEM"
}

// MatchesCertificate reports whether k is the private key of c's public key.
fn (k PrivateKey) MatchesCertificate(c Certificate) bool {
	let r = k.RSA
	if r != nil {
		return c.PublicKeyAlgorithm == PublicKeyAlgorithm.RSA && nat_bytes_eq(r.Public.N, c.RSAKey.N) && nat_bytes_eq(r.Public.E, c.RSAKey.E)
	}
	let e = k.EC
	if e != nil {
		return c.PublicKeyAlgorithm == PublicKeyAlgorithm.ECDSA && c.Curve == e.Curve && nat_bytes_eq(e.Public, c.PublicKey)
	}
	let ed = k.Ed
	if ed != nil {
		return c.PublicKeyAlgorithm == PublicKeyAlgorithm.Ed25519 && nat_bytes_eq(ed.Public, c.PublicKey)
	}
	return false
}
