// Package dice is fast pseudo-random numbers (like Go's math/rand): xoshiro256** generators and a lazily seeded per-core one.
package dice

import "gauge"
import "glyph"

extern fn sqrt(x f64) f64

// Rand is a xoshiro256** generator; make one with New or FromState, or call the package functions for this core's generator.
type Rand struct {
	s0 u64
	s1 u64
	s2 u64
	s3 u64
}

// mix is the splitmix64 output function, used to expand seeds (modulo 2^64, #362).
@wrap fn mix(z u64) u64 {
	z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9
	z = (z ^ (z >> 27)) * 0x94d049bb133111eb
	return z ^ (z >> 31)
}

// Seed resets r to the sequence for seed s (expanded with splitmix64, so every seed gives a good state).
@wrap fn (r mut Rand) Seed(s u64) {
	mut z = s + 0x9e3779b97f4a7c15
	r.s0 = mix(z)
	z += 0x9e3779b97f4a7c15
	r.s1 = mix(z)
	z += 0x9e3779b97f4a7c15
	r.s2 = mix(z)
	z += 0x9e3779b97f4a7c15
	r.s3 = mix(z)
}

// New returns a generator seeded with s; equal seeds give equal sequences.
fn New(s u64) Rand {
	let r = Rand{}
	r.Seed(s)
	return r
}

// FromState returns a generator holding the exact xoshiro256** state words, which must not all be zero.
fn FromState(s0 u64, s1 u64, s2 u64, s3 u64) Rand {
	if s0|s1|s2|s3 == 0 {
		panic("dice: FromState with an all-zero state")
	}
	return Rand{s0: s0, s1: s1, s2: s2, s3: s3}
}

// State returns the four state words, so the sequence can be resumed later with FromState.
fn (r Rand) State() (u64, u64, u64, u64) {
	return r.s0, r.s1, r.s2, r.s3
}

// rotl rotates x left by k bits (0 < k < 64).
fn rotl(x u64, k i64) u64 {
	return (x << k) | (x >> (64 - k))
}

// U64 returns the next uniformly distributed 64-bit value.
@wrap fn (r mut Rand) U64() u64 {
	let s0 = r.s0
	let s1 = r.s1
	let s2 = r.s2 ^ s0
	let s3 = r.s3 ^ s1
	let result = rotl(s1*5, 7) * 9
	r.s0 = s0 ^ s3
	r.s1 = s1 ^ s2
	r.s2 = s2 ^ (s1 << 17)
	r.s3 = rotl(s3, 45)
	return result
}

// U32 returns the next uniformly distributed 32-bit value (the high half of U64).
fn (r mut Rand) U32() u32 {
	return u32(r.U64() >> 32)
}

// mul64 returns the high and low 64-bit halves of the 128-bit product a*b.
fn mul64(a u64, b u64) (u64, u64) {
	let al = a & 0xffffffff
	let ah = a >> 32
	let bl = b & 0xffffffff
	let bh = b >> 32
	let p0 = al * bl
	let p1 = al * bh
	let p2 = ah * bl
	let mid = (p0 >> 32) + (p1 & 0xffffffff) + (p2 & 0xffffffff)
	let hi = ah*bh + (p1 >> 32) + (p2 >> 32) + (mid >> 32)
	return hi, (mid << 32) | (p0 & 0xffffffff)
}

// U64n returns a uniform value in [0, n) without bias (Lemire's method); n == 0 means the full 64-bit range.
fn (r mut Rand) U64n(n u64) u64 {
	if n&(n-%1) == 0 {
		// n == 0 is the full range: n - 1 wraps to all ones.
		return r.U64() & (n -% 1)
	}
	if n <= 0xffffffff {
		mut v = r.U64() >> 32
		mut prod = v * n
		mut low = prod & 0xffffffff
		if low < n {
			let thresh = (0x100000000 - n) % n
			for low < thresh {
				v = r.U64() >> 32
				prod = v * n
				low = prod & 0xffffffff
			}
		}
		return prod >> 32
	}
	mut (hi, lo) = mul64(r.U64(), n)
	if lo < n {
		let thresh = (0 -% n) % n
		for lo < thresh {
			hi, lo = mul64(r.U64(), n)
		}
	}
	return hi
}

// I64n returns a uniform value in [0, n); it panics when n <= 0.
fn (r mut Rand) I64n(n i64) i64 {
	if n <= 0 {
		panic("dice: I64n with n <= 0")
	}
	return i64(r.U64n(u64(n)))
}

// Intn is I64n under Go's name (Tin's int is i64).
fn (r mut Rand) Intn(n i64) i64 {
	return r.I64n(n)
}

// Range returns a uniform value in [lo, hi); it panics when hi <= lo.
fn (r mut Rand) Range(lo i64, hi i64) i64 {
	if hi <= lo {
		panic("dice: Range with hi <= lo")
	}
	// The width and the sum are computed modulo 2^64: exact for every lo < hi.
	return lo +% i64(r.U64n(u64(hi)-%u64(lo)))
}

// F64 returns a uniform float in [0, 1) built from 53 random bits.
fn (r mut Rand) F64() f64 {
	return f64(r.U64()>>11) * (1.0 / 9007199254740992.0)
}

// NormF64 returns a normally distributed float (mean 0, standard deviation 1) by Marsaglia's polar method.
fn (r mut Rand) NormF64() f64 {
	mut u = 0.0
	mut s = 0.0
	for s <= 0.0 || s >= 1.0 {
		u = 2.0*r.F64() - 1.0
		let v = 2.0*r.F64() - 1.0
		s = u*u + v*v
	}
	return u * sqrt(-2.0*gauge.Log(s)/s)
}

// Shuffle permutes xs uniformly in place (Fisher-Yates).
fn (r mut Rand) Shuffle(xs mut []i64) {
	{
		mut i = len(xs) - 1
		for i > 0 {
			let j = i64(r.U64n(u64(i + 1)))
			let t = xs[i]
			xs[i] = xs[j]
			xs[j] = t
			i -= 1
		}
	}
}

// ShuffleStr permutes the strings xs uniformly in place.
fn (r mut Rand) ShuffleStr(xs mut []str) {
	{
		mut i = len(xs) - 1
		for i > 0 {
			let j = i64(r.U64n(u64(i + 1)))
			let t = xs[i]
			xs[i] = xs[j]
			xs[j] = t
			i -= 1
		}
	}
}

// Perm returns a uniformly random permutation of 0..n-1 (empty when n <= 0).
fn (r mut Rand) Perm(n i64) []i64 {
	if n <= 0 {
		return make([]i64, 0)
	}
	let p = make([]i64, n)
	for i in 0..n {
		p[i] = i
	}
	r.Shuffle(mut p)
	return p
}

// Fill overwrites every byte of b with random bytes, eight at a time.
fn (r mut Rand) Fill(b mut []u8) {
	let n = len(b)
	if n == 0 {
		return
	}
	let d = cast(i64, b)[2]
	let words = n >> 3
	for k in 0..words {
		d[k] = i64(r.U64())
	}
	let rem = n & 7
	if rem > 0 {
		mut v = r.U64()
		let base = n - rem
		for j in 0..rem {
			store8(d+base+j, i64(v&0xff))
			v >>= 8
		}
	}
}

// Bytes returns n random bytes (empty when n <= 0).
fn (r mut Rand) Bytes(n i64) []u8 {
	if n <= 0 {
		return make([]u8, 0)
	}
	let b = make([]u8, n)
	r.Fill(mut b)
	return b
}

// Str returns n characters drawn uniformly from alphabet (its bytes when ASCII, its runes otherwise); "" when n <= 0 or alphabet is empty.
fn (r mut Rand) Str(n i64, alphabet str) str {
	let la = len(alphabet)
	if n <= 0 || la == 0 {
		return ""
	}
	mut ascii = true
	for i in 0..la {
		if alphabet[i] >= 0x80 {
			ascii = false
			break
		}
	}
	if ascii {
		let p = rt_str_new(n)
		let d = p + 8
		let src = cast(i64, alphabet) + 8
		let m = u64(la)
		for i in 0..n {
			store8(d+i, i64(load8(src+i64(r.U64n(m)))))
		}
		return cast(str, p)
	}
	mut parts = make([]str, 0, la)
	mut i = 0
	for i < la {
		let (_, size) = glyph.DecodeRune(alphabet, i)
		parts = append(parts, alphabet[i:i+size])
		i += size
	}
	mut b = make([]u8, 0, n*2)
	let m = u64(len(parts))
	for k in 0..n {
		b = append(b, parts[i64(r.U64n(m))]...)
	}
	return str(b)
}

// Every core has its own generator (globals are per core), seeded on first use from the clocks and the core id.
let g Rand = Rand{}
mut gSeeded bool

// seedCore seeds this core's generator from the wall clock, the monotonic clock and the core id.
fn seedCore() {
	gSeeded = true
	g.Seed(u64(rt_wall_ns()) ^ mix(u64(rt_mono_ns())+%u64(rt_core_id())*%0x9e3779b97f4a7c15))
}

// taped is the generator of the request whose tape is tp: seeded at its first draw from this
// core's generator, and the seed recorded (dice.seed@1), so a replay draws the same values (#241).
fn taped(tp i64) Rand {
	if tp[7] != 0 {
		return cast(Rand, tp[7])
	}
	if !gSeeded {
		seedCore()
	}
	let seed = rt_effect_word(tp, "dice.seed@1", "", i64(g.U64()))
	let r = New(u64(seed))
	tp[7] = cast(i64, r)
	return r
}

// Seed seeds this core's generator so that the package functions become deterministic on this core.
fn Seed(s u64) {
	gSeeded = true
	g.Seed(s)
}

// U64 returns the next 64-bit value from this core's generator.
fn U64() u64 {
	let tp = rt_tape()
	if tp != 0 {
		let r = taped(tp)
		return r.U64()
	}
	if !gSeeded {
		seedCore()
	}
	return g.U64()
}

// U32 returns the next 32-bit value from this core's generator.
fn U32() u32 {
	let tp = rt_tape()
	if tp != 0 {
		let r = taped(tp)
		return r.U32()
	}
	if !gSeeded {
		seedCore()
	}
	return g.U32()
}

// U64n returns a uniform value in [0, n) from this core's generator (n == 0 means the full range).
fn U64n(n u64) u64 {
	let tp = rt_tape()
	if tp != 0 {
		let r = taped(tp)
		return r.U64n(n)
	}
	if !gSeeded {
		seedCore()
	}
	return g.U64n(n)
}

// I64n returns a uniform value in [0, n) from this core's generator; it panics when n <= 0.
fn I64n(n i64) i64 {
	let tp = rt_tape()
	if tp != 0 {
		let r = taped(tp)
		return r.I64n(n)
	}
	if !gSeeded {
		seedCore()
	}
	return g.I64n(n)
}

// Intn is I64n under Go's name.
fn Intn(n i64) i64 {
	let tp = rt_tape()
	if tp != 0 {
		let r = taped(tp)
		return r.I64n(n)
	}
	if !gSeeded {
		seedCore()
	}
	return g.I64n(n)
}

// Range returns a uniform value in [lo, hi) from this core's generator; it panics when hi <= lo.
fn Range(lo i64, hi i64) i64 {
	let tp = rt_tape()
	if tp != 0 {
		let r = taped(tp)
		return r.Range(lo, hi)
	}
	if !gSeeded {
		seedCore()
	}
	return g.Range(lo, hi)
}

// F64 returns a uniform float in [0, 1) from this core's generator.
fn F64() f64 {
	let tp = rt_tape()
	if tp != 0 {
		let r = taped(tp)
		return r.F64()
	}
	if !gSeeded {
		seedCore()
	}
	return g.F64()
}

// NormF64 returns a standard normal float from this core's generator.
fn NormF64() f64 {
	let tp = rt_tape()
	if tp != 0 {
		let r = taped(tp)
		return r.NormF64()
	}
	if !gSeeded {
		seedCore()
	}
	return g.NormF64()
}

// Shuffle permutes xs uniformly in place with this core's generator.
fn Shuffle(xs mut []i64) {
	let tp = rt_tape()
	if tp != 0 {
		let r = taped(tp)
		r.Shuffle(mut xs)
		return
	}
	if !gSeeded {
		seedCore()
	}
	g.Shuffle(mut xs)
}

// ShuffleStr permutes the strings xs uniformly in place with this core's generator.
fn ShuffleStr(xs mut []str) {
	let tp = rt_tape()
	if tp != 0 {
		let r = taped(tp)
		r.ShuffleStr(mut xs)
		return
	}
	if !gSeeded {
		seedCore()
	}
	g.ShuffleStr(mut xs)
}

// Perm returns a random permutation of 0..n-1 from this core's generator.
fn Perm(n i64) []i64 {
	let tp = rt_tape()
	if tp != 0 {
		let r = taped(tp)
		return r.Perm(n)
	}
	if !gSeeded {
		seedCore()
	}
	return g.Perm(n)
}

// Fill overwrites b with random bytes from this core's generator.
fn Fill(b mut []u8) {
	let tp = rt_tape()
	if tp != 0 {
		let r = taped(tp)
		r.Fill(mut b)
		return
	}
	if !gSeeded {
		seedCore()
	}
	g.Fill(mut b)
}

// Bytes returns n random bytes from this core's generator.
fn Bytes(n i64) []u8 {
	let tp = rt_tape()
	if tp != 0 {
		let r = taped(tp)
		return r.Bytes(n)
	}
	if !gSeeded {
		seedCore()
	}
	return g.Bytes(n)
}

// Str returns n random characters of alphabet from this core's generator.
fn Str(n i64, alphabet str) str {
	let tp = rt_tape()
	if tp != 0 {
		let r = taped(tp)
		return r.Str(n, alphabet)
	}
	if !gSeeded {
		seedCore()
	}
	return g.Str(n, alphabet)
}
