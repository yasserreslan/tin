// Darwin system calls retain libSystem.
package mysql

extern fn close(fd i64) i64
fn rt_sys_close(fd i64) i64 { return close(fd) }
extern fn recv(fd i64, buf i64, n i64, flags i64) i64
fn rt_sys_recv(fd i64, buf i64, n i64, flags i64) i64 { return recv(fd, buf, n, flags) }
extern fn shutdown(fd i64, how i64) i64
fn rt_sys_shutdown(fd i64, how i64) i64 { return shutdown(fd, how) }
