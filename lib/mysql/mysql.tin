// Package mysql is a MySQL client (tested with MySQL 8.0). Statements are queries: in
// db.Query("SELECT name FROM users WHERE id = {id}") the text becomes "... id = ?" and id a
// bound parameter of a prepared statement, so a value can never change a statement.
//
// Each core keeps a pool of connections per Client (Options.Pool, default max(2, 64/cores);
// Options.MaxTotal caps them for the process); a request task waits for a free one without
// blocking the core. Prepared statements are cached per connection. Authentication: caching_sha2_password (the MySQL 8 default, including the
// RSA key exchange when the server has no cached entry) and mysql_native_password.
// Options.TLS connects over TLS 1.3 (SSLRequest), verifying the server's certificate and name.
//
// Sizing: a Client opened in a global's initializer is opened on every core, so a 32-core pod
// with Pool 16 may open 512 connections to one server, and a fleet of pods multiplies that.
// Pool, when not set, is max(2, 64/cores) per core: about 64 for the process, at least 2 on
// each core. Options.MaxTotal caps the connections of the whole process, over all cores (Clients
// with the same address, user, database and MaxTotal share one cap): a core at the cap waits,
// within the request's deadline and Options.Timeout, until a connection is released or a core
// that has one idle gives up its slot. Set MaxTotal to at least the number of cores that serve
// database requests; below that, cores share connections by closing and dialing again.
//
//	let pw = quarry.Getenv("MYSQL_PASSWORD")
//	let id = 7
//	let db = mysql.Open(mysql.Options{Addr: "127.0.0.1:3306", User: "app", Password: pw, Database: "shop"})
//	let rows = try db.Query("SELECT id, name FROM users WHERE id = {id}")
//	for r in rows.Rows {
//		say.Line(r[0].Int(), r[1].Text())
//	}
package mysql

import "gauge"
import "mint"
import "say"
import "seal"
import "tls"
import "wire"


// Value is one column of a row.
type Value enum {
	Null
	Int(v i64)   // integer columns (an unsigned BIGINT above the i64 range wraps)
	Float(v f64) // FLOAT and DOUBLE
	Text(v str)  // everything else: strings, blobs, DECIMAL, JSON, dates and times as text
}

// Rows is a query's result.
type Rows struct {
	Columns []str
	Rows    [][]Value
}

// Result is what a statement without rows did.
type Result struct {
	Affected i64
	LastID   i64
}

// Options says where and how to connect.
type Options struct {
	Addr     str // "host:port" (default "127.0.0.1:3306")
	User     str
	Password str
	Database str
	Pool     i64 // connections per core (default max(2, 64/cores))
	MaxTotal i64 // connections for the whole process, over all cores (0: no cap)
	Timeout  i64 // ns a statement may wait (0: no limit; a request's deadline still applies)
	TLS      ?tls.Config // require TLS 1.3 (CLIENT_SSL and SSLRequest); the server name is Addr's host unless TLS.ServerName is set
}

// Client runs statements on one MySQL server. Open it in a global's initializer (which
// runs on every core) or once in main, not per request.
type Client struct {
	open bool // false for the zero Client
	rec  i64
}

// Tx is a transaction: its statements run on one connection until Commit or Rollback.
type Tx struct {
	open bool
	c    Client
	conn i64
}

const maxClients = 1024

// The shared record of a Client.
const rAddr = 0
const rAddrN = 1
const rUser = 2
const rUserN = 3
const rPass = 4
const rPassN = 5
const rDB = 6
const rDBN = 7
const rPool = 8
const rTimeout = 9
const rID = 10
const rKey = 11 // the server's RSA public key (PEM), once fetched
const rKeyN = 12
const rTls = 13 // the kept tls.Config, or 0 for plain TCP
const rCap = 14 // the cap record of Options.MaxTotal (see cap_record), 0: no cap
const recWords = 15

// A core's pool for one Client.
const pIdle = 0 // a stack of idle connections
const pIdleN = 1
const pTotal = 2
const pWait = 3 // waiters, in order
const pWaitHead = 4
const pWaitN = 5
const pWaitCap = 6
const poolWords = 7

// A waiter: [task, connection handed over, gone].
const wTask = 0
const wConn = 1
const wGone = 2
const wDone = 3

// A connection.
const cFd = 0
const cBuf = 1 // bytes read: packets from cS to cE
const cS = 2
const cE = 3
const cCap = 4
const cNext = 5 // where the packet returned last ends
const cOut = 6
const cOutN = 7
const cOutCap = 8
const cSeq = 9
const cCaps = 10
const cStmts = 11 // cached statements: [text ptr, len, hash, id, params] each
const cNStmts = 12
const cTimeout = 13
const cPkt = 14 // the start of the packet being written
const cStolen = 15 // another core took this idle connection's slot (MaxTotal): free it, do not use it
const connWords = 16

const stmtWords = 5
const maxStmts = 256

// Capability flags.
const capSSL = 0x800
const capLongPassword = 0x1
const capLongFlag = 0x4
const capConnectWithDB = 0x8
const capProtocol41 = 0x200
const capTransactions = 0x2000
const capSecureConnection = 0x8000
const capMultiResults = 0x20000
const capPluginAuth = 0x80000
const capPluginAuthLenenc = 0x200000
const capDeprecateEOF = 0x1000000

const moreResults = 0x8
const flagUnsigned = 0x20

shared mut nClients i64
mut pools i64 // per core: the pool of each Client, by id

// tlsConns holds the TLS layer of this core's connections, by connection record. Removing
// one releases its memory (counted long-lived memory, from keep).
let tlsConns = make(map[i64]?tls.Conn)

fn keep_raw(s str) i64 {
	let p = malloc(len(s) + 1)
	memcpy(p, cast(i64, s)+8, len(s))
	return p
}

fn rec_str(rec i64, at i64) str {
	return rt_str_from_raw(rec[at], rec[at+1])
}

// Open makes a client for the server in o. It connects on first use, on each core.
fn Open(o Options) Client {
	mut addr = o.Addr
	if addr == "" {
		addr = "127.0.0.1:3306"
	}
	let id = __atomic_add(&nClients, 1)
	if id >= maxClients {
		return Client{open: false, rec: 0}
	}
	let rec = calloc(recWords, 8)
	rec[rAddr] = keep_raw(addr)
	rec[rAddrN] = len(addr)
	rec[rUser] = keep_raw(o.User)
	rec[rUserN] = len(o.User)
	rec[rPass] = keep_raw(o.Password)
	rec[rPassN] = len(o.Password)
	rec[rDB] = keep_raw(o.Database)
	rec[rDBN] = len(o.Database)
	rec[rPool] = o.Pool // 0: default_pool(), which needs the core count, known only when the cores run
	if o.MaxTotal > 0 {
		rec[rCap] = cap_record(addr + "\x00" + o.User + "\x00" + o.Database + "\x00" + mint.Itoa(o.MaxTotal), o.MaxTotal)
	}
	rec[rTimeout] = o.Timeout
	rec[rID] = id
	let cfg = o.TLS
	if cfg != nil {
		rec[rTls] = cast(i64, keep(cfg))
	}
	return Client{open: true, rec: rec}
}

// ---- values ----

// IsNull reports whether v is NULL.
fn (v Value) IsNull() bool {
	match v {
		Null => {
			return true
		}
		_ => {
		}
	}
	return false
}

// Int is v as an integer (a Text or Float converted, NULL and bad text 0).
fn (v Value) Int() i64 {
	match v {
		Int(n) => {
			return n
		}
		Float(f) => {
			return i64(f)
		}
		Text(s) => {
			let n = mint.ParseInt(s, 10) catch _ { 0 }
			return n
		}
		Null => {
		}
	}
	return 0
}

// Float is v as a float.
fn (v Value) Float() f64 {
	match v {
		Int(n) => {
			return f64(n)
		}
		Float(f) => {
			return f
		}
		Text(s) => {
			let f = mint.ParseFloat(s) catch _ { 0.0 }
			return f
		}
		Null => {
		}
	}
	return 0.0
}

// Text is v as text ("" for NULL).
fn (v Value) Text() str {
	match v {
		Int(n) => {
			return mint.Itoa(n)
		}
		Float(f) => {
			return mint.FormatFloat(f, 'g', -1)
		}
		Text(s) => {
			return s
		}
		Null => {
		}
	}
	return ""
}

// Col is the index of the named column, or -1.
fn (r Rows) Col(name str) i64 {
	for i, c in r.Columns {
		if c == name {
			return i
		}
	}
	return -1
}

// ---- packets ----

fn os_msg(what str, e i64) str {
	let m = rt_sys_strerror(e)
	return "mysql: {what}: {rt_str_from_raw(m, strlen(m))}"
}

fn wait_msg(r i64) ! {
	if r == waitDeadline {
		fail cast(fault, rt_wait_fault())
	}
	fail "mysql: timed out"
}

fn le(p i64, n i64) i64 {
	mut v = 0
	{
		mut i = n - 1
		for i >= 0 {
			v = v<<8 | i64(load8(p+i))
			i -= 1
		}
	}
	return v
}

// read_packet returns the next packet's payload; it stays valid until the next call.
fn read_packet(c i64) !(i64, i64) {
	c[cS] = c[cNext]
	for {
		let avail = c[cE] - c[cS]
		if avail >= 4 {
			let n = le(c[cBuf]+c[cS], 3)
			if n == 0xffffff {
				fail "mysql: packets of 16 MiB and more are not supported"
			}
			if avail >= 4+n {
				c[cSeq] = (i64(load8(c[cBuf]+c[cS]+3)) + 1) & 255
				c[cNext] = c[cS] + 4 + n
				return c[cBuf] + c[cS] + 4, n
			}
			if c[cS]+4+n > c[cCap] {
				// Make room: move what is buffered to the front, and grow when needed.
				if c[cS] > 0 {
					memmove(c[cBuf], c[cBuf]+c[cS], avail)
					c[cE] = avail
					c[cS] = 0
				}
				if 4+n > c[cCap] {
					let cp = 4 + n + 16384
					c[cBuf] = realloc(c[cBuf], cp)
					c[cCap] = cp
				}
			}
		} else if c[cS] > 0 && c[cS] == c[cE] {
			c[cS] = 0
			c[cE] = 0
		} else if c[cE] == c[cCap] {
			memmove(c[cBuf], c[cBuf]+c[cS], avail)
			c[cE] = avail
			c[cS] = 0
		}
		let tc = tlsConns[c]
		if tc != nil {
			let buf = make([]u8, 0, c[cCap]-c[cE])
			let got = try tc.ReadNow(mut buf, c[cCap]-c[cE])
			if got > 0 {
				memcpy(c[cBuf]+c[cE], cast(i64, buf)[2], got)
				c[cE] += got
				continue
			}
			let r = rt_task_wait(c[cFd], 1, c[cTimeout])
			if r != waitReady {
				fail wait_msg(r)
			}
			continue
		}
		let k = rt_sys_read(c[cFd], c[cBuf]+c[cE], c[cCap]-c[cE])
		if k > 0 {
			c[cE] += k
			continue
		}
		if k == 0 {
			fail "mysql: the server closed the connection"
		}
		let e = rt_errno()
		if e == EINTR {
			continue
		}
		if e != EAGAIN {
			fail os_msg("read", e)
		}
		let r = rt_task_wait(c[cFd], 1, c[cTimeout])
		if r != waitReady {
			fail wait_msg(r)
		}
	}
}

fn out_reserve(c i64, n i64) i64 {
	if c[cOutN]+n > c[cOutCap] {
		let cp = c[cOutCap]*2 + n + 4096
		c[cOut] = realloc(c[cOut], cp)
		c[cOutCap] = cp
	}
	let p = c[cOut] + c[cOutN]
	c[cOutN] += n
	return p
}

fn begin_packet(c i64, seq i64) {
	c[cSeq] = seq
	c[cPkt] = c[cOutN]
	out_reserve(c, 4)
}

fn put_u8(c i64, v i64) {
	store8(out_reserve(c, 1), v)
}

fn put_le(c i64, v i64, n i64) {
	let p = out_reserve(c, n)
	for i in 0..n {
		store8(p+i, v>>(8*i))
	}
}

fn put_raw(c i64, p i64, n i64) {
	if n > 0 {
		memcpy(out_reserve(c, n), p, n)
	}
}

fn put_str(c i64, s str) {
	put_raw(c, cast(i64, s)+8, len(s))
}

fn put_bytes(c i64, b []u8) {
	put_raw(c, cast(i64, b)[2], len(b))
}

fn put_lenenc(c i64, v i64) {
	if v < 251 {
		put_u8(c, v)
	} else if v < 65536 {
		put_u8(c, 0xfc)
		put_le(c, v, 2)
	} else if v < 16777216 {
		put_u8(c, 0xfd)
		put_le(c, v, 3)
	} else {
		put_u8(c, 0xfe)
		put_le(c, v, 8)
	}
}

fn end_packet(c i64) ! {
	let n = c[cOutN] - c[cPkt] - 4
	if n >= 0xffffff {
		fail "mysql: statements and parameters of 16 MiB and more are not supported"
	}
	let p = c[cOut] + c[cPkt]
	store8(p, n)
	store8(p+1, n>>8)
	store8(p+2, n>>16)
	store8(p+3, c[cSeq])
	c[cSeq] = (c[cSeq] + 1) & 255
}

fn flush(c i64) ! {
	let tc = tlsConns[c]
	if tc != nil {
		let err = tc.Write(rt_str_from_raw(c[cOut], c[cOutN]))
		c[cOutN] = 0
		if err != nil {
			fail err
		}
		return
	}
	mut at = 0
	for at < c[cOutN] {
		let k = rt_sys_write(c[cFd], c[cOut]+at, c[cOutN]-at)
		if k > 0 {
			at += k
			continue
		}
		let e = rt_errno()
		if e == EINTR {
			continue
		}
		if e != EAGAIN {
			c[cOutN] = 0
			fail os_msg("write", e)
		}
		let r = rt_task_wait(c[cFd], 2, c[cTimeout])
		if r != waitReady {
			c[cOutN] = 0
			fail wait_msg(r)
		}
	}
	c[cOutN] = 0
}

// A cursor over a packet's payload.
type cur struct {
	p   i64
	at  i64
	end i64
}

fn (k mut cur) u8() i64 {
	if k.at >= k.end {
		return 0
	}
	let v = i64(load8(k.p + k.at))
	k.at += 1
	return v
}

fn (k mut cur) fixed(n i64) i64 {
	if k.at+n > k.end {
		k.at = k.end
		return 0
	}
	let v = le(k.p+k.at, n)
	k.at += n
	return v
}

// lenenc reads a length-encoded integer; NULL (0xfb) is -1.
fn (k mut cur) lenenc() i64 {
	let b = k.u8()
	if b < 0xfb {
		return b
	}
	if b == 0xfb {
		return -1
	}
	if b == 0xfc {
		return k.fixed(2)
	}
	if b == 0xfd {
		return k.fixed(3)
	}
	return k.fixed(8)
}

fn (k mut cur) bytes(n i64) str {
	if n < 0 || k.at+n > k.end {
		n = k.end - k.at
	}
	let s = rt_str_from_raw(k.p+k.at, n)
	k.at += n
	return s
}

fn (k mut cur) lenstr() str {
	return k.bytes(k.lenenc())
}

fn (k mut cur) cstr() str {
	mut e = k.at
	for e < k.end && load8(k.p+e) != 0 {
		e += 1
	}
	let s = rt_str_from_raw(k.p+k.at, e-k.at)
	k.at = e + 1
	return s
}

fn (k mut cur) rest() str {
	return k.bytes(k.end - k.at)
}

// err_packet turns an ERR packet into a fault: "mysql: Error 1146 (42S02): ...".
fn err_packet(p i64, n i64) str {
	let k = cur{p: p, at: 1, end: n}
	let code = k.fixed(2)
	mut state = ""
	if k.at < k.end && load8(p+k.at) == '#' {
		k.at += 1
		state = k.bytes(5)
	}
	let msg = k.rest()
	if state == "" {
		return "mysql: Error {code}: {msg}"
	}
	return "mysql: Error {code} ({state}): {msg}"
}

// ---- authentication ----

fn xor_bytes(a []u8, b []u8) []u8 {
	let out = make([]u8, len(a))
	for i in 0..len(a) {
		out[i] = a[i] ^ b[i%len(b)]
	}
	return out
}

fn cat_bytes(a []u8, b []u8) str {
	mut out = make([]u8, 0, len(a)+len(b))
	for _, x in a {
		out = append(out, x)
	}
	for _, x in b {
		out = append(out, x)
	}
	return str(out)
}

fn auth_data(plugin str, pass str, scramble []u8) []u8 {
	if pass == "" {
		return []u8{}
	}
	if plugin == "mysql_native_password" {
		let h1 = seal.Sha1(pass)
		let h2 = seal.Sha1(str(h1))
		return xor_bytes(h1, seal.Sha1(cat_bytes(scramble, h2)))
	}
	let h1 = seal.Sha256(pass)
	let h2 = seal.Sha256(str(h1))
	return xor_bytes(h1, seal.Sha256(cat_bytes(h2, scramble)))
}

fn send_raw(c i64, data []u8) ! {
	begin_packet(c, c[cSeq])
	put_bytes(c, data)
	try end_packet(c)
	try flush(c)
}

// full_auth sends the password RSA-encrypted with the server's public key, as
// caching_sha2_password does without TLS when the server has no cached entry.
fn full_auth(c i64, rec i64, pass str, scramble []u8) ! {
	if tlsConns[c] != nil {
		// Over TLS the password goes as it is, NUL-terminated (no RSA key needed).
		mut pw = make([]u8, 0, len(pass)+1)
		pw = append(pw, pass...)
		pw = append(pw, 0)
		try send_raw(c, pw)
		return
	}
	mut pem = ""
	if rec[rKeyN] > 0 {
		pem = rec_str(rec, rKey)
	} else {
		try send_raw(c, []u8{2})
		let (p, n) = try read_packet(c)
		if n == 0 || load8(p) != 1 {
			if n > 0 && load8(p) == 0xff {
				fail err_packet(p, n)
			}
			fail "mysql: the server sent no public key"
		}
		pem = rt_str_from_raw(p+1, n-1)
		// Keep it for the next connections (a race only fetches it twice).
		rec[rKey] = keep_raw(pem)
		rec[rKeyN] = len(pem)
	}
	let key = try seal.ParseRSAPublicKeyPEM(pem)
	mut pw = make([]u8, 0, len(pass)+1)
	for i in 0..len(pass) {
		pw = append(pw, pass[i])
	}
	pw = append(pw, 0)
	let enc = try seal.EncryptOAEPSha1(key, xor_bytes(pw, scramble))
	try send_raw(c, enc)
}

// handshake reads the server's greeting, logs in and returns the agreed capabilities.
fn handshake(c i64, rec i64, w wire.Conn) ! {
	let (p, n) = try read_packet(c)
	if n > 0 && load8(p) == 0xff {
		fail err_packet(p, n)
	}
	let k = cur{p: p, at: 0, end: n}
	if k.u8() != 10 {
		fail "mysql: unsupported protocol version"
	}
	_ = k.cstr()
	_ = k.fixed(4)
	mut scramble = []u8(k.bytes(8))
	k.at += 1
	mut caps = k.fixed(2)
	_ = k.u8()
	_ = k.fixed(2)
	caps |= k.fixed(2) << 16
	let alen = k.u8()
	k.at += 10
	mut plugin = "mysql_native_password"
	if caps&capSecureConnection != 0 {
		mut m = alen - 8
		if m < 13 {
			m = 13
		}
		let part = k.bytes(m)
		{
			mut i = 0
			for i < len(part) && i < 12 {
				scramble = append(scramble, part[i])
				i += 1
			}
		}
	}
	if caps&capPluginAuth != 0 {
		plugin = k.cstr()
	}
	if caps&capProtocol41 == 0 {
		fail "mysql: the server is too old (no protocol 4.1)"
	}
	let user = rec_str(rec, rUser)
	let pass = rec_str(rec, rPass)
	let db = rec_str(rec, rDB)
	mut want = capLongPassword | capLongFlag | capProtocol41 | capTransactions | capSecureConnection |
		capMultiResults | capPluginAuth | capPluginAuthLenenc | capDeprecateEOF
	if db != "" {
		want |= capConnectWithDB
	}
	mut use = want & caps
	if rec[rTls] != 0 {
		if caps&capSSL == 0 {
			fail "mysql: the server does not support TLS"
		}
		use |= capSSL
		// SSLRequest: the first 32 bytes of the login packet, then TLS on the same socket.
		begin_packet(c, c[cSeq])
		put_le(c, use, 4)
		put_le(c, 16777216, 4)
		put_u8(c, 45)
		for i in 0..23 {
			put_u8(c, 0)
		}
		try end_packet(c)
		try flush(c)
		let base = cast(tls.Config, rec[rTls])
		mut name = base.ServerName
		if name == "" {
			name = host_of(rec_str(rec, rAddr))
		}
		let cfg = tls.Config{ServerName: name, RootCAs: base.RootCAs, ALPN: base.ALPN, Timeout: rec[rTimeout], InsecureSkipVerify: base.InsecureSkipVerify,
			Certificate: base.Certificate, Key: base.Key}
		let tc = try tls.Client(w, cfg)
		tc.SetTimeout(rec[rTimeout])
		tlsConns[c] = keep(tc)
	}
	c[cCaps] = use
	if plugin != "mysql_native_password" && plugin != "caching_sha2_password" {
		plugin = "caching_sha2_password"
	}
	let data = auth_data(plugin, pass, scramble)
	begin_packet(c, c[cSeq])
	put_le(c, use, 4)
	put_le(c, 16777216, 4)
	put_u8(c, 45)
	put_raw(c, 0, 0)
	for i in 0..23 {
		put_u8(c, 0)
	}
	put_str(c, user)
	put_u8(c, 0)
	if use&capPluginAuthLenenc != 0 {
		put_lenenc(c, len(data))
	} else {
		put_u8(c, len(data))
	}
	put_bytes(c, data)
	if use&capConnectWithDB != 0 {
		put_str(c, db)
		put_u8(c, 0)
	}
	if use&capPluginAuth != 0 {
		put_str(c, plugin)
		put_u8(c, 0)
	}
	try end_packet(c)
	try flush(c)
	for {
		let (q, m) = try read_packet(c)
		if m == 0 {
			fail "mysql: empty packet while logging in"
		}
		let t = load8(q)
		if t == 0 {
			return
		}
		if t == 0xff {
			fail err_packet(q, m)
		}
		if t == 0xfe {
			// Auth switch: another plugin, with a new scramble.
			let ks = cur{p: q, at: 1, end: m}
			plugin = ks.cstr()
			let s = ks.rest()
			scramble = []u8{}
			{
				mut i = 0
				for i < len(s) && i < 20 {
					scramble = append(scramble, s[i])
					i += 1
				}
			}
			if plugin != "mysql_native_password" && plugin != "caching_sha2_password" {
				fail "mysql: unsupported authentication plugin {plugin}"
			}
			try send_raw(c, auth_data(plugin, pass, scramble))
			continue
		}
		if t == 1 && m >= 2 {
			// caching_sha2_password: 3 is "fast auth worked", 4 "send the whole password".
			if load8(q+1) == 3 {
				continue
			}
			if load8(q+1) == 4 {
				try full_auth(c, rec, pass, scramble)
				continue
			}
		}
		fail "mysql: unexpected packet while logging in"
	}
}

// host_of is the host in "host:port" ("[v6]:port" gives v6).
fn host_of(addr str) str {
	mut colon = len(addr)
	for i in 0..len(addr) {
		if addr[i] == ':' {
			colon = i
		}
	}
	mut h = addr[:colon]
	if len(h) >= 2 && h[0] == '[' && h[len(h)-1] == ']' {
		h = h[1 : len(h)-1]
	}
	return h
}

// ---- the pool ----

fn (c Client) pool() i64 {
	if pools == 0 {
		pools = calloc(maxClients+1, 8)
	}
	let id = c.rec[rID]
	mut p = pools[id]
	if p == 0 {
		p = calloc(poolWords, 8)
		p[pIdle] = calloc(pool_cap(c.rec)+1, 8)
		pools[id] = p
	}
	return p
}

// ---- the process-wide cap (Options.MaxTotal) ----
//
// A Client opened in a global's initializer is opened once per core, each with its own record,
// so the cap cannot live in the record. It is a cap record shared by every Client with the same
// address, user, database and MaxTotal: the count of connections of all cores, and the list of
// those that sit idle in some core's pool. A core that finds the cap reached while all its own
// connections are busy (or it has none) takes a slot from that list: it shuts the idle
// connection's socket down and the core that owns it frees the record when it next looks at it.

const kKey = 0
const kKeyN = 1
const kMax = 2
const kTotal = 3 // connections of all cores (atomic)
const kLock = 4
const kIdle = 5 // [kMax] connections idle in some core's pool, 0 for a free place (under kLock)
const capWords = 6

shared mut capLock i64
shared mut capTab i64 // [maxClients]: the cap records, in the order they were first made
shared mut capN i64

// cap_record is the cap record for key, made on first use.
fn cap_record(key str, max i64) i64 {
	for __atomic_swap(&capLock, 1) != 0 {
		__yield()
	}
	if capTab == 0 {
		capTab = calloc(maxClients, 8)
	}
	mut k = 0
	for i in 0..capN {
		let r = capTab[i]
		if rt_str_from_raw(r[kKey], r[kKeyN]) == key {
			k = r
			break
		}
	}
	if k == 0 && capN < maxClients {
		k = calloc(capWords, 8)
		k[kKey] = keep_raw(key)
		k[kKeyN] = len(key)
		k[kMax] = max
		k[kIdle] = calloc(max, 8)
		capTab[capN] = k
		capN += 1
	}
	__atomic_store(&capLock, 0)
	return k
}

fn cap_lock(k i64) {
	for __atomic_swap(k + 8*kLock, 1) != 0 {
		__yield()
	}
}

fn cap_unlock(k i64) {
	__atomic_store(k + 8*kLock, 0)
}

// default_pool is the connections one core may hold when Options.Pool is not set: 64 shared
// among the cores hearth.Run started (a program that never ran it counts as one), at least 2.
fn default_pool() i64 {
	mut n = lifeCores
	if n < 1 {
		n = 1
	}
	if 64/n < 2 {
		return 2
	}
	return 64 / n
}

// pool_cap is the connections one core of the client rec may hold.
fn pool_cap(rec i64) i64 {
	if rec[rPool] > 0 {
		return rec[rPool]
	}
	return default_pool()
}

// reserve takes one of the process's MaxTotal connections for one about to be dialed; false when
// every core together hold them all.
fn reserve(rec i64) bool {
	let k = rec[rCap]
	if k == 0 {
		return true
	}
	for {
		let n = __atomic_load(k + 8*kTotal)
		if n >= k[kMax] {
			return false
		}
		if __atomic_cas(k + 8*kTotal, n, n+1) == n {
			return true
		}
	}
	return false
}

// unreserve gives back what reserve took, for a connection that was closed or never dialed.
fn unreserve(rec i64) {
	let k = rec[rCap]
	if k != 0 {
		__atomic_add(k + 8*kTotal, -1)
	}
}

// idle_add lists conn, just put in this core's idle stack, as one another core may take.
fn idle_add(rec i64, conn i64) {
	let k = rec[rCap]
	if k == 0 {
		return
	}
	cap_lock(k)
	let idle = k[kIdle]
	for i in 0..k[kMax] {
		if idle[i] == 0 {
			idle[i] = conn
			break
		}
	}
	cap_unlock(k)
}

// idle_claim takes conn, just popped from this core's idle stack, off the list; false when
// another core took its slot meanwhile (the socket is shut down: free the record and go on).
fn idle_claim(rec i64, conn i64) bool {
	let k = rec[rCap]
	if k == 0 {
		return true
	}
	cap_lock(k)
	let idle = k[kIdle]
	for i in 0..k[kMax] {
		if idle[i] == conn {
			idle[i] = 0
			break
		}
	}
	let stolen = conn[cStolen]
	cap_unlock(k)
	return stolen == 0
}

// steal_idle takes the slot of a connection idle in some core's pool: it shuts the socket down
// (the server sees the close at once; the owner still holds the record and the descriptor, so
// the descriptor number cannot be reused under it) and gives its place in the count back.
fn steal_idle(rec i64) bool {
	let k = rec[rCap]
	if k == 0 {
		return false
	}
	cap_lock(k)
	let idle = k[kIdle]
	mut took = false
	for i in 0..k[kMax] {
		if idle[i] != 0 {
			let conn = idle[i]
			idle[i] = 0
			conn[cStolen] = 1
			rt_sys_shutdown(conn[cFd], 2)
			__atomic_add(k + 8*kTotal, -1)
			took = true
			break
		}
	}
	cap_unlock(k)
	return took
}

// wait_for_slot parks the task for at most 2 ms (less when its time is nearly up): every
// connection is busy, so it looks again for a place or an idle connection. It returns how the
// wait ended (waitDeadline: the request's deadline or cancel).
fn wait_for_slot(left i64) i64 {
	mut step = 2000000
	if left > 0 && left < step {
		step = left
	}
	return rt_task_park(step)
}

fn conn_free(c i64) {
	delete(tlsConns, c)
	if c[cFd] >= 0 {
		rt_sys_close(c[cFd])
	}
	free(c[cBuf])
	free(c[cOut])
	let st = c[cStmts]
	for i in 0..c[cNStmts] {
		free(st[i*stmtWords])
	}
	free(st)
	free(c)
}

fn dial(rec i64) !i64 {
	let addr = rec_str(rec, rAddr)
	let w = try wire.DialTimeout(addr, rec[rTimeout])
	let c = calloc(connWords, 8)
	c[cFd] = w.Fd()
	c[cCap] = 16384
	c[cBuf] = malloc(c[cCap])
	c[cStmts] = calloc(maxStmts*stmtWords, 8)
	c[cTimeout] = rec[rTimeout]
	let err = handshake(c, rec, w)
	if err != nil {
		conn_free(c)
		fail err
	}
	return c
}

// alive reports whether an idle connection is still open (the server may have closed it:
// a restart, wait_timeout).
fn alive(c i64) bool {
	let tc = tlsConns[c]
	if tc != nil {
		// Records may wait (session tickets): read them; data or an error means not idle.
		let buf = make([]u8, 0, 16)
		let (got, err) = tc.ReadNow(mut buf, 16)
		return err == nil && got == 0
	}
	let b = calloc(1, 8)
	let k = rt_sys_recv(c[cFd], b, 1, 2)
	free(b)
	return k < 0 && (rt_errno() == EAGAIN || rt_errno() == EINTR)
}

fn (c Client) acquire() !i64 {
	if !c.open {
		fail "mysql: the client is not open (too many clients: open one per server, not per request)"
	}
	let p = c.pool()
	mut gaveUp = 0 // when a core waiting at the MaxTotal cap stops looking (Options.Timeout), 0: not yet set
	for {
		for p[pIdleN] > 0 {
			p[pIdleN] -= 1
			let idle = p[pIdle]
			let conn = idle[p[pIdleN]]
			if !idle_claim(c.rec, conn) {
				// Another core took its slot (MaxTotal) and shut it down; the count is already given back.
				conn_free(conn)
				p[pTotal] -= 1
				continue
			}
			if alive(conn) {
				return conn
			}
			conn_free(conn)
			p[pTotal] -= 1
			unreserve(c.rec)
		}
		if p[pTotal] < pool_cap(c.rec) || rt_task_current() == 0 {
			if reserve(c.rec) {
				p[pTotal] += 1
				let (conn, err) = dial(c.rec)
				if err != nil {
					p[pTotal] -= 1
					unreserve(c.rec)
					fail err
				}
				return conn
			}
			// MaxTotal connections exist already, on the other cores: take the slot of one that sits
			// idle. With none, and none of its own to wait for, this core looks again until a
			// connection is released somewhere or its time is up.
			if steal_idle(c.rec) {
				continue
			}
			if rt_task_current() == 0 {
				fail "mysql: MaxTotal connections are in use"
			}
			if p[pTotal] == 0 {
				if gaveUp == 0 && c.rec[rTimeout] > 0 {
					gaveUp = rt_mono_ns() + c.rec[rTimeout]
				}
				if gaveUp > 0 && rt_mono_ns() >= gaveUp {
					fail "mysql: timed out"
				}
				mut left = 0
				if gaveUp > 0 {
					left = gaveUp - rt_mono_ns()
				}
				let r = wait_for_slot(left)
				if r == waitDeadline {
					fail wait_msg(r)
				}
				continue
			}
		}
		// Every connection is busy: wait for one.
		let w = calloc(4, 8)
		w[wTask] = rt_task_current()
		if p[pWaitHead]+p[pWaitN] == p[pWaitCap] {
			if p[pWaitHead] > 0 {
				memmove(p[pWait], p[pWait]+8*p[pWaitHead], 8*p[pWaitN])
				p[pWaitHead] = 0
			} else {
				let cp = p[pWaitCap]*2 + 32
				p[pWait] = realloc(p[pWait], 8*cp)
				p[pWaitCap] = cp
			}
		}
		let q = p[pWait]
		q[p[pWaitHead]+p[pWaitN]] = w
		p[pWaitN] += 1
		let r = rt_task_park(c.rec[rTimeout])
		if w[wDone] == 0 {
			// Timed out: the releaser frees the entry when it reaches it.
			w[wGone] = 1
			fail wait_msg(r)
		}
		let conn = w[wConn]
		free(w)
		if conn != 0 {
			return conn
		}
		// A connection was dropped: there is room to dial again.
	}
}

// next_waiter is the first waiter still waiting, or 0.
fn next_waiter(p i64) i64 {
	for p[pWaitN] > 0 {
		let q = p[pWait]
		let w = q[p[pWaitHead]]
		p[pWaitHead] += 1
		p[pWaitN] -= 1
		if p[pWaitN] == 0 {
			p[pWaitHead] = 0
		}
		if w[wGone] != 0 {
			free(w)
			continue
		}
		return w
	}
	return 0
}

// release returns a connection to the pool; a broken one (ok false) is closed.
fn (c Client) release(conn i64, ok bool) {
	let p = c.pool()
	if !ok {
		conn_free(conn)
		p[pTotal] -= 1
		unreserve(c.rec)
		conn = 0
	}
	let w = next_waiter(p)
	if w != 0 {
		w[wConn] = conn
		w[wDone] = 1
		rt_task_wake(w[wTask])
		return
	}
	if conn != 0 {
		let idle = p[pIdle]
		idle[p[pIdleN]] = conn
		p[pIdleN] += 1
		idle_add(c.rec, conn)
	}
}

// ---- statements ----

// placeholders is the statement text with ? for each value.
fn placeholders(q query) str {
	if len(q.Args) == 0 {
		return q.Parts[0]
	}
	mut n = 0
	for _, s in q.Parts {
		n += len(s) + 1
	}
	mut b = make([]u8, 0, n)
	for i, s in q.Parts {
		for j in 0..len(s) {
			b = append(b, s[j])
		}
		if i < len(q.Args) {
			b = append(b, '?')
		}
	}
	return str(b)
}

fn text_hash(s str) i64 {
	mut h = 1469598103934665603
	for i in 0..len(s) {
		h = (h ^ i64(s[i])) *% 1099511628211
	}
	return h
}

fn eq_raw(p i64, s str) bool {
	for i in 0..len(s) {
		if load8(p+i) != s[i] {
			return false
		}
	}
	return true
}

// skip_until_eof reads n definition packets and, without DEPRECATE_EOF, the EOF after them.
fn skip_defs(c i64, n i64) ! {
	for i in 0..n {
		_, _ = try read_packet(c)
	}
	if n > 0 && c[cCaps]&capDeprecateEOF == 0 {
		_, _ = try read_packet(c)
	}
}

// prepare returns the cached statement for text, preparing it on first use: [id, params].
fn prepare(c i64, text str) !(i64, i64) {
	let h = text_hash(text)
	let st = c[cStmts]
	for i in 0..c[cNStmts] {
		let e = st + 8*stmtWords*i
		if e[2] == h && e[1] == len(text) && eq_raw(e[0], text) {
			return e[3], e[4]
		}
	}
	if c[cNStmts] == maxStmts {
		for i in 0..maxStmts {
			let e = st + 8*stmtWords*i
			begin_packet(c, 0)
			put_u8(c, 0x19)
			put_le(c, e[3], 4)
			try end_packet(c)
			free(e[0])
		}
		try flush(c)
		c[cNStmts] = 0
	}
	begin_packet(c, 0)
	put_u8(c, 0x16)
	put_str(c, text)
	try end_packet(c)
	try flush(c)
	let (p, n) = try read_packet(c)
	if n > 0 && load8(p) == 0xff {
		fail err_packet(p, n)
	}
	let k = cur{p: p, at: 1, end: n}
	let id = k.fixed(4)
	let cols = k.fixed(2)
	let params = k.fixed(2)
	try skip_defs(c, params)
	try skip_defs(c, cols)
	let e = st + 8*stmtWords*c[cNStmts]
	e[0] = keep_raw(text)
	e[1] = len(text)
	e[2] = h
	e[3] = id
	e[4] = params
	c[cNStmts] += 1
	return id, params
}

fn f32_from_bits(b i64) f64 {
	let sign = (b >> 31) & 1
	mut exp = (b >> 23) & 0xff
	let frac = b & 0x7fffff
	if exp == 0 {
		let v = f64(frac) / 8388608.0 / gauge.Pow(2.0, 126.0)
		if sign == 1 {
			return -v
		}
		return v
	}
	if exp == 255 {
		exp = 2047
	} else {
		exp = exp - 127 + 1023
	}
	return gauge.F64frombits(u64(sign<<63 | exp<<52 | frac<<29))
}

fn pad2(v i64) str {
	if v < 10 {
		return "0{v}"
	}
	return "{v}"
}

fn pad4(v i64) str {
	mut s = "{v}"
	for len(s) < 4 {
		s = "0" + s
	}
	return s
}

fn micros(v i64) str {
	mut s = "{v}"
	for len(s) < 6 {
		s = "0" + s
	}
	return "." + s
}

// binary_value reads one value of a binary row for a column of type t.
fn binary_value(k mut cur, t i64, flags i64) Value {
	let unsigned = flags&flagUnsigned != 0
	if t == 0x01 {
		mut v = k.fixed(1)
		if !unsigned && v >= 128 {
			v -= 256
		}
		return Value.Int(v)
	}
	if t == 0x02 || t == 0x0d {
		mut v = k.fixed(2)
		if !unsigned && t == 0x02 && v >= 32768 {
			v -= 65536
		}
		return Value.Int(v)
	}
	if t == 0x03 || t == 0x09 {
		mut v = k.fixed(4)
		if !unsigned && v >= 2147483648 {
			v -= 4294967296
		}
		return Value.Int(v)
	}
	if t == 0x08 {
		return Value.Int(k.fixed(8))
	}
	if t == 0x04 {
		return Value.Float(f32_from_bits(k.fixed(4)))
	}
	if t == 0x05 {
		return Value.Float(gauge.F64frombits(u64(k.fixed(8))))
	}
	if t == 0x07 || t == 0x0a || t == 0x0c {
		let n = k.u8()
		mut y = 0
		mut mo = 0
		mut d = 0
		mut h = 0
		mut mi = 0
		mut s = 0
		mut us = 0
		if n >= 4 {
			y = k.fixed(2)
			mo = k.u8()
			d = k.u8()
		}
		if n >= 7 {
			h = k.u8()
			mi = k.u8()
			s = k.u8()
		}
		if n >= 11 {
			us = k.fixed(4)
		}
		let date = "{pad4(y)}-{pad2(mo)}-{pad2(d)}"
		if t == 0x0a {
			return Value.Text(date)
		}
		mut out = "{date} {pad2(h)}:{pad2(mi)}:{pad2(s)}"
		if us != 0 {
			out = out + micros(us)
		}
		return Value.Text(out)
	}
	if t == 0x0b {
		let n = k.u8()
		mut neg = false
		mut days = 0
		mut h = 0
		mut mi = 0
		mut s = 0
		mut us = 0
		if n >= 8 {
			neg = k.u8() == 1
			days = k.fixed(4)
			h = k.u8()
			mi = k.u8()
			s = k.u8()
		}
		if n >= 12 {
			us = k.fixed(4)
		}
		mut out = "{pad2(days*24+h)}:{pad2(mi)}:{pad2(s)}"
		if us != 0 {
			out = out + micros(us)
		}
		if neg {
			out = "-" + out
		}
		return Value.Text(out)
	}
	return Value.Text(k.lenstr())
}

// text_value converts a text-protocol column of type t.
fn text_value(s str, t i64) Value {
	if t == 0x01 || t == 0x02 || t == 0x03 || t == 0x08 || t == 0x09 || t == 0x0d {
		let n = mint.ParseInt(s, 10) catch _ {
			let u = mint.ParseUint(s, 10) catch _ { u64(0) }
			i64(u)
		}
		return Value.Int(n)
	}
	if t == 0x04 || t == 0x05 {
		let f = mint.ParseFloat(s) catch _ { 0.0 }
		return Value.Float(f)
	}
	return Value.Text(s)
}

// ok_result reads an OK packet; it returns the result and the status flags.
fn ok_result(p i64, n i64) (Result, i64) {
	let k = cur{p: p, at: 1, end: n}
	let aff = k.lenenc()
	let last = k.lenenc()
	let status = k.fixed(2)
	return Result{Affected: aff, LastID: last}, status
}

fn is_end(p i64, n i64) bool {
	return n > 0 && n < 0xffffff && load8(p) == 0xfe
}

fn end_status(c i64, p i64, n i64) i64 {
	if c[cCaps]&capDeprecateEOF != 0 {
		let (_, st) = ok_result(p, n)
		return st
	}
	let k = cur{p: p, at: 3, end: n}
	return k.fixed(2)
}

// read_result reads a statement's response: rows (binary or text), or an OK.
fn read_result(c i64, binary bool) !(Rows, Result) {
	mut rows = Rows{Columns: []str{}, Rows: [][]Value{}}
	mut res = Result{Affected: 0, LastID: 0}
	mut first = true
	for {
		let (p, n) = try read_packet(c)
		if n == 0 {
			fail "mysql: empty response"
		}
		let t = load8(p)
		if t == 0xff {
			fail err_packet(p, n)
		}
		mut status = 0
		if t == 0 {
			let (r, st) = ok_result(p, n)
			if first {
				res = r
			}
			status = st
		} else {
			let k = cur{p: p, at: 0, end: n}
			let ncols = k.lenenc()
			let types = make([]i64, ncols)
			let flags = make([]i64, ncols)
			mut names = make([]str, 0, ncols)
			for i in 0..ncols {
				let (q, m) = try read_packet(c)
				let d = cur{p: q, at: 0, end: m}
				for j in 0..4 {
					_ = d.lenstr()
				}
				names = append(names, d.lenstr())
				_ = d.lenstr()
				_ = d.lenenc()
				_ = d.fixed(2)
				_ = d.fixed(4)
				types[i] = d.u8()
				flags[i] = d.fixed(2)
			}
			if c[cCaps]&capDeprecateEOF == 0 {
				_, _ = try read_packet(c)
			}
			mut out = [][]Value{}
			for {
				let (q, m) = try read_packet(c)
				if m > 0 && load8(q) == 0xff {
					fail err_packet(q, m)
				}
				if is_end(q, m) {
					status = end_status(c, q, m)
					break
				}
				mut row = make([]Value, 0, ncols)
				if binary {
					let d = cur{p: q, at: 1, end: m}
					let nb = (ncols + 9) / 8
					let bm = q + 1
					d.at = 1 + nb
					for i in 0..ncols {
						let bit = i + 2
						if (i64(load8(bm+bit/8))>>(bit%8))&1 == 1 {
							row = append(row, Value.Null)
							continue
						}
						row = append(row, binary_value(mut d, types[i], flags[i]))
					}
				} else {
					let d = cur{p: q, at: 0, end: m}
					for i in 0..ncols {
						let ln = d.lenenc()
						if ln < 0 {
							row = append(row, Value.Null)
							continue
						}
						row = append(row, text_value(d.bytes(ln), types[i]))
					}
				}
				out = append(out, row)
			}
			if first {
				rows = Rows{Columns: names, Rows: out}
			}
		}
		first = false
		if status&moreResults == 0 {
			return rows, res
		}
	}
}

// run sends q on connection conn and reads its response.
fn run(conn i64, q query) !(Rows, Result) {
	if len(q.Args) == 0 {
		begin_packet(conn, 0)
		put_u8(conn, 0x03)
		put_str(conn, q.Parts[0])
		try end_packet(conn)
		try flush(conn)
		return try read_result(conn, false)
	}
	let text = placeholders(q)
	let (id, params) = try prepare(conn, text)
	if params != len(q.Args) {
		fail "mysql: the statement has {params} placeholders but the query {len(q.Args)} values"
	}
	begin_packet(conn, 0)
	put_u8(conn, 0x17)
	put_le(conn, id, 4)
	put_u8(conn, 0)
	put_le(conn, 1, 4)
	let nb = (params + 7) / 8
	for i in 0..nb {
		put_u8(conn, 0)
	}
	put_u8(conn, 1)
	for _, a in q.Args {
		match a {
			Int(_) => {
				put_le(conn, 0x08, 2)
			}
			Float(_) => {
				put_le(conn, 0x05, 2)
			}
			Str(_) => {
				put_le(conn, 0xfe, 2)
			}
			Bool(_) => {
				put_le(conn, 0x01, 2)
			}
			Bytes(_) => {
				put_le(conn, 0xfc, 2)
			}
		}
	}
	for _, a in q.Args {
		match a {
			Int(v) => {
				put_le(conn, v, 8)
			}
			Float(v) => {
				put_le(conn, i64(gauge.F64bits(v)), 8)
			}
			Str(v) => {
				put_lenenc(conn, len(v))
				put_str(conn, v)
			}
			Bool(v) => {
				if v {
					put_u8(conn, 1)
				} else {
					put_u8(conn, 0)
				}
			}
			Bytes(v) => {
				put_lenenc(conn, len(v))
				put_bytes(conn, v)
			}
		}
	}
	try end_packet(conn)
	try flush(conn)
	return try read_result(conn, true)
}

// Server errors leave a connection usable; I/O errors and timeouts do not.
fn usable(err fault) bool {
	let m = say.Str(err)
	return len(m) > 13 && m[:13] == "mysql: Error "
}

fn (c Client) exec(q query) !(Rows, Result) {
	let conn = try c.acquire()
	let (rows, res, err) = run(conn, q)
	if err != nil {
		c.release(conn, usable(err))
		fail err
	}
	c.release(conn, true)
	return rows, res
}

// Query runs a statement and returns its rows.
fn (c Client) Query(q query) !Rows {
	let tp = rt_tape()
	if tp != 0 {
		let (rows, _) = try c.exec_taped(tp, "Q ", q) // recorded for replay (#241)
		return rows
	}
	let (rows, _) = try c.exec(q)
	return rows
}

// Exec runs a statement and returns what it changed.
fn (c Client) Exec(q query) !Result {
	let tp = rt_tape()
	if tp != 0 {
		let (_, res) = try c.exec_taped(tp, "E ", q) // recorded for replay (#241)
		return res
	}
	let (_, res) = try c.exec(q)
	return res
}

// Ping checks that the server answers.
fn (c Client) Ping() ! {
	_ = try c.Exec("DO 1")
}

// Begin starts a transaction; finish it with Commit or Rollback, or its connection stays
// out of the pool.
fn (c Client) Begin() !Tx {
	let tp = rt_tape()
	if tp != 0 {
		return try c.begin_taped(tp) // recorded for replay (#241)
	}
	let conn = try c.acquire()
	let (_, _, err) = run(conn, "BEGIN")
	if err != nil {
		c.release(conn, usable(err))
		fail err
	}
	return Tx{open: true, c: c, conn: conn}
}

fn (t mut Tx) run(q query) !(Rows, Result) {
	if !t.open {
		fail "mysql: the transaction is finished"
	}
	let (rows, res, err) = run(t.conn, q)
	if err != nil {
		if !usable(err) {
			t.c.release(t.conn, false)
			t.open = false
		}
		fail err
	}
	return rows, res
}

// Query runs a statement in the transaction and returns its rows.
fn (t mut Tx) Query(q query) !Rows {
	let tp = rt_tape()
	if tp != 0 {
		let (rows, _) = try t.run_taped(tp, "Q ", q) // recorded for replay (#241)
		return rows
	}
	let (rows, _) = try t.run(q)
	return rows
}

// Exec runs a statement in the transaction.
fn (t mut Tx) Exec(q query) !Result {
	let tp = rt_tape()
	if tp != 0 {
		let (_, res) = try t.run_taped(tp, "E ", q) // recorded for replay (#241)
		return res
	}
	let (_, res) = try t.run(q)
	return res
}

fn (t mut Tx) finish(q query) ! {
	_, _ = try t.run(q)
	t.c.release(t.conn, true)
	t.open = false
}

// Commit makes the transaction's changes permanent.
fn (t mut Tx) Commit() ! {
	let tp = rt_tape()
	if tp != 0 {
		return try t.finish_taped(tp, "commit", commit_live) // recorded for replay (#241)
	}
	return try t.finish("COMMIT")
}

// Rollback undoes the transaction's changes.
fn (t mut Tx) Rollback() ! {
	let tp = rt_tape()
	if tp != 0 {
		return try t.finish_taped(tp, "rollback", rollback_live) // recorded for replay (#241)
	}
	return try t.finish("ROLLBACK")
}

// ---- recording and replay (notes/interface_replay.md, section 4; #241) ----

// An effect's body runs at once, before it waits: these hand it its arguments.
mut tapedClient i64
mut tapedQuery i64
mut tapedTx i64

// exec_taped records or replays one statement as mysql@1 (kind "Q " or "E ", then the query).
fn (c Client) exec_taped(tp i64, kind str, q query) !(Rows, Result) {
	tapedClient = cast(i64, c)
	tapedQuery = cast(i64, q)
	let v = try rt_effect(tp, "mysql@1", rt_query_key(kind, q), exec_live)
	return try untape(v)
}

fn exec_live() !str {
	let c = cast(Client, tapedClient)
	let (rows, res) = try c.exec(cast(query, tapedQuery))
	return entape(rows, res)
}

// entape is a statement's outcome as a tape holds it: the columns, the rows (each value a tag,
// 0 null, 1 int, 2 float, 3 text, and its payload), then the Result.
fn entape(rows Rows, res Result) str {
	mut b = make([]u8, 0, 256)
	b = tput(b, len(rows.Columns))
	for _, col in rows.Columns {
		b = tput_str(b, col)
	}
	b = tput(b, len(rows.Rows))
	for _, row in rows.Rows {
		b = tput(b, len(row))
		for _, v in row {
			match v {
				Null => {
					b = tput(b, 0)
				}
				Int(x) => {
					b = tput(b, 1)
					b = tput(b, x)
				}
				Float(x) => {
					b = tput(b, 2)
					b = tput(b, i64(gauge.F64bits(x)))
				}
				Text(x) => {
					b = tput(b, 3)
					b = tput_str(b, x)
				}
			}
		}
	}
	b = tput(b, res.Affected)
	b = tput(b, res.LastID)
	return str(b)
}

// untape is entape's outcome again.
fn untape(v str) !(Rows, Result) {
	let k = tcur{s: v, pos: 0, bad: false}
	mut cols = make([]str, 0, 8)
	let nc = k.word()
	{
		mut i = 0
		for i < nc && !k.bad {
			cols = append(cols, k.text())
			i += 1
		}
	}
	mut all = make([][]Value, 0, 8)
	let nr = k.word()
	{
		mut i = 0
		for i < nr && !k.bad {
			mut row = make([]Value, 0, 8)
			let n = k.word()
			{
			mut j = 0
			for j < n && !k.bad {
					let t = k.word()
					if t == 0 {
						row = append(row, Value.Null)
					} else if t == 1 {
						row = append(row, Value.Int(k.word()))
					} else if t == 2 {
						row = append(row, Value.Float(gauge.F64frombits(u64(k.word()))))
					} else if t == 3 {
						row = append(row, Value.Text(k.text()))
					} else {
						k.bad = true
					}
					j += 1
			}
		}
			all = append(all, row)
			i += 1
		}
	}
	let res = Result{Affected: k.word(), LastID: 0}
	res.LastID = k.word()
	if k.bad || k.pos != len(v) {
		fail "replay: mysql@1 result is damaged"
	}
	return Rows{Columns: cols, Rows: all}, res
}

// tcur reads words and strings off a recorded result; bad once it ran past the end.
type tcur struct {
	s   str
	pos i64
	bad bool
}

fn (k mut tcur) word() i64 {
	if k.pos+8 > len(k.s) {
		k.bad = true
		return 0
	}
	mut v = 0
	{
		mut i = 7
		for i >= 0 {
			v = v<<8 | i64(k.s[k.pos+i])
			i -= 1
		}
	}
	k.pos += 8
	return v
}

fn (k mut tcur) text() str {
	let n = k.word()
	if n < 0 || k.pos+n > len(k.s) {
		k.bad = true
		return ""
	}
	let s = k.s[k.pos : k.pos+n]
	k.pos += n
	return s
}

fn tput(b []u8, v i64) []u8 {
	for i in 0..8 {
		b = append(b, u8(v >> (8 * i)))
	}
	return b
}

fn tput_str(b []u8, s str) []u8 {
	b = tput(b, len(s))
	b = append(b, s...)
	return b
}

// begin_taped records or replays Begin as mysql.tx@1 "begin"; replaying, the Tx has no
// connection and its statements come from the tape.
fn (c Client) begin_taped(tp i64) !Tx {
	tapedClient = cast(i64, c)
	tapedTx = 0
	_ = try rt_effect(tp, "mysql.tx@1", "begin", begin_live)
	if tapedTx != 0 {
		let t = cast(Tx, tapedTx)
		tapedTx = 0
		return t
	}
	return Tx{open: true, c: c, conn: 0}
}

fn begin_live() !str {
	let c = cast(Client, tapedClient)
	let t = try c.Begin()
	tapedTx = cast(i64, t)
	return ""
}

// run_taped records or replays a statement of the transaction as mysql@1.
fn (t mut Tx) run_taped(tp i64, kind str, q query) !(Rows, Result) {
	if !t.open {
		fail "mysql: the transaction is finished"
	}
	tapedTx = cast(i64, t)
	tapedQuery = cast(i64, q)
	let (v, err) = rt_effect(tp, "mysql@1", rt_query_key(kind, q), txrun_live)
	if err != nil {
		if !usable(err) {
			t.open = false
		}
		fail err
	}
	return try untape(v)
}

fn txrun_live() !str {
	let t = cast(Tx, tapedTx)
	let (rows, res) = try t.run(cast(query, tapedQuery))
	return entape(rows, res)
}

// finish_taped records or replays Commit or Rollback as mysql.tx@1.
fn (t mut Tx) finish_taped(tp i64, what str, live fn() !str) ! {
	tapedTx = cast(i64, t)
	let (_, err) = rt_effect(tp, "mysql.tx@1", what, live)
	if err == nil || !usable(err) {
		t.open = false
	}
	if err != nil {
		fail err
	}
}

fn commit_live() !str {
	let t = cast(Tx, tapedTx)
	try t.finish("COMMIT")
	return ""
}

fn rollback_live() !str {
	let t = cast(Tx, tapedTx)
	try t.finish("ROLLBACK")
	return ""
}
