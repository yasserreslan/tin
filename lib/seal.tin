// Package seal has cryptographic hashes (SHA-256, SHA-1), HMAC-SHA256, constant-time
// comparison, secure random bytes, and the hex and base64 encodings.
package seal

import "say"


var k256 []u32 = []u32{
	0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
	0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
	0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
	0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
	0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
	0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
	0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
	0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
}

func rotr(x u32, n u32) u32 {
	return (x >> n) | (x << (32 - n))
}

func rotl(x u32, n u32) u32 {
	return (x << n) | (x >> (32 - n))
}

func be32(p i64) u32 {
	return u32(load8(p))<<24 | u32(load8(p+1))<<16 | u32(load8(p+2))<<8 | u32(load8(p+3))
}

// pad returns the message's tail blocks: the last partial block, 0x80, zeros, bit length.
func pad(s str, full i64) []u8 {
	n := len(s)
	rest := n - full
	total := 64
	if rest >= 56 {
		total = 128
	}
	b := make([]u8, total)
	for i := 0; i < rest; i++ {
		b[i] = s[full+i]
	}
	b[rest] = 0x80
	bitlen := u64(n) * 8
	for i := 0; i < 8; i++ {
		b[total-1-i] = u8(bitlen >> u64(8*i))
	}
	return b
}

func sha256_blocks(h mut []u32, w mut []u32, p i64, nblocks i64) {
	for blk := 0; blk < nblocks; blk++ {
		q := p + blk*64
		for i := 0; i < 16; i++ {
			w[i] = be32(q + 4*i)
		}
		for i := 16; i < 64; i++ {
			a := w[i-15]
			b := w[i-2]
			s0 := rotr(a, 7) ^ rotr(a, 18) ^ (a >> 3)
			s1 := rotr(b, 17) ^ rotr(b, 19) ^ (b >> 10)
			w[i] = w[i-16] + s0 + w[i-7] + s1
		}
		a := h[0]
		b := h[1]
		c := h[2]
		d := h[3]
		e := h[4]
		f := h[5]
		g := h[6]
		hh := h[7]
		for i := 0; i < 64; i++ {
			s1 := rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
			ch := (e & f) ^ (^e & g)
			t1 := hh + s1 + ch + k256[i] + w[i]
			s0 := rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
			maj := (a & b) ^ (a & c) ^ (b & c)
			t2 := s0 + maj
			hh = g
			g = f
			f = e
			e = d + t1
			d = c
			c = b
			b = a
			a = t1 + t2
		}
		h[0] += a
		h[1] += b
		h[2] += c
		h[3] += d
		h[4] += e
		h[5] += f
		h[6] += g
		h[7] += hh
	}
}

func digest(h []u32) []u8 {
	out := make([]u8, 0, 4*len(h))
	for _, x := range h {
		out = append(out, u8(x>>24), u8(x>>16), u8(x>>8), u8(x))
	}
	return out
}

// hw_blocks compresses n >= 1 blocks at data into state with the CPU's SHA-256
// instructions; the compiler replaces this body with hand-assembled code.
func hw_blocks(state i64, data i64, n i64, k i64) {
	rt_panic("seal: hardware SHA-256 is not available for this target")
}

// Sha256 is the SHA-256 digest of s (32 bytes).
func Sha256(s str) []u8 {
	// The hardware path exists only on arm64 CPUs with the SHA-256 instructions (seal_<os>.tin).
	if !hw_sha256() {
		return Sha256Soft(s)
	}
	h := []u32{0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19}
	hp := cast(i64, h)[2]
	kp := cast(i64, k256)[2]
	full := len(s) / 64 * 64
	if full > 0 {
		hw_blocks(hp, cast(i64, s)+8, full/64, kp)
	}
	tail := pad(s, full)
	hw_blocks(hp, cast(i64, tail)[2], len(tail)/64, kp)
	return digest(h)
}

// Sha256Soft is SHA-256 in portable code (the reference the hardware path is tested against).
func Sha256Soft(s str) []u8 {
	h := []u32{0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19}
	w := make([]u32, 64)
	full := len(s) / 64 * 64
	sha256_blocks(h, w, cast(i64, s)+8, full/64)
	tail := pad(s, full)
	sha256_blocks(h, w, cast(i64, tail)[2], len(tail)/64)
	return digest(h)
}

// Sha256Hex is the SHA-256 digest of s in lower-case hex.
func Sha256Hex(s str) str {
	return Hex(Sha256(s))
}

// Sha1 is the SHA-1 digest of s (20 bytes); use it only where a protocol requires it.
func Sha1(s str) []u8 {
	h := []u32{0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476, 0xc3d2e1f0}
	w := make([]u32, 80)
	full := len(s) / 64 * 64
	sha1_blocks(h, w, cast(i64, s)+8, full/64)
	tail := pad(s, full)
	sha1_blocks(h, w, cast(i64, tail)[2], len(tail)/64)
	return digest(h)
}

func sha1_blocks(h mut []u32, w mut []u32, p i64, nblocks i64) {
	for blk := 0; blk < nblocks; blk++ {
		q := p + blk*64
		for i := 0; i < 16; i++ {
			w[i] = be32(q + 4*i)
		}
		for i := 16; i < 80; i++ {
			w[i] = rotl(w[i-3]^w[i-8]^w[i-14]^w[i-16], 1)
		}
		a := h[0]
		b := h[1]
		c := h[2]
		d := h[3]
		e := h[4]
		for i := 0; i < 80; i++ {
			f := u32(0)
			k := u32(0)
			if i < 20 {
				f = (b & c) | (^b & d)
				k = 0x5a827999
			} else if i < 40 {
				f = b ^ c ^ d
				k = 0x6ed9eba1
			} else if i < 60 {
				f = (b & c) | (b & d) | (c & d)
				k = 0x8f1bbcdc
			} else {
				f = b ^ c ^ d
				k = 0xca62c1d6
			}
			t := rotl(a, 5) + f + e + k + w[i]
			e = d
			d = c
			c = rotl(b, 30)
			b = a
			a = t
		}
		h[0] += a
		h[1] += b
		h[2] += c
		h[3] += d
		h[4] += e
	}
}

// HmacSha256 is the HMAC-SHA256 of msg under key (32 bytes).
func HmacSha256(key str, msg str) []u8 {
	k := []u8(key)
	if len(k) > 64 {
		k = Sha256(key)
	}
	ipad := make([]u8, 64, 64+len(msg))
	opad := make([]u8, 64, 96)
	for i := 0; i < 64; i++ {
		x := u8(0)
		if i < len(k) {
			x = k[i]
		}
		ipad[i] = x ^ 0x36
		opad[i] = x ^ 0x5c
	}
	ipad = append(ipad, msg...)
	inner := Sha256(str(ipad))
	opad = append(opad, inner...)
	return Sha256(str(opad))
}

// ConstantTimeEq compares a and b in time that depends only on their lengths.
func ConstantTimeEq(a []u8, b []u8) bool {
	if len(a) != len(b) {
		return false
	}
	v := u8(0)
	for i := 0; i < len(a); i++ {
		v |= a[i] ^ b[i]
	}
	return v == 0
}

// RandomBytes returns n cryptographically secure random bytes.
func RandomBytes(n i64) []u8 {
	b := make([]u8, n)
	if n > 0 {
		rt_random(cast(i64, b)[2], n)
	}
	return b
}

const hexDigits = "0123456789abcdef"

// Hex encodes b in lower-case hexadecimal.
func Hex(b []u8) str {
	out := make([]u8, 0, 2*len(b))
	for _, c := range b {
		out = append(out, hexDigits[i64(c>>4)], hexDigits[i64(c&15)])
	}
	return str(out)
}

func unhex(c u8) i64 {
	if c >= '0' && c <= '9' {
		return i64(c - '0')
	}
	if c >= 'a' && c <= 'f' {
		return i64(c-'a') + 10
	}
	if c >= 'A' && c <= 'F' {
		return i64(c-'A') + 10
	}
	return -1
}

// HexDecode decodes hexadecimal text.
func HexDecode(s str) ![]u8 {
	if len(s)%2 != 0 {
		fail "seal: odd length hex string"
	}
	out := make([]u8, 0, len(s)/2)
	for i := 0; i < len(s); i += 2 {
		a := unhex(s[i])
		b := unhex(s[i+1])
		if a < 0 || b < 0 {
			fail say.Fault("seal: invalid hex byte at offset %d", i)
		}
		out = append(out, u8(a*16+b))
	}
	return out
}

const b64std = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
const b64url = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

func b64enc(b []u8, alphabet str, padded bool) str {
	out := make([]u8, 0, (len(b)+2)/3*4)
	i := 0
	for i+3 <= len(b) {
		v := i64(b[i])<<16 | i64(b[i+1])<<8 | i64(b[i+2])
		out = append(out, alphabet[v>>18], alphabet[(v>>12)&63], alphabet[(v>>6)&63], alphabet[v&63])
		i += 3
	}
	rest := len(b) - i
	if rest == 1 {
		v := i64(b[i]) << 16
		out = append(out, alphabet[v>>18], alphabet[(v>>12)&63])
		if padded {
			out = append(out, '=', '=')
		}
	} else if rest == 2 {
		v := i64(b[i])<<16 | i64(b[i+1])<<8
		out = append(out, alphabet[v>>18], alphabet[(v>>12)&63], alphabet[(v>>6)&63])
		if padded {
			out = append(out, '=')
		}
	}
	return str(out)
}

func b64val(c u8, url bool) i64 {
	if c >= 'A' && c <= 'Z' {
		return i64(c - 'A')
	}
	if c >= 'a' && c <= 'z' {
		return i64(c-'a') + 26
	}
	if c >= '0' && c <= '9' {
		return i64(c-'0') + 52
	}
	if (c == '+' && !url) || (c == '-' && url) {
		return 62
	}
	if (c == '/' && !url) || (c == '_' && url) {
		return 63
	}
	return -1
}

func b64dec(s str, url bool, padded bool) ![]u8 {
	n := len(s)
	if padded {
		if n%4 != 0 {
			fail "seal: base64 length is not a multiple of 4"
		}
		for n > 0 && s[n-1] == '=' && len(s)-n < 2 {
			n--
		}
	} else if n%4 == 1 {
		fail "seal: illegal base64 length"
	}
	out := make([]u8, 0, n*3/4)
	acc := 0
	bitsn := 0
	for i := 0; i < n; i++ {
		v := b64val(s[i], url)
		if v < 0 {
			fail say.Fault("seal: illegal base64 data at input byte %d", i)
		}
		acc = acc<<6 | v
		bitsn += 6
		if bitsn >= 8 {
			bitsn -= 8
			out = append(out, u8(acc>>bitsn))
		}
	}
	// Unused low bits must be zero, as Go's strict decoding requires.
	if acc&((1<<bitsn)-1) != 0 {
		fail "seal: base64 has non-zero trailing bits"
	}
	return out
}

// B64 encodes b as standard padded base64.
func B64(b []u8) str {
	return b64enc(b, b64std, true)
}

// B64Decode decodes standard padded base64.
func B64Decode(s str) ![]u8 {
	return try b64dec(s, false, true)
}

// B64URL encodes b as unpadded URL-safe base64 (as in JWTs).
func B64URL(b []u8) str {
	return b64enc(b, b64url, false)
}

// B64URLDecode decodes unpadded URL-safe base64.
func B64URLDecode(s str) ![]u8 {
	return try b64dec(s, true, false)
}
