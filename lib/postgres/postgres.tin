// Package postgres is a PostgreSQL protocol 3.0 client over TCP. Query interpolation
// binds binary parameters as $1, $2, ...; a plain str cannot be used as SQL. Connections
// are pooled per core (Options.Pool, default max(2, 64/cores); Options.MaxTotal caps them for the
// process) and waiting request tasks park without blocking it.
// Authentication supports SCRAM-SHA-256, MD5 and cleartext. Options.SSLMode turns on TLS 1.3
// (SSLRequest): "require" encrypts, "verify-full" (the default when Options.TLS is set) also
// checks the server's certificate and name.
//
// Sizing: a Client opened in a global's initializer is opened on every core, so a 32-core pod
// with Pool 16 may open 512 connections to one server, and a fleet of pods multiplies that.
// Pool, when not set, is max(2, 64/cores) per core: about 64 for the process, at least 2 on
// each core. Options.MaxTotal caps the connections of the whole process, over all cores (Clients
// with the same address, user, database and MaxTotal share one cap): a core at the cap waits,
// within the request's deadline and Options.Timeout, until a connection is released or a core
// that has one idle gives up its slot. Set MaxTotal to at least the number of cores that serve
// database requests; below that, cores share connections by closing and dialing again.
//
//	let pw = quarry.Getenv("POSTGRES_PASSWORD")
//	let name = "ana"
//	let db = postgres.Open(postgres.Options{Addr: "127.0.0.1:5432", User: "app", Password: pw, Database: "shop"})
//	let rows = try db.Query("INSERT INTO users(name) VALUES ({name}) RETURNING id")
//	let id = rows.Rows[0][0].Int()
package postgres

import "gauge"
import "mint"
import "postgres/md5"
import "postgres/sasl"
import "seal"
import "tls"
import "wire"


// Value is one column of a row.
type Value enum {
	Null
	Int(v i64)   // integer columns and booleans (0 or 1)
	Float(v f64) // real and double precision
	Text(v str)  // everything else: strings, blobs, numeric, JSON, bytea, dates and times as text
}

// Rows is a query's result.
type Rows struct {
	Columns []str
	Rows    [][]Value
}

// Result is what a statement without rows did.
type Result struct {
	Affected i64
}

// Options says where and how to connect.
type Options struct {
	Addr     str // "host:port" (default "127.0.0.1:5432")
	User     str
	Password str
	Database str
	Pool     i64 // connections per core (default max(2, 64/cores))
	MaxTotal i64 // connections for the whole process, over all cores (0: no cap)
	Timeout  i64 // ns for acquisition, login, preparation and execution (0: no limit)
	SSLMode  str // "disable", "require" (TLS without checking the certificate) or "verify-full"; "" is disable, or verify-full when TLS is set
	TLS      ?tls.Config // roots, server name and the like for TLS 1.3 (the server name is Addr's host unless set)
}

// Client runs statements on one PostgreSQL server. Open it in a global's initializer (which
// runs on every core) or once in main, not per request.
type Client struct {
	open bool // false for the zero Client
	rec  i64
}

// Tx is a transaction: its statements run on one connection until Commit or Rollback.
type Tx struct {
	state i64 // caller-owned [connection, Client record, active]; shared by copies
}

const maxClients = 1024

// The shared record of a Client.
const rAddr = 0
const rAddrN = 1
const rUser = 2
const rUserN = 3
const rPass = 4
const rPassN = 5
const rDB = 6
const rDBN = 7
const rPool = 8
const rTimeout = 9
const rID = 10
const rTls = 11 // the kept tls.Config for this client's sslmode, or 0 for plain TCP
const rCap = 12 // the cap record of Options.MaxTotal (see cap_record), 0: no cap
const recWords = 13

// A core's pool for one Client.
const pIdle = 0 // a stack of idle connections
const pIdleN = 1
const pTotal = 2
const pWait = 3 // waiters, in order
const pWaitHead = 4
const pWaitN = 5
const pWaitCap = 6
const poolWords = 7

// A waiter: [task, connection handed over, gone, done].
const wTask = 0
const wConn = 1
const wGone = 2
const wDone = 3

// A connection.
const cFd = 0
const cBuf = 1 // bytes read: packets from cS to cE
const cS = 2
const cE = 3
const cCap = 4
const cNext = 5 // where the packet returned last ends
const cOut = 6
const cOutN = 7
const cOutCap = 8
const cKind = 9
const cSynced = 10 // set only after ReadyForQuery
const cStmts = 11 // cached SQL, parameter signature and statement name
const cNStmts = 12
const cPkt = 13 // the start of the packet being written
const cUntil = 14 // absolute operation timeout
const cStatus = 15 // I (idle), T (transaction), E (failed transaction)
const cSerial = 16
const cPID = 17
const cKey = 18
const cParsed = 19
const cStolen = 20 // another core took this idle connection's slot (MaxTotal): free it, do not use it
const connWords = 21

const stmtWords = 5 // [SQL ptr, len, signature ptr, len, name serial]
const maxStmts = 256

shared mut nClients i64
mut pools i64 // per core: the pool of each Client, by id

// tlsConns holds the TLS layer of this core's connections, by connection record. Removing
// one releases its memory (counted long-lived memory, from keep).
let tlsConns = make(map[i64]?tls.Conn)

fn keep_raw(s str) i64 {
	let p = malloc(len(s) + 1)
	memcpy(p, cast(i64, s)+8, len(s))
	return p
}

fn rec_str(rec i64, at i64) str {
	return rt_str_from_raw(rec[at], rec[at+1])
}

// Open makes a client for the server in o. It connects on first use, on each core.
fn Open(o Options) Client {
	mut addr = o.Addr
	if addr == "" {
		addr = "127.0.0.1:5432"
	}
	let id = __atomic_add(&nClients, 1)
	if id >= maxClients {
		return Client{open: false, rec: 0}
	}
	let rec = calloc(recWords, 8)
	rec[rAddr] = keep_raw(addr)
	rec[rAddrN] = len(addr)
	rec[rUser] = keep_raw(o.User)
	rec[rUserN] = len(o.User)
	rec[rPass] = keep_raw(o.Password)
	rec[rPassN] = len(o.Password)
	rec[rDB] = keep_raw(o.Database)
	rec[rDBN] = len(o.Database)
	rec[rPool] = o.Pool // 0: default_pool(), which needs the core count, known only when the cores run
	if o.MaxTotal > 0 {
		rec[rCap] = cap_record(addr + "\x00" + o.User + "\x00" + o.Database + "\x00" + mint.Itoa(o.MaxTotal), o.MaxTotal)
	}
	rec[rTimeout] = o.Timeout
	rec[rID] = id
	mut mode = o.SSLMode
	let given = o.TLS
	if mode == "" && given != nil {
		mode = "verify-full"
	}
	if mode == "require" || mode == "verify-full" {
		let cfg = tls.Config{ServerName: "", RootCAs: "", ALPN: []str{}, Timeout: 0, InsecureSkipVerify: mode == "require"}
		if given != nil {
			cfg.ServerName = given.ServerName
			cfg.RootCAs = given.RootCAs
			cfg.Certificate = given.Certificate // a client certificate, for clientcert=verify-full (#475)
			cfg.Key = given.Key
			cfg.MinVersion = given.MinVersion
			if given.InsecureSkipVerify {
				cfg.InsecureSkipVerify = true
			}
		}
		rec[rTls] = cast(i64, keep(cfg))
	} else if mode != "disable" && mode != "" {
		// An unknown mode must not silently mean plain TCP: refuse every connection.
		rec[rTls] = -1
	}
	return Client{open: true, rec: rec}
}

// ---- values ----

// IsNull reports whether v is NULL.
fn (v Value) IsNull() bool {
	match v {
		Null => {
			return true
		}
		_ => {
		}
	}
	return false
}

// Int is v as an integer (a Text or Float converted, NULL and bad text 0).
fn (v Value) Int() i64 {
	match v {
		Int(n) => {
			return n
		}
		Float(f) => {
			return i64(f)
		}
		Text(s) => {
			let n = mint.ParseInt(s, 10) catch _ { 0 }
			return n
		}
		Null => {
		}
	}
	return 0
}

// Float is v as a float.
fn (v Value) Float() f64 {
	match v {
		Int(n) => {
			return f64(n)
		}
		Float(f) => {
			return f
		}
		Text(s) => {
			let f = mint.ParseFloat(s) catch _ { 0.0 }
			return f
		}
		Null => {
		}
	}
	return 0.0
}

// Text is v as text ("" for NULL).
fn (v Value) Text() str {
	match v {
		Int(n) => {
			return mint.Itoa(n)
		}
		Float(f) => {
			return mint.FormatFloat(f, 'g', -1)
		}
		Text(s) => {
			return s
		}
		Null => {
		}
	}
	return ""
}

// Col is the index of the named column, or -1.
fn (r Rows) Col(name str) i64 {
	for i, c in r.Columns {
		if c == name {
			return i
		}
	}
	return -1
}

// ---- protocol framing and bounded cursors ----

fn os_msg(what str, e i64) str {
	let m = rt_sys_strerror(e)
	return "postgres: {what}: {rt_str_from_raw(m, strlen(m))}"
}

fn wait_msg(r i64) ! {
	if r == waitDeadline { fail cast(fault, rt_wait_fault()) }
	fail "postgres: timed out"
}

fn expiration(rec i64) i64 {
	if rec == 0 || rec[rTimeout] <= 0 { return 0 }
	return rt_mono_ns()+rec[rTimeout]
}

fn remaining(until i64) !i64 {
	let now = rt_mono_ns()
	let t = rt_task_current()
	if t != 0 && ((t[tDeadline] > 0 && now >= t[tDeadline]) || rt_bnd_stopped()) { fail cast(fault, rt_wait_fault()) }
	if until == 0 { return 0 }
	let left = until-now
	if left <= 0 { fail "postgres: timed out" }
	return left
}

fn be(p i64, n i64) i64 {
	mut v = 0
	for i in 0..n { v = v<<8 | i64(load8(p+i)) }
	return v
}

// A payload remains valid until the next read. Reject lengths before growing buffers.
fn read_packet(c i64) !(i64, i64) {
	c[cS] = c[cNext]
	for {
		_ = try remaining(c[cUntil])
		let avail = c[cE]-c[cS]
		if avail >= 5 {
			let p = c[cBuf]+c[cS]
			let n = be(p+1, 4)
			if n < 4 || n > 16777216 { fail "postgres: invalid or oversized message length" }
			if avail >= n+1 {
				c[cKind] = i64(load8(p))
				c[cNext] = c[cS]+n+1
				return p+5, n-4
			}
			if c[cS]+n+1 > c[cCap] {
				memmove(c[cBuf], p, avail)
				c[cS] = 0
 c[cE] = avail
				if n+1 > c[cCap] {
					c[cCap] = n+1+16384
					c[cBuf] = realloc(c[cBuf], c[cCap])
				}
			}
		} else if c[cS] > 0 && (c[cS] == c[cE] || c[cE] == c[cCap]) {
			memmove(c[cBuf], c[cBuf]+c[cS], avail)
			c[cS] = 0
 c[cE] = avail
		}
		let tc = tlsConns[c]
		if tc != nil {
			tc.SetDeadline(c[cUntil])
			let buf = make([]u8, 0, c[cCap]-c[cE])
			let got = try tc.ReadNow(mut buf, c[cCap]-c[cE])
			if got > 0 {
				memcpy(c[cBuf]+c[cE], cast(i64, buf)[2], got)
				c[cE] += got
				continue
			}
			let left = try remaining(c[cUntil])
			let r = rt_task_wait(c[cFd], 1, left)
			if r != waitReady { fail wait_msg(r) }
			continue
		}
		let k = rt_sys_read(c[cFd], c[cBuf]+c[cE], c[cCap]-c[cE])
		if k > 0 { c[cE] += k
 continue }
		if k == 0 { fail "postgres: the server closed the connection" }
		let e = rt_errno()
		if e == EINTR { continue }
		if e != EAGAIN { fail os_msg("read", e) }
		let left = try remaining(c[cUntil])
		let r = rt_task_wait(c[cFd], 1, left)
		if r != waitReady { fail wait_msg(r) }
	}
}

fn out_reserve(c i64, n i64) i64 {
	if n < 0 || c[cOutN]+n > 33554432 { rt_panic("postgres: output too large") }
	if c[cOutN]+n > c[cOutCap] {
		c[cOutCap] = c[cOutCap]*2+n+4096
		c[cOut] = realloc(c[cOut], c[cOutCap])
	}
	let p = c[cOut]+c[cOutN]
	c[cOutN] += n
	return p
}

fn put_be(c i64, v i64, n i64) {
	let p = out_reserve(c, n)
	for i in 0..n { store8(p+i, v >> (8*(n-1-i))) }
}

fn put_raw(c i64, p i64, n i64) {
	if n > 0 { memcpy(out_reserve(c, n), p, n) }
}

fn put_str(c i64, s str) { put_raw(c, cast(i64, s)+8, len(s)) }
fn put_cstr(c i64, s str) { put_str(c, s)
 put_be(c, 0, 1) }

// kind 0 is the untyped startup frame; otherwise a one-byte tag precedes the length.
fn begin_packet(c i64, kind i64) {
	if kind != 0 { put_be(c, kind, 1) }
	c[cPkt] = c[cOutN]
	out_reserve(c, 4)
}

fn end_packet(c i64) ! {
	let n = c[cOutN]-c[cPkt]
	if n > 16777216 { fail "postgres: messages above 16 MiB are not supported" }
	let p = c[cOut]+c[cPkt]
	for i in 0..4 { store8(p+i, n >> (24-8*i)) }
}

fn flush(c i64) ! {
	let tc = tlsConns[c]
	if tc != nil {
		tc.SetDeadline(c[cUntil])
		let err = tc.Write(rt_str_from_raw(c[cOut], c[cOutN]))
		c[cOutN] = 0
		if err != nil { fail err }
		return
	}
	mut at = 0
	for at < c[cOutN] {
		_ = try remaining(c[cUntil])
		let k = rt_sys_write(c[cFd], c[cOut]+at, c[cOutN]-at)
		if k > 0 { at += k
 continue }
		let e = rt_errno()
		if e == EINTR { continue }
		if e != EAGAIN { fail os_msg("write", e) }
		let left = try remaining(c[cUntil])
		let r = rt_task_wait(c[cFd], 2, left)
		if r != waitReady { fail wait_msg(r) }
	}
	c[cOutN] = 0
}

type cur struct { p i64
 at i64
 end i64 }
fn (k mut cur) fixed(n i64) !i64 {
	if n < 0 || n > k.end-k.at { fail "postgres: truncated message" }
	let v = be(k.p+k.at, n)
	k.at += n
	return v
}
fn (k mut cur) bytes(n i64) !str {
	if n < 0 || n > k.end-k.at { fail "postgres: truncated message" }
	let s = rt_str_from_raw(k.p+k.at, n)
	k.at += n
	return s
}
fn (k mut cur) cstr() !str {
	mut e = k.at
	for e < k.end && load8(k.p+e) != 0 { e += 1 }
	if e == k.end { fail "postgres: unterminated string" }
	let s = try k.bytes(e-k.at)
	k.at += 1
	return s
}
fn (k cur) done() ! {
	if k.at != k.end { fail "postgres: unexpected trailing message data" }
}

fn error_text(k mut cur) !str {
	mut severity = "ERROR"
	mut unlocalized = ""
	mut state = ""
	mut message = ""
	mut detail = ""
	for {
		let tag = try k.fixed(1)
		if tag == 0 { break }
		let s = try k.cstr()
		if tag == 'S' { severity = s }
		if tag == 'V' { unlocalized = s }
		if tag == 'C' { state = s }
		if tag == 'M' { message = s }
		if tag == 'D' { detail = s }
	}
	try k.done()
	if unlocalized != "" { severity = unlocalized }
	mut out = "postgres: {severity} {state}: {message}"
	if detail != "" { out += " (detail: {detail})" }
	return out
}

fn ready(c i64, k mut cur) ! {
	let status = try k.fixed(1)
	try k.done()
	if status != 'I' && status != 'T' && status != 'E' { fail "postgres: invalid transaction status" }
	c[cStatus] = status
	c[cSynced] = 1
}

fn status_message(c i64, k mut cur) ! {
	if c[cKind] == 'S' { _ = try k.cstr()
 _ = try k.cstr()
 try k.done()
 return }
	if c[cKind] == 'K' {
		c[cPID] = try k.fixed(4)
 c[cKey] = try k.fixed(4)
 try k.done()
 return
	}
	if c[cKind] == 'N' { _ = try error_text(mut k)
 return }
	fail "postgres: unexpected server message"
}

fn no_nul(s str) ! {
	for i in 0..len(s) { if s[i] == 0 { fail "postgres: NUL in protocol string" } }
}

// ---- authentication ----

fn password_message(c i64, text str, terminated bool) ! {
	begin_packet(c, 'p')
	put_str(c, text)
	if terminated { put_be(c, 0, 1) }
	try end_packet(c)
 try flush(c)
}

fn attrs(s str) ![]str {
	let out = make([]str, 128)
	mut at = 0
	for at < len(s) {
		if at+2 > len(s) || s[at+1] != '=' || !(s[at] >= 'a' && s[at] <= 'z' || s[at] >= 'A' && s[at] <= 'Z') { fail "postgres: invalid SCRAM attributes" }
		let tag = i64(s[at])
		if out[tag] != "" || tag == 'm' { fail "postgres: unsupported or duplicate SCRAM attribute" }
		mut e = at+2
		for e < len(s) && s[e] != ',' { e += 1 }
		if e == at+2 { fail "postgres: empty SCRAM attribute" }
		out[tag] = s[at+2:e]
		at = e+1
		if at == len(s) { fail "postgres: trailing SCRAM separator" }
	}
	return out
}

fn handshake(c i64, rec i64) ! {
	let user = rec_str(rec, rUser)
	let pass = rec_str(rec, rPass)
	let db = rec_str(rec, rDB)
	try no_nul(user)
 try no_nul(db)
	if len(user)+len(db) > 16700000 || len(pass) > 16700000 { fail "postgres: login data too large" }
	begin_packet(c, 0)
	put_be(c, 196608, 4)
	put_cstr(c, "user")
 put_cstr(c, user)
	if db != "" { put_cstr(c, "database")
 put_cstr(c, db) }
	put_cstr(c, "client_encoding")
 put_cstr(c, "UTF8")
	put_be(c, 0, 1)
	try end_packet(c)
 try flush(c)
	mut phase = 0
	mut nonce = ""
	mut bare = ""
	mut serverSig = []u8{}
	mut authed = false
	for {
		let (p, n) = try read_packet(c)
		let k = cur{p: p, end: n}
		if c[cKind] == 'R' {
			let method = try k.fixed(4)
			if method == 0 {
				try k.done()
				if phase != 0 && phase != 4 { fail "postgres: unverified authentication" }
				authed = true
 phase = 5
 continue
			}
			if method == 3 && phase == 0 {
				try k.done()
 try no_nul(pass)
				try password_message(c, pass, true)
 phase = 4
 continue
			}
			if method == 5 && phase == 0 {
				let salt = try k.bytes(4)
 try k.done()
				let inner = seal.Hex(md5.Sum(pass+user))
				try password_message(c, "md5"+seal.Hex(md5.Sum(inner+salt)), true)
				phase = 4
 continue
			}
			if method == 10 && phase == 0 {
				mut found = false
				for {
					let mechanism = try k.cstr()
					if mechanism == "" { break }
					if mechanism == "SCRAM-SHA-256" { found = true }
				}
				try k.done()
				if !found { fail "postgres: SCRAM-SHA-256 required (TLS/channel binding unsupported)" }
				nonce = seal.B64(seal.RandomBytes(24))
				bare = "n=,r={nonce}"
				let first = "n,,{bare}"
				begin_packet(c, 'p')
 put_cstr(c, "SCRAM-SHA-256")
 put_be(c, len(first), 4)
 put_str(c, first)
				try end_packet(c)
 try flush(c)
 phase = 1
 continue
			}
			if method == 11 && phase == 1 {
				let first = try k.bytes(k.end-k.at)
				let a = try attrs(first)
				let r = a['r']
				if len(r) > 16384 { fail "postgres: SCRAM server nonce too large" }
				for i in 0..len(r) {
					if r[i] < 33 || r[i] > 126 { fail "postgres: invalid SCRAM server nonce" }
				}
				if len(r) <= len(nonce) || r[:len(nonce)] != nonce { fail "postgres: invalid SCRAM server nonce" }
				let count = a['i']
				if len(count) == 0 || len(count) > 7 { fail "postgres: invalid SCRAM iteration count" }
				for i in 0..len(count) {
					if count[i] < '0' || count[i] > '9' { fail "postgres: invalid SCRAM iteration count" }
				}
				let iterations = try mint.Atoi(count)
				if iterations < 1 || iterations > 1000000 { fail "postgres: SCRAM iteration count outside 1..1000000" }
				if len(a['s']) == 0 || len(a['s']) > 4096 { fail "postgres: invalid SCRAM salt" }
				let salt = try seal.B64Decode(a['s'])
				let left = try remaining(c[cUntil])
				let (salted, err) = seal.Pbkdf2Sha256Timeout(sasl.Prep(pass), str(salt), iterations, 32, left)
				if err != nil {
					// Reclassify the derivation's timeout using the whole operation budget.
					_ = try remaining(c[cUntil])
					fail err
				}
				_ = try remaining(c[cUntil])
				let key = seal.HmacSha256(str(salted), "Client Key")
				let final = "c=biws,r={r}"
				let message = "{bare},{first},{final}"
				let signature = seal.HmacSha256(str(seal.Sha256(str(key))), message)
				let proof = make([]u8, 32)
				for i in 0..32 { proof[i] = key[i]^signature[i] }
				serverSig = seal.HmacSha256(str(seal.HmacSha256(str(salted), "Server Key")), message)
				try password_message(c, "{final},p={seal.B64(proof)}", false)
				phase = 2
 continue
			}
			if method == 12 && phase == 2 {
				let last = try k.bytes(k.end-k.at)
				let a = try attrs(last)
				if a['e'] != "" { fail "postgres: SCRAM authentication failed: {a['e']}" }
				if a['v'] == "" { fail "postgres: missing SCRAM server verifier" }
				if len(a['v']) != 44 { fail "postgres: invalid SCRAM server verifier" }
				let v = try seal.B64Decode(a['v'])
				if !seal.ConstantTimeEq(v, serverSig) { fail "postgres: invalid SCRAM server verifier" }
				phase = 4
 continue
			}
			fail "postgres: unsupported or out-of-order authentication method {method}"
		}
		if c[cKind] == 'E' {
			let message = try error_text(mut k)
			if contains(message, "SSL") || contains(message, "no encryption") {
				fail "{message}; postgres: the server requires TLS: set Options.SSLMode"
			}
			fail message
		}
		if c[cKind] == 'Z' {
			if !authed { fail "postgres: ReadyForQuery before authentication" }
			try ready(c, mut k)
 return
		}
		try status_message(c, mut k)
	}
}

fn contains(s str, part str) bool {
	{
		mut i = 0
		for i+len(part) <= len(s) { if s[i:i+len(part)] == part { return true } 
		i += 1
	}
	}
	return false
}

// ---- the pool ----

fn (c Client) pool() i64 {
	if pools == 0 {
		pools = calloc(maxClients+1, 8)
	}
	let id = c.rec[rID]
	mut p = pools[id]
	if p == 0 {
		p = calloc(poolWords, 8)
		p[pIdle] = calloc(pool_cap(c.rec)+1, 8)
		pools[id] = p
	}
	return p
}

// ---- the process-wide cap (Options.MaxTotal) ----
//
// A Client opened in a global's initializer is opened once per core, each with its own record,
// so the cap cannot live in the record. It is a cap record shared by every Client with the same
// address, user, database and MaxTotal: the count of connections of all cores, and the list of
// those that sit idle in some core's pool. A core that finds the cap reached while all its own
// connections are busy (or it has none) takes a slot from that list: it shuts the idle
// connection's socket down and the core that owns it frees the record when it next looks at it.

const kKey = 0
const kKeyN = 1
const kMax = 2
const kTotal = 3 // connections of all cores (atomic)
const kLock = 4
const kIdle = 5 // [kMax] connections idle in some core's pool, 0 for a free place (under kLock)
const capWords = 6

shared mut capLock i64
shared mut capTab i64 // [maxClients]: the cap records, in the order they were first made
shared mut capN i64

// cap_record is the cap record for key, made on first use.
fn cap_record(key str, max i64) i64 {
	for __atomic_swap(&capLock, 1) != 0 {
		__yield()
	}
	if capTab == 0 {
		capTab = calloc(maxClients, 8)
	}
	mut k = 0
	for i in 0..capN {
		let r = capTab[i]
		if rt_str_from_raw(r[kKey], r[kKeyN]) == key {
			k = r
			break
		}
	}
	if k == 0 && capN < maxClients {
		k = calloc(capWords, 8)
		k[kKey] = keep_raw(key)
		k[kKeyN] = len(key)
		k[kMax] = max
		k[kIdle] = calloc(max, 8)
		capTab[capN] = k
		capN += 1
	}
	__atomic_store(&capLock, 0)
	return k
}

fn cap_lock(k i64) {
	for __atomic_swap(k + 8*kLock, 1) != 0 {
		__yield()
	}
}

fn cap_unlock(k i64) {
	__atomic_store(k + 8*kLock, 0)
}

// default_pool is the connections one core may hold when Options.Pool is not set: 64 shared
// among the cores hearth.Run started (a program that never ran it counts as one), at least 2.
fn default_pool() i64 {
	mut n = lifeCores
	if n < 1 {
		n = 1
	}
	if 64/n < 2 {
		return 2
	}
	return 64 / n
}

// pool_cap is the connections one core of the client rec may hold.
fn pool_cap(rec i64) i64 {
	if rec[rPool] > 0 {
		return rec[rPool]
	}
	return default_pool()
}

// reserve takes one of the process's MaxTotal connections for one about to be dialed; false when
// every core together hold them all.
fn reserve(rec i64) bool {
	let k = rec[rCap]
	if k == 0 {
		return true
	}
	for {
		let n = __atomic_load(k + 8*kTotal)
		if n >= k[kMax] {
			return false
		}
		if __atomic_cas(k + 8*kTotal, n, n+1) == n {
			return true
		}
	}
	return false
}

// unreserve gives back what reserve took, for a connection that was closed or never dialed.
fn unreserve(rec i64) {
	let k = rec[rCap]
	if k != 0 {
		__atomic_add(k + 8*kTotal, -1)
	}
}

// idle_add lists conn, just put in this core's idle stack, as one another core may take.
fn idle_add(rec i64, conn i64) {
	let k = rec[rCap]
	if k == 0 {
		return
	}
	cap_lock(k)
	let idle = k[kIdle]
	for i in 0..k[kMax] {
		if idle[i] == 0 {
			idle[i] = conn
			break
		}
	}
	cap_unlock(k)
}

// idle_claim takes conn, just popped from this core's idle stack, off the list; false when
// another core took its slot meanwhile (the socket is shut down: free the record and go on).
fn idle_claim(rec i64, conn i64) bool {
	let k = rec[rCap]
	if k == 0 {
		return true
	}
	cap_lock(k)
	let idle = k[kIdle]
	for i in 0..k[kMax] {
		if idle[i] == conn {
			idle[i] = 0
			break
		}
	}
	let stolen = conn[cStolen]
	cap_unlock(k)
	return stolen == 0
}

// steal_idle takes the slot of a connection idle in some core's pool: it shuts the socket down
// (the server sees the close at once; the owner still holds the record and the descriptor, so
// the descriptor number cannot be reused under it) and gives its place in the count back.
fn steal_idle(rec i64) bool {
	let k = rec[rCap]
	if k == 0 {
		return false
	}
	cap_lock(k)
	let idle = k[kIdle]
	mut took = false
	for i in 0..k[kMax] {
		if idle[i] != 0 {
			let conn = idle[i]
			idle[i] = 0
			conn[cStolen] = 1
			rt_sys_shutdown(conn[cFd], 2)
			__atomic_add(k + 8*kTotal, -1)
			took = true
			break
		}
	}
	cap_unlock(k)
	return took
}

// wait_for_slot parks the task for at most 2 ms (less when its time is nearly up): every
// connection is busy, so it looks again for a place or an idle connection. It returns how the
// wait ended (waitDeadline: the request's deadline or cancel).
fn wait_for_slot(left i64) i64 {
	mut step = 2000000
	if left > 0 && left < step {
		step = left
	}
	return rt_task_park(step)
}

fn conn_free(c i64) {
	delete(tlsConns, c)
	if c[cFd] >= 0 {
		rt_sys_close(c[cFd])
	}
	free(c[cBuf])
	free(c[cOut])
	let st = c[cStmts]
	for i in 0..c[cNStmts] {
		free(st[i*stmtWords])
		free(st[i*stmtWords+2])
	}
	free(st)
	free(c)
}

fn dial(rec i64, until i64) !i64 {
	let addr = rec_str(rec, rAddr)
	let left = try remaining(until)
	let w = try wire.DialTimeout(addr, left)
	let c = calloc(connWords, 8)
	c[cFd] = w.Fd()
	c[cCap] = 16384
	c[cBuf] = malloc(c[cCap])
	c[cStmts] = calloc(maxStmts*stmtWords, 8)
	c[cUntil] = until
	if rec[rTls] != 0 {
		let e1 = start_tls(c, rec, w, until)
		if e1 != nil {
			conn_free(c)
			fail e1
		}
	}
	let err = handshake(c, rec)
	if err != nil {
		conn_free(c)
		fail err
	}
	return c
}

// start_tls sends SSLRequest and, when the server answers S, runs the TLS handshake. The
// answer is read alone, so no plaintext the server sent after it can reach the TLS layer.
fn start_tls(c i64, rec i64, w wire.Conn, until i64) ! {
	if rec[rTls] < 0 {
		fail "postgres: unknown sslmode (use disable, require or verify-full)"
	}
	begin_packet(c, 0)
	put_be(c, 80877103, 4)
	try end_packet(c)
	try flush(c)
	let b = calloc(1, 8)
	for {
		let k = rt_sys_read(c[cFd], b, 1)
		if k == 1 { break }
		let e = rt_errno()
		if k < 0 && e == EINTR { continue }
		if k < 0 && e == EAGAIN {
			let left = remaining(until) catch err { free(b)
 fail err }
			let r = rt_task_wait(c[cFd], 1, left)
			if r != waitReady { free(b)
 fail wait_msg(r) }
			continue
		}
		free(b)
		fail "postgres: the server closed the connection during SSLRequest"
	}
	let answer = load8(b)
	free(b)
	if answer != 'S' {
		fail "postgres: the server does not support TLS (sslmode needs it)"
	}
	let base = cast(tls.Config, rec[rTls])
	mut name = base.ServerName
	if name == "" {
		name = host_of(rec_str(rec, rAddr))
	}
	let left = try remaining(until)
	let cfg = tls.Config{ServerName: name, RootCAs: base.RootCAs, ALPN: []str{}, Timeout: left, InsecureSkipVerify: base.InsecureSkipVerify,
		Certificate: base.Certificate, Key: base.Key, MinVersion: base.MinVersion}
	let tc = try tls.Client(w, cfg)
	tlsConns[c] = keep(tc)
}

// host_of is the host in "host:port" ("[v6]:port" gives v6).
fn host_of(addr str) str {
	mut colon = len(addr)
	for i in 0..len(addr) {
		if addr[i] == ':' {
			colon = i
		}
	}
	mut h = addr[:colon]
	if len(h) >= 2 && h[0] == '[' && h[len(h)-1] == ']' {
		h = h[1 : len(h)-1]
	}
	return h
}

// alive reports whether an idle connection is still open (the server may have closed it:
// a restart, wait_timeout).
fn alive(c i64) bool {
	if c[cNext] != c[cE] { return false }
	let tc = tlsConns[c]
	if tc != nil {
		// Records may wait (session tickets): read them; data or an error means not idle.
		let buf = make([]u8, 0, 16)
		let (got, err) = tc.ReadNow(mut buf, 16)
		return err == nil && got == 0
	}
	let b = calloc(1, 8)
	let k = rt_sys_recv(c[cFd], b, 1, 2)
	let e = rt_errno()
	free(b)
	return k < 0 && (e == EAGAIN || e == EINTR)
}

fn (c Client) acquire(until i64) !i64 {
	if !c.open {
		fail "postgres: the client is not open (too many clients: open one per server, not per request)"
	}
	let p = c.pool()
	for {
		_ = try remaining(until)
		for p[pIdleN] > 0 {
			p[pIdleN] -= 1
			let idle = p[pIdle]
			let conn = idle[p[pIdleN]]
			if !idle_claim(c.rec, conn) {
				// Another core took its slot (MaxTotal) and shut it down; the count is already given back.
				conn_free(conn)
				p[pTotal] -= 1
				continue
			}
			if alive(conn) {
				return conn
			}
			conn_free(conn)
			p[pTotal] -= 1
			unreserve(c.rec)
		}
		if p[pTotal] < pool_cap(c.rec) {
			if reserve(c.rec) {
				p[pTotal] += 1
				let (conn, err) = dial(c.rec, until)
				if err != nil {
					p[pTotal] -= 1
					unreserve(c.rec)
					wake_retry(p)
					fail err
				}
				return conn
			}
			// MaxTotal connections exist already, on the other cores: take the slot of one that sits
			// idle. With none, and none of its own to wait for, this core looks again until a
			// connection is released somewhere or its time is up.
			if steal_idle(c.rec) {
				continue
			}
			if p[pTotal] == 0 {
				if rt_task_current() == 0 { fail "postgres: MaxTotal connections are in use" }
				let left = try remaining(until)
				if wait_for_slot(left) == waitDeadline {
					fail cast(fault, rt_wait_fault())
				}
				continue
			}
		}
		if rt_task_current() == 0 { fail "postgres: pool exhausted outside a request task" }
		// Every connection is busy: wait for one.
		let left = try remaining(until)
		let w = calloc(4, 8)
		w[wTask] = rt_task_current()
		if p[pWaitHead]+p[pWaitN] == p[pWaitCap] {
			if p[pWaitHead] > 0 {
				memmove(p[pWait], p[pWait]+8*p[pWaitHead], 8*p[pWaitN])
				p[pWaitHead] = 0
			} else {
				let cp = p[pWaitCap]*2 + 32
				p[pWait] = realloc(p[pWait], 8*cp)
				p[pWaitCap] = cp
			}
		}
		let q = p[pWait]
		q[p[pWaitHead]+p[pWaitN]] = w
		p[pWaitN] += 1
		let r = rt_task_park(left)
		if w[wDone] == 0 {
			// Timed out: the releaser frees the entry when it reaches it.
			w[wGone] = 1
			fail wait_msg(r)
		}
		let conn = w[wConn]
		free(w)
		if conn != 0 {
			return conn
		}
		// A connection was dropped: there is room to dial again.
	}
}

// next_waiter is the first waiter still waiting, or 0.
fn next_waiter(p i64) i64 {
	for p[pWaitN] > 0 {
		let q = p[pWait]
		let w = q[p[pWaitHead]]
		p[pWaitHead] += 1
		p[pWaitN] -= 1
		if p[pWaitN] == 0 {
			p[pWaitHead] = 0
		}
		if w[wGone] != 0 {
			free(w)
			continue
		}
		return w
	}
	return 0
}

// release returns a connection to the pool; a broken one (ok false) is closed.
fn (c Client) release(conn i64, ok bool) {
	let p = c.pool()
	if !ok {
		conn_free(conn)
		p[pTotal] -= 1
		unreserve(c.rec)
		conn = 0
	}
	let w = next_waiter(p)
	if w != 0 {
		w[wConn] = conn
		w[wDone] = 1
		rt_task_wake(w[wTask])
		return
	}
	if conn != 0 {
		let idle = p[pIdle]
		idle[p[pIdleN]] = conn
		p[pIdleN] += 1
		idle_add(c.rec, conn)
	}
}


fn wake_retry(p i64) {
	let w = next_waiter(p)
	if w != 0 { w[wDone] = 1
 rt_task_wake(w[wTask]) }
}

// ---- statement execution ----

fn placeholders(q query) str {
	mut n = len(q.Args)*6
	for _, part in q.Parts { n += len(part) }
	mut out = make([]u8, 0, n)
	for i, part in q.Parts {
		out = append(out, part...)
		if i < len(q.Args) {
			out = append(out, '$')
			out = append(out, mint.Itoa(i+1)...)
		}
	}
	return str(out)
}

fn param_oid(v qarg) i64 {
	match v {
		Int(_) => { return 20
		}
		Float(_) => { return 701
		}
		Str(_) => { return 25
		}
		Bool(_) => { return 16
		}
		Bytes(_) => { return 17
		}
	}
	return 0
}

fn eq_raw(p i64, s str) bool {
	for i in 0..len(s) { if load8(p+i) != s[i] { return false } }
	return true
}

fn name(id i64) str { return "tin"+mint.Itoa(id) }

// read_result always drains through ReadyForQuery, including after a server error.
// Return the first rowset and the affected count from the last command.
fn read_result(c i64) !(Rows, Result) {
	let rows = Rows{}
	let res = Result{}
	mut oids = []i64{}
	mut formats = []i64{}
	mut first = true
	mut haveRows = false
	mut message = ""
	for {
		let (p, n) = try read_packet(c)
		let k = cur{p: p, end: n}
		let kind = c[cKind]
		if kind == 'Z' {
			try ready(c, mut k)
			if message != "" { fail message }
			return rows, res
		}
		if kind == 'E' {
			let m = try error_text(mut k)
			if message == "" { message = m }
			continue
		}
		if kind == 'T' {
			let count = try k.fixed(2)
			if count > (n-2)/19 { fail "postgres: invalid column count" }
			oids = make([]i64, count)
 formats = make([]i64, count)
			let columns = make([]str, count)
			for i in 0..count {
				columns[i] = try k.cstr()
				_ = try k.fixed(4)
 _ = try k.fixed(2)
				oids[i] = try k.fixed(4)
				_ = try k.fixed(2)
 _ = try k.fixed(4)
				formats[i] = try k.fixed(2)
				if formats[i] != 0 { fail "postgres: unexpected binary result format" }
			}
			try k.done()
			first = !haveRows
			if first { rows.Columns = columns
 haveRows = true }
			continue
		}
		if kind == 'D' {
			let count = try k.fixed(2)
			if count != len(oids) { fail "postgres: row has incorrect column count" }
			mut row = make([]Value, 0, count)
			for i in 0..count {
				let rawLength = try k.fixed(4)
				let length = i64(i32(rawLength))
				if length == -1 { row = append(row, Value.Null)
 continue }
				let text = try k.bytes(length)
				if oids[i] == 20 || oids[i] == 21 || oids[i] == 23 {
					let number = try mint.Atoi(text)
					row = append(row, Value.Int(number))
				} else if oids[i] == 700 || oids[i] == 701 {
					let number = try mint.ParseFloat(text)
					row = append(row, Value.Float(number))
				} else if oids[i] == 16 {
					if text == "t" { row = append(row, Value.Int(1)) } else if text == "f" { row = append(row, Value.Int(0)) } else { fail "postgres: invalid boolean result" }
				} else { row = append(row, Value.Text(text)) }
			}
			try k.done()
			if first { rows.Rows = append(rows.Rows, row) }
			continue
		}
		if kind == 'C' {
			let tag = try k.cstr()
 try k.done()
			mut at = len(tag)
			for at > 0 && tag[at-1] >= '0' && tag[at-1] <= '9' { at -= 1 }
			res.Affected = 0
			if at < len(tag) && at > 0 && tag[at-1] == ' ' { res.Affected = try mint.Atoi(tag[at:]) }
			continue
		}
		if kind == '1' { try k.done()
 c[cParsed] = 1
 continue }
		if kind == '2' || kind == '3' || kind == 'n' || kind == 'I' { try k.done()
 continue }
		try status_message(c, mut k)
	}
}

fn clear_statements(c i64) ! {
	let st = c[cStmts]
	for i in 0..c[cNStmts] {
		let e = st+8*stmtWords*i
		begin_packet(c, 'C')
 put_be(c, 'S', 1)
 put_cstr(c, name(e[4]))
 try end_packet(c)
	}
	begin_packet(c, 'S')
 try end_packet(c)
 try flush(c)
	let (_, _, err) = read_result(c)
	if err != nil { c[cSynced] = 0
 fail err }
	for i in 0..c[cNStmts] { free(st[i*stmtWords])
 free(st[i*stmtWords+2]) }
	c[cNStmts] = 0
	c[cSynced] = 0
}

fn bind_param(c i64, v qarg) {
	match v {
		Int(n) => { put_be(c, 8, 4)
 put_be(c, n, 8)
		}
		Float(f) => { put_be(c, 8, 4)
 put_be(c, i64(gauge.F64bits(f)), 8)
		}
		Str(s) => { put_be(c, len(s), 4)
 put_str(c, s)
		}
		Bool(b) => { put_be(c, 1, 4)
 if b { put_be(c, 1, 1) } else { put_be(c, 0, 1) }
		}
		Bytes(b) => { put_be(c, len(b), 4)
 put_raw(c, cast(i64, b)[2], len(b))
		}
	}
}

fn run(c i64, q query) !(Rows, Result) {
	if len(q.Parts) != len(q.Args)+1 { fail "postgres: invalid query parts" }
	mut n = len(q.Args)*6
	for _, part in q.Parts { n += len(part) }
	if len(q.Args) > 65535 || n > 16700000 { fail "postgres: statement too large" }
	let text = placeholders(q)
	try no_nul(text)
	// Validate before changing synchronization state; local failures can reuse the socket.
	mut bytes = 64+len(q.Args)*16
	for _, v in q.Args {
		match v {
			Str(s) => { bytes += len(s)
			}
			Bytes(b) => { bytes += len(b)
			}
			_ => {
			}
		}
	}
	if bytes > 16700000 { fail "postgres: parameters too large" }
	c[cSynced] = 0
	if len(q.Args) == 0 {
		begin_packet(c, 'Q')
 put_cstr(c, text)
 try end_packet(c)
 try flush(c)
		return try read_result(c)
	}
	mut signature = make([]u8, 0, len(q.Args)*4)
	for _, v in q.Args {
		signature = append(signature, mint.Itoa(param_oid(v))...)
		signature = append(signature, ',')
	}
	let sig = str(signature)
	let st = c[cStmts]
	mut entry = 0
	for i in 0..c[cNStmts] {
		let e = st+8*stmtWords*i
		if e[1] == len(text) && e[3] == len(sig) && eq_raw(e[0], text) && eq_raw(e[2], sig) { entry = e
 break }
	}
	if entry == 0 {
		if c[cNStmts] == maxStmts { try clear_statements(c) }
		c[cSerial] += 1
		let id = c[cSerial]
		// Prepare separately: record only a confirmed Parse, even if a later Bind fails.
		c[cParsed] = 0
		begin_packet(c, 'P')
 put_cstr(c, name(id))
 put_cstr(c, text)
 put_be(c, len(q.Args), 2)
		for _, v in q.Args { put_be(c, param_oid(v), 4) }
		try end_packet(c)
 begin_packet(c, 'S')
 try end_packet(c)
 try flush(c)
		_, _ = try read_result(c)
		if c[cParsed] == 0 { c[cSynced] = 0
 fail "postgres: missing ParseComplete" }
		entry = st+8*stmtWords*c[cNStmts]
		entry[0] = keep_raw(text)
 entry[1] = len(text)
		entry[2] = keep_raw(sig)
 entry[3] = len(sig)
 entry[4] = id
		c[cNStmts] += 1
		c[cSynced] = 0
	}
	begin_packet(c, 'B')
 put_cstr(c, "")
 put_cstr(c, name(entry[4]))
	put_be(c, 1, 2)
 put_be(c, 1, 2) // one binary format for all parameters
	put_be(c, len(q.Args), 2)
	for _, v in q.Args { bind_param(c, v) }
	put_be(c, 0, 2) // text results, decoded by OID
	try end_packet(c)
	begin_packet(c, 'D')
 put_be(c, 'P', 1)
 put_cstr(c, "")
 try end_packet(c)
	begin_packet(c, 'E')
 put_cstr(c, "")
 put_be(c, 0, 4)
 try end_packet(c)
	begin_packet(c, 'S')
 try end_packet(c)
 try flush(c)
	return try read_result(c)
}

fn (c Client) exec(q query) !(Rows, Result) {
	let until = expiration(c.rec)
	let conn = try c.acquire(until)
	conn[cUntil] = until
	let (rows, res, err) = run(conn, q)
	if err != nil {
		c.release(conn, conn[cSynced] != 0 && conn[cStatus] == 'I')
		fail err
	}
	c.release(conn, conn[cStatus] == 'I')
	return rows, res
}

// Query returns the first rowset. With no parameters, multiple statements are allowed
// and all replies are consumed before returning. Integers and booleans use Value.Int;
// float4/8 use Value.Float; other OIDs (including numeric and bytea) use Value.Text.
fn (c Client) Query(q query) !Rows {
	let tp = rt_tape()
	if tp != 0 {
		let (rows, _) = try c.exec_taped(tp, "Q ", q) // recorded for replay (#241)
		return rows
	}
	let (rows, _) = try c.exec(q)
	return rows
}

// Exec returns the affected count of the last command. Use Query with RETURNING
// to obtain generated IDs (PostgreSQL has no connection-wide last insert ID).
fn (c Client) Exec(q query) !Result {
	let tp = rt_tape()
	if tp != 0 {
		let (_, res) = try c.exec_taped(tp, "E ", q) // recorded for replay (#241)
		return res
	}
	let (_, res) = try c.exec(q)
	return res
}

// Ping checks that the server answers.
fn (c Client) Ping() ! {
	_ = try c.Exec("SELECT 1")
}

// Begin pins a connection until Commit or Rollback. SQL errors abort the transaction
// until Rollback. Copies share its state: finishing one finishes them all. In request
// tasks an unfinished transaction is dropped when its owning task/scope ends. Outside
// tasks always finish explicitly. Tx and its rows belong to the caller's pool.
fn (c Client) Begin() !Tx {
	let tp = rt_tape()
	if tp != 0 {
		return try c.begin_taped(tp) // recorded for replay (#241)
	}
	let until = expiration(c.rec)
	let conn = try c.acquire(until)
	conn[cUntil] = until
	let (_, _, err) = run(conn, "BEGIN")
	if err != nil {
		c.release(conn, conn[cSynced] != 0 && conn[cStatus] == 'I')
		fail err
	}
	let state = rt_alloc(24)
	state[0] = conn
 state[1] = c.rec
 state[2] = 1
	rt_task_cleanup(abandon_tx, state)
	return Tx{state: state}
}

fn abandon_tx(state i64) {
	if state[2] == 0 { return }
	let c = Client{open: true, rec: state[1]}
	c.release(state[0], false)
	state[2] = 0
}

fn (t mut Tx) run(q query) !(Rows, Result) {
	if t.state == 0 || t.state[2] == 0 { fail "postgres: the transaction is finished" }
	let c = Client{open: true, rec: t.state[1]}
	let conn = t.state[0]
	conn[cUntil] = expiration(c.rec)
	let (rows, res, err) = run(conn, q)
	if err != nil {
		if conn[cSynced] == 0 { abandon_tx(t.state) } else if conn[cStatus] == 'I' { c.release(conn, true)
 t.state[2] = 0 }
		fail err
	}
	// Explicit transaction-control SQL also ends ownership of this connection.
	if conn[cStatus] == 'I' { c.release(conn, true)
 t.state[2] = 0 }
	return rows, res
}

// Query runs a statement in the transaction and returns its first rowset.
fn (t mut Tx) Query(q query) !Rows {
	let tp = rt_tape()
	if tp != 0 {
		let (rows, _) = try t.run_taped(tp, "Q ", q) // recorded for replay (#241)
		return rows
	}
	let (rows, _) = try t.run(q)
	return rows
}

// Exec runs a statement in the transaction and returns its affected count.
fn (t mut Tx) Exec(q query) !Result {
	let tp = rt_tape()
	if tp != 0 {
		let (_, res) = try t.run_taped(tp, "E ", q) // recorded for replay (#241)
		return res
	}
	let (_, res) = try t.run(q)
	return res
}

// Commit makes the transaction's changes permanent. An aborted transaction must be
// rolled back explicitly; PostgreSQL's implicit COMMIT-to-ROLLBACK is not success.
fn (t mut Tx) Commit() ! {
	let tp = rt_tape()
	if tp != 0 {
		return try t.finish_taped(tp, "commit", commit_live) // recorded for replay (#241)
	}
	if t.state != 0 && t.state[2] != 0 && t.state[0][cStatus] == 'E' {
		fail "postgres: transaction aborted; Rollback required"
	}
	_, _ = try t.run("COMMIT")
}

// Rollback undoes the transaction's changes and releases its connection.
fn (t mut Tx) Rollback() ! {
	let tp = rt_tape()
	if tp != 0 {
		return try t.finish_taped(tp, "rollback", rollback_live) // recorded for replay (#241)
	}
	_, _ = try t.run("ROLLBACK")
}

// ---- recording and replay (notes/interface_replay.md, section 4; #241) ----

// An effect's body runs at once, before it waits: these hand it its arguments.
mut tapedClient i64
mut tapedQuery i64
mut tapedTx i64

// exec_taped records or replays one statement as postgres@1 (kind "Q " or "E ", then the query).
fn (c Client) exec_taped(tp i64, kind str, q query) !(Rows, Result) {
	tapedClient = cast(i64, c)
	tapedQuery = cast(i64, q)
	let v = try rt_effect(tp, "postgres@1", rt_query_key(kind, q), exec_live)
	return try untape(v)
}

fn exec_live() !str {
	let c = cast(Client, tapedClient)
	let (rows, res) = try c.exec(cast(query, tapedQuery))
	return entape(rows, res)
}

// entape is a statement's outcome as a tape holds it: the columns, the rows (each value a tag,
// 0 null, 1 int, 2 float, 3 text, and its payload), then the Result.
fn entape(rows Rows, res Result) str {
	mut b = make([]u8, 0, 256)
	b = tput(b, len(rows.Columns))
	for _, col in rows.Columns {
		b = tput_str(b, col)
	}
	b = tput(b, len(rows.Rows))
	for _, row in rows.Rows {
		b = tput(b, len(row))
		for _, v in row {
			match v {
				Null => {
					b = tput(b, 0)
				}
				Int(x) => {
					b = tput(b, 1)
					b = tput(b, x)
				}
				Float(x) => {
					b = tput(b, 2)
					b = tput(b, i64(gauge.F64bits(x)))
				}
				Text(x) => {
					b = tput(b, 3)
					b = tput_str(b, x)
				}
			}
		}
	}
	b = tput(b, res.Affected)
	return str(b)
}

// untape is entape's outcome again.
fn untape(v str) !(Rows, Result) {
	let k = tcur{s: v, pos: 0, bad: false}
	mut cols = make([]str, 0, 8)
	let nc = k.word()
	{
		mut i = 0
		for i < nc && !k.bad {
			cols = append(cols, k.text())
			i += 1
		}
	}
	mut all = make([][]Value, 0, 8)
	let nr = k.word()
	{
		mut i = 0
		for i < nr && !k.bad {
			mut row = make([]Value, 0, 8)
			let n = k.word()
			{
			mut j = 0
			for j < n && !k.bad {
					let t = k.word()
					if t == 0 {
						row = append(row, Value.Null)
					} else if t == 1 {
						row = append(row, Value.Int(k.word()))
					} else if t == 2 {
						row = append(row, Value.Float(gauge.F64frombits(u64(k.word()))))
					} else if t == 3 {
						row = append(row, Value.Text(k.text()))
					} else {
						k.bad = true
					}
					j += 1
			}
		}
			all = append(all, row)
			i += 1
		}
	}
	let res = Result{Affected: k.word()}
	if k.bad || k.pos != len(v) {
		fail "replay: postgres@1 result is damaged"
	}
	return Rows{Columns: cols, Rows: all}, res
}

// tcur reads words and strings off a recorded result; bad once it ran past the end.
type tcur struct {
	s   str
	pos i64
	bad bool
}

fn (k mut tcur) word() i64 {
	if k.pos+8 > len(k.s) {
		k.bad = true
		return 0
	}
	mut v = 0
	{
		mut i = 7
		for i >= 0 {
			v = v<<8 | i64(k.s[k.pos+i])
			i -= 1
		}
	}
	k.pos += 8
	return v
}

fn (k mut tcur) text() str {
	let n = k.word()
	if n < 0 || k.pos+n > len(k.s) {
		k.bad = true
		return ""
	}
	let s = k.s[k.pos : k.pos+n]
	k.pos += n
	return s
}

fn tput(b []u8, v i64) []u8 {
	for i in 0..8 {
		b = append(b, u8(v >> (8 * i)))
	}
	return b
}

fn tput_str(b []u8, s str) []u8 {
	b = tput(b, len(s))
	b = append(b, s...)
	return b
}

// begin_taped records or replays Begin as postgres.tx@1 "begin"; replaying, the Tx has no
// connection (and no cleanup) and its statements come from the tape.
fn (c Client) begin_taped(tp i64) !Tx {
	tapedClient = cast(i64, c)
	tapedTx = 0
	_ = try rt_effect(tp, "postgres.tx@1", "begin", begin_live)
	if tapedTx != 0 {
		let t = cast(Tx, tapedTx)
		tapedTx = 0
		return t
	}
	let state = rt_alloc(24)
	state[0] = 0
	state[1] = c.rec
	state[2] = 1
	return Tx{state: state}
}

fn begin_live() !str {
	let c = cast(Client, tapedClient)
	let t = try c.Begin()
	tapedTx = cast(i64, t)
	return ""
}

// run_taped records or replays a statement of the transaction as postgres@1.
fn (t mut Tx) run_taped(tp i64, kind str, q query) !(Rows, Result) {
	if t.state == 0 || t.state[2] == 0 {
		fail "postgres: the transaction is finished"
	}
	tapedTx = cast(i64, t)
	tapedQuery = cast(i64, q)
	let v = try rt_effect(tp, "postgres@1", rt_query_key(kind, q), txrun_live)
	return try untape(v)
}

fn txrun_live() !str {
	let t = cast(Tx, tapedTx)
	let (rows, res) = try t.run(cast(query, tapedQuery))
	return entape(rows, res)
}

// finish_taped records or replays Commit or Rollback as postgres.tx@1; done, the transaction
// is finished.
fn (t mut Tx) finish_taped(tp i64, what str, live fn() !str) ! {
	tapedTx = cast(i64, t)
	_ = try rt_effect(tp, "postgres.tx@1", what, live)
	if t.state != 0 {
		t.state[2] = 0
	}
}

fn commit_live() !str {
	let t = cast(Tx, tapedTx)
	try t.Commit()
	return ""
}

fn rollback_live() !str {
	let t = cast(Tx, tapedTx)
	try t.Rollback()
	return ""
}
