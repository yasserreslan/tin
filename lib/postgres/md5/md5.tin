// Package md5 implements the legacy digest required by PostgreSQL's MD5 login.
// It is internal to the postgres client; use seal.Sha256 for new protocols.
package md5

var constants = []u32{0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501, 0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821, 0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x2441453, 0xd8a1e681, 0xe7d3fbc8, 0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a, 0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70, 0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x4881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665, 0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1, 0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391}
var shifts = []u32{7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21}

// Sum returns the MD5 digest of s, solely for legacy PostgreSQL authentication.
func Sum(s str) []u8 {
	n := (len(s)+9+63)/64*64
	b := make([]u8, n)
	for i := 0; i < len(s); i++ { b[i] = s[i] }
	b[len(s)] = 0x80
	for i := 0; i < 8; i++ { b[n-8+i] = u8(u64(len(s)*8) >> u64(8*i)) }
	h := []u32{0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476}
	m := make([]u32, 16)
	for at := 0; at < n; at += 64 {
		for i := 0; i < 16; i++ {
			j := at+4*i
			m[i] = u32(b[j]) | u32(b[j+1])<<8 | u32(b[j+2])<<16 | u32(b[j+3])<<24
		}
		a := h[0]
		bb := h[1]
		c := h[2]
		d := h[3]
		for i := 0; i < 64; i++ {
			f := u32(0)
			g := i
			if i < 16 { f = (bb & c) | (^bb & d) } else if i < 32 { f = (d & bb) | (^d & c); g = (5*i+1)%16 } else if i < 48 { f = bb ^ c ^ d; g = (3*i+5)%16 } else { f = c ^ (bb | ^d); g = (7*i)%16 }
			x := a+f+constants[i]+m[g]
			r := shifts[i]
			a = d
			d = c
			c = bb
			bb += (x<<r) | (x>>(32-r))
		}
		h[0] += a; h[1] += bb; h[2] += c; h[3] += d
	}
	out := make([]u8, 16)
	for i := 0; i < 4; i++ {
		for j := 0; j < 4; j++ { out[4*i+j] = u8(h[i] >> u32(8*j)) }
	}
	return out
}
