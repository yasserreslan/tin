// anvil's epoll event layout on arm64: struct epoll_event is 16 bytes (u32 events,
// padding, u64 data at 8), where x86-64 packs it to 12.
package anvil

const evSize = 16

fn ep_set(op i64, fd i64, events i64) {
	change[0] = events
	change[1] = fd
	rt_sys_epoll_ctl(kq, op, fd, change)
}

fn ev_fd(i i64) i64 {
	return (evs + i*evSize + 8)[0]
}

const sysSendfile = 71
