// anvil's event loop on Linux: epoll (connections edge-triggered with EPOLLET), timerfd
// for ticks, and one SO_REUSEPORT listener per core so the kernel balances connections.
package anvil


// struct epoll_event's size and data offset differ per CPU: see anvil_linux_<arch>.tin.
const epIn = 1
const epOut = 4
const epErr = 8
const epHup = 16
const epRdHup = 0x2000
const epEt = 0x80000000
const ownListener = true

fn ev_init() {
	kq = c32(rt_sys_epoll_create1(0x80000))
}

fn ev_level(fd i64) {
	ep_set(1, fd, epIn)
}

fn ev_conn(fd i64) {
	ep_set(1, fd, epIn|epRdHup|epEt)
}

fn ev_conn_write(fd i64) {
	ep_set(3, fd, epOut|epEt)
}

fn ev_conn_read(fd i64) {
	ep_set(3, fd, epIn|epRdHup|epEt)
}

fn ev_timer(ms i64) i64 {
	let tfd = c32(rt_sys_timerfd_create(1, 0x800|0x80000))
	let its = calloc(4, 8)
	its[0] = ms / 1000
	its[1] = (ms % 1000) * 1000000
	its[2] = its[0]
	its[3] = its[1]
	rt_sys_timerfd_settime(tfd, 0, its, 0)
	free(its)
	ev_level(tfd)
	return tfd
}

// ev_timer_ack reads the timerfd's expiry count so it stops being readable.
fn ev_timer_ack(fd i64) {
	rt_sys_read(fd, word+96, 8)
}

// ev_drain_timer is a second periodic timer (the shutdown deadline check): another timerfd.
fn ev_drain_timer(ms i64) i64 {
	return ev_timer(ms)
}

mut sigfd i64   // core 0: the signalfd delivering the blocked SIGTERM/SIGINT (-1 when absent)

// ev_signals adds a signalfd for SIGTERM and SIGINT (blocked in every thread) to the loop.
fn ev_signals() {
	sigfd = rt_signalfd()
	if sigfd >= 0 {
		rtWatchGrace = gGrace*1000000000
		rtWatchSignal = sigfd
		ev_level(sigfd)
	}
}

// ev_signal reports whether event i is the signalfd turning readable.
fn ev_signal(i i64) bool {
	return sigfd > 0 && ev_fd(i) == sigfd
}

// ev_signal_ack reads the 128-byte signalfd_siginfo so the signalfd stops being readable.
fn ev_signal_ack() {
	rt_sys_read(sigfd, word+128, 128)
}

// ev_wait waits for events, at most ms milliseconds (-1: no limit).
fn ev_wait(ms i64) i64 {
	return c32(rt_sys_epoll_wait(kq, evs, maxEvents, ms))
}

// ev_hangup reports that the peer closed or reset (it may arrive with the last data).
fn ev_hangup(i i64) bool {
	let m = __ld(evs+i*evSize, 2) & 0xffffffff
	return m&(epErr|epHup|epRdHup) != 0
}

fn ev_writable(i i64) bool {
	let m = __ld(evs+i*evSize, 2) & 0xffffffff
	return m&epOut != 0 && m&(epIn|epErr|epHup|epRdHup) == 0
}

// ev_task_add watches fd once for a waiting request task: want 1 readable, 2 writable.
fn ev_task_add(fd i64, want i64) {
	mut ev = epIn | epRdHup
	if want == 2 {
		ev = epOut
	}
	ep_set(1, fd, ev|0x40000000)
}

// ev_task_del stops watching fd for a task.
fn ev_task_del(fd i64) {
	ep_set(2, fd, 0)
}

// os_sendfile sends up to n bytes of file descriptor file, from offset off, to the socket sock
// (#350): the bytes sent, or minus the errno (EAGAIN when the socket would block). It runs on a
// helper thread, where a read from disk may block.
fn os_sendfile(sock i64, file i64, off i64, n i64) i64 {
	let offp = calloc(1, 8)
	offp[0] = off
	let r = linux_raw(sysSendfile, sock, file, offp, n, 0, 0)
	free(offp)
	return r
}

// os_pread reads up to n bytes of file descriptor fd from offset off into p (SendFile over TLS,
// which must seal the bytes): the bytes read, or minus the errno. It runs on a helper thread.
fn os_pread(fd i64, p i64, n i64, off i64) i64 {
	return linux_raw(sysPread64, fd, p, n, off, 0, 0)
}
