// anvil's epoll event layout on x86-64: struct epoll_event is packed to 12 bytes
// (u32 events at 0, u64 data at 4), where arm64 pads it to 16.
package anvil

const evSize = 12

fn ep_set(op i64, fd i64, events i64) {
	__st(change, events, 2)
	(change + 4)[0] = fd
	rt_sys_epoll_ctl(kq, op, fd, change)
}

fn ev_fd(i i64) i64 {
	return (evs + i*evSize + 4)[0]
}

const sysSendfile = 40
