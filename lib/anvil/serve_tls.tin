package anvil

import "quarry"
import "say"
import "seal"
import "tls"

// ---- HTTPS: ServeTLS (#124) ----
//
// A connection accepted by a TLS server starts in a handshake task of its own (tls_accept):
// tls.ServerOnFd runs the server side of TLS 1.3 on the socket, and each of its waits lets the
// core serve other connections. When it finishes, the tls.Conn is copied into long-lived memory
// (tlsConns, per core, by connection record: deleting the entry releases it through the
// long-lived reference counts, #176), c[cTls] holds its address, c[cProto] the protocol ALPN
// chose, and the connection enters that protocol at one place, tls_start. HTTP/1.1 then runs
// on the event loop plain connections use: a read decrypts the records that arrived into the
// read buffer serve_one parses (tls.Conn.ReadRaw), the batch of responses is sealed into records
// before it is written (SealRawTo), streams and SendFile seal what they write, and a close sends
// close_notify. Nothing here waits outside a task.
//
// anvil.tin reaches this file only through the hooks below, which ServeTLS sets: a server that
// never calls it links no TLS code.

shared mut gTlsOn bool
shared mut gTlsMs i64   // a handshake must finish within this (TIN_HANDSHAKE_TIMEOUT_MS; -1: the header timeout)
shared mut gTlsSet i64      // the certificates in effect (#476): malloc'd words [n, cert 1, key 1, ...] of heap strs, never freed (a core may still be reading an older set)
shared mut gTlsGen i64      // the set's generation: each reload adds 1, and a core rebuilds its configuration when it sees a new one
shared mut gTlsFiles i64    // malloc'd words [n, cert path, key path, contents' hash, ...] when certificates come from files, else 0
shared mut gTlsCheckNs i64  // how often core 0 looks at those files (TIN_TLS_RELOAD_S, default 60 s)
shared mut gTlsNextCheck i64
shared mut gTlsWatch fn()   // tls_watch: core 0's sweep looks at the files
shared mut gTlsClientAuth i64 // TLSConfig.ClientAuth (#475)
shared mut gTlsMinVersion i64 // TLSConfig.MinVersion (#473)
shared mut gTlsClientCAs i64  // TLSConfig.ClientCAs's PEM text, 0 for none

shared mut gTlsAccept fn(i64)                  // tls_accept: start the handshake of a new connection
shared mut gTlsDone fn(i64, i64)               // tls_done: a handshake task ended
shared mut gTlsRead fn(i64, i64, i64) i64      // tls_read: decrypted input, as ReadRaw counts it
shared mut gTlsPending fn(i64) i64             // tls_pending: input TLS holds that the socket will not report again
shared mut gTlsClosed fn(i64) bool             // tls_closed: Out.Closed for a TLS connection
shared mut gTlsSeal fn(i64) bool               // tls_seal: the output batch, sealed in place
shared mut gTlsWrite fn(i64, i64, i64) !()     // tls_write_all: a stream's bytes, sealed and written (!(): a bare ! ends no line here)
shared mut gTlsFile fn(i64, i64, i64, i64) !i64 // tls_file_step: a piece of SendFile's file, read and sealed
shared mut gTlsBye fn(i64)                     // tls_bye: close_notify before a close
shared mut gTlsFree fn(i64)                    // tls_free: release the connection's TLS state

mut tlsCfg ?tls.ServerConfig // this core's copy: an RSA key holds scratch space its signing writes
mut tlsCfgBad bool           // the copy could not be made (reported once)
mut tlsGen i64               // the generation of the certificate set tlsCfg was made from
let tlsConns = make(map[i64]?tls.Conn)
mut tlsHandshakes i64 // handshake tasks running on this core
mut tlsOb i64         // the sealed output batch is built here, then swapped with ob
mut tlsObCap i64

// ServeTLS is Serve over TLS 1.3 (HTTPS): certPEM is the certificate chain (leaf first) and
// keyPEM the leaf's private key (RSA, or ECDSA P-256 or P-384), as PEM text. The pair is
// checked before listening. ALPN offers "h2" (HTTP/2) and then "http/1.1"; a client without
// ALPN gets HTTP/1.1. Each handshake runs in a task, so slow clients never hold a core; it must
// finish within TIN_HANDSHAKE_TIMEOUT_MS (default: the header timeout, 10 s). Clients without
// TLS 1.3 are refused with a protocol_version alert, and those whose ALPN offers neither
// protocol with no_application_protocol.
fn ServeTLS(addr str, certPEM str, keyPEM str, h fn(Req, mut Out)) ! {
	try tls_setup(certPEM, keyPEM)
	gHandler = h
	gRoutes = 0
	return try serve_on(addr, serve_cores())
}

// ServeTLS is Serve over TLS 1.3, as anvil.ServeTLS: the routes are checked first, then the
// certificate and key.
fn (r Router) ServeTLS(addr str, certPEM str, keyPEM str) ! {
	let t = try compile(r)
	try tls_setup(certPEM, keyPEM)
	gRoutes = cast(i64, keep(t))
	return try serve_on(addr, serve_cores())
}

// TLSConfig configures ServeTLSConfig: the certificate chain and private key, as ServeTLS takes
// them, more certificates chosen by the client's server name (#476), and client certificates
// (mutual TLS, #475).
type TLSConfig struct {
	CertPEM      str       // the certificate chain (leaf first), PEM ("" when Certificates gives them all)
	KeyPEM       str       // the leaf's private key (RSA, ECDSA P-256 or P-384, Ed25519), PEM
	Certificates []TLSCert // more certificates; the default is CertPEM's, else the first of these
	ClientAuth   i64       // tls.NoClientCert (the default), tls.RequestClientCert or tls.RequireClientCert
	ClientCAs    str       // with ClientAuth: the PEM roots a client certificate must chain to (the system's are not used)
	MinVersion   i64       // tls.VersionTLS12 (the default, 0 too) or tls.VersionTLS13 to refuse TLS 1.2 clients (#473)
}

// TLSCert is one certificate chain (leaf first) and its private key: PEM text, or the paths of
// PEM files, which the server reads again when they change (#476).
type TLSCert struct {
	CertPEM  str
	KeyPEM   str
	CertFile str
	KeyFile  str
}

// ReloadCertificates replaces the server's certificates, from any core while it serves: the
// first is the default, the others are chosen by the client's server name. Every pair is checked
// first, and a bad one fails the call and changes nothing. Each core switches at its next
// handshake; connections already up keep their own. Pairs given as files are read now, and when
// the whole set was given as files, core 0 reads them again every TIN_TLS_RELOAD_S seconds
// (default 60) and reloads when they changed, so a renewal written to disk needs no call.
fn ReloadCertificates(certs []TLSCert) ! {
	if !gTlsOn {
		fail "anvil: ReloadCertificates on a server without TLS"
	}
	let pems = try tls_read_pems("", "", certs)
	try tls_check_pems(pems)
	tls_publish(pems)
}

// ServeTLSConfig is ServeTLS with a TLSConfig. With ClientAuth set, every full handshake asks
// for a client certificate: RequireClientCert refuses a client without one
// (certificate_required), and both refuse one that does not chain to ClientCAs for client
// authentication. A handler finds the verified chain in q.TLSConn().PeerCertificates().
fn ServeTLSConfig(addr str, cfg TLSConfig, h fn(Req, mut Out)) ! {
	try tls_setup_config(cfg)
	gHandler = h
	gRoutes = 0
	return try serve_on(addr, serve_cores())
}

// ServeTLSConfig is Serve over TLS with a TLSConfig, as anvil.ServeTLSConfig.
fn (r Router) ServeTLSConfig(addr str, cfg TLSConfig) ! {
	let t = try compile(r)
	try tls_setup_config(cfg)
	gRoutes = cast(i64, keep(t))
	return try serve_on(addr, serve_cores())
}

// TLSConn is the TLS connection the request arrived on, or nil over plain TCP: for its
// ALPN(), CipherSuite() and Group(). After Hijack every byte must go through it (Read, Write,
// Close), since the descriptor carries records.
fn (q Req) TLSConn() ?tls.Conn {
	if q.cn == 0 || q.cn[cTls] == 0 {
		return nil
	}
	return cast(tls.Conn, q.cn[cTls])
}

// tls_setup checks the certificate and key, keeps their PEM text for every core and turns
// the server's TLS on.
fn tls_setup(certPEM str, keyPEM str) ! {
	return try tls_setup_config(TLSConfig{CertPEM: certPEM, KeyPEM: keyPEM, ClientAuth: tls.NoClientCert, ClientCAs: ""})
}

// tls_setup_config is tls_setup for a TLSConfig: the client CAs are checked too.
fn tls_setup_config(tc TLSConfig) ! {
	let pems = try tls_read_pems(tc.CertPEM, tc.KeyPEM, tc.Certificates)
	try tls_check_pems(pems)
	let probe = try tls.LoadServerConfig(pems[0], pems[1])
	if tc.ClientAuth != tls.NoClientCert {
		if tc.ClientAuth != tls.RequestClientCert && tc.ClientAuth != tls.RequireClientCert {
			fail "anvil: TLSConfig.ClientAuth must be tls.NoClientCert, tls.RequestClientCert or tls.RequireClientCert"
		}
		if tc.ClientCAs == "" {
			fail "anvil: TLSConfig.ClientAuth needs TLSConfig.ClientCAs"
		}
		probe.ClientAuth = tc.ClientAuth
		probe.ClientCAs = tc.ClientCAs
		try tls.CheckServerConfig(probe)
		gTlsClientCAs = cast(i64, keep(tc.ClientCAs))
	}
	gTlsClientAuth = tc.ClientAuth
	if tc.MinVersion != 0 && tc.MinVersion != tls.VersionTLS12 && tc.MinVersion != tls.VersionTLS13 {
		fail "anvil: TLSConfig.MinVersion must be tls.VersionTLS12 or tls.VersionTLS13"
	}
	gTlsMinVersion = tc.MinVersion
	tls_publish(pems)
	tls_files(tc.Certificates)
	gTlsMs = -1
	let ms = quarry.Getenv("TIN_HANDSHAKE_TIMEOUT_MS")
	if ms != "" {
		gTlsMs = env_int("TIN_HANDSHAKE_TIMEOUT_MS", 0)
	}
	tls_protocols()
	gTlsAccept = tls_accept
	gTlsDone = tls_done
	gTlsRead = tls_read
	gTlsPending = tls_pending
	gTlsClosed = tls_closed
	gTlsSeal = tls_seal
	gTlsWrite = tls_write_all
	gTlsFile = tls_file_step
	gTlsBye = tls_bye
	gTlsFree = tls_free
	gTlsOn = true
}

// ---- ALPN: the protocols ServeTLS offers, and where each one starts ----
//
// alpn_offer registers a protocol, most preferred first, before the cores start. After a
// handshake c[cProto] is the protocol's number (its position + 1; 0 when the client offered no
// ALPN) and tls_start is the one place a connection enters it: start(c) is called once, on the
// event loop, with c in conns and its handshake done, and from then on owns c. It reads
// decrypted bytes with tls_read(c, p, n) (or through on_read for HTTP/1.1) and writes by
// appending to ob and calling flush(c), which seals the batch.

const maxProtos = 4

shared mut gProtoN i64
shared mut gProtoName i64  // maxProtos words: each name, a str kept in core 0's heap
shared mut gProtoStart i64 // maxProtos words: each start, a fn(i64)

// alpn_offer adds protocol name, after those already offered, with start as its entry.
fn alpn_offer(name str, start fn(i64)) {
	if gProtoName == 0 {
		gProtoName = calloc(maxProtos, 8)
		gProtoStart = calloc(maxProtos, 8)
	}
	if gProtoN == maxProtos {
		return
	}
	gProtoName[gProtoN] = cast(i64, keep(name))
	gProtoStart[gProtoN] = cast(i64, start)
	gProtoN += 1
}

// tls_protocols registers what ServeTLS offers, in the server's order of preference: HTTP/2
// (#360, h2.tin), then HTTP/1.1.
fn tls_protocols() {
	if gProtoN == 0 {
		alpn_offer("h2", h2_start)
		alpn_offer("http/1.1", tls_http1)
	}
}

// tls_alpn is the list of protocol names this server offers.
fn tls_alpn() []str {
	mut out = make([]str, 0, gProtoN)
	for i in 0..gProtoN {
		out = append(out, cast(str, gProtoName[i]))
	}
	return out
}

// tls_proto is the number of the protocol ALPN chose (0: none).
fn tls_proto(name str) i64 {
	if name == "" {
		return 0
	}
	for i in 0..gProtoN {
		if cast(str, gProtoName[i]) == name {
			return i + 1
		}
	}
	return 0
}

// tls_start is where a connection whose handshake finished enters its protocol: the one ALPN
// chose, or HTTP/1.1 when the client offered no ALPN.
fn tls_start(c i64) {
	let p = c[cProto]
	if p > 0 {
		let start = cast(fn(i64), gProtoStart[p-1])
		start(c)
		return
	}
	tls_http1(c)
}

// tls_http1 serves HTTP/1.1 on c from the event loop. Its first request has the header timeout
// from now on, and input that arrived with the client's Finished is read at once (the socket
// will not report it again).
fn tls_http1(c i64) {
	c[cStart] = loopNow
	c[cDeadline] = 0
	if gHeaderMs > 0 {
		c[cDeadline] = loopNow + gHeaderMs*1000000
	}
	ev_conn(c[cFD])
	if tls_pending(c) != 0 {
		on_read(c)
	}
}

// ---- the handshake ----

// tls_core_config makes this core's copy of the server configuration the first time; false
// when that fails (the pair was checked by ServeTLS, so only memory can make it fail).
fn tls_core_config() bool {
	let gen = __atomic_load(&gTlsGen)
	if tlsGen == gen && (tlsCfg != nil || tlsCfgBad) {
		return tlsCfg != nil
	}
	// A new certificate set (ServeTLS, or a reload): parse this core's copy. The configuration it
	// replaces stays alive while handshakes that use it run (the reclamation limbo).
	tlsGen = gen
	let set = __atomic_load(&gTlsSet)
	let cfg = tls.LoadServerConfig(cast(str, set[1]), cast(str, set[2])) catch err {
		tlsCfgBad = tlsCfg == nil
		quarry.Eprintln("anvil: TLS configuration: {err}")
		return tlsCfg != nil
	}
	mut others = make([]tls.Credential, 0, set[0])
	for i in 1..set[0] {
		let o = tls.LoadCredential(cast(str, set[1+2*i]), cast(str, set[2+2*i])) catch err {
			quarry.Eprintln("anvil: TLS configuration: {err}")
			continue
		}
		others = append(others, o)
	}
	cfg.Others = others
	cfg.ALPN = tls_alpn()
	cfg.ClientAuth = gTlsClientAuth
	cfg.MinVersion = gTlsMinVersion
	if gTlsClientCAs != 0 {
		cfg.ClientCAs = cast(str, gTlsClientCAs)
	}
	tlsCfg = keep(cfg)
	tlsCfgBad = false
	return true
}

// ---- the certificate set, its reloads and its files (#476) ----

// tls_read_pems is the certificate set as alternating chain and key PEM texts: certPEM's pair
// first when it is given, then each TLSCert's, read from its files when it names them.
fn tls_read_pems(certPEM str, keyPEM str, certs []TLSCert) ![]str {
	mut pems = make([]str, 0, 2+2*len(certs))
	if certPEM != "" {
		pems = append(pems, certPEM, keyPEM)
	}
	for _, c in certs {
		if c.CertFile != "" {
			let cert = quarry.ReadFile(c.CertFile) catch err {
				fail say.Fault("anvil: certificate file: %v", err)
			}
			let key = quarry.ReadFile(c.KeyFile) catch err {
				fail say.Fault("anvil: key file: %v", err)
			}
			pems = append(pems, cert, key)
		} else {
			pems = append(pems, c.CertPEM, c.KeyPEM)
		}
	}
	if len(pems) == 0 {
		fail "anvil: no certificate (TLSConfig.CertPEM or TLSConfig.Certificates)"
	}
	return pems
}

// tls_check_pems checks every pair of a certificate set.
fn tls_check_pems(pems []str) ! {
	for i in (0..len(pems)).step(2) {
		tls.LoadCredential(pems[i], pems[i+1]) catch err {
			fail say.Fault("anvil: certificate %d: %v", i/2+1, err)
		}
	}
}

// tls_publish makes pems the certificate set every core uses from its next handshake on. The set
// is copied to memory that is never freed: another core may still be reading the previous one.
fn tls_publish(pems []str) {
	let set = calloc(1+len(pems), 8)
	set[0] = len(pems) / 2
	for i, p in pems {
		set[1+i] = rt_heap_str(p)
	}
	__atomic_store(&gTlsSet, set)
	__atomic_add(&gTlsGen, 1)
}

// tls_files remembers the certificate files and a hash of their contents, for tls_watch.
fn tls_files(certs []TLSCert) {
	mut n = 0
	for _, c in certs {
		if c.CertFile != "" {
			n += 1
		}
	}
	if n == 0 || n != len(certs) {
		// Only a set given entirely as files is watched: a reload must not drop PEM pairs.
		return
	}
	let w = calloc(1+3*n, 8)
	w[0] = n
	for i, c in certs {
		w[1+3*i] = rt_heap_str(c.CertFile)
		w[2+3*i] = rt_heap_str(c.KeyFile)
		w[3+3*i] = rt_heap_str(tls_digest(c.CertFile, c.KeyFile))
	}
	gTlsFiles = w
	gTlsCheckNs = env_int("TIN_TLS_RELOAD_S", 60) * 1000000000
	gTlsNextCheck = rt_mono_ns() + gTlsCheckNs
	gTlsWatch = tls_watch
}

// tls_digest is a hash of a certificate file and its key file ("" when one cannot be read). The
// contents are compared, not modification times, whose one-second steps can hide a renewal.
fn tls_digest(certFile str, keyFile str) str {
	let c = quarry.ReadFile(certFile) catch _ { "" }
	let k = quarry.ReadFile(keyFile) catch _ { "" }
	return seal.Sha256Hex(c + "\n" + k)
}

// tls_watch (core 0's sweep, once a second) reads the certificate files again every
// TIN_TLS_RELOAD_S seconds and, when one changed since the last look, checks the new set and
// publishes it; a bad set is reported and the certificates in use stay.
fn tls_watch() {
	let now = rt_mono_ns()
	if now < gTlsNextCheck {
		return
	}
	gTlsNextCheck = now + gTlsCheckNs
	let w = gTlsFiles
	mut changed = false
	mut certs = make([]TLSCert, 0, w[0])
	for i in 0..w[0] {
		let cf = cast(str, w[1+3*i])
		let kf = cast(str, w[2+3*i])
		let m = tls_digest(cf, kf)
		if m != cast(str, w[3+3*i]) {
			w[3+3*i] = rt_heap_str(m)
			changed = true
		}
		certs = append(certs, TLSCert{CertPEM: "", KeyPEM: "", CertFile: cf, KeyFile: kf})
	}
	if !changed {
		return
	}
	ReloadCertificates(certs) catch err {
		quarry.Eprintln("anvil: certificate reload refused, the certificates in use stay: {err}")
		return
	}
	quarry.Eprintln("anvil: certificates reloaded from their files")
}

// tls_accept runs the handshake of the new connection c in a task, with the request deadline
// machinery: the handshake timeout ends a client that stalls, and a drain cancels it.
fn tls_accept(c i64) {
	if !tls_core_config() || tlsHandshakes >= maxWaiting {
		close_conn(c)
		return
	}
	let task = rt_task_new(tls_handshake, c)
	if rt_bnd_task(task, rt_bnd_core(), bkRequest) != nil {
		rt_task_free(task)
		close_conn(c)
		return
	}
	rt_task_recover(task)
	mut ms = gTlsMs
	if ms < 0 {
		ms = gHeaderMs
	}
	if ms > 0 {
		rt_task_set_deadline(task, rt_mono_ns()+ms*1000000)
	}
	c[cTask] = task
	c[cHs] = 1
	c[cDeadline] = 0
	tlsHandshakes += 1
	if rt_task_run(task) {
		tls_done(c, task)
	}
}

// tls_handshake is the handshake task's body: on success the tls.Conn is kept and c records it.
fn tls_handshake(c i64) {
	let cfg = tlsCfg
	if cfg == nil {
		return
	}
	let tc = tls.ServerOnFd(c[cFD], cfg) catch _ {
		return
	}
	let k = keep(tc)
	tlsConns[c] = k
	c[cTls] = cast(i64, k)
	c[cProto] = tls_proto(k.ALPN())
	c[cHs] = 2
}

// tls_done finishes c after its handshake task ended (finish_request sends it here).
fn tls_done(c i64, task i64) {
	let ok = c[cHs] == 2 && !rt_task_panicked(task)
	rt_task_free(task)
	tlsHandshakes -= 1
	c[cTask] = 0
	c[cHs] = 0
	if c[cDead] != 0 {
		// Closed while the handshake waited: the descriptor is closed already.
		free_conn(c)
		return
	}
	if !ok {
		close_conn(c)
		return
	}
	tls_start(c)
}

// ---- records on the event loop ----

// tls_read decrypts what arrived for c into the n bytes at p: the bytes (> 0), 0 after the
// client's close_notify, -1 when no whole record is in yet, -2 when the connection is broken.
// A KeyUpdate answer, or the alert that ends the connection, is sent first.
fn tls_read(c i64, p i64, n i64) i64 {
	let tc = cast(tls.Conn, c[cTls])
	let (k, out) = tc.ReadRaw(p, n)
	if len(out) > 0 {
		tls_send(c, cast(i64, out)[2], len(out))
	}
	return k
}

// tls_pending tells what input of c TLS holds that the socket will not report again: 2
// decrypted data (a read returns it at once), 1 only part of a record, 0 nothing.
fn tls_pending(c i64) i64 {
	if c[cTls] == 0 {
		return 0
	}
	let tc = cast(tls.Conn, c[cTls])
	if tc.Buffered() > 0 {
		return 2
	}
	if tc.PendingRaw() {
		return 1
	}
	return 0
}

// tls_closed is Out.Closed for a TLS connection (in its stream's task): whether the client
// sent close_notify or an alert, or closed the socket. Records read on the way stay buffered.
fn tls_closed(c i64) bool {
	let tc = cast(tls.Conn, c[cTls])
	let (gone, out) = tc.ClosedRaw()
	if len(out) > 0 {
		let p = cast(i64, out)[2]
		if conns[c[cFD]] == c {
			// The event loop owns the socket: after the output already pending.
			tls_send(c, p, len(out))
		} else if rt_sys_write(c[cFD], p, len(out)) != len(out) {
			// A stream owns it and the answer (a KeyUpdate's) does not fit: the stream ends.
			if c[cStream] >= 2 {
				c[cStream] = 5
			}
			c[cClose] = 1
			return true
		}
	}
	return gone
}

// tls_send writes the n sealed bytes at p after c's pending output, keeping what the socket
// does not take for on_write.
fn tls_send(c i64, p i64, n i64) {
	if c[cOut] != 0 {
		pend_out(c, p, n)
		return
	}
	mut w = rt_sys_write(c[cFD], p, n)
	if w < 0 {
		w = 0
	}
	if w < n {
		pend_out(c, p+w, n-w)
		ev_conn_write(c[cFD])
		c[cWriting] = 1
		write_deadline(c)
	}
}

// tls_seal turns the output batch (obLen bytes at ob, all for c) into records: they are sealed
// into tlsOb, which then becomes ob. False when sealing failed (the batch is dropped).
fn tls_seal(c i64) bool {
	if obLen == 0 {
		return true
	}
	let need = tls.SealRawSize(obLen)
	if need > tlsObCap {
		if tlsOb != 0 {
			free(tlsOb)
		}
		tlsObCap = need
		if tlsObCap < obCap {
			tlsObCap = obCap
		}
		tlsOb = malloc(tlsObCap)
	}
	let tc = cast(tls.Conn, c[cTls])
	let k = tc.SealRawTo(ob, obLen, tlsOb) catch _ {
		obLen = 0
		return false
	}
	let p = ob
	let pc = obCap
	ob = tlsOb
	obCap = tlsObCap
	tlsOb = p
	tlsObCap = pc
	obLen = k
	return true
}

// tls_bye sends close_notify before c closes, unless output is still pending (it would go out
// of order) or the connection already ended.
fn tls_bye(c i64) {
	if c[cOut] != 0 {
		return
	}
	let tc = cast(tls.Conn, c[cTls])
	let b = tc.CloseNotifyRaw()
	if len(b) > 0 {
		rt_sys_write(c[cFD], cast(i64, b)[2], len(b))
	}
}

// tls_free releases c's TLS state when its record is freed.
fn tls_free(c i64) {
	let tc = cast(tls.Conn, c[cTls])
	tc.ReleaseRaw()
	c[cTls] = 0
	delete(tlsConns, c)
}

// ---- streams and SendFile over TLS (in the request's task) ----

// tls_write_all seals the n bytes at p into records and writes them, waiting while the client
// does not read, as stream_write_all does for plain bytes. The records are built in a buffer
// freed afterwards, so a long stream does not grow the request's pool.
fn tls_write_all(c i64, p i64, n i64) ! {
	let tc = cast(tls.Conn, c[cTls])
	let buf = malloc(tls.SealRawSize(n))
	let k = tc.SealRawTo(p, n, buf) catch err {
		free(buf)
		c[cStream] = 5
		c[cClose] = 1
		fail err
	}
	mut done = 0
	for done < k {
		let w = rt_sys_write(c[cFD], buf+done, k-done)
		if w > 0 {
			done += w
			continue
		}
		stream_wait(c, w, errno()) catch err {
			free(buf)
			fail err
		}
	}
	free(buf)
}

const tlsFilePiece = 262144

// tls_file_step sends up to n bytes of file fd from off for SendFile over TLS: a helper thread
// reads them (a slow disk does not stop the core), then they are sealed and written. It returns
// how many went.
fn tls_file_step(c i64, fd i64, off i64, n i64) !i64 {
	let piece = min(n, tlsFilePiece)
	let job = calloc(6, 8)
	job[0] = fd
	job[1] = malloc(piece)
	job[2] = off
	job[3] = piece
	try rt_helper_run(tls_pread_job, job, tls_pread_drop)
	let k = job[4]
	let buf = job[1]
	free(job)
	if k <= 0 {
		free(buf)
		c[cStream] = 5
		c[cClose] = 1
		if k == 0 {
			fail "anvil: the file is shorter than it was when SendFile started"
		}
		fail "anvil: reading the file failed"
	}
	tls_write_all(c, buf, k) catch err {
		free(buf)
		fail err
	}
	free(buf)
	return k
}

fn tls_pread_job(job i64) {
	job[4] = os_pread(job[0], job[1], job[3], job[2])
}

// tls_pread_drop frees a job whose request ended before the helper did.
fn tls_pread_drop(job i64) {
	free(job[1])
	free(job)
}
