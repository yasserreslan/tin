// Package anvil is an HTTP/1.1 and HTTP/2 server: one event loop per core (epoll, kqueue),
// share-nothing. HTTP/2 without TLS (h2c) is served on the same port, by prior knowledge or after
// Upgrade: h2c, and over TLS (ServeTLS) to a client whose ALPN offers h2; handlers are the same
// for both, each request (or stream) in a task of its own.
//
// Core 0 accepts connections and deals them round-robin to every core through a pipe;
// from then on a connection belongs to one core for its whole life. Each core reads
// into one scratch buffer, parses requests in place, runs the handler, writes every
// response of the batch with one write, and wipes its request pool. Idle connections
// hold no buffers, only a 96-byte record.
//
//	type Msg struct {
//		message str
//	}
//
//	fn handle(q anvil.Req, w mut anvil.Out) {
//		w.Type("application/json")
//		argo.Put(mut w.Body, Msg{message: "hi"})
//	}
//
//	fn main() {
//		anvil.Serve(":8080", handle) catch err {
//			say.Line("server:", err)
//		}
//	}
//
// A Router picks the handler by method and path pattern, and runs middleware around it.
// Patterns match whole segments: "users" itself, {id} any one non-empty segment, and a
// last {path...} or * the rest of the path. Static segments win over {name}, and {name}
// over the rest, segment by segment, whatever the order of registration. A path whose
// routes take other methods gets 405 with Allow, any other miss 404; HEAD falls back to
// GET. A trailing slash is part of the path: /users/ and /users are different routes.
// Write patterns with {...} as raw strings: in "..." the braces would interpolate.
//
//	fn user(q anvil.Req, w mut anvil.Out) {
//		let id = q.PathParam("id")
//		w.Text("user {id}")
//	}
//
//	fn logged(q anvil.Req, w mut anvil.Out, next fn(anvil.Req, mut anvil.Out)) {
//		next(q, mut w)
//		herald.Log(herald.LInfo, "request", []str{
//			"method", q.Method, "route", q.Pattern(), "status", say.Str(w.Code()), "client", q.ClientIP(),
//		})
//	}
//
//	fn main() {
//		let r = anvil.NewRouter()
//		r.Use(logged)
//		r.Get(`/users/{id}`, user)
//		r.Route("/admin", fn(g mut anvil.Router) {
//			g.Use(logged)
//			g.Delete(`/users/{id}`, user)
//		})
//		r.Serve(":8080") catch err {
//			say.Line("server:", err)
//		}
//	}
//
// The middleware writes one herald line per request, with the client's address as client:
//
//	2026-10-05T09:00:00.000Z INFO core=0 request method=GET route=/users/{id} status=200 client=203.0.113.7
//
// q.ClientIP() is the connection's peer unless the peer is one of the TrustedProxies: behind a
// proxy of yours, call TrustedProxies first, or every line carries the proxy's address.
//
// ServeTLS (and Router.ServeTLS) serve HTTPS: TLS 1.3 with a PEM certificate chain and key, each
// handshake in a task of its own, then the same event loop with records decrypted before parsing
// and sealed before writing (docs/RUNTIME.md). examples/https_server.tin.
package anvil

import "hearth"
import "quarry"
import "relay"
import "say"

// Req is the request being served. Its strings live in the request pool: keep() them
// to store them anywhere long-lived.
type Req struct {
	Method str
	Path   str
	Query  str
	hp     i64
	hn     i64
	bp     i64
	bn     i64
	ep     i64 // the Router endpoint that matched (an rend), for PathParam and Pattern
	tp     i64 // a chunked body's trailer field lines (#349), read by Header after the header block
	tn     i64
	cn     i64 // the connection record, for RemoteAddr and ClientIP (0: a request made in-process)
}

// Out is the response being built. Body is the response body; the status defaults to
// 200 and the content type to text/plain.
type Out struct {
	Body  []u8
	code  i64
	ctype str
	extra []u8
	own   []u8
	ep    i64 // the Router endpoint whose middleware chain is running (an rend)
	ci    i64 // the next middleware of that chain
	vals  i64 // SetValue's keys and values: a []str made on first use, or 0
	tr    i64 // Trailer's field lines: a []u8 made on first use, or 0
}

const scrSize = 262144
const maxRequest = 67108864
const maxStreamBody = 1099511627776 // the largest Content-Length a Router.Stream route takes (#481)
const maxLine = 65536   // request line and header block limit: 414 / 431 past it
const maxEvents = 256

// Connection record words.
const cFD = 0
const cIn = 1     // pending input: a request that has not fully arrived
const cInLen = 2
const cInCap = 3
const cOut = 4    // pending output the socket would not take yet
const cOutLen = 5
const cOutOff = 6
const cClose = 7  // close once the output is written
const cWriting = 8
const cNeed = 9   // bytes the pending request needs, when known
const cTask = 10  // the request task waiting (sleep, I/O) on this connection; later requests queue
const cAlive = 11 // that request's keep-alive
const cDead = 12  // closed while its task waited: freed when the task ends
const cHijack = 13 // taken out of HTTP by its handler (Req.Hijack): closed when the task ends
const cDeadline = 14 // monotonic ns after which the sweep closes the connection (0: none)
const cStart = 15    // when the first bytes of the request still arriving came (0: none pending)
const cLinger = 16   // 1: close after an error response by lingering (see linger); 2: lingering
const cSent100 = 17  // the request still arriving was told 100 Continue
const cPeer = 18     // the peer's sockaddr (malloc'd, read when a handler first asks), -1: unknown (#355)
const cStream = 19   // the response streams (#350): 0 no, 1 asked for, 2 chunked, 3 with a Content-Length, 4 until the connection closes, 5 broken
const cStLen = 20    // Content-Length the handler set for the stream (-1: none)
const cStSent = 21   // body bytes of a Content-Length stream sent so far
const cStBuf = 22    // scratch the head and the chunk framing are built in (malloc'd)
const cStCap = 23
const cStPend = 24   // bytes of the response head in cStBuf that are not written yet
const cStFlags = 25  // the request: 1 HEAD, 2 HTTP/1.0, 4 keep-alive asked in HTTP/1.0, 8 the connection closes after it
const cTls = 26      // HTTPS (#124, serve_tls.tin): the connection's tls.Conn (kept in tlsConns), 0 over plain TCP
const cHs = 27       // its handshake: 1 running in the task in cTask, 2 done (until tls_done), 0 none
const cProto = 28    // the protocol ALPN chose: its number in the offered list (alpn_offer), 0 none
const cH2 = 29       // the connection speaks HTTP/2 (#360): its state (h2.tin), 0 for HTTP/1.1
const cBody = 30     // a request body its handler reads as it arrives (#481): the reader's record (stream_body.tin), 0 none
const cWords = 31

shared mut gListen i64
shared mut gIP i64
shared mut gPort i64
shared mut gHandler fn(Req, mut Out)
shared mut gRoutes i64 // a Router's compiled table (an rtable in core 0's ingot heap, read by every core), or 0
shared mut gCores i64
shared mut gRelay fn(i64, str)
shared mut gRelayOn bool
shared mut gTick fn(i64)
shared mut gAdmit fn(Load) bool // the admission policy (Admit), nil: the built-in limits only
shared mut gOverCores i64 // cores whose admission policy is shedding (server.overload while > 0)
shared mut gTickMs i64
shared mut gPipes i64   // [read fd, write fd] per core
shared mut gSpare i64   // an fd core 0 closes to accept and drop a connection when out of fds
shared mut gLoad i64    // live connections per core, one cache line each; a handoff credits its target
shared mut gStop i64    // 1 once SIGTERM or SIGINT started the graceful shutdown (core 0 only)
shared mut gDrained i64 // cores that stopped and have no connection left
shared mut gGrace i64   // seconds the shutdown waits for connections to finish (TIN_GRACE, default 25)
shared mut gReqMemory i64 // pool bytes a request may take beyond its first chunk (TIN_REQUEST_MEMORY, 0: no bound)
shared mut gMemSoft i64   // pool and ingot bytes past which new requests get 503 (TIN_MEMORY_SOFT, 0: no bound)
shared mut gTok i64     // 256 bytes: 1 for each byte a token (a field name) may hold (RFC 9110 5.6.2)
shared mut gHeaderMs i64   // a request's line and headers must arrive within this (0: no limit)
shared mut gReadMs i64     // the whole request, body included (0: no limit)
shared mut gIdleMs i64     // a keep-alive connection with no request in progress (0: no limit)
shared mut gWriteMs i64    // a response the client does not read: no progress for this long (0: no limit)
shared mut gTimeoutsSet bool
shared mut gMaxBody i64     // largest request body (413 past it)
shared mut gMaxBuffered i64 // bytes of requests still arriving a core may hold (503 past it)
shared mut gMaxConns i64    // connections per core; more are closed at accept (0: no limit)
shared mut gLimitsSet bool

mut myID i64
mut loopNow i64    // monotonic ns, read once per event-loop turn
mut nextSweep i64  // when the loop next closes connections past their deadline
mut hiFd i64       // the highest descriptor this core has held a connection on
mut bufBytes i64   // bytes held in connections' pending-input buffers on this core
mut draining bool     // this core stopped accepting; its connections close after their next response
mut reported bool     // this core counted itself in gDrained
mut deadline i64      // core 0: when the grace period ends (seconds)
mut drainTimer i64    // core 0: the timer that checks the deadline while draining
mut hardStop i64      // core 0: when the process exits although work is left (0: not yet canceled)
shared mut gDrainNs i64 // the grace period Drain asked for (ns)
mut kq i64
mut myListen i64
mut conns i64
mut evs i64
mut scr i64
mut ob i64
mut obLen i64
mut obCap i64
mut change i64
mut word i64
mut common i64      // "Server: anvil\r\nDate: ...\r\n"
mut commonLen i64
mut lastSec i64
mut rr i64
shared mut gDeadlineMs i64 // a request's waits give up this long after it started (0: never)
shared mut gDeadlineSet bool

const maxWaiting = 4096 // waiting request tasks per core; past it new requests get 503
mut waiting i64        // this core's request tasks that are waiting
mut shedCount i64      // requests this core's admission policy refused
mut shedAt i64         // when this core last shed (mono ns), 0: it is not overloaded

mut fdTask i64  // fd -> the request task waiting on it (client sockets)
mut doneRd i64  // the read end of this core's helper-job pipe
mut ringRd i64  // this core's io_uring descriptor once a task made the ring (Linux, #357), else -1

mut head bool
// The request serve_one hands to the task it starts (read before the task first waits).
mut pReq i64
mut pReqLen i64
mut pSp1 i64
mut pSp2 i64
mut pLe i64
mut pHend i64
mut pCl i64
mut pHead bool
mut pTs i64      // the request target: offset in the request and length (absolute-form reduced to its path)
mut pTn i64
mut pKeep10 bool // an HTTP/1.0 request asked for keep-alive: the response must say so
mut pClose bool  // the connection closes after this request's response, which says so (RFC 9112 9.6)
mut pHttp10 bool // the request is HTTP/1.0
mut pTr i64      // a chunked request's trailer lines: offset in the request bytes and length (#349)
mut pTrLen i64

// chunk_scan's results for a complete chunked body (#349).
mut ckLen i64    // the decoded body's length
mut ckEnd i64    // the offset just after the trailer section's empty line
mut ckTr i64     // the trailer field lines: offset and end
mut ckTrEnd i64
mut ckRecLen i64 // chunked_record's length

fn c32(x i64) i64 {
	return i64(i32(x))
}

fn errno() i64 {
	return rt_errno()
}

// Serve listens on addr (":8080", "127.0.0.1:8080") and serves h on every core. It
// returns only if the server cannot start. TIN_CORES overrides the number of cores.
fn Serve(addr str, h fn(Req, mut Out)) ! {
	return try ServeN(addr, serve_cores(), h)
}

// ServeN is Serve on exactly n cores.
fn ServeN(addr str, n i64, h fn(Req, mut Out)) ! {
	gHandler = h
	gRoutes = 0
	return try serve_on(addr, n)
}

// serve_cores is how many cores Serve uses: hearth.Cores(), or TIN_CORES when set.
fn serve_cores() i64 {
	mut n = hearth.Cores()
	let env = rt_getenv(cast(i64, "TIN_CORES") + 8)
	if env != 0 && rt_decimal_integer(env)&0xffffffff > 0 {
		n = rt_decimal_integer(env) & 0xffffffff
	}
	return n
}

// serve_on listens on addr and runs the event loops of n cores, serving gHandler (or the
// router in gRoutes); it returns only if the server cannot start.
fn serve_on(addr str, n i64) ! {
	mut port = 0
	mut ip = 0
	mut colon = -1
	for i in 0..len(addr) {
		if addr[i] == ':' {
			colon = i
		}
	}
	if colon < 0 {
		fail "anvil: address needs a port, like \":8080\""
	}
	for i in colon + 1..len(addr) {
		let c = addr[i]
		if c < '0' || c > '9' {
			fail "anvil: bad port in address"
		}
		port = port*10 + i64(c-'0')
	}
	if colon > 0 {
		mut part = 0
		for i in 0..colon {
			let c = addr[i]
			if c == '.' {
				ip = ip<<8 | part
				part = 0
			} else if c >= '0' && c <= '9' {
				part = part*10 + i64(c-'0')
			} else {
				fail "anvil: the host must be a dotted IPv4 address"
			}
		}
		ip = ip<<8 | part
	}
	// $PORT (as set by Kubernetes, Cloud Run, Heroku...) replaces the port.
	let penv = rt_getenv(cast(i64, "PORT") + 8)
	if penv != 0 && rt_decimal_integer(penv)&0xffffffff > 0 && rt_decimal_integer(penv)&0xffffffff < 65536 {
		port = rt_decimal_integer(penv) & 0xffffffff
	}
	if replay_prepare() {
		// TIN_REPLAY_CAPSULE (#242): one recorded request, sent to a listener only this process knows.
		ip = 0x7f000001
		port = 0
		n = 1
	}
	gIP = ip
	gPort = port
	let fd = open_listener(ip, port)
	if fd == -1 {
		fail "anvil: socket failed"
	}
	if fd == -2 {
		fail "anvil: cannot bind the address (in use?)"
	}
	if fd == -3 {
		fail "anvil: listen failed"
	}
	rt_sys_signal(13, 1)
	gListen = fd
	gSpare = c32(rt_sys_open(cast(i64, "/dev/null")+8, 0, 0))
	if n < 1 {
		n = 1
	}
	gCores = n
	gPipes = calloc(2*n, 8)
	gLoad = rt_aligned_alloc(n * 128)
	gTok = calloc(256, 1)
	let tc = "!#$%&'*+-.^_`|~0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
	for i in 0..len(tc) {
		store8(gTok+i64(tc[i]), 1)
	}
	let fds = calloc(2, 4)
	for i in 0..n {
		rt_sys_pipe(fds)
		gPipes[2*i] = __ld(fds, 2)
		gPipes[2*i+1] = __ld(fds+4, 2)
		rt_sys_fcntl(gPipes[2*i], F_SETFL, O_NONBLOCK)
	}
	gGrace = 25
	if !gDeadlineSet {
		gDeadlineMs = 30000
	}
	let denv = rt_getenv(cast(i64, "TIN_DEADLINE_MS") + 8)
	if denv != 0 {
		gDeadlineMs = rt_decimal_integer(denv) & 0xffffffff
	}
	if !gTimeoutsSet {
		gHeaderMs = 10000
		gReadMs = 60000
		gIdleMs = 60000
		gWriteMs = 30000
	}
	if !gLimitsSet {
		gMaxBody = maxRequest
		gMaxBuffered = 268435456
		gMaxConns = 16384
	}
	gHeaderMs = env_int("TIN_HEADER_TIMEOUT_MS", gHeaderMs)
	gReadMs = env_int("TIN_READ_TIMEOUT_MS", gReadMs)
	gIdleMs = env_int("TIN_IDLE_TIMEOUT_MS", gIdleMs)
	gWriteMs = env_int("TIN_WRITE_TIMEOUT_MS", gWriteMs)
	gMaxBody = env_int("TIN_MAX_BODY", gMaxBody)
	gMaxBuffered = env_int("TIN_MAX_BUFFERED", gMaxBuffered)
	gMaxConns = env_int("TIN_MAX_CONNS", gMaxConns)
	gReqMemory = env_int("TIN_REQUEST_MEMORY", request_budget(n))
	gMemSoft = env_int("TIN_MEMORY_SOFT", rt_mem_limit()/10*9)
	let genv = rt_getenv(cast(i64, "TIN_GRACE") + 8)
	if genv != 0 && rt_decimal_integer(genv)&0xffffffff > 0 {
		gGrace = rt_decimal_integer(genv) & 0xffffffff
	}
	// SIGTERM and SIGINT are blocked in every thread (cores inherit this mask) and taken by
	// core 0's event loop instead: a handler could run on any thread and no Tin code may.
	rt_sig_block_term()
	monitor_start(n) // after the mask is set: the monitor thread inherits it (#341)
	record_setup(n) // TIN_REPLAY_DIR: requests are recorded for replay (#241)
	hearth.Run(n, core)
}


// open_listener binds a non-blocking listener on ip:port (SO_REUSEPORT, so every core
// can have one on Linux); -1, -2, -3 report a socket, bind or listen failure.
fn open_listener(ip i64, port i64) i64 {
	let fd = c32(rt_sys_socket(2, 1, 0))
	if fd < 0 {
		return -1
	}
	let one = calloc(1, 8)
	one[0] = 1
	rt_sys_setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, one, 4)
	if ownListener {
		rt_sys_setsockopt(fd, SOL_SOCKET, SO_REUSEPORT, one, 4)
	}
	free(one)
	let sa = calloc(1, 16)
	rt_sockaddr_in(sa, ip, port)
	if c32(rt_sys_bind(fd, sa, 16)) < 0 {
		rt_sys_close(fd)
		return -2
	}
	free(sa)
	if c32(rt_sys_listen(fd, 4096)) < 0 {
		rt_sys_close(fd)
		return -3
	}
	rt_sys_fcntl(fd, F_SETFL, O_NONBLOCK)
	return fd
}

fn core(id i64) {
	myID = id
	ev_init()
	conns = calloc(65536, 8)
	evs = calloc(maxEvents, 32)
	scr = malloc(scrSize)
	obCap = 65536
	ob = malloc(obCap)
	// The core's small scratch areas share one block aligned to the 128-byte cache line,
	// so no two cores ever write the same line.
	let block = rt_aligned_alloc(1024)
	change = block
	word = block + 128
	common = block + 640
	refresh_date(rt_wall_seconds())
	let pr = gPipes[2*id]
	ev_level(pr)
	myListen = -1
	if id == 0 {
		myListen = gListen
	} else if ownListener {
		myListen = open_listener(gIP, gPort)
	}
	if myListen >= 0 {
		ev_level(myListen)
	}
	mut rfd = -1
	if gRelayOn {
		rfd = relay.WakeFD()
		ev_level(rfd)
	}
	mut tick = -1
	if gTickMs > 0 {
		tick = ev_timer(gTickMs)
	}
	// Request tasks wait on client sockets through this loop, and on helper threads
	// through a pipe.
	fdTask = calloc(65536, 8)
	let jfds = calloc(2, 4)
	rt_sys_pipe(jfds)
	doneRd = i64(i32(__ld(jfds, 2)))
	doneFd = i64(i32(__ld(jfds+4, 2)))
	rt_sys_fcntl(doneRd, F_SETFL, O_NONBLOCK)
	ev_level(doneRd)
	ringRd = -1
	ringHook = ring_watch
	waitHook = task_watch
	waitCancel = task_unwatch
	drainTimer = -1
	if id == 0 {
		ev_signals()
	}
	if id == 0 && gReplayTape != 0 {
		replay_start()
	}
	loopNow = rt_mono_ns()
	nextSweep = loopNow + 1000000000
	for {
		if replayFd != 0 {
			replay_pump()
		}
		if gRelayOn {
			relay.Arm()
		}
		let n = ev_wait(wait_ms())
		beat()
		loopNow = rt_mono_ns()
		if loopNow >= nextSweep {
			sweep()
			nextSweep = loopNow + 1000000000
			if myID == 0 && gTlsFiles != 0 {
				gTlsWatch() // certificate files that changed are read again (#476, serve_tls.tin)
			}
		}
		run_timers()
		if n <= 0 {
			// A task the timers ran may have ended this draining core's last connection.
			if draining && drain_done() {
				return
			}
			continue
		}
		let now = rt_wall_seconds()
		if now != lastSec {
			refresh_date(now)
		}
		for i in 0..n {
			let fd = ev_fd(i)
			if ev_signal(i) {
				on_signal()
			} else if fd == pr {
				take_handoffs(pr)
			} else if fd == drainTimer {
				ev_timer_ack(drainTimer)
				if hardStop == 0 && rt_mono_ns() >= deadline {
					// The grace period is over: cancel what is left on every core with
					// "draining"; waiting requests answer and finish (design_semantics §10).
					hardStop = rt_mono_ns() + 1000000000
					word[3] = -2
					for j in 1..gCores {
						rt_sys_write(gPipes[2*j+1], word+24, 8)
					}
					drain_cancel()
				}
				// Code that never waits cannot see the cancel until safepoints (#234) exist.
				if hardStop != 0 && rt_mono_ns() >= hardStop {
					rt_flush_core()
					rt_sys_exit(0)
				}
			} else if fd == tick {
				ev_timer_ack(tick)
				rt_guard_call(tick_guarded, id)
				rt_pool_reset()
			} else if fd == rfd {
				// A panic ends one message's handler; the rest are handled by the next round.
				for rt_guard_call(relay_guarded, 0) != 0 {
				}
				rt_pool_reset()
			} else if fd == myListen {
				accept_all()
			} else if fd == doneRd {
				take_jobs()
			} else if fd == ringRd {
				rt_ring_reap()
			} else if fd >= 0 && fd < 65536 && fdTask[fd] != 0 {
				let task = fdTask[fd]
				fdTask[fd] = 0
				ev_task_del(fd)
				rt_task_ready(task)
				resume_task(task)
			} else {
				// An HTTP/2 connection reads while its output waits (h2_flush): epoll reports
				// the room to write in the same event as the input.
				let c0 = conns[fd]
				if c0 != 0 && c0[cWriting] == 2 && !ev_writable(i) && ev_out(i) {
					on_write(c0)
				}
				let c = conns[fd]
				if c != 0 {
					if ev_writable(i) {
						on_write(c)
					} else {
						on_read(c)
						// An edge-triggered hang-up is reported once: close now, or after
						// the pending output is written.
						if ev_hangup(i) && conns[fd] == c {
							// A client that only shut down its sending side still reads: a
							// request that waits gets its response, then the connection closes.
							if c[cOut] == 0 && c[cTask] == 0 {
								close_conn(c)
							} else {
								c[cClose] = 1
							}
						}
					}
				}
			}
		}
		if draining && drain_done() {
			return
		}
	}
}

// on_signal (core 0) starts the graceful shutdown on the first SIGTERM or SIGINT: every core
// stops accepting and ends once its connections are gone; a second signal exits at once.
fn on_signal() {
	ev_signal_ack()
	if gStop != 0 {
		rt_flush_core()
		rt_sys_exit(0)
	}
	gStop = 1
	deadline = rt_mono_ns() + gGrace*1000000000
	arm_hard_stop(deadline + 2000000000)
	if rtWatchDrainAt == 0 || deadline < rtWatchDrainAt { rtWatchDrainAt = deadline }
	word[3] = -1
	for j in 1..gCores {
		rt_sys_write(gPipes[2*j+1], word+24, 8)
	}
	drainTimer = ev_drain_timer(100)
	begin_drain()
}

// begin_drain stops this core from accepting: its listener closes, open connections finish
// their current request and are closed after their next response (Connection: close).
fn begin_drain() {
	if draining {
		return
	}
	draining = true
	if myListen >= 0 {
		rt_sys_close(myListen)
		myListen = -1
	}
	h2_drain_all() // HTTP/2 connections get GOAWAY now, and the idle ones close (#360)
}

// Drain starts the graceful shutdown from code, as SIGTERM does (#238): listeners close, the
// requests in flight finish, and after grace nanoseconds what is left is cancelled with
// fault.Draining; then the cores stop, Serve returns and the stop events run. Any core may
// call it; it does nothing outside a server or once a shutdown started.
fn Drain(grace i64) {
	if gCores == 0 {
		return
	}
	if grace < 0 {
		grace = 0
	}
	__atomic_swap(&gDrainNs, grace)
	let b = calloc(1, 8)
	b[0] = -3
	rt_sys_write(gPipes[1], b, 8)
	free(b)
}

// drain_asked (core 0) starts the shutdown Drain asked for, with its grace period.
fn drain_asked() {
	if gStop != 0 {
		return
	}
	gStop = 1
	deadline = rt_mono_ns() + __atomic_load(&gDrainNs)
	arm_hard_stop(deadline + 2000000000)
	if rtWatchDrainAt == 0 || deadline < rtWatchDrainAt { rtWatchDrainAt = deadline }
	word[3] = -1
	for j in 1..gCores {
		rt_sys_write(gPipes[2*j+1], word+24, 8)
	}
	drainTimer = ev_drain_timer(100)
	begin_drain()
}

// drain_cancel cancels every request and background task on this core with "draining".
fn drain_cancel() {
	rt_bnd_cancel(rt_bnd_core(), cast(fault, rt_fault_draining()))
}

// drain_done reports whether this core may stop: no connection is left (counted once in
// gDrained); core 0 also waits until every other core has reported, so Serve returns.
fn drain_done() bool {
	if !reported && __atomic_load(gLoad+myID*128) == 0 {
		reported = true
		__atomic_add(&gDrained, 1)
	}
	if myID != 0 {
		return reported
	}
	return __atomic_load(&gDrained) == gCores
}

fn refresh_date(now i64) {
	lastSec = now
	let s = "Server: anvil\r\n"
	memcpy(common, cast(i64, s)+8, len(s))
	let date = rt_http_date(now)
	memcpy(common+len(s),cast(i64,date)+8,len(date))
	commonLen = len(s)+len(date)
}

fn accept_all() {
	for k in 0..64 {
		let fd = c32(rt_sys_accept(myListen, 0, 0))
		if fd < 0 {
			let e = errno()
			if (e == 24 || e == 23) && gSpare >= 0 {
				drop_one()
			}
			return
		}
		rt_sys_fcntl(fd, F_SETFL, O_NONBLOCK)
		word[1] = 1
		rt_sys_setsockopt(fd, 6, 1, word+8, 4)
		if fd >= 65536 {
			rt_sys_close(fd)
			continue
		}
		mut target = myID
		if ownListener {
			// SO_REUSEPORT hashes connections unevenly over the per-core listeners: a core
			// that is more than one connection ahead of the least-loaded one hands over.
			let j = least_loaded()
			if j != myID && __atomic_load(gLoad+myID*128) > __atomic_load(gLoad+j*128)+1 {
				target = j
			}
		} else {
			target = rr % gCores
			rr += 1
		}
		if gMaxConns > 0 && __atomic_load(gLoad+target*128) >= gMaxConns {
			// Full: close at once rather than let one client hold every descriptor.
			rt_sys_close(fd)
			continue
		}
		if target == myID {
			add_conn(fd, true)
		} else {
			__atomic_add(gLoad+target*128, 1)
			word[2] = fd
			rt_sys_write(gPipes[2*target+1], word+16, 8)
		}
	}
}

// least_loaded is the core with the fewest live connections (handoffs in flight included).
fn least_loaded() i64 {
	mut best = 0
	mut bestLoad = __atomic_load(gLoad)
	for j in 1..gCores {
		let l = __atomic_load(gLoad + j*128)
		if l < bestLoad {
			best = j
			bestLoad = l
		}
	}
	return best
}

// drop_one frees the spare fd to accept and close one waiting connection: the client gets
// a clean close instead of hanging, and the level-triggered listen event stops spinning.
fn drop_one() {
	rt_sys_close(gSpare)
	let fd = c32(rt_sys_accept(myListen, 0, 0))
	if fd >= 0 {
		rt_sys_close(fd)
	}
	gSpare = c32(rt_sys_open(cast(i64, "/dev/null")+8, 0, 0))
}

// take_handoffs registers the connections other cores dealt to this one (already counted
// in this core's load by the sender).
fn take_handoffs(pr i64) {
	let n = rt_sys_read(pr, word+64, 256)
	{
		mut i = 0
		for i+8 <= n {
			let fd = (word + 64 + i)[0]
			if fd == -1 {
				begin_drain()
			} else if fd == -2 {
				drain_cancel()
			} else if fd == -3 {
				drain_asked()
			} else {
				add_conn(fd, false)
			}
			i += 8
		}
	}
}

fn add_conn(fd i64, count bool) {
	let c = calloc(cWords, 8)
	c[cFD] = fd
	conns[fd] = c
	if fd > hiFd {
		hiFd = fd
	}
	// The first request must arrive like any other: its headers within the header timeout.
	c[cStart] = loopNow
	if gHeaderMs > 0 {
		c[cDeadline] = loopNow + gHeaderMs*1000000
	}
	if count {
		__atomic_add(gLoad+myID*128, 1)
	}
	if gTlsOn {
		// HTTPS: the handshake first, in a task of its own (serve_tls.tin).
		gTlsAccept(c)
		return
	}
	ev_conn(fd)
}

fn close_conn(c i64) {
	if c[cDead] != 0 {
		return
	}
	if c[cH2] != 0 {
		h2_close(c) // its streams' tasks are cancelled; it is freed when they end (#360)
		return
	}
	let fd = c[cFD]
	if c[cTls] != 0 {
		gTlsBye(c) // close_notify (serve_tls.tin)
	}
	rt_sys_close(fd)
	conns[fd] = 0
	if c[cTask] != 0 {
		// Its request is still waiting: free the connection when the task ends.
		c[cDead] = 1
		return
	}
	free_conn(c)
}

// free_conn releases a closed connection's buffers.
fn free_conn(c i64) {
	__atomic_add(gLoad+myID*128, -1)
	if c[cIn] != 0 {
		bufBytes -= c[cInCap]
		free(c[cIn])
	}
	if c[cOut] != 0 {
		free(c[cOut])
	}
	if c[cPeer] > 0 {
		free(c[cPeer])
	}
	if c[cStBuf] != 0 {
		free(c[cStBuf])
	}
	if c[cBody] != 0 {
		body_drop(c)
	}
	if c[cH2] != 0 {
		h2_free(c)
	}
	if c[cTls] != 0 {
		gTlsFree(c)
	}
	free(c)
}

// Connections are edge-triggered (EV_CLEAR, like Go's poller): kqueue reports each
// arrival once, so on_read keeps reading while a read fills the whole buffer.
fn on_read(c i64) {
	for on_read_once(c) {
	}
}

// on_read_once reads and serves what one read returns; true means more may be waiting. However
// it ends, the core's own stack is at a quiescent point of the long-lived memory afterwards: a
// connection that closes after its response (Connection: close, HTTP/1.0) left through paths
// that reset no pool, so a core serving only such clients never freed what its requests dropped
// (#358).
fn on_read_once(c i64) bool {
	let more = on_read_serve(c)
	rt_pool_reset()
	return more
}

fn on_read_serve(c i64) bool {
	let fd = c[cFD]
	if c[cLinger] == 2 {
		for {
			let n = rt_sys_read(fd, scr, scrSize)
			if n == 0 || (n < 0 && errno() != EAGAIN && errno() != 4) {
				close_conn(c)
				return false
			}
			if n < 0 {
				return false
			}
		}
	}
	if c[cH2] != 0 {
		return h2_read(c) // HTTP/2 (#360)
	}
	if c[cBody] != 0 {
		return false // the request's handler reads the body from the socket (#481)
	}
	mut buf = scr
	mut cap = scrSize
	mut have = 0
	mut big = false
	if c[cIn] != 0 {
		if c[cInCap] > scrSize {
			buf = c[cIn]
			cap = c[cInCap]
			have = c[cInLen]
			big = true
		} else {
			memcpy(scr, c[cIn], c[cInLen])
			have = c[cInLen]
			bufBytes -= c[cInCap]
			free(c[cIn])
			c[cIn] = 0
			c[cInLen] = 0
			c[cInCap] = 0
		}
	}
	let want = cap - have
	mut n = 0
	if c[cTls] != 0 {
		// HTTPS: the records that arrived, decrypted; 0 after close_notify, -1 none complete yet,
		// -2 broken (serve_tls.tin).
		n = gTlsRead(c, buf+have, want)
	} else {
		n = rt_sys_read(fd, buf+have, want)
	}
	if n == 0 && c[cTask] != 0 {
		// End of input while a request waits: answer it, then close.
		c[cClose] = 1
		return false
	}
	if n <= 0 {
		if n < 0 && ((c[cTls] == 0 && (errno() == EAGAIN || errno() == 4)) || (c[cTls] != 0 && n == -1)) {
			n = 0
		} else {
			close_conn(c)
			return false
		}
	}
	let full = n == want && n > 0
	have += n
	mut off = 0
	for off < have && c[cClose] == 0 && c[cTask] == 0 {
		let r = serve_one(c, buf+off, have-off)
		if r <= 0 {
			break
		}
		off += r
	}
	if !flush(c) {
		return false
	}
	let rem = have - off
	if rem > 0 && c[cClose] == 0 {
		mut need = c[cNeed]
		if need < rem+4096 {
			need = rem + 4096
		}
		if rem == cap {
			need = cap * 2
		}
		if need > gMaxBody+2*maxLine {
			close_conn(c)
			return false
		}
		mut grow = need
		if big {
			grow = need - cap
		}
		if grow > 0 && gMaxBuffered > 0 && bufBytes+grow > gMaxBuffered {
			// This core already holds as many partial requests as it may: refuse this one.
			if big {
				c[cIn] = buf
				c[cInLen] = 0
				c[cInCap] = cap
			}
			bad(c, 503)
			flush(c)
			return false
		}
		if big {
			if off > 0 {
				memmove(buf, buf+off, rem)
			}
			if need > cap {
				buf = realloc(buf, need)
				bufBytes += need - cap
				cap = need
			}
			c[cIn] = buf
			c[cInLen] = rem
			c[cInCap] = cap
		} else {
			let p = malloc(need)
			bufBytes += need
			memcpy(p, buf+off, rem)
			c[cIn] = p
			c[cInLen] = rem
			c[cInCap] = need
		}
	} else if big {
		bufBytes -= cap
		free(buf)
		if c[cIn] == buf {
			c[cIn] = 0
			c[cInLen] = 0
			c[cInCap] = 0
		}
	}
	// Part of a TLS record buffered counts as a request still arriving; decrypted data TLS holds
	// (Out.Closed reads ahead) is read on the next turn, since the socket will not report it.
	arm(c, (rem > 0 || (c[cTls] != 0 && gTlsPending(c) != 0)) && c[cClose] == 0)
	rt_pool_reset()
	// A request after a streamed chunked body (#481) waits in c's input: serve it now.
	let rest = bodyRest && c[cIn] != 0
	bodyRest = false
	return (full || rest || (c[cTls] != 0 && gTlsPending(c) == 2)) && c[cClose] == 0 && c[cWriting] == 0 && c[cTask] == 0
}

// flush writes the batch's responses; false means the connection is gone. While the
// socket will not take the output, reading stops too, so a client that never reads
// cannot make the server buffer responses without bound.
fn flush(c i64) bool {
	if obLen == 0 {
		if c[cClose] != 0 && c[cOut] == 0 {
			close_or_linger(c)
			return false
		}
		return true
	}
	if c[cTls] != 0 && !gTlsSeal(c) {
		// HTTPS: the batch goes out as records (serve_tls.tin).
		close_conn(c)
		return false
	}
	if c[cOut] != 0 {
		pend_out(c, ob, obLen)
		obLen = 0
		return true
	}
	mut w = rt_sys_write(c[cFD], ob, obLen)
	if w < 0 {
		if errno() != EAGAIN && errno() != 4 {
			obLen = 0
			close_conn(c)
			return false
		}
		w = 0
	}
	if w < obLen {
		pend_out(c, ob+w, obLen-w)
		obLen = 0
		ev_conn_write(c[cFD])
		c[cWriting] = 1
		write_deadline(c)
		return true
	}
	obLen = 0
	if c[cClose] != 0 {
		close_or_linger(c)
		return false
	}
	return true
}

fn pend_out(c i64, p i64, n i64) {
	if c[cOut] == 0 {
		c[cOut] = malloc(n)
		memcpy(c[cOut], p, n)
		c[cOutLen] = n
		c[cOutOff] = 0
		return
	}
	c[cOut] = realloc(c[cOut], c[cOutLen]+n)
	memcpy(c[cOut]+c[cOutLen], p, n)
	c[cOutLen] += n
}

fn on_write(c i64) {
	if c[cH2] != 0 {
		h2_on_write(c)
		return
	}
	if c[cOut] == 0 {
		return
	}
	let w = rt_sys_write(c[cFD], c[cOut]+c[cOutOff], c[cOutLen]-c[cOutOff])
	if w < 0 {
		if errno() != EAGAIN && errno() != 4 {
			close_conn(c)
		}
		return
	}
	c[cOutOff] += w
	if c[cOutOff] < c[cOutLen] {
		write_deadline(c)
		return
	}
	free(c[cOut])
	c[cOut] = 0
	c[cOutLen] = 0
	c[cOutOff] = 0
	c[cWriting] = 0
	if c[cClose] != 0 {
		close_or_linger(c)
		return
	}
	ev_conn_read(c[cFD])
	arm(c, c[cIn] != 0)
	if c[cIn] != 0 || (c[cTls] != 0 && gTlsPending(c) != 0) {
		// Input TLS already took from the socket is not reported again.
		on_read(c)
	}
}

// write_deadline gives a client that is not reading its response until the write timeout,
// counted from the last progress.
fn write_deadline(c i64) {
	c[cDeadline] = 0
	if gWriteMs > 0 {
		c[cDeadline] = loopNow + gWriteMs*1000000
	}
}

fn lower(c u8) u8 {
	if c >= 'A' && c <= 'Z' {
		return c + 32
	}
	return c
}

// name_is reports whether the header name at p (n bytes) is lname, ignoring case.
fn name_is(p i64, n i64, lname str) bool {
	if n != len(lname) {
		return false
	}
	for i in 0..n {
		if lower(load8(p+i)) != lname[i] {
			return false
		}
	}
	return true
}

// bytes_are reports whether the n bytes at p equal s.
fn bytes_are(p i64, n i64, s str) bool {
	if n != len(s) {
		return false
	}
	for i in 0..n {
		if load8(p+i) != s[i] {
			return false
		}
	}
	return true
}

fn method_str(p i64, n i64) str {
	let c = load8(p)
	if n == 3 && c == 'G' && load8(p+1) == 'E' && load8(p+2) == 'T' {
		return "GET"
	}
	if c == 'P' && bytes_are(p, n, "POST") {
		return "POST"
	}
	if c == 'P' && bytes_are(p, n, "PUT") {
		return "PUT"
	}
	if c == 'H' && bytes_are(p, n, "HEAD") {
		return "HEAD"
	}
	if c == 'D' && bytes_are(p, n, "DELETE") {
		return "DELETE"
	}
	return rt_str_from_raw(p, n)
}

// serve_one handles the request at p (n bytes available): the bytes it used, or 0
// when the request has not fully arrived.
fn serve_one(c i64, p i64, n i64) i64 {
	let nl = memchr(p, '\n', n)
	if nl == 0 {
		c[cNeed] = 0
		if n > maxLine {
			bad(c, 414)
		}
		return 0
	}
	let le = nl - p
	if le > maxLine {
		bad(c, 414)
		return -1
	}
	mut ll = le
	if ll > 0 && load8(p+ll-1) == '\r' {
		ll -= 1
	}
	mut sp1 = -1
	mut sp2 = -1
	mut nsp = 0
	mut ctl = false
	for i in 0..ll {
		let b = load8(p + i)
		if b == ' ' {
			if sp1 < 0 {
				sp1 = i
			}
			sp2 = i
			nsp += 1
		} else if b < ' ' || b == 0x7f {
			ctl = true
		}
	}
	let minor = load8(p + ll - 1)
	if ctl || nsp != 2 || sp1 <= 0 || sp2 <= sp1+1 || ll-sp2-1 != 8 || !is_http1(p+sp2+1) || minor < '0' || minor > '9' {
		if ll == 14 && bytes_are(p, 14, "PRI * HTTP/2.0") && c[cTls] == 0 {
			// The HTTP/2 client preface starts like a request line: h2c with prior knowledge (#360).
			// Over TLS, HTTP/2 is agreed by ALPN instead (RFC 9113 3.3).
			return h2_enter(c, p, n)
		}
		// Control bytes (a bare CR, NUL, tab) are not allowed anywhere in the request line.
		bad(c, 400)
		return -1
	}
	// HTTP/1.0 closes unless it asks for keep-alive; 1.1 and later 1.x keep the connection.
	let http10 = minor == '0'
	mut alive = !http10
	mut ts = sp1 + 1
	mut tn = sp2 - sp1 - 1
	if tn > 7 && (load8(p+ts) == 'h' || load8(p+ts) == 'H') {
		// Absolute-form ("http://host/path?q", RFC 9112 3.2.2): route on the path.
		mut k = 0
		if name_is(p+ts, 7, "http://") {
			k = 7
		} else if tn > 8 && name_is(p+ts, 8, "https://") {
			k = 8
		}
		if k > 0 {
			for k < tn && load8(p+ts+k) != '/' && load8(p+ts+k) != '?' {
				k += 1
			}
			ts += k
			tn -= k
		}
	}
	mut hosts = 0
	mut expect100 = false
	mut seenClose = false
	mut upgrade = false // Connection lists upgrade: maybe Upgrade: h2c (#360)
	mut pos = le + 1
	mut cl = 0
	mut seenCL = false
	mut chunked = false
	mut hend = 0
	for {
		mut e = memchr(p+pos, '\n', n-pos)
		if e == 0 {
			c[cNeed] = 0
			if n > maxLine {
				bad(c, 431)
			}
			return 0
		}
		let l = e - (p + pos)
		if l == 0 || (l == 1 && load8(p+pos) == '\r') {
			hend = pos + l + 1
			break
		}
		if pos+l > maxLine {
			bad(c, 431)
			return -1
		}
		let h = p + pos
		let kn = field_name(h, l)
		if kn == 0 {
			// Rejected, not skipped: a parser that trims or unfolds the line could frame
			// the request differently (RFC 9112 5.1, 5.2).
			bad(c, 400)
			return -1
		}
		// A CR inside a field line (only the one before LF is allowed) or a NUL is rejected: a
		// proxy that ends lines at a bare CR would frame the request differently (RFC 9112 2.2).
		mut vl = l
		if vl > 0 && load8(h+vl-1) == '\r' {
			vl -= 1
		}
		if memchr(h, '\r', vl) != 0 || memchr(h, 0, vl) != 0 {
			bad(c, 400)
			return -1
		}
		let f = lower(load8(h))
		if f == 'h' && kn == 4 && name_is(h, kn, "host") {
			hosts += 1
		} else if f == 'e' && kn == 6 && name_is(h, kn, "expect") {
			mut j = kn + 1
			for j < vl && (load8(h+j) == ' ' || load8(h+j) == '\t') {
				j += 1
			}
			mut e = vl
			for e > j && (load8(h+e-1) == ' ' || load8(h+e-1) == '\t') {
				e -= 1
			}
			expect100 = name_is(h+j, e-j, "100-continue")
		} else if f == 'c' && kn == 14 && name_is(h, kn, "content-length") {
			let v = parse_cl(h+kn+1, l-kn-1)
			// Repeated Content-Length headers must agree, or the framing is ambiguous (RFC 9112 6.3).
			if v < 0 || (seenCL && v != cl) {
				bad(c, 400)
				return -1
			}
			cl = v
			seenCL = true
		} else if f == 'c' && kn == 10 && name_is(h, kn, "connection") {
			// A comma-separated list of tokens: "close" anywhere wins (RFC 9112 9.6).
			mut j = kn + 1
			for j < vl {
				for j < vl && (load8(h+j) == ' ' || load8(h+j) == '\t' || load8(h+j) == ',') {
					j += 1
				}
				mut e = j
				for e < vl && load8(h+e) != ',' && load8(h+e) != ' ' && load8(h+e) != '\t' {
					e += 1
				}
				if name_is(h+j, e-j, "close") {
					alive = false
					seenClose = true
				} else if name_is(h+j, e-j, "keep-alive") && !seenClose {
					alive = true
				} else if name_is(h+j, e-j, "upgrade") {
					upgrade = true
				}
				j = e
			}
		} else if f == 't' && kn == 17 && name_is(h, kn, "transfer-encoding") {
			// chunked is the only coding understood (RFC 9112 6.1, 7): another is 501, and chunked
			// listed twice is malformed.
			mut j = kn + 1
			for j < vl && (load8(h+j) == ' ' || load8(h+j) == '\t') {
				j += 1
			}
			mut e = vl
			for e > j && (load8(h+e-1) == ' ' || load8(h+e-1) == '\t') {
				e -= 1
			}
			if !name_is(h+j, e-j, "chunked") {
				bad(c, 501)
				return -1
			}
			if chunked {
				bad(c, 400)
				return -1
			}
			chunked = true
		}
		pos += l + 1
	}
	if !http10 && hosts != 1 {
		// HTTP/1.1 requires exactly one Host field (RFC 9112 3.2).
		bad(c, 400)
		return -1
	}
	mut total = hend + cl
	pTr = 0
	pTrLen = 0
	mut streamMode = 0 // a Router.Stream route whose body is still arriving (#481): 1 by length, 2 chunked
	if chunked {
		// Both framings at once is how requests are smuggled past a proxy (RFC 9112 6.3).
		if seenCL {
			bad(c, 400)
			return -1
		}
		let r = chunk_scan(p, hend, n)
		if r < 0 {
			bad(c, -r)
			return -1
		}
		if r == 0 && route_streams(p, sp1, p+ts, tn) {
			streamMode = 2
		}
		if r == 0 && streamMode == 0 {
			c[cNeed] = 0
			if expect100 && !http10 && c[cSent100] == 0 {
				ob_room(32)
				ob_str("HTTP/1.1 100 Continue\r\n\r\n")
				c[cSent100] = 1
			}
			return 0
		}
		if streamMode == 0 {
			chunk_decode(p, hend)
			cl = ckLen
			total = ckEnd
			pTr = ckTr
			pTrLen = ckTrEnd - ckTr
		}
	}
	if !chunked && n < total && cl <= maxStreamBody && route_streams(p, sp1, p+ts, tn) {
		streamMode = 1
	}
	mut streamLeft = 0
	if streamMode != 0 {
		// The rest of the body is read by the handler, or not at all: a refusal below closes.
		if streamMode == 1 {
			streamLeft = cl // the whole body: what came with the headers is read from it first
		}
		cl = 0
		total = n
	}
	if cl > gMaxBody && streamMode == 0 {
		bad(c, 413)
		return -1
	}
	if n < total && streamMode == 0 {
		c[cNeed] = total
		if expect100 && !http10 && c[cSent100] == 0 {
			// The client waits for this before sending its body (RFC 9110 10.1.1): without it,
			// curl and most SDKs stall about a second on every upload.
			ob_room(32)
			ob_str("HTTP/1.1 100 Continue\r\n\r\n")
			c[cSent100] = 1
		}
		return 0
	}
	c[cNeed] = 0
	c[cSent100] = 0
	if upgrade && !http10 && !chunked && !draining && c[cTls] == 0 && streamMode == 0 {
		// Upgrade: h2c is for cleartext only (RFC 9113 3.2).
		pTs = ts
		pTn = tn
		if h2_upgrade(c, p, n, total, sp1, le, hend, cl) {
			return n // the connection speaks HTTP/2 now; the request is its stream 1 (#360)
		}
	}
	if waiting >= maxWaiting {
		// Backpressure: too many requests already wait on this core.
		bad(c, 503)
		return total
	}
	if gMemSoft > 0 && rt_mem_held() > gMemSoft {
		// Past the soft memory limit (TIN_MEMORY_SOFT, #356): refuse new requests rather than
		// let the container's limit end the process; the requests already running go on.
		overloaded()
		shed(c, sp1 == 4 && load8(p) == 'H' && bytes_are(p, 4, "HEAD"), http10 && alive, !alive || streamMode != 0)
		if !alive || streamMode != 0 {
			c[cClose] = 1
		}
		return total
	}
	if gAdmit != nil {
		if !gAdmit(Load{Core: myID, Waiting: waiting, Conns: __atomic_load(gLoad + myID*128), Buffered: bufBytes, Shed: shedCount, Pool: rt_mem_pool(), Ingot: rt_mem_ingot()}) {
			overloaded()
			shed(c, sp1 == 4 && load8(p) == 'H' && bytes_are(p, 4, "HEAD"), http10 && alive, !alive || streamMode != 0)
			if !alive || streamMode != 0 {
				c[cClose] = 1
			}
			return total
		}
	}
	if shedAt != 0 && rt_mono_ns()-shedAt >= recoverNs {
		recovered()
	}
	// The handler runs in a task: when it waits (tide.Wait, a client call) the core serves
	// other connections, and this one's later requests queue until it finishes.
	pReq = p
	pReqLen = total
	pSp1 = sp1
	pSp2 = sp2
	pLe = le
	pHend = hend
	pCl = cl
	pHead = sp1 == 4 && load8(p) == 'H' && bytes_are(p, 4, "HEAD")
	pTs = ts
	pTn = tn
	pKeep10 = http10 && alive
	pClose = !alive
	pHttp10 = http10
	let task = rt_task_new(run_request, c)
	if gReplayTape != 0 {
		rt_tape_set(task, gReplayTape) // the recorded request's effects come from its capsule (#242)
	}
	// The request's boundary: its deadline and cancel state (notes/interface_boundaries.md).
	if rt_bnd_task(task, rt_bnd_core(), bkRequest) != nil {
		rt_task_free(task)
		bad(c, 503)
		return total
	}
	if gReqMemory > 0 {
		rt_bnd_set_limit(task[tBnd], gReqMemory, 0)
	}
	// A panic in the handler ends its request with 500, not the server (#142).
	rt_task_recover(task)
	if gDeadlineMs > 0 {
		rt_task_set_deadline(task, rt_mono_ns()+gDeadlineMs*1000000)
	}
	if gRecord && streamMode == 0 {
		if chunked {
			// replay frames the recorded bytes again: keep the decoded form (#349)
			let rec = chunked_record(p)
			record_start(task, c, rec, ckRecLen)
			free(rec)
		} else {
			record_start(task, c, p, total)
		}
	}
	if streamMode != 0 {
		// The handler reads the body as it arrives: what came with the headers is the reader's,
		// and the socket is the handler's task's until it returns (stream_body.tin).
		body_begin(c, streamMode, streamLeft, p+hend, n-hend, expect100 && !http10 && c[cSent100] == 0)
	}
	if rt_task_run(task) {
		mut streamed = false
		if c[cStream] != 0 {
			streamed = stream_abort(c) // it ended in a panic or a cancel before it finished (#350)
		}
		if rt_task_panicked(task) && !streamed {
			panicked(c, task)
		}
		if c[cBody] != 0 {
			body_end(c) // the handler panicked before it was done with the body (#481)
		}
		if gRecord {
			record_end(task)
		}
		rt_task_free(task)
		if !alive || draining {
			c[cClose] = 1
		}
		return total
	}
	// It waits: keep its own copy of the request bytes (the read buffer is reused).
	let rb = malloc(total)
	memcpy(rb, p, total)
	task[tUser+1] = rb
	rebase_request(task, rb-p)
	c[cTask] = task
	c[cAlive] = i64(alive)
	if c[cHijack] == 0 {
		waiting += 1
	}
	return total
}

// run_request is a request task's body: build the Req and Out, run the handler, and append
// the response to the core's output batch.
fn run_request(c i64) {
	let p = pReq
	let t = p + pTs
	let tn = pTn
	let q = Req{Method: method_str(p, pSp1), Path: "", Query: "", hp: p + pLe + 1, hn: pHend - pLe - 1, bp: p + pHend, bn: pCl, tp: p + pTr, tn: pTrLen, cn: c}
	let qm = memchr(t, '?', tn)
	if qm == 0 {
		q.Path = rt_str_from_raw(t, tn)
	} else {
		q.Path = rt_str_from_raw(t, qm-t)
		q.Query = rt_str_from_raw(qm+1, tn-(qm-t)-1)
	}
	if len(q.Path) == 0 {
		q.Path = "/"
	}
	let hd = pHead
	let keep10 = pKeep10
	mut closes = pClose
	c[cStFlags] = i64(hd) | i64(pHttp10)<<1 | i64(keep10)<<2 | i64(closes)<<3
	body_bind(c)
	let body = make([]u8, 0, 1024)
	let w = Out{Body: body, code: 200, ctype: "text/plain; charset=utf-8", extra: make([]u8, 0, 256), own: body}
	rt_task_current()[tUser] = cast(i64, q)
	if gRoutes != 0 {
		dispatch(cast(rtable, gRoutes), mut q, mut w)
	} else {
		gHandler(q, mut w)
	}
	if c[cBody] != 0 && body_end(c) {
		closes = true // the body was not read to its end: what is left is not a request (#481)
	}
	if c[cHijack] == 0 {
		if gRecord {
			record_status(w.code)
		}
		if c[cStream] >= 2 {
			stream_end(c, w)
		} else {
			respond_out(w, hd, keep10, closes)
		}
	}
}

// rebase_request points a waiting task's Req at its own copy of the request bytes.
fn rebase_request(task i64, delta i64) {
	let q = cast(Req, task[tUser])
	q.hp += delta
	q.bp += delta
	q.tp += delta
}

// finish_request completes connection c after its waiting task finished: write the
// response, then serve the requests that queued behind it.
fn finish_request(c i64, task i64) {
	if c[cHs] != 0 {
		// A TLS handshake task, not a request (serve_tls.tin).
		gTlsDone(c, task)
		return
	}
	if c[cH2] != 0 {
		h2_finish(c, task) // a stream's task (#360)
		return
	}
	free(task[tUser+1])
	mut streamed = false
	if c[cStream] != 0 {
		// The handler ended in a panic or a cancel while it streamed: what was sent cannot be
		// followed by an error page, so the connection closes.
		streamed = stream_abort(c)
	}
	if rt_task_panicked(task) && c[cHijack] == 0 && c[cDead] == 0 && !streamed {
		panicked(c, task)
	}
	if c[cBody] != 0 {
		body_end(c) // the handler panicked or was cancelled before it was done with the body (#481)
	}
	if gRecord {
		record_end(task)
	}
	rt_task_free(task)
	if c[cHijack] != 0 {
		if c[cTls] != 0 {
			gTlsBye(c)
		}
		rt_sys_close(c[cFD])
		free_conn(c)
		return
	}
	waiting -= 1
	c[cTask] = 0
	if c[cDead] != 0 {
		obLen = 0
		free_conn(c)
		return
	}
	if c[cAlive] == 0 || draining {
		c[cClose] = 1
	}
	if !flush(c) {
		return
	}
	if c[cWriting] == 0 {
		on_read(c)
	}
}

// resume_task continues a task that waited; when it ends, its connection moves on.
fn resume_task(task i64) {
	if rt_task_run(task) {
		if rt_task_is_child(task) {
			// A scope's child task (#232): the runtime finishes it.
			rt_task_finish_child(task)
			return
		}
		finish_request(task[tArg], task)
	}
}

// task_watch is the runtime's wait hook: watch fd for the running task.
fn task_watch(fd i64, want i64) {
	fdTask[fd] = rt_task_current()
	ev_task_add(fd, want)
}

fn task_unwatch(fd i64) {
	ev_task_del(fd)
	fdTask[fd] = 0
}

// take_jobs resumes the tasks whose helper jobs finished.
fn take_jobs() {
	let buf = word
	for {
		let n = rt_sys_read(doneRd, buf, 8)
		if n != 8 {
			return
		}
		let job = buf[0]
		let task = rt_helper_done(job)
		if task != 0 {
			rt_task_ready(task)
			resume_task(task)
		}
	}
}

// ring_watch is the runtime's ring hook: watch the io_uring a task just made on this core; its
// completions wake their tasks, which the next turn of the loop resumes.
fn ring_watch(fd i64) {
	ringRd = fd
	ev_level(fd)
}

// run_timers resumes every task whose wait is over.
fn run_timers() {
	mut task = rt_timer_pop(rt_mono_ns())
	for task != 0 {
		resume_task(task)
		task = rt_timer_pop(rt_mono_ns())
	}
	// Tasks woken by other tasks; the ones they wake in turn wait for the next pass.
	mut n = rt_task_ready_count()
	for n > 0 {
		resume_task(rt_task_take_ready())
		n -= 1
	}
}

// wait_ms is how long the event loop may block: until the earliest task wake-up or the next
// sweep of connection deadlines.
fn wait_ms() i64 {
	if rt_task_any_ready() {
		return 0
	}
	mut next = rt_timer_next()
	if next < 0 || next > nextSweep {
		next = nextSweep
	}
	let d = next - rt_mono_ns()
	if d <= 0 {
		return 0
	}
	return (d + 999999) / 1000000
}

// sweep closes the connections past their deadline: a request that does not arrive in time,
// an idle keep-alive connection, or a client that stopped reading its response. Connections
// whose request is running are left to the request deadline.
fn sweep() {
	{
		mut fd = 0
		for fd <= hiFd {
			let c = conns[fd]
			if c != 0 && c[cDeadline] != 0 && c[cDeadline] <= loopNow && c[cTask] == 0 && c[cHijack] == 0 {
				close_conn(c)
			} else if c != 0 && c[cH2] != 0 {
				h2_sweep(c) // stream read timeouts, and GOAWAY when draining (#360)
			}
			fd += 1
		}
	}
}

// arm sets c's deadline for its state once a read or a response is done: a request still
// arriving (header timeout until its headers are in, then the read timeout, both from its
// first bytes), or an idle keep-alive connection.
fn arm(c i64, partial bool) {
	if c[cH2] != 0 {
		h2_arm(c)
		return
	}
	if c[cTask] != 0 || c[cHijack] != 0 {
		c[cDeadline] = 0
		return
	}
	if c[cWriting] != 0 {
		return
	}
	if partial {
		if c[cStart] == 0 {
			c[cStart] = loopNow
		}
		mut ms = gHeaderMs
		if c[cNeed] > 0 {
			ms = gReadMs
		}
		c[cDeadline] = 0
		if ms > 0 {
			c[cDeadline] = c[cStart] + ms*1000000
		}
		return
	}
	c[cStart] = 0
	c[cDeadline] = 0
	if gIdleMs > 0 {
		c[cDeadline] = loopNow + gIdleMs*1000000
	}
}

// env_int is environment variable name as a non-negative decimal number, or def when it is
// unset or not one.
fn env_int(name str, def i64) i64 {
	let p = rt_getenv(cast(i64, name) + 8)
	if p == 0 {
		return def
	}
	mut v = 0
	mut n = 0
	for {
		let d = load8(p + n)
		if d == 0 {
			break
		}
		if d < '0' || d > '9' || n > 15 {
			return def
		}
		v = v*10 + i64(d-'0')
		n += 1
	}
	if n == 0 {
		return def
	}
	return v
}

// request_budget is the default TIN_REQUEST_MEMORY for n cores (#356): a quarter of the memory
// limit (the container's, else the machine's) per core, at least 64 MiB; 0 (no bound) when
// neither is known.
fn request_budget(n i64) i64 {
	mut limit_ = rt_mem_limit()
	if limit_ <= 0 {
		limit_ = rt_mem_total()
	}
	if limit_ <= 0 {
		return 0
	}
	let b = limit_ / n / 4
	if b < 67108864 {
		return 67108864
	}
	return b
}

// Timeouts sets the connection timeouts in milliseconds; 0 turns one off. header: a
// request's line and headers must arrive within it (slowloris); read: the whole request,
// body included; idle: a keep-alive connection with no request in progress; write: a
// response the client stops reading (no progress for this long). A connection is closed
// when one passes; a request whose handler is running is governed by Deadline instead.
// Defaults 10000, 60000, 60000 and 30000; TIN_HEADER_TIMEOUT_MS, TIN_READ_TIMEOUT_MS,
// TIN_IDLE_TIMEOUT_MS and TIN_WRITE_TIMEOUT_MS override them. Call before Serve.
fn Timeouts(header i64, read i64, idle i64, write i64) {
	gHeaderMs = header
	gReadMs = read
	gIdleMs = idle
	gWriteMs = write
	gTimeoutsSet = true
}

// Load is what an admission policy sees of the core a new request arrived on: its waiting
// request tasks, live connections, bytes buffered for requests still arriving, how many
// requests were refused so far, the request-pool bytes its requests hold beyond each one's
// first chunk (what TIN_REQUEST_MEMORY counts), and the bytes its long-lived (ingot) heap
// holds (design_semantics §11).
type Load struct {
	Core     i64
	Waiting  i64
	Conns    i64
	Buffered i64
	Shed     i64
	Pool     i64
	Ingot    i64
}

// Admit sets the admission policy (call before Serve): after the built-in limits, p decides
// each new request before its handler runs; false answers 503 with Retry-After: 1 without
// running the handler. Every core calls p with its own Load.
fn Admit(p fn(Load) bool) {
	gAdmit = p
}

// recoverNs is how long a core admits every request after its last refusal before it counts
// as recovered: the hysteresis between server.overload and server.recovered.
const recoverNs = 1000000000

// overloaded notes that this core shed a request: the first core to shed makes the server
// OVERLOADED and runs the on server.overload handlers.
fn overloaded() {
	if shedAt == 0 && __atomic_add(&gOverCores, 1) == 0 {
		rt_life_overload(false)
	}
	shedAt = rt_mono_ns()
}

// recovered notes that this core admitted a request recoverNs after it last shed: when no
// core sheds any more the server is RUNNING again and the on server.recovered handlers run.
fn recovered() {
	shedAt = 0
	if __atomic_add(&gOverCores, -1) == 1 {
		rt_life_overload(true)
	}
}

// shed answers a request the admission policy refused from static bytes, so refusing
// allocates nothing; the connection stays open when the client keeps it alive.
fn shed(c i64, hd bool, keep10 bool, closes bool) {
	shedCount += 1
	ob_room(256)
	ob_str("HTTP/1.1 503 Service Unavailable\r\n")
	ob_raw(common, commonLen)
	ob_str("Retry-After: 1\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 19\r\n")
	if draining || closes {
		ob_str("Connection: close\r\n")
	} else if keep10 {
		ob_str("Connection: keep-alive\r\n")
	}
	ob_str("\r\n")
	if !hd {
		ob_str("Service Unavailable")
	}
	if draining {
		c[cClose] = 1
	}
}

// Limits sets the largest request body in bytes (413 past it), the bytes of requests still
// arriving that one core may buffer (a new partial request past it gets 503 and close), and
// the connections per core (more are closed at accept; 0: no limit). Defaults 64 MiB,
// 256 MiB and 16384; TIN_MAX_BODY, TIN_MAX_BUFFERED and TIN_MAX_CONNS override them. Call
// before Serve.
fn Limits(maxBody i64, maxBuffered i64, maxConns i64) {
	gMaxBody = maxBody
	gMaxBuffered = maxBuffered
	gMaxConns = maxConns
	gLimitsSet = true
}

// Deadline makes every request's waits (tide.Wait, client calls) fail with "deadline
// exceeded" once ms have passed since the request started (0: no deadline; call before
// Serve). TIN_DEADLINE_MS sets it too; the default is 30000.
fn Deadline(ms i64) {
	gDeadlineMs = ms
	gDeadlineSet = true
}

// is_http1 reports whether the 8 bytes at p start with "HTTP/1.".
fn is_http1(p i64) bool {
	return load8(p) == 'H' && load8(p+1) == 'T' && load8(p+2) == 'T' && load8(p+3) == 'P' && load8(p+4) == '/' && load8(p+5) == '1' && load8(p+6) == '.'
}

// field_name is the length of the name of the header line at h (l bytes): a token
// followed by ':'. 0 means it is not a field line: no colon, an empty name, whitespace
// before the colon, obs-fold or another byte a token cannot hold.
fn field_name(h i64, l i64) i64 {
	let tok = gTok
	mut i = 0
	for i < l && load8(tok+i64(load8(h+i))) != 0 {
		i += 1
	}
	if i < l && load8(h+i) == ':' {
		return i
	}
	return 0
}

// parse_cl parses a Content-Length value (n bytes at p): the length, -1 when it is not a plain decimal number.
// chunk_scan reads a chunked body (RFC 9112 7.1) from offset at of the n bytes at p: 1 when
// it is complete (ckLen, ckEnd, ckTr and ckTrEnd say where things are), 0 when more input
// is needed, -400 when it is malformed and -413 past the body limit. Chunk extensions are
// skipped; every line ends in CRLF, as a proxy that took a bare LF would frame differently.
fn chunk_scan(p i64, at i64, n i64) i64 {
	mut pos = at
	mut total = 0
	for {
		if pos-at > gMaxBody+maxLine {
			return -413
		}
		let e = memchr(p+pos, '\n', n-pos)
		if e == 0 {
			if n-pos > maxLine {
				return -400
			}
			return 0
		}
		let l = e - (p + pos)
		if l < 2 || load8(p+pos+l-1) != '\r' {
			return -400
		}
		mut size = 0
		mut d = 0
		for d < l-1 && hexval(u8(load8(p+pos+d))) >= 0 {
			if d >= 15 {
				return -400
			}
			size = size*16 + hexval(u8(load8(p+pos+d)))
			d += 1
		}
		if d == 0 {
			return -400
		}
		if d < l-1 {
			let x = load8(p + pos + d)
			if (x != ';' && x != ' ' && x != '\t') || memchr(p+pos+d, '\r', l-1-d) != 0 || memchr(p+pos+d, 0, l-1-d) != 0 {
				return -400
			}
		}
		pos += l + 1
		if size == 0 {
			break
		}
		total += size
		if total > gMaxBody {
			return -413
		}
		if n-pos < size+2 {
			return 0
		}
		if load8(p+pos+size) != '\r' || load8(p+pos+size+1) != '\n' {
			return -400
		}
		pos += size + 2
	}
	// The trailer section: field lines like the header block's, then an empty line.
	let tr = pos
	for {
		let e = memchr(p+pos, '\n', n-pos)
		if e == 0 {
			if n-tr > maxLine {
				return -400
			}
			return 0
		}
		let l = e - (p + pos)
		if l == 1 && load8(p+pos) == '\r' {
			ckTrEnd = pos
			pos += 2
			break
		}
		if l < 2 || load8(p+pos+l-1) != '\r' || pos+l-tr > maxLine {
			return -400
		}
		if field_name(p+pos, l) == 0 || memchr(p+pos, '\r', l-1) != 0 || memchr(p+pos, 0, l-1) != 0 {
			return -400
		}
		pos += l + 1
	}
	ckLen = total
	ckEnd = pos
	ckTr = tr
	return 1
}

// chunked_record is a decoded chunked request at p as replay records it (#349): the request
// line and header block without Transfer-Encoding, a Content-Length for the decoded body,
// the trailer fields, the empty line and the body, in a malloc'd buffer of ckRecLen bytes.
fn chunked_record(p i64) i64 {
	let b = malloc(pHend + 32 + pTrLen + pCl)
	memcpy(b, p, pLe+1)
	mut o = pLe + 1
	mut pos = pLe + 1
	for pos < pHend {
		let e = memchr(p+pos, '\n', pHend-pos)
		let l = e - (p + pos)
		if l == 0 || (l == 1 && load8(p+pos) == '\r') {
			break
		}
		let kn = field_name(p+pos, l)
		if !(kn == 17 && name_is(p+pos, kn, "transfer-encoding")) {
			memcpy(b+o, p+pos, l+1)
			o += l + 1
		}
		pos += l + 1
	}
	let cl = say.Fmt("Content-Length: %d\r\n", pCl)
	memcpy(b+o, cast(i64, cl)+8, len(cl))
	o += len(cl)
	memcpy(b+o, p+pTr, pTrLen)
	o += pTrLen
	store8(b+o, '\r')
	store8(b+o+1, '\n')
	o += 2
	memcpy(b+o, p+pHend, pCl)
	ckRecLen = o + pCl
	return b
}

// chunk_decode moves a chunked body that chunk_scan accepted into place: the data of every
// chunk right after the header block at offset at, then the trailer field lines (ckTr and
// ckTrEnd move with them). Each move goes down, into bytes already read.
fn chunk_decode(p i64, at i64) {
	mut pos = at
	mut out = at
	for {
		let e = memchr(p+pos, '\n', ckEnd-pos)
		mut size = 0
		mut d = 0
		for hexval(u8(load8(p+pos+d))) >= 0 {
			size = size*16 + hexval(u8(load8(p+pos+d)))
			d += 1
		}
		pos = e - p + 1
		if size == 0 {
			break
		}
		memmove(p+out, p+pos, size)
		out += size
		pos += size + 2
	}
	let tn = ckTrEnd - ckTr
	memmove(p+out, p+ckTr, tn)
	ckTr = out
	ckTrEnd = out + tn
}

fn parse_cl(p i64, n i64) i64 {
	mut i = 0
	for i < n && (load8(p+i) == ' ' || load8(p+i) == '\t') {
		i += 1
	}
	mut v = 0
	mut nd = 0
	for i < n {
		let d = load8(p + i)
		if d < '0' || d > '9' {
			break
		}
		if v <= maxStreamBody {
			v = v*10 + i64(d-'0') // exact up to a streamed body's limit (#481), larger past it
		}
		nd += 1
		i += 1
	}
	if nd == 0 {
		return -1
	}
	for i < n {
		let d = load8(p + i)
		if d != ' ' && d != '\t' && d != '\r' {
			return -1
		}
		i += 1
	}
	return v
}

// panicked answers a request whose handler panicked: 500, then the connection closes (the
// panic and its backtrace are on stderr). Nothing of the handler's response was sent yet.
fn panicked(c i64, task i64) {
	let body = make([]u8, 0, 64)
	let code = rt_task_failure_status(task)
	let w = Out{Body: body, code: code, ctype: "text/plain; charset=utf-8", extra: make([]u8, 0), own: body}
	w.Body = append(w.Body, status_text(code)...)
	respond_out(w, false, false, true)
	c[cClose] = 1
}

fn bad(c i64, code i64) {
	let body = make([]u8, 0, 64)
	let w = Out{Body: body, code: code, ctype: "text/plain; charset=utf-8", extra: make([]u8, 0), own: body}
	w.Body = append(w.Body, status_text(code)...)
	respond_out(w, false, false, true)
	c[cClose] = 1
	c[cLinger] = 1
}

// lingerMs bounds how long a connection closed after an error response keeps reading.
const lingerMs = 2000

// linger ends a connection after an error response without losing the response: closing a
// socket with unread input (a client still sending the body of a 413 or 503) makes the kernel
// reset it, and the client may never read the answer. So the sending side is shut down and
// whatever arrives is read and dropped until the client closes or lingerMs pass (as nginx's
// lingering close).
fn linger(c i64) {
	if c[cTls] != 0 {
		gTlsBye(c) // close_notify before the sending side shuts
	}
	rt_sys_shutdown(c[cFD], 1)
	c[cLinger] = 2
	if c[cIn] != 0 {
		bufBytes -= c[cInCap]
		free(c[cIn])
		c[cIn] = 0
		c[cInLen] = 0
		c[cInCap] = 0
	}
	c[cDeadline] = loopNow + lingerMs*1000000
}

// close_or_linger closes c once its last response is out: at once, or by lingering after an
// error response.
fn close_or_linger(c i64) {
	if c[cLinger] != 0 && c[cTask] == 0 {
		linger(c)
		return
	}
	close_conn(c)
}

fn ob_room(n i64) {
	if obLen+n > obCap {
		for obLen+n > obCap {
			obCap *= 2
		}
		ob = realloc(ob, obCap)
	}
}

fn ob_str(s str) {
	memcpy(ob+obLen, cast(i64, s)+8, len(s))
	obLen += len(s)
}

fn ob_raw(p i64, n i64) {
	memcpy(ob+obLen, p, n)
	obLen += n
}

// respond_out appends response w to the core's output batch; keep10 adds
// "Connection: keep-alive", which an HTTP/1.0 client needs to keep the connection, and closes
// "Connection: close" for a connection that closes after it.
fn respond_out(w Out, hd bool, keep10 bool, closes bool) {
	let bh = cast(i64, w.Body)
	let eh = cast(i64, w.extra)
	let bn = bh[0]
	ob_room(256 + len(w.ctype) + eh[0] + bn)
	ob_str(status_line(w.code))
	ob_raw(common, commonLen)
	if w.code < 200 || w.code == 204 || w.code == 304 {
		// No body is allowed (RFC 9110 6.4.1): no Content-Type or Content-Length either, and
		// whatever the handler wrote is dropped, or the client would read it as the next response.
		if eh[0] > 0 {
			ob_raw(eh[2], eh[0])
		}
		if draining || closes {
			ob_str("Connection: close\r\n")
		} else if keep10 {
			ob_str("Connection: keep-alive\r\n")
		}
		ob_str("\r\n")
		return
	}
	ob_str("Content-Type: ")
	ob_str(w.ctype)
	ob_str("\r\nContent-Length: ")
	let d = ob + obLen
	mut nd = 1
	{
		mut t = bn
		for t >= 10 {
			nd += 1
			t /= 10
		}
	}
	mut v = bn
	{
		mut i = nd - 1
		for i >= 0 {
			store8(d+i, '0'+v%10)
			v /= 10
			i -= 1
		}
	}
	obLen += nd
	ob_str("\r\n")
	if eh[0] > 0 {
		ob_raw(eh[2], eh[0])
	}
	if draining || closes {
		ob_str("Connection: close\r\n")
	} else if keep10 {
		ob_str("Connection: keep-alive\r\n")
	}
	ob_str("\r\n")
	if !hd {
		ob_raw(bh[2], bn)
	}
}

fn status_line(code i64) str {
	match code {
		200 => {
			return "HTTP/1.1 200 OK\r\n"
		}
		201 => {
			return "HTTP/1.1 201 Created\r\n"
		}
		204 => {
			return "HTTP/1.1 204 No Content\r\n"
		}
		301 => {
			return "HTTP/1.1 301 Moved Permanently\r\n"
		}
		302 => {
			return "HTTP/1.1 302 Found\r\n"
		}
		304 => {
			return "HTTP/1.1 304 Not Modified\r\n"
		}
		400 => {
			return "HTTP/1.1 400 Bad Request\r\n"
		}
		401 => {
			return "HTTP/1.1 401 Unauthorized\r\n"
		}
		403 => {
			return "HTTP/1.1 403 Forbidden\r\n"
		}
		404 => {
			return "HTTP/1.1 404 Not Found\r\n"
		}
		405 => {
			return "HTTP/1.1 405 Method Not Allowed\r\n"
		}
		413 => {
			return "HTTP/1.1 413 Content Too Large\r\n"
		}
		414 => {
			return "HTTP/1.1 414 URI Too Long\r\n"
		}
		431 => {
			return "HTTP/1.1 431 Request Header Fields Too Large\r\n"
		}
		500 => {
			return "HTTP/1.1 500 Internal Server Error\r\n"
		}
		501 => {
			return "HTTP/1.1 501 Not Implemented\r\n"
		}
		503 => {
			return "HTTP/1.1 503 Service Unavailable\r\n"
		}
		502 => {
			return "HTTP/1.1 502 Bad Gateway\r\n"
		}
		504 => {
			return "HTTP/1.1 504 Gateway Timeout\r\n"
		}
	}
	mut b = make([]u8, 0, 32)
	b = append(b, "HTTP/1.1 "...)
	b = append(b, str_int(code)...)
	b = append(b, " Status\r\n"...)
	return str(b)
}

fn status_text(code i64) str {
	let s = status_line(code)
	return s[13 : len(s)-2]
}

fn str_int(v i64) str {
	if v == 0 {
		return "0"
	}
	mut b = make([]u8, 0, 20)
	for v > 0 {
		b = append(b, u8('0'+v%10))
		v /= 10
	}
	for i in 0..len(b)/2 {
		let t = b[i]
		b[i] = b[len(b)-1-i]
		b[len(b)-1-i] = t
	}
	return str(b)
}

// Header returns the value of the request header name (any case), or "". A chunked request's
// trailer fields are read after the header block's.
fn (q Req) Header(name str) str {
	let v = header_in(q.hp, q.hn, name)
	if len(v) == 0 && q.tn > 0 {
		// a chunked body's trailer fields come after the header block's (#349)
		return header_in(q.tp, q.tn, name)
	}
	return v
}

// Proto is the protocol the request came in: "HTTP/2.0" (h2c, or h2 over TLS), "HTTP/1.1" or
// "HTTP/1.0". A request made with Router.Run is "HTTP/1.1".
fn (q Req) Proto() str {
	let c = q.cn
	if c == 0 {
		return "HTTP/1.1"
	}
	if c[cH2] != 0 {
		return "HTTP/2.0"
	}
	if (c[cStFlags] & 2) != 0 {
		return "HTTP/1.0"
	}
	return "HTTP/1.1"
}

// header_in is the value of the field name in the n bytes of field lines at hp, or "".
fn header_in(hp i64, hn i64, name str) str {
	mut p = hp
	let end = hp + hn
	for p < end {
		let e = memchr(p, '\n', end-p)
		if e == 0 {
			return ""
		}
		let l = e - p
		let k = memchr(p, ':', l)
		if k != 0 && k-p == len(name) {
			mut same = true
			for i in 0..len(name) {
				if lower(load8(p+i)) != lower(name[i]) {
					same = false
					break
				}
			}
			if same {
				mut v = k + 1
				for v < e && (load8(v) == ' ' || load8(v) == '\t') {
					v += 1
				}
				mut ve = e
				for ve > v && (load8(ve-1) == '\r' || load8(ve-1) == ' ') {
					ve -= 1
				}
				return rt_str_from_raw(v, ve-v)
			}
		}
		p = e + 1
	}
	return ""
}

// Hijack takes the request's connection out of HTTP for a protocol of its own (the
// websocket package uses it): the responses before this request are written, the core
// stops reading the connection and the request's deadline no longer applies. It returns
// the non-blocking descriptor, for the caller's I/O until the handler returns; then anvil
// closes it. The handler's Out is not sent. An HTTP/2 stream cannot be hijacked: Hijack fails there.
fn (q Req) Hijack() !i64 {
	let task = rt_task_current()
	if task == 0 {
		fail "anvil: Hijack outside a request"
	}
	let c = task[tArg]
	if c[cH2] != 0 {
		fail "anvil: an HTTP/2 stream cannot be hijacked"
	}
	if c[cHijack] != 0 {
		fail "anvil: the connection is already hijacked"
	}
	let fd = c[cFD]
	ev_task_del(fd)
	conns[fd] = 0
	c[cHijack] = 1
	rt_task_set_deadline(task, 0)
	if obLen > 0 {
		if c[cTls] != 0 {
			gTlsSeal(c) // HTTPS: the responses before this one, as records
		}
		pend_out(c, ob, obLen)
		obLen = 0
	}
	for c[cOut] != 0 && c[cOutOff] < c[cOutLen] {
		let k = rt_sys_write(fd, c[cOut]+c[cOutOff], c[cOutLen]-c[cOutOff])
		if k > 0 {
			c[cOutOff] += k
			continue
		}
		let e = errno()
		if e == EAGAIN {
			if rt_task_wait(fd, 2, 0) == waitDeadline {
				// Cancelled: the wait returns at once, so stop instead of spinning (#144).
				break
			}
		} else if e != 4 {
			break
		}
	}
	if c[cOut] != 0 {
		free(c[cOut])
		c[cOut] = 0
	}
	c[cWriting] = 0
	// From here the request always ends through finish_request, which closes it.
	rt_task_defer()
	return fd
}

// ---- streaming responses (#350) ----
//
// A handler that calls w.Stream() sends its response as it goes: the head goes out with the first
// Write or Flush, each Write is one chunk (or part of a Content-Length body), and the handler's
// return ends the response. The task writes to the socket itself and waits for it with
// rt_task_wait when the client reads slowly, so a response is never held in the request pool;
// for that it takes the connection out of the event loop until the response is over.

// Stream switches the response to streaming. The status, content type and headers set so far
// are sent with the first Write or Flush (set them before). The body is then written with Write
// and Flush, in chunks (Transfer-Encoding: chunked), or as a plain body of the size Length gave;
// an HTTP/1.0 client, which cannot read chunks, gets the body up to the end of the connection.
// Each write waits for a slow client within the write timeout (TIN_WRITE_TIMEOUT_MS), and the
// request deadline (TIN_DEADLINE_MS) counts from the last write, so a stream lives as long as it
// keeps writing. Calling Stream again does nothing. On HTTP/2 the body goes in DATA frames within
// the client's flow-control windows, and Length sets content-length.
fn (w mut Out) Stream() ! {
	let c = stream_conn()
	if c == 0 {
		fail "anvil: Stream outside a request"
	}
	if c[cH2] != 0 {
		let s = h2_stream() // an HTTP/2 stream: the body goes in DATA frames (#360)
		if s[sStream] == 0 {
			s[sStream] = 1
			s[sStLen] = -1
		}
		return
	}
	if c[cHijack] != 0 {
		fail "anvil: the connection is hijacked"
	}
	if c[cStream] == 0 {
		c[cStream] = 1
		c[cStLen] = -1
	}
}

// Length sets the size of the streamed body in bytes: the response then has a Content-Length
// header instead of chunks, and the handler must write exactly n bytes. Call it after Stream
// and before the first Write or Flush.
fn (w mut Out) Length(n i64) ! {
	let c = stream_conn()
	if c != 0 && c[cH2] != 0 {
		let s = h2_stream()
		if s[sStream] != 1 {
			fail "anvil: Length is set after Stream and before the first Write"
		}
		if n < 0 {
			fail "anvil: negative Length"
		}
		s[sStLen] = n
		return
	}
	if c == 0 || c[cStream] != 1 {
		fail "anvil: Length is set after Stream and before the first Write"
	}
	if n < 0 {
		fail "anvil: negative Length"
	}
	c[cStLen] = n
}

// Write sends b as part of the body, after the head if that is not out yet. It waits while the
// client does not read, and fails when the client has closed the connection, stopped reading for
// the write timeout, or the request was cancelled: the handler should stop then. Text appended to
// the body with Text or argo.Put(mut w.Body, v) is sent by the next Write or Flush.
fn (w mut Out) Write(b []u8) ! {
	let c = stream_conn()
	if c != 0 && c[cH2] != 0 {
		let s = h2_stream()
		if s[sStream] == 0 {
			fail "anvil: Write needs w.Stream() first"
		}
		try h2_put_body(c, s, mut w)
		let bh = cast(i64, b)
		try h2_put(c, s, w, bh[2], bh[0])
		return
	}
	if c == 0 || c[cStream] == 0 {
		fail "anvil: Write needs w.Stream() first"
	}
	try stream_flush_body(c, mut w)
	let h = cast(i64, b)
	try stream_put(c, w, h[2], h[0])
}

// WriteString is Write for a str.
fn (w mut Out) WriteString(s str) ! {
	let c = stream_conn()
	if c != 0 && c[cH2] != 0 {
		let st = h2_stream()
		if st[sStream] == 0 {
			fail "anvil: WriteString needs w.Stream() first"
		}
		try h2_put_body(c, st, mut w)
		try h2_put(c, st, w, cast(i64, s)+8, len(s))
		return
	}
	if c == 0 || c[cStream] == 0 {
		fail "anvil: WriteString needs w.Stream() first"
	}
	try stream_flush_body(c, mut w)
	try stream_put(c, w, cast(i64, s)+8, len(s))
}

// Flush sends the head if it is not out yet and what Text or argo.Put put in the body so far,
// as one chunk: with it a handler makes a client see an event now.
fn (w mut Out) Flush() ! {
	let c = stream_conn()
	if c != 0 && c[cH2] != 0 {
		let s = h2_stream()
		if s[sStream] == 0 {
			fail "anvil: Flush needs w.Stream() first"
		}
		try h2_put_body(c, s, mut w)
		try h2_put(c, s, w, 0, 0)
		return
	}
	if c == 0 || c[cStream] == 0 {
		fail "anvil: Flush needs w.Stream() first"
	}
	try stream_flush_body(c, mut w)
	try stream_put(c, w, 0, 0)
}

// Abort ends a stream the handler cannot finish (its data source failed halfway): the connection
// closes without the last chunk, so the client sees an incomplete response instead of a short one
// that looks complete. Before the head is sent, the response is an ordinary one again.
fn (w mut Out) Abort() {
	let c = stream_conn()
	if c != 0 && c[cH2] != 0 {
		h2_abort(c, h2_stream()) // RST_STREAM: the client sees the stream fail (#360)
		return
	}
	if c != 0 && c[cStream] >= 2 && c[cStream] != 5 {
		c[cStream] = 5
		c[cClose] = 1
	}
}

// Closed reports whether the client has closed the connection (a stream's handler asks between
// events: a write only fails once the client's reset arrives).
fn (w Out) Closed() bool {
	let c = stream_conn()
	if c == 0 {
		return false
	}
	if c[cH2] != 0 {
		let s = h2_stream()
		return s[sReset] != 0 || h2_gone(c)
	}
	if c[cTls] != 0 {
		return gTlsClosed(c) // HTTPS: a peek sees only records (serve_tls.tin)
	}
	let b = calloc(1, 8)
	let k = rt_sys_recv(c[cFD], b, 1, 2)
	let e = errno()
	free(b)
	if k == 0 {
		return true
	}
	return k < 0 && e != EAGAIN && e != 4
}

// stream_conn is the connection of the request the running task serves, 0 outside one.
fn stream_conn() i64 {
	let task = rt_task_current()
	if task == 0 || rt_task_is_child(task) {
		return 0 // a scope's child does not own the response
	}
	return task[tArg]
}

// stream_flush_body sends the body buffered in w (Text, argo.Put) and empties it.
fn stream_flush_body(c i64, w mut Out) ! {
	let h = cast(i64, w.Body)
	if h[0] > 0 {
		let n = h[0]
		h[0] = 0
		try stream_put(c, w, h[2], n)
	}
}

const streamChunk = 65536

// stream_put sends n bytes at p as body (n may be 0: only the head, if it is not out). The first
// call builds and sends the head.
fn stream_put(c i64, w Out, p i64, n i64) ! {
	if c[cStream] == 5 {
		fail "anvil: the stream is broken (the client went away or stopped reading)"
	}
	if c[cStream] == 1 {
		try stream_begin(c, w)
	}
	let fl = c[cStFlags]
	let mode = c[cStream]
	mut off = p
	mut left = n
	if (fl & 1) != 0 {
		// HEAD: the head, no body.
		left = 0
	}
	if mode == 3 && c[cStSent]+left > c[cStLen] {
		fail "anvil: more bytes written than the Content-Length"
	}
	for {
		let piece = min(left, streamChunk)
		if c[cStPend] == 0 && piece == 0 {
			return
		}
		let buf = c[cStBuf]
		mut out = c[cStPend]
		mut direct = 0
		if mode == 2 && piece > 0 {
			out += put_hex(buf, out, piece)
			memcpy(buf+out, off, piece)
			out += piece
			store8(buf+out, '\r')
			store8(buf+out+1, '\n')
			out += 2
		} else if piece > 0 && out > 0 {
			memcpy(buf+out, off, piece)
			out += piece
		} else if piece > 0 {
			direct = 1
		}
		c[cStPend] = 0
		if direct != 0 {
			try stream_write_all(c, off, piece)
		} else {
			try stream_write_all(c, buf, out)
		}
		c[cStSent] += piece
		off += piece
		left -= piece
		if left == 0 {
			break
		}
	}
	if gDeadlineMs > 0 {
		rt_task_set_deadline(rt_task_current(), rt_mono_ns()+gDeadlineMs*1000000)
	}
}

// put_hex writes v (> 0) in hexadecimal and CRLF at buf+at, and returns how many bytes that took.
fn put_hex(buf i64, at i64, v i64) i64 {
	mut nd = 1
	mut t = v
	for t >= 16 {
		nd += 1
		t /= 16
	}
	mut x = v
	mut i = nd - 1
	for i >= 0 {
		let d = x % 16
		if d < 10 {
			store8(buf+at+i, '0'+d)
		} else {
			store8(buf+at+i, 'a'+d-10)
		}
		x /= 16
		i -= 1
	}
	store8(buf+at+nd, '\r')
	store8(buf+at+nd+1, '\n')
	return nd + 2
}

// stream_begin takes the connection out of the event loop, writes what earlier pipelined responses
// left, and builds the head of the streamed response in the connection's scratch buffer.
fn stream_begin(c i64, w Out) ! {
	if w.code < 200 || w.code == 204 || w.code == 304 {
		fail "anvil: a response with this status has no body to stream"
	}
	let fd = c[cFD]
	let fl = c[cStFlags]
	if obLen > 0 {
		if c[cTls] != 0 {
			gTlsSeal(c) // HTTPS: earlier pipelined responses, as records
		}
		pend_out(c, ob, obLen)
		obLen = 0
	}
	ev_task_del(fd)
	conns[fd] = 0
	c[cWriting] = 0
	c[cStream] = 5
	// Whatever earlier pipelined responses left unwritten goes first.
	for c[cOut] != 0 && c[cOutOff] < c[cOutLen] {
		let k = rt_sys_write(fd, c[cOut]+c[cOutOff], c[cOutLen]-c[cOutOff])
		if k > 0 {
			c[cOutOff] += k
			continue
		}
		try stream_wait(c, k, errno())
	}
	if c[cOut] != 0 {
		free(c[cOut])
		c[cOut] = 0
		c[cOutLen] = 0
		c[cOutOff] = 0
	}
	mut mode = 2
	if c[cStLen] >= 0 {
		mode = 3
	} else if (fl & 2) != 0 {
		mode = 4
	}
	let cap = streamChunk + 1024 + len(w.ctype) + len(w.extra)
	let buf = malloc(cap)
	c[cStBuf] = buf
	c[cStCap] = cap
	mut o = 0
	o += put_str(buf, o, status_line(w.code))
	memcpy(buf+o, common, commonLen)
	o += commonLen
	o += put_str(buf, o, "Content-Type: ")
	o += put_str(buf, o, w.ctype)
	o += put_str(buf, o, "\r\n")
	let eh = cast(i64, w.extra)
	if eh[0] > 0 {
		memcpy(buf+o, eh[2], eh[0])
		o += eh[0]
	}
	if mode == 2 {
		o += put_str(buf, o, "Transfer-Encoding: chunked\r\n")
	} else if mode == 3 {
		o += put_str(buf, o, "Content-Length: ")
		o += put_dec(buf, o, c[cStLen])
		o += put_str(buf, o, "\r\n")
	}
	if draining || mode == 4 || ((fl & 2) != 0 && (fl & 4) == 0) || (fl & 8) != 0 {
		o += put_str(buf, o, "Connection: close\r\n")
	} else if (fl & 4) != 0 {
		o += put_str(buf, o, "Connection: keep-alive\r\n")
	}
	o += put_str(buf, o, "\r\n")
	c[cStPend] = o
	c[cStSent] = 0
	c[cStream] = mode
}

// stream_write_all writes n bytes at p to the client, waiting while it does not read.
fn stream_write_all(c i64, p i64, n i64) ! {
	if c[cTls] != 0 {
		return try gTlsWrite(c, p, n) // HTTPS: sealed into records first (serve_tls.tin)
	}
	mut done = 0
	for done < n {
		let k = rt_sys_write(c[cFD], p+done, n-done)
		if k > 0 {
			done += k
			continue
		}
		try stream_wait(c, k, errno())
	}
}

// stream_wait handles a write that moved nothing (k): wait for the socket to take more, or fail.
// A failure leaves the stream broken and the connection to be closed.
fn stream_wait(c i64, k i64, e i64) ! {
	if k < 0 && e == 4 {
		return
	}
	if k < 0 && e == EAGAIN {
		mut ns = 0
		if gWriteMs > 0 {
			ns = gWriteMs * 1000000
		}
		let r = rt_task_wait(c[cFD], 2, ns)
		if r == waitDeadline {
			c[cStream] = 5
			c[cClose] = 1
			fail cast(fault, rt_wait_fault())
		}
		if r == waitTimeout {
			c[cStream] = 5
			c[cClose] = 1
			fail "anvil: the client stopped reading"
		}
		return
	}
	c[cStream] = 5
	c[cClose] = 1
	fail "anvil: the client closed the connection"
}

// stream_end finishes a streamed response when the handler returns: the body still in w, the
// last chunk, and the connection back in the event loop.
fn stream_end(c i64, w Out) {
	let fl = c[cStFlags]
	let mode = c[cStream]
	if mode == 2 || mode == 3 || mode == 4 {
		let h = cast(i64, w.Body)
		if h[0] > 0 {
			stream_put(c, w, h[2], h[0]) catch _ {
				c[cClose] = 1
			}
		}
	}
	if rt_bnd_stopped() && c[cStream] >= 2 && c[cStream] != 5 {
		c[cStream] = 5 // cancelled, past its deadline or draining: the client must not see a complete body
	}
	let ended = c[cStream]
	if ended == 2 && (fl & 1) == 0 {
		let th = w.tr
		if th != 0 && th[0] > 0 {
			// The last chunk carries the trailer fields (RFC 9112 7.1.2).
			ob_room(8 + th[0])
			ob_str("0\r\n")
			ob_raw(th[2], th[0])
			ob_str("\r\n")
		} else {
			ob_room(8)
			ob_str("0\r\n\r\n")
		}
	} else if ended == 3 && (fl & 1) == 0 && c[cStSent] != c[cStLen] {
		c[cClose] = 1 // a short body: the client cannot tell where it ends
	} else if ended == 4 || ended == 5 {
		c[cClose] = 1
	}
	stream_release(c)
}

// stream_abort ends a stream whose handler did not finish normally; it reports whether the head
// was already sent (then the connection must close).
fn stream_abort(c i64) bool {
	let started = c[cStream] >= 2
	if started {
		c[cClose] = 1
	}
	stream_release(c)
	return started
}

// stream_release frees the scratch buffer and, for a stream that took the connection out of the
// event loop, puts it back.
fn stream_release(c i64) {
	let started = c[cStream] >= 2
	if c[cStBuf] != 0 {
		free(c[cStBuf])
		c[cStBuf] = 0
		c[cStCap] = 0
		c[cStPend] = 0
	}
	if started && c[cDead] == 0 {
		let fd = c[cFD]
		conns[fd] = c
		ev_conn(fd)
	}
	c[cStream] = 0
}

fn put_str(buf i64, at i64, s str) i64 {
	memcpy(buf+at, cast(i64, s)+8, len(s))
	return len(s)
}

// put_dec writes the decimal digits of v (>= 0) at buf+at and returns their count.
fn put_dec(buf i64, at i64, v i64) i64 {
	mut nd = 1
	mut t = v
	for t >= 10 {
		nd += 1
		t /= 10
	}
	mut x = v
	mut i = nd - 1
	for i >= 0 {
		store8(buf+at+i, '0'+x%10)
		x /= 10
		i -= 1
	}
	return nd
}

// SendFile sends n bytes of the file at path, from byte off, as the body (n < 0: to the end of
// the file). As the whole body of a response that is not streaming yet it starts the stream with
// a Content-Length of n, so a download is `w.SendFile(path, 0, -1)`; in a stream already begun,
// the bytes go out as chunks or as part of the Content-Length body. The file goes to the socket
// with sendfile(2) in pieces of 1 MiB on a helper thread, so it is never read into the request
// pool and a slow disk does not stop the core; each piece waits for a slow client within the
// write timeout.
fn (w mut Out) SendFile(path str, off i64, n i64) ! {
	let c = stream_conn()
	if c == 0 {
		fail "anvil: SendFile outside a request"
	}
	if c[cHijack] != 0 {
		fail "anvil: the connection is hijacked"
	}
	let size = try quarry.Size(path)
	if off < 0 || off > size {
		fail "anvil: SendFile starts past the end of the file"
	}
	mut count = n
	if count < 0 {
		count = size - off
	}
	if off + count > size {
		fail "anvil: SendFile asks for more than the file holds"
	}
	if c[cH2] != 0 {
		try h2_sendfile(c, h2_stream(), mut w, path, off, count) // DATA frames within the windows (#360)
		return
	}
	if c[cStream] == 0 {
		c[cStream] = 1
		c[cStLen] = -1
	}
	if c[cStream] == 1 && c[cStLen] < 0 && len(w.Body) == 0 {
		c[cStLen] = count
	}
	try stream_flush_body(c, mut w)
	let fd = c32(rt_sys_open(rt_cstr(path), 0, 0))
	if fd < 0 {
		fail "anvil: SendFile cannot open the file"
	}
	let err = stream_file(c, w, fd, off, count)
	rt_sys_close(fd)
	if err != nil {
		fail err
	}
}

const sendfilePiece = 1048576

// stream_file sends count bytes of file fd from off, framed as the stream needs.
fn stream_file(c i64, w Out, fd i64, off i64, count i64) ! {
	try stream_put(c, w, 0, 0) // the head, if it is not out
	let mode = c[cStream]
	if (c[cStFlags] & 1) != 0 {
		return
	}
	if mode == 3 && c[cStSent]+count > c[cStLen] {
		fail "anvil: more bytes written than the Content-Length"
	}
	mut left = count
	mut at = off
	for left > 0 {
		let piece = min(left, sendfilePiece)
		if mode == 2 {
			let hn = put_hex(c[cStBuf], 0, piece)
			try stream_write_all(c, c[cStBuf], hn)
		}
		mut sent = 0
		for sent < piece {
			let k = try sendfile_step(c, fd, at+sent, piece-sent)
			sent += k
		}
		if mode == 2 {
			store8(c[cStBuf], '\r')
			store8(c[cStBuf]+1, '\n')
			try stream_write_all(c, c[cStBuf], 2)
		}
		c[cStSent] += piece
		at += piece
		left -= piece
		if gDeadlineMs > 0 {
			rt_task_set_deadline(rt_task_current(), rt_mono_ns()+gDeadlineMs*1000000)
		}
	}
}

// sendfile_step moves some of the n bytes at off of file fd to the client on a helper thread,
// waiting for the socket when it is full; it returns how many went.
fn sendfile_step(c i64, fd i64, off i64, n i64) !i64 {
	if c[cTls] != 0 {
		return try gTlsFile(c, fd, off, n) // HTTPS: read, sealed and written (serve_tls.tin)
	}
	for {
		let job = calloc(5, 8)
		job[0] = fd
		job[1] = c[cFD]
		job[2] = off
		job[3] = n
		try rt_helper_run(sendfile_job, job, sendfile_drop)
		let k = job[4]
		free(job)
		if k > 0 {
			return k
		}
		if k == 0 {
			c[cStream] = 5
			c[cClose] = 1
			fail "anvil: the file is shorter than it was when SendFile started"
		}
		if k == -EAGAIN || k == -4 {
			if k == -EAGAIN {
				try stream_wait(c, -1, EAGAIN)
			}
			continue
		}
		c[cStream] = 5
		c[cClose] = 1
		fail "anvil: sendfile failed"
	}
	return 0
}

fn sendfile_job(job i64) {
	job[4] = os_sendfile(job[1], job[0], job[2], job[3])
}

// sendfile_drop frees a job whose request ended before the helper did.
fn sendfile_drop(job i64) {
	free(job)
}

// Body returns the request body (a chunked one decoded).
fn (q Req) Body() str {
	return rt_str_from_raw(q.bp, q.bn)
}

// BodyBound returns the request body when it is at most n bytes, and otherwise fails with
// fault.LimitExceeded before copying any of it: the compiler calls it for q.Body() into a
// bounded type (try bound(q.Body()), #240).
fn (q Req) BodyBound(n i64) !str {
	if q.bn > n {
		fail cast(fault, rt_fault_over(q.bn, n))
	}
	return rt_str_from_raw(q.bp, q.bn)
}

// Param returns query parameter name, %-decoded, or "".
fn (q Req) Param(name str) str {
	let s = q.Query
	mut i = 0
	for i < len(s) {
		mut j = i
		for j < len(s) && s[j] != '&' {
			j += 1
		}
		mut eq = i
		for eq < j && s[eq] != '=' {
			eq += 1
		}
		if eq-i == len(name) && s[i:eq] == name {
			if eq >= j {
				return ""
			}
			return unescape(s[eq+1 : j])
		}
		i = j + 1
	}
	return ""
}

// PathParam returns path parameter name of the Router route that matched ({name}, {name...},
// or "*" for a last *), %-decoded, or "".
fn (q Req) PathParam(name str) str {
	if q.ep == 0 {
		return ""
	}
	let e = cast(rend, q.ep)
	for i in 0..len(e.names) {
		if e.names[i] == name {
			mut (a, b) = seg_span(q.Path, e.segs[i])
			if e.rest && i == len(e.names)-1 {
				b = len(q.Path)
			}
			return path_unescape(q.Path, a, b)
		}
	}
	return ""
}

// Pattern returns the pattern of the Router route serving the request ("/users/{id}"), or ""
// (no Router, or a 404 or 405 answer).
fn (q Req) Pattern() str {
	if q.ep == 0 {
		return ""
	}
	let e = cast(rend, q.ep)
	return e.pattern
}

fn hexval(c u8) i64 {
	if c >= '0' && c <= '9' {
		return i64(c - '0')
	}
	if c >= 'a' && c <= 'f' {
		return i64(c-'a') + 10
	}
	if c >= 'A' && c <= 'F' {
		return i64(c-'A') + 10
	}
	return -1
}

fn unescape(s str) str {
	mut b = make([]u8, 0, len(s))
	{
		mut i = 0
		for i < len(s) {
			let c = s[i]
			if c == '+' {
				b = append(b, ' ')
			} else if c == '%' && i+2 < len(s) && hexval(s[i+1]) >= 0 && hexval(s[i+2]) >= 0 {
				b = append(b, u8(hexval(s[i+1])*16+hexval(s[i+2])))
				i += 2
			} else {
				b = append(b, c)
			}
			i += 1
		}
	}
	return str(b)
}

// Status sets the response status code.
fn (w mut Out) Status(code i64) {
	w.code = code
}

// Type sets the Content-Type header. CR, LF and NUL in t become spaces, so a value taken from
// the request cannot add header lines.
fn (w mut Out) Type(t str) {
	w.ctype = field_value(t)
}

// Head adds a response header. A name that is not an HTTP token is ignored, and so are
// Content-Length, Transfer-Encoding and Connection: anvil writes the framing itself. CR, LF and
// NUL in the value become spaces, so a value taken from the request cannot add header lines or
// a body (response splitting), as Go's net/http does.
fn (w mut Out) Head(k str, v str) {
	if !is_token(k) || is_framing(k) {
		return
	}
	w.extra = append(w.extra, k...)
	w.extra = append(w.extra, ": "...)
	for i in 0..len(v) {
		mut c = v[i]
		if c == '\r' || c == '\n' || c == 0 {
			c = ' '
		}
		w.extra = append(w.extra, c)
	}
	w.extra = append(w.extra, "\r\n"...)
}

// Trailer adds a trailer field, sent after the body: on HTTP/2 in a HEADERS frame that ends the
// stream (gRPC's grpc-status and grpc-message), on HTTP/1.1 after the last chunk of a chunked
// stream (w.Stream() without Length). A response with a Content-Length cannot carry trailers in
// HTTP/1.1: they are dropped there. Like Head, a name that is not a token and the framing fields
// are ignored, and CR, LF and NUL in the value become spaces.
fn (w mut Out) Trailer(k str, v str) {
	if !is_token(k) || is_framing(k) {
		return
	}
	if w.tr == 0 {
		w.tr = cast(i64, make([]u8, 0, 64))
	}
	mut t = cast([]u8, w.tr)
	t = append(t, k...)
	t = append(t, ": "...)
	for i in 0..len(v) {
		mut c = v[i]
		if c == '\r' || c == '\n' || c == 0 {
			c = ' '
		}
		t = append(t, c)
	}
	t = append(t, "\r\n"...)
}

// field_value is s with CR, LF and NUL replaced by spaces (s itself when it has none).
fn field_value(s str) str {
	mut bad = false
	for i in 0..len(s) {
		if s[i] == '\r' || s[i] == '\n' || s[i] == 0 {
			bad = true
			break
		}
	}
	if !bad {
		return s
	}
	let b = make([]u8, len(s))
	for i in 0..len(s) {
		mut c = s[i]
		if c == '\r' || c == '\n' || c == 0 {
			c = ' '
		}
		b[i] = c
	}
	return str(b)
}

// is_framing reports whether header k is one anvil computes for every response.
fn is_framing(k str) bool {
	let n = cast(i64, k) + 8
	return name_is(n, len(k), "content-length") || name_is(n, len(k), "transfer-encoding") || name_is(n, len(k), "connection")
}

// Text appends s to the body.
fn (w mut Out) Text(s str) {
	w.Body = append(w.Body, s...)
}

// Json sets the JSON content type; the body is then written with argo.Put(mut w.Body, v).
fn (w mut Out) Json() {
	w.ctype = "application/json"
}

// Code returns the response status set so far (200 unless Status changed it).
fn (w Out) Code() i64 {
	return w.code
}

// Header returns response header k as set so far (Type sets Content-Type, Head the rest), or "".
fn (w Out) Header(k str) str {
	if len(k) == 12 && name_is(cast(i64, k)+8, 12, "content-type") {
		return w.ctype
	}
	let e = w.extra
	{
		mut i = 0
		for i < len(e) {
			mut j = i
			for j < len(e) && e[j] != '\n' {
				j += 1
			}
			mut c = i
			for c < j && e[c] != ':' {
				c += 1
			}
			if c-i == len(k) && c < j {
				mut same = true
				for x in 0..len(k) {
					if lower(e[i+x]) != lower(k[x]) {
						same = false
						break
					}
				}
				if same {
					mut v = c + 1
					for v < j && e[v] == ' ' {
						v += 1
					}
					mut ve = j
					if ve > v && e[ve-1] == '\r' {
						ve -= 1
					}
					return str(e[v:ve])
				}
			}
			i = j + 1
		}
	}
	return ""
}

// SetValue stores value under key for the rest of the request: middleware hand data (a user
// id, a request id) to the handlers after them this way. Value reads it back.
fn (w mut Out) SetValue(key str, value str) {
	if w.vals == 0 {
		w.vals = cast(i64, make([]str, 0, 4))
	}
	mut v = cast([]str, w.vals)
	{
		mut i = 0
		for i+1 < len(v) {
			if v[i] == key {
				v[i+1] = value
				return
			}
			i += 2
		}
	}
	v = append(v, key, value)
}

// Value returns what SetValue stored under key in this request, or "".
fn (w Out) Value(key str) str {
	if w.vals == 0 {
		return ""
	}
	let v = cast([]str, w.vals)
	{
		mut i = 0
		for i+1 < len(v) {
			if v[i] == key {
				return v[i+1]
			}
			i += 2
		}
	}
	return ""
}

// OnRelay makes every core run h(from, msg) for each relay message it receives (call
// before Serve). Handlers run between requests, with their own request pool.
fn OnRelay(h fn(i64, str)) {
	gRelay = h
	gRelayOn = true
}

// OnTick makes every core run h(core) every ms milliseconds (call before Serve).
fn OnTick(ms i64, h fn(i64)) {
	gTick = h
	gTickMs = ms
}

// tick_guarded runs one tick inside an implicit guard (#230): a panic in it is logged with its
// backtrace, its deferred calls run, and the core goes on to its next event.
fn tick_guarded(id i64) ! {
	gTick(id)
}

// relay_guarded handles the waiting relay messages inside an implicit guard, like a tick.
fn relay_guarded(unused i64) ! {
	relay.Drain(gRelay)
}

// ---- Router ----

// Router sends each request to the handler routed for its method and path pattern, through
// the middleware added with Use. Build it in main (or in a function a global's initializer
// calls), then Serve it, or try requests on it with Run.
type Router struct {
	routes []route
	mws    []fn(Req, mut Out, fn(Req, mut Out))
	mounts []mount
	nf     fn(Req, mut Out)
	mna    fn(Req, mut Out)
	ownNF  bool
	ownMNA bool
}

// A route as added: its method (unless all), its pattern within its router, its handler.
type route struct {
	method  str
	all     bool
	pattern str
	h       fn(Req, mut Out)
	stream  bool // Router.Stream: the handler reads the body as it arrives (#481)
}

// A router mounted at prefix.
type mount struct {
	prefix str
	sub    Router
}

// A compiled router (Serve's lives in core 0's ingot heap and every core reads it): the
// trie of every route, the endpoints, one scope per router for its 404 and 405 answers,
// and the method names by code.
type rtable struct {
	nodes   []rnode
	ends    []rend
	scopes  []rscope
	methods []str
}

// A trie node: one per distinct pattern prefix. Node 0 is the root, so 0 is also "none".
type rnode struct {
	keys  []str // static children's segments
	kids  []i64 // their nodes
	slots []i64 // when there are many keys: a hash table of key index + 1 (0: empty)
	param i64   // the {name} child
	rest  i64   // the {name...} child
	codes []i64 // the methods of the routes ending here
	eps   []i64 // their endpoints
	mask  i64   // one bit per method in codes
	all   i64   // the Any route ending here: its endpoint + 1, or 0
}

// An endpoint: the handler and middleware chain a route (or a 404 or 405 answer) runs.
type rend struct {
	h       fn(Req, mut Out)
	mws     []fn(Req, mut Out, fn(Req, mut Out))
	pattern str   // the whole pattern; "" for a 404 or 405 answer
	names   []str // parameter names, in order
	segs    []i64 // the path segment each one reads
	rest    bool  // the last parameter reads the rest of the path
	stream  bool  // a Router.Stream route: it runs before its body has arrived (#481)
}

// A router's prefix and its 404 and 405 answers; a miss gets the deepest scope over its path.
type rscope struct {
	kinds []i64
	texts []str
	nf    i64
	mna   i64
}

// A parsed pattern: each segment's kind, and its text (the static text or the parameter name).
type ppat struct {
	kinds []i64
	texts []str
}

const segStatic = 0
const segParam = 1
const segRest = 2

const mGet = 0
const mHead = 1
const nKnown = 9      // GET HEAD POST PUT PATCH DELETE OPTIONS CONNECT TRACE: codes 0 to 8
const maxMethods = 63 // method codes are bits of a mask
const manyKeys = 8    // a node with more static children hashes them
const maxNest = 32    // how deep routers may be mounted in each other
const tchars = "!#$%&'*+-.^_`|~"

mut routerGen i64 // per core: counts router changes, so Run's compiled table is never stale
mut runRouter i64 // per core: the router Run and Match compiled last, its table and when
mut runTable i64
mut runGen i64

// NewRouter makes an empty router: every request gets 404 until routes are added.
fn NewRouter() Router {
	routerGen += 1
	return Router{nf: not_found, mna: not_allowed, ownNF: false, ownMNA: false}
}

// Get routes GET requests for pattern to h, and HEAD requests unless Head routes them.
fn (r mut Router) Get(pattern str, h fn(Req, mut Out)) {
	r.Handle("GET", pattern, h)
}

// Post routes POST requests for pattern to h.
fn (r mut Router) Post(pattern str, h fn(Req, mut Out)) {
	r.Handle("POST", pattern, h)
}

// Put routes PUT requests for pattern to h.
fn (r mut Router) Put(pattern str, h fn(Req, mut Out)) {
	r.Handle("PUT", pattern, h)
}

// Patch routes PATCH requests for pattern to h.
fn (r mut Router) Patch(pattern str, h fn(Req, mut Out)) {
	r.Handle("PATCH", pattern, h)
}

// Delete routes DELETE requests for pattern to h.
fn (r mut Router) Delete(pattern str, h fn(Req, mut Out)) {
	r.Handle("DELETE", pattern, h)
}

// Head routes HEAD requests for pattern to h (without it, they go to the GET route).
fn (r mut Router) Head(pattern str, h fn(Req, mut Out)) {
	r.Handle("HEAD", pattern, h)
}

// Options routes OPTIONS requests for pattern to h.
fn (r mut Router) Options(pattern str, h fn(Req, mut Out)) {
	r.Handle("OPTIONS", pattern, h)
}

// Handle routes requests with method (any HTTP method name, like "PROPFIND") for pattern to h.
fn (r mut Router) Handle(method str, pattern str, h fn(Req, mut Out)) {
	routerGen += 1
	r.routes = append(r.routes, route{method: method, all: false, pattern: pattern, h: h})
}

// Stream routes method requests for pattern to h, which runs as soon as the request's headers
// are in and reads the body as it arrives with q.BodyStream() (#481): large uploads in bounded
// memory, gRPC client and bidirectional streams. TIN_MAX_BODY does not bound such a body.
fn (r mut Router) Stream(method str, pattern str, h fn(Req, mut Out)) {
	routerGen += 1
	r.routes = append(r.routes, route{method: method, all: false, pattern: pattern, h: h, stream: true})
}

// Any routes requests for pattern with every method to h; a route for the request's own
// method on the same pattern wins over it.
fn (r mut Router) Any(pattern str, h fn(Req, mut Out)) {
	routerGen += 1
	r.routes = append(r.routes, route{method: "", all: true, pattern: pattern, h: h})
}

// Use adds middleware mw to r. Middleware run in the order added, around every route of r
// and of the routers mounted in it, and around their 404 and 405 answers. Each gets next,
// the rest of the chain, and decides whether and when to call it.
fn (r mut Router) Use(mw fn(Req, mut Out, fn(Req, mut Out))) {
	routerGen += 1
	r.mws = append(r.mws, mw)
}

// Route groups routes under prefix ("/api"): build adds them to a new router mounted there.
fn (r mut Router) Route(prefix str, build fn(mut Router)) {
	let g = NewRouter()
	build(mut g)
	r.Mount(prefix, g)
}

// Mount serves sub's routes under prefix: "/api" and "/users" make "/api/users", and "/api"
// and "" make "/api". r's middleware run before sub's, and sub's 404 and 405 answers (with
// its middleware) cover the paths under prefix.
fn (r mut Router) Mount(prefix str, sub Router) {
	routerGen += 1
	r.mounts = append(r.mounts, mount{prefix: prefix, sub: sub})
}

// NotFound sets the handler for the paths no route matches (under r's prefix when r is
// mounted); the status starts as 404.
fn (r mut Router) NotFound(h fn(Req, mut Out)) {
	routerGen += 1
	r.nf = h
	r.ownNF = true
}

// MethodNotAllowed sets the handler for the paths whose routes take other methods; the
// status starts as 405 and the Allow header lists those methods.
fn (r mut Router) MethodNotAllowed(h fn(Req, mut Out)) {
	routerGen += 1
	r.mna = h
	r.ownMNA = true
}

// Check fails with r's first bad pattern, conflicting route or misplaced mount, the error
// Serve would fail with before listening.
fn (r Router) Check() ! {
	_ = try compile(r)
}

// Serve listens on addr and serves r on every core, like anvil.Serve. The routes are checked
// and compiled once, into a table every core reads; Serve fails with r's error, if any (see Check).
fn (r Router) Serve(addr str) ! {
	return try r.ServeN(addr, serve_cores())
}

// ServeN is Serve on exactly n cores.
fn (r Router) ServeN(addr str, n i64) ! {
	let t = try compile(r)
	gRoutes = cast(i64, keep(t))
	return try serve_on(addr, n)
}

// Run sends one request through r on this thread, as Serve would (middleware, 404, 405),
// and returns the response: for tests. target is the path and query ("/users/7?full=1"),
// the request has no headers, and a HEAD response keeps its body. Run panics if r has an
// error (see Check).
fn (r Router) Run(method str, target str, body str) Out {
	let t = run_table(r)
	let q = Req{Method: method, Path: target, Query: "", hp: 0, hn: 0, bp: cast(i64, body) + 8, bn: len(body)}
	for i in 0..len(target) {
		if target[i] == '?' {
			q.Path = target[:i]
			q.Query = target[i+1:]
			break
		}
	}
	let b = make([]u8, 0, 256)
	let w = Out{Body: b, code: 200, ctype: "text/plain; charset=utf-8", extra: make([]u8, 0, 64), own: b}
	dispatch(t, mut q, mut w)
	return w
}

// Match returns the pattern of the route that would serve method and path ("/users/{id}"),
// or "" when the request would get 404 or 405. Like Run, it panics if r has an error (see Check).
fn (r Router) Match(method str, path str) str {
	let t = run_table(r)
	let e = find(t, method, path)
	if e < 0 {
		return ""
	}
	return t.ends[e].pattern
}

// run_table is r compiled, kept while no router is changed (so repeated Run and Match calls
// do not compile it again).
fn run_table(r Router) rtable {
	let id = cast(i64, r)
	if runTable == 0 || runRouter != id || runGen != routerGen {
		let (t, err) = compile(r)
		if err != nil {
			panic("{err}")
		}
		runTable = cast(i64, keep(t))
		runRouter = id
		runGen = routerGen
	}
	return cast(rtable, runTable)
}

// not_found is a router's default answer when no route matches (the status is already 404).
fn not_found(q Req, w mut Out) {
	w.Text("Not Found")
}

// not_allowed is a router's default answer when the path's routes take other methods (the
// status is already 405, and Allow is set).
fn not_allowed(q Req, w mut Out) {
	w.Text("Method Not Allowed")
}

// ---- Routing a request ----

// dispatch runs request q through table t: the matching route's endpoint, or the 404 or 405
// answer of the deepest router over the path, inside its middleware chain.
fn dispatch(t rtable, q mut Req, w mut Out) {
	mut e = find(t, q.Method, q.Path)
	if e < 0 {
		e = miss(t, q.Path, mut w)
	}
	let ep = cast(i64, t.ends[e])
	q.ep = ep
	w.ep = ep
	w.ci = 0
	chain_next(q, mut w)
}

// chain_next runs the rest of the request's middleware chain, then its handler: it is the
// next that every middleware gets. The position lives in the Out, so a middleware may call
// next more than once, and may wait before or after it.
fn chain_next(q Req, w mut Out) {
	if w.ep == 0 {
		panic("anvil: next needs the Out its middleware was given")
	}
	let e = cast(rend, w.ep)
	let i = w.ci
	if i < len(e.mws) {
		let mw = e.mws[i]
		w.ci = i + 1
		mw(q, mut w, chain_next)
		w.ci = i
		return
	}
	let h = e.h
	h(q, mut w)
}

// find returns the endpoint for method and path in t, or -1.
fn find(t rtable, method str, path str) i64 {
	let n = len(path)
	let p = cast(i64, path) + 8
	if n == 0 || load8(p) != '/' {
		return -1
	}
	return walk(t, 0, p, n, 1, method_code(t, method))
}

// method_code is method m's code in t, or -1 when no route takes it. The known methods have
// the codes of their place in compile's list.
fn method_code(t rtable, m str) i64 {
	let p = cast(i64, m) + 8
	let n = len(m)
	match load8(p) {
		'G' => {
			if bytes_are(p, n, "GET") {
				return 0
			}
		}
		'H' => {
			if bytes_are(p, n, "HEAD") {
				return 1
			}
		}
		'P' => {
			if bytes_are(p, n, "POST") {
				return 2
			}
			if bytes_are(p, n, "PUT") {
				return 3
			}
			if bytes_are(p, n, "PATCH") {
				return 4
			}
		}
		'D' => {
			if bytes_are(p, n, "DELETE") {
				return 5
			}
		}
		'O' => {
			if bytes_are(p, n, "OPTIONS") {
				return 6
			}
		}
		'C' => {
			if bytes_are(p, n, "CONNECT") {
				return 7
			}
		}
		'T' => {
			if bytes_are(p, n, "TRACE") {
				return 8
			}
		}
	}
	let ms = t.methods
	for i in nKnown..len(ms) {
		if ms[i] == m {
			return i
		}
	}
	return -1
}

// walk returns the endpoint for method m and the path (n bytes at p) from offset at on,
// below node i, or -1. It tries the static child first, then the {name} child, then the
// catch-all, going back when a branch has no route for the rest of the path.
fn walk(t rtable, i i64, p i64, n i64, at i64, m i64) i64 {
	let nd = t.nodes[i]
	if at > n {
		return pick(nd, m)
	}
	mut end = at
	for end < n && load8(p+end) != '/' {
		end += 1
	}
	if len(nd.keys) > 0 {
		let c = find_static(nd, p+at, end-at)
		if c != 0 {
			let e = walk(t, c, p, n, end+1, m)
			if e >= 0 {
				return e
			}
		}
	}
	if nd.param != 0 && end > at {
		let e = walk(t, nd.param, p, n, end+1, m)
		if e >= 0 {
			return e
		}
	}
	if nd.rest != 0 {
		return pick(t.nodes[nd.rest], m)
	}
	return -1
}

// pick returns node nd's endpoint for method m: its own, then GET's for HEAD, then Any's;
// or -1.
fn pick(nd rnode, m i64) i64 {
	if m >= 0 && (nd.mask>>m)&1 != 0 {
		for i in 0..len(nd.codes) {
			if nd.codes[i] == m {
				return nd.eps[i]
			}
		}
	}
	if m == mHead && nd.mask&1 != 0 {
		return pick(nd, mGet)
	}
	return nd.all - 1
}

// allowed returns the methods (a mask) of every route matching the path from offset at on,
// below node i, whatever its method.
fn allowed(t rtable, i i64, p i64, n i64, at i64) i64 {
	let nd = t.nodes[i]
	if at > n {
		return nd.mask
	}
	mut end = at
	for end < n && load8(p+end) != '/' {
		end += 1
	}
	mut mask = 0
	if len(nd.keys) > 0 {
		let c = find_static(nd, p+at, end-at)
		if c != 0 {
			mask |= allowed(t, c, p, n, end+1)
		}
	}
	if nd.param != 0 && end > at {
		mask |= allowed(t, nd.param, p, n, end+1)
	}
	if nd.rest != 0 {
		mask |= t.nodes[nd.rest].mask
	}
	return mask
}

// find_static returns node nd's static child for the n bytes at p, or 0.
fn find_static(nd rnode, p i64, n i64) i64 {
	if len(nd.slots) == 0 {
		for i in 0..len(nd.keys) {
			if seg_is(nd.keys[i], p, n) {
				return nd.kids[i]
			}
		}
		return 0
	}
	let m = len(nd.slots) - 1
	mut s = i64(hash_seg(p, n)) & m
	for {
		let k = nd.slots[s]
		if k == 0 {
			return 0
		}
		if seg_is(nd.keys[k-1], p, n) {
			return nd.kids[k-1]
		}
		s = (s + 1) & m
	}
	return 0
}

// seg_is reports whether the n bytes at p are k.
fn seg_is(k str, p i64, n i64) bool {
	if len(k) != n {
		return false
	}
	let kp = cast(i64, k) + 8
	for i in 0..n {
		if load8(kp+i) != load8(p+i) {
			return false
		}
	}
	return true
}

// hash_seg is the FNV-1a hash of the n bytes at p.
fn hash_seg(p i64, n i64) u64 {
	mut h = u64(14695981039346656037)
	for i in 0..n {
		h = (h ^ u64(load8(p+i))) *% 1099511628211
	}
	return h
}

// miss prepares w for a request no route takes and returns the endpoint that answers it:
// 405 with Allow when routes take the path with other methods, else 404, from the deepest
// router (scope) whose prefix starts the path.
fn miss(t rtable, path str, w mut Out) i64 {
	let n = len(path)
	let p = cast(i64, path) + 8
	mut mask = 0
	mut s = t.scopes[0]
	if n > 0 && load8(p) == '/' {
		mask = allowed(t, 0, p, n, 1)
		for i in 1..len(t.scopes) {
			let c = t.scopes[i]
			if scope_over(c, p, n) && scope_wins(c, s) {
				s = c
			}
		}
	}
	if mask == 0 {
		w.code = 404
		return s.nf
	}
	w.code = 405
	w.Head("Allow", allow_list(t, mask))
	return s.mna
}

// scope_over reports whether scope s's prefix starts the path (n bytes at p).
fn scope_over(s rscope, p i64, n i64) bool {
	mut at = 1
	for k in 0..len(s.kinds) {
		if at > n {
			return false
		}
		mut end = at
		for end < n && load8(p+end) != '/' {
			end += 1
		}
		if s.kinds[k] == segStatic {
			if !seg_is(s.texts[k], p+at, end-at) {
				return false
			}
		} else if end == at {
			return false
		}
		at = end + 1
	}
	return true
}

// scope_wins reports whether scope a answers before b for a path both start: the deeper
// one, or else the one with a static segment where the other has a parameter.
fn scope_wins(a rscope, b rscope) bool {
	if len(a.kinds) != len(b.kinds) {
		return len(a.kinds) > len(b.kinds)
	}
	for k in 0..len(a.kinds) {
		if a.kinds[k] != b.kinds[k] {
			return a.kinds[k] < b.kinds[k]
		}
	}
	return false
}

// allow_list is the Allow header for the methods in mask: their names in order, with HEAD
// wherever GET is.
fn allow_list(t rtable, mask i64) str {
	if mask&1 != 0 {
		mask |= 1 << mHead
	}
	mut names = make([]str, 0, 8)
	for c in 0..len(t.methods) {
		if (mask>>c)&1 != 0 {
			names = append(names, t.methods[c])
		}
	}
	for i in 1..len(names) {
		{
			mut j = i
			for j > 0 && names[j] < names[j-1] {
				let x = names[j]
				names[j] = names[j-1]
				names[j-1] = x
				j -= 1
			}
		}
	}
	mut b = make([]u8, 0, 64)
	for i, s in names {
		if i > 0 {
			b = append(b, ", "...)
		}
		b = append(b, s...)
	}
	return str(b)
}

// seg_span returns where path segment k starts and ends (segment 0 follows the first /).
fn seg_span(path str, k i64) (i64, i64) {
	let n = len(path)
	mut at = 1
	{
		mut j = 0
		for j < k && at <= n {
			for at < n && path[at] != '/' {
				at += 1
			}
			at += 1
			j += 1
		}
	}
	if at > n {
		return n, n
	}
	mut end = at
	for end < n && path[end] != '/' {
		end += 1
	}
	return at, end
}

// path_unescape is s[a:b] with its %XX escapes decoded ('+' stays itself in a path).
fn path_unescape(s str, a i64, b i64) str {
	mut esc = false
	for i in a..b {
		if s[i] == '%' {
			esc = true
			break
		}
	}
	if !esc {
		return s[a:b]
	}
	mut out = make([]u8, 0, b-a)
	{
		mut i = a
		for i < b {
			let c = s[i]
			if c == '%' && i+2 < b && hexval(s[i+1]) >= 0 && hexval(s[i+2]) >= 0 {
				out = append(out, u8(hexval(s[i+1])*16+hexval(s[i+2])))
				i += 2
			} else {
				out = append(out, c)
			}
			i += 1
		}
	}
	return str(out)
}

// ---- Compiling a router ----

// compile checks router r and builds its table: every route (mounted routers' too, under
// their prefixes) in one trie, an endpoint per route with its middleware chain, and a scope
// per router for its 404 and 405 answers.
fn compile(r Router) !rtable {
	let t = rtable{}
	t.nodes = append(t.nodes, rnode{})
	t.methods = append(t.methods, "GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "CONNECT", "TRACE")
	let seen = make([]i64, maxNest)
	let none = make([]fn(Req, mut Out, fn(Req, mut Out)), 0)
	try add_router(mut t, r, "", none, not_found, not_allowed, mut seen, 0)
	for _, nd in t.nodes {
		index_keys(mut nd)
	}
	return t
}

// add_router adds router r, mounted at prefix: its scope, then its routes and mounts, with
// the middleware of the routers around it (outer) before its own. nf and mna answer misses
// unless r has its own. seen[:depth] are the routers r is mounted in.
fn add_router(t mut rtable, r Router, prefix str, outer []fn(Req, mut Out, fn(Req, mut Out)), nf fn(Req, mut Out), mna fn(Req, mut Out), seen mut []i64, depth i64) ! {
	let id = cast(i64, r)
	for i in 0..depth {
		if seen[i] == id {
			fail "anvil: mount {prefix}: the router is mounted inside itself"
		}
	}
	if depth == len(seen) {
		fail "anvil: mount {prefix}: routers are mounted more than {maxNest} deep"
	}
	seen[depth] = id
	mut chain = make([]fn(Req, mut Out, fn(Req, mut Out)), 0, len(outer)+len(r.mws))
	for _, m in outer {
		chain = append(chain, m)
	}
	for _, m in r.mws {
		chain = append(chain, m)
	}
	if r.ownNF {
		nf = r.nf
	}
	if r.ownMNA {
		mna = r.mna
	}
	mut sp = ppat{}
	if prefix != "" {
		let pp = parse_pattern(prefix, true) catch err {
			fail "anvil: mount {prefix}: {err}"
		}
		sp = pp
	}
	for _, s in t.scopes {
		if same_shape(s.kinds, s.texts, sp.kinds, sp.texts) {
			fail "anvil: mount {prefix}: another router is mounted at the same prefix"
		}
	}
	t.scopes = append(t.scopes, rscope{kinds: sp.kinds, texts: sp.texts, nf: len(t.ends), mna: len(t.ends) + 1})
	t.ends = append(t.ends, endpoint(nf, chain, "", sp), endpoint(mna, chain, "", sp))
	for _, rt in r.routes {
		try add_route(mut t, rt, prefix, chain)
	}
	for _, m in r.mounts {
		if len(m.prefix) < 2 || m.prefix[0] != '/' || m.prefix[len(m.prefix)-1] == '/' {
			fail "anvil: mount {m.prefix}: a prefix starts with / and does not end with one, like /api"
		}
		try add_router(mut t, m.sub, prefix+m.prefix, chain, nf, mna, mut seen, depth+1)
	}
}

// add_route puts route rt, of a router mounted at prefix, into the trie with the given chain.
fn add_route(t mut rtable, rt route, prefix str, chain []fn(Req, mut Out, fn(Req, mut Out))) ! {
	let full = prefix + rt.pattern
	mut what = rt.method
	if rt.all {
		what = "Any"
	} else if !is_token(rt.method) {
		fail "anvil: route {full}: bad method \"{rt.method}\""
	}
	if full == "" || (rt.pattern != "" && rt.pattern[0] != '/') {
		mut where = ""
		if prefix != "" {
			where = " (mounted at {prefix})"
		}
		fail "anvil: route {what} \"{rt.pattern}\"{where}: a pattern starts with /, like /users/{{id}}"
	}
	let pp = parse_pattern(full, false) catch err {
		fail "anvil: route {what} {full}: {err}"
	}
	mut n = 0
	for k in 0..len(pp.kinds) {
		n = child(mut t, n, pp.kinds[k], pp.texts[k])
	}
	let nd = t.nodes[n]
	let e = len(t.ends)
	if rt.all {
		if nd.all != 0 {
			let first = t.ends[nd.all-1].pattern
			fail "anvil: route {what} {full} conflicts with {first}: they match the same requests"
		}
		nd.all = e + 1
	} else {
		let m = add_method(mut t, rt.method) catch err {
			fail "anvil: route {what} {full}: {err}"
		}
		for i in 0..len(nd.codes) {
			if nd.codes[i] == m {
				let first = t.ends[nd.eps[i]].pattern
				fail "anvil: route {what} {full} conflicts with {first}: they match the same requests"
			}
		}
		nd.codes = append(nd.codes, m)
		nd.eps = append(nd.eps, e)
		nd.mask |= 1 << m
	}
	let ep = endpoint(rt.h, chain, full, pp)
	ep.stream = rt.stream
	t.ends = append(t.ends, ep)
}

// add_method returns method m's code in t, giving a method no route used before the next one.
fn add_method(t mut rtable, m str) !i64 {
	for i in 0..len(t.methods) {
		if t.methods[i] == m {
			return i
		}
	}
	if len(t.methods) == maxMethods {
		fail "more than {maxMethods} methods"
	}
	t.methods = append(t.methods, m)
	return len(t.methods) - 1
}

// is_token reports whether m is an HTTP token, as a method name must be.
fn is_token(m str) bool {
	if len(m) == 0 {
		return false
	}
	for i in 0..len(m) {
		let c = m[i]
		mut ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')
		{
			mut j = 0
			for !ok && j < len(tchars) {
				ok = tchars[j] == c
				j += 1
			}
		}
		if !ok {
			return false
		}
	}
	return true
}

// child returns node n's child for a segment of kind and text, made if new.
fn child(t mut rtable, n i64, kind i64, text str) i64 {
	let nd = t.nodes[n]
	if kind == segStatic {
		for i in 0..len(nd.keys) {
			if nd.keys[i] == text {
				return nd.kids[i]
			}
		}
		let c = len(t.nodes)
		t.nodes = append(t.nodes, rnode{})
		nd.keys = append(nd.keys, text)
		nd.kids = append(nd.kids, c)
		return c
	}
	if kind == segParam {
		if nd.param == 0 {
			nd.param = len(t.nodes)
			t.nodes = append(t.nodes, rnode{})
		}
		return nd.param
	}
	if nd.rest == 0 {
		nd.rest = len(t.nodes)
		t.nodes = append(t.nodes, rnode{})
	}
	return nd.rest
}

// index_keys gives a node with many static children a hash table over their segments.
fn index_keys(nd mut rnode) {
	if len(nd.keys) <= manyKeys {
		return
	}
	mut size = 16
	for size < 2*len(nd.keys) {
		size *= 2
	}
	nd.slots = make([]i64, size)
	for i, k in nd.keys {
		mut s = i64(hash_seg(cast(i64, k)+8, len(k))) & (size - 1)
		for nd.slots[s] != 0 {
			s = (s + 1) & (size - 1)
		}
		nd.slots[s] = i + 1
	}
}

// endpoint makes the endpoint for handler h with middleware chain, for parsed pattern pp.
fn endpoint(h fn(Req, mut Out), chain []fn(Req, mut Out, fn(Req, mut Out)), pattern str, pp ppat) rend {
	let e = rend{h: h, mws: chain, pattern: pattern, rest: false}
	for k in 0..len(pp.kinds) {
		if pp.kinds[k] != segStatic {
			e.names = append(e.names, pp.texts[k])
			e.segs = append(e.segs, k)
			e.rest = pp.kinds[k] == segRest
		}
	}
	return e
}

// same_shape reports whether two parsed patterns match the same paths: the same static
// segments, and parameters in the same places.
fn same_shape(ak []i64, at []str, bk []i64, bt []str) bool {
	if len(ak) != len(bk) {
		return false
	}
	for k in 0..len(ak) {
		if ak[k] != bk[k] || (ak[k] == segStatic && at[k] != bt[k]) {
			return false
		}
	}
	return true
}

// parse_pattern splits pattern p ("/users/{id}") into its segments. A static segment may not
// hold a brace, a catch-all must come last, and a prefix (a mount's) may not have one.
fn parse_pattern(p str, prefix bool) !ppat {
	let pp = ppat{}
	if len(p) == 0 || p[0] != '/' {
		fail "a pattern starts with /"
	}
	mut at = 1
	for {
		mut end = at
		for end < len(p) && p[end] != '/' {
			end += 1
		}
		let seg = p[at:end]
		mut kind = segStatic
		mut text = seg
		if seg == "*" {
			kind = segRest
		} else if len(seg) >= 2 && seg[0] == '{' && seg[len(seg)-1] == '}' {
			kind = segParam
			text = seg[1 : len(seg)-1]
			if len(text) > 3 && text[len(text)-3:] == "..." {
				kind = segRest
				text = text[:len(text)-3]
			}
			if !is_name(text) {
				fail "bad parameter {seg}: a name is letters, digits and _"
			}
			for k in 0..len(pp.kinds) {
				if pp.kinds[k] != segStatic && pp.texts[k] == text {
					fail "parameter {text} appears twice"
				}
			}
		} else {
			for i in 0..len(seg) {
				if seg[i] == '{' || seg[i] == '}' {
					fail "a parameter is a whole segment, like /{{id}}"
				}
			}
		}
		if kind == segRest && prefix {
			fail "a prefix cannot end in a catch-all"
		}
		if kind == segRest && end < len(p) {
			fail "a catch-all ({{name...}} or *) must be the last segment"
		}
		pp.kinds = append(pp.kinds, kind)
		pp.texts = append(pp.texts, text)
		if end >= len(p) {
			break
		}
		at = end + 1
	}
	return pp
}

// is_name reports whether s is a parameter name: letters, digits and _, at least one.
fn is_name(s str) bool {
	if len(s) == 0 {
		return false
	}
	for i in 0..len(s) {
		let c = s[i]
		if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_') {
			return false
		}
	}
	return true
}
