// Package anvil is an HTTP/1.1 server: one event loop per core (kqueue), share-nothing.
//
// Core 0 accepts connections and deals them round-robin to every core through a pipe;
// from then on a connection belongs to one core for its whole life. Each core reads
// into one scratch buffer, parses requests in place, runs the handler, writes every
// response of the batch with one write, and wipes its request pool. Idle connections
// hold no buffers, only a 96-byte record.
//
//	func handle(q anvil.Req, w mut anvil.Out) {
//		w.Type("application/json")
//		argo.Put(mut w.Body, Msg{message: "hi"})
//	}
//	func main() {
//		err := anvil.Serve(":8080", handle)
//		say.Line("server:", err)
//	}
//
// A Router picks the handler by method and path pattern, and runs middleware around it.
// Patterns match whole segments: "users" itself, {id} any one non-empty segment, and a
// last {path...} or * the rest of the path. Static segments win over {name}, and {name}
// over the rest, segment by segment, whatever the order of registration. A path whose
// routes take other methods gets 405 with Allow, any other miss 404; HEAD falls back to
// GET. A trailing slash is part of the path: /users/ and /users are different routes.
// Write patterns with {...} as raw strings: in "..." the braces would interpolate.
//
//	func user(q anvil.Req, w mut anvil.Out) {
//		id := q.PathParam("id")
//		w.Text("user {id}")
//	}
//	func logged(q anvil.Req, w mut anvil.Out, next func(anvil.Req, mut anvil.Out)) {
//		next(q, mut w)
//		say.Line(q.Method, q.Pattern(), w.Code())
//	}
//	func main() {
//		r := anvil.NewRouter()
//		r.Use(logged)
//		r.Get(`/users/{id}`, user)
//		r.Route("/admin", func(g mut anvil.Router) {
//			g.Use(auth)
//			g.Delete(`/users/{id}`, remove)
//		})
//		err := r.Serve(":8080")
//		say.Line("server:", err)
//	}
package anvil

import "hearth"
import "relay"
import "say"

extern func socket(domain i64, typ i64, proto i64) i64
extern func setsockopt(fd i64, level i64, name i64, val i64, n i64) i64
extern func bind(fd i64, addr i64, n i64) i64
extern func listen(fd i64, backlog i64) i64
extern func accept(fd i64, addr i64, n i64) i64
extern func fcntl(fd i64, cmd i64, ...) i64
extern func close(fd i64) i64
extern func pipe(fds i64) i64
extern func signal(sig i64, h i64) i64
extern func time(t i64) i64
extern func gmtime_r(t i64, tm i64) i64
extern func strftime(s i64, max i64, f i64, tm i64) i64
extern func memchr(p i64, c i64, n i64) i64
extern func getenv(name i64) i64
extern func atoi(s i64) i64
extern func open(path i64, flags i64, ...) i64

// Req is the request being served. Its strings live in the request pool: keep() them
// to store them anywhere long-lived.
type Req struct {
	Method str
	Path   str
	Query  str
	hp     i64
	hn     i64
	bp     i64
	bn     i64
	ep     i64 // the Router endpoint that matched (an rend), for PathParam and Pattern
}

// Out is the response being built. Body is the response body; the status defaults to
// 200 and the content type to text/plain.
type Out struct {
	Body  []u8
	code  i64
	ctype str
	extra []u8
	own   []u8
	ep    i64 // the Router endpoint whose middleware chain is running (an rend)
	ci    i64 // the next middleware of that chain
	vals  i64 // SetValue's keys and values: a []str made on first use, or 0
}

const scrSize = 262144
const maxRequest = 67108864
const maxLine = 65536   // request line and header block limit: 414 / 431 past it
const maxEvents = 256

// Connection record words.
const cFD = 0
const cIn = 1     // pending input: a request that has not fully arrived
const cInLen = 2
const cInCap = 3
const cOut = 4    // pending output the socket would not take yet
const cOutLen = 5
const cOutOff = 6
const cClose = 7  // close once the output is written
const cWriting = 8
const cNeed = 9   // bytes the pending request needs, when known
const cTask = 10  // the request task waiting (sleep, I/O) on this connection; later requests queue
const cAlive = 11 // that request's keep-alive
const cDead = 12  // closed while its task waited: freed when the task ends
const cHijack = 13 // taken out of HTTP by its handler (Req.Hijack): closed when the task ends
const cWords = 14

shared var gListen i64
shared var gIP i64
shared var gPort i64
shared var gHandler func(Req, mut Out)
shared var gRoutes i64 // a Router's compiled table (an rtable in core 0's ingot heap, read by every core), or 0
shared var gCores i64
shared var gRelay func(i64, str)
shared var gRelayOn bool
shared var gTick func(i64)
shared var gTickMs i64
shared var gPipes i64   // [read fd, write fd] per core
shared var gSpare i64   // an fd core 0 closes to accept and drop a connection when out of fds
shared var gLoad i64    // live connections per core, one cache line each; a handoff credits its target
shared var gStop i64    // 1 once SIGTERM or SIGINT started the graceful shutdown (core 0 only)
shared var gDrained i64 // cores that stopped and have no connection left
shared var gGrace i64   // seconds the shutdown waits for connections to finish (TIN_GRACE, default 25)
shared var gTok i64     // 256 bytes: 1 for each byte a token (a field name) may hold (RFC 9110 5.6.2)

var myID i64
var draining bool     // this core stopped accepting; its connections close after their next response
var reported bool     // this core counted itself in gDrained
var deadline i64      // core 0: when the grace period ends (seconds)
var drainTimer i64    // core 0: the timer that checks the deadline while draining
var kq i64
var myListen i64
var conns i64
var evs i64
var scr i64
var ob i64
var obLen i64
var obCap i64
var change i64
var word i64
var common i64      // "Server: anvil\r\nDate: ...\r\n"
var commonLen i64
var lastSec i64
var tm i64
var rr i64
shared var gDeadlineMs i64 // a request's waits give up this long after it started (0: never)
shared var gDeadlineSet bool

const maxWaiting = 4096 // waiting request tasks per core; past it new requests get 503
var waiting i64        // this core's request tasks that are waiting

var fdTask i64  // fd -> the request task waiting on it (client sockets)
var doneRd i64  // the read end of this core's helper-job pipe

var head bool
// The request serve_one hands to the task it starts (read before the task first waits).
var pReq i64
var pReqLen i64
var pSp1 i64
var pSp2 i64
var pLe i64
var pHend i64
var pCl i64
var pHead bool
var pTs i64      // the request target: offset in the request and length (absolute-form reduced to its path)
var pTn i64
var pKeep10 bool // an HTTP/1.0 request asked for keep-alive: the response must say so

func c32(x i64) i64 {
	return i64(i32(x))
}

func errno() i64 {
	return rt_errno()
}

// Serve listens on addr (":8080", "127.0.0.1:8080") and serves h on every core. It
// returns only if the server cannot start. TIN_CORES overrides the number of cores.
func Serve(addr str, h func(Req, mut Out)) ! {
	return try ServeN(addr, serve_cores(), h)
}

// ServeN is Serve on exactly n cores.
func ServeN(addr str, n i64, h func(Req, mut Out)) ! {
	gHandler = h
	gRoutes = 0
	return try serve_on(addr, n)
}

// serve_cores is how many cores Serve uses: hearth.Cores(), or TIN_CORES when set.
func serve_cores() i64 {
	n := hearth.Cores()
	env := getenv(cast(i64, "TIN_CORES") + 8)
	if env != 0 && atoi(env)&0xffffffff > 0 {
		n = atoi(env) & 0xffffffff
	}
	return n
}

// serve_on listens on addr and runs the event loops of n cores, serving gHandler (or the
// router in gRoutes); it returns only if the server cannot start.
func serve_on(addr str, n i64) ! {
	port := 0
	ip := 0
	colon := -1
	for i := 0; i < len(addr); i++ {
		if addr[i] == ':' {
			colon = i
		}
	}
	if colon < 0 {
		fail "anvil: address needs a port, like \":8080\""
	}
	for i := colon + 1; i < len(addr); i++ {
		c := addr[i]
		if c < '0' || c > '9' {
			fail "anvil: bad port in address"
		}
		port = port*10 + i64(c-'0')
	}
	if colon > 0 {
		part := 0
		for i := 0; i < colon; i++ {
			c := addr[i]
			if c == '.' {
				ip = ip<<8 | part
				part = 0
			} else if c >= '0' && c <= '9' {
				part = part*10 + i64(c-'0')
			} else {
				fail "anvil: the host must be a dotted IPv4 address"
			}
		}
		ip = ip<<8 | part
	}
	// $PORT (as set by Kubernetes, Cloud Run, Heroku...) replaces the port.
	penv := getenv(cast(i64, "PORT") + 8)
	if penv != 0 && atoi(penv)&0xffffffff > 0 && atoi(penv)&0xffffffff < 65536 {
		port = atoi(penv) & 0xffffffff
	}
	gIP = ip
	gPort = port
	fd := open_listener(ip, port)
	if fd == -1 {
		fail "anvil: socket failed"
	}
	if fd == -2 {
		fail "anvil: cannot bind the address (in use?)"
	}
	if fd == -3 {
		fail "anvil: listen failed"
	}
	signal(13, 1)
	gListen = fd
	gSpare = c32(open(cast(i64, "/dev/null")+8, 0))
	if n < 1 {
		n = 1
	}
	gCores = n
	gPipes = calloc(2*n, 8)
	gLoad = rt_aligned_alloc(n * 128)
	gTok = calloc(256, 1)
	tc := "!#$%&'*+-.^_`|~0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
	for i := 0; i < len(tc); i++ {
		store8(gTok+i64(tc[i]), 1)
	}
	fds := calloc(2, 4)
	for i := 0; i < n; i++ {
		pipe(fds)
		gPipes[2*i] = __ld(fds, 2)
		gPipes[2*i+1] = __ld(fds+4, 2)
		fcntl(gPipes[2*i], F_SETFL, O_NONBLOCK)
	}
	gGrace = 25
	if !gDeadlineSet {
		gDeadlineMs = 30000
	}
	denv := getenv(cast(i64, "TIN_DEADLINE_MS") + 8)
	if denv != 0 {
		gDeadlineMs = atoi(denv) & 0xffffffff
	}
	genv := getenv(cast(i64, "TIN_GRACE") + 8)
	if genv != 0 && atoi(genv)&0xffffffff > 0 {
		gGrace = atoi(genv) & 0xffffffff
	}
	// SIGTERM and SIGINT are blocked in every thread (cores inherit this mask) and taken by
	// core 0's event loop instead: a handler could run on any thread and no Tin code may.
	rt_sig_block_term()
	hearth.Run(n, core)
}


// open_listener binds a non-blocking listener on ip:port (SO_REUSEPORT, so every core
// can have one on Linux); -1, -2, -3 report a socket, bind or listen failure.
func open_listener(ip i64, port i64) i64 {
	fd := c32(socket(2, 1, 0))
	if fd < 0 {
		return -1
	}
	one := calloc(1, 8)
	one[0] = 1
	setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, one, 4)
	if ownListener {
		setsockopt(fd, SOL_SOCKET, SO_REUSEPORT, one, 4)
	}
	free(one)
	sa := calloc(1, 16)
	rt_sockaddr_in(sa, ip, port)
	if c32(bind(fd, sa, 16)) < 0 {
		close(fd)
		return -2
	}
	free(sa)
	if c32(listen(fd, 4096)) < 0 {
		close(fd)
		return -3
	}
	fcntl(fd, F_SETFL, O_NONBLOCK)
	return fd
}

func core(id i64) {
	myID = id
	ev_init()
	conns = calloc(65536, 8)
	evs = calloc(maxEvents, 32)
	scr = malloc(scrSize)
	obCap = 65536
	ob = malloc(obCap)
	// The core's small scratch areas share one block aligned to the 128-byte cache line,
	// so no two cores ever write the same line.
	block := rt_aligned_alloc(1024)
	change = block
	word = block + 128
	common = block + 640
	tm = block + 768
	refresh_date(time(0))
	pr := gPipes[2*id]
	ev_level(pr)
	myListen = -1
	if id == 0 {
		myListen = gListen
	} else if ownListener {
		myListen = open_listener(gIP, gPort)
	}
	if myListen >= 0 {
		ev_level(myListen)
	}
	rfd := -1
	if gRelayOn {
		rfd = relay.WakeFD()
		ev_level(rfd)
	}
	tick := -1
	if gTickMs > 0 {
		tick = ev_timer(gTickMs)
	}
	// Request tasks wait on client sockets through this loop, and on helper threads
	// through a pipe.
	fdTask = calloc(65536, 8)
	jfds := calloc(2, 4)
	pipe(jfds)
	doneRd = i64(i32(__ld(jfds, 2)))
	doneFd = i64(i32(__ld(jfds+4, 2)))
	fcntl(doneRd, F_SETFL, O_NONBLOCK)
	ev_level(doneRd)
	waitHook = task_watch
	waitCancel = task_unwatch
	drainTimer = -1
	if id == 0 {
		ev_signals()
	}
	for {
		if gRelayOn {
			relay.Arm()
		}
		n := ev_wait(wait_ms())
		run_timers()
		if n <= 0 {
			continue
		}
		now := time(0)
		if now != lastSec {
			refresh_date(now)
		}
		for i := 0; i < n; i++ {
			fd := ev_fd(i)
			if ev_signal(i) {
				on_signal()
			} else if fd == pr {
				take_handoffs(pr)
			} else if fd == drainTimer {
				ev_timer_ack(drainTimer)
				if rt_mono_ns() >= deadline {
					rt_flush_core()
					exit(0)
				}
			} else if fd == tick {
				ev_timer_ack(tick)
				gTick(id)
				rt_pool_reset()
			} else if fd == rfd {
				relay.Drain(gRelay)
				rt_pool_reset()
			} else if fd == myListen {
				accept_all()
			} else if fd == doneRd {
				take_jobs()
			} else if fd >= 0 && fd < 65536 && fdTask[fd] != 0 {
				task := fdTask[fd]
				fdTask[fd] = 0
				ev_task_del(fd)
				rt_task_ready(task)
				resume_task(task)
			} else {
				c := conns[fd]
				if c != 0 {
					if ev_writable(i) {
						on_write(c)
					} else {
						on_read(c)
						// An edge-triggered hang-up is reported once: close now, or after
						// the pending output is written.
						if ev_hangup(i) && conns[fd] == c {
							// A client that only shut down its sending side still reads: a
							// request that waits gets its response, then the connection closes.
							if c[cOut] == 0 && c[cTask] == 0 {
								close_conn(c)
							} else {
								c[cClose] = 1
							}
						}
					}
				}
			}
		}
		if draining && drain_done() {
			return
		}
	}
}

// on_signal (core 0) starts the graceful shutdown on the first SIGTERM or SIGINT: every core
// stops accepting and ends once its connections are gone; a second signal exits at once.
func on_signal() {
	ev_signal_ack()
	if gStop != 0 {
		rt_flush_core()
		exit(0)
	}
	gStop = 1
	deadline = rt_mono_ns() + gGrace*1000000000
	word[3] = -1
	for j := 1; j < gCores; j++ {
		write(gPipes[2*j+1], word+24, 8)
	}
	drainTimer = ev_drain_timer(100)
	begin_drain()
}

// begin_drain stops this core from accepting: its listener closes, open connections finish
// their current request and are closed after their next response (Connection: close).
func begin_drain() {
	if draining {
		return
	}
	draining = true
	if myListen >= 0 {
		close(myListen)
		myListen = -1
	}
}

// drain_done reports whether this core may stop: no connection is left (counted once in
// gDrained); core 0 also waits until every other core has reported, so Serve returns.
func drain_done() bool {
	if !reported && __atomic_load(gLoad+myID*128) == 0 {
		reported = true
		__atomic_add(&gDrained, 1)
	}
	if myID != 0 {
		return reported
	}
	return __atomic_load(&gDrained) == gCores
}

func refresh_date(now i64) {
	lastSec = now
	word[0] = now
	gmtime_r(word, tm)
	s := "Server: anvil\r\n"
	memcpy(common, cast(i64, s)+8, len(s))
	commonLen = len(s) + c32(strftime(common+len(s), 100, cast(i64, "Date: %a, %d %b %Y %H:%M:%S GMT\r\n")+8, tm))
}

func accept_all() {
	for k := 0; k < 64; k++ {
		fd := c32(accept(myListen, 0, 0))
		if fd < 0 {
			e := errno()
			if (e == 24 || e == 23) && gSpare >= 0 {
				drop_one()
			}
			return
		}
		fcntl(fd, F_SETFL, O_NONBLOCK)
		word[1] = 1
		setsockopt(fd, 6, 1, word+8, 4)
		if fd >= 65536 {
			close(fd)
			continue
		}
		target := myID
		if ownListener {
			// SO_REUSEPORT hashes connections unevenly over the per-core listeners: a core
			// that is more than one connection ahead of the least-loaded one hands over.
			j := least_loaded()
			if j != myID && __atomic_load(gLoad+myID*128) > __atomic_load(gLoad+j*128)+1 {
				target = j
			}
		} else {
			target = rr % gCores
			rr++
		}
		if target == myID {
			add_conn(fd, true)
		} else {
			__atomic_add(gLoad+target*128, 1)
			word[2] = fd
			write(gPipes[2*target+1], word+16, 8)
		}
	}
}

// least_loaded is the core with the fewest live connections (handoffs in flight included).
func least_loaded() i64 {
	best := 0
	bestLoad := __atomic_load(gLoad)
	for j := 1; j < gCores; j++ {
		l := __atomic_load(gLoad + j*128)
		if l < bestLoad {
			best = j
			bestLoad = l
		}
	}
	return best
}

// drop_one frees the spare fd to accept and close one waiting connection: the client gets
// a clean close instead of hanging, and the level-triggered listen event stops spinning.
func drop_one() {
	close(gSpare)
	fd := c32(accept(myListen, 0, 0))
	if fd >= 0 {
		close(fd)
	}
	gSpare = c32(open(cast(i64, "/dev/null")+8, 0))
}

// take_handoffs registers the connections other cores dealt to this one (already counted
// in this core's load by the sender).
func take_handoffs(pr i64) {
	n := read(pr, word+64, 256)
	for i := 0; i+8 <= n; i += 8 {
		fd := (word + 64 + i)[0]
		if fd == -1 {
			begin_drain()
		} else {
			add_conn(fd, false)
		}
	}
}

func add_conn(fd i64, count bool) {
	c := calloc(cWords, 8)
	c[cFD] = fd
	conns[fd] = c
	if count {
		__atomic_add(gLoad+myID*128, 1)
	}
	ev_conn(fd)
}

func close_conn(c i64) {
	if c[cDead] != 0 {
		return
	}
	fd := c[cFD]
	close(fd)
	conns[fd] = 0
	if c[cTask] != 0 {
		// Its request is still waiting: free the connection when the task ends.
		c[cDead] = 1
		return
	}
	free_conn(c)
}

// free_conn releases a closed connection's buffers.
func free_conn(c i64) {
	__atomic_add(gLoad+myID*128, -1)
	if c[cIn] != 0 {
		free(c[cIn])
	}
	if c[cOut] != 0 {
		free(c[cOut])
	}
	free(c)
}

// Connections are edge-triggered (EV_CLEAR, like Go's poller): kqueue reports each
// arrival once, so on_read keeps reading while a read fills the whole buffer.
func on_read(c i64) {
	for on_read_once(c) {
	}
}

// on_read_once reads and serves what one read returns; true means more may be waiting.
func on_read_once(c i64) bool {
	fd := c[cFD]
	buf := scr
	cap := scrSize
	have := 0
	big := false
	if c[cIn] != 0 {
		if c[cInCap] > scrSize {
			buf = c[cIn]
			cap = c[cInCap]
			have = c[cInLen]
			big = true
		} else {
			memcpy(scr, c[cIn], c[cInLen])
			have = c[cInLen]
			free(c[cIn])
			c[cIn] = 0
			c[cInLen] = 0
			c[cInCap] = 0
		}
	}
	want := cap - have
	n := read(fd, buf+have, want)
	if n == 0 && c[cTask] != 0 {
		// End of input while a request waits: answer it, then close.
		c[cClose] = 1
		return false
	}
	if n <= 0 {
		if n < 0 && (errno() == EAGAIN || errno() == 4) {
			n = 0
		} else {
			close_conn(c)
			return false
		}
	}
	full := n == want && n > 0
	have += n
	off := 0
	for off < have && c[cClose] == 0 && c[cTask] == 0 {
		r := serve_one(c, buf+off, have-off)
		if r <= 0 {
			break
		}
		off += r
	}
	if !flush(c) {
		return false
	}
	rem := have - off
	if rem > 0 && c[cClose] == 0 {
		need := c[cNeed]
		if need < rem+4096 {
			need = rem + 4096
		}
		if rem == cap {
			need = cap * 2
		}
		if need > maxRequest {
			close_conn(c)
			return false
		}
		if big {
			if off > 0 {
				memmove(buf, buf+off, rem)
			}
			if need > cap {
				buf = realloc(buf, need)
				cap = need
			}
			c[cIn] = buf
			c[cInLen] = rem
			c[cInCap] = cap
		} else {
			p := malloc(need)
			memcpy(p, buf+off, rem)
			c[cIn] = p
			c[cInLen] = rem
			c[cInCap] = need
		}
	} else if big {
		free(buf)
		c[cIn] = 0
		c[cInLen] = 0
		c[cInCap] = 0
	}
	rt_pool_reset()
	return full && c[cClose] == 0 && c[cWriting] == 0 && c[cTask] == 0
}

// flush writes the batch's responses; false means the connection is gone. While the
// socket will not take the output, reading stops too, so a client that never reads
// cannot make the server buffer responses without bound.
func flush(c i64) bool {
	if obLen == 0 {
		if c[cClose] != 0 && c[cOut] == 0 {
			close_conn(c)
			return false
		}
		return true
	}
	if c[cOut] != 0 {
		pend_out(c, ob, obLen)
		obLen = 0
		return true
	}
	w := write(c[cFD], ob, obLen)
	if w < 0 {
		if errno() != EAGAIN && errno() != 4 {
			obLen = 0
			close_conn(c)
			return false
		}
		w = 0
	}
	if w < obLen {
		pend_out(c, ob+w, obLen-w)
		obLen = 0
		ev_conn_write(c[cFD])
		c[cWriting] = 1
		return true
	}
	obLen = 0
	if c[cClose] != 0 {
		close_conn(c)
		return false
	}
	return true
}

func pend_out(c i64, p i64, n i64) {
	if c[cOut] == 0 {
		c[cOut] = malloc(n)
		memcpy(c[cOut], p, n)
		c[cOutLen] = n
		c[cOutOff] = 0
		return
	}
	c[cOut] = realloc(c[cOut], c[cOutLen]+n)
	memcpy(c[cOut]+c[cOutLen], p, n)
	c[cOutLen] += n
}

func on_write(c i64) {
	if c[cOut] == 0 {
		return
	}
	w := write(c[cFD], c[cOut]+c[cOutOff], c[cOutLen]-c[cOutOff])
	if w < 0 {
		if errno() != EAGAIN && errno() != 4 {
			close_conn(c)
		}
		return
	}
	c[cOutOff] += w
	if c[cOutOff] < c[cOutLen] {
		return
	}
	free(c[cOut])
	c[cOut] = 0
	c[cOutLen] = 0
	c[cOutOff] = 0
	c[cWriting] = 0
	if c[cClose] != 0 {
		close_conn(c)
		return
	}
	ev_conn_read(c[cFD])
	if c[cIn] != 0 {
		on_read(c)
	}
}

func lower(c u8) u8 {
	if c >= 'A' && c <= 'Z' {
		return c + 32
	}
	return c
}

// name_is reports whether the header name at p (n bytes) is lname, ignoring case.
func name_is(p i64, n i64, lname str) bool {
	if n != len(lname) {
		return false
	}
	for i := 0; i < n; i++ {
		if lower(load8(p+i)) != lname[i] {
			return false
		}
	}
	return true
}

// bytes_are reports whether the n bytes at p equal s.
func bytes_are(p i64, n i64, s str) bool {
	if n != len(s) {
		return false
	}
	for i := 0; i < n; i++ {
		if load8(p+i) != s[i] {
			return false
		}
	}
	return true
}

func method_str(p i64, n i64) str {
	c := load8(p)
	if n == 3 && c == 'G' && load8(p+1) == 'E' && load8(p+2) == 'T' {
		return "GET"
	}
	if c == 'P' && bytes_are(p, n, "POST") {
		return "POST"
	}
	if c == 'P' && bytes_are(p, n, "PUT") {
		return "PUT"
	}
	if c == 'H' && bytes_are(p, n, "HEAD") {
		return "HEAD"
	}
	if c == 'D' && bytes_are(p, n, "DELETE") {
		return "DELETE"
	}
	return rt_str_from_raw(p, n)
}

// serve_one handles the request at p (n bytes available): the bytes it used, or 0
// when the request has not fully arrived.
func serve_one(c i64, p i64, n i64) i64 {
	nl := memchr(p, '\n', n)
	if nl == 0 {
		c[cNeed] = 0
		if n > maxLine {
			bad(c, 414)
		}
		return 0
	}
	le := nl - p
	if le > maxLine {
		bad(c, 414)
		return -1
	}
	ll := le
	if ll > 0 && load8(p+ll-1) == '\r' {
		ll--
	}
	sp1 := -1
	sp2 := -1
	nsp := 0
	ctl := false
	for i := 0; i < ll; i++ {
		b := load8(p + i)
		if b == ' ' {
			if sp1 < 0 {
				sp1 = i
			}
			sp2 = i
			nsp++
		} else if b < ' ' || b == 0x7f {
			ctl = true
		}
	}
	minor := load8(p + ll - 1)
	if ctl || nsp != 2 || sp1 <= 0 || sp2 <= sp1+1 || ll-sp2-1 != 8 || !is_http1(p+sp2+1) || minor < '0' || minor > '9' {
		// Control bytes (a bare CR, NUL, tab) are not allowed anywhere in the request line.
		bad(c, 400)
		return -1
	}
	// HTTP/1.0 closes unless it asks for keep-alive; 1.1 and later 1.x keep the connection.
	http10 := minor == '0'
	alive := !http10
	ts := sp1 + 1
	tn := sp2 - sp1 - 1
	if tn > 7 && (load8(p+ts) == 'h' || load8(p+ts) == 'H') {
		// Absolute-form ("http://host/path?q", RFC 9112 3.2.2): route on the path.
		k := 0
		if name_is(p+ts, 7, "http://") {
			k = 7
		} else if tn > 8 && name_is(p+ts, 8, "https://") {
			k = 8
		}
		if k > 0 {
			for k < tn && load8(p+ts+k) != '/' && load8(p+ts+k) != '?' {
				k++
			}
			ts += k
			tn -= k
		}
	}
	hosts := 0
	seenClose := false
	pos := le + 1
	cl := 0
	seenCL := false
	hend := 0
	for {
		e := memchr(p+pos, '\n', n-pos)
		if e == 0 {
			c[cNeed] = 0
			if n > maxLine {
				bad(c, 431)
			}
			return 0
		}
		l := e - (p + pos)
		if l == 0 || (l == 1 && load8(p+pos) == '\r') {
			hend = pos + l + 1
			break
		}
		if pos+l > maxLine {
			bad(c, 431)
			return -1
		}
		h := p + pos
		kn := field_name(h, l)
		if kn == 0 {
			// Rejected, not skipped: a parser that trims or unfolds the line could frame
			// the request differently (RFC 9112 5.1, 5.2).
			bad(c, 400)
			return -1
		}
		// A CR inside a field line (only the one before LF is allowed) or a NUL is rejected: a
		// proxy that ends lines at a bare CR would frame the request differently (RFC 9112 2.2).
		vl := l
		if vl > 0 && load8(h+vl-1) == '\r' {
			vl--
		}
		if memchr(h, '\r', vl) != 0 || memchr(h, 0, vl) != 0 {
			bad(c, 400)
			return -1
		}
		f := lower(load8(h))
		if f == 'h' && kn == 4 && name_is(h, kn, "host") {
			hosts++
		} else if f == 'c' && kn == 14 && name_is(h, kn, "content-length") {
			v := parse_cl(h+kn+1, l-kn-1)
			// Repeated Content-Length headers must agree, or the framing is ambiguous (RFC 9112 6.3).
			if v < 0 || (seenCL && v != cl) {
				bad(c, 400)
				return -1
			}
			cl = v
			seenCL = true
		} else if f == 'c' && kn == 10 && name_is(h, kn, "connection") {
			// A comma-separated list of tokens: "close" anywhere wins (RFC 9112 9.6).
			j := kn + 1
			for j < vl {
				for j < vl && (load8(h+j) == ' ' || load8(h+j) == '\t' || load8(h+j) == ',') {
					j++
				}
				e := j
				for e < vl && load8(h+e) != ',' && load8(h+e) != ' ' && load8(h+e) != '\t' {
					e++
				}
				if name_is(h+j, e-j, "close") {
					alive = false
					seenClose = true
				} else if name_is(h+j, e-j, "keep-alive") && !seenClose {
					alive = true
				}
				j = e
			}
		} else if f == 't' && kn == 17 && name_is(h, kn, "transfer-encoding") {
			bad(c, 501)
			return -1
		}
		pos += l + 1
	}
	if !http10 && hosts != 1 {
		// HTTP/1.1 requires exactly one Host field (RFC 9112 3.2).
		bad(c, 400)
		return -1
	}
	total := hend + cl
	if total > maxRequest {
		bad(c, 413)
		return -1
	}
	if n < total {
		c[cNeed] = total
		return 0
	}
	c[cNeed] = 0
	if waiting >= maxWaiting {
		// Backpressure: too many requests already wait on this core.
		bad(c, 503)
		return total
	}
	// The handler runs in a task: when it waits (tide.Wait, a client call) the core serves
	// other connections, and this one's later requests queue until it finishes.
	pReq = p
	pReqLen = total
	pSp1 = sp1
	pSp2 = sp2
	pLe = le
	pHend = hend
	pCl = cl
	pHead = sp1 == 4 && load8(p) == 'H' && bytes_are(p, 4, "HEAD")
	pTs = ts
	pTn = tn
	pKeep10 = http10 && alive
	task := rt_task_new(run_request, c)
	if gDeadlineMs > 0 {
		rt_task_set_deadline(task, rt_mono_ns()+gDeadlineMs*1000000)
	}
	if rt_task_run(task) {
		rt_task_free(task)
		if !alive || draining {
			c[cClose] = 1
		}
		return total
	}
	// It waits: keep its own copy of the request bytes (the read buffer is reused).
	rb := malloc(total)
	memcpy(rb, p, total)
	task[tUser+1] = rb
	rebase_request(task, rb-p)
	c[cTask] = task
	c[cAlive] = i64(alive)
	if c[cHijack] == 0 {
		waiting++
	}
	return total
}

// run_request is a request task's body: build the Req and Out, run the handler, and append
// the response to the core's output batch.
func run_request(c i64) {
	p := pReq
	t := p + pTs
	tn := pTn
	q := Req{Method: method_str(p, pSp1), Path: "", Query: "", hp: p + pLe + 1, hn: pHend - pLe - 1, bp: p + pHend, bn: pCl}
	qm := memchr(t, '?', tn)
	if qm == 0 {
		q.Path = rt_str_from_raw(t, tn)
	} else {
		q.Path = rt_str_from_raw(t, qm-t)
		q.Query = rt_str_from_raw(qm+1, tn-(qm-t)-1)
	}
	if len(q.Path) == 0 {
		q.Path = "/"
	}
	hd := pHead
	keep10 := pKeep10
	body := make([]u8, 0, 1024)
	w := Out{Body: body, code: 200, ctype: "text/plain; charset=utf-8", extra: make([]u8, 0, 256), own: body}
	rt_task_current()[tUser] = cast(i64, q)
	if gRoutes != 0 {
		dispatch(cast(rtable, gRoutes), mut q, mut w)
	} else {
		gHandler(q, mut w)
	}
	if c[cHijack] == 0 {
		respond_out(w, hd, keep10)
	}
}

// rebase_request points a waiting task's Req at its own copy of the request bytes.
func rebase_request(task i64, delta i64) {
	q := cast(Req, task[tUser])
	q.hp += delta
	q.bp += delta
}

// finish_request completes connection c after its waiting task finished: write the
// response, then serve the requests that queued behind it.
func finish_request(c i64, task i64) {
	free(task[tUser+1])
	rt_task_free(task)
	if c[cHijack] != 0 {
		close(c[cFD])
		free_conn(c)
		return
	}
	waiting--
	c[cTask] = 0
	if c[cDead] != 0 {
		obLen = 0
		free_conn(c)
		return
	}
	if c[cAlive] == 0 || draining {
		c[cClose] = 1
	}
	if !flush(c) {
		return
	}
	if c[cWriting] == 0 {
		on_read(c)
	}
}

// resume_task continues a task that waited; when it ends, its connection moves on.
func resume_task(task i64) {
	if rt_task_run(task) {
		finish_request(task[tArg], task)
	}
}

// task_watch is the runtime's wait hook: watch fd for the running task.
func task_watch(fd i64, want i64) {
	fdTask[fd] = rt_task_current()
	ev_task_add(fd, want)
}

func task_unwatch(fd i64) {
	ev_task_del(fd)
	fdTask[fd] = 0
}

// take_jobs resumes the tasks whose helper jobs finished.
func take_jobs() {
	buf := word
	for {
		n := read(doneRd, buf, 8)
		if n != 8 {
			return
		}
		job := buf[0]
		task := rt_helper_done(job)
		if task != 0 {
			rt_task_ready(task)
			resume_task(task)
		}
	}
}

// run_timers resumes every task whose wait is over.
func run_timers() {
	task := rt_timer_pop(rt_mono_ns())
	for task != 0 {
		resume_task(task)
		task = rt_timer_pop(rt_mono_ns())
	}
	// Tasks woken by other tasks; the ones they wake in turn wait for the next pass.
	n := rt_task_ready_count()
	for ; n > 0; n-- {
		resume_task(rt_task_take_ready())
	}
}

// wait_ms is how long the event loop may block: until the earliest task wake-up, or -1.
func wait_ms() i64 {
	if rt_task_any_ready() {
		return 0
	}
	next := rt_timer_next()
	if next < 0 {
		return -1
	}
	d := next - rt_mono_ns()
	if d <= 0 {
		return 0
	}
	return (d + 999999) / 1000000
}

// Deadline makes every request's waits (tide.Wait, client calls) fail with "deadline
// exceeded" once ms have passed since the request started (0: no deadline; call before
// Serve). TIN_DEADLINE_MS sets it too; the default is 30000.
func Deadline(ms i64) {
	gDeadlineMs = ms
	gDeadlineSet = true
}

// is_http1 reports whether the 8 bytes at p start with "HTTP/1.".
func is_http1(p i64) bool {
	return load8(p) == 'H' && load8(p+1) == 'T' && load8(p+2) == 'T' && load8(p+3) == 'P' && load8(p+4) == '/' && load8(p+5) == '1' && load8(p+6) == '.'
}

// field_name is the length of the name of the header line at h (l bytes): a token
// followed by ':'. 0 means it is not a field line: no colon, an empty name, whitespace
// before the colon, obs-fold or another byte a token cannot hold.
func field_name(h i64, l i64) i64 {
	tok := gTok
	i := 0
	for i < l && load8(tok+i64(load8(h+i))) != 0 {
		i++
	}
	if i < l && load8(h+i) == ':' {
		return i
	}
	return 0
}

// parse_cl parses a Content-Length value (n bytes at p): the length, -1 when it is not a plain decimal number.
func parse_cl(p i64, n i64) i64 {
	i := 0
	for i < n && (load8(p+i) == ' ' || load8(p+i) == '\t') {
		i++
	}
	v := 0
	nd := 0
	for i < n {
		d := load8(p + i)
		if d < '0' || d > '9' {
			break
		}
		if v <= maxRequest {
			v = v*10 + i64(d-'0')
		}
		nd++
		i++
	}
	if nd == 0 {
		return -1
	}
	for i < n {
		d := load8(p + i)
		if d != ' ' && d != '\t' && d != '\r' {
			return -1
		}
		i++
	}
	return v
}

func bad(c i64, code i64) {
	body := make([]u8, 0, 64)
	w := Out{Body: body, code: code, ctype: "text/plain; charset=utf-8", extra: make([]u8, 0), own: body}
	w.Body = append(w.Body, status_text(code)...)
	respond_out(w, false, false)
	c[cClose] = 1
}

func ob_room(n i64) {
	if obLen+n > obCap {
		for obLen+n > obCap {
			obCap *= 2
		}
		ob = realloc(ob, obCap)
	}
}

func ob_str(s str) {
	memcpy(ob+obLen, cast(i64, s)+8, len(s))
	obLen += len(s)
}

func ob_raw(p i64, n i64) {
	memcpy(ob+obLen, p, n)
	obLen += n
}

// respond_out appends response w to the core's output batch; keep10 adds
// "Connection: keep-alive", which an HTTP/1.0 client needs to keep the connection.
func respond_out(w Out, hd bool, keep10 bool) {
	bh := cast(i64, w.Body)
	eh := cast(i64, w.extra)
	bn := bh[0]
	ob_room(256 + len(w.ctype) + eh[0] + bn)
	ob_str(status_line(w.code))
	ob_raw(common, commonLen)
	if w.code < 200 || w.code == 204 || w.code == 304 {
		// No body is allowed (RFC 9110 6.4.1): no Content-Type or Content-Length either, and
		// whatever the handler wrote is dropped, or the client would read it as the next response.
		if eh[0] > 0 {
			ob_raw(eh[2], eh[0])
		}
		if draining {
			ob_str("Connection: close\r\n")
		} else if keep10 {
			ob_str("Connection: keep-alive\r\n")
		}
		ob_str("\r\n")
		return
	}
	ob_str("Content-Type: ")
	ob_str(w.ctype)
	ob_str("\r\nContent-Length: ")
	d := ob + obLen
	nd := 1
	for t := bn; t >= 10; t /= 10 {
		nd++
	}
	v := bn
	for i := nd - 1; i >= 0; i-- {
		store8(d+i, '0'+v%10)
		v /= 10
	}
	obLen += nd
	ob_str("\r\n")
	if eh[0] > 0 {
		ob_raw(eh[2], eh[0])
	}
	if draining {
		ob_str("Connection: close\r\n")
	} else if keep10 {
		ob_str("Connection: keep-alive\r\n")
	}
	ob_str("\r\n")
	if !hd {
		ob_raw(bh[2], bn)
	}
}

func status_line(code i64) str {
	switch code {
	case 200:
		return "HTTP/1.1 200 OK\r\n"
	case 201:
		return "HTTP/1.1 201 Created\r\n"
	case 204:
		return "HTTP/1.1 204 No Content\r\n"
	case 301:
		return "HTTP/1.1 301 Moved Permanently\r\n"
	case 302:
		return "HTTP/1.1 302 Found\r\n"
	case 304:
		return "HTTP/1.1 304 Not Modified\r\n"
	case 400:
		return "HTTP/1.1 400 Bad Request\r\n"
	case 401:
		return "HTTP/1.1 401 Unauthorized\r\n"
	case 403:
		return "HTTP/1.1 403 Forbidden\r\n"
	case 404:
		return "HTTP/1.1 404 Not Found\r\n"
	case 405:
		return "HTTP/1.1 405 Method Not Allowed\r\n"
	case 413:
		return "HTTP/1.1 413 Content Too Large\r\n"
	case 414:
		return "HTTP/1.1 414 URI Too Long\r\n"
	case 431:
		return "HTTP/1.1 431 Request Header Fields Too Large\r\n"
	case 500:
		return "HTTP/1.1 500 Internal Server Error\r\n"
	case 501:
		return "HTTP/1.1 501 Not Implemented\r\n"
	case 503:
		return "HTTP/1.1 503 Service Unavailable\r\n"
	case 502:
		return "HTTP/1.1 502 Bad Gateway\r\n"
	case 504:
		return "HTTP/1.1 504 Gateway Timeout\r\n"
	}
	b := make([]u8, 0, 32)
	b = append(b, "HTTP/1.1 "...)
	b = append(b, str_int(code)...)
	b = append(b, " Status\r\n"...)
	return str(b)
}

func status_text(code i64) str {
	s := status_line(code)
	return s[13 : len(s)-2]
}

func str_int(v i64) str {
	if v == 0 {
		return "0"
	}
	b := make([]u8, 0, 20)
	for v > 0 {
		b = append(b, u8('0'+v%10))
		v /= 10
	}
	for i := 0; i < len(b)/2; i++ {
		t := b[i]
		b[i] = b[len(b)-1-i]
		b[len(b)-1-i] = t
	}
	return str(b)
}

// Header returns the value of the request header name (any case), or "".
func (q Req) Header(name str) str {
	p := q.hp
	end := q.hp + q.hn
	for p < end {
		e := memchr(p, '\n', end-p)
		if e == 0 {
			return ""
		}
		l := e - p
		k := memchr(p, ':', l)
		if k != 0 && k-p == len(name) {
			same := true
			for i := 0; i < len(name); i++ {
				if lower(load8(p+i)) != lower(name[i]) {
					same = false
					break
				}
			}
			if same {
				v := k + 1
				for v < e && (load8(v) == ' ' || load8(v) == '\t') {
					v++
				}
				ve := e
				for ve > v && (load8(ve-1) == '\r' || load8(ve-1) == ' ') {
					ve--
				}
				return rt_str_from_raw(v, ve-v)
			}
		}
		p = e + 1
	}
	return ""
}

// Hijack takes the request's connection out of HTTP for a protocol of its own (the
// websocket package uses it): the responses before this request are written, the core
// stops reading the connection and the request's deadline no longer applies. It returns
// the non-blocking descriptor, for the caller's I/O until the handler returns; then anvil
// closes it. The handler's Out is not sent.
func (q Req) Hijack() !i64 {
	task := rt_task_current()
	if task == 0 {
		fail "anvil: Hijack outside a request"
	}
	c := task[tArg]
	if c[cHijack] != 0 {
		fail "anvil: the connection is already hijacked"
	}
	fd := c[cFD]
	ev_task_del(fd)
	conns[fd] = 0
	c[cHijack] = 1
	rt_task_set_deadline(task, 0)
	if obLen > 0 {
		pend_out(c, ob, obLen)
		obLen = 0
	}
	for c[cOut] != 0 && c[cOutOff] < c[cOutLen] {
		k := write(fd, c[cOut]+c[cOutOff], c[cOutLen]-c[cOutOff])
		if k > 0 {
			c[cOutOff] += k
			continue
		}
		e := errno()
		if e == EAGAIN {
			rt_task_wait(fd, 2, 0)
		} else if e != 4 {
			break
		}
	}
	if c[cOut] != 0 {
		free(c[cOut])
		c[cOut] = 0
	}
	c[cWriting] = 0
	// From here the request always ends through finish_request, which closes it.
	rt_task_defer()
	return fd
}

// Body returns the request body.
func (q Req) Body() str {
	return rt_str_from_raw(q.bp, q.bn)
}

// Param returns query parameter name, %-decoded, or "".
func (q Req) Param(name str) str {
	s := q.Query
	i := 0
	for i < len(s) {
		j := i
		for j < len(s) && s[j] != '&' {
			j++
		}
		eq := i
		for eq < j && s[eq] != '=' {
			eq++
		}
		if eq-i == len(name) && s[i:eq] == name {
			if eq >= j {
				return ""
			}
			return unescape(s[eq+1 : j])
		}
		i = j + 1
	}
	return ""
}

// PathParam returns path parameter name of the Router route that matched ({name}, {name...},
// or "*" for a last *), %-decoded, or "".
func (q Req) PathParam(name str) str {
	if q.ep == 0 {
		return ""
	}
	e := cast(rend, q.ep)
	for i := 0; i < len(e.names); i++ {
		if e.names[i] == name {
			a, b := seg_span(q.Path, e.segs[i])
			if e.rest && i == len(e.names)-1 {
				b = len(q.Path)
			}
			return path_unescape(q.Path, a, b)
		}
	}
	return ""
}

// Pattern returns the pattern of the Router route serving the request ("/users/{id}"), or ""
// (no Router, or a 404 or 405 answer).
func (q Req) Pattern() str {
	if q.ep == 0 {
		return ""
	}
	e := cast(rend, q.ep)
	return e.pattern
}

func hexval(c u8) i64 {
	if c >= '0' && c <= '9' {
		return i64(c - '0')
	}
	if c >= 'a' && c <= 'f' {
		return i64(c-'a') + 10
	}
	if c >= 'A' && c <= 'F' {
		return i64(c-'A') + 10
	}
	return -1
}

func unescape(s str) str {
	b := make([]u8, 0, len(s))
	for i := 0; i < len(s); i++ {
		c := s[i]
		if c == '+' {
			b = append(b, ' ')
		} else if c == '%' && i+2 < len(s) && hexval(s[i+1]) >= 0 && hexval(s[i+2]) >= 0 {
			b = append(b, u8(hexval(s[i+1])*16+hexval(s[i+2])))
			i += 2
		} else {
			b = append(b, c)
		}
	}
	return str(b)
}

// Status sets the response status code.
func (w mut Out) Status(code i64) {
	w.code = code
}

// Type sets the Content-Type header. CR, LF and NUL in t become spaces, so a value taken from
// the request cannot add header lines.
func (w mut Out) Type(t str) {
	w.ctype = field_value(t)
}

// Head adds a response header. A name that is not an HTTP token is ignored, and so are
// Content-Length, Transfer-Encoding and Connection: anvil writes the framing itself. CR, LF and
// NUL in the value become spaces, so a value taken from the request cannot add header lines or
// a body (response splitting), as Go's net/http does.
func (w mut Out) Head(k str, v str) {
	if !is_token(k) || is_framing(k) {
		return
	}
	w.extra = append(w.extra, k...)
	w.extra = append(w.extra, ": "...)
	for i := 0; i < len(v); i++ {
		c := v[i]
		if c == '\r' || c == '\n' || c == 0 {
			c = ' '
		}
		w.extra = append(w.extra, c)
	}
	w.extra = append(w.extra, "\r\n"...)
}

// field_value is s with CR, LF and NUL replaced by spaces (s itself when it has none).
func field_value(s str) str {
	bad := false
	for i := 0; i < len(s); i++ {
		if s[i] == '\r' || s[i] == '\n' || s[i] == 0 {
			bad = true
			break
		}
	}
	if !bad {
		return s
	}
	b := make([]u8, len(s))
	for i := 0; i < len(s); i++ {
		c := s[i]
		if c == '\r' || c == '\n' || c == 0 {
			c = ' '
		}
		b[i] = c
	}
	return str(b)
}

// is_framing reports whether header k is one anvil computes for every response.
func is_framing(k str) bool {
	n := cast(i64, k) + 8
	return name_is(n, len(k), "content-length") || name_is(n, len(k), "transfer-encoding") || name_is(n, len(k), "connection")
}

// Text appends s to the body.
func (w mut Out) Text(s str) {
	w.Body = append(w.Body, s...)
}

// Json sets the JSON content type; the body is then written with argo.Put(mut w.Body, v).
func (w mut Out) Json() {
	w.ctype = "application/json"
}

// Code returns the response status set so far (200 unless Status changed it).
func (w Out) Code() i64 {
	return w.code
}

// Header returns response header k as set so far (Type sets Content-Type, Head the rest), or "".
func (w Out) Header(k str) str {
	if len(k) == 12 && name_is(cast(i64, k)+8, 12, "content-type") {
		return w.ctype
	}
	e := w.extra
	for i := 0; i < len(e); {
		j := i
		for j < len(e) && e[j] != '\n' {
			j++
		}
		c := i
		for c < j && e[c] != ':' {
			c++
		}
		if c-i == len(k) && c < j {
			same := true
			for x := 0; x < len(k); x++ {
				if lower(e[i+x]) != lower(k[x]) {
					same = false
					break
				}
			}
			if same {
				v := c + 1
				for v < j && e[v] == ' ' {
					v++
				}
				ve := j
				if ve > v && e[ve-1] == '\r' {
					ve--
				}
				return str(e[v:ve])
			}
		}
		i = j + 1
	}
	return ""
}

// SetValue stores value under key for the rest of the request: middleware hand data (a user
// id, a request id) to the handlers after them this way. Value reads it back.
func (w mut Out) SetValue(key str, value str) {
	if w.vals == 0 {
		w.vals = cast(i64, make([]str, 0, 4))
	}
	v := cast([]str, w.vals)
	for i := 0; i+1 < len(v); i += 2 {
		if v[i] == key {
			v[i+1] = value
			return
		}
	}
	v = append(v, key, value)
}

// Value returns what SetValue stored under key in this request, or "".
func (w Out) Value(key str) str {
	if w.vals == 0 {
		return ""
	}
	v := cast([]str, w.vals)
	for i := 0; i+1 < len(v); i += 2 {
		if v[i] == key {
			return v[i+1]
		}
	}
	return ""
}

// OnRelay makes every core run h(from, msg) for each relay message it receives (call
// before Serve). Handlers run between requests, with their own request pool.
func OnRelay(h func(i64, str)) {
	gRelay = h
	gRelayOn = true
}

// OnTick makes every core run h(core) every ms milliseconds (call before Serve).
func OnTick(ms i64, h func(i64)) {
	gTick = h
	gTickMs = ms
}

// ---- Router ----

// Router sends each request to the handler routed for its method and path pattern, through
// the middleware added with Use. Build it in main (or in a function a global's initializer
// calls), then Serve it, or try requests on it with Run.
type Router struct {
	routes []route
	mws    []func(Req, mut Out, func(Req, mut Out))
	mounts []mount
	nf     func(Req, mut Out)
	mna    func(Req, mut Out)
	ownNF  bool
	ownMNA bool
}

// A route as added: its method (unless all), its pattern within its router, its handler.
type route struct {
	method  str
	all     bool
	pattern str
	h       func(Req, mut Out)
}

// A router mounted at prefix.
type mount struct {
	prefix str
	sub    Router
}

// A compiled router (Serve's lives in core 0's ingot heap and every core reads it): the
// trie of every route, the endpoints, one scope per router for its 404 and 405 answers,
// and the method names by code.
type rtable struct {
	nodes   []rnode
	ends    []rend
	scopes  []rscope
	methods []str
}

// A trie node: one per distinct pattern prefix. Node 0 is the root, so 0 is also "none".
type rnode struct {
	keys  []str // static children's segments
	kids  []i64 // their nodes
	slots []i64 // when there are many keys: a hash table of key index + 1 (0: empty)
	param i64   // the {name} child
	rest  i64   // the {name...} child
	codes []i64 // the methods of the routes ending here
	eps   []i64 // their endpoints
	mask  i64   // one bit per method in codes
	all   i64   // the Any route ending here: its endpoint + 1, or 0
}

// An endpoint: the handler and middleware chain a route (or a 404 or 405 answer) runs.
type rend struct {
	h       func(Req, mut Out)
	mws     []func(Req, mut Out, func(Req, mut Out))
	pattern str   // the whole pattern; "" for a 404 or 405 answer
	names   []str // parameter names, in order
	segs    []i64 // the path segment each one reads
	rest    bool  // the last parameter reads the rest of the path
}

// A router's prefix and its 404 and 405 answers; a miss gets the deepest scope over its path.
type rscope struct {
	kinds []i64
	texts []str
	nf    i64
	mna   i64
}

// A parsed pattern: each segment's kind, and its text (the static text or the parameter name).
type ppat struct {
	kinds []i64
	texts []str
}

const segStatic = 0
const segParam = 1
const segRest = 2

const mGet = 0
const mHead = 1
const nKnown = 9      // GET HEAD POST PUT PATCH DELETE OPTIONS CONNECT TRACE: codes 0 to 8
const maxMethods = 63 // method codes are bits of a mask
const manyKeys = 8    // a node with more static children hashes them
const maxNest = 32    // how deep routers may be mounted in each other
const tchars = "!#$%&'*+-.^_`|~"

var routerGen i64 // per core: counts router changes, so Run's compiled table is never stale
var runRouter i64 // per core: the router Run and Match compiled last, its table and when
var runTable i64
var runGen i64

// NewRouter makes an empty router: every request gets 404 until routes are added.
func NewRouter() Router {
	routerGen++
	return Router{nf: not_found, mna: not_allowed, ownNF: false, ownMNA: false}
}

// Get routes GET requests for pattern to h, and HEAD requests unless Head routes them.
func (r mut Router) Get(pattern str, h func(Req, mut Out)) {
	r.Handle("GET", pattern, h)
}

// Post routes POST requests for pattern to h.
func (r mut Router) Post(pattern str, h func(Req, mut Out)) {
	r.Handle("POST", pattern, h)
}

// Put routes PUT requests for pattern to h.
func (r mut Router) Put(pattern str, h func(Req, mut Out)) {
	r.Handle("PUT", pattern, h)
}

// Patch routes PATCH requests for pattern to h.
func (r mut Router) Patch(pattern str, h func(Req, mut Out)) {
	r.Handle("PATCH", pattern, h)
}

// Delete routes DELETE requests for pattern to h.
func (r mut Router) Delete(pattern str, h func(Req, mut Out)) {
	r.Handle("DELETE", pattern, h)
}

// Head routes HEAD requests for pattern to h (without it, they go to the GET route).
func (r mut Router) Head(pattern str, h func(Req, mut Out)) {
	r.Handle("HEAD", pattern, h)
}

// Options routes OPTIONS requests for pattern to h.
func (r mut Router) Options(pattern str, h func(Req, mut Out)) {
	r.Handle("OPTIONS", pattern, h)
}

// Handle routes requests with method (any HTTP method name, like "PROPFIND") for pattern to h.
func (r mut Router) Handle(method str, pattern str, h func(Req, mut Out)) {
	routerGen++
	r.routes = append(r.routes, route{method: method, all: false, pattern: pattern, h: h})
}

// Any routes requests for pattern with every method to h; a route for the request's own
// method on the same pattern wins over it.
func (r mut Router) Any(pattern str, h func(Req, mut Out)) {
	routerGen++
	r.routes = append(r.routes, route{method: "", all: true, pattern: pattern, h: h})
}

// Use adds middleware mw to r. Middleware run in the order added, around every route of r
// and of the routers mounted in it, and around their 404 and 405 answers. Each gets next,
// the rest of the chain, and decides whether and when to call it.
func (r mut Router) Use(mw func(Req, mut Out, func(Req, mut Out))) {
	routerGen++
	r.mws = append(r.mws, mw)
}

// Route groups routes under prefix ("/api"): build adds them to a new router mounted there.
func (r mut Router) Route(prefix str, build func(mut Router)) {
	g := NewRouter()
	build(mut g)
	r.Mount(prefix, g)
}

// Mount serves sub's routes under prefix: "/api" and "/users" make "/api/users", and "/api"
// and "" make "/api". r's middleware run before sub's, and sub's 404 and 405 answers (with
// its middleware) cover the paths under prefix.
func (r mut Router) Mount(prefix str, sub Router) {
	routerGen++
	r.mounts = append(r.mounts, mount{prefix: prefix, sub: sub})
}

// NotFound sets the handler for the paths no route matches (under r's prefix when r is
// mounted); the status starts as 404.
func (r mut Router) NotFound(h func(Req, mut Out)) {
	routerGen++
	r.nf = h
	r.ownNF = true
}

// MethodNotAllowed sets the handler for the paths whose routes take other methods; the
// status starts as 405 and the Allow header lists those methods.
func (r mut Router) MethodNotAllowed(h func(Req, mut Out)) {
	routerGen++
	r.mna = h
	r.ownMNA = true
}

// Check fails with r's first bad pattern, conflicting route or misplaced mount, the error
// Serve would fail with before listening.
func (r Router) Check() ! {
	_ = try compile(r)
}

// Serve listens on addr and serves r on every core, like anvil.Serve. The routes are checked
// and compiled once, into a table every core reads; Serve fails with r's error, if any (see Check).
func (r Router) Serve(addr str) ! {
	return try r.ServeN(addr, serve_cores())
}

// ServeN is Serve on exactly n cores.
func (r Router) ServeN(addr str, n i64) ! {
	t := try compile(r)
	gRoutes = cast(i64, keep(t))
	return try serve_on(addr, n)
}

// Run sends one request through r on this thread, as Serve would (middleware, 404, 405),
// and returns the response: for tests. target is the path and query ("/users/7?full=1"),
// the request has no headers, and a HEAD response keeps its body. Run panics if r has an
// error (see Check).
func (r Router) Run(method str, target str, body str) Out {
	t := run_table(r)
	q := Req{Method: method, Path: target, Query: "", hp: 0, hn: 0, bp: cast(i64, body) + 8, bn: len(body)}
	for i := 0; i < len(target); i++ {
		if target[i] == '?' {
			q.Path = target[:i]
			q.Query = target[i+1:]
			break
		}
	}
	b := make([]u8, 0, 256)
	w := Out{Body: b, code: 200, ctype: "text/plain; charset=utf-8", extra: make([]u8, 0, 64), own: b}
	dispatch(t, mut q, mut w)
	return w
}

// Match returns the pattern of the route that would serve method and path ("/users/{id}"),
// or "" when the request would get 404 or 405. Like Run, it panics if r has an error (see Check).
func (r Router) Match(method str, path str) str {
	t := run_table(r)
	e := find(t, method, path)
	if e < 0 {
		return ""
	}
	return t.ends[e].pattern
}

// run_table is r compiled, kept while no router is changed (so repeated Run and Match calls
// do not compile it again).
func run_table(r Router) rtable {
	id := cast(i64, r)
	if runTable == 0 || runRouter != id || runGen != routerGen {
		t, err := compile(r)
		if err != nil {
			panic("{err}")
		}
		runTable = cast(i64, keep(t))
		runRouter = id
		runGen = routerGen
	}
	return cast(rtable, runTable)
}

// not_found is a router's default answer when no route matches (the status is already 404).
func not_found(q Req, w mut Out) {
	w.Text("Not Found")
}

// not_allowed is a router's default answer when the path's routes take other methods (the
// status is already 405, and Allow is set).
func not_allowed(q Req, w mut Out) {
	w.Text("Method Not Allowed")
}

// ---- Routing a request ----

// dispatch runs request q through table t: the matching route's endpoint, or the 404 or 405
// answer of the deepest router over the path, inside its middleware chain.
func dispatch(t rtable, q mut Req, w mut Out) {
	e := find(t, q.Method, q.Path)
	if e < 0 {
		e = miss(t, q.Path, mut w)
	}
	ep := cast(i64, t.ends[e])
	q.ep = ep
	w.ep = ep
	w.ci = 0
	chain_next(q, mut w)
}

// chain_next runs the rest of the request's middleware chain, then its handler: it is the
// next that every middleware gets. The position lives in the Out, so a middleware may call
// next more than once, and may wait before or after it.
func chain_next(q Req, w mut Out) {
	if w.ep == 0 {
		panic("anvil: next needs the Out its middleware was given")
	}
	e := cast(rend, w.ep)
	i := w.ci
	if i < len(e.mws) {
		mw := e.mws[i]
		w.ci = i + 1
		mw(q, mut w, chain_next)
		w.ci = i
		return
	}
	h := e.h
	h(q, mut w)
}

// find returns the endpoint for method and path in t, or -1.
func find(t rtable, method str, path str) i64 {
	n := len(path)
	p := cast(i64, path) + 8
	if n == 0 || load8(p) != '/' {
		return -1
	}
	return walk(t, 0, p, n, 1, method_code(t, method))
}

// method_code is method m's code in t, or -1 when no route takes it. The known methods have
// the codes of their place in compile's list.
func method_code(t rtable, m str) i64 {
	p := cast(i64, m) + 8
	n := len(m)
	switch load8(p) {
	case 'G':
		if bytes_are(p, n, "GET") {
			return 0
		}
	case 'H':
		if bytes_are(p, n, "HEAD") {
			return 1
		}
	case 'P':
		if bytes_are(p, n, "POST") {
			return 2
		}
		if bytes_are(p, n, "PUT") {
			return 3
		}
		if bytes_are(p, n, "PATCH") {
			return 4
		}
	case 'D':
		if bytes_are(p, n, "DELETE") {
			return 5
		}
	case 'O':
		if bytes_are(p, n, "OPTIONS") {
			return 6
		}
	case 'C':
		if bytes_are(p, n, "CONNECT") {
			return 7
		}
	case 'T':
		if bytes_are(p, n, "TRACE") {
			return 8
		}
	}
	ms := t.methods
	for i := nKnown; i < len(ms); i++ {
		if ms[i] == m {
			return i
		}
	}
	return -1
}

// walk returns the endpoint for method m and the path (n bytes at p) from offset at on,
// below node i, or -1. It tries the static child first, then the {name} child, then the
// catch-all, going back when a branch has no route for the rest of the path.
func walk(t rtable, i i64, p i64, n i64, at i64, m i64) i64 {
	nd := t.nodes[i]
	if at > n {
		return pick(nd, m)
	}
	end := at
	for end < n && load8(p+end) != '/' {
		end++
	}
	if len(nd.keys) > 0 {
		c := find_static(nd, p+at, end-at)
		if c != 0 {
			e := walk(t, c, p, n, end+1, m)
			if e >= 0 {
				return e
			}
		}
	}
	if nd.param != 0 && end > at {
		e := walk(t, nd.param, p, n, end+1, m)
		if e >= 0 {
			return e
		}
	}
	if nd.rest != 0 {
		return pick(t.nodes[nd.rest], m)
	}
	return -1
}

// pick returns node nd's endpoint for method m: its own, then GET's for HEAD, then Any's;
// or -1.
func pick(nd rnode, m i64) i64 {
	if m >= 0 && (nd.mask>>m)&1 != 0 {
		for i := 0; i < len(nd.codes); i++ {
			if nd.codes[i] == m {
				return nd.eps[i]
			}
		}
	}
	if m == mHead && nd.mask&1 != 0 {
		return pick(nd, mGet)
	}
	return nd.all - 1
}

// allowed returns the methods (a mask) of every route matching the path from offset at on,
// below node i, whatever its method.
func allowed(t rtable, i i64, p i64, n i64, at i64) i64 {
	nd := t.nodes[i]
	if at > n {
		return nd.mask
	}
	end := at
	for end < n && load8(p+end) != '/' {
		end++
	}
	mask := 0
	if len(nd.keys) > 0 {
		c := find_static(nd, p+at, end-at)
		if c != 0 {
			mask |= allowed(t, c, p, n, end+1)
		}
	}
	if nd.param != 0 && end > at {
		mask |= allowed(t, nd.param, p, n, end+1)
	}
	if nd.rest != 0 {
		mask |= t.nodes[nd.rest].mask
	}
	return mask
}

// find_static returns node nd's static child for the n bytes at p, or 0.
func find_static(nd rnode, p i64, n i64) i64 {
	if len(nd.slots) == 0 {
		for i := 0; i < len(nd.keys); i++ {
			if seg_is(nd.keys[i], p, n) {
				return nd.kids[i]
			}
		}
		return 0
	}
	m := len(nd.slots) - 1
	s := i64(hash_seg(p, n)) & m
	for {
		k := nd.slots[s]
		if k == 0 {
			return 0
		}
		if seg_is(nd.keys[k-1], p, n) {
			return nd.kids[k-1]
		}
		s = (s + 1) & m
	}
	return 0
}

// seg_is reports whether the n bytes at p are k.
func seg_is(k str, p i64, n i64) bool {
	if len(k) != n {
		return false
	}
	kp := cast(i64, k) + 8
	for i := 0; i < n; i++ {
		if load8(kp+i) != load8(p+i) {
			return false
		}
	}
	return true
}

// hash_seg is the FNV-1a hash of the n bytes at p.
func hash_seg(p i64, n i64) u64 {
	h := u64(14695981039346656037)
	for i := 0; i < n; i++ {
		h = (h ^ u64(load8(p+i))) * 1099511628211
	}
	return h
}

// miss prepares w for a request no route takes and returns the endpoint that answers it:
// 405 with Allow when routes take the path with other methods, else 404, from the deepest
// router (scope) whose prefix starts the path.
func miss(t rtable, path str, w mut Out) i64 {
	n := len(path)
	p := cast(i64, path) + 8
	mask := 0
	s := t.scopes[0]
	if n > 0 && load8(p) == '/' {
		mask = allowed(t, 0, p, n, 1)
		for i := 1; i < len(t.scopes); i++ {
			c := t.scopes[i]
			if scope_over(c, p, n) && scope_wins(c, s) {
				s = c
			}
		}
	}
	if mask == 0 {
		w.code = 404
		return s.nf
	}
	w.code = 405
	w.Head("Allow", allow_list(t, mask))
	return s.mna
}

// scope_over reports whether scope s's prefix starts the path (n bytes at p).
func scope_over(s rscope, p i64, n i64) bool {
	at := 1
	for k := 0; k < len(s.kinds); k++ {
		if at > n {
			return false
		}
		end := at
		for end < n && load8(p+end) != '/' {
			end++
		}
		if s.kinds[k] == segStatic {
			if !seg_is(s.texts[k], p+at, end-at) {
				return false
			}
		} else if end == at {
			return false
		}
		at = end + 1
	}
	return true
}

// scope_wins reports whether scope a answers before b for a path both start: the deeper
// one, or else the one with a static segment where the other has a parameter.
func scope_wins(a rscope, b rscope) bool {
	if len(a.kinds) != len(b.kinds) {
		return len(a.kinds) > len(b.kinds)
	}
	for k := 0; k < len(a.kinds); k++ {
		if a.kinds[k] != b.kinds[k] {
			return a.kinds[k] < b.kinds[k]
		}
	}
	return false
}

// allow_list is the Allow header for the methods in mask: their names in order, with HEAD
// wherever GET is.
func allow_list(t rtable, mask i64) str {
	if mask&1 != 0 {
		mask |= 1 << mHead
	}
	names := make([]str, 0, 8)
	for c := 0; c < len(t.methods); c++ {
		if (mask>>c)&1 != 0 {
			names = append(names, t.methods[c])
		}
	}
	for i := 1; i < len(names); i++ {
		for j := i; j > 0 && names[j] < names[j-1]; j-- {
			x := names[j]
			names[j] = names[j-1]
			names[j-1] = x
		}
	}
	b := make([]u8, 0, 64)
	for i, s := range names {
		if i > 0 {
			b = append(b, ", "...)
		}
		b = append(b, s...)
	}
	return str(b)
}

// seg_span returns where path segment k starts and ends (segment 0 follows the first /).
func seg_span(path str, k i64) (i64, i64) {
	n := len(path)
	at := 1
	for j := 0; j < k && at <= n; j++ {
		for at < n && path[at] != '/' {
			at++
		}
		at++
	}
	if at > n {
		return n, n
	}
	end := at
	for end < n && path[end] != '/' {
		end++
	}
	return at, end
}

// path_unescape is s[a:b] with its %XX escapes decoded ('+' stays itself in a path).
func path_unescape(s str, a i64, b i64) str {
	esc := false
	for i := a; i < b; i++ {
		if s[i] == '%' {
			esc = true
			break
		}
	}
	if !esc {
		return s[a:b]
	}
	out := make([]u8, 0, b-a)
	for i := a; i < b; i++ {
		c := s[i]
		if c == '%' && i+2 < b && hexval(s[i+1]) >= 0 && hexval(s[i+2]) >= 0 {
			out = append(out, u8(hexval(s[i+1])*16+hexval(s[i+2])))
			i += 2
		} else {
			out = append(out, c)
		}
	}
	return str(out)
}

// ---- Compiling a router ----

// compile checks router r and builds its table: every route (mounted routers' too, under
// their prefixes) in one trie, an endpoint per route with its middleware chain, and a scope
// per router for its 404 and 405 answers.
func compile(r Router) !rtable {
	t := rtable{}
	t.nodes = append(t.nodes, rnode{})
	t.methods = append(t.methods, "GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "CONNECT", "TRACE")
	seen := make([]i64, maxNest)
	none := make([]func(Req, mut Out, func(Req, mut Out)), 0)
	try add_router(mut t, r, "", none, not_found, not_allowed, mut seen, 0)
	for _, nd := range t.nodes {
		index_keys(mut nd)
	}
	return t
}

// add_router adds router r, mounted at prefix: its scope, then its routes and mounts, with
// the middleware of the routers around it (outer) before its own. nf and mna answer misses
// unless r has its own. seen[:depth] are the routers r is mounted in.
func add_router(t mut rtable, r Router, prefix str, outer []func(Req, mut Out, func(Req, mut Out)), nf func(Req, mut Out), mna func(Req, mut Out), seen mut []i64, depth i64) ! {
	id := cast(i64, r)
	for i := 0; i < depth; i++ {
		if seen[i] == id {
			fail "anvil: mount {prefix}: the router is mounted inside itself"
		}
	}
	if depth == len(seen) {
		fail "anvil: mount {prefix}: routers are mounted more than {maxNest} deep"
	}
	seen[depth] = id
	chain := make([]func(Req, mut Out, func(Req, mut Out)), 0, len(outer)+len(r.mws))
	for _, m := range outer {
		chain = append(chain, m)
	}
	for _, m := range r.mws {
		chain = append(chain, m)
	}
	if r.ownNF {
		nf = r.nf
	}
	if r.ownMNA {
		mna = r.mna
	}
	sp := ppat{}
	if prefix != "" {
		pp := parse_pattern(prefix, true) catch err {
			fail "anvil: mount {prefix}: {err}"
		}
		sp = pp
	}
	for _, s := range t.scopes {
		if same_shape(s.kinds, s.texts, sp.kinds, sp.texts) {
			fail "anvil: mount {prefix}: another router is mounted at the same prefix"
		}
	}
	t.scopes = append(t.scopes, rscope{kinds: sp.kinds, texts: sp.texts, nf: len(t.ends), mna: len(t.ends) + 1})
	t.ends = append(t.ends, endpoint(nf, chain, "", sp), endpoint(mna, chain, "", sp))
	for _, rt := range r.routes {
		try add_route(mut t, rt, prefix, chain)
	}
	for _, m := range r.mounts {
		if len(m.prefix) < 2 || m.prefix[0] != '/' || m.prefix[len(m.prefix)-1] == '/' {
			fail "anvil: mount {m.prefix}: a prefix starts with / and does not end with one, like /api"
		}
		try add_router(mut t, m.sub, prefix+m.prefix, chain, nf, mna, mut seen, depth+1)
	}
}

// add_route puts route rt, of a router mounted at prefix, into the trie with the given chain.
func add_route(t mut rtable, rt route, prefix str, chain []func(Req, mut Out, func(Req, mut Out))) ! {
	full := prefix + rt.pattern
	what := rt.method
	if rt.all {
		what = "Any"
	} else if !is_token(rt.method) {
		fail "anvil: route {full}: bad method \"{rt.method}\""
	}
	if full == "" || (rt.pattern != "" && rt.pattern[0] != '/') {
		where := ""
		if prefix != "" {
			where = " (mounted at {prefix})"
		}
		fail "anvil: route {what} \"{rt.pattern}\"{where}: a pattern starts with /, like /users/{{id}}"
	}
	pp := parse_pattern(full, false) catch err {
		fail "anvil: route {what} {full}: {err}"
	}
	n := 0
	for k := 0; k < len(pp.kinds); k++ {
		n = child(mut t, n, pp.kinds[k], pp.texts[k])
	}
	nd := t.nodes[n]
	e := len(t.ends)
	if rt.all {
		if nd.all != 0 {
			first := t.ends[nd.all-1].pattern
			fail "anvil: route {what} {full} conflicts with {first}: they match the same requests"
		}
		nd.all = e + 1
	} else {
		m := add_method(mut t, rt.method) catch err {
			fail "anvil: route {what} {full}: {err}"
		}
		for i := 0; i < len(nd.codes); i++ {
			if nd.codes[i] == m {
				first := t.ends[nd.eps[i]].pattern
				fail "anvil: route {what} {full} conflicts with {first}: they match the same requests"
			}
		}
		nd.codes = append(nd.codes, m)
		nd.eps = append(nd.eps, e)
		nd.mask |= 1 << m
	}
	t.ends = append(t.ends, endpoint(rt.h, chain, full, pp))
}

// add_method returns method m's code in t, giving a method no route used before the next one.
func add_method(t mut rtable, m str) !i64 {
	for i := 0; i < len(t.methods); i++ {
		if t.methods[i] == m {
			return i
		}
	}
	if len(t.methods) == maxMethods {
		fail "more than {maxMethods} methods"
	}
	t.methods = append(t.methods, m)
	return len(t.methods) - 1
}

// is_token reports whether m is an HTTP token, as a method name must be.
func is_token(m str) bool {
	if len(m) == 0 {
		return false
	}
	for i := 0; i < len(m); i++ {
		c := m[i]
		ok := (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')
		for j := 0; !ok && j < len(tchars); j++ {
			ok = tchars[j] == c
		}
		if !ok {
			return false
		}
	}
	return true
}

// child returns node n's child for a segment of kind and text, made if new.
func child(t mut rtable, n i64, kind i64, text str) i64 {
	nd := t.nodes[n]
	if kind == segStatic {
		for i := 0; i < len(nd.keys); i++ {
			if nd.keys[i] == text {
				return nd.kids[i]
			}
		}
		c := len(t.nodes)
		t.nodes = append(t.nodes, rnode{})
		nd.keys = append(nd.keys, text)
		nd.kids = append(nd.kids, c)
		return c
	}
	if kind == segParam {
		if nd.param == 0 {
			nd.param = len(t.nodes)
			t.nodes = append(t.nodes, rnode{})
		}
		return nd.param
	}
	if nd.rest == 0 {
		nd.rest = len(t.nodes)
		t.nodes = append(t.nodes, rnode{})
	}
	return nd.rest
}

// index_keys gives a node with many static children a hash table over their segments.
func index_keys(nd mut rnode) {
	if len(nd.keys) <= manyKeys {
		return
	}
	size := 16
	for size < 2*len(nd.keys) {
		size *= 2
	}
	nd.slots = make([]i64, size)
	for i, k := range nd.keys {
		s := i64(hash_seg(cast(i64, k)+8, len(k))) & (size - 1)
		for nd.slots[s] != 0 {
			s = (s + 1) & (size - 1)
		}
		nd.slots[s] = i + 1
	}
}

// endpoint makes the endpoint for handler h with middleware chain, for parsed pattern pp.
func endpoint(h func(Req, mut Out), chain []func(Req, mut Out, func(Req, mut Out)), pattern str, pp ppat) rend {
	e := rend{h: h, mws: chain, pattern: pattern, rest: false}
	for k := 0; k < len(pp.kinds); k++ {
		if pp.kinds[k] != segStatic {
			e.names = append(e.names, pp.texts[k])
			e.segs = append(e.segs, k)
			e.rest = pp.kinds[k] == segRest
		}
	}
	return e
}

// same_shape reports whether two parsed patterns match the same paths: the same static
// segments, and parameters in the same places.
func same_shape(ak []i64, at []str, bk []i64, bt []str) bool {
	if len(ak) != len(bk) {
		return false
	}
	for k := 0; k < len(ak); k++ {
		if ak[k] != bk[k] || (ak[k] == segStatic && at[k] != bt[k]) {
			return false
		}
	}
	return true
}

// parse_pattern splits pattern p ("/users/{id}") into its segments. A static segment may not
// hold a brace, a catch-all must come last, and a prefix (a mount's) may not have one.
func parse_pattern(p str, prefix bool) !ppat {
	pp := ppat{}
	if len(p) == 0 || p[0] != '/' {
		fail "a pattern starts with /"
	}
	at := 1
	for {
		end := at
		for end < len(p) && p[end] != '/' {
			end++
		}
		seg := p[at:end]
		kind := segStatic
		text := seg
		if seg == "*" {
			kind = segRest
		} else if len(seg) >= 2 && seg[0] == '{' && seg[len(seg)-1] == '}' {
			kind = segParam
			text = seg[1 : len(seg)-1]
			if len(text) > 3 && text[len(text)-3:] == "..." {
				kind = segRest
				text = text[:len(text)-3]
			}
			if !is_name(text) {
				fail "bad parameter {seg}: a name is letters, digits and _"
			}
			for k := 0; k < len(pp.kinds); k++ {
				if pp.kinds[k] != segStatic && pp.texts[k] == text {
					fail "parameter {text} appears twice"
				}
			}
		} else {
			for i := 0; i < len(seg); i++ {
				if seg[i] == '{' || seg[i] == '}' {
					fail "a parameter is a whole segment, like /{{id}}"
				}
			}
		}
		if kind == segRest && prefix {
			fail "a prefix cannot end in a catch-all"
		}
		if kind == segRest && end < len(p) {
			fail "a catch-all ({{name...}} or *) must be the last segment"
		}
		pp.kinds = append(pp.kinds, kind)
		pp.texts = append(pp.texts, text)
		if end >= len(p) {
			break
		}
		at = end + 1
	}
	return pp
}

// is_name reports whether s is a parameter name: letters, digits and _, at least one.
func is_name(s str) bool {
	if len(s) == 0 {
		return false
	}
	for i := 0; i < len(s); i++ {
		c := s[i]
		if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_') {
			return false
		}
	}
	return true
}
