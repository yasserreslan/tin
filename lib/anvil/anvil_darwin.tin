// anvil's event loop on macOS: kqueue (connections edge-triggered with EV_CLEAR).
package anvil

extern fn kqueue() i64
extern fn kevent(kq i64, ch i64, nch i64, ev i64, nev i64, ts i64) i64

const evSize = 32
const tickIdent = 1099511627776
const drainIdent = 1099511627777

// Each core accepts on its own listener (true) or core 0 deals connections (false):
// macOS's SO_REUSEPORT does not balance, so core 0 deals.
const ownListener = false

fn kadd(fd i64, filter i64, flags i64) {
	change[0] = fd
	change[1] = (filter & 0xffff) | (flags << 16)
	change[2] = 0
	change[3] = 0
	kevent(kq, change, 1, 0, 0, 0)
}

mut waitTs i64 // per core: the timespec ev_wait passes kevent

fn ev_init() {
	kq = c32(kqueue())
	waitTs = malloc(16)
}

// ev_level watches fd for reading, level-triggered (listeners, pipes, wakers).
fn ev_level(fd i64) {
	kadd(fd, -1, 1)
}

// ev_conn watches a new connection for reading, edge-triggered.
fn ev_conn(fd i64) {
	kadd(fd, -1, 0x21)
}

// ev_conn_write waits for room to write and stops reading (backpressure).
fn ev_conn_write(fd i64) {
	kadd(fd, -2, 0x21)
	kadd(fd, -1, 8)
}

// ev_conn_rw waits for room to write and keeps reading (HTTP/2, h2_flush).
fn ev_conn_rw(fd i64) {
	kadd(fd, -2, 0x21)
}

// ev_conn_read goes back to reading once the output is written.
fn ev_conn_read(fd i64) {
	kadd(fd, -2, 2)
	kadd(fd, -1, 4)
}

// ev_timer fires every ms milliseconds; it returns the ident its events carry.
fn ev_timer(ms i64) i64 {
	change[0] = tickIdent
	change[1] = (-7 & 0xffff) | (1 << 16)
	change[2] = ms
	change[3] = 0
	kevent(kq, change, 1, 0, 0, 0)
	return tickIdent
}

fn ev_timer_ack(id i64) {
}

// ev_drain_timer is a second periodic timer (the shutdown deadline check); it returns its ident.
fn ev_drain_timer(ms i64) i64 {
	change[0] = drainIdent
	change[1] = (-7 & 0xffff) | (1 << 16)
	change[2] = ms
	change[3] = 0
	kevent(kq, change, 1, 0, 0, 0)
	return drainIdent
}

// ev_signals makes SIGTERM and SIGINT (blocked in every thread) events of this core's kqueue:
// EVFILT_SIGNAL records each delivery attempt even for a blocked signal.
fn ev_signals() {
	kadd(15, -6, 1)
	kadd(2, -6, 1)
}

// ev_signal reports whether event i is a signal (its ident is the signal number, not an fd).
fn ev_signal(i i64) bool {
	return i64(i16((evs + i*evSize)[1])) == -6
}

fn ev_signal_ack() {
}

// ev_wait waits for events, at most ms milliseconds (-1: no limit).
fn ev_wait(ms i64) i64 {
	if ms < 0 {
		return c32(kevent(kq, 0, 0, evs, maxEvents, 0))
	}
	waitTs[0] = ms / 1000
	waitTs[1] = (ms % 1000) * 1000000
	return c32(kevent(kq, 0, 0, evs, maxEvents, waitTs))
}

fn ev_fd(i i64) i64 {
	return (evs + i*evSize)[0]
}

// ev_hangup reports EV_EOF: the peer closed (it may arrive with the last data).
fn ev_hangup(i i64) bool {
	return ((evs+i*evSize)[1]>>16)&0x8000 != 0
}

// ev_writable reports a write-ready event (else it is readable, a timer or EOF).
fn ev_writable(i i64) bool {
	return i64(i16((evs + i*evSize)[1])) == -2
}

// ev_out reports a write-ready event, with or without input (kqueue reports them apart).
fn ev_out(i i64) bool {
	return ev_writable(i)
}

// ev_task_add watches fd once for a waiting request task: want 1 readable, 2 writable.
fn ev_task_add(fd i64, want i64) {
	if want == 1 {
		kadd(fd, -1, 0x11)
	} else {
		kadd(fd, -2, 0x11)
	}
}

// ev_task_del stops watching fd for a task (a one-shot event that fired is gone already).
fn ev_task_del(fd i64) {
	kadd(fd, -1, 2)
	kadd(fd, -2, 2)
}

// os_sendfile sends up to n bytes of file descriptor file, from offset off, to the socket sock
// (#350): the bytes sent, or minus the errno (EAGAIN when the socket would block). It runs on a
// helper thread, where a read from disk may block.
extern fn sendfile(file i64, sock i64, off i64, len i64, hdtr i64, flags i64) i64

fn os_sendfile(sock i64, file i64, off i64, n i64) i64 {
	let lp = calloc(1, 8)
	lp[0] = n
	let r = sendfile(file, sock, off, lp, 0, 0)
	let sent = lp[0]
	let e = errno()
	free(lp)
	if r == 0 {
		return sent
	}
	if e == EAGAIN && sent > 0 {
		return sent
	}
	return -e
}

// os_pread reads up to n bytes of file descriptor fd from offset off into p (SendFile over TLS,
// which must seal the bytes): the bytes read, or minus the errno. It runs on a helper thread.
extern fn pread(fd i64, p i64, n i64, off i64) i64

fn os_pread(fd i64, p i64, n i64, off i64) i64 {
	let r = pread(fd, p, n, off)
	if r < 0 {
		return -errno()
	}
	return r
}
