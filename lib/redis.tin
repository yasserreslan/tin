// Package redis is a Redis client. Commands are queries: in c.Do("SET user:{id} {body}")
// the values travel as separate arguments, so a value can never change a command.
//
// Each core keeps one connection per Client. The requests a core serves at the same time
// share it: their commands are written together and the replies matched in order
// (pipelining), so a busy server makes few system calls per command. Inside a request
// task a call waits without blocking the core; outside one it blocks.
//
//	var cache = redis.Open(redis.Options{Addr: "127.0.0.1:6379"})
//	try cache.Set("greeting", "hello")
//	v, found := try cache.Get("greeting")
//
// Blocking commands (BLPOP, SUBSCRIBE, ...) would hold up the commands queued behind them
// and are not supported.
package redis

import "mint"
import "say"
import "wire"

extern func close(fd i64) i64
extern func strerror(e i64) i64
extern func recv(fd i64, buf i64, n i64, flags i64) i64

// Reply is one Redis reply.
type Reply enum {
	Str(v str)           // a simple, bulk or verbatim string, or a big number's digits
	Int(v i64)
	Float(v f64)         // a RESP3 double
	Bool(v bool)         // a RESP3 boolean
	Array(items []Reply) // an array, a set or a push
	Map(pairs []Reply)   // a RESP3 map: key, value, key, value, ...
	Err(msg str)         // an error inside an array or a Pipe (a lone error fails the call)
	Nil
}

// Options says where and how to connect.
type Options struct {
	Addr     str // "host:port" (default "127.0.0.1:6379")
	Username str // sent with AUTH when set (Redis 6 ACLs)
	Password str // sent with AUTH when set
	DB       i64 // selected when not 0
	Proto    i64 // 3 sends HELLO 3 and speaks RESP3; otherwise RESP2
	Timeout  i64 // ns a command may wait (0: no limit; a request's deadline still applies)
}

// Client sends commands to one Redis server. Open it in a global's initializer (which
// runs on every core) or once in main, not per request.
type Client struct {
	open bool // false for the zero Client (a failed Open)
	rec  i64
}

const maxClients = 1024

// The shared record of a Client: its options, copied out of any pool.
const rAddr = 0
const rAddrN = 1
const rUser = 2
const rUserN = 3
const rPass = 4
const rPassN = 5
const rDB = 6
const rProto = 7
const rTimeout = 8
const rID = 9
const recWords = 10

// A core's connection for one Client.
const lFd = 0
const lOut = 1    // commands not yet written
const lOutN = 2
const lOutCap = 3
const lWpos = 4   // how much of lOut is written
const lIn = 5     // bytes read, from lInS to lInE not yet delivered
const lInS = 6
const lInE = 7
const lInCap = 8
const lQ = 9      // the slots waiting for replies, in order
const lQHead = 10
const lQN = 11
const lQCap = 12
const lBusy = 13  // a task is doing the connection's I/O
const lineWords = 14

// A slot: one caller's commands and the replies they get.
const sTask = 0
const sState = 1  // 0 waiting, 1 done, 2 failed
const sGone = 2   // the caller gave up; free the slot when its replies arrive
const sOwner = 3  // the caller must take over the connection's I/O
const sMsg = 4    // the replies, as received
const sMsgN = 5
const sMsgCap = 6
const sWant = 7   // how many replies
const sGot = 8
const sErr = 9    // why it failed
const sErrN = 10
const sHello = 11 // the connection's handshake: check it, then drop it
const slotWords = 12

shared var nClients i64
var lines i64 // per core: the connection of each Client, by id

func keep_raw(s str) i64 {
	p := malloc(len(s) + 1)
	memcpy(p, cast(i64, s)+8, len(s))
	return p
}

// Open makes a client for the server in o. It connects on first use, on each core.
func Open(o Options) Client {
	addr := o.Addr
	if addr == "" {
		addr = "127.0.0.1:6379"
	}
	id := __atomic_add(&nClients, 1)
	if id >= maxClients {
		return Client{open: false, rec: 0}
	}
	rec := calloc(recWords, 8)
	rec[rAddr] = keep_raw(addr)
	rec[rAddrN] = len(addr)
	rec[rUser] = keep_raw(o.Username)
	rec[rUserN] = len(o.Username)
	rec[rPass] = keep_raw(o.Password)
	rec[rPassN] = len(o.Password)
	rec[rDB] = o.DB
	rec[rProto] = o.Proto
	rec[rTimeout] = o.Timeout
	rec[rID] = id
	return Client{open: true, rec: rec}
}

func (c Client) line() i64 {
	if lines == 0 {
		lines = calloc(maxClients+1, 8)
	}
	id := c.rec[rID]
	l := lines[id]
	if l == 0 {
		l = calloc(lineWords, 8)
		l[lFd] = -1
		lines[id] = l
	}
	return l
}

// ---- commands ----

func is_space(c u8) bool {
	return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

func arg_text(a qarg) str {
	switch a {
	case Int(v):
		return mint.Itoa(v)
	case Float(v):
		return mint.FormatFloat(v, 'g', -1)
	case Str(v):
		return v
	case Bool(v):
		if v {
			return "1"
		}
		return "0"
	case Bytes(v):
		return str(v)
	}
}

// words splits a query into a command's arguments: the text at spaces, while a value is
// always one argument (with the text right next to it: "user:{id}" is one).
func words(q query) []str {
	out := []str{}
	cur := ""
	have := false
	for i, part := range q.Parts {
		j := 0
		for j < len(part) {
			if is_space(part[j]) {
				if have {
					out = append(out, cur)
					cur = ""
					have = false
				}
				j++
				continue
			}
			k := j
			for k < len(part) && !is_space(part[k]) {
				k++
			}
			cur = cur + part[j:k]
			have = true
			j = k
		}
		if i < len(q.Args) {
			cur = cur + arg_text(q.Args[i])
			have = true
		}
	}
	if have {
		out = append(out, cur)
	}
	return out
}

func digits(v i64) i64 {
	n := 1
	for v >= 10 {
		v /= 10
		n++
	}
	return n
}

func put_int(p i64, v i64) i64 {
	n := digits(v)
	for i := n - 1; i >= 0; i-- {
		store8(p+i, '0'+v%10)
		v /= 10
	}
	return p + n
}

func out_reserve(l i64, n i64) i64 {
	if l[lOutN]+n > l[lOutCap] {
		c := l[lOutCap]*2 + n + 4096
		l[lOut] = realloc(l[lOut], c)
		l[lOutCap] = c
	}
	p := l[lOut] + l[lOutN]
	l[lOutN] += n
	return p
}

// encode appends args as one RESP command to the connection's output.
func encode(l i64, args []str) {
	n := 3 + digits(len(args))
	for _, a := range args {
		n += 5 + digits(len(a)) + len(a)
	}
	p := out_reserve(l, n)
	store8(p, '*')
	p = put_int(p+1, len(args))
	store8(p, '\r')
	store8(p+1, '\n')
	p += 2
	for _, a := range args {
		store8(p, '$')
		p = put_int(p+1, len(a))
		store8(p, '\r')
		store8(p+1, '\n')
		memcpy(p+2, cast(i64, a)+8, len(a))
		p += 2 + len(a)
		store8(p, '\r')
		store8(p+1, '\n')
		p += 2
	}
}

// ---- the queue of slots ----

func new_slot(want i64) i64 {
	s := calloc(slotWords, 8)
	s[sTask] = rt_task_current()
	s[sWant] = want
	return s
}

func free_slot(s i64) {
	if s[sMsg] != 0 {
		free(s[sMsg])
	}
	if s[sErr] != 0 {
		free(s[sErr])
	}
	free(s)
}

func q_grow(l i64) {
	if l[lQHead]+l[lQN] < l[lQCap] {
		return
	}
	q := l[lQ]
	if l[lQHead] > 0 {
		memmove(q, q+8*l[lQHead], 8*l[lQN])
		l[lQHead] = 0
		return
	}
	c := l[lQCap]*2 + 32
	l[lQ] = realloc(q, 8*c)
	l[lQCap] = c
}

func q_push(l i64, s i64) {
	q_grow(l)
	q := l[lQ]
	q[l[lQHead]+l[lQN]] = s
	l[lQN]++
}

func q_push_front(l i64, s i64) {
	if l[lQHead] == 0 {
		q_grow(l)
		q := l[lQ]
		memmove(q+8, q, 8*l[lQN])
		l[lQHead] = 1
	}
	l[lQHead]--
	q := l[lQ]
	q[l[lQHead]] = s
	l[lQN]++
}

func q_at(l i64, i i64) i64 {
	q := l[lQ]
	return q[l[lQHead]+i]
}

func q_pop(l i64) i64 {
	s := q_at(l, 0)
	l[lQHead]++
	l[lQN]--
	if l[lQN] == 0 {
		l[lQHead] = 0
	}
	return s
}

func wake(s i64) {
	t := s[sTask]
	if t != 0 && t != rt_task_current() {
		rt_task_wake(t)
	}
}

func set_err(s i64, msg str) {
	s[sErr] = keep_raw(msg)
	s[sErrN] = len(msg)
}

// fail_line closes the connection and fails every caller waiting on it.
func fail_line(l i64, msg str) {
	if l[lFd] >= 0 {
		close(l[lFd])
		l[lFd] = -1
	}
	for l[lQN] > 0 {
		s := q_pop(l)
		if s[sGone] != 0 || s[sHello] != 0 {
			free_slot(s)
			continue
		}
		set_err(s, msg)
		s[sState] = 2
		wake(s)
	}
	l[lOutN] = 0
	l[lWpos] = 0
	l[lInS] = 0
	l[lInE] = 0
}

func os_msg(what str, e i64) str {
	m := strerror(e)
	return "redis: {what}: {rt_str_from_raw(m, strlen(m))}"
}

// hand_off gives the connection's I/O to the first caller still waiting, if any.
func hand_off(l i64) {
	l[lBusy] = 0
	for i := 0; i < l[lQN]; i++ {
		s := q_at(l, i)
		if s[sGone] == 0 && s[sHello] == 0 && s[sTask] != 0 && s[sTask] != rt_task_current() {
			s[sOwner] = 1
			l[lBusy] = 1
			rt_task_wake(s[sTask])
			return
		}
	}
}

// ---- replies ----

func line_end(p i64, at i64) i64 {
	for load8(p+at) != '\r' {
		at++
	}
	return at
}

func raw_int(p i64, from i64, to i64) i64 {
	neg := false
	if from < to && load8(p+from) == '-' {
		neg = true
		from++
	}
	v := 0
	for from < to {
		v = v*10 + i64(load8(p+from)) - '0'
		from++
	}
	if neg {
		return -v
	}
	return v
}

// resp_len is the length of the first complete reply in the n bytes at p: -1 while it
// is incomplete, -2 when the bytes are not RESP.
func resp_len(p i64, n i64) i64 {
	need := 1
	at := 0
	for need > 0 {
		if at >= n {
			return -1
		}
		t := load8(p + at)
		e := at + 1
		for e+1 < n && load8(p+e) != '\r' {
			e++
		}
		if e+1 >= n {
			return -1
		}
		if load8(p+e+1) != '\n' {
			return -2
		}
		v := raw_int(p, at+1, e)
		at = e + 2
		need--
		if t == '$' || t == '=' || t == '!' {
			if v >= 0 {
				at += v + 2
				if at > n {
					return -1
				}
			}
		} else if t == '*' || t == '~' || t == '>' {
			if v > 0 {
				need += v
			}
		} else if t == '%' {
			if v > 0 {
				need += 2 * v
			}
		} else if t == '|' {
			need += 2*v + 1
		} else if t != '+' && t != '-' && t != ':' && t != '_' && t != ',' && t != '#' && t != '(' {
			return -2
		}
	}
	return at
}

func reply_items(p i64, at i64, n i64) ([]Reply, i64) {
	items := make([]Reply, 0, n)
	for i := 0; i < n; i++ {
		r, next := reply_at(p, at)
		items = append(items, r)
		at = next
	}
	return items, at
}

// reply_at reads the complete reply at p+at; it returns the reply and where the next starts.
func reply_at(p i64, at i64) (Reply, i64) {
	t := load8(p + at)
	e := line_end(p, at+1)
	line := rt_str_from_raw(p+at+1, e-at-1)
	next := e + 2
	if t == '+' || t == '(' {
		return Reply.Str(line), next
	}
	if t == '-' {
		return Reply.Err(line), next
	}
	if t == ':' {
		return Reply.Int(raw_int(p, at+1, e)), next
	}
	if t == '_' {
		return Reply.Nil, next
	}
	if t == '#' {
		return Reply.Bool(line == "t"), next
	}
	if t == ',' {
		f := mint.ParseFloat(line) catch _ { 0.0 }
		if line == "inf" {
			f = 1.0e308 * 10.0
		} else if line == "-inf" {
			f = -1.0e308 * 10.0
		}
		return Reply.Float(f), next
	}
	n := raw_int(p, at+1, e)
	if t == '$' || t == '=' || t == '!' {
		if n < 0 {
			return Reply.Nil, next
		}
		s := rt_str_from_raw(p+next, n)
		if t == '=' && n >= 4 {
			s = s[4:]
		}
		if t == '!' {
			return Reply.Err(s), next + n + 2
		}
		return Reply.Str(s), next + n + 2
	}
	if n < 0 {
		return Reply.Nil, next
	}
	if t == '%' {
		pairs, after := reply_items(p, next, 2*n)
		return Reply.Map(pairs), after
	}
	if t == '|' {
		_, after := reply_items(p, next, 2*n)
		return reply_at(p, after)
	}
	items, after := reply_items(p, next, n)
	return Reply.Array(items), after
}

// deliver hands each complete reply to the slot at the front of the queue.
func deliver(l i64) {
	for l[lQN] > 0 {
		p := l[lIn] + l[lInS]
		n := resp_len(p, l[lInE]-l[lInS])
		if n == -1 {
			break
		}
		if n < 0 {
			fail_line(l, "redis: the server sent something that is not RESP")
			return
		}
		s := q_at(l, 0)
		if s[sMsgN]+n > s[sMsgCap] {
			c := s[sMsgCap]*2 + n
			s[sMsg] = realloc(s[sMsg], c)
			s[sMsgCap] = c
		}
		memcpy(s[sMsg]+s[sMsgN], p, n)
		s[sMsgN] += n
		l[lInS] += n
		s[sGot]++
		if s[sGot] < s[sWant] {
			continue
		}
		q_pop(l)
		if s[sHello] != 0 {
			bad := hello_error(s)
			free_slot(s)
			if bad != "" {
				fail_line(l, "redis: connecting: {bad}")
				return
			}
		} else if s[sGone] != 0 {
			free_slot(s)
		} else {
			s[sState] = 1
			wake(s)
		}
	}
	if l[lInS] == l[lInE] {
		l[lInS] = 0
		l[lInE] = 0
	}
}

func hello_error(s i64) str {
	at := 0
	for at < s[sMsgN] {
		r, next := reply_at(s[sMsg], at)
		switch r {
		case Err(m):
			return m
		default:
		}
		at = next
	}
	return ""
}

// ---- the connection ----

// connect dials and queues the handshake (HELLO or AUTH, then SELECT) ahead of everything.
func connect(l i64, rec i64) ! {
	addr := rt_str_from_raw(rec[rAddr], rec[rAddrN])
	conn := try wire.DialTimeout(addr, rec[rTimeout])
	l[lFd] = conn.Fd()
	user := rt_str_from_raw(rec[rUser], rec[rUserN])
	pass := rt_str_from_raw(rec[rPass], rec[rPassN])
	cmds := [][]str{}
	if rec[rProto] == 3 {
		hello := []str{"HELLO", "3"}
		if pass != "" {
			if user == "" {
				user = "default"
			}
			hello = append(hello, "AUTH", user, pass)
		}
		cmds = append(cmds, hello)
	} else if pass != "" {
		if user != "" {
			cmds = append(cmds, []str{"AUTH", user, pass})
		} else {
			cmds = append(cmds, []str{"AUTH", pass})
		}
	}
	if rec[rDB] != 0 {
		cmds = append(cmds, []str{"SELECT", mint.Itoa(rec[rDB])})
	}
	if len(cmds) == 0 {
		return
	}
	// The queued commands move behind the handshake.
	queued := l[lOutN]
	for _, c := range cmds {
		encode(l, c)
	}
	n := l[lOutN] - queued
	if queued > 0 {
		tmp := malloc(n)
		memcpy(tmp, l[lOut]+queued, n)
		memmove(l[lOut]+n, l[lOut], queued)
		memcpy(l[lOut], tmp, n)
		free(tmp)
	}
	s := new_slot(len(cmds))
	s[sHello] = 1
	q_push_front(l, s)
}

// give_up ends a wait that ran out of time: the slot stays queued for its replies.
func give_up(l i64, s i64, r i64) ! {
	s[sGone] = 1
	if s[sOwner] != 0 || l[lBusy] == 0 {
		hand_off(l)
	}
	if r == waitDeadline {
		fail "deadline exceeded"
	}
	fail "redis: timed out"
}

// drive does the connection's I/O until s has its replies: writes what is queued, reads,
// and hands replies to their slots. Then it passes the I/O on to a caller still waiting.
func drive(l i64, s i64, rec i64) ! {
	if l[lFd] >= 0 && l[lQN] == 1 && l[lOutN] > 0 && l[lWpos] == 0 && l[lInE] == 0 {
		// An idle connection the server may have closed (a restart, an idle timeout): find
		// out before sending, so the command goes on a new connection instead of failing.
		b := calloc(1, 8)
		k := recv(l[lFd], b, 1, 2)
		free(b)
		if k == 0 || (k < 0 && rt_errno() != EAGAIN && rt_errno() != EINTR) {
			close(l[lFd])
			l[lFd] = -1
		}
	}
	if l[lFd] < 0 {
		err := connect(l, rec)
		if err != nil {
			fail_line(l, say.Str(err))
			hand_off(l)
			return
		}
	}
	// Let the core run the other requests of this turn first: their commands go out with ours.
	rt_task_defer()
	timeout := rec[rTimeout]
	for s[sState] == 0 {
		fd := l[lFd]
		if l[lWpos] < l[lOutN] {
			k := write(fd, l[lOut]+l[lWpos], l[lOutN]-l[lWpos])
			if k > 0 {
				l[lWpos] += k
				if l[lWpos] == l[lOutN] {
					l[lWpos] = 0
					l[lOutN] = 0
				}
				continue
			}
			e := rt_errno()
			if e == EINTR {
				continue
			}
			if e == EAGAIN {
				r := rt_task_wait(fd, 2, timeout)
				if r != waitReady {
					fail give_up(l, s, r)
				}
				continue
			}
			fail_line(l, os_msg("write", e))
			break
		}
		deliver(l)
		if s[sState] != 0 || l[lOutN] > 0 {
			continue
		}
		if l[lInE] == l[lInCap] {
			c := l[lInCap]*2 + 16384
			l[lIn] = realloc(l[lIn], c)
			l[lInCap] = c
		}
		k := read(fd, l[lIn]+l[lInE], l[lInCap]-l[lInE])
		if k > 0 {
			l[lInE] += k
			continue
		}
		if k == 0 {
			fail_line(l, "redis: the server closed the connection")
			break
		}
		e := rt_errno()
		if e == EINTR {
			continue
		}
		if e == EAGAIN {
			r := rt_task_wait(fd, 1, timeout)
			if r != waitReady {
				fail give_up(l, s, r)
			}
			continue
		}
		fail_line(l, os_msg("read", e))
	}
	hand_off(l)
}

// exchange sends commands and waits for their replies; it returns the finished slot.
func (c Client) exchange(cmds [][]str) !i64 {
	if !c.open {
		fail "redis: the client is not open (too many clients: open one per server, not per request)"
	}
	for _, a := range cmds {
		if len(a) == 0 {
			fail "redis: an empty command"
		}
	}
	l := c.line()
	for _, a := range cmds {
		encode(l, a)
	}
	s := new_slot(len(cmds))
	q_push(l, s)
	if l[lBusy] == 0 {
		l[lBusy] = 1
		s[sOwner] = 1
	}
	for s[sState] == 0 {
		if s[sOwner] != 0 {
			try drive(l, s, c.rec)
			continue
		}
		r := rt_task_park(c.rec[rTimeout])
		if r != waitReady {
			fail give_up(l, s, r)
		}
	}
	if s[sState] == 2 {
		m := rt_str_from_raw(s[sErr], s[sErrN])
		free_slot(s)
		fail m
	}
	return s
}

// Do sends one command and returns its reply; an error reply fails.
func (c Client) Do(q query) !Reply {
	s := try c.exchange([][]str{words(q)})
	r, _ := reply_at(s[sMsg], 0)
	free_slot(s)
	switch r {
	case Err(m):
		fail "redis: {m}"
	default:
	}
	return r
}

// Pipe sends commands together and returns their replies in order; error replies come
// back as Err. The commands go out back to back, so MULTI ... EXEC in one Pipe is atomic.
func (c Client) Pipe(qs []query) ![]Reply {
	cmds := [][]str{}
	for _, q := range qs {
		cmds = append(cmds, words(q))
	}
	if len(cmds) == 0 {
		return []Reply{}
	}
	s := try c.exchange(cmds)
	items, _ := reply_items(s[sMsg], 0, len(cmds))
	free_slot(s)
	return items
}

func unexpected(cmd str, r Reply) ! {
	fail "redis: unexpected reply to {cmd}: {r}"
}

// Get returns the value at key, and whether there is one.
func (c Client) Get(key str) !(str, bool) {
	r := try c.Do("GET {key}")
	switch r {
	case Str(v):
		return v, true
	case Nil:
		return "", false
	default:
	}
	fail unexpected("GET", r)
}

// Set stores value at key.
func (c Client) Set(key str, value str) ! {
	_ = try c.Do("SET {key} {value}")
}

// SetEx stores value at key for ttl nanoseconds (at least a millisecond).
func (c Client) SetEx(key str, value str, ttl i64) ! {
	ms := ttl / 1000000
	if ms < 1 {
		ms = 1
	}
	_ = try c.Do("SET {key} {value} PX {ms}")
}

func int_reply(cmd str, r Reply) !i64 {
	switch r {
	case Int(v):
		return v
	default:
	}
	fail unexpected(cmd, r)
}

// Del removes key; it returns how many keys it removed (0 or 1).
func (c Client) Del(key str) !i64 {
	r := try c.Do("DEL {key}")
	return try int_reply("DEL", r)
}

// Incr adds one to the integer at key and returns the result.
func (c Client) Incr(key str) !i64 {
	r := try c.Do("INCR {key}")
	return try int_reply("INCR", r)
}

// Expire makes key expire after ttl nanoseconds; false when there is no such key.
func (c Client) Expire(key str, ttl i64) !bool {
	ms := ttl / 1000000
	if ms < 1 {
		ms = 1
	}
	r := try c.Do("PEXPIRE {key} {ms}")
	n := try int_reply("PEXPIRE", r)
	return n == 1
}

// Ping checks that the server answers.
func (c Client) Ping() ! {
	_ = try c.Do("PING")
}
