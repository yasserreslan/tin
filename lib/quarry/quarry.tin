// Package quarry is the operating system interface (like Go's os): arguments, environment, files and directories.
package quarry

import "say"


const oRdonly = 0
const oWrite = O_WRITE_CREATE
const oAppend = O_APPEND_CREATE
const eNOTDIR = 20
const eEXIST = 17
const eINVAL = 22

// Two stat buffers (struct stat is at most 144 bytes) and a path buffer, one set per core.
let stbuf i64 = calloc(1, 256)
let stbuf2 i64 = calloc(1, 256)
let pathbuf i64 = calloc(1, 4096)

fn c32(x i64) i64 {
	return i64(i32(x))
}

// errno returns the error code of the libc call that just failed.
fn errno() i64 {
	return rt_errno()
}

// errnoText returns rt_sys_strerror(e) with its first letter lowered, which is Go's spelling of errno texts.
fn errnoText(e i64) str {
	let p = rt_sys_strerror(e)
	let s = rt_str_from_raw(p, strlen(p))
	if len(s) > 0 && s[0] >= 'A' && s[0] <= 'Z' {
		store8(cast(i64, s)+8, i64(s[0])+32)
	}
	return s
}

// pathFault makes "op path: rt_sys_strerror(errno)" like Go's PathError.
fn pathFault(op str, path str) ! {
	let e = errnoText(errno())
	fail say.Fault("%s %s: %s", op, path, e)
}

// pathFaultCode is pathFault for error code e (an io_uring result is -e).
fn pathFaultCode(op str, path str, e i64) ! {
	fail say.Fault("%s %s: %s", op, path, errnoText(e))
}

// badPath reports whether path holds a NUL byte, which no C path can carry.
fn badPath(path str) bool {
	return len(path) > 0 && memchr(cast(i64, path)+8, 0, len(path)) != 0
}

// badKey reports an environment variable name the environment cannot hold: empty, or with
// '=' or NUL in it (as POSIX setenv and unsetenv refuse them).
fn badKey(key str) bool {
	return len(key) == 0 || memchr(cast(i64, key)+8, '=', len(key)) != 0 || badPath(key)
}

// invalidFault is the fault for a path with a NUL byte: "op path: invalid argument".
fn invalidFault(op str, path str) ! {
	fail say.Fault("%s %s: %s", op, path, errnoText(eINVAL))
}

// mode returns st_mode from the stat buffer st.
fn mode(st i64) i64 {
	return rt_stat_mode(st)
}

// isDirMode reports whether a st_mode value is a directory.
fn isDirMode(m i64) bool {
	return m&0xf000 == 0x4000
}

// Args returns the command line, program name first.
fn Args() []str {
	mut out = make([]str, 0, rtArgc)
	for i in 0..rtArgc {
		let p = rtArgv[i]
		out = append(out, rt_str_from_raw(p, strlen(p)))
	}
	return out
}

// Getenv returns the value of environment variable key, or "" when it is unset.
fn Getenv(key str) str {
	let p = rt_getenv(rt_cstr(key))
	if p == 0 {
		return ""
	}
	return rt_str_from_raw(p, strlen(p))
}

// LookupEnv returns the value of key and whether it is set (an empty value is still set).
fn LookupEnv(key str) (str, bool) {
	let p = rt_getenv(rt_cstr(key))
	if p == 0 {
		return "", false
	}
	return rt_str_from_raw(p, strlen(p)), true
}

// Setenv sets environment variable key to value; an empty key or one holding '=' or NUL is a fault.
fn Setenv(key str, value str) ! {
	if badKey(key) || badPath(value) {
		fail say.Fault("setenv: %s", errnoText(eINVAL))
	}
	if c32(rt_setenv(rt_cstr(key), rt_cstr(value))) != 0 {
		let e = errnoText(rt_env_errno())
		fail say.Fault("setenv: %s", e)
	}
}

// Unsetenv removes environment variable key.
fn Unsetenv(key str) ! {
	if badKey(key) {
		fail say.Fault("unsetenv: %s", errnoText(eINVAL))
	}
	if c32(rt_unsetenv(rt_cstr(key))) != 0 {
		let e = errnoText(rt_env_errno())
		fail say.Fault("unsetenv: %s", e)
	}
}

// readFd reads fd to its end into one str; hint is the expected size (0 when unknown).
fn readFd(fd i64, hint i64, path str) !str {
	mut room = hint + 1
	if room < 512 {
		room = 512
	}
	mut p = rt_str_new(room)
	mut got = 0
	for {
		if got == room {
			room *= 2
			let q = rt_str_new(room)
			memcpy(q+8, p+8, got)
			p = q
		}
		let n = rt_sys_read(fd, p+8+got, room-got)
		if n < 0 {
			fail pathFault("read", path)
		}
		if n == 0 {
			break
		}
		got += n
	}
	if got == 0 {
		return ""
	}
	p[0] = got
	return cast(str, p)
}

// ReadFile returns the whole content of the file at path.
fn ReadFile(path str) !str {
	let tp = rt_tape()
	if tp != 0 {
		tapedA = cast(i64, path)
		return try rt_effect(tp, "quarry.read@1", path, readLive) // recorded for replay (#241)
	}
	if rt_task_current() == 0 {
		return try readFileHere(path, -1)
	}
	// Inside a request task the read goes through the core's io_uring (Linux, #357), or runs
	// on a helper thread; either way the core serves others meanwhile.
	if useRing(path) {
		return try readRing(path)
	}
	return try readOnHelper(path, -1)
}

// Mount points of file systems whose stat and close can wait for a user-space daemon or a
// remote server (FUSE, virtiofs, 9p, CIFS): a file under one keeps the helper threads, so a core
// never waits for them in its own thread (#357). Read from /proc/self/mountinfo, per core, when
// the core first uses its ring; matched against the path as written.
mut slowMounts []str
mut slowMountsRead bool

// useRing reports whether this task's operation on path goes through the core's io_uring.
fn useRing(path str) bool {
	if !rt_ring_ready() {
		return false
	}
	if !slowMountsRead {
		slowMountsRead = true
		let (text, err) = readFileHere("/proc/self/mountinfo", -1)
		if err == nil {
			slowMounts = keep(slowMountsIn(text))
		}
	}
	if len(slowMounts) == 0 {
		return true
	}
	mut abs = path
	if len(path) == 0 || path[0] != '/' {
		if rt_sys_getcwd(pathbuf, 4096) == 0 {
			return false
		}
		abs = rt_str_from_raw(pathbuf, strlen(pathbuf)) + "/" + path
	}
	return !underAny(abs, slowMounts)
}

// underAny reports whether the absolute path p is one of dirs or inside one of them.
fn underAny(p str, dirs []str) bool {
	for d in dirs {
		let n = len(d)
		if d == "/" || (len(p) >= n && p[0:n] == d && (len(p) == n || p[n] == '/')) {
			return true
		}
	}
	return false
}

// slowMountsIn lists the mount points of slow file systems in mountinfo text, whose lines are
// "id parent major:minor root mountpoint options [tags...] - fstype source options".
fn slowMountsIn(text str) []str {
	mut out = make([]str, 0, 4)
	mut start = 0
	for i in 0..len(text)+1 {
		if i < len(text) && text[i] != '\n' {
			continue
		}
		let fields = splitSpaces(text[start:i])
		start = i + 1
		for k in 5..len(fields)-1 {
			if fields[k] == "-" {
				let t = fields[k+1]
				if t == "fuse" || t == "fuseblk" || (len(t) > 5 && t[0:5] == "fuse.") || t == "virtiofs" || t == "9p" || t == "cifs" || t == "smb3" {
					out = append(out, unescapeMount(fields[4]))
				}
				break
			}
		}
	}
	return out
}

fn splitSpaces(line str) []str {
	mut out = make([]str, 0, 12)
	mut start = 0
	for i in 0..len(line)+1 {
		if i == len(line) || line[i] == ' ' {
			if i > start {
				out = append(out, line[start:i])
			}
			start = i + 1
		}
	}
	return out
}

// unescapeMount undoes mountinfo's octal escapes (\040 for a space, \134 for a backslash).
fn unescapeMount(s str) str {
	mut b = make([]u8, 0, len(s))
	mut i = 0
	for i < len(s) {
		if s[i] == '\\' && i+3 < len(s) && s[i+1] >= '0' && s[i+1] <= '3' && s[i+2] >= '0' && s[i+2] <= '7' && s[i+3] >= '0' && s[i+3] <= '7' {
			b = append(b, u8(i64(s[i+1]-'0')*64 + i64(s[i+2]-'0')*8 + i64(s[i+3]-'0')))
			i += 4
		} else {
			b = append(b, s[i])
			i += 1
		}
	}
	return str(b)
}

// readOnHelper reads path on a helper thread. held (>= 0) is a descriptor of the same FIFO,
// open until the helper's own open returns, so a writer waiting for a reader never sees none.
fn readOnHelper(path str, held i64) !str {
	let job = calloc(6, 8)
	job[0] = rt_heap_str(path)
	job[5] = held + 1
	try rt_helper_run(readJob, job, readDrop)
	return try jobResult(job)
}

// readRing is ReadFile through the core's io_uring: the open and each read wait for their
// completion (data in the page cache arrives during the submit). The buffer is heap memory,
// which the ring frees if the task's deadline passes while the kernel still writes to it. A
// FIFO goes to a helper thread, whose open waits for a writer (the ring's open does not).
fn readRing(path str) !str {
	if badPath(path) {
		fail invalidFault("open", path)
	}
	let fd = rt_ring_open(rt_cstr(path), oRdonly, 0)
	if fd == ringGone {
		fail cast(fault, rt_wait_fault())
	}
	if fd < 0 {
		fail pathFaultCode("open", path, -fd)
	}
	mut size = 0
	if c32(rt_sys_fstat(fd, stbuf)) == 0 {
		if mode(stbuf)&0xf000 == 0x1000 {
			return try readOnHelper(path, fd)
		}
		if !isDirMode(mode(stbuf)) {
			size = rt_stat_size(stbuf)
		}
	}
	mut room = size + 1
	if room < 512 {
		room = 512
	}
	mut buf = malloc(room)
	mut got = 0
	for {
		if got == room {
			room *= 2
			let more = malloc(room)
			memcpy(more, buf, got)
			free(buf)
			buf = more
		}
		// Never past the size the file had: the kernel completes a short read of a regular file
		// on one of its workers, while a read of exactly what is there completes during the submit.
		mut ask = room - got
		if got < size {
			ask = size - got
		}
		if ask > 1073741824 {
			ask = 1073741824 // the length field is 32 bits
		}
		let n = rt_ring_read(fd, buf+got, ask, buf)
		if n == ringGone {
			fail cast(fault, rt_wait_fault()) // the ring closes fd and frees buf
		}
		if n < 0 {
			rt_sys_close(fd)
			free(buf)
			fail pathFaultCode("read", path, -n)
		}
		if n == 0 {
			break
		}
		got += n
	}
	rt_sys_close(fd)
	if got == 0 {
		free(buf)
		return ""
	}
	let s = rt_str_from_raw(buf, got)
	free(buf)
	return s
}

// readJob runs ReadFile on a helper thread, copying the result (or the fault's message)
// into malloc'd memory the task turns back into a str.
fn readJob(job i64) {
	let held = job[5] - 1
	job[5] = 0
	let (s, err) = readFileHere(cast(str, job[0]), held)
	if err != nil {
		jobFault(job, err)
		return
	}
	job[1] = malloc(len(s) + 1)
	memcpy(job[1], cast(i64, s)+8, len(s))
	job[2] = len(s)
}

fn jobFault(job i64, err fault) {
	let m = say.Str(err)
	job[3] = malloc(len(m) + 1)
	memcpy(job[3], cast(i64, m)+8, len(m))
	job[4] = len(m)
}

// Heap-owned inputs stay alive after a caller's deadline. The completion path uses
// these same disposers for late results, which never enter the expired request pool.
fn jobDrop(job i64) {
	free(job[0])
	free(job[1])
	free(job[3])
	free(job)
}

fn writeDrop(job i64) {
	free(job[5])
	jobDrop(job)
}

// readDrop also closes a held FIFO descriptor that no helper took (the job never ran).
fn readDrop(job i64) {
	if job[5] > 0 {
		rt_sys_close(job[5] - 1)
	}
	jobDrop(job)
}

// jobResult copies the result into the caller's pool and releases the heap-owned job.
fn jobResult(job i64) !str {
	mut m = ""
	mut s = ""
	let bad = job[3] != 0
	if bad {
		m = rt_str_from_raw(job[3], job[4])
	} else if job[1] != 0 {
		s = rt_str_from_raw(job[1], job[2])
	}
	jobDrop(job)
	if bad {
		fail m
	}
	return s
}

// readFileHere reads path where it runs; held (>= 0) is closed once its open returns.
fn readFileHere(path str, held i64) !str {
	if badPath(path) {
		if held >= 0 {
			rt_sys_close(held)
		}
		fail invalidFault("open", path)
	}
	let fd = c32(rt_sys_open(rt_cstr(path), oRdonly, 0))
	if held >= 0 {
		rt_sys_close(held)
	}
	if fd < 0 {
		fail pathFault("open", path)
	}
	mut size = 0
	if c32(rt_sys_fstat(fd, stbuf)) == 0 && !isDirMode(mode(stbuf)) {
		size = rt_stat_size(stbuf)
	}
	let (s, err) = readFd(fd, size, path)
	rt_sys_close(fd)
	if err != nil {
		fail err
	}
	return s
}

// ReadStdin reads standard input to its end. Inside a task, from a pipe, socket or terminal,
// it waits through rt_task_wait: the core serves others, and a deadline or cancel fails it.
fn ReadStdin() !str {
	if rt_task_current() != 0 && waitable(0) {
		return try readFdWait(0, "/dev/stdin")
	}
	return try readFd(0, 0, "/dev/stdin")
}

// waitable reports whether fd is a pipe, socket or terminal, which a task can wait on.
fn waitable(fd i64) bool {
	if c32(rt_sys_fstat(fd, stbuf)) != 0 {
		return false
	}
	let t = mode(stbuf) & 0xf000
	return t == 0x1000 || t == 0xc000 || (t == 0x2000 && rt_isatty(fd))
}

// readFdWait is readFd for a waitable fd in a task: it waits for input before every read.
fn readFdWait(fd i64, path str) !str {
	mut room = 512
	mut p = rt_str_new(room)
	mut got = 0
	for {
		if got == room {
			room *= 2
			let q = rt_str_new(room)
			memcpy(q+8, p+8, got)
			p = q
		}
		if rt_task_wait(fd, 1, 0) == waitDeadline {
			fail cast(fault, rt_wait_fault())
		}
		let n = rt_sys_read(fd, p+8+got, room-got)
		if n < 0 {
			if errno() == EAGAIN {
				continue
			}
			fail pathFault("read", path)
		}
		if n == 0 {
			break
		}
		got += n
	}
	if got == 0 {
		return ""
	}
	p[0] = got
	return cast(str, p)
}

// writeAll creates or opens path with flags (mode 0644) and writes all of data to it.
fn writeAll(path str, data str, flags i64) ! {
	if badPath(path) {
		fail invalidFault("open", path)
	}
	let fd = c32(rt_sys_open(rt_cstr(path), flags, 420))
	if fd < 0 {
		fail pathFault("open", path)
	}
	mut p = cast(i64, data) + 8
	mut n = len(data)
	for n > 0 {
		let w = rt_sys_write(fd, p, n)
		if w < 0 {
			let f = pathFault("write", path)
			rt_sys_close(fd)
			if f != nil {
				fail f
			}
			return
		}
		p += w
		n -= w
	}
	if c32(rt_sys_close(fd)) < 0 {
		fail pathFault("close", path)
	}
}

// WriteFile writes data to the file at path, creating it (mode 0644) or truncating it.
fn WriteFile(path str, data str) ! {
	let tp = rt_tape()
	if tp != 0 {
		return try writeTaped(tp, "w ", path, data, oWrite) // recorded for replay (#241)
	}
	return try writeVia(path, data, oWrite)
}

// AppendFile appends data to the file at path, creating it (mode 0644) when needed.
fn AppendFile(path str, data str) ! {
	let tp = rt_tape()
	if tp != 0 {
		return try writeTaped(tp, "a ", path, data, oAppend) // recorded for replay (#241)
	}
	return try writeVia(path, data, oAppend)
}

// writeVia is writeAll, through the core's io_uring or on a helper thread when called from a
// request task.
fn writeVia(path str, data str, flags i64) ! {
	if rt_task_current() == 0 {
		return try writeAll(path, data, flags)
	}
	if useRing(path) {
		return try writeRing(path, data, flags)
	}
	let job = calloc(7, 8)
	job[0] = rt_heap_str(path)
	job[5] = rt_heap_str(data)
	job[6] = flags
	try rt_helper_run(writeJob, job, writeDrop)
	free(job[5])
	_ = try jobResult(job)
}

// writeRing is writeAll through the core's io_uring (#357). The data is copied to heap memory
// the ring frees if the task's deadline passes while the kernel still reads it. An open that
// creates or truncates runs on the kernel's own workers, so a FIFO's waits for a reader.
fn writeRing(path str, data str, flags i64) ! {
	if badPath(path) {
		fail invalidFault("open", path)
	}
	let fd = rt_ring_open(rt_cstr(path), flags, 420)
	if fd == ringGone {
		fail cast(fault, rt_wait_fault())
	}
	if fd < 0 {
		fail pathFaultCode("open", path, -fd)
	}
	let n = len(data)
	if n > 0 {
		let buf = malloc(n)
		memcpy(buf, cast(i64, data)+8, n)
		mut done = 0
		for done < n {
			mut ask = n - done
			if ask > 1073741824 {
				ask = 1073741824 // the length field is 32 bits
			}
			let w = rt_ring_write(fd, buf+done, ask, buf)
			if w == ringGone {
				fail cast(fault, rt_wait_fault()) // the ring closes fd and frees buf
			}
			if w <= 0 {
				rt_sys_close(fd)
				free(buf)
				if w == 0 {
					fail say.Fault("write %s: unexpected EOF", path)
				}
				fail pathFaultCode("write", path, -w)
			}
			done += w
		}
		free(buf)
	}
	let c = rt_ring_close(fd)
	if c == ringGone {
		fail cast(fault, rt_wait_fault())
	}
	if c < 0 {
		fail pathFaultCode("close", path, -c)
	}
}

fn writeJob(job i64) {
	let err = writeAll(cast(str, job[0]), cast(str, job[5]), job[6])
	if err != nil {
		jobFault(job, err)
	}
}

// Exists reports whether path names an existing file or directory (symlinks are followed).
fn Exists(path str) bool {
	let tp = rt_tape()
	if tp != 0 {
		return rt_effect_word(tp, "quarry.stat@1", "exists " + path, i64(existsLive(path))) != 0 // recorded for replay (#241)
	}
	return existsLive(path)
}

fn existsLive(path str) bool {
	return !badPath(path) && c32(rt_sys_stat(rt_cstr(path), stbuf)) == 0
}

// IsDir reports whether path names a directory.
fn IsDir(path str) bool {
	let tp = rt_tape()
	if tp != 0 {
		let live = existsLive(path) && isDirMode(mode(stbuf))
		return rt_effect_word(tp, "quarry.stat@1", "isdir " + path, i64(live)) != 0 // recorded for replay (#241)
	}
	return Exists(path) && isDirMode(mode(stbuf))
}

// Size returns the size in bytes of the file at path.
fn Size(path str) !i64 {
	let tp = rt_tape()
	if tp != 0 {
		return try statTaped(tp, "size ", path, sizeLive) // recorded for replay (#241)
	}
	if badPath(path) {
		fail invalidFault("stat", path)
	}
	if c32(rt_sys_stat(rt_cstr(path), stbuf)) != 0 {
		fail pathFault("stat", path)
	}
	return rt_stat_size(stbuf)
}

// ModTime returns the modification time of path in seconds since the Unix epoch.
fn ModTime(path str) !i64 {
	let tp = rt_tape()
	if tp != 0 {
		return try statTaped(tp, "mtime ", path, mtimeLive) // recorded for replay (#241)
	}
	if badPath(path) {
		fail invalidFault("stat", path)
	}
	if c32(rt_sys_stat(rt_cstr(path), stbuf)) != 0 {
		fail pathFault("stat", path)
	}
	return rt_stat_mtime(stbuf)
}

// Remove deletes the file or empty directory at path.
fn Remove(path str) ! {
	let tp = rt_tape()
	if tp != 0 {
		return try fsTaped(tp, "rm ", path, "", removeLive) // recorded for replay (#241)
	}
	if badPath(path) {
		fail invalidFault("remove", path)
	}
	let cp = rt_cstr(path)
	if c32(rt_sys_unlink(cp)) == 0 {
		return
	}
	mut e = errno()
	if c32(rt_sys_rmdir(cp)) == 0 {
		return
	}
	let e1 = errno()
	if e1 != eNOTDIR {
		e = e1
	}
	fail say.Fault("remove %s: %s", path, errnoText(e))
}

// RemoveAll deletes path and everything below it; a missing path is not a fault.
fn RemoveAll(path str) ! {
	let tp = rt_tape()
	if tp != 0 {
		return try fsTaped(tp, "rmall ", path, "", removeAllLive) // recorded for replay (#241)
	}
	if badPath(path) {
		fail invalidFault("unlinkat", path)
	}
	if c32(rt_sys_lstat(rt_cstr(path), stbuf)) != 0 {
		if errno() == 2 {
			return
		}
		fail pathFault("lstat", path)
	}
	if isDirMode(mode(stbuf)) {
		let (names, err) = ReadDir(path)
		if err != nil {
			fail err
		}
		for _, name in names {
			try RemoveAll(path + "/" + name)
		}
	}
	return try Remove(path)
}

// sameFile reports whether the two stat buffers describe the same inode.
fn sameFile(a i64, b i64) bool {
	return rt_stat_ino(a) == rt_stat_ino(b) && rt_stat_dev(a) == rt_stat_dev(b)
}

// Rename moves oldpath to newpath, replacing a file there; like Go it never replaces a directory.
fn Rename(oldpath str, newpath str) ! {
	let tp = rt_tape()
	if tp != 0 {
		return try fsTaped(tp, "mv ", oldpath, newpath, renameLive) // recorded for replay (#241)
	}
	if badPath(oldpath) || badPath(newpath) {
		fail say.Fault("rename %s %s: %s", oldpath, newpath, errnoText(eINVAL))
	}
	if c32(rt_sys_lstat(rt_cstr(newpath), stbuf)) == 0 && isDirMode(mode(stbuf)) {
		if c32(rt_sys_lstat(rt_cstr(oldpath), stbuf2)) != 0 {
			let e = errnoText(errno())
			fail say.Fault("rename %s %s: %s", oldpath, newpath, e)
		}
		if newpath == oldpath || !sameFile(stbuf, stbuf2) {
			fail say.Fault("rename %s %s: %s", oldpath, newpath, errnoText(eEXIST))
		}
	}
	if c32(rt_sys_rename(rt_cstr(oldpath), rt_cstr(newpath))) != 0 {
		let e = errnoText(errno())
		fail say.Fault("rename %s %s: %s", oldpath, newpath, e)
	}
}

// Mkdir creates the directory path (mode 0755); its parent must exist.
fn Mkdir(path str) ! {
	let tp = rt_tape()
	if tp != 0 {
		return try fsTaped(tp, "mkdir ", path, "", mkdirLive) // recorded for replay (#241)
	}
	if badPath(path) {
		fail invalidFault("mkdir", path)
	}
	if c32(rt_sys_mkdir(rt_cstr(path), 493)) != 0 {
		fail pathFault("mkdir", path)
	}
}

// MkdirAll creates path and any missing parents (mode 0755); an existing directory is fine.
fn MkdirAll(path str) ! {
	let tp = rt_tape()
	if tp != 0 {
		return try fsTaped(tp, "mkdirall ", path, "", mkdirAllLive) // recorded for replay (#241)
	}
	if badPath(path) {
		fail invalidFault("mkdir", path)
	}
	if c32(rt_sys_stat(rt_cstr(path), stbuf)) == 0 {
		if isDirMode(mode(stbuf)) {
			return
		}
		fail say.Fault("mkdir %s: %s", path, errnoText(eNOTDIR))
	}
	mut i = len(path) - 1
	for i >= 0 && path[i] == '/' {
		i -= 1
	}
	for i >= 0 && path[i] != '/' {
		i -= 1
	}
	if i < 0 {
		i = 0
	}
	if i > 0 {
		try MkdirAll(path[0:i])
	}
	let err = Mkdir(path)
	if err != nil {
		if c32(rt_sys_lstat(rt_cstr(path), stbuf)) == 0 && isDirMode(mode(stbuf)) {
			return
		}
		if err != nil {
			fail err
		}
		return
	}
}

// sortStrs sorts a[lo:hi] bytewise in place (quicksort, insertion sort for short runs).
fn sortStrs(a mut []str, lo i64, hi i64) {
	for hi-lo > 12 {
		let mid = lo + (hi-lo)/2
		if rt_str_cmp(a[mid], a[lo]) < 0 {
			let t = a[mid]
			a[mid] = a[lo]
			a[lo] = t
		}
		if rt_str_cmp(a[hi-1], a[lo]) < 0 {
			let t = a[hi-1]
			a[hi-1] = a[lo]
			a[lo] = t
		}
		if rt_str_cmp(a[hi-1], a[mid]) < 0 {
			let t = a[hi-1]
			a[hi-1] = a[mid]
			a[mid] = t
		}
		let pivot = a[mid]
		mut i = lo
		mut j = hi - 1
		for i <= j {
			for rt_str_cmp(a[i], pivot) < 0 {
				i += 1
			}
			for rt_str_cmp(pivot, a[j]) < 0 {
				j -= 1
			}
			if i <= j {
				let t = a[i]
				a[i] = a[j]
				a[j] = t
				i += 1
				j -= 1
			}
		}
		if j-lo < hi-i {
			sortStrs(mut a, lo, j+1)
			lo = i
		} else {
			sortStrs(mut a, i, hi)
			hi = j + 1
		}
	}
	for i in lo + 1..hi {
		let x = a[i]
		mut j = i - 1
		for j >= lo && rt_str_cmp(a[j], x) > 0 {
			a[j+1] = a[j]
			j -= 1
		}
		a[j+1] = x
	}
}

// SortStrs sorts a bytewise in place.
fn SortStrs(a mut []str) {
	sortStrs(mut a, 0, len(a))
}

// ReadDir returns the names in directory path, sorted bytewise, without "." and "..".
fn ReadDir(path str) ![]str {
	let tp = rt_tape()
	if tp != 0 {
		return try readDirTaped(tp, path) // recorded for replay (#241)
	}
	mut out = make([]str, 0, 16)
	if badPath(path) {
		fail invalidFault("open", path)
	}
	let d = rt_sys_opendir(rt_cstr(path))
	if d == 0 {
		if errno() == eNOTDIR {
			fail pathFault("fdopendir", path)
		}
		fail pathFault("open", path)
	}
	for {
		let ent = rt_sys_readdir(d)
		if ent == 0 {
			break
		}
		let name = rt_dirent_name(ent)
		if name == "." || name == ".." {
			continue
		}
		out = append(out, name)
	}
	let direrr = rt_dir_error(d)
	rt_sys_closedir(d)
	if direrr != 0 { fail say.Fault("readdir %s: %s", path, errnoText(direrr)) }
	sortStrs(mut out, 0, len(out))
	return out
}

// Getwd returns the current working directory ($PWD when it still names it, like Go).
fn Getwd() !str {
	let pwd = Getenv("PWD")
	if len(pwd) > 0 && pwd[0] == '/' && c32(rt_sys_stat(rt_cstr(pwd), stbuf)) == 0 && c32(rt_sys_stat(rt_cstr("."), stbuf2)) == 0 && sameFile(stbuf, stbuf2) {
		return pwd
	}
	if rt_sys_getcwd(pathbuf, 4096) == 0 {
		let e = errnoText(errno())
		fail say.Fault("getwd: %s", e)
	}
	return rt_str_from_raw(pathbuf, strlen(pathbuf))
}

// Chdir changes the current working directory to path.
fn Chdir(path str) ! {
	if badPath(path) {
		fail invalidFault("chdir", path)
	}
	if c32(rt_sys_chdir(rt_cstr(path))) != 0 {
		fail pathFault("chdir", path)
	}
}

// TempDir returns the directory for temporary files: $TMPDIR, or /tmp.
fn TempDir() str {
	let d = Getenv("TMPDIR")
	if len(d) == 0 {
		return "/tmp"
	}
	return d
}

// Hostname returns the machine's host name.
fn Hostname() !str {
	if c32(hostName(pathbuf, 1024)) != 0 {
		let e = errnoText(errno())
		fail say.Fault("hostname: %s", e)
	}
	store8(pathbuf+1023, 0)
	return rt_str_from_raw(pathbuf, strlen(pathbuf))
}

// Pid returns the process id.
fn Pid() i64 {
	return c32(rt_sys_getpid())
}

// Exit flushes stdout and ends the program with status code.
fn Exit(code i64) {
	rt_flush()
	rt_sys_exit(code)
}

// Eprint writes s to stderr.
fn Eprint(s str) {
	if len(s) > 0 {
		rt_write_all(2, cast(i64, s)+8, len(s))
	}
}

// Eprintln writes s and a newline to stderr in one write.
fn Eprintln(s str) {
	let n = len(s)
	let p = rt_alloc(n + 1)
	if n > 0 {
		memcpy(p, cast(i64, s)+8, n)
	}
	store8(p+n, '\n')
	rt_write_all(2, p, n+1)
}

// ---- recording and replay (notes/interface_replay.md, section 4; #241) ----

// An effect's body runs at once, before it waits: these hand it its arguments.
mut tapedA i64
mut tapedB i64
mut tapedFlags i64

fn readLive() !str {
	return try ReadFile(cast(str, tapedA))
}

// writeTaped records or replays WriteFile or AppendFile as quarry.write@1.
fn writeTaped(tp i64, how str, path str, data str, flags i64) ! {
	tapedA = cast(i64, path)
	tapedB = cast(i64, data)
	tapedFlags = flags
	_ = try rt_effect(tp, "quarry.write@1", how + path + "\n" + data, writeLive)
}

fn writeLive() !str {
	try writeVia(cast(str, tapedA), cast(str, tapedB), tapedFlags)
	return ""
}

// statTaped records or replays Size or ModTime as quarry.stat@1 (the result a word).
fn statTaped(tp i64, what str, path str, live fn() !str) !i64 {
	tapedA = cast(i64, path)
	let v = try rt_effect(tp, "quarry.stat@1", what + path, live)
	if len(v) != 8 {
		fail "replay: quarry.stat@1 result is damaged"
	}
	return tword(v, 0)
}

fn sizeLive() !str {
	let n = try Size(cast(str, tapedA))
	return tput(make([]u8, 0, 8), n)
}

fn mtimeLive() !str {
	let t = try ModTime(cast(str, tapedA))
	return tput(make([]u8, 0, 8), t)
}

// fsTaped records or replays a change to the file system as quarry.fs@1 (a rename's two paths
// on two lines).
fn fsTaped(tp i64, what str, path str, other str, live fn() !str) ! {
	tapedA = cast(i64, path)
	tapedB = cast(i64, other)
	mut key = what + path
	if what == "mv " {
		key = key + "\n" + other
	}
	_ = try rt_effect(tp, "quarry.fs@1", key, live)
}

fn removeLive() !str {
	try Remove(cast(str, tapedA))
	return ""
}

fn removeAllLive() !str {
	try RemoveAll(cast(str, tapedA))
	return ""
}

fn renameLive() !str {
	try Rename(cast(str, tapedA), cast(str, tapedB))
	return ""
}

fn mkdirLive() !str {
	try Mkdir(cast(str, tapedA))
	return ""
}

fn mkdirAllLive() !str {
	try MkdirAll(cast(str, tapedA))
	return ""
}

// readDirTaped records or replays ReadDir as quarry.dir@1 (the names, each a string).
fn readDirTaped(tp i64, path str) ![]str {
	tapedA = cast(i64, path)
	let v = try rt_effect(tp, "quarry.dir@1", path, readDirLive)
	mut out = make([]str, 0, 16)
	mut at = 0
	for at < len(v) {
		if at+8 > len(v) {
			fail "replay: quarry.dir@1 result is damaged"
		}
		let n = tword(v, at)
		if n < 0 || at+8+n > len(v) {
			fail "replay: quarry.dir@1 result is damaged"
		}
		out = append(out, v[at+8:at+8+n])
		at += 8 + n
	}
	return out
}

fn readDirLive() !str {
	let names = try ReadDir(cast(str, tapedA))
	mut b = make([]u8, 0, 256)
	for _, n in names {
		b = append(b, tput(make([]u8, 0, 8), len(n))...)
		b = append(b, n...)
	}
	return str(b)
}

fn tput(b []u8, v i64) str {
	for i in 0..8 {
		b = append(b, u8(v >> (8 * i)))
	}
	return str(b)
}

fn tword(s str, at i64) i64 {
	mut v = 0
	{
		mut i = 7
		for i >= 0 {
			v = v<<8 | i64(s[at+i])
			i -= 1
		}
	}
	return v
}
