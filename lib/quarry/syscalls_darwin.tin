// Darwin system calls retain libSystem.
package quarry

extern func chdir(path i64) i64
func rt_sys_chdir(path i64) i64 { return chdir(path) }
extern func close(fd i64) i64
func rt_sys_close(fd i64) i64 { return close(fd) }
extern func closedir(d i64) i64
func rt_sys_closedir(d i64) i64 { return closedir(d) }
extern func fstat(fd i64, st i64) i64
func rt_sys_fstat(fd i64, st i64) i64 { return fstat(fd, st) }
extern func getcwd(buf i64, n i64) i64
func rt_sys_getcwd(buf i64, n i64) i64 { return getcwd(buf, n) }
extern func getpid() i64
func rt_sys_getpid() i64 { return getpid() }
extern func lstat(path i64, st i64) i64
func rt_sys_lstat(path i64, st i64) i64 { return lstat(path, st) }
extern func mkdir(path i64, mode i64) i64
func rt_sys_mkdir(path i64, mode i64) i64 { return mkdir(path, mode) }
extern func open(path i64, flags i64, ...) i64
func rt_sys_open(path i64, flags i64, mode i64) i64 { return open(path, flags, mode) }
extern func opendir(path i64) i64
func rt_sys_opendir(path i64) i64 { return opendir(path) }
extern func readdir(d i64) i64
func rt_sys_readdir(d i64) i64 { return readdir(d) }
extern func rename(a i64, b i64) i64
func rt_sys_rename(a i64, b i64) i64 { return rename(a, b) }
extern func rmdir(path i64) i64
func rt_sys_rmdir(path i64) i64 { return rmdir(path) }
extern func stat(path i64, st i64) i64
func rt_sys_stat(path i64, st i64) i64 { return stat(path, st) }
extern func unlink(path i64) i64
func rt_sys_unlink(path i64) i64 { return unlink(path) }
