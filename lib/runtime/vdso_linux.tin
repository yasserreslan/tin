// The kernel's in-process clock entry keeps the raw syscall backend off the hot path.
extern func getauxval(key i64) i64
shared var rtVdsoClock i64

func vdso_range(p i64, n i64, start i64, end i64) bool {
    return n >= 0 && p >= start && p <= end && n <= end-p
}

func rt_clock_setup() {
    base := getauxval(33)
    if base == 0 || __ld(base,2) != 0x464c457f || load8(base+4) != 2 || load8(base+5) != 1 { return }
    count := __ld(base+56,1)
    size := __ld(base+54,1)
    offset := base[4]
    if count == 0 || count > 32 || size != 56 || offset < 64 || offset > 4096 { return }
    bias := base
    end := base
    dynamic := i64(0)
    dynamicSize := i64(0)
    for i := i64(0); i < count; i++ {
        ph := base+offset+i*size
        if __ld(ph,2) == 1 && ph[1] == 0 { bias = base-ph[2] }
    }
    for i := i64(0); i < count; i++ {
        ph := base+offset+i*size
        if ph[5] < 0 || ph[5] > 1048576 { return }
        if __ld(ph,2) == 1 && bias+ph[2]+ph[5] > end { end = bias+ph[2]+ph[5] }
        if __ld(ph,2) == 2 { dynamic = bias+ph[2]; dynamicSize = ph[5] }
    }
    if !vdso_range(dynamic,dynamicSize,base,end) { return }
    strings := i64(0)
    stringsSize := i64(0)
    symbols := i64(0)
    hash := i64(0)
    gnu := i64(0)
    for p := dynamic; p+16 <= dynamic+dynamicSize; p += 16 {
        if p[0] == 0 { break }
        if p[0] == 4 { hash = bias+p[1] }
        if p[0] == 5 { strings = bias+p[1] }
        if p[0] == 6 { symbols = bias+p[1] }
        if p[0] == 10 { stringsSize = p[1] }
        if p[0] == 0x6ffffef5 { gnu = bias+p[1] }
    }
    if !vdso_range(strings,stringsSize,base,end) { return }
    symbolCount := i64(0)
    if vdso_range(hash,8,base,end) {
        symbolCount = __ld(hash+4,2)
    } else if vdso_range(gnu,16,base,end) {
        buckets := __ld(gnu,2)
        first := __ld(gnu+4,2)
        bloom := __ld(gnu+8,2)
        if buckets > 4096 || first > 4096 || bloom > 4096 { return }
        table := gnu+16+bloom*8
        if !vdso_range(table,buckets*4,base,end) { return }
        symbolCount = 0
        for i := i64(0); i < buckets; i++ {
            value := __ld(table+i*4,2)
            if value > symbolCount { symbolCount = value }
        }
        if symbolCount >= first && symbolCount != 0 {
            chain := table+buckets*4+(symbolCount-first)*4
            for vdso_range(chain,4,base,end) && symbolCount < 4096 {
                symbolCount++
                if __ld(chain,2)&1 != 0 { break }
                chain += 4
            }
        } else { symbolCount = first }
    }
    if symbolCount < 1 || symbolCount > 4096 || !vdso_range(symbols,symbolCount*24,base,end) { return }
    for i := i64(0); i < symbolCount; i++ {
        sym := symbols+i*24
        name := __ld(sym,2)
        if name >= stringsSize || __ld(sym+6,1) == 0 || load8(sym+4)&15 != 2 { continue }
        if memchr(strings+name,0,stringsSize-name) == 0 { continue }
        if strcmp(strings+name,linux_clock_name()) == 0 && vdso_range(bias+sym[1],1,base,end) {
            rtVdsoClock = bias+sym[1]
            return
        }
    }
}

func linux_vdso_clock(id i64, ts i64) i64 {
    if rtVdsoClock != 0 {
        entry := cast(func(i64,i64) i64,rtVdsoClock)
        result := i64(i32(entry(id,ts)))
        if result == 0 { return 0 }
    }
    return linux_raw(linux_nr_clock_gettime(),id,ts,0,0,0,0)
}
