// macOS part of the runtime: every libSystem call, constant and struct layout that differs
// from Linux sits here, behind rt_ helpers with the same names as in runtime_linux.tin.

extern fn __error() i64
extern fn clock_gettime_nsec_np(clock i64) i64
extern fn arc4random_buf(p i64, n i64)
extern fn sysconf(name i64) i64
extern fn setsockopt(fd i64, level i64, name i64, val i64, n i64) i64
extern fn pthread_set_qos_class_self_np(qos i64, rel i64) i64
extern fn pthread_sigmask(how i64, set i64, old i64) i64
extern fn pthread_create(t i64, attr i64, f i64, arg i64) i64
extern fn pthread_attr_init(attr i64) i64
extern fn pthread_attr_setstacksize(attr i64, n i64) i64

const EINTR = 4
const EAGAIN = 35
const EINPROGRESS = 36
const ENOENT = 2
const EEXIST = 17
const ENOTDIR = 20
const EINVAL = 22
const EMFILE = 24
const ENFILE = 23
const O_WRITE_CREATE = 0x601  // O_WRONLY | O_CREAT | O_TRUNC
const O_APPEND_CREATE = 0x209 // O_WRONLY | O_CREAT | O_APPEND
const O_NONBLOCK = 4
const F_GETFL = 3
const F_SETFL = 4
const SOL_SOCKET = 0xffff
const SO_REUSEADDR = 4
const SO_REUSEPORT = 0x200
const SO_ERROR = 0x1007
const SO_RCVTIMEO = 0x1006
const SO_SNDTIMEO = 0x1005
const TARGET_LINUX = false
const MAP_STACK = 0x1002 // MAP_PRIVATE | MAP_ANON
const TARGET_X64 = false

// rt_errno is the error code of the libc call that just failed.
fn rt_errno() i64 {
	return i64(i32(__error()[0]))
}

// rt_mono_ns is a monotonic clock in nanoseconds (it stops while the machine sleeps).
fn rt_mono_ns() i64 {
	return clock_gettime_nsec_np(8)
}

// rt_wall_ns is the wall clock in nanoseconds since 1970.
fn rt_wall_ns() i64 {
	return clock_gettime_nsec_np(0)
}

// rt_random fills n bytes at p with cryptographically secure random bytes.
fn rt_random(p i64, n i64) {
	arc4random_buf(p, n)
}

// rt_ncpus is the number of CPUs online.
fn rt_ncpus() i64 {
	return sysconf(58) & 0xffffffff
}

// rt_sockaddr_in fills the 16-byte IPv4 address ip:port at sa (ip in host byte order).
fn rt_sockaddr_in(sa i64, ip i64, port i64) {
	memset(sa, 0, 16)
	store8(sa, 16)
	store8(sa+1, 2)
	store8(sa+2, port>>8)
	store8(sa+3, port&255)
	store8(sa+4, (ip>>24)&255)
	store8(sa+5, (ip>>16)&255)
	store8(sa+6, (ip>>8)&255)
	store8(sa+7, ip&255)
}

// rt_ai_addr is the sockaddr of an addrinfo record.
fn rt_ai_addr(ai i64) i64 {
	return (ai + 32)[0]
}

// rt_nosigpipe stops writes to a closed socket from raising SIGPIPE.
fn rt_nosigpipe(fd i64) {
	let one = calloc(1, 8)
	one[0] = 1
	setsockopt(fd, 0xffff, 0x1022, one, 4)
	free(one)
}

// struct stat fields (st is a 256-byte buffer filled by stat, lstat or fstat).
fn rt_stat_mode(st i64) i64 {
	return __ld(st+4, 1) & 0xffff
}

fn rt_stat_size(st i64) i64 {
	return (st + 96)[0]
}

fn rt_stat_mtime(st i64) i64 {
	return (st + 48)[0]
}

fn rt_stat_dev(st i64) i64 {
	return __ld(st, 2) & 0xffffffff
}

fn rt_stat_ino(st i64) i64 {
	return (st + 8)[0]
}

// rt_dirent_name is the name in a directory entry returned by readdir.
fn rt_dirent_name(ent i64) str {
	return rt_str_from_raw(ent+21, __ld(ent+18, 1)&0xffff)
}

shared mut rtPoolChunk i64   // request pool chunk size once a memory limit lowered it (0: the default)

// rt_mem_limit is the container memory limit in bytes: macOS has none, so 0.
fn rt_mem_limit() i64 {
	return 0
}

// rt_mem_total is the machine's physical memory in bytes (_SC_PHYS_PAGES pages of
// _SC_PAGESIZE), 0 when unknown (#356).
fn rt_mem_total() i64 {
	let pages = sysconf(200)
	let size = sysconf(29)
	if pages <= 0 || size <= 0 {
		return 0
	}
	return pages * size
}

// rt_pin_setup is a no-op: macOS places threads itself (rt_core_qos asks for performance cores).
fn rt_pin_setup(n i64) {
}

// rt_core_qos asks macOS to keep this core's thread on a performance core.
fn rt_core_qos(id i64) {
	pthread_set_qos_class_self_np(0x21, 0)
}

// rt_stack_t fills a stack_t for sigaltstack: ss_sp, ss_size, ss_flags.
fn rt_stack_t(st i64, sp i64, n i64) {
	st[0] = sp
	st[1] = n
	__st(st+16, 0, 2)
}

// rt_fault_handlers installs h (sig, siginfo, ucontext) for SIGSEGV and SIGBUS on the signal
// stack: struct sigaction is the handler, a 4-byte mask and 4-byte flags (SA_ONSTACK 0x1 |
// SA_SIGINFO 0x40).
fn rt_fault_handlers(h i64) {
	let act = calloc(1, 16)
	act[0] = h
	__st(act+12, 0x41, 2)
	sigaction(11, act, 0)
	sigaction(10, act, 0)
	free(act)
}

// rt_fault_addr is siginfo_t's si_addr.
fn rt_fault_addr(info i64) i64 {
	return (info + 24)[0]
}

fn rt_sigbus() i64 {
	return 10
}

// rt_sig_block_term blocks SIGTERM and SIGINT in the calling thread; threads it creates inherit
// the mask, so a server can take the signals from kqueue (EVFILT_SIGNAL) instead of a handler.
fn rt_sig_block_term() {
	let set = calloc(1, 128)
	set[0] = 1<<14 | 1<<1
	pthread_sigmask(1, set, 0)
	free(set)
}

// rt_thread_start runs the function at code with arg on a new pthread with an 8 MiB stack.
fn rt_thread_start(code i64, arg i64) bool {
	let attr = calloc(16, 8)
	pthread_attr_init(attr)
	pthread_attr_setstacksize(attr, 8388608)
	let t = calloc(1, 8)
	let ok = pthread_create(t, attr, code, arg)&0xffffffff == 0
	free(t)
	free(attr)
	return ok
}

// rt_threads_reap is a no-op: pthreads own their stacks on macOS.
fn rt_threads_reap() {}

// rt_altstack_ready is false: every macOS thread installs its own signal stack.
fn rt_altstack_ready() bool { return false }

// rt_task_init sets a new task's saved registers (arm64: x19-x27, x29, x30, sp, d8-d15) so
// the first switch into it enters rt_task_entry with sp at top.
fn rt_task_init(t i64, top i64) {
	t[9] = 0
	t[10] = cast(i64, rt_task_entry)
	t[11] = top
}

// rt_page_size is the OS mapping page size.
fn rt_page_size() i64 { return sysconf(29) }

const MEM_DONTNEED = 4

// rt_task_sp reads the saved stack pointer without changing the swap layout.
fn rt_task_sp(t i64) i64 { return t[11] }

// rt_ctx_init sets saved registers (arm64) so the first switch into t calls entry with sp at top.
fn rt_ctx_init(t i64, top i64, entry i64) {
	t[9] = 0
	t[10] = entry
	t[11] = top
}

fn rt_env_errno() i64 { return rt_errno() }

extern fn getenv(name i64) i64
extern fn setenv(name i64, val i64, overwrite i64) i64
extern fn unsetenv(name i64) i64

// The environment stays in libSystem on macOS.
fn rt_os_start(argc i64, argv i64) {}
fn rt_getenv(name i64) i64 { return getenv(name) }
fn rt_setenv(name i64, value i64) i64 { return i64(i32(setenv(name, value, 1))) }
fn rt_unsetenv(name i64) i64 { return i64(i32(unsetenv(name))) }
fn rt_clock_setup() {}

fn rt_dir_error(d i64) i64 { return 0 }
fn rt_date_year_width() i64 { return 4 }
extern fn isatty(fd i64) i64
fn rt_isatty(fd i64) bool { return isatty(fd)&0xffffffff != 0 }

extern fn dladdr(addr i64, info i64) i64
fn rt_symbol_lookup(addr i64, info i64) i64 { return dladdr(addr,info) }

// Socket address family and length follow the native OS layout.
fn rt_sockaddr_family(sa i64) i64 { return i64(load8(sa+1)) }
fn rt_sockaddr_len(sa i64) i64 { return i64(load8(sa)) }

// rt_uctx_redirect makes the context the signal interrupted (ucontext_t, arm64) resume at pc with
// the stack pointer sp: uc_mcontext is a pointer at 48; its __ss has sp at 264 and pc at 272.
fn rt_uctx_redirect(uctx i64, pc i64, sp i64) {
	let mc = (uctx + 48)[0]
	(mc + 264)[0] = sp
	(mc + 272)[0] = pc
}

// rt_uctx_altstack_top is the top of the thread's signal stack, which the context records
// (uc_stack at 8: ss_sp, ss_size, ss_flags).
fn rt_uctx_altstack_top(uctx i64) i64 {
	return (uctx + 8)[0] + (uctx + 16)[0]
}
