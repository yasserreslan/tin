// Tin runtime: memory, strings, slices, maps, formatting and program startup.
// Compiler-generated code calls these rt_ functions with raw words; x28 holds the
// current thread's context.
//
// Strings are pointers to [length word][bytes][NUL], slices to [len, cap, data], maps
// to an open-addressing table. Every reference type uses 0 for nil, and nil strings,
// slices and maps behave as empty.

extern func write(fd i64, buf i64, n i64) i64
extern func read(fd i64, buf i64, n i64) i64
extern func malloc(n i64) i64
extern func calloc(n i64, size i64) i64
extern func realloc(p i64, n i64) i64
extern func free(p i64)
extern func nanosleep(req i64, rem i64) i64
extern func poll(fds i64, n i64, timeout i64) i64
extern func pipe(fds i64) i64
extern func fcntl(fd i64, cmd i64, ...) i64
extern func memcpy(dst i64, src i64, n i64) i64
extern func memmove(dst i64, src i64, n i64) i64
extern func memcmp(a i64, b i64, n i64) i64
extern func memset(p i64, c i64, n i64) i64
extern func exit(code i64)
extern func isatty(fd i64) i64
extern func snprintf(buf i64, n i64, format i64, ...) i64
extern func strtod(s i64, end i64) f64
extern func strlen(s i64) i64
extern func rint(x f64) f64
extern func dladdr(addr i64, info i64) i64
extern func posix_memalign(p i64, align i64, n i64) i64

extern func pthread_create(t i64, attr i64, f i64, arg i64) i64
extern func pthread_attr_init(attr i64) i64
extern func pthread_attr_setstacksize(attr i64, n i64) i64

// Core context words: x28 points here, and the core's globals follow (the compiler
// addresses global i at x28 + 8*(ctxWords+i), so every core has its own copy).
const ctxBump = 0
const ctxEnd = 1
const ctxFmt = 2
const ctxFound = 3
const ctxID = 4
const ctxArena = 5
const ctxIngot = 6      // 1 while initializers run: allocations go to the ingot heap
const ctxPoolBase = 7   // the core's first pool chunk
const ctxPoolMark = 8   // pool top in the first chunk once allocation moved past it
const ctxPoolExtra = 9  // overflow chunks and big blocks, freed at reset: [next, ...]
const ctxFree = 10      // 16 ingot free lists, one per size class
const ctxSlab = 26      // ingot slab bump pointer
const ctxSlabEnd = 27
const ctxWords = 32

const chunkSize = 4194304
const bigAlloc = 262144
const maxAlloc = 70368744177664 // 2^46 bytes: no single allocation may ask for more
const slabSize = 1048576

// rt_chunk is the request pool chunk size: chunkSize, or less when hearth lowered rtPoolChunk
// to fit the memory limit (see pool_tune in lib/hearth.tin).
func rt_chunk() i64 {
	if rtPoolChunk != 0 {
		return rtPoolChunk
	}
	return chunkSize
}

shared var rtArgc i64
shared var rtArgv i64
shared var rtOut i64      // stdout buffer: [len, cap, data]
shared var rtOutTTY bool
shared var rtOutLock i64
shared var rtTLS i64      // number of per-core globals
shared var rtCoreInit func()
shared var rtCores i64
shared var rtCoresDone i64
shared var rtHashK0 i64   // map hash key: random per process, so keys cannot be chosen to collide
shared var rtHashK1 i64

func rt_init(argc i64, argv i64, ntls i64, coreinit func()) {
	rtTLS = ntls
	rtCoreInit = coreinit
	ctx := rt_ctx_new(0)
	__set_ctx(ctx)
	rtCores = 1
	rtArgc = argc
	rtArgv = argv
	rtOut = calloc(3, 8)
	rtOut[1] = 65536
	rtOut[2] = malloc(65536)
	rtOutTTY = isatty(1)&0xffffffff != 0
	rt_random(&rtHashK0, 8)
	rt_random(&rtHashK1, 8)
}

// rt_aligned_alloc returns n zeroed bytes on their own 128-byte cache lines (n is rounded up).
func rt_aligned_alloc(n i64) i64 {
	n = (n + 127) & -128
	slot := calloc(1, 8)
	posix_memalign(slot, 128, n)
	p := slot[0]
	free(slot)
	memset(p, 0, n)
	return p
}

func rt_ctx_new(id i64) i64 {
	// Each core writes its context on every allocation: keep it off other cores' lines.
	ctx := rt_aligned_alloc((ctxWords + rtTLS) * 8)
	ctx[ctxID] = id
	ctx[ctxIngot] = 1
	return ctx
}

// rt_core_main is a new core's thread: its own context, its own globals, then entry(arg).
func rt_core_main(p i64) i64 {
	__set_ctx(rt_ctx_new(p[2]))
	rt_core_qos(p[2])
	rtCoreInit()
	__ctx()[ctxIngot] = 0
	entry := cast(func(i64), p[0])
	entry(p[1])
	rt_flush_core()
	__atomic_add(&rtCoresDone, 1)
	return 0
}

func rt_flush_core() {
	rt_lock(&rtOutLock)
	rt_flush()
	rt_unlock(&rtOutLock)
}

// rt_spawn_core starts a core running entry(arg) on its own thread with an 8 MiB stack.
func rt_spawn_core(entry func(i64), arg i64) {
	p := calloc(4, 8)
	p[0] = cast(i64, entry)
	p[1] = arg
	p[2] = __atomic_add(&rtCores, 1)
	attr := calloc(16, 8)
	pthread_attr_init(attr)
	pthread_attr_setstacksize(attr, 8388608)
	t := calloc(1, 8)
	if pthread_create(t, attr, cast(i64, rt_core_main), p)&0xffffffff != 0 {
		rt_panic("cannot start a core thread")
	}
}

func rt_core_id() i64 {
	return __ctx()[ctxID]
}

func rt_exit() {
	rt_flush()
	exit(0)
}

// rt_main_begin ends initialization: from here allocations go to the request pool.
func rt_main_begin() {
	__ctx()[ctxIngot] = 0
}

func rt_bounds_fail() {
	rt_panic("index out of range")
}

func rt_div_fail() {
	rt_panic("integer divide by zero")
}

// rt_bounds_fail2 is a failed bounds check with its index and length (Go's wording).
func rt_bounds_fail2(i i64, n i64) {
	b := rt_alloc(128)
	k := snprintf(b, 128, cast(i64, "index out of range [%lld] with length %lld")+8, i, n) & 0xffffffff
	rt_panic(rt_str_from_raw(b, k))
}

// rt_fail makes a fault: a str holding the message (a fault is never nil).
func rt_fail(msg str) i64 {
	n := len(msg)
	p := rt_str_new(n)
	memcpy(p+8, cast(i64, msg)+8, n)
	return p
}

// ---- memory ----

// rt_alloc returns n zeroed bytes from the thread's bump chunk. Memory is never freed:
// programs and requests are short, and a bump pointer is the fastest allocator there is.
func rt_alloc(n i64) i64 {
	c := __ctx()
	if c[ctxIngot] != 0 {
		return rt_ingot_alloc(n)
	}
	n = (n + 15) & -16
	p := c[ctxBump]
	if p+n > c[ctxEnd] {
		return rt_alloc_slow(n)
	}
	c[ctxBump] = p + n
	return p
}

func rt_alloc_slow(n i64) i64 {
	c := __ctx()
	if c[ctxPoolBase] == 0 {
		chunk := calloc(1, rt_chunk())
		c[ctxPoolBase] = chunk
		c[ctxBump] = chunk
		c[ctxEnd] = chunk + rt_chunk()
		// A first allocation that fits takes the base chunk; a big one still gets its own block.
		if n < bigAlloc && n <= rt_chunk() {
			c[ctxBump] = chunk + n
			return chunk
		}
	}
	if n >= bigAlloc || n+16 > rt_chunk() {
		if n > maxAlloc {
			rt_panic("allocation size out of range")
		}
		b := calloc(1, n+16)
		if b == 0 {
			rt_panic("out of memory")
		}
		b[0] = c[ctxPoolExtra]
		c[ctxPoolExtra] = b
		return b + 16
	}
	if c[ctxPoolMark] == 0 {
		c[ctxPoolMark] = c[ctxBump]
	}
	chunk := calloc(1, rt_chunk())
	chunk[0] = c[ctxPoolExtra]
	c[ctxPoolExtra] = chunk
	c[ctxBump] = chunk + 16 + n
	c[ctxEnd] = chunk + rt_chunk()
	return chunk + 16
}

// rt_pool_reset ends a request: the core's pool is zeroed back to empty in place.
func rt_pool_reset() {
	c := __ctx()
	base := c[ctxPoolBase]
	if base == 0 {
		return
	}
	top := c[ctxBump]
	if c[ctxPoolMark] != 0 {
		top = c[ctxPoolMark]
		for p := c[ctxPoolExtra]; p != 0; {
			next := p[0]
			free(p)
			p = next
		}
		c[ctxPoolExtra] = 0
		c[ctxPoolMark] = 0
	} else if c[ctxPoolExtra] != 0 {
		for p := c[ctxPoolExtra]; p != 0; {
			next := p[0]
			free(p)
			p = next
		}
		c[ctxPoolExtra] = 0
	}
	memset(base, 0, top-base)
	c[ctxBump] = base
	c[ctxEnd] = base + rt_chunk()
}

// rt_pool_used reports the bytes the current request has taken from the pool.
func rt_pool_used() i64 {
	c := __ctx()
	if c[ctxPoolMark] != 0 {
		return c[ctxPoolMark] - c[ctxPoolBase] + rt_chunk()
	}
	return c[ctxBump] - c[ctxPoolBase]
}

// Ingot size classes (block sizes with the 8-byte header): 16 32 48 64, then 96 128 192
// 256 ... 3072 4096. Larger blocks come from calloc with a -1 header.
func rt_ingot_class(sz i64) i64 {
	if sz <= 64 {
		return (sz+15)>>4 - 1
	}
	s := 64
	k := 4
	for k < 16 {
		if sz <= s+s>>1 {
			return k
		}
		if sz <= 2*s {
			return k + 1
		}
		s *= 2
		k += 2
	}
	return -1
}

func rt_class_size(k i64) i64 {
	if k < 4 {
		return 16 * (k + 1)
	}
	j := k - 4
	s := 64 << (j >> 1)
	if j&1 == 0 {
		return s + s>>1
	}
	return 2 * s
}

// rt_ingot_alloc returns zeroed long-lived memory from the core's ingot heap.
func rt_ingot_alloc(n i64) i64 {
	k := rt_ingot_class(n + 8)
	if k < 0 {
		if n > maxAlloc {
			rt_panic("allocation size out of range")
		}
		b := calloc(1, n+8)
		if b == 0 {
			rt_panic("out of memory")
		}
		b[0] = -1
		return b + 8
	}
	c := __ctx()
	p := c[ctxFree+k]
	if p != 0 {
		c[ctxFree+k] = p[0]
		memset(p, 0, rt_class_size(k)-8)
		return p
	}
	bs := rt_class_size(k)
	if c[ctxSlab]+bs > c[ctxSlabEnd] {
		slab := calloc(1, slabSize)
		c[ctxSlab] = slab
		c[ctxSlabEnd] = slab + slabSize
	}
	b := c[ctxSlab]
	c[ctxSlab] = b + bs
	b[0] = k
	return b + 8
}

// rt_ingot_free returns a block to its core's free list (blocks never cross cores).
func rt_ingot_free(p i64) {
	if p == 0 {
		return
	}
	k := (p - 8)[0]
	if k < 0 {
		free(p - 8)
		return
	}
	c := __ctx()
	p[0] = c[ctxFree+k]
	c[ctxFree+k] = p
}

// rt_region_alloc allocates in the ingot heap when ingot is 1, else in the pool.
func rt_region_alloc(ingot i64, n i64) i64 {
	if ingot != 0 {
		return rt_ingot_alloc(n)
	}
	return rt_alloc(n)
}

// lsr is a logical shift right (Tin's >> is arithmetic).
func lsr(x i64, n i64) i64 {
	return (x >> n) & ((1 << (64 - n)) - 1)
}

// ---- output ----

func rt_lock(p i64) {
	for __atomic_swap(p, 1) != 0 {
		__yield()
	}
}

func rt_unlock(p i64) {
	__atomic_store(p, 0)
}

func rt_write_all(fd i64, p i64, n i64) {
	for n > 0 {
		w := write(fd, p, n)
		if w <= 0 {
			return
		}
		p += w
		n -= w
	}
}

func rt_flush() {
	if rtOut == 0 {
		return
	}
	rt_write_all(1, rtOut[2], rtOut[0])
	rtOut[0] = 0
}

// rt_out appends n bytes to the stdout buffer, flushing at 64 KiB or, on a terminal,
// at every newline.
func rt_out(p i64, n i64) {
	rt_lock(&rtOutLock)
	if rtOut[0]+n > rtOut[1] {
		rt_flush()
		if n > rtOut[1] {
			rt_write_all(1, p, n)
			rt_unlock(&rtOutLock)
			return
		}
	}
	memcpy(rtOut[2]+rtOut[0], p, n)
	rtOut[0] += n
	if rtOutTTY {
		rt_flush()
	}
	rt_unlock(&rtOutLock)
}

func rt_panic(msg str) {
	rt_flush()
	head := "panic: "
	rt_write_all(2, cast(i64, head)+8, len(head))
	rt_write_all(2, cast(i64, msg)+8, len(msg))
	rt_write_all(2, cast(i64, "\n")+8, 1)
	rt_backtrace(__fp())
	exit(2)
}

// rt_backtrace prints the calling functions by walking the frame-pointer chain.
func rt_backtrace(fp i64) {
	info := calloc(4, 8)
	core := rt_alloc(64)
	cn := snprintf(core, 64, cast(i64, "\ncore %lld:\n")+8, rt_core_id()) & 0xffffffff
	rt_write_all(2, core, cn)
	for k := 0; k < 64 && fp != 0; k++ {
		ret := fp[1]
		if ret == 0 {
			break
		}
		name := cast(i64, "?") + 8
		if dladdr(ret-4, info)&0xffffffff != 0 && info[2] != 0 {
			name = info[2]
			// Linux executables name Tin functions tin.<name> in their dynamic symbols.
			if load8(name) == 't' && load8(name+1) == 'i' && load8(name+2) == 'n' && load8(name+3) == '.' {
				name = name + 4
			}
		}
		// The program's entry ("main", which calls main.main) ends the user's frames.
		if load8(name) == 'm' && load8(name+1) == 'a' && load8(name+2) == 'i' && load8(name+3) == 'n' && load8(name+4) == 0 {
			break
		}
		skip := load8(name) == 'r' && load8(name+1) == 't' && load8(name+2) == '_'
		if !skip {
			rt_write_all(2, cast(i64, "\t")+8, 1)
			rt_write_all(2, name, strlen(name))
			rt_write_all(2, cast(i64, "\n")+8, 1)
		}
		next := fp[0]
		if next <= fp {
			break
		}
		fp = next
	}
}

func rt_err_str(e i64) str {
	if e == 0 {
		return "<nil>"
	}
	return cast(str, e)
}

// ---- strings ----

func rt_str_new(n i64) i64 {
	// A negative or huge n would wrap n + 9 (length word and NUL) into a bogus size.
	if n < 0 || n > maxAlloc {
		rt_panic("allocation size out of range")
	}
	p := rt_alloc(n + 9)
	p[0] = n
	return p
}

func rt_cstr(s str) i64 {
	if len(s) == 0 {
		return cast(i64, "") + 8
	}
	return cast(i64, s) + 8
}

func rt_str_cat(a str, b str) str {
	la := len(a)
	lb := len(b)
	if la == 0 {
		return b
	}
	if lb == 0 {
		return a
	}
	p := rt_str_new(la + lb)
	memcpy(p+8, cast(i64, a)+8, la)
	memcpy(p+8+la, cast(i64, b)+8, lb)
	return cast(str, p)
}

func rt_str_eq(a str, b str) bool {
	pa := cast(i64, a)
	pb := cast(i64, b)
	if pa == pb {
		return true
	}
	la := len(a)
	if la != len(b) {
		return false
	}
	if la == 0 {
		return true
	}
	if load8(pa+8) != load8(pb+8) {
		return false
	}
	return memcmp(pa+8, pb+8, la)&0xffffffff == 0
}

func rt_str_cmp(a str, b str) i64 {
	la := len(a)
	lb := len(b)
	n := la
	if lb < n {
		n = lb
	}
	if n > 0 {
		r := (memcmp(cast(i64, a)+8, cast(i64, b)+8, n) << 32) >> 32
		if r != 0 {
			return r
		}
	}
	return la - lb
}

func rt_str_sub(s str, lo i64, hi i64, hasHi i64) str {
	n := len(s)
	if hasHi == 0 {
		hi = n
	}
	if lo < 0 || hi > n || lo > hi {
		rt_panic("str slice out of range")
	}
	if lo == 0 && hi == n {
		return s
	}
	if hi == lo {
		return ""
	}
	p := rt_str_new(hi - lo)
	memcpy(p+8, cast(i64, s)+8+lo, hi-lo)
	return cast(str, p)
}

func rt_str_from_bytes(b []u8) str {
	n := len(b)
	if n == 0 {
		return ""
	}
	p := rt_str_new(n)
	memcpy(p+8, cast(i64, b)[2], n)
	return cast(str, p)
}

func rt_str_from_raw(p i64, n i64) str {
	s := rt_str_new(n)
	memcpy(s+8, p, n)
	return cast(str, s)
}

func rt_bytes_from_str(s str) i64 {
	n := len(s)
	h := rt_slice_make(n, n, 1)
	if n > 0 {
		memcpy(h[2], cast(i64, s)+8, n)
	}
	return h
}

func rt_str_from_rune(r i64) str {
	p := rt_str_new(4)
	n := rt_utf8_put(p+8, r)
	p[0] = n
	return cast(str, p)
}

// rt_utf8_put encodes rune r at p and returns its length in bytes.
func rt_utf8_put(p i64, r i64) i64 {
	if r < 0 || r > 0x10ffff || (r >= 0xd800 && r <= 0xdfff) {
		r = 0xfffd
	}
	if r < 0x80 {
		store8(p, r)
		return 1
	}
	if r < 0x800 {
		store8(p, 0xc0|(r>>6))
		store8(p+1, 0x80|(r&63))
		return 2
	}
	if r < 0x10000 {
		store8(p, 0xe0|(r>>12))
		store8(p+1, 0x80|((r>>6)&63))
		store8(p+2, 0x80|(r&63))
		return 3
	}
	store8(p, 0xf0|(r>>18))
	store8(p+1, 0x80|((r>>12)&63))
	store8(p+2, 0x80|((r>>6)&63))
	store8(p+3, 0x80|(r&63))
	return 4
}

// rt_utf8 decodes the rune at byte i of s, returning rune | width<<32 (bad bytes are
// U+FFFD, width 1), which range loops over strings unpack.
func rt_utf8(s str, i i64) i64 {
	p := cast(i64, s) + 8 + i
	n := len(s) - i
	c := i64(load8(p))
	if c < 0x80 {
		return c | (1 << 32)
	}
	if c >= 0xc2 && c < 0xe0 && n >= 2 {
		c1 := i64(load8(p + 1))
		if c1&0xc0 == 0x80 {
			return ((c&31)<<6 | (c1 & 63)) | (2 << 32)
		}
	}
	if c >= 0xe0 && c < 0xf0 && n >= 3 {
		c1 := i64(load8(p + 1))
		c2 := i64(load8(p + 2))
		if c1&0xc0 == 0x80 && c2&0xc0 == 0x80 {
			r := (c&15)<<12 | (c1&63)<<6 | (c2 & 63)
			if r >= 0x800 && (r < 0xd800 || r > 0xdfff) {
				return r | (3 << 32)
			}
		}
	}
	if c >= 0xf0 && c < 0xf5 && n >= 4 {
		c1 := i64(load8(p + 1))
		c2 := i64(load8(p + 2))
		c3 := i64(load8(p + 3))
		if c1&0xc0 == 0x80 && c2&0xc0 == 0x80 && c3&0xc0 == 0x80 {
			r := (c&7)<<18 | (c1&63)<<12 | (c2&63)<<6 | (c3 & 63)
			if r >= 0x10000 && r <= 0x10ffff {
				return r | (4 << 32)
			}
		}
	}
	return 0xfffd | (1 << 32)
}

// ---- slices ----

func rt_slice_make(n i64, c i64, esz i64) i64 {
	if n < 0 {
		rt_panic("make: negative length")
	}
	if c < n {
		c = n
	}
	if c > maxAlloc/esz {
		rt_panic("make: size out of range")
	}
	ingot := __ctx()[ctxIngot]
	h := rt_region_alloc(ingot, 32)
	h[0] = n
	h[1] = c
	h[3] = ingot
	if c > 0 {
		h[2] = rt_region_alloc(ingot, c*esz+8)
	}
	return h
}

// rt_slice_make_str makes a []str of n "" elements (a str is never nil).
func rt_slice_make_str(n i64, c i64) i64 {
	h := rt_slice_make(n, c, 8)
	e := cast(i64, "")
	d := h[2]
	for i := 0; i < n; i++ {
		d[i] = e
	}
	return h
}

// rt_slice_make_nest makes a [][]T of n empty slices, each a header of its own.
func rt_slice_make_nest(n i64, c i64, esz i64) i64 {
	h := rt_slice_make(n, c, 8)
	d := h[2]
	for i := 0; i < n; i++ {
		d[i] = rt_slice_make(0, 0, esz)
	}
	return h
}

// rt_slice_make_grid makes an [n][m]T: n rows of m zero elements ("" for strs).
func rt_slice_make_grid(n i64, m i64, esz i64, isstr i64) i64 {
	h := rt_slice_make(n, n, 8)
	d := h[2]
	for i := 0; i < n; i++ {
		if isstr != 0 {
			d[i] = rt_slice_make_str(m, m)
		} else {
			d[i] = rt_slice_make(m, m, esz)
		}
	}
	return h
}

// rt_slice_grow gives s room for need elements, in the region s lives in.
func rt_slice_grow(s i64, need i64, esz i64) {
	c := s[1] * 2
	if c < 8 {
		c = 8
	}
	if need < 0 || need > maxAlloc/esz {
		rt_panic("append: size out of range")
	}
	for c < need {
		c *= 2
	}
	d := rt_region_alloc(s[3], c*esz+8)
	if s[0] > 0 {
		memcpy(d, s[2], s[0]*esz)
	}
	s[2] = d
	s[1] = c
}

// rt_own returns a header append may change: the shared empty header (cap 0) is copied.
func rt_own(s i64, esz i64) i64 {
	if s == cast(i64, __empty()) {
		return rt_slice_make(0, 0, esz)
	}
	return s
}

func rt_store_elem(p i64, v i64, esz i64) {
	if esz == 8 {
		p[0] = v
	} else if esz == 1 {
		store8(p, v)
	} else if esz == 4 {
		__st(p, v, 2)
	} else {
		__st(p, v, 1)
	}
}

func rt_append(s i64, v i64, esz i64) i64 {
	s = rt_own(s, esz)
	n := s[0]
	if n >= s[1] {
		rt_slice_grow(s, n+1, esz)
	}
	rt_store_elem(s[2]+n*esz, v, esz)
	s[0] = n + 1
	return s
}

// rt_append_dyn appends the two-word object/table representation without routing it
// through the one-word element store used by rt_append.
func rt_append_dyn(s i64, object i64, table i64) i64 {
	s = rt_own(s, 16)
	n := s[0]
	if n >= s[1] {
		rt_slice_grow(s, n+1, 16)
	}
	p := s[2] + n*16
	p[0] = object
	p[1] = table
	s[0] = n + 1
	return s
}

func rt_slice_appendn(s i64, t i64, esz i64) i64 {
	if t[0] == 0 {
		return s
	}
	s = rt_own(s, esz)
	n := s[0]
	need := n + t[0]
	if need > s[1] {
		rt_slice_grow(s, need, esz)
	}
	memmove(s[2]+n*esz, t[2], t[0]*esz)
	s[0] = need
	return s
}

func rt_append_str(s i64, txt str) i64 {
	m := len(txt)
	if m == 0 {
		return s
	}
	s = rt_own(s, 1)
	n := s[0]
	if n+m > s[1] {
		rt_slice_grow(s, n+m, 1)
	}
	memcpy(s[2]+n, cast(i64, txt)+8, m)
	s[0] = n + m
	return s
}

func rt_slice_sub(s i64, lo i64, hi i64, esz i64, hasHi i64) i64 {
	if hasHi == 0 {
		hi = s[0]
	}
	if lo < 0 || hi > s[0] || lo > hi {
		rt_panic("slice bounds out of range")
	}
	h := rt_alloc(32)
	h[0] = hi - lo
	h[1] = s[1] - lo
	h[2] = s[2] + lo*esz
	h[3] = s[3]
	return h
}

func rt_slice_copy(dst i64, src i64, esz i64) i64 {
	n := dst[0]
	if src[0] < n {
		n = src[0]
	}
	memmove(dst[2], src[2], n*esz)
	return n
}

func rt_copy_str(dst i64, s str) i64 {
	n := dst[0]
	if len(s) < n {
		n = len(s)
	}
	memmove(dst[2], cast(i64, s)+8, n)
	return n
}

// ---- maps ----
//
// Insertion-ordered: entries are appended to arrays (keys, values, cached str hashes, a
// live byte each) and found through an open-addressing index of entry numbers (0 empty,
// -1 deleted, else entry+1) with a keyed hash (rt_map_hash) and linear probing. The index has twice
// as many slots as there are entries, so it is never more than half full. Header words:
// count, index slots, keys, values, index, str keys?, shift, index tombstones, hashes,
// ingot, entries used, entry capacity, live bytes.

func rt_map_make(isstr i64) i64 {
	ingot := __ctx()[ctxIngot]
	m := rt_region_alloc(ingot, 104)
	m[5] = isstr
	m[9] = ingot
	rt_map_init(m, 8)
	return m
}

// rt_map_init gives m room for ec entries (an index of 2*ec slots), empty.
func rt_map_init(m i64, ec i64) {
	ic := ec * 2
	m[0] = 0
	m[1] = ic
	m[2] = rt_region_alloc(m[9], ec*8)
	m[3] = rt_region_alloc(m[9], ec*8)
	m[4] = rt_region_alloc(m[9], ic*8)
	shift := 64
	for x := ic; x > 1; x >>= 1 {
		shift--
	}
	m[6] = shift
	m[7] = 0
	m[8] = 0
	if m[5] != 0 {
		m[8] = rt_region_alloc(m[9], ec*8)
	}
	m[10] = 0
	m[11] = ec
	m[12] = rt_region_alloc(m[9], ec)
}

// rt_hash_str is SipHash-1-3 of s keyed with the process's random key, so a client cannot
// pick keys that collide in a map (hash flooding).
func rt_hash_str(s str) i64 {
	n := len(s)
	p := cast(i64, s) + 8
	v0 := rtHashK0 ^ 0x736f6d6570736575
	v1 := rtHashK1 ^ 0x646f72616e646f6d
	v2 := rtHashK0 ^ 0x6c7967656e657261
	v3 := rtHashK1 ^ 0x7465646279746573
	i := 0
	for i+8 <= n {
		m := (p + i)[0]
		v3 ^= m
		v0 += v1
		v1 = (v1<<13 | (v1>>51)&8191) ^ v0
		v0 = (v0<<32 | (v0>>32)&4294967295)
		v2 += v3
		v3 = (v3<<16 | (v3>>48)&65535) ^ v2
		v0 += v3
		v3 = (v3<<21 | (v3>>43)&2097151) ^ v0
		v2 += v1
		v1 = (v1<<17 | (v1>>47)&131071) ^ v2
		v2 = (v2<<32 | (v2>>32)&4294967295)
		v0 ^= m
		i += 8
	}
	m := n << 56
	shift := 0
	for i < n {
		m |= i64(load8(p+i)) << shift
		shift += 8
		i++
	}
	v3 ^= m
	v0 += v1
	v1 = (v1<<13 | (v1>>51)&8191) ^ v0
	v0 = (v0<<32 | (v0>>32)&4294967295)
	v2 += v3
	v3 = (v3<<16 | (v3>>48)&65535) ^ v2
	v0 += v3
	v3 = (v3<<21 | (v3>>43)&2097151) ^ v0
	v2 += v1
	v1 = (v1<<17 | (v1>>47)&131071) ^ v2
	v2 = (v2<<32 | (v2>>32)&4294967295)
	v0 ^= m
	v2 ^= 0xff
	for r := 0; r < 3; r++ {
		v0 += v1
		v1 = (v1<<13 | (v1>>51)&8191) ^ v0
		v0 = (v0<<32 | (v0>>32)&4294967295)
		v2 += v3
		v3 = (v3<<16 | (v3>>48)&65535) ^ v2
		v0 += v3
		v3 = (v3<<21 | (v3>>43)&2097151) ^ v0
		v2 += v1
		v1 = (v1<<17 | (v1>>47)&131071) ^ v2
		v2 = (v2<<32 | (v2>>32)&4294967295)
	}
	return v0 ^ v1 ^ v2 ^ v3
}

// rt_hash_int mixes integer key k with the process's random key (the splitmix64 finalizer
// over k ^ key), so precomputed keys do not land in one probe run.
func rt_hash_int(k i64) i64 {
	h := k ^ rtHashK0
	h = (h ^ (h>>30)&0x3ffffffff) * 0xbf58476d1ce4e5b9
	h = (h ^ (h>>27)&0x1fffffffff) * 0x94d049bb133111eb
	return h ^ (h>>31)&0x1ffffffff
}

// rt_map_hash is key k's hash: rt_hash_str for str (and struct or enum) keys, else rt_hash_int.
func rt_map_hash(m i64, k i64) i64 {
	if m[5] != 0 {
		return rt_hash_str(cast(str, k))
	}
	return rt_hash_int(k)
}

// An index slot holds 0 (empty), -1 (deleted) or fp<<32 | entry+1, fp being 31 hash bits,
// so a probe compares keys only when the fingerprints match.
func rt_map_fp(h i64) i64 {
	return (h & 0x7fffffff) << 32
}

// rt_map_slot returns the index slot holding key k (hash h), or -1.
func rt_map_slot(m i64, k i64, h i64) i64 {
	mask := m[1] - 1
	idx := m[4]
	keys := m[2]
	fp := rt_map_fp(h)
	i := lsr(h, m[6])
	if m[5] != 0 {
		for {
			v := idx[i]
			if v == 0 {
				return -1
			}
			if v > 0 && v&-4294967296 == fp && rt_str_eq(cast(str, keys[(v&0xffffffff)-1]), cast(str, k)) {
				return i
			}
			i = (i + 1) & mask
		}
	}
	for {
		v := idx[i]
		if v == 0 {
			return -1
		}
		if v > 0 && v&-4294967296 == fp && keys[(v&0xffffffff)-1] == k {
			return i
		}
		i = (i + 1) & mask
	}
}

// rt_map_find returns the entry holding key k, or -1.
func rt_map_find(m i64, k i64) i64 {
	s := rt_map_slot(m, k, rt_map_hash(m, k))
	if s < 0 {
		return -1
	}
	return (m[4][s] & 0xffffffff) - 1
}

func rt_map_get(m i64, k i64) i64 {
	c := __ctx()
	if m == 0 {
		c[ctxFound] = 0
		return 0
	}
	sl := rt_map_slot(m, k, rt_map_hash(m, k))
	if sl < 0 {
		c[ctxFound] = 0
		return 0
	}
	c[ctxFound] = 1
	return m[3][(m[4][sl]&0xffffffff)-1]
}

func rt_map_found() bool {
	return __ctx()[ctxFound] != 0
}

// rt_map_index puts entry e (hash h) into the first free or deleted index slot.
func rt_map_index(m i64, e i64, h i64) {
	mask := m[1] - 1
	idx := m[4]
	i := lsr(h, m[6])
	for idx[i] > 0 {
		i = (i + 1) & mask
	}
	if idx[i] < 0 {
		m[7]--
	}
	idx[i] = rt_map_fp(h) | (e + 1)
}

// rt_map_grow rebuilds m with room for twice its live entries, keeping their order.
func rt_map_grow(m i64) {
	okeys := m[2]
	ovals := m[3]
	oidx := m[4]
	ohashes := m[8]
	olive := m[12]
	used := m[10]
	n := m[0]
	ec := 8
	for ec < (n+1)*2 {
		ec *= 2
	}
	rt_map_init(m, ec)
	for j := 0; j < used; j++ {
		if load8(olive+j) == 1 {
			e := m[10]
			m[2][e] = okeys[j]
			m[3][e] = ovals[j]
			store8(m[12]+e, 1)
			h := 0
			if m[5] != 0 {
				h = ohashes[j]
				m[8][e] = h
			} else {
				h = rt_map_hash(m, okeys[j])
			}
			rt_map_index(m, e, h)
			m[10] = e + 1
		}
	}
	m[0] = n
	// Map tables are never shared, so a long-lived map frees the old ones.
	if m[9] != 0 {
		rt_ingot_free(okeys)
		rt_ingot_free(ovals)
		rt_ingot_free(oidx)
		rt_ingot_free(olive)
		if ohashes != 0 {
			rt_ingot_free(ohashes)
		}
	}
}

func rt_map_set(m i64, k i64, v i64) {
	if m == 0 {
		rt_panic("assignment to entry in nil map")
	}
	if m[10] == m[11] {
		rt_map_grow(m)
	}
	h := rt_map_hash(m, k)
	fp := rt_map_fp(h)
	mask := m[1] - 1
	idx := m[4]
	keys := m[2]
	str_keys := m[5] != 0
	i := lsr(h, m[6])
	tomb := -1
	for {
		x := idx[i]
		if x == 0 {
			break
		}
		if x < 0 {
			if tomb < 0 {
				tomb = i
			}
		} else if x&-4294967296 == fp {
			e0 := (x & 0xffffffff) - 1
			if (str_keys && rt_str_eq(cast(str, keys[e0]), cast(str, k))) || (!str_keys && keys[e0] == k) {
				m[3][e0] = v
				return
			}
		}
		i = (i + 1) & mask
	}
	if tomb >= 0 {
		i = tomb
		m[7]--
	}
	e := m[10]
	keys[e] = k
	m[3][e] = v
	store8(m[12]+e, 1)
	if str_keys {
		m[8][e] = h
	}
	m[10] = e + 1
	m[0]++
	idx[i] = fp | (e + 1)
}

// rt_map_setk is rt_map_set for a key encoded as a str (a struct or enum key): the key's
// bytes are copied into the map's own region, so the map never refers to the caller's.
func rt_map_setk(m i64, k str, v i64) {
	if m == 0 {
		rt_panic("assignment to entry in nil map")
	}
	if rt_map_find(m, cast(i64, k)) < 0 {
		n := len(k)
		p := rt_region_alloc(m[9], n+9)
		p[0] = n
		memcpy(p+8, cast(i64, k)+8, n)
		k = cast(str, p)
	}
	rt_map_set(m, cast(i64, k), v)
}

// ---- map keys encoded as bytes (struct and enum keys compare by value) ----

// query is what an interpolated literal becomes where a query is wanted: the text pieces
// around each {value} and the values themselves, never pasted into the text. Database
// and cache clients take a query so a value cannot change a command's shape.
type query struct {
	Parts []str
	Args  []qarg
}

// qarg is one value of a query.
type qarg enum {
	Int(v i64)
	Float(v f64)
	Str(v str)
	Bool(v bool)
	Bytes(v []u8)
}

var kdOff i64 // per core: where rt_kd_* reads next

func rt_kb_new() i64 {
	return rt_slice_make(0, 32, 1)
}

// rt_kb_word appends v's 8 bytes to byte slice b.
func rt_kb_word(b i64, v i64) i64 {
	if b[0]+8 > b[1] {
		rt_slice_grow(b, b[0]+8, 1)
	}
	(b[2] + b[0])[0] = v
	b[0] += 8
	return b
}

// rt_kb_str appends s's length and bytes to byte slice b.
func rt_kb_str(b i64, s str) i64 {
	n := len(s)
	b = rt_kb_word(b, n)
	if b[0]+n > b[1] {
		rt_slice_grow(b, b[0]+n, 1)
	}
	memcpy(b[2]+b[0], cast(i64, s)+8, n)
	b[0] += n
	return b
}

func rt_kb_done(b i64) str {
	return rt_str_from_raw(b[2], b[0])
}

func rt_kd_begin() {
	kdOff = 0
}

func rt_kd_word(s str) i64 {
	v := (cast(i64, s) + 8 + kdOff)[0]
	kdOff += 8
	return v
}

func rt_kd_str(s str) str {
	n := rt_kd_word(s)
	r := rt_str_from_raw(cast(i64, s)+8+kdOff, n)
	kdOff += n
	return r
}

func rt_map_del(m i64, k i64) {
	if m == 0 {
		return
	}
	s := rt_map_slot(m, k, rt_map_hash(m, k))
	if s >= 0 {
		e := (m[4][s] & 0xffffffff) - 1
		store8(m[12]+e, 0)
		m[4][s] = -1
		m[0]--
		m[7]++
	}
}

// rt_map_slots is how many entries a range over m walks (live and deleted, in order).
func rt_map_slots(m i64) i64 {
	if m == 0 {
		return 0
	}
	return m[10]
}

func rt_map_live(m i64, i i64) bool {
	return load8(m[12]+i) == 1
}

func rt_map_key(m i64, i i64) i64 {
	return m[2][i]
}

func rt_map_val(m i64, i i64) i64 {
	return m[3][i]
}

// rt_map_len is the number of entries of m (0 for the zero map).
func rt_map_len(m i64) i64 {
	if m == 0 {
		return 0
	}
	return m[0]
}

// Key kinds for rt_map_order: how the stored key words compare.
const keySigned = 0
const keyStr = 1
const keyFloat = 2
const keyUnsigned = 3 // unsigned integers and bool

// rt_key_less orders two keys of a map the way Go's fmt prints them: numbers by value (unsigned
// above 2^63 as unsigned, floats as floats with NaN first), strings bytewise, false before true.
func rt_key_less(m i64, kind i64, a i64, b i64) bool {
	ka := rt_map_key(m, a)
	kb := rt_map_key(m, b)
	if kind == keyStr {
		return rt_str_cmp(cast(str, ka), cast(str, kb)) < 0
	}
	if kind == keyFloat {
		x := cast(f64, ka)
		y := cast(f64, kb)
		return x < y || (x != x && y == y)
	}
	if kind == keyUnsigned {
		return u64(ka) < u64(kb)
	}
	return ka < kb
}

// rt_map_order returns the live slots of m sorted by key, as an array of rt_map_len(m) words in
// the current request's memory. Printing a map is the only user, and it must not depend on the
// order the entries were added in.
func rt_map_order(m i64, kind i64) i64 {
	n := rt_map_len(m)
	order := rt_alloc(8*n + 8)
	k := 0
	for i := 0; i < rt_map_slots(m); i++ {
		if rt_map_live(m, i) {
			order[k] = i
			k++
		}
	}
	if n < 2 {
		return order
	}
	// Bottom-up merge sort (stable, O(n log n)): a map may be large.
	tmp := rt_alloc(8*n + 8)
	for width := 1; width < n; width *= 2 {
		for lo := 0; lo < n; lo += 2 * width {
			mid := lo + width
			if mid > n {
				mid = n
			}
			hi := lo + 2*width
			if hi > n {
				hi = n
			}
			i := lo
			j := mid
			o := lo
			for i < mid && j < hi {
				if rt_key_less(m, kind, order[j], order[i]) {
					tmp[o] = order[j]
					j++
				} else {
					tmp[o] = order[i]
					i++
				}
				o++
			}
			for i < mid {
				tmp[o] = order[i]
				i++
				o++
			}
			for j < hi {
				tmp[o] = order[j]
				j++
				o++
			}
		}
		for i := 0; i < n; i++ {
			order[i] = tmp[i]
		}
	}
	return order
}

// rt_order_at is word j of an array returned by rt_map_order.
func rt_order_at(order i64, j i64) i64 {
	return order[j]
}

// ---- formatting ----
//
// fmt calls compile to begin, one typed call per argument, then end. A frame holds the
// output bytes and, for Printf, the format and the verb the next argument gets.

const fPrev = 0
const fData = 1
const fLen = 2
const fCap = 3
const fFormat = 4
const fPos = 5
const fMode = 6     // 0 Printf, 1 Print, 2 Println
const fCount = 7
const fWasStr = 8
const fVerb = 9
const fWidth = 10
const fPrec = 11
const fMinus = 12
const fPlus = 13
const fZero = 14
const fSharp = 15
const fNest = 16
const fSpace = 17
const fPlusV = 18 // the verb is %+v: structs print their field names, and numbers get no + sign
const fWords = 19

func rt_frame() i64 {
	return __ctx()[ctxFmt]
}

func rt_fmt_push(mode i64) i64 {
	c := __ctx()
	f := rt_alloc(fWords * 8)
	f[fPrev] = c[ctxFmt]
	f[fMode] = mode
	f[fCap] = 64
	f[fData] = rt_alloc(64)
	c[ctxFmt] = f
	return f
}

func rt_fmt_begin(format str) {
	f := rt_fmt_push(0)
	f[fFormat] = cast(i64, format)
}

func rt_fmt_begin_v(ln i64) {
	rt_fmt_push(1 + ln)
}

func fb_reserve(f i64, n i64) {
	if f[fLen]+n <= f[fCap] {
		return
	}
	c := f[fCap] * 2
	for c < f[fLen]+n {
		c *= 2
	}
	d := rt_alloc(c)
	memcpy(d, f[fData], f[fLen])
	f[fData] = d
	f[fCap] = c
}

func fb_byte(f i64, b i64) {
	fb_reserve(f, 1)
	store8(f[fData]+f[fLen], b)
	f[fLen]++
}

func fb_raw(f i64, p i64, n i64) {
	if n <= 0 {
		return
	}
	fb_reserve(f, n)
	memcpy(f[fData]+f[fLen], p, n)
	f[fLen] += n
}

func fb_str(f i64, s str) {
	fb_raw(f, cast(i64, s)+8, len(s))
}

func fb_pad(f i64, n i64, c i64) {
	for n > 0 {
		fb_byte(f, c)
		n--
	}
}

// fmt_pad writes n bytes at p padded to the current verb's width.
func fmt_pad(f i64, p i64, n i64) {
	w := f[fWidth]
	if w <= n {
		fb_raw(f, p, n)
		return
	}
	if f[fMinus] != 0 {
		fb_raw(f, p, n)
		fb_pad(f, w-n, ' ')
		return
	}
	if f[fZero] != 0 {
		// Zero padding goes after the sign.
		if n > 0 && (load8(p) == '-' || load8(p) == '+') {
			fb_byte(f, i64(load8(p)))
			fb_pad(f, w-n, '0')
			fb_raw(f, p+1, n-1)
			return
		}
		fb_pad(f, w-n, '0')
		fb_raw(f, p, n)
		return
	}
	fb_pad(f, w-n, ' ')
	fb_raw(f, p, n)
}

// rt_fmt_next copies format text up to the next verb and parses it; 0 means none is left.
func rt_fmt_next(f i64) i64 {
	s := cast(str, f[fFormat])
	n := len(s)
	p := cast(i64, s) + 8
	i := f[fPos]
	for i < n {
		c := i64(load8(p + i))
		if c != '%' {
			start := i
			for i < n && load8(p+i) != '%' {
				i++
			}
			fb_raw(f, p+start, i-start)
			continue
		}
		if i+1 < n && load8(p+i+1) == '%' {
			fb_byte(f, '%')
			i += 2
			continue
		}
		i++
		f[fMinus] = 0
		f[fPlus] = 0
		f[fZero] = 0
		f[fSharp] = 0
		f[fSpace] = 0
		f[fPlusV] = 0
		for i < n {
			c = i64(load8(p + i))
			if c == '-' {
				f[fMinus] = 1
			} else if c == '+' {
				f[fPlus] = 1
			} else if c == '0' {
				f[fZero] = 1
			} else if c == '#' {
				f[fSharp] = 1
			} else if c == ' ' {
				f[fSpace] = 1
			} else {
				break
			}
			i++
		}
		w := 0
		for i < n && load8(p+i) >= '0' && load8(p+i) <= '9' {
			w = w*10 + i64(load8(p+i)) - '0'
			i++
		}
		f[fWidth] = w
		f[fPrec] = -1
		if i < n && load8(p+i) == '.' {
			i++
			pr := 0
			for i < n && load8(p+i) >= '0' && load8(p+i) <= '9' {
				pr = pr*10 + i64(load8(p+i)) - '0'
				i++
			}
			f[fPrec] = pr
		}
		verb := 'v'
		if i < n {
			verb = i64(load8(p + i))
			i++
		}
		f[fVerb] = verb
		f[fPos] = i
		return 1
	}
	f[fPos] = i
	return 0
}

// rt_fmt_arg starts one argument: the separator for Print/Println, or the next verb
// for Printf. It returns the verb to use.
func rt_fmt_arg(f i64, isstr bool) i64 {
	if f[fNest] != 0 {
		f[fWidth] = 0
		f[fPrec] = -1
		return 'v'
	}
	if f[fMode] == 0 {
		if rt_fmt_next(f) == 0 {
			fb_str(f, "%!(EXTRA ")
			f[fVerb] = 'v'
			f[fWidth] = 0
			f[fPrec] = -1
		}
		f[fCount]++
		if f[fVerb] == 'v' && f[fPlus] != 0 {
			// Go's %+v is not "%v with a sign": it clears the + flag and asks structs for field names.
			f[fPlusV] = 1
			f[fPlus] = 0
		}
		return f[fVerb]
	}
	if f[fCount] > 0 && (f[fMode] == 2 || (!isstr && f[fWasStr] == 0)) {
		fb_byte(f, ' ')
	}
	f[fCount]++
	if isstr {
		f[fWasStr] = 1
	} else {
		f[fWasStr] = 0
	}
	f[fWidth] = 0
	f[fPrec] = -1
	f[fMinus] = 0
	f[fZero] = 0
	f[fPlus] = 0
	return 'v'
}

// rt_fmt_plusv reports whether the current argument is formatted with %+v.
func rt_fmt_plusv() bool {
	return rt_frame()[fPlusV] != 0
}

func rt_fmt_close_extra(f i64) {
	if f[fMode] == 0 && f[fCount] > 0 && rt_fmt_extra(f) {
		fb_byte(f, ')')
	}
}

func rt_fmt_extra(f i64) bool {
	return false
}

// i64 formatting

func fmt_uint_buf(buf i64, v i64, base i64, upper bool) i64 {
	digits := "0123456789abcdef"
	if upper {
		digits = "0123456789ABCDEF"
	}
	dp := cast(i64, digits) + 8
	i := 64
	if v == 0 {
		i--
		store8(buf+i, '0')
		return i
	}
	for v != 0 {
		i--
		d := 0
		if base == 10 {
			// Unsigned division by ten, valid for the full 64-bit range.
			q := lsr(v, 1) / 5
			d = v - q*10
			v = q
		} else {
			d = v & (base - 1)
			shift := 4
			if base == 8 {
				shift = 3
			} else if base == 2 {
				shift = 1
			}
			v = lsr(v, shift)
		}
		store8(buf+i, i64(load8(dp+d)))
	}
	return i
}

func fmt_int(f i64, v i64, verb i64) {
	buf := rt_alloc(80)
	if verb == 'c' {
		n := rt_utf8_put(buf, v)
		fmt_pad(f, buf, n)
		return
	}
	if verb == 'q' {
		store8(buf, '\'')
		n := rt_utf8_put(buf+1, v)
		store8(buf+1+n, '\'')
		fmt_pad(f, buf, n+2)
		return
	}
	if verb == 'U' {
		store8(buf, 'U')
		store8(buf+1, '+')
		i := fmt_uint_buf(buf+8, v, 16, true)
		n := 64 - i
		for n < 4 {
			i--
			store8(buf+8+i, '0')
			n++
		}
		memmove(buf+2, buf+8+i, n)
		fmt_pad(f, buf, n+2)
		return
	}
	base := 10
	upper := false
	if verb == 'x' {
		base = 16
	} else if verb == 'X' {
		base = 16
		upper = true
	} else if verb == 'o' {
		base = 8
	} else if verb == 'b' {
		base = 2
	}
	neg := v < 0 && base == 10
	if neg {
		v = -v
	}
	i := fmt_uint_buf(buf+16, v, base, upper)
	if f[fPrec] >= 0 {
		for 64-i < f[fPrec] {
			i--
			store8(buf+16+i, '0')
		}
	}
	if f[fSharp] != 0 && base == 16 {
		i--
		store8(buf+16+i, 'x')
		i--
		store8(buf+16+i, '0')
	}
	if neg {
		i--
		store8(buf+16+i, '-')
	} else if f[fPlus] != 0 {
		i--
		store8(buf+16+i, '+')
	}
	fmt_pad(f, buf+16+i, 64-i)
}

func rt_fmt_i(v i64) {
	f := rt_frame()
	fmt_int(f, v, rt_fmt_arg(f, false))
}

func rt_fmt_p(v i64) {
	f := rt_frame()
	rt_fmt_arg(f, false)
	if v == 0 {
		fb_str(f, "<nil>")
		return
	}
	f[fSharp] = 1
	fmt_int(f, v, 'x')
}

func rt_fmt_b(b bool) {
	f := rt_frame()
	rt_fmt_arg(f, false)
	if b {
		fmt_pad(f, cast(i64, "true")+8, 4)
	} else {
		fmt_pad(f, cast(i64, "false")+8, 5)
	}
}

// fmt_quote_hex writes v as exactly n lower-case hex digits.
func fmt_quote_hex(f i64, v i64, n i64) {
	for k := (n - 1) * 4; k >= 0; k -= 4 {
		fb_byte(f, i64(load8(cast(i64, "0123456789abcdef")+8+(v>>k&15))))
	}
}

// rt_is_print reports whether Go's unicode.IsPrint accepts r beyond the ASCII space (bytes of
// rt_print_runs: merged runs, generated by tools/gen_unicode.py).
func rt_is_print(r i64) bool {
	if r < 0x7f {
		return r >= 0x20
	}
	runs := rt_print_runs()
	lo := 0
	hi := len(runs) / 6
	for lo < hi {
		m := (lo + hi) >> 1
		at := m * 6
		first := i64(runs[at]) | i64(runs[at+1])<<8 | i64(runs[at+2])<<16
		last := i64(runs[at+3]) | i64(runs[at+4])<<8 | i64(runs[at+5])<<16
		if r < first {
			hi = m
		} else if r > last {
			lo = m + 1
		} else {
			return true
		}
	}
	return false
}

// fmt_quote_rune writes the escape of one valid rune that is not printable, or is the quote or a
// backslash, in Go's quoted form.
func fmt_quote_rune(f i64, r i64) {
	if r == '"' || r == '\\' {
		fb_byte(f, '\\')
		fb_byte(f, r)
	} else if r == 7 {
		fb_str(f, "\\a")
	} else if r == 8 {
		fb_str(f, "\\b")
	} else if r == 12 {
		fb_str(f, "\\f")
	} else if r == '\n' {
		fb_str(f, "\\n")
	} else if r == '\r' {
		fb_str(f, "\\r")
	} else if r == '\t' {
		fb_str(f, "\\t")
	} else if r == 11 {
		fb_str(f, "\\v")
	} else if r < ' ' || r == 0x7f {
		fb_str(f, "\\x")
		fmt_quote_hex(f, r, 2)
	} else if r < 0x10000 {
		fb_str(f, "\\u")
		fmt_quote_hex(f, r, 4)
	} else {
		fb_str(f, "\\U")
		fmt_quote_hex(f, r, 8)
	}
}

// fmt_quote writes s as a Go double-quoted string: invalid UTF-8 bytes become \xHH and unprintable
// runes \u escapes, as strconv.Quote does.
func fmt_quote(f i64, s str) {
	fb_byte(f, '"')
	n := len(s)
	p := cast(i64, s) + 8
	i := 0
	for i < n {
		c := i64(load8(p + i))
		if c < 0x80 {
			i++
			if c >= 32 && c < 127 && c != '"' && c != '\\' {
				fb_byte(f, c)
			} else {
				fmt_quote_rune(f, c)
			}
			continue
		}
		d := rt_utf8(s, i)
		r := d & 0xffffffff
		w := d >> 32
		if w == 1 && r == 0xfffd {
			fb_str(f, "\\x")
			fmt_quote_hex(f, c, 2)
		} else if rt_is_print(r) {
			fb_raw(f, p+i, w)
		} else {
			fmt_quote_rune(f, r)
		}
		i += w
	}
	fb_byte(f, '"')
}

func fmt_string(f i64, s str, verb i64) {
	if verb == 'q' {
		fmt_quote(f, s)
		return
	}
	if verb == 'x' || verb == 'X' {
		digits := "0123456789abcdef"
		if verb == 'X' {
			digits = "0123456789ABCDEF"
		}
		for i := 0; i < len(s); i++ {
			fb_byte(f, i64(digits[i64(s[i])>>4]))
			fb_byte(f, i64(digits[i64(s[i])&15]))
		}
		return
	}
	n := len(s)
	if f[fPrec] >= 0 && f[fPrec] < n {
		n = f[fPrec]
	}
	fmt_pad(f, cast(i64, s)+8, n)
}

func rt_fmt_s(s str) {
	f := rt_frame()
	fmt_string(f, s, rt_fmt_arg(f, true))
}

func rt_fmt_e(e i64) {
	f := rt_frame()
	verb := rt_fmt_arg(f, false)
	if e == 0 {
		fb_str(f, "<nil>")
		return
	}
	fmt_string(f, cast(str, e), verb)
}

func rt_fmt_raw(s str) {
	fb_str(rt_frame(), s)
}

// rt_fmt_argsep starts a struct or map argument, whose parts are written raw.
func rt_fmt_argsep() {
	f := rt_frame()
	rt_fmt_arg(f, false)
	f[fNest]++
}

func rt_fmt_argend() {
	rt_frame()[fNest]--
}

// f64 formatting, through snprintf and a shortest round-trip search for %v.

// fmt_nonfinite prints NaN, +Inf or -Inf the way Go's fmt does for every float verb: NaN has no sign
// (+NaN with the + flag), infinities always do, and neither is padded with zeros. snprintf spells
// them "nan" and "inf", so they must not reach it. It reports whether x was one of them.
func fmt_nonfinite(f i64, x f64, verb i64) bool {
	if x == x && x <= 1.7976931348623157e308 && x >= -1.7976931348623157e308 {
		return false
	}
	text := "+Inf"
	if x != x {
		text = "NaN"
		if f[fPlus] != 0 {
			text = "+NaN"
		}
	} else if x < 0 {
		text = "-Inf"
	}
	zero := f[fZero]
	f[fZero] = 0
	fmt_pad(f, cast(i64, text)+8, len(text))
	f[fZero] = zero
	return true
}

func fmt_float_c(f i64, x f64, verb i64, prec i64) {
	buf := rt_alloc(400)
	cf := "%.*f"
	if verb == 'e' {
		cf = "%.*e"
	} else if verb == 'E' {
		cf = "%.*E"
	} else if verb == 'g' {
		cf = "%.*g"
	} else if verb == 'G' {
		cf = "%.*G"
	}
	n := snprintf(buf, 400, cast(i64, cf)+8, prec, x) & 0xffffffff
	if f[fPlus] != 0 && load8(buf) != '-' {
		memmove(buf+1, buf, n)
		store8(buf, '+')
		n++
	}
	fmt_pad(f, buf, n)
}

// fmt_shortest writes x with the fewest digits that read back exactly, laid out the way
// Go's %v does: exponent form when the exponent is below -4 or at least 21.
shared var fast_exp i64
var fmtScratch i64   // per core: digit buffers for float formatting (no allocation per number)

func fmt_scratch() i64 {
	if fmtScratch == 0 {
		fmtScratch = rt_ingot_alloc(128)
	}
	return fmtScratch
}

// short_digits finds the shortest decimal of x the quick way: the fewest decimals k with
// rint(|x| * 10^k) / 10^k == |x| (exact: both operands are integers below 2^53 or powers
// of ten, and IEEE division rounds correctly). It writes the digits and sets fast_exp,
// or returns 0 when x is out of its range (the slow path then decides).
func short_digits(x f64, digits i64) i64 {
	ax := x
	if ax < 0 {
		ax = -ax
	}
	if !(ax >= 1e-7 && ax < 1e15) {
		return 0
	}
	p := 1.0
	for k := 0; k <= 22; k++ {
		m := rint(ax * p)
		if m >= 9007199254740992.0 {
			return 0
		}
		if m/p == ax && m >= 1 {
			mi := i64(m)
			tmp := fmt_scratch() + 96
			n := 0
			for mi > 0 {
				store8(tmp+n, '0'+mi%10)
				mi /= 10
				n++
			}
			for i := 0; i < n; i++ {
				store8(digits+i, i64(load8(tmp+n-1-i)))
			}
			nd := n
			for nd > 1 && load8(digits+nd-1) == '0' {
				nd--
			}
			fast_exp = n - 1 - k
			return nd
		}
		p *= 10
	}
	return 0
}

// shortest_into writes the shortest decimal that reads back as x into out (400 bytes):
// exponent form when the exponent is below lo or at least hi; json drops the exponent's
// zero padding (1e-7, not 1e-07). It returns the length.
var shortF32 bool // per core: shortest_into finds the shortest digits for an f32, not an f64

func shortest_into(out i64, x f64, lo i64, hi i64, json bool, plus bool) i64 {
	if x != x {
		memcpy(out, cast(i64, "NaN")+8, 3)
		return 3
	}
	if x > 1.7976931348623157e308 || x < -1.7976931348623157e308 {
		if x > 0 {
			memcpy(out, cast(i64, "+Inf")+8, 4)
		} else {
			memcpy(out, cast(i64, "-Inf")+8, 4)
		}
		return 4
	}
	scratch := fmt_scratch()
	tmp := scratch
	digits := scratch + 64
	nd := 0
	exp := 0
	neg := cast(i64, x) < 0
	if x != 0 && !shortF32 {
		nd = short_digits(x, digits)
		if nd > 0 {
			exp = fast_exp
		}
	}
	if x == 0 {
		store8(digits, '0')
		nd = 1
	} else if nd == 0 {
		for p := 1; p <= 17; p++ {
			snprintf(tmp, 64, cast(i64, "%.*e")+8, p-1, x)
			back := strtod(tmp, 0)
			if shortF32 {
				back = f64(f32(back))
			}
			if back == x || p == 17 {
				// tmp is [-]d.ddde±XX
				q := tmp
				if load8(q) == '-' {
					q++
				}
				nd = 0
				for load8(q) != 'e' {
					if load8(q) != '.' {
						store8(digits+nd, i64(load8(q)))
						nd++
					}
					q++
				}
				q++
				sign := 1
				if load8(q) == '-' {
					sign = -1
				}
				q++
				for load8(q) >= '0' && load8(q) <= '9' {
					exp = exp*10 + i64(load8(q)) - '0'
					q++
				}
				exp *= sign
				break
			}
		}
		for nd > 1 && load8(digits+nd-1) == '0' {
			nd--
		}
	}
	n := 0
	if neg {
		store8(out, '-')
		n = 1
	} else if plus {
		store8(out, '+')
		n = 1
	}
	if exp < lo || exp >= hi {
		store8(out+n, i64(load8(digits)))
		n++
		if nd > 1 {
			store8(out+n, '.')
			n++
			memcpy(out+n, digits+1, nd-1)
			n += nd - 1
		}
		store8(out+n, 'e')
		n++
		e := exp
		if e < 0 {
			store8(out+n, '-')
			e = -e
		} else {
			store8(out+n, '+')
		}
		n++
		if e < 10 && !json {
			store8(out+n, '0')
			n++
		}
		if e >= 100 {
			store8(out+n, '0'+e/100)
			n++
			e %= 100
			store8(out+n, '0'+e/10)
			n++
		} else if e >= 10 {
			store8(out+n, '0'+e/10)
			n++
		}
		store8(out+n, '0'+e%10)
		n++
	} else if exp >= 0 {
		for i := 0; i <= exp; i++ {
			if i < nd {
				store8(out+n, i64(load8(digits+i)))
			} else {
				store8(out+n, '0')
			}
			n++
		}
		if nd > exp+1 {
			store8(out+n, '.')
			n++
			memcpy(out+n, digits+exp+1, nd-exp-1)
			n += nd - exp - 1
		}
	} else {
		store8(out+n, '0')
		store8(out+n+1, '.')
		n += 2
		for i := 0; i < -exp-1; i++ {
			store8(out+n, '0')
			n++
		}
		memcpy(out+n, digits, nd)
		n += nd
	}
	return n
}

func fmt_shortest(f i64, x f64, lo i64, hi i64) {
	out := rt_alloc(400)
	n := shortest_into(out, x, lo, hi, false, f[fPlus] != 0)
	fmt_pad(f, out, n)
}

// rt_float_json is x as encoding/json writes it (exponent below 1e-6 or from 1e21).
func rt_float_json(x f64) str {
	out := rt_alloc(400)
	n := shortest_into(out, x, -6, 21, true, false)
	return rt_str_from_raw(out, n)
}

func fmt_float(f i64, x f64, verb i64) {
	if fmt_nonfinite(f, x, verb) {
		return
	}
	if verb == 'v' || ((verb == 'g' || verb == 'G') && f[fPrec] < 0) {
		fmt_shortest(f, x, -4, 6)
		return
	}
	prec := f[fPrec]
	if prec < 0 {
		prec = 6
	}
	if verb != 'f' && verb != 'F' && verb != 'e' && verb != 'E' && verb != 'g' && verb != 'G' {
		verb = 'g'
	}
	fmt_float_c(f, x, verb, prec)
}

func rt_fmt_f(x f64) {
	f := rt_frame()
	fmt_float(f, x, rt_fmt_arg(f, false))
}

// rt_fmt_f32 prints an f32 like Go's float32: the shortest digits that read back as it.
func rt_fmt_f32(x f64) {
	f := rt_frame()
	shortF32 = true
	fmt_float(f, x, rt_fmt_arg(f, false))
	shortF32 = false
}

func rt_fmt_slf32(s []f32) {
	f := rt_frame()
	verb := rt_fmt_arg(f, false)
	shortF32 = true
	fb_byte(f, '[')
	for i, v := range s {
		if i > 0 {
			fb_byte(f, ' ')
		}
		fmt_float(f, f64(v), verb)
	}
	fb_byte(f, ']')
	shortF32 = false
}

// slices print as [a b c]

func rt_fmt_sli(s []i64) {
	f := rt_frame()
	verb := rt_fmt_arg(f, false)
	fb_byte(f, '[')
	for i, v := range s {
		if i > 0 {
			fb_byte(f, ' ')
		}
		fmt_int(f, v, verb)
	}
	fb_byte(f, ']')
}

func rt_fmt_slb(s []u8) {
	f := rt_frame()
	verb := rt_fmt_arg(f, false)
	if verb == 's' || verb == 'q' || verb == 'x' {
		fmt_string(f, rt_str_from_bytes(s), verb)
		return
	}
	fb_byte(f, '[')
	for i, v := range s {
		if i > 0 {
			fb_byte(f, ' ')
		}
		fmt_int(f, i64(v), verb)
	}
	fb_byte(f, ']')
}

func rt_fmt_sls(s []str) {
	f := rt_frame()
	verb := rt_fmt_arg(f, false)
	fb_byte(f, '[')
	for i, v := range s {
		if i > 0 {
			fb_byte(f, ' ')
		}
		fmt_string(f, v, verb)
	}
	fb_byte(f, ']')
}

func rt_fmt_slf(s []f64) {
	f := rt_frame()
	verb := rt_fmt_arg(f, false)
	fb_byte(f, '[')
	for i, v := range s {
		if i > 0 {
			fb_byte(f, ' ')
		}
		fmt_float(f, v, verb)
	}
	fb_byte(f, ']')
}

func rt_fmt_slt(s []bool) {
	f := rt_frame()
	rt_fmt_arg(f, false)
	fb_byte(f, '[')
	for i, v := range s {
		if i > 0 {
			fb_byte(f, ' ')
		}
		if v {
			fb_str(f, "true")
		} else {
			fb_str(f, "false")
		}
	}
	fb_byte(f, ']')
}

// rt_fmt_finish completes the frame (rest of the format, or the newline) and pops it.
func rt_fmt_finish() i64 {
	c := __ctx()
	f := c[ctxFmt]
	if f[fMode] == 0 {
		for rt_fmt_next(f) != 0 {
			fb_str(f, "%!")
			fb_byte(f, f[fVerb])
			fb_str(f, "(MISSING)")
		}
	} else if f[fMode] == 2 {
		fb_byte(f, '\n')
	}
	c[ctxFmt] = f[fPrev]
	return f
}

func rt_fmt_end() str {
	f := rt_fmt_finish()
	return rt_str_from_raw(f[fData], f[fLen])
}

func rt_fmt_out() {
	f := rt_fmt_finish()
	rt_out(f[fData], f[fLen])
}

func rt_fmt_err() i64 {
	f := rt_fmt_finish()
	s := rt_str_new(f[fLen])
	memcpy(s+8, f[fData], f[fLen])
	return s
}

// ---- keep: copies into the long-lived ingot heap ----

func rt_keep_str(s str) str {
	n := len(s)
	if n == 0 {
		return ""
	}
	p := rt_ingot_alloc(n + 9)
	p[0] = n
	memcpy(p+8, cast(i64, s)+8, n)
	return cast(str, p)
}

func rt_keep_raw(p i64, n i64) i64 {
	q := rt_ingot_alloc(n)
	memcpy(q, p, n)
	return q
}

func rt_keep_slice(s i64, esz i64) i64 {
	n := s[0]
	h := rt_ingot_alloc(32)
	h[0] = n
	h[1] = n
	h[3] = 1
	if n > 0 {
		h[2] = rt_ingot_alloc(n*esz + 8)
		memcpy(h[2], s[2], n*esz)
	}
	return h
}

func rt_keep_map_new(m i64) i64 {
	k := rt_ingot_alloc(104)
	k[5] = m[5]
	k[9] = 1
	rt_map_init(k, 8)
	return k
}

func rt_keep_closure(f i64) i64 {
	if f == 0 {
		return 0
	}
	k := f[1]
	if k == 0 {
		return f
	}
	if f[2+k] != 0 {
		// The compiler's keeper copies every captured variable by its type (#170).
		keeper := cast(func(i64) i64, f[2+k])
		return keeper(f)
	}
	// No captured variable holds a reference: copying the words is a full copy.
	desc := rt_ingot_alloc(8 * (3 + k))
	desc[0] = f[0]
	desc[1] = k
	desc[2+k] = 0
	for i := 0; i < k; i++ {
		old_cell := f[2+i]
		new_cell := rt_ingot_alloc(8)
		new_cell[0] = old_cell[0]
		desc[2+i] = new_cell
	}
	return desc
}

// ---- unsigned and sized-int formatting ----

func rt_fmt_u(v i64) {
	f := rt_frame()
	verb := rt_fmt_arg(f, false)
	if verb == 'd' || verb == 'v' {
		buf := rt_alloc(80)
		i := fmt_uint_buf(buf+16, v, 10, false)
		fmt_pad(f, buf+16+i, 64-i)
		return
	}
	fmt_int(f, v, verb)
}

func rt_fmt_slint(s i64, width i64, signed i64) {
	f := rt_frame()
	verb := rt_fmt_arg(f, false)
	fb_byte(f, '[')
	n := s[0]
	d := s[2]
	for i := i64(0); i < n; i++ {
		if i > 0 {
			fb_byte(f, ' ')
		}
		v := i64(0)
		if width == 1 {
			v = i64(load8(d + i))
		} else if width == 8 {
			v = d[i]
		} else if width == 2 {
			v = __ld(d+i*2, 1)
		} else {
			v = __ld(d+i*4, 2)
		}
		if signed != 0 && width < 8 {
			shift := 64 - 8*width
			v = (v << shift) >> shift
		}
		if signed == 0 && (verb == 'v' || verb == 'd') {
			buf := rt_alloc(80)
			j := fmt_uint_buf(buf+16, v, 10, false)
			fb_raw(f, buf+16+j, 64-j)
		} else {
			fmt_int(f, v, verb)
		}
	}
	fb_byte(f, ']')
}

func width_log(w i64) i64 {
	if w == 2 {
		return 1
	}
	if w == 4 {
		return 2
	}
	return 3
}

func rt_fmt_slp(s i64) {
	f := rt_frame()
	rt_fmt_arg(f, false)
	fb_byte(f, '[')
	n := s[0]
	d := s[2]
	for i := i64(0); i < n; i++ {
		if i > 0 {
			fb_byte(f, ' ')
		}
		f[fSharp] = 1
		fmt_int(f, d[i], 'x')
	}
	fb_byte(f, ']')
}

// ---- tasks: a stack per in-flight request, switched in user space ----
//
// A task runs a func(i64) on its own 256 KiB stack (a guard region below it faults on
// overflow) with its own request pool. rt_task_run switches into it from the core's own
// stack; the task runs until it finishes or waits (rt_task_yield), and then the core
// continues. rt_task_swap (hand-assembled by the compiler for each CPU) saves and loads
// only what a call preserves: callee-saved registers, frame pointer, return address and
// stack pointer. The core context register is the same on every task of a core.

extern func mmap(addr i64, n i64, prot i64, flags i64, fd i64, off i64) i64
extern func mprotect(addr i64, n i64, prot i64) i64

const taskStack = 262144
const taskGuard = 16384
const tSave = 0      // 20 words of registers (layout per CPU, see rt_task_init)
const tFn = 20
const tArg = 21
const tStack = 22    // the mapping: guard region, then the stack
const tDone = 23
const tPool = 24     // the task's pool words: bump, end, base, mark, extra
const tWake = 29     // waiting: when to resume (mono ns)
const tDeadline = 30 // 0, or when every wait of this task gives up (mono ns)
const tFault = 31    // why the last wait ended: 0 woken, 1 deadline
const tNext = 32     // free list link
const tUser = 33     // 6 words for the owner (anvil keeps its connection here)
const tGen = 40      // counts waits: a timer entry from an earlier wait is ignored
const tWaiting = 41  // 1 while the task waits
const tWaitFd = 42   // the descriptor it waits on, or -1
const tResult = 43   // how the wait ended: waitReady, waitDeadline or waitTimeout
const tFmt = 44      // this task's formatting frame stack
const tCleanup = 45  // LIFO cleanup records, run before their pool is reset
const taskWords = 48

const waitReady = 0
const waitDeadline = 1
const waitTimeout = 2

var curTask i64   // per core: the running task, 0 on the core's own stack
var schedSave i64 // per core: the core's own registers while a task runs
var schedPool i64 // per core: the core's own pool words and formatting stack while a task runs
var freeTasks i64 // per core: finished tasks, reused with their stacks
var timerHeap i64 // per core: a min-heap of [wake, task, gen] entries
var timerN i64
var timerCap i64
var waitHook func(i64, i64) // per core (set by a server): watch fd (1 read, 2 write) for curTask
var waitCancel func(i64)    // per core: stop watching fd
var doneFd i64              // per core: the pipe helper threads report finished jobs to (0: none)
var readyQ i64              // per core: tasks woken by another task, resumed by the event loop
var readyHead i64
var readyN i64
var readyCap i64

// rt_task_swap stores the running registers into from and continues with those in to.
func rt_task_swap(from i64, to i64) {
}

// rt_task_new makes a task that will run body(arg); rt_task_run starts it.
func rt_task_new(body func(i64), arg i64) i64 {
	t := freeTasks
	if t != 0 {
		freeTasks = t[tNext]
	} else {
		t = calloc(taskWords, 8)
		base := mmap(0, taskStack+taskGuard, 3, MAP_STACK, -1, 0)
		if base == -1 || base == 0 {
			rt_panic("cannot map a task stack")
		}
		mprotect(base, taskGuard, 0)
		t[tStack] = base
	}
	t[tFn] = cast(i64, body)
	t[tArg] = arg
	t[tDone] = 0
	t[tFault] = 0
	t[tDeadline] = 0
	t[tWake] = 0
	t[tNext] = 0
	t[tFmt] = 0
	t[tCleanup] = 0
	for i := 0; i < 20; i++ {
		t[tSave+i] = 0
	}
	rt_task_init(t, (t[tStack]+taskStack+taskGuard)&-16)
	return t
}

// rt_task_entry is where a new task starts: it runs its function, zeroes its pool and
// switches back for good (a reused task starts over from rt_task_new).
func rt_task_entry() {
	t := curTask
	f := cast(func(i64), t[tFn])
	f(t[tArg])
	rt_task_cleanups(0)
	rt_pool_reset()
	t[tDone] = 1
	rt_task_swap(t, schedSave)
}

// rt_task_run runs task t until it finishes (true) or waits (false).
func rt_task_run(t i64) bool {
	if schedSave == 0 {
		schedSave = calloc(20, 8)
		schedPool = calloc(6, 8)
	}
	c := __ctx()
	schedPool[0] = c[ctxBump]
	schedPool[1] = c[ctxEnd]
	schedPool[2] = c[ctxPoolBase]
	schedPool[3] = c[ctxPoolMark]
	schedPool[4] = c[ctxPoolExtra]
	schedPool[5] = c[ctxFmt]
	c[ctxBump] = t[tPool]
	c[ctxEnd] = t[tPool+1]
	c[ctxPoolBase] = t[tPool+2]
	c[ctxPoolMark] = t[tPool+3]
	c[ctxPoolExtra] = t[tPool+4]
	c[ctxFmt] = t[tFmt]
	curTask = t
	rt_task_swap(schedSave, t)
	curTask = 0
	t[tPool] = c[ctxBump]
	t[tPool+1] = c[ctxEnd]
	t[tPool+2] = c[ctxPoolBase]
	t[tPool+3] = c[ctxPoolMark]
	t[tPool+4] = c[ctxPoolExtra]
	t[tFmt] = c[ctxFmt]
	c[ctxBump] = schedPool[0]
	c[ctxEnd] = schedPool[1]
	c[ctxPoolBase] = schedPool[2]
	c[ctxPoolMark] = schedPool[3]
	c[ctxPoolExtra] = schedPool[4]
	c[ctxFmt] = schedPool[5]
	return t[tDone] != 0
}

// rt_task_yield switches from the running task back to the core; rt_task_run continues it.
func rt_task_yield() {
	t := curTask
	if t == 0 {
		rt_panic("rt_task_yield outside a task")
	}
	rt_task_swap(t, schedSave)
}

// rt_task_free returns a finished task (its stack and pool) for reuse.
func rt_task_free(t i64) {
	t[tNext] = freeTasks
	freeTasks = t
}

func rt_task_current() i64 {
	return curTask
}

// rt_task_cleanup registers a resource to release before the current task's pool ends.
// A scope also runs the cleanups registered inside it before resetting its pool.
func rt_task_cleanup(f func(i64), arg i64) {
	if curTask == 0 {
		return
	}
	r := calloc(3, 8)
	r[0] = curTask[tCleanup]
	r[1] = cast(i64, f)
	r[2] = arg
	curTask[tCleanup] = r
}

func rt_task_cleanups(stop i64) {
	if curTask == 0 {
		return
	}
	for curTask[tCleanup] != stop {
		r := curTask[tCleanup]
		curTask[tCleanup] = r[0]
		f := cast(func(i64), r[1])
		f(r[2])
		free(r)
	}
}

// A pool scope preserves the caller's objects while a stream processes short-lived
// messages in its own reusable pool. Formatting state belongs to the scope too.
func rt_pool_enter() i64 {
	c := __ctx()
	s := calloc(7, 8)
	s[0] = c[ctxBump]
	s[1] = c[ctxEnd]
	s[2] = c[ctxPoolBase]
	s[3] = c[ctxPoolMark]
	s[4] = c[ctxPoolExtra]
	s[5] = c[ctxFmt]
	if curTask != 0 {
		s[6] = curTask[tCleanup]
	}
	c[ctxBump] = 0
	c[ctxEnd] = 0
	c[ctxPoolBase] = 0
	c[ctxPoolMark] = 0
	c[ctxPoolExtra] = 0
	c[ctxFmt] = 0
	return s
}

func rt_pool_scope_reset(s i64) {
	rt_task_cleanups(s[6])
	rt_pool_reset()
	__ctx()[ctxFmt] = 0
}

func rt_pool_leave(s i64) {
	rt_pool_scope_reset(s)
	c := __ctx()
	free(c[ctxPoolBase])
	c[ctxBump] = s[0]
	c[ctxEnd] = s[1]
	c[ctxPoolBase] = s[2]
	c[ctxPoolMark] = s[3]
	c[ctxPoolExtra] = s[4]
	c[ctxFmt] = s[5]
	free(s)
}

// rt_heap_str copies a string out of any pool for a helper job or scope result.
func rt_heap_str(s str) i64 {
	p := calloc(1, len(s)+9)
	p[0] = len(s)
	memcpy(p+8, cast(i64, s)+8, len(s))
	return p
}

// rt_task_set_deadline makes every wait of task t give up at mono time at (0: never).
func rt_task_set_deadline(t i64, at i64) {
	t[tDeadline] = at
}

// rt_task_wait waits until fd is ready (want 1: readable, 2: writable; fd -1: no fd), the
// timeout passes (ns, 0: none) or the task's deadline comes. Inside a task the core runs
// other tasks meanwhile; outside one it blocks in poll. It returns waitReady, waitTimeout
// or waitDeadline.
func rt_task_wait(fd i64, want i64, timeout i64) i64 {
	t := curTask
	if t == 0 || (fd >= 0 && cast(i64, waitHook) == 0) {
		if fd < 0 {
			rt_sleep_ns(timeout)
			return waitTimeout
		}
		return rt_poll_wait(fd, want, timeout)
	}
	wake := -1
	t[tResult] = waitTimeout
	if timeout > 0 {
		wake = rt_mono_ns() + timeout
	}
	if t[tDeadline] > 0 && (wake < 0 || t[tDeadline] <= wake) {
		wake = t[tDeadline]
		t[tResult] = waitDeadline
	}
	t[tGen]++
	t[tWaiting] = 1
	t[tWaitFd] = fd
	if wake >= 0 {
		rt_timer_push(t, wake)
	}
	if fd >= 0 {
		waitHook(fd, want)
	}
	rt_task_yield()
	return t[tResult]
}

// rt_task_ready ends task t's wait because what it waited for happened; resume it next.
func rt_task_ready(t i64) {
	t[tWaiting] = 0
	t[tGen]++
	t[tResult] = waitReady
	t[tWaitFd] = -1
}

// rt_task_park waits until another task wakes this one (rt_task_wake), or timeout ns or
// the deadline pass. Only a task parks: on the core's own stack there is no one to wake it.
func rt_task_park(timeout i64) i64 {
	return rt_task_wait(-1, 0, timeout)
}

// rt_task_wake ends a parked task's wait; the event loop resumes it on its next turn.
func rt_task_wake(t i64) {
	if t[tWaiting] == 0 || t[tWaitFd] >= 0 {
		return
	}
	rt_task_ready(t)
	if readyHead+readyN == readyCap {
		if readyHead > 0 {
			memmove(readyQ, readyQ+8*readyHead, 8*readyN)
			readyHead = 0
		} else {
			readyCap = readyCap*2 + 64
			readyQ = realloc(readyQ, 8*readyCap)
		}
	}
	readyQ[readyHead+readyN] = t
	readyN++
}

// rt_task_defer lets the core finish what it is doing (the other events of this turn)
// before this task goes on; on the core's own stack it does nothing.
func rt_task_defer() {
	t := curTask
	if t == 0 {
		return
	}
	t[tGen]++
	t[tWaiting] = 1
	t[tWaitFd] = -1
	rt_task_wake(t)
	rt_task_yield()
}

// rt_task_take_ready returns the next woken task, or 0.
func rt_task_take_ready() i64 {
	if readyN == 0 {
		readyHead = 0
		return 0
	}
	t := readyQ[readyHead]
	readyHead++
	readyN--
	return t
}

// rt_task_ready_count is how many woken tasks wait to be resumed.
func rt_task_ready_count() i64 {
	return readyN
}

// rt_task_any_ready reports whether woken tasks wait to be resumed.
func rt_task_any_ready() bool {
	return readyN > 0
}

// rt_poll_wait blocks until fd is ready or timeout ns pass (0: no limit).
func rt_poll_wait(fd i64, want i64, timeout i64) i64 {
	pfd := rt_alloc(8)
	__st(pfd, fd, 2)
	if want == 1 {
		__st(pfd+4, 1, 1)
	} else {
		__st(pfd+4, 4, 1)
	}
	ms := -1
	if timeout > 0 {
		ms = (timeout + 999999) / 1000000
	}
	for {
		r := i64(i32(poll(pfd, 1, ms)))
		if r > 0 {
			return waitReady
		}
		if r == 0 {
			return waitTimeout
		}
		if rt_errno() != EINTR {
			return waitReady
		}
	}
}

// rt_task_sleep waits ns: inside a task the core runs other tasks meanwhile; outside one
// it blocks. It returns true when the task's deadline cut the wait short.
func rt_task_sleep(ns i64) bool {
	return rt_task_wait(-1, 0, ns) == waitDeadline
}

// rt_sleep_ns blocks the thread for ns.
func rt_sleep_ns(ns i64) {
	if ns <= 0 {
		return
	}
	ts := rt_alloc(32)
	ts[0] = ns / 1000000000
	ts[1] = ns % 1000000000
	for i64(i32(nanosleep(ts, ts+16))) != 0 {
		if rt_errno() != EINTR {
			return
		}
		ts[0] = ts[2]
		ts[1] = ts[3]
	}
}

func rt_timer_push(t i64, wake i64) {
	if timerN == timerCap {
		nc := timerCap * 2
		if nc < 64 {
			nc = 64
		}
		nh := calloc(nc*3, 8)
		if timerN > 0 {
			memcpy(nh, timerHeap, timerN*24)
			free(timerHeap)
		}
		timerHeap = nh
		timerCap = nc
	}
	i := timerN
	timerN++
	for i > 0 {
		p := (i - 1) / 2
		if timerHeap[3*p] <= wake {
			break
		}
		timerHeap[3*i] = timerHeap[3*p]
		timerHeap[3*i+1] = timerHeap[3*p+1]
		timerHeap[3*i+2] = timerHeap[3*p+2]
		i = p
	}
	timerHeap[3*i] = wake
	timerHeap[3*i+1] = t
	timerHeap[3*i+2] = t[tGen]
}

// rt_timer_next is when the earliest timer entry is due (mono ns), or -1.
func rt_timer_next() i64 {
	if timerN == 0 {
		return -1
	}
	return timerHeap[0]
}

// rt_timer_pop returns a task whose wait timed out by now (ending that wait), or 0. Entries
// left by waits that already ended another way are dropped.
func rt_timer_pop(now i64) i64 {
	for timerN > 0 && timerHeap[0] <= now {
		t := timerHeap[1]
		gen := timerHeap[2]
		timerN--
		w := timerHeap[3*timerN]
		lt := timerHeap[3*timerN+1]
		lg := timerHeap[3*timerN+2]
		i := 0
		for {
			l := 2*i + 1
			if l >= timerN {
				break
			}
			m := l
			if l+1 < timerN && timerHeap[3*(l+1)] < timerHeap[3*l] {
				m = l + 1
			}
			if timerHeap[3*m] >= w {
				break
			}
			timerHeap[3*i] = timerHeap[3*m]
			timerHeap[3*i+1] = timerHeap[3*m+1]
			timerHeap[3*i+2] = timerHeap[3*m+2]
			i = m
		}
		if timerN > 0 {
			timerHeap[3*i] = w
			timerHeap[3*i+1] = lt
			timerHeap[3*i+2] = lg
		}
		if gen == t[tGen] && t[tWaiting] != 0 {
			t[tWaiting] = 0
			t[tGen]++
			if t[tWaitFd] >= 0 {
				waitCancel(t[tWaitFd])
				t[tWaitFd] = -1
			}
			return t
		}
	}
	return 0
}

func rt_pipe(fds i64) i64 {
	return i64(i32(pipe(fds)))
}

// ---- helper threads: blocking calls (DNS, files) run here while the task waits ----

shared var helperQ i64    // wake pipe [read fd, non-blocking write fd]
shared var helperLock i64
shared var helperUp bool
shared var helperHead i64
shared var helperTail i64
shared var helperCount i64
const helperThreads = 4
const maxHelperJobs = 4096

const jNext = 0
const jFn = 1
const jArg = 2
const jTask = 3
const jDoneFd = 4
const jDrop = 5
const jGone = 6

// rt_helper_run waits for a blocking job within the request deadline. arg and all of
// its inputs must be heap-owned: a timed-out task can end before the helper does.
// On success the caller owns arg; on failure drop(arg) runs when the job finishes
// (or immediately if it could not be queued). Never resume a timed-out, reused task.
func rt_helper_run(f func(i64), arg i64, drop func(i64)) ! {
	t := curTask
	if t == 0 || doneFd == 0 {
		f(arg)
		return
	}
	if t[tDeadline] > 0 && rt_mono_ns() >= t[tDeadline] {
		drop(arg)
		fail "deadline exceeded"
	}
	rt_lock(&helperLock)
	if !helperUp {
		helperQ = calloc(2, 8)
		fds := calloc(2, 4)
		rt_pipe(fds)
		helperQ[0] = i64(i32(__ld(fds, 2)))
		helperQ[1] = i64(i32(__ld(fds+4, 2)))
		fcntl(helperQ[1], F_SETFL, O_NONBLOCK)
		free(fds)
		for i := 0; i < helperThreads; i++ {
			rt_spawn_core(rt_helper_main, i)
		}
		helperUp = true
	}
	if helperCount >= maxHelperJobs {
		rt_unlock(&helperLock)
		drop(arg)
		fail "helper queue is full"
	}
	job := calloc(7, 8)
	job[jFn] = cast(i64, f)
	job[jArg] = arg
	job[jTask] = t
	job[jDoneFd] = doneFd
	job[jDrop] = cast(i64, drop)
	if helperTail == 0 {
		helperHead = job
	} else {
		helperTail[jNext] = job
	}
	helperTail = job
	helperCount++
	rt_unlock(&helperLock)
	// A full pipe already has wakeups pending; workers drain the whole queue.
	b := calloc(1, 8)
	for write(helperQ[1], b, 1) < 0 && rt_errno() == EINTR {}
	free(b)
	r := rt_task_park(0)
	if r == waitDeadline {
		job[jGone] = 1
		fail "deadline exceeded"
	}
	free(job)
}

// Called on the owning core only: late results release their heap-owned inputs and
// outputs, without touching the task pointer (the task may already have been reused).
func rt_helper_done(job i64) i64 {
	rt_lock(&helperLock)
	helperCount--
	rt_unlock(&helperLock)
	if job[jGone] != 0 {
		drop := cast(func(i64), job[jDrop])
		drop(job[jArg])
		free(job)
		return 0
	}
	return job[jTask]
}

func rt_helper_take() i64 {
	rt_lock(&helperLock)
	job := helperHead
	if job != 0 {
		helperHead = job[jNext]
		if helperHead == 0 {
			helperTail = 0
		}
	}
	rt_unlock(&helperLock)
	return job
}

// Helpers drain all queued jobs after a wakeup, then report completions to their core.
func rt_helper_main(id i64) {
	buf := calloc(1, 8)
	for {
		if read(helperQ[0], buf, 1) != 1 {
			continue
		}
		job := rt_helper_take()
		for job != 0 {
			f := cast(func(i64), job[jFn])
			f(job[jArg])
			rt_pool_reset()
			buf[0] = job
			rt_write_all(job[jDoneFd], buf, 8)
			job = rt_helper_take()
		}
	}
}
