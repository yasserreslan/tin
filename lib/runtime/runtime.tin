// Tin runtime: memory, strings, slices, maps, formatting and program startup.
// Compiler-generated code calls these rt_ functions with raw words; x28 holds the
// current thread's context.
//
// Strings are pointers to [length word][bytes][NUL], slices to [len, cap, data], maps
// to an open-addressing table. Every reference type uses 0 for nil, and nil strings,
// slices and maps behave as empty.

extern fn rint(x f64) f64

// Core context words: x28 points here, and the core's globals follow (the compiler
// addresses global i at x28 + 8*(ctxWords+i), so every core has its own copy).
const ctxBump = 0
const ctxEnd = 1
const ctxFmt = 2
const ctxFound = 3
const ctxID = 4
const ctxArena = 5
const ctxIngot = 6      // 1 while initializers run: allocations go to the ingot heap
const ctxPoolBase = 7   // the core's first pool chunk
const ctxPoolMark = 8   // pool top in the first chunk once allocation moved past it
const ctxPoolExtra = 9  // overflow chunks and big blocks, freed at reset: [next, ...]
// Words 10 and 11 hold the Linux error and vector mode; 12..31 preserve global offsets.
const ctxPoll = 12
const ctxWatch = 13
const ctxRunGen = 14
const ctxWords = 32

const chunkSize = 4194304
const bigAlloc = 262144
const maxAlloc = 70368744177664 // 2^46 bytes: no single allocation may ask for more
const slabSize = 1048576

// rt_chunk is the request pool chunk size: chunkSize, or less when hearth lowered rtPoolChunk
// to fit the memory limit (see pool_tune in lib/hearth.tin).
fn rt_chunk() i64 {
	if rtPoolChunk != 0 {
		return rtPoolChunk
	}
	return chunkSize
}

shared mut rtArgc i64
shared mut rtArgv i64
shared mut rtOut i64      // stdout buffer: [len, cap, data]
shared mut rtOutTTY bool
shared mut rtOutLock i64
shared mut rtTLS i64      // number of per-core globals
shared mut rtCoreInit fn()
shared mut rtCores i64
shared mut rtCoresDone i64
shared mut rtHashK0 i64   // map hash key: random per process, so keys cannot be chosen to collide
shared mut rtWatchCores i64 // entries: context, previous generation, stopped, previous watch.
shared mut rtWatchCount i64
shared mut rtWatchCap i64
shared mut rtWatchLock i64
shared mut rtWatchStarted i64
shared mut rtPollsEnabled bool
shared mut rtWatchSignal i64 // Linux signalfd, published by anvil; never consumed here.
shared mut rtWatchGrace i64
shared mut rtWatchDrainAt i64
shared mut rtHashK1 i64

fn rt_init(argc i64, argv i64, ntls i64, coreinit fn()) {
	__set_ctx(0)
	rt_os_start(argc, argv)
	rt_memory_test_setup()
	rtTLS = ntls
	rtCoreInit = coreinit
	let ctx = rt_ctx_new(0)
	__set_ctx(ctx)
	rtCores = 1
	rtArgc = argc
	rtArgv = argv
	rtOut = calloc(3, 8)
	rtOut[1] = 65536
	rtOut[2] = malloc(65536)
	rtOutTTY = rt_isatty(1)
	rt_clock_setup()
	rt_random(&rtHashK0, 8)
	rt_random(&rtHashK1, 8)
	rt_altstack()
	rt_fault_handlers(cast(i64, rt_fault))
}

// ---- faults: a stack overflow or a bad access is reported, not a silent death (#175) ----

const altStackSize = 65536

// rt_altstack gives the calling thread a signal stack of its own, so rt_fault can run after
// this thread's stack overflowed (every thread: the main one and each core and helper).
fn rt_altstack() {
	if rt_altstack_ready() {
		return
	}
	let st = calloc(1, 32)
	rt_stack_t(st, calloc(1, altStackSize), altStackSize)
	rt_sys_sigaltstack(st, 0)
	free(st)
}

// rt_fault handles SIGSEGV and SIGBUS on the thread's signal stack. It only reads this core's
// current task, writes one line to stderr and exits: nothing it calls may allocate or lock.
// A fault inside a request task's guard region is that task's stack overflowing.
fn rt_fault(sig i64, info i64, uctx i64) {
	let addr = rt_fault_addr(info)
	// Output printed before the fault goes out first, unless the fault came while the output
	// lock was held (taking it then would never return).
	if __atomic_swap(&rtOutLock, 1) == 0 {
		rt_flush()
		rt_unlock(&rtOutLock)
	}
	let t = curTask
	if t != 0 && addr >= t[tStack] && addr < t[tStack]+taskGuard {
		rt_fault_say("\npanic: stack overflow in a request handler (a request task's stack is 256 KiB: deep or unbounded recursion?)\n")
	} else if sig == rt_sigbus() {
		rt_fault_say("\npanic: bus error (invalid memory access, or a thread stack overflow)\n")
	} else {
		rt_fault_say("\npanic: segmentation fault (invalid memory access, or a thread stack overflow)\n")
	}
	rt_sys__exit(2)
}

fn rt_fault_say(s str) {
	rt_sys_write(2, cast(i64, s)+8, len(s))
}

// rt_aligned_alloc returns n zeroed bytes on their own 128-byte cache lines (n is rounded up).
fn rt_aligned_alloc(n i64) i64 {
    n = (n+127)&-128
    // Contexts live for the process lifetime; a page mapping also aligns cache lines.
    return mem_map((n+rt_page_size()-1)&-rt_page_size(),MAP_STACK)
}

fn rt_ctx_new(id i64) i64 {
	// Each core writes its context on every allocation: keep it off other cores' lines.
	let ctx = rt_aligned_alloc((ctxWords + rtTLS) * 8)
	ctx[ctxID] = id
	ctx[ctxIngot] = 1
	ctx[11] = rt_memory_vector_mode()
	rt_lock(&rtWatchLock)
	if rtWatchCount == rtWatchCap {
		rtWatchCap = rtWatchCap*2 + 8
		let next = calloc(rtWatchCap, 32)
		if rtWatchCores != 0 {
			memcpy(next, rtWatchCores, 32*rtWatchCount)
			free(rtWatchCores)
		}
		rtWatchCores = next
	}
	let n = rtWatchCores + 32*rtWatchCount
	n[0] = ctx
	n[1] = 0
	n[2] = 0
	n[3] = 0
	rtWatchCount += 1
	rt_unlock(&rtWatchLock)
	return ctx
}

// rt_core_main is a new core's thread: its own context, its own globals, then entry(arg).
fn rt_core_main(p i64) i64 {
	__set_ctx(0)
	__set_ctx(rt_ctx_new(p[2]))
	rt_altstack()
	rt_core_qos(p[2])
	lifeCore = p[0] != cast(i64, rt_helper_main)
	rtCoreInit()
	__ctx()[ctxIngot] = 0
	if lifeCore {
		rt_life_core_start()
	}
	let entry = cast(fn(i64), p[0])
	entry(p[1])
	if lifeCore {
		rt_life_core_stop()
	}
	rt_flush_core()
	__atomic_add(&rtCoresDone, 1)
	return 0
}

fn rt_flush_core() {
	rt_lock(&rtOutLock)
	rt_flush()
	rt_unlock(&rtOutLock)
}

// rt_spawn_core starts a core running entry(arg) on its own thread with an 8 MiB stack.
fn rt_spawn_core(entry fn(i64), arg i64) {
	let p = calloc(4, 8)
	p[0] = cast(i64, entry)
	p[1] = arg
	p[2] = __atomic_add(&rtCores, 1)
	if !rt_thread_start(cast(i64, rt_core_main), p) {
		rt_panic("cannot start a core thread")
	}
}

// rt_poll_enable is emitted at startup only for a program compiled with -polls.
fn rt_poll_enable() {
	rtPollsEnabled = true
	rt_watch_start()
}

// rt_watch_start starts one process-wide watchdog only when cancellable work begins.
fn rt_watch_start() {
	if !rtPollsEnabled { return }
	if rtWatchStarted != 0 { return }
	if __atomic_swap(&rtWatchStarted, 1) != 0 { return }
	if !rt_thread_start(cast(i64, rt_watch_main), 0) {
		rt_panic("cannot start the watchdog thread")
	}
}

// rt_watch_main never touches boundary records; its own context contains no Tin globals.
fn rt_watch_main(arg i64) i64 {
	__set_ctx(rt_aligned_alloc((ctxWords + rtTLS)*8))
	rt_sig_block_term()
	let ts = calloc(2, 8)
	ts[1] = 1000000
	let pfd = calloc(1, 8)
	for {
		rt_sys_nanosleep(ts, 0)
		let now = rt_mono_ns()
		if rtWatchSignal > 0 && rtWatchDrainAt == 0 {
			__st(pfd, rtWatchSignal, 2)
			__st(pfd+4, 1, 1)
			if rt_sys_poll(pfd, 1, 0)&0xffffffff == 1 {
				rtWatchDrainAt = now + rtWatchGrace
			}
		}
		rt_lock(&rtWatchLock)
		mut i = 0
		for i < rtWatchCount {
			let n = rtWatchCores + 32*i
			let c = n[0]
			let gen = c[ctxRunGen]
			let watch = c[ctxWatch]
			mut stopped = watch == -1 || (watch > 0 && now >= watch)
			if rtWatchDrainAt > 0 && now >= rtWatchDrainAt { stopped = true }
			if gen == n[1] && stopped && n[2] != 0 && n[3] == watch {
				// Recheck the generation immediately before publishing a poll.
				if c[ctxRunGen] == gen { c[ctxPoll] = 1 }
			}
			n[1] = gen
			n[2] = 0
			if stopped { n[2] = 1 }
			n[3] = watch
			i += 1
		}
		rt_unlock(&rtWatchLock)
	}
	return 0
}

// rt_watch_update publishes the running boundary's effective deadline or cancellation.
fn rt_watch_update() {
	if !rtPollsEnabled { return }
	let b = rt_bnd_current()
	mut w = b[bDeadline]
	if b[bCancel] != 0 { w = -1 }
	__ctx()[ctxWatch] = w
}

// rt_watch_switch clears old polls and distinguishes this run from every previous one.
fn rt_watch_switch() {
	let c = __ctx()
	c[ctxRunGen] += 1
	c[ctxPoll] = 0
	rt_watch_update()
}

fn rt_core_id() i64 {
	return __ctx()[ctxID]
}

fn rt_exit() {
	rt_flush()
	rt_sys_exit(0)
}

// rt_main_begin ends initialization: from here allocations go to the request pool.
fn rt_main_begin() {
	__ctx()[ctxIngot] = 0
}

fn rt_bounds_fail() {
	rt_panic("index out of range")
}

fn rt_div_fail() {
	rt_panic("integer divide by zero")
}

// rt_bounds_fail2 is a failed bounds check with its index and length (Go's wording).
fn rt_bounds_fail2(i i64, n i64) {
	let b = rt_alloc(128)
	let text = "index out of range [" + rt_i64str(i) + "] with length " + rt_i64str(n)
	let k = len(text)
	memcpy(b, cast(i64, text)+8, k)
	rt_panic(rt_str_from_raw(b, k))
}

// rt_fail makes a fault: a record whose word points at the str holding the message (a fault is never nil).
fn rt_fail(msg str) i64 {
	return rt_fault_raw(cast(i64, msg)+8, len(msg), 0, 0)
}

// ---- fault records (notes/interface_faults.md) ----

// A fault word points at a str [len][bytes][NUL] holding the full message; the four words
// before it are the record: trace, joined, identity, cause (fault word p: p[-4] .. p[-1]).
const faultHead = 32
const fhTrace = 0
const fhJoined = 1
const fhIdent = 2
const fhCause = 3

// Identities of the runtime's standard sentinels (package fault); the compiler numbers
// package-level fault("...") sentinels from faultUserIdent up.
const faultCanceled = 1
const faultDeadline = 2
const faultLimit = 3
const faultOverloaded = 4
const faultDraining = 5
const faultPanic = 6
const faultUserIdent = 64

// rt_fault_raw makes a fault record from n message bytes at data, a cause and an identity.
fn rt_fault_raw(data i64, n i64, cause i64, ident i64) i64 {
	if n < 0 || n > maxAlloc {
		rt_panic("allocation size out of range")
	}
	let b = rt_alloc(faultHead + n + 9)
	b[fhIdent] = ident
	b[fhCause] = cause
	let p = b + faultHead
	p[0] = n
	memcpy(p+8, data, n)
	return p
}

// rt_fault_new makes a fault with message msg, a cause (0: none) and an identity (0: none).
fn rt_fault_new(msg str, cause i64, ident i64) i64 {
	return rt_fault_raw(cast(i64, msg)+8, len(msg), cause, ident)
}

// rt_fault_sentinel makes the value of a sentinel: package-level `var E = fault("msg")`.
fn rt_fault_sentinel(msg str, ident i64) i64 {
	return rt_fault_raw(cast(i64, msg)+8, len(msg), 0, ident)
}

mut faultStd i64 // per core: the runtime's sentinels by identity, made once in the ingot heap

// rt_fault_std is the runtime sentinel id with message msg: one record per core, in the
// ingot heap, so it outlives every request and boundary that holds it as a reason.
fn rt_fault_std(id i64, msg str) i64 {
	if faultStd == 0 {
		faultStd = rt_ingot_alloc(8 * faultUserIdent)
	}
	mut w = faultStd[id]
	if w == 0 {
		let n = len(msg)
		let b = rt_ingot_alloc(faultHead + n + 9)
		b[fhIdent] = id
		w = b + faultHead
		w[0] = n
		memcpy(w+8, cast(i64, msg)+8, n)
		faultStd[id] = w
	}
	return w
}

// rt_fault_canceled is fault.Canceled: a wait in a cancelled boundary.
fn rt_fault_canceled() i64 { return rt_fault_std(faultCanceled, "canceled") }

// rt_fault_deadline is fault.DeadlineExceeded: a wait past the task's deadline.
fn rt_fault_deadline() i64 { return rt_fault_std(faultDeadline, "deadline exceeded") }

// rt_fault_limit is fault.LimitExceeded: a budget or bounded value exceeded.
fn rt_fault_limit() i64 { return rt_fault_std(faultLimit, "limit exceeded") }

// rt_fault_over is fault.LimitExceeded for a value of length n over a bound of max (#240).
fn rt_fault_over(n i64, max i64) i64 {
	return rt_fault_wrap(rt_fault_limit(), "length " + rt_i64str(n) + " is over the bound " + rt_i64str(max))
}

// rt_fault_overloaded is fault.Overloaded: admission refused by load shedding.
fn rt_fault_overloaded() i64 { return rt_fault_std(faultOverloaded, "overloaded") }

// rt_fault_draining is fault.Draining: the cause of cancellations during a drain.
fn rt_fault_draining() i64 { return rt_fault_std(faultDraining, "draining") }

// rt_fault_panic is a panic converted to a fault (identity fault.Panic): its message and backtrace text.
fn rt_fault_panic(msg str, trace str) i64 {
	let p = rt_fault_raw(cast(i64, msg)+8, len(msg), 0, faultPanic)
	if len(trace) > 0 {
		let b = p - faultHead
		b[fhTrace] = rt_fault_raw(cast(i64, trace)+8, len(trace), 0, 0)
	}
	return p
}

// rt_fault_wrap is fault.Wrap: "msg: cause" with err as the cause; a nil err stays nil.
fn rt_fault_wrap(err i64, msg str) i64 {
	if err == 0 {
		return 0
	}
	let la = len(msg)
	let lb = err[0]
	let n = la + 2 + lb
	let b = rt_alloc(faultHead + n + 9)
	b[fhCause] = err
	let p = b + faultHead
	p[0] = n
	memcpy(p+8, cast(i64, msg)+8, la)
	store8(p+8+la, ':')
	store8(p+9+la, ' ')
	memcpy(p+10+la, err+8, lb)
	return p
}

// rt_fault_join is fault.Join: every non-nil fault of the []fault slice xs, reachable by
// fault.Is, the messages joined with newlines; nil when there are none.
fn rt_fault_join(xs i64) i64 {
	let n = xs[0]
	let d = xs[2]
	mut count = 0
	mut total = 0
	for i in 0..n {
		let e = d[i]
		if e != 0 {
			if count > 0 {
				total += 1
			}
			total += e[0]
			count += 1
		}
	}
	if count == 0 {
		return 0
	}
	let list = rt_alloc(8 * (count + 1))
	list[0] = count
	let b = rt_alloc(faultHead + total + 9)
	b[fhJoined] = list
	let p = b + faultHead
	p[0] = total
	mut at = p + 8
	mut k = 0
	for i in 0..n {
		let e = d[i]
		if e != 0 {
			if k > 0 {
				store8(at, '\n')
				at += 1
			}
			memcpy(at, e+8, e[0])
			at += e[0]
			k += 1
			list[k] = e
		}
	}
	return p
}

// rt_fault_is is fault.Is: whether err or any fault in its chain (causes and joined faults)
// is target, by identity for sentinels and by reference otherwise; a nil target matches only nil.
fn rt_fault_is(err i64, target i64) bool {
	if target == 0 {
		return err == 0
	}
	let tb = target - faultHead
	let id = tb[fhIdent]
	for err != 0 {
		if err == target {
			return true
		}
		let b = err - faultHead
		if id != 0 && b[fhIdent] == id {
			return true
		}
		let list = b[fhJoined]
		if list != 0 {
			{
				mut i = 1
				for i <= list[0] {
					if rt_fault_is(list[i], target) {
						return true
					}
					i += 1
				}
			}
		}
		err = b[fhCause]
	}
	return false
}

// rt_fault_cause is fault.Cause: the fault err wraps (nil for none, for nil and for a join).
fn rt_fault_cause(err i64) i64 {
	if err == 0 {
		return 0
	}
	let b = err - faultHead
	return b[fhCause]
}

// rt_fault_ident is the sentinel identity of err (0: none).
fn rt_fault_ident(err i64) i64 {
	if err == 0 {
		return 0
	}
	let b = err - faultHead
	return b[fhIdent]
}

// rt_fault_trace is the backtrace text of the first panic fault in err's chain ("" for none).
fn rt_fault_trace(err i64) str {
	for err != 0 {
		let b = err - faultHead
		if b[fhTrace] != 0 {
			return cast(str, b[fhTrace])
		}
		let list = b[fhJoined]
		if list != 0 {
			{
				mut i = 1
				for i <= list[0] {
					let t = rt_fault_trace(list[i])
					if len(t) > 0 {
						return t
					}
					i += 1
				}
			}
		}
		err = b[fhCause]
	}
	return ""
}

// rt_fault_copy copies err and its whole chain, to the ingot heap (keep, or across a pool
// scope: release it with rt_fault_free) or, ingot false, to the current pool.
fn rt_fault_copy(err i64, ingot bool) i64 {
	if err == 0 {
		return 0
	}
	let b = err - faultHead
	let size = faultHead + err[0] + 9
	mut q = 0
	if ingot {
		q = rt_ingot_alloc(size)
	} else {
		q = rt_alloc(size)
	}
	memcpy(q, b, size)
	q[fhCause] = rt_fault_copy(b[fhCause], ingot)
	q[fhTrace] = rt_fault_copy(b[fhTrace], ingot)
	let list = b[fhJoined]
	if list != 0 {
		let n = list[0]
		mut nl = 0
		if ingot {
			nl = rt_ingot_alloc(8 * (n + 1))
		} else {
			nl = rt_alloc(8 * (n + 1))
		}
		nl[0] = n
		{
			mut i = 1
			for i <= n {
				nl[i] = rt_fault_copy(list[i], ingot)
				i += 1
			}
		}
		q[fhJoined] = nl
	}
	return q + faultHead
}

// rt_fault_free releases a chain rt_fault_copy made on the ingot heap.
fn rt_fault_free(err i64) {
	if err == 0 {
		return
	}
	let b = err - faultHead
	rt_fault_free(b[fhCause])
	rt_fault_free(b[fhTrace])
	let list = b[fhJoined]
	if list != 0 {
		{
			mut i = 1
			for i <= list[0] {
				rt_fault_free(list[i])
				i += 1
			}
		}
		free(list)
	}
	free(b)
}

// rt_keep_fault is keep() of a fault: a deep copy in the long-lived heap, identities kept.
fn rt_keep_fault(err i64) i64 {
	return rt_fault_copy(err, true)
}

// ---- memory ----

// rt_alloc returns n zeroed bytes from the thread's bump chunk. Memory is never freed:
// programs and requests are short, and a bump pointer is the fastest allocator there is.
fn rt_alloc(n i64) i64 {
	let c = __ctx()
	if c[ctxIngot] != 0 {
		return rt_ingot_alloc(n)
	}
	n = (n + 15) & -16
	let p = c[ctxBump]
	if p+n > c[ctxEnd] {
		return rt_alloc_slow(n)
	}
	c[ctxBump] = p + n
	return p
}

fn rt_alloc_slow(n i64) i64 {
	if curTask != 0 && n > 65536 { curTask[tTrim] = 1 }
	let c = __ctx()
	if c[ctxPoolBase] != 0 {
		// Pool memory beyond the first chunk counts against limit budgets (#235).
		if n >= bigAlloc || n+16 > rt_chunk() {
			rt_bnd_charge(n + 16)
		} else {
			rt_bnd_charge(rt_chunk())
		}
	}
	if c[ctxPoolBase] == 0 {
		let chunk = calloc(1, rt_chunk())
		rt_pool_took(chunk, true)
		// The pool's first object starts at this heap block's payload: pin the chunk so
		// the long-lived counts never treat pool memory as theirs (#176).
		(chunk - 8)[0] = (chunk-8)[0] | rcPin
		c[ctxPoolBase] = chunk
		c[ctxBump] = chunk
		c[ctxEnd] = chunk + rt_chunk()
		// A first allocation that fits takes the base chunk; a big one still gets its own block.
		if n < bigAlloc && n <= rt_chunk() {
			c[ctxBump] = chunk + n
			return chunk
		}
	}
	if n >= bigAlloc || n+16 > rt_chunk() {
		if n > maxAlloc {
			rt_panic("allocation size out of range")
		}
		let b = calloc(1, n+16)
		if b == 0 {
			rt_panic("out of memory")
		}
		rt_pool_took(b, false)
		b[0] = c[ctxPoolExtra]
		c[ctxPoolExtra] = b
		return b + 16
	}
	if c[ctxPoolMark] == 0 {
		c[ctxPoolMark] = c[ctxBump]
	}
	let chunk = calloc(1, rt_chunk())
	rt_pool_took(chunk, false)
	chunk[0] = c[ctxPoolExtra]
	c[ctxPoolExtra] = chunk
	c[ctxBump] = chunk + 16 + n
	c[ctxEnd] = chunk + rt_chunk()
	return chunk + 16
}

// rt_pool_reset ends a request: the core's pool is zeroed back to empty in place. On the
// core's own stack that is a quiescent point for the limbo (#176): the request or tick
// that borrowed long-lived values has ended.
fn rt_pool_reset() {
	rt_pool_clear()
	if curTask == 0 {
		rt_epoch_quiescent()
	}
	rt_epoch_release()
}

// rt_pool_clear zeroes the current pool back to empty in place.
fn rt_pool_clear() {
	let c = __ctx()
	let base = c[ctxPoolBase]
	if base == 0 {
		return
	}
	mut top = c[ctxBump]
	if c[ctxPoolMark] != 0 {
		top = c[ctxPoolMark]
		{
			mut p = c[ctxPoolExtra]
			for p != 0 {
				let next = p[0]
				rt_pool_gave(p, false)
				free(p)
				p = next
			}
		}
		c[ctxPoolExtra] = 0
		c[ctxPoolMark] = 0
	} else if c[ctxPoolExtra] != 0 {
		{
			mut p = c[ctxPoolExtra]
			for p != 0 {
				let next = p[0]
				rt_pool_gave(p, false)
				free(p)
				p = next
			}
		}
		c[ctxPoolExtra] = 0
	}
	memset(base, 0, top-base)
	c[ctxBump] = base
	c[ctxEnd] = base + rt_chunk()
}

// rt_pool_used reports the bytes the current request has taken from the pool.
fn rt_pool_used() i64 {
	let c = __ctx()
	if c[ctxPoolMark] != 0 {
		return c[ctxPoolMark] - c[ctxPoolBase] + rt_chunk()
	}
	return c[ctxBump] - c[ctxPoolBase]
}

mut rtPoolFirst i64             // bytes of this core's pools' first chunks (mapped, mostly never touched) (#356)
mut rtPoolMore i64              // bytes of this core's pools beyond their first chunks: later chunks, big blocks
shared mut rtPoolFirstAll i64   // rtPoolFirst summed over the cores

// rt_pool_took counts pool block p (a pool's first chunk when first) in the memory signals
// anvil's admission reads (#356); rt_pool_gave takes it back before p is freed.
fn rt_pool_took(p i64, first bool) {
	let n = rt_memory_mapped(p)
	if first {
		rtPoolFirst += n
		__atomic_add(&rtPoolFirstAll, n)
	} else {
		rtPoolMore += n
	}
}

fn rt_pool_gave(p i64, first bool) {
	let n = rt_memory_mapped(p)
	if first {
		rtPoolFirst -= n
		__atomic_add(&rtPoolFirstAll, 0-n)
	} else {
		rtPoolMore -= n
	}
}

// rt_mem_held is the bytes every core's pools and long-lived heap hold from the OS, leaving
// out the pools' first chunks, which requests mostly never touch: what TIN_MEMORY_SOFT bounds.
fn rt_mem_held() i64 {
	return __atomic_load(&memoryMapped) - __atomic_load(&rtPoolFirstAll)
}

// rt_mem_pool is this core's request-pool bytes beyond each pool's first chunk (what
// TIN_REQUEST_MEMORY and limit blocks count).
fn rt_mem_pool() i64 {
	return rtPoolMore
}

// rt_mem_ingot is the bytes this core's long-lived heap holds: its slabs and large blocks,
// less the pools' chunks taken from it.
fn rt_mem_ingot() i64 {
	return rt_memory_heap_mapped() - rtPoolFirst - rtPoolMore
}

// rt_ingot_alloc returns zeroed memory from the owning core's mmap size-class heap. A
// block made while the core initializes its globals starts pinned (#176): globals'
// initial values are stored without counts, so they are never reclaimed.
fn rt_ingot_alloc(n i64) i64 {
	let p = calloc(1, n)
	let c = __ctx()
	if c != 0 && c[ctxIngot] != 0 {
		(p - 8)[0] = (p-8)[0] | rcPin
	}
	return p
}

// rt_ingot_free returns a block locally or queues it for its owning core.
fn rt_ingot_free(p i64) { free(p) }

// rt_region_alloc allocates in the ingot heap when ingot is 1, else in the pool.
fn rt_region_alloc(ingot i64, n i64) i64 {
	if ingot != 0 {
		return rt_ingot_alloc(n)
	}
	return rt_alloc(n)
}

// ---- long-lived reclamation: counts, the limbo and epochs (#176, notes/interface_mem.md) ----
//
// A block of this core's heap keeps its count of long-lived references in bits 47-61 of
// its size word (p-8; the size is bits 0-46), so the header stays 16 bytes and payloads
// stay 16-byte aligned. Counts are per core: rt_rc_* only touch blocks whose heap word is
// this core's heap, so static data, pool memory and other cores' blocks are left alone.
//
// rt_rc_dec never frees at once: a count of 0 queues the block in the core's limbo until
// everything that could have borrowed it has passed a quiescent point, so a request that
// read `u := cache[k]` keeps a valid u even if another request replaced the entry
// meanwhile. The participants are the live tasks (each with the epoch it inherited when
// it was made) and the core's own stack, whose quiescent points are the full pool resets
// it makes (the end of a request or tick, hearth.Reset). A queued block whose count
// rises again (a borrowed value stored once more) is dequeued: it is not garbage.
//
// A count that reaches rcPin stays there: the block is pinned and never freed. Blocks
// made while a core initializes its globals start pinned, and the compiler pins values
// it stores where it cannot count them (a store through a parameter), so an uncounted
// reference can leak a block but never outlive it.

mut epochNext i64    // per core: the current epoch; a block queued now is tagged with it
mut coreQ i64        // per core: the epoch the core's own stack began at its last quiescent point
mut epLive i64       // per core: live tasks, oldest epoch first
mut epLiveTail i64
mut limboHead i64    // per core: FIFO of [next, block, drop, epoch], epochs never fall
mut limboTail i64
mut rtRcBlocks i64   // per core: counted blocks this core owns (diagnostics, 14.1)
mut rtRcBytes i64
mut rtRcLimbo i64

const rcSize = (1 << 47) - 1      // the requested size
const rcOne = 1 << 47             // one long-lived reference
const rcCount = (1 << 62) - rcOne // the count's bits
const rcPin = rcCount             // a saturated count: pinned for good
const rcQ = 1 << 62               // set only while the block sits in the limbo
const limboMax = 1 << 20          // per core: past this many queued blocks, a drop pins instead

// rt_rc_mine reports whether p is a block of this core's heap, the only memory counted.
fn rt_rc_mine(p i64) bool {
	return p != 0 && memoryHeap != 0 && (p-16)[0] == memoryHeap
}

// rt_rc_drop_none is the drop of blocks with no children of their own (a str, a slice
// backing array whose elements moved on): releasing frees the block and nothing else.
fn rt_rc_drop_none(x i64) {
}

// rt_rc_inc notes one more long-lived reference to p. A queued block stored again is
// dequeued: it is not garbage.
fn rt_rc_inc(p i64) {
	if !rt_rc_mine(p) {
		return
	}
	let w = p - 8
	mut c = w[0]
	if (c & rcQ) != 0 {
		rt_rc_unqueue(p)
		c = w[0]
	}
	let k = c & rcCount
	if k == rcPin {
		return
	}
	if k == 0 {
		rtRcBlocks += 1
		rtRcBytes += c & rcSize
	}
	w[0] = c + rcOne
}

// rt_rc_pin keeps p for good: a value stored where its reference cannot be counted.
fn rt_rc_pin(p i64) {
	if !rt_rc_mine(p) {
		return
	}
	let w = p - 8
	if (w[0] & rcQ) != 0 {
		rt_rc_unqueue(p)
	}
	let k = w[0] & rcCount
	if k == 0 {
		rtRcBlocks += 1
		rtRcBytes += w[0] & rcSize
	}
	w[0] = (w[0] & rcSize) | rcPin
}

// rt_rc_pinned pins p and returns it: the value of a store the compiler cannot count.
fn rt_rc_pinned(p i64) i64 {
	rt_rc_pin(p)
	return p
}

// rt_rc_queue puts a block with no long-lived reference left in the core's limbo, to be
// dropped and freed when its epoch passes.
fn rt_rc_queue(p i64, drop fn(i64)) {
	let n = calloc(4, 8)
	n[1] = p
	n[2] = cast(i64, drop)
	n[3] = epochNext
	if limboTail == 0 {
		limboHead = n
	} else {
		limboTail[0] = n
	}
	limboTail = n
	rtRcLimbo += 1
}

// rt_rc_dec drops one long-lived reference: a count of 0 queues the block for the
// epoch limbo (drop runs at release, never now: the block may still be borrowed). A
// block with no count (never stored where it is counted, or already queued) and a
// pinned one are left as they are.
fn rt_rc_dec(p i64, drop fn(i64)) {
	if !rt_rc_mine(p) {
		return
	}
	let w = p - 8
	mut c = w[0]
	let k = c & rcCount
	if k == 0 || k == rcPin {
		return
	}
	c = c - rcOne
	if (c & rcCount) != 0 {
		w[0] = c
		return
	}
	if rtRcLimbo >= limboMax {
		// Release is held back (a long-lived task): leak the block as before #176 rather
		// than grow the limbo without bound.
		w[0] = (c & rcSize) | rcPin
		return
	}
	rtRcBlocks -= 1
	rtRcBytes -= c & rcSize
	w[0] = c | rcQ
	rt_rc_queue(p, drop)
}

// rt_rc_unqueue takes p, queued but stored again, out of the limbo (rare: a borrowed
// value that a long-lived slot takes over).
fn rt_rc_unqueue(p i64) {
	mut prev = i64(0)
	mut n = limboHead
	for n != 0 {
		if n[1] == p {
			if prev == 0 {
				limboHead = n[0]
			} else {
				prev[0] = n[0]
			}
			if limboTail == n {
				limboTail = prev
			}
			free(n)
			rtRcLimbo -= 1
			(p - 8)[0] = (p - 8)[0] - rcQ
			return
		}
		prev = n
		n = n[0]
	}
}

// rt_rc_drop_fresh releases p when nobody owns it: its count is 0 and it is not waiting
// in the limbo, so it was never published and its maker has finished with it (a map
// overwrite keeps the key it has, leaving the incoming one duplicate).
fn rt_rc_drop_fresh(p i64) {
	if !rt_rc_mine(p) {
		return
	}
	let w = p - 8
	if (w[0] & (rcQ | rcCount)) != 0 || rtRcLimbo >= limboMax {
		return
	}
	w[0] = w[0] | rcQ
	rt_rc_queue(p, rt_rc_drop_none)
}

// rt_rc_arr_n is the element count of a slice backing array block (a spare word ends it).
fn rt_rc_arr_n(p i64, esz i64) i64 {
	return (((p-8)[0] & rcSize) - 8) / esz
}

// rt_rc_stats reports this core's counted blocks, their bytes and the limbo length.
fn rt_rc_stats() (i64, i64, i64) {
	return rtRcBlocks, rtRcBytes, rtRcLimbo
}

// rt_rc_live_add links a task into the core's live list with epoch e. The list stays
// ordered oldest first: a child made by a running task inherits that task's epoch, which
// may be older than the tail's.
fn rt_rc_live_add(t i64, e i64) {
	t[tEp] = e
	mut after = epLiveTail
	for after != 0 && after[tEp] > e {
		after = after[tEpPrev]
	}
	t[tEpPrev] = after
	if after == 0 {
		t[tEpNext] = epLive
		epLive = t
	} else {
		t[tEpNext] = after[tEpNext]
		after[tEpNext] = t
	}
	if t[tEpNext] == 0 {
		epLiveTail = t
	} else {
		t[tEpNext][tEpPrev] = t
	}
}

// rt_rc_live_del unlinks t from the live list; a task not on it is left alone.
fn rt_rc_live_del(t i64) {
	if t[tEpPrev] == 0 && epLive != t {
		return
	}
	if t[tEpPrev] != 0 {
		t[tEpPrev][tEpNext] = t[tEpNext]
	} else {
		epLive = t[tEpNext]
	}
	if t[tEpNext] != 0 {
		t[tEpNext][tEpPrev] = t[tEpPrev]
	} else {
		epLiveTail = t[tEpPrev]
	}
	t[tEpNext] = 0
	t[tEpPrev] = 0
}

// rt_epoch_quiescent marks a quiescent point of the core's own stack: it holds no
// borrowed value from before this point, so what was queued until now waits only for
// the live tasks.
fn rt_epoch_quiescent() {
	epochNext = epochNext + 1
	coreQ = epochNext
}

// rt_epoch_release frees limbo entries that neither the core's own stack nor any live
// task can still reach: drop walks the block's children (queueing them now, at the
// current epoch), then the block itself is freed. Entries whose block was stored again
// are gone (rt_rc_inc dequeued them), so everything on the queue is dead.
fn rt_epoch_release() {
	for limboHead != 0 && limboHead[3] < coreQ && (epLive == 0 || limboHead[3] < epLive[tEp]) {
		let n = limboHead
		limboHead = n[0]
		if limboHead == 0 {
			limboTail = 0
		}
		rtRcLimbo -= 1
		let b = n[1]
		if n[2] != 0 {
			let drop = cast(fn(i64), n[2])
			drop(b)
		}
		rt_ingot_free(b)
		free(n)
	}
}

// lsr is a logical shift right (Tin's >> is arithmetic).
fn lsr(x i64, n i64) i64 {
	return (x >> n) & ((1 << (64 - n)) - 1)
}

// ---- output ----

fn rt_lock(p i64) {
	for __atomic_swap(p, 1) != 0 {
		__yield()
	}
}

fn rt_unlock(p i64) {
	__atomic_store(p, 0)
}

fn rt_write_all(fd i64, p i64, n i64) {
	for n > 0 {
		let w = rt_sys_write(fd, p, n)
		if w <= 0 {
			return
		}
		p += w
		n -= w
	}
}

fn rt_flush() {
	if rtOut == 0 {
		return
	}
	rt_write_all(1, rtOut[2], rtOut[0])
	rtOut[0] = 0
}

// rt_out appends n bytes to the stdout buffer, flushing at 64 KiB or, on a terminal,
// at every newline.
fn rt_out(p i64, n i64) {
	rt_lock(&rtOutLock)
	if rtOut[0]+n > rtOut[1] {
		rt_flush()
		if n > rtOut[1] {
			rt_write_all(1, p, n)
			rt_unlock(&rtOutLock)
			return
		}
	}
	memcpy(rtOut[2]+rtOut[0], p, n)
	rtOut[0] += n
	if rtOutTTY {
		rt_flush()
	}
	rt_unlock(&rtOutLock)
}

fn rt_panic(msg str) {
	let t = curTask
	if t != 0 && t[tRecover] != 0 {
		// A request task whose owner recovers (anvil): end only this task (#142).
		t[tRecover] = 0
		if __atomic_swap(&rtOutLock, 1) == 0 {
			rt_flush()
			rt_unlock(&rtOutLock)
		}
	} else {
		rt_flush()
	}
	let head = "panic: "
	rt_write_all(2, cast(i64, head)+8, len(head))
	rt_write_all(2, cast(i64, msg)+8, len(msg))
	rt_write_all(2, cast(i64, "\n")+8, 1)
	rt_backtrace(__fp())
	if t != 0 && t[tTape]&-2 != 0 {
		rt_tape_panic(t[tTape]&-2, msg) // the capsule keeps the first panic (#241)
	}
	{
		let g = rt_guard_target()
		if g != 0 {
			if t != 0 && t[tRecoverable] != 0 {
				t[tRecover] = 1
			}
			rt_guard_land(g, msg)
		}
	}
	if t != 0 && t[tPanicked] == 0 && t[tRecoverable] != 0 {
		t[tPanicked] = 1
		// A task root is an implicit guard (#230): a spawned child's fault is the panic with
		// its message, as a guard's is (its scope's pool holds it).
		if t[tChild] != 0 && t[tChild][spOwnPool] == 0 && t[tChild][spFault] == 0 {
			t[tChild][spFault] = rt_fault_panic("panic: "+msg, rt_backtrace_text(__fp()))
		}
		// Unwind (#230): deferred calls innermost first, then cleanups (rt_task_abort). A
		// panic while they run ends the process, after both messages.
		rt_defer_run(0)
		rt_task_abort(t)
	}
	rt_sys_exit(2)
}

// rt_backtrace prints the calling functions by walking the frame-pointer chain.
fn rt_backtrace(fp i64) {
	let info = calloc(4, 8)
	let core = rt_alloc(64)
	let text = "\ncore " + rt_i64str(rt_core_id()) + ":\n"
	let cn = len(text)
	memcpy(core, cast(i64, text)+8, cn)
	rt_write_all(2, core, cn)
	{
		mut k = 0
		for k < 64 && fp != 0 {
			let ret = fp[1]
			if ret == 0 {
				break
			}
			mut name = cast(i64, "?") + 8
			if rt_symbol_lookup(ret-4, info)&0xffffffff != 0 && info[2] != 0 {
				name = info[2]
				// Linux executables name Tin functions tin.<name> in their dynamic symbols.
				if load8(name) == 't' && load8(name+1) == 'i' && load8(name+2) == 'n' && load8(name+3) == '.' {
					name = name + 4
				}
			}
			// The program's entry ("main", which calls main.main) ends the user's frames.
			if load8(name) == 'm' && load8(name+1) == 'a' && load8(name+2) == 'i' && load8(name+3) == 'n' && load8(name+4) == 0 {
				break
			}
			let skip = load8(name) == 'r' && load8(name+1) == 't' && load8(name+2) == '_'
			if !skip {
				rt_write_all(2, cast(i64, "\t")+8, 1)
				rt_write_all(2, name, strlen(name))
				rt_write_all(2, cast(i64, "\n")+8, 1)
			}
			let next = fp[0]
			if next <= fp {
				break
			}
			fp = next
			k += 1
		}
	}
}

// rt_backtrace_text is rt_backtrace's list of functions as text, one per line: the
// backtrace a panic's fault carries (fault.Backtrace, #142).
fn rt_backtrace_text(fp i64) str {
	let info = calloc(4, 8)
	mut out = ""
	{
		mut k = 0
		for k < 64 && fp != 0 {
			let ret = fp[1]
			if ret == 0 {
				break
			}
			mut name = cast(i64, "?") + 8
			if rt_symbol_lookup(ret-4, info)&0xffffffff != 0 && info[2] != 0 {
				name = info[2]
				if load8(name) == 't' && load8(name+1) == 'i' && load8(name+2) == 'n' && load8(name+3) == '.' {
					name = name + 4
				}
			}
			if load8(name) == 'm' && load8(name+1) == 'a' && load8(name+2) == 'i' && load8(name+3) == 'n' && load8(name+4) == 0 {
				break
			}
			let skip = load8(name) == 'r' && load8(name+1) == 't' && load8(name+2) == '_'
			if !skip {
				if len(out) > 0 {
					out = out + "\n"
				}
				out = out + rt_str_from_raw(name, strlen(name))
			}
			let next = fp[0]
			if next <= fp {
				break
			}
			fp = next
			k += 1
		}
	}
	free(info)
	return out
}

fn rt_err_str(e i64) str {
	if e == 0 {
		return "<nil>"
	}
	return cast(str, e)
}

// ---- strings ----

fn rt_str_new(n i64) i64 {
	// A negative or huge n would wrap n + 9 (length word and NUL) into a bogus size.
	if n < 0 || n > maxAlloc {
		rt_panic("allocation size out of range")
	}
	let p = rt_alloc(n + 9)
	p[0] = n
	return p
}

fn rt_cstr(s str) i64 {
	if len(s) == 0 {
		return cast(i64, "") + 8
	}
	return cast(i64, s) + 8
}

fn rt_str_cat(a str, b str) str {
	let la = len(a)
	let lb = len(b)
	if la == 0 {
		return b
	}
	if lb == 0 {
		return a
	}
	let p = rt_str_new(la + lb)
	memcpy(p+8, cast(i64, a)+8, la)
	memcpy(p+8+la, cast(i64, b)+8, lb)
	return cast(str, p)
}

fn rt_str_eq(a str, b str) bool {
	let pa = cast(i64, a)
	let pb = cast(i64, b)
	if pa == pb {
		return true
	}
	let la = len(a)
	if la != len(b) {
		return false
	}
	if la == 0 {
		return true
	}
	if load8(pa+8) != load8(pb+8) {
		return false
	}
	return memcmp(pa+8, pb+8, la)&0xffffffff == 0
}

fn rt_str_cmp(a str, b str) i64 {
	let la = len(a)
	let lb = len(b)
	mut n = la
	if lb < n {
		n = lb
	}
	if n > 0 {
		let r = (memcmp(cast(i64, a)+8, cast(i64, b)+8, n) << 32) >> 32
		if r != 0 {
			return r
		}
	}
	return la - lb
}

fn rt_str_sub(s str, lo i64, hi i64, hasHi i64) str {
	let n = len(s)
	if hasHi == 0 {
		hi = n
	}
	if lo < 0 || hi > n || lo > hi {
		rt_panic("str slice out of range")
	}
	if lo == 0 && hi == n {
		return s
	}
	if hi == lo {
		return ""
	}
	let p = rt_str_new(hi - lo)
	memcpy(p+8, cast(i64, s)+8+lo, hi-lo)
	return cast(str, p)
}

fn rt_str_from_bytes(b []u8) str {
	let n = len(b)
	if n == 0 {
		return ""
	}
	let p = rt_str_new(n)
	memcpy(p+8, cast(i64, b)[2], n)
	return cast(str, p)
}

fn rt_str_from_raw(p i64, n i64) str {
	let s = rt_str_new(n)
	memcpy(s+8, p, n)
	return cast(str, s)
}

fn rt_bytes_from_str(s str) i64 {
	let n = len(s)
	let h = rt_slice_make(n, n, 1)
	if n > 0 {
		memcpy(h[2], cast(i64, s)+8, n)
	}
	return h
}

fn rt_str_from_rune(r i64) str {
	let p = rt_str_new(4)
	let n = rt_utf8_put(p+8, r)
	p[0] = n
	return cast(str, p)
}

// rt_utf8_put encodes rune r at p and returns its length in bytes.
fn rt_utf8_put(p i64, r i64) i64 {
	if r < 0 || r > 0x10ffff || (r >= 0xd800 && r <= 0xdfff) {
		r = 0xfffd
	}
	if r < 0x80 {
		store8(p, r)
		return 1
	}
	if r < 0x800 {
		store8(p, 0xc0|(r>>6))
		store8(p+1, 0x80|(r&63))
		return 2
	}
	if r < 0x10000 {
		store8(p, 0xe0|(r>>12))
		store8(p+1, 0x80|((r>>6)&63))
		store8(p+2, 0x80|(r&63))
		return 3
	}
	store8(p, 0xf0|(r>>18))
	store8(p+1, 0x80|((r>>12)&63))
	store8(p+2, 0x80|((r>>6)&63))
	store8(p+3, 0x80|(r&63))
	return 4
}

// rt_utf8 decodes the rune at byte i of s, returning rune | width<<32 (bad bytes are
// U+FFFD, width 1), which range loops over strings unpack.
fn rt_utf8(s str, i i64) i64 {
	let p = cast(i64, s) + 8 + i
	let n = len(s) - i
	let c = i64(load8(p))
	if c < 0x80 {
		return c | (1 << 32)
	}
	if c >= 0xc2 && c < 0xe0 && n >= 2 {
		let c1 = i64(load8(p + 1))
		if c1&0xc0 == 0x80 {
			return ((c&31)<<6 | (c1 & 63)) | (2 << 32)
		}
	}
	if c >= 0xe0 && c < 0xf0 && n >= 3 {
		let c1 = i64(load8(p + 1))
		let c2 = i64(load8(p + 2))
		if c1&0xc0 == 0x80 && c2&0xc0 == 0x80 {
			let r = (c&15)<<12 | (c1&63)<<6 | (c2 & 63)
			if r >= 0x800 && (r < 0xd800 || r > 0xdfff) {
				return r | (3 << 32)
			}
		}
	}
	if c >= 0xf0 && c < 0xf5 && n >= 4 {
		let c1 = i64(load8(p + 1))
		let c2 = i64(load8(p + 2))
		let c3 = i64(load8(p + 3))
		if c1&0xc0 == 0x80 && c2&0xc0 == 0x80 && c3&0xc0 == 0x80 {
			let r = (c&7)<<18 | (c1&63)<<12 | (c2&63)<<6 | (c3 & 63)
			if r >= 0x10000 && r <= 0x10ffff {
				return r | (4 << 32)
			}
		}
	}
	return 0xfffd | (1 << 32)
}

// ---- slices ----

fn rt_slice_make(n i64, c i64, esz i64) i64 {
	if n < 0 {
		rt_panic("make: negative length")
	}
	if c < n {
		c = n
	}
	if c > maxAlloc/esz {
		rt_panic("make: size out of range")
	}
	let ingot = __ctx()[ctxIngot]
	let h = rt_region_alloc(ingot, 32)
	h[0] = n
	h[1] = c
	h[3] = ingot
	if c > 0 {
		h[2] = rt_region_alloc(ingot, c*esz+8)
		if ingot != 0 {
			// The header owns its backing array's one count (#176).
			rt_rc_inc(h[2])
		}
	}
	return h
}

// rt_slice_make_str makes a []str of n "" elements (a str is never nil).
fn rt_slice_make_str(n i64, c i64) i64 {
	let h = rt_slice_make(n, c, 8)
	let e = cast(i64, "")
	let d = h[2]
	for i in 0..n {
		d[i] = e
	}
	return h
}

// rt_slice_make_nest makes a [][]T of n empty slices, each a header of its own.
fn rt_slice_make_nest(n i64, c i64, esz i64) i64 {
	let h = rt_slice_make(n, c, 8)
	let d = h[2]
	for i in 0..n {
		d[i] = rt_slice_make(0, 0, esz)
	}
	return h
}

// rt_slice_make_grid makes an [n][m]T: n rows of m zero elements ("" for strs).
fn rt_slice_make_grid(n i64, m i64, esz i64, isstr i64) i64 {
	let h = rt_slice_make(n, n, 8)
	let d = h[2]
	for i in 0..n {
		if isstr != 0 {
			d[i] = rt_slice_make_str(m, m)
		} else {
			d[i] = rt_slice_make(m, m, esz)
		}
	}
	return h
}

// rt_slice_grow gives s room for need elements, in the region s lives in. A long-lived
// slice's old backing array drops its count (its elements moved: their owners are the
// new array now, so nothing walks them) and the new array takes one from the header.
fn rt_slice_grow(s i64, need i64, esz i64) {
	mut c = s[1] * 2
	if c < 8 {
		c = 8
	}
	if need < 0 || need > maxAlloc/esz {
		rt_panic("append: size out of range")
	}
	for c < need {
		c *= 2
	}
	let old = s[2]
	// A view into a long-lived array (s[3] == 2) grows into the pool: it owns nothing.
	let d = rt_region_alloc(s[3] & 1, c*esz+8)
	if s[0] > 0 {
		memcpy(d, old, s[0]*esz)
	}
	s[2] = d
	s[1] = c
	if s[3] == 1 {
		if old != 0 {
			rt_rc_dec(old, rt_rc_drop_none)
		}
		rt_rc_inc(d)
	} else {
		s[3] = 0
	}
}

// rt_own returns a header append may change: the shared empty header (cap 0) is copied.
fn rt_own(s i64, esz i64) i64 {
	if s == cast(i64, __empty()) {
		return rt_slice_make(0, 0, esz)
	}
	return s
}

fn rt_store_elem(p i64, v i64, esz i64) {
	if esz == 8 {
		p[0] = v
	} else if esz == 1 {
		store8(p, v)
	} else if esz == 4 {
		__st(p, v, 2)
	} else {
		__st(p, v, 1)
	}
}

fn rt_append(s i64, v i64, esz i64) i64 {
	s = rt_own(s, esz)
	let n = s[0]
	if n >= s[1] {
		rt_slice_grow(s, n+1, esz)
	}
	rt_store_elem(s[2]+n*esz, v, esz)
	s[0] = n + 1
	return s
}

// rt_append_rc is rt_append for a slice whose element type is counted (#176): the new
// element gains the count of the slot it lands in. The slice's own region word decides,
// so a request-local slice pays nothing.
fn rt_append_rc(s i64, v i64, esz i64) i64 {
	s = rt_own(s, esz)
	let n = s[0]
	if n >= s[1] {
		rt_slice_grow(s, n+1, esz)
	}
	rt_store_elem(s[2]+n*esz, v, esz)
	s[0] = n + 1
	if s[3] != 0 {
		rt_rc_inc(v)
	}
	return s
}

// rt_append_dyn appends the two-word object/table representation without routing it
// through the one-word element store used by rt_append.
fn rt_append_dyn(s i64, object i64, table i64) i64 {
	s = rt_own(s, 16)
	let n = s[0]
	if n >= s[1] {
		rt_slice_grow(s, n+1, 16)
	}
	let p = s[2] + n*16
	p[0] = object
	p[1] = table
	s[0] = n + 1
	return s
}

fn rt_slice_appendn(s i64, t i64, esz i64) i64 {
	if t[0] == 0 {
		return s
	}
	s = rt_own(s, esz)
	let n = s[0]
	let need = n + t[0]
	if need > s[1] {
		rt_slice_grow(s, need, esz)
	}
	memmove(s[2]+n*esz, t[2], t[0]*esz)
	s[0] = need
	return s
}

// rt_slice_appendn_rc is append(s, t...) for a counted element type (#176): each value
// that lands in a long-lived array gains its slot's count.
fn rt_slice_appendn_rc(s i64, t i64, esz i64) i64 {
	let n = s[0]
	s = rt_slice_appendn(s, t, esz)
	if s[3] != 0 {
		for i in n..s[0] {
			rt_rc_inc(s[2][i])
		}
	}
	return s
}

fn rt_append_str(s i64, txt str) i64 {
	let m = len(txt)
	if m == 0 {
		return s
	}
	s = rt_own(s, 1)
	let n = s[0]
	if n+m > s[1] {
		rt_slice_grow(s, n+m, 1)
	}
	memcpy(s[2]+n, cast(i64, txt)+8, m)
	s[0] = n + m
	return s
}

fn rt_slice_sub(s i64, lo i64, hi i64, esz i64, hasHi i64) i64 {
	if hasHi == 0 {
		hi = s[0]
	}
	if lo < 0 || hi > s[0] || lo > hi {
		rt_panic("slice bounds out of range")
	}
	let h = rt_alloc(32)
	h[0] = hi - lo
	h[1] = s[1] - lo
	h[2] = s[2] + lo*esz
	// A sub-slice header is a request-local view (#176): it never owns the backing array,
	// but region 2 remembers that the array is long-lived, so a store through the view
	// still counts the value it leaves there.
	h[3] = 0
	if s[3] != 0 {
		h[3] = 2
	}
	return h
}

fn rt_slice_copy(dst i64, src i64, esz i64) i64 {
	mut n = dst[0]
	if src[0] < n {
		n = src[0]
	}
	memmove(dst[2], src[2], n*esz)
	return n
}

// rt_slice_copy_rc is copy for a counted element type (#176): into a long-lived array,
// each value copied in gains its slot's count and each value it replaces loses one (the
// incs come first, so a value copied over itself keeps its count).
fn rt_slice_copy_rc(dst i64, src i64, esz i64, drop fn(i64)) i64 {
	mut n = dst[0]
	if src[0] < n {
		n = src[0]
	}
	if dst[3] != 0 {
		for i in 0..n {
			rt_rc_inc(src[2][i])
		}
		for i in 0..n {
			rt_rc_dec(dst[2][i], drop)
		}
	}
	memmove(dst[2], src[2], n*esz)
	return n
}

fn rt_copy_str(dst i64, s str) i64 {
	mut n = dst[0]
	if len(s) < n {
		n = len(s)
	}
	memmove(dst[2], cast(i64, s)+8, n)
	return n
}

// ---- maps ----
//
// Insertion-ordered: entries are appended to arrays (keys, values, cached str hashes, a
// live byte each) and found through an open-addressing index of entry numbers (0 empty,
// -1 deleted, else entry+1) with a keyed hash (rt_map_hash) and linear probing. The index has twice
// as many slots as there are entries, so it is never more than half full. Header words:
// count, index slots, keys, values, index, str keys?, shift, index tombstones, hashes,
// ingot, entries used, entry capacity, live bytes, value drop, counted sides (#176).

fn rt_map_make(isstr i64) i64 {
	let ingot = __ctx()[ctxIngot]
	let m = rt_region_alloc(ingot, 120)
	m[5] = isstr
	m[9] = ingot
	rt_map_init(m, 8)
	return m
}

// rt_map_make_rc makes a map whose entries own counted keys and values (#176): counted
// bit 0 the key side (str and encoded struct or enum keys), bit 1 the value side, with
// drop the value's drop (the key side's blocks never have children of their own). An
// uncounted side passes the runtime's own no-op drop; the gates skip it.
fn rt_map_make_rc(isstr i64, drop fn(i64), counted i64) i64 {
	let ingot = __ctx()[ctxIngot]
	let m = rt_region_alloc(ingot, 120)
	m[5] = isstr
	m[9] = ingot
	m[13] = cast(i64, drop)
	m[14] = counted
	rt_map_init(m, 8)
	return m
}

// rt_map_init gives m room for ec entries (an index of 2*ec slots), empty.
fn rt_map_init(m i64, ec i64) {
	let ic = ec * 2
	m[0] = 0
	m[1] = ic
	m[2] = rt_region_alloc(m[9], ec*8)
	m[3] = rt_region_alloc(m[9], ec*8)
	m[4] = rt_region_alloc(m[9], ic*8)
	mut shift = 64
	{
		mut x = ic
		for x > 1 {
			shift -= 1
			x >>= 1
		}
	}
	m[6] = shift
	m[7] = 0
	m[8] = 0
	if m[5] != 0 {
		m[8] = rt_region_alloc(m[9], ec*8)
	}
	m[10] = 0
	m[11] = ec
	m[12] = rt_region_alloc(m[9], ec)
}

// rt_hash_str is SipHash-1-3 of s keyed with the process's random key, so a client cannot
// pick keys that collide in a map (hash flooding).
fn rt_hash_str(s str) i64 {
	let n = len(s)
	let p = cast(i64, s) + 8
	mut v0 = rtHashK0 ^ 0x736f6d6570736575
	mut v1 = rtHashK1 ^ 0x646f72616e646f6d
	mut v2 = rtHashK0 ^ 0x6c7967656e657261
	mut v3 = rtHashK1 ^ 0x7465646279746573
	mut i = 0
	for i+8 <= n {
		let m = (p + i)[0]
		v3 ^= m
		v0 += v1
		v1 = (v1<<13 | (v1>>51)&8191) ^ v0
		v0 = (v0<<32 | (v0>>32)&4294967295)
		v2 += v3
		v3 = (v3<<16 | (v3>>48)&65535) ^ v2
		v0 += v3
		v3 = (v3<<21 | (v3>>43)&2097151) ^ v0
		v2 += v1
		v1 = (v1<<17 | (v1>>47)&131071) ^ v2
		v2 = (v2<<32 | (v2>>32)&4294967295)
		v0 ^= m
		i += 8
	}
	mut m = n << 56
	mut shift = 0
	for i < n {
		m |= i64(load8(p+i)) << shift
		shift += 8
		i += 1
	}
	v3 ^= m
	v0 += v1
	v1 = (v1<<13 | (v1>>51)&8191) ^ v0
	v0 = (v0<<32 | (v0>>32)&4294967295)
	v2 += v3
	v3 = (v3<<16 | (v3>>48)&65535) ^ v2
	v0 += v3
	v3 = (v3<<21 | (v3>>43)&2097151) ^ v0
	v2 += v1
	v1 = (v1<<17 | (v1>>47)&131071) ^ v2
	v2 = (v2<<32 | (v2>>32)&4294967295)
	v0 ^= m
	v2 ^= 0xff
	for r in 0..3 {
		v0 += v1
		v1 = (v1<<13 | (v1>>51)&8191) ^ v0
		v0 = (v0<<32 | (v0>>32)&4294967295)
		v2 += v3
		v3 = (v3<<16 | (v3>>48)&65535) ^ v2
		v0 += v3
		v3 = (v3<<21 | (v3>>43)&2097151) ^ v0
		v2 += v1
		v1 = (v1<<17 | (v1>>47)&131071) ^ v2
		v2 = (v2<<32 | (v2>>32)&4294967295)
	}
	return v0 ^ v1 ^ v2 ^ v3
}

// rt_hash_int mixes integer key k with the process's random key (the splitmix64 finalizer
// over k ^ key), so precomputed keys do not land in one probe run.
fn rt_hash_int(k i64) i64 {
	mut h = k ^ rtHashK0
	h = (h ^ (h>>30)&0x3ffffffff) * 0xbf58476d1ce4e5b9
	h = (h ^ (h>>27)&0x1fffffffff) * 0x94d049bb133111eb
	return h ^ (h>>31)&0x1ffffffff
}

// rt_map_hash is key k's hash: rt_hash_str for str (and struct or enum) keys, else rt_hash_int.
fn rt_map_hash(m i64, k i64) i64 {
	if m[5] != 0 {
		return rt_hash_str(cast(str, k))
	}
	return rt_hash_int(k)
}

// An index slot holds 0 (empty), -1 (deleted) or fp<<32 | entry+1, fp being 31 hash bits,
// so a probe compares keys only when the fingerprints match.
fn rt_map_fp(h i64) i64 {
	return (h & 0x7fffffff) << 32
}

// rt_map_slot returns the index slot holding key k (hash h), or -1.
fn rt_map_slot(m i64, k i64, h i64) i64 {
	let mask = m[1] - 1
	let idx = m[4]
	let keys = m[2]
	let fp = rt_map_fp(h)
	mut i = lsr(h, m[6])
	if m[5] != 0 {
		for {
			let v = idx[i]
			if v == 0 {
				return -1
			}
			if v > 0 && v&-4294967296 == fp && rt_str_eq(cast(str, keys[(v&0xffffffff)-1]), cast(str, k)) {
				return i
			}
			i = (i + 1) & mask
		}
	}
	for {
		let v = idx[i]
		if v == 0 {
			return -1
		}
		if v > 0 && v&-4294967296 == fp && keys[(v&0xffffffff)-1] == k {
			return i
		}
		i = (i + 1) & mask
	}
}

// rt_map_find returns the entry holding key k, or -1.
fn rt_map_find(m i64, k i64) i64 {
	let s = rt_map_slot(m, k, rt_map_hash(m, k))
	if s < 0 {
		return -1
	}
	return (m[4][s] & 0xffffffff) - 1
}

fn rt_map_get(m i64, k i64) i64 {
	let c = __ctx()
	if m == 0 {
		c[ctxFound] = 0
		return 0
	}
	let sl = rt_map_slot(m, k, rt_map_hash(m, k))
	if sl < 0 {
		c[ctxFound] = 0
		return 0
	}
	c[ctxFound] = 1
	return m[3][(m[4][sl]&0xffffffff)-1]
}

fn rt_map_found() bool {
	return __ctx()[ctxFound] != 0
}

// rt_map_index puts entry e (hash h) into the first free or deleted index slot.
fn rt_map_index(m i64, e i64, h i64) {
	let mask = m[1] - 1
	let idx = m[4]
	mut i = lsr(h, m[6])
	for idx[i] > 0 {
		i = (i + 1) & mask
	}
	if idx[i] < 0 {
		m[7] -= 1
	}
	idx[i] = rt_map_fp(h) | (e + 1)
}

// rt_map_grow rebuilds m with room for twice its live entries, keeping their order.
fn rt_map_grow(m i64) {
	let okeys = m[2]
	let ovals = m[3]
	let oidx = m[4]
	let ohashes = m[8]
	let olive = m[12]
	let used = m[10]
	let n = m[0]
	mut ec = 8
	for ec < (n+1)*2 {
		ec *= 2
	}
	rt_map_init(m, ec)
	for j in 0..used {
		if load8(olive+j) == 1 {
			let e = m[10]
			m[2][e] = okeys[j]
			m[3][e] = ovals[j]
			store8(m[12]+e, 1)
			mut h = 0
			if m[5] != 0 {
				h = ohashes[j]
				m[8][e] = h
			} else {
				h = rt_map_hash(m, okeys[j])
			}
			rt_map_index(m, e, h)
			m[10] = e + 1
		}
	}
	m[0] = n
	// Map tables are never shared, so a long-lived map frees the old ones.
	if m[9] != 0 {
		rt_ingot_free(okeys)
		rt_ingot_free(ovals)
		rt_ingot_free(oidx)
		rt_ingot_free(olive)
		if ohashes != 0 {
			rt_ingot_free(ohashes)
		}
	}
}

// rt_map_set stores v under k. dup says the caller passes a key it does not keep: on an
// overwrite the entry keeps the key it has, so a fresh incoming key is a duplicate and
// is released (#176).
fn rt_map_set(m i64, k i64, v i64, dup i64) {
	if m == 0 {
		rt_panic("assignment to entry in nil map")
	}
	if m[10] == m[11] {
		rt_map_grow(m)
	}
	let h = rt_map_hash(m, k)
	let fp = rt_map_fp(h)
	let mask = m[1] - 1
	let idx = m[4]
	let keys = m[2]
	let str_keys = m[5] != 0
	mut i = lsr(h, m[6])
	mut tomb = -1
	for {
		let x = idx[i]
		if x == 0 {
			break
		}
		if x < 0 {
			if tomb < 0 {
				tomb = i
			}
		} else if x&-4294967296 == fp {
			let e0 = (x & 0xffffffff) - 1
			if (str_keys && rt_str_eq(cast(str, keys[e0]), cast(str, k))) || (!str_keys && keys[e0] == k) {
				if m[9] != 0 {
					if (m[14] & 2) != 0 {
						// The old value's count leaves with the slot; the new one takes it.
						rt_rc_inc(v)
						rt_rc_dec(m[3][e0], cast(fn(i64), m[13]))
					}
					if dup != 0 && (m[14] & 1) != 0 {
						rt_rc_drop_fresh(k)
					}
				}
				m[3][e0] = v
				return
			}
		}
		i = (i + 1) & mask
	}
	if tomb >= 0 {
		i = tomb
		m[7] -= 1
	}
	let e = m[10]
	keys[e] = k
	m[3][e] = v
	store8(m[12]+e, 1)
	if str_keys {
		m[8][e] = h
	}
	if m[9] != 0 {
		if (m[14] & 1) != 0 {
			rt_rc_inc(k)
		}
		if (m[14] & 2) != 0 {
			rt_rc_inc(v)
		}
	}
	m[10] = e + 1
	m[0] += 1
	idx[i] = fp | (e + 1)
}

// rt_map_setk is rt_map_set for a key encoded as a str (a struct or enum key): the key's
// bytes are copied into the map's own region, so the map never refers to the caller's.
fn rt_map_setk(m i64, k str, v i64) {
	if m == 0 {
		rt_panic("assignment to entry in nil map")
	}
	if rt_map_find(m, cast(i64, k)) < 0 {
		let n = len(k)
		let p = rt_region_alloc(m[9], n+9)
		p[0] = n
		memcpy(p+8, cast(i64, k)+8, n)
		k = cast(str, p)
	}
	rt_map_set(m, cast(i64, k), v, 0)
}

// ---- map keys encoded as bytes (struct and enum keys compare by value) ----

// query is what an interpolated literal becomes where a query is wanted: the text pieces
// around each {value} and the values themselves, never pasted into the text. Database
// and cache clients take a query so a value cannot change a command's shape.
type query struct {
	Parts  []str
	Args   []qarg
	Hidden u64 // bit i: Args[i] was written with a secret value; replay keys hold its handle (#241)
}

// qarg is one value of a query.
type qarg enum {
	Int(v i64)
	Float(v f64)
	Str(v str)
	Bool(v bool)
	Bytes(v []u8)
}

mut kdOff i64 // per core: where rt_kd_* reads next

fn rt_kb_new() i64 {
	return rt_slice_make(0, 32, 1)
}

// rt_kb_word appends v's 8 bytes to byte slice b.
fn rt_kb_word(b i64, v i64) i64 {
	if b[0]+8 > b[1] {
		rt_slice_grow(b, b[0]+8, 1)
	}
	(b[2] + b[0])[0] = v
	b[0] += 8
	return b
}

// rt_kb_str appends s's length and bytes to byte slice b.
fn rt_kb_str(b i64, s str) i64 {
	let n = len(s)
	b = rt_kb_word(b, n)
	if b[0]+n > b[1] {
		rt_slice_grow(b, b[0]+n, 1)
	}
	memcpy(b[2]+b[0], cast(i64, s)+8, n)
	b[0] += n
	return b
}

fn rt_kb_done(b i64) str {
	return rt_str_from_raw(b[2], b[0])
}

fn rt_kd_begin() {
	kdOff = 0
}

fn rt_kd_word(s str) i64 {
	let v = (cast(i64, s) + 8 + kdOff)[0]
	kdOff += 8
	return v
}

fn rt_kd_str(s str) str {
	let n = rt_kd_word(s)
	let r = rt_str_from_raw(cast(i64, s)+8+kdOff, n)
	kdOff += n
	return r
}

fn rt_map_del(m i64, k i64) {
	if m == 0 {
		return
	}
	let s = rt_map_slot(m, k, rt_map_hash(m, k))
	if s >= 0 {
		let e = (m[4][s] & 0xffffffff) - 1
		if m[9] != 0 {
			// The slot's counts leave with it (#176); encoded keys are plain blocks.
			if (m[14] & 1) != 0 {
				rt_rc_dec(m[2][e], rt_rc_drop_none)
			}
			if (m[14] & 2) != 0 {
				rt_rc_dec(m[3][e], cast(fn(i64), m[13]))
			}
		}
		store8(m[12]+e, 0)
		m[4][s] = -1
		m[0] -= 1
		m[7] += 1
	}
}

// rt_map_release frees the auxiliary tables after a long-lived map's entries are dropped.
fn rt_map_release(m i64) {
	if m == 0 || m[9] == 0 { return }
	rt_ingot_free(m[2])
 rt_ingot_free(m[3])
 rt_ingot_free(m[4])
	if m[8] != 0 { rt_ingot_free(m[8]) }
	rt_ingot_free(m[12])
}

// rt_map_slots is how many entries a range over m walks (live and deleted, in order).
fn rt_map_slots(m i64) i64 {
	if m == 0 {
		return 0
	}
	return m[10]
}

fn rt_map_live(m i64, i i64) bool {
	return load8(m[12]+i) == 1
}

fn rt_map_key(m i64, i i64) i64 {
	return m[2][i]
}

fn rt_map_val(m i64, i i64) i64 {
	return m[3][i]
}

// rt_map_len is the number of entries of m (0 for the zero map).
fn rt_map_len(m i64) i64 {
	if m == 0 {
		return 0
	}
	return m[0]
}

// Key kinds for rt_map_order: how the stored key words compare.
const keySigned = 0
const keyStr = 1
const keyFloat = 2
const keyUnsigned = 3 // unsigned integers and bool

// rt_key_less orders two keys of a map the way Go's fmt prints them: numbers by value (unsigned
// above 2^63 as unsigned, floats as floats with NaN first), strings bytewise, false before true.
fn rt_key_less(m i64, kind i64, a i64, b i64) bool {
	let ka = rt_map_key(m, a)
	let kb = rt_map_key(m, b)
	if kind == keyStr {
		return rt_str_cmp(cast(str, ka), cast(str, kb)) < 0
	}
	if kind == keyFloat {
		let x = cast(f64, ka)
		let y = cast(f64, kb)
		return x < y || (x != x && y == y)
	}
	if kind == keyUnsigned {
		return u64(ka) < u64(kb)
	}
	return ka < kb
}

// rt_map_order returns the live slots of m sorted by key, as an array of rt_map_len(m) words in
// the current request's memory. Printing a map is the only user, and it must not depend on the
// order the entries were added in.
fn rt_map_order(m i64, kind i64) i64 {
	let n = rt_map_len(m)
	let order = rt_alloc(8*n + 8)
	mut k = 0
	{
		mut i = 0
		for i < rt_map_slots(m) {
			if rt_map_live(m, i) {
				order[k] = i
				k += 1
			}
			i += 1
		}
	}
	if n < 2 {
		return order
	}
	// Bottom-up merge sort (stable, O(n log n)): a map may be large.
	let tmp = rt_alloc(8*n + 8)
	{
		mut width = 1
		for width < n {
			for lo in (0..n).step(2 * width) {
				mut mid = lo + width
				if mid > n {
					mid = n
				}
				mut hi = lo + 2*width
				if hi > n {
					hi = n
				}
				mut i = lo
				mut j = mid
				mut o = lo
				for i < mid && j < hi {
					if rt_key_less(m, kind, order[j], order[i]) {
						tmp[o] = order[j]
						j += 1
					} else {
						tmp[o] = order[i]
						i += 1
					}
					o += 1
				}
				for i < mid {
					tmp[o] = order[i]
					i += 1
					o += 1
				}
				for j < hi {
					tmp[o] = order[j]
					j += 1
					o += 1
				}
			}
			for i in 0..n {
				order[i] = tmp[i]
			}
			width *= 2
		}
	}
	return order
}

// rt_order_at is word j of an array returned by rt_map_order.
fn rt_order_at(order i64, j i64) i64 {
	return order[j]
}

// ---- formatting ----
//
// fmt calls compile to begin, one typed call per argument, then end. A frame holds the
// output bytes and, for Printf, the format and the verb the next argument gets.

const fPrev = 0
const fData = 1
const fLen = 2
const fCap = 3
const fFormat = 4
const fPos = 5
const fMode = 6     // 0 Printf, 1 Print, 2 Println
const fCount = 7
const fWasStr = 8
const fVerb = 9
const fWidth = 10
const fPrec = 11
const fMinus = 12
const fPlus = 13
const fZero = 14
const fSharp = 15
const fNest = 16
const fSpace = 17
const fPlusV = 18 // the verb is %+v: structs print their field names, and numbers get no + sign
const fWords = 19

fn rt_frame() i64 {
	return __ctx()[ctxFmt]
}

fn rt_fmt_push(mode i64) i64 {
	let c = __ctx()
	let f = rt_alloc(fWords * 8)
	f[fPrev] = c[ctxFmt]
	f[fMode] = mode
	f[fCap] = 64
	f[fData] = rt_alloc(64)
	c[ctxFmt] = f
	return f
}

fn rt_fmt_begin(format str) {
	let f = rt_fmt_push(0)
	f[fFormat] = cast(i64, format)
}

fn rt_fmt_begin_v(ln i64) {
	rt_fmt_push(1 + ln)
}

fn fb_reserve(f i64, n i64) {
	if f[fLen]+n <= f[fCap] {
		return
	}
	mut c = f[fCap] * 2
	for c < f[fLen]+n {
		c *= 2
	}
	let d = rt_alloc(c)
	memcpy(d, f[fData], f[fLen])
	f[fData] = d
	f[fCap] = c
}

fn fb_byte(f i64, b i64) {
	fb_reserve(f, 1)
	store8(f[fData]+f[fLen], b)
	f[fLen] += 1
}

fn fb_raw(f i64, p i64, n i64) {
	if n <= 0 {
		return
	}
	fb_reserve(f, n)
	memcpy(f[fData]+f[fLen], p, n)
	f[fLen] += n
}

fn fb_str(f i64, s str) {
	fb_raw(f, cast(i64, s)+8, len(s))
}

fn fb_pad(f i64, n i64, c i64) {
	for n > 0 {
		fb_byte(f, c)
		n -= 1
	}
}

// fmt_pad writes n bytes at p padded to the current verb's width.
fn fmt_pad(f i64, p i64, n i64) {
	let w = f[fWidth]
	if w <= n {
		fb_raw(f, p, n)
		return
	}
	if f[fMinus] != 0 {
		fb_raw(f, p, n)
		fb_pad(f, w-n, ' ')
		return
	}
	if f[fZero] != 0 {
		// Zero padding goes after the sign.
		if n > 0 && (load8(p) == '-' || load8(p) == '+') {
			fb_byte(f, i64(load8(p)))
			fb_pad(f, w-n, '0')
			fb_raw(f, p+1, n-1)
			return
		}
		fb_pad(f, w-n, '0')
		fb_raw(f, p, n)
		return
	}
	fb_pad(f, w-n, ' ')
	fb_raw(f, p, n)
}

// rt_fmt_next copies format text up to the next verb and parses it; 0 means none is left.
fn rt_fmt_next(f i64) i64 {
	let s = cast(str, f[fFormat])
	let n = len(s)
	let p = cast(i64, s) + 8
	mut i = f[fPos]
	for i < n {
		mut c = i64(load8(p + i))
		if c != '%' {
			let start = i
			for i < n && load8(p+i) != '%' {
				i += 1
			}
			fb_raw(f, p+start, i-start)
			continue
		}
		if i+1 < n && load8(p+i+1) == '%' {
			fb_byte(f, '%')
			i += 2
			continue
		}
		i += 1
		f[fMinus] = 0
		f[fPlus] = 0
		f[fZero] = 0
		f[fSharp] = 0
		f[fSpace] = 0
		f[fPlusV] = 0
		for i < n {
			c = i64(load8(p + i))
			if c == '-' {
				f[fMinus] = 1
			} else if c == '+' {
				f[fPlus] = 1
			} else if c == '0' {
				f[fZero] = 1
			} else if c == '#' {
				f[fSharp] = 1
			} else if c == ' ' {
				f[fSpace] = 1
			} else {
				break
			}
			i += 1
		}
		mut w = 0
		for i < n && load8(p+i) >= '0' && load8(p+i) <= '9' {
			w = w*10 + i64(load8(p+i)) - '0'
			i += 1
		}
		f[fWidth] = w
		f[fPrec] = -1
		if i < n && load8(p+i) == '.' {
			i += 1
			mut pr = 0
			for i < n && load8(p+i) >= '0' && load8(p+i) <= '9' {
				pr = pr*10 + i64(load8(p+i)) - '0'
				i += 1
			}
			f[fPrec] = pr
		}
		mut verb = 'v'
		if i < n {
			verb = i64(load8(p + i))
			i += 1
		}
		f[fVerb] = verb
		f[fPos] = i
		return 1
	}
	f[fPos] = i
	return 0
}

// rt_fmt_arg starts one argument: the separator for Print/Println, or the next verb
// for Printf. It returns the verb to use.
fn rt_fmt_arg(f i64, isstr bool) i64 {
	if f[fNest] != 0 {
		f[fWidth] = 0
		f[fPrec] = -1
		return 'v'
	}
	if f[fMode] == 0 {
		if rt_fmt_next(f) == 0 {
			fb_str(f, "%!(EXTRA ")
			f[fVerb] = 'v'
			f[fWidth] = 0
			f[fPrec] = -1
		}
		f[fCount] += 1
		if f[fVerb] == 'v' && f[fPlus] != 0 {
			// Go's %+v is not "%v with a sign": it clears the + flag and asks structs for field names.
			f[fPlusV] = 1
			f[fPlus] = 0
		}
		return f[fVerb]
	}
	if f[fCount] > 0 && (f[fMode] == 2 || (!isstr && f[fWasStr] == 0)) {
		fb_byte(f, ' ')
	}
	f[fCount] += 1
	if isstr {
		f[fWasStr] = 1
	} else {
		f[fWasStr] = 0
	}
	f[fWidth] = 0
	f[fPrec] = -1
	f[fMinus] = 0
	f[fZero] = 0
	f[fPlus] = 0
	return 'v'
}

// rt_fmt_plusv reports whether the current argument is formatted with %+v.
fn rt_fmt_plusv() bool {
	return rt_frame()[fPlusV] != 0
}

fn rt_fmt_close_extra(f i64) {
	if f[fMode] == 0 && f[fCount] > 0 && rt_fmt_extra(f) {
		fb_byte(f, ')')
	}
}

fn rt_fmt_extra(f i64) bool {
	return false
}

// i64 formatting

fn fmt_uint_buf(buf i64, v i64, base i64, upper bool) i64 {
	mut digits = "0123456789abcdef"
	if upper {
		digits = "0123456789ABCDEF"
	}
	let dp = cast(i64, digits) + 8
	mut i = 64
	if v == 0 {
		i -= 1
		store8(buf+i, '0')
		return i
	}
	for v != 0 {
		i -= 1
		mut d = 0
		if base == 10 {
			// Unsigned division by ten, valid for the full 64-bit range.
			let q = lsr(v, 1) / 5
			d = v - q*10
			v = q
		} else {
			d = v & (base - 1)
			mut shift = 4
			if base == 8 {
				shift = 3
			} else if base == 2 {
				shift = 1
			}
			v = lsr(v, shift)
		}
		store8(buf+i, i64(load8(dp+d)))
	}
	return i
}

fn fmt_int(f i64, v i64, verb i64) {
	let buf = rt_alloc(80)
	if verb == 'c' {
		let n = rt_utf8_put(buf, v)
		fmt_pad(f, buf, n)
		return
	}
	if verb == 'q' {
		store8(buf, '\'')
		let n = rt_utf8_put(buf+1, v)
		store8(buf+1+n, '\'')
		fmt_pad(f, buf, n+2)
		return
	}
	if verb == 'U' {
		store8(buf, 'U')
		store8(buf+1, '+')
		mut i = fmt_uint_buf(buf+8, v, 16, true)
		mut n = 64 - i
		for n < 4 {
			i -= 1
			store8(buf+8+i, '0')
			n += 1
		}
		memmove(buf+2, buf+8+i, n)
		fmt_pad(f, buf, n+2)
		return
	}
	mut base = 10
	mut upper = false
	if verb == 'x' {
		base = 16
	} else if verb == 'X' {
		base = 16
		upper = true
	} else if verb == 'o' {
		base = 8
	} else if verb == 'b' {
		base = 2
	}
	let neg = v < 0 && base == 10
	if neg {
		v = -v
	}
	mut i = fmt_uint_buf(buf+16, v, base, upper)
	if f[fPrec] >= 0 {
		for 64-i < f[fPrec] {
			i -= 1
			store8(buf+16+i, '0')
		}
	}
	if f[fSharp] != 0 && base == 16 {
		i -= 1
		store8(buf+16+i, 'x')
		i -= 1
		store8(buf+16+i, '0')
	}
	if neg {
		i -= 1
		store8(buf+16+i, '-')
	} else if f[fPlus] != 0 {
		i -= 1
		store8(buf+16+i, '+')
	}
	fmt_pad(f, buf+16+i, 64-i)
}

fn rt_fmt_i(v i64) {
	let f = rt_frame()
	fmt_int(f, v, rt_fmt_arg(f, false))
}

fn rt_fmt_p(v i64) {
	let f = rt_frame()
	rt_fmt_arg(f, false)
	if v == 0 {
		fb_str(f, "<nil>")
		return
	}
	f[fSharp] = 1
	fmt_int(f, v, 'x')
}

fn rt_fmt_b(b bool) {
	let f = rt_frame()
	rt_fmt_arg(f, false)
	if b {
		fmt_pad(f, cast(i64, "true")+8, 4)
	} else {
		fmt_pad(f, cast(i64, "false")+8, 5)
	}
}

// fmt_quote_hex writes v as exactly n lower-case hex digits.
fn fmt_quote_hex(f i64, v i64, n i64) {
	{
		mut k = (n - 1) * 4
		for k >= 0 {
			fb_byte(f, i64(load8(cast(i64, "0123456789abcdef")+8+(v>>k&15))))
			k -= 4
		}
	}
}

// rt_is_print reports whether Go's unicode.IsPrint accepts r beyond the ASCII space (bytes of
// rt_print_runs: merged runs, generated by tools/gen_unicode.py).
fn rt_is_print(r i64) bool {
	if r < 0x7f {
		return r >= 0x20
	}
	let runs = rt_print_runs()
	mut lo = 0
	mut hi = len(runs) / 6
	for lo < hi {
		let m = (lo + hi) >> 1
		let at = m * 6
		let first = i64(runs[at]) | i64(runs[at+1])<<8 | i64(runs[at+2])<<16
		let last = i64(runs[at+3]) | i64(runs[at+4])<<8 | i64(runs[at+5])<<16
		if r < first {
			hi = m
		} else if r > last {
			lo = m + 1
		} else {
			return true
		}
	}
	return false
}

// fmt_quote_rune writes the escape of one valid rune that is not printable, or is the quote or a
// backslash, in Go's quoted form.
fn fmt_quote_rune(f i64, r i64) {
	if r == '"' || r == '\\' {
		fb_byte(f, '\\')
		fb_byte(f, r)
	} else if r == 7 {
		fb_str(f, "\\a")
	} else if r == 8 {
		fb_str(f, "\\b")
	} else if r == 12 {
		fb_str(f, "\\f")
	} else if r == '\n' {
		fb_str(f, "\\n")
	} else if r == '\r' {
		fb_str(f, "\\r")
	} else if r == '\t' {
		fb_str(f, "\\t")
	} else if r == 11 {
		fb_str(f, "\\v")
	} else if r < ' ' || r == 0x7f {
		fb_str(f, "\\x")
		fmt_quote_hex(f, r, 2)
	} else if r < 0x10000 {
		fb_str(f, "\\u")
		fmt_quote_hex(f, r, 4)
	} else {
		fb_str(f, "\\U")
		fmt_quote_hex(f, r, 8)
	}
}

// fmt_quote writes s as a Go double-quoted string: invalid UTF-8 bytes become \xHH and unprintable
// runes \u escapes, as strconv.Quote does.
fn fmt_quote(f i64, s str) {
	fb_byte(f, '"')
	let n = len(s)
	let p = cast(i64, s) + 8
	mut i = 0
	for i < n {
		let c = i64(load8(p + i))
		if c < 0x80 {
			i += 1
			if c >= 32 && c < 127 && c != '"' && c != '\\' {
				fb_byte(f, c)
			} else {
				fmt_quote_rune(f, c)
			}
			continue
		}
		let d = rt_utf8(s, i)
		let r = d & 0xffffffff
		let w = d >> 32
		if w == 1 && r == 0xfffd {
			fb_str(f, "\\x")
			fmt_quote_hex(f, c, 2)
		} else if rt_is_print(r) && f[fPlus] == 0 {
			fb_raw(f, p+i, w)
		} else {
			fmt_quote_rune(f, r)
		}
		i += w
	}
	fb_byte(f, '"')
}

// fmt_pad_since pads what was written since start to the verb's width: spaces (or zeros with
// the 0 flag) before it, or spaces after it with the - flag.
fn fmt_pad_since(f i64, start i64) {
	let n = f[fLen] - start
	// Width counts runes, as Go does: continuation bytes are not counted.
	mut runes = 0
	for i in 0..n {
		if load8(f[fData]+start+i)&0xc0 != 0x80 {
			runes += 1
		}
	}
	let pad = f[fWidth] - runes
	if pad <= 0 {
		return
	}
	if f[fMinus] != 0 {
		fb_pad(f, pad, ' ')
		return
	}
	fb_reserve(f, pad)
	let d = f[fData] + start
	memmove(d+pad, d, n)
	mut c = ' '
	if f[fZero] != 0 {
		c = '0'
	}
	memset(d, c, pad)
	f[fLen] += pad
}

// rt_runes_prefix is s cut after its first n runes (each invalid byte is one rune).
fn rt_runes_prefix(s str, n i64) str {
	mut i = 0
	{
		mut k = 0
		for k < n && i < len(s) {
			i += rt_utf8(s, i) >> 32
			k += 1
		}
	}
	return s[0:i]
}

// rt_can_backquote reports whether s can be written as a raw string, as strconv.CanBackquote:
// valid UTF-8 with no backquote, no U+FEFF and no control character other than tab.
fn rt_can_backquote(s str) bool {
	mut i = 0
	for i < len(s) {
		let c = i64(s[i])
		if c < 0x80 {
			if (c < ' ' && c != '\t') || c == '`' || c == 0x7f {
				return false
			}
			i += 1
			continue
		}
		let d = rt_utf8(s, i)
		let r = d & 0xffffffff
		let w = d >> 32
		if (w == 1 && r == 0xfffd) || r == 0xfeff {
			return false
		}
		i += w
	}
	return true
}

fn fmt_string(f i64, s str, verb i64) {
	if verb == 'q' {
		// Go's %q: precision counts runes of the input; # backquotes when the string allows it,
		// + escapes every non-ASCII rune; width pads the quoted text (#149).
		if f[fPrec] >= 0 {
			s = rt_runes_prefix(s, f[fPrec])
		}
		let start = f[fLen]
		if f[fSharp] != 0 && rt_can_backquote(s) {
			fb_byte(f, '`')
			fb_str(f, s)
			fb_byte(f, '`')
		} else {
			fmt_quote(f, s)
		}
		fmt_pad_since(f, start)
		return
	}
	if verb == 'x' || verb == 'X' {
		mut digits = "0123456789abcdef"
		if verb == 'X' {
			digits = "0123456789ABCDEF"
		}
		for i in 0..len(s) {
			fb_byte(f, i64(digits[i64(s[i])>>4]))
			fb_byte(f, i64(digits[i64(s[i])&15]))
		}
		return
	}
	mut n = len(s)
	if f[fPrec] >= 0 && f[fPrec] < n {
		n = f[fPrec]
	}
	fmt_pad(f, cast(i64, s)+8, n)
}

fn rt_fmt_s(s str) {
	let f = rt_frame()
	fmt_string(f, s, rt_fmt_arg(f, true))
}

fn rt_fmt_e(e i64) {
	let f = rt_frame()
	let verb = rt_fmt_arg(f, false)
	if e == 0 {
		fb_str(f, "<nil>")
		return
	}
	fmt_string(f, cast(str, e), verb)
}

fn rt_fmt_raw(s str) {
	fb_str(rt_frame(), s)
}

// rt_fmt_argsep starts a struct or map argument, whose parts are written raw.
fn rt_fmt_argsep() {
	let f = rt_frame()
	rt_fmt_arg(f, false)
	f[fNest] += 1
}

fn rt_fmt_argend() {
	rt_frame()[fNest] -= 1
}

// f64 formatting uses exact decimal rounding and shortest adjacent-float intervals.

// fmt_nonfinite prints NaN, +Inf or -Inf the way Go's fmt does for every float verb: NaN has no sign
// (+NaN with the + flag), infinities always do, and neither is padded with zeros.
// It reports whether x was one of them.
fn fmt_nonfinite(f i64, x f64, verb i64) bool {
	if x == x && x <= 1.7976931348623157e308 && x >= -1.7976931348623157e308 {
		return false
	}
	mut text = "+Inf"
	if x != x {
		text = "NaN"
		if f[fPlus] != 0 {
			text = "+NaN"
		}
	} else if x < 0 {
		text = "-Inf"
	}
	let zero = f[fZero]
	f[fZero] = 0
	fmt_pad(f, cast(i64, text)+8, len(text))
	f[fZero] = zero
	return true
}

fn fmt_float_number(f i64, x f64, verb i64, prec i64) {
	let buf = rt_alloc(prec + 400)
	mut n = rt_number_format(buf, x, verb, prec)
	if f[fPlus] != 0 && load8(buf) != '-' {
		memmove(buf+1, buf, n)
		store8(buf, '+')
		n += 1
	}
	fmt_pad(f, buf, n)
}

// fmt_shortest writes x with the fewest digits that read back exactly, laid out the way
// Go's %v does: exponent form when the exponent is below -4 or at least 21.
mut fast_exp i64
mut fmtScratch i64   // per core: digit buffers for float formatting (no allocation per number)

fn fmt_scratch() i64 {
	if fmtScratch == 0 {
		fmtScratch = rt_ingot_alloc(128)
	}
	return fmtScratch
}

// short_digits finds the shortest decimal of x the quick way: the fewest decimals k with
// rint(|x| * 10^k) / 10^k == |x| (exact: both operands are integers below 2^53 or powers
// of ten, and IEEE division rounds correctly). It writes the digits and sets fast_exp,
// or returns 0 when x is out of its range (the slow path then decides).
fn short_digits(x f64, digits i64) i64 {
	mut ax = x
	if ax < 0 {
		ax = -ax
	}
	if !(ax >= 1e-7 && ax < 1e15) {
		return 0
	}
	mut p = 1.0
	{
		mut k = 0
		for k <= 22 {
			let m = rint(ax * p)
			if m >= 9007199254740992.0 {
				return 0
			}
			if m/p == ax && m >= 1 {
				mut mi = i64(m)
				let tmp = fmt_scratch() + 96
				mut n = 0
				for mi > 0 {
					store8(tmp+n, '0'+mi%10)
					mi /= 10
					n += 1
				}
				for i in 0..n {
					store8(digits+i, i64(load8(tmp+n-1-i)))
				}
				mut nd = n
				for nd > 1 && load8(digits+nd-1) == '0' {
					nd -= 1
				}
				fast_exp = n - 1 - k
				return nd
			}
			p *= 10
			k += 1
		}
	}
	return 0
}

// shortest_into writes the shortest decimal that reads back as x into out (400 bytes):
// exponent form when the exponent is below lo or at least hi; json drops the exponent's
// zero padding (1e-7, not 1e-07). It returns the length.
mut shortF32 bool // per core: shortest_into finds the shortest digits for an f32, not an f64

fn shortest_into(out i64, x f64, lo i64, hi i64, json bool, plus bool) i64 {
	if x != x {
		memcpy(out, cast(i64, "NaN")+8, 3)
		return 3
	}
	if x > 1.7976931348623157e308 || x < -1.7976931348623157e308 {
		if x > 0 {
			memcpy(out, cast(i64, "+Inf")+8, 4)
		} else {
			memcpy(out, cast(i64, "-Inf")+8, 4)
		}
		return 4
	}
	let scratch = fmt_scratch()
	let tmp = scratch
	let digits = scratch + 64
	mut nd = 0
	mut exp = 0
	let neg = cast(i64, x) < 0
	if x != 0 && !shortF32 {
		nd = short_digits(x, digits)
		if nd > 0 {
			exp = fast_exp
		}
	}
	if x == 0 {
		store8(digits, '0')
		nd = 1
	} else if nd == 0 {
		nd = rt_number_short(x, digits, shortF32)
		exp = fast_exp
	}
	mut n = 0
	if neg {
		store8(out, '-')
		n = 1
	} else if plus {
		store8(out, '+')
		n = 1
	}
	if exp < lo || exp >= hi {
		store8(out+n, i64(load8(digits)))
		n += 1
		if nd > 1 {
			store8(out+n, '.')
			n += 1
			memcpy(out+n, digits+1, nd-1)
			n += nd - 1
		}
		store8(out+n, 'e')
		n += 1
		mut e = exp
		if e < 0 {
			store8(out+n, '-')
			e = -e
		} else {
			store8(out+n, '+')
		}
		n += 1
		if e < 10 && !json {
			store8(out+n, '0')
			n += 1
		}
		if e >= 100 {
			store8(out+n, '0'+e/100)
			n += 1
			e %= 100
			store8(out+n, '0'+e/10)
			n += 1
		} else if e >= 10 {
			store8(out+n, '0'+e/10)
			n += 1
		}
		store8(out+n, '0'+e%10)
		n += 1
	} else if exp >= 0 {
		{
			mut i = 0
			for i <= exp {
				if i < nd {
					store8(out+n, i64(load8(digits+i)))
				} else {
					store8(out+n, '0')
				}
				n += 1
				i += 1
			}
		}
		if nd > exp+1 {
			store8(out+n, '.')
			n += 1
			memcpy(out+n, digits+exp+1, nd-exp-1)
			n += nd - exp - 1
		}
	} else {
		store8(out+n, '0')
		store8(out+n+1, '.')
		n += 2
		for i in 0..-exp-1 {
			store8(out+n, '0')
			n += 1
		}
		memcpy(out+n, digits, nd)
		n += nd
	}
	return n
}

fn fmt_shortest(f i64, x f64, lo i64, hi i64) {
	let out = rt_alloc(400)
	let n = shortest_into(out, x, lo, hi, false, f[fPlus] != 0)
	fmt_pad(f, out, n)
}

// rt_float_json is x as encoding/json writes it (exponent below 1e-6 or from 1e21).
fn rt_float_json(x f64) str {
	let out = rt_alloc(400)
	let n = shortest_into(out, x, -6, 21, true, false)
	return rt_str_from_raw(out, n)
}

fn fmt_float(f i64, x f64, verb i64) {
	if fmt_nonfinite(f, x, verb) {
		return
	}
	if verb == 'v' || ((verb == 'g' || verb == 'G') && f[fPrec] < 0) {
		fmt_shortest(f, x, -4, 6)
		return
	}
	mut prec = f[fPrec]
	if prec < 0 {
		prec = 6
	}
	if verb != 'f' && verb != 'F' && verb != 'e' && verb != 'E' && verb != 'g' && verb != 'G' {
		verb = 'g'
	}
	fmt_float_number(f, x, verb, prec)
}

fn rt_fmt_f(x f64) {
	let f = rt_frame()
	fmt_float(f, x, rt_fmt_arg(f, false))
}

// rt_fmt_f32 prints an f32 like Go's float32: the shortest digits that read back as it.
fn rt_fmt_f32(x f64) {
	let f = rt_frame()
	shortF32 = true
	fmt_float(f, x, rt_fmt_arg(f, false))
	shortF32 = false
}

fn rt_fmt_slf32(s []f32) {
	let f = rt_frame()
	let verb = rt_fmt_arg(f, false)
	shortF32 = true
	fb_byte(f, '[')
	for i, v in s {
		if i > 0 {
			fb_byte(f, ' ')
		}
		fmt_float(f, f64(v), verb)
	}
	fb_byte(f, ']')
	shortF32 = false
}

// slices print as [a b c]

fn rt_fmt_sli(s []i64) {
	let f = rt_frame()
	let verb = rt_fmt_arg(f, false)
	fb_byte(f, '[')
	for i, v in s {
		if i > 0 {
			fb_byte(f, ' ')
		}
		fmt_int(f, v, verb)
	}
	fb_byte(f, ']')
}

fn rt_fmt_slb(s []u8) {
	let f = rt_frame()
	let verb = rt_fmt_arg(f, false)
	if verb == 's' || verb == 'q' || verb == 'x' {
		fmt_string(f, rt_str_from_bytes(s), verb)
		return
	}
	fb_byte(f, '[')
	for i, v in s {
		if i > 0 {
			fb_byte(f, ' ')
		}
		fmt_int(f, i64(v), verb)
	}
	fb_byte(f, ']')
}

fn rt_fmt_sls(s []str) {
	let f = rt_frame()
	let verb = rt_fmt_arg(f, false)
	fb_byte(f, '[')
	for i, v in s {
		if i > 0 {
			fb_byte(f, ' ')
		}
		fmt_string(f, v, verb)
	}
	fb_byte(f, ']')
}

fn rt_fmt_slf(s []f64) {
	let f = rt_frame()
	let verb = rt_fmt_arg(f, false)
	fb_byte(f, '[')
	for i, v in s {
		if i > 0 {
			fb_byte(f, ' ')
		}
		fmt_float(f, v, verb)
	}
	fb_byte(f, ']')
}

fn rt_fmt_slt(s []bool) {
	let f = rt_frame()
	rt_fmt_arg(f, false)
	fb_byte(f, '[')
	for i, v in s {
		if i > 0 {
			fb_byte(f, ' ')
		}
		if v {
			fb_str(f, "true")
		} else {
			fb_str(f, "false")
		}
	}
	fb_byte(f, ']')
}

// rt_fmt_finish completes the frame (rest of the format, or the newline) and pops it.
fn rt_fmt_finish() i64 {
	let c = __ctx()
	let f = c[ctxFmt]
	if f[fMode] == 0 {
		for rt_fmt_next(f) != 0 {
			fb_str(f, "%!")
			fb_byte(f, f[fVerb])
			fb_str(f, "(MISSING)")
		}
	} else if f[fMode] == 2 {
		fb_byte(f, '\n')
	}
	c[ctxFmt] = f[fPrev]
	return f
}

fn rt_fmt_end() str {
	let f = rt_fmt_finish()
	return rt_str_from_raw(f[fData], f[fLen])
}

fn rt_fmt_out() {
	let f = rt_fmt_finish()
	rt_out(f[fData], f[fLen])
}

fn rt_fmt_err() i64 {
	let f = rt_fmt_finish()
	return rt_fault_raw(f[fData], f[fLen], 0, 0)
}

// ---- keep: copies into the long-lived ingot heap ----

fn rt_keep_str(s str) str {
	let n = len(s)
	if n == 0 {
		return ""
	}
	let p = rt_ingot_alloc(n + 9)
	p[0] = n
	memcpy(p+8, cast(i64, s)+8, n)
	return cast(str, p)
}

fn rt_keep_raw(p i64, n i64) i64 {
	let q = rt_ingot_alloc(n)
	memcpy(q, p, n)
	return q
}

fn rt_keep_slice(s i64, esz i64) i64 {
	let n = s[0]
	let h = rt_ingot_alloc(32)
	h[0] = n
	h[1] = n
	h[3] = 1
	if n > 0 {
		h[2] = rt_ingot_alloc(n*esz + 8)
		memcpy(h[2], s[2], n*esz)
		// The kept header owns its array's one count (#176).
		rt_rc_inc(h[2])
	}
	return h
}

fn rt_keep_map_new(m i64, drop fn(i64), counted i64) i64 {
	let k = rt_ingot_alloc(120)
	k[5] = m[5]
	k[9] = 1
	k[13] = cast(i64, drop)
	k[14] = counted
	rt_map_init(k, 8)
	return k
}

// rt_arena_str, rt_arena_raw, rt_arena_slice and rt_arena_map_new are the pool twins of the
// rt_keep_ helpers: arenacopy$N copies an arena's result into the parent pool with them (#236).
fn rt_arena_str(s str) str {
	let n = len(s)
	if n == 0 {
		return ""
	}
	let p = rt_alloc(n + 9)
	p[0] = n
	memcpy(p+8, cast(i64, s)+8, n)
	return cast(str, p)
}

fn rt_arena_raw(p i64, n i64) i64 {
	let q = rt_alloc(n)
	memcpy(q, p, n)
	return q
}

fn rt_arena_slice(s i64, esz i64) i64 {
	let n = s[0]
	let h = rt_alloc(32)
	h[0] = n
	h[1] = n
	h[3] = __ctx()[ctxIngot]
	if n > 0 {
		h[2] = rt_alloc(n*esz + 8)
		memcpy(h[2], s[2], n*esz)
	}
	return h
}

fn rt_arena_map_new(m i64) i64 {
	return rt_map_make(m[5])
}

fn rt_keep_closure(f i64) i64 {
	if f == 0 {
		return 0
	}
	let k = f[1]
	if k == 0 {
		return f
	}
	if f[2+k] != 0 {
		// The compiler's keeper copies every captured variable by its type (#170).
		let keeper = cast(fn(i64) i64, f[2+k])
		return keeper(f)
	}
	// No captured variable holds a reference: copying the words is a full copy.
	let desc = rt_ingot_alloc(8 * (3 + k))
	desc[0] = f[0]
	desc[1] = k
	desc[2+k] = 0
	for i in 0..k {
		let old_cell = f[2+i]
		let new_cell = rt_ingot_alloc(8)
		new_cell[0] = old_cell[0]
		desc[2+i] = new_cell
	}
	return desc
}

// ---- unsigned and sized-int formatting ----

fn rt_fmt_u(v i64) {
	let f = rt_frame()
	let verb = rt_fmt_arg(f, false)
	if verb == 'd' || verb == 'v' {
		let buf = rt_alloc(80)
		let i = fmt_uint_buf(buf+16, v, 10, false)
		fmt_pad(f, buf+16+i, 64-i)
		return
	}
	fmt_int(f, v, verb)
}

fn rt_fmt_slint(s i64, width i64, signed i64) {
	let f = rt_frame()
	let verb = rt_fmt_arg(f, false)
	fb_byte(f, '[')
	let n = s[0]
	let d = s[2]
	for i in i64(0)..n {
		if i > 0 {
			fb_byte(f, ' ')
		}
		mut v = i64(0)
		if width == 1 {
			v = i64(load8(d + i))
		} else if width == 8 {
			v = d[i]
		} else if width == 2 {
			v = __ld(d+i*2, 1)
		} else {
			v = __ld(d+i*4, 2)
		}
		if signed != 0 && width < 8 {
			let shift = 64 - 8*width
			v = (v << shift) >> shift
		}
		if signed == 0 && (verb == 'v' || verb == 'd') {
			let buf = rt_alloc(80)
			let j = fmt_uint_buf(buf+16, v, 10, false)
			fb_raw(f, buf+16+j, 64-j)
		} else {
			fmt_int(f, v, verb)
		}
	}
	fb_byte(f, ']')
}

fn width_log(w i64) i64 {
	if w == 2 {
		return 1
	}
	if w == 4 {
		return 2
	}
	return 3
}

fn rt_fmt_slp(s i64) {
	let f = rt_frame()
	rt_fmt_arg(f, false)
	fb_byte(f, '[')
	let n = s[0]
	let d = s[2]
	for i in i64(0)..n {
		if i > 0 {
			fb_byte(f, ' ')
		}
		f[fSharp] = 1
		fmt_int(f, d[i], 'x')
	}
	fb_byte(f, ']')
}

// ---- tasks: a stack per in-flight request, switched in user space ----
//
// A task runs a func(i64) on its own 256 KiB stack (a guard region below it faults on
// overflow) with its own request pool. rt_task_run switches into it from the core's own
// stack; the task runs until it finishes or waits (rt_task_yield), and then the core
// continues. rt_task_swap (hand-assembled by the compiler for each CPU) saves and loads
// only what a call preserves: callee-saved registers, frame pointer, return address and
// stack pointer. The core context register is the same on every task of a core.


const taskStack = 262144
const taskGuard = 16384
const tSave = 0      // 20 words of registers (layout per CPU, see rt_task_init)
const tFn = 20
const tArg = 21
const tStack = 22    // the mapping: guard region, then the stack
const tDone = 23
const tPool = 24     // the task's pool words: bump, end, base, mark, extra
const tWake = 29     // waiting: when to resume (mono ns)
const tDeadline = 30 // 0, or when every wait of this task gives up (mono ns)
const tFault = 31    // why the last wait ended: 0 woken, 1 deadline
const tNext = 32     // free list link
const tUser = 33     // 6 words for the owner (anvil keeps its connection here)
const tGen = 40      // counts waits: a timer entry from an earlier wait is ignored
const tWaiting = 41  // 1 while the task waits
const tWaitFd = 42   // the descriptor it waits on, or -1
const tResult = 43   // how the wait ended: waitReady, waitDeadline or waitTimeout
const tFmt = 44      // this task's formatting frame stack
const tCleanup = 45  // LIFO cleanup records, run before their pool is reset
const tRecover = 46  // 1: a panic ends this task, not the process (rt_task_recover); 0 once it panicked
const tPanicked = 47 // 1: the task ended by a panic
const tRecoverable = 48
const tTrim = 49     // observed heavy pool or suspended stack: discard cached pages
const tTimers = 50   // timer heap entries that still name this record
const tRetired = 51  // 1: released over the cache cap; freed when its last timer entry pops
const tBnd = 52      // the task's current boundary (notes/interface_boundaries.md), 0 before rt_bnd_task
const tDefer = 53    // the task's defer chain (#230): records [next, defer$N, values...]
const tChild = 54    // a scope's child task (#232): its record [task, body, fault, done, waiter, scope, next]
const tScopeWait = 55 // the scope whose end the task is parked for (#232), else 0
const tTape = 56     // the request's replay tape (notes/interface_replay.md), 0: none; low bit: suspended
const tEp = 57       // the epoch the task inherited from its maker (#176)
const tEpNext = 58    // live-task list links (oldest epoch first)
const tEpPrev = 59
const taskWords = 60

const waitReady = 0
const waitDeadline = 1
const waitTimeout = 2

// Boundary records (notes/interface_boundaries.md): one per request, task and block boundary.
const bParent = 0
const bKind = 1     // kind in the low 8 bits, flags above
const bTask = 2     // the task running in it; 0 on the core stack
const bCancel = 3   // 0, or the reason it was cancelled (a fault)
const bOrigin = 4   // the boundary whose cancellation reached this one
const bDeadline = 5 // effective deadline (mono ns): min(own, parent's); 0: none
const bDlOwner = 6  // the boundary whose own deadline is the effective one
const bLimit = 7    // the innermost boundary with a budget at or above this one
const bMemMax = 8
const bMemUsed = 9
const bTaskMax = 10
const bTaskUsed = 11
const bSlots = 12   // slot chain [next, key, value], inherited at entry
const bChild = 13
const bNext = 14
const bPrev = 15
const bCleanup = 16 // the task's cleanup chain head at entry
const bLand = 17    // unwind landing data (#230)
const bRegion = 18  // 3 words: region mark at entry (#176)
const bFault = 21   // the fault an unwind landed with
const bOwnDl = 22   // this boundary's own deadline (mono ns); 0: none
const bLive = 23    // a scope's children that have not finished (#232)
const bndWords = 24

const bkCore = 1
const bkBackground = 2
const bkRequest = 3
const bkTask = 4
const bkGuard = 5
const bkWithin = 6
const bkLimit = 7
const bkScope = 8
const bkArena = 9
const bkWith = 10
const bfRoot = 256
const bfGuard = 512

mut curTask i64   // per core: the running task, 0 on the core's own stack
mut schedSave i64 // per core: the core's own registers while a task runs
mut schedPool i64 // per core: the core's own pool words and formatting stack while a task runs
mut freeTasks i64 // per core: finished tasks, reused with their stacks
mut freeTaskCount i64
const maxFreeTasks = 64
mut timerHeap i64 // per core: a min-heap of [wake, task, gen] entries
mut timerN i64
mut timerCap i64
mut waitHook fn(i64, i64) // per core (set by a server): watch fd (1 read, 2 write) for curTask
mut waitCancel fn(i64)    // per core: stop watching fd
mut doneFd i64              // per core: the pipe helper threads report finished jobs to (0: none)
mut readyQ i64              // per core: tasks woken by another task, resumed by the event loop
mut readyHead i64
mut readyN i64
mut readyCap i64
mut bndFree i64     // per core: free boundary records
mut bndCur i64      // per core: the current boundary of code on the core's own stack (0: the root)
mut bndRoot i64     // per core: the core's root boundary
mut bndBack i64     // per core: the core's background boundary
mut coreDefer i64   // per core: the defer chain of code on the core's own stack

// rt_once reports whether once-site id is reached for the first time on this core (#236).
fn rt_once(id i64) bool {
	if id >= onceCap {
		let n = id*2 + 64
		let nb = calloc(n, 1)
		if onceSeen != 0 {
			memcpy(nb, onceSeen, onceCap)
			free(onceSeen)
		}
		onceSeen = nb
		onceCap = n
	}
	if load8(onceSeen+id) != 0 {
		return false
	}
	store8(onceSeen+id, 1)
	return true
}

mut onceSeen i64 // per core: a byte per once site, 1 once reached
mut onceCap i64

// ---- lifecycle (#238): on handlers, package-level use, core start and stop ----
//
// Before main, __start registers each on handler and each package-level use's close in
// declaration order (rt_life_add), then runs rt_life_start; after main it runs rt_life_stop.
// A package-level use opens with its core's other globals, on cores only (not on helper
// threads), and a fault there ends the process (rt_use_fail). Handlers run guarded under the
// core's background boundary (no bindings), on the core's own stack: before the core serves
// anything or after it stopped, so a wait in one blocks its core, which has nothing else to do.

const lifeAppStart = 1
const lifeAppStop = 2
const lifeCoreStart = 3
const lifeCoreStop = 4
const lifeUseClose = 5
const lifeOverload = 6
const lifeRecovered = 7

shared mut lifeFns i64   // [n, cap, then kind, function, label for each]; set before cores start
shared mut lifeCores i64 // the cores hearth.Run starts, core 0 included
shared mut lifeReady i64 // the other cores that finished starting
mut lifeCore bool        // per core: a core thread, not a helper thread

// rt_life_add registers f as a handler of kind (or a use's close) with label for its faults.
fn rt_life_add(kind i64, f fn() !, label str) {
	if lifeFns == 0 {
		lifeFns = calloc(2+3*16, 8)
		lifeFns[1] = 16
	}
	if lifeFns[0] == lifeFns[1] {
		let n = calloc(2+6*lifeFns[1], 8)
		memcpy(n, lifeFns, 8*(2+3*lifeFns[0]))
		n[1] = lifeFns[1] * 2
		free(lifeFns)
		lifeFns = n
	}
	let i = lifeFns[0]
	lifeFns[2+3*i] = kind
	lifeFns[3+3*i] = cast(i64, f)
	lifeFns[4+3*i] = cast(i64, label)
	lifeFns[0] = i + 1
}

// rt_life_run runs the entries of kind in order (closes last first), each inside a guard. A
// fault (or a panic) ends startup when fatal; otherwise it is logged and the next one runs.
fn rt_life_run(kind i64, fatal bool) {
	if lifeFns == 0 {
		return
	}
	let n = lifeFns[0]
	for j in 0..n {
		mut i = j
		if kind == lifeUseClose {
			i = n - 1 - j
		}
		if lifeFns[2+3*i] == kind {
			// Under the core's background boundary, like detach: no request, no bindings.
			let saved = bndCur
			bndCur = rt_bnd_background()
			let f = rt_guard_call(cast(fn(i64) !, lifeFns[3+3*i]), 0)
			bndCur = saved
			if f != 0 {
				let label = cast(str, lifeFns[4+3*i])
				if fatal {
					rt_life_fail(label, f)
				}
				let m = label + ": " + cast(str, f) + "\n"
				rt_flush_core()
				rt_write_all(2, cast(i64, m)+8, len(m))
			}
		}
	}
}

// rt_life_overload runs the on server.overload handlers (with recovered, the on
// server.recovered ones) in a detached task of this core: the server is serving, so a handler
// that waits must not hold the core up. Their faults are logged.
fn rt_life_overload(recovered bool) {
	if lifeFns == 0 {
		return
	}
	if recovered {
		rt_detach(life_recovered)
	} else {
		rt_detach(life_overloaded)
	}
}

fn life_overloaded() ! {
	rt_life_run(lifeOverload, false)
}

fn life_recovered() ! {
	rt_life_run(lifeRecovered, false)
}

// rt_life_fail ends startup with label's fault f: the message, then exit status 1.
fn rt_life_fail(label str, f i64) {
	let m = "startup failed: " + label + ": " + cast(str, f) + "\n"
	rt_flush_core()
	rt_write_all(2, cast(i64, m)+8, len(m))
	rt_sys_exit(1)
}

// rt_use_fail ends startup: package-level use label could not open its resource.
fn rt_use_fail(label str, f fault) {
	rt_life_fail(label, cast(i64, f))
}

// rt_life_here reports whether package-level use resources open on this thread: core 0 and
// the cores hearth starts, not helper threads.
fn rt_life_here() bool {
	return lifeCore || rt_core_id() == 0
}

// rt_life_start runs on app.start, then core 0's on core.start; a fault ends startup.
fn rt_life_start() {
	rt_life_run(lifeAppStart, true)
	rt_life_run(lifeCoreStart, true)
}

// rt_life_stop runs after main, when every other core has stopped: core 0's on core.stop and
// use closes, then on app.stop.
fn rt_life_stop() {
	if lifeFns == 0 {
		return
	}
	// The drain is over: its deadline no longer stops anything.
	rtWatchDrainAt = 0
	rt_life_rearm()
	rt_life_run(lifeCoreStop, false)
	rt_life_run(lifeUseClose, false)
	rt_life_run(lifeAppStop, false)
}

// rt_life_cores records how many cores hearth.Run starts, for the startup barrier.
fn rt_life_cores(n i64) {
	lifeCores = n
}

// rt_life_core_start runs a started core's on core.start (a fault ends startup), then waits
// for every other core, so no core serves before all have started.
fn rt_life_core_start() {
	rt_life_run(lifeCoreStart, true)
	__atomic_add(&lifeReady, 1)
	rt_life_wait()
}

// rt_life_wait waits until every core hearth.Run started is past its start (only when the
// program declares lifecycle handlers or package-level use).
fn rt_life_wait() {
	if lifeFns == 0 {
		return
	}
	for __atomic_load(&lifeReady) < lifeCores-1 {
		rt_sleep_ns(100000)
	}
}

// rt_life_core_stop runs a stopped core's on core.stop, then closes its use resources.
fn rt_life_core_stop() {
	if lifeFns == 0 {
		return
	}
	rt_life_rearm()
	rt_life_run(lifeCoreStop, false)
	rt_life_run(lifeUseClose, false)
}

// rt_life_rearm gives the stop handlers a boundary the drain has not cancelled: the core's
// work is over, so a fresh root replaces the cancelled one.
fn rt_life_rearm() {
	if curTask == 0 && bndCur == 0 && bndRoot != 0 && bndRoot[bCancel] != 0 {
		bndRoot = 0
		bndBack = 0
	}
}

// rt_use_cell is the word a function's use closes join their faults into, freed by rt_use_take.
fn rt_use_cell() i64 {
	return calloc(1, 8)
}

// rt_use_note joins f, the fault of a use's Close, into cell c.
fn rt_use_note(c i64, f fault) {
	if f != nil {
		c[0] = rt_use_join(c[0], cast(i64, f))
	}
}

// rt_use_take frees cell c and returns the faults its closes gave (0: none).
fn rt_use_take(c i64) i64 {
	let f = c[0]
	free(c)
	return f
}

// rt_use_join is fault.Join of two fault words; either may be 0.
fn rt_use_join(a i64, b i64) i64 {
	if a == 0 {
		return b
	}
	if b == 0 {
		return a
	}
	let d = rt_alloc(16)
	d[0] = a
	d[1] = b
	let h = rt_alloc(32)
	h[0] = 2
	h[1] = 2
	h[2] = d
	h[3] = 0
	return rt_fault_join(h)
}

// rt_task_swap stores the running registers into from and continues with those in to.
fn rt_task_swap(from i64, to i64) {
}

// rt_task_new makes a task that will run body(arg); rt_task_run starts it.
fn rt_task_new(body fn(i64), arg i64) i64 {
	mut t = freeTasks
	if t != 0 {
		freeTasks = t[tNext]
        freeTaskCount -= 1
    } else {
        t = calloc(taskWords,8)
    }
    if t[tStack] == 0 {
        let base = mem_map(taskStack+taskGuard,MAP_STACK)
        if i64(i32(rt_sys_mprotect(base,taskGuard,0))) != 0 { mem_oom(taskStack+taskGuard) }
        t[tStack] = base
    }
	t[tFn] = cast(i64, body)
	t[tArg] = arg
	t[tDone] = 0
	t[tFault] = 0
	t[tDeadline] = 0
	t[tWake] = 0
	t[tNext] = 0
	t[tFmt] = 0
	t[tCleanup] = 0
	t[tRecover] = 0
	t[tPanicked] = 0
	t[tRecoverable] = 0
	t[tTrim] = 0
	t[tBnd] = 0
	t[tDefer] = 0
	t[tChild] = 0
	t[tTape] = 0
	t[tEpNext] = 0
	t[tEpPrev] = 0
	// The limbo keeps what the task's maker could have handed it (#176): a task made by a
	// task inherits its epoch, one made on the core's own stack the stack's.
	if curTask != 0 {
		rt_rc_live_add(t, curTask[tEp])
	} else {
		rt_rc_live_add(t, coreQ)
	}
	for i in 0..20 {
		t[tSave+i] = 0
	}
	rt_task_init(t, (t[tStack]+taskStack+taskGuard)&-16)
	return t
}

// rt_task_entry is where a new task starts: it runs its function, zeroes its pool and
// switches back for good (a reused task starts over from rt_task_new).
fn rt_task_entry() {
	let t = curTask
	let f = cast(fn(i64), t[tFn])
	f(t[tArg])
	rt_task_cleanups(0)
	rt_bnd_task_end(t)
	rt_rc_live_del(t)
	rt_epoch_release()
	// A scope's child allocates in its parent's pool (#232): that memory stays.
	if t[tChild] == 0 || t[tChild][spOwnPool] != 0 {
		if __ctx()[ctxPoolExtra] != 0 || rt_pool_used() > 65536 { t[tTrim] = 1 }
		rt_pool_reset()
	}
	t[tDone] = 1
	rt_task_swap(t, schedSave)
}

// rt_task_recover makes a panic in task t end t only: rt_panic prints the message and the
// backtrace, runs t's cleanups, resets its pool and switches back to the core as if t had
// finished; rt_task_panicked then reports it. A panic while those cleanups run ends the process.
fn rt_task_recover(t i64) {
	t[tRecover] = 1
	t[tRecoverable] = 1
}

fn rt_task_panicked(t i64) bool {
	return t[tPanicked] != 0
}

// rt_task_abort ends the running task t after a panic: its stack is abandoned where it is.
fn rt_task_abort(t i64) {
	rt_task_cleanups(0)
	rt_bnd_task_end(t)
	rt_rc_live_del(t)
	rt_epoch_release()
	// A scope's child allocates in its parent's pool (#232): that memory stays.
	if t[tChild] == 0 || t[tChild][spOwnPool] != 0 {
		if __ctx()[ctxPoolExtra] != 0 || rt_pool_used() > 65536 { t[tTrim] = 1 }
		rt_pool_reset()
	}
	t[tDone] = 1
	rt_task_swap(t, schedSave)
}

// rt_task_run runs task t until it finishes (true) or waits (false).
fn rt_task_run(t i64) bool {
	let tape = t[tTape]
	if tape != 0 && !rt_sched_resume(t) {
		return false // replaying: held until the tape says it is its turn (#243)
	}
	if schedSave == 0 {
		schedSave = calloc(20, 8)
		schedPool = calloc(6, 8)
	}
	let c = __ctx()
	// The core stack's pool words go to its innermost arena while it is in one (#236).
	mut sp = schedPool
	if arenaLive > 0 { sp = rt_pool_home(0) }
	sp[0] = c[ctxBump]
	sp[1] = c[ctxEnd]
	sp[2] = c[ctxPoolBase]
	sp[3] = c[ctxPoolMark]
	sp[4] = c[ctxPoolExtra]
	sp[5] = c[ctxFmt]
	// A scope's child runs in the pool of the task that owns its scope (or the core's own).
	mut pw = rt_pool_words(t)
	let arenas = arenaLive
	if arenas > 0 { pw = rt_pool_home(t) }
	c[ctxBump] = pw[0]
	c[ctxEnd] = pw[1]
	c[ctxPoolBase] = pw[2]
	c[ctxPoolMark] = pw[3]
	c[ctxPoolExtra] = pw[4]
	c[ctxFmt] = t[tFmt]
	curTask = t
	if rtPollsEnabled { rt_watch_switch() }
	rt_task_swap(schedSave, t)
	curTask = 0
	if rtPollsEnabled { rt_watch_switch() }
	if rt_task_sp(t) < t[tStack]+taskGuard+taskStack-16384 { t[tTrim] = 1 }
	if arenas > 0 || arenaLive > 0 { pw = rt_pool_home(t) }
	pw[0] = c[ctxBump]
	pw[1] = c[ctxEnd]
	pw[2] = c[ctxPoolBase]
	pw[3] = c[ctxPoolMark]
	pw[4] = c[ctxPoolExtra]
	t[tFmt] = c[ctxFmt]
	c[ctxBump] = sp[0]
	c[ctxEnd] = sp[1]
	c[ctxPoolBase] = sp[2]
	c[ctxPoolMark] = sp[3]
	c[ctxPoolExtra] = sp[4]
	c[ctxFmt] = sp[5]
	if tape != 0 {
		rt_sched_stopped(t) // replaying: a request whose tasks all wait for their turn diverged
	}
	return t[tDone] != 0
}

// rt_pool_words is where task t's pool words live: its own, or for a scope's child those of
// the nearest task that is not a child (the core's own while a scope in main waits).
fn rt_pool_words(t i64) i64 {
	for t != 0 && t[tChild] != 0 && t[tChild][spOwnPool] == 0 {
		t = t[tChild][spScope][bTask]
	}
	if t == 0 {
		return schedPool
	}
	return t + 8*tPool
}

// rt_task_yield switches from the running task back to the core; rt_task_run continues it.
fn rt_task_yield() {
	let t = curTask
	if t == 0 {
		rt_panic("rt_task_yield outside a task")
	}
	rt_task_swap(t, schedSave)
}

// rt_task_free trims heavy pools/stacks and unmaps overflow records, caching at most 64.
fn rt_task_free(t i64) {
	// A task that never ran is still on the live list (#176).
	rt_rc_live_del(t)
    if freeTaskCount >= maxFreeTasks {
        rt_pool_gave(t[tPool+2], true)
        free(t[tPool+2])
        rt_sys_munmap(t[tStack],taskStack+taskGuard)
        // Stale timer entries still read this record; the last one to pop frees it.
        if t[tTimers] > 0 {
            t[tRetired] = 1
            return
        }
        free(t)
        return
    }
    if t[tTrim] != 0 {
        rt_memory_discard(t[tPool+2])
        if i64(i32(rt_sys_madvise(t[tStack]+taskGuard,taskStack,MEM_DONTNEED))) != 0 {
            rt_sys_munmap(t[tStack],taskStack+taskGuard)
            t[tStack] = 0
        }
    }
    t[tNext] = freeTasks
    freeTasks = t
    freeTaskCount += 1
}

fn rt_task_current() i64 {
	return curTask
}

// rt_task_cleanup registers a resource to release before the current task's pool ends.
// A scope also runs the cleanups registered inside it before resetting its pool.
fn rt_task_cleanup(f fn(i64), arg i64) {
	if curTask == 0 {
		return
	}
	let r = calloc(3, 8)
	r[0] = curTask[tCleanup]
	r[1] = cast(i64, f)
	r[2] = arg
	curTask[tCleanup] = r
}

// rt_defer_rec makes a defer record with n value words after its two header words.
fn rt_defer_rec(n i64) i64 {
	return calloc(n+2, 8)
}

// rt_defer_push puts record r, made for the call call(r), on the running code's defer chain.
fn rt_defer_push(r i64, call fn(i64)) {
	r[1] = cast(i64, call)
	if curTask != 0 {
		r[0] = curTask[tDefer]
		curTask[tDefer] = r
		return
	}
	r[0] = coreDefer
	coreDefer = r
}

// rt_defer_mark is the defer chain's head: a function's returns run the chain back to it.
fn rt_defer_mark() i64 {
	if curTask != 0 {
		return curTask[tDefer]
	}
	return coreDefer
}

// rt_defer_run makes the deferred calls registered since mark, last first.
fn rt_defer_run(mark i64) {
	for {
		mut r = coreDefer
		if curTask != 0 {
			r = curTask[tDefer]
		}
		if r == mark || r == 0 {
			return
		}
		if curTask != 0 {
			curTask[tDefer] = r[0]
		} else {
			coreDefer = r[0]
		}
		let f = cast(fn(i64), r[1])
		f(r)
		free(r)
	}
}

// ---- guard: a panic inside the block becomes its fault (#230) ----
//
// rt_guard_call runs a guard block's closure on a stack of its own. A panic inside runs the
// deferred calls and cleanups registered since the guard began, leaves the boundaries the
// block entered, and switches back to the guard's caller with "panic: <message>"; the
// abandoned stack is reused. A panic while that unwinding runs ends the process.

const gSave = 0     // 20 words: the guard caller's registers
const gCtx = 20     // 20 words: the guard stack's registers
const gScratch = 40 // 20 words: the registers of a stack being left for good
const gBody = 60
const gArg = 61
const gFault = 62
const gDefer = 63
const gCleanup = 64
const gFmt = 65
const gStack = 66
const gBnd = 67
const gUnwinding = 68
const guardWords = 69

mut guardStart i64  // per core: the record rt_guard_entry starts
mut guardStacks i64 // per core: free guard stacks, linked through their lowest word

fn rt_guard_call(body fn(i64) !, r i64) i64 {
	return rt_land_call(bkGuard|bfGuard, body, r, 0, 0)
}

// rt_limit_call runs a limit block's closure: pool memory taken inside it (and tasks started
// in it) count against mem bytes and tasks (0: no bound). Passing the memory budget leaves the
// block with "limit exceeded" (#235).
fn rt_limit_call(body fn(i64) !, r i64, mem i64, tasks i64) i64 {
	return rt_land_call(bkLimit, body, r, mem, tasks)
}

// rt_within_call gives within a landing before its body can hit a poll.
fn rt_within_call(body fn(i64) !, r i64, duration i64) i64 {
	return rt_land_call(bkWithin, body, r, rt_mono_ns()+duration, 0)
}

// rt_land_call runs body(r) on a stack of its own inside a new boundary of the given kind, so
// a panic (guard) or a passed budget (limit) can leave it from anywhere inside.
fn rt_land_call(kind i64, body fn(i64) !, r i64, mem i64, tasks i64) i64 {
	let g = calloc(guardWords, 8)
	let b = rt_bnd_enter(kind)
	b[bLand] = g
	if kind == bkWithin {
		rt_watch_start()
		rt_bnd_set_deadline(b, mem)
	} else if mem > 0 || tasks > 0 {
		b[bMemMax] = mem
		b[bTaskMax] = tasks
		b[bLimit] = b
	}
	g[gBody] = cast(i64, body)
	g[gArg] = r
	g[gDefer] = rt_defer_mark()
	if curTask != 0 {
		g[gCleanup] = curTask[tCleanup]
	}
	g[gFmt] = __ctx()[ctxFmt]
	g[gBnd] = b
	mut st = guardStacks
	if st != 0 {
		guardStacks = (st + taskGuard)[0]
	} else {
		st = mem_map(taskStack+taskGuard, MAP_STACK)
		if i64(i32(rt_sys_mprotect(st, taskGuard, 0))) != 0 {
			mem_oom(taskStack + taskGuard)
		}
	}
	g[gStack] = st
	rt_ctx_init(g+8*gCtx, (st+taskStack+taskGuard)&-16, cast(i64, rt_guard_entry))
	guardStart = g
	rt_task_swap(g+8*gSave, g+8*gCtx)
	let f = g[gFault]
	(st + taskGuard)[0] = guardStacks
	guardStacks = st
	rt_bnd_leave(b)
	free(g)
	return f
}

// rt_guard_entry runs a guard's closure on the guard stack, then switches back.
fn rt_guard_entry() {
	let g = guardStart
	let body = cast(fn(i64) !, g[gBody])
	body(g[gArg]) catch err {
		g[gFault] = cast(i64, err)
	}
	rt_task_swap(g+8*gScratch, g+8*gSave)
}

// rt_guard_target is the guard record a panic here stops at, or 0 when the nearest guarding
// boundary is a request, a task root or the core (the existing per-task recovery applies).
fn rt_guard_target() i64 {
	if bndRoot == 0 && (curTask == 0 || curTask[tBnd] == 0) {
		return 0
	}
	mut b = rt_bnd_current()
	for b != 0 {
		if b[bKind]&bfGuard != 0 {
			if b[bKind]&255 == bkGuard {
				return b[bLand]
			}
			return 0
		}
		b = b[bParent]
	}
	return 0
}

// rt_guard_land unwinds to guard g after a panic with msg and resumes its caller.
fn rt_guard_land(g i64, msg str) {
	rt_land(g, rt_fault_panic("panic: "+msg, rt_backtrace_text(__fp())))
}

// rt_bnd_landing distinguishes unwind stacks from a scope's child-list word.
fn rt_bnd_landing(b i64) i64 {
	let k = b[bKind]&255
	if k == bkWithin || k == bkGuard || k == bkLimit { return b[bLand] }
	return 0
}

// rt_bnd_join_scopes stops and joins children before their parent's defers run.
fn rt_bnd_join_scopes(target i64, f i64) {
	mut b = rt_bnd_current()
	for b != 0 {
		if b[bKind]&255 == bkScope {
			rt_bnd_cancel(b, cast(fault, f))
			for b[bLive] > 0 { rt_scope_block(b, 0) }
		}
		if b == target || b[bKind]&bfRoot != 0 { break }
		b = b[bParent]
	}
}

// rt_scope_discard releases joined child handles after the unwinding defers finish.
fn rt_scope_discard(b i64) {
	mut r = b[bLand]
	for r != 0 {
		let n = r[spNext]
		rt_sp_free(r)
		r = n
	}
	b[bLand] = 0
}

// rt_land unwinds to the boundary of record g, which then gives fault word f, and resumes its
// caller: deferred calls and cleanups registered since it began run, and the boundaries
// entered inside it are left (their own stacks go back to the cache).
fn rt_land(g i64, f i64) {
	if g[gUnwinding] != 0 {
		rt_flush()
		rt_sys_exit(2)
	}
	g[gUnwinding] = 1
	rt_bnd_join_scopes(g[gBnd], f)
	rt_defer_run(g[gDefer])
	if curTask != 0 {
		rt_task_cleanups(g[gCleanup])
	}
	let b = g[gBnd]
	for rt_bnd_current() != b {
		let in = rt_bnd_current()
		if in[bKind]&255 == bkScope { rt_scope_discard(in) }
		if in[bKind]&255 == bkArena { f = rt_arena_discard(in, f) }
		let ig = rt_bnd_landing(in)
		if ig != 0 {
			let st = ig[gStack]
			(st + taskGuard)[0] = guardStacks
			guardStacks = st
		}
		rt_bnd_leave(in)
		if ig != 0 {
			free(ig)
		}
	}
	g[gFault] = f
	__ctx()[ctxFmt] = g[gFmt]
	rt_task_swap(g+8*gScratch, g+8*gSave)
}

// ---- arena: a sub-region dropped on exit (#236, notes/interface_arena.md) ----
//
// An arena is a fresh pool. rt_arena_open writes the parent pool's words back to their home
// (scope children sharing it keep using it while the body waits), the body runs, rt_arena_out
// gives the context the parent pool again, the compiler copies the result there, and
// rt_arena_close frees the arena. Unwinds discard arenas in rt_land and rt_bnd_task_end.

const aBump = 0     // 5 words: the arena pool's words while they are not in the context
const aBase = 2     // the arena pool's base chunk (with aBump)
const aExtra = 4    // its extra chunks and big blocks
const aFmt = 5      // the formatting state while the core stack is switched out (rt_task_run)
const aFmt0 = 6     // the formatting state at entry
const aCleanup = 7  // the running task's cleanup chain at entry
const aOut = 8      // 1 after rt_arena_out: the context holds the parent pool
const aCharged = 9  // pool bytes charged to limit budgets inside the arena
const arenaWords = 10

mut arenaLive i64 // per core: open arenas

// rt_pool_home is where the pool words of task t (0: the core stack) live while it is not
// running: the innermost arena it entered and has not left, else rt_pool_words(t).
fn rt_pool_home(t i64) i64 {
	if arenaLive > 0 {
		mut b = bndCur
		if t != 0 {
			b = t[tBnd]
		}
		for b != 0 {
			if b[bKind]&255 == bkArena && b[bTask] == t && b[bRegion][aOut] == 0 {
				return b[bRegion]
			}
			if b[bKind]&bfRoot != 0 {
				break
			}
			b = b[bParent]
		}
	}
	return rt_pool_words(t)
}

// rt_pool_save stores the context's pool words at p.
fn rt_pool_save(p i64) {
	let c = __ctx()
	p[0] = c[ctxBump]
	p[1] = c[ctxEnd]
	p[2] = c[ctxPoolBase]
	p[3] = c[ctxPoolMark]
	p[4] = c[ctxPoolExtra]
}

// rt_pool_load gives the context the pool words at p.
fn rt_pool_load(p i64) {
	let c = __ctx()
	c[ctxBump] = p[0]
	c[ctxEnd] = p[1]
	c[ctxPoolBase] = p[2]
	c[ctxPoolMark] = p[3]
	c[ctxPoolExtra] = p[4]
}

// rt_arena_open enters an arena: a bkArena boundary whose allocations go to a fresh pool.
fn rt_arena_open() i64 {
	if schedSave == 0 {
		schedSave = calloc(20, 8)
		schedPool = calloc(6, 8)
	}
	rt_pool_save(rt_pool_home(curTask))
	let b = rt_bnd_enter(bkArena)
	let a = calloc(arenaWords, 8)
	let c = __ctx()
	a[aFmt0] = c[ctxFmt]
	if curTask != 0 {
		a[aCleanup] = curTask[tCleanup]
	}
	b[bRegion] = a
	arenaLive += 1
	c[ctxBump] = 0
	c[ctxEnd] = 0
	c[ctxPoolBase] = 0
	c[ctxPoolMark] = 0
	c[ctxPoolExtra] = 0
	c[ctxFmt] = 0
	return b
}

// rt_arena_run runs an arena block's closure and gives its fault as a word (0: none).
fn rt_arena_run(body fn(i64) !, r i64) i64 {
	body(r) catch err {
		return cast(i64, err)
	}
	return 0
}

// rt_arena_out runs the cleanups registered inside arena b and gives the context the parent
// pool again; the arena's memory stays readable until rt_arena_close.
fn rt_arena_out(b i64) {
	let a = b[bRegion]
	if curTask != 0 {
		rt_task_cleanups(a[aCleanup])
	}
	rt_arena_switch(a)
}

// rt_arena_switch saves the arena pool in its record and loads the parent pool.
fn rt_arena_switch(a i64) {
	rt_pool_save(a)
	a[aOut] = 1
	rt_pool_load(rt_pool_home(curTask))
	__ctx()[ctxFmt] = a[aFmt0]
}

// rt_arena_fault copies fault word f into the current pool (0 stays 0).
fn rt_arena_fault(f i64) i64 {
	return rt_fault_copy(f, false)
}

// rt_arena_free frees arena record a's pool and gives its charges back to b's limit budgets.
fn rt_arena_free(b i64, a i64) {
	{
		mut p = a[aExtra]
		for p != 0 {
			let next = p[0]
			rt_pool_gave(p, false)
			free(p)
			p = next
		}
	}
	if a[aBase] != 0 {
		rt_pool_gave(a[aBase], true)
		free(a[aBase])
	}
	if a[aCharged] != 0 {
		{
			mut l = b[bLimit]
			for l != 0 {
				l[bMemUsed] -= a[aCharged]
				let p = l[bParent]
				if p == 0 {
					break
				}
				l = p[bLimit]
			}
		}
	}
	free(a)
	b[bRegion] = 0
	arenaLive -= 1
}

// rt_arena_close frees arena b after its result was copied out, and leaves it.
fn rt_arena_close(b i64) {
	rt_arena_free(b, b[bRegion])
	rt_bnd_leave(b)
}

// rt_arena_discard frees arena b on an unwind that leaves it (the caller unlinks b); fault
// word f, which may have been made in the arena, comes back copied into the parent pool.
fn rt_arena_discard(b i64, f i64) i64 {
	let a = b[bRegion]
	if a == 0 {
		return f
	}
	if a[aOut] == 0 {
		rt_arena_switch(a)
	}
	f = rt_fault_copy(f, false)
	rt_arena_free(b, a)
	return f
}

// rt_arena_task_end discards arena b of task t, which ends by panic: a scope child's fault,
// made in the pool it was using, is copied into the parent pool first.
fn rt_arena_task_end(t i64, b i64) {
	let sp = t[tChild]
	if sp != 0 && sp[spOwnPool] == 0 && sp[spFault] != 0 {
		sp[spFault] = rt_arena_discard(b, sp[spFault])
		return
	}
	rt_arena_discard(b, 0)
}

// rt_arena_charged notes pool bytes n charged to limit budgets inside the innermost arena.
fn rt_arena_charged(n i64) {
	mut b = rt_bnd_current()
	for b != 0 {
		if b[bKind]&255 == bkArena && b[bRegion] != 0 && b[bRegion][aOut] == 0 {
			b[bRegion][aCharged] += n
			return
		}
		if b[bKind]&bfRoot != 0 {
			return
		}
		b = b[bParent]
	}
}

fn rt_task_cleanups(stop i64) {
	if curTask == 0 {
		return
	}
	for curTask[tCleanup] != stop {
		let r = curTask[tCleanup]
		curTask[tCleanup] = r[0]
		let f = cast(fn(i64), r[1])
		f(r[2])
		free(r)
	}
}

// A pool scope preserves the caller's objects while a stream processes short-lived
// messages in its own reusable pool. Formatting state belongs to the scope too.
fn rt_pool_enter() i64 {
	let c = __ctx()
	let s = calloc(7, 8)
	s[0] = c[ctxBump]
	s[1] = c[ctxEnd]
	s[2] = c[ctxPoolBase]
	s[3] = c[ctxPoolMark]
	s[4] = c[ctxPoolExtra]
	s[5] = c[ctxFmt]
	if curTask != 0 {
		s[6] = curTask[tCleanup]
	}
	c[ctxBump] = 0
	c[ctxEnd] = 0
	c[ctxPoolBase] = 0
	c[ctxPoolMark] = 0
	c[ctxPoolExtra] = 0
	c[ctxFmt] = 0
	return s
}

fn rt_pool_scope_reset(s i64) {
	rt_task_cleanups(s[6])
	// Not a quiescent point (#176): the code around the scope may still hold borrows.
	rt_pool_clear()
	rt_epoch_release()
	__ctx()[ctxFmt] = 0
}

fn rt_pool_leave(s i64) {
	rt_pool_scope_reset(s)
	let c = __ctx()
	rt_pool_gave(c[ctxPoolBase], true)
	free(c[ctxPoolBase])
	c[ctxBump] = s[0]
	c[ctxEnd] = s[1]
	c[ctxPoolBase] = s[2]
	c[ctxPoolMark] = s[3]
	c[ctxPoolExtra] = s[4]
	c[ctxFmt] = s[5]
	free(s)
}

// rt_heap_str copies a string out of any pool for a helper job or scope result.
fn rt_heap_str(s str) i64 {
	let p = calloc(1, len(s)+9)
	p[0] = len(s)
	memcpy(p+8, cast(i64, s)+8, len(s))
	return p
}

// rt_task_set_deadline makes every wait of task t give up at mono time at (0: never).
fn rt_task_set_deadline(t i64, at i64) {
	t[tDeadline] = at
	if t[tBnd] != 0 {
		rt_bnd_set_deadline(rt_bnd_root(t), at)
	}
}

// ---- boundaries: cancel state, deadline, budget and slots (notes/interface_boundaries.md) ----
//
// Every task and block boundary has a record, linked to its parent in a per-core tree.
// Cancelling a record cancels its subtree, never its parent or siblings, and ends the waits
// of the tasks inside it with waitDeadline; rt_wait_fault gives the fault they fail with.

// rt_bnd_alloc takes a record from the core's free list; rt_bnd_new writes every word.
fn rt_bnd_alloc() i64 {
	let b = bndFree
	if b == 0 {
		return calloc(bndWords, 8)
	}
	bndFree = b[0]
	return b
}

// rt_bnd_core is this core's root boundary, made the first time it is asked for.
fn rt_bnd_core() i64 {
	if bndRoot == 0 {
		bndRoot = calloc(bndWords, 8)
		bndRoot[bKind] = bkCore | bfGuard
	}
	return bndRoot
}

// rt_bnd_background is this core's boundary for long-lived work (detach, ticks, handlers).
fn rt_bnd_background() i64 {
	if bndBack == 0 {
		bndBack = rt_bnd_new(rt_bnd_core(), bkBackground, 0)
	}
	return bndBack
}

// rt_bnd_current is the running task's current boundary, or the core stack's.
fn rt_bnd_current() i64 {
	let t = curTask
	if t != 0 && t[tBnd] != 0 {
		return t[tBnd]
	}
	if t == 0 && bndCur != 0 {
		return bndCur
	}
	return rt_bnd_core()
}

// rt_bnd_new links a record for task t (0: the core stack) under parent, inheriting its state.
fn rt_bnd_new(parent i64, kind i64, t i64) i64 {
	let b = rt_bnd_alloc()
	b[bParent] = parent
	b[bKind] = kind
	b[bTask] = t
	b[bCancel] = parent[bCancel]
	b[bOrigin] = parent[bOrigin]
	b[bDeadline] = parent[bDeadline]
	b[bDlOwner] = parent[bDlOwner]
	b[bLimit] = parent[bLimit]
	b[bMemMax] = 0
	b[bMemUsed] = 0
	b[bTaskMax] = 0
	b[bTaskUsed] = 0
	b[bSlots] = parent[bSlots]
	b[bChild] = 0
	b[bPrev] = 0
	b[bCleanup] = 0
	if t != 0 {
		b[bCleanup] = t[tCleanup]
	}
	b[bLand] = 0
	b[bRegion] = 0
	b[bRegion+1] = 0
	b[bRegion+2] = 0
	b[bFault] = 0
	b[bOwnDl] = 0
	let n = parent[bChild]
	b[bNext] = n
	if n != 0 {
		n[bPrev] = b
	}
	parent[bChild] = b
	return b
}

// rt_bnd_unlink takes b out of its parent's children and returns it to the free list.
fn rt_bnd_unlink(b i64) {
	let p = b[bParent]
	if b[bPrev] != 0 {
		b[bPrev][bNext] = b[bNext]
	} else if p != 0 {
		p[bChild] = b[bNext]
	}
	if b[bNext] != 0 {
		b[bNext][bPrev] = b[bPrev]
	}
	b[0] = bndFree
	bndFree = b
}

// rt_bnd_enter makes a child of the current boundary the current one.
fn rt_bnd_enter(kind i64) i64 {
	let t = curTask
	let b = rt_bnd_new(rt_bnd_current(), kind, t)
	if t != 0 {
		t[tBnd] = b
	} else {
		bndCur = b
	}
	rt_watch_update()
	return b
}

// rt_bnd_leave ends the current boundary b normally: its parent is current again.
fn rt_bnd_leave(b i64) {
	let t = b[bTask]
	let p = b[bParent]
	if t != 0 {
		t[tBnd] = p
		t[tDeadline] = p[bDeadline]
	} else if p == bndRoot {
		bndCur = 0
	} else {
		bndCur = p
	}
	rt_bnd_unlink(b)
	rt_watch_update()
}

// rt_slot_bind binds slot key to value on the current boundary (with policy.Bind, #237): a node
// [next, key, value] in the current pool, seen by everything entered or spawned inside it later.
fn rt_slot_bind(key i64, value i64) {
	let b = rt_bnd_current()
	let n = rt_alloc(24)
	n[0] = b[bSlots]
	n[1] = key
	n[2] = value
	b[bSlots] = n
}

// rt_slot_find is the newest binding node of slot key seen from the current boundary, or 0.
fn rt_slot_find(key i64) i64 {
	mut n = rt_bnd_current()[bSlots]
	for n != 0 {
		if n[1] == key {
			return n
		}
		n = n[0]
	}
	return 0
}

// rt_bnd_task gives task t a root boundary under parent before it first runs.
fn rt_bnd_task(t i64, parent i64, kind i64) ! {
	let l = parent[bLimit]
	if l != 0 && l[bTaskMax] > 0 && l[bTaskUsed] >= l[bTaskMax] {
		fail cast(fault, rt_fault_limit())
	}
	if l != 0 {
		l[bTaskUsed] += 1
	}
	let b = rt_bnd_new(parent, kind | bfRoot | bfGuard, t)
	b[bCleanup] = 0
	t[tBnd] = b
	t[tDeadline] = b[bDeadline]
}

// rt_bnd_root is the root boundary of task t.
fn rt_bnd_root(t i64) i64 {
	mut b = t[tBnd]
	for b != 0 && b[bKind] & bfRoot == 0 {
		b = b[bParent]
	}
	return b
}

// rt_bnd_task_end leaves every boundary of the finished task t, its root last.
fn rt_bnd_task_end(t i64) {
	mut b = t[tBnd]
	for b != 0 {
		let p = b[bParent]
		let root = b[bKind] & bfRoot != 0
		if root {
			let l = p[bLimit]
			if l != 0 {
				l[bTaskUsed] -= 1
			}
		}
		if b[bKind]&255 == bkScope { rt_scope_discard(b) }
		if b[bKind]&255 == bkArena { rt_arena_task_end(t, b) }
		let g = rt_bnd_landing(b)
		if g != 0 {
			let st = g[gStack]
			(st + taskGuard)[0] = guardStacks
			guardStacks = st
			free(g)
		}
		rt_bnd_unlink(b)
		if root {
			break
		}
		b = p
	}
	t[tBnd] = 0
}

// rt_bnd_set_deadline sets b's own deadline (mono ns, 0: none); b and everything inside it
// take the earlier of their own and their parent's.
fn rt_bnd_set_deadline(b i64, at i64) {
	b[bOwnDl] = at
	mut d = b
	for {
		let p = d[bParent]
		let own = d[bOwnDl]
		if p != 0 && p[bDeadline] > 0 && (own == 0 || p[bDeadline] <= own) {
			d[bDeadline] = p[bDeadline]
			d[bDlOwner] = p[bDlOwner]
		} else if own > 0 {
			d[bDeadline] = own
			d[bDlOwner] = d
		} else {
			d[bDeadline] = 0
			d[bDlOwner] = 0
		}
		let t = d[bTask]
		if t != 0 && t[tBnd] == d {
			t[tDeadline] = d[bDeadline]
		}
		if d[bChild] != 0 {
			d = d[bChild]
			continue
		}
		for d != b && d[bNext] == 0 {
			d = d[bParent]
		}
		if d == b {
			break
		}
		d = d[bNext]
	}
	rt_watch_update()
}

// rt_bnd_charge counts n pool bytes against every memory budget around the running code. Past
// a limit block's budget the block is left with "limit exceeded"; past a request's
// (TIN_REQUEST_MEMORY) the request ends as if it had panicked.
fn rt_bnd_charge(n i64) {
	if bndRoot == 0 {
		return
	}
	if curTask != 0 && curTask[tBnd] == 0 {
		return
	}
	if curTask == 0 && bndCur == 0 {
		return
	}
	mut l = rt_bnd_current()[bLimit]
	if l != 0 && arenaLive > 0 { rt_arena_charged(n) }
	mut over = 0
	for l != 0 {
		l[bMemUsed] += n
		if over == 0 && l[bMemMax] > 0 && l[bMemUsed] > l[bMemMax] {
			over = l
		}
		let p = l[bParent]
		if p == 0 {
			break
		}
		l = p[bLimit]
	}
	if over == 0 {
		return
	}
	if over[bKind]&bfRoot != 0 {
		rt_panic("limit exceeded: the request's memory budget (TIN_REQUEST_MEMORY)")
	}
	rt_bnd_cancel(over, cast(fault, rt_fault_limit()))
	if over[bLand] != 0 {
		rt_land(over[bLand], rt_fault_limit())
	}
}

// rt_bnd_set_limit gives b a memory budget (bytes) and a task budget (0: no bound).
fn rt_bnd_set_limit(b i64, mem i64, tasks i64) {
	b[bMemMax] = mem
	b[bTaskMax] = tasks
	b[bLimit] = b
}

// ---- scope and spawn: structured concurrency on the core (#232) ----
//
// scope s { ... } opens a scope boundary; s.spawn(f) starts f as a child task under it, on
// this core. Children run when the current task waits; the scope's end waits for all of
// them. The first child fault cancels the scope (so its other children) and is the scope's
// fault. Children run on their own stacks and share their parent's memory.

type scope struct {
	b i64
}

// spawned is a child task started by spawn.
type spawned struct {
	r i64
}

const spTask = 0
const spBody = 1
const spFault = 2
const spDone = 3
const spWaiter = 4
const spScope = 5
const spNext = 6
const spCanceled = 7 // cancelled through its handle: its fault is not the scope's
const spArg = 8      // 1 + the argument of a body that takes one (parallel's result cell)
const spOwnPool = 9  // a detached task: its own pool, and its fault is logged, not passed on
const spMore = 10    // waiters beyond spWaiter: [capacity, count, task...], or 0
const spNum = 11     // the child's number in its request (#243), 0 when it has no tape
const spWords = 12

// rt_scope_open starts a scope boundary inside the current one.
fn rt_scope_open() scope {
	return scope{b: rt_bnd_enter(bkScope)}
}

// spawn starts f as a child of scope s; it runs when the current task next waits.
fn (s scope) spawn(f fn() !) spawned {
	let b = s.b
	let r = calloc(spWords, 8)
	r[spBody] = cast(i64, f)
	r[spScope] = b
	r[spNext] = b[bLand]
	b[bLand] = r
	let t = rt_task_new(rt_child_main, r)
	if curTask != 0 {
		t[tTape] = curTask[tTape] & -2 // a request's children share its replay tape (#241)
	}
	r[spTask] = t
	if rt_bnd_task(t, b, bkTask) != nil {
		// Over the task budget of a limit around the scope (#235).
		rt_task_free(t)
		r[spTask] = 0
		r[spFault] = rt_fault_limit()
		r[spDone] = 1
		rt_child_fault(b, r[spFault])
		return spawned{r: r}
	}
	t[tChild] = r
	if t[tTape] != 0 {
		rt_sched_spawned(t[tTape], r) // its number in the request, for sched.resume (#243)
	}
	rt_task_recover(t)
	b[bLive] += 1
	rt_task_queue(t)
	return spawned{r: r}
}

// cancel cancels scope s by hand (#143): its children's waits and its own fail with
// "canceled: reason", and the scope's fault is that fault, unless a child failed first.
fn (s scope) cancel(reason str) {
	let b = s.b
	if b[bFault] != 0 || b[bCancel] != 0 {
		return
	}
	let r = rt_fault_new(reason, 0, 0)
	let c = rt_fault_wrap(r, "canceled")
	let cb = c - faultHead
	cb[fhIdent] = faultCanceled
	b[bFault] = c
	rt_bnd_cancel(b, cast(fault, r))
}

// yield lets the other ready tasks of this core run before the current one goes on (#143);
// on the core's own stack it runs one ready task, if there is one.
fn (s scope) yield() {
	if curTask != 0 {
		rt_task_defer()
		return
	}
	let t = rt_task_take_ready()
	if t != 0 {
		rt_task_resume(t)
	}
}

// wait waits until the child has finished and gives its fault, if any.
fn (h spawned) wait() ! {
	let r = h.r
	for r[spDone] == 0 {
		rt_scope_block(r[spScope], r)
	}
	if r[spFault] != 0 {
		fail cast(fault, r[spFault])
	}
}

// cancel cancels the child (its waits fail with "canceled: canceled").
fn (h spawned) cancel() {
	let r = h.r
	if r[spDone] == 0 && r[spTask] != 0 {
		r[spCanceled] = 1
		rt_bnd_cancel(rt_bnd_root(r[spTask]), cast(fault, rt_fault_canceled()))
	}
}

// ---- values from spawn (#232) ----

// spawnedValue admits the value of any spawned function.
shape spawnedValue {}

// spawnedOf is the handle of a child that gives a value: t := s.spawn(fn() !T { ... }), then
// t.wait() !T. The child writes its value into v, one element the handle shares; like
// everything the child makes, it lives in its parent's memory.
type spawnedOf[T spawnedValue] struct {
	h spawned
	v []T
}

// rt_spawn_value starts f as a child of s whose value the handle gives: the compiler's
// lowering of s.spawn(f) for a function with a value.
fn rt_spawn_value[T spawnedValue](s scope, f fn() !T) spawnedOf[T] {
	// The child runs after this returns, so what it uses is held in slices (cells in memory),
	// never in this frame.
	let fs = []fn() !T{f}
	let v = make([]T, 1)
	let h = s.spawn(fn() ! {
		v[0] = try fs[0]()
	})
	return spawnedOf[T]{h: h, v: v}
}

// wait waits until the child has finished and gives its value, or its fault.
fn (t spawnedOf[T]) wait() !T {
	try t.h.wait()
	return t.v[0]
}

// cancel cancels the child (its waits fail with "canceled: canceled").
fn (t spawnedOf[T]) cancel() {
	t.h.cancel()
}

// ready, watch and unwatch are a select arm's view of the child, as for spawned.
fn (t spawnedOf[T]) ready() bool {
	return t.h.ready()
}

fn (t spawnedOf[T]) watch() {
	t.h.watch()
}

fn (t spawnedOf[T]) unwatch() {
	t.h.unwatch()
}

// rt_scope_open_word and rt_scope_close_word are the scope calls of a parallel block's wrapper,
// with the scope as a word and the fault as the result (#232).
fn rt_scope_open_word() i64 {
	return rt_bnd_enter(bkScope)
}

fn rt_scope_close_word(b i64) i64 {
	rt_scope_close(scope{b: b}) catch err {
		return cast(i64, err)
	}
	return 0
}

// rt_scope_spawn_arg starts body(arg) as a child of scope b (a parallel line).
fn rt_scope_spawn_arg(b i64, body fn(i64) !, arg i64) {
	let h = scope{b: b}.spawn(cast(fn() !, cast(i64, body)))
	h.r[spArg] = arg + 1
}

// rt_detach starts f as a task in the core's background boundary (detach { }, #232). It has
// its own pool, outlives the request that started it, runs when the core's event loop turns,
// and is cancelled with the rest of the core by the drain. Its fault is logged.
fn rt_detach(f fn() !) {
	let b = rt_bnd_background()
	let r = calloc(spWords, 8)
	r[spBody] = cast(i64, f)
	r[spScope] = b
	r[spOwnPool] = 1
	let t = rt_task_new(rt_child_main, r)
	r[spTask] = t
	if rt_bnd_task(t, b, bkTask) != nil {
		rt_task_free(t)
		free(r)
		return
	}
	t[tChild] = r
	rt_task_recover(t)
	b[bLive] += 1
	rt_task_queue(t)
}

// ---- select (#232): the runtime side of the lowering in check.tin ----

// rt_select_deadline is when an after(d) arm becomes ready (mono ns).
fn rt_select_deadline(d i64) i64 {
	return rt_mono_ns() + d
}

// rt_select_due reports whether an after arm's time has come.
fn rt_select_due(at i64) bool {
	return rt_mono_ns() >= at
}

// rt_select_canceled reports whether the current boundary is cancelled or past its deadline.
fn rt_select_canceled() bool {
	return rt_bnd_stopped()
}

// rt_select_min is the earlier of two deadlines (0: none).
fn rt_select_min(a i64, b i64) i64 {
	if a == 0 || (b != 0 && b < a) {
		return b
	}
	return a
}

// rt_select_park waits until a watched source wakes this task or deadline (mono ns, 0: none)
// comes; on the core's own stack it runs the core's tasks one step instead.
fn rt_select_park(deadline i64) {
	if curTask == 0 {
		rt_core_step_until(rt_select_min(deadline, rt_bnd_deadline(rt_bnd_current())))
		return
	}
	if deadline > 0 {
		let left = deadline - rt_mono_ns()
		if left <= 0 {
			return
		}
		rt_task_park(left)
		return
	}
	rt_task_park(0)
}

// rt_select_fail leaves a select whose boundary was cancelled, with the wait's fault.
fn rt_select_fail() ! {
	fail cast(fault, rt_wait_fault())
}

// rt_select_begin is a select's replay state (#243): -1 when its task has no tape, -2 when
// it records the winner, else (replaying) the recorded arm, the only one it checks and waits
// for; n (the number of arms) means it left by its boundary's fault.
fn rt_select_begin(site str, n i64) i64 {
	let t = curTask
	if t == 0 || t[tTape] == 0 || t[tTape]&1 != 0 {
		return -1
	}
	return rt_sched_select(t[tTape], site, n)
}

// rt_select_end records the arm a select took (state -2), or checks it took the recorded one.
fn rt_select_end(site str, state i64, arm i64) {
	rt_sched_select_end(curTask[tTape], site, state, arm)
}

// ready reports whether the child has finished (a select arm on t.wait()).
fn (h spawned) ready() bool {
	return h.r[spDone] != 0
}

// watch makes the child's end wake the running task (a select waiting on it).
fn (h spawned) watch() {
	if h.r[spDone] == 0 {
		rt_sp_watch(h.r)
	}
}

fn (h spawned) unwatch() {
	rt_sp_unwatch(h.r)
}

// rt_sp_watch adds the running task to those child record r's end wakes: any number of
// tasks may wait for one child (its parent, siblings, selects).
fn rt_sp_watch(r i64) {
	let t = curTask
	if t == 0 || r[spWaiter] == t {
		return
	}
	if r[spWaiter] == 0 {
		r[spWaiter] = t
		return
	}
	mut m = r[spMore]
	if m == 0 {
		m = calloc(6, 8)
		m[0] = 4
		r[spMore] = m
	}
	for i in 0..m[1] {
		if m[2+i] == t {
			return
		}
	}
	if m[1] == m[0] {
		m = realloc(m, 8*(2+2*m[0]))
		m[0] = 2 * m[0]
		r[spMore] = m
	}
	m[2+m[1]] = t
	m[1] += 1
}

// rt_sp_unwatch removes the running task from r's waiters.
fn rt_sp_unwatch(r i64) {
	let t = curTask
	if r[spWaiter] == t {
		r[spWaiter] = 0
	}
	let m = r[spMore]
	if m == 0 {
		return
	}
	for i in 0..m[1] {
		if m[2+i] == t {
			m[2+i] = m[2+m[1]-1]
			m[1] -= 1
			return
		}
	}
}

// rt_sp_wake wakes every task waiting for r's child, which has ended.
fn rt_sp_wake(r i64) {
	if r[spWaiter] != 0 {
		rt_task_wake(r[spWaiter])
		r[spWaiter] = 0
	}
	let m = r[spMore]
	if m == 0 {
		return
	}
	for i in 0..m[1] {
		rt_task_wake(m[2+i])
	}
	m[1] = 0
}

// rt_sp_free releases child record r.
fn rt_sp_free(r i64) {
	if r[spMore] != 0 {
		free(r[spMore])
	}
	free(r)
}

// rt_scope_close waits for every child of s, leaves the scope and gives its first fault.
fn rt_scope_close(s scope) ! {
	let b = s.b
	for b[bLive] > 0 {
		rt_scope_block(b, 0)
	}
	let f = b[bFault]
	mut r = b[bLand]
	for r != 0 {
		let n = r[spNext]
		rt_sp_free(r)
		r = n
	}
	b[bLand] = 0
	b[bFault] = 0
	rt_bnd_leave(b)
	if f != 0 {
		fail cast(fault, f)
	}
}

// rt_scope_exit leaves scope s when its body is left early, by a return or a try's fault: its
// children are cancelled and joined, their handles freed and its boundary left. Their faults
// are dropped: the body's own result is what leaves (#232).
fn rt_scope_exit(s scope) {
	let b = s.b
	if b[bLive] > 0 {
		rt_bnd_cancel(b, cast(fault, rt_fault_canceled()))
		for b[bLive] > 0 {
			rt_scope_block(b, 0)
		}
	}
	rt_scope_discard(b)
	b[bFault] = 0
	rt_bnd_leave(b)
}

// rt_scope_block lets children of b run until one finishes: a task parks (the child's end
// wakes it); code on the core's own stack runs them itself. Waiting for child r, the task
// may be any task of the core; waiting for the scope's end (r 0), it is the scope's own task.
fn rt_scope_block(b i64, r i64) {
	if curTask != 0 {
		let t = curTask
		if r != 0 {
			rt_sp_watch(r)
		} else {
			t[tScopeWait] = b
		}
		if rt_bnd_current()[bCancel] != 0 {
			// A cancelled wait returns at once: yield instead, so the children can finish.
			rt_task_defer()
		} else {
			rt_task_park(0)
		}
		t[tScopeWait] = 0
		if r != 0 {
			rt_sp_unwatch(r)
		}
		return
	}
	rt_core_step()
}

// rt_core_step lets the tasks of this core move on while code on the core's own stack (main)
// waits for them: it runs one woken task or due timer, or sleeps until the next timer.
fn rt_core_step() {
	rt_core_step_until(0)
}

// rt_core_step_until is rt_core_step for a wait with a deadline (mono ns, 0: none): with
// nothing to run it sleeps no later than the deadline instead of reporting a deadlock.
fn rt_core_step_until(deadline i64) {
	mut t = rt_task_take_ready()
	if t == 0 {
		let now = rt_mono_ns()
		t = rt_timer_pop(now)
		if t == 0 {
			mut next = rt_timer_next()
			if deadline > 0 && (next < 0 || deadline < next) {
				next = deadline
			}
			if next < 0 {
				rt_panic("deadlock: main waits for tasks that are all waiting for it")
			}
			rt_sleep_ns(next - now)
			return
		}
	}
	rt_task_resume(t)
}

// rt_task_resume runs task t until it waits or ends; an ended child is finished here.
fn rt_task_resume(t i64) {
	if rt_task_run(t) {
		rt_task_finish_child(t)
	}
}

// rt_child_main is a child task's body: run the closure and keep its fault.
fn rt_child_main(r i64) {
	if r[spArg] != 0 {
		let g = cast(fn(i64) !, r[spBody])
		g(r[spArg]-1) catch err {
			r[spFault] = cast(i64, err)
		}
		return
	}
	let f = cast(fn() !, r[spBody])
	f() catch err {
		r[spFault] = cast(i64, err)
		if r[spOwnPool] != 0 {
			// A detached task's fault lives in its own pool: log it before the pool ends.
			let m = "detached task failed: " + say_fault(err) + "\n"
			rt_write_all(2, cast(i64, m)+8, len(m))
		}
	}
}

fn say_fault(err fault) str {
	return cast(str, cast(i64, err))
}

// rt_task_finish_child completes ended child task t: its fault reaches the scope, its
// waiters wake, and the task is reused.
fn rt_task_finish_child(t i64) {
	let r = t[tChild]
	if r[spOwnPool] != 0 {
		// A detached task: nobody waits for it (rt_child_main logged its fault).
		r[spScope][bLive] -= 1
		free(r)
		t[tChild] = 0
		rt_task_free(t)
		return
	}
	if t[tPanicked] != 0 && r[spFault] == 0 {
		r[spFault] = rt_fault_std(faultPanic, "panic")
	}
	r[spDone] = 1
	r[spTask] = 0
	let b = r[spScope]
	b[bLive] -= 1
	if r[spFault] != 0 && r[spCanceled] == 0 {
		rt_child_fault(b, r[spFault])
	}
	rt_sp_wake(r)
	if b[bLive] == 0 && b[bTask] != 0 && b[bTask][tScopeWait] == b {
		// Only when it waits for the scope's end: any other wait of its own goes on.
		rt_task_wake(b[bTask])
	}
	if r[spNum] != 0 {
		rt_sched_ended(t[tTape]&-2, t)
	}
	t[tChild] = 0
	rt_task_free(t)
}

// rt_child_fault makes f the scope's fault (the first one wins) and cancels the scope.
fn rt_child_fault(b i64, f i64) {
	if b[bFault] == 0 {
		b[bFault] = f
		rt_bnd_cancel(b, cast(fault, f))
	}
}

// rt_task_queue puts task t on the core's ready queue, to run on the event loop's next turn.
fn rt_task_queue(t i64) {
	if readyHead+readyN == readyCap {
		if readyHead > 0 {
			memmove(readyQ, readyQ+8*readyHead, 8*readyN)
			readyHead = 0
		} else {
			readyCap = readyCap*2 + 64
			readyQ = realloc(readyQ, 8*readyCap)
		}
	}
	readyQ[readyHead+readyN] = t
	readyN += 1
}

// rt_task_is_child reports whether t is a scope's child task (not a request).
fn rt_task_is_child(t i64) bool {
	return t[tChild] != 0
}

// rt_bnd_deadline is b's effective deadline (mono ns), 0 for none.
fn rt_bnd_deadline(b i64) i64 {
	return b[bDeadline]
}

// rt_bnd_cancel cancels b and everything inside it with reason, and ends their waits. The
// first reason wins.
fn rt_bnd_cancel(b i64, reason fault) {
	if b[bCancel] != 0 {
		return
	}
	if !rt_sched_cancel(b, reason) {
		return // replaying: a deadline or a drain comes from the tape, not the clock (#243)
	}
	let r = cast(i64, reason)
	mut d = b
	for {
		// A drain reaching a request is that request's cancel on its tape (#243).
		if d[bCancel] == 0 && (d == b || d[bKind]&255 != bkRequest || rt_sched_cancel(d, reason)) {
			d[bCancel] = r
			d[bOrigin] = b
			let t = d[bTask]
			if t != 0 && t[tBnd] == d {
				rt_task_interrupt(t)
			}
			if d[bChild] != 0 {
				d = d[bChild]
				continue
			}
		}
		for d != b && d[bNext] == 0 {
			d = d[bParent]
		}
		if d == b {
			break
		}
		d = d[bNext]
	}
	rt_watch_update()
}

// rt_bnd_canceled is b's cancel reason (a fault word), or 0.
fn rt_bnd_canceled(b i64) i64 {
	return b[bCancel]
}

// rt_bnd_check cancels the owner of the current deadline once it has passed.
fn rt_bnd_check() {
	let b = rt_bnd_current()
	if b[bCancel] == 0 && b[bDeadline] > 0 && rt_mono_ns() >= b[bDeadline] {
		rt_bnd_cancel(b[bDlOwner], cast(fault, rt_fault_deadline()))
	}
}

// rt_bnd_target stops cancellation at its owner, or at this task's root.
fn rt_bnd_target(origin i64) i64 {
	mut b = rt_bnd_current()
	for b != 0 {
		if b == origin || b[bKind]&bfRoot != 0 { return b }
		b = b[bParent]
	}
	return origin
}

// rt_bnd_poll contains CPU-bound cancellation and preserves the server after a deadline.
fn rt_bnd_poll() {
	__ctx()[ctxPoll] = 0
	rt_bnd_check()
	if rtWatchDrainAt > 0 && rt_mono_ns() >= rtWatchDrainAt {
		rt_bnd_cancel(rt_bnd_core(), cast(fault, rt_fault_draining()))
	}
	let b = rt_bnd_current()
	if b[bCancel] == 0 { return }
	let f = rt_wait_fault()
	let target = rt_bnd_target(b[bOrigin])
	let g = rt_bnd_landing(target)
	if g != 0 {
		if g[gUnwinding] != 0 { return }
		rt_land(g, f)
	}
	let t = curTask
	if t != 0 && t[tPanicked] != 0 { return }
	if t != 0 && t[tRecoverable] != 0 {
		t[tRecover] = 0
		t[tPanicked] = 1
		if t[tChild] != 0 {
			t[tChild][spFault] = f
		} else {
			if rt_fault_ident(f) == faultDeadline { t[tPanicked] = 504 }
			rt_fault_say("request canceled: " + cast(str, f) + "\n")
		}
		rt_bnd_join_scopes(rt_bnd_root(t), f)
		rt_defer_run(0)
		rt_task_abort(t)
	}
	// A draining event loop has no task to unwind; it completes shutdown itself.
	if t == 0 { return }
	rt_panic(cast(str, f))
}

// rt_task_failure_status distinguishes a CPU deadline from ordinary panic recovery.
fn rt_task_failure_status(t i64) i64 {
	if t[tPanicked] == 504 { return 504 }
	return 500
}

// rt_bnd_stopped reports whether the current boundary is cancelled or past its deadline.
fn rt_bnd_stopped() bool {
	rt_bnd_check()
	return rt_bnd_current()[bCancel] != 0
}

// rt_task_interrupt ends t's wait, whatever it waits for, as waitDeadline, and queues t.
fn rt_task_interrupt(t i64) {
	if t[tWaiting] == 0 {
		if t[tTape] != 0 && rt_sched_held(t) {
			t[tResult] = waitDeadline // replaying: its wait ends when its turn comes, cancelled (#243)
		}
		return
	}
	if t[tWaitFd] >= 0 {
		waitCancel(t[tWaitFd])
	}
	rt_task_ready(t)
	t[tResult] = waitDeadline
	if readyHead+readyN == readyCap {
		if readyHead > 0 {
			memmove(readyQ, readyQ+8*readyHead, 8*readyN)
			readyHead = 0
		} else {
			readyCap = readyCap*2 + 64
			readyQ = realloc(readyQ, 8*readyCap)
		}
	}
	readyQ[readyHead+readyN] = t
	readyN += 1
}

// rt_wait_fault is the fault (a word: fail cast(fault, w)) a wait that returned waitDeadline
// fails with: the deadline or budget fault itself, or "canceled: " and any other reason.
fn rt_wait_fault() i64 {
	rt_bnd_check()
	let r = rt_bnd_current()[bCancel]
	if r == 0 {
		return rt_fault_deadline()
	}
	// Reasons compare by identity (notes/interface_faults.md), never by message.
	let id = rt_fault_ident(r)
	if id == faultDeadline || id == faultLimit {
		return r
	}
	let c = rt_fault_wrap(r, "canceled")
	let cb = c - faultHead
	cb[fhIdent] = faultCanceled
	return c
}

// rt_wait_msg is rt_wait_fault's message, for code that builds its fault later.
fn rt_wait_msg() str {
	return cast(str, rt_wait_fault())
}

// rt_task_wait waits until fd is ready (want 1: readable, 2: writable; fd -1: no fd), the
// timeout passes (ns, 0: none) or the task's deadline comes. Inside a task the core runs
// other tasks meanwhile; outside one it blocks in poll. It returns waitReady, waitTimeout
// or waitDeadline.
fn rt_task_wait(fd i64, want i64, timeout i64) i64 {
	let t = curTask
	if t == 0 || (fd >= 0 && cast(i64, waitHook) == 0) {
		rt_bnd_check()
		let cb = rt_bnd_current()
		if cb[bCancel] != 0 {
			return waitDeadline
		}
		// A boundary deadline (within) shortens the wait; reaching it cancels its owner.
		mut cut = false
		if cb[bDeadline] > 0 {
			let left = cb[bDeadline] - rt_mono_ns()
			if timeout <= 0 || left < timeout {
				timeout = left
				cut = true
			}
		}
		mut r = waitTimeout
		if fd < 0 {
			rt_sleep_ns(timeout)
		} else {
			r = rt_poll_wait(fd, want, timeout)
		}
		if cut && r == waitTimeout {
			rt_bnd_check()
			return waitDeadline
		}
		return r
	}
	let b = t[tBnd]
	if b != 0 && b[bCancel] != 0 {
		return waitDeadline
	}
	mut wake = -1
	t[tResult] = waitTimeout
	if timeout > 0 {
		wake = rt_mono_ns() + timeout
	}
	if t[tDeadline] > 0 && (wake < 0 || t[tDeadline] <= wake) && (t[tTape] == 0 || rt_sched_clock(t)) {
		wake = t[tDeadline]
		t[tResult] = waitDeadline
	}
	t[tGen] += 1
	t[tWaiting] = 1
	t[tWaitFd] = fd
	if wake >= 0 {
		rt_timer_push(t, wake)
	}
	if fd >= 0 {
		waitHook(fd, want)
	}
	rt_task_yield()
	if t[tResult] == waitDeadline && t[tBnd] != 0 {
		rt_bnd_check()
	}
	return t[tResult]
}

// rt_task_ready ends task t's wait because what it waited for happened; resume it next.
fn rt_task_ready(t i64) {
	t[tWaiting] = 0
	t[tGen] += 1
	t[tResult] = waitReady
	t[tWaitFd] = -1
}

// rt_task_park waits until another task wakes this one (rt_task_wake), or timeout ns or
// the deadline pass. Only a task parks: on the core's own stack there is no one to wake it.
fn rt_task_park(timeout i64) i64 {
	return rt_task_wait(-1, 0, timeout)
}

// rt_task_wake ends a parked task's wait; the event loop resumes it on its next turn.
fn rt_task_wake(t i64) {
	if t[tWaiting] == 0 || t[tWaitFd] >= 0 {
		return
	}
	rt_task_ready(t)
	if readyHead+readyN == readyCap {
		if readyHead > 0 {
			memmove(readyQ, readyQ+8*readyHead, 8*readyN)
			readyHead = 0
		} else {
			readyCap = readyCap*2 + 64
			readyQ = realloc(readyQ, 8*readyCap)
		}
	}
	readyQ[readyHead+readyN] = t
	readyN += 1
}

// rt_task_defer lets the core finish what it is doing (the other events of this turn)
// before this task goes on; on the core's own stack it does nothing.
fn rt_task_defer() {
	let t = curTask
	if t == 0 {
		return
	}
	t[tGen] += 1
	t[tWaiting] = 1
	t[tWaitFd] = -1
	rt_task_wake(t)
	rt_task_yield()
}

// rt_task_take_ready returns the next woken task, or 0.
fn rt_task_take_ready() i64 {
	if readyN == 0 {
		readyHead = 0
		return 0
	}
	let t = readyQ[readyHead]
	readyHead += 1
	readyN -= 1
	return t
}

// rt_task_ready_count is how many woken tasks wait to be resumed.
fn rt_task_ready_count() i64 {
	return readyN
}

// rt_task_any_ready reports whether woken tasks wait to be resumed.
fn rt_task_any_ready() bool {
	return readyN > 0
}

// rt_poll_wait blocks until fd is ready or timeout ns pass (0: no limit).
fn rt_poll_wait(fd i64, want i64, timeout i64) i64 {
	let pfd = rt_alloc(8)
	__st(pfd, fd, 2)
	if want == 1 {
		__st(pfd+4, 1, 1)
	} else {
		__st(pfd+4, 4, 1)
	}
	mut ms = -1
	if timeout > 0 {
		ms = (timeout + 999999) / 1000000
	}
	for {
		let r = i64(i32(rt_sys_poll(pfd, 1, ms)))
		if r > 0 {
			rt_epoch_release()
			return waitReady
		}
		if r == 0 {
			rt_epoch_release()
			return waitTimeout
		}
		if rt_errno() != EINTR {
			rt_epoch_release()
			return waitReady
		}
	}
}

// rt_task_sleep waits ns: inside a task the core runs other tasks meanwhile; outside one
// it blocks. It returns true when the task's deadline cut the wait short.
fn rt_task_sleep(ns i64) bool {
	return rt_task_wait(-1, 0, ns) == waitDeadline
}

// rt_sleep_ns blocks the thread for ns.
fn rt_sleep_ns(ns i64) {
	if ns <= 0 {
		return
	}
	let ts = rt_alloc(32)
	ts[0] = ns / 1000000000
	ts[1] = ns % 1000000000
	for i64(i32(rt_sys_nanosleep(ts, ts+16))) != 0 {
		if rt_errno() != EINTR {
			return
		}
		ts[0] = ts[2]
		ts[1] = ts[3]
	}
}

fn rt_timer_push(t i64, wake i64) {
	if timerN == timerCap {
		mut nc = timerCap * 2
		if nc < 64 {
			nc = 64
		}
		let nh = calloc(nc*3, 8)
		if timerN > 0 {
			memcpy(nh, timerHeap, timerN*24)
			free(timerHeap)
		}
		timerHeap = nh
		timerCap = nc
	}
	mut i = timerN
	timerN += 1
	for i > 0 {
		let p = (i - 1) / 2
		if timerHeap[3*p] <= wake {
			break
		}
		timerHeap[3*i] = timerHeap[3*p]
		timerHeap[3*i+1] = timerHeap[3*p+1]
		timerHeap[3*i+2] = timerHeap[3*p+2]
		i = p
	}
	timerHeap[3*i] = wake
	timerHeap[3*i+1] = t
	timerHeap[3*i+2] = t[tGen]
	t[tTimers] += 1
}

// rt_timer_next is when the earliest timer entry is due (mono ns), or -1.
fn rt_timer_next() i64 {
	if timerN == 0 {
		return -1
	}
	return timerHeap[0]
}

// rt_timer_pop returns a task whose wait timed out by now (ending that wait), or 0. Entries
// left by waits that already ended another way are dropped.
fn rt_timer_pop(now i64) i64 {
	for timerN > 0 && timerHeap[0] <= now {
		let t = timerHeap[1]
		let gen = timerHeap[2]
		timerN -= 1
		let w = timerHeap[3*timerN]
		let lt = timerHeap[3*timerN+1]
		let lg = timerHeap[3*timerN+2]
		mut i = 0
		for {
			let l = 2*i + 1
			if l >= timerN {
				break
			}
			mut m = l
			if l+1 < timerN && timerHeap[3*(l+1)] < timerHeap[3*l] {
				m = l + 1
			}
			if timerHeap[3*m] >= w {
				break
			}
			timerHeap[3*i] = timerHeap[3*m]
			timerHeap[3*i+1] = timerHeap[3*m+1]
			timerHeap[3*i+2] = timerHeap[3*m+2]
			i = m
		}
		if timerN > 0 {
			timerHeap[3*i] = w
			timerHeap[3*i+1] = lt
			timerHeap[3*i+2] = lg
		}
		t[tTimers] -= 1
		if t[tRetired] != 0 {
			if t[tTimers] == 0 {
				free(t)
			}
			continue
		}
		if gen == t[tGen] && t[tWaiting] != 0 {
			t[tWaiting] = 0
			t[tGen] += 1
			if t[tWaitFd] >= 0 {
				waitCancel(t[tWaitFd])
				t[tWaitFd] = -1
			}
			if t[tTape] != 0 && t[tResult] == waitDeadline {
				rt_sched_deadline(t) // recording: the deadline's cancel goes on the tape before t resumes (#243)
			}
			return t
		}
	}
	return 0
}

fn rt_pipe(fds i64) i64 {
	return i64(i32(rt_sys_pipe(fds)))
}

// ---- helper threads: blocking calls (DNS, files) run here while the task waits ----

shared mut helperQ i64    // wake pipe [read fd, non-blocking write fd]
shared mut helperLock i64
shared mut helperUp bool
shared mut helperHead i64
shared mut helperTail i64
shared mut helperCount i64
const minHelperThreads = 4
const maxHelperJobs = 4096 // jobs one core may have out at once: past that its tasks wait for one to finish

// A core's helper jobs in flight, and the tasks waiting to start one (records [task, next, gone]).
mut helperInflight i64
mut helperWaitHead i64
mut helperWaitTail i64

// rt_helper_threads is how many helper threads to start: the number of cores, at least 4,
// or TIN_HELPERS (1 to 256).
fn rt_helper_threads() i64 {
	let env = rt_getenv(cast(i64, "TIN_HELPERS") + 8)
	if env != 0 {
		mut n = rt_decimal_integer(env) & 0xffffffff
		if n < 1 {
			n = 1
		}
		if n > 256 {
			n = 256
		}
		return n
	}
	mut n = __atomic_load(&rtCores)
	if n < minHelperThreads {
		n = minHelperThreads
	}
	return n
}

const jNext = 0
const jFn = 1
const jArg = 2
const jTask = 3
const jDoneFd = 4
const jDrop = 5
const jGone = 6

// rt_helper_run waits for a blocking job within the request deadline. arg and all of
// its inputs must be heap-owned: a timed-out task can end before the helper does.
// On success the caller owns arg; on failure drop(arg) runs when the job finishes
// (or immediately if it could not be queued). Never resume a timed-out, reused task.
fn rt_helper_run(f fn(i64), arg i64, drop fn(i64)) ! {
	let t = curTask
	if t == 0 || doneFd == 0 {
		f(arg)
		return
	}
	if (t[tDeadline] > 0 && rt_mono_ns() >= t[tDeadline]) || rt_bnd_stopped() {
		drop(arg)
		fail cast(fault, rt_wait_fault())
	}
	rt_lock(&helperLock)
	if !helperUp {
		helperQ = calloc(2, 8)
		let fds = calloc(2, 4)
		rt_pipe(fds)
		helperQ[0] = i64(i32(__ld(fds, 2)))
		helperQ[1] = i64(i32(__ld(fds+4, 2)))
		rt_sys_fcntl(helperQ[1], F_SETFL, O_NONBLOCK)
		free(fds)
		let nh = rt_helper_threads() // before the first: each helper counts in rtCores too
		for i in 0..nh {
			rt_spawn_core(rt_helper_main, i)
		}
		helperUp = true
	}
	rt_unlock(&helperLock)
	// At most maxHelperJobs jobs of this core are out at once; the next task waits for one to
	// finish, within its deadline, instead of failing (#357).
	for helperInflight >= maxHelperJobs {
		let w = calloc(3, 8)
		w[0] = t
		if helperWaitTail == 0 {
			helperWaitHead = w
		} else {
			helperWaitTail[1] = w
		}
		helperWaitTail = w
		let r = rt_task_park(0)
		if r == waitDeadline {
			w[2] = 1 // the waker frees the record when it reaches it
			drop(arg)
			fail cast(fault, rt_wait_fault())
		}
		free(w)
	}
	helperInflight += 1
	rt_lock(&helperLock)
	let job = calloc(7, 8)
	job[jFn] = cast(i64, f)
	job[jArg] = arg
	job[jTask] = t
	job[jDoneFd] = doneFd
	job[jDrop] = cast(i64, drop)
	if helperTail == 0 {
		helperHead = job
	} else {
		helperTail[jNext] = job
	}
	helperTail = job
	helperCount += 1
	rt_unlock(&helperLock)
	// A full pipe already has wakeups pending; workers drain the whole queue.
	let b = calloc(1, 8)
	for rt_sys_write(helperQ[1], b, 1) < 0 && rt_errno() == EINTR {}
	free(b)
	let r = rt_task_park(0)
	if r == waitDeadline {
		job[jGone] = 1
		fail cast(fault, rt_wait_fault())
	}
	free(job)
}

// Called on the owning core only: late results release their heap-owned inputs and
// outputs, without touching the task pointer (the task may already have been reused).
fn rt_helper_done(job i64) i64 {
	rt_lock(&helperLock)
	helperCount -= 1
	rt_unlock(&helperLock)
	helperInflight -= 1
	// A task waiting to start a job goes first now that there is room (records of tasks that
	// gave up are freed on the way).
	for helperWaitHead != 0 {
		let w = helperWaitHead
		helperWaitHead = w[1]
		if helperWaitHead == 0 {
			helperWaitTail = 0
		}
		if w[2] != 0 {
			free(w)
			continue
		}
		rt_task_wake(w[0])
		break
	}
	if job[jGone] != 0 {
		let drop = cast(fn(i64), job[jDrop])
		drop(job[jArg])
		free(job)
		return 0
	}
	return job[jTask]
}

fn rt_helper_take() i64 {
	rt_lock(&helperLock)
	let job = helperHead
	if job != 0 {
		helperHead = job[jNext]
		if helperHead == 0 {
			helperTail = 0
		}
	}
	rt_unlock(&helperLock)
	return job
}

// Helpers drain all queued jobs after a wakeup, then report completions to their core.
fn rt_helper_main(id i64) {
	let buf = calloc(1, 8)
	for {
		if rt_sys_read(helperQ[0], buf, 1) != 1 {
			continue
		}
		mut job = rt_helper_take()
		for job != 0 {
			let f = cast(fn(i64), job[jFn])
			f(job[jArg])
			rt_pool_reset()
			buf[0] = job
			rt_write_all(job[jDoneFd], buf, 8)
			job = rt_helper_take()
		}
	}
}
