// Memory operations and the mmap heap shared by every program and by the compiler; no libc allocation calls.
// The bodies of the bulk operations are the portable versions; the backends substitute bounded vector leaves.
// The backends replace this body on x86-64; it has two statements so that no compiler, the seeds
// included, inlines the placeholder.
fn mem_avx2_supported() i64 {
	let none = 0
	return none
}

fn memcpy(dst_in i64, src_in i64, n_in i64) i64 {
	mut dst = dst_in
	mut src = src_in
	mut n = n_in
	let result = dst
	if n >= 64 {
		let chunks = n >> 6
		mem_copy64(dst, src, chunks)
		let bytes = chunks << 6
		dst = dst + bytes
		src = src + bytes
		n = n - bytes
	}
	for n >= 8 {
		dst[0] = src[0]
		dst = dst + 8
		src = src + 8
		n = n - 8
	}
	for n > 0 {
		store8(dst, i64(load8(src)))
		dst = dst + 1
		src = src + 1
		n = n - 1
	}
	return result
}

fn memmove(dst_in i64, src_in i64, n_in i64) i64 {
	mut dst = dst_in
	mut src = src_in
	mut n = n_in
	if dst <= src || dst - src >= n {
		return memcpy(dst, src, n)
	}
	let result = dst
	dst = dst + n
	src = src + n
	for n >= 8 {
		dst = dst - 8
		src = src - 8
		dst[0] = src[0]
		n = n - 8
	}
	for n > 0 {
		dst = dst - 1
		src = src - 1
		store8(dst, i64(load8(src)))
		n = n - 1
	}
	return result
}

fn memset(p_in i64, c_in i64, n_in i64) i64 {
	mut p = p_in
	mut c = c_in
	mut n = n_in
	let result = p
	c = c & 255
	let word = c * 0x0101010101010101
	if n >= 64 {
		let chunks = n >> 6
		mem_fill64(p, word, chunks)
		let bytes = chunks << 6
		p = p + bytes
		n = n - bytes
	}
	for n >= 8 {
		p[0] = word
		p = p + 8
		n = n - 8
	}
	for n > 0 {
		store8(p, c)
		p = p + 1
		n = n - 1
	}
	return result
}

fn memcmp(a_in i64, b_in i64, n_in i64) i64 {
	mut a = a_in
	mut b = b_in
	mut n = n_in
	for n >= 8 && a[0] == b[0] {
		a = a + 8
		b = b + 8
		n = n - 8
	}
	for n > 0 {
		let d = i64(load8(a)) - i64(load8(b))
		if d != 0 {
			return d
		}
		a = a + 1
		b = b + 1
		n = n - 1
	}
	return 0
}

// Zero-byte detection handles eight bytes without reading past the supplied length.
fn memchr(p_in i64, c_in i64, n_in i64) i64 {
	mut p = p_in
	mut c = c_in
	mut n = n_in
	c = c & 255
	let word = c * 0x0101010101010101
	for n >= 8 {
		let v = p[0] ^ word
		if ((v - 0x0101010101010101) & ~v & (-9187201950435737472)) != 0 {
			break
		}
		p = p + 8
		n = n - 8
	}
	for n > 0 {
		if i64(load8(p)) == c {
			return p
		}
		p = p + 1
		n = n - 1
	}
	return 0
}

fn strlen(p_in i64) i64 {
	mut p = p_in
	let start = p
	for (p & 7) != 0 {
		if i64(load8(p)) == 0 {
			return p - start
		}
		p = p + 1
	}
	for {
		let v = p[0]
		if ((v - 0x0101010101010101) & ~v & (-9187201950435737472)) != 0 {
			break
		}
		p = p + 8
	}
	for i64(load8(p)) != 0 {
		p = p + 1
	}
	return p - start
}

fn strcmp(a_in i64, b_in i64) i64 {
	mut a = a_in
	mut b = b_in
	for i64(load8(a)) == i64(load8(b)) {
		if i64(load8(a)) == 0 {
			return 0
		}
		a = a + 1
		b = b + 1
	}
	return i64(load8(a)) - i64(load8(b))
}

// The failure report uses static bytes and stack words, even before a context exists.
fn mem_oom_digits(n i64) {
	if n >= 10 {
		mem_oom_digits(n / 10)
	}
	mut c = '0' + n % 10
	rt_sys_write(2, &c, 1)
}

fn mem_oom(n i64) i64 {
	rt_sys_write(2, (cast(i64, "tin: out of memory (") + 8), 20)
	mem_oom_digits(n)
	rt_sys_write(2, (cast(i64, " bytes)\n") + 8), 8)
	rt_sys__exit(2)
	return 0
}

fn mem_map(n i64, flags i64) i64 {
	mem_failpoint(n)
	let p = rt_sys_mmap(0, n, 3, flags, -1, 0)
	if p == -1 || p == 0 {
		return mem_oom(n)
	}
	return p
}

// mem_class is the size class of a block of sz bytes with its header: 16 bytes apart up to 64,
// then four classes per doubling pair up to 4 KiB (k 0 to 15), then four per doubling, 25%
// apart, up to 256 KiB (k 16 to 39, #345). Bigger blocks have no class (-1).
fn mem_class(sz i64) i64 {
	if sz <= 64 {
		return ((sz + 15) >> 4) - 1
	}
	mut s = 64
	mut k = 4
	for k < 16 {
		if sz <= s + (s >> 1) {
			return k
		}
		if sz <= 2 * s {
			return k + 1
		}
		s = s * 2
		k = k + 2
	}
	if sz > 262144 {
		return -1
	}
	mut base = 4096
	mut i = 0
	for sz > 2 * base {
		base = base * 2
		i = i + 1
	}
	let step = base >> 2
	return 16 + (i << 2) + (sz - base + step - 1) / step - 1
}

fn mem_class_size(k i64) i64 {
	if k < 4 {
		return 16 * (k + 1)
	}
	if k >= 16 {
		let m = k - 16
		return (1024 << (m >> 2)) * (5 + (m & 3))
	}
	let j = k - 4
	let s = 64 << (j >> 1)
	if (j & 1) == 0 {
		return s + (s >> 1)
	}
	return s * 2
}

// mem_fl is the heap word of class k's free list.
fn mem_fl(k i64) i64 {
	if k < 16 {
		return 6 + k
	}
	return 10 + k
}

// Blocks above the largest class are mappings of their own. Up to 4 MiB a mapping is rounded
// up to one of 16 sizes (four per doubling from 256 KiB) so that a freed one serves any block of
// its class, and a heap keeps up to largeCacheCap bytes of them for reuse instead of unmapping;
// bigger blocks map exactly their pages and are unmapped when freed.
const largeCacheCap = 8388608

// mem_large_class is the mapping class of a block of sz bytes with its header, or -1 above 4 MiB.
fn mem_large_class(sz i64) i64 {
	if sz > 4194304 {
		return -1
	}
	mut base = 262144
	mut i = 0
	for sz > 2 * base {
		base = base * 2
		i = i + 1
	}
	let step = base >> 2
	return (i << 2) + (sz - base + step - 1) / step - 1
}

fn mem_large_size(lk i64) i64 {
	return (65536 << (lk >> 2)) * (5 + (lk & 3))
}

// mem_map_size is the bytes a block above the largest class maps for sz bytes with its header.
fn mem_map_size(page i64, sz i64) i64 {
	let lk = mem_large_class(sz)
	if lk >= 0 {
		return mem_large_size(lk)
	}
	return (sz + page - 1) & -page
}

// Heap words: flags, page size, return lock/head, slab bump/end, 16 local free lists, then
// (word 22) the bytes of slabs and large blocks it has mapped (#356), 23 the bytes of its slabs,
// 24 how many mappings it holds, 25 the bytes of large mappings cached for reuse, the free lists
// of classes 16 to 39 (words 26 to 49) and of the large mapping classes (words 50 to 65).
fn mem_heap_new(flags i64, page i64) i64 {
	let p = mem_map(page, flags)
	p[0] = flags
	p[1] = page
	return p
}

fn mem_lock(p i64) {
	for __atomic_swap(p, 1) != 0 {
		__yield()
	}
}

fn mem_unlock(p i64) {
	__atomic_store(p, 0)
}

fn mem_drain(heap i64) {
	if __atomic_load(heap + 24) == 0 {
		return
	}
	mem_lock(heap + 16)
	mut p = heap[3]
	heap[3] = 0
	mem_unlock(heap + 16)
	for p != 0 {
		let next = p[0]
		let k = mem_class(((p - 8)[0] & 140737488355327) + 16)
		p[0] = heap[mem_fl(k)]
		heap[mem_fl(k)] = p
		p = next
	}
}

// Every block has [owning heap, size word] before its 16-byte-aligned payload. The size
// word's bits 0-46 are the requested size; bits 47-62 belong to the long-lived reference
// count (#176, design/interface_mem.md), so every reader masks with 2^47-1. A fresh block
// and a freelist reuse both start with a count of 0.
fn mem_alloc(heap i64, n_in i64, zero i64) i64 {
	mut n = n_in
	mem_failpoint(n)
	if n < 0 || n > 70368744177664 {
		return mem_oom(n)
	}
	if n == 0 {
		n = 1
	}
	let k = mem_class(n + 16)
	mut b = 0
	if k < 0 {
		let size = mem_map_size(heap[1], n + 16)
		let lk = mem_large_class(n + 16)
		if lk >= 0 && heap[50 + lk] != 0 {
			// A mapping kept from an earlier block of its class: no system call.
			b = heap[50 + lk]
			heap[50 + lk] = b[0]
			heap[25] -= size
			__atomic_add(&memoryCached, 0 - size)
			b[0] = heap
			b[1] = n
			if zero != 0 {
				memset(b + 16, 0, n)
			}
			return b + 16
		}
		b = mem_map(size, heap[0])
		mem_mapped(heap, size)
		__atomic_add(heap + 192, 1)
	} else {
		mem_drain(heap)
		let fl = mem_fl(k)
		let p = heap[fl]
		if p != 0 {
			heap[fl] = p[0]
			(p - 8)[0] = n
			if zero != 0 {
				memset(p, 0, n)
			}
			return p
		}
		let bs = mem_class_size(k)
		if heap[4] + bs > heap[5] {
			// A slab holds at least 16 blocks of the class it was made for.
			mut slab = 1048576
			if bs * 16 > slab {
				slab = bs * 16
			}
			let m = mem_map(slab, heap[0])
			mem_mapped(heap, slab)
			__atomic_add(heap + 192, 1)
			heap[23] += slab
			heap[4] = m
			heap[5] = m + slab
		}
		b = heap[4]
		heap[4] = b + bs
	}
	b[0] = heap
	b[1] = n
	return b + 16
}

fn mem_free(p i64, current i64) {
	if p == 0 {
		return
	}
	let b = p - 16
	let heap = b[0]
	let n = b[1] & 140737488355327
	let k = mem_class(n + 16)
	if k < 0 {
		let size = mem_map_size(heap[1], n + 16)
		let lk = mem_large_class(n + 16)
		if lk >= 0 && heap == current && heap[25] + size <= largeCacheCap {
			b[0] = heap[50 + lk]
			heap[50 + lk] = b
			heap[25] += size
			__atomic_add(&memoryCached, size)
			return
		}
		mem_mapped(heap, 0 - size)
		__atomic_add(heap + 192, -1)
		rt_sys_munmap(b, size)
		return
	}
	if heap == current {
		p[0] = heap[mem_fl(k)]
		heap[mem_fl(k)] = p
		return
	}
	mem_lock(heap + 16)
	p[0] = heap[3]
	__atomic_store(heap + 24, p)
	mem_unlock(heap + 16)
}

fn mem_realloc(heap i64, p i64, n i64) i64 {
	if p == 0 {
		return mem_alloc(heap, n, 0)
	}
	if n == 0 {
		mem_free(p, heap)
		return 0
	}
	let old = (p - 8)[0] & 140737488355327
	// Keep the recorded class stable; growing within it (or within a large block's mapping)
	// needs no mapping or copy.
	if n > old {
		let ok = mem_class(old + 16)
		mut cap = 0
		if ok >= 0 {
			cap = mem_class_size(ok)
		} else {
			cap = mem_map_size((p - 16)[0][1], old + 16)
		}
		if n + 16 <= cap {
			mem_failpoint(n)
			(p - 8)[0] = (p - 8)[0] - old + n
			return p
		}
	}
	let q = mem_alloc(heap, n, 0)
	mut copy_ = old
	if n < copy_ {
		copy_ = n
	}
	memcpy(q, p, copy_)
	mem_free(p, heap)
	return q
}

// Bootstrap fallbacks; both backends emit the leaf routines in tools/gen/arch/memory-*.S.
fn mem_copy64(dst_in i64, src_in i64, chunks_in i64) {
	mut dst = dst_in
	mut src = src_in
	mut chunks = chunks_in
	for chunks > 0 {
		dst[0] = src[0]
		dst[1] = src[1]
		dst[2] = src[2]
		dst[3] = src[3]
		dst[4] = src[4]
		dst[5] = src[5]
		dst[6] = src[6]
		dst[7] = src[7]
		dst = dst + 64
		src = src + 64
		chunks = chunks - 1
	}
}

fn mem_fill64(p_in i64, word i64, chunks_in i64) {
	mut p = p_in
	mut chunks = chunks_in
	for chunks > 0 {
		p[0] = word
		p[1] = word
		p[2] = word
		p[3] = word
		p[4] = word
		p[5] = word
		p[6] = word
		p[7] = word
		p = p + 64
		chunks = chunks - 1
	}
}
