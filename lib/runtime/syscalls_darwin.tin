// macOS retains libSystem for runtime system calls.
extern func _exit(code i64)
func rt_sys__exit(code i64)  { _exit(code) }
extern func close(fd i64) i64
func rt_sys_close(fd i64) i64 { return close(fd) }
extern func exit(code i64)
func rt_sys_exit(code i64)  { exit(code) }
extern func fcntl(fd i64, cmd i64, ...) i64
func rt_sys_fcntl(fd i64, cmd i64, arg i64) i64 { return fcntl(fd, cmd, arg) }
extern func madvise(addr i64, n i64, advice i64) i64
func rt_sys_madvise(addr i64, n i64, advice i64) i64 { return madvise(addr, n, advice) }
extern func mmap(addr i64, n i64, prot i64, flags i64, fd i64, off i64) i64
func rt_sys_mmap(addr i64, n i64, prot i64, flags i64, fd i64, off i64) i64 { return mmap(addr, n, prot, flags, fd, off) }
extern func mprotect(addr i64, n i64, prot i64) i64
func rt_sys_mprotect(addr i64, n i64, prot i64) i64 { return mprotect(addr, n, prot) }
extern func munmap(addr i64, n i64) i64
func rt_sys_munmap(addr i64, n i64) i64 { return munmap(addr, n) }
extern func nanosleep(req i64, rem i64) i64
func rt_sys_nanosleep(req i64, rem i64) i64 { return nanosleep(req, rem) }
extern func open(path i64, flags i64, ...) i64
func rt_sys_open(path i64, flags i64, mode i64) i64 { return open(path, flags, mode) }
extern func pipe(fds i64) i64
func rt_sys_pipe(fds i64) i64 { return pipe(fds) }
extern func poll(fds i64, n i64, timeout i64) i64
func rt_sys_poll(fds i64, n i64, timeout i64) i64 { return poll(fds, n, timeout) }
extern func pthread_sigmask(how i64, set i64, old i64) i64
func rt_sys_pthread_sigmask(how i64, set i64, old i64) i64 { return pthread_sigmask(how, set, old) }
extern func read(fd i64, buf i64, n i64) i64
func rt_sys_read(fd i64, buf i64, n i64) i64 { return read(fd, buf, n) }
extern func sigaction(sig i64, act i64, old i64) i64
func rt_sys_sigaction(sig i64, act i64, old i64) i64 { return sigaction(sig, act, old) }
extern func sigaltstack(ss i64, old i64) i64
func rt_sys_sigaltstack(ss i64, old i64) i64 { return sigaltstack(ss, old) }
extern func signal(sig i64, h i64) i64
func rt_sys_signal(sig i64, h i64) i64 { return signal(sig, h) }
extern func write(fd i64, buf i64, n i64) i64
func rt_sys_write(fd i64, buf i64, n i64) i64 { return write(fd, buf, n) }
