// x86-64 part of the Linux runtime: the struct layouts that differ from arm64.

const TARGET_X64 = true

// struct stat on x86-64 Linux: st_mode is a u32 at 24 (16 on arm64).
fn rt_stat_mode(st i64) i64 {
	return __ld(st+24, 2) & 0xffffffff
}

// rt_task_init sets a new task's saved registers (x86-64: rbx, rbp, r12-r14, rsp) so the
// first switch into it returns into rt_task_entry: the switch's ret pops the address left
// at the top of the new stack, which leaves rsp as a call would (8 modulo 16).
fn rt_task_init(t i64, top i64) {
	let slot = top - 16
	slot[0] = cast(i64, rt_task_entry)
	t[1] = 0
	t[5] = slot
}

// rt_task_sp reads the saved stack pointer without changing the swap layout.
fn rt_task_sp(t i64) i64 { return t[5] }

// rt_ctx_init sets saved registers (x86-64) so the first switch into t returns into entry
// with the stack at top, as rt_task_init does for rt_task_entry.
fn rt_ctx_init(t i64, top i64, entry i64) {
	let slot = top - 16
	slot[0] = entry
	t[1] = 0
	t[5] = slot
}

// rt_uctx_redirect makes the context the signal interrupted (ucontext_t) resume at pc with the
// stack pointer sp: uc_mcontext starts at 40, with rsp at 160 and rip at 168. A function is
// entered with rsp 8 below a multiple of 16 (a call pushed its return address): sp is set so,
// and the pushed address is the interrupted rip, so a backtrace from pc names the function
// that was running.
fn rt_uctx_redirect(uctx i64, pc i64, sp i64) {
	(sp - 8)[0] = (uctx + 168)[0]
	(uctx + 160)[0] = sp - 8
	(uctx + 168)[0] = pc
}

// rt_uctx_altstack_top is the top of the thread's signal stack, which the context records
// (uc_stack at 16: ss_sp, ss_flags, ss_size at 32).
fn rt_uctx_altstack_top(uctx i64) i64 {
	return (uctx + 16)[0] + (uctx + 32)[0]
}
