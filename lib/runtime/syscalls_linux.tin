	if r < 0 {
		return r
	}
	return 0
}

fn rt_sys_getcwd(buf i64, n i64) i64 {
	if linux_result(linux_raw(linux_nr_getcwd(), buf, n, 0, 0, 0, 0)) < 0 {
		return 0
	}
	return buf
}

fn rt_sys_poll(fds i64, n i64, timeout i64) i64 {
	let sec = timeout / 1000
	let ns = (timeout % 1000) * 1000000
	let ts = calloc(2, 8)
	ts[0] = sec
	ts[1] = ns
	mut p = ts
	if timeout < 0 {
		p = 0
	}
	let r = linux_result(linux_raw(linux_nr_ppoll(), fds, n, p, 0, 8, 0))
	free(ts)
	return r
}

fn rt_sys__exit(code i64) i64 {
	return linux_raw(linux_nr_exit_group(), code, 0, 0, 0, 0, 0)
}

fn rt_sys_exit(code i64) i64 {
	return rt_sys__exit(code)
}

fn rt_sys_signal(sig i64, h i64) i64 {
	let act = calloc(4, 8)
	let old = calloc(4, 8)
	act[0] = h
	act[1] = 0x14000000
	act[2] = linux_restorer_ptr()
	let r = rt_sys_sigaction(sig, act, old)
	let prev = old[0]
	free(act)
	free(old)
	if r < 0 {
		return -1
	}
	return prev
}

// Directory handles: fd, valid bytes, cursor, sticky error, path, buffer.
fn rt_sys_opendir(path i64) i64 {
	let fd = rt_sys_open(path, linux_directory_flags(), 0)
	if fd < 0 {
		return 0
	}
	let d = calloc(6, 8)
	d[0] = fd
	let n = strlen(path)
	d[4] = malloc(n + 1)
	memcpy(d[4], path, n + 1)
	d[5] = malloc(32768)
	return d
}

fn rt_sys_readdir(d i64) i64 {
	for {
		if d[2] >= d[1] {
			let n = linux_result(linux_raw(linux_nr_getdents64(), d[0], d[5], 32768, 0, 0, 0))
			if n < 0 {
				if linux_get_errno() == 4 {
					continue
				}
				d[3] = linux_get_errno()
				return 0
			}
			if n == 0 {
				return 0
			}
			d[1] = n
			d[2] = 0
		}
		let ent = d[5] + d[2]
		let reclen = __ld(ent + 16, 1)
		if reclen < 20 || reclen > d[1] - d[2] {
			linux_set_errno(5)
			d[3] = 5
			return 0
		}
		let bytes = reclen - 19
		let name = ent + 19
		if memchr(name, 0, bytes) == 0 {
			linux_set_errno(5)
			d[3] = 5
			return 0
		}
		d[2] = d[2] + reclen
		linux_dir_type(d, ent)
		return ent
	}
}

fn rt_sys_closedir(d i64) i64 {
	let r = rt_sys_close(d[0])
	free(d[4])
	free(d[5])
	free(d)
	return r
}

// Unknown d_type is resolved with lstat, preserving a symbolic link as DT_LNK.
fn linux_dir_type(d i64, ent i64) {
	if i64(load8(ent + 18)) != 0 {
		return
	}
	let name = ent + 19
	let a = strlen(d[4])
	let b = strlen(name)
	let p = malloc(a + b + 2)
	memcpy(p, d[4], a)
	store8(p + a, '/')
	memcpy(p + a + 1, name, b + 1)
	let st = calloc(1, 256)
	if rt_sys_lstat(p, st) == 0 {
		store8(ent + 18, linux_stat_type(st))
	}
	free(st)
	free(p)
}
