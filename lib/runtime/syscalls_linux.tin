// Linux system calls, shared by the runtime and the compiler. Both backends generate linux_raw
// as a leaf (svc #0 on arm64, syscall on x86-64) that returns the kernel's result, -errno on
// failure, so this body never runs. It has two statements so that no compiler, the seeds included,
// takes it for a one-line function worth inlining.
fn linux_raw(n i64, a i64, b i64, c i64, d i64, e i64, f i64) i64 {
	let enosys = -38
	return enosys
}

fn linux_result(r i64) i64 {
	if r < 0 && r >= -4095 {
		linux_set_errno(-r)
		return -1
	}
	return r
}

fn rt_sys_read(fd i64, buf i64, n i64) i64 {
	return linux_result(linux_raw(linux_nr_read(), fd, buf, n, 0, 0, 0))
}

fn rt_sys_write(fd i64, buf i64, n i64) i64 {
	return linux_result(linux_raw(linux_nr_write(), fd, buf, n, 0, 0, 0))
}

