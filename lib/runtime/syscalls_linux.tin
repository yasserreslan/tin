// Seed-compatible Linux syscall layer shared by the runtime and compiler.
// The old seed uses libc syscall only while building stage 1; both backends emit the leaf.
extern fn syscall(n,a,b,c,d,e,f);
extern fn __errno_location();
fn linux_raw(n,a,b,c,d,e,f) {
    let r=syscall(n,a,b,c,d,e,f);
    if r == -1 { return -(__ld(__errno_location(),2)&0xffffffff); }
    return r;
}
fn linux_result(r) {
    if r < 0 && r >= -4095 { linux_set_errno(-r); return -1; }
    return r;
}
fn rt_sys_read(fd,buf,n) { return linux_result(linux_raw(linux_nr_read(),fd,buf,n,0,0,0)); }
fn rt_sys_write(fd,buf,n) { return linux_result(linux_raw(linux_nr_write(),fd,buf,n,0,0,0)); }
fn rt_sys_close(fd) { return linux_result(linux_raw(linux_nr_close(),fd,0,0,0,0,0)); }
fn rt_sys_getpid() { return linux_result(linux_raw(linux_nr_getpid(),0,0,0,0,0,0)); }
fn rt_sys_uname(buf) { return linux_result(linux_raw(linux_nr_uname(),buf,0,0,0,0,0)); }
fn rt_sys_chdir(path) { return linux_result(linux_raw(linux_nr_chdir(),path,0,0,0,0,0)); }
fn rt_sys_fstat(fd,st) { return linux_result(linux_raw(linux_nr_fstat(),fd,st,0,0,0,0)); }
fn rt_sys_mmap(addr,n,prot,flags,fd,off) { return linux_result(linux_raw(linux_nr_mmap(),addr,n,prot,flags,fd,off)); }
fn rt_sys_munmap(addr,n) { return linux_result(linux_raw(linux_nr_munmap(),addr,n,0,0,0,0)); }
fn rt_sys_mprotect(addr,n,prot) { return linux_result(linux_raw(linux_nr_mprotect(),addr,n,prot,0,0,0)); }
fn rt_sys_madvise(addr,n,advice) { return linux_result(linux_raw(linux_nr_madvise(),addr,n,advice,0,0,0)); }
fn rt_sys_nanosleep(req,rem) { return linux_result(linux_raw(linux_nr_nanosleep(),req,rem,0,0,0,0)); }
fn rt_sys_fcntl(fd,cmd,arg) { return linux_result(linux_raw(linux_nr_fcntl(),fd,cmd,arg,0,0,0)); }
fn rt_sys_socket(domain,typ,proto) { return linux_result(linux_raw(linux_nr_socket(),domain,typ,proto,0,0,0)); }
fn rt_sys_connect(fd,addr,n) { return linux_result(linux_raw(linux_nr_connect(),fd,addr,n,0,0,0)); }
fn rt_sys_bind(fd,addr,n) { return linux_result(linux_raw(linux_nr_bind(),fd,addr,n,0,0,0)); }
fn rt_sys_listen(fd,backlog) { return linux_result(linux_raw(linux_nr_listen(),fd,backlog,0,0,0,0)); }
fn rt_sys_accept(fd,addr,n) { return linux_result(linux_raw(linux_nr_accept(),fd,addr,n,0,0,0)); }
fn rt_sys_getsockopt(fd,level,name,val,n) { return linux_result(linux_raw(linux_nr_getsockopt(),fd,level,name,val,n,0)); }
fn rt_sys_setsockopt(fd,level,name,val,n) { return linux_result(linux_raw(linux_nr_setsockopt(),fd,level,name,val,n,0)); }
fn rt_sys_getsockname(fd,addr,n) { return linux_result(linux_raw(linux_nr_getsockname(),fd,addr,n,0,0,0)); }
fn rt_sys_shutdown(fd,how) { return linux_result(linux_raw(linux_nr_shutdown(),fd,how,0,0,0,0)); }
fn rt_sys_epoll_create1(flags) { return linux_result(linux_raw(linux_nr_epoll_create1(),flags,0,0,0,0,0)); }
fn rt_sys_epoll_ctl(fd,op,other,ev) { return linux_result(linux_raw(linux_nr_epoll_ctl(),fd,op,other,ev,0,0)); }
fn rt_sys_timerfd_create(clock,flags) { return linux_result(linux_raw(linux_nr_timerfd_create(),clock,flags,0,0,0,0)); }
fn rt_sys_timerfd_settime(fd,flags,nv,old) { return linux_result(linux_raw(linux_nr_timerfd_settime(),fd,flags,nv,old,0,0)); }
fn rt_sys_clock_gettime(id,ts) { return linux_result(linux_vdso_clock(id,ts)); }
fn rt_sys_getrandom(p,n,flags) { return linux_result(linux_raw(linux_nr_getrandom(),p,n,flags,0,0,0)); }
fn rt_sys_sched_setaffinity(pid,n,set) { return linux_result(linux_raw(linux_nr_sched_setaffinity(),pid,n,set,0,0,0)); }
fn rt_sys_sigaltstack(ss,old) { return linux_result(linux_raw(linux_nr_sigaltstack(),ss,old,0,0,0,0)); }
fn rt_sys_open(path,flags,mode) { return linux_result(linux_raw(linux_nr_openat(),-100,path,flags,mode,0,0)); }
fn rt_sys_creat(path,mode) { return linux_result(linux_raw(linux_nr_openat(),-100,path,577,mode,0,0)); }
fn rt_sys_unlink(path) { return linux_result(linux_raw(linux_nr_unlinkat(),-100,path,0,0,0,0)); }
fn rt_sys_rmdir(path) { return linux_result(linux_raw(linux_nr_unlinkat(),-100,path,512,0,0,0)); }
fn rt_sys_mkdir(path,mode) { return linux_result(linux_raw(linux_nr_mkdirat(),-100,path,mode,0,0,0)); }
fn rt_sys_rename(a,b) { return linux_result(linux_raw(linux_nr_renameat(),-100,a,-100,b,0,0)); }
fn rt_sys_readlink(path,buf,n) { return linux_result(linux_raw(linux_nr_readlinkat(),-100,path,buf,n,0,0)); }
fn rt_sys_stat(path,st) { return linux_result(linux_raw(linux_nr_newfstatat(),-100,path,st,0,0,0)); }
fn rt_sys_lstat(path,st) { return linux_result(linux_raw(linux_nr_newfstatat(),-100,path,st,256,0,0)); }
fn rt_sys_pipe(fds) { return linux_result(linux_raw(linux_nr_pipe2(),fds,0,0,0,0,0)); }
fn rt_sys_recv(fd,buf,n,flags) { return linux_result(linux_raw(linux_nr_recvfrom(),fd,buf,n,flags,0,0)); }
fn rt_sys_epoll_wait(fd,ev,n,timeout) { return linux_result(linux_raw(linux_nr_epoll_pwait(),fd,ev,n,timeout,0,8)); }
fn rt_sys_pthread_sigmask(how,set,old) { return linux_result(linux_raw(linux_nr_rt_sigprocmask(),how,set,old,8,0,0)); }
fn rt_sys_signalfd(fd,mask,flags) { return linux_result(linux_raw(linux_nr_signalfd4(),fd,mask,8,flags,0,0)); }
fn rt_sys_sigaction(sig,act,old) { return linux_result(linux_raw(linux_nr_rt_sigaction(),sig,act,old,8,0,0)); }

fn rt_sys_sched_getaffinity(pid,n,set) {
    let r=linux_result(linux_raw(linux_nr_sched_getaffinity(),pid,n,set,0,0,0));
    if r < 0 { return r; } return 0;
}
fn rt_sys_getcwd(buf,n) {
    if linux_result(linux_raw(linux_nr_getcwd(),buf,n,0,0,0,0)) < 0 { return 0; }
    return buf;
}
fn rt_sys_poll(fds,n,timeout) {
    let sec=timeout/1000; let ns=(timeout%1000)*1000000;
    let ts=calloc(2,8); ts[0]=sec; ts[1]=ns;
    let p=ts; if timeout < 0 { p=0; }
    let r=linux_result(linux_raw(linux_nr_ppoll(),fds,n,p,0,8,0));
    free(ts); return r;
}
fn rt_sys__exit(code) { return linux_raw(linux_nr_exit_group(),code,0,0,0,0,0); }
fn rt_sys_exit(code) { return rt_sys__exit(code); }
fn rt_sys_signal(sig,h) {
    let act=calloc(4,8); let old=calloc(4,8);
    act[0]=h; act[1]=0x14000000; act[2]=linux_restorer_ptr();
    let r=rt_sys_sigaction(sig,act,old); let prev=old[0];
    free(act); free(old); if r < 0 { return -1; } return prev;
}
// Directory handles: fd, valid bytes, cursor, sticky error, path, buffer.
fn rt_sys_opendir(path) {
    let fd=rt_sys_open(path,linux_directory_flags(),0);
    if fd < 0 { return 0; }
    let d=calloc(6,8); d[0]=fd;
    let n=strlen(path); d[4]=malloc(n+1); memcpy(d[4],path,n+1);
    d[5]=malloc(32768); return d;
}
fn rt_sys_readdir(d) {
    while 1 {
        if d[2] >= d[1] {
            let n=linux_result(linux_raw(linux_nr_getdents64(),d[0],d[5],32768,0,0,0));
            if n < 0 { if linux_get_errno() == 4 { continue; } d[3]=linux_get_errno(); return 0; }
            if n == 0 { return 0; } d[1]=n; d[2]=0;
        }
        let ent=d[5]+d[2]; let reclen=__ld(ent+16,1);
        if reclen < 20 || reclen > d[1]-d[2] { linux_set_errno(5); d[3]=5; return 0; }
        let bytes=reclen-19; let name=ent+19;
        if memchr(name,0,bytes) == 0 { linux_set_errno(5); d[3]=5; return 0; }
        d[2]=d[2]+reclen;
        linux_dir_type(d,ent);
        return ent;
    }
}
fn rt_sys_closedir(d) {
    let r=rt_sys_close(d[0]); free(d[4]); free(d[5]); free(d); return r;
}

// Unknown d_type is resolved with lstat, preserving a symbolic link as DT_LNK.
fn linux_dir_type(d,ent) {
    if load8(ent+18) != 0 { return; }
    let name=ent+19; let a=strlen(d[4]); let b=strlen(name); let p=malloc(a+b+2);
    memcpy(p,d[4],a); store8(p+a,'/'); memcpy(p+a+1,name,b+1);
    let st=calloc(1,256);
    if rt_sys_lstat(p,st) == 0 { store8(ent+18,linux_stat_type(st)); }
    free(st); free(p);
}
