// arm64 part of the Linux runtime: the struct layouts that differ from x86-64.

const TARGET_X64 = false

// struct stat on arm64 Linux: st_mode is a u32 at 16 (24 on x86-64).
fn rt_stat_mode(st i64) i64 {
	return __ld(st+16, 2) & 0xffffffff
}

// rt_task_init sets a new task's saved registers (arm64: x19-x27, x29, x30, sp, d8-d15) so
// the first switch into it enters rt_task_entry with sp at top.
fn rt_task_init(t i64, top i64) {
	t[9] = 0
	t[10] = cast(i64, rt_task_entry)
	t[11] = top
}

// rt_task_sp reads the saved stack pointer without changing the swap layout.
fn rt_task_sp(t i64) i64 { return t[11] }

// rt_ctx_init sets saved registers (arm64) so the first switch into t calls entry with sp at top.
fn rt_ctx_init(t i64, top i64, entry i64) {
	t[9] = 0
	t[10] = entry
	t[11] = top
}

// rt_uctx_redirect makes the context the signal interrupted (ucontext_t) resume at pc with the
// stack pointer sp: uc_mcontext starts at 176; fault_address, regs[31], then sp at 432 and pc at 440.
fn rt_uctx_redirect(uctx i64, pc i64, sp i64) {
	(uctx + 432)[0] = sp
	(uctx + 440)[0] = pc
}

// rt_uctx_altstack_top is the top of the thread's signal stack, which the context records
// (uc_stack at 16: ss_sp, ss_flags, ss_size at 32).
fn rt_uctx_altstack_top(uctx i64) i64 {
	return (uctx + 16)[0] + (uctx + 32)[0]
}
