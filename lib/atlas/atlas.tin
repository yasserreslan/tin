// Package atlas is the functions on maps (like Go's maps): keys, values, copies and comparisons.
package atlas

import "sift"

// Keys returns m's keys in insertion order.
func Keys[K comparable, V any](m map[K]V) []K {
	out := make([]K, 0, len(m))
	for k := range m {
		out = append(out, k)
	}
	return out
}

// Values returns m's values in insertion order.
func Values[K comparable, V any](m map[K]V) []V {
	out := make([]V, 0, len(m))
	for _, v := range m {
		out = append(out, v)
	}
	return out
}

// SortedKeys returns m's keys in ascending order (NaN first), whatever order they were added in.
func SortedKeys[K i64 | i32 | i16 | i8 | u64 | u32 | u16 | u8 | f64 | f32 | str, V any](m map[K]V) []K {
	out := make([]K, 0, len(m))
	for k := range m {
		out = append(out, k)
	}
	sift.Sort(mut out)
	return out
}

// Clone returns a new map with the same entries, in the same order.
func Clone[K comparable, V any](m map[K]V) map[K]V {
	out := make(map[K]V)
	for k, v := range m {
		out[k] = v
	}
	return out
}

// Copy adds every entry of src to dst, replacing the values of keys dst already has.
func Copy[K comparable, V any](dst mut map[K]V, src map[K]V) {
	for k, v := range src {
		dst[k] = v
	}
}

// Equal reports whether a and b have the same keys with equal values.
func Equal[K comparable, V comparable](a map[K]V, b map[K]V) bool {
	if len(a) != len(b) {
		return false
	}
	for k, v1 := range a {
		v2, ok := b[k]
		if !ok || v1 != v2 {
			return false
		}
	}
	return true
}

// EqualFunc is Equal with eq comparing the values, which may have different types.
func EqualFunc[K comparable, V1 any, V2 any](a map[K]V1, b map[K]V2, eq func(V1, V2) bool) bool {
	if len(a) != len(b) {
		return false
	}
	for k, v1 := range a {
		v2, ok := b[k]
		if !ok || !eq(v1, v2) {
			return false
		}
	}
	return true
}

// DeleteFunc removes the entries for which del is true.
func DeleteFunc[K comparable, V any](m mut map[K]V, del func(K, V) bool) {
	drop := make([]K, 0)
	for k, v := range m {
		if del(k, v) {
			drop = append(drop, k)
		}
	}
	for _, k := range drop {
		delete(m, k)
	}
}
