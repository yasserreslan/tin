// Package io declares the streaming shapes: a type satisfies Reader, Writer, Closer or
// Seeker by having the methods, with no declaration, and compositions like
// ReadWriteCloser by satisfying every listed shape. The helpers (Copy, ReadAll, Pipe,
// MultiWriter, ...) and EOF as a sentinel fault land with the io port (roadmap #141);
// the byte, rune and string shapes (ByteReader, RuneReader, StringWriter, ...) and Go's
// ReaderFrom and WriterTo (which need dyn) are not declared yet.
package io

// Reader is anything with Read: it fills buf and returns how many bytes it wrote.
shape Reader { Read(buf mut []u8) !i64 }

// Writer is anything with Write: it takes data and returns how many bytes it took.
shape Writer { Write(data []u8) !i64 }

// Closer is anything with Close.
shape Closer { Close() !i64 }

// Seeker is anything with Seek: offset is relative to whence (0 start, 1 current, 2 end).
shape Seeker { Seek(offset i64, whence i64) !i64 }

// ReaderAt is a reader that does not move a position: it reads at off.
shape ReaderAt { ReadAt(buf mut []u8, off i64) !i64 }

// WriterAt is a writer that does not move a position: it writes at off.
shape WriterAt { WriteAt(data []u8, off i64) !i64 }

// ReadWriter reads and writes.
shape ReadWriter {
	Reader
	Writer
}

// ReadCloser reads and closes.
shape ReadCloser {
	Reader
	Closer
}

// WriteCloser writes and closes.
shape WriteCloser {
	Writer
	Closer
}

// WriteSeeker writes and seeks.
shape WriteSeeker {
	Writer
	Seeker
}

// ReadSeekCloser reads, seeks and closes.
shape ReadSeekCloser {
	Reader
	Seeker
	Closer
}

// ReadWriteCloser reads, writes and closes.
shape ReadWriteCloser {
	Reader
	Writer
	Closer
}

// ReadSeeker reads and seeks.
shape ReadSeeker {
	Reader
	Seeker
}

// ReadWriteSeeker reads, writes and seeks.
shape ReadWriteSeeker {
	Reader
	Writer
	Seeker
}
