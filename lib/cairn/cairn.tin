// Package cairn is a set of containers for i64 and str values: heaps, a deque, a queue, hash sets, a bitset and an LRU cache.
package cairn

// IntHeap is a binary min-heap of i64 values; IntHeap{} is ready to use.
type IntHeap struct {
	xs []i64
	n  i64
}

// NewIntHeap returns an empty min-heap with room for n values.
func NewIntHeap(n i64) IntHeap {
	return IntHeap{xs: make([]i64, 0, n), n: 0}
}

// Push adds v to the heap.
func (h mut IntHeap) Push(v i64) {
	if h.n < len(h.xs) {
		h.xs[h.n] = v
	} else {
		h.xs = append(h.xs, v)
	}
	xs := h.xs
	i := h.n
	h.n++
	for i > 0 {
		p := (i - 1) / 2
		if xs[p] <= v {
			break
		}
		xs[i] = xs[p]
		i = p
	}
	xs[i] = v
}

// Pop removes and returns the smallest value, or (0, false) when the heap is empty.
func (h mut IntHeap) Pop() (i64, bool) {
	n := h.n
	if n == 0 {
		return 0, false
	}
	xs := h.xs
	top := xs[0]
	n--
	h.n = n
	if n > 0 {
		last := xs[n]
		i := 0
		for {
			c := 2*i + 1
			if c >= n {
				break
			}
			if c+1 < n && xs[c+1] < xs[c] {
				c++
			}
			if xs[c] >= last {
				break
			}
			xs[i] = xs[c]
			i = c
		}
		xs[i] = last
	}
	return top, true
}

// Peek returns the smallest value without removing it, or (0, false) when the heap is empty.
func (h IntHeap) Peek() (i64, bool) {
	if h.n == 0 {
		return 0, false
	}
	return h.xs[0], true
}

// Len returns the number of values in the heap.
func (h IntHeap) Len() i64 {
	return h.n
}

// IntMaxHeap is a binary max-heap of i64 values; IntMaxHeap{} is ready to use.
type IntMaxHeap struct {
	xs []i64
	n  i64
}

// NewIntMaxHeap returns an empty max-heap with room for n values.
func NewIntMaxHeap(n i64) IntMaxHeap {
	return IntMaxHeap{xs: make([]i64, 0, n), n: 0}
}

// Push adds v to the heap.
func (h mut IntMaxHeap) Push(v i64) {
	if h.n < len(h.xs) {
		h.xs[h.n] = v
	} else {
		h.xs = append(h.xs, v)
	}
	xs := h.xs
	i := h.n
	h.n++
	for i > 0 {
		p := (i - 1) / 2
		if xs[p] >= v {
			break
		}
		xs[i] = xs[p]
		i = p
	}
	xs[i] = v
}

// Pop removes and returns the largest value, or (0, false) when the heap is empty.
func (h mut IntMaxHeap) Pop() (i64, bool) {
	n := h.n
	if n == 0 {
		return 0, false
	}
	xs := h.xs
	top := xs[0]
	n--
	h.n = n
	if n > 0 {
		last := xs[n]
		i := 0
		for {
			c := 2*i + 1
			if c >= n {
				break
			}
			if c+1 < n && xs[c+1] > xs[c] {
				c++
			}
			if xs[c] <= last {
				break
			}
			xs[i] = xs[c]
			i = c
		}
		xs[i] = last
	}
	return top, true
}

// Peek returns the largest value without removing it, or (0, false) when the heap is empty.
func (h IntMaxHeap) Peek() (i64, bool) {
	if h.n == 0 {
		return 0, false
	}
	return h.xs[0], true
}

// Len returns the number of values in the heap.
func (h IntMaxHeap) Len() i64 {
	return h.n
}

// IntDeque is a double-ended queue of i64 values in a growing ring buffer; IntDeque{} is ready to use.
type IntDeque struct {
	buf  []i64
	head i64
	n    i64
}

// NewIntDeque returns an empty deque with room for n values.
func NewIntDeque(n i64) IntDeque {
	if n < 1 {
		n = 1
	}
	return IntDeque{buf: make([]i64, n), head: 0, n: 0}
}

// grow doubles the ring buffer, unrolling the values to start at index 0.
func (d mut IntDeque) grow() {
	c := len(d.buf)
	nc := c * 2
	if nc < 8 {
		nc = 8
	}
	nb := make([]i64, nc)
	j := d.head
	for i := 0; i < d.n; i++ {
		nb[i] = d.buf[j]
		j++
		if j == c {
			j = 0
		}
	}
	d.buf = nb
	d.head = 0
}

// PushBack appends v at the back.
func (d mut IntDeque) PushBack(v i64) {
	if d.n == len(d.buf) {
		d.grow()
	}
	i := d.head + d.n
	if i >= len(d.buf) {
		i -= len(d.buf)
	}
	d.buf[i] = v
	d.n++
}

// PushFront prepends v at the front.
func (d mut IntDeque) PushFront(v i64) {
	if d.n == len(d.buf) {
		d.grow()
	}
	h := d.head - 1
	if h < 0 {
		h += len(d.buf)
	}
	d.buf[h] = v
	d.head = h
	d.n++
}

// PopFront removes and returns the front value, or (0, false) when the deque is empty.
func (d mut IntDeque) PopFront() (i64, bool) {
	if d.n == 0 {
		return 0, false
	}
	v := d.buf[d.head]
	h := d.head + 1
	if h == len(d.buf) {
		h = 0
	}
	d.head = h
	d.n--
	return v, true
}

// PopBack removes and returns the back value, or (0, false) when the deque is empty.
func (d mut IntDeque) PopBack() (i64, bool) {
	if d.n == 0 {
		return 0, false
	}
	i := d.head + d.n - 1
	if i >= len(d.buf) {
		i -= len(d.buf)
	}
	d.n--
	return d.buf[i], true
}

// Front returns the front value, or (0, false) when the deque is empty.
func (d IntDeque) Front() (i64, bool) {
	if d.n == 0 {
		return 0, false
	}
	return d.buf[d.head], true
}

// Back returns the back value, or (0, false) when the deque is empty.
func (d IntDeque) Back() (i64, bool) {
	if d.n == 0 {
		return 0, false
	}
	i := d.head + d.n - 1
	if i >= len(d.buf) {
		i -= len(d.buf)
	}
	return d.buf[i], true
}

// At returns the i-th value from the front, panicking when i is out of range.
func (d IntDeque) At(i i64) i64 {
	if i < 0 || i >= d.n {
		panic("cairn: IntDeque index out of range")
	}
	j := d.head + i
	if j >= len(d.buf) {
		j -= len(d.buf)
	}
	return d.buf[j]
}

// Len returns the number of values in the deque.
func (d IntDeque) Len() i64 {
	return d.n
}

// IntQueue is a first-in first-out queue of i64 values in a growing ring buffer; IntQueue{} is ready to use.
type IntQueue struct {
	buf  []i64
	head i64
	n    i64
}

// NewIntQueue returns an empty queue with room for n values.
func NewIntQueue(n i64) IntQueue {
	if n < 1 {
		n = 1
	}
	return IntQueue{buf: make([]i64, n), head: 0, n: 0}
}

// Push appends v at the back of the queue.
func (q mut IntQueue) Push(v i64) {
	c := len(q.buf)
	if q.n == c {
		nc := c * 2
		if nc < 8 {
			nc = 8
		}
		nb := make([]i64, nc)
		j := q.head
		for i := 0; i < q.n; i++ {
			nb[i] = q.buf[j]
			j++
			if j == c {
				j = 0
			}
		}
		q.buf = nb
		q.head = 0
		c = nc
	}
	i := q.head + q.n
	if i >= c {
		i -= c
	}
	q.buf[i] = v
	q.n++
}

// Pop removes and returns the front value, or (0, false) when the queue is empty.
func (q mut IntQueue) Pop() (i64, bool) {
	if q.n == 0 {
		return 0, false
	}
	v := q.buf[q.head]
	h := q.head + 1
	if h == len(q.buf) {
		h = 0
	}
	q.head = h
	q.n--
	return v, true
}

// Peek returns the front value without removing it, or (0, false) when the queue is empty.
func (q IntQueue) Peek() (i64, bool) {
	if q.n == 0 {
		return 0, false
	}
	return q.buf[q.head], true
}

// Len returns the number of values in the queue.
func (q IntQueue) Len() i64 {
	return q.n
}

// IntSet is a hash set of i64 values with open addressing and linear probing; IntSet{} is ready to use.
type IntSet struct {
	keys  []i64
	ctrl  []u8
	n     i64
	used  i64
	shift i64
}

// NewIntSet returns an empty set sized for about n values.
func NewIntSet(n i64) IntSet {
	s := IntSet{keys: make([]i64, 0), ctrl: make([]u8, 0), n: 0, used: 0, shift: 64}
	c := i64(8)
	for c*3 < n*4 {
		c *= 2
	}
	s.alloc(c)
	return s
}

// alloc gives the set an empty table of c slots (c a power of two).
func (s mut IntSet) alloc(c i64) {
	s.keys = make([]i64, c)
	s.ctrl = make([]u8, c)
	shift := i64(64)
	for x := c; x > 1; x >>= 1 {
		shift--
	}
	s.shift = shift
	s.n = 0
	s.used = 0
}

// slot returns the home slot of k.
func (s IntSet) slot(k i64) i64 {
	return i64(u64(rt_hash_int(k)) >> s.shift)
}

// rehash rebuilds the table with c slots, dropping tombstones.
func (s mut IntSet) rehash(c i64) {
	okeys := s.keys
	octrl := s.ctrl
	s.alloc(c)
	for i, f := range octrl {
		if f == 1 {
			s.Add(okeys[i])
		}
	}
}

// Add puts k in the set and reports whether it was absent.
func (s mut IntSet) Add(k i64) bool {
	c := len(s.ctrl)
	if c == 0 {
		s.alloc(8)
		c = 8
	} else if (s.used+1)*4 > c*3 {
		nc := c
		if (s.n+1)*2 > c {
			nc = c * 2
		}
		s.rehash(nc)
		c = nc
	}
	mask := c - 1
	i := s.slot(k)
	free := i64(-1)
	for {
		f := s.ctrl[i]
		if f == 0 {
			break
		}
		if f == 1 {
			if s.keys[i] == k {
				return false
			}
		} else if free < 0 {
			free = i
		}
		i = (i + 1) & mask
	}
	if free >= 0 {
		i = free
	} else {
		s.used++
	}
	s.ctrl[i] = 1
	s.keys[i] = k
	s.n++
	return true
}

// find returns the slot holding k, or -1.
func (s IntSet) find(k i64) i64 {
	c := len(s.ctrl)
	if s.n == 0 {
		return -1
	}
	mask := c - 1
	i := s.slot(k)
	for {
		f := s.ctrl[i]
		if f == 0 {
			return -1
		}
		if f == 1 && s.keys[i] == k {
			return i
		}
		i = (i + 1) & mask
	}
}

// Has reports whether k is in the set.
func (s IntSet) Has(k i64) bool {
	return s.find(k) >= 0
}

// Del removes k and reports whether it was present.
func (s mut IntSet) Del(k i64) bool {
	i := s.find(k)
	if i < 0 {
		return false
	}
	s.ctrl[i] = 2
	s.n--
	return true
}

// Len returns the number of values in the set.
func (s IntSet) Len() i64 {
	return s.n
}

// Keys returns the values in table order (unsorted).
func (s IntSet) Keys() []i64 {
	out := make([]i64, 0, s.n)
	for i, f := range s.ctrl {
		if f == 1 {
			out = append(out, s.keys[i])
		}
	}
	return out
}

// StrSet is a set of strs backed by a map; make one with NewStrSet.
type StrSet struct {
	m map[str]bool
}

// NewStrSet returns an empty set.
func NewStrSet() StrSet {
	return StrSet{m: make(map[str]bool)}
}

// Add puts k in the set and reports whether it was absent.
func (s mut StrSet) Add(k str) bool {
	_, ok := s.m[k]
	if ok {
		return false
	}
	s.m[k] = true
	return true
}

// Has reports whether k is in the set.
func (s StrSet) Has(k str) bool {
	_, ok := s.m[k]
	return ok
}

// Del removes k and reports whether it was present.
func (s mut StrSet) Del(k str) bool {
	_, ok := s.m[k]
	if !ok {
		return false
	}
	delete(s.m, k)
	return true
}

// Len returns the number of strs in the set.
func (s StrSet) Len() i64 {
	return len(s.m)
}

// Keys returns the strs in map order (unsorted).
func (s StrSet) Keys() []str {
	out := make([]str, 0, s.Len())
	for k, _ := range s.m {
		out = append(out, k)
	}
	return out
}

// Bitset is a growing set of bit indexes stored in []u64 words; Bitset{} is ready to use.
type Bitset struct {
	words []u64
}

// NewBitset returns a bitset with room for n bits (Set grows it further as needed).
func NewBitset(n i64) Bitset {
	return Bitset{words: make([]u64, (n+63)/64)}
}

// popcount returns the number of set bits in x.
func popcount(x u64) i64 {
	x = x - ((x >> 1) & 0x5555555555555555)
	x = (x & 0x3333333333333333) + ((x >> 2) & 0x3333333333333333)
	x = (x + (x >> 4)) & 0x0f0f0f0f0f0f0f0f
	return i64((x * 0x0101010101010101) >> 56)
}

// trailingZeros returns the index of the lowest set bit of x (x must not be 0).
func trailingZeros(x u64) i64 {
	return popcount((x & (0 - x)) - 1)
}

// Set turns bit i on, growing the bitset when i is past its end.
func (b mut Bitset) Set(i i64) {
	if i < 0 {
		panic("cairn: negative Bitset index")
	}
	w := i >> 6
	for w >= len(b.words) {
		b.words = append(b.words, 0)
	}
	b.words[w] |= u64(1) << (i & 63)
}

// Clear turns bit i off (bits past the end are already off).
func (b mut Bitset) Clear(i i64) {
	if i < 0 {
		return
	}
	w := i >> 6
	if w >= len(b.words) {
		return
	}
	bit := u64(1) << (i & 63)
	if b.words[w]&bit != 0 {
		b.words[w] ^= bit
	}
}

// Has reports whether bit i is on (false past the end or for a negative i).
func (b Bitset) Has(i i64) bool {
	if i < 0 {
		return false
	}
	w := i >> 6
	if w >= len(b.words) {
		return false
	}
	return b.words[w]&(u64(1)<<(i&63)) != 0
}

// Count returns the number of bits that are on.
func (b Bitset) Count() i64 {
	n := i64(0)
	for _, w := range b.words {
		n += popcount(w)
	}
	return n
}

// Next returns the lowest bit index >= i that is on, or -1.
func (b Bitset) Next(i i64) i64 {
	if i < 0 {
		i = 0
	}
	w := i >> 6
	n := len(b.words)
	if w >= n {
		return -1
	}
	x := b.words[w] >> (i & 63)
	if x != 0 {
		return i + trailingZeros(x)
	}
	for w++; w < n; w++ {
		x = b.words[w]
		if x != 0 {
			return w*64 + trailingZeros(x)
		}
	}
	return -1
}

// Len returns the number of bits the bitset currently holds words for.
func (b Bitset) Len() i64 {
	return len(b.words) * 64
}

// Words returns the underlying words without copying.
func (b Bitset) Words() []u64 {
	return b.words
}

// LRU is a least-recently-used cache from str to str with a fixed capacity; use NewLRU.
type LRU struct {
	cap  i64
	n    i64
	idx  map[str]i64
	keys []str
	vals []str
	prev []i64
	next []i64
	head i64
	tail i64
	free i64
}

// NewLRU returns an empty cache holding at most capacity entries (at least 1).
func NewLRU(capacity i64) LRU {
	if capacity < 1 {
		capacity = 1
	}
	c := LRU{cap: capacity, n: 0, idx: make(map[str]i64), keys: make([]str, capacity), vals: make([]str, capacity), prev: make([]i64, capacity), next: make([]i64, capacity), head: -1, tail: -1, free: 0}
	for i := 0; i < capacity; i++ {
		c.keys[i] = ""
		c.vals[i] = ""
		c.prev[i] = -1
		c.next[i] = i + 1
	}
	c.next[capacity-1] = -1
	return c
}

// unlink removes slot i from the recency list.
func (c mut LRU) unlink(i i64) {
	p := c.prev[i]
	nx := c.next[i]
	if p >= 0 {
		c.next[p] = nx
	} else {
		c.head = nx
	}
	if nx >= 0 {
		c.prev[nx] = p
	} else {
		c.tail = p
	}
}

// linkFront makes slot i the most recently used.
func (c mut LRU) linkFront(i i64) {
	c.prev[i] = -1
	c.next[i] = c.head
	if c.head >= 0 {
		c.prev[c.head] = i
	} else {
		c.tail = i
	}
	c.head = i
}

// Get returns the value for k and marks it most recently used, or ("", false).
func (c mut LRU) Get(k str) (str, bool) {
	i, ok := c.idx[k]
	if !ok {
		return "", false
	}
	if c.head != i {
		c.unlink(i)
		c.linkFront(i)
	}
	return c.vals[i], true
}

// Peek returns the value for k without touching its recency, or ("", false).
func (c LRU) Peek(k str) (str, bool) {
	i, ok := c.idx[k]
	if !ok {
		return "", false
	}
	return c.vals[i], true
}

// Has reports whether k is cached, without touching its recency.
func (c LRU) Has(k str) bool {
	_, ok := c.idx[k]
	return ok
}

// Put stores v under k as most recently used, evicting the least recently used entry when full.
func (c mut LRU) Put(k str, v str) {
	i, ok := c.idx[k]
	if ok {
		c.vals[i] = v
		if c.head != i {
			c.unlink(i)
			c.linkFront(i)
		}
		return
	}
	if c.n == c.cap {
		i = c.tail
		c.unlink(i)
		delete(c.idx, c.keys[i])
	} else {
		i = c.free
		c.free = c.next[i]
		c.n++
	}
	c.keys[i] = k
	c.vals[i] = v
	c.idx[k] = i
	c.linkFront(i)
}

// Del removes k and reports whether it was cached.
func (c mut LRU) Del(k str) bool {
	i, ok := c.idx[k]
	if !ok {
		return false
	}
	c.unlink(i)
	delete(c.idx, k)
	c.keys[i] = ""
	c.vals[i] = ""
	c.next[i] = c.free
	c.free = i
	c.n--
	return true
}

// Len returns the number of cached entries.
func (c LRU) Len() i64 {
	return c.n
}

// Cap returns the capacity.
func (c LRU) Cap() i64 {
	return c.cap
}

// Keys returns the cached keys from most to least recently used.
func (c LRU) Keys() []str {
	out := make([]str, 0, c.n)
	for i := c.head; i >= 0; i = c.next[i] {
		out = append(out, c.keys[i])
	}
	return out
}
