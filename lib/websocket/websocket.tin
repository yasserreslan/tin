// Package websocket is the WebSocket protocol (RFC 6455): Accept upgrades an anvil request,
// Dial connects to a server (ws://, or wss:// over TLS 1.3). Messages are text or binary; pings are answered and
// fragments joined inside Read. Inside a request task a Read waits without blocking the
// core, so one core holds many idle connections.
//
//	fn handle(q anvil.Req, w mut anvil.Out) {
//		let ws = websocket.Accept(q, mut w) catch _ { return }
//		ws.Each(echo) catch _ {}
//	}
//
//	fn echo(ws websocket.Conn, m websocket.Message) ! {
//		try ws.WriteText("echo: {m.Data}")
//	}
package websocket

import "anvil"
import "glyph"
import "say"
import "seal"
import "tls"
import "twine"
import "wire"


// Message is one complete message.
type Message struct {
	Text bool // a text message (valid UTF-8); otherwise binary
	Data str
}

// Conn is a WebSocket connection.
type Conn struct {
	open bool // false for the zero Conn
	st   i64
}

// The state lives in the same pool as its Conn. Its I/O buffer is heap-owned and
// released on Close, or automatically before an owning request/scope ends.
const sFd = 0
const sClient = 1  // we are the client: our frames are masked, the server's are not
const sBuf = 2     // bytes read and not yet used, from sS to sE
const sS = 3
const sE = 4
const sCap = 5
const sClosed = 6  // a close frame was sent
const sTimeout = 7 // ns a read or write may wait (0: no limit)
const sWriting = 8 // a task is writing a frame: others wait their turn
const sOwnFd = 9   // Close closes the descriptor (Dial); anvil closes Accept's
const sMax = 10    // the largest message accepted
const sTls = 11    // wss://: the tls.Conn every byte goes through (a client's, in the same pool, or anvil's for Accept)
const sTn = 12     // its number in a recorded or replayed request (websocket.dial@1, #241); 0: accepted
const stWords = 13

const guid = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"

const opCont = 0
const opText = 1
const opBinary = 2
const opClose = 8
const opPing = 9
const opPong = 10

fn new_state(fd i64, client bool) i64 {
	let st = rt_alloc(stWords * 8)
	st[sFd] = fd
	st[sClient] = i64(client)
	st[sCap] = 16384
	st[sBuf] = malloc(st[sCap])
	st[sMax] = 16 << 20
	rt_task_cleanup(release_state, st)
	return st
}

fn accept_key(key str) str {
	return seal.B64(seal.Sha1(key + guid))
}

fn has_token(v str, tok str) bool {
	for _, part in twine.Split(v, ",") {
		if twine.EqualFold(twine.TrimSpace(part), tok) {
			return true
		}
	}
	return false
}

// Accept completes the opening handshake for request q and takes over its connection. A
// request that is not a WebSocket handshake gets a 400 (426 for another version) in w and
// fails. The connection and its buffers close when the handler returns.
fn Accept(q anvil.Req, w mut anvil.Out) !Conn {
	let key = q.Header("Sec-WebSocket-Key")
	if q.Method != "GET" || !has_token(q.Header("Upgrade"), "websocket") || !has_token(q.Header("Connection"), "upgrade") || key == "" {
		w.Status(400)
		w.Text("not a websocket handshake")
		fail "websocket: not a websocket handshake"
	}
	if q.Header("Sec-WebSocket-Version") != "13" {
		w.Status(426)
		w.Head("Sec-WebSocket-Version", "13")
		w.Text("websocket version 13 only")
		fail "websocket: unsupported version"
	}
	let raw = seal.B64Decode(key) catch _ { []u8{} }
	if len(raw) != 16 {
		w.Status(400)
		w.Text("bad Sec-WebSocket-Key")
		fail "websocket: bad Sec-WebSocket-Key"
	}
	let fd = try q.Hijack()
	let st = new_state(fd, false)
	if let tc = q.TLSConn() {
		// wss:// on anvil.ServeTLS: the descriptor carries records, so every byte goes through
		// the request's tls.Conn (Close sends its close_notify; anvil closes the descriptor).
		st[sTls] = cast(i64, tc)
	}
	let c = Conn{open: true, st: st}
	let err = c.write_all("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: {accept_key(key)}\r\n\r\n")
	if err != nil {
		c.release()
		fail err
	}
	return c
}

// Dial connects to a ws:// or wss:// URL ("ws://host:port/path"); wss:// verifies the
// server's certificate against the system's roots. Close it when finished; inside a request
// task, it is also closed automatically when its scope ends.
fn Dial(url str) !Conn {
	let tp = rt_tape()
	if tp != 0 {
		return try dial_taped(tp, url) // recorded for replay (#241)
	}
	return try DialTLS(url, tls.Config{ServerName: "", RootCAs: "", ALPN: []str{}, Timeout: 0, InsecureSkipVerify: false})
}

// DialTLS is Dial with the TLS configuration of a wss:// URL (RootCAs, Timeout for the
// handshake, InsecureSkipVerify for tests); the server name is the URL's host, and ALPN offers
// http/1.1 whatever cfg.ALPN says (the upgrade is HTTP/1.1).
fn DialTLS(url str, cfg tls.Config) !Conn {
	let secure = twine.HasPrefix(url, "wss://")
	if !secure && !twine.HasPrefix(url, "ws://") {
		fail "websocket: only ws:// and wss:// URLs"
	}
	mut rest = url[5:]
	if secure {
		rest = url[6:]
	}
	let slash = twine.IndexByte(rest, '/')
	mut host = rest
	mut path = "/"
	if slash >= 0 {
		host = rest[:slash]
		path = rest[slash:]
	}
	mut addr = host
	if twine.LastIndexByte(host, ':') < 0 || twine.HasSuffix(host, "]") {
		addr = host + ":80"
		if secure {
			addr = host + ":443"
		}
	}
	mut st = 0
	if secure {
		// A WebSocket here is an HTTP/1.1 upgrade: ALPN offers http/1.1 alone (#478).
		let wcfg = tls.Config{ServerName: cfg.ServerName, RootCAs: cfg.RootCAs, ALPN: []str{"http/1.1"}, Timeout: cfg.Timeout,
			InsecureSkipVerify: cfg.InsecureSkipVerify, Certificate: cfg.Certificate, Key: cfg.Key, MinVersion: cfg.MinVersion}
		let tc = try tls.Dial(addr, wcfg)
		st = new_state(tc.Fd(), true)
		st[sTls] = cast(i64, tc)
	} else {
		let wc = try wire.Dial(addr)
		st = new_state(wc.Fd(), true)
	}
	st[sOwnFd] = 1
	let c = Conn{open: true, st: st}
	let key = seal.B64(seal.RandomBytes(16))
	let err = c.write_all("GET {path} HTTP/1.1\r\nHost: {host}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n")
	if err != nil {
		c.release()
		fail err
	}
	// Read the response head; what follows it is the first frames.
	for {
		let end = find_head_end(st)
		if end >= 0 {
			let head = rt_str_from_raw(st[sBuf]+st[sS], end)
			st[sS] += end + 4
			let lines = twine.Split(head, "\r\n")
			if len(lines) == 0 || !twine.HasPrefix(lines[0], "HTTP/1.1 101") {
				c.release()
				mut first = ""
				if len(lines) > 0 {
					first = lines[0]
				}
				fail "websocket: the server refused the upgrade: {first}"
			}
			mut got = ""
			for _, ln in lines[1:] {
				let colon = twine.IndexByte(ln, ':')
				if colon > 0 && twine.EqualFold(ln[:colon], "Sec-WebSocket-Accept") {
					got = twine.TrimSpace(ln[colon+1:])
				}
			}
			if got != accept_key(key) {
				c.release()
				fail "websocket: bad Sec-WebSocket-Accept"
			}
			return c
		}
		if st[sE]-st[sS] > 16384 {
			c.release()
			fail "websocket: response head too large"
		}
		let rerr = c.fill()
		if rerr != nil {
			c.release()
			fail rerr
		}
	}
}

fn find_head_end(st i64) i64 {
	let p = st[sBuf] + st[sS]
	let n = st[sE] - st[sS]
	{
		mut i = 0
		for i+3 < n {
			if load8(p+i) == '\r' && load8(p+i+1) == '\n' && load8(p+i+2) == '\r' && load8(p+i+3) == '\n' {
				return i
			}
			i += 1
		}
	}
	return -1
}

fn (c Conn) release() {
	release_state(c.st)
}

fn release_state(st i64) {
	if st[sTls] != 0 && st[sFd] >= 0 {
		// close_notify, then the descriptor.
		let tc = cast(tls.Conn, st[sTls])
		tc.Close()
		st[sTls] = 0
		st[sFd] = -1
	}
	if st[sOwnFd] != 0 && st[sFd] >= 0 {
		rt_sys_close(st[sFd])
		st[sFd] = -1
	}
	if st[sBuf] != 0 {
		free(st[sBuf])
		st[sBuf] = 0
	}
}

// SetTimeout limits every later read and write to ns nanoseconds (0: no limit).
fn (c Conn) SetTimeout(ns i64) {
	c.st[sTimeout] = ns
	if c.st[sTls] != 0 {
		let tc = cast(tls.Conn, c.st[sTls])
		tc.SetTimeout(ns)
	}
}

// SetMaxMessage sets the largest message Read accepts (default 16 MiB); a bigger one
// closes the connection with 1009.
fn (c Conn) SetMaxMessage(n i64) {
	c.st[sMax] = n
}

fn os_msg(what str, e i64) str {
	let m = rt_sys_strerror(e)
	return "websocket: {what}: {rt_str_from_raw(m, strlen(m))}"
}

fn wait_fail(r i64) ! {
	if r == waitDeadline {
		fail cast(fault, rt_wait_fault())
	}
	fail "websocket: timed out"
}

fn (c Conn) write_raw(p i64, n i64) ! {
	let st = c.st
	if st[sBuf] == 0 {
		fail "websocket: the connection is closed"
	}
	if st[sTls] != 0 {
		let tc = cast(tls.Conn, st[sTls])
		try tc.Write(rt_str_from_raw(p, n))
		return
	}
	for n > 0 {
		let k = rt_sys_write(st[sFd], p, n)
		if k > 0 {
			p += k
			n -= k
			continue
		}
		let e = rt_errno()
		if e == EINTR {
			continue
		}
		if e != EAGAIN {
			fail os_msg("write", e)
		}
		let r = rt_task_wait(st[sFd], 2, st[sTimeout])
		if r != waitReady {
			fail wait_fail(r)
		}
	}
}

fn (c Conn) write_all(s str) ! {
	return try c.write_raw(cast(i64, s)+8, len(s))
}

// fill reads more bytes into the buffer. A connection's task lives as long as the connection
// and spends it waiting here, so the wait is outside the runtime's reclamation epochs (#358): a
// handler must not use a value it borrowed from long-lived memory (a map entry) before a read
// after the read returns, which is the rule for any wait (hearth.Quiet).
fn (c Conn) fill() ! {
	let st = c.st
	if st[sBuf] == 0 {
		fail "websocket: the connection is closed"
	}
	if st[sS] > 0 && st[sS] == st[sE] {
		st[sS] = 0
		st[sE] = 0
	}
	if st[sE] == st[sCap] {
		if st[sS] > 0 {
			memmove(st[sBuf], st[sBuf]+st[sS], st[sE]-st[sS])
			st[sE] -= st[sS]
			st[sS] = 0
		} else {
			st[sCap] *= 2
			st[sBuf] = realloc(st[sBuf], st[sCap])
		}
	}
	if st[sTls] != 0 {
		let tc = cast(tls.Conn, st[sTls])
		let tmp = make([]u8, 0, st[sCap]-st[sE])
		for {
			// ReadNow never waits: the wait for the socket is here, outside the reclamation
			// epochs, as for a plain connection below.
			let k = tc.ReadNow(mut tmp, st[sCap]-st[sE]) catch e {
				if wire.IsEOF(e) {
					fail "websocket: closed (the peer went away)"
				}
				fail e
			}
			if k > 0 {
				break
			}
			rt_epoch_park()
			let r = rt_task_wait(st[sFd], 1, st[sTimeout])
			rt_epoch_unpark()
			if r != waitReady {
				fail wait_fail(r)
			}
		}
		memcpy(st[sBuf]+st[sE], cast(i64, tmp)[2], len(tmp))
		st[sE] += len(tmp)
		return
	}
	for {
		let k = rt_sys_read(st[sFd], st[sBuf]+st[sE], st[sCap]-st[sE])
		if k > 0 {
			st[sE] += k
			return
		}
		if k == 0 {
			fail "websocket: closed (the peer went away)"
		}
		let e = rt_errno()
		if e == EINTR {
			continue
		}
		if e != EAGAIN {
			fail os_msg("read", e)
		}
		rt_epoch_park()
		let r = rt_task_wait(st[sFd], 1, st[sTimeout])
		rt_epoch_unpark()
		if r != waitReady {
			fail wait_fail(r)
		}
	}
}

// need makes sure n bytes are buffered.
fn (c Conn) need(n i64) ! {
	let st = c.st
	if st[sBuf] == 0 {
		fail "websocket: closed (the connection is closed)"
	}
	if st[sS]+n > st[sCap] {
		memmove(st[sBuf], st[sBuf]+st[sS], st[sE]-st[sS])
		st[sE] -= st[sS]
		st[sS] = 0
		if n > st[sCap] {
			st[sCap] = n + 4096
			st[sBuf] = realloc(st[sBuf], st[sCap])
		}
	}
	for st[sE]-st[sS] < n {
		try c.fill()
	}
}

// frame sends one frame (the writer's turn is taken by the caller).
fn (c Conn) frame(op i64, p i64, n i64) ! {
	let st = c.st
	let hdr = calloc(2, 8)
	mut h = 0
	store8(hdr, 0x80|op)
	mut mask = 0
	if st[sClient] != 0 {
		mask = 0x80
	}
	if n < 126 {
		store8(hdr+1, mask|n)
		h = 2
	} else if n < 65536 {
		store8(hdr+1, mask|126)
		store8(hdr+2, n>>8)
		store8(hdr+3, n)
		h = 4
	} else {
		store8(hdr+1, mask|127)
		for i in 0..8 {
			store8(hdr+2+i, n>>(8*(7-i)))
		}
		h = 10
	}
	if st[sClient] == 0 {
		let err = c.write_raw(hdr, h)
		free(hdr)
		if err != nil {
			fail err
		}
		return try c.write_raw(p, n)
	}
	// A client masks its payload with a fresh key.
	rt_random(hdr+h, 4)
	let key = hdr + h
	h += 4
	let body = malloc(n + 1)
	for i in 0..n {
		store8(body+i, i64(load8(p+i))^i64(load8(key+i%4)))
	}
	mut err = c.write_raw(hdr, h)
	free(hdr)
	if err == nil {
		err = c.write_raw(body, n)
	}
	free(body)
	if err != nil {
		fail err
	}
}

// send takes the writer's turn (tasks on one core may share a Conn), sends, gives it back.
fn (c Conn) send(op i64, p i64, n i64) ! {
	let st = c.st
	if !c.open {
		fail "websocket: the connection is not open"
	}
	if st[sFd] < 0 && st[sOwnFd] == 0 {
		return // a replayed client connection has no socket: only its messages are on the tape
	}
	for st[sWriting] != 0 {
		rt_task_defer()
	}
	if st[sClosed] != 0 && op != opClose {
		fail "websocket: the connection is closing"
	}
	st[sWriting] = 1
	let err = c.frame(op, p, n)
	st[sWriting] = 0
	if err != nil {
		fail err
	}
}

// WriteText sends s as a text message.
fn (c Conn) WriteText(s str) ! {
	let tp = rt_tape()
	if tp != 0 && c.open {
		return try c.write_taped(tp, opText, cast(i64, s)+8, len(s)) // recorded for replay (#241)
	}
	return try c.send(opText, cast(i64, s)+8, len(s))
}

// WriteBinary sends b as a binary message.
fn (c Conn) WriteBinary(b []u8) ! {
	let tp = rt_tape()
	if tp != 0 && c.open {
		return try c.write_taped(tp, opBinary, cast(i64, b)[2], len(b)) // recorded for replay (#241)
	}
	return try c.send(opBinary, cast(i64, b)[2], len(b))
}

// Ping sends a ping; the peer's pong is consumed by Read.
fn (c Conn) Ping() ! {
	return try c.send(opPing, 0, 0)
}

fn close_payload(code i64, reason str) str {
	mut b = make([]u8, 0, 2+len(reason))
	b = append(b, u8(code>>8), u8(code))
	for i in 0..len(reason) {
		b = append(b, reason[i])
	}
	return str(b)
}

// CloseWith sends a close frame with code and reason; the connection then only drains.
fn (c Conn) CloseWith(code i64, reason str) ! {
	let st = c.st
	if st[sClosed] != 0 || st[sBuf] == 0 {
		return
	}
	let p = close_payload(code, reason)
	let err = c.send(opClose, cast(i64, p)+8, len(p))
	st[sClosed] = 1
	if err != nil {
		fail err
	}
}

// Close sends a normal close (1000) and, for a client, closes the connection.
fn (c Conn) Close() {
	if !c.open || c.st[sBuf] == 0 {
		return
	}
	c.CloseWith(1000, "") catch _ {}
	c.release()
}

// IsClosed reports whether err is the normal end of a connection: the peer closed it.
fn IsClosed(err fault) bool {
	return err != nil && twine.HasPrefix(say.Str(err), "websocket: closed")
}

// protocol_error closes with code and fails with msg.
fn (c Conn) protocol_error(code i64, msg str) ! {
	c.CloseWith(code, msg) catch _ {}
	fail "websocket: {msg}"
}

// Read returns the next message; it answers pings and joins fragments on the way. When the
// peer closes, it answers the close and fails with "websocket: closed (code)". The
// returned message lives in the caller's pool. For a long-lived stream, use Each
// to reset message allocations after every callback without invalidating the Conn.
fn (c Conn) Read() !Message {
	if !c.open {
		fail "websocket: the connection is not open"
	}
	let tp = rt_tape()
	if tp != 0 {
		return try c.read_taped(tp) // recorded for replay (#241)
	}
	let st = c.st
	if st[sBuf] == 0 {
		fail "websocket: closed (the connection is closed)"
	}
	let data = calloc(3, 8) // [heap buffer, length, capacity], including all fragments
	defer free_message(data)
	mut text = false
	mut started = false
	for {
		try c.need(2)
		mut p = st[sBuf] + st[sS]
		let b0 = i64(load8(p))
		let b1 = i64(load8(p + 1))
		let fin = b0&0x80 != 0
		let op = b0 & 15
		let masked = b1&0x80 != 0
		mut n = b1 & 127
		mut h = 2
		if b0&0x70 != 0 {
			fail c.protocol_error(1002, "reserved bits set")
		}
		if n == 126 {
			try c.need(4)
			p = st[sBuf] + st[sS]
			n = i64(load8(p+2))<<8 | i64(load8(p+3))
			h = 4
		} else if n == 127 {
			try c.need(10)
			p = st[sBuf] + st[sS]
			n = 0
			for i in 0..8 {
				n = n<<8 | i64(load8(p+2+i))
			}
			h = 10
			if n < 0 {
				fail c.protocol_error(1002, "bad frame length")
			}
		}
		if masked != (st[sClient] == 0) {
			fail c.protocol_error(1002, "wrong masking")
		}
		let mk = h
		if masked {
			h += 4
		}
		let control = op >= 8
		if control && (n > 125 || !fin) {
			fail c.protocol_error(1002, "bad control frame")
		}
		if !control && (st[sMax] < 0 || data[1] > st[sMax] || n > st[sMax]-data[1]) {
			fail c.protocol_error(1009, "message too big")
		}
		try c.need(h + n)
		p = st[sBuf] + st[sS]
		let pp = p + h
		if masked {
			for i in 0..n {
				store8(pp+i, i64(load8(pp+i))^i64(load8(p+mk+i%4)))
			}
		}
		st[sS] += h + n
		if op == opPing {
			if st[sClosed] == 0 {
				try c.send(opPong, pp, n)
			}
			continue
		}
		if op == opPong {
			continue
		}
		if op == opClose {
			mut code = 1005
			if n >= 2 {
				code = i64(load8(pp))<<8 | i64(load8(pp+1))
			}
			if n == 1 || (n > 2 && !glyph.Valid(rt_str_from_raw(pp+2, n-2))) {
				fail c.protocol_error(1002, "bad close frame")
			}
			if st[sClosed] == 0 {
				mut echo = 1000
				if n >= 2 {
					echo = code
				}
				c.CloseWith(echo, "") catch _ {}
			}
			fail "websocket: closed ({code})"
		}
		if op == opCont {
			if !started {
				fail c.protocol_error(1002, "continuation without a message")
			}
		} else if op == opText || op == opBinary {
			if started {
				fail c.protocol_error(1002, "a new message inside a fragmented one")
			}
			started = true
			text = op == opText
		} else {
			fail c.protocol_error(1002, "unknown opcode")
		}
		if data[1]+n > data[2] {
			mut cap = data[2]*2 + n
			if cap > st[sMax] {
				cap = st[sMax]
			}
			data[0] = realloc(data[0], cap)
			data[2] = cap
		}
		if n > 0 {
			memcpy(data[0]+data[1], pp, n)
		}
		data[1] += n
		if fin {
			let s = rt_str_from_raw(data[0], data[1])
			if text && !glyph.Valid(s) {
				fail c.protocol_error(1007, "text message is not UTF-8")
			}
			return Message{Text: text, Data: s}
		}
	}
}

fn free_message(data i64) {
	free(data[0])
	free(data)
}

// Each reads messages and calls h until a read or callback fails. Every callback has
// a reusable message pool: use keep() to retain its data after the callback returns.
// The Conn and all objects allocated before Each remain valid. Callbacks may wait.
// A closed peer returns the same IsClosed fault as Read; callback faults propagate.
fn (c Conn) Each(h fn(Conn, Message) !) ! {
	let scope = rt_pool_enter()
	for {
		mut (m, err) = c.Read()
		if err == nil {
			err = h(c, m)
		}
		if err != nil {
			// The fault belongs to the message pool too: copy it, with its chain, across the scope boundary.
			let held = rt_fault_copy(cast(i64, err), true)
			rt_pool_leave(scope)
			let out = rt_fault_copy(held, false)
			rt_fault_free(held)
			fail cast(fault, out)
		}
		rt_pool_scope_reset(scope)
	}
}

// ---- recording and replay (notes/interface_replay.md, section 4; #241) ----

// An effect's body runs at once, before it waits: these hand it its arguments and results.
mut tapedCall i64 // the URL to dial, or the Conn to read or write
mut tapedOp i64
mut tapedP i64
mut tapedN i64
mut tapedConn i64 // the connection a dial's body made

// dial_taped records or replays Dial as websocket.dial@1 (key: the URL; result: the
// connection's number in the request). Replaying, the connection has no socket.
fn dial_taped(tp i64, url str) !Conn {
	tapedCall = cast(i64, url)
	tapedConn = 0
	let v = try rt_effect(tp, "websocket.dial@1", url, dial_live)
	if len(v) != 8 {
		fail "replay: websocket.dial@1 result is damaged"
	}
	let n = tword(v, 0)
	if tapedConn != 0 {
		let c = cast(Conn, tapedConn)
		tapedConn = 0
		c.st[sTn] = n
		return c
	}
	let st = new_state(-1, true)
	st[sTn] = n
	return Conn{open: true, st: st}
}

fn dial_live() !str {
	let c = try Dial(cast(str, tapedCall))
	tapedConn = cast(i64, c)
	let n = rt_tape_kinds(rt_tape_of(rt_task_current()), "websocket.dial@1") + 1
	return tput(make([]u8, 0, 8), n)
}

// read_taped records or replays Read as websocket.read@1 (key: the connection's number; result:
// 1 text or 2 binary, then the data).
fn (c Conn) read_taped(tp i64) !Message {
	tapedCall = cast(i64, c)
	let v = try rt_effect(tp, "websocket.read@1", rt_i64str(c.st[sTn]), read_live)
	if len(v) < 16 || tword(v, 8) != len(v)-16 {
		fail "replay: websocket.read@1 result is damaged"
	}
	return Message{Text: tword(v, 0) == 1, Data: v[16:]}
}

fn read_live() !str {
	let c = cast(Conn, tapedCall)
	let m = try c.Read()
	mut b = make([]u8, 0, 16+len(m.Data))
	mut kind = 2
	if m.Text {
		kind = 1
	}
	b = append(b, tput(make([]u8, 0, 8), kind)...)
	b = append(b, tput(make([]u8, 0, 8), len(m.Data))...)
	b = append(b, m.Data...)
	return str(b)
}

// write_taped records or replays a message write as websocket.write@1 (key: the connection's
// number, " ", the bytes).
fn (c Conn) write_taped(tp i64, op i64, p i64, n i64) ! {
	tapedCall = cast(i64, c)
	tapedOp = op
	tapedP = p
	tapedN = n
	_ = try rt_effect(tp, "websocket.write@1", rt_i64str(c.st[sTn]) + " " + rt_str_from_raw(p, n), write_live)
}

fn write_live() !str {
	let c = cast(Conn, tapedCall)
	try c.send(tapedOp, tapedP, tapedN)
	return ""
}

fn tput(b []u8, v i64) str {
	for i in 0..8 {
		b = append(b, u8(v >> (8 * i)))
	}
	return str(b)
}

fn tword(s str, at i64) i64 {
	mut v = 0
	{
		mut i = 7
		for i >= 0 {
			v = v<<8 | i64(s[at+i])
			i -= 1
		}
	}
	return v
}
