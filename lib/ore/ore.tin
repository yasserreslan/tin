// Package ore works on byte slices ([]u8), like Go's bytes. Functions that append take
// the slice as mut and grow it in place.
package ore


fn data(b []u8) i64 {
	return cast(i64, b)[2]
}

// Equal reports whether a and b hold the same bytes.
fn Equal(a []u8, b []u8) bool {
	let n = len(a)
	if n != len(b) {
		return false
	}
	return n == 0 || i64(i32(memcmp(data(a), data(b), n))) == 0
}

// Compare returns -1, 0 or 1 by byte-wise order.
fn Compare(a []u8, b []u8) i64 {
	mut n = len(a)
	if len(b) < n {
		n = len(b)
	}
	if n > 0 {
		let c = i64(i32(memcmp(data(a), data(b), n)))
		if c < 0 {
			return -1
		}
		if c > 0 {
			return 1
		}
	}
	if len(a) < len(b) {
		return -1
	}
	if len(a) > len(b) {
		return 1
	}
	return 0
}

// IndexByte returns the index of the first c in b, or -1.
fn IndexByte(b []u8, c u8) i64 {
	let n = len(b)
	if n == 0 {
		return -1
	}
	let p = memchr(data(b), i64(c), n)
	if p == 0 {
		return -1
	}
	return p - data(b)
}

// LastIndexByte returns the index of the last c in b, or -1.
fn LastIndexByte(b []u8, c u8) i64 {
	{
		mut i = len(b) - 1
		for i >= 0 {
			if b[i] == c {
				return i
			}
			i -= 1
		}
	}
	return -1
}

// Index returns the index of the first occurrence of sep in b, or -1.
fn Index(b []u8, sep []u8) i64 {
	let n = len(sep)
	if n == 0 {
		return 0
	}
	if n > len(b) {
		return -1
	}
	let p = data(b)
	let s = data(sep)
	let first = i64(sep[0])
	let last = len(b) - n
	mut i = 0
	for i <= last {
		let q = memchr(p+i, first, last-i+1)
		if q == 0 {
			return -1
		}
		i = q - p
		if i64(i32(memcmp(q, s, n))) == 0 {
			return i
		}
		i += 1
	}
	return -1
}

// Contains reports whether sep occurs in b.
fn Contains(b []u8, sep []u8) bool {
	return Index(b, sep) >= 0
}

// HasPrefix reports whether b starts with p.
fn HasPrefix(b []u8, p []u8) bool {
	return len(b) >= len(p) && Equal(b[:len(p)], p)
}

// HasSuffix reports whether b ends with p.
fn HasSuffix(b []u8, p []u8) bool {
	return len(b) >= len(p) && Equal(b[len(b)-len(p):], p)
}

// Clone returns a fresh copy of b.
fn Clone(b []u8) []u8 {
	let c = make([]u8, len(b))
	copy(c, b)
	return c
}

// AppendStr appends the bytes of s.
fn AppendStr(b mut []u8, s str) []u8 {
	b = append(b, s...)
	return b
}

// AppendByte appends c.
fn AppendByte(b mut []u8, c u8) []u8 {
	b = append(b, c)
	return b
}

// AppendInt appends v in decimal.
fn AppendInt(b mut []u8, v i64) []u8 {
	if v < 0 {
		b = append(b, '-')
		return AppendUint(mut b, u64(0-%v))
	}
	return AppendUint(mut b, u64(v))
}

// AppendUint appends v in decimal.
fn AppendUint(b mut []u8, v u64) []u8 {
	mut n = 1
	{
		mut t = v
		for t >= 10 {
			n += 1
			t /= 10
		}
	}
	let h = cast(i64, b)
	if h[0]+n > h[1] {
		rt_slice_grow(h, h[0]+n, 1)
	}
	let d = h[2] + h[0]
	{
		mut i = n - 1
		for i >= 0 {
			store8(d+i, '0'+i64(v%10))
			v /= 10
			i -= 1
		}
	}
	h[0] += n
	return b
}

// AppendHex appends v in lower-case hexadecimal (no prefix).
fn AppendHex(b mut []u8, v u64) []u8 {
	let digits = "0123456789abcdef"
	mut n = 1
	{
		mut t = v
		for t >= 16 {
			n += 1
			t >>= 4
		}
	}
	{
		mut i = n - 1
		for i >= 0 {
			b = append(b, digits[i64((v>>u64(4*i))&15)])
			i -= 1
		}
	}
	return b
}

// Reset empties b, keeping its capacity.
fn Reset(b mut []u8) {
	cast(i64, b)[0] = 0
}

// Truncate keeps the first n bytes of b.
fn Truncate(b mut []u8, n i64) {
	if n < 0 || n > len(b) {
		rt_panic("ore.Truncate: length out of range")
	}
	cast(i64, b)[0] = n
}

// ToStr returns b's bytes as a str.
fn ToStr(b []u8) str {
	return str(b)
}

fn space(c u8) bool {
	return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == 11 || c == 12
}

// TrimSpace returns b without leading and trailing ASCII white space (a sub-slice).
fn TrimSpace(b []u8) []u8 {
	mut i = 0
	mut j = len(b)
	for i < j && space(b[i]) {
		i += 1
	}
	for j > i && space(b[j-1]) {
		j -= 1
	}
	return b[i:j]
}

// Split cuts b around every sep byte and returns the pieces as strs.
fn Split(b []u8, sep u8) []str {
	mut out = []str{}
	mut start = 0
	for i in 0..len(b) {
		if b[i] == sep {
			out = append(out, str(b[start:i]))
			start = i + 1
		}
	}
	out = append(out, str(b[start:]))
	return out
}

// Fields splits b around runs of ASCII white space.
fn Fields(b []u8) []str {
	mut out = []str{}
	mut i = 0
	for i < len(b) {
		for i < len(b) && space(b[i]) {
			i += 1
		}
		mut j = i
		for j < len(b) && !space(b[j]) {
			j += 1
		}
		if j > i {
			out = append(out, str(b[i:j]))
		}
		i = j
	}
	return out
}

// ToLower returns a copy with ASCII letters lowered.
fn ToLower(b []u8) []u8 {
	let c = make([]u8, len(b))
	for i in 0..len(b) {
		mut x = b[i]
		if x >= 'A' && x <= 'Z' {
			x += 32
		}
		c[i] = x
	}
	return c
}

// ToUpper returns a copy with ASCII letters raised.
fn ToUpper(b []u8) []u8 {
	let c = make([]u8, len(b))
	for i in 0..len(b) {
		mut x = b[i]
		if x >= 'a' && x <= 'z' {
			x -= 32
		}
		c[i] = x
	}
	return c
}

// Repeat returns n copies of b (panics when the length overflows).
fn Repeat(b []u8, n i64) []u8 {
	if n > 0 && len(b) > 9223372036854775807/n {
		panic("ore: Repeat output length overflow")
	}
	mut c = make([]u8, 0, len(b)*n)
	for i in 0..n {
		c = append(c, b...)
	}
	return c
}
