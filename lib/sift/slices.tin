package sift

import "constraints"

// Ordered is the set of built-in types with a total ordering operator.
shape Ordered = i64 | i32 | i16 | i8 | u64 | u32 | u16 | u8 | f64 | f32 | str

// Sort sorts xs in ascending order, in place. Floating-point NaNs sort first. It is not stable,
// and the order of equal elements is the same as Go's slices.Sort.
fn Sort[E Ordered](xs mut []E) {
	let n = len(xs)
	pdqsortOrdered(mut xs, 0, n, bitLen(n))
}

// SortFunc sorts xs in place by cmp, which returns a negative number when a sorts before b, zero
// when they are equal and a positive number after. It is not stable.
fn SortFunc[E constraints.Any](xs mut []E, cmp fn(E, E) i64) {
	let n = len(xs)
	pdqsortCmpFunc(mut xs, 0, n, bitLen(n), cmp)
}

// SortStableFunc is SortFunc, keeping the original order of elements that compare equal.
fn SortStableFunc[E constraints.Any](xs mut []E, cmp fn(E, E) i64) {
	stableCmpFunc(mut xs, len(xs), cmp)
}

// IsSorted reports whether xs is in ascending order.
fn IsSorted[E Ordered](xs []E) bool {
	{
		mut i = len(xs) - 1
		for i > 0 {
			if less(xs[i], xs[i-1]) {
				return false
			}
			i -= 1
		}
	}
	return true
}

// IsSortedFunc reports whether xs is sorted by cmp.
fn IsSortedFunc[E constraints.Any](xs []E, cmp fn(E, E) i64) bool {
	{
		mut i = len(xs) - 1
		for i > 0 {
			if cmp(xs[i], xs[i-1]) < 0 {
				return false
			}
			i -= 1
		}
	}
	return true
}

// Less is cmp.Less: x < y, with NaN smaller than every other value (and so before them in Sort).
fn Less[E Ordered](x E, y E) bool {
	return x < y || (x != x && y == y)
}

// Cmp is cmp.Compare: -1 if x sorts before y, 0 if they are equal, +1 after. NaNs are equal to each
// other and sort before every other value.
fn Cmp[E Ordered](x E, y E) i64 {
	let xNaN = x != x
	let yNaN = y != y
	if xNaN {
		if yNaN {
			return 0
		}
		return -1
	}
	if yNaN {
		return 1
	}
	if x < y {
		return -1
	}
	if x > y {
		return 1
	}
	return 0
}

// BinarySearch searches the sorted xs for target and returns the position where it is, or would
// be inserted, and whether it is there.
fn BinarySearch[E Ordered](xs []E, target E) (i64, bool) {
	let n = len(xs)
	// Invariant: xs[i-1] < target, xs[j] >= target.
	mut i = 0
	mut j = n
	for i < j {
		let h = (i + j) >> 1
		if less(xs[h], target) {
			i = h + 1
		} else {
			j = h
		}
	}
	return i, i < n && (xs[i] == target || (xs[i] != xs[i] && target != target))
}

// BinarySearchFunc is BinarySearch for a target of another type, ordered by cmp(element, target).
fn BinarySearchFunc[E constraints.Any, T constraints.Any](xs []E, target T, cmp fn(E, T) i64) (i64, bool) {
	let n = len(xs)
	mut i = 0
	mut j = n
	for i < j {
		let h = (i + j) >> 1
		if cmp(xs[h], target) < 0 {
			i = h + 1
		} else {
			j = h
		}
	}
	return i, i < n && cmp(xs[i], target) == 0
}

// Min returns the smallest element of xs; a NaN anywhere gives NaN. It panics if xs is empty. (-0
// and +0 compare equal here, so a mix of them returns whichever comes first.)
fn Min[E Ordered](xs []E) E {
	if len(xs) < 1 {
		panic("sift.Min: empty slice")
	}
	mut m = xs[0]
	if m != m {
		return m
	}
	for i in 1..len(xs) {
		let v = xs[i]
		if v != v {
			return v
		}
		if v < m {
			m = v
		}
	}
	return m
}

// Max returns the largest element of xs; a NaN anywhere gives NaN. It panics if xs is empty.
fn Max[E Ordered](xs []E) E {
	if len(xs) < 1 {
		panic("sift.Max: empty slice")
	}
	mut m = xs[0]
	if m != m {
		return m
	}
	for i in 1..len(xs) {
		let v = xs[i]
		if v != v {
			return v
		}
		if v > m {
			m = v
		}
	}
	return m
}

// MinFunc returns the first smallest element of xs by cmp. It panics if xs is empty.
fn MinFunc[E constraints.Any](xs []E, cmp fn(E, E) i64) E {
	if len(xs) < 1 {
		panic("sift.MinFunc: empty slice")
	}
	mut m = xs[0]
	for i in 1..len(xs) {
		if cmp(xs[i], m) < 0 {
			m = xs[i]
		}
	}
	return m
}

// MaxFunc returns the first largest element of xs by cmp. It panics if xs is empty.
fn MaxFunc[E constraints.Any](xs []E, cmp fn(E, E) i64) E {
	if len(xs) < 1 {
		panic("sift.MaxFunc: empty slice")
	}
	mut m = xs[0]
	for i in 1..len(xs) {
		if cmp(xs[i], m) > 0 {
			m = xs[i]
		}
	}
	return m
}

// Index returns the position of the first element equal to v, or -1.
fn Index[E constraints.Comparable](xs []E, v E) i64 {
	for i, _ in xs {
		if v == xs[i] {
			return i
		}
	}
	return -1
}

// IndexFunc returns the position of the first element for which f is true, or -1.
fn IndexFunc[E constraints.Any](xs []E, f fn(E) bool) i64 {
	for i, _ in xs {
		if f(xs[i]) {
			return i
		}
	}
	return -1
}

// Contains reports whether v is in xs.
fn Contains[E constraints.Comparable](xs []E, v E) bool {
	return Index(xs, v) >= 0
}

// ContainsFunc reports whether f is true for some element of xs.
fn ContainsFunc[E constraints.Any](xs []E, f fn(E) bool) bool {
	return IndexFunc(xs, f) >= 0
}

// Equal reports whether a and b have the same length and equal elements.
fn Equal[E constraints.Comparable](a []E, b []E) bool {
	if len(a) != len(b) {
		return false
	}
	for i, _ in a {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

// EqualFunc is Equal for two element types, with eq deciding.
fn EqualFunc[A constraints.Any, B constraints.Any](a []A, b []B, eq fn(A, B) bool) bool {
	if len(a) != len(b) {
		return false
	}
	for i, _ in a {
		if !eq(a[i], b[i]) {
			return false
		}
	}
	return true
}

// Compare compares a and b element by element with Cmp, then by length: -1, 0 or +1.
fn Compare[E Ordered](a []E, b []E) i64 {
	for i, _ in a {
		if i >= len(b) {
			return 1
		}
		let c = Cmp(a[i], b[i])
		if c != 0 {
			return c
		}
	}
	if len(a) < len(b) {
		return -1
	}
	return 0
}

// CompareFunc is Compare for two element types, with cmp comparing elements.
fn CompareFunc[A constraints.Any, B constraints.Any](a []A, b []B, cmp fn(A, B) i64) i64 {
	for i, _ in a {
		if i >= len(b) {
			return 1
		}
		let c = cmp(a[i], b[i])
		if c != 0 {
			return c
		}
	}
	if len(a) < len(b) {
		return -1
	}
	return 0
}

// Reverse reverses xs in place.
fn Reverse[E constraints.Any](xs mut []E) {
	mut i = 0
	mut j = len(xs) - 1
	for i < j {
		xs[i], xs[j] = xs[j], xs[i]
		i += 1
		j -= 1
	}
}

// Clone returns a copy of xs that shares nothing with it.
fn Clone[E constraints.Any](xs []E) []E {
	mut out = make([]E, 0, len(xs))
	for _, x in xs {
		out = append(out, x)
	}
	return out
}

// Grow returns a copy of xs with room for n more elements before it has to grow again.
fn Grow[E constraints.Any](xs []E, n i64) []E {
	if n < 0 {
		panic("sift.Grow: n cannot be negative")
	}
	mut out = make([]E, 0, len(xs)+n)
	for _, x in xs {
		out = append(out, x)
	}
	return out
}

// Concat returns a new slice holding a followed by b.
fn Concat[E constraints.Any](a []E, b []E) []E {
	mut out = make([]E, 0, len(a)+len(b))
	for _, x in a {
		out = append(out, x)
	}
	for _, x in b {
		out = append(out, x)
	}
	return out
}

// ConcatAll returns a new slice holding every slice of parts, in order.
fn ConcatAll[E constraints.Any](parts [][]E) []E {
	mut size = 0
	for _, p in parts {
		size += len(p)
	}
	mut out = make([]E, 0, size)
	for _, p in parts {
		for _, x in p {
			out = append(out, x)
		}
	}
	return out
}

// Repeat returns a new slice that repeats xs count times.
fn Repeat[E constraints.Any](xs []E, count i64) []E {
	if count < 0 {
		panic("sift.Repeat: count cannot be negative")
	}
	mut out = make([]E, 0, len(xs)*count)
	for k in 0..count {
		for _, x in xs {
			out = append(out, x)
		}
	}
	return out
}

// Insert inserts v at position i (0 to len(xs)) and returns the longer slice. Like append, it
// grows xs in place, so every other reference to the same slice sees the new length.
fn Insert[E constraints.Any](xs mut []E, i i64, v E) []E {
	let n = len(xs)
	if i < 0 || i > n {
		panic("sift.Insert: index out of range")
	}
	xs = append(xs, v)
	{
		mut k = n
		for k > i {
			xs[k] = xs[k-1]
			k -= 1
		}
	}
	xs[i] = v
	return xs
}

// InsertAll inserts all of vs at position i and returns the longer slice (grown in place, as Insert).
fn InsertAll[E constraints.Any](xs mut []E, i i64, vs []E) []E {
	let n = len(xs)
	if i < 0 || i > n {
		panic("sift.InsertAll: index out of range")
	}
	let m = len(vs)
	if m == 0 {
		return xs
	}
	xs = append(xs, vs...)
	// xs is now xs[:i] + xs[i:n] + vs: rotate the tail so that vs comes before xs[i:n].
	rotateLeft(mut xs, i, n+m, n-i)
	return xs
}

// rotateLeft rotates xs[a:b] left by k places, by three reversals.
fn rotateLeft[E constraints.Any](xs mut []E, a i64, b i64, k i64) {
	reverseSpan(mut xs, a, a+k)
	reverseSpan(mut xs, a+k, b)
	reverseSpan(mut xs, a, b)
}

fn reverseSpan[E constraints.Any](xs mut []E, a i64, b i64) {
	mut i = a
	mut j = b - 1
	for i < j {
		xs[i], xs[j] = xs[j], xs[i]
		i += 1
		j -= 1
	}
}

// Delete removes xs[i:j] and returns the shorter slice; the elements after j move down in place.
fn Delete[E constraints.Any](xs mut []E, i i64, j i64) []E {
	let n = len(xs)
	if i < 0 || j < i || j > n {
		panic("sift.Delete: bounds out of range")
	}
	if i == j {
		return xs
	}
	let d = j - i
	for k in j..n {
		xs[k-d] = xs[k]
	}
	return xs[:n-d]
}

// DeleteFunc removes the elements for which del is true, in place, and returns the shorter slice.
fn DeleteFunc[E constraints.Any](xs mut []E, del fn(E) bool) []E {
	mut i = IndexFunc(xs, del)
	if i == -1 {
		return xs
	}
	for j in i + 1..len(xs) {
		let v = xs[j]
		if !del(v) {
			xs[i] = v
			i += 1
		}
	}
	return xs[:i]
}

// Replace replaces xs[i:j] with vs and returns the resulting slice (grown or shrunk in place).
fn Replace[E constraints.Any](xs mut []E, i i64, j i64, vs []E) []E {
	let n = len(xs)
	if i < 0 || j < i || j > n {
		panic("sift.Replace: bounds out of range")
	}
	mut d = Delete(mut xs, i, j)
	return InsertAll(mut d, i, vs)
}

// Compact removes runs of equal consecutive elements, keeping the first of each run, in place, and
// returns the shorter slice.
fn Compact[E constraints.Comparable](xs mut []E) []E {
	if len(xs) < 2 {
		return xs
	}
	mut k = 1
	for r in 1..len(xs) {
		if xs[r] != xs[k-1] {
			xs[k] = xs[r]
			k += 1
		}
	}
	return xs[:k]
}

// CompactFunc is Compact with eq deciding which neighbours are equal.
fn CompactFunc[E constraints.Any](xs mut []E, eq fn(E, E) bool) []E {
	if len(xs) < 2 {
		return xs
	}
	mut k = 1
	for r in 1..len(xs) {
		if !eq(xs[r], xs[k-1]) {
			xs[k] = xs[r]
			k += 1
		}
	}
	return xs[:k]
}

// Each calls f for every element of xs in ascending index order.
fn Each[E constraints.Any](xs []E, f fn(E)) {
	for i in 0..len(xs) {
		f(xs[i])
	}
}
