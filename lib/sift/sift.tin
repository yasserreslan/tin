// Package sift sorts and searches slices and has the generic functions on them (like Go's sort, slices and cmp). Sort, SortFunc, IsSorted and the rest
// work on any element type; the type-specific functions (Ints, Strs, SortBy ...) are the faster, older forms.
package sift

import "constraints"

// maxInsertion is the largest range sorted by insertion instead of partitioning.
const maxInsertion = 24

// shortestNinther is the smallest range whose pivot is a median of three medians.
const shortestNinther = 50

// maxSwaps is the swap count of a fully decreasing pivot sample.
const maxSwaps = 12

// shortestShifting is the smallest range partialIns is allowed to shift elements in.
const shortestShifting = 50

// maxSteps is how many out-of-order pairs partialIns fixes before giving up.
const maxSteps = 5

const hintUnknown = 0
const hintIncreasing = 1
const hintDecreasing = 2

// data returns the raw word pointer of a slice's elements (only valid when len > 0).
fn data(h i64) i64 {
	return h[2]
}

// bitLen returns the number of bits needed to hold n (0 for 0).
fn bitLen(n i64) i64 {
	mut k = 0
	for n > 0 {
		n >>= 1
		k += 1
	}
	return k
}

// strLess orders two strs bytewise, a shorter prefix first.
fn strLess(a str, b str) bool {
	let la = len(a)
	let lb = len(b)
	mut n = la
	if lb < n {
		n = lb
	}
	if n > 0 {
		let pa = cast(i64, a) + 8
		let pb = cast(i64, b) + 8
		let ca = i64(load8(pa))
		let cb = i64(load8(pb))
		if ca != cb {
			return ca < cb
		}
		let r = (memcmp(pa, pb, n) << 32) >> 32
		if r != 0 {
			return r < 0
		}
	}
	return la < lb
}

// reverseRange reverses the words d[a:b).
fn reverseRange(d i64, a i64, b i64) {
	mut i = a
	mut j = b - 1
	for i < j {
		let t = d[i]
		d[i] = d[j]
		d[j] = t
		i += 1
		j -= 1
	}
}

// breakPatterns swaps three pseudo-random words into the middle of d[a:b) so a bad pivot pattern cannot repeat.
fn breakPatterns(d i64, a i64, b i64) {
	let length = b - a
	if length >= 8 {
		mut random = u64(length)
		let modulus = u64(1) << bitLen(length)
		let idx = a + (length/4)*2 - 1
		for i in 0..3 {
			random ^= random << 13
			random ^= random >> 7
			random ^= random << 17
			mut other = i64(random & (modulus - 1))
			if other >= length {
				other -= length
			}
			let t = d[idx-1+i]
			d[idx-1+i] = d[a+other]
			d[a+other] = t
		}
	}
}

// Ints sorts xs in increasing order with pattern-defeating quicksort (not stable, O(n log n) worst case).
fn Ints(xs mut []i64) {
	let n = len(xs)
	if n < 2 {
		return
	}
	pdqInts(data(cast(i64, xs)), 0, n, bitLen(n))
}

// IntsDesc sorts xs in decreasing order.
fn IntsDesc(xs mut []i64) {
	let n = len(xs)
	if n < 2 {
		return
	}
	let d = data(cast(i64, xs))
	pdqInts(d, 0, n, bitLen(n))
	reverseRange(d, 0, n)
}

// U64s sorts xs in increasing unsigned order.
fn U64s(xs mut []u64) {
	let n = len(xs)
	if n < 2 {
		return
	}
	let d = data(cast(i64, xs))
	let sb = i64(1) << 63
	for i in 0..n {
		d[i] ^= sb
	}
	pdqInts(d, 0, n, bitLen(n))
	for i in 0..n {
		d[i] ^= sb
	}
}

// F64s sorts xs in increasing order with NaNs first, like Go's slices.Sort (-0 sorts before 0).
fn F64s(xs mut []f64) {
	let n = len(xs)
	if n < 2 {
		return
	}
	let d = data(cast(i64, xs))
	mut k = 0
	for i in 0..n {
		let w = d[i]
		if w&0x7fffffffffffffff > 0x7ff0000000000000 {
			d[i] = d[k]
			d[k] = w
			k += 1
		}
	}
	for i in k..n {
		let w = d[i]
		d[i] = w ^ ((w >> 63) & 0x7fffffffffffffff)
	}
	pdqInts(d+k*8, 0, n-k, bitLen(n-k))
	for i in k..n {
		let w = d[i]
		d[i] = w ^ ((w >> 63) & 0x7fffffffffffffff)
	}
}

// Strs sorts xs in increasing bytewise order.
fn Strs(xs mut []str) {
	let n = len(xs)
	if n < 2 {
		return
	}
	pdqStrs(data(cast(i64, xs)), 0, n, bitLen(n))
}

// SortBy sorts xs so that less(xs[i+1], xs[i]) is never true (less must be a strict weak order).
fn SortBy(xs mut []i64, less fn(i64, i64) bool) {
	let n = len(xs)
	if n < 2 {
		return
	}
	pdqBy(data(cast(i64, xs)), 0, n, bitLen(n), less)
}

// HeapInts sorts xs in increasing order with heapsort (slower than Ints, no recursion, no extra memory).
fn HeapInts(xs mut []i64) {
	let n = len(xs)
	if n < 2 {
		return
	}
	heapInts(data(cast(i64, xs)), 0, n)
}

// StableInts sorts xs in increasing order with a merge sort that keeps equal elements in their original order.
fn StableInts(xs mut []i64) {
	let n = len(xs)
	if n < 2 {
		return
	}
	let d = data(cast(i64, xs))
	if n <= maxInsertion {
		insInts(d, 0, n)
		return
	}
	let tmp = make([]i64, n)
	let t = data(cast(i64, tmp))
	memcpy(t, d, n*8)
	msortInts(t, d, 0, n)
}

// msortInts sorts the words s[a:b) into d[a:b) using s as scratch (both hold the same words on entry).
fn msortInts(s i64, d i64, a i64, b i64) {
	if b-a <= maxInsertion {
		insInts(d, a, b)
		return
	}
	let mid = a + (b-a)/2
	msortInts(d, s, a, mid)
	msortInts(d, s, mid, b)
	if s[mid-1] <= s[mid] {
		memcpy(d+a*8, s+a*8, (b-a)*8)
		return
	}
	mut i = a
	mut j = mid
	mut k = a
	for i < mid && j < b {
		if s[j] < s[i] {
			d[k] = s[j]
			j += 1
		} else {
			d[k] = s[i]
			i += 1
		}
		k += 1
	}
	for i < mid {
		d[k] = s[i]
		i += 1
		k += 1
	}
	for j < b {
		d[k] = s[j]
		j += 1
		k += 1
	}
}

// IsSortedInts reports whether xs is in increasing order.
fn IsSortedInts(xs []i64) bool {
	{
		mut i = len(xs) - 1
		for i > 0 {
			if xs[i] < xs[i-1] {
				return false
			}
			i -= 1
		}
	}
	return true
}

// IsSortedStrs reports whether xs is in increasing bytewise order.
fn IsSortedStrs(xs []str) bool {
	{
		mut i = len(xs) - 1
		for i > 0 {
			if strLess(xs[i], xs[i-1]) {
				return false
			}
			i -= 1
		}
	}
	return true
}

// SearchInts returns the first index of sorted xs holding a value >= x (len(xs) when there is none).
fn SearchInts(xs []i64, x i64) i64 {
	mut lo = 0
	mut hi = len(xs)
	if hi == 0 {
		return 0
	}
	let d = data(cast(i64, xs))
	for lo < hi {
		let m = lo + (hi-lo)/2
		if d[m] < x {
			lo = m + 1
		} else {
			hi = m
		}
	}
	return lo
}

// SearchStrs returns the first index of sorted xs holding a str >= x bytewise (len(xs) when there is none).
fn SearchStrs(xs []str, x str) i64 {
	mut lo = 0
	mut hi = len(xs)
	if hi == 0 {
		return 0
	}
	let d = data(cast(i64, xs))
	for lo < hi {
		let m = lo + (hi-lo)/2
		if strLess(cast(str, d[m]), x) {
			lo = m + 1
		} else {
			hi = m
		}
	}
	return lo
}

// ReverseInts reverses xs in place.
fn ReverseInts(xs mut []i64) {
	let n = len(xs)
	if n < 2 {
		return
	}
	reverseRange(data(cast(i64, xs)), 0, n)
}

// ReverseStrs reverses xs in place.
fn ReverseStrs(xs mut []str) {
	let n = len(xs)
	if n < 2 {
		return
	}
	reverseRange(data(cast(i64, xs)), 0, n)
}

// UniqInts compacts runs of equal values in sorted xs to one element and returns the new length (xs[0:k] is the result).
fn UniqInts(xs mut []i64) i64 {
	let n = len(xs)
	if n < 2 {
		return n
	}
	let d = data(cast(i64, xs))
	mut k = 1
	for i in 1..n {
		if d[i] != d[k-1] {
			d[k] = d[i]
			k += 1
		}
	}
	return k
}

// MinInts returns the smallest element of xs, or a fault when xs is empty.
fn MinInts(xs []i64) !i64 {
	let n = len(xs)
	if n == 0 {
		fail "sift: MinInts of empty slice"
	}
	let d = data(cast(i64, xs))
	mut m = d[0]
	for i in 1..n {
		if d[i] < m {
			m = d[i]
		}
	}
	return m
}

// MaxInts returns the largest element of xs, or a fault when xs is empty.
fn MaxInts(xs []i64) !i64 {
	let n = len(xs)
	if n == 0 {
		fail "sift: MaxInts of empty slice"
	}
	let d = data(cast(i64, xs))
	mut m = d[0]
	for i in 1..n {
		if d[i] > m {
			m = d[i]
		}
	}
	return m
}

// SumInts returns the sum of xs (0 for an empty slice); it panics when the sum overflows i64.
fn SumInts(xs []i64) i64 {
	mut s = i64(0)
	for _, v in xs {
		s += v
	}
	return s
}

// IndexInts returns the index of the first x in xs, or -1.
fn IndexInts(xs []i64, x i64) i64 {
	for i, v in xs {
		if v == x {
			return i
		}
	}
	return -1
}

// ContainsStr reports whether x occurs in xs.
fn ContainsStr(xs []str, x str) bool {
	for _, v in xs {
		if v == x {
			return true
		}
	}
	return false
}

// EqualInts reports whether a and b have the same length and elements.
fn EqualInts(a []i64, b []i64) bool {
	let n = len(a)
	if n != len(b) {
		return false
	}
	if n == 0 {
		return true
	}
	return memcmp(data(cast(i64, a)), data(cast(i64, b)), n*8)&0xffffffff == 0
}

// insInts sorts d[a:b) by insertion.
fn insInts(d i64, a i64, b i64) {
	for i in a + 1..b {
		let v = d[i]
		mut j = i
		for j > a && v < d[j-1] {
			d[j] = d[j-1]
			j -= 1
		}
		d[j] = v
	}
}

// siftDownInts restores the max-heap property below root in the heap d[first:first+hi).
fn siftDownInts(d i64, lo i64, hi i64, first i64) {
	mut root = lo
	for {
		mut child = 2*root + 1
		if child >= hi {
			return
		}
		if child+1 < hi && d[first+child] < d[first+child+1] {
			child += 1
		}
		if !(d[first+root] < d[first+child]) {
			return
		}
		let t = d[first+root]
		d[first+root] = d[first+child]
		d[first+child] = t
		root = child
	}
}

// heapInts sorts d[a:b) with heapsort.
fn heapInts(d i64, a i64, b i64) {
	let first = a
	let hi = b - a
	{
		mut i = (hi - 1) / 2
		for i >= 0 {
			siftDownInts(d, i, hi, first)
			i -= 1
		}
	}
	{
		mut i = hi - 1
		for i >= 0 {
			let t = d[first]
			d[first] = d[first+i]
			d[first+i] = t
			siftDownInts(d, 0, i, first)
			i -= 1
		}
	}
}

// med3Ints returns the index of the median of d[a], d[b], d[c] and how many of the three orderings were reversed.
fn med3Ints(d i64, a i64, b i64, c i64) (i64, i64) {
	mut s = 0
	if d[b] < d[a] {
		let t = a
		a = b
		b = t
		s += 1
	}
	if d[c] < d[b] {
		let t = b
		b = c
		c = t
		s += 1
	}
	if d[b] < d[a] {
		let t = a
		a = b
		b = t
		s += 1
	}
	return b, s
}

// pivotInts picks a pivot index in d[a:b) (median of three, ninther from 50 elements) and a sortedness hint.
fn pivotInts(d i64, a i64, b i64) (i64, i64) {
	let l = b - a
	mut swaps = 0
	mut s = 0
	let i = a + l/4*1
	let j = a + l/4*2
	let k = a + l/4*3
	if l >= 8 {
		if l >= shortestNinther {
			i, s = med3Ints(d, i-1, i, i+1)
			swaps += s
			j, s = med3Ints(d, j-1, j, j+1)
			swaps += s
			k, s = med3Ints(d, k-1, k, k+1)
			swaps += s
		}
		j, s = med3Ints(d, i, j, k)
		swaps += s
	}
	if swaps == 0 {
		return j, hintIncreasing
	}
	if swaps == maxSwaps {
		return j, hintDecreasing
	}
	return j, hintUnknown
}

// partInts partitions d[a:b) around d[pivot], returning the pivot's final index and whether nothing had to move.
fn partInts(d i64, a i64, b i64, pivot i64) (i64, bool) {
	mut t = d[a]
	d[a] = d[pivot]
	d[pivot] = t
	let p = d[a]
	mut i = a + 1
	mut j = b - 1
	for i <= j && d[i] < p {
		i += 1
	}
	for i <= j && !(d[j] < p) {
		j -= 1
	}
	if i > j {
		d[a] = d[j]
		d[j] = p
		return j, true
	}
	t = d[i]
	d[i] = d[j]
	d[j] = t
	i += 1
	j -= 1
	for {
		for i <= j && d[i] < p {
			i += 1
		}
		for i <= j && !(d[j] < p) {
			j -= 1
		}
		if i > j {
			break
		}
		t = d[i]
		d[i] = d[j]
		d[j] = t
		i += 1
		j -= 1
	}
	d[a] = d[j]
	d[j] = p
	return j, false
}

// partEqInts moves the elements equal to d[pivot] to the front of d[a:b) and returns the index after them.
fn partEqInts(d i64, a i64, b i64, pivot i64) i64 {
	mut t = d[a]
	d[a] = d[pivot]
	d[pivot] = t
	let p = d[a]
	mut i = a + 1
	mut j = b - 1
	for {
		for i <= j && !(p < d[i]) {
			i += 1
		}
		for i <= j && p < d[j] {
			j -= 1
		}
		if i > j {
			break
		}
		t = d[i]
		d[i] = d[j]
		d[j] = t
		i += 1
		j -= 1
	}
	return i
}

// partialInsInts finishes a nearly sorted d[a:b) with at most five adjacent fixes, reporting whether it is sorted now.
fn partialInsInts(d i64, a i64, b i64) bool {
	mut i = a + 1
	for step in 0..maxSteps {
		for i < b && !(d[i] < d[i-1]) {
			i += 1
		}
		if i == b {
			return true
		}
		if b-a < shortestShifting {
			return false
		}
		mut t = d[i]
		d[i] = d[i-1]
		d[i-1] = t
		if i-a >= 2 {
			{
				mut j = i - 1
				for j > a {
					if !(d[j] < d[j-1]) {
						break
					}
					t = d[j]
					d[j] = d[j-1]
					d[j-1] = t
					j -= 1
				}
			}
		}
		if b-i >= 2 {
			for j in i + 1..b {
				if !(d[j] < d[j-1]) {
					break
				}
				t = d[j]
				d[j] = d[j-1]
				d[j-1] = t
			}
		}
	}
	return false
}

// pdqInts sorts d[a:b) with pattern-defeating quicksort, falling back to heapsort after limit bad partitions.
fn pdqInts(d i64, a i64, b i64, limit_ i64) {
	mut wasBalanced = true
	mut wasPartitioned = true
	for {
		let length = b - a
		if length <= maxInsertion {
			insInts(d, a, b)
			return
		}
		if limit_ == 0 {
			heapInts(d, a, b)
			return
		}
		if !wasBalanced {
			breakPatterns(d, a, b)
			limit_ -= 1
		}
		mut (pivot, hint) = pivotInts(d, a, b)
		if hint == hintDecreasing {
			reverseRange(d, a, b)
			pivot = (b - 1) - (pivot - a)
			hint = hintIncreasing
		}
		if wasBalanced && wasPartitioned && hint == hintIncreasing {
			if partialInsInts(d, a, b) {
				return
			}
		}
		if a > 0 && !(d[a-1] < d[pivot]) {
			a = partEqInts(d, a, b, pivot)
			continue
		}
		let (mid, already) = partInts(d, a, b, pivot)
		wasPartitioned = already
		let leftLen = mid - a
		let rightLen = b - mid
		let balanceThreshold = length / 8
		if leftLen < rightLen {
			wasBalanced = leftLen >= balanceThreshold
			pdqInts(d, a, mid, limit_)
			a = mid + 1
		} else {
			wasBalanced = rightLen >= balanceThreshold
			pdqInts(d, mid+1, b, limit_)
			b = mid
		}
	}
}

// insStrs sorts d[a:b) by insertion.
fn insStrs(d i64, a i64, b i64) {
	for i in a + 1..b {
		let v = d[i]
		mut j = i
		for j > a && strLess(cast(str, v), cast(str, d[j-1])) {
			d[j] = d[j-1]
			j -= 1
		}
		d[j] = v
	}
}

// siftDownStrs restores the max-heap property below root in the heap d[first:first+hi).
fn siftDownStrs(d i64, lo i64, hi i64, first i64) {
	mut root = lo
	for {
		mut child = 2*root + 1
		if child >= hi {
			return
		}
		if child+1 < hi && strLess(cast(str, d[first+child]), cast(str, d[first+child+1])) {
			child += 1
		}
		if !strLess(cast(str, d[first+root]), cast(str, d[first+child])) {
			return
		}
		let t = d[first+root]
		d[first+root] = d[first+child]
		d[first+child] = t
		root = child
	}
}

// heapStrs sorts d[a:b) with heapsort.
fn heapStrs(d i64, a i64, b i64) {
	let first = a
	let hi = b - a
	{
		mut i = (hi - 1) / 2
		for i >= 0 {
			siftDownStrs(d, i, hi, first)
			i -= 1
		}
	}
	{
		mut i = hi - 1
		for i >= 0 {
			let t = d[first]
			d[first] = d[first+i]
			d[first+i] = t
			siftDownStrs(d, 0, i, first)
			i -= 1
		}
	}
}

// med3Strs returns the index of the median of d[a], d[b], d[c] and how many of the three orderings were reversed.
fn med3Strs(d i64, a i64, b i64, c i64) (i64, i64) {
	mut s = 0
	if strLess(cast(str, d[b]), cast(str, d[a])) {
		let t = a
		a = b
		b = t
		s += 1
	}
	if strLess(cast(str, d[c]), cast(str, d[b])) {
		let t = b
		b = c
		c = t
		s += 1
	}
	if strLess(cast(str, d[b]), cast(str, d[a])) {
		let t = a
		a = b
		b = t
		s += 1
	}
	return b, s
}

// pivotStrs picks a pivot index in d[a:b) (median of three, ninther from 50 elements) and a sortedness hint.
fn pivotStrs(d i64, a i64, b i64) (i64, i64) {
	let l = b - a
	mut swaps = 0
	mut s = 0
	let i = a + l/4*1
	let j = a + l/4*2
	let k = a + l/4*3
	if l >= 8 {
		if l >= shortestNinther {
			i, s = med3Strs(d, i-1, i, i+1)
			swaps += s
			j, s = med3Strs(d, j-1, j, j+1)
			swaps += s
			k, s = med3Strs(d, k-1, k, k+1)
			swaps += s
		}
		j, s = med3Strs(d, i, j, k)
		swaps += s
	}
	if swaps == 0 {
		return j, hintIncreasing
	}
	if swaps == maxSwaps {
		return j, hintDecreasing
	}
	return j, hintUnknown
}

// partStrs partitions d[a:b) around d[pivot], returning the pivot's final index and whether nothing had to move.
fn partStrs(d i64, a i64, b i64, pivot i64) (i64, bool) {
	mut t = d[a]
	d[a] = d[pivot]
	d[pivot] = t
	let p = d[a]
	mut i = a + 1
	mut j = b - 1
	for i <= j && strLess(cast(str, d[i]), cast(str, p)) {
		i += 1
	}
	for i <= j && !strLess(cast(str, d[j]), cast(str, p)) {
		j -= 1
	}
	if i > j {
		d[a] = d[j]
		d[j] = p
		return j, true
	}
	t = d[i]
	d[i] = d[j]
	d[j] = t
	i += 1
	j -= 1
	for {
		for i <= j && strLess(cast(str, d[i]), cast(str, p)) {
			i += 1
		}
		for i <= j && !strLess(cast(str, d[j]), cast(str, p)) {
			j -= 1
		}
		if i > j {
			break
		}
		t = d[i]
		d[i] = d[j]
		d[j] = t
		i += 1
		j -= 1
	}
	d[a] = d[j]
	d[j] = p
	return j, false
}

// partEqStrs moves the elements equal to d[pivot] to the front of d[a:b) and returns the index after them.
fn partEqStrs(d i64, a i64, b i64, pivot i64) i64 {
	mut t = d[a]
	d[a] = d[pivot]
	d[pivot] = t
	let p = d[a]
	mut i = a + 1
	mut j = b - 1
	for {
		for i <= j && !strLess(cast(str, p), cast(str, d[i])) {
			i += 1
		}
		for i <= j && strLess(cast(str, p), cast(str, d[j])) {
			j -= 1
		}
		if i > j {
			break
		}
		t = d[i]
		d[i] = d[j]
		d[j] = t
		i += 1
		j -= 1
	}
	return i
}

// partialInsStrs finishes a nearly sorted d[a:b) with at most five adjacent fixes, reporting whether it is sorted now.
fn partialInsStrs(d i64, a i64, b i64) bool {
	mut i = a + 1
	for step in 0..maxSteps {
		for i < b && !strLess(cast(str, d[i]), cast(str, d[i-1])) {
			i += 1
		}
		if i == b {
			return true
		}
		if b-a < shortestShifting {
			return false
		}
		mut t = d[i]
		d[i] = d[i-1]
		d[i-1] = t
		if i-a >= 2 {
			{
				mut j = i - 1
				for j > a {
					if !strLess(cast(str, d[j]), cast(str, d[j-1])) {
						break
					}
					t = d[j]
					d[j] = d[j-1]
					d[j-1] = t
					j -= 1
				}
			}
		}
		if b-i >= 2 {
			for j in i + 1..b {
				if !strLess(cast(str, d[j]), cast(str, d[j-1])) {
					break
				}
				t = d[j]
				d[j] = d[j-1]
				d[j-1] = t
			}
		}
	}
	return false
}

// pdqStrs sorts d[a:b) with pattern-defeating quicksort, falling back to heapsort after limit bad partitions.
fn pdqStrs(d i64, a i64, b i64, limit_ i64) {
	mut wasBalanced = true
	mut wasPartitioned = true
	for {
		let length = b - a
		if length <= maxInsertion {
			insStrs(d, a, b)
			return
		}
		if limit_ == 0 {
			heapStrs(d, a, b)
			return
		}
		if !wasBalanced {
			breakPatterns(d, a, b)
			limit_ -= 1
		}
		mut (pivot, hint) = pivotStrs(d, a, b)
		if hint == hintDecreasing {
			reverseRange(d, a, b)
			pivot = (b - 1) - (pivot - a)
			hint = hintIncreasing
		}
		if wasBalanced && wasPartitioned && hint == hintIncreasing {
			if partialInsStrs(d, a, b) {
				return
			}
		}
		if a > 0 && !strLess(cast(str, d[a-1]), cast(str, d[pivot])) {
			a = partEqStrs(d, a, b, pivot)
			continue
		}
		let (mid, already) = partStrs(d, a, b, pivot)
		wasPartitioned = already
		let leftLen = mid - a
		let rightLen = b - mid
		let balanceThreshold = length / 8
		if leftLen < rightLen {
			wasBalanced = leftLen >= balanceThreshold
			pdqStrs(d, a, mid, limit_)
			a = mid + 1
		} else {
			wasBalanced = rightLen >= balanceThreshold
			pdqStrs(d, mid+1, b, limit_)
			b = mid
		}
	}
}

// insBy sorts d[a:b) by insertion.
fn insBy(d i64, a i64, b i64, less fn(i64, i64) bool) {
	for i in a + 1..b {
		let v = d[i]
		mut j = i
		for j > a && less(v, d[j-1]) {
			d[j] = d[j-1]
			j -= 1
		}
		d[j] = v
	}
}

// siftDownBy restores the max-heap property below root in the heap d[first:first+hi).
fn siftDownBy(d i64, lo i64, hi i64, first i64, less fn(i64, i64) bool) {
	mut root = lo
	for {
		mut child = 2*root + 1
		if child >= hi {
			return
		}
		if child+1 < hi && less(d[first+child], d[first+child+1]) {
			child += 1
		}
		if !less(d[first+root], d[first+child]) {
			return
		}
		let t = d[first+root]
		d[first+root] = d[first+child]
		d[first+child] = t
		root = child
	}
}

// heapBy sorts d[a:b) with heapsort.
fn heapBy(d i64, a i64, b i64, less fn(i64, i64) bool) {
	let first = a
	let hi = b - a
	{
		mut i = (hi - 1) / 2
		for i >= 0 {
			siftDownBy(d, i, hi, first, less)
			i -= 1
		}
	}
	{
		mut i = hi - 1
		for i >= 0 {
			let t = d[first]
			d[first] = d[first+i]
			d[first+i] = t
			siftDownBy(d, 0, i, first, less)
			i -= 1
		}
	}
}

// med3By returns the index of the median of d[a], d[b], d[c] and how many of the three orderings were reversed.
fn med3By(d i64, a i64, b i64, c i64, less fn(i64, i64) bool) (i64, i64) {
	mut s = 0
	if less(d[b], d[a]) {
		let t = a
		a = b
		b = t
		s += 1
	}
	if less(d[c], d[b]) {
		let t = b
		b = c
		c = t
		s += 1
	}
	if less(d[b], d[a]) {
		let t = a
		a = b
		b = t
		s += 1
	}
	return b, s
}

// pivotBy picks a pivot index in d[a:b) (median of three, ninther from 50 elements) and a sortedness hint.
fn pivotBy(d i64, a i64, b i64, less fn(i64, i64) bool) (i64, i64) {
	let l = b - a
	mut swaps = 0
	mut s = 0
	let i = a + l/4*1
	let j = a + l/4*2
	let k = a + l/4*3
	if l >= 8 {
		if l >= shortestNinther {
			i, s = med3By(d, i-1, i, i+1, less)
			swaps += s
			j, s = med3By(d, j-1, j, j+1, less)
			swaps += s
			k, s = med3By(d, k-1, k, k+1, less)
			swaps += s
		}
		j, s = med3By(d, i, j, k, less)
		swaps += s
	}
	if swaps == 0 {
		return j, hintIncreasing
	}
	if swaps == maxSwaps {
		return j, hintDecreasing
	}
	return j, hintUnknown
}

// partBy partitions d[a:b) around d[pivot], returning the pivot's final index and whether nothing had to move.
fn partBy(d i64, a i64, b i64, pivot i64, less fn(i64, i64) bool) (i64, bool) {
	mut t = d[a]
	d[a] = d[pivot]
	d[pivot] = t
	let p = d[a]
	mut i = a + 1
	mut j = b - 1
	for i <= j && less(d[i], p) {
		i += 1
	}
	for i <= j && !less(d[j], p) {
		j -= 1
	}
	if i > j {
		d[a] = d[j]
		d[j] = p
		return j, true
	}
	t = d[i]
	d[i] = d[j]
	d[j] = t
	i += 1
	j -= 1
	for {
		for i <= j && less(d[i], p) {
			i += 1
		}
		for i <= j && !less(d[j], p) {
			j -= 1
		}
		if i > j {
			break
		}
		t = d[i]
		d[i] = d[j]
		d[j] = t
		i += 1
		j -= 1
	}
	d[a] = d[j]
	d[j] = p
	return j, false
}

// partEqBy moves the elements equal to d[pivot] to the front of d[a:b) and returns the index after them.
fn partEqBy(d i64, a i64, b i64, pivot i64, less fn(i64, i64) bool) i64 {
	mut t = d[a]
	d[a] = d[pivot]
	d[pivot] = t
	let p = d[a]
	mut i = a + 1
	mut j = b - 1
	for {
		for i <= j && !less(p, d[i]) {
			i += 1
		}
		for i <= j && less(p, d[j]) {
			j -= 1
		}
		if i > j {
			break
		}
		t = d[i]
		d[i] = d[j]
		d[j] = t
		i += 1
		j -= 1
	}
	return i
}

// partialInsBy finishes a nearly sorted d[a:b) with at most five adjacent fixes, reporting whether it is sorted now.
fn partialInsBy(d i64, a i64, b i64, less fn(i64, i64) bool) bool {
	mut i = a + 1
	for step in 0..maxSteps {
		for i < b && !less(d[i], d[i-1]) {
			i += 1
		}
		if i == b {
			return true
		}
		if b-a < shortestShifting {
			return false
		}
		mut t = d[i]
		d[i] = d[i-1]
		d[i-1] = t
		if i-a >= 2 {
			{
				mut j = i - 1
				for j > a {
					if !less(d[j], d[j-1]) {
						break
					}
					t = d[j]
					d[j] = d[j-1]
					d[j-1] = t
					j -= 1
				}
			}
		}
		if b-i >= 2 {
			for j in i + 1..b {
				if !less(d[j], d[j-1]) {
					break
				}
				t = d[j]
				d[j] = d[j-1]
				d[j-1] = t
			}
		}
	}
	return false
}

// pdqBy sorts d[a:b) with pattern-defeating quicksort, falling back to heapsort after limit bad partitions.
fn pdqBy(d i64, a i64, b i64, limit_ i64, less fn(i64, i64) bool) {
	mut wasBalanced = true
	mut wasPartitioned = true
	for {
		let length = b - a
		if length <= maxInsertion {
			insBy(d, a, b, less)
			return
		}
		if limit_ == 0 {
			heapBy(d, a, b, less)
			return
		}
		if !wasBalanced {
			breakPatterns(d, a, b)
			limit_ -= 1
		}
		mut (pivot, hint) = pivotBy(d, a, b, less)
		if hint == hintDecreasing {
			reverseRange(d, a, b)
			pivot = (b - 1) - (pivot - a)
			hint = hintIncreasing
		}
		if wasBalanced && wasPartitioned && hint == hintIncreasing {
			if partialInsBy(d, a, b, less) {
				return
			}
		}
		if a > 0 && !less(d[a-1], d[pivot]) {
			a = partEqBy(d, a, b, pivot, less)
			continue
		}
		let (mid, already) = partBy(d, a, b, pivot, less)
		wasPartitioned = already
		let leftLen = mid - a
		let rightLen = b - mid
		let balanceThreshold = length / 8
		if leftLen < rightLen {
			wasBalanced = leftLen >= balanceThreshold
			pdqBy(d, a, mid, limit_, less)
			a = mid + 1
		} else {
			wasBalanced = rightLen >= balanceThreshold
			pdqBy(d, mid+1, b, limit_, less)
			b = mid
		}
	}
}

// ---- generic helpers ----

// Map returns f applied to each element of xs.
fn Map[T constraints.Any, U constraints.Any](xs []T, f fn(T) U) []U {
	mut out = make([]U, 0, len(xs))
	for _, x in xs {
		out = append(out, f(x))
	}
	return out
}

// Filter returns the elements of xs for which keep returns true, in order.
fn Filter[T constraints.Any](xs []T, keep_ fn(T) bool) []T {
	mut out = make([]T, 0, len(xs))
	for _, x in xs {
		if keep_(x) {
			out = append(out, x)
		}
	}
	return out
}

// Reduce folds xs into one value: f(f(f(start, x0), x1), ...).
fn Reduce[T constraints.Any, A constraints.Any](xs []T, start A, f fn(A, T) A) A {
	mut acc = start
	for _, x in xs {
		acc = f(acc, x)
	}
	return acc
}
