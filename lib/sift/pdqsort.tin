package sift

// Sorting any slice, by the pattern-defeating quicksort of Go's slices package (zsortordered.go and
// zsortanyfunc.go), so that Sort and SortFunc produce the same order as Go's for the same input,
// equal elements included. The two variants below are the same code: one compares with `<` (NaNs
// first, as cmp.Less), the other calls cmp. Change them together.

// swapCount counts the swaps order2 makes while a pivot is chosen.
type swapCount struct {
	n i64
}

// less is cmp.Less: x < y, with NaN smaller than everything else.
func less[E i64 | i32 | i16 | i8 | u64 | u32 | u16 | u8 | f64 | f32 | str](x E, y E) bool {
	return x < y || (x != x && y == y)
}

// ---- ordered element types ----

func insertionSortOrdered[E i64 | i32 | i16 | i8 | u64 | u32 | u16 | u8 | f64 | f32 | str](data mut []E, a i64, b i64) {
	for i := a + 1; i < b; i++ {
		for j := i; j > a && less(data[j], data[j-1]); j-- {
			data[j], data[j-1] = data[j-1], data[j]
		}
	}
}

func siftDownOrdered[E i64 | i32 | i16 | i8 | u64 | u32 | u16 | u8 | f64 | f32 | str](data mut []E, lo i64, hi i64, first i64) {
	root := lo
	for {
		child := 2*root + 1
		if child >= hi {
			break
		}
		if child+1 < hi && less(data[first+child], data[first+child+1]) {
			child++
		}
		if !less(data[first+root], data[first+child]) {
			return
		}
		data[first+root], data[first+child] = data[first+child], data[first+root]
		root = child
	}
}

func heapSortOrdered[E i64 | i32 | i16 | i8 | u64 | u32 | u16 | u8 | f64 | f32 | str](data mut []E, a i64, b i64) {
	first := a
	lo := 0
	hi := b - a
	for i := (hi - 1) / 2; i >= 0; i-- {
		siftDownOrdered(mut data, i, hi, first)
	}
	for i := hi - 1; i >= 0; i-- {
		data[first], data[first+i] = data[first+i], data[first]
		siftDownOrdered(mut data, lo, i, first)
	}
}

func pdqsortOrdered[E i64 | i32 | i16 | i8 | u64 | u32 | u16 | u8 | f64 | f32 | str](data mut []E, a i64, b i64, limit i64) {
	const maxInsertion = 12
	wasBalanced := true // whether the last partitioning was reasonably balanced
	wasPartitioned := true // whether the slice was already partitioned
	for {
		length := b - a
		if length <= maxInsertion {
			insertionSortOrdered(mut data, a, b)
			return
		}
		// Fall back to heapsort if too many bad choices were made.
		if limit == 0 {
			heapSortOrdered(mut data, a, b)
			return
		}
		// If the last partitioning was imbalanced, we need to breakPatterns.
		if !wasBalanced {
			breakPatternsOrdered(mut data, a, b)
			limit--
		}
		pivot, hint := choosePivotOrdered(data, a, b)
		if hint == hintDecreasing {
			reverseRangeOrdered(mut data, a, b)
			// The chosen pivot was pivot-a elements after the start of the array.
			// After reversing it is pivot-a elements before the end of the array.
			pivot = (b - 1) - (pivot - a)
			hint = hintIncreasing
		}
		// The slice is likely already sorted.
		if wasBalanced && wasPartitioned && hint == hintIncreasing {
			if partialInsertionSortOrdered(mut data, a, b) {
				return
			}
		}
		// Probably the slice contains many duplicate elements, partition the slice into
		// elements equal to and elements greater than the pivot.
		if a > 0 && !less(data[a-1], data[pivot]) {
			mid := partitionEqualOrdered(mut data, a, b, pivot)
			a = mid
			continue
		}
		mid, alreadyPartitioned := partitionOrdered(mut data, a, b, pivot)
		wasPartitioned = alreadyPartitioned
		leftLen := mid - a
		rightLen := b - mid
		balanceThreshold := length / 8
		if leftLen < rightLen {
			wasBalanced = leftLen >= balanceThreshold
			pdqsortOrdered(mut data, a, mid, limit)
			a = mid + 1
		} else {
			wasBalanced = rightLen >= balanceThreshold
			pdqsortOrdered(mut data, mid+1, b, limit)
			b = mid
		}
	}
}

func partitionOrdered[E i64 | i32 | i16 | i8 | u64 | u32 | u16 | u8 | f64 | f32 | str](data mut []E, a i64, b i64, pivot i64) (i64, bool) {
	data[a], data[pivot] = data[pivot], data[a]
	i := a + 1
	j := b - 1 // i and j are inclusive of the elements remaining to be partitioned
	for i <= j && less(data[i], data[a]) {
		i++
	}
	for i <= j && !less(data[j], data[a]) {
		j--
	}
	if i > j {
		data[j], data[a] = data[a], data[j]
		return j, true
	}
	data[i], data[j] = data[j], data[i]
	i++
	j--
	for {
		for i <= j && less(data[i], data[a]) {
			i++
		}
		for i <= j && !less(data[j], data[a]) {
			j--
		}
		if i > j {
			break
		}
		data[i], data[j] = data[j], data[i]
		i++
		j--
	}
	data[j], data[a] = data[a], data[j]
	return j, false
}

func partitionEqualOrdered[E i64 | i32 | i16 | i8 | u64 | u32 | u16 | u8 | f64 | f32 | str](data mut []E, a i64, b i64, pivot i64) i64 {
	data[a], data[pivot] = data[pivot], data[a]
	i := a + 1
	j := b - 1 // i and j are inclusive of the elements remaining to be partitioned
	for {
		for i <= j && !less(data[a], data[i]) {
			i++
		}
		for i <= j && less(data[a], data[j]) {
			j--
		}
		if i > j {
			break
		}
		data[i], data[j] = data[j], data[i]
		i++
		j--
	}
	return i
}

func partialInsertionSortOrdered[E i64 | i32 | i16 | i8 | u64 | u32 | u16 | u8 | f64 | f32 | str](data mut []E, a i64, b i64) bool {
	const maxSteps = 5 // maximum number of adjacent out-of-order pairs that will get shifted
	const shortestShifting = 50 // don't shift any elements on short arrays
	i := a + 1
	for j := 0; j < maxSteps; j++ {
		for i < b && !less(data[i], data[i-1]) {
			i++
		}
		if i == b {
			return true
		}
		if b-a < shortestShifting {
			return false
		}
		data[i], data[i-1] = data[i-1], data[i]
		// Shift the smaller one to the left.
		if i-a >= 2 {
			for k := i - 1; k >= 1; k-- {
				if !less(data[k], data[k-1]) {
					break
				}
				data[k], data[k-1] = data[k-1], data[k]
			}
		}
		// Shift the greater one to the right.
		if b-i >= 2 {
			for k := i + 1; k < b; k++ {
				if !less(data[k], data[k-1]) {
					break
				}
				data[k], data[k-1] = data[k-1], data[k]
			}
		}
	}
	return false
}

func breakPatternsOrdered[E i64 | i32 | i16 | i8 | u64 | u32 | u16 | u8 | f64 | f32 | str](data mut []E, a i64, b i64) {
	length := b - a
	if length >= 8 {
		random := u64(length) // xorshift, seeded with the length: deterministic
		modulus := u64(1) << u64(bitLen(length))
		for idx := a + (length/4)*2 - 1; idx <= a+(length/4)*2+1; idx++ {
			random ^= random << 13
			random ^= random >> 7
			random ^= random << 17
			other := i64(random & (modulus - 1))
			if other >= length {
				other -= length
			}
			data[idx], data[a+other] = data[a+other], data[idx]
		}
	}
}

// choosePivot chooses a pivot in data[a:b] and reports whether the slice looks sorted, reverse
// sorted or neither (a hint).
func choosePivotOrdered[E i64 | i32 | i16 | i8 | u64 | u32 | u16 | u8 | f64 | f32 | str](data []E, a i64, b i64) (i64, i64) {
	const shortestNinther = 50
	const maxSwaps = 4 * 3
	l := b - a
	swaps := swapCount{}
	i := a + l/4*1
	j := a + l/4*2
	k := a + l/4*3
	if l >= 8 {
		if l >= shortestNinther {
			// Tukey ninther method, the idea came from Rust's implementation.
			i = medianAdjacentOrdered(data, i, mut swaps)
			j = medianAdjacentOrdered(data, j, mut swaps)
			k = medianAdjacentOrdered(data, k, mut swaps)
		}
		// Find the median among i, j, k and stores it into j.
		j = medianOrdered(data, i, j, k, mut swaps)
	}
	if swaps.n == 0 {
		return j, hintIncreasing
	}
	if swaps.n == maxSwaps {
		return j, hintDecreasing
	}
	return j, hintUnknown
}

// order2 returns x,y where data[x] <= data[y], where x,y=a,b or x,y=b,a.
func order2Ordered[E i64 | i32 | i16 | i8 | u64 | u32 | u16 | u8 | f64 | f32 | str](data []E, a i64, b i64, swaps mut swapCount) (i64, i64) {
	if less(data[b], data[a]) {
		swaps.n++
		return b, a
	}
	return a, b
}

// median returns x where data[x] is the median of data[a],data[b],data[c], where x is a, b, or c.
func medianOrdered[E i64 | i32 | i16 | i8 | u64 | u32 | u16 | u8 | f64 | f32 | str](data []E, a i64, b i64, c i64, swaps mut swapCount) i64 {
	a, b = order2Ordered(data, a, b, mut swaps)
	b, c = order2Ordered(data, b, c, mut swaps)
	a, b = order2Ordered(data, a, b, mut swaps)
	return b
}

// medianAdjacent finds the median of data[a - 1], data[a], data[a + 1] and stores the index into a.
func medianAdjacentOrdered[E i64 | i32 | i16 | i8 | u64 | u32 | u16 | u8 | f64 | f32 | str](data []E, a i64, swaps mut swapCount) i64 {
	return medianOrdered(data, a-1, a, a+1, mut swaps)
}

func reverseRangeOrdered[E i64 | i32 | i16 | i8 | u64 | u32 | u16 | u8 | f64 | f32 | str](data mut []E, a i64, b i64) {
	i := a
	j := b - 1
	for i < j {
		data[i], data[j] = data[j], data[i]
		i++
		j--
	}
}

// ---- comparison function ----

func insertionSortCmpFunc[E any](data mut []E, a i64, b i64, cmp func(E, E) i64) {
	for i := a + 1; i < b; i++ {
		for j := i; j > a && (cmp(data[j], data[j-1]) < 0); j-- {
			data[j], data[j-1] = data[j-1], data[j]
		}
	}
}

func siftDownCmpFunc[E any](data mut []E, lo i64, hi i64, first i64, cmp func(E, E) i64) {
	root := lo
	for {
		child := 2*root + 1
		if child >= hi {
			break
		}
		if child+1 < hi && (cmp(data[first+child], data[first+child+1]) < 0) {
			child++
		}
		if !(cmp(data[first+root], data[first+child]) < 0) {
			return
		}
		data[first+root], data[first+child] = data[first+child], data[first+root]
		root = child
	}
}

func heapSortCmpFunc[E any](data mut []E, a i64, b i64, cmp func(E, E) i64) {
	first := a
	lo := 0
	hi := b - a
	for i := (hi - 1) / 2; i >= 0; i-- {
		siftDownCmpFunc(mut data, i, hi, first, cmp)
	}
	for i := hi - 1; i >= 0; i-- {
		data[first], data[first+i] = data[first+i], data[first]
		siftDownCmpFunc(mut data, lo, i, first, cmp)
	}
}

func pdqsortCmpFunc[E any](data mut []E, a i64, b i64, limit i64, cmp func(E, E) i64) {
	const maxInsertion = 12
	wasBalanced := true // whether the last partitioning was reasonably balanced
	wasPartitioned := true // whether the slice was already partitioned
	for {
		length := b - a
		if length <= maxInsertion {
			insertionSortCmpFunc(mut data, a, b, cmp)
			return
		}
		// Fall back to heapsort if too many bad choices were made.
		if limit == 0 {
			heapSortCmpFunc(mut data, a, b, cmp)
			return
		}
		// If the last partitioning was imbalanced, we need to breakPatterns.
		if !wasBalanced {
			breakPatternsCmpFunc(mut data, a, b, cmp)
			limit--
		}
		pivot, hint := choosePivotCmpFunc(data, a, b, cmp)
		if hint == hintDecreasing {
			reverseRangeCmpFunc(mut data, a, b, cmp)
			// The chosen pivot was pivot-a elements after the start of the array.
			// After reversing it is pivot-a elements before the end of the array.
			pivot = (b - 1) - (pivot - a)
			hint = hintIncreasing
		}
		// The slice is likely already sorted.
		if wasBalanced && wasPartitioned && hint == hintIncreasing {
			if partialInsertionSortCmpFunc(mut data, a, b, cmp) {
				return
			}
		}
		// Probably the slice contains many duplicate elements, partition the slice into
		// elements equal to and elements greater than the pivot.
		if a > 0 && !(cmp(data[a-1], data[pivot]) < 0) {
			mid := partitionEqualCmpFunc(mut data, a, b, pivot, cmp)
			a = mid
			continue
		}
		mid, alreadyPartitioned := partitionCmpFunc(mut data, a, b, pivot, cmp)
		wasPartitioned = alreadyPartitioned
		leftLen := mid - a
		rightLen := b - mid
		balanceThreshold := length / 8
		if leftLen < rightLen {
			wasBalanced = leftLen >= balanceThreshold
			pdqsortCmpFunc(mut data, a, mid, limit, cmp)
			a = mid + 1
		} else {
			wasBalanced = rightLen >= balanceThreshold
			pdqsortCmpFunc(mut data, mid+1, b, limit, cmp)
			b = mid
		}
	}
}

func partitionCmpFunc[E any](data mut []E, a i64, b i64, pivot i64, cmp func(E, E) i64) (i64, bool) {
	data[a], data[pivot] = data[pivot], data[a]
	i := a + 1
	j := b - 1 // i and j are inclusive of the elements remaining to be partitioned
	for i <= j && (cmp(data[i], data[a]) < 0) {
		i++
	}
	for i <= j && !(cmp(data[j], data[a]) < 0) {
		j--
	}
	if i > j {
		data[j], data[a] = data[a], data[j]
		return j, true
	}
	data[i], data[j] = data[j], data[i]
	i++
	j--
	for {
		for i <= j && (cmp(data[i], data[a]) < 0) {
			i++
		}
		for i <= j && !(cmp(data[j], data[a]) < 0) {
			j--
		}
		if i > j {
			break
		}
		data[i], data[j] = data[j], data[i]
		i++
		j--
	}
	data[j], data[a] = data[a], data[j]
	return j, false
}

func partitionEqualCmpFunc[E any](data mut []E, a i64, b i64, pivot i64, cmp func(E, E) i64) i64 {
	data[a], data[pivot] = data[pivot], data[a]
	i := a + 1
	j := b - 1 // i and j are inclusive of the elements remaining to be partitioned
	for {
		for i <= j && !(cmp(data[a], data[i]) < 0) {
			i++
		}
		for i <= j && (cmp(data[a], data[j]) < 0) {
			j--
		}
		if i > j {
			break
		}
		data[i], data[j] = data[j], data[i]
		i++
		j--
	}
	return i
}

func partialInsertionSortCmpFunc[E any](data mut []E, a i64, b i64, cmp func(E, E) i64) bool {
	const maxSteps = 5 // maximum number of adjacent out-of-order pairs that will get shifted
	const shortestShifting = 50 // don't shift any elements on short arrays
	i := a + 1
	for j := 0; j < maxSteps; j++ {
		for i < b && !(cmp(data[i], data[i-1]) < 0) {
			i++
		}
		if i == b {
			return true
		}
		if b-a < shortestShifting {
			return false
		}
		data[i], data[i-1] = data[i-1], data[i]
		// Shift the smaller one to the left.
		if i-a >= 2 {
			for k := i - 1; k >= 1; k-- {
				if !(cmp(data[k], data[k-1]) < 0) {
					break
				}
				data[k], data[k-1] = data[k-1], data[k]
			}
		}
		// Shift the greater one to the right.
		if b-i >= 2 {
			for k := i + 1; k < b; k++ {
				if !(cmp(data[k], data[k-1]) < 0) {
					break
				}
				data[k], data[k-1] = data[k-1], data[k]
			}
		}
	}
	return false
}

func breakPatternsCmpFunc[E any](data mut []E, a i64, b i64, cmp func(E, E) i64) {
	length := b - a
	if length >= 8 {
		random := u64(length) // xorshift, seeded with the length: deterministic
		modulus := u64(1) << u64(bitLen(length))
		for idx := a + (length/4)*2 - 1; idx <= a+(length/4)*2+1; idx++ {
			random ^= random << 13
			random ^= random >> 7
			random ^= random << 17
			other := i64(random & (modulus - 1))
			if other >= length {
				other -= length
			}
			data[idx], data[a+other] = data[a+other], data[idx]
		}
	}
}

// choosePivot chooses a pivot in data[a:b] and reports whether the slice looks sorted, reverse
// sorted or neither (a hint).
func choosePivotCmpFunc[E any](data []E, a i64, b i64, cmp func(E, E) i64) (i64, i64) {
	const shortestNinther = 50
	const maxSwaps = 4 * 3
	l := b - a
	swaps := swapCount{}
	i := a + l/4*1
	j := a + l/4*2
	k := a + l/4*3
	if l >= 8 {
		if l >= shortestNinther {
			// Tukey ninther method, the idea came from Rust's implementation.
			i = medianAdjacentCmpFunc(data, i, mut swaps, cmp)
			j = medianAdjacentCmpFunc(data, j, mut swaps, cmp)
			k = medianAdjacentCmpFunc(data, k, mut swaps, cmp)
		}
		// Find the median among i, j, k and stores it into j.
		j = medianCmpFunc(data, i, j, k, mut swaps, cmp)
	}
	if swaps.n == 0 {
		return j, hintIncreasing
	}
	if swaps.n == maxSwaps {
		return j, hintDecreasing
	}
	return j, hintUnknown
}

// order2 returns x,y where data[x] <= data[y], where x,y=a,b or x,y=b,a.
func order2CmpFunc[E any](data []E, a i64, b i64, swaps mut swapCount, cmp func(E, E) i64) (i64, i64) {
	if (cmp(data[b], data[a]) < 0) {
		swaps.n++
		return b, a
	}
	return a, b
}

// median returns x where data[x] is the median of data[a],data[b],data[c], where x is a, b, or c.
func medianCmpFunc[E any](data []E, a i64, b i64, c i64, swaps mut swapCount, cmp func(E, E) i64) i64 {
	a, b = order2CmpFunc(data, a, b, mut swaps, cmp)
	b, c = order2CmpFunc(data, b, c, mut swaps, cmp)
	a, b = order2CmpFunc(data, a, b, mut swaps, cmp)
	return b
}

// medianAdjacent finds the median of data[a - 1], data[a], data[a + 1] and stores the index into a.
func medianAdjacentCmpFunc[E any](data []E, a i64, swaps mut swapCount, cmp func(E, E) i64) i64 {
	return medianCmpFunc(data, a-1, a, a+1, mut swaps, cmp)
}

func reverseRangeCmpFunc[E any](data mut []E, a i64, b i64, cmp func(E, E) i64) {
	i := a
	j := b - 1
	for i < j {
		data[i], data[j] = data[j], data[i]
		i++
		j--
	}
}

// ---- stable sort (comparison function only) ----

// stableCmpFunc sorts data[0:n] stably: insertion sort on blocks of 20, then merges of
// doubling blocks (SymMerge, which needs no scratch memory).
func stableCmpFunc[E any](data mut []E, n i64, cmp func(E, E) i64) {
	blockSize := 20 // must be > 0
	a := 0
	b := blockSize
	for b <= n {
		insertionSortCmpFunc(mut data, a, b, cmp)
		a = b
		b += blockSize
	}
	insertionSortCmpFunc(mut data, a, n, cmp)
	for blockSize < n {
		a = 0
		b = 2 * blockSize
		for b <= n {
			symMergeCmpFunc(mut data, a, a+blockSize, b, cmp)
			a = b
			b += 2 * blockSize
		}
		m := a + blockSize
		if m < n {
			symMergeCmpFunc(mut data, a, m, n, cmp)
		}
		blockSize *= 2
	}
}

// symMergeCmpFunc merges the sorted runs data[a:m] and data[m:b] in place, stably, using
// rotations (Kim and Kutzner, "Stable Minimum Storage Merging by Symmetric Comparisons").
func symMergeCmpFunc[E any](data mut []E, a i64, m i64, b i64, cmp func(E, E) i64) {
	// Avoid unnecessary recursions of symMerge by direct insertion of data[a] into data[m:b]
	// if data[a:m] only contains one element.
	if m-a == 1 {
		// Use binary search to find the lowest index i such that data[i] >= data[a] for m <= i < b.
		i := m
		j := b
		for i < j {
			h := (i + j) >> 1
			if cmp(data[h], data[a]) < 0 {
				i = h + 1
			} else {
				j = h
			}
		}
		// Swap values until data[a] reaches the position before i.
		for k := a; k < i-1; k++ {
			data[k], data[k+1] = data[k+1], data[k]
		}
		return
	}
	// Avoid unnecessary recursions of symMerge by direct insertion of data[m] into data[a:m]
	// if data[m:b] only contains one element.
	if b-m == 1 {
		// Use binary search to find the lowest index i such that data[i] > data[m] for a <= i < m.
		i := a
		j := m
		for i < j {
			h := (i + j) >> 1
			if !(cmp(data[m], data[h]) < 0) {
				i = h + 1
			} else {
				j = h
			}
		}
		// Swap values until data[m] reaches the position i.
		for k := m; k > i; k-- {
			data[k], data[k-1] = data[k-1], data[k]
		}
		return
	}
	mid := (a + b) >> 1
	n := mid + m
	var start i64
	var r i64
	if m > mid {
		start = n - b
		r = mid
	} else {
		start = a
		r = m
	}
	p := n - 1
	for start < r {
		c := (start + r) >> 1
		if !(cmp(data[p-c], data[c]) < 0) {
			start = c + 1
		} else {
			r = c
		}
	}
	end := n - start
	if start < m && m < end {
		rotateRange(mut data, start, m, end)
	}
	if a < start && start < mid {
		symMergeCmpFunc(mut data, a, start, mid, cmp)
	}
	if mid < end && end < b {
		symMergeCmpFunc(mut data, mid, end, b, cmp)
	}
}

// rotateRange rotates the two consecutive blocks data[a:m] and data[m:b] by swapping.
func rotateRange[E any](data mut []E, a i64, m i64, b i64) {
	i := m - a
	j := b - m
	for i != j {
		if i > j {
			swapRange(mut data, m-i, m, j)
			i -= j
		} else {
			swapRange(mut data, m-i, m+j-i, i)
			j -= i
		}
	}
	// i == j
	swapRange(mut data, m-i, m, i)
}

func swapRange[E any](data mut []E, a i64, b i64, n i64) {
	for i := 0; i < n; i++ {
		data[a+i], data[b+i] = data[b+i], data[a+i]
	}
}
