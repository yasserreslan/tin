// Package policy is the with policies (design_semantics §7.1, design/interface_policy.md): with p { body } calls p.Run(body) inside a boundary of its own, with the block as body. Slots are typed ambient values that Bind binds for a block and the tasks it spawns; Retry, Trace and Cached are the library policies.
package policy

import "constraints"
import "fault"
import "herald"
import "say"
import "tide"

// Policy is what with p { body } needs of p: Run runs body (any number of times) and gives the block's value. Run may only call body, or pass it to a function that only calls it.
shape Policy[T constraints.Any] { Run(body fn() !T) !T }

// ---- slots ----

// Slot is a typed ambient value: with policy.Bind(s, v) { } binds it for the block and the tasks the block spawns.
type Slot[T constraints.Any] struct {
	name str
}

// cell holds a bound value, so a binding stores one word whatever T is.
type cell[T constraints.Any] struct {
	v T
}

// NewSlot makes a slot named name; declare it once, in a package-level let (one per core).
fn NewSlot[T constraints.Any](name str) Slot[T] {
	return Slot[T]{name: name}
}

// Name is the slot's name.
fn (s Slot[T]) Name() str {
	return s.name
}

// Get is the value of the innermost Bind of s around the running code; it fails when s is not bound.
fn (s Slot[T]) Get() !T {
	let n = rt_slot_find(cast(i64, s))
	if n == 0 {
		fail "slot " + s.name + " is not bound"
	}
	let c = cast(cell[T], n[2])
	return c.v
}

// Bound reports whether s is bound around the running code.
fn (s Slot[T]) Bound() bool {
	return rt_slot_find(cast(i64, s)) != 0
}

// BindPolicy binds a slot for its block (Bind).
type BindPolicy[V constraints.Any, T constraints.Any] struct {
	s Slot[V]
	v V
}

// Bind is a policy that binds s to v for its block and the tasks the block spawns: with policy.Bind(requestID, id) { }.
fn Bind[V constraints.Any, T constraints.Any](s Slot[V], v V) BindPolicy[V, T] {
	return BindPolicy[V, T]{s: s, v: v}
}

// Run binds the slot on the with block's boundary, then runs body once.
fn (b BindPolicy[V, T]) Run(body fn() !T) !T {
	rt_slot_bind(cast(i64, b.s), cast(i64, cell[V]{v: b.v}))
	return try body()
}

// ---- retry ----

// RetryPolicy runs its block again while it fails (Retry).
type RetryPolicy[T constraints.Any] struct {
	attempts i64
	wait     i64
}

// Retry is a policy that runs its block up to attempts times while it fails and gives the last fault. A cancellation ends it at once: a cancellation fault from the block is given as it is, and a boundary cancelled (or past its deadline) between attempts gives the cancellation's fault. The block's side effects run again on each attempt.
fn Retry[T constraints.Any](attempts i64) RetryPolicy[T] {
	return RetryPolicy[T]{attempts: attempts, wait: 0}
}

// Backoff is r waiting d before the second attempt, and twice as long before each later one.
fn (r RetryPolicy[T]) Backoff(d i64) RetryPolicy[T] {
	return RetryPolicy[T]{attempts: r.attempts, wait: d}
}

// Run runs body until it succeeds, attempts runs have failed, or the boundary is cancelled.
fn (r RetryPolicy[T]) Run(body fn() !T) !T {
	mut wait = r.wait
	mut n = 1
	for {
		let (v, err) = body()
		if err == nil {
			return v
		}
		if n >= r.attempts || canceled(err) {
			fail err
		}
		if rt_bnd_stopped() {
			fail cast(fault, rt_wait_fault())
		}
		if wait > 0 {
			try tide.Wait(wait)
			wait = wait * 2
		}
		n += 1
	}
}

// canceled reports whether err is a cancellation, which no attempt can get past.
fn canceled(err fault) bool {
	return fault.Is(err, fault.Canceled) || fault.Is(err, fault.DeadlineExceeded) || fault.Is(err, fault.LimitExceeded)
}

// ---- trace ----

mut tracer fn(str, i64, fault) = logSpan

// SetTracer sends this core's trace spans to f(name, duration in ns, fault or nil) instead of the log.
fn SetTracer(f fn(str, i64, fault)) {
	tracer = f
}

// logSpan is the default tracer: one herald line per span.
fn logSpan(name str, ns i64, err fault) {
	if err != nil {
		herald.Log(herald.LInfo, "trace", []str{"name", name, "us", say.Str(ns / 1000), "fault", say.Str(err)})
		return
	}
	herald.Log(herald.LInfo, "trace", []str{"name", name, "us", say.Str(ns / 1000)})
}

// TracePolicy reports each run of its block (Trace).
type TracePolicy[T constraints.Any] struct {
	name str
}

// Trace is a policy that reports its block's name, duration and fault to the core's tracer (a herald line by default).
fn Trace[T constraints.Any](name str) TracePolicy[T] {
	return TracePolicy[T]{name: name}
}

// Run runs body once and reports it.
fn (t TracePolicy[T]) Run(body fn() !T) !T {
	let start = tide.Now()
	let (v, err) = body()
	tracer(t.name, tide.Now()-start, err)
	if err != nil {
		fail err
	}
	return v
}

// ---- cached ----

// entry is a cached value and when it expires (mono ns).
type entry[T constraints.Any] struct {
	v     T
	until i64
}

// Cache is a per-core store for Cached: declare it in a package-level let. Values are kept (copied to the long-lived heap).
type Cache[T constraints.Any] struct {
	m   map[str]entry[T]
	max i64
}

// NewCache makes a cache of at most max entries (at least one); a full cache drops its oldest entry.
fn NewCache[T constraints.Any](max i64) Cache[T] {
	if max < 1 {
		max = 1
	}
	return Cache[T]{m: map[str]entry[T]{}, max: max}
}

// Len is the number of entries, fresh or expired.
fn (c Cache[T]) Len() i64 {
	return len(c.m)
}

// Drop removes key's entry.
fn (c mut Cache[T]) Drop(key str) {
	delete(c.m, key)
}

// CachedPolicy answers its block from a cache (Cached).
type CachedPolicy[T constraints.Any] struct {
	c   Cache[T]
	key str
	ttl i64
}

// Cached is a policy that gives the value cached under key while it is younger than ttl (ns), without running its block; otherwise it runs the block and caches a value it gives. Faults are not cached.
fn Cached[T constraints.Any](c Cache[T], key str, ttl i64) CachedPolicy[T] {
	return CachedPolicy[T]{c: c, key: key, ttl: ttl}
}

// Run gives the cached value, or runs body and caches its value.
fn (p mut CachedPolicy[T]) Run(body fn() !T) !T {
	let (e, ok) = p.c.m[p.key]
	if ok && tide.Now() < e.until {
		return e.v
	}
	let v = try body()
	if !ok && len(p.c.m) >= p.c.max {
		for k, _ in p.c.m {
			delete(p.c.m, k)
			break
		}
	}
	p.c.m[keep(p.key)] = keep(entry[T]{v: v, until: tide.Now() + p.ttl})
	return v
}
