// Package ore works on byte slices ([]u8), like Go's bytes. Functions that append take
// the slice as mut and grow it in place.
package ore

extern func memchr(p i64, c i64, n i64) i64
extern func memcmp(a i64, b i64, n i64) i64

func data(b []u8) i64 {
	return cast(i64, b)[2]
}

// Equal reports whether a and b hold the same bytes.
func Equal(a []u8, b []u8) bool {
	n := len(a)
	if n != len(b) {
		return false
	}
	return n == 0 || i64(i32(memcmp(data(a), data(b), n))) == 0
}

// Compare returns -1, 0 or 1 by byte-wise order.
func Compare(a []u8, b []u8) i64 {
	n := len(a)
	if len(b) < n {
		n = len(b)
	}
	if n > 0 {
		c := i64(i32(memcmp(data(a), data(b), n)))
		if c < 0 {
			return -1
		}
		if c > 0 {
			return 1
		}
	}
	if len(a) < len(b) {
		return -1
	}
	if len(a) > len(b) {
		return 1
	}
	return 0
}

// IndexByte returns the index of the first c in b, or -1.
func IndexByte(b []u8, c u8) i64 {
	n := len(b)
	if n == 0 {
		return -1
	}
	p := memchr(data(b), i64(c), n)
	if p == 0 {
		return -1
	}
	return p - data(b)
}

// LastIndexByte returns the index of the last c in b, or -1.
func LastIndexByte(b []u8, c u8) i64 {
	for i := len(b) - 1; i >= 0; i-- {
		if b[i] == c {
			return i
		}
	}
	return -1
}

// Index returns the index of the first occurrence of sep in b, or -1.
func Index(b []u8, sep []u8) i64 {
	n := len(sep)
	if n == 0 {
		return 0
	}
	if n > len(b) {
		return -1
	}
	p := data(b)
	s := data(sep)
	first := i64(sep[0])
	last := len(b) - n
	i := 0
	for i <= last {
		q := memchr(p+i, first, last-i+1)
		if q == 0 {
			return -1
		}
		i = q - p
		if i64(i32(memcmp(q, s, n))) == 0 {
			return i
		}
		i++
	}
	return -1
}

// Contains reports whether sep occurs in b.
func Contains(b []u8, sep []u8) bool {
	return Index(b, sep) >= 0
}

// HasPrefix reports whether b starts with p.
func HasPrefix(b []u8, p []u8) bool {
	return len(b) >= len(p) && Equal(b[:len(p)], p)
}

// HasSuffix reports whether b ends with p.
func HasSuffix(b []u8, p []u8) bool {
	return len(b) >= len(p) && Equal(b[len(b)-len(p):], p)
}

// Clone returns a fresh copy of b.
func Clone(b []u8) []u8 {
	c := make([]u8, len(b))
	copy(c, b)
	return c
}

// AppendStr appends the bytes of s.
func AppendStr(b mut []u8, s str) []u8 {
	b = append(b, s...)
	return b
}

// AppendByte appends c.
func AppendByte(b mut []u8, c u8) []u8 {
	b = append(b, c)
	return b
}

// AppendInt appends v in decimal.
func AppendInt(b mut []u8, v i64) []u8 {
	if v < 0 {
		b = append(b, '-')
		return AppendUint(mut b, u64(0-v))
	}
	return AppendUint(mut b, u64(v))
}

// AppendUint appends v in decimal.
func AppendUint(b mut []u8, v u64) []u8 {
	n := 1
	for t := v; t >= 10; t /= 10 {
		n++
	}
	h := cast(i64, b)
	if h[0]+n > h[1] {
		rt_slice_grow(h, h[0]+n, 1)
	}
	d := h[2] + h[0]
	for i := n - 1; i >= 0; i-- {
		store8(d+i, '0'+i64(v%10))
		v /= 10
	}
	h[0] += n
	return b
}

// AppendHex appends v in lower-case hexadecimal (no prefix).
func AppendHex(b mut []u8, v u64) []u8 {
	digits := "0123456789abcdef"
	n := 1
	for t := v; t >= 16; t >>= 4 {
		n++
	}
	for i := n - 1; i >= 0; i-- {
		b = append(b, digits[i64((v>>u64(4*i))&15)])
	}
	return b
}

// Reset empties b, keeping its capacity.
func Reset(b mut []u8) {
	cast(i64, b)[0] = 0
}

// Truncate keeps the first n bytes of b.
func Truncate(b mut []u8, n i64) {
	if n < 0 || n > len(b) {
		rt_panic("ore.Truncate: length out of range")
	}
	cast(i64, b)[0] = n
}

// ToStr returns b's bytes as a str.
func ToStr(b []u8) str {
	return str(b)
}

func space(c u8) bool {
	return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == 11 || c == 12
}

// TrimSpace returns b without leading and trailing ASCII white space (a sub-slice).
func TrimSpace(b []u8) []u8 {
	i := 0
	j := len(b)
	for i < j && space(b[i]) {
		i++
	}
	for j > i && space(b[j-1]) {
		j--
	}
	return b[i:j]
}

// Split cuts b around every sep byte and returns the pieces as strs.
func Split(b []u8, sep u8) []str {
	out := []str{}
	start := 0
	for i := 0; i < len(b); i++ {
		if b[i] == sep {
			out = append(out, str(b[start:i]))
			start = i + 1
		}
	}
	out = append(out, str(b[start:]))
	return out
}

// Fields splits b around runs of ASCII white space.
func Fields(b []u8) []str {
	out := []str{}
	i := 0
	for i < len(b) {
		for i < len(b) && space(b[i]) {
			i++
		}
		j := i
		for j < len(b) && !space(b[j]) {
			j++
		}
		if j > i {
			out = append(out, str(b[i:j]))
		}
		i = j
	}
	return out
}

// ToLower returns a copy with ASCII letters lowered.
func ToLower(b []u8) []u8 {
	c := make([]u8, len(b))
	for i := 0; i < len(b); i++ {
		x := b[i]
		if x >= 'A' && x <= 'Z' {
			x += 32
		}
		c[i] = x
	}
	return c
}

// ToUpper returns a copy with ASCII letters raised.
func ToUpper(b []u8) []u8 {
	c := make([]u8, len(b))
	for i := 0; i < len(b); i++ {
		x := b[i]
		if x >= 'a' && x <= 'z' {
			x -= 32
		}
		c[i] = x
	}
	return c
}

// Repeat returns n copies of b.
func Repeat(b []u8, n i64) []u8 {
	c := make([]u8, 0, len(b)*n)
	for i := 0; i < n; i++ {
		c = append(c, b...)
	}
	return c
}
