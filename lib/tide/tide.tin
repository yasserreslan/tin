// Package tide is clocks, durations and civil (calendar) time in UTC, like Go's time package.
package tide

import "say"


// Durations are i64 nanoseconds; these constants are the units, like Go's time.Duration.
const Nanosecond = 1
const Microsecond = 1000
const Millisecond = 1000000
const Second = 1000000000
const Minute = 60000000000
const Hour = 3600000000000

const clockUptimeRaw = 8
const clockRealtime = 0
const eintr = 4

// Weekdays as returned in Civil.Weekday, Sunday first like Go.
const Sunday = 0
const Monday = 1
const Tuesday = 2
const Wednesday = 3
const Thursday = 4
const Friday = 5
const Saturday = 6

// Now returns monotonic nanoseconds since boot (CLOCK_UPTIME_RAW): use it to measure intervals.
fn Now() i64 {
	let tp = rt_tape()
	if tp != 0 {
		return rt_effect_word(tp, "tide.now@1", "", rt_mono_ns()) // recorded for replay (#241)
	}
	return rt_mono_ns()
}

// Wall returns the wall clock as nanoseconds since the Unix epoch, 1970-01-01T00:00:00Z.
fn Wall() i64 {
	let tp = rt_tape()
	if tp != 0 {
		return rt_effect_word(tp, "tide.wall@1", "", rt_wall_ns()) // recorded for replay (#241)
	}
	return rt_wall_ns()
}

// Since returns the nanoseconds elapsed since the Now() reading t.
fn Since(t i64) i64 {
	return Now() - t
}

// Sleep pauses the current core for ns nanoseconds (nothing happens when ns <= 0).
fn Sleep(ns i64) {
	if ns <= 0 {
		return
	}
	rt_task_sleep(ns)
}

// Wait pauses for ns like Sleep, but inside a request with a deadline it fails with
// "deadline exceeded" once the deadline comes first. On a server core, other requests run
// while one waits.
fn Wait(ns i64) ! {
	if ns <= 0 {
		// Inside a task a wait with no timeout would never end: a zero wait only checks
		// whether the boundary was cancelled.
		if rt_bnd_stopped() {
			fail cast(fault, rt_wait_fault())
		}
		return
	}
	if rt_task_sleep(ns) {
		fail cast(fault, rt_wait_fault())
	}
}

// Seconds returns d as floating-point seconds, like Go's Duration.Seconds.
fn Seconds(d i64) f64 {
	return f64(d/Second) + f64(d%Second)/1e9
}

// Minutes returns d as floating-point minutes.
fn Minutes(d i64) f64 {
	return f64(d/Minute) + f64(d%Minute)/60e9
}

// Hours returns d as floating-point hours.
fn Hours(d i64) f64 {
	return f64(d/Hour) + f64(d%Hour)/3600e9
}

// Milliseconds returns d as whole milliseconds, truncated toward zero.
fn Milliseconds(d i64) i64 {
	return d / Millisecond
}

// Microseconds returns d as whole microseconds, truncated toward zero.
fn Microseconds(d i64) i64 {
	return d / Microsecond
}

// putFrac writes the fractional part of v (prec digits, trailing zeros dropped) ending at d+w and returns (new w, v / 10^prec).
fn putFrac(d i64, w i64, v u64, prec i64) (i64, u64) {
	mut print = false
	for i in 0..prec {
		let digit = v % 10
		print = print || digit != 0
		if print {
			w -= 1
			store8(d+w, i64(digit)+'0')
		}
		v /= 10
	}
	if print {
		w -= 1
		store8(d+w, '.')
	}
	return w, v
}

// putInt writes v in decimal ending at d+w and returns the new w.
fn putInt(d i64, w i64, v u64) i64 {
	if v == 0 {
		w -= 1
		store8(d+w, '0')
		return w
	}
	for v > 0 {
		w -= 1
		store8(d+w, i64(v%10)+'0')
		v /= 10
	}
	return w
}

// FormatDuration renders d exactly like Go's Duration.String: "1.5s", "250ms", "1h2m3s", "0s", "-1.5µs".
fn FormatDuration(d i64) str {
	let p = rt_str_new(32)
	let b = p + 8
	mut w = 32
	mut u = u64(d)
	let neg = d < 0
	if neg {
		u = 0 -% u
	}
	if u < Second {
		mut prec = 0
		w -= 1
		store8(b+w, 's')
		w -= 1
		if u == 0 {
			store8(b+w, '0')
		} else {
			if u < Microsecond {
				store8(b+w, 'n')
			} else if u < Millisecond {
				prec = 3
				store8(b+w, 0xb5)
				w -= 1
				store8(b+w, 0xc2)
			} else {
				prec = 6
				store8(b+w, 'm')
			}
			w, u = putFrac(b, w, u, prec)
			w = putInt(b, w, u)
		}
	} else {
		w -= 1
		store8(b+w, 's')
		w, u = putFrac(b, w, u, 9)
		w = putInt(b, w, u%60)
		u /= 60
		if u > 0 {
			w -= 1
			store8(b+w, 'm')
			w = putInt(b, w, u%60)
			u /= 60
			if u > 0 {
				w -= 1
				store8(b+w, 'h')
				w = putInt(b, w, u)
			}
		}
	}
	if neg {
		w -= 1
		store8(b+w, '-')
	}
	let n = 32 - w
	memmove(b, b+w, n)
	store8(b+n, 0)
	p[0] = n
	return cast(str, p)
}

// quote wraps s in double quotes escaping '"', '\' and every non-ASCII or control byte as \xNN, like Go's time.quote.
fn quote(s str) str {
	mut b = make([]u8, 0, len(s)+2)
	b = append(b, '"')
	let hex = "0123456789abcdef"
	for i in 0..len(s) {
		let c = s[i]
		if c >= 0x80 || c < ' ' {
			b = append(b, '\\')
			b = append(b, 'x')
			b = append(b, hex[i64(c)>>4])
			b = append(b, hex[i64(c)&15])
			continue
		}
		if c == '"' || c == '\\' {
			b = append(b, '\\')
		}
		b = append(b, c)
	}
	b = append(b, '"')
	return str(b)
}

// unitAt returns the nanoseconds of the unit s[i:j] ("ns" "us" "µs" "μs" "ms" "s" "m" "h"), or 0 when unknown.
fn unitAt(s str, i i64, j i64) u64 {
	let n = j - i
	if n == 1 {
		let c = s[i]
		if c == 's' {
			return Second
		}
		if c == 'm' {
			return Minute
		}
		if c == 'h' {
			return Hour
		}
		return 0
	}
	if n == 2 && s[j-1] == 's' {
		let c = s[i]
		if c == 'n' {
			return Nanosecond
		}
		if c == 'u' {
			return Microsecond
		}
		if c == 'm' {
			return Millisecond
		}
		return 0
	}
	if n == 3 && s[j-1] == 's' && ((s[i] == 0xc2 && s[i+1] == 0xb5) || (s[i] == 0xce && s[i+1] == 0xbc)) {
		return Microsecond
	}
	return 0
}

// ParseDuration parses "300ms", "-1.5h" or "2h45m" (units ns us µs ms s m h) exactly like Go's time.ParseDuration.
fn ParseDuration(s str) !i64 {
	let n = len(s)
	mut i = 0
	mut neg = false
	if n > 0 && (s[0] == '-' || s[0] == '+') {
		neg = s[0] == '-'
		i = 1
	}
	if n-i == 1 && s[i] == '0' {
		return 0
	}
	if i == n {
		fail say.Fault("time: invalid duration %s", quote(s))
	}
	let top = u64(1) << 63
	mut d = u64(0)
	for i < n {
		mut c = s[i]
		if !(c == '.' || (c >= '0' && c <= '9')) {
			fail say.Fault("time: invalid duration %s", quote(s))
		}
		mut v = u64(0)
		mut start = i
		for i < n && s[i] >= '0' && s[i] <= '9' {
			if v > top/10 {
				fail say.Fault("time: invalid duration %s", quote(s))
			}
			v = v*10 + u64(s[i]-'0')
			if v > top {
				fail say.Fault("time: invalid duration %s", quote(s))
			}
			i += 1
		}
		let pre = i != start
		mut f = u64(0)
		mut scale = 1.0
		mut post = false
		if i < n && s[i] == '.' {
			i += 1
			start = i
			mut overflow = false
			for i < n && s[i] >= '0' && s[i] <= '9' {
				if !overflow {
					if f > (top-1)/10 {
						overflow = true
					} else {
						let y = f*10 + u64(s[i]-'0')
						if y > top {
							overflow = true
						} else {
							f = y
							scale *= 10
						}
					}
				}
				i += 1
			}
			post = i != start
		}
		if !pre && !post {
			fail say.Fault("time: invalid duration %s", quote(s))
		}
		start = i
		for i < n {
			c = s[i]
			if c == '.' || (c >= '0' && c <= '9') {
				break
			}
			i += 1
		}
		if i == start {
			fail say.Fault("time: missing unit in duration %s", quote(s))
		}
		let unit = unitAt(s, start, i)
		if unit == 0 {
			fail say.Fault("time: unknown unit %s in duration %s", quote(s[start:i]), quote(s))
		}
		if v > top/unit {
			fail say.Fault("time: invalid duration %s", quote(s))
		}
		v *= unit
		if f > 0 {
			v += u64(i64(f64(f) * (f64(unit) / scale)))
			if v > top {
				fail say.Fault("time: invalid duration %s", quote(s))
			}
		}
		d += v
		if d > top {
			fail say.Fault("time: invalid duration %s", quote(s))
		}
	}
	if neg {
		return 0 -% i64(d)
	}
	if d > top-1 {
		fail say.Fault("time: invalid duration %s", quote(s))
	}
	return i64(d)
}

// Civil is a broken-down UTC instant: Month 1..12, Day 1..31, Weekday 0 (Sunday)..6, YearDay 1..366.
type Civil struct {
	Year    i64
	Month   i64
	Day     i64
	Hour    i64
	Min     i64
	Sec     i64
	Nano    i64
	Weekday i64
	YearDay i64
}

// floorDiv is a / b rounded toward negative infinity (b > 0).
fn floorDiv(a i64, b i64) i64 {
	mut q = a / b
	if a-q*b < 0 {
		q -= 1
	}
	return q
}

// IsLeap reports whether year is a leap year in the proleptic Gregorian calendar.
fn IsLeap(year i64) bool {
	return year%4 == 0 && (year%100 != 0 || year%400 == 0)
}

// DaysIn returns the number of days in month (1..12) of year, or 0 for a month out of range.
fn DaysIn(year i64, month i64) i64 {
	if month < 1 || month > 12 {
		return 0
	}
	if month == 2 {
		if IsLeap(year) {
			return 29
		}
		return 28
	}
	if month == 4 || month == 6 || month == 9 || month == 11 {
		return 30
	}
	return 31
}

// daysBefore returns the days in the year before month m (1..12) in a common year.
fn daysBefore(m i64) i64 {
	if m <= 1 {
		return 0
	}
	if m == 2 {
		return 31
	}
	if m == 3 {
		return 59
	}
	if m == 4 {
		return 90
	}
	if m == 5 {
		return 120
	}
	if m == 6 {
		return 151
	}
	if m == 7 {
		return 181
	}
	if m == 8 {
		return 212
	}
	if m == 9 {
		return 243
	}
	if m == 10 {
		return 273
	}
	if m == 11 {
		return 304
	}
	return 334
}

// DaysFromCivil returns the days from 1970-01-01 to the date y-m-d (m 1..12; d may be out of range and carries).
fn DaysFromCivil(y i64, m i64, d i64) i64 {
	if m <= 2 {
		y -= 1
	}
	let era = floorDiv(y, 400)
	let yoe = y - era*400
	mut mp = m + 9
	if mp >= 12 {
		mp -= 12
	}
	let doy = (153*mp+2)/5 + d - 1
	let doe = yoe*365 + yoe/4 - yoe/100 + doy
	return era*146097 + doe - 719468
}

// CivilFromDays returns the (year, month, day) that is z days after 1970-01-01.
fn CivilFromDays(z i64) (i64, i64, i64) {
	z += 719468
	let era = floorDiv(z, 146097)
	let doe = z - era*146097
	let yoe = (doe - doe/1460 + doe/36524 - doe/146096) / 365
	mut y = yoe + era*400
	let doy = doe - (365*yoe + yoe/4 - yoe/100)
	let mp = (5*doy + 2) / 153
	let d = doy - (153*mp+2)/5 + 1
	mut m = mp + 3
	if mp >= 10 {
		m = mp - 9
	}
	if m <= 2 {
		y += 1
	}
	return y, m, d
}

// UTCSec breaks Unix seconds into UTC calendar fields (Nano is 0); it covers every i64 second.
fn UTCSec(sec i64) Civil {
	let days = floorDiv(sec, 86400)
	let rem = sec - days*86400
	let (y, m, d) = CivilFromDays(days)
	mut yday = daysBefore(m) + d
	if m > 2 && IsLeap(y) {
		yday += 1
	}
	mut wd = (days + 4) % 7
	if wd < 0 {
		wd += 7
	}
	return Civil{Year: y, Month: m, Day: d, Hour: rem / 3600, Min: (rem % 3600) / 60, Sec: rem % 60, Nano: 0, Weekday: wd, YearDay: yday}
}

// UTC breaks the Unix-nanosecond instant ns into its UTC calendar fields.
fn UTC(ns i64) Civil {
	mut sec = ns / Second
	mut nano = ns - sec*Second
	if nano < 0 {
		nano += Second
		sec -= 1
	}
	let c = UTCSec(sec)
	c.Nano = nano
	return c
}

// Date returns the Unix nanoseconds of the UTC civil time; out-of-range fields carry like Go's time.Date (month 13 is January of the next year), and a time outside the years 1677..2262 that i64 nanoseconds hold panics (integer overflow).
fn Date(year i64, month i64, day i64, hour i64, min i64, sec i64, nano i64) i64 {
	mut m = month - 1
	let q = floorDiv(m, 12)
	year += q
	m -= q * 12
	let days = DaysFromCivil(year, m+1, 1) + day - 1
	mut total = days*86400 + hour*3600 + min*60 + sec
	// Carry whole seconds out of nano, and for a negative time borrow one back, so that every
	// time i64 nanoseconds can hold is computed without an intermediate overflow (#362).
	let carry = floorDiv(nano, Second)
	total += carry
	mut ns = nano - carry*Second
	if total < 0 && ns > 0 {
		total += 1
		ns -= Second
	}
	return total*Second + ns
}

// Unix returns the Unix nanoseconds of c (the inverse of UTC; Weekday and YearDay are ignored, other fields carry).
fn Unix(c Civil) i64 {
	return Date(c.Year, c.Month, c.Day, c.Hour, c.Min, c.Sec, c.Nano)
}

// UnixSec returns the Unix seconds of c, rounded toward negative infinity.
fn UnixSec(c Civil) i64 {
	return floorDiv(Unix(c), Second)
}

// WeekdayName returns the English name of weekday d (0 = Sunday), or "%!Weekday(d)" with d unsigned like Go.
fn WeekdayName(d i64) str {
	if d == 0 {
		return "Sunday"
	}
	if d == 1 {
		return "Monday"
	}
	if d == 2 {
		return "Tuesday"
	}
	if d == 3 {
		return "Wednesday"
	}
	if d == 4 {
		return "Thursday"
	}
	if d == 5 {
		return "Friday"
	}
	if d == 6 {
		return "Saturday"
	}
	return say.Fmt("%%!Weekday(%d)", u64(d))
}

// MonthName returns the English name of month m (1 = January), or "%!Month(m)" with m unsigned like Go.
fn MonthName(m i64) str {
	if m < 1 || m > 12 {
		return say.Fmt("%%!Month(%d)", u64(m))
	}
	let names = "January  February March    April    May      June     July     August   SeptemberOctober  November December "
	let s = names[(m-1)*9 : m*9]
	mut n = 9
	for n > 0 && s[n-1] == ' ' {
		n -= 1
	}
	return s[0:n]
}

// put2 writes v (0..99) as two digits at p.
fn put2(p i64, v i64) {
	store8(p, '0'+v/10)
	store8(p+1, '0'+v%10)
}

// put4 writes v (0..9999) as four digits at p.
fn put4(p i64, v i64) {
	store8(p, '0'+v/1000)
	store8(p+1, '0'+(v/100)%10)
	store8(p+2, '0'+(v/10)%10)
	store8(p+3, '0'+v%10)
}

// putDateTime writes "YYYY-MM-DDTHH:MM:SS" (19 bytes) for c at p.
fn putDateTime(p i64, c Civil) {
	put4(p, c.Year)
	store8(p+4, '-')
	put2(p+5, c.Month)
	store8(p+7, '-')
	put2(p+8, c.Day)
	store8(p+10, 'T')
	put2(p+11, c.Hour)
	store8(p+13, ':')
	put2(p+14, c.Min)
	store8(p+16, ':')
	put2(p+17, c.Sec)
}

// FormatRFC3339 renders the Unix-nanosecond instant ns as "2026-10-01T11:22:05Z" (whole seconds, UTC).
fn FormatRFC3339(ns i64) str {
	let c = UTC(ns)
	let p = rt_str_new(20)
	let b = p + 8
	putDateTime(b, c)
	store8(b+19, 'Z')
	return cast(str, p)
}

// FormatRFC3339Nano is FormatRFC3339 with the fractional seconds, trailing zeros removed: "2026-10-01T11:22:05.5Z".
fn FormatRFC3339Nano(ns i64) str {
	let c = UTC(ns)
	if c.Nano == 0 {
		let p = rt_str_new(20)
		let b = p + 8
		putDateTime(b, c)
		store8(b+19, 'Z')
		return cast(str, p)
	}
	mut digits = 9
	mut frac = c.Nano
	for frac%10 == 0 {
		frac /= 10
		digits -= 1
	}
	let n = 21 + digits
	let p = rt_str_new(n)
	let b = p + 8
	putDateTime(b, c)
	store8(b+19, '.')
	{
		mut i = digits - 1
		for i >= 0 {
			store8(b+20+i, '0'+frac%10)
			frac /= 10
			i -= 1
		}
	}
	store8(b+n-1, 'Z')
	return cast(str, p)
}

// digit2 returns the two-digit number at s[i], or -1 when either byte is not a digit.
fn digit2(s str, i i64) i64 {
	let a = i64(s[i]) - '0'
	let b = i64(s[i+1]) - '0'
	if a < 0 || a > 9 || b < 0 || b > 9 {
		return -1
	}
	return a*10 + b
}

// isDigitAt reports whether s[i] exists and is an ASCII digit.
fn isDigitAt(s str, i i64) bool {
	return i < len(s) && s[i] >= '0' && s[i] <= '9'
}

// ParseRFC3339 parses "2026-10-01T11:22:05Z", optional fraction ".123" and offsets "+02:00", accepting what Go's time.Parse(RFC3339) accepts, into Unix nanoseconds.
fn ParseRFC3339(s str) !i64 {
	let n = len(s)
	if n < 19 || s[4] != '-' || s[7] != '-' || s[10] != 'T' {
		fail say.Fault("tide: cannot parse %s as RFC3339", quote(s))
	}
	let hi = digit2(s, 0)
	let lo = digit2(s, 2)
	let month = digit2(s, 5)
	let day = digit2(s, 8)
	if hi < 0 || lo < 0 || month < 1 || month > 12 || day < 1 {
		fail say.Fault("tide: cannot parse %s as RFC3339", quote(s))
	}
	let year = hi*100 + lo
	if day > DaysIn(year, month) {
		fail say.Fault("tide: day out of range in %s", quote(s))
	}
	mut i = 11
	mut hour = i64(s[i]) - '0'
	if hour < 0 || hour > 9 {
		fail say.Fault("tide: cannot parse %s as RFC3339", quote(s))
	}
	i += 1
	if isDigitAt(s, i) {
		hour = hour*10 + i64(s[i]) - '0'
		i += 1
	}
	if hour > 23 || i+6 > n || s[i] != ':' || s[i+3] != ':' {
		fail say.Fault("tide: cannot parse %s as RFC3339", quote(s))
	}
	let min = digit2(s, i+1)
	let sec = digit2(s, i+4)
	if min < 0 || min > 59 || sec < 0 || sec > 59 {
		fail say.Fault("tide: cannot parse %s as RFC3339", quote(s))
	}
	i += 6
	mut nano = 0
	if i+1 < n && (s[i] == '.' || s[i] == ',') && isDigitAt(s, i+1) {
		i += 1
		mut scale = Second
		for isDigitAt(s, i) {
			if scale > 1 {
				scale /= 10
				nano += (i64(s[i]) - '0') * scale
			}
			i += 1
		}
	}
	mut offset = 0
	if i+1 == n && s[i] == 'Z' {
		i += 1
	} else {
		if i+6 != n || (s[i] != '+' && s[i] != '-') || s[i+3] != ':' {
			fail say.Fault("tide: cannot parse %s as RFC3339", quote(s))
		}
		let zh = digit2(s, i+1)
		let zm = digit2(s, i+4)
		if zh < 0 || zh > 24 || zm < 0 || zm > 60 {
			fail say.Fault("tide: time zone offset out of range in %s", quote(s))
		}
		offset = (zh*60 + zm) * 60
		if s[i] == '-' {
			offset = -offset
		}
		i += 6
	}
	// Unix nanoseconds hold 1677-09-21T00:12:43.145224192Z to 2262-04-11T23:47:16.854775807Z;
	// anything outside would wrap (year 0001 read back as 1754), so it is a fault.
	let secs = (DaysFromCivil(year, month, 1)+day-1)*86400 + hour*3600 + min*60 + sec - offset
	if secs > 9223372036 || secs < -9223372037 || (secs == 9223372036 && nano > 854775807) || (secs == -9223372037 && nano < 145224192) {
		fail say.Fault("tide: %s is outside the range of Unix nanoseconds (1677-09-21 to 2262-04-11)", quote(s))
	}
	return Date(year, month, day, hour, min, sec-offset, nano)
}

// FormatHTTP renders Unix seconds in the HTTP date format "Thu, 01 Oct 2026 11:22:05 GMT".
fn FormatHTTP(unixSec i64) str {
	let c = UTCSec(unixSec)
	let days = "SunMonTueWedThuFriSat"
	let months = "JanFebMarAprMayJunJulAugSepOctNovDec"
	if c.Year < 0 || c.Year > 9999 {
		mut year = say.Fmt("%d", c.Year)
		if c.Year < 0 {
			year = say.Fmt("-%04d", 0-c.Year)
		}
		return say.Fmt("%s, %02d %s %s %02d:%02d:%02d GMT", days[c.Weekday*3:c.Weekday*3+3], c.Day, months[(c.Month-1)*3:c.Month*3], year, c.Hour, c.Min, c.Sec)
	}
	let p = rt_str_new(29)
	let b = p + 8
	memcpy(b, cast(i64, days)+8+c.Weekday*3, 3)
	store8(b+3, ',')
	store8(b+4, ' ')
	put2(b+5, c.Day)
	store8(b+7, ' ')
	memcpy(b+8, cast(i64, months)+8+(c.Month-1)*3, 3)
	store8(b+11, ' ')
	put4(b+12, c.Year)
	store8(b+16, ' ')
	put2(b+17, c.Hour)
	store8(b+19, ':')
	put2(b+20, c.Min)
	store8(b+22, ':')
	put2(b+23, c.Sec)
	memcpy(b+25, cast(i64, " GMT")+8, 4)
	return cast(str, p)
}
