package gauge

// Pow: Go's own algorithm (pow.go). It is not correctly rounded: the error grows with the size of the
// result, to about 140 ulp on the corpus in bench/ref/gauge, the same as Go's.

// isOddInt reports whether x is an odd integer.
func isOddInt(x f64) bool {
	if Abs(x) >= 9007199254740992.0 { // 2**53: every such float is even
		return false
	}
	xi, xf := Modf(x)
	return xf == 0 && i64(xi)&1 == 1
}

// Pow returns x**y, with the special cases of C99 and Go: Pow(x, ±0) = 1, Pow(1, y) = 1, Pow(NaN,
// y) = NaN, Pow(x < 0, non-integer y) = NaN, and the usual infinities and signed zeros. It is
// exact for small integer powers of exactly representable bases and within an ulp or two
// otherwise (it is not correctly rounded).
func Pow(x f64, y f64) f64 {
	if y == 0 || x == 1 {
		return 1
	}
	if y == 1 {
		return x
	}
	if IsNaN(x) || IsNaN(y) {
		return NaN()
	}
	if x == 0 {
		if y < 0 {
			if Signbit(x) && isOddInt(y) {
				return Inf(-1)
			}
			return Inf(1)
		}
		if y > 0 {
			if Signbit(x) && isOddInt(y) {
				return x
			}
			return 0
		}
	} else if IsInf(y, 0) {
		if x == -1 {
			return 1
		}
		if (Abs(x) < 1) == IsInf(y, 1) {
			return 0
		}
		return Inf(1)
	} else if IsInf(x, 0) {
		if IsInf(x, -1) {
			return Pow(1/x, -y) // Pow(-0, -y)
		}
		if y < 0 {
			return 0
		}
		if y > 0 {
			return Inf(1)
		}
	} else if y == 0.5 {
		return Sqrt(x)
	} else if y == -0.5 {
		return 1 / Sqrt(x)
	}
	yi, yf := Modf(Abs(y))
	if yf != 0 && x < 0 {
		return NaN()
	}
	if yi >= 9223372036854775808.0 { // 2**63: yi does not fit an i64
		if x == -1 {
			return 1
		}
		if (Abs(x) < 1) == (y > 0) {
			return 0
		}
		return Inf(1)
	}
	// ans = a1 * 2**ae (= 1 for now).
	a1 := 1.0
	ae := 0
	// ans *= x**yf
	if yf != 0 {
		if yf > 0.5 {
			yf -= 1.0
			yi += 1.0
		}
		a1 = Exp(yf * Log(x))
	}
	// ans *= x**yi, by repeated squaring on the fraction and exponent of x.
	x1, xe := Frexp(x)
	i := i64(yi)
	for i != 0 {
		if xe < -4096 || 4096 < xe {
			// catastrophic: the exponent would overflow or underflow, and so will the answer
			ae += xe
			break
		}
		if i&1 == 1 {
			a1 *= x1
			ae += xe
		}
		x1 *= x1
		xe <<= 1
		if x1 < .5 {
			x1 += x1
			xe--
		}
		i >>= 1
	}
	// ans = a1 * 2**ae; if y < 0 { ans = 1 / ans }, but in the opposite order to avoid overflow.
	if y < 0 {
		a1 = 1 / a1
		ae = -ae
	}
	return Ldexp(a1, ae)
}
