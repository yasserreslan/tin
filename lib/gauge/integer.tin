package gauge

// MinI returns the smaller of a and b.
func MinI(a i64, b i64) i64 {
	if a < b {
		return a
	}
	return b
}

// MaxI returns the larger of a and b.
func MaxI(a i64, b i64) i64 {
	if a > b {
		return a
	}
	return b
}

// AbsI returns |x| (MinI64 wraps to itself).
func AbsI(x i64) i64 {
	if x < 0 {
		return -x
	}
	return x
}

// ClampI returns x limited to [lo, hi].
func ClampI(x i64, lo i64, hi i64) i64 {
	if x < lo {
		return lo
	}
	if x > hi {
		return hi
	}
	return x
}

// shl and shr are the shifts Go defines for every count: a count of 64 or more gives 0, where
// the hardware (and Tin) takes the count modulo 64.
func shl(x u64, n u64) u64 {
	if n >= 64 {
		return 0
	}
	return x << n
}

func shr(x u64, n u64) u64 {
	if n >= 64 {
		return 0
	}
	return x >> n
}

// mul64 returns the 128-bit product of x and y as (high, low) words.
func mul64(x u64, y u64) (u64, u64) {
	x0 := x & 0xffffffff
	x1 := x >> 32
	y0 := y & 0xffffffff
	y1 := y >> 32
	w0 := x0 * y0
	t := x1*y0 + w0>>32
	w1 := t & 0xffffffff
	w2 := t >> 32
	w1 += x0 * y1
	return x1*y1 + w2 + w1>>32, x * y
}

// add64 returns x + y + carry and the carry out (0 or 1).
func add64(x u64, y u64, carry u64) (u64, u64) {
	sum := x + y + carry
	return sum, ((x & y) | ((x | y) & ~sum)) >> 63
}

// Gcd returns the greatest common divisor of |a| and |b| (0 when both are 0).
func Gcd(a i64, b i64) i64 {
	a = AbsI(a)
	b = AbsI(b)
	for b != 0 {
		t := a % b
		a = b
		b = t
	}
	return a
}

// Lcm returns the least common multiple of |a| and |b| (0 when either is 0; wraps on overflow).
func Lcm(a i64, b i64) i64 {
	if a == 0 || b == 0 {
		return 0
	}
	return AbsI(a/Gcd(a, b)*b)
}

// PopCount returns the number of one bits in x.
func PopCount(x u64) i64 {
	x = x - (x>>1)&0x5555555555555555
	x = x&0x3333333333333333 + (x>>2)&0x3333333333333333
	x = (x + x>>4) & 0x0f0f0f0f0f0f0f0f
	return i64(x * 0x0101010101010101 >> 56)
}

// LeadingZeros returns the number of leading zero bits in x (64 for 0).
func LeadingZeros(x u64) i64 {
	if x == 0 {
		return 64
	}
	n := 0
	if x>>32 == 0 {
		n += 32
		x <<= 32
	}
	if x>>48 == 0 {
		n += 16
		x <<= 16
	}
	if x>>56 == 0 {
		n += 8
		x <<= 8
	}
	if x>>60 == 0 {
		n += 4
		x <<= 4
	}
	if x>>62 == 0 {
		n += 2
		x <<= 2
	}
	if x>>63 == 0 {
		n++
	}
	return n
}

// TrailingZeros returns the number of trailing zero bits in x (64 for 0).
func TrailingZeros(x u64) i64 {
	if x == 0 {
		return 64
	}
	n := 0
	if x&0xffffffff == 0 {
		n += 32
		x >>= 32
	}
	if x&0xffff == 0 {
		n += 16
		x >>= 16
	}
	if x&0xff == 0 {
		n += 8
		x >>= 8
	}
	if x&0xf == 0 {
		n += 4
		x >>= 4
	}
	if x&0x3 == 0 {
		n += 2
		x >>= 2
	}
	if x&0x1 == 0 {
		n++
	}
	return n
}
