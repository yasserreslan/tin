package gauge

// pow10tab holds 1e0 .. 1e31; the two coarse tables hold every 32nd power, as in Go's math.Pow10.
var pow10tab = []f64{1e00, 1e01, 1e02, 1e03, 1e04, 1e05, 1e06, 1e07, 1e08, 1e09, 1e10, 1e11, 1e12, 1e13, 1e14, 1e15, 1e16, 1e17, 1e18, 1e19, 1e20, 1e21, 1e22, 1e23, 1e24, 1e25, 1e26, 1e27, 1e28, 1e29, 1e30, 1e31}

var pow10postab32 = []f64{1e00, 1e32, 1e64, 1e96, 1e128, 1e160, 1e192, 1e224, 1e256, 1e288}

var pow10negtab32 = []f64{1e-00, 1e-32, 1e-64, 1e-96, 1e-128, 1e-160, 1e-192, 1e-224, 1e-256, 1e-288, 1e-320}

// F64bits returns the IEEE 754 bit pattern of f.
func F64bits(f f64) u64 {
	return u64(cast(i64, f))
}

// F64frombits returns the f64 with bit pattern b.
func F64frombits(b u64) f64 {
	return cast(f64, i64(b))
}

// Abs returns |x| (NaN stays NaN, -0 becomes +0).
func Abs(x f64) f64 {
	return F64frombits(F64bits(x) & 0x7fffffffffffffff)
}

// Signbit reports whether x is negative or negative zero.
func Signbit(x f64) bool {
	return cast(i64, x) < 0
}

// Copysign returns a value with the magnitude of f and the sign of sign.
func Copysign(f f64, sign f64) f64 {
	return F64frombits(F64bits(f)&0x7fffffffffffffff | F64bits(sign)>>63<<63)
}

// Inf returns +Inf when sign >= 0, else -Inf.
func Inf(sign i64) f64 {
	v := F64frombits(0x7ff0000000000000)
	if sign < 0 {
		return -v
	}
	return v
}

// NaN returns a quiet not-a-number.
func NaN() f64 {
	return F64frombits(0x7ff8000000000001)
}

// IsNaN reports whether f is not-a-number.
func IsNaN(f f64) bool {
	return f != f
}

// IsInf reports whether f is +Inf (sign > 0), -Inf (sign < 0) or either (sign == 0).
func IsInf(f f64, sign i64) bool {
	return sign >= 0 && f > MaxF64 || sign <= 0 && f < -MaxF64
}

// Min returns the smaller of x and y; any NaN gives NaN and -0 is smaller than +0 (like Go).
func Min(x f64, y f64) f64 {
	if IsInf(x, -1) || IsInf(y, -1) {
		return Inf(-1)
	}
	if x != x || y != y {
		return NaN()
	}
	if x == 0 && x == y {
		if Signbit(x) {
			return x
		}
		return y
	}
	if x < y {
		return x
	}
	return y
}

// Max returns the larger of x and y; any NaN gives NaN and +0 is larger than -0 (like Go).
func Max(x f64, y f64) f64 {
	if IsInf(x, 1) || IsInf(y, 1) {
		return Inf(1)
	}
	if x != x || y != y {
		return NaN()
	}
	if x == 0 && x == y {
		if Signbit(x) {
			return y
		}
		return x
	}
	if x > y {
		return x
	}
	return y
}

// Clamp returns x limited to [lo, hi] (NaN passes through).
func Clamp(x f64, lo f64, hi f64) f64 {
	if x < lo {
		return lo
	}
	if x > hi {
		return hi
	}
	return x
}

// Pow10 returns 10**n: +Inf above 308, 0 below -323, exactly as Go's math.Pow10.
func Pow10(n i64) f64 {
	if n >= 0 && n <= 308 {
		return pow10postab32[n/32] * pow10tab[n%32]
	}
	if n >= -323 && n < 0 {
		return pow10negtab32[(-n)/32] / pow10tab[(-n)%32]
	}
	if n > 0 {
		return Inf(1)
	}
	return 0
}
