package gauge

// Hypot, as in Go's hypot.go.

// Hypot returns sqrt(p*p + q*q), overflowing only if the result does.
func Hypot(p f64, q f64) f64 {
	p = Abs(p)
	q = Abs(q)
	if IsInf(p, 1) || IsInf(q, 1) {
		return Inf(1)
	}
	if IsNaN(p) || IsNaN(q) {
		return NaN()
	}
	if p < q {
		t := p
		p = q
		q = t
	}
	if p == 0 {
		return 0
	}
	q = q / p
	return p * Sqrt(1+q*q)
}
