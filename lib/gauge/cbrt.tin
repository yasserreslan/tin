package gauge

// Cube root: FreeBSD's s_cbrt.c, through Go's cbrt.go.

// Cbrt returns the cube root of x. Cbrt(±0) = ±0, Cbrt(±Inf) = ±Inf, Cbrt(NaN) = NaN.
func Cbrt(x f64) f64 {
	const b1 = 715094163 // (682-0.03306235651)*2**20
	const b2 = 696219795 // (664-0.03306235651)*2**20
	const c = 5.42857142857142815906e-01 // 19/35
	const d = -7.05306122448979611050e-01 // -864/1225
	const e = 1.41428571428571436819e+00 // 99/70
	const f = 1.60714285714285720630e+00 // 45/28
	const g = 3.57142857142857150787e-01 // 5/14
	if x == 0 || IsNaN(x) || IsInf(x, 0) {
		return x
	}
	sign := false
	if x < 0 {
		x = -x
		sign = true
	}
	// Rough cbrt to 5 bits.
	t := F64frombits(F64bits(x)/3 + u64(b1)<<32)
	if x < smallestNormal { // subnormal: scale into the normal range first
		t = 18014398509481984.0 // 2**54
		t *= x
		t = F64frombits(F64bits(t)/3 + u64(b2)<<32)
	}
	// New cbrt to 23 bits: cbrt(x) = t*cbrt(x/t**3) ~= t*P(t**3/x).
	r := t * t / x
	s := c + r*t
	t *= g + f/(s+e+d/s)
	// Round t away from zero to 23 bits, so that t*t is exact, then one Newton step.
	t = F64frombits(F64bits(t)&0xFFFFFFFFC0000000 + u64(1)<<30)
	s = t * t // t*t is exact
	r = x / s
	w := t + t
	r = (r - t) / (w + r) // r-s is exact
	t = t + t*r
	if sign {
		t = -t
	}
	return t
}
