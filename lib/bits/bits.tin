// Package bits counts, rotates and reverses the bits of fixed-width unsigned integers, and does 64-bit
// and 32-bit arithmetic with carries (like Go's math/bits). Every name carries its width; PopCount is
// Go's OnesCount; there is no uint-wide form because Tin has no uint.
package bits

// shr is x >> n for any count: a count of 64 or more gives 0, where the hardware (and Tin) takes the
// count modulo 64.
fn shr(x u64, n u64) u64 {
	if n >= 64 {
		return 0
	}
	return x >> n
}

// shl is x << n for any count (see shr).
fn shl(x u64, n u64) u64 {
	if n >= 64 {
		return 0
	}
	return x << n
}

// ---- Len and the zero counts ----

// Len64 returns the minimum number of bits needed to represent x; Len64(0) is 0.
fn Len64(x u64) i64 {
	mut n = 0
	if x >= 1<<32 {
		x >>= 32
		n = 32
	}
	if x >= 1<<16 {
		x >>= 16
		n += 16
	}
	if x >= 1<<8 {
		x >>= 8
		n += 8
	}
	if x >= 1<<4 {
		x >>= 4
		n += 4
	}
	if x >= 1<<2 {
		x >>= 2
		n += 2
	}
	if x >= 1<<1 {
		x >>= 1
		n += 1
	}
	return n + i64(x) // x is now 0 or 1
}

// Len32 is Len64 for a u32.
fn Len32(x u32) i64 {
	return Len64(u64(x))
}

// Len16 is Len64 for a u16.
fn Len16(x u16) i64 {
	return Len64(u64(x))
}

// Len8 is Len64 for a u8.
fn Len8(x u8) i64 {
	return Len64(u64(x))
}

// LeadingZeros64 returns the number of leading zero bits in x; it is 64 for 0.
fn LeadingZeros64(x u64) i64 {
	return 64 - Len64(x)
}

// LeadingZeros32 returns the number of leading zero bits in x; it is 32 for 0.
fn LeadingZeros32(x u32) i64 {
	return 32 - Len64(u64(x))
}

// LeadingZeros16 returns the number of leading zero bits in x; it is 16 for 0.
fn LeadingZeros16(x u16) i64 {
	return 16 - Len64(u64(x))
}

// LeadingZeros8 returns the number of leading zero bits in x; it is 8 for 0.
fn LeadingZeros8(x u8) i64 {
	return 8 - Len64(u64(x))
}

// TrailingZeros64 returns the number of trailing zero bits in x; it is 64 for 0.
fn TrailingZeros64(x u64) i64 {
	if x == 0 {
		return 64
	}
	return Len64(x&(^x+1)) - 1 // x & -x keeps only the lowest set bit
}

// TrailingZeros32 returns the number of trailing zero bits in x; it is 32 for 0.
fn TrailingZeros32(x u32) i64 {
	if x == 0 {
		return 32
	}
	return TrailingZeros64(u64(x))
}

// TrailingZeros16 returns the number of trailing zero bits in x; it is 16 for 0.
fn TrailingZeros16(x u16) i64 {
	if x == 0 {
		return 16
	}
	return TrailingZeros64(u64(x))
}

// TrailingZeros8 returns the number of trailing zero bits in x; it is 8 for 0.
fn TrailingZeros8(x u8) i64 {
	if x == 0 {
		return 8
	}
	return TrailingZeros64(u64(x))
}

// ---- PopCount ----

const m0 = 0x5555555555555555 // 01010101 ...

const m1 = 0x3333333333333333 // 00110011 ...

const m2 = 0x0f0f0f0f0f0f0f0f // 00001111 ...

// PopCount64 returns the number of one bits in x.
fn PopCount64(x u64) i64 {
	x = (x>>1)&m0 + x&m0
	x = (x>>2)&m1 + x&m1
	x = ((x >> 4) + x) & m2
	x += x >> 8
	x += x >> 16
	x += x >> 32
	return i64(x) & (1<<7 - 1)
}

// PopCount32 returns the number of one bits in x.
fn PopCount32(x u32) i64 {
	return PopCount64(u64(x))
}

// PopCount16 returns the number of one bits in x.
fn PopCount16(x u16) i64 {
	return PopCount64(u64(x))
}

// PopCount8 returns the number of one bits in x.
fn PopCount8(x u8) i64 {
	return PopCount64(u64(x))
}

// ---- RotateLeft ----

// RotateLeft64 returns x rotated left by k bits; a negative k rotates right.
fn RotateLeft64(x u64, k i64) u64 {
	let s = u64(k) & 63
	if s == 0 {
		return x
	}
	return x<<s | x>>(64-s)
}

// RotateLeft32 returns x rotated left by k bits; a negative k rotates right.
fn RotateLeft32(x u32, k i64) u32 {
	let s = u64(k) & 31
	return u32(u64(x)<<s | u64(x)>>(32-s))
}

// RotateLeft16 returns x rotated left by k bits; a negative k rotates right.
fn RotateLeft16(x u16, k i64) u16 {
	let s = u64(k) & 15
	return u16(u64(x)<<s | u64(x)>>(16-s))
}

// RotateLeft8 returns x rotated left by k bits; a negative k rotates right.
fn RotateLeft8(x u8, k i64) u8 {
	let s = u64(k) & 7
	return u8(u64(x)<<s | u64(x)>>(8-s))
}

// ---- Reverse ----

const m3 = 0x00ff00ff00ff00ff

const m4 = 0x0000ffff0000ffff

// ReverseBytes64 returns x with its bytes in reversed order.
fn ReverseBytes64(x u64) u64 {
	x = (x>>8)&m3 | (x&m3)<<8
	x = (x>>16)&m4 | (x&m4)<<16
	return x>>32 | x<<32
}

// ReverseBytes32 returns x with its bytes in reversed order.
fn ReverseBytes32(x u32) u32 {
	return u32(ReverseBytes64(u64(x)) >> 32)
}

// ReverseBytes16 returns x with its bytes in reversed order.
fn ReverseBytes16(x u16) u16 {
	return u16(ReverseBytes64(u64(x)) >> 48)
}

// Reverse64 returns x with its bits in reversed order.
fn Reverse64(x u64) u64 {
	x = (x>>1)&m0 | (x&m0)<<1
	x = (x>>2)&m1 | (x&m1)<<2
	x = (x>>4)&m2 | (x&m2)<<4
	return ReverseBytes64(x)
}

// Reverse32 returns x with its bits in reversed order.
fn Reverse32(x u32) u32 {
	return u32(Reverse64(u64(x)) >> 32)
}

// Reverse16 returns x with its bits in reversed order.
fn Reverse16(x u16) u16 {
	return u16(Reverse64(u64(x)) >> 48)
}

// Reverse8 returns x with its bits in reversed order.
fn Reverse8(x u8) u8 {
	return u8(Reverse64(u64(x)) >> 56)
}

// ---- arithmetic with carries ----
// These compute modulo 2^64 or 2^32, returning the carry or borrow separately (@wrap, #362).

// Add64 returns the sum x + y + carry and the carry out. carry must be 0 or 1, otherwise the
// behavior is undefined.
@wrap fn Add64(x u64, y u64, carry u64) (u64, u64) {
	let sum = x + y + carry
	// The carry out is the sum of the carries of the top bits of x, y and the incoming carry.
	return sum, ((x & y) | ((x | y) & ^sum)) >> 63
}

// Add32 returns the sum x + y + carry and the carry out (0 or 1).
fn Add32(x u32, y u32, carry u32) (u32, u32) {
	let sum64 = u64(x) + u64(y) + u64(carry)
	return u32(sum64), u32(sum64 >> 32)
}

// Sub64 returns the difference x - y - borrow and the borrow out. borrow must be 0 or 1,
// otherwise the behavior is undefined.
@wrap fn Sub64(x u64, y u64, borrow u64) (u64, u64) {
	let diff = x - y - borrow
	return diff, ((^x & y) | (^(x ^ y) & diff)) >> 63
}

// Sub32 returns the difference x - y - borrow and the borrow out (0 or 1).
@wrap fn Sub32(x u32, y u32, borrow u32) (u32, u32) {
	let diff = x - y - borrow
	return diff, ((^x & y) | (^(x ^ y) & diff)) >> 31
}

const mask32 = 1<<32 - 1

// Mul64 returns the 128-bit product of x and y as (high word, low word): two instructions,
// umulh and mul on arm64, one mul on x86-64 (#474).
fn Mul64(x u64, y u64) (u64, u64) {
	return u64(__mulhu(i64(x), i64(y))), x *% y
}

// Mul32 returns the 64-bit product of x and y as (high word, low word).
fn Mul32(x u32, y u32) (u32, u32) {
	let tmp = u64(x) * u64(y)
	return u32(tmp >> 32), u32(tmp)
}

const two32 = 1 << 32

const Div64Mask32 = two32 - 1

// Div64 returns the quotient and remainder of (hi, lo) divided by y. It panics for y == 0 (division
// by zero) and for y <= hi (the quotient does not fit in 64 bits).
@wrap fn Div64(hi u64, lo u64, y u64) (u64, u64) {
	if y == 0 {
		panic("integer divide by zero")
	}
	if y <= hi {
		panic("integer overflow")
	}
	if hi == 0 {
		return lo / y, lo % y
	}
	// Knuth's algorithm D on 32-bit digits.
	let s = u64(LeadingZeros64(y))
	y <<= s
	let yn1 = y >> 32
	let yn0 = y & Div64Mask32
	let un32 = shl(hi, s) | shr(lo, 64-s)
	let un10 = shl(lo, s)
	let un1 = un10 >> 32
	let un0 = un10 & Div64Mask32
	mut q1 = un32 / yn1
	mut rhat = un32 - q1*yn1
	for q1 >= two32 || q1*yn0 > two32*rhat+un1 {
		q1 -= 1
		rhat += yn1
		if rhat >= two32 {
			break
		}
	}
	let un21 = un32*two32 + un1 - q1*y
	mut q0 = un21 / yn1
	rhat = un21 - q0*yn1
	for q0 >= two32 || q0*yn0 > two32*rhat+un0 {
		q0 -= 1
		rhat += yn1
		if rhat >= two32 {
			break
		}
	}
	return q1*two32 + q0, shr(un21*two32+un0-q0*y, s)
}

// Div32 returns the quotient and remainder of (hi, lo) divided by y. It panics for y == 0 and for
// y <= hi (the quotient does not fit in 32 bits).
fn Div32(hi u32, lo u32, y u32) (u32, u32) {
	if y != 0 && y <= hi {
		panic("integer overflow")
	}
	let z = u64(hi)<<32 | u64(lo)
	return u32(z / u64(y)), u32(z % u64(y))
}

// Rem64 returns the remainder of (hi, lo) divided by y, for any hi (no overflow panic). It panics
// for y == 0.
fn Rem64(hi u64, lo u64, y u64) u64 {
	let (_, rem) = Div64(hi%y, lo, y)
	return rem
}

// Rem32 returns the remainder of (hi, lo) divided by y. It panics for y == 0.
fn Rem32(hi u32, lo u32, y u32) u32 {
	return u32((u64(hi)<<32 | u64(lo)) % u64(y))
}
