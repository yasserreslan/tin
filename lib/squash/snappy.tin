package squash

import "fault"

// Snappy's block format (github.com/google/snappy, format_description.txt): the uncompressed
// length as a varint, then literals and copies. The encoder works in 64 KiB fragments, as the
// reference does, so every offset fits two bytes.

// Snappy compresses data as one Snappy block.
fn Snappy(data str) str {
	let n = len(data)
	mut out = make([]u8, 0, 32+n+n/6)
	mut v = n
	for v >= 0x80 {
		out = append(out, u8(v|0x80))
		v = v >> 7
	}
	out = append(out, u8(v))
	mut table = make([]i64, 1 << 14)
	mut frag = 0
	for frag < n {
		let end = min(frag+65536, n)
		for i in 0..len(table) {
			table[i] = -1
		}
		mut lit = frag
		mut i = frag
		for i+4 <= end {
			let key = i64(data[i]) | i64(data[i+1])<<8 | i64(data[i+2])<<16 | i64(data[i+3])<<24
			let h = ((key * 0x1e35a7bd) >> 18) & ((1 << 14) - 1)
			let cand = table[h]
			table[h] = i
			if cand < 0 || data[cand] != data[i] || data[cand+1] != data[i+1] || data[cand+2] != data[i+2] || data[cand+3] != data[i+3] {
				i += 1
				continue
			}
			mut l = 4
			for i+l < end && data[cand+l] == data[i+l] {
				l += 1
			}
			snappyLiteral(mut out, data, lit, i)
			snappyCopy(mut out, i-cand, l)
			i += l
			lit = i
		}
		snappyLiteral(mut out, data, lit, end)
		frag = end
	}
	return str(out)
}

fn snappyLiteral(out mut []u8, s str, from i64, to i64) {
	let n = to - from
	if n == 0 {
		return
	}
	let k = n - 1
	if k < 60 {
		out = append(out, u8(k<<2))
	} else if k < 256 {
		out = append(out, u8(60<<2), u8(k))
	} else if k < 65536 {
		out = append(out, u8(61<<2), u8(k), u8(k>>8))
	} else if k < 16777216 {
		out = append(out, u8(62<<2), u8(k), u8(k>>8), u8(k>>16))
	} else {
		out = append(out, u8(63<<2), u8(k), u8(k>>8), u8(k>>16), u8(k>>24))
	}
	out = append(out, s[from:to]...)
}

fn snappyCopy(out mut []u8, off i64, length i64) {
	mut l = length
	// Copies of 64 bytes at a time, leaving at least 4 for the last one.
	for l >= 68 {
		out = append(out, u8(2|(63<<2)), u8(off), u8(off>>8))
		l -= 64
	}
	if l > 64 {
		out = append(out, u8(2|(59<<2)), u8(off), u8(off>>8))
		l -= 60
	}
	if l >= 4 && l < 12 && off < 2048 {
		out = append(out, u8(1|((l-4)<<2)|((off>>8)<<5)), u8(off))
		return
	}
	out = append(out, u8(2|((l-1)<<2)), u8(off), u8(off>>8))
}

// Unsnappy decompresses one Snappy block whose length is at most max.
fn Unsnappy(data str, max i64) !str {
	mut at = 0
	mut n = 0
	mut shift = 0
	for {
		if at >= len(data) || shift > 28 {
			fail "squash: snappy length is damaged"
		}
		let c = i64(data[at])
		at += 1
		n = n | ((c & 0x7f) << shift)
		if c < 0x80 {
			break
		}
		shift += 7
	}
	if n > max {
		fail fault.Wrap(fault.LimitExceeded, "squash: output over {max} bytes")
	}
	mut out = make([]u8, 0, n)
	for at < len(data) {
		let tag = i64(data[at])
		at += 1
		let kind = tag & 3
		if kind == 0 {
			mut l = tag >> 2
			if l >= 60 {
				let k = l - 59
				if at+k > len(data) {
					fail "squash: snappy data ends in a literal's length"
				}
				l = 0
				for j in 0..k {
					l = l | (i64(data[at+j]) << (8*j))
				}
				at += k
			}
			l += 1
			if at+l > len(data) || len(out)+l > n {
				fail "squash: a snappy literal runs past its data"
			}
			out = append(out, data[at:at+l]...)
			at += l
			continue
		}
		mut l = 0
		mut off = 0
		if kind == 1 {
			if at >= len(data) {
				fail "squash: snappy data ends in a copy"
			}
			l = 4 + ((tag >> 2) & 7)
			off = ((tag >> 5) << 8) | i64(data[at])
			at += 1
		} else if kind == 2 {
			if at+2 > len(data) {
				fail "squash: snappy data ends in a copy"
			}
			l = 1 + (tag >> 2)
			off = i64(data[at]) | i64(data[at+1])<<8
			at += 2
		} else {
			if at+4 > len(data) {
				fail "squash: snappy data ends in a copy"
			}
			l = 1 + (tag >> 2)
			off = le32(data, at)
			at += 4
		}
		if off == 0 || off > len(out) || len(out)+l > n {
			fail "squash: a snappy copy is out of range"
		}
		let from = len(out) - off
		for j in 0..l {
			out = append(out, out[from+j])
		}
	}
	if len(out) != n {
		fail "squash: snappy data is {len(out)} bytes, its header says {n}"
	}
	return str(out)
}
