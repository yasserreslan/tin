package squash

import "sift"

// The DEFLATE encoder: LZ77 over a 32 KiB window with hash chains (lazy matching from level 4),
// then each block of tokens is written as whichever of stored, fixed Huffman and dynamic Huffman
// is smallest.

// ---- writing bits ----

type bitWriter struct {
	out []u8
	acc u64
	n   i64
}

fn (w mut bitWriter) put(v i64, k i64) {
	w.acc = w.acc | (u64(v) << u64(w.n))
	w.n += k
	for w.n >= 8 {
		w.out = append(w.out, u8(w.acc))
		w.acc = w.acc >> 8
		w.n -= 8
	}
}

// flush pads the last byte with zero bits.
fn (w mut bitWriter) flush() {
	if w.n > 0 {
		w.out = append(w.out, u8(w.acc))
	}
	w.acc = 0
	w.n = 0
}

// ---- Huffman codes for encoding ----

// huffLengths gives each symbol with a nonzero frequency a code length of at most maxBits bits
// (Huffman's lengths, then shortened the way JPEG's Annex K.3 does).
fn huffLengths(freq []i64, maxBits i64) []i64 {
	let n = len(freq)
	mut lengths = make([]i64, n)
	mut keys = make([]i64, 0, n)
	for s, f in freq {
		if f > 0 {
			keys = append(keys, (f << 16) | s)
		}
	}
	if len(keys) == 0 {
		return lengths
	}
	if len(keys) == 1 {
		lengths[keys[0] & 0xffff] = 1
		return lengths
	}
	sift.Ints(mut keys)
	// Huffman's algorithm with two queues: leaves (sorted) and internal nodes (made in order).
	let m = len(keys)
	mut weight = make([]i64, 2*m)
	mut parent = make([]i64, 2*m)
	for i in 0..m {
		weight[i] = keys[i] >> 16
	}
	mut li = 0
	mut ni = m
	mut next = m
	for next < 2*m-1 {
		mut pick = make([]i64, 2)
		for k in 0..2 {
			if li < m && (ni >= next || weight[li] <= weight[ni]) {
				pick[k] = li
				li += 1
			} else {
				pick[k] = ni
				ni += 1
			}
		}
		weight[next] = weight[pick[0]] + weight[pick[1]]
		parent[pick[0]] = next
		parent[pick[1]] = next
		next += 1
	}
	let root = 2*m - 2
	mut depth = make([]i64, 2*m)
	{
		mut i = root - 1
		for i >= 0 {
			depth[i] = depth[parent[i]] + 1
			i -= 1
		}
	}
	mut bits = make([]i64, 64)
	mut maxLen = 0
	for i in 0..m {
		bits[depth[i]] += 1
		if depth[i] > maxLen {
			maxLen = depth[i]
		}
	}
	// Shorten codes longer than maxBits while keeping the code complete.
	{
		mut i = maxLen
		for i > maxBits {
			for bits[i] > 0 {
				mut j = i - 2
				for bits[j] == 0 {
					j -= 1
				}
				bits[i] -= 2
				bits[i-1] += 1
				bits[j+1] += 2
				bits[j] -= 1
			}
			i -= 1
		}
	}
	// The most frequent symbols get the shortest codes.
	mut k = m - 1
	for l in 1..maxBits+1 {
		for c in 0..bits[l] {
			lengths[keys[k] & 0xffff] = l
			k -= 1
		}
	}
	return lengths
}

// codes are the canonical codes for lengths, bit-reversed for writing.
fn codes(lengths []i64) []i64 {
	mut count = make([]i64, 16)
	for _, l in lengths {
		count[l] += 1
	}
	count[0] = 0
	mut next = make([]i64, 16)
	mut code = 0
	for l in 1..16 {
		code = (code + count[l-1]) << 1
		next[l] = code
	}
	mut out = make([]i64, len(lengths))
	for s, l in lengths {
		if l == 0 {
			continue
		}
		let c = next[l]
		next[l] += 1
		mut rev = 0
		for b in 0..l {
			rev = (rev << 1) | ((c >> b) & 1)
		}
		out[s] = rev
	}
	return out
}

// ---- LZ77 ----

const windowSize = 32768
const hashBits = 15
const minMatch = 3
const maxMatch = 258

// A token is a literal byte (0..255) or a match: 1<<32 | length<<16 | distance.
const matchFlag = 4294967296

fn lenCode(length i64) i64 {
	mut i = 28
	for lenBase[i] > length {
		i -= 1
	}
	return i
}

fn distCode(d i64) i64 {
	mut i = 29
	for distBase[i] > d {
		i -= 1
	}
	return i
}

fn hash3(s str, i i64) i64 {
	let v = (i64(s[i]) << 16) | (i64(s[i+1]) << 8) | i64(s[i+2])
	return ((v * 2654435761) >> (32 - hashBits)) & ((1 << hashBits) - 1)
}

// Per level: how many chain links to follow, the length that stops the search, the length below
// which a lazy match is tried at the next byte (0: no lazy matching).
let chainOf = []i64{0, 4, 8, 32, 16, 32, 128, 256, 1024, 4096}
let niceOf = []i64{0, 8, 16, 32, 16, 32, 128, 128, 258, 258}
let lazyOf = []i64{0, 0, 0, 0, 4, 16, 16, 32, 128, 258}

// longest finds the longest earlier match for position i, as length<<16 | distance (0: none).
fn longest(s str, i i64, head []i64, prev []i64, chain i64, nice i64) i64 {
	let n = len(s)
	if i+minMatch > n {
		return 0
	}
	let room = min(maxMatch, n-i)
	mut best = 0
	mut bestD = 0
	mut cand = head[hash3(s, i)]
	mut left = chain
	for cand >= 0 && i-cand <= windowSize && left > 0 && best < room {
		if s[cand+best] == s[i+best] || best == 0 {
			mut l = 0
			for l < room && s[cand+l] == s[i+l] {
				l += 1
			}
			if l > best {
				best = l
				bestD = i - cand
				if l >= nice {
					break
				}
			}
		}
		let p = prev[cand & (windowSize - 1)]
		if p >= cand {
			break
		}
		cand = p
		left -= 1
	}
	if best < minMatch {
		return 0
	}
	return (best << 16) | bestD
}

fn insert(s str, i i64, head mut []i64, prev mut []i64) {
	if i+minMatch > len(s) {
		return
	}
	let h = hash3(s, i)
	prev[i & (windowSize - 1)] = head[h]
	head[h] = i
}

// ---- blocks ----

// writeBlock writes tokens (covering s[from:to]) as the smallest of the three block kinds.
fn writeBlock(w mut bitWriter, tokens []i64, s str, from i64, to i64, final bool) {
	mut lf = make([]i64, 286)
	mut df = make([]i64, 30)
	for _, t in tokens {
		if t < matchFlag {
			lf[t] += 1
		} else {
			let length = (t >> 16) & 0xffff
			let d = t & 0xffff
			lf[257+lenCode(length)] += 1
			df[distCode(d)] += 1
		}
	}
	lf[256] = 1
	// At least two distance codes, as zlib writes, so every inflater accepts the tree.
	mut used = 0
	for _, f in df {
		if f > 0 {
			used += 1
		}
	}
	if used < 2 {
		if df[0] == 0 {
			df[0] = 1
		} else {
			df[1] = 1
		}
	}
	let ll = huffLengths(lf, 15)
	let dl = huffLengths(df, 15)
	// Costs in bits of the data under the dynamic and the fixed codes.
	mut extra = 0
	mut dynData = 0
	mut fixData = 0
	for s2 in 0..286 {
		dynData += lf[s2] * ll[s2]
		fixData += lf[s2] * fixedLitLen(s2)
	}
	for d in 0..30 {
		if df[d] > 0 {
			dynData += df[d] * dl[d]
			fixData += df[d] * 5
		}
	}
	for i in 0..29 {
		extra += lf[257+i] * lenExtra[i]
	}
	for d in 0..30 {
		extra += df[d] * distExtra[d]
	}
	// The dynamic header: lengths run-length coded with symbols 16, 17 and 18.
	mut hlit = 286
	for hlit > 257 && ll[hlit-1] == 0 {
		hlit -= 1
	}
	mut hdist = 30
	for hdist > 1 && dl[hdist-1] == 0 {
		hdist -= 1
	}
	mut all = make([]i64, 0, hlit+hdist)
	all = append(all, ll[:hlit]...)
	all = append(all, dl[:hdist]...)
	let rle = runLengths(all)
	mut cf = make([]i64, 19)
	for _, x in rle {
		cf[x & 31] += 1
	}
	let cl = huffLengths(cf, 7)
	mut hclen = 19
	for hclen > 4 && cl[clOrder[hclen-1]] == 0 {
		hclen -= 1
	}
	mut header = 14 + 3*hclen
	for _, x in rle {
		let sym = x & 31
		header += cl[sym]
		if sym == 16 {
			header += 2
		} else if sym == 17 {
			header += 3
		} else if sym == 18 {
			header += 7
		}
	}
	let dynCost = 3 + header + dynData + extra
	let fixCost = 3 + fixData + extra
	let rawBytes = to - from
	let storeCost = (rawBytes / 65535 + 1) * 40 + rawBytes*8
	if storeCost <= dynCost && storeCost <= fixCost {
		writeStored(mut w, s, from, to, final)
		return
	}
	mut fin = 0
	if final {
		fin = 1
	}
	if fixCost <= dynCost {
		w.put(fin, 1)
		w.put(1, 2)
		writeTokens(mut w, tokens, fixedLitCodes, fixedLitLens, fixedDistCodes, fixedDistLens)
		return
	}
	w.put(fin, 1)
	w.put(2, 2)
	w.put(hlit-257, 5)
	w.put(hdist-1, 5)
	w.put(hclen-4, 4)
	for i in 0..hclen {
		w.put(cl[clOrder[i]], 3)
	}
	let cc = codes(cl)
	for _, x in rle {
		let sym = x & 31
		w.put(cc[sym], cl[sym])
		if sym == 16 {
			w.put(x >> 5, 2)
		} else if sym == 17 {
			w.put(x >> 5, 3)
		} else if sym == 18 {
			w.put(x >> 5, 7)
		}
	}
	writeTokens(mut w, tokens, codes(ll), ll, codes(dl), dl)
}

fn fixedLitLen(s i64) i64 {
	if s < 144 {
		return 8
	}
	if s < 256 {
		return 9
	}
	if s < 280 {
		return 7
	}
	return 8
}

let fixedLitLens = fixed_lengths()
let fixedLitCodes = codes(fixedLitLens)
let fixedDistLens = five30()
let fixedDistCodes = codes(fixedDistLens)

fn five30() []i64 {
	mut l = make([]i64, 30)
	for i in 0..30 {
		l[i] = 5
	}
	return l
}

// runLengths codes lengths with the symbols 0..18; each entry is symbol | extra<<5.
fn runLengths(lens []i64) []i64 {
	mut out = make([]i64, 0, len(lens))
	mut i = 0
	for i < len(lens) {
		let v = lens[i]
		mut run = 1
		for i+run < len(lens) && lens[i+run] == v {
			run += 1
		}
		if v == 0 && run >= 3 {
			mut left = run
			for left >= 11 {
				let k = min(left, 138)
				out = append(out, 18|((k-11)<<5))
				left -= k
			}
			if left >= 3 {
				out = append(out, 17|((left-3)<<5))
				left = 0
			}
			for j in 0..left {
				out = append(out, 0)
			}
			i += run
			continue
		}
		out = append(out, v)
		i += 1
		mut left = run - 1
		for left >= 3 {
			let k = min(left, 6)
			out = append(out, 16|((k-3)<<5))
			left -= k
		}
		for j in 0..left {
			out = append(out, v)
		}
		i += run - 1
	}
	return out
}

fn writeTokens(w mut bitWriter, tokens []i64, lc []i64, ll []i64, dc []i64, dl []i64) {
	for _, t in tokens {
		if t < matchFlag {
			w.put(lc[t], ll[t])
			continue
		}
		let length = (t >> 16) & 0xffff
		let d = t & 0xffff
		let li = lenCode(length)
		w.put(lc[257+li], ll[257+li])
		w.put(length-lenBase[li], lenExtra[li])
		let di = distCode(d)
		w.put(dc[di], dl[di])
		w.put(d-distBase[di], distExtra[di])
	}
	w.put(lc[256], ll[256])
}

// writeStored writes s[from:to] as stored blocks of at most 65535 bytes.
fn writeStored(w mut bitWriter, s str, from i64, to i64, final bool) {
	mut at = from
	for {
		let k = min(65535, to-at)
		let last = at+k == to
		mut fin = 0
		if final && last {
			fin = 1
		}
		w.put(fin, 1)
		w.put(0, 2)
		w.flush()
		w.out = append(w.out, u8(k), u8(k>>8), u8(^k), u8((^k)>>8))
		w.out = append(w.out, s[at:at+k]...)
		at += k
		if last {
			return
		}
	}
}

// Deflate compresses data as raw DEFLATE at level (Store to Best).
fn Deflate(data str, level i64) str {
	mut w = bitWriter{out: make([]u8, 0, len(data)/2+64), acc: 0, n: 0}
	deflateTo(mut w, data, level)
	w.flush()
	return str(w.out)
}

const blockTokens = 16384

fn deflateTo(w mut bitWriter, s str, level0 i64) {
	let level = min(max(level0, 0), 9)
	if level == 0 || len(s) == 0 {
		writeStored(mut w, s, 0, len(s), true)
		return
	}
	let chain = chainOf[level]
	let nice = niceOf[level]
	let lazy = lazyOf[level]
	mut head = make([]i64, 1 << hashBits)
	for i in 0..len(head) {
		head[i] = -1
	}
	mut prev = make([]i64, windowSize)
	mut tokens = make([]i64, 0, blockTokens)
	mut blockStart = 0
	mut i = 0
	let n = len(s)
	for i < n {
		mut m = longest(s, i, head, prev, chain, nice)
		insert(s, i, mut head, mut prev)
		if m != 0 && lazy > 0 && (m >> 16) < lazy && i+1 < n {
			// A longer match one byte later wins: this byte goes out as a literal.
			let m2 = longest(s, i+1, head, prev, chain, nice)
			if (m2 >> 16) > (m >> 16) {
				m = 0
			}
		}
		if m == 0 {
			tokens = append(tokens, i64(s[i]))
			i += 1
		} else {
			let length = m >> 16
			tokens = append(tokens, matchFlag|m)
			for k in 1..length {
				insert(s, i+k, mut head, mut prev)
			}
			i += length
		}
		if len(tokens) >= blockTokens {
			writeBlock(mut w, tokens, s, blockStart, i, i >= n)
			tokens = tokens[:0]
			blockStart = i
		}
	}
	if len(tokens) > 0 {
		writeBlock(mut w, tokens, s, blockStart, n, true)
	}
}
