// Package twine manipulates UTF-8 strings (like Go's strings), with Unicode case mapping, folding and white
// space from glyph's tables.
package twine

import "glyph"


// IndexByte returns the byte offset of the first c in s, or -1.
fn IndexByte(s str, c u8) i64 {
	let n = len(s)
	if n == 0 {
		return -1
	}
	let ps = cast(i64, s) + 8
	let p = memchr(ps, i64(c), n)
	if p == 0 {
		return -1
	}
	return p - ps
}

// LastIndexByte returns the byte offset of the last c in s, or -1.
fn LastIndexByte(s str, c u8) i64 {
	{
		mut i = len(s) - 1
		for i >= 0 {
			if s[i] == c {
				return i
			}
			i -= 1
		}
	}
	return -1
}

// indexAt returns the offset of the first sub in s at or after from, or -1 (sub must be non-empty).
fn indexAt(s str, sub str, from i64) i64 {
	let n = len(sub)
	let ls = len(s)
	if from < 0 {
		from = 0
	}
	if n > ls-from {
		return -1
	}
	let ps = cast(i64, s) + 8
	let psub = cast(i64, sub) + 8
	let c0 = i64(sub[0])
	let last = ls - n
	mut i = from
	for i <= last {
		let p = memchr(ps+i, c0, last-i+1)
		if p == 0 {
			return -1
		}
		i = p - ps
		if n == 1 || memcmp(ps+i+1, psub+1, n-1)&0xffffffff == 0 {
			return i
		}
		i += 1
	}
	return -1
}

// Index returns the byte offset of the first sub in s, or -1 (0 for an empty sub).
fn Index(s str, sub str) i64 {
	if len(sub) == 0 {
		return 0
	}
	return indexAt(s, sub, 0)
}

// LastIndex returns the byte offset of the last sub in s, or -1 (len(s) for an empty sub).
fn LastIndex(s str, sub str) i64 {
	let n = len(sub)
	let ls = len(s)
	if n == 0 {
		return ls
	}
	if n > ls {
		return -1
	}
	let ps = cast(i64, s) + 8
	let psub = cast(i64, sub) + 8
	let c0 = sub[0]
	{
		mut i = ls - n
		for i >= 0 {
			if s[i] == c0 && memcmp(ps+i, psub, n)&0xffffffff == 0 {
				return i
			}
			i -= 1
		}
	}
	return -1
}

// Contains reports whether sub occurs in s.
fn Contains(s str, sub str) bool {
	return Index(s, sub) >= 0
}

// ContainsByte reports whether byte c occurs in s.
fn ContainsByte(s str, c u8) bool {
	return IndexByte(s, c) >= 0
}

// HasPrefix reports whether s starts with prefix.
fn HasPrefix(s str, prefix str) bool {
	let n = len(prefix)
	if n > len(s) {
		return false
	}
	if n == 0 {
		return true
	}
	return memcmp(cast(i64, s)+8, cast(i64, prefix)+8, n)&0xffffffff == 0
}

// HasSuffix reports whether s ends with suffix.
fn HasSuffix(s str, suffix str) bool {
	let n = len(suffix)
	let ls = len(s)
	if n > ls {
		return false
	}
	if n == 0 {
		return true
	}
	return memcmp(cast(i64, s)+8+ls-n, cast(i64, suffix)+8, n)&0xffffffff == 0
}

// Split slices s around every sep (into runes when sep is empty) and returns the pieces.
fn Split(s str, sep str) []str {
	return SplitN(s, sep, -1)
}

// SplitN is Split returning at most n pieces (all when n < 0, none when n == 0).
fn SplitN(s str, sep str, n i64) []str {
	mut out = make([]str, 0, 8)
	if n == 0 {
		return out
	}
	if len(sep) == 0 {
		return explode(s, n)
	}
	mut start = 0
	let ls = len(s)
	for n < 0 || len(out) < n-1 {
		let i = indexAt(s, sep, start)
		if i < 0 {
			break
		}
		out = append(out, s[start:i])
		start = i + len(sep)
	}
	out = append(out, s[start:ls])
	return out
}

// explode splits s into its runes, at most n pieces when n > 0.
fn explode(s str, n i64) []str {
	mut out = make([]str, 0, 8)
	let ls = len(s)
	mut i = 0
	for i < ls {
		if n > 0 && len(out) == n-1 {
			break
		}
		let (_, size) = glyph.DecodeRune(s, i)
		out = append(out, s[i:i+size])
		i += size
	}
	if i < ls {
		out = append(out, s[i:ls])
	}
	return out
}

// isSpaceByte reports whether c is ASCII white space.
fn isSpaceByte(c u8) bool {
	return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == 0x0b || c == 0x0c
}

// Join concatenates elems with sep between them.
fn Join(elems []str, sep str) str {
	let n = len(elems)
	if n == 0 {
		return ""
	}
	if n == 1 {
		return elems[0]
	}
	mut total = len(sep) * (n - 1)
	for _, e in elems {
		total += len(e)
	}
	if total == 0 {
		return ""
	}
	let p = rt_str_new(total)
	let d = p + 8
	mut off = 0
	for i, e in elems {
		if i > 0 && len(sep) > 0 {
			memcpy(d+off, cast(i64, sep)+8, len(sep))
			off += len(sep)
		}
		if len(e) > 0 {
			memcpy(d+off, cast(i64, e)+8, len(e))
			off += len(e)
		}
	}
	return cast(str, p)
}

// Repeat returns s concatenated count times (empty when count <= 0; panics when the length overflows).
fn Repeat(s str, count i64) str {
	let n = len(s)
	if count <= 0 || n == 0 {
		return ""
	}
	if count == 1 {
		return s
	}
	if n > 9223372036854775807/count {
		panic("twine: Repeat output length overflow")
	}
	let p = rt_str_new(n * count)
	let d = p + 8
	let src = cast(i64, s) + 8
	for i in 0..count {
		memcpy(d+i*n, src, n)
	}
	return cast(str, p)
}

// Count returns the number of non-overlapping sub in s (RuneCount+1 when sub is empty).
fn Count(s str, sub str) i64 {
	let n = len(sub)
	if n == 0 {
		return glyph.RuneCount(s) + 1
	}
	mut k = 0
	if n == 1 {
		let c = sub[0]
		for i in 0..len(s) {
			if s[i] == c {
				k += 1
			}
		}
		return k
	}
	mut i = 0
	for i <= len(s)-n {
		let j = indexAt(s, sub, i)
		if j < 0 {
			break
		}
		k += 1
		i = j + n
	}
	return k
}

// Replace returns s with the first n non-overlapping old replaced by repl (all when n < 0; empty old matches at every rune boundary).
fn Replace(s str, old str, repl str, n i64) str {
	if n == 0 || old == repl {
		return s
	}
	let m = Count(s, old)
	if m == 0 {
		return s
	}
	if n < 0 || m < n {
		n = m
	}
	mut b = make([]u8, 0, len(s)+n*(len(repl)-len(old)))
	mut start = 0
	for i in 0..n {
		mut j = start
		if len(old) == 0 {
			if i > 0 {
				let (_, size) = glyph.DecodeRune(s, start)
				j += size
			}
		} else {
			j = indexAt(s, old, start)
		}
		b = append(b, s[start:j]...)
		b = append(b, repl...)
		start = j + len(old)
	}
	b = append(b, s[start:len(s)]...)
	return str(b)
}

// ReplaceAll returns s with every non-overlapping old replaced by repl.
fn ReplaceAll(s str, old str, repl str) str {
	return Replace(s, old, repl, -1)
}

// cutRune returns the size of the rune at s[i] when it is in cutset, else 0.
fn cutRune(s str, i i64, cutset str) i64 {
	let c = s[i]
	if c < 0x80 {
		if IndexByte(cutset, c) >= 0 {
			return 1
		}
		return 0
	}
	let (r, size) = glyph.DecodeRune(s, i)
	if IndexRune(cutset, r) >= 0 {
		return size
	}
	return 0
}

// TrimLeft returns s without its leading runes that are in cutset.
fn TrimLeft(s str, cutset str) str {
	let n = len(s)
	if n == 0 || len(cutset) == 0 {
		return s
	}
	mut i = 0
	for i < n {
		let size = cutRune(s, i, cutset)
		if size == 0 {
			break
		}
		i += size
	}
	return s[i:n]
}

// TrimRight returns s without its trailing runes that are in cutset.
fn TrimRight(s str, cutset str) str {
	mut end = len(s)
	if end == 0 || len(cutset) == 0 {
		return s
	}
	for end > 0 {
		let c = s[end-1]
		if c < 0x80 {
			if IndexByte(cutset, c) < 0 {
				break
			}
			end -= 1
			continue
		}
		let (r, size) = glyph.DecodeLastRune(s, end)
		if IndexRune(cutset, r) < 0 {
			break
		}
		end -= size
	}
	return s[0:end]
}

// Trim returns s without leading and trailing runes that are in cutset.
fn Trim(s str, cutset str) str {
	return TrimRight(TrimLeft(s, cutset), cutset)
}

// TrimSpace returns s without leading and trailing white space (ASCII, U+0085, U+00A0).
fn TrimSpace(s str) str {
	let n = len(s)
	mut i = 0
	for i < n {
		let c = s[i]
		if c < 0x80 {
			if !isSpaceByte(c) {
				break
			}
			i += 1
			continue
		}
		let (r, size) = glyph.DecodeRune(s, i)
		if !glyph.IsSpace(r) {
			break
		}
		i += size
	}
	mut end = n
	for end > i {
		let c = s[end-1]
		if c < 0x80 {
			if !isSpaceByte(c) {
				break
			}
			end -= 1
			continue
		}
		let (r, size) = glyph.DecodeLastRune(s, end)
		if !glyph.IsSpace(r) {
			break
		}
		end -= size
	}
	return s[i:end]
}

// TrimPrefix returns s without the leading prefix, or s unchanged.
fn TrimPrefix(s str, prefix str) str {
	if HasPrefix(s, prefix) {
		return s[len(prefix):len(s)]
	}
	return s
}

// TrimSuffix returns s without the trailing suffix, or s unchanged.
fn TrimSuffix(s str, suffix str) str {
	if HasSuffix(s, suffix) {
		return s[0 : len(s)-len(suffix)]
	}
	return s
}

// Compare returns -1, 0 or 1 ordering a and b bytewise.
fn Compare(a str, b str) i64 {
	let la = len(a)
	let lb = len(b)
	mut n = la
	if lb < n {
		n = lb
	}
	if n > 0 {
		let r = (memcmp(cast(i64, a)+8, cast(i64, b)+8, n) << 32) >> 32
		if r < 0 {
			return -1
		}
		if r > 0 {
			return 1
		}
	}
	if la < lb {
		return -1
	}
	if la > lb {
		return 1
	}
	return 0
}

// IndexRune returns the byte offset of the first r in s, or -1.
fn IndexRune(s str, r i32) i64 {
	if r >= 0 && r < 0x80 {
		return IndexByte(s, u8(r))
	}
	if r == glyph.RuneError {
		// Matches an invalid byte as well as a real U+FFFD.
		mut i = 0
		for i < len(s) {
			let (c, size) = glyph.DecodeRune(s, i)
			if c == glyph.RuneError {
				return i
			}
			i += size
		}
		return -1
	}
	if !glyph.ValidRune(r) {
		return -1
	}
	return Index(s, glyph.RuneStr(r))
}

// ContainsRune reports whether rune r occurs in s.
fn ContainsRune(s str, r i32) bool {
	return IndexRune(s, r) >= 0
}

// IndexAny returns the byte offset of the first rune of s that is in chars, or -1.
fn IndexAny(s str, chars str) i64 {
	if len(chars) == 0 {
		return -1
	}
	let n = len(s)
	mut i = 0
	for i < n {
		let size = cutRune(s, i, chars)
		if size > 0 {
			return i
		}
		if s[i] < 0x80 {
			i += 1
		} else {
			let (_, w) = glyph.DecodeRune(s, i)
			i += w
		}
	}
	return -1
}

// ContainsAny reports whether any rune of chars occurs in s.
fn ContainsAny(s str, chars str) bool {
	return IndexAny(s, chars) >= 0
}

// Cut splits s around the first sep, returning (before, after, true), or (s, "", false) when absent.
fn Cut(s str, sep str) (str, str, bool) {
	let i = Index(s, sep)
	if i < 0 {
		return s, "", false
	}
	return s[0:i], s[i+len(sep) : len(s)], true
}

// Builder accumulates bytes; the zero Builder{} is ready to use, NewBuilder preallocates.
type Builder struct {
	buf []u8
}

// NewBuilder returns an empty Builder with room for n bytes.
fn NewBuilder(n i64) Builder {
	return Builder{buf: make([]u8, 0, n)}
}

// Str appends s.
fn (b mut Builder) Str(s str) {
	b.buf = append(b.buf, s...)
}

// Byte appends one byte.
fn (b mut Builder) Byte(c u8) {
	b.buf = append(b.buf, c)
}

// Rune appends the UTF-8 encoding of r.
fn (b mut Builder) Rune(r i32) {
	b.buf = append(b.buf, glyph.RuneStr(r)...)
}

// Int appends v in decimal.
fn (b mut Builder) Int(v i64) {
	if v == 0 {
		b.buf = append(b.buf, '0')
		return
	}
	mut u = u64(v)
	if v < 0 {
		b.buf = append(b.buf, '-')
		u = 0 -% u
	}
	mut n = 0
	mut t = u
	for t > 0 {
		t /= 10
		n += 1
	}
	let start = len(b.buf)
	for i in 0..n {
		b.buf = append(b.buf, '0')
	}
	mut pos = start + n - 1
	for u > 0 {
		b.buf[pos] = u8(u%10) + '0'
		u /= 10
		pos -= 1
	}
}

// Len returns the number of bytes accumulated.
fn (b Builder) Len() i64 {
	return len(b.buf)
}

// String returns a copy of the accumulated bytes as a str.
fn (b Builder) String() str {
	return str(b.buf)
}

// Bytes returns the accumulated bytes without copying (aliases the Builder).
fn (b Builder) Bytes() []u8 {
	return b.buf
}

// Cap returns the number of bytes the Builder can hold without growing.
fn (b Builder) Cap() i64 {
	return cap(b.buf)
}

// Grow makes room for n more bytes.
fn (b mut Builder) Grow(n i64) {
	if n < 0 {
		panic("strings.Builder.Grow: negative count")
	}
	if cap(b.buf)-len(b.buf) < n {
		let grown = make([]u8, len(b.buf), 2*cap(b.buf)+n)
		copy(grown, b.buf)
		b.buf = grown
	}
}

// Write appends p.
fn (b mut Builder) Write(p []u8) {
	b.buf = append(b.buf, p...)
}

// Reset empties the Builder but keeps its capacity.
fn (b mut Builder) Reset() {
	b.buf = b.buf[0:0]
}
