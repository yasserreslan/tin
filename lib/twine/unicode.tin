package twine

import "glyph"

// ---- case ----

// isASCII reports whether every byte of s is below 0x80.
func isASCII(s str) bool {
	for i := 0; i < len(s); i++ {
		if s[i] >= 0x80 {
			return false
		}
	}
	return true
}

// Map returns s with every rune replaced by mapping(rune); a rune mapped to a negative value is
// dropped. Invalid UTF-8 bytes reach mapping as U+FFFD, and a rune mapped to it is written as U+FFFD.
func Map(mapping func(i32) i32, s str) str {
	b := NewBuilder(len(s))
	i := 0
	n := len(s)
	for i < n {
		r, size := glyph.DecodeRune(s, i)
		m := mapping(r)
		if m >= 0 {
			if m < 0x80 {
				b.Byte(u8(m))
			} else {
				b.Rune(m)
			}
		}
		i += size
	}
	return b.String()
}

// ToUpper returns s with every letter mapped to upper case.
func ToUpper(s str) str {
	if isASCII(s) {
		has := false
		for i := 0; i < len(s); i++ {
			if s[i] >= 'a' && s[i] <= 'z' {
				has = true
				break
			}
		}
		if !has {
			return s
		}
		b := make([]u8, len(s))
		for i := 0; i < len(s); i++ {
			c := s[i]
			if c >= 'a' && c <= 'z' {
				c -= 32
			}
			b[i] = c
		}
		return str(b)
	}
	return Map(glyph.ToUpper, s)
}

// ToLower returns s with every letter mapped to lower case.
func ToLower(s str) str {
	if isASCII(s) {
		has := false
		for i := 0; i < len(s); i++ {
			if s[i] >= 'A' && s[i] <= 'Z' {
				has = true
				break
			}
		}
		if !has {
			return s
		}
		b := make([]u8, len(s))
		for i := 0; i < len(s); i++ {
			c := s[i]
			if c >= 'A' && c <= 'Z' {
				c += 32
			}
			b[i] = c
		}
		return str(b)
	}
	return Map(glyph.ToLower, s)
}

// ToTitle returns s with every letter mapped to title case.
func ToTitle(s str) str {
	return Map(glyph.ToTitle, s)
}

// isSeparator reports whether r separates words for Title.
func isSeparator(r i32) bool {
	if r <= 0x7f {
		if r >= '0' && r <= '9' || r >= 'a' && r <= 'z' || r >= 'A' && r <= 'Z' || r == '_' {
			return false
		}
		return true
	}
	if glyph.IsLetter(r) || glyph.IsDigit(r) {
		return false
	}
	return glyph.IsSpace(r)
}

// Title returns s with the first letter of each word mapped to title case. It cannot tell where words
// start in every script (the apostrophe in "they're" starts one): it is Go's deprecated strings.Title.
func Title(s str) str {
	b := NewBuilder(len(s))
	var prev i32 = ' '
	i := 0
	for i < len(s) {
		r, size := glyph.DecodeRune(s, i)
		m := r
		if isSeparator(prev) {
			m = glyph.ToTitle(r)
		}
		prev = r
		b.Rune(m)
		i += size
	}
	return b.String()
}

// EqualFold reports whether s and t are equal under Unicode simple case folding.
func EqualFold(s str, t str) bool {
	i := 0
	j := 0
	for i < len(s) && j < len(t) {
		var sr i32
		var tr i32
		if s[i] < 0x80 {
			sr = i32(s[i])
			i++
		} else {
			r, size := glyph.DecodeRune(s, i)
			sr = r
			i += size
		}
		if t[j] < 0x80 {
			tr = i32(t[j])
			j++
		} else {
			r, size := glyph.DecodeRune(t, j)
			tr = r
			j += size
		}
		if tr == sr {
			continue
		}
		if tr < sr {
			sr, tr = tr, sr
		}
		if tr < 0x80 {
			// Both are ASCII: sr must be upper case and tr its lower-case form.
			if 'A' <= sr && sr <= 'Z' && tr == sr+'a'-'A' {
				continue
			}
			return false
		}
		r := glyph.SimpleFold(sr)
		for r != sr && r < tr {
			r = glyph.SimpleFold(r)
		}
		if r == tr {
			continue
		}
		return false
	}
	return i == len(s) && j == len(t)
}

// ---- white space and fields ----

// Fields splits s around runs of white space (Unicode's) and returns the non-empty pieces.
func Fields(s str) []str {
	return FieldsFunc(s, glyph.IsSpace)
}

// FieldsFunc splits s around runs of runes for which f is true and returns the non-empty pieces.
func FieldsFunc(s str, f func(i32) bool) []str {
	out := make([]str, 0, 8)
	n := len(s)
	start := -1
	i := 0
	for i < n {
		r, size := glyph.DecodeRune(s, i)
		if f(r) {
			if start >= 0 {
				out = append(out, s[start:i])
				start = -1
			}
		} else if start < 0 {
			start = i
		}
		i += size
	}
	if start >= 0 {
		out = append(out, s[start:n])
	}
	return out
}

// ---- searching and trimming with a function ----

// IndexFunc returns the byte offset of the first rune for which f is true, or -1.
func IndexFunc(s str, f func(i32) bool) i64 {
	i := 0
	for i < len(s) {
		r, size := glyph.DecodeRune(s, i)
		if f(r) {
			return i
		}
		i += size
	}
	return -1
}

// LastIndexFunc returns the byte offset of the last rune for which f is true, or -1.
func LastIndexFunc(s str, f func(i32) bool) i64 {
	end := len(s)
	for end > 0 {
		r, size := glyph.DecodeLastRune(s, end)
		end -= size
		if f(r) {
			return end
		}
	}
	return -1
}

// ContainsFunc reports whether f is true for any rune of s.
func ContainsFunc(s str, f func(i32) bool) bool {
	return IndexFunc(s, f) >= 0
}

// TrimLeftFunc returns s without the leading runes for which f is true.
func TrimLeftFunc(s str, f func(i32) bool) str {
	i := 0
	for i < len(s) {
		r, size := glyph.DecodeRune(s, i)
		if !f(r) {
			break
		}
		i += size
	}
	return s[i:]
}

// TrimRightFunc returns s without the trailing runes for which f is true.
func TrimRightFunc(s str, f func(i32) bool) str {
	end := len(s)
	for end > 0 {
		r, size := glyph.DecodeLastRune(s, end)
		if !f(r) {
			break
		}
		end -= size
	}
	return s[:end]
}

// TrimFunc returns s without the leading and trailing runes for which f is true.
func TrimFunc(s str, f func(i32) bool) str {
	return TrimRightFunc(TrimLeftFunc(s, f), f)
}
