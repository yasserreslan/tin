// Darwin system calls retain libSystem.
package wire

extern func accept(fd i64, addr i64, n i64) i64
func rt_sys_accept(fd i64, addr i64, n i64) i64 { return accept(fd, addr, n) }
extern func bind(fd i64, addr i64, n i64) i64
func rt_sys_bind(fd i64, addr i64, n i64) i64 { return bind(fd, addr, n) }
extern func close(fd i64) i64
func rt_sys_close(fd i64) i64 { return close(fd) }
extern func connect(fd i64, addr i64, n i64) i64
func rt_sys_connect(fd i64, addr i64, n i64) i64 { return connect(fd, addr, n) }
extern func fcntl(fd i64, cmd i64, ...) i64
func rt_sys_fcntl(fd i64, cmd i64, arg i64) i64 { return fcntl(fd, cmd, arg) }
extern func getsockname(fd i64, addr i64, n i64) i64
func rt_sys_getsockname(fd i64, addr i64, n i64) i64 { return getsockname(fd, addr, n) }
extern func getsockopt(fd i64, level i64, name i64, val i64, n i64) i64
func rt_sys_getsockopt(fd i64, level i64, name i64, val i64, n i64) i64 { return getsockopt(fd, level, name, val, n) }
extern func listen(fd i64, backlog i64) i64
func rt_sys_listen(fd i64, backlog i64) i64 { return listen(fd, backlog) }
extern func poll(fds i64, n i64, timeout i64) i64
func rt_sys_poll(fds i64, n i64, timeout i64) i64 { return poll(fds, n, timeout) }
extern func setsockopt(fd i64, level i64, name i64, val i64, n i64) i64
func rt_sys_setsockopt(fd i64, level i64, name i64, val i64, n i64) i64 { return setsockopt(fd, level, name, val, n) }
extern func socket(domain i64, typ i64, proto i64) i64
func rt_sys_socket(domain i64, typ i64, proto i64) i64 { return socket(domain, typ, proto) }
