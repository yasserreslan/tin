// Package wire is TCP networking and a small HTTP/1.1 client. Calls block the calling
// core (servers should use anvil); every connection can carry a read/write timeout.
//
//	c := try wire.Dial("127.0.0.1:6379")
//	try c.Write("PING\r\n")
//	r := try wire.Get("http://127.0.0.1:8080/json")
package wire

import "say"

extern func getaddrinfo(node i64, service i64, hints i64, res i64) i64
extern func freeaddrinfo(res i64)
extern func strerror(e i64) i64

// Conn is a TCP connection.
type Conn struct {
	open    bool // false for the zero Conn (a failed Dial or Accept): it owns no descriptor
	fd      i64
	timeout i64  // ns a read or write may wait (0: no limit; a request's deadline still applies)
	until   i64  // monotonic ns after which every wait fails (0: none); set by DoWith's Timeout
}

// Listener accepts TCP connections.
type Listener struct {
	open bool // false for the zero Listener (a failed Listen)
	fd   i64
	port i64
}

// Resp is an HTTP response.
type Resp struct {
	Status i64
	Body   str
	head   str
}

func errno() i64 {
	return rt_errno()
}

func os_fault(what str) ! {
	m := strerror(errno())
	fail say.Fault("wire: %s: %s", what, rt_str_from_raw(m, strlen(m)))
}

// EOF is the fault Read returns at the end of the stream.
func IsEOF(err fault) bool {
	return err != nil && say.Str(err) == "EOF"
}

// split_addr cuts "host:port" (host may be empty).
func split_addr(addr str) !(str, i64) {
	colon := -1
	for i := 0; i < len(addr); i++ {
		if addr[i] == ':' {
			colon = i
		}
	}
	if colon < 0 || colon == len(addr)-1 {
		fail say.Fault("wire: address %q needs a port", addr)
	}
	port := 0
	for i := colon + 1; i < len(addr); i++ {
		c := addr[i]
		if c < '0' || c > '9' || port > 65535 {
			fail say.Fault("wire: bad port in %q", addr)
		}
		port = port*10 + i64(c-'0')
	}
	if port > 65535 {
		fail say.Fault("wire: bad port in %q", addr)
	}
	return addr[:colon], port
}

// resolve fills a sockaddr_in for host (dotted IPv4, "localhost" or a DNS name).
func resolve(host str, port i64, sa i64) ! {
	rt_sockaddr_in(sa, 0, port)
	if host == "" || host == "localhost" {
		if host == "localhost" {
			rt_sockaddr_in(sa, 0x7f000001, port)
		}
		return
	}
	parts := 0
	val := 0
	octets := calloc(1, 8)
	dotted := true
	for i := 0; i < len(host); i++ {
		c := host[i]
		if c == '.' {
			if parts >= 3 || val > 255 {
				dotted = false
				break
			}
			store8(octets+parts, val)
			parts++
			val = 0
		} else if c >= '0' && c <= '9' {
			val = val*10 + i64(c-'0')
		} else {
			dotted = false
			break
		}
	}
	if dotted && parts == 3 && val <= 255 {
		store8(octets+3, val)
		memcpy(sa+4, octets, 4)
		free(octets)
		return
	}
	free(octets)
	// getaddrinfo blocks: inside a request task it runs on a helper thread.
	job := calloc(3, 8)
	job[0] = rt_heap_str(host)
	job[1] = calloc(1, 16)
	try rt_helper_run(dns_job, job, dns_drop)
	ok := job[2] != 0
	if ok {
		memcpy(sa+4, job[1]+4, 4)
	}
	dns_drop(job)
	if !ok {
		fail say.Fault("wire: cannot resolve %q", host)
	}
}

func dns_drop(job i64) {
	free(job[0])
	free(job[1])
	free(job)
}

// dns_job resolves heap-owned inputs into its own sockaddr; job[2] is 1 on success.
func dns_job(job i64) {
	hints := calloc(1, 48)
	__st(hints+4, 2, 2)
	__st(hints+8, 1, 2)
	res := calloc(1, 8)
	rc := i64(i32(getaddrinfo(job[0]+8, 0, hints, res)))
	free(hints)
	if rc != 0 || res[0] == 0 {
		free(res)
		return
	}
	ai := res[0]
	addr := rt_ai_addr(ai)
	memcpy(job[1]+4, addr+4, 4)
	freeaddrinfo(ai)
	free(res)
	job[2] = 1
}

// wait_io waits until fd is ready for a read (want 1) or write (2), within timeout ns.
func wait_io(fd i64, want i64, timeout i64, what str) ! {
	r := rt_task_wait(fd, want, timeout)
	if r == waitDeadline {
		fail "deadline exceeded"
	}
	if r == waitTimeout {
		fail "wire: {what} timed out"
	}
}

// wait is wait_io for c: the per-wait timeout, cut short by the call's overall limit.
func (c Conn) wait(want i64, what str) ! {
	t := c.timeout
	if c.until > 0 {
		left := c.until - rt_mono_ns()
		if left <= 0 {
			fail "wire: {what} timed out"
		}
		if t == 0 || left < t {
			t = left
		}
	}
	try wait_io(c.fd, want, t, what)
}

func nonblocking(fd i64) {
	flags := i64(i32(rt_sys_fcntl(fd, F_GETFL, 0)))
	rt_sys_fcntl(fd, F_SETFL, flags|O_NONBLOCK)
}

// Dial connects to "host:port".
func Dial(addr str) !Conn {
	return try DialTimeout(addr, 0)
}

// DialTimeout connects to "host:port", giving up after timeout nanoseconds (0: no limit).
func DialTimeout(addr str, timeout i64) !Conn {
	none := Conn{fd: -1}
	host, port, err := split_addr(addr)
	if err != nil {
		fail err
	}
	sa := calloc(1, 16)
	defer free(sa)
	e2 := resolve(host, port, sa)
	if e2 != nil {
		fail e2
	}
	fd := i64(i32(rt_sys_socket(2, 1, 0)))
	if fd < 0 {
		fail os_fault("socket")
	}
	one := calloc(1, 8)
	one[0] = 1
	rt_nosigpipe(fd)
	rt_sys_setsockopt(fd, 6, 1, one, 4)
	free(one)
	// Sockets are non-blocking: inside a request task a wait lets the core serve others.
	nonblocking(fd)
	if i64(i32(rt_sys_connect(fd, sa, 16))) < 0 {
		if errno() != EINPROGRESS {
			f2 := os_fault(say.Fmt("connect %s", addr))
			rt_sys_close(fd)
			if f2 != nil {
				fail f2
			}
			return none
		}
		werr := wait_io(fd, 2, timeout, "connect " + addr)
		if werr != nil {
			rt_sys_close(fd)
			fail werr
		}
		soerr := calloc(1, 8)
		ln := calloc(1, 8)
		ln[0] = 4
		rt_sys_getsockopt(fd, SOL_SOCKET, SO_ERROR, soerr, ln)
		code := i64(i32(soerr[0]))
		free(soerr)
		free(ln)
		if code != 0 {
			m := strerror(code)
			rt_sys_close(fd)
			fail say.Fault("wire: connect %s: %s", addr, rt_str_from_raw(m, strlen(m)))
		}
	}
	return Conn{open: true, fd: fd, timeout: 0}
}

// Fd is the connection's descriptor, for clients that do their own I/O on it (it stays
// non-blocking; Close still closes it).
func (c Conn) Fd() i64 {
	return c.fd
}

// SetTimeout limits every later read and write to ns nanoseconds (0: no limit).
func (c mut Conn) SetTimeout(ns i64) {
	c.timeout = ns
}

// SetNoDelay turns Nagle's algorithm off (true) or on.
func (c Conn) SetNoDelay(on bool) {
	v := calloc(1, 8)
	if on {
		v[0] = 1
	}
	rt_sys_setsockopt(c.fd, 6, 1, v, 4)
	free(v)
}

// WriteRaw sends n bytes at p.
func (c Conn) write_raw(p i64, n i64) ! {
	if !c.open {
		fail "wire: write on a closed connection"
	}
	for n > 0 {
		k := rt_sys_write(c.fd, p, n)
		if k < 0 {
			e := errno()
			if e == 4 {
				continue
			}
			if e == EAGAIN {
				try c.wait(2, "write")
				continue
			}
			fail os_fault("write")
		}
		p += k
		n -= k
	}
}

// Write sends all of s.
func (c Conn) Write(s str) ! {
	return try c.write_raw(cast(i64, s)+8, len(s))
}

// WriteBytes sends all of b.
func (c Conn) WriteBytes(b []u8) ! {
	return try c.write_raw(cast(i64, b)[2], len(b))
}

// Read appends up to max bytes to buf and returns how many; at the end it returns 0 and EOF.
func (c Conn) Read(buf mut []u8, max i64) !i64 {
	if !c.open {
		fail "wire: read on a closed connection"
	}
	h := cast(i64, buf)
	if h[0]+max > h[1] {
		rt_slice_grow(h, h[0]+max, 1)
	}
	for {
		k := rt_sys_read(c.fd, h[2]+h[0], max)
		if k > 0 {
			h[0] += k
			return k
		}
		if k == 0 {
			fail "EOF"
		}
		e := errno()
		if e == 4 {
			continue
		}
		if e == EAGAIN {
			try c.wait(1, "read")
			continue
		}
		fail os_fault("read")
	}
}

// ReadFull reads exactly n bytes.
func (c Conn) ReadFull(n i64) !str {
	b := make([]u8, 0, n)
	for len(b) < n {
		_, err := c.Read(mut b, n-len(b))
		if err != nil {
			fail err
		}
	}
	return str(b)
}

// Close closes the connection.
func (c mut Conn) Close() {
	if c.open {
		rt_sys_close(c.fd)
		c.open = false
	}
}

// Listen opens a TCP listener on "host:port" (":0" picks a free port: see Port).
func Listen(addr str) !Listener {
	none := Listener{fd: -1}
	host, port, err := split_addr(addr)
	if err != nil {
		fail err
	}
	sa := calloc(1, 16)
	defer free(sa)
	e2 := resolve(host, port, sa)
	if e2 != nil {
		fail e2
	}
	fd := i64(i32(rt_sys_socket(2, 1, 0)))
	if fd < 0 {
		fail os_fault("socket")
	}
	one := calloc(1, 8)
	one[0] = 1
	rt_sys_setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, one, 4)
	free(one)
	if i64(i32(rt_sys_bind(fd, sa, 16))) < 0 {
		f := os_fault(say.Fmt("bind %s", addr))
		rt_sys_close(fd)
		if f != nil {
			fail f
		}
		return none
	}
	if i64(i32(rt_sys_listen(fd, 1024))) < 0 {
		f2 := os_fault("listen")
		rt_sys_close(fd)
		if f2 != nil {
			fail f2
		}
		return none
	}
	ln := calloc(1, 8)
	ln[0] = 16
	rt_sys_getsockname(fd, sa, ln)
	free(ln)
	nonblocking(fd)
	return Listener{open: true, fd: fd, port: i64(load8(sa+2))<<8 | i64(load8(sa+3))}
}

// Port is the port the listener is bound to.
func (l Listener) Port() i64 {
	return l.port
}

// Accept waits for the next connection.
func (l Listener) Accept() !Conn {
	if !l.open {
		fail "wire: accept on a closed listener"
	}
	for {
		fd := i64(i32(rt_sys_accept(l.fd, 0, 0)))
		if fd >= 0 {
			one := calloc(1, 8)
			one[0] = 1
			rt_nosigpipe(fd)
			rt_sys_setsockopt(fd, 6, 1, one, 4)
			free(one)
			nonblocking(fd)
			return Conn{open: true, fd: fd, timeout: 0}
		}
		e := errno()
		if e == EAGAIN {
			try wait_io(l.fd, 1, 0, "accept")
			continue
		}
		if e != 4 {
			fail os_fault("accept")
		}
	}
}

// Close stops listening.
func (l mut Listener) Close() {
	if l.open {
		rt_sys_close(l.fd)
		l.open = false
	}
}

// ---- HTTP client ----

// Options configure one client call (DoWith); the zero value is what Do uses.
type Options struct {
	Timeout i64 // ns for the whole call: connect, send and the complete response (0: no limit; a request's deadline still applies)
	MaxBody i64 // largest response body accepted, in bytes (0: DefaultMaxBody)
}

// DefaultMaxBody is the largest response body Do accepts (64 MiB, anvil's request limit):
// a larger one is a fault rather than memory a broken or hostile server can fill.
const DefaultMaxBody = 67108864

// Get fetches url.
func Get(url str) !Resp {
	return try Do("GET", url, []str{}, "")
}

// Post sends body with content type ctype to url.
func Post(url str, ctype str, body str) !Resp {
	return try Do("POST", url, []str{"Content-Type", ctype}, body)
}

func none_resp() Resp {
	return Resp{Body: "", head: ""}
}

// Do sends one request: headers is a list of name, value pairs. The method and header names
// must be tokens, and the URL and header values must not hold CR, LF, NUL or other control
// bytes (the URL no spaces either), or Do fails instead of sending a request an input could
// have split. Response bodies over DefaultMaxBody fail; DoWith sets a timeout and the limit.
func Do(method str, url str, headers []str, body str) !Resp {
	return try DoWith(method, url, headers, body, Options{Timeout: 0, MaxBody: 0})
}

// DoWith is Do with options: an overall timeout and a response size limit.
func DoWith(method str, url str, headers []str, body str, opt Options) !Resp {
	limit := opt.MaxBody
	if limit <= 0 {
		limit = DefaultMaxBody
	}
	until := 0
	if opt.Timeout > 0 {
		until = rt_mono_ns() + opt.Timeout
	}
	if !is_token(method) {
		fail say.Fault("wire: invalid method %q", method)
	}
	for i := 0; i < len(url); i++ {
		if url[i] <= ' ' || url[i] == 0x7f {
			fail say.Fault("wire: invalid character in URL %q", url)
		}
	}
	if len(headers)%2 != 0 {
		fail "wire: headers must be name, value pairs"
	}
	for i := 0; i+1 < len(headers); i += 2 {
		if !is_token(headers[i]) {
			fail say.Fault("wire: invalid header name %q", headers[i])
		}
		v := headers[i+1]
		for k := 0; k < len(v); k++ {
			if v[k] == '\r' || v[k] == '\n' || v[k] == 0 {
				fail say.Fault("wire: invalid header value for %s", headers[i])
			}
		}
	}
	if len(url) < 7 || url[:7] != "http://" {
		if len(url) >= 8 && url[:8] == "https://" {
			fail "wire: https is not supported yet"
		}
		fail say.Fault("wire: %q is not an http:// URL", url)
	}
	rest := url[7:]
	slash := len(rest)
	for i := 0; i < len(rest); i++ {
		if rest[i] == '/' || rest[i] == '?' {
			slash = i
			break
		}
	}
	hostport := rest[:slash]
	path := "/"
	if slash < len(rest) {
		path = rest[slash:]
		if path[0] == '?' {
			path = "/" + path
		}
	}
	addr := hostport
	hasport := false
	for i := 0; i < len(hostport); i++ {
		if hostport[i] == ':' {
			hasport = true
		}
	}
	if !hasport {
		addr = hostport + ":80"
	}
	c := try DialTimeout(addr, opt.Timeout)
	defer c.Close()
	c.until = until
	req := make([]u8, 0, 256+len(body))
	req = append(req, method...)
	req = append(req, ' ')
	req = append(req, path...)
	req = append(req, " HTTP/1.1\r\nHost: "...)
	req = append(req, hostport...)
	req = append(req, "\r\nUser-Agent: tin-wire\r\nConnection: close\r\n"...)
	for i := 0; i+1 < len(headers); i += 2 {
		req = append(req, headers[i]...)
		req = append(req, ": "...)
		req = append(req, headers[i+1]...)
		req = append(req, "\r\n"...)
	}
	if len(body) > 0 || method == "POST" || method == "PUT" {
		req = append(req, "Content-Length: "...)
		req = append(req, say.Str(len(body))...)
		req = append(req, "\r\n"...)
	}
	req = append(req, "\r\n"...)
	req = append(req, body...)
	try c.WriteBytes(req)
	r, err := read_response(c, method == "HEAD", limit)
	if err != nil {
		fail err
	}
	return r
}

// is_token reports whether s is an HTTP token (a method or header name, RFC 9110 5.6.2).
func is_token(s str) bool {
	if len(s) == 0 {
		return false
	}
	for i := 0; i < len(s); i++ {
		c := s[i]
		if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') {
			continue
		}
		ok := false
		t := "!#$%&'*+-.^_`|~"
		for j := 0; j < len(t); j++ {
			if t[j] == c {
				ok = true
				break
			}
		}
		if !ok {
			return false
		}
	}
	return true
}

func find_crlf2(b []u8) i64 {
	for i := 3; i < len(b); i++ {
		if b[i] == '\n' && b[i-1] == '\r' && b[i-2] == '\n' && b[i-3] == '\r' {
			return i + 1
		}
	}
	return -1
}

// read_head reads until buf holds a complete header block and returns its length.
func read_head(c Conn, buf mut []u8) !i64 {
	hend := find_crlf2(buf)
	for hend < 0 {
		if len(buf) > 1048576 {
			fail "wire: response headers too large"
		}
		_, err := c.Read(mut buf, 4096)
		if err != nil {
			if IsEOF(err) {
				fail "wire: connection closed before the response headers"
			}
			if err != nil {
				fail err
			}
			return 0
		}
		hend = find_crlf2(buf)
	}
	return hend
}

// maxInformational bounds the 1xx responses accepted before the final one (as Go does).
const maxInformational = 5

func read_response(c Conn, head bool, limit i64) !Resp {
	buf := make([]u8, 0, 4096)
	informational := 0
	for {
		hend := try read_head(c, mut buf)
		h := str(buf[:hend])
		if len(h) < 12 || h[:5] != "HTTP/" {
			fail "wire: malformed response"
		}
		status := 0
		for i := 9; i < 12; i++ {
			d := h[i]
			if d < '0' || d > '9' {
				fail "wire: malformed status line"
			}
			status = status*10 + i64(d-'0')
		}
		r := Resp{Status: status, Body: "", head: h}
		rest := buf[hend:]
		// A 1xx other than 101 precedes the final response: drop it and keep the bytes after it.
		if status >= 100 && status < 200 && status != 101 {
			informational++
			if informational > maxInformational {
				fail "wire: too many informational responses"
			}
			next := make([]u8, 0, len(rest)+4096)
			next = append(next, rest...)
			buf = next
			continue
		}
		// wire never asks for an upgrade, so a 101 is returned as the final response without a body.
		if head || status == 204 || status == 304 || status == 101 {
			return r
		}
		chunked, err0 := transfer_coding(r)
		if err0 != nil {
			fail err0
		}
		n, err := content_length(r)
		if err != nil {
			fail err
		}
		if chunked && n >= 0 {
			// Both framings at once is how responses get desynchronized: refuse it (RFC 9112 6.3).
			fail "wire: both Transfer-Encoding and Content-Length"
		}
		if chunked {
			b := try read_chunked(c, rest, limit)
			r.Body = b
			return r
		}
		if n > limit {
			fail say.Fault("wire: response body of %d bytes is over the %d-byte limit", n, limit)
		}
		if n >= 0 {
			b := try read_length(c, rest, n)
			r.Body = b
			return r
		}
		body2 := make([]u8, 0, 4096)
		body2 = append(body2, rest...)
		for {
			if len(body2) > limit {
				fail say.Fault("wire: response body is over the %d-byte limit", limit)
			}
			_, err := c.Read(mut body2, 65536)
			if err != nil {
				if IsEOF(err) {
					break
				}
				if err != nil {
					fail err
				}
				return none_resp()
			}
		}
		r.Body = str(body2)
		return r
	}
}

// transfer_coding reports whether the response is chunked. Transfer-Encoding headers form one
// comma-separated list of codings (case-insensitive, blanks ignored); wire decodes only
// chunked, so a list that is not exactly "chunked" is a fault rather than raw bytes.
func transfer_coding(r Resp) !bool {
	seen := false
	codings := 0
	h := r.head
	i := 0
	for i < len(h) {
		j := i
		for j < len(h) && h[j] != '\n' {
			j++
		}
		line := h[i:j]
		i = j + 1
		if len(line) > 0 && line[len(line)-1] == '\r' {
			line = line[:len(line)-1]
		}
		if len(line) <= 17 || line[17] != ':' || !fold_eq(line[:17], "transfer-encoding") {
			continue
		}
		seen = true
		v := line[18:]
		k := 0
		for k <= len(v) {
			e := k
			for e < len(v) && v[e] != ',' {
				e++
			}
			a := k
			b := e
			for a < b && (v[a] == ' ' || v[a] == '\t') {
				a++
			}
			for b > a && (v[b-1] == ' ' || v[b-1] == '\t') {
				b--
			}
			if b > a {
				c := v[a:b]
				semi := 0
				for semi < len(c) && c[semi] != ';' {
					semi++
				}
				name := c[:semi]
				if !fold_eq(name, "chunked") || semi < len(c) {
					fail say.Fmt("wire: unsupported Transfer-Encoding %q", c)
				}
				codings++
			}
			k = e + 1
		}
	}
	if !seen {
		return false
	}
	if codings == 0 {
		fail "wire: empty Transfer-Encoding"
	}
	if codings > 1 {
		fail "wire: chunked applied more than once"
	}
	return true
}

// maxBodyLen bounds a Content-Length (1 TiB): larger values are refused, not trusted.
const maxBodyLen = 1099511627776

// content_length is the response's Content-Length: -1 when there is none. Repeated headers
// must agree; anything but plain decimal digits (lists included) is a fault.
func content_length(r Resp) !i64 {
	n := -1
	h := r.head
	i := 0
	for i < len(h) {
		j := i
		for j < len(h) && h[j] != '\n' {
			j++
		}
		line := h[i:j]
		i = j + 1
		if len(line) > 0 && line[len(line)-1] == '\r' {
			line = line[:len(line)-1]
		}
		if len(line) <= 14 || line[14] != ':' || !fold_eq(line[:14], "content-length") {
			continue
		}
		v := line[15:]
		a := 0
		for a < len(v) && (v[a] == ' ' || v[a] == '\t') {
			a++
		}
		e := len(v)
		for e > a && (v[e-1] == ' ' || v[e-1] == '\t') {
			e--
		}
		if e == a || e-a > 13 {
			fail "wire: bad Content-Length"
		}
		x := 0
		for k := a; k < e; k++ {
			d := v[k]
			if d < '0' || d > '9' {
				fail "wire: bad Content-Length"
			}
			x = x*10 + i64(d-'0')
		}
		if x > maxBodyLen {
			fail "wire: Content-Length too large"
		}
		if n >= 0 && x != n {
			fail "wire: conflicting Content-Length headers"
		}
		n = x
	}
	return n
}

// read_length reads an n-byte body after the pending bytes, growing the buffer as data arrives
// instead of reserving the announced size up front.
func read_length(c Conn, pending []u8, n i64) !str {
	start := n
	if start > 65536 {
		start = 65536
	}
	body := make([]u8, 0, start)
	body = append(body, pending...)
	for len(body) < n {
		want := n - len(body)
		if want > 65536 {
			want = 65536
		}
		_, err := c.Read(mut body, want)
		if err != nil {
			if IsEOF(err) {
				fail "wire: response body truncated"
			}
			if err != nil {
				fail err
			}
			return ""
		}
	}
	return str(body[:n])
}

// maxChunkLine bounds a chunk-size or trailer line, maxTrailers the whole trailer section.
const maxChunkLine = 4096
const maxTrailers = 1048576

// chunk_fault names a connection that ends inside a chunked body.
func chunk_fault(err fault) ! {
	if IsEOF(err) {
		fail "wire: chunked body truncated"
	}
	if err != nil {
		fail err
	}
}

// chunk_line reads until buf holds a CRLF-terminated line at pos and returns the index of its CR.
func chunk_line(c Conn, buf mut []u8, pos i64) !i64 {
	scan := pos
	for {
		for i := scan; i < len(buf); i++ {
			if buf[i] == '\n' {
				if i == pos || buf[i-1] != '\r' {
					fail "wire: malformed chunked body: line not ended by CRLF"
				}
				return i - 1
			}
		}
		scan = len(buf)
		if len(buf)-pos > maxChunkLine {
			fail "wire: malformed chunked body: line too long"
		}
		_, err := c.Read(mut buf, 4096)
		if err != nil {
			fail chunk_fault(err)
		}
	}
}

// visible reports whether buf[from:to] has no control characters other than tab.
func visible(buf []u8, from i64, to i64) bool {
	for i := from; i < to; i++ {
		d := buf[i]
		if (d < ' ' && d != '\t') || d == 127 {
			return false
		}
	}
	return true
}

// chunk_size parses buf[pos:end]: one or more hex digits, then optional ";" extensions.
func chunk_size(buf []u8, pos i64, end i64) !i64 {
	size := 0
	i := pos
	for i < end {
		d := buf[i]
		v := -1
		if d >= '0' && d <= '9' {
			v = i64(d - '0')
		} else if d >= 'a' && d <= 'f' {
			v = i64(d-'a') + 10
		} else if d >= 'A' && d <= 'F' {
			v = i64(d-'A') + 10
		}
		if v < 0 {
			break
		}
		if size >= 0x0800000000000000 {
			fail "wire: malformed chunked body: chunk size too large"
		}
		size = size*16 + v
		i++
	}
	if i == pos {
		fail "wire: malformed chunked body: bad chunk size"
	}
	for i < end && (buf[i] == ' ' || buf[i] == '\t') {
		i++
	}
	if i < end && (buf[i] != ';' || !visible(buf, i, end)) {
		fail "wire: malformed chunked body: bad chunk size"
	}
	return size
}

// chunk_trailers reads the trailer fields after the last chunk up to the empty line; they are ignored.
func chunk_trailers(c Conn, buf mut []u8, pos i64) ! {
	start := pos
	for {
		end := try chunk_line(c, mut buf, pos)
		if end == pos {
			return
		}
		colon := -1
		for i := pos; i < end; i++ {
			if buf[i] == ':' {
				colon = i
				break
			}
		}
		if colon <= pos || buf[pos] == ' ' || buf[pos] == '\t' || !visible(buf, pos, end) {
			fail "wire: malformed chunked body: bad trailer"
		}
		pos = end + 2
		if pos-start > maxTrailers {
			fail "wire: malformed chunked body: trailers too large"
		}
	}
}

// read_chunked decodes a chunked body; pending holds bytes already read.
func read_chunked(c Conn, pending []u8, limit i64) !str {
	buf := make([]u8, 0, len(pending)+4096)
	buf = append(buf, pending...)
	out := make([]u8, 0, 4096)
	pos := 0
	for {
		end := try chunk_line(c, mut buf, pos)
		size := try chunk_size(buf, pos, end)
		pos = end + 2
		if size == 0 {
			try chunk_trailers(c, mut buf, pos)
			return str(out)
		}
		if size > limit-len(out) {
			fail say.Fault("wire: response body is over the %d-byte limit", limit)
		}
		// Read at most 64 KiB at a time so the buffer grows only as data arrives.
		for len(buf)-pos < size+2 {
			want := size + 2 - (len(buf) - pos)
			if want > 65536 {
				want = 65536
			}
			_, err := c.Read(mut buf, want)
			if err != nil {
				fail chunk_fault(err)
			}
		}
		if buf[pos+size] != '\r' || buf[pos+size+1] != '\n' {
			fail "wire: malformed chunked body: chunk data not ended by CRLF"
		}
		out = append(out, buf[pos:pos+size]...)
		pos += size + 2
	}
}

// Header returns the response header name (any case), or "".
func (r Resp) Header(name str) str {
	h := r.head
	i := 0
	for i < len(h) {
		j := i
		for j < len(h) && h[j] != '\n' {
			j++
		}
		line := h[i:j]
		if len(line) > 0 && line[len(line)-1] == '\r' {
			line = line[:len(line)-1]
		}
		if len(line) > len(name) && line[len(name)] == ':' && fold_eq(line[:len(name)], name) {
			v := line[len(name)+1:]
			k := 0
			for k < len(v) && (v[k] == ' ' || v[k] == '\t') {
				k++
			}
			return v[k:]
		}
		i = j + 1
	}
	return ""
}

func fold_eq(a str, b str) bool {
	if len(a) != len(b) {
		return false
	}
	for i := 0; i < len(a); i++ {
		x := a[i]
		y := b[i]
		if x >= 'A' && x <= 'Z' {
			x += 32
		}
		if y >= 'A' && y <= 'Z' {
			y += 32
		}
		if x != y {
			return false
		}
	}
	return true
}
