// Package wire is TCP networking and an HTTP client: HTTP/1.1, and HTTP/2 to servers that choose
// it by ALPN or with Options.H2C (#480). Calls inside a request wait without blocking the core;
// every connection can carry a read/write timeout.
//
//	let c = try wire.Dial("127.0.0.1:6379")
//	try c.Write("PING\r\n")
//	let r = try wire.Get("http://127.0.0.1:8080/json")
package wire

import "say"
import "seal"
import "tls"


// Conn is a TCP connection.
type Conn struct {
	open    bool // false for the zero Conn (a failed Dial or Accept): it owns no descriptor
	fd      i64
	timeout i64  // ns a read or write may wait (0: no limit; a request's deadline still applies)
	until   i64  // monotonic ns after which every wait fails (0: none); set by DoWith's Timeout
	tn      i64  // its number in a recorded or replayed request (wire.dial@1, #241), 0: none
}

// Listener accepts TCP connections.
type Listener struct {
	open bool // false for the zero Listener (a failed Listen)
	fd   i64
	port i64
}

// Resp is an HTTP response.
type Resp struct {
	Status i64
	Body   str
	head   str
	trail  str // the trailers of an HTTP/2 response (#480), as header lines
}

fn errno() i64 {
	return rt_errno()
}

fn os_fault(what str) ! {
	let m = rt_sys_strerror(errno())
	fail say.Fault("wire: %s: %s", what, rt_str_from_raw(m, strlen(m)))
}

// EOF is the fault Read returns at the end of the stream.
fn IsEOF(err fault) bool {
	return err != nil && say.Str(err) == "EOF"
}

// split_addr cuts "host:port" (host may be empty).
fn split_addr(addr str) !(str, i64) {
	mut colon = -1
	for i in 0..len(addr) {
		if addr[i] == ':' {
			colon = i
		}
	}
	if colon < 0 || colon == len(addr)-1 {
		fail say.Fault("wire: address %q needs a port", addr)
	}
	mut port = 0
	for i in colon + 1..len(addr) {
		let c = addr[i]
		if c < '0' || c > '9' || port > 65535 {
			fail say.Fault("wire: bad port in %q", addr)
		}
		port = port*10 + i64(c-'0')
	}
	if port > 65535 {
		fail say.Fault("wire: bad port in %q", addr)
	}
	return addr[:colon], port
}

// wait_io waits until fd is ready for a read (want 1) or write (2), within timeout ns.
fn wait_io(fd i64, want i64, timeout i64, what str) ! {
	let r = rt_task_wait(fd, want, timeout)
	if r == waitDeadline {
		fail cast(fault, rt_wait_fault())
	}
	if r == waitTimeout {
		fail "wire: {what} timed out"
	}
}

// wait is wait_io for c: the per-wait timeout, cut short by the call's overall limit.
fn (c Conn) wait(want i64, what str) ! {
	mut t = c.timeout
	if c.until > 0 {
		let left = c.until - rt_mono_ns()
		if left <= 0 {
			fail "wire: {what} timed out"
		}
		if t == 0 || left < t {
			t = left
		}
	}
	try wait_io(c.fd, want, t, what)
}

fn nonblocking(fd i64) {
	let flags = i64(i32(rt_sys_fcntl(fd, F_GETFL, 0)))
	rt_sys_fcntl(fd, F_SETFL, flags|O_NONBLOCK)
}

// Dial connects to "host:port".
fn Dial(addr str) !Conn {
	return try DialTimeout(addr, 0)
}

// DialTimeout connects to "host:port", giving up after timeout nanoseconds (0: no limit).
fn DialTimeout(addr str, timeout i64) !Conn {
	let tp = rt_tape()
	if tp != 0 {
		return try dial_taped(tp, addr, timeout)
	}
	let none = Conn{fd: -1}
	let (host, port, err) = split_addr(addr)
	if err != nil {
		fail err
	}
	let sa = calloc(1, 32)
	defer free(sa)
	mut until = i64(0)
	if timeout > 0 { until = rt_mono_ns()+timeout }
	let e2 = resolve(host, port, sa, until)
	if e2 != nil {
		fail e2
	}
	let fd = i64(i32(rt_sys_socket(rt_sockaddr_family(sa), 1, 0)))
	if fd < 0 {
		fail os_fault("socket")
	}
	let one = calloc(1, 8)
	one[0] = 1
	rt_nosigpipe(fd)
	rt_sys_setsockopt(fd, 6, 1, one, 4)
	free(one)
	// Sockets are non-blocking: inside a request task a wait lets the core serve others.
	nonblocking(fd)
	if i64(i32(rt_sys_connect(fd, sa, rt_sockaddr_len(sa)))) < 0 {
		if errno() != EINPROGRESS {
			let f2 = os_fault(say.Fmt("connect %s", addr))
			rt_sys_close(fd)
			if f2 != nil {
				fail f2
			}
			return none
		}
		mut left = timeout
		if until > 0 {
			left = until-rt_mono_ns()
			if left <= 0 { rt_sys_close(fd)
 fail "wire: connect {addr} timed out" }
		}
		let werr = wait_io(fd, 2, left, "connect " + addr)
		if werr != nil {
			rt_sys_close(fd)
			fail werr
		}
		let soerr = calloc(1, 8)
		let ln = calloc(1, 8)
		ln[0] = 4
		rt_sys_getsockopt(fd, SOL_SOCKET, SO_ERROR, soerr, ln)
		let code = i64(i32(soerr[0]))
		free(soerr)
		free(ln)
		if code != 0 {
			let m = rt_sys_strerror(code)
			rt_sys_close(fd)
			fail say.Fault("wire: connect %s: %s", addr, rt_str_from_raw(m, strlen(m)))
		}
	}
	return Conn{open: true, fd: fd, timeout: 0}
}

// Fd is the connection's descriptor, for clients that do their own I/O on it (it stays
// non-blocking; Close still closes it).
fn (c Conn) Fd() i64 {
	return c.fd
}

// SetTimeout limits every later read and write to ns nanoseconds (0: no limit).
fn (c mut Conn) SetTimeout(ns i64) {
	c.timeout = ns
}

// SetNoDelay turns Nagle's algorithm off (true) or on.
fn (c Conn) SetNoDelay(on bool) {
	let v = calloc(1, 8)
	if on {
		v[0] = 1
	}
	rt_sys_setsockopt(c.fd, 6, 1, v, 4)
	free(v)
}

// WriteRaw sends n bytes at p.
fn (c Conn) write_raw(p i64, n i64) ! {
	if !c.open {
		fail "wire: write on a closed connection"
	}
	if c.tn != 0 {
		let tp = rt_tape()
		if tp != 0 {
			return try c.write_taped(tp, p, n)
		}
	}
	for n > 0 {
		let k = rt_sys_write(c.fd, p, n)
		if k < 0 {
			let e = errno()
			if e == 4 {
				continue
			}
			if e == EAGAIN {
				try c.wait(2, "write")
				continue
			}
			fail os_fault("write")
		}
		p += k
		n -= k
	}
}

// Write sends all of s.
fn (c Conn) Write(s str) ! {
	return try c.write_raw(cast(i64, s)+8, len(s))
}

// WriteBytes sends all of b.
fn (c Conn) WriteBytes(b []u8) ! {
	return try c.write_raw(cast(i64, b)[2], len(b))
}

// Read appends up to max bytes to buf and returns how many; at the end it returns 0 and EOF.
fn (c Conn) Read(buf mut []u8, max i64) !i64 {
	if !c.open {
		fail "wire: read on a closed connection"
	}
	if c.tn != 0 {
		let tp = rt_tape()
		if tp != 0 {
			return try c.read_taped(tp, mut buf, max)
		}
	}
	let h = cast(i64, buf)
	if h[0]+max > h[1] {
		rt_slice_grow(h, h[0]+max, 1)
	}
	for {
		let k = rt_sys_read(c.fd, h[2]+h[0], max)
		if k > 0 {
			h[0] += k
			return k
		}
		if k == 0 {
			fail "EOF"
		}
		let e = errno()
		if e == 4 {
			continue
		}
		if e == EAGAIN {
			try c.wait(1, "read")
			continue
		}
		fail os_fault("read")
	}
}

// ReadFull reads exactly n bytes.
fn (c Conn) ReadFull(n i64) !str {
	let b = make([]u8, 0, n)
	for len(b) < n {
		let (_, err) = c.Read(mut b, n-len(b))
		if err != nil {
			fail err
		}
	}
	return str(b)
}

// Close closes the connection.
fn (c mut Conn) Close() {
	if c.open {
		if c.fd >= 0 {
			rt_sys_close(c.fd)
		}
		c.open = false
	}
}

// Listen opens a TCP listener on "host:port" (":0" picks a free port: see Port).
fn Listen(addr str) !Listener {
	let none = Listener{fd: -1}
	let (host, port, err) = split_addr(addr)
	if err != nil {
		fail err
	}
	let sa = calloc(1, 32)
	defer free(sa)
	let e2 = resolve(host, port, sa, 0)
	if e2 != nil {
		fail e2
	}
	let fd = i64(i32(rt_sys_socket(rt_sockaddr_family(sa), 1, 0)))
	if fd < 0 {
		fail os_fault("socket")
	}
	let one = calloc(1, 8)
	one[0] = 1
	rt_sys_setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, one, 4)
	free(one)
	if i64(i32(rt_sys_bind(fd, sa, rt_sockaddr_len(sa)))) < 0 {
		let f = os_fault(say.Fmt("bind %s", addr))
		rt_sys_close(fd)
		if f != nil {
			fail f
		}
		return none
	}
	if i64(i32(rt_sys_listen(fd, 1024))) < 0 {
		let f2 = os_fault("listen")
		rt_sys_close(fd)
		if f2 != nil {
			fail f2
		}
		return none
	}
	let ln = calloc(1, 8)
	ln[0] = 32
	rt_sys_getsockname(fd, sa, ln)
	free(ln)
	nonblocking(fd)
	return Listener{open: true, fd: fd, port: i64(load8(sa+2))<<8 | i64(load8(sa+3))}
}

// Port is the port the listener is bound to.
fn (l Listener) Port() i64 {
	return l.port
}

// Accept waits for the next connection.
fn (l Listener) Accept() !Conn {
	if !l.open {
		fail "wire: accept on a closed listener"
	}
	for {
		let fd = i64(i32(rt_sys_accept(l.fd, 0, 0)))
		if fd >= 0 {
			let one = calloc(1, 8)
			one[0] = 1
			rt_nosigpipe(fd)
			rt_sys_setsockopt(fd, 6, 1, one, 4)
			free(one)
			nonblocking(fd)
			return Conn{open: true, fd: fd, timeout: 0}
		}
		let e = errno()
		if e == EAGAIN {
			try wait_io(l.fd, 1, 0, "accept")
			continue
		}
		if e != 4 {
			fail os_fault("accept")
		}
	}
}

// AcceptTimeout waits at most timeout ns for the next connection (0: no limit), failing with a
// fault that says "timed out" when none came.
fn (l Listener) AcceptTimeout(timeout i64) !Conn {
	if !l.open {
		fail "wire: accept on a closed listener"
	}
	let until = rt_mono_ns() + timeout
	for {
		let fd = i64(i32(rt_sys_accept(l.fd, 0, 0)))
		if fd >= 0 {
			let one = calloc(1, 8)
			one[0] = 1
			rt_nosigpipe(fd)
			rt_sys_setsockopt(fd, 6, 1, one, 4)
			free(one)
			nonblocking(fd)
			return Conn{open: true, fd: fd, timeout: 0}
		}
		let e = errno()
		if e == EAGAIN {
			mut left = 0
			if timeout > 0 {
				left = until - rt_mono_ns()
				if left <= 0 {
					fail "wire: accept timed out"
				}
			}
			try wait_io(l.fd, 1, left, "accept")
			continue
		}
		if e != 4 {
			fail os_fault("accept")
		}
	}
}

// Close stops listening.
fn (l mut Listener) Close() {
	if l.open {
		rt_sys_close(l.fd)
		l.open = false
	}
}

// ---- HTTP client ----

// Options configure one client call (DoWith); the zero value is what Do uses.
type Options struct {
	Timeout i64         // ns for the whole call: connect, send and the complete response (0: no limit; a request's deadline still applies)
	MaxBody i64         // largest response body accepted, in bytes (0: DefaultMaxBody)
	TLS     ?tls.Config // for https://: roots, ALPN (default h2 then http/1.1; a server that picks another protocol is refused), InsecureSkipVerify (nil: verify against the system's roots); the server name is the URL's host
	MaxIdle i64         // idle keep-alive connections kept per core and host after a call (0: 8; negative: none, every call dials and sends Connection: close)
	NoH2    bool        // speak HTTP/1.1 only: https:// offers no h2 (#480)
	H2C     bool        // http:// speaks HTTP/2 by prior knowledge (h2c), as gRPC servers expect (#480)
}

// DefaultMaxIdle is how many idle connections per host (and core) DoWith keeps when Options.MaxIdle is 0.
const DefaultMaxIdle = 8

// DefaultMaxBody is the largest response body Do accepts (64 MiB, anvil's request limit):
// a larger one is a fault rather than memory a broken or hostile server can fill.
const DefaultMaxBody = 67108864

// Get fetches url.
fn Get(url str) !Resp {
	return try Do("GET", url, []str{}, "")
}

// Post sends body with content type ctype to url.
fn Post(url str, ctype str, body str) !Resp {
	return try Do("POST", url, []str{"Content-Type", ctype}, body)
}

fn none_resp() Resp {
	return Resp{Body: "", head: "", trail: ""}
}

// Do sends one request: headers is a list of name, value pairs. The method and header names
// must be tokens, and the URL and header values must not hold CR, LF, NUL or other control
// bytes (the URL no spaces either), or Do fails instead of sending a request an input could
// have split. Response bodies over DefaultMaxBody fail; DoWith sets a timeout and the limit.
//
// Connections are kept alive: after a response that ends cleanly (HTTP/1.1, framed by a length
// or chunks, no "Connection: close") the connection waits in a per-core pool, by scheme, host
// and port (and TLS settings), and the next call to that host uses it instead of dialing and,
// for https, doing a TLS handshake. A kept connection is checked before it is used, dropped after
// 30 s idle, and at most Options.MaxIdle are kept per host. One the server closed meanwhile is
// replaced by a new connection without the caller seeing it, for a GET, HEAD, PUT, DELETE,
// OPTIONS or TRACE; any other method (a POST) fails instead of being sent twice.
fn Do(method str, url str, headers []str, body str) !Resp {
	return try DoWith(method, url, headers, body, Options{Timeout: 0, MaxBody: 0, MaxIdle: 0})
}

// DoWith is Do with options: an overall timeout and a response size limit.
fn DoWith(method str, url str, headers []str, body str, opt Options) !Resp {
	let tp = rt_tape()
	if tp != 0 {
		return try http_taped(tp, method, url, headers, body, opt)
	}
	mut limit_ = opt.MaxBody
	if limit_ <= 0 {
		limit_ = DefaultMaxBody
	}
	mut until = 0
	if opt.Timeout > 0 {
		until = rt_mono_ns() + opt.Timeout
	}
	if !is_token(method) {
		fail say.Fault("wire: invalid method %q", method)
	}
	for i in 0..len(url) {
		if url[i] <= ' ' || url[i] == 0x7f {
			fail say.Fault("wire: invalid character in URL %q", url)
		}
	}
	if len(headers)%2 != 0 {
		fail "wire: headers must be name, value pairs"
	}
	{
		mut i = 0
		for i+1 < len(headers) {
			if !is_token(headers[i]) {
				fail say.Fault("wire: invalid header name %q", headers[i])
			}
			let v = headers[i+1]
			for k in 0..len(v) {
				if v[k] == '\r' || v[k] == '\n' || v[k] == 0 {
					fail say.Fault("wire: invalid header value for %s", headers[i])
				}
			}
			i += 2
		}
	}
	let secure = len(url) >= 8 && url[:8] == "https://"
	if !secure && (len(url) < 7 || url[:7] != "http://") {
		fail say.Fault("wire: %q is not an http:// or https:// URL", url)
	}
	mut rest = url[7:]
	if secure {
		rest = url[8:]
	}
	mut slash = len(rest)
	for i in 0..len(rest) {
		if rest[i] == '/' || rest[i] == '?' {
			slash = i
			break
		}
	}
	let hostport = rest[:slash]
	mut path = "/"
	if slash < len(rest) {
		path = rest[slash:]
		if path[0] == '?' {
			path = "/" + path
		}
	}
	mut addr = hostport
	mut hasport = false
	mut brackets = len(hostport) > 0 && hostport[0] == '['
	for i in 0..len(hostport) {
		if hostport[i] == ']' { brackets=false }
		if hostport[i] == ':' && !brackets { hasport=true }
	}
	if !hasport {
		addr = hostport + ":80"
		if secure {
			addr = hostport + ":443"
		}
	}
	mut req = make([]u8, 0, 256+len(body))
	req = append(req, method...)
	req = append(req, ' ')
	req = append(req, path...)
	req = append(req, " HTTP/1.1\r\nHost: "...)
	req = append(req, hostport...)
	req = append(req, "\r\nUser-Agent: tin-wire\r\n"...)
	mut maxIdle = opt.MaxIdle
	if maxIdle == 0 {
		maxIdle = DefaultMaxIdle
	}
	mut closes = maxIdle < 0
	{
		mut i = 0
		for i+1 < len(headers) {
			if fold_eq(headers[i], "Connection") {
				closes = true // the caller decides: the connection is not kept
			}
			i += 2
		}
	}
	if maxIdle < 0 {
		req = append(req, "Connection: close\r\n"...)
	}
	{
		mut i = 0
		for i+1 < len(headers) {
			req = append(req, headers[i]...)
			req = append(req, ": "...)
			req = append(req, headers[i+1]...)
			req = append(req, "\r\n"...)
			i += 2
		}
	}
	if len(body) > 0 || method == "POST" || method == "PUT" {
		req = append(req, "Content-Length: "...)
		req = append(req, say.Str(len(body))...)
		req = append(req, "\r\n"...)
	}
	req = append(req, "\r\n"...)
	req = append(req, body...)
	if closes {
		maxIdle = -1
	}
	mut scheme = "http"
	if secure {
		scheme = "https"
	}
	let k = call{addr: addr, hostport: hostport, key: pool_key(secure, hostport, opt), req: req, head: method == "HEAD", limit_: limit_, until: until, timeout: opt.Timeout, maxIdle: maxIdle, idem: method == "GET" || method == "HEAD" || method == "PUT" || method == "DELETE" || method == "OPTIONS" || method == "TRACE",
		method: method, scheme: scheme, path: path, headers: headers, body: body, noH2: opt.NoH2, h2c: opt.H2C}
	// A kept connection the server closed meanwhile fails before any response byte: once, for a
	// request that may be repeated, the call goes to a fresh connection.
	staleRetry = false
	if secure {
		let (r, err) = attempt_tls(k, opt, true)
		if err != nil && staleRetry {
			return try attempt_tls(k, opt, false)
		}
		if err != nil {
			fail err
		}
		return r
	}
	let (r, err) = attempt_plain(k, true)
	if err != nil && staleRetry {
		return try attempt_plain(k, false)
	}
	if err != nil {
		fail err
	}
	return r
}

// call is one DoWith call, ready to send: as HTTP/1.1 bytes (req), and in parts for HTTP/2.
type call struct {
	addr     str
	hostport str
	key      str
	req      []u8
	head     bool
	limit_   i64
	until    i64
	timeout  i64
	maxIdle  i64
	idem     bool
	method   str
	scheme   str
	path     str
	headers  []str
	body     str
	noH2     bool
	h2c      bool
}

// attempt_plain makes one http:// exchange, on a kept connection to the key when allowed (usePool)
// and there is one, else on a new one. A connection is kept again when the response ends cleanly.
fn attempt_plain(k call, usePool bool) !Resp {
	if k.h2c {
		// HTTP/2 by prior knowledge (#480).
		if usePool {
			let g = h2_usable(k.key)
			if g != 0 {
				return try h2_attempt(g, k)
			}
		}
		let nc = try DialTimeout(k.addr, k.timeout)
		return try h2_attempt(h2_new(k.key, nc.fd, nil), k)
	}
	mut c = Conn{open: false, fd: -1}
	mut reused = false
	if usePool && k.maxIdle >= 0 {
		let fd = pool_take(k.key, false)
		if fd >= 0 {
			c = Conn{open: true, fd: fd, timeout: 0}
			reused = true
		}
	}
	if !reused {
		c = try DialTimeout(k.addr, k.timeout)
	}
	c.until = k.until
	respSeen = false
	respReuse = false
	let werr = c.WriteBytes(k.req)
	if werr != nil {
		c.Close()
		staleRetry = reused && k.idem
		fail werr
	}
	let (r, err) = read_response(mut c, k.head, k.limit_)
	if err != nil {
		c.Close()
		staleRetry = reused && k.idem && !respSeen
		fail err
	}
	if respReuse && k.maxIdle >= 0 && pool_put(k.key, c.fd, nil, k.maxIdle) {
		return r
	}
	c.Close()
	return r
}

// attempt_tls is attempt_plain for https://: a kept connection keeps its TLS session.
fn attempt_tls(k call, opt Options, usePool bool) !Resp {
	if usePool && !k.noH2 {
		// A connection that speaks HTTP/2 to this origin takes the call as a stream (#480).
		let g = h2_usable(k.key)
		if g != 0 {
			return try h2_attempt(g, k)
		}
	}
	if usePool && k.maxIdle >= 0 {
		let kept = pool_take_tls(k.key)
		if kept != nil {
			return try exchange_tls(mut kept, k, true)
		}
	}
	// ALPN offers h2 (#480), then http/1.1 (#478): some servers and gateways refuse a client that
	// offers none.
	mut alpn = []str{"h2", "http/1.1"}
	if k.noH2 {
		alpn = []str{"http/1.1"}
	}
	let cfg = tls.Config{ServerName: "", RootCAs: "", ALPN: alpn, Timeout: opt.Timeout, InsecureSkipVerify: false}
	let given = opt.TLS
	if given != nil {
		cfg.RootCAs = given.RootCAs
		if len(given.ALPN) > 0 {
			cfg.ALPN = given.ALPN
		}
		cfg.InsecureSkipVerify = given.InsecureSkipVerify
		cfg.Certificate = given.Certificate // a client certificate (mutual TLS, #475)
		cfg.Key = given.Key
		cfg.MinVersion = given.MinVersion
	}
	cfg.ServerName = tls_host(k.hostport)
	let tc = try tls.Dial(k.addr, cfg)
	if tc.ALPN() == "h2" && !k.noH2 {
		return try h2_attempt(h2_new(k.key, tc.Fd(), tc), k)
	}
	if tc.ALPN() != "" && tc.ALPN() != "http/1.1" {
		tc.Close()
		fail say.Fault("wire: the server chose %q by ALPN; wire speaks HTTP/1.1 and h2", tc.ALPN())
	}
	return try exchange_tls(mut tc, k, false)
}

fn exchange_tls(tc mut tls.Conn, k call, reused bool) !Resp {
	tc.SetDeadline(k.until)
	respSeen = false
	respReuse = false
	let werr = tc.WriteBytes(k.req)
	if werr != nil {
		tc.Close()
		staleRetry = reused && k.idem
		fail werr
	}
	let (r, err) = read_response(mut tc, k.head, k.limit_)
	if err != nil {
		tc.Close()
		staleRetry = reused && k.idem && !respSeen
		fail err
	}
	if respReuse && k.maxIdle >= 0 && tc.Buffered() == 0 && pool_put(k.key, tc.Fd(), tc, k.maxIdle) {
		return r
	}
	tc.Close()
	return r
}

// ---- keep-alive connections (#348) ----
//
// DoWith keeps a connection that ended a response cleanly (HTTP/1.1, framed by Content-Length or
// chunks, no "Connection: close", nothing left in the buffer) in a per-core pool, by scheme, host
// and TLS settings, and sends the next call to the same host on it: no TCP or TLS handshake, no
// TIME_WAIT socket per call. A kept connection is checked before it is used (a peek for a closed
// peer), dropped when idle for idleTimeout, and at most Options.MaxIdle are kept per host.

const idleTimeout = 30000000000
const maxPooled = 256

// An idle connection's record, in malloc'd words.
const iKey = 0   // the pool key (malloc'd bytes)
const iKeyN = 1
const iFd = 2
const iTLS = 3   // 1: the TLS layer is in idleTLS, by descriptor
const iSince = 4 // rt_mono_ns() when the connection went idle
const idleWords = 5

mut idleRecs i64 // per core: [maxPooled] record pointers, 0 for a free place
let idleTLS = make(map[i64]?tls.Conn)

mut respReuse bool   // the response read last leaves its connection fit for another call
mut respSeen bool    // the call in progress has received response bytes
mut staleRetry bool  // the call failed on a kept connection before any response byte: try a new one
mut chunkTail i64    // read_chunked: where the message ended in its buffer
mut chunkExtra i64   // read_chunked: bytes in the buffer after the message

// pool_key names the connections one call may use: scheme, host and port, and for https the
// settings that decide which servers it trusts.
fn pool_key(secure bool, hostport str, opt Options) str {
	if !secure {
		return "http://" + hostport
	}
	mut k = "https://" + hostport + "|"
	let given = opt.TLS
	if given != nil {
		if given.InsecureSkipVerify {
			k += "insecure|"
		}
		k += given.RootCAs + "|"
		for _, a in given.ALPN {
			k += a + ","
		}
		if given.Certificate != "" {
			// Connections made with one client certificate are not lent to another (#475).
			k += "|cert:" + seal.Sha256Hex(given.Certificate)
		}
		if given.MinVersion == tls.VersionTLS13 {
			// A connection that may be TLS 1.2 is not lent to a caller that requires 1.3 (#473).
			k += "|tls13"
		}
	}
	return k
}

fn pool_recs() i64 {
	if idleRecs == 0 {
		idleRecs = calloc(maxPooled, 8)
	}
	return idleRecs
}

fn rec_key_is(r i64, key str) bool {
	return r[iKeyN] == len(key) && rt_str_from_raw(r[iKey], r[iKeyN]) == key
}

// pool_drop frees idle record i of the table and closes its connection.
fn pool_drop(recs i64, i i64) {
	let r = recs[i]
	recs[i] = 0
	if r[iTLS] != 0 {
		let tc = idleTLS[r[iFd]]
		delete(idleTLS, r[iFd])
		if tc != nil {
			tc.Close()
		}
	} else {
		rt_sys_close(r[iFd])
	}
	free(r[iKey])
	free(r)
}

// pool_alive reports whether a kept connection is still open and quiet: a closed peer, or bytes
// nobody asked for, make it unusable.
fn pool_alive(r i64) bool {
	if r[iTLS] != 0 {
		let tc = idleTLS[r[iFd]]
		if tc == nil {
			return false
		}
		let buf = make([]u8, 0, 16)
		let (got, err) = tc.ReadNow(mut buf, 16)
		return err == nil && got == 0
	}
	let b = calloc(1, 8)
	let k = rt_sys_recv(r[iFd], b, 1, 2)
	let e = errno()
	free(b)
	return k < 0 && (e == EAGAIN || e == 4)
}

// pool_find takes the newest kept connection to key off the table, closing the ones that went
// stale on the way: its record, or 0.
fn pool_find(key str, secure bool) i64 {
	let recs = pool_recs()
	let now = rt_mono_ns()
	mut best = -1
	for i in 0..maxPooled {
		let r = recs[i]
		if r != 0 && (r[iTLS] != 0) == secure && rec_key_is(r, key) {
			if now-r[iSince] > idleTimeout || !pool_alive(r) {
				pool_drop(recs, i)
			} else if best < 0 || r[iSince] > recs[best][iSince] {
				best = i
			}
		}
	}
	if best < 0 {
		return 0
	}
	let r = recs[best]
	recs[best] = 0
	return r
}

// pool_take returns the descriptor of a kept plain connection to key, or -1.
fn pool_take(key str, secure bool) i64 {
	let r = pool_find(key, secure)
	if r == 0 {
		return -1
	}
	let fd = r[iFd]
	free(r[iKey])
	free(r)
	return fd
}

// pool_take_tls returns a kept https connection to key, or nil.
fn pool_take_tls(key str) ?tls.Conn {
	let r = pool_find(key, true)
	if r == 0 {
		return nil
	}
	let fd = r[iFd]
	let tc = idleTLS[fd]
	delete(idleTLS, fd)
	free(r[iKey])
	free(r)
	return tc
}

// pool_put keeps the connection fd (with its TLS layer tc, for https) for the next call to key,
// and reports whether it did: not when maxIdle of them are kept already (the caller closes it).
fn pool_put(key str, fd i64, tc ?tls.Conn, maxIdle i64) bool {
	let recs = pool_recs()
	mut n = 0
	mut free_at = -1
	mut oldest = -1
	for i in 0..maxPooled {
		let r = recs[i]
		if r == 0 {
			if free_at < 0 {
				free_at = i
			}
		} else if rec_key_is(r, key) {
			n += 1
			if oldest < 0 || r[iSince] < recs[oldest][iSince] {
				oldest = i
			}
		}
	}
	if n >= maxIdle {
		return false
	}
	if free_at < 0 {
		return false
	}
	let r = calloc(idleWords, 8)
	r[iKey] = malloc(len(key) + 1)
	memcpy(r[iKey], cast(i64, key)+8, len(key))
	r[iKeyN] = len(key)
	r[iFd] = fd
	r[iSince] = rt_mono_ns()
	if tc != nil {
		r[iTLS] = 1
		idleTLS[fd] = keep(tc)
	}
	recs[free_at] = r
	return true
}

// connection_closes reports whether the response head h asks to close the connection after it.
fn connection_closes(h str) bool {
	let r = Resp{Status: 0, Body: "", head: h}
	let v = r.Header("Connection")
	let n = len(v)
	mut i = 0
	for i+5 <= n {
		if fold_eq(v[i:i+5], "close") {
			return true
		}
		i += 1
	}
	return false
}

// tls_host is the host of "host[:port]" for SNI and certificate checks ("[v6]" gives v6).
fn tls_host(hostport str) str {
	let h = hostport
	if len(h) > 0 && h[0] == '[' {
		for i in 0..len(h) {
			if h[i] == ']' {
				return h[1:i]
			}
		}
		return h
	}
	for i in 0..len(h) {
		if h[i] == ':' {
			return h[:i]
		}
	}
	return h
}

// is_token reports whether s is an HTTP token (a method or header name, RFC 9110 5.6.2).
fn is_token(s str) bool {
	if len(s) == 0 {
		return false
	}
	for i in 0..len(s) {
		let c = s[i]
		if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') {
			continue
		}
		mut ok = false
		let t = "!#$%&'*+-.^_`|~"
		for j in 0..len(t) {
			if t[j] == c {
				ok = true
				break
			}
		}
		if !ok {
			return false
		}
	}
	return true
}

fn find_crlf2(b []u8) i64 {
	for i in 3..len(b) {
		if b[i] == '\n' && b[i-1] == '\r' && b[i-2] == '\n' && b[i-3] == '\r' {
			return i + 1
		}
	}
	return -1
}

// stream is what the response reader needs from a connection: a TCP Conn or a tls.Conn.
shape stream { Read(buf mut []u8, max i64) !i64 }

// read_head reads until buf holds a complete header block and returns its length.
fn read_head[S stream](c mut S, buf mut []u8) !i64 {
	mut hend = find_crlf2(buf)
	for hend < 0 {
		if len(buf) > 1048576 {
			fail "wire: response headers too large"
		}
		let (_, err) = c.Read(mut buf, 4096)
		if len(buf) > 0 {
			respSeen = true
		}
		if err != nil {
			if IsEOF(err) {
				fail "wire: connection closed before the response headers"
			}
			if err != nil {
				fail err
			}
			return 0
		}
		hend = find_crlf2(buf)
	}
	return hend
}

// maxInformational bounds the 1xx responses accepted before the final one (as Go does).
const maxInformational = 5

fn read_response[S stream](c mut S, head bool, limit_ i64) !Resp {
	mut buf = make([]u8, 0, 4096)
	mut informational = 0
	for {
		let hend = try read_head(mut c, mut buf)
		let h = str(buf[:hend])
		if len(h) < 12 || h[:5] != "HTTP/" {
			fail "wire: malformed response"
		}
		mut status = 0
		for i in 9..12 {
			let d = h[i]
			if d < '0' || d > '9' {
				fail "wire: malformed status line"
			}
			status = status*10 + i64(d-'0')
		}
		let r = Resp{Status: status, Body: "", head: h}
		let rest = buf[hend:]
		let keepable = len(h) >= 8 && h[:8] == "HTTP/1.1" && !connection_closes(h)
		// A 1xx other than 101 precedes the final response: drop it and keep the bytes after it.
		if status >= 100 && status < 200 && status != 101 {
			informational += 1
			if informational > maxInformational {
				fail "wire: too many informational responses"
			}
			mut next = make([]u8, 0, len(rest)+4096)
			next = append(next, rest...)
			buf = next
			continue
		}
		// wire never asks for an upgrade, so a 101 is returned as the final response without a body.
		if head || status == 204 || status == 304 || status == 101 {
			respReuse = keepable && status != 101 && len(rest) == 0
			return r
		}
		let (chunked, err0) = transfer_coding(r)
		if err0 != nil {
			fail err0
		}
		mut (n, err) = content_length(r)
		if err != nil {
			fail err
		}
		if chunked && n >= 0 {
			// Both framings at once is how responses get desynchronized: refuse it (RFC 9112 6.3).
			fail "wire: both Transfer-Encoding and Content-Length"
		}
		if chunked {
			let b = try read_chunked(mut c, rest, limit_)
			r.Body = b
			respReuse = keepable && chunkExtra == 0
			return r
		}
		if n > limit_ {
			fail say.Fault("wire: response body of %d bytes is over the %d-byte limit", n, limit_)
		}
		if n >= 0 {
			let b = try read_length(mut c, rest, n)
			r.Body = b
			respReuse = keepable && len(rest) <= n
			return r
		}
		mut body2 = make([]u8, 0, 4096)
		body2 = append(body2, rest...)
		for {
			if len(body2) > limit_ {
				fail say.Fault("wire: response body is over the %d-byte limit", limit_)
			}
			let (_, err) = c.Read(mut body2, 65536)
			if err != nil {
				if IsEOF(err) {
					break
				}
				if err != nil {
					fail err
				}
				return none_resp()
			}
		}
		r.Body = str(body2)
		return r
	}
}

// transfer_coding reports whether the response is chunked. Transfer-Encoding headers form one
// comma-separated list of codings (case-insensitive, blanks ignored); wire decodes only
// chunked, so a list that is not exactly "chunked" is a fault rather than raw bytes.
fn transfer_coding(r Resp) !bool {
	mut seen = false
	mut codings = 0
	let h = r.head
	mut i = 0
	for i < len(h) {
		mut j = i
		for j < len(h) && h[j] != '\n' {
			j += 1
		}
		mut line = h[i:j]
		i = j + 1
		if len(line) > 0 && line[len(line)-1] == '\r' {
			line = line[:len(line)-1]
		}
		if len(line) <= 17 || line[17] != ':' || !fold_eq(line[:17], "transfer-encoding") {
			continue
		}
		seen = true
		let v = line[18:]
		mut k = 0
		for k <= len(v) {
			mut e = k
			for e < len(v) && v[e] != ',' {
				e += 1
			}
			mut a = k
			mut b = e
			for a < b && (v[a] == ' ' || v[a] == '\t') {
				a += 1
			}
			for b > a && (v[b-1] == ' ' || v[b-1] == '\t') {
				b -= 1
			}
			if b > a {
				let c = v[a:b]
				mut semi = 0
				for semi < len(c) && c[semi] != ';' {
					semi += 1
				}
				let name = c[:semi]
				if !fold_eq(name, "chunked") || semi < len(c) {
					fail say.Fmt("wire: unsupported Transfer-Encoding %q", c)
				}
				codings += 1
			}
			k = e + 1
		}
	}
	if !seen {
		return false
	}
	if codings == 0 {
		fail "wire: empty Transfer-Encoding"
	}
	if codings > 1 {
		fail "wire: chunked applied more than once"
	}
	return true
}

// maxBodyLen bounds a Content-Length (1 TiB): larger values are refused, not trusted.
const maxBodyLen = 1099511627776

// content_length is the response's Content-Length: -1 when there is none. Repeated headers
// must agree; anything but plain decimal digits (lists included) is a fault.
fn content_length(r Resp) !i64 {
	mut n = -1
	let h = r.head
	mut i = 0
	for i < len(h) {
		mut j = i
		for j < len(h) && h[j] != '\n' {
			j += 1
		}
		mut line = h[i:j]
		i = j + 1
		if len(line) > 0 && line[len(line)-1] == '\r' {
			line = line[:len(line)-1]
		}
		if len(line) <= 14 || line[14] != ':' || !fold_eq(line[:14], "content-length") {
			continue
		}
		let v = line[15:]
		mut a = 0
		for a < len(v) && (v[a] == ' ' || v[a] == '\t') {
			a += 1
		}
		mut e = len(v)
		for e > a && (v[e-1] == ' ' || v[e-1] == '\t') {
			e -= 1
		}
		if e == a || e-a > 13 {
			fail "wire: bad Content-Length"
		}
		mut x = 0
		for k in a..e {
			let d = v[k]
			if d < '0' || d > '9' {
				fail "wire: bad Content-Length"
			}
			x = x*10 + i64(d-'0')
		}
		if x > maxBodyLen {
			fail "wire: Content-Length too large"
		}
		if n >= 0 && x != n {
			fail "wire: conflicting Content-Length headers"
		}
		n = x
	}
	return n
}

// read_length reads an n-byte body after the pending bytes, growing the buffer as data arrives
// instead of reserving the announced size up front.
fn read_length[S stream](c mut S, pending []u8, n i64) !str {
	mut start = n
	if start > 65536 {
		start = 65536
	}
	mut body = make([]u8, 0, start)
	body = append(body, pending...)
	for len(body) < n {
		mut want = n - len(body)
		if want > 65536 {
			want = 65536
		}
		let (_, err) = c.Read(mut body, want)
		if err != nil {
			if IsEOF(err) {
				fail "wire: response body truncated"
			}
			if err != nil {
				fail err
			}
			return ""
		}
	}
	return str(body[:n])
}

// maxChunkLine bounds a chunk-size or trailer line, maxTrailers the whole trailer section.
const maxChunkLine = 4096
const maxTrailers = 1048576

// chunk_fault names a connection that ends inside a chunked body.
fn chunk_fault(err fault) ! {
	if IsEOF(err) {
		fail "wire: chunked body truncated"
	}
	if err != nil {
		fail err
	}
}

// chunk_line reads until buf holds a CRLF-terminated line at pos and returns the index of its CR.
fn chunk_line[S stream](c mut S, buf mut []u8, pos i64) !i64 {
	mut scan = pos
	for {
		for i in scan..len(buf) {
			if buf[i] == '\n' {
				if i == pos || buf[i-1] != '\r' {
					fail "wire: malformed chunked body: line not ended by CRLF"
				}
				return i - 1
			}
		}
		scan = len(buf)
		if len(buf)-pos > maxChunkLine {
			fail "wire: malformed chunked body: line too long"
		}
		let (_, err) = c.Read(mut buf, 4096)
		if err != nil {
			fail chunk_fault(err)
		}
	}
}

// visible reports whether buf[from:to] has no control characters other than tab.
fn visible(buf []u8, from i64, to i64) bool {
	for i in from..to {
		let d = buf[i]
		if (d < ' ' && d != '\t') || d == 127 {
			return false
		}
	}
	return true
}

// chunk_size parses buf[pos:end]: one or more hex digits, then optional ";" extensions.
fn chunk_size(buf []u8, pos i64, end i64) !i64 {
	mut size = 0
	mut i = pos
	for i < end {
		let d = buf[i]
		mut v = -1
		if d >= '0' && d <= '9' {
			v = i64(d - '0')
		} else if d >= 'a' && d <= 'f' {
			v = i64(d-'a') + 10
		} else if d >= 'A' && d <= 'F' {
			v = i64(d-'A') + 10
		}
		if v < 0 {
			break
		}
		if size >= 0x0800000000000000 {
			fail "wire: malformed chunked body: chunk size too large"
		}
		size = size*16 + v
		i += 1
	}
	if i == pos {
		fail "wire: malformed chunked body: bad chunk size"
	}
	for i < end && (buf[i] == ' ' || buf[i] == '\t') {
		i += 1
	}
	if i < end && (buf[i] != ';' || !visible(buf, i, end)) {
		fail "wire: malformed chunked body: bad chunk size"
	}
	return size
}

// chunk_trailers reads the trailer fields after the last chunk up to the empty line; they are ignored.
fn chunk_trailers[S stream](c mut S, buf mut []u8, pos i64) ! {
	let start = pos
	for {
		let end = try chunk_line(mut c, mut buf, pos)
		if end == pos {
			chunkTail = end + 2
			return
		}
		mut colon = -1
		for i in pos..end {
			if buf[i] == ':' {
				colon = i
				break
			}
		}
		if colon <= pos || buf[pos] == ' ' || buf[pos] == '\t' || !visible(buf, pos, end) {
			fail "wire: malformed chunked body: bad trailer"
		}
		pos = end + 2
		if pos-start > maxTrailers {
			fail "wire: malformed chunked body: trailers too large"
		}
	}
}

// read_chunked decodes a chunked body; pending holds bytes already read.
fn read_chunked[S stream](c mut S, pending []u8, limit_ i64) !str {
	mut buf = make([]u8, 0, len(pending)+4096)
	buf = append(buf, pending...)
	mut out = make([]u8, 0, 4096)
	mut pos = 0
	for {
		let end = try chunk_line(mut c, mut buf, pos)
		let size = try chunk_size(buf, pos, end)
		pos = end + 2
		if size == 0 {
			try chunk_trailers(mut c, mut buf, pos)
			chunkExtra = len(buf) - chunkTail
			return str(out)
		}
		if size > limit_-len(out) {
			fail say.Fault("wire: response body is over the %d-byte limit", limit_)
		}
		// Read at most 64 KiB at a time so the buffer grows only as data arrives.
		for len(buf)-pos < size+2 {
			mut want = size + 2 - (len(buf) - pos)
			if want > 65536 {
				want = 65536
			}
			let (_, err) = c.Read(mut buf, want)
			if err != nil {
				fail chunk_fault(err)
			}
		}
		if buf[pos+size] != '\r' || buf[pos+size+1] != '\n' {
			fail "wire: malformed chunked body: chunk data not ended by CRLF"
		}
		out = append(out, buf[pos:pos+size]...)
		pos += size + 2
	}
}

// Header returns the response header name (any case), or "".
fn (r Resp) Header(name str) str {
	return field_of(r.head, name)
}

// Trailer returns the response trailer name (any case), or "": HTTP/2 responses carry trailers
// (gRPC's grpc-status, for one; #480).
fn (r Resp) Trailer(name str) str {
	return field_of(r.trail, name)
}

// field_of is field name's value in header lines h, or "".
fn field_of(h str, name str) str {
	mut i = 0
	for i < len(h) {
		mut j = i
		for j < len(h) && h[j] != '\n' {
			j += 1
		}
		mut line = h[i:j]
		if len(line) > 0 && line[len(line)-1] == '\r' {
			line = line[:len(line)-1]
		}
		if len(line) > len(name) && line[len(name)] == ':' && fold_eq(line[:len(name)], name) {
			let v = line[len(name)+1:]
			mut k = 0
			for k < len(v) && (v[k] == ' ' || v[k] == '\t') {
				k += 1
			}
			return v[k:]
		}
		i = j + 1
	}
	return ""
}

fn fold_eq(a str, b str) bool {
	if len(a) != len(b) {
		return false
	}
	for i in 0..len(a) {
		mut x = a[i]
		mut y = b[i]
		if x >= 'A' && x <= 'Z' {
			x += 32
		}
		if y >= 'A' && y <= 'Z' {
			y += 32
		}
		if x != y {
			return false
		}
	}
	return true
}

// ---- recording and replay (notes/interface_replay.md, section 4; #241) ----

// An effect's body runs at once, before it waits: these hand it its arguments (read at its
// start) and hand back what it made (read as soon as it returns).
mut tapedCall i64 // the call an effect body makes (an httpCall, or a Conn for read and write)
mut tapedArg i64  // its number argument (max bytes, a dial's timeout, the bytes to write)
mut tapedLen i64  // how many bytes to write
mut tapedConn i64 // the connection a dial's body made

// httpCall is one DoWith call, for its effect body.
type httpCall struct {
	method  str
	url     str
	headers []str
	body    str
	opt     Options
}

// http_taped records or replays one DoWith call as wire.http@1: the key is the request (the
// values of secret headers as handles), the result the status, the head and the body.
fn http_taped(tp i64, method str, url str, headers []str, body str, opt Options) !Resp {
	mut k = make([]u8, 0, 64+len(url)+len(body))
	k = append(k, method...)
	k = append(k, ' ')
	k = append(k, url...)
	{
		mut i = 0
		for i+1 < len(headers) {
			k = append(k, '\n')
			k = append(k, headers[i]...)
			k = append(k, ": "...)
			if rt_secret_header(headers[i]) {
				k = append(k, rt_secret_key(headers[i+1])...)
			} else {
				k = append(k, headers[i+1]...)
			}
			i += 2
		}
	}
	k = append(k, "\n\n"...)
	k = append(k, body...)
	tapedCall = cast(i64, httpCall{method: method, url: url, headers: headers, body: body, opt: opt})
	let v = try rt_effect(tp, "wire.http@1", str(k), http_live)
	if len(v) < 24 {
		fail "replay: wire.http@1 result is damaged"
	}
	let hn = taped_word(v, 8)
	if 16+hn+8 > len(v) || taped_word(v, 16+hn) != len(v)-24-hn {
		fail "replay: wire.http@1 result is damaged"
	}
	return Resp{Status: taped_word(v, 0), head: v[16 : 16+hn], Body: v[24+hn:]}
}

fn http_live() !str {
	let call = cast(httpCall, tapedCall)
	let r = try DoWith(call.method, call.url, call.headers, call.body, call.opt)
	mut b = make([]u8, 0, 24+len(r.head)+len(r.Body))
	b = taped_put(b, r.Status)
	b = taped_put(b, len(r.head))
	b = append(b, r.head...)
	b = taped_put(b, len(r.Body))
	b = append(b, r.Body...)
	return str(b)
}

// dial_taped records or replays a dial as wire.dial@1, whose result is the connection's number
// in the request; replaying, the connection has no socket and its reads and writes come from
// the tape.
fn dial_taped(tp i64, addr str, timeout i64) !Conn {
	tapedCall = cast(i64, addr)
	tapedArg = timeout
	tapedConn = 0
	let v = try rt_effect(tp, "wire.dial@1", addr, dial_live)
	if len(v) != 8 {
		fail "replay: wire.dial@1 result is damaged"
	}
	let n = taped_word(v, 0)
	if tapedConn != 0 {
		let c = cast(Conn, tapedConn)
		tapedConn = 0
		c.tn = n
		return c
	}
	return Conn{open: true, fd: -1, tn: n}
}

fn dial_live() !str {
	let c = try DialTimeout(cast(str, tapedCall), tapedArg)
	tapedConn = cast(i64, c)
	let n = rt_tape_kinds(rt_tape_of(rt_task_current()), "wire.dial@1") + 1
	return str(taped_put(make([]u8, 0, 8), n))
}

// read_taped records or replays one Read as wire.read@1 (key: the connection's number and max).
fn (c Conn) read_taped(tp i64, buf mut []u8, max i64) !i64 {
	tapedCall = cast(i64, c)
	tapedArg = max
	let v = try rt_effect(tp, "wire.read@1", rt_i64str(c.tn) + " " + rt_i64str(max), read_live)
	buf = append(buf, v...)
	return len(v)
}

fn read_live() !str {
	let c = cast(Conn, tapedCall)
	let b = make([]u8, 0, tapedArg)
	_ = try c.Read(mut b, tapedArg)
	return str(b)
}

// write_taped records or replays one write as wire.write@1 (key: the connection's number and
// the bytes).
fn (c Conn) write_taped(tp i64, p i64, n i64) ! {
	tapedCall = cast(i64, c)
	tapedArg = p
	tapedLen = n
	_ = try rt_effect(tp, "wire.write@1", rt_i64str(c.tn) + " " + rt_str_from_raw(p, n), write_live)
}

fn write_live() !str {
	let c = cast(Conn, tapedCall)
	try c.write_raw(tapedArg, tapedLen)
	return ""
}

fn taped_put(b []u8, v i64) []u8 {
	for i in 0..8 {
		b = append(b, u8(v >> (8 * i)))
	}
	return b
}

fn taped_word(s str, at i64) i64 {
	mut v = 0
	{
		mut i = 7
		for i >= 0 {
			v = v<<8 | i64(s[at+i])
			i -= 1
		}
	}
	return v
}
