// Package argo writes JSON. argo.Put(b, v) appends v to the []u8 buffer b; the compiler
// generates a dedicated encoder for v's type (fields in declaration order, no reflection,
// no allocation). The w* writers below are what those encoders call. argo.Get(s, v) fills
// v from the JSON text s with a decoder generated the same way; it returns a fault for
// arrays and objects nested more than 512 deep, as each level takes stack, and leaves v
// unchanged on any fault. argo.GetStrict(s, v) also rejects unknown and duplicate members.
package argo

import "say"

const hexDigits = "0123456789abcdef"

// Put appends v as JSON to b. The compiler replaces every call with a typed encoder.
fn Put(b mut []u8, v i64) {
	wint(mut b, v)
}

// Str appends s as a JSON string.
fn Str(b mut []u8, s str) {
	wstr(mut b, s)
}

// Raw appends already-encoded JSON text.
fn Raw(b mut []u8, s str) {
	rt_append_str(cast(i64, b), s)
}

fn wroom(h i64, n i64) {
	if h[0]+n > h[1] {
		rt_slice_grow(h, h[0]+n, 1)
	}
}

fn wstr(b mut []u8, s str) {
	let h = cast(i64, b)
	let n = len(s)
	let p = cast(i64, s) + 8
	if h[0]+n+2 > h[1] {
		rt_slice_grow(h, h[0]+n+2, 1)
	}
	mut d = h[2] + h[0]
	store8(d, '"')
	// Copy 8 bytes at a time while all are ASCII and none needs escaping (control bytes, '"'
	// and '\\'); a non-ASCII byte goes to the loop below, which checks its UTF-8.
	mut i = 0
	for i+8 <= n {
		let w = u64(__ld(p+i, 3))
		let lo = (w - 0x2020202020202020) & ^w
		let q = w ^ 0x2222222222222222
		let bs = w ^ 0x5c5c5c5c5c5c5c5c
		let hit = (lo | ((q - 0x0101010101010101) & ^q) | ((bs - 0x0101010101010101) & ^bs) | w) & 0x8080808080808080
		if hit != 0 {
			break
		}
		__st(d+1+i, i64(w), 3)
		i += 8
	}
	for i < n {
		let c = load8(p + i)
		if c < 0x20 || c == '"' || c == '\\' || c >= 0x80 {
			break
		}
		store8(d+1+i, i64(c))
		i += 1
	}
	if i == n {
		store8(d+1+n, '"')
		h[0] += n + 2
		return
	}
	h[0] += 1 + i
	for i < n {
		let c = load8(p + i)
		wroom(h, 7)
		d = h[2] + h[0]
		if c == '"' || c == '\\' {
			store8(d, '\\')
			store8(d+1, c)
			h[0] += 2
		} else if c == '\n' {
			store8(d, '\\')
			store8(d+1, 'n')
			h[0] += 2
		} else if c == '\r' {
			store8(d, '\\')
			store8(d+1, 'r')
			h[0] += 2
		} else if c == '\t' {
			store8(d, '\\')
			store8(d+1, 't')
			h[0] += 2
		} else if c < 0x20 {
			store8(d, '\\')
			store8(d+1, 'u')
			store8(d+2, '0')
			store8(d+3, '0')
			store8(d+4, load8(cast(i64, hexDigits)+8+i64(c>>4)))
			store8(d+5, load8(cast(i64, hexDigits)+8+i64(c&15)))
			h[0] += 6
		} else if c >= 0x80 {
			// Valid UTF-8 is copied; each byte that is not part of a valid sequence becomes
			// \ufffd, as Go's encoding/json does, so the output is always valid JSON (#104).
			let k = utf8_seq(p, i, n)
			if k == 0 {
				memcpy(d, cast(i64, "\\ufffd")+8, 6)
				h[0] += 6
			} else if k == 3 && c == 0xe2 && load8(p+i+1) == 0x80 && (load8(p+i+2) == 0xa8 || load8(p+i+2) == 0xa9) {
				// U+2028 and U+2029 end lines in JavaScript: escaped, as Go does.
				memcpy(d, cast(i64, "\\u202")+8, 5)
				store8(d+5, '8'+i64(load8(p+i+2)-0xa8))
				h[0] += 6
				i += 2
			} else {
				memcpy(d, p+i, k)
				h[0] += k
				i += k - 1
			}
		} else {
			store8(d, c)
			h[0] += 1
		}
		i += 1
	}
	wroom(h, 1)
	store8(h[2]+h[0], '"')
	h[0] += 1
}

// utf8_seq is the length of the valid UTF-8 sequence starting at byte i of the n bytes at p
// (2 to 4), or 0 when it is not one: a stray continuation byte, a truncated sequence, an
// overlong form, a surrogate or a value past U+10FFFF.
fn utf8_seq(p i64, i i64, n i64) i64 {
	let c = load8(p + i)
	mut k = 0
	mut lo = 0x80
	mut hi = 0xbf
	if c >= 0xc2 && c <= 0xdf {
		k = 2
	} else if c >= 0xe0 && c <= 0xef {
		k = 3
		if c == 0xe0 {
			lo = 0xa0
		} else if c == 0xed {
			hi = 0x9f
		}
	} else if c >= 0xf0 && c <= 0xf4 {
		k = 4
		if c == 0xf0 {
			lo = 0x90
		} else if c == 0xf4 {
			hi = 0x8f
		}
	} else {
		return 0
	}
	if i+k > n {
		return 0
	}
	let c1 = i64(load8(p + i + 1))
	if c1 < lo || c1 > hi {
		return 0
	}
	for j in 2..k {
		let cj = i64(load8(p + i + j))
		if cj < 0x80 || cj > 0xbf {
			return 0
		}
	}
	return k
}

fn wuint(b mut []u8, v u64) {
	let h = cast(i64, b)
	wroom(h, 21)
	mut n = 1
	{
		mut t = v
		for t >= 10 {
			n += 1
			t /= 10
		}
	}
	let d = h[2] + h[0]
	{
		mut i = n - 1
		for i >= 0 {
			store8(d+i, '0'+i64(v%10))
			v /= 10
			i -= 1
		}
	}
	h[0] += n
}

fn wint(b mut []u8, v i64) {
	if v < 0 {
		let h = cast(i64, b)
		wroom(h, 1)
		store8(h[2]+h[0], '-')
		h[0] += 1
		wuint(mut b, u64(0-v))
		return
	}
	wuint(mut b, u64(v))
}

fn wbool(b mut []u8, v bool) {
	if v {
		rt_append_str(cast(i64, b), "true")
	} else {
		rt_append_str(cast(i64, b), "false")
	}
}

fn wfloat(b mut []u8, v f64) {
	if v != v || v > 1.7976931348623157e308 || v < -1.7976931348623157e308 {
		rt_append_str(cast(i64, b), "null")
		return
	}
	let h = cast(i64, b)
	if h[0]+40 > h[1] {
		rt_slice_grow(h, h[0]+40, 1)
	}
	h[0] += shortest_into(h[2]+h[0], v, -6, 21, true, false)
}

// wfloat32 writes an f32 in the shortest form that reads back as the same f32.
fn wfloat32(b mut []u8, v f32) {
	shortF32 = true
	wfloat(mut b, f64(v))
	shortF32 = false
}

// ---- decoding ----
//
// argo.Get(s, v) fills v (a struct, slice or map) from the JSON text s and returns a fault
// for malformed input or a type mismatch. The compiler generates a decoder per type; it
// calls the r* readers below, which record the first error in the Parser and then do
// nothing, so decoders only test p.err at loop boundaries.

// maxDepth bounds the arrays and objects open at once: each holds a stack frame of rskip
// (32 bytes) or of a decoder (80 for a small struct, 240 for one of 32 fields), and a
// request task has 256 KiB of stack.
const maxDepth = 512

type Parser struct {
	s      str
	i      i64
	depth  i64 // arrays and objects open at i
	err    fault
	strict bool         // GetStrict: unknown and duplicate keys are faults
	keyAt  i64          // where the member name last read starts
	scopes []i64        // ids of the objects with members open at i (strict only)
	nscope i64          // objects opened so far (strict only)
	seen   ?map[str]bool // "id:name" of every member read (strict only)
}

fn parser(s str) Parser {
	return Parser{s: s}
}

// strictly is parser for GetStrict.
fn strictly(s str) Parser {
	return Parser{s: s, strict: true, seen: make(map[str]bool)}
}

// cut sets the length of the slice with header h back to n (Get decoded elements past it
// and then failed).
fn cut(h i64, n i64) {
	h[0] = n
}

// rewind starts reading the same text again (the second pass of Get).
fn rewind(p mut Parser) {
	p.i = 0
	p.depth = 0
	p.err = nil
	p.keyAt = 0
	if p.strict {
		p.scopes = []i64{}
		p.nscope = 0
		p.seen = make(map[str]bool)
	}
}

fn finish(p mut Parser) ! {
	if p.err != nil {
		return try p.err
	}
	ws(mut p)
	if p.i < len(p.s) {
		fail say.Fault("argo: unexpected %q after the value at offset %d", str(p.s[p.i]), p.i)
	}
}

fn bad(p mut Parser, what str) {
	if p.err == nil {
		if p.i < len(p.s) && p.s[p.i] >= 0x80 && utf8_seq(cast(i64, p.s)+8, p.i, len(p.s)) == 0 {
			p.err = say.Fault("argo: invalid UTF-8 at offset %d (expected %s)", p.i, what)
		} else if p.i < len(p.s) {
			p.err = say.Fault("argo: expected %s at offset %d, found %q", what, p.i, str(p.s[p.i]))
		} else {
			p.err = say.Fault("argo: expected %s, found the end of the input", what)
		}
	}
	p.i = len(p.s)
}

fn ws(p mut Parser) {
	let s = p.s
	mut i = p.i
	for i < len(s) {
		let c = s[i]
		if c != ' ' && c != '\n' && c != '\r' && c != '\t' {
			break
		}
		i += 1
	}
	p.i = i
}

// robj consumes '{' and reports whether a member follows ('}' right away is consumed).
fn robj(p mut Parser) bool {
	ws(mut p)
	if p.i >= len(p.s) || p.s[p.i] != '{' {
		bad(mut p, "an object")
		return false
	}
	return nest(mut p, '}')
}

// rarr consumes '[' and reports whether an element follows.
fn rarr(p mut Parser) bool {
	ws(mut p)
	if p.i >= len(p.s) || p.s[p.i] != '[' {
		bad(mut p, "an array")
		return false
	}
	return nest(mut p, ']')
}

// nest consumes the '{' or '[' at p.i and reports whether a member follows (close right
// away is consumed). The array or object counts toward maxDepth until rmore closes it.
fn nest(p mut Parser, close u8) bool {
	if p.depth == maxDepth {
		bad(mut p, say.Fmt("at most %d nested arrays and objects", maxDepth))
		return false
	}
	p.i += 1
	ws(mut p)
	if p.i < len(p.s) && p.s[p.i] == close {
		p.i += 1
		return false
	}
	p.depth += 1
	if p.strict && close == '}' {
		p.nscope += 1
		p.scopes = append(p.scopes, p.nscope)
	}
	return true
}

// rmore consumes ',' (true: another member follows) or the closing byte (false).
fn rmore(p mut Parser, close u8) bool {
	ws(mut p)
	if p.i < len(p.s) {
		let c = p.s[p.i]
		if c == ',' {
			p.i += 1
			return true
		}
		if c == close {
			p.i += 1
			p.depth -= 1
			if p.strict && close == '}' {
				p.scopes = p.scopes[:len(p.scopes)-1]
			}
			return false
		}
	}
	bad(mut p, "',' or the end of the object or array")
	return false
}

// rkey reads a member name and its ':'.
fn rkey(p mut Parser) str {
	ws(mut p)
	p.keyAt = p.i
	let k = rstr(mut p)
	ws(mut p)
	if p.i >= len(p.s) || p.s[p.i] != ':' {
		bad(mut p, "':'")
		return ""
	}
	p.i += 1
	if p.strict && p.err == nil && len(p.scopes) > 0 {
		let seen = p.seen
		if seen != nil {
			let id = say.Fmt("%d:%s", p.scopes[len(p.scopes)-1], k)
			if seen[id] {
				fault_at(mut p, p.keyAt, say.Fmt("duplicate key %q", k))
				return ""
			}
			seen[id] = true
		}
	}
	return k
}

// runknown handles a member the target has no field for: skipped, or a fault when strict.
fn runknown(p mut Parser, key str) {
	if p.strict {
		fault_at(mut p, p.keyAt, say.Fmt("unknown key %q", key))
		return
	}
	rskip(mut p)
}

// fault_at records a fault with a reason at offset at, and the parser stops.
fn fault_at(p mut Parser, at i64, what str) {
	if p.err == nil {
		p.err = say.Fault("argo: %s at offset %d", what, at)
	}
	p.i = len(p.s)
}

// renum reads an enum variant's name: a bare "Name", or the key of {"Name": ...}; boxed
// reports the second form, whose payload follows (then rclose).
fn renum(p mut Parser) (str, bool) {
	ws(mut p)
	if p.i < len(p.s) && p.s[p.i] == '"' {
		return rstr(mut p), false
	}
	if !robj(mut p) {
		bad(mut p, "an enum variant (\"Name\" or {\"Name\": ...})")
		return "", false
	}
	return rkey(mut p), true
}

// rclose consumes the '}' that ends a boxed enum variant.
fn rclose(p mut Parser) {
	if rmore(mut p, '}') {
		bad(mut p, "the end of the enum object (one variant per value)")
	}
}

// rvariant records a fault for a variant name the enum does not have, or one given the
// wrong shape.
fn rvariant(p mut Parser, name str) {
	if p.err == nil {
		p.err = say.Fault("argo: unknown or malformed enum variant %q", name)
	}
	p.i = len(p.s)
}

// rnull consumes null if it is next.
fn rnull(p mut Parser) bool {
	ws(mut p)
	let s = p.s
	let i = p.i
	if i+4 <= len(s) && s[i] == 'n' && s[i+1] == 'u' && s[i+2] == 'l' && s[i+3] == 'l' {
		p.i = i + 4
		return true
	}
	return false
}

fn hex4(s str, i i64) i64 {
	mut v = 0
	for k in 0..4 {
		let c = s[i+k]
		mut d = -1
		if c >= '0' && c <= '9' {
			d = i64(c - '0')
		} else if c >= 'a' && c <= 'f' {
			d = i64(c-'a') + 10
		} else if c >= 'A' && c <= 'F' {
			d = i64(c-'A') + 10
		}
		if d < 0 {
			return -1
		}
		v = v*16 + d
	}
	return v
}

fn rstr(p mut Parser) str {
	ws(mut p)
	let s = p.s
	mut i = p.i
	if i >= len(s) || s[i] != '"' {
		bad(mut p, "a string")
		return ""
	}
	i += 1
	let start = i
	for i < len(s) {
		let c = s[i]
		if c == '"' {
			p.i = i + 1
			return s[start:i]
		}
		if c == '\\' || c < 0x20 {
			break
		}
		if c >= 0x80 {
			let k = utf8_seq(cast(i64, s)+8, i, len(s))
			if k == 0 {
				fault_at(mut p, i, "invalid UTF-8")
				return ""
			}
			i += k
			continue
		}
		i += 1
	}
	mut b = make([]u8, 0, i-start+16)
	b = append(b, s[start:i]...)
	for i < len(s) {
		let c = s[i]
		if c == '"' {
			p.i = i + 1
			return str(b)
		}
		if c < 0x20 {
			p.i = i
			bad(mut p, "an escaped control character")
			return ""
		}
		if c >= 0x80 {
			let k = utf8_seq(cast(i64, s)+8, i, len(s))
			if k == 0 {
				fault_at(mut p, i, "invalid UTF-8")
				return ""
			}
			b = append(b, s[i:i+k]...)
			i += k
			continue
		}
		if c != '\\' {
			b = append(b, c)
			i += 1
			continue
		}
		if i+1 >= len(s) {
			break
		}
		let e = s[i+1]
		i += 2
		if e == 'n' {
			b = append(b, '\n')
		} else if e == 't' {
			b = append(b, '\t')
		} else if e == 'r' {
			b = append(b, '\r')
		} else if e == 'b' {
			b = append(b, 8)
		} else if e == 'f' {
			b = append(b, 12)
		} else if e == '"' || e == '\\' || e == '/' {
			b = append(b, e)
		} else if e == 'u' && i+4 <= len(s) && hex4(s, i) >= 0 {
			mut r = hex4(s, i)
			let at = i - 2
			i += 4
			if r >= 0xD800 && r < 0xDC00 && i+6 <= len(s) && s[i] == '\\' && s[i+1] == 'u' && hex4(s, i+2) >= 0xDC00 && hex4(s, i+2) < 0xE000 {
				r = 0x10000 + (r-0xD800)<<10 + (hex4(s, i+2) - 0xDC00)
				i += 6
			} else if r >= 0xD800 && r < 0xE000 {
				fault_at(mut p, at, say.Fmt("unpaired surrogate \\u%04x", r))
				return ""
			}
			b = append(b, str(i32(r))...)
		} else {
			p.i = i - 2
			bad(mut p, "a valid escape")
			return ""
		}
	}
	p.i = len(s)
	bad(mut p, "a closing '\"'")
	return ""
}

// rstrmax is rstr for a str max n (#240): a string longer than n bytes (decoded) fails with
// fault.LimitExceeded once its length passes n, without reading the rest of it.
fn rstrmax(p mut Parser, n i64) str {
	ws(mut p)
	let s = p.s
	let i = p.i
	if i >= len(s) || s[i] != '"' {
		bad(mut p, "a string")
		return ""
	}
	mut j = i + 1
	mut count = 0
	for j < len(s) && count <= n {
		let c = s[j]
		if c == '"' {
			return rstr(mut p)
		}
		if c == '\\' && j+1 < len(s) && s[j+1] == 'u' && j+6 <= len(s) {
			let r = hex4(s, j+2)
			j += 6
			if r >= 0xD800 && r < 0xDC00 && j+6 <= len(s) && s[j] == '\\' && s[j+1] == 'u' && hex4(s, j+2) >= 0xDC00 && hex4(s, j+2) < 0xE000 {
				count += 4
				j += 6
			} else if r >= 0 && r < 0x80 {
				count += 1
			} else if r >= 0 && r < 0x800 {
				count += 2
			} else {
				count += 3
			}
			continue
		}
		if c == '\\' {
			j += 1
		}
		count += 1
		j += 1
	}
	if count <= n {
		// No closing quote: rstr reports the malformed string.
		return rstr(mut p)
	}
	over(mut p, n)
	return ""
}

// over records that the value at p is longer than its bound n (#240): fault.LimitExceeded,
// and the parser stops.
fn over(p mut Parser, n i64) {
	if p.err == nil {
		p.err = cast(fault, rt_fault_wrap(rt_fault_limit(), say.Fmt("argo: the value at offset %d is longer than its bound %d", p.i, n)))
	}
	p.i = len(p.s)
}

fn rint(p mut Parser) i64 {
	ws(mut p)
	let s = p.s
	mut i = p.i
	mut neg = false
	if i < len(s) && s[i] == '-' {
		neg = true
		i += 1
	}
	if i >= len(s) || s[i] < '0' || s[i] > '9' {
		bad(mut p, "an integer")
		return 0
	}
	mut v = u64(0)
	let top = ^u64(0)
	for i < len(s) && s[i] >= '0' && s[i] <= '9' {
		let d = u64(s[i] - '0')
		if v > (top-d)/10 {
			bad(mut p, "an integer that fits in 64 bits")
			return 0
		}
		v = v*10 + d
		i += 1
		if v == 0 {
			// A leading 0 is the whole number: in "007" the next byte is junk after a value.
			break
		}
	}
	if i < len(s) && (s[i] == '.' || s[i] == 'e' || s[i] == 'E') {
		bad(mut p, "an integer (not a fraction)")
		return 0
	}
	if neg {
		if v > u64(9223372036854775807)+1 {
			bad(mut p, "an integer that fits in i64")
			return 0
		}
		p.i = i
		return 0 - i64(v)
	}
	if v > u64(9223372036854775807) {
		bad(mut p, "an integer that fits in i64")
		return 0
	}
	p.i = i
	return i64(v)
}

// rintr reads an integer within [lo, hi] (for the sized integer types).
fn rintr(p mut Parser, lo i64, hi i64) i64 {
	let at = p.i
	let v = rint(mut p)
	if p.err == nil && (v < lo || v > hi) {
		p.i = at
		ws(mut p)
		bad(mut p, say.Fmt("an integer in [%d, %d]", lo, hi))
		return 0
	}
	return v
}

fn ruint(p mut Parser) u64 {
	ws(mut p)
	if p.i < len(p.s) && p.s[p.i] == '-' {
		bad(mut p, "an unsigned integer")
		return 0
	}
	let s = p.s
	mut i = p.i
	if i >= len(s) || s[i] < '0' || s[i] > '9' {
		bad(mut p, "an unsigned integer")
		return 0
	}
	mut v = u64(0)
	let top = ^u64(0)
	for i < len(s) && s[i] >= '0' && s[i] <= '9' {
		let d = u64(s[i] - '0')
		if v > (top-d)/10 {
			bad(mut p, "an integer that fits in 64 bits")
			return 0
		}
		v = v*10 + d
		i += 1
		if v == 0 {
			break
		}
	}
	p.i = i
	return v
}

// rnum consumes a number and returns where it starts. It matches RFC 8259's
// -?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)? as far as it goes, so "007" and "1.2.3"
// end early and fail on the byte that follows, as junk after any value does.
fn rnum(p mut Parser) i64 {
	ws(mut p)
	let s = p.s
	let at = p.i
	mut i = at
	if i < len(s) && s[i] == '-' {
		i += 1
	}
	if i < len(s) && s[i] == '0' {
		p.i = i + 1
	} else {
		digits(mut p, i, "a number")
	}
	if p.i < len(s) && s[p.i] == '.' {
		digits(mut p, p.i+1, "a digit")
	}
	i = p.i
	if i < len(s) && (s[i] == 'e' || s[i] == 'E') {
		i += 1
		if i < len(s) && (s[i] == '+' || s[i] == '-') {
			i += 1
		}
		digits(mut p, i, "a digit")
	}
	return at
}

// digits consumes the digits at i; there must be at least one.
fn digits(p mut Parser, i i64, what str) {
	let s = p.s
	mut j = i
	for j < len(s) && s[j] >= '0' && s[j] <= '9' {
		j += 1
	}
	p.i = j
	if j == i {
		bad(mut p, what)
	}
}

// rfloat reads a number that fits in f64 (1e400 is a fault, as in Go).
fn rfloat(p mut Parser) f64 {
	let at = rnum(mut p)
	if p.err != nil {
		return 0
	}
	let v = rt_parse_float(cast(i64, p.s[at:p.i])+8, 0)
	if v > 1.7976931348623157e308 || v < -1.7976931348623157e308 {
		p.i = at
		bad(mut p, "a number that fits in f64")
		return 0
	}
	return v
}

// vfloat checks what rfloat checks without converting a plain number: only a long one or
// one with an exponent can overflow, and those take the full path.
fn vfloat(p mut Parser, width i64) {
	let at = rnum(mut p)
	if p.err != nil || p.i-at <= width && !has_exp(p.s, at, p.i) {
		return
	}
	p.i = at
	if width == 38 {
		rfloat32(mut p)
	} else {
		rfloat(mut p)
	}
}

fn has_exp(s str, from i64, to i64) bool {
	for i in from..to {
		if s[i] == 'e' || s[i] == 'E' {
			return true
		}
	}
	return false
}

// rfloat32 reads a number that fits in f32.
fn rfloat32(p mut Parser) f32 {
	let at = p.i
	let v = f32(rfloat(mut p))
	if f64(v) > 3.4028234663852886e38 || f64(v) < -3.4028234663852886e38 {
		p.i = at
		ws(mut p)
		bad(mut p, "a number that fits in f32")
		return 0
	}
	return v
}

fn rbool(p mut Parser) bool {
	ws(mut p)
	let s = p.s
	let i = p.i
	if i+4 <= len(s) && s[i] == 't' && s[i+1] == 'r' && s[i+2] == 'u' && s[i+3] == 'e' {
		p.i = i + 4
		return true
	}
	if i+5 <= len(s) && s[i] == 'f' && s[i+1] == 'a' && s[i+2] == 'l' && s[i+3] == 's' && s[i+4] == 'e' {
		p.i = i + 5
		return false
	}
	bad(mut p, "true or false")
	return false
}

// rskip skips any value (an unknown member).
fn rskip(p mut Parser) {
	ws(mut p)
	if p.i >= len(p.s) {
		bad(mut p, "a value")
		return
	}
	let c = p.s[p.i]
	if c == '"' {
		rstr(mut p)
	} else if c == '{' {
		if robj(mut p) {
			for p.err == nil {
				rkey(mut p)
				rskip(mut p)
				if !rmore(mut p, '}') {
					break
				}
			}
		}
	} else if c == '[' {
		if rarr(mut p) {
			for p.err == nil {
				rskip(mut p)
				if !rmore(mut p, ']') {
					break
				}
			}
		}
	} else if c == 't' || c == 'f' {
		rbool(mut p)
	} else if c == 'n' {
		if !rnull(mut p) {
			bad(mut p, "a value")
		}
	} else {
		rnum(mut p)
	}
}
