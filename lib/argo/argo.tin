// Package argo writes JSON. argo.Put(b, v) appends v to the []u8 buffer b; the compiler
// generates a dedicated encoder for v's type (fields in declaration order, no reflection,
// no allocation). The w* writers below are what those encoders call. argo.Get(s, v) fills
// v from the JSON text s with a decoder generated the same way; it returns a fault for
// arrays and objects nested more than 512 deep, as each level takes stack.
package argo

import "say"

const hexDigits = "0123456789abcdef"

// Put appends v as JSON to b. The compiler replaces every call with a typed encoder.
func Put(b mut []u8, v i64) {
	wint(mut b, v)
}

// Str appends s as a JSON string.
func Str(b mut []u8, s str) {
	wstr(mut b, s)
}

// Raw appends already-encoded JSON text.
func Raw(b mut []u8, s str) {
	rt_append_str(cast(i64, b), s)
}

func wroom(h i64, n i64) {
	if h[0]+n > h[1] {
		rt_slice_grow(h, h[0]+n, 1)
	}
}

func wstr(b mut []u8, s str) {
	h := cast(i64, b)
	n := len(s)
	p := cast(i64, s) + 8
	if h[0]+n+2 > h[1] {
		rt_slice_grow(h, h[0]+n+2, 1)
	}
	d := h[2] + h[0]
	store8(d, '"')
	// Copy 8 bytes at a time while all are ASCII and none needs escaping (control bytes, '"'
	// and '\\'); a non-ASCII byte goes to the loop below, which checks its UTF-8.
	i := 0
	for i+8 <= n {
		w := u64(__ld(p+i, 3))
		lo := (w - 0x2020202020202020) & ^w
		q := w ^ 0x2222222222222222
		bs := w ^ 0x5c5c5c5c5c5c5c5c
		hit := (lo | ((q - 0x0101010101010101) & ^q) | ((bs - 0x0101010101010101) & ^bs) | w) & 0x8080808080808080
		if hit != 0 {
			break
		}
		__st(d+1+i, i64(w), 3)
		i += 8
	}
	for i < n {
		c := load8(p + i)
		if c < 0x20 || c == '"' || c == '\\' || c >= 0x80 {
			break
		}
		store8(d+1+i, i64(c))
		i++
	}
	if i == n {
		store8(d+1+n, '"')
		h[0] += n + 2
		return
	}
	h[0] += 1 + i
	for i < n {
		c := load8(p + i)
		wroom(h, 7)
		d = h[2] + h[0]
		if c == '"' || c == '\\' {
			store8(d, '\\')
			store8(d+1, c)
			h[0] += 2
		} else if c == '\n' {
			store8(d, '\\')
			store8(d+1, 'n')
			h[0] += 2
		} else if c == '\r' {
			store8(d, '\\')
			store8(d+1, 'r')
			h[0] += 2
		} else if c == '\t' {
			store8(d, '\\')
			store8(d+1, 't')
			h[0] += 2
		} else if c < 0x20 {
			store8(d, '\\')
			store8(d+1, 'u')
			store8(d+2, '0')
			store8(d+3, '0')
			store8(d+4, load8(cast(i64, hexDigits)+8+i64(c>>4)))
			store8(d+5, load8(cast(i64, hexDigits)+8+i64(c&15)))
			h[0] += 6
		} else if c >= 0x80 {
			// Valid UTF-8 is copied; each byte that is not part of a valid sequence becomes
			// \ufffd, as Go's encoding/json does, so the output is always valid JSON (#104).
			k := utf8_seq(p, i, n)
			if k == 0 {
				memcpy(d, cast(i64, "\\ufffd")+8, 6)
				h[0] += 6
			} else if k == 3 && c == 0xe2 && load8(p+i+1) == 0x80 && (load8(p+i+2) == 0xa8 || load8(p+i+2) == 0xa9) {
				// U+2028 and U+2029 end lines in JavaScript: escaped, as Go does.
				memcpy(d, cast(i64, "\\u202")+8, 5)
				store8(d+5, '8'+i64(load8(p+i+2)-0xa8))
				h[0] += 6
				i += 2
			} else {
				memcpy(d, p+i, k)
				h[0] += k
				i += k - 1
			}
		} else {
			store8(d, c)
			h[0]++
		}
		i++
	}
	wroom(h, 1)
	store8(h[2]+h[0], '"')
	h[0]++
}

// utf8_seq is the length of the valid UTF-8 sequence starting at byte i of the n bytes at p
// (2 to 4), or 0 when it is not one: a stray continuation byte, a truncated sequence, an
// overlong form, a surrogate or a value past U+10FFFF.
func utf8_seq(p i64, i i64, n i64) i64 {
	c := load8(p + i)
	k := 0
	lo := 0x80
	hi := 0xbf
	if c >= 0xc2 && c <= 0xdf {
		k = 2
	} else if c >= 0xe0 && c <= 0xef {
		k = 3
		if c == 0xe0 {
			lo = 0xa0
		} else if c == 0xed {
			hi = 0x9f
		}
	} else if c >= 0xf0 && c <= 0xf4 {
		k = 4
		if c == 0xf0 {
			lo = 0x90
		} else if c == 0xf4 {
			hi = 0x8f
		}
	} else {
		return 0
	}
	if i+k > n {
		return 0
	}
	c1 := i64(load8(p + i + 1))
	if c1 < lo || c1 > hi {
		return 0
	}
	for j := 2; j < k; j++ {
		cj := i64(load8(p + i + j))
		if cj < 0x80 || cj > 0xbf {
			return 0
		}
	}
	return k
}

func wuint(b mut []u8, v u64) {
	h := cast(i64, b)
	wroom(h, 21)
	n := 1
	for t := v; t >= 10; t /= 10 {
		n++
	}
	d := h[2] + h[0]
	for i := n - 1; i >= 0; i-- {
		store8(d+i, '0'+i64(v%10))
		v /= 10
	}
	h[0] += n
}

func wint(b mut []u8, v i64) {
	if v < 0 {
		h := cast(i64, b)
		wroom(h, 1)
		store8(h[2]+h[0], '-')
		h[0]++
		wuint(mut b, u64(0-v))
		return
	}
	wuint(mut b, u64(v))
}

func wbool(b mut []u8, v bool) {
	if v {
		rt_append_str(cast(i64, b), "true")
	} else {
		rt_append_str(cast(i64, b), "false")
	}
}

func wfloat(b mut []u8, v f64) {
	if v != v || v > 1.7976931348623157e308 || v < -1.7976931348623157e308 {
		rt_append_str(cast(i64, b), "null")
		return
	}
	h := cast(i64, b)
	if h[0]+40 > h[1] {
		rt_slice_grow(h, h[0]+40, 1)
	}
	h[0] += shortest_into(h[2]+h[0], v, -6, 21, true, false)
}

// wfloat32 writes an f32 in the shortest form that reads back as the same f32.
func wfloat32(b mut []u8, v f32) {
	shortF32 = true
	wfloat(mut b, f64(v))
	shortF32 = false
}

// ---- decoding ----
//
// argo.Get(s, v) fills v (a struct, slice or map) from the JSON text s and returns a fault
// for malformed input or a type mismatch. The compiler generates a decoder per type; it
// calls the r* readers below, which record the first error in the Parser and then do
// nothing, so decoders only test p.err at loop boundaries.

// maxDepth bounds the arrays and objects open at once: each holds a stack frame of rskip
// (32 bytes) or of a decoder (80 for a small struct, 240 for one of 32 fields), and a
// request task has 256 KiB of stack.
const maxDepth = 512

type Parser struct {
	s     str
	i     i64
	depth i64 // arrays and objects open at i
	err   fault
}

func parser(s str) Parser {
	return Parser{s: s}
}

func finish(p mut Parser) ! {
	if p.err != nil {
		return try p.err
	}
	ws(mut p)
	if p.i < len(p.s) {
		fail say.Fault("argo: unexpected %q after the value at offset %d", str(p.s[p.i]), p.i)
	}
}

func bad(p mut Parser, what str) {
	if p.err == nil {
		if p.i < len(p.s) {
			p.err = say.Fault("argo: expected %s at offset %d, found %q", what, p.i, str(p.s[p.i]))
		} else {
			p.err = say.Fault("argo: expected %s, found the end of the input", what)
		}
	}
	p.i = len(p.s)
}

func ws(p mut Parser) {
	s := p.s
	i := p.i
	for i < len(s) {
		c := s[i]
		if c != ' ' && c != '\n' && c != '\r' && c != '\t' {
			break
		}
		i++
	}
	p.i = i
}

// robj consumes '{' and reports whether a member follows ('}' right away is consumed).
func robj(p mut Parser) bool {
	ws(mut p)
	if p.i >= len(p.s) || p.s[p.i] != '{' {
		bad(mut p, "an object")
		return false
	}
	return nest(mut p, '}')
}

// rarr consumes '[' and reports whether an element follows.
func rarr(p mut Parser) bool {
	ws(mut p)
	if p.i >= len(p.s) || p.s[p.i] != '[' {
		bad(mut p, "an array")
		return false
	}
	return nest(mut p, ']')
}

// nest consumes the '{' or '[' at p.i and reports whether a member follows (close right
// away is consumed). The array or object counts toward maxDepth until rmore closes it.
func nest(p mut Parser, close u8) bool {
	if p.depth == maxDepth {
		bad(mut p, say.Fmt("at most %d nested arrays and objects", maxDepth))
		return false
	}
	p.i++
	ws(mut p)
	if p.i < len(p.s) && p.s[p.i] == close {
		p.i++
		return false
	}
	p.depth++
	return true
}

// rmore consumes ',' (true: another member follows) or the closing byte (false).
func rmore(p mut Parser, close u8) bool {
	ws(mut p)
	if p.i < len(p.s) {
		c := p.s[p.i]
		if c == ',' {
			p.i++
			return true
		}
		if c == close {
			p.i++
			p.depth--
			return false
		}
	}
	bad(mut p, "',' or the end of the object or array")
	return false
}

// rkey reads a member name and its ':'.
func rkey(p mut Parser) str {
	k := rstr(mut p)
	ws(mut p)
	if p.i >= len(p.s) || p.s[p.i] != ':' {
		bad(mut p, "':'")
		return ""
	}
	p.i++
	return k
}

// renum reads an enum variant's name: a bare "Name", or the key of {"Name": ...}; boxed
// reports the second form, whose payload follows (then rclose).
func renum(p mut Parser) (str, bool) {
	ws(mut p)
	if p.i < len(p.s) && p.s[p.i] == '"' {
		return rstr(mut p), false
	}
	if !robj(mut p) {
		bad(mut p, "an enum variant (\"Name\" or {\"Name\": ...})")
		return "", false
	}
	return rkey(mut p), true
}

// rclose consumes the '}' that ends a boxed enum variant.
func rclose(p mut Parser) {
	if rmore(mut p, '}') {
		bad(mut p, "the end of the enum object (one variant per value)")
	}
}

// rvariant records a fault for a variant name the enum does not have, or one given the
// wrong shape.
func rvariant(p mut Parser, name str) {
	if p.err == nil {
		p.err = say.Fault("argo: unknown or malformed enum variant %q", name)
	}
	p.i = len(p.s)
}

// rnull consumes null if it is next.
func rnull(p mut Parser) bool {
	ws(mut p)
	s := p.s
	i := p.i
	if i+4 <= len(s) && s[i] == 'n' && s[i+1] == 'u' && s[i+2] == 'l' && s[i+3] == 'l' {
		p.i = i + 4
		return true
	}
	return false
}

func hex4(s str, i i64) i64 {
	v := 0
	for k := 0; k < 4; k++ {
		c := s[i+k]
		d := -1
		if c >= '0' && c <= '9' {
			d = i64(c - '0')
		} else if c >= 'a' && c <= 'f' {
			d = i64(c-'a') + 10
		} else if c >= 'A' && c <= 'F' {
			d = i64(c-'A') + 10
		}
		if d < 0 {
			return -1
		}
		v = v*16 + d
	}
	return v
}

func rstr(p mut Parser) str {
	ws(mut p)
	s := p.s
	i := p.i
	if i >= len(s) || s[i] != '"' {
		bad(mut p, "a string")
		return ""
	}
	i++
	start := i
	for i < len(s) {
		c := s[i]
		if c == '"' {
			p.i = i + 1
			return s[start:i]
		}
		if c == '\\' || c < 0x20 {
			break
		}
		i++
	}
	b := make([]u8, 0, i-start+16)
	b = append(b, s[start:i]...)
	for i < len(s) {
		c := s[i]
		if c == '"' {
			p.i = i + 1
			return str(b)
		}
		if c < 0x20 {
			p.i = i
			bad(mut p, "an escaped control character")
			return ""
		}
		if c != '\\' {
			b = append(b, c)
			i++
			continue
		}
		if i+1 >= len(s) {
			break
		}
		e := s[i+1]
		i += 2
		if e == 'n' {
			b = append(b, '\n')
		} else if e == 't' {
			b = append(b, '\t')
		} else if e == 'r' {
			b = append(b, '\r')
		} else if e == 'b' {
			b = append(b, 8)
		} else if e == 'f' {
			b = append(b, 12)
		} else if e == '"' || e == '\\' || e == '/' {
			b = append(b, e)
		} else if e == 'u' && i+4 <= len(s) && hex4(s, i) >= 0 {
			r := hex4(s, i)
			i += 4
			if r >= 0xD800 && r < 0xDC00 && i+6 <= len(s) && s[i] == '\\' && s[i+1] == 'u' && hex4(s, i+2) >= 0xDC00 && hex4(s, i+2) < 0xE000 {
				r = 0x10000 + (r-0xD800)<<10 + (hex4(s, i+2) - 0xDC00)
				i += 6
			}
			b = append(b, str(i32(r))...)
		} else {
			p.i = i - 2
			bad(mut p, "a valid escape")
			return ""
		}
	}
	p.i = len(s)
	bad(mut p, "a closing '\"'")
	return ""
}

// rstrmax is rstr for a str max n (#240): a string longer than n bytes (decoded) fails with
// fault.LimitExceeded once its length passes n, without reading the rest of it.
func rstrmax(p mut Parser, n i64) str {
	ws(mut p)
	s := p.s
	i := p.i
	if i >= len(s) || s[i] != '"' {
		bad(mut p, "a string")
		return ""
	}
	j := i + 1
	count := 0
	for j < len(s) && count <= n {
		c := s[j]
		if c == '"' {
			return rstr(mut p)
		}
		if c == '\\' && j+1 < len(s) && s[j+1] == 'u' && j+6 <= len(s) {
			r := hex4(s, j+2)
			j += 6
			if r >= 0xD800 && r < 0xDC00 && j+6 <= len(s) && s[j] == '\\' && s[j+1] == 'u' && hex4(s, j+2) >= 0xDC00 && hex4(s, j+2) < 0xE000 {
				count += 4
				j += 6
			} else if r >= 0 && r < 0x80 {
				count++
			} else if r >= 0 && r < 0x800 {
				count += 2
			} else {
				count += 3
			}
			continue
		}
		if c == '\\' {
			j++
		}
		count++
		j++
	}
	if count <= n {
		// No closing quote: rstr reports the malformed string.
		return rstr(mut p)
	}
	over(mut p, n)
	return ""
}

// over records that the value at p is longer than its bound n (#240): fault.LimitExceeded,
// and the parser stops.
func over(p mut Parser, n i64) {
	if p.err == nil {
		p.err = cast(fault, rt_fault_wrap(rt_fault_limit(), say.Fmt("argo: the value at offset %d is longer than its bound %d", p.i, n)))
	}
	p.i = len(p.s)
}

func rint(p mut Parser) i64 {
	ws(mut p)
	s := p.s
	i := p.i
	neg := false
	if i < len(s) && s[i] == '-' {
		neg = true
		i++
	}
	if i >= len(s) || s[i] < '0' || s[i] > '9' {
		bad(mut p, "an integer")
		return 0
	}
	v := u64(0)
	top := ^u64(0)
	for i < len(s) && s[i] >= '0' && s[i] <= '9' {
		d := u64(s[i] - '0')
		if v > (top-d)/10 {
			bad(mut p, "an integer that fits in 64 bits")
			return 0
		}
		v = v*10 + d
		i++
		if v == 0 {
			// A leading 0 is the whole number: in "007" the next byte is junk after a value.
			break
		}
	}
	if i < len(s) && (s[i] == '.' || s[i] == 'e' || s[i] == 'E') {
		bad(mut p, "an integer (not a fraction)")
		return 0
	}
	if neg {
		if v > u64(9223372036854775807)+1 {
			bad(mut p, "an integer that fits in i64")
			return 0
		}
		p.i = i
		return 0 - i64(v)
	}
	if v > u64(9223372036854775807) {
		bad(mut p, "an integer that fits in i64")
		return 0
	}
	p.i = i
	return i64(v)
}

// rintr reads an integer within [lo, hi] (for the sized integer types).
func rintr(p mut Parser, lo i64, hi i64) i64 {
	at := p.i
	v := rint(mut p)
	if p.err == nil && (v < lo || v > hi) {
		p.i = at
		ws(mut p)
		bad(mut p, say.Fmt("an integer in [%d, %d]", lo, hi))
		return 0
	}
	return v
}

func ruint(p mut Parser) u64 {
	ws(mut p)
	if p.i < len(p.s) && p.s[p.i] == '-' {
		bad(mut p, "an unsigned integer")
		return 0
	}
	s := p.s
	i := p.i
	if i >= len(s) || s[i] < '0' || s[i] > '9' {
		bad(mut p, "an unsigned integer")
		return 0
	}
	v := u64(0)
	top := ^u64(0)
	for i < len(s) && s[i] >= '0' && s[i] <= '9' {
		d := u64(s[i] - '0')
		if v > (top-d)/10 {
			bad(mut p, "an integer that fits in 64 bits")
			return 0
		}
		v = v*10 + d
		i++
		if v == 0 {
			break
		}
	}
	p.i = i
	return v
}

// rnum consumes a number and returns where it starts. It matches RFC 8259's
// -?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)? as far as it goes, so "007" and "1.2.3"
// end early and fail on the byte that follows, as junk after any value does.
func rnum(p mut Parser) i64 {
	ws(mut p)
	s := p.s
	at := p.i
	i := at
	if i < len(s) && s[i] == '-' {
		i++
	}
	if i < len(s) && s[i] == '0' {
		p.i = i + 1
	} else {
		digits(mut p, i, "a number")
	}
	if p.i < len(s) && s[p.i] == '.' {
		digits(mut p, p.i+1, "a digit")
	}
	i = p.i
	if i < len(s) && (s[i] == 'e' || s[i] == 'E') {
		i++
		if i < len(s) && (s[i] == '+' || s[i] == '-') {
			i++
		}
		digits(mut p, i, "a digit")
	}
	return at
}

// digits consumes the digits at i; there must be at least one.
func digits(p mut Parser, i i64, what str) {
	s := p.s
	j := i
	for j < len(s) && s[j] >= '0' && s[j] <= '9' {
		j++
	}
	p.i = j
	if j == i {
		bad(mut p, what)
	}
}

// rfloat reads a number that fits in f64 (1e400 is a fault, as in Go).
func rfloat(p mut Parser) f64 {
	at := rnum(mut p)
	if p.err != nil {
		return 0
	}
	v := rt_parse_float(cast(i64, p.s[at:p.i])+8, 0)
	if v > 1.7976931348623157e308 || v < -1.7976931348623157e308 {
		p.i = at
		bad(mut p, "a number that fits in f64")
		return 0
	}
	return v
}

// rfloat32 reads a number that fits in f32.
func rfloat32(p mut Parser) f32 {
	at := p.i
	v := f32(rfloat(mut p))
	if f64(v) > 3.4028234663852886e38 || f64(v) < -3.4028234663852886e38 {
		p.i = at
		ws(mut p)
		bad(mut p, "a number that fits in f32")
		return 0
	}
	return v
}

func rbool(p mut Parser) bool {
	ws(mut p)
	s := p.s
	i := p.i
	if i+4 <= len(s) && s[i] == 't' && s[i+1] == 'r' && s[i+2] == 'u' && s[i+3] == 'e' {
		p.i = i + 4
		return true
	}
	if i+5 <= len(s) && s[i] == 'f' && s[i+1] == 'a' && s[i+2] == 'l' && s[i+3] == 's' && s[i+4] == 'e' {
		p.i = i + 5
		return false
	}
	bad(mut p, "true or false")
	return false
}

// rskip skips any value (an unknown member).
func rskip(p mut Parser) {
	ws(mut p)
	if p.i >= len(p.s) {
		bad(mut p, "a value")
		return
	}
	c := p.s[p.i]
	if c == '"' {
		rstr(mut p)
	} else if c == '{' {
		if robj(mut p) {
			for p.err == nil {
				rkey(mut p)
				rskip(mut p)
				if !rmore(mut p, '}') {
					break
				}
			}
		}
	} else if c == '[' {
		if rarr(mut p) {
			for p.err == nil {
				rskip(mut p)
				if !rmore(mut p, ']') {
					break
				}
			}
		}
	} else if c == 't' || c == 'f' {
		rbool(mut p)
	} else if c == 'n' {
		if !rnull(mut p) {
			bad(mut p, "a value")
		}
	} else {
		rnum(mut p)
	}
}
