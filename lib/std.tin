// Tin standard library: libc externs plus printing and string helpers.


fn streq(a, b) {
    let i = 0;
    while load8(a + i) == load8(b + i) {
        if load8(a + i) == 0 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn print(s) {
    rt_sys_write(1, s, strlen(s));
}

fn println(s) {
    print(s);
    print("\n");
}

fn print_char(c) {
    let b = c;
    rt_sys_write(1, &b, 1);
}

fn print_int(n) {
    if n < 0 {
        print_char('-');
        // Peel the last digit first so the most negative number never overflows.
        if n / 10 != 0 {
            print_int(-(n / 10));
        }
        print_char('0' - n % 10);
        return;
    }
    if n >= 10 {
        print_int(n / 10);
    }
    print_char('0' + n % 10);
}
