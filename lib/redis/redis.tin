// Package redis is a Redis client. Commands are queries: in c.Do("SET user:{id} {body}")
// the values travel as separate arguments, so a value can never change a command.
//
// Each core keeps one connection per Client. The requests a core serves at the same time
// share it: their commands are written together and the replies matched in order
// (pipelining), so a busy server makes few system calls per command. Inside a request
// task a call waits without blocking the core; outside one it blocks.
//
//	let cache = redis.Open(redis.Options{Addr: "127.0.0.1:6379"})
//	try cache.Set("greeting", "hello")
//	let (v, found) = try cache.Get("greeting")
//
// Blocking commands (BLPOP, SUBSCRIBE, ...) would hold up the commands queued behind them
// and are not supported.
package redis

import "mint"
import "say"
import "tls"
import "wire"


// Reply is one Redis reply.
type Reply enum {
	Str(v str)           // a simple, bulk or verbatim string, or a big number's digits
	Int(v i64)
	Float(v f64)         // a RESP3 double
	Bool(v bool)         // a RESP3 boolean
	Array(items []Reply) // an array, a set or a push
	Map(pairs []Reply)   // a RESP3 map: key, value, key, value, ...
	Err(msg str)         // an error inside an array or a Pipe (a lone error fails the call)
	Nil
}

// Options says where and how to connect.
type Options struct {
	Addr     str // "host:port" (default "127.0.0.1:6379")
	Username str // sent with AUTH when set (Redis 6 ACLs)
	Password str // sent with AUTH when set
	DB       i64 // selected when not 0
	Proto    i64 // 3 sends HELLO 3 and speaks RESP3; otherwise RESP2
	Timeout  i64 // ns a command may wait (0: no limit; a request's deadline still applies)
	TLS      ?tls.Config // connect over TLS 1.3 (the server name is Addr's host unless TLS.ServerName is set)
}

// ParseURL reads "redis://[[user]:password@]host[:port][/db]"; "rediss://" is the same over
// TLS 1.3 (TLS is set, so the server's certificate is verified for host).
fn ParseURL(url str) !Options {
	let o = Options{Addr: "", Username: "", Password: "", DB: 0, Proto: 0, Timeout: 0, TLS: nil}
	mut rest = ""
	if len(url) >= 9 && url[:9] == "rediss://" {
		rest = url[9:]
		o.TLS = tls.Config{ServerName: "", RootCAs: "", ALPN: []str{}, Timeout: 0, InsecureSkipVerify: false}
	} else if len(url) >= 8 && url[:8] == "redis://" {
		rest = url[8:]
	} else {
		fail say.Fault("redis: %q is not a redis:// or rediss:// URL", url)
	}
	mut slash = len(rest)
	for i in 0..len(rest) {
		if rest[i] == '/' {
			slash = i
			break
		}
	}
	let db = rest[slash:]
	rest = rest[:slash]
	mut at = -1
	for i in 0..len(rest) {
		if rest[i] == '@' {
			at = i
		}
	}
	if at >= 0 {
		let cred = rest[:at]
		rest = rest[at+1:]
		mut colon = -1
		for i in 0..len(cred) {
			if cred[i] == ':' {
				colon = i
				break
			}
		}
		if colon < 0 {
			o.Password = cred
		} else {
			o.Username = cred[:colon]
			o.Password = cred[colon+1:]
		}
	}
	if rest == "" {
		rest = "127.0.0.1"
	}
	mut hasport = false
	mut brackets = false
	for i in 0..len(rest) {
		if rest[i] == '[' {
			brackets = true
		}
		if rest[i] == ']' {
			brackets = false
		}
		if rest[i] == ':' && !brackets {
			hasport = true
		}
	}
	o.Addr = rest
	if !hasport {
		o.Addr = rest + ":6379"
	}
	if len(db) > 1 {
		let n = mint.Atoi(db[1:]) catch _ {
			fail say.Fault("redis: bad database number in %q", url)
		}
		o.DB = n
	}
	return o
}

// Client sends commands to one Redis server. Open it in a global's initializer (which
// runs on every core) or once in main, not per request.
type Client struct {
	open bool // false for the zero Client (a failed Open)
	rec  i64
}

const maxClients = 1024

// The shared record of a Client: its options, copied out of any pool.
const rAddr = 0
const rAddrN = 1
const rUser = 2
const rUserN = 3
const rPass = 4
const rPassN = 5
const rDB = 6
const rProto = 7
const rTimeout = 8
const rID = 9
const rTls = 10   // the kept tls.Config, or 0 for plain TCP
const recWords = 11

// A core's connection for one Client.
const lFd = 0
const lOut = 1    // commands not yet written
const lOutN = 2
const lOutCap = 3
const lWpos = 4   // how much of lOut is written
const lIn = 5     // bytes read, from lInS to lInE not yet delivered
const lInS = 6
const lInE = 7
const lInCap = 8
const lQ = 9      // the slots waiting for replies, in order
const lQHead = 10
const lQN = 11
const lQCap = 12
const lBusy = 13  // a task is doing the connection's I/O
const lID = 14    // the client's id: its TLS connection is tlsLines[id]
const lineWords = 15

// A slot: one caller's commands and the replies they get.
const sTask = 0
const sState = 1  // 0 waiting, 1 done, 2 failed
const sGone = 2   // the caller gave up; free the slot when its replies arrive
const sOwner = 3  // the caller must take over the connection's I/O
const sMsg = 4    // the replies, as received
const sMsgN = 5
const sMsgCap = 6
const sWant = 7   // how many replies
const sGot = 8
const sErr = 9    // why it failed
const sErrN = 10
const sHello = 11 // the connection's handshake: check it, then drop it
const slotWords = 12

shared mut nClients i64
mut lines i64 // per core: the connection of each Client, by id

// tlsLines holds each TLS connection of this core, by client id. Replacing or clearing one
// releases the old connection's memory (it is counted long-lived memory, from keep).
let tlsLines = make([]?tls.Conn, maxClients+1)

fn keep_raw(s str) i64 {
	let p = malloc(len(s) + 1)
	memcpy(p, cast(i64, s)+8, len(s))
	return p
}

// Open makes a client for the server in o. It connects on first use, on each core.
fn Open(o Options) Client {
	mut addr = o.Addr
	if addr == "" {
		addr = "127.0.0.1:6379"
	}
	let id = __atomic_add(&nClients, 1)
	if id >= maxClients {
		return Client{open: false, rec: 0}
	}
	let rec = calloc(recWords, 8)
	rec[rAddr] = keep_raw(addr)
	rec[rAddrN] = len(addr)
	rec[rUser] = keep_raw(o.Username)
	rec[rUserN] = len(o.Username)
	rec[rPass] = keep_raw(o.Password)
	rec[rPassN] = len(o.Password)
	rec[rDB] = o.DB
	rec[rProto] = o.Proto
	rec[rTimeout] = o.Timeout
	rec[rID] = id
	let cfg = o.TLS
	if cfg != nil {
		rec[rTls] = cast(i64, keep(cfg))
	}
	return Client{open: true, rec: rec}
}

fn (c Client) line() i64 {
	if lines == 0 {
		lines = calloc(maxClients+1, 8)
	}
	let id = c.rec[rID]
	mut l = lines[id]
	if l == 0 {
		l = calloc(lineWords, 8)
		l[lFd] = -1
		l[lID] = id
		lines[id] = l
	}
	return l
}

// ---- commands ----

fn is_space(c u8) bool {
	return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

fn arg_text(a qarg) str {
	match a {
		Int(v) => {
			return mint.Itoa(v)
		}
		Float(v) => {
			return mint.FormatFloat(v, 'g', -1)
		}
		Str(v) => {
			return v
		}
		Bool(v) => {
			if v {
				return "1"
			}
			return "0"
		}
		Bytes(v) => {
			return str(v)
		}
	}
}

// words splits a query into a command's arguments: the text at spaces, while a value is
// always one argument (with the text right next to it: "user:{id}" is one).
fn words(q query) []str {
	mut out = []str{}
	mut cur = ""
	mut have = false
	for i, part in q.Parts {
		mut j = 0
		for j < len(part) {
			if is_space(part[j]) {
				if have {
					out = append(out, cur)
					cur = ""
					have = false
				}
				j += 1
				continue
			}
			mut k = j
			for k < len(part) && !is_space(part[k]) {
				k += 1
			}
			cur = cur + part[j:k]
			have = true
			j = k
		}
		if i < len(q.Args) {
			cur = cur + arg_text(q.Args[i])
			have = true
		}
	}
	if have {
		out = append(out, cur)
	}
	return out
}

fn digits(v i64) i64 {
	mut n = 1
	for v >= 10 {
		v /= 10
		n += 1
	}
	return n
}

fn put_int(p i64, v i64) i64 {
	let n = digits(v)
	{
		mut i = n - 1
		for i >= 0 {
			store8(p+i, '0'+v%10)
			v /= 10
			i -= 1
		}
	}
	return p + n
}

fn out_reserve(l i64, n i64) i64 {
	if l[lOutN]+n > l[lOutCap] {
		let c = l[lOutCap]*2 + n + 4096
		l[lOut] = realloc(l[lOut], c)
		l[lOutCap] = c
	}
	let p = l[lOut] + l[lOutN]
	l[lOutN] += n
	return p
}

// encode appends args as one RESP command to the connection's output.
fn encode(l i64, args []str) {
	mut n = 3 + digits(len(args))
	for _, a in args {
		n += 5 + digits(len(a)) + len(a)
	}
	mut p = out_reserve(l, n)
	store8(p, '*')
	p = put_int(p+1, len(args))
	store8(p, '\r')
	store8(p+1, '\n')
	p += 2
	for _, a in args {
		store8(p, '$')
		p = put_int(p+1, len(a))
		store8(p, '\r')
		store8(p+1, '\n')
		memcpy(p+2, cast(i64, a)+8, len(a))
		p += 2 + len(a)
		store8(p, '\r')
		store8(p+1, '\n')
		p += 2
	}
}

// ---- the queue of slots ----

fn new_slot(want i64) i64 {
	let s = calloc(slotWords, 8)
	s[sTask] = rt_task_current()
	s[sWant] = want
	return s
}

fn free_slot(s i64) {
	if s[sMsg] != 0 {
		free(s[sMsg])
	}
	if s[sErr] != 0 {
		free(s[sErr])
	}
	free(s)
}

fn q_grow(l i64) {
	if l[lQHead]+l[lQN] < l[lQCap] {
		return
	}
	let q = l[lQ]
	if l[lQHead] > 0 {
		memmove(q, q+8*l[lQHead], 8*l[lQN])
		l[lQHead] = 0
		return
	}
	let c = l[lQCap]*2 + 32
	l[lQ] = realloc(q, 8*c)
	l[lQCap] = c
}

fn q_push(l i64, s i64) {
	q_grow(l)
	let q = l[lQ]
	q[l[lQHead]+l[lQN]] = s
	l[lQN] += 1
}

fn q_push_front(l i64, s i64) {
	if l[lQHead] == 0 {
		q_grow(l)
		let q = l[lQ]
		memmove(q+8, q, 8*l[lQN])
		l[lQHead] = 1
	}
	l[lQHead] -= 1
	let q = l[lQ]
	q[l[lQHead]] = s
	l[lQN] += 1
}

fn q_at(l i64, i i64) i64 {
	let q = l[lQ]
	return q[l[lQHead]+i]
}

fn q_pop(l i64) i64 {
	let s = q_at(l, 0)
	l[lQHead] += 1
	l[lQN] -= 1
	if l[lQN] == 0 {
		l[lQHead] = 0
	}
	return s
}

fn wake(s i64) {
	let t = s[sTask]
	if t != 0 && t != rt_task_current() {
		rt_task_wake(t)
	}
}

fn set_err(s i64, msg str) {
	s[sErr] = keep_raw(msg)
	s[sErrN] = len(msg)
}

// fail_line closes the connection and fails every caller waiting on it.
fn fail_line(l i64, msg str) {
	if l[lFd] >= 0 {
		// A TLS connection is dropped without close_notify: the descriptor goes either way.
		tlsLines[l[lID]] = nil
		rt_sys_close(l[lFd])
		l[lFd] = -1
	}
	for l[lQN] > 0 {
		let s = q_pop(l)
		if s[sGone] != 0 || s[sHello] != 0 {
			free_slot(s)
			continue
		}
		set_err(s, msg)
		s[sState] = 2
		wake(s)
	}
	l[lOutN] = 0
	l[lWpos] = 0
	l[lInS] = 0
	l[lInE] = 0
}

fn os_msg(what str, e i64) str {
	let m = rt_sys_strerror(e)
	return "redis: {what}: {rt_str_from_raw(m, strlen(m))}"
}

// hand_off gives the connection's I/O to the first caller still waiting, if any.
fn hand_off(l i64) {
	l[lBusy] = 0
	for i in 0..l[lQN] {
		let s = q_at(l, i)
		if s[sGone] == 0 && s[sHello] == 0 && s[sTask] != 0 && s[sTask] != rt_task_current() {
			s[sOwner] = 1
			l[lBusy] = 1
			rt_task_wake(s[sTask])
			return
		}
	}
}

// ---- replies ----

fn line_end(p i64, at i64) i64 {
	for load8(p+at) != '\r' {
		at += 1
	}
	return at
}

// raw_int is the decimal number at the start of the bytes [from, to) at p. It stops at the
// first byte that is not a digit, so the text of a '+' or '-' line reads as 0, and a number
// beyond the i64 range is clamped to it. It counts down from 0 so that the most negative
// i64 parses.
fn raw_int(p i64, from i64, to i64) i64 {
	mut neg = false
	if from < to && load8(p+from) == '-' {
		neg = true
		from += 1
	}
	mut v = 0
	for from < to {
		let d = i64(load8(p+from)) - '0'
		if d < 0 || d > 9 {
			break
		}
		if v < (-9223372036854775807 - 1 + d) / 10 {
			v = -9223372036854775807 - 1
			break
		}
		v = v*10 - d
		from += 1
	}
	if neg {
		return v
	}
	if v == -9223372036854775807 - 1 {
		return 9223372036854775807
	}
	return -v
}

// resp_len is the length of the first complete reply in the n bytes at p: -1 while it
// is incomplete, -2 when the bytes are not RESP.
fn resp_len(p i64, n i64) i64 {
	mut need = 1
	mut at = 0
	for need > 0 {
		if at >= n {
			return -1
		}
		let t = load8(p + at)
		mut e = at + 1
		for e+1 < n && load8(p+e) != '\r' {
			e += 1
		}
		if e+1 >= n {
			return -1
		}
		if load8(p+e+1) != '\n' {
			return -2
		}
		let v = raw_int(p, at+1, e)
		at = e + 2
		need -= 1
		if t == '$' || t == '=' || t == '!' {
			if v >= 0 {
				at += v + 2
				if at > n {
					return -1
				}
			}
		} else if t == '*' || t == '~' || t == '>' {
			if v > 0 {
				need += v
			}
		} else if t == '%' {
			if v > 0 {
				need += 2 * v
			}
		} else if t == '|' {
			need += 2*v + 1
		} else if t != '+' && t != '-' && t != ':' && t != '_' && t != ',' && t != '#' && t != '(' {
			return -2
		}
	}
	return at
}

fn reply_items(p i64, at i64, n i64) ([]Reply, i64) {
	mut items = make([]Reply, 0, n)
	for i in 0..n {
		let (r, next) = reply_at(p, at)
		items = append(items, r)
		at = next
	}
	return items, at
}

// reply_at reads the complete reply at p+at; it returns the reply and where the next starts.
fn reply_at(p i64, at i64) (Reply, i64) {
	let t = load8(p + at)
	let e = line_end(p, at+1)
	let line = rt_str_from_raw(p+at+1, e-at-1)
	let next = e + 2
	if t == '+' || t == '(' {
		return Reply.Str(line), next
	}
	if t == '-' {
		return Reply.Err(line), next
	}
	if t == ':' {
		return Reply.Int(raw_int(p, at+1, e)), next
	}
	if t == '_' {
		return Reply.Nil, next
	}
	if t == '#' {
		return Reply.Bool(line == "t"), next
	}
	if t == ',' {
		mut f = mint.ParseFloat(line) catch _ { 0.0 }
		if line == "inf" {
			f = 1.0e308 * 10.0
		} else if line == "-inf" {
			f = -1.0e308 * 10.0
		}
		return Reply.Float(f), next
	}
	let n = raw_int(p, at+1, e)
	if t == '$' || t == '=' || t == '!' {
		if n < 0 {
			return Reply.Nil, next
		}
		mut s = rt_str_from_raw(p+next, n)
		if t == '=' && n >= 4 {
			s = s[4:]
		}
		if t == '!' {
			return Reply.Err(s), next + n + 2
		}
		return Reply.Str(s), next + n + 2
	}
	if n < 0 {
		return Reply.Nil, next
	}
	if t == '%' {
		let (pairs, after) = reply_items(p, next, 2*n)
		return Reply.Map(pairs), after
	}
	if t == '|' {
		let (_, after) = reply_items(p, next, 2*n)
		return reply_at(p, after)
	}
	let (items, after) = reply_items(p, next, n)
	return Reply.Array(items), after
}

// deliver hands each complete reply to the slot at the front of the queue.
fn deliver(l i64) {
	for l[lQN] > 0 {
		let p = l[lIn] + l[lInS]
		let n = resp_len(p, l[lInE]-l[lInS])
		if n == -1 {
			break
		}
		if n < 0 {
			fail_line(l, "redis: the server sent something that is not RESP")
			return
		}
		let s = q_at(l, 0)
		if s[sMsgN]+n > s[sMsgCap] {
			let c = s[sMsgCap]*2 + n
			s[sMsg] = realloc(s[sMsg], c)
			s[sMsgCap] = c
		}
		memcpy(s[sMsg]+s[sMsgN], p, n)
		s[sMsgN] += n
		l[lInS] += n
		s[sGot] += 1
		if s[sGot] < s[sWant] {
			continue
		}
		q_pop(l)
		if s[sHello] != 0 {
			let bad = hello_error(s)
			free_slot(s)
			if bad != "" {
				fail_line(l, "redis: connecting: {bad}")
				return
			}
		} else if s[sGone] != 0 {
			free_slot(s)
		} else {
			s[sState] = 1
			wake(s)
		}
	}
	if l[lInS] == l[lInE] {
		l[lInS] = 0
		l[lInE] = 0
	}
}

fn hello_error(s i64) str {
	mut at = 0
	for at < s[sMsgN] {
		let (r, next) = reply_at(s[sMsg], at)
		match r {
			Err(m) => {
				return m
			}
			_ => {
			}
		}
		at = next
	}
	return ""
}

// ---- the connection ----

// connect dials and queues the handshake (HELLO or AUTH, then SELECT) ahead of everything.
fn connect(l i64, rec i64) ! {
	let addr = rt_str_from_raw(rec[rAddr], rec[rAddrN])
	if rec[rTls] != 0 {
		let base = cast(tls.Config, rec[rTls])
		let cfg = tls.Config{ServerName: base.ServerName, RootCAs: base.RootCAs, ALPN: base.ALPN, Timeout: rec[rTimeout], InsecureSkipVerify: base.InsecureSkipVerify,
			Certificate: base.Certificate, Key: base.Key, MinVersion: base.MinVersion}
		let tc = try tls.Dial(addr, cfg)
		tc.SetTimeout(rec[rTimeout])
		l[lFd] = tc.Fd()
		tlsLines[l[lID]] = keep(tc)
	} else {
		let conn = try wire.DialTimeout(addr, rec[rTimeout])
		l[lFd] = conn.Fd()
	}
	mut user = rt_str_from_raw(rec[rUser], rec[rUserN])
	let pass = rt_str_from_raw(rec[rPass], rec[rPassN])
	mut cmds = [][]str{}
	if rec[rProto] == 3 {
		mut hello = []str{"HELLO", "3"}
		if pass != "" {
			if user == "" {
				user = "default"
			}
			hello = append(hello, "AUTH", user, pass)
		}
		cmds = append(cmds, hello)
	} else if pass != "" {
		if user != "" {
			cmds = append(cmds, []str{"AUTH", user, pass})
		} else {
			cmds = append(cmds, []str{"AUTH", pass})
		}
	}
	if rec[rDB] != 0 {
		cmds = append(cmds, []str{"SELECT", mint.Itoa(rec[rDB])})
	}
	if len(cmds) == 0 {
		return
	}
	// The queued commands move behind the handshake.
	let queued = l[lOutN]
	for _, c in cmds {
		encode(l, c)
	}
	let n = l[lOutN] - queued
	if queued > 0 {
		let tmp = malloc(n)
		memcpy(tmp, l[lOut]+queued, n)
		memmove(l[lOut]+n, l[lOut], queued)
		memcpy(l[lOut], tmp, n)
		free(tmp)
	}
	let s = new_slot(len(cmds))
	s[sHello] = 1
	q_push_front(l, s)
}

// give_up ends a wait that ran out of time: the slot stays queued for its replies.
fn give_up(l i64, s i64, r i64) ! {
	s[sGone] = 1
	if s[sOwner] != 0 || l[lBusy] == 0 {
		hand_off(l)
	}
	if r == waitDeadline {
		fail cast(fault, rt_wait_fault())
	}
	fail "redis: timed out"
}

// drive does the connection's I/O until s has its replies: writes what is queued, reads,
// and hands replies to their slots. Then it passes the I/O on to a caller still waiting.
fn drive(l i64, s i64, rec i64) ! {
	if l[lFd] >= 0 && l[lQN] == 1 && l[lOutN] > 0 && l[lWpos] == 0 && l[lInE] == 0 {
		// An idle connection the server may have closed (a restart, an idle timeout): find
		// out before sending, so the command goes on a new connection instead of failing.
		let b = calloc(1, 8)
		let k = rt_sys_recv(l[lFd], b, 1, 2)
		free(b)
		if k == 0 || (k < 0 && rt_errno() != EAGAIN && rt_errno() != EINTR) {
			rt_sys_close(l[lFd])
			l[lFd] = -1
		}
	}
	if l[lFd] < 0 {
		let err = connect(l, rec)
		if err != nil {
			fail_line(l, say.Str(err))
			hand_off(l)
			return
		}
	}
	// Let the core run the other requests of this turn first: their commands go out with ours.
	rt_task_defer()
	let timeout = rec[rTimeout]
	for s[sState] == 0 {
		let fd = l[lFd]
		let tc = tlsLines[l[lID]]
		if tc != nil && l[lWpos] < l[lOutN] {
			// A TLS write waits inside tls (records cannot be half sent); a fault drops the
			// connection.
			let err = tc.Write(rt_str_from_raw(l[lOut]+l[lWpos], l[lOutN]-l[lWpos]))
			if err != nil {
				fail_line(l, say.Str(err))
				break
			}
			l[lWpos] = 0
			l[lOutN] = 0
			continue
		}
		if l[lWpos] < l[lOutN] {
			let k = rt_sys_write(fd, l[lOut]+l[lWpos], l[lOutN]-l[lWpos])
			if k > 0 {
				l[lWpos] += k
				if l[lWpos] == l[lOutN] {
					l[lWpos] = 0
					l[lOutN] = 0
				}
				continue
			}
			let e = rt_errno()
			if e == EINTR {
				continue
			}
			if e == EAGAIN {
				let r = rt_task_wait(fd, 2, timeout)
				if r != waitReady {
					fail give_up(l, s, r)
				}
				continue
			}
			fail_line(l, os_msg("write", e))
			break
		}
		deliver(l)
		if s[sState] != 0 || l[lOutN] > 0 {
			continue
		}
		if l[lInE] == l[lInCap] {
			let c = l[lInCap]*2 + 16384
			l[lIn] = realloc(l[lIn], c)
			l[lInCap] = c
		}
		if tc != nil {
			let buf = make([]u8, 0, l[lInCap]-l[lInE])
			let (got, rerr) = tc.ReadNow(mut buf, l[lInCap]-l[lInE])
			if rerr != nil {
				fail_line(l, say.Str(rerr))
				break
			}
			if got > 0 {
				memcpy(l[lIn]+l[lInE], cast(i64, buf)[2], got)
				l[lInE] += got
				continue
			}
			let r = rt_task_wait(fd, 1, timeout)
			if r != waitReady {
				fail give_up(l, s, r)
			}
			continue
		}
		let k = rt_sys_read(fd, l[lIn]+l[lInE], l[lInCap]-l[lInE])
		if k > 0 {
			l[lInE] += k
			continue
		}
		if k == 0 {
			fail_line(l, "redis: the server closed the connection")
			break
		}
		let e = rt_errno()
		if e == EINTR {
			continue
		}
		if e == EAGAIN {
			let r = rt_task_wait(fd, 1, timeout)
			if r != waitReady {
				fail give_up(l, s, r)
			}
			continue
		}
		fail_line(l, os_msg("read", e))
	}
	hand_off(l)
}

// exchange sends commands and waits for their replies; it returns the finished slot.
fn (c Client) exchange(cmds [][]str) !i64 {
	if !c.open {
		fail "redis: the client is not open (too many clients: open one per server, not per request)"
	}
	for _, a in cmds {
		if len(a) == 0 {
			fail "redis: an empty command"
		}
	}
	let l = c.line()
	for _, a in cmds {
		encode(l, a)
	}
	let s = new_slot(len(cmds))
	q_push(l, s)
	if l[lBusy] == 0 {
		l[lBusy] = 1
		s[sOwner] = 1
	}
	for s[sState] == 0 {
		if s[sOwner] != 0 {
			try drive(l, s, c.rec)
			continue
		}
		let r = rt_task_park(c.rec[rTimeout])
		if r != waitReady {
			fail give_up(l, s, r)
		}
	}
	if s[sState] == 2 {
		let m = rt_str_from_raw(s[sErr], s[sErrN])
		free_slot(s)
		fail m
	}
	return s
}

// ---- recording and replay (notes/interface_replay.md, section 4; #241) ----

// The client and commands of the exchange an effect body makes (read at its start).
mut tapedClient i64
mut tapedCmds i64

// exchange_taped records or replays one exchange as redis@1: the key is the commands (each word
// as its length, ":" and its bytes; a value written with a secret is its handle), the result
// the raw replies; it returns a slot holding them.
fn (c Client) exchange_taped(tp i64, cmds [][]str, qs []query) !i64 {
	for _, a in cmds {
		if len(a) == 0 {
			fail "redis: an empty command"
		}
	}
	mut k = make([]u8, 0, 64)
	for _, q in qs {
		mut a = words(q)
		if q.Hidden != 0 {
			a = key_words(q)
		}
		for i, w in a {
			if i > 0 {
				k = append(k, ' ')
			}
			k = append(k, mint.Itoa(len(w))...)
			k = append(k, ':')
			k = append(k, w...)
		}
		k = append(k, '\n')
	}
	tapedClient = cast(i64, c)
	tapedCmds = cast(i64, cmds)
	let v = try rt_effect(tp, "redis@1", str(k), exchange_live)
	if len(cmds) > 0 && !replies_fit(v, len(cmds)) {
		fail "replay: redis@1 replies are damaged"
	}
	let s = new_slot(len(cmds))
	s[sMsg] = malloc(len(v) + 1)
	memcpy(s[sMsg], cast(i64, v)+8, len(v))
	s[sMsgN] = len(v)
	s[sMsgCap] = len(v) + 1
	s[sGot] = len(cmds)
	s[sState] = 1
	return s
}

fn exchange_live() !str {
	let c = cast(Client, tapedClient)
	let s = try c.exchange(cast([][]str, tapedCmds))
	let v = rt_str_from_raw(s[sMsg], s[sMsgN])
	free_slot(s)
	return v
}

// key_words is words(q) with each value written with a secret replaced by its handle.
fn key_words(q query) []str {
	mut args = make([]qarg, 0, len(q.Args))
	for i, a in q.Args {
		if i < 64 && (q.Hidden>>u64(i))&1 != 0 {
			args = append(args, qarg.Str(rt_secret_key(arg_text(a))))
		} else {
			args = append(args, a)
		}
	}
	return words(query{Parts: q.Parts, Args: args})
}

// replies_fit reports whether v holds exactly n complete replies.
fn replies_fit(v str, n i64) bool {
	let p = cast(i64, v) + 8
	mut at = 0
	for i in 0..n {
		let k = resp_len(p+at, len(v)-at)
		if k <= 0 {
			return false
		}
		at += k
	}
	return at == len(v)
}

// Do sends one command and returns its reply; an error reply fails.
fn (c Client) Do(q query) !Reply {
	let tp = rt_tape()
	if tp != 0 && c.open {
		let s = try c.exchange_taped(tp, [][]str{words(q)}, []query{q}) // recorded for replay (#241)
		let (r, _) = reply_at(s[sMsg], 0)
		free_slot(s)
		match r {
			Err(m) => {
				fail "redis: {m}"
			}
			_ => {
			}
		}
		return r
	}
	let s = try c.exchange([][]str{words(q)})
	let (r, _) = reply_at(s[sMsg], 0)
	free_slot(s)
	match r {
		Err(m) => {
			fail "redis: {m}"
		}
		_ => {
		}
	}
	return r
}

// Pipe sends commands together and returns their replies in order; error replies come
// back as Err. The commands go out back to back, so MULTI ... EXEC in one Pipe is atomic.
fn (c Client) Pipe(qs []query) ![]Reply {
	mut cmds = [][]str{}
	for _, q in qs {
		cmds = append(cmds, words(q))
	}
	if len(cmds) == 0 {
		return []Reply{}
	}
	let tp = rt_tape()
	if tp != 0 && c.open {
		let s = try c.exchange_taped(tp, cmds, qs) // recorded for replay (#241)
		let (items, _) = reply_items(s[sMsg], 0, len(cmds))
		free_slot(s)
		return items
	}
	let s = try c.exchange(cmds)
	let (items, _) = reply_items(s[sMsg], 0, len(cmds))
	free_slot(s)
	return items
}

fn unexpected(cmd str, r Reply) ! {
	fail "redis: unexpected reply to {cmd}: {r}"
}

// Get returns the value at key, and whether there is one.
fn (c Client) Get(key str) !(str, bool) {
	let r = try c.Do("GET {key}")
	match r {
		Str(v) => {
			return v, true
		}
		Nil => {
			return "", false
		}
		_ => {
		}
	}
	fail unexpected("GET", r)
}

// Set stores value at key.
fn (c Client) Set(key str, value str) ! {
	_ = try c.Do("SET {key} {value}")
}

// SetEx stores value at key for ttl nanoseconds (at least a millisecond).
fn (c Client) SetEx(key str, value str, ttl i64) ! {
	mut ms = ttl / 1000000
	if ms < 1 {
		ms = 1
	}
	_ = try c.Do("SET {key} {value} PX {ms}")
}

fn int_reply(cmd str, r Reply) !i64 {
	match r {
		Int(v) => {
			return v
		}
		_ => {
		}
	}
	fail unexpected(cmd, r)
}

// Del removes key; it returns how many keys it removed (0 or 1).
fn (c Client) Del(key str) !i64 {
	let r = try c.Do("DEL {key}")
	return try int_reply("DEL", r)
}

// Incr adds one to the integer at key and returns the result.
fn (c Client) Incr(key str) !i64 {
	let r = try c.Do("INCR {key}")
	return try int_reply("INCR", r)
}

// Expire makes key expire after ttl nanoseconds; false when there is no such key.
fn (c Client) Expire(key str, ttl i64) !bool {
	mut ms = ttl / 1000000
	if ms < 1 {
		ms = 1
	}
	let r = try c.Do("PEXPIRE {key} {ms}")
	let n = try int_reply("PEXPIRE", r)
	return n == 1
}

// Ping checks that the server answers.
fn (c Client) Ping() ! {
	_ = try c.Do("PING")
}
