package kafka

import "fault"
import "say"
import "tls"
import "wire"

// Connections. Each core keeps one connection per broker for each Client. The requests a core
// serves at the same time share a connection: their frames are written together and the
// responses matched in order (a Kafka broker answers one connection's requests in the order it
// received them), so a busy service makes few system calls per request. Inside a request task a
// call waits without blocking the core; outside one it blocks. The design is the one of the
// redis client, with Kafka's length-prefixed frames in place of RESP.
//
// A new connection first asks the broker which request versions it speaks (ApiVersions) and
// authenticates (SASL PLAIN or SCRAM); the requests already queued go out after that.

// maxClients guards against opening a client per request: each Open keeps its record.
const maxClients = 65536
const maxBrokers = 64 // connections one client keeps at once, per core (an idle one is reused)
const maxFrame = 256 * 1024 * 1024
const defaultTimeout = 30000000000 // ns a request may wait when Options.Timeout is 0 (Java's request.timeout.ms)

// The shared record of a Client: its options, copied out of any pool.
const rClient = 0
const rClientN = 1
const rUser = 2
const rUserN = 3
const rPass = 4
const rPassN = 5
const rTimeout = 6
const rID = 7
const rTls = 8      // the kept tls.Config, or 0 for plain TCP
const rAcks = 9
const rFetchMax = 10
const rBoots = 11   // the bootstrap addresses, comma separated
const rBootsN = 12
const rMech = 13    // 0 PLAIN, 1 SCRAM-SHA-256, 2 SCRAM-SHA-512
const rCodec = 14
const rIdem = 15    // 1: idempotent producer
const rBatchMax = 16
const rIsolation = 17
const rLinger = 18
const recWords = 19

// A core's connection to one broker.
const lFd = 0
const lOut = 1    // frames not yet written
const lOutN = 2
const lOutCap = 3
const lWpos = 4   // how much of lOut is written
const lIn = 5     // bytes read, from lInS to lInE not yet delivered
const lInS = 6
const lInE = 7
const lInCap = 8
const lQ = 9      // the slots waiting for responses, in order
const lQHead = 10
const lQN = 11
const lQCap = 12
const lBusy = 13  // a task is doing the connection's I/O (no task waits on the line while it is 0)
const lUsed = 14  // when the line was last asked for (a per-core count): the least recent is reused first
const lCorr = 15  // the next correlation id
const lAddr = 16  // the line's key: the broker's address, and a lane mark for requests it may hold
const lAddrN = 17
const lVers = 18  // the broker's version range of each request: min, max (calloc'd), 0 before the handshake
const lRetired = 19 // 1: takes no new requests (its SASL session ends, KIP-368); closed once drained
const lReauth = 20  // mono ns past which the connection must authenticate again (KIP-368), 0 for never
const lAbort = 21   // why another task ended the connection (Close, a timeout): the task doing its I/O fails it
const lAbortN = 22
const lineWords = 23

// A slot: one caller's request and the response it gets.
const sTask = 0
const sState = 1    // 0 waiting, 1 done, 2 failed
const sGone = 2     // the caller gave up; free the slot when its response arrives
const sOwner = 3    // the caller must take over the connection's I/O
const sMsg = 4      // the response, without its size
const sMsgN = 5
const sErr = 6      // why it failed
const sErrN = 7
const sNoReply = 8  // a request the broker does not answer (acks 0): done once written
const sCorr = 9     // the correlation id the response must carry
const slotWords = 10

// The start of the message of a failed SASL handshake, which call turns into ErrAuth.
const authFailed = "kafka: connecting: authentication failed"

// The reason Close gives the requests it ends, which call turns into ErrClosed.
const closedMsg = "kafka: the client was closed"

shared mut nClients i64

// lineTables holds this core's connections of each client, by client id: maxBrokers words
// (calloc'd on first use), each a line or 0.
let lineTables = make(map[i64]i64)
mut lineTick i64

// tlsLines holds the TLS layer of this core's connections, by line. Replacing or removing one
// releases the old connection's memory (it is counted long-lived memory, from keep).
let tlsLines = make(map[i64]?tls.Conn)

fn keep_raw(s str) i64 {
	let p = malloc(len(s) + 1)
	memcpy(p, cast(i64, s)+8, len(s))
	return p
}

fn raw_str(p i64, n i64) str {
	return rt_str_from_raw(p, n)
}

// A broker answers one request of a connection at a time, so a request it may hold (a fetch
// waiting for records, a JoinGroup waiting for the other members) would hold up every request
// behind it. Those go on a second connection to the broker, keyed by the address and this mark;
// a group's JoinGroup and SyncGroup on one of the group's own, so that one group's rebalance
// holds up neither another group's nor the fetches.
const waitLane = "#wait"

fn holds(api i64) bool {
	return api == apiFetch || api == apiJoinGroup || api == apiSyncGroup
}

// laneKey is the key of the line a request goes on: the broker's address, with a lane mark for
// a request the broker may hold.
fn laneKey(addr str, group str, api i64) str {
	if !holds(api) {
		return addr
	}
	if group != "" && api != apiFetch {
		return addr + waitLane + ":" + group
	}
	return addr + waitLane
}

// dialAddr is the address a line connects to (its key without the lane mark).
fn dialAddr(l i64) str {
	let key = raw_str(l[lAddr], l[lAddrN])
	for i in 0..len(key) {
		if key[i] == '#' {
			return key[:i]
		}
	}
	return key
}

// line is the core's connection record for key, made on first use. When the client keeps
// maxBrokers connections already, the one no task has used for longest is closed and reused (a
// broker no longer in the cluster, a lane no longer used); it is 0 when every one is in use.
fn (c Client) line(key str) i64 {
	let id = c.rec[rID]
	mut t = lineTables[id]
	if t == 0 {
		t = calloc(maxBrokers, 8)
		lineTables[id] = t
	}
	lineTick += 1
	mut spare = -1
	for k in 0..maxBrokers {
		let l = t[k]
		if l == 0 {
			if spare < 0 || t[spare] != 0 {
				spare = k
			}
			continue
		}
		if l[lRetired] == 0 && l[lAddrN] == len(key) && raw_str(l[lAddr], l[lAddrN]) == key {
			l[lUsed] = lineTick
			return l
		}
		// No task waits on a line that is not busy (its queue holds only slots whose callers
		// left), so it can be closed.
		if l[lBusy] == 0 && (spare < 0 || (t[spare] != 0 && l[lUsed] < t[spare][lUsed])) {
			spare = k
		}
	}
	if spare < 0 {
		return 0
	}
	mut l = t[spare]
	if l == 0 {
		l = calloc(lineWords, 8)
		l[lFd] = -1
		t[spare] = l
	} else {
		fail_line(l, "kafka: the connection was closed")
		free(l[lAddr])
		l[lRetired] = 0
	}
	l[lAddr] = keep_raw(key)
	l[lAddrN] = len(key)
	l[lUsed] = lineTick
	return l
}

// ---- the queue of slots ----

fn new_slot(corr i64) i64 {
	let s = calloc(slotWords, 8)
	s[sTask] = rt_task_current()
	s[sCorr] = corr
	return s
}

fn free_slot(s i64) {
	if s[sMsg] != 0 {
		free(s[sMsg])
	}
	if s[sErr] != 0 {
		free(s[sErr])
	}
	free(s)
}

fn q_grow(l i64) {
	if l[lQHead]+l[lQN] < l[lQCap] {
		return
	}
	let q = l[lQ]
	if l[lQHead] > 0 {
		memmove(q, q+8*l[lQHead], 8*l[lQN])
		l[lQHead] = 0
		return
	}
	let cap = l[lQCap]*2 + 32
	l[lQ] = realloc(q, 8*cap)
	l[lQCap] = cap
}

fn q_push(l i64, s i64) {
	q_grow(l)
	let q = l[lQ]
	q[l[lQHead]+l[lQN]] = s
	l[lQN] += 1
}

fn q_at(l i64, i i64) i64 {
	let q = l[lQ]
	return q[l[lQHead]+i]
}

fn q_pop(l i64) i64 {
	let s = q_at(l, 0)
	l[lQHead] += 1
	l[lQN] -= 1
	if l[lQN] == 0 {
		l[lQHead] = 0
	}
	return s
}

fn wake(s i64) {
	let t = s[sTask]
	if t != 0 && t != rt_task_current() {
		rt_task_wake(t)
	}
}

fn set_err(s i64, msg str) {
	s[sErr] = keep_raw(msg)
	s[sErrN] = len(msg)
}

// close_line drops the connection without failing anyone (its queue is empty or about to be
// failed). Only the task doing the line's I/O, or any task while none does, may close it: a
// descriptor closed under another task's wait would leave that task asleep.
fn close_line(l i64) {
	if l[lFd] >= 0 {
		// A TLS connection is dropped without close_notify: the descriptor goes either way.
		delete(tlsLines, l)
		rt_sys_close(l[lFd])
		l[lFd] = -1
	}
	if l[lVers] != 0 {
		free(l[lVers])
		l[lVers] = 0
	}
	l[lReauth] = 0
}

// fail_line closes the connection and fails every caller waiting on it, with the reason another
// task gave (drop_line) when there is one.
fn fail_line(l i64, msg str) {
	close_line(l)
	mut why = msg
	if l[lAbort] != 0 {
		why = raw_str(l[lAbort], l[lAbortN])
	}
	for l[lQN] > 0 {
		let s = q_pop(l)
		if s[sGone] != 0 {
			free_slot(s)
			continue
		}
		set_err(s, why)
		s[sState] = 2
		wake(s)
	}
	if l[lAbort] != 0 {
		free(l[lAbort])
		l[lAbort] = 0
	}
	l[lOutN] = 0
	l[lWpos] = 0
	l[lInS] = 0
	l[lInE] = 0
}

// drop_line ends the connection and fails its callers with msg. When another task is doing its
// I/O (owner false and the line busy), the socket is shut down instead of closed: that task's
// wait ends, and it fails the line itself with msg (closing the descriptor under its wait would
// leave it asleep, and the number could be reused for another connection under it).
fn drop_line(l i64, owner bool, msg str) {
	if owner || l[lBusy] == 0 {
		fail_line(l, msg)
		return
	}
	if l[lFd] >= 0 && l[lAbort] == 0 {
		l[lAbort] = keep_raw(msg)
		l[lAbortN] = len(msg)
		rt_sys_shutdown(l[lFd], 2)
	}
}

fn os_msg(what str, e i64) str {
	let m = rt_sys_strerror(e)
	return "kafka: {what}: {raw_str(m, strlen(m))}"
}

// hand_off gives the connection's I/O to the first caller still waiting, if any. It runs in the
// task that did the I/O (or when none did), so a drop another task asked for happens here; a
// retired line whose requests are done is closed.
fn hand_off(l i64) {
	if l[lAbort] != 0 {
		fail_line(l, "")
	}
	l[lBusy] = 0
	for i in 0..l[lQN] {
		let s = q_at(l, i)
		if s[sGone] == 0 && s[sTask] != 0 && s[sTask] != rt_task_current() {
			s[sOwner] = 1
			l[lBusy] = 1
			rt_task_wake(s[sTask])
			return
		}
	}
	if l[lRetired] != 0 && l[lQN] == 0 && l[lOutN] == 0 {
		close_line(l)
	}
}

// ---- responses ----

fn be32raw(p i64) i64 {
	let v = u32(load8(p))<<24 | u32(load8(p+1))<<16 | u32(load8(p+2))<<8 | u32(load8(p+3))
	return i64(i32(v))
}

// frame_ready is the size of the complete frame at the start of the read buffer, -1 while it
// is incomplete (after making room for it), -2 when the size is not believable.
fn frame_ready(l i64) i64 {
	let have = l[lInE] - l[lInS]
	if have < 4 {
		return -1
	}
	let p = l[lIn] + l[lInS]
	let size = be32raw(p)
	if size < 4 || size > maxFrame {
		return -2
	}
	if have < 4+size {
		// Make room for the rest of a large frame in one step.
		if l[lInS]+4+size > l[lInCap] {
			if l[lInS] > 0 {
				memmove(l[lIn], p, have)
				l[lInE] = have
				l[lInS] = 0
			}
			if 4+size > l[lInCap] {
				l[lIn] = realloc(l[lIn], 4+size)
				l[lInCap] = 4 + size
			}
		}
		return -1
	}
	return size
}

// deliver hands each complete response to the slot at the front of the queue.
fn deliver(l i64) {
	for l[lQN] > 0 {
		let size = frame_ready(l)
		if size == -1 {
			break
		}
		if size == -2 {
			fail_line(l, "kafka: the broker sent a frame of {be32raw(l[lIn]+l[lInS])} bytes")
			return
		}
		let p = l[lIn] + l[lInS]
		let s = q_at(l, 0)
		let corr = be32raw(p + 4)
		if corr != s[sCorr] {
			fail_line(l, "kafka: the broker answered request {corr} where {s[sCorr]} was next")
			return
		}
		s[sMsg] = malloc(size + 1)
		memcpy(s[sMsg], p+4, size)
		s[sMsgN] = size
		l[lInS] += 4 + size
		q_pop(l)
		if s[sGone] != 0 {
			free_slot(s)
		} else {
			s[sState] = 1
			wake(s)
		}
	}
	if l[lInS] == l[lInE] {
		l[lInS] = 0
		l[lInE] = 0
	}
}

// ---- the handshake ----

fn next_corr(l i64) i64 {
	let n = l[lCorr]
	l[lCorr] = (n + 1) & 0x7fffffff
	return n
}

// write_all writes n bytes at p on the connection, waiting as needed (the handshake's writes).
fn write_all(l i64, p i64, n i64, timeout i64) ! {
	let tc = tlsLines[l]
	if tc != nil {
		try tc.Write(raw_str(p, n))
		return
	}
	mut done = 0
	for done < n {
		let k = rt_sys_write(l[lFd], p+done, n-done)
		if k > 0 {
			done += k
			continue
		}
		let e = rt_errno()
		if e == EINTR {
			continue
		}
		if e == EAGAIN {
			let r = rt_task_wait(l[lFd], 2, timeout)
			if r == waitDeadline {
				fail cast(fault, rt_wait_fault())
			}
			if r != waitReady {
				fail "kafka: timed out connecting"
			}
			continue
		}
		fail os_msg("write", e)
	}
}

// read_frame reads one whole frame into the read buffer and returns its size; the frame is at
// lIn+lInS+4 until the caller moves lInS on.
fn read_frame(l i64, timeout i64) !i64 {
	for {
		let size = frame_ready(l)
		if size == -2 {
			fail "kafka: the broker sent a frame of {be32raw(l[lIn]+l[lInS])} bytes"
		}
		if size >= 0 {
			return size
		}
		if l[lInE] == l[lInCap] {
			let cap = l[lInCap]*2 + 16384
			l[lIn] = realloc(l[lIn], cap)
			l[lInCap] = cap
		}
		let tc = tlsLines[l]
		if tc != nil {
			let got = try tc.ReadNowTo(l[lIn]+l[lInE], l[lInCap]-l[lInE])
			if got > 0 {
				l[lInE] += got
				continue
			}
		} else {
			let k = rt_sys_read(l[lFd], l[lIn]+l[lInE], l[lInCap]-l[lInE])
			if k > 0 {
				l[lInE] += k
				continue
			}
			if k == 0 {
				fail "kafka: the broker closed the connection"
			}
			let e = rt_errno()
			if e == EINTR {
				continue
			}
			if e != EAGAIN {
				fail os_msg("read", e)
			}
		}
		let r = rt_task_wait(l[lFd], 1, timeout)
		if r == waitDeadline {
			fail cast(fault, rt_wait_fault())
		}
		if r != waitReady {
			fail "kafka: timed out connecting"
		}
	}
}

// hs_call sends one handshake request and returns its response after the correlation id.
fn hs_call(l i64, client str, api i64, body []u8, timeout i64) !str {
	let corr = next_corr(l)
	mut req = request(api, version(api), corr, client)
	req = append(req, body...)
	finish(mut req)
	try write_all(l, cast(i64, req)[2], len(req), timeout)
	let size = try read_frame(l, timeout)
	let p = l[lIn] + l[lInS]
	if be32raw(p+4) != corr {
		fail "kafka: the broker answered request {be32raw(p+4)} where {corr} was next"
	}
	let resp = raw_str(p+8, size-4)
	l[lInS] += 4 + size
	if l[lInS] == l[lInE] {
		l[lInS] = 0
		l[lInE] = 0
	}
	return resp
}

// handshake learns the broker's request versions and authenticates the connection.
fn handshake(l i64, rec i64, timeout i64) ! {
	let client = raw_str(rec[rClient], rec[rClientN])
	let av = try hs_call(l, client, apiApiVersions, make([]u8, 0), timeout)
	mut d = newDec(av)
	let code = d.i16()
	let vers = calloc(apiCount*2, 8)
	for i in 0..apiCount*2 {
		vers[i] = -1
	}
	let n = d.count()
	for i in 0..n {
		let api = d.i16()
		let lo = d.i16()
		let hi = d.i16()
		if api >= 0 && api < apiCount {
			vers[2*api] = lo
			vers[2*api+1] = hi
		}
	}
	if d.bad || (code != 0 && n == 0) {
		free(vers)
		fail "kafka: connecting: the broker's ApiVersions answer is damaged ({errName(code)})"
	}
	l[lVers] = vers
	let user = raw_str(rec[rUser], rec[rUserN])
	let pass = raw_str(rec[rPass], rec[rPassN])
	if user == "" && pass == "" {
		return
	}
	let mech = rec[rMech]
	mut name = "PLAIN"
	if mech == 1 {
		name = "SCRAM-SHA-256"
	} else if mech == 2 {
		name = "SCRAM-SHA-512"
	}
	mut hb = make([]u8, 0, 32)
	putStr(mut hb, name)
	let hr = try hs_call(l, client, apiSaslHandshake, hb, timeout)
	mut hd = newDec(hr)
	let hcode = hd.i16()
	let offered = hd.strs()
	if hcode != 0 {
		fail "kafka: connecting: the broker does not accept SASL {name} (it offers {offered}): {errName(hcode)}"
	}
	if mech == 0 {
		_ = try sasl_step(l, client, "\x00" + user + "\x00" + pass, timeout)
		return
	}
	try scram(l, client, mech, user, pass, timeout)
}

// sasl_step sends one SaslAuthenticate token and returns the broker's.
fn sasl_step(l i64, client str, token str, timeout i64) !str {
	mut b = make([]u8, 0, len(token)+8)
	putBytes(mut b, token)
	let r = try hs_call(l, client, apiSaslAuthenticate, b, timeout)
	mut d = newDec(r)
	let code = d.i16()
	let msg = d.str()
	let out = d.bytes()
	let life = d.i64() // session_lifetime_ms (KIP-368), 0 for none
	if code != 0 {
		if msg != "" {
			fail "{authFailed}: {msg}"
		}
		fail "{authFailed}: {errName(code)}"
	}
	if d.bad {
		fail "kafka: connecting: the broker's SaslAuthenticate answer is damaged"
	}
	if life > 0 {
		// The broker closes the connection at the next request after the session ends: renew
		// it at 85% of its lifetime (call_live), as Java does between 85% and 95%.
		l[lReauth] = rt_mono_ns() + life*850000
	}
	return out
}

// ---- the connection ----

// connect dials the broker and runs the handshake; the requests already queued wait for it.
fn connect(l i64, rec i64, timeout i64) ! {
	let addr = dialAddr(l)
	if rec[rTls] != 0 {
		let base = cast(tls.Config, rec[rTls])
		let cfg = tls.Config{ServerName: base.ServerName, RootCAs: base.RootCAs, ALPN: base.ALPN, Timeout: timeout, InsecureSkipVerify: base.InsecureSkipVerify,
			Certificate: base.Certificate, Key: base.Key}
		let tc = try tls.Dial(addr, cfg)
		tc.SetTimeout(timeout)
		l[lFd] = tc.Fd()
		tlsLines[l] = keep(tc)
	} else {
		let conn = try wire.DialTimeout(addr, timeout)
		l[lFd] = conn.Fd()
	}
	// The read buffer holds no answers yet: anything in it belonged to the closed connection.
	l[lInS] = 0
	l[lInE] = 0
	let err = handshake(l, rec, timeout)
	if err != nil {
		close_line(l)
		fail err
	}
}

// give_up ends a wait that did not end in a response. At the caller's own deadline or
// cancellation the slot stays queued for its response, and the connection stays in step for
// the others. At the client's timeout the broker is taken to be gone, as Java's
// request.timeout.ms does: the connection is dropped and every request on it fails, so the next
// one connects again instead of queueing behind an answer that will not come.
fn give_up(l i64, s i64, r i64) ! {
	let queued = s[sNoReply] == 0
	if r == waitDeadline {
		s[sGone] = 1
		if s[sOwner] != 0 || l[lBusy] == 0 {
			hand_off(l)
		}
		if !queued {
			free_slot(s)
		}
		fail cast(fault, rt_wait_fault())
	}
	let owner = s[sOwner] != 0
	s[sGone] = 1
	drop_line(l, owner, "kafka: the broker did not answer within the timeout; the connection was dropped")
	if owner || l[lBusy] == 0 {
		hand_off(l)
	}
	if !queued {
		free_slot(s)
	}
	fail fault.Wrap(ErrNetwork, "kafka: the broker did not answer within the timeout; the connection was dropped")
}

// drive does the connection's I/O until s has its response (or, for a request the broker does
// not answer, until it is written): writes what is queued, reads, and hands responses to their
// slots. Then it passes the I/O on to a caller still waiting.
fn drive(l i64, s i64, rec i64, timeout i64) ! {
	mut mine = 1 // the slots of this call in the queue (a request without a reply is not queued)
	if s[sNoReply] != 0 {
		mine = 0
	}
	if l[lFd] >= 0 && l[lQN] == mine && l[lOutN] > 0 && l[lWpos] == 0 && l[lInE] == 0 {
		// An idle connection the broker may have closed (a restart, an idle timeout): find
		// out before sending, so the request goes on a new connection instead of failing.
		let b = calloc(1, 8)
		let k = rt_sys_recv(l[lFd], b, 1, 2)
		free(b)
		if k == 0 || (k < 0 && rt_errno() != EAGAIN && rt_errno() != EINTR) {
			close_line(l)
		}
	}
	if l[lFd] < 0 {
		let err = connect(l, rec, timeout)
		if err != nil {
			if fault.Is(err, fault.DeadlineExceeded) || fault.Is(err, fault.Canceled) {
				// This caller's own deadline: the others keep their requests, and the next of
				// them connects again.
				s[sGone] = 1
				hand_off(l)
				if mine == 0 {
					free_slot(s)
				}
				fail err
			}
			let m = say.Str(err)
			fail_line(l, m)
			if s[sNoReply] != 0 {
				s[sState] = 2
				set_err(s, m)
			}
			hand_off(l)
			return
		}
	}
	// Let the core run the other requests of this turn first: their frames go out with ours.
	rt_task_defer()
	for s[sState] == 0 {
		let fd = l[lFd]
		if fd < 0 {
			// The connection failed under us: its callers have been told.
			if s[sNoReply] != 0 {
				s[sState] = 2
				set_err(s, "kafka: the connection failed")
			}
			break
		}
		let tc = tlsLines[l]
		if tc != nil && l[lWpos] < l[lOutN] {
			// A TLS write waits inside tls (records cannot be half sent); a fault drops the
			// connection.
			let err = tc.Write(raw_str(l[lOut]+l[lWpos], l[lOutN]-l[lWpos]))
			if err != nil {
				fail_line(l, say.Str(err))
				continue
			}
			l[lWpos] = 0
			l[lOutN] = 0
			continue
		}
		if l[lWpos] < l[lOutN] {
			let k = rt_sys_write(fd, l[lOut]+l[lWpos], l[lOutN]-l[lWpos])
			if k > 0 {
				l[lWpos] += k
				if l[lWpos] == l[lOutN] {
					l[lWpos] = 0
					l[lOutN] = 0
				}
				continue
			}
			let e = rt_errno()
			if e == EINTR {
				continue
			}
			if e == EAGAIN {
				let r = rt_task_wait(fd, 2, timeout)
				if r != waitReady {
					fail give_up(l, s, r)
				}
				continue
			}
			fail_line(l, os_msg("write", e))
			continue
		}
		if s[sNoReply] != 0 {
			s[sState] = 1
			break
		}
		deliver(l)
		if s[sState] != 0 || l[lOutN] > 0 {
			continue
		}
		if l[lInE] == l[lInCap] {
			let cap = l[lInCap]*2 + 16384
			l[lIn] = realloc(l[lIn], cap)
			l[lInCap] = cap
		}
		if tc != nil {
			// Straight into the read buffer: a frame of many records costs no copies.
			let (got, rerr) = tc.ReadNowTo(l[lIn]+l[lInE], l[lInCap]-l[lInE])
			if rerr != nil {
				fail_line(l, say.Str(rerr))
				continue
			}
			if got > 0 {
				l[lInE] += got
				continue
			}
			let r = rt_task_wait(fd, 1, timeout)
			if r != waitReady {
				fail give_up(l, s, r)
			}
			continue
		}
		let k = rt_sys_read(fd, l[lIn]+l[lInE], l[lInCap]-l[lInE])
		if k > 0 {
			l[lInE] += k
			continue
		}
		if k == 0 {
			fail_line(l, "kafka: the broker closed the connection")
			continue
		}
		let e = rt_errno()
		if e == EINTR {
			continue
		}
		if e == EAGAIN {
			let r = rt_task_wait(fd, 1, timeout)
			if r != waitReady {
				fail give_up(l, s, r)
			}
			continue
		}
		fail_line(l, os_msg("read", e))
	}
	hand_off(l)
}

// supports checks the broker at l speaks the version of api this client sends.
fn supports(l i64, api i64) ! {
	let v = l[lVers]
	if v == 0 {
		return
	}
	let lo = v[2*api]
	let hi = v[2*api+1]
	let want = version(api)
	if lo < 0 {
		fail "kafka: the broker at {dialAddr(l)} does not support {apiName(api)}"
	}
	if want < lo || want > hi {
		fail "kafka: the broker at {dialAddr(l)} supports {apiName(api)} versions {lo} to {hi}, this client sends {want}"
	}
}

// call sends one request (its body, after the header) to the broker at addr and returns the
// response after its correlation id. extra is how long the broker may hold the request on top
// of the client's timeout (a fetch's max wait). With noReply the broker sends nothing back
// (Produce with acks 0) and call returns "" once the request is written.
fn (c Client) call(addr str, api i64, body []u8, extra i64, noReply bool) !str {
	return try c.call_in(addr, "", api, body, extra, noReply)
}

// call_in is call for a group's request: a JoinGroup or SyncGroup goes on the group's own lane.
fn (c Client) call_in(addr str, group str, api i64, body []u8, extra i64, noReply bool) !str {
	if !c.open {
		fail "kafka: the client is not open (too many clients: open one per cluster, not per request)"
	}
	let tp = rt_tape()
	if tp != 0 {
		return try c.call_taped(tp, addr, group, api, body, extra, noReply) // recorded for replay (#241)
	}
	return try c.call_live(addr, group, api, body, extra, noReply)
}

fn (c Client) call_live(addr str, group str, api i64, body []u8, extra i64, noReply bool) !str {
	let key = laneKey(addr, group, api)
	mut l = c.line(key)
	if l != 0 && l[lReauth] != 0 && rt_mono_ns() >= l[lReauth] {
		// The SASL session is ending (KIP-368). A connection no task waits on is closed and made
		// again, which authenticates anew; one with requests in flight lets them finish there,
		// and new ones go on a new connection.
		if l[lBusy] == 0 {
			fail_line(l, "kafka: the connection was closed")
		} else {
			l[lRetired] = 1
			l = c.line(key)
		}
	}
	if l == 0 {
		fail "kafka: more than {maxBrokers} connections in use at once"
	}
	mut timeout = c.rec[rTimeout]
	if timeout > 0 {
		timeout += extra
	}
	if l[lFd] < 0 && l[lBusy] == 0 {
		// Connect first, so the broker's versions are known before the request is queued.
		l[lBusy] = 1
		let err = connect(l, c.rec, timeout)
		l[lBusy] = 0
		if err != nil {
			if fault.Is(err, fault.DeadlineExceeded) || fault.Is(err, fault.Canceled) {
				// This caller's own deadline: the callers that queued meanwhile keep their
				// requests, and the first of them connects again.
				hand_off(l)
				fail err
			}
			fail_line(l, say.Str(err))
			hand_off(l)
			let m = say.Str(err)
			if len(m) >= len(authFailed) && m[:len(authFailed)] == authFailed {
				fail fault.Wrap(ErrAuth, m)
			}
			fail fault.Wrap(ErrNetwork, m)
		}
		hand_off(l)
	}
	try supports(l, api)
	let corr = next_corr(l)
	mut req = request(api, version(api), corr, raw_str(c.rec[rClient], c.rec[rClientN]))
	req = append(req, body...)
	finish(mut req)
	let n = len(req)
	if l[lOutN]+n > l[lOutCap] {
		let cap = (l[lOutN]+n)*2 + 4096
		l[lOut] = realloc(l[lOut], cap)
		l[lOutCap] = cap
	}
	memcpy(l[lOut]+l[lOutN], cast(i64, req)[2], n)
	l[lOutN] += n
	let s = new_slot(corr)
	if noReply {
		s[sNoReply] = 1
	} else {
		q_push(l, s)
	}
	if l[lBusy] == 0 {
		l[lBusy] = 1
		s[sOwner] = 1
	}
	for s[sState] == 0 {
		if s[sOwner] != 0 {
			try drive(l, s, c.rec, timeout)
			continue
		}
		if noReply {
			// Someone else is writing: the frame goes out with theirs.
			s[sState] = 1
			break
		}
		let r = rt_task_park(timeout)
		if r != waitReady {
			fail give_up(l, s, r)
		}
	}
	if s[sState] == 2 {
		let m = raw_str(s[sErr], s[sErrN])
		free_slot(s)
		if len(m) >= len(authFailed) && m[:len(authFailed)] == authFailed {
			fail fault.Wrap(ErrAuth, m)
		}
		if m == closedMsg {
			fail ErrClosed
		}
		fail fault.Wrap(ErrNetwork, m)
	}
	if noReply {
		free_slot(s)
		return ""
	}
	let resp = raw_str(s[sMsg]+4, s[sMsgN]-4)
	free_slot(s)
	return resp
}

// ---- recording and replay (notes/interface_replay.md, section 4; #241) ----

// The request an effect body makes (read at its start).
mut tapedClient i64
mut tapedAddr i64
mut tapedGroup i64
mut tapedApi i64
mut tapedBody i64
mut tapedExtra i64
mut tapedNoReply bool

// call_taped records or replays one request as kafka@1: the key is the request's name, version
// and body (not the broker or the correlation id), the result the response body.
fn (c Client) call_taped(tp i64, addr str, group str, api i64, body []u8, extra i64, noReply bool) !str {
	mut k = make([]u8, 0, len(body)+32)
	k = append(k, "{apiName(api)} v{version(api)} "...)
	k = append(k, body...)
	tapedClient = cast(i64, c)
	tapedAddr = cast(i64, addr)
	tapedGroup = cast(i64, group)
	tapedApi = api
	tapedBody = cast(i64, body)
	tapedExtra = extra
	tapedNoReply = noReply
	return try rt_effect(tp, "kafka@1", str(k), call_effect)
}

fn call_effect() !str {
	let c = cast(Client, tapedClient)
	return try c.call_live(cast(str, tapedAddr), cast(str, tapedGroup), tapedApi, cast([]u8, tapedBody), tapedExtra, tapedNoReply)
}

// Close closes this core's connections of the client; the next request connects again. Requests
// waiting on them fail, including one another task is waiting on (a held fetch).
fn (c Client) Close() {
	if !c.open {
		return
	}
	let t = lineTables[c.rec[rID]]
	if t == 0 {
		return
	}
	for k in 0..maxBrokers {
		let l = t[k]
		if l != 0 && l[lFd] >= 0 {
			drop_line(l, false, closedMsg)
		}
	}
}
