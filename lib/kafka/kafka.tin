// Package kafka is an Apache Kafka client: a producer (idempotent by default, with batching and
// gzip, snappy, lz4 and zstd compression), fetching from partitions (read_committed too),
// consumer groups with rebalancing, transactions, and administration of topics, partitions,
// records, groups and configs. It speaks Kafka's binary protocol directly (request versions brokers
// 2.4 to 4.x accept; run against 3.9 and 4.2), over plain TCP or TLS 1.3, with SASL PLAIN,
// SCRAM-SHA-256 or SCRAM-SHA-512.
//
// Each core keeps one connection per broker for each Client. The requests a core serves at the
// same time share a connection, and sends of the same turn to one partition share a record
// batch, so a busy service makes few requests. Inside a request task a call waits without
// blocking the core; outside one it blocks.
//
//	let bus = kafka.Open(kafka.Options{Brokers: []str{"127.0.0.1:9092"}})
//	let ack = try bus.Send("orders", kafka.Message{Key: "7", Value: "paid"})
//	let records = try bus.Fetch("orders", ack.Partition, ack.Offset, 1s)
//
// A key picks the partition the way the Java client does (murmur2), so a key lands on the same
// partition from either. Consumer groups: Group and design/design_kafka.md (section 3) for where a
// consumer loop runs. Transactions: Transactional.
package kafka

import "fault"
import "mint"
import "tide"
import "tls"

// Mechanism is the SASL mechanism used when Options.Username is set.
type Mechanism enum {
	Plain
	ScramSha256
	ScramSha512
}

// Acks says which replicas must have a record before Send returns.
type Acks enum {
	All    // every in-sync replica (the default)
	Leader // the partition leader only
	NoAck  // none: Send returns once the request is written, without an offset
}

// Options says where and how to connect, and how to produce and fetch.
type Options struct {
	Brokers       []str       // "host:port" of at least one broker (default "127.0.0.1:9092"); the rest of the cluster is found from it
	ClientID      str         // sent with every request (default "tin")
	Username      str         // turns on SASL with Mechanism (use TLS so a PLAIN password is not sent in the clear)
	Password      str
	Mechanism     ?Mechanism  // nil: Plain
	Timeout       i64         // ns a request may wait for its answer (0: 30 s, as Java's request.timeout.ms; negative: no limit). Past it the connection is dropped. A request's deadline still applies
	Acks          ?Acks       // nil: All
	NoIdempotence bool        // turn off the idempotent producer (it is on by default with Acks.All)
	Compression   ?Compression // codec of produced batches (nil: none)
	BatchMax      i64         // bytes of records in one batch (default 1 MiB)
	Linger        i64         // ns a send waits for more records to join its batch (default 0: those of the same turn)
	FetchMax      i64         // bytes one fetch may return (default 1 MiB)
	ReadCommitted bool        // fetch only committed transactional records (isolation read_committed)
	TLS           ?tls.Config // connect over TLS 1.3 (the server name is the broker's host unless TLS.ServerName is set)
}

// Client talks to one Kafka cluster. Open it in a global's initializer (which runs on every core)
// or once in main, not per request.
type Client struct {
	open bool // false for the zero Client (a failed Open)
	rec  i64
}

// Ack says where Send put a record. Offset is -1 with Acks.NoAck, and when an idempotent retry
// found the batch already written.
type Ack struct {
	Partition i64
	Offset    i64
}

// The faults a call can return, for fault.Is. Any other broker error is reported by its Kafka
// name and number.
let ErrUnknownTopic = fault("kafka: unknown topic or partition")
let ErrOffsetOutOfRange = fault("kafka: offset out of range")
let ErrLeaderNotAvailable = fault("kafka: leader not available")
let ErrNotLeader = fault("kafka: not the leader for the partition")
let ErrTimedOut = fault("kafka: the broker timed out")
let ErrMessageTooLarge = fault("kafka: message too large")
let ErrTopicExists = fault("kafka: topic already exists")
let ErrAuth = fault("kafka: authentication failed")
let ErrCoordinator = fault("kafka: group coordinator not available")
let ErrNetwork = fault("kafka: the connection to a broker failed")
let ErrClosed = fault("kafka: the client was closed") // a request Close ended (not retried)
let ErrRebalance = fault("kafka: the group is rebalancing")
let ErrFenced = fault("kafka: fenced by a newer producer or group member")
let ErrNotEnoughReplicas = fault("kafka: not enough in-sync replicas")
let ErrProducerState = fault("kafka: the broker lost track of this producer's sequence")
let ErrTransaction = fault("kafka: the transaction cannot go on")
let ErrGroup = fault("kafka: group error")

const defaultFetchMax = 1048576
const defaultBatchMax = 1048576
const maxAttempts = 5
const coordAttempts = 10

// Open makes a client for the cluster in o. It connects on first use, on each core.
fn Open(o Options) Client {
	mut boots = ""
	for i, b in o.Brokers {
		if i > 0 {
			boots = boots + ","
		}
		boots = boots + b
	}
	if boots == "" {
		boots = "127.0.0.1:9092"
	}
	mut client = o.ClientID
	if client == "" {
		client = "tin"
	}
	let id = __atomic_add(&nClients, 1)
	if id >= maxClients {
		return Client{open: false, rec: 0}
	}
	let rec = calloc(recWords, 8)
	rec[rClient] = keep_raw(client)
	rec[rClientN] = len(client)
	rec[rUser] = keep_raw(o.Username)
	rec[rUserN] = len(o.Username)
	rec[rPass] = keep_raw(o.Password)
	rec[rPassN] = len(o.Password)
	rec[rTimeout] = o.Timeout
	if o.Timeout == 0 {
		rec[rTimeout] = defaultTimeout
	} else if o.Timeout < 0 {
		rec[rTimeout] = 0
	}
	rec[rID] = id
	rec[rBoots] = keep_raw(boots)
	rec[rBootsN] = len(boots)
	let mech = o.Mechanism
	if mech != nil {
		rec[rMech] = match mech {
			Plain => 0
			ScramSha256 => 1
			ScramSha512 => 2
		}
	}
	rec[rAcks] = -1
	let acks = o.Acks
	if acks != nil {
		rec[rAcks] = match acks {
			All => -1
			Leader => 1
			NoAck => 0
		}
	}
	let codec = o.Compression
	if codec != nil {
		rec[rCodec] = codecNumber(codec)
	}
	if rec[rAcks] == -1 && !o.NoIdempotence {
		rec[rIdem] = 1
	}
	rec[rBatchMax] = o.BatchMax
	if rec[rBatchMax] <= 0 {
		rec[rBatchMax] = defaultBatchMax
	}
	rec[rFetchMax] = o.FetchMax
	if rec[rFetchMax] <= 0 {
		rec[rFetchMax] = defaultFetchMax
	}
	if o.ReadCommitted {
		rec[rIsolation] = 1
	}
	rec[rLinger] = max(o.Linger, 0)
	let cfg = o.TLS
	if cfg != nil {
		rec[rTls] = cast(i64, keep(cfg))
	}
	return Client{open: true, rec: rec}
}

fn (c Client) clientID() str {
	return raw_str(c.rec[rClient], c.rec[rClientN])
}

// ---- errors ----

fn errName(code i64) str {
	return match code {
		-1 => "UNKNOWN_SERVER_ERROR (-1)"
		1 => "OFFSET_OUT_OF_RANGE (1)"
		2 => "CORRUPT_MESSAGE (2)"
		3 => "UNKNOWN_TOPIC_OR_PARTITION (3)"
		4 => "INVALID_FETCH_SIZE (4)"
		5 => "LEADER_NOT_AVAILABLE (5)"
		6 => "NOT_LEADER_OR_FOLLOWER (6)"
		7 => "REQUEST_TIMED_OUT (7)"
		8 => "BROKER_NOT_AVAILABLE (8)"
		9 => "REPLICA_NOT_AVAILABLE (9)"
		10 => "MESSAGE_TOO_LARGE (10)"
		13 => "NETWORK_EXCEPTION (13)"
		14 => "COORDINATOR_LOAD_IN_PROGRESS (14)"
		15 => "COORDINATOR_NOT_AVAILABLE (15)"
		16 => "NOT_COORDINATOR (16)"
		17 => "INVALID_TOPIC_EXCEPTION (17)"
		18 => "RECORD_LIST_TOO_LARGE (18)"
		19 => "NOT_ENOUGH_REPLICAS (19)"
		20 => "NOT_ENOUGH_REPLICAS_AFTER_APPEND (20)"
		21 => "INVALID_REQUIRED_ACKS (21)"
		22 => "ILLEGAL_GENERATION (22)"
		23 => "INCONSISTENT_GROUP_PROTOCOL (23)"
		24 => "INVALID_GROUP_ID (24)"
		25 => "UNKNOWN_MEMBER_ID (25)"
		26 => "INVALID_SESSION_TIMEOUT (26)"
		27 => "REBALANCE_IN_PROGRESS (27)"
		28 => "INVALID_COMMIT_OFFSET_SIZE (28)"
		29 => "TOPIC_AUTHORIZATION_FAILED (29)"
		30 => "GROUP_AUTHORIZATION_FAILED (30)"
		31 => "CLUSTER_AUTHORIZATION_FAILED (31)"
		32 => "INVALID_TIMESTAMP (32)"
		33 => "UNSUPPORTED_SASL_MECHANISM (33)"
		34 => "ILLEGAL_SASL_STATE (34)"
		35 => "UNSUPPORTED_VERSION (35)"
		36 => "TOPIC_ALREADY_EXISTS (36)"
		37 => "INVALID_PARTITIONS (37)"
		38 => "INVALID_REPLICATION_FACTOR (38)"
		39 => "INVALID_REPLICA_ASSIGNMENT (39)"
		40 => "INVALID_CONFIG (40)"
		41 => "NOT_CONTROLLER (41)"
		42 => "INVALID_REQUEST (42)"
		43 => "UNSUPPORTED_FOR_MESSAGE_FORMAT (43)"
		44 => "POLICY_VIOLATION (44)"
		45 => "OUT_OF_ORDER_SEQUENCE_NUMBER (45)"
		46 => "DUPLICATE_SEQUENCE_NUMBER (46)"
		47 => "INVALID_PRODUCER_EPOCH (47)"
		48 => "INVALID_TXN_STATE (48)"
		49 => "INVALID_PRODUCER_ID_MAPPING (49)"
		50 => "INVALID_TRANSACTION_TIMEOUT (50)"
		51 => "CONCURRENT_TRANSACTIONS (51)"
		52 => "TRANSACTION_COORDINATOR_FENCED (52)"
		53 => "TRANSACTIONAL_ID_AUTHORIZATION_FAILED (53)"
		56 => "KAFKA_STORAGE_ERROR (56)"
		57 => "LOG_DIR_NOT_FOUND (57)"
		58 => "SASL_AUTHENTICATION_FAILED (58)"
		59 => "UNKNOWN_PRODUCER_ID (59)"
		60 => "REASSIGNMENT_IN_PROGRESS (60)"
		67 => "OPERATION_NOT_ATTEMPTED (67)"
		68 => "NON_EMPTY_GROUP (68)"
		69 => "GROUP_ID_NOT_FOUND (69)"
		72 => "LISTENER_NOT_FOUND (72)"
		74 => "FENCED_LEADER_EPOCH (74)"
		75 => "UNKNOWN_LEADER_EPOCH (75)"
		76 => "UNSUPPORTED_COMPRESSION_TYPE (76)"
		79 => "MEMBER_ID_REQUIRED (79)"
		82 => "FENCED_INSTANCE_ID (82)"
		87 => "INVALID_RECORD (87)"
		89 => "THROTTLING_QUOTA_EXCEEDED (89)"
		90 => "PRODUCER_FENCED (90)"
		_ => "error {code}"
	}
}

// kerr is the fault for a broker's nonzero error code; what says which request it answered.
fn kerr(code i64, what str) ! {
	let msg = "{what}: {errName(code)}"
	let sentinel = match code {
		1 => ErrOffsetOutOfRange
		3 => ErrUnknownTopic
		5 => ErrLeaderNotAvailable
		6, 74, 75 => ErrNotLeader
		7, 89 => ErrTimedOut
		8, 9, 13, 56 => ErrNetwork
		10, 18 => ErrMessageTooLarge
		14, 15, 16 => ErrCoordinator
		19, 20 => ErrNotEnoughReplicas
		22, 25, 27, 79 => ErrRebalance
		47, 52, 82, 90 => ErrFenced
		45, 59 => ErrProducerState
		48, 49, 51 => ErrTransaction
		36 => ErrTopicExists
		58 => ErrAuth
		23, 24, 26, 30, 68, 69 => ErrGroup
		_ => nil
	}
	if sentinel != nil {
		fail fault.Wrap(sentinel, "kafka: {msg}")
	}
	fail "kafka: {msg}"
}

fn damaged(what str) ! {
	fail "kafka: the broker's {what} response is damaged"
}

// retriable says whether a request that failed with err is worth sending again (after fresh
// metadata): a moved or electing leader, a busy broker, a dropped connection.
fn retriable(err fault) bool {
	return fault.Is(err, ErrNotLeader) || fault.Is(err, ErrLeaderNotAvailable) || fault.Is(err, ErrUnknownTopic) || fault.Is(err, ErrTimedOut) || fault.Is(err, ErrNetwork) || fault.Is(err, ErrNotEnoughReplicas)
}

// backoff waits before attempt (0, 1, ...): 50 ms doubling to a second.
fn backoff(attempt i64) bool {
	mut ns = 50000000 << min(attempt, 5)
	if ns > 1000000000 {
		ns = 1000000000
	}
	let err = tide.Wait(ns)
	return err == nil
}

// ---- the cluster as this core last saw it ----

type nodeInfo struct {
	id   i64
	addr str
}

type topicInfo struct {
	name    str
	leaders []i64 // the node id leading each partition, -1 for none
}

type view struct {
	nodes      []nodeInfo
	topics     []topicInfo
	controller i64
}

// views holds each client's view of the cluster on this core, by client id. A replaced view is
// released (it is long-lived memory, from keep).
let views = make(map[i64]?view)

fn (c Client) bootstrap() []str {
	let all = raw_str(c.rec[rBoots], c.rec[rBootsN])
	mut out = []str{}
	mut from = 0
	for i in 0..len(all) {
		if all[i] == ',' {
			out = append(out, all[from:i])
			from = i + 1
		}
	}
	out = append(out, all[from:])
	return out
}

// candidates are the brokers to ask for anything any broker can answer: the ones the cluster
// named, then the ones the caller gave.
fn (c Client) candidates() []str {
	mut out = []str{}
	let v = views[c.rec[rID]]
	if v != nil {
		let ns = v.nodes
		for _, n in ns {
			out = append(out, n.addr)
		}
	}
	for _, b in c.bootstrap() {
		out = append(out, b)
	}
	return out
}

// anyCall sends a request to the first broker that answers.
fn (c Client) anyCall(api i64, body []u8, extra i64) !str {
	mut last fault = nil
	for _, addr in c.candidates() {
		let (r, err) = c.call(addr, api, body, extra, false)
		if err == nil {
			return r
		}
		if fault.Is(err, ErrAuth) || fault.Is(err, fault.DeadlineExceeded) || fault.Is(err, fault.Canceled) {
			fail err
		}
		last = err
	}
	if last != nil {
		fail last
	}
	fail "kafka: no broker to ask"
}

fn (c Client) nodeAddr(id i64) str {
	let v = views[c.rec[rID]]
	if v == nil {
		return ""
	}
	let ns = v.nodes
	for _, n in ns {
		if n.id == id {
			return n.addr
		}
	}
	return ""
}

// controllerAddr is the address of the cluster's controller (for admin requests), or any broker.
fn (c Client) controllerAddr() !str {
	mut v = views[c.rec[rID]]
	if v == nil {
		try c.refresh([]str{})
		v = views[c.rec[rID]]
	}
	if v != nil {
		let a = c.nodeAddr(v.controller)
		if a != "" {
			return a
		}
	}
	return c.bootstrap()[0]
}

// refresh asks the cluster for topics' partitions and leaders (none: only the brokers).
fn (c Client) refresh(topics []str) ! {
	mut body = make([]u8, 0, 32)
	putStrs(mut body, topics)
	putBool(mut body, true) // allow auto-creation, as the broker is configured
	let resp = try c.anyCall(apiMetadata, body, 0)
	mut d = newDec(resp)
	d.i32() // throttle
	mut nodes = []nodeInfo{}
	let nb = d.count()
	for i in 0..nb {
		let id = d.i32()
		let host = d.str()
		let port = d.i32()
		d.str() // rack
		nodes = append(nodes, nodeInfo{id: id, addr: host + ":" + mint.Itoa(port)})
	}
	d.str() // cluster id
	let controller = d.i32()
	mut failure = 0
	mut failedTopic = ""
	mut fresh = []topicInfo{}
	let nt = d.count()
	for i in 0..nt {
		let terr = d.i16()
		let name = d.str()
		d.bool() // internal
		let np = d.count()
		mut leaders = make([]i64, 0, np)
		for j in 0..np {
			let perr = d.i16()
			let idx = d.i32()
			let leader = d.i32()
			d.i32() // leader epoch
			d.skipInts()
			d.skipInts()
			d.skipInts()
			if idx < 0 || idx > 1000000 {
				d.bad = true
				continue
			}
			for len(leaders) <= idx {
				leaders = append(leaders, -1)
			}
			if perr == 0 || perr == 9 {
				leaders[idx] = leader
			}
		}
		if terr != 0 && terr != errLeaderNotAvailable {
			failure = terr
			failedTopic = name
			continue
		}
		fresh = append(fresh, topicInfo{name: name, leaders: leaders})
	}
	if d.bad {
		fail damaged("metadata")
	}
	mut all = []topicInfo{}
	let old = views[c.rec[rID]]
	if old != nil {
		let ot = old.topics
		for _, t in ot {
			mut replaced = false
			for _, f in fresh {
				if f.name == t.name {
					replaced = true
				}
			}
			if !replaced && t.name != failedTopic {
				all = append(all, t)
			}
		}
	}
	for _, f in fresh {
		all = append(all, f)
	}
	views[c.rec[rID]] = keep(view{nodes: nodes, topics: all, controller: controller})
	if failure != 0 {
		fail kerr(failure, "metadata for {failedTopic}")
	}
}

const errLeaderNotAvailable = 5

// partsKnown is the cached partition count of topic, -1 when unknown.
fn (c Client) partsKnown(topic str) i64 {
	let v = views[c.rec[rID]]
	if v == nil {
		return -1
	}
	let ts = v.topics
	for _, t in ts {
		if t.name == topic {
			return len(t.leaders)
		}
	}
	return -1
}

// leaderOf is the address of the broker leading partition p of topic, from the cached view
// ("" when it does not say).
fn (c Client) leaderOf(topic str, p i64) str {
	let v = views[c.rec[rID]]
	if v == nil {
		return ""
	}
	let ts = v.topics
	for _, t in ts {
		if t.name != topic {
			continue
		}
		if p < 0 || p >= len(t.leaders) || t.leaders[p] < 0 {
			return ""
		}
		return c.nodeAddr(t.leaders[p])
	}
	return ""
}

// leader is the address of the broker leading partition p of topic, asking the cluster when the
// cached view does not know. A recorded or replayed request always asks (as an effect), so what
// it does does not depend on what this core cached before.
fn (c Client) leader(topic str, p i64) !str {
	if rt_tape() == 0 {
		let a = c.leaderOf(topic, p)
		if a != "" {
			return a
		}
	}
	try c.refresh([]str{topic})
	let b = c.leaderOf(topic, p)
	if b != "" {
		return b
	}
	let n = c.partsKnown(topic)
	if n < 0 {
		fail fault.Wrap(ErrUnknownTopic, "kafka: topic {topic} has no metadata")
	}
	if p < 0 || p >= n {
		fail fault.Wrap(ErrUnknownTopic, "kafka: topic {topic} has {n} partitions, not partition {p}")
	}
	fail fault.Wrap(ErrLeaderNotAvailable, "kafka: topic {topic} partition {p} has no leader yet")
}

// Partitions is how many partitions topic has (asking the cluster). A topic created a moment ago
// may not be in every broker's metadata yet, so an unknown topic is asked about again for a
// little while (about two seconds) before the call fails with ErrUnknownTopic.
fn (c Client) Partitions(topic str) !i64 {
	for attempt in 0..maxAttempts {
		let err = c.refresh([]str{topic})
		if err == nil {
			let n = c.partsKnown(topic)
			if n >= 0 {
				return n
			}
		} else if !c.retry(err, "", attempt) {
			fail err
		} else {
			continue
		}
		if !backoff(attempt) {
			break
		}
	}
	fail fault.Wrap(ErrUnknownTopic, "kafka: topic {topic} has no metadata")
}

// partitions is the cached partition count, asking the cluster when unknown (always, in a
// recorded or replayed request).
fn (c Client) partitions(topic str) !i64 {
	let n = c.partsKnown(topic)
	if n > 0 && rt_tape() == 0 {
		return n
	}
	return try c.Partitions(topic)
}

// Ping checks that a broker answers.
fn (c Client) Ping() ! {
	try c.refresh([]str{})
}

// retry decides whether to send a failed request again: on a retriable error, with attempts
// left, after fresh metadata for topic and a backoff.
fn (c Client) retry(err fault, topic str, attempt i64) bool {
	if attempt+1 >= maxAttempts || !retriable(err) {
		return false
	}
	if !backoff(attempt) {
		return false
	}
	if topic != "" {
		let rerr = c.refresh([]str{topic})
		if rerr != nil && !retriable(rerr) {
			return false
		}
	}
	return true
}
