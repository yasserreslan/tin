// Package hearth runs a program on every core: one thread per core, each with its own
// globals, request pool and ingot heap. Cores share nothing; relay carries messages.
package hearth


// Cores is the number of CPUs this program may use: the CPUs online, capped on Linux by the
// affinity mask (cpuset) and the cgroup CPU quota (ceil of cpu.max quota/period); never 0.
fn Cores() i64 {
	let n = rt_ncpus()
	if n < 1 {
		return 1
	}
	return n
}

// MemLimit is the memory limit in bytes the container (cgroup) imposes: 0 when there is none.
fn MemLimit() i64 {
	return rt_mem_limit()
}

// ID is the current core's number: 0 for the main core.
fn ID() i64 {
	return rt_core_id()
}

// Run starts entry(i) on cores 1..n-1, runs entry(0) here, then waits for every core. Before
// starting it sizes the request pools to the memory limit and decides whether cores pin
// themselves to CPUs (only when they map one-to-one onto the allowed CPUs, or TIN_PIN=1).
fn Run(n i64, entry fn(i64)) {
	rt_pin_setup(n)
	pool_tune(n)
	rt_life_cores(n)
	for i in 1..n {
		rt_spawn_core(entry, i)
	}
	if n > 1 {
		rt_core_qos(0)
	}
	// Every core opens its use resources and runs on core.start before any serves (#238).
	rt_life_wait()
	entry(0)
	for __atomic_load(&rtCoresDone) < n-1 {
		rt_sleep_ns(200000)
	}
	rt_threads_reap()
}

// pool_tune lowers the per-core request pool chunk (4 MiB by default) when n of them would take
// more than a quarter of the memory limit; the runtime reads rtPoolChunk when it is not 0.
fn pool_tune(n i64) {
	let limit_ = rt_mem_limit()
	if limit_ <= 0 || n < 1 {
		return
	}
	let budget = limit_ / 4
	if n*chunkSize <= budget {
		return
	}
	mut c = budget / n / 65536 * 65536
	if c < 65536 {
		c = 65536
	}
	rtPoolChunk = c
}

// PoolChunk is the request pool chunk size in bytes each core uses (after pool_tune).
fn PoolChunk() i64 {
	return rt_chunk()
}

// PoolCapacity is the usable size in bytes of this core's current base pool chunk (0 before
// its first request allocation).
fn PoolCapacity() i64 {
	let c = __ctx()
	if c[ctxPoolBase] == 0 {
		return 0
	}
	return c[ctxEnd] - c[ctxPoolBase]
}

// Reset ends the current request: the core's pool is emptied for the next one.
fn Reset() {
	rt_pool_reset()
}

// HeapStats reports what this core's long-lived heap has from the system (#345): the bytes of
// its slabs (blocks up to 256 KiB), the bytes of the mappings of its larger blocks (those in use
// and those kept for reuse) and the number of mappings in all.
fn HeapStats() (i64, i64, i64) {
	return rt_heap_stats()
}

// RcStats reports what long-lived memory this core still counts (#176): the number of
// counted blocks, their bytes and how many dropped blocks wait in the limbo.
fn RcStats() (i64, i64, i64) {
	return rt_rc_stats()
}
