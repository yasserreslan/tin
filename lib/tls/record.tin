package tls

import "say"
import "seal"
import "wire"

// ---- the record layer (RFC 8446 section 5) ----

const ctChangeCipherSpec = 20
const ctAlert = 21
const ctHandshake = 22
const ctApplicationData = 23

const maxPlaintext = 16384
const maxCiphertext = 16384 + 256

// After this many records under one key the client moves to a new one (RFC 8446 5.5 allows
// about 2^24.5 full-size records for AES-GCM).
const rekeyAfter = 16777216

const alertCloseNotify = 0
const alertUnexpectedMessage = 10
const alertBadRecordMAC = 20
const alertRecordOverflow = 22
const alertHandshakeFailure = 40
const alertBadCertificate = 42
const alertIllegalParameter = 47
const alertDecodeError = 50
const alertDecryptError = 51
const alertProtocolVersion = 70
const alertInternalError = 80
const alertUserCanceled = 90
const alertMissingExtension = 109
const alertUnsupportedExtension = 110

// pendingAlert is the alert the last alert_fault asked for (read at once by the caller).
mut pendingAlert = 0

// alert_fault returns "tls: msg" (for fail) and remembers the alert to send for it.
fn alert_fault(desc i64, msg str) str {
	pendingAlert = desc
	return "tls: " + msg
}

fn alert_name(d i64) str {
	match d {
		0 => {
			return "close notify"
		}
		10 => {
			return "unexpected message"
		}
		20 => {
			return "bad record MAC"
		}
		22 => {
			return "record overflow"
		}
		40 => {
			return "handshake failure"
		}
		42 => {
			return "bad certificate"
		}
		43 => {
			return "unsupported certificate"
		}
		44 => {
			return "certificate revoked"
		}
		45 => {
			return "certificate expired"
		}
		46 => {
			return "certificate unknown"
		}
		47 => {
			return "illegal parameter"
		}
		48 => {
			return "unknown certificate authority"
		}
		49 => {
			return "access denied"
		}
		50 => {
			return "error decoding message"
		}
		51 => {
			return "error decrypting message"
		}
		70 => {
			return "protocol version not supported"
		}
		71 => {
			return "insufficient security level"
		}
		80 => {
			return "internal error"
		}
		86 => {
			return "inappropriate fallback"
		}
		90 => {
			return "user canceled"
		}
		109 => {
			return "missing extension"
		}
		110 => {
			return "unsupported extension"
		}
		112 => {
			return "unrecognized name"
		}
		116 => {
			return "certificate required"
		}
		120 => {
			return "no application protocol"
		}
	}
	return say.Fmt("alert %d", d)
}

// Conn is a TLS 1.3 connection over a wire.Conn. After the handshake its memory only changes
// in place (record buffers made once, keys rewritten by seal.AEAD.Rekey), so a Conn stays
// valid wherever it lives: a request's pool, or keep()'s long-lived heap for a client that
// holds connections across requests.
type Conn struct {
	tcp     wire.Conn
	fd      i64
	timeout i64 // ns a read or write may wait (0: no limit; a request's deadline still applies)
	until   i64 // monotonic ns after which every wait fails (0: none): the handshake's Timeout
	ready   bool
	closed  bool
	failure str // the fault that ended the connection, given again by every later call
	eof     bool
	suite   i64
	hash    seal.Hash
	rd      ?seal.AEAD
	riv     []u8
	rseq    u64
	rsecret []u8
	wr      ?seal.AEAD
	wiv     []u8
	wseq    u64
	wsecret []u8
	in      []u8 // bytes read from the socket: in[ins:ine] are not consumed yet
	ins     i64
	ine     i64
	plain   []u8 // application data decrypted but not read: plain[ps:pe]
	ps      i64
	pe      i64
	ph      []u8 // a post-handshake message's header (4 bytes) and a KeyUpdate's body
	phn     i64  // bytes of ph collected
	phskip  i64  // body bytes of a NewSessionTicket still to skip
	alpn    str
	certs   [][]u8
	group   i64  // the key exchange group used
	retried bool // the server asked for another key share (HelloRetryRequest)
	alertCt i64 // records of alerts or empty data in a row (a peer cannot loop us forever)
	resumption []u8 // the resumption secret: what the tickets the server sends are worth
	skey    str  // the session_key under which tickets are kept ("": none are)
	resumed bool // the handshake resumed an earlier session
	phcollect i64 // bytes of a NewSessionTicket still to collect into phbuf
	phbuf   []u8
}

fn new_conn(tcp wire.Conn) Conn {
	return Conn{tcp: tcp, fd: tcp.Fd(), failure: "", riv: make([]u8, 12), rsecret: make([]u8, 0, 48),
		wiv: make([]u8, 12), wsecret: make([]u8, 0, 48), in: make([]u8, 5+maxCiphertext+64),
		plain: make([]u8, maxPlaintext), ph: make([]u8, 5), alpn: "", certs: make([][]u8, 0, 1), hash: seal.Hash.SHA256,
		resumption: []u8{}, skey: "", phbuf: []u8{}}
}

// wait blocks the task until the socket is readable (want 1) or writable (2), within the
// per-call timeout and the handshake's deadline.
fn (c Conn) wait(want i64, what str) ! {
	mut t = c.timeout
	if c.until > 0 {
		let left = c.until - rt_mono_ns()
		if left <= 0 {
			fail "tls: {what} timed out"
		}
		if t == 0 || left < t {
			t = left
		}
	}
	let r = rt_task_wait(c.fd, want, t)
	if r == waitDeadline {
		fail cast(fault, rt_wait_fault())
	}
	if r == waitTimeout {
		fail "tls: {what} timed out"
	}
}

// send writes all of b to the socket.
fn (c Conn) send(b []u8) ! {
	mut p = cast(i64, b)[2]
	mut n = len(b)
	for n > 0 {
		let k = rt_sys_write(c.fd, p, n)
		if k < 0 {
			let e = rt_errno()
			if e == EINTR {
				continue
			}
			if e == EAGAIN {
				try c.wait(2, "write")
				continue
			}
			let m = rt_sys_strerror(e)
			fail say.Fault("tls: write: %s", rt_str_from_raw(m, strlen(m)))
		}
		p += k
		n -= k
	}
}

// fill reads from the socket until n unconsumed bytes are buffered.
fn (c mut Conn) fill(n i64) ! {
	try c.fill_some(n, true)
}

// fill_some is fill; without wait it returns false instead of waiting for the socket.
fn (c mut Conn) fill_some(n i64, wait bool) !bool {
	if c.ine-c.ins >= n {
		return true
	}
	if c.ins > 0 {
		copy(c.in, c.in[c.ins:c.ine])
		c.ine -= c.ins
		c.ins = 0
	}
	let base = cast(i64, c.in)[2]
	for c.ine < n {
		let k = rt_sys_read(c.fd, base+c.ine, len(c.in)-c.ine)
		if k > 0 {
			c.ine += k
			continue
		}
		if k == 0 {
			fail "tls: connection closed by the peer without close_notify"
		}
		let e = rt_errno()
		if e == EINTR {
			continue
		}
		if e == EAGAIN {
			if !wait {
				return false
			}
			try c.wait(1, "read")
			continue
		}
		let m = rt_sys_strerror(e)
		fail say.Fault("tls: read: %s", rt_str_from_raw(m, strlen(m)))
	}
	return true
}

// nonce is the per-record nonce: the IV xor the sequence number (RFC 8446 5.3).
fn nonce(iv []u8, seq u64) []u8 {
	let n = clone(iv)
	for i in 0..8 {
		n[11-i] ^= u8(seq >> u64(8*i))
	}
	return n
}

// seal_record encrypts one record of content type typ (or writes it in the clear before
// keys exist) and appends it to out.
fn (c mut Conn) seal_record(out mut []u8, typ i64, data []u8) ! {
	let a = c.wr
	if a == nil {
		out = append(out, u8(typ), 3, 3, u8(len(data)>>8), u8(len(data)))
		out = append(out, data...)
		return
	}
	mut inner = make([]u8, 0, len(data)+1)
	inner = append(inner, data...)
	inner = append(inner, u8(typ))
	let n = len(inner) + 16
	let hdr = []u8{ctApplicationData, 3, 3, u8(n >> 8), u8(n)}
	let sealed = try a.Seal(nonce(c.wiv, c.wseq), inner, hdr)
	c.wseq += 1
	out = append(out, hdr...)
	out = append(out, sealed...)
}

// write_records sends data as records of type typ, at most 16 KiB each, in one write.
fn (c mut Conn) write_records(typ i64, data []u8) ! {
	let out = make([]u8, 0, len(data)+(len(data)/maxPlaintext+1)*22)
	{
		mut off = 0
		for off == 0 || off < len(data) {
			mut end = off + maxPlaintext
			if end > len(data) {
				end = len(data)
			}
			try c.seal_record(mut out, typ, data[off:end])
			off += maxPlaintext
		}
	}
	try c.send(out)
}

// send_alert sends a fatal alert (or close_notify), ignoring write errors.
fn (c mut Conn) send_alert(desc i64) {
	mut level = 2
	if desc == alertCloseNotify || desc == alertUserCanceled {
		level = 1
	}
	let out = make([]u8, 0, 32)
	let err = c.seal_record(mut out, ctAlert, []u8{u8(level), u8(desc)})
	if err == nil {
		let saved = c.timeout
		if c.timeout == 0 || c.timeout > 1000000000 {
			c.timeout = 1000000000
		}
		c.send(out) catch _ {}
		c.timeout = saved
	}
}

// read_record returns the next record's content type and plaintext, decrypting it once read
// keys exist. Change-cipher-spec records are skipped during the handshake.
fn (c mut Conn) read_record() !(i64, []u8) {
	let (typ, data, _) = try c.next_record(true)
	return typ, data
}

// next_record is read_record; without wait it gives false (and no record) when a whole record
// is not buffered and the socket has nothing more yet.
fn (c mut Conn) next_record(wait bool) !(i64, []u8, bool) {
	for {
		mut more = try c.fill_some(5, wait)
		if !more {
			return 0, []u8{}, false
		}
		let h = c.in[c.ins : c.ins+5]
		let typ = i64(h[0])
		let n = i64(h[3])<<8 | i64(h[4])
		if typ < ctChangeCipherSpec || typ > ctApplicationData {
			fail alert_fault(alertUnexpectedMessage, say.Fmt("unexpected record type %d", typ))
		}
		if n > maxCiphertext {
			fail alert_fault(alertRecordOverflow, "record too large")
		}
		more = try c.fill_some(5+n, wait)
		if !more {
			return 0, []u8{}, false
		}
		let hdr = clone(c.in[c.ins : c.ins+5])
		let body = c.in[c.ins+5 : c.ins+5+n]
		c.ins += 5 + n
		if typ == ctChangeCipherSpec {
			if c.ready || n != 1 || body[0] != 1 {
				fail alert_fault(alertUnexpectedMessage, "unexpected change_cipher_spec")
			}
			continue
		}
		let a = c.rd
		if a == nil {
			if typ != ctHandshake && typ != ctAlert {
				fail alert_fault(alertUnexpectedMessage, say.Fmt("unexpected record type %d", typ))
			}
			if n > maxPlaintext {
				fail alert_fault(alertRecordOverflow, "record too large")
			}
			return typ, clone(body), true
		}
		if typ != ctApplicationData {
			fail alert_fault(alertUnexpectedMessage, say.Fmt("unexpected record type %d", typ))
		}
		let pt = a.Open(nonce(c.riv, c.rseq), body, hdr) catch _ {
			fail alert_fault(alertBadRecordMAC, "record authentication failed")
		}
		c.rseq += 1
		// The content type is the last non-zero byte; zeros after it are padding.
		mut end = len(pt) - 1
		for end >= 0 && pt[end] == 0 {
			end -= 1
		}
		if end < 0 {
			fail alert_fault(alertUnexpectedMessage, "record with no content type")
		}
		if end > maxPlaintext {
			fail alert_fault(alertRecordOverflow, "record too large")
		}
		return i64(pt[end]), pt[:end], true
	}
	return 0, []u8{}, false
}

// set_read_key and set_write_key install the keys of a traffic secret (in place once they
// exist, so an established Conn allocates nothing new).
fn (c mut Conn) set_read_key(secret_ []u8) ! {
	let (key, iv) = try traffic_keys(c.suite, c.hash, secret_)
	let a = c.rd
	if a == nil {
		c.rd = try suite_aead(c.suite, key)
	} else {
		try a.Rekey(key)
	}
	copy(c.riv, iv)
	c.rseq = 0
	c.rsecret = c.rsecret[:0]
	c.rsecret = append(c.rsecret, secret_...)
}

fn (c mut Conn) set_write_key(secret_ []u8) ! {
	let (key, iv) = try traffic_keys(c.suite, c.hash, secret_)
	let a = c.wr
	if a == nil {
		c.wr = try suite_aead(c.suite, key)
	} else {
		try a.Rekey(key)
	}
	copy(c.wiv, iv)
	c.wseq = 0
	c.wsecret = c.wsecret[:0]
	c.wsecret = append(c.wsecret, secret_...)
}

// send_key_update sends KeyUpdate and moves to the next write secret (RFC 8446 4.6.3).
fn (c mut Conn) send_key_update(request bool) ! {
	mut r = 0
	if request {
		r = 1
	}
	try c.write_records(ctHandshake, handshake_msg(hsKeyUpdate, []u8{u8(r)}))
	let next = try seal.HkdfExpandLabel(c.hash, str(c.wsecret), "traffic upd", "", seal.Size(c.hash))
	try c.set_write_key(next)
}

// post_handshake handles handshake messages after the handshake: NewSessionTicket is
// kept for resumption (session.tin), KeyUpdate moves to the next read secret; anything else is fatal.
fn (c mut Conn) post_handshake(data []u8) ! {
	mut i = 0
	for i < len(data) {
		if c.phcollect > 0 {
			mut k = len(data) - i
			if k > c.phcollect {
				k = c.phcollect
			}
			c.phbuf = append(c.phbuf, data[i:i+k]...)
			c.phcollect -= k
			i += k
			if c.phcollect == 0 {
				c.phn = 0
				try c.save_ticket(c.phbuf)
			}
			continue
		}
		if c.phskip > 0 {
			mut k = len(data) - i
			if k > c.phskip {
				k = c.phskip
			}
			c.phskip -= k
			i += k
			if c.phskip == 0 {
				c.phn = 0
			}
			continue
		}
		c.ph[c.phn] = data[i]
		c.phn += 1
		i += 1
		if c.phn < 4 {
			continue
		}
		let typ = i64(c.ph[0])
		let n = i64(c.ph[1])<<16 | i64(c.ph[2])<<8 | i64(c.ph[3])
		if typ == hsNewSessionTicket {
			if n == 0 {
				fail alert_fault(alertDecodeError, "empty NewSessionTicket")
			}
			if n <= 16384 && c.skey != "" && len(c.resumption) > 0 {
				c.phcollect = n
				c.phbuf = make([]u8, 0, n)
			} else {
				c.phskip = n
			}
			continue
		}
		if typ != hsKeyUpdate || n != 1 {
			fail alert_fault(alertUnexpectedMessage, say.Fmt("unexpected post-handshake message %d", typ))
		}
		if c.phn < 5 {
			continue
		}
		c.phn = 0
		let req = c.ph[4]
		if req > 1 {
			fail alert_fault(alertIllegalParameter, "bad KeyUpdate")
		}
		if i != len(data) {
			fail alert_fault(alertUnexpectedMessage, "KeyUpdate not at the end of a record")
		}
		let next = try seal.HkdfExpandLabel(c.hash, str(c.rsecret), "traffic upd", "", seal.Size(c.hash))
		try c.set_read_key(next)
		if req == 1 {
			try c.send_key_update(false)
		}
	}
}

// fault_close records err as the connection's failure, sends the alert it asked for and
// closes the socket; later calls fail with the same fault.
fn (c mut Conn) fault_close(err fault, desc i64) {
	if !c.closed {
		c.send_alert(desc)
		c.failure = say.Str(err)
		c.closed = true
		c.tcp.Close()
	}
}

// abort ends the connection with alert desc and returns "tls: msg" to fail with.
fn (c mut Conn) abort(desc i64, msg str) str {
	let m = "tls: " + msg
	if !c.closed {
		c.send_alert(desc)
		c.failure = m
		c.closed = true
		c.tcp.Close()
	}
	return m
}

// save_ticket keeps the NewSessionTicket whose body is b for a later connection to the same server.
fn (c mut Conn) save_ticket(b []u8) ! {
	let r = rdr{b: b}
	mut life = r.u16v()<<16 | r.u16v()
	let ageAdd = r.u16v()<<16 | r.u16v()
	let nonce = r.vec8()
	let tkt = r.vec16()
	r.vec16()
	if r.bad || !r.done() || len(tkt) == 0 {
		fail alert_fault(alertDecodeError, "malformed NewSessionTicket")
	}
	if life == 0 {
		return
	}
	if life > maxTicketLife {
		life = maxTicketLife
	}
	let psk = try seal.HkdfExpandLabel(c.hash, str(c.resumption), "resumption", str(nonce), seal.Size(c.hash))
	put_ticket(ticket{key: c.skey, ticket: clone(tkt), psk: psk, suite: c.suite, ageAdd: ageAdd, issued: rt_mono_ns(), life: life, alpn: c.alpn})
}
