package tls

import "say"
import "seal"

// ---- the client handshake (RFC 8446 section 2, full handshake without PSK) ----

// hello holds the client's random choices for one handshake; the RFC 8448 trace test fixes
// them and the ClientHello bytes (raw).
type hello struct {
	random  []u8
	session []u8
	x25519  []u8 // X25519 private key
	raw     []u8 // a ClientHello to send as is (tests only; empty: build one)
}

fn new_hello() hello {
	return hello{random: seal.RandomBytes(32), session: seal.RandomBytes(32), x25519: seal.X25519NewPrivateKey(), raw: []u8{}}
}

// hsReader collects handshake messages from records.
type hsReader struct {
	buf []u8
}

// next returns the next handshake message (header and body) of the server's flight.
fn (h mut hsReader) next(c mut Conn) !(i64, []u8) {
	for {
		if len(h.buf) >= 4 {
			let n = i64(h.buf[1])<<16 | i64(h.buf[2])<<8 | i64(h.buf[3])
			if n > 262144 {
				fail alert_fault(alertDecodeError, "handshake message too large")
			}
			if len(h.buf) >= 4+n {
				let msg = clone(h.buf[:4+n])
				let rest = clone(h.buf[4+n:])
				h.buf = rest
				return i64(msg[0]), msg
			}
		}
		let (typ, data) = try c.read_record()
		if typ == ctAlert {
			try handle_alert(data)
			fail "tls: handshake ended by close_notify"
		}
		if typ != ctHandshake {
			fail alert_fault(alertUnexpectedMessage, say.Fmt("unexpected record type %d during the handshake", typ))
		}
		if len(data) == 0 {
			fail alert_fault(alertUnexpectedMessage, "empty handshake record")
		}
		h.buf = cat(h.buf, data)
	}
	return 0, []u8{}
}

// empty is true when no partial message is buffered (keys may change only then).
fn (h hsReader) empty() bool {
	return len(h.buf) == 0
}

// handle_alert fails with the peer's alert, or returns for close_notify.
fn handle_alert(data []u8) ! {
	if len(data) != 2 {
		fail alert_fault(alertDecodeError, "malformed alert")
	}
	if data[1] == alertCloseNotify {
		return
	}
	fail say.Fault("tls: remote error: %s", alert_name(i64(data[1])))
}

// handshake runs the client side on c (a fresh connection) for server name name.
fn (c mut Conn) handshake(cfg Config, name str, hi hello) ! {
	let offered = suites()
	mut group = groupX25519
	mut priv = hi.x25519
	mut share = try seal.X25519PublicKey(priv)
	mut ch = hi.raw
	// A ticket from an earlier connection to this server, if there is one, is offered as a PSK.
	mut tk = ticket{key: "", ticket: []u8{}, psk: []u8{}, suite: 0, ageAdd: 0, issued: 0, life: 0, alpn: ""}
	mut psked = false
	if len(ch) == 0 {
		if name != "" {
			c.skey = session_key(name, cfg)
			let (t, ok) = take_ticket(c.skey)
			if ok {
				tk = t
				psked = true
			}
		}
		mut opt = chOptions{cookie: []u8{}, offer: nil}
		if psked {
			opt.offer = pskOffer{identity: tk.ticket, age: ticket_age(tk), hlen: seal.Size(suite_hash(tk.suite))}
		}
		ch = client_hello(hi.random, hi.session, offered, name, cfg.ALPN, group, share, opt)
		if psked {
			ch = try bind_psk(ch, tk, []u8{})
		}
	}
	mut transcript = clone(ch)
	try c.write_records(ctHandshake, ch)
	let hr = hsReader{buf: []u8{}}
	mut (typ, msg) = try hr.next(mut c)
	if typ != hsServerHello {
		fail alert_fault(alertUnexpectedMessage, "expected ServerHello")
	}
	mut sh = try parse_server_hello(msg[4:], hi.session)
	mut retried = false
	if sh.retry {
		// HelloRetryRequest: answer once with a key share for the group the server asked for.
		if !in_list(offered, sh.suite) {
			fail alert_fault(alertIllegalParameter, "server chose a cipher suite that was not offered")
		}
		if sh.group != groupP256 {
			fail alert_fault(alertIllegalParameter, "HelloRetryRequest asks for a group that was not offered or was already sent")
		}
		if len(hi.raw) != 0 {
			fail alert_fault(alertInternalError, "a fixed ClientHello cannot be retried")
		}
		let h = suite_hash(sh.suite)
		// The transcript restarts with message_hash(ClientHello1), then the retry request.
		let first = handshake_msg(hsMessageHash, transcript_hash(h, transcript))
		transcript = cat(first, msg)
		group = groupP256
		priv = seal.P256NewPrivateKey()
		share = try seal.P256PublicKey(priv)
		// The ticket is offered again only when its hash is the one the server chose.
		psked = psked && suite_hash(tk.suite) == h
		mut opt2 = chOptions{cookie: sh.cookie, offer: nil}
		if psked {
			opt2.offer = pskOffer{identity: tk.ticket, age: ticket_age(tk), hlen: seal.Size(h)}
		}
		mut ch2 = client_hello(hi.random, hi.session, offered, name, cfg.ALPN, group, share, opt2)
		if psked {
			ch2 = try bind_psk(ch2, tk, transcript)
		}
		transcript = cat(transcript, ch2)
		try c.write_records(ctHandshake, ch2)
		retried = true
		let suite = sh.suite
		typ, msg = try hr.next(mut c)
		if typ != hsServerHello {
			fail alert_fault(alertUnexpectedMessage, "expected ServerHello")
		}
		sh = try parse_server_hello(msg[4:], hi.session)
		if sh.retry {
			fail alert_fault(alertUnexpectedMessage, "a second HelloRetryRequest")
		}
		if sh.suite != suite {
			fail alert_fault(alertIllegalParameter, "ServerHello changed the cipher suite of the HelloRetryRequest")
		}
	}
	if !in_list(offered, sh.suite) {
		fail alert_fault(alertIllegalParameter, "server chose a cipher suite that was not offered")
	}
	if sh.group != group || len(sh.share) == 0 {
		fail alert_fault(alertIllegalParameter, "ServerHello key share is not for the group offered")
	}
	transcript = cat(transcript, msg)
	c.suite = sh.suite
	c.hash = suite_hash(sh.suite)
	let h = c.hash
	mut psk = []u8{}
	if sh.psk {
		if !psked {
			fail alert_fault(alertIllegalParameter, "ServerHello accepts a PSK that was not offered")
		}
		if suite_hash(tk.suite) != h {
			fail alert_fault(alertIllegalParameter, "ServerHello resumes with a cipher suite of another hash")
		}
		psk = tk.psk
		c.resumed = true
	}
	mut shared_ = []u8{}
	if group == groupX25519 {
		shared_ = seal.X25519(priv, sh.share) catch _ {
			fail alert_fault(alertIllegalParameter, "invalid X25519 key share")
		}
	} else {
		if len(sh.share) != 65 || sh.share[0] != 4 {
			fail alert_fault(alertIllegalParameter, "invalid P-256 key share")
		}
		shared_ = seal.P256ECDH(priv, sh.share) catch _ {
			fail alert_fault(alertIllegalParameter, "invalid P-256 key share")
		}
	}
	if !hr.empty() {
		fail alert_fault(alertUnexpectedMessage, "handshake data before a key change")
	}
	let sc = try handshake_secrets(h, shared_, transcript_hash(h, transcript), psk)
	try c.set_read_key(sc.shs)
	try c.set_write_key(sc.chs)
	// The server's encrypted flight.
	typ, msg = try hr.next(mut c)
	if typ != hsEncryptedExtensions {
		fail alert_fault(alertUnexpectedMessage, "expected EncryptedExtensions")
	}
	c.alpn = try parse_encrypted_extensions(msg[4:], cfg.ALPN, hello_extensions(ch))
	transcript = cat(transcript, msg)
	mut requested = false
	mut reqctx = []u8{}
	if c.resumed && c.alpn != tk.alpn {
		fail alert_fault(alertIllegalParameter, "a resumed connection negotiated another ALPN protocol")
	}
	if !c.resumed {
		typ, msg = try hr.next(mut c)
		if typ == hsCertificateRequest {
			reqctx = try parse_certificate_request(msg[4:])
			requested = true
			transcript = cat(transcript, msg)
			typ, msg = try hr.next(mut c)
		}
		if typ != hsCertificate {
			fail alert_fault(alertUnexpectedMessage, "expected Certificate")
		}
		let certs = try parse_certificate(msg[4:])
		transcript = cat(transcript, msg)
		typ, msg = try hr.next(mut c)
		if typ != hsCertificateVerify {
			fail alert_fault(alertUnexpectedMessage, "expected CertificateVerify")
		}
		let cv = rdr{b: msg[4:]}
		let scheme = cv.u16v()
		let sig = cv.vec16()
		if cv.bad || !cv.done() {
			fail alert_fault(alertDecodeError, "malformed CertificateVerify")
		}
		if scheme == 0x0401 || scheme == 0x0501 || scheme == 0x0601 || !in_list(sigSchemes, scheme) {
			fail alert_fault(alertIllegalParameter, "CertificateVerify uses a scheme that was not offered")
		}
		try verify_peer(cfg, name, certs, scheme, cv_content(transcript_hash(h, transcript)), sig)
		c.certs = certs
		transcript = cat(transcript, msg)
	}
	typ, msg = try hr.next(mut c)
	if typ != hsFinished {
		fail alert_fault(alertUnexpectedMessage, "expected Finished")
	}
	let want = try finished_mac(h, sc.shs, transcript_hash(h, transcript))
	if !seal.ConstantTimeEq(want, msg[4:]) {
		fail alert_fault(alertDecryptError, "server Finished does not verify")
	}
	transcript = cat(transcript, msg)
	if !hr.empty() {
		fail alert_fault(alertUnexpectedMessage, "handshake data after the server Finished")
	}
	let thash = transcript_hash(h, transcript)
	let cats = try derive_secret(h, sc.master, "c ap traffic", thash)
	let sap = try derive_secret(h, sc.master, "s ap traffic", thash)
	try c.set_read_key(sap)
	// The client's flight under its handshake keys: an empty Certificate if one was asked
	// for (this client has none), then Finished.
	mut flight = []u8{}
	if requested {
		mut body = make([]u8, 0, 8)
		body = append(body, u8(len(reqctx)))
		body = append(body, reqctx...)
		body = append(body, 0, 0, 0)
		let cm = handshake_msg(hsCertificate, body)
		flight = cat(flight, cm)
		transcript = cat(transcript, cm)
	}
	let fin = try finished_mac(h, sc.chs, transcript_hash(h, transcript))
	let finmsg = handshake_msg(hsFinished, fin)
	flight = cat(flight, finmsg)
	// What tickets the server sends from now on are worth: the resumption secret.
	c.resumption = try derive_secret(h, sc.master, "res master", transcript_hash(h, cat(transcript, finmsg)))
	try c.write_records(ctHandshake, flight)
	try c.set_write_key(cats)
	c.group = group
	c.retried = retried
	c.ready = true
}

fn in_list(xs []i64, v i64) bool {
	for _, x in xs {
		if x == v {
			return true
		}
	}
	return false
}

// ticket_age is the obfuscated age the PSK identity carries: milliseconds since the ticket came,
// plus ticket_age_add, modulo 2^32.
fn ticket_age(t ticket) i64 {
	return ((rt_mono_ns()-t.issued)/1000000 + t.ageAdd) & 0xffffffff
}

// bind_psk fills in the binder of the PSK offered in ClientHello ch, over the handshake bytes
// before it (prefix) and the message without its binders.
fn bind_psk(ch []u8, t ticket, prefix []u8) ![]u8 {
	let h = suite_hash(t.suite)
	let n = seal.Size(h)
	let out = clone(ch)
	let binder = try psk_binder(h, t.psk, prefix, out[:len(out)-binders_len(n)])
	copy(out[len(out)-n:], binder)
	return out
}
