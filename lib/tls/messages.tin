package tls

import "seal"

// ---- reading and writing the wire format (RFC 8446 section 3) ----

// rdr reads big-endian fields from b; a read past the end sets bad and gives zeros, so a
// parser checks bad once at the end (decode_error).
type rdr struct {
	b   []u8
	at  i64
	bad bool
}

fn (r mut rdr) u8v() i64 {
	if r.at+1 > len(r.b) {
		r.bad = true
		return 0
	}
	let v = i64(r.b[r.at])
	r.at += 1
	return v
}

fn (r mut rdr) u16v() i64 {
	if r.at+2 > len(r.b) {
		r.bad = true
		return 0
	}
	let v = i64(r.b[r.at])<<8 | i64(r.b[r.at+1])
	r.at += 2
	return v
}

fn (r mut rdr) u24v() i64 {
	if r.at+3 > len(r.b) {
		r.bad = true
		return 0
	}
	let v = i64(r.b[r.at])<<16 | i64(r.b[r.at+1])<<8 | i64(r.b[r.at+2])
	r.at += 3
	return v
}

// bytes reads n bytes (a view into b).
fn (r mut rdr) bytes(n i64) []u8 {
	if n < 0 || r.at+n > len(r.b) {
		r.bad = true
		return []u8{}
	}
	let v = r.b[r.at : r.at+n]
	r.at += n
	return v
}

fn (r mut rdr) vec8() []u8 {
	return r.bytes(r.u8v())
}

fn (r mut rdr) vec16() []u8 {
	return r.bytes(r.u16v())
}

fn (r mut rdr) vec24() []u8 {
	return r.bytes(r.u24v())
}

fn (r rdr) done() bool {
	return r.at == len(r.b)
}

fn put16(b mut []u8, v i64) {
	b = append(b, u8(v>>8), u8(v))
}

fn put24(b mut []u8, v i64) {
	b = append(b, u8(v>>16), u8(v>>8), u8(v))
}

// open_len appends a placeholder for an n-byte length and returns where it starts;
// close_len fills it with the length of what was appended since.
fn open_len(b mut []u8, n i64) i64 {
	let at = len(b)
	for i in 0..n {
		b = append(b, 0)
	}
	return at
}

fn close_len(b mut []u8, at i64, n i64) {
	let v = len(b) - at - n
	for i in 0..n {
		b[at+n-1-i] = u8(v >> (8 * i))
	}
}

fn cat(a []u8, b []u8) []u8 {
	mut out = make([]u8, 0, len(a)+len(b))
	out = append(out, a...)
	out = append(out, b...)
	return out
}

fn clone(a []u8) []u8 {
	let out = make([]u8, len(a))
	copy(out, a)
	return out
}

// ---- handshake message and extension numbers ----

const hsClientHello = 1
const hsServerHello = 2
const hsNewSessionTicket = 4
const hsEncryptedExtensions = 8
const hsCertificate = 11
const hsCertificateRequest = 13
const hsCertificateVerify = 15
const hsFinished = 20
const hsKeyUpdate = 24
const hsMessageHash = 254

const extServerName = 0
const extSupportedGroups = 10
const extSignatureAlgorithms = 13
const extALPN = 16
const extSupportedVersions = 43
const extCookie = 44
const extKeyShare = 51
const extPSKModes = 45
const extPreSharedKey = 41
const extRecordSizeLimit = 28

const groupX25519 = 0x001d
const groupP256 = 0x0017

// The SignatureSchemes offered: ECDSA, RSA-PSS and Ed25519 for CertificateVerify, and
// PKCS #1 v1.5 for certificate signatures only.
let sigSchemes = []i64{0x0403, 0x0503, 0x0804, 0x0805, 0x0806, 0x0807, 0x0401, 0x0501, 0x0601}

// hrrRandom is the ServerHello.random of a HelloRetryRequest: SHA-256("HelloRetryRequest").
const hrrRandom = "\xcf\x21\xad\x74\xe5\x9a\x61\x11\xbe\x1d\x8c\x02\x1e\x65\xb8\x91\xc2\xa2\x11\x16\x7a\xbb\x8c\x5e\x07\x9e\x09\xe2\xc8\xa8\x33\x9c"

// is_ip reports whether name is an IP literal (no SNI is sent for one, RFC 6066 section 3).
fn is_ip(name str) bool {
	if len(name) == 0 {
		return false
	}
	mut digits = true
	for i in 0..len(name) {
		let c = name[i]
		if c == ':' {
			return true
		}
		if (c < '0' || c > '9') && c != '.' {
			digits = false
		}
	}
	return digits
}

// pskOffer is a ticket offered in a ClientHello: its identity, the obfuscated age and the hash size
// the binder takes (the binder itself is filled in once the bytes before it are known).
type pskOffer struct {
	identity []u8
	age      i64
	hlen     i64
}

// chOptions are the optional parts of a ClientHello: the HelloRetryRequest's cookie, and a PSK.
type chOptions struct {
	cookie []u8
	offer  ?pskOffer
}

// client_hello encodes a ClientHello. share is the key_share entry (group, key). With a PSK
// offer it ends with psk_key_exchange_modes and pre_shared_key, whose binder is zeros: the
// caller computes it over the message without its last binders_len(offer) bytes.
fn client_hello(random []u8, session []u8, suites []i64, name str, alpn []str, group i64, share []u8, opt chOptions) []u8 {
	let cookie = opt.cookie
	mut b = make([]u8, 0, 512)
	b = append(b, hsClientHello)
	let body = open_len(mut b, 3)
	b = append(b, 3, 3)
	b = append(b, random...)
	b = append(b, u8(len(session)))
	b = append(b, session...)
	put16(mut b, 2*len(suites))
	for _, s in suites {
		put16(mut b, s)
	}
	b = append(b, 1, 0)
	let exts = open_len(mut b, 2)
	if name != "" && !is_ip(name) {
		put16(mut b, extServerName)
		let e = open_len(mut b, 2)
		let l = open_len(mut b, 2)
		b = append(b, 0)
		put16(mut b, len(name))
		b = append(b, name...)
		close_len(mut b, l, 2)
		close_len(mut b, e, 2)
	}
	put16(mut b, extSupportedGroups)
	put16(mut b, 6)
	put16(mut b, 4)
	put16(mut b, groupX25519)
	put16(mut b, groupP256)
	put16(mut b, extSignatureAlgorithms)
	put16(mut b, 2+2*len(sigSchemes))
	put16(mut b, 2*len(sigSchemes))
	for _, s in sigSchemes {
		put16(mut b, s)
	}
	if len(alpn) > 0 {
		put16(mut b, extALPN)
		let e = open_len(mut b, 2)
		let l = open_len(mut b, 2)
		for _, p in alpn {
			b = append(b, u8(len(p)))
			b = append(b, p...)
		}
		close_len(mut b, l, 2)
		close_len(mut b, e, 2)
	}
	put16(mut b, extSupportedVersions)
	put16(mut b, 3)
	b = append(b, 2, 3, 4)
	if len(cookie) > 0 {
		put16(mut b, extCookie)
		put16(mut b, 2+len(cookie))
		put16(mut b, len(cookie))
		b = append(b, cookie...)
	}
	put16(mut b, extKeyShare)
	put16(mut b, 2+4+len(share))
	put16(mut b, 4+len(share))
	put16(mut b, group)
	put16(mut b, len(share))
	b = append(b, share...)
	let offer = opt.offer
	if offer != nil {
		put16(mut b, extPSKModes)
		put16(mut b, 2)
		b = append(b, 1, 1) // psk_dhe_ke
		put16(mut b, extPreSharedKey)
		let e = open_len(mut b, 2)
		let ids = open_len(mut b, 2)
		put16(mut b, len(offer.identity))
		b = append(b, offer.identity...)
		b = append(b, u8(offer.age>>24), u8(offer.age>>16), u8(offer.age>>8), u8(offer.age))
		close_len(mut b, ids, 2)
		let bs = open_len(mut b, 2)
		b = append(b, u8(offer.hlen))
		for i in 0..offer.hlen {
			b = append(b, 0)
		}
		close_len(mut b, bs, 2)
		close_len(mut b, e, 2)
	}
	close_len(mut b, exts, 2)
	close_len(mut b, body, 3)
	return b
}

// binders_len is how many bytes at the end of a ClientHello with a PSK offer are binders.
fn binders_len(hlen i64) i64 {
	return 2 + 1 + hlen
}

// serverHello is what the client takes from a ServerHello or HelloRetryRequest.
type serverHello struct {
	retry   bool // a HelloRetryRequest
	suite   i64
	group   i64  // the key_share group (HelloRetryRequest: the group asked for)
	share   []u8 // the server's key share (ServerHello)
	cookie  []u8 // HelloRetryRequest
	version i64  // supported_versions, 0 when absent
	psk     bool // the server accepted the PSK offered (pre_shared_key with identity 0)
}

// parse_server_hello reads a ServerHello body; alert is set when it is malformed or not
// what was offered.
fn parse_server_hello(body []u8, session []u8) !serverHello {
	let r = rdr{b: body}
	let sh = serverHello{share: []u8{}, cookie: []u8{}}
	let legacy = r.u16v()
	let random = r.bytes(32)
	let echo = r.vec8()
	sh.suite = r.u16v()
	let comp = r.u8v()
	let exts = r.vec16()
	if r.bad || !r.done() {
		fail alert_fault(alertDecodeError, "malformed ServerHello")
	}
	sh.retry = str(random) == hrrRandom
	if legacy != 0x0303 || comp != 0 {
		fail alert_fault(alertIllegalParameter, "ServerHello has a bad legacy version or compression")
	}
	if !seal.ConstantTimeEq(echo, session) {
		fail alert_fault(alertIllegalParameter, "ServerHello does not echo the session id")
	}
	mut seen = make([]i64, 0, 8)
	let er = rdr{b: exts}
	for !er.bad && !er.done() {
		let typ = er.u16v()
		let data = er.vec16()
		for _, s in seen {
			if s == typ {
				fail alert_fault(alertIllegalParameter, "ServerHello repeats an extension")
			}
		}
		seen = append(seen, typ)
		let x = rdr{b: data}
		if typ == extSupportedVersions {
			sh.version = x.u16v()
		} else if typ == extKeyShare {
			sh.group = x.u16v()
			if !sh.retry {
				sh.share = x.vec16()
			}
		} else if typ == extPreSharedKey && !sh.retry {
			if x.u16v() != 0 {
				fail alert_fault(alertIllegalParameter, "ServerHello selects a PSK identity that was not offered")
			}
			sh.psk = true
		} else if typ == extCookie && sh.retry {
			sh.cookie = x.vec16()
			if len(sh.cookie) == 0 {
				x.bad = true
			}
		} else {
			fail alert_fault(alertUnsupportedExtension, "ServerHello has an extension that was not offered")
		}
		if x.bad || !x.done() {
			fail alert_fault(alertDecodeError, "malformed ServerHello extension")
		}
	}
	if er.bad {
		fail alert_fault(alertDecodeError, "malformed ServerHello extensions")
	}
	if sh.version != 0x0304 {
		fail alert_fault(alertProtocolVersion, "server does not support TLS 1.3")
	}
	return sh
}

// hello_extensions lists the extension types of a ClientHello message.
fn hello_extensions(ch []u8) []i64 {
	mut out = make([]i64, 0, 16)
	let r = rdr{b: ch}
	r.bytes(4 + 2 + 32)
	r.vec8()
	r.vec16()
	r.vec8()
	let er = rdr{b: r.vec16()}
	for !r.bad && !er.bad && !er.done() {
		out = append(out, er.u16v())
		er.vec16()
	}
	return out
}

// parse_encrypted_extensions returns the negotiated ALPN protocol ("" for none). Only
// extensions the ClientHello offered (offered) may appear, and of those only the ones
// EncryptedExtensions may carry (RFC 8446 4.2).
fn parse_encrypted_extensions(body []u8, alpn []str, offered []i64) !str {
	let r = rdr{b: body}
	let exts = r.vec16()
	if r.bad || !r.done() {
		fail alert_fault(alertDecodeError, "malformed EncryptedExtensions")
	}
	mut proto = ""
	mut seen = make([]i64, 0, 8)
	let er = rdr{b: exts}
	for !er.bad && !er.done() {
		let typ = er.u16v()
		let data = er.vec16()
		for _, s in seen {
			if s == typ {
				fail alert_fault(alertIllegalParameter, "EncryptedExtensions repeats an extension")
			}
		}
		seen = append(seen, typ)
		if !in_list(offered, typ) {
			fail alert_fault(alertUnsupportedExtension, "EncryptedExtensions has an extension that was not offered")
		}
		let x = rdr{b: data}
		if typ == extALPN {
			let list = rdr{b: x.vec16()}
			let p = str(list.vec8())
			if list.bad || !list.done() || len(p) == 0 {
				fail alert_fault(alertDecodeError, "malformed ALPN extension")
			}
			mut ok = false
			for _, a in alpn {
				if a == p {
					ok = true
				}
			}
			if !ok {
				fail alert_fault(alertIllegalParameter, "server chose an ALPN protocol that was not offered")
			}
			proto = p
		} else if typ == extServerName {
			if len(data) != 0 {
				x.bad = true
			}
		} else if typ == extSupportedGroups || typ == extRecordSizeLimit {
			// The server's groups are a hint; a record size limit is only offered by a fixed
			// ClientHello (the RFC 8448 trace), whose limit is the default.
			x.at = len(data)
		} else {
			fail alert_fault(alertIllegalParameter, "EncryptedExtensions has an extension it must not carry")
		}
		if x.bad || !x.done() {
			fail alert_fault(alertDecodeError, "malformed EncryptedExtensions extension")
		}
	}
	if er.bad {
		fail alert_fault(alertDecodeError, "malformed EncryptedExtensions")
	}
	return proto
}

// parse_certificate returns the certificate chain (DER, leaf first) of a server Certificate.
fn parse_certificate(body []u8) ![][]u8 {
	let r = rdr{b: body}
	let ctx = r.vec8()
	let list = r.vec24()
	if r.bad || !r.done() {
		fail alert_fault(alertDecodeError, "malformed Certificate")
	}
	if len(ctx) != 0 {
		fail alert_fault(alertIllegalParameter, "server Certificate has a request context")
	}
	mut certs = make([][]u8, 0, 4)
	let lr = rdr{b: list}
	for !lr.bad && !lr.done() {
		let der = lr.vec24()
		lr.vec16()
		if len(der) == 0 {
			lr.bad = true
		}
		certs = append(certs, der)
	}
	if lr.bad {
		fail alert_fault(alertDecodeError, "malformed certificate list")
	}
	if len(certs) == 0 {
		fail alert_fault(alertDecodeError, "server sent no certificate")
	}
	return certs
}

// parse_certificate_request returns the request context (the client answers with an empty
// Certificate carrying it).
fn parse_certificate_request(body []u8) ![]u8 {
	let r = rdr{b: body}
	let ctx = r.vec8()
	r.vec16()
	if r.bad || !r.done() {
		fail alert_fault(alertDecodeError, "malformed CertificateRequest")
	}
	return ctx
}

// cv_content is what a server's CertificateVerify signs (RFC 8446 section 4.4.3).
fn cv_content(transcript []u8) []u8 {
	mut b = make([]u8, 0, 64+34+len(transcript))
	for i in 0..64 {
		b = append(b, 0x20)
	}
	b = append(b, "TLS 1.3, server CertificateVerify"...)
	b = append(b, 0)
	b = append(b, transcript...)
	return b
}

// handshake_msg wraps body in a handshake header of type typ.
fn handshake_msg(typ i64, body []u8) []u8 {
	mut b = make([]u8, 0, 4+len(body))
	b = append(b, u8(typ))
	put24(mut b, len(body))
	b = append(b, body...)
	return b
}
