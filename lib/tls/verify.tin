package tls

import "say"
import "seal"

// ---- checking the server's certificate ----

// verify_peer checks the server's certificate chain for name against the roots (the system's,
// plus Config.RootCAs), and its CertificateVerify signature (scheme, sig) over signed. Only
// InsecureSkipVerify skips it, so verification can never be left out by accident.
fn verify_peer(cfg Config, name str, certs [][]u8, scheme i64, signed []u8, sig []u8) ! {
	if cfg.InsecureSkipVerify {
		return
	}
	if len(certs) == 0 {
		fail alert_fault(alertBadCertificate, "the server sent no certificate")
	}
	let leaf = seal.ParseCertificate(certs[0]) catch err {
		fail alert_fault(alertBadCertificate, say.Str(err))
	}
	let inter = seal.NewCertPool()
	for i in 1..len(certs) {
		let c = seal.ParseCertificate(certs[i]) catch err {
			fail alert_fault(alertBadCertificate, say.Str(err))
		}
		inter.Add(c)
	}
	let opts = seal.VerifyOptions{DNSName: name, Intermediates: inter}
	if cfg.RootCAs != "" {
		opts.Roots = try roots_with(cfg.RootCAs)
	}
	leaf.Verify(opts) catch err {
		fail alert_fault(alertBadCertificate, say.Str(err))
	}
	leaf.CheckTLSSignature(scheme, signed, sig) catch err {
		fail alert_fault(alertDecryptError, say.Str(err))
	}
}

// The pool of the system's roots plus the last RootCAs asked for, per core (most programs give
// one RootCAs, so a connection does not copy the system's roots again).
mut extraRoots str
mut extraPool ?seal.CertPool

// roots_with is the system's roots (when there are any) and the PEM certificates in pem.
fn roots_with(pem str) !seal.CertPool {
	let cached = extraPool
	if cached != nil && extraRoots == pem {
		return cached
	}
	let pool = seal.NewCertPool()
	let (sys, err) = seal.SystemRoots()
	if err == nil {
		for _, c in sys.Certificates() {
			pool.Add(c)
		}
	}
	let n = pool.AddPEM(pem) catch e {
		fail say.Fault("tls: Config.RootCAs: %v", e)
	}
	if n == 0 {
		fail "tls: Config.RootCAs holds no certificate"
	}
	extraRoots = keep(pem)
	extraPool = keep(pool)
	return pool
}
