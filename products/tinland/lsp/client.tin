// A client of the Language Server Protocol: starts a language server (gopls, rust-analyzer, ...), tells it about the open files and
// asks it for completions, and keeps the diagnostics it publishes. It never waits: the program calls Poll between frames and
// takes what has arrived.
package lsp

import "appkit"
import "mint"
import "quarry"
import "tinjson"
import "tinsym"
import "twine"

// Client is one running language server.
type Client struct {
	Name str
	Root str
	P appkit.Pipe
	// In holds bytes received that are not a whole message yet.
	In str
	NextID i64
	// Ready says the server answered initialize; Failed that it could not be started or went away.
	Ready bool
	Failed bool
	// Items is the answer to the last completion request, and Asked the id of the request still unanswered (0 when none).
	Items []tinsym.Item
	Asked i64
	Answered bool
	// Diags are the problems the server published, for every file it spoke about.
	Diags []tinsym.Diag
	DiagsChanged bool
	// Sent is the version of each file's text the server has (path, then version).
	SentPaths []str
	SentVersions []i64
}

// extraDirs are searched for servers besides PATH (a program started from the Finder has a short PATH).
fn extraDirs() []str {
	let home = quarry.Getenv("HOME")
	return []str{home + "/go/bin", home + "/.cargo/bin", home + "/.local/bin", "/opt/homebrew/bin", "/usr/local/bin"}
}

// Find is the full path of a program by name ("" when there is none), looking in PATH and the usual places.
fn Find(name str) str {
	mut dirs = twine.Split(quarry.Getenv("PATH"), ":")
	for d in extraDirs() {
		dirs = append(dirs, d)
	}
	for d in dirs {
		if len(d) > 0 && quarry.Exists(d + "/" + name) {
			return d + "/" + name
		}
	}
	return ""
}

// ServerFor is the command of the language server for a language id ("go", "rust", "typescript", "python"): the full path first,
// then its arguments; empty when none is installed.
fn ServerFor(lang str) []str {
	if lang == "go" {
		let p = Find("gopls")
		if len(p) > 0 {
			return []str{p}
		}
	} else if lang == "rust" {
		let p = Find("rust-analyzer")
		if len(p) > 0 {
			return []str{p}
		}
	} else if lang == "typescript" || lang == "javascript" {
		let p = Find("typescript-language-server")
		if len(p) > 0 {
			return []str{p, "--stdio"}
		}
	} else if lang == "python" {
		let p = Find("pyright-langserver")
		if len(p) > 0 {
			return []str{p, "--stdio"}
		}
		let q = Find("pylsp")
		if len(q) > 0 {
			return []str{q}
		}
	}
	return []str{}
}

fn uri(path str) str {
	return "file://" + path
}

// send frames a JSON message for the server.
fn (c mut Client) send(body str) {
	c.P.Send("Content-Length: " + mint.Itoa(len(body)) + "\r\n\r\n" + body)
}

fn (c mut Client) request(method str, params str) i64 {
	c.NextID += 1
	let id = c.NextID
	c.send(`{"jsonrpc":"2.0","id":` + mint.Itoa(id) + ",\"method\":" + tinjson.Quote(method) + ",\"params\":" + params + `}`)
	return id
}

fn (c mut Client) notify(method str, params str) {
	c.send(`{"jsonrpc":"2.0","method":` + tinjson.Quote(method) + ",\"params\":" + params + `}`)
}

// Start runs the server (argv as ServerFor gives it) for the project folder and begins the handshake.
fn Start(name str, argv []str, root str) Client {
	let c = Client{Name: name, Root: root, P: appkit.Pipe{}, Items: []tinsym.Item{}, Diags: []tinsym.Diag{}, SentPaths: []str{}, SentVersions: []i64{}}
	if len(argv) == 0 {
		c.Failed = true
		return c
	}
	c.P = appkit.StartPipe(root, argv)
	if !c.P.Alive {
		c.Failed = true
		return c
	}
	let caps = `{"textDocument":{"completion":{"completionItem":{"snippetSupport":false}},"publishDiagnostics":{}},"workspace":{"workspaceFolders":true}}`
	c.request("initialize", `{"processId":` + mint.Itoa(quarry.Pid()) + ",\"rootUri\":" + tinjson.Quote(uri(root)) + ",\"capabilities\":" + caps + `,"workspaceFolders":[{"uri":` + tinjson.Quote(uri(root)) + ",\"name\":" + tinjson.Quote(name) + `}]}`)
	return c
}

// Stop ends the server.
fn (c mut Client) Stop() {
	if c.P.Alive {
		c.request("shutdown", "null")
		c.notify("exit", "null")
		c.P.Stop()
	}
}

// versionOf is the version the server has of a file (-1 when it has not been opened).
fn (c Client) versionOf(path str) i64 {
	for i in 0..len(c.SentPaths) {
		if c.SentPaths[i] == path {
			return c.SentVersions[i]
		}
	}
	return -1
}

// NeedsSync reports whether the server has an older version of the file than this one.
fn (c Client) NeedsSync(path str, version i64) bool {
	return c.versionOf(path) != version
}

// Sync tells the server the text of a file, opening it the first time and sending a change after that (the whole text: servers
// all take it). version says which edit of the text this is; the same version again sends nothing.
fn (c mut Client) Sync(path str, langID str, text str, version i64) {
	if !c.Ready || c.Failed {
		return
	}
	let have = c.versionOf(path)
	if have == version {
		return
	}
	if have < 0 {
		c.notify("textDocument/didOpen", `{"textDocument":{"uri":` + tinjson.Quote(uri(path)) + ",\"languageId\":" + tinjson.Quote(langID) + ",\"version\":" + mint.Itoa(version) + ",\"text\":" + tinjson.Quote(text) + `}}`)
		c.SentPaths = append(c.SentPaths, path)
		c.SentVersions = append(c.SentVersions, version)
		return
	}
	c.notify("textDocument/didChange", `{"textDocument":{"uri":` + tinjson.Quote(uri(path)) + ",\"version\":" + mint.Itoa(version) + `},"contentChanges":[{"text":` + tinjson.Quote(text) + `}]}`)
	for i in 0..len(c.SentPaths) {
		if c.SentPaths[i] == path {
			c.SentVersions[i] = version
		}
	}
}

// Complete asks for the completions at a place (line and character from 0); the answer comes through Poll into Items.
fn (c mut Client) Complete(path str, line i64, character i64) {
	if !c.Ready || c.Failed {
		return
	}
	c.Answered = false
	c.Items = []tinsym.Item{}
	c.Asked = c.request("textDocument/completion", `{"textDocument":{"uri":` + tinjson.Quote(uri(path)) + `},"position":{"line":` + mint.Itoa(line) + ",\"character\":" + mint.Itoa(character) + `}}`)
}

// kindName is the word for a completion item kind number.
fn kindName(k i64) str {
	if k == 2 || k == 3 {
		return "fn"
	}
	if k == 5 || k == 10 {
		return "field"
	}
	if k == 6 {
		return "var"
	}
	if k == 7 || k == 8 || k == 22 {
		return "type"
	}
	if k == 9 {
		return "package"
	}
	if k == 14 {
		return "keyword"
	}
	if k == 21 {
		return "const"
	}
	return "item"
}

// Poll takes in what the server has said: it reports whether anything changed that the program should look at (new completion
// items, new diagnostics, the handshake done).
fn (c mut Client) Poll() bool {
	if c.Failed {
		return false
	}
	let got = c.P.Read()
	if !c.P.Alive {
		c.Failed = true
		return true
	}
	if len(got) == 0 && len(c.In) == 0 {
		return false
	}
	c.In = c.In + got
	mut changed = false
	for {
		let sep = twine.Index(c.In, "\r\n\r\n")
		if sep < 0 {
			break
		}
		let head = c.In[0:sep]
		let at = twine.Index(head, "Content-Length:")
		if at < 0 {
			// not a header: drop what we have
			c.In = ""
			break
		}
		let digits = twine.TrimSpace(twine.Split(head[at + 15:], "\r\n")[0])
		let n = mint.Atoi(digits) catch _ {
			0
		}
		if len(c.In) < sep + 4 + n {
			break
		}
		let body = c.In[sep + 4:sep + 4 + n]
		c.In = c.In[sep + 4 + n:]
		if c.handle(body) {
			changed = true
		}
	}
	return changed
}

// handle acts on one message; it reports whether the program should look at something new.
fn (c mut Client) handle(body str) bool {
	let (j, ok) = tinjson.Parse(body)
	if !ok {
		return false
	}
	let method = j.Get("method").Text()
	let idj = j.Get("id")
	if len(method) > 0 && !idj.IsNull() {
		// a request from the server (configuration, progress, registrations): answer with nothing, so it does not wait
		c.send(`{"jsonrpc":"2.0","id":` + idText(idj) + `,"result":null}`)
		return false
	}
	if len(method) > 0 {
		if method == "textDocument/publishDiagnostics" {
			c.takeDiagnostics(j.Get("params"))
			return true
		}
		return false
	}
	if idj.IsNull() {
		return false
	}
	let id = idj.Int()
	if id == 1 && !c.Ready {
		c.Ready = true
		c.notify("initialized", `{}`)
		return true
	}
	if id == c.Asked {
		c.Asked = 0
		c.Answered = true
		let result = j.Get("result")
		mut list = result
		if result.Get("items").Len() > 0 || result.Get("items").Len() == 0 && !result.Get("items").IsNull() {
			list = result.Get("items")
		}
		mut items = []tinsym.Item{}
		for it in list.Items() {
			let label = it.Get("label").Text()
			if len(label) > 0 && len(items) < 300 {
				items = append(items, tinsym.Item{Label: label, Kind: kindName(it.Get("kind").Int()), Detail: it.Get("detail").Text()})
			}
		}
		c.Items = items
		return true
	}
	return false
}

// idText is a request id as it must be sent back (a number or a string).
fn idText(j tinjson.J) str {
	if j.IsString() {
		return tinjson.Quote(j.Text())
	}
	return mint.Itoa(j.Int())
}

// takeDiagnostics replaces the diagnostics of one file with what the server published.
fn (c mut Client) takeDiagnostics(params tinjson.J) {
	let u = params.Get("uri").Text()
	let path = twine.TrimPrefix(u, "file://")
	mut kept = []tinsym.Diag{}
	for d in c.Diags {
		if d.File != path {
			kept = append(kept, d)
		}
	}
	for d in params.Get("diagnostics").Items() {
		let r = d.Get("range")
		kept = append(kept, tinsym.Diag{File: path, Line: r.Get("start").Get("line").Int() + 1, Col: r.Get("start").Get("character").Int() + 1, EndLine: r.Get("end").Get("line").Int() + 1, EndCol: r.Get("end").Get("character").Int() + 1, Code: d.Get("code").Text(), Message: d.Get("message").Text()})
	}
	c.Diags = kept
	c.DiagsChanged = true
}
