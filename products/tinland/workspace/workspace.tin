// A workspace is what one window holds: the title bar, the docks (the project panel on the left, the output panel at the
// bottom), the editor with its tabs, and the status bar. This package owns the state of all of it, builds each frame's element
// tree from that state, and turns the window's events into changes of it.
package workspace

import "../editor"
import "../lsp"
import "../terminal"
import "../project"
import "textedit"
import "../theme"
import "../ui"
import "appkit"

// Ids of the elements the mouse can reach.
const idTitle = 1
const idLeftScroll = 2
// The editor area of pane p has the id idPaneBase + p (up to maxPanes of them).
const idPaneBase = 3100
const maxPanes = 4
const idDivider = 4
const idOutputScroll = 5
const idOutputClose = 6
const idNewFile = 7
const idNewFolder = 8
const idRefresh = 9
const idPanelBase = 10
const idTabBase = 1000
const idTabClose = 2000
const tabsPerPane = 100
const idSearchInput = 20
const idSearchCase = 21
const idSearchWord = 22
const idSearchRegex = 23
const idPickerInput = 24
const idSearchScroll = 25
const idSearchReplace = 28
const idReplaceAll = 29
const idStatusCrlf = 30
const idStatusWrap = 31
const idPanelScroll = 26
const idRow = 10000
const idOutputLine = 30000
const idPickerItem = 40000
const idSearchRow = 50000
const idSymRow = 60000
const idDiagRow = 70000
const idGitRow = 80000

// The panels of the left dock and their buttons in the status bar.
const PanelProject = 0
const PanelGit = 1
const PanelOutline = 2
const PanelSearch = 3
const PanelDiagnostics = 4
const PanelTerminal = 5
const PanelDebug = 6

// What the mouse is doing: nothing, dragging the dock's edge, selecting text.
const dragNone = 0
const dragDivider = 1
const dragText = 2
const DragTitle = 3
const dragTerm = 4

// Sizes in points.
const titleH = 36.0
const statusH = 26.0
const tabH = 34.0
const rowH = 24.0
const outputH = 200.0

// Workspace is the state of one window.
type Workspace struct {
	Th theme.Theme
	// Ed is the editor of the active pane (the same object as Panes[Active]).
	Ed editor.Editor
	Panes []editor.Editor
	Active i64
	Proj project.Project
	HasProj bool
	Scrolls ui.Scrolls
	Hits ui.HitList
	LeftOpen bool
	LeftW f64
	Panel i64
	// W and H are the window's size in points; MouseX and MouseY where the mouse was last.
	W f64
	H f64
	MouseX f64
	MouseY f64
	Hover i64
	Drag i64
	// Dirty says the next frame must be drawn.
	Dirty bool
	Quit bool
	// Frames counts drawn frames (the tests use it).
	Frames i64
	// Focus is where typed text goes: the editor, the search box or the picker.
	Focus i64
	Picker Picker
	// Recent are the files opened lately, newest first; RecentPath is the file they are kept in (empty: they are not kept).
	Recent []str
	RecentPath str
	Search Search
	// Git is the output of git status, one line per changed file.
	Git []str
	// Menu asks the application to pop up a context menu for the last right click (MenuNone when it does not).
	Menu i64
	// CodeSize is the size of the code font in points.
	CodeSize f64
	// WantSettings asks the application to open its settings file (the file is the application's).
	WantSettings bool
	// The language servers: their clients, the language of each, and the one a completion request waits on (-1 for none).
	Lsps []lsp.Client
	LspLangs []str
	LspWaiting i64
	// The bottom dock: which panel shows, and the terminal: its screen, its shell, whether the shell runs, how far it is scrolled back.
	Bottom i64
	Term terminal.Screen
	Pty appkit.Pty
	TermUp bool
	TermScroll i64
	// The selection in the terminal, from (SelCol0, SelLine0) to (SelCol1, SelLine1), lines counted from the oldest history line.
	TermSel bool
	SelCol0 i64
	SelLine0 i64
	SelCol1 i64
	SelLine1 i64
}

const MenuNone = 0
const MenuTree = 1

// Where typed text goes.
const FocusEditor = 0
const FocusSearch = 1
const FocusPicker = 2
const FocusTerminal = 3
const FocusProject = 4
const FocusReplace = 5

// New makes a workspace around an editor.
fn New(th theme.Theme, ed editor.Editor) Workspace {
	let ws = Workspace{Th: th, Ed: ed, Proj: project.Project{Selected: -1}, Scrolls: ui.NewScrolls(64), Hits: ui.NewHitList(6000), Picker: Picker{Items: []str{}}, Recent: []str{}, Search: Search{Matches: []project.Match{}}, Git: []str{}, Lsps: []lsp.Client{}, LspLangs: []str{}, Term: terminal.New(80, 10), Pty: appkit.Pty{}}
	ws.LeftOpen = true
	ws.LeftW = 260.0
	ws.W = 1100.0
	ws.H = 720.0
	ws.Dirty = true
	ws.CodeSize = 13.0
	ws.LspWaiting = -1
	ws.Panes = []editor.Editor{ed}
	return ws
}

// OpenFolder makes the folder the project, showing it in the project panel.
fn (ws mut Workspace) OpenFolder(path str) bool {
	let p = project.Open(path) catch _ {
		ws.Ed.Say("cannot open folder " + path)
		return false
	}
	ws.Proj = p
	ws.HasProj = true
	ws.LeftOpen = true
	ws.Panel = PanelProject
	ws.Dirty = true
	return true
}

// OpenFile opens the file in the editor (a new tab, or the one that already shows it) and marks it in the project panel.
fn (ws mut Workspace) OpenFile(path str) {
	if ws.Ed.Load(path) {
		if ws.HasProj {
			ws.Proj.Reveal(path)
		}
		ws.NoteRecent(path)
	}
	ws.Dirty = true
}

// Title is the text of the window's title: the project, the branch and the file.
fn (ws Workspace) Title() str {
	mut t = ws.Ed.Name()
	if ws.Ed.Buf.Dirty {
		t = t + " (edited)"
	}
	if ws.HasProj {
		t = t + " - " + ws.Proj.Name
	}
	return t + " - Tinland"
}

// SetActive makes pane i the one typing goes to.
fn (ws mut Workspace) SetActive(i i64) {
	if i >= 0 && i < len(ws.Panes) && i != ws.Active {
		ws.Active = i
		ws.Ed = ws.Panes[i]
		ws.Dirty = true
	}
}

// Split opens another pane after the active one, showing the active file (up to maxPanes).
fn (ws mut Workspace) Split() {
	if len(ws.Panes) >= maxPanes {
		ws.Ed.Say("at most four panes")
		return
	}
	let pane = editor.New(textedit.New())
	pane.UseFont()
	if len(ws.Ed.Buf.Path) > 0 {
		pane.Load(ws.Ed.Buf.Path)
	}
	mut panes = []editor.Editor{}
	for i in 0..len(ws.Panes) {
		panes = append(panes, ws.Panes[i])
		if i == ws.Active {
			panes = append(panes, pane)
		}
	}
	ws.Panes = panes
	ws.Active = ws.Active + 1
	ws.Ed = ws.Panes[ws.Active]
	ws.Dirty = true
}

// CloseSplit closes the active pane (asking about unsaved changes in it) when there is more than one.
fn (ws mut Workspace) CloseSplit() {
	if len(ws.Panes) < 2 {
		return
	}
	let pane = ws.Panes[ws.Active]
	pane.Perform(editor.CmdQuit)
	if !pane.Quit {
		return
	}
	mut panes = []editor.Editor{}
	for i in 0..len(ws.Panes) {
		if i != ws.Active {
			panes = append(panes, ws.Panes[i])
		}
	}
	ws.Panes = panes
	if ws.Active >= len(ws.Panes) {
		ws.Active = len(ws.Panes) - 1
	}
	ws.Ed = ws.Panes[ws.Active]
	ws.Dirty = true
}

// UseFont tells every editor the size of a character cell.
fn (ws mut Workspace) UseFont() {
	for i in 0..len(ws.Panes) {
		ws.Panes[i].UseFont()
	}
}

// RequestQuit asks every pane about its unsaved files and reports whether the program may end (and sets Quit when it may).
fn (ws mut Workspace) RequestQuit() bool {
	for i in 0..len(ws.Panes) {
		ws.Panes[i].Perform(editor.CmdQuit)
		if !ws.Panes[i].Quit {
			return false
		}
	}
	ws.Quit = true
	return true
}

// CheckDisk looks for changes made to the open files by other programs, in every pane.
fn (ws mut Workspace) CheckDisk() {
	for i in 0..len(ws.Panes) {
		if ws.Panes[i].CheckDisk() {
			ws.Dirty = true
		}
	}
	if ws.HasProj && ws.Bottom != BottomTerminal && ws.Panel == PanelGit && ws.LeftOpen {
		ws.RefreshGit()
		ws.Dirty = true
	}
}

// CheckSources has the compiler look at the active file when it is Tin source that changed since it was last checked.
fn (ws mut Workspace) CheckSources() {
	if ws.Ed.DiagFor != ws.Ed.Buf.Version {
		ws.Ed.CheckNow()
		ws.Dirty = true
	}
}
