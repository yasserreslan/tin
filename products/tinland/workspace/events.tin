package workspace

import "../render"
import "appkit"
import "../editor"
import "textedit"

// Commands of the workspace, besides the editor's (editor.Cmd...). The menu bar sends these numbers.
const CmdOpenFolder = 100
const CmdToggleProject = 101
const CmdNewFile = 102
const CmdNewFolder = 103
const CmdRevealInProject = 104
const CmdQuickOpen = 105
const CmdPalette = 106
const CmdSearch = 107
const CmdToggleOutput = 108
const CmdRefresh = 109
const CmdNewFolder2 = 110
const CmdRename = 111
const CmdDelete = 112
const CmdCollapseAll = 113
const CmdZoomIn = 114
const CmdZoomOut = 115
const CmdZoomReset = 116
const CmdToggleTerminal = 117
const CmdSplit = 118
const CmdCloseSplit = 119
const CmdOpenSettings = 120
const CmdToggleWhitespace = 121

// Event kinds of an NSEvent that the workspace reads.
const evMouseDown = 1
const evRightDown = 3
const evMouseUp = 2
const evMouseMoved = 5
const evMouseDragged = 6
const evKeyDown = 10
const evScroll = 22

// Event acts on one window event: a key goes to the shortcuts and then the editor; the mouse is matched against what the last
// frame drew.
fn (ws mut Workspace) Event(e i64) {
	let t = appkit.EventType(e)
	if t == evKeyDown {
		ws.key(appkit.EventKeyCode(e), appkit.EventFlags(e), appkit.EventChars(e))
		return
	}
	if t == evScroll {
		let (sx, sy) = appkit.EventLocation(e)
		ws.MouseX = sx
		ws.MouseY = ws.H - sy
		// a mouse wheel reports lines, a trackpad points
		mut k = 1.0
		if !appkit.EventPreciseScroll(e) {
			k = 12.0
		}
		ws.scroll(appkit.EventScrollX(e) * k, appkit.EventScrollY(e) * k)
		return
	}
	if t != evMouseDown && t != evRightDown && t != evMouseUp && t != evMouseMoved && t != evMouseDragged {
		return
	}
	let (x, wy) = appkit.EventLocation(e)
	let y = ws.H - wy
	ws.MouseX = x
	ws.MouseY = y
	if t == evMouseMoved || t == evMouseDragged {
		let over = ws.Hits.At(x, y)
		if over != ws.Hover {
			ws.Hover = over
			ws.Dirty = true
		}
	}
	if t == evRightDown {
		let id = ws.Hits.At(x, y)
		if id >= idRow && id < idOutputLine {
			ws.clickSelect(id - idRow)
			ws.Menu = MenuTree
		}
		ws.Dirty = true
	} else if t == evMouseDown {
		ws.press(x, y, appkit.EventClicks(e), appkit.EventFlags(e))
	} else if t == evMouseDragged {
		ws.drag(x, y)
	} else if t == evMouseUp {
		ws.Drag = dragNone
		ws.Ed.MouseUp()
	}
}

// Key handles a key press (the events deliver keys here; tests call it directly).
fn (ws mut Workspace) Key(code i64, flags i64, chars str) {
	ws.key(code, flags, chars)
}

// key handles a key press: the workspace's own shortcuts first, then the editor.
fn (ws mut Workspace) key(code i64, flags i64, chars str) {
	if ws.Picker.Open {
		ws.pickerKey(code, flags, chars)
		return
	}
	if ws.Focus == FocusProject && (flags & appkit.ModCmd) == 0 {
		ws.projectKey(code)
		return
	}
	if ws.Focus == FocusTerminal && (flags & appkit.ModCmd) == 0 {
		ws.termKey(code, flags, chars)
		return
	}
	if ws.Focus == FocusReplace && (flags & appkit.ModCmd) == 0 {
		ws.replaceKey(code, flags, chars)
		return
	}
	if ws.Focus == FocusSearch && (flags & appkit.ModCmd) == 0 {
		ws.searchKey(code, flags, chars)
		return
	}
	if (flags & appkit.ModCmd) != 0 && (flags & appkit.ModShift) == 0 && (flags & appkit.ModAlt) == 0 && chars == "b" {
		ws.Perform(CmdToggleProject)
		return
	}
	// a language server answers Ctrl+Space, and a dot asks it what follows
	if code == 49 && (flags & appkit.ModCtrl) != 0 && ws.LspComplete() {
		ws.Dirty = true
		return
	}
	ws.Ed.KeyDown(code, flags, chars)
	if chars == "." && (flags & appkit.ModCmd) == 0 {
		ws.LspComplete()
	}
	ws.Dirty = true
}

// scroll moves what is under the mouse: the project panel, the output panel or the text.
fn (ws mut Workspace) scroll(dx f64, dy f64) {
	let id = ws.Hits.ScrollAt(ws.MouseX, ws.MouseY)
	if id == idLeftScroll || id == idOutputScroll || id == idSearchScroll || id == idPanelScroll {
		ws.Scrolls.Scroll(id, 0.0 - dy)
	} else if ws.Hits.At(ws.MouseX, ws.MouseY) == idTerminal {
		ws.TermScroll = max(0, min(ws.TermScroll + i64(dy / ws.Ed.LineH), ws.Term.HistoryLines()))
	} else {
		let over = ws.Hits.At(ws.MouseX, ws.MouseY)
		if isPane(over) && paneOf(over) < len(ws.Panes) {
			ws.Panes[paneOf(over)].Wheel(dx, dy)
		} else {
			ws.Ed.Wheel(dx, dy)
		}
	}
	ws.Dirty = true
}

// press handles a mouse button going down at (x, y).
fn (ws mut Workspace) press(x f64, y f64, clicks i64, flags i64) {
	let id = ws.Hits.At(x, y)
	ws.Dirty = true
	if isPane(id) {
		ws.SetActive(paneOf(id))
		let (ex, ey, ew, eh) = ws.Hits.Rect(id)
		ws.Ed.MouseDown(x - ex, y - ey, clicks, flags)
		ws.Drag = dragText
		return
	}
	if ws.Picker.Open {
		if id >= idPickerItem && id < idSearchRow {
			ws.accept(id - idPickerItem)
		} else if id != idPickerInput {
			ws.ClosePicker()
		}
		return
	}
	ws.Focus = FocusEditor
	ws.Ed.Mode = 0
	if id == idSearchInput {
		ws.Focus = FocusSearch
	} else if id == idSearchReplace {
		ws.Focus = FocusReplace
	} else if id == idReplaceAll {
		ws.ReplaceAll()
	} else if id == idSearchCase {
		ws.Search.Case = !ws.Search.Case
		ws.Search.Done = false
	} else if id == idSearchWord {
		ws.Search.Word = !ws.Search.Word
		ws.Search.Done = false
	} else if id == idSearchRegex {
		ws.Search.Regex = !ws.Search.Regex
		ws.Search.Done = false
	} else if id >= idGitRow {
		ws.openGitFile(id - idGitRow)
	} else if id >= idDiagRow {
		ws.openDiag(id - idDiagRow)
	} else if id >= idSymRow {
		ws.openSym(id - idSymRow)
	} else if id >= idSearchRow {
		ws.OpenMatch(id - idSearchRow)
	} else if id == idDivider {
		ws.Drag = dragDivider
	} else if id == idTitle {
		ws.Drag = DragTitle
	} else if id >= idRow && id < idOutputLine {
		ws.clickRow(id - idRow)
	} else if id >= idTabClose && id < idTabClose + maxPanes * tabsPerPane {
		ws.SetActive((id - idTabClose) / tabsPerPane)
		ws.Ed.CloseTab((id - idTabClose) % tabsPerPane)
	} else if id >= idTabBase && id < idTabBase + maxPanes * tabsPerPane {
		ws.SetActive((id - idTabBase) / tabsPerPane)
		ws.Ed.Activate((id - idTabBase) % tabsPerPane)
	} else if id >= idPanelBase && id < idTabBase {
		ws.togglePanel(id - idPanelBase)
	} else if id >= idOutputLine && id < idPickerItem {
		ws.Ed.JumpTo(ws.Ed.Output[id - idOutputLine])
	} else if id == idOutputClose {
		ws.Bottom = BottomNone
		ws.Focus = FocusEditor
	} else if id == idBottomOutput {
		ws.Bottom = BottomOutput
	} else if id == idBottomTerminal {
		ws.Bottom = BottomNone
		ws.ToggleTerminal()
	} else if id == idTerminal {
		ws.Focus = FocusTerminal
		ws.termPress(x, y)
	} else if id == idNewFile {
		ws.Perform(CmdNewFile)
	} else if id == idRefresh {
		ws.Perform(CmdRefresh)
	}
}

// drag handles the mouse moving with the button down.
fn (ws mut Workspace) drag(x f64, y f64) {
	if ws.Drag == dragDivider {
		mut w = x
		if w < 160.0 {
			w = 160.0
		}
		if w > 600.0 {
			w = 600.0
		}
		ws.LeftW = w
		ws.Dirty = true
	} else if ws.Drag == dragTerm {
		ws.termDrag(x, y)
		ws.Dirty = true
	} else if ws.Drag == dragText {
		let (ex, ey, ew, eh) = ws.Hits.Rect(paneId(ws.Active))
		ws.Ed.MouseDrag(x - ex, y - ey)
		ws.Dirty = true
	}
}

// clickRow opens a file, or opens or closes a folder, from a row of the project panel.
fn (ws mut Workspace) clickRow(r i64) {
	if r < 0 || r >= len(ws.Proj.Rows) {
		return
	}
	let i = ws.Proj.Rows[r]
	ws.Proj.Select(i)
	ws.Focus = FocusProject
	if ws.Proj.Entries[i].Dir {
		ws.Proj.Toggle(i)
	} else {
		ws.Ed.Load(ws.Proj.Entries[i].Path)
	}
}

// togglePanel shows panel k in the left dock, or hides the dock when k is already showing.
fn (ws mut Workspace) togglePanel(k i64) {
	if ws.LeftOpen && ws.Panel == k {
		ws.LeftOpen = false
	} else if k == PanelTerminal {
		ws.ToggleTerminal()
	} else {
		ws.LeftOpen = true
		ws.Panel = k
		if k == PanelSearch {
			ws.Focus = FocusSearch
		}
		if k == PanelGit {
			ws.RefreshGit()
		}
		if k == PanelDiagnostics {
			ws.Ed.CheckNow()
		}
	}
}

// Perform does a menu command.
fn (ws mut Workspace) Perform(cmd i64) {
	ws.Dirty = true
	if cmd == CmdToggleProject {
		ws.togglePanel(PanelProject)
	} else if cmd == CmdOpenFolder {
		let path = appkit.FolderPanel()
		if len(path) > 0 {
			ws.OpenFolder(path)
		}
	} else if cmd == CmdQuickOpen {
		ws.OpenPicker(PickFile)
	} else if cmd == CmdPalette {
		ws.OpenPicker(PickCommand)
	} else if cmd == CmdSearch {
		ws.LeftOpen = true
		ws.Panel = PanelSearch
		ws.Focus = FocusSearch
	} else if cmd == CmdToggleOutput {
		if ws.Bottom == BottomOutput {
			ws.Bottom = BottomNone
		} else {
			ws.Bottom = BottomOutput
		}
	} else if cmd == editor.CmdQuit {
		ws.RequestQuit()
	} else if cmd == editor.CmdComplete && ws.LspComplete() {
		ws.Dirty = true
	} else if cmd == CmdOpenSettings {
		ws.WantSettings = true
	} else if cmd == CmdSplit {
		ws.Split()
	} else if cmd == CmdCloseSplit {
		ws.CloseSplit()
	} else if cmd == CmdToggleTerminal {
		ws.ToggleTerminal()
	} else if cmd == CmdRefresh {
		if ws.HasProj {
			ws.Proj.Refresh()
			ws.RefreshGit()
		}
	} else if cmd == CmdNewFile {
		ws.OpenPicker(PickNewFile)
	} else if cmd == CmdNewFolder2 {
		ws.OpenPicker(PickNewFolder)
	} else if cmd == CmdRename {
		ws.OpenPicker(PickRename)
	} else if cmd == CmdDelete {
		ws.deleteSelected()
	} else if cmd == CmdZoomIn {
		ws.zoom(ws.CodeSize + 1.0)
	} else if cmd == CmdZoomOut {
		ws.zoom(ws.CodeSize - 1.0)
	} else if cmd == CmdZoomReset {
		ws.zoom(13.0)
	} else if cmd == CmdToggleWhitespace {
		if editor.ToggleWhitespace() {
			ws.Ed.Say("whitespace shown")
		} else {
			ws.Ed.Say("whitespace hidden")
		}
	} else if cmd == CmdCollapseAll {
		ws.collapseAll()
	} else if cmd == CmdRevealInProject {
		if ws.HasProj && len(ws.Ed.Buf.Path) > 0 {
			ws.Proj.Reveal(ws.Ed.Buf.Path)
			ws.LeftOpen = true
			ws.Panel = PanelProject
		}
	} else if cmd == editor.CmdCopy && ws.Focus == FocusTerminal {
		let text = ws.TermSelectedText()
		if len(text) > 0 {
			appkit.SetClipboard(text)
		}
	} else if cmd == editor.CmdPaste && ws.Picker.Open {
		ws.Picker.Query = pasteLine(ws.Picker.Query, appkit.ClipboardText())
		ws.Picker.Sel = 0
		ws.refilter()
	} else if cmd == editor.CmdPaste && ws.Focus == FocusSearch {
		ws.Search.Query = pasteLine(ws.Search.Query, appkit.ClipboardText())
		ws.Search.Done = false
	} else if cmd == editor.CmdPaste && ws.Focus == FocusReplace {
		ws.Search.Replace = pasteLine(ws.Search.Replace, appkit.ClipboardText())
	} else if cmd == editor.CmdPaste && ws.Focus == FocusTerminal {
		ws.Pty.Type(appkit.ClipboardText())
	} else if cmd == editor.CmdOpen {
		let path = appkit.OpenPanel()
		if len(path) > 0 {
			ws.OpenFile(path)
		}
	} else {
		ws.Ed.Perform(cmd)
	}
}

// deleteSelected removes the selected file or folder after asking.
fn (ws mut Workspace) deleteSelected() {
	if !ws.HasProj || ws.Proj.Selected <= 0 {
		return
	}
	let e = ws.Proj.Entries[ws.Proj.Selected]
	if appkit.Alert("Delete " + e.Name + "?", "This removes it from disk and cannot be undone.", []str{"Delete", "Cancel"}) != 0 {
		return
	}
	ws.Proj.Delete(ws.Proj.Selected) catch _ {
		ws.Ed.Say("cannot delete " + e.Name)
		return
	}
}

// collapseAll closes every folder of the project panel.
fn (ws mut Workspace) collapseAll() {
	if !ws.HasProj {
		return
	}
	for i in 1..len(ws.Proj.Entries) {
		ws.Proj.Entries[i].Open = false
	}
	ws.Proj.Rebuild()
}

// clickSelect selects a row of the project panel without opening it.
fn (ws mut Workspace) clickSelect(r i64) {
	if r >= 0 && r < len(ws.Proj.Rows) {
		ws.Proj.Select(ws.Proj.Rows[r])
	}
}

// zoom sets the code font size (within 8 and 40 points).
fn (ws mut Workspace) zoom(points f64) {
	mut p = points
	if p < 8.0 {
		p = 8.0
	}
	if p > 40.0 {
		p = 40.0
	}
	ws.CodeSize = p
	render.SetCodeSize(p)
	ws.UseFont()
	ws.Dirty = true
}

// paneOf is the pane an editor area id belongs to, paneId the id of a pane's editor area, isPane whether an id is one.
fn paneOf(id i64) i64 {
	return id - idPaneBase
}

fn paneId(pane i64) i64 {
	return idPaneBase + pane
}

fn isPane(id i64) bool {
	return id >= idPaneBase && id < idPaneBase + maxPanes
}

// projectKey handles a key while the project panel has the keyboard: Up and Down move the selection, Right opens a folder, Left
// closes it (or goes to the one above), Return opens the file or toggles the folder, Delete asks to delete, Escape gives the
// keyboard back to the editor.
fn (ws mut Workspace) projectKey(code i64) {
	if !ws.HasProj {
		ws.Focus = FocusEditor
		return
	}
	mut row = -1
	for r in 0..len(ws.Proj.Rows) {
		if ws.Proj.Rows[r] == ws.Proj.Selected {
			row = r
		}
	}
	if code == keyEscape {
		ws.Focus = FocusEditor
	} else if code == keyDown {
		if row + 1 < len(ws.Proj.Rows) {
			ws.Proj.Select(ws.Proj.Rows[row + 1])
			ws.showRow(row + 1)
		}
	} else if code == keyUp {
		if row > 0 {
			ws.Proj.Select(ws.Proj.Rows[row - 1])
			ws.showRow(row - 1)
		}
	} else if code == 124 && row >= 0 {
		let e = ws.Proj.Entries[ws.Proj.Selected]
		if e.Dir && !e.Open {
			ws.Proj.Toggle(ws.Proj.Selected)
		}
	} else if code == 123 && row >= 0 {
		let e = ws.Proj.Entries[ws.Proj.Selected]
		if e.Dir && e.Open && ws.Proj.Selected != 0 {
			ws.Proj.Toggle(ws.Proj.Selected)
		} else if e.Parent >= 0 {
			ws.Proj.Select(e.Parent)
			ws.Proj.Rebuild()
			for r in 0..len(ws.Proj.Rows) {
				if ws.Proj.Rows[r] == e.Parent {
					ws.showRow(r)
				}
			}
		}
	} else if code == keyReturn && row >= 0 {
		ws.clickRow(row)
		if !ws.Proj.Entries[ws.Proj.Rows[row]].Dir {
			ws.Focus = FocusEditor
		}
	} else if code == 117 || code == keyBackspace {
		ws.deleteSelected()
	}
	ws.Dirty = true
}

// showRow scrolls the project panel so that row r is in view.
fn (ws mut Workspace) showRow(r i64) {
	let viewH = ws.H - titleH - statusH - 34.0
	let top = f64(r) * rowH
	let off = ws.Scrolls.Offset[idLeftScroll]
	if top < off {
		ws.Scrolls.Offset[idLeftScroll] = top
	} else if top + rowH > off + viewH {
		ws.Scrolls.Offset[idLeftScroll] = top + rowH - viewH
	}
}
