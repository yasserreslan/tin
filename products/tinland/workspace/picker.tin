// OpenPicker shows the picker for a kind of choice.
fn (ws mut Workspace) OpenPicker(kind i64) {
	ws.Picker.Open = true
	ws.Picker.Kind = kind
	ws.Picker.Query = ""
	ws.Picker.Sel = 0
	ws.Focus = FocusPicker
	if kind == PickRename && ws.HasProj && ws.Proj.Selected > 0 {
		ws.Picker.Query = ws.Proj.Entries[ws.Proj.Selected].Name
	}
	ws.refilter()
}

// ClosePicker hides the picker and gives the keyboard back to the editor.
fn (ws mut Workspace) ClosePicker() {
	ws.Picker.Open = false
	ws.Focus = FocusEditor
}

// refilter recomputes the list for the query.
fn (ws mut Workspace) refilter() {
	mut items = []str{}
	mut targets = []i64{}
	if ws.Picker.Kind >= PickNewFile && ws.Picker.Kind != PickRecent {
		ws.Picker.Items = items
		ws.Picker.Targets = targets
		return
	}
	if ws.Picker.Kind == PickRecent {
		items = project.Ranked(ws.Picker.Query, ws.Recent, 14)
		for it in items {
			targets = append(targets, 0)
		}
	} else if ws.Picker.Kind == PickSymbol {
		// the active file's declarations: its own kind after the name, sorted as the rows are
		mut names = []str{}
		mut ids = []i64{}
		for i in 0..len(ws.Ed.Syms) {
			let sy = ws.Ed.Syms[i]
			if sy.Kind == "local" || (len(sy.File) > 0 && sy.File != ws.Ed.Buf.Path) {
				continue
			}
			names = append(names, sy.Name + "  " + sy.Kind)
			ids = append(ids, i)
		}
		items = project.Ranked(ws.Picker.Query, names, 20)
		for it in items {
			mut id = 0
			for k in 0..len(names) {
				if names[k] == it {
					id = ids[k]
				}
			}
			targets = append(targets, id)
		}
	} else if ws.Picker.Kind == PickFile {
		if ws.HasProj {
			let all = ws.Proj.Files(20000)
			mut rel = []str{}
			for path in all {
				rel = append(rel, twine.TrimPrefix(path, ws.Proj.Root + "/"))
			}
			items = project.Ranked(ws.Picker.Query, rel, 14)
		}
		for it in items {
			targets = append(targets, 0)
		}
	} else {
		let all = commands()
		mut names = []str{}
		for c in all {
			names = append(names, c.name)
		}
		items = project.Ranked(ws.Picker.Query, names, 14)
		for it in items {
			mut id = 0
			for c in all {
				if c.name == it {
					id = c.cmd
				}
			}
			targets = append(targets, id)
		}
	}
	ws.Picker.Items = items
	ws.Picker.Targets = targets
	if ws.Picker.Sel >= len(items) {
		ws.Picker.Sel = 0
	}
}

// PickerKey handles a key while the picker is open (the events deliver keys here; tests call it directly).
fn (ws mut Workspace) PickerKey(code i64, flags i64, chars str) {
	ws.pickerKey(code, flags, chars)
}

// pickerKey handles a key while the picker is open.
fn (ws mut Workspace) pickerKey(code i64, flags i64, chars str) {
	if code == keyEscape {
		ws.ClosePicker()
	} else if code == keyReturn {
		if ws.Picker.Kind >= PickNewFile {
			ws.applyName()
		} else {
			ws.accept(ws.Picker.Sel)
		}
	} else if code == keyDown {
		if ws.Picker.Sel + 1 < len(ws.Picker.Items) {
			ws.Picker.Sel += 1
		}
	} else if code == keyUp {
		if ws.Picker.Sel > 0 {
			ws.Picker.Sel -= 1
		}
	} else {
		let q = editLine(ws.Picker.Query, code, flags, chars)
		if q != ws.Picker.Query {
			ws.Picker.Query = q
			ws.Picker.Sel = 0
			ws.refilter()
		}
	}
	ws.Dirty = true
}

// accept takes item i of the picker.
fn (ws mut Workspace) accept(i i64) {
	if i < 0 || i >= len(ws.Picker.Items) {
		return
	}
	let kind = ws.Picker.Kind
	let item = ws.Picker.Items[i]
	let target = ws.Picker.Targets[i]
	ws.ClosePicker()
	if kind == PickFile {
		ws.OpenFile(ws.Proj.Root + "/" + item)
	} else if kind == PickRecent {
		ws.OpenFile(item)
	} else if kind == PickSymbol {
		if target >= 0 && target < len(ws.Ed.Syms) {
			let sy = ws.Ed.Syms[target]
			ws.Ed.Buf.MoveTo(sy.Line - 1, max(sy.Col - 1, 0), false)
			ws.Ed.Follow = true
			ws.Ed.Say("at " + sy.Name)
		}
	} else {
		ws.Perform(target)
	}
}

// applyName creates or renames with the name typed.
fn (ws mut Workspace) applyName() {
	let name = twine.TrimSpace(ws.Picker.Query)
	let kind = ws.Picker.Kind
	ws.ClosePicker()
	if len(name) == 0 || !ws.HasProj {
		return
	}
	if kind == PickNewFile {
		let path = ws.Proj.NewFile(ws.Proj.Selected, name) catch _ {
			ws.Ed.Say("cannot create " + name)
			return
		}
		ws.OpenFile(path)
	} else if kind == PickNewFolder {
		ws.Proj.NewFolder(ws.Proj.Selected, name) catch _ {
			ws.Ed.Say("cannot create " + name)
			return
		}
	} else if kind == PickRename && ws.Proj.Selected > 0 {
		ws.Proj.Rename(ws.Proj.Selected, name) catch _ {
			ws.Ed.Say("cannot rename")
			return
		}
	}
}

// pickerPrompt is the line above the list.
fn (ws Workspace) pickerPrompt() str {
	if ws.Picker.Kind == PickFile {
		return "Go to file"
	}
	if ws.Picker.Kind == PickCommand {
		return "Command"
	}
	if ws.Picker.Kind == PickRecent {
		return "Open recent file"
	}
	if ws.Picker.Kind == PickSymbol {
		return "Go to symbol in file"
	}
	if ws.Picker.Kind == PickNewFile {
		return "New file name"
	}
	if ws.Picker.Kind == PickNewFolder {
		return "New folder name"
	}
	return "Rename to"
}
