package workspace

import "../project"
import "twine"

// The picker is the box that opens over the window to choose something by typing: a file (Go to File), a command (Command
// Palette). Typing narrows the list by fuzzy matching, Up and Down move through it, Return takes the chosen one.
const PickFile = 0
const PickCommand = 1
const PickNewFile = 2
const PickNewFolder = 3
const PickRename = 4
const PickRecent = 5
const PickSymbol = 6

// Picker is the state of the box.
type Picker struct {
	Open bool
	Kind i64
	Query str
	Items []str
	// Targets are what the items stand for: a path, or a command number.
	Targets []i64
	Sel i64
}

// A command of the palette: its name and the number Perform takes.
type command struct {
	name str
	cmd i64
}

fn commands() []command {
	return []command{
		command{name: "File: New", cmd: 1},
		command{name: "File: Open File...", cmd: 2},
		command{name: "File: Open Folder...", cmd: CmdOpenFolder},
		command{name: "File: Open Recent...", cmd: CmdOpenRecent},
