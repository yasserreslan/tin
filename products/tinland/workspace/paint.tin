package workspace

import "metal"
import "../render"
import "../ui"

// NeedsFrame reports whether anything changed since the last frame (the workspace's own state or the editor's).
fn (ws Workspace) NeedsFrame() bool {
	mut redraw = false
	for p in ws.Panes {
		if p.Redraw {
			redraw = true
		}
	}
	return ws.Dirty || redraw
}

// Resize tells the workspace the window's size in points and reports whether it changed.
fn (ws mut Workspace) Resize(w f64, h f64) bool {
	if w <= 0.0 || (w == ws.W && h == ws.H) {
		return false
	}
	ws.W = w
	ws.H = h
	return true
}

// Prepare does the part of a frame that stores new memory in the state (the editor's per-line highlighting state); call it before
// the frame's arena starts.
fn (ws mut Workspace) Prepare() {
	// the output of a run opens the dock on its Output tab
	if ws.Ed.OutputOpen {
		ws.Ed.OutputOpen = false
		ws.Bottom = BottomOutput
	}
	ws.termFit()
	ws.SyncLsp()
	if ws.HasProj && (ws.Ed.Buf.Path != ws.Ed.MarksPath || ws.Ed.Saves != ws.Ed.MarksSaves) {
		ws.RefreshMarks()
	}
	for i in 0..len(ws.Panes) {
		ws.Panes[i].Prepare()
	}
}

// Paint lays the window out for its size (ws.W by ws.H points) and draws it into the scene. It records where everything is for
// the mouse, and reads and changes nothing else that outlives the frame, so it can run in an arena.
fn (ws mut Workspace) Paint(scene mut metal.Scene) {
	let th = ws.Th
	mut t = ui.NewTree(render.Width, render.LineHeight)
	ws.Build(mut t)
	t.Hover = ws.Hover
	t.Layout(ws.W, ws.H, mut ws.Scrolls)
	t.Record(mut ws.Hits)
	let cmds = t.Paint()
	// the editor and the terminal paint their own areas: draw what comes before each, then it, then the rest
	mut from = 0
	for i in 0..len(cmds) {
		if cmds[i].Kind == ui.CmdCustom && (isPane(cmds[i].Arg) || cmds[i].Arg == idTerminal) {
			render.Draw(cmds[from:i], t.Texts, mut scene, noCustom)
			let c = cmds[i]
			if isPane(c.Arg) {
				ws.Panes[paneOf(c.Arg)].Paint(th, c.X, c.Y, c.W, c.H, mut scene)
				if !ws.HasProj && c.Arg == paneId(0) && ws.Panes[0].Empty() {
					ws.welcome(c.X, c.Y, c.W, c.H, mut scene)
				}
			} else {
				ws.paintTerminal(c.X, c.Y, c.W, c.H, mut scene)
			}
			from = i + 1
		}
	}
	render.Draw(cmds[from:len(cmds)], t.Texts, mut scene, noCustom)
	ws.Dirty = false
	for i in 0..len(ws.Panes) {
		ws.Panes[i].Redraw = false
	}
	ws.Frames += 1
}

fn noCustom(id i64, x f64, y f64, w f64, h f64, scene mut metal.Scene) {
}

// welcome tells what to do first, in the middle of an empty editor with no folder open.
fn (ws Workspace) welcome(x f64, y f64, w f64, h f64, scene mut metal.Scene) {
	let th = ws.Th
	let labels = []str{"Open Folder", "Go to File", "Command Palette", "Terminal"}
	let keys = []str{"Cmd+Shift+O", "Cmd+P", "Cmd+Shift+P", "Ctrl+`"}
	let lh = ws.Ed.LineH
	mut top = y + (h - lh * f64(len(labels) + 2)) / 2.0
	let title = "Tinland"
	render.Pen(mut scene, render.FontUIBold, x + (w - render.Width(render.FontUIBold, title)) / 2.0, top, title, th.Text)
	top += lh * 2.0
	let left = x + (w - 32.0 * render.CodeCell()) / 2.0
	for i in 0..len(labels) {
		render.Pen(mut scene, render.FontCode, left, top, labels[i], th.Muted)
		render.Pen(mut scene, render.FontCode, left + 20.0 * render.CodeCell(), top, keys[i], th.Faint)
		top += lh
	}
}
