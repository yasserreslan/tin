package workspace

import "../lsp"
import "glyph"
import "tinsym"
import "twine"

// The language servers: one per language, started when a file of that language is opened in a project and the server is
// installed. They give completion (Ctrl+Space, and after a dot) and diagnostics for files that are not Tin.

// langID is the Language Server Protocol's name for the language of a file ("" for none a server is known for).
fn langID(path str) str {
	if twine.HasSuffix(path, ".go") {
		return "go"
	}
	if twine.HasSuffix(path, ".rs") {
		return "rust"
	}
	if twine.HasSuffix(path, ".ts") || twine.HasSuffix(path, ".tsx") {
		return "typescript"
	}
	if twine.HasSuffix(path, ".js") || twine.HasSuffix(path, ".jsx") {
		return "javascript"
	}
	if twine.HasSuffix(path, ".py") {
		return "python"
	}
	return ""
}

// lspIndex is the place of the client for the language in ws.Lsps (-1 when none).
fn (ws Workspace) lspIndex(lang str) i64 {
	for i in 0..len(ws.LspLangs) {
		if ws.LspLangs[i] == lang {
			return i
		}
	}
	return -1
}

// lspFor starts the language's server the first time it is needed; it returns its place, or -1 when there is no server.
fn (ws mut Workspace) lspFor(lang str) i64 {
	let have = ws.lspIndex(lang)
	if have >= 0 {
		if ws.Lsps[have].Failed {
			return -1
		}
		return have
	}
	if !ws.HasProj {
		return -1
	}
	let argv = lsp.ServerFor(lang)
	if len(argv) == 0 {
		// remember that there is none, so it is not looked for every frame
		ws.Lsps = append(ws.Lsps, lsp.Start(lang, argv, ws.Proj.Root))
		ws.LspLangs = append(ws.LspLangs, lang)
		return -1
	}
	ws.Lsps = append(ws.Lsps, lsp.Start(lang, argv, ws.Proj.Root))
	ws.LspLangs = append(ws.LspLangs, lang)
	return len(ws.Lsps) - 1
}

// SyncLsp tells the server of the active file's language what the text is now.
fn (ws mut Workspace) SyncLsp() {
	let path = ws.Ed.Buf.Path
	let lang = langID(path)
	if len(lang) == 0 {
		ws.Ed.ExternalDiags = false
		return
	}
	let i = ws.lspFor(lang)
	if i < 0 {
		ws.Ed.ExternalDiags = false
		return
	}
	ws.Ed.ExternalDiags = true
	if ws.Lsps[i].Ready && ws.Lsps[i].NeedsSync(path, ws.Ed.Buf.Version) {
		ws.Lsps[i].Sync(path, lang, ws.Ed.Buf.Text(), ws.Ed.Buf.Version)
	}
}

// PollLsp takes in what the servers said; it reports whether the screen needs a frame.
fn (ws mut Workspace) PollLsp() bool {
	mut changed = false
	for i in 0..len(ws.Lsps) {
		if ws.Lsps[i].Failed {
			continue
		}
		if ws.Lsps[i].Poll() {
			changed = true
		}
		let c = ws.Lsps[i]
		if c.Answered && ws.LspWaiting == i {
			ws.LspWaiting = -1
			if len(c.Items) > 0 {
				ws.Ed.OpenExternal(c.Items)
			} else {
				ws.Ed.Say("no completions")
			}
		}
		if c.DiagsChanged {
			c.DiagsChanged = false
			let path = ws.Ed.Buf.Path
			if langID(path) == ws.LspLangs[i] {
				mut mine = []tinsym.Diag{}
				for d in c.Diags {
					if d.File == path {
						mine = append(mine, d)
					}
				}
				ws.Ed.SetDiagnostics(mine)
			}
		}
	}
	if changed {
		ws.Dirty = true
	}
	return changed
}

// LspActive reports whether any server is running (the loop then looks at its pipes more often).
fn (ws Workspace) LspActive() bool {
	for c in ws.Lsps {
		if !c.Failed && c.P.Alive {
			return true
		}
	}
	return false
}

// LspComplete asks the server of the active file for completions at the caret; it reports whether there is one to ask.
fn (ws mut Workspace) LspComplete() bool {
	let path = ws.Ed.Buf.Path
	let lang = langID(path)
	if len(lang) == 0 {
		return false
	}
	let i = ws.lspFor(lang)
	if i < 0 || !ws.Lsps[i].Ready {
		return false
	}
	ws.SyncLsp()
	let b = ws.Ed.Buf
	// the server counts characters, not bytes
	let col = glyph.RuneCount(b.Lines[b.Row][0:b.Col])
	ws.Lsps[i].Complete(path, b.Row, col)
	ws.LspWaiting = i
	return true
}

// StopLsp ends the servers (when the window closes).
fn (ws mut Workspace) StopLsp() {
	for i in 0..len(ws.Lsps) {
		ws.Lsps[i].Stop()
	}
}
