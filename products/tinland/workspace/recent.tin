package workspace

import "quarry"
import "trail"
import "twine"

// The recent files: the last files opened, newest first, kept in a small text file (one path per line) so Open Recent has them
// at the next start. A file that no longer exists is left out when the list is read.

const recentMax = 30

// LoadRecent reads the list from path and keeps path for later writes.
fn (ws mut Workspace) LoadRecent(path str) {
	ws.RecentPath = path
	let text = quarry.ReadFile(path) catch _ {
		return
	}
	mut list = []str{}
	for line in twine.Split(text, "\n") {
		let p = twine.TrimSpace(line)
		if len(p) > 0 && quarry.Exists(p) && len(list) < recentMax {
			list = append(list, p)
		}
	}
	ws.Recent = list
}

// NoteRecent puts a file at the front of the list (once) and writes the list down.
fn (ws mut Workspace) NoteRecent(path str) {
	let full = trail.Clean(path)
	mut list = []str{full}
	for p in ws.Recent {
		if p != full && len(list) < recentMax {
			list = append(list, p)
		}
	}
	ws.Recent = list
	if len(ws.RecentPath) == 0 {
		return
	}
	quarry.MkdirAll(trail.Dir(ws.RecentPath)) catch _ {
		return
	}
	quarry.WriteFile(ws.RecentPath, twine.Join(list, "\n") + "\n") catch _ {
	}
}
