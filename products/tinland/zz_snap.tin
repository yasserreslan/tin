package main

import "editor"
import "metal"
import "quarry"
import "render"
import "textedit"
import "theme"
import "workspace"

fn main() {
	let gpu = metal.Open()
	render.Init(gpu, 2.0, 13.0)
	mut ed = editor.New(textedit.New())
	ed.UseFont()
	mut ws = workspace.New(theme.Dark(), ed)
	ws.OpenFolder(quarry.Args()[1])
	ws.OpenFile(quarry.Args()[2])
	ws.W = 1100.0
	ws.H = 700.0
	ws.Prepare()
	mut scene = metal.Scene{}
	ws.Paint(mut scene)
	render.Upload()
	render.Snapshot(scene, 2200, 1400, ws.Th.Background, "/tmp/ws.png")
}
