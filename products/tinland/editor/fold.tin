package editor

import "textedit"

// Code folding by indentation: a line followed by more indented lines can be folded, which hides those lines (the folded line
// shows an ellipsis). The folds belong to the open text: an edit that changes the number of lines, or switching tabs, drops them,
// and a fold that hides the caret opens.

// fold hides the lines Start+1 to End; Start stays visible.
type fold struct {
	Start i64
	End   i64
}

const CmdFold = 29
const CmdUnfold = 30
const CmdUnfoldAll = 31

// indentOf is the width of a line's leading white space (a tab counts to the next stop of four), or -1 for a blank line.
fn indentOf(line str) i64 {
	mut col = 0
	for k in 0..len(line) {
		let c = line[k]
		if c == ' ' {
			col += 1
		} else if c == '\t' {
			col += 4 - col % 4
		} else {
			return col
		}
	}
	return -1
}

// blockEnd is the last line of the block that starts at row: the lines after it that are indented deeper (blank lines between
// them belong, those at the end do not). It is row itself when there is no block.
fn (ed Editor) blockEnd(row i64) i64 {
	let lines = ed.Buf.Lines
	let base = indentOf(lines[row])
	if base < 0 {
		return row
	}
	mut end = row
	mut r = row + 1
	for r < len(lines) {
		let d = indentOf(lines[r])
		if d >= 0 && d <= base {
			break
		}
		if d > base {
			end = r
		}
		r += 1
	}
	return end
}

// foldAt is the index of the fold that starts at row, or -1.
fn (ed Editor) foldAt(row i64) i64 {
	for i in 0..len(ed.Folds) {
		if ed.Folds[i].Start == row {
			return i
		}
	}
	return -1
}

// hiddenBy is the index of the fold that hides row, or -1.
fn (ed Editor) hiddenBy(row i64) i64 {
	for i in 0..len(ed.Folds) {
		if row > ed.Folds[i].Start && row <= ed.Folds[i].End {
			return i
		}
	}
	return -1
}

// nextVisible is the line shown after row (len(lines) at the end).
fn (ed Editor) nextVisible(row i64) i64 {
	mut r = row + 1
	let i = ed.foldAt(row)
	if i >= 0 {
		r = ed.Folds[i].End + 1
	}
	for {
		let h = ed.hiddenBy(r)
		if h < 0 {
			break
		}
		r = ed.Folds[h].End + 1
	}
	return r
}

// prevVisible is the line shown before row (-1 at the start).
fn (ed Editor) prevVisible(row i64) i64 {
	mut r = row - 1
	for r >= 0 {
		let h = ed.hiddenBy(r)
		if h < 0 {
			break
		}
		r = ed.Folds[h].Start
	}
	return r
}

// dispRow is how many shown lines lie between the first line in view and row: its place on the screen (negative above the view,
// and capped a little past the bottom).
fn (ed Editor) dispRow(row i64) i64 {
	if row < ed.Scroll {
		return -1
	}
	if len(ed.Folds) == 0 {
		return row - ed.Scroll
	}
	mut n = 0
	mut r = ed.Scroll
	let cap = ed.rows() + 2
	for r < row && n < cap {
		r = ed.nextVisible(r)
		n += 1
	}
	return n
}

// shownAfter is the line n shown lines below row (clamped to the last line).
fn (ed Editor) shownAfter(row i64, n i64) i64 {
	mut r = row
	mut k = 0
	for k < n {
		let next = ed.nextVisible(r)
		if next >= len(ed.Buf.Lines) {
			break
		}
		r = next
		k += 1
	}
	return r
}

// shownBefore is the line n shown lines above row (clamped to the first line).
fn (ed Editor) shownBefore(row i64, n i64) i64 {
	mut r = row
	mut k = 0
	for k < n {
		let prev = ed.prevVisible(r)
		if prev < 0 {
			break
		}
		r = prev
		k += 1
	}
	return r
}

// syncFolds drops the folds when the text's line count changed under them, and opens the one that hides the caret.
fn (ed mut Editor) syncFolds() {
	if len(ed.Folds) == 0 {
		return
	}
	if ed.FoldLines != len(ed.Buf.Lines) {
		ed.Folds = ed.Folds[0:0]
		return
	}
	let h = ed.hiddenBy(ed.Buf.Row)
	if h >= 0 {
		ed.removeFold(h)
	}
}

// removeFold takes fold i out in place (it is called while a frame is painted, which must not allocate for the editor).
fn (ed mut Editor) removeFold(i i64) {
	mut k = i
	for k + 1 < len(ed.Folds) {
		ed.Folds[k] = ed.Folds[k + 1]
		k += 1
	}
	ed.Folds = ed.Folds[0:len(ed.Folds) - 1]
}

// ToggleFold folds the block that starts at row, or opens the fold there.
fn (ed mut Editor) ToggleFold(row i64) {
	if row < 0 || row >= len(ed.Buf.Lines) {
		return
	}
	let i = ed.foldAt(row)
	if i >= 0 {
		ed.removeFold(i)
		ed.Redraw = true
		return
	}
	let end = ed.blockEnd(row)
	if end <= row {
		return
	}
	if len(ed.Folds) == 0 {
		ed.FoldLines = len(ed.Buf.Lines)
	}
	ed.Folds = append(ed.Folds, fold{Start: row, End: end})
	// a fold inside the new one is swallowed by it
	mut kept = []fold{}
	for f in ed.Folds {
		if f.Start == row || f.Start < row || f.Start > end {
			kept = append(kept, f)
		}
	}
	ed.Folds = kept
	if ed.Buf.Row > row && ed.Buf.Row <= end {
		ed.Buf.MoveTo(row, len(ed.Buf.Lines[row]), false)
	}
	ed.Redraw = true
}

// FoldCaret folds the block the caret is in: the innermost one that starts at or above the caret's line and reaches it.
fn (ed mut Editor) FoldCaret() {
	mut r = ed.Buf.Row
	for r >= 0 {
		if ed.foldAt(r) < 0 && ed.blockEnd(r) >= ed.Buf.Row && ed.blockEnd(r) > r {
			ed.ToggleFold(r)
			return
		}
		r -= 1
	}
}

// UnfoldCaret opens the fold on the caret's line, or the one that holds it.
fn (ed mut Editor) UnfoldCaret() {
	let i = ed.foldAt(ed.Buf.Row)
	if i >= 0 {
		ed.removeFold(i)
		ed.Redraw = true
		return
	}
	let h = ed.hiddenBy(ed.Buf.Row)
	if h >= 0 {
		ed.removeFold(h)
		ed.Redraw = true
	}
}

// UnfoldAll opens every fold.
fn (ed mut Editor) UnfoldAll() {
	ed.Folds = ed.Folds[0:0]
	ed.Redraw = true
}

// foldable says whether the block at row can be folded (the gutter shows an arrow there).
fn (ed Editor) foldable(row i64) bool {
	if ed.foldAt(row) >= 0 {
		return true
	}
	if row + 1 >= len(ed.Buf.Lines) {
		return false
	}
	let d = indentOf(ed.Buf.Lines[row])
	if d < 0 {
		return false
	}
	// the next line that is not blank is deeper
	mut r = row + 1
	for r < len(ed.Buf.Lines) {
		let n = indentOf(ed.Buf.Lines[r])
		if n >= 0 {
			return n > d
		}
		r += 1
	}
	return false
}

fn foldCols(line str) i64 {
	return textedit.DisplayCol(line, len(line), 4)
}

// moveVertical moves the caret one line up (-1) or down (1), over the lines a fold hides.
fn (ed mut Editor) moveVertical(dir i64, shift bool) {
	if len(ed.Folds) > 0 {
		mut target = ed.nextVisible(ed.Buf.Row)
		if dir < 0 {
			target = ed.prevVisible(ed.Buf.Row)
		}
		if target >= 0 && target < len(ed.Buf.Lines) {
			let col = textedit.DisplayCol(ed.Buf.Lines[ed.Buf.Row], ed.Buf.Col, 4)
			ed.Buf.MoveTo(target, textedit.ColForDisplay(ed.Buf.Lines[target], col, 4), shift)
			return
		}
	}
	if dir < 0 {
		ed.Buf.Up(shift)
	} else {
		ed.Buf.Down(shift)
	}
}
