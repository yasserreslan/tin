package editor

import "appkit"
import "mint"
import "quarry"
import "textedit"
import "tinfmt"
import "tinsym"
import "twine"

// Modifier flags of a key event (NSEventModifierFlag).
const flagShift = 1 << 17
const flagCtrl = 1 << 18
const flagAlt = 1 << 19
const flagCmd = 1 << 20

// What the keys mean right now: editing, typing a search, typing a line number.
const modeEdit = 0
const modeFind = 1
const modeGoto = 2
const modeReplace = 3

// Hardware key codes (the ANSI layout; the editor reads text from the event, codes only for keys that type none).
const keyReturn = 36
const keyEnter = 76
const keyTab = 48
const keyBackspace = 51
const keyEscape = 53
const keyLeft = 123
const keyRight = 124
const keyDown = 125
const keyUp = 126
const keyForwardDelete = 117
const keyHome = 115
const keyEnd = 119
const keyPageUp = 116
const keyPageDown = 121
const keyF8 = 100

// Key is one key press: the hardware code, the modifier flags and the text it types.
type Key struct {
	Code  i64
	Flags i64
	Chars str
}

// Tab is one open file: its text and where its view is scrolled (the active tab's live copy is the editor's).
type Tab struct {
	Buf     textedit.Buffer
	Scroll  i64
	HScroll i64
	// Mtime is when the file was last changed on disk, as of the last time it was read or written here (0 until first seen).
	Mtime   i64
}

// Editor is the application state: the text, where the view is scrolled, the mode, and the pixels.
type Editor struct {
	Buf      textedit.Buffer
	Tabs     []Tab
	Active   i64
	// AreaW and AreaH are the size in points of the text area (gutter and text), and CharW and LineH the size of one
	// character cell: the view sets them before each frame so scrolling and paging know what fits.
	AreaW    f64
	AreaH    f64
	CharW    f64
	LineH    f64
	Scroll   i64
	HScroll  i64
	Mode     i64
	Prompt   str
	Message  str
	FindFrom textedit.Pos
	Needle   str
	Replacement str
	fresh    bool
	Clip     str
	Output   []str
	Diags    []tinsym.Diag
	Syms     []tinsym.Sym
	Back     []Place
	Info     []str
	CompOpen bool
	Comp     []tinsym.Item
	CompSel  i64
	DiagFor  i64
	TmpDir   str
	OutputOpen bool
	Redraw   bool
	Blink    bool
	Quit     bool
	Headless bool
	Title    str
	rawRows  []i64
	rawLang  i64
	rawFor   i64
	acc      f64
	accX     f64
	// Follow asks the next frame to scroll the caret into view (after typing or moving it, not after a wheel).
	Follow   bool
	// Marks are the lines git says differ from the last commit (line * 4 + 1 added, 2 changed, 3 lines removed above), for the file named
	// MarksPath as it was when MarksSaves saves had happened; Saves counts the saves.
	Marks    []i64
	// Extra are the carets besides the buffer's own (multi.tin).
	Extra    []textedit.Pos
	// External are completion items someone else (a language server) supplied for the list that is open; ExternalDiags says the
	// diagnostics come from elsewhere too, so CheckNow leaves them alone for files that are not Tin.
	External []tinsym.Item
	ExternalDiags bool
	MarksPath str
	MarksSaves i64
	Saves    i64
	dragging bool
	// Folds are the folded blocks (fold.tin); FoldLines is the line count they were made for.
	Folds    []fold
	// ScrollSeg is the row of line Scroll at the top of the view when lines are wrapped (wrap.tin).
	ScrollSeg i64
	FoldLines i64
	// mapDrag is true while the mouse drags in the minimap.
	mapDrag bool
	gutterDrag bool
	gutterAnchor i64
	clicks   i64
	lastClick f64
	// SaveTrim and SaveFinalNl are the write hygiene of the settings: the trailing spaces and tabs are
	// removed from every line before the file is written, and a final newline is added when the last
	// line is not empty. Both are off by default.
	SaveTrim   bool
	SaveFinalNl bool
}

fn New(buf textedit.Buffer) Editor {
	let ed = Editor{Buf: buf, FindFrom: textedit.Pos{}, Marks: []i64{}, Folds: []fold{}, Extra: []textedit.Pos{}, External: []tinsym.Item{}, AreaW: 800.0, AreaH: 500.0, CharW: 7.8, LineH: 17.0, Redraw: true, Blink: true}
	ed.rawFor = -1
	ed.Diags = []tinsym.Diag{}
	ed.DiagFor = -1
	ed.Tabs = []Tab{Tab{Buf: buf}}
	ed.Diags = []tinsym.Diag{}
	ed.DiagFor = -1
	return ed
}

// name is the file's name for the title and the status line.
fn (ed Editor) Name() str {
	if len(ed.Buf.Path) == 0 {
		return "untitled"
	}
	let parts = twine.Split(ed.Buf.Path, "/")
	return parts[len(parts) - 1]
}

// Say shows a message in the status bar.
fn (ed mut Editor) Say(text str) {
	ed.Message = text
	ed.Redraw = true
}

// stash keeps the live view state in the active tab.
fn (ed mut Editor) stash() {
	if ed.Active < 0 {
		return
	}
	let t = ed.Tabs[ed.Active]
	t.Buf = ed.Buf
	t.Scroll = ed.Scroll
	t.HScroll = ed.HScroll
}

// activate makes tab i the one shown.
fn (ed mut Editor) activate(i i64) {
	if i < 0 || i >= len(ed.Tabs) {
		return
	}
	ed.stash()
	ed.Active = i
	ed.Buf = ed.Tabs[i].Buf
	ed.Scroll = ed.Tabs[i].Scroll
	ed.HScroll = ed.Tabs[i].HScroll
	ed.rawFor = -1
	ed.ScrollSeg = 0
	ed.Folds = []fold{}
	ed.Diags = []tinsym.Diag{}
	ed.DiagFor = -1
	ed.Mode = modeEdit
	ed.Follow = true
	ed.Redraw = true
}

// newTab opens a tab holding buf and shows it.
fn (ed mut Editor) newTab(buf textedit.Buffer) {
	ed.stash()
	ed.Tabs = append(ed.Tabs, Tab{Buf: buf})
	ed.activate(len(ed.Tabs) - 1)
}

// tabName is the name shown for tab i.
fn (ed Editor) tabName(i i64) str {
	let b = ed.Tabs[i].Buf
	if i == ed.Active {
		return nameOf(ed.Buf)
	}
	return nameOf(b)
}

// TabName is the name shown for tab i, and TabDirty whether it has unsaved changes.
fn (ed Editor) TabName(i i64) str {
	return ed.tabName(i)
}

fn (ed Editor) TabDirty(i i64) bool {
	if i == ed.Active {
		return ed.Buf.Dirty
	}
	return ed.Tabs[i].Buf.Dirty
}

// Activate shows tab i.
fn (ed mut Editor) Activate(i i64) {
	ed.activate(i)
}

// CloseTab closes tab i (asking about unsaved changes).
fn (ed mut Editor) CloseTab(i i64) {
	ed.activate(i)
	ed.closeTab()
}

fn nameOf(b textedit.Buffer) str {
	if len(b.Path) == 0 {
		return "untitled"
	}
	let parts = twine.Split(b.Path, "/")
	return parts[len(parts) - 1]
}

// load opens the file at path in a tab (switching to the tab that already has it, and reusing an untouched
// empty tab).
fn (ed mut Editor) Load(path str) bool {
	ed.stash()
	mut i = 0
	for i < len(ed.Tabs) {
		if ed.Tabs[i].Buf.Path == path {
			ed.activate(i)
			ed.Say("switched to " + path)
			return true
		}
		i += 1
	}
	let size = quarry.Size(path) catch _ {
		0
	}
	if size > 20000000 {
		ed.Say("too large to open: " + path)
		return false
	}
	let text = quarry.ReadFile(path) catch _ {
		ed.Say("cannot read " + path)
		return false
	}
	// a zero byte in the first few kilobytes means the file is not text
	mut probe = len(text)
	if probe > 8192 {
		probe = 8192
	}
	for i in 0..probe {
		if text[i] == 0 {
			ed.Say("binary file, not opened: " + path)
			return false
		}
	}
	let buf = textedit.FromText(text)
	buf.Path = path
	let cur = ed.Buf
	if len(ed.Tabs) == 1 && len(cur.Path) == 0 && !cur.Dirty && len(cur.Lines) == 1 && len(cur.Lines[0]) == 0 {
		ed.Tabs[0].Buf = buf
		ed.Active = -1
		ed.activate(0)
		ed.Active = 0
	} else {
		ed.newTab(buf)
	}
	ed.Say("opened " + path)
	return true
}

// closeOthers closes every tab but the active one, asking about unsaved changes in each.
fn (ed mut Editor) closeOthers() {
	if len(ed.Tabs) <= 1 {
		return
	}
	let at = ed.Active
	mut kept = []Tab{}
	mut j = 0
	for j < len(ed.Tabs) {
		if j == at {
			kept = append(kept, ed.Tabs[j])
			j += 1
			continue
		}
		// a tab with changes asks first, and a Cancel stops the whole thing
		ed.Active = -1
		ed.activate(j)
		ed.Active = j
		if !ed.confirm() {
			ed.Active = at
			ed.stash()
			return
		}
		j += 1
	}
	ed.Tabs = kept
	ed.Active = -1
	ed.activate(0)
	ed.Active = 0
	ed.rawFor = -1
	ed.Diags = []tinsym.Diag{}
	ed.DiagFor = -1
	ed.Say("closed the other tabs")
	ed.Redraw = true
}

// closeAll closes every tab, asking about unsaved changes in each, and leaves one empty tab behind.
fn (ed mut Editor) closeAll() {
	mut j = 0
	for j < len(ed.Tabs) {
		ed.Active = -1
		ed.activate(j)
		ed.Active = j
		if !ed.confirm() {
			ed.Say("close all stopped")
			return
		}
		j += 1
	}
	ed.Tabs = []Tab{Tab{Buf: textedit.New()}}
	ed.Active = -1
	ed.activate(0)
	ed.Active = 0
	ed.rawFor = -1
	ed.Diags = []tinsym.Diag{}
	ed.DiagFor = -1
	ed.Say("closed every tab")
	ed.Redraw = true
}

// closeTab closes the active tab (asking about unsaved changes); closing the last one leaves an empty tab.
fn (ed mut Editor) closeTab() {
	if !ed.confirm() {
		return
	}
	if len(ed.Tabs) == 1 {
		// the last tab closes into an empty one
		ed.Tabs = []Tab{Tab{Buf: textedit.New()}}
		ed.Active = -1
		ed.activate(0)
		return
	}
	let at = ed.Active
	mut rest = []Tab{}
	mut j = 0
	for j < len(ed.Tabs) {
		if j != at {
			rest = append(rest, ed.Tabs[j])
		}
		j += 1
	}
	ed.Tabs = rest
	mut next = at
	if next >= len(ed.Tabs) {
		next = len(ed.Tabs) - 1
	}
	ed.Active = -1
	ed.Buf = ed.Tabs[next].Buf
	ed.Scroll = ed.Tabs[next].Scroll
	ed.HScroll = ed.Tabs[next].HScroll
	ed.Active = next
	ed.rawFor = -1
	ed.Diags = []tinsym.Diag{}
	ed.DiagFor = -1
	ed.Redraw = true
}

// writeText is what the settings say a file's text is: the trailing spaces and tabs of every line removed
// and a final newline added when both are on (they are off by default).
fn (ed Editor) writeText(text str) str {
	mut out = text
	if ed.SaveTrim {
		mut lines = []str{}
		for line in twine.Split(out, "\r\n") {
			lines = append(lines, twine.TrimRight(line, " \t"))
		}
		mut sep = "\n"
		if ed.Buf.CRLF {
			sep = "\r\n"
		}
		out = twine.Join(lines, sep)
	}
	if ed.SaveFinalNl && !twine.HasSuffix(out, "\n") {
		out += "\n"
	}
	return out
}

// save writes the text to its file (asking for one when it has none).
fn (ed mut Editor) save(asNew bool) bool {
	mut path = ed.Buf.Path
	if len(path) == 0 || asNew {
		if ed.Headless {
			ed.Say("no file name")
			return false
		}
		path = appkit.SavePanel(ed.Name())
		if len(path) == 0 {
			return false
		}
	}
	quarry.WriteFile(path, ed.writeText(ed.Buf.FileText())) catch _ {
		ed.Say("cannot write " + path)
		return false
	}
	ed.Buf.Path = path
	ed.Buf.Dirty = false
	ed.Saves += 1
	ed.stash()
	if ed.Active >= 0 {
		ed.Tabs[ed.Active].Mtime = quarry.ModTime(path) catch _ {
			0
		}
	}
	ed.Say("saved " + path)
	return true
}

// SaveDirty writes every open file that has unsaved changes (auto-save: the app calls it when the window has been quiet for a moment).
// Tabs without a file name are left alone. It reports how many files it wrote.
fn (ed mut Editor) SaveDirty() i64 {
	ed.stash()
	mut written = 0
	for i in 0..len(ed.Tabs) {
		let path = ed.Tabs[i].Buf.Path
		if len(path) == 0 || !ed.Tabs[i].Buf.Dirty {
			continue
		}
		quarry.WriteFile(path, ed.writeText(ed.Tabs[i].Buf.FileText())) catch _ {
			continue
		}
		ed.Tabs[i].Buf.Dirty = false
		ed.Tabs[i].Mtime = quarry.ModTime(path) catch _ {
			0
		}
		written += 1
	}
	if written > 0 {
		ed.Saves += written
		if ed.Active >= 0 {
			ed.Buf.Dirty = ed.Tabs[ed.Active].Buf.Dirty
		}
		ed.Redraw = true
	}
	return written
}

// rows is how many text lines fit in the text area.
fn (ed Editor) rows() i64 {
	let n = i64(ed.AreaH / ed.LineH)
	if n < 1 {
		return 1
	}
	return n
}

// cols is how many columns of text fit beside the line numbers.
fn (ed Editor) cols() i64 {
	let n = i64((ed.AreaW - ed.gutterW() - ed.CharW - ed.mapW()) / ed.CharW)
	if n < 1 {
		return 1
	}
	return n
}

// minimapWidth is the width in points of the minimap, and minimapRow the height of one line in it.
const minimapWidth = 84.0
const minimapRow = 2.0

// mapW is the width the minimap takes at the right of the text: none in a narrow editor.
fn (ed Editor) mapW() f64 {
	if ed.AreaW < 640.0 {
		return 0.0
	}
	return minimapWidth
}

// mapStart is the first line the minimap shows: all of a short file, and for a longer one the part that keeps the window's place
// in the file.
fn (ed Editor) mapStart() i64 {
	let total = len(ed.Buf.Lines)
	let cap = i64(ed.AreaH / minimapRow)
	let rows = ed.rows()
	if total <= cap || total <= rows {
		return 0
	}
	return i64(f64(total - cap) * f64(ed.Scroll) / f64(total - rows))
}

// gutterW is the width in points of the line numbers.
fn (ed Editor) gutterW() f64 {
	mut digits = 1
	mut n = len(ed.Buf.Lines)
	for n >= 10 {
		n = n / 10
		digits += 1
	}
	return f64(digits + 3) * ed.CharW
}

// ensureVisible scrolls so the cursor is on screen.
fn (ed mut Editor) ensureVisible() {
	let rows = ed.rows()
	let dc = textedit.DisplayCol(ed.Buf.Lines[ed.Buf.Row], ed.Buf.Col, 4)
	if wrapOn {
		ed.HScroll = 0
		if ed.ScrollSeg >= ed.segCount(ed.Scroll) {
			ed.ScrollSeg = 0
		}
		let (cr, cs) = ed.rowAtCaret(dc)
		if cr < ed.Scroll || (cr == ed.Scroll && cs < ed.ScrollSeg) {
			ed.Scroll = cr
			ed.ScrollSeg = cs
		}
		let d = ed.visRow(cr, dc)
		if d >= rows {
			ed.scrollRows(d - rows + 1)
		}
		let most = len(ed.Buf.Lines) - 1
		if ed.Scroll > most {
			ed.Scroll = most
		}
		if ed.Scroll < 0 {
			ed.Scroll = 0
		}
		return
	}
	if ed.Buf.Row < ed.Scroll {
		ed.Scroll = ed.Buf.Row
	}
	let d = ed.dispRow(ed.Buf.Row)
	if d >= rows {
		ed.Scroll = ed.shownAfter(ed.Scroll, d - rows + 1)
	}
	let maxScroll = len(ed.Buf.Lines) - 1
	if ed.Scroll > maxScroll {
		ed.Scroll = maxScroll
	}
	if ed.Scroll < 0 {
		ed.Scroll = 0
	}
	let cols = ed.cols()
	if dc < ed.HScroll {
		ed.HScroll = dc
	}
	if dc >= ed.HScroll + cols - 1 {
		ed.HScroll = dc - cols + 2
	}
	if ed.HScroll < 0 {
		ed.HScroll = 0
	}
}

// typeable reports whether a key's text is something to insert: not a control character, and not one of the
// private-use characters AppKit reports for the arrow, function and other keys that type nothing.
fn typeable(chars str) bool {
	if len(chars) == 0 {
		return false
	}
	let c = i64(chars[0])
	if c < 0x20 || c == 0x7f {
		return false
	}
	if c == 0xef && len(chars) > 1 {
		let d = i64(chars[1])
		if d >= 0x9c && d <= 0xa3 {
			return false
		}
	}
	return true
}

// handleKey acts on one key press.
fn (ed mut Editor) handleKey(k Key) {
	ed.Follow = true
	ed.Blink = true
	ed.Redraw = true
	ed.Message = ""
	ed.Info = []str{}
	if ed.CompOpen && ed.Mode == modeEdit && ed.completionKey(k) {
		return
	}
	if ed.Mode != modeEdit {
		ed.promptKey(k)
		ed.ensureVisible()
		return
	}
	if len(ed.Extra) > 0 && ed.multiKey(k) {
		return
	}
	if k.Code == keyF8 {
		// F8 goes to the next problem, Shift+F8 to the previous one
		ed.NextProblem((k.Flags & flagShift) == 0)
		ed.ensureVisible()
		return
	}
	let shift = (k.Flags & flagShift) != 0
	let alt = (k.Flags & flagAlt) != 0
	let cmd = (k.Flags & flagCmd) != 0
	let ctrl = (k.Flags & flagCtrl) != 0
	if cmd {
		ed.CompOpen = false
		ed.command(k, shift)
		ed.ensureVisible()
		return
	}
	if ctrl && k.Code == 49 {
		// Ctrl+Space: complete
		ed.openCompletion()
		return
	}
	let b = ed.Buf
	if k.Code == keyLeft {
		if alt {
			b.WordLeft(shift)
		} else {
			b.Left(shift)
		}
	} else if k.Code == keyRight {
		if alt {
			b.WordRight(shift)
		} else {
			b.Right(shift)
		}
	} else if k.Code == keyUp {
		if alt {
			b.MoveLines(-1)
		} else {
			ed.moveVertical(-1, shift)
		}
	} else if k.Code == keyDown {
		if alt {
			b.MoveLines(1)
		} else {
			ed.moveVertical(1, shift)
		}
	} else if k.Code == keyHome {
		b.Home(shift)
	} else if k.Code == keyEnd {
		b.End(shift)
	} else if k.Code == keyPageUp {
		b.PageUp(ed.rows() - 1, shift)
	} else if k.Code == keyPageDown {
		b.PageDown(ed.rows() - 1, shift)
	} else if k.Code == keyReturn || k.Code == keyEnter {
		b.Newline()
	} else if k.Code == keyBackspace {
		if alt && !b.HasSel {
			b.WordLeft(true)
		}
		if !b.HasSel && ed.insidePair() {
			b.Delete()
		}
		b.Backspace()
	} else if k.Code == keyForwardDelete {
		if alt && !b.HasSel {
			// Alt+Delete removes the word after the caret, and the line break when there is no word left
			b.WordRight(true)
			if !b.HasSel {
				b.Delete()
			} else {
				b.Backspace()
			}
		} else {
			b.Delete()
		}
	} else if k.Code == keyTab && ctrl {
		mut next = ed.Active + 1
		if shift {
			next = ed.Active - 1
		}
		if next < 0 {
			next = len(ed.Tabs) - 1
		}
		if next >= len(ed.Tabs) {
			next = 0
		}
		ed.activate(next)
	} else if k.Code == keyTab {
		if shift {
			b.Unindent()
		} else if b.HasSel && b.SelStart().Row != b.SelEnd().Row {
			b.Indent()
		} else {
			b.Insert("\t")
		}
	} else if k.Code == keyEscape {
		b.HasSel = false
		ed.OutputOpen = false
	} else if ctrl {
		ed.controlKey(k)
	} else if typeable(k.Chars) {
		if !ed.autoPair(k.Chars) {
			b.Insert(k.Chars)
		}
		if k.Chars == "." && len(ed.Syms) > 0 {
			ed.openCompletion()
		}
	}
	if ed.CompOpen {
		ed.refilter()
	}
	ed.ensureVisible()
}

// controlKey handles the Emacs-style line editing keys of a Mac text field.
fn (ed mut Editor) controlKey(k Key) {
	let b = ed.Buf
	if len(k.Chars) == 0 {
		return
	}
	let c = k.Chars[0]
	if c == 'a' || c == 1 {
		b.Home(false)
	} else if c == 'e' || c == 5 {
		b.End(false)
	} else if c == 'l' || c == 12 {
		// Ctrl+L selects the caret's line (its newline with it when it is not the last)
		b.SelectLine(b.Row)
		ed.Follow = true
		ed.Redraw = true
	} else if c == 'q' || c == 17 {
		ed.quickInfo()
	} else if c == 'k' || c == 11 {
		// kill to the end of the line (at the end of a line, the line break)
		b.MoveTo(b.Row, len(b.Lines[b.Row]), true)
		if len(b.SelectedText()) == 0 {
			b.Delete()
		} else {
			b.Backspace()
		}
	}
}

// command handles a key pressed with the command key.
fn (ed mut Editor) command(k Key, shift bool) {
	let b = ed.Buf
	mut c = u8(0)
	if len(k.Chars) > 0 {
		c = k.Chars[0]
	}
	if k.Code == keyLeft && (k.Flags & flagAlt) != 0 {
		ed.goBack()
	} else if c == 'b' {
		ed.gotoDefinition()
	} else if k.Code == keyBackspace {
		// delete to the start of the line
		if !b.HasSel {
			b.Home(true)
			if !b.HasSel {
				b.Left(true)
			}
		}
		b.Backspace()
	} else if k.Code == keyLeft {
		b.Home(shift)
	} else if k.Code == keyRight {
		b.End(shift)
	} else if k.Code == keyUp {
		b.DocStart(shift)
	} else if k.Code == keyDown {
		b.DocEnd(shift)
	} else if c == 'q' {
		ed.quit()
	} else if c == 'w' {
		ed.closeTab()
	} else if c >= '1' && c <= '9' {
		ed.activate(i64(c) - 49)
	} else if c == 's' {
		ed.save(shift)
	} else if c == 'o' {
		ed.openFile()
	} else if c == 'n' {
		ed.newTab(textedit.New())
	} else if c == 'z' {
		if shift {
			b.Redo()
		} else {
			b.Undo()
		}
	} else if c == 'x' {
		ed.copy(true)
	} else if c == 'c' {
		ed.copy(false)
	} else if c == 'v' {
		let text = ed.clipboard()
		if len(text) > 0 {
			b.Insert(text)
		}
	} else if c == 'a' {
		b.SelectAll()
	} else if c == 'f' {
		ed.Mode = modeFind
		ed.Prompt = ed.Needle
		ed.fresh = true
		ed.FindFrom = b.SelStart()
	} else if c == 'g' {
		if len(ed.Needle) > 0 && !b.Find(ed.Needle, !shift) {
			ed.Say("not found: " + ed.Needle)
		}
	} else if c == 'l' && shift {
		// Cmd+Shift+L selects every occurrence of the selected text
		ed.SelectNext()
	} else if c == 'l' {
		ed.Mode = modeGoto
		ed.Prompt = ""
	} else if c == 'i' && shift {
		ed.formatDoc()
	} else if c == 'r' {
		ed.runFile()
	} else if c == '/' {
		b.ToggleComment()
	} else if c == 'd' {
		b.DuplicateLine()
	} else if c == 'k' && shift {
		b.DeleteLine()
	} else if c == ']' {
		b.Indent()
	} else if c == '[' {
		b.Unindent()
	} else if shift && (c == '\\' || k.Code == 42) {
		ed.JumpBracket()
	}
}

// clipboard and copy go through the system pasteboard (the Clip field stands in when there is no window).
fn (ed Editor) clipboard() str {
	if ed.Headless {
		return ed.Clip
	}
	return appkit.ClipboardText()
}

fn (ed mut Editor) copy(cut bool) {
	let b = ed.Buf
	mut text = b.SelectedText()
	if len(text) == 0 {
		text = b.Lines[b.Row] + "\n"
		if cut {
			b.DeleteLine()
		}
	} else if cut {
		b.Backspace()
	}
	if ed.Headless {
		ed.Clip = text
	} else {
		appkit.SetClipboard(text)
	}
}

// openFile asks for a file and loads it.
fn (ed mut Editor) openFile() {
	if ed.Headless {
		return
	}
	let path = appkit.OpenPanel()
	if len(path) > 0 {
		ed.Load(path)
	}
}

// confirm asks what to do with unsaved changes in the active tab before it goes away; it reports whether to go on.
fn (ed mut Editor) confirm() bool {
	if !ed.Buf.Dirty || ed.Headless {
		return true
	}
	let answer = appkit.Alert("Save changes to " + ed.Name() + "?", "Your changes will be lost if you don't save them.", []str{"Save", "Don't Save", "Cancel"})
	if answer == 2 {
		return false
	}
	return answer != 0 || ed.save(false)
}

// quit leaves the editor, asking first about every tab with unsaved changes.
fn (ed mut Editor) quit() {
	ed.stash()
	let start = ed.Active
	mut i = 0
	for i < len(ed.Tabs) {
		if ed.Tabs[i].Buf.Dirty {
			ed.activate(i)
			if !ed.confirm() {
				return
			}
		}
		i += 1
	}
	ed.Quit = true
}

// promptKey handles keys while a find or go-to-line prompt is open.
fn (ed mut Editor) promptKey(k Key) {
	let b = ed.Buf
	let shift = (k.Flags & flagShift) != 0
	if k.Code == keyEscape {
		ed.Mode = modeEdit
		return
	}
	if k.Code == keyTab && ed.Mode == modeFind {
		// Tab moves from the search text to the replacement text
		ed.Needle = ed.Prompt
		ed.Prompt = ed.Replacement
		ed.fresh = true
		ed.Mode = modeReplace
		return
	}
	if k.Code == keyTab && ed.Mode == modeReplace {
		ed.Replacement = ed.Prompt
		ed.Prompt = ed.Needle
		ed.fresh = true
		ed.Mode = modeFind
		return
	}
	if (k.Code == keyReturn || k.Code == keyEnter) && ed.Mode == modeReplace {
		ed.Replacement = ed.Prompt
		if (k.Flags & flagCmd) != 0 {
			let n = b.ReplaceAll(ed.Needle, ed.Prompt)
			ed.Say("replaced " + mint.Itoa(n))
			ed.Mode = modeEdit
			return
		}
		// replace the match the cursor is on (finding it first when it is not selected), then go to the next
		if !b.HasSel || b.SelectedText() != ed.Needle {
			b.Find(ed.Needle, true)
		}
		if b.HasSel && b.SelectedText() == ed.Needle {
			b.ReplaceSelection(ed.Prompt)
			if !b.Find(ed.Needle, true) {
				ed.Say("no more matches")
			}
		} else {
			ed.Say("not found: " + ed.Needle)
		}
		return
	}
	if k.Code == keyReturn || k.Code == keyEnter {
		if ed.Mode == modeGoto {
			let n = parseInt(ed.Prompt)
			if n > 0 {
				b.MoveTo(n - 1, 0, false)
			}
			ed.Mode = modeEdit
			return
		}
		ed.Needle = ed.Prompt
		if len(ed.Needle) > 0 && !b.Find(ed.Needle, !shift) {
			ed.Say("not found: " + ed.Needle)
		}
		return
	}
	if k.Code == keyBackspace {
		if ed.fresh {
			ed.Prompt = ""
		} else if len(ed.Prompt) > 0 {
			ed.Prompt = ed.Prompt[:len(ed.Prompt) - 1]
		}
		ed.fresh = false
	} else if (k.Flags & flagCmd) != 0 {
		if len(k.Chars) > 0 && k.Chars[0] == 'g' && len(ed.Needle) > 0 {
			b.Find(ed.Needle, !shift)
		} else if len(k.Chars) > 0 && k.Chars[0] == 'f' {
			ed.Mode = modeFind
			ed.Prompt = ed.Needle
			ed.fresh = true
		}
		return
	} else if typeable(k.Chars) {
		if ed.fresh {
			ed.Prompt = ""
			ed.fresh = false
		}
		ed.Prompt = ed.Prompt + k.Chars
	} else {
		return
	}
	if ed.Mode == modeFind {
		// search again from where the search began, as the text is typed
		b.MoveTo(ed.FindFrom.Row, ed.FindFrom.Col, false)
		ed.Needle = ed.Prompt
		if len(ed.Prompt) > 0 {
			b.Find(ed.Prompt, true)
		}
	}
}

// parseInt is the number in s (0 when it is not one).
fn parseInt(s str) i64 {
	mut n = 0
	mut i = 0
	for i < len(s) {
		if s[i] < '0' || s[i] > '9' {
			return 0
		}
		n = n * 10 + (i64(s[i]) - 48)
		i += 1
	}
	return n
}

// formatDoc formats the active file with tin fmt's rules (a .tin file; the text is one undo step).
fn (ed mut Editor) formatDoc() {
	if !twine.HasSuffix(ed.Buf.Path, ".tin") {
		ed.Say("Format Document works on a .tin file")
		return
	}
	let text = ed.Buf.Text()
	let fresh = tinfmt.Format(text)
	if fresh == text {
		ed.Say("already formatted")
		return
	}
	ed.Buf.SetText(fresh)
	ed.Say("formatted")
}

// tmp is a file name inside this editor's private temporary directory (made on first use), or "" when there is none:
// nothing is written to a fixed name in a shared directory.
fn (ed mut Editor) tmp(name str) str {
	if len(ed.TmpDir) == 0 {
		ed.TmpDir = appkit.PrivateDir("tinland")
	}
	if len(ed.TmpDir) == 0 {
		return ""
	}
	return ed.TmpDir + "/" + name
}

// cleanup removes the private temporary directory.
fn (ed Editor) Cleanup() {
	if len(ed.TmpDir) > 0 {
		quarry.RemoveAll(ed.TmpDir) catch _ {
		}
	}
}

// StatusLine is what the status bar says on the left: the find, replace or go-to-line prompt while one is open, otherwise the last
// message (empty when there is none).
fn (ed Editor) StatusLine() str {
	if ed.Mode == modeReplace {
		return "Return replaces, Cmd+Return replaces all, Tab switches to the search text"
	}
	if ed.Mode == modeFind {
		return "Return finds the next, Shift+Cmd+G the previous, Escape closes"
	}
	if ed.Mode == modeGoto {
		return "Type a line number and press Return"
	}
	return ed.Message
}

// NextProblem puts the caret at the next problem the compiler found (the first one when forward is
// false, wrapping around the end), and reports whether there was one.
fn (ed mut Editor) NextProblem(forward bool) bool {
	if len(ed.Diags) == 0 {
		ed.Say("no problems")
		return false
	}
	// the diagnostics arrive in the order the compiler prints them, which is by line
	let at = ed.Buf.Row
	mut best = -1
	for i in 0..len(ed.Diags) {
		let line = ed.Diags[i].Line - 1
		if forward {
			if line > at {
				best = i
				break
			}
		} else {
			if line < at {
				best = i
				break
			}
		}
	}
	if best < 0 {
		// wrap around: the first problem going forward, the last going back
		if forward {
			best = 0
		} else {
			for i in (0..len(ed.Diags)).step(1) {
				best = len(ed.Diags) - 1 - i
				if ed.Diags[best].Line - 1 <= at {
					break
				}
			}
			if ed.Diags[best].Line - 1 > at {
				best = len(ed.Diags) - 1
			}
		}
	}
	let d = ed.Diags[best]
	ed.Buf.MoveTo(max(d.Line - 1, 0), max(d.Col - 1, 0), false)
	ed.Follow = true
	ed.Redraw = true
	ed.Say(d.Message)
	return true
}

// Counts is what the status bar says about the whole text: the lines, the words and the characters.
// A word is a run of anything but spaces, tabs, newlines and carriage returns.
fn (ed Editor) Counts() str {
	let text = ed.Buf.Text()
	mut lines = 1
	mut words = 0
	mut inWord = false
	for i in 0..len(text) {
		let c = text[i]
		if c == '\n' {
			lines += 1
		}
		let space = c == ' ' || c == '\t' || c == '\n' || c == '\r'
		if space {
			inWord = false
		} else if !inWord {
			inWord = true
			words += 1
		}
	}
	return mint.Itoa(lines) + " lines, " + mint.Itoa(words) + " words, " + mint.Itoa(len(text)) + " chars"
}

// SelectionInfo is what the status bar adds to the cursor position while text is selected: the lines and
// characters it spans ("" without a selection).
fn (ed Editor) SelectionInfo() str {
	if !ed.Buf.HasSel {
		return ""
	}
	let text = ed.Buf.SelectedText()
	mut lines = 1
	for i in 0..len(text) {
		if text[i] == '\n' {
			lines += 1
		}
	}
	return " (" + mint.Itoa(lines) + " lines, " + mint.Itoa(len(text)) + " chars selected)"
}

// closerOf is the character that closes an opening one ("" for a character that opens nothing).
fn closerOf(ch str) str {
	if ch == "(" {
		return ")"
	}
	if ch == "[" {
		return "]"
	}
	if ch == "{{" {
		return "}}"
	}
	if ch == "\"" || ch == "'" || ch == "`" {
		return ch
	}
	return ""
}

// charAt is the character at byte col of the line as a string ("" past the end or in the middle of a character).
fn charAt(line str, col i64) str {
	if col < 0 || col >= len(line) {
		return ""
	}
	return line[col:col + 1]
}

// autoPair types a bracket or quote the way editors do: an opening one brings its closing one (with the caret between, and a
// selection wrapped), and a closing one typed in front of the same one steps over it. It reports whether it handled the key.
fn (ed mut Editor) autoPair(ch str) bool {
	let b = ed.Buf
	let line = b.Lines[b.Row]
	let next = charAt(line, b.Col)
	let prev = charAt(line, b.Col - 1)
	if !b.HasSel && next == ch && (ch == ")" || ch == "]" || ch == "}}" || ch == "\"" || ch == "'" || ch == "`") {
		b.Right(false)
		return true
	}
	let close = closerOf(ch)
	if len(close) == 0 {
		return false
	}
	if b.HasSel {
		let text = b.SelectedText()
		b.Insert(ch + text + close)
		return true
	}
	// a quote after a word character is an apostrophe or a closing quote, not a new pair
	if (ch == "\"" || ch == "'" || ch == "`") && len(prev) > 0 && wordByte(prev[0]) {
		return false
	}
	// only open a pair in front of nothing, a space or a closing character
	if len(next) > 0 && next != " " && next != "\t" && next != ")" && next != "]" && next != "}}" {
		return false
	}
	b.Insert(ch + close)
	b.Left(false)
	return true
}

// insidePair reports whether the caret sits between an opening character and its closing one ("()" with the caret in the middle).
fn (ed Editor) insidePair() bool {
	let b = ed.Buf
	let line = b.Lines[b.Row]
	let prev = charAt(line, b.Col - 1)
	let next = charAt(line, b.Col)
	return len(prev) > 0 && closerOf(prev) == next && len(next) > 0
}

// Empty reports whether the active tab is the untouched empty one a new editor starts with.
fn (ed Editor) Empty() bool {
	return len(ed.Tabs) == 1 && len(ed.Buf.Path) == 0 && !ed.Buf.Dirty && len(ed.Buf.Lines) == 1 && len(ed.Buf.Lines[0]) == 0
}

// ReloadClean reads again the files of the open tabs that have no unsaved changes (after something else changed them on disk),
// keeping the caret where it was as far as the new text allows.
fn (ed mut Editor) ReloadClean() {
	ed.stash()
	for i in 0..len(ed.Tabs) {
		let t = ed.Tabs[i]
		if len(t.Buf.Path) == 0 || t.Buf.Dirty {
			continue
		}
		let text = quarry.ReadFile(t.Buf.Path) catch _ {
			continue
		}
		if text == t.Buf.FileText() {
			continue
		}
		let row = t.Buf.Row
		let col = t.Buf.Col
		t.Buf.SetText(text)
		t.Buf.Dirty = false
		t.Buf.MoveTo(row, col, false)
		if i == ed.Active {
			ed.Buf = t.Buf
		}
	}
	ed.rawFor = -1
	ed.Redraw = true
}

// CheckDisk looks at the files of the open tabs for changes made by something else: a tab without unsaved changes is read
// again, one with them gets a message. It reports whether anything changed.
fn (ed mut Editor) CheckDisk() bool {
	ed.stash()
	mut changed = false
	for i in 0..len(ed.Tabs) {
		let t = ed.Tabs[i]
		if len(t.Buf.Path) == 0 {
			continue
		}
		let now = quarry.ModTime(t.Buf.Path) catch _ {
			continue
		}
		if t.Mtime == 0 {
			t.Mtime = now
			continue
		}
		if now == t.Mtime {
			continue
		}
		t.Mtime = now
		if t.Buf.Dirty {
			ed.Say(nameOf(t.Buf) + " changed on disk; saving overwrites it")
			changed = true
			continue
		}
		let text = quarry.ReadFile(t.Buf.Path) catch _ {
			continue
		}
		if text != t.Buf.FileText() {
			let row = t.Buf.Row
			let col = t.Buf.Col
			t.Buf.SetText(text)
			t.Buf.Dirty = false
			t.Buf.MoveTo(row, col, false)
			if i == ed.Active {
				ed.Buf = t.Buf
			}
			changed = true
		}
	}
	if changed {
		ed.rawFor = -1
		ed.Redraw = true
	}
	return changed
}

// JumpBracket moves the caret to the matching partner of the bracket beside it.
fn (ed mut Editor) JumpBracket() {
	let (mr, mc, found) = ed.matchBracket()
	if found {
		ed.Buf.MoveTo(mr, mc, false)
		ed.Follow = true
		ed.Redraw = true
	}
}

// Revert re-reads the active file from disk, discarding unsaved edits.
fn (ed mut Editor) Revert() {
	if len(ed.Buf.Path) == 0 {
		ed.Say("no file on disk")
		return
	}
	let text = quarry.ReadFile(ed.Buf.Path) catch _ {
		ed.Say("cannot read " + ed.Buf.Path)
		return
	}
	ed.Buf.SetText(text)
	ed.Buf.Dirty = false
	ed.Say("reverted " + ed.Name())
	ed.Redraw = true
}
