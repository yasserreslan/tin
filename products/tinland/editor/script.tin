package editor

import "appkit"
import "say"
import "textedit"
import "tide"
import "twine"

// keyFor turns "cmd+shift+z", "left" or "a" into a key press (the scripts that drive the editor without a
// window, so its behaviour can be tested and its pixels written to a PNG).
fn keyFor(spec str) Key {
	let parts = twine.Split(spec, "+")
	mut k = Key{}
	mut i = 0
	for i < len(parts) - 1 {
		if parts[i] == "shift" {
			k.Flags = k.Flags | flagShift
		} else if parts[i] == "alt" {
			k.Flags = k.Flags | flagAlt
		} else if parts[i] == "cmd" {
			k.Flags = k.Flags | flagCmd
		} else if parts[i] == "ctrl" {
			k.Flags = k.Flags | flagCtrl
		}
		i += 1
	}
	let name = parts[len(parts) - 1]
	k.Code = -1
	if name == "return" {
		k.Code = keyReturn
	} else if name == "tab" {
		k.Code = keyTab
	} else if name == "backspace" {
		k.Code = keyBackspace
	} else if name == "delete" {
		k.Code = keyForwardDelete
	} else if name == "escape" {
		k.Code = keyEscape
	} else if name == "left" {
		k.Code = keyLeft
	} else if name == "right" {
		k.Code = keyRight
	} else if name == "up" {
		k.Code = keyUp
	} else if name == "down" {
		k.Code = keyDown
	} else if name == "home" {
		k.Code = keyHome
	} else if name == "end" {
		k.Code = keyEnd
	} else if name == "pageup" {
		k.Code = keyPageUp
	} else if name == "pagedown" {
		k.Code = keyPageDown
	} else {
		k.Chars = name
	}
	return k
}

// dump prints the text and the cursor (and the selection when there is one).
fn (ed Editor) dump() {
	let b = ed.Buf
	say.Line("---", ed.Name(), "row", b.Row + 1, "col", b.Col + 1, "dirty", b.Dirty)
	if b.HasSel {
		say.Line("selection:", b.SelectedText())
	}
	say.Line(b.Text())
}

// runScript performs a script: steps separated by "|", each one of
//   type:TEXT        types TEXT (\n is a line break, \t a tab, \p a "|")
//   key:SPEC         one key press, such as key:cmd+shift+z or key:left
//   dump             prints the text and the cursor
//   jump:TEXT        jumps to the place a compiler message names
//   check            checks the text with the compiler and prints the errors
//   complete:LABEL   opens the completion list and says whether LABEL is in it; accept takes the chosen one
//   whereFile        prints the name of the file the caret is in
//   where            prints the file, line and column of the caret
//   info             prints the quick info popup
//   budget:KIND:N:MS repeats render, type or scroll N times and says whether each took at most MS milliseconds
//   output           prints the output panel
//   prompt           prints the find or go-to-line prompt
//   open:PATH        loads a file
//   fold, unfold, unfoldall  fold the block at the caret, open the fold there, open all
//   shown            prints the folds' count and the lines on screen
//   wrap             toggles word wrap (prints the new state); rowof prints the caret's row on the screen
//   sort, trim       sorts the touched lines, removes their trailing spaces and tabs
//   whitespace       toggles the whitespace marks (prints the new state)
//   tabs             prints how many tabs are open, which is active and its name; closeothers keeps the active
//   counts           prints the text's lines, words and characters
//   one, closeall leaves one empty tab
//   snap:PATH        draws the editor and writes it as a PNG
//   view:W,H         sets the window size in points
fn RunScript(ed mut Editor, script str) {
	let steps = twine.Split(script, "|")
	mut i = 0
	for i < len(steps) {
		let step = steps[i]
		if twine.HasPrefix(step, "type:") {
			mut text = step[5:]
			text = twine.ReplaceAll(text, "\\n", "\n")
			text = twine.ReplaceAll(text, "\\t", "\t")
			text = twine.ReplaceAll(text, "\\p", "|")
			if ed.Mode != modeEdit {
				// typed into a prompt: one key press per character
				mut j = 0
				for j < len(text) {
					ed.handleKey(Key{Code: -1, Chars: text[j:j + 1]})
					j += 1
				}
			} else {
				ed.Blink = true
				ed.Buf.Insert(text)
			}
		} else if twine.HasPrefix(step, "key:") {
			ed.handleKey(keyFor(step[4:]))
		} else if twine.HasPrefix(step, "cursor:") {
			// cursor:below and cursor:above add a caret
			if step == "cursor:below" {
				ed.AddCursor(1)
			} else {
				ed.AddCursor(-1)
			}
		} else if step == "dump" {
			ed.dump()
		} else if twine.HasPrefix(step, "jump:") {
			say.Line("jumped:", ed.JumpTo(step[5:]))
		} else if twine.HasPrefix(step, "complete:") {
			// complete:LABEL opens the completion list at the caret and says whether LABEL is in it
			ed.openCompletion()
			mut has = false
			for n, it in ed.Comp {
				if it.Label == step[9:] {
					has = true
					ed.CompSel = n
				}
			}
			say.Line("complete", step[9:], has, len(ed.Comp) > 0)
		} else if step == "accept" {
			ed.acceptCompletion()
		} else if step == "whereFile" {
			say.Line("in", ed.Name())
		} else if step == "where" {
			say.Line("at", ed.Name(), ed.Buf.Row + 1, ed.Buf.Col + 1)
		} else if step == "selinfo" {
			say.Line("selection", ed.SelectionInfo())
		} else if step == "info" {
			say.Line("info:", twine.Join(ed.Info, " | "))
		} else if step == "check" {
			ed.CheckNow()
			mut d = 0
			for d < len(ed.Diags) {
				let x = ed.Diags[d]
				say.Line("diag:", x.Line, x.Col, x.EndLine, x.EndCol, x.Code, x.Message)
				d += 1
			}
			say.Line("diags:", len(ed.Diags))
		} else if twine.HasPrefix(step, "budget:") {
			// budget:render:N:MS, budget:type:N:MS, budget:scroll:N:MS: N repetitions must average at most MS
			// milliseconds each (the performance gates of the editor: the numbers are generous, a real
			// regression is orders of magnitude)
			let nums = appkit.ParseNumbers(twine.ReplaceAll(step[7:], ":", " "))
			let what = step[7:twine.Index(step[7:], ":") + 7]
			if len(nums) >= 2 {
				let reps = i64(nums[0])
				let t0 = tide.Now()
				mut r = 0
				for r < reps {
					if what == "render" {
						ed.Buf.Version += 1
						ed.cpuFrame()
					} else if what == "type" {
						ed.Buf.Insert("x")
						ed.cpuFrame()
					} else if what == "scroll" {
						ed.Scroll = (ed.Scroll + 37) % len(ed.Buf.Lines)
						ed.cpuFrame()
					}
					r += 1
				}
				let avgMs = f64(tide.Since(t0)) / 1000000.0 / f64(reps)
				if avgMs <= nums[1] {
					say.Line("budget", what, "ok")
				} else {
					say.Line("budget", what, "EXCEEDED:", avgMs, "ms per frame, limit", nums[1])
				}
			}
		} else if step == "output" {
			say.Line("output:", ed.OutputOpen)
			say.Line(twine.Join(ed.Output, "\n"))
		} else if step == "prompt" {
			say.Line("prompt:", ed.Mode, ed.Prompt, ed.Message)
		} else if twine.HasPrefix(step, "open:") {
			ed.Load(step[5:])
		} else if step == "fold" {
			ed.FoldCaret()
		} else if step == "unfold" {
			ed.UnfoldCaret()
		} else if step == "unfoldall" {
			ed.UnfoldAll()
		} else if step == "shown" {
			// the lines on screen, in order, with the folds
			ed.syncFolds()
			mut shown = []str{}
			mut r = ed.Scroll
			for r < len(ed.Buf.Lines) && len(shown) < 40 {
				shown = append(shown, ed.Buf.Lines[r])
				r = ed.nextVisible(r)
			}
			say.Line("shown:", len(ed.Folds), twine.Join(shown, "|"), "row", ed.Buf.Row)
		} else if step == "bracket" {
			ed.JumpBracket()
		} else if step == "join" {
			ed.Buf.JoinLines()
		} else if step == "uppercase" {
			ed.Buf.TransformCase(true)
		} else if step == "lowercase" {
			ed.Buf.TransformCase(false)
		} else if step == "sort" {
			ed.Buf.SortLines()
		} else if step == "trim" {
			ed.Buf.TrimTrailingSpace()
		} else if twine.HasPrefix(step, "gutter:") {
			let r = parseInt(step[7:])
			ed.Buf.SelectLine(r)
		} else if step == "revert" {
			ed.Revert()
		} else if step == "wrap" {
			say.Line("wrap:", ed.ToggleWrapView())
		} else if step == "rowof" {
			// where the caret is on the screen: its row from the top and its column in that row
			let dc = textedit.DisplayCol(ed.Buf.Lines[ed.Buf.Row], ed.Buf.Col, 4)
			say.Line("caret row", ed.visRow(ed.Buf.Row, dc), "col", dc - ed.baseOf(dc), "top", ed.Scroll, ed.ScrollSeg)
		} else if step == "selnext" {
			say.Line("selected:", ed.SelectNext())
		} else if step == "counts" {
			say.Line("counts", ed.Counts())
		} else if step == "tabs" {
			say.Line("tabs", len(ed.Tabs), ed.Active + 1, ed.Name())
		} else if step == "closeothers" {
			ed.closeOthers()
		} else if step == "closeall" {
			ed.closeAll()
		} else if step == "whitespace" {
			say.Line("whitespace:", ToggleWhitespace())
		} else if twine.HasPrefix(step, "ruler:") {
			// ruler:N puts the line at display column N
			let n = parseInt(step[6:])
			SetRulerColumn(n)
			say.Line("ruler column:", n)
		} else if step == "ruler" {
			say.Line("ruler:", ToggleRuler(), RulerColumn())
		} else if step == "rulercol" {
			say.Line("ruler column:", ed.RulerCol())
		} else if twine.HasPrefix(step, "snap:") {
			ed.Snapshot(step[5:])
		} else if twine.HasPrefix(step, "view:") {
			let nums = appkit.ParseNumbers(step[5:])
			if len(nums) >= 2 {
				ed.AreaW = nums[0]
				ed.AreaH = nums[1]
			}
		}
		i += 1
	}
	if ed.Message != "" {
		say.Line("message:", ed.Message)
	}
}
