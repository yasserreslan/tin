package editor

import "language"
import "twine"

// output is what the last Run printed, shown in a panel above the status line until Escape.
const outputRows = 10

// runFile compiles the active file with tinc and runs it, collecting the output into the panel.
fn (ed mut Editor) runFile() {
	if !twine.HasSuffix(ed.Buf.Path, ".tin") {
		ed.Say("Run works on a saved .tin file")
		return
	}
	if ed.Buf.Dirty && !ed.save(false) {
		return
	}
	let exe = ed.tmp("run")
	if len(exe) == 0 {
		ed.Say("no private temporary directory")
		return
	}
	ed.Output = language.Run(ed.Buf.Path, exe, ed.Name())
	ed.OutputOpen = true
	ed.Redraw = true
}

// JumpTo opens the file and line named by a compiler message "path:line:col: ..." (false for any other line).
fn (ed mut Editor) JumpTo(text str) bool {
	let parts = twine.SplitN(text, ":", 4)
	if len(parts) < 3 {
		return false
	}
	let row = parseInt(parts[1])
	let col = parseInt(parts[2])
	if row < 1 || len(parts[0]) == 0 {
		return false
	}
	if parts[0] != ed.Buf.Path && !ed.Load(parts[0]) {
		return false
	}
	let at = row - 1
	if at >= len(ed.Buf.Lines) {
		return false
	}
	mut c = col - 1
	if c < 0 {
		c = 0
	}
	if c > len(ed.Buf.Lines[at]) {
		c = len(ed.Buf.Lines[at])
	}
	ed.Buf.MoveTo(at, c, false)
	ed.Redraw = true
	return true
}
