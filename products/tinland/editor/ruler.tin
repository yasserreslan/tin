package editor

// The ruler (View > Toggle Ruler): a faint vertical line down the text area at a display column, so a line that runs past it
// is visible without counting. The column is `rulerColumn` (the settings' ruler_column, 80 by default) and with word wrap on
// the wrap column is shown instead when it is the one in the way.

// defaultRulerColumn is where the line sits before the settings name a column.
const defaultRulerColumn = 80

// rulerOn is whether the line is drawn.
mut rulerOn = false

// rulerColumn is the column the line sits at (at least 1).
mut rulerColumn = defaultRulerColumn

// ToggleRuler turns the ruler on or off and reports the new state.
fn ToggleRuler() bool {
	rulerOn = !rulerOn
	return rulerOn
}

// RulerShown is whether the ruler is drawn.
fn RulerShown() bool {
	return rulerOn
}

// RulerColumn is the column the ruler sits at.
fn RulerColumn() i64 {
	return rulerColumn
}

// SetRulerColumn chooses the column (a value below 1 keeps the default).
fn SetRulerColumn(col i64) {
	mut c = col
	if c < 1 {
		c = defaultRulerColumn
	}
	rulerColumn = c
}

// RulerCol is the display column the line is drawn at for this editor: the wrap column when wrapping is on and it is smaller,
// else the column the settings name.
fn (ed Editor) RulerCol() i64 {
	if wrapOn {
		let cols = ed.cols()
		if cols > 0 && cols < rulerColumn {
			return cols
		}
	}
	return rulerColumn
}
