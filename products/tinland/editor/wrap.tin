package editor

import "textedit"

// Soft wrap (View > Toggle Word Wrap): a line longer than the text area is shown as several rows, each as wide as the area. The
// text is not changed. The view's place is a line (Scroll) and the row of that line at the top (ScrollSeg); with wrap off every line
// is one row and ScrollSeg is 0.

const CmdToggleWrap = 32

// wrapOn is whether lines are wrapped.
mut wrapOn = false

// ToggleWrap turns wrapping on or off and reports the new state.
fn ToggleWrap() bool {
	wrapOn = !wrapOn
	return wrapOn
}

// WrapShown is whether wrapping is on.
fn WrapShown() bool {
	return wrapOn
}

// ToggleWrapView does the view's part of turning wrapping on or off: the scroll goes back to whole lines and the sideways
// scroll to nothing.
fn (ed mut Editor) ToggleWrapView() bool {
	let on = ToggleWrap()
	ed.ScrollSeg = 0
	ed.HScroll = 0
	ed.Follow = true
	ed.Redraw = true
	return on
}

// segCount is how many rows line row takes: one without wrap, and for a folded line.
fn (ed Editor) segCount(row i64) i64 {
	if !wrapOn || ed.foldAt(row) >= 0 {
		return 1
	}
	let cols = ed.cols()
	let width = foldCols(ed.Buf.Lines[row])
	if width <= cols {
		return 1
	}
	return (width + cols - 1) / cols
}

// baseOf is the first display column shown in the row that holds display column dcol.
fn (ed Editor) baseOf(dcol i64) i64 {
	if !wrapOn {
		return ed.HScroll
	}
	return dcol / ed.cols() * ed.cols()
}

// nextRow is the row after row r, segment s (the row count of a line past the last row stays on it).
fn (ed Editor) nextRow(r i64, s i64) (i64, i64) {
	if s + 1 < ed.segCount(r) {
		return r, s + 1
	}
	let next = ed.nextVisible(r)
	if next >= len(ed.Buf.Lines) {
		return r, s
	}
	return next, 0
}

// prevRow is the row before row r, segment s.
fn (ed Editor) prevRow(r i64, s i64) (i64, i64) {
	if s > 0 {
		return r, s - 1
	}
	let prev = ed.prevVisible(r)
	if prev < 0 {
		return r, s
	}
	return prev, ed.segCount(prev) - 1
}

// rowAt is the line and segment shown k rows below the top of the view.
fn (ed Editor) rowAt(k i64) (i64, i64) {
	mut r = ed.Scroll
	mut s = ed.ScrollSeg
	mut i = 0
	for i < k {
		let (nr, ns) = ed.nextRow(r, s)
		if nr == r && ns == s {
			break
		}
		r = nr
		s = ns
		i += 1
	}
	return r, s
}

// visRow is the place on the screen (rows from the top, -1 above it, capped a little below the bottom) of the row that holds display
// column dcol of line row.
fn (ed Editor) visRow(row i64, dcol i64) i64 {
	if !wrapOn {
		return ed.dispRow(row)
	}
	mut want = 0
	if dcol > 0 {
		want = dcol / ed.cols()
	}
	if want >= ed.segCount(row) {
		want = ed.segCount(row) - 1
	}
	if row < ed.Scroll || (row == ed.Scroll && want < ed.ScrollSeg) {
		return -1
	}
	mut r = ed.Scroll
	mut s = ed.ScrollSeg
	mut n = 0
	let cap = ed.rows() + 2
	for (r != row || s != want) && n < cap {
		let (nr, ns) = ed.nextRow(r, s)
		if nr == r && ns == s {
			break
		}
		r = nr
		s = ns
		n += 1
	}
	return n
}

// scrollRows moves the view n rows down (up for a negative n).
fn (ed mut Editor) scrollRows(n i64) {
	mut r = ed.Scroll
	mut s = ed.ScrollSeg
	mut i = 0
	if n > 0 {
		for i < n {
			let (nr, ns) = ed.nextRow(r, s)
			if nr == r && ns == s {
				break
			}
			r = nr
			s = ns
			i += 1
		}
	} else {
		for i < 0 - n {
			let (nr, ns) = ed.prevRow(r, s)
			if nr == r && ns == s {
				break
			}
			r = nr
			s = ns
			i += 1
		}
	}
	ed.Scroll = r
	ed.ScrollSeg = s
	ed.Redraw = true
}

// clampSpan cuts display columns c0 to c1 to the row that starts at column base: ok is false when nothing of it is in the row.
fn (ed Editor) clampSpan(c0 i64, c1 i64, base i64) (i64, i64, bool) {
	if !wrapOn {
		return c0, c1, c1 > c0
	}
	mut a = c0
	mut b = c1
	if a < base {
		a = base
	}
	if b > base + ed.cols() {
		b = base + ed.cols()
	}
	return a, b, b > a
}

// moveWrapped moves the caret one row up (-1) or down (1) in wrapped text, keeping its column in the row.
fn (ed mut Editor) moveWrapped(dir i64, shift bool) bool {
	let line = ed.Buf.Lines[ed.Buf.Row]
	let dcol = textedit.DisplayCol(line, ed.Buf.Col, 4)
	let cols = ed.cols()
	let (r, s) = ed.rowAtCaret(dcol)
	mut nr = r
	mut ns = s
	if dir < 0 {
		let (a, b) = ed.prevRow(r, s)
		nr = a
		ns = b
	} else {
		let (a, b) = ed.nextRow(r, s)
		nr = a
		ns = b
	}
	if nr == r && ns == s {
		return false
	}
	let target = ns * cols + dcol % cols
	let text = ed.Buf.Lines[nr]
	ed.Buf.MoveTo(nr, textedit.ColForDisplay(text, target, 4), shift)
	return true
}

// rowAtCaret is the line and segment of display column dcol on the caret's line.
fn (ed Editor) rowAtCaret(dcol i64) (i64, i64) {
	mut s = 0
	if dcol > 0 {
		s = dcol / ed.cols()
	}
	if s >= ed.segCount(ed.Buf.Row) {
		s = ed.segCount(ed.Buf.Row) - 1
	}
	return ed.Buf.Row, s
}

// nextRowIn is nextRow for painting: it also moves past the last line (len(lines)) so the loop ends.
fn (ed Editor) nextRowIn(r i64, s i64) (i64, i64) {
	if s + 1 < ed.segCount(r) {
		return r, s + 1
	}
	return ed.nextVisible(r), 0
}
