package editor

import "metal"
import "mint"
import "../render"
import "say"
import "textedit"
import "twine"
import "../theme"
import "../ui"

// The editor's text area, painted on the GPU: line numbers, the current line, the selection, the text in syntax colors, the
// diagnostics, the caret, a scroll bar and the completion list. Everything is placed on a grid of cells, CharW by LineH points,
// so a fallback font's wider glyph cannot push the rest of a line out of its columns.

// kindColor is the color of a syntax class.
fn kindColor(th theme.Theme, kind i64) i64 {
	if kind == textedit.KindKeyword {
		return th.Keyword
	}
	if kind == textedit.KindString {
		return th.String
	}
	if kind == textedit.KindNumber {
		return th.Number
	}
	if kind == textedit.KindComment {
		return th.Comment
	}
	if kind == textedit.KindConstant {
		return th.Constant
	}
	if kind == textedit.KindType {
		return th.Type
	}
	if kind == textedit.KindFunc {
		return th.Func
	}
	return th.Text
}

// UseFont sets the character cell from the code font: its advance, and a line a little taller than the font.
fn (ed mut Editor) UseFont() {
	ed.CharW = render.CodeCell()
	ed.LineH = f64(i64(render.LineHeight(render.FontCode) * 1.2 + 0.5))
}

// Prepare does what a frame needs that stores new memory: the multi-line string state of each line. Call it outside the
// frame's arena, after the text changed.
fn (ed mut Editor) Prepare() {
	ed.syncFolds()
	ed.updateRaw()
}

// updateRaw recomputes, for each line, what it starts inside (a block comment, a multi-line string, a code fence): the state the
// highlighting of the language needs from the line above.
fn (ed mut Editor) updateRaw() {
	let lang = textedit.LanguageOf(ed.Buf.Path)
	if ed.rawFor == ed.Buf.Version && len(ed.rawRows) == len(ed.Buf.Lines) && ed.rawLang == lang {
		return
	}
	mut rows = []i64{}
	mut state = 0
	for i in 0..len(ed.Buf.Lines) {
		rows = append(rows, state)
		let (spans, next) = textedit.HighlightLang(lang, ed.Buf.Lines[i], state)
		state = next
	}
	ed.rawRows = rows
	ed.rawLang = lang
	ed.rawFor = ed.Buf.Version
}

// cell is one displayed character: what to draw and the syntax class it has.
type cell struct {
	text str
	kind i64
}

// cellsOf expands a line into display cells: tabs become spaces to the next tab stop, a multi-byte character is one cell (two
// for a wide one), and each cell gets its syntax class.
fn cellsOf(line str, state i64, lang i64) []cell {
	let (spans, _) = textedit.HighlightLang(lang, line, state)
	mut kinds = make([]i64, len(line), len(line))
	for sp in spans {
		mut j = sp.Start
		for j < sp.End && j < len(line) {
			kinds[j] = sp.Kind
			j += 1
		}
	}
	mut out = []cell{}
	mut i = 0
	for i < len(line) {
		let c = line[i]
		if c == '\t' {
			mut n = 4 - len(out) % 4
			for n > 0 {
				out = append(out, cell{text: " ", kind: kinds[i]})
				n -= 1
			}
		} else if c >= 0x80 && c < 0xc0 {
			// a continuation byte belongs to the cell its lead byte began
		} else if c >= 0xc0 {
			mut n = 2
			if c >= 0xf0 {
				n = 4
			} else if c >= 0xe0 {
				n = 3
			}
			if i + n > len(line) {
				n = len(line) - i
			}
			out = append(out, cell{text: line[i:i + n], kind: kinds[i]})
			if textedit.RuneWidth(textedit.RuneAt(line, i)) == 2 {
				out = append(out, cell{text: "", kind: kinds[i]})
			}
		} else {
			out = append(out, cell{text: line[i:i + 1], kind: kinds[i]})
		}
		i += 1
	}
	return out
}

fn textOf(cells []cell, from i64, to i64) str {
	mut text = ""
	for i in from..to {
		text = text + cells[i].text
	}
	return text
}

fn (c cell) ascii() bool {
	return len(c.text) == 1
}

// rowTop is where line number n of the view (counted from the scroll position) starts, in points from the area's top.
fn (ed Editor) rowTop(n i64) f64 {
	return f64(n) * ed.LineH
}

// Paint draws the text area into the rectangle (x, y, w, h) (points). The text must have been Prepared.
// showWhitespace marks spaces with a dot and tabs with an arrow (View > Toggle Whitespace).
mut showWhitespace = false

// ToggleWhitespace turns the whitespace marks on or off and reports the new state.
fn ToggleWhitespace() bool {
	showWhitespace = !showWhitespace
	return showWhitespace
}

// WhitespaceShown is whether the whitespace marks are on.
fn WhitespaceShown() bool {
	return showWhitespace
}

fn (ed mut Editor) Paint(th theme.Theme, x f64, y f64, w f64, h f64, scene mut metal.Scene) {
	ed.AreaW = w
	ed.AreaH = h
	if ed.Follow {
		ed.ensureVisible()
		ed.Follow = false
	}
	render.Clip(mut scene, x, y, w, h)
	render.Fill(mut scene, x, y, w, h, th.Editor)
	let gutter = ed.gutterW()
	let rows = ed.rows()
	let b = ed.Buf
	let sel0 = b.SelStart()
	let sel1 = b.SelEnd()
	let textX = x + gutter
	let lh = ed.LineH
	let pad = (lh - render.LineHeight(render.FontCode)) / 2.0
	mut n = 0
	mut row = ed.Scroll
	mut seg = ed.ScrollSeg
	if !wrapOn {
		seg = 0
	}
	for n <= rows && row < len(b.Lines) {
		let hs = ed.HScroll + seg * ed.cols()
		let first = seg == 0
		let line = b.Lines[row]
		let top = y + ed.rowTop(n)
		mut state = 0
		if row < len(ed.rawRows) {
			state = ed.rawRows[row]
		}
		let cells = cellsOf(line, state, ed.rawLang)
		if row == b.Row && !b.HasSel {
			render.Fill(mut scene, x, top, w, lh, th.LineHighlight)
		}
		// the indent guides: one vertical segment per indentation level this line reaches
		if guidesOn && first {
			let ind = indentOf(line)
			if ind >= 4 {
				mut k = 1
				for guideAt(k) < ind {
					let gx = textX + f64(guideAt(k) - hs) * ed.CharW
					if gx >= textX && gx < x + w {
						render.Fill(mut scene, gx, top, 1.0, lh, th.Guide)
					}
					k += 1
				}
			}
		}
		// the selected part of this line
		if b.HasSel && row >= sel0.Row && row <= sel1.Row {
			mut from = 0
			mut to = len(cells) + 1
			if row == sel0.Row {
				from = textedit.DisplayCol(line, sel0.Col, 4)
			}
			if row == sel1.Row {
				to = textedit.DisplayCol(line, sel1.Col, 4)
			}
			let (f2, t2, inRow) = ed.clampSpan(from, to, hs)
			let x0 = textX + f64(f2 - hs) * ed.CharW
			let x1 = textX + f64(t2 - hs) * ed.CharW
			if inRow && x1 > x0 {
				render.Fill(mut scene, x0, top, x1 - x0, lh, th.Selection)
			}
		}
		// every place the find box's text occurs on this line
		let needle = ed.activeNeedle()
		if len(needle) > 0 {
			mut from = 0
			for from < len(line) {
				let at = twine.Index(line[from:], needle)
				if at < 0 {
					break
				}
				let c0 = textedit.DisplayCol(line, from + at, 4)
				let c1 = textedit.DisplayCol(line, from + at + len(needle), 4)
				let (m0, m1, inRow) = ed.clampSpan(c0, c1, hs)
				if inRow {
					render.Fill(mut scene, textX + f64(m0 - hs) * ed.CharW, top, f64(m1 - m0) * ed.CharW, lh, th.Match)
				}
				from = from + at + len(needle)
			}
		}
		// the text, in runs of one syntax class
		mut i = hs
		mut last = hs + ed.cols() + 2
		if wrapOn {
			last = hs + ed.cols()
		}
		for i < len(cells) && i < last {
			mut j = i + 1
			for j < len(cells) && j < last && cells[j].kind == cells[i].kind {
				j += 1
			}
			let color = kindColor(th, cells[i].kind)
			mut k = i
			for k < j {
				mut m = k
				if cells[k].ascii() {
					for m < j && cells[m].ascii() {
						m += 1
					}
					render.Pen(mut scene, render.FontCode, textX + f64(k - hs) * ed.CharW, top + pad, textOf(cells, k, m), color)
				} else if len(cells[k].text) == 0 {
					m = k + 1
				} else {
					m = k + 1
					render.Pen(mut scene, render.FontCode, textX + f64(k - hs) * ed.CharW, top + pad, cells[k].text, color)
				}
				k = m
			}
			i = j
		}
		// the whitespace marks: a dot for a space, an arrow at the start of a tab
		if showWhitespace {
			mut col = 0
			for k in 0..len(line) {
				let ch = line[k]
				if ch == '\t' {
					let stop = 4 - col % 4
					if col >= hs && col < last {
						render.Pen(mut scene, render.FontCode, textX + f64(col - hs) * ed.CharW, top + pad, "\u2192", th.Gutter)
					}
					col += stop
				} else if ch == ' ' {
					if col >= hs && col < last {
						render.Pen(mut scene, render.FontCode, textX + f64(col - hs) * ed.CharW, top + pad, "\u00b7", th.Gutter)
					}
					col += 1
				} else if ch < 128 || ch >= 192 {
					col += textedit.DisplayCol(line[k:k + 1], 1, 4)
				}
			}
		}
		// errors on this line: a bar in the gutter and a line under the offending text
		if ed.diagAt(row) >= 0 && first {
			render.Fill(mut scene, x, top, 3.0, lh, th.Error)
			for d in ed.Diags {
				if d.Line == row + 1 {
					let from = textedit.DisplayCol(line, d.Col - 1, 4)
					mut to = textedit.DisplayCol(line, d.EndCol - 1, 4)
					if d.EndCol - 1 > len(line) {
						to = textedit.DisplayCol(line, len(line), 4) + (d.EndCol - 1 - len(line))
					}
					if to <= from {
						to = from + 1
					}
					let (d0, d1, inRow) = ed.clampSpan(from, to, hs)
					if inRow {
						render.Fill(mut scene, textX + f64(d0 - hs) * ed.CharW, top + lh - 2.0, f64(d1 - d0) * ed.CharW, 1.5, th.Error)
					}
				}
			}
		}
		// what git says about this line: a bar in the gutter's edge
		mut mark = ed.markAt(row)
		if !first {
			mark = 0
		}
		if mark == 1 {
			render.Fill(mut scene, x + 2.0, top, 3.0, lh, ui.Hex(0x8fd1b0))
		} else if mark == 2 {
			render.Fill(mut scene, x + 2.0, top, 3.0, lh, ui.Hex(0x7cc4f0))
		} else if mark == 3 {
			render.Fill(mut scene, x + 2.0, top, 6.0, 2.0, th.Error)
		}
		// the line number, right aligned in the gutter (the current line brighter)
		let label = mint.Itoa(row + 1)
		let lx = x + gutter - ed.CharW * 1.5 - f64(len(label)) * ed.CharW
		mut numColor = th.Gutter
		if row == b.Row {
			numColor = th.GutterActive
		}
		if first {
			render.Pen(mut scene, render.FontCode, lx, top + pad, label, numColor)
		}
		// the fold arrow: open (down) on a line that starts a block, closed (right) on a folded one, and an ellipsis after its text
		if ed.foldable(row) && first {
			let folded = ed.foldAt(row) >= 0
			mut arrow = "\u25be"
			if folded {
				arrow = "\u25b8"
			}
			render.Pen(mut scene, render.FontCode, x + gutter - ed.CharW * 1.4, top + pad, arrow, th.Gutter)
			if folded {
				let ex = textX + f64(foldCols(line) - hs + 1) * ed.CharW
				render.FillRound(mut scene, ex, top + lh * 0.2, ed.CharW * 3.0, lh * 0.6, 3.0, th.Selection)
				render.Pen(mut scene, render.FontCode, ex + ed.CharW * 0.5, top + pad, "\u2026", th.Gutter)
			}
		}
		let (nr, ns) = ed.nextRowIn(row, seg)
		row = nr
		seg = ns
		n += 1
	}
	// the caret: a bar between two characters, blinking
	if ed.Blink && ed.Mode == modeEdit {
		let cdc = textedit.DisplayCol(b.Lines[b.Row], b.Col, 4)
		let cx = textX + f64(cdc - ed.baseOf(cdc)) * ed.CharW
		let cn = ed.visRow(b.Row, cdc)
		if cn >= 0 && cn <= rows {
			render.Fill(mut scene, cx, y + ed.rowTop(cn), 1.5, lh, th.Cursor)
		}
	}
	// the bracket next to the caret and its partner
	let (mr, mc, found) = ed.matchBracket()
	if found {
		ed.markCell(th, textX, y, b.Row, caretBracketCol(ed), mut scene)
		ed.markCell(th, textX, y, mr, mc, mut scene)
	}
	// the other carets
	for p in ed.Extra {
		let edc = textedit.DisplayCol(b.Lines[p.Row], p.Col, 4)
		let en = ed.visRow(p.Row, edc)
		if en >= 0 && en <= rows && p.Row < len(b.Lines) {
			let ex = textX + f64(edc - ed.baseOf(edc)) * ed.CharW
			render.Fill(mut scene, ex, y + ed.rowTop(en), 1.5, lh, th.Cursor)
		}
	}
	// the ruler: a vertical line at the column (it moves sideways with the text, and is not drawn past its edge)
	if rulerOn {
		let col = ed.RulerCol()
		let rx = textX + f64(col - ed.HScroll) * ed.CharW
		if rx >= textX {
			render.Fill(mut scene, rx, y, 1.0, h, th.Ruler)
		}
	}
	if ed.mapW() > 0.0 {
		ed.minimap(th, x, y, w, h, mut scene)
	} else {
		ed.scrollbar(th, x, y, w, h, mut scene)
	}
	ed.promptBox(th, x, y, w, mut scene)
	ed.popups(th, x, y, w, h, mut scene)
	render.Unclip(mut scene)
}

// minimap draws the whole file as small bars, one per run of text, with the part in the window shaded; a click or a drag in it
// scrolls.
fn (ed Editor) minimap(th theme.Theme, x f64, y f64, w f64, h f64, scene mut metal.Scene) {
	let mw = ed.mapW()
	let mx = x + w - mw
	render.Fill(mut scene, mx, y, mw, h, th.Editor)
	render.Fill(mut scene, mx, y, 1.0, h, th.LineHighlight)
	let start = ed.mapStart()
	let cap = i64(h / minimapRow)
	let rows = ed.rows()
	// the window
	let vy = y + f64(ed.Scroll - start) * minimapRow
	render.Fill(mut scene, mx, vy, mw, f64(rows) * minimapRow, th.Selection)
	let b = ed.Buf
	mut n = 0
	for n < cap && start + n < len(b.Lines) {
		let line = b.Lines[start + n]
		let top = y + f64(n) * minimapRow
		// one bar for each run of characters that are not spaces, a column per character (a tab is four)
		mut col = 0
		mut from = -1
		for k in 0..len(line) {
			let ch = line[k]
			if ch == ' ' || ch == '\t' {
				if from >= 0 {
					render.Fill(mut scene, mx + 4.0 + f64(from), top, f64(col - from), 1.2, th.Gutter)
					from = -1
				}
				if ch == '\t' {
					col += 4
				} else {
					col += 1
				}
			} else if ch < 128 || ch >= 192 {
				if from < 0 {
					from = col
				}
				col += 1
			}
			if col >= i64(mw) - 6 {
				break
			}
		}
		if from >= 0 {
			render.Fill(mut scene, mx + 4.0 + f64(from), top, f64(col - from), 1.2, th.Gutter)
		}
		n += 1
	}
}

// scrollbar draws a thin thumb at the right edge showing which part of the text is in view.
fn (ed Editor) scrollbar(th theme.Theme, x f64, y f64, w f64, h f64, scene mut metal.Scene) {
	let total = len(ed.Buf.Lines)
	let rows = ed.rows()
	if total <= rows {
		return
	}
	let thumb = h * f64(rows) / f64(total)
	let at = (h - thumb) * f64(ed.Scroll) / f64(total - 1)
	render.FillRound(mut scene, x + w - 9.0, y + at, 6.0, thumb, 3.0, ui.HexA(0xffffff, 0.18))
}

// popups draws the completion list or the quick info next to the caret.
fn (ed Editor) popups(th theme.Theme, x f64, y f64, w f64, h f64, scene mut metal.Scene) {
	mut lines = []str{}
	mut sel = -1
	if ed.CompOpen {
		let first = max(0, min(ed.CompSel - 4, len(ed.Comp) - 9))
		mut i = first
		for i < len(ed.Comp) && i < first + 9 {
			let it = ed.Comp[i]
			mut l = it.Label
			if len(it.Detail) > 0 {
				l = l + "   " + it.Detail
			}
			lines = append(lines, l)
			if i == ed.CompSel {
				sel = i - first
			}
			i += 1
		}
	} else {
		for l in ed.Info {
			lines = append(lines, l)
		}
	}
	if len(lines) == 0 {
		return
	}
	mut widest = 0
	for l in lines {
		widest = max(widest, len(l))
	}
	widest = min(widest, 100)
	let b = ed.Buf
	let pdc = textedit.DisplayCol(b.Lines[b.Row], b.Col, 4)
	let cn = ed.visRow(b.Row, pdc)
	let cx = x + ed.gutterW() + f64(pdc - ed.baseOf(pdc)) * ed.CharW
	let boxW = f64(widest + 2) * ed.CharW
	let boxH = f64(len(lines)) * ed.LineH + 8.0
	mut px = cx
	if px + boxW > x + w {
		px = x + w - boxW
	}
	mut top = y + ed.rowTop(cn + 1)
	if top + boxH > y + h {
		top = y + ed.rowTop(cn) - boxH
	}
	render.FillRound(mut scene, px, top, boxW, boxH, 6.0, th.Panel)
	render.Stroke(mut scene, px, top, boxW, boxH, 6.0, 1.0, th.Border)
	let pad = (ed.LineH - render.LineHeight(render.FontCode)) / 2.0
	mut k = 0
	for k < len(lines) {
		let ly = top + 4.0 + f64(k) * ed.LineH
		if k == sel {
			render.FillRound(mut scene, px + 3.0, ly, boxW - 6.0, ed.LineH, 4.0, th.Selected)
		}
		mut text = lines[k]
		if len(text) > widest {
			text = text[:widest]
		}
		render.Pen(mut scene, render.FontCode, px + ed.CharW, ly + pad, text, th.Text)
		k += 1
	}
}

// cpuFrame does the work of a frame that needs no GPU: the highlighting state and the display cells of the visible lines (the
// scripts time it to catch a regression in how a frame is prepared).
fn (ed mut Editor) cpuFrame() {
	ed.syncFolds()
	ed.updateRaw()
	ed.ensureVisible()
	mut n = 0
	mut row = ed.Scroll
	for n <= ed.rows() && row < len(ed.Buf.Lines) {
		cellsOf(ed.Buf.Lines[row], ed.rawRows[row], ed.rawLang)
		row = ed.nextVisible(row)
		n += 1
	}
}

// Snapshot draws the text area (AreaW by AreaH points) on the GPU at twice the scale and writes it as a PNG. Without a GPU it does
// nothing (the caller checks for the file).
fn (ed mut Editor) Snapshot(path str) {
	let gpu = metal.Open()
	if gpu.Device == 0 {
		return
	}
	render.Init(gpu, 2.0, 13.0)
	ed.UseFont()
	ed.Prepare()
	mut scene = metal.Scene{}
	let th = theme.Dark()
	ed.Paint(th, 0.0, 0.0, ed.AreaW, ed.AreaH, mut scene)
	render.Upload()
	if !render.Snapshot(scene, i64(ed.AreaW * 2.0), i64(ed.AreaH * 2.0), th.Editor, path) {
		say.Line("cannot write", path)
	}
}

// activeNeedle is the text the find box is looking for now ("" when it is not open).
fn (ed Editor) activeNeedle() str {
	if ed.Mode == modeFind {
		return ed.Prompt
	}
	if ed.Mode == modeReplace {
		return ed.Needle
	}
	return ""
}

// markAt is what git says about line row: 0 nothing, 1 added, 2 changed, 3 lines were removed above it.
fn (ed Editor) markAt(row i64) i64 {
	for m in ed.Marks {
		if m / 4 == row {
			return m % 4
		}
	}
	return 0
}

// markCell outlines the character at byte col of line row.
fn (ed Editor) markCell(th theme.Theme, textX f64, y f64, row i64, col i64, scene mut metal.Scene) {
	let line = ed.Buf.Lines[row]
	let c0 = textedit.DisplayCol(line, col, 4)
	let n = ed.visRow(row, c0)
	if n < 0 || n > ed.rows() {
		return
	}
	render.Stroke(mut scene, textX + f64(c0 - ed.baseOf(c0)) * ed.CharW, y + ed.rowTop(n), ed.CharW, ed.LineH, 2.0, 1.0, th.Muted)
}

fn opener(c u8) bool {
	return c == '(' || c == '[' || c == '{'
}

fn closer(c u8) bool {
	return c == ')' || c == ']' || c == '}'
}

fn partner(c u8) u8 {
	if c == '(' {
		return ')'
	}
	if c == '[' {
		return ']'
	}
	if c == '{' {
		return '}'
	}
	if c == ')' {
		return '('
	}
	if c == ']' {
		return '['
	}
	return '{'
}

// caretBracketCol is the column of the bracket matchBracket looked at: the one after the caret, else the one before it.
fn caretBracketCol(ed Editor) i64 {
	let b = ed.Buf
	let line = b.Lines[b.Row]
	if b.Col < len(line) && (opener(line[b.Col]) || closer(line[b.Col])) {
		return b.Col
	}
	return b.Col - 1
}

// matchBracket finds the partner of the bracket beside the caret (the one right after it, or else right before it), looking at
// most 20000 characters away; it reports where and whether it found one.
fn (ed Editor) matchBracket() (i64, i64, bool) {
	let b = ed.Buf
	let line = b.Lines[b.Row]
	mut col = -1
	if b.Col < len(line) && (opener(line[b.Col]) || closer(line[b.Col])) {
		col = b.Col
	} else if b.Col > 0 && b.Col <= len(line) && (opener(line[b.Col - 1]) || closer(line[b.Col - 1])) {
		col = b.Col - 1
	}
	if col < 0 {
		return 0, 0, false
	}
	let c = line[col]
	let want = partner(c)
	mut depth = 0
	mut row = b.Row
	mut at = col
	mut budget = 20000
	if opener(c) {
		for row < len(b.Lines) && budget > 0 {
			let l = b.Lines[row]
			for at < len(l) {
				budget -= 1
				if l[at] == c {
					depth += 1
				} else if l[at] == want {
					depth -= 1
					if depth == 0 {
						return row, at, true
					}
				}
				at += 1
			}
			row += 1
			at = 0
		}
	} else {
		for row >= 0 && budget > 0 {
			let l = b.Lines[row]
			if row != b.Row {
				at = len(l) - 1
			}
			for at >= 0 {
				budget -= 1
				if l[at] == c {
					depth += 1
				} else if l[at] == want {
					depth -= 1
					if depth == 0 {
						return row, at, true
					}
				}
				at -= 1
			}
			row -= 1
		}
	}
	return 0, 0, false
}

// matchCount is how many times the find text occurs in the buffer (counting stops at 9999).
fn (ed Editor) matchCount(needle str) i64 {
	if len(needle) == 0 {
		return 0
	}
	mut n = 0
	for line in ed.Buf.Lines {
		mut from = 0
		for from < len(line) {
			let at = twine.Index(line[from:], needle)
			if at < 0 {
				break
			}
			n += 1
			from = from + at + len(needle)
		}
		if n >= 9999 {
			return n
		}
	}
	return n
}

// promptBox draws the find, replace or go-to-line box in the corner of the text area while one is open.
fn (ed Editor) promptBox(th theme.Theme, x f64, y f64, w f64, scene mut metal.Scene) {
	if ed.Mode == modeEdit {
		return
	}
	mut label = "Find"
	mut text = ed.Prompt
	mut note = ""
	if ed.Mode == modeGoto {
		label = "Go to line"
	} else if ed.Mode == modeReplace {
		label = "Replace " + ed.Needle + " with"
	}
	let needle = ed.activeNeedle()
	if len(needle) > 0 {
		let n = ed.matchCount(needle)
		if n == 0 {
			note = "no results"
		} else {
			note = mint.Itoa(n) + " results"
		}
	}
	let boxW = min(520.0, w - 20.0)
	let bx = x + w - boxW - 14.0
	let by = y + 8.0
	render.FillRound(mut scene, bx, by, boxW, 34.0, 6.0, th.Panel)
	render.Stroke(mut scene, bx, by, boxW, 34.0, 6.0, 1.0, th.Accent)
	let lh = render.LineHeight(render.FontUI)
	let ty = by + (34.0 - lh) / 2.0
	render.Pen(mut scene, render.FontUI, bx + 12.0, ty, label, th.Faint)
	let lx = bx + 12.0 + render.Width(render.FontUI, label) + 10.0
	let end = render.Pen(mut scene, render.FontUI, lx, ty, text, th.Text)
	if ed.Blink {
		render.Fill(mut scene, end + 1.0, by + 8.0, 1.5, 18.0, th.Cursor)
	}
	if len(note) > 0 {
		mut color = th.Muted
		if note == "no results" {
			color = th.Error
		}
		let nw = render.Width(render.FontSmall, note)
		render.Pen(mut scene, render.FontSmall, bx + boxW - nw - 12.0, by + (34.0 - render.LineHeight(render.FontSmall)) / 2.0, note, color)
	}
}
