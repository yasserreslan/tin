package editor

import "textedit"
import "twine"

// Mouse and key input, in the terms the text area understands: positions are in points from the area's top left, keys come as
// the hardware code, the modifier flags and the text typed.

// mouseTo moves the caret to the character cell at (x, y).
fn (ed mut Editor) mouseTo(x f64, y f64, extend bool) {
	mut row = 0
	mut seg = 0
	if y < 0.0 {
		if wrapOn {
			let (r, s) = ed.prevRow(ed.Scroll, ed.ScrollSeg)
			row = r
			seg = s
		} else {
			row = ed.prevVisible(ed.Scroll)
		}
	} else if wrapOn {
		let (r, s) = ed.rowAt(i64(y / ed.LineH))
		row = r
		seg = s
	} else {
		row = ed.shownAfter(ed.Scroll, i64(y / ed.LineH))
	}
	if row < 0 {
		row = 0
	}
	if row >= len(ed.Buf.Lines) {
		row = len(ed.Buf.Lines) - 1
	}
	mut base = ed.HScroll
	if wrapOn {
		base = seg * ed.cols()
	}
	mut dcol = base + i64((x - ed.gutterW()) / ed.CharW + 0.5)
	if wrapOn && dcol >= base + ed.cols() {
		dcol = base + ed.cols() - 1
	}
	if dcol < 0 {
		dcol = 0
	}
	ed.Buf.MoveTo(row, textedit.ColForDisplay(ed.Buf.Lines[row], dcol, 4), extend)
	ed.Blink = true
	ed.Redraw = true
}

// KeyDown acts on a key press: code is the hardware key code, flags the modifiers, chars the text it types.
fn (ed mut Editor) KeyDown(code i64, flags i64, chars str) {
	mut text = chars
	if (flags & flagCmd) != 0 {
		text = twine.ToLower(chars)
	}
	ed.handleKey(Key{Code: code, Flags: flags, Chars: text})
}

// MouseDown handles a press at (x, y) in the text area: clicks is 1, 2 (a word) or 3 (a line); a click with the command key
// goes to the declaration under the mouse.
fn (ed mut Editor) MouseDown(x f64, y f64, clicks i64, flags i64) {
	ed.Mode = modeEdit
	ed.CompOpen = false
	if x < ed.gutterW() && x >= ed.gutterW() - ed.CharW * 2.0 && y >= 0.0 {
		// the fold arrow of the line under the mouse
		let row = ed.shownAfter(ed.Scroll, i64(y / ed.LineH))
		if ed.foldable(row) {
			ed.ToggleFold(row)
			return
		}
	}
	if ed.mapW() > 0.0 && x >= ed.AreaW - ed.mapW() {
		ed.mapDrag = true
		ed.mapScrollTo(y)
		return
	}
	ed.Follow = true
	ed.mouseTo(x, y, (flags & flagShift) != 0)
	if (flags & flagCmd) != 0 {
		ed.gotoDefinition()
		return
	}
	if clicks == 2 {
		ed.Buf.SelectWordAt(ed.Buf.Row, ed.Buf.Col)
	} else if clicks >= 3 {
		ed.Buf.MoveTo(ed.Buf.Row, 0, false)
		ed.Buf.MoveTo(ed.Buf.Row, len(ed.Buf.Lines[ed.Buf.Row]), true)
	}
	ed.dragging = true
}

// MouseDrag extends the selection to (x, y) while the button is held.
fn (ed mut Editor) MouseDrag(x f64, y f64) {
	if ed.mapDrag {
		ed.mapScrollTo(y)
		return
	}
	if ed.dragging {
		ed.mouseTo(x, y, true)
	}
}

// MouseUp ends a drag.
fn (ed mut Editor) MouseUp() {
	ed.dragging = false
	ed.mapDrag = false
}

// mapScrollTo scrolls so the line under y in the minimap is in the middle of the window.
fn (ed mut Editor) mapScrollTo(y f64) {
	let row = ed.mapStart() + i64(y / minimapRow)
	mut top = row - ed.rows() / 2
	let most = len(ed.Buf.Lines) - ed.rows()
	if top > most {
		top = most
	}
	if top < 0 {
		top = 0
	}
	ed.Scroll = top
	ed.Redraw = true
}

// Wheel scrolls the text by dy points (positive scrolls the text down, as a trackpad moves it).
fn (ed mut Editor) Wheel(dx f64, dy f64) {
	ed.acc += dy
	let lines = i64(ed.acc / ed.LineH)
	if lines != 0 {
		ed.acc -= f64(lines) * ed.LineH
		if wrapOn {
			ed.scrollRows(0 - lines)
		} else if lines > 0 {
			ed.Scroll = ed.shownBefore(ed.Scroll, lines)
		} else {
			ed.Scroll = ed.shownAfter(ed.Scroll, 0 - lines)
		}
		ed.Redraw = true
	}
	ed.accX += dx
	let cols = i64(ed.accX / ed.CharW)
	if cols != 0 {
		ed.accX -= f64(cols) * ed.CharW
		ed.HScroll -= cols
		if ed.HScroll < 0 {
			ed.HScroll = 0
		}
		ed.Redraw = true
	}
}
