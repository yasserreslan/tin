package editor

import "mint"
import "sift"
import "textedit"
import "tinsym"
import "twine"

// Navigation and completion from the compiler's declarations (tinsym): go to the declaration of a name, back again, a
// popup with a name's signature and documentation, and a list of what can be written at the caret.

// Place is a position the editor was at: a file and a place in it.
type Place struct {
	Path str
	Row  i64
	Col  i64
}

// gotoDefinition is Cmd+B and Cmd+click, GoLand's Go to Declaration or Usages: on a use of a name, its declaration (a list to
// choose from when the name may mean several); on the declaration itself, its usages (straight there when there is one); on
// an import path or a package's name, the package's source.
fn (ed mut Editor) gotoDefinition() {
	if ed.openPackageAt(ed.Buf.Row, ed.Buf.Col) {
		return
	}
	let (decl, isDecl) = ed.declarationAt(ed.Buf.Row, ed.Buf.Col)
	if isDecl {
		ed.showUsages(decl)
		return
	}
	let found = tinsym.Resolve(ed.Syms, ed.Buf.Path, ed.Buf.Text(), ed.Buf.Row, ed.Buf.Col)
	if len(found) == 0 {
		ed.Say("no declaration found")
		return
	}
	if len(found) > 1 {
		mut choices = []Choice{}
		for sym in found {
			choices = append(choices, Choice{At: ed.placeOf(sym), Text: sym.Sig})
		}
		ed.offer("Declarations of " + found[0].Name, choices)
		return
	}
	let sym = found[0]
	if ed.jump(ed.placeOf(sym)) {
		ed.Say(sym.Sig)
	}
}

// jump moves to the place, opening its file, and remembers where it came from for Back; a new jump forgets Forward.
fn (ed mut Editor) jump(to Place) bool {
	let here = Place{Path: ed.Buf.Path, Row: ed.Buf.Row, Col: ed.Buf.Col}
	if to.Path != ed.Buf.Path && !ed.Load(to.Path) {
		return false
	}
	ed.Back = append(ed.Back, here)
	ed.Fwd = []Place{}
	ed.moveTo(to)
	return true
}

// GoTo goes to a place chosen from the editor's Choices (the workspace's picker calls it); Back returns from it.
fn (ed mut Editor) GoTo(to Place) bool {
	return ed.jump(to)
}

// moveTo puts the caret at the place in the open file (inside its text) and scrolls it into view.
fn (ed mut Editor) moveTo(at Place) {
	let row = max(0, min(at.Row, len(ed.Buf.Lines) - 1))
	let col = max(0, min(at.Col, len(ed.Buf.Lines[row])))
	ed.Buf.MoveTo(row, col, false)
	ed.Follow = true
	ed.Redraw = true
}

// offer gives the places to choose from (the workspace shows them); with only one there is nothing to choose: it goes there.
fn (ed mut Editor) offer(title str, choices []Choice) {
	if len(choices) == 0 {
		return
	}
	if len(choices) == 1 {
		ed.jump(choices[0].At)
		ed.Say(title + ": " + choices[0].Text)
		return
	}
	ed.Choices = choices
	ed.ChoiceTitle = title
	ed.Say(title + ": " + mint.Itoa(len(choices)))
}

// goBack returns to where the last jump came from.
fn (ed mut Editor) goBack() {
	if len(ed.Back) == 0 {
		ed.Say("nowhere to go back to")
		return
	}
	let at = ed.Back[len(ed.Back) - 1]
	let here = Place{Path: ed.Buf.Path, Row: ed.Buf.Row, Col: ed.Buf.Col}
	if at.Path != ed.Buf.Path && !ed.Load(at.Path) {
		return
	}
	ed.Back = ed.Back[:len(ed.Back) - 1]
	ed.Fwd = append(ed.Fwd, here)
	ed.moveTo(at)
}

// goForward goes again where Back came from.
fn (ed mut Editor) goForward() {
	if len(ed.Fwd) == 0 {
		ed.Say("nowhere to go forward to")
		return
	}
	let at = ed.Fwd[len(ed.Fwd) - 1]
	let here = Place{Path: ed.Buf.Path, Row: ed.Buf.Row, Col: ed.Buf.Col}
	if at.Path != ed.Buf.Path && !ed.Load(at.Path) {
		return
	}
	ed.Fwd = ed.Fwd[:len(ed.Fwd) - 1]
	ed.Back = append(ed.Back, here)
	ed.moveTo(at)
}

// quickInfo shows the signature and the documentation of the name at the caret.
fn (ed mut Editor) quickInfo() {
	let found = tinsym.Resolve(ed.Syms, ed.Buf.Path, ed.Buf.Text(), ed.Buf.Row, ed.Buf.Col)
	if len(found) == 0 {
		let at = ed.diagAt(ed.Buf.Row)
		if at >= 0 {
			// an error on the line: what the compiler says and what to do about it
			let d = ed.Diags[at]
			mut lines = []str{d.Code + " " + d.Message}
			if len(d.Fix) > 0 {
				lines = append(lines, "Fix: " + d.Fix)
			}
			ed.Info = lines
			return
		}
		ed.Say("no declaration found")
		return
	}
	mut lines = []str{found[0].Sig}
	if len(found[0].Doc) > 0 {
		for l in twine.Split(found[0].Doc, "\n") {
			lines = append(lines, l)
		}
	}
	ed.Info = lines
}

// prefix is the word being typed: the identifier bytes just before the caret.
fn (ed Editor) prefix() str {
	let line = ed.Buf.Lines[ed.Buf.Row]
	mut from = ed.Buf.Col
	for from > 0 && wordByte(line[from - 1]) {
		from -= 1
	}
	return line[from:ed.Buf.Col]
}

fn wordByte(c u8) bool {
	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
}

// openCompletion lists what can be written at the caret, for the word typed so far.
fn (ed mut Editor) openCompletion() {
	let items = ed.candidates()
	let want = twine.ToLower(ed.prefix())
	mut shown = []tinsym.Item{}
	for it in items {
		if len(shown) < 200 && twine.HasPrefix(twine.ToLower(it.Label), want) {
			shown = append(shown, it)
		}
	}
	ed.Comp = shown
	ed.CompSel = 0
	ed.CompOpen = len(shown) > 0
	if !ed.CompOpen {
		ed.Say("no completions")
	}
}

// refilter narrows the list to the word typed since it was opened (closing it when nothing is left).
fn (ed mut Editor) refilter() {
	if !ed.CompOpen {
		return
	}
	let want = twine.ToLower(ed.prefix())
	let items = ed.candidates()
	mut shown = []tinsym.Item{}
	for it in items {
		if len(shown) < 200 && twine.HasPrefix(twine.ToLower(it.Label), want) {
			shown = append(shown, it)
		}
	}
	ed.Comp = shown
	if ed.CompSel >= len(shown) {
		ed.CompSel = 0
	}
	ed.CompOpen = len(shown) > 0
}

// acceptCompletion replaces the typed word with the chosen candidate.
fn (ed mut Editor) acceptCompletion() {
	if !ed.CompOpen || ed.CompSel >= len(ed.Comp) {
		return
	}
	let label = ed.Comp[ed.CompSel].Label
	let typed = len(ed.prefix())
	ed.CompOpen = false
	ed.External = []tinsym.Item{}
	if typed > 0 {
		ed.Buf.MoveTo(ed.Buf.Row, ed.Buf.Col - typed, false)
		ed.Buf.MoveTo(ed.Buf.Row, ed.Buf.Col + typed, true)
	}
	ed.Buf.Insert(label)
}

// completionKey handles a key while the list is open; it reports whether the key was used up.
fn (ed mut Editor) completionKey(k Key) bool {
	if k.Code == keyUp {
		if ed.CompSel > 0 {
			ed.CompSel -= 1
		}
		return true
	}
	if k.Code == keyDown {
		if ed.CompSel + 1 < len(ed.Comp) {
			ed.CompSel += 1
		}
		return true
	}
	if k.Code == keyTab || k.Code == keyReturn || k.Code == keyEnter {
		ed.acceptCompletion()
		return true
	}
	if k.Code == keyEscape {
		ed.CompOpen = false
		ed.External = []tinsym.Item{}
		return true
	}
	return false
}

// candidates are what completion offers: for Tin source, what the compiler's declarations say can be written at the caret; for
// every other file, the words that occur in the open files (three letters or more), in alphabetical order.
fn (ed Editor) candidates() []tinsym.Item {
	let lang = textedit.LanguageOf(ed.Buf.Path)
	if len(ed.External) > 0 && lang != textedit.LangTin {
		return ed.External
	}
	if lang == textedit.LangTin {
		return tinsym.Complete(ed.Syms, ed.Buf.Path, ed.Buf.Text(), ed.Buf.Row, ed.Buf.Col)
	}
	let typed = ed.prefix()
	mut seen = map[str]bool{}
	mut words = []str{}
	mut buffers = []textedit.Buffer{ed.Buf}
	for t in ed.Tabs {
		buffers = append(buffers, t.Buf)
	}
	for b in buffers {
		mut scanned = 0
		for r in 0..len(b.Lines) {
			let line = b.Lines[r]
			scanned += len(line)
			if scanned > 400000 {
				break
			}
			mut i = 0
			for i < len(line) {
				if !wordByte(line[i]) {
					i += 1
					continue
				}
				let start = i
				for i < len(line) && wordByte(line[i]) {
					i += 1
				}
				let w = line[start:i]
				let (_, have) = seen[w]
				if len(w) >= 3 && !have && w != typed {
					seen[w] = true
					words = append(words, w)
				}
			}
		}
	}
	sift.Strs(mut words)
	mut items = []tinsym.Item{}
	for w in words {
		items = append(items, tinsym.Item{Label: w, Kind: "word"})
	}
	return items
}

// OpenExternal shows the completions a language server gave, narrowed to the word typed so far.
fn (ed mut Editor) OpenExternal(items []tinsym.Item) {
	ed.External = items
	ed.CompSel = 0
	ed.CompOpen = true
	ed.refilter()
	if !ed.CompOpen {
		ed.External = []tinsym.Item{}
	}
	ed.Redraw = true
}

// SetDiagnostics replaces the problems shown with those a language server reported for this file.
fn (ed mut Editor) SetDiagnostics(diags []tinsym.Diag) {
	ed.Diags = diags
	ed.DiagFor = ed.Buf.Version
	ed.Redraw = true
}
