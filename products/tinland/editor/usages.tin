package editor

import "mint"
import "quarry"
import "tinsym"
import "trail"
import "twine"

// Navigation as GoLand does it, from the compiler's declarations: the usages of a declaration, the implementations of a shape,
// the declaration of a value's type, the source of an imported package, and what Cmd+hover shows. A usage is found the way Go
// to Declaration finds a declaration, backwards: every whole word of the name in the files that may see it, outside comments and
// strings, that resolves to the declaration.

// Choice is a place offered in a list: where it is, and the text shown for it.
type Choice struct {
	At   Place
	Text str
}

// maxChoices is the most places one list offers.
const maxChoices = 500

// wordSpan is the identifier around byte col of the line: its first byte and the byte after it (equal when there is none).
fn wordSpan(line str, col i64) (i64, i64) {
	mut from = min(max(col, 0), len(line))
	mut to = from
	for from > 0 && wordByte(line[from - 1]) {
		from -= 1
	}
	for to < len(line) && wordByte(line[to]) {
		to += 1
	}
	return from, to
}

// describe is one line about a declaration: its signature, or a local's name and type.
fn describe(sym tinsym.Sym) str {
	if len(sym.Sig) > 0 {
		return sym.Sig
	}
	return sym.Name + " " + sym.Type
}

// sameSym reports whether two declarations are the same one (a field by its type and name: it has no place of its own).
fn sameSym(a tinsym.Sym, b tinsym.Sym) bool {
	if a.Kind == "field" || b.Kind == "field" {
		return a.Kind == b.Kind && a.Name == b.Name && a.Recv == b.Recv && a.Pkg == b.Pkg
	}
	return a.File == b.File && a.Line == b.Line && a.Col == b.Col && a.Name == b.Name
}

// declarationAt is the declaration whose name is the word at (row, col) of the active file, when it is one: a function, a
// method, a type, a shape, a constant, a variable, a local or a parameter, or a field in its type's declaration.
fn (ed Editor) declarationAt(row i64, col i64) (tinsym.Sym, bool) {
	if row < 0 || row >= len(ed.Buf.Lines) {
		return tinsym.Sym{}, false
	}
	let line = ed.Buf.Lines[row]
	let (from, to) = wordSpan(line, col)
	if to <= from {
		return tinsym.Sym{}, false
	}
	let word = line[from:to]
	for sym in ed.Syms {
		if sym.File == ed.Buf.Path && sym.Line == row + 1 && sym.Col == from + 1 && sym.Name == word {
			return sym, true
		}
	}
	if len(twine.TrimSpace(line[:from])) == 0 {
		for sym in ed.Syms {
			if sym.Kind == "type" && sym.File == ed.Buf.Path && sym.Line < row + 1 && sym.DeclEndLine > row + 1 {
				for m in sym.Members {
					if m.Name == word {
						return tinsym.Sym{Kind: "field", Name: word, Pkg: sym.Pkg, File: sym.File, Line: sym.Line, Col: sym.Col, Recv: sym.Name, Exported: isUpper(word), Sig: word + " " + m.Detail, Members: []tinsym.Member{}, DeclEndLine: sym.DeclEndLine}, true
					}
				}
			}
		}
	}
	return tinsym.Sym{}, false
}

fn isUpper(word str) bool {
	return len(word) > 0 && word[0] >= 'A' && word[0] <= 'Z'
}

// placeOf is where a declaration's name is written; a field's is its line in its type's declaration.
fn (ed Editor) placeOf(sym tinsym.Sym) Place {
	let at = Place{Path: sym.File, Row: sym.Line - 1, Col: max(sym.Col - 1, 0)}
	if sym.Kind != "field" {
		return at
	}
	let (text, ok) = ed.textOfFile(sym.File)
	if !ok {
		return at
	}
	let lines = twine.Split(text, "\n")
	for r in sym.Line..min(sym.DeclEndLine, len(lines)) {
		let l = lines[r]
		let t = twine.TrimLeft(l, " \t")
		if twine.HasPrefix(t, sym.Name) && (len(t) == len(sym.Name) || !wordByte(t[len(sym.Name)])) {
			return Place{Path: sym.File, Row: r, Col: len(l) - len(t)}
		}
	}
	return at
}

// textOfFile is the text of the file: the active one's as it is being edited, any other's as it is on disk (the compiler's
// declarations were made from that).
fn (ed Editor) textOfFile(path str) (str, bool) {
	if path == ed.Buf.Path {
		return ed.Buf.Text(), true
	}
	let text = quarry.ReadFile(path) catch _ {
		return "", false
	}
	return text, true
}

// wordsIn are the byte columns where name is written as a whole word in the line, outside strings (but inside the {...} a
// string interpolates) and a trailing comment.
fn wordsIn(l str, name str) []i64 {
	mut out = []i64{}
	mut i = 0
	mut quote = u8(0)
	mut interp = false
	for i < len(l) {
		let c = l[i]
		if quote != 0 && !interp {
			if c == '\\' && quote != '`' {
				i += 2
				continue
			}
			if quote == '"' && c == '{' {
				if i + 1 < len(l) && l[i + 1] == '{' {
					i += 2
					continue
				}
				interp = true
				i += 1
				continue
			}
			if c == quote {
				quote = 0
			}
			i += 1
			continue
		}
		if interp && c == '}' {
			interp = false
			i += 1
			continue
		}
		if !interp && (c == '"' || c == '`' || c == '\'') {
			quote = c
			i += 1
			continue
		}
		if c == '/' && i + 1 < len(l) && l[i + 1] == '/' {
			break
		}
		if wordByte(c) {
			mut j = i
			for j < len(l) && wordByte(l[j]) {
				j += 1
			}
			if l[i:j] == name {
				out = append(out, i)
			}
			i = j
			continue
		}
		i += 1
	}
	return out
}

// filesSeeing are the files that may use the declaration, the active one first: a local's own file, the package's folder for a
// name that is not exported, and every file the compiler read for one that is.
fn (ed Editor) filesSeeing(sym tinsym.Sym) []str {
	if sym.Kind == "local" {
		return []str{sym.File}
	}
	let dir = tinsym.DirOf(sym.File)
	let wide = sym.Exported || isUpper(sym.Name)
	mut seen = map[str]bool{}
	mut out = []str{}
	mut all = []str{ed.Buf.Path, sym.File}
	for s in ed.Syms {
		all = append(all, s.File)
	}
	for p in all {
		let (_, have) = seen[p]
		if len(p) == 0 || have {
			continue
		}
		seen[p] = true
		if wide || tinsym.DirOf(p) == dir {
			out = append(out, p)
		}
	}
	return out
}

// usagesOf are the places that use the declaration (not the declaration itself).
fn (ed Editor) usagesOf(sym tinsym.Sym) []Choice {
	mut out = []Choice{}
	for path in ed.filesSeeing(sym) {
		let (text, ok) = ed.textOfFile(path)
		if !ok || twine.Index(text, sym.Name) < 0 {
			continue
		}
		let lines = twine.Split(text, "\n")
		for n in 0..len(lines) {
			let l = lines[n]
			if twine.Index(l, sym.Name) < 0 {
				continue
			}
			for col in wordsIn(l, sym.Name) {
				if path == sym.File && n + 1 == sym.Line && col + 1 == sym.Col {
					continue
				}
				for f in tinsym.Resolve(ed.Syms, path, text, n, col) {
					if sameSym(f, sym) {
						out = append(out, Choice{At: Place{Path: path, Row: n, Col: col}, Text: twine.TrimSpace(l)})
						break
					}
				}
				if len(out) >= maxChoices {
					return out
				}
			}
		}
	}
	return out
}

// showUsages offers the usages of the declaration (going straight there when there is one).
fn (ed mut Editor) showUsages(sym tinsym.Sym) {
	let uses = ed.usagesOf(sym)
	if len(uses) == 0 {
		ed.Say("no usages of " + sym.Name)
		return
	}
	ed.offer("Usages of " + sym.Name, uses)
}

// symAtCaret is the declaration the caret names: the one it is on, else the one the word there resolves to.
fn (ed mut Editor) symAtCaret() (tinsym.Sym, bool) {
	let (decl, isDecl) = ed.declarationAt(ed.Buf.Row, ed.Buf.Col)
	if isDecl {
		return decl, true
	}
	let found = tinsym.Resolve(ed.Syms, ed.Buf.Path, ed.Buf.Text(), ed.Buf.Row, ed.Buf.Col)
	if len(found) == 0 {
		ed.Say("no declaration found")
		return tinsym.Sym{}, false
	}
	return found[0], true
}

// showUsagesAtCaret is Show Usages (Cmd+Alt+F7): the usages of the name at the caret, from its declaration or from a use.
fn (ed mut Editor) showUsagesAtCaret() {
	let (sym, ok) = ed.symAtCaret()
	if ok {
		ed.showUsages(sym)
	}
}

// gotoImplementations is Go to Implementation (Cmd+Alt+B, Cmd+Alt+click): for a shape, the types that have every method it
// lists; for a method, every method of that name.
fn (ed mut Editor) gotoImplementations() {
	let (sym, ok) = ed.symAtCaret()
	if !ok {
		return
	}
	if sym.Kind == "shape" {
		let methods = ed.shapeMethods(sym, 0)
		if len(methods) == 0 {
			ed.Say(sym.Name + " lists no methods")
			return
		}
		mut choices = []Choice{}
		for t in ed.Syms {
			if t.Kind == "type" && ed.hasMethods(t, methods) {
				choices = append(choices, Choice{At: ed.placeOf(t), Text: t.Sig})
			}
		}
		if len(choices) == 0 {
			ed.Say("no type has every method of " + sym.Name)
			return
		}
		ed.offer("Implementations of " + sym.Name, choices)
		return
	}
	if sym.Kind == "method" {
		mut choices = []Choice{}
		for m in ed.Syms {
			if m.Kind == "method" && m.Name == sym.Name {
				choices = append(choices, Choice{At: ed.placeOf(m), Text: m.Sig})
			}
		}
		ed.offer("Methods named " + sym.Name, choices)
		return
	}
	ed.Say(sym.Name + " is not a shape or a method")
}

// shapeMethods are the names of the methods a shape lists, with those of the shapes it lists (depth counts the nesting).
fn (ed Editor) shapeMethods(sym tinsym.Sym, depth i64) []str {
	mut out = []str{}
	let (text, ok) = ed.textOfFile(sym.File)
	if !ok || depth > 4 {
		return out
	}
	let lines = twine.Split(text, "\n")
	for r in sym.Line..min(sym.DeclEndLine - 1, len(lines)) {
		mut t = lines[r]
		let c = twine.Index(t, "//")
		if c >= 0 {
			t = t[:c]
		}
		t = twine.TrimSpace(t)
		let paren = twine.Index(t, "(")
		if paren > 0 {
			let name = twine.TrimSpace(t[:paren])
			let (from, to) = wordSpan(name, 0)
			if from == 0 && to == len(name) {
				out = append(out, name)
			}
		} else if len(t) > 0 && t != "}}" {
			// a shape listed in this one
			let dot = twine.LastIndex(t, ".")
			let inner = t[dot + 1:]
			for s in ed.Syms {
				if s.Kind == "shape" && s.Name == inner {
					for m in ed.shapeMethods(s, depth + 1) {
						out = append(out, m)
					}
					break
				}
			}
		}
	}
	return out
}

// hasMethods reports whether the type has a method of every one of the names.
fn (ed Editor) hasMethods(t tinsym.Sym, names []str) bool {
	for name in names {
		mut has = false
		for m in ed.Syms {
			if m.Kind == "method" && m.Name == name && m.Recv == t.Name && m.Pkg == t.Pkg {
				has = true
				break
			}
		}
		if !has {
			return false
		}
	}
	return true
}

// gotoTypeDeclaration is Go to Type Declaration (Ctrl+Shift+B, Cmd+Shift+click): the declaration of the type of the name at
// the caret (a local, a parameter, a field, a constant or a variable), or of the type itself.
fn (ed mut Editor) gotoTypeDeclaration() {
	let (sym, ok) = ed.symAtCaret()
	if !ok {
		return
	}
	if sym.Kind == "type" || sym.Kind == "shape" {
		if ed.jump(ed.placeOf(sym)) {
			ed.Say(sym.Sig)
		}
		return
	}
	mut t = ""
	if sym.Kind == "local" {
		t = sym.Type
	} else if sym.Kind == "field" {
		t = firstWord(sym.Sig[len(sym.Name):])
	} else if sym.Kind == "var" || sym.Kind == "const" {
		let (rest, has) = twine.CutPrefix(sym.Sig, sym.Kind + " " + sym.Name + " ")
		if has && !twine.HasPrefix(rest, "=") {
			t = firstWord(rest)
		}
	}
	if len(t) == 0 {
		ed.Say("no type known for " + sym.Name)
		return
	}
	let (tpkg, tname) = tinsym.TypeParts(t)
	mut owner = tpkg
	if len(tpkg) == 0 {
		owner = sym.Pkg
	}
	for s in ed.Syms {
		if (s.Kind == "type" || s.Kind == "shape") && s.Name == tname && s.Pkg == owner {
			if ed.jump(ed.placeOf(s)) {
				ed.Say(s.Sig)
			}
			return
		}
	}
	ed.Say(sym.Name + " is " + t)
}

fn firstWord(s str) str {
	let t = twine.TrimSpace(s)
	let sp = twine.IndexAny(t, " \t")
	if sp >= 0 {
		return t[:sp]
	}
	return t
}

// importAt is the import path named at (row, col) of the active file, with the bytes of the line that name it: the quoted path
// of an import line, or the name of an imported package before a dot ("" when there is none).
fn (ed Editor) importAt(row i64, col i64) (str, i64, i64) {
	if row < 0 || row >= len(ed.Buf.Lines) {
		return "", 0, 0
	}
	let line = ed.Buf.Lines[row]
	if twine.HasPrefix(twine.TrimSpace(line), "import \"") {
		let q0 = twine.Index(line, "\"")
		let q1 = twine.Index(line[q0 + 1:], "\"")
		if q1 >= 0 && col > q0 && col <= q0 + 1 + q1 {
			return line[q0 + 1:q0 + 1 + q1], q0 + 1, q0 + 1 + q1
		}
		return "", 0, 0
	}
	let (from, to) = wordSpan(line, col)
	if to <= from || to >= len(line) || line[to] != '.' || (from > 0 && line[from - 1] == '.') {
		return "", 0, 0
	}
	let word = line[from:to]
	for l in ed.Buf.Lines {
		let t = twine.TrimSpace(l)
		if twine.HasPrefix(t, "import \"") {
			let p = t[8:]
			let q = twine.Index(p, "\"")
			if q > 0 && trail.Base(p[:q]) == word {
				// a local or a declaration of that name hides the package
				if len(tinsym.Resolve(ed.Syms, ed.Buf.Path, ed.Buf.Text(), row, col)) > 0 {
					return "", 0, 0
				}
				return p[:q], from, to
			}
		}
	}
	return "", 0, 0
}

// packageFile is the file to open for an import path: in the package's folder, the file named after the package, else the first
// of its files the compiler read.
fn (ed Editor) packageFile(importPath str) (str, bool) {
	let name = trail.Base(importPath)
	mut dir = ""
	if twine.HasPrefix(importPath, ".") {
		dir = trail.Clean(tinsym.DirOf(ed.Buf.Path) + "/" + importPath)
	} else {
		for s in ed.Syms {
			let d = tinsym.DirOf(s.File)
			if twine.HasSuffix(d, "/" + importPath) {
				dir = d
				break
			}
		}
	}
	if len(dir) == 0 {
		return "", false
	}
	if quarry.Exists(dir + "/" + name + ".tin") {
		return dir + "/" + name + ".tin", true
	}
	for s in ed.Syms {
		if tinsym.DirOf(s.File) == dir {
			return s.File, true
		}
	}
	return "", false
}

// openPackageAt opens the source of the package named at (row, col), reporting whether one is named there.
fn (ed mut Editor) openPackageAt(row i64, col i64) bool {
	let (path, _, _) = ed.importAt(row, col)
	if len(path) == 0 {
		return false
	}
	let (file, ok) = ed.packageFile(path)
	if !ok {
		ed.Say("package " + path + " not found")
		return true
	}
	if ed.jump(Place{Path: file, Row: 0, Col: 0}) {
		ed.Say("package " + path)
	}
	return true
}

// linkAt is what Cmd+click would follow from the character at (row, col): a line or two about it (none when there is nowhere to
// go), and the bytes of the line to draw as the link.
fn (ed Editor) linkAt(row i64, col i64) ([]str, i64, i64) {
	let line = ed.Buf.Lines[row]
	let (imp, i0, i1) = ed.importAt(row, col)
	if len(imp) > 0 {
		return []str{"package " + imp}, i0, i1
	}
	if col >= len(line) || !wordByte(line[col]) {
		return []str{}, 0, 0
	}
	let (from, to) = wordSpan(line, col)
	let (decl, isDecl) = ed.declarationAt(row, col)
	if isDecl {
		return []str{describe(decl), "click: its usages"}, from, to
	}
	let found = tinsym.Resolve(ed.Syms, ed.Buf.Path, ed.Buf.Text(), row, col)
	if len(found) == 0 {
		return []str{}, from, to
	}
	mut lines = []str{describe(found[0])}
	if len(found) > 1 {
		lines = append(lines, mint.Itoa(len(found)) + " declarations")
	} else if found[0].File != ed.Buf.Path {
		lines = append(lines, trail.Base(found[0].File) + ":" + mint.Itoa(found[0].Line))
	}
	return lines, from, to
}

// linkTo makes the name at (row, col) the link (row -1 for none); it reports whether that changed.
fn (ed mut Editor) linkTo(row i64, col i64) bool {
	if row < 0 || row >= len(ed.Buf.Lines) || col < 0 || col >= len(ed.Buf.Lines[row]) {
		return ed.unlink()
	}
	let line = ed.Buf.Lines[row]
	mut from = col
	mut to = col
	let (imp, i0, i1) = ed.importAt(row, col)
	if len(imp) > 0 {
		from = i0
		to = i1
	} else if wordByte(line[col]) {
		let (f, t) = wordSpan(line, col)
		from = f
		to = t
	}
	if to <= from {
		return ed.unlink()
	}
	if ed.LinkRow == row && ed.LinkFrom == from && ed.LinkTo == to && ed.LinkPath == ed.Buf.Path && ed.LinkVer == ed.Buf.Version {
		return false
	}
	let (info, _, _) = ed.linkAt(row, col)
	ed.LinkRow = row
	ed.LinkFrom = from
	ed.LinkTo = to
	ed.LinkPath = ed.Buf.Path
	ed.LinkVer = ed.Buf.Version
	ed.LinkInfo = info
	ed.Redraw = true
	return true
}

// unlink stops showing the link; it reports whether one was there.
fn (ed mut Editor) unlink() bool {
	if ed.LinkRow < 0 {
		return false
	}
	ed.LinkRow = -1
	ed.LinkInfo = []str{}
	ed.Redraw = true
	return true
}

// Linked reports whether a name is drawn as a link (the application shows the pointing hand then).
fn (ed Editor) Linked() bool {
	return ed.LinkRow >= 0 && ed.LinkRow < len(ed.Buf.Lines) && len(ed.LinkInfo) > 0 && ed.LinkPath == ed.Buf.Path && ed.LinkVer == ed.Buf.Version
}
