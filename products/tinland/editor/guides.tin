package editor

// Indent guides (View > Toggle Indent Guides): a faint vertical line at each indentation level a line reaches, so the block
// structure of the file is visible without reading it. Each visible row draws its own segment at the levels its own
// indentation reaches, so a run of rows at one depth is one continuous line.

// guidesOn is whether the lines are drawn.
mut guidesOn = true

// ToggleGuides turns the indent guides on or off and reports the new state.
fn ToggleGuides() bool {
	guidesOn = !guidesOn
	return guidesOn
}

// GuidesShown is whether the indent guides are drawn.
fn GuidesShown() bool {
	return guidesOn
}

// SetGuides turns the indent guides on or off (the settings' indent_guides).
fn SetGuides(on bool) {
	guidesOn = on
}

// guideAt is the display column the level k guide sits at: k multiples of four (the one indent a Tab inserts).
fn guideAt(k i64) i64 {
	return k * 4
}
