package project

import "../../tit/ignore"
import "twine"

// loadRules reads the folder's ignore rules with tit's ignore package (git's rules: negation, `**`, classes, the
// root .gitignore and .tit/info/exclude); a folder's own .gitignore is added when load reads the folder.
fn loadRules(root str) ignore.Rules {
	return ignore.Load(root) catch _ {
		ignore.New(root)
	}
}

// ignored reports whether the rules read so far ignore the entry at path.
fn (p Project) ignored(path str, name str, isDir bool) bool {
	let rules = p.rules
	if rules == nil {
		return false
	}
	return rules.Ignored(twine.TrimPrefix(path, p.Root + "/"), isDir)
}
