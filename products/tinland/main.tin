package main

import "app"
import "editor"
import "quarry"
import "textedit"

// Tinland: an editor written in Tin. With paths it opens those files and folders; with TINLAND_SCRIPT set it runs the script
// without a window (editor/script.tin).
fn main() {
	let args = quarry.Args()
	let script = quarry.Getenv("TINLAND_SCRIPT")
	if len(script) > 0 {
		mut ed = editor.New(textedit.New())
		for a in 1..len(args) {
			ed.Load(args[a])
		}
		ed.Headless = true
		editor.RunScript(mut ed, script)
		ed.Cleanup()
		return
	}
	app.Run(args[1:])
}
