// The colors of the interface, in one place: a Theme is a value (every field a color) and the program holds one. Dark is
// modelled on Zed's One Dark.
package theme

import "../ui"

type Theme struct {
	// surfaces
	Background i64
	Panel i64
	TitleBar i64
	StatusBar i64
	Editor i64
	TabBar i64
	TabActive i64
	Border i64
	// rows and controls
	Hover i64
	Selected i64
	Accent i64
	// text
	Text i64
	Muted i64
	Faint i64
	Error i64
	Warning i64
	// the editor
	Gutter i64
	GutterActive i64
	Cursor i64
	Selection i64
	LineHighlight i64
	Match i64
	// Ruler is the vertical line at the ruler's column.
	Ruler i64
	// Guide is an indent guide's vertical line.
	Guide i64
	// syntax
	Keyword i64
	String i64
	Number i64
	Comment i64
	Constant i64
	Type i64
	Func i64
}

// Dark is the default theme: Tinland's own, a blue-black slate like the metal it is named for, with a copper accent.
fn Dark() Theme {
	return Theme{
		Background: ui.Hex(0x14171c),
		Panel: ui.Hex(0x191d24),
		TitleBar: ui.Hex(0x111419),
		StatusBar: ui.Hex(0x111419),
		Editor: ui.Hex(0x161a20),
		TabBar: ui.Hex(0x111419),
		TabActive: ui.Hex(0x161a20),
		Border: ui.Hex(0x262c36),
		Hover: ui.Hex(0x212733),
		Selected: ui.Hex(0x2b3442),
		Accent: ui.Hex(0xe0955a),
		Text: ui.Hex(0xd6dbe4),
		Muted: ui.Hex(0x98a2b3),
		Faint: ui.Hex(0x5f6b7d),
		Error: ui.Hex(0xf0777a),
		Warning: ui.Hex(0xf2c46d),
		Gutter: ui.Hex(0x465062),
		GutterActive: ui.Hex(0xd6dbe4),
		Cursor: ui.Hex(0xe0955a),
		Selection: ui.Hex(0x2a4a5e),
		LineHighlight: ui.Hex(0x1b2028),
		Match: ui.HexA(0xe0955a, 0.35),
		Ruler: ui.Hex(0x2b3442),
		Guide: ui.Hex(0x232931),
		Keyword: ui.Hex(0xf0876a),
		String: ui.Hex(0x8fd1b0),
		Number: ui.Hex(0xf2c46d),
		Comment: ui.Hex(0x5f6b7d),
		Constant: ui.Hex(0xe58fb3),
		Type: ui.Hex(0xa9b7ff),
		Func: ui.Hex(0x7cc4f0)
	}
}

// Light is the light counterpart: warm paper and slate text with the same copper accent.
fn Light() Theme {
	return Theme{
		Background: ui.Hex(0xf4f2ee),
		Panel: ui.Hex(0xebe8e2),
		TitleBar: ui.Hex(0xe4e0d9),
		StatusBar: ui.Hex(0xe4e0d9),
		Editor: ui.Hex(0xfbfaf7),
		TabBar: ui.Hex(0xe4e0d9),
		TabActive: ui.Hex(0xfbfaf7),
		Border: ui.Hex(0xd3cec5),
		Hover: ui.Hex(0xe0dcd3),
		Selected: ui.Hex(0xd6d1c6),
		Accent: ui.Hex(0xc2692a),
		Text: ui.Hex(0x2a303b),
		Muted: ui.Hex(0x5b6577),
		Faint: ui.Hex(0x8a93a3),
		Error: ui.Hex(0xc8383c),
		Warning: ui.Hex(0xa87400),
		Gutter: ui.Hex(0xa4abb8),
		GutterActive: ui.Hex(0x2a303b),
		Cursor: ui.Hex(0xc2692a),
		Selection: ui.Hex(0xcfe0ec),
		LineHighlight: ui.Hex(0xf1eee8),
		Match: ui.HexA(0xc2692a, 0.30),
		Ruler: ui.Hex(0xd8d2c8),
		Guide: ui.Hex(0xdcd6cc),
		Keyword: ui.Hex(0xc2492a),
		String: ui.Hex(0x2a8a63),
		Number: ui.Hex(0xa86a00),
		Comment: ui.Hex(0x8a93a3),
		Constant: ui.Hex(0xb03a78),
		Type: ui.Hex(0x4a5bc8),
		Func: ui.Hex(0x1f78b4)
	}
}

// ByName is the theme with the name ("light"; anything else is the dark one).
fn ByName(name str) Theme {
	if name == "light" {
		return Light()
	}
	return Dark()
}
