// The colors of the interface, in one place: a Theme is a value (every field a color) and the program holds one. Dark is
// modelled on Zed's One Dark.
package theme

import "ui"

type Theme struct {
	// surfaces
	Background i64
	Panel i64
	TitleBar i64
	StatusBar i64
	Editor i64
	TabBar i64
	TabActive i64
	Border i64
	// rows and controls
	Hover i64
	Selected i64
	Accent i64
	// text
	Text i64
	Muted i64
	Faint i64
	Error i64
	Warning i64
	// the editor
	Gutter i64
	GutterActive i64
	Cursor i64
	Selection i64
	LineHighlight i64
	Match i64
	// syntax
	Keyword i64
	String i64
	Number i64
	Comment i64
	Constant i64
	Type i64
	Func i64
}

// Dark is the default theme.
fn Dark() Theme {
	return Theme{
		Background: ui.Hex(0x282c33),
		Panel: ui.Hex(0x2f343e),
		TitleBar: ui.Hex(0x2f343e),
		StatusBar: ui.Hex(0x2f343e),
		Editor: ui.Hex(0x282c33),
		TabBar: ui.Hex(0x2f343e),
		TabActive: ui.Hex(0x282c33),
		Border: ui.Hex(0x464b57),
		Hover: ui.Hex(0x363c46),
		Selected: ui.Hex(0x454a56),
		Accent: ui.Hex(0x74ade8),
		Text: ui.Hex(0xdce0e5),
		Muted: ui.Hex(0xa9afbc),
		Faint: ui.Hex(0x878a98),
		Error: ui.Hex(0xd07277),
		Warning: ui.Hex(0xdec184),
		Gutter: ui.Hex(0x4e5a5f),
		GutterActive: ui.Hex(0xdce0e5),
		Cursor: ui.Hex(0x74ade8),
		Selection: ui.HexA(0x74ade8, 0.25),
		LineHighlight: ui.HexA(0xffffff, 0.04),
		Match: ui.HexA(0xdec184, 0.35),
		Keyword: ui.Hex(0xb477cf),
		String: ui.Hex(0xa1c181),
		Number: ui.Hex(0xbf956a),
		Comment: ui.Hex(0x5d636f),
		Constant: ui.Hex(0xdfc184),
		Type: ui.Hex(0x6eb4bf),
		Func: ui.Hex(0x73ade9)
	}
}
