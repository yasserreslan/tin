package main

import "appkit"
import "mint"
import "quarry"
import "tinsym"
import "twine"

// Diagnostics: the compiler checks the text being edited (tinc -check -json with the buffer as an overlay) when typing
// pauses, and the errors are underlined where they are, marked in the gutter, and explained in the status line.

// tinRoot is the tree the compiler belongs to when it is <root>/bin/tinc ("" otherwise).
fn tinRoot(compiler str) str {
	if twine.HasSuffix(compiler, "/bin/tinc") {
		return compiler[:len(compiler) - 9]
	}
	return ""
}

// checkNow runs the compiler on the active buffer (tinc -symbols -json, with the unsaved text as an overlay) and keeps
// the errors and the declarations it reports.
fn (ed mut Editor) checkNow() {
	ed.DiagFor = ed.Buf.Version
	if !twine.HasSuffix(ed.Buf.Path, ".tin") {
		ed.Diags = []tinsym.Diag{}
		ed.Syms = []tinsym.Sym{}
		return
	}
	let overlay = ed.tmp("overlay.tin")
	if len(overlay) == 0 {
		return
	}
	quarry.WriteFile(overlay, ed.Buf.Text()) catch _ {
		return
	}
	let compiler = compilerPath()
	mut env = ""
	let root = tinRoot(compiler)
	if len(root) > 0 {
		env = "TIN_ROOT=" + quoted(root) + " "
	}
	let (code, out) = appkit.RunCapture(env + quoted(compiler) + " -symbols -json -overlay " + quoted(ed.Buf.Path + "=" + overlay) + " " + quoted(ed.Buf.Path))
	if code == 127 || code == -1 {
		ed.Diags = []tinsym.Diag{}
		return
	}
	let (syms, all) = tinsym.Parse(out)
	mut mine = []tinsym.Diag{}
	for d in all {
		if d.File == ed.Buf.Path {
			mine = append(mine, d)
		}
	}
	ed.Diags = mine
	// a file that does not parse gives no declarations: keep the last ones
	if len(syms) > 0 || code == 0 {
		ed.Syms = syms
	}
	ed.Redraw = true
}

// diagAt is the first error on a line (-1 when there is none).
fn (ed Editor) diagAt(line i64) i64 {
	mut i = 0
	for i < len(ed.Diags) {
		if ed.Diags[i].Line == line + 1 {
			return i
		}
		i += 1
	}
	return -1
}

// summary is the status line text for the errors: the one under the caret, or how many there are.
fn (ed Editor) diagSummary() str {
	if len(ed.Diags) == 0 {
		return ""
	}
	let at = ed.diagAt(ed.Buf.Row)
	if at >= 0 {
		return ed.Diags[at].Code + " " + ed.Diags[at].Message
	}
	return mint.Itoa(len(ed.Diags)) + " errors"
}
