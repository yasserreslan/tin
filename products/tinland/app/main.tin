package main

import "appkit"
import "mint"
import "quarry"
import "say"

// Tinland: the first window. It opens, draws a line of text, and stays until it is closed (or for TINLAND_SMOKE
// seconds, which the smoke test sets).
fn main() {
	let w = 800
	let h = 500
	let bmp = appkit.NewBitmap(w, h)
	appkit.FillRect(bmp, 0.0, 0.0, 800.0, 500.0, 0.11, 0.12, 0.14, 1.0)
	appkit.FillRect(bmp, 0.0, 470.0, 800.0, 30.0, 0.18, 0.2, 0.24, 1.0)
	appkit.FillRect(bmp, 0.0, 0.0, 800.0, 24.0, 0.18, 0.2, 0.24, 1.0)
	appkit.SetFont(bmp, "Menlo-Regular", 15.0)
	appkit.FillRect(bmp, 0.0, 0.0, 0.0, 0.0, 0.9, 0.9, 0.9, 1.0)
	appkit.DrawText(bmp, 16.0, 440.0, "Tinland: an editor written in Tin")
	let win = appkit.OpenWindow("Tinland", 800.0, 500.0)
	appkit.Present(win, bmp)
	say.Line("window open:", appkit.IsOpen(win))
	// TINLAND_SMOKE=N closes the window after N seconds (the smoke test); otherwise it stays until closed.
	mut maxFrames = -1
	let smoke = quarry.Getenv("TINLAND_SMOKE")
	if len(smoke) > 0 {
		let seconds = mint.Atoi(smoke) catch _ {
			0
		}
		maxFrames = seconds * 100
	}
	mut frames = 0
	for appkit.IsOpen(win) && (maxFrames < 0 || frames < maxFrames) {
		let e = appkit.PollEvent(win)
		if e != 0 {
			appkit.Dispatch(win, e)
		}
		frames = frames + 1
	}
}
