package main

import "appkit"
import "mint"
import "quarry"
import "textedit"
import "twine"

// Tinland: a text editor written in Tin. With a path it opens that file; with TINLAND_SCRIPT set it runs the
// script without a window (see script.tin); with TINLAND_SMOKE=N the window closes itself after N seconds.
fn main() {
	mut ed = newEditor(textedit.New())
	let args = quarry.Args()
	mut a = 1
	for a < len(args) {
		ed.load(args[a])
		a += 1
	}
	let script = quarry.Getenv("TINLAND_SCRIPT")
	if len(script) > 0 {
		ed.Headless = true
		ed.Scale = 1.0
		ed.fontFor()
		runScript(mut ed, script)
		return
	}
	run(mut ed)
}

// pointToCell moves the caret to where the mouse is (x and y in points from the window's bottom left).
fn (ed mut Editor) mouseTo(x f64, y f64, extend bool) {
	let px = x * ed.Scale
	let py = ed.PtH * ed.Scale - y * ed.Scale
	mut row = ed.Scroll + i64((py - ed.LineH * 0.2 - ed.tabH()) / ed.LineH)
	if py < ed.LineH * 0.2 + ed.tabH() {
		row = ed.Scroll - 1
	}
	if row < 0 {
		row = 0
	}
	if row >= len(ed.Buf.Lines) {
		row = len(ed.Buf.Lines) - 1
	}
	mut dcol = ed.HScroll + i64((px - ed.gutterW()) / ed.CharW + 0.5)
	if dcol < 0 {
		dcol = 0
	}
	ed.Buf.MoveTo(row, textedit.ColForDisplay(ed.Buf.Lines[row], dcol, 4), extend)
	ed.Blink = true
	ed.Redraw = true
}

// handleEvent acts on one window event; the ones the editor does not use go to AppKit.
fn (ed mut Editor) handleEvent(e i64) {
	let t = appkit.EventType(e)
	if t == appkit.EventKeyDown {
		mut chars = appkit.EventChars(e)
		let flags = appkit.EventFlags(e)
		if (flags & flagCmd) != 0 {
			chars = twine.ToLower(chars)
		}
		ed.handleKey(Key{Code: appkit.EventKeyCode(e), Flags: flags, Chars: chars})
		return
	}
	if t == 1 || t == 6 {
		// left mouse down, dragged
		let (x, y) = appkit.EventLocation(e)
		if y < ed.PtH && ed.PtH * ed.Scale - y * ed.Scale < ed.tabH() {
			if t == 1 {
				ed.activate(ed.tabAt(x * ed.Scale))
			}
		} else if y < ed.PtH && t == 1 && ed.panelClick(ed.PtH * ed.Scale - y * ed.Scale) {
			// a click in the output panel: a compiler message opens its place
		} else if y < ed.PtH {
			ed.Mode = modeEdit
			let clicks = appkit.EventClicks(e)
			ed.mouseTo(x, y, t == 6 && ed.dragging)
			if t == 1 && clicks == 2 {
				ed.Buf.SelectWordAt(ed.Buf.Row, ed.Buf.Col)
			} else if t == 1 && clicks >= 3 {
				ed.Buf.MoveTo(ed.Buf.Row, 0, false)
				ed.Buf.MoveTo(ed.Buf.Row, len(ed.Buf.Lines[ed.Buf.Row]), true)
			}
			ed.dragging = true
		}
	} else if t == 2 {
		ed.dragging = false
	} else if t == 22 {
		ed.acc += appkit.EventScrollY(e)
		let step = ed.FontSize * 1.4
		let lines = i64(ed.acc / step)
		if lines != 0 {
			ed.acc -= f64(lines) * step
			ed.Scroll -= lines
			if ed.Scroll < 0 {
				ed.Scroll = 0
			}
			if ed.Scroll > len(ed.Buf.Lines) - 1 {
				ed.Scroll = len(ed.Buf.Lines) - 1
			}
			ed.Redraw = true
		}
		return
	}
	appkit.Dispatch(ed.Win, e)
}

// run opens the window and handles events until it is closed.
fn run(ed mut Editor) {
	let win = appkit.OpenWindow("Tinland", ed.PtW, ed.PtH)
	ed.Win = win
	ed.Scale = appkit.Scale(win)
	ed.fontFor()
	let menu = buildMenus(win)
	let smoke = quarry.Getenv("TINLAND_SMOKE")
	mut ticks = 0
	mut limitTicks = -1
	if len(smoke) > 0 {
		let seconds = mint.Atoi(smoke) catch _ {
			0
		}
		limitTicks = seconds * 2
	}
	for !ed.Quit && appkit.IsOpen(win) && (limitTicks < 0 || ticks < limitTicks) {
		let pool = appkit.PoolPush()
		mut e = appkit.WaitEvent(win, 0.5)
		if e == 0 {
			// nothing happened for half a second: blink the caret
			ed.Blink = !ed.Blink
			ed.Redraw = true
			ticks += 1
		}
		for e != 0 {
			ed.handleEvent(e)
			e = appkit.WaitEvent(win, 0.0)
		}
		mut cmd = appkit.NextCommand(menu)
		for cmd >= 0 {
			ed.perform(cmd)
			cmd = appkit.NextCommand(menu)
		}
		let (w, h) = appkit.ContentSize(win)
		if w > 0.0 && (w != ed.PtW || h != ed.PtH) {
			ed.PtW = w
			ed.PtH = h
			ed.Redraw = true
		}
		if ed.Redraw {
			ed.render()
			appkit.Present(win, ed.Bmp)
			ed.Redraw = false
			mut title = ed.name()
			if ed.Buf.Dirty {
				title = title + " (edited)"
			}
			if title != ed.Title {
				ed.Title = title
				appkit.SetTitle(win, title + " - Tinland")
			}
		}
		appkit.PoolPop(pool)
	}
}
