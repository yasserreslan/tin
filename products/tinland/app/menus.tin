package app

import "appkit"
import "../editor"
import "gpuwin"
import "../workspace"

// item adds a menu item: its title, the key shown beside it and its command (the tag OnCommand gets).
fn item(m appkit.Menu, menu i64, title str, key str, mods i64, cmd i64) {
	let (k, mo) = menuSettings.Binding(title, key, mods)
	appkit.AddItem(m, menu, title, k, mo, cmd)
}

// menuSettings holds the user's settings while the menus are built, for their key bindings.
mut menuSettings = DefaultSettings()

const cmd = appkit.ModCmd
const shift = appkit.ModShift
const alt = appkit.ModAlt
const ctrl = appkit.ModCtrl

// BuildMenus installs the menu bar, in the order and with the names Zed uses: the application, File, Edit, Selection, View, Go,
// Run, Window and Help.
fn BuildMenus(win gpuwin.Window, cfg Settings) appkit.Menu {
	menuSettings = keep(cfg)
	let m = gpuwin.NewMenuBar(win)
	let app = appkit.AddMenu(m, "Tinland")
	appkit.AddSystemItem(app, "About Tinland", "orderFrontStandardAboutPanel:", "", 0)
	appkit.AddSeparator(app)
	appkit.AddSystemItem(app, "Hide Tinland", "hide:", "h", cmd)
	appkit.AddSystemItem(app, "Hide Others", "hideOtherApplications:", "h", cmd | alt)
	appkit.AddSystemItem(app, "Show All", "unhideAllApplications:", "", 0)
	appkit.AddSeparator(app)
	item(m, app, "Settings...", ",", cmd, workspace.CmdOpenSettings)
	appkit.AddSeparator(app)
	item(m, app, "Quit Tinland", "q", cmd, editor.CmdQuit)

	let file = appkit.AddMenu(m, "File")
	item(m, file, "New", "n", cmd, editor.CmdNew)
	appkit.AddSeparator(file)
	item(m, file, "Open File...", "o", cmd, editor.CmdOpen)
	item(m, file, "Open Folder...", "o", cmd | shift, workspace.CmdOpenFolder)
	item(m, file, "Open Recent...", "e", cmd | shift, workspace.CmdOpenRecent)
	appkit.AddSeparator(file)
	item(m, file, "New File...", "n", cmd | alt, workspace.CmdNewFile)
	item(m, file, "New Folder...", "n", cmd | alt | shift, workspace.CmdNewFolder2)
	item(m, file, "Rename...", "", 0, workspace.CmdRename)
	item(m, file, "Delete", "", 0, workspace.CmdDelete)
	appkit.AddSeparator(file)
	item(m, file, "Save", "s", cmd, editor.CmdSave)
	item(m, file, "Save As...", "s", cmd | shift, editor.CmdSaveAs)
	item(m, file, "Revert File", "", 0, editor.CmdRevert)
	appkit.AddSeparator(file)
	item(m, file, "Close Tab", "w", cmd, editor.CmdClose)

	let edit = appkit.AddMenu(m, "Edit")
	item(m, edit, "Undo", "z", cmd, editor.CmdUndo)
	item(m, edit, "Redo", "z", cmd | shift, editor.CmdRedo)
	appkit.AddSeparator(edit)
	item(m, edit, "Cut", "x", cmd, editor.CmdCut)
	item(m, edit, "Copy", "c", cmd, editor.CmdCopy)
	item(m, edit, "Paste", "v", cmd, editor.CmdPaste)
	appkit.AddSeparator(edit)
	item(m, edit, "Find and Replace...", "f", cmd, editor.CmdFind)
	item(m, edit, "Find in Project", "f", cmd | shift, workspace.CmdSearch)
	item(m, edit, "Find Next", "g", cmd, editor.CmdFindNext)
	item(m, edit, "Find Previous", "g", cmd | shift, editor.CmdFindPrev)
	appkit.AddSeparator(edit)
	item(m, edit, "Toggle Comment", "/", cmd, editor.CmdComment)
	item(m, edit, "Sort Lines", "", 0, editor.CmdSortLines)
	item(m, edit, "Trim Trailing Whitespace", "", 0, editor.CmdTrimTrailing)
	item(m, edit, "Format Document", "i", cmd | shift, editor.CmdFormat)
	item(m, edit, "Join Lines", "", 0, editor.CmdJoinLines)
	item(m, edit, "Transform to Uppercase", "", 0, editor.CmdUppercase)
	item(m, edit, "Transform to Lowercase", "", 0, editor.CmdLowercase)
	appkit.AddSeparator(edit)
	item(m, edit, "Fold", "[", cmd | alt, editor.CmdFold)
	item(m, edit, "Unfold", "]", cmd | alt, editor.CmdUnfold)
	item(m, edit, "Unfold All", "", 0, editor.CmdUnfoldAll)

	let sel = appkit.AddMenu(m, "Selection")
	item(m, sel, "Add Cursor Below", "\xef\x9c\x81", cmd | alt, editor.CmdCursorBelow)
	item(m, sel, "Add Cursor Above", "\xef\x9c\x80", cmd | alt, editor.CmdCursorAbove)
	appkit.AddSeparator(sel)
	item(m, sel, "Select All", "a", cmd, editor.CmdSelectAll)
	appkit.AddSeparator(sel)
	item(m, sel, "Move Line Up", "\xef\x9c\x80", alt, editor.CmdMoveLineUp)
	item(m, sel, "Move Line Down", "\xef\x9c\x81", alt, editor.CmdMoveLineDown)
	item(m, sel, "Duplicate Line", "d", cmd, editor.CmdDuplicate)
	item(m, sel, "Delete Line", "k", cmd | shift, editor.CmdDeleteLine)
	item(m, sel, "Indent", "]", cmd, editor.CmdIndent)
	item(m, sel, "Unindent", "[", cmd, editor.CmdUnindent)

	let view = appkit.AddMenu(m, "View")
	item(m, view, "Command Palette...", "p", cmd | shift, workspace.CmdPalette)
	appkit.AddSeparator(view)
	item(m, view, "Zoom In", "=", cmd, workspace.CmdZoomIn)
	item(m, view, "Zoom Out", "-", cmd, workspace.CmdZoomOut)
	item(m, view, "Reset Zoom", "0", cmd, workspace.CmdZoomReset)
	item(m, view, "Toggle Whitespace", "", 0, workspace.CmdToggleWhitespace)
	item(m, view, "Toggle Word Wrap", "z", cmd | alt, editor.CmdToggleWrap)
	appkit.AddSeparator(view)
	item(m, view, "Split Right", "\\", cmd, workspace.CmdSplit)
	item(m, view, "Close Split", "\\", cmd | shift, workspace.CmdCloseSplit)
	appkit.AddSeparator(view)
	item(m, view, "Toggle Project Panel", "b", cmd, workspace.CmdToggleProject)
	item(m, view, "Toggle Outline Panel", "", 0, workspace.CmdToggleOutline)
	item(m, view, "Toggle Problems Panel", "", 0, workspace.CmdToggleProblems)
	item(m, view, "Toggle Git Panel", "", 0, workspace.CmdToggleGit)
	item(m, view, "Toggle Output Panel", "j", cmd, workspace.CmdToggleOutput)
	item(m, view, "Toggle Terminal", "`", ctrl, workspace.CmdToggleTerminal)
	item(m, view, "Reveal in Project Panel", "r", cmd | shift, workspace.CmdRevealInProject)
	appkit.AddSeparator(view)
	appkit.AddSystemItem(view, "Enter Full Screen", "toggleFullScreen:", "f", cmd | ctrl)

	let nav = appkit.AddMenu(m, "Go")
	item(m, nav, "Go to File...", "p", cmd, workspace.CmdQuickOpen)
	item(m, nav, "Go to Line...", "l", cmd, editor.CmdGoto)
	item(m, nav, "Jump to Matching Bracket", "\\", cmd | shift, editor.CmdJumpBracket)
	item(m, nav, "Go to Declaration", "b", cmd | shift, editor.CmdDefinition)
	appkit.AddItem(m, nav, "Back", "\xef\x9c\x82", cmd | alt, editor.CmdBack)
	appkit.AddItem(m, nav, "Quick Info", "q", ctrl, editor.CmdInfo)
	appkit.AddItem(m, nav, "Complete", " ", ctrl, editor.CmdComplete)

	let run = appkit.AddMenu(m, "Run")
	item(m, run, "Run File", "r", cmd, editor.CmdRun)

	let window = appkit.AddMenu(m, "Window")
	appkit.AddSystemItem(window, "Minimize", "performMiniaturize:", "m", cmd)
	appkit.AddSystemItem(window, "Zoom", "performZoom:", "", 0)
	appkit.SetWindowsMenu(win.Win, window)

	appkit.AddMenu(m, "Help")
	return m
}
