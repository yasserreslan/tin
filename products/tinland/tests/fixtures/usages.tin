package main

import "say"
import "twine"

// Speaker is what can speak.
shape Speaker {
	Speak() str
}

// Dog is a pet.
type Dog struct {
	Name str
}

fn (d Dog) Speak() str {
	return "woof " + d.Name
}

type Cat struct {
	Lives i64
}

fn (c Cat) Speak() str {
	return "meow"
}

fn talk[S Speaker](s S) str {
	return s.Speak()
}

fn main() {
	let d = Dog{Name: "rex"}
	let c = Cat{Lives: 9}
	say.Line(talk(d), talk(c), d.Name, d.Speak(), c.Lives)
	say.Line(twine.ToUpper(d.Name), "talk {d.Name}")
}
