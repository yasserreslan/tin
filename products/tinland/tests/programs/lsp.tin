package main

import "../../editor"
import "../../lsp"
import "../../theme"
import "../../workspace"
import "appkit"
import "quarry"
import "say"
import "textedit"
import "trail"

// A real language server: gopls, when it is installed, completes fmt.Pri in a Go file and reports a type error. Prints "no gopls"
// first on a machine without it.
fn main() {
	let argv = lsp.ServerFor("go")
	if len(argv) == 0 {
		say.Line("no gopls: skipped")
		return
	}
	let root = trail.Clean(quarry.TempDir() + "/tinland_lsp_test")
	quarry.RemoveAll(root) catch _ {
	}
	quarry.MkdirAll(root) catch _ {
	}
	quarry.WriteFile(root + "/go.mod", "module example.com/t\n\ngo 1.21\n") catch _ {
	}
	let text = `package main

import "fmt"

func main() {
	fmt.Pri
	var x int = "s"
}
`
	quarry.WriteFile(root + "/main.go", text) catch _ {
	}
	mut c = lsp.Start("t", argv, root)
	mut waited = 0
	for !c.Ready && !c.Failed && waited < 300 {
		appkit.RunCapture("sleep 0.1")
		c.Poll()
		waited += 1
	}
	say.Line("ready", c.Ready)
	c.Sync(root + "/main.go", "go", text, 1)
	c.Complete(root + "/main.go", 5, 8)
	waited = 0
	for !c.Answered && waited < 300 {
		appkit.RunCapture("sleep 0.1")
		c.Poll()
		waited += 1
	}
	mut found = false
	for it in c.Items {
		if it.Label == "Println" {
			found = true
		}
	}
	say.Line("completion has Println", found, len(c.Items) >= 3)
	waited = 0
	for len(c.Diags) == 0 && waited < 100 {
		appkit.RunCapture("sleep 0.1")
		c.Poll()
		waited += 1
	}
	say.Line("diagnostics", len(c.Diags) > 0)
	c.Stop()
	// the same through the workspace: opening the file, the caret after the dot, Ctrl+Space
	mut ws = workspace.New(theme.Dark(), editor.New(textedit.New()))
	ws.OpenFolder(root)
	ws.OpenFile(root + "/main.go")
	ws.Ed.Buf.MoveTo(5, 8, false)
	waited = 0
	for waited < 300 && !(len(ws.Lsps) > 0 && ws.Lsps[0].Ready) {
		appkit.RunCapture("sleep 0.1")
		ws.Prepare()
		ws.PollLsp()
		waited += 1
	}
	say.Line("workspace server ready", len(ws.Lsps) > 0 && ws.Lsps[0].Ready)
	say.Line("asked", ws.LspComplete())
	waited = 0
	for waited < 300 && !ws.Ed.CompOpen {
		appkit.RunCapture("sleep 0.1")
		ws.PollLsp()
		waited += 1
	}
	mut has = false
	for it in ws.Ed.Comp {
		if it.Label == "Println" {
			has = true
		}
	}
	say.Line("list open", ws.Ed.CompOpen, has)
	waited = 0
	for waited < 100 && len(ws.Ed.Diags) == 0 {
		appkit.RunCapture("sleep 0.1")
		ws.Prepare()
		ws.PollLsp()
		waited += 1
	}
	say.Line("editor shows problems", len(ws.Ed.Diags) > 0)
	ws.StopLsp()
	quarry.RemoveAll(root) catch _ {
	}
}
