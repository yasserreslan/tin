package main

import "../../editor"
import "../../project"
import "../../theme"
import "../../workspace"
import "quarry"
import "appkit"
import "say"
import "twine"
import "textedit"
import "trail"

fn put(path str, text str) {
	quarry.WriteFile(path, text) catch _ {
		say.Line("cannot write", path)
	}
}

fn key(ws mut workspace.Workspace, code i64, chars str) {
	ws.PickerKey(code, 0, chars)
}

fn PickRecentForTest() i64 {
	return workspace.PickRecent
}

fn typeText(ws mut workspace.Workspace, text str) {
	for i in 0..len(text) {
		key(mut ws, -1, text[i:i + 1])
	}
}

// screenHas reports whether any row of the terminal screen holds the text.
fn screenHas(ws workspace.Workspace, text str) bool {
	for y in 0..ws.Term.Rows {
		if twine.Contains(ws.Term.Text(y), text) {
			return true
		}
	}
	return false
}

// The workspace without a window: the picker, the project search and the file operations.
fn main() {
	let root = trail.Clean(quarry.TempDir() + "/tinland_ws_test")
	quarry.RemoveAll(root) catch _ {
	}
	quarry.MkdirAll(root + "/src") catch _ {
	}
	put(root + "/main.tin", `package main
fn main() {}
`)
	put(root + "/src/util.tin", `fn helper() {}
fn main2() {}
`)
	put(root + "/notes.md", "main notes\n")
	mut ws = workspace.New(theme.Dark(), editor.New(textedit.New()))
	ws.Ed.Headless = true
	say.Line("opened", ws.OpenFolder(root))
	// go to file: type, narrow, choose
	ws.OpenPicker(workspace.PickFile)
	say.Line("picker", ws.Picker.Open, len(ws.Picker.Items))
	typeText(mut ws, "util")
	say.Line("filtered", ws.Picker.Items)
	key(mut ws, 36, "")
	say.Line("opened file", ws.Ed.Name(), ws.Picker.Open, ws.Focus)
	// the palette
	ws.OpenPicker(workspace.PickCommand)
	typeText(mut ws, "toggle proj")
	say.Line("palette", ws.Picker.Items)
	say.Line("panel open before", ws.LeftOpen)
	key(mut ws, 36, "")
	say.Line("panel open after", ws.LeftOpen)
	// escape closes
	ws.OpenPicker(workspace.PickFile)
	key(mut ws, 53, "")
	say.Line("closed", ws.Picker.Open)
	// project search
	ws.Search.Query = "main"
	ws.RunSearch()
	say.Line(ws.Search.Summary())
	ws.OpenMatch(0)
	say.Line("match opened", ws.Ed.Name(), ws.Ed.Buf.Row, ws.Ed.Buf.Col, ws.Ed.Buf.SelectedText())
	ws.Search.Regex = true
	ws.Search.Query = "fn (\\w+)\\("
	ws.RunSearch()
	say.Line(ws.Search.Summary())
	ws.Search.Query = "("
	ws.RunSearch()
	say.Line(ws.Search.Summary())
	// new file, rename, delete
	ws.Proj.Select(0)
	ws.OpenPicker(workspace.PickNewFile)
	typeText(mut ws, "fresh.tin")
	key(mut ws, 36, "")
	say.Line("created", quarry.Exists(root + "/fresh.tin"), ws.Ed.Name())
	ws.OpenPicker(workspace.PickRename)
	say.Line("rename starts with", ws.Picker.Query)
	key(mut ws, 53, "")
	// split panes
	ws.OpenFile(root + "/main.tin")
	ws.Split()
	say.Line("split", len(ws.Panes), ws.Active, ws.Ed.Name())
	ws.OpenFile(root + "/notes.md")
	say.Line("right pane", ws.Panes[1].Name(), "left pane", ws.Panes[0].Name())
	ws.SetActive(0)
	say.Line("active", ws.Ed.Name())
	ws.Split()
	ws.Split()
	ws.Split()
	ws.Split()
	say.Line("panes", len(ws.Panes), ws.Active)
	ws.CloseSplit()
	ws.CloseSplit()
	ws.CloseSplit()
	say.Line("closed splits", len(ws.Panes), ws.Active)
	ws.SetActive(0)
	ws.CloseSplit()
	say.Line("closed split", len(ws.Panes), ws.Active)
	// keyboard in the project panel
	ws.Focus = workspace.FocusProject
	ws.Proj.Select(0)
	ws.Key(126, 0, "")
	ws.Key(125, 0, "")
	ws.Key(125, 0, "")
	say.Line("selected", ws.Proj.Entries[ws.Proj.Selected].Name)
	ws.Key(36, 0, "")
	say.Line("opened by Return", ws.Ed.Name(), ws.Focus)
	// replace in the project
	put(root + "/r.txt", "foo bar foo\nfoo\n")
	ws.Search.Regex = false
	ws.Search.Query = "foo"
	ws.RunSearch()
	ws.Search.Replace = "baz"
	ws.ReplaceAll()
	let replaced = quarry.ReadFile(root + "/r.txt") catch _ {
		"unreadable"
	}
	say.Line("replaced", ws.Search.Replaced, replaced == "baz bar baz\nbaz\n", ws.Search.Summary())
	// a file changed by another program is read again
	ws.OpenFile(root + "/notes.md")
	ws.CheckDisk()
	put(root + "/notes.md", "rewritten elsewhere\n")
	appkit.RunCapture("touch -t 203001010000 '" + root + "/notes.md'")
	ws.CheckDisk()
	say.Line("reloaded", ws.Ed.Name(), ws.Ed.Buf.Lines[0])
	// a binary file is not opened
	put(root + "/blob.bin", "ab\x00cd")
	let before = ws.Ed.Name()
	ws.OpenFile(root + "/blob.bin")
	say.Line("binary", ws.Ed.Name() == before, twine.HasPrefix(ws.Ed.Message, "binary file"))
	// git: the marks in the gutter and the panel's list of changed files
	appkit.RunCapture("git -C '" + root + "' init -q && git -C '" + root + "' add -A && git -C '" + root + "' -c user.email=t@t -c user.name=t commit -qm first")
	put(root + "/main.tin", `package changed
fn main() {}
added
`)
	ws.OpenFile(root + "/main.tin")
	ws.RefreshMarks()
	say.Line("marks", ws.Ed.Marks)
	ws.RefreshGit()
	say.Line("git", ws.Git)
	// the session: the folder and open files come back in a new workspace
	quarry.Setenv("HOME", root) catch _ {
	}
	ws.OpenFile(root + "/notes.md")
	ws.SaveSession()
	mut again = workspace.New(theme.Dark(), editor.New(textedit.New()))
	say.Line("restored", again.RestoreSession(), again.HasProj, again.Ed.Name(), len(again.Panes[0].Tabs))
	// the terminal: a shell on a pseudo terminal, its output in the screen
	quarry.Setenv("SHELL", "/bin/sh") catch _ {
	}
	// recent files: newest first, once each, kept in a file and read back (a file that is gone is left out)
	ws.RecentPath = root + "/recent.list"
	ws.OpenFile(root + "/main.tin")
	ws.OpenFile(root + "/notes.md")
	ws.OpenFile(root + "/main.tin")
	say.Line("recent", len(ws.Recent) > 0, ws.Recent[0] == root + "/main.tin", ws.Recent[1] == root + "/notes.md")
	let recentCount = len(ws.Recent)
	ws.Recent = []str{}
	ws.LoadRecent(root + "/recent.list")
	say.Line("recent read back", len(ws.Recent) == recentCount, ws.Recent[0] == root + "/main.tin")
	ws.OpenPicker(PickRecentForTest())
	typeText(mut ws, "notes")
	say.Line("recent picker", ws.Picker.Kind, len(ws.Picker.Items), twine.HasSuffix(ws.Picker.Items[0], "/notes.md"))
	ws.ClosePicker()
	// auto-save: a file with changes is written, a tab without a name is not
	ws.OpenFile(root + "/notes.md")
	ws.Ed.Buf.MoveTo(0, 0, false)
	ws.Ed.KeyDown(-1, 0, "A")
	say.Line("dirty before", ws.Ed.Buf.Dirty)
	let written = ws.Ed.SaveDirty()
	let onDisk = quarry.ReadFile(root + "/notes.md") catch _ {
		"?"
	}
	say.Line("auto-saved", written, ws.Ed.Buf.Dirty, twine.TrimSpace(onDisk))
	say.Line("nothing left", ws.Ed.SaveDirty())
	ws.ToggleTerminal()
	say.Line("shell running", ws.TermUp, ws.Bottom, ws.Focus)
	appkit.RunCapture("sleep 0.5")
	ws.PollTerminal()
	ws.Pty.Type("echo pty-ok-$((20+22))\n")
	mut found = false
	for i in 0..60 {
		if !found {
			appkit.RunCapture("sleep 0.05")
			ws.PollTerminal()
			found = screenHas(ws, "pty-ok-42")
		}
	}
	say.Line("terminal output seen", found)
	// select the output line and read it back
	for y in 0..ws.Term.Rows {
		if ws.Term.Text(y) == "pty-ok-42" {
			ws.TermSel = true
			ws.SelCol0 = 0
			ws.SelLine0 = ws.Term.HistoryLines() + y
			ws.SelCol1 = 8
			ws.SelLine1 = ws.SelLine0
		}
	}
	say.Line("terminal selection", ws.TermSelectedText())
	ws.StopTerminal()
	say.Line("shell stopped", ws.TermUp)
	quarry.RemoveAll(root) catch _ {
	}
}
