package main

import "../../language"
import "appkit"
import "quarry"
import "say"
import "trail"
import "twine"

fn put(path str, text str) {
	quarry.WriteFile(path, text) catch _ {
		say.Line("cannot write", path)
	}
	quarry.Chmod(path, 0o755) catch _ {
	}
}

fn setenv(key str, value str) {
	quarry.Setenv(key, value) catch _ {
		say.Line("cannot set", key)
	}
}

// run is what a shell prints for the command, with PATH as Setup left it, the test's folder written ROOT.
fn run(root str, command str) str {
	let (_, out) = appkit.RunCapture(command)
	return twine.ReplaceAll(twine.TrimSpace(out), root, "ROOT")
}

// Finding the toolchain without a window: a project that is a Tin tree comes first, its tin and tinc are linked into a folder
// put first in PATH, and its tit is built from its source on first use; in a folder that is not a tree, tit comes from PATH.
fn main() {
	let root = trail.Clean(quarry.TempDir() + "/tinland_tools_test")
	quarry.RemoveAll(root) catch _ {
	}
	for d in []str{"/tree/bin", "/tree/products/tit", "/other/bin"} {
		quarry.MkdirAll(root + d) catch _ {
		}
	}
	put(root + "/tree/tin", "#!/bin/sh\necho tree tin \"$@\"\n")
	// a stand-in compiler: the program it writes says what it was asked
	put(root + "/tree/bin/tinc", "#!/bin/sh\nprintf '#!/bin/sh\\necho built tit \"$@\"\\n' > \"$2\"\nchmod +x \"$2\"\n")
	put(root + "/tree/products/tit/main.tin", "package main\n")
	put(root + "/other/bin/tit", "#!/bin/sh\necho installed tit\n")
	// nothing of the machine's own: no other tree on the PATH, in $TIN_ROOT or in ~/.tin
	setenv("PATH", root + "/other/bin:/usr/bin:/bin")
	setenv("HOME", root)
	quarry.Unsetenv("TIN_ROOT") catch _ {
	}
	quarry.Unsetenv("TINLAND_TINC") catch _ {
	}
	let t = language.Setup(root + "/tree")
	say.Line("root is the project:", t.Root == root + "/tree", "compiler:", language.CompilerPath() == root + "/tree/bin/tinc")
	say.Line("first in PATH:", quarry.Getenv("PATH") == t.Bin + ":" + root + "/other/bin:/usr/bin:/bin")
	say.Line(run(root, "tin build x.tin"))
	say.Line(run(root, "tit status"))
	say.Line(run(root, "tit log"))
	say.Line("built in the tree:", quarry.Exists(root + "/tree/bin/tit"), t.Tit == root + "/tree/bin/tit")

	let u = language.Setup(root + "/other")
	say.Line("no tree:", len(u.Root) == 0, "same folder:", u.Bin == t.Bin, "tit from PATH:", u.Tit == root + "/other/bin/tit")
	say.Line(run(root, "tit"))
	say.Line("in PATH once:", quarry.Getenv("PATH") == u.Bin + ":" + root + "/other/bin:/usr/bin:/bin", "no tin:", !quarry.Exists(u.Bin + "/tin"))
	language.Cleanup()
	say.Line("removed:", !quarry.Exists(u.Bin))
	quarry.RemoveAll(root) catch _ {
	}
}
