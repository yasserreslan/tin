package language

import "appkit"
import "quarry"
import "trail"
import "twine"

// Finding the Tin toolchain. Tinland opened from the Finder, the Dock or `open -a` gets the PATH launchd gives every application
// (/usr/bin:/bin:/usr/sbin:/sbin), not the one the user's shell builds, so tin, tinc and tit are often nowhere on it. Setup finds
// them, links them into a folder of Tinland's own and puts that folder first in PATH: the terminal's shell, Run and Build, the
// error checks and the language servers all inherit it, and all use the same toolchain.

// Tools is what Setup found.
type Tools struct {
	// Root is the Tin tree: Root/tin is the tin command and Root/bin/tinc the compiler ("" when there is none).
	Root str
	// Tit is what the tit command runs: an installed tit, or Root/bin/tit built from Root's source ("" when there is neither).
	Tit str
	// Bin is the folder of links to them that is first in PATH ("" before Setup or when it could not be made).
	Bin str
}

mut tools = Tools{}
mut askedShell = false

// Found is what the last Setup found.
fn Found() Tools {
	return tools
}

// Setup finds the toolchain for the project folder (the folder itself when it is a Tin tree; "" for none), points Tinland's
// folder of links at it and puts the folder first in PATH. The application calls it at start and when another folder opens.
fn Setup(project str) Tools {
	if !askedShell {
		askedShell = true
		// a shell sets SHLVL: without it Tinland was not started from one, and the user's PATH is the one the login shell makes
		if len(quarry.Getenv("SHLVL")) == 0 {
			let p = loginPath()
			if len(p) > 0 {
				quarry.Setenv("PATH", p) catch _ {
				}
			}
		}
	}
	let path = withoutDir(quarry.Getenv("PATH"), tools.Bin)
	let root = findRoot(project, path)
	mut bin = tools.Bin
	if len(bin) == 0 {
		bin = appkit.PrivateDir("tinland-tools")
	}
	if len(bin) == 0 {
		tools = keep(Tools{Root: root})
		return tools
	}
	mut tit = ""
	if len(root) > 0 {
		link(bin + "/tin", root + "/tin")
		link(bin + "/tinc", root + "/bin/tinc")
	} else {
		unlink(bin + "/tin")
		unlink(bin + "/tinc")
	}
	if len(root) > 0 && quarry.Exists(root + "/products/tit/main.tin") {
		// the tree has tit's source: a script that builds it there on first use, and again after its source changes
		unlink(bin + "/tit")
		quarry.WriteFile(bin + "/tit", titScript(root)) catch _ {
		}
		quarry.Chmod(bin + "/tit", 0o755) catch _ {
		}
		tit = root + "/bin/tit"
	} else {
		tit = lookPath("tit", path)
		if len(tit) == 0 && executable(quarry.Getenv("HOME") + "/.tin/bin/tit") {
			tit = quarry.Getenv("HOME") + "/.tin/bin/tit"
		}
		if len(tit) > 0 {
			link(bin + "/tit", resolved(tit))
		} else {
			unlink(bin + "/tit")
		}
	}
	quarry.Setenv("PATH", bin + ":" + path) catch _ {
	}
	tools = keep(Tools{Root: root, Tit: tit, Bin: bin})
	return tools
}

// Cleanup removes Tinland's folder of links (when the window closes).
fn Cleanup() {
	if len(tools.Bin) > 0 {
		quarry.RemoveAll(tools.Bin) catch _ {
		}
	}
}

// titScript is a tit command for the Tin tree at root: it builds root/bin/tit from root/products/tit the first time, and again
// when the compiler or a source file it may read is newer than it, then runs it.
fn titScript(root str) str {
	return `#!/bin/sh
# tit from the Tin tree below, built the first time it is used and again when the compiler or its source changed (Tinland).
root=` + Quoted(root) + `
out=$root/bin/tit
if [ ! -x "$out" ] || [ "$root/bin/tinc" -nt "$out" ] || [ -n "$(find "$root/products/tit" "$root/packages" "$root/toolchain/std" "$root/toolchain/runtime" -name '*.tin' -newer "$out" 2>/dev/null | head -n 1)" ]; then
	echo "tit: building $out" >&2
	TIN_POOL_WARN_MB=0 "$root/bin/tinc" -o "$out.new" "$root/products/tit/main.tin" >&2 && mv -f "$out.new" "$out" || exit 1
fi
exec "$out" "$@"
`
}

// loginPath is the PATH the user's login shell sets up ("" when it could not be asked): what a terminal would have.
fn loginPath() str {
	mut shell = quarry.Getenv("SHELL")
	if len(shell) == 0 {
		shell = "/bin/zsh"
	}
	let mark = "__tinland_path__"
	let (code, out) = captureFor(5, []str{shell, "-l", "-i", "-c", "printf '\\n" + mark + "%s\\n' \"$PATH\""})
	let at = twine.LastIndex(out, mark)
	if code != 0 || at < 0 {
		return ""
	}
	mut rest = out[at + len(mark):]
	let nl = twine.Index(rest, "\n")
	if nl >= 0 {
		rest = rest[:nl]
	}
	return twine.TrimSpace(rest)
}

// findRoot is the Tin tree to use, the first of: the one $TINLAND_TINC belongs to, the project folder, $TIN_ROOT, the trees of
// the tin and the tinc in path, the one installed in ~/.tin, and the tree Tinland itself was built in.
fn findRoot(project str, path str) str {
	mut dirs = []str{TinRoot(quarry.Getenv("TINLAND_TINC")), project, quarry.Getenv("TIN_ROOT")}
	let tin = lookPath("tin", path)
	if len(tin) > 0 {
		dirs = append(dirs, trail.Dir(resolved(tin)))
	}
	let tinc = lookPath("tinc", path)
	if len(tinc) > 0 {
		dirs = append(dirs, TinRoot(resolved(tinc)))
	}
	dirs = append(dirs, trail.Dir(resolved(quarry.Getenv("HOME") + "/.tin/bin/tin")))
	// <tree>/tinland, or <tree>/bin/Tinland.app/Contents/MacOS/Tinland
	let args = quarry.Args()
	if len(args) > 0 && len(args[0]) > 0 {
		mut self = args[0]
		if !trail.IsAbs(self) {
			let wd = quarry.Getwd() catch _ {
				""
			}
			self = wd + "/" + self
		}
		self = resolved(trail.Clean(self))
		for up in 0..5 {
			self = trail.Dir(self)
			dirs = append(dirs, self)
		}
	}
	for d in dirs {
		if isTree(d) {
			return d
		}
	}
	return ""
}

// isTree reports whether dir holds a Tin toolchain: the tin command and a built compiler.
fn isTree(dir str) bool {
	return len(dir) > 1 && executable(dir + "/tin") && executable(dir + "/bin/tinc")
}

// executable reports whether path is a file someone may run.
fn executable(path str) bool {
	let info = quarry.Stat(path) catch _ {
		return false
	}
	return info.Type == quarry.FileType.Regular && (info.Perm & 0o111) != 0
}

// lookPath is the first program named name in the folders of path (a PATH value), or "".
fn lookPath(name str, path str) str {
	for dir in twine.Split(path, ":") {
		if len(dir) > 0 && executable(dir + "/" + name) {
			return dir + "/" + name
		}
	}
	return ""
}

// withoutDir is path (a PATH value) without the folder dir.
fn withoutDir(path str, dir str) str {
	if len(dir) == 0 {
		return path
	}
	mut keepDirs = []str{}
	for d in twine.Split(path, ":") {
		if d != dir {
			keepDirs = append(keepDirs, d)
		}
	}
	return twine.Join(keepDirs, ":")
}

// resolved follows path's symbolic links to the file they end at (path itself when it is not one).
fn resolved(path str) str {
	mut p = path
	for hop in 0..16 {
		let info = quarry.Lstat(p) catch _ {
			return p
		}
		if info.Type != quarry.FileType.Symlink {
			return p
		}
		let target = quarry.Readlink(p) catch _ {
			return p
		}
		if trail.IsAbs(target) {
			p = target
		} else {
			p = trail.Clean(trail.Dir(p) + "/" + target)
		}
	}
	return p
}

// link makes at a symbolic link to target, replacing what was there.
fn link(at str, target str) {
	unlink(at)
	quarry.Symlink(target, at) catch _ {
	}
}

fn unlink(at str) {
	quarry.Remove(at) catch _ {
	}
}
