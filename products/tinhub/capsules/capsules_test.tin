package capsules

import "../../tit/transport"
import "../accounts"
import "../db"
import "../events"
import "../packs"
import "anvil"
import "argo"
import "crucible"
import "fault"
import "mint"
import "postgres"
import "quarry"
import "replay"
import "seal"
import "tide"

// Tests for the replay store (#1022) against Postgres (TINHUB_TEST_DB): tit's server taking version 2 capsules into
// it (an upload of 1,000 interrupted and resumed), failure groups closing and reopening, retention and deletion, and
// the replay permission over the protocol and the API.

fn testDb(t mut crucible.T) ?postgres.Client {
	let (o, ok) = db.TestOptions()
	if !ok {
		t.Log("TINHUB_TEST_DB is not set: skipped")
		return nil
	}
	let c = db.Open(o)
	db.ResetForTests(c) catch err {
		t.Error("reset: {err}")
		return nil
	}
	_ = db.Migrate(c) catch err {
		t.Error("migrate: {err}")
		return nil
	}
	return c
}

// testAuth is the API's caller in tests: the user id in X-Test-User, 0 for none.
fn testAuth(q anvil.Req) !i64 {
	let h = q.Header("x-test-user")
	if len(h) == 0 {
		return 0
	}
	return try mint.Atoi(h)
}

// setup configures this core over c and a fresh directory store; the store's root.
fn setup(c postgres.Client) !str {
	let dir = "/tmp/tin-test-tinhub-capsules-" + seal.Hex(seal.RandomBytes(4))
	let s = try packs.NewDirStore(dir + "/store")
	let st dyn packs.PackStore = s
	Configure(Deps{Db: c, Store: st, Dir: dir, Auth: testAuth})
	return dir
}

// newRepo makes owner's user (when new) and a repository of theirs.
fn newRepo(c postgres.Client, owner str, visibility str) !accounts.Repo {
	let o = try c.Query("INSERT INTO owners (name, kind) VALUES ({owner}, 'user') RETURNING id")
	let ownerId = o.Rows[0][0].Int()
	let email = owner + "@example.com"
	_ = try c.Exec("INSERT INTO users (owner_id, email) VALUES ({ownerId}, {email})")
	let r = try c.Query("INSERT INTO repos (owner_id, name, visibility, quota_bytes) VALUES ({ownerId}, 'shop', {visibility}, 1000000000) RETURNING id")
	return accounts.Repo{Id: r.Rows[0][0].Int(), OwnerId: ownerId, Owner: owner, Name: "shop", Visibility: visibility, DefaultBranch: "main", QuotaBytes: 1000000000, SizeBytes: 0}
}

// newUser makes a user; its id.
fn newUser(c postgres.Client, name str) !i64 {
	let o = try c.Query("INSERT INTO owners (name, kind) VALUES ({name}, 'user') RETURNING id")
	let ownerId = o.Rows[0][0].Int()
	let email = name + "@example.com"
	let u = try c.Query("INSERT INTO users (owner_id, email) VALUES ({ownerId}, {email}) RETURNING id")
	return u.Rows[0][0].Int()
}

// maker seals version 2 capsules as a recording server does: for one reader, signed with the server's key.
type maker struct {
	readers []replay.Recipient
	ks      str
	seed    str
}

fn newMaker() !maker {
	let (_, pub) = try replay.NewIdentity()
	let readers = try replay.ParseRecipients(pub)
	return maker{readers: readers, ks: str(seal.RandomBytes(32)), seed: str(seal.RandomBytes(32))}
}

fn (m maker) capsule(summary str, body str) !str {
	return try replay.SealV2(body, m.ks, summary, m.readers, m.seed)
}

// client signs replay requests to one tit server, as a user with one key.
type client struct {
	srv   transport.Server
	email str
	seed  []u8
	nonce str
}

// newClient is a server over the repository's capsules for user holding role, and a client signing as them.
fn newClient(r accounts.Repo, user i64, role i64, email str) !client {
	let mem = try transport.NewMemRepo("/tmp/tin-test-tinhub-capsules-mem-" + seal.Hex(seal.RandomBytes(4)))
	let repo dyn transport.Repo = mem
	mut srv = transport.NewRepoServer(repo, "test-nonce-key", false)
	let seed = seal.RandomBytes(32)
	let pub = try seal.Ed25519PublicKey(seed)
	srv.Allow(email, pub)
	srv.SetReplays(StoreFor(r, user, role))
	return client{srv: srv, email: email, seed: seed, nonce: ""}
}

fn now() i64 {
	return tide.Wall() / tide.Second
}

// call sends a signed request, taking a nonce from the server's challenge first.
fn (c mut client) call(method str, path str, body str) !transport.Reply {
	if len(c.nonce) == 0 {
		let r = c.srv.Handle("GET", "/ada/shop/tit/v1/replay", "", "", now())
		let a = try errorOf(r)
		c.nonce = a.Nonce
	}
	let sig = try seal.SignEd25519(c.seed, []u8(transport.SigningPayload(method, path, c.nonce, body)))
	return c.srv.Handle(method, path, transport.SignatureHeader(c.email, c.nonce, sig), body, now())
}

fn errorOf(r transport.Reply) !transport.ErrorAnswer {
	let (_, header, _) = try transport.ReadFrame(r.Body)
	mut a = transport.ErrorAnswer{Code: "", Message: "", Ref: "", Nonce: ""}
	try argo.Get(header, mut a)
	return a
}

const path = "/ada/shop/tit/v1/replay"

// push sends one capsule; the answer, or the refusal's code and message as a fault.
fn (c mut client) push(commit str, name str, data str) !transport.ReplayAnswer {
	let r = try c.call("POST", path, transport.Frame(transport.Kind.ReplayPush, transport.Encode(transport.ReplayPushHeader{Commit: commit, Name: name}), data))
	if r.Status != 200 {
		let a = try errorOf(r)
		fail "{r.Status} {a.Code}: {a.Message}"
	}
	let (_, header, _) = try transport.ReadFrame(r.Body)
	mut a = transport.ReplayAnswer{Id: "", Group: "", New: false}
	try argo.Get(header, mut a)
	return a
}

// prime takes the nonce the client signs with from the server's challenge.
fn (c mut client) prime() ! {
	let r = c.srv.Handle("GET", path, "", "", now())
	let a = try errorOf(r)
	c.nonce = a.Nonce
}

// pushed is push as a number: 1 a new capsule with the id of its bytes, 0 one stored already, -1 a refusal.
fn (c mut client) pushed(commit str, name str, data str) i64 {
	let a = c.push(commit, name, data) catch _ {
		return -1
	}
	if a.Id != idOf(data) {
		return -1
	}
	if a.New {
		return 1
	}
	return 0
}

fn (c mut client) list() ![]transport.ReplayEntry {
	let r = try c.call("GET", path, "")
	if r.Status != 200 {
		let a = try errorOf(r)
		fail "{r.Status} {a.Code}: {a.Message}"
	}
	let (_, header, _) = try transport.ReadFrame(r.Body)
	mut l = transport.ReplayList{Capsules: []transport.ReplayEntry{}}
	try argo.Get(header, mut l)
	return l.Capsules
}

fn (c mut client) get(id str) !str {
	let r = try c.call("GET", path + "/" + id, "")
	if r.Status != 200 {
		let a = try errorOf(r)
		fail "{r.Status} {a.Code}: {a.Message}"
	}
	let (_, _, data) = try transport.ReadFrame(r.Body)
	return data
}

fn summary(status i64, method str, p str, panicText str) str {
	mut s = "status={status}\nmethod={method}\npath={p}\n"
	if len(panicText) > 0 {
		s = s + "panic=" + panicText + "\n"
	}
	return s
}

fn idOf(data str) str {
	return seal.Hex(seal.Sha256(data))
}

fn count(c postgres.Client, q query) i64 {
	let rows = c.Query(q) catch _ {
		return -1
	}
	return rows.Rows[0][0].Int()
}

const commitA = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

// An upload of 1,000 capsules is interrupted after 600, with the 601st's bytes in the store and no row yet (a crash
// between them), then runs again from where it was (tit replay push resends what the spool still holds, the capsule
// in flight included): every capsule is stored once, the store holds 1,000 files, and the groups count each once.
fn TestUploadResumes(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	let c = got
	let (_, serr) = setup(c)
	t.NoFault("setup", serr)
	let (r, rerr) = newRepo(c, "ada", "private")
	t.NoFault("repo", rerr)
	let (ada, uerr) = newUser(c, "ada-ci")
	t.NoFault("user", uerr)
	let (m, merr) = newMaker()
	t.NoFault("maker", merr)
	mut caps = []str{}
	for i in 0..1000 {
		let data = m.capsule(summary(500, "POST", "/checkout/{i % 10}", ""), "request {i}") catch err {
			t.Error("seal: {err}")
			return
		}
		caps = append(caps, data)
	}
	let (cl, cerr) = newClient(r, ada, accounts.RoleWrite, "ada-ci@example.com")
	t.NoFault("client", cerr)
	mut cli = cl
	t.NoFault("a nonce", cli.prime())
	mut fresh = 0
	for i in 0..600 {
		if cli.pushed(commitA, "{i}.tcap", caps[i]) == 1 {
			fresh += 1
		}
	}
	crucible.Equal(mut t, "new before the interruption", fresh, 600)
	// the interruption: the 601st capsule's bytes stored, its row never written
	let d = depsOf() catch _ {
		return
	}
	t.NoFault("the bytes of the capsule in flight", putFile(d, r.Id, idOf(caps[600]), caps[600]))
	crucible.Equal(mut t, "rows after the interruption", count(c, "SELECT count(*) FROM capsules"), 600)
	// resumed: the last ten sent again (their spool files were not removed yet) and everything after
	fresh = 0
	mut again = 0
	for i in 590..1000 {
		let k = cli.pushed(commitA, "{i}.tcap", caps[i])
		if k == 1 {
			fresh += 1
		} else if k == 0 {
			again += 1
		}
	}
	crucible.Equal(mut t, "new after resuming", fresh, 400)
	crucible.Equal(mut t, "sent again, not new", again, 10)
	crucible.Equal(mut t, "rows", count(c, "SELECT count(*) FROM capsules"), 1000)
	crucible.Equal(mut t, "distinct ids", count(c, "SELECT count(DISTINCT id) FROM capsules"), 1000)
	crucible.Equal(mut t, "groups", count(c, "SELECT count(*) FROM replay_groups"), 10)
	crucible.Equal(mut t, "counted once each", count(c, "SELECT sum(count)::bigint FROM replay_groups"), 1000)
	mut st = storeOf() catch _ {
		return
	}
	let keys = st.List("repos/{r.Id}/capsules/") catch err {
		t.Error("list: {err}")
		return
	}
	crucible.Equal(mut t, "files in the store", len(keys), 1000)
	// a writer cannot read them back; an admin lists them all and gets a capsule byte for byte
	let (_, werr) = cli.list()
	t.HasFault("a writer lists", werr)
	let (ac, aerr) = newClient(r, ada, accounts.RoleAdmin, "ada-ci@example.com")
	t.NoFault("admin client", aerr)
	mut admin = ac
	let all = admin.list() catch err {
		t.Error("list: {err}")
		return
	}
	crucible.Equal(mut t, "listed", len(all), 1000)
	let back = admin.get(idOf(caps[600])) catch err {
		t.Error("get: {err}")
		return
	}
	t.True("the capsule in flight comes back whole", back == caps[600])
}

// exec runs a statement; false on a fault.
fn exec(c postgres.Client, q query) bool {
	let (_, err) = c.Exec(q)
	return err == nil
}

// groupState is a group's state, the change that is to fix it, the change it reopened against, its count and its
// declaration.
fn groupState(c postgres.Client, repoId i64, id str) (str, str, str, i64, str) {
	let rows = c.Query("SELECT state, fixed_by, reopened_by, count, decl FROM replay_groups WHERE repo_id = {repoId} AND id = {id}") catch _ {
		return "error", "", "", 0, ""
	}
	if len(rows.Rows) == 0 {
		return "none", "", "", 0, ""
	}
	let r = rows.Rows[0]
	return r[0].Text(), r[1].Text(), r[2].Text(), r[3].Int(), r[4].Text()
}

fn land(c postgres.Client, repoId i64, change str, message str) ![]str {
	mut tx = try c.Begin()
	let got = try ChangeLanded(mut tx, repoId, change, message)
	try tx.Commit()
	return got
}

fn passed(c postgres.Client, repoId i64, change str) ![]str {
	mut tx = try c.Begin()
	let got = try CheckPassed(mut tx, repoId, change)
	try tx.Commit()
	return got
}

fn sealed(m maker, s str, body str) str {
	return m.capsule(s, body) catch _ {
		""
	}
}

// Capsules with the same panic and route form a group, whatever server signed them; a group links to the declaration
// that panicked; it closes only when the change that says it fixes it has landed and its saved test passed, and it
// reopens, naming that change, when the same panic arrives again.
fn TestGroupsCloseAndReopen(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	let c = got
	let (_, serr) = setup(c)
	t.NoFault("setup", serr)
	let (r, rerr) = newRepo(c, "ada", "private")
	t.NoFault("repo", rerr)
	let (ada, uerr) = newUser(c, "ada-ci")
	t.NoFault("user", uerr)
	// the commit's symbols: the handler, inside a larger declaration
	t.True("symbols", exec(c, "INSERT INTO symbols (repo_id, commit_id, package, name, kind, file, line, end_line) VALUES ({r.Id}, {commitA}, 'shop', 'routes', 'fn', 'shop/cart.tin', 1, 200), ({r.Id}, {commitA}, 'shop', 'Checkout', 'fn', 'shop/cart.tin', 30, 50)"))
	let (m1, e1) = newMaker()
	t.NoFault("maker", e1)
	let (m2, e2) = newMaker()
	t.NoFault("another server's maker", e2)
	let boom = "index 3 out of range [0,3) at shop/cart.tin:42"
	let a1 = sealed(m1, summary(500, "POST", "/checkout", boom), "one")
	let a2 = sealed(m2, summary(500, "POST", "/checkout", boom), "two")
	let b1 = sealed(m1, summary(500, "POST", "/cart", boom), "three")
	let (cl, cerr) = newClient(r, ada, accounts.RoleWrite, "ada-ci@example.com")
	t.NoFault("client", cerr)
	mut cli = cl
	let (ra1, p1) = cli.push(commitA, "a1.tcap", a1)
	t.NoFault("push a1", p1)
	let (ra2, p2) = cli.push(commitA, "a2.tcap", a2)
	t.NoFault("push a2", p2)
	let (rb1, p3) = cli.push(commitA, "b1.tcap", b1)
	t.NoFault("push b1", p3)
	let ga = GroupId(ParseSummary(summary(500, "POST", "/checkout", boom)))
	let gb = GroupId(ParseSummary(summary(500, "POST", "/cart", boom)))
	t.True("a different route is another group", ga != gb)
	crucible.Equal(mut t, "a's capsules", count(c, "SELECT count(*) FROM capsules WHERE group_id = {ga}"), 2)
	let (st0, _, _, n0, decl) = groupState(c, r.Id, ga)
	crucible.Equal(mut t, "a new group is open", st0, "open")
	crucible.Equal(mut t, "two servers' capsules in one group", n0, 2)
	crucible.Equal(mut t, "the declaration that panicked", decl, "shop.Checkout")
	crucible.Equal(mut t, "a group's route and panic", count(c, "SELECT count(*) FROM replay_groups WHERE route = 'POST /checkout' AND panic = {boom}"), 1)
	t.True("pushed ids", len(ra1.Id) == 64 && len(ra2.Id) == 64 && len(rb1.Id) == 64)
	// a status with no panic in the summary is its own failure
	let s1 = GroupId(ParseSummary(summary(500, "GET", "/x", "")))
	let s2 = GroupId(ParseSummary(summary(503, "GET", "/x", "")))
	t.True("statuses without a panic", s1 != s2)

	// landing a change that names a group (by a prefix) and a capsule of another (by its id's prefix)
	let msg = "Fix the cart's index\n\nfixes replay {ga[0:12]}\nFixes Replay {rb1.Id[0:16]}, and fixes replay 1234567 (too short)\n"
	let (marked, lerr) = land(c, r.Id, "kfix", msg)
	t.NoFault("land", lerr)
	crucible.Equal(mut t, "groups the change fixes", len(marked), 2)
	let (st1, fx1, _, _, _) = groupState(c, r.Id, ga)
	crucible.Equal(mut t, "landed: still open until its test passes", st1, "open")
	crucible.Equal(mut t, "landed: the change that is to fix it", fx1, "kfix")
	// the same panic before the test passed changes nothing
	let (_, p4) = cli.push(commitA, "a3.tcap", sealed(m1, summary(500, "POST", "/checkout", boom), "four"))
	t.NoFault("push a3", p4)
	let (st2, fx2, ro2, _, _) = groupState(c, r.Id, ga)
	crucible.Equal(mut t, "before the check: open", st2, "open")
	crucible.Equal(mut t, "before the check: fix kept", fx2, "kfix")
	crucible.Equal(mut t, "before the check: not reopened", ro2, "")
	// the saved test passes on main: both close
	let (closed, cerr2) = passed(c, r.Id, "kfix")
	t.NoFault("check passed", cerr2)
	crucible.Equal(mut t, "groups closed", len(closed), 2)
	let (st3, _, _, _, _) = groupState(c, r.Id, ga)
	crucible.Equal(mut t, "closed", st3, "closed")
	// another change's check closes nothing
	let (none, nerr) = passed(c, r.Id, "kother")
	t.NoFault("another check", nerr)
	crucible.Equal(mut t, "another change closes nothing", len(none), 0)
	// the same panic again: the group reopens, naming the change
	let (ra4, p5) = cli.push(commitA, "a4.tcap", sealed(m2, summary(500, "POST", "/checkout", boom), "five"))
	t.NoFault("push a4", p5)
	let (st4, fx4, ro4, n4, _) = groupState(c, r.Id, ga)
	crucible.Equal(mut t, "reopened", st4, "open")
	crucible.Equal(mut t, "reopened against the change", ro4, "kfix")
	crucible.Equal(mut t, "the fix is no longer claimed", fx4, "")
	crucible.Equal(mut t, "counted", n4, 4)
	t.True("a4 pushed", len(ra4.Id) == 64)
	crucible.Equal(mut t, "a4 in a's group", count(c, "SELECT count(*) FROM capsules WHERE id = {ra4.Id} AND group_id = {ga}"), 1)
	let (st5, _, _, _, _) = groupState(c, r.Id, gb)
	crucible.Equal(mut t, "the other group stays closed", st5, "closed")
}

fn TestFixes(t mut crucible.T) {
	let got = Fixes("Fixes replay DEADBEEF01\nfixes replay deadbeef01 again; fixes replay 0123456 short; fixes replay deadbeefzz; fixes replay  cafe0000cafe")
	crucible.Equal(mut t, "ids", len(got), 2)
	if len(got) == 2 {
		crucible.Equal(mut t, "first", got[0], "deadbeef01")
		crucible.Equal(mut t, "second", got[1], "cafe0000cafe")
	}
	let (f, line) = PanicSite("panic: nil map at shop/cart.tin:42: bad")
	crucible.Equal(mut t, "file", f, "shop/cart.tin")
	crucible.Equal(mut t, "line", line, 42)
	let (f2, _) = PanicSite("index out of range")
	crucible.Equal(mut t, "no site", f2, "")
	let s = ParseSummary("status=500\nmethod=GET\npath=/a/b\npanic=boom\n")
	crucible.Equal(mut t, "status", s.Status, 500)
	crucible.Equal(mut t, "route", Route(s), "GET /a/b")
	crucible.Equal(mut t, "panic", s.Panic, "boom")
}

// sizeOf is the size of the object at key in this core's store, -1 for none.
fn sizeOf(key str) i64 {
	mut st = storeOf() catch _ {
		return -2
	}
	let n = st.Size(key) catch _ {
		return -2
	}
	if n == nil {
		return -1
	}
	return n
}

// Retention: a repository's retention moves the expiry of what it holds; the replay.retention job deletes expired
// capsules (file and row), leaves the rest, and queues its next nightly run once; a capsule and a group are deleted on
// request.
fn TestRetentionAndDelete(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	let c = got
	let (_, serr) = setup(c)
	t.NoFault("setup", serr)
	let (r, rerr) = newRepo(c, "ada", "private")
	t.NoFault("repo", rerr)
	let (ada, uerr) = newUser(c, "ada-ci")
	t.NoFault("user", uerr)
	let (m, merr) = newMaker()
	t.NoFault("maker", merr)
	let (cl, cerr) = newClient(r, ada, accounts.RoleAdmin, "ada-ci@example.com")
	t.NoFault("client", cerr)
	mut cli = cl
	mut ids = []str{}
	for i in 0..4 {
		let (a, perr) = cli.push(commitA, "{i}.tcap", sealed(m, summary(500, "GET", "/r/{i % 2}", ""), "r{i}"))
		t.NoFault("push", perr)
		ids = append(ids, a.Id)
	}
	crucible.Equal(mut t, "default retention", count(c, "SELECT count(*) FROM capsules WHERE expires_at - created_at = interval '30 days'"), 4)
	let (moved, rterr) = SetRetention(c, r.Id, 7)
	t.NoFault("set retention", rterr)
	crucible.Equal(mut t, "moved", moved, 4)
	crucible.Equal(mut t, "new expiry", count(c, "SELECT count(*) FROM capsules WHERE expires_at - created_at = interval '7 days'"), 4)
	let (days, derr) = RetentionDays(c, r.Id)
	t.NoFault("retention", derr)
	crucible.Equal(mut t, "days", days, 7)
	let (_, bad) = SetRetention(c, r.Id, 0)
	t.HasFault("a retention of 0 days", bad)
	// two capsules past their expiry
	let gone0 = ids[0]
	let gone1 = ids[1]
	t.True("expire", exec(c, "UPDATE capsules SET expires_at = now() - interval '1 second' WHERE id IN ({gone0}, {gone1})"))
	let (listed, lerr) = cli.list()
	t.NoFault("list", lerr)
	crucible.Equal(mut t, "expired capsules are not listed", len(listed), 2)
	// the job, through the queue
	let (_, qerr) = events.EnqueueNow(c, RetentionKind, 0, "{{}}")
	t.NoFault("enqueue", qerr)
	let w = events.Runner{Db: c, Handlers: Handlers(), Lease: 60 * tide.Second, Poll: tide.Second}
	let (ran, werr) = w.Step("test/1/0")
	t.NoFault("step", werr)
	t.True("a job ran", ran)
	crucible.Equal(mut t, "the job is done", count(c, "SELECT count(*) FROM events WHERE kind = 'replay.retention' AND state = 'done'"), 1)
	crucible.Equal(mut t, "rows left", count(c, "SELECT count(*) FROM capsules"), 2)
	crucible.Equal(mut t, "an expired capsule's file is gone", sizeOf(packs.CapsuleKey(r.Id, gone0)), -1)
	t.True("a live capsule's file stays", sizeOf(packs.CapsuleKey(r.Id, ids[2])) > 0)
	crucible.Equal(mut t, "the next run is queued", count(c, "SELECT count(*) FROM events WHERE kind = 'replay.retention' AND state = 'ready' AND next_at > now() + interval '23 hours'"), 1)
	let (queued, schErr) = ScheduleRetention(c, 24 * tide.Hour)
	t.NoFault("schedule", schErr)
	t.False("queued once", queued)
	// deleted on request
	let (del, delErr) = Delete(c, r.Id, ids[2])
	t.NoFault("delete", delErr)
	t.True("deleted", del)
	crucible.Equal(mut t, "its file is gone", sizeOf(packs.CapsuleKey(r.Id, ids[2])), -1)
	let (_, gerr) = cli.get(ids[2])
	t.HasFault("a deleted capsule", gerr)
	let (again, aerr) = Delete(c, r.Id, ids[2])
	t.NoFault("delete again", aerr)
	t.False("deleted twice", again)
	let g3 = GroupId(ParseSummary(summary(500, "GET", "/r/1", "")))
	let (dg, dgErr) = DeleteGroup(c, r.Id, g3)
	t.NoFault("delete group", dgErr)
	t.True("group deleted", dg)
	crucible.Equal(mut t, "no capsules left", count(c, "SELECT count(*) FROM capsules"), 0)
	crucible.Equal(mut t, "the group's files are gone", sizeOf(packs.CapsuleKey(r.Id, ids[3])), -1)
}

fn has(s str, sub str) bool {
	if len(sub) > len(s) {
		return false
	}
	for i in 0..len(s) - len(sub) + 1 {
		if s[i:i + len(sub)] == sub {
			return true
		}
	}
	return false
}

// The replay permission: a writer can push and not read, a reader without a grant can do neither, a replay grant (of
// one's own or a team's) and an admin's role read; over the API, 403 without it and 404 for a private repository.
fn TestPermission(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	let c = got
	let (_, serr) = setup(c)
	t.NoFault("setup", serr)
	let (r, rerr) = newRepo(c, "ada", "public")
	t.NoFault("repo", rerr)
	let bob = newUser(c, "bob") catch _ {
		0
	}
	let cat = newUser(c, "cat") catch _ {
		0
	}
	let dan = newUser(c, "dan") catch _ {
		0
	}
	let eve = newUser(c, "eve") catch _ {
		0
	}
	let (m, merr) = newMaker()
	t.NoFault("maker", merr)
	let data = sealed(m, summary(500, "GET", "/p", ""), "secret request")
	let id = idOf(data)
	// bob writes: he pushes, and cannot read
	let (bc, be) = newClient(r, bob, accounts.RoleWrite, "bob@example.com")
	t.NoFault("bob", be)
	mut bobc = bc
	let (_, bp) = bobc.push(commitA, "p.tcap", data)
	t.NoFault("a writer pushes", bp)
	let (_, bl) = bobc.list()
	t.HasFault("a writer lists", bl)
	let (_, bg) = bobc.get(id)
	t.HasFault("a writer fetches", bg)
	// dan reads the repository: no push, no list
	let (dc, de) = newClient(r, dan, accounts.RoleRead, "dan@example.com")
	t.NoFault("dan", de)
	mut danc = dc
	let (_, dp) = danc.push(commitA, "p.tcap", data)
	t.HasFault("a reader pushes", dp)
	let (_, dl) = danc.list()
	t.HasFault("a reader lists", dl)
	// cat reads with a replay grant
	let (_, gerr) = Grant(c, r.Id, cat)
	t.NoFault("grant", gerr)
	let (cc, ce) = newClient(r, cat, accounts.RoleRead, "cat@example.com")
	t.NoFault("cat", ce)
	mut catc = cc
	let (cl, clerr) = catc.list()
	t.NoFault("granted: list", clerr)
	crucible.Equal(mut t, "granted: listed", len(cl), 1)
	let (back, cgerr) = catc.get(id)
	t.NoFault("granted: get", cgerr)
	t.True("granted: the bytes", back == data)
	// eve through her team
	let team = teamOf(c, eve)
	t.True("a team", team > 0)
	let (_, gterr) = GrantTeam(c, r.Id, team)
	t.NoFault("team grant", gterr)
	let (ec, ee) = newClient(r, eve, accounts.RoleRead, "eve@example.com")
	t.NoFault("eve", ee)
	mut evec = ec
	let (_, el) = evec.list()
	t.NoFault("a team's grant: list", el)
	// an admin reads without a grant; nobody signed in reads nothing
	let (adm, adErr) = CanRead(c, r.Id, bob, accounts.RoleAdmin)
	t.NoFault("admin", adErr)
	t.True("an admin reads", adm)
	let (anon, anErr) = CanRead(c, r.Id, 0, accounts.RoleAdmin)
	t.NoFault("anonymous", anErr)
	t.False("nobody reads", anon)
	// a grant taken away, and given back
	let (rv, rvErr) = Revoke(c, r.Id, cat)
	t.NoFault("revoke", rvErr)
	t.True("revoked", rv)
	let (_, cl2) = catc.list()
	t.HasFault("revoked: list", cl2)
	let (_, gerr2) = Grant(c, r.Id, cat)
	t.NoFault("grant again", gerr2)

	// the API: the same permission
	mut router = anvil.NewRouter()
	Mount(mut router)
	let base = "/api/v1/repos/ada/shop/replay"
	let w1 = router.RunWith("GET", base + "/groups", []str{"X-Test-User: {dan}"}, "")
	crucible.Equal(mut t, "API: no replay permission", w1.Code(), 403)
	let w2 = router.RunWith("GET", base + "/groups", []str{}, "")
	crucible.Equal(mut t, "API: anonymous", w2.Code(), 403)
	let w3 = router.RunWith("GET", base + "/groups", []str{"X-Test-User: {cat}"}, "")
	crucible.Equal(mut t, "API: groups", w3.Code(), 200)
	let gid = GroupId(ParseSummary(summary(500, "GET", "/p", "")))
	t.True("API: the group listed", has(str(w3.Body), gid))
	let w4 = router.RunWith("GET", base + "/groups/" + gid, []str{"X-Test-User: {cat}"}, "")
	crucible.Equal(mut t, "API: a group", w4.Code(), 200)
	t.True("API: the group's capsules", has(str(w4.Body), id))
	let w5 = router.RunWith("GET", base + "/capsules?limit=1", []str{"X-Test-User: {cat}"}, "")
	crucible.Equal(mut t, "API: capsules", w5.Code(), 200)
	let w6 = router.RunWith("GET", base + "/capsules/" + id + "/download", []str{"X-Test-User: {cat}"}, "")
	crucible.Equal(mut t, "API: download", w6.Code(), 200)
	t.True("API: the sealed bytes", str(w6.Body) == data)
	let w7 = router.RunWith("GET", base + "/capsules/" + id + "/download", []str{"X-Test-User: {bob}"}, "")
	crucible.Equal(mut t, "API: a writer downloads", w7.Code(), 403)
	let w8 = router.RunWith("PUT", base + "/retention", []str{"X-Test-User: {cat}"}, "{{\"days\": 3}}")
	crucible.Equal(mut t, "API: retention by a non-admin", w8.Code(), 403)
	let w9 = router.RunWith("GET", base + "/retention", []str{"X-Test-User: {cat}"}, "")
	crucible.Equal(mut t, "API: retention", w9.Code(), 200)
	t.True("API: 30 days", has(str(w9.Body), "30"))
	let w10 = router.RunWith("DELETE", base + "/capsules/" + id, []str{"X-Test-User: {dan}"}, "")
	crucible.Equal(mut t, "API: delete without the permission", w10.Code(), 403)
	let w11 = router.RunWith("DELETE", base + "/capsules/" + id, []str{"X-Test-User: {cat}"}, "")
	crucible.Equal(mut t, "API: delete", w11.Code(), 204)
	crucible.Equal(mut t, "API: deletion audited", count(c, "SELECT count(*) FROM audit_log WHERE action = 'replay.delete'"), 1)
	let w12 = router.RunWith("GET", base + "/capsules/" + id, []str{"X-Test-User: {cat}"}, "")
	crucible.Equal(mut t, "API: a deleted capsule", w12.Code(), 404)
	// a private repository is 404 to someone who cannot read it
	t.True("private", exec(c, "UPDATE repos SET visibility = 'private' WHERE id = {r.Id}"))
	let w13 = router.RunWith("GET", base + "/groups", []str{"X-Test-User: {dan}"}, "")
	crucible.Equal(mut t, "API: a private repository", w13.Code(), 404)
}

// teamOf makes an org with a team whose one member is user; the team's id, 0 on a fault.
fn teamOf(c postgres.Client, user i64) i64 {
	let org = c.Query("INSERT INTO owners (name, kind) VALUES ('acme', 'org') RETURNING id") catch _ {
		return 0
	}
	let ownerId = org.Rows[0][0].Int()
	let o = c.Query("INSERT INTO orgs (owner_id) VALUES ({ownerId}) RETURNING id") catch _ {
		return 0
	}
	let orgId = o.Rows[0][0].Int()
	let tm = c.Query("INSERT INTO teams (org_id, name) VALUES ({orgId}, 'oncall') RETURNING id") catch _ {
		return 0
	}
	let team = tm.Rows[0][0].Int()
	if !exec(c, "INSERT INTO team_members (team_id, user_id) VALUES ({team}, {user})") {
		return 0
	}
	return team
}

// marker is a secret the recorded requests carry (a card number in their bodies and a token in a header): tinhub must
// never hold it in the clear, wherever it keeps bytes.
const marker = "tinhub-marker-4111111111111111"

// leakedFiles is the files under dir (walked whole) whose bytes hold sub.
fn leakedFiles(dir str, sub str) ![]str {
	mut out = []str{}
	let entries = try quarry.ReadDirEntries(dir)
	for e in entries {
		let p = dir + "/" + e.Name
		if quarry.IsDir(p) {
			let more = try leakedFiles(p, sub)
			for x in more {
				out = append(out, x)
			}
			continue
		}
		let data = try quarry.ReadFile(p)
		if has(data, sub) {
			out = append(out, p)
		}
	}
	return out
}

// Capsules of requests that carry a marker are uploaded, listed and read through the API; then every stored byte is
// searched for the marker, in the clear and in hex: every file under the store's root (the store and its tmp) and
// every row of every table of the database (bytea as hex). It is never found.
fn TestNoPlaintext(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	let c = got
	let (dir, serr) = setup(c)
	t.NoFault("setup", serr)
	let (r, rerr) = newRepo(c, "ada", "public")
	t.NoFault("repo", rerr)
	let (ada, uerr) = newUser(c, "ada-ci")
	t.NoFault("user", uerr)
	let (m, merr) = newMaker()
	t.NoFault("maker", merr)
	let (cl, cerr) = newClient(r, ada, accounts.RoleAdmin, "ada-ci@example.com")
	t.NoFault("client", cerr)
	mut cli = cl
	t.NoFault("a nonce", cli.prime())
	mut ids = []str{}
	for i in 0..20 {
		let body = "POST /checkout/{i} HTTP/1.1\r\nAuthorization: Bearer " + marker + "\r\n\r\ncard=" + marker + "&n={i}"
		let data = m.capsule(summary(500, "POST", "/checkout", "index out of range"), body) catch err {
			t.Error("seal: {err}")
			return
		}
		t.True("the capsule's own bytes do not hold the marker", !has(data, marker))
		crucible.Equal(mut t, "pushed", cli.pushed(commitA, "{i}.tcap", data), 1)
		ids = append(ids, idOf(data))
	}
	let all = cli.list() catch err {
		t.Error("list: {err}")
		return
	}
	crucible.Equal(mut t, "listed", len(all), 20)
	mut router = anvil.NewRouter()
	Mount(mut router)
	let base = "/api/v1/repos/ada/shop/replay"
	let (_, gerr) = Grant(c, r.Id, ada)
	t.NoFault("grant", gerr)
	let w1 = router.RunWith("GET", base + "/groups", []str{"X-Test-User: {ada}"}, "")
	crucible.Equal(mut t, "API: groups", w1.Code(), 200)
	t.True("the API's groups do not hold the marker", !has(str(w1.Body), marker))
	let hexMarker = seal.Hex([]u8(marker))
	let leaks = leakedFiles(dir, marker) catch err {
		t.Error("walk: {err}")
		return
	}
	crucible.Equal(mut t, "files holding the marker", len(leaks), 0)
	let hexLeaks = leakedFiles(dir, hexMarker) catch err {
		t.Error("walk: {err}")
		return
	}
	crucible.Equal(mut t, "files holding the marker in hex", len(hexLeaks), 0)
	let like = "%" + marker + "%"
	let hexLike = "%" + hexMarker + "%"
	let rows = c.Query("SELECT t.table_name FROM information_schema.tables t WHERE t.table_schema = 'public' AND t.table_type = 'BASE TABLE' AND (query_to_xml(format('SELECT 1 FROM %I x WHERE x::text LIKE %L OR x::text LIKE %L LIMIT 1', t.table_name, {like}::text, {hexLike}::text), false, true, ''))::text <> ''") catch err {
		t.Error("search the database: {err}")
		return
	}
	for row in rows.Rows {
		t.Error("table {row[0].Text()} holds the marker")
	}
	// the search would have found it: a row holding the marker is seen
	t.True("the search sees a marker", exec(c, "INSERT INTO audit_log (action, target_kind, target_id, detail) VALUES ('test', 'repo', {r.Id}, jsonb_build_object('m', {marker}::text))"))
	let seen = c.Query("SELECT t.table_name FROM information_schema.tables t WHERE t.table_schema = 'public' AND t.table_type = 'BASE TABLE' AND (query_to_xml(format('SELECT 1 FROM %I x WHERE x::text LIKE %L LIMIT 1', t.table_name, {like}::text), false, true, ''))::text <> ''") catch err {
		t.Error("search the database: {err}")
		return
	}
	crucible.Equal(mut t, "tables the planted marker is found in", len(seen.Rows), 1)
	// the walk sees the capsules: a file holding a capsule's own bytes is found
	let (first, gerr2) = Bytes(r.Id, ids[0])
	t.NoFault("bytes", gerr2)
	let found = leakedFiles(dir, first) catch err {
		t.Error("walk: {err}")
		return
	}
	crucible.Equal(mut t, "files holding the first capsule", len(found), 1)
}
