package capsules

import "../../tit/transport"
import "../accounts"
import "../events"
import "../packs"
import "anvil"
import "argo"
import "fault"
import "postgres"
import "quarry"
import "seal"
import "tide"
import "twine"

// The replay store (design/tinhub.md §5, #1022): sealed capsules pushed by tit replay (design/tit.md §17), kept in the
// pack store at repos/<repo>/capsules/<id>.tcap with a row of capsules each, and grouped into failure groups by their
// panic and route. tinhub holds no key and never opens a capsule: all it reads is the plain summary tit's server
// hands it (status, method, path, and the panic only when the recording server opted in). The package is capsules,
// not replay: tit's transport imports the standard replay package, and two packages of one name cannot meet in a
// program (E113).
//
// A group closes when a landed change that says "fixes replay <id>" has its saved test pass on main, and reopens,
// naming that change, when the same failure arrives again. Capsules expire after their repository's retention (30 days
// unless set) and are deleted by the replay.retention job, or at once on request. Reading capsules takes the replay
// permission (a replay grant, or admin of the repository), which read and write access do not give.

// Deps is what the store needs, set on every core (Configure) before the first request or job.
type Deps struct {
	Db    postgres.Client
	Store dyn packs.PackStore
	// Dir is packs.dir: capsules are written under Dir/tmp before they move into the store
	Dir str
	// Auth is the signed-in user of an API request (a session or a signature), 0 for nobody
	Auth fn(anvil.Req) !i64
}

// deps is this core's: globals are per core.
mut deps ?Deps = nil

// Configure sets this core's dependencies.
fn Configure(d Deps) {
	deps = keep(d)
}

fn depsOf() !Deps {
	let got = deps
	if got == nil {
		fail "capsules: not configured on this core"
	}
	return got
}

// DefaultRetentionDays is how long a capsule is kept when its repository sets nothing.
const DefaultRetentionDays = 30

// refused is a fault tit's server answers as a refusal ("Code: message").
fn refused(c transport.Code, message str) ! {
	fail fault.Wrap(transport.ErrRefused, transport.CodeName(c) + ": " + message)
}

// ---- summaries and groups ----

// Summary is a capsule's plain summary, as the recording server wrote it: "status=N\nmethod=M\npath=P\n", "route=R\n"
// when a Router pattern served the request (#1106), and "panic=TEXT\n" with TIN_REPLAY_SUMMARY_PANIC=1
// (design/interface_replay.md §6.1).
type Summary struct {
	Status  i64
	Method  str
	Path    str
	Pattern str
	Panic   str
}

// ParseSummary reads a summary; lines it does not know are ignored.
fn ParseSummary(text str) Summary {
	mut s = Summary{Status: 0, Method: "", Path: "", Pattern: "", Panic: ""}
	for line in twine.Split(text, "\n") {
		let (k, v, ok) = twine.Cut(line, "=")
		if !ok {
			continue
		}
		match k {
			"status" => {
				s.Status = atoi(v)
			}
			"method" => {
				s.Method = v
			}
			"path" => {
				s.Path = v
			}
			"route" => {
				s.Pattern = v
			}
			"panic" => {
				s.Panic = v
			}
			_ => {
			}
		}
	}
	return s
}

fn atoi(v str) i64 {
	mut n = 0
	for c in v {
		if c < '0' || c > '9' || n > 100000000 {
			return 0
		}
		n = n * 10 + i64(c - '0')
	}
	return n
}

// Route is a summary's route: its method and the Router pattern that served it ("POST /checkout/{id}"), so the
// failures of one route make one group whatever ids their paths hold (#1106); its method and path when the summary
// has no pattern (a capsule recorded before, or a server without a Router).
fn Route(s Summary) str {
	if len(s.Pattern) > 0 {
		return s.Method + " " + s.Pattern
	}
	return s.Method + " " + s.Path
}

// GroupId is the failure group of a summary: the hex SHA-256 of its route and its panic (its status when the summary
// carries no panic). Unlike tit serve's groups (design/tit.md §17) the signer is left out, so a server's new signing
// key keeps its failures in their groups.
fn GroupId(s Summary) str {
	mut failure = "status {s.Status}"
	if len(s.Panic) > 0 {
		failure = "panic " + s.Panic
	}
	return seal.Hex(seal.Sha256("tinhub replay group\n" + Route(s) + "\n" + failure))
}

// summaryJson is a summary as the capsules row keeps it (jsonb): its fields, and its text as received.
type summaryJson struct {
	text   str
	status i64
	method str
	path   str
	route  str
	panic  str
}

fn summaryJsonOf(text str, s Summary) str {
	mut b = []u8{}
	argo.Put(mut b, summaryJson{text: text, status: s.Status, method: s.Method, path: s.Path, route: s.Pattern, panic: s.Panic})
	return str(b)
}

// ---- the permission ----

// HasGrant reports whether user holds a replay grant on the repository, of their own or through a team.
fn HasGrant(c postgres.Client, repoId i64, user i64) !bool {
	if user <= 0 {
		return false
	}
	let rows = try c.Query("SELECT 1 FROM replay_grants g WHERE g.repo_id = {repoId} AND (g.user_id = {user} OR g.team_id IN (SELECT team_id FROM team_members WHERE user_id = {user})) LIMIT 1")
	return len(rows.Rows) > 0
}

// CanRead reports whether user, whose role on the repository is role (accounts.Role*), may list, fetch and delete its
// capsules: the replay permission, which an admin has and anyone else only by a replay grant.
fn CanRead(c postgres.Client, repoId i64, user i64, role i64) !bool {
	if user <= 0 || role == accounts.RoleNone {
		return false
	}
	if role >= accounts.RoleAdmin {
		return true
	}
	return try HasGrant(c, repoId, user)
}

// CanUpload reports whether user may push capsules to the repository: write access or the replay permission. A
// writer can add capsules but not read them.
fn CanUpload(c postgres.Client, repoId i64, user i64, role i64) !bool {
	if user <= 0 || role == accounts.RoleNone {
		return false
	}
	if role >= accounts.RoleWrite {
		return true
	}
	return try HasGrant(c, repoId, user)
}

// Grant gives user the replay permission on the repository; false when they had a grant already.
fn Grant(c postgres.Client, repoId i64, user i64) !bool {
	let r = try c.Exec("INSERT INTO replay_grants (repo_id, user_id) VALUES ({repoId}, {user}) ON CONFLICT DO NOTHING")
	return r.Affected == 1
}

// GrantTeam gives a team's members the replay permission on the repository; false when it had a grant already.
fn GrantTeam(c postgres.Client, repoId i64, team i64) !bool {
	let r = try c.Exec("INSERT INTO replay_grants (repo_id, team_id) VALUES ({repoId}, {team}) ON CONFLICT DO NOTHING")
	return r.Affected == 1
}

// Revoke takes user's own replay grant away; false when there was none.
fn Revoke(c postgres.Client, repoId i64, user i64) !bool {
	let r = try c.Exec("DELETE FROM replay_grants WHERE repo_id = {repoId} AND user_id = {user}")
	return r.Affected == 1
}

// ---- retention ----

// RetentionDays is how many days the repository keeps a capsule.
fn RetentionDays(c postgres.Client, repoId i64) !i64 {
	let rows = try c.Query("SELECT retention_days FROM replay_settings WHERE repo_id = {repoId}")
	if len(rows.Rows) == 0 {
		return DefaultRetentionDays
	}
	return rows.Rows[0][0].Int()
}

// SetRetention sets the repository's retention to days (1 to 3650) and moves the expiry of every capsule it holds to
// match; it returns the capsules whose expiry moved.
fn SetRetention(c postgres.Client, repoId i64, days i64) !i64 {
	if days < 1 || days > 3650 {
		fail "capsules: a retention of {days} days (want 1 to 3650)"
	}
	mut tx = try c.Begin()
	let (n, err) = setRetentionIn(mut tx, repoId, days)
	if err != nil {
		tx.Rollback() catch _ {
		}
		fail err
	}
	try tx.Commit()
	return n
}

fn setRetentionIn(tx mut postgres.Tx, repoId i64, days i64) !i64 {
	_ = try tx.Exec("INSERT INTO replay_settings (repo_id, retention_days) VALUES ({repoId}, {days}::int) ON CONFLICT (repo_id) DO UPDATE SET retention_days = excluded.retention_days, updated_at = now()")
	let r = try tx.Exec("UPDATE capsules SET expires_at = created_at + make_interval(days => {days}::int) WHERE repo_id = {repoId}")
	return r.Affected
}

// RetentionKind is the job that deletes expired capsules (design/tinhub.md §6).
const RetentionKind = "replay.retention"

// retentionBatch is the capsules one round of the job deletes; retentionRounds the most rounds one job runs (the
// next run takes the rest).
const retentionBatch = 500

const retentionRounds = 40

// Handlers is the store's job kinds for the worker: replay.retention, nightly, in 5m and 64mb. The worker's core must
// have been configured (Configure).
fn Handlers() []events.Handler {
	return []events.Handler{events.Handler{Kind: RetentionKind, Within: 5 * tide.Minute, Memory: 64 * 1024 * 1024, Tasks: 4, MaxAttempts: 5, Run: retentionJob}}
}

// retentionJob deletes the expired capsules of every repository (or of the job's repository when it names one), and
// queues the next nightly run when it ran for all of them.
fn retentionJob(j events.Job) ! {
	let d = try depsOf()
	_ = try Expire(d.Db, j.RepoId)
	if j.RepoId == 0 {
		_ = try ScheduleRetention(d.Db, 24 * tide.Hour)
	}
}

// Expire deletes every capsule past its expiry (of repoId, or of every repository when 0), its file first and then
// its row, so a crash between the two leaves a row the next run deletes and never a file nobody can see. It returns
// the capsules deleted.
fn Expire(c postgres.Client, repoId i64) !i64 {
	mut st = try storeOf()
	mut total = 0
	for round in 0..retentionRounds {
		let rows = try c.Query("SELECT repo_id, id FROM capsules WHERE expires_at <= now() AND ({repoId} = 0 OR repo_id = {repoId}) ORDER BY expires_at LIMIT {retentionBatch}")
		for row in rows.Rows {
			let r = row[0].Int()
			let id = row[1].Text()
			_ = try st.Delete(packs.CapsuleKey(r, id))
			let gone = try c.Exec("DELETE FROM capsules WHERE repo_id = {r} AND id = {id} AND expires_at <= now()")
			total += gone.Affected
		}
		if len(rows.Rows) < retentionBatch {
			break
		}
	}
	return total
}

// ScheduleRetention queues the nightly replay.retention job to run after wait nanoseconds, unless one is queued
// already; true when it queued one. A worker calls it at start, and each run queues the next.
fn ScheduleRetention(c postgres.Client, wait i64) !bool {
	let secs = wait / tide.Second
	let r = try c.Exec("INSERT INTO events (kind, payload, next_at) SELECT {RetentionKind}, '{{}}'::jsonb, now() + make_interval(secs => {secs}::float8) WHERE NOT EXISTS (SELECT 1 FROM events WHERE kind = {RetentionKind} AND repo_id IS NULL AND state = 'ready')")
	return r.Affected == 1
}

// ---- deleting ----

// storeOf is this core's pack store (read from the global: a store taken from a parameter's field trips a false
// E701, #1073).
fn storeOf() !dyn packs.PackStore {
	let d = try depsOf()
	return d.Store
}

// Delete removes one capsule, its file first; false when the repository has no such capsule.
fn Delete(c postgres.Client, repoId i64, id str) !bool {
	if !isId(id) {
		return false
	}
	let rows = try c.Query("SELECT 1 FROM capsules WHERE repo_id = {repoId} AND id = {id}")
	if len(rows.Rows) == 0 {
		return false
	}
	mut st = try storeOf()
	_ = try st.Delete(packs.CapsuleKey(repoId, id))
	let r = try c.Exec("DELETE FROM capsules WHERE repo_id = {repoId} AND id = {id}")
	return r.Affected == 1
}

// DeleteGroup removes a failure group and every capsule in it; false when the repository has no such group.
fn DeleteGroup(c postgres.Client, repoId i64, groupId str) !bool {
	let g = try c.Query("SELECT 1 FROM replay_groups WHERE repo_id = {repoId} AND id = {groupId}")
	if len(g.Rows) == 0 {
		return false
	}
	let rows = try c.Query("SELECT id FROM capsules WHERE repo_id = {repoId} AND group_id = {groupId}")
	for row in rows.Rows {
		_ = try Delete(c, repoId, row[0].Text())
	}
	// the group's capsules go with it (on delete cascade), any that arrived meanwhile included: delete their files too
	let late = try c.Query("DELETE FROM capsules WHERE repo_id = {repoId} AND group_id = {groupId} RETURNING id")
	mut st = try storeOf()
	for row in late.Rows {
		_ = try st.Delete(packs.CapsuleKey(repoId, row[0].Text()))
	}
	let r = try c.Exec("DELETE FROM replay_groups WHERE repo_id = {repoId} AND id = {groupId}")
	return r.Affected == 1
}

fn isId(id str) bool {
	if len(id) != 64 {
		return false
	}
	return isHex(id)
}

fn isHex(s str) bool {
	for c in s {
		if !((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')) {
			return false
		}
	}
	return true
}

// ---- storing ----

// Stored is one capsule's row.
type Stored struct {
	Id      str
	Group   str
	Commit  str
	Name    str
	Signer  str
	Summary str
	Status  i64
	Route   str
	Size    i64
	Created i64
	Expires i64
}

// Store is a repository's capsules as tit's server keeps them (transport.ReplayStore), for one signed-in user and
// the role they have there: Put takes upload access, List and Get the replay permission.
type Store struct {
	repo i64
	user i64
	role i64
	name str
}

// StoreFor is r's capsules for user (0 for nobody) holding role, as proto's server takes them: s.SetReplays(it).
fn StoreFor(r accounts.Repo, user i64, role i64) dyn transport.ReplayStore {
	let s dyn transport.ReplayStore = Store{repo: r.Id, user: user, role: role, name: r.Owner + "/" + r.Name}
	return s
}

// Put stores a capsule tit's server has checked (a version 2 capsule whose signature verifies), once: false when the
// repository had it already, so an interrupted upload simply runs again. The bytes go into the pack store first and
// the row second; a crash between them leaves a file the next upload of the capsule finds and keeps.
fn (s Store) Put(e transport.ReplayEntry, data str) !bool {
	let d = try depsOf()
	let ok = try CanUpload(d.Db, s.repo, s.user, s.role)
	if !ok {
		try refused(transport.Code.Unauthorized, "pushing replay capsules to {s.name} takes write access or the replay permission")
	}
	if !isId(e.Id) {
		try refused(transport.Code.BadRequest, "{e.Id} is not a capsule id")
	}
	let have = try d.Db.Query("SELECT 1 FROM capsules WHERE repo_id = {s.repo} AND id = {e.Id}")
	if len(have.Rows) > 0 {
		return false
	}
	try putFile(d, s.repo, e.Id, data)
	return try Record(d.Db, s.repo, e, len(data))
}

// putFile writes a capsule's bytes to the pack store, through a file under packs.dir/tmp.
fn putFile(d Deps, repoId i64, id str, data str) ! {
	let dir = d.Dir + "/tmp"
	try quarry.MkdirAll(dir)
	let tmp = dir + "/capsule-" + seal.Hex(seal.RandomBytes(8))
	try quarry.WriteFile(tmp, data)
	mut st = try storeOf()
	_ = st.Put(packs.CapsuleKey(repoId, id), tmp) catch err {
		quarry.Remove(tmp) catch _ {
		}
		fail err
	}
}

// Record adds a stored capsule's row and counts it in its group, in one transaction: the group is made when it is new
// and reopened, naming the change that was to fix it, when it was closed. False when the row was there already.
fn Record(c postgres.Client, repoId i64, e transport.ReplayEntry, size i64) !bool {
	mut tx = try c.Begin()
	let (fresh, err) = recordIn(mut tx, repoId, e, size)
	if err != nil {
		tx.Rollback() catch _ {
		}
		fail err
	}
	try tx.Commit()
	return fresh
}

fn recordIn(tx mut postgres.Tx, repoId i64, e transport.ReplayEntry, size i64) !bool {
	let s = ParseSummary(e.Summary)
	let group = GroupId(s)
	let route = Route(s)
	let summary = summaryJsonOf(e.Summary, s)
	let days = try retentionIn(mut tx, repoId)
	_ = try tx.Exec("INSERT INTO replay_groups (repo_id, id, panic, route, state) VALUES ({repoId}, {group}, {s.Panic}, {route}, 'open') ON CONFLICT (repo_id, id) DO NOTHING")
	let ins = try tx.Query("INSERT INTO capsules (repo_id, id, group_id, commit_id, name, signer, summary, status, route, size_bytes, expires_at) VALUES ({repoId}, {e.Id}, {group}, {e.Commit}, {e.Name}, {e.Signer}, {summary}::jsonb, {s.Status}::int, {route}, {size}, now() + make_interval(days => {days}::int)) ON CONFLICT (repo_id, id) DO NOTHING RETURNING id")
	if len(ins.Rows) == 0 {
		return false
	}
	// SET reads the row as it was: a closed group reopens, naming the change that closed it
	_ = try tx.Exec("UPDATE replay_groups SET count = count + 1, last_at = now(), state = 'open', reopened_by = CASE WHEN state = 'closed' THEN fixed_by ELSE reopened_by END, fixed_by = CASE WHEN state = 'closed' THEN '' ELSE fixed_by END WHERE repo_id = {repoId} AND id = {group}")
	// the declaration that panicked, when the panic names a file and line the symbols of its commit know
	if len(s.Panic) > 0 && len(e.Commit) > 0 {
		let decl = try declIn(mut tx, repoId, e.Commit, s.Panic)
		if len(decl) > 0 {
			_ = try tx.Exec("UPDATE replay_groups SET decl = {decl} WHERE repo_id = {repoId} AND id = {group}")
		}
	}
	return true
}

fn retentionIn(tx mut postgres.Tx, repoId i64) !i64 {
	let rows = try tx.Query("SELECT retention_days FROM replay_settings WHERE repo_id = {repoId}")
	if len(rows.Rows) == 0 {
		return DefaultRetentionDays
	}
	return rows.Rows[0][0].Int()
}

// List is the repository's capsules that have not expired, newest first (at most listMax of them).
fn (s Store) List() ![]transport.ReplayEntry {
	let d = try depsOf()
	let ok = try CanRead(d.Db, s.repo, s.user, s.role)
	if !ok {
		try refused(transport.Code.Unauthorized, "the capsules of {s.name} take the replay permission")
	}
	let rows = try d.Db.Query("SELECT id, group_id, name, commit_id, signer, summary->>'text', extract(epoch FROM created_at)::bigint FROM capsules WHERE repo_id = {s.repo} AND expires_at > now() ORDER BY created_at DESC, id LIMIT {listMax}")
	mut out = []transport.ReplayEntry{}
	for r in rows.Rows {
		out = append(out, transport.ReplayEntry{Id: r[0].Text(), Group: r[1].Text(), Name: r[2].Text(), Commit: r[3].Text(), Signer: r[4].Text(), Summary: r[5].Text(), Time: r[6].Int()})
	}
	return out
}

// listMax is the most capsules a protocol list answers.
const listMax = 10000

// Get is one capsule's entry and bytes.
fn (s Store) Get(id str) !(transport.ReplayEntry, str) {
	let d = try depsOf()
	let ok = try CanRead(d.Db, s.repo, s.user, s.role)
	if !ok {
		try refused(transport.Code.Unauthorized, "the capsules of {s.name} take the replay permission")
	}
	if !isId(id) {
		try refused(transport.Code.BadRequest, "{id} is not a capsule id")
	}
	let rows = try d.Db.Query("SELECT id, group_id, name, commit_id, signer, summary->>'text', extract(epoch FROM created_at)::bigint FROM capsules WHERE repo_id = {s.repo} AND id = {id} AND expires_at > now()")
	if len(rows.Rows) == 0 {
		try refused(transport.Code.NotFound, "no capsule {id[0:12]} here")
	}
	let r = rows.Rows[0]
	let e = transport.ReplayEntry{Id: r[0].Text(), Group: r[1].Text(), Name: r[2].Text(), Commit: r[3].Text(), Signer: r[4].Text(), Summary: r[5].Text(), Time: r[6].Int()}
	let data = try Bytes(s.repo, id)
	return e, data
}

// Bytes is a stored capsule's bytes, read from the pack store.
fn Bytes(repoId i64, id str) !str {
	let d = try depsOf()
	mut st = try storeOf()
	let key = packs.CapsuleKey(repoId, id)
	let local = st.Local(key)
	if local != nil {
		return try quarry.ReadFileBound(local, transport.MaxCapsule + 1)
	}
	let dir = d.Dir + "/tmp"
	try quarry.MkdirAll(dir)
	let tmp = dir + "/capsule-get-" + seal.Hex(seal.RandomBytes(8))
	_ = try st.Get(key, tmp)
	let (data, err) = quarry.ReadFileBound(tmp, transport.MaxCapsule + 1)
	quarry.Remove(tmp) catch _ {
	}
	if err != nil {
		fail err
	}
	return data
}

// ---- closing and reopening ----

// Fixes is the ids a change message names as fixed: each "fixes replay <id>" (any case; the id a group's or a
// capsule's, whole or a prefix of at least 8 hex digits), in order, once each.
fn Fixes(message str) []str {
	let low = twine.ToLower(message)
	let word = "fixes replay "
	mut out = []str{}
	mut at = 0
	for {
		let i = twine.Index(low[at:], word)
		if i < 0 {
			break
		}
		mut j = at + i + len(word)
		for j < len(low) && low[j] == ' ' {
			j += 1
		}
		let start = j
		for j < len(low) && ((low[j] >= '0' && low[j] <= '9') || (low[j] >= 'a' && low[j] <= 'f')) {
			j += 1
		}
		let id = low[start:j]
		// a word that goes on past the hex digits is not an id
		let ends = j == len(low) || !((low[j] >= 'a' && low[j] <= 'z') || (low[j] >= '0' && low[j] <= '9') || low[j] == '_')
		if len(id) >= 8 && len(id) <= 64 && ends {
			mut seen = false
			for x in out {
				if x == id {
					seen = true
				}
			}
			if !seen {
				out = append(out, id)
			}
		}
		at = j
		if at >= len(low) {
			break
		}
	}
	return out
}

// ChangeLanded is called by landing (reviews, #1025) in the transaction that lands changeId on the repository's main
// branch, with the change's message: every group the message says it fixes ("fixes replay <id>", Fixes) is marked
// as fixed by the change, still open until the change's saved test passes on main (CheckPassed). An id that names no
// group of the repository, or more than one, is skipped. It returns the groups marked.
fn ChangeLanded(tx mut postgres.Tx, repoId i64, changeId str, message str) ![]str {
	mut out = []str{}
	for id in Fixes(message) {
		let g = try groupOf(mut tx, repoId, id)
		if len(g) == 0 {
			continue
		}
		_ = try tx.Exec("UPDATE replay_groups SET fixed_by = {changeId} WHERE repo_id = {repoId} AND id = {g}")
		out = append(out, g)
	}
	return out
}

// groupOf is the group an id or prefix names: a group's, or the group of the capsule it names; "" for none, or for a
// prefix that fits more than one.
fn groupOf(tx mut postgres.Tx, repoId i64, id str) !str {
	let like = id + "%"
	let gs = try tx.Query("SELECT id FROM replay_groups WHERE repo_id = {repoId} AND id LIKE {like} LIMIT 2")
	if len(gs.Rows) == 1 {
		return gs.Rows[0][0].Text()
	}
	if len(gs.Rows) > 1 {
		return ""
	}
	let cs = try tx.Query("SELECT DISTINCT group_id FROM capsules WHERE repo_id = {repoId} AND id LIKE {like} LIMIT 2")
	if len(cs.Rows) == 1 {
		return cs.Rows[0][0].Text()
	}
	return ""
}

// CheckPassed is called by the checks code (#1025) when a landed change's saved test (the replay test its author
// saved with tin replay --save-test) passes on main: every group the change fixes closes. It returns the groups
// closed.
fn CheckPassed(tx mut postgres.Tx, repoId i64, changeId str) ![]str {
	let rows = try tx.Query("UPDATE replay_groups SET state = 'closed' WHERE repo_id = {repoId} AND fixed_by = {changeId} AND fixed_by <> '' AND state = 'open' RETURNING id")
	mut out = []str{}
	for r in rows.Rows {
		out = append(out, r[0].Text())
	}
	return out
}

// SetDecl records the declaration a group's failure panicked in (package.name), as a replay of one of its capsules
// found it (the runner, #1028).
fn SetDecl(c postgres.Client, repoId i64, groupId str, decl str) !bool {
	let r = try c.Exec("UPDATE replay_groups SET decl = {decl} WHERE repo_id = {repoId} AND id = {groupId}")
	return r.Affected == 1
}

// PanicSite is the file and line a panic message names ("… shop/cart.tin:42 …"), "" and 0 when it names none.
fn PanicSite(text str) (str, i64) {
	let at = twine.Index(text, ".tin:")
	if at < 0 {
		return "", 0
	}
	mut start = at
	for start > 0 {
		let c = text[start - 1]
		let ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '-' || c == '.' || c == '/'
		if !ok {
			break
		}
		start -= 1
	}
	mut j = at + 5
	mut line = 0
	for j < len(text) && text[j] >= '0' && text[j] <= '9' && line < 100000000 {
		line = line * 10 + i64(text[j] - '0')
		j += 1
	}
	if line == 0 || start == at {
		return "", 0
	}
	return text[start:at + 4], line
}

// declIn is the declaration of the repository's commit whose lines hold the panic's file and line, "" for none.
fn declIn(tx mut postgres.Tx, repoId i64, commit str, panicText str) !str {
	let (file, line) = PanicSite(panicText)
	if len(file) == 0 {
		return ""
	}
	let rows = try tx.Query("SELECT package, name FROM symbols WHERE repo_id = {repoId} AND commit_id = {commit} AND (file = {file} OR right(file, length({file}) + 1) = '/' || {file}) AND line <= {line}::int AND end_line >= {line}::int ORDER BY end_line - line LIMIT 1")
	if len(rows.Rows) == 0 {
		return ""
	}
	return rows.Rows[0][0].Text() + "." + rows.Rows[0][1].Text()
}

// DeclOf is declIn outside a transaction (the API looks again when a group has none yet: symbols come later).
fn DeclOf(c postgres.Client, repoId i64, commit str, panicText str) !str {
	mut tx = try c.Begin()
	let (decl, err) = declIn(mut tx, repoId, commit, panicText)
	tx.Rollback() catch _ {
	}
	if err != nil {
		fail err
	}
	return decl
}
