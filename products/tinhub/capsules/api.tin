package capsules

import "../accounts"
import "../packs"
import "anvil"
import "argo"
import "fault"
import "mint"
import "postgres"
import "tide"
import "twine"

// The replay API (design/tinhub.md §4, #1022), JSON under /api/v1/repos/<owner>/<repo>/replay: failure groups and
// capsules listed, read and deleted, a capsule downloaded (its sealed bytes, as stored), the retention read and set,
// and replay grants given and taken. A repository the caller cannot read is 404; reading or deleting capsules
// without the replay permission is 403; the retention and the grants are set by the repository's admins. Errors are
// {"code", "message"} as in the rest of the API; lists page with an opaque cursor.

// Mount adds the replay API's routes to r.
fn Mount(r mut anvil.Router) {
	r.Get(`/api/v1/repos/{owner}/{repo}/replay/groups`, listGroups)
	r.Get(`/api/v1/repos/{owner}/{repo}/replay/groups/{id}`, getGroup)
	r.Delete(`/api/v1/repos/{owner}/{repo}/replay/groups/{id}`, deleteGroup)
	r.Get(`/api/v1/repos/{owner}/{repo}/replay/capsules`, listCapsules)
	r.Get(`/api/v1/repos/{owner}/{repo}/replay/capsules/{id}`, getCapsule)
	r.Get(`/api/v1/repos/{owner}/{repo}/replay/capsules/{id}/download`, download)
	r.Delete(`/api/v1/repos/{owner}/{repo}/replay/capsules/{id}`, deleteCapsule)
	r.Get(`/api/v1/repos/{owner}/{repo}/replay/retention`, getRetention)
	r.Put(`/api/v1/repos/{owner}/{repo}/replay/retention`, putRetention)
	r.Get(`/api/v1/repos/{owner}/{repo}/replay/grants`, listGrants)
	r.Put(`/api/v1/repos/{owner}/{repo}/replay/grants/{user}`, putGrant)
	r.Delete(`/api/v1/repos/{owner}/{repo}/replay/grants/{user}`, deleteGrant)
}

// readWithin, writeWithin and apiMemory are a request's budget (design/tinhub.md §8).
const readWithin = 2 * tide.Second

const writeWithin = 5 * tide.Second

const apiMemory = 16 * 1024 * 1024

const pageMax = 200

const pageSize = 50

type apiError struct {
	code    str
	message str
}

fn fail_(w mut anvil.Out, status i64, code str, message str) {
	w.Status(status)
	w.Json()
	w.Body = []u8{}
	argo.Put(mut w.Body, apiError{code: code, message: message})
}

fn send[T](w mut anvil.Out, v T) {
	w.Json()
	w.Body = []u8{}
	argo.Put(mut w.Body, v)
}

// call is a request's context: who asks, their role and the repository.
type call struct {
	d    Deps
	user i64
	role i64
	r    accounts.Repo
}

// What a request needs beyond reading the repository.
const needRead = 0

const needReplay = 1

const needAdmin = 2

// begin authenticates a request, finds its repository (404 when the caller cannot read it) and checks the caller has
// what need asks; nil when the answer is written already.
fn begin(q anvil.Req, w mut anvil.Out, need i64) ?call {
	let got = deps
	if got == nil {
		fail_(mut w, 503, "unavailable", "the replay API is not configured on this core")
		return nil
	}
	let d = got
	let auth = d.Auth
	let user = auth(q) catch err {
		fail_(mut w, 401, "unauthorized", fault.Message(err))
		return nil
	}
	let owner = q.PathParam("owner")
	let name = q.PathParam("repo")
	let found = accounts.FindRepo(d.Db, owner, name) catch err {
		fail_(mut w, 503, "unavailable", fault.Message(err))
		return nil
	}
	if found == nil {
		fail_(mut w, 404, "not_found", "no repository {owner}/{name}")
		return nil
	}
	let role = accounts.RoleOf(d.Db, user, found) catch err {
		fail_(mut w, 503, "unavailable", fault.Message(err))
		return nil
	}
	if role == accounts.RoleNone {
		fail_(mut w, 404, "not_found", "no repository {owner}/{name}")
		return nil
	}
	if need == needReplay {
		let ok = CanRead(d.Db, found.Id, user, role) catch err {
			fail_(mut w, 503, "unavailable", fault.Message(err))
			return nil
		}
		if !ok {
			fail_(mut w, 403, "forbidden", "the capsules of {owner}/{name} take the replay permission")
			return nil
		}
	}
	if need == needAdmin && (user <= 0 || role < accounts.RoleAdmin) {
		fail_(mut w, 403, "forbidden", "only an admin of {owner}/{name} can change this")
		return nil
	}
	return call{d: d, user: user, role: role, r: found}
}

fn pageLimit(q anvil.Req) i64 {
	let n = mint.Atoi(q.Param("limit")) catch _ {
		pageSize
	}
	if n < 1 {
		return pageSize
	}
	if n > pageMax {
		return pageMax
	}
	return n
}

// ErrBadCursor is the fault of a cursor this API did not give.
let ErrBadCursor = fault("bad cursor")

// ErrNotFound is the fault of a group or capsule the repository does not have.
let ErrNotFound = fault("not found")

fn answerErr(w mut anvil.Out, err fault) {
	if fault.Is(err, ErrBadCursor) {
		fail_(mut w, 400, "bad_request", fault.Message(err))
		return
	}
	if fault.Is(err, ErrNotFound) {
		fail_(mut w, 404, "not_found", fault.Message(err))
		return
	}
	fail_(mut w, 503, "unavailable", fault.Message(err))
}

// cursorOf reads "<time>.<id>" (microseconds since the epoch, and the last id sent); none is the far end.
fn cursorOf(cursor str) !(i64, str) {
	if len(cursor) == 0 {
		return 9223372036854775807, ""
	}
	let (t, id, ok) = twine.Cut(cursor, ".")
	if !ok {
		fail fault.Wrap(ErrBadCursor, cursor)
	}
	let n = mint.Atoi(t) catch _ {
		fail fault.Wrap(ErrBadCursor, cursor)
		0
	}
	return n, id
}

// ---- groups ----

type groupOut struct {
	id          str
	state       str
	panic       str
	route       str
	status      i64
	count       i64
	held        i64
	fixed_by    str
	reopened_by str
	commit      str
	decl        str
	first_at    i64
	last_at     i64
}

type groupPage struct {
	groups []groupOut
	next   str
}

fn groupOf_(row []postgres.Value) groupOut {
	return groupOut{id: row[0].Text(), state: row[1].Text(), panic: row[2].Text(), route: row[3].Text(), count: row[4].Int(), fixed_by: row[5].Text(), reopened_by: row[6].Text(), decl: row[7].Text(), first_at: row[8].Int(), last_at: row[9].Int(), status: row[11].Int(), commit: row[12].Text(), held: row[13].Int()}
}

// listGroups lists the failure groups, most recently seen first (?state=open or closed); the cursor is
// "<last seen>.<id>".
fn listGroups(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, needReplay)
	if c == nil {
		return
	}
	let (page, err) = readGroups(c, q.Param("state"), q.Param("cursor"), pageLimit(q))
	if err != nil {
		answerErr(mut w, err)
		return
	}
	send(mut w, page)
}

fn readGroups(c call, state str, cursor str, n i64) !groupPage {
	let (before, beforeId) = try cursorOf(cursor)
	mut out = groupPage{groups: []groupOut{}, next: ""}
	try within readWithin + 0 {
		try limit memory apiMemory + 0 {
			mut page = groupPage{groups: []groupOut{}, next: ""}
			let repoId = c.r.Id
			let more = n + 1
			let rows = try c.d.Db.Query("SELECT g.id, g.state, g.panic, g.route, g.count, g.fixed_by, g.reopened_by, g.decl, (extract(epoch FROM g.first_at))::bigint, (extract(epoch FROM g.last_at))::bigint, (extract(epoch FROM g.last_at) * 1000000)::bigint AS t, coalesce((SELECT c.status FROM capsules c WHERE c.repo_id = g.repo_id AND c.group_id = g.id ORDER BY c.created_at DESC LIMIT 1), 0), coalesce((SELECT c.commit_id FROM capsules c WHERE c.repo_id = g.repo_id AND c.group_id = g.id ORDER BY c.created_at DESC LIMIT 1), ''), (SELECT count(*) FROM capsules c WHERE c.repo_id = g.repo_id AND c.group_id = g.id AND c.expires_at > now()) FROM replay_groups g WHERE g.repo_id = {repoId} AND ({state} = '' OR g.state = {state}) AND ((extract(epoch FROM g.last_at) * 1000000)::bigint, g.id) < ({before}::bigint, {beforeId}) ORDER BY t DESC, g.id DESC LIMIT {more}")
			for i, row in rows.Rows {
				if i == n {
					let last = rows.Rows[n - 1]
					page.next = "{last[10].Int()}.{last[0].Text()}"
					break
				}
				page.groups = append(page.groups, groupOf_(row))
			}
			out = keep(page)
		}
	}
	return out
}

type groupDetail struct {
	group    groupOut
	capsules []capsuleOut
}

// getGroup is one group, with its declaration looked up again when it has none yet, and its newest capsules.
fn getGroup(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, needReplay)
	if c == nil {
		return
	}
	let (g, err) = readGroup(c, q.PathParam("id"))
	if err != nil {
		answerErr(mut w, err)
		return
	}
	send(mut w, g)
}

fn readGroup(c call, id str) !groupDetail {
	mut out ?groupDetail = nil
	try within readWithin + 0 {
		try limit memory apiMemory + 0 {
			let repoId = c.r.Id
			let rows = try c.d.Db.Query("SELECT g.id, g.state, g.panic, g.route, g.count, g.fixed_by, g.reopened_by, g.decl, (extract(epoch FROM g.first_at))::bigint, (extract(epoch FROM g.last_at))::bigint, 0::bigint, coalesce((SELECT c.status FROM capsules c WHERE c.repo_id = g.repo_id AND c.group_id = g.id ORDER BY c.created_at DESC LIMIT 1), 0), coalesce((SELECT c.commit_id FROM capsules c WHERE c.repo_id = g.repo_id AND c.group_id = g.id ORDER BY c.created_at DESC LIMIT 1), ''), (SELECT count(*) FROM capsules c WHERE c.repo_id = g.repo_id AND c.group_id = g.id AND c.expires_at > now()) FROM replay_groups g WHERE g.repo_id = {repoId} AND g.id = {id}")
			if len(rows.Rows) == 0 {
				fail fault.Wrap(ErrNotFound, "no failure group {id}")
			}
			mut g = groupOf_(rows.Rows[0])
			if len(g.decl) == 0 && len(g.panic) > 0 && len(g.commit) > 0 {
				g.decl = try DeclOf(c.d.Db, repoId, g.commit, g.panic)
				if len(g.decl) > 0 {
					_ = try SetDecl(c.d.Db, repoId, g.id, g.decl)
				}
			}
			let page = try readCapsules(c, id, "", pageSize)
			out = keep(groupDetail{group: g, capsules: page.capsules})
		}
	}
	if out == nil {
		fail fault.Wrap(ErrNotFound, "no failure group {id}")
	}
	return out
}

// ---- capsules ----

type capsuleOut struct {
	id         str
	group      str
	commit     str
	name       str
	signer     str
	status     i64
	route      str
	size_bytes i64
	created_at i64
	expires_at i64
}

type capsulePage struct {
	capsules []capsuleOut
	next     str
}

// listCapsules lists the capsules that have not expired, newest first (?group= for one group's); the cursor is
// "<created>.<id>".
fn listCapsules(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, needReplay)
	if c == nil {
		return
	}
	let (page, err) = readCapsules(c, q.Param("group"), q.Param("cursor"), pageLimit(q))
	if err != nil {
		answerErr(mut w, err)
		return
	}
	send(mut w, page)
}

fn capsuleOf(row []postgres.Value) capsuleOut {
	return capsuleOut{id: row[0].Text(), group: row[1].Text(), commit: row[2].Text(), name: row[3].Text(), signer: row[4].Text(), status: row[5].Int(), route: row[6].Text(), size_bytes: row[7].Int(), created_at: row[8].Int(), expires_at: row[9].Int()}
}

fn readCapsules(c call, group str, cursor str, n i64) !capsulePage {
	let (before, beforeId) = try cursorOf(cursor)
	mut out = capsulePage{capsules: []capsuleOut{}, next: ""}
	try within readWithin + 0 {
		try limit memory apiMemory + 0 {
			mut page = capsulePage{capsules: []capsuleOut{}, next: ""}
			let repoId = c.r.Id
			let more = n + 1
			let rows = try c.d.Db.Query("SELECT id, group_id, commit_id, name, signer, status, route, size_bytes, (extract(epoch FROM created_at))::bigint, (extract(epoch FROM expires_at))::bigint, (extract(epoch FROM created_at) * 1000000)::bigint AS t FROM capsules WHERE repo_id = {repoId} AND expires_at > now() AND ({group} = '' OR group_id = {group}) AND ((extract(epoch FROM created_at) * 1000000)::bigint, id) < ({before}::bigint, {beforeId}) ORDER BY t DESC, id DESC LIMIT {more}")
			for i, row in rows.Rows {
				if i == n {
					let last = rows.Rows[n - 1]
					page.next = "{last[10].Int()}.{last[0].Text()}"
					break
				}
				page.capsules = append(page.capsules, capsuleOf(row))
			}
			out = keep(page)
		}
	}
	return out
}

fn getCapsule(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, needReplay)
	if c == nil {
		return
	}
	let (one, err) = readCapsule(c, q.PathParam("id"))
	if err != nil {
		answerErr(mut w, err)
		return
	}
	send(mut w, one)
}

fn readCapsule(c call, id str) !capsuleOut {
	mut out ?capsuleOut = nil
	try within readWithin + 0 {
		try limit memory apiMemory + 0 {
			let repoId = c.r.Id
			let rows = try c.d.Db.Query("SELECT id, group_id, commit_id, name, signer, status, route, size_bytes, (extract(epoch FROM created_at))::bigint, (extract(epoch FROM expires_at))::bigint FROM capsules WHERE repo_id = {repoId} AND id = {id} AND expires_at > now()")
			if len(rows.Rows) > 0 {
				out = keep(capsuleOf(rows.Rows[0]))
			}
		}
	}
	if out == nil {
		fail fault.Wrap(ErrNotFound, "no capsule {id}")
	}
	return out
}

// wholeMax is the largest capsule a download answers in one body.
const wholeMax = 1024 * 1024

// download sends a capsule's sealed bytes as application/octet-stream, read from the store a piece at a time.
fn download(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, needReplay)
	if c == nil {
		return
	}
	let id = q.PathParam("id")
	let (one, err) = readCapsule(c, id)
	if err != nil {
		answerErr(mut w, err)
		return
	}
	mut st = storeOf() catch err2 {
		answerErr(mut w, err2)
		return
	}
	let key = packs.CapsuleKey(c.r.Id, one.id)
	let size = st.Size(key) catch err3 {
		answerErr(mut w, err3)
		return
	}
	if size == nil {
		fail_(mut w, 404, "not_found", "capsule {id} has no bytes in the store")
		return
	}
	w.Type("application/octet-stream")
	w.Head("Content-Disposition", "attachment; filename=\"{one.id}.tcap\"")
	mut buf = make([]u8, 65536)
	// a small capsule (most are) in one answer; a larger one streamed a piece at a time
	if size <= wholeMax {
		mut body = make([]u8, size)
		mut at = 0
		for at < size {
			let k = st.ReadAt(key, at, mut buf) catch err4 {
				answerErr(mut w, err4)
				return
			}
			if k == 0 {
				fail_(mut w, 503, "unavailable", "capsule {id} is shorter than its size")
				return
			}
			for i in 0..k {
				body[at + i] = buf[i]
			}
			at += k
		}
		w.Body = body
		return
	}
	w.Stream() catch _ {
		return
	}
	w.Length(size) catch _ {
		return
	}
	mut off = 0
	for off < size {
		let k = st.ReadAt(key, off, mut buf) catch _ {
			w.Abort()
			return
		}
		if k == 0 {
			w.Abort()
			return
		}
		w.Write(buf[0:k]) catch _ {
			return
		}
		off += k
	}
}

// deleteCapsule deletes a capsule at once (its file, then its row) and records it in the audit log.
fn deleteCapsule(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, needReplay)
	if c == nil {
		return
	}
	let id = q.PathParam("id")
	let (gone, err) = deleteAudited(c, "capsule", id)
	if err != nil {
		answerErr(mut w, err)
		return
	}
	if !gone {
		fail_(mut w, 404, "not_found", "no capsule {id}")
		return
	}
	w.Status(204)
}

// deleteGroup deletes a failure group and every capsule in it.
fn deleteGroup(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, needReplay)
	if c == nil {
		return
	}
	let id = q.PathParam("id")
	let (gone, err) = deleteAudited(c, "group", id)
	if err != nil {
		answerErr(mut w, err)
		return
	}
	if !gone {
		fail_(mut w, 404, "not_found", "no failure group {id}")
		return
	}
	w.Status(204)
}

type auditDetail struct {
	kind str
	id   str
}

fn deleteAudited(c call, kind str, id str) !bool {
	mut gone = false
	try within writeWithin + 0 {
		if kind == "group" {
			gone = try DeleteGroup(c.d.Db, c.r.Id, id)
		} else {
			gone = try Delete(c.d.Db, c.r.Id, id)
		}
		if gone {
			mut b = []u8{}
			argo.Put(mut b, auditDetail{kind: kind, id: id})
			let detail = str(b)
			_ = try c.d.Db.Exec("INSERT INTO audit_log (actor_id, action, target_kind, target_id, detail) VALUES (nullif({c.user}, 0), 'replay.delete', 'repo', {c.r.Id}, {detail}::jsonb)")
		}
	}
	return gone
}

// ---- retention and grants ----

type retentionOut struct {
	days i64
}

fn getRetention(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, needReplay)
	if c == nil {
		return
	}
	let days = RetentionDays(c.d.Db, c.r.Id) catch err {
		answerErr(mut w, err)
		return
	}
	send(mut w, retentionOut{days: days})
}

// putRetention sets the repository's retention ({"days": N}, 1 to 3650); capsules held move to the new expiry.
fn putRetention(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, needAdmin)
	if c == nil {
		return
	}
	mut v = retentionOut{days: 0}
	argo.Get(q.Body(), mut v) catch err {
		fail_(mut w, 400, "bad_request", fault.Message(err))
		return
	}
	if v.days < 1 || v.days > 3650 {
		fail_(mut w, 400, "bad_request", "days must be 1 to 3650, not {v.days}")
		return
	}
	let days = v.days
	_ = SetRetention(c.d.Db, c.r.Id, days) catch err {
		answerErr(mut w, err)
		return
	}
	send(mut w, retentionOut{days: days})
}

// userId is the id of the user named, 0 when there is none.
fn userId(c call, name str) !i64 {
	let rows = try c.d.Db.Query("SELECT u.id FROM users u JOIN owners o ON o.id = u.owner_id WHERE o.name = {name} AND u.deleted_at IS NULL")
	if len(rows.Rows) == 0 {
		return 0
	}
	return rows.Rows[0][0].Int()
}

type grantOut struct {
	user   str
	replay bool
}

type grantList struct {
	users []str
	teams []str
}

// listGrants is who holds the replay permission by a grant: users and teams by name (admins).
fn listGrants(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, needAdmin)
	if c == nil {
		return
	}
	let id = c.r.Id
	let rows = c.d.Db.Query("SELECT coalesce(o.name, ''), coalesce(t.name, '') FROM replay_grants g LEFT JOIN users u ON u.id = g.user_id AND u.deleted_at IS NULL LEFT JOIN owners o ON o.id = u.owner_id LEFT JOIN teams t ON t.id = g.team_id WHERE g.repo_id = {id} ORDER BY 1, 2") catch err {
		answerErr(mut w, err)
		return
	}
	mut out = grantList{users: []str{}, teams: []str{}}
	for x in rows.Rows {
		if len(x[0].Text()) > 0 {
			out.users = append(out.users, x[0].Text())
		} else if len(x[1].Text()) > 0 {
			out.teams = append(out.teams, x[1].Text())
		}
	}
	send(mut w, out)
}

// putGrant gives a user the replay permission.
fn putGrant(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, needAdmin)
	if c == nil {
		return
	}
	let name = q.PathParam("user")
	let id = userId(c, name) catch err {
		answerErr(mut w, err)
		return
	}
	if id == 0 {
		fail_(mut w, 404, "not_found", "no user {name}")
		return
	}
	_ = Grant(c.d.Db, c.r.Id, id) catch err {
		answerErr(mut w, err)
		return
	}
	send(mut w, grantOut{user: name, replay: true})
}

// deleteGrant takes a user's replay grant away.
fn deleteGrant(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, needAdmin)
	if c == nil {
		return
	}
	let name = q.PathParam("user")
	let id = userId(c, name) catch err {
		answerErr(mut w, err)
		return
	}
	if id == 0 {
		fail_(mut w, 404, "not_found", "no user {name}")
		return
	}
	_ = Revoke(c.d.Db, c.r.Id, id) catch err {
		answerErr(mut w, err)
		return
	}
	send(mut w, grantOut{user: name, replay: false})
}
