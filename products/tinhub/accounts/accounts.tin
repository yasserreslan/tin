package accounts

import "../../tit/transport"
import "fault"
import "postgres"
import "twine"

// tinhub's accounts and access (design/tinhub.md §5, #1012): users and orgs sharing one owner namespace, org members
// and teams, repositories and their grants, ed25519 keys, invites, sign-in with a key and browser sessions. There are
// no passwords. Every change to who may do what is one transaction that also writes its audit_log row.

// The roles a user has on a repository, ordered: a role allows everything the roles below it allow.
const RoleNone = 0
const RoleRead = 1
const RoleWrite = 2
const RoleAdmin = 3

// ErrNotFound is the fault of a user, org, team, repository, key or invite that does not exist, and of a private
// repository the actor cannot read (it answers 404, never 403).
let ErrNotFound = fault("not found")

// ErrForbidden is the fault of an action the actor may see but not do.
let ErrForbidden = fault("forbidden")

// ErrExists is the fault of a name, email or key that is taken.
let ErrExists = fault("already exists")

// ErrInvalid is the fault of a bad name, email, role, visibility or key.
let ErrInvalid = fault("invalid")

// User is an account: its id, its owner row (the name in /<owner>/…), its email and whether it administers the site.
type User struct {
	Id        i64
	OwnerId   i64
	Name      str
	Email     str
	SiteAdmin bool
}

// Org is an organization: its id, its owner row and name, and its display name.
type Org struct {
	Id      i64
	OwnerId i64
	Name    str
	Display str
}

// Team is a named group of an org's members that grants can name.
type Team struct {
	Id    i64
	OrgId i64
	Name  str
}

// Actor is who makes a change, for the access checks and the audit log: a user's id (0 for tinhub itself, as the
// tinhub admin commands are) and the address the request came from ("" for none).
type Actor struct {
	Id i64
	Ip str
}

// System is tinhub itself acting: the admin commands, and migrations of data.
fn System() Actor {
	return Actor{Id: 0, Ip: ""}
}

// RoleName is a role's name in the grants table: "read", "write", "admin", or "none".
fn RoleName(role i64) str {
	return match role {
		RoleRead => "read"
		RoleWrite => "write"
		RoleAdmin => "admin"
		_ => "none"
	}
}

// ParseRole reads a role's name; "none" is RoleNone.
fn ParseRole(s str) !i64 {
	return match s {
		"none" => RoleNone
		"read" => RoleRead
		"write" => RoleWrite
		"admin" => RoleAdmin
		_ => fail fault.Wrap(ErrInvalid, "no role {s}: read, write or admin")
	}
}

// ValidOwnerName reports whether name may name a user or org: [a-z0-9][a-z0-9-]{0,38}.
fn ValidOwnerName(name str) bool {
	if len(name) == 0 || len(name) > 39 {
		return false
	}
	for i in 0..len(name) {
		let b = name[i]
		let ok = (b >= 'a' && b <= 'z') || (b >= '0' && b <= '9') || (b == '-' && i > 0)
		if !ok {
			return false
		}
	}
	return true
}

// ValidRepoName reports whether name may name a repository: [A-Za-z0-9._-]{1,100}, not . or .., not ending in .tit.
fn ValidRepoName(name str) bool {
	if len(name) == 0 || len(name) > 100 || name == "." || name == ".." || twine.HasSuffix(name, ".tit") {
		return false
	}
	for i in 0..len(name) {
		let b = name[i]
		let ok = (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9') || b == '.' || b == '_' || b == '-'
		if !ok {
			return false
		}
	}
	return true
}

// validEmail is a loose check: one @ with text on both sides, no spaces or control bytes (it goes in a header).
fn validEmail(email str) bool {
	let at = twine.IndexByte(email, '@')
	if at <= 0 || at == len(email) - 1 || len(email) > 254 || twine.Count(email, "@") != 1 {
		return false
	}
	for i in 0..len(email) {
		if email[i] <= ' ' || email[i] == 127 {
			return false
		}
	}
	return true
}

// isUnique reports whether err is Postgres refusing a duplicate key (SQLSTATE 23505).
fn isUnique(err fault) bool {
	return twine.Index(fault.Message(err), " 23505: ") >= 0
}

// audit writes an audit_log row in tx: by did action to the target; detail is key, value pairs (JSON strings).
fn audit(tx mut postgres.Tx, by Actor, action str, kind str, id i64, detail []str) ! {
	mut m = map[str]str{}
	mut i = 0
	for i + 1 < len(detail) {
		m[detail[i]] = detail[i + 1]
		i += 2
	}
	let text = transport.Encode(m)
	let actor = by.Id
	let ip = by.Ip
	_ = try tx.Exec("INSERT INTO audit_log (actor_id, action, target_kind, target_id, detail, ip) VALUES (nullif({actor}, 0), {action}, {kind}, {id}, {text}::jsonb, {ip})")
}

// rollback ends a failed transaction; its own fault is dropped, the caller's is the one that matters.
fn rollback(tx mut postgres.Tx) {
	tx.Rollback() catch _ {
	}
}

// ---- users ----

fn userOf(rows postgres.Rows) ?User {
	if len(rows.Rows) == 0 {
		return nil
	}
	let r = rows.Rows[0]
	return User{Id: r[0].Int(), OwnerId: r[1].Int(), Name: r[2].Text(), Email: r[3].Text(), SiteAdmin: r[4].Int() == 1}
}

// UserByEmail is the live user with this email (case-insensitive), or nil.
fn UserByEmail(c postgres.Client, email str) !?User {
	let rows = try c.Query("SELECT u.id, u.owner_id, o.name, u.email, u.site_admin FROM users u JOIN owners o ON o.id = u.owner_id WHERE lower(u.email) = lower({email}) AND u.deleted_at IS NULL")
	return userOf(rows)
}

// UserById is the live user with this id, or nil.
fn UserById(c postgres.Client, id i64) !?User {
	let rows = try c.Query("SELECT u.id, u.owner_id, o.name, u.email, u.site_admin FROM users u JOIN owners o ON o.id = u.owner_id WHERE u.id = {id} AND u.deleted_at IS NULL")
	return userOf(rows)
}

// UserByName is the live user whose owner name is name, or nil.
fn UserByName(c postgres.Client, name str) !?User {
	let rows = try c.Query("SELECT u.id, u.owner_id, o.name, u.email, u.site_admin FROM users u JOIN owners o ON o.id = u.owner_id WHERE o.name = lower({name}) AND u.deleted_at IS NULL")
	return userOf(rows)
}

// isSiteAdmin reports whether user id is a live site admin.
fn isSiteAdmin(tx mut postgres.Tx, id i64) !bool {
	if id == 0 {
		return false
	}
	let rows = try tx.Query("SELECT 1 FROM users WHERE id = {id} AND site_admin AND deleted_at IS NULL")
	return len(rows.Rows) == 1
}

// mayAdminister reports whether by may act as an administrator of the site: tinhub itself or a site admin.
fn mayAdminister(tx mut postgres.Tx, by Actor) !bool {
	if by.Id == 0 {
		return true
	}
	return try isSiteAdmin(mut tx, by.Id)
}

// CreateUser makes an account named name (its owner name) with email; only tinhub itself or a site admin may.
fn CreateUser(c postgres.Client, by Actor, name str, email str, siteAdmin bool) !User {
	mut tx = try c.Begin()
	let (u, err) = createUserIn(mut tx, by, name, email, siteAdmin)
	if err != nil {
		rollback(mut tx)
		fail err
	}
	try tx.Commit()
	return u
}

fn createUserIn(tx mut postgres.Tx, by Actor, name str, email str, siteAdmin bool) !User {
	let admin = try mayAdminister(mut tx, by)
	if !admin {
		fail fault.Wrap(ErrForbidden, "only a site admin makes accounts")
	}
	return try newUser(mut tx, by, name, email, siteAdmin)
}

// newUser inserts the owner and user rows, with no access check.
fn newUser(tx mut postgres.Tx, by Actor, name str, email str, siteAdmin bool) !User {
	if !ValidOwnerName(name) {
		fail fault.Wrap(ErrInvalid, "{name}: a name is 1 to 39 of a-z, 0-9 and -, not starting with -")
	}
	if !validEmail(email) {
		fail fault.Wrap(ErrInvalid, "{email} is not an email address")
	}
	let o = try tx.Query("INSERT INTO owners (name, kind) VALUES ({name}, 'user') ON CONFLICT DO NOTHING RETURNING id")
	if len(o.Rows) == 0 {
		fail fault.Wrap(ErrExists, "the name {name} is taken")
	}
	let owner = o.Rows[0][0].Int()
	let u = try tx.Query("INSERT INTO users (owner_id, email, site_admin) VALUES ({owner}, {email}, {siteAdmin}) ON CONFLICT DO NOTHING RETURNING id")
	if len(u.Rows) == 0 {
		fail fault.Wrap(ErrExists, "an account with email {email} exists")
	}
	let id = u.Rows[0][0].Int()
	mut admin = "false"
	if siteAdmin {
		admin = "true"
	}
	try audit(mut tx, by, "user.create", "user", id, []str{"name", name, "email", email, "site_admin", admin})
	return User{Id: id, OwnerId: owner, Name: name, Email: email, SiteAdmin: siteAdmin}
}

// SetSiteAdmin makes a user a site admin or not; only tinhub itself or a site admin may.
fn SetSiteAdmin(c postgres.Client, by Actor, userId i64, on bool) ! {
	mut tx = try c.Begin()
	let err = setSiteAdminIn(mut tx, by, userId, on)
	if err != nil {
		rollback(mut tx)
		fail err
	}
	try tx.Commit()
}

fn setSiteAdminIn(tx mut postgres.Tx, by Actor, userId i64, on bool) ! {
	let admin = try mayAdminister(mut tx, by)
	if !admin {
		fail fault.Wrap(ErrForbidden, "only a site admin names site admins")
	}
	let r = try tx.Exec("UPDATE users SET site_admin = {on} WHERE id = {userId} AND deleted_at IS NULL")
	if r.Affected == 0 {
		fail fault.Wrap(ErrNotFound, "no user {userId}")
	}
	mut v = "false"
	if on {
		v = "true"
	}
	try audit(mut tx, by, "user.site_admin", "user", userId, []str{"site_admin", v})
}

// DeleteUser soft-deletes an account: it signs in no more, its keys stop working and it has no role anywhere. The
// user or a site admin may. Its sessions end at their next lookup (SessionUser checks the account).
fn DeleteUser(c postgres.Client, by Actor, userId i64) ! {
	mut tx = try c.Begin()
	let err = deleteUserIn(mut tx, by, userId)
	if err != nil {
		rollback(mut tx)
		fail err
	}
	try tx.Commit()
}

fn deleteUserIn(tx mut postgres.Tx, by Actor, userId i64) ! {
	let admin = try mayAdminister(mut tx, by)
	if !admin && by.Id != userId {
		fail fault.Wrap(ErrForbidden, "only the user or a site admin deletes an account")
	}
	let r = try tx.Exec("UPDATE users SET deleted_at = now() WHERE id = {userId} AND deleted_at IS NULL")
	if r.Affected == 0 {
		fail fault.Wrap(ErrNotFound, "no user {userId}")
	}
	_ = try tx.Exec("UPDATE keys SET revoked_at = now() WHERE user_id = {userId} AND revoked_at IS NULL")
	try audit(mut tx, by, "user.delete", "user", userId, []str{})
}
