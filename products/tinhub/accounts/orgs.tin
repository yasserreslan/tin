package accounts

import "fault"
import "postgres"

// Orgs, their members (member or owner) and their teams. An org's owners administer it and every repository it owns;
// a member has no role of its own on the org's repositories beyond what grants (to it or its teams) and public
// visibility give.

fn orgOf(rows postgres.Rows) ?Org {
	if len(rows.Rows) == 0 {
		return nil
	}
	let r = rows.Rows[0]
	return Org{Id: r[0].Int(), OwnerId: r[1].Int(), Name: r[2].Text(), Display: r[3].Text()}
}

// OrgByName is the live org called name, or nil.
fn OrgByName(c postgres.Client, name str) !?Org {
	let rows = try c.Query("SELECT g.id, g.owner_id, o.name, g.display FROM orgs g JOIN owners o ON o.id = g.owner_id WHERE o.name = lower({name}) AND g.deleted_at IS NULL")
	return orgOf(rows)
}

// OrgById is the live org with this id, or nil.
fn OrgById(c postgres.Client, id i64) !?Org {
	let rows = try c.Query("SELECT g.id, g.owner_id, o.name, g.display FROM orgs g JOIN owners o ON o.id = g.owner_id WHERE g.id = {id} AND g.deleted_at IS NULL")
	return orgOf(rows)
}

// isOrgOwner reports whether user id is an owner of the live org orgId.
fn isOrgOwner(tx mut postgres.Tx, orgId i64, id i64) !bool {
	if id == 0 {
		return false
	}
	let rows = try tx.Query("SELECT 1 FROM members m JOIN orgs g ON g.id = m.org_id JOIN users u ON u.id = m.user_id WHERE m.org_id = {orgId} AND m.user_id = {id} AND m.role = 'owner' AND g.deleted_at IS NULL AND u.deleted_at IS NULL")
	return len(rows.Rows) == 1
}

// mayAdministerOrg reports whether by may change the org: tinhub itself, a site admin or one of its owners.
fn mayAdministerOrg(tx mut postgres.Tx, by Actor, orgId i64) !bool {
	let admin = try mayAdminister(mut tx, by)
	if admin {
		return true
	}
	return try isOrgOwner(mut tx, orgId, by.Id)
}

// CreateOrg makes an org called name; the user making it (by, unless it is tinhub itself) is its first owner.
fn CreateOrg(c postgres.Client, by Actor, name str, display str) !Org {
	mut tx = try c.Begin()
	let (g, err) = createOrgIn(mut tx, by, name, display)
	if err != nil {
		rollback(mut tx)
		fail err
	}
	try tx.Commit()
	return g
}

fn createOrgIn(tx mut postgres.Tx, by Actor, name str, display str) !Org {
	if !ValidOwnerName(name) {
		fail fault.Wrap(ErrInvalid, "{name}: a name is 1 to 39 of a-z, 0-9 and -, not starting with -")
	}
	if by.Id != 0 {
		let live = try tx.Query("SELECT 1 FROM users WHERE id = {by.Id} AND deleted_at IS NULL")
		if len(live.Rows) == 0 {
			fail fault.Wrap(ErrForbidden, "no user {by.Id} to own the org")
		}
	}
	let o = try tx.Query("INSERT INTO owners (name, kind) VALUES ({name}, 'org') ON CONFLICT DO NOTHING RETURNING id")
	if len(o.Rows) == 0 {
		fail fault.Wrap(ErrExists, "the name {name} is taken")
	}
	let owner = o.Rows[0][0].Int()
	let g = try tx.Query("INSERT INTO orgs (owner_id, display) VALUES ({owner}, {display}) RETURNING id")
	let id = g.Rows[0][0].Int()
	try audit(mut tx, by, "org.create", "org", id, []str{"name", name})
	if by.Id != 0 {
		_ = try tx.Exec("INSERT INTO members (org_id, user_id, role) VALUES ({id}, {by.Id}, 'owner')")
		try audit(mut tx, by, "org.member", "org", id, []str{"user", "{by.Id}", "role", "owner"})
	}
	return Org{Id: id, OwnerId: owner, Name: name, Display: display}
}

// SetMember makes a user a member ("member") or an owner ("owner") of the org, or no longer a member (""), which
// also takes it out of the org's teams. The org's last owner stays. Org owners and site admins may.
fn SetMember(c postgres.Client, by Actor, orgId i64, userId i64, role str) ! {
	mut tx = try c.Begin()
	let err = setMemberIn(mut tx, by, orgId, userId, role)
	if err != nil {
		rollback(mut tx)
		fail err
	}
	try tx.Commit()
}

fn setMemberIn(tx mut postgres.Tx, by Actor, orgId i64, userId i64, role str) ! {
	if role != "" && role != "member" && role != "owner" {
		fail fault.Wrap(ErrInvalid, "no org role {role}: member or owner")
	}
	let g = try tx.Query("SELECT 1 FROM orgs WHERE id = {orgId} AND deleted_at IS NULL FOR UPDATE")
	if len(g.Rows) == 0 {
		fail fault.Wrap(ErrNotFound, "no org {orgId}")
	}
	let may = try mayAdministerOrg(mut tx, by, orgId)
	if !may {
		fail fault.Wrap(ErrForbidden, "only an owner of the org changes its members")
	}
	let u = try tx.Query("SELECT 1 FROM users WHERE id = {userId} AND deleted_at IS NULL")
	if len(u.Rows) == 0 {
		fail fault.Wrap(ErrNotFound, "no user {userId}")
	}
	if role != "owner" {
		// the org row is locked: two owners demoting each other cannot both pass this
		let owners = try tx.Query("SELECT count(*) FILTER (WHERE user_id <> {userId}), count(*) FILTER (WHERE user_id = {userId}) FROM members WHERE org_id = {orgId} AND role = 'owner'")
		if owners.Rows[0][1].Int() == 1 && owners.Rows[0][0].Int() == 0 {
			fail fault.Wrap(ErrInvalid, "user {userId} is the org's last owner")
		}
	}
	if role == "" {
		_ = try tx.Exec("DELETE FROM members WHERE org_id = {orgId} AND user_id = {userId}")
		_ = try tx.Exec("DELETE FROM team_members WHERE user_id = {userId} AND team_id IN (SELECT id FROM teams WHERE org_id = {orgId})")
		try audit(mut tx, by, "org.member.remove", "org", orgId, []str{"user", "{userId}"})
		return
	}
	_ = try tx.Exec("INSERT INTO members (org_id, user_id, role) VALUES ({orgId}, {userId}, {role}) ON CONFLICT (org_id, user_id) DO UPDATE SET role = excluded.role")
	try audit(mut tx, by, "org.member", "org", orgId, []str{"user", "{userId}", "role", role})
}

// MemberRole is the user's role in the org: "owner", "member", or "" for none.
fn MemberRole(c postgres.Client, orgId i64, userId i64) !str {
	let rows = try c.Query("SELECT role FROM members WHERE org_id = {orgId} AND user_id = {userId}")
	if len(rows.Rows) == 0 {
		return ""
	}
	return rows.Rows[0][0].Text()
}

// CreateTeam makes a team in the org; org owners and site admins may.
fn CreateTeam(c postgres.Client, by Actor, orgId i64, name str) !Team {
	mut tx = try c.Begin()
	let (t, err) = createTeamIn(mut tx, by, orgId, name)
	if err != nil {
		rollback(mut tx)
		fail err
	}
	try tx.Commit()
	return t
}

fn createTeamIn(tx mut postgres.Tx, by Actor, orgId i64, name str) !Team {
	if !ValidOwnerName(name) {
		fail fault.Wrap(ErrInvalid, "{name}: a team name is 1 to 39 of a-z, 0-9 and -, not starting with -")
	}
	let g = try tx.Query("SELECT 1 FROM orgs WHERE id = {orgId} AND deleted_at IS NULL")
	if len(g.Rows) == 0 {
		fail fault.Wrap(ErrNotFound, "no org {orgId}")
	}
	let may = try mayAdministerOrg(mut tx, by, orgId)
	if !may {
		fail fault.Wrap(ErrForbidden, "only an owner of the org makes teams")
	}
	let rows = try tx.Query("INSERT INTO teams (org_id, name) VALUES ({orgId}, {name}) ON CONFLICT DO NOTHING RETURNING id")
	if len(rows.Rows) == 0 {
		fail fault.Wrap(ErrExists, "the org has a team {name}")
	}
	let id = rows.Rows[0][0].Int()
	try audit(mut tx, by, "team.create", "team", id, []str{"org", "{orgId}", "name", name})
	return Team{Id: id, OrgId: orgId, Name: name}
}

// TeamByName is the org's team called name, or nil.
fn TeamByName(c postgres.Client, orgId i64, name str) !?Team {
	let rows = try c.Query("SELECT id FROM teams WHERE org_id = {orgId} AND name = {name}")
	if len(rows.Rows) == 0 {
		return nil
	}
	return Team{Id: rows.Rows[0][0].Int(), OrgId: orgId, Name: name}
}

// DeleteTeam removes a team, its members and its grants; org owners and site admins may.
fn DeleteTeam(c postgres.Client, by Actor, teamId i64) ! {
	mut tx = try c.Begin()
	let err = deleteTeamIn(mut tx, by, teamId)
	if err != nil {
		rollback(mut tx)
		fail err
	}
	try tx.Commit()
}

fn deleteTeamIn(tx mut postgres.Tx, by Actor, teamId i64) ! {
	let orgId = try teamOrg(mut tx, teamId)
	let may = try mayAdministerOrg(mut tx, by, orgId)
	if !may {
		fail fault.Wrap(ErrForbidden, "only an owner of the org deletes teams")
	}
	_ = try tx.Exec("DELETE FROM teams WHERE id = {teamId}")
	try audit(mut tx, by, "team.delete", "team", teamId, []str{"org", "{orgId}"})
}

fn teamOrg(tx mut postgres.Tx, teamId i64) !i64 {
	let rows = try tx.Query("SELECT org_id FROM teams WHERE id = {teamId}")
	if len(rows.Rows) == 0 {
		fail fault.Wrap(ErrNotFound, "no team {teamId}")
	}
	return rows.Rows[0][0].Int()
}

// SetTeamMember adds a member of the org to the team (add true) or takes it out; org owners and site admins may.
fn SetTeamMember(c postgres.Client, by Actor, teamId i64, userId i64, add bool) ! {
	mut tx = try c.Begin()
	let err = setTeamMemberIn(mut tx, by, teamId, userId, add)
	if err != nil {
		rollback(mut tx)
		fail err
	}
	try tx.Commit()
}

fn setTeamMemberIn(tx mut postgres.Tx, by Actor, teamId i64, userId i64, add bool) ! {
	let orgId = try teamOrg(mut tx, teamId)
	let may = try mayAdministerOrg(mut tx, by, orgId)
	if !may {
		fail fault.Wrap(ErrForbidden, "only an owner of the org changes its teams")
	}
	if !add {
		_ = try tx.Exec("DELETE FROM team_members WHERE team_id = {teamId} AND user_id = {userId}")
		try audit(mut tx, by, "team.member.remove", "team", teamId, []str{"user", "{userId}"})
		return
	}
	let m = try tx.Query("SELECT 1 FROM members WHERE org_id = {orgId} AND user_id = {userId}")
	if len(m.Rows) == 0 {
		fail fault.Wrap(ErrInvalid, "user {userId} is not a member of the team's org")
	}
	_ = try tx.Exec("INSERT INTO team_members (team_id, user_id) VALUES ({teamId}, {userId}) ON CONFLICT DO NOTHING")
	try audit(mut tx, by, "team.member", "team", teamId, []str{"user", "{userId}"})
}
