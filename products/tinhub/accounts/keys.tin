package accounts

import "../../tit/transport"
import "fault"
import "postgres"
import "seal"

// Keys: a user's ed25519 public keys, the same keys tit key makes. One key both signs commits and authorizes requests
// (Tit-Signature, design/tit.md §15). A removed key is revoked, not deleted: checks and the audit log still name it,
// and the same key added again by its user is live again.

// Key is one of a user's keys: the raw 32-byte public key, a name, and when it was added and last used (unix
// seconds, 0 for never).
type Key struct {
	Id       i64
	UserId   i64
	Public   []u8
	Name     str
	Created  i64
	LastUsed i64
}

// refused is the fault of a protocol request turned down, as tit's server writes it: transport.ErrRefused, "Code: …".
fn refused(c transport.Code, message str) ! {
	fail fault.Wrap(transport.ErrRefused, transport.CodeName(c) + ": " + message)
}

// AddKey adds a raw 32-byte ed25519 public key to a user (the user or a site admin may). A key another user holds,
// or one the user holds already, is ErrExists.
fn AddKey(c postgres.Client, by Actor, userId i64, pub []u8, name str) !Key {
	mut tx = try c.Begin()
	let (k, err) = addKeyIn(mut tx, by, userId, pub, name)
	if err != nil {
		rollback(mut tx)
		fail err
	}
	try tx.Commit()
	return k
}

fn addKeyIn(tx mut postgres.Tx, by Actor, userId i64, pub []u8, name str) !Key {
	let admin = try mayAdminister(mut tx, by)
	if !admin && by.Id != userId {
		fail fault.Wrap(ErrForbidden, "only the user or a site admin adds a user's keys")
	}
	return try newKey(mut tx, by, userId, pub, name)
}

// newKey adds the key with no access check.
fn newKey(tx mut postgres.Tx, by Actor, userId i64, pub []u8, name str) !Key {
	if len(pub) != 32 {
		fail fault.Wrap(ErrInvalid, "an ed25519 public key has 32 bytes, not {len(pub)}")
	}
	let u = try tx.Query("SELECT 1 FROM users WHERE id = {userId} AND deleted_at IS NULL")
	if len(u.Rows) == 0 {
		fail fault.Wrap(ErrNotFound, "no user {userId}")
	}
	let text = seal.B64(pub)
	let have = try tx.Query("SELECT id, user_id, revoked_at IS NOT NULL FROM keys WHERE public_key = {text} FOR UPDATE")
	mut id = 0
	if len(have.Rows) == 1 {
		if have.Rows[0][1].Int() != userId || have.Rows[0][2].Int() == 0 {
			fail fault.Wrap(ErrExists, "the key {text} is registered")
		}
		id = have.Rows[0][0].Int()
		_ = try tx.Exec("UPDATE keys SET revoked_at = NULL, name = {name}, created_at = now(), last_used_at = NULL WHERE id = {id}")
	} else {
		let rows = try tx.Query("INSERT INTO keys (user_id, public_key, name) VALUES ({userId}, {text}, {name}) ON CONFLICT DO NOTHING RETURNING id")
		if len(rows.Rows) == 0 {
			fail fault.Wrap(ErrExists, "the key {text} is registered")
		}
		id = rows.Rows[0][0].Int()
	}
	try audit(mut tx, by, "key.add", "user", userId, []str{"key", "{id}", "public", text, "name", name})
	let row = try tx.Query("SELECT extract(epoch FROM created_at)::bigint FROM keys WHERE id = {id}")
	return Key{Id: id, UserId: userId, Public: pub, Name: name, Created: row.Rows[0][0].Int(), LastUsed: 0}
}

// RemoveKey revokes one of a user's keys (the user or a site admin may): requests it signs are refused from now on.
fn RemoveKey(c postgres.Client, by Actor, keyId i64) ! {
	mut tx = try c.Begin()
	let err = removeKeyIn(mut tx, by, keyId)
	if err != nil {
		rollback(mut tx)
		fail err
	}
	try tx.Commit()
}

fn removeKeyIn(tx mut postgres.Tx, by Actor, keyId i64) ! {
	let rows = try tx.Query("SELECT user_id, public_key FROM keys WHERE id = {keyId} AND revoked_at IS NULL FOR UPDATE")
	if len(rows.Rows) == 0 {
		fail fault.Wrap(ErrNotFound, "no key {keyId}")
	}
	let userId = rows.Rows[0][0].Int()
	let admin = try mayAdminister(mut tx, by)
	if !admin && by.Id != userId {
		fail fault.Wrap(ErrNotFound, "no key {keyId}")
	}
	_ = try tx.Exec("UPDATE keys SET revoked_at = now() WHERE id = {keyId}")
	try audit(mut tx, by, "key.remove", "user", userId, []str{"key", "{keyId}", "public", rows.Rows[0][1].Text()})
}

// Keys is the user's live keys, oldest first.
fn Keys(c postgres.Client, userId i64) ![]Key {
	let rows = try c.Query("SELECT k.id, k.public_key, k.name, extract(epoch FROM k.created_at)::bigint, coalesce(extract(epoch FROM k.last_used_at)::bigint, 0) FROM keys k JOIN users u ON u.id = k.user_id WHERE k.user_id = {userId} AND k.revoked_at IS NULL AND u.deleted_at IS NULL ORDER BY k.id")
	mut out = []Key{}
	for r in rows.Rows {
		let pub = try seal.B64Decode(r[1].Text())
		out = append(out, Key{Id: r[0].Int(), UserId: userId, Public: pub, Name: r[2].Text(), Created: r[3].Int(), LastUsed: r[4].Int()})
	}
	return out
}

// KeysOf is the user's live keys as raw 32-byte ed25519 public keys; none for a deleted user.
fn KeysOf(c postgres.Client, userId i64) ![][]u8 {
	let ks = try Keys(c, userId)
	mut out = [][]u8{}
	for k in ks {
		out = append(out, k.Public)
	}
	return out
}

// VerifySigned checks a request's Tit-Signature header (design/tit.md §15): the nonce is one nonceKey made less than a
// minute before now (unix seconds), and the signature over method, path and the body's SHA-256 (hex) is one of the
// signer's live keys. It returns the signer, and records the key's use. A refusal is transport.ErrRefused with
// Unauthorized or NonceExpired, as tit's server answers. Replays inside the minute are the caller's to refuse (a push's
// version check, or a seen-nonce set).
fn VerifySigned(c postgres.Client, nonceKey secret str, method str, path str, signature str, bodyHash str, now i64) !User {
	if len(signature) == 0 {
		try refused(transport.Code.Unauthorized, "sign the request with your key (tit key makes one)")
	}
	let (email, nonce, sig) = try transport.ParseSignatureHeader(signature)
	try transport.CheckNonce(nonceKey, nonce, now)
	let u = try UserByEmail(c, email)
	if u == nil {
		try refused(transport.Code.Unauthorized, "no key of {email} is registered here")
		return User{Id: 0, OwnerId: 0, Name: "", Email: "", SiteAdmin: false}
	}
	let keys = try KeysOf(c, u.Id)
	let payload = []u8(transport.SigningPayloadOf(method, path, nonce, bodyHash))
	for k in keys {
		let verr = seal.VerifyEd25519(k, payload, sig)
		if verr == nil {
			let text = seal.B64(k)
			_ = try c.Exec("UPDATE keys SET last_used_at = now() WHERE public_key = {text}")
			return u
		}
	}
	try refused(transport.Code.Unauthorized, "the signature is not {email}'s")
	return u
}
