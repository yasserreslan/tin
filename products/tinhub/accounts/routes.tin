package accounts

import "../../tit/transport"
import "fault"
import "herald"
import "postgres"
import "seal"
import "twine"

// The sign-in and key requests of design/tit.md §18 as tinhub answers them, for the node's router to mount
// (design/tinhub.md §4): POST /tit/v1/login, GET|POST /tit/v1/login/<code> and POST /tit/v1/keys, at the root or under
// a repository's URL (tit login takes a remote's URL). Success answers are JSON; refusals are tit error frames, with a
// fresh nonce on Unauthorized and NonceExpired, as tit's server sends them.

// Service is what the sign-in requests need: the database, the session store, the nonce key (secrets.nonce), the
// cookie key (secrets.cookie) and the service's public URL (public_url).
type Service struct {
	Db        postgres.Client
	Sessions  Sessions
	NonceKey  secret str
	CookieKey secret str
	PublicUrl str
}

// Answer is what to answer a request with; LoginCookie, when set, is the claim token to set as cookie
// LoginCookieName (HttpOnly, Secure, SameSite=Lax, Max-Age LoginTTL).
type Answer struct {
	Status      i64
	Body        str
	ContentType str
	LoginCookie str
}

// CodeOf is the protocol code and message for a fault of this package: a refusal's own code; NotFound, BadRequest
// (ErrInvalid), Moved (ErrExists) and Unauthorized (ErrForbidden) for the sentinels; Internal for anything else, whose
// text stays in the log.
fn CodeOf(err fault) (transport.Code, str) {
	mut m = fault.Message(err)
	if fault.Is(err, transport.ErrRefused) {
		let tail = ": " + fault.Message(transport.ErrRefused)
		if twine.HasSuffix(m, tail) {
			m = m[0:len(m) - len(tail)]
		}
		let colon = twine.Index(m, ": ")
		if colon > 0 {
			let name = m[0:colon]
			let c = transport.ParseCode(name)
			if transport.CodeName(c) == name {
				return c, m[colon + 2:]
			}
		}
	}
	if fault.Is(err, ErrNotFound) {
		return transport.Code.NotFound, m
	}
	if fault.Is(err, ErrInvalid) {
		return transport.Code.BadRequest, m
	}
	if fault.Is(err, ErrExists) {
		return transport.Code.Moved, m
	}
	if fault.Is(err, ErrForbidden) {
		return transport.Code.Unauthorized, m
	}
	herald.Log(herald.LError, "accounts", []str{"error", m})
	return transport.Code.Internal, "internal error"
}

fn json(body str) Answer {
	return Answer{Status: 200, Body: body, ContentType: "application/json", LoginCookie: ""}
}

// refusal is the error frame answering err.
fn (s Service) refusal(err fault, now i64) Answer {
	let (c, m) = CodeOf(err)
	mut nonce = ""
	if c == transport.Code.Unauthorized || c == transport.Code.NonceExpired {
		nonce = transport.NewNonce(s.NonceKey, now)
	}
	let head = transport.Encode(transport.ErrorAnswer{Code: transport.CodeName(c), Message: m, Ref: "", Nonce: nonce})
	return Answer{Status: transport.Status(c), Body: transport.Frame(transport.Kind.Error, head, ""), ContentType: "application/x-tit", LoginCookie: ""}
}

// Handle answers a §18 request: method and path as received (the path is what a signature covers), the Tit-Signature
// header ("" for none), the body, the client's address and the time (unix seconds).
fn (s Service) Handle(method str, path str, signature str, body str, ip str, now i64) Answer {
	let (a, err) = s.route(method, path, signature, body, ip, now)
	if err != nil {
		return s.refusal(err, now)
	}
	return a
}

fn (s Service) route(method str, path str, signature str, body str, ip str, now i64) !Answer {
	let at = twine.Index(path, "/tit/v1/")
	if at < 0 {
		try refused(transport.Code.NotFound, "no such request: {method} {path}")
	}
	let tail = path[at + 8:]
	if tail == "keys" && method == "POST" {
		let u = try KeyAdd(s.Db, s.NonceKey, path, signature, body, ip, now)
		return json(transport.Encode(transport.LoginState{State: "added", Email: u.Email, Expires: 0}))
	}
	if tail == "login" && method == "POST" {
		let (ans, claim) = try LoginNew(s.Db, s.CookieKey, s.PublicUrl)
		mut a = json(transport.Encode(ans))
		a.LoginCookie = claim
		return a
	}
	if twine.HasPrefix(tail, "login/") {
		let code = tail[6:]
		if method == "GET" {
			let st = try LoginRead(s.Db, code)
			return json(transport.Encode(st))
		}
		if method == "POST" {
			let u = try VerifySigned(s.Db, s.NonceKey, method, path, signature, seal.Hex(seal.Sha256(body)), now)
			let st = try LoginApprove(s.Db, code, u, ip)
			return json(transport.Encode(st))
		}
	}
	try refused(transport.Code.NotFound, "no such request: {method} {path}")
	return json("")
}

// Claim turns the approved login request code into a session for the browser whose claim token (cookie
// LoginCookieName) is claim: the session cookie to set.
fn (s Service) Claim(code str, claim str, ip str) !Session {
	return try LoginClaim(s.Db, s.Sessions, s.CookieKey, code, claim, ip)
}
