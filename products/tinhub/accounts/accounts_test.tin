package accounts

import "../../tit/transport"
import "../db"
import "argo"
import "crucible"
import "fault"
import "postgres"
import "quarry"
import "seal"

// Tests for accounts (#1012). The Postgres tests run when TINHUB_TEST_DB is set (and empty that database); the
// session tests use the Redis at TINHUB_TEST_REDIS (host:port) under a fresh key prefix, and are skipped without it.

fn testDb(t mut crucible.T) ?postgres.Client {
	let (o, ok) = db.TestOptions()
	if !ok {
		t.Log("TINHUB_TEST_DB is not set: skipped")
		return nil
	}
	let c = db.Open(o)
	db.ResetForTests(c) catch err {
		t.Error("reset: {err}")
		return nil
	}
	_ = db.Migrate(c) catch err {
		t.Error("migrate: {err}")
		return nil
	}
	return c
}

const cookieKey = "test-cookie-key-0123456789"

const nonceKey = "test-nonce-key-0123456789"

// now is the tests' clock, in unix seconds: nonces are made and checked at it.
const now = 1700000000

// sessions is a session store in the Redis at TINHUB_TEST_REDIS under a fresh prefix, or none.
fn sessions(prefix str) Sessions {
	return NewSessions(quarry.Getenv("TINHUB_TEST_REDIS"), prefix, 60 * 1000000000, cookieKey)
}

fn freshPrefix() str {
	return "tinhub-test-" + seal.Hex(seal.RandomBytes(4)) + ":"
}

fn service(c postgres.Client, s Sessions) Service {
	return Service{Db: c, Sessions: s, NonceKey: nonceKey, CookieKey: cookieKey, PublicUrl: "https://hub.example"}
}

// signer is a test key: its seed and public key.
type signer struct {
	seed []u8
	pub  []u8
}

fn newSigner() !signer {
	let seed = seal.RandomBytes(32)
	let pub = try seal.Ed25519PublicKey(seed)
	return signer{seed: seed, pub: pub}
}

// header is a Tit-Signature for a request, signed by k as email with a fresh nonce.
fn (k signer) header(email str, method str, path str, body str) !str {
	let nonce = transport.NewNonce(nonceKey, now)
	let sig = try seal.SignEd25519(k.seed, []u8(transport.SigningPayload(method, path, nonce, body)))
	return transport.SignatureHeader(email, nonce, sig)
}

// other is s with its first byte changed: "0" becomes "1", anything else "0".
fn other(s str) str {
	if s[0] == '0' {
		return "1" + s[1:]
	}
	return "0" + s[1:]
}

fn auditCount(c postgres.Client) !i64 {
	let rows = try c.Query("SELECT count(*) FROM audit_log")
	return rows.Rows[0][0].Int()
}

// ---- without a database ----

fn TestNames(t mut crucible.T) {
	t.True("owner name", ValidOwnerName("ada-1"))
	t.False("owner name starting with -", ValidOwnerName("-ada"))
	t.False("owner name in upper case", ValidOwnerName("Ada"))
	t.False("empty owner name", ValidOwnerName(""))
	t.False("40-byte owner name", ValidOwnerName("a123456789012345678901234567890123456789"))
	t.True("repo name", ValidRepoName("Tin.go_x-1"))
	t.False("repo name .", ValidRepoName("."))
	t.False("repo name ..", ValidRepoName(".."))
	t.False("repo name ending in .tit", ValidRepoName("x.tit"))
	t.False("repo name with a slash", ValidRepoName("a/b"))
	crucible.Equal(mut t, "name from an email", nameFor("Ada.Lovelace+tin@example.com"), "ada-lovelace-tin")
	crucible.Equal(mut t, "name from a symbol email", nameFor("__@example.com"), "user")
	t.True("code", validCode("ABCD-EF23"))
	t.False("code with a look-alike", validCode("ABCD-EF01"))
	t.False("code without a dash", validCode("ABCDEFGH2"))
	for r in []i64{RoleNone, RoleRead, RoleWrite, RoleAdmin} {
		let back = ParseRole(RoleName(r)) catch _ {
			-1
		}
		crucible.Equal(mut t, "role {r} by name", back, r)
	}
	let (_, unknown) = ParseRole("owner")
	t.HasFault("unknown role", unknown)
	t.True("email", validEmail("a@b.c"))
	t.False("email with a space", validEmail("a b@c.d"))
	t.False("email with two @", validEmail("a@b@c"))
}

fn TestCookies(t mut crucible.T) {
	let s = NewSessions("", "x:", SessionTTL, cookieKey)
	let id = seal.Hex(seal.RandomBytes(32))
	let cookie = id + "." + s.mac(id)
	crucible.Equal(mut t, "a signed cookie names its id", s.idOf(cookie), id)
	crucible.Equal(mut t, "a forged signature", s.idOf(id + "." + s.mac(other(id))), "")
	crucible.Equal(mut t, "no signature", s.idOf(id), "")
	let other = NewSessions("", "x:", SessionTTL, "another-cookie-key-0123456789")
	crucible.Equal(mut t, "another key's cookie", other.idOf(cookie), "")
	let n = s.Lookup(cookie) catch _ {
		-1
	}
	crucible.Equal(mut t, "no store, no session", n, 0)
	let (_, err) = s.New(1)
	t.True("no store, no sign-in", fault.Is(err, ErrNoSessions))
}

// ---- the access matrix ----

// person is a user of the matrix and its expected role on each of its repositories.
type person struct {
	name  str
	id    i64
	roles []i64
}

// action is something done to a repository and the role it needs.
type action struct {
	name str
	need i64
}

fn TestAccessMatrix(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	let err = accessMatrix(mut t, got)
	t.NoFault("access matrix", err)
}

fn mkUser(c postgres.Client, name str) !i64 {
	let u = try CreateUser(c, System(), name, name + "@example.com", false)
	return u.Id
}

fn accessMatrix(t mut crucible.T, c postgres.Client) ! {
	let sys = System()
	let root = try CreateUser(c, sys, "root", "root@example.com", true)
	let alice = try mkUser(c, "alice")
	let bob = try mkUser(c, "bob")
	let carol = try mkUser(c, "carol")
	let dave = try mkUser(c, "dave")
	let erin = try mkUser(c, "erin")
	let frank = try mkUser(c, "frank")
	let gina = try mkUser(c, "gina")
	let zed = try mkUser(c, "zed")
	let org = try CreateOrg(c, Actor{Id: frank, Ip: "10.0.0.1"}, "acme", "Acme")
	try SetMember(c, Actor{Id: frank, Ip: ""}, org.Id, erin, "member")
	try SetMember(c, Actor{Id: frank, Ip: ""}, org.Id, gina, "member")
	let devs = try CreateTeam(c, Actor{Id: frank, Ip: ""}, org.Id, "devs")
	try SetTeamMember(c, Actor{Id: frank, Ip: ""}, devs.Id, erin, true)
	// who may make repositories
	let (_, e1) = CreateRepo(c, Actor{Id: gina, Ip: ""}, "acme", "nope", "private", 1000)
	t.True("an org member makes no org repository", fault.Is(e1, ErrForbidden))
	let (_, e2) = CreateRepo(c, Actor{Id: bob, Ip: ""}, "alice", "nope", "private", 1000)
	t.True("a user makes no repository for another", fault.Is(e2, ErrForbidden))
	let (_, e3) = CreateRepo(c, Actor{Id: bob, Ip: ""}, "nobody", "nope", "private", 1000)
	t.True("no owner", fault.Is(e3, ErrNotFound))
	let pub = try CreateRepo(c, Actor{Id: alice, Ip: ""}, "alice", "pub", "public", 1000)
	let priv = try CreateRepo(c, Actor{Id: alice, Ip: ""}, "alice", "priv", "private", 1000)
	let orgRepo = try CreateRepo(c, Actor{Id: frank, Ip: ""}, "acme", "Engine", "private", 1000)
	let (_, e4) = CreateRepo(c, Actor{Id: alice, Ip: ""}, "alice", "PUB", "private", 1000)
	t.True("a name taken in another case", fault.Is(e4, ErrExists))
	let (_, e5) = CreateRepo(c, Actor{Id: alice, Ip: ""}, "alice", "x.tit", "private", 1000)
	t.True("a bad repository name", fault.Is(e5, ErrInvalid))
	let repos = []Repo{pub, priv, orgRepo}
	for r in repos {
		try GrantUser(c, sys, r, bob, RoleRead)
		try GrantUser(c, sys, r, carol, RoleWrite)
		try GrantUser(c, sys, r, dave, RoleAdmin)
		try GrantUser(c, sys, r, zed, RoleAdmin)
	}
	try GrantTeam(c, sys, orgRepo, devs.Id, RoleWrite)
	let terr = GrantTeam(c, sys, priv, devs.Id, RoleRead)
	t.True("a team grants only on its org's repositories", fault.Is(terr, ErrInvalid))
	try DeleteUser(c, Actor{Id: zed, Ip: ""}, zed)
	// FindRepo: case-insensitive
	let found = try FindRepo(c, "ACME", "engine")
	t.True("FindRepo without case", found != nil && found.Id == orgRepo.Id)
	// the expected roles on pub, priv and acme/Engine
	let people = []person{
		person{name: "root (site admin)", id: root.Id, roles: []i64{RoleAdmin, RoleAdmin, RoleAdmin}},
		person{name: "alice (owner)", id: alice, roles: []i64{RoleAdmin, RoleAdmin, RoleNone}},
		person{name: "bob (read)", id: bob, roles: []i64{RoleRead, RoleRead, RoleRead}},
		person{name: "carol (write)", id: carol, roles: []i64{RoleWrite, RoleWrite, RoleWrite}},
		person{name: "dave (admin)", id: dave, roles: []i64{RoleAdmin, RoleAdmin, RoleAdmin}},
		person{name: "erin (team write)", id: erin, roles: []i64{RoleRead, RoleNone, RoleWrite}},
		person{name: "frank (org owner)", id: frank, roles: []i64{RoleRead, RoleNone, RoleAdmin}},
		person{name: "gina (org member)", id: gina, roles: []i64{RoleRead, RoleNone, RoleNone}},
		person{name: "zed (deleted)", id: zed, roles: []i64{RoleRead, RoleNone, RoleNone}},
		person{name: "anonymous", id: 0, roles: []i64{RoleRead, RoleNone, RoleNone}},
	}
	let actions = []action{
		action{name: "fetch", need: RoleRead},
		action{name: "push", need: RoleWrite},
		action{name: "rename", need: RoleAdmin},
		action{name: "visibility", need: RoleAdmin},
		action{name: "grant", need: RoleAdmin},
		action{name: "revoke", need: RoleAdmin},
		action{name: "delete", need: RoleAdmin},
	}
	for p in people {
		for i, r in repos {
			let role = try RoleOf(c, p.id, r)
			crucible.Equal(mut t, "{p.name}'s role on {r.Owner}/{r.Name}", role, p.roles[i])
			for a in actions {
				let before = try auditCount(c)
				let err = act(c, a.name, p.id, r, gina)
				let after = try auditCount(c)
				let what = "{p.name} {a.name} {r.Owner}/{r.Name}"
				if p.roles[i] >= a.need {
					t.NoFault(what, err)
					if a.need == RoleAdmin {
						crucible.Equal(mut t, "{what}: one audit row", after - before, 1)
					}
				} else if p.roles[i] == RoleNone {
					t.True("{what}: not found ({err})", fault.Is(err, ErrNotFound))
					crucible.Equal(mut t, "{what}: no audit row", after - before, 0)
				} else {
					t.True("{what}: forbidden ({err})", fault.Is(err, ErrForbidden))
					crucible.Equal(mut t, "{what}: no audit row", after - before, 0)
				}
				// what an action changed is put back, by tinhub itself
				try undo(c, a.name, err, r, gina)
			}
		}
	}
	// the roles follow the changes: a public repository is read by anyone, a member out of the org loses its teams
	let opened = try SetVisibility(c, Actor{Id: dave, Ip: ""}, priv, "public")
	let anon = try RoleOf(c, 0, opened)
	crucible.Equal(mut t, "anonymous reads a repository made public", anon, RoleRead)
	_ = try SetVisibility(c, sys, priv, "private")
	try SetMember(c, Actor{Id: frank, Ip: ""}, org.Id, erin, "")
	let left = try RoleOf(c, erin, orgRepo)
	crucible.Equal(mut t, "out of the org, out of its teams", left, RoleNone)
	let last = SetMember(c, Actor{Id: frank, Ip: ""}, org.Id, frank, "member")
	t.True("the last owner stays", fault.Is(last, ErrInvalid))
	try SetMember(c, Actor{Id: frank, Ip: ""}, org.Id, gina, "owner")
	let promoted = try RoleOf(c, gina, orgRepo)
	crucible.Equal(mut t, "a new org owner administers its repositories", promoted, RoleAdmin)
	let byMember = SetMember(c, Actor{Id: bob, Ip: ""}, org.Id, bob, "owner")
	t.True("only owners change members", fault.Is(byMember, ErrForbidden))
	// a deleted repository has no role and is not found, and its name is free again
	try DeleteRepo(c, Actor{Id: alice, Ip: ""}, pub)
	let deleted = try RoleOf(c, alice, pub)
	crucible.Equal(mut t, "a deleted repository", deleted, RoleNone)
	let gone = try FindRepo(c, "alice", "pub")
	t.True("FindRepo skips a deleted repository", gone == nil)
	let again = try CreateRepo(c, Actor{Id: alice, Ip: ""}, "alice", "pub", "public", 1000)
	t.True("the name is free again", again.Id != pub.Id)
	// the audit log names the actor and the address
	let rows = try c.Query("SELECT actor_id, ip FROM audit_log WHERE action = 'org.create'")
	crucible.Equal(mut t, "audit actor", rows.Rows[0][0].Int(), frank)
	crucible.Equal(mut t, "audit address", rows.Rows[0][1].Text(), "10.0.0.1")
}

// act does action name to r as user id (anonymous: only the access check, there is no actor); the fault is the
// action's.
fn act(c postgres.Client, name str, id i64, r Repo, other i64) ! {
	let by = Actor{Id: id, Ip: ""}
	if name == "fetch" {
		try Check(c, id, r, RoleRead)
		return
	}
	if name == "push" {
		try Check(c, id, r, RoleWrite)
		return
	}
	if id == 0 {
		try Check(c, 0, r, RoleAdmin)
		return
	}
	if name == "rename" {
		_ = try RenameRepo(c, by, r, r.Name + "-renamed")
		return
	}
	if name == "visibility" {
		_ = try SetVisibility(c, by, r, r.Visibility)
		return
	}
	if name == "grant" {
		try GrantUser(c, by, r, other, RoleWrite)
		return
	}
	if name == "revoke" {
		try GrantUser(c, by, r, other, RoleNone)
		return
	}
	try DeleteRepo(c, by, r)
}

// undo puts back what a successful action changed.
fn undo(c postgres.Client, name str, err fault, r Repo, other i64) ! {
	if err != nil {
		return
	}
	if name == "rename" {
		_ = try c.Exec("UPDATE repos SET name = {r.Name} WHERE id = {r.Id}")
	}
	if name == "grant" || name == "revoke" {
		_ = try c.Exec("DELETE FROM grants WHERE repo_id = {r.Id} AND user_id = {other}")
	}
	if name == "delete" {
		_ = try c.Exec("UPDATE repos SET deleted_at = NULL WHERE id = {r.Id}")
	}
}

// ---- keys ----

fn TestKeys(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	let err = keys(mut t, got)
	t.NoFault("keys", err)
}

fn keys(t mut crucible.T, c postgres.Client) ! {
	let ada = try CreateUser(c, System(), "ada", "Ada@Example.com", false)
	let bob = try CreateUser(c, System(), "bob", "bob@example.com", false)
	let k1 = try newSigner()
	let k2 = try newSigner()
	let added = try AddKey(c, Actor{Id: ada.Id, Ip: ""}, ada.Id, k1.pub, "laptop")
	_ = try AddKey(c, Actor{Id: ada.Id, Ip: ""}, ada.Id, k2.pub, "desk")
	let (_, dup) = AddKey(c, Actor{Id: ada.Id, Ip: ""}, ada.Id, k1.pub, "again")
	t.True("a key twice", fault.Is(dup, ErrExists))
	let (_, theirs) = AddKey(c, Actor{Id: bob.Id, Ip: ""}, bob.Id, k1.pub, "mine")
	t.True("another user's key", fault.Is(theirs, ErrExists))
	let (_, other) = AddKey(c, Actor{Id: bob.Id, Ip: ""}, ada.Id, k1.pub, "for ada")
	t.True("a key for another user", fault.Is(other, ErrForbidden))
	let (_, short) = AddKey(c, Actor{Id: ada.Id, Ip: ""}, ada.Id, k1.pub[0:31], "short")
	t.True("a 31-byte key", fault.Is(short, ErrInvalid))
	let ks = try KeysOf(c, ada.Id)
	crucible.Equal(mut t, "two keys", len(ks), 2)
	t.True("raw 32-byte keys", len(ks) == 2 && str(ks[0]) == str(k1.pub) && str(ks[1]) == str(k2.pub))
	let byEmail = try UserByEmail(c, "ada@EXAMPLE.com")
	t.True("UserByEmail without case", byEmail != nil && byEmail.Id == ada.Id)
	// a signed request: the signer, by a live key
	let path = "/ada/tin/tit/v1/push"
	let h1 = try k1.header("ada@example.com", "POST", path, "body")
	let who = try VerifySigned(c, nonceKey, "POST", path, h1, seal.Hex(seal.Sha256("body")), now)
	crucible.Equal(mut t, "the signer", who.Id, ada.Id)
	let used = try Keys(c, ada.Id)
	t.True("the key's use is recorded", used[0].LastUsed > 0)
	let (_, wrongBody) = VerifySigned(c, nonceKey, "POST", path, h1, seal.Hex(seal.Sha256("other")), now)
	t.True("another body", fault.Is(wrongBody, transport.ErrRefused))
	let (_, late) = VerifySigned(c, nonceKey, "POST", path, h1, seal.Hex(seal.Sha256("body")), now + 61)
	t.True("an old nonce", fault.Is(late, transport.ErrRefused))
	let hb = try k1.header("bob@example.com", "POST", path, "body")
	let (_, notBobs) = VerifySigned(c, nonceKey, "POST", path, hb, seal.Hex(seal.Sha256("body")), now)
	t.True("signed as bob with ada's key", fault.Is(notBobs, transport.ErrRefused))
	// a removed key signs nothing; added again, it does
	let byBob = RemoveKey(c, Actor{Id: bob.Id, Ip: ""}, added.Id)
	t.True("bob removes no key of ada's", fault.Is(byBob, ErrNotFound))
	try RemoveKey(c, Actor{Id: ada.Id, Ip: ""}, added.Id)
	let h2 = try k1.header("ada@example.com", "POST", path, "body")
	let (_, revoked) = VerifySigned(c, nonceKey, "POST", path, h2, seal.Hex(seal.Sha256("body")), now)
	t.True("a removed key", fault.Is(revoked, transport.ErrRefused))
	crucible.Equal(mut t, "one key left", keyCount(c, ada.Id), 1)
	_ = try AddKey(c, Actor{Id: ada.Id, Ip: ""}, ada.Id, k1.pub, "laptop again")
	let back = try VerifySigned(c, nonceKey, "POST", path, h2, seal.Hex(seal.Sha256("body")), now)
	crucible.Equal(mut t, "a key added again", back.Id, ada.Id)
	// a deleted user's keys stop
	try DeleteUser(c, System(), ada.Id)
	crucible.Equal(mut t, "a deleted user has no keys", keyCount(c, ada.Id), 0)
	let (_, deleted) = VerifySigned(c, nonceKey, "POST", path, h2, seal.Hex(seal.Sha256("body")), now)
	t.True("a deleted user signs nothing", fault.Is(deleted, transport.ErrRefused))
	let audits = try c.Query("SELECT count(*) FILTER (WHERE action = 'key.add'), count(*) FILTER (WHERE action = 'key.remove') FROM audit_log")
	crucible.Equal(mut t, "key.add rows", audits.Rows[0][0].Int(), 3)
	crucible.Equal(mut t, "key.remove rows", audits.Rows[0][1].Int(), 1)
}

// ---- invites ----

fn TestInvites(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	let err = invites(mut t, got)
	t.NoFault("invites", err)
}

// keyAdd sends tit key add's request for email, signed by k, with invite.
fn keyAdd(s Service, k signer, email str, invite str) !Answer {
	let path = "/tit/v1/keys"
	let body = transport.Encode(transport.KeyAdd{Email: email, Key: seal.B64(k.pub), Invite: invite})
	let h = try k.header(email, "POST", path, body)
	return s.Handle("POST", path, h, body, "192.0.2.1", now)
}

fn invites(t mut crucible.T, c postgres.Client) ! {
	let s = service(c, sessions(freshPrefix()))
	// the first admin: tinhub admin invite --admin, then tit key add
	let code = try CreateInvite(c, "first@example.com", true)
	t.True("an invite's code", validCode(code))
	let k = try newSigner()
	let a = try keyAdd(s, k, "first@example.com", code)
	crucible.Equal(mut t, "key add answers 200", a.Status, 200)
	mut st = transport.LoginState{State: "", Email: "", Expires: 0}
	try argo.Get(a.Body, mut st)
	crucible.Equal(mut t, "key add's state", st.State, "added")
	let first = try UserByEmail(c, "first@example.com")
	if first == nil {
		fail "no account for first@example.com"
	}
	t.True("the account is made, a site admin named after the email", first.SiteAdmin && first.Name == "first")
	let ks = try KeysOf(c, first.Id)
	t.True("with the key", len(ks) == 1 && str(ks[0]) == str(k.pub))
	// once only
	let k2 = try newSigner()
	let twice = try keyAdd(s, k2, "first@example.com", code)
	crucible.Equal(mut t, "a spent invite", twice.Status, 401)
	t.True("a refusal is a tit error frame with a nonce", errorNonce(twice.Body) != "")
	// for its email only
	let code2 = try CreateInvite(c, "second@example.com", false)
	let wrong = try keyAdd(s, k2, "third@example.com", code2)
	crucible.Equal(mut t, "an invite for another email", wrong.Status, 401)
	// signed by the key it adds
	let body = transport.Encode(transport.KeyAdd{Email: "second@example.com", Key: seal.B64(k2.pub), Invite: code2})
	let h = try k.header("second@example.com", "POST", "/tit/v1/keys", body)
	let forged = s.Handle("POST", "/tit/v1/keys", h, body, "", now)
	crucible.Equal(mut t, "signed by another key", forged.Status, 401)
	let unsigned = s.Handle("POST", "/tit/v1/keys", "", body, "", now)
	crucible.Equal(mut t, "unsigned", unsigned.Status, 401)
	// expired
	_ = try c.Exec("UPDATE invites SET expires_at = now() - interval '1 second' WHERE code = {code2}")
	let late = try keyAdd(s, k2, "second@example.com", code2)
	crucible.Equal(mut t, "an expired invite", late.Status, 401)
	let unknown = try keyAdd(s, k2, "second@example.com", "ABCD-EFGH")
	crucible.Equal(mut t, "an unknown invite", unknown.Status, 401)
	// an invite into an org, by its owner; the name after the email is free or numbered
	let owner = try CreateUser(c, System(), "boss", "boss@example.com", false)
	let org = try CreateOrg(c, Actor{Id: owner.Id, Ip: ""}, "acme", "")
	let (_, notOwner) = InviteBy(c, Actor{Id: first.Id + 1000, Ip: ""}, "x@example.com", org.Id, false)
	t.True("only an owner invites into an org", fault.Is(notOwner, ErrForbidden))
	let (_, adminByOwner) = InviteBy(c, Actor{Id: owner.Id, Ip: ""}, "x@example.com", org.Id, true)
	t.True("an org owner makes no site admin", fault.Is(adminByOwner, ErrForbidden))
	let code3 = try InviteBy(c, Actor{Id: owner.Id, Ip: ""}, "boss@other.example", org.Id, false)
	let k3 = try newSigner()
	let joined = try AcceptInvite(c, code3, "boss@other.example", "", k3.pub, "")
	crucible.Equal(mut t, "a taken name is numbered", joined.Name, "boss-2")
	crucible.Equal(mut t, "the invite's org", memberRole(c, org.Id, joined.Id), "member")
	t.False("an org invite makes no site admin", joined.SiteAdmin)
	// an invite for an existing account adds a key
	let code4 = try CreateInvite(c, "FIRST@example.com", false)
	let k4 = try newSigner()
	let more = try keyAdd(s, k4, "first@example.com", code4)
	crucible.Equal(mut t, "a second key with an invite", more.Status, 200)
	crucible.Equal(mut t, "two keys", keyCount(c, first.Id), 2)
	let audits = try c.Query("SELECT count(*) FILTER (WHERE action = 'invite.create'), count(*) FILTER (WHERE action = 'invite.accept') FROM audit_log")
	crucible.Equal(mut t, "invite.create rows", audits.Rows[0][0].Int(), 4)
	crucible.Equal(mut t, "invite.accept rows", audits.Rows[0][1].Int(), 3)
	let leaked = try c.Query("SELECT count(*) FROM audit_log WHERE detail::text LIKE '%' || {code} || '%'")
	crucible.Equal(mut t, "no invite code in the audit log", leaked.Rows[0][0].Int(), 0)
}

// errorNonce is the nonce of a tit error frame, "" for none.
fn errorNonce(body str) str {
	let (_, header, _, err) = transport.ReadFrame(body)
	if err != nil {
		return ""
	}
	mut e = transport.ErrorAnswer{Code: "", Message: "", Ref: "", Nonce: ""}
	argo.Get(header, mut e) catch _ {
		return ""
	}
	return e.Nonce
}

// ---- sign-in ----

fn TestLoginOnce(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	let err = loginOnce(mut t, got)
	t.NoFault("login", err)
}

// stateOf is a login answer's state, empty when it is not one.
fn stateOf(a Answer) transport.LoginState {
	mut st = transport.LoginState{State: "", Email: "", Expires: 0}
	argo.Get(a.Body, mut st) catch _ {
	}
	return st
}

// keyCount is how many live keys the user has, -1 on a fault.
fn keyCount(c postgres.Client, id i64) i64 {
	let ks = KeysOf(c, id) catch _ {
		return -1
	}
	return len(ks)
}

// memberRole is MemberRole, "?" on a fault.
fn memberRole(c postgres.Client, org i64, id i64) str {
	let r = MemberRole(c, org, id) catch _ {
		"?"
	}
	return r
}

// lookup is the user a cookie signs in, -1 on a fault.
fn lookup(s Sessions, cookie str) i64 {
	let n = s.Lookup(cookie) catch _ {
		-1
	}
	return n
}

fn loginOnce(t mut crucible.T, c postgres.Client) ! {
	let redisOn = len(quarry.Getenv("TINHUB_TEST_REDIS")) > 0
	let s = service(c, sessions(freshPrefix()))
	let ada = try CreateUser(c, System(), "ada", "ada@example.com", false)
	let k = try newSigner()
	_ = try AddKey(c, System(), ada.Id, k.pub, "")
	// a browser asks
	let made = s.Handle("POST", "/tit/v1/login", "", "", "", now)
	crucible.Equal(mut t, "a login request", made.Status, 200)
	mut ans = transport.LoginAnswer{Code: "", Url: "", Expires: 0}
	try argo.Get(made.Body, mut ans)
	t.True("its code", validCode(ans.Code))
	crucible.Equal(mut t, "its url", ans.Url, "https://hub.example/tit/v1/login/" + ans.Code)
	t.True("the claim token", len(made.LoginCookie) > 20)
	let path = "/tit/v1/login/" + ans.Code
	crucible.Equal(mut t, "pending", stateOf(s.Handle("GET", path, "", "", "", now)).State, "pending")
	// tit login approves it, once
	let unsigned = s.Handle("POST", path, "", "", "", now)
	crucible.Equal(mut t, "an unsigned approval", unsigned.Status, 401)
	let h = try k.header("ada@example.com", "POST", path, "")
	let ok = s.Handle("POST", path, h, "", "", now)
	crucible.Equal(mut t, "approved", ok.Status, 200)
	crucible.Equal(mut t, "approved by", stateOf(ok).Email, "ada@example.com")
	let h2 = try k.header("ada@example.com", "POST", path, "")
	let again = s.Handle("POST", path, h2, "", "", now)
	crucible.Equal(mut t, "a second approval", again.Status, 409)
	let seen = stateOf(s.Handle("GET", path, "", "", "", now))
	t.True("the browser sees the approval", seen.State == "approved" && seen.Email == "ada@example.com")
	// the browser claims it, once, with its token
	let (_, stolen) = s.Claim(ans.Code, "not-the-token", "")
	t.True("another browser's claim", fault.Is(stolen, transport.ErrRefused))
	let (ses, cerr) = s.Claim(ans.Code, made.LoginCookie, "203.0.113.9")
	if redisOn {
		t.NoFault("the claim", cerr)
		let who = try SessionUser(c, s.Sessions, ses.Cookie)
		t.True("the session signs ada in", who != nil && who.Id == ada.Id)
		let (_, twice) = s.Claim(ans.Code, made.LoginCookie, "")
		let (code2, _) = CodeOf(twice)
		t.True("a second claim is refused (Moved)", code2 == transport.Code.Moved)
		let rows = try c.Query("SELECT ip FROM audit_log WHERE action = 'login.session'")
		t.True("the sign-in is audited", len(rows.Rows) == 1 && rows.Rows[0][0].Text() == "203.0.113.9")
	} else {
		t.Log("TINHUB_TEST_REDIS is not set: the session part skipped")
		t.True("no Redis, no session", fault.Is(cerr, ErrNoSessions))
		let row = try c.Query("SELECT state FROM login_requests WHERE code = {ans.Code}")
		crucible.Equal(mut t, "a failed claim leaves the code approved", row.Rows[0][0].Text(), "approved")
	}
	// a request not yet approved is not claimed; an expired one is neither approved nor claimed
	let made2 = s.Handle("POST", "/tit/v1/login", "", "", "", now)
	mut ans2 = transport.LoginAnswer{Code: "", Url: "", Expires: 0}
	try argo.Get(made2.Body, mut ans2)
	let (_, early) = s.Claim(ans2.Code, made2.LoginCookie, "")
	let (codeEarly, _) = CodeOf(early)
	t.True("an unapproved request is not claimed", codeEarly == transport.Code.Moved)
	_ = try c.Exec("UPDATE login_requests SET expires_at = now() - interval '1 second' WHERE code = {ans2.Code}")
	let path2 = "/tit/v1/login/" + ans2.Code
	crucible.Equal(mut t, "expired", stateOf(s.Handle("GET", path2, "", "", "", now)).State, "expired")
	let h3 = try k.header("ada@example.com", "POST", path2, "")
	let late = s.Handle("POST", path2, h3, "", "", now)
	crucible.Equal(mut t, "a late approval", late.Status, 409)
	let missing = s.Handle("GET", "/tit/v1/login/ABCD-EFGH", "", "", "", now)
	crucible.Equal(mut t, "an unknown code", missing.Status, 404)
	// under a repository's URL, as tit login with a remote sends it
	let made3 = s.Handle("POST", "/ada/tin/tit/v1/login", "", "", "", now)
	mut ans3 = transport.LoginAnswer{Code: "", Url: "", Expires: 0}
	try argo.Get(made3.Body, mut ans3)
	let path3 = "/ada/tin/tit/v1/login/" + ans3.Code
	let h4 = try k.header("ada@example.com", "POST", path3, "")
	crucible.Equal(mut t, "an approval under a repository's URL", s.Handle("POST", path3, h4, "", "", now).Status, 200)
	let approvals = try c.Query("SELECT count(*) FROM audit_log WHERE action = 'login.approve'")
	crucible.Equal(mut t, "approvals audited", approvals.Rows[0][0].Int(), 2)
}

// ---- sessions ----

fn TestSessionsSurviveRestart(t mut crucible.T) {
	if len(quarry.Getenv("TINHUB_TEST_REDIS")) == 0 {
		t.Log("TINHUB_TEST_REDIS is not set: skipped")
		return
	}
	let err = sessionsRestart(mut t)
	t.NoFault("sessions", err)
}

fn sessionsRestart(t mut crucible.T) ! {
	let prefix = freshPrefix()
	let before = sessions(prefix)
	let ses = try before.New(42)
	crucible.Equal(mut t, "the cookie's Max-Age", ses.MaxAge, 60)
	// a node restarts: a new store, a new connection, the same Redis and key
	let after = sessions(prefix)
	crucible.Equal(mut t, "a session survives a restart", lookup(after, ses.Cookie), 42)
	crucible.Equal(mut t, "a forged cookie", lookup(after, other(ses.Cookie)), 0)
	let rekeyed = NewSessions(quarry.Getenv("TINHUB_TEST_REDIS"), prefix, 60 * 1000000000, "a-new-cookie-key-0123456789")
	crucible.Equal(mut t, "a changed cookie key signs everyone out", lookup(rekeyed, ses.Cookie), 0)
	// Redis holds the id's hash, never the cookie
	let id = before.idOf(ses.Cookie)
	let (_, raw) = try after.Client.Get(prefix + "session:" + id)
	t.False("no raw id in Redis", raw)
	// losing Redis's data signs everyone out
	_ = try after.Client.Del(after.redisKey(id))
	crucible.Equal(mut t, "a lost session", lookup(after, ses.Cookie), 0)
	// signing out
	let ses2 = try after.New(43)
	try before.End(ses2.Cookie)
	crucible.Equal(mut t, "signed out", lookup(after, ses2.Cookie), 0)
	// an unreachable Redis is a fault, which the caller takes as signed out
	let down = NewSessions("127.0.0.1:1", prefix, 60 * 1000000000, cookieKey)
	let (_, derr) = down.Lookup(ses.Cookie)
	t.True("an unreachable Redis", derr != nil)
}
