package accounts

import "fault"
import "postgres"
import "twine"

// What the web pages change besides access (#1081, design/tinhub.md §15): a repository's description and default
// branch, a user's display name, a repository's mirror. Each is one transaction with its audit_log row.

// RepoInfo is a repository's description and default branch.
type RepoInfo struct {
	Description   str
	DefaultBranch str
}

// InfoOf is the repository's description and default branch.
fn InfoOf(c postgres.Client, r Repo) !RepoInfo {
	let rows = try c.Query("SELECT description, default_branch FROM repos WHERE id = {r.Id}")
	if len(rows.Rows) == 0 {
		fail fault.Wrap(ErrNotFound, "{r.Owner}/{r.Name}")
	}
	return RepoInfo{Description: rows.Rows[0][0].Text(), DefaultBranch: rows.Rows[0][1].Text()}
}

// ValidBranch reports whether a default branch is a branch's short name: 1 to 200 bytes, no spaces, control bytes,
// "..", leading or trailing "/" or a leading "-".
fn ValidBranch(name str) bool {
	if len(name) == 0 || len(name) > 200 || name[0] == '-' || name[0] == '/' || name[len(name) - 1] == '/' {
		return false
	}
	if twine.Contains(name, "..") || twine.Contains(name, "//") {
		return false
	}
	for c in name {
		if c <= ' ' || c == 0x7f || c == '~' || c == '^' || c == ':' || c == '?' || c == '*' || c == '[' || c == '\\' {
			return false
		}
	}
	return true
}

// SetRepoInfo sets a repository's description (at most 350 bytes) and default branch (admin).
fn SetRepoInfo(c postgres.Client, by Actor, r Repo, info RepoInfo) !Repo {
	if len(info.Description) > 350 {
		fail fault.Wrap(ErrInvalid, "a description is at most 350 bytes")
	}
	if !ValidBranch(info.DefaultBranch) {
		fail fault.Wrap(ErrInvalid, "{info.DefaultBranch} is not a branch name")
	}
	mut tx = try c.Begin()
	let (out, err) = setInfoIn(mut tx, by, r, info)
	if err != nil {
		rollback(mut tx)
		fail err
	}
	try tx.Commit()
	return out
}

fn setInfoIn(tx mut postgres.Tx, by Actor, r Repo, info RepoInfo) !Repo {
	try lockRepo(mut tx, by, r, RoleAdmin)
	let d = info.Description
	let b = info.DefaultBranch
	// a new default branch is one the repository has (#1136); an empty one may name the branch its first push makes
	let heads = try tx.Query("SELECT count(f.name) FILTER (WHERE f.name = 'refs/heads/' || {b}), count(f.name), min(p.default_branch) FROM repos p LEFT JOIN refs f ON f.repo_id = p.id AND f.name LIKE 'refs/heads/%' WHERE p.id = {r.Id}")
	if len(heads.Rows) == 1 && heads.Rows[0][2].Text() != b && heads.Rows[0][1].Int() > 0 && heads.Rows[0][0].Int() == 0 {
		fail fault.Wrap(ErrInvalid, "{r.Owner}/{r.Name} has no branch {b}")
	}
	_ = try tx.Exec("UPDATE repos SET description = {d}, default_branch = {b} WHERE id = {r.Id}")
	try audit(mut tx, by, "repo.info", "repo", r.Id, []str{"description", d, "default_branch", b})
	return try repoIn(mut tx, r.Id)
}

// SetDisplay sets a user's display name (at most 100 bytes): the user or a site admin may.
fn SetDisplay(c postgres.Client, by Actor, userId i64, display str) ! {
	if len(display) > 100 {
		fail fault.Wrap(ErrInvalid, "a display name is at most 100 bytes")
	}
	for c0 in display {
		if c0 < ' ' || c0 == 0x7f {
			fail fault.Wrap(ErrInvalid, "a display name has no control characters")
		}
	}
	mut tx = try c.Begin()
	let err = setDisplayIn(mut tx, by, userId, display)
	if err != nil {
		rollback(mut tx)
		fail err
	}
	try tx.Commit()
}

fn setDisplayIn(tx mut postgres.Tx, by Actor, userId i64, display str) ! {
	let admin = try mayAdminister(mut tx, by)
	if !admin && by.Id != userId {
		fail fault.Wrap(ErrForbidden, "only the user changes their display name")
	}
	let n = try tx.Exec("UPDATE users SET display = {display} WHERE id = {userId} AND deleted_at IS NULL")
	if n.Affected == 0 {
		fail fault.Wrap(ErrNotFound, "no user {userId}")
	}
	try audit(mut tx, by, "user.display", "user", userId, []str{"display", display})
}

// SetOrgDisplay sets an org's display name (at most 100 bytes): its owners or a site admin may.
fn SetOrgDisplay(c postgres.Client, by Actor, orgId i64, display str) ! {
	if len(display) > 100 {
		fail fault.Wrap(ErrInvalid, "a display name is at most 100 bytes")
	}
	mut tx = try c.Begin()
	let err = setOrgDisplayIn(mut tx, by, orgId, display)
	if err != nil {
		rollback(mut tx)
		fail err
	}
	try tx.Commit()
}

fn setOrgDisplayIn(tx mut postgres.Tx, by Actor, orgId i64, display str) ! {
	let may = try mayAdministerOrg(mut tx, by, orgId)
	if !may {
		fail fault.Wrap(ErrForbidden, "only an owner of the org changes its name")
	}
	_ = try tx.Exec("UPDATE orgs SET display = {display} WHERE id = {orgId} AND deleted_at IS NULL")
	try audit(mut tx, by, "org.display", "org", orgId, []str{"display", display})
}

// Mirror is a repository's mirror: where tinhub pushes it after every push (design/tinhub.md §6, mirror). The token is
// never read back out.
type Mirror struct {
	Url       str
	HasToken  bool
	Active    bool
	Mirrored  i64
	LastError str
}

// MirrorOf is the repository's mirror, or nil.
fn MirrorOf(c postgres.Client, r Repo) !?Mirror {
	let rows = try c.Query("SELECT url, (token <> '')::int, active::int, coalesce(extract(epoch FROM mirrored_at)::bigint, 0), last_error FROM mirrors WHERE repo_id = {r.Id}")
	if len(rows.Rows) == 0 {
		return nil
	}
	let x = rows.Rows[0]
	return Mirror{Url: x[0].Text(), HasToken: x[1].Int() == 1, Active: x[2].Int() == 1, Mirrored: x[3].Int(), LastError: x[4].Text()}
}

// SetMirror sets the repository's mirror (admin): an https URL; token "" with keepToken keeps the one stored.
fn SetMirror(c postgres.Client, by Actor, r Repo, url str, token str, keepToken bool, active bool) ! {
	if !twine.HasPrefix(url, "https://") || len(url) > 500 || twine.ContainsAny(url, " \t\r\n") {
		fail fault.Wrap(ErrInvalid, "a mirror is an https:// URL")
	}
	mut tx = try c.Begin()
	let err = setMirrorIn(mut tx, by, r, url, token, keepToken, active)
	if err != nil {
		rollback(mut tx)
		fail err
	}
	try tx.Commit()
}

fn setMirrorIn(tx mut postgres.Tx, by Actor, r Repo, url str, token str, keepToken bool, active bool) ! {
	try lockRepo(mut tx, by, r, RoleAdmin)
	if keepToken {
		_ = try tx.Exec("INSERT INTO mirrors (repo_id, url, active) VALUES ({r.Id}, {url}, {active}) ON CONFLICT (repo_id) DO UPDATE SET url = excluded.url, active = excluded.active")
	} else {
		_ = try tx.Exec("INSERT INTO mirrors (repo_id, url, token, active) VALUES ({r.Id}, {url}, {token}, {active}) ON CONFLICT (repo_id) DO UPDATE SET url = excluded.url, token = excluded.token, active = excluded.active")
	}
	// the token is a credential: the log names the URL, never the token
	try audit(mut tx, by, "repo.mirror", "repo", r.Id, []str{"url", url})
}

// DeleteMirror removes the repository's mirror (admin); false when it had none.
fn DeleteMirror(c postgres.Client, by Actor, r Repo) !bool {
	mut tx = try c.Begin()
	let (gone, err) = deleteMirrorIn(mut tx, by, r)
	if err != nil {
		rollback(mut tx)
		fail err
	}
	try tx.Commit()
	return gone
}

fn deleteMirrorIn(tx mut postgres.Tx, by Actor, r Repo) !bool {
	try lockRepo(mut tx, by, r, RoleAdmin)
	let n = try tx.Exec("DELETE FROM mirrors WHERE repo_id = {r.Id}")
	if n.Affected > 0 {
		try audit(mut tx, by, "repo.mirror.remove", "repo", r.Id, []str{})
	}
	return n.Affected > 0
}
