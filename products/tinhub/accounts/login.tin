package accounts

import "../../tit/transport"
import "fault"
import "postgres"
import "seal"

// Sign-in with a key (design/tit.md §18, #1017), rows of login_requests:
//
//  1. A browser asks for a login request (POST /tit/v1/login, unsigned): a code, pending for 10 minutes. The answer
//     also gives the browser a claim token (cookie tinhub_login), the code's HMAC under secrets.cookie: only the
//     browser that asked can turn the code into a session, so a code read over a shoulder is worth nothing.
//  2. `tit login --code CODE` approves it with a request signed by a registered key (POST /tit/v1/login/<code>):
//     pending becomes approved, naming the signer. Once only: a second approval, or one after 10 minutes, is refused
//     (Moved).
//  3. The browser, polling GET /tit/v1/login/<code>, sees approved and claims it with its token (LoginClaim): approved
//     becomes used and the browser gets a session cookie. Once only, and within the same 10 minutes.

// LoginTTL is how long a login request may be approved and claimed, in seconds: 10 minutes.
const LoginTTL = transport.LoginTTL

// LoginCookieName is the claim token's cookie.
const LoginCookieName = "tinhub_login"

fn claimFor(cookieKey secret str, code str) str {
	return seal.B64URL(seal.Hmac(seal.Hash.SHA256, cookieKey, "tinhub login " + code))
}

// LoginNew makes a pending login request: the answer to send (its url is where its state is read, under publicUrl)
// and the claim token to give the browser that asked.
fn LoginNew(c postgres.Client, cookieKey secret str, publicUrl str) !(transport.LoginAnswer, str) {
	let ttl = LoginTTL
	for attempt in 0..5 {
		let code = transport.NewCode()
		let rows = try c.Query("INSERT INTO login_requests (code, state, expires_at) VALUES ({code}, 'pending', now() + make_interval(secs => {ttl})) ON CONFLICT DO NOTHING RETURNING extract(epoch FROM expires_at)::bigint")
		if len(rows.Rows) == 1 {
			let a = transport.LoginAnswer{Code: code, Url: publicUrl + "/tit/v1/login/" + code, Expires: rows.Rows[0][0].Int()}
			return a, claimFor(cookieKey, code)
		}
		_ = attempt
	}
	fail "login: no free code after 5 tries"
}

// LoginRead is a login request's state, as GET /tit/v1/login/<code> answers it: pending, approved (with the email
// that approved it) or expired. An unknown code is refused (NotFound).
fn LoginRead(c postgres.Client, code str) !transport.LoginState {
	if !validCode(code) {
		try refused(transport.Code.NotFound, "no login request {code}")
	}
	let rows = try c.Query("SELECT l.state, coalesce(u.email, ''), l.expires_at <= now(), extract(epoch FROM l.expires_at)::bigint FROM login_requests l LEFT JOIN users u ON u.id = l.user_id WHERE l.code = {code}")
	if len(rows.Rows) == 0 {
		try refused(transport.Code.NotFound, "no login request {code}")
	}
	let r = rows.Rows[0]
	mut state = r[0].Text()
	if state == "used" {
		state = "approved"
	} else if r[2].Int() == 1 {
		state = "expired"
	}
	return transport.LoginState{State: state, Email: r[1].Text(), Expires: r[3].Int()}
}

// LoginApprove approves a pending login request as u (who signed the approval), once, before it expires; ip is the
// approval's address. A second approval or a late one is refused (Moved), an unknown code too (NotFound).
fn LoginApprove(c postgres.Client, code str, u User, ip str) !transport.LoginState {
	mut tx = try c.Begin()
	let (st, err) = approveIn(mut tx, code, u, ip)
	if err != nil {
		rollback(mut tx)
		fail err
	}
	try tx.Commit()
	return st
}

fn approveIn(tx mut postgres.Tx, code str, u User, ip str) !transport.LoginState {
	if !validCode(code) {
		try refused(transport.Code.NotFound, "no login request {code}")
	}
	let rows = try tx.Query("UPDATE login_requests SET state = 'approved', user_id = {u.Id}, approved_at = now() WHERE code = {code} AND state = 'pending' AND expires_at > now() RETURNING extract(epoch FROM expires_at)::bigint")
	if len(rows.Rows) == 0 {
		try whyNot(mut tx, code, "approved already")
	}
	try audit(mut tx, Actor{Id: u.Id, Ip: ip}, "login.approve", "user", u.Id, []str{})
	return transport.LoginState{State: "approved", Email: u.Email, Expires: rows.Rows[0][0].Int()}
}

// whyNot fails with why a login request could not move on: unknown (NotFound), expired or done (Moved).
fn whyNot(tx mut postgres.Tx, code str, done str) ! {
	let have = try tx.Query("SELECT expires_at <= now() FROM login_requests WHERE code = {code}")
	if len(have.Rows) == 0 {
		try refused(transport.Code.NotFound, "no login request {code}")
	}
	if have.Rows[0][0].Int() == 1 {
		try refused(transport.Code.Moved, "login request {code} expired")
	}
	try refused(transport.Code.Moved, "login request {code} was {done}")
}

// LoginClaim turns an approved login request into a session, for the browser holding its claim token: once, before
// the request expires. A wrong token is refused (Unauthorized), a pending, used or expired request too (Moved).
fn LoginClaim(c postgres.Client, s Sessions, cookieKey secret str, code str, claim str, ip str) !Session {
	if !validCode(code) || !seal.Equal(claimFor(cookieKey, code), claim) {
		try refused(transport.Code.Unauthorized, "this browser did not ask for login request {code}")
	}
	mut tx = try c.Begin()
	let (ses, err) = claimIn(mut tx, s, code, ip)
	if err != nil {
		rollback(mut tx)
		fail err
	}
	let cerr = tx.Commit()
	if cerr != nil {
		// the code is still approved: the session made for it goes, and the browser may claim again
		s.End(ses.Cookie) catch _ {
		}
		fail cerr
	}
	return ses
}

fn claimIn(tx mut postgres.Tx, s Sessions, code str, ip str) !Session {
	let rows = try tx.Query("UPDATE login_requests l SET state = 'used' FROM users u WHERE l.code = {code} AND l.state = 'approved' AND l.expires_at > now() AND u.id = l.user_id AND u.deleted_at IS NULL RETURNING l.user_id")
	if len(rows.Rows) == 0 {
		let st = try tx.Query("SELECT state, expires_at > now() FROM login_requests WHERE code = {code}")
		if len(st.Rows) == 1 && st.Rows[0][0].Text() == "pending" && st.Rows[0][1].Int() == 1 {
			try refused(transport.Code.Moved, "login request {code} is not approved yet")
		}
		try whyNot(mut tx, code, "used already")
	}
	let user = rows.Rows[0][0].Int()
	// the session is made before the commit: a Redis fault rolls the claim back, so the browser may try again
	let ses = try s.New(user)
	try audit(mut tx, Actor{Id: user, Ip: ip}, "login.session", "user", user, []str{"code", code})
	return ses
}
