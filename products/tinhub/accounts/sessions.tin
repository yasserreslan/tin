package accounts

import "fault"
import "mint"
import "postgres"
import "redis"
import "seal"
import "twine"

// Browser sessions (#1012). A session is a Redis key; the browser holds a cookie naming it, signed with
// secrets.cookie so a node refuses a forged cookie without asking Redis:
//
//	cookie   tinhub_session=<id>.<base64url HMAC-SHA256(secrets.cookie, "tinhub session " + id)>   id: 64 hex digits
//	Redis    <prefix>session:<hex SHA-256(id)> = "v1 <user id>", expiring after Ttl
//
// Redis keeps only the hash of an id: reading Redis does not give anyone a cookie. Every node with the same Redis and
// secrets.cookie reads every session, so sessions survive a node's restart. Losing Redis (or flushing it, or changing
// secrets.cookie) signs everyone out: browsers sign in again with a key (tit login). Nothing else is lost, since a
// session holds no state of its own. Without redis.addr there are no sessions: browser sign-in is refused, and
// requests signed with Tit-Signature work as always.

// CookieName is the session cookie's name.
const CookieName = "tinhub_session"

// SessionTTL is how long a session lives, in nanoseconds: 30 days from sign-in (not renewed by use).
const SessionTTL = 30 * 24 * 3600 * 1000000000

// ErrNoSessions is the fault of signing in where tinhub has no Redis (redis.addr) to keep sessions in.
let ErrNoSessions = fault("no session store: set redis.addr")

// Sessions keeps sessions in Redis under Prefix ("tinhub:" in a deployment) for Ttl nanoseconds, and signs their
// cookies with the cookie key (config secrets.cookie).
type Sessions struct {
	Client redis.Client
	On     bool
	Prefix str
	Ttl    i64
	key    secret str
}

// Session is a session just made: its user, the cookie's value and its lifetime in seconds (the cookie's Max-Age).
type Session struct {
	UserId i64
	Cookie str
	MaxAge i64
}

// NewSessions is a session store in the Redis at addr ("" for none), signing cookies with cookieKey.
fn NewSessions(addr str, prefix str, ttl i64, cookieKey secret str) Sessions {
	return Sessions{Client: redis.Open(redis.Options{Addr: addr, Username: "", Password: "", DB: 0, Proto: 0, Timeout: 0, TLS: nil}), On: len(addr) > 0, Prefix: prefix, Ttl: ttl, key: cookieKey}
}

fn (s Sessions) mac(id str) str {
	return seal.B64URL(seal.Hmac(seal.Hash.SHA256, s.key, "tinhub session " + id))
}

fn (s Sessions) redisKey(id str) str {
	return s.Prefix + "session:" + seal.Hex(seal.Sha256(id))
}

// New starts a session for the user: the cookie to set.
fn (s Sessions) New(userId i64) !Session {
	if !s.On {
		fail ErrNoSessions
	}
	let id = seal.Hex(seal.RandomBytes(32))
	try s.Client.SetEx(s.redisKey(id), "v1 {userId}", s.Ttl)
	return Session{UserId: userId, Cookie: id + "." + s.mac(id), MaxAge: s.Ttl / 1000000000}
}

// idOf is the session id a cookie names when its signature holds, else "".
fn (s Sessions) idOf(cookie str) str {
	let (id, mac, ok) = twine.Cut(cookie, ".")
	if !ok || len(id) != 64 {
		return ""
	}
	if !seal.Equal(s.mac(id), mac) {
		return ""
	}
	return id
}

// Lookup is the user a session cookie signs in, 0 for none (no cookie, a forged or ended one, or one past its time).
// A fault is Redis failing: the caller treats the request as signed out.
fn (s Sessions) Lookup(cookie str) !i64 {
	if !s.On {
		return 0
	}
	let id = s.idOf(cookie)
	if len(id) == 0 {
		return 0
	}
	let (v, found) = try s.Client.Get(s.redisKey(id))
	if !found || !twine.HasPrefix(v, "v1 ") {
		return 0
	}
	let n = mint.Atoi(v[3:]) catch _ {
		0
	}
	return n
}

// End ends the session a cookie names (signing out); an unknown cookie is no fault.
fn (s Sessions) End(cookie str) ! {
	if !s.On {
		return
	}
	let id = s.idOf(cookie)
	if len(id) == 0 {
		return
	}
	_ = try s.Client.Del(s.redisKey(id))
}

// SessionUser is the live user a session cookie signs in, or nil: a deleted account's sessions end with it.
fn SessionUser(c postgres.Client, s Sessions, cookie str) !?User {
	let id = try s.Lookup(cookie)
	if id == 0 {
		return nil
	}
	return try UserById(c, id)
}
