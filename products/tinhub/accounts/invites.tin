package accounts

import "../../tit/transport"
import "argo"
import "fault"
import "postgres"
import "seal"
import "twine"

// Invites: how an account gets its first key (design/tinhub.md §1, design/tit.md §18). `tinhub admin invite` makes a
// one-use code for an email; `tit key add URL CODE` sends the email, a public key and the code, signed by that key;
// the server spends the code, makes the account when the email has none, and adds the key. The first site admin
// comes from `tinhub admin invite --admin`.

// InviteTTL is how long an invite lives, in seconds: 7 days, as tit serve's.
const InviteTTL = transport.InviteTTL

// validCode reports whether s has the form of a tit code: 8 letters of tit's alphabet, "ABCD-EFGH".
fn validCode(s str) bool {
	if len(s) != 9 || s[4] != '-' {
		return false
	}
	for i in 0..9 {
		if i != 4 && twine.IndexByte("ABCDEFGHJKMNPQRSTUVWXYZ23456789", s[i]) < 0 {
			return false
		}
	}
	return true
}

// CreateInvite is the code of a new invite for email, made by tinhub itself (`tinhub admin invite`); siteAdmin makes
// the account it creates or extends a site admin.
fn CreateInvite(c postgres.Client, email str, siteAdmin bool) !str {
	return try InviteBy(c, System(), email, 0, siteAdmin)
}

// InviteBy is the code of a new invite for email ("" for anyone, never with siteAdmin), into the org orgId (0 for
// none) as a member. Site admins invite anyone; an org's owners invite into it.
fn InviteBy(c postgres.Client, by Actor, email str, orgId i64, siteAdmin bool) !str {
	mut tx = try c.Begin()
	let (code, err) = inviteIn(mut tx, by, email, orgId, siteAdmin)
	if err != nil {
		rollback(mut tx)
		fail err
	}
	try tx.Commit()
	return code
}

fn inviteIn(tx mut postgres.Tx, by Actor, email str, orgId i64, siteAdmin bool) !str {
	if len(email) > 0 && !validEmail(email) {
		fail fault.Wrap(ErrInvalid, "{email} is not an email address")
	}
	if len(email) == 0 && siteAdmin {
		fail fault.Wrap(ErrInvalid, "an invite that makes a site admin names its email")
	}
	mut may = try mayAdminister(mut tx, by)
	if !may && orgId != 0 && !siteAdmin {
		may = try isOrgOwner(mut tx, orgId, by.Id)
	}
	if !may {
		fail fault.Wrap(ErrForbidden, "only a site admin, or an owner of the org, invites")
	}
	if orgId != 0 {
		let g = try tx.Query("SELECT 1 FROM orgs WHERE id = {orgId} AND deleted_at IS NULL")
		if len(g.Rows) == 0 {
			fail fault.Wrap(ErrNotFound, "no org {orgId}")
		}
	}
	let actor = by.Id
	let ttl = InviteTTL
	for attempt in 0..5 {
		let code = transport.NewCode()
		let rows = try tx.Query("INSERT INTO invites (code, email, org_id, site_admin, created_by, expires_at) VALUES ({code}, {email}, nullif({orgId}, 0), {siteAdmin}, nullif({actor}, 0), now() + make_interval(secs => {ttl})) ON CONFLICT DO NOTHING RETURNING 1")
		if len(rows.Rows) == 1 {
			mut admin = "false"
			if siteAdmin {
				admin = "true"
			}
			// the code is a credential: the log names the invite's email, never its code
			mut kind = "site"
			if orgId != 0 {
				kind = "org"
			}
			try audit(mut tx, by, "invite.create", kind, orgId, []str{"email", email, "site_admin", admin})
			return code
		}
		_ = attempt
	}
	fail "invites: no free code after 5 tries"
}

// nameFor is an owner name made from an email's local part: lower case, a-z 0-9 and -, at most 32 bytes.
fn nameFor(email str) str {
	let at = twine.IndexByte(email, '@')
	mut local = email
	if at >= 0 {
		local = email[0:at]
	}
	mut b = make([]u8, 0, len(local))
	for i in 0..len(local) {
		mut ch = local[i]
		if ch >= 'A' && ch <= 'Z' {
			ch = ch + 32
		}
		let ok = (ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9')
		if ok {
			b = append(b, ch)
		} else if len(b) > 0 && b[len(b) - 1] != '-' {
			b = append(b, '-')
		}
		if len(b) >= 32 {
			break
		}
	}
	for len(b) > 0 && b[len(b) - 1] == '-' {
		b = b[0:len(b) - 1]
	}
	if len(b) == 0 {
		return "user"
	}
	return str(b)
}

// freeName is name, or name-2 .. name-9, or name and four random hex digits: the first no owner has.
fn freeName(tx mut postgres.Tx, name str) !str {
	for i in 1..11 {
		mut n = name
		if i == 10 {
			n = name + "-" + seal.Hex(seal.RandomBytes(2))
		} else if i > 1 {
			n = name + "-{i}"
		}
		let rows = try tx.Query("SELECT 1 FROM owners WHERE name = {n}")
		if len(rows.Rows) == 0 {
			return n
		}
	}
	fail fault.Wrap(ErrExists, "no free name like {name}")
}

// AcceptInvite spends invite code for email and adds the raw ed25519 key pub to that email's account, made first
// (named name, or after the email when name is "") when there is none; ip is where the request came from. An unknown,
// spent or expired invite, or one for another email, is refused (transport.ErrRefused, Unauthorized). A code is spent
// once: two requests racing for it are serialized on its row.
fn AcceptInvite(c postgres.Client, code str, email str, name str, pub []u8, ip str) !User {
	mut tx = try c.Begin()
	let (u, err) = acceptIn(mut tx, code, email, name, pub, ip)
	if err != nil {
		rollback(mut tx)
		fail err
	}
	try tx.Commit()
	return u
}

fn acceptIn(tx mut postgres.Tx, code str, email str, name str, pub []u8, ip str) !User {
	if !validEmail(email) {
		fail fault.Wrap(ErrInvalid, "{email} is not an email address")
	}
	if len(pub) != 32 {
		fail fault.Wrap(ErrInvalid, "an ed25519 public key has 32 bytes, not {len(pub)}")
	}
	if !validCode(code) {
		try refused(transport.Code.Unauthorized, "no invite {code} here (spent, or never made)")
	}
	let rows = try tx.Query("SELECT email, coalesce(org_id, 0), site_admin, expires_at > now(), used_at IS NOT NULL FROM invites WHERE code = {code} FOR UPDATE")
	if len(rows.Rows) == 0 || rows.Rows[0][4].Int() == 1 {
		try refused(transport.Code.Unauthorized, "no invite {code} here (spent, or never made)")
	}
	let inv = rows.Rows[0]
	if inv[3].Int() == 0 {
		try refused(transport.Code.Unauthorized, "invite {code} expired")
	}
	let forEmail = inv[0].Text()
	if len(forEmail) > 0 && twine.ToLower(forEmail) != twine.ToLower(email) {
		try refused(transport.Code.Unauthorized, "invite {code} is for another email")
	}
	let orgId = inv[1].Int()
	let siteAdmin = inv[2].Int() == 1
	// the account: the email's, or a new one
	let found = try tx.Query("SELECT u.id, u.owner_id, o.name, u.email, u.site_admin FROM users u JOIN owners o ON o.id = u.owner_id WHERE lower(u.email) = lower({email}) AND u.deleted_at IS NULL FOR UPDATE OF u")
	mut user = User{Id: 0, OwnerId: 0, Name: "", Email: "", SiteAdmin: false}
	let had = userOf(found)
	if had != nil {
		user = had
	} else {
		mut want = name
		if len(want) == 0 {
			want = try freeName(mut tx, nameFor(email))
		}
		user = try newUser(mut tx, Actor{Id: 0, Ip: ip}, want, email, false)
	}
	let me = Actor{Id: user.Id, Ip: ip}
	if siteAdmin && !user.SiteAdmin {
		_ = try tx.Exec("UPDATE users SET site_admin = true WHERE id = {user.Id}")
		user.SiteAdmin = true
		try audit(mut tx, me, "user.site_admin", "user", user.Id, []str{"site_admin", "true", "by", "invite"})
	}
	if orgId != 0 {
		let m = try tx.Query("INSERT INTO members (org_id, user_id, role) VALUES ({orgId}, {user.Id}, 'member') ON CONFLICT DO NOTHING RETURNING 1")
		if len(m.Rows) == 1 {
			try audit(mut tx, me, "org.member", "org", orgId, []str{"user", "{user.Id}", "role", "member", "by", "invite"})
		}
	}
	// the key: added, unless it is this account's live key already
	let text = seal.B64(pub)
	let k = try tx.Query("SELECT user_id, revoked_at IS NULL FROM keys WHERE public_key = {text}")
	let mine = len(k.Rows) == 1 && k.Rows[0][0].Int() == user.Id && k.Rows[0][1].Int() == 1
	if !mine {
		_ = try newKey(mut tx, me, user.Id, pub, "")
	}
	_ = try tx.Exec("UPDATE invites SET used_at = now(), used_by = {user.Id} WHERE code = {code}")
	try audit(mut tx, me, "invite.accept", "user", user.Id, []str{"email", email})
	return user
}

// KeyAdd answers POST <url>/tit/v1/keys (design/tit.md §18): body is {"email", "key", "invite"}, signed (signature,
// the Tit-Signature header) by the key it adds over the request's path, so the sender holds the key. It accepts the
// invite and returns the account. Refusals are transport.ErrRefused: BadRequest for a bad body, Unauthorized for a
// bad signature or invite, NonceExpired for an old nonce.
fn KeyAdd(c postgres.Client, nonceKey secret str, path str, signature str, body str, ip str, now i64) !User {
	mut req = transport.KeyAdd{Email: "", Key: "", Invite: ""}
	argo.Get(body, mut req) catch e {
		try refused(transport.Code.BadRequest, fault.Message(e))
	}
	let pub = seal.B64Decode(req.Key) catch _ {
		try refused(transport.Code.BadRequest, "the key is not base64")
		[]u8{}
	}
	if len(pub) != 32 || !validEmail(req.Email) {
		try refused(transport.Code.BadRequest, "an email and a 32-byte ed25519 key, please")
	}
	if len(signature) == 0 {
		try refused(transport.Code.Unauthorized, "sign the request with the key you add")
	}
	let (email, nonce, sig) = try transport.ParseSignatureHeader(signature)
	try transport.CheckNonce(nonceKey, nonce, now)
	if email != req.Email {
		try refused(transport.Code.Unauthorized, "signed as {email}, adding a key for {req.Email}")
	}
	let payload = []u8(transport.SigningPayloadOf("POST", path, nonce, seal.Hex(seal.Sha256(body))))
	seal.VerifyEd25519(pub, payload, sig) catch _ {
		try refused(transport.Code.Unauthorized, "the request is not signed by the key it adds")
	}
	return try AcceptInvite(c, req.Invite, req.Email, "", pub, ip)
}
