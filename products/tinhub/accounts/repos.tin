package accounts

import "fault"
import "postgres"

// Repositories (create, rename, visibility, soft delete), their grants and the access check every route makes.
//
// A user's role on a repository is the highest of (design/tinhub.md §5): admin for a site admin, for the user that
// owns it and for an owner of the org that owns it; the user's own grant; the grants of the user's teams; and read
// when the repository is public. A deleted repository, or a deleted user, has no role; anonymous (user 0) reads
// public repositories only.
//
// What each role allows:
//
//	read    heads, fetch and clone; the API's reads; replay capsules (signed)
//	write   push (refs, change versions, packs)
//	admin   rename, visibility, delete, grants

// Repo is a live repository, as the protocol (#1018) and the API (#1019) see it.
type Repo struct {
	Id            i64
	OwnerId       i64
	Owner         str
	Name          str
	Visibility    str
	DefaultBranch str
	QuotaBytes    i64
	SizeBytes     i64
}

// Grant is one row of grants: a role on a repository for a user or (UserId 0) a team.
type Grant struct {
	UserId i64
	TeamId i64
	Role   i64
}

fn repoOf(rows postgres.Rows) ?Repo {
	if len(rows.Rows) == 0 {
		return nil
	}
	let r = rows.Rows[0]
	return Repo{Id: r[0].Int(), OwnerId: r[1].Int(), Owner: r[2].Text(), Name: r[3].Text(), Visibility: r[4].Text(), DefaultBranch: r[5].Text(), QuotaBytes: r[6].Int(), SizeBytes: r[7].Int()}
}

// FindRepo is the live repository owner/name (the name compared without case), or nil; deleted repositories are nil.
fn FindRepo(c postgres.Client, owner str, name str) !?Repo {
	let rows = try c.Query("SELECT r.id, r.owner_id, o.name, r.name, r.visibility, r.default_branch, r.quota_bytes, r.size_bytes FROM repos r JOIN owners o ON o.id = r.owner_id WHERE o.name = lower({owner}) AND lower(r.name) = lower({name}) AND r.deleted_at IS NULL")
	return repoOf(rows)
}

// RepoById is the live repository with this id, or nil.
fn RepoById(c postgres.Client, id i64) !?Repo {
	let rows = try c.Query("SELECT r.id, r.owner_id, o.name, r.name, r.visibility, r.default_branch, r.quota_bytes, r.size_bytes FROM repos r JOIN owners o ON o.id = r.owner_id WHERE r.id = {id} AND r.deleted_at IS NULL")
	return repoOf(rows)
}

fn repoIn(tx mut postgres.Tx, id i64) !Repo {
	let rows = try tx.Query("SELECT r.id, r.owner_id, o.name, r.name, r.visibility, r.default_branch, r.quota_bytes, r.size_bytes FROM repos r JOIN owners o ON o.id = r.owner_id WHERE r.id = {id} AND r.deleted_at IS NULL")
	let r = repoOf(rows)
	if r == nil {
		fail fault.Wrap(ErrNotFound, "no repository {id}")
	}
	return r
}

// roleQuery is the role of user on the live repository repo: one row with the role, none for a deleted repository.
fn roleQuery(user i64, repo i64) query {
	return "SELECT greatest(CASE WHEN r.visibility = 'public' THEN 1 ELSE 0 END, coalesce((SELECT greatest(CASE WHEN u.site_admin OR u.owner_id = r.owner_id THEN 3 ELSE 0 END, coalesce((SELECT 3 FROM members m JOIN orgs g ON g.id = m.org_id WHERE g.owner_id = r.owner_id AND g.deleted_at IS NULL AND m.user_id = u.id AND m.role = 'owner'), 0), coalesce((SELECT max(CASE x.role WHEN 'read' THEN 1 WHEN 'write' THEN 2 ELSE 3 END) FROM grants x WHERE x.repo_id = r.id AND (x.user_id = u.id OR x.team_id IN (SELECT team_id FROM team_members WHERE user_id = u.id))), 0)) FROM users u WHERE u.id = {user} AND u.deleted_at IS NULL), 0)) FROM repos r WHERE r.id = {repo} AND r.deleted_at IS NULL"
}

// RoleOf is the user's role on the repository (RoleNone .. RoleAdmin); userId 0 is anonymous.
fn RoleOf(c postgres.Client, userId i64, r Repo) !i64 {
	let rows = try c.Query(roleQuery(userId, r.Id))
	if len(rows.Rows) == 0 {
		return RoleNone
	}
	return rows.Rows[0][0].Int()
}

fn roleIn(tx mut postgres.Tx, by Actor, repo i64) !i64 {
	if by.Id == 0 {
		return RoleAdmin
	}
	let rows = try tx.Query(roleQuery(by.Id, repo))
	if len(rows.Rows) == 0 {
		return RoleNone
	}
	return rows.Rows[0][0].Int()
}

// verdict is the fault of a role too low for need: ErrNotFound when the user cannot even read (a private repository
// is not admitted to exist), else ErrForbidden.
fn verdict(role i64, need i64, what str) ! {
	if role >= need {
		return
	}
	if role == RoleNone {
		fail fault.Wrap(ErrNotFound, what)
	}
	fail fault.Wrap(ErrForbidden, "{what}: needs {RoleName(need)}, has {RoleName(role)}")
}

// Check fails unless the user has at least role need on the repository: ErrNotFound for a user who cannot read it,
// ErrForbidden for one who can read it but not do this.
fn Check(c postgres.Client, userId i64, r Repo, need i64) ! {
	let role = try RoleOf(c, userId, r)
	try verdict(role, need, "{r.Owner}/{r.Name}")
}

// CreateRepo makes a repository owner/name with visibility "public" or "private" and quota bytes. A user's own
// repositories are made by that user, an org's by its owners; site admins make any.
fn CreateRepo(c postgres.Client, by Actor, owner str, name str, visibility str, quota i64) !Repo {
	mut tx = try c.Begin()
	let (r, err) = createRepoIn(mut tx, by, owner, name, visibility, quota)
	if err != nil {
		rollback(mut tx)
		fail err
	}
	try tx.Commit()
	return r
}

fn createRepoIn(tx mut postgres.Tx, by Actor, owner str, name str, visibility str, quota i64) !Repo {
	if !ValidRepoName(name) {
		fail fault.Wrap(ErrInvalid, "{name}: a repository name is 1 to 100 of A-Z, a-z, 0-9, ., _ and -")
	}
	if visibility != "public" && visibility != "private" {
		fail fault.Wrap(ErrInvalid, "visibility {visibility}: public or private")
	}
	if quota < 0 {
		fail fault.Wrap(ErrInvalid, "a negative quota")
	}
	let o = try tx.Query("SELECT o.id, o.kind, coalesce(u.id, 0), coalesce(g.id, 0) FROM owners o LEFT JOIN users u ON u.owner_id = o.id AND u.deleted_at IS NULL LEFT JOIN orgs g ON g.owner_id = o.id AND g.deleted_at IS NULL WHERE o.name = lower({owner})")
	if len(o.Rows) == 0 || (o.Rows[0][2].Int() == 0 && o.Rows[0][3].Int() == 0) {
		fail fault.Wrap(ErrNotFound, "no user or org {owner}")
	}
	let ownerId = o.Rows[0][0].Int()
	let userId = o.Rows[0][2].Int()
	let orgId = o.Rows[0][3].Int()
	mut may = try mayAdminister(mut tx, by)
	if !may && userId != 0 {
		may = by.Id == userId
	}
	if !may && orgId != 0 {
		may = try isOrgOwner(mut tx, orgId, by.Id)
	}
	if !may {
		fail fault.Wrap(ErrForbidden, "{by.Id} may not make repositories for {owner}")
	}
	let rows = try tx.Query("INSERT INTO repos (owner_id, name, visibility, quota_bytes) VALUES ({ownerId}, {name}, {visibility}, {quota}) ON CONFLICT DO NOTHING RETURNING id")
	if len(rows.Rows) == 0 {
		fail fault.Wrap(ErrExists, "{owner}/{name} exists")
	}
	let id = rows.Rows[0][0].Int()
	try audit(mut tx, by, "repo.create", "repo", id, []str{"owner", owner, "name", name, "visibility", visibility})
	return try repoIn(mut tx, id)
}

// lockRepo locks the live repository's row for a change, and checks by has need on it.
fn lockRepo(tx mut postgres.Tx, by Actor, r Repo, need i64) ! {
	let rows = try tx.Query("SELECT 1 FROM repos WHERE id = {r.Id} AND deleted_at IS NULL FOR UPDATE")
	if len(rows.Rows) == 0 {
		fail fault.Wrap(ErrNotFound, "{r.Owner}/{r.Name}")
	}
	let role = try roleIn(mut tx, by, r.Id)
	try verdict(role, need, "{r.Owner}/{r.Name}")
}

// RenameRepo renames a repository (admin); a name its owner already uses (in any case) is ErrExists.
fn RenameRepo(c postgres.Client, by Actor, r Repo, name str) !Repo {
	mut tx = try c.Begin()
	let (out, err) = renameRepoIn(mut tx, by, r, name)
	if err != nil {
		rollback(mut tx)
		if isUnique(err) {
			fail fault.Wrap(ErrExists, "{r.Owner}/{name} exists")
		}
		fail err
	}
	try tx.Commit()
	return out
}

fn renameRepoIn(tx mut postgres.Tx, by Actor, r Repo, name str) !Repo {
	if !ValidRepoName(name) {
		fail fault.Wrap(ErrInvalid, "{name}: a repository name is 1 to 100 of A-Z, a-z, 0-9, ., _ and -")
	}
	try lockRepo(mut tx, by, r, RoleAdmin)
	let old = try repoIn(mut tx, r.Id)
	_ = try tx.Exec("UPDATE repos SET name = {name} WHERE id = {r.Id}")
	try audit(mut tx, by, "repo.rename", "repo", r.Id, []str{"from", old.Name, "to", name})
	return try repoIn(mut tx, r.Id)
}

// SetVisibility makes a repository "public" or "private" (admin).
fn SetVisibility(c postgres.Client, by Actor, r Repo, visibility str) !Repo {
	mut tx = try c.Begin()
	let (out, err) = setVisibilityIn(mut tx, by, r, visibility)
	if err != nil {
		rollback(mut tx)
		fail err
	}
	try tx.Commit()
	return out
}

fn setVisibilityIn(tx mut postgres.Tx, by Actor, r Repo, visibility str) !Repo {
	if visibility != "public" && visibility != "private" {
		fail fault.Wrap(ErrInvalid, "visibility {visibility}: public or private")
	}
	try lockRepo(mut tx, by, r, RoleAdmin)
	_ = try tx.Exec("UPDATE repos SET visibility = {visibility} WHERE id = {r.Id}")
	try audit(mut tx, by, "repo.visibility", "repo", r.Id, []str{"visibility", visibility})
	return try repoIn(mut tx, r.Id)
}

// DeleteRepo soft-deletes a repository (admin): it is gone for every route, and its name is free again; its rows
// and packs stay until a purge removes them.
fn DeleteRepo(c postgres.Client, by Actor, r Repo) ! {
	mut tx = try c.Begin()
	let err = deleteRepoIn(mut tx, by, r)
	if err != nil {
		rollback(mut tx)
		fail err
	}
	try tx.Commit()
}

fn deleteRepoIn(tx mut postgres.Tx, by Actor, r Repo) ! {
	try lockRepo(mut tx, by, r, RoleAdmin)
	_ = try tx.Exec("UPDATE repos SET deleted_at = now() WHERE id = {r.Id}")
	try audit(mut tx, by, "repo.delete", "repo", r.Id, []str{"owner", r.Owner, "name", r.Name})
}

// GrantUser gives a user a role on the repository, replacing its grant; RoleNone removes it (admin).
fn GrantUser(c postgres.Client, by Actor, r Repo, userId i64, role i64) ! {
	mut tx = try c.Begin()
	let err = grantUserIn(mut tx, by, r, userId, role)
	if err != nil {
		rollback(mut tx)
		fail err
	}
	try tx.Commit()
}

fn grantUserIn(tx mut postgres.Tx, by Actor, r Repo, userId i64, role i64) ! {
	if role < RoleNone || role > RoleAdmin {
		fail fault.Wrap(ErrInvalid, "no role {role}")
	}
	try lockRepo(mut tx, by, r, RoleAdmin)
	if role == RoleNone {
		_ = try tx.Exec("DELETE FROM grants WHERE repo_id = {r.Id} AND user_id = {userId}")
		try audit(mut tx, by, "repo.revoke", "repo", r.Id, []str{"user", "{userId}"})
		return
	}
	let u = try tx.Query("SELECT 1 FROM users WHERE id = {userId} AND deleted_at IS NULL")
	if len(u.Rows) == 0 {
		fail fault.Wrap(ErrNotFound, "no user {userId}")
	}
	let name = RoleName(role)
	_ = try tx.Exec("INSERT INTO grants (repo_id, user_id, role) VALUES ({r.Id}, {userId}, {name}) ON CONFLICT (repo_id, user_id) DO UPDATE SET role = excluded.role")
	try audit(mut tx, by, "repo.grant", "repo", r.Id, []str{"user", "{userId}", "role", name})
}

// GrantTeam gives a team of the org that owns the repository a role on it; RoleNone removes it (admin).
fn GrantTeam(c postgres.Client, by Actor, r Repo, teamId i64, role i64) ! {
	mut tx = try c.Begin()
	let err = grantTeamIn(mut tx, by, r, teamId, role)
	if err != nil {
		rollback(mut tx)
		fail err
	}
	try tx.Commit()
}

fn grantTeamIn(tx mut postgres.Tx, by Actor, r Repo, teamId i64, role i64) ! {
	if role < RoleNone || role > RoleAdmin {
		fail fault.Wrap(ErrInvalid, "no role {role}")
	}
	try lockRepo(mut tx, by, r, RoleAdmin)
	if role == RoleNone {
		_ = try tx.Exec("DELETE FROM grants WHERE repo_id = {r.Id} AND team_id = {teamId}")
		try audit(mut tx, by, "repo.revoke", "repo", r.Id, []str{"team", "{teamId}"})
		return
	}
	let t = try tx.Query("SELECT 1 FROM teams t JOIN orgs g ON g.id = t.org_id JOIN repos r ON r.owner_id = g.owner_id WHERE t.id = {teamId} AND r.id = {r.Id}")
	if len(t.Rows) == 0 {
		fail fault.Wrap(ErrInvalid, "team {teamId} is not a team of the org that owns {r.Owner}/{r.Name}")
	}
	let name = RoleName(role)
	_ = try tx.Exec("INSERT INTO grants (repo_id, team_id, role) VALUES ({r.Id}, {teamId}, {name}) ON CONFLICT (repo_id, team_id) DO UPDATE SET role = excluded.role")
	try audit(mut tx, by, "repo.grant", "repo", r.Id, []str{"team", "{teamId}", "role", name})
}

// Grants is the repository's grants, users first.
fn Grants(c postgres.Client, r Repo) ![]Grant {
	let rows = try c.Query("SELECT coalesce(user_id, 0), coalesce(team_id, 0), role FROM grants WHERE repo_id = {r.Id} ORDER BY team_id NULLS FIRST, user_id, team_id")
	mut out = []Grant{}
	for row in rows.Rows {
		let role = try ParseRole(row[2].Text())
		out = append(out, Grant{UserId: row[0].Int(), TeamId: row[1].Int(), Role: role})
	}
	return out
}
