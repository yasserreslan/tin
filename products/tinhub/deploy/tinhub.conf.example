# /etc/tinhub/tinhub.conf for phase 1: one server, every role, Postgres on localhost, content in an R2 bucket
# (design/tinhub.md §3 lists every key). Secrets are file:PATH, files readable by the tinhub user only.
roles = node,worker,runner
listen = :443
public_url = https://tinhub.example.org
tls.cert = /etc/tinhub/tls/fullchain.pem
tls.key = /etc/tinhub/tls/privkey.pem
db.addr = 127.0.0.1:5432
db.user = tinhub
db.name = tinhub
db.password = file:/etc/tinhub/secrets/db
redis.addr = 127.0.0.1:6379
# content (packs, capsules, diffs) lives in object storage; Postgres holds the pointers. Any S3-compatible store works:
# R2 below; for AWS S3, s3.endpoint = https://s3.REGION.amazonaws.com and s3.region = REGION; for MinIO, its URL.
packs.store = s3
s3.endpoint = https://ACCOUNT_ID.r2.cloudflarestorage.com
s3.region = auto
s3.bucket = tinhub
s3.access_key = R2_ACCESS_KEY_ID
s3.secret_key = file:/etc/tinhub/secrets/s3
# packs.dir is this node's cache of the bucket and its scratch space, not a copy of record
packs.dir = /var/lib/tinhub
packs.cache = 10gb
secrets.nonce = file:/etc/tinhub/secrets/nonce
secrets.cookie = file:/etc/tinhub/secrets/cookie
log.level = info
# the runner (design/tinhub.md §12): without runner.key it runs no replays; the toolchain is a Tin release unpacked here
runner.key = file:/etc/tinhub/secrets/runner
runner.tin = /usr/local/lib/tin
