# Keeps the Tin repo on tinhub a mirror of GitHub (deploy/RUNBOOK.md, "The Tin repo as a mirror").
[Unit]
Description=tinhub mirror of the Tin repo
After=tinhub.service

[Service]
Type=oneshot
User=tinhub-mirror
Environment=TIT=/usr/local/bin/tit
ExecStart=/usr/local/lib/tinhub/mirror-sync.sh /var/lib/tinhub-mirror/tin main
