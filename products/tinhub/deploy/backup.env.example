# /etc/tinhub/backup.env: what backup.sh needs, the same values as tinhub.conf. The pack store's keys (the bucket) are
# read by tinhub itself from /etc/tinhub/tinhub.conf.
TINHUB_DB_ADDR=127.0.0.1:5432
TINHUB_DB_NAME=tinhub
TINHUB_DB_USER=tinhub
TINHUB_DB_PASSWORD=file:/etc/tinhub/secrets/db
TINHUB_BACKUP_KEEP=14
