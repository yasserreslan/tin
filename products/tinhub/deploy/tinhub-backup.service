# The nightly backup (deploy/RUNBOOK.md): a pg_dump and the objects the last one lacks, into /var/backups/tinhub.
[Unit]
Description=tinhub nightly backup
After=postgresql.service

[Service]
Type=oneshot
User=tinhub
Group=tinhub
EnvironmentFile=/etc/tinhub/backup.env
ExecStart=/usr/local/lib/tinhub/backup.sh /var/backups/tinhub
