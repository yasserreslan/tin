# tinhub, phase 1: every role in one process on one Linux server, Postgres on the same host, packs on disk
# (design/tinhub.md §9, deploy/RUNBOOK.md). Install as /etc/systemd/system/tinhub.service.
[Unit]
Description=tinhub
Documentation=https://github.com/yasserreslan/tin/blob/main/products/tinhub/deploy/RUNBOOK.md
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=tinhub
Group=tinhub
# the schema is migrated before every start: a no-op when it is current, and two migrators take turns
ExecStartPre=/usr/local/bin/tinhub migrate --config /etc/tinhub/tinhub.conf
ExecStart=/usr/local/bin/tinhub run --config /etc/tinhub/tinhub.conf
# tinhub ignores SIGHUP; certificates are read again whenever their files change
ExecReload=/bin/kill -HUP $MAINPID
# SIGTERM drains: requests in flight finish within shutdown.deadline (30s by default), jobs go back to the queue
KillSignal=SIGTERM
TimeoutStopSec=45
Restart=on-failure
RestartSec=2
LimitNOFILE=1048576
# hardening: the binary is static and writes only under /var/lib/tinhub
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/tinhub
# to listen on 443 as the tinhub user
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
