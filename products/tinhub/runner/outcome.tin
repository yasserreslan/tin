package runner

import "mint"
import "twine"

// What a replay printed, and how a change's replay compares with its base's (design/tinhub.md §12). tin replay prints
// its report and then the response body (design/interface_replay.md §8):
//
//   replay: status S (recorded R)            or  replay: no response (recorded R)
//   replay: divergence at effect N: got KIND "KEY", recorded KIND "KEY"   (or "recorded nothing more")
//   replay: K recorded effects not served
//   <body>
//
// Only the numbers and the effect kinds are kept: the keys and the body hold the recorded request's data, which never
// leaves the runner.

// Report is one replay's outcome.
type Report struct {
	// Ran is false when the capsule could not be replayed at all (Why says why: unreadable, not sealed for the runner)
	Ran      bool
	Why      str
	Status   i64
	Recorded i64
	TimedOut bool
	// Effect is the first effect that diverged, -1 for none; Got and Want its kind and the recorded kind ("" for
	// nothing more recorded)
	Effect i64
	Got    str
	Want   str
	// Left is how many recorded effects the replay did not ask for
	Left i64
	Body str
}

// NoReport is a replay that did not run.
fn NoReport(why str) Report {
	return Report{Ran: false, Why: why, Status: 0, Recorded: 0, TimedOut: false, Effect: -1, Got: "", Want: "", Left: 0, Body: ""}
}

// ParseReport reads what tin replay printed on stdout and stderr.
fn ParseReport(stdout str, stderr str) Report {
	let head = "replay: status "
	let none = "replay: no response (recorded "
	mut r = Report{Ran: true, Why: "", Status: 0, Recorded: 0, TimedOut: false, Effect: -1, Got: "", Want: "", Left: 0, Body: ""}
	let (first, rest, _) = twine.Cut(stdout, "\n")
	if twine.HasPrefix(first, head) {
		let (s, rec, ok) = twine.Cut(first[len(head):], " (recorded ")
		if !ok {
			return NoReport(unreadable(stderr))
		}
		r.Status = number(s)
		r.Recorded = number(twine.TrimSuffix(rec, ")"))
	} else if twine.HasPrefix(first, none) {
		r.Recorded = number(twine.TrimSuffix(first[len(none):], ")"))
	} else {
		return NoReport(unreadable(stderr))
	}
	mut body = rest
	let div = "replay: divergence at effect "
	if twine.HasPrefix(body, div) {
		let (line, after, _) = twine.Cut(body, "\n")
		body = after
		let (n, what, _) = twine.Cut(line[len(div):], ": ")
		r.Effect = number(n)
		r.Got = kindAfter(what, "got ")
		if twine.Contains(what, ", recorded nothing more") {
			r.Want = ""
		} else {
			let at = twine.LastIndex(what, ", recorded ")
			if at >= 0 {
				r.Want = kindAfter(what[at + 2:], "recorded ")
			}
		}
	}
	if twine.HasPrefix(body, "replay: ") && twine.Contains(body, " recorded effects not served") {
		let (line, after, _) = twine.Cut(body, "\n")
		if twine.HasSuffix(line, " recorded effects not served") {
			r.Left = number(twine.TrimSuffix(line[8:], " recorded effects not served"))
			body = after
		}
	}
	r.Body = body
	return r
}

// unreadable is why a capsule did not replay: tin replay's own message about the capsule when it gave one (fixed
// texts with no data of the request, such as "not sealed for this key"), else a word for it.
fn unreadable(stderr str) str {
	let line = twine.TrimSpace(firstLine(stderr))
	let mark = "replay: capsule: "
	let at = twine.Index(line, mark)
	if at >= 0 {
		return "unreadable: " + clean(line[at + len(mark):], 120)
	}
	return "unreadable"
}

fn firstLine(s str) str {
	let (a, _, _) = twine.Cut(s, "\n")
	return a
}

// clean keeps the letters, digits, spaces and a little punctuation of s, at most n bytes of it.
fn clean(s str, n i64) str {
	mut b = []u8{}
	for c in s {
		if len(b) >= n {
			break
		}
		let ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == ' ' || c == '.' || c == ',' || c == '(' || c == ')' || c == '_' || c == '-'
		if ok {
			b = append(b, u8(c))
		}
	}
	return str(b)
}

// kindAfter is the effect kind that follows word in text ("got redis@1 ..."): a name@version of at most 40 bytes, or
// "?" when what follows is not one.
fn kindAfter(text str, word str) str {
	let at = twine.Index(text, word)
	if at < 0 {
		return "?"
	}
	let rest = text[at + len(word):]
	mut end = 0
	for end < len(rest) && end <= 40 && isKindByte(rest[end]) {
		end += 1
	}
	if end == 0 || end > 40 || !twine.Contains(rest[0:end], "@") {
		return "?"
	}
	return rest[0:end]
}

fn isKindByte(c u8) bool {
	return (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '.' || c == '@' || c == '_' || c == '-'
}

fn number(s str) i64 {
	let n = mint.Atoi(twine.TrimSpace(s)) catch _ {
		-1
	}
	return n
}

// The outcomes of one capsule, in the order the panel shows them.
const OutcomeCalls = "calls"

const OutcomeError = "error"

const OutcomeBody = "body"

const OutcomeSame = "same"

const OutcomeSkipped = "skipped"

// Verdict is one capsule's outcome: its kind, the group it joins (one per first differing effect), the group's label
// and that effect (-1 for none).
type Verdict value struct {
	Outcome str
	Key     str
	Label   str
	Effect  i64
}

// diverged reports whether a replay asked for other effects than were recorded.
fn diverged(r Report) bool {
	return r.Effect >= 0 || r.Left > 0
}

// sameCalls reports whether two replays diverged alike (or neither did).
fn sameCalls(a Report, b Report) bool {
	return a.Effect == b.Effect && a.Got == b.Got && a.Want == b.Want && a.Left == b.Left
}

fn failing(r Report) bool {
	return r.TimedOut || r.Status == 0 || r.Status >= 500
}

// Compare is the outcome of a capsule replayed against the change (change) and against the change's base (base; when
// the base has no build, hasBase is false and the change is compared with the recording). The first difference
// decides, in the order a request meets them: the calls it makes (grouped by the first effect that differs), then a
// new 5xx, panic or timeout, then the response.
fn Compare(change Report, base Report, hasBase bool) Verdict {
	if !change.Ran {
		return Verdict{Outcome: OutcomeSkipped, Key: "skipped " + change.Why, Label: change.Why, Effect: -1}
	}
	mut ref = base
	if !hasBase || !base.Ran {
		ref = Report{Ran: true, Why: "", Status: change.Recorded, Recorded: change.Recorded, TimedOut: false, Effect: -1, Got: "", Want: "", Left: 0, Body: change.Body}
	}
	if !sameCalls(change, ref) {
		// the run that diverged first names the effect; the change's when both did at the same one
		mut d = change
		if !diverged(change) || (diverged(ref) && ref.Effect >= 0 && (change.Effect < 0 || ref.Effect < change.Effect)) {
			d = ref
		}
		if d.Effect < 0 {
			let fewer = "different calls: recorded effects not asked for"
			return Verdict{Outcome: OutcomeCalls, Key: "calls end", Label: fewer, Effect: -1}
		}
		mut want = d.Want
		if len(want) == 0 {
			want = "nothing more"
		}
		let label = "different calls at effect {d.Effect}: got {d.Got}, recorded {want}"
		return Verdict{Outcome: OutcomeCalls, Key: "calls {d.Effect} {d.Got} {want}", Label: label, Effect: d.Effect}
	}
	if failing(change) && !failing(ref) {
		if change.TimedOut {
			return Verdict{Outcome: OutcomeError, Key: "error timeout", Label: "new failure: the replay timed out", Effect: -1}
		}
		if change.Status == 0 {
			return Verdict{Outcome: OutcomeError, Key: "error none", Label: "new failure: no response (a panic or a crash)", Effect: -1}
		}
		return Verdict{Outcome: OutcomeError, Key: "error {change.Status}", Label: "new 5xx: status {change.Status}", Effect: -1}
	}
	if change.Status != ref.Status {
		return Verdict{Outcome: OutcomeBody, Key: "body {ref.Status} {change.Status}", Label: "different response: status {ref.Status}, now {change.Status}", Effect: -1}
	}
	if change.Body != ref.Body {
		return Verdict{Outcome: OutcomeBody, Key: "body {change.Status}", Label: "different body (status {change.Status})", Effect: -1}
	}
	return Verdict{Outcome: OutcomeSame, Key: "same", Label: "same", Effect: -1}
}

// outcomeRank orders the panel's groups: what changed most first.
fn outcomeRank(outcome str) i64 {
	return match outcome {
		"calls" => 0
		"error" => 1
		"body" => 2
		"same" => 3
		_ => 4
	}
}
