package runner

import "twine"

// A replay check's verdict (design/tinhub.md §12.1): one capsule replayed against a chosen build, judged against its
// own recording, with a label for the list and an explanation of why. The order of the questions is the order a
// request meets them: did the build ask for the calls production made (else it diverged, and nothing after that point
// is known), did it finish (else it timed out), did it panic, and what did it answer.

// The verdicts, in the order the page shows them.
const VerdictPassed = "passed"

const VerdictDiverged = "diverged"

const VerdictPanicked = "panicked"

const VerdictFailing = "failing"

const VerdictTimeout = "timeout"

const VerdictSkipped = "skipped"

// Judgement is one capsule's verdict, its one-line label and the explanation.
type Judgement struct {
	Verdict str
	Label   str
	Detail  str
	// PanicIn is the function the build panicked in ("" for none): code, never the request's data
	PanicIn str
}

// PanicOf is the panic message and the function it happened in from a replayed program's stderr ("panic: MSG", then
// "core N:" and the frames, innermost first); "", "" when it did not panic.
fn PanicOf(stderr str) (str, str) {
	let lines = twine.Split(stderr, "\n")
	for i, line in lines {
		if !twine.HasPrefix(line, "panic: ") {
			continue
		}
		let msg = line[7:]
		mut where = ""
		mut j = i + 1
		for j < len(lines) && j < i + 6 {
			let l = lines[j]
			if twine.HasPrefix(l, "\t") {
				where = frameName(twine.TrimSpace(l))
				break
			}
			j += 1
		}
		return msg, where
	}
	return "", ""
}

// frameName keeps a frame's function name: letters, digits, '.', '_' and '$', at most 80 bytes.
fn frameName(s str) str {
	mut b = []u8{}
	for c in s {
		let ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '.' || c == '_' || c == '$'
		if !ok || len(b) >= 80 {
			break
		}
		b = append(b, u8(c))
	}
	return str(b)
}

// CallName is what an effect kind is, in words: "a Redis command" for redis@1.
fn CallName(kind str) str {
	let (name, _, _) = twine.Cut(kind, "@")
	return match name {
		"redis" => "a Redis command"
		"wire.http" => "an HTTP request"
		"wire.dial" => "a TCP connection"
		"wire.read" => "a read from a TCP connection"
		"wire.write" => "a write to a TCP connection"
		"postgres" => "a Postgres query"
		"postgres.tx" => "a Postgres transaction step"
		"mysql" => "a MySQL query"
		"mysql.tx" => "a MySQL transaction step"
		"kafka" => "a Kafka request"
		"tide.now" => "a clock read"
		"tide.wall" => "a wall-clock read"
		"dice.seed" => "a random draw"
		"seal.random" => "random bytes"
		"quarry.read" => "a file read"
		"quarry.write" => "a file write"
		"quarry.stat" => "a file lookup"
		"quarry.dir" => "a directory listing"
		"quarry.fs" => "a file-system change"
		"?" => "a call"
		"" => "a call"
		_ => "a {name} call"
	}
}

fn statusWords(status i64, panicked bool) str {
	if status == 0 {
		return "no response"
	}
	if panicked {
		return "{status} after a panic"
	}
	return "{status}"
}

// Judge is the verdict of a replay r of a capsule whose failure group panicked with groupPanic ("" when it did not or
// its summary did not say), the replayed program having printed panicMsg in panicIn ("" for no panic).
fn Judge(r Report, panicMsg str, panicIn str, groupPanic str) Judgement {
	let recordedPanic = len(groupPanic) > 0
	let recorded = statusWords(r.Recorded, recordedPanic)
	if !r.Ran {
		let detail = "The runner could not replay this capsule ({r.Why}). It opens only capsules sealed for its own key: the recording server adds the runner's public key (GET /api/v1/orgs/<org>/runner) to TIN_REPLAY_RECIPIENTS, and capsules recorded from then on can be checked."
		return Judgement{Verdict: VerdictSkipped, Label: "not replayed: {r.Why}", Detail: detail, PanicIn: ""}
	}
	if r.Effect >= 0 {
		if len(r.Want) == 0 {
			let label = "diverged at effect {r.Effect}: an extra {r.Got}"
			let detail = "This build made every call production made, then one more: at effect {r.Effect} it asked for {CallName(r.Got)} ({r.Got}) where the recording has nothing more. A replay answers each call from the capsule, in order, so it cannot answer a call production never made; from there the build only saw failures, and its answer says nothing about the fix. A retry or a new write after the failing call shows this way. Check it with a capsule recorded from a build that makes this call, or keep the call out of this path."
			return Judgement{Verdict: VerdictDiverged, Label: label, Detail: detail, PanicIn: ""}
		}
		if r.Got == r.Want {
			let label = "diverged at effect {r.Effect}: {r.Got} with other arguments"
			let detail = "At effect {r.Effect} this build made {CallName(r.Got)} ({r.Got}) as production did, but not the same one: another URL, query, key or body. A replay answers a call only when it is the very call production made, so from effect {r.Effect} on the build saw only failures, and its status says nothing about the fix. Either the change builds this call differently, or the replayed program's environment is not the recording server's: a different service URL in the runner's env (Settings, Runner) changes every call to it."
			return Judgement{Verdict: VerdictDiverged, Label: label, Detail: detail, PanicIn: ""}
		}
		let label = "diverged at effect {r.Effect}: {r.Got} where production made {r.Want}"
		let detail = "At effect {r.Effect} this build asked for {CallName(r.Got)} ({r.Got}) where production made {CallName(r.Want)} ({r.Want}). The two runs agreed up to there, then took different paths. A replay answers each call from the capsule, in order, so from effect {r.Effect} on it has no true answer to give: the build saw only failures, and its status says nothing about the fix. A new lookup before the call that failed shows this way. Check it with a capsule recorded from a build that makes this call."
		return Judgement{Verdict: VerdictDiverged, Label: label, Detail: detail, PanicIn: ""}
	}
	if r.Left > 0 {
		let label = "diverged: answered without {r.Left} recorded call{plural(r.Left)}"
		mut calls = "the last {r.Left} calls"
		if r.Left == 1 {
			calls = "the last call"
		}
		let detail = "This build answered ({statusWords(r.Status, len(panicMsg) > 0)}) without making {calls} production made. Every call it did make matched the recording. Answering early can be the fix (a request refused before it reaches the service that failed), but the replay cannot show what the skipped calls would have done, so it is not a pass. Read the answer: if refusing early is right, this is the fix working as meant."
		return Judgement{Verdict: VerdictDiverged, Label: label, Detail: detail, PanicIn: ""}
	}
	if r.TimedOut {
		let detail = "The replay did not finish in time. A replay waits on nothing outside the build (every call is answered from the capsule at once), so this is the build itself: a loop that does not end, or a wait on a lane, a select or a lock that nothing wakes."
		return Judgement{Verdict: VerdictTimeout, Label: "timed out", Detail: detail, PanicIn: ""}
	}
	if len(panicMsg) > 0 || r.Status == 0 {
		mut label = "panicked"
		if len(panicIn) > 0 {
			label = "panicked in {panicIn}"
		}
		mut what = "It panicked"
		if len(panicIn) > 0 {
			what = "It panicked in {panicIn}"
		}
		if len(panicMsg) > 0 && panicMsg == groupPanic {
			label = label + ": the recorded panic"
			what = what + " with the panic production had: {panicMsg}"
		} else if len(panicMsg) > 0 && recordedPanic {
			what = what + ", with another message than production's"
		} else if len(panicMsg) == 0 {
			label = "no response"
			what = "It gave no response: it crashed, or panicked outside a handler"
		}
		let detail = "Every call matched the recording, so this replay is faithful up to the failure. {what}. The fix does not cover this request: the same data still reaches the code that fails (production answered {recorded})."
		return Judgement{Verdict: VerdictPanicked, Label: label, Detail: detail, PanicIn: panicIn}
	}
	if r.Status >= 500 {
		mut detail = "Every call matched the recording and nothing panicked, but the build answers {r.Status}."
		if r.Status == r.Recorded && !recordedPanic {
			detail = detail + " That is what production answered: the failure is reproduced, not fixed."
		} else {
			detail = detail + " Production answered {recorded}."
		}
		detail = detail + " When the capsule recorded a dependency failing (a refused connection, a 5xx from a service), the replay serves that same failure, so an error answer can be right: a 502 or 503 says the request may be retried, a 500 says the code failed."
		return Judgement{Verdict: VerdictFailing, Label: "still fails: status {r.Status}", Detail: detail, PanicIn: ""}
	}
	if r.Recorded >= 500 || r.Recorded == 0 || recordedPanic {
		let detail = "Fixed. Production answered {recorded}; this build answers {r.Status} without a panic, and it made exactly the calls production made, in the same order, so every answer it read was the real one from the incident. That is the strongest evidence a replay gives: the same input, the same world, a different outcome."
		return Judgement{Verdict: VerdictPassed, Label: "passed: {r.Status}, recorded {recorded}", Detail: detail, PanicIn: ""}
	}
	if r.Status == r.Recorded {
		let detail = "Matches production: the same calls in the same order and the same status ({r.Status}). This request did not fail when it was recorded, and the build still serves it the same way."
		return Judgement{Verdict: VerdictPassed, Label: "passed: {r.Status}, as recorded", Detail: detail, PanicIn: ""}
	}
	let detail = "No failure: the same calls in the same order, and status {r.Status} where production answered {r.Recorded}. Check the new status is the one you meant."
	return Judgement{Verdict: VerdictPassed, Label: "passed: {r.Status}, recorded {r.Recorded}", Detail: detail, PanicIn: ""}
}

fn plural(n i64) str {
	if n == 1 {
		return ""
	}
	return "s"
}

// verdictRank orders a check's verdicts: what needs a look first.
fn verdictRank(v str) i64 {
	return match v {
		"panicked" => 0
		"failing" => 1
		"timeout" => 2
		"diverged" => 3
		"skipped" => 4
		_ => 5
	}
}
