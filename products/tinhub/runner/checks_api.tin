package runner

import "anvil"
import "argo"
import "fault"
import "mint"

// The replay checks' routes (design/tinhub.md §12.1), under /api/v1/repos/<owner>/<repo>/replay/checks. They take
// read access and the replay permission, as the capsules they replay do.

type countOut value struct {
	verdict str
	count   i64
}

type checkOut struct {
	id          i64
	target      str
	commit      str
	group       str
	capsule     str
	state       str
	reason      str
	capsules    i64
	created_at  i64
	finished_at i64
	by          str
	counts      []countOut
}

type resultOut struct {
	capsule  str
	route    str
	verdict  str
	label    str
	detail   str
	status   i64
	recorded i64
	effect   i64
	got      str
	want     str
	left     i64
	panic_in str
}

type checksOut struct {
	opted_in bool
	checks   []checkOut
}

type checkDetailOut struct {
	check   checkOut
	results []resultOut
}

type checkIn struct {
	target  str
	group   str
	capsule str
}

fn checkOutOf(k CheckInfo) checkOut {
	mut counts = []countOut{}
	for c in k.Counts {
		counts = append(counts, countOut{verdict: c.Verdict, count: c.Count})
	}
	return checkOut{id: k.Id, target: k.Target, commit: k.Commit, group: k.Group, capsule: k.Capsule, state: k.State, reason: k.Reason, capsules: k.Capsules, created_at: k.Created, finished_at: k.Finished, by: k.By, counts: counts}
}

// getChecks is the repository's checks (?group=ID for one failure group's), newest first, and whether its owner opted
// in to the runner (a check needs it).
fn getChecks(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, false)
	if c == nil {
		return
	}
	mut n = mint.Atoi(q.Param("limit")) catch _ {
		20
	}
	if n < 1 || n > 100 {
		n = 20
	}
	let (out, err) = readChecks(c, q.Param("group"), n)
	if err != nil {
		answerErr(mut w, err)
		return
	}
	send(mut w, out)
}

fn readChecks(c call, group str, n i64) !checksOut {
	mut out ?checksOut = nil
	try within readWithin {
		let ks = try ChecksOf(c.d.Db, c.r.Id, group, n)
		let opt = try OptInOf(c.d.Db, c.r.OwnerId)
		mut list = []checkOut{}
		for k in ks {
			list = append(list, checkOutOf(k))
		}
		out = keep(checksOut{opted_in: opt != nil, checks: list})
	}
	if out == nil {
		fail "no checks"
	}
	return out
}

// getCheck is one check and each capsule's verdict.
fn getCheck(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, false)
	if c == nil {
		return
	}
	let id = mint.Atoi(q.PathParam("id")) catch _ {
		0
	}
	let (out, err) = readCheck(c, id)
	if err != nil {
		answerErr(mut w, err)
		return
	}
	send(mut w, out)
}

fn readCheck(c call, id i64) !checkDetailOut {
	mut out ?checkDetailOut = nil
	try within readWithin {
		let k = try CheckOf(c.d.Db, c.r.Id, id)
		if k == nil {
			fail fault.Wrap(ErrNotFound, "no check {id}")
		}
		let rs = try CheckResults(c.d.Db, k.Id)
		mut results = []resultOut{}
		for r in rs {
			results = append(results, resultOut{capsule: r.Capsule, route: r.Route, verdict: r.Verdict, label: r.Label, detail: r.Detail, status: r.Status, recorded: r.Recorded, effect: r.Effect, got: r.Got, want: r.Want, left: r.Left, panic_in: r.PanicIn})
		}
		out = keep(checkDetailOut{check: checkOutOf(k), results: results})
	}
	if out == nil {
		fail fault.Wrap(ErrNotFound, "no check {id}")
	}
	return out
}

// postCheck queues a check of a revision ({"target": branch, tag, change or commit, "group": failure group, "capsule":
// one of its capsules, optional}): 202 and the check, 404 when the revision, group or capsule is not the repository's,
// 409 when its owner has not opted in to the runner.
fn postCheck(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, false)
	if c == nil {
		return
	}
	mut v = checkIn{target: "", group: "", capsule: ""}
	argo.Get(q.Body(), mut v) catch err {
		fail_(mut w, 400, "bad_request", fault.Message(err))
		return
	}
	if len(v.group) == 0 || len(v.group) > 128 || len(v.capsule) > 128 {
		fail_(mut w, 400, "bad_request", "a check needs the failure group it replays (group)")
		return
	}
	let (id, err) = requestCheck(c, v)
	if err != nil {
		if fault.Is(err, ErrNoRevision) || fault.Is(err, ErrNoGroup) {
			fail_(mut w, 404, "not_found", fault.Message(err))
			return
		}
		answerErr(mut w, err)
		return
	}
	if id == 0 {
		fail_(mut w, 409, "not_opted_in", "the owner of {c.r.Owner}/{c.r.Name} has not opted in to the runner: an owner turns it on with PUT /api/v1/orgs/{c.r.Owner}/runner")
		return
	}
	let (out, rerr) = readCheck(c, id)
	if rerr != nil {
		answerErr(mut w, rerr)
		return
	}
	w.Status(202)
	send(mut w, out.check)
}

fn requestCheck(c call, v checkIn) !i64 {
	mut id = 0
	try within writeWithin {
		id = try RequestCheckNow(c.d.Db, c.r.Id, v.target, v.group, v.capsule, c.user)
	}
	return id
}
