package runner

import "../../tit/object"
import "../events"
import "../packs"
import "../repo"
import "anvil"
import "argo"
import "fault"
import "herald"
import "mint"
import "postgres"
import "quarry"
import "replay"
import "sandbox"
import "seal"
import "tide"
import "twine"

// The runner role (design/tinhub.md §12, #1028): a change version's behaviour, seen through production's own requests.
// A run builds the change's commit and its base (its first parent) with tinc and replays a sample of the repository's
// capsules against both with tin replay --against, every step in packages/sandbox: no network (a replay gets a network
// namespace of its own whose loopback alone is up, because tin replay sends the request to the program over it), the
// sources and the toolchain read-only, one scratch directory, and a lower CPU weight. Each capsule's outcome is the
// first difference between the two replays: different calls (grouped by the first effect that differs, so one new SQL
// query is one group however many requests meet it), a new 5xx, panic or timeout, a different response, or the same.
//
// Only owners that opt in are replayed: an org's owners opt in for the runner key the runner registered, and their
// recording servers add its public key to TIN_REPLAY_RECIPIENTS, so capsules recorded from then on are sealed for it too
// (a capsule's reader blocks name their key ids in plain, which is how a run finds the capsules it can open). The
// private key (runner.key) stays in the runner: it is written only into the run's scratch directory, the one the
// sandbox mounts, for the replay to open the capsule, and deleted with it. Postgres keeps outcomes, statuses, effect
// numbers and kinds; never a request, a body or an effect's key.

// KindRun is the runner's job: {"run": <runner_runs id>}.
const KindRun = "replay.run"

// Deps is what the runner and its API need, set on every core (Configure) before the first request or job.
type Deps struct {
	Db    postgres.Client
	Store dyn packs.PackStore
	// Dir is packs.dir: a run works in Dir/runner/<run>-<random>, removed when it ends
	Dir str
	// Tin is runner.tin, the Tin toolchain (bin/tinc, the tin command, toolchain/std, packages) the sandboxes mount at /tin
	Tin str
	// Key is runner.key, the runner's replay private key (tinreplaykey1:…); "" on a process that runs no replays
	Key secret str
	// Cgroup is runner.cgroup, the delegated cgroup v2 directory each sandbox gets a child of, "" for none (then no limit
	// and no CPU weight applies)
	Cgroup str
	// Auth is the signed-in user of an API request, 0 for nobody
	Auth fn(anvil.Req) !i64
	// Lease is how long the job's lease is renewed for after each sandbox (workers.lease)
	Lease i64
	// BuildTimeout and ReplayTimeout bound one build and one replay
	BuildTimeout  i64
	ReplayTimeout i64
}

// NewDeps is Deps with the default lease (5m) and timeouts (a build 5m, a replay 30s).
fn NewDeps(c postgres.Client, s dyn packs.PackStore, dir str, tin str, key secret str, cgroup str, auth fn(anvil.Req) !i64) Deps {
	return Deps{Db: c, Store: s, Dir: twine.TrimRight(dir, "/"), Tin: twine.TrimRight(tin, "/"), Key: key, Cgroup: cgroup, Auth: auth, Lease: 5 * tide.Minute, BuildTimeout: 5 * tide.Minute, ReplayTimeout: 30 * tide.Second}
}

// deps is this core's: globals are per core.
mut deps ?Deps = nil

// Configure sets this core's dependencies.
fn Configure(d Deps) {
	deps = keep(d)
}

fn depsOf() !Deps {
	let got = deps
	if got == nil {
		fail "runner: not configured on this core"
	}
	return got
}

// storeOf is this core's pack store (read from the global: a store taken from a parameter's field trips a false E701,
// #1073).
fn storeOf() !dyn packs.PackStore {
	let d = try depsOf()
	return d.Store
}

// ErrNoVersion is the fault of a change version the repository does not have.
let ErrNoVersion = fault("no such change version")

// ---- the runner's key ----

const keyPrefix = "tinreplaykey1:"

const pubPrefix = "tinreplay1:"

// KeyOf is the runner key's public key (tinreplay1:…, for TIN_REPLAY_RECIPIENTS) and key id (hex SHA-256 of the public
// key's bytes, as a capsule's reader block names it), from the private key's text.
fn KeyOf(private secret str) !(str, str) {
	let text = twine.TrimSpace(reveal(private))
	let id = try replay.ParseIdentity(text)
	let raw = try seal.B64Decode(text[len(keyPrefix):])
	let xpub = try seal.X25519PublicKey(raw[0:32])
	let (_, ek) = try seal.MLKEM768KeyFromSeed(raw[32:96])
	mut pub = []u8{}
	pub = append(pub, xpub...)
	pub = append(pub, ek...)
	let keyId = seal.Hex(seal.Sha256(str(pub)))
	if keyId != seal.Hex([]u8(id.Id)) {
		fail "runner: runner.key does not match its own public key"
	}
	return pubPrefix + seal.B64(pub), keyId
}

// Register records this runner's public key, so owners can opt in for it (GET /api/v1/orgs/<org>/runner shows the
// newest); its key id. A runner calls it at start and before each run.
fn Register(c postgres.Client, private secret str) !str {
	let (pub, keyId) = try KeyOf(private)
	_ = try c.Exec("INSERT INTO runner_keys (key_id, public_key) VALUES ({keyId}, {pub}) ON CONFLICT (key_id) DO UPDATE SET seen_at = now()")
	return keyId
}

// RunnerKey is a registered runner key.
type RunnerKey struct {
	Id     str
	Public str
}

// CurrentKey is the runner key registered most recently, nil when no runner has started.
fn CurrentKey(c postgres.Client) !?RunnerKey {
	let rows = try c.Query("SELECT key_id, public_key FROM runner_keys ORDER BY seen_at DESC, key_id LIMIT 1")
	if len(rows.Rows) == 0 {
		return nil
	}
	return RunnerKey{Id: rows.Rows[0][0].Text(), Public: rows.Rows[0][1].Text()}
}

// ---- capsules' readers ----

const magic2 = "TINCAP\x02\x00"

const readerBlock = 1200

// ReadersOf is a version 2 capsule's signer (hex ed25519 public key) and the key ids (hex) of the readers it is sealed
// for, read from its plain header (design/interface_replay.md §6.1) without any key.
fn ReadersOf(data str) !(str, []str) {
	if len(data) < 56 || data[0:8] != magic2 {
		fail "not a version 2 capsule"
	}
	let signer = seal.Hex([]u8(data[8:40]))
	let n = wordAt(data, 40)
	if n < 0 || n > len(data) - 56 {
		fail "a damaged capsule"
	}
	let at = 48 + n
	let count = wordAt(data, at)
	if count < 1 || count > 64 || at + 8 + count * readerBlock > len(data) {
		fail "a damaged capsule"
	}
	mut ids = []str{}
	for i in 0..count {
		let b = at + 8 + i * readerBlock
		ids = append(ids, seal.Hex([]u8(data[b:b + 32])))
	}
	return signer, ids
}

// wordAt is the little-endian word at data[at:at+8], -1 when it is not there or too large.
fn wordAt(data str, at i64) i64 {
	if at < 0 || at + 8 > len(data) || data[at + 7] != 0 || data[at + 6] != 0 || data[at + 5] != 0 || data[at + 4] != 0 {
		return -1
	}
	mut v = 0
	for k in 0..4 {
		v = v | (i64(data[at + k]) << (8 * k))
	}
	return v
}

// ---- opting in ----

// OptIn is an owner's opt-in.
type OptIn struct {
	KeyId   str
	Signers []str
}

// OptInOf is the owner's opt-in, nil when it has none.
fn OptInOf(c postgres.Client, ownerId i64) !?OptIn {
	let rows = try c.Query("SELECT key_id, signers FROM runner_optins WHERE owner_id = {ownerId}")
	if len(rows.Rows) == 0 {
		return nil
	}
	return OptIn{KeyId: rows.Rows[0][0].Text(), Signers: splitList(rows.Rows[0][1].Text())}
}

// SetOptIn opts the owner in for the runner key keyId, trusting signers (hex ed25519 public keys; none: the signer
// each capsule names, which only a writer of the repository could have uploaded), as user by; audited.
fn SetOptIn(c postgres.Client, ownerId i64, keyId str, signers []str, by i64) ! {
	for s in signers {
		if len(s) != 64 || !isHex(s) {
			fail "runner: a signer must be 64 hex digits, not {s}"
		}
	}
	let list = twine.Join(signers, ",")
	_ = try c.Exec("INSERT INTO runner_optins (owner_id, key_id, signers, enabled_by) VALUES ({ownerId}, {keyId}, {list}, nullif({by}, 0)) ON CONFLICT (owner_id) DO UPDATE SET key_id = excluded.key_id, signers = excluded.signers, enabled_by = excluded.enabled_by, created_at = now()")
	_ = try c.Exec("INSERT INTO audit_log (actor_id, action, target_kind, target_id, detail) VALUES (nullif({by}, 0), 'runner.optin', 'owner', {ownerId}, jsonb_build_object('key_id', {keyId}::text))")
}

// ClearOptIn opts the owner out; false when it was not in. Runs already queued are skipped.
fn ClearOptIn(c postgres.Client, ownerId i64, by i64) !bool {
	let r = try c.Exec("DELETE FROM runner_optins WHERE owner_id = {ownerId}")
	if r.Affected == 1 {
		_ = try c.Exec("INSERT INTO audit_log (actor_id, action, target_kind, target_id, detail) VALUES (nullif({by}, 0), 'runner.optout', 'owner', {ownerId}, '{{}}'::jsonb)")
	}
	return r.Affected == 1
}

fn splitList(text str) []str {
	mut out = []str{}
	for part in twine.Split(text, ",") {
		let p = twine.TrimSpace(part)
		if len(p) > 0 {
			out = append(out, p)
		}
	}
	return out
}

fn isHex(s str) bool {
	for c in s {
		if !((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')) {
			return false
		}
	}
	return true
}

// ---- a repository's settings ----

// Settings is what a repository's runs build and replay: the program's entry file (relative to the tree), how many of
// the newest capsules to replay, and the environment the replayed program runs with (NAME=value, no secrets: anyone
// with the replay permission reads them), as the recording server had it.
type Settings struct {
	Entry  str
	Sample i64
	Env    []str
}

// DefaultSample is how many capsules a run replays when the repository sets nothing.
const DefaultSample = 20

// SettingsOf is the repository's settings, the defaults when it has none.
fn SettingsOf(c postgres.Client, repoId i64) !Settings {
	let rows = try c.Query("SELECT entry, sample, env FROM runner_settings WHERE repo_id = {repoId}")
	if len(rows.Rows) == 0 {
		return Settings{Entry: "main.tin", Sample: DefaultSample, Env: []str{}}
	}
	let r = rows.Rows[0]
	mut env = []str{}
	for line in twine.Split(r[2].Text(), "\n") {
		if len(line) > 0 {
			env = append(env, line)
		}
	}
	return Settings{Entry: r[0].Text(), Sample: r[1].Int(), Env: env}
}

// CheckSettings is the fault of settings a run cannot use.
fn CheckSettings(s Settings) ! {
	if !safeEntry(s.Entry) {
		fail "runner: the entry must be a relative path to a .tin file, not {s.Entry}"
	}
	if s.Sample < 1 || s.Sample > 200 {
		fail "runner: sample must be 1 to 200, not {s.Sample}"
	}
	if len(s.Env) > 64 {
		fail "runner: at most 64 environment variables"
	}
	for e in s.Env {
		let (name, value, ok) = twine.Cut(e, "=")
		if !ok || !envName(name) || len(value) > 1024 || twine.Contains(value, "\n") {
			fail "runner: {name} is not NAME=value for the replayed program"
		}
	}
}

// envName reports whether name may be set for the replayed program: an upper-case name, not one the sandbox sets
// (PATH, HOME, TMPDIR) and not TIN_*, which steer the replay itself.
fn envName(name str) bool {
	if len(name) == 0 || len(name) > 64 || twine.HasPrefix(name, "TIN_") || name == "PATH" || name == "HOME" || name == "TMPDIR" {
		return false
	}
	for i, c in name {
		let ok = (c >= 'A' && c <= 'Z') || c == '_' || (i > 0 && c >= '0' && c <= '9')
		if !ok {
			return false
		}
	}
	return true
}

// SetSettings stores a repository's settings.
fn SetSettings(c postgres.Client, repoId i64, s Settings) ! {
	try CheckSettings(s)
	let env = twine.Join(s.Env, "\n")
	_ = try c.Exec("INSERT INTO runner_settings (repo_id, entry, sample, env) VALUES ({repoId}, {s.Entry}, {s.Sample}::int, {env}) ON CONFLICT (repo_id) DO UPDATE SET entry = excluded.entry, sample = excluded.sample, env = excluded.env, updated_at = now()")
}

// ---- requesting a run ----

type runPayload struct {
	run i64
}

fn payloadOf(run i64) str {
	mut b = []u8{}
	argo.Put(mut b, runPayload{run: run})
	return str(b)
}

// Request queues a run of a change version in tx (reviews call it when a version is pushed, #1025; the API on
// request): its id, or 0 when the repository's owner has not opted in (nothing is queued). A run of the version that
// is queued or running already is that run; one that ended runs again, with the capsules there are now.
fn Request(tx mut postgres.Tx, repoId i64, changeId str, version i64, by i64) !i64 {
	let opted = try tx.Query("SELECT 1 FROM repos r JOIN runner_optins o ON o.owner_id = r.owner_id WHERE r.id = {repoId}")
	if len(opted.Rows) == 0 {
		return 0
	}
	let v = try tx.Query("SELECT commit_id FROM changes WHERE repo_id = {repoId} AND change_id = {changeId} AND version = {version}::int")
	if len(v.Rows) == 0 {
		fail fault.Wrap(ErrNoVersion, "{changeId} version {version}")
	}
	let commit = v.Rows[0][0].Text()
	let made = try tx.Query("INSERT INTO runner_runs (repo_id, change_id, version, commit_id, requested_by) VALUES ({repoId}, {changeId}, {version}::int, {commit}, nullif({by}, 0)) ON CONFLICT (repo_id, change_id, version) DO NOTHING RETURNING id")
	if len(made.Rows) == 1 {
		let id = made.Rows[0][0].Int()
		_ = try events.Enqueue(mut tx, KindRun, repoId, payloadOf(id))
		return id
	}
	let rows = try tx.Query("SELECT id, state FROM runner_runs WHERE repo_id = {repoId} AND change_id = {changeId} AND version = {version}::int FOR UPDATE")
	let id = rows.Rows[0][0].Int()
	let state = rows.Rows[0][1].Text()
	if state == "queued" || state == "running" {
		return id
	}
	_ = try tx.Exec("UPDATE runner_runs SET state = 'queued', reason = '', requested_by = nullif({by}, 0), created_at = now(), started_at = NULL, finished_at = NULL WHERE id = {id}")
	_ = try events.Enqueue(mut tx, KindRun, repoId, payloadOf(id))
	return id
}

// RequestNow is Request in a transaction of its own.
fn RequestNow(c postgres.Client, repoId i64, changeId str, version i64, by i64) !i64 {
	mut tx = try c.Begin()
	let (id, err) = Request(mut tx, repoId, changeId, version, by)
	if err != nil {
		tx.Rollback() catch _ {
		}
		fail err
	}
	try tx.Commit()
	return id
}

// ---- the job ----

// Handlers is the runner's job kind for the runner role's own claim loop (never the worker's: a run takes minutes of
// CPU in sandboxes): replay.run, in 60m and 512mb. It configures the core with d.
fn Handlers(d Deps) []events.Handler {
	Configure(d)
	return []events.Handler{events.Handler{Kind: KindRun, Within: 60 * tide.Minute, Memory: 512 * 1024 * 1024, Tasks: 16, MaxAttempts: 3, Run: runJob}}
}

fn runJob(j events.Job) ! {
	mut p = runPayload{run: 0}
	argo.Get(j.Payload, mut p) catch err {
		fail "replay.run: a payload without a run: {fault.Message(err)}"
	}
	try Run(p.run, j.Id)
}

// finish is how a run ended: its state and reason, the capsules replayed and the base it compared with.
type finish struct {
	state    str
	reason   str
	capsules i64
	base     str
	results  []result
}

type result struct {
	capsule  str
	verdict  Verdict
	recorded i64
	base     i64
	change   i64
}

fn ended(state str, reason str) finish {
	return finish{state: state, reason: reason, capsules: 0, base: "", results: []result{}}
}

// Run runs the run with this id, as its job (jobId, whose lease it renews; 0 for none) does: a run already done or
// skipped is left alone (its job came twice). A fault (Postgres, a sandbox that cannot be built) marks it failed and is
// the job's, which the queue tries again.
fn Run(runId i64, jobId i64) ! {
	let d = try depsOf()
	let rows = try d.Db.Query("SELECT r.repo_id, r.change_id, r.version, r.commit_id, r.state, p.owner_id FROM runner_runs r JOIN repos p ON p.id = r.repo_id WHERE r.id = {runId}")
	if len(rows.Rows) == 0 {
		return
	}
	let row = rows.Rows[0]
	let state = row[4].Text()
	if state == "done" || state == "skipped" {
		return
	}
	let repoId = row[0].Int()
	let commit = row[3].Text()
	let ownerId = row[5].Int()
	_ = try d.Db.Exec("UPDATE runner_runs SET state = 'running', reason = '', started_at = now() WHERE id = {runId}")
	let (f, err) = attempt(d, runId, jobId, repoId, ownerId, commit)
	if err != nil {
		let why = clip(fault.Message(err), 2000)
		_ = d.Db.Exec("UPDATE runner_runs SET state = 'failed', reason = {why}, finished_at = now() WHERE id = {runId}") catch _ {
			postgres.Result{Affected: 0}
		}
		fail err
	}
	try store(d, runId, f)
	herald.Log(herald.LInfo, "replay run", []str{"run", mint.Itoa(runId), "state", f.state, "capsules", mint.Itoa(f.capsules)})
}

// store writes a run's results and its end in one transaction; a run done again replaces its results.
fn store(d Deps, runId i64, f finish) ! {
	mut tx = try d.Db.Begin()
	let err = storeIn(mut tx, runId, f)
	if err != nil {
		tx.Rollback() catch _ {
		}
		fail err
	}
	try tx.Commit()
}

fn storeIn(tx mut postgres.Tx, runId i64, f finish) ! {
	_ = try tx.Exec("DELETE FROM runner_results WHERE run_id = {runId}")
	for r in f.results {
		let v = r.verdict
		_ = try tx.Exec("INSERT INTO runner_results (run_id, capsule_id, outcome, group_key, label, effect, recorded_status, base_status, change_status) VALUES ({runId}, {r.capsule}, {v.Outcome}, {v.Key}, {v.Label}, {v.Effect}::int, {r.recorded}::int, {r.base}::int, {r.change}::int) ON CONFLICT (run_id, capsule_id) DO NOTHING")
	}
	_ = try tx.Exec("UPDATE runner_runs SET state = {f.state}, reason = {f.reason}, capsules = {f.capsules}::int, base_commit = {f.base}, finished_at = now() WHERE id = {runId}")
}

fn clip(s str, n i64) str {
	if len(s) <= n {
		return s
	}
	return s[0:n]
}

// extend renews the job's lease after a long step.
fn extend(d Deps, jobId i64) {
	if jobId <= 0 {
		return
	}
	let ms = d.Lease / tide.Millisecond
	_ = d.Db.Exec("UPDATE events SET lease_until = now() + make_interval(secs => {ms}::float8 / 1000) WHERE id = {jobId} AND state = 'claimed'") catch _ {
		postgres.Result{Affected: 0}
	}
}

// picked is a capsule a run replays: its id, bytes and the signer it trusts for it.
type picked struct {
	id      str
	data    str
	signers str
}

// attempt is one run: the checks, the sample, then the builds and replays in a working directory removed afterwards.
fn attempt(d Deps, runId i64, jobId i64, repoId i64, ownerId i64, commit str) !finish {
	if len(reveal(d.Key)) == 0 {
		return ended("skipped", "this runner has no key (runner.key)")
	}
	let keyId = try Register(d.Db, d.Key)
	let opt = try OptInOf(d.Db, ownerId)
	if opt == nil {
		return ended("skipped", "the repository's owner has not opted in to the runner")
	}
	if opt.KeyId != keyId {
		return ended("skipped", "the owner opted in for another runner key ({opt.KeyId[0:12]}); opt in again for {keyId[0:12]}")
	}
	let settings = try SettingsOf(d.Db, repoId)
	let bad = CheckSettings(settings)
	if bad != nil {
		return ended("failed", fault.Message(bad))
	}
	if !quarry.Exists(d.Tin + "/bin/tinc") || !quarry.Exists(d.Tin + "/tin") {
		fail "runner: runner.tin {d.Tin} has no bin/tinc and tin"
	}
	let work = d.Dir + "/runner/{runId}-" + seal.Hex(seal.RandomBytes(6))
	try quarry.MkdirAll(work)
	try quarry.Chmod(work, 448)
	let (f, err) = inWork(d, work, jobId, repoId, keyId, opt.Signers, settings, commit)
	quarry.RemoveAll(work) catch _ {
	}
	if err != nil {
		fail err
	}
	return f
}

// repoOf is the repository's objects' reader, built from this core's global (one built from a parameter's fields trips a
// false E701, #1073).
fn repoOf(repoId i64) !repo.PgRepo {
	let d = try depsOf()
	let st = try storeOf()
	return repo.PgRepo{Db: d.Db, Store: st, Cache: repo.NoCache(), Id: repoId, Dir: d.Dir, Who: 0}
}

fn inWork(d Deps, work str, jobId i64, repoId i64, keyId str, signers []str, settings Settings, commit str) !finish {
	let sample = try pick(d, work, repoId, keyId, signers, settings.Sample)
	if len(sample) == 0 {
		return ended("skipped", "no capsule of the repository is sealed for the runner: add its public key to the recording server's TIN_REPLAY_RECIPIENTS")
	}
	mut r = try repoOf(repoId)
	mut objs = try r.Objects()
	let cid = try object.ParseId(commit)
	let (tree, parent) = try CommitOf(mut objs, cid)
	_ = try WriteTree(mut objs, tree, work + "/change")
	let hasParent = parent != object.NoId
	if hasParent {
		let (baseTree, _) = try CommitOf(mut objs, parent)
		_ = try WriteTree(mut objs, baseTree, work + "/base")
	}
	let scratch = work + "/scratch"
	try quarry.MkdirAll(scratch + "/tmp")
	let built = try Build(d, work + "/change", scratch, settings.Entry, "change.bin")
	extend(d, jobId)
	if len(built) > 0 {
		return ended("failed", "the change does not build:\n" + clip(built, 2000))
	}
	mut hasBase = false
	mut reason = ""
	mut base = ""
	if hasParent {
		base = parent.Hex()
		let baseBuilt = try Build(d, work + "/base", scratch, settings.Entry, "base.bin")
		extend(d, jobId)
		hasBase = len(baseBuilt) == 0
		if !hasBase {
			reason = "the base does not build: each replay is compared with its recording"
		}
	} else {
		reason = "the change has no parent: each replay is compared with its recording"
	}
	// the key goes into the sandbox's scratch directory only, for the replays, and is removed after them whatever
	// happened
	let keyPath = scratch + "/runner.key"
	try quarry.WriteFile(keyPath, twine.TrimSpace(reveal(d.Key)) + "\n")
	try quarry.Chmod(keyPath, 384)
	let (results, err) = replayAll(d, scratch, jobId, sample, settings.Env, hasBase)
	quarry.Remove(keyPath) catch _ {
	}
	if err != nil {
		fail err
	}
	return finish{state: "done", reason: reason, capsules: len(results), base: base, results: results}
}

fn replayAll(d Deps, scratch str, jobId i64, sample []picked, env []str, hasBase bool) ![]result {
	mut out = []result{}
	for p in sample {
		let path = scratch + "/capsule.tcap"
		try quarry.WriteFile(path, p.data)
		let change = try ReplayOne(d, scratch, "change.bin", p.signers, env)
		extend(d, jobId)
		mut base = NoReport("no base")
		if hasBase {
			base = try ReplayOne(d, scratch, "base.bin", p.signers, env)
			extend(d, jobId)
		}
		quarry.Remove(path) catch _ {
		}
		let v = Compare(change, base, hasBase)
		out = append(out, result{capsule: p.id, verdict: v, recorded: change.Recorded, base: base.Status, change: change.Status})
	}
	return out
}

// pick is the newest capsules of the repository sealed for the runner's key, at most n: each with its bytes and the
// signers its replay trusts (the opt-in's, else the one it names).
fn pick(d Deps, work str, repoId i64, keyId str, signers []str, n i64) ![]picked {
	let most = n * 4
	let rows = try d.Db.Query("SELECT id FROM capsules WHERE repo_id = {repoId} AND expires_at > now() ORDER BY created_at DESC, id LIMIT {most}")
	mut out = []picked{}
	for row in rows.Rows {
		if len(out) >= n {
			break
		}
		let id = row[0].Text()
		let data = try bytesOf(d, work, repoId, id)
		let (signer, readers) = ReadersOf(data) catch _ {
			continue
		}
		mut sealed = false
		for r in readers {
			if r == keyId {
				sealed = true
			}
		}
		if !sealed {
			continue
		}
		mut trust = twine.Join(signers, ",")
		if len(trust) == 0 {
			trust = signer
		}
		out = append(out, picked{id: id, data: data, signers: trust})
	}
	return out
}

// bytesOf is a stored capsule's bytes.
fn bytesOf(d Deps, work str, repoId i64, id str) !str {
	mut st = try storeOf()
	let key = packs.CapsuleKey(repoId, id)
	let local = st.Local(key)
	if local != nil {
		return try quarry.ReadFileBound(local, 64 * 1024 * 1024 + 1)
	}
	let tmp = work + "/capsule-get"
	_ = try st.Get(key, tmp)
	let (data, err) = quarry.ReadFileBound(tmp, 64 * 1024 * 1024 + 1)
	quarry.Remove(tmp) catch _ {
	}
	if err != nil {
		fail err
	}
	return data
}

// ---- the sandboxes ----

// buildMemory, replayMemory, sandboxPids and sandboxWeight are the limits of the runner's sandboxes with runner.cgroup:
// cpu.weight 50 against the default 100 of the node's and the worker's processes, so a run yields to them.
const buildMemory = 2 * 1024 * 1024 * 1024

const replayMemory = 512 * 1024 * 1024

const sandboxPids = 256

const sandboxWeight = 50

// SandboxFor is the sandbox of a build (src mounted at /src) or a replay (src ""): the toolchain d.Tin at /tin and the
// sources read-only, scratch read-write at /scratch, no network (a replay alone gets a namespace of its own with its
// loopback up), and with d.Cgroup the memory, process and CPU limits and a lower CPU weight.
fn SandboxFor(d Deps, src str, scratch str, argv []str, env []str) sandbox.Spec {
	mut inputs = []sandbox.Bind{sandbox.Bind{From: d.Tin, To: "/tin"}}
	mut timeout = d.ReplayTimeout
	mut memory = replayMemory
	let replaying = len(src) == 0
	if !replaying {
		inputs = append(inputs, sandbox.Bind{From: src, To: "/src"})
		timeout = d.BuildTimeout
		memory = buildMemory
	}
	mut s = sandbox.Spec{Argv: argv, Env: env, Dir: "/scratch", Inputs: inputs, System: []str{}, NoSystem: false, Scratch: scratch, ScratchPath: "/scratch", Memory: 0, CPU: 0.0, Pids: 0, Weight: 0, Timeout: timeout, MaxOutput: 1024 * 1024, Cgroup: "", Network: false, Loopback: replaying}
	if len(d.Cgroup) > 0 {
		s.Cgroup = d.Cgroup
		s.Memory = memory
		s.CPU = 1.0
		s.Pids = sandboxPids
		s.Weight = sandboxWeight
	}
	return s
}

fn baseEnv() []str {
	return []str{"PATH=/usr/bin:/bin", "HOME=/scratch", "TMPDIR=/scratch/tmp"}
}

// Build compiles the tree at src (its entry file) into scratch/out with tinc in a sandbox: "" when it built, else what
// the compiler said.
fn Build(d Deps, src str, scratch str, entry str, out str) !str {
	mut env = baseEnv()
	env = append(env, "TIN_ROOT=/tin")
	let argv = []str{"/tin/bin/tinc", "-o", "/scratch/" + out, "/src/" + entry}
	let r = try sandbox.Run(SandboxFor(d, src, scratch, argv, env))
	if r.TimedOut {
		return "the build timed out"
	}
	if r.Code != 0 {
		let said = twine.TrimSpace(r.Stderr + r.Stdout)
		if len(said) == 0 {
			return "tinc exited with status {r.Code}"
		}
		return said
	}
	return ""
}

// ReplayOne replays scratch/capsule.tcap against scratch/bin with tin replay --against in a sandbox, trusting signers,
// the program's environment env added.
fn ReplayOne(d Deps, scratch str, bin str, signers str, env []str) !Report {
	mut e = baseEnv()
	e = append(e, "TIN_REPLAY_IDENTITY=/scratch/runner.key")
	e = append(e, "TIN_REPLAY_SIGNERS=" + signers)
	for x in env {
		e = append(e, x)
	}
	let argv = []str{"/bin/sh", "/tin/tin", "replay", "/scratch/capsule.tcap", "--against", "/scratch/" + bin}
	let r = try sandbox.Run(SandboxFor(d, "", scratch, argv, e))
	if r.TimedOut || r.OOM {
		mut rep = ParseReport(r.Stdout, r.Stderr)
		rep.Ran = true
		rep.Why = ""
		rep.TimedOut = true
		rep.Status = 0
		return rep
	}
	if r.Code == 4 {
		return NoReport(unreadable(r.Stderr))
	}
	return ParseReport(r.Stdout, r.Stderr)
}

// ---- reading runs ----

// RunInfo is a run as the panel shows it.
type RunInfo struct {
	Id       i64
	Change   str
	Version  i64
	Commit   str
	Base     str
	State    str
	Reason   str
	Capsules i64
	Created  i64
	Finished i64
}

// RunOf is the run of a change version (version 0: the change's newest run), nil when there is none.
fn RunOf(c postgres.Client, repoId i64, changeId str, version i64) !?RunInfo {
	let rows = try c.Query("SELECT id, change_id, version, commit_id, base_commit, state, reason, capsules, (extract(epoch FROM created_at))::bigint, coalesce((extract(epoch FROM finished_at))::bigint, 0) FROM runner_runs WHERE repo_id = {repoId} AND change_id = {changeId} AND ({version} = 0 OR version = {version}::int) ORDER BY version DESC LIMIT 1")
	if len(rows.Rows) == 0 {
		return nil
	}
	let r = rows.Rows[0]
	return RunInfo{Id: r[0].Int(), Change: r[1].Text(), Version: r[2].Int(), Commit: r[3].Text(), Base: r[4].Text(), State: r[5].Text(), Reason: r[6].Text(), Capsules: r[7].Int(), Created: r[8].Int(), Finished: r[9].Int()}
}

// Group is the capsules of a run whose replays differ first in the same way.
type Group struct {
	Outcome  str
	Key      str
	Label    str
	Effect   i64
	Count    i64
	Capsules []str
}

// Groups is a run's groups, what changed most first (different calls, new failures, different responses, the same,
// the skipped), the larger first within each.
fn Groups(c postgres.Client, runId i64) ![]Group {
	// a group lists its first 20 capsules
	let rows = try c.Query("SELECT outcome, group_key, min(label), min(effect), count(*), array_to_string((array_agg(capsule_id ORDER BY capsule_id))[1:20], ',') FROM runner_results WHERE run_id = {runId} GROUP BY outcome, group_key ORDER BY count(*) DESC, group_key")
	mut out = []Group{}
	for rank in 0..5 {
		for r in rows.Rows {
			if outcomeRank(r[0].Text()) != rank {
				continue
			}
			out = append(out, Group{Outcome: r[0].Text(), Key: r[1].Text(), Label: r[2].Text(), Effect: r[3].Int(), Count: r[4].Int(), Capsules: splitList(r[5].Text())})
		}
	}
	return out
}
