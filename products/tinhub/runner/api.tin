package runner

import "../accounts"
import "../capsules"
import "anvil"
import "argo"
import "fault"
import "mint"
import "tide"

// The behaviour panel's API (design/tinhub.md §12, #1028), JSON under /api/v1:
//
//   GET  repos/<owner>/<repo>/changes/<change>/behaviour   the change's newest run (?version=N for a version's): its
//                                                           state and its groups, what changed most first
//   POST repos/<owner>/<repo>/changes/<change>/behaviour   request a run of a version ({"version": N}; none: the newest)
//   GET  repos/<owner>/<repo>/runner, PUT (admin)          what the repository's runs build and replay
//   GET  orgs/<org>/runner, PUT, DELETE (org owners)        the org's opt-in, and the runner key to seal capsules for
//   GET  repos/<owner>/<repo>/replay/checks                 replay checks, newest first (?group=ID, ?limit=N)
//   POST repos/<owner>/<repo>/replay/checks                 check a revision against a failure group or one capsule
//                                                           ({"target", "group", "capsule"}; checks_api.tin)
//   GET  repos/<owner>/<repo>/replay/checks/<id>            a check and each capsule's verdict with its explanation
//
// The repository's routes take read access and the replay permission (capsules.CanRead), as capsules do: a repository
// the caller cannot read is 404, one whose capsules they cannot read 403. Errors are {"code", "message"}.

// Mount adds the runner's routes to r.
fn Mount(r mut anvil.Router) {
	r.Get(`/api/v1/repos/{owner}/{repo}/changes/{change}/behaviour`, getBehaviour)
	r.Post(`/api/v1/repos/{owner}/{repo}/changes/{change}/behaviour`, postBehaviour)
	r.Get(`/api/v1/repos/{owner}/{repo}/runner`, getSettings)
	r.Put(`/api/v1/repos/{owner}/{repo}/runner`, putSettings)
	r.Get(`/api/v1/orgs/{org}/runner`, getOptIn)
	r.Put(`/api/v1/orgs/{org}/runner`, putOptIn)
	r.Delete(`/api/v1/orgs/{org}/runner`, deleteOptIn)
	r.Get(`/api/v1/repos/{owner}/{repo}/replay/checks`, getChecks)
	r.Post(`/api/v1/repos/{owner}/{repo}/replay/checks`, postCheck)
	r.Get(`/api/v1/repos/{owner}/{repo}/replay/checks/{id}`, getCheck)
}

// readWithin and writeWithin are a request's budget (design/tinhub.md §8).
const readWithin = 2 * tide.Second

const writeWithin = 5 * tide.Second

type apiError struct {
	code    str
	message str
}

fn fail_(w mut anvil.Out, status i64, code str, message str) {
	w.Status(status)
	w.Json()
	w.Body = []u8{}
	argo.Put(mut w.Body, apiError{code: code, message: message})
}

fn send[T](w mut anvil.Out, v T) {
	w.Json()
	w.Body = []u8{}
	argo.Put(mut w.Body, v)
}

// call is a repository request's context.
type call struct {
	d    Deps
	user i64
	role i64
	r    accounts.Repo
}

// begin authenticates a request, finds its repository (404 when the caller cannot read it) and checks the replay
// permission, and admin when admin is set; nil when the answer is written already.
fn begin(q anvil.Req, w mut anvil.Out, admin bool) ?call {
	let got = deps
	if got == nil {
		fail_(mut w, 503, "unavailable", "the runner API is not configured on this core")
		return nil
	}
	let d = got
	let auth = d.Auth
	let user = auth(q) catch err {
		fail_(mut w, 401, "unauthorized", fault.Message(err))
		return nil
	}
	let owner = q.PathParam("owner")
	let name = q.PathParam("repo")
	let found = accounts.FindRepo(d.Db, owner, name) catch err {
		fail_(mut w, 503, "unavailable", fault.Message(err))
		return nil
	}
	if found == nil {
		fail_(mut w, 404, "not_found", "no repository {owner}/{name}")
		return nil
	}
	let role = accounts.RoleOf(d.Db, user, found) catch err {
		fail_(mut w, 503, "unavailable", fault.Message(err))
		return nil
	}
	if role == accounts.RoleNone {
		fail_(mut w, 404, "not_found", "no repository {owner}/{name}")
		return nil
	}
	let ok = capsules.CanRead(d.Db, found.Id, user, role) catch err {
		fail_(mut w, 503, "unavailable", fault.Message(err))
		return nil
	}
	if !ok {
		fail_(mut w, 403, "forbidden", "replays of {owner}/{name} take the replay permission")
		return nil
	}
	if admin && role < accounts.RoleAdmin {
		fail_(mut w, 403, "forbidden", "only an admin of {owner}/{name} can change this")
		return nil
	}
	return call{d: d, user: user, role: role, r: found}
}

// ---- the behaviour panel ----

type runOut struct {
	change      str
	version     i64
	commit      str
	base        str
	state       str
	reason      str
	capsules    i64
	created_at  i64
	finished_at i64
}

type groupOut struct {
	outcome  str
	key      str
	label    str
	effect   i64
	count    i64
	capsules []str
}

type behaviourOut struct {
	run    runOut
	groups []groupOut
}

// getBehaviour is a change's run (?version=N, else its newest) and its groups.
fn getBehaviour(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, false)
	if c == nil {
		return
	}
	let version = mint.Atoi(q.Param("version")) catch _ {
		0
	}
	let change = q.PathParam("change")
	let (out, err) = readBehaviour(c, change, version)
	if err != nil {
		answerErr(mut w, err)
		return
	}
	send(mut w, out)
}

// ErrNotFound is the fault of a run the change does not have.
let ErrNotFound = fault("not found")

fn answerErr(w mut anvil.Out, err fault) {
	if fault.Is(err, ErrNotFound) || fault.Is(err, ErrNoVersion) {
		fail_(mut w, 404, "not_found", fault.Message(err))
		return
	}
	fail_(mut w, 503, "unavailable", fault.Message(err))
}

fn readBehaviour(c call, change str, version i64) !behaviourOut {
	mut out ?behaviourOut = nil
	try within readWithin {
		let run = try RunOf(c.d.Db, c.r.Id, change, version)
		if run == nil {
			fail fault.Wrap(ErrNotFound, "no run of change {change}")
		}
		let gs = try Groups(c.d.Db, run.Id)
		mut groups = []groupOut{}
		for g in gs {
			groups = append(groups, groupOut{outcome: g.Outcome, key: g.Key, label: g.Label, effect: g.Effect, count: g.Count, capsules: g.Capsules})
		}
		let r = runOut{change: run.Change, version: run.Version, commit: run.Commit, base: run.Base, state: run.State, reason: run.Reason, capsules: run.Capsules, created_at: run.Created, finished_at: run.Finished}
		out = keep(behaviourOut{run: r, groups: groups})
	}
	if out == nil {
		fail fault.Wrap(ErrNotFound, "no run of change {change}")
	}
	return out
}

type requestIn struct {
	version i64
}

type requestOut struct {
	run     i64
	change  str
	version i64
	state   str
}

// postBehaviour requests a run of a change version ({"version": N}, else the change's newest): 202 and the run, or 409
// when the repository's owner has not opted in.
fn postBehaviour(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, false)
	if c == nil {
		return
	}
	mut v = requestIn{version: 0}
	if len(q.Body()) > 0 {
		argo.Get(q.Body(), mut v) catch err {
			fail_(mut w, 400, "bad_request", fault.Message(err))
			return
		}
	}
	let change = q.PathParam("change")
	let (out, err) = requestRun(c, change, v.version)
	if err != nil {
		answerErr(mut w, err)
		return
	}
	if out.run == 0 {
		fail_(mut w, 409, "not_opted_in", "the owner of {c.r.Owner}/{c.r.Name} has not opted in to the runner")
		return
	}
	w.Status(202)
	send(mut w, out)
}

fn requestRun(c call, change str, version i64) !requestOut {
	mut out = requestOut{run: 0, change: change, version: version, state: ""}
	try within writeWithin {
		mut n = version
		if n <= 0 {
			let rows = try c.d.Db.Query("SELECT coalesce(max(version), 0) FROM changes WHERE repo_id = {c.r.Id} AND change_id = {change}")
			n = rows.Rows[0][0].Int()
			if n == 0 {
				fail fault.Wrap(ErrNoVersion, "no change {change}")
			}
		}
		let id = try RequestNow(c.d.Db, c.r.Id, change, n, c.user)
		mut state = ""
		if id > 0 {
			let rows = try c.d.Db.Query("SELECT state FROM runner_runs WHERE id = {id}")
			state = rows.Rows[0][0].Text()
		}
		out = keep(requestOut{run: id, change: change, version: n, state: state})
	}
	return out
}

// ---- a repository's settings ----

type settingsOut struct {
	entry  str
	sample i64
	env    []str
}

fn getSettings(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, false)
	if c == nil {
		return
	}
	let s = SettingsOf(c.d.Db, c.r.Id) catch err {
		answerErr(mut w, err)
		return
	}
	send(mut w, settingsOut{entry: s.Entry, sample: s.Sample, env: s.Env})
}

// putSettings sets what the repository's runs build and replay ({"entry", "sample", "env": ["NAME=value"]}), admin.
fn putSettings(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, true)
	if c == nil {
		return
	}
	mut v = settingsOut{entry: "main.tin", sample: DefaultSample, env: []str{}}
	argo.Get(q.Body(), mut v) catch err {
		fail_(mut w, 400, "bad_request", fault.Message(err))
		return
	}
	let s = Settings{Entry: v.entry, Sample: v.sample, Env: v.env}
	let bad = CheckSettings(s)
	if bad != nil {
		fail_(mut w, 400, "bad_request", fault.Message(bad))
		return
	}
	SetSettings(c.d.Db, c.r.Id, s) catch err {
		answerErr(mut w, err)
		return
	}
	send(mut w, v)
}

// ---- an org's opt-in ----

type optInOut struct {
	org        str
	opted_in   bool
	key_id     str
	public_key str
	current    bool
	signers    []str
}

type optInIn struct {
	signers []str
}

// orgCall is an org request's context: the caller must own the org (or be a site admin).
type orgCall struct {
	d     Deps
	user  i64
	owner i64
	name  str
}

fn beginOrg(q anvil.Req, w mut anvil.Out) ?orgCall {
	let got = deps
	if got == nil {
		fail_(mut w, 503, "unavailable", "the runner API is not configured on this core")
		return nil
	}
	let d = got
	let auth = d.Auth
	let user = auth(q) catch err {
		fail_(mut w, 401, "unauthorized", fault.Message(err))
		return nil
	}
	let name = q.PathParam("org")
	let org = accounts.OrgByName(d.Db, name) catch err {
		fail_(mut w, 503, "unavailable", fault.Message(err))
		return nil
	}
	if org == nil || user <= 0 {
		fail_(mut w, 404, "not_found", "no org {name}")
		return nil
	}
	let member = accounts.MemberRole(d.Db, org.Id, user) catch err {
		fail_(mut w, 503, "unavailable", fault.Message(err))
		return nil
	}
	mut admin = false
	if member != "owner" {
		let u = accounts.UserById(d.Db, user) catch err {
			fail_(mut w, 503, "unavailable", fault.Message(err))
			return nil
		}
		admin = u != nil && u.SiteAdmin
	}
	if member == "" && !admin {
		fail_(mut w, 404, "not_found", "no org {name}")
		return nil
	}
	if member != "owner" && !admin {
		fail_(mut w, 403, "forbidden", "only an owner of {name} opts it in to the runner")
		return nil
	}
	return orgCall{d: d, user: user, owner: org.OwnerId, name: org.Name}
}

fn optInState(c orgCall) !optInOut {
	let key = try CurrentKey(c.d.Db)
	mut out = optInOut{org: c.name, opted_in: false, key_id: "", public_key: "", current: false, signers: []str{}}
	if key != nil {
		out.key_id = key.Id
		out.public_key = key.Public
	}
	let opt = try OptInOf(c.d.Db, c.owner)
	if opt != nil {
		out.opted_in = true
		out.signers = opt.Signers
		out.current = key != nil && opt.KeyId == key.Id
		if !out.current {
			out.key_id = opt.KeyId
		}
	}
	return out
}

// getOptIn is the org's opt-in and the runner's public key, for the recording servers' TIN_REPLAY_RECIPIENTS.
fn getOptIn(q anvil.Req, w mut anvil.Out) {
	let c = beginOrg(q, mut w)
	if c == nil {
		return
	}
	let out = optInState(c) catch err {
		answerErr(mut w, err)
		return
	}
	send(mut w, out)
}

// putOptIn opts the org in for the newest runner key ({"signers": [hex ed25519 keys]}, optional).
fn putOptIn(q anvil.Req, w mut anvil.Out) {
	let c = beginOrg(q, mut w)
	if c == nil {
		return
	}
	mut v = optInIn{signers: []str{}}
	if len(q.Body()) > 0 {
		argo.Get(q.Body(), mut v) catch err {
			fail_(mut w, 400, "bad_request", fault.Message(err))
			return
		}
	}
	let key = CurrentKey(c.d.Db) catch err {
		answerErr(mut w, err)
		return
	}
	if key == nil {
		fail_(mut w, 409, "no_runner", "no runner has registered a key yet: start one with runner.key set")
		return
	}
	SetOptIn(c.d.Db, c.owner, key.Id, v.signers, c.user) catch err {
		fail_(mut w, 400, "bad_request", fault.Message(err))
		return
	}
	let out = optInState(c) catch err {
		answerErr(mut w, err)
		return
	}
	send(mut w, out)
}

// deleteOptIn opts the org out.
fn deleteOptIn(q anvil.Req, w mut anvil.Out) {
	let c = beginOrg(q, mut w)
	if c == nil {
		return
	}
	_ = ClearOptIn(c.d.Db, c.owner, c.user) catch err {
		answerErr(mut w, err)
		return
	}
	w.Status(204)
}
