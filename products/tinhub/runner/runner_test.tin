package runner

import "../db"
import "../packs"
import "anvil"
import "crucible"
import "fault"
import "mint"
import "postgres"
import "replay"
import "seal"
import "twine"

// Tests for the runner (#1028): reading tin replay's report, comparing a change's replay with its base's and grouping
// by the first effect that differs, a capsule's readers, the runner's key, the settings' checks, and against Postgres
// (TINHUB_TEST_DB) requesting runs, the opt-in and the behaviour panel's permissions. tests/runner.sh runs the sandboxed
// builds and replays end to end.

fn TestParseReport(t mut crucible.T) {
	let r = ParseReport("replay: status 500 (recorded 500)\nreplay: divergence at effect 2: got postgres@1 \"Q INSERT INTO orders\\nS7\\n\", recorded wire.http@1 \"POST http://pay/charge\"\nreplay: 1 recorded effects not served\ncharge failed\n", "")
	t.True("ran", r.Ran)
	crucible.Equal(mut t, "status", r.Status, 500)
	crucible.Equal(mut t, "recorded", r.Recorded, 500)
	crucible.Equal(mut t, "effect", r.Effect, 2)
	crucible.Equal(mut t, "got", r.Got, "postgres@1")
	crucible.Equal(mut t, "want", r.Want, "wire.http@1")
	crucible.Equal(mut t, "left", r.Left, 1)
	crucible.Equal(mut t, "body", r.Body, "charge failed\n")
	let clean = ParseReport("replay: status 200 (recorded 200)\npaid 3 for apples\n", "")
	crucible.Equal(mut t, "clean effect", clean.Effect, -1)
	crucible.Equal(mut t, "clean left", clean.Left, 0)
	crucible.Equal(mut t, "clean body", clean.Body, "paid 3 for apples\n")
	let more = ParseReport("replay: status 200 (recorded 200)\nreplay: divergence at effect 4: got redis@1 \"3:GET\", recorded nothing more\n", "")
	crucible.Equal(mut t, "nothing more", more.Want, "")
	crucible.Equal(mut t, "nothing more got", more.Got, "redis@1")
	let none = ParseReport("replay: no response (recorded 200)\n", "")
	crucible.Equal(mut t, "no response", none.Status, 0)
	crucible.Equal(mut t, "no response recorded", none.Recorded, 200)
	let bad = ParseReport("", "replay: capsule: not sealed for this key\n")
	t.True("unreadable", !bad.Ran)
	crucible.Equal(mut t, "why", bad.Why, "unreadable: not sealed for this key")
	// a body that looks like a report line is the body
	let tricky = ParseReport("replay: status 200 (recorded 200)\nreplay: 2 recorded effects not served, said the body\n", "")
	crucible.Equal(mut t, "tricky left", tricky.Left, 0)
	// a key is never a kind
	let odd = ParseReport("replay: status 200 (recorded 200)\nreplay: divergence at effect 1: got \"x\", recorded \"y\"\n", "")
	crucible.Equal(mut t, "odd got", odd.Got, "?")
}

fn rep(status i64, effect i64, got str, want str, body str) Report {
	return Report{Ran: true, Why: "", Status: status, Recorded: 500, TimedOut: false, Effect: effect, Got: got, Want: want, Left: 0, Body: body}
}

fn TestCompare(t mut crucible.T) {
	let base = rep(500, -1, "", "", "charge failed\n")
	crucible.Equal(mut t, "same", Compare(rep(500, -1, "", "", "charge failed\n"), base, true).Outcome, OutcomeSame)
	// a new SQL query before the charge: the first effect that differs names the group, whatever the request held
	let a = Compare(rep(500, 2, "postgres@1", "wire.http@1", "x"), base, true)
	let b = Compare(rep(500, 2, "postgres@1", "wire.http@1", "y"), base, true)
	crucible.Equal(mut t, "calls", a.Outcome, OutcomeCalls)
	crucible.Equal(mut t, "one group", a.Key, b.Key)
	crucible.Equal(mut t, "effect", a.Effect, 2)
	crucible.Equal(mut t, "label", a.Label, "different calls at effect 2: got postgres@1, recorded wire.http@1")
	let other = Compare(rep(500, 1, "postgres@1", "redis@1", "x"), base, true)
	t.True("another effect, another group", other.Key != a.Key)
	// the base diverged alike (an environment the recording had): the same
	let both = rep(500, 2, "wire.http@1", "wire.http@1", "z")
	crucible.Equal(mut t, "both diverged alike", Compare(rep(500, 2, "wire.http@1", "wire.http@1", "z"), both, true).Outcome, OutcomeSame)
	// fewer calls than recorded
	let fewer = Report{Ran: true, Why: "", Status: 500, Recorded: 500, TimedOut: false, Effect: -1, Got: "", Want: "", Left: 1, Body: "charge failed\n"}
	crucible.Equal(mut t, "fewer", Compare(fewer, base, true).Key, "calls end")
	let ok = rep(200, -1, "", "", "paid\n")
	let e = Compare(rep(503, -1, "", "", "down\n"), ok, true)
	crucible.Equal(mut t, "new 5xx", e.Outcome, OutcomeError)
	crucible.Equal(mut t, "new 5xx key", e.Key, "error 503")
	crucible.Equal(mut t, "panic", Compare(rep(0, -1, "", "", ""), ok, true).Key, "error none")
	crucible.Equal(mut t, "old 5xx is not new", Compare(rep(500, -1, "", "", "other\n"), base, true).Outcome, OutcomeBody)
	crucible.Equal(mut t, "body", Compare(rep(200, -1, "", "", "paid twice\n"), ok, true).Key, "body 200")
	crucible.Equal(mut t, "status", Compare(rep(404, -1, "", "", "paid\n"), ok, true).Key, "body 200 404")
	crucible.Equal(mut t, "skipped", Compare(NoReport("unreadable"), ok, true).Outcome, OutcomeSkipped)
	// no base: compared with the recording
	crucible.Equal(mut t, "no base same", Compare(rep(500, -1, "", "", "x"), NoReport("no base"), false).Outcome, OutcomeSame)
	crucible.Equal(mut t, "no base calls", Compare(rep(500, 0, "postgres@1", "redis@1", "x"), NoReport("no base"), false).Outcome, OutcomeCalls)
	crucible.Equal(mut t, "no base status", Compare(rep(200, -1, "", "", "x"), NoReport("no base"), false).Outcome, OutcomeBody)
	t.True("ranks", outcomeRank(OutcomeCalls) < outcomeRank(OutcomeError) && outcomeRank(OutcomeError) < outcomeRank(OutcomeBody) && outcomeRank(OutcomeBody) < outcomeRank(OutcomeSame))
}

fn TestKeyAndReaders(t mut crucible.T) {
	let (priv, pub) = replay.NewIdentity() catch err {
		t.Error("identity: {err}")
		return
	}
	let (pub2, keyId) = KeyOf(priv) catch err {
		t.Error("KeyOf: {err}")
		return
	}
	crucible.Equal(mut t, "public key", pub2, pub)
	let (_, otherPub) = replay.NewIdentity() catch err {
		t.Error("identity: {err}")
		return
	}
	let readers = replay.ParseRecipients(otherPub + "," + pub) catch err {
		t.Error("recipients: {err}")
		return
	}
	let seed = seal.RandomBytes(32)
	let data = replay.SealV2("body", str(seal.RandomBytes(32)), "status=500\nmethod=POST\npath=/checkout/7\n", readers, str(seed)) catch err {
		t.Error("seal: {err}")
		return
	}
	let (signer, ids) = ReadersOf(data) catch err {
		t.Error("readers: {err}")
		return
	}
	let signerPub = seal.Ed25519PublicKey(seed) catch err {
		t.Error("signer: {err}")
		return
	}
	crucible.Equal(mut t, "signer", signer, seal.Hex(signerPub))
	crucible.Equal(mut t, "readers", len(ids), 2)
	crucible.Equal(mut t, "our key id", ids[1], keyId)
	let (_, _, v1) = ReadersOf("TINCAP\x01\x00" + twine.Repeat("x", 100))
	t.HasFault("v1", v1)
	let (_, _, cut) = ReadersOf(data[0:200])
	t.HasFault("truncated", cut)
	let (_, _, notKey) = KeyOf("tinreplaykey1:AAAA")
	t.HasFault("not a key", notKey)
}

fn TestSettings(t mut crucible.T) {
	t.NoFault("defaults", CheckSettings(Settings{Entry: "main.tin", Sample: 20, Env: []str{}}))
	t.NoFault("env", CheckSettings(Settings{Entry: "examples/checkout.tin", Sample: 1, Env: []str{"PAYMENTS_URL=http://127.0.0.1:1", "REDIS_ADDR=127.0.0.1:6379"}}))
	t.HasFault("absolute", CheckSettings(Settings{Entry: "/etc/passwd.tin", Sample: 20, Env: []str{}}))
	t.HasFault("dotdot", CheckSettings(Settings{Entry: "../x.tin", Sample: 20, Env: []str{}}))
	t.HasFault("not tin", CheckSettings(Settings{Entry: "main.go", Sample: 20, Env: []str{}}))
	t.HasFault("sample", CheckSettings(Settings{Entry: "main.tin", Sample: 0, Env: []str{}}))
	t.HasFault("TIN_", CheckSettings(Settings{Entry: "main.tin", Sample: 5, Env: []str{"TIN_REPLAY_IDENTITY=/x"}}))
	t.HasFault("PATH", CheckSettings(Settings{Entry: "main.tin", Sample: 5, Env: []str{"PATH=/x"}}))
	t.HasFault("no =", CheckSettings(Settings{Entry: "main.tin", Sample: 5, Env: []str{"JUSTNAME"}}))
	t.True("names", safeName("a.tin") && !safeName("..") && !safeName("a/b") && !safeName(""))
}

// ---- against Postgres ----

fn testDb(t mut crucible.T) ?postgres.Client {
	let (o, ok) = db.TestOptions()
	if !ok {
		t.Log("TINHUB_TEST_DB is not set: skipped")
		return nil
	}
	let c = db.Open(o)
	db.ResetForTests(c) catch err {
		t.Error("reset: {err}")
		return nil
	}
	_ = db.Migrate(c) catch err {
		t.Error("migrate: {err}")
		return nil
	}
	return c
}

fn testAuth(q anvil.Req) !i64 {
	let h = q.Header("x-test-user")
	if len(h) == 0 {
		return 0
	}
	return try mint.Atoi(h)
}

// world is an org shop (owner ada, member bob), its private repository shop/checkout with change k... at version 1,
// and carol, who has nothing.
type world struct {
	org   i64
	owner i64
	repo  i64
	ada   i64
	bob   i64
	carol i64
}

fn user(c postgres.Client, name str) !i64 {
	let o = try c.Query("INSERT INTO owners (name, kind) VALUES ({name}, 'user') RETURNING id")
	let ownerId = o.Rows[0][0].Int()
	let email = name + "@example.com"
	let u = try c.Query("INSERT INTO users (owner_id, email) VALUES ({ownerId}, {email}) RETURNING id")
	return u.Rows[0][0].Int()
}

const change = "kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkl"

fn setup(c postgres.Client) !world {
	let ada = try user(c, "ada")
	let bob = try user(c, "bob")
	let carol = try user(c, "carol")
	let o = try c.Query("INSERT INTO owners (name, kind) VALUES ('shop', 'org') RETURNING id")
	let owner = o.Rows[0][0].Int()
	let g = try c.Query("INSERT INTO orgs (owner_id) VALUES ({owner}) RETURNING id")
	let org = g.Rows[0][0].Int()
	_ = try c.Exec("INSERT INTO members (org_id, user_id, role) VALUES ({org}, {ada}, 'owner'), ({org}, {bob}, 'member')")
	let r = try c.Query("INSERT INTO repos (owner_id, name, visibility, quota_bytes) VALUES ({owner}, 'checkout', 'private', 1000000000) RETURNING id")
	let repoId = r.Rows[0][0].Int()
	let commit = twine.Repeat("ab", 32)
	_ = try c.Exec("INSERT INTO changes (repo_id, change_id, version, commit_id, op) VALUES ({repoId}, {change}, 1, {commit}, 1)")
	_ = try c.Exec("INSERT INTO grants (repo_id, user_id, role) VALUES ({repoId}, {bob}, 'read')")
	let dir = "/tmp/tin-test-tinhub-runner-" + seal.Hex(seal.RandomBytes(4))
	let s = try packs.NewDirStore(dir + "/store")
	let st dyn packs.PackStore = s
	Configure(NewDeps(c, st, dir, "/nonexistent", "", "", testAuth))
	return world{org: org, owner: owner, repo: repoId, ada: ada, bob: bob, carol: carol}
}

fn count(c postgres.Client, q query) i64 {
	let rows = c.Query(q) catch _ {
		return -1
	}
	return rows.Rows[0][0].Int()
}

fn TestRequest(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	let c = got
	let w = setup(c) catch err {
		t.Error("setup: {err}")
		return
	}
	let none = RequestNow(c, w.repo, change, 1, w.ada) catch err {
		t.Error("request: {err}")
		return
	}
	crucible.Equal(mut t, "not opted in", none, 0)
	let (priv, _) = replay.NewIdentity() catch err {
		t.Error("identity: {err}")
		return
	}
	let keyId = Register(c, priv) catch err {
		t.Error("register: {err}")
		return
	}
	let cur = CurrentKey(c) catch err {
		t.Error("current: {err}")
		return
	}
	t.True("registered", cur != nil && cur.Id == keyId)
	t.NoFault("opt in", SetOptIn(c, w.owner, keyId, []str{}, w.ada))
	t.HasFault("a bad signer", SetOptIn(c, w.owner, keyId, []str{"xyz"}, w.ada))
	let id = RequestNow(c, w.repo, change, 1, w.ada) catch err {
		t.Error("request: {err}")
		return
	}
	t.True("queued", id > 0)
	let again = RequestNow(c, w.repo, change, 1, w.bob) catch err {
		t.Error("request again: {err}")
		return
	}
	crucible.Equal(mut t, "the same run", again, id)
	crucible.Equal(mut t, "one job", count(c, "SELECT count(*) FROM events WHERE kind = 'replay.run'"), 1)
	let (_, noVersion) = RequestNow(c, w.repo, change, 2, w.ada)
	t.HasFault("no version 2", noVersion)
	// a run that ended runs again on request
	_ = c.Exec("UPDATE runner_runs SET state = 'done' WHERE id = {id}") catch _ {
		postgres.Result{Affected: 0}
	}
	let third = RequestNow(c, w.repo, change, 1, w.ada) catch err {
		t.Error("request a third time: {err}")
		return
	}
	crucible.Equal(mut t, "the run again", third, id)
	crucible.Equal(mut t, "two jobs", count(c, "SELECT count(*) FROM events WHERE kind = 'replay.run'"), 2)
	crucible.Equal(mut t, "queued again", count(c, "SELECT count(*) FROM runner_runs WHERE state = 'queued'"), 1)
	// a run without a key on this core is skipped, and a duplicate job leaves it alone
	t.NoFault("run", Run(id, 0))
	let run = RunOf(c, w.repo, change, 0) catch err {
		t.Error("run of: {err}")
		return
	}
	t.True("skipped", run != nil && run.State == "skipped" && twine.Contains(run.Reason, "runner.key"))
	let (_, outErr) = ClearOptIn(c, w.owner, w.ada)
	t.NoFault("opt out", outErr)
	crucible.Equal(mut t, "audited", count(c, "SELECT count(*) FROM audit_log WHERE action IN ('runner.optin', 'runner.optout')"), 2)
}

fn TestGroupsAndApi(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	let c = got
	let w = setup(c) catch err {
		t.Error("setup: {err}")
		return
	}
	let commit = twine.Repeat("ab", 32)
	let rows = c.Query("INSERT INTO runner_runs (repo_id, change_id, version, commit_id, state) VALUES ({w.repo}, {change}, 1, {commit}, 'done') RETURNING id") catch err {
		t.Error("run: {err}")
		return
	}
	let id = rows.Rows[0][0].Int()
	// five capsules: three meet the new query at effect 2, one answers the same, one is new 5xx
	let base = rep(500, -1, "", "", "charge failed\n")
	mut results = []result{}
	for i in 0..3 {
		results = append(results, result{capsule: "c{i}", verdict: Compare(rep(500, 2, "postgres@1", "wire.http@1", "x{i}"), base, true), recorded: 500, base: 500, change: 500})
	}
	results = append(results, result{capsule: "c3", verdict: Compare(base, base, true), recorded: 500, base: 500, change: 500})
	results = append(results, result{capsule: "c4", verdict: Compare(rep(502, -1, "", "", ""), rep(200, -1, "", "", ""), true), recorded: 200, base: 200, change: 502})
	t.NoFault("store", store(Deps{Db: c, Store: packs.DirStore{Root: "/nonexistent"}, Dir: "", Tin: "", Key: "", Cgroup: "", Auth: testAuth, Lease: 0, BuildTimeout: 0, ReplayTimeout: 0}, id, finish{state: "done", reason: "", capsules: 5, base: "", results: results}))
	let gs = Groups(c, id) catch err {
		t.Error("groups: {err}")
		return
	}
	crucible.Equal(mut t, "groups", len(gs), 3)
	crucible.Equal(mut t, "calls first", gs[0].Outcome, OutcomeCalls)
	crucible.Equal(mut t, "one group of three", gs[0].Count, 3)
	crucible.Equal(mut t, "its effect", gs[0].Effect, 2)
	crucible.Equal(mut t, "then the new 5xx", gs[1].Outcome, OutcomeError)
	crucible.Equal(mut t, "then the same", gs[2].Outcome, OutcomeSame)
	// the panel: read access and the replay permission
	mut r = anvil.NewRouter()
	Mount(mut r)
	let path = "/api/v1/repos/shop/checkout/changes/" + change + "/behaviour"
	crucible.Equal(mut t, "nobody", r.RunWith("GET", path, []str{}, "").Code(), 404)
	crucible.Equal(mut t, "no access", r.RunWith("GET", path, []str{"X-Test-User: {w.carol}"}, "").Code(), 404)
	crucible.Equal(mut t, "read, no replay", r.RunWith("GET", path, []str{"X-Test-User: {w.bob}"}, "").Code(), 403)
	let ok = r.RunWith("GET", path, []str{"X-Test-User: {w.ada}"}, "")
	crucible.Equal(mut t, "admin", ok.Code(), 200)
	let body = str(ok.Body)
	t.True("names the group", twine.Contains(body, "different calls at effect 2: got postgres@1, recorded wire.http@1"))
	t.True("no request data", !twine.Contains(body, "x0"))
	_ = c.Exec("INSERT INTO replay_grants (repo_id, user_id) VALUES ({w.repo}, {w.bob})") catch _ {
		postgres.Result{Affected: 0}
	}
	crucible.Equal(mut t, "a replay grant", r.RunWith("GET", path, []str{"X-Test-User: {w.bob}"}, "").Code(), 200)
	crucible.Equal(mut t, "no such version", r.RunWith("GET", path + "?version=7", []str{"X-Test-User: {w.ada}"}, "").Code(), 404)
	crucible.Equal(mut t, "request, not opted in", r.RunWith("POST", path, []str{"X-Test-User: {w.ada}"}, "").Code(), 409)
	// settings: replay holders read them, admins set them
	let settings = "/api/v1/repos/shop/checkout/runner"
	crucible.Equal(mut t, "settings read", r.RunWith("GET", settings, []str{"X-Test-User: {w.bob}"}, "").Code(), 200)
	crucible.Equal(mut t, "settings by a reader", r.RunWith("PUT", settings, []str{"X-Test-User: {w.bob}"}, "{{\"entry\":\"main.tin\",\"sample\":5,\"env\":[]}}").Code(), 403)
	crucible.Equal(mut t, "bad settings", r.RunWith("PUT", settings, []str{"X-Test-User: {w.ada}"}, "{{\"entry\":\"/x.tin\",\"sample\":5,\"env\":[]}}").Code(), 400)
	crucible.Equal(mut t, "settings set", r.RunWith("PUT", settings, []str{"X-Test-User: {w.ada}"}, "{{\"entry\":\"examples/checkout.tin\",\"sample\":5,\"env\":[\"PAYMENTS_URL=http://127.0.0.1:1\"]}}").Code(), 200)
	let s = SettingsOf(c, w.repo) catch err {
		t.Error("settings: {err}")
		return
	}
	crucible.Equal(mut t, "entry", s.Entry, "examples/checkout.tin")
	crucible.Equal(mut t, "env", len(s.Env), 1)
	// the org's opt-in: its owners only
	let org = "/api/v1/orgs/shop/runner"
	crucible.Equal(mut t, "no runner yet", r.RunWith("PUT", org, []str{"X-Test-User: {w.ada}"}, "").Code(), 409)
	let (priv, pub) = replay.NewIdentity() catch err {
		t.Error("identity: {err}")
		return
	}
	_ = Register(c, priv) catch err {
		t.Error("register: {err}")
		""
	}
	crucible.Equal(mut t, "outsider", r.RunWith("GET", org, []str{"X-Test-User: {w.carol}"}, "").Code(), 404)
	crucible.Equal(mut t, "member", r.RunWith("PUT", org, []str{"X-Test-User: {w.bob}"}, "").Code(), 403)
	let shown = r.RunWith("GET", org, []str{"X-Test-User: {w.ada}"}, "")
	t.True("the public key to seal for", twine.Contains(str(shown.Body), pub) && twine.Contains(str(shown.Body), "\"opted_in\":false"))
	t.True("never the private key", !twine.Contains(str(shown.Body), priv[14:40]))
	crucible.Equal(mut t, "opt in", r.RunWith("PUT", org, []str{"X-Test-User: {w.ada}"}, "").Code(), 200)
	let req = r.RunWith("POST", path, []str{"X-Test-User: {w.ada}"}, "{{\"version\":1}}")
	crucible.Equal(mut t, "request", req.Code(), 202)
	t.True("queued", twine.Contains(str(req.Body), "\"state\":\"queued\""))
	crucible.Equal(mut t, "opt out", r.RunWith("DELETE", org, []str{"X-Test-User: {w.ada}"}, "").Code(), 204)
	let opt = OptInOf(c, w.owner) catch err {
		t.Error("opt-in: {err}")
		return
	}
	t.True("out", opt == nil)
}

// ---- replay checks (checks.tin, verdict.tin) ----

fn replayed(status i64, recorded i64, effect i64, got str, want str, left i64) Report {
	return Report{Ran: true, Why: "", Status: status, Recorded: recorded, TimedOut: false, Effect: effect, Got: got, Want: want, Left: left, Body: ""}
}

fn TestPanicOf(t mut crucible.T) {
	let (msg, where) = PanicOf("panic: index out of range [1] with length 1\n\ncore 0:\n\tcheckout\n\tanvil.chain_next\n")
	crucible.Equal(mut t, "message", msg, "index out of range [1] with length 1")
	crucible.Equal(mut t, "where", where, "checkout")
	let (none, nowhere) = PanicOf("replay: capsule: not sealed for this key\n")
	crucible.Equal(mut t, "no panic", none, "")
	crucible.Equal(mut t, "nowhere", nowhere, "")
	// a frame keeps only a function's name
	let (_, odd) = PanicOf("panic: x\ncore 1:\n\tshop.charge$1 (main.tin:12)\n")
	crucible.Equal(mut t, "frame", odd, "shop.charge$1")
}

fn TestJudge(t mut crucible.T) {
	let p = "index out of range [1] with length 1"
	// the fix: the same calls, no panic, a 4xx where production panicked
	let fixed = Judge(replayed(402, 500, -1, "", "", 0), "", "", p)
	crucible.Equal(mut t, "fixed", fixed.Verdict, VerdictPassed)
	crucible.Equal(mut t, "fixed label", fixed.Label, "passed: 402, recorded 500 after a panic")
	t.True("fixed says so", twine.HasPrefix(fixed.Detail, "Fixed."))
	// production's own panic again
	let again = Judge(replayed(500, 500, -1, "", "", 0), p, "checkout", p)
	crucible.Equal(mut t, "panicked", again.Verdict, VerdictPanicked)
	crucible.Equal(mut t, "panicked label", again.Label, "panicked in checkout: the recorded panic")
	crucible.Equal(mut t, "panic in", again.PanicIn, "checkout")
	// a panic that is not the group's keeps its message out
	let other = Judge(replayed(500, 500, -1, "", "", 0), "card 4111 refused", "charge", p)
	crucible.Equal(mut t, "other label", other.Label, "panicked in charge")
	t.True("no message", !twine.Contains(other.Detail, "4111"))
	// an extra call at the end, a different call, the same kind with other arguments, a call not made
	let retry = Judge(replayed(503, 500, 3, "wire.http@1", "", 0), "", "", p)
	crucible.Equal(mut t, "retry", retry.Verdict, VerdictDiverged)
	crucible.Equal(mut t, "retry label", retry.Label, "diverged at effect 3: an extra wire.http@1")
	let lookup = Judge(replayed(502, 500, 2, "redis@1", "wire.http@1", 1), "", "", p)
	crucible.Equal(mut t, "lookup label", lookup.Label, "diverged at effect 2: redis@1 where production made wire.http@1")
	t.True("lookup words", twine.Contains(lookup.Detail, "a Redis command (redis@1) where production made an HTTP request (wire.http@1)"))
	let env = Judge(replayed(500, 500, 2, "wire.http@1", "wire.http@1", 1), "", "", p)
	crucible.Equal(mut t, "env label", env.Label, "diverged at effect 2: wire.http@1 with other arguments")
	let early = Judge(replayed(422, 500, -1, "", "", 1), "", "", p)
	crucible.Equal(mut t, "early", early.Verdict, VerdictDiverged)
	crucible.Equal(mut t, "early label", early.Label, "diverged: answered without 1 recorded call")
	// an outage replayed: no panic, still a 5xx
	let outage = Judge(replayed(503, 500, -1, "", "", 0), "", "", "")
	crucible.Equal(mut t, "outage", outage.Verdict, VerdictFailing)
	crucible.Equal(mut t, "outage label", outage.Label, "still fails: status 503")
	let same = Judge(replayed(500, 500, -1, "", "", 0), "", "", "")
	t.True("reproduced", twine.Contains(same.Detail, "reproduced, not fixed"))
	// a request that did not fail, served the same
	let ok = Judge(replayed(200, 200, -1, "", "", 0), "", "", "")
	crucible.Equal(mut t, "ok label", ok.Label, "passed: 200, as recorded")
	let slow = Judge(Report{Ran: true, Why: "", Status: 0, Recorded: 500, TimedOut: true, Effect: -1, Got: "", Want: "", Left: 0, Body: ""}, "", "", p)
	crucible.Equal(mut t, "timeout", slow.Verdict, VerdictTimeout)
	let skipped = Judge(NoReport("not sealed for the runner's key"), "", "", p)
	crucible.Equal(mut t, "skipped", skipped.Verdict, VerdictSkipped)
	crucible.Equal(mut t, "call names", CallName("postgres@1"), "a Postgres query")
	crucible.Equal(mut t, "unknown call", CallName("nats@2"), "a nats call")
}

fn TestChecks(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	let c = got
	let w = setup(c) catch err {
		t.Error("setup: {err}")
		return
	}
	let group = twine.Repeat("9f", 6)
	let capsule = twine.Repeat("c1", 32)
	let other = twine.Repeat("c2", 32)
	_ = c.Exec("INSERT INTO replay_groups (repo_id, id, panic, route, state, count) VALUES ({w.repo}, {group}, 'index out of range [1] with length 1', 'POST /checkout/{{id}}', 'open', 2)") catch err {
		t.Error("group: {err}")
		postgres.Result{Affected: 0}
	}
	_ = c.Exec("INSERT INTO capsules (repo_id, id, group_id, status, route, expires_at) VALUES ({w.repo}, {capsule}, {group}, 500, 'POST /checkout/2', now() + interval '1 day'), ({w.repo}, {other}, {group}, 500, 'POST /checkout/3', now() + interval '1 day')") catch err {
		t.Error("capsules: {err}")
		postgres.Result{Affected: 0}
	}
	let commit = twine.Repeat("ab", 32)
	mut tx = c.Begin() catch err {
		t.Error("begin: {err}")
		return
	}
	let none = RequestCheck(mut tx, w.repo, "fix/declined", commit, group, "", w.ada) catch err {
		t.Error("request: {err}")
		0
	}
	crucible.Equal(mut t, "not opted in", none, 0)
	let (priv, _) = replay.NewIdentity() catch err {
		t.Error("identity: {err}")
		return
	}
	let keyId = Register(c, priv) catch err {
		t.Error("register: {err}")
		return
	}
	t.NoFault("opt in", SetOptIn(c, w.owner, keyId, []str{}, w.ada))
	let id = RequestCheck(mut tx, w.repo, "fix/declined", commit, group, "", w.ada) catch err {
		t.Error("request: {err}")
		0
	}
	t.True("queued", id > 0)
	let (_, noGroup) = RequestCheck(mut tx, w.repo, "fix/declined", commit, "nogroup", "", w.ada)
	t.True("no such group", fault.Is(noGroup, ErrNoGroup))
	tx.Rollback() catch _ {
	}
	mut tx2 = c.Begin() catch err {
		t.Error("begin: {err}")
		return
	}
	let (_, wrongCapsule) = RequestCheck(mut tx2, w.repo, "fix/declined", commit, group, twine.Repeat("dd", 32), w.ada)
	t.True("no such capsule in the group", fault.Is(wrongCapsule, ErrNoGroup))
	tx2.Rollback() catch _ {
	}
	mut tx3 = c.Begin() catch err {
		t.Error("begin: {err}")
		return
	}
	let one = RequestCheck(mut tx3, w.repo, "fix/declined", commit, group, capsule, w.ada) catch err {
		t.Error("request one: {err}")
		0
	}
	t.NoFault("commit", tx3.Commit())
	crucible.Equal(mut t, "a job", count(c, "SELECT count(*) FROM events WHERE kind = 'replay.check'"), 1)
	// verdicts as a check stores them: what needs a look first, counted per verdict
	let p = "index out of range [1] with length 1"
	let a = Judge(replayed(500, 500, -1, "", "", 0), p, "checkout", p)
	let b = Judge(replayed(402, 500, -1, "", "", 0), "", "", p)
	let f = checkEnd{state: "done", reason: "", results: []checkResult{checkResult{capsule: other, judged: b, report: replayed(402, 500, -1, "", "", 0)}, checkResult{capsule: capsule, judged: a, report: replayed(500, 500, -1, "", "", 0)}}}
	t.NoFault("store", storeCheck(Deps{Db: c, Store: packs.DirStore{Root: "/nonexistent"}, Dir: "", Tin: "", Key: "", Cgroup: "", Auth: testAuth, Lease: 0, BuildTimeout: 0, ReplayTimeout: 0, Sandbox: "on"}, one, f))
	let rs = CheckResults(c, one) catch err {
		t.Error("results: {err}")
		return
	}
	crucible.Equal(mut t, "two results", len(rs), 2)
	crucible.Equal(mut t, "panicked first", rs[0].Verdict, VerdictPanicked)
	crucible.Equal(mut t, "its route", rs[0].Route, "POST /checkout/2")
	crucible.Equal(mut t, "then passed", rs[1].Verdict, VerdictPassed)
	// the API: read access and the replay permission
	mut r = anvil.NewRouter()
	Mount(mut r)
	let list = "/api/v1/repos/shop/checkout/replay/checks?group=" + group
	crucible.Equal(mut t, "no access", r.RunWith("GET", list, []str{"X-Test-User: {w.carol}"}, "").Code(), 404)
	crucible.Equal(mut t, "read, no replay", r.RunWith("GET", list, []str{"X-Test-User: {w.bob}"}, "").Code(), 403)
	let shown = r.RunWith("GET", list, []str{"X-Test-User: {w.ada}"}, "")
	crucible.Equal(mut t, "list", shown.Code(), 200)
	t.True("counted", twine.Contains(str(shown.Body), "\"counts\":[{{\"verdict\":\"panicked\",\"count\":1}},{{\"verdict\":\"passed\",\"count\":1}}]"))
	t.True("opted in", twine.Contains(str(shown.Body), "\"opted_in\":true"))
	let detail = r.RunWith("GET", "/api/v1/repos/shop/checkout/replay/checks/{one}", []str{"X-Test-User: {w.ada}"}, "")
	crucible.Equal(mut t, "detail", detail.Code(), 200)
	t.True("explains", twine.Contains(str(detail.Body), "Fixed. Production answered 500 after a panic"))
	crucible.Equal(mut t, "another repository's check", r.RunWith("GET", "/api/v1/repos/shop/checkout/replay/checks/999999", []str{"X-Test-User: {w.ada}"}, "").Code(), 404)
	// a revision the repository does not have
	let post = "/api/v1/repos/shop/checkout/replay/checks"
	crucible.Equal(mut t, "no group", r.RunWith("POST", post, []str{"X-Test-User: {w.ada}"}, "{{\"target\":\"main\"}}").Code(), 400)
	crucible.Equal(mut t, "no branch", r.RunWith("POST", post, []str{"X-Test-User: {w.ada}"}, "{{\"target\":\"fix/none\",\"group\":\"{group}\"}}").Code(), 404)
}
