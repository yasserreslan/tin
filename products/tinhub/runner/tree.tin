package runner

import "../../tit/object"
import "../../tit/store"
import "fault"
import "quarry"

// A commit's files, written into a directory the sandbox mounts read-only at /src. Links are left out (a build needs
// none, and a link could point the build at the host's files outside the mount); a name that is not one path element
// is refused.

// treeMost is the most bytes of files one tree may write: a larger one is refused rather than filling the disk.
const treeMost = 256 * 1024 * 1024

// CommitOf is a commit's tree and its first parent (object.NoId when it has none).
fn CommitOf(objs mut store.Layered, commit object.Id) !(object.Id, object.Id) {
	let o = try objs.Get(commit)
	match o {
		Commit(c) => {
			if len(c.Parents) > 0 {
				return c.Tree, c.Parents[0]
			}
			return c.Tree, object.NoId
		}
		_ => {
			fail "{commit.Hex()} is not a commit"
		}
	}
	return object.NoId, object.NoId
}

// WriteTree writes the tree's files under dir (made when missing); the bytes written.
fn WriteTree(objs mut store.Layered, tree object.Id, dir str) !i64 {
	try quarry.MkdirAll(dir)
	return try writeTreeIn(mut objs, tree, dir, 0)
}

// writeTreeIn writes a tree under dir, with written bytes written so far; the bytes written after it.
fn writeTreeIn(objs mut store.Layered, tree object.Id, dir str, written i64) !i64 {
	mut total = written
	let o = try objs.Get(tree)
	mut entries = []object.Entry{}
	match o {
		Tree(es) => {
			entries = es
		}
		_ => {
			fail "{tree.Hex()} is not a tree"
		}
	}
	for e in entries {
		if !safeName(e.Name) {
			fail "a tree entry named {e.Name}"
		}
		let path = dir + "/" + e.Name
		match e.Mode {
			Dir => {
				try quarry.MkdirAll(path)
				total = try writeTreeIn(mut objs, e.Id, path, total)
			}
			Link => {
			}
			_ => {
				let (kind, body) = try objs.GetRaw(e.Id)
				if kind != object.Kind.Blob {
					fail "{e.Name} is not a blob"
				}
				total = total + len(body)
				if total > treeMost {
					fail fault.Wrap(fault.LimitExceeded, "the tree is larger than {treeMost} bytes")
				}
				try quarry.WriteFile(path, body)
				if e.Mode == object.Mode.Exec {
					try quarry.Chmod(path, 493)
				}
			}
		}
	}
	return total
}

// safeName reports whether a tree entry's name is one path element.
fn safeName(name str) bool {
	if len(name) == 0 || name == "." || name == ".." {
		return false
	}
	for c in name {
		if c == '/' || c == 0 {
			return false
		}
	}
	return true
}

// safeEntry reports whether a repository's entry file (runner_settings.entry) is a relative .tin path inside the tree.
fn safeEntry(path str) bool {
	if len(path) < 5 || len(path) > 200 || path[0] == '/' || path[len(path) - 4:] != ".tin" {
		return false
	}
	mut start = 0
	for i in 0..len(path) + 1 {
		if i == len(path) || path[i] == '/' {
			if !safeName(path[start:i]) {
				return false
			}
			start = i + 1
		}
	}
	for c in path {
		let ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '/' || c == '.' || c == '_' || c == '-'
		if !ok {
			return false
		}
	}
	return true
}
