package runner

import "../../tit/change"
import "../../tit/object"
import "../../tit/store"
import "../events"
import "argo"
import "fault"
import "herald"
import "mint"
import "postgres"
import "quarry"
import "seal"
import "twine"

// Replay checks (design/tinhub.md §12.1): the question after a production failure is "does my fix handle what
// happened?". A check takes any revision of the repository (a branch, a tag, a change or a commit), builds it in the
// runner's sandbox, and replays the capsules of one failure group (or one capsule of it) against that build, each
// judged against its own recording (Judge): passed, diverged at effect N, panicked, still failing, timed out, or
// skipped. It runs where runs do (the runner role, for owners that opted in, capsules sealed for the runner's key) and
// keeps what runs keep: outcomes, statuses, effect numbers and kinds, never a request, a body or an effect's key.

// KindCheck is a check's job: {"check": <runner_checks id>}.
const KindCheck = "replay.check"

// CheckSample is the most capsules a group's check replays: the newest.
const CheckSample = 20

// ErrNoRevision is the fault of a target the repository has no commit for.
let ErrNoRevision = fault("no such revision")

// ErrNoGroup is the fault of a failure group or capsule the repository does not have.
let ErrNoGroup = fault("no such failure group or capsule")

// Resolve is the commit (hex) a target names: a branch, then a tag (refs/heads/<t>, refs/tags/<t>, or a full ref
// name), a change id (its newest version), or a full commit id.
fn Resolve(repoId i64, target str) !str {
	let t = twine.TrimSpace(target)
	if len(t) == 0 || len(t) > 200 {
		fail fault.Wrap(ErrNoRevision, "a branch, tag, change or commit is needed")
	}
	mut r = try repoOf(repoId)
	mut objs = try r.Objects()
	mut names = []str{}
	if twine.HasPrefix(t, "refs/") {
		names = append(names, t)
	} else {
		names = append(names, "refs/heads/" + t, "refs/tags/" + t)
	}
	for name in names {
		let ref = try r.Ref(name)
		if ref == nil {
			continue
		}
		mut id = object.NoId
		match ref.Target {
			Commit(c) => {
				id = c
			}
			Change(ch) => {
				let v = try r.Newest(ch)
				if v != nil {
					id = v.Commit()
				}
			}
		}
		if id == object.NoId {
			continue
		}
		return try peelCommit(mut objs, id)
	}
	if len(t) == 32 {
		let (ch, bad) = object.ParseChangeId(t)
		if bad == nil {
			let v = try r.Newest(ch)
			if v != nil {
				return v.Commit().Hex()
			}
		}
	}
	if len(t) == 64 {
		let (id, bad) = object.ParseId(t)
		if bad == nil {
			let (o, missing) = objs.Get(id)
			if missing == nil {
				_ = o
				return try peelCommit(mut objs, id)
			}
		}
	}
	fail fault.Wrap(ErrNoRevision, "{t} is not a branch, tag, change or commit of the repository")
}

// peelCommit follows tags to the commit they name (hex).
fn peelCommit(objs mut store.Layered, id0 object.Id) !str {
	mut id = id0
	for i in 0..16 {
		let o = try objs.Get(id)
		match o {
			Commit(_) => {
				return id.Hex()
			}
			Tag(t) => {
				id = t.Object
			}
			_ => {
				fail fault.Wrap(ErrNoRevision, "{id.Hex()} is not a commit")
			}
		}
		_ = i
	}
	fail fault.Wrap(ErrNoRevision, "tags nested too deep")
}

// ---- requesting a check ----

type checkPayload struct {
	check i64
}

fn checkPayloadOf(id i64) str {
	mut b = []u8{}
	argo.Put(mut b, checkPayload{check: id})
	return str(b)
}

// RequestCheck queues a check of target against the failure group groupId (capsuleId "" for all its capsules, else
// that one) in tx: its id, or 0 when the repository's owner has not opted in to the runner (nothing is queued).
fn RequestCheck(tx mut postgres.Tx, repoId i64, target str, commit str, groupId str, capsuleId str, by i64) !i64 {
	let opted = try tx.Query("SELECT 1 FROM repos r JOIN runner_optins o ON o.owner_id = r.owner_id WHERE r.id = {repoId}")
	if len(opted.Rows) == 0 {
		return 0
	}
	if len(capsuleId) > 0 {
		let c = try tx.Query("SELECT 1 FROM capsules WHERE repo_id = {repoId} AND group_id = {groupId} AND id = {capsuleId}")
		if len(c.Rows) == 0 {
			fail fault.Wrap(ErrNoGroup, "no capsule {capsuleId} in group {groupId}")
		}
	} else {
		let g = try tx.Query("SELECT 1 FROM replay_groups WHERE repo_id = {repoId} AND id = {groupId}")
		if len(g.Rows) == 0 {
			fail fault.Wrap(ErrNoGroup, "no failure group {groupId}")
		}
	}
	let t = twine.TrimSpace(target)
	let made = try tx.Query("INSERT INTO runner_checks (repo_id, target, commit_id, group_id, capsule_id, requested_by) VALUES ({repoId}, {t}, {commit}, {groupId}, {capsuleId}, nullif({by}, 0)) RETURNING id")
	let id = made.Rows[0][0].Int()
	_ = try events.Enqueue(mut tx, KindCheck, repoId, checkPayloadOf(id))
	return id
}

// RequestCheckNow resolves target and queues its check in a transaction of its own.
fn RequestCheckNow(c postgres.Client, repoId i64, target str, groupId str, capsuleId str, by i64) !i64 {
	let commit = try Resolve(repoId, target)
	mut tx = try c.Begin()
	let (id, err) = RequestCheck(mut tx, repoId, target, commit, groupId, capsuleId, by)
	if err != nil {
		tx.Rollback() catch _ {
		}
		fail err
	}
	try tx.Commit()
	return id
}

// ---- the job ----

fn checkJob(j events.Job) ! {
	mut p = checkPayload{check: 0}
	argo.Get(j.Payload, mut p) catch err {
		fail "replay.check: a payload without a check: {fault.Message(err)}"
	}
	try RunCheck(p.check, j.Id)
}

type checkResult struct {
	capsule  str
	judged   Judgement
	report   Report
}

type checkEnd struct {
	state   str
	reason  str
	results []checkResult
}

fn checkEnded(state str, reason str) checkEnd {
	return checkEnd{state: state, reason: reason, results: []checkResult{}}
}

// RunCheck runs the check with this id, as its job (jobId, whose lease it renews; 0 for none) does: one that is done
// or skipped is left alone. A fault marks it failed and is the job's.
fn RunCheck(checkId i64, jobId i64) ! {
	let d = try depsOf()
	let rows = try d.Db.Query("SELECT k.repo_id, k.commit_id, k.group_id, k.capsule_id, k.state, p.owner_id, coalesce(g.panic, '') FROM runner_checks k JOIN repos p ON p.id = k.repo_id LEFT JOIN replay_groups g ON g.repo_id = k.repo_id AND g.id = k.group_id WHERE k.id = {checkId}")
	if len(rows.Rows) == 0 {
		return
	}
	let row = rows.Rows[0]
	let state = row[4].Text()
	if state == "done" || state == "skipped" {
		return
	}
	let repoId = row[0].Int()
	_ = try d.Db.Exec("UPDATE runner_checks SET state = 'running', reason = '', started_at = now() WHERE id = {checkId}")
	let (f, err) = checkAttempt(d, checkId, jobId, repoId, row[5].Int(), row[1].Text(), row[2].Text(), row[3].Text(), row[6].Text())
	if err != nil {
		let why = clip(fault.Message(err), 2000)
		_ = d.Db.Exec("UPDATE runner_checks SET state = 'failed', reason = {why}, finished_at = now() WHERE id = {checkId}") catch _ {
			postgres.Result{Affected: 0}
		}
		fail err
	}
	try storeCheck(d, checkId, f)
	herald.Log(herald.LInfo, "replay check", []str{"check", mint.Itoa(checkId), "state", f.state, "capsules", mint.Itoa(len(f.results))})
}

fn storeCheck(d Deps, checkId i64, f checkEnd) ! {
	mut tx = try d.Db.Begin()
	let err = storeCheckIn(mut tx, checkId, f)
	if err != nil {
		tx.Rollback() catch _ {
		}
		fail err
	}
	try tx.Commit()
}

fn storeCheckIn(tx mut postgres.Tx, checkId i64, f checkEnd) ! {
	_ = try tx.Exec("DELETE FROM runner_check_results WHERE check_id = {checkId}")
	for r in f.results {
		let j = r.judged
		let p = r.report
		_ = try tx.Exec("INSERT INTO runner_check_results (check_id, capsule_id, verdict, label, detail, status, recorded_status, effect, got, want, left_over, panic_in) VALUES ({checkId}, {r.capsule}, {j.Verdict}, {j.Label}, {j.Detail}, {p.Status}::int, {p.Recorded}::int, {p.Effect}::int, {p.Got}, {p.Want}, {p.Left}::int, {j.PanicIn}) ON CONFLICT (check_id, capsule_id) DO NOTHING")
	}
	let n = len(f.results)
	_ = try tx.Exec("UPDATE runner_checks SET state = {f.state}, reason = {f.reason}, capsules = {n}::int, finished_at = now() WHERE id = {checkId}")
}

// checkAttempt is one check: the opt-in, the capsules, then the build and the replays in a working directory removed
// afterwards.
fn checkAttempt(d Deps, checkId i64, jobId i64, repoId i64, ownerId i64, commit str, groupId str, capsuleId str, groupPanic str) !checkEnd {
	if len(reveal(d.Key)) == 0 {
		return checkEnded("skipped", "this runner has no key (runner.key)")
	}
	let keyId = try Register(d.Db, d.Key)
	let opt = try OptInOf(d.Db, ownerId)
	if opt == nil {
		return checkEnded("skipped", "the repository's owner has not opted in to the runner")
	}
	if opt.KeyId != keyId {
		return checkEnded("skipped", "the owner opted in for another runner key ({opt.KeyId[0:12]}); opt in again for {keyId[0:12]}")
	}
	let settings = try SettingsOf(d.Db, repoId)
	let bad = CheckSettings(settings)
	if bad != nil {
		return checkEnded("failed", fault.Message(bad))
	}
	if !quarry.Exists(d.Tin + "/bin/tinc") || !quarry.Exists(d.Tin + "/tin") {
		fail "runner: runner.tin {d.Tin} has no bin/tinc and tin"
	}
	let work = d.Dir + "/runner/check-{checkId}-" + seal.Hex(seal.RandomBytes(6))
	try quarry.MkdirAll(work)
	try quarry.Chmod(work, 448)
	let (f, err) = checkInWork(d, work, jobId, repoId, keyId, opt.Signers, settings, commit, groupId, capsuleId, groupPanic)
	quarry.RemoveAll(work) catch _ {
	}
	if err != nil {
		fail err
	}
	return f
}

fn checkInWork(d Deps, work str, jobId i64, repoId i64, keyId str, signers []str, settings Settings, commit str, groupId str, capsuleId str, groupPanic str) !checkEnd {
	let (sample, unsealed) = try pickChecked(d, work, repoId, keyId, signers, groupId, capsuleId)
	mut results = []checkResult{}
	for id in unsealed {
		let rep = NoReport("not sealed for the runner's key")
		results = append(results, checkResult{capsule: id, judged: Judge(rep, "", "", groupPanic), report: rep})
	}
	if len(sample) == 0 {
		if len(results) == 0 {
			return checkEnded("skipped", "the failure group holds no capsules")
		}
		return checkEnd{state: "done", reason: "no capsule of the group is sealed for the runner: add its public key to the recording server's TIN_REPLAY_RECIPIENTS", results: results}
	}
	mut r = try repoOf(repoId)
	mut objs = try r.Objects()
	let cid = try object.ParseId(commit)
	let (tree, _) = try CommitOf(mut objs, cid)
	_ = try WriteTree(mut objs, tree, work + "/src")
	let scratch = work + "/scratch"
	try quarry.MkdirAll(scratch + "/tmp")
	let built = try Build(d, work + "/src", scratch, settings.Entry, "check.bin")
	extend(d, jobId)
	if len(built) > 0 {
		return checkEnded("failed", "{settings.Entry} does not build at {commit[0:12]}:\n" + clip(built, 2000))
	}
	let keyPath = scratch + "/runner.key"
	try quarry.WriteFile(keyPath, twine.TrimSpace(reveal(d.Key)) + "\n")
	try quarry.Chmod(keyPath, 384)
	let (replayed, err) = checkAll(d, scratch, jobId, sample, settings.Env, groupPanic)
	quarry.Remove(keyPath) catch _ {
	}
	if err != nil {
		fail err
	}
	for x in replayed {
		results = append(results, x)
	}
	return checkEnd{state: "done", reason: "", results: results}
}

fn checkAll(d Deps, scratch str, jobId i64, sample []picked, env []str, groupPanic str) ![]checkResult {
	mut out = []checkResult{}
	for p in sample {
		let path = scratch + "/capsule.tcap"
		try quarry.WriteFile(path, p.data)
		let (rep, stderr) = try replayFull(d, scratch, "check.bin", p.signers, env)
		extend(d, jobId)
		quarry.Remove(path) catch _ {
		}
		let (msg, where) = PanicOf(stderr)
		out = append(out, checkResult{capsule: p.id, judged: Judge(rep, msg, where, groupPanic), report: rep})
	}
	return out
}

// pickChecked is the group's newest capsules (or the one asked for), at most CheckSample: those sealed for the runner's
// key with their bytes and signers, and the ids of the others.
fn pickChecked(d Deps, work str, repoId i64, keyId str, signers []str, groupId str, capsuleId str) !([]picked, []str) {
	let rows = try d.Db.Query("SELECT id FROM capsules WHERE repo_id = {repoId} AND group_id = {groupId} AND ({capsuleId} = '' OR id = {capsuleId}) AND expires_at > now() ORDER BY created_at DESC, id LIMIT {CheckSample}")
	mut out = []picked{}
	mut unsealed = []str{}
	for row in rows.Rows {
		let id = row[0].Text()
		let data = try bytesOf(d, work, repoId, id)
		let (signer, readers) = ReadersOf(data) catch _ {
			unsealed = append(unsealed, id)
			continue
		}
		mut sealed = false
		for r in readers {
			if r == keyId {
				sealed = true
			}
		}
		if !sealed {
			unsealed = append(unsealed, id)
			continue
		}
		mut trust = twine.Join(signers, ",")
		if len(trust) == 0 {
			trust = signer
		}
		out = append(out, picked{id: id, data: data, signers: trust})
	}
	return out, unsealed
}

// ---- reading checks ----

// CheckInfo is a check as the page shows it, with its verdicts counted.
type CheckInfo struct {
	Id       i64
	Target   str
	Commit   str
	Group    str
	Capsule  str
	State    str
	Reason   str
	Capsules i64
	Created  i64
	Finished i64
	By       str
	// Counts is each verdict's count, in verdictRank order
	Counts []VerdictCount
}

// VerdictCount is how many capsules of a check had a verdict.
type VerdictCount value struct {
	Verdict str
	Count   i64
}

// CheckResult is one capsule's verdict.
type CheckResult struct {
	Capsule  str
	Verdict  str
	Label    str
	Detail   str
	Status   i64
	Recorded i64
	Effect   i64
	Got      str
	Want     str
	Left     i64
	PanicIn  str
	Route    str
}

// checkOfRow reads a row of the checks queries: the check's columns, its requester's name and "verdict:count,..."
fn checkOfRow(r []postgres.Value) CheckInfo {
	mut counts = []VerdictCount{}
	let text = r[11].Text()
	for rank in 0..6 {
		for part in splitList(text) {
			let (v, n, ok) = twine.Cut(part, ":")
			if ok && verdictRank(v) == rank {
				counts = append(counts, VerdictCount{Verdict: v, Count: number(n)})
			}
		}
	}
	return CheckInfo{Id: r[0].Int(), Target: r[1].Text(), Commit: r[2].Text(), Group: r[3].Text(), Capsule: r[4].Text(), State: r[5].Text(), Reason: r[6].Text(), Capsules: r[7].Int(), Created: r[8].Int(), Finished: r[9].Int(), By: r[10].Text(), Counts: counts}
}

// ChecksOf is the repository's checks, newest first: of one failure group when groupId is set, at most n.
fn ChecksOf(c postgres.Client, repoId i64, groupId str, n i64) ![]CheckInfo {
	let rows = try c.Query("SELECT k.id, k.target, k.commit_id, k.group_id, k.capsule_id, k.state, k.reason, k.capsules, (extract(epoch FROM k.created_at))::bigint, coalesce((extract(epoch FROM k.finished_at))::bigint, 0), coalesce(o.name, ''), coalesce((SELECT string_agg(verdict || ':' || n, ',') FROM (SELECT verdict, count(*) AS n FROM runner_check_results WHERE check_id = k.id GROUP BY verdict) v), '') FROM runner_checks k LEFT JOIN users u ON u.id = k.requested_by LEFT JOIN owners o ON o.id = u.owner_id WHERE k.repo_id = {repoId} AND ({groupId} = '' OR k.group_id = {groupId}) ORDER BY k.id DESC LIMIT {n}")
	mut out = []CheckInfo{}
	for r in rows.Rows {
		out = append(out, checkOfRow(r))
	}
	return out
}

// CheckOf is a check of the repository, nil when it has none with this id.
fn CheckOf(c postgres.Client, repoId i64, id i64) !?CheckInfo {
	let rows = try c.Query("SELECT k.id, k.target, k.commit_id, k.group_id, k.capsule_id, k.state, k.reason, k.capsules, (extract(epoch FROM k.created_at))::bigint, coalesce((extract(epoch FROM k.finished_at))::bigint, 0), coalesce(o.name, ''), coalesce((SELECT string_agg(verdict || ':' || n, ',') FROM (SELECT verdict, count(*) AS n FROM runner_check_results WHERE check_id = k.id GROUP BY verdict) v), '') FROM runner_checks k LEFT JOIN users u ON u.id = k.requested_by LEFT JOIN owners o ON o.id = u.owner_id WHERE k.repo_id = {repoId} AND k.id = {id}")
	if len(rows.Rows) == 0 {
		return nil
	}
	return checkOfRow(rows.Rows[0])
}

// CheckResults is a check's verdicts, what needs a look first.
fn CheckResults(c postgres.Client, id i64) ![]CheckResult {
	let rows = try c.Query("SELECT r.capsule_id, r.verdict, r.label, r.detail, r.status, r.recorded_status, r.effect, r.got, r.want, r.left_over, r.panic_in, coalesce(p.route, '') FROM runner_check_results r JOIN runner_checks k ON k.id = r.check_id LEFT JOIN capsules p ON p.repo_id = k.repo_id AND p.id = r.capsule_id WHERE r.check_id = {id} ORDER BY r.capsule_id")
	mut out = []CheckResult{}
	for rank in 0..6 {
		for r in rows.Rows {
			if verdictRank(r[1].Text()) != rank {
				continue
			}
			out = append(out, CheckResult{Capsule: r[0].Text(), Verdict: r[1].Text(), Label: r[2].Text(), Detail: r[3].Text(), Status: r[4].Int(), Recorded: r[5].Int(), Effect: r[6].Int(), Got: r[7].Text(), Want: r[8].Text(), Left: r[9].Int(), PanicIn: r[10].Text(), Route: r[11].Text()})
		}
	}
	return out
}
