package repo

import "herald"
import "redis"
import "twine"

// RefCache keeps each repository's refs in Redis (#1016), and is safe to lose: a miss or any Redis fault reads
// Postgres. Entries are keyed by a generation that a commit bumps after it lands, so an entry filled from what
// Postgres held before a push is never read once that push has answered:
//
//	<prefix>refgen:<repo>          the generation (INCR after every commit that moves refs)
//	<prefix>refs:<repo>:<gen>      the refs at that generation, "v1\n" then a "name\ttarget\n" line each; expires
//
// The prefix is "tinhub:" in a deployment.
//
// A commit whose INCR fails (Redis down) leaves entries readers may still find for up to Ttl, should Redis come back
// with its data: Ttl bounds that staleness. Pushes never read the cache: they check refs in Postgres under the lock.
type RefCache struct {
	Client redis.Client
	On     bool
	Ttl    i64
	Prefix str
}

// NewRefCache is a cache in the Redis at addr ("" for none: then every read goes to Postgres).
fn NewRefCache(addr str, prefix str, ttl i64) RefCache {
	return RefCache{Client: redis.Open(redis.Options{Addr: addr, Username: "", Password: "", DB: 0, Proto: 0, Timeout: 0, TLS: nil}), On: len(addr) > 0, Ttl: ttl, Prefix: prefix}
}

// NoCache is a RefCache that reads Postgres every time.
fn NoCache() RefCache {
	return NewRefCache("", "tinhub:", 0)
}

fn (c RefCache) genKey(repo i64) str {
	return c.Prefix + "refgen:{repo}"
}

fn (c RefCache) refsKey(repo i64, gen str) str {
	return c.Prefix + "refs:{repo}:{gen}"
}

// generation is the repository's generation, "0" before its first commit; false when Redis did not answer.
fn (c RefCache) generation(repo i64) (str, bool) {
	let (v, found) = c.Client.Get(c.genKey(repo)) catch err {
		herald.Log(herald.LDebug, "ref cache", []str{"error", "{err}"})
		return "", false
	}
	if !found {
		return "0", true
	}
	return v, true
}

// get is the cached refs text of the repository and its generation; ok is false on a miss.
fn (c RefCache) get(repo i64) (str, str, bool) {
	if !c.On {
		return "", "", false
	}
	let (gen, ok) = c.generation(repo)
	if !ok {
		return "", "", false
	}
	let (v, found) = c.Client.Get(c.refsKey(repo, gen)) catch _ {
		return "", gen, false
	}
	if !found || !twine.HasPrefix(v, "v1\n") {
		return "", gen, false
	}
	return v, gen, true
}

// put fills the entry of generation gen.
fn (c RefCache) put(repo i64, gen str, text str) {
	if !c.On || len(gen) == 0 {
		return
	}
	c.Client.SetEx(c.refsKey(repo, gen), text, c.Ttl) catch _ {
	}
}

// bump moves the repository to a new generation, after a commit.
fn (c RefCache) bump(repo i64) {
	if !c.On {
		return
	}
	_ = c.Client.Incr(c.genKey(repo)) catch err {
		herald.Log(herald.LWarn, "ref cache: a commit could not move the generation", []str{"repo", "{repo}", "error", "{err}"})
		0
	}
}
