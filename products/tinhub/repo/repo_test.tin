package repo

import "../../tit/change"
import "../../tit/object"
import "../../tit/packfile"
import "../../tit/store"
import "../../tit/transport"
import "../db"
import "../packs"
import "crucible"
import "fault"
import "postgres"
import "quarry"
import "seal"
import "twine"

// Tests for PgRepo (#1016) against Postgres (TINHUB_TEST_DB), and the Redis at TINHUB_TEST_REDIS (host:port) when set:
// the Repo contract tit's own repositories pass, two servers racing for one ref, and tit's server pushing and
// fetching over a PgRepo.

fn testDb(t mut crucible.T) ?postgres.Client {
	let (o, ok) = db.TestOptions()
	if !ok {
		t.Log("TINHUB_TEST_DB is not set: skipped")
		return nil
	}
	let c = db.Open(o)
	db.ResetForTests(c) catch err {
		t.Error("reset: {err}")
		return nil
	}
	_ = db.Migrate(c) catch err {
		t.Error("migrate: {err}")
		return nil
	}
	return c
}

// cache is a ref cache in the Redis at TINHUB_TEST_REDIS (host:port), under a fresh prefix, or none.
fn cache() RefCache {
	return NewRefCache(quarry.Getenv("TINHUB_TEST_REDIS"), "tinhub-test-" + seal.Hex(seal.RandomBytes(4)) + ":", 60 * 1000000000)
}

fn newRepo(c postgres.Client, name str) !PgRepo {
	let o = try c.Query("INSERT INTO owners (name, kind) VALUES ({name}, 'user') RETURNING id")
	let owner = o.Rows[0][0].Int()
	let r = try c.Query("INSERT INTO repos (owner_id, name, visibility, quota_bytes) VALUES ({owner}, 'tin', 'public', 1000000000) RETURNING id")
	let dir = "/tmp/tin-test-tinhub-repo-" + name + "-" + seal.Hex(seal.RandomBytes(4))
	let s = try packs.NewDirStore(dir + "/store")
	return PgRepo{Db: c, Store: s, Cache: cache(), Id: r.Rows[0][0].Int(), Dir: dir, Who: 0}
}

fn person(when i64) object.Person {
	return object.Person{Name: "Ada", Email: "ada@example.com", When: when, Zone: 0}
}

// commitIn writes a commit of one file into s.
fn commitIn(s mut store.Mem, name str, body str, parents []object.Id, cid object.ChangeId, when i64) object.Id {
	let blob = s.PutRaw(object.Kind.Blob, body) catch _ {
		object.NoId
	}
	let tree = s.Put(object.Object.Tree([]object.Entry{object.Entry{Mode: object.Mode.File, Name: name, Id: blob}})) catch _ {
		object.NoId
	}
	let c = object.CommitData{Tree: tree, Parents: parents, Change: cid, Author: person(when), Committer: person(when), GitHeaders: []str{}, Signature: "", Message: "{name}\n", Conflicts: []str{}}
	return s.Put(object.Object.Commit(c)) catch _ {
		object.NoId
	}
}

// everything is a commit, its tree and the tree's entries.
fn everything(s mut store.Mem, id object.Id) []object.Id {
	mut out = []object.Id{id}
	let o = s.Get(id) catch _ {
		return out
	}
	match o {
		Commit(c) => {
			out = append(out, c.Tree)
			let t = s.Get(c.Tree) catch _ {
				return out
			}
			match t {
				Tree(es) => {
					for e in es {
						out = append(out, e.Id)
					}
				}
				Commit(_) => {
				}
				Tag(_) => {
				}
				Blob(_) => {
				}
			}
		}
		Tree(_) => {
		}
		Tag(_) => {
		}
		Blob(_) => {
		}
	}
	return out
}

fn stagePack(r mut PgRepo, s mut store.Mem, ids []object.Id) !transport.Staged {
	let p = try packfile.Write(mut s, ids, r.TempDir())
	return try r.Stage(p.Path)
}

// TestContract is tit's Repo contract (products/tit/transport/repo_test.tin) on a PgRepo.
fn TestContract(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	mut r = newRepo(got, "ada") catch err {
		t.Error("repo: {err}")
		return
	}
	mut client = store.NewMem()
	let cid = object.NewChangeId()
	let c1 = commitIn(mut client, "a.txt", "one\n", []object.Id{}, cid, 1700000000)
	let st = stagePack(mut r, mut client, everything(mut client, c1)) catch e {
		t.Error("stage: {e}")
		return
	}
	let before = r.Objects() catch e {
		t.Error("objects: {e}")
		return
	}
	t.True("a staged pack is not read", !before.Has(c1))
	let main = transport.RefUpdate{Name: "refs/heads/main", Old: "", New: c1.Hex()}
	let v1 = transport.ChangeUpdate{Change: cid.Letters(), Replaces: "", Commit: c1.Hex()}
	let when = 1700000000123456000
	let n = r.Commit(transport.Update{Who: "ada@example.com", Command: "push", Changes: []transport.ChangeUpdate{v1}, Refs: []transport.RefUpdate{main}, Pack: st.Name, Time: when}) catch e {
		t.Error("commit: {e}")
		return
	}
	crucible.Equal(mut t, "the first operation", n, 1)
	let after = r.Objects() catch e {
		t.Error("objects: {e}")
		return
	}
	t.True("the committed pack is read", after.Has(c1))
	let ref = r.Ref("refs/heads/main") catch _ {
		nil
	}
	t.True("main moved", ref != nil && change.TargetText(ref.Target) == c1.Hex())
	let newest = r.Newest(cid) catch _ {
		nil
	}
	t.True("the version", newest != nil && newest.Commit() == c1 && newest.Time == when && newest.Op == 1)
	let ev = got.Query("SELECT kind, payload->>'who', jsonb_array_length(payload->'refs') FROM events WHERE repo_id = {r.Id}") catch e {
		t.Error("events: {e}")
		return
	}
	t.True("one push event in the push's transaction", len(ev.Rows) == 1 && ev.Rows[0][0].Text() == "push" && ev.Rows[0][1].Text() == "ada@example.com" && ev.Rows[0][2].Int() == 1)
	// a stale ref and a stale version are each refused, and nothing changes
	let c2 = commitIn(mut client, "a.txt", "two\n", []object.Id{c1}, cid, 1700000100)
	let st2 = stagePack(mut r, mut client, everything(mut client, c2)) catch e {
		t.Error("stage 2: {e}")
		return
	}
	let (_, rerr) = r.Commit(transport.Update{Who: "", Command: "push", Changes: []transport.ChangeUpdate{}, Refs: []transport.RefUpdate{transport.RefUpdate{Name: "refs/heads/main", Old: "", New: c2.Hex()}}, Pack: st2.Name, Time: 6})
	t.True("a stale ref: {rerr}", rerr != nil && twine.Contains(fault.Message(rerr), "RefChanged"))
	let (_, verr) = r.Commit(transport.Update{Who: "", Command: "push", Changes: []transport.ChangeUpdate{transport.ChangeUpdate{Change: cid.Letters(), Replaces: "", Commit: c2.Hex()}}, Refs: []transport.RefUpdate{}, Pack: st2.Name, Time: 6})
	t.True("a stale version: {verr}", verr != nil && twine.Contains(fault.Message(verr), "Moved"))
	let still = r.Objects() catch e {
		t.Error("objects: {e}")
		return
	}
	t.True("the refused pack stays pending", !still.Has(c2))
	let dropped = r.Drop(st2) catch _ {
		false
	}
	t.True("dropped", dropped)
	let again = r.Drop(st2) catch _ {
		true
	}
	t.True("dropped once", !again)
	// a second version of the change, and main deleted
	let st3 = stagePack(mut r, mut client, everything(mut client, c2)) catch e {
		t.Error("stage 3: {e}")
		return
	}
	let n3 = r.Commit(transport.Update{Who: "", Command: "push", Changes: []transport.ChangeUpdate{transport.ChangeUpdate{Change: cid.Letters(), Replaces: c1.Hex(), Commit: c2.Hex()}}, Refs: []transport.RefUpdate{transport.RefUpdate{Name: "refs/heads/main", Old: c1.Hex(), New: ""}}, Pack: st3.Name, Time: when}) catch e {
		t.Error("commit 3: {e}")
		return
	}
	crucible.Equal(mut t, "the second operation", n3, 2)
	let v2 = r.Newest(cid) catch _ {
		nil
	}
	t.True("the newest version", v2 != nil && v2.Commit() == c2 && v2.Op == 2)
	let gone = r.Refs("refs/") catch _ {
		[]change.Ref{change.Ref{Name: "x", Target: change.Target.Commit(c1)}}
	}
	crucible.Equal(mut t, "main deleted", len(gone), 0)
	// retiring the first pack takes it out of sight
	let ps = r.Packs() catch _ {
		[]packfile.Pack{}
	}
	crucible.Equal(mut t, "two live packs", len(ps), 2)
	let retired = r.Retire([]str{st.Name}) catch _ {
		0
	}
	crucible.Equal(mut t, "retired", retired, 1)
	let left = r.Packs() catch _ {
		[]packfile.Pack{}
	}
	crucible.Equal(mut t, "one live pack", len(left), 1)
	quarry.RemoveAll(r.Dir) catch _ {
	}
}

// TestTwoNodes: two servers (two PgRepos of one repository, as two nodes hold) check the same push against the same
// ref; both pass the unlocked checks, and exactly one moves the ref while the other is refused RefChanged.
fn TestTwoNodes(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	mut a = newRepo(got, "ada") catch err {
		t.Error("repo: {err}")
		return
	}
	mut b = a
	b.Dir = a.Dir + "-b"
	mut client = store.NewMem()
	let c1 = commitIn(mut client, "a.txt", "one\n", []object.Id{}, object.NewChangeId(), 1700000000)
	let c2 = commitIn(mut client, "b.txt", "two\n", []object.Id{}, object.NewChangeId(), 1700000001)
	let sa = stagePack(mut a, mut client, everything(mut client, c1)) catch e {
		t.Error("stage a: {e}")
		return
	}
	let sb = stagePack(mut b, mut client, everything(mut client, c2)) catch e {
		t.Error("stage b: {e}")
		return
	}
	// both read main as missing before either commits
	let ra = a.Ref("refs/heads/main") catch _ {
		nil
	}
	let rb = b.Ref("refs/heads/main") catch _ {
		nil
	}
	t.True("both see no main", ra == nil && rb == nil)
	let (_, ea) = a.Commit(transport.Update{Who: "a", Command: "push", Changes: []transport.ChangeUpdate{}, Refs: []transport.RefUpdate{transport.RefUpdate{Name: "refs/heads/main", Old: "", New: c1.Hex()}}, Pack: sa.Name, Time: 1})
	let (_, eb) = b.Commit(transport.Update{Who: "b", Command: "push", Changes: []transport.ChangeUpdate{}, Refs: []transport.RefUpdate{transport.RefUpdate{Name: "refs/heads/main", Old: "", New: c2.Hex()}}, Pack: sb.Name, Time: 1})
	t.True("the first moves main: {ea}", ea == nil)
	t.True("the second is refused: {eb}", eb != nil && twine.Contains(fault.Message(eb), "RefChanged"))
	let now = b.Ref("refs/heads/main") catch _ {
		nil
	}
	t.True("b reads a's push", now != nil && change.TargetText(now.Target) == c1.Hex())
	let pending = b.Drop(sb) catch _ {
		false
	}
	t.True("b's pack was left pending, and is dropped", pending)
	quarry.RemoveAll(a.Dir) catch _ {
	}
	quarry.RemoveAll(b.Dir) catch _ {
	}
}
