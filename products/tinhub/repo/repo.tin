package repo

import "../../tit/change"
import "../../tit/crash"
import "../../tit/object"
import "../../tit/packfile"
import "../../tit/store"
import "../../tit/transport"
import "../events"
import "../packs"
import "fault"
import "postgres"
import "quarry"
import "tinjson"
import "twine"

// PgRepo is tit's transport.Repo for tinhub (design/tinhub.md §7, #1016): refs and change versions are rows, packs are
// in the pack store with their state in the packs table, and a push's commit is one Postgres transaction under the
// repository's advisory lock: refs moved by compare-and-swap, versions added, the pack made live and the push event
// queued, or nothing.
type PgRepo struct {
	Db    postgres.Client
	Store dyn packs.PackStore
	Cache RefCache
	// Id is the repository's id; Dir the node's packs.dir (tmp/ for packs being received, cache/ for packs the store
	// has no local file for); Who the users.id a push is recorded as, 0 for none.
	Id  i64
	Dir str
	Who i64
}

// refused is the fault of a push Commit turns down, as tit's server sends it (transport.ErrRefused, "Code: …").
fn refused(c transport.Code, message str) ! {
	fail fault.Wrap(transport.ErrRefused, transport.CodeName(c) + ": " + message)
}

fn short(text str) str {
	if len(text) == 0 {
		return "nothing"
	}
	if len(text) == 64 {
		return text[0:12]
	}
	return text
}

// refsText reads every ref of the repository, as the cache keeps them.
fn (r PgRepo) refsText() !str {
	let (cached, gen, ok) = r.Cache.get(r.Id)
	if ok {
		return cached
	}
	let rows = try r.Db.Query("SELECT name, target FROM refs WHERE repo_id = {r.Id} ORDER BY name")
	mut text = "v1\n"
	for row in rows.Rows {
		text = text + row[0].Text() + "\t" + row[1].Text() + "\n"
	}
	r.Cache.put(r.Id, gen, text)
	return text
}

// Ref is the ref called name, or nil.
fn (r PgRepo) Ref(name str) !?change.Ref {
	let all = try r.Refs(name)
	for ref in all {
		if ref.Name == name {
			return ref
		}
	}
	return nil
}

// Refs is every ref whose name starts with prefix, in name order.
fn (r PgRepo) Refs(prefix str) ![]change.Ref {
	let text = try r.refsText()
	mut out = []change.Ref{}
	for line in twine.Split(text, "\n") {
		let (name, target, ok) = twine.Cut(line, "\t")
		if !ok || !twine.HasPrefix(name, prefix) {
			continue
		}
		let t = try change.ParseTarget(target)
		out = append(out, change.Ref{Name: name, Target: t})
	}
	return out
}

// Newest is the change's newest version, or nil.
fn (r PgRepo) Newest(c object.ChangeId) !?change.Version {
	let letters = c.Letters()
	let rows = try r.Db.Query("SELECT commit_id, op, (extract(epoch FROM created_at) * 1000000)::bigint FROM changes WHERE repo_id = {r.Id} AND change_id = {letters} ORDER BY version DESC LIMIT 1")
	return try versionOf(rows)
}

fn versionOf(rows postgres.Rows) !?change.Version {
	if len(rows.Rows) == 0 {
		return nil
	}
	let id = try object.ParseId(rows.Rows[0][0].Text())
	return change.NewVersion(rows.Rows[0][1].Int(), id, rows.Rows[0][2].Int() * 1000)
}

// Objects is every live pack's objects.
fn (r mut PgRepo) Objects() !store.Layered {
	let ps = try r.Packs()
	mut layers = []dyn store.ObjectStore{}
	for p in ps {
		layers = append(layers, p)
	}
	return store.NewLayered(layers)
}

// Packs is the live packs, opened from the store's own files, or from copies in <Dir>/cache.
fn (r mut PgRepo) Packs() ![]packfile.Pack {
	let hashes = try packs.Live(r.Db, r.Id)
	mut out = []packfile.Pack{}
	for h in hashes {
		let path = try r.localPack(h)
		mut p = try packfile.Open(path)
		p.Budget(packBudget)
		out = append(out, p)
	}
	return out
}

// packBudget is the memory a pack's reading is fitted to (packfile.Pack.Budget): the API's read budget (16 MiB,
// design/tinhub.md §8), so a log or a compare of a large repository reads its pack entry by entry instead of whole.
const packBudget = 16 << 20

// localPack is a file holding the pack (with its index beside it), fetched into the cache when the store has none.
fn (r mut PgRepo) localPack(hash str) !str {
	let key = packs.PackKey(r.Id, hash, "pack")
	let local = r.Store.Local(key)
	if local != nil && r.Store.Local(packs.PackKey(r.Id, hash, "idx")) != nil {
		return local
	}
	let base = r.Dir + "/cache/" + packs.PackKey(r.Id, hash, "")
	let path = base + "pack"
	if quarry.Exists(path) && quarry.Exists(base + "idx") {
		return path
	}
	try quarry.MkdirAll(r.Dir + "/cache/repos/{r.Id}/packs")
	// the index first: a cached .pack always has its .idx
	_ = try r.Store.Get(packs.PackKey(r.Id, hash, "idx"), base + "idx")
	_ = try r.Store.Get(key, path)
	return path
}

// TempDir is <Dir>/tmp, where a push's pack is received and indexed before Stage.
fn (r PgRepo) TempDir() str {
	let d = r.Dir + "/tmp"
	quarry.MkdirAll(d) catch _ {
	}
	return d
}

// Stage makes the pack at path (with its .idx beside it) pending and moves both into the store.
fn (r mut PgRepo) Stage(pack str) !transport.Staged {
	if !twine.HasSuffix(pack, ".pack") {
		try refused(transport.Code.Internal, "{pack} is not a .pack file")
	}
	let slash = twine.LastIndex(pack, "/")
	mut dir = "."
	if slash >= 0 {
		dir = pack[0:slash]
	}
	let name = pack[slash + 1:len(pack) - 5]
	_ = try packs.Stage(r.Db, mut r.Store, r.Id, dir, name)
	return transport.Staged{Name: name}
}

// Commit makes u current in one transaction under the repository's lock: each change's replaced version and each
// ref's old target checked again, the pack made live, the refs moved, the versions added and the push event queued.
// It returns the operation's number (the repository's push sequence), 0 when u moves nothing.
fn (r mut PgRepo) Commit(u transport.Update) !i64 {
	mut tx = try r.Db.Begin()
	let (op, err) = r.commitIn(mut tx, u)
	if err != nil {
		tx.Rollback() catch _ {
		}
		fail err
	}
	crash.Point()
	try tx.Commit()
	if len(u.Refs) > 0 {
		r.Cache.bump(r.Id)
	}
	return op
}

// CommitTx is Commit inside the caller's transaction, for an update that must commit with other rows (landing a
// change, #1025): it takes the repository's lock in tx and does what Commit does; the caller commits tx and then, when
// u moved refs, calls Moved.
fn (r PgRepo) CommitTx(tx mut postgres.Tx, u transport.Update) !i64 {
	return try r.commitIn(mut tx, u)
}

// Moved bumps the ref cache's generation after a CommitTx that moved refs has committed.
fn (r PgRepo) Moved() {
	r.Cache.bump(r.Id)
}

fn (r PgRepo) commitIn(tx mut postgres.Tx, u transport.Update) !i64 {
	try packs.Lock(mut tx, r.Id)
	try recheck(mut tx, r.Id, u)
	if len(u.Pack) > 0 {
		packs.MakeLive(mut tx, r.Id, u.Pack) catch err {
			try refused(transport.Code.Internal, "no staged pack {u.Pack}: {fault.Message(err)}")
		}
	}
	if len(u.Refs) == 0 && len(u.Changes) == 0 {
		return 0
	}
	let seq = try tx.Query("UPDATE repos SET push_seq = push_seq + 1 WHERE id = {r.Id} RETURNING push_seq")
	if len(seq.Rows) == 0 {
		try refused(transport.Code.NotFound, "no repository {r.Id}")
	}
	let op = seq.Rows[0][0].Int()
	for ru in u.Refs {
		try moveRef(mut tx, r.Id, ru)
	}
	let micros = u.Time / 1000
	let who = r.Who
	for cu in u.Changes {
		let change = cu.Change
		let commit = cu.Commit
		_ = try tx.Exec("INSERT INTO changes (repo_id, change_id, version, commit_id, op, pushed_by, created_at) VALUES ({r.Id}, {change}, (SELECT coalesce(max(version), 0) + 1 FROM changes WHERE repo_id = {r.Id} AND change_id = {change}), {commit}, {op}, nullif({who}, 0), to_timestamp(0) + {micros} * interval '1 microsecond')")
	}
	_ = try events.Enqueue(mut tx, "push", r.Id, pushPayload(op, u))
	return op
}

// moveRef moves one ref by compare-and-swap: an insert when it had no target, a delete when it gets none.
fn moveRef(tx mut postgres.Tx, repo i64, ru transport.RefUpdate) ! {
	try change.CheckName(ru.Name)
	let name = ru.Name
	let old = ru.Old
	let next = ru.New
	mut moved = 0
	if len(old) == 0 && len(next) == 0 {
		return
	}
	if len(old) == 0 {
		let res = try tx.Exec("INSERT INTO refs (repo_id, name, target) VALUES ({repo}, {name}, {next}) ON CONFLICT DO NOTHING")
		moved = res.Affected
	} else if len(next) == 0 {
		let res = try tx.Exec("DELETE FROM refs WHERE repo_id = {repo} AND name = {name} AND target = {old}")
		moved = res.Affected
	} else {
		let res = try tx.Exec("UPDATE refs SET target = {next}, updated_at = now() WHERE repo_id = {repo} AND name = {name} AND target = {old}")
		moved = res.Affected
	}
	if moved != 1 {
		try refused(transport.Code.RefChanged, "{name} moved: it does not hold {short(old)} here")
	}
}

// recheck refuses an update whose changes or refs moved since the server checked it (design/tit.md §16, step 4), as
// tit's own servers do, reading under the lock.
fn recheck(tx mut postgres.Tx, repo i64, u transport.Update) ! {
	for cu in u.Changes {
		let cid = object.ParseChangeId(cu.Change) catch _ {
			try refused(transport.Code.BadRequest, "{cu.Change} is not a change id")
			object.NewChangeId()
		}
		let letters = cid.Letters()
		let rows = try tx.Query("SELECT commit_id, op, 0::bigint FROM changes WHERE repo_id = {repo} AND change_id = {letters} ORDER BY version DESC LIMIT 1")
		mut have = ""
		if len(rows.Rows) > 0 {
			have = rows.Rows[0][0].Text()
		}
		if have != cu.Replaces {
			mut what = "a new change"
			if len(cu.Replaces) > 0 {
				what = "version " + short(cu.Replaces)
			}
			mut there = "none"
			if len(have) > 0 {
				there = short(have)
			}
			try refused(transport.Code.Moved, "{cu.Change} has version {there} here; this push replaces {what}")
		}
	}
	for ru in u.Refs {
		try change.CheckName(ru.Name)
		let name = ru.Name
		let rows = try tx.Query("SELECT target FROM refs WHERE repo_id = {repo} AND name = {name}")
		mut now = ""
		if len(rows.Rows) > 0 {
			now = rows.Rows[0][0].Text()
		}
		if now != ru.Old {
			try refused(transport.Code.RefChanged, "{ru.Name} moved: it holds {short(now)} here, not {short(ru.Old)}")
		}
	}
}

// pushPayload is the push event's payload: the operation, who pushed, and what moved.
fn pushPayload(op i64, u transport.Update) str {
	mut refs = []str{}
	for ru in u.Refs {
		refs = append(refs, "{{" + field("name", ru.Name) + "," + field("old", ru.Old) + "," + field("new", ru.New) + "}}")
	}
	mut changes = []str{}
	for cu in u.Changes {
		changes = append(changes, "{{" + field("change", cu.Change) + "," + field("replaces", cu.Replaces) + "," + field("commit", cu.Commit) + "}}")
	}
	let sep = ","
	return "{{\"op\":{op}," + field("who", u.Who) + "," + field("pack", u.Pack) + ",\"refs\":[" + twine.Join(refs, sep) + "],\"changes\":[" + twine.Join(changes, sep) + "]}}"
}

fn field(name str, value str) str {
	return tinjson.Quote(name) + ":" + tinjson.Quote(value)
}

// Drop deletes a pending pack.
fn (r mut PgRepo) Drop(s transport.Staged) !bool {
	return try packs.Drop(r.Db, mut r.Store, r.Id, s.Name)
}

// Retire retires the named live packs (a repack replaced them).
fn (r PgRepo) Retire(names []str) !i64 {
	return try packs.Retire(r.Db, r.Id, names)
}
