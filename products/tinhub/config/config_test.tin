package config

import "crucible"
import "fault"

// Tests for the configuration (design/tinhub.md §3): the file format, defaults, the environment and the checks.

fn noEnv(name str) (str, bool) {
	return "", false
}

fn TestDefaults(t mut crucible.T) {
	let vals = Resolve(map[str]str{}, noEnv) catch err {
		t.Error("resolve: {err}")
		return
	}
	let c = Build(vals) catch err {
		t.Error("build: {err}")
		return
	}
	crucible.Equal(mut t, "roles", len(c.Roles), 3)
	t.True("has node", c.Has("node") && c.Has("worker") && c.Has("runner"))
	crucible.Equal(mut t, "listen", c.Listen, ":8080")
	crucible.Equal(mut t, "push deadline", c.PushDeadline, 60 * 1000000000)
	crucible.Equal(mut t, "shutdown follows push deadline", c.Shutdown, 70 * 1000000000)
	crucible.Equal(mut t, "push memory", c.PushMemory, 512 * 1024 * 1024)
	crucible.Equal(mut t, "packs store", c.PacksStore, "dir")
	t.True("path style", c.S3PathStyle)
	t.HasFault("secrets required", c.RequireSecrets())
}

fn TestFile(t mut crucible.T) {
	let text = "# tinhub\nroles = node\n\nlisten = \"127.0.0.1:9000\"\npush.deadline = 2m\nrepo.quota = 3gb\nsecrets.nonce = 0123456789abcdef\nsecrets.cookie = fedcba9876543210\n"
	let file = ParseText(text) catch err {
		t.Error("parse: {err}")
		return
	}
	let vals = Resolve(file, noEnv) catch err {
		t.Error("resolve: {err}")
		return
	}
	let c = Build(vals) catch err {
		t.Error("build: {err}")
		return
	}
	t.True("node only", c.Has("node") && !c.Has("worker"))
	crucible.Equal(mut t, "listen unquoted", c.Listen, "127.0.0.1:9000")
	crucible.Equal(mut t, "deadline", c.PushDeadline, 120 * 1000000000)
	crucible.Equal(mut t, "quota", c.RepoQuota, 3 * 1024 * 1024 * 1024)
	t.NoFault("secrets set", c.RequireSecrets())
}

fn TestErrors(t mut crucible.T) {
	let (_, e1) = ParseText("nonsense\n")
	t.True("no equals", e1 != nil && fault.Is(e1, ErrConfig))
	let (_, e2) = ParseText("db.passwd = x\n")
	t.True("unknown key", e2 != nil && fault.Is(e2, ErrConfig))
	mut vals = Resolve(map[str]str{}, noEnv) catch _ {
		map[str]str{}
	}
	vals["roles"] = "node,frontend"
	let (_, e3) = Build(vals)
	t.HasFault("unknown role", e3)
	vals["roles"] = "node"
	vals["packs.store"] = "s3"
	let (_, e4) = Build(vals)
	t.HasFault("s3 needs endpoint", e4)
	vals["packs.store"] = "dir"
	vals["push.deadline"] = "soon"
	let (_, e5) = Build(vals)
	t.HasFault("bad duration", e5)
	vals["push.deadline"] = "1s"
	vals["tls.cert"] = "/c.pem"
	let (_, e6) = Build(vals)
	t.HasFault("cert without key", e6)
}

fn env(name str) (str, bool) {
	if name == "TINHUB_DB_PASSWORD" {
		return "hunter22", true
	}
	if name == "TINHUB_LISTEN" {
		return ":7000", true
	}
	return "", false
}

fn TestEnvironment(t mut crucible.T) {
	crucible.Equal(mut t, "env name", EnvName("db.max_total"), "TINHUB_DB_MAX_TOTAL")
	let file = ParseText("listen = :9000\n") catch _ {
		map[str]str{}
	}
	let vals = Resolve(file, env) catch err {
		t.Error("resolve: {err}")
		return
	}
	crucible.Equal(mut t, "env wins", vals["listen"], ":7000")
	crucible.Equal(mut t, "secret from env", vals["db.password"], "hunter22")
}

fn TestSizes(t mut crucible.T) {
	crucible.Equal(mut t, "bytes", sz("100"), 100)
	crucible.Equal(mut t, "kb", sz("4kb"), 4096)
	crucible.Equal(mut t, "MB upper", sz("16MB"), 16 * 1024 * 1024)
	crucible.Equal(mut t, "tb", sz("1tb"), 1024 * 1024 * 1024 * 1024)
	let (_, e1) = ParseSize("-1kb")
	t.HasFault("negative", e1)
	let (_, e2) = ParseSize("99999999999tb")
	t.HasFault("overflow", e2)
}

fn sz(s str) i64 {
	let n = ParseSize(s) catch _ {
		-1
	}
	return n
}
