package config

import "fault"
import "flume"
import "mint"
import "quarry"
import "tide"
import "twine"

// tinhub's configuration (design/tinhub.md §3): a file of key = value lines, each key overridable by the environment
// (TINHUB_ and the key in upper case, dots as underscores), and a value file:PATH read from that file.

// ErrConfig is the fault of a configuration that cannot be used.
let ErrConfig = fault("tinhub config")

// Config is every setting tinhub reads. Durations are nanoseconds and sizes bytes.
type Config struct {
	Roles       []str
	Listen      str
	TLSCert     str
	TLSKey      str
	PublicURL   str
	DbAddr      str
	DbUser      str
	DbName      str
	DbPassword  secret str
	DbReplica   str
	DbMaxTotal  i64
	RedisAddr   str
	PacksStore  str
	PacksDir    str
	PacksCache  i64
	PacksGrace  i64
	PacksSweep  i64
	S3Endpoint  str
	S3Region    str
	S3Bucket    str
	S3AccessKey str
	S3SecretKey secret str
	S3PathStyle bool
	NonceSecret secret str
	CookieKey   secret str
	PushDeadline i64
	PushMemory  i64
	RepoQuota   i64
	LimitPack   i64
	LimitRefs   i64
	Workers     i64
	WorkerLease i64
	RepackPacks i64
	ApiRate     i64
	SmtpAddr    str
	SmtpFrom    str
	LogLevel    str
	Shutdown    i64
}

// Key is one setting: its name, its default and whether it is a secret.
type Key value struct {
	Name    str
	Default str
	Secret  bool
}

// Keys is every key a configuration may set, in the order design/tinhub.md §3 lists them.
fn Keys() []Key {
	return []Key{
		Key{Name: "roles", Default: "node,worker,runner", Secret: false},
		Key{Name: "listen", Default: ":8080", Secret: false},
		Key{Name: "tls.cert", Default: "", Secret: false},
		Key{Name: "tls.key", Default: "", Secret: false},
		Key{Name: "public_url", Default: "http://localhost:8080", Secret: false},
		Key{Name: "db.addr", Default: "127.0.0.1:5432", Secret: false},
		Key{Name: "db.user", Default: "tinhub", Secret: false},
		Key{Name: "db.name", Default: "tinhub", Secret: false},
		Key{Name: "db.password", Default: "", Secret: true},
		Key{Name: "db.replica", Default: "", Secret: false},
		Key{Name: "db.max_total", Default: "16", Secret: false},
		Key{Name: "redis.addr", Default: "", Secret: false},
		Key{Name: "packs.store", Default: "dir", Secret: false},
		Key{Name: "packs.dir", Default: "/var/lib/tinhub", Secret: false},
		Key{Name: "packs.cache", Default: "10gb", Secret: false},
		Key{Name: "packs.grace", Default: "1h", Secret: false},
		Key{Name: "packs.sweep", Default: "10m", Secret: false},
		Key{Name: "s3.endpoint", Default: "", Secret: false},
		Key{Name: "s3.region", Default: "auto", Secret: false},
		Key{Name: "s3.bucket", Default: "", Secret: false},
		Key{Name: "s3.access_key", Default: "", Secret: false},
		Key{Name: "s3.secret_key", Default: "", Secret: true},
		Key{Name: "s3.path_style", Default: "true", Secret: false},
		Key{Name: "secrets.nonce", Default: "", Secret: true},
		Key{Name: "secrets.cookie", Default: "", Secret: true},
		Key{Name: "push.deadline", Default: "60s", Secret: false},
		Key{Name: "push.memory", Default: "512mb", Secret: false},
		Key{Name: "repo.quota", Default: "10gb", Secret: false},
		Key{Name: "limits.pack", Default: "2gb", Secret: false},
		Key{Name: "limits.refs", Default: "10000", Secret: false},
		Key{Name: "workers.concurrency", Default: "4", Secret: false},
		Key{Name: "workers.lease", Default: "5m", Secret: false},
		Key{Name: "repack.packs", Default: "16", Secret: false},
		Key{Name: "api.rate", Default: "600", Secret: false},
		Key{Name: "smtp.addr", Default: "", Secret: false},
		Key{Name: "smtp.from", Default: "", Secret: false},
		Key{Name: "log.level", Default: "info", Secret: false},
		Key{Name: "shutdown.deadline", Default: "", Secret: false},
	}
}

// EnvName is the environment variable that sets key: TINHUB_ and the key in upper case, dots as underscores.
fn EnvName(key str) str {
	return "TINHUB_" + twine.ToUpper(twine.ReplaceAll(key, ".", "_"))
}

// known reports whether key is one of Keys.
fn known(key str) bool {
	for k in Keys() {
		if k.Name == key {
			return true
		}
	}
	return false
}

// ParseText reads the key = value lines of a configuration file into a map; an unknown key or a line without "=" is a
// fault naming its line.
fn ParseText(text str) !map[str]str {
	mut out = map[str]str{}
	mut n = 0
	for line in twine.Split(text, "\n") {
		n += 1
		let t = twine.TrimSpace(line)
		if len(t) == 0 || t[0] == '#' {
			continue
		}
		let (k, v, ok) = twine.Cut(t, "=")
		if !ok {
			fail fault.Wrap(ErrConfig, "line {n}: want key = value")
		}
		let key = twine.TrimSpace(k)
		if !known(key) {
			fail fault.Wrap(ErrConfig, "line {n}: unknown key {key}")
		}
		mut val = twine.TrimSpace(v)
		if len(val) >= 2 && val[0] == '"' && val[len(val) - 1] == '"' {
			val = val[1:len(val) - 1]
		}
		out[key] = val
	}
	return out
}

// Resolve is the value of every key: the file's value, else the default, then the environment's when it is set, and a
// file:PATH value replaced by that file's text without its trailing newline.
fn Resolve(file map[str]str, env fn(str) (str, bool)) !map[str]str {
	mut out = map[str]str{}
	for k in Keys() {
		mut v = k.Default
		let (fv, inFile) = file[k.Name]
		if inFile {
			v = fv
		}
		let (ev, inEnv) = env(EnvName(k.Name))
		if inEnv {
			v = ev
		}
		if twine.HasPrefix(v, "file:") {
			let path = v[5:]
			let text = quarry.ReadFileBound(path, 1024 * 1024) catch err {
				fail fault.Wrap(ErrConfig, "{k.Name}: reading {path}: {fault.Message(err)}")
			}
			v = twine.TrimRight(text, "\r\n")
		}
		out[k.Name] = v
	}
	return out
}

// ParseSize reads a size: a number of bytes, or one with a unit kb, mb, gb or tb (powers of 1024).
fn ParseSize(s str) !i64 {
	let t = twine.ToLower(twine.TrimSpace(s))
	mut mult = 1
	mut num = t
	if twine.HasSuffix(t, "kb") {
		mult = 1024
		num = t[0:len(t) - 2]
	} else if twine.HasSuffix(t, "mb") {
		mult = 1024 * 1024
		num = t[0:len(t) - 2]
	} else if twine.HasSuffix(t, "gb") {
		mult = 1024 * 1024 * 1024
		num = t[0:len(t) - 2]
	} else if twine.HasSuffix(t, "tb") {
		mult = 1024 * 1024 * 1024 * 1024
		num = t[0:len(t) - 2]
	} else if twine.HasSuffix(t, "b") {
		num = t[0:len(t) - 1]
	}
	let n = mint.Atoi(num) catch _ {
		fail fault.Wrap(ErrConfig, "{s} is not a size")
		0
	}
	if n < 0 || n > mint.MaxI64 / mult {
		fail fault.Wrap(ErrConfig, "{s} is out of range")
	}
	return n * mult
}

fn duration(vals map[str]str, key str) !i64 {
	let d = tide.ParseDuration(vals[key]) catch _ {
		fail fault.Wrap(ErrConfig, "{key}: {vals[key]} is not a duration")
		0
	}
	if d < 0 {
		fail fault.Wrap(ErrConfig, "{key}: a duration cannot be negative")
	}
	return d
}

fn size(vals map[str]str, key str) !i64 {
	return try ParseSize(vals[key]) wrap "{key}"
}

fn count(vals map[str]str, key str) !i64 {
	let n = mint.Atoi(vals[key]) catch _ {
		fail fault.Wrap(ErrConfig, "{key}: {vals[key]} is not a number")
		0
	}
	if n < 0 {
		fail fault.Wrap(ErrConfig, "{key}: cannot be negative")
	}
	return n
}

fn flag(vals map[str]str, key str) !bool {
	let b = mint.ParseBool(vals[key]) catch _ {
		fail fault.Wrap(ErrConfig, "{key}: {vals[key]} is not true or false")
		false
	}
	return b
}

// Build makes a Config from resolved values and checks it.
fn Build(vals map[str]str) !Config {
	mut roles = []str{}
	for r in twine.Split(vals["roles"], ",") {
		let role = twine.TrimSpace(r)
		if len(role) == 0 {
			continue
		}
		if role != "node" && role != "worker" && role != "runner" {
			fail fault.Wrap(ErrConfig, "roles: unknown role {role} (node, worker, runner)")
		}
		roles = append(roles, role)
	}
	if len(roles) == 0 {
		fail fault.Wrap(ErrConfig, "roles: none given")
	}
	let store = vals["packs.store"]
	if store != "dir" && store != "s3" {
		fail fault.Wrap(ErrConfig, "packs.store: {store} is not dir or s3")
	}
	if store == "s3" && (len(vals["s3.endpoint"]) == 0 || len(vals["s3.bucket"]) == 0) {
		fail fault.Wrap(ErrConfig, "packs.store = s3 needs s3.endpoint and s3.bucket")
	}
	if (len(vals["tls.cert"]) == 0) != (len(vals["tls.key"]) == 0) {
		fail fault.Wrap(ErrConfig, "tls.cert and tls.key go together")
	}
	let level = vals["log.level"]
	if level != "debug" && level != "info" && level != "warn" && level != "error" {
		fail fault.Wrap(ErrConfig, "log.level: {level} is not debug, info, warn or error")
	}
	let pushDeadline = try duration(vals, "push.deadline")
	mut shutdown = pushDeadline + 10 * tide.Second
	if len(vals["shutdown.deadline"]) > 0 {
		shutdown = try duration(vals, "shutdown.deadline")
	}
	let dbMaxTotalV = try count(vals, "db.max_total")
	let packsCacheV = try size(vals, "packs.cache")
	let packsGraceV = try duration(vals, "packs.grace")
	let packsSweepV = try duration(vals, "packs.sweep")
	let s3PathStyleV = try flag(vals, "s3.path_style")
	let pushMemoryV = try size(vals, "push.memory")
	let repoQuotaV = try size(vals, "repo.quota")
	let limitPackV = try size(vals, "limits.pack")
	let limitRefsV = try count(vals, "limits.refs")
	let workersV = try count(vals, "workers.concurrency")
	let workerLeaseV = try duration(vals, "workers.lease")
	let repackPacksV = try count(vals, "repack.packs")
	let apiRateV = try count(vals, "api.rate")
	return Config{
		Roles: roles,
		Listen: vals["listen"],
		TLSCert: vals["tls.cert"],
		TLSKey: vals["tls.key"],
		PublicURL: twine.TrimRight(vals["public_url"], "/"),
		DbAddr: vals["db.addr"],
		DbUser: vals["db.user"],
		DbName: vals["db.name"],
		DbPassword: vals["db.password"],
		DbReplica: vals["db.replica"],
		DbMaxTotal: dbMaxTotalV,
		RedisAddr: vals["redis.addr"],
		PacksStore: store,
		PacksDir: twine.TrimRight(vals["packs.dir"], "/"),
		PacksCache: packsCacheV,
		PacksGrace: packsGraceV,
		PacksSweep: packsSweepV,
		S3Endpoint: vals["s3.endpoint"],
		S3Region: vals["s3.region"],
		S3Bucket: vals["s3.bucket"],
		S3AccessKey: vals["s3.access_key"],
		S3SecretKey: vals["s3.secret_key"],
		S3PathStyle: s3PathStyleV,
		NonceSecret: vals["secrets.nonce"],
		CookieKey: vals["secrets.cookie"],
		PushDeadline: pushDeadline,
		PushMemory: pushMemoryV,
		RepoQuota: repoQuotaV,
		LimitPack: limitPackV,
		LimitRefs: limitRefsV,
		Workers: workersV,
		WorkerLease: workerLeaseV,
		RepackPacks: repackPacksV,
		ApiRate: apiRateV,
		SmtpAddr: vals["smtp.addr"],
		SmtpFrom: vals["smtp.from"],
		LogLevel: level,
		Shutdown: shutdown,
	}
}

// Has reports whether the configuration runs role.
fn (c Config) Has(role str) bool {
	for r in c.Roles {
		if r == role {
			return true
		}
	}
	return false
}

// Path is the configuration file to read: flag (from --config) when set, else $TINHUB_CONFIG, else
// /etc/tinhub/tinhub.conf when it exists, else "" (defaults and the environment only).
fn Path(flag str) str {
	if len(flag) > 0 {
		return flag
	}
	let env = quarry.Getenv("TINHUB_CONFIG")
	if len(env) > 0 {
		return env
	}
	if quarry.Exists("/etc/tinhub/tinhub.conf") {
		return "/etc/tinhub/tinhub.conf"
	}
	return ""
}

// Load reads the configuration at path ("" for none) and the process's environment.
fn Load(path str) !Config {
	mut file = map[str]str{}
	if len(path) > 0 {
		let text = flume.ReadFile(path) catch err {
			fail fault.Wrap(ErrConfig, "reading {path}: {fault.Message(err)}")
			""
		}
		file = try ParseText(text) wrap "{path}"
	}
	let vals = try Resolve(file, quarry.LookupEnv)
	return try Build(vals)
}

// RequireSecrets checks the secrets a node needs are set.
fn (c Config) RequireSecrets() ! {
	if len(reveal(c.NonceSecret)) < 16 {
		fail fault.Wrap(ErrConfig, "secrets.nonce must be set (at least 16 characters)")
	}
	if len(reveal(c.CookieKey)) < 16 {
		fail fault.Wrap(ErrConfig, "secrets.cookie must be set (at least 16 characters)")
	}
}
