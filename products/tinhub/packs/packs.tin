package packs

import "fault"
import "postgres"
import "quarry"
import "seal"
import "twine"

// The pack store (design/tinhub.md §7, #1011): where a repository's packs and capsules are kept, by key, written once
// and never modified. What a pack is (pending, live or retired) is its row in the packs table, never its file: a
// reader lists live packs from Postgres, and the sweep deletes the files of rows it is done with.

// ErrBadKey is the fault of a key that is not a store key.
let ErrBadKey = fault("not a pack store key")

// PackStore is where packs and capsules are kept. Put takes the file at path: once it returns, the file is the
// store's, and path is gone. Put and Get return the bytes they stored or wrote (a method returning a bare ! must be a
// shape's last, #1072).
shape PackStore {
	mut Put(key str, path str) !i64
	mut Get(key str, path str) !i64
	mut ReadAt(key str, off i64, buf mut []u8) !i64
	mut Size(key str) !?i64
	mut Delete(key str) !bool
	mut List(prefix str) ![]str
	Local(key str) ?str
}

// PackKey is the key of a repository's pack file: ext is "pack" or "idx".
fn PackKey(repo i64, hash str, ext str) str {
	return "repos/{repo}/packs/{hash}.{ext}"
}

// CapsuleKey is the key of a replay capsule.
fn CapsuleKey(repo i64, id str) str {
	return "repos/{repo}/capsules/{id}.tcap"
}

// CheckKey refuses a key that could reach outside the store: empty parts, dot parts, a leading or trailing slash, or
// a byte outside [A-Za-z0-9._-/].
fn CheckKey(key str) ! {
	if len(key) == 0 || len(key) > 512 || key[0] == '/' || key[len(key) - 1] == '/' {
		fail fault.Wrap(ErrBadKey, key)
	}
	for c in key {
		let ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '.' || c == '_' || c == '-' || c == '/'
		if !ok {
			fail fault.Wrap(ErrBadKey, key)
		}
	}
	for part in twine.Split(key, "/") {
		if len(part) == 0 || part[0] == '.' {
			fail fault.Wrap(ErrBadKey, key)
		}
	}
}

// Lock takes the repository's lock until tx ends: a push's commit, a staging and a sweep of one repository never
// interleave. Repository locks are negative advisory keys; the migration lock is positive.
fn Lock(tx mut postgres.Tx, repo i64) ! {
	_ = try tx.Query("SELECT pg_advisory_xact_lock(-{repo}::bigint)")
}

// CopyResult is what Copy did: the keys it copied, and those the destination had already (the same size).
type CopyResult struct {
	Copied  i64
	Skipped i64
	Bytes   i64
}

// Copy copies every object under prefix from one store to another (tinhub packs copy: phase 1's directory into a
// bucket), through files in scratch. A key the destination holds already, at the same size, is skipped (packs never
// change), so copying again after a switch picks up only what arrived since.
fn Copy[A PackStore, B PackStore](from mut A, to mut B, prefix str, scratch str) !CopyResult {
	try quarry.MkdirAll(scratch)
	mut out = CopyResult{Copied: 0, Skipped: 0, Bytes: 0}
	let keys = try from.List(prefix)
	for key in keys {
		let have = try to.Size(key)
		let want = try from.Size(key)
		if have != nil && want != nil && have == want {
			out.Skipped += 1
			continue
		}
		let tmp = scratch + "/copy-" + seal.Hex(seal.RandomBytes(8))
		_ = try from.Get(key, tmp)
		let n = try to.Put(key, tmp)
		out.Copied += 1
		out.Bytes += n
	}
	return out
}
