package packs

import "../../tit/crash"
import "fault"
import "postgres"
import "quarry"
import "twine"

// The states of a pack (design/tinhub.md §7): pending from before its first byte reaches the store until its push
// commits or is dropped, live from inside the push transaction, retired once a repack replaces it. Readers list live
// packs only; the sweep deletes the files of pending packs a crashed push left and of packs retired longer than the
// grace period, and only then their rows, all under the repository's lock.

// ErrNoPack is the fault of a commit whose staged pack is not pending or live.
let ErrNoPack = fault("no staged pack")

// Stage records the pack at <dir>/<hash>.pack (with its .idx beside it) as pending and moves both into the store:
// the row first, then the index, then the pack. A pack the repository already has live is not stored again. It
// returns false when the pack was live already.
fn Stage[S PackStore](c postgres.Client, s mut S, repo i64, dir str, hash str) !bool {
	let pack = dir + "/" + hash + ".pack"
	let idx = dir + "/" + hash + ".idx"
	let size = try quarry.Size(pack)
	mut tx = try c.Begin()
	let (fresh, err) = stageRow(mut tx, repo, hash, size)
	if err != nil {
		tx.Rollback() catch _ {
		}
		fail err
	}
	try tx.Commit()
	if !fresh {
		quarry.Remove(pack) catch _ {
		}
		quarry.Remove(idx) catch _ {
		}
		return false
	}
	crash.Point()
	_ = try s.Put(PackKey(repo, hash, "idx"), idx)
	crash.Point()
	_ = try s.Put(PackKey(repo, hash, "pack"), pack)
	return true
}

fn stageRow(tx mut postgres.Tx, repo i64, hash str, size i64) !bool {
	try Lock(mut tx, repo)
	let rows = try tx.Query("SELECT state FROM packs WHERE repo_id = {repo} AND hash = {hash}")
	if len(rows.Rows) == 0 {
		_ = try tx.Exec("INSERT INTO packs (repo_id, hash, state, size_bytes) VALUES ({repo}, {hash}, 'pending', {size})")
		return true
	}
	let state = rows.Rows[0][0].Text()
	if state == "live" {
		return false
	}
	// pending (another push of the same pack) or retired (a repack replaced it, and now it is pushed again): pending,
	// and its files written again, so the sweep never deletes a file this push needs
	_ = try tx.Exec("UPDATE packs SET state = 'pending', staged_at = now(), live_at = NULL, retired_at = NULL, size_bytes = {size} WHERE repo_id = {repo} AND hash = {hash}")
	return true
}

// MakeLive makes a pending pack live inside a push's transaction (the repository's lock held) and adds its size to
// the repository's. A pack already live is left as it is; one neither pending nor live is ErrNoPack.
fn MakeLive(tx mut postgres.Tx, repo i64, hash str) ! {
	let rows = try tx.Query("UPDATE packs SET state = 'live', live_at = now() WHERE repo_id = {repo} AND hash = {hash} AND state = 'pending' RETURNING size_bytes")
	if len(rows.Rows) == 1 {
		let size = rows.Rows[0][0].Int()
		_ = try tx.Exec("UPDATE repos SET size_bytes = size_bytes + {size} WHERE id = {repo}")
		return
	}
	let have = try tx.Query("SELECT 1 FROM packs WHERE repo_id = {repo} AND hash = {hash} AND state = 'live'")
	if len(have.Rows) == 0 {
		fail fault.Wrap(ErrNoPack, hash)
	}
}

// Live is the hashes of the repository's live packs, newest first.
fn Live(c postgres.Client, repo i64) ![]str {
	let rows = try c.Query("SELECT hash FROM packs WHERE repo_id = {repo} AND state = 'live' ORDER BY live_at DESC, hash")
	mut out = []str{}
	for r in rows.Rows {
		out = append(out, r[0].Text())
	}
	return out
}

// Retire retires the named live packs: readers stop listing them, and those reading them already keep their files
// for the grace period. It returns how many it retired.
fn Retire(c postgres.Client, repo i64, hashes []str) !i64 {
	mut tx = try c.Begin()
	let (n, err) = retireIn(mut tx, repo, hashes)
	if err != nil {
		tx.Rollback() catch _ {
		}
		fail err
	}
	crash.Point()
	try tx.Commit()
	return n
}

fn retireIn(tx mut postgres.Tx, repo i64, hashes []str) !i64 {
	try Lock(mut tx, repo)
	let list = twine.Join(hashes, ",")
	let rows = try tx.Query("UPDATE packs SET state = 'retired', retired_at = now() WHERE repo_id = {repo} AND state = 'live' AND hash = ANY(string_to_array({list}, ',')) RETURNING size_bytes")
	mut total = 0
	for r in rows.Rows {
		total += r[0].Int()
	}
	if total > 0 {
		_ = try tx.Exec("UPDATE repos SET size_bytes = greatest(size_bytes - {total}, 0) WHERE id = {repo}")
	}
	return len(rows.Rows)
}

// Drop deletes a pending pack (a push that failed after staging it): its files, then its row. A pack that became
// live meanwhile (another push of the same pack) is kept. It returns whether it dropped one.
fn Drop[S PackStore](c postgres.Client, s mut S, repo i64, hash str) !bool {
	mut tx = try c.Begin()
	let (n, err) = dropIn(mut tx, mut s, repo, hash, rule{sweep: false, pendingSecs: 0, graceSecs: 0})
	if err != nil {
		tx.Rollback() catch _ {
		}
		fail err
	}
	try tx.Commit()
	return n > 0
}

// dropIn deletes, under the lock, the files and then the row of the pack when its row matches the rule.
fn dropIn[S PackStore](tx mut postgres.Tx, s mut S, repo i64, hash str, r rule) !i64 {
	try Lock(mut tx, repo)
	let rows = try tx.Query("SELECT state, coalesce(extract(epoch FROM now() - staged_at), 0)::bigint, coalesce(extract(epoch FROM now() - retired_at), 0)::bigint FROM packs WHERE repo_id = {repo} AND hash = {hash}")
	if len(rows.Rows) == 0 || !r.matches(rows.Rows[0][0].Text(), rows.Rows[0][1].Int(), rows.Rows[0][2].Int()) {
		return 0
	}
	crash.Point()
	_ = try s.Delete(PackKey(repo, hash, "pack"))
	crash.Point()
	_ = try s.Delete(PackKey(repo, hash, "idx"))
	_ = try tx.Exec("DELETE FROM packs WHERE repo_id = {repo} AND hash = {hash}")
	return 1
}

// rule is which packs dropIn deletes: pending ones (Drop), or pending ones staged pendingSecs ago or more and
// retired ones retired graceSecs ago or more (Sweep).
type rule struct {
	sweep       bool
	pendingSecs i64
	graceSecs   i64
}

fn (r rule) matches(state str, stagedAge i64, retiredAge i64) bool {
	if !r.sweep {
		return state == "pending"
	}
	return (state == "pending" && stagedAge >= r.pendingSecs) || (state == "retired" && retiredAge >= r.graceSecs)
}

// Sweep deletes, in every repository, the pending packs staged pending ns ago or more (a push that crashed or never
// came back) and the packs retired grace ns ago or more: files first, then rows, each pack under its repository's
// lock. It returns how many packs it deleted.
fn Sweep[S PackStore](c postgres.Client, s mut S, pending i64, grace i64) !i64 {
	let ps = pending / 1000000000
	let gs = grace / 1000000000
	let rows = try c.Query("SELECT repo_id, hash FROM packs WHERE (state = 'pending' AND staged_at <= now() - make_interval(secs => {ps})) OR (state = 'retired' AND retired_at <= now() - make_interval(secs => {gs})) ORDER BY repo_id, hash LIMIT 1000")
	mut n = 0
	for r in rows.Rows {
		let repo = r[0].Int()
		let hash = r[1].Text()
		mut tx = try c.Begin()
		let (k, err) = dropIn(mut tx, mut s, repo, hash, rule{sweep: true, pendingSecs: ps, graceSecs: gs})
		if err != nil {
			tx.Rollback() catch _ {
			}
			fail err
		}
		try tx.Commit()
		n += k
	}
	return n
}

// SweepTemp deletes the files directly in dir modified ageSecs or more before nowSecs: packs a push was receiving
// when its process died.
fn SweepTemp(dir str, ageSecs i64, nowSecs i64) !i64 {
	if !quarry.IsDir(dir) {
		return 0
	}
	let names = try quarry.ReadDir(dir)
	mut n = 0
	for name in names {
		let p = dir + "/" + name
		if quarry.IsDir(p) {
			continue
		}
		let (t, err) = quarry.ModTime(p)
		if err == nil && nowSecs - t >= ageSecs {
			quarry.Remove(p) catch _ {
			}
			n += 1
		}
	}
	return n
}
