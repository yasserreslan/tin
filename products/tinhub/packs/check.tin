package packs

import "fault"
import "quarry"
import "seal"

// ErrContract is the fault of a store that breaks the PackStore contract.
let ErrContract = fault("pack store contract")

// Check runs the PackStore contract against s, using scratch (a directory of its own) for files: every store
// (the directory store, the S3 store of #1015) passes it. Keys are under prefix, which it leaves empty.
fn Check[S PackStore](s mut S, scratch str, prefix str) ! {
	try quarry.MkdirAll(scratch)
	let body = "TITPACK\x00" + seal.Hex(seal.RandomBytes(600))
	let key = prefix + "/a/one.pack"
	let missing = try s.Size(key)
	if missing != nil {
		fail fault.Wrap(ErrContract, "Size of a missing key is not nil")
	}
	let src = scratch + "/put"
	try quarry.WriteFile(src, body)
	_ = try s.Put(key, src)
	if quarry.Exists(src) {
		fail fault.Wrap(ErrContract, "Put left its file behind")
	}
	let size = try s.Size(key)
	if size == nil || size != len(body) {
		fail fault.Wrap(ErrContract, "Size after Put is not the file's")
	}
	let out = scratch + "/got"
	_ = try s.Get(key, out)
	let got = try quarry.ReadFile(out)
	if got != body {
		fail fault.Wrap(ErrContract, "Get is not what Put stored")
	}
	mut buf = make([]u8, 10)
	let n = try s.ReadAt(key, 8, mut buf)
	if n != 10 || str(buf) != body[8:18] {
		fail fault.Wrap(ErrContract, "ReadAt in the middle")
	}
	mut tail = make([]u8, 100)
	let m = try s.ReadAt(key, len(body) - 4, mut tail)
	if m != 4 || str(tail[0:4]) != body[len(body) - 4:] {
		fail fault.Wrap(ErrContract, "ReadAt at the end reads what is there")
	}
	try quarry.WriteFile(src, "two")
	_ = try s.Put(prefix + "/a/two.idx", src)
	try quarry.WriteFile(src, "three")
	_ = try s.Put(prefix + "/b/three.pack", src)
	let all = try s.List(prefix + "/")
	if len(all) != 3 || all[0] != key || all[1] != prefix + "/a/two.idx" || all[2] != prefix + "/b/three.pack" {
		fail fault.Wrap(ErrContract, "List of every key is not the three, in order")
	}
	let some = try s.List(prefix + "/a/t")
	if len(some) != 1 || some[0] != prefix + "/a/two.idx" {
		fail fault.Wrap(ErrContract, "List of a prefix")
	}
	let local = s.Local(key)
	if local != nil {
		let lb = try quarry.ReadFile(local)
		if lb != body {
			fail fault.Wrap(ErrContract, "Local is not a file of the key's bytes")
		}
	}
	let (_, bad) = s.Size(prefix + "/../escape")
	if bad == nil || !fault.Is(bad, ErrBadKey) {
		fail fault.Wrap(ErrContract, "a key with .. is not refused")
	}
	for k in all {
		let gone = try s.Delete(k)
		if !gone {
			fail fault.Wrap(ErrContract, "Delete of a stored key is false")
		}
	}
	let again = try s.Delete(key)
	if again {
		fail fault.Wrap(ErrContract, "Delete of a missing key is true")
	}
	let left = try s.List(prefix + "/")
	if len(left) != 0 {
		fail fault.Wrap(ErrContract, "keys left after Delete")
	}
	quarry.RemoveAll(scratch) catch _ {
	}
}
