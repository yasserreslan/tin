package packs

import "../db"
import "crucible"
import "fault"
import "postgres"
import "quarry"
import "seal"

// The states of packs against Postgres (TINHUB_TEST_DB): a property test runs random stages, commits, retires,
// drops and sweeps against a model, and checks after every step that the rows, the files and the repository's size
// agree with it.

fn testDb(t mut crucible.T) ?postgres.Client {
	let (o, ok) = db.TestOptions()
	if !ok {
		t.Log("TINHUB_TEST_DB is not set: skipped")
		return nil
	}
	let c = db.Open(o)
	db.ResetForTests(c) catch err {
		t.Error("reset: {err}")
		return nil
	}
	_ = db.Migrate(c) catch err {
		t.Error("migrate: {err}")
		return nil
	}
	return c
}

// testRepo makes an owner and a repository and returns the repository's id.
fn testRepo(c postgres.Client) !i64 {
	let o = try c.Query("INSERT INTO owners (name, kind) VALUES ('ada', 'user') RETURNING id")
	let owner = o.Rows[0][0].Int()
	let r = try c.Query("INSERT INTO repos (owner_id, name, visibility, quota_bytes) VALUES ({owner}, 'tin', 'public', 1000000000) RETURNING id")
	return r.Rows[0][0].Int()
}

fn roll(n i64) i64 {
	let b = seal.RandomBytes(2)
	return ((i64(b[0]) << 8) | i64(b[1])) % n
}

// commitPack makes a pack live as a push transaction does.
fn commitPack(c postgres.Client, repo i64, hash str) ! {
	mut tx = try c.Begin()
	try Lock(mut tx, repo)
	let err = MakeLive(mut tx, repo, hash)
	if err != nil {
		tx.Rollback() catch _ {
		}
		fail err
	}
	try tx.Commit()
}

fn TestPackStates(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	let c = got
	let repo = testRepo(c) catch err {
		t.Error("repo: {err}")
		return
	}
	let root = scratch("states")
	let tmp = root + "/tmp"
	quarry.MkdirAll(tmp) catch _ {
	}
	mut s = NewDirStore(root + "/store") catch err {
		t.Error("store: {err}")
		return
	}
	mut hashes = []str{}
	mut sizes = []i64{}
	mut model = []str{}
	for i in 0..4 {
		hashes = append(hashes, seal.Hex(seal.RandomBytes(32)))
		sizes = append(sizes, 100 + 10 * i)
		model = append(model, "none")
	}
	for step in 0..300 {
		let i = roll(4)
		let h = hashes[i]
		let op = roll(5)
		mut what = ""
		if op == 0 {
			what = "stage"
			quarry.WriteFile(tmp + "/" + h + ".pack", seal.Hex(seal.RandomBytes(sizes[i] / 2))) catch _ {
			}
			quarry.WriteFile(tmp + "/" + h + ".idx", "idx") catch _ {
			}
			let fresh = Stage(c, mut s, repo, tmp, h) catch err {
				t.Error("step {step}: stage: {err}")
				return
			}
			t.True("step {step}: stage of a live pack is not fresh", fresh == (model[i] != "live"))
			if model[i] != "live" {
				model[i] = "pending"
			}
		} else if op == 1 {
			what = "commit"
			let err = commitPack(c, repo, h)
			if model[i] == "pending" || model[i] == "live" {
				t.True("step {step}: commit of a {model[i]} pack: {err}", err == nil)
				model[i] = "live"
			} else {
				t.True("step {step}: commit of a {model[i]} pack is refused", err != nil && fault.Is(err, ErrNoPack))
			}
		} else if op == 2 {
			what = "retire"
			let n = Retire(c, repo, []str{h}) catch err {
				t.Error("step {step}: retire: {err}")
				return
			}
			mut want = 0
			if model[i] == "live" {
				want = 1
			}
			crucible.Equal(mut t, "step {step}: retired", n, want)
			if model[i] == "live" {
				model[i] = "retired"
			}
		} else if op == 3 {
			what = "drop"
			let dropped = Drop(c, mut s, repo, h) catch err {
				t.Error("step {step}: drop: {err}")
				return
			}
			t.True("step {step}: dropped a {model[i]} pack", dropped == (model[i] == "pending"))
			if model[i] == "pending" {
				model[i] = "none"
			}
		} else {
			what = "sweep"
			_ = Sweep(c, mut s, 0, 0) catch err {
				t.Error("step {step}: sweep: {err}")
				return
			}
			for j in 0..4 {
				if model[j] == "pending" || model[j] == "retired" {
					model[j] = "none"
				}
			}
		}
		// the rows, the files and the size agree with the model
		mut liveSize = 0
		for j in 0..4 {
			let rows = c.Query("SELECT state, size_bytes FROM packs WHERE repo_id = {repo} AND hash = {hashes[j]}") catch err {
				t.Error("step {step}: query: {err}")
				return
			}
			mut state = "none"
			if len(rows.Rows) == 1 {
				state = rows.Rows[0][0].Text()
				if state == "live" {
					liveSize += rows.Rows[0][1].Int()
				}
			}
			crucible.Equal(mut t, "step {step} ({what}): pack {j}'s state", state, model[j])
			let files = s.Local(PackKey(repo, hashes[j], "pack")) != nil && s.Local(PackKey(repo, hashes[j], "idx")) != nil
			t.True("step {step} ({what}): pack {j} ({state}) has its files exactly when it has a row", files == (state != "none"))
		}
		let r = c.Query("SELECT size_bytes FROM repos WHERE id = {repo}") catch err {
			t.Error("step {step}: query: {err}")
			return
		}
		crucible.Equal(mut t, "step {step} ({what}): the repository's size", r.Rows[0][0].Int(), liveSize)
		if t.Failed() {
			return
		}
	}
	quarry.RemoveAll(root) catch _ {
	}
}
