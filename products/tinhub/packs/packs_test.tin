package packs

import "crucible"
import "quarry"
import "s3"
import "seal"

// Tests for the pack store (#1011). The states of packs need Postgres (TINHUB_TEST_DB): see state_test.tin.

fn scratch(name str) str {
	return "/tmp/tin-test-tinhub-packs-" + name + "-" + seal.Hex(seal.RandomBytes(4))
}

fn TestDirStoreContract(t mut crucible.T) {
	let root = scratch("dir")
	mut d = NewDirStore(root) catch err {
		t.Error("new: {err}")
		return
	}
	t.NoFault("contract", Check(mut d, scratch("files"), "repos/7"))
	quarry.RemoveAll(root) catch _ {
	}
}

fn TestKeys(t mut crucible.T) {
	crucible.Equal(mut t, "pack key", PackKey(3, "ab", "pack"), "repos/3/packs/ab.pack")
	t.NoFault("a pack key", CheckKey(PackKey(3, "ab", "idx")))
	for bad in []str{"", "/abs", "a//b", "a/../b", "a/.hidden", "a/b/", "a b", "a\\b"} {
		t.HasFault("refused: {bad}", CheckKey(bad))
	}
}

// TestS3StoreContract runs the same contract on the S3 store, against the server at TINHUB_TEST_S3 (an endpoint URL,
// with TINHUB_TEST_S3_KEY and TINHUB_TEST_S3_SECRET), when one is given: tests/run.sh starts the signature-checking
// fake of bench/ref/s3sig when Go is there.
fn TestS3StoreContract(t mut crucible.T) {
	let endpoint = quarry.Getenv("TINHUB_TEST_S3")
	if len(endpoint) == 0 {
		t.Log("TINHUB_TEST_S3 is not set: skipped")
		return
	}
	let c = s3.New(s3.Config{Endpoint: endpoint, Region: "us-east-1", AccessKey: quarry.Getenv("TINHUB_TEST_S3_KEY"), SecretKey: quarry.Getenv("TINHUB_TEST_S3_SECRET"), Token: "", PathStyle: true, SignPayload: false, UnsignedPayload: false, Attempts: 0, Backoff: 0, Timeout: 0, TLS: nil}) catch err {
		t.Error("client: {err}")
		return
	}
	let bucket = "tinhub-test-" + seal.Hex(seal.RandomBytes(4))
	c.CreateBucket(bucket) catch err {
		t.Error("bucket: {err}")
		return
	}
	let cache = scratch("s3cache")
	mut s = S3Store{Client: c, Bucket: bucket, Cache: cache}
	t.NoFault("contract", Check(mut s, scratch("s3files"), "repos/7"))
	quarry.RemoveAll(cache) catch _ {
	}
}

// TestTrimCache: the oldest copies are retired until the cache fits, and stay readable in retired/.
fn TestTrimCache(t mut crucible.T) {
	let cache = scratch("trim")
	let dir = cache + "/repos/1/packs"
	quarry.MkdirAll(dir) catch _ {
	}
	for i in 0..4 {
		quarry.WriteFile(dir + "/p{i}.pack", seal.Hex(seal.RandomBytes(500))) catch _ {
		}
		quarry.WriteFile(dir + "/p{i}.idx", "idx") catch _ {
		}
	}
	let n = TrimCache(cache, 2100, 3600, 1000) catch err {
		t.Error("trim: {err}")
		return
	}
	crucible.Equal(mut t, "two retired to fit", n, 2)
	let left = quarry.ReadDir(dir) catch _ {
		[]str{}
	}
	mut packs = 0
	for f in left {
		if len(f) > 5 && f[len(f) - 5:] == ".pack" {
			packs += 1
		}
	}
	crucible.Equal(mut t, "two copies left", packs, 2)
	let later = TrimCache(cache, 2100, 3600, 1000 + 7200) catch err {
		t.Error("trim: {err}")
		return
	}
	crucible.Equal(mut t, "nothing more to retire", later, 0)
	let gone = quarry.ReadDir(dir + "/retired") catch _ {
		[]str{"x"}
	}
	crucible.Equal(mut t, "retired copies deleted after the grace period", len(gone), 0)
	quarry.RemoveAll(cache) catch _ {
	}
}

// TestCopy: tinhub packs copy moves every object across, and a second copy finds them all there already.
fn TestCopy(t mut crucible.T) {
	let a = scratch("copyfrom")
	let b = scratch("copyto")
	let files = scratch("copyfiles")
	mut from = NewDirStore(a) catch err {
		t.Error("new: {err}")
		return
	}
	mut to = NewDirStore(b) catch err {
		t.Error("new: {err}")
		return
	}
	quarry.MkdirAll(files) catch err {
		t.Error("mkdir: {err}")
		return
	}
	for i in 0..5 {
		let f = files + "/f{i}"
		quarry.WriteFile(f, "pack {i} " + seal.Hex(seal.RandomBytes(16))) catch err {
			t.Error("write: {err}")
			return
		}
		from.Put(PackKey(i % 2 + 1, "h{i}", "pack"), f) catch err {
			t.Error("put: {err}")
			return
		}
	}
	let first = Copy(mut from, mut to, "repos/", files + "/tmp") catch err {
		t.Error("copy: {err}")
		return
	}
	crucible.Equal(mut t, "copied", first.Copied, 5)
	crucible.Equal(mut t, "skipped", first.Skipped, 0)
	let again = Copy(mut from, mut to, "repos/", files + "/tmp") catch err {
		t.Error("copy again: {err}")
		return
	}
	crucible.Equal(mut t, "copied again", again.Copied, 0)
	crucible.Equal(mut t, "skipped again", again.Skipped, 5)
	let keys = to.List("repos/") catch err {
		t.Error("list: {err}")
		return
	}
	crucible.Equal(mut t, "keys", len(keys), 5)
	for dir in []str{a, b, files} {
		quarry.RemoveAll(dir) catch _ {
		}
	}
}
