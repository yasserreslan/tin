package packs

import "quarry"
import "seal"
import "twine"

// DirStore is a PackStore on a directory (deployment phase 1): the object at a key is the file <Root>/<key>, written
// through a temporary file in the same directory, synced and renamed, so a key holds all of its bytes or nothing.
type DirStore struct {
	Root str
}

// NewDirStore is the store under root (made when missing).
fn NewDirStore(root str) !DirStore {
	try quarry.MkdirAll(root)
	return DirStore{Root: twine.TrimRight(root, "/")}
}

fn (d DirStore) path(key str) !str {
	try CheckKey(key)
	return d.Root + "/" + key
}

// Put moves the file at path to key (copying it when it is on another file system), synced before it is visible; the bytes stored.
fn (d DirStore) Put(key str, path str) !i64 {
	let to = try d.path(key)
	let dir = parent(to)
	try quarry.MkdirAll(dir)
	let tmp = dir + "/.tmp-" + seal.Hex(seal.RandomBytes(8))
	let err = quarry.Rename(path, tmp)
	if err != nil {
		_ = try copyFile(path, tmp)
		quarry.Remove(path) catch _ {
		}
	}
	try quarry.Sync(tmp)
	let size = try quarry.Size(tmp)
	try quarry.Rename(tmp, to)
	try quarry.Sync(dir)
	return size
}

// Get copies the object at key to path; the bytes written.
fn (d DirStore) Get(key str, path str) !i64 {
	let from = try d.path(key)
	let tmp = path + ".tmp-" + seal.Hex(seal.RandomBytes(8))
	let n = try copyFile(from, tmp)
	try quarry.Rename(tmp, path)
	return n
}

// ReadAt reads into buf from offset off of the object at key; the bytes read, fewer at its end.
fn (d DirStore) ReadAt(key str, off i64, buf mut []u8) !i64 {
	let p = try d.path(key)
	let s = try quarry.ReadAt(p, off, len(buf))
	for i in 0..len(s) {
		buf[i] = s[i]
	}
	return len(s)
}

// Size is the object's size, nil when there is none at key.
fn (d DirStore) Size(key str) !?i64 {
	let p = try d.path(key)
	if !quarry.Exists(p) {
		return nil
	}
	let n = try quarry.Size(p)
	return n
}

// Delete removes the object at key; false when there was none.
fn (d DirStore) Delete(key str) !bool {
	let p = try d.path(key)
	if !quarry.Exists(p) {
		return false
	}
	try quarry.Remove(p)
	return true
}

// List is every key that starts with prefix, in order.
fn (d DirStore) List(prefix str) ![]str {
	// the directory to walk is prefix up to its last slash
	mut base = ""
	let slash = twine.LastIndex(prefix, "/")
	if slash > 0 {
		base = prefix[0:slash]
		try CheckKey(base)
	}
	mut out = []str{}
	mut start = d.Root
	if len(base) > 0 {
		start = d.Root + "/" + base
	}
	if !quarry.IsDir(start) {
		return out
	}
	try walk(start, base, prefix, mut out)
	quarry.SortStrs(mut out)
	return out
}

fn walk(dir str, rel str, prefix str, out mut []str) ! {
	let entries = try quarry.ReadDirEntries(dir)
	for e in entries {
		if len(e.Name) == 0 || e.Name[0] == '.' {
			continue
		}
		mut key = e.Name
		if len(rel) > 0 {
			key = rel + "/" + e.Name
		}
		if quarry.IsDir(dir + "/" + e.Name) {
			if twine.HasPrefix(key + "/", prefix) || twine.HasPrefix(prefix, key + "/") {
				try walk(dir + "/" + e.Name, key, prefix, mut out)
			}
			continue
		}
		if twine.HasPrefix(key, prefix) {
			out = append(out, key)
		}
	}
}

// Local is the file that holds key's bytes: every key of a directory store is one.
fn (d DirStore) Local(key str) ?str {
	let (p, err) = d.path(key)
	if err != nil || !quarry.Exists(p) {
		return nil
	}
	return p
}

// copyChunk is how much of a file copyFile holds at once.
const copyChunk = 4 * 1024 * 1024

// copyFile copies the file at from to to (created, or truncated), a chunk at a time; the bytes copied.
fn copyFile(from str, to str) !i64 {
	let size = try quarry.Size(from)
	try quarry.WriteFile(to, "")
	mut off = 0
	for off < size {
		let chunk = try quarry.ReadAt(from, off, copyChunk)
		if len(chunk) == 0 {
			break
		}
		try quarry.AppendFile(to, chunk)
		off += len(chunk)
	}
	return off
}

fn parent(path str) str {
	let slash = twine.LastIndex(path, "/")
	if slash <= 0 {
		return "."
	}
	return path[0:slash]
}
