package packs

import "postgres"
import "say"

// Verified is what Verify found: the live packs and their bytes, the ones missing from the store or at the wrong
// size, and fingerprints of the refs and of the live packs, to compare a restored database with the one backed up.
type Verified struct {
	Packs   i64
	Bytes   i64
	Missing []str
	Refs    str
	Live    str
}

// Verify checks every live pack of every repository: its .pack is in the store at the size its row records, and its
// .idx is there too. It is tinhub check, run after a restore (deploy/RUNBOOK.md).
fn Verify[S PackStore](c postgres.Client, s mut S) !Verified {
	let fp = try c.Query("SELECT coalesce(md5(string_agg(repo_id::text || ' ' || name || ' ' || target, E'\\n' ORDER BY repo_id, name)), '') FROM refs")
	let lp = try c.Query("SELECT coalesce(md5(string_agg(repo_id::text || ' ' || hash || ' ' || size_bytes::text, E'\\n' ORDER BY repo_id, hash)), '') FROM packs WHERE state = 'live'")
	mut out = Verified{Packs: 0, Bytes: 0, Missing: []str{}, Refs: fp.Rows[0][0].Text(), Live: lp.Rows[0][0].Text()}
	let rows = try c.Query("SELECT repo_id, hash, size_bytes FROM packs WHERE state = 'live' ORDER BY repo_id, hash")
	for r in rows.Rows {
		let repo = r[0].Int()
		let hash = r[1].Text()
		let want = r[2].Int()
		out.Packs += 1
		out.Bytes += want
		let key = PackKey(repo, hash, "pack")
		let got = try s.Size(key)
		if got == nil {
			out.Missing = append(out.Missing, key)
		} else if got != want {
			out.Missing = append(out.Missing, key + " (" + say.Str(got) + " bytes, not " + say.Str(want) + ")")
		}
		let idx = PackKey(repo, hash, "idx")
		let have = try s.Size(idx)
		if have == nil {
			out.Missing = append(out.Missing, idx)
		}
	}
	return out
}
