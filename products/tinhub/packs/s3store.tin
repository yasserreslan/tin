package packs

import "../../tit/packfile"
import "fault"
import "quarry"
import "s3"
import "seal"
import "twine"

// S3Store is a PackStore in an S3-compatible bucket (deployment phase 2, #1015), with the node's copies of what it
// reads and writes under Cache (<packs.dir>/cache): a key is the same object key in the bucket and the file
// <Cache>/<key>. Packs a node uses stay on its disk; TrimCache keeps the copies under a size, retiring the oldest as
// tit retires a pack, so a fetch that opened one keeps reading it until the grace period ends.
type S3Store struct {
	Client s3.Client
	Bucket str
	Cache  str
}

// partSize is the part of a multipart upload; files above multipartAt are sent in parts.
const partSize = 16 * 1024 * 1024

const multipartAt = 64 * 1024 * 1024

fn (s S3Store) cached(key str) !str {
	try CheckKey(key)
	return s.Cache + "/" + key
}

// Put uploads the file at path to key, then keeps it as the node's copy.
fn (s S3Store) Put(key str, path str) !i64 {
	let local = try s.cached(key)
	let size = try quarry.Size(path)
	if size > multipartAt {
		_ = try s.Client.Upload(s.Bucket, key, path, partSize)
	} else {
		_ = try s.Client.Put(s.Bucket, key, path)
	}
	try quarry.MkdirAll(parent(local))
	let err = quarry.Rename(path, local)
	if err != nil {
		quarry.Remove(path) catch _ {
		}
	}
	return size
}

// Get writes the object at key to path, from the node's copy when it has one.
fn (s S3Store) Get(key str, path str) !i64 {
	let local = try s.cached(key)
	if quarry.Exists(local) {
		let tmp = path + ".tmp-" + seal.Hex(seal.RandomBytes(8))
		let n = try copyFile(local, tmp)
		try quarry.Rename(tmp, path)
		return n
	}
	return try s.Client.GetFile(s.Bucket, key, path)
}

// ReadAt reads into buf from offset off of the object at key: from the node's copy, else a ranged GET.
fn (s S3Store) ReadAt(key str, off i64, buf mut []u8) !i64 {
	let local = try s.cached(key)
	mut data = ""
	if quarry.Exists(local) {
		data = try quarry.ReadAt(local, off, len(buf))
	} else {
		data = try s.Client.GetRange(s.Bucket, key, off, len(buf))
	}
	for i in 0..len(data) {
		buf[i] = data[i]
	}
	return len(data)
}

// Size is the object's size, nil when the bucket has none at key.
fn (s S3Store) Size(key str) !?i64 {
	try CheckKey(key)
	let (o, err) = s.Client.Head(s.Bucket, key)
	if err != nil {
		if fault.Is(err, s3.ErrNotFound) {
			return nil
		}
		fail err
	}
	return o.Size
}

// Delete removes the object at key and the node's copy; false when the bucket had none.
fn (s S3Store) Delete(key str) !bool {
	let local = try s.cached(key)
	let there = try s.Size(key)
	try s.Client.Delete(s.Bucket, key)
	if quarry.Exists(local) {
		quarry.Remove(local) catch _ {
		}
	}
	return there != nil
}

// List is every key in the bucket that starts with prefix, in order.
fn (s S3Store) List(prefix str) ![]str {
	let objs = try s.Client.ListAll(s.Bucket, prefix)
	mut out = []str{}
	for o in objs {
		out = append(out, o.Key)
	}
	quarry.SortStrs(mut out)
	return out
}

// Local is the node's copy of key, when it has one.
fn (s S3Store) Local(key str) ?str {
	let (p, err) = s.cached(key)
	if err != nil || !quarry.Exists(p) {
		return nil
	}
	return p
}

// TrimCache keeps the node's copies of packs under max bytes: the oldest are retired (packfile.Retire: moved into
// retired/, where a reader that opened one still finds it) and retired copies older than grace seconds are deleted.
// It returns how many it retired.
fn TrimCache(cache str, max i64, grace i64, now i64) !i64 {
	let root = cache + "/repos"
	if !quarry.IsDir(root) {
		return 0
	}
	mut dirs = []str{}
	mut names = []str{}
	mut times = []i64{}
	mut sizes = []i64{}
	mut total = 0
	let repos = try quarry.ReadDir(root)
	for repo in repos {
		let dir = root + "/" + repo + "/packs"
		if !quarry.IsDir(dir) {
			continue
		}
		_ = try packfile.Sweep(dir, grace, now)
		let files = try quarry.ReadDir(dir)
		for f in files {
			let p = dir + "/" + f
			if quarry.IsDir(p) || twine.HasPrefix(f, ".") {
				continue
			}
			let info = quarry.Lstat(p) catch _ {
				continue
			}
			total += info.Size
			if twine.HasSuffix(f, ".pack") {
				dirs = append(dirs, dir)
				names = append(names, f[0:len(f) - 5])
				times = append(times, info.Mtime)
				sizes = append(sizes, info.Size)
			}
		}
	}
	mut retired = 0
	for total > max && len(names) > 0 {
		// the oldest copy
		mut at = 0
		for i in 1..len(names) {
			if times[i] < times[at] {
				at = i
			}
		}
		retired += try packfile.Retire(dirs[at], []str{names[at]}, now)
		total -= sizes[at]
		dirs = append(dirs[0:at], dirs[at + 1:]...)
		names = append(names[0:at], names[at + 1:]...)
		times = append(times[0:at], times[at + 1:]...)
		sizes = append(sizes[0:at], sizes[at + 1:]...)
	}
	return retired
}
