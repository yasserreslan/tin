package web

import "crucible"
import "twine"

// Tests for the pages' server side (#1081, #1093): which paths are assets and which are pages, the validators and
// encodings, escaping in the shell, and the embedded files the shell and the pages load.

fn TestSafePath(t mut crucible.T) {
	t.True("a module", SafePath("js/pages/review.js"))
	t.True("a stylesheet", SafePath("css/app.css"))
	t.False("empty", SafePath(""))
	t.False("absolute", SafePath("/etc/passwd"))
	t.False("parent", SafePath("js/../../web.tin"))
	t.False("dot segment", SafePath("js/./main.js"))
	t.False("hidden", SafePath(".git/config"))
	t.False("empty segment", SafePath("js//main.js"))
	t.False("encoded", SafePath("js/%2e%2e/x"))
	t.False("backslash", SafePath("js\\main.js"))
	t.False("too long", SafePath(twine.Repeat("a", 257)))
}

fn TestTypeOf(t mut crucible.T) {
	crucible.Equal(mut t, "js", TypeOf("js/main.js"), "text/javascript; charset=utf-8")
	crucible.Equal(mut t, "css", TypeOf("css/app.css"), "text/css; charset=utf-8")
	crucible.Equal(mut t, "svg", TypeOf("img/icon.svg"), "image/svg+xml")
	crucible.Equal(mut t, "html", TypeOf("index.html"), "text/html; charset=utf-8")
	crucible.Equal(mut t, "none", TypeOf("LICENSE"), "application/octet-stream")
}

fn TestIsPage(t mut crucible.T) {
	t.True("home", IsPage("GET", "/"))
	t.True("a repository", IsPage("GET", "/ada/tin"))
	t.True("a review", IsPage("GET", "/ada/tin/change/abc/files"))
	t.True("head", IsPage("HEAD", "/explore"))
	t.False("a post", IsPage("POST", "/ada/tin"))
	t.False("the API", IsPage("GET", "/api/v1/nothing"))
	t.False("an asset", IsPage("GET", "/-/abc/js/nothing.js"))
	t.False("the protocol", IsPage("GET", "/ada/tin/tit/v1/refs"))
}

fn TestMatches(t mut crucible.T) {
	t.True("same", matches("\"abc\"", "\"abc\""))
	t.True("weak", matches("W/\"abc\"", "\"abc\""))
	t.True("in a list", matches("\"x\", \"abc\"", "\"abc\""))
	t.True("star", matches("*", "\"abc\""))
	t.False("other", matches("\"abd\"", "\"abc\""))
	t.False("none", matches("", "\"abc\""))
}

fn TestAcceptsGzip(t mut crucible.T) {
	t.True("plain", acceptsGzip("gzip"))
	t.True("listed", acceptsGzip("br, gzip, deflate"))
	t.True("weighted", acceptsGzip("gzip;q=0.5"))
	t.False("refused", acceptsGzip("gzip;q=0"))
	t.False("refused with space", acceptsGzip("gzip; q=0.0"))
	t.False("absent", acceptsGzip("br, deflate"))
	t.False("empty", acceptsGzip(""))
}

fn TestEscape(t mut crucible.T) {
	crucible.Equal(mut t, "markup", escape("<a href=\"x\">'&'</a>"), "&lt;a href=&quot;x&quot;&gt;&#39;&amp;&#39;&lt;/a&gt;")
	crucible.Equal(mut t, "plain", escape("https://hub.example.com"), "https://hub.example.com")
}

fn TestPrepare(t mut crucible.T) {
	let big = prepare("js/x.js", twine.Repeat("let a = 1;\n", 400))
	t.True("gzipped when large", len(big.gz) > 0 && len(big.gz) < len(big.body))
	t.True("quoted etag", twine.HasPrefix(big.etag, "\"") && twine.HasSuffix(big.etag, "\""))
	let small = prepare("js/x.js", "let a = 1;\n")
	crucible.Equal(mut t, "small not gzipped", small.gz, "")
	let png = prepare("img/x.png", twine.Repeat("x", 4000))
	crucible.Equal(mut t, "binary not gzipped", png.gz, "")
	t.True("same bytes, same etag", prepare("a.js", "x").etag == prepare("b.js", "x").etag)
	t.True("other bytes, other etag", prepare("a.js", "x").etag != prepare("a.js", "y").etag)
}

// the shell and every page module the route table names are embedded
fn TestEmbedded(t mut crucible.T) {
	let shell = readFile("index.html") catch err {
		t.Error("index.html: {err}")
		return
	}
	t.True("shell has the build placeholder", twine.Contains(shell, "%BUILD%"))
	let main = readFile("js/main.js") catch err {
		t.Error("js/main.js: {err}")
		return
	}
	mut pages = 0
	for part in twine.Split(main, "page(\"./") {
		let end = twine.Index(part, "\")")
		if end <= 0 || !twine.HasPrefix(part, "pages/") {
			continue
		}
		let path = "js/" + part[:end]
		pages += 1
		_ = readFile(path) catch err {
			t.Error("{path}: {err}")
			continue
		}
	}
	t.True("the route table names pages", pages >= 20)
	let icon = readFile("img/icon.svg") catch _ {
		""
	}
	t.True("an icon", len(icon) > 0)
	let css = readFile("css/app.css") catch _ {
		""
	}
	t.True("the stylesheet", len(css) > 1000)
	t.True("build id", len(Build()) == 12)
}
