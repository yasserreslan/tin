package web

import "anvil"
import "embed"
import "fault"
import "herald"
import "quarry"
import "seal"
import "squash"
import "twine"

// tinhub's pages (design/tinhub.md §15, #1081): the UI's files are embedded in the binary and served under
// /-/<build>/, and every page URL answers the app shell, which reads and writes through the JSON API. With web.dir set
// the files are read from that directory on every request instead, for editing the UI against a running node.

// embed: static
let files str

// Deps is what the pages need, set on every core (Configure) before the first request.
type Deps struct {
	// Dir serves the UI from this directory instead of the embedded files ("" for the embedded ones).
	Dir str
	// PublicURL is the URL clients use (config public_url), shown in the sign-in command.
	PublicURL str
	// Version is tinhub's version, shown in the page's footer.
	Version str
}

mut deps ?Deps = nil

// Configure sets this core's dependencies.
fn Configure(d Deps) {
	deps = keep(d)
}

// asset is one file ready to send: its bytes, its gzipped bytes ("" when not worth it), its ETag and content type.
type asset struct {
	body  str
	gz    str
	etag  str
	ctype str
}

// This core's assets by path, the embedded tree and the build id; filled on first use.
mut cache = map[str]asset{}

mut tree ?embed.FS = nil

mut buildId = ""

// Build is the id of the embedded files: the first 12 hex digits of the SHA-256 of all of them ("dev" with web.dir).
fn Build() str {
	let d = deps
	if d != nil && len(d.Dir) > 0 {
		return "dev"
	}
	if len(buildId) == 0 {
		buildId = keep(seal.Hex(seal.Sha256Soft(files))[:12])
	}
	return buildId
}

// Mount adds the asset route and makes the router's 404 answer the shell for page URLs.
fn Mount(r mut anvil.Router) {
	r.Get(`/-/{build}/{path...}`, serveAsset)
	r.NotFound(notFound)
}

// TypeOf is the content type of a file by its extension.
fn TypeOf(path str) str {
	let dot = twine.LastIndex(path, ".")
	if dot < 0 {
		return "application/octet-stream"
	}
	return match path[dot + 1:] {
		"html" => "text/html; charset=utf-8"
		"js", "mjs" => "text/javascript; charset=utf-8"
		"css" => "text/css; charset=utf-8"
		"json" => "application/json"
		"svg" => "image/svg+xml"
		"png" => "image/png"
		"ico" => "image/x-icon"
		"woff2" => "font/woff2"
		"txt", "md" => "text/plain; charset=utf-8"
		"webmanifest" => "application/manifest+json"
		_ => "application/octet-stream"
	}
}

// compressible reports whether a content type is text worth gzipping.
fn compressible(ctype str) bool {
	return twine.HasPrefix(ctype, "text/") || twine.HasPrefix(ctype, "application/json") || twine.HasPrefix(ctype, "image/svg") || twine.HasPrefix(ctype, "application/manifest")
}

// SafePath reports whether an asset path may be served: relative, no empty, "." or ".." segments and no hidden names.
fn SafePath(path str) bool {
	if len(path) == 0 || len(path) > 256 {
		return false
	}
	for seg in twine.Split(path, "/") {
		if len(seg) == 0 || seg[0] == '.' {
			return false
		}
	}
	for c in path {
		let ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '.' || c == '-' || c == '_' || c == '/'
		if !ok {
			return false
		}
	}
	return true
}

// readFile is the UI's file at path (relative to static/), from web.dir or the embedded tree.
fn readFile(path str) !str {
	let d = deps
	if d != nil && len(d.Dir) > 0 {
		return try quarry.ReadFile(d.Dir + "/" + path)
	}
	if tree == nil {
		let t = try embed.Parse(files)
		tree = keep(t)
	}
	let t = tree
	if t == nil {
		fail "no embedded tree"
	}
	return try t.ReadFile("static/" + path)
}

// load is the asset at path, from this core's cache unless the files come from web.dir.
fn load(path str) !asset {
	let d = deps
	let fromDisk = d != nil && len(d.Dir) > 0
	if !fromDisk {
		let (a, ok) = cache[path]
		if ok {
			return a
		}
	}
	let body = try readFile(path)
	let a = prepare(path, body)
	if !fromDisk {
		cache[keep(path)] = keep(a)
	}
	return a
}

// prepare makes an asset of a file's bytes: its ETag, its type and, for text over 1 KiB, its gzipped bytes.
fn prepare(path str, body str) asset {
	let ctype = TypeOf(path)
	mut gz = ""
	if compressible(ctype) && len(body) > 1024 {
		gz = squash.Gzip(body, squash.Default)
		if len(gz) >= len(body) {
			gz = ""
		}
	}
	let etag = "\"" + seal.Hex(seal.Sha256Soft(body))[:32] + "\""
	return asset{body: body, gz: gz, etag: etag, ctype: ctype}
}

// matches reports whether an If-None-Match field names etag (or is *).
fn matches(field str, etag str) bool {
	if len(field) == 0 {
		return false
	}
	if twine.TrimSpace(field) == "*" {
		return true
	}
	for part in twine.Split(field, ",") {
		mut p = twine.TrimSpace(part)
		if twine.HasPrefix(p, "W/") {
			p = p[2:]
		}
		if p == etag {
			return true
		}
	}
	return false
}

// acceptsGzip reports whether an Accept-Encoding field allows gzip.
fn acceptsGzip(field str) bool {
	for part in twine.Split(field, ",") {
		let (name, params, _) = twine.Cut(twine.TrimSpace(part), ";")
		if twine.ToLower(twine.TrimSpace(name)) == "gzip" {
			let p = twine.ReplaceAll(params, " ", "")
			return p != "q=0" && p != "q=0.0" && p != "q=0.00" && p != "q=0.000"
		}
	}
	return false
}

// send writes an asset with its validators: 304 when the client has it, gzipped when the client takes it.
fn send(q anvil.Req, w mut anvil.Out, a asset, cacheControl str) {
	w.Head("ETag", a.etag)
	w.Head("Cache-Control", cacheControl)
	w.Head("Vary", "Accept-Encoding")
	w.Head("X-Content-Type-Options", "nosniff")
	if matches(q.Header("if-none-match"), a.etag) {
		w.Status(304)
		w.Body = []u8{}
		return
	}
	w.Type(a.ctype)
	if len(a.gz) > 0 && acceptsGzip(q.Header("accept-encoding")) {
		w.Head("Content-Encoding", "gzip")
		w.Body = []u8(a.gz)
		return
	}
	w.Body = []u8(a.body)
}

// serveAsset answers /-/<build>/<path>: immutable when build is the current one, else the current file revalidated.
fn serveAsset(q anvil.Req, w mut anvil.Out) {
	let path = q.PathParam("path")
	if !SafePath(path) || path == "index.html" {
		plain404(mut w)
		return
	}
	let a = load(path) catch _ {
		plain404(mut w)
		return
	}
	mut cc = "no-cache"
	if q.PathParam("build") == Build() && Build() != "dev" {
		cc = "public, max-age=31536000, immutable"
	}
	send(q, mut w, a, cc)
}

fn plain404(w mut anvil.Out) {
	w.Status(404)
	w.Type("text/plain; charset=utf-8")
	w.Body = []u8("404 page not found\n")
}

// IsPage reports whether a request for path that no route matched is a page URL: a GET or HEAD outside /api/ and /-/.
fn IsPage(method str, path str) bool {
	if method != "GET" && method != "HEAD" {
		return false
	}
	if !twine.HasPrefix(path, "/") || twine.HasPrefix(path, "/api/") || path == "/api" || twine.HasPrefix(path, "/-/") {
		return false
	}
	return !twine.Contains(path, "/tit/v1/")
}

// notFound answers the shell for page URLs, and 404 for the rest (JSON under /api/).
fn notFound(q anvil.Req, w mut anvil.Out) {
	if IsPage(q.Method, q.Path) {
		Shell(q, mut w)
		return
	}
	if twine.HasPrefix(q.Path, "/api/") {
		w.Status(404)
		w.Json()
		w.Body = []u8(`{"code":"not_found","message":"no such route"}`)
		return
	}
	plain404(mut w)
}

// Policy is the shell's Content-Security-Policy: scripts, styles and connections from this origin only.
const Policy = "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' ws: wss:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"

// escape is text made safe inside an HTML attribute or element.
fn escape(s str) str {
	mut b = []u8{}
	for i in 0..len(s) {
		let c = s[i]
		match c {
			'&' => b = append(b, "&amp;"...)
			'<' => b = append(b, "&lt;"...)
			'>' => b = append(b, "&gt;"...)
			'"' => b = append(b, "&quot;"...)
			'\'' => b = append(b, "&#39;"...)
			_ => b = append(b, c)
		}
	}
	return str(b)
}

// Shell answers the app shell: index.html with the build and the site's URL filled in, and the page headers.
fn Shell(q anvil.Req, w mut anvil.Out) {
	let text = readFile("index.html") catch err {
		herald.Log(herald.LError, "web: the shell", []str{"error", fault.Message(err)})
		w.Status(503)
		w.Type("text/plain; charset=utf-8")
		w.Body = []u8("the web UI is not available\n")
		return
	}
	mut publicUrl = ""
	mut version = ""
	let d = deps
	if d != nil {
		publicUrl = d.PublicURL
		version = d.Version
	}
	mut page = twine.ReplaceAll(text, "%BUILD%", Build())
	page = twine.ReplaceAll(page, "%PUBLIC_URL%", escape(publicUrl))
	page = twine.ReplaceAll(page, "%VERSION%", escape(version))
	w.Status(200)
	w.Head("Content-Security-Policy", Policy)
	w.Head("X-Content-Type-Options", "nosniff")
	w.Head("Referrer-Policy", "same-origin")
	w.Head("X-Frame-Options", "DENY")
	let a = prepare("index.html", page)
	send(q, mut w, a, "no-cache")
}
