package events

import "fault"
import "hearth"
import "herald"
import "mint"
import "postgres"
import "quarry"
import "seal"
import "tide"

// The event queue (design/tinhub.md §6, #1013): an event is a row of events, written in the transaction that made the
// change it describes; workers claim ready rows with FOR UPDATE SKIP LOCKED under a lease, run the handler of their
// kind inside its budget, and mark them done, or ready again later with a backoff, or dead after too many attempts.
// Delivery is at least once: handlers are idempotent.

// Job is a claimed event.
type Job struct {
	Id       i64
	Kind     str
	RepoId   i64
	Payload  str
	Attempts i64
}

// Handler runs the jobs of one kind inside a budget: Within nanoseconds, Memory bytes of pool and Tasks tasks.
type Handler struct {
	Kind        str
	Within      i64
	Memory      i64
	Tasks       i64
	MaxAttempts i64
	Run         fn(Job) !
}

// Stats is the queue's state: ready jobs, claimed jobs, dead jobs and the age of the oldest ready job in seconds.
type Stats struct {
	Ready     i64
	Claimed   i64
	Dead      i64
	OldestAge i64
}

// Enqueue adds an event in tx, so it exists exactly when the change it describes does; repoId 0 is none.
fn Enqueue(tx mut postgres.Tx, kind str, repoId i64, payload str) !i64 {
	let rows = try tx.Query("INSERT INTO events (kind, repo_id, payload) VALUES ({kind}, nullif({repoId}, 0), {payload}::jsonb) RETURNING id")
	return rows.Rows[0][0].Int()
}

// EnqueueNow adds an event in a transaction of its own.
fn EnqueueNow(c postgres.Client, kind str, repoId i64, payload str) !i64 {
	let rows = try c.Query("INSERT INTO events (kind, repo_id, payload) VALUES ({kind}, nullif({repoId}, 0), {payload}::jsonb) RETURNING id")
	return rows.Rows[0][0].Int()
}

// Reap makes every claimed job whose lease has passed ready again: its worker died or stalled.
fn Reap(c postgres.Client) !i64 {
	let r = try c.Exec("UPDATE events SET state = 'ready', lease_until = NULL, claimed_by = '' WHERE state = 'claimed' AND lease_until < now()")
	return r.Affected
}

// Claim takes up to n ready jobs of the given kinds for worker me, leased for lease nanoseconds.
fn Claim(c postgres.Client, me str, kinds []str, n i64, lease i64) ![]Job {
	let ms = lease / 1000000
	let names = encodeKinds(kinds)
	let rows = try c.Query("UPDATE events SET state = 'claimed', lease_until = now() + make_interval(secs => {ms}::float8 / 1000), claimed_by = {me}, attempts = attempts + 1 WHERE id IN (SELECT id FROM events WHERE state = 'ready' AND next_at <= now() AND kind = ANY(string_to_array({names}, ',')) ORDER BY next_at, id LIMIT {n} FOR UPDATE SKIP LOCKED) RETURNING id, kind, coalesce(repo_id, 0), payload::text, attempts")
	mut out = []Job{}
	for r in rows.Rows {
		out = append(out, Job{Id: r[0].Int(), Kind: r[1].Text(), RepoId: r[2].Int(), Payload: r[3].Text(), Attempts: r[4].Int()})
	}
	return out
}

fn encodeKinds(kinds []str) str {
	mut s = ""
	for i, k in kinds {
		if i > 0 {
			s = s + ","
		}
		s = s + k
	}
	return s
}

// Extend renews a job's lease while its worker still holds it; false when the job was taken from it.
fn Extend(c postgres.Client, id i64, me str, lease i64) !bool {
	let ms = lease / 1000000
	let r = try c.Exec("UPDATE events SET lease_until = now() + make_interval(secs => {ms}::float8 / 1000) WHERE id = {id} AND state = 'claimed' AND claimed_by = {me}")
	return r.Affected == 1
}

// Done marks a job finished.
fn Done(c postgres.Client, id i64, me str) !bool {
	let r = try c.Exec("UPDATE events SET state = 'done', done_at = now(), lease_until = NULL WHERE id = {id} AND state = 'claimed' AND claimed_by = {me}")
	return r.Affected == 1
}

// Backoff is the wait before attempt n + 1: one second doubling to ten minutes, plus up to a quarter more at random.
fn Backoff(attempts i64) i64 {
	mut d = tide.Second
	mut i = 1
	for i < attempts && d < 10 * tide.Minute {
		d = d * 2
		i += 1
	}
	if d > 10 * tide.Minute {
		d = 10 * tide.Minute
	}
	let b = seal.RandomBytes(4)
	let r = (i64(b[0]) << 24) | (i64(b[1]) << 16) | (i64(b[2]) << 8) | i64(b[3])
	let jitter = r % (d / 4 + 1)
	return d + jitter
}

// Failed puts a job back as ready after its backoff, or dead once it has had maxAttempts, with the fault's text.
fn Failed(c postgres.Client, j Job, me str, why str, maxAttempts i64) !bool {
	if j.Attempts >= maxAttempts {
		let r = try c.Exec("UPDATE events SET state = 'dead', lease_until = NULL, last_error = {why}, done_at = now() WHERE id = {j.Id} AND state = 'claimed' AND claimed_by = {me}")
		return r.Affected == 1
	}
	let ms = Backoff(j.Attempts) / 1000000
	let r = try c.Exec("UPDATE events SET state = 'ready', lease_until = NULL, claimed_by = '', last_error = {why}, next_at = now() + make_interval(secs => {ms}::float8 / 1000) WHERE id = {j.Id} AND state = 'claimed' AND claimed_by = {me}")
	return r.Affected == 1
}

// Release gives a job back unfinished (its worker is stopping): ready at once, and the attempt not counted.
fn Release(c postgres.Client, id i64, me str) !bool {
	let r = try c.Exec("UPDATE events SET state = 'ready', lease_until = NULL, claimed_by = '', attempts = greatest(attempts - 1, 0) WHERE id = {id} AND state = 'claimed' AND claimed_by = {me}")
	return r.Affected == 1
}

// QueueStats is the queue's ready, claimed and dead counts and the age of the oldest ready job.
fn QueueStats(c postgres.Client) !Stats {
	let rows = try c.Query("SELECT count(*) FILTER (WHERE state = 'ready'), count(*) FILTER (WHERE state = 'claimed'), count(*) FILTER (WHERE state = 'dead'), coalesce(extract(epoch FROM now() - min(next_at) FILTER (WHERE state = 'ready' AND next_at <= now()))::bigint, 0) FROM events")
	let r = rows.Rows[0]
	return Stats{Ready: r[0].Int(), Claimed: r[1].Int(), Dead: r[2].Int(), OldestAge: r[3].Int()}
}

// KindStats is one kind's ready and dead jobs and the age in seconds of its oldest ready job.
type KindStats struct {
	Kind      str
	Ready     i64
	Dead      i64
	OldestAge i64
}

// StatsByKind is QueueStats for each kind that has ready or dead jobs.
fn StatsByKind(c postgres.Client) ![]KindStats {
	let rows = try c.Query("SELECT kind, count(*) FILTER (WHERE state = 'ready'), count(*) FILTER (WHERE state = 'dead'), coalesce(extract(epoch FROM now() - min(next_at) FILTER (WHERE state = 'ready' AND next_at <= now()))::bigint, 0) FROM events WHERE state IN ('ready', 'dead') GROUP BY kind ORDER BY kind")
	mut out = []KindStats{}
	for r in rows.Rows {
		out = append(out, KindStats{Kind: r[0].Text(), Ready: r[1].Int(), Dead: r[2].Int(), OldestAge: r[3].Int()})
	}
	return out
}

// WorkerName names this process's workers in claimed_by: host, process id and a slot.
fn WorkerName(slot i64) str {
	return ProcessName() + "{slot}"
}

// Runner runs the handlers of a worker: one loop per slot, each claiming one job at a time.
type Runner struct {
	Db       postgres.Client
	Handlers []Handler
	Lease    i64
	Poll     i64
}

fn (r Runner) kinds() []str {
	mut out = []str{}
	for h in r.Handlers {
		out = append(out, h.Kind)
	}
	return out
}

fn (r Runner) handler(kind str) ?Handler {
	for h in r.Handlers {
		if h.Kind == kind {
			return h
		}
	}
	return nil
}

// runJob runs one job inside its kind's budget; the fault is the job's.
fn runJob(h Handler, j Job) ! {
	let run = h.Run
	let d = h.Within
	let mem = h.Memory
	let tasks = h.Tasks
	if h.Memory > 0 && h.Tasks > 0 {
		try within d {
			try limit memory mem, tasks tasks {
				try guard {
					try run(j)
				}
			}
		}
		return
	}
	if h.Memory > 0 {
		try within d {
			try limit memory mem {
				try guard {
					try run(j)
				}
			}
		}
		return
	}
	try within d {
		try guard {
			try run(j)
		}
	}
}

// Step claims and runs at most one job; it returns false when there was none.
fn (r Runner) Step(me str) !bool {
	let jobs = try Claim(r.Db, me, r.kinds(), 1, r.Lease)
	if len(jobs) == 0 {
		return false
	}
	let j = jobs[0]
	let h = r.handler(j.Kind)
	if h == nil {
		_ = try Failed(r.Db, j, me, "no handler for kind {j.Kind}", 1)
		return true
	}
	let err = runJob(h, j)
	if err == nil {
		_ = try Done(r.Db, j.Id, me)
		return true
	}
	// a drain cancels the job: it goes back for another worker, not counted as a failure
	if fault.Is(err, fault.Canceled) || fault.Is(err, fault.Draining) {
		_ = Release(r.Db, j.Id, me) catch _ {
			false
		}
		fail err
	}
	herald.Log(herald.LWarn, "job failed", []str{"id", mint.Itoa(j.Id), "kind", j.Kind, "attempt", mint.Itoa(j.Attempts), "error", fault.Message(err)})
	mut most = h.MaxAttempts
	if most <= 0 {
		most = 10
	}
	_ = try Failed(r.Db, j, me, fault.Message(err), most)
	return true
}

// stepCode is Step as a number: 1 a job ran, 0 none was ready (or the step failed, logged), -1 the task is cancelled.
fn (r Runner) stepCode(me str) i64 {
	let (got, err) = r.Step(me)
	if err != nil {
		if fault.Is(err, fault.Canceled) || fault.Is(err, fault.Draining) {
			return -1
		}
		herald.Log(herald.LError, "worker", []str{"worker", me, "error", fault.Message(err)})
		return 0
	}
	if got {
		return 1
	}
	Reap(r.Db) catch _ {
		0
	}
	return 0
}

// Loop runs Step until the task is cancelled (the drain): when the queue is empty it reaps expired leases and waits
// r.Poll. Each step runs in an arena, so a loop that lives for days keeps nothing it does not need.
fn (r Runner) Loop(slot i64) {
	let me = WorkerName(slot)
	let poll = r.Poll
	for {
		let busy = arena {
			r.stepCode(me)
		}
		if busy < 0 {
			return
		}
		if busy == 0 {
			mut stop = false
			hearth.Quiet(fn() {
				tide.Wait(poll) catch _ {
					stop = true
				}
			})
			if stop {
				return
			}
		}
	}
}

// ProcessName is the prefix of every WorkerName in this process.
fn ProcessName() str {
	let host = quarry.Hostname() catch _ {
		"host"
	}
	return "{host}/{quarry.Pid()}/"
}

// ReleaseAll gives back every job this process's workers hold, as a stopping worker does after the drain cancelled
// its loops (a cancelled task can no longer reach Postgres, so this runs in on core.stop).
fn ReleaseAll(c postgres.Client) !i64 {
	let prefix = ProcessName()
	let r = try c.Exec("UPDATE events SET state = 'ready', lease_until = NULL, claimed_by = '', attempts = greatest(attempts - 1, 0) WHERE state = 'claimed' AND starts_with(claimed_by, {prefix})")
	return r.Affected
}
