package db

import "postgres"
import "quarry"

// The database tests use: TINHUB_TEST_DB names it (host:port/name), TINHUB_TEST_DB_USER and TINHUB_TEST_DB_PASSWORD
// sign in. Without TINHUB_TEST_DB the tests that need Postgres are skipped.

// TestOptions is the test database's options, and false when none is configured.
fn TestOptions() (Options, bool) {
	let spec = quarry.Getenv("TINHUB_TEST_DB")
	if len(spec) == 0 {
		return Options{Addr: "", User: "", Password: "", Name: "", MaxTotal: 0}, false
	}
	mut addr = spec
	mut name = "tinhub_test"
	for i in 0..len(spec) {
		if spec[i] == '/' {
			addr = spec[0:i]
			name = spec[i + 1:]
			break
		}
	}
	return Options{Addr: addr, User: quarry.Getenv("TINHUB_TEST_DB_USER"), Password: quarry.Getenv("TINHUB_TEST_DB_PASSWORD"), Name: name, MaxTotal: 0}, true
}

// ResetForTests empties the test database: every table of the public schema is dropped. Only tests call it.
fn ResetForTests(c postgres.Client) ! {
	_ = try c.Exec("DROP SCHEMA public CASCADE")
	_ = try c.Exec("CREATE SCHEMA public")
}
