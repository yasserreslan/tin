package db

import "crucible"
import "fault"
import "postgres"

// Tests for the migrations (#1008). The schema tests need Postgres (TINHUB_TEST_DB); two migrators racing each other
// are run by tests/run.sh as two processes.

fn TestMigrationFiles(t mut crucible.T) {
	let ms = Migrations() catch err {
		t.Error("migrations: {err}")
		return
	}
	t.True("at least one", len(ms) >= 1)
	crucible.Equal(mut t, "first", ms[0].Name, "init")
	crucible.Equal(mut t, "numbered", ms[0].Version, 1)
}

fn fresh(t mut crucible.T) ?postgres.Client {
	let (o, ok) = TestOptions()
	if !ok {
		t.Log("TINHUB_TEST_DB is not set: skipped")
		return nil
	}
	let c = Open(o)
	ResetForTests(c) catch err {
		t.Error("reset: {err}")
		return nil
	}
	return c
}

fn TestMigrate(t mut crucible.T) {
	let got = fresh(mut t)
	if got == nil {
		return
	}
	let c = got
	t.HasFault("not current before", Current(c))
	let n = Migrate(c) catch err {
		t.Error("migrate: {err}")
		return
	}
	let want = Newest() catch _ {
		-1
	}
	crucible.Equal(mut t, "applied all", n, want)
	t.NoFault("current after", Current(c))
	let again = Migrate(c) catch err {
		t.Error("migrate again: {err}")
		return
	}
	crucible.Equal(mut t, "second run applies none", again, 0)
	_ = c.Exec("INSERT INTO schema_migrations (version, name) VALUES (9999, 'future')") catch err {
		t.Error("insert: {err}")
		Result0()
	}
	let e = Current(c)
	t.True("newer database refused", e != nil && fault.Is(e, ErrSchema))
}

fn Result0() postgres.Result {
	return postgres.Result{Affected: 0}
}

// refused runs a statement that must break a constraint.
fn refused(t mut crucible.T, c postgres.Client, label str, q query) {
	let (_, err) = c.Exec(q)
	t.True(label, err != nil)
}

fn TestConstraints(t mut crucible.T) {
	let got = fresh(mut t)
	if got == nil {
		return
	}
	let c = got
	Migrate(c) catch err {
		t.Error("migrate: {err}")
		return
	}
	let setup = c.Exec("INSERT INTO owners (name, kind) VALUES ('ana', 'user'), ('tin', 'org')") catch err {
		t.Error("owners: {err}")
		Result0()
	}
	crucible.Equal(mut t, "owners", setup.Affected, 2)
	refused(mut t, c, "one owner per name", "INSERT INTO owners (name, kind) VALUES ('ana', 'org')")
	refused(mut t, c, "owner names are lower case", "INSERT INTO owners (name, kind) VALUES ('Ana', 'user')")
	refused(mut t, c, "owner kind", "INSERT INTO owners (name, kind) VALUES ('bob', 'robot')")
	_ = c.Exec("INSERT INTO repos (owner_id, name, visibility, quota_bytes) SELECT id, 'tin', 'public', 1000 FROM owners WHERE name = 'tin'") catch err {
		t.Error("repo: {err}")
		Result0()
	}
	refused(mut t, c, "one repo per owner and name, any case", "INSERT INTO repos (owner_id, name, visibility, quota_bytes) SELECT id, 'TIN', 'public', 1000 FROM owners WHERE name = 'tin'")
	refused(mut t, c, "repo visibility", "INSERT INTO repos (owner_id, name, visibility, quota_bytes) SELECT id, 'x', 'secret', 1000 FROM owners WHERE name = 'tin'")
	refused(mut t, c, "repo name", "INSERT INTO repos (owner_id, name, visibility, quota_bytes) SELECT id, 'a/b', 'public', 1000 FROM owners WHERE name = 'tin'")
	_ = c.Exec("UPDATE repos SET deleted_at = now() WHERE name = 'tin'") catch err {
		t.Error("soft delete: {err}")
		Result0()
	}
	let (_, reuse) = c.Exec("INSERT INTO repos (owner_id, name, visibility, quota_bytes) SELECT id, 'tin', 'private', 1000 FROM owners WHERE name = 'tin'")
	t.NoFault("a deleted repo's name is free again", reuse)
	let h = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
	_ = c.Exec("INSERT INTO refs (repo_id, name, target) SELECT id, 'refs/heads/main', {h} FROM repos WHERE deleted_at IS NULL") catch err {
		t.Error("ref: {err}")
		Result0()
	}
	refused(mut t, c, "one ref per repo and name", "INSERT INTO refs (repo_id, name, target) SELECT id, 'refs/heads/main', 'x' FROM repos WHERE deleted_at IS NULL")
	_ = c.Exec("INSERT INTO packs (repo_id, hash, state) SELECT id, {h}, 'pending' FROM repos WHERE deleted_at IS NULL") catch err {
		t.Error("pack: {err}")
		Result0()
	}
	refused(mut t, c, "one pack per repo and hash", "INSERT INTO packs (repo_id, hash, state) SELECT id, {h}, 'pending' FROM repos WHERE deleted_at IS NULL")
	refused(mut t, c, "a live pack has live_at", "UPDATE packs SET state = 'live'")
	let (_, live) = c.Exec("UPDATE packs SET state = 'live', live_at = now()")
	t.NoFault("pending to live", live)
	refused(mut t, c, "pack hash is hex", "INSERT INTO packs (repo_id, hash, state) SELECT id, 'xyz', 'pending' FROM repos WHERE deleted_at IS NULL")
	_ = c.Exec("INSERT INTO changes (repo_id, change_id, version, commit_id, op) SELECT id, 'kzvqt', 1, {h}, 1 FROM repos WHERE deleted_at IS NULL") catch err {
		t.Error("change: {err}")
		Result0()
	}
	refused(mut t, c, "one row per change version", "INSERT INTO changes (repo_id, change_id, version, commit_id, op) SELECT id, 'kzvqt', 1, {h}, 2 FROM repos WHERE deleted_at IS NULL")
	refused(mut t, c, "a claimed event has a lease", "INSERT INTO events (kind, state) VALUES ('push', 'claimed')")
	refused(mut t, c, "a grant names a user or a team", "INSERT INTO grants (repo_id, role) SELECT id, 'read' FROM repos WHERE deleted_at IS NULL")
}
