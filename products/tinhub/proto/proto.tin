package proto

import "../../tit/transport"
import "../accounts"
import "../capsules"
import "../packs"
import "../repo"
import "../signin"
import "anvil"
import "fault"
import "io"
import "postgres"
import "tide"
import "twine"

// The tit protocol on tinhub (design/tinhub.md §4, #1018): tit's streaming transport.Server, made for each request
// over the repository's PgRepo, at /<owner>/<repo>/tit/v1/*. Heads and fetch need read access (none for a public
// repository), a push needs write access; a private repository answers 404 to anyone outside it, as if it did not
// exist. The signer's keys come from the keys table and nonces are signed with secrets.nonce, the same on every node.

// Deps is what the protocol needs, set on every core (Configure) before the first request.
type Deps struct {
	Db    postgres.Client
	Store dyn packs.PackStore
	Cache repo.RefCache
	// Dir is packs.dir; NonceKey secrets.nonce
	Dir      str
	NonceKey secret str
	// Pack and Refs are limits.pack and limits.refs; PushWithin and PushMemory push.deadline and push.memory
	Pack       i64
	Refs       i64
	PushWithin i64
	PushMemory i64
	// FetchWithin and FetchMemory bound a heads or fetch request (design §8: 10m, 256mb)
	FetchWithin i64
	FetchMemory i64
}

// deps is this core's: globals are per core.
mut deps ?Deps = nil

// Configure sets this core's dependencies.
fn Configure(d Deps) {
	deps = keep(d)
}

// Mount adds the protocol's routes to r.
fn Mount(r mut anvil.Router) {
	r.Stream("POST", `/{owner}/{repo}/tit/v1/{rest...}`, post)
	r.Get(`/{owner}/{repo}/tit/v1/{rest...}`, get)
}

fn now() i64 {
	return tide.Wall() / tide.Second
}

// reply writes a protocol answer.
fn reply(w mut anvil.Out, r transport.Reply) {
	w.Status(r.Status)
	if len(r.Body) > 0 && r.Body[0] == '{' {
		w.Type("application/json")
	} else {
		w.Type("application/x-tit")
	}
	w.Body = []u8(r.Body)
}

// refuse answers a refusal as tit's server words it: code is a transport code name.
fn refuse(w mut anvil.Out, status i64, code str, message str) {
	w.Status(status)
	w.Type("application/x-tit")
	w.Body = []u8(transport.Frame(transport.Kind.Error, transport.Encode(transport.ErrorAnswer{Code: code, Message: message, Ref: "", Nonce: ""}), ""))
}

// notFound is the answer for a repository that does not exist, and for a private one to anyone outside it.
fn notFound(w mut anvil.Out, owner str, name str) {
	refuse(mut w, 404, "NotFound", "no repository {owner}/{name}")
}

// hidden answers a request for a repository that does not exist, or that its caller cannot read. Unsigned, it is a
// challenge (Unauthorized, with a nonce to sign with), the same for both, so a private repository's name is not
// revealed and tit can sign its next attempt (tit clone, tit login); signed, it is NotFound.
fn hidden(w mut anvil.Out, d Deps, sig str, owner str, name str) {
	if len(sig) > 0 {
		notFound(mut w, owner, name)
		return
	}
	w.Status(401)
	w.Type("application/x-tit")
	let nonce = transport.NewNonce(d.NonceKey, now())
	w.Body = []u8(transport.Frame(transport.Kind.Error, transport.Encode(transport.ErrorAnswer{Code: "Unauthorized", Message: "sign the request to read {owner}/{name}", Ref: "", Nonce: nonce}), ""))
}

// Access is a request's repository, its server, and the role its signer (or nobody) has there.
type Access struct {
	Repo   accounts.Repo
	Role   i64
	Server transport.Server
	Deps   Deps
}

// access works out a request's repository and role and makes its server; nil when the answer is written already.
fn access(q anvil.Req, w mut anvil.Out) ?Access {
	let got = deps
	if got == nil {
		refuse(mut w, 503, "Internal", "the protocol is not configured on this core")
		return nil
	}
	let d = got
	let owner = q.PathParam("owner")
	mut name = q.PathParam("repo")
	if twine.HasSuffix(name, ".tit") {
		name = name[0:len(name) - 4]
	}
	let found = accounts.FindRepo(d.Db, owner, name) catch err {
		refuse(mut w, 503, "Internal", fault.Message(err))
		return nil
	}
	if found == nil {
		hidden(mut w, d, q.Header("tit-signature"), owner, name)
		return nil
	}
	let r = found
	mut userId = 0
	mut email = ""
	mut keys = [][]u8{}
	let sig = q.Header("tit-signature")
	if len(sig) > 0 {
		let (who, _, _) = transport.ParseSignatureHeader(sig) catch err {
			refuse(mut w, 401, "Unauthorized", fault.Message(err))
			return nil
		}
		let u = accounts.UserByEmail(d.Db, who) catch err {
			refuse(mut w, 503, "Internal", fault.Message(err))
			return nil
		}
		if u != nil {
			userId = u.Id
			email = u.Email
			keys = accounts.KeysOf(d.Db, u.Id) catch err {
				refuse(mut w, 503, "Internal", fault.Message(err))
				return nil
			}
		}
	}
	let role = accounts.RoleOf(d.Db, userId, r) catch err {
		refuse(mut w, 503, "Internal", fault.Message(err))
		return nil
	}
	if role == accounts.RoleNone {
		hidden(mut w, d, sig, owner, name)
		return nil
	}
	let pg = repo.PgRepo{Db: d.Db, Store: d.Store, Cache: d.Cache, Id: r.Id, Dir: d.Dir, Who: userId}
	mut s = transport.NewRepoServer(pg, d.NonceKey, r.Visibility == "public")
	for k in keys {
		s.Allow(email, k)
	}
	// replay capsules (design/tit.md §17): the repository's, as far as this signer's role and replay grant allow
	s.SetReplays(capsules.StoreFor(r, userId, role))
	// a push never takes the repository past its quota
	mut most = d.Pack
	let room = r.QuotaBytes - r.SizeBytes
	if room < most {
		most = room
	}
	if most < 0 {
		most = 0
	}
	s.SetLimits(transport.Limits{Pack: most, Refs: d.Refs})
	return Access{Repo: r, Role: role, Server: s, Deps: d}
}

// get answers heads (and every other GET tit's server knows).
fn get(q anvil.Req, w mut anvil.Out) {
	if signin.Handles(q.Path) {
		signin.Serve(q, mut w)
		return
	}
	let a = access(q, mut w)
	if a == nil {
		return
	}
	let d = a.Deps
	let (r, err) = answer(a.Server, q, d.FetchWithin, d.FetchMemory)
	if err != nil {
		reply(mut w, a.Server.Refusal(err, now()))
		return
	}
	reply(mut w, r)
}

// answer is the server's answer to a request with a small body, inside the request's budget.
fn answer(srv transport.Server, q anvil.Req, within_ i64, mem i64) !transport.Reply {
	mut out = transport.Reply{Status: 500, Body: ""}
	try within within_ {
		// + 0: a bare name before the block is read as a struct literal (#1070)
		try limit memory mem + 0 {
			mut s = srv
			out = s.Handle(q.Method, q.Path, q.Header("tit-signature"), q.Body(), now())
		}
	}
	return out
}

// post answers a push (streamed to a file as it arrives), a fetch (its pack streamed out an entry at a time), and
// the other POSTs tit's server knows.
fn post(q anvil.Req, w mut anvil.Out) {
	if signin.Handles(q.Path) {
		// tit login and tit key add take a remote's URL: sign-in answers under every repository's too
		mut b = q.BodyStream()
		let body = readBody(mut b, 64 * 1024) catch err {
			refuse(mut w, 413, "TooLarge", fault.Message(err))
			return
		}
		signin.ServeBody(q, mut w, body)
		return
	}
	let a = access(q, mut w)
	if a == nil {
		return
	}
	let d = a.Deps
	mut srv = a.Server
	let body = q.BodyStream()
	if twine.HasSuffix(q.Path, "/tit/v1/push") {
		if a.Role < accounts.RoleWrite {
			// unsigned (tit ship's tag push opens with no nonce, #1029): a challenge, so tit signs its next attempt
			if len(q.Header("tit-signature")) == 0 {
				w.Status(401)
				w.Type("application/x-tit")
				let nonce = transport.NewNonce(d.NonceKey, now())
				w.Body = []u8(transport.Frame(transport.Kind.Error, transport.Encode(transport.ErrorAnswer{Code: "Unauthorized", Message: "sign the request to push to {a.Repo.Owner}/{a.Repo.Name}", Ref: "", Nonce: nonce}), ""))
				return
			}
			refuse(mut w, 403, "Unauthorized", "you can read {a.Repo.Owner}/{a.Repo.Name} but not push to it")
			return
		}
		let (r, err) = push(srv, q, body, d.PushWithin, d.PushMemory)
		if err != nil {
			reply(mut w, srv.Refusal(err, now()))
			return
		}
		reply(mut w, r)
		return
	}
	mut b = body
	if !twine.HasSuffix(q.Path, "/tit/v1/fetch") {
		reply(mut w, transport.HandleStream(mut srv, q.Method, q.Path, q.Header("tit-signature"), mut b, now()))
		return
	}
	let req = readBody(mut b, transport.MaxHeader + 65536) catch e {
		reply(mut w, srv.Refusal(fault.Wrap(transport.ErrRefused, "BadRequest: " + fault.Message(e)), now()))
		return
	}
	// the plan (what to send) inside the fetch's budget; the pack then goes out an entry at a time, under the
	// request's deadline
	let (planned, perr) = plan(srv, q, req, d.FetchWithin, d.FetchMemory)
	if perr != nil {
		reply(mut w, srv.Refusal(perr, now()))
		return
	}
	mut f = planned
	w.Status(200)
	w.Type("application/x-tit")
	w.Stream() catch _ {
		return
	}
	mut o = outWriter{w: w}
	let (_, herr) = o.Write([]u8(f.Head))
	if herr != nil {
		return
	}
	transport.SendFetch(mut f, mut o) catch _ {
		// the answer has begun: the client sees a cut pack, which it refuses (its trailing hash)
		w.Abort()
	}
}

// push receives a push inside push.deadline and push.memory.
fn push(srv transport.Server, q anvil.Req, body anvil.BodyReader, within_ i64, mem i64) !transport.Reply {
	mut out = transport.Reply{Status: 500, Body: ""}
	try within within_ {
		// + 0: a bare name before the block is read as a struct literal (#1070)
		try limit memory mem + 0 {
			mut s = srv
			mut b = body
			out = transport.HandleStream(mut s, q.Method, q.Path, q.Header("tit-signature"), mut b, now())
		}
	}
	return out
}

// plan checks a fetch and works out what to send.
fn plan(srv transport.Server, q anvil.Req, req str, within_ i64, mem i64) !transport.Fetching {
	mut out ?transport.Fetching = nil
	try within within_ {
		// + 0: a bare name before the block is read as a struct literal (#1070)
		try limit memory mem + 0 {
			mut s = srv
			let f = try s.StartFetch(q.Path, q.Header("tit-signature"), req, now())
			out = keep(f)
		}
	}
	if out == nil {
		fail fault.Wrap(transport.ErrRefused, "Internal: the fetch was not planned")
	}
	return out
}

// outWriter is an anvil response streamed as an io.Writer.
type outWriter struct {
	w anvil.Out
}

// Write sends data.
fn (o mut outWriter) Write(data []u8) !i64 {
	try o.w.Write(data)
	return len(data)
}

// readBody reads a whole small body, refusing one longer than most bytes.
fn readBody[R io.Reader](body mut R, most i64) !str {
	mut out = []u8{}
	mut buf = make([]u8, 64 * 1024)
	for {
		let k = try body.Read(mut buf)
		if k == 0 {
			break
		}
		if len(out) + k > most {
			fail fault.Wrap(transport.ErrRefused, "TooLarge: a body larger than {most} bytes")
		}
		out = append(out, buf[0:k]...)
	}
	return str(out)
}
