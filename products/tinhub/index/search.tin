package index

import "../../tit/change"
import "../accounts"
import "anvil"
import "argo"
import "fault"
import "mint"
import "tide"
import "twine"

// Search by declaration (#1020): a repository's symbols at a head or a change, and one name across every repository
// the caller can read (at each one's default branch). A query is a name, optionally after a kind ("fn:ReadFile",
// "type:Repo", "method:PgRepo.Commit"); within a repository it matches names that start with it, across
// repositories names that are it, ignoring case. A private repository the caller cannot read is never searched.

const readWithin = 2 * tide.Second

const readMemory = 16 * 1024 * 1024

const pageMax = 200

const pageSize = 50

// candidateMost is how many repositories holding a name a search checks access to.
const candidateMost = 2000

// Mount adds the search routes to r.
fn Mount(r mut anvil.Router) {
	r.Get(`/api/v1/repos/{owner}/{repo}/symbols`, repoSymbols)
	r.Get("/api/v1/search", search)
}

type apiError struct {
	code    str
	message str
}

fn fail_(w mut anvil.Out, status i64, code str, message str) {
	w.Status(status)
	w.Json()
	w.Body = []u8{}
	argo.Put(mut w.Body, apiError{code: code, message: message})
}

fn send[T](w mut anvil.Out, v T) {
	w.Json()
	w.Body = []u8{}
	argo.Put(mut w.Body, v)
}

fn pageLimit(q anvil.Req) i64 {
	let n = mint.Atoi(q.Param("limit")) catch _ {
		pageSize
	}
	if n < 1 {
		return pageSize
	}
	return min(n, pageMax)
}

// offsetOf is a page cursor: the rows before the page.
fn offsetOf(cursor str) ?i64 {
	if len(cursor) == 0 {
		return 0
	}
	let n = mint.Atoi(cursor) catch _ {
		return nil
	}
	if n < 0 {
		return nil
	}
	return n
}

// Query is a parsed search: the kind ("" for any), the receiver of a method ("" for any) and the name.
type Query struct {
	Kind str
	Recv str
	Name str
}

// ParseQuery reads "kind:Name", "Type.Method" and "Name".
fn ParseQuery(q str) Query {
	mut kind = ""
	mut rest = twine.TrimSpace(q)
	let (k, after, ok) = twine.Cut(rest, ":")
	if ok && isKind(k) {
		kind = k
		rest = after
	}
	mut recv = ""
	let dot = twine.LastIndex(rest, ".")
	if dot > 0 {
		recv = rest[0:dot]
		rest = rest[dot + 1:]
		if len(kind) == 0 {
			kind = "method"
		}
	}
	return Query{Kind: kind, Recv: recv, Name: rest}
}

// likePrefix is a LIKE pattern for the names starting with s, ignoring case.
fn likePrefix(s str) str {
	mut out = []u8{}
	let low = twine.ToLower(s)
	for i in 0..len(low) {
		let c = low[i]
		if c == '\\' || c == '%' || c == '_' {
			out = append(out, '\\')
		}
		out = append(out, c)
	}
	out = append(out, '%')
	return str(out)
}

type symOut struct {
	@json("package") pkg str
	name     str
	kind     str
	recv     str
	file     str
	line     i64
	end_line i64
}

type repoSymbolsOut struct {
	commit  str
	indexed bool
	symbols []symOut
	next    str
}

// repoSymbols is GET /api/v1/repos/{owner}/{repo}/symbols?q=&ref=&change=: the symbols of the commit a head (ref,
// by default the default branch) or a change (its newest version) names.
fn repoSymbols(q anvil.Req, w mut anvil.Out) {
	let d = deps
	if d == nil {
		fail_(mut w, 503, "unavailable", "the index is not configured on this core")
		return
	}
	let auth = d.Auth
	let user = auth(q) catch err {
		fail_(mut w, 401, "unauthorized", fault.Message(err))
		return
	}
	let owner = q.PathParam("owner")
	let name = q.PathParam("repo")
	let found = accounts.FindRepo(d.Db, owner, name) catch err {
		fail_(mut w, 503, "unavailable", fault.Message(err))
		return
	}
	if found == nil {
		fail_(mut w, 404, "not_found", "no repository {owner}/{name}")
		return
	}
	let role = accounts.RoleOf(d.Db, user, found) catch err {
		fail_(mut w, 503, "unavailable", fault.Message(err))
		return
	}
	if role == accounts.RoleNone {
		fail_(mut w, 404, "not_found", "no repository {owner}/{name}")
		return
	}
	let off = offsetOf(q.Param("cursor"))
	if off == nil {
		fail_(mut w, 400, "bad_request", "bad cursor")
		return
	}
	let (out, err) = readRepoSymbols(d, found, q.Param("ref"), q.Param("change"), ParseQuery(q.Param("q")), off, pageLimit(q))
	if err != nil {
		if fault.Is(err, ErrNoRef) {
			fail_(mut w, 404, "not_found", fault.Message(err))
			return
		}
		fail_(mut w, 503, "unavailable", fault.Message(err))
		return
	}
	send(mut w, out)
}

// ErrNoRef is the fault of a ref or change the repository does not have.
let ErrNoRef = fault("no such ref")

// commitOf is the commit a ref or a change names in a repository.
fn commitOf(d Deps, r accounts.Repo, ref str, ch str) !str {
	let repoId = r.Id
	if len(ch) > 0 {
		let rows = try d.Db.Query("SELECT commit_id FROM changes WHERE repo_id = {repoId} AND change_id = {ch} ORDER BY version DESC LIMIT 1")
		if len(rows.Rows) == 0 {
			fail fault.Wrap(ErrNoRef, "no change {ch}")
		}
		return rows.Rows[0][0].Text()
	}
	mut name = ref
	if len(name) == 0 {
		name = "refs/heads/" + r.DefaultBranch
	} else if !twine.HasPrefix(name, "refs/") {
		name = "refs/heads/" + name
	}
	let rows = try d.Db.Query("SELECT target FROM refs WHERE repo_id = {repoId} AND name = {name}")
	if len(rows.Rows) == 0 {
		fail fault.Wrap(ErrNoRef, "no ref {name}")
	}
	let t = try change.ParseTarget(rows.Rows[0][0].Text())
	return match t {
		Commit(id) => id.Hex()
		Change(cid) => try commitOf(d, r, "", cid.Letters())
	}
}

fn readRepoSymbols(d Deps, r accounts.Repo, ref str, ch str, qy Query, off i64, n i64) !repoSymbolsOut {
	let commit = try commitOf(d, r, ref, ch)
	let repoId = r.Id
	mut out = repoSymbolsOut{commit: commit, indexed: false, symbols: []symOut{}, next: ""}
	try within readWithin {
		try limit memory readMemory {
			mut page = repoSymbolsOut{commit: commit, indexed: false, symbols: []symOut{}, next: ""}
			page.indexed = try Indexed(d.Db, repoId, commit)
			let pattern = likePrefix(qy.Name)
			let kind = qy.Kind
			let recv = qy.Recv
			let more = n + 1
			let rows = try d.Db.Query("SELECT package, name, kind, recv, file, line, end_line FROM symbols WHERE repo_id = {repoId} AND commit_id = {commit} AND ({kind} = '' OR kind = {kind}) AND ({recv} = '' OR lower(recv) = lower({recv})) AND lower(name) LIKE {pattern} ESCAPE '\\' ORDER BY lower(name), file, line LIMIT {more} OFFSET {off}")
			for i, row in rows.Rows {
				if i == n {
					page.next = "{off + n}"
					break
				}
				page.symbols = append(page.symbols, symOut{pkg: row[0].Text(), name: row[1].Text(), kind: row[2].Text(), recv: row[3].Text(), file: row[4].Text(), line: row[5].Int(), end_line: row[6].Int()})
			}
			out = keep(page)
		}
	}
	return out
}

type hitOut struct {
	owner    str
	repo     str
	commit   str
	@json("package") pkg str
	name     str
	kind     str
	recv     str
	file     str
	line     i64
	end_line i64
}

type searchOut struct {
	query   str
	results []hitOut
	next    str
}

// search is GET /api/v1/search?q=: the declarations named q at the default branch of every repository the caller can
// read.
fn search(q anvil.Req, w mut anvil.Out) {
	let d = deps
	if d == nil {
		fail_(mut w, 503, "unavailable", "the index is not configured on this core")
		return
	}
	let auth = d.Auth
	let user = auth(q) catch err {
		fail_(mut w, 401, "unauthorized", fault.Message(err))
		return
	}
	let text = q.Param("q")
	let qy = ParseQuery(text)
	if len(qy.Name) == 0 {
		fail_(mut w, 400, "bad_request", "q names nothing: give a name, as in ?q=fn:ReadFile")
		return
	}
	let off = offsetOf(q.Param("cursor"))
	if off == nil {
		fail_(mut w, 400, "bad_request", "bad cursor")
		return
	}
	let (out, err) = Search(d, user, text, off, pageLimit(q))
	if err != nil {
		fail_(mut w, 503, "unavailable", fault.Message(err))
		return
	}
	send(mut w, out)
}

// Search is one page of the declarations a query names, at the default branch of every repository user (0 for
// nobody) can read; off is the rows before the page.
fn Search(d Deps, user i64, text str, off i64, n i64) !searchOut {
	let qy = ParseQuery(text)
	mut out = searchOut{query: text, results: []hitOut{}, next: ""}
	try within readWithin {
		try limit memory readMemory {
			mut page = searchOut{query: text, results: []hitOut{}, next: ""}
			let name = qy.Name
			let kind = qy.Kind
			let recv = qy.Recv
			// the repositories holding the name at their default branch, and of those the ones user can read
			let cands = try d.Db.Query("SELECT DISTINCT o.name, r.name FROM symbols s JOIN repos r ON r.id = s.repo_id AND r.deleted_at IS NULL JOIN owners o ON o.id = r.owner_id JOIN refs f ON f.repo_id = r.id AND f.name = 'refs/heads/' || r.default_branch AND f.target = s.commit_id WHERE lower(s.name) = lower({name}) AND ({kind} = '' OR s.kind = {kind}) AND ({recv} = '' OR lower(s.recv) = lower({recv})) ORDER BY 1, 2 LIMIT {candidateMost}")
			mut ids = []str{}
			for row in cands.Rows {
				let found = try accounts.FindRepo(d.Db, row[0].Text(), row[1].Text())
				if found == nil {
					continue
				}
				let role = try accounts.RoleOf(d.Db, user, found)
				if role != accounts.RoleNone {
					ids = append(ids, "{found.Id}")
				}
			}
			let allowed = twine.Join(ids, ",")
			let more = n + 1
			let rows = try d.Db.Query("SELECT o.name, r.name, s.commit_id, s.package, s.name, s.kind, s.recv, s.file, s.line, s.end_line FROM symbols s JOIN repos r ON r.id = s.repo_id AND r.deleted_at IS NULL JOIN owners o ON o.id = r.owner_id JOIN refs f ON f.repo_id = r.id AND f.name = 'refs/heads/' || r.default_branch AND f.target = s.commit_id WHERE r.id = ANY(string_to_array({allowed}, ',')::bigint[]) AND lower(s.name) = lower({name}) AND ({kind} = '' OR s.kind = {kind}) AND ({recv} = '' OR lower(s.recv) = lower({recv})) ORDER BY o.name, r.name, s.file, s.line LIMIT {more} OFFSET {off}")
			for i, row in rows.Rows {
				if i == n {
					page.next = "{off + n}"
					break
				}
				page.results = append(page.results, hitOut{owner: row[0].Text(), repo: row[1].Text(), commit: row[2].Text(), pkg: row[3].Text(), name: row[4].Text(), kind: row[5].Text(), recv: row[6].Text(), file: row[7].Text(), line: row[8].Int(), end_line: row[9].Int()})
			}
			out = keep(page)
		}
	}
	return out
}
