package index

import "../../tit/object"
import "../../tit/semantic"
import "../../tit/store"
import "argo"
import "fault"
import "herald"
import "quarry"
import "sandbox"
import "spawn"
import "tide"
import "twine"

// The compiler as a child process: a commit's Tin files are written to a checkout, and `tinc -symbols -json` runs on
// them in batches, each in packages/sandbox (no network, read-only inputs, its own cgroup when one is delegated) or,
// where the host cannot build a sandbox, as a plain child process. Either way the shell around it sets ulimit -v and
// -t, the run has a timeout and its output a cap. A batch that stops the compiler before it prints any declaration (a
// syntax error, an unknown import) loses the file the error names, or is split in two, until every file that can be
// read is.

// batchFiles is how many files one compiler run checks: each run also checks the runtime, so fewer, larger runs are
// faster, while a run's output (every declaration of every file it loads) stays far below maxOutput.
const batchFiles = 300

// maxDrops is how many files a batch drops (each costs a run) before the rest of it is read without the compiler, and
// runsWithin how long the runs of one commit may take before every batch left is.
const maxDrops = 4

const runsWithin = 60 * 1000 * 1000 * 1000

// maxOutput is the most standard output one run may print; past it the batch is split.
const maxOutput = 64 * 1024 * 1024

// compilerMemory is one run's memory (ulimit -v, and memory.max with a cgroup); runTimeout its wall time and
// runCPU its CPU seconds.
const compilerMemory = 2 * 1024 * 1024 * 1024

const runTimeout = 60 * 1000 * 1000 * 1000

const runCPU = 60

// Checkout limits: the most files and bytes a checkout writes, and the largest file an embed directive brings.
const maxFiles = 100000

const maxBytes = 512 * 1024 * 1024

const maxEmbedFile = 4 * 1024 * 1024

// Sym is one declaration the compiler printed (TOOLING.md §3.3).
type Sym struct {
	kind        str
	name        str
	file        str
	line        i64
	declEndLine i64
	recv        str
}

// diag is an error the compiler printed (TOOLING.md §3.1).
type diag struct {
	file     str
	code     str
	severity str
}

// Result is what the compiler found in a set of files: the declarations, the runs it took, the files no run read (a
// syntax error, an unknown import, a run over its limits: their declarations are read from their text), and how it ran
// ("sandbox" or "process").
type Result struct {
	Syms    []Sym
	Runs    i64
	Skipped []str
	Runner  str
}

// ---- the checkout ----

type entry struct {
	path str
	id   object.Id
}

// okName refuses a tree entry name that could leave the checkout.
fn okName(name str) bool {
	if len(name) == 0 || name == "." || name == ".." {
		return false
	}
	for c in name {
		if c == '/' || c == 0 || c == '\\' {
			return false
		}
	}
	return true
}

fn walk[S store.ObjectStore](st mut S, tree object.Id, prefix str, out mut []entry, depth i64) ! {
	if depth > 64 {
		fail "index: the tree is nested more than 64 deep"
	}
	let o = try st.Get(tree)
	match o {
		Tree(es) => {
			for e in es {
				if !okName(e.Name) {
					continue
				}
				if e.Mode == object.Mode.Dir {
					try walk(mut st, e.Id, prefix + e.Name + "/", mut out, depth + 1)
				} else if e.Mode != object.Mode.Link {
					if len(out) >= maxFiles {
						fail "index: the tree has more than {maxFiles} files"
					}
					out = append(out, entry{path: prefix + e.Name, id: e.Id})
				}
			}
		}
		Commit(_) => {
			fail "index: {tree.Hex()} is not a tree"
		}
		Tag(_) => {
			fail "index: {tree.Hex()} is not a tree"
		}
		Blob(_) => {
			fail "index: {tree.Hex()} is not a tree"
		}
	}
}

fn blobOf[S store.ObjectStore](st mut S, id object.Id) !str {
	let (_, body) = try st.GetRaw(id)
	return body
}

// embedPrefixes is where the // embed: lines of a Tin file at path point: each pattern up to its first glob, relative to
// the repository's top. A pattern that climbs out of the file's directory is left out.
fn embedPrefixes(path str, text str) []str {
	mut out = []str{}
	let dir = DirOf(path)
	for line in twine.Split(text, "\n") {
		if !twine.HasPrefix(line, "// embed:") {
			continue
		}
		for p in twine.Split(twine.TrimSpace(line[9:]), " ") {
			if len(p) == 0 || twine.Contains(p, "..") || p[0] == '/' {
				continue
			}
			mut cut = len(p)
			for i in 0..len(p) {
				if p[i] == '*' || p[i] == '?' || p[i] == '[' {
					cut = i
					break
				}
			}
			mut pre = p[0:cut]
			if len(dir) > 0 {
				pre = dir + "/" + pre
			}
			out = append(out, pre)
		}
	}
	return out
}

fn writeFile(root str, path str, body str, made mut map[str]bool) ! {
	let dir = DirOf(path)
	let (_, have) = made[dir]
	if !have {
		try quarry.MkdirAll(root + "/" + dir)
		made[dir] = true
	}
	try quarry.WriteFile(root + "/" + path, body)
}

// Checkout writes a tree's Tin files under root, with the files their // embed: lines name, and returns the Tin files'
// paths in tree order.
fn Checkout[S store.ObjectStore](st mut S, tree object.Id, root str) ![]str {
	mut all = []entry{}
	try walk(mut st, tree, "", mut all, 0)
	try quarry.MkdirAll(root)
	mut made = map[str]bool{}
	made[""] = true
	mut tins = []str{}
	mut prefixes = []str{}
	mut total = 0
	for e in all {
		if !isTin(e.path) {
			continue
		}
		let body = try blobOf(mut st, e.id)
		total += len(body)
		if total > maxBytes {
			fail "index: the checkout is over {maxBytes} bytes"
		}
		try writeFile(root, e.path, body, mut made)
		tins = append(tins, e.path)
		if twine.Contains(body, "// embed:") {
			for p in embedPrefixes(e.path, body) {
				prefixes = append(prefixes, p)
			}
		}
	}
	if len(prefixes) == 0 {
		return tins
	}
	for e in all {
		if isTin(e.path) {
			continue
		}
		mut wanted = false
		for p in prefixes {
			if twine.HasPrefix(e.path, p) {
				wanted = true
				break
			}
		}
		if !wanted {
			continue
		}
		let body = try blobOf(mut st, e.id)
		if len(body) > maxEmbedFile {
			continue
		}
		total += len(body)
		if total > maxBytes {
			fail "index: the checkout is over {maxBytes} bytes"
		}
		try writeFile(root, e.path, body, mut made)
	}
	return tins
}

// ---- running the compiler ----

// sandboxState is this core's finding about the sandbox: 0 not tried, 1 it works, -1 the host cannot build one.
mut sandboxState = 0

fn tincPath(d Deps) str {
	if len(d.Tinc) > 0 {
		return d.Tinc
	}
	return rootPath(d) + "/bin/tinc"
}

fn rootPath(d Deps) str {
	if len(d.TinRoot) > 0 {
		return d.TinRoot
	}
	return quarry.Getenv("TIN_ROOT")
}

// Runner is how the compiler runs for d: "sandbox" or "process". With Sandbox "auto" the first call on a core tries to
// build a sandbox, and when the host cannot, says so in the log and runs plain child processes from then on.
fn Runner(d Deps) !str {
	if d.Sandbox == "off" {
		return "process"
	}
	if d.Sandbox == "on" || sandboxState == 1 {
		return "sandbox"
	}
	if sandboxState == -1 {
		return "process"
	}
	let probe = sandbox.Spec{Argv: []str{"/bin/sh", "-c", "exit 0"}, Env: []str{"PATH=/usr/bin:/bin"}, Dir: "", Inputs: []sandbox.Bind{}, System: []str{}, NoSystem: false, Scratch: "", ScratchPath: "", Memory: 0, CPU: 0.0, Pids: 0, Weight: 0, Timeout: runTimeout, MaxOutput: 0, Cgroup: "", Network: false}
	let r = sandbox.Run(probe) catch err {
		herald.Log(herald.LWarn, "index: no sandbox on this host; the compiler runs as a plain child process (ulimit memory and CPU, a timeout, but the host's network)", []str{"error", fault.Message(err)})
		sandboxState = -1
		return "process"
	}
	if r.Code != 0 {
		herald.Log(herald.LWarn, "index: the sandbox probe failed; the compiler runs as a plain child process (ulimit memory and CPU, a timeout, but the host's network)", []str{"stderr", r.Stderr})
		sandboxState = -1
		return "process"
	}
	sandboxState = 1
	return "sandbox"
}

// outName is the file in the scratch directory a run's output goes to. It is a file and not a pipe: the sandbox reads
// a pipe in a child task, whose buffers are not given back with the arena a run is in, while the file is read in it.
const outName = "symbols.json"

// shell is the script that runs the compiler ($0) under ulimit (memory in KiB, CPU seconds, the output file in
// 512-byte blocks) with its output in the file out.
fn shell(out str) str {
	let kb = compilerMemory / 1024
	let blocks = maxOutput / 512
	return "ulimit -v {kb} 2>/dev/null; ulimit -t {runCPU} 2>/dev/null; ulimit -f {blocks} 2>/dev/null; exec \"$0\" \"$@\" > " + out + " 2>/dev/null"
}

// readOutput is what a run wrote to its output file; broken when there is none.
fn readOutput(scratch str, broken bool) output {
	let path = scratch + "/" + outName
	let text = quarry.ReadFileBound(path, maxOutput + 1) catch _ {
		return output{text: "", broken: true}
	}
	quarry.Remove(path) catch _ {
	}
	return output{text: text, broken: broken || len(text) > maxOutput}
}

// output is one run's standard output; broken when the run did not finish normally (a signal, its timeout, its
// memory, its output cap), so what it printed may be cut short.
type output struct {
	text   str
	broken bool
}

// tool is where the compiler is and how it is limited: plain strings, so a run in an arena takes nothing of Deps.
type tool struct {
	tinc   str
	root   str
	cgroup str
}

fn toolOf(d Deps) tool {
	return tool{tinc: tincPath(d), root: rootPath(d), cgroup: d.Cgroup}
}

fn compile(d tool, runner str, src str, scratch str, files []str) !output {
	if runner == "sandbox" {
		mut argv = []str{"/bin/sh", "-c", shell("/scratch/" + outName), "/tinc", "-symbols", "-json"}
		for f in files {
			argv = append(argv, f)
		}
		mut mem = 0
		mut cpu = 0.0
		mut pids = 0
		if len(d.cgroup) > 0 {
			mem = compilerMemory
			cpu = 1.0
			pids = 64
		}
		let inputs = []sandbox.Bind{sandbox.Bind{From: d.root, To: "/tin"}, sandbox.Bind{From: d.tinc, To: "/tinc"}, sandbox.Bind{From: src, To: "/src"}}
		let spec = sandbox.Spec{Argv: argv, Env: []str{"TIN_ROOT=/tin", "PATH=/usr/bin:/bin", "HOME=/scratch", "TMPDIR=/scratch"}, Dir: "/src", Inputs: inputs, System: []str{}, NoSystem: false, Scratch: scratch, ScratchPath: "/scratch", Memory: mem, CPU: cpu, Pids: pids, Weight: 0, Timeout: runTimeout, MaxOutput: 65536, Cgroup: d.cgroup, Network: false}
		let r = try sandbox.Run(spec)
		let broken = r.TimedOut || r.OOM || r.Signal != 0 || (r.Code != 0 && r.Code != 1)
		return readOutput(scratch, broken)
	}
	mut argv = []str{"/bin/sh", "-c", shell(scratch + "/" + outName), d.tinc, "-symbols", "-json"}
	for f in files {
		argv = append(argv, f)
	}
	let env = []str{"TIN_ROOT=" + d.root, "PATH=/usr/bin:/bin", "HOME=" + scratch, "TMPDIR=" + scratch}
	let r = try spawn.Run(spawn.Cmd{Argv: argv, Env: spawn.Env.Set(env), Dir: src, Stdin: spawn.Stdio.Null, Stdout: spawn.Stdio.Null, Stderr: spawn.Stdio.Null, MaxOutput: 0, Input: ""})
	return readOutput(scratch, r.Code != 0 && r.Code != 1)
}

// step is one run's findings: the declarations of the batch's files, the batch files an error names, whether any
// error was printed, whether the run broke, and the fault that kept it from running ("" for none).
type step struct {
	syms      []Sym
	errFiles  []str
	anyErr    bool
	broken    bool
	failure   str
}

fn isKind(k str) bool {
	return k == "fn" || k == "method" || k == "type" || k == "shape" || k == "const" || k == "var"
}

// parse reads a run's JSON lines, keeping the declarations (not locals) of the files in batch.
fn parse(text str, batch map[str]bool) step {
	mut out = step{syms: []Sym{}, errFiles: []str{}, anyErr: false, broken: false, failure: ""}
	let declPrefix = "{{\"kind\":\""
	let localPrefix = "{{\"kind\":\"local\""
	for line in twine.Split(text, "\n") {
		if twine.HasPrefix(line, declPrefix) {
			if twine.HasPrefix(line, localPrefix) {
				continue
			}
			mut s = Sym{kind: "", name: "", file: "", line: 0, declEndLine: 0, recv: ""}
			argo.Get(line, mut s) catch _ {
				continue
			}
			let (_, mine) = batch[s.file]
			if mine && isKind(s.kind) {
				out.syms = append(out.syms, s)
			}
			continue
		}
		if twine.Contains(line, "\"severity\"") {
			mut g = diag{file: "", code: "", severity: ""}
			argo.Get(line, mut g) catch _ {
				continue
			}
			out.anyErr = true
			let (_, mine) = batch[g.file]
			if mine {
				out.errFiles = append(out.errFiles, g.file)
			}
		}
	}
	return out
}

fn runStep(d tool, runner str, src str, scratch str, files []str) step {
	let (o, err) = compile(d, runner, src, scratch, files)
	if err != nil {
		return step{syms: []Sym{}, errFiles: []str{}, anyErr: false, broken: false, failure: fault.Message(err)}
	}
	mut set = map[str]bool{}
	for f in files {
		set[f] = true
	}
	mut s = parse(o.text, set)
	s.broken = o.broken
	return s
}

// runStepArena is runStep in an arena: a run's output (every declaration of every file the compiler loads, megabytes)
// is dropped with it, and only the batch's declarations leave.
fn runStepArena(d tool, runner str, src str, scratch str, files []str) step {
	return arena {
		runStep(d, runner, src, scratch, files)
	}
}

// textSyms is the declarations of a file the compiler could not read, from its text (tit/semantic: the top-level
// declarations as tin fmt lays them out), so a file with a syntax error is still found by its names.
fn textSyms(src str, path str) []Sym {
	mut out = []Sym{}
	let text = quarry.ReadFile(src + "/" + path) catch _ {
		return out
	}
	let (ds, _) = semantic.Decls(text)
	for d in ds {
		let (kw, rest, _) = twine.Cut(d.Key, " ")
		mut kind = kw
		if kw == "let" || kw == "mut" {
			kind = "var"
		}
		if !isKind(kind) {
			continue
		}
		mut name = d.Name
		mut recv = ""
		if kind == "method" {
			let (r, n, _) = twine.Cut(rest, ".")
			recv = r
			name = n
		}
		// the declaration's own line: past its doc comment
		let lines = twine.Split(d.Text, "\n")
		mut first = 0
		for first < len(lines) - 1 && twine.HasPrefix(lines[first], "//") {
			first += 1
		}
		out = append(out, Sym{kind: kind, name: name, file: path, line: d.Line + first, declEndLine: d.Line + len(lines) - 1, recv: recv})
	}
	return out
}

// textSymsArena is textSyms in an arena: the file's text and its declarations' copies are dropped with it.
fn textSymsArena(src str, path str) []Sym {
	return arena {
		textSyms(src, path)
	}
}

// Symbols runs the compiler over files (paths relative to src, the checkout) and gathers their declarations. A batch
// the compiler stops on (one error stops a run: a syntax error, an unknown import) goes on without the file the error
// names, read by textSyms instead, and with that file's package split off into a batch of its own; after a package's
// batch drops maxDrops files, or when the runs have taken runsWithin, what is left of it is read by textSyms too. A run that breaks (its limits) splits its batch. (The batches and results are plain
// local slices: appending a value from an arena's result to a struct's field is a false E310.)
fn Symbols(d Deps, src str, scratch str, files []str) !Result {
	let runner = try Runner(d)
	let t = toolOf(d)
	let started = tide.Now()
	if len(files) == 0 {
		return Result{Syms: []Sym{}, Runs: 0, Skipped: []str{}, Runner: runner}
	}
	try quarry.MkdirAll(scratch)
	// the batches, newest last, and how many files each has dropped; each a copy of its files (a slice of the
	// parameter trips a false E701 below)
	mut queue = [][]str{}
	mut drops = []i64{}
	mut cur = []str{}
	for f in files {
		cur = append(cur, f)
		if len(cur) == batchFiles {
			queue = append(queue, cur)
			drops = append(drops, 0)
			cur = []str{}
		}
	}
	if len(cur) > 0 {
		queue = append(queue, cur)
		drops = append(drops, 0)
	}
	mut syms = []Sym{}
	mut skipped = []str{}
	mut runs = 0
	for len(queue) > 0 {
		let b = queue[len(queue) - 1]
		let dropped = drops[len(drops) - 1]
		queue = queue[0:len(queue) - 1]
		drops = drops[0:len(drops) - 1]
		if dropped >= maxDrops || tide.Now() - started > runsWithin {
			for f in b {
				skipped = append(skipped, f)
			}
			continue
		}
		let s = runStepArena(t, runner, src, scratch, b)
		runs += 1
		if len(s.failure) > 0 {
			fail "index: the compiler: " + s.failure
		}
		if !s.broken && (len(s.syms) > 0 || !s.anyErr) {
			for x in s.syms {
				syms = append(syms, x)
			}
			continue
		}
		// nothing printed: drop the file the error names, else split the batch
		if len(b) == 1 {
			skipped = append(skipped, b[0])
			continue
		}
		mut drop = ""
		if !s.broken && len(s.errFiles) > 0 {
			drop = s.errFiles[0]
		}
		if len(drop) > 0 {
			// the file's package goes on alone without it (one more drop), the other packages without that one
			skipped = append(skipped, drop)
			let dir = DirOf(drop)
			mut mine = []str{}
			mut others = []str{}
			for f in b {
				if f == drop {
					continue
				}
				if DirOf(f) == dir {
					mine = append(mine, f)
				} else {
					others = append(others, f)
				}
			}
			if len(others) > 0 {
				queue = append(queue, others)
				drops = append(drops, dropped)
			}
			if len(mine) > 0 {
				queue = append(queue, mine)
				drops = append(drops, dropped + 1)
			}
			continue
		}
		let half = len(b) / 2
		queue = append(queue, b[half:])
		drops = append(drops, dropped)
		queue = append(queue, b[0:half])
		drops = append(drops, dropped)
	}
	for f in skipped {
		let found = textSymsArena(src, f)
		for x in found {
			syms = append(syms, x)
		}
	}
	return Result{Syms: syms, Runs: runs, Skipped: skipped, Runner: runner}
}
