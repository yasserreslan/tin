package index

import "../../tit/diff"
import "../../tit/object"
import "../../tit/store"
import "../events"
import "../packs"
import "../repo"
import "anvil"
import "argo"
import "fault"
import "herald"
import "mint"
import "postgres"
import "quarry"
import "seal"
import "tide"
import "twine"

// The symbol index (design/tinhub.md §5 and §6, #1020): on a push, every head it moved and every change version it
// added is indexed by running the compiler's `tinc -symbols -json` on the packages that changed, as a child process
// (in packages/sandbox when the host can build one) with limits and no network, because a repository's source is
// untrusted input to the compiler. A commit's rows are its declarations (package directory, name, kind, file, lines);
// the packages a push did not change are copied from the commit indexed before it. Only the current heads and the
// newest versions of open changes keep rows, so the table does not grow with history.

// Kind is the job kind (design/tinhub.md §6) and Within, Memory its budget.
const Kind = "index"

const Within = 2 * tide.Minute

const Memory = 256 * 1024 * 1024

// Deps is what the index needs, set on every core (Configure) before the first job or request.
type Deps struct {
	Db    postgres.Client
	Store dyn packs.PackStore
	Cache repo.RefCache
	// Dir is the node's packs.dir: checkouts are made under Dir/tmp
	Dir str
	// TinRoot is the Tin tree the compiler checks against ("" for $TIN_ROOT); Tinc the compiler ("" for
	// <TinRoot>/bin/tinc)
	TinRoot str
	Tinc    str
	// Sandbox is "auto" (packages/sandbox when the host can build one, else a plain child process, logged), "on"
	// (the sandbox, or the job fails) or "off" (a plain child process)
	Sandbox str
	// Cgroup is a delegated cgroup v2 directory the sandbox puts each compiler run in for its memory, CPU and pids
	// limits; "" for none (the memory limit is then the shell's ulimit -v)
	Cgroup str
	// Auth is the signed-in user of a request, 0 for nobody
	Auth fn(anvil.Req) !i64
}

mut deps ?Deps = nil

// Configure sets this core's dependencies.
fn Configure(d Deps) {
	deps = keep(d)
}

// Handlers configures this core with d and is the index's job handlers, for the worker.
fn Handlers(d Deps) []events.Handler {
	Configure(d)
	return []events.Handler{events.Handler{Kind: Kind, Within: Within, Memory: Memory, Tasks: 0, MaxAttempts: 5, Run: run}}
}

fn current() !Deps {
	let got = deps
	if got == nil {
		fail "index: not configured on this core"
	}
	return got
}

// pgRepo is a repository over this core's dependencies (taking the store from a parameter trips a false E701, #1073).
fn pgRepo(id i64) !repo.PgRepo {
	let d = try current()
	return repo.PgRepo{Db: d.Db, Store: d.Store, Cache: d.Cache, Id: id, Dir: d.Dir, Who: 0}
}

// ---- the push event's payload ----

type refMove struct {
	name str
	old  str
	@json("new") next str
}

type changeMove struct {
	change   str
	replaces str
	commit   str
}

type push struct {
	op      i64
	who     str
	pack    str
	refs    []refMove
	changes []changeMove
}

fn parsePush(payload str) !push {
	mut p = push{op: 0, who: "", pack: "", refs: []refMove{}, changes: []changeMove{}}
	argo.Get(payload, mut p) catch err {
		fail fault.Wrap(err, "index: the push payload")
	}
	return p
}

// IsHex reports whether s is an object id as refs and versions write it: 64 lower-case hex digits.
fn IsHex(s str) bool {
	if len(s) != 64 {
		return false
	}
	for c in s {
		if !((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')) {
			return false
		}
	}
	return true
}

// target is a commit to index and the commits whose rows it may start from, best first.
type target struct {
	commit str
	hints  []str
}

// targetsOf is what a push asks the index for: each head it moved to a commit (from its old commit) and each new
// change version (from the version it replaces).
fn targetsOf(p push) []target {
	mut out = []target{}
	for r in p.refs {
		if twine.HasPrefix(r.name, "refs/heads/") && IsHex(r.next) {
			out = append(out, target{commit: r.next, hints: []str{r.old}})
		}
	}
	for c in p.changes {
		if IsHex(c.commit) {
			out = append(out, target{commit: c.commit, hints: []str{c.replaces}})
		}
	}
	return out
}

// EnqueueFor queues the index job of a push in tx (the push fan-out calls it with the push event's repository and
// payload): one job when the push moved a head or added a change version, none otherwise. It returns the jobs queued.
fn EnqueueFor(tx mut postgres.Tx, repoId i64, payload str) !i64 {
	let p = try parsePush(payload)
	if len(targetsOf(p)) == 0 {
		return 0
	}
	_ = try events.Enqueue(mut tx, Kind, repoId, payload)
	return 1
}

// ---- the job ----

fn run(j events.Job) ! {
	let p = try parsePush(j.Payload)
	_ = try IndexPush(j.RepoId, p.refs, p.changes)
}

// IndexPush indexes what one push moved and prunes what no head or open change holds any more; it returns the commits
// it indexed. A commit indexed already (another head holds it, or the job runs again) is not indexed twice.
fn IndexPush(repoId i64, refs []refMove, changes []changeMove) !i64 {
	let d = try current()
	let ts = targetsOf(push{op: 0, who: "", pack: "", refs: refs, changes: changes})
	mut done = 0
	for t in ts {
		let kept = try Kept(d.Db, repoId, t.commit)
		let have = try Indexed(d.Db, repoId, t.commit)
		if !kept || have {
			continue
		}
		try indexCommit(d, repoId, t)
		done += 1
	}
	_ = try Prune(d.Db, repoId)
	return done
}

// IndexCommit indexes one commit of a repository from the given earlier commits (the first indexed one is used), as
// the job does; tests and tools call it directly.
fn IndexCommit(repoId i64, commit str, hints []str) ! {
	let d = try current()
	try indexCommit(d, repoId, target{commit: commit, hints: hints})
}

// Kept reports whether a commit is one the index keeps: a head's target, or the newest version of an open change
// (one with no landed or abandoned review, or one a ref names).
fn Kept(c postgres.Client, repoId i64, commit str) !bool {
	let rows = try c.Query("SELECT (EXISTS (SELECT 1 FROM refs WHERE repo_id = {repoId} AND name LIKE 'refs/heads/%' AND target = {commit}) OR EXISTS (SELECT 1 FROM (SELECT DISTINCT ON (change_id) change_id, commit_id FROM changes WHERE repo_id = {repoId} ORDER BY change_id, version DESC) v WHERE v.commit_id = {commit} AND (NOT EXISTS (SELECT 1 FROM reviews rv WHERE rv.repo_id = {repoId} AND rv.change_id = v.change_id AND rv.state IN ('landed', 'abandoned')) OR EXISTS (SELECT 1 FROM refs f WHERE f.repo_id = {repoId} AND f.target = 'change ' || v.change_id))))::int")
	return rows.Rows[0][0].Int() == 1
}

// Indexed reports whether the index holds a commit.
fn Indexed(c postgres.Client, repoId i64, commit str) !bool {
	let rows = try c.Query("SELECT count(*) FROM indexed_commits WHERE repo_id = {repoId} AND commit_id = {commit}")
	return rows.Rows[0][0].Int() > 0
}

// Prune deletes the rows of every commit the index no longer keeps (see Kept); it returns the commits dropped.
fn Prune(c postgres.Client, repoId i64) !i64 {
	mut tx = try c.Begin()
	let (n, err) = pruneIn(mut tx, repoId)
	if err != nil {
		tx.Rollback() catch _ {
		}
		fail err
	}
	try tx.Commit()
	return n
}

fn pruneIn(tx mut postgres.Tx, repoId i64) !i64 {
	try lock(mut tx, repoId)
	_ = try tx.Exec("CREATE TEMP TABLE IF NOT EXISTS index_keep (commit_id text PRIMARY KEY) ON COMMIT DELETE ROWS")
	_ = try tx.Exec("INSERT INTO index_keep SELECT target FROM refs WHERE repo_id = {repoId} AND name LIKE 'refs/heads/%' UNION SELECT v.commit_id FROM (SELECT DISTINCT ON (change_id) change_id, commit_id FROM changes WHERE repo_id = {repoId} ORDER BY change_id, version DESC) v WHERE NOT EXISTS (SELECT 1 FROM reviews rv WHERE rv.repo_id = {repoId} AND rv.change_id = v.change_id AND rv.state IN ('landed', 'abandoned')) OR EXISTS (SELECT 1 FROM refs f WHERE f.repo_id = {repoId} AND f.target = 'change ' || v.change_id) ON CONFLICT DO NOTHING")
	_ = try tx.Exec("DELETE FROM symbols WHERE repo_id = {repoId} AND commit_id NOT IN (SELECT commit_id FROM index_keep)")
	let r = try tx.Exec("DELETE FROM indexed_commits WHERE repo_id = {repoId} AND commit_id NOT IN (SELECT commit_id FROM index_keep)")
	return r.Affected
}

// lock serializes the index's writes to one repository (an advisory key of its own, apart from the push lock).
fn lock(tx mut postgres.Tx, repoId i64) ! {
	_ = try tx.Query("SELECT pg_advisory_xact_lock(1020, ({repoId} % 2147483647)::int)")
}

// ---- indexing a commit ----

fn treeOf[S store.ObjectStore](st mut S, hex str) !object.Id {
	let id = try object.ParseId(hex)
	let o = try st.Get(id)
	return match o {
		Commit(cd) => cd.Tree
		Tree(_) => try notCommit(hex)
		Tag(_) => try notCommit(hex)
		Blob(_) => try notCommit(hex)
	}
}

fn notCommit(hex str) !object.Id {
	fail "index: {hex} is not a commit"
}

fn isTin(path str) bool {
	return twine.HasSuffix(path, ".tin")
}

// DirOf is a file's package: its directory, "" at the top.
fn DirOf(path str) str {
	let slash = twine.LastIndex(path, "/")
	if slash < 0 {
		return ""
	}
	return path[0:slash]
}

fn indexCommit(d Deps, repoId i64, t target) ! {
	let work = d.Dir + "/tmp/index-{repoId}-" + t.commit[0:12] + "-" + seal.Hex(seal.RandomBytes(4))
	let err = indexIn(d, repoId, t, work)
	quarry.RemoveAll(work) catch _ {
	}
	if err != nil {
		fail err
	}
}

// checkout is a commit read for indexing: its Tin files, written under the checkout, and the package directories whose
// Tin files changed since the base commit.
type checkout struct {
	files   []str
	changed []str
}

// checkoutOf writes a commit's Tin files under src, in an arena: what reading the packs takes (the inflater's buffers,
// up to 6 times each file) is given back when it ends, and only the paths leave it.
fn checkoutOf(repoId i64, commit str, base str, src str) !checkout {
	return try arena {
		mut r = try pgRepo(repoId)
		mut st = try r.Objects()
		let tree = try treeOf(mut st, commit)
		let files = try Checkout(mut st, tree, src)
		mut seen = map[str]bool{}
		mut changed = []str{}
		if len(base) > 0 {
			let baseTree = try treeOf(mut st, base)
			let fcs = try diff.TreeDiff(mut st, baseTree, tree, false)
			for fc in fcs {
				for p in []str{fc.Path, fc.OldPath} {
					if !isTin(p) {
						continue
					}
					let dir = DirOf(p)
					let (_, have) = seen[dir]
					if !have {
						seen[dir] = true
						changed = append(changed, dir)
					}
				}
			}
		}
		checkout{files: files, changed: changed}
	}
}

fn indexIn(d Deps, repoId i64, t target, work str) ! {
	let started = tide.Now()
	// the earlier commit to start from: the first hint the index holds
	mut base = ""
	for h in t.hints {
		if !IsHex(h) || h == t.commit {
			continue
		}
		let have = try Indexed(d.Db, repoId, h)
		if have {
			base = h
			break
		}
	}
	let src = work + "/src"
	let co = try checkoutOf(repoId, t.commit, base, src)
	let files = co.files
	mut pkgs = map[str]bool{}
	for f in files {
		pkgs[DirOf(f)] = true
	}
	// the packages to run the compiler on: every one, or those whose Tin files changed since base
	mut changed = map[str]bool{}
	for dir in co.changed {
		changed[dir] = true
	}
	mut runFiles = []str{}
	for f in files {
		let (_, hit) = changed[DirOf(f)]
		if len(base) == 0 || hit {
			runFiles = append(runFiles, f)
		}
	}
	mut reindexed = 0
	for dir, _ in pkgs {
		let (_, hit) = changed[dir]
		if len(base) == 0 || hit {
			reindexed += 1
		}
	}
	let res = try Symbols(d, src, work + "/scratch", runFiles)
	try write(d.Db, repoId, t.commit, base, co.changed, res, len(pkgs), reindexed)
	herald.Log(herald.LInfo, "indexed", []str{"repo", mint.Itoa(repoId), "commit", t.commit[0:12], "base", base, "packages", mint.Itoa(len(pkgs)), "reindexed", mint.Itoa(reindexed), "symbols", mint.Itoa(len(res.Syms)), "runs", mint.Itoa(res.Runs), "skipped", mint.Itoa(len(res.Skipped)), "runner", res.Runner, "ms", mint.Itoa((tide.Now() - started) / tide.Millisecond)})
}

// rowsOut is a batch of symbol rows as jsonb_to_recordset reads them.
type rowOut struct {
	@json("package") pkg str
	name     str
	kind     str
	file     str
	line     i64
	end_line i64
	recv     str
}

// rowsPerInsert is how many rows one INSERT carries.
const rowsPerInsert = 2000

// write replaces a commit's rows in one transaction: the packages that did not change since base copied from it, and
// the rows found; the commit is recorded in indexed_commits. A commit no longer kept (a later push moved on) is not
// written.
fn write(c postgres.Client, repoId i64, commit str, base str, changedDirs []str, res Result, packages i64, reindexed i64) ! {
	mut tx = try c.Begin()
	let err = writeIn(mut tx, c, repoId, commit, base, changedDirs, res, packages, reindexed)
	if err != nil {
		tx.Rollback() catch _ {
		}
		fail err
	}
	try tx.Commit()
}

fn writeIn(tx mut postgres.Tx, c postgres.Client, repoId i64, commit str, base str, changedDirs []str, res Result, packages i64, reindexed i64) ! {
	try lock(mut tx, repoId)
	let kept = try Kept(c, repoId, commit)
	if !kept {
		return
	}
	// a prune since the job chose base took its rows: fail, and the next attempt starts from another commit
	mut baseHeld = true
	if len(base) > 0 {
		baseHeld = try Indexed(c, repoId, base)
	}
	if !baseHeld {
		fail "index: {base} left the index while {commit} was indexed from it"
	}
	_ = try tx.Exec("DELETE FROM symbols WHERE repo_id = {repoId} AND commit_id = {commit}")
	_ = try tx.Exec("DELETE FROM indexed_commits WHERE repo_id = {repoId} AND commit_id = {commit}")
	if len(base) > 0 {
		let skip = twine.Join(changedDirs, "\n")
		_ = try tx.Exec("INSERT INTO symbols (repo_id, commit_id, package, name, kind, file, line, end_line, recv) SELECT repo_id, {commit}, package, name, kind, file, line, end_line, recv FROM symbols WHERE repo_id = {repoId} AND commit_id = {base} AND NOT (package = ANY(string_to_array({skip}, chr(10))))")
	}
	mut at = 0
	for at < len(res.Syms) {
		let end = min(at + rowsPerInsert, len(res.Syms))
		mut rows = []rowOut{}
		for s in res.Syms[at:end] {
			rows = append(rows, rowOut{pkg: DirOf(s.file), name: s.name, kind: s.kind, file: s.file, line: s.line, end_line: s.declEndLine, recv: s.recv})
		}
		mut buf = []u8{}
		argo.Put(mut buf, rows)
		let js = str(buf)
		_ = try tx.Exec("INSERT INTO symbols (repo_id, commit_id, package, name, kind, file, line, end_line, recv) SELECT {repoId}, {commit}, x.package, x.name, x.kind, x.file, x.line, x.end_line, x.recv FROM jsonb_to_recordset({js}::jsonb) AS x(package text, name text, kind text, file text, line int, end_line int, recv text)")
		at = end
	}
	let runner = res.Runner
	_ = try tx.Exec("INSERT INTO indexed_commits (repo_id, commit_id, packages, reindexed, base, runner) VALUES ({repoId}, {commit}, {packages}, {reindexed}, {base}, {runner})")
}
