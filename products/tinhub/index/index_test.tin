// Tests for the symbol index (#1020) against Postgres (TINHUB_TEST_DB): pushes made through PgRepo, the index job run
// by the event queue's runner, an incremental push re-indexing only the package it changed, pruning, and search that
// never shows a private repository to a non-member.

fn testDb(t mut crucible.T) ?postgres.Client {
	let (o, ok) = db.TestOptions()
	if !ok {
		t.Log("TINHUB_TEST_DB is not set: skipped")
		return nil
	}
	let c = db.Open(o)
	db.ResetForTests(c) catch err {
		t.Error("reset: {err}")
		return nil
	}
	_ = db.Migrate(c) catch err {
		t.Error("migrate: {err}")
		return nil
	}
	return c
}

fn nobody(q anvil.Req) !i64 {
	return 0
}

// fixture is a repository of the test database with a directory store, and this core configured for it.
type fixture struct {
	r   repo.PgRepo
	dir str
}

fn newRepo(c postgres.Client, owner str, name str, visibility str) !fixture {
	return try newRepoAt(c, owner, name, visibility, "/tmp/tin-test-tinhub-index-" + seal.Hex(seal.RandomBytes(4)))
}

// newRepoAt is newRepo with its packs under dir (repositories that share one store, as on a node).
fn newRepoAt(c postgres.Client, owner str, name str, visibility str, dir str) !fixture {
	let o = try c.Query("INSERT INTO owners (name, kind) VALUES ({owner}, 'user') ON CONFLICT (name) DO UPDATE SET kind = 'user' RETURNING id")
	let ownerId = o.Rows[0][0].Int()
	let r = try c.Query("INSERT INTO repos (owner_id, name, visibility, quota_bytes) VALUES ({ownerId}, {name}, {visibility}, 1000000000) RETURNING id")
	let s = try packs.NewDirStore(dir + "/store")
	Configure(Deps{Db: c, Store: s, Cache: repo.NoCache(), Dir: dir, TinRoot: "", Tinc: "", Sandbox: "auto", Cgroup: "", Auth: nobody})
	return fixture{r: repo.PgRepo{Db: c, Store: s, Cache: repo.NoCache(), Id: r.Rows[0][0].Int(), Dir: dir, Who: 0}, dir: dir}
}

fn person(when i64) object.Person {
	return object.Person{Name: "Ada", Email: "ada@example.com", When: when, Zone: 0}
}

// treeOfFiles writes the tree of files (path to text) into s, adding every id it writes to ids.
fn treeOfFiles(s mut store.Mem, files map[str]str, prefix str, ids mut []object.Id) !object.Id {
	mut keys = []str{}
	mut subdirs = map[str]bool{}
	for path, _ in files {
		if !twine.HasPrefix(path, prefix) {
			continue
		}
		let rest = path[len(prefix):]
		let slash = twine.IndexByte(rest, '/')
		if slash < 0 {
			keys = append(keys, rest)
		} else {
			let (_, seen) = subdirs[rest[0:slash]]
			if !seen {
				subdirs[rest[0:slash]] = true
				keys = append(keys, rest[0:slash] + "/")
			}
		}
	}
	sift.Strs(mut keys)
	mut entries = []object.Entry{}
	for k in keys {
		if twine.HasSuffix(k, "/") {
			let name = k[0:len(k) - 1]
			let sub = try treeOfFiles(mut s, files, prefix + k, mut ids)
			entries = append(entries, object.Entry{Mode: object.Mode.Dir, Name: name, Id: sub})
		} else {
			let (body, _) = files[prefix + k]
			let blob = try s.PutRaw(object.Kind.Blob, body)
			ids = append(ids, blob)
			entries = append(entries, object.Entry{Mode: object.Mode.File, Name: k, Id: blob})
		}
	}
	let tree = try s.Put(object.Object.Tree(entries))
	ids = append(ids, tree)
	return tree
}

fn makeCommit(s mut store.Mem, files map[str]str, parents []object.Id, cid object.ChangeId, when i64, ids mut []object.Id) !object.Id {
	let tree = try treeOfFiles(mut s, files, "", mut ids)
	let c = object.CommitData{Tree: tree, Parents: parents, Change: cid, Author: person(when), Committer: person(when), GitHeaders: []str{}, Signature: "", Message: "test\n", Conflicts: []str{}}
	let id = try s.Put(object.Object.Commit(c))
	ids = append(ids, id)
	return id
}

// pushOf pushes ids' objects with the ref and change moves, as a push over the protocol commits them.
fn pushOf(f mut fixture, s mut store.Mem, ids []object.Id, refs []transport.RefUpdate, changes []transport.ChangeUpdate) ! {
	let p = try packfile.Write(mut s, ids, f.r.TempDir())
	let st = try f.r.Stage(p.Path)
	_ = try f.r.Commit(transport.Update{Who: "ada@example.com", Command: "push", Changes: changes, Refs: refs, Pack: st.Name, Time: 1700000000000000000})
}

// fanOut does what the push fan-out does for the index: the newest push event's payload goes to EnqueueFor.
fn fanOut(c postgres.Client, repoId i64) !i64 {
	let rows = try c.Query("SELECT payload::text FROM events WHERE repo_id = {repoId} AND kind = 'push' ORDER BY id DESC LIMIT 1")
	mut tx = try c.Begin()
	let n = try EnqueueFor(mut tx, repoId, rows.Rows[0][0].Text())
	try tx.Commit()
	return n
}

// work runs every ready index job through the event queue's runner.
fn work(c postgres.Client) !i64 {
	let d = try current()
	let runner = events.Runner{Db: c, Handlers: Handlers(d), Lease: 300 * 1000000000, Poll: 0}
	mut n = 0
	for {
		let ran = try runner.Step("test/1/0")
		if !ran {
			break
		}
		n += 1
	}
	let dead = try c.Query("SELECT count(*), coalesce(max(last_error), '') FROM events WHERE kind = 'index' AND state <> 'done'")
	if dead.Rows[0][0].Int() > 0 {
		fail "an index job did not finish: " + dead.Rows[0][1].Text()
	}
	return n
}

const libA = "package a\n\n// ReadFile reads.\nfn ReadFile(p str) str {{\n\treturn p\n}}\n\n// Buf is a buffer.\ntype Buf struct {{\n\tn i64\n}}\n\nfn (b Buf) Len() i64 {{\n\treturn b.n\n}}\n"

const libB1 = "package b\n\nconst Size = 4\n"

const libB2 = "package b\n\nconst Size = 4\n\nfn Grow(n i64) i64 {{\n\treturn n * 2\n}}\n"

const mainTin = "package main\n\nimport \"./lib/a\"\n\nfn main() {{\n\t_ = a.ReadFile(\"x\")\n}}\n"

// badTin does not parse: the compiler stops at it, the batch goes on without it, and its declarations are read from
// its text.
const badTin = "package bad\n\nfn Broken( {{\n"

fn symbolCount(c postgres.Client, repoId i64, commit str, name str) i64 {
	let rows = c.Query("SELECT count(*) FROM symbols WHERE repo_id = {repoId} AND commit_id = {commit} AND name = {name}") catch _ {
		return -1
	}
	return rows.Rows[0][0].Int()
}

fn TestIndexPushes(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	let c = got
	mut f = newRepo(c, "ada", "tin", "public") catch err {
		t.Error("repo: {err}")
		return
	}
	mut s = store.NewMem()
	mut ids = []object.Id{}
	let cid = object.NewChangeId()
	let files1 = map[str]str{"lib/a/a.tin": libA, "lib/b/b.tin": libB1, "main.tin": mainTin, "bad/bad.tin": badTin, "README": "not Tin\n"}
	let c1 = makeCommit(mut s, files1, []object.Id{}, cid, 1700000000, mut ids) catch err {
		t.Error("c1: {err}")
		return
	}
	pushOf(mut f, mut s, ids, []transport.RefUpdate{transport.RefUpdate{Name: "refs/heads/main", Old: "", New: c1.Hex()}}, []transport.ChangeUpdate{transport.ChangeUpdate{Change: cid.Letters(), Replaces: "", Commit: c1.Hex()}}) catch err {
		t.Error("push 1: {err}")
		return
	}
	let queued = fanOut(c, f.r.Id) catch err {
		t.Error("fan-out: {err}")
		return
	}
	crucible.Equal(mut t, "one index job for a push", queued, 1)
	let ran = work(c) catch err {
		t.Error("work: {err}")
		return
	}
	crucible.Equal(mut t, "the job ran", ran, 1)
	let h1 = c1.Hex()
	crucible.Equal(mut t, "fn ReadFile", symbolCount(c, f.r.Id, h1, "ReadFile"), 1)
	crucible.Equal(mut t, "type Buf", symbolCount(c, f.r.Id, h1, "Buf"), 1)
	crucible.Equal(mut t, "const Size", symbolCount(c, f.r.Id, h1, "Size"), 1)
	crucible.Equal(mut t, "fn main", symbolCount(c, f.r.Id, h1, "main"), 1)
	crucible.Equal(mut t, "the file that does not parse is read from its text", symbolCount(c, f.r.Id, h1, "Broken"), 1)
	let m = c.Query("SELECT kind, recv, package, file, line, end_line FROM symbols WHERE repo_id = {f.r.Id} AND commit_id = {h1} AND name = 'Len'") catch err {
		t.Error("method: {err}")
		return
	}
	t.True("the method's row", len(m.Rows) == 1 && m.Rows[0][0].Text() == "method" && m.Rows[0][1].Text() == "Buf" && m.Rows[0][2].Text() == "lib/a" && m.Rows[0][3].Text() == "lib/a/a.tin" && m.Rows[0][4].Int() == 13 && m.Rows[0][5].Int() == 15)
	let ic = c.Query("SELECT packages, reindexed, base FROM indexed_commits WHERE repo_id = {f.r.Id} AND commit_id = {h1}") catch err {
		t.Error("indexed: {err}")
		return
	}
	t.True("c1 indexed whole: 4 packages", len(ic.Rows) == 1 && ic.Rows[0][0].Int() == 4 && ic.Rows[0][1].Int() == 4 && ic.Rows[0][2].Text() == "")
	// the job again (at least once delivery): nothing is indexed twice
	let again = IndexPush(f.r.Id, []refMove{refMove{name: "refs/heads/main", old: "", next: h1}}, []changeMove{}) catch err {
		t.Error("again: {err}")
		return
	}
	crucible.Equal(mut t, "an indexed commit is not indexed again", again, 0)
	crucible.Equal(mut t, "no duplicate rows", symbolCount(c, f.r.Id, h1, "ReadFile"), 1)

	// an incremental push: lib/b changes, the change gets version 2, main moves
	mut files2 = map[str]str{}
	for k, v in files1 {
		files2[k] = v
	}
	files2["lib/b/b.tin"] = libB2
	mut ids2 = []object.Id{}
	let c2 = makeCommit(mut s, files2, []object.Id{c1}, cid, 1700000100, mut ids2) catch err {
		t.Error("c2: {err}")
		return
	}
	pushOf(mut f, mut s, ids2, []transport.RefUpdate{transport.RefUpdate{Name: "refs/heads/main", Old: h1, New: c2.Hex()}}, []transport.ChangeUpdate{transport.ChangeUpdate{Change: cid.Letters(), Replaces: h1, Commit: c2.Hex()}}) catch err {
		t.Error("push 2: {err}")
		return
	}
	_ = fanOut(c, f.r.Id) catch err {
		t.Error("fan-out 2: {err}")
		return
	}
	_ = work(c) catch err {
		t.Error("work 2: {err}")
		return
	}
	let h2 = c2.Hex()
	let ic2 = c.Query("SELECT packages, reindexed, base FROM indexed_commits WHERE repo_id = {f.r.Id} AND commit_id = {h2}") catch err {
		t.Error("indexed 2: {err}")
		return
	}
	t.True("c2 re-indexed only lib/b, from c1", len(ic2.Rows) == 1 && ic2.Rows[0][0].Int() == 4 && ic2.Rows[0][1].Int() == 1 && ic2.Rows[0][2].Text() == h1)
	crucible.Equal(mut t, "the new fn", symbolCount(c, f.r.Id, h2, "Grow"), 1)
	crucible.Equal(mut t, "an unchanged package's rows copied", symbolCount(c, f.r.Id, h2, "ReadFile"), 1)
	crucible.Equal(mut t, "the method copied", symbolCount(c, f.r.Id, h2, "Len"), 1)
	// c1 is no head and no change's newest version any more: pruned
	let left = c.Query("SELECT count(*) FROM symbols WHERE repo_id = {f.r.Id} AND commit_id = {h1}") catch err {
		t.Error("left: {err}")
		return
	}
	crucible.Equal(mut t, "c1's rows pruned", left.Rows[0][0].Int(), 0)
	let held = c.Query("SELECT count(*) FROM indexed_commits WHERE repo_id = {f.r.Id}") catch err {
		t.Error("held: {err}")
		return
	}
	crucible.Equal(mut t, "only c2 is held", held.Rows[0][0].Int(), 1)
	quarry.RemoveAll(f.dir) catch _ {
	}
}

// TestSearchAccess: the same declaration in a public and a private repository; search and the repository endpoint
// never show the private one to someone outside it.
fn TestSearchAccess(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	let c = got
	mut fs = []fixture{}
	let dir = "/tmp/tin-test-tinhub-index-" + seal.Hex(seal.RandomBytes(4))
	for name in []str{"pub", "priv"} {
		let vis = match name {
			"pub" => "public"
			_ => "private"
		}
		mut f = newRepoAt(c, "ada", name, vis, dir) catch err {
			t.Error("repo: {err}")
			return
		}
		mut s = store.NewMem()
		mut ids = []object.Id{}
		let c1 = makeCommit(mut s, map[str]str{"lib/a/a.tin": libA}, []object.Id{}, object.NewChangeId(), 1700000000, mut ids) catch err {
			t.Error("commit: {err}")
			return
		}
		pushOf(mut f, mut s, ids, []transport.RefUpdate{transport.RefUpdate{Name: "refs/heads/main", Old: "", New: c1.Hex()}}, []transport.ChangeUpdate{}) catch err {
			t.Error("push: {err}")
			return
		}
		_ = fanOut(c, f.r.Id) catch err {
			t.Error("fan-out: {err}")
			return
		}
		fs = append(fs, f)
	}
	_ = work(c) catch err {
		t.Error("work: {err}")
		return
	}
	let held = c.Query("SELECT count(DISTINCT repo_id) FROM symbols WHERE name = 'ReadFile'") catch err {
		t.Error("held: {err}")
		return
	}
	crucible.Equal(mut t, "both repositories indexed", held.Rows[0][0].Int(), 2)
	let d = current() catch err {
		t.Error("deps: {err}")
		return
	}
	let res = Search(d, 0, "fn:ReadFile", 0, 50) catch err {
		t.Error("search: {err}")
		return
	}
	t.True("search finds only the public repository", len(res.results) == 1 && res.results[0].repo == "pub" && res.results[0].file == "lib/a/a.tin" && res.results[0].line == 4)
	let none = Search(d, 0, "type:ReadFile", 0, 50) catch err {
		t.Error("search kind: {err}")
		return
	}
	crucible.Equal(mut t, "a kind narrows", len(none.results), 0)
	let meth = Search(d, 0, "Buf.Len", 0, 50) catch err {
		t.Error("search method: {err}")
		return
	}
	t.True("Type.Method finds the method", len(meth.results) == 1 && meth.results[0].kind == "method" && meth.results[0].recv == "Buf")
	mut r = anvil.NewRouter()
	Mount(mut r)
	let w = r.Run("GET", "/api/v1/search?q=fn:ReadFile", "")
	t.True("GET /api/v1/search: {str(w.Body)}", w.Code() == 200 && twine.Contains(str(w.Body), "\"repo\":\"pub\"") && !twine.Contains(str(w.Body), "priv"))
	let pub = r.Run("GET", "/api/v1/repos/ada/pub/symbols?q=read", "")
	t.True("a public repository's symbols: {str(pub.Body)}", pub.Code() == 200 && twine.Contains(str(pub.Body), "\"name\":\"ReadFile\"") && twine.Contains(str(pub.Body), "\"indexed\":true"))
	let all = r.Run("GET", "/api/v1/repos/ada/pub/symbols?limit=2", "")
	t.True("pages: {str(all.Body)}", all.Code() == 200 && twine.Contains(str(all.Body), "\"next\":\"2\""))
	let priv = r.Run("GET", "/api/v1/repos/ada/priv/symbols?q=read", "")
	t.True("a private repository is not found: {str(priv.Body)}", priv.Code() == 404 && !twine.Contains(str(priv.Body), "ReadFile"))
	let noRef = r.Run("GET", "/api/v1/repos/ada/pub/symbols?ref=nope", "")
	crucible.Equal(mut t, "an unknown ref", noRef.Code(), 404)
	quarry.RemoveAll(dir) catch _ {
	}
}

fn TestParseQuery(t mut crucible.T) {
	let a = ParseQuery("fn:ReadFile")
	t.True("fn:ReadFile", a.Kind == "fn" && a.Name == "ReadFile" && a.Recv == "")
	let b = ParseQuery("PgRepo.Commit")
	t.True("Type.Method", b.Kind == "method" && b.Recv == "PgRepo" && b.Name == "Commit")
	let d = ParseQuery("fn ReadFile")
	t.True("fn ReadFile", d.Kind == "fn" && d.Name == "ReadFile" && d.Recv == "")
	let e = ParseQuery("type: Repo")
	t.True("type: Repo", e.Kind == "type" && e.Name == "Repo")
	let f = ParseQuery("method PgRepo.Commit")
	t.True("method PgRepo.Commit", f.Kind == "method" && f.Recv == "PgRepo" && f.Name == "Commit")
	let c = ParseQuery("weird:Name")
	t.True("an unknown kind is part of the name", c.Kind == "" && c.Name == "weird:Name")
	crucible.Equal(mut t, "LIKE escapes", likePrefix("A_b%"), "a\\_b\\%%")
	t.True("hex", IsHex("0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef") && !IsHex("change abc"))
	let ps = embedPrefixes("products/x/db.tin", "// embed: migrations\nlet m str\n// embed: static/*.html ../up\n")
	t.True("embed prefixes: {ps}", len(ps) == 2 && ps[0] == "products/x/migrations" && ps[1] == "products/x/static/")
}
