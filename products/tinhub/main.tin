package main

import "./accounts"
import "./api"
import "./capsules"
import "./config"
import "./db"
import "./events"
import "./notify"
import "./packs"
import "./proto"
import "./repo"
import "./signin"
import "./workers"
import "anvil"
import "fault"
import "hearth"
import "mint"
import "herald"
import "postgres"
import "quarry"
import "redis"
import "s3"
import "say"
import "seal"
import "signal"
import "tide"
import "tls"
import "twine"

// tinhub: hosting for tit repositories (design/tinhub.md). One binary in roles: node (the protocol, the API, health),
// worker (the event queue) and runner (sandboxed replays).

const version = "0.1.0"

// Boot is what the command line and the configuration say, read once on core 0 before the cores start.
type Boot struct {
	Command str
	Args    []str
	Conf    config.Config
	Err     str
}

fn usage() str {
	return "usage: tinhub run [--config FILE] [--roles node,worker,runner]\n       tinhub migrate [--config FILE]\n       tinhub packs sweep|copy [--config FILE]\n       tinhub check [--config FILE]\n       tinhub admin invite EMAIL [--site-admin] [--config FILE]\n       tinhub version [-v]\n"
}

// parseBoot reads the command, its --config and --roles flags, and loads the configuration.
fn parseBoot(argv []str) Boot {
	mut command = ""
	mut path = ""
	mut roles = ""
	mut rest = []str{}
	mut i = 1
	for i < len(argv) {
		let a = argv[i]
		if a == "--config" || a == "--roles" {
			if i + 1 >= len(argv) {
				return Boot{Command: command, Args: rest, Conf: emptyConfig(), Err: "{a} needs a value"}
			}
			if a == "--config" {
				path = argv[i + 1]
			} else {
				roles = argv[i + 1]
			}
			i += 2
			continue
		}
		if len(command) == 0 {
			command = a
		} else {
			rest = append(rest, a)
		}
		i += 1
	}
	if command == "version" || command == "" || command == "help" || command == "-h" || command == "--help" {
		return Boot{Command: command, Args: rest, Conf: emptyConfig(), Err: ""}
	}
	if len(roles) > 0 {
		quarry.Setenv(config.EnvName("roles"), roles) catch _ {
		}
	}
	let c = config.Load(config.Path(path)) catch err {
		return Boot{Command: command, Args: rest, Conf: emptyConfig(), Err: fault.Message(err)}
	}
	return Boot{Command: command, Args: rest, Conf: c, Err: ""}
}

fn emptyConfig() config.Config {
	let vals = config.Resolve(map[str]str{}, noEnv) catch _ {
		map[str]str{}
	}
	let c = config.Build(vals) catch _ {
		panic("tinhub: the default configuration does not build")
	}
	return c
}

fn noEnv(name str) (str, bool) {
	return "", false
}

// boot is read on every core from the same command line, file and environment (a shared let cannot call into packages
// whose globals are not initialized yet, E130), so every core holds the same configuration.
let boot = parseBoot(quarry.Args())

fn dbOptions(c config.Config) db.Options {
	return db.Options{Addr: c.DbAddr, User: c.DbUser, Password: c.DbPassword, Name: c.DbName, MaxTotal: c.DbMaxTotal}
}

// pg is this core's client of the primary.
let pg = db.Open(dbOptions(boot.Conf))

// stale is this core's client of db.replica (phase 2), else the primary: for API reads that may lag.
let stale = replica(boot.Conf)

fn replica(c config.Config) postgres.Client {
	if len(c.DbReplica) == 0 {
		return pg
	}
	mut o = dbOptions(c)
	o.Addr = c.DbReplica
	return db.Open(o)
}

fn level(name str) i64 {
	return match name {
		"debug" => herald.LDebug
		"warn" => herald.LWarn
		"error" => herald.LError
		_ => herald.LInfo
	}
}

// handlers is every job kind this binary runs (design/tinhub.md §6); later issues add theirs here.
fn handlers() []events.Handler {
	let st = openStore(boot.Conf) catch err {
		herald.Log(herald.LError, "the pack store", []str{"error", fault.Message(err)})
		return []events.Handler{}
	}
	mut all = workers.Handlers(workers.NewDeps(pg, st, boot.Conf.PacksDir, boot.Conf.RepackPacks))
	capsules.Configure(capsules.Deps{Db: pg, Store: st, Dir: boot.Conf.PacksDir, Auth: signin.Caller})
	all = append(all, capsules.Handlers()...)
	all = append(all, notify.Handlers(notifyDeps(boot.Conf))...)
	return all
}

fn runner() events.Runner {
	return events.Runner{Db: pg, Handlers: handlers(), Lease: boot.Conf.WorkerLease, Poll: tide.Second}
}

// working reports whether this process runs workers: tinhub run with the worker role, on core 0.
fn working() bool {
	return boot.Command == "run" && len(boot.Err) == 0 && boot.Conf.Has("worker") && hearth.ID() == 0
}

// openStore is the pack store packs.store names: the directory store at packs.dir, or the bucket with the node's
// copies under packs.dir/cache.
fn openStore(c config.Config) !dyn packs.PackStore {
	if c.PacksStore == "s3" {
		let client = try s3.New(s3.Config{Endpoint: c.S3Endpoint, Region: c.S3Region, AccessKey: c.S3AccessKey, SecretKey: c.S3SecretKey, Token: "", PathStyle: c.S3PathStyle, SignPayload: false, UnsignedPayload: false, Attempts: 0, Backoff: 0, Timeout: 0, TLS: nil})
		let st dyn packs.PackStore = packs.S3Store{Client: client, Bucket: c.S3Bucket, Cache: c.PacksDir + "/cache"}
		return st
	}
	let d = try packs.NewDirStore(c.PacksDir)
	let st dyn packs.PackStore = d
	return st
}

// pendingAge is how old a pending pack is before the sweep deletes it: no push runs past its deadline, so none can
// still be writing it.
fn pendingAge(c config.Config) i64 {
	return c.PushDeadline + 10 * tide.Minute
}

// sweep runs the sweeps once (design/tinhub.md §2): on a worker, the pending and retired packs of every repository;
// on every process, the packs left in packs.dir/tmp by pushes that died and, with the S3 store, the node's copies
// over packs.cache.
fn sweep(c config.Config, rows bool) ! {
	mut st = try openStore(c)
	let now = tide.Wall() / tide.Second
	if rows {
		let n = try packs.Sweep(pg, mut st, pendingAge(c), c.PacksGrace)
		if n > 0 {
			herald.Log(herald.LInfo, "swept packs", []str{"packs", say.Str(n)})
		}
		// the nightly prune: each repository at most once a day
		let p = try workers.SchedulePrune(pg)
		if p > 0 {
			herald.Log(herald.LInfo, "queued prunes", []str{"repos", say.Str(p)})
		}
	}
	_ = try packs.SweepTemp(c.PacksDir + "/tmp", pendingAge(c) / tide.Second, now)
	if c.PacksStore == "s3" {
		_ = try packs.TrimCache(c.PacksDir + "/cache", c.PacksCache, c.PacksGrace / tide.Second, now)
	}
}

// serving reports whether this process answers the protocol: tinhub run with the node role.
fn serving() bool {
	return boot.Command == "run" && len(boot.Err) == 0 && boot.Conf.Has("node")
}

// fetchWithin and fetchMemory are a heads or fetch request's budget (design/tinhub.md §8).
const fetchWithin = 10 * tide.Minute

const fetchMemory = 256 * 1024 * 1024

// notifyDeps is what notifications, webhooks and the live websocket need (#1023).
fn notifyDeps(c config.Config) notify.Deps {
	let (_, test) = quarry.LookupEnv("TINHUB_TEST_ROUTES")
	return notify.Deps{Db: pg, Auth: signin.Caller, Role: accounts.RoleOf, SmtpAddr: c.SmtpAddr, SmtpFrom: c.SmtpFrom, PublicURL: c.PublicURL, Attempts: 0, Timeout: 0, AllowPrivate: test, Poll: 0}
}

// configureProto gives this core the protocol's dependencies: its pack store, its Redis client and the limits.
fn configureProto(c config.Config) {
	let st = openStore(c) catch err {
		herald.Log(herald.LError, "the pack store", []str{"error", fault.Message(err)})
		return
	}
	let cache = repo.NewRefCache(c.RedisAddr, "tinhub:", tide.Minute)
	let limits = redis.Open(redis.Options{Addr: c.RedisAddr, Username: "", Password: "", DB: 0, Proto: 0, Timeout: 0, TLS: nil})
	api.Configure(api.Deps{Db: pg, Stale: stale, Store: st, Cache: cache, Dir: c.PacksDir, Limits: limits, LimitsOn: len(c.RedisAddr) > 0, Window: tide.Minute, PerWindow: c.ApiRate, Auth: signin.Caller})
	let sessions = accounts.NewSessions(c.RedisAddr, "tinhub:", accounts.SessionTTL, c.CookieKey)
	signin.Configure(signin.Deps{Db: pg, Sessions: sessions, NonceKey: c.NonceSecret, CookieKey: c.CookieKey, PublicUrl: c.PublicURL, Secure: twine.HasPrefix(c.PublicURL, "https:")})
	capsules.Configure(capsules.Deps{Db: pg, Store: st, Dir: c.PacksDir, Auth: signin.Caller})
	notify.Configure(notifyDeps(c))
	proto.Configure(proto.Deps{Db: pg, Store: st, Cache: cache, Dir: c.PacksDir, NonceKey: c.NonceSecret, Pack: c.LimitPack, Refs: c.LimitRefs, PushWithin: c.PushDeadline, PushMemory: c.PushMemory, FetchWithin: fetchWithin, FetchMemory: fetchMemory})
}

// sweeping reports whether this process runs the sweeps: tinhub run, on core 0.
fn sweeping() bool {
	return boot.Command == "run" && len(boot.Err) == 0 && hearth.ID() == 0
}

// sweepLoop runs the sweeps every packs.sweep until the drain cancels it.
fn sweepLoop() {
	let every = boot.Conf.PacksSweep
	let rows = boot.Conf.Has("worker")
	for {
		arena {
			sweep(boot.Conf, rows) catch err {
				herald.Log(herald.LError, "sweep", []str{"error", fault.Message(err)})
			}
		}
		mut stop = false
		hearth.Quiet(fn() {
			tide.Wait(every) catch _ {
				stop = true
			}
		})
		if stop {
			return
		}
	}
}

on core.start {
	herald.SetLevel(level(boot.Conf.LogLevel))
	if working() {
		// the nightly capsule retention queues its next run itself; this queues the first
		_ = capsules.ScheduleRetention(pg, 24 * tide.Hour) catch err {
			herald.Log(herald.LError, "scheduling capsule retention", []str{"error", fault.Message(err)})
			false
		}
		for slot in 0..boot.Conf.Workers {
			let s = slot
			detach {
				runner().Loop(s)
			}
		}
	}
	if serving() {
		configureProto(boot.Conf)
	}
	if sweeping() && boot.Conf.PacksSweep > 0 {
		detach {
			sweepLoop()
		}
	}
}

// The drain (SIGTERM) cancels the worker loops; the jobs they held go back to the queue here, where waits work again.
on core.stop {
	if working() {
		let n = events.ReleaseAll(pg) catch err {
			herald.Log(herald.LError, "giving back jobs", []str{"error", fault.Message(err)})
			0
		}
		if n > 0 {
			herald.Log(herald.LInfo, "gave back jobs", []str{"jobs", say.Str(n)})
		}
	}
}

// requestId is the request's X-Request-Id when it is a short safe token, else a fresh one.
fn requestId(q anvil.Req) str {
	let given = q.Header("x-request-id")
	if len(given) > 0 && len(given) <= 64 {
		mut ok = true
		for c in given {
			let alnum = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')
			if !alnum && c != '-' && c != '_' && c != '.' {
				ok = false
				break
			}
		}
		if ok {
			return given
		}
	}
	return seal.Hex(seal.RandomBytes(8))
}

// logged gives every request an id (echoed in X-Request-Id) and writes one log line for it.
fn logged(q anvil.Req, w mut anvil.Out, next fn(anvil.Req, mut anvil.Out)) {
	let id = requestId(q)
	w.SetValue("req", id)
	w.Head("X-Request-Id", id)
	next(q, mut w)
	herald.Log(herald.LInfo, "request", []str{"req", id, "method", q.Method, "route", q.Pattern(), "status", say.Str(w.Code()), "client", q.ClientIP()})
}

fn healthz(q anvil.Req, w mut anvil.Out) {
	w.Text("ok\n")
}

// readyz is 200 when Postgres answers and its schema is the one this binary needs.
fn readyz(q anvil.Req, w mut anvil.Out) {
	db.Current(pg) catch err {
		w.Status(503)
		w.Text("not ready: {fault.Message(err)}\n")
		return
	}
	w.Text("ready\n")
}

// testWait answers after ?ms= milliseconds.
fn testWait(q anvil.Req, w mut anvil.Out) {
	let ms = mint.Atoi(q.Param("ms")) catch _ {
		0
	}
	tide.Wait(ms * tide.Millisecond) catch err {
		w.Status(503)
		w.Text("{fault.Message(err)}\n")
		return
	}
	w.Text("waited {ms}ms\n")
}

// metrics answers the queue's depth per kind and the age of its oldest ready job, as Prometheus text, to clients on
// this machine only (a scraper next to the node, or through the operator's own proxy).
fn metrics(q anvil.Req, w mut anvil.Out) {
	let ip = q.ClientIP()
	if ip != "127.0.0.1" && ip != "::1" {
		w.Status(404)
		w.Text("404 page not found\n")
		return
	}
	let all = events.QueueStats(pg) catch err {
		w.Status(503)
		w.Text("{fault.Message(err)}\n")
		return
	}
	let kinds = events.StatsByKind(pg) catch err {
		w.Status(503)
		w.Text("{fault.Message(err)}\n")
		return
	}
	w.Type("text/plain; version=0.0.4")
	w.Text("# TYPE tinhub_jobs_ready gauge\n")
	for k in kinds {
		w.Text("tinhub_jobs_ready{{kind=\"{k.Kind}\"}} {k.Ready}\n")
	}
	w.Text("# TYPE tinhub_jobs_dead gauge\n")
	for k in kinds {
		w.Text("tinhub_jobs_dead{{kind=\"{k.Kind}\"}} {k.Dead}\n")
	}
	w.Text("# TYPE tinhub_jobs_oldest_ready_seconds gauge\n")
	for k in kinds {
		w.Text("tinhub_jobs_oldest_ready_seconds{{kind=\"{k.Kind}\"}} {k.OldestAge}\n")
	}
	w.Text("# TYPE tinhub_jobs_claimed gauge\ntinhub_jobs_claimed {all.Claimed}\n")
}

// routes is every route this process serves: health on every role, the rest on a node.
fn routes(c config.Config) anvil.Router {
	mut r = anvil.NewRouter()
	r.Use(logged)
	r.Get("/healthz", healthz)
	r.Get("/readyz", readyz)
	r.Get("/metrics", metrics)
	if c.Has("node") {
		signin.Mount(mut r)
		capsules.Mount(mut r)
		notify.Mount(mut r)
		proto.Mount(mut r)
		api.Mount(mut r)
	}
	// tests/run.sh checks the drain with a request that waits; never on in a deployment
	if quarry.Getenv("TINHUB_TEST_ROUTES") == "1" {
		r.Get("/test/wait", testWait)
	}
	return r
}

fn run(c config.Config) ! {
	if c.Has("node") {
		try c.RequireSecrets()
	}
	try db.Current(pg)
	// the drain (SIGTERM) waits this long for requests in flight, so a push that has begun completes
	let grace = c.Shutdown / 1000000000
	try quarry.Setenv("TIN_GRACE", "{grace}")
	// a request's deadline is the longest any request has (a fetch's, or a push's when longer); pushes, fetches and API
	// calls each run inside their own budget below it
	mut longest = fetchWithin
	if c.PushDeadline > longest {
		longest = c.PushDeadline
	}
	anvil.Deadline(longest / 1000000)
	// each push, fetch and API call runs inside its own limit memory (design/tinhub.md §8), so anvil's default request
	// budget (a share of memory per core, smaller than a push's) is lifted; TIN_REQUEST_MEMORY, when set, is kept
	let (_, set) = quarry.LookupEnv("TIN_REQUEST_MEMORY")
	if !set {
		try quarry.Setenv("TIN_REQUEST_MEMORY", "0")
	}
	let r = routes(c)
	herald.Log(herald.LInfo, "tinhub starting", []str{"version", version, "roles", twine.Join(c.Roles, ","), "listen", c.Listen})
	// SIGHUP (systemctl reload, a certificate renewal hook) must not end the server: certificates are read again
	// when their files change, with or without it
	try signal.Ignore(signal.SIGHUP)
	if len(c.TLSCert) > 0 {
		// the files are read again when they change, so a renewed certificate needs no restart
		let cert = anvil.TLSCert{CertPEM: "", KeyPEM: "", CertFile: c.TLSCert, KeyFile: c.TLSKey}
		try r.ServeTLSConfig(c.Listen, anvil.TLSConfig{CertPEM: "", KeyPEM: "", Certificates: []anvil.TLSCert{cert}, ClientAuth: 0, ClientCAs: "", MinVersion: tls.VersionTLS13})
		return
	}
	try r.Serve(c.Listen)
}

fn migrate() ! {
	let n = try db.Migrate(pg)
	let at = try db.Applied(pg)
	say.Line("tinhub: applied {n} migrations; the database is at migration {at}")
}

fn main() {
	let b = boot
	if len(b.Err) > 0 {
		quarry.Eprintln("tinhub: {b.Err}")
		quarry.Exit(2)
	}
	match b.Command {
		"version" => {
			say.Line("tinhub {version}")
			quarry.Exit(0)
		}
		"run" => {
			run(b.Conf) catch err {
				quarry.Eprintln("tinhub: {fault.Message(err)}")
				quarry.Exit(1)
			}
		}
		"migrate" => {
			migrate() catch err {
				quarry.Eprintln("tinhub: migrate: {fault.Message(err)}")
				quarry.Exit(1)
			}
		}
		"admin" => {
			if len(b.Args) < 2 || b.Args[0] != "invite" || (len(b.Args) == 3 && b.Args[2] != "--site-admin") || len(b.Args) > 3 {
				quarry.Eprint(usage())
				quarry.Exit(2)
			}
			invite(b.Args[1], len(b.Args) == 3) catch err {
				quarry.Eprintln("tinhub: admin invite: {fault.Message(err)}")
				quarry.Exit(1)
			}
		}
		"check" => {
			let ok = checkNow(b.Conf) catch err {
				quarry.Eprintln("tinhub: check: {fault.Message(err)}")
				quarry.Exit(1)
				return
			}
			if !ok {
				quarry.Exit(1)
			}
		}
		"packs" => {
			if len(b.Args) == 1 && b.Args[0] == "copy" {
				copyNow(b.Conf) catch err {
					quarry.Eprintln("tinhub: packs copy: {fault.Message(err)}")
					quarry.Exit(1)
				}
				quarry.Exit(0)
			}
			if len(b.Args) != 1 || b.Args[0] != "sweep" {
				quarry.Eprint(usage())
				quarry.Exit(2)
			}
			sweepNow(b.Conf) catch err {
				quarry.Eprintln("tinhub: packs sweep: {fault.Message(err)}")
				quarry.Exit(1)
			}
		}
		_ => {
			quarry.Eprint(usage())
			quarry.Exit(2)
		}
	}
}

// sweepNow is tinhub packs sweep: the sweeps once, with the schema checked first.
fn sweepNow(c config.Config) ! {
	try db.Current(pg)
	try sweep(c, true)
	say.Line("tinhub: swept")
}

// copyNow is tinhub packs copy: every pack under packs.dir into the bucket the s3.* keys name, for the move from
// phase 1's directory store to S3 (design/tinhub.md §7). Run it again after switching packs.store to s3 to pick up
// what arrived in between: keys already in the bucket at the same size are skipped.
fn copyNow(c config.Config) ! {
	if c.S3Bucket == "" {
		fail "set s3.bucket and the other s3.* keys first"
	}
	mut from = try packs.NewDirStore(c.PacksDir)
	let client = try s3.New(s3.Config{Endpoint: c.S3Endpoint, Region: c.S3Region, AccessKey: c.S3AccessKey, SecretKey: c.S3SecretKey, Token: "", PathStyle: c.S3PathStyle, SignPayload: false, UnsignedPayload: false, Attempts: 0, Backoff: 0, Timeout: 0, TLS: nil})
	// the bucket is made when it can be; one that exists already, or credentials that may not make one, are no fault
	client.CreateBucket(c.S3Bucket) catch _ {
	}
	mut to = packs.S3Store{Client: client, Bucket: c.S3Bucket, Cache: c.PacksDir + "/cache"}
	let got = try packs.Copy(mut from, mut to, "repos/", c.PacksDir + "/tmp")
	say.Line("tinhub: copied {got.Copied} objects ({got.Bytes} bytes), {got.Skipped} already there")
}

// checkNow is tinhub check: every live pack is in the store at its size, with fingerprints of the refs and the live
// packs to compare with the same command's output before a backup (deploy/RUNBOOK.md). It reports false when a pack
// is missing.
fn checkNow(c config.Config) !bool {
	try db.Current(pg)
	mut st = try openStore(c)
	let v = try packs.Verify(pg, mut st)
	say.Line("refs {v.Refs}")
	say.Line("packs {v.Live} ({v.Packs} packs, {v.Bytes} bytes)")
	for m in v.Missing {
		say.Line("missing {m}")
	}
	return len(v.Missing) == 0
}

// invite is tinhub admin invite: a one-use code for tit key add, the way the first user (with --site-admin) and every
// later one gets in (design/tinhub.md §11).
fn invite(email str, siteAdmin bool) ! {
	try db.Current(pg)
	let code = try accounts.CreateInvite(pg, email, siteAdmin)
	say.Line("invite for {email}: {code}")
	say.Line("on their machine: tit key add {boot.Conf.PublicURL} {code}")
}
