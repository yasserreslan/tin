// Tests for review diffs and overlaps (#1021) against Postgres (TINHUB_TEST_DB): versions pushed through PgRepo, the
// jobs queued from the push event and run by the event queue's runner, the interdiff of a rebased change, the line
// diff fallback of a 50 MB file, and overlaps between open changes.

fn testDb(t mut crucible.T) ?postgres.Client {
	let (o, ok) = db.TestOptions()
	if !ok {
		t.Log("TINHUB_TEST_DB is not set: skipped")
		return nil
	}
	let c = db.Open(o)
	db.ResetForTests(c) catch err {
		t.Error("reset: {err}")
		return nil
	}
	_ = db.Migrate(c) catch err {
		t.Error("migrate: {err}")
		return nil
	}
	return c
}

fn nobody(q anvil.Req) !i64 {
	return 0
}

type fixture struct {
	r   repo.PgRepo
	dir str
	s   store.Mem
}

fn newRepo(c postgres.Client, name str, visibility str) !fixture {
	let o = try c.Query("INSERT INTO owners (name, kind) VALUES ('ada', 'user') ON CONFLICT (name) DO UPDATE SET kind = 'user' RETURNING id")
	let ownerId = o.Rows[0][0].Int()
	let r = try c.Query("INSERT INTO repos (owner_id, name, visibility, quota_bytes) VALUES ({ownerId}, {name}, {visibility}, 10000000000) RETURNING id")
	let dir = "/tmp/tin-test-tinhub-diffs-" + seal.Hex(seal.RandomBytes(4))
	let s = try packs.NewDirStore(dir + "/store")
	Configure(Deps{Db: c, Store: s, Cache: repo.NoCache(), Dir: dir, Auth: nobody})
	return fixture{r: repo.PgRepo{Db: c, Store: s, Cache: repo.NoCache(), Id: r.Rows[0][0].Int(), Dir: dir, Who: 0}, dir: dir, s: store.NewMem()}
}

fn person(when i64) object.Person {
	return object.Person{Name: "Ada", Email: "ada@example.com", When: when, Zone: 0}
}

// treeOfFiles writes the tree of files (path to text) into s, adding every id it writes to ids.
fn treeOfFiles(s mut store.Mem, files map[str]str, prefix str, ids mut []object.Id) !object.Id {
	mut keys = []str{}
	mut subdirs = map[str]bool{}
	for path, _ in files {
		if !twine.HasPrefix(path, prefix) {
			continue
		}
		let rest = path[len(prefix):]
		let slash = twine.IndexByte(rest, '/')
		if slash < 0 {
			keys = append(keys, rest)
		} else {
			let (_, seen) = subdirs[rest[0:slash]]
			if !seen {
				subdirs[rest[0:slash]] = true
				keys = append(keys, rest[0:slash] + "/")
			}
		}
	}
	sift.Strs(mut keys)
	mut entries = []object.Entry{}
	for k in keys {
		if twine.HasSuffix(k, "/") {
			let sub = try treeOfFiles(mut s, files, prefix + k, mut ids)
			entries = append(entries, object.Entry{Mode: object.Mode.Dir, Name: k[0:len(k) - 1], Id: sub})
		} else {
			let (body, _) = files[prefix + k]
			let blob = try s.PutRaw(object.Kind.Blob, body)
			ids = append(ids, blob)
			entries = append(entries, object.Entry{Mode: object.Mode.File, Name: k, Id: blob})
		}
	}
	let tree = try s.Put(object.Object.Tree(entries))
	ids = append(ids, tree)
	return tree
}

fn makeCommit(s mut store.Mem, files map[str]str, parents []object.Id, cid object.ChangeId, when i64, ids mut []object.Id) !object.Id {
	let tree = try treeOfFiles(mut s, files, "", mut ids)
	let c = object.CommitData{Tree: tree, Parents: parents, Change: cid, Author: person(when), Committer: person(when), GitHeaders: []str{}, Signature: "", Message: "test\n", Conflicts: []str{}}
	let id = try s.Put(object.Object.Commit(c))
	ids = append(ids, id)
	return id
}

// pushOf pushes ids' objects with the ref and change moves, as a push over the protocol commits them.
fn pushOf(f mut fixture, ids []object.Id, refs []transport.RefUpdate, changes []transport.ChangeUpdate) ! {
	let p = try packfile.Write(mut f.s, ids, f.r.TempDir())
	let st = try f.r.Stage(p.Path)
	_ = try f.r.Commit(transport.Update{Who: "ada@example.com", Command: "push", Changes: changes, Refs: refs, Pack: st.Name, Time: 1700000000000000000})
}

// version pushes a change version: a commit of files on parent, replacing the change's commit replaces ("" for none).
fn version(f mut fixture, files map[str]str, parent object.Id, cid object.ChangeId, replaces str, when i64) !object.Id {
	mut ids = []object.Id{}
	mut parents = []object.Id{}
	if parent != object.NoId {
		parents = append(parents, parent)
	}
	let id = try makeCommit(mut f.s, files, parents, cid, when, mut ids)
	try pushOf(mut f, ids, []transport.RefUpdate{}, []transport.ChangeUpdate{transport.ChangeUpdate{Change: cid.Letters(), Replaces: replaces, Commit: id.Hex()}})
	try fanOut(f.r.Db, f.r.Id)
	return id
}

// trunk pushes a commit of files to refs/heads/main.
fn trunk(f mut fixture, files map[str]str, parent object.Id, old str, when i64) !object.Id {
	mut ids = []object.Id{}
	mut parents = []object.Id{}
	if parent != object.NoId {
		parents = append(parents, parent)
	}
	let id = try makeCommit(mut f.s, files, parents, object.NewChangeId(), when, mut ids)
	try pushOf(mut f, ids, []transport.RefUpdate{transport.RefUpdate{Name: "refs/heads/main", Old: old, New: id.Hex()}}, []transport.ChangeUpdate{})
	return id
}

// fanOut does what the push fan-out does for review diffs: the newest push event's payload goes to EnqueueFor.
fn fanOut(c postgres.Client, repoId i64) ! {
	let rows = try c.Query("SELECT payload::text FROM events WHERE repo_id = {repoId} AND kind = 'push' ORDER BY id DESC LIMIT 1")
	mut tx = try c.Begin()
	_ = try EnqueueFor(mut tx, repoId, rows.Rows[0][0].Text())
	try tx.Commit()
}

// work runs every ready review.diff job through the event queue's runner.
fn work(c postgres.Client) !i64 {
	let d = try current()
	let runner = events.Runner{Db: c, Handlers: Handlers(d), Lease: 300 * 1000000000, Poll: 0}
	mut n = 0
	for {
		let ran = try runner.Step("test/1/0")
		if !ran {
			break
		}
		n += 1
	}
	let dead = try c.Query("SELECT count(*), coalesce(max(last_error), '') FROM events WHERE kind IN ('review.diff', 'overlap') AND state <> 'done'")
	if dead.Rows[0][0].Int() > 0 {
		fail "a job did not finish: " + dead.Rows[0][1].Text()
	}
	return n
}

fn diffOf(f fixture, ch object.ChangeId, n i64, against str) !DiffOut {
	let (body, ok) = try Stored(f.r.Id, ch.Letters(), n, against)
	if !ok {
		fail "no {against} diff of version {n}"
	}
	mut out = DiffOut{change: "", version: 0, against: "", kind: "", from: "", to: "", reason: "", files: []fileOut{}}
	try argo.Get(body, mut out)
	return out
}

// declsIn lists a diff's declarations as "path key change" and its files with a rest diff as "path (rest)".
fn declsIn(d DiffOut) []str {
	mut out = []str{}
	for f in d.files {
		for x in f.decls {
			out = append(out, "{f.path} {x.key} {x.change}")
		}
		if len(f.diff) > 0 {
			out = append(out, "{f.path} (rest)")
		}
	}
	return out
}

const libV0 = "package a\n\nimport \"twine\"\n\n// ReadFile reads.\nfn ReadFile(p str) str {{\n\treturn twine.TrimSpace(p)\n}}\n\n// Other is upstream's.\nfn Other() i64 {{\n\treturn 1\n}}\n"

// libUp is the trunk's edit: Other changes.
const libUp = "package a\n\nimport \"twine\"\n\n// ReadFile reads.\nfn ReadFile(p str) str {{\n\treturn twine.TrimSpace(p)\n}}\n\n// Other is upstream's.\nfn Other() i64 {{\n\treturn 2\n}}\n"

// libV1 is the change on the old trunk: ReadFile changes.
const libV1 = "package a\n\nimport \"twine\"\n\n// ReadFile reads.\nfn ReadFile(p str) str {{\n\treturn twine.ToLower(twine.TrimSpace(p))\n}}\n\n// Other is upstream's.\nfn Other() i64 {{\n\treturn 1\n}}\n"

// libV2 is the change rebased onto the new trunk, with one real edit: Extra.
const libV2 = "package a\n\nimport \"twine\"\n\n// ReadFile reads.\nfn ReadFile(p str) str {{\n\treturn twine.ToLower(twine.TrimSpace(p))\n}}\n\n// Other is upstream's.\nfn Other() i64 {{\n\treturn 2\n}}\n\nfn Extra() i64 {{\n\treturn 3\n}}\n"

// libV3 is v2 rebased onto a newer trunk again with no edit.
const libUp2 = "package a\n\nimport \"twine\"\n\n// ReadFile reads.\nfn ReadFile(p str) str {{\n\treturn twine.TrimSpace(p)\n}}\n\n// Other is upstream's.\nfn Other() i64 {{\n\treturn 3\n}}\n"

const libV3 = "package a\n\nimport \"twine\"\n\n// ReadFile reads.\nfn ReadFile(p str) str {{\n\treturn twine.ToLower(twine.TrimSpace(p))\n}}\n\n// Other is upstream's.\nfn Other() i64 {{\n\treturn 3\n}}\n\nfn Extra() i64 {{\n\treturn 3\n}}\n"

fn has(xs []str, x str) bool {
	for y in xs {
		if y == x {
			return true
		}
	}
	return false
}

// TestRebasedVersions: a change rebased onto a trunk that moved shows only its real edit against the version before.
fn TestRebasedVersions(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	let c = got
	mut f = newRepo(c, "tin", "public") catch err {
		t.Error("repo: {err}")
		return
	}
	let cid = object.NewChangeId()
	let b1 = trunk(mut f, map[str]str{"lib/a/a.tin": libV0, "README": "one\n"}, object.NoId, "", 1700000000) catch err {
		t.Error("trunk 1: {err}")
		return
	}
	let v1 = version(mut f, map[str]str{"lib/a/a.tin": libV1, "README": "one\n"}, b1, cid, "", 1700000010) catch err {
		t.Error("v1: {err}")
		return
	}
	let b2 = trunk(mut f, map[str]str{"lib/a/a.tin": libUp, "README": "two\n", "NEWS": "news\n"}, b1, b1.Hex(), 1700000020) catch err {
		t.Error("trunk 2: {err}")
		return
	}
	let v2 = version(mut f, map[str]str{"lib/a/a.tin": libV2, "README": "two\n", "NEWS": "news\n"}, b2, cid, v1.Hex(), 1700000030) catch err {
		t.Error("v2: {err}")
		return
	}
	let b3 = trunk(mut f, map[str]str{"lib/a/a.tin": libUp2, "README": "three\n", "NEWS": "news\n"}, b2, b2.Hex(), 1700000040) catch err {
		t.Error("trunk 3: {err}")
		return
	}
	_ = version(mut f, map[str]str{"lib/a/a.tin": libV3, "README": "three\n", "NEWS": "news\n"}, b3, cid, v2.Hex(), 1700000050) catch err {
		t.Error("v3: {err}")
		return
	}
	let jobs = c.Query("SELECT count(*) FROM events WHERE kind IN ('review.diff', 'overlap')") catch err {
		t.Error("jobs: {err}")
		return
	}
	crucible.Equal(mut t, "one job per version", jobs.Rows[0][0].Int(), 3)
	let ran = work(c) catch err {
		t.Error("work: {err}")
		return
	}
	crucible.Equal(mut t, "every job ran", ran, 3)
	let base1 = diffOf(f, cid, 1, "base") catch err {
		t.Error("v1 base: {err}")
		return
	}
	let d1 = declsIn(base1)
	t.True("v1 against its base: only ReadFile changed: {d1}", base1.kind == "semantic" && len(d1) == 1 && has(d1, "lib/a/a.tin fn ReadFile changed") && base1.from == b1.Hex())
	let base2 = diffOf(f, cid, 2, "base") catch err {
		t.Error("v2 base: {err}")
		return
	}
	let d2 = declsIn(base2)
	t.True("v2 against its base: ReadFile and Extra: {d2}", len(d2) == 2 && has(d2, "lib/a/a.tin fn ReadFile changed") && has(d2, "lib/a/a.tin fn Extra added"))
	let prev2 = diffOf(f, cid, 2, "previous") catch err {
		t.Error("v2 previous: {err}")
		return
	}
	let p2 = declsIn(prev2)
	t.True("v2 against v1: only the real edit (Extra), not the trunk's Other, README or NEWS: {p2}", prev2.kind == "semantic" && len(p2) == 1 && has(p2, "lib/a/a.tin fn Extra added") && prev2.from == v1.Hex())
	t.True("the edit's text", len(prev2.files) == 1 && twine.Contains(prev2.files[0].decls[0].diff, "+fn Extra() i64 {{"))
	let prev3 = diffOf(f, cid, 3, "previous") catch err {
		t.Error("v3 previous: {err}")
		return
	}
	crucible.Equal(mut t, "a rebase with no edit shows nothing", len(prev3.files), 0)
	// the routes
	mut r = anvil.NewRouter()
	Mount(mut r)
	let w = r.Run("GET", "/api/v1/repos/ada/tin/changes/" + cid.Letters() + "/diffs/previous?version=2", "")
	t.True("GET …/diffs/previous: {str(w.Body)}", w.Code() == 200 && twine.Contains(str(w.Body), "fn Extra") && !twine.Contains(str(w.Body), "fn Other"))
	let nw = r.Run("GET", "/api/v1/repos/ada/tin/changes/" + cid.Letters() + "/diffs/base", "")
	t.True("the newest version by default: {str(nw.Body)}", nw.Code() == 200 && twine.Contains(str(nw.Body), "\"version\":3"))
	let none = r.Run("GET", "/api/v1/repos/ada/tin/changes/" + cid.Letters() + "/diffs/previous?version=1", "")
	crucible.Equal(mut t, "the first version has no previous", none.Code(), 404)
	quarry.RemoveAll(f.dir) catch _ {
	}
}

// big is a Tin file of about n bytes: one small function after another; function edit's body says "edited" (-1 for
// none).
fn big(n i64, edit i64) str {
	mut out = make([]u8, 0, n + 64)
	mut i = 0
	for len(out) < n {
		mut body = "{i}"
		if i == edit {
			body = "edited"
		}
		let decl = "fn f{i}() str {{\n\treturn \"{body}\"\n}}\n\n"
		for k in 0..len(decl) {
			out = append(out, decl[k])
		}
		i += 1
	}
	return str(out)
}

// TestLargeFile: a 50 MB file's semantic diff is over its 48mb, so the diff falls back to a line diff, inside the
// job's budget.
fn TestLargeFile(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	let c = got
	mut f = newRepo(c, "large", "public") catch err {
		t.Error("repo: {err}")
		return
	}
	let cid = object.NewChangeId()
	let b1 = trunk(mut f, map[str]str{"gen/big.tin": big(50 * 1024 * 1024, -1)}, object.NoId, "", 1700000000) catch err {
		t.Error("trunk: {err}")
		return
	}
	_ = version(mut f, map[str]str{"gen/big.tin": big(50 * 1024 * 1024, 700000)}, b1, cid, "", 1700000010) catch err {
		t.Error("v1: {err}")
		return
	}
	let started = tide.Now()
	_ = work(c) catch err {
		t.Error("work: {err}")
		return
	}
	let took = tide.Now() - started
	t.Log("the 50 MB file's job took {took / tide.Millisecond}ms")
	t.True("within the diff job's budget", took < DiffWithin)
	let d = diffOf(f, cid, 1, "base") catch err {
		t.Error("diff: {err}")
		return
	}
	t.True("a line diff, saying why: {d.kind} {d.reason}", d.kind == "lines" && len(d.reason) > 0)
	t.True("the edit is in it", len(d.files) == 1 && twine.Contains(d.files[0].diff, "+\treturn \"edited\"") && twine.Contains(d.files[0].diff, "-\treturn \"700000\""))
	quarry.RemoveAll(f.dir) catch _ {
	}
}

// TestStoredBody: a diff over bodyMax is kept in the pack store and read back from it.
fn TestStoredBody(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	let c = got
	mut f = newRepo(c, "store", "public") catch err {
		t.Error("repo: {err}")
		return
	}
	mut data = []u8{}
	for i in 0..20000 {
		let line = "line {i} of the data\n"
		for k in 0..len(line) {
			data = append(data, line[k])
		}
	}
	let cid = object.NewChangeId()
	let b = trunk(mut f, map[str]str{"README": "x\n"}, object.NoId, "", 1700000000) catch err {
		t.Error("trunk: {err}")
		return
	}
	_ = version(mut f, map[str]str{"README": "x\n", "data.txt": str(data)}, b, cid, "", 1700000010) catch err {
		t.Error("v1: {err}")
		return
	}
	_ = work(c) catch err {
		t.Error("work: {err}")
		return
	}
	let chId = cid.Letters()
	let row = c.Query("SELECT stored::int, length(body) FROM diffs WHERE repo_id = {f.r.Id} AND change_id = {chId}") catch err {
		t.Error("row: {err}")
		return
	}
	t.True("kept in the pack store, not the row", len(row.Rows) == 1 && row.Rows[0][0].Int() == 1 && row.Rows[0][1].Int() == 0)
	let d = diffOf(f, cid, 1, "base") catch err {
		t.Error("read back: {err}")
		return
	}
	t.True("read back whole", len(d.files) == 1 && d.files[0].path == "data.txt" && twine.Contains(d.files[0].diff, "+line 19999 of the data"))
	mut r = anvil.NewRouter()
	Mount(mut r)
	let w = r.Run("GET", "/api/v1/repos/ada/store/changes/" + chId + "/diffs/base", "")
	t.True("GET answers it", w.Code() == 200 && len(w.Body) > bodyMax)
	quarry.RemoveAll(f.dir) catch _ {
	}
}

const ovBase = "package a\n\n// ReadFile reads.\nfn ReadFile(p str) str {{\n\treturn p\n}}\n\ntype Buf struct {{\n\tn i64\n}}\n\nfn Other() i64 {{\n\treturn 1\n}}\n"

// TestOverlaps: open changes on one base name the declarations they share; an abandoned change drops out.
fn TestOverlaps(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	let c = got
	mut f = newRepo(c, "ov", "public") catch err {
		t.Error("repo: {err}")
		return
	}
	let b = trunk(mut f, map[str]str{"lib/a/a.tin": ovBase}, object.NoId, "", 1700000000) catch err {
		t.Error("trunk: {err}")
		return
	}
	let one = object.NewChangeId()
	let two = object.NewChangeId()
	let three = object.NewChangeId()
	let s1 = twine.ReplaceAll(twine.ReplaceAll(ovBase, "return p\n", "return p + p\n"), "\tn i64\n", "\tn i64\n\tm i64\n")
	let s2 = twine.ReplaceAll(ovBase, "return p\n", "return \"\" + p\n")
	let s3 = twine.ReplaceAll(ovBase, "return 1\n", "return 3\n")
	let cids = []object.ChangeId{one, two, three}
	let texts = []str{s1, s2, s3}
	for x in 0..3 {
		_ = version(mut f, map[str]str{"lib/a/a.tin": texts[x]}, b, cids[x], "", 1700000001 + x) catch err {
			t.Error("version {x}: {err}")
			return
		}
	}
	_ = work(c) catch err {
		t.Error("work: {err}")
		return
	}
	let o1 = Overlaps(c, f.r.Id, one.Letters()) catch err {
		t.Error("overlaps 1: {err}")
		return
	}
	t.True("one shares ReadFile with two, exactly", len(o1.overlaps) == 1 && o1.overlaps[0].change == two.Letters() && len(o1.overlaps[0].decls) == 1 && o1.overlaps[0].decls[0] == "lib/a: fn ReadFile")
	let o2 = Overlaps(c, f.r.Id, two.Letters()) catch err {
		t.Error("overlaps 2: {err}")
		return
	}
	t.True("two (pushed later) sees one too", len(o2.overlaps) == 1 && o2.overlaps[0].change == one.Letters())
	let o3 = Overlaps(c, f.r.Id, three.Letters()) catch err {
		t.Error("overlaps 3: {err}")
		return
	}
	crucible.Equal(mut t, "three shares nothing", len(o3.overlaps), 0)
	let held = c.Query("SELECT decl FROM change_decls WHERE repo_id = {f.r.Id} AND change_id = {one.Letters()} ORDER BY decl") catch err {
		t.Error("decls: {err}")
		return
	}
	t.True("one's declarations", len(held.Rows) == 2 && held.Rows[0][0].Text() == "lib/a: fn ReadFile" && held.Rows[1][0].Text() == "lib/a: type Buf")
	// two is abandoned: one has no overlap any more
	let twoId = two.Letters()
	_ = c.Exec("INSERT INTO reviews (repo_id, change_id, state, target) VALUES ({f.r.Id}, {twoId}, 'abandoned', 'refs/heads/main')") catch err {
		t.Error("abandon: {err}")
		return
	}
	let after = Overlaps(c, f.r.Id, one.Letters()) catch err {
		t.Error("overlaps after: {err}")
		return
	}
	crucible.Equal(mut t, "an abandoned change does not overlap", len(after.overlaps), 0)
	mut r = anvil.NewRouter()
	Mount(mut r)
	let w = r.Run("GET", "/api/v1/repos/ada/ov/changes/" + three.Letters() + "/overlaps", "")
	t.True("GET …/overlaps: {str(w.Body)}", w.Code() == 200 && twine.Contains(str(w.Body), "\"overlaps\":[]"))
	quarry.RemoveAll(f.dir) catch _ {
	}
}

// TestPrivate: a private repository's diffs and overlaps are 404 to someone outside it.
fn TestPrivate(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	let c = got
	mut f = newRepo(c, "secret", "private") catch err {
		t.Error("repo: {err}")
		return
	}
	let cid = object.NewChangeId()
	let b = trunk(mut f, map[str]str{"lib/a/a.tin": libV0}, object.NoId, "", 1700000000) catch err {
		t.Error("trunk: {err}")
		return
	}
	_ = version(mut f, map[str]str{"lib/a/a.tin": libV1}, b, cid, "", 1700000010) catch err {
		t.Error("v1: {err}")
		return
	}
	_ = work(c) catch err {
		t.Error("work: {err}")
		return
	}
	mut r = anvil.NewRouter()
	Mount(mut r)
	let w = r.Run("GET", "/api/v1/repos/ada/secret/changes/" + cid.Letters() + "/diffs/base", "")
	t.True("a private repository's diff is not found: {str(w.Body)}", w.Code() == 404 && !twine.Contains(str(w.Body), "ReadFile"))
	let o = r.Run("GET", "/api/v1/repos/ada/secret/changes/" + cid.Letters() + "/overlaps", "")
	crucible.Equal(mut t, "a private repository's overlaps", o.Code(), 404)
	quarry.RemoveAll(f.dir) catch _ {
	}
}

// TestSemanticBudget: a semantic diff over its 48mb (two 20 MB files of small declarations) fails with LimitExceeded,
// which Compute turns into a line diff.
fn TestSemanticBudget(t mut crucible.T) {
	let a = big(20 * 1024 * 1024, -1)
	let b = big(20 * 1024 * 1024, 300000)
	let (_, err) = semanticWithin_(false, []fileIn{fileIn{path: "gen/big.tin", oldPath: "gen/big.tin", ob: "", o: a, nb: "", n: b}})
	t.True("over the budget: {err}", err != nil && fault.Is(err, fault.LimitExceeded))
	let d = lineDiff("gen/big.tin", "gen/big.tin", a, b)
	t.True("the line diff has the edit, at its line: {d}", twine.Contains(d, "@@ -1199999,7 +1199999,7 @@") && twine.Contains(d, "+\treturn \"edited\""))
}

fn TestInterdiffUnits(t mut crucible.T) {
	t.True("one edit on two bases is the same patch", samePatch("a\nb\nc\n", "a\nB\nc\n", "z\na\nb\nc\n", "z\na\nB\nc\n"))
	t.True("another edit is not", !samePatch("a\nb\n", "a\nB\n", "a\nb\n", "a\nC\n"))
	crucible.Equal(mut t, "rest is what lies outside declarations", rest("package a\n\nfn F() {{\n}}\n", []semantic.Decl{semantic.Decl{Key: "fn F", Name: "F", Line: 3, Text: "fn F() {{\n}}", Norm: ""}}), "package a\n")
	t.True("binary", binary("a\x00b") && !binary("ab"))
}
