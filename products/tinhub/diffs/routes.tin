package diffs

import "../accounts"
import "anvil"
import "argo"
import "fault"
import "mint"
import "tide"

// The review diffs' routes: a version's kept diff (against its base or the previous version) and a change's overlaps.
// A private repository the caller cannot read is 404, as one that does not exist.

const readWithin = 2 * tide.Second

const readMemory = 16 * 1024 * 1024

// Mount adds the routes to r.
fn Mount(r mut anvil.Router) {
	r.Get(`/api/v1/repos/{owner}/{repo}/changes/{change}/diffs/{against}`, versionDiff)
	r.Get(`/api/v1/repos/{owner}/{repo}/changes/{change}/overlaps`, overlaps)
}

type apiError struct {
	code    str
	message str
}

fn fail_(w mut anvil.Out, status i64, code str, message str) {
	w.Status(status)
	w.Json()
	w.Body = []u8{}
	argo.Put(mut w.Body, apiError{code: code, message: message})
}

// readable is the repository of a request's path when the caller can read it; nil when the answer is written.
fn readable(q anvil.Req, w mut anvil.Out) ?accounts.Repo {
	let got = deps
	if got == nil {
		fail_(mut w, 503, "unavailable", "review diffs are not configured on this core")
		return nil
	}
	let d = got
	let auth = d.Auth
	let user = auth(q) catch err {
		fail_(mut w, 401, "unauthorized", fault.Message(err))
		return nil
	}
	let owner = q.PathParam("owner")
	let name = q.PathParam("repo")
	let found = accounts.FindRepo(d.Db, owner, name) catch err {
		fail_(mut w, 503, "unavailable", fault.Message(err))
		return nil
	}
	if found == nil {
		fail_(mut w, 404, "not_found", "no repository {owner}/{name}")
		return nil
	}
	let role = accounts.RoleOf(d.Db, user, found) catch err {
		fail_(mut w, 503, "unavailable", fault.Message(err))
		return nil
	}
	if role == accounts.RoleNone {
		fail_(mut w, 404, "not_found", "no repository {owner}/{name}")
		return nil
	}
	return found
}

// versionDiff is GET …/changes/{change}/diffs/{against}?version=: the kept diff of a version (by default the newest)
// against "base" or "previous"; 202 while the job has not computed it yet.
fn versionDiff(q anvil.Req, w mut anvil.Out) {
	let r = readable(q, mut w)
	if r == nil {
		return
	}
	let against = q.PathParam("against")
	if against != "base" && against != "previous" {
		fail_(mut w, 404, "not_found", "a diff is against base or previous, not {against}")
		return
	}
	let ch = q.PathParam("change")
	let n = mint.Atoi(q.Param("version")) catch _ {
		0
	}
	let d = deps
	if d == nil {
		return
	}
	let (body, err) = readDiff(d, r.Id, ch, n, against)
	if err != nil {
		if fault.Is(err, ErrNoVersion) {
			fail_(mut w, 404, "not_found", fault.Message(err))
			return
		}
		fail_(mut w, 503, "unavailable", fault.Message(err))
		return
	}
	if len(body) == 0 {
		fail_(mut w, 202, "pending", "the diff of {ch} is not computed yet")
		return
	}
	w.Json()
	w.Body = []u8(body)
}

fn readDiff(d Deps, repoId i64, ch str, n i64, against str) !str {
	mut out = ""
	try within readWithin {
		let v = try versionAt(d.Db, repoId, ch, n)
		if against == "previous" && len(v.Previous) == 0 {
			fail fault.Wrap(ErrNoVersion, "{ch} version {v.Number} has no version before it")
		}
		let (body, ok) = try Stored(repoId, ch, v.Number, against)
		if ok {
			out = keep(body)
		}
	}
	return out
}

// overlaps is GET …/changes/{change}/overlaps: the other open changes that touch the declarations its newest version
// touches, and those declarations.
fn overlaps(q anvil.Req, w mut anvil.Out) {
	let r = readable(q, mut w)
	if r == nil {
		return
	}
	let d = deps
	if d == nil {
		return
	}
	let ch = q.PathParam("change")
	let (out, err) = readOverlaps(d, r.Id, ch)
	if err != nil {
		if fault.Is(err, ErrNoVersion) {
			fail_(mut w, 404, "not_found", fault.Message(err))
			return
		}
		fail_(mut w, 503, "unavailable", fault.Message(err))
		return
	}
	w.Json()
	w.Body = []u8{}
	argo.Put(mut w.Body, out)
}

fn readOverlaps(d Deps, repoId i64, ch str) !overlapOut {
	mut out = overlapOut{change: ch, version: 0, overlaps: []otherOut{}}
	try within readWithin {
		try limit memory readMemory {
			let got = try Overlaps(d.Db, repoId, ch)
			out = keep(got)
		}
	}
	return out
}
