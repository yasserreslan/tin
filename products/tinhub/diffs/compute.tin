package diffs

import "../../tit/diff"
import "../../tit/object"
import "../../tit/semantic"
import "../../tit/store"
import "fault"
import "mint"
import "sift"
import "twine"

// Computing a diff. Against the base it is tit's semantic diff: each Tin file's declarations that were added,
// removed, changed, moved or renamed, each with the line diff of its text, and the line diff of what lies outside
// every declaration (the package line, imports); any other file is a line diff. Against the previous version it is an
// interdiff: of the paths either version touched, a declaration shows only when the two versions differ in it and the
// difference is not the rebase's (neither version edited it, or both made the same edit to it on their own bases).
// The line diff fallback is the same over whole files. The files are read first (in the job's budget); the semantic
// diff is then computed from their texts inside its own. A line diff splits and diffs only what lies between the
// lines both texts start and end with (plus the context), with a cost bound past which a part of it is a whole
// replacement, so a huge file with a small edit is cheap and one with a large edit never takes long.

// contextLines is the context each hunk keeps; lineCost bounds the work of one line diff (tit/diff.DiffLimit).
const contextLines = 3

const lineCost = 4 * 1024 * 1024

// declOut is one declaration's change: how it changed (tit/semantic's kinds), its key ("fn Name", "method T.Name",
// ...), its key before (a rename or a move), and the line diff of its text.
type declOut struct {
	change  str
	key     str
	old_key str
	diff    str
}

// fileOut is one file of a diff: the declarations that changed, and the line diff of the rest of the file (of the
// whole file when it is not Tin, or the diff is a line diff).
type fileOut struct {
	path     str
	old_path str
	decls    []declOut
	diff     str
}

// DiffOut is a diff as it is kept and as the API answers it: kind "semantic" or "lines" (with the reason the semantic
// diff did not fit its budget), from the base or previous version's commit to the version's.
type DiffOut struct {
	change  str
	version i64
	against str
	kind    str
	from    str
	to      str
	reason  str
	files   []fileOut
}

// pair is what a diff compares: the trees from and to and, for an interdiff, the base tree of each.
type pair struct {
	from    str
	inter   bool
	oldBase object.Id
	oldTree object.Id
	newBase object.Id
	newTree object.Id
}

fn commitData(st mut store.Layered, hex str) !object.CommitData {
	let id = try object.ParseId(hex)
	let o = try st.Get(id)
	return match o {
		Commit(cd) => cd
		Tree(_) => try notCommit(hex)
		Tag(_) => try notCommit(hex)
		Blob(_) => try notCommit(hex)
	}
}

fn notCommit(hex str) !object.CommitData {
	fail "diffs: {hex} is not a commit"
}

// baseOf is a commit's parent ("" for a root commit) and the parent's tree.
fn baseOf(st mut store.Layered, cd object.CommitData) !(str, object.Id) {
	if len(cd.Parents) == 0 {
		return "", object.NoId
	}
	let hex = cd.Parents[0].Hex()
	let p = try commitData(mut st, hex)
	return hex, p.Tree
}

fn pairOf(st mut store.Layered, v Version, against str) !pair {
	let cd = try commitData(mut st, v.Commit)
	let (base, baseTree) = try baseOf(mut st, cd)
	if against == "base" {
		return pair{from: base, inter: false, oldBase: object.NoId, oldTree: baseTree, newBase: object.NoId, newTree: cd.Tree}
	}
	if len(v.Previous) == 0 {
		fail fault.Wrap(ErrNoVersion, "{v.Change} version {v.Number} has no version before it")
	}
	let pd = try commitData(mut st, v.Previous)
	let (_, prevBase) = try baseOf(mut st, pd)
	return pair{from: v.Previous, inter: true, oldBase: prevBase, oldTree: pd.Tree, newBase: baseTree, newTree: cd.Tree}
}

// fileIn is one path's texts. Against the base: o, the old text (at oldPath for a rename) and n, the new; for an
// interdiff also ob and nb, the path's texts at each version's base.
type fileIn struct {
	path    str
	oldPath str
	ob      str
	o       str
	nb      str
	n       str
}

// slot is one file a diff compares, before its texts are read: its path, its old path and, against the base, both
// blob ids as bytes.
type slot struct {
	path    str
	oldPath str
	oldHash str
	newHash str
}

// slots lists the files a diff compares: against the base, each file the tree diff names; for an interdiff, each path
// either version touched.
fn slots(st mut store.Layered, p pair) ![]slot {
	mut out = []slot{}
	if !p.inter {
		let fcs = try diff.TreeDiff(mut st, p.oldTree, p.newTree, true)
		for fc in fcs {
			out = append(out, slot{path: fc.Path, oldPath: fc.OldPath, oldHash: fc.OldHash, newHash: fc.NewHash})
		}
		return out
	}
	let paths = try touched(mut st, p)
	for path in paths {
		out = append(out, slot{path: path, oldPath: path, oldHash: "", newHash: ""})
	}
	return out
}

// readSlot reads one file's texts.
fn readSlot(st mut store.Layered, p pair, x slot) !fileIn {
	if !p.inter {
		let a = try blobText(mut st, x.oldHash)
		let b = try blobText(mut st, x.newHash)
		return fileIn{path: x.path, oldPath: x.oldPath, ob: "", o: a, nb: "", n: b}
	}
	let o = try blobAt(mut st, p.oldTree, x.path)
	let n = try blobAt(mut st, p.newTree, x.path)
	if o == n {
		return fileIn{path: x.path, oldPath: x.path, ob: "", o: o, nb: "", n: n}
	}
	let ob = try blobAt(mut st, p.oldBase, x.path)
	let nb = try blobAt(mut st, p.newBase, x.path)
	return fileIn{path: x.path, oldPath: x.path, ob: ob, o: o, nb: nb, n: n}
}

// gatherMemory is the most reading all of a diff's files at once may take. Past it each text is read in an arena of
// its own: tit's inflater takes up to 6 times a file's size, given back when the arena ends, so a diff of a 50 MB file
// keeps the texts and not that.
const gatherMemory = 128 * 1024 * 1024

fn gatherAll(repoId i64, p pair) ![]fileIn {
	return try arena {
		try limit memory gatherMemory + 0 {
			mut r = try pgRepo(repoId)
			mut st = try r.Objects()
			let xs = try slots(mut st, p)
			mut out = []fileIn{}
			for x in xs {
				let f = try readSlot(mut st, p, x)
				out = append(out, f)
			}
			out
		}
	}
}

// textIn reads one text in an arena of its own: the blob hash names, or the file at path in tree.
fn textIn(repoId i64, hash str, tree object.Id, path str) !str {
	return try arena {
		mut r = try pgRepo(repoId)
		mut st = try r.Objects()
		mut text = ""
		if len(hash) > 0 || len(path) == 0 {
			text = try blobText(mut st, hash)
		} else {
			text = try blobAt(mut st, tree, path)
		}
		text
	}
}

fn gatherEach(repoId i64, p pair) ![]fileIn {
	let xs = try arena {
		mut r = try pgRepo(repoId)
		mut st = try r.Objects()
		try slots(mut st, p)
	}
	mut out = []fileIn{}
	for x in xs {
		if !p.inter {
			let a = try textIn(repoId, x.oldHash, object.NoId, "")
			let b = try textIn(repoId, x.newHash, object.NoId, "")
			out = append(out, fileIn{path: x.path, oldPath: x.oldPath, ob: "", o: a, nb: "", n: b})
			continue
		}
		let o = try textIn(repoId, "", p.oldTree, x.path)
		let n = try textIn(repoId, "", p.newTree, x.path)
		if o == n {
			continue
		}
		let ob = try textIn(repoId, "", p.oldBase, x.path)
		let nb = try textIn(repoId, "", p.newBase, x.path)
		out = append(out, fileIn{path: x.path, oldPath: x.path, ob: ob, o: o, nb: nb, n: n})
	}
	return out
}

// gather reads the texts of the files a diff compares; for an interdiff, those whose text differs between the
// versions.
fn gather(repoId i64, p pair) ![]fileIn {
	mut all = []fileIn{}
	let (got, err) = gatherAll(repoId, p)
	if err == nil {
		all = got
	} else {
		if !fault.Is(err, fault.LimitExceeded) {
			fail err
		}
		all = try gatherEach(repoId, p)
	}
	mut out = []fileIn{}
	for f in all {
		if !p.inter || f.o != f.n {
			out = append(out, f)
		}
	}
	return out
}

// Compute is a version's diff against "base" or "previous" (semantic inside its budget, else lines), and the texts it
// compared.
fn Compute(repoId i64, v Version, against str) !(DiffOut, []fileIn) {
	let p = try arena {
		mut r = try pgRepo(repoId)
		mut st = try r.Objects()
		try pairOf(mut st, v, against)
	}
	let files = try gather(repoId, p)
	mut out = DiffOut{change: v.Change, version: v.Number, against: against, kind: "semantic", from: p.from, to: v.Commit, reason: "", files: []fileOut{}}
	mut size = 0
	for f in files {
		size += len(f.ob) + len(f.o) + len(f.nb) + len(f.n)
	}
	if size > semanticMemory {
		// the texts alone are over the budget: not worth trying
		out.kind = "lines"
		out.reason = "the files are {size} bytes, over the semantic diff's {semanticMemory}"
		out.files = lineFiles(p.inter, files)
		return out, files
	}
	let (sem, err) = semanticWithin_(p.inter, files)
	if err == nil {
		out.files = sem
		return out, files
	}
	if !fault.Is(err, fault.LimitExceeded) && !fault.Is(err, fault.DeadlineExceeded) {
		fail err
	}
	out.kind = "lines"
	out.reason = fault.Message(err)
	out.files = lineFiles(p.inter, files)
	return out, files
}

// semanticWithin_ is the semantic diff of files inside its budget (semanticWithin, semanticMemory).
fn semanticWithin_(inter bool, files []fileIn) ![]fileOut {
	mut out = []fileOut{}
	try within semanticWithin + 0 {
		try limit memory semanticMemory + 0 {
			let got = semanticFiles(inter, files)
			out = keep(got)
		}
	}
	return out
}

// ---- reading files ----

fn blobText(st mut store.Layered, hash str) !str {
	if len(hash) == 0 {
		return ""
	}
	let id = try object.IdOf(hash)
	let (_, body) = try st.GetRaw(id)
	return body
}

// blobAt is the text of the file at path in a tree, "" when there is none.
fn blobAt(st mut store.Layered, tree object.Id, path str) !str {
	if tree == object.NoId {
		return ""
	}
	let parts = twine.Split(path, "/")
	mut at = tree
	for i, name in parts {
		let o = try st.Get(at)
		mut next = object.NoId
		mut dir = false
		match o {
			Tree(es) => {
				for e in es {
					if e.Name == name {
						next = e.Id
						dir = e.Mode == object.Mode.Dir
						break
					}
				}
			}
			Commit(_) => {
			}
			Tag(_) => {
			}
			Blob(_) => {
			}
		}
		if next == object.NoId {
			return ""
		}
		if i == len(parts) - 1 {
			if dir {
				return ""
			}
			let (_, body) = try st.GetRaw(next)
			return body
		}
		if !dir {
			return ""
		}
		at = next
	}
	return ""
}

fn isTin(path str) bool {
	return twine.HasSuffix(path, ".tin")
}

// binary reports whether a file looks binary: a NUL byte in its first 8000 bytes, as git decides.
fn binary(text str) bool {
	let n = min(len(text), 8000)
	for i in 0..n {
		if text[i] == 0 {
			return true
		}
	}
	return false
}

// ---- line diffs ----

// lineStart reports whether at starts a line of s.
fn lineStart(s str, at i64) bool {
	return at == 0 || s[at - 1] == '\n'
}

// common is how many bytes a and b start and end with in whole lines (the two never overlap).
fn common(a str, b str) (i64, i64) {
	let most = min(len(a), len(b))
	mut pre = 0
	for pre < most && a[pre] == b[pre] {
		pre += 1
	}
	for pre > 0 && a[pre - 1] != '\n' {
		pre -= 1
	}
	mut suf = 0
	for suf < most - pre && a[len(a) - 1 - suf] == b[len(b) - 1 - suf] {
		suf += 1
	}
	for suf > 0 && !(lineStart(a, len(a) - suf) && lineStart(b, len(b) - suf)) {
		suf -= 1
	}
	return pre, suf
}

// lineDiff is the unified diff of a and b ("" when they are equal), its work bounded by lineCost: the lines both start
// and end with, less the context, are left out of the diff and its hunks' line numbers moved past them.
fn lineDiff(oldName str, newName str, a str, b str) str {
	if a == b {
		return ""
	}
	if binary(a) || binary(b) {
		return "Binary files {oldName} and {newName} differ\n"
	}
	let (pre0, suf0) = common(a, b)
	mut pre = pre0
	for step in 0..contextLines {
		if pre == 0 {
			break
		}
		pre -= 1
		for pre > 0 && a[pre - 1] != '\n' {
			pre -= 1
		}
	}
	mut suf = suf0
	for step in 0..contextLines {
		if suf == 0 {
			break
		}
		let at = len(a) - suf
		let nl = twine.IndexByte(a[at:], '\n')
		if nl < 0 {
			suf = 0
		} else {
			suf = len(a) - (at + nl + 1)
		}
	}
	let la = diff.Lines(a[pre:len(a) - suf])
	let lb = diff.Lines(b[pre:len(b) - suf])
	let (es, _) = diff.DiffLimit(la, lb, lineCost)
	let text = diff.UnifiedLines(oldName, newName, la, lb, es, contextLines)
	let skipped = twine.Count(a[0:pre], "\n")
	if skipped == 0 {
		return text
	}
	let lines = twine.Split(text, "\n")
	mut out = []str{}
	for l in lines {
		if twine.HasPrefix(l, "@@ -") {
			out = append(out, shiftHunk(l, skipped))
		} else {
			out = append(out, l)
		}
	}
	return twine.Join(out, "\n")
}

// shiftHunk moves a hunk header's two start lines ("@@ -a,b +c,d @@") on by n.
fn shiftHunk(h str, n i64) str {
	mut parts = twine.Split(h, " ")
	if len(parts) < 3 {
		return h
	}
	parts[1] = "-" + shiftRange(parts[1][1:], n)
	parts[2] = "+" + shiftRange(parts[2][1:], n)
	return twine.Join(parts, " ")
}

fn shiftRange(r str, n i64) str {
	let (start, count, has) = twine.Cut(r, ",")
	let at = mint.Atoi(start) catch _ {
		return r
	}
	if has {
		return "{at + n},{count}"
	}
	return "{at + n}"
}

// patchOf is the edit from a to b without its positions: each line removed ("-") and added ("+"), in order.
fn patchOf(a str, b str) []str {
	mut out = []str{}
	if a == b {
		return out
	}
	let (pre, suf) = common(a, b)
	let la = diff.Lines(a[pre:len(a) - suf])
	let lb = diff.Lines(b[pre:len(b) - suf])
	let (es, _) = diff.DiffLimit(la, lb, lineCost)
	mut i = 0
	mut j = 0
	for e in es {
		match e {
			Keep(n) => {
				i += n
				j += n
			}
			Delete(n) => {
				for k in 0..n {
					out = append(out, "-" + la[i + k])
				}
				i += n
			}
			Insert(n) => {
				for k in 0..n {
					out = append(out, "+" + lb[j + k])
				}
				j += n
			}
		}
	}
	return out
}

// samePatch reports whether the edit from ob to o is the edit from nb to n: one edit made on two bases.
fn samePatch(ob str, o str, nb str, n str) bool {
	let p = patchOf(ob, o)
	let q = patchOf(nb, n)
	if len(p) != len(q) {
		return false
	}
	for i in 0..len(p) {
		if p[i] != q[i] {
			return false
		}
	}
	return true
}

// ---- declarations ----

fn byKey(ds []semantic.Decl) map[str]semantic.Decl {
	mut out = map[str]semantic.Decl{}
	for d in ds {
		out[d.Key] = d
	}
	return out
}

fn textOf(ds map[str]semantic.Decl, key str) str {
	let (d, ok) = ds[key]
	if !ok {
		return ""
	}
	return d.Text
}

// normOf is a declaration's normalized text, "\x00" when there is none (so an empty one still differs from none).
fn normOf(ds map[str]semantic.Decl, key str) str {
	let (d, ok) = ds[key]
	if !ok {
		return "\x00"
	}
	return d.Norm
}

// rest is a file's lines outside every declaration (its package line, imports, stray comments), blank lines left out.
fn rest(text str, ds []semantic.Decl) str {
	let lines = twine.Split(text, "\n")
	mut covered = make([]bool, len(lines), len(lines))
	for d in ds {
		let n = twine.Count(d.Text, "\n") + 1
		for k in d.Line - 1..min(d.Line - 1 + n, len(lines)) {
			covered[k] = true
		}
	}
	mut out = []u8{}
	for i, l in lines {
		if covered[i] || len(twine.TrimSpace(l)) == 0 {
			continue
		}
		for k in 0..len(l) {
			out = append(out, l[k])
		}
		out = append(out, '\n')
	}
	return str(out)
}

// ---- against the base ----

fn semanticFiles(inter bool, files []fileIn) []fileOut {
	mut out = []fileOut{}
	for f in files {
		if inter {
			let got = interFile(f, true)
			if got != nil {
				out = append(out, got)
			}
		} else {
			out = append(out, baseFile(f.path, f.oldPath, f.o, f.n))
		}
	}
	return out
}

fn oldName(path str, oldPath str) str {
	if len(oldPath) > 0 {
		return oldPath
	}
	return path
}

// baseFile is one file's semantic diff against the base.
fn baseFile(path str, oldPath str, a str, b str) fileOut {
	mut f = fileOut{path: path, old_path: oldPath, decls: []declOut{}, diff: ""}
	let before = oldName(path, oldPath)
	if (isTin(path) || isTin(before)) && !binary(a) && !binary(b) {
		let (od, okA) = semantic.Decls(a)
		let (nd, okB) = semantic.Decls(b)
		if okA || okB {
			let olds = byKey(od)
			let news = byKey(nd)
			mut cs = []semantic.Change{}
			if before != path {
				cs = semantic.Compare([]str{before, path}, []str{a, ""}, []str{"", b})
			} else {
				cs = semantic.Compare([]str{path}, []str{a}, []str{b})
			}
			for c in cs {
				f.decls = append(f.decls, declOut{change: semantic.KindText(c.Kind), key: c.Key, old_key: c.OldKey, diff: lineDiff(c.OldKey, c.Key, textOf(olds, c.OldKey), textOf(news, c.Key))})
			}
			f.diff = lineDiff(before, path, rest(a, od), rest(b, nd))
			return f
		}
	}
	f.diff = lineDiff(before, path, a, b)
	return f
}

// ---- against the previous version ----

// touched is every path either version changed against its own base, in order.
fn touched(st mut store.Layered, p pair) ![]str {
	mut seen = map[str]bool{}
	mut out = []str{}
	let a = try diff.TreeDiff(mut st, p.oldBase, p.oldTree, false)
	let b = try diff.TreeDiff(mut st, p.newBase, p.newTree, false)
	for fcs in [][]diff.FileChange{a, b} {
		for fc in fcs {
			for path in []str{fc.Path, fc.OldPath} {
				let (_, have) = seen[path]
				if len(path) > 0 && !have {
					seen[path] = true
					out = append(out, path)
				}
			}
		}
	}
	sift.Strs(mut out)
	return out
}

// interFile is one path's interdiff, semantic (declarations in a Tin file) or by lines; nil when the versions differ
// there only by the rebase.
fn interFile(x fileIn, semantic_ bool) ?fileOut {
	if x.o == x.n {
		return nil
	}
	mut f = fileOut{path: x.path, old_path: x.path, decls: []declOut{}, diff: ""}
	if semantic_ && isTin(x.path) && !binary(x.o) && !binary(x.n) {
		let (dob, _) = semantic.Decls(x.ob)
		let (dold, okO) = semantic.Decls(x.o)
		let (dnb, _) = semantic.Decls(x.nb)
		let (dnew, okN) = semantic.Decls(x.n)
		if okO || okN {
			f.decls = interDecls(dob, dold, dnb, dnew)
			f.diff = interText(x.path, rest(x.ob, dob), rest(x.o, dold), rest(x.nb, dnb), rest(x.n, dnew))
			if len(f.decls) == 0 && len(f.diff) == 0 {
				return nil
			}
			return f
		}
	}
	f.diff = interText(x.path, x.ob, x.o, x.nb, x.n)
	if len(f.diff) == 0 {
		return nil
	}
	return f
}

// interText is the line diff from o to n unless it is only the rebase's: neither version edited the text (ob to o,
// nb to n), or both made the same edit.
fn interText(name str, ob str, o str, nb str, n str) str {
	if o == n || (o == ob && n == nb) || samePatch(ob, o, nb, n) {
		return ""
	}
	return lineDiff(name, name, o, n)
}

// interDecls is the declarations whose difference between the versions is the author's.
fn interDecls(dob []semantic.Decl, dold []semantic.Decl, dnb []semantic.Decl, dnew []semantic.Decl) []declOut {
	let mob = byKey(dob)
	let mo = byKey(dold)
	let mnb = byKey(dnb)
	let mn = byKey(dnew)
	mut keys = []str{}
	for d in dnew {
		keys = append(keys, d.Key)
	}
	for d in dold {
		let (_, both) = mn[d.Key]
		if !both {
			keys = append(keys, d.Key)
		}
	}
	mut out = []declOut{}
	for k in keys {
		let to = normOf(mo, k)
		let tn = normOf(mn, k)
		if to == tn || (to == normOf(mob, k) && tn == normOf(mnb, k)) {
			continue
		}
		let xo = textOf(mo, k)
		let xn = textOf(mn, k)
		if samePatch(textOf(mob, k), xo, textOf(mnb, k), xn) {
			continue
		}
		mut how = "changed"
		if to == "\x00" {
			how = "added"
		} else if tn == "\x00" {
			how = "removed"
		}
		out = append(out, declOut{change: how, key: k, old_key: k, diff: lineDiff(k, k, xo, xn)})
	}
	return out
}

// ---- the line diff fallback ----

fn lineFiles(inter bool, files []fileIn) []fileOut {
	mut out = []fileOut{}
	for f in files {
		if inter {
			let got = interFile(f, false)
			if got != nil {
				out = append(out, got)
			}
		} else {
			out = append(out, fileOut{path: f.path, old_path: f.oldPath, decls: []declOut{}, diff: lineDiff(oldName(f.path, f.oldPath), f.path, f.o, f.n)})
		}
	}
	return out
}
