package diffs

import "../events"
import "../packs"
import "../repo"
import "anvil"
import "argo"
import "fault"
import "herald"
import "mint"
import "postgres"
import "quarry"
import "seal"
import "tide"
import "twine"

// Review diffs and overlaps (design/tinhub.md §5 and §6, #1021). For each new change version the review.diff job
// computes two diffs: against its base (the commit's parent) and against the version before it, which shows only what
// the author edited between the two, not what a rebase brought in. Each is a semantic diff (tit/semantic: the
// declarations that changed, each with its own line diff) computed inside within 5s and limit memory 48mb; past
// either budget it is a line diff instead. A result is kept in the diffs table up to bodyMax bytes, and a larger one in
// the pack store. The same job then records the declarations the version touches (from its semantic diff against the
// base) and the other open changes that touch the same ones: its overlaps.

// The job kind and its budget (§6): it reads the files the diffs compare and holds the line diff of a large one; the
// semantic diff inside it has its own budget (semanticWithin, semanticMemory). Overlaps are recorded by the same job
// (design/tinhub.md lists an overlap kind; doing it here reads each text once).
const DiffKind = "review.diff"

const DiffWithin = 30 * tide.Second

const DiffMemory = 512 * 1024 * 1024

const semanticWithin = 5 * tide.Second

const semanticMemory = 48 * 1024 * 1024

// bodyMax is the largest diff kept in its row; a larger one is kept in the pack store.
const bodyMax = 256 * 1024

// Deps is what review diffs need, set on every core (Configure) before the first job or request.
type Deps struct {
	Db    postgres.Client
	Store dyn packs.PackStore
	Cache repo.RefCache
	// Dir is the node's packs.dir: a large diff is written under Dir/tmp on its way to and from the store
	Dir str
	// Auth is the signed-in user of a request, 0 for nobody
	Auth fn(anvil.Req) !i64
}

mut deps ?Deps = nil

// Configure sets this core's dependencies.
fn Configure(d Deps) {
	deps = keep(d)
}

// Handlers configures this core with d and is the review.diff job handler, for the worker.
fn Handlers(d Deps) []events.Handler {
	Configure(d)
	return []events.Handler{events.Handler{Kind: DiffKind, Within: DiffWithin, Memory: DiffMemory, Tasks: 0, MaxAttempts: 5, Run: runDiff}}
}

fn current() !Deps {
	let got = deps
	if got == nil {
		fail "diffs: not configured on this core"
	}
	return got
}

// pgRepo is a repository over this core's dependencies (taking the store from a parameter trips a false E701, #1073).
fn pgRepo(id i64) !repo.PgRepo {
	let d = try current()
	return repo.PgRepo{Db: d.Db, Store: d.Store, Cache: d.Cache, Id: id, Dir: d.Dir, Who: 0}
}

// ---- queueing ----

type changeMove struct {
	change   str
	replaces str
	commit   str
}

type push struct {
	changes []changeMove
}

// jobIn is the job's payload: a change and the commit of its new version.
type jobIn struct {
	change str
	commit str
}

fn isHex(s str) bool {
	if len(s) != 64 {
		return false
	}
	for i in 0..len(s) {
		let c = s[i]
		if !((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')) {
			return false
		}
	}
	return true
}

// EnqueueFor queues the jobs of a push in tx (the push fan-out calls it with the push event's repository and
// payload): a review.diff job for each change version the push added. It returns the jobs queued.
fn EnqueueFor(tx mut postgres.Tx, repoId i64, payload str) !i64 {
	mut p = push{changes: []changeMove{}}
	argo.Get(payload, mut p) catch err {
		fail fault.Wrap(err, "diffs: the push payload")
	}
	mut n = 0
	for c in p.changes {
		if !isHex(c.commit) || len(c.change) == 0 {
			continue
		}
		mut buf = []u8{}
		argo.Put(mut buf, jobIn{change: c.change, commit: c.commit})
		let body = str(buf)
		_ = try events.Enqueue(mut tx, DiffKind, repoId, body)
		n += 1
	}
	return n
}

fn parseJob(payload str) !jobIn {
	mut j = jobIn{change: "", commit: ""}
	argo.Get(payload, mut j) catch err {
		fail fault.Wrap(err, "diffs: the job payload")
	}
	return j
}

// Version is a change version: its number, its commit and the commit of the version before it ("" for the first).
type Version struct {
	Change   str
	Number   i64
	Commit   str
	Previous str
}

// ErrNoVersion is the fault of a change version the repository does not have.
let ErrNoVersion = fault("no such change version")

// VersionOf is the version of a change whose commit is commit (the newest such, when a version was pushed again).
fn VersionOf(c postgres.Client, repoId i64, ch str, commit str) !Version {
	let rows = try c.Query("SELECT version FROM changes WHERE repo_id = {repoId} AND change_id = {ch} AND commit_id = {commit} ORDER BY version DESC LIMIT 1")
	if len(rows.Rows) == 0 {
		fail fault.Wrap(ErrNoVersion, "{ch} has no version at {commit}")
	}
	return try versionAt(c, repoId, ch, rows.Rows[0][0].Int())
}

// versionAt is a change's version n, or its newest when n is 0.
fn versionAt(c postgres.Client, repoId i64, ch str, n i64) !Version {
	let rows = try c.Query("SELECT version, commit_id FROM changes WHERE repo_id = {repoId} AND change_id = {ch} AND ({n} = 0 OR version <= {n}) ORDER BY version DESC LIMIT 2")
	if len(rows.Rows) == 0 || (n > 0 && rows.Rows[0][0].Int() != n) {
		fail fault.Wrap(ErrNoVersion, "{ch} has no version {n}")
	}
	mut prev = ""
	if len(rows.Rows) > 1 {
		prev = rows.Rows[1][1].Text()
	}
	return Version{Change: ch, Number: rows.Rows[0][0].Int(), Commit: rows.Rows[0][1].Text(), Previous: prev}
}

// ---- the diff job ----

fn runDiff(j events.Job) ! {
	let job = try parseJob(j.Payload)
	let d = try current()
	let v = try VersionOf(d.Db, j.RepoId, job.change, job.commit)
	try DiffVersion(j.RepoId, v)
}

// DiffVersion computes and keeps a version's diffs, against its base and against the version before it, and records
// its overlaps.
fn DiffVersion(repoId i64, v Version) ! {
	let started = tide.Now()
	let (base, files) = try Compute(repoId, v, "base")
	try save(repoId, base)
	mut kinds = []str{"base", base.kind}
	if len(v.Previous) > 0 {
		let (prev, _) = try Compute(repoId, v, "previous")
		try save(repoId, prev)
		kinds = append(kinds, "previous", prev.kind)
	}
	let decls = try declsFrom(base, files)
	let others = try Overlap(repoId, v, decls)
	herald.Log(herald.LInfo, "review diffs", []str{"repo", mint.Itoa(repoId), "change", v.Change, "version", mint.Itoa(v.Number), "kinds", twine.Join(kinds, " "), "decls", mint.Itoa(len(decls)), "overlaps", mint.Itoa(others), "ms", mint.Itoa((tide.Now() - started) / tide.Millisecond)})
}

// DiffKey is where the pack store keeps a diff too large for its row (§7).
fn DiffKey(repoId i64, ch str, version i64, against str) str {
	return "repos/{repoId}/diffs/{ch}/{version}.{against}"
}

// save keeps a diff: in its row when it is at most bodyMax bytes, else in the pack store (stored).
fn save(repoId i64, out DiffOut) ! {
	let d = try current()
	mut buf = []u8{}
	argo.Put(mut buf, out)
	mut body = str(buf)
	mut stored = false
	if len(body) > bodyMax {
		let key = DiffKey(repoId, out.change, out.version, out.against)
		let tmp = d.Dir + "/tmp/diff-" + seal.Hex(seal.RandomBytes(8))
		try quarry.MkdirAll(d.Dir + "/tmp")
		try quarry.WriteFile(tmp, body)
		mut r = try pgRepo(repoId)
		let (_, err) = r.Store.Put(key, tmp)
		quarry.Remove(tmp) catch _ {
		}
		if err != nil {
			fail err
		}
		body = ""
		stored = true
	}
	let ch = out.change
	let version = out.version
	let against = out.against
	let kind = out.kind
	_ = try d.Db.Exec("INSERT INTO diffs (repo_id, change_id, version, against, kind, body, stored) VALUES ({repoId}, {ch}, {version}, {against}, {kind}, {body}, {stored}) ON CONFLICT (repo_id, change_id, version, against) DO UPDATE SET kind = EXCLUDED.kind, body = EXCLUDED.body, stored = EXCLUDED.stored, created_at = now()")
}

// Stored is a kept diff's JSON: from its row, or from the pack store; ok is false when it is not computed yet.
fn Stored(repoId i64, ch str, version i64, against str) !(str, bool) {
	let d = try current()
	let rows = try d.Db.Query("SELECT body, stored::int FROM diffs WHERE repo_id = {repoId} AND change_id = {ch} AND version = {version} AND against = {against}")
	if len(rows.Rows) == 0 {
		return "", false
	}
	if rows.Rows[0][1].Int() == 0 {
		return rows.Rows[0][0].Text(), true
	}
	let tmp = d.Dir + "/tmp/diff-" + seal.Hex(seal.RandomBytes(8))
	try quarry.MkdirAll(d.Dir + "/tmp")
	mut r = try pgRepo(repoId)
	let (_, err) = r.Store.Get(DiffKey(repoId, ch, version, against), tmp)
	if err != nil {
		quarry.Remove(tmp) catch _ {
		}
		fail err
	}
	let (body, rerr) = quarry.ReadFile(tmp)
	quarry.Remove(tmp) catch _ {
	}
	if rerr != nil {
		fail rerr
	}
	return body, true
}
