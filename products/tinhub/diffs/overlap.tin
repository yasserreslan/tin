package diffs

import "../../tit/semantic"
import "fault"
import "herald"
import "postgres"
import "sift"
import "twine"

// Overlaps (#1021): the declarations an open change touches, as tit overlap names them ("<package dir>: <key>", the
// key before a rename or move too), are its rows in change_decls (its newest version only). On each new version the
// review.diff job replaces them and records, both ways, which other open changes touch the same declarations. An open
// change is one with no landed or abandoned review.

// fileMemory is the most one file's declarations may take; a larger file (a generated table) is left out of overlaps.
const fileMemory = 8 * 1024 * 1024

fn trailDir(path str) str {
	let slash = twine.LastIndex(path, "/")
	if slash < 0 {
		return ""
	}
	return path[0:slash]
}

// fileDecls is the declarations one changed file touches.
fn fileDecls(f fileIn) []str {
	let before = oldName(f.path, f.oldPath)
	mut cs = []semantic.Change{}
	if before != f.path {
		cs = semantic.Compare([]str{before, f.path}, []str{f.o, ""}, []str{"", f.n})
	} else {
		cs = semantic.Compare([]str{f.path}, []str{f.o}, []str{f.n})
	}
	mut out = []str{}
	for c in cs {
		out = append(out, trailDir(c.Path) + ": " + c.Key)
		if len(c.OldPath) > 0 && c.OldKey != c.Key {
			out = append(out, trailDir(c.OldPath) + ": " + c.OldKey)
		}
	}
	return out
}

// fileDeclsWithin is fileDecls inside the semantic diff's budget.
fn fileDeclsWithin(f fileIn) ![]str {
	mut out = []str{}
	try within semanticWithin + 0 {
		try limit memory semanticMemory + 0 {
			let got = fileDecls(f)
			out = keep(got)
		}
	}
	return out
}

// declsFrom is the declarations a version touches against its base, sorted: from its semantic diff, or, when that is a
// line diff, file by file inside the semantic budget, leaving out a file too large for it (a generated table).
fn declsFrom(base DiffOut, files []fileIn) ![]str {
	mut all = []str{}
	if base.kind == "semantic" {
		for f in base.files {
			for x in f.decls {
				all = append(all, trailDir(f.path) + ": " + x.key)
				if len(x.old_key) > 0 && x.old_key != x.key {
					all = append(all, trailDir(oldName(f.path, f.old_path)) + ": " + x.old_key)
				}
			}
		}
	} else {
		for f in files {
			if !isTin(f.path) && !isTin(f.oldPath) {
				continue
			}
			if len(f.o) + len(f.n) > semanticMemory {
				herald.Log(herald.LInfo, "overlap: a file too large for its declarations", []str{"path", f.path})
				continue
			}
			let (ds, err) = fileDeclsWithin(f)
			if err != nil {
				if fault.Is(err, fault.LimitExceeded) || fault.Is(err, fault.DeadlineExceeded) {
					herald.Log(herald.LInfo, "overlap: a file too large for its declarations", []str{"path", f.path})
					continue
				}
				fail err
			}
			for k in ds {
				all = append(all, k)
			}
		}
	}
	mut seen = map[str]bool{}
	mut out = []str{}
	for k in all {
		let (_, have) = seen[k]
		if !have {
			seen[k] = true
			out = append(out, k)
		}
	}
	sift.Strs(mut out)
	return out
}

// Overlap records the declarations a version touches and the open changes that share them; it returns the other
// changes found. A version that is not its change's newest any more is left alone (the newer one's job does it).
fn Overlap(repoId i64, v Version, decls []str) !i64 {
	let d = try current()
	mut tx = try d.Db.Begin()
	let (n, err) = overlapIn(mut tx, repoId, v, decls)
	if err != nil {
		tx.Rollback() catch _ {
		}
		fail err
	}
	try tx.Commit()
	return n
}

fn overlapIn(tx mut postgres.Tx, repoId i64, v Version, decls []str) !i64 {
	// one writer per repository, apart from the push lock and the index's
	_ = try tx.Query("SELECT pg_advisory_xact_lock(1021, ({repoId} % 2147483647)::int)")
	let ch = v.Change
	let version = v.Number
	let newest = try tx.Query("SELECT max(version) FROM changes WHERE repo_id = {repoId} AND change_id = {ch}")
	if newest.Rows[0][0].Int() != version {
		return 0
	}
	_ = try tx.Exec("DELETE FROM change_decls WHERE repo_id = {repoId} AND change_id = {ch}")
	_ = try tx.Exec("DELETE FROM change_overlaps WHERE repo_id = {repoId} AND (change_id = {ch} OR other_change_id = {ch})")
	let closed = try tx.Query("SELECT count(*) FROM reviews WHERE repo_id = {repoId} AND change_id = {ch} AND state IN ('landed', 'abandoned')")
	if closed.Rows[0][0].Int() > 0 || len(decls) == 0 {
		return 0
	}
	let list = twine.Join(decls, "\n")
	_ = try tx.Exec("INSERT INTO change_decls (repo_id, change_id, version, decl) SELECT {repoId}, {ch}, {version}, x FROM unnest(string_to_array({list}, chr(10))) AS x ON CONFLICT DO NOTHING")
	// the other open changes' rows on the same declarations, recorded both ways
	_ = try tx.Exec("INSERT INTO change_overlaps (repo_id, change_id, version, other_change_id, decl) SELECT {repoId}, {ch}, {version}, o.change_id, o.decl FROM change_decls o WHERE o.repo_id = {repoId} AND o.change_id <> {ch} AND o.decl = ANY(string_to_array({list}, chr(10))) AND NOT EXISTS (SELECT 1 FROM reviews rv WHERE rv.repo_id = {repoId} AND rv.change_id = o.change_id AND rv.state IN ('landed', 'abandoned')) ON CONFLICT DO NOTHING")
	_ = try tx.Exec("INSERT INTO change_overlaps (repo_id, change_id, version, other_change_id, decl) SELECT {repoId}, o.change_id, o.version, {ch}, o.decl FROM change_decls o WHERE o.repo_id = {repoId} AND o.change_id <> {ch} AND o.decl = ANY(string_to_array({list}, chr(10))) AND NOT EXISTS (SELECT 1 FROM reviews rv WHERE rv.repo_id = {repoId} AND rv.change_id = o.change_id AND rv.state IN ('landed', 'abandoned')) ON CONFLICT DO NOTHING")
	let n = try tx.Query("SELECT count(DISTINCT other_change_id) FROM change_overlaps WHERE repo_id = {repoId} AND change_id = {ch} AND version = {version}")
	return n.Rows[0][0].Int()
}

// overlapOut is a change's overlaps: for its newest version, each other open change and the declarations both touch.
type overlapOut struct {
	change   str
	version  i64
	overlaps []otherOut
}

type otherOut struct {
	change str
	decls  []str
}

// Overlaps reads a change's overlaps.
fn Overlaps(c postgres.Client, repoId i64, ch str) !overlapOut {
	let v = try versionAt(c, repoId, ch, 0)
	let version = v.Number
	let rows = try c.Query("SELECT other_change_id, decl FROM change_overlaps WHERE repo_id = {repoId} AND change_id = {ch} AND version = {version} AND NOT EXISTS (SELECT 1 FROM reviews rv WHERE rv.repo_id = {repoId} AND rv.change_id = other_change_id AND rv.state IN ('landed', 'abandoned')) ORDER BY other_change_id, decl")
	mut out = overlapOut{change: ch, version: version, overlaps: []otherOut{}}
	for row in rows.Rows {
		let other = row[0].Text()
		if len(out.overlaps) == 0 || out.overlaps[len(out.overlaps) - 1].change != other {
			out.overlaps = append(out.overlaps, otherOut{change: other, decls: []str{}})
		}
		let last = len(out.overlaps) - 1
		out.overlaps[last].decls = append(out.overlaps[last].decls, row[1].Text())
	}
	return out
}
