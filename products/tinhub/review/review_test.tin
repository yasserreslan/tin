// Tests for reviews (#1025) against Postgres (TINHUB_TEST_DB): versions pushed through PgRepo as tit's server commits
// them, the push fan-out's EnqueueFor and the review.version jobs run by the event queue's runner, and every route
// through the router: a comment on fn Lstat kept through three rebases and a reformat (outdated by a rename), a stack
// of three landed bottom-up with one move of main per change, a landing refused on a conflict, and checks signed
// with a tit key and required before landing.

fn testDb(t mut crucible.T) ?postgres.Client {
	let (o, ok) = db.TestOptions()
	if !ok {
		t.Log("TINHUB_TEST_DB is not set: skipped")
		return nil
	}
	let c = db.Open(o)
	db.ResetForTests(c) catch err {
		t.Error("reset: {err}")
		return nil
	}
	_ = db.Migrate(c) catch err {
		t.Error("migrate: {err}")
		return nil
	}
	return c
}

// testAuth is the caller in tests: the user id in X-Test-User, 0 for none.
fn testAuth(q anvil.Req) !i64 {
	let h = q.Header("x-test-user")
	if len(h) == 0 {
		return 0
	}
	return try mint.Atoi(h)
}

const nonceKey = "test-nonce-key-0123456789"

// world is a repository ada/tin (private) with its people: ada owns it, bob writes, carol reads, ci writes and posts
// checks with a key.
type world struct {
	c     postgres.Client
	r     repo.PgRepo
	s     store.Mem
	repo  accounts.Repo
	ada   i64
	bob   i64
	carol i64
	ci    i64
	seed  []u8
	rt    anvil.Router
}

fn newUser(c postgres.Client, name str) !i64 {
	let o = try c.Query("INSERT INTO owners (name, kind) VALUES ({name}, 'user') RETURNING id")
	let ownerId = o.Rows[0][0].Int()
	let email = name + "@example.com"
	let u = try c.Query("INSERT INTO users (owner_id, email) VALUES ({ownerId}, {email}) RETURNING id")
	return u.Rows[0][0].Int()
}

fn grant(c postgres.Client, repoId i64, user i64, role str) ! {
	_ = try c.Exec("INSERT INTO grants (repo_id, user_id, role) VALUES ({repoId}, {user}, {role})")
}

fn newWorld(c postgres.Client) !world {
	let ada = try newUser(c, "ada")
	let bob = try newUser(c, "bob")
	let carol = try newUser(c, "carol")
	let ci = try newUser(c, "ci")
	let rows = try c.Query("INSERT INTO repos (owner_id, name, visibility, quota_bytes) SELECT owner_id, 'tin', 'private', 10000000000 FROM users WHERE id = {ada} RETURNING id")
	let repoId = rows.Rows[0][0].Int()
	try grant(c, repoId, bob, "write")
	try grant(c, repoId, carol, "read")
	try grant(c, repoId, ci, "write")
	let seed = seal.RandomBytes(32)
	let pub = try seal.Ed25519PublicKey(seed)
	_ = try accounts.AddKey(c, accounts.System(), ci, pub, "ci")
	let dir = "/tmp/tin-test-tinhub-review-" + seal.Hex(seal.RandomBytes(4))
	let s = try packs.NewDirStore(dir + "/store")
	let st dyn packs.PackStore = s
	Configure(Deps{Db: c, Store: st, Cache: repo.NoCache(), Dir: dir, NonceKey: nonceKey, Auth: testAuth})
	let found = try accounts.RepoById(c, repoId)
	if found == nil {
		fail "no repository"
	}
	mut rt = anvil.NewRouter()
	Mount(mut rt)
	return world{c: c, r: repo.PgRepo{Db: c, Store: s, Cache: repo.NoCache(), Id: repoId, Dir: dir, Who: ada}, s: store.NewMem(), repo: found, ada: ada, bob: bob, carol: carol, ci: ci, seed: seed, rt: rt}
}

fn person(when i64) object.Person {
	return object.Person{Name: "Ada", Email: "ada@example.com", When: when, Zone: 0}
}

// treeOfFiles writes the tree of files (path to text) into s, adding every id it writes to ids.
fn treeOfFiles(s mut store.Mem, files map[str]str, prefix str, ids mut []object.Id) !object.Id {
	mut keys = []str{}
	mut subdirs = map[str]bool{}
	for path, _ in files {
		if !twine.HasPrefix(path, prefix) {
			continue
		}
		let rest = path[len(prefix):]
		let slash = twine.IndexByte(rest, '/')
		if slash < 0 {
			keys = append(keys, rest)
		} else {
			let (_, seen) = subdirs[rest[0:slash]]
			if !seen {
				subdirs[rest[0:slash]] = true
				keys = append(keys, rest[0:slash] + "/")
			}
		}
	}
	sift.Strs(mut keys)
	mut entries = []object.Entry{}
	for k in keys {
		if twine.HasSuffix(k, "/") {
			let sub = try treeOfFiles(mut s, files, prefix + k, mut ids)
			entries = append(entries, object.Entry{Mode: object.Mode.Dir, Name: k[0:len(k) - 1], Id: sub})
		} else {
			let (body, _) = files[prefix + k]
			let blob = try s.PutRaw(object.Kind.Blob, body)
			ids = append(ids, blob)
			entries = append(entries, object.Entry{Mode: object.Mode.File, Name: k, Id: blob})
		}
	}
	let tree = try s.Put(object.Object.Tree(entries))
	ids = append(ids, tree)
	return tree
}

fn makeCommit(s mut store.Mem, files map[str]str, parents []object.Id, cid object.ChangeId, message str, when i64, ids mut []object.Id) !object.Id {
	let tree = try treeOfFiles(mut s, files, "", mut ids)
	let cd = object.CommitData{Tree: tree, Parents: parents, Change: cid, Author: person(when), Committer: person(when), GitHeaders: []str{}, Signature: "", Message: message, Conflicts: []str{}}
	let id = try s.Put(object.Object.Commit(cd))
	ids = append(ids, id)
	return id
}

// pushOf pushes ids' objects with the ref and change moves, as tit's server commits a push, then runs what the push
// fan-out does for reviews (EnqueueFor in a transaction) and the review.version jobs it queued.
fn pushOf(w mut world, ids []object.Id, refs []transport.RefUpdate, changes []transport.ChangeUpdate) ! {
	let p = try packfile.Write(mut w.s, ids, w.r.TempDir())
	let st = try w.r.Stage(p.Path)
	_ = try w.r.Commit(transport.Update{Who: "ada@example.com", Command: "push", Changes: changes, Refs: refs, Pack: st.Name, Time: 1700000000000000000})
	try fanOut(w.c, w.r.Id)
	_ = try work(w.c)
}

fn fanOut(c postgres.Client, repoId i64) ! {
	let rows = try c.Query("SELECT payload::text FROM events WHERE repo_id = {repoId} AND kind = 'push' ORDER BY id DESC LIMIT 1")
	mut tx = try c.Begin()
	_ = try EnqueueFor(mut tx, repoId, rows.Rows[0][0].Text())
	try tx.Commit()
}

// work runs every ready review.version job through the event queue's runner.
fn work(c postgres.Client) !i64 {
	let d = try current()
	let runner_ = events.Runner{Db: c, Handlers: Handlers(d), Lease: 300 * 1000000000, Poll: 0}
	mut n = 0
	for {
		let ran = try runner_.Step("test/1/0")
		if !ran {
			break
		}
		n += 1
	}
	let left = try c.Query("SELECT count(*), coalesce(max(last_error), '') FROM events WHERE kind = 'review.version' AND state <> 'done'")
	if left.Rows[0][0].Int() > 0 {
		fail "a job did not finish: " + left.Rows[0][1].Text()
	}
	return n
}

// version pushes a version of a change: a commit of files on parent, replacing the change's commit replaces.
fn version(w mut world, files map[str]str, parent object.Id, cid object.ChangeId, replaces str, message str, when i64) !object.Id {
	mut ids = []object.Id{}
	let id = try makeCommit(mut w.s, files, []object.Id{parent}, cid, message, when, mut ids)
	try pushOf(mut w, ids, []transport.RefUpdate{}, []transport.ChangeUpdate{transport.ChangeUpdate{Change: cid.Letters(), Replaces: replaces, Commit: id.Hex()}})
	return id
}

// trunk pushes a commit of files to refs/heads/main.
fn trunk(w mut world, files map[str]str, parent object.Id, when i64) !object.Id {
	mut ids = []object.Id{}
	mut parents = []object.Id{}
	mut old = ""
	if parent != object.NoId {
		parents = append(parents, parent)
		old = parent.Hex()
	}
	let id = try makeCommit(mut w.s, files, parents, object.NewChangeId(), "trunk\n", when, mut ids)
	try pushOf(mut w, ids, []transport.RefUpdate{transport.RefUpdate{Name: "refs/heads/main", Old: old, New: id.Hex()}}, []transport.ChangeUpdate{})
	return id
}

// call sends a request as user (0: nobody) to the review routes.
fn (w world) call(user i64, method str, path str, body str) anvil.Out {
	mut hs = []str{}
	if user > 0 {
		hs = append(hs, "X-Test-User: {user}")
	}
	return w.rt.RunWith(method, path, hs, body)
}

// signed sends a request signed with ci's key (as tit signs a request), taking a nonce first.
fn (w world) signed(email str, seed []u8, method str, path str, body str) !anvil.Out {
	let nonce = Nonce(nonceKey, now())
	let sig = try seal.SignEd25519(seed, []u8(transport.SigningPayload(method, path, nonce, body)))
	let h = "Tit-Signature: " + transport.SignatureHeader(email, nonce, sig)
	return w.rt.RunWith(method, path, []str{h}, body)
}

fn (w world) base() str {
	return "/api/v1/repos/ada/tin/changes/"
}

// ---- the files ----

const osHead = "package os\n\n"

fn osStat(k str) str {
	return "// Stat stats.\nfn Stat(p str) i64 {{\n\treturn " + k + "\n}}\n\n"
}

const osExtra = "// Extra is upstream's.\nfn Extra() i64 {{\n\treturn 7\n}}\n\n"

const lstatBase = "// Lstat stats a link.\nfn Lstat(p str) i64 {{\n\tlet n = len(p)\n\tif n == 0 {{\n\t\treturn 0\n\t}}\n\treturn n + 1\n}}\n"

const lstatEdit = "// Lstat stats a link.\nfn Lstat(p str) i64 {{\n\tlet n = len(p)\n\tif n == 0 {{\n\t\treturn 0\n\t}}\n\treturn n + 2\n}}\n"

// lstatFormatted is lstatEdit reformatted: spaces for tabs and a blank line at the top of the body.
const lstatFormatted = "// Lstat stats a link.\nfn Lstat(p str) i64 {{\n\n    let n = len(p)\n    if n == 0 {{\n        return 0\n    }}\n    return n + 2\n}}\n"

const lstatRenamed = "// LstatFile stats a link.\nfn LstatFile(p str) i64 {{\n\n    let n = len(p)\n    if n == 0 {{\n        return 0\n    }}\n    return n + 2\n}}\n"

// lineOf is line n (from 1) of text.
fn lineOf(text str, n i64) str {
	let ls = twine.Split(text, "\n")
	if n < 1 || n > len(ls) {
		return ""
	}
	return ls[n - 1]
}

fn commentsOf(w world, ch str) !commentsOut {
	let out = w.call(w.bob, "GET", w.base() + ch + "/comments", "")
	if out.Code() != 200 {
		fail "GET comments: {out.Code()} {str(out.Body)}"
	}
	mut got = commentsOut{comments: []commentOut{}}
	try argo.Get(str(out.Body), mut got)
	return got
}

// ---- the comment on fn Lstat ----

// TestCommentFollowsLstat: a comment on a line of fn Lstat stays on that line through three rebases onto a main that
// moved (lines added above it, another function edited, a file added) and a reformat of the function, and is outdated
// once fn Lstat is renamed.
fn TestCommentFollowsLstat(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	mut w = newWorld(got) catch err {
		t.Error("world: {err}")
		return
	}
	let cid = object.NewChangeId()
	let ch = cid.Letters()
	let m0 = trunk(mut w, map[str]str{"os/os.tin": osHead + osStat("1") + lstatBase}, object.NoId, 1700000000) catch err {
		t.Error("m0: {err}")
		return
	}
	let v1Text = osHead + osStat("1") + lstatEdit
	let v1 = version(mut w, map[str]str{"os/os.tin": v1Text}, m0, cid, "", "os: Lstat counts one more\n", 1700000010) catch err {
		t.Error("v1: {err}")
		return
	}
	let rv = ReviewOf(w.c, w.r.Id, ch) catch err {
		t.Error("review: {err}")
		return
	}
	t.True("the first push opened the review on main", rv != nil && rv.State == StateOpen && rv.Target == "refs/heads/main" && rv.OpenedBy == w.ada)
	// a comment on fn Lstat's "let n = len(p)" (two lines below its doc comment)
	let bad = w.call(w.bob, "POST", w.base() + ch + "/comments", "{{\"body\":\"why n?\",\"file\":\"os/os.tin\",\"decl\":\"fn Nope\",\"line_offset\":2}}")
	crucible.Equal(mut t, "a declaration the file lacks is refused", bad.Code(), 422)
	let past = w.call(w.bob, "POST", w.base() + ch + "/comments", "{{\"body\":\"why n?\",\"file\":\"os/os.tin\",\"decl\":\"fn Lstat\",\"line_offset\":40}}")
	crucible.Equal(mut t, "an offset past the declaration is refused", past.Code(), 422)
	let anon = w.call(0, "POST", w.base() + ch + "/comments", "{{\"body\":\"hi\"}}")
	crucible.Equal(mut t, "a private repository is 404 to nobody", anon.Code(), 404)
	let made = w.call(w.bob, "POST", w.base() + ch + "/comments", "{{\"body\":\"why n?\",\"file\":\"os/os.tin\",\"decl\":\"fn Lstat\",\"line_offset\":2}}")
	crucible.Equal(mut t, "a comment on fn Lstat: {str(made.Body)}", made.Code(), 201)
	let general = w.call(w.carol, "POST", w.base() + ch + "/comments", "{{\"body\":\"looks fine\"}}")
	crucible.Equal(mut t, "a reader comments on the change", general.Code(), 201)
	_ = AddComment(w.r.Id, ch, 0, NewComment{Version: 0, File: "", Decl: "", Offset: 0, Parent: 0, Body: "bench: no change"}) catch err {
		t.Error("a system comment: {err}")
		0
	}
	let first = commentsOf(w, ch) catch err {
		t.Error("comments: {err}")
		return
	}
	t.True("anchored at version 1, on its line: {first.comments}", len(first.comments) == 3 && first.comments[0].version == 1 && twine.TrimSpace(lineOf(v1Text, first.comments[0].line)) == "let n = len(p)")
	t.True("a system comment has no author", first.comments[2].author == 0 && first.comments[2].body == "bench: no change")
	// three rebases: main moves under the change each time, never touching fn Lstat
	let m1Files = osHead + osStat("1") + osExtra + lstatBase
	let m2Files = osHead + osStat("2") + osExtra + lstatBase
	let m1 = trunk(mut w, map[str]str{"os/os.tin": m1Files}, m0, 1700000020) catch err {
		t.Error("m1: {err}")
		return
	}
	let v2Text = osHead + osStat("1") + osExtra + lstatEdit
	let v2 = version(mut w, map[str]str{"os/os.tin": v2Text}, m1, cid, v1.Hex(), "os: Lstat counts one more\n", 1700000030) catch err {
		t.Error("v2: {err}")
		return
	}
	let m2 = trunk(mut w, map[str]str{"os/os.tin": m2Files}, m1, 1700000040) catch err {
		t.Error("m2: {err}")
		return
	}
	let v3Text = osHead + osStat("2") + osExtra + lstatEdit
	let v3 = version(mut w, map[str]str{"os/os.tin": v3Text}, m2, cid, v2.Hex(), "os: Lstat counts one more\n", 1700000050) catch err {
		t.Error("v3: {err}")
		return
	}
	let m3 = trunk(mut w, map[str]str{"os/os.tin": m2Files, "os/b.tin": "package os\n\nfn B() i64 {{\n\treturn 0\n}}\n"}, m2, 1700000060) catch err {
		t.Error("m3: {err}")
		return
	}
	let v4 = version(mut w, map[str]str{"os/os.tin": v3Text, "os/b.tin": "package os\n\nfn B() i64 {{\n\treturn 0\n}}\n"}, m3, cid, v3.Hex(), "os: Lstat counts one more\n", 1700000070) catch err {
		t.Error("v4: {err}")
		return
	}
	let after = commentsOf(w, ch) catch err {
		t.Error("comments: {err}")
		return
	}
	let c4 = after.comments[0]
	t.True("after three rebases it is on fn Lstat at version 4, on its line: {c4}", c4.version == 4 && c4.written_on == 1 && c4.decl == "fn Lstat" && c4.file == "os/os.tin" && !c4.outdated && c4.line_offset == 2 && twine.TrimSpace(lineOf(v3Text, c4.line)) == "let n = len(p)" && c4.line != first.comments[0].line)
	t.True("the change's other comments moved too", after.comments[1].version == 4 && after.comments[2].version == 4)
	// a reformat: spaces for tabs, a blank line added at the top of the body
	let v5Text = osHead + osStat("2") + osExtra + lstatFormatted
	let v5 = version(mut w, map[str]str{"os/os.tin": v5Text, "os/b.tin": "package os\n\nfn B() i64 {{\n\treturn 0\n}}\n"}, m3, cid, v4.Hex(), "os: Lstat counts one more\n", 1700000080) catch err {
		t.Error("v5: {err}")
		return
	}
	let fmtd = commentsOf(w, ch) catch err {
		t.Error("comments: {err}")
		return
	}
	let c5 = fmtd.comments[0]
	t.True("after the reformat it is still on its line, one further down: {c5}", c5.version == 5 && !c5.outdated && c5.line_offset == 3 && lineOf(v5Text, c5.line) == "    let n = len(p)")
	// a rename: the comment is outdated, and stays on version 5
	_ = version(mut w, map[str]str{"os/os.tin": osHead + osStat("2") + osExtra + lstatRenamed, "os/b.tin": "package os\n\nfn B() i64 {{\n\treturn 0\n}}\n"}, m3, cid, v5.Hex(), "os: LstatFile\n", 1700000090) catch err {
		t.Error("v6: {err}")
		return
	}
	let renamed = commentsOf(w, ch) catch err {
		t.Error("comments: {err}")
		return
	}
	let c6 = renamed.comments[0]
	t.True("renamed: outdated on version 5: {c6}", c6.outdated && c6.version == 5 && c6.line == 0)
	t.True("the change's comment follows to version 6", renamed.comments[1].version == 6 && !renamed.comments[1].outdated)
	// a reply takes its parent's anchor; a resolve takes the author or a writer
	let reply = w.call(w.ada, "POST", w.base() + ch + "/comments", "{{\"body\":\"so it counts\",\"parent\":{c6.id}}}")
	crucible.Equal(mut t, "a reply", reply.Code(), 201)
	let byCarol = w.call(w.carol, "PATCH", w.base() + ch + "/comments/{c6.id}", "{{\"resolved\":true}}")
	crucible.Equal(mut t, "a reader cannot resolve another's comment", byCarol.Code(), 403)
	let byBob = w.call(w.bob, "PATCH", w.base() + ch + "/comments/{c6.id}", "{{\"resolved\":true}}")
	crucible.Equal(mut t, "its author resolves it", byBob.Code(), 204)
	let last = commentsOf(w, ch) catch err {
		t.Error("comments: {err}")
		return
	}
	t.True("resolved, and the reply on the same declaration", last.comments[0].resolved && len(last.comments) == 4 && last.comments[3].decl == "fn Lstat" && last.comments[3].parent == c6.id)
	let events_ = w.c.Query("SELECT count(*) FROM events WHERE kind = 'review.comment' AND state = 'done'") catch err {
		t.Error("events: {err}")
		return
	}
	crucible.Equal(mut t, "each comment is a live event", events_.Rows[0][0].Int(), 4)
}

// TestMoved: a declaration moved to another file of its package keeps its comments; one moved out of it does not.
fn TestMoved(t mut crucible.T) {
	mut s = store.NewMem()
	mut ids = []object.Id{}
	let a = treeOfFiles(mut s, map[str]str{"os/os.tin": osHead + lstatBase}, "", mut ids) catch err {
		t.Error("a: {err}")
		return
	}
	let b = treeOfFiles(mut s, map[str]str{"os/os.tin": osHead, "os/link.tin": osHead + osStat("1") + lstatFormatted}, "", mut ids) catch err {
		t.Error("b: {err}")
		return
	}
	let c = treeOfFiles(mut s, map[str]str{"os/os.tin": osHead, "fs/link.tin": "package fs\n\n" + lstatBase}, "", mut ids) catch err {
		t.Error("c: {err}")
		return
	}
	let first dyn store.ObjectStore = s
	mut st = store.NewLayered([]dyn store.ObjectStore{first})
	let (to, ok) = Moved(mut st, a, b, Anchor{File: "os/os.tin", Decl: "fn Lstat", Offset: 2}) catch err {
		t.Error("moved: {err}")
		return
	}
	t.True("moved in its package: {to.File} {to.Offset}", ok && to.File == "os/link.tin" && to.Offset == 3)
	let (_, gone) = Moved(mut st, a, c, Anchor{File: "os/os.tin", Decl: "fn Lstat", Offset: 2}) catch err {
		t.Error("moved: {err}")
		return
	}
	t.False("moved to another package: outdated", gone)
}

// TestCarryLine: lines carried through edits, a reformat and removals.
fn TestCarryLine(t mut crucible.T) {
	crucible.Equal(mut t, "the same text", CarryLine("a\nb\nc", "a\nb\nc", 1), 1)
	crucible.Equal(mut t, "a line added above", CarryLine("a\nb\nc", "x\na\nb\nc", 1), 2)
	crucible.Equal(mut t, "whitespace only", CarryLine("a\n\tb  c\nd", "a\n    b c\nd", 1), 1)
	crucible.Equal(mut t, "the line removed: where it was", CarryLine("a\nb\nc", "a\nc", 1), 1)
	crucible.Equal(mut t, "past the end: the last line", CarryLine("a\nb\nc", "a", 2), 0)
}

// The landing's merge (rebase.tin, tit's merge without renames): lines both sides kept, a stretch only one side
// changed, and two declarations on neighbouring lines, one changed on each side, which a line merge cannot combine.
fn TestRebaseMerge(t mut crucible.T) {
	let (m, ok) = mergeText("a\nb\nc\n", "a\nB\nc\n", "a\nb\nc\nd\n")
	crucible.Equal(mut t, "lines merge", ok, true)
	crucible.Equal(mut t, "both changes", m, "a\nB\nc\nd\n")
	let (_, clash) = mergeText("a\nb\nc\n", "a\nX\nc\n", "a\nY\nc\n")
	crucible.Equal(mut t, "the same line changed two ways does not merge", clash, false)
	let base = "package p\n\nfn A() i64 {{ return 1 }}\nfn B() i64 {{ return 1 }}\n"
	let ours = "package p\n\nfn A() i64 {{ return 2 }}\nfn B() i64 {{ return 1 }}\n"
	let theirs = "package p\n\nfn A() i64 {{ return 1 }}\nfn B() i64 {{ return 3 }}\n"
	let (_, lineOk) = mergeText(base, ours, theirs)
	crucible.Equal(mut t, "neighbouring lines do not merge by lines", lineOk, false)
	let (d, dok) = mergeTin(base, ours, theirs)
	crucible.Equal(mut t, "they merge by declaration", dok, true)
	crucible.Equal(mut t, "each declaration from the side that changed it", d, "package p\n\nfn A() i64 {{ return 2 }}\nfn B() i64 {{ return 3 }}\n")
}

// ---- landing ----

type landBody struct {
	landed  []landedOut
	code    str
	message str
}

fn landOf(out anvil.Out) landBody {
	mut b = landBody{landed: []landedOut{}, code: "", message: ""}
	argo.Get(str(out.Body), mut b) catch _ {
	}
	return b
}

fn mainOf(c postgres.Client, repoId i64) str {
	let rows = c.Query("SELECT target FROM refs WHERE repo_id = {repoId} AND name = 'refs/heads/main'") catch _ {
		return ""
	}
	if len(rows.Rows) == 0 {
		return ""
	}
	return rows.Rows[0][0].Text()
}

// mainMoves is every move of main the push events record: "old new", oldest first.
fn mainMoves(c postgres.Client, repoId i64) ![]str {
	let rows = try c.Query("SELECT r->>'old', r->>'new' FROM events e, jsonb_array_elements(e.payload->'refs') r WHERE e.repo_id = {repoId} AND e.kind = 'push' AND r->>'name' = 'refs/heads/main' ORDER BY e.id")
	mut out = []str{}
	for x in rows.Rows {
		out = append(out, x[0].Text() + " " + x[1].Text())
	}
	return out
}

fn parentOf(w mut world, hex str) !str {
	mut st = try w.r.Objects()
	let cd = try commitOf(mut st, hex)
	return cd.Parents[0].Hex()
}

// TestLandStack: a stack of three changes on main lands bottom-up once each has a writer's approval and its required
// check, rebased onto a main that moved, with one compare-and-swap of main per change, in order; the bottom change's
// "fixes replay" marks the group, and its check passing after it landed closes it.
fn TestLandStack(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	mut w = newWorld(got) catch err {
		t.Error("world: {err}")
		return
	}
	let base = map[str]str{"a.tin": "package a\n\nfn A() i64 {{\n\treturn 1\n}}\n", "b.tin": "package a\n\nfn B() i64 {{\n\treturn 1\n}}\n", "c.tin": "package a\n\nfn C() i64 {{\n\treturn 1\n}}\n", "README": "tin\n"}
	let m0 = trunk(mut w, base, object.NoId, 1700000000) catch err {
		t.Error("m0: {err}")
		return
	}
	// the stack: A edits a.tin, B (on A) b.tin, C (on B) c.tin
	let ida = object.NewChangeId()
	let idb = object.NewChangeId()
	let idc = object.NewChangeId()
	mut fa = map[str]str{}
	for k, v in base {
		fa[k] = v
	}
	fa["a.tin"] = "package a\n\nfn A() i64 {{\n\treturn 2\n}}\n"
	let ca = version(mut w, fa, m0, ida, "", "a: two\n\nfixes replay 00aa00aa00aa\n", 1700000010) catch err {
		t.Error("A: {err}")
		return
	}
	mut fb = map[str]str{}
	for k, v in fa {
		fb[k] = v
	}
	fb["b.tin"] = "package a\n\nfn B() i64 {{\n\treturn 2\n}}\n"
	let cb = version(mut w, fb, ca, idb, "", "b: two\n", 1700000020) catch err {
		t.Error("B: {err}")
		return
	}
	mut fc = map[str]str{}
	for k, v in fb {
		fc[k] = v
	}
	fc["c.tin"] = "package a\n\nfn C() i64 {{\n\treturn 2\n}}\n"
	let cc = version(mut w, fc, cb, idc, "", "c: two\n", 1700000030) catch err {
		t.Error("C: {err}")
		return
	}
	let below = StackBelow(w.r.Id, idc.Letters()) catch err {
		t.Error("stack: {err}")
		return
	}
	t.True("the stack below C: {below}", len(below) == 3 && below[0] == ida.Letters() && below[1] == idb.Letters() && below[2] == idc.Letters())
	// main moves under the stack (README), so each change is rebased when it lands
	mut fm = map[str]str{}
	for k, v in base {
		fm[k] = v
	}
	fm["README"] = "tin, the language\n"
	let m1 = trunk(mut w, fm, m0, 1700000040) catch err {
		t.Error("m1: {err}")
		return
	}
	// a replay group the bottom change fixes
	let repoId = w.r.Id
	_ = w.c.Exec("INSERT INTO replay_groups (repo_id, id, panic, route, state, count, first_at, last_at) VALUES ({repoId}, '00aa00aa00aa00aa00aa00aa00aa00aa00aa00aa00aa00aa00aa00aa00aa00aa', 'boom', 'GET /', 'open', 1, now(), now())") catch err {
		t.Error("group: {err}")
		return
	}
	// required: one approval and the ci check
	let byBob = w.call(w.bob, "PUT", "/api/v1/repos/ada/tin/review/settings", "{{\"approvals\":1,\"checks\":[\"ci\"]}}")
	crucible.Equal(mut t, "a writer cannot set the settings", byBob.Code(), 403)
	let set = w.call(w.ada, "PUT", "/api/v1/repos/ada/tin/review/settings", "{{\"approvals\":1,\"checks\":[\"ci\"]}}")
	crucible.Equal(mut t, "the admin sets them: {str(set.Body)}", set.Code(), 200)
	// C alone is refused: B and A have not landed
	let alone = w.call(w.bob, "POST", w.base() + idc.Letters() + "/land", "")
	crucible.Equal(mut t, "C before the changes below it: {str(alone.Body)}", alone.Code(), 409)
	// no approval yet
	let early = w.call(w.bob, "POST", w.base() + ida.Letters() + "/land", "")
	t.True("A without an approval: {str(early.Body)}", early.Code() == 409 && twine.Contains(str(early.Body), "0 of 1 approvals"))
	// the author's own approval and a reader's do not count
	_ = w.call(w.ada, "POST", w.base() + ida.Letters() + "/approvals", "{{\"vote\":\"approve\"}}")
	_ = w.call(w.carol, "POST", w.base() + ida.Letters() + "/approvals", "{{\"vote\":\"approve\"}}")
	let notYet = w.call(w.bob, "POST", w.base() + ida.Letters() + "/land", "")
	t.True("the author's and a reader's approvals do not count: {str(notYet.Body)}", notYet.Code() == 409 && twine.Contains(str(notYet.Body), "0 of 1 approvals"))
	for id in []object.ChangeId{ida, idb, idc} {
		let a = w.call(w.bob, "POST", w.base() + id.Letters() + "/approvals", "{{\"vote\":\"approve\"}}")
		t.True("bob approves {id.Letters()}: {str(a.Body)}", a.Code() == 200 && twine.Contains(str(a.Body), "\"state\":\"approved\""))
	}
	// the checks: required, so A cannot land until ci passes on it
	let noCheck = w.call(w.bob, "POST", w.base() + ida.Letters() + "/land", "")
	t.True("A without its required check: {str(noCheck.Body)}", noCheck.Code() == 409 && twine.Contains(str(noCheck.Body), "ci none"))
	for id in []object.ChangeId{ida, idb, idc} {
		let ok = w.signed("ci@example.com", w.seed, "POST", w.base() + id.Letters() + "/checks", "{{\"name\":\"ci\",\"state\":\"failure\",\"url\":\"https://ci.example.com/1\"}}") catch err {
			t.Error("sign: {err}")
			return
		}
		crucible.Equal(mut t, "ci posts a failure on {id.Letters()}: {str(ok.Body)}", ok.Code(), 201)
	}
	let failed = w.call(w.bob, "POST", w.base() + idc.Letters() + "/land", "{{\"stack\":true}}")
	t.True("a failed check refuses the stack: {str(failed.Body)}", failed.Code() == 409 && twine.Contains(str(failed.Body), "ci failure") && len(landOf(failed).landed) == 0)
	crucible.Equal(mut t, "main has not moved", mainOf(w.c, w.r.Id), m1.Hex())
	for id in []object.ChangeId{ida, idb, idc} {
		let ok = w.signed("ci@example.com", w.seed, "POST", w.base() + id.Letters() + "/checks", "{{\"name\":\"ci\",\"state\":\"success\",\"url\":\"https://ci.example.com/2\"}}") catch err {
			t.Error("sign: {err}")
			return
		}
		crucible.Equal(mut t, "ci passes on {id.Letters()}", ok.Code(), 201)
	}
	// a reader cannot land; a writer lands the stack from its top
	let reader = w.call(w.carol, "POST", w.base() + idc.Letters() + "/land", "{{\"stack\":true}}")
	crucible.Equal(mut t, "a reader cannot land", reader.Code(), 403)
	let movesBefore = mainMoves(w.c, w.r.Id) catch err {
		t.Error("moves: {err}")
		return
	}
	let landed = w.call(w.bob, "POST", w.base() + idc.Letters() + "/land", "{{\"stack\":true}}")
	crucible.Equal(mut t, "the stack lands: {str(landed.Body)}", landed.Code(), 200)
	let lb = landOf(landed)
	t.True("three changes, bottom first, each rebased: {lb.landed}", len(lb.landed) == 3 && lb.landed[0].change == ida.Letters() && lb.landed[1].change == idb.Letters() && lb.landed[2].change == idc.Letters() && lb.landed[0].rebased && lb.landed[1].rebased && lb.landed[2].rebased && lb.landed[0].version == 2)
	if len(lb.landed) != 3 {
		return
	}
	let moves = mainMoves(w.c, w.r.Id) catch err {
		t.Error("moves: {err}")
		return
	}
	crucible.Equal(mut t, "main moved three times", len(moves) - len(movesBefore), 3)
	let a2 = lb.landed[0].commit
	let b2 = lb.landed[1].commit
	let c2 = lb.landed[2].commit
	t.True("once per change, in order: {moves}", len(moves) >= 3 && moves[len(moves) - 3] == m1.Hex() + " " + a2 && moves[len(moves) - 2] == a2 + " " + b2 && moves[len(moves) - 1] == b2 + " " + c2)
	crucible.Equal(mut t, "main is C", mainOf(w.c, w.r.Id), c2)
	let pc = parentOf(mut w, c2) catch err {
		t.Error("parent: {err}")
		return
	}
	let pa = parentOf(mut w, a2) catch err {
		t.Error("parent: {err}")
		return
	}
	t.True("C on B, A on the new main", pc == b2 && pa == m1.Hex() && cc.Hex() != c2)
	for id in []object.ChangeId{ida, idb, idc} {
		let rv = ReviewOf(w.c, w.r.Id, id.Letters()) catch err {
			t.Error("review: {err}")
			return
		}
		t.True("{id.Letters()} is landed", rv != nil && rv.State == StateLanded && rv.LandedBy == w.bob && rv.Version == 2)
	}
	let fixed = w.c.Query("SELECT fixed_by, state FROM replay_groups WHERE repo_id = {repoId}") catch err {
		t.Error("groups: {err}")
		return
	}
	t.True("A's message marked the group it fixes", fixed.Rows[0][0].Text() == ida.Letters() && fixed.Rows[0][1].Text() == "open")
	// the check passing on landed A closes the group (capsules.CheckPassed)
	let passed = w.signed("ci@example.com", w.seed, "POST", w.base() + ida.Letters() + "/checks", "{{\"name\":\"replay-test\",\"state\":\"success\",\"version\":2}}") catch err {
		t.Error("sign: {err}")
		return
	}
	crucible.Equal(mut t, "a check on landed A", passed.Code(), 201)
	let closed = w.c.Query("SELECT state FROM replay_groups WHERE repo_id = {repoId}") catch err {
		t.Error("groups: {err}")
		return
	}
	crucible.Equal(mut t, "the group closed", closed.Rows[0][0].Text(), "closed")
	let again = w.call(w.bob, "POST", w.base() + ida.Letters() + "/land", "")
	crucible.Equal(mut t, "landing a landed change", again.Code(), 409)
	let lev = w.c.Query("SELECT count(*) FROM events WHERE kind = 'review.landed' AND state = 'done'") catch err {
		t.Error("events: {err}")
		return
	}
	crucible.Equal(mut t, "three landed events", lev.Rows[0][0].Int(), 3)
	let pending = w.c.Query("SELECT count(*) FROM packs WHERE repo_id = {repoId} AND state = 'pending'") catch err {
		t.Error("packs: {err}")
		return
	}
	crucible.Equal(mut t, "no pending pack left", pending.Rows[0][0].Int(), 0)
}

// TestLandConflict: when main moved and the change does not rebase onto it, the landing is refused and nothing moves;
// a change already on main lands by moving main alone; a writer's request for changes blocks.
fn TestLandConflict(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	mut w = newWorld(got) catch err {
		t.Error("world: {err}")
		return
	}
	let m0 = trunk(mut w, map[str]str{"a.tin": "package a\n\nfn A() i64 {{\n\treturn 1\n}}\n"}, object.NoId, 1700000000) catch err {
		t.Error("m0: {err}")
		return
	}
	let idx = object.NewChangeId()
	_ = version(mut w, map[str]str{"a.tin": "package a\n\nfn A() i64 {{\n\treturn 2\n}}\n"}, m0, idx, "", "a: two\n", 1700000010) catch err {
		t.Error("X: {err}")
		return
	}
	let idy = object.NewChangeId()
	let cy = version(mut w, map[str]str{"a.tin": "package a\n\nfn A() i64 {{\n\treturn 1\n}}\n", "y.tin": "package a\n"}, m0, idy, "", "y\n", 1700000015) catch err {
		t.Error("Y: {err}")
		return
	}
	let m1 = trunk(mut w, map[str]str{"a.tin": "package a\n\nfn A() i64 {{\n\treturn 3\n}}\n"}, m0, 1700000020) catch err {
		t.Error("m1: {err}")
		return
	}
	let block = w.call(w.bob, "POST", w.base() + idx.Letters() + "/approvals", "{{\"vote\":\"changes\"}}")
	t.True("bob requests changes: {str(block.Body)}", block.Code() == 200 && twine.Contains(str(block.Body), "\"state\":\"changes_requested\""))
	let blocked = w.call(w.bob, "POST", w.base() + idx.Letters() + "/land", "")
	t.True("a writer's changes vote blocks: {str(blocked.Body)}", blocked.Code() == 409 && twine.Contains(str(blocked.Body), "requested changes"))
	_ = w.call(w.bob, "POST", w.base() + idx.Letters() + "/approvals", "{{\"vote\":\"approve\"}}")
	let refused = w.call(w.bob, "POST", w.base() + idx.Letters() + "/land", "")
	t.True("the rebase conflicts: refused: {str(refused.Body)}", refused.Code() == 409 && landOf(refused).code == "conflict" && twine.Contains(str(refused.Body), "a.tin"))
	crucible.Equal(mut t, "main has not moved", mainOf(w.c, w.r.Id), m1.Hex())
	let rv = ReviewOf(w.c, w.r.Id, idx.Letters()) catch err {
		t.Error("review: {err}")
		return
	}
	t.True("the review is still open", rv != nil && rv.State == StateApproved && rv.Version == 1)
	let repoId = w.r.Id
	let pending = w.c.Query("SELECT count(*) FROM packs WHERE repo_id = {repoId} AND state = 'pending'") catch err {
		t.Error("packs: {err}")
		return
	}
	crucible.Equal(mut t, "no pending pack left", pending.Rows[0][0].Int(), 0)
	// Y rebases cleanly (it adds a file); after it lands, a change made on the new main moves main without a rebase
	_ = w.call(w.bob, "POST", w.base() + idy.Letters() + "/approvals", "{{\"vote\":\"approve\"}}")
	let ly = w.call(w.bob, "POST", w.base() + idy.Letters() + "/land", "")
	t.True("Y lands rebased: {str(ly.Body)}", ly.Code() == 200 && landOf(ly).landed[0].rebased && landOf(ly).landed[0].commit != cy.Hex())
	let top = mainOf(w.c, w.r.Id)
	let idz = object.NewChangeId()
	let topId = object.ParseId(top) catch err {
		t.Error("main: {err}")
		return
	}
	let cz = version(mut w, map[str]str{"a.tin": "package a\n\nfn A() i64 {{\n\treturn 3\n}}\n", "y.tin": "package a\n", "z.tin": "package a\n"}, topId, idz, "", "z\n", 1700000030) catch err {
		t.Error("Z: {err}")
		return
	}
	_ = w.call(w.bob, "POST", w.base() + idz.Letters() + "/approvals", "{{\"vote\":\"approve\"}}")
	let lz = w.call(w.bob, "POST", w.base() + idz.Letters() + "/land", "")
	t.True("Z is on main: main moves to its commit as it is: {str(lz.Body)}", lz.Code() == 200 && !landOf(lz).landed[0].rebased && landOf(lz).landed[0].commit == cz.Hex() && mainOf(w.c, w.r.Id) == cz.Hex())
	// X is approved, not landed: "active" lists it, "open" (waiting for votes) does not
	let active = w.call(w.carol, "GET", "/api/v1/repos/ada/tin/reviews?state=active", "")
	t.True("the active reviews: {str(active.Body)}", active.Code() == 200 && twine.Count(str(active.Body), "\"change\":") == 1 && twine.Contains(str(active.Body), idx.Letters()))
	let waiting = w.call(w.carol, "GET", "/api/v1/repos/ada/tin/reviews?state=open", "")
	t.True("no review waits for votes: {str(waiting.Body)}", waiting.Code() == 200 && twine.Count(str(waiting.Body), "\"change\":") == 0)
	let ab = w.call(w.carol, "PATCH", w.base() + idx.Letters() + "/review", "{{\"state\":\"abandoned\"}}")
	crucible.Equal(mut t, "a reader cannot abandon another's change", ab.Code(), 403)
	let ab2 = w.call(w.ada, "PATCH", w.base() + idx.Letters() + "/review", "{{\"state\":\"abandoned\"}}")
	t.True("its author abandons it: {str(ab2.Body)}", ab2.Code() == 200 && twine.Contains(str(ab2.Body), "\"state\":\"abandoned\""))
	let la = w.call(w.bob, "POST", w.base() + idx.Letters() + "/land", "")
	crucible.Equal(mut t, "an abandoned change does not land", la.Code(), 409)
	let list = w.call(w.carol, "GET", "/api/v1/repos/ada/tin/reviews?state=landed", "")
	t.True("the landed reviews: {str(list.Body)}", list.Code() == 200 && twine.Count(str(list.Body), "\"state\":\"landed\"") == 2)
}

// TestChecksSigned: a check is posted only with a valid signature of a writer's key, and keeps the key's id.
fn TestChecksSigned(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	mut w = newWorld(got) catch err {
		t.Error("world: {err}")
		return
	}
	let m0 = trunk(mut w, map[str]str{"a.tin": "package a\n"}, object.NoId, 1700000000) catch err {
		t.Error("m0: {err}")
		return
	}
	let id = object.NewChangeId()
	_ = version(mut w, map[str]str{"a.tin": "package a\n\nfn A() {{\n}}\n"}, m0, id, "", "a\n", 1700000010) catch err {
		t.Error("v1: {err}")
		return
	}
	let path = w.base() + id.Letters() + "/checks"
	let body = "{{\"name\":\"ci\",\"state\":\"success\",\"url\":\"https://ci.example.com/7\"}}"
	let anon = w.call(w.ci, "POST", path, body)
	t.True("unsigned: 401 with a nonce: {str(anon.Body)}", anon.Code() == 401 && twine.Contains(str(anon.Body), "\"nonce\":\""))
	let other = seal.RandomBytes(32)
	let forged = w.signed("ci@example.com", other, "POST", path, body) catch err {
		t.Error("sign: {err}")
		return
	}
	crucible.Equal(mut t, "a key ci does not hold", forged.Code(), 401)
	let tampered = w.signed("ci@example.com", w.seed, "POST", path, body) catch err {
		t.Error("sign: {err}")
		return
	}
	crucible.Equal(mut t, "ci's key", tampered.Code(), 201)
	// carol (a reader) with a key of her own
	let cseed = seal.RandomBytes(32)
	let cpub = seal.Ed25519PublicKey(cseed) catch err {
		t.Error("key: {err}")
		return
	}
	_ = accounts.AddKey(w.c, accounts.System(), w.carol, cpub, "laptop") catch err {
		t.Error("add key: {err}")
		return
	}
	let reader = w.signed("carol@example.com", cseed, "POST", path, body) catch err {
		t.Error("sign: {err}")
		return
	}
	crucible.Equal(mut t, "a reader's key: forbidden", reader.Code(), 403)
	let badState = w.signed("ci@example.com", w.seed, "POST", path, "{{\"name\":\"ci\",\"state\":\"green\"}}") catch err {
		t.Error("sign: {err}")
		return
	}
	crucible.Equal(mut t, "a state that is none of the four", badState.Code(), 422)
	let badName = w.signed("ci@example.com", w.seed, "POST", path, "{{\"name\":\"c i\",\"state\":\"success\"}}") catch err {
		t.Error("sign: {err}")
		return
	}
	crucible.Equal(mut t, "a name with a space", badName.Code(), 422)
	let list = w.call(w.carol, "GET", path, "")
	mut cl = checksList{checks: []checkOut{}}
	argo.Get(str(list.Body), mut cl) catch err {
		t.Error("checks: {err} {str(list.Body)}")
		return
	}
	let keys = accounts.Keys(w.c, w.ci) catch err {
		t.Error("keys: {err}")
		return
	}
	t.True("one check, with ci's key: {str(list.Body)}", len(cl.checks) == 1 && cl.checks[0].name == "ci" && cl.checks[0].version == 1 && cl.checks[0].key_id == keys[0].Id && cl.checks[0].url == "https://ci.example.com/7")
	let review = w.call(w.carol, "GET", w.base() + id.Letters() + "/review", "")
	t.True("the review shows it: {str(review.Body)}", review.Code() == 200 && twine.Contains(str(review.Body), "\"name\":\"ci\""))
}

// TestFanOut: the push fan-out opens a review once per change, asks the runner for a run of each new version when the
// owner opted in, and queues nothing twice when run again.
fn TestFanOut(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	mut w = newWorld(got) catch err {
		t.Error("world: {err}")
		return
	}
	let repoId = w.r.Id
	let ada = w.ada
	_ = w.c.Exec("INSERT INTO runner_keys (key_id, public_key) VALUES ('aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 'tinreplay1:x')") catch err {
		t.Error("key: {err}")
		return
	}
	_ = w.c.Exec("INSERT INTO runner_optins (owner_id, key_id, signers, enabled_by) SELECT owner_id, 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', '', {ada} FROM repos WHERE id = {repoId}") catch err {
		t.Error("opt in: {err}")
		return
	}
	let m0 = trunk(mut w, map[str]str{"a.tin": "package a\n"}, object.NoId, 1700000000) catch err {
		t.Error("m0: {err}")
		return
	}
	let id = object.NewChangeId()
	let v1 = version(mut w, map[str]str{"a.tin": "package a\n\nfn A() {{\n}}\n"}, m0, id, "", "a\n", 1700000010) catch err {
		t.Error("v1: {err}")
		return
	}
	fanOut(w.c, w.r.Id) catch err {
		t.Error("again: {err}")
	}
	_ = version(mut w, map[str]str{"a.tin": "package a\n\nfn A() {{\n\tpanic(1)\n}}\n"}, m0, id, v1.Hex(), "a\n", 1700000020) catch err {
		t.Error("v2: {err}")
		return
	}
	let ch = id.Letters()
	let n = w.c.Query("SELECT (SELECT count(*) FROM reviews WHERE repo_id = {repoId}), (SELECT count(*) FROM events WHERE kind = 'review.opened'), (SELECT count(*) FROM runner_runs WHERE change_id = {ch}), (SELECT count(*) FROM events WHERE kind = 'replay.run')") catch err {
		t.Error("count: {err}")
		return
	}
	let x = n.Rows[0]
	t.True("one review, opened once, a run per version: {x[0].Int()} {x[1].Int()} {x[2].Int()} {x[3].Int()}", x[0].Int() == 1 && x[1].Int() == 1 && x[2].Int() == 2 && x[3].Int() == 2)
	// opened on first use too: a change pushed with no fan-out
	let fresh = Open(w.c, w.r.Id, "zzzz") catch _ {
		Review{RepoId: 0, Change: "", State: "", Target: "", OpenedBy: 0, Version: 0, Commit: "", Created: 0, Updated: 0, Landed: 0, LandedAt: "", LandedBy: 0}
	}
	crucible.Equal(mut t, "no review of a change that does not exist", fresh.RepoId, 0)
}

// TestRoutes: the review routes beside every other package's under /changes/{change}/: no pattern conflicts.
fn TestRoutes(t mut crucible.T) {
	mut r = anvil.NewRouter()
	api.Mount(mut r)
	diffs.Mount(mut r)
	runner.Mount(mut r)
	notify.Mount(mut r)
	capsules.Mount(mut r)
	Mount(mut r)
	t.NoFault("no conflicting pattern", r.Check())
	crucible.Equal(mut t, "land", r.Match("POST", "/api/v1/repos/a/b/changes/xyz/land"), `/api/v1/repos/{owner}/{repo}/changes/{change}/land`)
	crucible.Equal(mut t, "the change itself stays the API's", r.Match("GET", "/api/v1/repos/a/b/changes/xyz"), `/api/v1/repos/{owner}/{repo}/changes/{change}`)
	t.True("review kinds are live", twine.Contains(notify.LiveKinds, KindLanded) && twine.Contains(notify.LiveKinds, KindComment) && twine.Contains(notify.LiveKinds, KindCheck))
}
