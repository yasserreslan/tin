package review

import "../../tit/diff"
import "../../tit/object"
import "../../tit/semantic"
import "../../tit/store"
import "../events"
import "argo"
import "fault"
import "herald"
import "mint"
import "postgres"
import "twine"

// Comments anchored to declarations. A comment names a file, a declaration of it (tit/semantic's key: "fn Lstat",
// "method Repo.Commit"; "" for a comment on the file, and a file of "" for one on the change), a line offset from the
// declaration's first line (its doc comment included), and the version it is anchored to. On a new version each
// comment is looked up again: the declaration in its file, else in another Tin file of the same directory (moved in
// its package); found, the comment moves to the version with its offset carried through a line diff that ignores
// whitespace (so a reformat keeps it on its line); not found (renamed or deleted), it is outdated and stays on the
// version it was last anchored to. A rebase changes nothing a comment is anchored to unless it changed the
// declaration itself.

// Anchor is where a comment sits.
type Anchor struct {
	File   str
	Decl   str
	Offset i64
}

// ---- reading trees ----

// commitOf is a commit's data.
fn commitOf(st mut store.Layered, hex str) !object.CommitData {
	let id = try object.ParseId(hex)
	return try commitData(mut st, id)
}

// entriesAt is the entries of the directory at path in a tree ("" the root); none when there is no such directory.
fn entriesAt(st mut store.Layered, tree object.Id, path str) ![]object.Entry {
	mut at = tree
	if len(path) > 0 {
		for name in twine.Split(path, "/") {
			let es = try treeEntries(mut st, at)
			mut next = object.NoId
			for e in es {
				if e.Name == name && e.Mode == object.Mode.Dir {
					next = e.Id
				}
			}
			if next == object.NoId {
				return []object.Entry{}
			}
			at = next
		}
	}
	return try treeEntries(mut st, at)
}

fn treeEntries(st mut store.Layered, id object.Id) ![]object.Entry {
	let o = try st.Get(id)
	return match o {
		Tree(es) => es
		Commit(_) => []object.Entry{}
		Tag(_) => []object.Entry{}
		Blob(_) => []object.Entry{}
	}
}

fn dirOf(path str) str {
	let slash = twine.LastIndex(path, "/")
	if slash < 0 {
		return ""
	}
	return path[0:slash]
}

fn baseOf(path str) str {
	return path[twine.LastIndex(path, "/") + 1:]
}

// fileAt is the text of the file at path in a tree; ok is false when there is none.
fn fileAt(st mut store.Layered, tree object.Id, path str) !(str, bool) {
	let es = try entriesAt(mut st, tree, dirOf(path))
	let name = baseOf(path)
	for e in es {
		if e.Name == name && e.Mode != object.Mode.Dir {
			let (_, body) = try st.GetRaw(e.Id)
			return body, true
		}
	}
	return "", false
}

// tinFilesIn is the paths of the Tin files directly in a directory of a tree, in name order.
fn tinFilesIn(st mut store.Layered, tree object.Id, dir str) ![]str {
	let es = try entriesAt(mut st, tree, dir)
	mut out = []str{}
	for e in es {
		if e.Mode != object.Mode.Dir && twine.HasSuffix(e.Name, ".tin") {
			if len(dir) == 0 {
				out = append(out, e.Name)
			} else {
				out = append(out, dir + "/" + e.Name)
			}
		}
	}
	return out
}

// declIn is the declaration called key in a file's text, nil when it has none.
fn declIn(text str, key str) ?semantic.Decl {
	let (ds, _) = semantic.Decls(text)
	for d in ds {
		if d.Key == key {
			return d
		}
	}
	return nil
}

// ---- carrying a line ----

// normLine is a line with its whitespace runs as one space and none at either end: a reformat leaves it alone.
fn normLine(line str) str {
	mut out = []u8{}
	mut space = false
	for i in 0..len(line) {
		let c = line[i]
		if c == ' ' || c == '\t' || c == '\r' {
			space = true
			continue
		}
		if space && len(out) > 0 {
			out = append(out, ' ')
		}
		space = false
		out = append(out, c)
	}
	return str(out)
}

// normLines is a text's lines, normalized, blank lines kept (as "") so each keeps its number.
fn normLines(text str) []str {
	mut out = []str{}
	for l in twine.Split(text, "\n") {
		out = append(out, normLine(l))
	}
	return out
}

// CarryLine is where line n (from 0) of a is in b: through the line diff of their normalized lines, a kept line goes
// where it went, a removed one to where the removal happened (the line after it), and every result is inside b.
fn CarryLine(a str, b str, n i64) i64 {
	let la = normLines(a)
	let lb = normLines(b)
	if len(lb) == 0 {
		return 0
	}
	let (es, _) = diff.DiffLimit(la, lb, 1 << 20)
	mut i = 0
	mut j = 0
	mut at = -1
	for e in es {
		if at >= 0 {
			break
		}
		match e {
			Keep(k) => {
				if n < i + k {
					at = j + (n - i)
				}
				i += k
				j += k
			}
			Delete(k) => {
				if n < i + k {
					at = j
				}
				i += k
			}
			Insert(k) => {
				j += k
			}
		}
	}
	if at < 0 {
		at = j + (n - i)
	}
	if at >= len(lb) {
		at = len(lb) - 1
	}
	if at < 0 {
		at = 0
	}
	return at
}

// Moved is where a comment anchored at a in the tree from goes in the tree to; ok is false when its declaration (or
// its file, for a file comment) is gone there.
fn Moved(st mut store.Layered, from object.Id, to object.Id, a Anchor) !(Anchor, bool) {
	if len(a.File) == 0 {
		return a, true
	}
	let (newText, has) = try fileAt(mut st, to, a.File)
	if len(a.Decl) == 0 {
		return a, has
	}
	let (oldText, _) = try fileAt(mut st, from, a.File)
	let before = declIn(oldText, a.Decl)
	mut file = a.File
	mut after = declIn(newText, a.Decl)
	if after == nil {
		// moved to another file of its package
		let others = try tinFilesIn(mut st, to, dirOf(a.File))
		for path in others {
			if path == a.File {
				continue
			}
			let (text, _) = try fileAt(mut st, to, path)
			let d = declIn(text, a.Decl)
			if d != nil {
				after = d
				file = path
				break
			}
		}
	}
	if after == nil {
		return a, false
	}
	mut offset = a.Offset
	let lines = twine.Count(after.Text, "\n") + 1
	if before != nil {
		offset = CarryLine(before.Text, after.Text, a.Offset)
	} else if offset >= lines {
		offset = lines - 1
	}
	return Anchor{File: file, Decl: a.Decl, Offset: offset}, true
}

// ---- the job ----

fn runVersion(j events.Job) ! {
	mut p = versionJob{change: "", version: 0}
	argo.Get(j.Payload, mut p) catch err {
		fail fault.Wrap(err, "review.version: the payload")
	}
	_ = try Reanchor(j.RepoId, p.change, p.version)
}

// commentRow is a comment to move: its id, anchor and the version it is anchored to.
type commentRow struct {
	id      i64
	version i64
	anchor  Anchor
}

// Reanchor moves every comment of a change anchored to a version before version onto it, or marks it outdated; it
// returns the comments moved. Run again it finds them moved.
fn Reanchor(repoId i64, ch str, version i64) !i64 {
	let d = try current()
	let target = try d.Db.Query("SELECT commit_id FROM changes WHERE repo_id = {repoId} AND change_id = {ch} AND version = {version}::int")
	if len(target.Rows) == 0 {
		fail fault.Wrap(ErrNotFound, "{ch} has no version {version}")
	}
	let toCommit = target.Rows[0][0].Text()
	let rows = try d.Db.Query("SELECT c.id, c.version, c.file, c.decl, c.line_offset, v.commit_id FROM comments c JOIN changes v ON v.repo_id = c.repo_id AND v.change_id = c.change_id AND v.version = c.version WHERE c.repo_id = {repoId} AND c.change_id = {ch} AND c.version < {version}::int AND NOT c.outdated ORDER BY c.id")
	if len(rows.Rows) == 0 {
		return 0
	}
	mut r = try pgRepo(repoId, 0)
	mut st = try r.Objects()
	let to = try commitOf(mut st, toCommit)
	mut moved = 0
	mut lost = 0
	for x in rows.Rows {
		let id = x[0].Int()
		let from = try commitOf(mut st, x[5].Text())
		let a = Anchor{File: x[2].Text(), Decl: x[3].Text(), Offset: x[4].Int()}
		let (next, ok) = try Moved(mut st, from.Tree, to.Tree, a)
		let was = x[1].Int()
		if ok {
			let file = next.File
			let off = next.Offset
			_ = try d.Db.Exec("UPDATE comments SET version = {version}::int, file = {file}, line_offset = {off}::int WHERE id = {id} AND version = {was}::int")
			moved += 1
		} else {
			_ = try d.Db.Exec("UPDATE comments SET outdated = true, outdated_at = now() WHERE id = {id} AND version = {was}::int")
			lost += 1
		}
	}
	herald.Log(herald.LInfo, "review comments", []str{"repo", mint.Itoa(repoId), "change", ch, "version", mint.Itoa(version), "moved", mint.Itoa(moved), "outdated", mint.Itoa(lost)})
	return moved
}

// ---- comments ----

// Comment is one comment as the API shows it: author 0 for a system comment (the bench, #1029).
type Comment struct {
	Id       i64
	Author   i64
	Name     str
	Parent   i64
	Version  i64
	Written  i64
	File     str
	Decl     str
	Offset   i64
	Line     i64
	Body     str
	Outdated bool
	Resolved bool
	Created  i64
}

// Comments is a change's comments, oldest first; Line is the comment's line in its file at the version it is
// anchored to (0 when it has no declaration, or it is outdated).
fn Comments(repoId i64, ch str) ![]Comment {
	let d = try current()
	let rows = try d.Db.Query("SELECT c.id, coalesce(c.author_id, 0), coalesce(o.name, ''), coalesce(c.parent_id, 0), c.version, c.written_on, c.file, c.decl, c.line_offset, c.body, c.outdated::int, (c.resolved_at IS NOT NULL)::int, extract(epoch FROM c.created_at)::bigint, coalesce(v.commit_id, '') FROM comments c LEFT JOIN users u ON u.id = c.author_id LEFT JOIN owners o ON o.id = u.owner_id LEFT JOIN changes v ON v.repo_id = c.repo_id AND v.change_id = c.change_id AND v.version = c.version WHERE c.repo_id = {repoId} AND c.change_id = {ch} ORDER BY c.id")
	mut out = []Comment{}
	mut lines = map[str]i64{}
	mut st ?store.Layered = nil
	for x in rows.Rows {
		let decl = x[7].Text()
		let outdated = x[10].Int() == 1
		mut line = 0
		if len(decl) > 0 && !outdated && len(x[13].Text()) > 0 {
			let key = x[13].Text() + "\t" + x[6].Text() + "\t" + decl
			let (got, seen) = lines[key]
			if seen {
				line = got
			} else {
				if st == nil {
					mut r = try pgRepo(repoId, 0)
					st = try r.Objects()
				}
				mut s = st
				if s != nil {
					let cd = try commitOf(mut s, x[13].Text())
					let (text, _) = try fileAt(mut s, cd.Tree, x[6].Text())
					let at = declIn(text, decl)
					if at != nil {
						line = at.Line
					}
				}
				lines[key] = line
			}
			if line > 0 {
				line += x[8].Int()
			}
		}
		out = append(out, Comment{Id: x[0].Int(), Author: x[1].Int(), Name: x[2].Text(), Parent: x[3].Int(), Version: x[4].Int(), Written: x[5].Int(), File: x[6].Text(), Decl: decl, Offset: x[8].Int(), Line: line, Body: x[9].Text(), Outdated: outdated, Resolved: x[11].Int() == 1, Created: x[12].Int()})
	}
	return out
}

// NewComment is a comment to add: on a version (0: the newest), a file, a declaration of it and a line offset, or a
// reply to another (Parent: it takes the parent's anchor).
type NewComment struct {
	Version i64
	File    str
	Decl    str
	Offset  i64
	Parent  i64
	Body    str
}

// AddComment adds a comment by author (0: a system comment) after checking that its declaration is in its file at
// the version; its id.
fn AddComment(repoId i64, ch str, author i64, nc NewComment) !i64 {
	let d = try current()
	if len(nc.Body) == 0 || len(nc.Body) > 65536 {
		fail fault.Wrap(ErrInvalid, "a comment's body is 1 to 65536 bytes")
	}
	let rv = try Open(d.Db, repoId, ch)
	mut a = Anchor{File: nc.File, Decl: nc.Decl, Offset: nc.Offset}
	mut version = nc.Version
	let parent = nc.Parent
	if parent > 0 {
		let p = try d.Db.Query("SELECT version, file, decl, line_offset FROM comments WHERE id = {parent} AND repo_id = {repoId} AND change_id = {ch}")
		if len(p.Rows) == 0 {
			fail fault.Wrap(ErrNotFound, "no comment {parent} on {ch}")
		}
		version = p.Rows[0][0].Int()
		a = Anchor{File: p.Rows[0][1].Text(), Decl: p.Rows[0][2].Text(), Offset: p.Rows[0][3].Int()}
	} else {
		if version <= 0 {
			version = rv.Version
		}
		try checkAnchor(repoId, ch, version, a)
	}
	let file = a.File
	let decl = a.Decl
	let off = a.Offset
	let body = nc.Body
	mut tx = try d.Db.Begin()
	let (id, err) = commentIn(mut tx, repoId, ch, version, author, parent, file, decl, off, body)
	if err != nil {
		rollback(mut tx)
		fail err
	}
	try tx.Commit()
	return id
}

fn commentIn(tx mut postgres.Tx, repoId i64, ch str, version i64, author i64, parent i64, file str, decl str, off i64, body str) !i64 {
	let rows = try tx.Query("INSERT INTO comments (repo_id, change_id, version, written_on, author_id, parent_id, decl, file, line_offset, body) VALUES ({repoId}, {ch}, {version}::int, {version}::int, nullif({author}, 0), nullif({parent}, 0), {decl}, {file}, {off}::int, {body}) RETURNING id")
	let id = rows.Rows[0][0].Int()
	try announce(mut tx, repoId, KindComment, ch, version, author, "", "{id}")
	return id
}

// checkAnchor fails unless the anchor is in the change's version: its file, and its declaration with the offset
// inside it.
fn checkAnchor(repoId i64, ch str, version i64, a Anchor) ! {
	let d = try current()
	if len(a.File) == 0 {
		if len(a.Decl) > 0 || a.Offset != 0 {
			fail fault.Wrap(ErrInvalid, "a comment on a declaration names its file")
		}
		return
	}
	if a.Offset < 0 {
		fail fault.Wrap(ErrInvalid, "a line offset is not negative")
	}
	let v = try d.Db.Query("SELECT commit_id FROM changes WHERE repo_id = {repoId} AND change_id = {ch} AND version = {version}::int")
	if len(v.Rows) == 0 {
		fail fault.Wrap(ErrNotFound, "{ch} has no version {version}")
	}
	mut r = try pgRepo(repoId, 0)
	mut st = try r.Objects()
	let cd = try commitOf(mut st, v.Rows[0][0].Text())
	let (text, has) = try fileAt(mut st, cd.Tree, a.File)
	if !has {
		fail fault.Wrap(ErrInvalid, "version {version} of {ch} has no file {a.File}")
	}
	if len(a.Decl) == 0 {
		return
	}
	let at = declIn(text, a.Decl)
	if at == nil {
		fail fault.Wrap(ErrInvalid, "{a.File} has no declaration {a.Decl} in version {version}")
	}
	let lines = twine.Count(at.Text, "\n") + 1
	if a.Offset >= lines {
		fail fault.Wrap(ErrInvalid, "{a.Decl} has {lines} lines; the offset {a.Offset} is past them")
	}
}

// Resolve marks a comment resolved, or not: its author or a writer (the API checks the role).
fn Resolve(repoId i64, ch str, id i64, resolved bool) !bool {
	let d = try current()
	let res = try d.Db.Exec("UPDATE comments SET resolved_at = CASE WHEN {resolved} THEN coalesce(resolved_at, now()) ELSE NULL END WHERE id = {id} AND repo_id = {repoId} AND change_id = {ch}")
	return res.Affected == 1
}

// AuthorOf is a comment's author (0 for a system comment); ErrNotFound when the change has no such comment.
fn AuthorOf(repoId i64, ch str, id i64) !i64 {
	let d = try current()
	let rows = try d.Db.Query("SELECT coalesce(author_id, 0) FROM comments WHERE id = {id} AND repo_id = {repoId} AND change_id = {ch}")
	if len(rows.Rows) == 0 {
		fail fault.Wrap(ErrNotFound, "no comment {id} on {ch}")
	}
	return rows.Rows[0][0].Int()
}
