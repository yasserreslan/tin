package review

import "../accounts"
import "../events"
import "../notify"
import "../packs"
import "../repo"
import "../runner"
import "anvil"
import "argo"
import "fault"
import "postgres"
import "tide"
import "twine"

// Reviews, comments, checks and landing (design/tinhub.md §5 and §14, #1025). A change gets its review when its first
// version is pushed (the push fan-out calls EnqueueFor) or on its first use through the API: open, approved,
// changes_requested, landed or abandoned. Votes count by role: each user's newest vote counts, an approve from a writer
// (not the change's author) toward the repository's required approvals, and a writer's changes_requested blocks.
// Comments are anchored to a declaration of a file (tit/semantic's key, "fn Lstat"), a line offset inside it and a
// version, and re-anchored on each new version (the review.version job): a declaration found again (in its file, or
// moved within its package) keeps the comment, its offset carried by a whitespace-blind line diff; a renamed or
// deleted one makes it outdated. Checks are posted by outside CI, signed with a tit key (Tit-Signature), one status
// per name and version. Landing runs on the server, bottom-up through a stack, one compare-and-swap of the target
// under the repository's lock per change (land.tin).

// The job kind of re-anchoring a change's comments onto a new version, and its budget.
const KindVersion = "review.version"

const versionWithin = 60 * tide.Second

const versionMemory = 256 * 1024 * 1024

// The review events: rows of the events table written done in the transaction that made them (live updates read
// them; notify.EnqueueFor queues their webhooks and mail in the same transaction). notify.LiveKinds lists them.
const KindOpened = "review.opened"

const KindVoted = "review.voted"

const KindComment = "review.comment"

const KindCheck = "review.check"

const KindLanded = "review.landed"

const KindState = "review.state"

// The review states.
const StateOpen = "open"

const StateApproved = "approved"

const StateChanges = "changes_requested"

const StateLanded = "landed"

const StateAbandoned = "abandoned"

// Errors the API answers with its own status.
let ErrNotFound = fault("not found")

let ErrInvalid = fault("invalid")

let ErrForbidden = fault("forbidden")

let ErrConflict = fault("conflict")

let ErrNotReady = fault("not ready to land")

// Deps is what reviews need, set on every core (Configure, or Handlers on a worker) before the first use.
type Deps struct {
	Db    postgres.Client
	Store dyn packs.PackStore
	Cache repo.RefCache
	// Dir is the node's packs.dir: a landing's rebased commits are packed under Dir/tmp
	Dir str
	// NonceKey is secrets.nonce: checks are posted with a Tit-Signature over one of its nonces
	NonceKey secret str
	// Auth is the signed-in user of a request (a session), 0 for nobody; a request with a Tit-Signature is its signer
	Auth fn(anvil.Req) !i64
}

mut deps ?Deps = nil

// Configure sets this core's dependencies.
fn Configure(d Deps) {
	deps = keep(d)
}

fn current() !Deps {
	let got = deps
	if got == nil {
		fail "review: not configured on this core"
	}
	return got
}

// pgRepo is a repository over this core's dependencies (the store is read from the global: taking it from a
// parameter's field trips a false E701, #1073).
fn pgRepo(id i64, who i64) !repo.PgRepo {
	let d = try current()
	return repo.PgRepo{Db: d.Db, Store: d.Store, Cache: d.Cache, Id: id, Dir: d.Dir, Who: who}
}

// Handlers configures this core with d and is the worker's review.version handler.
fn Handlers(d Deps) []events.Handler {
	Configure(d)
	return []events.Handler{events.Handler{Kind: KindVersion, Within: versionWithin, Memory: versionMemory, Tasks: 0, MaxAttempts: 5, Run: runVersion}}
}

// ---- the push fan-out ----

type changeMove struct {
	change   str
	replaces str
	commit   str
}

type push struct {
	changes []changeMove
}

// versionJob is a review.version job's payload: the change and the version its comments move to.
type versionJob struct {
	change  str
	version i64
}

// EnqueueFor is the push fan-out's call (workers/push.tin followUps), in its transaction: for each change version the
// push added it opens the change's review when it has none, asks the runner for a run of the version while the
// review is open (runner.Request: nothing unless the owner opted in), and queues a review.version job when the change
// has comments to move onto it. A fan-out run again does each once. It returns the jobs and runs queued.
fn EnqueueFor(tx mut postgres.Tx, repoId i64, payload str) !i64 {
	mut p = push{changes: []changeMove{}}
	argo.Get(payload, mut p) catch err {
		fail fault.Wrap(err, "review: the push payload")
	}
	mut n = 0
	for c in p.changes {
		if len(c.change) == 0 || len(c.commit) != 64 {
			continue
		}
		let ch = c.change
		let commit = c.commit
		let v = try tx.Query("SELECT version, coalesce(pushed_by, 0) FROM changes WHERE repo_id = {repoId} AND change_id = {ch} AND commit_id = {commit} ORDER BY version DESC LIMIT 1")
		if len(v.Rows) == 0 {
			continue
		}
		let version = v.Rows[0][0].Int()
		let by = v.Rows[0][1].Int()
		let state = try openIn(mut tx, repoId, ch, version, by)
		if state == StateOpen || state == StateApproved || state == StateChanges {
			let ran = try tx.Query("SELECT 1 FROM runner_runs WHERE repo_id = {repoId} AND change_id = {ch} AND version = {version}::int")
			if len(ran.Rows) == 0 {
				let run = try runner.Request(mut tx, repoId, ch, version, by)
				if run > 0 {
					n += 1
				}
			}
		}
		let behind = try tx.Query("SELECT 1 FROM comments WHERE repo_id = {repoId} AND change_id = {ch} AND version < {version}::int AND NOT outdated LIMIT 1")
		if len(behind.Rows) > 0 {
			mut buf = []u8{}
			argo.Put(mut buf, versionJob{change: ch, version: version})
			let body = str(buf)
			let kind = KindVersion
			let q = try tx.Exec("INSERT INTO events (kind, repo_id, payload) SELECT {kind}, {repoId}, {body}::jsonb WHERE NOT EXISTS (SELECT 1 FROM events WHERE kind = {kind} AND repo_id = {repoId} AND payload = {body}::jsonb AND state IN ('ready', 'claimed'))")
			n += q.Affected
		}
	}
	return n
}

// openIn makes the change's review when it has none (target: the repository's default branch), announcing it; the
// review's state.
fn openIn(tx mut postgres.Tx, repoId i64, ch str, version i64, by i64) !str {
	let made = try tx.Query("INSERT INTO reviews (repo_id, change_id, state, target, opened_by) SELECT id, {ch}, 'open', 'refs/heads/' || default_branch, nullif({by}, 0) FROM repos WHERE id = {repoId} ON CONFLICT (repo_id, change_id) DO NOTHING RETURNING state")
	if len(made.Rows) == 1 {
		try announce(mut tx, repoId, KindOpened, ch, version, by, StateOpen, "")
		return StateOpen
	}
	let rows = try tx.Query("SELECT state FROM reviews WHERE repo_id = {repoId} AND change_id = {ch}")
	if len(rows.Rows) == 0 {
		fail fault.Wrap(ErrNotFound, "no repository {repoId}")
	}
	return rows.Rows[0][0].Text()
}

// Open makes a change's review when it has none (its first use through the API) and returns it; ErrNotFound when the
// repository has no such change.
fn Open(c postgres.Client, repoId i64, ch str) !Review {
	let v = try c.Query("SELECT max(version), (array_agg(coalesce(pushed_by, 0) ORDER BY version))[1] FROM changes WHERE repo_id = {repoId} AND change_id = {ch} HAVING count(*) > 0")
	if len(v.Rows) == 0 {
		fail fault.Wrap(ErrNotFound, "no change {ch}")
	}
	let have = try c.Query("SELECT 1 FROM reviews WHERE repo_id = {repoId} AND change_id = {ch}")
	if len(have.Rows) == 0 {
		mut tx = try c.Begin()
		let (_, err) = openIn(mut tx, repoId, ch, v.Rows[0][0].Int(), v.Rows[0][1].Int())
		if err != nil {
			rollback(mut tx)
			fail err
		}
		try tx.Commit()
	}
	let got = try ReviewOf(c, repoId, ch)
	if got == nil {
		fail fault.Wrap(ErrNotFound, "no change {ch}")
	}
	return got
}

fn rollback(tx mut postgres.Tx) {
	tx.Rollback() catch _ {
	}
}

// ---- events ----

type changeRef struct {
	change str
}

// eventOut is a review event's payload: the change (also as changes, which notify and live updates read), its
// version, who did it, the review's state after it, and a detail (a comment's id, a check's name and state, the
// commit landed).
type eventOut struct {
	change  str
	version i64
	by      i64
	state   str
	detail  str
	changes []changeRef
}

// announce records a review event in tx: a done row of events (live updates read it) and its webhooks and mail.
fn announce(tx mut postgres.Tx, repoId i64, kind str, ch str, version i64, by i64, state str, detail str) ! {
	mut buf = []u8{}
	argo.Put(mut buf, eventOut{change: ch, version: version, by: by, state: state, detail: detail, changes: []changeRef{changeRef{change: ch}}})
	let body = str(buf)
	_ = try tx.Exec("INSERT INTO events (kind, repo_id, payload, state, done_at) VALUES ({kind}, {repoId}, {body}::jsonb, 'done', now())")
	_ = try notify.EnqueueFor(mut tx, repoId, kind, body)
}

// ---- reviews ----

// Review is a change's review.
type Review struct {
	RepoId    i64
	Change    str
	State     str
	Target    str
	OpenedBy  i64
	Version   i64
	Commit    str
	Created   i64
	Updated   i64
	Landed    i64
	LandedAt  str
	LandedBy  i64
}

// ReviewOf is a change's review, nil when it has none.
fn ReviewOf(c postgres.Client, repoId i64, ch str) !?Review {
	let rows = try c.Query("SELECT r.state, r.target, coalesce(r.opened_by, 0), coalesce(v.version, 0), coalesce(v.commit_id, ''), extract(epoch FROM r.created_at)::bigint, extract(epoch FROM r.updated_at)::bigint, coalesce(extract(epoch FROM r.landed_at)::bigint, 0), r.landed_commit, coalesce(r.landed_by, 0) FROM reviews r LEFT JOIN LATERAL (SELECT version, commit_id FROM changes WHERE repo_id = r.repo_id AND change_id = r.change_id ORDER BY version DESC LIMIT 1) v ON true WHERE r.repo_id = {repoId} AND r.change_id = {ch}")
	if len(rows.Rows) == 0 {
		return nil
	}
	let x = rows.Rows[0]
	return Review{RepoId: repoId, Change: ch, State: x[0].Text(), Target: x[1].Text(), OpenedBy: x[2].Int(), Version: x[3].Int(), Commit: x[4].Text(), Created: x[5].Int(), Updated: x[6].Int(), Landed: x[7].Int(), LandedAt: x[8].Text(), LandedBy: x[9].Int()}
}

// Settings is a repository's review settings: the writers' approvals a change needs and the checks that must pass on
// it before it lands.
type Settings struct {
	Approvals i64
	Checks    []str
}

// SettingsOf is a repository's settings (one approval and no checks when none are set).
fn SettingsOf(c postgres.Client, repoId i64) !Settings {
	let rows = try c.Query("SELECT approvals, array_to_string(required_checks, ',') FROM review_settings WHERE repo_id = {repoId}")
	if len(rows.Rows) == 0 {
		return Settings{Approvals: 1, Checks: []str{}}
	}
	return Settings{Approvals: rows.Rows[0][0].Int(), Checks: splitComma(rows.Rows[0][1].Text())}
}

fn splitComma(s str) []str {
	mut out = []str{}
	if len(s) == 0 {
		return out
	}
	for x in twine.Split(s, ",") {
		if len(x) > 0 {
			out = append(out, x)
		}
	}
	return out
}

// ValidCheckName reports whether a check's name is 1 to 100 of [A-Za-z0-9._/-].
fn ValidCheckName(name str) bool {
	if len(name) == 0 || len(name) > 100 {
		return false
	}
	for i in 0..len(name) {
		let c = name[i]
		let ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '.' || c == '_' || c == '/' || c == '-'
		if !ok {
			return false
		}
	}
	return true
}

// SetSettings sets a repository's settings (an admin's call: the API checks the role), with an audit row.
fn SetSettings(c postgres.Client, repoId i64, by i64, s Settings) ! {
	if s.Approvals < 0 || s.Approvals > 10 {
		fail fault.Wrap(ErrInvalid, "approvals is 0 to 10, not {s.Approvals}")
	}
	if len(s.Checks) > 20 {
		fail fault.Wrap(ErrInvalid, "at most 20 required checks")
	}
	for name in s.Checks {
		if !ValidCheckName(name) {
			fail fault.Wrap(ErrInvalid, "a check's name is 1 to 100 of A-Z a-z 0-9 . _ / -, not {name}")
		}
	}
	let csv = twine.Join(s.Checks, ",")
	let n = s.Approvals
	mut tx = try c.Begin()
	let err = setIn(mut tx, repoId, by, n, csv)
	if err != nil {
		rollback(mut tx)
		fail err
	}
	try tx.Commit()
}

fn setIn(tx mut postgres.Tx, repoId i64, by i64, n i64, csv str) ! {
	_ = try tx.Exec("INSERT INTO review_settings (repo_id, approvals, required_checks, updated_by) VALUES ({repoId}, {n}::int, string_to_array(nullif({csv}, ''), ','), nullif({by}, 0)) ON CONFLICT (repo_id) DO UPDATE SET approvals = EXCLUDED.approvals, required_checks = EXCLUDED.required_checks, updated_by = EXCLUDED.updated_by, updated_at = now()")
	_ = try tx.Exec("INSERT INTO audit_log (actor_id, action, target_kind, target_id, detail) VALUES (nullif({by}, 0), 'review.settings', 'repo', {repoId}, jsonb_build_object('approvals', {n}::int, 'checks', {csv}))")
}

// ---- votes ----

// Tally is how a review's votes count: the approvals that count, the writers blocking, and the approvals needed.
type Tally struct {
	Approvals i64
	Blocking  i64
	Needed    i64
}

// Ready reports whether the votes let the change land.
fn (t Tally) Ready() bool {
	return t.Blocking == 0 && t.Approvals >= t.Needed
}

// stateOf is the state votes give an open review.
fn stateOf(t Tally) str {
	if t.Blocking > 0 {
		return StateChanges
	}
	if t.Approvals >= t.Needed {
		return StateApproved
	}
	return StateOpen
}

// TallyOf counts a review's votes: each user's newest (by version, then time); an approve counts from a writer who
// is not the change's author, a changes vote from a writer blocks.
fn TallyOf(c postgres.Client, r accounts.Repo, ch str) !Tally {
	let s = try SettingsOf(c, r.Id)
	let repoId = r.Id
	let rows = try c.Query("SELECT DISTINCT ON (a.user_id) a.user_id, a.vote, coalesce(rv.opened_by, 0) FROM approvals a JOIN reviews rv ON rv.repo_id = a.repo_id AND rv.change_id = a.change_id WHERE a.repo_id = {repoId} AND a.change_id = {ch} ORDER BY a.user_id, a.version DESC, a.created_at DESC")
	mut t = Tally{Approvals: 0, Blocking: 0, Needed: s.Approvals}
	for x in rows.Rows {
		let user = x[0].Int()
		let role = try accounts.RoleOf(c, user, r)
		if role < accounts.RoleWrite {
			continue
		}
		if x[1].Text() == "changes" {
			t.Blocking += 1
		} else if user != x[2].Int() {
			t.Approvals += 1
		}
	}
	return t
}

// Vote records user's vote ("approve" or "changes") on the change's newest version and sets the review's state from
// the votes; the review after it. Anyone who can read may vote; only writers' votes count.
fn Vote(c postgres.Client, r accounts.Repo, ch str, user i64, vote str) !Review {
	if vote != "approve" && vote != "changes" {
		fail fault.Wrap(ErrInvalid, "a vote is approve or changes, not {vote}")
	}
	let rv = try Open(c, r.Id, ch)
	if rv.State == StateLanded || rv.State == StateAbandoned {
		fail fault.Wrap(ErrConflict, "{ch} is {rv.State}")
	}
	let repoId = r.Id
	let version = rv.Version
	_ = try c.Exec("INSERT INTO approvals (repo_id, change_id, version, user_id, vote) VALUES ({repoId}, {ch}, {version}::int, {user}, {vote}) ON CONFLICT (repo_id, change_id, version, user_id) DO UPDATE SET vote = EXCLUDED.vote, created_at = now()")
	let t = try TallyOf(c, r, ch)
	let state = stateOf(t)
	mut tx = try c.Begin()
	let err = votedIn(mut tx, repoId, ch, version, user, state, vote)
	if err != nil {
		rollback(mut tx)
		fail err
	}
	try tx.Commit()
	let after = try ReviewOf(c, repoId, ch)
	if after == nil {
		fail fault.Wrap(ErrNotFound, "no change {ch}")
	}
	return after
}

fn votedIn(tx mut postgres.Tx, repoId i64, ch str, version i64, user i64, state str, vote str) ! {
	_ = try tx.Exec("UPDATE reviews SET state = {state}, updated_at = now() WHERE repo_id = {repoId} AND change_id = {ch} AND state IN ('open', 'approved', 'changes_requested')")
	try announce(mut tx, repoId, KindVoted, ch, version, user, state, vote)
}

// SetState abandons an open review ("abandoned") or reopens an abandoned one ("open"): the change's author or a
// writer.
fn SetState(c postgres.Client, r accounts.Repo, ch str, user i64, state str) !Review {
	if state != StateAbandoned && state != StateOpen {
		fail fault.Wrap(ErrInvalid, "a review is set to open or abandoned, not {state}")
	}
	let rv = try Open(c, r.Id, ch)
	let role = try accounts.RoleOf(c, user, r)
	if role < accounts.RoleWrite && user != rv.OpenedBy {
		fail fault.Wrap(ErrForbidden, "only the change's author or a writer can do that")
	}
	if rv.State == StateLanded {
		fail fault.Wrap(ErrConflict, "{ch} has landed")
	}
	mut next = state
	if state == StateOpen {
		let t = try TallyOf(c, r, ch)
		next = stateOf(t)
	}
	let repoId = r.Id
	mut tx = try c.Begin()
	let err = stateIn(mut tx, repoId, ch, rv.Version, user, next)
	if err != nil {
		rollback(mut tx)
		fail err
	}
	try tx.Commit()
	let after = try ReviewOf(c, repoId, ch)
	if after == nil {
		fail fault.Wrap(ErrNotFound, "no change {ch}")
	}
	return after
}

fn stateIn(tx mut postgres.Tx, repoId i64, ch str, version i64, user i64, next str) ! {
	let res = try tx.Exec("UPDATE reviews SET state = {next}, updated_at = now() WHERE repo_id = {repoId} AND change_id = {ch} AND state <> 'landed'")
	if res.Affected != 1 {
		fail fault.Wrap(ErrConflict, "{ch} has landed")
	}
	try announce(mut tx, repoId, KindState, ch, version, user, next, "")
}

// VoteOut is one user's vote on a version.
type VoteOut struct {
	User    i64
	Name    str
	Version i64
	Vote    str
	At      i64
}

// Votes is every vote on a change, oldest first.
fn Votes(c postgres.Client, repoId i64, ch str) ![]VoteOut {
	let rows = try c.Query("SELECT a.user_id, coalesce(o.name, ''), a.version, a.vote, extract(epoch FROM a.created_at)::bigint FROM approvals a LEFT JOIN users u ON u.id = a.user_id LEFT JOIN owners o ON o.id = u.owner_id WHERE a.repo_id = {repoId} AND a.change_id = {ch} ORDER BY a.created_at, a.user_id")
	mut out = []VoteOut{}
	for x in rows.Rows {
		out = append(out, VoteOut{User: x[0].Int(), Name: x[1].Text(), Version: x[2].Int(), Vote: x[3].Text(), At: x[4].Int()})
	}
	return out
}
