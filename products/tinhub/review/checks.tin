package review

import "../../tit/transport"
import "../accounts"
import "../capsules"
import "fault"
import "postgres"
import "seal"
import "twine"

// Checks: outside CI posts a status per change version (name, state, URL), signed with a tit key (Tit-Signature over
// the request, the same scheme as the protocol's: design/tit.md §15), and the key's id is kept with the status. The
// poster needs write access. A repository's admin names the checks a change must pass before it lands
// (review_settings). A check that passes on a landed change runs capsules.CheckPassed in its transaction: the replay
// groups the change fixes close.

// Signer is who signed a request: the user and the id of the key.
type Signer struct {
	User  accounts.User
	KeyId i64
}

// VerifyKey checks a Tit-Signature as accounts.VerifySigned does (a nonce of nonceKey under a minute old, a signature
// over method, path and the body's SHA-256 by one of the signer's live keys) and also names the key; a refusal is
// transport.ErrRefused (Unauthorized or NonceExpired).
fn VerifyKey(c postgres.Client, nonceKey secret str, method str, path str, signature str, body str, now i64) !Signer {
	if len(signature) == 0 {
		fail fault.Wrap(transport.ErrRefused, "Unauthorized: sign the request with your key (tit key makes one)")
	}
	let (email, nonce, sig) = try transport.ParseSignatureHeader(signature)
	try transport.CheckNonce(nonceKey, nonce, now)
	let u = try accounts.UserByEmail(c, email)
	if u == nil {
		fail fault.Wrap(transport.ErrRefused, "Unauthorized: no key of {email} is registered here")
	}
	let keys = try accounts.Keys(c, u.Id)
	let payload = []u8(transport.SigningPayload(method, path, nonce, body))
	for k in keys {
		let verr = seal.VerifyEd25519(k.Public, payload, sig)
		if verr == nil {
			let id = k.Id
			_ = try c.Exec("UPDATE keys SET last_used_at = now() WHERE id = {id}")
			return Signer{User: u, KeyId: id}
		}
	}
	fail fault.Wrap(transport.ErrRefused, "Unauthorized: the signature is not {email}'s")
}

// Nonce is a fresh nonce to sign a request with.
fn Nonce(nonceKey secret str, now i64) str {
	return transport.NewNonce(nonceKey, now)
}

// Check is one check's status on a version.
type Check struct {
	Version     i64
	Name        str
	State       str
	Url         str
	Description str
	KeyId       i64
	Updated     i64
}

// validState reports whether a check's state is one of pending, success, failure and error.
fn validState(s str) bool {
	return s == "pending" || s == "success" || s == "failure" || s == "error"
}

// validUrl reports whether a check's URL is empty or http(s), at most 2000 bytes, with no space or control byte.
fn validUrl(u str) bool {
	if len(u) == 0 {
		return true
	}
	if len(u) > 2000 || !(twine.HasPrefix(u, "https://") || twine.HasPrefix(u, "http://")) {
		return false
	}
	for i in 0..len(u) {
		if u[i] <= ' ' || u[i] == 127 {
			return false
		}
	}
	return true
}

// PostCheck records a check's status on a change version (0: the newest), signed with keyId; the check as kept. A
// success on a landed change closes the replay groups it fixes (capsules.CheckPassed), in the same transaction.
fn PostCheck(repoId i64, ch str, keyId i64, c Check) !Check {
	let d = try current()
	if !ValidCheckName(c.Name) {
		fail fault.Wrap(ErrInvalid, "a check's name is 1 to 100 of A-Z a-z 0-9 . _ / -, not {c.Name}")
	}
	if !validState(c.State) {
		fail fault.Wrap(ErrInvalid, "a check's state is pending, success, failure or error, not {c.State}")
	}
	if !validUrl(c.Url) {
		fail fault.Wrap(ErrInvalid, "a check's url is http(s), at most 2000 bytes")
	}
	if len(c.Description) > 1000 {
		fail fault.Wrap(ErrInvalid, "a check's description is at most 1000 bytes")
	}
	let rv = try Open(d.Db, repoId, ch)
	mut version = c.Version
	if version <= 0 {
		version = rv.Version
	}
	let have = try d.Db.Query("SELECT 1 FROM changes WHERE repo_id = {repoId} AND change_id = {ch} AND version = {version}::int")
	if len(have.Rows) == 0 {
		fail fault.Wrap(ErrNotFound, "{ch} has no version {version}")
	}
	let out = Check{Version: version, Name: c.Name, State: c.State, Url: c.Url, Description: c.Description, KeyId: keyId, Updated: 0}
	mut tx = try d.Db.Begin()
	let err = checkIn(mut tx, repoId, ch, out)
	if err != nil {
		rollback(mut tx)
		fail err
	}
	try tx.Commit()
	return out
}

fn checkIn(tx mut postgres.Tx, repoId i64, ch str, c Check) ! {
	let version = c.Version
	let name = c.Name
	let state = c.State
	let url = c.Url
	let desc = c.Description
	let key = c.KeyId
	_ = try tx.Exec("INSERT INTO checks (repo_id, change_id, version, name, state, url, description, key_id) VALUES ({repoId}, {ch}, {version}::int, {name}, {state}, {url}, {desc}, nullif({key}, 0)) ON CONFLICT (repo_id, change_id, version, name) DO UPDATE SET state = EXCLUDED.state, url = EXCLUDED.url, description = EXCLUDED.description, key_id = EXCLUDED.key_id, updated_at = now()")
	if state == "success" {
		let landed = try tx.Query("SELECT 1 FROM reviews WHERE repo_id = {repoId} AND change_id = {ch} AND state = 'landed'")
		if len(landed.Rows) > 0 {
			_ = try capsules.CheckPassed(mut tx, repoId, ch)
		}
	}
	try announce(mut tx, repoId, KindCheck, ch, version, 0, "", name + " " + state)
}

// Checks is a change's checks, by version then name.
fn Checks(c postgres.Client, repoId i64, ch str) ![]Check {
	let rows = try c.Query("SELECT version, name, state, url, description, coalesce(key_id, 0), extract(epoch FROM updated_at)::bigint FROM checks WHERE repo_id = {repoId} AND change_id = {ch} ORDER BY version, name")
	mut out = []Check{}
	for x in rows.Rows {
		out = append(out, Check{Version: x[0].Int(), Name: x[1].Text(), State: x[2].Text(), Url: x[3].Text(), Description: x[4].Text(), KeyId: x[5].Int(), Updated: x[6].Int()})
	}
	return out
}

// Missing is the required checks that have not passed on a change's version: each "name state" ("name none" when
// it was never posted).
fn Missing(c postgres.Client, repoId i64, ch str, version i64, required []str) ![]str {
	mut out = []str{}
	if len(required) == 0 {
		return out
	}
	let rows = try c.Query("SELECT name, state FROM checks WHERE repo_id = {repoId} AND change_id = {ch} AND version = {version}::int")
	mut states = map[str]str{}
	for x in rows.Rows {
		states[x[0].Text()] = x[1].Text()
	}
	for name in required {
		let (s, ok) = states[name]
		if !ok {
			out = append(out, name + " none")
		} else if s != "success" {
			out = append(out, name + " " + s)
		}
	}
	return out
}
