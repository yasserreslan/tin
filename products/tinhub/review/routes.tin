package review

import "../../tit/transport"
import "../accounts"
import "anvil"
import "argo"
import "fault"
import "mint"
import "postgres"
import "tide"
import "twine"

// The review API, JSON under /api/v1/repos/<owner>/<repo>:
//
//   GET   changes/<change>/review            the review: state, target, newest version, votes counted, checks, and
//                                             why it cannot land yet ("" when it can)
//   PATCH changes/<change>/review            {"state": "abandoned"|"open"}: the change's author or a writer
//   GET   changes/<change>/comments          every comment, with its anchor now and whether it is outdated
//   POST  changes/<change>/comments          {"body", "file", "decl", "line_offset", "version", "parent"}
//   PATCH changes/<change>/comments/<id>     {"resolved": bool}: the comment's author or a writer
//   GET   changes/<change>/approvals         every vote
//   POST  changes/<change>/approvals         {"vote": "approve"|"changes"} on the newest version
//   GET   changes/<change>/checks            every check, by version
//   POST  changes/<change>/checks            {"name", "state", "url", "description", "version"}: signed with a tit key
//                                             (Tit-Signature; unsigned, the 401 carries a nonce), write access
//   POST  changes/<change>/land              {"stack": bool}: write access; 200 and what landed, or 409 and why not
//   GET   reviews?state=                     the repository's reviews, newest first
//   GET   review/settings, PUT (admin)       {"approvals": N, "checks": [names]}
//
// A request signed with Tit-Signature is its signer's; any other is Deps.Auth's (a session). A repository the caller
// cannot read is 404. Errors are {"code", "message"}.

// Mount adds the review routes to r.
fn Mount(r mut anvil.Router) {
	r.Get(`/api/v1/repos/{owner}/{repo}/changes/{change}/review`, getReview)
	r.Patch(`/api/v1/repos/{owner}/{repo}/changes/{change}/review`, patchReview)
	r.Get(`/api/v1/repos/{owner}/{repo}/changes/{change}/comments`, getComments)
	r.Post(`/api/v1/repos/{owner}/{repo}/changes/{change}/comments`, postComment)
	r.Patch(`/api/v1/repos/{owner}/{repo}/changes/{change}/comments/{id}`, patchComment)
	r.Get(`/api/v1/repos/{owner}/{repo}/changes/{change}/approvals`, getApprovals)
	r.Post(`/api/v1/repos/{owner}/{repo}/changes/{change}/approvals`, postApproval)
	r.Get(`/api/v1/repos/{owner}/{repo}/changes/{change}/checks`, getChecks)
	r.Post(`/api/v1/repos/{owner}/{repo}/changes/{change}/checks`, postCheck)
	r.Post(`/api/v1/repos/{owner}/{repo}/changes/{change}/land`, postLand)
	r.Get(`/api/v1/repos/{owner}/{repo}/reviews`, getReviews)
	r.Get(`/api/v1/repos/{owner}/{repo}/review/settings`, getSettings)
	r.Put(`/api/v1/repos/{owner}/{repo}/review/settings`, putSettings)
}

// The budgets (design/tinhub.md §8); a landing rebases and packs, so it has more.
const readWithin = 2 * tide.Second

const writeWithin = 5 * tide.Second

const landWithin = 60 * tide.Second

type apiError struct {
	code    str
	message str
}

// nonceError is a refused signature's answer: a fresh nonce to sign the next attempt with.
type nonceError struct {
	code    str
	message str
	nonce   str
}

fn fail_(w mut anvil.Out, status i64, code str, message str) {
	w.Status(status)
	w.Json()
	w.Body = []u8{}
	argo.Put(mut w.Body, apiError{code: code, message: message})
}

fn send[T](w mut anvil.Out, v T) {
	w.Json()
	w.Body = []u8{}
	argo.Put(mut w.Body, v)
}

fn now() i64 {
	return tide.Wall() / tide.Second
}

// call is a request's context: its caller, their role and key (a signed request), and the repository.
type call struct {
	d     Deps
	user  i64
	key   i64
	role  i64
	r     accounts.Repo
}

// unsigned answers 401 with a nonce to sign with.
fn unsigned(w mut anvil.Out, d Deps, message str) {
	w.Status(401)
	w.Json()
	w.Body = []u8{}
	argo.Put(mut w.Body, nonceError{code: "unauthorized", message: message, nonce: Nonce(d.NonceKey, now())})
}

// begin authenticates a request (its signature, else Deps.Auth), finds the repository (404 when the caller cannot
// read it) and checks the role need; nil when the answer is written already.
fn begin(q anvil.Req, w mut anvil.Out, need i64) ?call {
	let got = deps
	if got == nil {
		fail_(mut w, 503, "unavailable", "reviews are not configured on this core")
		return nil
	}
	let d = got
	mut user = 0
	mut key = 0
	let sig = q.Header("tit-signature")
	if len(sig) > 0 {
		let s = VerifyKey(d.Db, d.NonceKey, q.Method, q.Path, sig, q.Body(), now()) catch err {
			unsigned(mut w, d, fault.Message(err))
			return nil
		}
		user = s.User.Id
		key = s.KeyId
	} else {
		let auth = d.Auth
		user = auth(q) catch err {
			fail_(mut w, 401, "unauthorized", fault.Message(err))
			return nil
		}
	}
	let owner = q.PathParam("owner")
	let name = q.PathParam("repo")
	let found = accounts.FindRepo(d.Db, owner, name) catch err {
		fail_(mut w, 503, "unavailable", fault.Message(err))
		return nil
	}
	if found == nil {
		fail_(mut w, 404, "not_found", "no repository {owner}/{name}")
		return nil
	}
	let role = accounts.RoleOf(d.Db, user, found) catch err {
		fail_(mut w, 503, "unavailable", fault.Message(err))
		return nil
	}
	if role == accounts.RoleNone {
		fail_(mut w, 404, "not_found", "no repository {owner}/{name}")
		return nil
	}
	if role < need {
		if user == 0 {
			fail_(mut w, 401, "unauthorized", "sign in to do that")
			return nil
		}
		fail_(mut w, 403, "forbidden", "that takes {accounts.RoleName(need)} access to {owner}/{name}")
		return nil
	}
	return call{d: d, user: user, key: key, role: role, r: found}
}

// answerErr answers a fault with its status.
fn answerErr(w mut anvil.Out, err fault) {
	let m = fault.Message(err)
	if fault.Is(err, ErrNotFound) {
		fail_(mut w, 404, "not_found", m)
	} else if fault.Is(err, ErrInvalid) {
		fail_(mut w, 422, "invalid", m)
	} else if fault.Is(err, ErrForbidden) {
		fail_(mut w, 403, "forbidden", m)
	} else if fault.Is(err, ErrConflict) {
		fail_(mut w, 409, "conflict", m)
	} else if fault.Is(err, ErrNotReady) {
		fail_(mut w, 409, "not_ready", m)
	} else if fault.Is(err, fault.DeadlineExceeded) {
		fail_(mut w, 503, "timeout", m)
	} else {
		fail_(mut w, 503, "unavailable", m)
	}
}

// decode reads a JSON body into v; false (answered 400) when it is not one.
fn decode[T](q anvil.Req, w mut anvil.Out, v mut T) bool {
	if len(q.Body()) == 0 {
		return true
	}
	argo.Get(q.Body(), mut v) catch err {
		fail_(mut w, 400, "bad_request", fault.Message(err))
		return false
	}
	return true
}

// ---- the review ----

type tallyOut struct {
	approvals i64
	blocking  i64
	needed    i64
}

type checkOut struct {
	version     i64
	name        str
	state       str
	url         str
	description str
	key_id      i64
	updated_at  i64
}

type reviewOut struct {
	change        str
	state         str
	target        str
	opened_by     i64
	version       i64
	commit        str
	created_at    i64
	updated_at    i64
	landed_at     i64
	landed_commit str
	landed_by     i64
	votes         tallyOut
	required      []str
	checks        []checkOut
	blocked       str
	// below is the changes under this one that have not landed, bottom first; stack_blocked is why the stack (those
	// and this one) cannot land yet, "" when it can
	below         []str
	stack_blocked str
	// opened_by_name and landed_by_name are those users' names, for pages ("" for none)
	opened_by_name str
	landed_by_name str
}

fn checksOut(cs []Check) []checkOut {
	mut out = []checkOut{}
	for c in cs {
		out = append(out, checkOut{version: c.Version, name: c.Name, state: c.State, url: c.Url, description: c.Description, key_id: c.KeyId, updated_at: c.Updated})
	}
	return out
}

// nameOf is a user's name, "" for none.
fn nameOf(db postgres.Client, user i64) !str {
	if user <= 0 {
		return ""
	}
	let rows = try db.Query("SELECT o.name FROM users u JOIN owners o ON o.id = u.owner_id WHERE u.id = {user}")
	if len(rows.Rows) == 0 {
		return ""
	}
	return rows.Rows[0][0].Text()
}

fn reviewOf(c call, ch str) !reviewOut {
	mut out ?reviewOut = nil
	try within readWithin + 0 {
		let rv = try Open(c.d.Db, c.r.Id, ch)
		let t = try TallyOf(c.d.Db, c.r, ch)
		let s = try SettingsOf(c.d.Db, c.r.Id)
		let cs = try Checks(c.d.Db, c.r.Id, ch)
		mut blocked = ""
		if rv.State == StateLanded || rv.State == StateAbandoned {
			blocked = "the review is " + rv.State
		} else {
			blocked = try Readiness(c.d.Db, c.r, ch, rv.Version)
		}
		mut below = []str{}
		mut stackBlocked = blocked
		if rv.State != StateLanded && rv.State != StateAbandoned {
			let (order, serr) = StackBelow(c.r.Id, ch)
			if serr != nil {
				if len(stackBlocked) == 0 {
					stackBlocked = fault.Message(serr)
				}
			} else {
				below = order[0:len(order) - 1]
			}
			for b in below {
				if len(stackBlocked) > 0 {
					break
				}
				let brv = try Open(c.d.Db, c.r.Id, b)
				let why = try Readiness(c.d.Db, c.r, b, brv.Version)
				if len(why) > 0 {
					stackBlocked = "{b} below it: {why}"
				}
			}
			if len(blocked) == 0 && len(below) > 0 {
				blocked = "{below[len(below) - 1]} below it has not landed: land it first, or land the stack"
			}
		}
		let opener = try nameOf(c.d.Db, rv.OpenedBy)
		let lander = try nameOf(c.d.Db, rv.LandedBy)
		out = keep(reviewOut{change: ch, state: rv.State, target: rv.Target, opened_by: rv.OpenedBy, version: rv.Version, commit: rv.Commit, created_at: rv.Created, updated_at: rv.Updated, landed_at: rv.Landed, landed_commit: rv.LandedAt, landed_by: rv.LandedBy, votes: tallyOut{approvals: t.Approvals, blocking: t.Blocking, needed: t.Needed}, required: s.Checks, checks: checksOut(cs), blocked: blocked, below: below, stack_blocked: stackBlocked, opened_by_name: opener, landed_by_name: lander})
	}
	if out == nil {
		fail fault.Wrap(ErrNotFound, "no change {ch}")
	}
	return out
}

fn getReview(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, accounts.RoleRead)
	if c == nil {
		return
	}
	let (out, err) = reviewOf(c, q.PathParam("change"))
	if err != nil {
		answerErr(mut w, err)
		return
	}
	send(mut w, out)
}

type stateIn_ struct {
	state str
}

fn patchReview(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, accounts.RoleRead)
	if c == nil {
		return
	}
	mut v = stateIn_{state: ""}
	if !decode(q, mut w, mut v) {
		return
	}
	let ch = q.PathParam("change")
	let err = setState(c, ch, v.state)
	if err != nil {
		answerErr(mut w, err)
		return
	}
	let (out, rerr) = reviewOf(c, ch)
	if rerr != nil {
		answerErr(mut w, rerr)
		return
	}
	send(mut w, out)
}

fn setState(c call, ch str, state str) ! {
	try within writeWithin + 0 {
		_ = try SetState(c.d.Db, c.r, ch, c.user, state)
	}
}

// ---- comments ----

type commentOut struct {
	id          i64
	author      i64
	author_name str
	parent      i64
	version     i64
	written_on  i64
	file        str
	decl        str
	line_offset i64
	line        i64
	body        str
	outdated    bool
	resolved    bool
	created_at  i64
}

type commentsOut struct {
	comments []commentOut
}

fn getComments(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, accounts.RoleRead)
	if c == nil {
		return
	}
	let (out, err) = readComments(c, q.PathParam("change"))
	if err != nil {
		answerErr(mut w, err)
		return
	}
	send(mut w, out)
}

fn readComments(c call, ch str) !commentsOut {
	mut out = commentsOut{comments: []commentOut{}}
	try within readWithin + 0 {
		_ = try Open(c.d.Db, c.r.Id, ch)
		let cs = try Comments(c.r.Id, ch)
		mut list = []commentOut{}
		for x in cs {
			list = append(list, commentOut{id: x.Id, author: x.Author, author_name: x.Name, parent: x.Parent, version: x.Version, written_on: x.Written, file: x.File, decl: x.Decl, line_offset: x.Offset, line: x.Line, body: x.Body, outdated: x.Outdated, resolved: x.Resolved, created_at: x.Created})
		}
		out = keep(commentsOut{comments: list})
	}
	return out
}

type commentIn_ struct {
	body        str
	file        str
	decl        str
	line_offset i64
	version     i64
	parent      i64
}

type idOut struct {
	id i64
}

fn postComment(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, accounts.RoleRead)
	if c == nil {
		return
	}
	if c.user == 0 {
		fail_(mut w, 401, "unauthorized", "sign in to comment")
		return
	}
	mut v = commentIn_{body: "", file: "", decl: "", line_offset: 0, version: 0, parent: 0}
	if !decode(q, mut w, mut v) {
		return
	}
	let (id, err) = addComment(c, q.PathParam("change"), v)
	if err != nil {
		answerErr(mut w, err)
		return
	}
	w.Status(201)
	send(mut w, idOut{id: id})
}

fn addComment(c call, ch str, v commentIn_) !i64 {
	mut id = 0
	try within writeWithin + 0 {
		id = try AddComment(c.r.Id, ch, c.user, NewComment{Version: v.version, File: v.file, Decl: v.decl, Offset: v.line_offset, Parent: v.parent, Body: v.body})
	}
	return id
}

type resolveIn struct {
	resolved bool
}

fn patchComment(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, accounts.RoleRead)
	if c == nil {
		return
	}
	let raw = q.PathParam("id")
	let id = mint.Atoi(raw) catch _ {
		fail_(mut w, 404, "not_found", "no comment {raw}")
		return
	}
	mut v = resolveIn{resolved: true}
	if !decode(q, mut w, mut v) {
		return
	}
	let err = resolve(c, q.PathParam("change"), id, v.resolved)
	if err != nil {
		answerErr(mut w, err)
		return
	}
	w.Status(204)
}

fn resolve(c call, ch str, id i64, resolved bool) ! {
	try within writeWithin + 0 {
		let author = try AuthorOf(c.r.Id, ch, id)
		if c.role < accounts.RoleWrite && (c.user == 0 || author != c.user) {
			fail fault.Wrap(ErrForbidden, "only the comment's author or a writer can resolve it")
		}
		_ = try Resolve(c.r.Id, ch, id, resolved)
	}
}

// ---- approvals ----

type voteOut struct {
	user    i64
	name    str
	version i64
	vote    str
	at      i64
}

type votesOut struct {
	votes   []voteOut
	counted tallyOut
}

fn getApprovals(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, accounts.RoleRead)
	if c == nil {
		return
	}
	let (out, err) = readVotes(c, q.PathParam("change"))
	if err != nil {
		answerErr(mut w, err)
		return
	}
	send(mut w, out)
}

fn readVotes(c call, ch str) !votesOut {
	mut out = votesOut{votes: []voteOut{}, counted: tallyOut{approvals: 0, blocking: 0, needed: 0}}
	try within readWithin + 0 {
		_ = try Open(c.d.Db, c.r.Id, ch)
		let vs = try Votes(c.d.Db, c.r.Id, ch)
		let t = try TallyOf(c.d.Db, c.r, ch)
		mut list = []voteOut{}
		for v in vs {
			list = append(list, voteOut{user: v.User, name: v.Name, version: v.Version, vote: v.Vote, at: v.At})
		}
		out = keep(votesOut{votes: list, counted: tallyOut{approvals: t.Approvals, blocking: t.Blocking, needed: t.Needed}})
	}
	return out
}

type voteIn struct {
	vote str
}

fn postApproval(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, accounts.RoleRead)
	if c == nil {
		return
	}
	if c.user == 0 {
		fail_(mut w, 401, "unauthorized", "sign in to vote")
		return
	}
	mut v = voteIn{vote: ""}
	if !decode(q, mut w, mut v) {
		return
	}
	let ch = q.PathParam("change")
	let err = vote(c, ch, v.vote)
	if err != nil {
		answerErr(mut w, err)
		return
	}
	let (out, rerr) = reviewOf(c, ch)
	if rerr != nil {
		answerErr(mut w, rerr)
		return
	}
	send(mut w, out)
}

fn vote(c call, ch str, v str) ! {
	try within writeWithin + 0 {
		_ = try Vote(c.d.Db, c.r, ch, c.user, v)
	}
}

// ---- checks ----

type checksList struct {
	checks []checkOut
}

fn getChecks(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, accounts.RoleRead)
	if c == nil {
		return
	}
	let (out, err) = readChecks(c, q.PathParam("change"))
	if err != nil {
		answerErr(mut w, err)
		return
	}
	send(mut w, out)
}

fn readChecks(c call, ch str) !checksList {
	mut out = checksList{checks: []checkOut{}}
	try within readWithin + 0 {
		_ = try Open(c.d.Db, c.r.Id, ch)
		let cs = try Checks(c.d.Db, c.r.Id, ch)
		out = keep(checksList{checks: checksOut(cs)})
	}
	return out
}

type checkIn_ struct {
	version     i64
	name        str
	state       str
	url         str
	description str
}

fn postCheck(q anvil.Req, w mut anvil.Out) {
	let got = deps
	if got == nil {
		fail_(mut w, 503, "unavailable", "reviews are not configured on this core")
		return
	}
	if len(q.Header("tit-signature")) == 0 {
		unsigned(mut w, got, "a check is signed with a tit key (Tit-Signature)")
		return
	}
	let c = begin(q, mut w, accounts.RoleWrite)
	if c == nil {
		return
	}
	mut v = checkIn_{version: 0, name: "", state: "", url: "", description: ""}
	if !decode(q, mut w, mut v) {
		return
	}
	let (out, err) = postCheck_(c, q.PathParam("change"), v)
	if err != nil {
		answerErr(mut w, err)
		return
	}
	w.Status(201)
	send(mut w, out)
}

fn postCheck_(c call, ch str, v checkIn_) !checkOut {
	mut out ?checkOut = nil
	try within writeWithin + 0 {
		let k = try PostCheck(c.r.Id, ch, c.key, Check{Version: v.version, Name: v.name, State: v.state, Url: v.url, Description: v.description, KeyId: 0, Updated: 0})
		out = keep(checkOut{version: k.Version, name: k.Name, state: k.State, url: k.Url, description: k.Description, key_id: k.KeyId, updated_at: k.Updated})
	}
	if out == nil {
		fail "no check"
	}
	return out
}

// ---- landing ----

type landIn_ struct {
	stack bool
}

type landedOut struct {
	change  str
	version i64
	commit  str
	rebased bool
}

type landOut struct {
	landed  []landedOut
	code    str
	message str
}

fn postLand(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, accounts.RoleWrite)
	if c == nil {
		return
	}
	mut v = landIn_{stack: false}
	if !decode(q, mut w, mut v) {
		return
	}
	let ch = q.PathParam("change")
	let res = land(c, ch, v.stack)
	mut out = landOut{landed: []landedOut{}, code: "", message: ""}
	for l in res.Landed {
		out.landed = append(out.landed, landedOut{change: l.Change, version: l.Version, commit: l.Commit, rebased: l.Rebased})
	}
	let err = res.Err
	if err != nil {
		let m = fault.Message(err)
		out.message = m
		if fault.Is(err, ErrNotFound) {
			w.Status(404)
			out.code = "not_found"
		} else if fault.Is(err, ErrConflict) {
			w.Status(409)
			out.code = "conflict"
		} else if fault.Is(err, ErrNotReady) {
			w.Status(409)
			out.code = "not_ready"
		} else if fault.Is(err, transport.ErrRefused) {
			w.Status(409)
			out.code = "refused"
		} else {
			w.Status(503)
			out.code = "unavailable"
		}
	}
	send(mut w, out)
}

fn land(c call, ch str, withStack bool) LandResult {
	let (res, err) = landWithin_(c, ch, withStack)
	if err != nil {
		return LandResult{Landed: []Landed{}, Err: err}
	}
	return res
}

fn landWithin_(c call, ch str, withStack bool) !LandResult {
	mut out = LandResult{Landed: []Landed{}, Err: nil}
	try within landWithin + 0 {
		let got = Land(c.r.Id, ch, c.user, withStack)
		out = keep(got)
	}
	return out
}

// ---- the repository's reviews and settings ----

type listItem struct {
	change     str
	state      str
	target     str
	version    i64
	updated_at i64
	// commit is the newest version's commit, opened_by the name of who opened the review ("" when unknown)
	commit     str
	opened_by  str
	created_at i64
}

type listOut struct {
	reviews []listItem
}

fn getReviews(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, accounts.RoleRead)
	if c == nil {
		return
	}
	let state = q.Param("state")
	let (out, err) = listReviews(c, state)
	if err != nil {
		answerErr(mut w, err)
		return
	}
	send(mut w, out)
}

fn listReviews(c call, state str) !listOut {
	mut out = listOut{reviews: []listItem{}}
	let repoId = c.r.Id
	try within readWithin + 0 {
		let rows = try c.d.Db.Query("SELECT r.change_id, r.state, r.target, coalesce(v.version, 0), extract(epoch FROM r.updated_at)::bigint, coalesce(v.commit_id, ''), coalesce(o.name, ''), extract(epoch FROM r.created_at)::bigint FROM reviews r LEFT JOIN LATERAL (SELECT version, commit_id FROM changes x WHERE x.repo_id = r.repo_id AND x.change_id = r.change_id ORDER BY version DESC LIMIT 1) v ON true LEFT JOIN users u ON u.id = r.opened_by LEFT JOIN owners o ON o.id = u.owner_id WHERE r.repo_id = {repoId} AND ({state} = '' OR r.state = {state}) ORDER BY r.updated_at DESC, r.change_id LIMIT 200")
		mut list = []listItem{}
		for x in rows.Rows {
			list = append(list, listItem{change: x[0].Text(), state: x[1].Text(), target: x[2].Text(), version: x[3].Int(), updated_at: x[4].Int(), commit: x[5].Text(), opened_by: x[6].Text(), created_at: x[7].Int()})
		}
		out = keep(listOut{reviews: list})
	}
	return out
}

type settingsOut struct {
	approvals i64
	checks    []str
}

fn getSettings(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, accounts.RoleRead)
	if c == nil {
		return
	}
	let s = SettingsOf(c.d.Db, c.r.Id) catch err {
		answerErr(mut w, err)
		return
	}
	send(mut w, settingsOut{approvals: s.Approvals, checks: s.Checks})
}

fn putSettings(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, accounts.RoleAdmin)
	if c == nil {
		return
	}
	mut v = settingsOut{approvals: 1, checks: []str{}}
	if !decode(q, mut w, mut v) {
		return
	}
	let names = twine.Join(v.checks, ",")
	SetSettings(c.d.Db, c.r.Id, c.user, Settings{Approvals: v.approvals, Checks: splitComma(names)}) catch err {
		answerErr(mut w, err)
		return
	}
	send(mut w, v)
}
