package review

import "../../tit/diff"
import "../../tit/object"
import "../../tit/semantic"
import "../../tit/store"
import "fault"
import "sift"
import "twine"

// The server's rebase for landing: tit's own (products/tit/stack Pick over products/tit/merge), ported here because
// tit/merge imports tit/index, and a program cannot hold two packages named index (E113: tinhub's symbol index is
// one). It is tit's three-way merge without the rename step (a file one side renamed and the other edited conflicts
// here, where tit would follow the rename): each name takes the side that changed it, directories merge recursively,
// files line by line (diff3), and a Tin file whose line merge conflicts merges again one declaration at a time.

// pick is commit c's change replayed onto the commit onto, as a new version of c's change by committer: the merged
// trees and blobs are written to s, and the paths that do not merge are returned (the landing is then refused).
fn pick(s mut store.Layered, c object.Id, onto object.Id, committer object.Person) !(object.CommitData, []str) {
	let cd = try commitData(mut s, c)
	let target = try commitData(mut s, onto)
	mut base = object.NoId
	if len(cd.Parents) > 0 {
		let p = try commitData(mut s, cd.Parents[0])
		base = p.Tree
	}
	mut conflicts = []str{}
	let tree = try mergeDir(mut s, "", base, target.Tree, cd.Tree, mut conflicts)
	let out = object.CommitData{Tree: tree, Parents: []object.Id{onto}, Change: cd.Change, Author: cd.Author, Committer: committer, GitHeaders: []str{}, Signature: "", Message: cd.Message, Conflicts: []str{}}
	return out, conflicts
}

fn commitData(s mut store.Layered, id object.Id) !object.CommitData {
	let o = try s.Get(id)
	return match o {
		Commit(c) => c
		Tree(_) => try notCommit(id)
		Tag(_) => try notCommit(id)
		Blob(_) => try notCommit(id)
	}
}

fn notCommit(id object.Id) !object.CommitData {
	fail fault.Wrap(object.ErrCorrupt, "{id.Hex()} is not a commit")
}

// ---- trees ----

fn sameEntry(a ?object.Entry, b ?object.Entry) bool {
	if a == nil || b == nil {
		return a == nil && b == nil
	}
	return a.Mode == b.Mode && a.Id == b.Id
}

fn entriesOf(s mut store.Layered, id object.Id) !map[str]object.Entry {
	mut out = map[str]object.Entry{}
	if id == object.NoId {
		return out
	}
	let o = try s.Get(id)
	match o {
		Tree(es) => {
			for e in es {
				out[e.Name] = e
			}
		}
		Blob(_) => {
			fail fault.Wrap(object.ErrCorrupt, "{id.Hex()} is not a tree")
		}
		Commit(_) => {
			fail fault.Wrap(object.ErrCorrupt, "{id.Hex()} is not a tree")
		}
		Tag(_) => {
			fail fault.Wrap(object.ErrCorrupt, "{id.Hex()} is not a tree")
		}
	}
	return out
}

fn isDir(e ?object.Entry) bool {
	return e != nil && e.Mode == object.Mode.Dir
}

fn isBinary(b str) bool {
	for i in 0..min(len(b), 8000) {
		if b[i] == 0 {
			return true
		}
	}
	return false
}

fn blobOf(s mut store.Layered, e ?object.Entry) !str {
	if e == nil {
		return ""
	}
	let (_, body) = try s.GetRaw(e.Id)
	return body
}

fn idOf(e ?object.Entry) object.Id {
	if e == nil {
		return object.NoId
	}
	return e.Id
}

fn treeKey(e object.Entry) str {
	return match e.Mode {
		Dir => e.Name + "/"
		File, Exec, Link => e.Name
	}
}

fn mergeDir(s mut store.Layered, path str, base object.Id, ours object.Id, theirs object.Id, conflicts mut []str) !object.Id {
	let b = try entriesOf(mut s, base)
	let o = try entriesOf(mut s, ours)
	let t = try entriesOf(mut s, theirs)
	mut names = map[str]bool{}
	for n, _ in b {
		names[n] = true
	}
	for n, _ in o {
		names[n] = true
	}
	for n, _ in t {
		names[n] = true
	}
	mut sorted = []str{}
	for name, _ in names {
		sorted = append(sorted, name)
	}
	sift.Sort(mut sorted)
	mut out = []object.Entry{}
	for name in sorted {
		mut be ?object.Entry = nil
		mut oe ?object.Entry = nil
		mut te ?object.Entry = nil
		let (bv, bok) = b[name]
		if bok {
			be = bv
		}
		let (ov, ook) = o[name]
		if ook {
			oe = ov
		}
		let (tv, tok) = t[name]
		if tok {
			te = tv
		}
		let full = path + name
		mut chosen ?object.Entry = nil
		if sameEntry(oe, te) || sameEntry(te, be) {
			chosen = oe
		} else if sameEntry(oe, be) {
			chosen = te
		} else if isDir(oe) && isDir(te) {
			mut bsub = object.NoId
			if isDir(be) {
				bsub = idOf(be)
			}
			let sub = try mergeDir(mut s, full + "/", bsub, idOf(oe), idOf(te), mut conflicts)
			chosen = object.Entry{Mode: object.Mode.Dir, Name: name, Id: sub}
		} else if oe != nil && te != nil && !isDir(oe) && !isDir(te) {
			chosen = try mergeFile(mut s, full, be, oe, te, mut conflicts)
		} else if (oe == nil || isDir(oe)) && (te == nil || isDir(te)) && (be == nil || isDir(be)) {
			mut bsub = object.NoId
			if isDir(be) {
				bsub = idOf(be)
			}
			let sub = try mergeDir(mut s, full + "/", bsub, idOf(oe), idOf(te), mut conflicts)
			let left = try entriesOf(mut s, sub)
			if len(left) > 0 {
				chosen = object.Entry{Mode: object.Mode.Dir, Name: name, Id: sub}
			}
		} else {
			// deleted on one side and changed on the other, or a file against a directory
			conflicts = append(conflicts, full)
			chosen = oe
			if chosen == nil {
				chosen = te
			}
		}
		if chosen != nil {
			out = append(out, chosen)
		}
	}
	sift.SortFunc(mut out, fn(x object.Entry, y object.Entry) i64 {
		let kx = treeKey(x)
		let ky = treeKey(y)
		if kx < ky {
			return -1
		}
		if kx > ky {
			return 1
		}
		return 0
	})
	return try s.Put(object.Object.Tree(out))
}

fn mergeFile(s mut store.Layered, path str, be ?object.Entry, oe object.Entry, te object.Entry, conflicts mut []str) !object.Entry {
	mut mode = oe.Mode
	mut modeOk = true
	if be != nil {
		if oe.Mode == be.Mode {
			mode = te.Mode
		} else if te.Mode != be.Mode && te.Mode != oe.Mode {
			modeOk = false
		}
	} else if oe.Mode != te.Mode {
		modeOk = false
	}
	if oe.Id == te.Id {
		if !modeOk {
			conflicts = append(conflicts, path)
		}
		return object.Entry{Mode: mode, Name: oe.Name, Id: oe.Id}
	}
	let bb = try blobOf(mut s, be)
	let ob = try blobOf(mut s, oe)
	let tb = try blobOf(mut s, te)
	if mode == object.Mode.Link || isBinary(bb) || isBinary(ob) || isBinary(tb) {
		conflicts = append(conflicts, path)
		return oe
	}
	mut (text, clean) = mergeText(bb, ob, tb)
	if !clean && twine.HasSuffix(path, ".tin") {
		let (dt, dok) = mergeTin(bb, ob, tb)
		if dok {
			text = dt
			clean = true
		}
	}
	if !clean || !modeOk {
		conflicts = append(conflicts, path)
		return oe
	}
	let id = try s.PutRaw(object.Kind.Blob, text)
	return object.Entry{Mode: mode, Name: oe.Name, Id: id}
}

// ---- lines (diff3) ----

fn keptIn(es []diff.Edit, nbase i64) []i64 {
	mut out = make([]i64, nbase)
	for i in 0..nbase {
		out[i] = -1
	}
	mut i = 0
	mut j = 0
	for e in es {
		match e {
			Keep(n) => {
				for k in 0..n {
					out[i + k] = j + k
				}
				i += n
				j += n
			}
			Insert(n) => {
				j += n
			}
			Delete(n) => {
				i += n
			}
		}
	}
	return out
}

fn sameLines(a []str, b []str) bool {
	if len(a) != len(b) {
		return false
	}
	for i in 0..len(a) {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

// mergeText merges ours and theirs, both changed from base, line by line; clean is false when a stretch both sides
// changed differently does not combine (the text is then not used).
fn mergeText(base str, ours str, theirs str) (str, bool) {
	let bl = diff.Lines(base)
	let ol = diff.Lines(ours)
	let tl = diff.Lines(theirs)
	let ko = keptIn(diff.Diff(bl, ol), len(bl))
	let kt = keptIn(diff.Diff(bl, tl), len(bl))
	mut out = []u8{}
	mut i = 0
	mut o = 0
	mut t = 0
	for i < len(bl) || o < len(ol) || t < len(tl) {
		if i < len(bl) && ko[i] == o && kt[i] == t {
			out = append(out, []u8(bl[i])...)
			i += 1
			o += 1
			t += 1
			continue
		}
		mut i2 = i
		for i2 < len(bl) && (ko[i2] < 0 || kt[i2] < 0) {
			i2 += 1
		}
		mut o2 = len(ol)
		mut t2 = len(tl)
		if i2 < len(bl) {
			o2 = ko[i2]
			t2 = kt[i2]
		}
		let b = bl[i:i2]
		let x = ol[o:o2]
		let y = tl[t:t2]
		if sameLines(x, b) {
			for l in y {
				out = append(out, []u8(l)...)
			}
		} else if sameLines(y, b) || sameLines(x, y) {
			for l in x {
				out = append(out, []u8(l)...)
			}
		} else {
			return "", false
		}
		i = i2
		o = o2
		t = t2
	}
	return str(out), true
}

// ---- Tin files by declaration ----

// mergeTin merges three versions of a Tin file one top-level declaration at a time (tit's MergeTin): ok is false when
// they do not merge that way.
fn mergeTin(base str, ours str, theirs str) (str, bool) {
	let (bd, bok) = semantic.Decls(base)
	let (od, ook) = semantic.Decls(ours)
	let (td, tok) = semantic.Decls(theirs)
	if !bok || !ook || !tok {
		return "", false
	}
	let bc = chunksOf(base, bd)
	let oc = chunksOf(ours, od)
	let tc = chunksOf(theirs, td)
	let bm = chunksByKey(bd, bc)
	let om = chunksByKey(od, oc)
	let tm = chunksByKey(td, tc)
	if len(bm) != len(bd) || len(om) != len(od) || len(tm) != len(td) {
		return "", false
	}
	let (pre, preClean) = mergeText(bc[0], oc[0], tc[0])
	let (post, postClean) = mergeText(bc[len(bc) - 1], oc[len(oc) - 1], tc[len(tc) - 1])
	if !preClean || !postClean {
		return "", false
	}
	mut order = []str{}
	for d in od {
		order = append(order, d.Key)
	}
	for i in 0..len(td) {
		let k = td[i].Key
		let (_, inOurs) = om[k]
		let (_, inBase) = bm[k]
		if inOurs || inBase {
			continue
		}
		mut at = 0
		for j in 0..i {
			for p in 0..len(order) {
				if order[p] == td[i - 1 - j].Key && at == 0 {
					at = p + 1
				}
			}
			if at > 0 {
				break
			}
		}
		for at < len(order) {
			let (_, ob) = bm[order[at]]
			let (_, ot) = tm[order[at]]
			if ob || ot {
				break
			}
			at += 1
		}
		mut next = []str{}
		for p in 0..len(order) {
			if p == at {
				next = append(next, k)
			}
			next = append(next, order[p])
		}
		if at >= len(order) {
			next = append(next, k)
		}
		order = next
	}
	mut out = pre
	for k in order {
		let (b, inB) = bm[k]
		let (o, inO) = om[k]
		let (t, inT) = tm[k]
		if inO && inT {
			if o == t || (inB && t == b) {
				out = out + o
			} else if inB && o == b {
				out = out + t
			} else if inB {
				let (text, clean) = mergeText(b, o, t)
				if !clean {
					return "", false
				}
				out = out + text
			} else {
				return "", false
			}
		} else if inO {
			if inB {
				if o != b {
					return "", false
				}
				continue
			}
			out = out + o
		} else if inT {
			if inB {
				if t != b {
					return "", false
				}
				continue
			}
			out = out + t
		}
	}
	return out + post, true
}

fn chunksOf(text str, ds []semantic.Decl) []str {
	mut lines = []str{}
	mut from = 0
	for i in 0..len(text) {
		if text[i] == '\n' {
			lines = append(lines, text[from:i + 1])
			from = i + 1
		}
	}
	if from < len(text) {
		lines = append(lines, text[from:])
	}
	mut out = []str{}
	mut at = ds[0].Line - 1
	out = append(out, joinLines(lines[0:at]))
	for d in ds {
		mut end = d.Line - 1 + len(twine.Split(d.Text, "\n"))
		if end > len(lines) {
			end = len(lines)
		}
		out = append(out, joinLines(lines[at:end]))
		at = end
	}
	out = append(out, joinLines(lines[at:]))
	return out
}

fn joinLines(ls []str) str {
	mut b = []u8{}
	for l in ls {
		b = append(b, []u8(l)...)
	}
	return str(b)
}

fn chunksByKey(ds []semantic.Decl, chunks []str) map[str]str {
	mut m = map[str]str{}
	for i in 0..len(ds) {
		m[ds[i].Key] = chunks[i + 1]
	}
	return m
}
