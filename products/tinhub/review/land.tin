package review

import "../../tit/object"
import "../../tit/packfile"
import "../../tit/store"
import "../../tit/transport"
import "../accounts"
import "../capsules"
import "../packs"
import "../repo"
import "fault"
import "postgres"
import "tide"
import "twine"

// Landing runs on the server. A change lands on its review's target (the repository's default branch when the review
// was opened), bottom-up through its stack: the changes below it (each one's newest version is the parent of the
// next) land first, and a change lands only once every change below it has. For each change: its newest version is
// rebased onto the target's current commit when its parent is not that commit (rebase.tin's pick, tit's stack.Pick;
// written as a new version of the change; a conflict refuses the landing), its votes and required checks are checked again under the
// repository's lock, the target moves by compare-and-swap through repo.PgRepo's CommitTx (one move per change), and in
// the same transaction the review is marked landed and capsules.ChangeLanded runs on the change's message. When the
// target moved between the rebase and the swap, the change is rebased again (three tries).

// Landed is one change landed: the version that went onto the target (a new one when it was rebased) and its commit.
type Landed struct {
	Change  str
	Version i64
	Commit  str
	Rebased bool
}

// LandResult is what a landing did: the changes landed, in order, and why it stopped (nil when every change landed).
type LandResult struct {
	Landed []Landed
	Err    fault
}

// maxStack bounds how many changes one landing walks down.
const maxStack = 50

// tries is how many times a change is rebased again when the target moves under it.
const tries = 3

// StackBelow is the changes to land for ch, bottom first, ch last: each change whose newest version is the parent of
// the one above, down to a change already landed or a commit that is no change's.
fn StackBelow(repoId i64, ch str) ![]str {
	let d = try current()
	mut out = []str{ch}
	mut cur = ch
	mut r = try pgRepo(repoId, 0)
	mut st = try r.Objects()
	for i in 0..maxStack {
		let rv = try Open(d.Db, repoId, cur)
		let cd = try commitOf(mut st, rv.Commit)
		if len(cd.Parents) == 0 {
			break
		}
		let parent = cd.Parents[0].Hex()
		let rows = try d.Db.Query("SELECT change_id FROM changes WHERE repo_id = {repoId} AND commit_id = {parent} AND change_id <> {cur} ORDER BY version DESC LIMIT 1")
		if len(rows.Rows) == 0 {
			break
		}
		let below = rows.Rows[0][0].Text()
		let brv = try Open(d.Db, repoId, below)
		if brv.State == StateLanded {
			break
		}
		if brv.State == StateAbandoned {
			fail fault.Wrap(ErrNotReady, "{cur} is on {below}, which is abandoned")
		}
		if brv.Commit != parent {
			fail fault.Wrap(ErrNotReady, "{cur} is on an old version of {below}: push the stack again")
		}
		out = append([]str{below}, out...)
		cur = below
	}
	return out
}

// Land lands ch by user by: with stack, every change below it first; without, ch alone, refused while a change below
// it has not landed.
fn Land(repoId i64, ch str, by i64, withStack bool) LandResult {
	mut res = LandResult{Landed: []Landed{}, Err: nil}
	let (order, err) = StackBelow(repoId, ch)
	if err != nil {
		res.Err = err
		return res
	}
	if !withStack && len(order) > 1 {
		res.Err = fault.Wrap(ErrNotReady, "{order[len(order) - 2]} below {ch} has not landed: land it first, or land the stack")
		return res
	}
	for c in order {
		let (l, lerr) = landOne(repoId, c, by)
		if lerr != nil {
			res.Err = lerr
			return res
		}
		res.Landed = append(res.Landed, l)
	}
	return res
}

// landOne lands one change whose changes below have landed, rebasing it again when the target moves under it.
fn landOne(repoId i64, ch str, by i64) !Landed {
	mut last fault = nil
	for i in 0..tries {
		let (l, err) = tryLand(repoId, ch, by)
		if err == nil {
			return l
		}
		if !twine.Contains(fault.Message(err), "RefChanged") {
			fail err
		}
		last = err
	}
	fail fault.Wrap(ErrConflict, "{ch}: the target kept moving: {fault.Message(last)}")
}

// Readiness is why a change cannot land yet: "" when its votes and required checks let it.
fn Readiness(c postgres.Client, r accounts.Repo, ch str, version i64) !str {
	let t = try TallyOf(c, r, ch)
	if t.Blocking > 0 {
		return "{t.Blocking} writer(s) requested changes"
	}
	if t.Approvals < t.Needed {
		return "{t.Approvals} of {t.Needed} approvals"
	}
	let s = try SettingsOf(c, r.Id)
	let missing = try Missing(c, r.Id, ch, version, s.Checks)
	if len(missing) > 0 {
		return "required checks have not passed: " + twine.Join(missing, ", ")
	}
	return ""
}

// committerOf is the person a landing's rebased commits are made by.
fn committerOf(c postgres.Client, by i64) !object.Person {
	let u = try accounts.UserById(c, by)
	let now = tide.Wall() / tide.Second
	if u == nil {
		return object.Person{Name: "tinhub", Email: "tinhub@localhost", When: now, Zone: 0}
	}
	return object.Person{Name: u.Name, Email: u.Email, When: now, Zone: 0}
}

// plan is how a change lands: the target's commit it goes on, the commit that goes there, and the pack that brings a
// rebased one ("" for none).
type plan struct {
	target  str
	old     str
	from    str
	commit  str
	rebased bool
	pack    str
	message str
}

fn tryLand(repoId i64, ch str, by i64) !Landed {
	let d = try current()
	let found = try accounts.RepoById(d.Db, repoId)
	if found == nil {
		fail fault.Wrap(ErrNotFound, "no repository {repoId}")
	}
	let rp = found
	let rv = try Open(d.Db, repoId, ch)
	if rv.State == StateLanded {
		fail fault.Wrap(ErrConflict, "{ch} has landed")
	}
	if rv.State == StateAbandoned {
		fail fault.Wrap(ErrNotReady, "{ch} is abandoned")
	}
	let why = try Readiness(d.Db, rp, ch, rv.Version)
	if len(why) > 0 {
		fail fault.Wrap(ErrNotReady, "{ch}: {why}")
	}
	let p = try planOf(repoId, rv, by)
	mut r = try pgRepo(repoId, by)
	mut tx = try d.Db.Begin()
	let (version, err) = landIn(mut tx, r, rp, rv, p, by)
	if err != nil {
		rollback(mut tx)
		if len(p.pack) > 0 {
			_ = r.Drop(transport.Staged{Name: p.pack}) catch _ {
				false
			}
		}
		fail err
	}
	try tx.Commit()
	r.Moved()
	return Landed{Change: ch, Version: version, Commit: p.commit, Rebased: p.rebased}
}

// planOf reads the target and, when the change's newest version is not on it, rebases the version onto it and stages
// the pack of what the rebase wrote.
fn planOf(repoId i64, rv Review, by i64) !plan {
	let d = try current()
	let name = rv.Target
	let refs = try d.Db.Query("SELECT target FROM refs WHERE repo_id = {repoId} AND name = {name}")
	if len(refs.Rows) == 0 {
		fail fault.Wrap(ErrNotReady, "the target {name} does not exist")
	}
	let old = refs.Rows[0][0].Text()
	if len(old) != 64 {
		fail fault.Wrap(ErrNotReady, "the target {name} is {old}, not a commit")
	}
	mut r = try pgRepo(repoId, by)
	mut st = try r.Objects()
	let cd = try commitOf(mut st, rv.Commit)
	if len(cd.Conflicts) > 0 {
		fail fault.Wrap(ErrConflict, "{rv.Change} version {rv.Version} records conflicts")
	}
	mut parent = ""
	if len(cd.Parents) > 0 {
		parent = cd.Parents[0].Hex()
	}
	if parent == old {
		return plan{target: name, old: old, from: rv.Commit, commit: rv.Commit, rebased: false, pack: "", message: cd.Message}
	}
	let committer = try committerOf(d.Db, by)
	let mem = store.NewMem()
	let first dyn store.ObjectStore = mem
	mut lay = st.Under(first)
	let nid = try object.ParseId(rv.Commit)
	let tid = try object.ParseId(old)
	let (picked, paths) = try pick(mut lay, nid, tid, committer)
	if len(paths) > 0 {
		fail fault.Wrap(ErrConflict, "{rv.Change} does not rebase onto {name} ({old[0:12]}): conflicts in " + twine.Join(paths, ", "))
	}
	let id = try lay.Put(object.Object.Commit(picked))
	let ids = try mem.Match("")
	let pk = try packfile.Write(mut lay, ids, r.TempDir())
	let staged = try r.Stage(pk.Path)
	return plan{target: name, old: old, from: rv.Commit, commit: id.Hex(), rebased: true, pack: staged.Name, message: cd.Message}
}

// landIn moves the target and marks the review landed in tx, under the repository's lock: the review, the change's
// newest version, its votes and checks are read again there first. It returns the version that landed.
fn landIn(tx mut postgres.Tx, r repo.PgRepo, rp accounts.Repo, rv Review, p plan, by i64) !i64 {
	let d = try current()
	let repoId = rp.Id
	let ch = rv.Change
	try packs.Lock(mut tx, repoId)
	let st = try tx.Query("SELECT state FROM reviews WHERE repo_id = {repoId} AND change_id = {ch} FOR UPDATE")
	if len(st.Rows) == 0 || st.Rows[0][0].Text() == StateLanded || st.Rows[0][0].Text() == StateAbandoned {
		fail fault.Wrap(ErrConflict, "{ch} has landed or was abandoned meanwhile")
	}
	let newest = try tx.Query("SELECT commit_id, version FROM changes WHERE repo_id = {repoId} AND change_id = {ch} ORDER BY version DESC LIMIT 1")
	if newest.Rows[0][0].Text() != p.from {
		fail fault.Wrap(ErrConflict, "a new version of {ch} arrived: review it, then land it")
	}
	let why = try Readiness(d.Db, rp, ch, rv.Version)
	if len(why) > 0 {
		fail fault.Wrap(ErrNotReady, "{ch}: {why}")
	}
	mut who = ""
	let u = try accounts.UserById(d.Db, by)
	if u != nil {
		who = u.Email
	}
	mut changes = []transport.ChangeUpdate{}
	if p.rebased {
		changes = append(changes, transport.ChangeUpdate{Change: ch, Replaces: p.from, Commit: p.commit})
	}
	let refs = []transport.RefUpdate{transport.RefUpdate{Name: p.target, Old: p.old, New: p.commit}}
	_ = try r.CommitTx(mut tx, transport.Update{Who: who, Command: "land", Changes: changes, Refs: refs, Pack: p.pack, Time: tide.Wall()})
	mut version = newest.Rows[0][1].Int()
	if p.rebased {
		version += 1
	}
	let commit = p.commit
	_ = try tx.Exec("UPDATE reviews SET state = 'landed', landed_at = now(), updated_at = now(), landed_commit = {commit}, landed_by = nullif({by}, 0) WHERE repo_id = {repoId} AND change_id = {ch}")
	_ = try capsules.ChangeLanded(mut tx, repoId, ch, p.message)
	try announce(mut tx, repoId, KindLanded, ch, version, by, StateLanded, commit)
	return version
}
