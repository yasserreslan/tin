package workers

import "../../tit/git"
import "../../tit/object"
import "../../tit/packfile"
import "../../tit/store"
import "../../tit/transport"
import "../db"
import "../events"
import "../packs"
import "../repo"
import "crucible"
import "fault"
import "postgres"
import "quarry"
import "seal"
import "twine"

// Tests for the repository workers (#1014) against Postgres (TINHUB_TEST_DB; skipped without it): repack, prune,
// purge, the push fan-out and mirroring into a local git directory. The crash points are tests/workers.sh's.

fn testDb(t mut crucible.T) ?postgres.Client {
	let (o, ok) = db.TestOptions()
	if !ok {
		t.Log("TINHUB_TEST_DB is not set: skipped")
		return nil
	}
	let c = db.Open(o)
	db.ResetForTests(c) catch err {
		t.Error("reset: {err}")
		return nil
	}
	_ = db.Migrate(c) catch err {
		t.Error("migrate: {err}")
		return nil
	}
	return c
}

// fixture is a repository with its Deps and the client's objects.
type fixture struct {
	d    Deps
	r    repo.PgRepo
	objs store.Mem
}

fn newFixture(c postgres.Client, name str) !fixture {
	let o = try c.Query("INSERT INTO owners (name, kind) VALUES ({name}, 'user') RETURNING id")
	let owner = o.Rows[0][0].Int()
	let rr = try c.Query("INSERT INTO repos (owner_id, name, visibility, quota_bytes) VALUES ({owner}, 'tin', 'public', 1000000000) RETURNING id")
	let id = rr.Rows[0][0].Int()
	let dir = "/tmp/tin-test-tinhub-workers-" + name + "-" + seal.Hex(seal.RandomBytes(4))
	let s = try packs.NewDirStore(dir + "/store")
	let st dyn packs.PackStore = s
	mut d = NewDeps(c, st, dir, 16)
	d.LocalMirrors = true
	return fixture{d: d, r: d.repoOf(id), objs: store.NewMem()}
}

fn person(when i64) object.Person {
	return object.Person{Name: "Ada", Email: "ada@example.com", When: when, Zone: 0}
}

// commitIn writes a commit of one file into s.
fn commitIn(s mut store.Mem, name str, body str, parents []object.Id, cid object.ChangeId, when i64) object.Id {
	let blob = s.PutRaw(object.Kind.Blob, body) catch _ {
		object.NoId
	}
	let tree = s.Put(object.Object.Tree([]object.Entry{object.Entry{Mode: object.Mode.File, Name: name, Id: blob}})) catch _ {
		object.NoId
	}
	let c = object.CommitData{Tree: tree, Parents: parents, Change: cid, Author: person(when), Committer: person(when), GitHeaders: []str{}, Signature: "", Message: "{name}\n", Conflicts: []str{}}
	return s.Put(object.Object.Commit(c)) catch _ {
		object.NoId
	}
}

// everything is a commit, its tree and the tree's entries.
fn everything(s mut store.Mem, id object.Id) []object.Id {
	mut out = []object.Id{id}
	let o = s.Get(id) catch _ {
		return out
	}
	match o {
		Commit(c) => {
			out = append(out, c.Tree)
			let t = s.Get(c.Tree) catch _ {
				return out
			}
			match t {
				Tree(es) => {
					for e in es {
						out = append(out, e.Id)
					}
				}
				Commit(_) => {
				}
				Tag(_) => {
				}
				Blob(_) => {
				}
			}
		}
		Tree(_) => {
		}
		Tag(_) => {
		}
		Blob(_) => {
		}
	}
	return out
}

fn treeBlob(s mut store.Mem, id object.Id) object.Id {
	let all = everything(mut s, id)
	if len(all) < 3 {
		return object.NoId
	}
	return all[2]
}

// push stages a pack of ids and commits it with the ref moves and versions given.
fn push(f mut fixture, ids []object.Id, refs []transport.RefUpdate, changes []transport.ChangeUpdate) !str {
	let p = try packfile.Write(mut f.objs, ids, f.r.TempDir())
	let st = try f.r.Stage(p.Path)
	_ = try f.r.Commit(transport.Update{Who: "ada@example.com", Command: "push", Changes: changes, Refs: refs, Pack: st.Name, Time: 1700000000000000000})
	return st.Name
}

fn move(name str, old object.Id, next object.Id) transport.RefUpdate {
	mut o = ""
	if old != object.NoId {
		o = old.Hex()
	}
	mut n = ""
	if next != object.NoId {
		n = next.Hex()
	}
	return transport.RefUpdate{Name: name, Old: o, New: n}
}

fn version(cid object.ChangeId, replaces object.Id, commit object.Id) transport.ChangeUpdate {
	mut was = ""
	if replaces != object.NoId {
		was = replaces.Hex()
	}
	return transport.ChangeUpdate{Change: cid.Letters(), Replaces: was, Commit: commit.Hex()}
}

// history pushes four commits of one change to main, one pack each, and points refs/heads/old at the second.
fn history(f mut fixture) ![]object.Id {
	let cid = object.NewChangeId()
	mut commits = []object.Id{}
	mut prev = object.NoId
	for i in 0..4 {
		mut parents = []object.Id{}
		if prev != object.NoId {
			parents = append(parents, prev)
		}
		let c = commitIn(mut f.objs, "a.txt", "version {i}\n", parents, cid, 1700000000 + i)
		mut refs = []transport.RefUpdate{move("refs/heads/main", prev, c)}
		if i == 1 {
			refs = append(refs, move("refs/heads/old", object.NoId, c))
		}
		_ = try push(mut f, everything(mut f.objs, c), refs, []transport.ChangeUpdate{version(cid, prev, c)})
		commits = append(commits, c)
		prev = c
	}
	return commits
}

// whole reports what a ref reaches that the live packs lack ("" when every ref's history is there).
fn whole(f mut fixture) str {
	let refs = f.r.Refs("refs/") catch err {
		return "refs: {err}"
	}
	mut st = f.r.Objects() catch err {
		return "objects: {err}"
	}
	for ref in refs {
		mut todo = []object.Id{}
		match ref.Target {
			Commit(id) => {
				todo = append(todo, id)
			}
			Change(_) => {
			}
		}
		for len(todo) > 0 {
			let id = todo[len(todo) - 1]
			todo = todo[0:len(todo) - 1]
			let o = st.Get(id) catch err {
				return "{ref.Name} reaches {id.Hex()[0:12]}, missing: {fault.Message(err)}"
			}
			match o {
				Commit(c) => {
					todo = append(todo, c.Tree)
					for p in c.Parents {
						todo = append(todo, p)
					}
				}
				Tree(es) => {
					for e in es {
						todo = append(todo, e.Id)
					}
				}
				Tag(tg) => {
					todo = append(todo, tg.Object)
				}
				Blob(_) => {
				}
			}
		}
	}
	return ""
}

fn liveCount(c postgres.Client, id i64) i64 {
	let live = packs.Live(c, id) catch _ {
		return -1
	}
	return len(live)
}

fn stateOf(c postgres.Client, id i64, hash str) str {
	let rows = c.Query("SELECT state FROM packs WHERE repo_id = {id} AND hash = {hash}") catch _ {
		return "error"
	}
	if len(rows.Rows) == 0 {
		return "none"
	}
	return rows.Rows[0][0].Text()
}

fn handler(d Deps, kind str) ?events.Handler {
	for h in Handlers(d) {
		if h.Kind == kind {
			return h
		}
	}
	return nil
}

fn job(id i64, kind str, repoId i64, payload str) events.Job {
	return events.Job{Id: id, Kind: kind, RepoId: repoId, Payload: payload, Attempts: 1}
}

// TestRepack: four packs merged into one through the repack job, every ref still whole, the old packs retired, and a
// second repack changes nothing.
fn TestRepack(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	mut f = newFixture(got, "ada") catch err {
		t.Error("fixture: {err}")
		return
	}
	let _ = history(mut f) catch err {
		t.Error("history: {err}")
		return
	}
	let before = packs.Live(got, f.r.Id) catch _ {
		[]str{}
	}
	crucible.Equal(mut t, "four live packs", len(before), 4)
	let h = handler(f.d, KindRepack)
	if h == nil {
		t.Error("no repack handler")
		return
	}
	let run = h.Run
	let err = run(job(1, KindRepack, f.r.Id, "{{}}"))
	t.True("the repack job: {err}", err == nil)
	crucible.Equal(mut t, "one live pack", liveCount(got, f.r.Id), 1)
	for hash in before {
		crucible.Equal(mut t, "{hash[0:12]} retired", stateOf(got, f.r.Id, hash), "retired")
	}
	crucible.Equal(mut t, "every ref whole after the repack", whole(mut f), "")
	let after = packs.Live(got, f.r.Id) catch _ {
		[]str{}
	}
	let again = Repack(mut f.d, f.r.Id) catch err {
		t.Error("repack again: {err}")
		return
	}
	crucible.Equal(mut t, "a second repack retires nothing", again, 0)
	let still = packs.Live(got, f.r.Id) catch _ {
		[]str{}
	}
	t.True("the same pack is live", len(still) == 1 && len(after) == 1 && still[0] == after[0])
	quarry.RemoveAll(f.d.Dir) catch _ {
	}
}

// TestRepackRerun: a repack that died after making its pack live and before retiring (the new pack live beside the
// old ones) is finished by the next run, which writes the same pack again and retires the rest.
fn TestRepackRerun(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	mut f = newFixture(got, "bob") catch err {
		t.Error("fixture: {err}")
		return
	}
	let _ = history(mut f) catch err {
		t.Error("history: {err}")
		return
	}
	// the first half of a repack, by hand: merged, staged and made live, nothing retired
	let ps = f.r.Packs() catch err {
		t.Error("packs: {err}")
		return
	}
	mut paths = []str{}
	for k in 0..len(ps) {
		paths = append(paths, ps[len(ps) - 1 - k].Path)
	}
	let merged = packfile.Merge(paths, f.r.TempDir()) catch err {
		t.Error("merge: {err}")
		return
	}
	let st = f.r.Stage(merged.Path) catch err {
		t.Error("stage: {err}")
		return
	}
	_ = f.r.Commit(transport.Update{Who: "", Command: "repack", Changes: []transport.ChangeUpdate{}, Refs: []transport.RefUpdate{}, Pack: st.Name, Time: 1}) catch err {
		t.Error("commit: {err}")
		0
	}
	crucible.Equal(mut t, "five live packs after the half repack", liveCount(got, f.r.Id), 5)
	let n = Repack(mut f.d, f.r.Id) catch err {
		t.Error("repack: {err}")
		return
	}
	crucible.Equal(mut t, "the rerun retires the four", n, 4)
	let live = packs.Live(got, f.r.Id) catch _ {
		[]str{}
	}
	t.True("the half repack's pack is the one live: {live}", len(live) == 1 && live[0] == st.Name)
	crucible.Equal(mut t, "every ref whole", whole(mut f), "")
	quarry.RemoveAll(f.d.Dir) catch _ {
	}
}

// TestPrune: a deleted branch's commit goes, while everything a ref or an open change reaches stays; a young pack is
// kept whole; a second prune removes nothing.
fn TestPrune(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	mut f = newFixture(got, "cy") catch err {
		t.Error("fixture: {err}")
		return
	}
	let commits = history(mut f) catch err {
		t.Error("history: {err}")
		return
	}
	// a leak: pushed to a branch of its own as a change of its own, then the branch deleted
	let leakChange = object.NewChangeId()
	let leak = commitIn(mut f.objs, "leaked.txt", "password=hunter2\n", []object.Id{}, leakChange, 1700000100)
	let leakBlob = treeBlob(mut f.objs, leak)
	_ = push(mut f, everything(mut f.objs, leak), []transport.RefUpdate{move("refs/heads/leak", object.NoId, leak)}, []transport.ChangeUpdate{version(leakChange, object.NoId, leak)}) catch err {
		t.Error("push leak: {err}")
		""
	}
	_ = f.r.Commit(transport.Update{Who: "", Command: "push", Changes: []transport.ChangeUpdate{}, Refs: []transport.RefUpdate{move("refs/heads/leak", leak, object.NoId)}, Pack: "", Time: 1}) catch err {
		t.Error("delete leak: {err}")
		0
	}
	// a change under review: a ref names it, and its versions reach nothing else
	let reviewed = object.NewChangeId()
	let v1 = commitIn(mut f.objs, "b.txt", "under review\n", []object.Id{commits[3]}, reviewed, 1700000200)
	_ = push(mut f, everything(mut f.objs, v1), []transport.RefUpdate{transport.RefUpdate{Name: "refs/changes/review", Old: "", New: "change " + reviewed.Letters()}}, []transport.ChangeUpdate{version(reviewed, object.NoId, v1)}) catch err {
		t.Error("push review: {err}")
		""
	}
	// young: nothing removed within the retention
	let young = Prune(mut f.d, f.r.Id, f.d.Retention) catch err {
		t.Error("prune young: {err}")
		return
	}
	crucible.Equal(mut t, "a prune within the retention removes nothing", young.Objects, 0)
	let h = handler(f.d, KindPrune)
	if h == nil {
		t.Error("no prune handler")
		return
	}
	let run = h.Run
	let err = run(job(7, KindPrune, f.r.Id, "{{\"retention_secs\":0}}"))
	t.True("the prune job: {err}", err == nil)
	mut st = f.r.Objects() catch err {
		t.Error("objects: {err}")
		return
	}
	t.True("the leaked commit is gone", !st.Has(leak))
	t.True("the leaked blob is gone", !st.Has(leakBlob))
	t.True("the reviewed change's version stays", st.Has(v1) && st.Has(treeBlob(mut f.objs, v1)))
	for c in commits {
		t.True("{c.Hex()[0:12]} stays", st.Has(c))
	}
	crucible.Equal(mut t, "every ref whole", whole(mut f), "")
	let again = Prune(mut f.d, f.r.Id, 0) catch err {
		t.Error("prune again: {err}")
		return
	}
	crucible.Equal(mut t, "a second prune removes nothing", again.Objects, 0)
	crucible.Equal(mut t, "and retires nothing", again.Packs, 0)
	quarry.RemoveAll(f.d.Dir) catch _ {
	}
}

// TestPurge: an object nothing reaches is removed from the live pack and every retired pack that held it (their files
// deleted), with audit rows; an object a ref reaches is refused and recorded.
fn TestPurge(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	mut f = newFixture(got, "di") catch err {
		t.Error("fixture: {err}")
		return
	}
	let commits = history(mut f) catch err {
		t.Error("history: {err}")
		return
	}
	// a blob pushed with a commit's objects but reached by nothing
	let leaked = f.objs.PutRaw(object.Kind.Blob, "AKIA-very-leaked\n") catch _ {
		object.NoId
	}
	let cid = object.NewChangeId()
	let c5 = commitIn(mut f.objs, "a.txt", "five\n", []object.Id{commits[3]}, cid, 1700000300)
	mut ids = everything(mut f.objs, c5)
	ids = append(ids, leaked)
	let p5 = push(mut f, ids, []transport.RefUpdate{move("refs/heads/main", commits[3], c5)}, []transport.ChangeUpdate{version(cid, object.NoId, c5)}) catch err {
		t.Error("push: {err}")
		return
	}
	// repacked: the leaked is in the live pack and in p5, now retired
	_ = Repack(mut f.d, f.r.Id) catch err {
		t.Error("repack: {err}")
		0
	}
	let merged = packs.Live(got, f.r.Id) catch _ {
		[]str{}
	}
	crucible.Equal(mut t, "p5 retired", stateOf(got, f.r.Id, p5), "retired")
	let ev = RequestPurge(got, f.r.Id, 0, []str{leaked.Hex()}, "a leaked key", "127.0.0.1") catch err {
		t.Error("request: {err}")
		return
	}
	let h = handler(f.d, KindPurge)
	if h == nil {
		t.Error("no purge handler")
		return
	}
	let rows = got.Query("SELECT payload::text FROM events WHERE id = {ev}") catch err {
		t.Error("event: {err}")
		return
	}
	let run = h.Run
	let err = run(job(ev, KindPurge, f.r.Id, rows.Rows[0][0].Text()))
	t.True("the purge job: {err}", err == nil)
	mut st = f.r.Objects() catch err {
		t.Error("objects: {err}")
		return
	}
	t.True("the leaked is in no live pack", !st.Has(leaked))
	t.True("main's objects stay", st.Has(c5) && st.Has(treeBlob(mut f.objs, c5)))
	crucible.Equal(mut t, "every ref whole", whole(mut f), "")
	crucible.Equal(mut t, "p5's row is gone", stateOf(got, f.r.Id, p5), "none")
	crucible.Equal(mut t, "the merged pack's row is gone", stateOf(got, f.r.Id, merged[0]), "none")
	let keys = f.d.Store.List("repos/{f.r.Id}/") catch _ {
		[]str{}
	}
	for k in keys {
		t.True("{k} is not a purged pack's", !twine.Contains(k, p5) && !twine.Contains(k, merged[0]))
		if twine.HasSuffix(k, ".pack") {
			let path = f.d.Store.Local(k)
			if path != nil {
				let p = packfile.Open(path) catch _ {
					continue
				}
				t.True("{k} does not hold the leaked", !p.Has(leaked))
			}
		}
	}
	let audit = got.Query("SELECT action FROM audit_log WHERE target_kind = 'repo' AND target_id = {f.r.Id} ORDER BY id") catch err {
		t.Error("audit: {err}")
		return
	}
	t.True("requested and done, once each", len(audit.Rows) == 2 && audit.Rows[0][0].Text() == "repo.purge.requested" && audit.Rows[1][0].Text() == "repo.purge")
	// run again (at least once delivery): nothing to do, no second row
	let again = run(job(ev, KindPurge, f.r.Id, rows.Rows[0][0].Text()))
	t.True("the purge job again: {again}", again == nil)
	let audit2 = got.Query("SELECT count(*) FROM audit_log WHERE action = 'repo.purge'") catch err {
		t.Error("audit: {err}")
		return
	}
	crucible.Equal(mut t, "one purge row", audit2.Rows[0][0].Int(), 1)
	// a reachable object is refused, and the refusal recorded
	let reached = treeBlob(mut f.objs, commits[0])
	let (_, rerr) = Purge(mut f.d, f.r.Id, []str{reached.Hex()})
	t.True("a reachable object is refused: {rerr}", rerr != nil && fault.Is(rerr, ErrReachable) && twine.Contains(fault.Message(rerr), "refs/heads/"))
	let ev2 = RequestPurge(got, f.r.Id, 0, []str{reached.Hex()}, "oops", "") catch err {
		t.Error("request 2: {err}")
		return
	}
	let p2 = "{{\"objects\":[\"" + reached.Hex() + "\"],\"actor\":0,\"reason\":\"oops\"}}"
	let refused = run(job(ev2, KindPurge, f.r.Id, p2))
	t.True("a refused purge is done, not retried: {refused}", refused == nil)
	let rr = got.Query("SELECT count(*) FROM audit_log WHERE action = 'repo.purge.refused'") catch err {
		t.Error("audit: {err}")
		return
	}
	crucible.Equal(mut t, "the refusal recorded", rr.Rows[0][0].Int(), 1)
	let st2 = f.r.Objects() catch err {
		t.Error("objects: {err}")
		return
	}
	t.True("the reachable object stays", st2.Has(reached))
	let (_, bad) = RequestPurge(got, f.r.Id, 0, []str{"nope"}, "", "")
	t.True("a bad id is refused", bad != nil && fault.Is(bad, ErrBadId))
	quarry.RemoveAll(f.d.Dir) catch _ {
	}
}

// TestPushFanOut: a push queues a repack past repack.packs, a mirror when there is one, and each follow-up kind once;
// a fan-out run again queues nothing more.
fn TestPushFanOut(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	mut f = newFixture(got, "eve") catch err {
		t.Error("fixture: {err}")
		return
	}
	f.d.RepackPacks = 3
	f.d.Follows = []str{"index"}
	let _ = history(mut f) catch err {
		t.Error("history: {err}")
		return
	}
	_ = got.Exec("INSERT INTO mirrors (repo_id, url) VALUES ({f.r.Id}, 'https://example.com/ada/tin.git')") catch err {
		t.Error("mirror row: {err}")
		postgres.Result{Affected: 0}
	}
	let pushes = got.Query("SELECT id, payload::text FROM events WHERE kind = 'push' AND repo_id = {f.r.Id} ORDER BY id") catch err {
		t.Error("pushes: {err}")
		return
	}
	crucible.Equal(mut t, "four push events", len(pushes.Rows), 4)
	let h = handler(f.d, KindPush)
	if h == nil {
		t.Error("no push handler")
		return
	}
	let run = h.Run
	for row in pushes.Rows {
		let err = run(job(row[0].Int(), KindPush, f.r.Id, row[1].Text()))
		t.True("fan-out: {err}", err == nil)
	}
	let last = pushes.Rows[3]
	let err = run(job(last[0].Int(), KindPush, f.r.Id, last[1].Text()))
	t.True("fan-out again: {err}", err == nil)
	let kinds = got.Query("SELECT kind, count(*) FROM events WHERE repo_id = {f.r.Id} AND kind <> 'push' GROUP BY kind ORDER BY kind") catch err {
		t.Error("kinds: {err}")
		return
	}
	mut seen = ""
	for row in kinds.Rows {
		seen = seen + row[0].Text() + "=" + "{row[1].Int()} "
	}
	crucible.Equal(mut t, "queued", seen, "index=4 mirror=1 repack=1 review.diff=4 ")
	let idx = got.Query("SELECT count(*) FROM events WHERE kind = 'index' AND (payload->>'push')::bigint = {last[0].Int()} AND payload->>'pack' <> ''") catch err {
		t.Error("index: {err}")
		return
	}
	crucible.Equal(mut t, "the index job carries the push", idx.Rows[0][0].Int(), 1)
	let n = SchedulePrune(got) catch err {
		t.Error("schedule: {err}")
		return
	}
	crucible.Equal(mut t, "a nightly prune queued", n, 1)
	let n2 = SchedulePrune(got) catch err {
		t.Error("schedule: {err}")
		return
	}
	crucible.Equal(mut t, "and only one", n2, 0)
	quarry.RemoveAll(f.d.Dir) catch _ {
	}
}

// TestMirror: the branches written into a local git directory as git objects, a commit made in tit with its Change-Id
// line; a second run writes nothing new.
fn TestMirror(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	mut f = newFixture(got, "fay") catch err {
		t.Error("fixture: {err}")
		return
	}
	let commits = history(mut f) catch err {
		t.Error("history: {err}")
		return
	}
	let gitDir = f.d.Dir + "/target.git"
	bareGit(gitDir) catch err {
		t.Error("bare: {err}")
		return
	}
	_ = got.Exec("INSERT INTO mirrors (repo_id, url) VALUES ({f.r.Id}, {gitDir})") catch err {
		t.Error("mirror row: {err}")
		postgres.Result{Affected: 0}
	}
	let h = handler(f.d, KindMirror)
	if h == nil {
		t.Error("no mirror handler")
		return
	}
	let run = h.Run
	let err = run(job(1, KindMirror, f.r.Id, "{{}}"))
	t.True("the mirror job: {err}", err == nil)
	let target = git.Open(gitDir) catch err {
		t.Error("open: {err}")
		return
	}
	let refs = target.Refs() catch err {
		t.Error("refs: {err}")
		return
	}
	mut names = []str{}
	mut mainId = ""
	for r in refs {
		names = append(names, r.Name)
		if r.Name == "refs/heads/main" {
			mainId = r.Id
		}
	}
	let sep = " "
	crucible.Equal(mut t, "the branches", twine.Join(names, sep), "refs/heads/main refs/heads/old")
	if len(mainId) != 20 {
		t.Error("main is not mirrored")
		return
	}
	let (kind, body) = target.Read(mainId) catch err {
		t.Error("read main: {err}")
		return
	}
	t.True("main is a commit with its Change-Id", kind == object.Kind.Commit && twine.Contains(body, "Change-Id: " + commitChange(mut f.objs, commits[3])))
	let again = Mirror(mut f.d, f.r.Id) catch err {
		t.Error("mirror again: {err}")
		return
	}
	crucible.Equal(mut t, "a second mirror writes nothing", again.Objects, 0)
	let row = got.Query("SELECT (mirrored_at IS NOT NULL)::int, last_error FROM mirrors WHERE repo_id = {f.r.Id}") catch err {
		t.Error("row: {err}")
		return
	}
	t.True("recorded", row.Rows[0][0].Int() == 1 && row.Rows[0][1].Text() == "")
	// a local directory is refused unless the worker allows it
	f.d.LocalMirrors = false
	let (_, lerr) = Mirror(mut f.d, f.r.Id)
	t.True("a local mirror refused: {lerr}", lerr != nil && fault.Is(lerr, ErrMirrorUrl))
	quarry.RemoveAll(f.d.Dir) catch _ {
	}
}

fn commitChange(s mut store.Mem, id object.Id) str {
	let o = s.Get(id) catch _ {
		return ""
	}
	return match o {
		Commit(c) => c.Change.Letters()
		Tree(_) => ""
		Tag(_) => ""
		Blob(_) => ""
	}
}
