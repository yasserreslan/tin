package workers

import "../../tit/packfile"
import "../../tit/store"
import "../events"
import "../packs"
import "../repo"
import "postgres"
import "tide"
import "tinjson"
import "twine"

// The repository workers (design/tinhub.md §6, #1014): the handlers of the push event's fan-out and of the repack,
// prune, purge and mirror jobs. Each is idempotent (delivery is at least once) and crash safe: a pack is written,
// staged and made live before the packs it replaces are retired, so a job that dies at any point leaves every ref
// reaching live objects, and running it again finishes the work.

// The kinds these handlers run.
const KindPush = "push"

const KindRepack = "repack"

const KindPrune = "prune"

const KindPurge = "purge"

const KindMirror = "mirror"

// DefaultRetention is how long prune keeps the objects of a pack after it went live, whatever reaches them: 30 days
// in ns, as tit's prune keeps what its oplog names.
const DefaultRetention = 30 * 24 * 3600 * 1000000000

// Deps is what the handlers need: the primary, the pack store, the node's packs.dir and the settings of the jobs.
type Deps struct {
	Db    postgres.Client
	Store dyn packs.PackStore
	// Dir is packs.dir: tmp/ holds packs being written, cache/ copies of the store's packs, mirror/<repo>/ each
	// mirror's git directory and git-ids table (rebuilt from the packs when lost).
	Dir str
	// RepackPacks is repack.packs: a push queues a repack once the repository has more live packs than this.
	RepackPacks i64
	// Retention is how long (ns) prune keeps every object of a pack that went live since, reachable or not.
	Retention i64
	// Follows are the kinds the push handler queues for every push, with the push's payload: the hook for index
	// (#1020), review.diff and overlap (#1021), notify and webhook (#1023) and bench (#1029), each added here once its
	// handler is registered with the worker.
	Follows []str
	// LocalMirrors lets a mirror's url be a local git directory (tests, a git server on the same host); otherwise a
	// mirror must be http(s).
	LocalMirrors bool
}

// NewDeps is Deps with the defaults: DefaultRetention, no follow-up kinds and http(s) mirrors only.
fn NewDeps(c postgres.Client, s dyn packs.PackStore, dir str, repackPacks i64) Deps {
	return Deps{Db: c, Store: s, Dir: twine.TrimRight(dir, "/"), RepackPacks: repackPacks, Retention: DefaultRetention, Follows: []str{}, LocalMirrors: false}
}

// Handlers is every handler of this package, with the budgets of design/tinhub.md §6.
fn Handlers(d Deps) []events.Handler {
	return []events.Handler{
		events.Handler{Kind: KindPush, Within: 30 * tide.Second, Memory: 32 * 1024 * 1024, Tasks: 4, MaxAttempts: 10, Run: fn(j events.Job) ! {
			try runPush(d, j)
		}},
		events.Handler{Kind: KindRepack, Within: 10 * tide.Minute, Memory: 512 * 1024 * 1024, Tasks: 4, MaxAttempts: 10, Run: fn(j events.Job) ! {
			mut dd = d
			_ = try Repack(mut dd, j.RepoId)
		}},
		events.Handler{Kind: KindPrune, Within: 30 * tide.Minute, Memory: 512 * 1024 * 1024, Tasks: 4, MaxAttempts: 10, Run: fn(j events.Job) ! {
			mut dd = d
			try runPrune(mut dd, j)
		}},
		events.Handler{Kind: KindPurge, Within: 30 * tide.Minute, Memory: 512 * 1024 * 1024, Tasks: 4, MaxAttempts: 10, Run: fn(j events.Job) ! {
			mut dd = d
			try runPurge(mut dd, j)
		}},
		events.Handler{Kind: KindMirror, Within: 10 * tide.Minute, Memory: 256 * 1024 * 1024, Tasks: 4, MaxAttempts: 10, Run: fn(j events.Job) ! {
			mut dd = d
			_ = try Mirror(mut dd, j.RepoId)
		}},
	}
}

// repoOf is the repository as a PgRepo. The workers move no refs, so it reads Postgres, not the ref cache.
fn (d mut Deps) repoOf(id i64) repo.PgRepo {
	return repo.PgRepo{Db: d.Db, Store: d.Store, Cache: repo.NoCache(), Id: id, Dir: d.Dir, Who: 0}
}

// packName is the name (hash) of the pack at path: its file name without .pack.
fn packName(path str) str {
	let slash = twine.LastIndex(path, "/")
	mut name = path[slash + 1:]
	if twine.HasSuffix(name, ".pack") {
		name = name[0:len(name) - 5]
	}
	return name
}

// layered is one store of the packs' objects.
fn layered(ps []packfile.Pack) store.Layered {
	mut layers = []dyn store.ObjectStore{}
	for p in ps {
		layers = append(layers, p)
	}
	return store.NewLayered(layers)
}

// payloadOf is a job's payload, parsed; an empty object when it is not JSON.
fn payloadOf(j events.Job) tinjson.J {
	let (v, ok) = tinjson.Parse(j.Payload)
	if !ok {
		let (empty, _) = tinjson.Parse("{{}}")
		return empty
	}
	return v
}

fn quoteAll(xs []str) str {
	mut parts = []str{}
	for x in xs {
		parts = append(parts, tinjson.Quote(x))
	}
	let sep = ","
	return "[" + twine.Join(parts, sep) + "]"
}
