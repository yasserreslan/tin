package workers

import "../../tit/git"
import "../../tit/object"
import "../../tit/store"
import "../repo"
import "fault"
import "postgres"
import "quarry"
import "twine"

// Mirroring (#805, #1014): after a push, a repository's branches and tags are written as git objects with tit
// mirror's fixed encoding (products/tit/git/mirror.tin: adopted commits keep their git ids, a commit made in tit gets
// a Change-Id line and no signature, so every node writes the same git ids) and pushed to the git host in the
// repository's mirrors row, over git's smart HTTP protocol. The objects go into a git directory of the node's own,
// <packs.dir>/mirror/<repo>/mirror.git, with its git-ids table beside it; both are a cache, rebuilt from the packs
// when lost, since the encoding is fixed. A mirror whose url is a local git directory (Deps.LocalMirrors) is written
// directly. Refs deleted in tinhub are left on the mirror, as tit mirror leaves them.

// ErrMirrorUrl is the fault of a mirror url the worker does not push to.
let ErrMirrorUrl = fault("not a mirror url")

// mirrorBudget is about how many bytes one batch reads before its pairs of ids are recorded.
const mirrorBudget = 8 * 1024 * 1024

// MirrorResult is what a mirror did: the git objects written, the refs written into the git directory, and the refs
// the git host moved.
type MirrorResult struct {
	Objects i64
	Refs    i64
	Moved   i64
}

// Mirror copies the repository's branches and tags to its mirror, when it has an active one; the outcome is recorded
// in the mirrors row (mirrored_at, or last_error).
fn Mirror(d mut Deps, id i64) !MirrorResult {
	let rows = try d.Db.Query("SELECT m.url, m.token, r.default_branch FROM mirrors m JOIN repos r ON r.id = m.repo_id WHERE m.repo_id = {id} AND m.active AND r.deleted_at IS NULL")
	if len(rows.Rows) == 0 {
		return MirrorResult{Objects: 0, Refs: 0, Moved: 0}
	}
	let url = rows.Rows[0][0].Text()
	let token secret str = rows.Rows[0][1].Text()
	let branch = rows.Rows[0][2].Text()
	let (res, err) = mirrorTo(mut d, id, url, token, branch)
	if err != nil {
		let why = fault.Message(err)
		_ = d.Db.Exec("UPDATE mirrors SET last_error = {why} WHERE repo_id = {id}") catch _ {
			postgres.Result{Affected: 0}
		}
		fail err
	}
	_ = try d.Db.Exec("UPDATE mirrors SET mirrored_at = now(), last_error = '' WHERE repo_id = {id}")
	return res
}

fn mirrorTo(d mut Deps, id i64, url str, token secret str, branch str) !MirrorResult {
	let http = twine.HasPrefix(url, "https://") || twine.HasPrefix(url, "http://")
	if !http && !(d.LocalMirrors && twine.HasPrefix(url, "/")) {
		fail fault.Wrap(ErrMirrorUrl, url)
	}
	let base = d.Dir + "/mirror/{id}"
	try quarry.MkdirAll(base)
	mut gitDir = url
	if http {
		gitDir = base + "/mirror.git"
		try bareGit(gitDir)
	}
	let target = try git.Open(gitDir)
	mut r = d.repoOf(id)
	let ps = try r.Packs()
	mut paths = []str{}
	for p in ps {
		paths = append(paths, p.Path)
	}
	mut st = layered(ps)
	let sep = "\n"
	let (res, err) = mirrorFrom(mut r, mut st, twine.Join(paths, sep), gitDir, target, base, url, token, branch, http)
	if err != nil {
		fail err
	}
	return res
}

fn mirrorFrom(r mut repo.PgRepo, st mut store.Layered, packList str, gitDir str, target git.Repo, base str, url str, token secret str, branch str, http bool) !MirrorResult {
	let idsPath = base + "/git-ids"
	mut ids = try git.ReadIds(idsPath)
	mut back = git.BackOf(ids)
	let refs = try r.Refs("refs/")
	mut names = []str{}
	mut tips = []object.Id{}
	for ref in refs {
		if !twine.HasPrefix(ref.Name, "refs/heads/") && !twine.HasPrefix(ref.Name, "refs/tags/") {
			continue
		}
		match ref.Target {
			Commit(cid) => {
				names = append(names, ref.Name)
				tips = append(tips, cid)
			}
			Change(_) => {
			}
		}
	}
	let order = try git.MirrorPlan(mut st, target, back, tips)
	let nl = "\n"
	mut written = 0
	mut i = 0
	for i < len(order) {
		let start = i
		let b = try arena {
			try git.MirrorBatchFrom(twine.Split(packList, nl), gitDir, back, order, start, mirrorBudget)
		}
		for k in 0..len(b.Git) {
			ids.Set(b.Git[k], b.Tit[k])
			back.Set(b.Tit[k], b.Git[k])
		}
		written += len(b.Git)
		_ = try arena {
			try git.WriteIds(idsPath, ids)
			0
		}
		i = b.Next
	}
	mut updates = []git.RefPush{}
	for k in 0..len(names) {
		let gid = back.Git(tips[k].Bytes())
		if len(gid) == 0 {
			fail "{names[k]} has no git id after mirroring"
		}
		try git.WriteRef(gitDir, names[k], gid)
		updates = append(updates, git.RefPush{Name: names[k], New: gid})
	}
	if len(branch) > 0 {
		try git.PointHead(gitDir, "refs/heads/" + branch)
	}
	mut res = MirrorResult{Objects: written, Refs: len(names), Moved: 0}
	if !http {
		return res
	}
	let pushed = try git.Open(gitDir)
	let (moved, _) = try git.PushHttp(pushed, url, token, updates)
	res.Moved = moved
	return res
}

// bareGit makes an empty bare git directory at dir, unless there is one.
fn bareGit(dir str) ! {
	if quarry.Exists(dir + "/HEAD") {
		return
	}
	try quarry.MkdirAll(dir + "/objects")
	try quarry.MkdirAll(dir + "/refs/heads")
	try quarry.MkdirAll(dir + "/refs/tags")
	try quarry.WriteFile(dir + "/config", "[core]\n\trepositoryformatversion = 0\n\tbare = true\n")
	try quarry.WriteFile(dir + "/HEAD", "ref: refs/heads/main\n")
}
