package workers

import "../../tit/packfile"
import "../../tit/transport"
import "tide"

// Repack (#1007, #1014): a repository's live packs merged into one through PgRepo, as design/tit.md §16 has it: the
// new pack written (packfile.Merge copies the entries as they are, a window at a time), staged, made live by a Commit
// with no refs and no changes, and only then the packs it replaces retired. Readers that listed the old packs keep
// reading them for packs.grace; the sweep deletes them after.
//
// A job that dies before the Commit leaves a pending pack the sweep deletes, and the repository as it was; one that
// dies after it leaves the new pack live beside the old ones (every object twice, none missing). Run again, it merges
// the same packs, the new one last: each of its entries is a copy of an earlier one, so the merge is byte for byte
// the same pack, already live, and the job only retires the rest. Packs pushed meanwhile are merged or left live,
// never retired unmerged.

// Repack merges the repository's live packs into one and retires them; it returns how many it retired (0 when the
// repository has one pack or none).
fn Repack(d mut Deps, id i64) !i64 {
	mut r = d.repoOf(id)
	let ps = try r.Packs()
	if len(ps) <= 1 {
		return 0
	}
	// oldest first (Packs is newest first): a pack merged by an earlier run comes last, so its entries are copies
	mut paths = []str{}
	mut names = []str{}
	for k in 0..len(ps) {
		let p = ps[len(ps) - 1 - k]
		paths = append(paths, p.Path)
		names = append(names, packName(p.Path))
	}
	let merged = try packfile.Merge(paths, r.TempDir())
	let st = try r.Stage(merged.Path)
	_ = try r.Commit(transport.Update{Who: "", Command: "repack", Changes: []transport.ChangeUpdate{}, Refs: []transport.RefUpdate{}, Pack: st.Name, Time: tide.Wall()})
	mut old = []str{}
	for n in names {
		if n != st.Name {
			old = append(old, n)
		}
	}
	return try r.Retire(old)
}
