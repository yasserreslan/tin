package workers

import "../events"
import "../diffs"
import "../index"
import "../notify"
import "postgres"

// The push event's fan-out (design/tinhub.md §6): a push queues, in one transaction, the jobs that follow it. Every
// kind in Deps.Follows once per push (keyed by the push event's id, so a fan-out run again queues nothing twice), a
// mirror when the repository has an active one, and a repack when it has more than repack.packs live packs; a mirror
// or a repack already waiting (ready) covers this push too, so none is queued beside it.

fn runPush(d Deps, j events.Job) ! {
	mut tx = try d.Db.Begin()
	let err = fanOut(d, mut tx, j)
	if err != nil {
		tx.Rollback() catch _ {
		}
		fail err
	}
	try tx.Commit()
}

fn fanOut(d Deps, tx mut postgres.Tx, j events.Job) ! {
	if j.RepoId == 0 {
		return
	}
	try followUps(d, mut tx, j)
	try housekeeping(d, mut tx, j)
}

// followUps queues the jobs other packages own, all in the fan-out's transaction. THE ONE PLACE to add them: each
// kind below is queued here once its handler is registered with the worker, by a call to its package's enqueue hook
// (keyed by the push event's id, j.Id, so a fan-out run again queues nothing twice), or by naming the kind in
// Deps.Follows, which queues it with the push's payload plus "push": j.Id.
//
//	index         symbols of moved heads and new versions        #1020 (index.EnqueueFor, below)
//	review.diff   semantic diffs and overlaps of a new version   #1021 (diffs.EnqueueFor, below)
//	notify        notifications to subscribers                   #1023 (notify.EnqueueFor, below)
//	webhook       webhook deliveries                             #1023 (notify.EnqueueFor, below)
//	bench         benchmarks of a pushed commit                  #1029
fn followUps(d Deps, tx mut postgres.Tx, j events.Job) ! {
	let repo = j.RepoId
	let ev = "{j.Id}"
	let pushed = j.Payload
	// webhooks and notifications (#1023): at least once, as webhooks are; a fan-out that dies between its commit and
	// its job's end queues them again, and receivers tell repeats apart by the event in the body
	_ = try notify.EnqueueFor(mut tx, repo, "push", pushed)
	// the symbols of the heads it moved and the versions it added (#1020), and each new version's review diff and
	// overlaps (#1021); a job run again finds its commit indexed or its diff kept, and does nothing
	_ = try index.EnqueueFor(mut tx, repo, pushed)
	_ = try diffs.EnqueueFor(mut tx, repo, pushed)
	for k in d.Follows {
		_ = try tx.Exec("INSERT INTO events (kind, repo_id, payload) SELECT {k}, {repo}, {pushed}::jsonb || jsonb_build_object('push', {j.Id}) WHERE NOT EXISTS (SELECT 1 FROM events WHERE kind = {k} AND repo_id = {repo} AND payload->>'push' = {ev})")
	}
}

// housekeeping queues this package's jobs: a mirror when the repository has an active one, and a repack past
// repack.packs live packs.
fn housekeeping(d Deps, tx mut postgres.Tx, j events.Job) ! {
	let repo = j.RepoId
	let mirrors = try tx.Query("SELECT 1 FROM mirrors WHERE repo_id = {repo} AND active")
	if len(mirrors.Rows) > 0 {
		try queueOnce(mut tx, KindMirror, repo, j.Id)
	}
	let live = try tx.Query("SELECT count(*) FROM packs WHERE repo_id = {repo} AND state = 'live'")
	if live.Rows[0][0].Int() > d.RepackPacks {
		try queueOnce(mut tx, KindRepack, repo, j.Id)
	}
}

// queueOnce queues a job of kind for the repository unless one is ready already.
fn queueOnce(tx mut postgres.Tx, kind str, repo i64, push i64) ! {
	_ = try tx.Exec("INSERT INTO events (kind, repo_id, payload) SELECT {kind}, {repo}, jsonb_build_object('push', {push}) WHERE NOT EXISTS (SELECT 1 FROM events WHERE kind = {kind} AND repo_id = {repo} AND state = 'ready')")
}
