package workers

import "../../tit/change"
import "../../tit/crash"
import "../../tit/object"
import "../../tit/packfile"
import "../../tit/store"
import "../../tit/transport"
import "../events"
import "../packs"
import "../repo"
import "fault"
import "postgres"
import "quarry"
import "tide"
import "tinjson"
import "twine"

// Prune and purge (#1010, #1014), with tit's rules (products/tit/prune) over a repository in Postgres and the pack
// store. The roots are every ref's commit and every version of every open change: one a ref names, one with an open
// review, or one with a version the refs reach (its earlier versions are its history, which reviews compare). Prune
// also keeps every object of a pack that went live within the retention (Deps.Retention): tinhub has no oplog, and a
// push whose checks saw an object must still find it at its Commit (design/tit.md §16). Removing objects writes a
// pack of what stays from the packs that held them, stages it, makes it live, and only then retires those packs, as
// a repack does, so a job that dies partway leaves every object a ref reaches readable and running it again finishes.
//
// Purge removes named objects that nothing above reaches, at once: from every live pack (rewritten, the old ones
// retired and deleted without waiting for the grace period) and from every retired pack that holds one, with a row in
// audit_log. An object something reaches is refused (ErrReachable, naming what reaches it), and the refusal recorded.

// ErrReachable is the fault of a purge of an object a ref or an open change still reaches.
let ErrReachable = fault("still reachable")

// ErrBadId is the fault of a purge naming something that is not an object id.
let ErrBadId = fault("not an object id")

// Result is what a prune or a purge did: the objects reachable, the objects removed from live packs, the packs
// retired (or, for a purge, deleted) and the pack written ("" for none).
type Result struct {
	Reachable i64
	Objects   i64
	Packs     i64
	Pack      str
}

// root is an object something names (its id's 32 bytes), what names it, and whether it is known to be a blob.
type root struct {
	raw  str
	from str
	blob bool
}

fn idOf(raw str) object.Id {
	let id = object.IdOf(raw) catch _ {
		object.NoId
	}
	return id
}

// refRoots is every ref's commit, and the letters of every change a ref names.
fn refRoots(r mut repo.PgRepo) !([]root, map[str]bool) {
	mut out = []root{}
	mut named = map[str]bool{}
	let all = try r.Refs("")
	for ref in all {
		match ref.Target {
			Commit(id) => {
				out = append(out, root{raw: id.Bytes(), from: ref.Name, blob: false})
			}
			Change(c) => {
				named[c.Letters()] = true
			}
		}
	}
	return out, named
}

// children is what an object names.
fn children(st mut store.Layered, id object.Id) ![]root {
	mut out = []root{}
	let o = try st.Get(id)
	match o {
		Commit(c) => {
			out = append(out, root{raw: c.Tree.Bytes(), from: "", blob: false})
			for p in c.Parents {
				out = append(out, root{raw: p.Bytes(), from: "", blob: false})
			}
			for k in c.Conflicts {
				for part in twine.Split(k, "\t") {
					if len(part) == 64 {
						let cid = object.ParseId(part) catch _ {
							continue
						}
						out = append(out, root{raw: cid.Bytes(), from: "", blob: true})
					}
				}
			}
		}
		Tree(es) => {
			for e in es {
				out = append(out, root{raw: e.Id.Bytes(), from: "", blob: e.Mode != object.Mode.Dir})
			}
		}
		Tag(t) => {
			out = append(out, root{raw: t.Object.Bytes(), from: "", blob: false})
		}
		Blob(_) => {
		}
	}
	return out
}

// reach adds to seen every object reachable from roots in st; an object the packs lack ends its branch of the walk.
fn reach(st mut store.Layered, roots []root, seen mut map[str]bool) ! {
	mut todo = []root{}
	for r in roots {
		todo = append(todo, r)
	}
	for len(todo) > 0 {
		let r = todo[len(todo) - 1]
		todo = todo[0:len(todo) - 1]
		let (_, done) = seen[r.raw]
		let id = idOf(r.raw)
		if done || !st.Has(id) {
			continue
		}
		seen[r.raw] = true
		if r.blob {
			continue
		}
		let kids = try children(mut st, id)
		for k in kids {
			let (_, d) = seen[k.raw]
			if !d {
				todo = append(todo, k)
			}
		}
	}
}

// openChanges adds to live every version of each open change: one a ref names, one with an open review, or one with
// a version live already holds.
fn openChanges(c postgres.Client, id i64, st mut store.Layered, named map[str]bool, live mut map[str]bool) ! {
	mut open = map[str]bool{}
	for k, _ in named {
		open[k] = true
	}
	let reviews = try c.Query("SELECT change_id FROM reviews WHERE repo_id = {id} AND state IN ('open', 'approved', 'changes_requested')")
	for row in reviews.Rows {
		open[row[0].Text()] = true
	}
	let rows = try c.Query("SELECT change_id, commit_id FROM changes WHERE repo_id = {id} ORDER BY change_id, version")
	mut versions = map[str][]str{}
	for row in rows.Rows {
		let letters = row[0].Text()
		let cid = object.ParseId(row[1].Text()) catch _ {
			continue
		}
		mut vs = versions[letters]
		vs = append(vs, cid.Bytes())
		versions[letters] = vs
		let (_, hit) = live[cid.Bytes()]
		if hit {
			open[letters] = true
		}
	}
	mut more = []root{}
	for letters, vs in versions {
		let (_, isOpen) = open[letters]
		if !isOpen {
			continue
		}
		for raw in vs {
			more = append(more, root{raw: raw, from: "change " + letters, blob: false})
		}
	}
	try reach(mut st, more, mut live)
}

// rewritten is what rewrite did: the objects left out, the packs retired, and the pack written.
type rewritten struct {
	removed i64
	retired []str
	made    str
}

// goes is whether an object leaves: when listed is true, those in set leave (purge); otherwise those not in it
// (prune, set being what is reachable).
fn goes(set map[str]bool, listed bool, raw str) bool {
	let (_, in) = set[raw]
	return in == listed
}

// rewrite replaces the live packs that hold an object that goes (except those young names) with one pack of the rest
// of their objects: written, staged and made live, then the old packs retired.
fn rewrite(r mut repo.PgRepo, st mut store.Layered, ps []packfile.Pack, set map[str]bool, listed bool, young map[str]bool, command str) !rewritten {
	mut stay = []object.Id{}
	mut stayed = map[str]bool{}
	mut old = []str{}
	mut removed = 0
	for k in 0..len(ps) {
		let p = ps[k]
		let name = packName(p.Path)
		let (_, isYoung) = young[name]
		if isYoung {
			continue
		}
		mut hit = false
		for i in 0..p.Count {
			if goes(set, listed, p.IdAt(i).Bytes()) {
				hit = true
				break
			}
		}
		if !hit {
			continue
		}
		old = append(old, name)
		for i in 0..p.Count {
			let id = p.IdAt(i)
			if goes(set, listed, id.Bytes()) {
				removed += 1
				continue
			}
			let (_, dup) = stayed[id.Bytes()]
			if !dup {
				stayed[id.Bytes()] = true
				stay = append(stay, id)
			}
		}
	}
	mut out = rewritten{removed: removed, retired: []str{}, made: ""}
	if len(old) == 0 {
		return out
	}
	if len(stay) > 0 {
		let np = try packfile.Write(mut st, stay, r.TempDir())
		let staged = try r.Stage(np.Path)
		_ = try r.Commit(transport.Update{Who: "", Command: command, Changes: []transport.ChangeUpdate{}, Refs: []transport.RefUpdate{}, Pack: staged.Name, Time: tide.Wall()})
		out.made = staged.Name
	}
	mut retire = []str{}
	for n in old {
		if n != out.made {
			retire = append(retire, n)
		}
	}
	_ = try r.Retire(retire)
	out.retired = retire
	return out
}

// ages is how long ago (seconds) each live pack of the repository went live.
fn ages(c postgres.Client, id i64) !map[str]i64 {
	let rows = try c.Query("SELECT hash, extract(epoch FROM now() - live_at)::bigint FROM packs WHERE repo_id = {id} AND state = 'live'")
	mut out = map[str]i64{}
	for row in rows.Rows {
		out[row[0].Text()] = row[1].Int()
	}
	return out
}

// Prune removes from the repository's live packs every object that no ref or open change reaches, keeping each pack
// that went live within retention (ns) whole, and its objects' closure.
fn Prune(d mut Deps, id i64, retention i64) !Result {
	mut r = d.repoOf(id)
	// the ages before the packs: a pack that goes live in between is young
	let age = try ages(d.Db, id)
	let ps = try r.Packs()
	mut st = layered(ps)
	let (roots0, named) = try refRoots(mut r)
	mut roots = roots0
	mut young = map[str]bool{}
	let keepSecs = retention / tide.Second
	for k in 0..len(ps) {
		mut p = ps[k]
		let name = packName(p.Path)
		let (a, known) = age[name]
		if known && a >= keepSecs {
			continue
		}
		young[name] = true
		for i in 0..p.Count {
			let kind = try p.KindAt(i)
			roots = append(roots, root{raw: p.IdAt(i).Bytes(), from: "pack {name}", blob: kind == object.Kind.Blob})
		}
	}
	mut live = map[str]bool{}
	try reach(mut st, roots, mut live)
	try openChanges(d.Db, id, mut st, named, mut live)
	let w = try rewrite(mut r, mut st, ps, live, false, young, "prune")
	return Result{Reachable: len(live), Objects: w.removed, Packs: len(w.retired), Pack: w.made}
}

// whatReaches names a root that reaches the object raw.
fn whatReaches(st mut store.Layered, roots []root, raw str) !str {
	for r in roots {
		mut one = map[str]bool{}
		try reach(mut st, []root{r}, mut one)
		let (_, here) = one[raw]
		if here {
			return r.from
		}
	}
	return "an open change"
}

// parseIds is the ids as raw bytes; a text that is not a 64-digit id is ErrBadId.
fn parseIds(hexes []str) ![]str {
	mut out = []str{}
	for h in hexes {
		let id = object.ParseId(h) catch _ {
			fail fault.Wrap(ErrBadId, h)
		}
		out = append(out, id.Bytes())
	}
	return out
}

// Purge removes the objects named (hex ids) from every pack of the repository, live and retired, at once. An object a
// ref or an open change reaches is ErrReachable, and nothing is removed.
fn Purge(d mut Deps, id i64, hexes []str) !Result {
	let raws = try parseIds(hexes)
	mut r = d.repoOf(id)
	let ps = try r.Packs()
	mut st = layered(ps)
	let (roots, named) = try refRoots(mut r)
	mut live = map[str]bool{}
	try reach(mut st, roots, mut live)
	try openChanges(d.Db, id, mut st, named, mut live)
	mut wanted = map[str]bool{}
	for raw in raws {
		let (_, reached) = live[raw]
		if reached {
			let from = try whatReaches(mut st, roots, raw)
			fail fault.Wrap(ErrReachable, "{idOf(raw).Hex()} is reached from {from}")
		}
		wanted[raw] = true
	}
	let w = try rewrite(mut r, mut st, ps, wanted, true, map[str]bool{}, "purge")
	// every retired pack that holds one, those just retired among them: deleted now, not after the grace period
	let deleted = try deleteRetired(mut d, id, raws)
	return Result{Reachable: len(live), Objects: w.removed, Packs: deleted, Pack: w.made}
}

// deleteRetired deletes the repository's retired packs that hold any of the objects raws: files, then rows, each under
// the repository's lock, and the node's cached copies. It returns how many it deleted.
fn deleteRetired(d mut Deps, id i64, raws []str) !i64 {
	let rows = try d.Db.Query("SELECT hash FROM packs WHERE repo_id = {id} AND state = 'retired' ORDER BY hash")
	mut n = 0
	for row in rows.Rows {
		let hash = row[0].Text()
		let has = try retiredHolds(mut d, id, hash, raws)
		if !has {
			continue
		}
		mut tx = try d.Db.Begin()
		let (k, err) = deleteIn(mut d, mut tx, id, hash)
		if err != nil {
			tx.Rollback() catch _ {
			}
			fail err
		}
		try tx.Commit()
		n += k
	}
	return n
}

fn deleteIn(d mut Deps, tx mut postgres.Tx, id i64, hash str) !i64 {
	try packs.Lock(mut tx, id)
	let rows = try tx.Query("SELECT 1 FROM packs WHERE repo_id = {id} AND hash = {hash} AND state = 'retired'")
	if len(rows.Rows) == 0 {
		return 0
	}
	mut s = d.Store
	crash.Point()
	_ = try s.Delete(packs.PackKey(id, hash, "pack"))
	crash.Point()
	_ = try s.Delete(packs.PackKey(id, hash, "idx"))
	let base = d.Dir + "/cache/" + packs.PackKey(id, hash, "")
	for ext in []str{"pack", "idx"} {
		if quarry.Exists(base + ext) {
			quarry.Remove(base + ext) catch _ {
			}
		}
	}
	_ = try tx.Exec("DELETE FROM packs WHERE repo_id = {id} AND hash = {hash}")
	return 1
}

// retiredHolds is whether the retired pack holds any of raws: its index, read from the store's file or fetched.
fn retiredHolds(d mut Deps, id i64, hash str, raws []str) !bool {
	let key = packs.PackKey(id, hash, "idx")
	let local = d.Store.Local(key)
	if local != nil {
		let text = quarry.ReadFileBound(local, 1 << 40) catch _ {
			// the files are gone already
			return false
		}
		return try idxHolds(text, key, raws)
	}
	try quarry.MkdirAll(d.Dir + "/tmp")
	let tmp = d.Dir + "/tmp/purge-" + hash + ".idx"
	mut s = d.Store
	_ = s.Get(key, tmp) catch _ {
		return false
	}
	let (text, err) = quarry.ReadFileBound(tmp, 1 << 40)
	quarry.Remove(tmp) catch _ {
	}
	if err != nil {
		fail err
	}
	return try idxHolds(text, key, raws)
}

fn le64(s str, at i64) i64 {
	mut v = 0
	for k in 0..8 {
		v = v | (i64(s[at + k]) << (8 * k))
	}
	return v
}

// idxHolds is whether the pack index idx (design/tit.md §6: a 20-byte header with the count at 12, a 1024-byte
// fan-out table, then the sorted ids) holds any of raws.
fn idxHolds(idx str, name str, raws []str) !bool {
	if len(idx) < 20 + 1024 || idx[0:8] != "TITIDX\x00\x00" {
		fail fault.Wrap(packfile.ErrBadPack, "{name}: not a pack index")
	}
	let count = le64(idx, 12)
	if count < 0 || 20 + 1024 + 32 * count > len(idx) {
		fail fault.Wrap(packfile.ErrBadPack, "{name}: not a pack index")
	}
	mut want = map[str]bool{}
	for raw in raws {
		want[raw] = true
	}
	for i in 0..count {
		let at = 20 + 1024 + 32 * i
		let (_, hit) = want[idx[at:at + 32]]
		if hit {
			return true
		}
	}
	return false
}

// RequestPurge records an admin's purge in audit_log and queues it, in one transaction; it returns the event's id.
// actor is the admin's users.id (0 for none), ip the request's address.
fn RequestPurge(c postgres.Client, id i64, actor i64, hexes []str, reason str, ip str) !i64 {
	_ = try parseIds(hexes)
	let objs = quoteAll(hexes)
	let payload = "{{\"objects\":" + objs + ",\"actor\":{actor},\"reason\":" + tinjson.Quote(reason) + "}}"
	let detail = "{{\"objects\":" + objs + ",\"reason\":" + tinjson.Quote(reason) + "}}"
	mut tx = try c.Begin()
	let (ev, err) = requestIn(mut tx, id, actor, payload, detail, ip)
	if err != nil {
		tx.Rollback() catch _ {
		}
		fail err
	}
	try tx.Commit()
	return ev
}

fn requestIn(tx mut postgres.Tx, id i64, actor i64, payload str, detail str, ip str) !i64 {
	_ = try tx.Exec("INSERT INTO audit_log (actor_id, action, target_kind, target_id, detail, ip) VALUES (nullif({actor}, 0), 'repo.purge.requested', 'repo', {id}, {detail}::jsonb, {ip})")
	return try events.Enqueue(mut tx, KindPurge, id, payload)
}

// audit adds a row to audit_log for the purge job j, once: a job run again finds its row and adds none.
fn audit(c postgres.Client, j events.Job, actor i64, action str, detail str) ! {
	let ev = "{j.Id}"
	_ = try c.Exec("INSERT INTO audit_log (actor_id, action, target_kind, target_id, detail) SELECT nullif({actor}, 0), {action}, 'repo', {j.RepoId}, {detail}::jsonb WHERE NOT EXISTS (SELECT 1 FROM audit_log WHERE action = {action} AND target_kind = 'repo' AND target_id = {j.RepoId} AND detail->>'event' = {ev})")
}

// runPurge is the purge job: its payload is {"objects": [hex, ...], "actor": id, "reason": text}. A refused purge is
// recorded and the job done (running it again would be refused again).
fn runPurge(d mut Deps, j events.Job) ! {
	let p = payloadOf(j)
	mut hexes = []str{}
	for o in p.Get("objects").Items() {
		hexes = append(hexes, o.Text())
	}
	let actor = p.Get("actor").Int()
	let reason = p.Get("reason").Text()
	let objs = quoteAll(hexes)
	let (res, err) = Purge(mut d, j.RepoId, hexes)
	if err != nil {
		if fault.Is(err, ErrReachable) || fault.Is(err, ErrBadId) {
			let why = fault.Message(err)
			let detail = "{{\"event\":\"{j.Id}\",\"objects\":" + objs + ",\"reason\":" + tinjson.Quote(reason) + ",\"error\":" + tinjson.Quote(why) + "}}"
			try audit(d.Db, j, actor, "repo.purge.refused", detail)
			return
		}
		fail err
	}
	let detail = "{{\"event\":\"{j.Id}\",\"objects\":" + objs + ",\"reason\":" + tinjson.Quote(reason) + ",\"removed\":{res.Objects},\"packs\":{res.Packs}}}"
	try audit(d.Db, j, actor, "repo.purge", detail)
}

// runPrune is the prune job: its payload may set "retention_secs", else Deps.Retention holds.
fn runPrune(d mut Deps, j events.Job) ! {
	let p = payloadOf(j)
	mut retention = d.Retention
	let set = p.Get("retention_secs")
	if set.IsNumber() && set.Int() >= 0 {
		retention = set.Int() * tide.Second
	}
	_ = try Prune(mut d, j.RepoId, retention)
}

// SchedulePrune queues a prune of every repository that has live packs and has had no prune queued for a day, none
// ready or claimed now: the nightly prune, for the worker to call on its timer. It returns how many it queued.
fn SchedulePrune(c postgres.Client) !i64 {
	let r = try c.Exec("INSERT INTO events (kind, repo_id, payload) SELECT 'prune', r.id, '{{}}'::jsonb FROM repos r WHERE r.deleted_at IS NULL AND EXISTS (SELECT 1 FROM packs p WHERE p.repo_id = r.id AND p.state = 'live') AND NOT EXISTS (SELECT 1 FROM events e WHERE e.kind = 'prune' AND e.repo_id = r.id AND (e.state IN ('ready', 'claimed') OR e.created_at > now() - interval '20 hours'))")
	return r.Affected
}
