package bench

import "../../tit/object"
import "../../tit/store"
import "fault"
import "postgres"
import "say"
import "twine"

// A change version against its base (design/tinhub.md §13): the newest Linux result of each benchmark recorded for the
// version's change, as the version's own .bench/ files hold them (so a later version's results never judge an earlier
// one; when its tree has none, the newest bench_results has), against the newest recorded for its base, the version's
// first parent (the base's change, or the base commit), on the same benchmark, unit, architecture and machine. macOS
// results never take part.
// A unit that is a rate (it ends in /s: req/s, MiB/s, ops/s) is faster when higher; any other (ns, ms, s, ns/op) when
// lower. A result more than the threshold slower fails the version's bench check and leaves a note on its review.

// Delta is one benchmark of a version against its base.
type Delta struct {
	Name    str
	Unit    str
	Arch    str
	Machine str
	Cpu     str
	Kernel  str
	Base    f64
	Value   f64
	// Slower is how much slower the version is, as a fraction of the base (0.25: 25% slower; below 0: faster)
	Slower f64
	// Regressed is Slower past the threshold
	Regressed bool
}

// Verdict is a change version's benchmarks against its base.
type Verdict struct {
	Change  str
	Version i64
	Commit  str
	// Base is the version's first parent, "" for a root commit; BaseChange its change
	Base       str
	BaseChange str
	Threshold  f64
	// State is the check's: failure when a benchmark regressed, else success
	State  str
	Deltas []Delta
}

// CheckName is the name of the bench check in checks.
const CheckName = "bench"

// IsRate reports whether a unit measures a rate (higher is faster): it ends in /s, /sec or /second.
fn IsRate(unit str) bool {
	let u = twine.ToLower(twine.TrimSpace(unit))
	return twine.HasSuffix(u, "/s") || twine.HasSuffix(u, "/sec") || twine.HasSuffix(u, "/second")
}

// SlowerBy is how much slower value is than base, as a fraction of base; 0 when either is not positive.
fn SlowerBy(unit str, base f64, value f64) f64 {
	if base <= 0.0 || value <= 0.0 {
		return 0.0
	}
	if IsRate(unit) {
		return base / value - 1.0
	}
	return value / base - 1.0
}

// newest is the newest Linux result of each series (benchmark, unit, architecture, machine) of a change or commit.
type newest struct {
	name    str
	unit    str
	arch    str
	machine str
	cpu     str
	kernel  str
	value   f64
}

fn seriesKey(name str, unit str, arch str, machine str) str {
	return name + "\x00" + unit + "\x00" + arch + "\x00" + machine
}

// newestOf is the newest Linux result of each series recorded for the change (when not "") or the commit.
fn newestOf(c postgres.Client, repoId i64, change str, commit str) !map[str]newest {
	mut out = map[str]newest{}
	if len(change) == 0 && len(commit) == 0 {
		return out
	}
	let rows = try c.Query("SELECT DISTINCT ON (name, unit, arch, machine) name, unit, arch, machine, cpu, kernel, value FROM bench_results WHERE repo_id = {repoId} AND os = 'Linux' AND ((change_id = {change} AND {change} <> '') OR (change_id = '' AND commit_id = {commit} AND {commit} <> '')) ORDER BY name, unit, arch, machine, created_at DESC, id DESC")
	for r in rows.Rows {
		let n = newest{name: r[0].Text(), unit: r[1].Text(), arch: r[2].Text(), machine: r[3].Text(), cpu: r[4].Text(), kernel: r[5].Text(), value: r[6].Float()}
		out[seriesKey(n.name, n.unit, n.arch, n.machine)] = n
	}
	return out
}

// commitOf is a version's commit; ErrNoVersion when the repository has no such version.
fn commitOf(c postgres.Client, repoId i64, change str, version i64) !str {
	let rows = try c.Query("SELECT commit_id FROM changes WHERE repo_id = {repoId} AND change_id = {change} AND version = {version}")
	if len(rows.Rows) == 0 {
		fail fault.Wrap(ErrNoVersion, "no version {version} of change {change}")
	}
	return rows.Rows[0][0].Text()
}

// NewestVersion is a change's newest version, 0 when it has none.
fn NewestVersion(c postgres.Client, repoId i64, change str) !i64 {
	let rows = try c.Query("SELECT coalesce(max(version), 0) FROM changes WHERE repo_id = {repoId} AND change_id = {change}")
	return rows.Rows[0][0].Int()
}

// baseOf is a commit's first parent and that parent's change ("", "" for a root commit).
fn baseOf(objs mut store.Layered, id object.Id) !(str, str) {
	let o = try objs.Get(id)
	mut parent = object.NoId
	match o {
		Commit(cd) => {
			if len(cd.Parents) > 0 {
				parent = cd.Parents[0]
			}
		}
		_ => {
			fail "{id.Hex()} is not a commit"
		}
	}
	if parent == object.NoId {
		return "", ""
	}
	let po = try objs.Get(parent)
	mut change = ""
	match po {
		Commit(pd) => {
			change = pd.Change.Letters()
		}
		_ => {
		}
	}
	return parent.Hex(), change
}

// treeNewest is the newest Linux result of each series the commit's own .bench/ files hold for the change (a later
// line wins a tie).
fn treeNewest(objs mut store.Layered, id object.Id, change str) !map[str]newest {
	mut best = map[str]Result{}
	let files = try FilesAt(mut objs, id)
	for f in files {
		let (kind, body) = try objs.GetRaw(f.blob)
		if kind != object.Kind.Blob || len(body) > fileMost {
			continue
		}
		let (results, _) = ParseFile(f.name, body)
		for r in results {
			if r.Change != change || r.Os != "Linux" {
				continue
			}
			let key = seriesKey(r.Name, r.Unit, r.Arch, r.Machine)
			let (was, ok) = best[key]
			if !ok || r.At >= was.At {
				best[key] = r
			}
		}
	}
	mut out = map[str]newest{}
	for key, r in best {
		out[key] = newest{name: r.Name, unit: r.Unit, arch: r.Arch, machine: r.Machine, cpu: r.Cpu, kernel: r.Kernel, value: r.Value}
	}
	return out
}

// Evaluate compares a change version with its base, recording nothing.
fn Evaluate(c postgres.Client, repoId i64, change str, version i64) !Verdict {
	let d = try depsOf()
	let t = threshold(d)
	let commit = try commitOf(c, repoId, change, version)
	let id = try object.ParseId(commit)
	mut r = try pgRepo(repoId)
	mut objs = try r.Objects()
	let (base, baseChange) = try baseOf(mut objs, id)
	mut v = Verdict{Change: change, Version: version, Commit: commit, Base: base, BaseChange: baseChange, Threshold: t, State: "success", Deltas: []Delta{}}
	if len(base) == 0 {
		return v
	}
	mut mine = try treeNewest(mut objs, id, change)
	if len(mine) == 0 {
		mine = try newestOf(c, repoId, change, commit)
	}
	let theirs = try newestOf(c, repoId, baseChange, base)
	for key, n in mine {
		let (b, ok) = theirs[key]
		if !ok || b.value <= 0.0 || n.value <= 0.0 {
			continue
		}
		let slower = SlowerBy(n.unit, b.value, n.value)
		let regressed = slower > t
		if regressed {
			v.State = "failure"
		}
		v.Deltas = append(v.Deltas, Delta{Name: n.name, Unit: n.unit, Arch: n.arch, Machine: n.machine, Cpu: n.cpu, Kernel: n.kernel, Base: b.value, Value: n.value, Slower: slower, Regressed: regressed})
	}
	return v
}

// CompareVersion compares a change version with its base and records it: the version's bench check (failure when a
// Linux benchmark is more than the threshold slower, else success), and, when the change has a review, a note (a
// comment with no author) naming each slower benchmark, once. Reviews (#1025) may call it when a review opens, or
// queue it with Recheck in their transaction.
fn CompareVersion(c postgres.Client, repoId i64, change str, version i64) !Verdict {
	let v = try Evaluate(c, repoId, change, version)
	let url = try checkURL(c, repoId, change, version)
	mut tx = try c.Begin()
	let err = record(mut tx, repoId, v, url)
	if err != nil {
		tx.Rollback() catch _ {
		}
		fail err
	}
	try tx.Commit()
	return v
}

// checkURL is the API's address of the version's comparison, "" without public_url.
fn checkURL(c postgres.Client, repoId i64, change str, version i64) !str {
	let d = try depsOf()
	if len(d.PublicURL) == 0 {
		return ""
	}
	let rows = try c.Query("SELECT o.name, r.name FROM repos r JOIN owners o ON o.id = r.owner_id WHERE r.id = {repoId}")
	if len(rows.Rows) == 0 {
		return ""
	}
	let base = twine.TrimRight(d.PublicURL, "/")
	return base + "/api/v1/repos/" + rows.Rows[0][0].Text() + "/" + rows.Rows[0][1].Text() + "/changes/" + change + "/bench?version={version}"
}

// record writes a verdict's check and, for a regression on a change with a review, its note, under a lock per change
// so two jobs of one version write one note.
fn record(tx mut postgres.Tx, repoId i64, v Verdict, url str) ! {
	_ = try tx.Query("SELECT pg_advisory_xact_lock(1029, hashtext({v.Change}))")
	_ = try tx.Exec("INSERT INTO checks (repo_id, change_id, version, name, state, url) VALUES ({repoId}, {v.Change}, {v.Version}, {CheckName}, {v.State}, {url}) ON CONFLICT (repo_id, change_id, version, name) DO UPDATE SET state = EXCLUDED.state, url = EXCLUDED.url, updated_at = now()")
	if v.State != "failure" {
		return
	}
	let body = Note(v)
	_ = try tx.Exec("INSERT INTO comments (repo_id, change_id, version, body) SELECT {repoId}, {v.Change}, {v.Version}, {body} WHERE EXISTS (SELECT 1 FROM reviews WHERE repo_id = {repoId} AND change_id = {v.Change}) AND NOT EXISTS (SELECT 1 FROM comments WHERE repo_id = {repoId} AND change_id = {v.Change} AND version = {v.Version} AND author_id IS NULL AND body = {body})")
}

fn pct(f f64) str {
	return say.Fmt("%.1f%%", f * 100.0)
}

fn num(f f64) str {
	return say.Fmt("%g", f)
}

// Note is the review note of a verdict: each benchmark slower than the threshold, with its numbers and machine.
fn Note(v Verdict) str {
	mut base = v.Base
	if len(base) > 12 {
		base = base[0:12]
	}
	mut text = "Benchmarks slower than the base " + base + " by more than " + pct(v.Threshold) + " (Linux results of the same machine):\n"
	for dl in v.Deltas {
		if !dl.Regressed {
			continue
		}
		text = text + "\n- " + dl.Name + ": " + num(dl.Base) + " -> " + num(dl.Value) + " " + dl.Unit + ", " + pct(dl.Slower) + " slower (" + dl.Machine + ", kernel " + dl.Kernel + ")"
	}
	return text + "\n"
}
