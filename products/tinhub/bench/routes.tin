package bench

import "../accounts"
import "anvil"
import "argo"
import "fault"
import "mint"
import "tide"

// The API (design/tinhub.md §4, §13), JSON under /api/v1/repos/<owner>/<repo>; read access, as the API's other reads
// (a repository the caller cannot read is 404). Errors are {"code", "message"}. Every read runs inside within 2s and
// limit memory 16mb (design/tinhub.md §8).
//
//   GET bench                         every benchmark: its name, results, Linux results and newest time
//   GET bench/<name>?limit=N          its series, one per machine (OS, architecture, CPU, cores) and unit, Linux
//                                     first; a macOS series is marked development and never merged with a Linux one
//   GET changes/<change>/bench        a version (?version=N, else the newest) against its base: each benchmark's base
//                                     and value, how much slower, and the check's state
//   GET releases?limit=&cursor=       the releases tit ship made (annotated tags), newest first
//   GET releases/<tag>                one release

// Mount adds the routes to r.
fn Mount(r mut anvil.Router) {
	r.Get(`/api/v1/repos/{owner}/{repo}/bench`, listBench)
	r.Get(`/api/v1/repos/{owner}/{repo}/bench/{name}`, seriesOf)
	r.Get(`/api/v1/repos/{owner}/{repo}/changes/{change}/bench`, changeBench)
	r.Get(`/api/v1/repos/{owner}/{repo}/releases`, listReleases)
	r.Get(`/api/v1/repos/{owner}/{repo}/releases/{tag...}`, oneRelease)
}

// readWithin and readMemory are a read's budget.
const readWithin = 2 * tide.Second

const readMemory = 16 * 1024 * 1024

type apiError struct {
	code    str
	message str
}

fn fail_(w mut anvil.Out, status i64, code str, message str) {
	w.Status(status)
	w.Json()
	w.Body = []u8{}
	argo.Put(mut w.Body, apiError{code: code, message: message})
}

fn send[T](w mut anvil.Out, v T) {
	w.Json()
	w.Body = []u8{}
	argo.Put(mut w.Body, v)
}

// ErrNotFound is the fault of a benchmark, version or release the repository does not have.
let ErrNotFound = fault("not found")

fn answerErr(w mut anvil.Out, err fault) {
	if fault.Is(err, ErrNotFound) || fault.Is(err, ErrNoVersion) {
		fail_(mut w, 404, "not_found", fault.Message(err))
		return
	}
	fail_(mut w, 503, "unavailable", fault.Message(err))
}

// call is a request's context: the repository in its path, which the caller can read.
type call struct {
	d    Deps
	user i64
	r    accounts.Repo
}

// begin authenticates a request and finds its repository; nil when the answer is written already.
fn begin(q anvil.Req, w mut anvil.Out) ?call {
	let got = deps
	if got == nil {
		fail_(mut w, 503, "unavailable", "the bench API is not configured on this core")
		return nil
	}
	let d = got
	let auth = d.Auth
	let user = auth(q) catch err {
		fail_(mut w, 401, "unauthorized", fault.Message(err))
		return nil
	}
	let owner = q.PathParam("owner")
	let name = q.PathParam("repo")
	let found = accounts.FindRepo(d.Db, owner, name) catch err {
		fail_(mut w, 503, "unavailable", fault.Message(err))
		return nil
	}
	if found == nil {
		fail_(mut w, 404, "not_found", "no repository {owner}/{name}")
		return nil
	}
	let role = accounts.RoleOf(d.Db, user, found) catch err {
		fail_(mut w, 503, "unavailable", fault.Message(err))
		return nil
	}
	if role == accounts.RoleNone {
		fail_(mut w, 404, "not_found", "no repository {owner}/{name}")
		return nil
	}
	return call{d: d, user: user, r: found}
}

// limitOf is ?limit= within 1 and most, else def.
fn limitOf(q anvil.Req, def i64, most i64) i64 {
	let n = mint.Atoi(q.Param("limit")) catch _ {
		def
	}
	if n < 1 {
		return def
	}
	if n > most {
		return most
	}
	return n
}

// ---- benchmarks ----

type benchOut struct {
	name          str
	results       i64
	linux_results i64
	newest_at     i64
}

type benchList struct {
	benchmarks []benchOut
}

fn listBench(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w)
	if c == nil {
		return
	}
	let (out, err) = readBench(c)
	if err != nil {
		answerErr(mut w, err)
		return
	}
	send(mut w, out)
}

fn readBench(c call) !benchList {
	mut out = benchList{benchmarks: []benchOut{}}
	try within readWithin + 0 {
		try limit memory readMemory + 0 {
			mut l = benchList{benchmarks: []benchOut{}}
			let rows = try c.d.Db.Query("SELECT name, count(*), count(*) FILTER (WHERE os = 'Linux'), extract(epoch FROM max(created_at))::bigint FROM bench_results WHERE repo_id = {c.r.Id} GROUP BY name ORDER BY name LIMIT 1000")
			for r in rows.Rows {
				l.benchmarks = append(l.benchmarks, benchOut{name: r[0].Text(), results: r[1].Int(), linux_results: r[2].Int(), newest_at: r[3].Int()})
			}
			out = keep(l)
		}
	}
	return out
}

type pointOut struct {
	commit str
	change str
	value  f64
	kernel str
	at     i64
}

type seriesOut struct {
	os          str
	arch        str
	cpu         str
	machine     str
	unit        str
	development bool
	points      []pointOut
}

type seriesList struct {
	name   str
	series []seriesOut
}

fn seriesOf(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w)
	if c == nil {
		return
	}
	let (out, err) = readSeries(c, q.PathParam("name"), limitOf(q, 100, 1000))
	if err != nil {
		answerErr(mut w, err)
		return
	}
	send(mut w, out)
}

// readSeries is a benchmark's series, each its newest n points oldest first; Linux series before the others.
fn readSeries(c call, name str, n i64) !seriesList {
	mut out = seriesList{name: name, series: []seriesOut{}}
	try within readWithin + 0 {
		try limit memory readMemory + 0 {
			let rows = try c.d.Db.Query("SELECT os, arch, cpu, machine, unit, commit_id, change_id, value, kernel, extract(epoch FROM created_at)::bigint FROM bench_results WHERE repo_id = {c.r.Id} AND name = {name} ORDER BY (os = 'Linux') DESC, os, arch, machine, unit, created_at DESC, id DESC LIMIT 20000")
			if len(rows.Rows) == 0 {
				fail fault.Wrap(ErrNotFound, "no benchmark {name}")
			}
			mut l = seriesList{name: name, series: []seriesOut{}}
			mut key = ""
			for r in rows.Rows {
				let k = r[0].Text() + "\x00" + r[1].Text() + "\x00" + r[3].Text() + "\x00" + r[4].Text()
				if k != key {
					key = k
					l.series = append(l.series, seriesOut{os: r[0].Text(), arch: r[1].Text(), cpu: r[2].Text(), machine: r[3].Text(), unit: r[4].Text(), development: r[0].Text() != "Linux", points: []pointOut{}})
				}
				let last = len(l.series) - 1
				if len(l.series[last].points) < n {
					l.series[last].points = append(l.series[last].points, pointOut{commit: r[5].Text(), change: r[6].Text(), value: r[7].Float(), kernel: r[8].Text(), at: r[9].Int()})
				}
			}
			// oldest first, for a chart
			for i in 0..len(l.series) {
				let ps = l.series[i].points
				mut rev = []pointOut{}
				for j in 0..len(ps) {
					rev = append(rev, ps[len(ps) - 1 - j])
				}
				l.series[i].points = rev
			}
			out = keep(l)
		}
	}
	return out
}

// ---- a change version against its base ----

type deltaOut struct {
	name      str
	unit      str
	arch      str
	machine   str
	cpu       str
	kernel    str
	base      f64
	value     f64
	slower    f64
	regressed bool
}

type verdictOut struct {
	change      str
	version     i64
	commit      str
	base        str
	base_change str
	threshold   f64
	state       str
	benchmarks  []deltaOut
}

fn changeBench(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w)
	if c == nil {
		return
	}
	let version = mint.Atoi(q.Param("version")) catch _ {
		0
	}
	let (out, err) = readVerdict(c, q.PathParam("change"), version)
	if err != nil {
		answerErr(mut w, err)
		return
	}
	send(mut w, out)
}

fn readVerdict(c call, change str, version i64) !verdictOut {
	mut out ?verdictOut = nil
	try within readWithin + 0 {
		try limit memory readMemory + 0 {
			mut v = version
			if v <= 0 {
				v = try NewestVersion(c.d.Db, c.r.Id, change)
			}
			let got = try Evaluate(c.d.Db, c.r.Id, change, v)
			mut ds = []deltaOut{}
			for dl in got.Deltas {
				ds = append(ds, deltaOut{name: dl.Name, unit: dl.Unit, arch: dl.Arch, machine: dl.Machine, cpu: dl.Cpu, kernel: dl.Kernel, base: dl.Base, value: dl.Value, slower: dl.Slower, regressed: dl.Regressed})
			}
			out = keep(verdictOut{change: got.Change, version: got.Version, commit: got.Commit, base: got.Base, base_change: got.BaseChange, threshold: got.Threshold, state: got.State, benchmarks: ds})
		}
	}
	if out == nil {
		fail fault.Wrap(ErrNotFound, "no version of change {change}")
	}
	return out
}

// ---- releases ----

type personOut struct {
	name  str
	email str
	when  i64
	zone  i64
}

type changeOut struct {
	title  str
	change str
}

type releaseOut struct {
	name      str
	tag       str
	commit    str
	title     str
	message   str
	changes   []changeOut
	tagger    personOut
	signed    bool
	verified  bool
	signed_by str
}

type releasePage struct {
	releases []releaseOut
	next     str
}

fn releaseOutOf(r Release) releaseOut {
	mut cs = []changeOut{}
	for c in r.Changes {
		cs = append(cs, changeOut{title: c.Title, change: c.Change})
	}
	let p = r.Tagger
	return releaseOut{name: r.Name, tag: r.Tag, commit: r.Commit, title: r.Title, message: r.Message, changes: cs, tagger: personOut{name: p.Name, email: p.Email, when: p.When, zone: p.Zone}, signed: r.Signed, verified: r.Verified, signed_by: r.SignedBy}
}

fn listReleases(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w)
	if c == nil {
		return
	}
	let from = mint.Atoi(q.Param("cursor")) catch _ {
		-1
	}
	if from < 0 && len(q.Param("cursor")) > 0 {
		fail_(mut w, 400, "bad_request", "the cursor is not one this API gave")
		return
	}
	let (out, err) = readReleases(c, from, limitOf(q, 50, 200))
	if err != nil {
		answerErr(mut w, err)
		return
	}
	send(mut w, out)
}

// readReleases is a page of releases from index from (the cursor is the next page's first index).
fn readReleases(c call, from0 i64, n i64) !releasePage {
	mut out = releasePage{releases: []releaseOut{}, next: ""}
	mut from = from0
	if from < 0 {
		from = 0
	}
	try within readWithin + 0 {
		try limit memory readMemory + 0 {
			let all = try Releases(c.d.Db, c.r.Id)
			mut page = releasePage{releases: []releaseOut{}, next: ""}
			mut i = from
			for i < len(all) && len(page.releases) < n {
				page.releases = append(page.releases, releaseOutOf(all[i]))
				i += 1
			}
			if i < len(all) {
				page.next = "{i}"
			}
			out = keep(page)
		}
	}
	return out
}

fn oneRelease(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w)
	if c == nil {
		return
	}
	let (out, err) = readRelease(c, q.PathParam("tag"))
	if err != nil {
		answerErr(mut w, err)
		return
	}
	send(mut w, out)
}

fn readRelease(c call, name str) !releaseOut {
	mut out ?releaseOut = nil
	try within readWithin + 0 {
		try limit memory readMemory + 0 {
			let r = try ReleaseNamed(c.d.Db, c.r.Id, name)
			if r != nil {
				out = keep(releaseOutOf(r))
			}
		}
	}
	if out == nil {
		fail fault.Wrap(ErrNotFound, "no release {name}")
	}
	return out
}
