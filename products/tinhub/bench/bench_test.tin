// Tests for benchmark history and releases (#1029): reading tit bench's lines, how much slower a result is, the
// changelog of a release, and against Postgres (TINHUB_TEST_DB) a push's results read by the bench job, a change made
// slower failing its check with a note on its review (macOS results never compared), the API's series and verdicts, and
// releases with verified signatures. tests/bench.sh runs it end to end with tit.

const cpu = "Intel(R) Xeon(R) Platinum 8375C CPU @ 2.90GHz"

fn lineOf(change str, commit str, value str, unit str, at i64, os str) str {
	mut b = []u8{}
	argo.Put(mut b, lineIn{Change: change, Commit: commit, Value: value, Unit: unit, Time: at, Machine: machineIn{Os: os, Arch: "x86_64", Cpu: cpu, Kernel: "6.8.0-1017-aws", Cores: "8"}})
	return str(b)
}

const changeA = "kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkl"

fn TestParseLine(t mut crucible.T) {
	let commit = twine.Repeat("ab", 32)
	// as tit bench record writes it
	let text = "{{\"Change\":\"" + changeA + "\",\"Commit\":\"" + commit + "\",\"Value\":\"12.5\",\"Unit\":\"ms\",\"Time\":1760000000,\"Machine\":{{\"Os\":\"Linux\",\"Arch\":\"aarch64\",\"Cpu\":\"Neoverse-N1\",\"Kernel\":\"6.8.0\",\"Cores\":\"4\"}}}}"
	let r = ParseLine("fib", text) catch err {
		t.Error("parse: {err}")
		return
	}
	crucible.Equal(mut t, "change", r.Change, changeA)
	crucible.Equal(mut t, "commit", r.Commit, commit)
	t.True("value", r.Value == 12.5)
	crucible.Equal(mut t, "unit", r.Unit, "ms")
	crucible.Equal(mut t, "os", r.Os, "Linux")
	crucible.Equal(mut t, "cpu", r.Cpu, "Neoverse-N1")
	crucible.Equal(mut t, "kernel", r.Kernel, "6.8.0")
	crucible.Equal(mut t, "machine", r.Machine, "Linux aarch64, Neoverse-N1, 4 cores")
	crucible.Equal(mut t, "at", r.At, 1760000000)
	crucible.Equal(mut t, "hash", len(r.Hash), 64)
	let other = ParseLine("sieve", text) catch err {
		t.Error("parse: {err}")
		return
	}
	t.True("the file's name is in the hash", other.Hash != r.Hash)
	t.HasFault("a bad name", badLine("a.b", text))
	t.HasFault("not JSON", badLine("fib", "nope"))
	t.HasFault("no commit", badLine("fib", lineOf(changeA, "abc", "1", "ms", 1, "Linux")))
	t.HasFault("no change", badLine("fib", lineOf("xyz", commit, "1", "ms", 1, "Linux")))
	t.HasFault("not a number", badLine("fib", lineOf(changeA, commit, "fast", "ms", 1, "Linux")))
	t.HasFault("not finite", badLine("fib", lineOf(changeA, commit, "NaN", "ms", 1, "Linux")))
	t.HasFault("no machine", badLine("fib", lineOf(changeA, commit, "1", "ms", 1, "")))
	t.HasFault("a long unit", badLine("fib", lineOf(changeA, commit, "1", twine.Repeat("u", 40), 1, "Linux")))
	let file = lineOf(changeA, commit, "1", "ms", 1, "Linux") + "\n\ngarbage\n" + lineOf(changeA, commit, "2", "ms", 2, "Darwin") + "\r\n"
	let (rs, bad) = ParseFile("fib", file)
	crucible.Equal(mut t, "results", len(rs), 2)
	crucible.Equal(mut t, "left out", bad, 1)
	crucible.Equal(mut t, "a CRLF line", rs[1].Os, "Darwin")
	t.True("names", ValidName("http_req") && !ValidName("") && !ValidName("a/b") && !ValidName("a b"))
}

fn TestSlower(t mut crucible.T) {
	t.True("ms is a cost", !IsRate("ms") && !IsRate("ns/op"))
	t.True("req/s is a rate", IsRate("req/s") && IsRate("MiB/s") && IsRate("ops/sec"))
	t.True("30% slower", SlowerBy("ms", 100.0, 130.0) > 0.299 && SlowerBy("ms", 100.0, 130.0) < 0.301)
	t.True("faster", SlowerBy("ms", 100.0, 90.0) < 0.0)
	t.True("a rate down by a quarter", SlowerBy("req/s", 1000.0, 800.0) > 0.249 && SlowerBy("req/s", 1000.0, 800.0) < 0.251)
	t.True("a rate up", SlowerBy("req/s", 1000.0, 1200.0) < 0.0)
	t.True("nothing", SlowerBy("ms", 0.0, 5.0) == 0.0)
}

fn TestChangelog(t mut crucible.T) {
	let msg = "v1.2\n\nChanges since v1.1 (2):\n\n- faster fib (kkkkkkkkkkkk)\n- a fix (with parens) (mmmmmmmmmmmm)\n- not one (XYZ)\n"
	let cs = changesOf(msg)
	crucible.Equal(mut t, "changes", len(cs), 2)
	crucible.Equal(mut t, "title", cs[1].Title, "a fix (with parens)")
	crucible.Equal(mut t, "change", cs[1].Change, "mmmmmmmmmmmm")
	crucible.Equal(mut t, "first line", firstLine(msg), "v1.2")
}

fn TestNote(t mut crucible.T) {
	let v = Verdict{Change: changeA, Version: 2, Commit: "", Base: twine.Repeat("cd", 32), BaseChange: "", Threshold: 0.1, State: "failure", Deltas: []Delta{Delta{Name: "fib", Unit: "ms", Arch: "x86_64", Machine: "Linux x86_64, X, 8 cores", Cpu: "X", Kernel: "6.8", Base: 100.0, Value: 130.0, Slower: 0.3, Regressed: true}, Delta{Name: "sieve", Unit: "ms", Arch: "x86_64", Machine: "m", Cpu: "X", Kernel: "6.8", Base: 10.0, Value: 10.5, Slower: 0.05, Regressed: false}}}
	let n = Note(v)
	t.True("the base", twine.Contains(n, "base cdcdcdcdcdcd by more than 10.0%"))
	t.True("the regression", twine.Contains(n, "- fib: 100 -> 130 ms, 30.0% slower (Linux x86_64, X, 8 cores, kernel 6.8)"))
	t.True("not the rest", !twine.Contains(n, "sieve"))
}

// ---- against Postgres ----

fn testDb(t mut crucible.T) ?postgres.Client {
	let (o, ok) = db.TestOptions()
	if !ok {
		t.Log("TINHUB_TEST_DB is not set: skipped")
		return nil
	}
	let c = db.Open(o)
	db.ResetForTests(c) catch err {
		t.Error("reset: {err}")
		return nil
	}
	_ = db.Migrate(c) catch err {
		t.Error("migrate: {err}")
		return nil
	}
	return c
}

fn testAuth(q anvil.Req) !i64 {
	let h = q.Header("x-test-user")
	if len(h) == 0 {
		return 0
	}
	return try mint.Atoi(h)
}

// fixture is ada's repository ada/tin with the client's objects.
type fixture struct {
	c    postgres.Client
	r    repo.PgRepo
	objs store.Mem
	repo i64
	ada  i64
}

fn newFixture(c postgres.Client) !fixture {
	let o = try c.Query("INSERT INTO owners (name, kind) VALUES ('ada', 'user') RETURNING id")
	let owner = o.Rows[0][0].Int()
	let u = try c.Query("INSERT INTO users (owner_id, email, display) VALUES ({owner}, 'ada@example.com', 'Ada') RETURNING id")
	let ada = u.Rows[0][0].Int()
	let rr = try c.Query("INSERT INTO repos (owner_id, name, visibility, quota_bytes) VALUES ({owner}, 'tin', 'public', 1000000000) RETURNING id")
	let id = rr.Rows[0][0].Int()
	let dir = "/tmp/tin-test-tinhub-bench-" + seal.Hex(seal.RandomBytes(4))
	let s = try packs.NewDirStore(dir + "/store")
	let st dyn packs.PackStore = s
	mut d = NewDeps(c, st, dir, testAuth)
	d.PublicURL = "https://hub.example.com/"
	Configure(d)
	return fixture{c: c, r: repo.PgRepo{Db: c, Store: st, Cache: repo.NoCache(), Id: id, Dir: dir, Who: 0}, objs: store.NewMem(), repo: id, ada: ada}
}

fn person(when i64) object.Person {
	return object.Person{Name: "Ada", Email: "ada@example.com", When: when, Zone: 0}
}

// commitWith writes a commit whose tree is main.tin and, when results is not "", .bench/fib.jsonl; its objects too.
fn commitWith(s mut store.Mem, code str, results str, parents []object.Id, cid object.ChangeId, when i64) !(object.Id, []object.Id) {
	let src = try s.PutRaw(object.Kind.Blob, code)
	mut ids = []object.Id{src}
	mut entries = []object.Entry{}
	if len(results) > 0 {
		let blob = try s.PutRaw(object.Kind.Blob, results)
		let dir = try s.Put(object.Object.Tree([]object.Entry{object.Entry{Mode: object.Mode.File, Name: "fib.jsonl", Id: blob}}))
		ids = append(ids, blob, dir)
		entries = append(entries, object.Entry{Mode: object.Mode.Dir, Name: ".bench", Id: dir})
	}
	entries = append(entries, object.Entry{Mode: object.Mode.File, Name: "main.tin", Id: src})
	let tree = try s.Put(object.Object.Tree(entries))
	let c = object.CommitData{Tree: tree, Parents: parents, Change: cid, Author: person(when), Committer: person(when), GitHeaders: []str{}, Signature: "", Message: "commit {when}\n", Conflicts: []str{}}
	let id = try s.Put(object.Object.Commit(c))
	ids = append(ids, tree, id)
	return id, ids
}

// push stages a pack of ids and commits it with the ref moves and versions given; the push event's id and payload.
fn push(f mut fixture, ids []object.Id, refs []transport.RefUpdate, changes []transport.ChangeUpdate) !(i64, str) {
	let p = try packfile.Write(mut f.objs, ids, f.r.TempDir())
	let st = try f.r.Stage(p.Path)
	_ = try f.r.Commit(transport.Update{Who: "ada@example.com", Command: "push", Changes: changes, Refs: refs, Pack: st.Name, Time: 1700000000000000000})
	let rows = try f.c.Query("SELECT id, payload::text FROM events WHERE kind = 'push' ORDER BY id DESC LIMIT 1")
	return rows.Rows[0][0].Int(), rows.Rows[0][1].Text()
}

fn move(name str, old object.Id, next object.Id) transport.RefUpdate {
	mut o = ""
	if old != object.NoId {
		o = old.Hex()
	}
	return transport.RefUpdate{Name: name, Old: o, New: next.Hex()}
}

fn version(cid object.ChangeId, replaces object.Id, commit object.Id) transport.ChangeUpdate {
	mut was = ""
	if replaces != object.NoId {
		was = replaces.Hex()
	}
	return transport.ChangeUpdate{Change: cid.Letters(), Replaces: was, Commit: commit.Hex()}
}

// fanOut is the push handler's call: the bench job queued in a transaction of the fan-out.
fn fanOut(c postgres.Client, repoId i64, ev i64, payload str) !bool {
	mut tx = try c.Begin()
	let (queued, err) = Enqueue(mut tx, repoId, ev, payload)
	if err != nil {
		tx.Rollback() catch _ {
		}
		fail err
	}
	try tx.Commit()
	return queued
}

// work runs every ready bench job; how many ran.
fn work(c postgres.Client) !i64 {
	let d = try depsOf()
	let r = events.Runner{Db: c, Handlers: Handlers(d), Lease: tide.Minute, Poll: tide.Second}
	mut n = 0
	for {
		let ran = try r.Step("bench-test")
		if !ran {
			return n
		}
		n += 1
	}
	return n
}

// badLine is ParseLine's fault.
fn badLine(name str, text str) ! {
	_ = try ParseLine(name, text)
}

// workAll is work's fault.
fn workAll(c postgres.Client) ! {
	_ = try work(c)
}

fn count(c postgres.Client, q query) i64 {
	let rows = c.Query(q) catch _ {
		return -1
	}
	return rows.Rows[0][0].Int()
}

fn TestPushCompareAndApi(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	let c = got
	mut f = newFixture(c) catch err {
		t.Error("fixture: {err}")
		return
	}
	let mainChange = object.NewChangeId()
	let slow = object.NewChangeId()
	let measured = twine.Repeat("ef", 32)
	// main: fib takes 100 ms on Linux and 40 ms on a Mac
	let baseLines = lineOf(mainChange.Letters(), measured, "100", "ms", 1760000000, "Linux") + "\n" + lineOf(mainChange.Letters(), measured, "40", "ms", 1760000001, "Darwin") + "\n"
	let (m1, ids1) = commitWith(mut f.objs, "fn main() {{}}\n", baseLines, []object.Id{}, mainChange, 1760000000) catch err {
		t.Error("commit: {err}")
		return
	}
	let (ev1, p1) = push(mut f, ids1, []transport.RefUpdate{move("refs/heads/main", object.NoId, m1)}, []transport.ChangeUpdate{}) catch err {
		t.Error("push main: {err}")
		return
	}
	let q1 = fanOut(c, f.repo, ev1, p1) catch err {
		t.Error("enqueue: {err}")
		return
	}
	t.True("queued", q1)
	let again = fanOut(c, f.repo, ev1, p1) catch err {
		t.Error("enqueue again: {err}")
		return
	}
	t.True("once per push", !again)
	t.NoFault("the job", workAll(c))
	crucible.Equal(mut t, "rows", count(c, "SELECT count(*) FROM bench_results"), 2)
	crucible.Equal(mut t, "the cpu and kernel", count(c, "SELECT count(*) FROM bench_results WHERE cpu = {cpu} AND kernel = '6.8.0-1017-aws' AND change_id <> ''"), 2)
	// the change made slower: 130 ms on Linux (30%), and 400 ms on the Mac, which is never compared
	let slowLines = baseLines + lineOf(slow.Letters(), twine.Repeat("12", 32), "130", "ms", 1760000100, "Linux") + "\n" + lineOf(slow.Letters(), twine.Repeat("12", 32), "400", "ms", 1760000101, "Darwin") + "\n"
	let (c1, ids2) = commitWith(mut f.objs, "fn main() {{ slow() }}\n", slowLines, []object.Id{m1}, slow, 1760000100) catch err {
		t.Error("commit: {err}")
		return
	}
	_ = c.Exec("INSERT INTO reviews (repo_id, change_id, state, target, opened_by) VALUES ({f.repo}, {slow.Letters()}, 'open', 'refs/heads/main', {f.ada})") catch err {
		t.Error("review: {err}")
		postgres.Result{Affected: 0}
	}
	let (ev2, p2) = push(mut f, ids2, []transport.RefUpdate{move("refs/heads/slow", object.NoId, c1)}, []transport.ChangeUpdate{version(slow, object.NoId, c1)}) catch err {
		t.Error("push slow: {err}")
		return
	}
	_ = fanOut(c, f.repo, ev2, p2) catch err {
		t.Error("enqueue: {err}")
		false
	}
	t.NoFault("the job", workAll(c))
	crucible.Equal(mut t, "rows after", count(c, "SELECT count(*) FROM bench_results"), 4)
	crucible.Equal(mut t, "files", count(c, "SELECT count(*) FROM bench_files"), 2)
	crucible.Equal(mut t, "a failed check", count(c, "SELECT count(*) FROM checks WHERE name = 'bench' AND state = 'failure' AND version = 1 AND url LIKE 'https://hub.example.com/api/v1/repos/ada/tin/changes/%/bench?version=1'"), 1)
	crucible.Equal(mut t, "a note", count(c, "SELECT count(*) FROM comments WHERE author_id IS NULL AND version = 1 AND body LIKE '%- fib: 100 -> 130 ms, 30.0% slower%'"), 1)
	crucible.Equal(mut t, "no macOS in it", count(c, "SELECT count(*) FROM comments WHERE body LIKE '%400%' OR body LIKE '%Darwin%'"), 0)
	// the job again (at least once): nothing twice
	_ = c.Exec("UPDATE events SET state = 'ready', next_at = now() WHERE kind = 'bench'") catch _ {
		postgres.Result{Affected: 0}
	}
	let rerun = work(c) catch _ {
		-1
	}
	crucible.Equal(mut t, "ran again", rerun, 2)
	crucible.Equal(mut t, "rows once", count(c, "SELECT count(*) FROM bench_results"), 4)
	crucible.Equal(mut t, "one note", count(c, "SELECT count(*) FROM comments"), 1)
	crucible.Equal(mut t, "one check", count(c, "SELECT count(*) FROM checks"), 1)
	// version 2 is fixed (95 ms): its check passes, and it gets no note
	let fixedLines = slowLines + lineOf(slow.Letters(), c1.Hex(), "95", "ms", 1760000200, "Linux") + "\n"
	let (c2, ids3) = commitWith(mut f.objs, "fn main() {{ fast() }}\n", fixedLines, []object.Id{m1}, slow, 1760000200) catch err {
		t.Error("commit: {err}")
		return
	}
	let (ev3, p3) = push(mut f, ids3, []transport.RefUpdate{move("refs/heads/slow", c1, c2)}, []transport.ChangeUpdate{version(slow, c1, c2)}) catch err {
		t.Error("push fixed: {err}")
		return
	}
	_ = fanOut(c, f.repo, ev3, p3) catch err {
		t.Error("enqueue: {err}")
		false
	}
	t.NoFault("the job", workAll(c))
	crucible.Equal(mut t, "a passing check", count(c, "SELECT count(*) FROM checks WHERE version = 2 AND state = 'success'"), 1)
	crucible.Equal(mut t, "still one note", count(c, "SELECT count(*) FROM comments"), 1)
	// a review opened later asks again for a version (Recheck), in its transaction
	_ = c.Exec("DELETE FROM checks") catch _ {
		postgres.Result{Affected: 0}
	}
	mut tx = c.Begin() catch err {
		t.Error("begin: {err}")
		return
	}
	let job = Recheck(mut tx, f.repo, slow.Letters(), 1) catch err {
		t.Error("recheck: {err}")
		0
	}
	t.True("a job", job > 0)
	t.NoFault("commit", tx.Commit())
	t.NoFault("the job", workAll(c))
	crucible.Equal(mut t, "the check again", count(c, "SELECT count(*) FROM checks WHERE version = 1 AND state = 'failure'"), 1)
	crucible.Equal(mut t, "and no second note", count(c, "SELECT count(*) FROM comments"), 1)
	let (_, noVersion) = CompareVersion(c, f.repo, slow.Letters(), 9)
	t.HasFault("no version 9", noVersion)
	// a recheck of a version that does not exist is done, not retried
	mut tx9 = c.Begin() catch err {
		t.Error("begin: {err}")
		return
	}
	let job9 = Recheck(mut tx9, f.repo, slow.Letters(), 9) catch err {
		t.Error("recheck 9: {err}")
		0
	}
	t.NoFault("commit", tx9.Commit())
	t.NoFault("the job", workAll(c))
	crucible.Equal(mut t, "done", count(c, "SELECT count(*) FROM events WHERE id = {job9} AND state = 'done'"), 1)
	// a push of a tag only queues no bench job
	let (_, quiet) = fanOut(c, f.repo, 999, "{{\"refs\":[{{\"name\":\"refs/tags/v1\",\"old\":\"\",\"new\":\"" + m1.Hex() + "\"}}],\"changes\":[]}}")
	t.NoFault("tag push", quiet)
	crucible.Equal(mut t, "no job for a tag", count(c, "SELECT count(*) FROM events WHERE kind = 'bench' AND payload->>'push' = '999'"), 0)

	// the API
	mut r = anvil.NewRouter()
	Mount(mut r)
	let base = "/api/v1/repos/ada/tin"
	let list = r.RunWith("GET", base + "/bench", []str{}, "")
	crucible.Equal(mut t, "list", list.Code(), 200)
	t.True("fib's counts", twine.Contains(str(list.Body), "{{\"name\":\"fib\",\"results\":5,\"linux_results\":3,"))
	let series = r.RunWith("GET", base + "/bench/fib", []str{}, "")
	crucible.Equal(mut t, "series", series.Code(), 200)
	let sb = str(series.Body)
	let linux = twine.Index(sb, "\"os\":\"Linux\"")
	let mac = twine.Index(sb, "\"os\":\"Darwin\"")
	t.True("Linux first, macOS apart", linux > 0 && mac > linux)
	t.True("macOS is development", twine.Contains(sb, "\"os\":\"Darwin\",\"arch\":\"x86_64\",\"cpu\":\"" + cpu + "\",\"machine\":\"Darwin x86_64, " + cpu + ", 8 cores\",\"unit\":\"ms\",\"development\":true"))
	t.True("oldest first", twine.Index(sb, "\"value\":100") < twine.Index(sb, "\"value\":130") && twine.Index(sb, "\"value\":130") < twine.Index(sb, "\"value\":95"))
	crucible.Equal(mut t, "no benchmark", r.RunWith("GET", base + "/bench/nope", []str{}, "").Code(), 404)
	let v1 = r.RunWith("GET", base + "/changes/" + slow.Letters() + "/bench?version=1", []str{}, "")
	crucible.Equal(mut t, "verdict", v1.Code(), 200)
	t.True("failure", twine.Contains(str(v1.Body), "\"state\":\"failure\"") && twine.Contains(str(v1.Body), "\"regressed\":true") && twine.Contains(str(v1.Body), "\"base\":\"" + m1.Hex() + "\""))
	let newestV = r.RunWith("GET", base + "/changes/" + slow.Letters() + "/bench", []str{}, "")
	t.True("the newest version passes", twine.Contains(str(newestV.Body), "\"version\":2") && twine.Contains(str(newestV.Body), "\"state\":\"success\""))
	crucible.Equal(mut t, "no change", r.RunWith("GET", base + "/changes/" + changeA + "/bench", []str{}, "").Code(), 404)
	_ = c.Exec("UPDATE repos SET visibility = 'private' WHERE id = {f.repo}") catch _ {
		postgres.Result{Affected: 0}
	}
	crucible.Equal(mut t, "private", r.RunWith("GET", base + "/bench", []str{}, "").Code(), 404)
	crucible.Equal(mut t, "the owner", r.RunWith("GET", base + "/bench", []str{"X-Test-User: {f.ada}"}, "").Code(), 200)
}

fn TestReleases(t mut crucible.T) {
	let got = testDb(mut t)
	if got == nil {
		return
	}
	let c = got
	mut f = newFixture(c) catch err {
		t.Error("fixture: {err}")
		return
	}
	let cid = object.NewChangeId()
	let (m1, ids) = commitWith(mut f.objs, "fn main() {{}}\n", "", []object.Id{}, cid, 1760000000) catch err {
		t.Error("commit: {err}")
		return
	}
	// ada's key signs v1.0, as tit ship does; v0.9 is signed by a key nobody registered; light is not annotated
	let seed = seal.RandomBytes(32)
	let pub = seal.Ed25519PublicKey(seed) catch err {
		t.Error("key: {err}")
		return
	}
	let text = seal.B64(pub)
	_ = c.Exec("INSERT INTO keys (user_id, public_key, name) VALUES ({f.ada}, {text}, 'laptop')") catch err {
		t.Error("key row: {err}")
		postgres.Result{Affected: 0}
	}
	let log = "v1.0\n\nChanges since v0.9 (1):\n\n- the first change (" + cid.Letters()[0:12] + ")\n"
	let t1 = object.TagData{Object: m1, Kind: object.Kind.Commit, Name: "v1.0", Tagger: person(1760000500), Signature: "", Message: log}
	let payload = object.TagSigningPayload(t1) catch err {
		t.Error("payload: {err}")
		return
	}
	let sig = seal.SignEd25519(seed, []u8(payload)) catch err {
		t.Error("sign: {err}")
		return
	}
	let signed = object.TagData{Object: m1, Kind: object.Kind.Commit, Name: "v1.0", Tagger: person(1760000500), Signature: str(sig), Message: log}
	let tag1 = f.objs.Put(object.Object.Tag(signed)) catch err {
		t.Error("tag: {err}")
		return
	}
	let other = seal.RandomBytes(32)
	let t0 = object.TagData{Object: m1, Kind: object.Kind.Commit, Name: "v0.9", Tagger: person(1760000400), Signature: "", Message: "v0.9\n\nChanges (0):\n\n"}
	let p0 = object.TagSigningPayload(t0) catch err {
		t.Error("payload: {err}")
		return
	}
	let sig0 = seal.SignEd25519(other, []u8(p0)) catch err {
		t.Error("sign: {err}")
		return
	}
	let tag0 = f.objs.Put(object.Object.Tag(object.TagData{Object: m1, Kind: object.Kind.Commit, Name: "v0.9", Tagger: person(1760000400), Signature: str(sig0), Message: t0.Message})) catch err {
		t.Error("tag: {err}")
		return
	}
	mut all = ids
	all = append(all, tag1, tag0)
	let (_, _, pushErr) = push(mut f, all, []transport.RefUpdate{move("refs/heads/main", object.NoId, m1), move("refs/tags/v1.0", object.NoId, tag1), move("refs/tags/v0.9", object.NoId, tag0), move("refs/tags/light", object.NoId, m1)}, []transport.ChangeUpdate{})
	if pushErr != nil {
		t.Error("push: {pushErr}")
		return
	}
	mut r = anvil.NewRouter()
	Mount(mut r)
	let base = "/api/v1/repos/ada/tin/releases"
	let list = r.RunWith("GET", base, []str{}, "")
	crucible.Equal(mut t, "list", list.Code(), 200)
	let body = str(list.Body)
	t.True("newest first", twine.Index(body, "\"name\":\"v1.0\"") >= 0 && twine.Index(body, "\"name\":\"v1.0\"") < twine.Index(body, "\"name\":\"v0.9\""))
	t.True("not the lightweight tag", !twine.Contains(body, "\"name\":\"light\""))
	t.True("verified", twine.Contains(body, "\"signed\":true,\"verified\":true,\"signed_by\":\"ada\""))
	t.True("signed, not verified", twine.Contains(body, "\"signed\":true,\"verified\":false,\"signed_by\":\"\""))
	t.True("the changelog", twine.Contains(body, "\"changes\":[{{\"title\":\"the first change\",\"change\":\"" + cid.Letters()[0:12] + "\"}}]"))
	let page = r.RunWith("GET", base + "?limit=1", []str{}, "")
	t.True("a page", twine.Contains(str(page.Body), "\"next\":\"1\"") && !twine.Contains(str(page.Body), "\"name\":\"v0.9\""))
	let second = r.RunWith("GET", base + "?limit=1&cursor=1", []str{}, "")
	t.True("the next page", twine.Contains(str(second.Body), "v0.9") && twine.Contains(str(second.Body), "\"next\":\"\""))
	crucible.Equal(mut t, "a bad cursor", r.RunWith("GET", base + "?cursor=x", []str{}, "").Code(), 400)
	let one = r.RunWith("GET", base + "/v1.0", []str{}, "")
	crucible.Equal(mut t, "one", one.Code(), 200)
	t.True("its commit", twine.Contains(str(one.Body), "\"commit\":\"" + m1.Hex() + "\"") && twine.Contains(str(one.Body), "\"title\":\"v1.0\""))
	crucible.Equal(mut t, "lightweight", r.RunWith("GET", base + "/light", []str{}, "").Code(), 404)
	crucible.Equal(mut t, "missing", r.RunWith("GET", base + "/v9", []str{}, "").Code(), 404)
	crucible.Equal(mut t, "no repository", r.RunWith("GET", "/api/v1/repos/ada/nope/releases", []str{}, "").Code(), 404)
}
