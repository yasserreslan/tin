package bench

import "../../tit/object"
import "../../tit/store"
import "../events"
import "../packs"
import "../repo"
import "anvil"
import "argo"
import "fault"
import "herald"
import "mint"
import "postgres"
import "seal"
import "tide"
import "twine"

// Benchmark history and releases (design/tinhub.md §13, #1029). tit bench keeps a result with the change it measured
// and the machine that measured it (OS, architecture, CPU, cores, kernel), one JSON line each in .tit/bench/<name>.jsonl;
// a repository publishes them by committing those files under .bench/ (the same lines, the same names). On every push
// the bench job reads .bench/*.jsonl from the pushed heads and change versions into bench_results, each line once, then
// compares every change version the push named with its base (the version's first parent): a Linux result more than
// Threshold slower than the base's, on the same benchmark, architecture and machine, fails the version's bench check
// and leaves a note on its review. macOS results are stored and charted on their own, never compared or charted with
// Linux ones (toolchain/docs/PERFORMANCE.md). The releases tit ship makes (annotated tags whose message is the
// changelog) are read from refs and objects: no table.

// KindBench is the bench job: a push's payload (its heads and change versions are read and compared), or
// {"change", "version"} to compare one version again (Recheck).
const KindBench = "bench"

// ResultsDir is the directory at a tree's root whose <name>.jsonl files hold tit bench's results.
const ResultsDir = ".bench"

// DefaultThreshold is how much slower than its base a Linux result may be before the version's check fails: 10%.
const DefaultThreshold = 0.10

// jobWithin and jobMemory are the bench job's budget (design/tinhub.md §6).
const jobWithin = 1 * tide.Minute

const jobMemory = 64 * 1024 * 1024

// fileMost is the largest results file read, filesMost the most files read from one tree, lineMost the longest line.
const fileMost = 8 * 1024 * 1024

const filesMost = 256

const lineMost = 4096

// Deps is what the bench job and its API need, set on every core (Configure, or Handlers on a worker).
type Deps struct {
	Db    postgres.Client
	Store dyn packs.PackStore
	// Dir is packs.dir (cache/ holds copies of packs the store has no local file for)
	Dir str
	// Auth is the signed-in user of an API request, 0 for nobody
	Auth fn(anvil.Req) !i64
	// Threshold is the fraction slower than the base that fails a version's bench check (0: DefaultThreshold)
	Threshold f64
	// PublicURL is public_url, for the check's link; "" leaves the link out
	PublicURL str
}

// NewDeps is Deps with the default threshold and no link.
fn NewDeps(c postgres.Client, s dyn packs.PackStore, dir str, auth fn(anvil.Req) !i64) Deps {
	return Deps{Db: c, Store: s, Dir: twine.TrimRight(dir, "/"), Auth: auth, Threshold: DefaultThreshold, PublicURL: ""}
}

// deps is this core's: globals are per core.
mut deps ?Deps = nil

// Configure sets this core's dependencies.
fn Configure(d Deps) {
	deps = keep(d)
}

fn depsOf() !Deps {
	let got = deps
	if got == nil {
		fail "bench: not configured on this core"
	}
	return got
}

// threshold is the configured threshold, or the default.
fn threshold(d Deps) f64 {
	if d.Threshold > 0.0 {
		return d.Threshold
	}
	return DefaultThreshold
}

// pgRepo is the repository over this core's store (read from the global: a store taken from a parameter's field trips
// a false E701, #1073). The job moves no refs, so it reads Postgres, not the ref cache.
fn pgRepo(repoId i64) !repo.PgRepo {
	let d = try depsOf()
	return repo.PgRepo{Db: d.Db, Store: d.Store, Cache: repo.NoCache(), Id: repoId, Dir: d.Dir, Who: 0}
}

// Handlers is the worker's bench handler; it configures this core with d as Configure does.
fn Handlers(d Deps) []events.Handler {
	Configure(d)
	return []events.Handler{events.Handler{Kind: KindBench, Within: jobWithin, Memory: jobMemory, Tasks: 0, MaxAttempts: 10, Run: runJob}}
}

// ErrNoVersion is the fault of a change version the repository does not have.
let ErrNoVersion = fault("no such change version")

// ---- the push's payload ----

type refMove struct {
	name str
	old  str
	new  str
}

type changeRef struct {
	change   str
	replaces str
	commit   str
}

// jobBody is a bench job's payload: a push's (refs and changes), or one version to compare again.
type jobBody struct {
	refs    []refMove
	changes []changeRef
	change  str
	version i64
}

fn parseJob(payload str) jobBody {
	mut b = jobBody{refs: []refMove{}, changes: []changeRef{}, change: "", version: 0}
	argo.Get(payload, mut b) catch _ {
		return jobBody{refs: []refMove{}, changes: []changeRef{}, change: "", version: 0}
	}
	return b
}

// isHex reports whether s is an object id: 64 lower-case hex digits.
fn isHex(s str) bool {
	if len(s) != 64 {
		return false
	}
	for c in s {
		if !((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')) {
			return false
		}
	}
	return true
}

// commitsOf is the commits a push brought whose trees may hold results: the new tips of branches and the commits of
// the change versions it added, each once.
fn commitsOf(b jobBody) []str {
	mut out = []str{}
	mut seen = map[str]bool{}
	for r in b.refs {
		if twine.HasPrefix(r.name, "refs/heads/") && isHex(r.new) && !seen[r.new] {
			seen[r.new] = true
			out = append(out, r.new)
		}
	}
	for c in b.changes {
		if isHex(c.commit) && !seen[c.commit] {
			seen[c.commit] = true
			out = append(out, c.commit)
		}
	}
	return out
}

// Enqueue queues the bench job of a push in the fan-out's transaction tx (workers/push.tin's followUps), keyed by the
// push event's id so a fan-out run again queues nothing twice; a push that moved no branch and added no version (a tag,
// a deletion) queues none, and neither does a worker that does not run the bench job (bench.Handlers, or Configure,
// was not called on this core), so no job waits for a handler nobody runs. It reports whether it queued one.
fn Enqueue(tx mut postgres.Tx, repoId i64, push i64, payload str) !bool {
	if deps == nil || len(commitsOf(parseJob(payload))) == 0 {
		return false
	}
	let ev = "{push}"
	let r = try tx.Exec("INSERT INTO events (kind, repo_id, payload) SELECT {KindBench}, {repoId}, {payload}::jsonb || jsonb_build_object('push', {push}) WHERE NOT EXISTS (SELECT 1 FROM events WHERE kind = {KindBench} AND repo_id = {repoId} AND payload->>'push' = {ev})")
	return r.Affected == 1
}

// Recheck queues, in tx, a bench job that compares one change version with its base again and records its check (and
// its note, once the review exists). Reviews (#1025) call it in the transaction that opens a review or adds a version,
// so a version pushed before its review still gets its note. It returns the job's id.
fn Recheck(tx mut postgres.Tx, repoId i64, change str, version i64) !i64 {
	mut body = []u8{}
	argo.Put(mut body, recheckBody{change: change, version: version})
	return try events.Enqueue(mut tx, KindBench, repoId, str(body))
}

type recheckBody struct {
	change  str
	version i64
}

// runJob is the bench job: compare one version again, or read a push's results and compare the versions it added.
fn runJob(j events.Job) ! {
	let d = try depsOf()
	let b = parseJob(j.Payload)
	if len(b.change) > 0 && b.version > 0 {
		let (_, err) = CompareVersion(d.Db, j.RepoId, b.change, b.version)
		// a version that is gone (or never was) has nothing to compare: the job is done, not retried
		if err != nil && !fault.Is(err, ErrNoVersion) {
			fail err
		}
		return
	}
	let commits = commitsOf(b)
	let n = try Ingest(j.RepoId, commits)
	if n > 0 {
		herald.Log(herald.LInfo, "bench results", []str{"repo", mint.Itoa(j.RepoId), "rows", mint.Itoa(n)})
	}
	// every version of a change these commits are: those the push named, and a branch tip a version row names
	let csv = twine.Join(commits, ",")
	let rows = try d.Db.Query("SELECT change_id, version FROM changes WHERE repo_id = {j.RepoId} AND commit_id = ANY(string_to_array({csv}, ',')) ORDER BY change_id, version")
	for row in rows.Rows {
		_ = try CompareVersion(d.Db, j.RepoId, row[0].Text(), row[1].Int())
	}
}

// ---- results ----

// machineIn and lineIn are one line of tit bench's results file (products/tit/cmd/bench.tin's Result).
type machineIn struct {
	Os     str
	Arch   str
	Cpu    str
	Kernel str
	Cores  str
}

type lineIn struct {
	Change  str
	Commit  str
	Value   str
	Unit    str
	Time    i64
	Machine machineIn
}

// Result is one benchmark result as bench_results keeps it.
type Result struct {
	Name   str
	Change str
	Commit str
	Value  f64
	Unit   str
	Os     str
	Arch   str
	Cpu    str
	Kernel str
	// Machine is what the comparison matches: the OS, architecture, CPU and cores (tit bench's machine without the
	// kernel, which an update changes under the same machine)
	Machine str
	// At is when it was recorded, in Unix seconds
	At i64
	// Hash is the hex SHA-256 of its file's name and its line: the same line read again is the same row
	Hash str
}

// ErrBadLine is the fault of a results line that is not tit bench's.
let ErrBadLine = fault("not a tit bench result")

// ValidName reports whether name can name a benchmark: tit bench's rule (no slashes, dots or spaces), at most 100 bytes.
fn ValidName(name str) bool {
	return len(name) > 0 && len(name) <= 100 && !twine.ContainsAny(name, "/\\ \t\n.")
}

fn short(s str, most i64) !str {
	if len(s) > most {
		fail fault.Wrap(ErrBadLine, "a field is longer than {most} bytes")
	}
	return s
}

// MachineOf is the machine a result's comparison matches: "<os> <arch>, <cpu>, <cores> cores".
fn MachineOf(os str, arch str, cpu str, cores str) str {
	return os + " " + arch + ", " + cpu + ", " + cores + " cores"
}

// ParseLine reads one line of the results file of benchmark name.
fn ParseLine(name str, text str) !Result {
	if !ValidName(name) {
		fail fault.Wrap(ErrBadLine, "{name} cannot name a benchmark")
	}
	if len(text) > lineMost {
		fail fault.Wrap(ErrBadLine, "a line longer than {lineMost} bytes")
	}
	mut l = lineIn{Change: "", Commit: "", Value: "", Unit: "", Time: 0, Machine: machineIn{Os: "", Arch: "", Cpu: "", Kernel: "", Cores: ""}}
	argo.Get(text, mut l) catch err {
		fail fault.Wrap(ErrBadLine, fault.Message(err))
	}
	if !isHex(l.Commit) {
		fail fault.Wrap(ErrBadLine, "the commit is not an object id")
	}
	let (_, cerr) = object.ParseChangeId(l.Change)
	if cerr != nil {
		fail fault.Wrap(ErrBadLine, "the change is not a change id")
	}
	let v = mint.ParseFloat(twine.TrimSpace(l.Value)) catch _ {
		fail fault.Wrap(ErrBadLine, "the value is not a number")
		0.0
	}
	if v != v || v > 1e300 || v < -1e300 {
		fail fault.Wrap(ErrBadLine, "the value is not a finite number")
	}
	if l.Time < 0 || l.Time > 100000000000 {
		fail fault.Wrap(ErrBadLine, "the time is not Unix seconds")
	}
	let m = l.Machine
	let os = try short(m.Os, 64)
	if len(os) == 0 {
		fail fault.Wrap(ErrBadLine, "no machine")
	}
	let arch = try short(m.Arch, 64)
	let cpu = try short(m.Cpu, 200)
	let kernel = try short(m.Kernel, 200)
	let cores = try short(m.Cores, 16)
	let unit = try short(l.Unit, 32)
	let hash = seal.Sha256Hex(name + "\n" + text)
	return Result{Name: name, Change: l.Change, Commit: l.Commit, Value: v, Unit: unit, Os: os, Arch: arch, Cpu: cpu, Kernel: kernel, Machine: MachineOf(os, arch, cpu, cores), At: l.Time, Hash: hash}
}

// ParseFile reads a results file: its results, and how many of its lines were not tit bench's (left out).
fn ParseFile(name str, text str) ([]Result, i64) {
	mut out = []Result{}
	mut bad = 0
	for raw in twine.Split(text, "\n") {
		let line = twine.TrimRight(raw, "\r")
		if len(twine.TrimSpace(line)) == 0 {
			continue
		}
		let r = ParseLine(name, line) catch _ {
			bad += 1
			continue
		}
		out = append(out, r)
	}
	return out, bad
}

// resultFile is one .bench/<name>.jsonl of a tree.
type resultFile struct {
	name str
	blob object.Id
}

// entriesOf is a tree's entries, none when the object is not a tree.
fn entriesOf(objs mut store.Layered, id object.Id) ![]object.Entry {
	let o = try objs.Get(id)
	match o {
		Tree(es) => {
			return es
		}
		_ => {
		}
	}
	return []object.Entry{}
}

// FilesAt is the results files at a commit's .bench/, in name order (as the tree holds them), at most filesMost.
fn FilesAt(objs mut store.Layered, commit object.Id) ![]resultFile {
	let o = try objs.Get(commit)
	mut tree = object.NoId
	match o {
		Commit(c) => {
			tree = c.Tree
		}
		_ => {
			// a branch at a tag or a tree holds no results
			return []resultFile{}
		}
	}
	mut out = []resultFile{}
	let root = try entriesOf(mut objs, tree)
	for e in root {
		if e.Name != ResultsDir || e.Mode != object.Mode.Dir {
			continue
		}
		let files = try entriesOf(mut objs, e.Id)
		for f in files {
			if f.Mode != object.Mode.File && f.Mode != object.Mode.Exec {
				continue
			}
			if !twine.HasSuffix(f.Name, ".jsonl") {
				continue
			}
			let name = f.Name[0:len(f.Name) - 6]
			if !ValidName(name) {
				continue
			}
			if len(out) == filesMost {
				return out
			}
			out = append(out, resultFile{name: name, blob: f.Id})
		}
	}
	return out
}

// Ingest reads the results files of the commits (hex ids; one that is not in the repository's packs is a fault) into
// bench_results, each file's blob once and each line once; the rows it added.
fn Ingest(repoId i64, commits []str) !i64 {
	let d = try depsOf()
	if len(commits) == 0 {
		return 0
	}
	mut r = try pgRepo(repoId)
	mut objs = try r.Objects()
	mut added = 0
	for hex in commits {
		let id = try object.ParseId(hex)
		let files = try FilesAt(mut objs, id)
		for f in files {
			added += try ingestFile(d.Db, mut objs, repoId, f)
		}
	}
	return added
}

// ingestFile adds one results file's lines, in one transaction with its bench_files row; the rows it added.
fn ingestFile(c postgres.Client, objs mut store.Layered, repoId i64, f resultFile) !i64 {
	let blob = f.blob.Hex()
	let done = try c.Query("SELECT 1 FROM bench_files WHERE repo_id = {repoId} AND blob = {blob}")
	if len(done.Rows) > 0 {
		return 0
	}
	let (kind, body) = try objs.GetRaw(f.blob)
	if kind != object.Kind.Blob {
		return 0
	}
	if len(body) > fileMost {
		herald.Log(herald.LWarn, "bench results file too large", []str{"repo", mint.Itoa(repoId), "name", f.name, "bytes", mint.Itoa(len(body))})
		return 0
	}
	let (results, bad) = ParseFile(f.name, body)
	if bad > 0 {
		herald.Log(herald.LWarn, "bench results lines left out", []str{"repo", mint.Itoa(repoId), "name", f.name, "lines", mint.Itoa(bad)})
	}
	mut tx = try c.Begin()
	let (n, err) = insertAll(mut tx, repoId, blob, results)
	if err != nil {
		tx.Rollback() catch _ {
		}
		fail err
	}
	try tx.Commit()
	return n
}

fn insertAll(tx mut postgres.Tx, repoId i64, blob str, results []Result) !i64 {
	mut n = 0
	for r in results {
		let res = try tx.Exec("INSERT INTO bench_results (repo_id, commit_id, change_id, name, value, unit, os, arch, cpu, kernel, machine, created_at, line_hash) VALUES ({repoId}, {r.Commit}, {r.Change}, {r.Name}, {r.Value}, {r.Unit}, {r.Os}, {r.Arch}, {r.Cpu}, {r.Kernel}, {r.Machine}, to_timestamp({r.At}), {r.Hash}) ON CONFLICT DO NOTHING")
		n += res.Affected
	}
	let count = len(results)
	_ = try tx.Exec("INSERT INTO bench_files (repo_id, blob, lines) VALUES ({repoId}, {blob}, {count}) ON CONFLICT DO NOTHING")
	return n
}
