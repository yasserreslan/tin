package bench

import "../../tit/object"
import "../accounts"
import "postgres"
import "seal"
import "sift"
import "twine"

// Releases (design/tinhub.md §13): what tit ship records, read from refs and objects. A release is an annotated tag
// under refs/tags/ (tit ship's: the tag's message is the changelog, "<version>\n\nChanges since <last> (N):\n\n- <first
// line> (<change, 12 letters>)" a change), signed with the shipper's key when they have one. A signature is verified
// when a key registered to the tinhub account with the tagger's email made it. Lightweight tags are not releases.

// ReleaseChange is one line of a release's changelog.
type ReleaseChange struct {
	Title  str
	Change str
}

// Release is one release.
type Release struct {
	// Name is the tag's name (refs/tags/<Name>), Tag the tag object, Commit what it tags
	Name   str
	Tag    str
	Commit str
	// Title is the message's first line (the version), Message the whole changelog
	Title   str
	Message str
	Changes []ReleaseChange
	Tagger  object.Person
	// Signed reports a signature; Verified that a key of SignedBy (the tagger's tinhub account) made it
	Signed   bool
	Verified bool
	SignedBy str
}

// releasesMost is the most tags one listing reads.
const releasesMost = 2000

// changesOf reads a changelog's "- <title> (<change>)" lines.
fn changesOf(message str) []ReleaseChange {
	mut out = []ReleaseChange{}
	for line in twine.Split(message, "\n") {
		if !twine.HasPrefix(line, "- ") || !twine.HasSuffix(line, ")") {
			continue
		}
		let open = twine.LastIndex(line, " (")
		if open < 2 {
			continue
		}
		let id = line[open + 2:len(line) - 1]
		mut letters = true
		for c in id {
			if c < 'a' || c > 'z' {
				letters = false
			}
		}
		if !letters || len(id) == 0 || len(id) > 32 {
			continue
		}
		out = append(out, ReleaseChange{Title: line[2:open], Change: id})
	}
	return out
}

fn firstLine(s str) str {
	let nl = twine.IndexByte(s, '\n')
	if nl < 0 {
		return s
	}
	return s[0:nl]
}

// signerCache is the verifying keys of each tagger's email, read once per listing.
type signer struct {
	name str
	keys [][]u8
}

fn signerOf(c postgres.Client, cache mut map[str]signer, email str) !signer {
	let key = twine.ToLower(email)
	let (got, ok) = cache[key]
	if ok {
		return got
	}
	mut s = signer{name: "", keys: [][]u8{}}
	let u = try accounts.UserByEmail(c, email)
	if u != nil {
		let ks = try accounts.KeysOf(c, u.Id)
		s = signer{name: u.Name, keys: ks}
	}
	cache[key] = s
	return s
}

// releaseOf is the release a tag object makes.
fn releaseOf(c postgres.Client, cache mut map[str]signer, name str, tagId object.Id, t object.TagData) !Release {
	mut rel = Release{Name: name, Tag: tagId.Hex(), Commit: t.Object.Hex(), Title: firstLine(t.Message), Message: t.Message, Changes: changesOf(t.Message), Tagger: t.Tagger, Signed: len(t.Signature) > 0, Verified: false, SignedBy: ""}
	if !rel.Signed {
		return rel
	}
	let s = try signerOf(c, mut cache, t.Tagger.Email)
	if len(s.keys) == 0 {
		return rel
	}
	let payload = object.TagSigningPayload(t) catch _ {
		return rel
	}
	for k in s.keys {
		let err = seal.VerifyEd25519(k, []u8(payload), []u8(t.Signature))
		if err == nil {
			rel.Verified = true
			rel.SignedBy = s.name
			return rel
		}
	}
	return rel
}

// Releases is a repository's releases, newest (by the tagger's time) first.
fn Releases(c postgres.Client, repoId i64) ![]Release {
	mut r = try pgRepo(repoId)
	let refs = try r.Refs("refs/tags/")
	mut out = []Release{}
	if len(refs) == 0 {
		return out
	}
	mut objs = try r.Objects()
	mut cache = map[str]signer{}
	for ref in refs {
		if len(out) == releasesMost {
			break
		}
		mut id = object.NoId
		match ref.Target {
			Commit(x) => {
				id = x
			}
			Change(_) => {
			}
		}
		if id == object.NoId {
			continue
		}
		let o = objs.Get(id) catch _ {
			continue
		}
		match o {
			Tag(t) => {
				let rel = try releaseOf(c, mut cache, ref.Name[10:], id, t)
				out = append(out, rel)
			}
			_ => {
			}
		}
	}
	sift.SortFunc(mut out, fn(a Release, b Release) i64 {
		if a.Tagger.When != b.Tagger.When {
			if a.Tagger.When > b.Tagger.When {
				return -1
			}
			return 1
		}
		if a.Name < b.Name {
			return -1
		}
		if a.Name > b.Name {
			return 1
		}
		return 0
	})
	return out
}

// ReleaseNamed is the release tagged name, nil when refs/tags/<name> is missing or not an annotated tag.
fn ReleaseNamed(c postgres.Client, repoId i64, name str) !?Release {
	mut r = try pgRepo(repoId)
	let ref = try r.Ref("refs/tags/" + name)
	if ref == nil {
		return nil
	}
	mut id = object.NoId
	match ref.Target {
		Commit(x) => {
			id = x
		}
		Change(_) => {
		}
	}
	if id == object.NoId {
		return nil
	}
	mut objs = try r.Objects()
	let o = try objs.Get(id)
	mut cache = map[str]signer{}
	match o {
		Tag(t) => {
			return try releaseOf(c, mut cache, name, id, t)
		}
		_ => {
		}
	}
	return nil
}
