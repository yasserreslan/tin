package signin

import "../../tit/transport"
import "../accounts"
import "anvil"
import "fault"
import "herald"
import "postgres"
import "tide"
import "tinjson"
import "twine"

// Sign-in on the node (design/tinhub.md §11, #1012): the requests of design/tit.md §18 (POST /tit/v1/login,
// GET|POST /tit/v1/login/<code>, POST /tit/v1/keys) at the root and under a repository's URL, the browser's claim of an
// approved code (POST /tit/v1/login/<code>/session, with its tinhub_login cookie), sign-out (POST /tit/v1/logout), and
// the API's caller: the user a tinhub_session cookie signs in.

// Deps is what sign-in needs, set on every core (Configure) before the first request.
type Deps struct {
	Db        postgres.Client
	Sessions  accounts.Sessions
	NonceKey  secret str
	CookieKey secret str
	PublicUrl str
	// Secure marks cookies Secure: public_url is https
	Secure bool
}

mut deps ?Deps = nil

// Configure sets this core's dependencies.
fn Configure(d Deps) {
	deps = keep(d)
}

// Mount adds the root routes to r; protocol routes under a repository reach Serve through the protocol's handler.
fn Mount(r mut anvil.Router) {
	r.Post("/tit/v1/login", Serve)
	r.Post("/tit/v1/keys", Serve)
	r.Post("/tit/v1/logout", logout)
	r.Get(`/tit/v1/login/{code}`, Serve)
	r.Post(`/tit/v1/login/{code}`, Serve)
	r.Post(`/tit/v1/login/{code}/session`, claim)
}

// Handles reports whether a protocol path is one of sign-in's: the protocol's handler passes those to Serve.
fn Handles(path str) bool {
	let at = twine.Index(path, "/tit/v1/")
	if at < 0 {
		return false
	}
	let tail = path[at + 8:]
	return tail == "login" || tail == "keys" || (twine.HasPrefix(tail, "login/") && !twine.Contains(tail[6:], "/"))
}

fn now() i64 {
	return tide.Wall() / tide.Second
}

// Serve answers a §18 request.
fn Serve(q anvil.Req, w mut anvil.Out) {
	ServeBody(q, mut w, q.Body())
}

// ServeBody answers a §18 request whose body the caller read already (a streaming route's).
fn ServeBody(q anvil.Req, w mut anvil.Out, body str) {
	let got = deps
	if got == nil {
		w.Status(503)
		w.Text("sign-in is not configured on this core")
		return
	}
	let d = got
	let s = accounts.Service{Db: d.Db, Sessions: d.Sessions, NonceKey: d.NonceKey, CookieKey: d.CookieKey, PublicUrl: d.PublicUrl}
	let a = s.Handle(q.Method, q.Path, q.Header("tit-signature"), body, q.ClientIP(), now())
	w.Status(a.Status)
	w.Type(a.ContentType)
	if len(a.LoginCookie) > 0 {
		w.SetCookie(cookie(d, accounts.LoginCookieName, a.LoginCookie, accounts.LoginTTL))
	}
	w.Body = []u8(a.Body)
}

fn cookie(d Deps, name str, value str, maxAge i64) anvil.Cookie {
	return anvil.Cookie{Name: name, Value: value, Path: "/", Domain: "", Expires: 0, MaxAge: maxAge, Secure: d.Secure, HttpOnly: true, SameSite: "Lax", Partitioned: false, Quoted: false}
}

// claim turns an approved code into a session for the browser holding its claim token.
fn claim(q anvil.Req, w mut anvil.Out) {
	let got = deps
	if got == nil {
		w.Status(503)
		w.Text("sign-in is not configured on this core")
		return
	}
	let d = got
	let s = accounts.Service{Db: d.Db, Sessions: d.Sessions, NonceKey: d.NonceKey, CookieKey: d.CookieKey, PublicUrl: d.PublicUrl}
	let session = s.Claim(q.PathParam("code"), q.Cookie(accounts.LoginCookieName), q.ClientIP()) catch err {
		let (code, message) = accounts.CodeOf(err)
		w.Status(transport.Status(code))
		w.Type("application/json")
		let name = transport.CodeName(code)
		w.Body = []u8("{{\"code\":" + tinjson.Quote(name) + ",\"message\":" + tinjson.Quote(message) + "}}")
		return
	}
	w.SetCookie(cookie(d, accounts.CookieName, session.Cookie, session.MaxAge))
	w.SetCookie(cookie(d, accounts.LoginCookieName, "", -1))
	w.Type("application/json")
	let uid = session.UserId
	w.Body = []u8("{{\"user\":{uid}}}")
}

// logout ends the session the request's cookie names.
fn logout(q anvil.Req, w mut anvil.Out) {
	let got = deps
	if got == nil {
		w.Status(503)
		return
	}
	let d = got
	d.Sessions.End(q.Cookie(accounts.CookieName)) catch err {
		herald.Log(herald.LWarn, "sign-out", []str{"error", fault.Message(err)})
	}
	w.SetCookie(cookie(d, accounts.CookieName, "", -1))
	w.Status(204)
}

// Caller is the user a request's session cookie signs in, 0 for nobody: the API's Auth. Redis failing counts as
// signed out.
fn Caller(q anvil.Req) !i64 {
	let got = deps
	if got == nil {
		return 0
	}
	let d = got
	let c = q.Cookie(accounts.CookieName)
	if len(c) == 0 {
		return 0
	}
	let u = accounts.SessionUser(d.Db, d.Sessions, c) catch _ {
		return 0
	}
	if u == nil {
		return 0
	}
	return u.Id
}
