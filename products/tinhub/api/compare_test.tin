package api

import "../../tit/object"
import "../../tit/revwalk"
import "../../tit/store"
import "crucible"

// Tests for a compare's split point, on this history (times in brackets):
//
//   c1[1] - c2[2] - c3[3]            main
//                \
//                 b1[4] - b2[5]      feature        x1[6] shares nothing

fn put(s mut store.Mem, ids mut map[str]object.Id, name str, parents []str, when i64) {
	mut ps = []object.Id{}
	for p in parents {
		ps = append(ps, ids[p])
	}
	let tree = s.Put(object.Object.Tree([]object.Entry{})) catch _ {
		object.NoId
	}
	let who = object.Person{Name: "A", Email: "a@x", When: when, Zone: 0}
	let c = object.CommitData{Tree: tree, Parents: ps, Change: object.AdoptedChangeId(name), Author: who, Committer: who, GitHeaders: []str{}, Signature: "", Message: name + "\n", Conflicts: []str{}}
	ids[name] = s.Put(object.Object.Commit(c)) catch _ {
		object.NoId
	}
}

// split is where to left from, and how many commits to has that from lacks.
fn split(s mut store.Mem, ids map[str]object.Id, from str, to str) (str, i64) {
	let (listed, datas) = revwalk.WalkCommits(mut s, []object.Id{ids[to]}, []object.Id{ids[from]}, revwalk.Order.Date, 0) catch _ {
		return "walk failed", 0
	}
	let at = splitPoint(mut s, listed, datas, ids[from], ids[to]) catch _ {
		return "split failed", 0
	}
	for name, id in ids {
		if id == at {
			return name, len(listed)
		}
	}
	return "none", len(listed)
}

fn TestSplitPoint(t mut crucible.T) {
	mut s = store.NewMem()
	mut ids = map[str]object.Id{}
	put(mut s, mut ids, "c1", []str{}, 1)
	put(mut s, mut ids, "c2", []str{"c1"}, 2)
	put(mut s, mut ids, "c3", []str{"c2"}, 3)
	put(mut s, mut ids, "b1", []str{"c2"}, 4)
	put(mut s, mut ids, "b2", []str{"b1"}, 5)
	put(mut s, mut ids, "x1", []str{}, 6)
	let (a, an) = split(mut s, ids, "c3", "b2")
	t.True("a branch left main at c2 with two commits: {a} {an}", a == "c2" && an == 2)
	let (b, bn) = split(mut s, ids, "b2", "c3")
	t.True("main has one commit the branch lacks, since c2: {b} {bn}", b == "c2" && bn == 1)
	let (c, cn) = split(mut s, ids, "c3", "c2")
	t.True("an ancestor has nothing new and is its own point: {c} {cn}", c == "c2" && cn == 0)
	let (d, dn) = split(mut s, ids, "c3", "x1")
	t.True("unrelated histories compare with from: {d} {dn}", d == "c3" && dn == 1)
}
