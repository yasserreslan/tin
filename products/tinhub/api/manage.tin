package api

import "../accounts"
import "anvil"
import "argo"
import "fault"
import "mint"
import "postgres"
import "twine"

// Repository management (design/tinhub.md §15, #1085): create, settings, delete, access, the mirror and the audit log.
// Every write goes through accounts (its access check and audit row, in one transaction).

// repoDetail is one repository as its page shows it, with the caller's role on it and whether they follow it.
type repoDetail struct {
	owner          str
	owner_kind     str
	name           str
	visibility     str
	description    str
	default_branch str
	size_bytes     i64
	quota_bytes    i64
	pushed_at      i64
	created_at     i64
	role           str
	following      bool
	changes        i64
	open_reviews   i64
}

fn detailOf(c call, r accounts.Repo) !repoDetail {
	let role = try accounts.RoleOf(c.d.Db, c.user, r)
	let u = c.user
	let rows = try c.d.Db.Query("SELECT r.description, r.default_branch, coalesce((SELECT extract(epoch FROM max(f.updated_at))::bigint FROM refs f WHERE f.repo_id = r.id), 0), extract(epoch FROM r.created_at)::bigint, (SELECT count(*) FROM subscriptions s WHERE s.user_id = {u} AND s.repo_id = r.id AND s.change_id = ''), o.kind, (SELECT count(DISTINCT change_id) FROM changes v WHERE v.repo_id = r.id), (SELECT count(*) FROM reviews v WHERE v.repo_id = r.id AND v.state IN ('open', 'approved', 'changes_requested')) FROM repos r JOIN owners o ON o.id = r.owner_id WHERE r.id = {r.Id}")
	if len(rows.Rows) == 0 {
		fail fault.Wrap(accounts.ErrNotFound, "{r.Owner}/{r.Name}")
	}
	let x = rows.Rows[0]
	return repoDetail{owner: r.Owner, owner_kind: x[5].Text(), name: r.Name, visibility: r.Visibility, description: x[0].Text(), default_branch: x[1].Text(), size_bytes: r.SizeBytes, quota_bytes: r.QuotaBytes, pushed_at: x[2].Int(), created_at: x[3].Int(), role: accounts.RoleName(role), following: x[4].Int() > 0, changes: x[6].Int(), open_reviews: x[7].Int()}
}

fn sendDetail(c call, w mut anvil.Out, r accounts.Repo) {
	let (out, err) = detailWithin(c, r)
	if err != nil {
		answerErr(mut w, err)
		return
	}
	send(mut w, out)
}

fn detailWithin(c call, r accounts.Repo) !repoDetail {
	mut out ?repoDetail = nil
	try within readWithin {
		let d = try detailOf(c, r)
		out = keep(d)
	}
	if out == nil {
		fail fault.Wrap(accounts.ErrNotFound, "{r.Owner}/{r.Name}")
	}
	return out
}

type newRepoIn struct {
	owner       str
	name        str
	visibility  str
	description str
}

// createRepo makes a repository for the caller, an org they own, or (a site admin) anyone: 201 and the repository.
fn createRepo(q anvil.Req, w mut anvil.Out) {
	let c = signedIn(q, mut w, false)
	if c == nil {
		return
	}
	mut v = newRepoIn{owner: "", name: "", visibility: "public", description: ""}
	if !decode(q, mut w, mut v) {
		return
	}
	if len(v.owner) == 0 {
		let me = accounts.UserById(c.d.Db, c.user) catch err {
			answerErr(mut w, err)
			return
		}
		if me == nil {
			fail_(mut w, 401, "unauthorized", "sign in to do that")
			return
		}
		v.owner = me.Name
	}
	let (r, err) = makeRepo(c, actorOf(c, q), v)
	if err != nil {
		answerErr(mut w, err)
		return
	}
	w.Status(201)
	sendDetail(c, mut w, r)
}

fn makeRepo(c call, by accounts.Actor, v newRepoIn) !accounts.Repo {
	mut out ?accounts.Repo = nil
	try within writeWithin {
		mut r = try accounts.CreateRepo(c.d.Db, by, v.owner, v.name, v.visibility, c.d.Quota)
		let desc = twine.TrimSpace(v.description)
		if len(desc) > 0 {
			r = try accounts.SetRepoInfo(c.d.Db, by, r, accounts.RepoInfo{Description: desc, DefaultBranch: r.DefaultBranch})
		}
		out = keep(r)
	}
	if out == nil {
		fail "no repository"
	}
	return out
}

type repoPatch struct {
	name           str
	visibility     str
	description    str
	default_branch str
}

// patchRepo changes a repository's name, visibility, description and default branch (admin); members the body leaves
// out keep their values.
fn patchRepo(q anvil.Req, w mut anvil.Out) {
	let c = withRole(q, mut w, accounts.RoleAdmin)
	if c == nil {
		return
	}
	let info = accounts.InfoOf(c.d.Db, c.r) catch err {
		answerErr(mut w, err)
		return
	}
	mut v = repoPatch{name: c.r.Name, visibility: c.r.Visibility, description: info.Description, default_branch: info.DefaultBranch}
	if !decode(q, mut w, mut v) {
		return
	}
	let (r, err) = changeRepo(c, actorOf(c, q), info, v)
	if err != nil {
		answerErr(mut w, err)
		return
	}
	sendDetail(c, mut w, r)
}

fn changeRepo(c call, by accounts.Actor, info accounts.RepoInfo, v repoPatch) !accounts.Repo {
	mut out ?accounts.Repo = nil
	try within writeWithin {
		mut r = c.r
		if v.visibility != r.Visibility {
			r = try accounts.SetVisibility(c.d.Db, by, r, v.visibility)
		}
		let desc = twine.TrimSpace(v.description)
		if desc != info.Description || v.default_branch != info.DefaultBranch {
			r = try accounts.SetRepoInfo(c.d.Db, by, r, accounts.RepoInfo{Description: desc, DefaultBranch: v.default_branch})
		}
		if v.name != r.Name {
			r = try accounts.RenameRepo(c.d.Db, by, r, v.name)
		}
		out = keep(r)
	}
	if out == nil {
		fail "no repository"
	}
	return out
}

fn deleteRepo(q anvil.Req, w mut anvil.Out) {
	let c = withRole(q, mut w, accounts.RoleAdmin)
	if c == nil {
		return
	}
	accounts.DeleteRepo(c.d.Db, actorOf(c, q), c.r) catch err {
		answerErr(mut w, err)
		return
	}
	noContent(mut w)
}

// ---- access ----

type grantUserOut struct {
	name    str
	display str
	role    str
}

type grantTeamOut struct {
	name    str
	role    str
	members i64
}

type accessOut struct {
	users []grantUserOut
	teams []grantTeamOut
	// owners is who has admin by owning the repository (the user, or the org's owners)
	owners []grantUserOut
}

// collaborators is who has access to the repository beyond its visibility: grants to users and teams, and the owners.
fn collaborators(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, true)
	if c == nil {
		return
	}
	let (out, err) = readAccess(c)
	if err != nil {
		answerErr(mut w, err)
		return
	}
	send(mut w, out)
}

fn readAccess(c call) !accessOut {
	mut out = accessOut{users: []grantUserOut{}, teams: []grantTeamOut{}, owners: []grantUserOut{}}
	try within readWithin {
		let id = c.r.Id
		let ownerId = c.r.OwnerId
		let us = try c.d.Db.Query("SELECT o.name, u.display, x.role FROM grants x JOIN users u ON u.id = x.user_id JOIN owners o ON o.id = u.owner_id WHERE x.repo_id = {id} AND u.deleted_at IS NULL ORDER BY o.name")
		let ts = try c.d.Db.Query("SELECT t.name, x.role, (SELECT count(*) FROM team_members m WHERE m.team_id = t.id) FROM grants x JOIN teams t ON t.id = x.team_id WHERE x.repo_id = {id} ORDER BY t.name")
		let os = try c.d.Db.Query("SELECT o.name, u.display FROM users u JOIN owners o ON o.id = u.owner_id WHERE u.deleted_at IS NULL AND (u.owner_id = {ownerId} OR u.id IN (SELECT m.user_id FROM members m JOIN orgs g ON g.id = m.org_id WHERE g.owner_id = {ownerId} AND m.role = 'owner' AND g.deleted_at IS NULL)) ORDER BY o.name")
		mut page = accessOut{users: []grantUserOut{}, teams: []grantTeamOut{}, owners: []grantUserOut{}}
		for x in us.Rows {
			page.users = append(page.users, grantUserOut{name: x[0].Text(), display: x[1].Text(), role: x[2].Text()})
		}
		for x in ts.Rows {
			page.teams = append(page.teams, grantTeamOut{name: x[0].Text(), role: x[1].Text(), members: x[2].Int()})
		}
		for x in os.Rows {
			page.owners = append(page.owners, grantUserOut{name: x[0].Text(), display: x[1].Text(), role: "admin"})
		}
		out = keep(page)
	}
	return out
}

type roleIn struct {
	role str
}

// userByName is the live user called name; answered 404 (and nil) when there is none.
fn userByName(c call, w mut anvil.Out, name str) ?accounts.User {
	let u = accounts.UserByName(c.d.Db, name) catch err {
		answerErr(mut w, err)
		return nil
	}
	if u == nil {
		fail_(mut w, 404, "not_found", "no user {name}")
		return nil
	}
	return u
}

fn putCollaborator(q anvil.Req, w mut anvil.Out) {
	let c = withRole(q, mut w, accounts.RoleAdmin)
	if c == nil {
		return
	}
	mut v = roleIn{role: "read"}
	if !decode(q, mut w, mut v) {
		return
	}
	let role = accounts.ParseRole(v.role) catch err {
		answerErr(mut w, err)
		return
	}
	let u = userByName(c, mut w, q.PathParam("user"))
	if u == nil {
		return
	}
	accounts.GrantUser(c.d.Db, actorOf(c, q), c.r, u.Id, role) catch err {
		answerErr(mut w, err)
		return
	}
	noContent(mut w)
}

fn deleteCollaborator(q anvil.Req, w mut anvil.Out) {
	let c = withRole(q, mut w, accounts.RoleAdmin)
	if c == nil {
		return
	}
	let u = userByName(c, mut w, q.PathParam("user"))
	if u == nil {
		return
	}
	accounts.GrantUser(c.d.Db, actorOf(c, q), c.r, u.Id, accounts.RoleNone) catch err {
		answerErr(mut w, err)
		return
	}
	noContent(mut w)
}

// teamOf is the team called name of the org that owns the call's repository; answered (and nil) when there is none.
fn teamOf(c call, w mut anvil.Out, name str) ?accounts.Team {
	let g = accounts.OrgByName(c.d.Db, c.r.Owner) catch err {
		answerErr(mut w, err)
		return nil
	}
	if g == nil {
		fail_(mut w, 422, "invalid", "{c.r.Owner} is not an org: only an org's repositories have team grants")
		return nil
	}
	let t = accounts.TeamByName(c.d.Db, g.Id, name) catch err {
		answerErr(mut w, err)
		return nil
	}
	if t == nil {
		fail_(mut w, 404, "not_found", "{c.r.Owner} has no team {name}")
		return nil
	}
	return t
}

fn putTeamGrant(q anvil.Req, w mut anvil.Out) {
	let c = withRole(q, mut w, accounts.RoleAdmin)
	if c == nil {
		return
	}
	mut v = roleIn{role: "read"}
	if !decode(q, mut w, mut v) {
		return
	}
	let role = accounts.ParseRole(v.role) catch err {
		answerErr(mut w, err)
		return
	}
	let t = teamOf(c, mut w, q.PathParam("team"))
	if t == nil {
		return
	}
	accounts.GrantTeam(c.d.Db, actorOf(c, q), c.r, t.Id, role) catch err {
		answerErr(mut w, err)
		return
	}
	noContent(mut w)
}

fn deleteTeamGrant(q anvil.Req, w mut anvil.Out) {
	let c = withRole(q, mut w, accounts.RoleAdmin)
	if c == nil {
		return
	}
	let t = teamOf(c, mut w, q.PathParam("team"))
	if t == nil {
		return
	}
	accounts.GrantTeam(c.d.Db, actorOf(c, q), c.r, t.Id, accounts.RoleNone) catch err {
		answerErr(mut w, err)
		return
	}
	noContent(mut w)
}

// ---- the mirror ----

type mirrorOut struct {
	url         str
	has_token   bool
	active      bool
	mirrored_at i64
	last_error  str
}

fn getMirror(q anvil.Req, w mut anvil.Out) {
	let c = withRole(q, mut w, accounts.RoleAdmin)
	if c == nil {
		return
	}
	let m = accounts.MirrorOf(c.d.Db, c.r) catch err {
		answerErr(mut w, err)
		return
	}
	if m == nil {
		fail_(mut w, 404, "not_found", "{c.r.Owner}/{c.r.Name} has no mirror")
		return
	}
	send(mut w, mirrorOut{url: m.Url, has_token: m.HasToken, active: m.Active, mirrored_at: m.Mirrored, last_error: m.LastError})
}

type mirrorIn struct {
	url    str
	token  str
	active bool
	// keep_token keeps the stored token when token is ""
	keep_token bool
}

fn putMirror(q anvil.Req, w mut anvil.Out) {
	let c = withRole(q, mut w, accounts.RoleAdmin)
	if c == nil {
		return
	}
	mut v = mirrorIn{url: "", token: "", active: true, keep_token: true}
	if !decode(q, mut w, mut v) {
		return
	}
	let keepToken = v.keep_token && len(v.token) == 0
	accounts.SetMirror(c.d.Db, actorOf(c, q), c.r, twine.TrimSpace(v.url), v.token, keepToken, v.active) catch err {
		answerErr(mut w, err)
		return
	}
	noContent(mut w)
}

fn deleteMirror(q anvil.Req, w mut anvil.Out) {
	let c = withRole(q, mut w, accounts.RoleAdmin)
	if c == nil {
		return
	}
	let gone = accounts.DeleteMirror(c.d.Db, actorOf(c, q), c.r) catch err {
		answerErr(mut w, err)
		return
	}
	if !gone {
		fail_(mut w, 404, "not_found", "{c.r.Owner}/{c.r.Name} has no mirror")
		return
	}
	noContent(mut w)
}

// ---- the audit log ----

// auditJson writes audit rows as {"entries": [{"id", "at", "actor", "action", "target_kind", "target_id", "detail",
// "ip"}], "next"}; the detail is the row's JSON as it is.
fn auditJson(rows postgres.Rows, n i64, ip bool) str {
	mut b = []u8{}
	b = append(b, "{{\"entries\":["...)
	mut last = 0
	for i, x in rows.Rows {
		if i == n {
			break
		}
		if i > 0 {
			b = append(b, ',')
		}
		last = x[0].Int()
		b = append(b, "{{\"id\":"...)
		b = append(b, mint.Itoa(x[0].Int())...)
		b = append(b, ",\"at\":"...)
		b = append(b, mint.Itoa(x[1].Int())...)
		b = append(b, ",\"actor\":"...)
		argo.Put(mut b, x[2].Text())
		b = append(b, ",\"action\":"...)
		argo.Put(mut b, x[3].Text())
		b = append(b, ",\"target_kind\":"...)
		argo.Put(mut b, x[4].Text())
		b = append(b, ",\"target_id\":"...)
		b = append(b, mint.Itoa(x[5].Int())...)
		b = append(b, ",\"detail\":"...)
		let d = x[6].Text()
		if len(d) == 0 {
			b = append(b, "null"...)
		} else {
			b = append(b, d...)
		}
		if ip {
			b = append(b, ",\"ip\":"...)
			argo.Put(mut b, x[7].Text())
		}
		b = append(b, '}')
	}
	b = append(b, "],\"next\":"...)
	if len(rows.Rows) > n {
		argo.Put(mut b, mint.Itoa(last))
	} else {
		b = append(b, "\"\""...)
	}
	b = append(b, '}')
	return str(b)
}

// repoAudit is the repository's audit log, newest first (admin); the cursor is the last id sent.
fn repoAudit(q anvil.Req, w mut anvil.Out) {
	let c = withRole(q, mut w, accounts.RoleAdmin)
	if c == nil {
		return
	}
	let before = mint.Atoi(q.Param("cursor")) catch _ {
		9223372036854775807
	}
	let n = pageLimit(q)
	let more = n + 1
	let id = c.r.Id
	let rows = c.d.Db.Query("SELECT a.id, extract(epoch FROM a.at)::bigint, coalesce(o.name, ''), a.action, a.target_kind, a.target_id, coalesce(a.detail::text, ''), a.ip FROM audit_log a LEFT JOIN users u ON u.id = a.actor_id LEFT JOIN owners o ON o.id = u.owner_id WHERE a.target_kind = 'repo' AND a.target_id = {id} AND a.id < {before} ORDER BY a.id DESC LIMIT {more}") catch err {
		answerErr(mut w, err)
		return
	}
	answerJson(mut w, auditJson(rows, n, false))
}

// siteAudit is the whole audit log, newest first (site admins), with each row's address; ?action= filters by prefix.
fn siteAudit(q anvil.Req, w mut anvil.Out) {
	let c = signedIn(q, mut w, false)
	if c == nil {
		return
	}
	let admin = isAdmin(c.d.Db, c.user) catch err {
		answerErr(mut w, err)
		return
	}
	if !admin {
		fail_(mut w, 403, "forbidden", "the audit log is for site admins")
		return
	}
	let before = mint.Atoi(q.Param("cursor")) catch _ {
		9223372036854775807
	}
	let n = pageLimit(q)
	let more = n + 1
	let action = q.Param("action")
	let rows = c.d.Db.Query("SELECT a.id, extract(epoch FROM a.at)::bigint, coalesce(o.name, ''), a.action, a.target_kind, a.target_id, coalesce(a.detail::text, ''), a.ip FROM audit_log a LEFT JOIN users u ON u.id = a.actor_id LEFT JOIN owners o ON o.id = u.owner_id WHERE a.id < {before} AND left(a.action, length({action})) = {action} ORDER BY a.id DESC LIMIT {more}") catch err {
		answerErr(mut w, err)
		return
	}
	answerJson(mut w, auditJson(rows, n, true))
}
