package api

import "../accounts"
import "anvil"
import "argo"
import "fault"
import "tide"

// What the API's writes share (design/tinhub.md §15): the caller as an accounts.Actor, the budget, JSON bodies and
// the answers of accounts' faults. A write never acts as accounts.System(): nobody signed in is 401 before any call.

// writeWithin and writeMemory are a write's budget (design/tinhub.md §8).
const writeWithin = 5 * tide.Second

const writeMemory = 16 * 1024 * 1024

// actorOf is the call's caller as an actor of accounts, with the request's address.
fn actorOf(c call, q anvil.Req) accounts.Actor {
	return accounts.Actor{Id: c.user, Ip: q.ClientIP()}
}

// signedIn is begin for a request that needs a signed-in caller: 401 when there is none.
fn signedIn(q anvil.Req, w mut anvil.Out, withRepo bool) ?call {
	let c = begin(q, mut w, withRepo)
	if c == nil {
		return nil
	}
	if c.user <= 0 {
		fail_(mut w, 401, "unauthorized", "sign in to do that")
		return nil
	}
	return c
}

// withRole is begin with the repository and a role of at least need: 401 for nobody, 403 below need.
fn withRole(q anvil.Req, w mut anvil.Out, need i64) ?call {
	let c = begin(q, mut w, true)
	if c == nil {
		return nil
	}
	let role = accounts.RoleOf(c.d.Db, c.user, c.r) catch err {
		fail_(mut w, 503, "unavailable", fault.Message(err))
		return nil
	}
	if role < need {
		if c.user <= 0 {
			fail_(mut w, 401, "unauthorized", "sign in to do that")
			return nil
		}
		fail_(mut w, 403, "forbidden", "that takes {accounts.RoleName(need)} access to {c.r.Owner}/{c.r.Name}")
		return nil
	}
	return c
}

// decode reads a JSON body into v (members it lacks keep v's values); false (answered 400) when it is not JSON.
fn decode[T](q anvil.Req, w mut anvil.Out, v mut T) bool {
	if len(q.Body()) == 0 {
		return true
	}
	argo.Get(q.Body(), mut v) catch err {
		fail_(mut w, 400, "bad_request", fault.Message(err))
		return false
	}
	return true
}

// answerErr answers a fault of accounts (or of a read) with its status.
fn answerErr(w mut anvil.Out, err fault) {
	let m = fault.Message(err)
	if fault.Is(err, accounts.ErrNotFound) || fault.Is(err, ErrNotFound) {
		fail_(mut w, 404, "not_found", m)
	} else if fault.Is(err, accounts.ErrForbidden) {
		fail_(mut w, 403, "forbidden", m)
	} else if fault.Is(err, accounts.ErrExists) {
		fail_(mut w, 409, "exists", m)
	} else if fault.Is(err, accounts.ErrInvalid) {
		fail_(mut w, 422, "invalid", m)
	} else if fault.Is(err, ErrBadCursor) {
		fail_(mut w, 400, "bad_request", m)
	} else if fault.Is(err, fault.DeadlineExceeded) {
		fail_(mut w, 503, "timeout", m)
	} else {
		fail_(mut w, 503, "unavailable", m)
	}
}

// noContent answers 204.
fn noContent(w mut anvil.Out) {
	w.Status(204)
	w.Body = []u8{}
}
