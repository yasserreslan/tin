package api

import "../accounts"
import "anvil"
import "argo"
import "fault"
import "mint"
import "postgres"
import "seal"
import "twine"

// The signed-in user, profiles, keys, repository lists and activity (design/tinhub.md §15, #1084).

// MountWeb adds the routes the web pages need (§15) to r: the user, profiles, repositories and their management,
// orgs and teams, invites, the audit log, activity, path lookup and the commit log.
fn MountWeb(r mut anvil.Router) {
	r.Get("/api/v1/user", me)
	r.Patch("/api/v1/user", patchMe)
	r.Get("/api/v1/user/keys", myKeys)
	r.Delete(`/api/v1/user/keys/{id}`, revokeKey)
	r.Get("/api/v1/user/repos", myRepos)
	r.Get("/api/v1/users", findUsers)
	r.Get(`/api/v1/owners/{owner}`, ownerInfo)
	r.Get("/api/v1/repos", listRepos)
	r.Post("/api/v1/repos", createRepo)
	r.Patch(`/api/v1/repos/{owner}/{repo}`, patchRepo)
	r.Delete(`/api/v1/repos/{owner}/{repo}`, deleteRepo)
	r.Get(`/api/v1/repos/{owner}/{repo}/collaborators`, collaborators)
	r.Put(`/api/v1/repos/{owner}/{repo}/collaborators/{user}`, putCollaborator)
	r.Delete(`/api/v1/repos/{owner}/{repo}/collaborators/{user}`, deleteCollaborator)
	r.Put(`/api/v1/repos/{owner}/{repo}/teams/{team}`, putTeamGrant)
	r.Delete(`/api/v1/repos/{owner}/{repo}/teams/{team}`, deleteTeamGrant)
	r.Get(`/api/v1/repos/{owner}/{repo}/mirror`, getMirror)
	r.Put(`/api/v1/repos/{owner}/{repo}/mirror`, putMirror)
	r.Delete(`/api/v1/repos/{owner}/{repo}/mirror`, deleteMirror)
	r.Get(`/api/v1/repos/{owner}/{repo}/audit`, repoAudit)
	r.Get(`/api/v1/repos/{owner}/{repo}/events`, repoEvents)
	r.Get("/api/v1/feed", feed)
	r.Get(`/api/v1/repos/{owner}/{repo}/resolve`, resolve)
	r.Get(`/api/v1/repos/{owner}/{repo}/log`, log)
	r.Get(`/api/v1/repos/{owner}/{repo}/raw/{path...}`, raw)
	r.Get(`/api/v1/repos/{owner}/{repo}/compare`, compare)
	r.Post("/api/v1/orgs", createOrg)
	r.Patch(`/api/v1/orgs/{org}`, patchOrg)
	r.Get(`/api/v1/orgs/{org}/members`, orgMembers)
	r.Put(`/api/v1/orgs/{org}/members/{user}`, putMember)
	r.Delete(`/api/v1/orgs/{org}/members/{user}`, deleteMember)
	r.Get(`/api/v1/orgs/{org}/teams`, orgTeams)
	r.Post(`/api/v1/orgs/{org}/teams`, createTeam)
	r.Delete(`/api/v1/orgs/{org}/teams/{team}`, deleteTeam)
	r.Get(`/api/v1/orgs/{org}/teams/{team}/members`, teamMembers)
	r.Put(`/api/v1/orgs/{org}/teams/{team}/members/{user}`, putTeamMember)
	r.Delete(`/api/v1/orgs/{org}/teams/{team}/members/{user}`, deleteTeamMember)
	r.Post("/api/v1/invites", createInvite)
	r.Get("/api/v1/invites", listInvites)
	r.Get("/api/v1/admin/audit", siteAudit)
}

// ---- the signed-in user ----

type orgRef struct {
	name    str
	display str
	role    str
}

type meOut struct {
	id         i64
	name       str
	email      str
	display    str
	site_admin bool
	created_at i64
	orgs       []orgRef
}

fn me(q anvil.Req, w mut anvil.Out) {
	let c = signedIn(q, mut w, false)
	if c == nil {
		return
	}
	let (out, err) = readMe(c)
	if err != nil {
		answerErr(mut w, err)
		return
	}
	send(mut w, out)
}

fn readMe(c call) !meOut {
	mut out ?meOut = nil
	try within readWithin {
		let u = c.user
		let rows = try c.d.Db.Query("SELECT u.id, o.name, u.email, u.display, u.site_admin::int, extract(epoch FROM u.created_at)::bigint FROM users u JOIN owners o ON o.id = u.owner_id WHERE u.id = {u} AND u.deleted_at IS NULL")
		if len(rows.Rows) == 0 {
			fail fault.Wrap(accounts.ErrNotFound, "no user {u}")
		}
		let x = rows.Rows[0]
		let gs = try c.d.Db.Query("SELECT o.name, g.display, m.role FROM members m JOIN orgs g ON g.id = m.org_id JOIN owners o ON o.id = g.owner_id WHERE m.user_id = {u} AND g.deleted_at IS NULL ORDER BY o.name")
		mut orgs = []orgRef{}
		for g in gs.Rows {
			orgs = append(orgs, orgRef{name: g[0].Text(), display: g[1].Text(), role: g[2].Text()})
		}
		out = keep(meOut{id: x[0].Int(), name: x[1].Text(), email: x[2].Text(), display: x[3].Text(), site_admin: x[4].Int() == 1, created_at: x[5].Int(), orgs: orgs})
	}
	if out == nil {
		fail fault.Wrap(accounts.ErrNotFound, "no user")
	}
	return out
}

type displayIn struct {
	display str
}

fn patchMe(q anvil.Req, w mut anvil.Out) {
	let c = signedIn(q, mut w, false)
	if c == nil {
		return
	}
	mut v = displayIn{display: ""}
	if !decode(q, mut w, mut v) {
		return
	}
	let err = setDisplay(c, actorOf(c, q), twine.TrimSpace(v.display))
	if err != nil {
		answerErr(mut w, err)
		return
	}
	let (out, rerr) = readMe(c)
	if rerr != nil {
		answerErr(mut w, rerr)
		return
	}
	send(mut w, out)
}

fn setDisplay(c call, by accounts.Actor, display str) ! {
	try within writeWithin {
		try accounts.SetDisplay(c.d.Db, by, c.user, display)
	}
}

// ---- keys ----

type keyOut struct {
	id           i64
	name         str
	public_key   str
	fingerprint  str
	created_at   i64
	last_used_at i64
}

type keysOut struct {
	keys []keyOut
}

// Fingerprint is how a key is shown: "SHA256:" and the unpadded base64 of the SHA-256 of its 32 bytes, as ssh does.
fn Fingerprint(pub []u8) str {
	return "SHA256:" + twine.TrimRight(seal.B64(seal.Sha256Soft(str(pub))), "=")
}

fn myKeys(q anvil.Req, w mut anvil.Out) {
	let c = signedIn(q, mut w, false)
	if c == nil {
		return
	}
	let ks = accounts.Keys(c.d.Db, c.user) catch err {
		answerErr(mut w, err)
		return
	}
	mut out = keysOut{keys: []keyOut{}}
	for k in ks {
		out.keys = append(out.keys, keyOut{id: k.Id, name: k.Name, public_key: seal.B64(k.Public), fingerprint: Fingerprint(k.Public), created_at: k.Created, last_used_at: k.LastUsed})
	}
	send(mut w, out)
}

fn revokeKey(q anvil.Req, w mut anvil.Out) {
	let c = signedIn(q, mut w, false)
	if c == nil {
		return
	}
	let raw = q.PathParam("id")
	let id = mint.Atoi(raw) catch _ {
		fail_(mut w, 404, "not_found", "no key {raw}")
		return
	}
	// a user revokes their own keys here; a site admin revoking someone's goes through that user's page later
	let ks = accounts.Keys(c.d.Db, c.user) catch err {
		answerErr(mut w, err)
		return
	}
	mut mine = false
	for k in ks {
		if k.Id == id {
			mine = true
		}
	}
	if !mine {
		fail_(mut w, 404, "not_found", "no key {raw}")
		return
	}
	accounts.RemoveKey(c.d.Db, actorOf(c, q), id) catch err {
		answerErr(mut w, err)
		return
	}
	noContent(mut w)
}

// ---- repository lists ----

type repoItem struct {
	owner          str
	name           str
	visibility     str
	description    str
	default_branch str
	size_bytes     i64
	pushed_at      i64
	created_at     i64
}

type repoList struct {
	repos []repoItem
	next  str
}

fn itemsOf(rows postgres.Rows, n i64) []repoItem {
	mut out = []repoItem{}
	for i, x in rows.Rows {
		if i == n {
			break
		}
		out = append(out, repoItem{owner: x[0].Text(), name: x[1].Text(), visibility: x[2].Text(), description: x[3].Text(), default_branch: x[4].Text(), size_bytes: x[5].Int(), pushed_at: x[6].Int(), created_at: x[7].Int()})
	}
	return out
}

// isAdmin reports whether the user is a live site admin.
fn isAdmin(c postgres.Client, user i64) !bool {
	if user <= 0 {
		return false
	}
	let rows = try c.Query("SELECT 1 FROM users WHERE id = {user} AND site_admin AND deleted_at IS NULL")
	return len(rows.Rows) == 1
}

// myRepos is the repositories the caller can write: their own, their orgs' (as an owner) and those granted write.
fn myRepos(q anvil.Req, w mut anvil.Out) {
	let c = signedIn(q, mut w, false)
	if c == nil {
		return
	}
	let (out, err) = readMyRepos(c, pageLimit(q))
	if err != nil {
		answerErr(mut w, err)
		return
	}
	send(mut w, out)
}

fn readMyRepos(c call, n i64) !repoList {
	mut out = repoList{repos: []repoItem{}, next: ""}
	try within readWithin {
		let u = c.user
		let rows = try c.d.Stale.Query("SELECT o.name, r.name, r.visibility, r.description, r.default_branch, r.size_bytes, coalesce((SELECT extract(epoch FROM max(f.updated_at))::bigint FROM refs f WHERE f.repo_id = r.id), 0) AS pushed, extract(epoch FROM r.created_at)::bigint FROM repos r JOIN owners o ON o.id = r.owner_id WHERE r.deleted_at IS NULL AND (r.owner_id = (SELECT owner_id FROM users WHERE id = {u} AND deleted_at IS NULL) OR EXISTS (SELECT 1 FROM members m JOIN orgs g ON g.id = m.org_id WHERE g.owner_id = r.owner_id AND m.user_id = {u} AND m.role = 'owner' AND g.deleted_at IS NULL) OR EXISTS (SELECT 1 FROM grants x WHERE x.repo_id = r.id AND x.role IN ('write', 'admin') AND (x.user_id = {u} OR x.team_id IN (SELECT team_id FROM team_members WHERE user_id = {u})))) ORDER BY pushed DESC, r.created_at DESC LIMIT {n}")
		out = keep(repoList{repos: itemsOf(rows, n), next: ""})
	}
	return out
}

// listRepos is the repositories the caller can read, newest push first, matching ?q= (owner/name or description);
// the cursor is how many were sent before.
fn listRepos(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, false)
	if c == nil {
		return
	}
	let off = mint.Atoi(q.Param("cursor")) catch _ {
		0
	}
	let (out, err) = readRepoList(c, twine.TrimSpace(q.Param("q")), q.Param("owner"), max(off, 0), pageLimit(q))
	if err != nil {
		answerErr(mut w, err)
		return
	}
	send(mut w, out)
}

fn readRepoList(c call, text str, owner str, off i64, n i64) !repoList {
	mut out = repoList{repos: []repoItem{}, next: ""}
	try within readWithin {
		let u = c.user
		let admin = try isAdmin(c.d.Db, u)
		let more = n + 1
		let rows = try c.d.Stale.Query("SELECT o.name, r.name, r.visibility, r.description, r.default_branch, r.size_bytes, coalesce((SELECT extract(epoch FROM max(f.updated_at))::bigint FROM refs f WHERE f.repo_id = r.id), 0) AS pushed, extract(epoch FROM r.created_at)::bigint FROM repos r JOIN owners o ON o.id = r.owner_id WHERE r.deleted_at IS NULL AND ({owner} = '' OR o.name = lower({owner})) AND ({text} = '' OR strpos(lower(o.name || '/' || r.name), lower({text})) > 0 OR strpos(lower(r.description), lower({text})) > 0) AND (r.visibility = 'public' OR {admin} OR r.owner_id = (SELECT owner_id FROM users WHERE id = {u} AND deleted_at IS NULL) OR EXISTS (SELECT 1 FROM members m JOIN orgs g ON g.id = m.org_id WHERE g.owner_id = r.owner_id AND m.user_id = {u} AND m.role = 'owner' AND g.deleted_at IS NULL) OR EXISTS (SELECT 1 FROM grants x WHERE x.repo_id = r.id AND (x.user_id = {u} OR x.team_id IN (SELECT team_id FROM team_members WHERE user_id = {u})))) ORDER BY pushed DESC, r.created_at DESC, r.id DESC OFFSET {off} LIMIT {more}")
		mut next = ""
		if len(rows.Rows) > n {
			next = "{off + n}"
		}
		out = keep(repoList{repos: itemsOf(rows, n), next: next})
	}
	return out
}

// ---- people ----

type userRef struct {
	name    str
	display str
}

type usersOut struct {
	users []userRef
}

// findUsers is up to 20 users whose name starts with ?q= (signed in only, for pickers).
fn findUsers(q anvil.Req, w mut anvil.Out) {
	let c = signedIn(q, mut w, false)
	if c == nil {
		return
	}
	let prefix = twine.ToLower(twine.TrimSpace(q.Param("q")))
	let rows = c.d.Db.Query("SELECT o.name, u.display FROM users u JOIN owners o ON o.id = u.owner_id WHERE u.deleted_at IS NULL AND left(o.name, length({prefix})) = {prefix} ORDER BY o.name LIMIT 20") catch err {
		answerErr(mut w, err)
		return
	}
	mut out = usersOut{users: []userRef{}}
	for x in rows.Rows {
		out.users = append(out.users, userRef{name: x[0].Text(), display: x[1].Text()})
	}
	send(mut w, out)
}

type ownerOut struct {
	name       str
	kind       str
	display    str
	created_at i64
	members    i64
	teams      i64
	repos      i64
	// the caller's role in an org: "owner", "member" or ""
	role str
	// whether the caller may administer the org (or is this user)
	admin bool
}

// ownerInfo is a user's or an org's profile; repos counts those the caller can read.
fn ownerInfo(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, false)
	if c == nil {
		return
	}
	let (out, err) = readOwner(c, q.PathParam("owner"))
	if err != nil {
		answerErr(mut w, err)
		return
	}
	send(mut w, out)
}

fn readOwner(c call, name str) !ownerOut {
	mut out ?ownerOut = nil
	try within readWithin {
		let u = c.user
		let rows = try c.d.Db.Query("SELECT o.name, o.kind, coalesce(us.display, g.display, ''), extract(epoch FROM o.created_at)::bigint, coalesce(g.id, 0), coalesce(us.id, 0) FROM owners o LEFT JOIN users us ON us.owner_id = o.id AND us.deleted_at IS NULL LEFT JOIN orgs g ON g.owner_id = o.id AND g.deleted_at IS NULL WHERE o.name = lower({name}) AND (us.id IS NOT NULL OR g.id IS NOT NULL)")
		if len(rows.Rows) == 0 {
			fail fault.Wrap(accounts.ErrNotFound, "no user or org {name}")
		}
		let x = rows.Rows[0]
		let orgId = x[4].Int()
		let userId = x[5].Int()
		let admin = try isAdmin(c.d.Db, u)
		mut members = 0
		mut teams = 0
		mut role = ""
		if orgId > 0 {
			let m = try c.d.Db.Query("SELECT count(*), (SELECT count(*) FROM teams WHERE org_id = {orgId}), coalesce((SELECT role FROM members WHERE org_id = {orgId} AND user_id = {u}), '') FROM members m JOIN users us ON us.id = m.user_id WHERE m.org_id = {orgId} AND us.deleted_at IS NULL")
			members = m.Rows[0][0].Int()
			teams = m.Rows[0][1].Int()
			role = m.Rows[0][2].Text()
		}
		let ownerName = x[0].Text()
		let n = try c.d.Stale.Query("SELECT count(*) FROM repos r JOIN owners o ON o.id = r.owner_id WHERE r.deleted_at IS NULL AND o.name = {ownerName} AND (r.visibility = 'public' OR {admin} OR r.owner_id = (SELECT owner_id FROM users WHERE id = {u} AND deleted_at IS NULL) OR EXISTS (SELECT 1 FROM members m JOIN orgs g ON g.id = m.org_id WHERE g.owner_id = r.owner_id AND m.user_id = {u} AND m.role = 'owner' AND g.deleted_at IS NULL) OR EXISTS (SELECT 1 FROM grants x WHERE x.repo_id = r.id AND (x.user_id = {u} OR x.team_id IN (SELECT team_id FROM team_members WHERE user_id = {u}))))")
		let mayAdmin = admin || role == "owner" || (userId > 0 && userId == u)
		out = keep(ownerOut{name: ownerName, kind: x[1].Text(), display: x[2].Text(), created_at: x[3].Int(), members: members, teams: teams, repos: n.Rows[0][0].Int(), role: role, admin: mayAdmin})
	}
	if out == nil {
		fail fault.Wrap(accounts.ErrNotFound, "no user or org {name}")
	}
	return out
}

// ---- activity ----

// eventsJson writes a page of events as {"events": [{"id", "kind", "repo", "actor", "at", "payload"}], "next"}: the
// payload is the event's own JSON, copied as it is.
fn eventsJson(rows postgres.Rows, n i64) str {
	mut b = []u8{}
	b = append(b, "{{\"events\":["...)
	mut last = 0
	for i, x in rows.Rows {
		if i == n {
			break
		}
		if i > 0 {
			b = append(b, ',')
		}
		last = x[0].Int()
		b = append(b, "{{\"id\":"...)
		b = append(b, mint.Itoa(x[0].Int())...)
		b = append(b, ",\"kind\":"...)
		argo.Put(mut b, x[1].Text())
		b = append(b, ",\"repo\":"...)
		argo.Put(mut b, x[2].Text())
		b = append(b, ",\"actor\":"...)
		argo.Put(mut b, x[3].Text())
		b = append(b, ",\"at\":"...)
		b = append(b, mint.Itoa(x[4].Int())...)
		b = append(b, ",\"payload\":"...)
		let p = x[5].Text()
		if len(p) == 0 {
			b = append(b, "null"...)
		} else {
			b = append(b, p...)
		}
		b = append(b, '}')
	}
	b = append(b, "],\"next\":"...)
	if len(rows.Rows) > n {
		argo.Put(mut b, mint.Itoa(last))
	} else {
		b = append(b, "\"\""...)
	}
	b = append(b, '}')
	return str(b)
}

// answerJson writes a JSON text as the answer.
fn answerJson(w mut anvil.Out, text str) {
	w.Json()
	w.Body = []u8(text)
}

// liveKinds is the event kinds pages show: notify.LiveKinds (pushes and the review events).
const liveKinds = "push,review.opened,review.voted,review.comment,review.check,review.landed,review.state"

// repoEvents is a repository's activity, newest first; the cursor is the last event id sent.
fn repoEvents(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, true)
	if c == nil {
		return
	}
	let before = mint.Atoi(q.Param("cursor")) catch _ {
		9223372036854775807
	}
	let n = pageLimit(q)
	let more = n + 1
	let repoId = c.r.Id
	let kinds = liveKinds
	let rows = c.d.Stale.Query("SELECT e.id, e.kind, o.name || '/' || r.name, coalesce(CASE WHEN jsonb_typeof(e.payload->'by') = 'number' THEN (SELECT ow.name FROM users u JOIN owners ow ON ow.id = u.owner_id WHERE u.id = (e.payload->>'by')::bigint) END, (SELECT ow.name FROM users u JOIN owners ow ON ow.id = u.owner_id WHERE u.email = e.payload->>'who' AND u.deleted_at IS NULL), e.payload->>'who', ''), extract(epoch FROM e.created_at)::bigint, e.payload::text FROM events e JOIN repos r ON r.id = e.repo_id JOIN owners o ON o.id = r.owner_id WHERE e.repo_id = {repoId} AND e.id < {before} AND e.kind = ANY(string_to_array({kinds}, ',')) ORDER BY e.id DESC LIMIT {more}") catch err {
		answerErr(mut w, err)
		return
	}
	answerJson(mut w, eventsJson(rows, n))
}

// feed is the activity of the repositories the caller follows or can write, that they can still read, newest first.
fn feed(q anvil.Req, w mut anvil.Out) {
	let c = signedIn(q, mut w, false)
	if c == nil {
		return
	}
	let before = mint.Atoi(q.Param("cursor")) catch _ {
		9223372036854775807
	}
	let n = pageLimit(q)
	let more = n + 1
	let u = c.user
	let admin = isAdmin(c.d.Db, u) catch err {
		answerErr(mut w, err)
		return
	}
	let kinds = liveKinds
	let rows = c.d.Stale.Query("SELECT e.id, e.kind, o.name || '/' || r.name, coalesce(CASE WHEN jsonb_typeof(e.payload->'by') = 'number' THEN (SELECT ow.name FROM users u JOIN owners ow ON ow.id = u.owner_id WHERE u.id = (e.payload->>'by')::bigint) END, (SELECT ow.name FROM users u JOIN owners ow ON ow.id = u.owner_id WHERE u.email = e.payload->>'who' AND u.deleted_at IS NULL), e.payload->>'who', ''), extract(epoch FROM e.created_at)::bigint, e.payload::text FROM events e JOIN repos r ON r.id = e.repo_id JOIN owners o ON o.id = r.owner_id WHERE r.deleted_at IS NULL AND e.id < {before} AND e.kind = ANY(string_to_array({kinds}, ',')) AND e.created_at > now() - interval '90 days' AND (EXISTS (SELECT 1 FROM subscriptions s WHERE s.user_id = {u} AND s.repo_id = r.id) OR r.owner_id = (SELECT owner_id FROM users WHERE id = {u}) OR EXISTS (SELECT 1 FROM members m JOIN orgs g ON g.id = m.org_id WHERE g.owner_id = r.owner_id AND m.user_id = {u} AND g.deleted_at IS NULL) OR EXISTS (SELECT 1 FROM grants x WHERE x.repo_id = r.id AND (x.user_id = {u} OR x.team_id IN (SELECT team_id FROM team_members WHERE user_id = {u})))) AND (r.visibility = 'public' OR {admin} OR r.owner_id = (SELECT owner_id FROM users WHERE id = {u} AND deleted_at IS NULL) OR EXISTS (SELECT 1 FROM members m JOIN orgs g ON g.id = m.org_id WHERE g.owner_id = r.owner_id AND m.user_id = {u} AND m.role = 'owner' AND g.deleted_at IS NULL) OR EXISTS (SELECT 1 FROM grants x WHERE x.repo_id = r.id AND (x.user_id = {u} OR x.team_id IN (SELECT team_id FROM team_members WHERE user_id = {u})))) ORDER BY e.id DESC LIMIT {more}") catch err {
		answerErr(mut w, err)
		return
	}
	answerJson(mut w, eventsJson(rows, n))
}
