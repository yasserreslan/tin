package api

import "../accounts"
import "anvil"
import "postgres"
import "twine"

// Orgs, their members and teams, and invites (design/tinhub.md §15, #1086). Writes go through accounts, which checks
// that the caller owns the org (or is a site admin) and writes the audit row.

type orgIn struct {
	name    str
	display str
}

// createOrg makes an org; the caller is its first owner.
fn createOrg(q anvil.Req, w mut anvil.Out) {
	let c = signedIn(q, mut w, false)
	if c == nil {
		return
	}
	mut v = orgIn{name: "", display: ""}
	if !decode(q, mut w, mut v) {
		return
	}
	let g = accounts.CreateOrg(c.d.Db, actorOf(c, q), twine.ToLower(twine.TrimSpace(v.name)), twine.TrimSpace(v.display)) catch err {
		answerErr(mut w, err)
		return
	}
	w.Status(201)
	let (out, err) = readOwner(c, g.Name)
	if err != nil {
		answerErr(mut w, err)
		return
	}
	send(mut w, out)
}

// orgOf is the org a request's path names; answered 404 (and nil) when there is none.
fn orgOf(c call, w mut anvil.Out, name str) ?accounts.Org {
	let g = accounts.OrgByName(c.d.Db, name) catch err {
		answerErr(mut w, err)
		return nil
	}
	if g == nil {
		fail_(mut w, 404, "not_found", "no org {name}")
		return nil
	}
	return g
}

fn patchOrg(q anvil.Req, w mut anvil.Out) {
	let c = signedIn(q, mut w, false)
	if c == nil {
		return
	}
	let g = orgOf(c, mut w, q.PathParam("org"))
	if g == nil {
		return
	}
	mut v = orgIn{name: g.Name, display: g.Display}
	if !decode(q, mut w, mut v) {
		return
	}
	accounts.SetOrgDisplay(c.d.Db, actorOf(c, q), g.Id, twine.TrimSpace(v.display)) catch err {
		answerErr(mut w, err)
		return
	}
	let (out, err) = readOwner(c, g.Name)
	if err != nil {
		answerErr(mut w, err)
		return
	}
	send(mut w, out)
}

type memberOut struct {
	name    str
	display str
	role    str
	since   i64
}

type membersOut struct {
	members []memberOut
}

fn orgMembers(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, false)
	if c == nil {
		return
	}
	let g = orgOf(c, mut w, q.PathParam("org"))
	if g == nil {
		return
	}
	let id = g.Id
	let rows = c.d.Db.Query("SELECT o.name, u.display, m.role, extract(epoch FROM m.created_at)::bigint FROM members m JOIN users u ON u.id = m.user_id JOIN owners o ON o.id = u.owner_id WHERE m.org_id = {id} AND u.deleted_at IS NULL ORDER BY m.role DESC, o.name") catch err {
		answerErr(mut w, err)
		return
	}
	mut out = membersOut{members: []memberOut{}}
	for x in rows.Rows {
		out.members = append(out.members, memberOut{name: x[0].Text(), display: x[1].Text(), role: x[2].Text(), since: x[3].Int()})
	}
	send(mut w, out)
}

fn putMember(q anvil.Req, w mut anvil.Out) {
	let c = signedIn(q, mut w, false)
	if c == nil {
		return
	}
	let g = orgOf(c, mut w, q.PathParam("org"))
	if g == nil {
		return
	}
	mut v = roleIn{role: "member"}
	if !decode(q, mut w, mut v) {
		return
	}
	let u = userByName(c, mut w, q.PathParam("user"))
	if u == nil {
		return
	}
	accounts.SetMember(c.d.Db, actorOf(c, q), g.Id, u.Id, v.role) catch err {
		answerErr(mut w, err)
		return
	}
	noContent(mut w)
}

fn deleteMember(q anvil.Req, w mut anvil.Out) {
	let c = signedIn(q, mut w, false)
	if c == nil {
		return
	}
	let g = orgOf(c, mut w, q.PathParam("org"))
	if g == nil {
		return
	}
	let u = userByName(c, mut w, q.PathParam("user"))
	if u == nil {
		return
	}
	// a member may leave; anyone else needs the org's owners
	let by = actorOf(c, q)
	if u.Id == c.user {
		let role = accounts.MemberRole(c.d.Db, g.Id, u.Id) catch err {
			answerErr(mut w, err)
			return
		}
		if role == "member" {
			leave(c, g.Id) catch err {
				answerErr(mut w, err)
				return
			}
			noContent(mut w)
			return
		}
	}
	accounts.SetMember(c.d.Db, by, g.Id, u.Id, "") catch err {
		answerErr(mut w, err)
		return
	}
	noContent(mut w)
}

// leave takes the caller (a plain member) out of the org and its teams.
fn leave(c call, orgId i64) ! {
	try within writeWithin + 0 {
		let u = c.user
		mut tx = try c.d.Db.Begin()
		let err = leaveIn(mut tx, orgId, u)
		if err != nil {
			tx.Rollback() catch _ {
			}
			fail err
		}
		try tx.Commit()
	}
}

fn leaveIn(tx mut postgres.Tx, orgId i64, u i64) ! {
	_ = try tx.Exec("DELETE FROM members WHERE org_id = {orgId} AND user_id = {u} AND role = 'member'")
	_ = try tx.Exec("DELETE FROM team_members WHERE user_id = {u} AND team_id IN (SELECT id FROM teams WHERE org_id = {orgId})")
	_ = try tx.Exec("INSERT INTO audit_log (actor_id, action, target_kind, target_id, detail, ip) VALUES ({u}, 'org.member.leave', 'org', {orgId}, '{{}}'::jsonb, '')")
}

type teamOut struct {
	name    str
	members i64
	repos   i64
}

type teamsOut struct {
	teams []teamOut
}

fn orgTeams(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, false)
	if c == nil {
		return
	}
	let g = orgOf(c, mut w, q.PathParam("org"))
	if g == nil {
		return
	}
	let id = g.Id
	let rows = c.d.Db.Query("SELECT t.name, (SELECT count(*) FROM team_members m WHERE m.team_id = t.id), (SELECT count(*) FROM grants x JOIN repos r ON r.id = x.repo_id WHERE x.team_id = t.id AND r.deleted_at IS NULL) FROM teams t WHERE t.org_id = {id} ORDER BY t.name") catch err {
		answerErr(mut w, err)
		return
	}
	mut out = teamsOut{teams: []teamOut{}}
	for x in rows.Rows {
		out.teams = append(out.teams, teamOut{name: x[0].Text(), members: x[1].Int(), repos: x[2].Int()})
	}
	send(mut w, out)
}

type teamIn struct {
	name str
}

fn createTeam(q anvil.Req, w mut anvil.Out) {
	let c = signedIn(q, mut w, false)
	if c == nil {
		return
	}
	let g = orgOf(c, mut w, q.PathParam("org"))
	if g == nil {
		return
	}
	mut v = teamIn{name: ""}
	if !decode(q, mut w, mut v) {
		return
	}
	let t = accounts.CreateTeam(c.d.Db, actorOf(c, q), g.Id, twine.ToLower(twine.TrimSpace(v.name))) catch err {
		answerErr(mut w, err)
		return
	}
	w.Status(201)
	send(mut w, teamOut{name: t.Name, members: 0, repos: 0})
}

// orgTeam is the team a request's path names in its org; answered (and nil) when there is none.
fn orgTeam(c call, w mut anvil.Out, q anvil.Req) ?accounts.Team {
	let g = orgOf(c, mut w, q.PathParam("org"))
	if g == nil {
		return nil
	}
	let name = q.PathParam("team")
	let t = accounts.TeamByName(c.d.Db, g.Id, name) catch err {
		answerErr(mut w, err)
		return nil
	}
	if t == nil {
		fail_(mut w, 404, "not_found", "{g.Name} has no team {name}")
		return nil
	}
	return t
}

fn deleteTeam(q anvil.Req, w mut anvil.Out) {
	let c = signedIn(q, mut w, false)
	if c == nil {
		return
	}
	let t = orgTeam(c, mut w, q)
	if t == nil {
		return
	}
	accounts.DeleteTeam(c.d.Db, actorOf(c, q), t.Id) catch err {
		answerErr(mut w, err)
		return
	}
	noContent(mut w)
}

fn teamMembers(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, false)
	if c == nil {
		return
	}
	let t = orgTeam(c, mut w, q)
	if t == nil {
		return
	}
	let id = t.Id
	let rows = c.d.Db.Query("SELECT o.name, u.display, coalesce((SELECT role FROM members m WHERE m.org_id = {t.OrgId} AND m.user_id = u.id), '') FROM team_members tm JOIN users u ON u.id = tm.user_id JOIN owners o ON o.id = u.owner_id WHERE tm.team_id = {id} AND u.deleted_at IS NULL ORDER BY o.name") catch err {
		answerErr(mut w, err)
		return
	}
	mut out = membersOut{members: []memberOut{}}
	for x in rows.Rows {
		out.members = append(out.members, memberOut{name: x[0].Text(), display: x[1].Text(), role: x[2].Text(), since: 0})
	}
	send(mut w, out)
}

fn setTeamMember(q anvil.Req, w mut anvil.Out, add bool) {
	let c = signedIn(q, mut w, false)
	if c == nil {
		return
	}
	let t = orgTeam(c, mut w, q)
	if t == nil {
		return
	}
	let u = userByName(c, mut w, q.PathParam("user"))
	if u == nil {
		return
	}
	accounts.SetTeamMember(c.d.Db, actorOf(c, q), t.Id, u.Id, add) catch err {
		answerErr(mut w, err)
		return
	}
	noContent(mut w)
}

fn putTeamMember(q anvil.Req, w mut anvil.Out) {
	setTeamMember(q, mut w, true)
}

fn deleteTeamMember(q anvil.Req, w mut anvil.Out) {
	setTeamMember(q, mut w, false)
}

// ---- invites ----

type inviteIn struct {
	email      str
	org        str
	site_admin bool
}

type inviteOut struct {
	code    str
	email   str
	org     str
	expires i64
	command str
}

// createInvite makes a one-use invite: a site admin invites anyone, an org's owner into the org.
fn createInvite(q anvil.Req, w mut anvil.Out) {
	let c = signedIn(q, mut w, false)
	if c == nil {
		return
	}
	mut v = inviteIn{email: "", org: "", site_admin: false}
	if !decode(q, mut w, mut v) {
		return
	}
	mut orgId = 0
	if len(v.org) > 0 {
		let g = orgOf(c, mut w, v.org)
		if g == nil {
			return
		}
		orgId = g.Id
	}
	let email = twine.TrimSpace(v.email)
	let code = accounts.InviteBy(c.d.Db, actorOf(c, q), email, orgId, v.site_admin) catch err {
		answerErr(mut w, err)
		return
	}
	let site = c.d.PublicURL
	w.Status(201)
	send(mut w, inviteOut{code: code, email: email, org: v.org, expires: 0, command: "tit key add {site} {code}"})
}

type pendingOut struct {
	email      str
	org        str
	site_admin bool
	created_by str
	created_at i64
	expires_at i64
}

type pendingList struct {
	invites []pendingOut
}

// listInvites is the invites not used yet and not expired (site admins), newest first; never their codes.
fn listInvites(q anvil.Req, w mut anvil.Out) {
	let c = signedIn(q, mut w, false)
	if c == nil {
		return
	}
	let admin = isAdmin(c.d.Db, c.user) catch err {
		answerErr(mut w, err)
		return
	}
	if !admin {
		fail_(mut w, 403, "forbidden", "invites are listed for site admins")
		return
	}
	let rows = c.d.Db.Query("SELECT i.email, coalesce(og.name, ''), i.site_admin::int, coalesce(ou.name, ''), extract(epoch FROM i.created_at)::bigint, extract(epoch FROM i.expires_at)::bigint FROM invites i LEFT JOIN orgs g ON g.id = i.org_id LEFT JOIN owners og ON og.id = g.owner_id LEFT JOIN users u ON u.id = i.created_by LEFT JOIN owners ou ON ou.id = u.owner_id WHERE i.used_at IS NULL AND i.expires_at > now() ORDER BY i.created_at DESC LIMIT 200") catch err {
		answerErr(mut w, err)
		return
	}
	mut out = pendingList{invites: []pendingOut{}}
	for x in rows.Rows {
		out.invites = append(out.invites, pendingOut{email: x[0].Text(), org: x[1].Text(), site_admin: x[2].Int() == 1, created_by: x[3].Text(), created_at: x[4].Int(), expires_at: x[5].Int()})
	}
	send(mut w, out)
}
