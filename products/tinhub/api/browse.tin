package api

import "../../tit/change"
import "../../tit/diff"
import "../../tit/object"
import "../../tit/store"
import "anvil"
import "fault"
import "twine"

// Browsing by URL (design/tinhub.md §15, #1087): what a revision and a path name (resolve), and the commit log.

// textMax is the largest file resolve answers inline as text.
const textMax = 1024 * 1024

// walkMax is the most commits one log request reads; a walk that reads more answers what it has, with a cursor.
const walkMax = 4000

type resolveOut struct {
	rev    str
	ref    str
	commit str
	change str
	path   str
	// kind is "tree" or "blob"
	kind      str
	id        str
	mode      str
	entries   []entryOut
	size      i64
	binary    bool
	text      str
	truncated bool
}

// resolve answers what ?rev= (a branch, tag, full ref name, change id or commit id; the default branch when empty)
// names, and at ?path= its tree's entries or its blob (inline as text when it is text of at most 1 MiB).
fn resolve(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, true)
	if c == nil {
		return
	}
	let path = twine.Trim(q.Param("path"), "/")
	let (out, err) = readResolve(c, q.Param("rev"), path)
	if err != nil {
		answerErr(mut w, err)
		return
	}
	send(mut w, out)
}

// revision is what a rev names: its commit, the ref it was found as ("" for none) and the commit's change.
type revision struct {
	commit object.Id
	ref    str
}

// peel follows tags to the commit they name.
fn peel[S store.ObjectStore](st mut S, id0 object.Id) !object.Id {
	mut id = id0
	for i in 0..16 {
		let o = st.Get(id) catch _ {
			fail fault.Wrap(ErrNotFound, "no object {id.Hex()}")
			object.Object.Blob("")
		}
		match o {
			Commit(_) => {
				return id
			}
			Tag(t) => {
				id = t.Object
			}
			Tree(_) => {
				fail fault.Wrap(ErrNotFound, "{id.Hex()} is a tree, not a commit")
			}
			Blob(_) => {
				fail fault.Wrap(ErrNotFound, "{id.Hex()} is a blob, not a commit")
			}
		}
		_ = i
	}
	fail fault.Wrap(ErrNotFound, "tags nested too deep")
}

// targetCommit is the commit a ref's target names: the commit, or its change's newest version.
fn targetCommit(c call, t change.Target) !?object.Id {
	match t {
		Commit(id) => {
			return id
		}
		Change(ch) => {
			let r = pgRepo(c)
			let v = try r.Newest(ch)
			if v == nil {
				return nil
			}
			return v.Commit()
		}
	}
	return nil
}

fn revisionOf[S store.ObjectStore](c call, st mut S, rev0 str) !revision {
	mut rev = rev0
	if len(rev) == 0 {
		let info = try detailOf(c, c.r)
		rev = info.default_branch
	}
	let r = pgRepo(c)
	mut names = []str{}
	if twine.HasPrefix(rev, "refs/") {
		names = append(names, rev)
	} else {
		names = append(names, "refs/heads/" + rev, "refs/tags/" + rev)
	}
	for name in names {
		let ref = try r.Ref(name)
		if ref == nil {
			continue
		}
		let id = try targetCommit(c, ref.Target)
		if id == nil {
			continue
		}
		let commit = try peel(mut st, id)
		return revision{commit: commit, ref: name}
	}
	if len(rev) == 32 {
		let (ch, bad) = object.ParseChangeId(rev)
		if bad == nil {
			let v = try r.Newest(ch)
			if v != nil {
				return revision{commit: v.Commit(), ref: ""}
			}
		}
	}
	if len(rev) == 64 {
		let id = object.ParseId(rev) catch _ {
			fail fault.Wrap(ErrNotFound, "{rev} is not a branch, tag, change or commit")
			object.NoId
		}
		let commit = try peel(mut st, id)
		return revision{commit: commit, ref: ""}
	}
	fail fault.Wrap(ErrNotFound, "{rev} is not a branch, tag, change or commit")
}

// isBinary reports whether a file looks binary: a NUL byte in its first 8000 bytes.
fn isBinary(s str) bool {
	let n = min(len(s), 8000)
	for i in 0..n {
		if s[i] == 0 {
			return true
		}
	}
	return false
}

fn readResolve(c call, rev str, path str) !resolveOut {
	mut out ?resolveOut = nil
	try within readWithin {
		try limit memory blobMemory {
			mut r = pgRepo(c)
			mut st = try r.Objects()
			let rv = try revisionOf(c, mut st, rev)
			let o = try st.Get(rv.commit)
			mut tree = object.NoId
			mut changeId = ""
			match o {
				Commit(cd) => {
					tree = cd.Tree
					changeId = cd.Change.Letters()
				}
				Tree(_) => {
				}
				Tag(_) => {
				}
				Blob(_) => {
				}
			}
			mut res = resolveOut{rev: rev, ref: rv.ref, commit: rv.commit.Hex(), change: changeId, path: path, kind: "tree", id: tree.Hex(), mode: "dir", entries: []entryOut{}, size: 0, binary: false, text: "", truncated: false}
			mut id = tree
			mut mode = "dir"
			if len(path) > 0 {
				let segs = twine.Split(path, "/")
				for i, seg in segs {
					if mode != "dir" {
						fail fault.Wrap(ErrNotFound, "{path}: {segs[i - 1]} is a file")
					}
					let to = try st.Get(id)
					mut found = false
					match to {
						Tree(es) => {
							for e in es {
								if e.Name == seg {
									id = e.Id
									mode = modeName(e.Mode)
									found = true
									break
								}
							}
						}
						Commit(_) => {
						}
						Tag(_) => {
						}
						Blob(_) => {
						}
					}
					if !found {
						fail fault.Wrap(ErrNotFound, "no {path} at {rev}")
					}
				}
			}
			res.id = id.Hex()
			res.mode = mode
			let target = try st.Get(id)
			match target {
				Tree(es) => {
					res.kind = "tree"
					for e in es {
						res.entries = append(res.entries, entryOut{name: e.Name, mode: modeName(e.Mode), id: e.Id.Hex()})
					}
				}
				Blob(b) => {
					res.kind = "blob"
					res.size = len(b)
					res.binary = isBinary(b)
					if !res.binary {
						if len(b) <= textMax {
							res.text = b
						} else {
							res.truncated = true
						}
					}
				}
				Commit(_) => {
					fail fault.Wrap(ErrNotFound, "{path} is a submodule")
				}
				Tag(_) => {
					fail fault.Wrap(ErrNotFound, "{path} is a tag")
				}
			}
			out = keep(res)
		}
	}
	if out == nil {
		fail fault.Wrap(ErrNotFound, "no {path} at {rev}")
	}
	return out
}

// ---- the log ----

type logEntry struct {
	id        str
	change    str
	title     str
	message   str
	author    personOut
	committer personOut
	parents   []str
	signed    bool
}

type logOut struct {
	commits []logEntry
	next    str
}

// log is the commits reachable from ?rev= (or the ?cursor= a previous page gave), newest committer time first; with
// ?path=, only those that changed it (a merge only when it differs from every parent there).
fn log(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, true)
	if c == nil {
		return
	}
	let (out, err) = readLog(c, q.Param("rev"), twine.Trim(q.Param("path"), "/"), q.Param("cursor"), pageLimit(q))
	if err != nil {
		answerErr(mut w, err)
		return
	}
	send(mut w, out)
}

// pending is a commit waiting in the walk, with its committer time.
type pending struct {
	id   object.Id
	when i64
}

// idAt is the id of what path names under tree, or "" when nothing is there.
fn idAt[S store.ObjectStore](st mut S, tree object.Id, path str) !str {
	if len(path) == 0 {
		return tree.Hex()
	}
	mut id = tree
	for seg in twine.Split(path, "/") {
		let o = try st.Get(id)
		mut found = false
		match o {
			Tree(es) => {
				for e in es {
					if e.Name == seg {
						id = e.Id
						found = true
						break
					}
				}
			}
			Commit(_) => {
			}
			Tag(_) => {
			}
			Blob(_) => {
			}
		}
		if !found {
			return ""
		}
	}
	return id.Hex()
}

// treeOfCommit is a commit's tree and data.
fn commitOf[S store.ObjectStore](st mut S, id object.Id) !object.CommitData {
	let o = try st.Get(id)
	match o {
		Commit(cd) => {
			return cd
		}
		Tree(_) => {
		}
		Tag(_) => {
		}
		Blob(_) => {
		}
	}
	fail fault.Wrap(ErrNotFound, "{id.Hex()} is not a commit")
}

fn titleOf(message str) str {
	let (first, _, _) = twine.Cut(message, "\n")
	return twine.TrimSpace(first)
}

fn readLog(c call, rev str, path str, cursor str, n i64) !logOut {
	mut out = logOut{commits: []logEntry{}, next: ""}
	try within readWithin {
		try limit memory readMemory {
			mut r = pgRepo(c)
			mut st = try r.Objects()
			mut frontier = []pending{}
			mut seen = map[str]bool{}
			if len(cursor) > 0 {
				for part in twine.Split(cursor, ",") {
					let id = object.ParseId(part) catch _ {
						fail fault.Wrap(ErrBadCursor, cursor)
						object.NoId
					}
					let cd = try commitOf(mut st, id)
					frontier = append(frontier, pending{id: id, when: cd.Committer.When})
					seen[id.Hex()] = true
				}
			} else {
				let rv = try revisionOf(c, mut st, rev)
				let cd = try commitOf(mut st, rv.commit)
				frontier = append(frontier, pending{id: rv.commit, when: cd.Committer.When})
				seen[rv.commit.Hex()] = true
			}
			mut page = logOut{commits: []logEntry{}, next: ""}
			mut read = 0
			for len(frontier) > 0 && len(page.commits) < n && read < walkMax {
				// the newest commit waiting
				mut best = 0
				for i in 1..len(frontier) {
					if frontier[i].when > frontier[best].when {
						best = i
					}
				}
				let p = frontier[best]
				frontier[best] = frontier[len(frontier) - 1]
				frontier = frontier[:len(frontier) - 1]
				read += 1
				let cd = try commitOf(mut st, p.id)
				mut changed = true
				if len(path) > 0 {
					let mine = try idAt(mut st, cd.Tree, path)
					if len(cd.Parents) == 0 {
						changed = len(mine) > 0
					} else {
						for par in cd.Parents {
							let pd = try commitOf(mut st, par)
							let theirs = try idAt(mut st, pd.Tree, path)
							if theirs == mine {
								changed = false
							}
						}
					}
				}
				mut parents = []str{}
				for par in cd.Parents {
					let h = par.Hex()
					parents = append(parents, h)
					let (_, was) = seen[h]
					if was {
						continue
					}
					seen[h] = true
					let pd = try commitOf(mut st, par)
					frontier = append(frontier, pending{id: par, when: pd.Committer.When})
				}
				if changed {
					page.commits = append(page.commits, logEntry{id: p.id.Hex(), change: cd.Change.Letters(), title: titleOf(cd.Message), message: cd.Message, author: personOf(cd.Author), committer: personOf(cd.Committer), parents: parents, signed: len(cd.Signature) > 0})
				}
			}
			if len(frontier) > 0 && len(frontier) <= 32 {
				mut ids = []str{}
				for f in frontier {
					ids = append(ids, f.id.Hex())
				}
				page.next = twine.Join(ids, ",")
			}
			out = keep(page)
		}
	}
	return out
}

// ---- raw files ----

// rawType is the content type a raw file is served as: images as themselves, text as plain text, anything else as
// bytes. Never HTML or script: a repository's files are not this site's pages.
fn rawType(path str, binary bool) str {
	let dot = twine.LastIndex(path, ".")
	mut ext = ""
	if dot >= 0 {
		ext = twine.ToLower(path[dot + 1:])
	}
	mut other = "text/plain; charset=utf-8"
	if binary {
		other = "application/octet-stream"
	}
	return match ext {
		"png" => "image/png"
		"jpg", "jpeg" => "image/jpeg"
		"gif" => "image/gif"
		"webp" => "image/webp"
		"avif" => "image/avif"
		"ico" => "image/x-icon"
		"svg" => "image/svg+xml"
		_ => other
	}
}

// rawPolicy keeps a raw file inert when opened directly: no scripts, no plugins, a sandboxed origin.
const rawPolicy = "default-src 'none'; img-src 'self' data:; style-src 'unsafe-inline'; sandbox"

// raw is the file at {path...} of ?rev= (the default branch when empty), as bytes: what READMEs' relative images
// and the file page's Raw link load.
fn raw(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, true)
	if c == nil {
		return
	}
	let path = twine.Trim(q.PathParam("path"), "/")
	let rev = q.Param("rev")
	let (res, err) = readResolve(c, rev, path)
	if err != nil {
		answerErr(mut w, err)
		return
	}
	if res.kind != "blob" {
		fail_(mut w, 404, "not_found", "{path} is a directory")
		return
	}
	let (body, berr) = readBlob(c, res.id)
	if berr != nil {
		fail_(mut w, errStatus(berr), errCode(berr), fault.Message(berr))
		return
	}
	w.Type(rawType(path, res.binary))
	w.Head("X-Content-Type-Options", "nosniff")
	w.Head("Content-Security-Policy", rawPolicy)
	w.Head("ETag", "\"" + res.id + "\"")
	if res.commit == rev {
		w.Head("Cache-Control", "private, max-age=31536000, immutable")
	} else {
		w.Head("Cache-Control", "private, max-age=60")
	}
	if q.Param("download") == "1" {
		let name = twine.ReplaceAll(path[twine.LastIndex(path, "/") + 1:], "\"", "")
		w.Head("Content-Disposition", "attachment; filename=\"" + name + "\"")
	}
	if q.Header("If-None-Match") == "\"" + res.id + "\"" {
		w.Status(304)
		return
	}
	w.Body = []u8(body)
}

// ---- comparing ----

type compareOut struct {
	@json("from") from_ str
	to                  str
	files               []fileOut
}

// compare is the files that differ from ?from= to ?to= (each a branch, tag, change or commit; from empty compares
// with nothing, so every file of to is added): a commit's diff against its first parent, or two branches.
fn compare(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, true)
	if c == nil {
		return
	}
	let (out, err) = readCompare(c, q.Param("from"), q.Param("to"))
	if err != nil {
		answerErr(mut w, err)
		return
	}
	send(mut w, out)
}

fn readCompare(c call, from str, to str) !compareOut {
	mut out ?compareOut = nil
	try within readWithin {
		try limit memory readMemory {
			mut r = pgRepo(c)
			mut st = try r.Objects()
			let b = try revisionOf(c, mut st, to)
			let tb = try treeOf(mut st, b.commit.Hex())
			mut ta = object.NoId
			mut fromHex = ""
			if len(from) > 0 {
				let a = try revisionOf(c, mut st, from)
				ta = try treeOf(mut st, a.commit.Hex())
				fromHex = a.commit.Hex()
			}
			mut page = compareOut{from_: fromHex, to: b.commit.Hex(), files: []fileOut{}}
			let fcs = try diff.TreeDiff(mut st, ta, tb, true)
			for f in fcs {
				page.files = append(page.files, fileOut{kind: kindName(f.Kind), path: f.Path, old_path: f.OldPath, old_blob: hexOf(f.OldHash), new_blob: hexOf(f.NewHash)})
			}
			out = keep(page)
		}
	}
	if out == nil {
		fail fault.Wrap(ErrNotFound, "nothing to compare")
	}
	return out
}
