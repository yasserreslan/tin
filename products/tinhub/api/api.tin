package api

import "../../tit/change"
import "../../tit/diff"
import "../../tit/object"
import "../../tit/store"
import "../accounts"
import "../packs"
import "../repo"
import "anvil"
import "argo"
import "fault"
import "herald"
import "mint"
import "postgres"
import "redis"
import "tide"
import "twine"

// The JSON API, v1 (design/tinhub.md §4, #1019): repositories, refs, changes and their versions, the diff between two
// versions, each person's stacks, and commits, trees and blobs read from the packs through tit's store. Lists page
// with an opaque cursor; an error is {"code", "message"}. Every read runs inside within 2s and limit memory 16mb, and
// each client (a signed-in user, else an address) has a fixed window of requests in Redis.

// Deps is what the API needs, set on every core (Configure) before the first request.
type Deps struct {
	Db    postgres.Client
	Store dyn packs.PackStore
	Cache repo.RefCache
	Dir   str
	// Limits is the rate limiter (Redis); Window its window in ns and PerWindow the requests each client has in one
	Limits    redis.Client
	LimitsOn  bool
	Window    i64
	PerWindow i64
	// Auth is the signed-in user of a request (a session or a signature), 0 for nobody
	Auth fn(anvil.Req) !i64
}

mut deps ?Deps = nil

// Configure sets this core's dependencies.
fn Configure(d Deps) {
	deps = keep(d)
}

// readWithin and readMemory are a read's budget (design/tinhub.md §8).
const readWithin = 2 * tide.Second

const readMemory = 16 * 1024 * 1024

// pageMax is the most items one page has; pageSize the default.
const pageMax = 200

const pageSize = 50

// Mount adds the API's routes to r.
fn Mount(r mut anvil.Router) {
	r.Get(`/api/v1/owners/{owner}/repos`, ownerRepos)
	r.Get(`/api/v1/repos/{owner}/{repo}`, repoInfo)
	r.Get(`/api/v1/repos/{owner}/{repo}/refs`, refs)
	r.Get(`/api/v1/repos/{owner}/{repo}/changes`, changes)
	r.Get(`/api/v1/repos/{owner}/{repo}/changes/{change}`, versions)
	r.Get(`/api/v1/repos/{owner}/{repo}/changes/{change}/diff`, versionDiff)
	r.Get(`/api/v1/repos/{owner}/{repo}/stacks/{user}`, stacks)
	r.Get(`/api/v1/repos/{owner}/{repo}/commits/{id}`, commit)
	r.Get(`/api/v1/repos/{owner}/{repo}/trees/{id}`, tree)
	r.Get(`/api/v1/repos/{owner}/{repo}/blobs/{id}`, blob)
}

// apiError is every error's body.
type apiError struct {
	code    str
	message str
}

fn fail_(w mut anvil.Out, status i64, code str, message str) {
	w.Status(status)
	w.Json()
	w.Body = []u8{}
	argo.Put(mut w.Body, apiError{code: code, message: message})
}

// call is a request's context: who asks, and the repository named in its path when it has one.
type call struct {
	d    Deps
	user i64
	r    accounts.Repo
}

// begin authenticates a request, applies the rate limit and, when withRepo, finds the repository and checks the
// caller can read it (a private one the caller cannot read is 404, as one that does not exist); nil when the answer is
// written already.
fn begin(q anvil.Req, w mut anvil.Out, withRepo bool) ?call {
	let got = deps
	if got == nil {
		fail_(mut w, 503, "unavailable", "the API is not configured on this core")
		return nil
	}
	let d = got
	let auth = d.Auth
	let user = auth(q) catch err {
		fail_(mut w, 401, "unauthorized", fault.Message(err))
		return nil
	}
	if !allowed(d, q, user, mut w) {
		return nil
	}
	mut r = accounts.Repo{Id: 0, OwnerId: 0, Owner: "", Name: "", Visibility: "", DefaultBranch: "", QuotaBytes: 0, SizeBytes: 0}
	if withRepo {
		let owner = q.PathParam("owner")
		let name = q.PathParam("repo")
		let found = accounts.FindRepo(d.Db, owner, name) catch err {
			fail_(mut w, 503, "unavailable", fault.Message(err))
			return nil
		}
		if found == nil {
			fail_(mut w, 404, "not_found", "no repository {owner}/{name}")
			return nil
		}
		let role = accounts.RoleOf(d.Db, user, found) catch err {
			fail_(mut w, 503, "unavailable", fault.Message(err))
			return nil
		}
		if role == accounts.RoleNone {
			fail_(mut w, 404, "not_found", "no repository {owner}/{name}")
			return nil
		}
		r = found
	}
	return call{d: d, user: user, r: r}
}

// allowed counts the request in its client's window (a fixed window in Redis: INCR, and EXPIRE on the first); over
// the limit it answers 429 with Retry-After. Without Redis, or when Redis fails, every request is allowed.
fn allowed(d Deps, q anvil.Req, user i64, w mut anvil.Out) bool {
	if !d.LimitsOn || d.PerWindow <= 0 {
		return true
	}
	let secs = d.Window / tide.Second
	let window = tide.Wall() / d.Window
	mut who = "ip:" + q.ClientIP()
	if user > 0 {
		who = "user:{user}"
	}
	let key = "tinhub:rate:{who}:{window}"
	let n = d.Limits.Incr(key) catch err {
		herald.Log(herald.LDebug, "rate limit", []str{"error", fault.Message(err)})
		return true
	}
	if n == 1 {
		_ = d.Limits.Expire(key, d.Window * 2) catch _ {
			false
		}
	}
	if n > d.PerWindow {
		let left = secs - (tide.Wall() / tide.Second) % secs
		w.Head("Retry-After", "{left}")
		fail_(mut w, 429, "rate_limited", "more than {d.PerWindow} requests in {secs} seconds: try again in {left}")
		return false
	}
	return true
}

// pageLimit is the page size a request asks for (?limit=), within 1 and pageMax.
fn pageLimit(q anvil.Req) i64 {
	let n = mint.Atoi(q.Param("limit")) catch _ {
		pageSize
	}
	if n < 1 {
		return pageSize
	}
	if n > pageMax {
		return pageMax
	}
	return n
}

// send writes v as the JSON answer.
fn send[T](w mut anvil.Out, v T) {
	w.Json()
	w.Body = []u8{}
	argo.Put(mut w.Body, v)
}

// ---- repositories ----

type repoOut struct {
	owner          str
	name           str
	visibility     str
	default_branch str
	size_bytes     i64
}

fn repoOf(r accounts.Repo) repoOut {
	return repoOut{owner: r.Owner, name: r.Name, visibility: r.Visibility, default_branch: r.DefaultBranch, size_bytes: r.SizeBytes}
}

fn repoInfo(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, true)
	if c == nil {
		return
	}
	send(mut w, repoOf(c.r))
}

type repoPage struct {
	repos []repoOut
	next  str
}

// ownerRepos lists an owner's repositories the caller can read, by name; the cursor is the last name sent.
fn ownerRepos(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, false)
	if c == nil {
		return
	}
	let owner = q.PathParam("owner")
	let after = q.Param("cursor")
	let n = pageLimit(q)
	let (page, err) = readRepos(c, owner, after, n)
	if err != nil {
		fail_(mut w, 503, "unavailable", fault.Message(err))
		return
	}
	send(mut w, page)
}

fn readRepos(c call, owner str, after str, n i64) !repoPage {
	mut out = repoPage{repos: []repoOut{}, next: ""}
	try within readWithin + 0 {
		try limit memory readMemory + 0 {
			mut page = repoPage{repos: []repoOut{}, next: ""}
			// a page and one more, of which those the caller cannot read are left out
			let rows = try c.d.Db.Query("SELECT r.name FROM repos r JOIN owners o ON o.id = r.owner_id WHERE o.name = {owner} AND r.deleted_at IS NULL AND r.name > {after} ORDER BY r.name LIMIT 1000")
			mut last = ""
			for row in rows.Rows {
				let name = row[0].Text()
				last = name
				let found = try accounts.FindRepo(c.d.Db, owner, name)
				if found == nil {
					continue
				}
				let role = try accounts.RoleOf(c.d.Db, c.user, found)
				if role == accounts.RoleNone {
					continue
				}
				page.repos = append(page.repos, repoOf(found))
				if len(page.repos) == n {
					page.next = name
					break
				}
			}
			if len(page.repos) < n && len(rows.Rows) == 1000 {
				page.next = last
			}
			out = keep(page)
		}
	}
	return out
}

// ---- refs ----

type refOut struct {
	name   str
	target str
}

type refPage struct {
	refs []refOut
	next str
}

// refs lists the refs under ?prefix=, by name; the cursor is the last name sent.
fn refs(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, true)
	if c == nil {
		return
	}
	let (page, err) = readRefs(c, q.Param("prefix"), q.Param("cursor"), pageLimit(q))
	if err != nil {
		fail_(mut w, 503, "unavailable", fault.Message(err))
		return
	}
	send(mut w, page)
}

// pgRepo is the call's repository, its store from this core's dependencies (taking it from c trips a false E701,
// #1073).
fn pgRepo(c call) repo.PgRepo {
	return repoOf_(c.r.Id)
}

fn repoOf_(id i64) repo.PgRepo {
	let got = deps
	if got == nil {
		panic("api: no dependencies on this core")
	}
	let d = got
	return repo.PgRepo{Db: d.Db, Store: d.Store, Cache: d.Cache, Id: id, Dir: d.Dir, Who: 0}
}

fn readRefs(c call, prefix str, after str, n i64) !refPage {
	mut out = refPage{refs: []refOut{}, next: ""}
	try within readWithin + 0 {
		try limit memory readMemory + 0 {
			mut page = refPage{refs: []refOut{}, next: ""}
			let r = pgRepo(c)
			let all = try r.Refs(prefix)
			for ref in all {
				if len(after) > 0 && ref.Name <= after {
					continue
				}
				if len(page.refs) == n {
					page.next = page.refs[n - 1].name
					break
				}
				page.refs = append(page.refs, refOut{name: ref.Name, target: change.TargetText(ref.Target)})
			}
			out = keep(page)
		}
	}
	return out
}

// ---- changes and versions ----

type versionOut struct {
	version   i64
	commit    str
	op        i64
	pushed_by str
	time      i64
}

type changeOut struct {
	change  str
	newest  versionOut
	parents []str
}

type changePage struct {
	changes []changeOut
	next    str
}

// changes lists the repository's changes with their newest versions, newest first; the cursor is "<time>.<change>".
fn changes(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, true)
	if c == nil {
		return
	}
	let (page, err) = readChanges(c, "", q.Param("cursor"), pageLimit(q))
	if err != nil {
		fail_(mut w, errStatus(err), errCode(err), fault.Message(err))
		return
	}
	send(mut w, page)
}

// stacks is one person's changes (those whose newest version they pushed), newest first, each with its commit's
// parents, from which a client draws the stacks.
fn stacks(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, true)
	if c == nil {
		return
	}
	let (page, err) = readChanges(c, q.PathParam("user"), q.Param("cursor"), pageLimit(q))
	if err != nil {
		fail_(mut w, errStatus(err), errCode(err), fault.Message(err))
		return
	}
	send(mut w, page)
}

// ErrBadCursor is the fault of a cursor this API did not give.
let ErrBadCursor = fault("bad cursor")

// ErrNotFound is the fault of an object, change or version the repository does not have.
let ErrNotFound = fault("not found")

fn errStatus(err fault) i64 {
	if fault.Is(err, ErrBadCursor) {
		return 400
	}
	if fault.Is(err, ErrNotFound) {
		return 404
	}
	return 503
}

fn errCode(err fault) str {
	if fault.Is(err, ErrBadCursor) {
		return "bad_request"
	}
	if fault.Is(err, ErrNotFound) {
		return "not_found"
	}
	return "unavailable"
}

fn readChanges(c call, user str, cursor str, n i64) !changePage {
	mut out = changePage{changes: []changeOut{}, next: ""}
	mut beforeTime = 9223372036854775807
	mut beforeChange = ""
	if len(cursor) > 0 {
		let (t, ch, ok) = twine.Cut(cursor, ".")
		if !ok {
			fail fault.Wrap(ErrBadCursor, cursor)
		}
		beforeTime = mint.Atoi(t) catch _ {
			fail fault.Wrap(ErrBadCursor, cursor)
			0
		}
		beforeChange = ch
	}
	try within readWithin + 0 {
		try limit memory readMemory + 0 {
			mut page = changePage{changes: []changeOut{}, next: ""}
			let repoId = c.r.Id
			let limitN = n + 1
			let rows = try c.d.Db.Query("SELECT v.change_id, v.version, v.commit_id, v.op, coalesce(o.name, ''), (extract(epoch FROM v.created_at) * 1000000)::bigint AS t FROM (SELECT DISTINCT ON (change_id) * FROM changes WHERE repo_id = {repoId} ORDER BY change_id, version DESC) v LEFT JOIN users u ON u.id = v.pushed_by LEFT JOIN owners o ON o.id = u.owner_id WHERE ({user} = '' OR o.name = {user}) AND ((extract(epoch FROM v.created_at) * 1000000)::bigint, v.change_id) < ({beforeTime}::bigint, {beforeChange}) ORDER BY t DESC, v.change_id DESC LIMIT {limitN}")
			mut r = pgRepo(c)
			mut st = try r.Objects()
			for i, row in rows.Rows {
				if i == n {
					let last = page.changes[n - 1]
					page.next = "{last.newest.time}.{last.change}"
					break
				}
				let v = versionOut{version: row[1].Int(), commit: row[2].Text(), op: row[3].Int(), pushed_by: row[4].Text(), time: row[5].Int()}
				mut parents = []str{}
				let id = object.ParseId(v.commit) catch _ {
					object.NoId
				}
				let o = st.Get(id) catch _ {
					object.Object.Blob("")
				}
				match o {
					Commit(cd) => {
						for p in cd.Parents {
							parents = append(parents, p.Hex())
						}
					}
					Tree(_) => {
					}
					Tag(_) => {
					}
					Blob(_) => {
					}
				}
				page.changes = append(page.changes, changeOut{change: row[0].Text(), newest: v, parents: parents})
			}
			out = keep(page)
		}
	}
	return out
}

type versionsOut struct {
	change   str
	versions []versionOut
}

// versions lists a change's versions, oldest first.
fn versions(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, true)
	if c == nil {
		return
	}
	let (vs, err) = readVersions(c, q.PathParam("change"))
	if err != nil {
		fail_(mut w, errStatus(err), errCode(err), fault.Message(err))
		return
	}
	send(mut w, vs)
}

fn readVersions(c call, ch str) !versionsOut {
	mut out = versionsOut{change: ch, versions: []versionOut{}}
	try within readWithin + 0 {
		try limit memory readMemory + 0 {
			mut page = versionsOut{change: ch, versions: []versionOut{}}
			let repoId = c.r.Id
			let rows = try c.d.Db.Query("SELECT v.version, v.commit_id, v.op, coalesce(o.name, ''), (extract(epoch FROM v.created_at) * 1000000)::bigint FROM changes v LEFT JOIN users u ON u.id = v.pushed_by LEFT JOIN owners o ON o.id = u.owner_id WHERE v.repo_id = {repoId} AND v.change_id = {ch} ORDER BY v.version LIMIT 1000")
			for row in rows.Rows {
				page.versions = append(page.versions, versionOut{version: row[0].Int(), commit: row[1].Text(), op: row[2].Int(), pushed_by: row[3].Text(), time: row[4].Int()})
			}
			out = keep(page)
		}
	}
	if len(out.versions) == 0 {
		fail fault.Wrap(ErrNotFound, "no change {ch}")
	}
	return out
}

type fileOut struct {
	kind     str
	path     str
	old_path str
	old_blob str
	new_blob str
}

type diffOut struct {
	change str
	from   i64
	to     i64
	files  []fileOut
}

// versionDiff is the files that differ between two versions of a change (?from=, ?to=; by default the newest and
// the one before it).
fn versionDiff(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, true)
	if c == nil {
		return
	}
	let from = mint.Atoi(q.Param("from")) catch _ {
		0
	}
	let to = mint.Atoi(q.Param("to")) catch _ {
		0
	}
	let (d, err) = readDiff(c, q.PathParam("change"), from, to)
	if err != nil {
		fail_(mut w, errStatus(err), errCode(err), fault.Message(err))
		return
	}
	send(mut w, d)
}

fn readDiff(c call, ch str, from0 i64, to0 i64) !diffOut {
	let vs = try readVersions(c, ch)
	mut to = to0
	if to <= 0 {
		to = vs.versions[len(vs.versions) - 1].version
	}
	mut from = from0
	if from <= 0 {
		from = to - 1
	}
	mut a = ""
	mut b = ""
	for v in vs.versions {
		if v.version == from {
			a = v.commit
		}
		if v.version == to {
			b = v.commit
		}
	}
	if len(b) == 0 || (from > 0 && len(a) == 0) {
		fail fault.Wrap(ErrNotFound, "{ch} has no version {from} or {to}")
	}
	mut out = diffOut{change: ch, from: from, to: to, files: []fileOut{}}
	try within readWithin + 0 {
		try limit memory readMemory + 0 {
			mut page = diffOut{change: ch, from: from, to: to, files: []fileOut{}}
			mut r = pgRepo(c)
			mut st = try r.Objects()
			let tb = try treeOf(mut st, b)
			mut ta = object.NoId
			if len(a) > 0 {
				ta = try treeOf(mut st, a)
			}
			let fcs = try diff.TreeDiff(mut st, ta, tb, true)
			for f in fcs {
				page.files = append(page.files, fileOut{kind: kindName(f.Kind), path: f.Path, old_path: f.OldPath, old_blob: hexOf(f.OldHash), new_blob: hexOf(f.NewHash)})
			}
			out = keep(page)
		}
	}
	return out
}

fn kindName(k diff.Kind) str {
	return match k {
		Added => "added"
		Deleted => "deleted"
		Modified => "modified"
		Renamed => "renamed"
		TypeChanged => "type_changed"
	}
}

fn hexOf(raw str) str {
	if len(raw) == 0 {
		return ""
	}
	let id = object.IdOf(raw) catch _ {
		return ""
	}
	return id.Hex()
}

fn treeOf[S store.ObjectStore](st mut S, commit str) !object.Id {
	let id = try object.ParseId(commit)
	let o = st.Get(id) catch _ {
		fail fault.Wrap(ErrNotFound, "no commit {commit}")
		object.Object.Blob("")
	}
	return match o {
		Commit(cd) => cd.Tree
		Tree(_) => try notA("commit", commit)
		Tag(_) => try notA("commit", commit)
		Blob(_) => try notA("commit", commit)
	}
}

fn notA(what str, id str) !object.Id {
	fail fault.Wrap(ErrNotFound, "{id} is not a {what}")
}

// ---- objects ----

type personOut struct {
	name  str
	email str
	when  i64
	zone  i64
}

type commitOut struct {
	id        str
	tree      str
	parents   []str
	change    str
	author    personOut
	committer personOut
	message   str
	signed    bool
	conflicts []str
}

type entryOut struct {
	name str
	mode str
	id   str
}

type treeOut struct {
	id      str
	entries []entryOut
}

fn personOf(p object.Person) personOut {
	return personOut{name: p.Name, email: p.Email, when: p.When, zone: p.Zone}
}

// object reads one object of the repository's live packs.
fn readObject(c call, hex str) !object.Object {
	let id = object.ParseId(hex) catch _ {
		fail fault.Wrap(ErrNotFound, "{hex} is not an object id")
		object.NoId
	}
	mut r = pgRepo(c)
	mut st = try r.Objects()
	let o = st.Get(id) catch _ {
		fail fault.Wrap(ErrNotFound, "no object {hex}")
		object.Object.Blob("")
	}
	return o
}

fn commit(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, true)
	if c == nil {
		return
	}
	let hex = q.PathParam("id")
	let (out, err) = readCommit(c, hex)
	if err != nil {
		fail_(mut w, errStatus(err), errCode(err), fault.Message(err))
		return
	}
	send(mut w, out)
}

fn readCommit(c call, hex str) !commitOut {
	mut out ?commitOut = nil
	try within readWithin + 0 {
		try limit memory readMemory + 0 {
			let o = try readObject(c, hex)
			match o {
				Commit(cd) => {
					mut parents = []str{}
					for p in cd.Parents {
						parents = append(parents, p.Hex())
					}
					out = keep(commitOut{id: hex, tree: cd.Tree.Hex(), parents: parents, change: cd.Change.Letters(), author: personOf(cd.Author), committer: personOf(cd.Committer), message: cd.Message, signed: len(cd.Signature) > 0, conflicts: cd.Conflicts})
				}
				Tree(_) => {
				}
				Tag(_) => {
				}
				Blob(_) => {
				}
			}
		}
	}
	if out == nil {
		fail fault.Wrap(ErrNotFound, "{hex} is not a commit")
	}
	return out
}

fn tree(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, true)
	if c == nil {
		return
	}
	let hex = q.PathParam("id")
	let (out, err) = readTree(c, hex)
	if err != nil {
		fail_(mut w, errStatus(err), errCode(err), fault.Message(err))
		return
	}
	send(mut w, out)
}

fn modeName(m object.Mode) str {
	return match m {
		File => "file"
		Exec => "exec"
		Link => "link"
		Dir => "dir"
	}
}

fn readTree(c call, hex str) !treeOut {
	mut out ?treeOut = nil
	try within readWithin + 0 {
		try limit memory readMemory + 0 {
			let o = try readObject(c, hex)
			match o {
				Tree(es) => {
					mut entries = []entryOut{}
					for e in es {
						entries = append(entries, entryOut{name: e.Name, mode: modeName(e.Mode), id: e.Id.Hex()})
					}
					out = keep(treeOut{id: hex, entries: entries})
				}
				Commit(_) => {
				}
				Tag(_) => {
				}
				Blob(_) => {
				}
			}
		}
	}
	if out == nil {
		fail fault.Wrap(ErrNotFound, "{hex} is not a tree")
	}
	return out
}

// blobMemory is a blob read's budget: a blob is held whole while it is sent (packs keep it as one entry).
const blobMemory = 160 * 1024 * 1024

// blob answers a blob's bytes as application/octet-stream, sent in pieces.
fn blob(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, true)
	if c == nil {
		return
	}
	let hex = q.PathParam("id")
	let (body, err) = readBlob(c, hex)
	if err != nil {
		fail_(mut w, errStatus(err), errCode(err), fault.Message(err))
		return
	}
	w.Type("application/octet-stream")
	w.Head("Content-Length", "{len(body)}")
	w.Stream() catch _ {
		return
	}
	mut at = 0
	for at < len(body) {
		let end = min(at + 65536, len(body))
		w.Write([]u8(body[at:end])) catch _ {
			return
		}
		at = end
	}
}

fn readBlob(c call, hex str) !str {
	mut out = ""
	try within readWithin + 0 {
		try limit memory blobMemory + 0 {
			let o = try readObject(c, hex)
			match o {
				Blob(b) => {
					out = keep(b)
				}
				Commit(_) => {
					fail fault.Wrap(ErrNotFound, "{hex} is not a blob")
				}
				Tree(_) => {
					fail fault.Wrap(ErrNotFound, "{hex} is not a blob")
				}
				Tag(_) => {
					fail fault.Wrap(ErrNotFound, "{hex} is not a blob")
				}
			}
		}
	}
	return out
}
