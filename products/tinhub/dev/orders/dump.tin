package main

import "quarry"
import "replay"
import "say"

// dump CAPSULE: what one recorded request asked the outside world and what it got back, call by call. Version 2
// capsules need TIN_REPLAY_IDENTITY (a reader's private key) and TIN_REPLAY_SIGNERS.
fn word(b str, at i64) i64 {
	mut v = 0
	mut i = 7
	for i >= 0 {
		v = v << 8 | i64(b[at + i])
		i -= 1
	}
	return v
}

// shown is s on one line, its unprintable bytes as dots, cut at most bytes.
fn shown(s str, most i64) str {
	mut out = []u8{}
	for i in 0..len(s) {
		if len(out) >= most {
			return str(out) + "..."
		}
		let c = s[i]
		if c == '\n' {
			out = append(out, ' ')
		} else if c < 32 || c > 126 {
			out = append(out, '.')
		} else {
			out = append(out, c)
		}
	}
	return str(out)
}

fn main() {
	let args = quarry.Args()
	let c = replay.Open(args[1], quarry.Getenv("TIN_REPLAY_KEY")) catch err {
		say.Line("dump:", err)
		return
	}
	say.Line("request:", shown(c.Request, 120))
	say.Line("answered:", c.Status, "panic:", c.Panic)
	let b = c.Effects
	mut at = 0
	for k in 0..c.Count {
		at += 8
		let kn = word(b, at)
		let kind = b[at + 8:at + 8 + kn]
		at += 8 + kn
		let yn = word(b, at)
		let key = b[at + 8:at + 8 + yn]
		at += 8 + yn
		let outcome = word(b, at)
		at += 16
		let dn = word(b, at)
		let data = b[at + 8:at + 8 + dn]
		at += 8 + dn
		mut got = "got: "
		if outcome == 1 {
			got = "FAULT: "
		}
		say.Line("  {k + 1}. {kind}  asked: {shown(key, 110)}")
		say.Line("       {got}{shown(data, 150)}")
	}
}
