package main

// fix/free-order: a free order is answered without the card fee's share, which
// divided by the 0 charged. The calls are production's, in the same order.

import "anvil"
import "fault"
import "mint"
import "postgres"
import "quarry"
import "redis"
import "twine"
import "wire"

// orders: a payment service with three bugs that only show on some requests, for tinhub's replay checks.
// POST /orders/{id}/pay charges an order in US dollars:
//   1. Postgres: read the order (customer, amount in cents, currency, status).
//   2. Redis: the exchange rate to USD, cached as fx:<currency>.
//   3. On a cache miss, the real website api.frankfurter.dev for today's rate, then cache it for an hour.
//   4. Postgres: insert the payment, then mark the order paid.
//   5. Answer with the amount and what share of it the card fee is.
//
// The bugs:
//   - A currency the website does not price (ARS): it answers 404 {"message":"not found"}, which has no "USD": field,
//     and rateFrom takes the part after it, [1] of a split of length 1: a panic.
//   - Two "pay" clicks at once: both read the order as unpaid, the second insert breaks payments' primary key, and
//     the duplicate-key error is answered as a 500.
//   - A free order (a 100% coupon, 0 cents): the payment is written and the order marked paid, then the fee's share
//     divides by the 0 charged: a panic after the writes, so the customer sees an error for an order that is paid.
let db = postgres.Open(postgres.Options{
	Addr:     quarry.Getenv("POSTGRES_ADDR"),
	User:     quarry.Getenv("POSTGRES_USER"),
	Password: quarry.Getenv("POSTGRES_PASSWORD"),
	Database: quarry.Getenv("POSTGRES_DATABASE"),
})
let cache = redis.Open(redis.Options{Addr: quarry.Getenv("REDIS_ADDR"), Password: ""})

// cardFee is what the card network takes from every charge, in US cents.
const cardFee = 30

// rateFrom reads "USD":<number> out of the website's JSON answer.
fn rateFrom(body str) str {
	let after = twine.Split(body, "\"USD\":")[1]
	return twine.Split(after, "}}")[0]
}

fn pay(q anvil.Req, w mut anvil.Out) {
	let id = mint.Atoi(q.PathParam("id")) catch _ {
		w.Status(400)
		w.Text("bad order id\n")
		return
	}
	let rows = db.Query("SELECT customer, amount_cents, currency, status FROM orders WHERE id = {id}") catch err {
		w.Status(502)
		w.Text("db: " + fault.Message(err) + "\n")
		return
	}
	if len(rows.Rows) == 0 {
		w.Status(404)
		w.Text("no order {id}\n")
		return
	}
	let customer = rows.Rows[0][0].Text()
	let cents = rows.Rows[0][1].Int()
	let currency = rows.Rows[0][2].Text()
	if rows.Rows[0][3].Text() == "paid" {
		w.Status(409)
		w.Text("order {id} is already paid\n")
		return
	}
	let (cached, hit) = cache.Get("fx:" + currency) catch err {
		w.Status(502)
		w.Text("cache: " + fault.Message(err) + "\n")
		return
	}
	mut text = cached
	if !hit {
		let r = wire.DoWith("GET", "https://api.frankfurter.dev/v1/latest?base=" + currency + "&symbols=USD", []str{}, "", wire.Options{Timeout: 5 * 1000000000}) catch err {
			w.Status(502)
			w.Text("rates: " + fault.Message(err) + "\n")
			return
		}
		text = rateFrom(r.Body)
		cache.SetEx("fx:" + currency, text, 3600) catch _ {}
	}
	let rate = mint.ParseFloat(text) catch err {
		w.Status(500)
		w.Text("rate {text}: " + fault.Message(err) + "\n")
		return
	}
	let usd = i64(f64(cents) * rate + 0.5)
	db.Exec("INSERT INTO payments (order_id, usd_cents, rate) VALUES ({id}, {usd}, {text})") catch err {
		w.Status(500)
		w.Text("payment: " + fault.Message(err) + "\n")
		return
	}
	db.Exec("UPDATE orders SET status = 'paid' WHERE id = {id}") catch err {
		w.Status(500)
		w.Text("order: " + fault.Message(err) + "\n")
		return
	}
	if usd == 0 {
		w.Text("order {id} is free: nothing charged for {customer}\n")
		return
	}
	let feeShare = cardFee * 100 / usd
	w.Text("charged {customer} {usd} US cents for order {id} ({cents} {currency} at {text}); the card fee is {feeShare}% of it\n")
}

fn main() {
	let r = anvil.NewRouter()
	r.Post(`/orders/{id}/pay`, pay)
	let err = r.Serve(":" + quarry.Getenv("PORT"))
	if err != nil {
		panic(fault.Message(err))
	}
}
