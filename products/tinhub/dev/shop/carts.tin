package main

import "fault"
import "quarry"
import "redis"
import "say"

// The carts dev/shop/record.sh checks out, written to the Redis at REDIS_ADDR: 1 has two items (paid), 2 to 4 more
// than three (declined), 5 and 6 two each (charged while the payment service is down).
let cache = redis.Open(redis.Options{Addr: quarry.Getenv("REDIS_ADDR"), Password: ""})

fn main() {
	let carts = []str{"apples,pears", "apples,pears,plums,figs", "tea,milk,bread,eggs,jam", "pens,ink,paper,clips", "salt,rice", "soap,towels"}
	for i, items in carts {
		cache.Set("cart:{i + 1}", items) catch err {
			say.Line("carts: {fault.Message(err)}")
			quarry.Exit(1)
		}
	}
	say.Line("{len(carts)} carts")
}
