package main

import "anvil"
import "fault"
import "quarry"
import "twine"

// The payment service shop charges (dev/shop/record.sh): POST /charge with "cart=a,b,c" answers 200 "paid|r-<items>"
// for up to three items and 402 "declined: card limit exceeded" for more.

fn charge(q anvil.Req, w mut anvil.Out) {
	let body = str(q.Body())
	let items = twine.Split(twine.TrimPrefix(body, "cart="), ",")
	if len(items) > 3 {
		w.Status(402)
		w.Text("declined: card limit exceeded")
		return
	}
	w.Text("paid|r-{len(items)}")
}

fn main() {
	let r = anvil.NewRouter()
	r.Post(`/charge`, charge)
	let err = r.Serve(":" + quarry.Getenv("PORT"))
	if err != nil {
		panic(fault.Message(err))
	}
}
