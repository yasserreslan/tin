package main

import "anvil"
import "fault"
import "quarry"
import "redis"
import "twine"
import "wire"

// shop: the checkout service tinhub's replay checks are shown with (dev/shop/record.sh, design/tinhub.md §12.1).
// POST /checkout/{id} reads the cart from Redis (REDIS_ADDR) and charges it at the payment service (PAYMENTS_URL),
// which answers "paid|<receipt>".
//
// The bug: a declined charge (402, "declined: ...") has no "|", so reading the receipt panics with index out of range
// [1] with length 1. The branches under branches/ are attempts at a fix.
let cache = redis.Open(redis.Options{Addr: quarry.Getenv("REDIS_ADDR"), Password: ""})

fn checkout(q anvil.Req, w mut anvil.Out) {
	let id = q.PathParam("id")
	let (items, found) = cache.Get("cart:" + id) catch err {
		w.Status(502)
		w.Text("cart: " + fault.Message(err) + "\n")
		return
	}
	if !found {
		w.Status(404)
		w.Text("no cart " + id + "\n")
		return
	}
	let r = wire.Post(quarry.Getenv("PAYMENTS_URL") + "/charge", "text/plain", "cart=" + items) catch err {
		w.Status(500)
		w.Text("charge failed: " + fault.Message(err) + "\n")
		return
	}
	let receipt = twine.Split(r.Body, "|")[1]
	w.Text("paid " + receipt + " for " + items + "\n")
}

fn main() {
	let r = anvil.NewRouter()
	r.Post(`/checkout/{id}`, checkout)
	let err = r.Serve(":" + quarry.Getenv("PORT"))
	if err != nil {
		panic(fault.Message(err))
	}
}
