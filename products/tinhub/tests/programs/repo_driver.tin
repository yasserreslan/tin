package main

import "../../../tit/change"
import "../../../tit/object"
import "../../../tit/packfile"
import "../../../tit/store"
import "../../../tit/transport"
import "../../db"
import "../../packs"
import "../../repo"
import "fault"
import "mint"
import "postgres"
import "quarry"
import "say"
import "seal"
import "tide"
import "twine"

// The repository's process tests (#1011, #1016), driven by tests/repo.sh against TINHUB_TEST_DB (and the Redis at
// TINHUB_TEST_REDIS, keys under TINHUB_TEST_PREFIX). DIR is the node's packs.dir.
//   repo_driver setup DIR       empty the database, migrate, make repository 1 and push c1 to main
//   repo_driver race N TAG      N times: read main and move it to a new target; print the moves that landed
//   repo_driver checkrace       the refs moved as many times as the pushes that landed (the sum, on stdin)
//   repo_driver redis N         N pushes by one writer, each read back through two nodes' caches at once
//   repo_driver crash DIR       a push of c2, a repack of both packs and the retiring of the old ones (TIT_CRASH_AT)
//   repo_driver check DIR       main reaches only live packs' objects; after a sweep, rows and files agree
//   repo_driver private         make repository 1 private
//   repo_driver repo NAME       make the empty public repository ada/NAME
//   repo_driver grant EMAIL ROLE [NAME]  the user with EMAIL gets ROLE (read, write, admin) on ada/NAME (tin)

fn client() postgres.Client {
	let (o, ok) = db.TestOptions()
	if !ok {
		say.Line("TINHUB_TEST_DB is not set")
		quarry.Exit(2)
	}
	return db.Open(o)
}

let pg = client()

fn die(what str, err fault) {
	quarry.Eprintln("repo_driver: {what}: {fault.Message(err)}")
	quarry.Exit(1)
}

fn node(dir str) repo.PgRepo {
	let s = packs.NewDirStore(dir) catch err {
		die("store", err)
		return repo.PgRepo{Db: pg, Store: packs.DirStore{Root: ""}, Cache: repo.NoCache(), Id: 1, Dir: dir, Who: 0}
	}
	let cache = repo.NewRefCache(quarry.Getenv("TINHUB_TEST_REDIS"), quarry.Getenv("TINHUB_TEST_PREFIX"), 60 * tide.Second)
	return repo.PgRepo{Db: pg, Store: s, Cache: cache, Id: 1, Dir: dir, Who: 0}
}

// the objects are the same in every run: a fixed change id and fixed times
fn cid() object.ChangeId {
	let c = object.ParseChangeId("kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkl") catch _ {
		object.NewChangeId()
	}
	return c
}

fn person(when i64) object.Person {
	return object.Person{Name: "Ada", Email: "ada@example.com", When: when, Zone: 0}
}

fn commitIn(s mut store.Mem, body str, parents []object.Id, when i64) object.Id {
	let blob = s.PutRaw(object.Kind.Blob, body) catch _ {
		object.NoId
	}
	let tree = s.Put(object.Object.Tree([]object.Entry{object.Entry{Mode: object.Mode.File, Name: "a.txt", Id: blob}})) catch _ {
		object.NoId
	}
	let c = object.CommitData{Tree: tree, Parents: parents, Change: cid(), Author: person(when), Committer: person(when), GitHeaders: []str{}, Signature: "", Message: "a\n", Conflicts: []str{}}
	return s.Put(object.Object.Commit(c)) catch _ {
		object.NoId
	}
}

// objectsOf is a commit, its tree and its blob.
fn objectsOf(s mut store.Mem, id object.Id) []object.Id {
	mut out = []object.Id{id}
	let o = s.Get(id) catch _ {
		return out
	}
	match o {
		Commit(c) => {
			out = append(out, c.Tree)
			let t = s.Get(c.Tree) catch _ {
				return out
			}
			match t {
				Tree(es) => {
					for e in es {
						out = append(out, e.Id)
					}
				}
				Commit(_) => {
				}
				Tag(_) => {
				}
				Blob(_) => {
				}
			}
		}
		Tree(_) => {
		}
		Tag(_) => {
		}
		Blob(_) => {
		}
	}
	return out
}

fn stage(r mut repo.PgRepo, s mut store.Mem, ids []object.Id) str {
	let p = packfile.Write(mut s, ids, r.TempDir()) catch err {
		die("write a pack", err)
		return ""
	}
	let st = r.Stage(p.Path) catch err {
		die("stage", err)
		return ""
	}
	return st.Name
}

fn update(refs []transport.RefUpdate, changes []transport.ChangeUpdate, pack str) transport.Update {
	return transport.Update{Who: "ada@example.com", Command: "push", Changes: changes, Refs: refs, Pack: pack, Time: 1700000000 * tide.Second}
}

fn setup(dir str) {
	db.ResetForTests(pg) catch err {
		die("reset", err)
	}
	_ = db.Migrate(pg) catch err {
		die("migrate", err)
		0
	}
	_ = pg.Exec("INSERT INTO owners (name, kind) VALUES ('ada', 'user')") catch err {
		die("owner", err)
		postgres.Result{Affected: 0}
	}
	_ = pg.Exec("INSERT INTO repos (owner_id, name, visibility, quota_bytes) VALUES (1, 'tin', 'public', 1000000000)") catch err {
		die("repo", err)
		postgres.Result{Affected: 0}
	}
	quarry.RemoveAll(dir) catch _ {
	}
	mut r = node(dir)
	mut m = store.NewMem()
	let c1 = commitIn(mut m, "one\n", []object.Id{}, 1700000000)
	let p1 = stage(mut r, mut m, objectsOf(mut m, c1))
	_ = r.Commit(update([]transport.RefUpdate{transport.RefUpdate{Name: "refs/heads/main", Old: "", New: c1.Hex()}}, []transport.ChangeUpdate{transport.ChangeUpdate{Change: cid().Letters(), Replaces: "", Commit: c1.Hex()}}, p1)) catch err {
		die("push c1", err)
		0
	}
	say.Line("setup: main at {c1.Hex()[0:12]}")
}

fn mainOf(r mut repo.PgRepo) str {
	let got = r.Ref("refs/heads/main") catch err {
		die("read main", err)
		return ""
	}
	if got == nil {
		return ""
	}
	return change.TargetText(got.Target)
}

fn target(tag str, i i64) str {
	return seal.Hex(seal.RandomBytes(32))
}

// race moves main n times, each from what it read: a move another process made in between is refused RefChanged.
fn race(n i64, tag str) {
	// this run's own store directory (#1065)
	let dir = "/tmp/tin-test-tinhub-race-{tag}-{quarry.Pid()}"
	mut r = node(dir)
	mut landed = 0
	for i in 0..n {
		let old = mainOf(mut r)
		let next = target(tag, i)
		let (_, err) = r.Commit(update([]transport.RefUpdate{transport.RefUpdate{Name: "refs/heads/main", Old: old, New: next}}, []transport.ChangeUpdate{}, ""))
		if err == nil {
			landed += 1
		} else if !twine.Contains(fault.Message(err), "RefChanged") {
			die("push", err)
		}
	}
	say.Line("{landed}")
	quarry.RemoveAll(dir) catch _ {
	}
}

fn checkRace() {
	let input = quarry.ReadStdin() catch err {
		die("stdin", err)
		return
	}
	mut sum = 0
	for line in twine.Split(input, "\n") {
		if len(line) > 0 {
			sum += mint.Atoi(twine.TrimSpace(line)) catch _ {
				0
			}
		}
	}
	let rows = pg.Query("SELECT push_seq FROM repos WHERE id = 1") catch err {
		die("query", err)
		return
	}
	// setup's push is operation 1
	let seq = rows.Rows[0][0].Int()
	if seq != sum + 1 || sum == 0 {
		say.Line("FAIL race: {sum} moves landed but the repository has {seq - 1} operations after setup")
		quarry.Exit(1)
	}
	say.Line("PASS race: {sum} moves landed, each exactly once")
}

// redisReads pushes n times and reads each push back through two nodes (two Redis clients), which must see it.
fn redisReads(n i64) {
	// this run's own store directories (#1065)
	let base = "/tmp/tin-test-tinhub-redis-{quarry.Pid()}"
	mut a = node(base + "-a")
	mut b = node(base + "-b")
	mut old = mainOf(mut a)
	for i in 0..n {
		let next = target("redis", i)
		_ = a.Commit(update([]transport.RefUpdate{transport.RefUpdate{Name: "refs/heads/main", Old: old, New: next}}, []transport.ChangeUpdate{}, "")) catch err {
			die("push {i}", err)
			0
		}
		let ra = mainOf(mut a)
		let rb = mainOf(mut b)
		if ra != next || rb != next {
			say.Line("FAIL redis: push {i} moved main to {next[0:12]}, but the nodes read {ra[0:12]} and {rb[0:12]}")
			quarry.Exit(1)
		}
		old = next
		tide.Wait(20 * tide.Millisecond) catch _ {
		}
	}
	say.Line("PASS redis: {n} pushes, each read back through both nodes")
	for d in []str{base + "-a", base + "-b"} {
		quarry.RemoveAll(d) catch _ {
		}
	}
}

// crashRun pushes c2, repacks c1's and c2's packs into one and retires the two, then sweeps.
fn crashRun(dir str) {
	mut r = node(dir)
	mut m = store.NewMem()
	let c1 = commitIn(mut m, "one\n", []object.Id{}, 1700000000)
	let c2 = commitIn(mut m, "two\n", []object.Id{c1}, 1700000100)
	let before = packs.Live(pg, 1) catch err {
		die("live", err)
		return
	}
	let p2 = stage(mut r, mut m, objectsOf(mut m, c2))
	_ = r.Commit(update([]transport.RefUpdate{transport.RefUpdate{Name: "refs/heads/main", Old: c1.Hex(), New: c2.Hex()}}, []transport.ChangeUpdate{transport.ChangeUpdate{Change: cid().Letters(), Replaces: c1.Hex(), Commit: c2.Hex()}}, p2)) catch err {
		die("push c2", err)
		0
	}
	mut all = objectsOf(mut m, c1)
	for id in objectsOf(mut m, c2) {
		all = append(all, id)
	}
	let p3 = stage(mut r, mut m, all)
	_ = r.Commit(update([]transport.RefUpdate{}, []transport.ChangeUpdate{}, p3)) catch err {
		die("repack", err)
		0
	}
	mut old = before
	old = append(old, p2)
	_ = r.Retire(old) catch err {
		die("retire", err)
		0
	}
	_ = packs.Sweep(pg, mut r.Store, 0, 0) catch err {
		die("sweep", err)
		0
	}
}

// check: main's commit and its parents are in live packs; then, after the sweeps a node runs, every pack row has
// both files and every file has a row.
fn check(dir str) {
	mut r = node(dir)
	let objs = r.Objects() catch err {
		say.Line("FAIL check: the live packs do not open: {fault.Message(err)}")
		quarry.Exit(1)
		return
	}
	mut st = objs
	let main = mainOf(mut r)
	let id = object.ParseId(main) catch err {
		die("main", err)
		return
	}
	mut at = id
	for {
		let o = st.Get(at) catch err {
			say.Line("FAIL check: main reaches {at.Hex()[0:12]}, which no live pack holds: {fault.Message(err)}")
			quarry.Exit(1)
			return
		}
		mut parents = []object.Id{}
		match o {
			Commit(c) => {
				parents = c.Parents
			}
			Tree(_) => {
			}
			Tag(_) => {
			}
			Blob(_) => {
			}
		}
		if len(parents) == 0 {
			break
		}
		at = parents[0]
	}
	_ = packs.Sweep(pg, mut r.Store, 0, 0) catch err {
		die("sweep", err)
		0
	}
	_ = packs.SweepTemp(r.TempDir(), 0, tide.Wall() / tide.Second + 1) catch err {
		die("sweep temp", err)
		0
	}
	let rows = pg.Query("SELECT hash FROM packs WHERE repo_id = 1 ORDER BY hash") catch err {
		die("rows", err)
		return
	}
	mut want = []str{}
	for row in rows.Rows {
		let h = row[0].Text()
		want = append(want, packs.PackKey(1, h, "idx"))
		want = append(want, packs.PackKey(1, h, "pack"))
	}
	let keys = r.Store.List("repos/1/") catch err {
		die("list", err)
		return
	}
	let sp = " "
	let have = twine.Join(keys, sp)
	let named = twine.Join(want, sp)
	if have != named {
		say.Line("FAIL check: the store holds [{have}] but the rows name [{named}]")
		quarry.Exit(1)
	}
	let pending = pg.Query("SELECT count(*) FROM packs WHERE state <> 'live'") catch err {
		die("rows", err)
		return
	}
	if pending.Rows[0][0].Int() != 0 {
		say.Line("FAIL check: pending or retired packs left after the sweep")
		quarry.Exit(1)
	}
	say.Line("ok: main at {main[0:12]}, {len(rows.Rows)} live packs")
}

fn main() {
	let args = quarry.Args()
	if len(args) < 2 {
		say.Line("usage: repo_driver setup|race|checkrace|redis|crash|check ...")
		quarry.Exit(2)
	}
	let arg = fn(i i64) str {
		if i < len(args) {
			return args[i]
		}
		return ""
	}
	match args[1] {
		"setup" => setup(arg(2))
		"race" => {
			let n = mint.Atoi(arg(2)) catch _ {
				100
			}
			race(n, arg(3))
		}
		"checkrace" => checkRace()
		"redis" => {
			let n = mint.Atoi(arg(2)) catch _ {
				100
			}
			redisReads(n)
		}
		"crash" => crashRun(arg(2))
		"private" => {
			_ = pg.Exec("UPDATE repos SET visibility = 'private' WHERE id = 1") catch err {
				die("private", err)
				postgres.Result{Affected: 0}
			}
		}
		"check" => check(arg(2))
		"repo" => {
			// repo NAME: an empty public repository ada/NAME
			let name = arg(2)
			_ = pg.Exec("INSERT INTO repos (owner_id, name, visibility, quota_bytes) VALUES (1, {name}, 'public', 1000000000)") catch err {
				die("repo", err)
				postgres.Result{Affected: 0}
			}
		}
		"grant" => {
			// grant EMAIL ROLE [REPO]: the user with that email gets ROLE on ada/REPO (ada/tin by default), in place of a role
			// they had
			let email = arg(2)
			let role = arg(3)
			mut name = "tin"
			if len(args) > 4 {
				name = args[4]
			}
			_ = pg.Exec("INSERT INTO grants (repo_id, user_id, role) SELECT r.id, u.id, {role} FROM users u, repos r WHERE lower(u.email) = lower({email}) AND r.owner_id = 1 AND r.name = {name} ON CONFLICT (repo_id, user_id) DO UPDATE SET role = excluded.role") catch err {
				die("grant", err)
				postgres.Result{Affected: 0}
			}
		}
		_ => {
			say.Line("unknown command {args[1]}")
			quarry.Exit(2)
		}
	}
}
