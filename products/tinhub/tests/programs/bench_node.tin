package main

import "../../bench"
import "../../db"
import "../../events"
import "../../packs"
import "../../workers"
import "anvil"
import "fault"
import "hearth"
import "mint"
import "postgres"
import "quarry"
import "say"
import "tide"

// Benchmark history's process tests (#1029), driven by tests/bench.sh against TINHUB_TEST_DB. The node here is what
// main.tin is once it wires bench in: the bench routes, and on core 0 a worker running the workers' handlers (whose
// push fan-out queues the bench job) next to bench.Handlers. Requests name their user in X-Test-User.
//   bench_node serve ADDR DIR                     a node on ADDR whose pack store is the directory DIR
//   bench_node version OWNER REPO CHANGE COMMIT   version 1 of CHANGE is COMMIT, and the change has an open review:
//                                                 what reviews (#1025) record; tit push sends no versions yet
//   bench_node checks                             each bench check: "<change> <version> <state>"
//   bench_node notes                              each note with no author, its body
//   bench_node compare OWNER REPO CHANGE VERSION DIR   bench.CompareVersion now (what reviews call): the state and
//                                                 each benchmark

fn client() postgres.Client {
	let (o, ok) = db.TestOptions()
	if !ok {
		say.Line("TINHUB_TEST_DB is not set")
		quarry.Exit(2)
	}
	return db.Open(o)
}

let pg = client()

fn arg(i i64) str {
	let a = quarry.Args()
	if i < len(a) {
		return a[i]
	}
	return ""
}

let command = arg(1)

fn die(what str, err fault) {
	quarry.Eprintln("bench_node: {what}: {fault.Message(err)}")
	quarry.Exit(1)
}

// testAuth is the user X-Test-User names, 0 for nobody.
fn testAuth(q anvil.Req) !i64 {
	let h = q.Header("x-test-user")
	if len(h) == 0 {
		return 0
	}
	return try mint.Atoi(h)
}

// dirArg is the pack store's directory: serve's DIR, or compare's.
fn dirArg() str {
	if command == "compare" {
		return arg(6)
	}
	return arg(3)
}

fn store() dyn packs.PackStore {
	let s = packs.NewDirStore(dirArg()) catch err {
		die("store", err)
		return packs.DirStore{Root: ""}
	}
	let st dyn packs.PackStore = s
	return st
}

fn deps() bench.Deps {
	return bench.NewDeps(pg, store(), dirArg(), testAuth)
}

on core.start {
	if command == "compare" {
		bench.Configure(deps())
	}
	if command == "serve" {
		bench.Configure(deps())
		if hearth.ID() == 0 {
			detach {
				mut hs = workers.Handlers(workers.NewDeps(pg, store(), arg(3), 16))
				hs = append(hs, bench.Handlers(deps())...)
				let r = events.Runner{Db: pg, Handlers: hs, Lease: 30 * tide.Second, Poll: 100 * tide.Millisecond}
				r.Loop(0)
			}
		}
	}
}

// repoId is OWNER/REPO's id.
fn repoId(owner str, name str) i64 {
	let rows = pg.Query("SELECT r.id FROM repos r JOIN owners o ON o.id = r.owner_id WHERE o.name = {owner} AND r.name = {name}") catch err {
		die("repo", err)
		return 0
	}
	if len(rows.Rows) == 0 {
		quarry.Eprintln("bench_node: no repository {owner}/{name}")
		quarry.Exit(1)
	}
	return rows.Rows[0][0].Int()
}

fn main() {
	match command {
		"serve" => {
			mut r = anvil.NewRouter()
			bench.Mount(mut r)
			r.Serve(arg(2)) catch err {
				die("serve", err)
			}
		}
		"version" => {
			let id = repoId(arg(2), arg(3))
			let change = arg(4)
			let commit = arg(5)
			_ = pg.Exec("INSERT INTO changes (repo_id, change_id, version, commit_id, op) VALUES ({id}, {change}, 1, {commit}, 1000)") catch err {
				die("version", err)
				postgres.Result{Affected: 0}
			}
			_ = pg.Exec("INSERT INTO reviews (repo_id, change_id, state, target) VALUES ({id}, {change}, 'open', 'refs/heads/main')") catch err {
				die("review", err)
				postgres.Result{Affected: 0}
			}
		}
		"checks" => {
			let rows = pg.Query("SELECT change_id || ' ' || version || ' ' || state FROM checks WHERE name = 'bench' ORDER BY change_id, version") catch err {
				die("checks", err)
				postgres.Rows{Columns: []str{}, Rows: [][]postgres.Value{}}
			}
			for row in rows.Rows {
				say.Line(row[0].Text())
			}
		}
		"notes" => {
			let rows = pg.Query("SELECT body FROM comments WHERE author_id IS NULL ORDER BY id") catch err {
				die("notes", err)
				postgres.Rows{Columns: []str{}, Rows: [][]postgres.Value{}}
			}
			for row in rows.Rows {
				say.Line(row[0].Text())
			}
		}
		"compare" => {
			// DIR (the pack store) is where the version and its base are read
			let id = repoId(arg(2), arg(3))
			let version = mint.Atoi(arg(5)) catch _ {
				1
			}
			let v = bench.CompareVersion(pg, id, arg(4), version) catch err {
				die("compare", err)
				return
			}
			say.Line("state {v.State}")
			for dl in v.Deltas {
				say.Line("{dl.Name} {dl.Base} {dl.Value} {dl.Unit} slower {dl.Slower:.3} regressed {dl.Regressed}")
			}
		}
		_ => {
			quarry.Eprintln("usage: bench_node serve ADDR DIR | version OWNER REPO CHANGE COMMIT | checks | notes | compare OWNER REPO CHANGE VERSION DIR")
			quarry.Exit(2)
		}
	}
}
