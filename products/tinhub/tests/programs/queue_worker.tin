package main

import "../../db"
import "../../events"
import "fault"
import "mint"
import "postgres"
import "quarry"
import "say"
import "tide"

// The event queue's process tests (#1013), driven by tests/queue.sh against TINHUB_TEST_DB:
//   queue_worker setup N        empty the database, migrate, and queue N test.ok jobs
//   queue_worker reset          empty the database
//   queue_worker work LEASE_MS  claim and run jobs until no test job is ready or claimed
//   queue_worker check N        every test.ok job ran (at least once) and is done; none is dead
//   queue_worker sleeper        queue one test.sleep job: its first attempt sleeps 60 s, later ones return at once
//   queue_worker checksleep     the test.sleep job is done on its second attempt
//   queue_worker hog N          queue a test.hog job (over its memory budget) among N test.ok jobs
//   queue_worker checkhog N     the hog failed (dead after one attempt) and the N others are done

fn client() postgres.Client {
	let (o, ok) = db.TestOptions()
	if !ok {
		say.Line("TINHUB_TEST_DB is not set")
		quarry.Exit(2)
	}
	return db.Open(o)
}

// pg is the client the handlers use: one per process.
let pg = client()

fn ok(j events.Job) ! {
	let id = j.Id
	_ = try pg.Exec("INSERT INTO test_runs (event_id) VALUES ({id})")
}

fn sleeper(j events.Job) ! {
	if j.Attempts == 1 {
		try tide.Wait(60 * tide.Second)
	}
}

fn hog(j events.Job) ! {
	mut keepAll = [][]u8{}
	for i in 0..64 {
		keepAll = append(keepAll, make([]u8, 1024 * 1024))
	}
	say.Line("hog kept", len(keepAll), "MiB")
}

fn handlers() []events.Handler {
	return []events.Handler{
		events.Handler{Kind: "test.ok", Within: 10 * tide.Second, Memory: 0, Tasks: 0, MaxAttempts: 10, Run: ok},
		events.Handler{Kind: "test.sleep", Within: 120 * tide.Second, Memory: 0, Tasks: 0, MaxAttempts: 10, Run: sleeper},
		events.Handler{Kind: "test.hog", Within: 10 * tide.Second, Memory: 8 * 1024 * 1024, Tasks: 4, MaxAttempts: 1, Run: hog},
	}
}

fn enqueue(c postgres.Client, kind str, n i64) ! {
	_ = try c.Exec("INSERT INTO events (kind, payload) SELECT {kind}, '{{}}'::jsonb FROM generate_series(1, {n})")
}

fn setup(n i64) ! {
	let c = client()
	try db.ResetForTests(c)
	_ = try db.Migrate(c)
	_ = try c.Exec("CREATE TABLE test_runs (event_id bigint NOT NULL)")
	try enqueue(c, "test.ok", n)
}

fn work(leaseMs i64) ! {
	let c = client()
	let r = events.Runner{Db: c, Handlers: handlers(), Lease: leaseMs * tide.Millisecond, Poll: 100 * tide.Millisecond}
	let me = events.WorkerName(0)
	mut idle = 0
	for {
		let code = arena {
			step(r, c, me)
		}
		if code == 2 {
			return
		}
		if code == 0 {
			idle += 1
			try tide.Wait(100 * tide.Millisecond)
		}
	}
}

// step runs one job: 1 when one ran, 0 when none was ready, 2 when no test job is left ready or claimed.
fn step(r events.Runner, c postgres.Client, me str) i64 {
	let got = r.Step(me) catch err {
		say.Line("step:", fault.Message(err))
		false
	}
	if got {
		return 1
	}
	let left = c.Query("SELECT count(*) FROM events WHERE kind LIKE 'test.%' AND state IN ('ready', 'claimed')") catch _ {
		postgres.Rows{Columns: []str{}, Rows: [][]postgres.Value{}}
	}
	if len(left.Rows) == 1 && left.Rows[0][0].Int() == 0 {
		return 2
	}
	events.Reap(c) catch _ {
		0
	}
	return 0
}

fn check(n i64) ! {
	let c = client()
	let ran = try c.Query("SELECT count(DISTINCT event_id), count(*) FROM test_runs")
	let done = try c.Query("SELECT count(*) FILTER (WHERE state = 'done'), count(*) FILTER (WHERE state = 'dead'), count(*) FROM events WHERE kind = 'test.ok'")
	let distinct = ran.Rows[0][0].Int()
	let total = ran.Rows[0][1].Int()
	say.Line("ran", distinct, "distinct jobs,", total - distinct, "more than once; done", done.Rows[0][0].Int(), "dead", done.Rows[0][1].Int(), "of", done.Rows[0][2].Int())
	if distinct != n || done.Rows[0][0].Int() != n || done.Rows[0][1].Int() != 0 {
		fail "lost jobs"
	}
}

fn checksleep() ! {
	let c = client()
	let rows = try c.Query("SELECT state, attempts FROM events WHERE kind = 'test.sleep'")
	say.Line("sleep job", rows.Rows[0][0].Text(), "after", rows.Rows[0][1].Int(), "attempts")
	if rows.Rows[0][0].Text() != "done" || rows.Rows[0][1].Int() != 2 {
		fail "the abandoned job was not claimed again"
	}
}

fn checkhog(n i64) ! {
	let c = client()
	let rows = try c.Query("SELECT state, last_error FROM events WHERE kind = 'test.hog'")
	say.Line("hog", rows.Rows[0][0].Text())
	if rows.Rows[0][0].Text() != "dead" {
		fail "the hog did not fail"
	}
	try check(n)
}

fn arg(i i64) i64 {
	let args = quarry.Args()
	if len(args) <= i {
		return 0
	}
	let n = mint.Atoi(args[i]) catch _ {
		0
	}
	return n
}

fn main() {
	let args = quarry.Args()
	if len(args) < 2 {
		say.Line("usage: queue_worker setup|work|check|sleeper|checksleep|hog|checkhog [N]")
		quarry.Exit(2)
	}
	let err = dispatch(args[1])
	if err != nil {
		say.Line("queue_worker {args[1]}: {fault.Message(err)}")
		quarry.Exit(1)
	}
}

fn enqueueHog(n i64) ! {
	let c = client()
	try enqueue(c, "test.hog", 1)
	try enqueue(c, "test.ok", n)
}

fn dispatch(cmd str) ! {
	match cmd {
		"setup" => try setup(arg(2))
		"reset" => try db.ResetForTests(client())
		"work" => try work(arg(2))
		"check" => try check(arg(2))
		"sleeper" => try enqueue(client(), "test.sleep", 1)
		"checksleep" => try checksleep()
		"hog" => try enqueueHog(arg(2))
		"checkhog" => try checkhog(arg(2))
		_ => fail "unknown command {cmd}"
	}
}
