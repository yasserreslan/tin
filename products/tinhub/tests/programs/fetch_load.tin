package main

import "../../../tit/transport"
import "mint"
import "quarry"
import "say"
import "tide"

// The clone benchmark's load (tests/clones.sh, #1026): fetch_load URL DIR SECONDS fetches everything the repository
// at URL has (its heads, then one fetch of every ref's commit, as tit clone does) again and again for SECONDS, the
// pack streamed to DIR/pack, and prints how many fetches finished. It is tit clone without the checkout and the
// indexing, so a few processes on one machine load the server rather than themselves.

fn fetchAll(url str, path str) ! {
	mut c = transport.NewHttp(url, "", fn(s str) ![]u8 {
		return []u8{}
	})
	let heads = try c.Heads()
	mut wants = []str{}
	for ref in heads.Refs {
		wants = append(wants, ref.Target)
	}
	let a = try c.FetchTo(transport.FetchRequest{Wants: wants, Haves: []str{}, NoBlobs: false, Objects: []str{}}, path)
	if a.Objects == 0 {
		say.Line("fetch_load: an empty fetch from {url}")
		quarry.Exit(1)
	}
	quarry.Remove(path) catch _ {
	}
}

fn main() {
	let args = quarry.Args()
	if len(args) < 4 {
		say.Line("usage: fetch_load URL DIR SECONDS")
		quarry.Exit(2)
	}
	let url = args[1]
	let path = args[2] + "/pack"
	let seconds = mint.Atoi(args[3]) catch _ {
		10
	}
	let start = tide.Now()
	mut n = 0
	for tide.Since(start) < seconds * tide.Second {
		arena {
			fetchAll(url, path) catch e {
				say.Line("fetch_load: {e}")
				quarry.Exit(1)
			}
		}
		n += 1
	}
	say.Line("{n}")
}
