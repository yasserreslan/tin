package main

import "fault"
import "mint"
import "quarry"
import "say"
import "wire"

// The runner's network probe (#1028), run by runner_driver probe inside a replay's sandbox: a server of its own on
// 127.0.0.1 and a connection to it (the loopback tin replay needs), then a connection to ADDR (a server on the host, or
// the internet), which must fail.
//   runner_probe ADDR

fn line(what str, err fault) {
	if err == nil {
		say.Line(what, "ok")
		return
	}
	say.Line(what, "fail", fault.Message(err))
}

fn main() {
	let a = quarry.Args()
	if len(a) != 2 {
		say.Line("usage: runner_probe ADDR")
		quarry.Exit(2)
	}
	let (l, lerr) = wire.Listen("127.0.0.1:0")
	if lerr != nil {
		line("self", lerr)
	} else {
		let (c, err) = wire.DialTimeout("127.0.0.1:" + mint.Itoa(l.Port()), 2000000000)
		if err == nil {
			mut cc = c
			cc.Close()
		}
		line("self", err)
	}
	let (c, err) = wire.DialTimeout(a[1], 2000000000)
	if err == nil {
		mut cc = c
		cc.Close()
	}
	line("dial " + a[1], err)
}
