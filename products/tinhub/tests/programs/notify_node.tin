package main

import "../../accounts"
import "../../db"
import "../../events"
import "../../notify"
import "anvil"
import "fault"
import "hearth"
import "mint"
import "postgres"
import "quarry"
import "say"
import "tide"
import "twine"
import "websocket"

// The notifications' process tests (#1023), driven by tests/notify.sh against TINHUB_TEST_DB. A node here is what
// main.tin is once it wires notify in: the notify routes, and a worker running notify.Handlers next to a push handler
// that fans out with notify.EnqueueFor (the workers' push handler, #1014, does that in tinhub). Requests name their
// user in X-Test-User; a user is admin of the repositories of their own owner.
//   notify_node setup              empty the database, migrate, make ada (user 1, owner of ada/tin) and bob (user 2)
//   notify_node serve ADDR         a node on ADDR (TINHUB_TEST_SMTP: the mail server; NODE_WORKER=1: run the worker)
//   notify_node watch URL N SECS   a websocket client: print every message until N events came, or fail after SECS
//   notify_node event REPO CHANGE  commit a push event of repository REPO naming CHANGE, as a push does
//   notify_node states KIND        the states of the jobs of KIND, with their counts
// A node also answers POST /test/event?repo=&change=, which commits that event through it.

fn client() postgres.Client {
	let (o, ok) = db.TestOptions()
	if !ok {
		say.Line("TINHUB_TEST_DB is not set")
		quarry.Exit(2)
	}
	return db.Open(o)
}

let pg = client()

fn arg(i i64) str {
	let a = quarry.Args()
	if i < len(a) {
		return a[i]
	}
	return ""
}

let command = arg(1)

fn die(what str, err fault) {
	quarry.Eprintln("notify_node: {what}: {fault.Message(err)}")
	quarry.Exit(1)
}

// testAuth is the user X-Test-User names, 0 for nobody.
fn testAuth(q anvil.Req) !i64 {
	let h = q.Header("x-test-user")
	if len(h) == 0 {
		return 0
	}
	return try mint.Atoi(h)
}

// testRole is admin for the repositories of the user's own owner, else accounts.RoleOf.
fn testRole(c postgres.Client, userId i64, r accounts.Repo) !i64 {
	if userId != 0 {
		let owner = r.OwnerId
		let rows = try c.Query("SELECT 1 FROM users WHERE id = {userId} AND owner_id = {owner}")
		if len(rows.Rows) > 0 {
			return accounts.RoleAdmin
		}
	}
	return try accounts.RoleOf(c, userId, r)
}

fn deps() notify.Deps {
	let smtp = quarry.Getenv("TINHUB_TEST_SMTP")
	return notify.Deps{Db: pg, Auth: testAuth, Role: testRole, SmtpAddr: smtp, SmtpFrom: "tinhub@example.com", PublicURL: "http://localhost:8080", Attempts: 3, Timeout: 5 * tide.Second, AllowPrivate: quarry.Getenv("TINHUB_TEST_ROUTES") == "1", Poll: 200 * tide.Millisecond}
}

// fanOut is the push handler's fan-out, as the workers' push handler does it.
fn fanOut(j events.Job) ! {
	mut tx = try pg.Begin()
	let (_, err) = notify.EnqueueFor(mut tx, j.RepoId, j.Kind, j.Payload)
	if err != nil {
		tx.Rollback() catch _ {
		}
		fail err
	}
	try tx.Commit()
}

fn handlers() []events.Handler {
	mut hs = notify.Handlers(deps())
	hs = append(hs, events.Handler{Kind: "push", Within: 30 * tide.Second, Memory: 32 * 1024 * 1024, Tasks: 0, MaxAttempts: 10, Run: fanOut})
	return hs
}

on core.start {
	if command == "serve" {
		notify.Configure(deps())
		if hearth.ID() == 0 && quarry.Getenv("NODE_WORKER") == "1" {
			detach {
				let r = events.Runner{Db: pg, Handlers: handlers(), Lease: 30 * tide.Second, Poll: 100 * tide.Millisecond}
				r.Loop(0)
			}
		}
	}
}

fn setup() {
	db.ResetForTests(pg) catch err {
		die("reset", err)
	}
	_ = db.Migrate(pg) catch err {
		die("migrate", err)
		0
	}
	_ = pg.Exec("INSERT INTO owners (name, kind) VALUES ('ada', 'user'), ('bob', 'user')") catch err {
		die("owners", err)
		postgres.Result{Affected: 0}
	}
	_ = pg.Exec("INSERT INTO users (owner_id, email, display) VALUES (1, 'ada@example.com', 'Ada'), (2, 'bob@example.com', 'Bob')") catch err {
		die("users", err)
		postgres.Result{Affected: 0}
	}
	_ = pg.Exec("INSERT INTO repos (owner_id, name, visibility, quota_bytes) VALUES (1, 'tin', 'public', 1000000000)") catch err {
		die("repos", err)
		postgres.Result{Affected: 0}
	}
	say.Line("setup: ada/tin is repository 1")
}

// event commits a push event as a push's transaction does.
fn event(repoId i64, change str) !i64 {
	let payload = "{{\"op\":1,\"who\":\"ada@example.com\",\"pack\":\"\",\"refs\":[{{\"name\":\"refs/heads/main\",\"old\":\"\",\"new\":\"c0ffee\"}}],\"changes\":[{{\"change\":\"" + change + "\",\"replaces\":\"\",\"commit\":\"c0ffee\"}}]}}"
	mut tx = try pg.Begin()
	let (id, err) = events.Enqueue(mut tx, "push", repoId, payload)
	if err != nil {
		tx.Rollback() catch _ {
		}
		fail err
	}
	try tx.Commit()
	return id
}

// testEvent is POST /test/event?repo=&change=: a push event committed through this node.
fn testEvent(q anvil.Req, w mut anvil.Out) {
	let repoId = mint.Atoi(q.Param("repo")) catch _ {
		1
	}
	let id = event(repoId, q.Param("change")) catch err {
		w.Status(503)
		w.Text("{fault.Message(err)}\n")
		return
	}
	w.Text("{id}\n")
}

fn watch(url str, want i64, secs i64) {
	let c = websocket.Dial(url) catch err {
		die("dial", err)
		return
	}
	c.SetTimeout(secs * tide.Second)
	mut n = 0
	for n < want {
		let m = c.Read() catch err {
			die("read", err)
			return
		}
		say.Line(m.Data)
		if twine.Contains(m.Data, "\"op\":\"event\"") {
			n += 1
		}
	}
	c.Close()
}

fn main() {
	match command {
		"setup" => setup()
		"serve" => {
			mut r = anvil.NewRouter()
			notify.Mount(mut r)
			r.Post("/test/event", testEvent)
			r.Serve(arg(2)) catch err {
				die("serve", err)
			}
		}
		"watch" => {
			let n = mint.Atoi(arg(3)) catch _ {
				1
			}
			let secs = mint.Atoi(arg(4)) catch _ {
				10
			}
			watch(arg(2), n, secs)
		}
		"states" => {
			let kind = arg(2)
			let rows = pg.Query("SELECT state || ' ' || count(*) FROM events WHERE kind = {kind} GROUP BY state ORDER BY state") catch err {
				die("states", err)
				postgres.Rows{Columns: []str{}, Rows: [][]postgres.Value{}}
			}
			for row in rows.Rows {
				say.Line(row[0].Text())
			}
		}
		"event" => {
			let repoId = mint.Atoi(arg(2)) catch _ {
				1
			}
			let id = event(repoId, arg(3)) catch err {
				die("event", err)
				0
			}
			say.Line(id)
		}
		_ => {
			quarry.Eprintln("usage: notify_node setup | serve ADDR | watch URL N SECS | event REPO CHANGE")
			quarry.Exit(2)
		}
	}
}
