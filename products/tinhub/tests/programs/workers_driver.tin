package main

import "../../../tit/object"
import "../../../tit/packfile"
import "../../../tit/store"
import "../../../tit/transport"
import "../../db"
import "../../packs"
import "../../repo"
import "../../workers"
import "fault"
import "postgres"
import "quarry"
import "say"
import "tide"
import "twine"

// The repository workers' crash tests (#1014), driven by tests/workers.sh against TINHUB_TEST_DB. DIR is the node's
// packs.dir; JOB is repack, prune or purge.
//   workers_driver setup DIR        empty the database, migrate, make repository 1: four pushes to main (one pack
//                                   each), a branch pushed and deleted, and a blob nothing reaches
//   workers_driver run DIR JOB      run the job (TIT_CRASH_AT ends it at a crash point)
//   workers_driver mirror DIR GIT   mirror repository 1 into the bare git directory GIT
//   workers_driver check DIR JOB    every ref whole; the job run again finishes it (one live pack after a repack, the
//                                   unreachable objects gone after a prune or a purge); the sweep leaves rows and files
//                                   agreeing

fn client() postgres.Client {
	let (o, ok) = db.TestOptions()
	if !ok {
		say.Line("TINHUB_TEST_DB is not set")
		quarry.Exit(2)
	}
	return db.Open(o)
}

let pg = client()

fn die(what str, err fault) {
	quarry.Eprintln("workers_driver: {what}: {fault.Message(err)}")
	quarry.Exit(1)
}

fn deps(dir str) workers.Deps {
	let s = packs.NewDirStore(dir + "/store") catch err {
		die("store", err)
		return workers.NewDeps(pg, packs.DirStore{Root: ""}, dir, 16)
	}
	return workers.NewDeps(pg, s, dir, 16)
}

fn node(dir str) repo.PgRepo {
	let s = packs.NewDirStore(dir + "/store") catch err {
		die("store", err)
		return repo.PgRepo{Db: pg, Store: packs.DirStore{Root: ""}, Cache: repo.NoCache(), Id: 1, Dir: dir, Who: 0}
	}
	return repo.PgRepo{Db: pg, Store: s, Cache: repo.NoCache(), Id: 1, Dir: dir, Who: 0}
}

// the objects are the same in every run: fixed change ids and times
fn changeId(letters str) object.ChangeId {
	let c = object.ParseChangeId(letters) catch _ {
		object.NewChangeId()
	}
	return c
}

fn mainChange() object.ChangeId {
	return changeId("kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkl")
}

fn leakChange() object.ChangeId {
	return changeId("kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkm")
}

fn person(when i64) object.Person {
	return object.Person{Name: "Ada", Email: "ada@example.com", When: when, Zone: 0}
}

fn commitIn(s mut store.Mem, name str, body str, parents []object.Id, cid object.ChangeId, when i64) object.Id {
	let blob = s.PutRaw(object.Kind.Blob, body) catch _ {
		object.NoId
	}
	let tree = s.Put(object.Object.Tree([]object.Entry{object.Entry{Mode: object.Mode.File, Name: name, Id: blob}})) catch _ {
		object.NoId
	}
	let c = object.CommitData{Tree: tree, Parents: parents, Change: cid, Author: person(when), Committer: person(when), GitHeaders: []str{}, Signature: "", Message: "a\n", Conflicts: []str{}}
	return s.Put(object.Object.Commit(c)) catch _ {
		object.NoId
	}
}

fn objectsOf(s mut store.Mem, id object.Id) []object.Id {
	mut out = []object.Id{id}
	let o = s.Get(id) catch _ {
		return out
	}
	match o {
		Commit(c) => {
			out = append(out, c.Tree)
			let t = s.Get(c.Tree) catch _ {
				return out
			}
			match t {
				Tree(es) => {
					for e in es {
						out = append(out, e.Id)
					}
				}
				Commit(_) => {
				}
				Tag(_) => {
				}
				Blob(_) => {
				}
			}
		}
		Tree(_) => {
		}
		Tag(_) => {
		}
		Blob(_) => {
		}
	}
	return out
}

fn secretBody() str {
	return "AKIA-not-for-the-world\n"
}

fn push(r mut repo.PgRepo, s mut store.Mem, ids []object.Id, refs []transport.RefUpdate, changes []transport.ChangeUpdate) {
	let p = packfile.Write(mut s, ids, r.TempDir()) catch err {
		die("write a pack", err)
		return
	}
	let st = r.Stage(p.Path) catch err {
		die("stage", err)
		return
	}
	_ = r.Commit(transport.Update{Who: "ada@example.com", Command: "push", Changes: changes, Refs: refs, Pack: st.Name, Time: 1700000000 * tide.Second}) catch err {
		die("commit", err)
		0
	}
}

fn hexOr(id object.Id) str {
	if id == object.NoId {
		return ""
	}
	return id.Hex()
}

fn setup(dir str) {
	db.ResetForTests(pg) catch err {
		die("reset", err)
	}
	_ = db.Migrate(pg) catch err {
		die("migrate", err)
		0
	}
	_ = pg.Exec("INSERT INTO owners (name, kind) VALUES ('ada', 'user')") catch err {
		die("owner", err)
		postgres.Result{Affected: 0}
	}
	_ = pg.Exec("INSERT INTO repos (owner_id, name, visibility, quota_bytes) VALUES (1, 'tin', 'public', 1000000000)") catch err {
		die("repo", err)
		postgres.Result{Affected: 0}
	}
	quarry.RemoveAll(dir) catch _ {
	}
	mut r = node(dir)
	mut m = store.NewMem()
	mut prev = object.NoId
	for i in 0..4 {
		mut parents = []object.Id{}
		if prev != object.NoId {
			parents = append(parents, prev)
		}
		let c = commitIn(mut m, "a.txt", "version {i}\n", parents, mainChange(), 1700000000 + i)
		mut ids = objectsOf(mut m, c)
		if i == 3 {
			let blob = m.PutRaw(object.Kind.Blob, secretBody()) catch _ {
				object.NoId
			}
			ids = append(ids, blob)
		}
		push(mut r, mut m, ids, []transport.RefUpdate{transport.RefUpdate{Name: "refs/heads/main", Old: hexOr(prev), New: c.Hex()}}, []transport.ChangeUpdate{transport.ChangeUpdate{Change: mainChange().Letters(), Replaces: hexOr(prev), Commit: c.Hex()}})
		prev = c
	}
	let leak = commitIn(mut m, "leak.txt", "password=hunter2\n", []object.Id{}, leakChange(), 1700000100)
	push(mut r, mut m, objectsOf(mut m, leak), []transport.RefUpdate{transport.RefUpdate{Name: "refs/heads/leak", Old: "", New: leak.Hex()}}, []transport.ChangeUpdate{transport.ChangeUpdate{Change: leakChange().Letters(), Replaces: "", Commit: leak.Hex()}})
	_ = r.Commit(transport.Update{Who: "", Command: "push", Changes: []transport.ChangeUpdate{}, Refs: []transport.RefUpdate{transport.RefUpdate{Name: "refs/heads/leak", Old: leak.Hex(), New: ""}}, Pack: "", Time: 1}) catch err {
		die("delete leak", err)
		0
	}
	say.Line("setup: main at {prev.Hex()[0:12]}, 5 packs")
}

fn secretId() object.Id {
	mut m = store.NewMem()
	let id = m.PutRaw(object.Kind.Blob, secretBody()) catch _ {
		object.NoId
	}
	return id
}

fn leakId() object.Id {
	mut m = store.NewMem()
	return commitIn(mut m, "leak.txt", "password=hunter2\n", []object.Id{}, leakChange(), 1700000100)
}

fn runJob(dir str, job str) {
	mut d = deps(dir)
	let err = match job {
		"repack" => {
			let (_, e) = workers.Repack(mut d, 1)
			e
		}
		"prune" => {
			let (_, e) = workers.Prune(mut d, 1, 0)
			e
		}
		"purge" => {
			let (_, e) = workers.Purge(mut d, 1, []str{secretId().Hex()})
			e
		}
		_ => {
			say.Line("unknown job {job}")
			quarry.Exit(2)
			nil
		}
	}
	if err != nil {
		die(job, err)
	}
}

// whole fails unless every ref's history is in the live packs.
fn whole(r mut repo.PgRepo, when str) {
	let refs = r.Refs("refs/") catch err {
		die("refs", err)
		return
	}
	mut st = r.Objects() catch err {
		say.Line("FAIL {when}: the live packs do not open: {fault.Message(err)}")
		quarry.Exit(1)
		return
	}
	for ref in refs {
		mut todo = []object.Id{}
		match ref.Target {
			Commit(id) => {
				todo = append(todo, id)
			}
			Change(_) => {
			}
		}
		for len(todo) > 0 {
			let id = todo[len(todo) - 1]
			todo = todo[0:len(todo) - 1]
			let o = st.Get(id) catch err {
				say.Line("FAIL {when}: {ref.Name} reaches {id.Hex()[0:12]}, which no live pack holds: {fault.Message(err)}")
				quarry.Exit(1)
				return
			}
			match o {
				Commit(c) => {
					todo = append(todo, c.Tree)
					for p in c.Parents {
						todo = append(todo, p)
					}
				}
				Tree(es) => {
					for e in es {
						todo = append(todo, e.Id)
					}
				}
				Tag(tg) => {
					todo = append(todo, tg.Object)
				}
				Blob(_) => {
				}
			}
		}
	}
}

fn check(dir str, job str) {
	mut r = node(dir)
	whole(mut r, "after the crash")
	// the job run again finishes it
	runJob(dir, job)
	whole(mut r, "after the rerun")
	let live = packs.Live(pg, 1) catch err {
		die("live", err)
		return
	}
	let st = r.Objects() catch err {
		die("objects", err)
		return
	}
	if job == "repack" && len(live) != 1 {
		say.Line("FAIL check: {len(live)} live packs after a repack")
		quarry.Exit(1)
	}
	if (job == "prune" || job == "purge") && st.Has(secretId()) {
		say.Line("FAIL check: the unreachable blob is still live after a {job}")
		quarry.Exit(1)
	}
	if job == "prune" && st.Has(leakId()) {
		say.Line("FAIL check: the deleted branch's commit is still live after a prune")
		quarry.Exit(1)
	}
	if job == "purge" {
		// no file of the store holds it, retired or live
		let keys = r.Store.List("repos/1/") catch err {
			die("list", err)
			return
		}
		for k in keys {
			if !twine.HasSuffix(k, ".pack") {
				continue
			}
			let path = r.Store.Local(k)
			if path == nil {
				continue
			}
			let p = packfile.Open(path) catch err {
				die("open {k}", err)
				return
			}
			if p.Has(secretId()) {
				say.Line("FAIL check: {k} still holds the purged blob")
				quarry.Exit(1)
			}
		}
	}
	_ = packs.Sweep(pg, mut r.Store, 0, 0) catch err {
		die("sweep", err)
		0
	}
	_ = packs.SweepTemp(r.TempDir(), 0, tide.Wall() / tide.Second + 1) catch err {
		die("sweep temp", err)
		0
	}
	let rows = pg.Query("SELECT hash FROM packs WHERE repo_id = 1 ORDER BY hash") catch err {
		die("rows", err)
		return
	}
	mut want = []str{}
	for row in rows.Rows {
		let h = row[0].Text()
		want = append(want, packs.PackKey(1, h, "idx"))
		want = append(want, packs.PackKey(1, h, "pack"))
	}
	let keys = r.Store.List("repos/1/") catch err {
		die("list", err)
		return
	}
	let sp = " "
	let have = twine.Join(keys, sp)
	let named = twine.Join(want, sp)
	if have != named {
		say.Line("FAIL check: the store holds [{have}] but the rows name [{named}]")
		quarry.Exit(1)
	}
	whole(mut r, "after the sweep")
	say.Line("ok: {job}, {len(live)} live packs")
}

// mirrorTo mirrors repository 1 into the local git directory gitDir.
fn mirrorTo(dir str, gitDir str) {
	_ = pg.Exec("INSERT INTO mirrors (repo_id, url) VALUES (1, {gitDir}) ON CONFLICT (repo_id) DO UPDATE SET url = excluded.url") catch err {
		die("mirror row", err)
		postgres.Result{Affected: 0}
	}
	mut d = deps(dir)
	d.LocalMirrors = true
	let res = workers.Mirror(mut d, 1) catch err {
		die("mirror", err)
		return
	}
	say.Line("mirrored: {res.Objects} objects, {res.Refs} refs")
}

fn main() {
	let args = quarry.Args()
	if len(args) < 3 {
		say.Line("usage: workers_driver setup|run|check DIR [JOB]")
		quarry.Exit(2)
	}
	mut job = ""
	if len(args) > 3 {
		job = args[3]
	}
	match args[1] {
		"setup" => setup(args[2])
		"run" => runJob(args[2], job)
		"check" => check(args[2], job)
		"mirror" => mirrorTo(args[2], job)
		_ => {
			say.Line("unknown command {args[1]}")
			quarry.Exit(2)
		}
	}
}
