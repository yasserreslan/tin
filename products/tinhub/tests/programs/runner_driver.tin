// The runner's process test (#1028), driven by tests/runner.sh against TINHUB_TEST_DB. DIR is the node's packs.dir, TIN
// the toolchain the sandboxes mount (runner.tin), KEY the runner's private key file (runner.key's file:).
//   runner_driver sandbox TIN DIR          exit 0 when this machine can run the runner's sandboxes, else print why
//   runner_driver setup DIR BASE CHANGED   empty the database; org shop (owner ada) and its private repository
//                                          shop/checkout: main at a commit whose main.tin is BASE, and change m on it
//                                          whose main.tin is CHANGED
//   runner_driver upload DIR SPOOL         every capsule in SPOOL into the repository's replay store
//   runner_driver optin KEY ENV...         the runner registers its key, shop opts in, the repository replays with ENV
//   runner_driver request                  a run of change m's version 1; its id
//   runner_driver run DIR TIN KEY          the runner's claim loop until no replay.run job is left; the run's groups
//   runner_driver panel                    the behaviour panel's answer to ada, as JSON
//   runner_driver probe DIR TIN PROBE ADDR the probe (a static program) in a replay's sandbox, dialling ADDR
//   runner_driver shop DIR SHOP            as setup, with dev/shop (SHOP): main at SHOP/main.tin, and a branch fix/NAME
//                                          on it for each SHOP/branches/fix-NAME.tin
//   runner_driver check DIR TARGET         a replay check of TARGET against every failure group; the checks' ids
//   runner_driver checks DIR TIN KEY       the runner's claim loop until no job is left; every check's verdicts

fn client() postgres.Client {
	let (o, ok) = db.TestOptions()
	if !ok {
		say.Line("TINHUB_TEST_DB is not set")
		quarry.Exit(2)
	}
	return db.Open(o)
}

let pg = client()

fn die(what str, err fault) {
	quarry.Eprintln("runner_driver: {what}: {fault.Message(err)}")
	quarry.Exit(1)
}

fn args() []str {
	return quarry.Args()
}

fn dirStore(dir str) dyn packs.PackStore {
	let s = packs.NewDirStore(dir) catch err {
		die("store", err)
		return packs.DirStore{Root: ""}
	}
	let st dyn packs.PackStore = s
	return st
}

fn noAuth(q anvil.Req) !i64 {
	return 1
}

fn person(when i64) object.Person {
	return object.Person{Name: "Ada", Email: "ada@example.com", When: when, Zone: 0}
}

fn changeId(letters str) object.ChangeId {
	let c = object.ParseChangeId(letters) catch _ {
		object.NewChangeId()
	}
	return c
}

const baseChange = "kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkl"

const theChange = "kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkm"

// commitOf writes a commit whose tree holds main.tin; its id and its objects.
fn commitOf(s mut store.Mem, program str, parents []object.Id, change str, when i64) !(object.Id, []object.Id) {
	let blob = try s.PutRaw(object.Kind.Blob, program)
	let tree = try s.Put(object.Object.Tree([]object.Entry{object.Entry{Mode: object.Mode.File, Name: "main.tin", Id: blob}}))
	let c = object.CommitData{Tree: tree, Parents: parents, Change: changeId(change), Author: person(when), Committer: person(when), GitHeaders: []str{}, Signature: "", Message: "checkout\n", Conflicts: []str{}}
	let id = try s.Put(object.Object.Commit(c))
	return id, []object.Id{id, tree, blob}
}

fn setup(dir str, basePath str, changedPath str) ! {
	try db.ResetForTests(pg)
	_ = try db.Migrate(pg)
	_ = try pg.Exec("INSERT INTO owners (name, kind) VALUES ('ada', 'user')")
	_ = try pg.Exec("INSERT INTO users (owner_id, email) VALUES (1, 'ada@example.com')")
	_ = try pg.Exec("INSERT INTO owners (name, kind) VALUES ('shop', 'org')")
	_ = try pg.Exec("INSERT INTO orgs (owner_id) VALUES (2)")
	_ = try pg.Exec("INSERT INTO members (org_id, user_id, role) VALUES (1, 1, 'owner')")
	_ = try pg.Exec("INSERT INTO repos (owner_id, name, visibility, quota_bytes) VALUES (2, 'checkout', 'private', 1000000000)")
	quarry.RemoveAll(dir) catch _ {
	}
	let base = try quarry.ReadFile(basePath)
	let changed = try quarry.ReadFile(changedPath)
	mut r = repo.PgRepo{Db: pg, Store: dirStore(dir), Cache: repo.NoCache(), Id: 1, Dir: dir, Who: 1}
	mut m = store.NewMem()
	let (c1, o1) = try commitOf(mut m, base, []object.Id{}, baseChange, 1700000000)
	let (c2, o2) = try commitOf(mut m, changed, []object.Id{c1}, theChange, 1700000100)
	mut ids = o1
	for o in o2 {
		ids = append(ids, o)
	}
	let p = try packfile.Write(mut m, ids, r.TempDir())
	let st = try r.Stage(p.Path)
	let refs = []transport.RefUpdate{transport.RefUpdate{Name: "refs/heads/main", Old: "", New: c1.Hex()}}
	let changes = []transport.ChangeUpdate{transport.ChangeUpdate{Change: baseChange, Replaces: "", Commit: c1.Hex()}, transport.ChangeUpdate{Change: theChange, Replaces: "", Commit: c2.Hex()}}
	_ = try r.Commit(transport.Update{Who: "ada@example.com", Command: "push", Changes: changes, Refs: refs, Pack: st.Name, Time: 1700000000 * tide.Second})
	say.Line("setup: main at {c1.Hex()[0:12]}, change {theChange} at {c2.Hex()[0:12]}")
}

// shop is setup with dev/shop's main.tin on main and each of its branches as a commit on main.
fn shop(dir str, shopDir str) ! {
	try db.ResetForTests(pg)
	_ = try db.Migrate(pg)
	_ = try pg.Exec("INSERT INTO owners (name, kind) VALUES ('ada', 'user')")
	_ = try pg.Exec("INSERT INTO users (owner_id, email) VALUES (1, 'ada@example.com')")
	_ = try pg.Exec("INSERT INTO owners (name, kind) VALUES ('shop', 'org')")
	_ = try pg.Exec("INSERT INTO orgs (owner_id) VALUES (2)")
	_ = try pg.Exec("INSERT INTO members (org_id, user_id, role) VALUES (1, 1, 'owner')")
	_ = try pg.Exec("INSERT INTO repos (owner_id, name, visibility, quota_bytes) VALUES (2, 'checkout', 'private', 1000000000)")
	quarry.RemoveAll(dir) catch _ {
	}
	mut r = repo.PgRepo{Db: pg, Store: dirStore(dir), Cache: repo.NoCache(), Id: 1, Dir: dir, Who: 1}
	mut m = store.NewMem()
	let base = try quarry.ReadFile(shopDir + "/main.tin")
	let (c1, o1) = try commitOf(mut m, base, []object.Id{}, baseChange, 1700000000)
	mut ids = o1
	mut refs = []transport.RefUpdate{transport.RefUpdate{Name: "refs/heads/main", Old: "", New: c1.Hex()}}
	mut changes = []transport.ChangeUpdate{transport.ChangeUpdate{Change: baseChange, Replaces: "", Commit: c1.Hex()}}
	let names = try quarry.ReadDir(shopDir + "/branches")
	let letters = "mnopqrstuvwxyz"
	mut n = 0
	for name in names {
		if !twine.HasPrefix(name, "fix-") || !twine.HasSuffix(name, ".tin") {
			continue
		}
		let text = try quarry.ReadFile(shopDir + "/branches/" + name)
		let ch = "kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk" + letters[n:n + 1]
		let (c, o) = try commitOf(mut m, text, []object.Id{c1}, ch, 1700000100 + n)
		for x in o {
			ids = append(ids, x)
		}
		let branch = "refs/heads/fix/" + twine.TrimSuffix(name[4:], ".tin")
		refs = append(refs, transport.RefUpdate{Name: branch, Old: "", New: c.Hex()})
		changes = append(changes, transport.ChangeUpdate{Change: ch, Replaces: "", Commit: c.Hex()})
		n += 1
	}
	let p = try packfile.Write(mut m, ids, r.TempDir())
	let st = try r.Stage(p.Path)
	_ = try r.Commit(transport.Update{Who: "ada@example.com", Command: "push", Changes: changes, Refs: refs, Pack: st.Name, Time: 1700000000 * tide.Second})
	say.Line("shop: main at {c1.Hex()[0:12]} and {n} branches")
}

// check queues a check of target against every failure group of the repository.
fn check(dir str, target str) ! {
	runner.Configure(runner.NewDeps(pg, dirStore(dir), dir, "/nonexistent", "", "", noAuth))
	let groups = try pg.Query("SELECT id FROM replay_groups WHERE repo_id = 1 ORDER BY id")
	for g in groups.Rows {
		let id = try runner.RequestCheckNow(pg, 1, target, g[0].Text(), "", 1)
		say.Line("{id}")
	}
}

// checks runs the runner's claim loop until no job is left, then prints each check's verdicts: "check TARGET GROUP
// PANIC|status" then one "verdict VERDICT LABEL" line per capsule, and the first capsule's explanation as "why TEXT".
fn checks(dir str, tin str, keyPath str) ! {
	let d = try deps(dir, tin, keyPath)
	let loop = events.Runner{Db: pg, Handlers: runner.Handlers(d), Lease: 5 * tide.Minute, Poll: tide.Second}
	let me = events.WorkerName(0)
	for {
		let ran = try loop.Step(me)
		if !ran {
			break
		}
	}
	let ks = try runner.ChecksOf(pg, 1, "", 100)
	for i in 0..len(ks) {
		let k = ks[len(ks) - 1 - i]
		let g = try pg.Query("SELECT panic FROM replay_groups WHERE repo_id = 1 AND id = {k.Group}")
		mut what = "status"
		if len(g.Rows) > 0 && len(g.Rows[0][0].Text()) > 0 {
			what = "panic"
		}
		say.Line("check {k.Target} {what} {k.State} {k.Reason}")
		let rs = try runner.CheckResults(pg, k.Id)
		for r in rs {
			say.Line("verdict {r.Verdict} {r.Label}")
		}
		if len(rs) > 0 {
			say.Line("why {rs[0].Detail}")
		}
	}
}

// upload stores every capsule of the spool as tit's server does, after checking its signature.
fn upload(dir str, spool str) ! {
	let names = try quarry.ReadDir(spool)
	capsules.Configure(capsules.Deps{Db: pg, Store: dirStore(dir), Dir: dir, Auth: noAuth})
	mut n = 0
	for name in names {
		if !twine.HasSuffix(name, ".tcap") {
			continue
		}
		let data = try quarry.ReadFile(spool + "/" + name)
		let (signer, summary) = try replay.Summary(data)
		let id = seal.Hex(seal.Sha256(data))
		let tmp = dir + "/upload.tmp"
		try quarry.WriteFile(tmp, data)
		mut st = dirStore(dir)
		_ = try st.Put(packs.CapsuleKey(1, id), tmp)
		let e = transport.ReplayEntry{Id: id, Group: "", Name: name, Commit: "", Signer: signer, Summary: summary, Time: 0}
		_ = try capsules.Record(pg, 1, e, len(data))
		n += 1
	}
	say.Line("uploaded {n} capsules")
}

fn readKey(path str) !secret str {
	let text = try quarry.ReadFile(path)
	let k secret str = twine.TrimSpace(text)
	return k
}

fn optin(keyPath str, env []str) ! {
	let key = try readKey(keyPath)
	let keyId = try runner.Register(pg, key)
	try runner.SetOptIn(pg, 2, keyId, []str{}, 1)
	try runner.SetSettings(pg, 1, runner.Settings{Entry: "main.tin", Sample: 50, Env: env})
	say.Line("opted in for {keyId[0:12]}")
}

fn deps(dir str, tin str, keyPath str) !runner.Deps {
	let key = try readKey(keyPath)
	mut d = runner.NewDeps(pg, dirStore(dir), dir, tin, key, quarry.Getenv("TINHUB_RUNNER_CGROUP"), noAuth)
	// TINHUB_RUNNER_SANDBOX=off runs the builds and replays as plain processes, as runner.sandbox = off does
	if quarry.Getenv("TINHUB_RUNNER_SANDBOX") == "off" {
		d.Sandbox = "off"
	}
	return d
}

fn request() ! {
	let id = try runner.RequestNow(pg, 1, theChange, 1, 1)
	say.Line("{id}")
}

// run is the runner role's claim loop over replay.run jobs, until none is left.
fn run(dir str, tin str, keyPath str) ! {
	let d = try deps(dir, tin, keyPath)
	let loop = events.Runner{Db: pg, Handlers: runner.Handlers(d), Lease: 5 * tide.Minute, Poll: tide.Second}
	let me = events.WorkerName(0)
	for {
		let ran = try loop.Step(me)
		if !ran {
			break
		}
	}
	let r = try runner.RunOf(pg, 1, theChange, 1)
	if r == nil {
		fail "no run"
	}
	say.Line("run {r.State} capsules {r.Capsules} reason {r.Reason}")
	let gs = try runner.Groups(pg, r.Id)
	for g in gs {
		say.Line("group {g.Outcome} {g.Count} {g.Label}")
	}
}

fn panel() {
	runner.Configure(runner.NewDeps(pg, packs.DirStore{Root: "/nonexistent"}, "/nonexistent", "/nonexistent", "", "", noAuth))
	mut r = anvil.NewRouter()
	runner.Mount(mut r)
	let w = r.Run("GET", "/api/v1/repos/shop/checkout/changes/{theChange}/behaviour", "")
	say.Line(w.Code())
	say.Line(str(w.Body))
}

// sandboxOk runs /bin/true in a replay's sandbox: the machine has user namespaces and what the sandbox needs.
fn sandboxOk(tin str, dir str) {
	quarry.MkdirAll(dir + "/probe-scratch") catch err {
		die("mkdir", err)
	}
	let d = runner.NewDeps(pg, packs.DirStore{Root: dir}, dir, tin, "", "", noAuth)
	let r = sandbox.Run(runner.SandboxFor(d, "", dir + "/probe-scratch", []str{"/bin/true"}, []str{})) catch err {
		say.Line(fault.Message(err))
		quarry.Exit(1)
		return
	}
	if r.Code != 0 {
		say.Line("/bin/true exited {r.Code}: {r.Stderr}")
		quarry.Exit(1)
	}
	say.Line("ok")
}

// probe runs the probe program in exactly the sandbox a replay gets, dialling itself and addr.
fn probe(dir str, tin str, prog str, addr str) ! {
	let scratch = dir + "/probe-scratch"
	try quarry.MkdirAll(scratch)
	let data = try quarry.ReadFile(prog)
	try quarry.WriteFile(scratch + "/probe", data)
	try quarry.Chmod(scratch + "/probe", 493)
	let d = runner.NewDeps(pg, packs.DirStore{Root: dir}, dir, tin, "", "", noAuth)
	let r = try sandbox.Run(runner.SandboxFor(d, "", scratch, []str{"/scratch/probe", addr}, []str{}))
	say.Text(r.Stdout)
	if r.Code != 0 {
		say.Line("probe exited {r.Code}: {r.Stderr}")
	}
}

// dispatch runs the command a names.
fn dispatch(a []str) ! {
	match a[1] {
		"sandbox" => sandboxOk(a[2], a[3])
		"setup" => {
			try setup(a[2], a[3], a[4])
		}
		"upload" => {
			try upload(a[2], a[3])
		}
		"optin" => {
			try optin(a[2], a[3:])
		}
		"request" => {
			try request()
		}
		"run" => {
			try run(a[2], a[3], a[4])
		}
		"panel" => panel()
		"shop" => {
			try shop(a[2], a[3])
		}
		"check" => {
			try check(a[2], a[3])
		}
		"checks" => {
			try checks(a[2], a[3], a[4])
		}
		"probe" => {
			try probe(a[2], a[3], a[4], a[5])
		}
		_ => {
			fail "unknown command {a[1]}"
		}
	}
}

fn main() {
	let a = args()
	if len(a) < 2 {
		say.Line("usage: runner_driver sandbox|setup|upload|optin|request|run|panel|probe|shop|check|checks ...")
		quarry.Exit(2)
	}
	dispatch(a) catch err {
		die(a[1], err)
	}
}
