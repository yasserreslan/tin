// The reviews' process test (#1025), driven by tests/review.sh against TINHUB_TEST_DB. A node here is what main.tin
// is once it wires reviews in: the protocol (proto) and the review routes, and a worker running the push fan-out
// (workers.Handlers, whose followUps call review.EnqueueFor) and review.Handlers. Pushes go over the wire as tit's
// protocol client sends them, signed with bob's key, carrying change versions. API callers name their user in
// X-Test-User; a check is signed with ci's key over HTTP (401 and a nonce first).
//   review_node setup DIR             empty the database, migrate; ada (owner of the public ada/tin), bob, carol and
//                                     ci (writers); bob's and ci's keys in DIR; one approval and the ci check required
//   review_node serve ADDR DIR        a node and its worker on ADDR, packs under DIR
//   review_node push URL DIR PHASE    push over the protocol as bob: base (main), stack (changes A, B and C, A under B
//                                     under C), move (main moves: README), conflict (change D, against move's README)
//   review_node ids                   the commits and change ids: "NAME change commit", one a line
//   review_node check URL DIR CHANGE STATE   post the ci check on CHANGE's newest version, signed with ci's key
//   review_node log URL DIR REF       the first parents from REF's commit on the server, one commit a line
//   review_node moves                 every move of main the push events record: "old new", oldest first

fn client() postgres.Client {
	let (o, ok) = db.TestOptions()
	if !ok {
		say.Line("TINHUB_TEST_DB is not set")
		quarry.Exit(2)
	}
	return db.Open(o)
}

let pg = client()

fn arg(i i64) str {
	let a = quarry.Args()
	if i < len(a) {
		return a[i]
	}
	return ""
}

let command = arg(1)

const nonceKey = "test-nonce-secret-0123456789"

fn die(what str, err fault) {
	quarry.Eprintln("review_node: {what}: {fault.Message(err)}")
	quarry.Exit(1)
}

fn testAuth(q anvil.Req) !i64 {
	let h = q.Header("x-test-user")
	if len(h) == 0 {
		return 0
	}
	return try mint.Atoi(h)
}

// ---- the node ----

fn storeAt(dir str) dyn packs.PackStore {
	let s = packs.NewDirStore(dir) catch err {
		die("store", err)
		return packs.DirStore{Root: ""}
	}
	let st dyn packs.PackStore = s
	return st
}

fn reviewDeps(dir str) review.Deps {
	return review.Deps{Db: pg, Store: storeAt(dir), Cache: repo.NoCache(), Dir: dir, NonceKey: nonceKey, Auth: testAuth}
}

fn handlers(dir str) []events.Handler {
	mut hs = workers.Handlers(workers.NewDeps(pg, storeAt(dir), dir, 16))
	hs = append(hs, review.Handlers(reviewDeps(dir))...)
	return hs
}

on core.start {
	if command == "serve" {
		let dir = keep(arg(3))
		review.Configure(reviewDeps(dir))
		proto.Configure(proto.Deps{Db: pg, Store: storeAt(dir), Cache: repo.NoCache(), Dir: dir, NonceKey: nonceKey, Pack: 1 << 30, Refs: 1000, PushWithin: 60 * tide.Second, PushMemory: 512 * 1024 * 1024, FetchWithin: 60 * tide.Second, FetchMemory: 256 * 1024 * 1024})
		if hearth.ID() == 0 {
			detach {
				let r = events.Runner{Db: pg, Handlers: handlers(dir), Lease: 60 * tide.Second, Poll: 100 * tide.Millisecond}
				r.Loop(0)
			}
		}
	}
}

// ---- setup ----

fn exec(q query) {
	_ = pg.Exec(q) catch err {
		die("setup", err)
		postgres.Result{Affected: 0}
	}
}

// keyOf is the key of a user kept in DIR/<name>.key: its seed, made on the first call.
fn keyOf(dir str, name str) []u8 {
	let path = dir + "/" + name + ".key"
	if quarry.Exists(path) {
		let text = quarry.ReadFile(path) catch err {
			die("read a key", err)
			return []u8{}
		}
		let seed = seal.HexDecode(twine.TrimSpace(text)) catch err {
			die("a key", err)
			return []u8{}
		}
		return seed
	}
	let seed = seal.RandomBytes(32)
	quarry.WriteFile(path, seal.Hex(seed) + "\n") catch err {
		die("write a key", err)
	}
	return seed
}

fn setup(dir str) {
	db.ResetForTests(pg) catch err {
		die("reset", err)
	}
	_ = db.Migrate(pg) catch err {
		die("migrate", err)
		0
	}
	quarry.MkdirAll(dir) catch err {
		die("dir", err)
	}
	exec("INSERT INTO owners (name, kind) VALUES ('ada', 'user'), ('bob', 'user'), ('carol', 'user'), ('ci', 'user')")
	exec("INSERT INTO users (owner_id, email) VALUES (1, 'ada@example.com'), (2, 'bob@example.com'), (3, 'carol@example.com'), (4, 'ci@example.com')")
	exec("INSERT INTO repos (owner_id, name, visibility, quota_bytes) VALUES (1, 'tin', 'public', 1000000000)")
	exec("INSERT INTO grants (repo_id, user_id, role) VALUES (1, 2, 'write'), (1, 3, 'write'), (1, 4, 'write')")
	exec("INSERT INTO review_settings (repo_id, approvals, required_checks) VALUES (1, 1, ARRAY['ci'])")
	for name in []str{"bob", "ci"} {
		let pub = seal.Ed25519PublicKey(keyOf(dir, name)) catch err {
			die("a public key", err)
			return
		}
		let text = seal.B64(pub)
		let email = name + "@example.com"
		exec("INSERT INTO keys (user_id, public_key, name) SELECT id, {text}, 'test' FROM users WHERE email = {email}")
	}
	say.Line("setup: ada/tin; bob, carol and ci write to it")
}

// ---- the commits: the same in every run (fixed change ids and times) ----

fn changeId(last str) object.ChangeId {
	let c = object.ParseChangeId("kkkkkkkkkkkkkkkkkkkkkkkkkkkkkk" + last) catch _ {
		object.NewChangeId()
	}
	return c
}

const lstat = "package os\n\n// Lstat stats a link.\nfn Lstat(p str) i64 {{\n\tlet n = len(p)\n\treturn n + 1\n}}\n"

fn baseFiles() map[str]str {
	return map[str]str{"README": "tin\n", "a.tin": "package a\n\nfn A() i64 {{\n\treturn 1\n}}\n", "b.tin": "package a\n\nfn B() i64 {{\n\treturn 1\n}}\n", "c.tin": "package a\n\nfn C() i64 {{\n\treturn 1\n}}\n", "os/os.tin": lstat}
}

fn with(files map[str]str, path str, text str) map[str]str {
	mut out = map[str]str{}
	for k, v in files {
		out[k] = v
	}
	out[path] = text
	return out
}

fn treeOf(s mut store.Mem, files map[str]str, prefix str) !object.Id {
	mut names = []str{}
	mut dirs = map[str]bool{}
	for path, _ in files {
		if !twine.HasPrefix(path, prefix) {
			continue
		}
		let rest = path[len(prefix):]
		let slash = twine.IndexByte(rest, '/')
		if slash < 0 {
			names = append(names, rest)
		} else {
			let (_, seen) = dirs[rest[0:slash]]
			if !seen {
				dirs[rest[0:slash]] = true
				names = append(names, rest[0:slash] + "/")
			}
		}
	}
	// tree entries in name order
	for i in 1..len(names) {
		mut j = i
		for j > 0 && names[j - 1] > names[j] {
			let x = names[j]
			names[j] = names[j - 1]
			names[j - 1] = x
			j -= 1
		}
	}
	mut es = []object.Entry{}
	for n in names {
		if twine.HasSuffix(n, "/") {
			let sub = try treeOf(mut s, files, prefix + n)
			es = append(es, object.Entry{Mode: object.Mode.Dir, Name: n[0:len(n) - 1], Id: sub})
		} else {
			let (body, _) = files[prefix + n]
			let blob = try s.PutRaw(object.Kind.Blob, body)
			es = append(es, object.Entry{Mode: object.Mode.File, Name: n, Id: blob})
		}
	}
	return try s.Put(object.Object.Tree(es))
}

fn commit(s mut store.Mem, files map[str]str, parents []object.Id, cid object.ChangeId, message str, when i64) !object.Id {
	let tree = try treeOf(mut s, files, "")
	let who = object.Person{Name: "Bob", Email: "bob@example.com", When: when, Zone: 0}
	return try s.Put(object.Object.Commit(object.CommitData{Tree: tree, Parents: parents, Change: cid, Author: who, Committer: who, GitHeaders: []str{}, Signature: "", Message: message, Conflicts: []str{}}))
}

// commits is every commit of the scenario, by name: m0 and m1 on main, A, B and C stacked on m0, D on m0.
type commits struct {
	m0 object.Id
	m1 object.Id
	a  object.Id
	b  object.Id
	c  object.Id
	d  object.Id
}

fn build(s mut store.Mem) !commits {
	let f0 = baseFiles()
	let m0 = try commit(mut s, f0, []object.Id{}, changeId("ko"), "base\n", 1700000000)
	let fa = with(f0, "a.tin", "package a\n\nfn A() i64 {{\n\treturn 2\n}}\n")
	let a = try commit(mut s, fa, []object.Id{m0}, changeId("kl"), "a: two\n", 1700000010)
	let fb = with(fa, "b.tin", "package a\n\nfn B() i64 {{\n\treturn 2\n}}\n")
	let b = try commit(mut s, fb, []object.Id{a}, changeId("km"), "b: two\n", 1700000020)
	let fc = with(fb, "c.tin", "package a\n\nfn C() i64 {{\n\treturn 2\n}}\n")
	let c = try commit(mut s, fc, []object.Id{b}, changeId("kn"), "c: two\n", 1700000030)
	let m1 = try commit(mut s, with(f0, "README", "tin, the language\n"), []object.Id{m0}, changeId("kp"), "readme\n", 1700000040)
	let d = try commit(mut s, with(f0, "README", "tin, a language\n"), []object.Id{m0}, changeId("kq"), "readme too\n", 1700000050)
	return commits{m0: m0, m1: m1, a: a, b: b, c: c, d: d}
}

fn ref(name str, old object.Id, next object.Id) transport.RefUpdate {
	mut o = ""
	if old != object.NoId {
		o = old.Hex()
	}
	return transport.RefUpdate{Name: name, Old: o, New: next.Hex()}
}

fn version(cid str, c object.Id) transport.ChangeUpdate {
	return transport.ChangeUpdate{Change: cid, Replaces: "", Commit: c.Hex()}
}

// push sends one phase over the protocol, signed by bob, with every object of the scenario in its pack.
fn push(url str, dir str, phase str) ! {
	mut s = store.NewMem()
	let cs = try build(mut s)
	mut req = transport.PushRequest{Changes: []transport.ChangeUpdate{}, Refs: []transport.RefUpdate{}}
	match phase {
		"base" => {
			req.Refs = append(req.Refs, ref("refs/heads/main", object.NoId, cs.m0))
		}
		"stack" => {
			req.Changes = append(req.Changes, version(changeId("kl").Letters(), cs.a), version(changeId("km").Letters(), cs.b), version(changeId("kn").Letters(), cs.c))
			req.Refs = append(req.Refs, ref("refs/heads/stack", object.NoId, cs.c))
		}
		"move" => {
			req.Refs = append(req.Refs, ref("refs/heads/main", cs.m0, cs.m1))
		}
		"conflict" => {
			req.Changes = append(req.Changes, version(changeId("kq").Letters(), cs.d))
		}
		_ => {
			fail "no phase {phase}"
		}
	}
	let ids = try s.Match("")
	try quarry.MkdirAll(dir + "/client")
	let p = try packfile.Write(mut s, ids, dir + "/client")
	let data = try quarry.ReadFile(p.Path)
	let seed = keyOf(dir, "bob")
	mut h = transport.NewHttp(url + "/ada/tin", "bob@example.com", fn(payload str) ![]u8 {
		return try seal.SignEd25519(seed, []u8(payload))
	})
	_ = try h.Heads()
	let a = try h.Push(req, data)
	say.Line("pushed {phase}: {len(a.Refs)} refs")
}

fn ids() ! {
	mut s = store.NewMem()
	let cs = try build(mut s)
	let names = []str{"m0", "m1", "A", "B", "C", "D"}
	let lasts = []str{"ko", "kp", "kl", "km", "kn", "kq"}
	let ids_ = []object.Id{cs.m0, cs.m1, cs.a, cs.b, cs.c, cs.d}
	for i in 0..len(names) {
		say.Line(names[i] + " " + changeId(lasts[i]).Letters() + " " + ids_[i].Hex())
	}
}

// ---- a signed check ----

type nonceAnswer struct {
	nonce str
}

fn check(url str, dir str, change str, state str) ! {
	let path = "/api/v1/repos/ada/tin/changes/" + change + "/checks"
	let body = "{{\"name\":\"ci\",\"state\":\"" + state + "\",\"url\":\"https://ci.example.com/" + change + "\"}}"
	let opts = wire.Options{Timeout: 30 * tide.Second, MaxBody: 1 << 20, MaxIdle: 0}
	let first = try wire.DoWith("POST", url + path, []str{"Content-Type", "application/json"}, body, opts)
	if first.Status != 401 {
		fail "an unsigned check: {first.Status}, not 401"
	}
	mut n = nonceAnswer{nonce: ""}
	try argo.Get(first.Body, mut n)
	let sig = try seal.SignEd25519(keyOf(dir, "ci"), []u8(transport.SigningPayload("POST", path, n.nonce, body)))
	let r = try wire.DoWith("POST", url + path, []str{"Content-Type", "application/json", "Tit-Signature", transport.SignatureHeader("ci@example.com", n.nonce, sig)}, body, opts)
	say.Line("{r.Status} {r.Body}")
	if r.Status != 201 {
		fail "the signed check: {r.Status}"
	}
}

// log prints the first parents from a ref's commit on the server, reading the packs the node keeps.
fn log(dir str, name str) ! {
	let rows = try pg.Query("SELECT target FROM refs WHERE repo_id = 1 AND name = {name}")
	if len(rows.Rows) == 0 {
		fail "no ref {name}"
	}
	mut r = repo.PgRepo{Db: pg, Store: storeAt(dir), Cache: repo.NoCache(), Id: 1, Dir: dir, Who: 0}
	mut st = try r.Objects()
	mut at = try object.ParseId(rows.Rows[0][0].Text())
	for i in 0..100 {
		let o = try st.Get(at)
		mut next = object.NoId
		match o {
			Commit(cd) => {
				say.Line("{at.Hex()} {cd.Change.Letters()} {twine.TrimSpace(cd.Message)}")
				if len(cd.Parents) > 0 {
					next = cd.Parents[0]
				}
			}
			Tree(_) => {
			}
			Tag(_) => {
			}
			Blob(_) => {
			}
		}
		if next == object.NoId {
			return
		}
		at = next
	}
}

fn main() {
	match command {
		"setup" => setup(arg(2))
		"serve" => {
			mut r = anvil.NewRouter()
			review.Mount(mut r)
			proto.Mount(mut r)
			r.Serve(arg(2)) catch err {
				die("serve", err)
			}
		}
		"push" => {
			push(arg(2), arg(3), arg(4)) catch err {
				die("push", err)
			}
		}
		"ids" => {
			ids() catch err {
				die("ids", err)
			}
		}
		"check" => {
			check(arg(2), arg(3), arg(4), arg(5)) catch err {
				die("check", err)
			}
		}
		"moves" => {
			let rows = pg.Query("SELECT r->>'old' || ' ' || (r->>'new') FROM events e, jsonb_array_elements(e.payload->'refs') r WHERE e.repo_id = 1 AND e.kind = 'push' AND r->>'name' = 'refs/heads/main' ORDER BY e.id") catch err {
				die("moves", err)
				postgres.Rows{Columns: []str{}, Rows: [][]postgres.Value{}}
			}
			for row in rows.Rows {
				say.Line(row[0].Text())
			}
		}
		"log" => {
			log(arg(3), arg(4)) catch err {
				die("log", err)
			}
		}
		_ => {
			quarry.Eprintln("usage: review_node setup DIR | serve ADDR DIR | push URL DIR PHASE | ids | check URL DIR CHANGE STATE | log URL DIR REF")
			quarry.Exit(2)
		}
	}
}
