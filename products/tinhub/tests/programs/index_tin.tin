package main

import "../../../tit/object"
import "../../../tit/packfile"
import "../../../tit/store"
import "../../../tit/transport"
import "../../db"
import "../../index"
import "../../packs"
import "../../repo"
import "anvil"
import "fault"
import "postgres"
import "quarry"
import "say"
import "sift"
import "tide"
import "twine"

// The symbol index's measurement on a real tree (#1020), against TINHUB_TEST_DB (emptied):
//   index_tin LIST ROOT DIR
// pushes the files LIST names (one path per line, relative to ROOT; `git ls-files` of the Tin repository) to
// refs/heads/main of a new repository with its packs under DIR, indexes that commit inside the index job's budget
// (index.Within, index.Memory), then pushes an edit of one package's file and indexes again from the first commit.
// It prints each run's time, packages and symbols.

fn die(what str, err fault) {
	quarry.Eprintln("index_tin: {what}: {fault.Message(err)}")
	quarry.Exit(1)
}

fn nobody(q anvil.Req) !i64 {
	return 0
}

fn person() object.Person {
	return object.Person{Name: "Ada", Email: "ada@example.com", When: 1700000000, Zone: 0}
}

// node is one directory of the tree being written: its files and its subdirectories by name.
type node struct {
	files map[str]str
	dirs  []str
}

fn treeOf(s mut store.Mem, nodes map[str]node, dir str, ids mut []object.Id) !object.Id {
	let (n, _) = nodes[dir]
	mut names = []str{}
	for name, _ in n.files {
		names = append(names, name)
	}
	for name in n.dirs {
		names = append(names, name + "/")
	}
	sift.Strs(mut names)
	mut entries = []object.Entry{}
	for k in names {
		if twine.HasSuffix(k, "/") {
			let name = k[0:len(k) - 1]
			mut sub = name
			if len(dir) > 0 {
				sub = dir + "/" + name
			}
			let id = try treeOf(mut s, nodes, sub, mut ids)
			entries = append(entries, object.Entry{Mode: object.Mode.Dir, Name: name, Id: id})
		} else {
			let (body, _) = n.files[k]
			let blob = try s.PutRaw(object.Kind.Blob, body)
			ids = append(ids, blob)
			entries = append(entries, object.Entry{Mode: object.Mode.File, Name: k, Id: blob})
		}
	}
	let tree = try s.Put(object.Object.Tree(entries))
	ids = append(ids, tree)
	return tree
}

fn client() postgres.Client {
	let (o, ok) = db.TestOptions()
	if !ok {
		say.Line("TINHUB_TEST_DB is not set")
		quarry.Exit(2)
	}
	return db.Open(o)
}

// pg is the database (a global: a repository built from a parameter's client and then called mut trips a false E701,
// #1073)
let pg = client()

fn main() {
	let args = quarry.Args()
	if len(args) < 4 {
		quarry.Eprintln("usage: index_tin LIST ROOT DIR")
		quarry.Exit(2)
	}
	run(args[1], args[2], args[3]) catch err {
		die("run", err)
	}
}

fn commitOf(s mut store.Mem, files map[str]str, parents []object.Id, ids mut []object.Id) !object.Id {
	mut nodes = map[str]node{}
	nodes[""] = node{files: map[str]str{}, dirs: []str{}}
	mut paths = []str{}
	for p, _ in files {
		paths = append(paths, p)
	}
	sift.Strs(mut paths)
	for p in paths {
		let (body, _) = files[p]
		place(mut nodes, p, body)
	}
	let tree = try treeOf(mut s, nodes, "", mut ids)
	let c = object.CommitData{Tree: tree, Parents: parents, Change: object.NewChangeId(), Author: person(), Committer: person(), GitHeaders: []str{}, Signature: "", Message: "index_tin\n", Conflicts: []str{}}
	let id = try s.Put(object.Object.Commit(c))
	ids = append(ids, id)
	return id
}

// place puts a file into nodes, making its directories.
fn place(nodes mut map[str]node, path str, body str) {
	let parts = twine.Split(path, "/")
	mut dir = ""
	for i in 0..len(parts) - 1 {
		mut sub = parts[i]
		if len(dir) > 0 {
			sub = dir + "/" + parts[i]
		}
		let (_, have) = nodes[sub]
		if !have {
			nodes[sub] = node{files: map[str]str{}, dirs: []str{}}
			let (p, _) = nodes[dir]
			nodes[dir] = node{files: p.files, dirs: append(p.dirs, parts[i])}
		}
		dir = sub
	}
	let (n, _) = nodes[dir]
	n.files[parts[len(parts) - 1]] = body
}

fn push(r mut repo.PgRepo, s mut store.Mem, ids []object.Id, old str, next str) ! {
	let p = try packfile.Write(mut s, ids, r.TempDir())
	let st = try r.Stage(p.Path)
	_ = try r.Commit(transport.Update{Who: "ada@example.com", Command: "push", Changes: []transport.ChangeUpdate{}, Refs: []transport.RefUpdate{transport.RefUpdate{Name: "refs/heads/main", Old: old, New: next}}, Pack: st.Name, Time: 1700000000000000000})
}

fn indexed(c postgres.Client, repoId i64, commit str) !str {
	let rows = try c.Query("SELECT packages, reindexed, (SELECT count(*) FROM symbols WHERE repo_id = {repoId} AND commit_id = {commit}) FROM indexed_commits WHERE repo_id = {repoId} AND commit_id = {commit}")
	if len(rows.Rows) == 0 {
		return "not indexed"
	}
	return "packages={rows.Rows[0][0].Int()} reindexed={rows.Rows[0][1].Int()} symbols={rows.Rows[0][2].Int()}"
}

// timed indexes commit from hints inside the job's budget and says how long it took.
fn timed(c postgres.Client, repoId i64, commit str, hints []str, what str) ! {
	let started = tide.Now()
	try within index.Within + 0 {
		try limit memory index.Memory + 0 {
			try index.IndexCommit(repoId, commit, hints)
		}
	}
	let ms = (tide.Now() - started) / tide.Millisecond
	let got = try indexed(c, repoId, commit)
	say.Line("{what}: {ms}ms {got}")
}

fn run(list str, root str, dir str) ! {
	let c = pg
	try db.ResetForTests(c)
	_ = try db.Migrate(c)
	let o = try c.Query("INSERT INTO owners (name, kind) VALUES ('tin', 'user') RETURNING id")
	let ownerId = o.Rows[0][0].Int()
	let rr = try c.Query("INSERT INTO repos (owner_id, name, visibility, quota_bytes) VALUES ({ownerId}, 'tin', 'public', 10000000000) RETURNING id")
	let repoId = rr.Rows[0][0].Int()
	let st = try packs.NewDirStore(dir + "/store")
	index.Configure(index.Deps{Db: c, Store: st, Cache: repo.NoCache(), Dir: dir, TinRoot: "", Tinc: "", Sandbox: "auto", Cgroup: "", Auth: nobody})
	mut r = repo.PgRepo{Db: pg, Store: st, Cache: repo.NoCache(), Id: repoId, Dir: dir, Who: 0}
	let names = try quarry.ReadFile(list)
	mut files = map[str]str{}
	mut bytes = 0
	for p in twine.Split(names, "\n") {
		if len(p) == 0 {
			continue
		}
		let body = quarry.ReadFile(root + "/" + p) catch _ {
			continue
		}
		files[p] = body
		bytes += len(body)
	}
	say.Line("files={len(files)} bytes={bytes}")
	mut s = store.NewMem()
	mut ids = []object.Id{}
	let c1 = try commitOf(mut s, files, []object.Id{}, mut ids)
	try push(mut r, mut s, ids, "", c1.Hex())
	try timed(c, repoId, c1.Hex(), []str{}, "full")
	// an edit of one package: a new function at the end of products/tinhub/events/events.tin
	let edited = "products/tinhub/events/events.tin"
	let (body, have) = files[edited]
	if !have {
		fail "{edited} is not in the list"
	}
	files[edited] = body + "\n// Added is the incremental push's edit.\nfn Added() i64 {{\n\treturn 1\n}}\n"
	mut ids2 = []object.Id{}
	let c2 = try commitOf(mut s, files, []object.Id{c1}, mut ids2)
	try push(mut r, mut s, ids2, c1.Hex(), c2.Hex())
	try timed(c, repoId, c2.Hex(), []str{c1.Hex()}, "incremental")
	let added = try c.Query("SELECT count(*) FROM symbols WHERE repo_id = {repoId} AND commit_id = {c2.Hex()} AND name = 'Added'")
	say.Line("incremental found Added: {added.Rows[0][0].Int()}")
	_ = try index.Prune(c, repoId)
	let held = try c.Query("SELECT count(DISTINCT commit_id) FROM symbols WHERE repo_id = {repoId}")
	say.Line("commits held after prune: {held.Rows[0][0].Int()}")
}
