package notify

import "../accounts"
import "../events"
import "anvil"
import "argo"
import "postgres"
import "tide"

// Notifications, webhooks and live updates (design/tinhub.md §6, §10, #1023). An event that people follow (a push,
// and later a review's) is fanned out by its kind's handler with EnqueueFor, in that handler's transaction: one
// webhook job per active webhook of the repository that wants the kind, and one notify job when someone follows the
// repository or a change the event names. The webhook job POSTs the event, signed with HMAC-SHA256, and the queue
// retries a failed delivery with its backoff until Attempts; every attempt is a row of deliveries. The notify job
// mails each follower once (std smtp, smtp.addr; none sends no mail). Live updates are a websocket at /api/v1/live:
// each core of a node polls the events table (the postgres package has no LISTEN/NOTIFY and the redis package no
// SUBSCRIBE, design/tinhub.md §10), so an event committed through any node reaches a subscriber on every node.

// KindNotify is the job that mails a repository's followers about an event.
const KindNotify = "notify"

// KindWebhook is the job that delivers an event to one webhook.
const KindWebhook = "webhook"

// jobWithin and jobMemory are the notify and webhook jobs' budget (design/tinhub.md §6).
const jobWithin = 30 * tide.Second

const jobMemory = 16 * 1024 * 1024

// Deps is what notifications need, set on every core (Configure, or Handlers on a worker) before the first use.
type Deps struct {
	Db postgres.Client
	// Auth is the signed-in user of a request (a session or a signature), 0 for nobody
	Auth fn(anvil.Req) !i64
	// Role is a user's role on a repository: accounts.RoleOf
	Role fn(postgres.Client, i64, accounts.Repo) !i64
	// SmtpAddr and SmtpFrom are smtp.addr and smtp.from; an empty SmtpAddr sends no mail
	SmtpAddr str
	SmtpFrom str
	// PublicURL is public_url, for the links in mail
	PublicURL str
	// Attempts is how many times a webhook delivery is tried before it is given up (0: 8)
	Attempts i64
	// Timeout is one delivery's limit in nanoseconds (0: 10s)
	Timeout i64
	// AllowPrivate lets webhooks reach loopback and private addresses: tests only (TINHUB_TEST_ROUTES=1)
	AllowPrivate bool
	// Poll is how often each core reads new events for its websockets, in nanoseconds (0: 500ms)
	Poll i64
}

mut deps ?Deps = nil

// Configure sets this core's dependencies.
fn Configure(d Deps) {
	deps = keep(d)
}

// got is this core's dependencies; a core that was not configured panics, as the API's does.
fn got() Deps {
	let d = deps
	if d == nil {
		panic("notify: no dependencies on this core")
	}
	return d
}

// attempts is how many times a webhook delivery is tried.
fn attempts(d Deps) i64 {
	if d.Attempts > 0 {
		return d.Attempts
	}
	return 8
}

// Handlers is the worker's notify and webhook handlers; it configures this core with d as Configure does.
fn Handlers(d Deps) []events.Handler {
	Configure(d)
	return []events.Handler{
		events.Handler{Kind: KindWebhook, Within: jobWithin, Memory: jobMemory, Tasks: 0, MaxAttempts: attempts(d), Run: runWebhook},
		events.Handler{Kind: KindNotify, Within: jobWithin, Memory: jobMemory, Tasks: 0, MaxAttempts: 10, Run: runNotify},
	}
}

// hookJob is a webhook job's payload: the webhook, the event's kind and its payload (JSON text).
type hookJob struct {
	webhook i64
	kind    str
	event   str
}

// notifyJob is a notify job's payload: the event's kind and its payload.
type notifyJob struct {
	kind  str
	event str
}

// EnqueueFor fans an event of the repository out in tx: a webhook job for each active webhook that wants kind (a
// webhook with no kinds wants every kind) and a notify job when someone follows the repository or a change the
// payload names (and mail is configured on this core). It returns how many jobs it queued. A webhook job's id is the
// delivery's id (X-Tinhub-Delivery), the same on every attempt.
//
// The push handler calls it in the transaction that records its fan-out, so the jobs exist exactly when it is done:
//
//	mut tx = try pg.Begin()
//	_ = try notify.EnqueueFor(mut tx, job.RepoId, job.Kind, job.Payload)
//	try tx.Commit()
fn EnqueueFor(tx mut postgres.Tx, repoId i64, kind str, payload str) !i64 {
	mut n = 0
	let hooks = try tx.Query("SELECT id FROM webhooks WHERE repo_id = {repoId} AND active AND (cardinality(kinds) = 0 OR {kind} = ANY(kinds)) ORDER BY id")
	for row in hooks.Rows {
		mut body = []u8{}
		argo.Put(mut body, hookJob{webhook: row[0].Int(), kind: kind, event: payload})
		_ = try events.Enqueue(mut tx, KindWebhook, repoId, str(body))
		n += 1
	}
	let d = deps
	if d != nil && len(d.SmtpAddr) == 0 {
		return n
	}
	let changes = changesOf(payload)
	let csv = joinComma(changes)
	let subs = try tx.Query("SELECT 1 FROM subscriptions WHERE repo_id = {repoId} AND (change_id = '' OR change_id = ANY(string_to_array({csv}, ','))) LIMIT 1")
	if len(subs.Rows) > 0 {
		mut body = []u8{}
		argo.Put(mut body, notifyJob{kind: kind, event: payload})
		_ = try events.Enqueue(mut tx, KindNotify, repoId, str(body))
		n += 1
	}
	return n
}

// changeRef and eventBody are the parts of an event's payload notifications read: the changes it names.
type changeRef struct {
	change str
}

type refMove struct {
	name str
	old  str
	new  str
}

type eventBody struct {
	who     str
	refs    []refMove
	changes []changeRef
}

// parseEvent reads the parts of a payload notifications use; a payload of another shape has none of them.
fn parseEvent(payload str) eventBody {
	mut e = eventBody{who: "", refs: []refMove{}, changes: []changeRef{}}
	argo.Get(payload, mut e) catch _ {
		return eventBody{who: "", refs: []refMove{}, changes: []changeRef{}}
	}
	return e
}

// changesOf is the change ids a payload names.
fn changesOf(payload str) []str {
	let e = parseEvent(payload)
	mut out = []str{}
	for c in e.changes {
		if len(c.change) > 0 {
			out = append(out, c.change)
		}
	}
	return out
}

fn joinComma(xs []str) str {
	mut s = ""
	for i, x in xs {
		if i > 0 {
			s = s + ","
		}
		s = s + x
	}
	return s
}

// repoName is a repository's owner/name, "" when it is gone.
fn repoName(c postgres.Client, repoId i64) !str {
	let rows = try c.Query("SELECT o.name || '/' || r.name FROM repos r JOIN owners o ON o.id = r.owner_id WHERE r.id = {repoId} AND r.deleted_at IS NULL")
	if len(rows.Rows) == 0 {
		return ""
	}
	return rows.Rows[0][0].Text()
}
