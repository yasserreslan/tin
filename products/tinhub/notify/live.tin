package notify

import "../accounts"
import "anvil"
import "argo"
import "fault"
import "hearth"
import "herald"
import "tide"
import "twine"
import "websocket"

// Live updates: GET /api/v1/live is a websocket. A client follows topics, "repo:<owner>/<name>" (every live event of
// the repository) and "change:<owner>/<name>/<change>" (the events that name the change), given at connect time as
// ?topics=a,b and changed later with {"op":"subscribe","topic":...} and {"op":"unsubscribe","topic":...}; it is
// answered {"op":"subscribed"|"unsubscribed"|"error","topic":...,"message":...} and sent
// {"op":"event","topic":...,"id":<event id>,"kind":...,"payload":{...}} for each event of a topic it follows (the
// payload is null and "truncated" true when it is over 64 KiB: read it from the API).
//
// Fan-out across nodes: the events table is the bus. Each core of a node that has websockets reads the events newer
// than the last it saw every Deps.Poll into a ring of the newest ringSize live events, and each websocket on the core
// sends what its topics match from the ring. Event ids are given out when a transaction inserts its event, not when it
// commits, so an id below the newest one seen can still appear: the ids skipped are remembered for gapLife and read
// again until they appear. LISTEN/NOTIFY (when the postgres package has it, design/tinhub.md §10) would only replace
// the poll's timer.

// LiveKinds is the comma list of the event kinds a websocket sees: pushes, and the review events (#1025; the review
// package writes them done, in the transaction that made them).
const LiveKinds = "push,review.opened,review.voted,review.comment,review.check,review.landed,review.state"

// ringSize is how many live events each core keeps for its websockets; a websocket further behind skips the rest.
const ringSize = 256

// maxGaps and gapLife bound the ids remembered as skipped, and for how long.
const maxGaps = 1000

const gapLife = 30 * tide.Second

// maxPayload is the largest payload a live event carries.
const maxPayload = 64 * 1024

// maxTopics and maxCommands bound what one websocket follows and how many commands it may send.
const maxTopics = 100

const maxCommands = 1000

// writeTimeout is how long a write to a websocket may wait for a slow client; pingEvery keeps idle ones open.
const writeTimeout = 10 * tide.Second

const pingEvery = 30 * tide.Second

// liveEvent is one live event in a core's ring: seq numbers the ring's entries on this core.
type liveEvent struct {
	seq       i64
	id        i64
	kind      str
	repoId    i64
	changes   []str
	payload   str
	truncated bool
}

// gap is an event id skipped by a poll, and when.
type gap value struct {
	id i64
	at i64
}

fn emptyRing() []liveEvent {
	mut r = []liveEvent{}
	for i in 0..ringSize {
		r = append(r, liveEvent{seq: 0, id: 0, kind: "", repoId: 0, changes: []str{}, payload: "", truncated: false})
	}
	return r
}

// This core's feed: the ring, the newest seq in it, the newest event id read (-1 before the first read), the ids
// skipped, the websockets open and whether the poller runs.
mut ring = emptyRing()

mut feedSeq = 0

mut feedLast = -1

mut gaps = []gap{}

mut watchers = 0

mut polling = false

// pollEvery is Deps.Poll, or 500ms.
fn pollEvery(d Deps) i64 {
	if d.Poll > 0 {
		return d.Poll
	}
	return 500 * tide.Millisecond
}

// pollOnce reads the events newer than the last seen, and those skipped earlier that have appeared since, into the
// ring. The first poll only finds where the events table ends: a websocket sees the events after it connected.
fn pollOnce(d Deps) ! {
	if feedLast < 0 {
		let rows = try d.Db.Query("SELECT coalesce(max(id), 0) FROM events")
		feedLast = rows.Rows[0][0].Int()
		gaps = keep([]gap{})
		return
	}
	let last = feedLast
	let kinds = LiveKinds
	let now = tide.Now()
	mut open = []gap{}
	mut ids = []str{}
	for g in gaps {
		if now - g.at < gapLife {
			open = append(open, g)
			ids = append(ids, "{g.id}")
		}
	}
	let csv = joinComma(ids)
	let late = try d.Db.Query("SELECT id, kind, coalesce(repo_id, 0), CASE WHEN kind = ANY(string_to_array({kinds}, ',')) THEN payload::text ELSE '' END FROM events WHERE id = ANY(string_to_array({csv}, ',')::bigint[]) ORDER BY id")
	let fresh = try d.Db.Query("SELECT id, kind, coalesce(repo_id, 0), CASE WHEN kind = ANY(string_to_array({kinds}, ',')) THEN payload::text ELSE '' END FROM events WHERE id > {last} ORDER BY id LIMIT 1000")
	for row in late.Rows {
		let id = row[0].Int()
		mut still = []gap{}
		for g in open {
			if g.id != id {
				still = append(still, g)
			}
		}
		open = still
		add(row[1].Text(), id, row[2].Int(), row[3].Text())
	}
	mut newest = last
	for row in fresh.Rows {
		let id = row[0].Int()
		if id - newest - 1 <= maxGaps - len(open) {
			for x in newest + 1..id {
				open = append(open, gap{id: x, at: now})
			}
		}
		newest = id
		add(row[1].Text(), id, row[2].Int(), row[3].Text())
	}
	gaps = keep(open)
	feedLast = newest
}

// add puts an event in the ring when its kind is a live one.
fn add(kind str, id i64, repoId i64, payload str) {
	if !twine.Contains("," + LiveKinds + ",", "," + kind + ",") {
		return
	}
	let seq = feedSeq + 1
	mut body = payload
	mut cut = false
	if len(body) > maxPayload {
		body = ""
		cut = true
	}
	let e = liveEvent{seq: seq, id: id, kind: kind, repoId: repoId, changes: changesOf(payload), payload: body, truncated: cut}
	ring[(seq - 1) % ringSize] = keep(e)
	feedSeq = seq
}

// feedLoop is a core's poller: while the core has websockets it polls every Deps.Poll; with none it forgets where it
// was, so the next websocket starts from the end of the events table, not from a backlog.
fn feedLoop() {
	for {
		mut every = 500 * tide.Millisecond
		let d = deps
		if d != nil {
			every = pollEvery(d)
			if watchers > 0 {
				arena {
					pollOnce(d) catch err {
						herald.Log(herald.LWarn, "live poll", []str{"error", fault.Message(err)})
					}
				}
			} else {
				feedLast = -1
			}
		}
		mut stop = false
		hearth.Quiet(fn() {
			tide.Wait(every) catch _ {
				stop = true
			}
		})
		if stop {
			polling = false
			return
		}
	}
}

// liveSub is a topic a websocket follows: the repository and, for a change topic, the change.
type liveSub struct {
	topic  str
	repoId i64
	change str
}

// liveRead is one read of a websocket: 1 a text message, 0 nothing (the wait ran out, or a binary message), -1 the
// connection ended.
type liveRead value struct {
	state i64
	text  str
}

type liveCmd struct {
	op    str
	topic str
}

type liveReply struct {
	op      str
	topic   str
	message str
}

// live is GET /api/v1/live.
fn live(q anvil.Req, w mut anvil.Out) {
	let have = deps
	if have == nil {
		fail_(mut w, 503, "unavailable", "notifications are not configured on this core")
		return
	}
	let d = have
	let auth = d.Auth
	let user = auth(q) catch err {
		fail_(mut w, 401, "unauthorized", fault.Message(err))
		return
	}
	watchers += 1
	if feedLast < 0 {
		pollOnce(d) catch err {
			watchers -= 1
			fail_(mut w, 503, "unavailable", fault.Message(err))
			return
		}
	}
	if !polling {
		polling = true
		detach {
			feedLoop()
		}
	}
	let ws = websocket.Accept(q, mut w) catch _ {
		watchers -= 1
		return
	}
	ws.SetMaxMessage(4096)
	serveLive(d, ws, user, q.Param("topics"))
	watchers -= 1
	ws.Close()
}

// serveLive runs one websocket until it closes: it waits for a command at most half a poll, then sends what the ring
// has for its topics.
fn serveLive(d Deps, ws websocket.Conn, user i64, initial str) {
	mut subs = []liveSub{}
	mut cursor = feedSeq
	mut commands = 0
	mut pinged = tide.Now()
	let wake = pollEvery(d) / 2 + tide.Millisecond
	ws.SetTimeout(writeTimeout)
	if len(initial) > 0 {
		for t in twine.Split(initial, ",") {
			subs = subscribe(d, ws, user, subs, t)
		}
	}
	for {
		ws.SetTimeout(wake)
		let r = arena {
			readStep(ws)
		}
		if r.state < 0 {
			return
		}
		ws.SetTimeout(writeTimeout)
		if r.state == 1 {
			commands += 1
			if commands > maxCommands {
				ws.CloseWith(1008, "too many commands") catch _ {
				}
				return
			}
			subs = command(d, ws, user, subs, r.text)
		}
		let next = arena {
			flush(ws, subs, cursor)
		}
		if next < 0 {
			return
		}
		cursor = next
		if tide.Since(pinged) > pingEvery {
			ws.Ping() catch _ {
				return
			}
			pinged = tide.Now()
		}
	}
}

// readStep reads the next message, waiting at most the connection's timeout.
fn readStep(ws websocket.Conn) liveRead {
	let (m, err) = ws.Read()
	if err != nil {
		if fault.Message(err) == "websocket: timed out" {
			return liveRead{state: 0, text: ""}
		}
		return liveRead{state: -1, text: ""}
	}
	if !m.Text {
		return liveRead{state: 0, text: ""}
	}
	return liveRead{state: 1, text: m.Data}
}

// reply sends a command's answer; a failed write is seen by the next read.
fn reply(ws websocket.Conn, op str, topic str, message str) {
	mut b = []u8{}
	argo.Put(mut b, liveReply{op: op, topic: topic, message: message})
	ws.WriteText(str(b)) catch _ {
	}
}

// command applies one client message to the topics.
fn command(d Deps, ws websocket.Conn, user i64, subs []liveSub, text str) []liveSub {
	mut c = liveCmd{op: "", topic: ""}
	argo.Get(text, mut c) catch err {
		reply(ws, "error", "", "not a command: {fault.Message(err)}")
		return subs
	}
	if c.op == "subscribe" {
		return subscribe(d, ws, user, subs, c.topic)
	}
	if c.op == "unsubscribe" {
		mut out = []liveSub{}
		for s in subs {
			if s.topic != c.topic {
				out = append(out, s)
			}
		}
		reply(ws, "unsubscribed", c.topic, "")
		return out
	}
	reply(ws, "error", c.topic, "unknown op {c.op}: subscribe or unsubscribe")
	return subs
}

// subscribe adds a topic the user may read.
fn subscribe(d Deps, ws websocket.Conn, user i64, subs []liveSub, topic0 str) []liveSub {
	let topic = twine.TrimSpace(topic0)
	for s in subs {
		if s.topic == topic {
			reply(ws, "subscribed", topic, "")
			return subs
		}
	}
	if len(subs) >= maxTopics {
		reply(ws, "error", topic, "at most {maxTopics} topics")
		return subs
	}
	let (sub, err) = resolveTopic(d, user, topic)
	if err != nil {
		reply(ws, "error", topic, fault.Message(err))
		return subs
	}
	mut out = []liveSub{}
	for s in subs {
		out = append(out, s)
	}
	out = append(out, sub)
	reply(ws, "subscribed", topic, "")
	return out
}

// ErrTopic is the fault of a topic that is malformed or names a repository the user cannot read.
let ErrTopic = fault("topic")

// resolveTopic finds a topic's repository and checks the user can read it (a repository the user cannot read is not
// found, as on every route).
fn resolveTopic(d Deps, user i64, topic str) !liveSub {
	let (kind, rest, ok) = twine.Cut(topic, ":")
	if !ok || (kind != "repo" && kind != "change") {
		fail fault.Wrap(ErrTopic, "{topic}: want repo:<owner>/<name> or change:<owner>/<name>/<change>")
	}
	let parts = twine.Split(rest, "/")
	if (kind == "repo" && len(parts) != 2) || (kind == "change" && len(parts) != 3) {
		fail fault.Wrap(ErrTopic, "{topic}: want repo:<owner>/<name> or change:<owner>/<name>/<change>")
	}
	let found = try accounts.FindRepo(d.Db, parts[0], parts[1])
	if found == nil {
		fail fault.Wrap(ErrTopic, "no repository {parts[0]}/{parts[1]}")
	}
	let role = d.Role
	let can = try role(d.Db, user, found)
	if can < accounts.RoleRead {
		fail fault.Wrap(ErrTopic, "no repository {parts[0]}/{parts[1]}")
	}
	mut change = ""
	if kind == "change" {
		change = parts[2]
		if len(change) == 0 || len(change) > 64 {
			fail fault.Wrap(ErrTopic, "{topic}: a bad change id")
		}
	}
	return liveSub{topic: topic, repoId: found.Id, change: change}
}

// flush sends the ring's entries after cursor that the topics match, and returns the new cursor (-1 when the
// connection failed). The messages are made before the first write, so nothing borrowed from the ring is used after a
// wait.
fn flush(ws websocket.Conn, subs []liveSub, cursor i64) i64 {
	let top = feedSeq
	if top <= cursor || len(subs) == 0 {
		return top
	}
	mut start = cursor + 1
	if top - cursor > ringSize {
		start = top - ringSize + 1
	}
	mut out = []str{}
	for s in start..top + 1 {
		let e = ring[(s - 1) % ringSize]
		if e.seq != s {
			continue
		}
		for sub in subs {
			if sub.repoId != e.repoId {
				continue
			}
			if len(sub.change) > 0 && !has(e.changes, sub.change) {
				continue
			}
			out = append(out, eventMessage(sub.topic, e))
		}
	}
	for m in out {
		ws.WriteText(m) catch _ {
			return -1
		}
	}
	return top
}

fn has(xs []str, x str) bool {
	for y in xs {
		if y == x {
			return true
		}
	}
	return false
}

// eventMessage is the message an event is sent as.
fn eventMessage(topic str, e liveEvent) str {
	mut b = []u8{}
	argo.Raw(mut b, "{{\"op\":\"event\",\"topic\":")
	argo.Str(mut b, topic)
	argo.Raw(mut b, ",\"id\":{e.id},\"kind\":")
	argo.Str(mut b, e.kind)
	argo.Raw(mut b, ",\"payload\":")
	if len(e.payload) == 0 {
		argo.Raw(mut b, "null")
	} else {
		argo.Raw(mut b, e.payload)
	}
	if e.truncated {
		argo.Raw(mut b, ",\"truncated\":true")
	}
	argo.Raw(mut b, "}}")
	return str(b)
}
