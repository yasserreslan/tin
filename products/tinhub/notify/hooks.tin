package notify

import "../events"
import "argo"
import "fault"
import "herald"
import "mint"
import "netip"
import "seal"
import "tide"
import "twine"
import "wire"

// Webhooks: an event POSTed as JSON to the webhook's URL, its body signed with HMAC-SHA256 under the webhook's secret
// (X-Tinhub-Signature-256: sha256=<hex>, as GitHub's X-Hub-Signature-256). A delivery that fails (no answer, or a
// status outside 2xx) fails its job, and the queue tries it again after its backoff until Attempts; each attempt is a
// row of deliveries. A URL is never sent to loopback, private, link-local or other non-public addresses (a webhook
// must not reach the node's own network) unless Deps.AllowPrivate, which only tests set.

// ErrURL is the fault of a webhook URL that is malformed or names an address a webhook may not reach.
let ErrURL = fault("webhook URL")

// defaultTimeout is one delivery's limit when Deps.Timeout is 0.
const defaultTimeout = 10 * tide.Second

// maxAnswer is the largest answer a receiver may send; a bigger one fails the delivery.
const maxAnswer = 1024 * 1024

// splitURL is the host and port of an http:// or https:// URL, split as wire splits it (the host ends at the first
// "/" or "?"), so the address checked is the address dialed.
fn splitURL(url str) !(str, str) {
	mut rest = ""
	mut port = "80"
	if twine.HasPrefix(url, "https://") {
		rest = url[8:]
		port = "443"
	} else if twine.HasPrefix(url, "http://") {
		rest = url[7:]
	} else {
		fail fault.Wrap(ErrURL, "{url}: not an http:// or https:// URL")
	}
	if len(url) > 2000 {
		fail fault.Wrap(ErrURL, "longer than 2000 bytes")
	}
	for i in 0..len(url) {
		let c = url[i]
		if c <= ' ' || c >= 127 || c == '#' || c == '\\' {
			fail fault.Wrap(ErrURL, "{url}: a space, control byte, # or \\ in the URL")
		}
	}
	mut end = len(rest)
	for i in 0..len(rest) {
		if rest[i] == '/' || rest[i] == '?' {
			end = i
			break
		}
	}
	let hostport = rest[0:end]
	for i in 0..len(hostport) {
		let c = hostport[i]
		let ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '.' || c == '-' || c == ':' || c == '[' || c == ']'
		if !ok {
			fail fault.Wrap(ErrURL, "{url}: the host may hold letters, digits, '.', '-', ':' and IPv6 brackets only")
		}
	}
	mut host = hostport
	if twine.HasPrefix(hostport, "[") {
		let close = twine.IndexByte(hostport, ']')
		if close < 0 {
			fail fault.Wrap(ErrURL, "{url}: an IPv6 host without its ]")
		}
		host = hostport[1:close]
		let after = hostport[close + 1:]
		if len(after) > 0 {
			if after[0] != ':' {
				fail fault.Wrap(ErrURL, "{url}: a bad port")
			}
			port = after[1:]
		}
	} else {
		let colon = twine.LastIndexByte(hostport, ':')
		if colon >= 0 {
			host = hostport[0:colon]
			port = hostport[colon + 1:]
			if twine.ContainsByte(host, ':') {
				fail fault.Wrap(ErrURL, "{url}: an IPv6 host must be in brackets")
			}
		}
	}
	if len(host) == 0 {
		fail fault.Wrap(ErrURL, "{url}: no host")
	}
	let p = mint.Atoi(port) catch _ {
		fail fault.Wrap(ErrURL, "{url}: a bad port")
		0
	}
	if p < 1 || p > 65535 {
		fail fault.Wrap(ErrURL, "{url}: a bad port")
	}
	return twine.ToLower(host), port
}

// CheckURL fails when url is not a webhook URL: http:// or https://, a plain host (a name or an IP literal) and, unless
// allowPrivate, a host that is a public address or a name that is not a local one. A name's addresses are not looked
// up (the wire package resolves names inside its dial and does not say where it connected): a public name that
// resolves to a private address is not caught here.
fn CheckURL(url str, allowPrivate bool) ! {
	let (host, _) = try splitURL(url)
	if allowPrivate {
		return
	}
	let (a, err) = netip.ParseAddr(host)
	if err == nil {
		if !publicAddr(a) {
			fail fault.Wrap(ErrURL, "{host} is not a public address")
		}
		return
	}
	let name = twine.TrimSuffix(host, ".")
	if !twine.ContainsByte(name, '.') {
		fail fault.Wrap(ErrURL, "{host} is not a fully qualified name")
	}
	let local = []str{".localhost", ".local", ".localdomain", ".internal", ".intranet", ".lan", ".home.arpa", ".corp"}
	for s in local {
		if twine.HasSuffix(name, s) {
			fail fault.Wrap(ErrURL, "{host} is a local name")
		}
	}
	// a last label of digits (or 0x...) is an IPv4 address in another spelling ("127.1", "0x7f.1"), which the
	// resolver would take as one
	let dot = twine.LastIndexByte(name, '.')
	let last = name[dot + 1:]
	mut digits = true
	for i in 0..len(last) {
		let c = last[i]
		if !((c >= '0' && c <= '9') || c == 'x' || (c >= 'a' && c <= 'f')) {
			digits = false
		}
	}
	if digits && (twine.HasPrefix(last, "0x") || (len(last) > 0 && last[0] >= '0' && last[0] <= '9')) {
		fail fault.Wrap(ErrURL, "{host} is an address in another spelling")
	}
}

// publicAddr reports whether a webhook may reach a: a global unicast address outside the private, shared (CGNAT),
// benchmarking, documentation and IPv4-translation ranges.
fn publicAddr(a0 netip.Addr) bool {
	let a = a0.Unmap()
	if !a.IsGlobalUnicast() || a.IsPrivate() || a.IsLoopback() || a.IsLinkLocalUnicast() || a.IsMulticast() || a.IsUnspecified() {
		return false
	}
	let blocked = []str{"0.0.0.0/8", "100.64.0.0/10", "192.0.0.0/24", "192.0.2.0/24", "198.18.0.0/15", "198.51.100.0/24", "203.0.113.0/24", "240.0.0.0/4", "64:ff9b::/96", "64:ff9b:1::/48", "2001:db8::/32", "2002::/16", "100::/64"}
	for b in blocked {
		let p = netip.ParsePrefix(b) catch _ {
			return false
		}
		if p.Contains(a) {
			return false
		}
	}
	return true
}

// Sign is the X-Tinhub-Signature-256 value of body under key: "sha256=" and the HMAC-SHA256 in hex.
fn Sign(key str, body str) str {
	return "sha256=" + seal.Hex(seal.HmacSha256(key, body))
}

// hookBody is the JSON a webhook receives: the event's kind, the repository, the delivery's id and the event's payload.
fn hookBody(kind str, repo str, delivery i64, event str) str {
	mut b = []u8{}
	argo.Raw(mut b, "{{\"kind\":")
	argo.Str(mut b, kind)
	argo.Raw(mut b, ",\"repo\":")
	argo.Str(mut b, repo)
	argo.Raw(mut b, ",\"delivery\":{delivery},\"event\":")
	if len(event) == 0 {
		argo.Raw(mut b, "null")
	} else {
		argo.Raw(mut b, event)
	}
	argo.Raw(mut b, "}}")
	return str(b)
}

// runWebhook is the webhook job: one attempt at delivering the event to the webhook, logged in deliveries.
fn runWebhook(j events.Job) ! {
	let d = got()
	mut p = hookJob{webhook: 0, kind: "", event: ""}
	argo.Get(j.Payload, mut p) catch err {
		// a payload this code did not write: trying again cannot help
		herald.Log(herald.LError, "webhook job", []str{"id", mint.Itoa(j.Id), "error", fault.Message(err)})
		return
	}
	let hook = p.webhook
	let rows = try d.Db.Query("SELECT w.url, w.secret, w.active, o.name || '/' || r.name FROM webhooks w JOIN repos r ON r.id = w.repo_id JOIN owners o ON o.id = r.owner_id WHERE w.id = {hook} AND r.deleted_at IS NULL")
	if len(rows.Rows) == 0 {
		// the webhook or its repository was deleted since the event
		return
	}
	let row = rows.Rows[0]
	if row[2].Int() != 1 {
		return
	}
	let url = row[0].Text()
	let key = row[1].Text()
	let body = hookBody(p.kind, row[3].Text(), j.Id, p.event)
	let refused = CheckURL(url, d.AllowPrivate)
	if refused != nil {
		// a URL that may not be reached is not tried again
		try logDelivery(hook, j, 0, fault.Message(refused), 0)
		return
	}
	mut timeout = d.Timeout
	if timeout <= 0 {
		timeout = defaultTimeout
	}
	let headers = []str{"Content-Type", "application/json", "User-Agent", "tinhub-webhook", "X-Tinhub-Event", p.kind, "X-Tinhub-Delivery", mint.Itoa(j.Id), "X-Tinhub-Attempt", mint.Itoa(j.Attempts), "X-Tinhub-Signature-256", Sign(key, body)}
	let start = tide.Now()
	let (resp, err) = wire.DoWith("POST", url, headers, body, wire.Options{Timeout: timeout, MaxBody: maxAnswer, TLS: nil, MaxIdle: -1, NoH2: true, H2C: false, Trace: nil})
	let ms = tide.Since(start) / tide.Millisecond
	if err != nil {
		try logDelivery(hook, j, 0, fault.Message(err), ms)
		fail fault.Wrap(err, "webhook {hook}")
	}
	if resp.Status < 200 || resp.Status > 299 {
		try logDelivery(hook, j, resp.Status, "", ms)
		fail "webhook {hook}: the receiver answered {resp.Status}"
	}
	try logDelivery(hook, j, resp.Status, "", ms)
}

// clip is s cut to at most n bytes, at the start of a UTF-8 sequence.
fn clip(s str, n i64) str {
	if len(s) <= n {
		return s
	}
	mut end = n
	for end > 0 && s[end] >= 0x80 && s[end] < 0xc0 {
		end -= 1
	}
	return s[0:end]
}

// logDelivery records one attempt at a delivery.
fn logDelivery(hook i64, j events.Job, status i64, why str, ms i64) ! {
	let d = got()
	let e = clip(why, 500)
	let id = j.Id
	let attempt = j.Attempts
	_ = try d.Db.Exec("INSERT INTO deliveries (webhook_id, event_id, attempt, status, error, duration_ms) VALUES ({hook}, {id}, {attempt}, {status}, {e}, {ms})")
}
