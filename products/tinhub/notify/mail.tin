package notify

import "../accounts"
import "../events"
import "argo"
import "fault"
import "herald"
import "mint"
import "smtp"
import "tide"

// Mail: the notify job mails each follower of the repository (a subscription with no change) and of a change the
// event names, once: a follower already mailed about this job (a row of notifications) is skipped when the job runs
// again, and a follower who can no longer read the repository is not mailed.

// follower is a user to mail.
type follower struct {
	id    i64
	email str
}

// runNotify is the notify job.
fn runNotify(j events.Job) ! {
	let d = got()
	if len(d.SmtpAddr) == 0 {
		return
	}
	mut p = notifyJob{kind: "", event: ""}
	argo.Get(j.Payload, mut p) catch err {
		herald.Log(herald.LError, "notify job", []str{"id", mint.Itoa(j.Id), "error", fault.Message(err)})
		return
	}
	let repoId = j.RepoId
	let rows = try d.Db.Query("SELECT o.name, r.name FROM repos r JOIN owners o ON o.id = r.owner_id WHERE r.id = {repoId} AND r.deleted_at IS NULL")
	if len(rows.Rows) == 0 {
		return
	}
	let owner = rows.Rows[0][0].Text()
	let name = rows.Rows[0][1].Text()
	let found = try accounts.FindRepo(d.Db, owner, name)
	if found == nil {
		return
	}
	let r = found
	let csv = joinComma(changesOf(p.event))
	let id = j.Id
	let subs = try d.Db.Query("SELECT DISTINCT u.id, u.email FROM subscriptions s JOIN users u ON u.id = s.user_id WHERE s.repo_id = {repoId} AND (s.change_id = '' OR s.change_id = ANY(string_to_array({csv}, ','))) AND u.deleted_at IS NULL AND u.email <> '' AND NOT EXISTS (SELECT 1 FROM notifications n WHERE n.event_id = {id} AND n.user_id = u.id) ORDER BY u.id")
	mut first fault = nil
	let role = d.Role
	for row in subs.Rows {
		let f = follower{id: row[0].Int(), email: row[1].Text()}
		let can = try role(d.Db, f.id, r)
		if can < accounts.RoleRead {
			continue
		}
		let msg = message(d, j.Id, f, owner + "/" + name, p.kind, p.event)
		let err = smtp.SendMail(d.SmtpAddr, d.SmtpFrom, []str{f.email}, msg)
		if err != nil {
			herald.Log(herald.LWarn, "notify mail", []str{"user", mint.Itoa(f.id), "error", fault.Message(err)})
			if first == nil {
				first = err
			}
			continue
		}
		let uid = f.id
		_ = try d.Db.Exec("INSERT INTO notifications (event_id, user_id) VALUES ({id}, {uid}) ON CONFLICT DO NOTHING")
	}
	if first != nil {
		fail fault.Wrap(first, "mailing followers of {owner}/{name}")
	}
}

// oneLine is s with no line breaks or other control bytes, for a header field.
fn oneLine(s str) str {
	mut b = []u8{}
	for i in 0..len(s) {
		let c = s[i]
		if c < ' ' || c == 127 {
			b = append(b, ' ')
		} else {
			b = append(b, c)
		}
	}
	return str(b)
}

// short is the first 12 digits of an object id, "nothing" for none.
fn short(id str) str {
	if len(id) == 0 {
		return "nothing"
	}
	if len(id) > 12 {
		return id[0:12]
	}
	return id
}

// summary is the subject's text for an event, and its body's lines.
fn summary(repo str, kind str, event str) (str, []str) {
	if kind != "push" {
		return "{kind} in {repo}", []str{"{kind} in {repo}."}
	}
	let e = parseEvent(event)
	mut who = e.who
	if len(who) == 0 {
		who = "someone"
	}
	mut lines = []str{"{who} pushed to {repo}."}
	if len(e.refs) > 0 {
		lines = append(lines, "")
		lines = append(lines, "Refs:")
		for r in e.refs {
			lines = append(lines, "  {r.name}: {short(r.old)} -> {short(r.new)}")
		}
	}
	if len(e.changes) > 0 {
		lines = append(lines, "")
		lines = append(lines, "Changes:")
		for c in e.changes {
			lines = append(lines, "  {c.change}")
		}
	}
	return "{who} pushed to {repo}", lines
}

// message is the mail to one follower about one event.
fn message(d Deps, jobId i64, f follower, repo str, kind str, event str) str {
	let (subject, lines) = summary(repo, kind, event)
	let date = tide.FormatHTTP(tide.Wall() / tide.Second)
	mut out = "From: " + oneLine(d.SmtpFrom) + "\r\n"
	out = out + "To: " + oneLine(f.email) + "\r\n"
	out = out + "Subject: [" + oneLine(repo) + "] " + oneLine(subject) + "\r\n"
	out = out + "Date: " + date + "\r\n"
	out = out + "Message-Id: <tinhub.{jobId}.{f.id}@tinhub>\r\n"
	out = out + "MIME-Version: 1.0\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n"
	for l in lines {
		out = out + oneLine(l) + "\r\n"
	}
	out = out + "\r\n" + oneLine(d.PublicURL) + "/" + repo + "\r\n"
	out = out + "You follow " + repo + " or one of its changes on tinhub.\r\n"
	return out
}
