package notify

import "../accounts"
import "../db"
import "../events"
import "anvil"
import "argo"
import "crucible"
import "postgres"
import "tide"
import "twine"

// Tests for notifications (#1023): webhook URLs, signatures and bodies everywhere; against Postgres (TINHUB_TEST_DB),
// the fan-out of an event to webhook and notify jobs, a refused delivery's log, and the live feed's poll.

fn testDb(t mut crucible.T) ?postgres.Client {
	let (o, ok) = db.TestOptions()
	if !ok {
		t.Log("TINHUB_TEST_DB is not set: skipped")
		return nil
	}
	let c = db.Open(o)
	db.ResetForTests(c) catch err {
		t.Error("reset: {err}")
		return nil
	}
	_ = db.Migrate(c) catch err {
		t.Error("migrate: {err}")
		return nil
	}
	return c
}

fn nobody(q anvil.Req) !i64 {
	return 0
}

fn testDeps(c postgres.Client, smtp str) Deps {
	return Deps{Db: c, Auth: nobody, Role: accounts.RoleOf, SmtpAddr: smtp, SmtpFrom: "tinhub@example.com", PublicURL: "http://localhost:8080", Attempts: 3, Timeout: tide.Second, AllowPrivate: false, Poll: 0}
}

fn TestCheckURL(t mut crucible.T) {
	let good = []str{"https://hooks.example.com/tinhub", "http://hooks.example.com:8080/x?y=1", "https://8.8.8.8/hook", "https://[2606:4700::1111]/hook"}
	for u in good {
		t.NoFault(u, CheckURL(u, false))
	}
	let bad = []str{"ftp://example.com/x", "https://", "http://localhost/x", "http://127.0.0.1/x", "http://10.1.2.3/x", "http://192.168.0.1/x", "http://169.254.169.254/latest", "http://[::1]/x", "http://[fe80::1]/x", "http://100.64.0.1/x", "http://0.0.0.0/x", "http://127.1/x", "http://0x7f.1/x", "http://db.internal/x", "http://printer.local/x", "http://intranet/x", "http://example.com:0/x", "http://example.com:99999/x", "http://exa mple.com/x", "http://user@example.com/x", "http://example.com/x#frag", "http://[::ffff:127.0.0.1]/x"}
	for u in bad {
		t.HasFault(u, CheckURL(u, false))
	}
	t.NoFault("loopback when allowed", CheckURL("http://127.0.0.1:9000/hook", true))
	t.HasFault("still not ftp when allowed", CheckURL("ftp://127.0.0.1/x", true))
}

fn TestSign(t mut crucible.T) {
	// RFC 4231's style of vector, as Go's crypto/hmac computes it
	crucible.Equal(mut t, "hmac", Sign("key", "The quick brown fox jumps over the lazy dog"), "sha256=f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8")
}

type bodyIn struct {
	kind     str
	repo     str
	delivery i64
	event    eventBody
}

fn TestHookBody(t mut crucible.T) {
	let event = "{{\"who\":\"ada\",\"refs\":[],\"changes\":[{{\"change\":\"kabc\"}}]}}"
	let text = hookBody("push", "ada/t\"in", 42, event)
	mut b = bodyIn{kind: "", repo: "", delivery: 0, event: eventBody{who: "", refs: []refMove{}, changes: []changeRef{}}}
	argo.Get(text, mut b) catch err {
		t.Error("not JSON: {err}: {text}")
		return
	}
	crucible.Equal(mut t, "kind", b.kind, "push")
	crucible.Equal(mut t, "repo", b.repo, "ada/t\"in")
	crucible.Equal(mut t, "delivery", b.delivery, 42)
	crucible.Equal(mut t, "who", b.event.who, "ada")
	crucible.Equal(mut t, "changes", len(changesOf(event)), 1)
	crucible.Equal(mut t, "a payload of another shape", len(changesOf("[1,2]")), 0)
}

fn TestMessage(t mut crucible.T) {
	let d = Deps{Db: postgres.Open(postgres.Options{Addr: "127.0.0.1:1", User: "", Password: "", Database: "", Pool: 0, MaxTotal: 0, Timeout: 0, SSLMode: "", TLS: nil}), Auth: nobody, Role: accounts.RoleOf, SmtpAddr: "x:25", SmtpFrom: "tinhub@example.com", PublicURL: "https://hub.example.com", Attempts: 0, Timeout: 0, AllowPrivate: false, Poll: 0}
	let event = "{{\"who\":\"ada\\r\\nBcc: eve@example.com\",\"refs\":[{{\"name\":\"refs/heads/main\",\"old\":\"\",\"new\":\"0123456789abcdef\"}}],\"changes\":[]}}"
	let m = message(d, 7, follower{id: 2, email: "bob@example.com"}, "ada/tin", "push", event)
	t.True("subject", twine.Contains(m, "Subject: [ada/tin] ada  Bcc: eve@example.com pushed to ada/tin\r\n"))
	t.True("no header injected", !twine.Contains(m, "\r\nBcc:"))
	t.True("ref", twine.Contains(m, "refs/heads/main: nothing -> 0123456789ab"))
	t.True("link", twine.Contains(m, "https://hub.example.com/ada/tin\r\n"))
}

// world is ada (user 1, owner of the public ada/tin, repository 1) and bob (user 2).
fn world(c postgres.Client) ! {
	_ = try c.Exec("INSERT INTO owners (name, kind) VALUES ('ada', 'user'), ('bob', 'user')")
	_ = try c.Exec("INSERT INTO users (owner_id, email, display) VALUES (1, 'ada@example.com', 'Ada'), (2, 'bob@example.com', 'Bob')")
	_ = try c.Exec("INSERT INTO repos (owner_id, name, visibility, quota_bytes) VALUES (1, 'tin', 'public', 1000000000)")
}

fn fanOut(c postgres.Client, kind str, payload str) !i64 {
	mut tx = try c.Begin()
	let (n, err) = EnqueueFor(mut tx, 1, kind, payload)
	if err != nil {
		tx.Rollback() catch _ {
		}
		fail err
	}
	try tx.Commit()
	return n
}

// jobs is how many jobs of kind there are, -1 when Postgres fails.
fn jobs(c postgres.Client, kind str) i64 {
	let rows = c.Query("SELECT count(*) FROM events WHERE kind = {kind}") catch _ {
		return -1
	}
	return rows.Rows[0][0].Int()
}

// refused is how many deliveries were refused without a request because of the address.
fn refused(c postgres.Client) i64 {
	let rows = c.Query("SELECT count(*) FROM deliveries WHERE status = 0 AND error LIKE '%not a public address%'") catch _ {
		return -1
	}
	return rows.Rows[0][0].Int()
}

fn TestEnqueueFor(t mut crucible.T) {
	let have = testDb(mut t)
	if have == nil {
		return
	}
	let c = have
	world(c) catch err {
		t.Error("world: {err}")
		return
	}
	Configure(testDeps(c, "127.0.0.1:1"))
	_ = c.Exec("INSERT INTO webhooks (repo_id, url, secret, kinds, active) VALUES (1, 'https://a.example.com/', 's', '{{}}', true), (1, 'https://b.example.com/', 's', '{{push}}', true), (1, 'https://c.example.com/', 's', '{{review.landed}}', true), (1, 'https://d.example.com/', 's', '{{push}}', false)") catch err {
		t.Error("webhooks: {err}")
		return
	}
	let payload = "{{\"who\":\"ada\",\"refs\":[],\"changes\":[{{\"change\":\"kone\",\"replaces\":\"\",\"commit\":\"\"}}]}}"
	let n1 = fanOut(c, "push", payload) catch err {
		t.Error("fan out: {err}")
		return
	}
	crucible.Equal(mut t, "two webhooks want push, nobody follows", n1, 2)
	_ = c.Exec("INSERT INTO subscriptions (user_id, repo_id, change_id) VALUES (2, 1, 'kone')") catch err {
		t.Error("subscribe: {err}")
		return
	}
	let n2 = fanOut(c, "push", payload) catch err {
		t.Error("fan out: {err}")
		return
	}
	crucible.Equal(mut t, "and a notify job for bob's change", n2, 3)
	let n3 = fanOut(c, "push", "{{\"changes\":[{{\"change\":\"ktwo\"}}]}}") catch err {
		t.Error("fan out: {err}")
		return
	}
	crucible.Equal(mut t, "not for another change", n3, 2)
	crucible.Equal(mut t, "webhook jobs", jobs(c, KindWebhook), 6)
	crucible.Equal(mut t, "notify jobs", jobs(c, KindNotify), 1)
	Configure(testDeps(c, ""))
	let n4 = fanOut(c, "push", payload) catch err {
		t.Error("fan out: {err}")
		return
	}
	crucible.Equal(mut t, "no mail configured: no notify job", n4, 2)
}

fn TestRefusedDelivery(t mut crucible.T) {
	let have = testDb(mut t)
	if have == nil {
		return
	}
	let c = have
	world(c) catch err {
		t.Error("world: {err}")
		return
	}
	Configure(testDeps(c, ""))
	let rows = c.Query("INSERT INTO webhooks (repo_id, url, secret) VALUES (1, 'http://127.0.0.1:9/x', 'secret') RETURNING id") catch err {
		t.Error("webhook: {err}")
		return
	}
	let hook = rows.Rows[0][0].Int()
	mut body = []u8{}
	argo.Put(mut body, hookJob{webhook: hook, kind: "push", event: "{{}}"})
	let id = events.EnqueueNow(c, KindWebhook, 1, str(body)) catch err {
		t.Error("enqueue: {err}")
		return
	}
	t.NoFault("a refused URL is not tried again", runWebhook(events.Job{Id: id, Kind: KindWebhook, RepoId: 1, Payload: str(body), Attempts: 1}))
	crucible.Equal(mut t, "one delivery, status 0", refused(c), 1)
	t.NoFault("a deleted webhook is done", runWebhook(events.Job{Id: id, Kind: KindWebhook, RepoId: 1, Payload: "{{\"webhook\":999,\"kind\":\"push\",\"event\":\"\"}}", Attempts: 1}))
}

fn TestPoll(t mut crucible.T) {
	let have = testDb(mut t)
	if have == nil {
		return
	}
	let c = have
	world(c) catch err {
		t.Error("world: {err}")
		return
	}
	let d = testDeps(c, "")
	Configure(d)
	feedLast = -1
	t.NoFault("first poll", pollOnce(d))
	let start = feedSeq
	_ = events.EnqueueNow(c, "push", 1, "{{\"changes\":[{{\"change\":\"kone\"}}]}}") catch _ {
		0
	}
	_ = events.EnqueueNow(c, "repack", 1, "{{}}") catch _ {
		0
	}
	// an id given out but not committed yet: the poll remembers it as a gap and reads it once it appears
	mut tx = c.Begin() catch err {
		t.Error("begin: {err}")
		return
	}
	let late = events.Enqueue(mut tx, "push", 1, "{{\"changes\":[{{\"change\":\"klate\"}}]}}") catch _ {
		0
	}
	_ = events.EnqueueNow(c, "push", 1, "{{\"changes\":[]}}") catch _ {
		0
	}
	t.NoFault("second poll", pollOnce(d))
	crucible.Equal(mut t, "two committed push events, not the repack", feedSeq - start, 2)
	t.True("the late id is a gap", len(gaps) == 1 && gaps[0].id == late)
	tx.Commit() catch err {
		t.Error("commit: {err}")
		return
	}
	t.NoFault("third poll", pollOnce(d))
	crucible.Equal(mut t, "the late event", feedSeq - start, 3)
	let e = ring[(feedSeq - 1) % ringSize]
	crucible.Equal(mut t, "late id", e.id, late)
	t.True("late change", len(e.changes) == 1 && e.changes[0] == "klate")
	crucible.Equal(mut t, "no gaps left", len(gaps), 0)
}
