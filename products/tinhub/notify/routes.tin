package notify

import "../accounts"
import "anvil"
import "argo"
import "fault"
import "mint"
import "seal"
import "tide"
import "twine"

// The routes (design/tinhub.md §4): webhooks for a repository's admins, the caller's subscriptions, and the live
// websocket. Errors are the API's {"code", "message"}; a repository the caller cannot read is 404, one the caller can
// read but not administer is 403. Every call runs inside within 5s and limit memory 16mb (design/tinhub.md §8).

// callWithin and callMemory are a call's budget.
const callWithin = 5 * tide.Second

const callMemory = 16 * 1024 * 1024

// Mount adds the routes to r.
fn Mount(r mut anvil.Router) {
	r.Get("/api/v1/live", live)
	r.Get("/api/v1/subscriptions", subscriptions)
	r.Get(`/api/v1/repos/{owner}/{repo}/hooks`, listHooks)
	r.Post(`/api/v1/repos/{owner}/{repo}/hooks`, createHook)
	r.Get(`/api/v1/repos/{owner}/{repo}/hooks/{id}`, getHook)
	r.Patch(`/api/v1/repos/{owner}/{repo}/hooks/{id}`, updateHook)
	r.Delete(`/api/v1/repos/{owner}/{repo}/hooks/{id}`, deleteHook)
	r.Get(`/api/v1/repos/{owner}/{repo}/hooks/{id}/deliveries`, deliveries)
	r.Put(`/api/v1/repos/{owner}/{repo}/subscription`, follow)
	r.Delete(`/api/v1/repos/{owner}/{repo}/subscription`, unfollow)
	r.Put(`/api/v1/repos/{owner}/{repo}/changes/{change}/subscription`, follow)
	r.Delete(`/api/v1/repos/{owner}/{repo}/changes/{change}/subscription`, unfollow)
}

// apiError is every error's body.
type apiError struct {
	code    str
	message str
}

fn fail_(w mut anvil.Out, status i64, code str, message str) {
	w.Status(status)
	w.Json()
	w.Body = []u8{}
	argo.Put(mut w.Body, apiError{code: code, message: message})
}

// answer writes a JSON text as the answer, with status.
fn answer(w mut anvil.Out, status i64, body str) {
	w.Status(status)
	w.Json()
	w.Body = []u8(body)
}

// call is a request's context: who asks, and the repository in its path.
type call struct {
	d    Deps
	user i64
	r    accounts.Repo
	role i64
}

// begin authenticates a request and, when withRepo, finds the repository and the caller's role on it; a caller who
// cannot read it gets 404, one whose role is below need 403 (401 when nobody is signed in). nil when the answer is
// written already.
fn begin(q anvil.Req, w mut anvil.Out, withRepo bool, need i64) ?call {
	let have = deps
	if have == nil {
		fail_(mut w, 503, "unavailable", "notifications are not configured on this core")
		return nil
	}
	let d = have
	let auth = d.Auth
	let user = auth(q) catch err {
		fail_(mut w, 401, "unauthorized", fault.Message(err))
		return nil
	}
	mut r = accounts.Repo{Id: 0, OwnerId: 0, Owner: "", Name: "", Visibility: "", DefaultBranch: "", QuotaBytes: 0, SizeBytes: 0}
	mut role = accounts.RoleNone
	if withRepo {
		let owner = q.PathParam("owner")
		let name = q.PathParam("repo")
		let found = accounts.FindRepo(d.Db, owner, name) catch err {
			fail_(mut w, 503, "unavailable", fault.Message(err))
			return nil
		}
		if found == nil {
			fail_(mut w, 404, "not_found", "no repository {owner}/{name}")
			return nil
		}
		let roleOf = d.Role
		role = roleOf(d.Db, user, found) catch err {
			fail_(mut w, 503, "unavailable", fault.Message(err))
			return nil
		}
		if role == accounts.RoleNone {
			fail_(mut w, 404, "not_found", "no repository {owner}/{name}")
			return nil
		}
		r = found
	}
	if need > accounts.RoleNone && user == 0 {
		fail_(mut w, 401, "unauthorized", "sign in first")
		return nil
	}
	if withRepo && role < need {
		fail_(mut w, 403, "forbidden", "this needs the {roleName(need)} role on {r.Owner}/{r.Name}")
		return nil
	}
	return call{d: d, user: user, r: r, role: role}
}

fn roleName(role i64) str {
	return match role {
		accounts.RoleAdmin => "admin"
		accounts.RoleWrite => "write"
		_ => "read"
	}
}

// ErrInvalid is the fault of a request body or parameter that is not acceptable (422); ErrMissing of a webhook or
// change that does not exist (404).
let ErrInvalid = fault("invalid")

let ErrMissing = fault("not found")

// finish answers a handler's result: its JSON with status, or the fault's error.
fn finish(w mut anvil.Out, status i64, body str, err fault) {
	if err == nil {
		answer(mut w, status, body)
		return
	}
	if fault.Is(err, ErrInvalid) {
		fail_(mut w, 422, "invalid", fault.Message(err))
		return
	}
	if fault.Is(err, ErrMissing) {
		fail_(mut w, 404, "not_found", fault.Message(err))
		return
	}
	fail_(mut w, 503, "unavailable", fault.Message(err))
}

// bounded runs f inside a call's budget and gives its JSON text.
fn bounded(f fn() !str) !str {
	mut out = ""
	try within callWithin + 0 {
		try limit memory callMemory + 0 {
			let s = try f()
			out = keep(s)
		}
	}
	return out
}

// ---- webhooks ----

type hookOut struct {
	id         i64
	url        str
	kinds      []str
	active     bool
	created_at i64
}

type hookCreated struct {
	id         i64
	url        str
	kinds      []str
	active     bool
	created_at i64
	@json("secret") key str
}

type hookIn struct {
	url    str
	@json("secret") key str
	kinds  []str
	active bool
}

type hookList struct {
	hooks []hookOut
}

fn kindsOf(csv str) []str {
	if len(csv) == 0 {
		return []str{}
	}
	return twine.Split(csv, ",")
}

// checkHook validates a webhook's fields; it returns the kinds as a comma list.
fn checkHook(d Deps, h hookIn) !str {
	CheckURL(h.url, d.AllowPrivate) catch err {
		fail fault.Wrap(ErrInvalid, fault.Message(err))
	}
	if len(h.key) < 16 || len(h.key) > 200 {
		fail fault.Wrap(ErrInvalid, "the secret must be 16 to 200 bytes")
	}
	if len(h.kinds) > 20 {
		fail fault.Wrap(ErrInvalid, "at most 20 kinds")
	}
	for k in h.kinds {
		if !kindName(k) {
			fail fault.Wrap(ErrInvalid, "{k} is not an event kind")
		}
	}
	return joinComma(h.kinds)
}

// kindName reports whether k looks like an event kind: a lower-case letter, then up to 39 of a-z, 0-9, '.', '_', '-'.
fn kindName(k str) bool {
	if len(k) == 0 || len(k) > 40 || k[0] < 'a' || k[0] > 'z' {
		return false
	}
	for i in 0..len(k) {
		let c = k[i]
		if !((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '.' || c == '_' || c == '-') {
			return false
		}
	}
	return true
}

fn hookId(q anvil.Req) i64 {
	let id = mint.Atoi(q.PathParam("id")) catch _ {
		0
	}
	return id
}

fn listHooks(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, true, accounts.RoleAdmin)
	if c == nil {
		return
	}
	let repoId = c.r.Id
	let db = c.d.Db
	let (body, err) = bounded(fn() !str {
		let rows = try db.Query("SELECT id, url, array_to_string(kinds, ','), active, extract(epoch FROM created_at)::bigint FROM webhooks WHERE repo_id = {repoId} ORDER BY id LIMIT 1000")
		mut out = hookList{hooks: []hookOut{}}
		for row in rows.Rows {
			out.hooks = append(out.hooks, hookOut{id: row[0].Int(), url: row[1].Text(), kinds: kindsOf(row[2].Text()), active: row[3].Int() == 1, created_at: row[4].Int()})
		}
		mut b = []u8{}
		argo.Put(mut b, out)
		return str(b)
	})
	finish(mut w, 200, body, err)
}

fn createHook(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, true, accounts.RoleAdmin)
	if c == nil {
		return
	}
	let repoId = c.r.Id
	let user = c.user
	let d = c.d
	let text = q.Body()
	let (body, err) = bounded(fn() !str {
		mut h = hookIn{url: "", key: "", kinds: []str{}, active: true}
		argo.Get(text, mut h) catch bad {
			fail fault.Wrap(ErrInvalid, "the body: {fault.Message(bad)}")
		}
		if len(h.key) == 0 {
			h.key = seal.Hex(seal.RandomBytes(32))
		}
		let csv = try checkHook(d, h)
		let url = h.url
		let key = h.key
		let active = h.active
		let rows = try d.Db.Query("INSERT INTO webhooks (repo_id, url, secret, kinds, active, created_by) VALUES ({repoId}, {url}, {key}, string_to_array({csv}, ','), {active}, nullif({user}, 0)) RETURNING id, extract(epoch FROM created_at)::bigint")
		let out = hookCreated{id: rows.Rows[0][0].Int(), url: url, kinds: h.kinds, active: active, created_at: rows.Rows[0][1].Int(), key: key}
		mut b = []u8{}
		argo.Put(mut b, out)
		return str(b)
	})
	finish(mut w, 201, body, err)
}

// readHook is one webhook of the repository, with its secret.
fn readHook(d Deps, repoId i64, id i64) !hookIn {
	let rows = try d.Db.Query("SELECT url, secret, array_to_string(kinds, ','), active FROM webhooks WHERE repo_id = {repoId} AND id = {id}")
	if len(rows.Rows) == 0 {
		fail fault.Wrap(ErrMissing, "no webhook {id}")
	}
	let row = rows.Rows[0]
	return hookIn{url: row[0].Text(), key: row[1].Text(), kinds: kindsOf(row[2].Text()), active: row[3].Int() == 1}
}

fn hookJson(d Deps, repoId i64, id i64) !str {
	let rows = try d.Db.Query("SELECT id, url, array_to_string(kinds, ','), active, extract(epoch FROM created_at)::bigint FROM webhooks WHERE repo_id = {repoId} AND id = {id}")
	if len(rows.Rows) == 0 {
		fail fault.Wrap(ErrMissing, "no webhook {id}")
	}
	let row = rows.Rows[0]
	mut b = []u8{}
	argo.Put(mut b, hookOut{id: row[0].Int(), url: row[1].Text(), kinds: kindsOf(row[2].Text()), active: row[3].Int() == 1, created_at: row[4].Int()})
	return str(b)
}

fn getHook(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, true, accounts.RoleAdmin)
	if c == nil {
		return
	}
	let repoId = c.r.Id
	let d = c.d
	let id = hookId(q)
	let (body, err) = bounded(fn() !str {
		return try hookJson(d, repoId, id)
	})
	finish(mut w, 200, body, err)
}

// updateHook changes the fields the body names (url, secret, kinds, active); the others keep their values.
fn updateHook(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, true, accounts.RoleAdmin)
	if c == nil {
		return
	}
	let repoId = c.r.Id
	let d = c.d
	let id = hookId(q)
	let text = q.Body()
	let (body, err) = bounded(fn() !str {
		mut h = try readHook(d, repoId, id)
		argo.Get(text, mut h) catch bad {
			fail fault.Wrap(ErrInvalid, "the body: {fault.Message(bad)}")
		}
		let csv = try checkHook(d, h)
		let url = h.url
		let key = h.key
		let active = h.active
		_ = try d.Db.Exec("UPDATE webhooks SET url = {url}, secret = {key}, kinds = string_to_array({csv}, ','), active = {active} WHERE repo_id = {repoId} AND id = {id}")
		return try hookJson(d, repoId, id)
	})
	finish(mut w, 200, body, err)
}

fn deleteHook(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, true, accounts.RoleAdmin)
	if c == nil {
		return
	}
	let repoId = c.r.Id
	let d = c.d
	let id = hookId(q)
	let (_, err) = bounded(fn() !str {
		let r = try d.Db.Exec("DELETE FROM webhooks WHERE repo_id = {repoId} AND id = {id}")
		if r.Affected == 0 {
			fail fault.Wrap(ErrMissing, "no webhook {id}")
		}
		return ""
	})
	if err == nil {
		w.Status(204)
		w.Body = []u8{}
		return
	}
	finish(mut w, 204, "", err)
}

type deliveryOut struct {
	id          i64
	event       i64
	attempt     i64
	status      i64
	error       str
	duration_ms i64
	created_at  i64
}

type deliveryPage struct {
	deliveries []deliveryOut
	next       str
}

// deliveries lists a webhook's attempts, newest first; the cursor is the last id sent.
fn deliveries(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, true, accounts.RoleAdmin)
	if c == nil {
		return
	}
	let repoId = c.r.Id
	let d = c.d
	let id = hookId(q)
	let before = mint.Atoi(q.Param("cursor")) catch _ {
		9223372036854775807
	}
	mut n = mint.Atoi(q.Param("limit")) catch _ {
		50
	}
	if n < 1 || n > 200 {
		n = 50
	}
	let (body, err) = bounded(fn() !str {
		_ = try readHook(d, repoId, id)
		let rows = try d.Db.Query("SELECT id, event_id, attempt, status, error, duration_ms, extract(epoch FROM created_at)::bigint FROM deliveries WHERE webhook_id = {id} AND id < {before} ORDER BY id DESC LIMIT {n}")
		mut page = deliveryPage{deliveries: []deliveryOut{}, next: ""}
		for row in rows.Rows {
			page.deliveries = append(page.deliveries, deliveryOut{id: row[0].Int(), event: row[1].Int(), attempt: row[2].Int(), status: row[3].Int(), error: row[4].Text(), duration_ms: row[5].Int(), created_at: row[6].Int()})
		}
		if len(page.deliveries) == n {
			page.next = "{page.deliveries[n - 1].id}"
		}
		mut b = []u8{}
		argo.Put(mut b, page)
		return str(b)
	})
	finish(mut w, 200, body, err)
}

// ---- subscriptions ----

type subOut struct {
	repo   str
	change str
}

type subList struct {
	subscriptions []subOut
}

// subscriptions lists what the caller follows.
fn subscriptions(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, false, accounts.RoleRead)
	if c == nil {
		return
	}
	let user = c.user
	let d = c.d
	let (body, err) = bounded(fn() !str {
		let rows = try d.Db.Query("SELECT o.name || '/' || r.name, s.change_id FROM subscriptions s JOIN repos r ON r.id = s.repo_id JOIN owners o ON o.id = r.owner_id WHERE s.user_id = {user} AND r.deleted_at IS NULL ORDER BY s.id LIMIT 1000")
		mut out = subList{subscriptions: []subOut{}}
		for row in rows.Rows {
			out.subscriptions = append(out.subscriptions, subOut{repo: row[0].Text(), change: row[1].Text()})
		}
		mut b = []u8{}
		argo.Put(mut b, out)
		return str(b)
	})
	finish(mut w, 200, body, err)
}

// follow subscribes the caller to the repository, or to one of its changes.
fn follow(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, true, accounts.RoleRead)
	if c == nil {
		return
	}
	let repoId = c.r.Id
	let user = c.user
	let d = c.d
	let ch = q.PathParam("change")
	let name = c.r.Owner + "/" + c.r.Name
	let (body, err) = bounded(fn() !str {
		if len(ch) > 0 {
			let rows = try d.Db.Query("SELECT 1 FROM changes WHERE repo_id = {repoId} AND change_id = {ch} LIMIT 1")
			if len(rows.Rows) == 0 {
				fail fault.Wrap(ErrMissing, "no change {ch}")
			}
		}
		_ = try d.Db.Exec("INSERT INTO subscriptions (user_id, repo_id, change_id) VALUES ({user}, {repoId}, {ch}) ON CONFLICT DO NOTHING")
		mut b = []u8{}
		argo.Put(mut b, subOut{repo: name, change: ch})
		return str(b)
	})
	finish(mut w, 200, body, err)
}

// unfollow removes the caller's subscription to the repository, or to one of its changes.
fn unfollow(q anvil.Req, w mut anvil.Out) {
	let c = begin(q, mut w, true, accounts.RoleRead)
	if c == nil {
		return
	}
	let repoId = c.r.Id
	let user = c.user
	let d = c.d
	let ch = q.PathParam("change")
	let (_, err) = bounded(fn() !str {
		_ = try d.Db.Exec("DELETE FROM subscriptions WHERE user_id = {user} AND repo_id = {repoId} AND change_id = {ch}")
		return ""
	})
	if err == nil {
		w.Status(204)
		w.Body = []u8{}
		return
	}
	finish(mut w, 204, "", err)
}
