package packfile

import "../object"
import "../store"
import "fault"
import "io"
import "quarry"
import "seal"
import "sift"
import "squash"

// Packing what is packed already (#778, #795): a fetch or a clone sends objects the server mostly holds in its own
// packs, so their entries are copied as they are, compressed bytes and deltas alike, as git reuses its packs. An
// offset delta becomes a delta by its base's id (the new pack's offsets differ); a delta whose base is not sent, or
// comes later, is sent whole instead; a loose object is compressed afresh. Entries go out in each pack's order, so
// a base comes before its deltas. Nothing is decompressed but what has to be, and no index is written: Unpack reads
// the pack in order.

// reused is where one object to send is: in packs[pack] at index position pos, or loose (pack -1).
type reused struct {
	pack i64
	off  i64
	pos  i64
	raw  str
}

// Reuse is a pack of the objects ids (each once), from the packs where they are and s for the rest.
fn Reuse[S store.ObjectStore](s mut S, packs mut []Pack, ids []object.Id) !str {
	mut b = bytesOut{b: []u8{}}
	_ = try ReuseTo(mut s, mut packs, ids, mut b)
	return str(b.b)
}

// bytesOut collects a pack in memory, for Reuse.
type bytesOut struct {
	b []u8
}

// Write appends data.
fn (o mut bytesOut) Write(data []u8) !i64 {
	o.b = append(o.b, data...)
	return len(data)
}

// ReuseTo writes the pack Reuse makes to w an entry at a time, as each is made, and gives how many objects it holds:
// a fetch streams its answer (#1009), and the client has its first bytes long before the server reaches the last.
fn ReuseTo[S store.ObjectStore, W io.Writer](s mut S, packs mut []Pack, ids []object.Id, w mut W) !i64 {
	mut seen = map[str]bool{}
	mut list = []reused{}
	for id in ids {
		let raw = id.Bytes()
		if seen[raw] {
			continue
		}
		seen[raw] = true
		mut found = false
		for k in 0..len(packs) {
			let pos = packs[k].Find(id)
			if pos >= 0 {
				list = append(list, reused{pack: k, off: packs[k].off(pos), pos: pos, raw: raw})
				found = true
				break
			}
		}
		if !found {
			list = append(list, reused{pack: -1, off: 0, pos: -1, raw: raw})
		}
	}
	// each pack's entries in its order (bases before their deltas), the loose ones last
	sift.SortStableFunc(mut list, fn(a reused, b reused) i64 {
		let pa = packRank(a.pack)
		let pb = packRank(b.pack)
		if pa != pb {
			return pa - pb
		}
		return a.off - b.off
	})
	// each pack's entries by offset, to name an offset delta's base
	mut posOf = []map[i64]i64{}
	for k in 0..len(packs) {
		mut m = map[i64]i64{}
		for i in 0..packs[k].Count {
			m[packs[k].off(i)] = i
		}
		posOf = append(posOf, m)
	}
	mut h = seal.NewSha256()
	mut head = []u8{}
	appendStr(mut head, "TITPACK\x00")
	appendLE32(mut head, 1)
	appendLE64(mut head, len(list))
	try put(mut w, mut h, head)
	mut sent = map[str]bool{}
	// an entry's header goes out of e, its compressed bytes straight from the pack's file through window (#1076): a
	// clone of a file of any size costs a window, not the file
	mut e = []u8{}
	mut window = []u8{}
	for r in list {
		if r.pack >= 0 {
			mut p = packs[r.pack]
			let (t, size, baseOff, baseId, zAt, zLen) = try p.stored(r.pos)
			mut base = baseId
			if baseOff >= 0 {
				let (bpos, known) = posOf[r.pack][baseOff]
				if known {
					base = p.idx[idsAt + 32 * bpos:idsAt + 32 * bpos + 32]
				}
			}
			if t != typeOfsDelta && t != typeRefDelta {
				e = e[0:0]
				e = append(e, u8(t))
				appendUv(mut e, size)
				appendUv(mut e, zLen)
				try put(mut w, mut h, e)
				if len(window) == 0 {
					window = make([]u8, sendWindow)
				}
				try sendRange(mut p, zAt, zLen, mut window, mut w, mut h)
			} else if len(base) == 32 && sent[base] {
				e = e[0:0]
				e = append(e, u8(typeRefDelta))
				appendUv(mut e, size)
				appendStr(mut e, base)
				appendUv(mut e, zLen)
				try put(mut w, mut h, e)
				if len(window) == 0 {
					window = make([]u8, sendWindow)
				}
				try sendRange(mut p, zAt, zLen, mut window, mut w, mut h)
			} else {
				// the base is not in this pack, or not sent: the object goes whole
				let id = try object.IdOf(r.raw)
				let (kind, body) = try p.GetRaw(id)
				let whole = try wholeEntry(kind, body)
				try put(mut w, mut h, whole)
			}
			packs[r.pack] = p
		} else {
			let id = try object.IdOf(r.raw)
			let (kind, body) = try s.GetRaw(id)
			let whole = try wholeEntry(kind, body)
			try put(mut w, mut h, whole)
		}
		sent[r.raw] = true
	}
	_ = try w.Write(h.Sum())
	return len(list)
}

// sendWindow is how much of a pack's file a fetch reads at a time to send an entry's compressed bytes.
const sendWindow = 1 << 20

// sendRange writes n bytes of the pack from off to w and to the hash h, a window at a time through buf: an entry of
// any size costs the window (buf, sendWindow bytes), and each window's read is freed before the next (#1076).
fn sendRange[W io.Writer](p mut Pack, off i64, n i64, buf mut []u8, w mut W, h mut seal.Hasher) ! {
	mut done = 0
	for done < n {
		let k = min(sendWindow, n - done)
		let at = off + done
		mut part = buf[0:k]
		mut got = 0
		if p.loaded {
			let data = p.data
			got = arena {
				copy(part, data[at:at + k])
			}
		} else {
			let path = p.Path
			let (read, err) = arena {
				let chunk = try quarry.ReadAt(path, at, k)
				copy(part, chunk)
			}
			got = read
			if err != nil {
				if !p.followRetired() {
					fail err
				}
				let moved = p.Path
				got = try arena {
					let chunk = try quarry.ReadAt(moved, at, k)
					copy(part, chunk)
				}
			}
		}
		if got != k {
			fail fault.Wrap(ErrBadPack, "{p.Path} is shorter than its index says")
		}
		_ = try h.Write(part)
		_ = try w.Write(part)
		done += k
	}
}

// put writes b to w and to the pack's hash.
fn put[W io.Writer](w mut W, h mut seal.Hasher, b []u8) ! {
	_ = try h.Write(b)
	_ = try w.Write(b)
}

// packRank orders the packs, loose objects (-1) last.
fn packRank(k i64) i64 {
	if k < 0 {
		return 1 << 40
	}
	return k
}

// wholeEntry is an object as a whole entry: commits and trees stored, blobs compressed (as Write does).
fn wholeEntry(kind object.Kind, body str) ![]u8 {
	mut e = []u8{u8(typeOf(kind))}
	appendUv(mut e, len(body))
	mut level = squash.Default
	if kind != object.Kind.Blob {
		level = 0
	}
	let lv = level
	let z = arena {
		squash.Zlib(body, lv)
	}
	appendUv(mut e, len(z))
	appendStr(mut e, z)
	return e
}
