package packfile

import "../object"
import "fault"
import "flume"
import "quarry"
import "seal"
import "squash"
import "stamp"

// Keeping a received pack as it is (#795, #778), as git's index-pack does: a fetch or a clone gets a pack, and rather
// than unpacking every object into memory and packing them again, the pack's bytes are written as they came and an
// index is built for them. Building it needs each object's id, so each entry is decoded once, in order, its delta's
// base taken from a cache of recent bodies (a bounded number of bytes) or decoded again from the pack; nothing holds
// the whole history in memory. A delta's base must be in the same pack (Reuse sends one so).

// keepBatch is how many bytes of decoded bodies one batch of entries keeps as bases for the deltas after them.
const keepBatch = 16 << 20

// The cache of decoded bodies lives in an arena that spans a batch of entries (#1009): at the batch's end it goes with
// the arena, all of it, so indexing a pack takes the memory of one batch whatever the pack's size. (Kept in globals, a
// dropped body waited for the end of the request to be freed, so a push or a clone held every body it had decoded.) A
// delta whose base is in an earlier batch decodes the base again from the pack.

// batchCache is one batch's decoded bodies and their kinds by offset, and its entries' offsets by id.
type batchCache struct {
	bodies map[i64]str
	kinds  map[i64]i64
	byId   map[str]i64
}

// batch is what one batch gives back: its entries' ids (32 bytes each), offsets and CRCs, and where the next begins.
type batch struct {
	ids  []str
	offs []i64
	crcs []u32
	next i64
}

// kept is what one entry's own arena gives back: its kind, where the next entry starts, its id, its CRC, and its body
// when it is small enough to keep as a base.
type kept struct {
	kind i64
	next i64
	id   str
	crc  u32
	body str
}

// src is where a pack's bytes are read from: the bytes themselves (Keep), or a file read a range at a time (KeepFile),
// so a pack of gigabytes is indexed in the memory of the entries it holds, not of the whole pack.
type src struct {
	data str
	path str
}

// span is the pack's bytes from a to b.
fn (s src) span(a i64, b i64) !str {
	if len(s.path) == 0 {
		return s.data[a:b]
	}
	let got = try quarry.ReadAt(s.path, a, b - a)
	if len(got) != b - a {
		fail fault.Wrap(ErrBadPack, "{s.path} is shorter than {b} bytes")
	}
	return got
}

// headOf is the first bytes of the entry at off: enough for its header, cut at the entries' end.
fn headOf(s src, end i64, off i64) !str {
	return try s.span(off, min(end, off + maxHead))
}

fn uvarintTo(h str, at i64) !(i64, i64) {
	let (v, next) = try uvarintIn(h, at)
	if next > len(h) {
		fail fault.Wrap(ErrBadPack, "a number runs past the entries at {at}")
	}
	return v, next
}

// decodeAt is the kind (an entry type) and body of the entry at off, its delta chain resolved within the pack, and
// where the next entry starts. c is the current batch's cache; before is the offsets of earlier batches' entries by id.
fn decodeAt(s src, end i64, max i64, off i64, depth i64, c batchCache, before map[str]i64) !(i64, str, i64) {
	if depth > MaxDeltaDepth {
		fail fault.Wrap(ErrBadPack, "a delta chain deeper than {MaxDeltaDepth} at {off}")
	}
	if off < 20 || off >= end {
		fail fault.Wrap(ErrBadPack, "an entry outside the pack at {off}")
	}
	// the header, from a window of the entry (its offsets relative to off)
	let h = try headOf(s, end, off)
	let t = i64(h[0])
	let (size, a) = try uvarintTo(h, 1)
	if size > max {
		fail fault.Wrap(fault.LimitExceeded, "an object of {size} bytes at {off}")
	}
	mut at = a
	mut baseOff = -1
	if t == typeOfsDelta {
		let (dist, b) = try uvarintTo(h, at)
		at = b
		baseOff = off - dist
		if dist <= 0 || baseOff < 20 {
			fail fault.Wrap(ErrBadPack, "a delta at {off} against no earlier entry")
		}
	} else if t == typeRefDelta {
		if at + 32 > len(h) {
			fail fault.Wrap(ErrBadPack, "an entry runs past the end")
		}
		let ref = h[at:at + 32]
		let (bo, known) = c.byId[ref]
		if known {
			baseOff = bo
		} else {
			let (eo, earlier) = before[ref]
			if !earlier {
				fail fault.Wrap(ErrBadPack, "a delta at {off} against an object not before it in the pack")
			}
			baseOff = eo
		}
		at += 32
	}
	let (clen, cl) = try uvarintTo(h, at)
	if clen < 0 || off + cl + clen > end {
		fail fault.Wrap(ErrBadPack, "an entry runs past the end")
	}
	let z = try s.span(off + cl, off + cl + clen)
	let next = off + cl + clen
	if baseOff < 0 {
		let _ = try kindOf(t)
		let body = squash.Unzlib(z, size + 1) catch err {
			fail fault.Wrap(ErrBadPack, "entry at {off}: {fault.Message(err)}")
		}
		if len(body) != size {
			fail fault.Wrap(ErrBadPack, "entry at {off}: {len(body)} bytes, not {size}")
		}
		return t, body, next
	}
	mut kind = typeBlob
	mut base = ""
	let (cached, hit) = c.bodies[baseOff]
	if hit {
		kind = c.kinds[baseOff]
		base = cached
	} else {
		let (bk, bb, _) = try decodeAt(s, end, max, baseOff, depth + 1, c, before)
		kind = bk
		base = bb
	}
	let d = squash.Unzlib(z, 2 * max + 64) catch err {
		fail fault.Wrap(ErrBadPack, "entry at {off}: {fault.Message(err)}")
	}
	let body = try ApplyDelta(base, d, size)
	return kind, body, next
}

// entryOf decodes the entry at off and gives what indexing records of it, with its body when it may serve as a base.
fn entryOf(s src, end i64, max i64, off i64, c batchCache, before map[str]i64) !kept {
	let (t, body, next) = try decodeAt(s, end, max, off, 0, c, before)
	let kind = try kindOf(t)
	let id = object.Hash(kind, body)
	let bytes = try s.span(off, next)
	mut base = ""
	if len(body) <= keepBatch / 4 {
		base = body
	}
	return kept{kind: t, next: next, id: id.Bytes(), crc: stamp.Crc32(bytes), body: base}
}

// batchFrom decodes entries from at0, at most left of them, until their bodies pass keepBatch bytes; each entry is
// decoded in an arena of its own, inside the batch's.
fn batchFrom(s src, end i64, max i64, at0 i64, left i64, count i64, done i64, before map[str]i64) !batch {
	mut c = batchCache{bodies: map[i64]str{}, kinds: map[i64]i64{}, byId: map[str]i64{}}
	mut out = batch{ids: []str{}, offs: []i64{}, crcs: []u32{}, next: at0}
	mut held = 0
	mut at = at0
	for n in 0..left {
		if at >= end {
			fail fault.Wrap(ErrBadPack, "{count} entries promised, {done + n} found")
		}
		let off = at
		let e = try arena {
			try entryOf(s, end, max, off, c, before)
		}
		if len(e.body) > 0 {
			c.bodies[off] = e.body
			c.kinds[off] = e.kind
			held += len(e.body)
		}
		c.byId[e.id] = off
		out.ids = append(out.ids, e.id)
		out.offs = append(out.offs, off)
		out.crcs = append(out.crcs, e.crc)
		at = e.next
		if held > keepBatch {
			break
		}
	}
	out.next = at
	return out
}

// indexEntries decodes every entry of the pack in s, in order, from offset 20 to end, giving their ids, offsets and
// CRCs: a batch at a time, each in an arena of its own.
fn indexEntries(s src, count i64, end i64, maxObject i64) !([]object.Id, []i64, []u32) {
	mut ids = make([]object.Id, 0, min(count, 1 << 20))
	mut offs = make([]i64, 0, min(count, 1 << 20))
	mut crcs = make([]u32, 0, min(count, 1 << 20))
	mut before = map[str]i64{}
	mut at = 20
	for len(ids) < count {
		let done = len(ids)
		let b = try arena {
			try batchFrom(s, end, maxObject, at, count - done, count, done, before)
		}
		for i in 0..len(b.ids) {
			let id = try object.IdOf(b.ids[i])
			ids = append(ids, id)
			offs = append(offs, b.offs[i])
			crcs = append(crcs, b.crcs[i])
			before[b.ids[i]] = b.offs[i]
		}
		at = b.next
	}
	if at != end {
		fail fault.Wrap(ErrBadPack, "{end - at} bytes after the last entry")
	}
	return ids, offs, crcs
}

// Keep writes the pack data (as a fetch receives it) into dir as it is, with an index built for it, after checking
// it whole: its hash, its count, every entry decoded and its id computed, nothing after the last entry. No object is
// larger than maxObject.
fn Keep(data str, dir str, maxObject i64) !Pack {
	if len(data) < 20 + 32 || data[0:8] != "TITPACK\x00" || le32(data, 8) != 1 {
		fail fault.Wrap(ErrBadPack, "not a version 1 pack")
	}
	if str(seal.Sha256(data[0:len(data) - 32])) != data[len(data) - 32:] {
		fail fault.Wrap(ErrBadPack, "its trailing hash does not match")
	}
	let count = le64(data, 12)
	let end = len(data) - 32
	if count < 0 || count > end {
		fail fault.Wrap(ErrBadPack, "{count} entries in {len(data)} bytes")
	}
	let (ids, offs, crcs) = try indexEntries(src{data: data, path: ""}, count, end, maxObject)
	try quarry.MkdirAll(dir)
	let tmp = dir + "/tmp-" + seal.Hex(seal.RandomBytes(8))
	return try finish(dir, tmp, data, ids, offs, crcs)
}

// KeepFile is Keep for a pack already in a file (a push or a fetch streamed to disk): the file is checked and indexed
// reading a range at a time, then moved into dir with its index. On a fault the file is left where it was.
fn KeepFile(path str, dir str, maxObject i64) !Pack {
	let info = try quarry.Lstat(path)
	let size = info.Size
	let head = try readHead(path, 20)
	if size < 20 + 32 || len(head) < 20 || head[0:8] != "TITPACK\x00" || le32(head, 8) != 1 {
		fail fault.Wrap(ErrBadPack, "not a version 1 pack")
	}
	let trailer = try quarry.ReadAt(path, size - 32, 32)
	let sum = try hashPrefix(path, size - 32)
	if sum != trailer {
		fail fault.Wrap(ErrBadPack, "its trailing hash does not match")
	}
	let count = le64(head, 12)
	let end = size - 32
	if count < 0 || count > end {
		fail fault.Wrap(ErrBadPack, "{count} entries in {size} bytes")
	}
	let (ids, offs, crcs) = try indexEntries(src{data: "", path: path}, count, end, maxObject)
	try quarry.MkdirAll(dir)
	let tmp = dir + "/tmp-" + seal.Hex(seal.RandomBytes(8))
	try quarry.Sync(path)
	try quarry.Rename(path, tmp + ".pack")
	return try install(dir, tmp, trailer, ids, offs, crcs)
}

// hashPrefix is the SHA-256 of the first n bytes of the file at path, read a buffer at a time.
fn hashPrefix(path str, n i64) !str {
	mut h = seal.NewSha256()
	mut r = try flume.Open(path)
	mut buf = make([]u8, 1 << 20)
	mut total = 0
	for total < n {
		let want = min(len(buf), n - total)
		let k = r.Read(mut buf[0:want]) catch e {
			r.Close()
			fail e
		}
		if k == 0 {
			break
		}
		_ = try h.Write(buf[0:k])
		total += k
	}
	r.Close()
	if total != n {
		fail fault.Wrap(ErrBadPack, "{path} is shorter than {n} bytes")
	}
	return str(h.Sum())
}
