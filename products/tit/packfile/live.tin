package packfile

import "../crash"
import "fault"
import "mint"
import "quarry"
import "twine"

// Live, retired and pending packs in a .tit directory's packs/ (design/tit.md §16, #1007). A pack is never deleted
// while a reader may still open it: Retire moves it to packs/retired, where a reader that listed it before finds it,
// and Sweep deletes it once it has been retired longer than the grace period.

// DefaultGrace is how long a retired pack is kept, in seconds: longer than any read of it.
const DefaultGrace = 3600

// Grace is the grace period in seconds: TIT_RETIRED_GRACE when it is set, DefaultGrace otherwise.
fn Grace() i64 {
	let s = quarry.Getenv("TIT_RETIRED_GRACE")
	if len(s) == 0 {
		return DefaultGrace
	}
	let n = mint.Atoi(s) catch _ {
		DefaultGrace
	}
	if n < 0 {
		return DefaultGrace
	}
	return n
}

// liveNames is the names (hashes) of the live packs in dir, as listed now.
fn liveNames(dir str) ![]str {
	mut out = []str{}
	if !quarry.IsDir(dir) {
		return out
	}
	let names = try quarry.ReadDir(dir)
	for n in names {
		if twine.HasSuffix(n, ".pack") && !twine.HasPrefix(n, "tmp-") {
			out = append(out, n[0:len(n) - 5])
		}
	}
	return out
}

// OpenAll opens every live pack in dir. A pack retired between the listing and its open is not an error: the
// directory is listed again (once), and a pack still gone then is left out, as it is no longer live.
fn OpenAll(dir str) ![]Pack {
	mut out = []Pack{}
	let names = try liveNames(dir)
	mut again = false
	for n in names {
		let path = dir + "/" + n + ".pack"
		let (p, err) = Open(path)
		if err != nil {
			if quarry.Exists(path) {
				fail err
			}
			again = true
			continue
		}
		out = append(out, p)
	}
	if !again {
		return out
	}
	mut have = map[str]bool{}
	for p in out {
		have[p.Path] = true
	}
	let later = try liveNames(dir)
	for n in later {
		let path = dir + "/" + n + ".pack"
		let (_, seen) = have[path]
		if seen {
			continue
		}
		let (p, err) = Open(path)
		if err != nil {
			if quarry.Exists(path) {
				fail err
			}
			continue
		}
		out = append(out, p)
	}
	return out
}

// Retire moves the live packs called names out of dir into dir/retired, each pack before its index (a listing
// stops naming it first), with a file saying when; it is how many were live.
fn Retire(dir str, names []str, now i64) !i64 {
	let to = dir + "/retired"
	try quarry.MkdirAll(to)
	mut n = 0
	for name in names {
		let from = dir + "/" + name
		if !quarry.Exists(from + ".pack") {
			continue
		}
		try quarry.WriteFile(to + "/" + name + ".at", "{now}\n")
		crash.Point()
		try quarry.Rename(from + ".pack", to + "/" + name + ".pack")
		crash.Point()
		try quarry.Rename(from + ".idx", to + "/" + name + ".idx")
		n += 1
	}
	try quarry.Sync(dir)
	return n
}

// retiredAt is when the retired pack called name was retired (unix seconds): its .at file, else its index's mtime.
fn retiredAt(to str, name str) i64 {
	let text = quarry.ReadFile(to + "/" + name + ".at") catch _ {
		""
	}
	let t = mint.Atoi(twine.TrimSpace(text)) catch _ {
		-1
	}
	if t >= 0 {
		return t
	}
	let info = quarry.Lstat(to + "/" + name + ".pack") catch _ {
		return 0
	}
	return info.Mtime / 1000000000
}

// Sweep deletes from dir the packs retired more than grace seconds before now, and the pending packs in dir/staged
// written more than grace seconds before now (a push that crashed or was refused); it is how many packs went.
fn Sweep(dir str, grace i64, now i64) !i64 {
	mut n = 0
	let to = dir + "/retired"
	if quarry.IsDir(to) {
		let names = try quarry.ReadDir(to)
		for f in names {
			if !twine.HasSuffix(f, ".pack") {
				continue
			}
			let name = f[0:len(f) - 5]
			if now - retiredAt(to, name) <= grace {
				continue
			}
			try removeIfThere(to + "/" + name + ".pack")
			try removeIfThere(to + "/" + name + ".idx")
			try removeIfThere(to + "/" + name + ".at")
			n += 1
		}
	}
	let staged = dir + "/staged"
	if quarry.IsDir(staged) {
		let names = try quarry.ReadDir(staged)
		for f in names {
			let path = staged + "/" + f
			let info = quarry.Lstat(path) catch _ {
				continue
			}
			if now - info.Mtime / 1000000000 <= grace {
				continue
			}
			try removeIfThere(path)
			if twine.HasSuffix(f, ".pack") {
				n += 1
			}
		}
	}
	return n
}

fn removeIfThere(path str) ! {
	if !quarry.Exists(path) {
		return
	}
	quarry.Remove(path) catch e {
		if quarry.Exists(path) {
			fail fault.Wrap(e, "removing {path}")
		}
	}
}

// retiredPath is where the pack at path is once retired, or "" when path is not a live pack's.
fn retiredPath(path str) str {
	let slash = twine.LastIndex(path, "/")
	if slash < 0 {
		return ""
	}
	let dir = path[0:slash]
	if twine.HasSuffix(dir, "/retired") {
		return ""
	}
	return dir + "/retired/" + path[slash + 1:]
}

// followRetired points the pack at its retired copy when the live file is gone (Retire moved it after this pack was
// opened), so a reader that listed it before keeps reading; false when there is nothing to follow.
fn (p mut Pack) followRetired() bool {
	if quarry.Exists(p.Path) {
		return false
	}
	let other = retiredPath(p.Path)
	if len(other) == 0 || !quarry.Exists(other) {
		return false
	}
	p.Path = other
	return true
}

// readAt is n bytes of the pack's file from off, following the pack into packs/retired when it moved there.
fn (p mut Pack) readAt(off i64, n i64) !str {
	let (s, err) = quarry.ReadAt(p.Path, off, n)
	if err == nil {
		return s
	}
	if p.followRetired() {
		return try quarry.ReadAt(p.Path, off, n)
	}
	fail err
}

// readAll is the pack's whole file (at most n bytes), following the pack into packs/retired when it moved there.
fn (p mut Pack) readAll(n i64) !str {
	let (s, err) = quarry.ReadFileBound(p.Path, n)
	if err == nil {
		return s
	}
	if p.followRetired() {
		return try quarry.ReadFileBound(p.Path, n)
	}
	fail err
}
