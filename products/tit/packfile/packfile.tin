package packfile

import "../object"
import "fault"
import "flume"
import "pack"
import "quarry"
import "seal"
import "sift"
import "squash"
import "stamp"

// Packs and their indexes (design/tit.md section 6; #778). A pack holds many objects, some as deltas against an earlier
// entry (by distance back) or against an object by id; every entry records its compressed length. The index maps ids
// to entries through a fan-out table and a sorted list. A Pack is a read-only ObjectStore.

// ErrBadPack is the fault of a pack or index that breaks the format.
let ErrBadPack = fault("bad pack")

// MaxDeltaDepth is the longest delta chain a pack may hold.
const MaxDeltaDepth = 50

const typeBlob = 1
const typeTree = 2
const typeCommit = 3
const typeTag = 4
const typeOfsDelta = 8
const typeRefDelta = 9

fn typeOf(k object.Kind) i64 {
	return match k {
		Blob => typeBlob
		Tree => typeTree
		Commit => typeCommit
		Tag => typeTag
	}
}

fn kindOf(t i64) !object.Kind {
	if t == typeBlob {
		return object.Kind.Blob
	}
	if t == typeTree {
		return object.Kind.Tree
	}
	if t == typeCommit {
		return object.Kind.Commit
	}
	if t == typeTag {
		return object.Kind.Tag
	}
	fail fault.Wrap(ErrBadPack, "entry type {t}")
}

// Pack is an open pack with its index. Its bytes are read the first time an object of it is (a command that needs
// none of its objects reads only its index) and checked then against the hash the index names; every object read is
// checked against its id, and Verify checks the whole pack.
type Pack struct {
	Path    str
	Count   i64
	size    i64
	trailer str
	loaded  bool
	data    str
	// idx is the index file: its ids, offsets and CRCs are read from it where they are (#807: copying them out on
	// every open cost more than a status)
	idx str
	// ends is the entries' offsets in order, then the trailer's: an entry runs to the next one
	ends []i64
	// ranged counts the entries read one by one (entryBytes)
	ranged i64
	fanout []i64
	cache  map[i64]str
	kinds  map[i64]object.Kind
	// order is the cached offsets, oldest first; held their bytes (at most cacheMost)
	order []i64
	held  i64
}

fn le32(s str, at i64) i64 {
	return i64(s[at]) | (i64(s[at + 1]) << 8) | (i64(s[at + 2]) << 16) | (i64(s[at + 3]) << 24)
}

fn le64(s str, at i64) i64 {
	return le32(s, at) | (le32(s, at + 4) << 32)
}

// readHead is the first n bytes of a file (fewer when it is shorter).
fn readHead(path str, n i64) !str {
	mut r = try flume.Open(path)
	mut buf = make([]u8, n)
	mut got = 0
	for got < n {
		let k = r.Read(mut buf[got:]) catch e {
			r.Close()
			fail e
		}
		if k == 0 {
			break
		}
		got += k
	}
	r.Close()
	return str(buf[0:got])
}

// Open opens the pack at path (ending in .pack) and its index (the same name ending in .idx), checking both.
fn Open(path str) !Pack {
	let info = try quarry.Lstat(path)
	let head = try readHead(path, 20)
	if info.Size < 20 + 32 || len(head) < 20 || head[0:8] != "TITPACK\x00" || le32(head, 8) != 1 {
		fail fault.Wrap(ErrBadPack, "{path}: not a version 1 pack")
	}
	let count = le64(head, 12)
	let idxPath = path[0:len(path) - 5] + ".idx"
	let idx = try flume.ReadFile(idxPath)
	let want = 8 + 4 + 8 + 1024 + count * 44 + 64
	if count < 0 || count > info.Size || len(idx) != want || idx[0:8] != "TITIDX\x00\x00" || le32(idx, 8) != 1 || le64(idx, 12) != count {
		fail fault.Wrap(ErrBadPack, "{idxPath}: not the index of this pack")
	}
	mut fanout = make([]i64, 256)
	mut prev = 0
	for i in 0..256 {
		fanout[i] = le32(idx, 20 + 4 * i)
		if fanout[i] < prev {
			fail fault.Wrap(ErrBadPack, "{idxPath}: the fan-out table goes down")
		}
		prev = fanout[i]
	}
	if fanout[255] != count {
		fail fault.Wrap(ErrBadPack, "{idxPath}: the fan-out table does not end at the count")
	}
	// The index's hash and the order of its ids are checked by Verify (tit verify), as git checks its own indexes
	// in fsck: an open reads only what it needs, and an offset is checked where it is used.
	return Pack{Path: path, Count: count, size: info.Size, trailer: idx[len(idx) - 64:len(idx) - 32], loaded: false, data: "", idx: idx, ends: []i64{}, ranged: 0, fanout: fanout, cache: map[i64]str{}, kinds: map[i64]object.Kind{}, order: []i64{}, held: 0}
}

// idsAt is where the ids start in an index: after its header (20 bytes) and fan-out table (1024).
const idsAt = 20 + 1024

// off is the offset in the pack of the entry at position i of the index.
fn (p Pack) off(i i64) i64 {
	return le64(p.idx, idsAt + 32 * p.Count + 8 * i)
}

// crc is the CRC-32 of the entry at position i.
fn (p Pack) crc(i i64) u32 {
	return u32(le32(p.idx, idsAt + 40 * p.Count + 4 * i))
}

// offOf is off, checked to lie inside the pack.
fn (p Pack) offOf(i i64) !i64 {
	let o = p.off(i)
	if o < 20 || o >= p.size - 32 {
		fail fault.Wrap(ErrBadPack, "{p.Path}: an offset outside the pack")
	}
	return o
}

// idBefore reports whether the 32-byte id at a in ids sorts before the one at b.
fn idBefore(ids str, a i64, b i64) bool {
	for k in 0..32 {
		if ids[a + k] != ids[b + k] {
			return ids[a + k] < ids[b + k]
		}
	}
	return false
}

// Find is the position of the object in the index, or -1.
fn (p Pack) Find(id object.Id) i64 {
	let raw = id.Bytes()
	let first = i64(raw[0])
	mut lo = 0
	if first > 0 {
		lo = p.fanout[first - 1]
	}
	mut hi = p.fanout[first]
	for lo < hi {
		let mid = (lo + hi) / 2
		// compared in place: a slice of the index would be a copy per step
		let at = idsAt + 32 * mid
		mut c = 0
		for k in 0..32 {
			if p.idx[at + k] != raw[k] {
				if p.idx[at + k] < raw[k] {
					c = -1
				} else {
					c = 1
				}
				break
			}
		}
		if c == 0 {
			return mid
		}
		if c < 0 {
			lo = mid + 1
		} else {
			hi = mid
		}
	}
	return -1
}

// Has reports whether the pack holds the object.
fn (p Pack) Has(id object.Id) bool {
	return p.Find(id) >= 0
}

// IdAt is the id of the object at position i of the index.
fn (p Pack) IdAt(i i64) object.Id {
	let id = object.IdOf(p.idx[idsAt + 32 * i:idsAt + 32 * i + 32]) catch _ {
		object.NoId
	}
	return id
}

// load reads the pack's bytes the first time they are needed, and checks them against the hash its index names.
fn (p mut Pack) load() ! {
	if p.loaded {
		return
	}
	let data = try flume.ReadFile(p.Path)
	if len(data) != p.size || data[len(data) - 32:] != p.trailer || data[0:8] != "TITPACK\x00" {
		fail fault.Wrap(ErrBadPack, "{p.Path}: the pack does not match its index")
	}
	p.data = keep(data)
	p.loaded = true
}

fn (p Pack) uvarint(at i64) !(i64, i64) {
	if at >= len(p.data) - 32 {
		fail fault.Wrap(ErrBadPack, "an entry runs past the end")
	}
	let (v, n) = pack.Uvarint([]u8(p.data[at:min(len(p.data) - 32, at + 10)])) catch _ {
		fail fault.Wrap(ErrBadPack, "a bad varint at {at}")
	}
	if v > u64(1) << 40 {
		fail fault.Wrap(ErrBadPack, "a size too large at {at}")
	}
	return i64(v), at + n
}

// wholeUnder is the size under which a pack is read whole the first time an object of it is.
const wholeUnder = 2 << 20

// entryBytes is the entry at off, up to the next one: from the pack's bytes once they are read, otherwise only that
// range of the file (quarry.ReadAt), so reading a few objects of a large pack reads a few entries of it.
fn (p mut Pack) entryBytes(off i64) !str {
	if len(p.ends) == 0 {
		// the entries' offsets in order, made the first time an entry's end is wanted
		mut ends = make([]i64, p.Count)
		for i in 0..p.Count {
			ends[i] = p.off(i)
		}
		sift.Sort(mut ends)
		p.ends = append(ends, p.size - 32)
	}
	mut lo = 0
	mut hi = len(p.ends)
	for lo < hi {
		let mid = (lo + hi) / 2
		if p.ends[mid] <= off {
			lo = mid + 1
		} else {
			hi = mid
		}
	}
	if lo >= len(p.ends) || off < 20 {
		fail fault.Wrap(ErrBadPack, "no entry at {off}")
	}
	let end = p.ends[lo]
	// a small pack, or one read entry by entry many times already, is read whole: one read beats many
	if !p.loaded && (p.size <= wholeUnder || (p.ranged >= 64 && p.size <= 256 << 20)) {
		try p.load()
	}
	if p.loaded {
		return p.data[off:end]
	}
	p.ranged += 1
	let e = try quarry.ReadAt(p.Path, off, end - off)
	if len(e) != end - off {
		fail fault.Wrap(ErrBadPack, "{p.Path} is shorter than its index says")
	}
	return e
}

// storedZlib is the data of a zlib stream made only of stored blocks, when it is exactly size bytes and its Adler-32
// matches; otherwise "" (the caller inflates it, which also reports what is wrong with it). size 0 is never stored.
fn storedZlib(z str, size i64) str {
	// the header: deflate with a 32 KiB window, no dictionary, a multiple of 31
	if size <= 0 || len(z) < 2 + 5 + 4 || (i64(z[0]) & 15) != 8 || (i64(z[1]) & 32) != 0 || (i64(z[0]) * 256 + i64(z[1])) % 31 != 0 {
		return ""
	}
	// one final block, as almost every commit and tree is: the body is a slice of the stream
	if i64(z[2]) == 1 && len(z) == 2 + 5 + size + 4 {
		let n = i64(z[3]) | (i64(z[4]) << 8)
		let nn = i64(z[5]) | (i64(z[6]) << 8)
		if n == size && n ^ nn == 65535 {
			let body = z[7:7 + n]
			let at = 7 + n
			let sum = (u32(z[at]) << 24) | (u32(z[at + 1]) << 16) | (u32(z[at + 2]) << 8) | u32(z[at + 3])
			if stamp.Adler32(body) == sum {
				return body
			}
			return ""
		}
	}
	mut out = make([]u8, 0, size)
	mut at = 2
	for {
		if at + 5 > len(z) {
			return ""
		}
		let h = i64(z[at])
		// BTYPE 00 (stored) and nothing else in the header byte
		if (h >> 1) != 0 {
			return ""
		}
		let n = i64(z[at + 1]) | (i64(z[at + 2]) << 8)
		let nn = i64(z[at + 3]) | (i64(z[at + 4]) << 8)
		if n ^ nn != 65535 || at + 5 + n > len(z) || len(out) + n > size {
			return ""
		}
		for k in 0..n {
			out = append(out, z[at + 5 + k])
		}
		at += 5 + n
		if h & 1 == 1 {
			break
		}
	}
	if at + 4 != len(z) || len(out) != size {
		return ""
	}
	let body = str(out)
	let sum = (u32(z[at]) << 24) | (u32(z[at + 1]) << 16) | (u32(z[at + 2]) << 8) | u32(z[at + 3])
	if stamp.Adler32(body) != sum {
		return ""
	}
	return body
}

// varintIn is the uvarint at e[at:] and where it ends, within e.
fn varintIn(e str, at i64) !(i64, i64) {
	if at >= len(e) {
		fail fault.Wrap(ErrBadPack, "an entry runs past its end")
	}
	let (v, n) = pack.Uvarint([]u8(e[at:min(len(e), at + 10)])) catch _ {
		fail fault.Wrap(ErrBadPack, "a bad varint")
	}
	if v > u64(1) << 40 {
		fail fault.Wrap(ErrBadPack, "a size too large")
	}
	return i64(v), at + n
}

// entryAt reads the object at offset off, resolving deltas up to MaxDeltaDepth.
fn (p mut Pack) entryAt(off i64, depth i64) !(object.Kind, str) {
	if depth > MaxDeltaDepth {
		fail fault.Wrap(ErrBadPack, "a delta chain longer than {MaxDeltaDepth}")
	}
	let (cached, hit) = p.cache[off]
	if hit {
		return p.kinds[off], cached
	}
	let e = try p.entryBytes(off)
	let t = i64(e[0])
	let (size, a) = try varintIn(e, 1)
	mut baseOff = -1
	mut at = a
	if t == typeOfsDelta {
		let (dist, b) = try varintIn(e, at)
		baseOff = off - dist
		if dist <= 0 || baseOff < 20 {
			fail fault.Wrap(ErrBadPack, "a delta at {off} against no earlier entry")
		}
		at = b
	} else if t == typeRefDelta {
		if at + 32 > len(e) {
			fail fault.Wrap(ErrBadPack, "an entry runs past the end")
		}
		let baseId = try object.IdOf(e[at:at + 32])
		let pos = p.Find(baseId)
		if pos < 0 {
			fail fault.Wrap(ErrBadPack, "a delta at {off} against {baseId.Hex()}, which this pack lacks")
		}
		baseOff = try p.offOf(pos)
		if baseOff == off {
			fail fault.Wrap(ErrBadPack, "a delta at {off} against itself")
		}
		at += 32
	}
	let (clen, c) = try varintIn(e, at)
	if c + clen > len(e) {
		fail fault.Wrap(ErrBadPack, "an entry runs past the end")
	}
	let zbytes = e[c:c + clen]
	// the inflater grows its output by doubling (the buffers it outgrows stay until the pool resets, less than 4 times
	// the size together) and copies the result once: 6 times the size, and room for its tables
	let budget = 6 * size + 4194304
	// budget * 1: a bare name before { would read as a struct literal.
	// commits and trees are written as zlib's stored blocks: copied out as they are, with no inflater (its tables and
	// buffers were most of a log's memory, #807)
	mut body = storedZlib(zbytes, size)
	if len(body) != size {
		body = limit memory budget * 1 {
			try squash.Unzlib(zbytes, size + 1)
		} catch err {
			fail fault.Wrap(ErrBadPack, "entry at {off}: {fault.Message(err)}")
		}
	}
	if baseOff < 0 {
		if len(body) != size {
			fail fault.Wrap(ErrBadPack, "entry at {off}: {len(body)} bytes, not {size}")
		}
		let kind = try kindOf(t)
		if depth > 0 {
			// the base of a delta: the next delta on it will want it again
			p.remember(off, kind, body)
		}
		return kind, body
	}
	let (kind, base) = try p.entryAt(baseOff, depth + 1)
	let out = try ApplyDelta(base, body, size)
	p.remember(off, kind, out)
	return kind, out
}

// cacheMost is how many bytes of decoded entries a pack keeps for the deltas read after them.
const cacheMost = 32 << 20

// remember keeps a decoded entry for the deltas that build on it, dropping the oldest past cacheMost: a delta chain
// is then decoded once, not once for every object on it.
fn (p mut Pack) remember(off i64, kind object.Kind, body str) {
	if len(body) > cacheMost / 8 {
		return
	}
	let (_, had) = p.cache[off]
	if had {
		return
	}
	p.cache[off] = keep(body)
	p.kinds[off] = kind
	p.order = append(p.order, off)
	p.held += len(body)
	mut drop = 0
	for p.held > cacheMost && drop < len(p.order) {
		let old = p.order[drop]
		let (b, ok) = p.cache[old]
		if ok {
			p.held -= len(b)
			delete(p.cache, old)
			delete(p.kinds, old)
		}
		drop += 1
	}
	if drop > 0 {
		p.order = p.order[drop:]
	}
}

// GetRaw is the object's kind and body, checked against its id.
fn (p mut Pack) GetRaw(id object.Id) !(object.Kind, str) {
	let pos = p.Find(id)
	if pos < 0 {
		fail fault.Wrap(ErrBadPack, "{id.Hex()} is not in {p.Path}")
	}
	let off = try p.offOf(pos)
	let (kind, body) = try p.entryAt(off, 0)
	if object.Hash(kind, body) != id {
		fail fault.Wrap(object.ErrCorrupt, "{id.Hex()} in {p.Path}: the content does not match the id")
	}
	return kind, body
}

// Get is the decoded object.
fn (p mut Pack) Get(id object.Id) !object.Object {
	let (kind, body) = try p.GetRaw(id)
	return try object.Decode(kind, body)
}

// PutRaw fails: a pack is written once, by Write.
fn (p mut Pack) PutRaw(kind object.Kind, body str) !object.Id {
	fail fault.Wrap(ErrBadPack, "{p.Path} is read-only")
}

// Put fails: a pack is written once, by Write.
fn (p mut Pack) Put(o object.Object) !object.Id {
	fail fault.Wrap(ErrBadPack, "{p.Path} is read-only")
}

// Deltas is how many entries are stored as deltas.
fn (p mut Pack) Deltas() i64 {
	p.load() catch _ {
		return 0
	}
	mut n = 0
	for i in 0..p.Count {
		let t = i64(p.data[p.off(i)])
		if t == typeOfsDelta || t == typeRefDelta {
			n += 1
		}
	}
	return n
}

// Verify checks the pack's hash, then reads every entry, checks its CRC and that its content matches its id.
fn (p mut Pack) Verify() ! {
	if str(seal.Sha256(p.idx[0:len(p.idx) - 32])) != p.idx[len(p.idx) - 32:] {
		fail fault.Wrap(ErrBadPack, "{p.Path}: its index's hash does not match")
	}
	for i in 1..p.Count {
		if !idBefore(p.idx, idsAt + 32 * (i - 1), idsAt + 32 * i) {
			fail fault.Wrap(ErrBadPack, "{p.Path}: its index's ids are not in order")
		}
	}
	try p.load()
	if str(seal.Sha256(p.data[0:len(p.data) - 32])) != p.data[len(p.data) - 32:] {
		fail fault.Wrap(ErrBadPack, "{p.Path}: its trailing hash does not match")
	}
	mut sorted = make([]i64, p.Count)
	for i in 0..p.Count {
		sorted[i] = try p.offOf(i)
	}
	sift.Sort(mut sorted)
	mut next = map[i64]i64{}
	for k in 0..len(sorted) {
		if k + 1 < len(sorted) {
			next[sorted[k]] = sorted[k + 1]
		} else {
			next[sorted[k]] = len(p.data) - 32
		}
	}
	for i in 0..p.Count {
		let id = p.IdAt(i)
		let off = p.off(i)
		let end = next[off]
		if stamp.Crc32(p.data[off:end]) != p.crc(i) {
			fail fault.Wrap(ErrBadPack, "{id.Hex()}: its CRC does not match")
		}
		let (_, _, err) = p.GetRaw(id)
		if err != nil {
			fail err
		}
	}
}

// entry is the stored form of the object at position pos: its entry type, its size, the offset of its base (an
// offset delta) or its base's id (a ref delta), and its compressed bytes, as they are in the pack.
fn (p mut Pack) entry(pos i64) !(i64, i64, i64, str, str) {
	try p.load()
	let off = try p.offOf(pos)
	let t = i64(p.data[off])
	let (size, a) = try p.uvarint(off + 1)
	mut at = a
	mut baseOff = -1
	mut baseId = ""
	if t == typeOfsDelta {
		let (dist, b) = try p.uvarint(at)
		baseOff = off - dist
		if dist <= 0 || baseOff < 20 {
			fail fault.Wrap(ErrBadPack, "a delta at {off} against no earlier entry")
		}
		at = b
	} else if t == typeRefDelta {
		if at + 32 > len(p.data) - 32 {
			fail fault.Wrap(ErrBadPack, "an entry runs past the end")
		}
		baseId = p.data[at:at + 32]
		at += 32
	}
	let (clen, c) = try p.uvarint(at)
	if c + clen > len(p.data) - 32 {
		fail fault.Wrap(ErrBadPack, "an entry runs past the end")
	}
	return t, size, baseOff, baseId, p.data[c:c + clen]
}
