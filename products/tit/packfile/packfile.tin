package packfile

import "../object"
import "fault"
import "flume"
import "quarry"
import "seal"
import "sift"
import "squash"
import "stamp"

// Packs and their indexes (design/tit.md section 6; #778). A pack holds many objects, some as deltas against an earlier
// entry (by distance back) or against an object by id; every entry records its compressed length. The index maps ids
// to entries through a fan-out table and a sorted list. A Pack is a read-only ObjectStore.

// ErrBadPack is the fault of a pack or index that breaks the format.
let ErrBadPack = fault("bad pack")

// MaxDeltaDepth is the longest delta chain a pack may hold.
const MaxDeltaDepth = 50

const typeBlob = 1
const typeTree = 2
const typeCommit = 3
const typeTag = 4
const typeOfsDelta = 8
const typeRefDelta = 9

fn typeOf(k object.Kind) i64 {
	return match k {
		Blob => typeBlob
		Tree => typeTree
		Commit => typeCommit
		Tag => typeTag
	}
}

fn kindOf(t i64) !object.Kind {
	if t == typeBlob {
		return object.Kind.Blob
	}
	if t == typeTree {
		return object.Kind.Tree
	}
	if t == typeCommit {
		return object.Kind.Commit
	}
	if t == typeTag {
		return object.Kind.Tag
	}
	fail fault.Wrap(ErrBadPack, "entry type {t}")
}

// Pack is an open pack with its index. Its bytes are read the first time an object of it is (a command that needs
// none of its objects reads only its index) and checked then against the hash the index names; every object read is
// checked against its id, and Verify checks the whole pack.
type Pack struct {
	Path    str
	Count   i64
	size    i64
	trailer str
	loaded  bool
	data    str
	// idx is the index file: its ids, offsets and CRCs are read from it where they are (#807: copying them out on
	// every open cost more than a status)
	idx str
	// ranged counts the entries read one by one (entrySpan); win is the last range of the file read for them, from
	// winAt, which holds the next entries too when they follow (one read for several, #807)
	ranged i64
	win    str
	winAt  i64
	fanout []i64
	cache  map[i64]str
	kinds  map[i64]object.Kind
	// order is the cached offsets, oldest first; held their bytes (at most cacheMax)
	order []i64
	held  i64
	// wholeMax is the largest pack read whole once many of its entries were read one by one, and cacheMax the bytes
	// of decoded entries kept: Budget lowers them for a reader within a memory budget
	wholeMax i64
	cacheMax i64
}

fn le32(s str, at i64) i64 {
	return i64(s[at]) | (i64(s[at + 1]) << 8) | (i64(s[at + 2]) << 16) | (i64(s[at + 3]) << 24)
}

fn le64(s str, at i64) i64 {
	return le32(s, at) | (le32(s, at + 4) << 32)
}

// readHead is the first n bytes of a file (fewer when it is shorter).
fn readHead(path str, n i64) !str {
	mut r = try flume.Open(path)
	mut buf = make([]u8, n)
	mut got = 0
	for got < n {
		let k = r.Read(mut buf[got:]) catch e {
			r.Close()
			fail e
		}
		if k == 0 {
			break
		}
		got += k
	}
	r.Close()
	return str(buf[0:got])
}

// Open opens the pack at path (ending in .pack) and its index (the same name ending in .idx), checking both.
fn Open(path str) !Pack {
	let info = try quarry.Lstat(path)
	let head = try readHead(path, 20)
	if info.Size < 20 + 32 || len(head) < 20 || head[0:8] != "TITPACK\x00" || le32(head, 8) != 1 {
		fail fault.Wrap(ErrBadPack, "{path}: not a version 1 pack")
	}
	let count = le64(head, 12)
	let idxPath = path[0:len(path) - 5] + ".idx"
	let idx = try quarry.ReadFileBound(idxPath, 1 << 40)
	let want = 8 + 4 + 8 + 1024 + count * 44 + 64
	if count < 0 || count > info.Size || len(idx) != want || idx[0:8] != "TITIDX\x00\x00" || le32(idx, 8) != 1 || le64(idx, 12) != count {
		fail fault.Wrap(ErrBadPack, "{idxPath}: not the index of this pack")
	}
	mut fanout = make([]i64, 256)
	mut prev = 0
	for i in 0..256 {
		fanout[i] = le32(idx, 20 + 4 * i)
		if fanout[i] < prev {
			fail fault.Wrap(ErrBadPack, "{idxPath}: the fan-out table goes down")
		}
		prev = fanout[i]
	}
	if fanout[255] != count {
		fail fault.Wrap(ErrBadPack, "{idxPath}: the fan-out table does not end at the count")
	}
	// The index's hash and the order of its ids are checked by Verify (tit verify), as git checks its own indexes
	// in fsck: an open reads only what it needs, and an offset is checked where it is used.
	return Pack{Path: path, Count: count, size: info.Size, trailer: idx[len(idx) - 64:len(idx) - 32], loaded: false, data: "", idx: idx, ranged: 0, win: "", winAt: 0, fanout: fanout, cache: map[i64]str{}, kinds: map[i64]object.Kind{}, order: []i64{}, held: 0, wholeMax: wholeMost, cacheMax: cacheMost}
}

// idsAt is where the ids start in an index: after its header (20 bytes) and fan-out table (1024).
const idsAt = 20 + 1024

// off is the offset in the pack of the entry at position i of the index.
fn (p Pack) off(i i64) i64 {
	return le64(p.idx, idsAt + 32 * p.Count + 8 * i)
}

// crc is the CRC-32 of the entry at position i.
fn (p Pack) crc(i i64) u32 {
	return u32(le32(p.idx, idsAt + 40 * p.Count + 4 * i))
}

// offOf is off, checked to lie inside the pack.
fn (p Pack) offOf(i i64) !i64 {
	let o = p.off(i)
	if o < 20 || o >= p.size - 32 {
		fail fault.Wrap(ErrBadPack, "{p.Path}: an offset outside the pack")
	}
	return o
}

// idBefore reports whether the 32-byte id at a in ids sorts before the one at b.
fn idBefore(ids str, a i64, b i64) bool {
	for k in 0..32 {
		if ids[a + k] != ids[b + k] {
			return ids[a + k] < ids[b + k]
		}
	}
	return false
}

// Find is the position of the object in the index, or -1.
fn (p Pack) Find(id object.Id) i64 {
	let raw = id.Bytes()
	let first = i64(raw[0])
	mut lo = 0
	if first > 0 {
		lo = p.fanout[first - 1]
	}
	mut hi = p.fanout[first]
	for lo < hi {
		let mid = (lo + hi) / 2
		// compared in place: a slice of the index would be a copy per step
		let at = idsAt + 32 * mid
		mut c = 0
		for k in 0..32 {
			if p.idx[at + k] != raw[k] {
				if p.idx[at + k] < raw[k] {
					c = -1
				} else {
					c = 1
				}
				break
			}
		}
		if c == 0 {
			return mid
		}
		if c < 0 {
			lo = mid + 1
		} else {
			hi = mid
		}
	}
	return -1
}

// Has reports whether the pack holds the object.
fn (p Pack) Has(id object.Id) bool {
	return p.Find(id) >= 0
}

// IdAt is the id of the object at position i of the index.
fn (p Pack) IdAt(i i64) object.Id {
	let id = object.IdOf(p.idx[idsAt + 32 * i:idsAt + 32 * i + 32]) catch _ {
		object.NoId
	}
	return id
}

// load reads the pack's bytes the first time they are needed, and checks them against the hash its index names.
fn (p mut Pack) load() ! {
	if p.loaded {
		return
	}
	let data = try p.readAll(p.size + 1)
	if len(data) != p.size || data[len(data) - 32:] != p.trailer || data[0:8] != "TITPACK\x00" {
		fail fault.Wrap(ErrBadPack, "{p.Path}: the pack does not match its index")
	}
	p.data = data
	p.loaded = true
}

fn (p Pack) uvarint(at i64) !(i64, i64) {
	if at >= len(p.data) - 32 {
		fail fault.Wrap(ErrBadPack, "an entry runs past the end")
	}
	let (v, n, ok) = uvarintAt(p.data, at, len(p.data) - 32)
	if !ok {
		fail fault.Wrap(ErrBadPack, "a bad varint at {at}")
	}
	if v > u64(1) << 40 {
		fail fault.Wrap(ErrBadPack, "a size too large at {at}")
	}
	return i64(v), at + n
}

// wholeUnder is the size under which a pack is read whole the first time an object of it is.
const wholeUnder = 256 << 10

// entrySpan is where the entry at off is, up to the next one: in the pack's bytes once they are read (s is p.data, the
// entry from off to off + n: #807, a slice would copy every entry), otherwise in that range of the file alone
// (quarry.ReadAt), from 0, so reading a few objects of a large pack reads a few entries of it.
fn (p mut Pack) entrySpan(off i64) !(str, i64, i64) {
	if off < 20 || off >= p.size - 32 {
		fail fault.Wrap(ErrBadPack, "no entry at {off}")
	}
	// a small pack, or one read entry by entry many times already, is read whole: one read beats many
	if !p.loaded && (p.size <= wholeUnder || (p.ranged >= 64 && p.size <= p.wholeMax)) {
		try p.load()
	}
	if p.loaded {
		let n = try entryLenIn(p.data, off, min(p.size - 32, off + maxHead))
		if off + n > p.size - 32 {
			fail fault.Wrap(ErrBadPack, "an entry runs past the end")
		}
		return p.data, off, off + n
	}
	// the entry's header says how long it is (#807: sorting every offset to find where one entry ends cost more than
	// a log -n 1): read a window from the entry on, then the rest when the window did not hold it
	p.ranged += 1
	let stop = p.size - 32
	let headEnd = min(stop, off + maxHead)
	if len(p.win) == 0 || off < p.winAt || headEnd > p.winAt + len(p.win) {
		p.win = try p.readAt(off, min(windowSize, stop - off))
		p.winAt = off
	}
	let n = try entryLenIn(p.win, off - p.winAt, min(headEnd, p.winAt + len(p.win)) - p.winAt)
	if off + n > stop {
		fail fault.Wrap(ErrBadPack, "an entry runs past the end")
	}
	if off + n > p.winAt + len(p.win) {
		p.win = try p.readAt(off, max(n, min(windowSize, stop - off)))
		p.winAt = off
		if len(p.win) < n {
			fail fault.Wrap(ErrBadPack, "{p.Path} is shorter than its index says")
		}
	}
	return p.win, off - p.winAt, off - p.winAt + n
}

// windowSize is how much of the file a read of one entry reads at first: most commits and trees fit, so one read
// takes the whole entry, and the next entry when it follows.
const windowSize = 4 << 10

// headAt is the first bytes of the entry at off, enough for its header.
fn (p mut Pack) headAt(off i64) !str {
	if off < 20 || off >= p.size - 32 {
		fail fault.Wrap(ErrBadPack, "no entry at {off}")
	}
	if p.loaded {
		return p.data[off:min(p.size - 32, off + maxHead)]
	}
	return try p.readAt(off, min(maxHead, p.size - 32 - off))
}

// KindAt is the kind of the object at position i of the index, from its entry's header, or a delta's from its
// base's: nothing is read past the headers or inflated, so sorting a pack's objects by kind reads none of their
// bodies (#778: repack read every object twice, once only for its kind).
fn (p mut Pack) KindAt(i i64) !object.Kind {
	mut off = try p.offOf(i)
	for depth in 0..MaxDeltaDepth + 1 {
		let h = try p.headAt(off)
		let t = i64(h[0])
		if t == typeOfsDelta {
			let (_, a) = try varintIn(h, 1)
			let (dist, _) = try varintIn(h, a)
			if dist <= 0 || off - dist < 20 {
				fail fault.Wrap(ErrBadPack, "a delta at {off} against no earlier entry")
			}
			off = off - dist
			continue
		}
		if t == typeRefDelta {
			let (_, a) = try varintIn(h, 1)
			if a + 32 > len(h) {
				fail fault.Wrap(ErrBadPack, "an entry runs past the end")
			}
			let baseId = try object.IdOf(h[a:a + 32])
			let pos = p.Find(baseId)
			if pos < 0 {
				fail fault.Wrap(ErrBadPack, "a delta at {off} against {baseId.Hex()}, which this pack lacks")
			}
			off = try p.offOf(pos)
			continue
		}
		return try kindOf(t)
	}
	fail fault.Wrap(ErrBadPack, "a delta chain longer than {MaxDeltaDepth}")
}

// maxHead is the most bytes an entry's header takes: its type, size, base (an offset or an id) and compressed length.
const maxHead = 1 + 10 + 32 + 10

// entryLenIn is the length of the entry whose first bytes are s[from:end]: its header and its compressed bytes.
fn entryLenIn(s str, from i64, end i64) !i64 {
	if end <= from {
		fail fault.Wrap(ErrBadPack, "an entry runs past the end")
	}
	let t = i64(s[from])
	let (_, a) = try varintTo(s, from + 1, end)
	mut at = a
	if t == typeOfsDelta {
		let (_, b) = try varintTo(s, at, end)
		at = b
	} else if t == typeRefDelta {
		at += 32
	}
	let (clen, c) = try varintTo(s, at, end)
	return c - from + clen
}

// storedZlibIn is the data of the zlib stream s[from:end] when it is made only of stored blocks, exactly size bytes,
// and its Adler-32 matches; otherwise "" (the caller inflates it, which also reports what is wrong with it). size 0 is
// never stored. The stream is read where it is: only the data is copied out (#807).
fn storedZlibIn(s str, from i64, end i64, size i64) str {
	let zn = end - from
	// the header: deflate with a 32 KiB window, no dictionary, a multiple of 31
	if size <= 0 || zn < 2 + 5 + 4 || (i64(s[from]) & 15) != 8 || (i64(s[from + 1]) & 32) != 0 || (i64(s[from]) * 256 + i64(s[from + 1])) % 31 != 0 {
		return ""
	}
	// one final block, as almost every commit and tree is: the body is a slice of the stream
	if i64(s[from + 2]) == 1 && zn == 2 + 5 + size + 4 {
		let n = i64(s[from + 3]) | (i64(s[from + 4]) << 8)
		let nn = i64(s[from + 5]) | (i64(s[from + 6]) << 8)
		if n == size && n ^ nn == 65535 {
			let at = from + 7 + n
			let sum = (u32(s[at]) << 24) | (u32(s[at + 1]) << 16) | (u32(s[at + 2]) << 8) | u32(s[at + 3])
			if adler32In(s, from + 7, at) == sum {
				return s[from + 7:at]
			}
			return ""
		}
	}
	mut out = make([]u8, 0, size)
	mut at = from + 2
	for {
		if at + 5 > end {
			return ""
		}
		let h = i64(s[at])
		// BTYPE 00 (stored) and nothing else in the header byte
		if (h >> 1) != 0 {
			return ""
		}
		let n = i64(s[at + 1]) | (i64(s[at + 2]) << 8)
		let nn = i64(s[at + 3]) | (i64(s[at + 4]) << 8)
		if n ^ nn != 65535 || at + 5 + n > end || len(out) + n > size {
			return ""
		}
		for k in 0..n {
			out = append(out, s[at + 5 + k])
		}
		at += 5 + n
		if h & 1 == 1 {
			break
		}
	}
	if at + 4 != end || len(out) != size {
		return ""
	}
	let body = str(out)
	let sum = (u32(s[at]) << 24) | (u32(s[at + 1]) << 16) | (u32(s[at + 2]) << 8) | u32(s[at + 3])
	if stamp.Adler32(body) != sum {
		return ""
	}
	return body
}

// adler32In is the Adler-32 of s[from:to], as stamp.Adler32 of that slice, read in place and four bytes a step (#807:
// it cost more than the SHA-256 that checks each object). The sums fit in 64 bits for up to 2^28 bytes between
// reductions (b grows by at most 255 * n * n / 2), so they are reduced once every 2^24 bytes.
@wrap fn adler32In(s str, from i64, to i64) u32 {
	mut a = u64(1)
	mut b = u64(0)
	mut i = from
	for i < to {
		let end = min(to, i + (1 << 24))
		for i + 4 <= end {
			let c0 = u64(s[i])
			let c1 = u64(s[i + 1])
			let c2 = u64(s[i + 2])
			let c3 = u64(s[i + 3])
			b = b + 4 * a + 4 * c0 + 3 * c1 + 2 * c2 + c3
			a = a + c0 + c1 + c2 + c3
			i += 4
		}
		for i < end {
			a = a + u64(s[i])
			b = b + a
			i += 1
		}
		a = a % 65521
		b = b % 65521
	}
	return u32(b << 16 | a)
}

// varintIn is the uvarint at e[at:] and where it ends, within e.
fn varintIn(e str, at i64) !(i64, i64) {
	return try varintTo(e, at, len(e))
}

// varintTo is the uvarint at s[at:] and where it ends, within the bytes before end.
fn varintTo(s str, at i64, end i64) !(i64, i64) {
	if at >= end {
		fail fault.Wrap(ErrBadPack, "an entry runs past its end")
	}
	let (v, n, ok) = uvarintAt(s, at, end)
	if !ok {
		fail fault.Wrap(ErrBadPack, "a bad varint")
	}
	if v > u64(1) << 40 {
		fail fault.Wrap(ErrBadPack, "a size too large")
	}
	return i64(v), at + n
}

// uvarintAt reads the uvarint at s[at:], within the bytes before end and at most ten of them, as pack.Uvarint reads it
// from that slice but in place (a slice and its []u8 were two copies a number): its value, its length, and false when
// it is cut off or overflows.
fn uvarintAt(s str, at i64, end i64) (u64, i64, bool) {
	let stop = min(end, at + 10)
	mut x = u64(0)
	mut sh = u64(0)
	mut i = at
	for i < stop {
		let c = s[i]
		if c < 0x80 {
			if i - at == 9 && c > 1 {
				return 0, 0, false
			}
			return x | (u64(c) << sh), i + 1 - at, true
		}
		x = x | (u64(c & 0x7f) << sh)
		sh += 7
		i += 1
	}
	return 0, 0, false
}

// entryAt reads the object at offset off, resolving deltas up to MaxDeltaDepth.
fn (p mut Pack) entryAt(off i64, depth i64) !(object.Kind, str) {
	if depth > MaxDeltaDepth {
		fail fault.Wrap(ErrBadPack, "a delta chain longer than {MaxDeltaDepth}")
	}
	let (cached, hit) = p.cache[off]
	if hit {
		return p.kinds[off], cached
	}
	let (e, from, end) = try p.entrySpan(off)
	let t = i64(e[from])
	let (size, a) = try varintTo(e, from + 1, end)
	mut baseOff = -1
	mut at = a
	if t == typeOfsDelta {
		let (dist, b) = try varintTo(e, at, end)
		baseOff = off - dist
		if dist <= 0 || baseOff < 20 {
			fail fault.Wrap(ErrBadPack, "a delta at {off} against no earlier entry")
		}
		at = b
	} else if t == typeRefDelta {
		if at + 32 > end {
			fail fault.Wrap(ErrBadPack, "an entry runs past the end")
		}
		let baseId = try object.IdOf(e[at:at + 32])
		let pos = p.Find(baseId)
		if pos < 0 {
			fail fault.Wrap(ErrBadPack, "a delta at {off} against {baseId.Hex()}, which this pack lacks")
		}
		baseOff = try p.offOf(pos)
		if baseOff == off {
			fail fault.Wrap(ErrBadPack, "a delta at {off} against itself")
		}
		at += 32
	}
	let (clen, c) = try varintTo(e, at, end)
	if c + clen > end {
		fail fault.Wrap(ErrBadPack, "an entry runs past the end")
	}
	// the inflater grows its output by doubling (the buffers it outgrows stay until the pool resets, less than 4 times
	// the size together) and copies the result once: 6 times the size, and room for its tables
	let budget = 6 * size + 4194304
	// budget * 1: a bare name before { would read as a struct literal.
	// commits and trees are written as zlib's stored blocks: copied out as they are, with no inflater (its tables and
	// buffers were most of a log's memory, #807)
	mut body = storedZlibIn(e, c, c + clen, size)
	if len(body) != size {
		let zbytes = e[c:c + clen]
		body = limit memory budget * 1 {
			try squash.Unzlib(zbytes, size + 1)
		} catch err {
			fail fault.Wrap(ErrBadPack, "entry at {off}: {fault.Message(err)}")
		}
	}
	if baseOff < 0 {
		if len(body) != size {
			fail fault.Wrap(ErrBadPack, "entry at {off}: {len(body)} bytes, not {size}")
		}
		let kind = try kindOf(t)
		if depth > 0 {
			// the base of a delta: the next delta on it will want it again
			p.remember(off, kind, body)
		}
		return kind, body
	}
	let (kind, base) = try p.entryAt(baseOff, depth + 1)
	let out = try ApplyDelta(base, body, size)
	p.remember(off, kind, out)
	return kind, out
}

// cacheMost is how many bytes of decoded entries a pack keeps for the deltas read after them.
const cacheMost = 32 << 20

// wholeMost is the largest pack read whole after many of its entries were read one by one.
const wholeMost = 256 << 20

// Budget fits the pack's reading to a memory budget of n bytes, for a reader that reads some objects within a `limit
// memory` (a tinhub request: 16 MiB): the pack is read whole only when it is under n / 4, and the decoded entries kept
// for deltas take at most n / 4. Otherwise a log of a large repository read the whole pack after 64 entries and
// failed with fault.LimitExceeded.
fn (p mut Pack) Budget(n i64) {
	p.wholeMax = min(wholeMost, n / 4)
	p.cacheMax = min(cacheMost, n / 4)
}

// remember keeps a decoded entry for the deltas that build on it, dropping the oldest past cacheMost: a delta chain
// is then decoded once, not once for every object on it.
fn (p mut Pack) remember(off i64, kind object.Kind, body str) {
	if len(body) > p.cacheMax / 8 {
		return
	}
	let (_, had) = p.cache[off]
	if had {
		return
	}
	p.cache[off] = body
	p.kinds[off] = kind
	p.order = append(p.order, off)
	p.held += len(body)
	mut drop = 0
	for p.held > p.cacheMax && drop < len(p.order) {
		let old = p.order[drop]
		let (b, ok) = p.cache[old]
		if ok {
			p.held -= len(b)
			delete(p.cache, old)
			delete(p.kinds, old)
		}
		drop += 1
	}
	if drop > 0 {
		p.order = p.order[drop:]
	}
}

// GetRaw is the object's kind and body, checked against its id.
fn (p mut Pack) GetRaw(id object.Id) !(object.Kind, str) {
	let pos = p.Find(id)
	if pos < 0 {
		fail fault.Wrap(ErrBadPack, "{id.Hex()} is not in {p.Path}")
	}
	let off = try p.offOf(pos)
	let (kind, body) = try p.entryAt(off, 0)
	if object.Hash(kind, body) != id {
		fail fault.Wrap(object.ErrCorrupt, "{id.Hex()} in {p.Path}: the content does not match the id")
	}
	return kind, body
}

// Get is the decoded object.
fn (p mut Pack) Get(id object.Id) !object.Object {
	let (kind, body) = try p.GetRaw(id)
	return try object.Decode(kind, body)
}

// PutRaw fails: a pack is written once, by Write.
fn (p mut Pack) PutRaw(kind object.Kind, body str) !object.Id {
	fail fault.Wrap(ErrBadPack, "{p.Path} is read-only")
}

// Put fails: a pack is written once, by Write.
fn (p mut Pack) Put(o object.Object) !object.Id {
	fail fault.Wrap(ErrBadPack, "{p.Path} is read-only")
}

// Deltas is how many entries are stored as deltas.
fn (p mut Pack) Deltas() i64 {
	p.load() catch _ {
		return 0
	}
	mut n = 0
	for i in 0..p.Count {
		let t = i64(p.data[p.off(i)])
		if t == typeOfsDelta || t == typeRefDelta {
			n += 1
		}
	}
	return n
}

// Verify checks the pack's hash, then reads every entry, checks its CRC and that its content matches its id.
fn (p mut Pack) Verify() ! {
	if str(seal.Sha256(p.idx[0:len(p.idx) - 32])) != p.idx[len(p.idx) - 32:] {
		fail fault.Wrap(ErrBadPack, "{p.Path}: its index's hash does not match")
	}
	for i in 1..p.Count {
		if !idBefore(p.idx, idsAt + 32 * (i - 1), idsAt + 32 * i) {
			fail fault.Wrap(ErrBadPack, "{p.Path}: its index's ids are not in order")
		}
	}
	try p.load()
	if str(seal.Sha256(p.data[0:len(p.data) - 32])) != p.data[len(p.data) - 32:] {
		fail fault.Wrap(ErrBadPack, "{p.Path}: its trailing hash does not match")
	}
	mut sorted = make([]i64, p.Count)
	for i in 0..p.Count {
		sorted[i] = try p.offOf(i)
	}
	sift.Sort(mut sorted)
	mut next = map[i64]i64{}
	for k in 0..len(sorted) {
		if k + 1 < len(sorted) {
			next[sorted[k]] = sorted[k + 1]
		} else {
			next[sorted[k]] = len(p.data) - 32
		}
	}
	for i in 0..p.Count {
		let id = p.IdAt(i)
		let off = p.off(i)
		let end = next[off]
		if stamp.Crc32(p.data[off:end]) != p.crc(i) {
			fail fault.Wrap(ErrBadPack, "{id.Hex()}: its CRC does not match")
		}
		let (_, _, err) = p.GetRaw(id)
		if err != nil {
			fail err
		}
	}
}

// stored is where the object at position pos is, as it is in the pack: its entry type, its size, the offset of its base
// (an offset delta) or its base's id (a ref delta), and the offset and length of its compressed bytes. Only the entry's
// header is read: a fetch copies the compressed bytes from the file a window at a time (ReuseTo, #1076).
fn (p mut Pack) stored(pos i64) !(i64, i64, i64, str, i64, i64) {
	let off = try p.offOf(pos)
	let h = try p.headAt(off)
	let t = i64(h[0])
	let (size, a) = try varintTo(h, 1, len(h))
	mut at = a
	mut baseOff = -1
	mut baseId = ""
	if t == typeOfsDelta {
		let (dist, b) = try varintTo(h, at, len(h))
		baseOff = off - dist
		if dist <= 0 || baseOff < 20 {
			fail fault.Wrap(ErrBadPack, "a delta at {off} against no earlier entry")
		}
		at = b
	} else if t == typeRefDelta {
		if at + 32 > len(h) {
			fail fault.Wrap(ErrBadPack, "an entry runs past the end")
		}
		baseId = h[at:at + 32]
		at += 32
	}
	let (clen, c) = try varintTo(h, at, len(h))
	if off + c + clen > p.size - 32 {
		fail fault.Wrap(ErrBadPack, "an entry runs past the end")
	}
	return t, size, baseOff, baseId, off + c, clen
}
