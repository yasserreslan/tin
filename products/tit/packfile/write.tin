package packfile

import "../cores"
import "../crash"
import "../object"
import "../store"
import "fault"
import "flume"
import "quarry"
import "seal"
import "sift"
import "squash"
import "stamp"

// Writing a pack (#778): objects are ordered by kind and size, each tries the previous few of its kind as a delta
// base (a delta must be under half the object to be used, and chains stay within MaxDeltaDepth), and the pack and its
// index are written to temporary files, synced and renamed to the pack's hash.

const window = 10

type item struct {
	id    object.Id
	kind  object.Kind
	body  str
	base  i64
	delta str
	depth i64
}

// Write packs the objects of ids from s into dir, and returns the open pack.
fn Write[S store.ObjectStore](s mut S, ids []object.Id, dir str) !Pack {
	mut seen = map[str]bool{}
	mut items = []item{}
	for id in ids {
		if seen[id.Bytes()] {
			continue
		}
		seen[id.Bytes()] = true
		let (kind, body) = try s.GetRaw(id)
		items = append(items, item{id: id, kind: kind, body: body, base: -1, delta: "", depth: 0})
	}
	sift.SortStableFunc(mut items, fn(a item, b item) i64 {
		let ta = typeOf(a.kind)
		let tb = typeOf(b.kind)
		if ta != tb {
			return ta - tb
		}
		return len(b.body) - len(a.body)
	})
	// delta search on every core (tit/cores): each object against the window before it of its kind, then the bases
	// taken in order, so a chain stays within MaxDeltaDepth. Objects over 16 MiB are not searched (a delta of such
	// files is slow to find, and they are kept in chunks anyway).
	mut bodies = make([]str, len(items))
	mut kinds = make([]i64, len(items))
	for i in 0..len(items) {
		bodies[i] = items[i].body
		kinds[i] = typeOf(items[i].kind)
	}
	let (which, deltas) = cores.WindowDeltas(bodies, kinds, window)
	for i in 0..len(items) {
		let j = which[i]
		if j < 0 || j >= i || items[j].depth >= MaxDeltaDepth {
			continue
		}
		items[i].base = j
		items[i].delta = deltas[i]
		items[i].depth = items[j].depth + 1
	}
	// every entry compressed on every core: commits and trees stored (zlib's stored blocks: they shrink little, a tree
	// being mostly ids, and a walk or a log inflates thousands of them, #807), blobs and deltas compressed
	mut payloads = make([]str, len(items))
	mut levels = make([]i64, len(items))
	for i in 0..len(items) {
		if items[i].base >= 0 {
			payloads[i] = items[i].delta
			levels[i] = squash.Default
		} else {
			payloads[i] = items[i].body
			levels[i] = squash.Default
			if items[i].kind != object.Kind.Blob {
				levels[i] = 0
			}
		}
	}
	let zs = cores.Compress(payloads, levels)
	try quarry.MkdirAll(dir)
	let tmp = dir + "/tmp-" + seal.Hex(seal.RandomBytes(8))
	mut out = []u8{}
	appendStr(mut out, "TITPACK\x00")
	appendLE32(mut out, 1)
	appendLE64(mut out, len(items))
	mut offs = make([]i64, len(items))
	mut crcs = make([]u32, len(items))
	for i in 0..len(items) {
		let off = len(out)
		offs[i] = off
		mut e = []u8{}
		if items[i].base >= 0 {
			e = append(e, u8(typeOfsDelta))
			appendUv(mut e, len(items[i].body))
			appendUv(mut e, off - offs[items[i].base])
		} else {
			e = append(e, u8(typeOf(items[i].kind)))
			appendUv(mut e, len(items[i].body))
		}
		let z = zs[i]
		appendUv(mut e, len(z))
		appendStr(mut e, z)
		crcs[i] = stamp.Crc32(str(e))
		out = append(out, e...)
	}
	appendStr(mut out, str(seal.Sha256(str(out))))
	mut packed = make([]object.Id, 0, len(items))
	for it in items {
		packed = append(packed, it.id)
	}
	return try finish(dir, tmp, str(out), packed, offs, crcs)
}

// finish writes a pack (its bytes, trailing hash included) and its index: the ids sorted, with their offsets and CRCs;
// both go to temporary files, synced, then renamed to the pack's hash.
fn finish(dir str, tmp str, pack str, ids []object.Id, offs []i64, crcs []u32) !Pack {
	try writeSynced(tmp + ".pack", pack)
	return try install(dir, tmp, pack[len(pack) - 32:], ids, offs, crcs)
}

// install writes the index of the pack written and synced at tmp.pack, whose trailing hash is sum, and renames both
// to the pack's hash (Merge writes its pack a piece at a time, then installs it as finish does).
fn install(dir str, tmp str, sum str, ids []object.Id, offs []i64, crcs []u32) !Pack {
	let hex = seal.Hex([]u8(sum))
	mut order = make([]i64, 0, len(ids))
	for i in 0..len(ids) {
		order = append(order, i)
	}
	sift.SortFunc(mut order, fn(a i64, b i64) i64 {
		let x = ids[a].Bytes()
		let y = ids[b].Bytes()
		if x < y {
			return -1
		}
		if x > y {
			return 1
		}
		return 0
	})
	mut idx = []u8{}
	appendStr(mut idx, "TITIDX\x00\x00")
	appendLE32(mut idx, 1)
	appendLE64(mut idx, len(ids))
	mut counts = make([]i64, 256)
	for i in order {
		counts[i64(ids[i].Bytes()[0])] += 1
	}
	mut total = 0
	for b in 0..256 {
		total += counts[b]
		appendLE32(mut idx, total)
	}
	for i in order {
		appendStr(mut idx, ids[i].Bytes())
	}
	for i in order {
		appendLE64(mut idx, offs[i])
	}
	for i in order {
		appendLE32(mut idx, i64(crcs[i]))
	}
	appendStr(mut idx, sum)
	appendStr(mut idx, str(seal.Sha256(str(idx))))
	try writeSynced(tmp + ".idx", str(idx))
	let final = dir + "/" + hex
	crash.Point()
	try quarry.Rename(tmp + ".idx", final + ".idx")
	crash.Point()
	try quarry.Rename(tmp + ".pack", final + ".pack")
	try quarry.Sync(dir)
	return try Open(final + ".pack")
}

fn writeSynced(path str, data str) ! {
	mut w = try flume.CreateExcl(path)
	w.Str(data)
	let err = w.Sync()
	try w.Close()
	if err != nil {
		fail err
	}
}

fn appendStr(out mut []u8, s str) {
	for i in 0..len(s) {
		out = append(out, s[i])
	}
}

fn appendUv(out mut []u8, v i64) {
	appendUvarint(mut out, u64(v))
}

fn appendLE32(out mut []u8, v i64) {
	out = append(out, u8(v & 255), u8((v >> 8) & 255), u8((v >> 16) & 255), u8((v >> 24) & 255))
}

fn appendLE64(out mut []u8, v i64) {
	appendLE32(mut out, v & 0xffffffff)
	appendLE32(mut out, (v >> 32) & 0xffffffff)
}
