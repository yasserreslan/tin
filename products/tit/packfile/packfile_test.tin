package packfile

import "../object"
import "../store"
import "crucible"
import "dice"
import "fault"
import "pack"
import "quarry"
import "seal"
import "sift"
import "squash"
import "stamp"
import "tide"

// Tests for packs (#778): deltas, a write and read round trip with deltas, and hand-built hostile packs.

fn TestDelta(t mut crucible.T) {
	mut r = dice.New(8)
	mut bad = 0
	mut used = 0
	for round in 0..300 {
		let base = str(r.Bytes(200 + r.Intn(3000)))
		mut tb = []u8(base)
		for e in 0..r.Intn(6) {
			let at = r.Intn(len(tb))
			if r.Intn(2) == 0 {
				tb[at] = u8(r.Intn(256))
			} else {
				mut grown = []u8{}
				grown = append(grown, tb[0:at]...)
				grown = append(grown, r.Bytes(1 + r.Intn(40))...)
				grown = append(grown, tb[at:]...)
				tb = grown
			}
		}
		let target = str(tb)
		let d = MakeDelta(base, target)
		if len(d) == 0 {
			continue
		}
		used += 1
		let back = ApplyDelta(base, d, len(target)) catch _ {
			"?"
		}
		if back != target {
			bad += 1
		}
	}
	crucible.Equal(mut t, "deltas that do not rebuild their target", bad, 0)
	t.True("most similar pairs get a delta", used > 250)
	crucible.Equal(mut t, "unrelated data gets none", MakeDelta(str(r.Bytes(1000)), str(r.Bytes(1000))), "")
	let (_, e1) = ApplyDelta("abc", "\x05\x03", 10)
	t.HasFault("wrong base size", e1)
	let (_, e2) = ApplyDelta("abcdef", "\x06\x03\x01\x04\x05", 10)
	t.HasFault("a copy outside the base", e2)
	let (_, e3) = ApplyDelta("abcdef", "\x06\x09\x01\x00\x03", 5)
	t.HasFault("a result over the bound", e3)
	let (_, e4) = ApplyDelta("abcdef", "\x06\x03\x07", 10)
	t.HasFault("an unknown op", e4)
}

fn fresh(name str) str {
	let d = "/tmp/tin-test-tit-pack-" + name + "-" + seal.Hex(seal.RandomBytes(4))
	quarry.RemoveAll(d) catch _ {
	}
	return d
}

fn TestRoundTrip(t mut crucible.T) {
	mut r = dice.New(2)
	mut s = store.NewMem()
	mut ids = []object.Id{}
	mut text = str(r.Bytes(4000))
	for i in 0..120 {
		// each version of the file edits the last one: deltas
		let at = r.Intn(len(text) - 10)
		text = text[0:at] + "edit {i}" + text[at + 5:]
		let id = s.PutRaw(object.Kind.Blob, text) catch _ {
			object.NoId
		}
		ids = append(ids, id)
		let tree = s.Put(object.Object.Tree([]object.Entry{object.Entry{Mode: object.Mode.File, Name: "f{i}", Id: id}})) catch _ {
			object.NoId
		}
		ids = append(ids, tree)
	}
	let small = s.PutRaw(object.Kind.Blob, "tiny") catch _ {
		object.NoId
	}
	ids = append(ids, small)
	let d = fresh("rt")
	mut p = Write(mut s, ids, d) catch err {
		t.Error("write: {fault.Message(err)}")
		return
	}
	crucible.Equal(mut t, "count", p.Count, 241)
	t.True("deltas used", p.Deltas() > 100)
	mut wrong = 0
	for id in ids {
		let (k1, b1, e1) = p.GetRaw(id)
		let (k2, b2, e2) = s.GetRaw(id)
		if e1 != nil || e2 != nil || k1 != k2 || b1 != b2 {
			wrong += 1
		}
	}
	crucible.Equal(mut t, "objects read back wrong", wrong, 0)
	t.NoFault("verify", p.Verify())
	t.False("an absent object", p.Has(object.Hash(object.Kind.Blob, "absent")))
	let reopened = Open(p.Path) catch err {
		t.Error("reopen: {fault.Message(err)}")
		return
	}
	crucible.Equal(mut t, "reopened count", reopened.Count, 241)
	quarry.RemoveAll(d) catch _ {
	}
}

// build writes a pack of raw entries (each the bytes after its offset) with a correct index for ids, and opens it.
fn build(dir str, entries []str, ids []object.Id) !Pack {
	mut out = []u8{}
	appendStr(mut out, "TITPACK\x00")
	appendLE32(mut out, 1)
	appendLE64(mut out, len(entries))
	mut offs = []i64{}
	mut crcs = []u32{}
	for e in entries {
		offs = append(offs, len(out))
		crcs = append(crcs, stamp.Crc32(e))
		appendStr(mut out, e)
	}
	let sum = str(seal.Sha256(str(out)))
	appendStr(mut out, sum)
	mut order = []i64{}
	for i in 0..len(ids) {
		order = append(order, i)
	}
	sift.SortFunc(mut order, fn(a i64, b i64) i64 {
		if ids[a].Bytes() < ids[b].Bytes() {
			return -1
		}
		return 1
	})
	mut idx = []u8{}
	appendStr(mut idx, "TITIDX\x00\x00")
	appendLE32(mut idx, 1)
	appendLE64(mut idx, len(ids))
	mut counts = make([]i64, 256)
	for i in order {
		counts[i64(ids[i].Bytes()[0])] += 1
	}
	mut total = 0
	for b in 0..256 {
		total += counts[b]
		appendLE32(mut idx, total)
	}
	for i in order {
		appendStr(mut idx, ids[i].Bytes())
	}
	for i in order {
		appendLE64(mut idx, offs[i])
	}
	for i in order {
		appendLE32(mut idx, i64(crcs[i]))
	}
	appendStr(mut idx, sum)
	appendStr(mut idx, str(seal.Sha256(str(idx))))
	try quarry.MkdirAll(dir)
	try quarry.WriteFile(dir + "/h.pack", str(out))
	try quarry.WriteFile(dir + "/h.idx", str(idx))
	return try Open(dir + "/h.pack")
}

fn whole(kind i64, body str) str {
	mut e = []u8{u8(kind)}
	appendUv(mut e, len(body))
	let z = squash.Zlib(body, 6)
	appendUv(mut e, len(z))
	appendStr(mut e, z)
	return str(e)
}

fn refDelta(size i64, base object.Id, delta str) str {
	mut e = []u8{u8(typeRefDelta)}
	appendUv(mut e, size)
	appendStr(mut e, base.Bytes())
	let z = squash.Zlib(delta, 6)
	appendUv(mut e, len(z))
	appendStr(mut e, z)
	return str(e)
}

fn ofsDelta(size i64, dist i64, delta str) str {
	mut e = []u8{u8(typeOfsDelta)}
	appendUv(mut e, size)
	appendUv(mut e, dist)
	let z = squash.Zlib(delta, 6)
	appendUv(mut e, len(z))
	appendStr(mut e, z)
	return str(e)
}

// readsAll builds a pack of entries and reads every object; false at the first fault.
fn readsAll(dir str, entries []str, ids []object.Id) bool {
	mut p = build(dir, entries, ids) catch _ {
		return false
	}
	for id in ids {
		let (_, _, err) = p.GetRaw(id)
		if err != nil {
			return false
		}
	}
	return true
}

fn TestHostile(t mut crucible.T) {
	let d = fresh("hostile")
	let a = object.Hash(object.Kind.Blob, "aaaa")
	// a delta against itself
	mut p1 = build(d + "/1", []str{refDelta(4, a, "\x04\x04\x00\x04aaaa")}, []object.Id{a}) catch err {
		t.Error("build 1: {fault.Message(err)}")
		return
	}
	let (_, _, e1) = p1.GetRaw(a)
	t.HasFault("a delta against itself", e1)
	// a delta against an object the pack lacks
	let other = object.Hash(object.Kind.Blob, "other")
	mut p2 = build(d + "/2", []str{refDelta(4, other, "\x05\x04\x00\x04aaaa")}, []object.Id{a}) catch err {
		t.Error("build 2: {fault.Message(err)}")
		return
	}
	let (_, _, e2) = p2.GetRaw(a)
	t.HasFault("a missing base", e2)
	// a whole entry whose size lies
	mut p3 = build(d + "/3", []str{whole(typeBlob, "aaaaa")}, []object.Id{a}) catch err {
		t.Error("build 3: {fault.Message(err)}")
		return
	}
	let (_, _, e3) = p3.GetRaw(a)
	t.HasFault("a lying size", e3)
	// a chain of 60 deltas, each copying the one before
	mut entries = []str{whole(typeBlob, "xxxx")}
	for i in 0..60 {
		entries = append(entries, ofsDelta(4, len(entries[len(entries) - 1]), "\x04\x04\x01\x00\x04"))
	}
	let last = object.Hash(object.Kind.Blob, "xxxx")
	mut chainIds = []object.Id{}
	for i in 0..len(entries) {
		chainIds = append(chainIds, object.Hash(object.Kind.Blob, "chain {i}"))
	}
	chainIds[len(chainIds) - 1] = last
	mut p4 = build(d + "/4", entries, chainIds) catch err {
		t.Error("build 4: {fault.Message(err)}")
		return
	}
	let (_, _, e4) = p4.GetRaw(last)
	t.True("a chain past the depth bound", e4 != nil && fault.Is(e4, ErrBadPack))
	// two deltas, each against the other: a cycle
	let b4 = object.Hash(object.Kind.Blob, "bbbb")
	mut p5 = build(d + "/5", []str{refDelta(4, b4, "\x04\x04\x00\x04aaaa"), refDelta(4, a, "\x04\x04\x00\x04bbbb")}, []object.Id{a, b4}) catch err {
		t.Error("build 5: {fault.Message(err)}")
		return
	}
	let (_, _, e5) = p5.GetRaw(a)
	t.HasFault("a delta cycle", e5)
	let (_, _, e5b) = p5.GetRaw(b4)
	t.HasFault("a delta cycle from the other end", e5b)
	// a delta whose result is larger than its entry declares
	let x4 = object.Hash(object.Kind.Blob, "xxxx")
	let a5 = object.Hash(object.Kind.Blob, "aaaaa")
	mut p6 = build(d + "/6", []str{whole(typeBlob, "xxxx"), refDelta(4, x4, "\x04\x05\x00\x05aaaaa")}, []object.Id{x4, a5}) catch err {
		t.Error("build 6: {fault.Message(err)}")
		return
	}
	let (_, _, e6) = p6.GetRaw(a5)
	t.HasFault("a result larger than declared", e6)
	// a chain of 10,000 deltas: refused at the depth bound, quickly and without deep recursion
	mut long = []str{whole(typeBlob, "xxxx")}
	for i in 0..10000 {
		long = append(long, ofsDelta(4, len(long[len(long) - 1]), "\x04\x04\x01\x00\x04"))
	}
	mut longIds = []object.Id{}
	for i in 0..len(long) {
		longIds = append(longIds, object.Hash(object.Kind.Blob, "long {i}"))
	}
	longIds[len(longIds) - 1] = last
	mut p7 = build(d + "/7", long, longIds) catch err {
		t.Error("build 7: {fault.Message(err)}")
		return
	}
	let t0 = tide.Now()
	let (_, _, e7) = p7.GetRaw(last)
	t.True("a chain of 10,000 deltas is refused", e7 != nil && fault.Is(e7, ErrBadPack))
	t.True("within a second", tide.Now() - t0 < 1000000000)
	mut m7 = store.NewMem()
	let data7 = quarry.ReadFile(p7.Path) catch _ {
		""
	}
	let (_, u7) = Unpack(data7, mut m7, 1 << 20)
	t.HasFault("unpacking the chain of 10,000", u7)
	// every byte of a small pack's entries damaged (with the hashes fixed up): faults, never panics
	let good = []str{whole(typeBlob, "some content here"), refDelta(18, object.Hash(object.Kind.Blob, "some content here"), "\x11\x12\x01\x00\x11\x00\x01!")}
	let goodIds = []object.Id{object.Hash(object.Kind.Blob, "some content here"), object.Hash(object.Kind.Blob, "some content here!")}
	mut panics = 0
	for which in 0..2 {
		for i in 0..len(good[which]) {
			mut damaged = []str{good[0], good[1]}
			mut b = []u8(good[which])
			b[i] = b[i] ^ 0x41
			damaged[which] = str(b)
			let ok = guard {
				readsAll(d + "/m", damaged, goodIds)
			} catch err {
				if fault.Is(err, fault.Panic) {
					panics += 1
				}
				false
			}
			_ = ok
			quarry.RemoveAll(d + "/m") catch _ {
			}
		}
	}
	crucible.Equal(mut t, "panics on damaged entries", panics, 0)
	quarry.RemoveAll(d) catch _ {
	}
}

// A large file that compresses well is read back: the reader's memory budget allows for the inflater growing its
// output by doubling (a 2.3 MB roadmap compressing 9 to 1 failed adopting the Tin repo, #789).
fn TestLargeCompressible(t mut crucible.T) {
	mut s = store.NewMem()
	mut b = make([]u8, 0, 2400000)
	mut i = 0
	for len(b) < 2331597 {
		b = append(b, []u8("- [x] item {i}: done on 2026-10-{i % 28 + 1}, see #{i * 7 % 900}\n")...)
		i += 1
	}
	let big = s.PutRaw(object.Kind.Blob, str(b)) catch _ {
		object.NoId
	}
	let d = fresh("large")
	mut p = Write(mut s, []object.Id{big}, d) catch e {
		t.Error("write: {e}")
		return
	}
	t.NoFault("verify", p.Verify())
	let (_, body, err) = p.GetRaw(big)
	t.NoFault("read", err)
	crucible.Equal(mut t, "the same bytes", len(body), len(b))
	quarry.RemoveAll(d) catch _ {
	}
}

// A pack's bytes alone, with no index, unpack into another store with every object (#796); damage is refused.
fn TestUnpack(t mut crucible.T) {
	mut s = store.NewMem()
	mut ids = []object.Id{}
	mut text = ""
	for i in 0..200 {
		text = text + "line {i}\n"
	}
	for i in 0..20 {
		text = text[0:i * 9] + "edit {i}\n" + text[i * 9:]
		let id = s.PutRaw(object.Kind.Blob, text) catch _ {
			object.NoId
		}
		ids = append(ids, id)
	}
	let d = fresh("unpack")
	let p = Write(mut s, ids, d) catch e {
		t.Error("write: {e}")
		return
	}
	t.True("deltas were made", p.Deltas() > 0)
	let data = quarry.ReadFile(p.Path) catch _ {
		""
	}
	mut other = store.NewMem()
	let got = Unpack(data, mut other, 1 << 20) catch e {
		t.Error("unpack: {e}")
		return
	}
	crucible.Equal(mut t, "every object", len(got), len(ids))
	for id in ids {
		t.True("present: " + id.Hex(), other.Has(id))
	}
	mut cut = store.NewMem()
	let (_, err) = Unpack(data[0:len(data) - 40] + data[len(data) - 32:], mut cut, 1 << 20)
	t.True("a cut pack", err != nil)
	mut small = store.NewMem()
	let (_, lerr) = Unpack(data, mut small, 100)
	t.True("objects over the limit", lerr != nil && fault.Is(lerr, fault.LimitExceeded))
	quarry.RemoveAll(d) catch _ {
	}
}

// Reuse sends packed entries as they are (#778): every object comes back from Unpack with its content, whether its
// delta base is sent (a delta by id), not sent (whole), or the object is only loose.
fn TestReuse(t mut crucible.T) {
	let d = fresh("reuse")
	mut s = store.NewMem()
	mut ids = []object.Id{}
	mut text = ""
	for i in 0..40 {
		text = text + "line {i} of a file that grows a line at a time, so each version deltas well against the last\n"
		let id = s.PutRaw(object.Kind.Blob, text) catch _ {
			object.NoId
		}
		ids = append(ids, id)
	}
	mut p = Write(mut s, ids, d + "/pack") catch e {
		t.Error("write: {e}")
		return
	}
	t.True("the pack has deltas", p.Deltas() > 0)
	let lone = s.PutRaw(object.Kind.Blob, "only loose\n") catch _ {
		object.NoId
	}
	mut packs = []Pack{p}
	let cases = [][]object.Id{ids, ids[30:], []object.Id{ids[5], lone}}
	for k in 0..len(cases) {
		let data = Reuse(mut s, mut packs, cases[k]) catch e {
			t.Error("reuse {k}: {e}")
			return
		}
		mut m = store.NewMem()
		let got = Unpack(data, mut m, 1 << 20) catch e {
			t.Error("unpack {k}: {e}")
			return
		}
		crucible.Equal(mut t, "objects ({k})", len(got), len(cases[k]))
		for id in cases[k] {
			let (_, want) = s.GetRaw(id) catch _ {
				return
			}
			let (_, have) = m.GetRaw(id) catch _ {
				t.Error("{id.Hex()} missing ({k})")
				return
			}
			t.True("content ({k})", have == want)
		}
	}
	quarry.RemoveAll(d) catch _ {
	}
}

// Reuse sends an entry larger than its window from the pack's file a window at a time (#1076): a blob of 3 MiB that
// does not compress, and the small objects around it, come back from Unpack with their content.
fn TestReuseLarge(t mut crucible.T) {
	let d = fresh("reuselarge")
	mut s = store.NewMem()
	mut big = make([]u8, 3 << 20)
	mut x = u64(88172645463325252)
	for i in 0..len(big) {
		x = x ^ (x << 13)
		x = x ^ (x >> 7)
		x = x ^ (x << 17)
		big[i] = u8(x & 0xff)
	}
	mut ids = []object.Id{}
	for body in []str{"before\n", str(big), "after\n"} {
		let id = s.PutRaw(object.Kind.Blob, body) catch _ {
			object.NoId
		}
		ids = append(ids, id)
	}
	let p = Write(mut s, ids, d + "/pack") catch e {
		t.Error("write: {e}")
		return
	}
	t.True("the pack holds the blob", p.size > 3 << 20)
	mut packs = []Pack{p}
	let data = Reuse(mut s, mut packs, ids) catch e {
		t.Error("reuse: {e}")
		return
	}
	mut m = store.NewMem()
	let got = Unpack(data, mut m, 4 << 20) catch e {
		t.Error("unpack: {e}")
		return
	}
	crucible.Equal(mut t, "objects", len(got), len(ids))
	for id in ids {
		let (_, want) = s.GetRaw(id) catch _ {
			return
		}
		let (_, have) = m.GetRaw(id) catch _ {
			t.Error("{id.Hex()} missing")
			return
		}
		t.True("content", have == want)
	}
	quarry.RemoveAll(d) catch _ {
	}
}

// Keep writes a received pack as it is and indexes it (#795): every object reads back from it with its content, the
// pack verifies, and a damaged or cut pack is refused with nothing written.
fn TestKeep(t mut crucible.T) {
	let d = fresh("keep")
	mut s = store.NewMem()
	mut ids = []object.Id{}
	mut text = ""
	for i in 0..60 {
		text = text + "line {i} of a file that grows a line at a time, so each version deltas well against the last\n"
		let id = s.PutRaw(object.Kind.Blob, text) catch _ {
			object.NoId
		}
		ids = append(ids, id)
	}
	let p0 = Write(mut s, ids, d + "/src") catch e {
		t.Error("write: {e}")
		return
	}
	mut packs = []Pack{p0}
	let data = Reuse(mut s, mut packs, ids) catch e {
		t.Error("reuse: {e}")
		return
	}
	mut p = Keep(data, d + "/kept", 1 << 20) catch e {
		t.Error("keep: {e}")
		return
	}
	crucible.Equal(mut t, "count", p.Count, len(ids))
	for id in ids {
		let (_, want) = s.GetRaw(id) catch _ {
			return
		}
		let (_, have) = p.GetRaw(id) catch e {
			t.Error("{id.Hex()}: {e}")
			return
		}
		t.True("content", have == want)
	}
	let verr = p.Verify()
	t.True("the pack verifies", verr == nil)
	mut b = []u8(data)
	b[len(b) / 2] = b[len(b) / 2] ^ 0x41
	let (_, e1) = Keep(str(b), d + "/bad", 1 << 20)
	t.HasFault("a damaged pack", e1)
	let (_, e2) = Keep(data[0:len(data) / 2], d + "/cut", 1 << 20)
	t.HasFault("a cut pack", e2)
	t.True("nothing written for them", !quarry.Exists(d + "/bad") && !quarry.Exists(d + "/cut"))
	quarry.RemoveAll(d) catch _ {
	}
}

// Merge joins packs into one (#807): every object reads back from it with its content, an object two packs hold is
// copied once, the deltas stay deltas, the pack verifies, the same packs merge into the same pack, and a damaged pack
// is refused with nothing left behind.
fn TestMerge(t mut crucible.T) {
	let d = fresh("merge")
	mut s = store.NewMem()
	mut all = []object.Id{}
	mut text = ""
	for i in 0..70 {
		text = text + "line {i} of a file that grows a line at a time, so each version deltas well against the last\n"
		let id = s.PutRaw(object.Kind.Blob, text) catch _ {
			object.NoId
		}
		all = append(all, id)
	}
	let tree = s.Put(object.Object.Tree([]object.Entry{object.Entry{Mode: object.Mode.File, Name: "f", Id: all[0]}})) catch _ {
		object.NoId
	}
	mut paths = []str{}
	mut deltas = 0
	for part in [][]object.Id{all[0:40], all[30:70], []object.Id{tree}} {
		mut p = Write(mut s, part, d) catch e {
			t.Error("write: {e}")
			return
		}
		deltas += p.Deltas()
		paths = append(paths, p.Path)
	}
	mut m = Merge(paths, d) catch e {
		t.Error("merge: {e}")
		return
	}
	crucible.Equal(mut t, "count", m.Count, 71)
	t.True("the deltas stay deltas", m.Deltas() > 0 && m.Deltas() <= deltas)
	for id in all {
		let (_, want) = s.GetRaw(id) catch _ {
			return
		}
		let (_, have) = m.GetRaw(id) catch e {
			t.Error("{id.Hex()}: {e}")
			return
		}
		t.True("content", have == want)
	}
	let (tk, _, terr) = m.GetRaw(tree)
	t.True("the tree", terr == nil && tk == object.Kind.Tree)
	t.NoFault("verify", m.Verify())
	t.True("the packs merged are left", quarry.Exists(paths[0]) && quarry.Exists(paths[1]) && quarry.Exists(paths[2]))
	let again = Merge(paths, d) catch e {
		t.Error("merge again: {e}")
		return
	}
	crucible.Equal(mut t, "the same packs make the same pack", again.Path, m.Path)
	let raw = quarry.ReadFile(paths[1]) catch _ {
		return
	}
	mut b = []u8(raw)
	b[len(b) / 2] = b[len(b) / 2] ^ 0x41
	quarry.WriteFile(paths[1], str(b)) catch _ {
		return
	}
	let before = quarry.ReadDir(d) catch _ {
		return
	}
	let other = fresh("merge-other")
	let (_, bad) = Merge(paths, other)
	t.HasFault("a damaged pack", bad)
	let left = quarry.ReadDir(other) catch _ {
		[]str{}
	}
	crucible.Equal(mut t, "nothing left behind", len(left), 0)
	let after = quarry.ReadDir(d) catch _ {
		return
	}
	crucible.Equal(mut t, "the packs as they were", len(after), len(before))
	quarry.RemoveAll(d) catch _ {
	}
	quarry.RemoveAll(other) catch _ {
	}
}

// The in-place Adler-32 and uvarint readers give what stamp.Adler32 and pack.Uvarint give on the slice (#807).
fn TestInPlaceReaders(t mut crucible.T) {
	mut r = dice.New(11)
	mut wrong = 0
	for round in 0..400 {
		let n = r.Intn(12000)
		mut b = r.Bytes(n + 16)
		if round % 7 == 0 {
			for k in 0..len(b) {
				b[k] = 0xff
			}
		}
		let s = str(b)
		let from = r.Intn(9)
		let to = from + n
		if adler32In(s, from, to) != stamp.Adler32(s[from:to]) {
			wrong += 1
		}
	}
	mut big = make([]u8, (1 << 24) + 4099)
	for k in 0..len(big) {
		big[k] = 0xff
	}
	let bs = str(big)
	if adler32In(bs, 3, len(bs)) != stamp.Adler32(bs[3:]) {
		wrong += 1
	}
	crucible.Equal(mut t, "adler sums that differ", wrong, 0)
	mut vwrong = 0
	for round in 0..3000 {
		let n = 1 + r.Intn(14)
		mut b = r.Bytes(n)
		// mostly continuation bytes, so long and overflowing numbers come up
		for k in 0..n {
			if r.Intn(4) != 0 {
				b[k] = b[k] | 0x80
			}
		}
		let s = str(b)
		let at = r.Intn(n)
		let end = at + r.Intn(n - at + 1)
		let (v, k, ok) = uvarintAt(s, at, end)
		let (wv, wk, werr) = pack.Uvarint([]u8(s[at:min(end, at + 10)]))
		if ok != (werr == nil) || (ok && (v != wv || k != wk)) {
			vwrong += 1
		}
	}
	crucible.Equal(mut t, "varints read differently", vwrong, 0)
}

// A pack too large to be read whole at once gives every object through its read windows, in any order (#807).
fn TestRanged(t mut crucible.T) {
	mut r = dice.New(12)
	mut s = store.NewMem()
	mut ids = []object.Id{}
	for i in 0..300 {
		// mostly small objects, some larger than a window, incompressible so the pack outgrows wholeUnder
		mut n = 200 + r.Intn(1500)
		if i % 25 == 0 {
			n = 20000 + r.Intn(30000)
		}
		let id = s.PutRaw(object.Kind.Blob, str(r.Bytes(n))) catch _ {
			object.NoId
		}
		ids = append(ids, id)
	}
	let d = fresh("ranged")
	let written = Write(mut s, ids, d) catch err {
		t.Error("write: {fault.Message(err)}")
		return
	}
	t.True("larger than wholeUnder", written.size > wholeUnder)
	mut p = Open(written.Path) catch err {
		t.Error("open: {fault.Message(err)}")
		return
	}
	mut wrong = 0
	// fewer than 64 objects first, in a random order, so each is read by its range of the file
	for k in 0..60 {
		let id = ids[r.Intn(len(ids))]
		let (k1, b1, e1) = p.GetRaw(id)
		let (k2, b2, e2) = s.GetRaw(id)
		if e1 != nil || e2 != nil || k1 != k2 || b1 != b2 {
			wrong += 1
		}
	}
	t.False("still read by ranges", p.loaded)
	for id in ids {
		let (k1, b1, e1) = p.GetRaw(id)
		let (k2, b2, e2) = s.GetRaw(id)
		if e1 != nil || e2 != nil || k1 != k2 || b1 != b2 {
			wrong += 1
		}
	}
	crucible.Equal(mut t, "objects read back wrong", wrong, 0)
	quarry.RemoveAll(d) catch _ {
	}
}

// A pack fitted to a memory budget it would outgrow read whole is read by ranges however many objects are read, and
// keeps at most a quarter of the budget of decoded entries; without a budget it is read whole after 64 (tinhub: a log of
// a large repository read the whole pack within a 16 MiB request).
fn TestBudget(t mut crucible.T) {
	mut r = dice.New(13)
	mut s = store.NewMem()
	mut ids = []object.Id{}
	for i in 0..300 {
		let id = s.PutRaw(object.Kind.Blob, str(r.Bytes(200 + r.Intn(1500)))) catch _ {
			object.NoId
		}
		ids = append(ids, id)
	}
	let d = fresh("budget")
	let written = Write(mut s, ids, d) catch err {
		t.Error("write: {fault.Message(err)}")
		return
	}
	t.True("larger than wholeUnder", written.size > wholeUnder)
	mut fitted = Open(written.Path) catch err {
		t.Error("open: {fault.Message(err)}")
		return
	}
	fitted.Budget(written.size * 2)
	mut plain = Open(written.Path) catch err {
		t.Error("open: {fault.Message(err)}")
		return
	}
	mut wrong = 0
	for id in ids {
		let (k1, b1, e1) = fitted.GetRaw(id)
		let (k2, b2, e2) = plain.GetRaw(id)
		let (k3, b3, e3) = s.GetRaw(id)
		if e1 != nil || e2 != nil || e3 != nil || k1 != k3 || b1 != b3 || k2 != k3 || b2 != b3 {
			wrong += 1
		}
	}
	crucible.Equal(mut t, "objects read back wrong", wrong, 0)
	t.False("fitted to the budget: still read by ranges", fitted.loaded)
	t.True("no budget: read whole", plain.loaded)
	t.True("decoded entries kept within a quarter of the budget", fitted.held <= written.size / 2)
	quarry.RemoveAll(d) catch _ {
	}
}
