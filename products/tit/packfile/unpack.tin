package packfile

import "../object"
import "../store"
import "fault"
import "seal"
import "squash"

// Unpacking (#796): reading a pack's bytes in order, with no index, as a server does with a pushed pack. Every entry
// gives its compressed length (section 6), so one pass finds them all.

fn uvarintIn(d str, at i64) !(i64, i64) {
	mut v = 0
	mut shift = 0
	mut i = at
	for {
		if i >= len(d) || shift > 62 {
			fail fault.Wrap(ErrBadPack, "a number cut off at {at}")
		}
		let c = i64(d[i])
		i += 1
		v = v | ((c & 0x7f) << shift)
		shift += 7
		if c & 0x80 == 0 {
			return v, i
		}
	}
}

// Unpack puts every object of the pack data into s, in the pack's order, and gives their ids. A delta's base is an
// earlier entry (by offset) or an object named by id, earlier in the pack or already in s; no object may be larger
// than maxObject. The trailing hash, the count and every object's id are checked.
fn Unpack[S store.ObjectStore](data str, s mut S, maxObject i64) ![]object.Id {
	if len(data) < 20 + 32 || data[0:8] != "TITPACK\x00" || le32(data, 8) != 1 {
		fail fault.Wrap(ErrBadPack, "not a version 1 pack")
	}
	if str(seal.Sha256(data[0:len(data) - 32])) != data[len(data) - 32:] {
		fail fault.Wrap(ErrBadPack, "its trailing hash does not match")
	}
	let count = le64(data, 12)
	let end = len(data) - 32
	mut bodies = map[i64]str{}
	mut kinds = map[i64]object.Kind{}
	mut ids = []object.Id{}
	mut at = 20
	for n in 0..count {
		if at >= end {
			fail fault.Wrap(ErrBadPack, "{count} entries promised, {n} found")
		}
		let off = at
		let t = i64(data[at])
		let (size, a) = try uvarintIn(data, at + 1)
		if size > maxObject {
			fail fault.Wrap(fault.LimitExceeded, "an object of {size} bytes at {off}")
		}
		at = a
		mut baseKind = object.Kind.Blob
		mut base = ""
		mut delta = false
		if t == typeOfsDelta {
			let (dist, b) = try uvarintIn(data, at)
			at = b
			let (bb, ok) = bodies[off - dist]
			if dist <= 0 || !ok {
				fail fault.Wrap(ErrBadPack, "a delta at {off} against no earlier entry")
			}
			base = bb
			baseKind = kinds[off - dist]
			delta = true
		} else if t == typeRefDelta {
			if at + 32 > end {
				fail fault.Wrap(ErrBadPack, "an entry runs past the end")
			}
			let bid = try object.IdOf(data[at:at + 32])
			at += 32
			let (bk, bb) = s.GetRaw(bid) catch _ {
				fail fault.Wrap(ErrBadPack, "a delta at {off} against {bid.Hex()}, which is neither in the pack nor here")
			}
			base = bb
			baseKind = bk
			delta = true
		}
		let (clen, c) = try uvarintIn(data, at)
		if clen < 0 || c + clen > end {
			fail fault.Wrap(ErrBadPack, "an entry runs past the end")
		}
		let z = data[c:c + clen]
		at = c + clen
		mut kind = baseKind
		mut body = ""
		if delta {
			let d = squash.Unzlib(z, 2 * maxObject + 64) catch err {
				fail fault.Wrap(ErrBadPack, "entry at {off}: {fault.Message(err)}")
			}
			body = try ApplyDelta(base, d, size)
		} else {
			kind = try kindOf(t)
			body = squash.Unzlib(z, size + 1) catch err {
				fail fault.Wrap(ErrBadPack, "entry at {off}: {fault.Message(err)}")
			}
		}
		if len(body) != size {
			fail fault.Wrap(ErrBadPack, "entry at {off}: {len(body)} bytes, not {size}")
		}
		bodies[off] = body
		kinds[off] = kind
		let id = try s.PutRaw(kind, body)
		ids = append(ids, id)
	}
	if at != end {
		fail fault.Wrap(ErrBadPack, "{end - at} bytes after the last entry")
	}
	return ids
}
