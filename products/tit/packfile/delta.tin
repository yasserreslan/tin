package packfile

import "../delta"
import "fault"

// MakeDelta is the delta that turns base into target, or "" when it would not be shorter (tit/delta).
fn MakeDelta(base str, target str) str {
	return delta.MakeDelta(base, target)
}

// ApplyDelta rebuilds a delta's result from its base (tit/delta); a delta that does not fit is ErrBadPack.
fn ApplyDelta(base str, d str, max i64) !str {
	let out = delta.ApplyDelta(base, d, max) catch e {
		if fault.Is(e, fault.LimitExceeded) {
			fail e
		}
		fail fault.Wrap(ErrBadPack, fault.Message(e))
	}
	return out
}

// appendUvarint appends v as a uvarint (seven bits a byte, low first).
fn appendUvarint(out mut []u8, v u64) {
	mut x = v
	for x >= 0x80 {
		out = append(out, u8(x & 0x7f) | 0x80)
		x = x >> 7
	}
	out = append(out, u8(x))
}
