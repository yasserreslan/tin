package packfile

import "../object"
import "../store"
import "crucible"
import "quarry"
import "seal"

// Tests for retired packs (#1007): a pack opened before it retires keeps reading, a listing leaves it out, and Sweep
// deletes it only after the grace period.

fn liveDir(name str) str {
	let d = "/tmp/tin-test-tit-live-" + name + "-" + seal.Hex(seal.RandomBytes(4))
	quarry.RemoveAll(d) catch _ {
	}
	quarry.MkdirAll(d) catch _ {
	}
	return d
}

// bigPack writes a pack of n blobs large enough to be read entry by entry, and gives it with the blobs' ids.
fn bigPack(dir str, n i64, tag str) !(Pack, []object.Id) {
	mut s = store.NewMem()
	mut ids = []object.Id{}
	for i in 0..n {
		mut body = ""
		for k in 0..200 {
			body = body + "{tag} blob {i} line {k} {seal.Hex(seal.RandomBytes(8))}\n"
		}
		let id = try s.PutRaw(object.Kind.Blob, body)
		ids = append(ids, id)
	}
	let p = try Write(mut s, ids, dir)
	return p, ids
}

fn TestRetiredReaders(t mut crucible.T) {
	let dir = liveDir("readers")
	let (p, ids) = bigPack(dir, 40, "a") catch e {
		t.Error("write: {e}")
		return
	}
	let name = p.Path[len(dir) + 1:len(p.Path) - 5]
	// opened before the retire, read after it
	mut open = Open(p.Path) catch e {
		t.Error("open: {e}")
		return
	}
	let n = Retire(dir, []str{name}, 1000) catch e {
		t.Error("retire: {e}")
		return
	}
	crucible.Equal(mut t, "one retired", n, 1)
	t.True("the live file is gone", !quarry.Exists(p.Path))
	mut read = 0
	for id in ids {
		let (_, body) = open.GetRaw(id) catch e {
			t.Error("read after retire: {e}")
			return
		}
		if len(body) > 0 {
			read += 1
		}
	}
	crucible.Equal(mut t, "every object reads from packs/retired", read, len(ids))
	let listed = OpenAll(dir) catch e {
		t.Error("open all: {e}")
		return
	}
	crucible.Equal(mut t, "no live pack listed", len(listed), 0)
	// the grace period: kept until it has passed
	let early = Sweep(dir, 3600, 1000 + 3600) catch _ {
		-1
	}
	crucible.Equal(mut t, "kept within the grace period", early, 0)
	t.True("still there", quarry.Exists(dir + "/retired/" + name + ".pack"))
	let late = Sweep(dir, 3600, 1000 + 3601) catch _ {
		-1
	}
	crucible.Equal(mut t, "deleted after it", late, 1)
	t.True("gone", !quarry.Exists(dir + "/retired/" + name + ".pack") && !quarry.Exists(dir + "/retired/" + name + ".idx") && !quarry.Exists(dir + "/retired/" + name + ".at"))
	quarry.RemoveAll(dir) catch _ {
	}
}

fn TestSweepStaged(t mut crucible.T) {
	let dir = liveDir("staged")
	quarry.MkdirAll(dir + "/staged") catch _ {
	}
	let (p, _) = bigPack(dir + "/staged", 2, "s") catch e {
		t.Error("write: {e}")
		return
	}
	let info = quarry.Lstat(p.Path) catch e {
		t.Error("stat: {e}")
		return
	}
	let written = info.Mtime / 1000000000
	let stays = Sweep(dir, 60, written + 10) catch _ {
		-1
	}
	crucible.Equal(mut t, "a recent pending pack stays", stays, 0)
	let gone = Sweep(dir, 60, written + 120) catch _ {
		-1
	}
	crucible.Equal(mut t, "an old pending pack goes", gone, 1)
	t.True("pack and index gone", !quarry.Exists(p.Path) && !quarry.Exists(p.Path[0:len(p.Path) - 5] + ".idx"))
	quarry.RemoveAll(dir) catch _ {
	}
}

fn TestOpenAllSkipsRetired(t mut crucible.T) {
	let dir = liveDir("openall")
	let (a, _) = bigPack(dir, 3, "x") catch e {
		t.Error("write a: {e}")
		return
	}
	let (b, _) = bigPack(dir, 3, "y") catch e {
		t.Error("write b: {e}")
		return
	}
	let all = OpenAll(dir) catch e {
		t.Error("open all: {e}")
		return
	}
	crucible.Equal(mut t, "two live", len(all), 2)
	_ = Retire(dir, []str{a.Path[len(dir) + 1:len(a.Path) - 5]}, 5) catch _ {
		0
	}
	let left = OpenAll(dir) catch e {
		t.Error("open all after retire: {e}")
		return
	}
	crucible.Equal(mut t, "one live", len(left), 1)
	crucible.Equal(mut t, "the other", left[0].Path, b.Path)
	quarry.RemoveAll(dir) catch _ {
	}
}
