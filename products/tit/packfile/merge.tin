package packfile

import "../object"
import "fault"
import "flume"
import "quarry"
import "seal"
import "sift"
import "stamp"

// Merging packs (#807): adopt writes three packs a batch (commits and tags, trees, blobs), and every pack is one more
// index to read and to search for each object, so at its end it merges the batches' packs of each kind into one. The
// entries are copied as they are, compressed bytes and deltas alike, with no inflating and no delta search (as Reuse
// does for a fetch): only an offset delta's header changes, its distance back to its base being another in the new
// pack. The packs are read a window at a time and the new pack is written as it goes, so the memory is a window's,
// not the packs'. Each entry is checked against its CRC as it is read and again once written.

// windowBytes is about how many bytes of a pack Merge reads at once (a larger entry is read alone).
const windowBytes = 8 << 20

// mergedWindow is what copying one window gives back: each entry's length in the new pack (0 for one left out, an
// object an earlier pack holds already), its CRC there and its delta depth.
type mergedWindow struct {
	lens   []i64
	crcs   []u32
	depths []i64
}

// Merge writes every object of the packs at paths (ending in .pack) into one pack in dir, their entries copied in the
// packs' order, and returns it, open and checked. The packs are left as they are: the caller removes them once the
// new pack is in place. A delta's base must be in the same pack (Write's packs are so).
fn Merge(paths []str, dir str) !Pack {
	try quarry.MkdirAll(dir)
	let tmp = dir + "/tmp-" + seal.Hex(seal.RandomBytes(8))
	let (p, err) = mergeInto(paths, dir, tmp)
	if err != nil {
		for ext in []str{".pack", ".idx"} {
			if quarry.Exists(tmp + ext) {
				quarry.Remove(tmp + ext) catch _ {
				}
			}
		}
		fail err
	}
	return p
}

fn mergeInto(paths []str, dir str, tmp str) !Pack {
	mut packs = []Pack{}
	for path in paths {
		let p = try Open(path)
		packs = append(packs, p)
	}
	// an object two packs hold is copied once, from the first (an entry of a later pack that is a delta against it
	// then names the first copy)
	mut seen = map[str]bool{}
	mut dups = [][]bool{}
	mut count = 0
	for p in packs {
		mut d = make([]bool, p.Count)
		for i in 0..p.Count {
			let raw = p.idx[idsAt + 32 * i:idsAt + 32 * i + 32]
			if seen[raw] {
				d[i] = true
			} else {
				seen[raw] = true
				count += 1
			}
		}
		dups = append(dups, d)
	}
	let path = tmp + ".pack"
	mut head = []u8{}
	appendStr(mut head, "TITPACK\x00")
	appendLE32(mut head, 1)
	appendLE64(mut head, count)
	mut w = try flume.CreateExcl(path)
	w.Str(str(head))
	try w.Close()
	// the new pack's offset and delta depth of every object copied so far, by id
	mut newAt = map[str]i64{}
	mut depthOf = map[str]i64{}
	mut ids = make([]object.Id, 0, count)
	mut offs = make([]i64, 0, count)
	mut crcs = make([]u32, 0, count)
	mut cur = len(head)
	for k in 0..len(packs) {
		let p = packs[k]
		// the entries in the pack's order (a base before its deltas), each running to the next
		mut order = make([]i64, 0, p.Count)
		for i in 0..p.Count {
			order = append(order, i)
		}
		sift.SortFunc(mut order, fn(a i64, b i64) i64 {
			return p.off(a) - p.off(b)
		})
		mut starts = make([]i64, p.Count)
		mut ends = make([]i64, p.Count)
		mut posAt = map[i64]i64{}
		for j in 0..len(order) {
			starts[j] = try p.offOf(order[j])
			posAt[starts[j]] = order[j]
		}
		for j in 0..len(order) {
			if j + 1 < len(order) {
				ends[j] = starts[j + 1]
			} else {
				ends[j] = p.size - 32
			}
		}
		let d = dups[k]
		mut j = 0
		for j < len(order) {
			let j0 = j
			j += 1
			for j < len(order) && ends[j] - starts[j0] <= windowBytes {
				j += 1
			}
			let j1 = j
			let at = cur
			let mw = try arena {
				try mergeWindow(p, path, order, starts, ends, d, j0, j1, at, posAt, newAt, depthOf)
			}
			for n in j0..j1 {
				let pos = order[n]
				if d[pos] {
					continue
				}
				let id = p.IdAt(pos)
				newAt[id.Bytes()] = cur
				depthOf[id.Bytes()] = mw.depths[n - j0]
				ids = append(ids, id)
				offs = append(offs, cur)
				crcs = append(crcs, mw.crcs[n - j0])
				cur += mw.lens[n - j0]
			}
		}
	}
	if len(ids) != count {
		fail fault.Wrap(ErrBadPack, "merging: {len(ids)} objects copied, not {count}")
	}
	// the trailing hash, of the pack as it is on the disk, then every entry read back against its CRC
	let sum = try hashFile(path, cur)
	try quarry.AppendFile(path, sum)
	try checkWritten(path, offs, crcs, cur)
	try quarry.Sync(path)
	let merged = try install(dir, tmp, sum, ids, offs, crcs)
	for id in ids {
		if merged.Find(id) < 0 {
			fail fault.Wrap(ErrBadPack, "merging: {id.Hex()} is not in the new pack")
		}
	}
	return merged
}

// mergeWindow copies the entries order[j0:j1] of p (in the order of their offsets) to the end of the file at path, the
// first at offset at of the new pack. Run it in an arena: only the lengths, CRCs and depths leave it.
fn mergeWindow(p Pack, path str, order []i64, starts []i64, ends []i64, dups []bool, j0 i64, j1 i64, at i64, posAt map[i64]i64, newAt map[str]i64, depthOf map[str]i64) !mergedWindow {
	let ws = starts[j0]
	let win = try quarry.ReadAt(p.Path, ws, ends[j1 - 1] - ws)
	if len(win) != ends[j1 - 1] - ws {
		fail fault.Wrap(ErrBadPack, "{p.Path} is shorter than its index says")
	}
	// the objects of this window copied so far: their new offsets and depths
	mut here = map[str]i64{}
	mut hereDepth = map[str]i64{}
	mut out = []u8{}
	mut res = mergedWindow{lens: []i64{}, crcs: []u32{}, depths: []i64{}}
	mut cur = at
	for n in j0..j1 {
		let pos = order[n]
		let off = starts[n]
		let e = win[off - ws:ends[n] - ws]
		if stamp.Crc32(e) != p.crc(pos) {
			fail fault.Wrap(ErrBadPack, "{p.IdAt(pos).Hex()} in {p.Path}: its CRC does not match")
		}
		if dups[pos] {
			res.lens = append(res.lens, 0)
			res.crcs = append(res.crcs, 0)
			res.depths = append(res.depths, 0)
			continue
		}
		let t = i64(e[0])
		let (_, a) = try varintIn(e, 1)
		mut c = a
		mut baseId = ""
		if t == typeOfsDelta {
			let (dist, b) = try varintIn(e, a)
			let (bpos, known) = posAt[off - dist]
			if dist <= 0 || !known {
				fail fault.Wrap(ErrBadPack, "{p.Path}: a delta at {off} against no earlier entry")
			}
			baseId = p.idx[idsAt + 32 * bpos:idsAt + 32 * bpos + 32]
			c = b
		} else if t == typeRefDelta {
			if a + 32 > len(e) {
				fail fault.Wrap(ErrBadPack, "{p.Path}: an entry runs past its end at {off}")
			}
			baseId = e[a:a + 32]
			c = a + 32
		} else {
			let _ = try kindOf(t)
		}
		let (clen, z) = try varintIn(e, c)
		if z + clen != len(e) {
			fail fault.Wrap(ErrBadPack, "{p.Path}: the entry at {off} does not end where the next begins")
		}
		mut depth = 0
		mut entry = e
		mut crc = p.crc(pos)
		if len(baseId) > 0 {
			// the base is copied already, in this window or an earlier one
			mut baseAt = -1
			mut baseDepth = 0
			let (h, inHere) = here[baseId]
			if inHere {
				baseAt = h
				baseDepth = hereDepth[baseId]
			} else {
				let (o, before) = newAt[baseId]
				if before {
					baseAt = o
					baseDepth = depthOf[baseId]
				}
			}
			if baseAt < 0 {
				fail fault.Wrap(ErrBadPack, "{p.Path}: a delta at {off} against an object not copied before it")
			}
			depth = baseDepth + 1
			if depth > MaxDeltaDepth {
				fail fault.Wrap(ErrBadPack, "merging: a delta chain longer than {MaxDeltaDepth} at {off} of {p.Path}")
			}
			if t == typeOfsDelta {
				// the same entry, its distance back counted in the new pack
				mut ne = []u8{u8(t)}
				let (size, _) = try varintIn(e, 1)
				appendUv(mut ne, size)
				appendUv(mut ne, cur - baseAt)
				ne = append(ne, e[c:]...)
				entry = str(ne)
				crc = stamp.Crc32(entry)
			}
		}
		let raw = p.idx[idsAt + 32 * pos:idsAt + 32 * pos + 32]
		here[raw] = cur
		hereDepth[raw] = depth
		out = append(out, entry...)
		res.lens = append(res.lens, len(entry))
		res.crcs = append(res.crcs, crc)
		res.depths = append(res.depths, depth)
		cur += len(entry)
	}
	try quarry.AppendFile(path, str(out))
	return res
}

// hashFile is the SHA-256 of the file at path, which must be size bytes long, read a buffer at a time.
fn hashFile(path str, size i64) !str {
	mut h = seal.NewSha256()
	mut r = try flume.Open(path)
	mut buf = make([]u8, 1 << 20)
	mut total = 0
	for {
		let k = r.Read(mut buf) catch e {
			r.Close()
			fail e
		}
		if k == 0 {
			break
		}
		_ = try h.Write(buf[0:k])
		total += k
	}
	r.Close()
	if total != size {
		fail fault.Wrap(ErrBadPack, "{path}: {total} bytes written, not {size}")
	}
	return str(h.Sum())
}

// checkWritten reads the pack written at path back, a window at a time, and checks each entry (at offs, in order,
// the last running to end) against its CRC.
fn checkWritten(path str, offs []i64, crcs []u32, end i64) ! {
	mut j = 0
	for j < len(offs) {
		let j0 = j
		j += 1
		for j < len(offs) && entryEnd(offs, end, j) - offs[j0] <= windowBytes {
			j += 1
		}
		let j1 = j
		_ = try arena {
			try checkWindow(path, offs, crcs, end, j0, j1)
			0
		}
	}
}

fn entryEnd(offs []i64, end i64, j i64) i64 {
	if j + 1 < len(offs) {
		return offs[j + 1]
	}
	return end
}

fn checkWindow(path str, offs []i64, crcs []u32, end i64, j0 i64, j1 i64) ! {
	let ws = offs[j0]
	let we = entryEnd(offs, end, j1 - 1)
	let win = try quarry.ReadAt(path, ws, we - ws)
	if len(win) != we - ws {
		fail fault.Wrap(ErrBadPack, "{path} is shorter than what was written")
	}
	for n in j0..j1 {
		if stamp.Crc32(win[offs[n] - ws:entryEnd(offs, end, n) - ws]) != crcs[n] {
			fail fault.Wrap(ErrBadPack, "{path}: the entry at {offs[n]} does not read back as it was written")
		}
	}
}
