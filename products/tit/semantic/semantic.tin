package semantic

import "twine"

// Declarations of a Tin file (#798), found from its text: edition 1 code is laid out by tin fmt, so a top-level
// declaration starts at the line's first column with fn, type, shape, const, let, mut, use or on, its doc comment is
// the comment lines right above it, and it runs to the next top-level line. That works on every version in history
// with nothing checked out and no compiler; a file with no declaration so laid out is compared by lines instead.
// Bodies are compared with their whitespace normalized, so a change tin fmt would undo is no change.

// Decl is one top-level declaration.
type Decl struct {
	// Key names it within its package: "fn name", "method Type.name", "type Name", "const Name", ...
	Key  str
	Name str
	// Line is where it starts in the file (its doc comment included), from 1.
	Line i64
	Text str
	// Norm is Text without its doc comment and with runs of whitespace as one space, blank lines dropped.
	Norm str
}

fn startsDecl(line str) bool {
	// func and var: edition 0's words, so history reaches back past the conversion to edition 1 (#226)
	for kw in []str{"fn ", "type ", "shape ", "const ", "let ", "mut ", "use ", "on ", "shared ", "func ", "var "} {
		if twine.HasPrefix(line, kw) {
			return true
		}
	}
	return false
}

fn isIdent(c u8) bool {
	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
}

fn identAt(s str, at i64) str {
	mut i = at
	for i < len(s) && isIdent(s[i]) {
		i += 1
	}
	return s[at:i]
}

fn skipSpace(s str, at i64) i64 {
	mut i = at
	for i < len(s) && s[i] == ' ' {
		i += 1
	}
	return i
}

// keyOf is a declaration's key and name from its first line.
fn keyOf(line str) (str, str) {
	mut l = line
	if twine.HasPrefix(l, "shared ") {
		l = l[7:]
	}
	let sp = twine.IndexByte(l, ' ')
	mut kw = l[0:sp]
	if kw == "func" {
		kw = "fn"
	} else if kw == "var" {
		kw = "let"
	}
	mut at = skipSpace(l, sp + 1)
	if kw == "fn" && at < len(l) && l[at] == '(' {
		// a method: fn (r T) Name / fn (r mut T) Name
		let close = twine.IndexByte(l[at:], ')')
		if close > 0 {
			let recv = twine.Split(twine.TrimSpace(l[at + 1:at + close]), " ")
			mut typ = recv[len(recv) - 1]
			let br = twine.IndexByte(typ, '[')
			if br > 0 {
				typ = typ[0:br]
			}
			let name = identAt(l, skipSpace(l, at + close + 1))
			return "method " + typ + "." + name, typ + "." + name
		}
	}
	let name = identAt(l, at)
	return kw + " " + name, name
}

fn normalize(text str) str {
	mut out = []u8{}
	for raw in twine.Split(text, "\n") {
		let line = twine.TrimSpace(raw)
		if len(line) == 0 || twine.HasPrefix(line, "//") {
			continue
		}
		mut space = false
		for i in 0..len(line) {
			let c = line[i]
			if c == ' ' || c == '\t' {
				space = true
				continue
			}
			if space && len(out) > 0 {
				out = append(out, ' ')
			}
			space = false
			out = append(out, c)
		}
		out = append(out, '\n')
	}
	return str(out)
}

// Decls are a file's top-level declarations, in order. ok is false when the file has none laid out as tin fmt lays
// them out (compare it by lines).
fn Decls(text str) ([]Decl, bool) {
	let lines = twine.Split(text, "\n")
	mut out = []Decl{}
	mut i = 0
	for i < len(lines) {
		if !startsDecl(lines[i]) {
			i += 1
			continue
		}
		// its doc comment: the comment lines right above
		mut start = i
		for start > 0 && twine.HasPrefix(lines[start - 1], "//") {
			start -= 1
		}
		mut end = i + 1
		// a declaration with a body runs to its closing brace at the first column; one line otherwise
		let opens = twine.HasSuffix(twine.TrimSpace(lines[i]), "{{") || twine.HasSuffix(twine.TrimSpace(lines[i]), "(")
		if opens {
			for end < len(lines) && !(len(lines[end]) > 0 && (lines[end][0] == '}' || lines[end][0] == ')')) {
				end += 1
			}
			if end < len(lines) {
				end += 1
			}
		}
		let (key, name) = keyOf(lines[i])
		let body = twine.Join(lines[i:end], "\n")
		out = append(out, Decl{Key: key, Name: name, Line: start + 1, Text: twine.Join(lines[start:end], "\n"), Norm: normalize(body)})
		i = end
	}
	return out, len(out) > 0
}

// Kind is how a declaration changed.
type Kind enum {
	Added
	Removed
	Changed
	Moved
	Renamed
}

// Change is one declaration's change between two versions of a package's files.
type Change struct {
	Kind    Kind
	Key     str
	Path    str
	OldKey  str
	OldPath str
}

// KindText names a kind.
fn KindText(k Kind) str {
	return match k {
		Added => "added"
		Removed => "removed"
		Changed => "changed"
		Moved => "moved"
		Renamed => "renamed"
	}
}

// Compare is how declarations changed from the old files to the new ones (path and text of each, the same paths in
// both lists, text "" for a file that does not exist on that side). A declaration that leaves one file and appears
// in another is moved; one whose body stays but whose name changes is renamed; reordering is no change.
fn Compare(paths []str, olds []str, news []str) []Change {
	mut gone = []Decl{}
	mut gonePath = []str{}
	mut came = []Decl{}
	mut camePath = []str{}
	mut out = []Change{}
	for i in 0..len(paths) {
		let (od, _) = Decls(olds[i])
		let (nd, _) = Decls(news[i])
		mut newBy = map[str]i64{}
		for k in 0..len(nd) {
			newBy[nd[k].Key] = k
		}
		mut kept = map[str]bool{}
		for d in od {
			let (k, ok) = newBy[d.Key]
			if ok {
				kept[d.Key] = true
				if nd[k].Norm != d.Norm {
					out = append(out, Change{Kind: Kind.Changed, Key: d.Key, Path: paths[i], OldKey: d.Key, OldPath: paths[i]})
				}
			} else {
				gone = append(gone, d)
				gonePath = append(gonePath, paths[i])
			}
		}
		for d in nd {
			let (_, was) = kept[d.Key]
			if !was {
				came = append(came, d)
				camePath = append(camePath, paths[i])
			}
		}
	}
	// pair what left with what came: the same key elsewhere is a move, the same body under another name a rename
	mut used = map[i64]bool{}
	for g in 0..len(gone) {
		mut match1 = -1
		for c in 0..len(came) {
			let (_, u) = used[c]
			if !u && came[c].Key == gone[g].Key && camePath[c] != gonePath[g] {
				match1 = c
				break
			}
		}
		if match1 >= 0 {
			used[match1] = true
			out = append(out, Change{Kind: Kind.Moved, Key: came[match1].Key, Path: camePath[match1], OldKey: gone[g].Key, OldPath: gonePath[g]})
			if came[match1].Norm != gone[g].Norm {
				out = append(out, Change{Kind: Kind.Changed, Key: came[match1].Key, Path: camePath[match1], OldKey: gone[g].Key, OldPath: gonePath[g]})
			}
			continue
		}
		mut match2 = -1
		for c in 0..len(came) {
			let (_, u) = used[c]
			if !u && renamedBody(gone[g], came[c]) {
				match2 = c
				break
			}
		}
		if match2 >= 0 {
			used[match2] = true
			out = append(out, Change{Kind: Kind.Renamed, Key: came[match2].Key, Path: camePath[match2], OldKey: gone[g].Key, OldPath: gonePath[g]})
			continue
		}
		out = append(out, Change{Kind: Kind.Removed, Key: gone[g].Key, Path: gonePath[g], OldKey: gone[g].Key, OldPath: gonePath[g]})
	}
	for c in 0..len(came) {
		let (_, u) = used[c]
		if !u {
			out = append(out, Change{Kind: Kind.Added, Key: came[c].Key, Path: camePath[c], OldKey: "", OldPath: ""})
		}
	}
	return out
}

// renamedBody reports whether b is a with only its name changed (same kind, same body otherwise).
fn renamedBody(a Decl, b Decl) bool {
	let ka = twine.IndexByte(a.Key, ' ')
	let kb = twine.IndexByte(b.Key, ' ')
	if a.Key[0:ka] != b.Key[0:kb] || len(a.Norm) < 16 {
		return false
	}
	return twine.ReplaceAll(a.Norm, a.Name, b.Name) == b.Norm
}
