package semantic

import "crucible"
import "twine"

// Tests for declarations and their changes (#798).

const oldA = `package p

// Hello says hello.
fn Hello(name str) str {
	return "hello " + name
}

fn helper() i64 {
	let x = 1
	return x
}

type Point struct {
	X i64
	Y i64
}

fn (p Point) Len() i64 {
	return p.X + p.Y
}
`

// the same file, reformatted (spacing, a blank line), helper renamed, Len changed, Point moved to b.tin
const newA = `package p

// Hello says hello.
fn Hello(name str) str {
	return   "hello " + name

}

fn helping() i64 {
	let x = 1
	return x
}

fn (p Point) Len() i64 {
	return p.X * p.Y
}
`

const newB = `package p

type Point struct {
	X i64
	Y i64
}
`

fn TestDecls(t mut crucible.T) {
	let (ds, ok) = Decls(oldA)
	t.True("laid out", ok)
	mut keys = []str{}
	for d in ds {
		keys = append(keys, d.Key)
	}
	crucible.Equal(mut t, "keys", twine.Join(keys, "|"), "fn Hello|fn helper|type Point|method Point.Len")
	crucible.Equal(mut t, "the doc comment starts it", ds[0].Line, 3)
	let (_, none) = Decls("just text\nno code\n")
	t.False("plain text has no declarations", none)
}

fn TestCompare(t mut crucible.T) {
	let cs = Compare([]str{"a.tin", "b.tin"}, []str{oldA, ""}, []str{newA, newB})
	mut got = []str{}
	for c in cs {
		got = append(got, KindText(c.Kind) + " " + c.Key + " " + c.OldPath + "->" + c.Path)
	}
	let text = twine.Join(got, "|")
	t.True("reformatting is no change: " + text, !twine.Contains(text, "fn Hello"))
	t.True("changed: " + text, twine.Contains(text, "changed method Point.Len a.tin->a.tin"))
	t.True("moved: " + text, twine.Contains(text, "moved type Point a.tin->b.tin"))
	t.True("renamed: " + text, twine.Contains(text, "renamed fn helping a.tin->a.tin"))
	crucible.Equal(mut t, "nothing else", len(cs), 3)
}
