package stack

import "../merge"
import "../object"
import "../store"
import "fault"
import "twine"

// Rebasing changes (#793, #786). A change replayed onto another commit keeps its change id, author and message: the
// result is a new version of the same change. A conflict does not stop a rebase: the new version records it
// (CommitData.Conflicts) and its tree holds our side at that path, so `tit stack` can show it and `tit edit` can put
// git's markers back on the disk.

// ErrNotCommit is the fault of an id that names no commit.
let ErrNotCommit = fault("not a commit")

// ConflictLine is a conflict as a commit records it: "path\tbase\tours\ttheirs", ids in hex, "-" for no file.
fn ConflictLine(c merge.Conflict) str {
	return c.Path + "\t" + hexOr(c.Base()) + "\t" + hexOr(c.Ours()) + "\t" + hexOr(c.Theirs())
}

fn hexOr(id object.Id) str {
	if id == object.NoId {
		return "-"
	}
	return id.Hex()
}

fn idOr(h str) !object.Id {
	if h == "-" {
		return object.NoId
	}
	return try object.ParseId(h)
}

// ParseConflict reads a recorded conflict line.
fn ParseConflict(line str) !merge.Conflict {
	let parts = twine.Split(line, "\t")
	if len(parts) != 4 || len(parts[0]) == 0 {
		fail fault.Wrap(object.ErrCorrupt, "a conflict line has {len(parts)} fields, not 4")
	}
	let b = try idOr(parts[1])
	let o = try idOr(parts[2])
	let t = try idOr(parts[3])
	return merge.NewConflict(parts[0], b, o, t)
}

// ConflictPaths are the paths a commit records conflicts at.
fn ConflictPaths(c object.CommitData) []str {
	mut out = []str{}
	for line in c.Conflicts {
		let tab = twine.IndexByte(line, '\t')
		if tab > 0 {
			out = append(out, line[0:tab])
		}
	}
	return out
}

// CommitOf is the commit an id names.
fn CommitOf[S store.ObjectStore](s mut S, id object.Id) !object.CommitData {
	let o = try s.Get(id)
	return match o {
		Commit(c) => c
		Tree(_) => try notCommit(id)
		Tag(_) => try notCommit(id)
		Blob(_) => try notCommit(id)
	}
}

fn notCommit(id object.Id) !object.CommitData {
	fail fault.Wrap(ErrNotCommit, id.Hex())
}

// Pick is commit c's change replayed onto the commit onto: the three-way merge of c's change (from its first
// parent's tree to its own) onto onto's tree, as a new version of c's change by committer, unsigned. The merged trees
// and blobs are written to s. Conflicts are recorded; conflicts c recorded already, at paths the merge did not reach,
// are kept.
fn Pick[S store.ObjectStore](s mut S, c object.Id, onto object.Id, committer object.Person) !object.CommitData {
	let cd = try CommitOf(mut s, c)
	let target = try CommitOf(mut s, onto)
	mut base = object.NoId
	if len(cd.Parents) > 0 {
		let p = try CommitOf(mut s, cd.Parents[0])
		base = p.Tree
	}
	let res = try merge.MergeTrees(mut s, base, target.Tree, cd.Tree)
	mut lines = []str{}
	mut at = map[str]bool{}
	for k in res.Conflicts {
		lines = append(lines, ConflictLine(k))
		at[k.Path] = true
	}
	for line in cd.Conflicts {
		let tab = twine.IndexByte(line, '\t')
		if tab > 0 {
			let (_, dup) = at[line[0:tab]]
			if !dup {
				lines = append(lines, line)
			}
		}
	}
	return object.CommitData{Tree: res.Tree, Parents: []object.Id{onto}, Change: cd.Change, Author: cd.Author, Committer: committer, GitHeaders: []str{}, Signature: "", Message: cd.Message, Conflicts: lines}
}
