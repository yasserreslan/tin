package identity

import "../object"
import "../store"
import "crucible"
import "fault"
import "quarry"
import "seal"

// Tests for config, identity, keys and signatures (#787).

fn fresh(name str) str {
	let d = "/tmp/tin-test-tit-identity-" + name + "-" + seal.Hex(seal.RandomBytes(4))
	quarry.RemoveAll(d) catch _ {
	}
	quarry.MkdirAll(d) catch _ {
	}
	return d
}

fn TestConfig(t mut crucible.T) {
	mut c = NewConfig()
	t.NoFault("user file", c.Parse("# me\n[user]\n\tname = Ana Lu\n\temail = ana@x.io\n[remote \"origin\"]\n\turl = https://example.test/tin\n", "user"))
	t.NoFault("repo file", c.Parse("[user]\nemail = \"ana@work.test\"\n; a comment\n", "repo"))
	let name = c.Get("user.name")
	t.True("name", name != nil && name == "Ana Lu")
	let email = c.Get("user.email")
	t.True("the repository wins", email != nil && email == "ana@work.test")
	let url = c.Get("remote.origin.url")
	t.True("subsection", url != nil && url == "https://example.test/tin")
	t.True("missing", c.Get("user.key") == nil)
	t.HasFault("bad line", c.Parse("[user]\nno equals sign\n", "bad"))
	t.HasFault("key outside a section", c.Parse("x = 1\n", "bad"))
	let p = Who(c, FixedClock{At: 1700000000123456789}) catch _ {
		object.Person{Name: "", Email: "", When: 0, Zone: 0}
	}
	t.True("who", p.Name == "Ana Lu" && p.Email == "ana@work.test" && p.When == 1700000000)
	let (_, err) = Who(NewConfig(), FixedClock{At: 0})
	t.True("no name is ErrNoIdentity", err != nil && fault.Is(err, ErrNoIdentity))
}

fn TestSet(t mut crucible.T) {
	let d = fresh("set")
	let path = d + "/config"
	t.NoFault("set new", Set(path, "user.name", "Ana"))
	t.NoFault("set another", Set(path, "user.email", "ana@x"))
	t.NoFault("replace", Set(path, "user.name", "Ana Lu"))
	t.NoFault("subsection", Set(path, "remote.origin.url", "https://x.test"))
	let text = quarry.ReadFile(path) catch _ {
		""
	}
	crucible.Equal(mut t, "file", text, "[user]\n\tname = Ana Lu\n\temail = ana@x\n[remote \"origin\"]\n\turl = https://x.test\n")
	quarry.RemoveAll(d) catch _ {
	}
}

fn person(email str) object.Person {
	return object.Person{Name: "Ana", Email: email, When: 1700000000, Zone: 0}
}

fn TestKeys(t mut crucible.T) {
	let d = fresh("keys")
	let path = d + "/key"
	let pub = NewKey(path) catch err {
		t.Error("new key: {fault.Message(err)}")
		return
	}
	let info = quarry.Lstat(path) catch _ {
		return
	}
	crucible.Equal(mut t, "owner only", info.Perm, 384)
	let s = LoadKey(path) catch err {
		t.Error("load: {fault.Message(err)}")
		return
	}
	crucible.Equal(mut t, "public half", seal.B64(s.Public), pub)
	let (_, again) = NewKey(path)
	t.HasFault("a key is never overwritten", again)
	quarry.Chmod(path, 420) catch _ {
	}
	let (_, open) = LoadKey(path)
	t.True("a key others can read is refused", open != nil && fault.Is(open, ErrBadKey))
	quarry.WriteFile(d + "/junk", "not a key\n") catch _ {
	}
	quarry.Chmod(d + "/junk", 384) catch _ {
	}
	let (_, junk) = LoadKey(d + "/junk")
	t.True("junk is ErrBadKey", junk != nil && fault.Is(junk, ErrBadKey))
	quarry.Chmod(path, 384) catch _ {
	}
	let c = object.CommitData{Tree: object.Hash(object.Kind.Tree, ""), Parents: []object.Id{}, Change: object.AdoptedChangeId("k"), Author: person("ana@x"), Committer: person("ana@x"), GitHeaders: []str{}, Signature: "", Message: "signed\n"}
	let signed = s.SignCommit(c) catch err {
		t.Error("sign: {fault.Message(err)}")
		return
	}
	crucible.Equal(mut t, "64-byte signature", len(signed.Signature), 64)
	let keys = []TrustedKey{TrustedKey{Email: "ana@x", Public: s.Public}}
	t.NoFault("verifies", VerifyCommit(signed, keys))
	let changed = object.CommitData{Tree: signed.Tree, Parents: signed.Parents, Change: signed.Change, Author: signed.Author, Committer: signed.Committer, GitHeaders: signed.GitHeaders, Signature: signed.Signature, Message: "signed!\n"}
	let e1 = VerifyCommit(changed, keys)
	t.True("a changed commit fails", e1 != nil && fault.Is(e1, ErrBadSignature))
	let e2 = VerifyCommit(signed, []TrustedKey{TrustedKey{Email: "bo@x", Public: s.Public}})
	t.True("another person's key does not count", e2 != nil && fault.Is(e2, ErrBadSignature))
	let e3 = VerifyCommit(c, keys)
	t.True("unsigned fails", e3 != nil && fault.Is(e3, ErrBadSignature))
	quarry.RemoveAll(d) catch _ {
	}
}

// commitWith stores a commit whose tree holds .tit-signers with these lines, signed by s.
fn commitWith(st mut store.Mem, s Signer, signers str, parents []object.Id, email str) object.Id {
	let blob = st.PutRaw(object.Kind.Blob, signers) catch _ {
		object.NoId
	}
	let tree = st.Put(object.Object.Tree([]object.Entry{object.Entry{Mode: object.Mode.File, Name: ".tit-signers", Id: blob}})) catch _ {
		object.NoId
	}
	let c = object.CommitData{Tree: tree, Parents: parents, Change: object.NewChangeId(), Author: person(email), Committer: person(email), GitHeaders: []str{}, Signature: "", Message: "m\n"}
	let signed = s.SignCommit(c) catch _ {
		c
	}
	return st.Put(object.Object.Commit(signed)) catch _ {
		object.NoId
	}
}

fn TestVerifyAgainstParent(t mut crucible.T) {
	let d = fresh("parent")
	let anaPub = NewKey(d + "/ana") catch _ {
		""
	}
	let evePub = NewKey(d + "/eve") catch _ {
		""
	}
	let a = LoadKey(d + "/ana") catch err {
		t.Error("{fault.Message(err)}")
		return
	}
	let e = LoadKey(d + "/eve") catch err {
		t.Error("{fault.Message(err)}")
		return
	}
	mut st = store.NewMem()
	let anaLine = "ana@x ed25519 " + anaPub + "\n"
	let root = commitWith(mut st, a, anaLine, []object.Id{}, "ana@x")
	t.NoFault("a root commit checks against its own file", Verify(mut st, root))
	let good = commitWith(mut st, a, anaLine, []object.Id{root}, "ana@x")
	t.NoFault("signed by a trusted key", Verify(mut st, good))
	let sneaky = commitWith(mut st, e, anaLine + "eve@x ed25519 " + evePub + "\n", []object.Id{good}, "eve@x")
	let err = Verify(mut st, sneaky)
	t.True("a commit cannot add the key that signs it", err != nil && fault.Is(err, ErrBadSignature))
	let after = commitWith(mut st, e, anaLine + "eve@x ed25519 " + evePub + "\n", []object.Id{sneaky}, "eve@x")
	t.NoFault("once a parent trusts the key, it counts", Verify(mut st, after))
	quarry.RemoveAll(d) catch _ {
	}
}
