package identity

import "../object"
import "../store"
import "fault"
import "flume"
import "quarry"
import "seal"
import "twine"

// Keys and signatures (#787). A private key is the 32-byte ed25519 seed, kept as a `secret []u8` from the moment it
// is read until seal signs with it, so the compiler keeps it out of logs, faults and output; `tin audit secrets` lists
// every place it leaves that protection.

// Signer signs commits and tags with one private key.
type Signer struct {
	seed   secret []u8
	Public []u8
	Path   str
}

// DefaultKeyPath is the user's key file: user.key from the config, else ~/.config/tit/key.
fn DefaultKeyPath(cfg Config) str {
	let k = cfg.Get("user.key")
	if k != nil {
		return k
	}
	let xdg = quarry.Getenv("XDG_CONFIG_HOME")
	if len(xdg) > 0 {
		return xdg + "/tit/key"
	}
	return quarry.Getenv("HOME") + "/.config/tit/key"
}

const keyHeader = "tit ed25519 private key"

// NewKey makes a new key at path (which must not exist), readable only by its owner, and returns its public half in
// base64.
fn NewKey(path str) !str {
	let slash = twine.LastIndex(path, "/")
	if slash > 0 {
		try quarry.MkdirAll(path[0:slash])
	}
	let seed secret []u8 = seal.RandomBytes(32)
	let pub = try seal.Ed25519PublicKey(seed)
	mut w = try flume.CreateExcl(path)
	quarry.Chmod(path, 384) catch err {
		w.Close() catch _ {
		}
		fail err
	}
	// The file holds the seed in base64: this is the one place the key is written out.
	w.Str(keyHeader + "\n" + seal.B64(reveal(seed)) + "\n")
	try w.Sync()
	try w.Close()
	return seal.B64(pub)
}

// LoadKey reads the key at path. A key file that its group or others can read is refused.
fn LoadKey(path str) !Signer {
	let info = quarry.Lstat(path) catch err {
		fail fault.Wrap(ErrNoIdentity, "no key at {path}: make one with tit key ({fault.Message(err)})")
	}
	if info.Perm & 63 != 0 {
		fail fault.Wrap(ErrBadKey, "{path} can be read by others: run chmod 600 {path}")
	}
	let text = try quarry.ReadFile(path)
	let lines = twine.Split(text, "\n")
	if len(lines) < 2 || lines[0] != keyHeader {
		fail fault.Wrap(ErrBadKey, "{path} is not a tit key")
	}
	let raw = seal.B64Decode(twine.TrimSpace(lines[1])) catch _ {
		fail fault.Wrap(ErrBadKey, "{path}: the key is not base64")
	}
	if len(raw) != 32 {
		fail fault.Wrap(ErrBadKey, "{path}: the key is not 32 bytes")
	}
	let seed secret []u8 = raw
	let pub = try seal.Ed25519PublicKey(seed)
	return Signer{seed: seed, Public: pub, Path: path}
}

// SignCommit is the commit with its signature set from this key.
fn (s Signer) SignCommit(c object.CommitData) !object.CommitData {
	let payload = try object.SigningPayload(c)
	let sig = try seal.SignEd25519(s.seed, []u8(payload))
	return object.CommitData{Tree: c.Tree, Parents: c.Parents, Change: c.Change, Author: c.Author, Committer: c.Committer, GitHeaders: c.GitHeaders, Signature: str(sig), Message: c.Message, Conflicts: c.Conflicts}
}

// Sign is the ed25519 signature of payload with this key (for requests to a server, transport section 15).
fn (s Signer) Sign(payload str) ![]u8 {
	return try seal.SignEd25519(s.seed, []u8(payload))
}

// SignTag is the tag with its signature set from this key.
fn (s Signer) SignTag(t object.TagData) !object.TagData {
	let payload = try object.TagSigningPayload(t)
	let sig = try seal.SignEd25519(s.seed, []u8(payload))
	return object.TagData{Object: t.Object, Kind: t.Kind, Name: t.Name, Tagger: t.Tagger, Signature: str(sig), Message: t.Message}
}

// TrustedKey is one line of a .tit-signers file: whose key it is, and the key.
type TrustedKey struct {
	Email  str
	Public []u8
}

// ParseSigners reads a .tit-signers file: `<email> ed25519 <base64 public key>` per line, `#` comments.
fn ParseSigners(text str) ![]TrustedKey {
	mut out = []TrustedKey{}
	mut n = 0
	for raw in twine.Split(text, "\n") {
		n += 1
		let line = twine.TrimSpace(raw)
		if len(line) == 0 || line[0] == '#' {
			continue
		}
		let f = twine.Fields(line)
		if len(f) != 3 || f[1] != "ed25519" {
			fail fault.Wrap(ErrBadKey, ".tit-signers:{n}: expected <email> ed25519 <key>")
		}
		let pub = seal.B64Decode(f[2]) catch _ {
			fail fault.Wrap(ErrBadKey, ".tit-signers:{n}: the key is not base64")
		}
		if len(pub) != 32 {
			fail fault.Wrap(ErrBadKey, ".tit-signers:{n}: the key is not 32 bytes")
		}
		out = append(out, TrustedKey{Email: f[0], Public: pub})
	}
	return out
}

// VerifyCommit checks the commit's signature against the trusted keys of its committer's email.
fn VerifyCommit(c object.CommitData, keys []TrustedKey) ! {
	if len(c.Signature) == 0 {
		fail fault.Wrap(ErrBadSignature, "the commit is not signed")
	}
	let payload = try object.SigningPayload(c)
	for k in keys {
		if k.Email != c.Committer.Email {
			continue
		}
		let err = seal.VerifyEd25519(k.Public, []u8(payload), []u8(c.Signature))
		if err == nil {
			return
		}
	}
	fail fault.Wrap(ErrBadSignature, "no trusted key of {c.Committer.Email} made this signature")
}

// SignersAt reads .tit-signers from the root of a commit's tree (no keys when there is no such file).
fn SignersAt[S store.ObjectStore](s mut S, commit object.Id) ![]TrustedKey {
	let co = try s.Get(commit)
	mut tree = object.NoId
	match co {
		Commit(c) => {
			tree = c.Tree
		}
		Blob(_) => {
			fail fault.Wrap(object.ErrCorrupt, "{commit.Hex()} is not a commit")
		}
		Tree(_) => {
			fail fault.Wrap(object.ErrCorrupt, "{commit.Hex()} is not a commit")
		}
		Tag(_) => {
			fail fault.Wrap(object.ErrCorrupt, "{commit.Hex()} is not a commit")
		}
	}
	let to = try s.Get(tree)
	match to {
		Tree(es) => {
			for e in es {
				if e.Name == ".tit-signers" {
					let (_, body) = try s.GetRaw(e.Id)
					return try ParseSigners(body)
				}
			}
		}
		Blob(_) => {
		}
		Commit(_) => {
		}
		Tag(_) => {
		}
	}
	return []TrustedKey{}
}

// Verify checks a commit against .tit-signers as it is in the commit's first parent, so a commit cannot add the key
// that signs it. A root commit, having no parent, is checked against its own file.
fn Verify[S store.ObjectStore](s mut S, id object.Id) ! {
	let o = try s.Get(id)
	match o {
		Commit(c) => {
			mut from = id
			if len(c.Parents) > 0 {
				from = c.Parents[0]
			}
			let keys = try SignersAt(mut s, from)
			try VerifyCommit(c, keys)
		}
		Blob(_) => {
			fail fault.Wrap(object.ErrCorrupt, "{id.Hex()} is not a commit")
		}
		Tree(_) => {
			fail fault.Wrap(object.ErrCorrupt, "{id.Hex()} is not a commit")
		}
		Tag(_) => {
			fail fault.Wrap(object.ErrCorrupt, "{id.Hex()} is not a commit")
		}
	}
}
