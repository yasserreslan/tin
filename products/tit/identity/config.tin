package identity

import "fault"
import "quarry"
import "twine"

// Config files (design/tit.md section 11): `[section]` and `[section "name"]` headers, `key = value` lines and `#` or
// `;` comments. Keys are read as `section.key` or `section.name.key`; the repository's file wins over the user's.

// Config is the merged repository and user configuration.
type Config struct {
	values map[str]str
}

// NewConfig is an empty configuration.
fn NewConfig() Config {
	return Config{values: map[str]str{}}
}

// Get is the value of a key, or nil.
fn (c Config) Get(key str) ?str {
	let (v, ok) = c.values[key]
	if !ok {
		return nil
	}
	return v
}

// Keys is every key, sorted.
fn (c Config) Keys() []str {
	mut out = []str{}
	for k, _ in c.values {
		out = append(out, k)
	}
	for i in 1..len(out) {
		let x = out[i]
		mut j = i - 1
		for j >= 0 && out[j] > x {
			out[j + 1] = out[j]
			j -= 1
		}
		out[j + 1] = x
	}
	return out
}

// Parse adds the settings of one file's text, later ones winning.
fn (c mut Config) Parse(text str, from str) ! {
	mut section = ""
	mut n = 0
	for raw in twine.Split(text, "\n") {
		n += 1
		let line = twine.TrimSpace(raw)
		if len(line) == 0 || line[0] == '#' || line[0] == ';' {
			continue
		}
		if line[0] == '[' {
			if line[len(line) - 1] != ']' {
				fail fault.Wrap(ErrBadKey, "{from}:{n}: a section header ends with ]")
			}
			let inner = twine.TrimSpace(line[1:len(line) - 1])
			let q = twine.IndexByte(inner, '"')
			if q < 0 {
				section = twine.ToLower(inner)
			} else {
				if inner[len(inner) - 1] != '"' || q == len(inner) - 1 {
					fail fault.Wrap(ErrBadKey, "{from}:{n}: [section \"name\"] needs both quotes")
				}
				section = twine.ToLower(twine.TrimSpace(inner[0:q])) + "." + inner[q + 1:len(inner) - 1]
			}
			continue
		}
		let eq = twine.IndexByte(line, '=')
		if eq < 1 || len(section) == 0 {
			fail fault.Wrap(ErrBadKey, "{from}:{n}: expected key = value inside a section")
		}
		let key = twine.ToLower(twine.TrimSpace(line[0:eq]))
		mut value = twine.TrimSpace(line[eq + 1:])
		if len(value) >= 2 && value[0] == '"' && value[len(value) - 1] == '"' {
			value = value[1:len(value) - 1]
		}
		c.values[section + "." + key] = value
	}
}

// UserConfigPath is the user's config file: $XDG_CONFIG_HOME/tit/config or ~/.config/tit/config.
fn UserConfigPath() str {
	let xdg = quarry.Getenv("XDG_CONFIG_HOME")
	if len(xdg) > 0 {
		return xdg + "/tit/config"
	}
	return quarry.Getenv("HOME") + "/.config/tit/config"
}

// Load is the user's config with the repository's (dir is its .tit directory, "" for none) over it.
fn Load(dir str) !Config {
	mut c = NewConfig()
	let user = UserConfigPath()
	if quarry.Exists(user) {
		let text = try quarry.ReadFile(user)
		try c.Parse(text, user)
	}
	if len(dir) > 0 && quarry.Exists(dir + "/config") {
		let text = try quarry.ReadFile(dir + "/config")
		try c.Parse(text, dir + "/config")
	}
	return c
}

// Set writes key = value into the config file at path, replacing the key's line or adding it under its section.
fn Set(path str, key str, value str) ! {
	let dot = twine.LastIndex(key, ".")
	if dot < 1 || dot == len(key) - 1 || twine.ContainsAny(value, "\n\r") {
		fail fault.Wrap(ErrBadKey, "set {key}: a key is section.name or section.sub.name, and a value is one line")
	}
	let section = key[0:dot]
	let name = key[dot + 1:]
	mut header = "[" + section + "]"
	let sub = twine.IndexByte(section, '.')
	if sub > 0 {
		header = "[" + section[0:sub] + " \"" + section[sub + 1:] + "\"]"
	}
	mut text = ""
	if quarry.Exists(path) {
		text = try quarry.ReadFile(path)
	}
	mut lines = twine.Split(text, "\n")
	if len(lines) > 0 && lines[len(lines) - 1] == "" {
		lines = lines[0:len(lines) - 1]
	}
	mut out = []str{}
	mut inSection = false
	mut done = false
	for line in lines {
		let t = twine.TrimSpace(line)
		if len(t) > 0 && t[0] == '[' {
			if inSection && !done {
				out = append(out, "\t" + name + " = " + value)
				done = true
			}
			inSection = t == header
		} else if inSection && !done {
			let eq = twine.IndexByte(t, '=')
			if eq > 0 && twine.ToLower(twine.TrimSpace(t[0:eq])) == twine.ToLower(name) {
				out = append(out, "\t" + name + " = " + value)
				done = true
				continue
			}
		}
		out = append(out, line)
	}
	if !done {
		if !inSection {
			out = append(out, header)
		}
		out = append(out, "\t" + name + " = " + value)
	}
	let slash = twine.LastIndex(path, "/")
	if slash > 0 {
		try quarry.MkdirAll(path[0:slash])
	}
	try quarry.WriteFile(path, twine.Join(out, "\n") + "\n")
}
