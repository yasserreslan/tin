package identity

import "../object"
import "fault"
import "tide"

// Config, names, keys, signing and the clock (design/tit.md sections 11 and 13; #787).

// ErrNoIdentity is the fault of a missing user.name, user.email or key.
let ErrNoIdentity = fault("no identity")

// ErrBadSignature is the fault of a signature that does not verify against the signers file.
let ErrBadSignature = fault("bad signature")

// ErrBadKey is the fault of a key file that cannot be used: unreadable, malformed, or readable by others.
let ErrBadKey = fault("bad key file")

// Clock is where tit reads the time; tests freeze it.
shape Clock {
	Now() i64
}

// SystemClock reads the wall clock.
type SystemClock struct {
	unused i64
}

// Now is the wall clock in unix nanoseconds.
fn (c SystemClock) Now() i64 {
	return tide.Wall()
}

// FixedClock always says the same time, for tests.
type FixedClock struct {
	At i64
}

// Now is the fixed time.
fn (c FixedClock) Now() i64 {
	return c.At
}

// Who is the person in new commits: user.name and user.email from the config, at the clock's time in the local zone.
fn Who[C Clock](cfg Config, clock C) !object.Person {
	let name = cfg.Get("user.name")
	let email = cfg.Get("user.email")
	if name == nil || email == nil {
		fail fault.Wrap(ErrNoIdentity, "set user.name and user.email: tit config set user.name 'Your Name'")
	}
	let now = clock.Now()
	let civil = tide.In(now, tide.Local())
	return object.Person{Name: name, Email: email, When: now / 1000000000, Zone: civil.Offset / 60}
}
