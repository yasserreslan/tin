package ignore

import "quarry"
import "twine"

// Ignore rules, as git's .gitignore (#782): negation, anchoring, directory-only patterns, `**`, character
// classes and escapes; nested .gitignore files, .tit/info/exclude and a user file, with the deeper file and the
// later line winning; and no re-including a path inside an excluded directory. Shared by tit and Tinland.

// Pattern is one rule of an ignore file.
type Pattern struct {
	glob     str
	negate   bool
	dirOnly  bool
	anchored bool
	base     str
}

// Rules are the ignore rules of a working directory, loaded so far.
type Rules struct {
	root  str
	outer []Pattern
	dirs  map[str][]Pattern
}

// New is a set of rules for the working directory root, with nothing loaded.
fn New(root str) Rules {
	return Rules{root: root, outer: []Pattern{}, dirs: map[str][]Pattern{}}
}

// Load is the rules for root: the user's file (~/.config/tit/ignore), .tit/info/exclude and root/.gitignore.
// Nested .gitignore files are loaded by Enter as a walk reaches their directories, or all at once by LoadTree.
fn Load(root str) !Rules {
	mut r = New(root)
	let user = userFile()
	if len(user) > 0 {
		try r.addFile(user, "", true)
	}
	try r.addFile(root + "/.tit/info/exclude", "", true)
	try r.Enter("")
	return r
}

// LoadTree is Load plus every .gitignore below root that is not inside an ignored directory.
fn LoadTree(root str) !Rules {
	mut r = try Load(root)
	try r.walk("")
	return r
}

fn (r mut Rules) walk(dir str) ! {
	mut full = r.root
	if len(dir) > 0 {
		full = r.root + "/" + dir
	}
	let names = try quarry.ReadDir(full)
	for name in names {
		if name == ".tit" || name == ".git" || !quarry.IsDir(full + "/" + name) {
			continue
		}
		mut rel = name
		if len(dir) > 0 {
			rel = dir + "/" + name
		}
		if r.Ignored(rel, true) {
			continue
		}
		try r.Enter(rel)
		try r.walk(rel)
	}
}

// Enter loads the .gitignore of dir (relative to the root, "" for the root itself) if it has one. Entering a
// directory twice loads it once.
fn (r mut Rules) Enter(dir str) ! {
	let (_, seen) = r.dirs[dir]
	if seen {
		return
	}
	mut path = r.root + "/.gitignore"
	if len(dir) > 0 {
		path = r.root + "/" + dir + "/.gitignore"
	}
	r.dirs[dir] = []Pattern{}
	try r.addFile(path, dir, false)
}

// EnterListed is Enter for a directory whose entries the caller has read: its .gitignore is read only when hasFile
// says it is there, so a walk spends no lookup on the directories without one.
fn (r mut Rules) EnterListed(dir str, hasFile bool) ! {
	if hasFile {
		try r.Enter(dir)
		return
	}
	let (_, seen) = r.dirs[dir]
	if !seen {
		r.dirs[dir] = []Pattern{}
	}
}

// Add adds the lines of an ignore file whose directory is base (relative to the root, "" for the root);
// rules added later win over earlier ones in the same directory.
fn (r mut Rules) Add(base str, text str) {
	let ps = Parse(text, base)
	let (old, _) = r.dirs[base]
	r.dirs[base] = append(old, ps...)
}

// AddOuter adds rules that apply below every ignore file, as .tit/info/exclude and the user's file do.
fn (r mut Rules) AddOuter(text str) {
	r.outer = append(r.outer, Parse(text, "")...)
}

fn (r mut Rules) addFile(path str, base str, outer bool) ! {
	if !quarry.Exists(path) {
		return
	}
	let text = try quarry.ReadFile(path)
	if outer {
		r.AddOuter(text)
	} else {
		r.Add(base, text)
	}
}

fn userFile() str {
	let xdg = quarry.Getenv("XDG_CONFIG_HOME")
	if len(xdg) > 0 {
		return xdg + "/tit/ignore"
	}
	let home = quarry.Getenv("HOME")
	if len(home) > 0 {
		return home + "/.config/tit/ignore"
	}
	return ""
}

// Parse reads the lines of an ignore file whose directory is base.
fn Parse(text str, base str) []Pattern {
	mut out = []Pattern{}
	for raw in twine.Split(text, "\n") {
		mut line = raw
		if len(line) > 0 && line[len(line) - 1] == '\r' {
			line = line[0:len(line) - 1]
		}
		line = trimTrailingSpaces(line)
		if len(line) == 0 || line[0] == '#' {
			continue
		}
		mut negate = false
		if line[0] == '!' {
			negate = true
			line = line[1:]
		} else if len(line) > 1 && line[0] == '\\' && (line[1] == '!' || line[1] == '#') {
			line = line[1:]
		}
		mut dirOnly = false
		if len(line) > 0 && line[len(line) - 1] == '/' {
			dirOnly = true
			line = line[0:len(line) - 1]
		}
		if len(line) == 0 {
			continue
		}
		let anchored = twine.ContainsByte(line, '/')
		if line[0] == '/' {
			line = line[1:]
		}
		out = append(out, Pattern{glob: line, negate: negate, dirOnly: dirOnly, anchored: anchored, base: base})
	}
	return out
}

// trimTrailingSpaces drops trailing spaces that a backslash does not escape.
fn trimTrailingSpaces(s str) str {
	mut end = len(s)
	for end > 0 && s[end - 1] == ' ' {
		if end >= 2 && s[end - 2] == '\\' {
			break
		}
		end -= 1
	}
	return s[0:end]
}

// Ignored reports whether the path (relative to the root, "/"-separated) is ignored by the rules loaded so
// far. A path inside an ignored directory is ignored whatever its own rules say, as in git.
fn (r Rules) Ignored(path str, isDir bool) bool {
	for i in 0..len(path) {
		if path[i] == '/' && r.verdict(path[0:i], true) {
			return true
		}
	}
	return r.verdict(path, isDir)
}

// verdict is the last matching rule's answer for path itself: the outer rules first, then each directory's file
// from the root down, so the deeper file and the later line win.
fn (r Rules) verdict(path str, isDir bool) bool {
	mut ignored = false
	for p in r.outer {
		if matches(p, path, isDir) {
			ignored = !p.negate
		}
	}
	mut dir = ""
	mut i = 0
	for {
		let (ps, ok) = r.dirs[dir]
		if ok {
			for p in ps {
				if matches(p, path, isDir) {
					ignored = !p.negate
				}
			}
		}
		let slash = twine.IndexByte(path[i:], '/')
		if slash < 0 {
			break
		}
		dir = path[0:i + slash]
		i = i + slash + 1
	}
	return ignored
}

fn matches(p Pattern, path str, isDir bool) bool {
	if p.dirOnly && !isDir {
		return false
	}
	mut rel = path
	if len(p.base) > 0 {
		if len(path) <= len(p.base) || path[0:len(p.base)] != p.base || path[len(p.base)] != '/' {
			return false
		}
		rel = path[len(p.base) + 1:]
	}
	if !p.anchored {
		let slash = twine.LastIndex(rel, "/")
		if slash >= 0 {
			rel = rel[slash + 1:]
		}
	}
	return Match(p.glob, rel)
}

// Match reports whether name matches the glob with git's rules: `*` and `?` stop at `/`, `[...]` is a class
// (`!` or `^` negates it), `\` escapes, and `**` between slashes (or at either end) spans directories.
fn Match(glob str, name str) bool {
	return wild(glob, 0, name, 0)
}

fn wild(p str, pi i64, s str, si i64) bool {
	mut i = pi
	mut j = si
	for i < len(p) {
		let c = p[i]
		if c == '*' {
			let double = i + 1 < len(p) && p[i + 1] == '*'
			let startOk = i == 0 || p[i - 1] == '/'
			if double && startOk && (i + 2 == len(p) || p[i + 2] == '/') {
				if i + 2 == len(p) {
					return true
				}
				// "**/": zero or more whole directories
				if wild(p, i + 3, s, j) {
					return true
				}
				for k in j..len(s) {
					if s[k] == '/' && wild(p, i + 3, s, k + 1) {
						return true
					}
				}
				return false
			}
			mut n = i
			for n < len(p) && p[n] == '*' {
				n += 1
			}
			for k in j..len(s) + 1 {
				if wild(p, n, s, k) {
					return true
				}
				if k < len(s) && s[k] == '/' {
					return false
				}
			}
			return false
		}
		if j >= len(s) {
			return false
		}
		if c == '?' {
			if s[j] == '/' {
				return false
			}
			i += 1
			j += 1
			continue
		}
		if c == '[' {
			let (ok, next) = class(p, i, s[j])
			if !ok {
				return false
			}
			i = next
			j += 1
			continue
		}
		mut lit = c
		if c == '\\' && i + 1 < len(p) {
			i += 1
			lit = p[i]
		}
		if lit != s[j] {
			return false
		}
		i += 1
		j += 1
	}
	return j == len(s)
}

// class matches c against the class starting at p[open] == '['; it gives whether it matched and the index
// after the class. A class without its closing bracket matches nothing.
fn class(p str, open i64, c u8) (bool, i64) {
	if c == '/' {
		return false, open + 1
	}
	mut i = open + 1
	mut negate = false
	if i < len(p) && (p[i] == '!' || p[i] == '^') {
		negate = true
		i += 1
	}
	mut hit = false
	mut first = true
	for i < len(p) {
		mut lo = p[i]
		if lo == ']' && !first {
			return hit != negate, i + 1
		}
		first = false
		if lo == '\\' && i + 1 < len(p) {
			i += 1
			lo = p[i]
		}
		mut hi = lo
		if i + 2 < len(p) && p[i + 1] == '-' && p[i + 2] != ']' {
			hi = p[i + 2]
			i += 2
		}
		if c >= lo && c <= hi {
			hit = true
		}
		i += 1
	}
	return false, len(p)
}
