package ignore

import "crucible"

// Unit tests for tit/ignore (#782); the comparison with git itself is products/tit/tests/programs/ignore_git.tin.

fn TestMatch(t mut crucible.T) {
	let yes = [][]str{
		[]str{"*.log", "a.log"}, []str{"a?c", "abc"}, []str{"[abc]x", "bx"}, []str{"[!0-9]n", "an"},
		[]str{"[^0-9]n", "an"}, []str{"[a-c]", "b"}, []str{"[]]", "]"}, []str{"\\*", "*"}, []str{"**/z", "z"},
		[]str{"**/z", "a/b/z"}, []str{"a/**/z", "a/z"}, []str{"a/**/z", "a/b/c/z"}, []str{"a/**", "a/b/c"},
		[]str{"**", "x/y"}, []str{"a**b", "axxb"}, []str{"x/*/y", "x/q/y"},
	}
	let no = [][]str{
		[]str{"*.log", "a/b.log"}, []str{"a?c", "a/c"}, []str{"[abc]x", "dx"}, []str{"[!0-9]n", "5n"},
		[]str{"[a-c]", "/"}, []str{"[abc", "a"}, []str{"a/**/z", "a/zz"}, []str{"a**b", "a/b"},
		[]str{"x/*/y", "x/q/r/y"}, []str{"a/**", "a"},
	}
	for c in yes {
		t.True("{c[0]} matches {c[1]}", Match(c[0], c[1]))
	}
	for c in no {
		t.False("{c[0]} does not match {c[1]}", Match(c[0], c[1]))
	}
}

fn TestRules(t mut crucible.T) {
	mut r = New("/nowhere")
	r.AddOuter("*.bak\n")
	r.Add("", "build/\n*.log\n!keep.log\n!*.bak\n/top\n")
	r.Add("sub", "*.txt\n!important.txt\n")
	t.True("file pattern", r.Ignored("x/a.log", false))
	t.False("negated later", r.Ignored("x/keep.log", false))
	t.True("directory pattern on a directory", r.Ignored("x/build", true))
	t.False("directory pattern on a file", r.Ignored("x/build", false))
	t.True("inside an ignored directory", r.Ignored("x/build/keep.log", false))
	t.False("a .gitignore wins over the outer rules", r.Ignored("a.bak", false))
	t.True("anchored at its directory", r.Ignored("top", false))
	t.False("anchored, deeper", r.Ignored("x/top", false))
	t.True("nested file applies below it", r.Ignored("sub/a.txt", false))
	t.False("nested negation", r.Ignored("sub/important.txt", false))
	t.False("nested file does not apply elsewhere", r.Ignored("other/a.txt", false))
}

fn TestParse(t mut crucible.T) {
	let ps = Parse("# c\n\n  \n\\#lit\n\\!lit\nend\\ \nsp   \n/a/b/\nname\r\n", "d")
	crucible.Equal(mut t, "count", len(ps), 6)
	crucible.Equal(mut t, "escaped #", ps[0].glob, "#lit")
	crucible.Equal(mut t, "escaped !", ps[1].glob, "!lit")
	crucible.Equal(mut t, "escaped space kept", ps[2].glob, "end\\ ")
	crucible.Equal(mut t, "trailing spaces dropped", ps[3].glob, "sp")
	t.True("anchored", ps[4].anchored)
	crucible.Equal(mut t, "carriage return dropped", ps[5].glob, "name")
	t.True("dir only", ps[4].dirOnly)
	crucible.Equal(mut t, "leading slash dropped", ps[4].glob, "a/b")
}
