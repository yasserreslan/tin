package main

import "cmd"
import "cores"
import "quarry"

// tit: version control written in Tin (#769). The command runs on core 0 while the other cores hash files for it.
fn main() {
	let args = quarry.Args()
	// tit serve runs anvil, which starts its own cores: it must not run inside the hashing cores' (#858)
	for a in args[1:] {
		if a == "serve" {
			quarry.Exit(cmd.Main(args[1:]))
		}
	}
	mut code = 0
	cores.Start(0, fn() {
		code = cmd.Main(args[1:])
	})
	quarry.Exit(code)
}
