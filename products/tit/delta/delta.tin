package delta

import "fault"
import "pack"

// ErrBadDelta is the fault of a delta that does not fit its base or its declared size.
let ErrBadDelta = fault("a damaged delta")

// Deltas (design/tit.md section 6), in a package of their own so that the cores computing them for a pack
// (tit/cores) need not import tit/packfile: a header of the base's size and the result's size, then ops until the end:
// 0x00 uvarint n and n bytes inserts them; 0x01 uvarint offset, uvarint n copies n bytes of the base from offset.

const deltaBlock = 16

const rollBase = u64(0x100000001b3)

// blockHash is the hash of the 16 bytes of s at i: the polynomial sum of s[i+k] * B^(15-k) modulo 2^64, which
// rollHash moves one byte along in constant time.
@wrap fn blockHash(s str, i i64) u64 {
	mut h = u64(0)
	for k in 0..deltaBlock {
		h = h * rollBase + u64(s[i + k])
	}
	return h
}

// rollTop is B^15 modulo 2^64, the weight of a block's first byte.
@wrap fn rollTop() u64 {
	mut p = u64(1)
	for k in 0..deltaBlock - 1 {
		p = p * rollBase
	}
	return p
}

// rollHash is the hash of the block one byte on: out leaves at the front, in arrives at the back.
@wrap fn rollHash(h u64, out u8, in u8, top u64) u64 {
	return (h - u64(out) * top) * rollBase + u64(in)
}

// slotOf is a hash's first slot in a table of mask + 1 slots.
@wrap fn slotOf(h u64, mask i64) i64 {
	let x = (h ^ (h >> 29)) * u64(0xbf58476d1ce4e5b9)
	return i64((x >> 32) ^ x) & mask
}

// sameBlock reports whether the 16 bytes of a at i are those of b at j (compared in place: a slice of a str is a copy).
fn sameBlock(a str, i i64, b str, j i64) bool {
	for k in 0..deltaBlock {
		if a[i + k] != b[j + k] {
			return false
		}
	}
	return true
}

// appendUvarint appends v as a uvarint (seven bits a byte, low first).
fn appendUvarint(out mut []u8, v u64) {
	mut x = v
	for x >= 0x80 {
		out = append(out, u8(x & 0x7f) | 0x80)
		x = x >> 7
	}
	out = append(out, u8(x))
}

fn putInsert(out mut []u8, lit []u8) {
	if len(lit) == 0 {
		return
	}
	out = append(out, 0)
	appendUvarint(mut out, u64(len(lit)))
	out = append(out, lit...)
}

// MakeDelta is the delta that turns base into target, or "" when it would not be shorter than target: the base is
// indexed every 16 bytes, and each match found in the target is extended forwards and backwards.
fn MakeDelta(base str, target str) str {
	if len(base) < deltaBlock || len(target) < deltaBlock {
		return ""
	}
	// the base's blocks by hash, the first of equal hashes kept: an open-addressing table (a map's probes were most
	// of the time)
	let blocks = len(base) / deltaBlock
	mut size = 16
	for size < 2 * blocks {
		size = size * 2
	}
	mut keys = make([]u64, size)
	mut vals = make([]i64, size)
	for k in 0..size {
		vals[k] = -1
	}
	let mask = size - 1
	mut i = 0
	for i + deltaBlock <= len(base) {
		let h = blockHash(base, i)
		mut slot = slotOf(h, mask)
		for vals[slot] >= 0 && keys[slot] != h {
			slot = (slot + 1) & mask
		}
		if vals[slot] < 0 {
			keys[slot] = h
			vals[slot] = i
		}
		i += deltaBlock
	}
	mut out = make([]u8, 0, len(target) / 4 + 16)
	appendUvarint(mut out, u64(len(base)))
	appendUvarint(mut out, u64(len(target)))
	mut lit = make([]u8, 0, 64)
	let top = rollTop()
	mut t = 0
	// h is the hash of target[t:t+16] whenever that block exists
	mut h = blockHash(target, 0)
	for t < len(target) {
		if t + deltaBlock <= len(target) {
			mut slot = slotOf(h, mask)
			mut b0 = -1
			for vals[slot] >= 0 {
				if keys[slot] == h {
					b0 = vals[slot]
					break
				}
				slot = (slot + 1) & mask
			}
			if b0 >= 0 && sameBlock(base, b0, target, t) {
				mut b = b0
				mut start = t
				// extend backwards into the pending literal bytes
				for start > 0 && b > 0 && len(lit) > 0 && base[b - 1] == target[start - 1] {
					b -= 1
					start -= 1
					lit = lit[0:len(lit) - 1]
				}
				mut end = t + deltaBlock
				mut be = b0 + deltaBlock
				for end < len(target) && be < len(base) && base[be] == target[end] {
					end += 1
					be += 1
				}
				putInsert(mut out, lit)
				lit = lit[0:0]
				out = append(out, 1)
				appendUvarint(mut out, u64(b))
				appendUvarint(mut out, u64(end - start))
				t = end
				if t + deltaBlock <= len(target) {
					h = blockHash(target, t)
				}
				continue
			}
		}
		lit = append(lit, target[t])
		if t + deltaBlock < len(target) {
			h = rollHash(h, target[t], target[t + deltaBlock], top)
		}
		t += 1
	}
	putInsert(mut out, lit)
	if len(out) >= len(target) {
		return ""
	}
	return str(out)
}

fn uvarintAt(d str, at i64) !(i64, i64) {
	if at >= len(d) {
		fail fault.Wrap(ErrBadDelta, "delta: cut off")
	}
	let (v, n) = pack.Uvarint([]u8(d[at:min(len(d), at + 10)])) catch _ {
		fail fault.Wrap(ErrBadDelta, "delta: a bad varint")
	}
	if v > u64(1) << 62 {
		fail fault.Wrap(ErrBadDelta, "delta: a number too large")
	}
	return i64(v), at + n
}

// ApplyDelta rebuilds the result of a delta from its base, failing on any delta that does not fit the base or its own
// declared size, or whose result would be larger than max.
fn ApplyDelta(base str, delta str, max i64) !str {
	let (bsize, p1) = try uvarintAt(delta, 0)
	let (rsize, p2) = try uvarintAt(delta, p1)
	if bsize != len(base) {
		fail fault.Wrap(ErrBadDelta, "delta: for a base of {bsize} bytes, not {len(base)}")
	}
	if rsize > max {
		fail fault.Wrap(fault.LimitExceeded, "delta: a result of {rsize} bytes")
	}
	mut out = make([]u8, 0, rsize)
	mut at = p2
	for at < len(delta) {
		let op = delta[at]
		at += 1
		if op == 0 {
			let (n, p) = try uvarintAt(delta, at)
			if n == 0 || p + n > len(delta) || len(out) + n > rsize {
				fail fault.Wrap(ErrBadDelta, "delta: a bad insert")
			}
			out = append(out, delta[p:p + n]...)
			at = p + n
		} else if op == 1 {
			let (off, p) = try uvarintAt(delta, at)
			let (n, q) = try uvarintAt(delta, p)
			if n == 0 || off + n > len(base) || len(out) + n > rsize {
				fail fault.Wrap(ErrBadDelta, "delta: a copy outside the base")
			}
			out = append(out, base[off:off + n]...)
			at = q
		} else {
			fail fault.Wrap(ErrBadDelta, "delta: unknown op {op}")
		}
	}
	if len(out) != rsize {
		fail fault.Wrap(ErrBadDelta, "delta: {len(out)} bytes, not the {rsize} declared")
	}
	return str(out)
}
