package prune

import "../change"
import "../crash"
import "../index"
import "../object"
import "../oplog"
import "../packfile"
import "../store"
import "fault"
import "quarry"
import "twine"

// Removing objects (design/tit.md §16, #1010). tit never deleted an object: staged packs of crashed pushes,
// force-pushed versions, deleted branches and a secret pushed by mistake all stayed. Prune removes what nothing
// reaches any more, keeping what undo may still need; purge removes named objects that no ref, change or workspace
// reaches, at once, from every pack, for leaked secrets and takedowns.
//
// The roots: every ref and tag, every version of every open change, each workspace's HEAD, index, parked work
// and edit, and (for prune) the snapshots and the oplog's records inside the retention window, so undo and restore
// keep working. Removing from packs writes a new pack of what stays and retires the old ones (packfile.Retire).

// ErrReachable is the fault of a purge of an object a ref, a change or a workspace still reaches.
let ErrReachable = fault("still reachable")

// DefaultRetention is how long prune keeps what only the oplog or a loose file's age protects: 30 days, in ns.
const DefaultRetention = 30 * 24 * 3600 * 1000000000

// Result is what a prune or a purge removed.
type Result struct {
	Reachable i64
	Objects   i64
	Packs     i64
	Loose     i64
	Chunks    i64
}

// root is an object something names (its id's 32 bytes: a field of object.Id's type is not stored reliably today,
// #847), what names it (for purge's refusal), and whether it is known to be a blob.
type root struct {
	raw  str
	from str
	blob bool
}

fn rootOf(id object.Id, from str, blob bool) root {
	return root{raw: id.Bytes(), from: from, blob: blob}
}

fn idOf(raw str) object.Id {
	let id = object.IdOf(raw) catch _ {
		object.NoId
	}
	return id
}

// local is the repository's own objects: loose and every live pack, no lazy remote behind them.
fn local(dir str) !(store.Layered, []packfile.Pack) {
	let packs = try packfile.OpenAll(dir + "/packs")
	mut layers = []dyn store.ObjectStore{}
	for p in packs {
		layers = append(layers, p)
	}
	layers = append(layers, store.NewLoose(dir + "/objects"))
	return store.NewLayered(layers), packs
}

// hexIds is every 64-digit hex run in text, as ids.
fn hexIds(text str) []object.Id {
	mut out = []object.Id{}
	mut i = 0
	for i < len(text) {
		mut j = i
		for j < len(text) && ((text[j] >= '0' && text[j] <= '9') || (text[j] >= 'a' && text[j] <= 'f')) {
			j += 1
		}
		if j - i == 64 {
			let id = object.ParseId(text[i:j]) catch _ {
				object.NoId
			}
			if id != object.NoId {
				out = append(out, id)
			}
		}
		i = j + 1
	}
	return out
}

fn addText(roots mut []root, text str, from str, blob bool) {
	for id in hexIds(text) {
		roots = append(roots, rootOf(id, from, blob))
	}
}

fn filesIn(dir str) []str {
	mut out = []str{}
	if !quarry.IsDir(dir) {
		return out
	}
	let names = quarry.ReadDir(dir) catch _ {
		return out
	}
	for n in names {
		let p = dir + "/" + n
		if quarry.IsDir(p) {
			for f in filesIn(p) {
				out = append(out, f)
			}
		} else {
			out = append(out, p)
		}
	}
	return out
}

// Roots is what names objects in the .tit directory dir. history adds what only undo needs: the snapshots, and the
// oplog's records newer than now - retention (ns).
fn Roots(dir str, history bool, retention i64, now i64) ![]root {
	mut out = []root{}
	let refs = change.NewRefs(dir)
	let all = try refs.List("refs/")
	for r in all {
		match r.Target {
			Commit(id) => {
				out = append(out, rootOf(id, r.Name, false))
			}
			Change(_) => {
			}
		}
	}
	// each workspace: HEAD, its index's blobs, parked work, an edit in progress
	let wsDir = dir + "/workspaces"
	if quarry.IsDir(wsDir) {
		let names = try quarry.ReadDir(wsDir)
		for w in names {
			let base = wsDir + "/" + w
			for name in []str{"HEAD", "EDIT", "head-tree"} {
				let text = quarry.ReadFile(base + "/" + name) catch _ {
					continue
				}
				addText(mut out, text, "workspace {w} {name}", false)
			}
			for f in filesIn(base + "/parked") {
				let text = quarry.ReadFile(f) catch _ {
					continue
				}
				addText(mut out, text, "workspace {w} parked work", false)
			}
			if quarry.Exists(base + "/index") {
				let ix = index.Read(base + "/index") catch _ {
					index.Index{Entries: []index.Entry{}, Written: 0, Sum: "", Tree: object.NoId}
				}
				for e in ix.Entries {
					out = append(out, root{raw: e.Hash, from: "workspace {w} index ({e.Path})", blob: true})
				}
			}
			if history {
				for f in filesIn(base + "/snapshots") {
					let text = quarry.ReadFile(f) catch _ {
						continue
					}
					addText(mut out, text, "workspace {w} snapshot", true)
				}
			}
		}
	}
	if history {
		let recs = oplog.List(dir) catch _ {
			[]oplog.Record{}
		}
		for rec in recs {
			if now - rec.Time > retention {
				continue
			}
			for rc in rec.Refs {
				addText(mut out, rc.Before + " " + rc.After, "operation {rec.Number}", false)
			}
			addText(mut out, rec.Snapshot, "operation {rec.Number}", false)
		}
	}
	return out
}

// children is what an object names: (id, a blob) pairs, from the object's own encoding.
fn children[S store.ObjectStore](st mut S, id object.Id) ![]root {
	mut out = []root{}
	let o = try st.Get(id)
	match o {
		Commit(c) => {
			out = append(out, rootOf(c.Tree, "", false))
			for p in c.Parents {
				out = append(out, rootOf(p, "", false))
			}
			for k in c.Conflicts {
				addText(mut out, k, "", true)
			}
		}
		Tree(es) => {
			for e in es {
				out = append(out, rootOf(e.Id, "", e.Mode != object.Mode.Dir))
			}
		}
		Tag(t) => {
			out = append(out, rootOf(t.Object, "", false))
		}
		Blob(_) => {
		}
	}
	return out
}

// Reach is every object reachable from roots in st, as a set of id bytes; an object the repository lacks (a lazy
// clone's) ends its branch of the walk.
fn Reach[S store.ObjectStore](st mut S, roots []root) !map[str]bool {
	mut seen = map[str]bool{}
	mut todo = []root{}
	for r in roots {
		todo = append(todo, r)
	}
	for len(todo) > 0 {
		let r = todo[len(todo) - 1]
		todo = todo[0:len(todo) - 1]
		let (_, done) = seen[r.raw]
		let id = idOf(r.raw)
		if done || !st.Has(id) {
			continue
		}
		seen[r.raw] = true
		if r.blob {
			continue
		}
		let kids = try children(mut st, id)
		for k in kids {
			let (_, d) = seen[k.raw]
			if !d {
				todo = append(todo, k)
			}
		}
	}
	return seen
}

// openChanges adds to live every version of each open change: one a ref names, or one with a version live already
// reaches (its earlier versions are its history, which reviews compare). A change whose branch was deleted is not
// open: its versions go once nothing else keeps them.
fn openChanges[S store.ObjectStore](st mut S, dir str, live mut map[str]bool) ! {
	mut named = map[str]bool{}
	let refs = change.NewRefs(dir)
	let all = try refs.List("refs/")
	for r in all {
		match r.Target {
			Change(c) => {
				named[c.Letters()] = true
			}
			Commit(_) => {
			}
		}
	}
	mut more = []root{}
	for f in filesIn(dir + "/changes") {
		let text = quarry.ReadFile(f) catch _ {
			continue
		}
		let letters = twine.ReplaceAll(f[len(dir) + 9:], "/", "")
		let ids = hexIds(text)
		let (_, open) = named[letters]
		mut keepIt = open
		for id in ids {
			let (_, hit) = live[id.Bytes()]
			if hit {
				keepIt = true
			}
		}
		if keepIt {
			for id in ids {
				more = append(more, rootOf(id, "change " + letters, false))
			}
		}
	}
	let extra = try Reach(mut st, more)
	for k, _ in extra {
		live[keep(k)] = true
	}
}

// rewrite replaces the live packs in dir/packs that hold an object gone() refuses with one pack of the rest of their
// objects, and retires them; it gives how many objects left and how many packs were retired. purge also deletes the
// retired copies at once.
fn rewrite(dir str, st mut store.Layered, packs mut []packfile.Pack, gone fn(str) bool, purge bool, now i64) !(i64, i64) {
	mut stay = []object.Id{}
	mut stayed = map[str]bool{}
	mut old = []str{}
	mut removed = 0
	for k in 0..len(packs) {
		mut p = packs[k]
		mut hit = false
		for i in 0..p.Count {
			if gone(p.IdAt(i).Bytes()) {
				hit = true
				break
			}
		}
		if !hit {
			continue
		}
		let name = p.Path[len(dir) + 7:len(p.Path) - 5]
		old = append(old, name)
		for i in 0..p.Count {
			let id = p.IdAt(i)
			if gone(id.Bytes()) {
				removed += 1
				continue
			}
			let (_, dup) = stayed[id.Bytes()]
			if !dup {
				stayed[id.Bytes()] = true
				stay = append(stay, id)
			}
		}
	}
	if len(old) == 0 {
		return 0, 0
	}
	mut made = ""
	if len(stay) > 0 {
		let np = try packfile.Write(mut st, stay, dir + "/packs")
		made = np.Path[len(dir) + 7:len(np.Path) - 5]
	}
	mut retire = []str{}
	for n in old {
		if n != made {
			retire = append(retire, n)
		}
	}
	_ = try packfile.Retire(dir + "/packs", retire, now / 1000000000)
	if purge {
		for n in retire {
			for ext in []str{".pack", ".idx", ".at"} {
				let p = dir + "/packs/retired/" + n + ext
				if quarry.Exists(p) {
					crash.Point()
					try quarry.Remove(p)
				}
			}
		}
	}
	return removed, len(retire)
}

// looseObject is a loose object's id (its bytes) and its file's mtime (ns).
type looseObject struct {
	raw   str
	mtime i64
}

// looseIds is every loose object in dir/objects.
fn looseIds(dir str) ![]looseObject {
	mut out = []looseObject{}
	let base = dir + "/objects"
	if !quarry.IsDir(base) {
		return out
	}
	let subs = try quarry.ReadDir(base)
	for sub in subs {
		if len(sub) != 2 {
			continue
		}
		let names = quarry.ReadDir(base + "/" + sub) catch _ {
			continue
		}
		for n in names {
			if len(n) != 62 {
				continue
			}
			let id = object.ParseId(sub + n) catch _ {
				continue
			}
			let info = quarry.Lstat(base + "/" + sub + "/" + n) catch _ {
				continue
			}
			out = append(out, looseObject{raw: id.Bytes(), mtime: info.Mtime})
		}
	}
	return out
}

// Prune removes from the .tit directory dir what nothing reaches: from the packs (rewritten, the old ones retired) and
// loose objects and chunks older than retention (ns). The oplog's records and the snapshots inside the retention
// window are roots too, so undo and restore keep working. The caller holds the repository lock. dry reports only.
fn Prune(dir str, retention i64, now i64, dry bool) !Result {
	let roots = try Roots(dir, true, retention, now)
	mut (st, packs) = try local(dir)
	mut live = try Reach(mut st, roots)
	try openChanges(mut st, dir, mut live)
	mut res = Result{Reachable: len(live), Objects: 0, Packs: 0, Loose: 0, Chunks: 0}
	let gone = fn(raw str) bool {
		let (_, ok) = live[raw]
		return !ok
	}
	if dry {
		for k in 0..len(packs) {
			let p = packs[k]
			for i in 0..p.Count {
				if gone(p.IdAt(i).Bytes()) {
					res.Objects += 1
				}
			}
		}
	} else {
		let (n, retired) = try rewrite(dir, mut st, mut packs, gone, false, now)
		res.Objects = n
		res.Packs = retired
	}
	// loose objects: unreachable and older than the retention window (a command may be writing new ones now)
	let objs = try looseIds(dir)
	mut keepChunks = map[str]bool{}
	for lo in objs {
		let id = idOf(lo.raw)
		let (_, reached) = live[lo.raw]
		if reached || now - lo.mtime <= retention {
			let cs = store.ManifestChunks(dir + "/objects", id) catch _ {
				[]str{}
			}
			for c in cs {
				keepChunks[c] = true
			}
			continue
		}
		res.Loose += 1
		if !dry {
			crash.Point()
			try quarry.Remove(store.LoosePath(dir + "/objects", id))
		}
	}
	// chunks no kept manifest names, older than the window
	for f in filesIn(dir + "/objects/chunks") {
		let parts = twine.Split(f, "/")
		if len(parts) < 2 {
			continue
		}
		let h = parts[len(parts) - 2] + parts[len(parts) - 1]
		let (_, wanted) = keepChunks[h]
		if wanted || len(h) != 64 {
			continue
		}
		let info = quarry.Lstat(f) catch _ {
			continue
		}
		if now - info.Mtime <= retention {
			continue
		}
		res.Chunks += 1
		if !dry {
			try quarry.Remove(f)
		}
	}
	return res
}

// Purge removes the objects ids from the .tit directory dir at once: from every live pack (rewritten, the old ones
// retired and deleted), from the retired packs, and from the loose store with the chunks no other manifest names. An
// object a ref, a change or a workspace reaches is refused (ErrReachable, naming what reaches it): rewrite the history
// first (tit rewrite). The oplog and the snapshots do not protect an object from purge; an undo that needs a purged
// object fails. The caller holds the repository lock; reason is recorded in dir/purged with the time.
fn Purge(dir str, ids []object.Id, reason str, now i64) !Result {
	let roots = try Roots(dir, false, 0, now)
	mut (st, packs) = try local(dir)
	mut live = try Reach(mut st, roots)
	try openChanges(mut st, dir, mut live)
	mut wanted = map[str]bool{}
	for id in ids {
		let (_, reached) = live[id.Bytes()]
		if reached {
			// what reaches it: each root's walk on its own
			for r in roots {
				let one = try Reach(mut st, []root{r})
				let (_, here) = one[id.Bytes()]
				if here {
					fail fault.Wrap(ErrReachable, "{id.Hex()} is reached from {r.from}")
				}
			}
			fail fault.Wrap(ErrReachable, id.Hex())
		}
		wanted[keep(id.Bytes())] = true
	}
	let gone = fn(raw str) bool {
		let (_, ok) = wanted[raw]
		return ok
	}
	mut res = Result{Reachable: len(live), Objects: 0, Packs: 0, Loose: 0, Chunks: 0}
	let (n, retired) = try rewrite(dir, mut st, mut packs, gone, true, now)
	res.Objects = n
	res.Packs = retired
	// retired packs a reader may still hold that contain one: deleted too
	let rdir = dir + "/packs/retired"
	if quarry.IsDir(rdir) {
		let names = try quarry.ReadDir(rdir)
		for f in names {
			if !twine.HasSuffix(f, ".pack") {
				continue
			}
			let p = packfile.Open(rdir + "/" + f) catch _ {
				continue
			}
			mut has = false
			for id in ids {
				if p.Has(id) {
					has = true
				}
			}
			if has {
				let base = rdir + "/" + f[0:len(f) - 5]
				for ext in []str{".pack", ".idx", ".at"} {
					if quarry.Exists(base + ext) {
						try quarry.Remove(base + ext)
					}
				}
				res.Packs += 1
			}
		}
	}
	// loose copies, and the chunks only they name
	mut drop = map[str]bool{}
	for id in ids {
		let p = store.LoosePath(dir + "/objects", id)
		if !quarry.Exists(p) {
			continue
		}
		let cs = store.ManifestChunks(dir + "/objects", id) catch _ {
			[]str{}
		}
		for c in cs {
			drop[c] = true
		}
		crash.Point()
		try quarry.Remove(p)
		res.Loose += 1
	}
	if len(drop) > 0 {
		let objs = try looseIds(dir)
		for lo in objs {
			let cs = store.ManifestChunks(dir + "/objects", idOf(lo.raw)) catch _ {
				[]str{}
			}
			for c in cs {
				delete(drop, c)
			}
		}
		for c, _ in drop {
			let p = store.ChunkPath(dir + "/objects", c)
			if quarry.Exists(p) {
				try quarry.Remove(p)
				res.Chunks += 1
			}
		}
	}
	mut line = "{now / 1000000000}"
	for id in ids {
		line = line + " " + id.Hex()
	}
	try quarry.AppendFile(dir + "/purged", line + " " + twine.ReplaceAll(reason, "\n", " ") + "\n")
	return res
}
