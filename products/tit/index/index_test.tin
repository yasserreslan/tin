package index

import "../ignore"
import "../object"
import "../store"
import "crucible"
import "fault"
import "quarry"
import "seal"

// Tests for the index and status (#783). The comparison with git status is products/tit/tests/programs/status_git.tin;
// status on several cores is products/tit/tests/programs/status_cores.tin.

fn fresh(name str) str {
	let d = "/tmp/tin-test-tit-index-" + name + "-" + seal.Hex(seal.RandomBytes(4))
	quarry.RemoveAll(d) catch _ {
	}
	quarry.MkdirAll(d) catch _ {
	}
	return d
}

fn entry(path str, body str) Entry {
	return Entry{Path: path, Hash: object.Hash(object.Kind.Blob, body).Bytes(), Mode: object.Mode.File, Stage: 0, Size: len(body), Mtime: 7, Ctime: 8, Inode: 9, Device: 10}
}

fn TestReadWrite(t mut crucible.T) {
	let d = fresh("rw")
	mut idx = New()
	idx.Set(entry("b/c.txt", "c"))
	idx.Set(entry("a.txt", "a"))
	idx.Set(entry("b/a.txt", "x"))
	idx.Set(entry("a.txt", "a2"))
	crucible.Equal(mut t, "replaced, not added", len(idx.Entries), 3)
	crucible.Equal(mut t, "sorted", idx.Entries[0].Path + " " + idx.Entries[1].Path + " " + idx.Entries[2].Path, "a.txt b/a.txt b/c.txt")
	t.NoFault("write", idx.Write(d + "/index"))
	let back = Read(d + "/index") catch err {
		t.Error(fault.Message(err))
		return
	}
	crucible.Equal(mut t, "count", len(back.Entries), 3)
	let a = back.Find("a.txt")
	t.True("found with its stat and id", a != nil && a.Mtime == 7 && a.Device == 10 && a.Id() == object.Hash(object.Kind.Blob, "a2"))
	t.True("absent", back.Find("nope") == nil)
	mut b2 = back
	b2.Remove("b/a.txt")
	crucible.Equal(mut t, "removed", len(b2.Entries), 2)
	let missing = Read(d + "/none") catch _ {
		Index{Entries: []Entry{entry("x", "y")}}
	}
	crucible.Equal(mut t, "a missing file is an empty index", len(missing.Entries), 0)
	// damaged files: faults
	let good = quarry.ReadFile(d + "/index") catch _ {
		""
	}
	mut damaged = 0
	for i in 0..len(good) {
		mut b = []u8(good)
		b[i] = b[i] ^ 1
		quarry.WriteFile(d + "/bad", str(b)) catch _ {
		}
		let (_, err) = Read(d + "/bad")
		if err != nil {
			damaged += 1
		}
	}
	crucible.Equal(mut t, "every damaged byte is caught (the hash covers them all)", damaged, len(good))
	quarry.RemoveAll(d) catch _ {
	}
}

fn TestTrees(t mut crucible.T) {
	mut s = store.NewMem()
	mut idx = New()
	for p in []str{"z.txt", "a/b/c.txt", "a/b/d.txt", "a/e.txt", "f.txt"} {
		idx.Set(entry(p, "body of " + p))
	}
	let tree = WriteTree(mut s, idx) catch err {
		t.Error(fault.Message(err))
		return
	}
	let back = FromTree(mut s, tree) catch err {
		t.Error(fault.Message(err))
		return
	}
	crucible.Equal(mut t, "five files", len(back.Entries), 5)
	mut same = true
	for i in 0..5 {
		if back.Entries[i].Path != idx.Entries[i].Path || back.Entries[i].Hash != idx.Entries[i].Hash {
			same = false
		}
	}
	t.True("the tree holds the index's files", same)
	let again = WriteTree(mut s, back) catch _ {
		object.NoId
	}
	t.True("writing it again gives the same tree", again == tree)
	mut conflicted = New()
	conflicted.Entries = append(conflicted.Entries, Entry{Path: "x", Hash: object.Hash(object.Kind.Blob, "x").Bytes(), Mode: object.Mode.File, Stage: 2, Size: 0, Mtime: 0, Ctime: 0, Inode: 0, Device: 0})
	let (_, err) = WriteTree(mut s, conflicted)
	t.True("conflicts cannot be written", err != nil && fault.Is(err, ErrConflicted))
}

fn TestStatusRefreshesStat(t mut crucible.T) {
	let d = fresh("refresh")
	quarry.WriteFile(d + "/a.txt", "a\n") catch _ {
	}
	mut s = store.NewMem()
	mut idx = New()
	t.NoFault("add", Add(mut idx, mut s, d, "a.txt"))
	let tree = WriteTree(mut s, idx) catch _ {
		object.NoId
	}
	// an index from the tree has no stat: status reads the file once and remembers its stat
	mut fresh = FromTree(mut s, tree) catch _ {
		New()
	}
	mut rules = ignore.New(d)
	let rep = Status(mut s, d, tree, mut fresh, mut rules) catch err {
		t.Error(fault.Message(err))
		return
	}
	crucible.Equal(mut t, "nothing changed", len(rep.Staged) + len(rep.Unstaged) + len(rep.Untracked), 0)
	let e = fresh.Find("a.txt")
	t.True("the stat is filled in", e != nil && e.Size == 2 && e.Inode != 0)
	quarry.RemoveAll(d) catch _ {
	}
}
