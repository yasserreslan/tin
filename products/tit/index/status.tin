package index

import "../cores"
import "../ignore"
import "../object"
import "../store"
import "fault"
import "quarry"
import "sift"
import "twine"

// Status (#783): what the next commit would change (the last commit's tree against the index) and what is not staged
// (the index against the working directory), plus the files no one tracks. A tracked file whose size, times, inode
// and device equal its entry's is not read; the others are hashed, on every core when the pool is running, and an
// unchanged file's new stat is written back into the index so the next status skips it.

// ErrUnreadable is the fault of a tracked file that cannot be read.
let ErrUnreadable = fault("cannot read a tracked file")

// Report is what status found, each list sorted by path.
type Report struct {
	Staged    []FileStatus
	Unstaged  []FileStatus
	Untracked []str
	// Restat says that idx got new stats (files found unchanged after all), worth writing back
	Restat bool
}

// flatten is the commit tree's files as their index entries, by path (a map of Entry rather than of a small struct
// holding object.Id: two fields of another package's value struct share a slot today, #847).
fn flatten[S store.ObjectStore](s mut S, tree object.Id) !map[str]Entry {
	let idx = try FromTree(mut s, tree)
	mut out = map[str]Entry{}
	for e in idx.Entries {
		out[e.Path] = e
	}
	return out
}

fn pathOf(f FileStatus) str {
	return match f {
		Added(p) => p
		Modified(p) => p
		Deleted(p) => p
		Renamed(_, p) => p
		TypeChanged(p) => p
		Untracked(p) => p
		Conflicted(p) => p
	}
}

fn sortStatus(xs mut []FileStatus) {
	sift.SortStableFunc(mut xs, fn(a FileStatus, b FileStatus) i64 {
		let pa = pathOf(a)
		let pb = pathOf(b)
		if pa < pb {
			return -1
		}
		if pa > pb {
			return 1
		}
		return 0
	})
}

fn isLink(m object.Mode) bool {
	return m == object.Mode.Link
}

// Status compares the commit tree head (object.NoId before the first commit), the index and the working directory
// at root. idx gets the new stat of files found unchanged.
fn Status[S store.ObjectStore](s mut S, root str, head object.Id, idx mut Index, rules mut ignore.Rules) !Report {
	mut rep = Report{Staged: []FileStatus{}, Unstaged: []FileStatus{}, Untracked: []str{}, Restat: false}
	// the index as a tree, hashed in memory: when it is the last commit's tree, nothing is staged and the commit's
	// trees need not be read at all
	mut conflictedAny = false
	for e in idx.Entries {
		if e.Stage != 0 {
			conflictedAny = true
		}
	}
	mut same = false
	if !conflictedAny && head != object.NoId {
		if idx.Tree == object.NoId {
			mut mem = store.NewMem()
			idx.Tree = WriteTree(mut mem, idx) catch _ {
				object.NoId
			}
		}
		same = idx.Tree == head
	}
	mut h = map[str]Entry{}
	if !same {
		h = try flatten(mut s, head)
	}
	// staged: the last commit against the index
	mut conflicted = map[str]bool{}
	mut inIndex = map[str]bool{}
	for e in idx.Entries {
		inIndex[e.Path] = true
		if e.Stage != 0 {
			if !conflicted[e.Path] {
				conflicted[e.Path] = true
				rep.Staged = append(rep.Staged, FileStatus.Conflicted(e.Path))
			}
			continue
		}
		if same {
			continue
		}
		let (he, ok) = h[e.Path]
		if !ok {
			rep.Staged = append(rep.Staged, FileStatus.Added(e.Path))
		} else if isLink(he.Mode) != isLink(e.Mode) {
			rep.Staged = append(rep.Staged, FileStatus.TypeChanged(e.Path))
		} else if he.Hash != e.Hash || he.Mode != e.Mode {
			rep.Staged = append(rep.Staged, FileStatus.Modified(e.Path))
		}
	}
	for path, _ in h {
		if !inIndex[path] {
			rep.Staged = append(rep.Staged, FileStatus.Deleted(path))
		}
	}
	// the working directory
	// what the walk finds of each index entry's file, by the entry's position
	mut infos = noInfos(len(idx.Entries))
	mut found = make([]bool, len(idx.Entries))
	try walk(root, "", mut infos, mut found, mut rules, idx, mut rep.Untracked)
	try compareFiles(root, mut idx, infos, found, mut rep)
	sortStatus(mut rep.Staged)
	sortStatus(mut rep.Unstaged)
	sift.Sort(mut rep.Untracked)
	return rep
}

// Unstaged is the index against the files alone, what diff needs: each entry's file is looked at (git diff's lstat of
// each), with no walk for untracked files and no tree read (#807).
fn Unstaged(root str, idx mut Index) !Report {
	mut rep = Report{Staged: []FileStatus{}, Unstaged: []FileStatus{}, Untracked: []str{}, Restat: false}
	mut infos = noInfos(len(idx.Entries))
	mut found = make([]bool, len(idx.Entries))
	for i in 0..len(idx.Entries) {
		if idx.Entries[i].Stage != 0 {
			continue
		}
		let (info, err) = quarry.Lstat(root + "/" + idx.Entries[i].Path)
		if err == nil && (info.Type == quarry.FileType.Regular || info.Type == quarry.FileType.Symlink) {
			infos[i] = info
			found[i] = true
		}
	}
	try compareFiles(root, mut idx, infos, found, mut rep)
	sortStatus(mut rep.Unstaged)
	return rep
}

// noInfos is n empty file infos, to be filled by position.
fn noInfos(n i64) []quarry.FileInfo {
	mut out = make([]quarry.FileInfo, 0, n)
	for i in 0..n {
		out = append(out, quarry.FileInfo{Type: quarry.FileType.Regular, Perm: 0, Size: 0, Mtime: 0, Ctime: 0, Inode: 0, Device: 0, Links: 0})
	}
	return out
}

// compareFiles adds to rep what differs between the index and the files found: deleted, of another type, or
// changed (read and hashed when the stat cache cannot tell); the entries found unchanged get their new stat.
fn compareFiles(root str, idx mut Index, infos []quarry.FileInfo, found []bool, rep mut Report) ! {
	// unstaged: the index against the files
	mut toHash = []str{}
	mut hashIdx = []i64{}
	for i in 0..len(idx.Entries) {
		let e = idx.Entries[i]
		if e.Stage != 0 {
			continue
		}
		let info = infos[i]
		if !found[i] {
			rep.Unstaged = append(rep.Unstaged, FileStatus.Deleted(e.Path))
			continue
		}
		let mode = ModeOf(info)
		if isLink(mode) != isLink(e.Mode) {
			rep.Unstaged = append(rep.Unstaged, FileStatus.TypeChanged(e.Path))
			continue
		}
		// the stat says unchanged, unless the file changed no earlier than the index was written: then a change of
		// the same size within the clock's granularity would look the same (git's racily clean entries)
		if info.Size == e.Size && info.Mtime == e.Mtime && info.Ctime == e.Ctime && info.Inode == e.Inode && info.Device == e.Device && mode == e.Mode && e.Mtime < idx.Written {
			continue
		}
		toHash = append(toHash, root + "/" + e.Path)
		hashIdx = append(hashIdx, i)
	}
	let hashed = cores.HashPaths(toHash)
	for k in 0..len(hashed) {
		let i = hashIdx[k]
		let e = idx.Entries[i]
		let info = infos[i]
		if len(hashed[k].Err) > 0 {
			fail fault.Wrap(ErrUnreadable, "{e.Path}: {hashed[k].Err}")
		}
		if hashed[k].Id.Bytes() != e.Hash || ModeOf(info) != e.Mode {
			rep.Unstaged = append(rep.Unstaged, FileStatus.Modified(e.Path))
		} else {
			idx.Entries[i] = Entry{Path: e.Path, Hash: e.Hash, Mode: e.Mode, Stage: 0, Size: info.Size, Mtime: info.Mtime, Ctime: info.Ctime, Inode: info.Inode, Device: info.Device}
			rep.Restat = true
		}
	}
}

// hasTracked reports whether the index tracks anything under dir/.
fn hasTracked(idx Index, dir str) bool {
	let prefix = dir + "/"
	let at = idx.lowerBound(prefix)
	return at < len(idx.Entries) && twine.HasPrefix(idx.Entries[at].Path, prefix)
}

fn walk(root str, dir str, infos mut []quarry.FileInfo, found mut []bool, rules mut ignore.Rules, idx Index, untracked mut []str) ! {
	mut full = root
	if len(dir) > 0 {
		full = root + "/" + dir
	}
	let entries = try quarry.ReadDirEntries(full)
	if len(dir) > 0 {
		mut hasIgnore = false
		for e in entries {
			if e.Name == ".gitignore" {
				hasIgnore = true
			}
		}
		try rules.EnterListed(dir, hasIgnore)
	}
	for e in entries {
		if len(dir) == 0 && (e.Name == ".tit" || e.Name == ".git") {
			continue
		}
		mut rel = e.Name
		if len(dir) > 0 {
			rel = dir + "/" + e.Name
		}
		if e.Type == quarry.FileType.Dir {
			if rules.Ignored(rel, true) && !hasTracked(idx, rel) {
				continue
			}
			try walk(root, rel, mut infos, mut found, mut rules, idx, mut untracked)
			continue
		}
		if e.Type != quarry.FileType.Regular && e.Type != quarry.FileType.Symlink {
			continue
		}
		// one lookup: a path the index has at any stage is tracked (a conflicted file has only stages 1 to 3); only a
		// tracked file's stat is wanted
		let at = idx.lowerBound(rel)
		if at < len(idx.Entries) && idx.Entries[at].Path == rel {
			infos[at] = try quarry.Lstat(root + "/" + rel)
			found[at] = true
		} else if !rules.Ignored(rel, false) {
			untracked = append(untracked, rel)
		}
	}
}
