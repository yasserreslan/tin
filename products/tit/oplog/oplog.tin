package oplog

import "../change"
import "argo"
import "fault"
import "flume"
import "mint"
import "quarry"
import "sift"
import "tide"
import "twine"

// The operation log (design/tit.md section 9; #780). Every command that changes refs records an operation before its
// effects are visible, so a crash leaves the repository before or after it, and any operation can be undone. Records
// hold ids as text (hex digits, change ids' letters), which keeps them readable JSON and keeps value structs out of
// them (#847).

// ErrMoved is the fault of an undo whose refs a later operation moved.
let ErrMoved = fault("moved by a later operation")

// ErrNothing is the fault of an undo or redo with nothing to act on.
let ErrNothing = fault("nothing to undo")

// OpNumber is an operation's number, from 1.
type OpNumber i64

// RefChange is one ref an operation changed: its value before and after, as a ref file writes it ("" for none).
type RefChange struct {
	Name   str
	Before str
	After  str
}

// Op is what an operation did; change ids are their letters, commits their hex digits.
type Op enum {
	Init
	Adopt(str)
	Commit(str)
	Amend(str)
	Rebase([]str)
	Merge(str)
	Switch(str)
	Branch(str)
	Tag(str)
	Fetch(str)
	Push(str)
	Undo(i64)
	Redo(i64)
	Restore(i64)
	Absorb
	Split(str)
	Move(str)
	Rewrite(str)
}

// Record is one operation as stored.
type Record struct {
	Number    i64
	Time      i64
	Workspace str
	Command   str
	Op        Op
	Refs      []RefChange
	Snapshot  str
}

fn opPath(dir str, n i64) str {
	mut digits = "{n}"
	for len(digits) < 16 {
		digits = "0" + digits
	}
	return dir + "/oplog/" + digits + ".op"
}

fn pendingPath(dir str) str {
	return dir + "/oplog/pending.op"
}

// List is every committed operation, oldest first.
fn List(dir str) ![]Record {
	mut out = []Record{}
	let d = dir + "/oplog"
	if !quarry.IsDir(d) {
		return out
	}
	let names = try quarry.ReadDir(d)
	sift.Sort(mut names)
	for name in names {
		if !twine.HasSuffix(name, ".op") || name == "pending.op" {
			continue
		}
		let text = try flume.ReadFile(d + "/" + name)
		mut r = Record{Number: 0, Time: 0, Workspace: "", Command: "", Op: Op.Init, Refs: []RefChange{}, Snapshot: ""}
		argo.Get(text, mut r) catch err {
			fail fault.Wrap(err, "{d}/{name}")
		}
		out = append(out, r)
	}
	return out
}

fn last(dir str) !i64 {
	let rs = try List(dir)
	if len(rs) == 0 {
		return 0
	}
	return rs[len(rs) - 1].Number
}

fn writeSynced(path str, text str) ! {
	if quarry.Exists(path) {
		try quarry.Remove(path)
	}
	mut w = try flume.CreateExcl(path)
	w.Str(text)
	let err = w.Sync()
	try w.Close()
	if err != nil {
		fail err
	}
}

fn target(text str) !?change.Target {
	if len(text) == 0 {
		return nil
	}
	let t = try change.ParseTarget(text)
	return t
}

fn textOf(t ?change.Target) str {
	if t == nil {
		return ""
	}
	return change.TargetText(t)
}

// A ref change named workspaces/<name>/HEAD is that workspace's HEAD rather than a ref: its texts are what the HEAD
// file holds ("ref: <branch>", or a commit). So switching, undoing a switch and recovering from a crash move HEAD
// the way they move refs.

// HeadRef is the name of a workspace's HEAD in ref changes.
fn HeadRef(workspace str) str {
	return "workspaces/" + workspace + "/HEAD"
}

// HeadText is a HEAD as its file and ref changes write it.
fn HeadText(h change.Head) str {
	return match h {
		Branch(name) => "ref: " + name
		Detached(t) => change.TargetText(t)
	}
}

fn isHead(name str) bool {
	return twine.HasPrefix(name, "workspaces/") && twine.HasSuffix(name, "/HEAD")
}

fn headText(dir str, name str) !str {
	let ws = dir + "/" + name[0:len(name) - 5]
	if !quarry.Exists(ws + "/HEAD") {
		return ""
	}
	let h = try change.ReadHead(ws)
	return HeadText(h)
}

fn writeHead(dir str, name str, text str) ! {
	let ws = dir + "/" + name[0:len(name) - 5]
	if twine.HasPrefix(text, "ref: ") {
		try change.WriteHead(ws, change.Head.Branch(text[5:]))
		return
	}
	let t = try change.ParseTarget(text)
	try change.WriteHead(ws, change.Head.Detached(t))
}

// current is what a ref (or a workspace's HEAD) holds now, as text.
fn current(dir str, refs change.Refs, name str) !str {
	if isHead(name) {
		return try headText(dir, name)
	}
	let cur = try refs.Get(name)
	if cur == nil {
		return ""
	}
	return change.TargetText(cur.Target)
}

// setRef moves a ref from what it holds now to text ("" deletes it), for recovery and rollback.
fn setRef(dir str, refs mut change.Refs, name str, text str) ! {
	if isHead(name) {
		if len(text) > 0 {
			let now = try headText(dir, name)
			if now != text {
				try writeHead(dir, name, text)
			}
		}
		return
	}
	let cur = try refs.Get(name)
	mut now ?change.Target = nil
	if cur != nil {
		now = cur.Target
	}
	if textOf(now) == text {
		return
	}
	let next = try target(text)
	try refs.Update(name, now, next)
}

// Tx is an operation being written. Apply moves its refs; Commit is its commit point; Close (for `use`) rolls back an
// operation that did not reach Commit.
type Tx struct {
	dir str
	rec Record
}

// Begin starts an operation in the .tit directory dir: it writes the record to pending.op and syncs it. The caller
// holds the repository lock (change.Lock) from before Begin until after Commit.
fn Begin(dir str, workspace str, command str, op Op, refs []RefChange) !Tx {
	try Recover(dir)
	try quarry.MkdirAll(dir + "/oplog")
	let n = try last(dir)
	let rec = Record{Number: n + 1, Time: tide.Wall(), Workspace: workspace, Command: command, Op: op, Refs: refs, Snapshot: ""}
	mut b = make([]u8, 0, 256)
	argo.Put(mut b, rec)
	try writeSynced(pendingPath(dir), str(b))
	return Tx{dir: dir, rec: rec}
}

// Number is the operation's number.
fn (tx Tx) Number() i64 {
	return tx.rec.Number
}

// Apply moves every ref of the operation from Before to After, each by compare-and-swap.
fn (tx Tx) Apply() ! {
	mut refs = change.NewRefs(tx.dir)
	for rc in tx.rec.Refs {
		if isHead(rc.Name) {
			let now = try headText(tx.dir, rc.Name)
			if now != rc.Before {
				fail fault.Wrap(change.ErrConflict, "{rc.Name} holds {now}, not {rc.Before}")
			}
			try writeHead(tx.dir, rc.Name, rc.After)
			continue
		}
		let before = try target(rc.Before)
		let after = try target(rc.After)
		try refs.Update(rc.Name, before, after)
	}
}

// Commit makes the operation current: the pending record is renamed to its number and the directory synced.
fn (tx Tx) Commit() ! {
	try quarry.Rename(pendingPath(tx.dir), opPath(tx.dir, tx.rec.Number))
	try quarry.Sync(tx.dir + "/oplog")
}

// Close rolls back an operation that did not reach Commit (its record is still pending).
fn (tx Tx) Close() ! {
	_ = try Recover(tx.dir)
}

// Recover finishes what a crash left: an operation still pending did not reach its commit point, so each ref it moved
// (each that holds its After) is set back to Before and the pending record is removed. True when there was one.
fn Recover(dir str) !bool {
	let p = pendingPath(dir)
	if !quarry.Exists(p) {
		return false
	}
	let text = try flume.ReadFile(p)
	mut r = Record{Number: 0, Time: 0, Workspace: "", Command: "", Op: Op.Init, Refs: []RefChange{}, Snapshot: ""}
	argo.Get(text, mut r) catch _ {
		// a record cut off before its sync: no ref moved yet
		try quarry.Remove(p)
		return true
	}
	mut refs = change.NewRefs(dir)
	for rc in r.Refs {
		// only a ref the operation moved goes back: one that still holds Before was not reached, and one that holds
		// something else was never the operation's (its compare-and-swap failed), so it is left alone
		let now = try current(dir, refs, rc.Name)
		if now == rc.After && now != rc.Before {
			try setRef(dir, mut refs, rc.Name, rc.Before)
		}
	}
	try quarry.Remove(p)
	return true
}

// Run records and applies an operation in one step: Begin, Apply, Commit, rolling back on any fault.
fn Run(dir str, workspace str, command str, op Op, refs []RefChange) !i64 {
	use tx = Begin(dir, workspace, command, op, refs)
	try tx.Apply()
	try tx.Commit()
	return tx.Number()
}

// undone is which operations are undone now: an Undo marks its target, a Redo clears it.
fn undone(rs []Record) map[i64]bool {
	mut out = map[i64]bool{}
	for r in rs {
		match r.Op {
			Undo(n) => {
				out[n] = true
			}
			Redo(n) => {
				out[n] = false
			}
			Init, Absorb => {
			}
			Adopt(_) => {
			}
			Commit(_) => {
			}
			Amend(_) => {
			}
			Rebase(_) => {
			}
			Merge(_) => {
			}
			Switch(_) => {
			}
			Branch(_) => {
			}
			Tag(_) => {
			}
			Fetch(_) => {
			}
			Push(_) => {
			}
			Restore(_) => {
			}
			Split(_) => {
			}
			Move(_) => {
			}
			Rewrite(_) => {
			}
		}
	}
	return out
}

fn isUndoOrRedo(op Op) bool {
	return match op {
		Undo(_) => true
		Redo(_) => true
		Init, Absorb => false
		Adopt(_) => false
		Commit(_) => false
		Amend(_) => false
		Rebase(_) => false
		Merge(_) => false
		Switch(_) => false
		Branch(_) => false
		Tag(_) => false
		Fetch(_) => false
		Push(_) => false
		Restore(_) => false
		Split(_) => false
		Move(_) => false
		Rewrite(_) => false
	}
}

fn reversed(rs []RefChange) []RefChange {
	mut out = []RefChange{}
	for rc in rs {
		out = append(out, RefChange{Name: rc.Name, Before: rc.After, After: rc.Before})
	}
	return out
}

// checkUnmoved fails with ErrMoved when a ref no longer holds what op left in it, naming the later operation (and its
// workspace) that moved it.
fn checkUnmoved(dir str, rs []Record, rec Record, refsOf []RefChange) ! {
	let refs = change.NewRefs(dir)
	for rc in refsOf {
		let now = try current(dir, refs, rc.Name)
		if now != rc.Before {
			mut who = "something outside the oplog"
			for later in rs {
				if later.Number <= rec.Number {
					continue
				}
				for lc in later.Refs {
					if lc.Name == rc.Name {
						who = "operation {later.Number} ({later.Command}) in workspace {later.Workspace}"
					}
				}
			}
			fail fault.Wrap(ErrMoved, "{rc.Name} was moved by {who}")
		}
	}
}

// UndoPlan is the operation Undo would reverse and the ref changes it would make, without making them.
fn UndoPlan(dir str, workspace str, n i64) !(Record, []RefChange) {
	let rs = try List(dir)
	let gone = undone(rs)
	mut pick = -1
	for i in 0..len(rs) {
		let r = rs[i]
		if n > 0 {
			if r.Number == n {
				pick = i
			}
		} else if r.Workspace == workspace && !isUndoOrRedo(r.Op) && !gone[r.Number] {
			pick = i
		}
	}
	if pick < 0 {
		fail fault.Wrap(ErrNothing, "no operation to undo in workspace {workspace}")
	}
	let rec = rs[pick]
	if gone[rec.Number] {
		fail fault.Wrap(ErrNothing, "operation {rec.Number} is already undone")
	}
	let back = reversed(rec.Refs)
	try checkUnmoved(dir, rs, rec, back)
	return rec, back
}

// Undo reverses operation n (0: the newest of the workspace that is not undone and is not itself an undo or redo). It
// refuses when a later operation moved any of its refs.
fn Undo(dir str, workspace str, n i64) !i64 {
	let (rec, back) = try UndoPlan(dir, workspace, n)
	return try Run(dir, workspace, "undo {rec.Number}", Op.Undo(rec.Number), back)
}

// RedoPlan is the operation Redo would apply again and its ref changes, without making them.
fn RedoPlan(dir str, workspace str) !(Record, []RefChange) {
	let rs = try List(dir)
	let gone = undone(rs)
	mut pick = -1
	for i in 0..len(rs) {
		let r = rs[i]
		if r.Workspace == workspace && gone[r.Number] {
			pick = i
		}
	}
	if pick < 0 {
		fail fault.Wrap(ErrNothing, "nothing to redo in workspace {workspace}")
	}
	let rec = rs[pick]
	try checkUnmoved(dir, rs, rec, rec.Refs)
	return rec, rec.Refs
}

// Redo applies again the newest operation of the workspace that an undo reversed.
fn Redo(dir str, workspace str) !i64 {
	let (rec, refs) = try RedoPlan(dir, workspace)
	return try Run(dir, workspace, "redo {rec.Number}", Op.Redo(rec.Number), refs)
}

// RestorePlan is the ref changes that put every ref back to its value right after operation n.
fn RestorePlan(dir str, n i64) ![]RefChange {
	let rs = try List(dir)
	mut at = map[str]str{}
	mut names = map[str]bool{}
	for r in rs {
		for rc in r.Refs {
			if !names[rc.Name] {
				names[rc.Name] = true
				at[rc.Name] = rc.Before
			}
			if r.Number <= n {
				at[rc.Name] = rc.After
			}
		}
	}
	let refs = change.NewRefs(dir)
	mut plan = []RefChange{}
	mut sorted = []str{}
	for name, _ in names {
		sorted = append(sorted, name)
	}
	sift.Sort(mut sorted)
	for name in sorted {
		let now = try current(dir, refs, name)
		// a HEAD is never removed: a workspace always has one
		if now != at[name] && !(isHead(name) && len(at[name]) == 0) {
			plan = append(plan, RefChange{Name: name, Before: now, After: at[name]})
		}
	}
	return plan
}

// LaterElsewhere is the operations after n made in other workspaces (a restore to n would reverse them too).
fn LaterElsewhere(dir str, workspace str, n i64) ![]Record {
	let rs = try List(dir)
	mut out = []Record{}
	for r in rs {
		if r.Number > n && r.Workspace != workspace {
			out = append(out, r)
		}
	}
	return out
}

// Restore puts every ref back to its value right after operation n, as one new operation.
fn Restore(dir str, workspace str, n i64) !i64 {
	let plan = try RestorePlan(dir, n)
	return try Run(dir, workspace, "restore {n}", Op.Restore(n), plan)
}

// ParseNumber reads an operation number written by tit oplog.
fn ParseNumber(s str) !i64 {
	return try mint.Atoi(s)
}
