package oplog

import "../change"
import "../object"
import "crucible"
import "fault"
import "quarry"
import "seal"

// Tests for the operation log (#780). A writer killed with SIGKILL mid-operation:
// products/tit/tests/programs/oplog_crash.tin.

fn fresh(name str) str {
	let d = "/tmp/tin-test-tit-oplog-" + name + "-" + seal.Hex(seal.RandomBytes(4))
	quarry.RemoveAll(d) catch _ {
	}
	quarry.MkdirAll(d) catch _ {
	}
	return d
}

fn c(s str) str {
	return object.Hash(object.Kind.Blob, s).Hex()
}

fn refText(dir str, name str) str {
	let refs = change.NewRefs(dir)
	let r = refs.Get(name) catch _ {
		nil
	}
	if r == nil {
		return ""
	}
	return change.TargetText(r.Target)
}

fn TestRunAndList(t mut crucible.T) {
	let d = fresh("run")
	let n1 = Run(d, "default", "commit", Op.Commit("kz"), []RefChange{RefChange{Name: "refs/heads/main", Before: "", After: c("1")}}) catch err {
		t.Error(fault.Message(err))
		return
	}
	let n2 = Run(d, "default", "commit", Op.Commit("kz"), []RefChange{RefChange{Name: "refs/heads/main", Before: c("1"), After: c("2")}}) catch err {
		t.Error(fault.Message(err))
		return
	}
	crucible.Equal(mut t, "numbers", "{n1} {n2}", "1 2")
	crucible.Equal(mut t, "the ref moved", refText(d, "refs/heads/main"), c("2"))
	let rs = List(d) catch _ {
		[]Record{}
	}
	crucible.Equal(mut t, "two records", len(rs), 2)
	let text = quarry.ReadFile(d + "/oplog/0000000000000002.op") catch _ {
		""
	}
	t.True("a readable record", len(text) > 0 && text[0] == '{')
	let (_, e) = Run(d, "default", "commit", Op.Commit("kz"), []RefChange{RefChange{Name: "refs/heads/main", Before: c("1"), After: c("3")}})
	t.True("a stale Before is a conflict", e != nil && fault.Is(e, change.ErrConflict))
	let after = List(d) catch _ {
		[]Record{}
	}
	crucible.Equal(mut t, "nothing recorded for it", len(after), 2)
	crucible.Equal(mut t, "no pending record left", quarry.Exists(d + "/oplog/pending.op"), false)
	quarry.RemoveAll(d) catch _ {
	}
}

fn TestCrashRecovery(t mut crucible.T) {
	let d = fresh("crash")
	_ = Run(d, "default", "init", Op.Init, []RefChange{RefChange{Name: "refs/heads/main", Before: "", After: c("1")}}) catch _ {
		0
	}
	// an operation that applies its refs and then stops before its commit point, as a crash would
	let tx = Begin(d, "default", "commit", Op.Commit("kz"), []RefChange{RefChange{Name: "refs/heads/main", Before: c("1"), After: c("2")}, RefChange{Name: "refs/heads/side", Before: "", After: c("x")}}) catch err {
		t.Error(fault.Message(err))
		return
	}
	t.NoFault("apply", tx.Apply())
	crucible.Equal(mut t, "moved before the commit point", refText(d, "refs/heads/main"), c("2"))
	let (was, err) = Recover(d)
	t.True("recovered", was && err == nil)
	crucible.Equal(mut t, "main back", refText(d, "refs/heads/main"), c("1"))
	crucible.Equal(mut t, "side gone", refText(d, "refs/heads/side"), "")
	let left = List(d) catch _ {
		[]Record{}
	}
	crucible.Equal(mut t, "only the first operation", len(left), 1)
	quarry.RemoveAll(d) catch _ {
	}
}

fn failing(d str) !i64 {
	use tx = Begin(d, "default", "commit", Op.Commit("kz"), []RefChange{RefChange{Name: "refs/heads/main", Before: c("1"), After: c("2")}})
	try tx.Apply()
	fail "something went wrong after the refs moved"
}

fn TestRollbackOnFault(t mut crucible.T) {
	let d = fresh("rollback")
	_ = Run(d, "default", "init", Op.Init, []RefChange{RefChange{Name: "refs/heads/main", Before: "", After: c("1")}}) catch _ {
		0
	}
	let (_, err) = failing(d)
	t.HasFault("the fault comes through", err)
	crucible.Equal(mut t, "use rolled the ref back", refText(d, "refs/heads/main"), c("1"))
	quarry.RemoveAll(d) catch _ {
	}
}

fn TestUndoPerWorkspace(t mut crucible.T) {
	let d = fresh("undo")
	_ = Run(d, "a", "branch a", Op.Branch("a"), []RefChange{RefChange{Name: "refs/heads/a", Before: "", After: c("a1")}}) catch _ {
		0
	}
	_ = Run(d, "b", "branch b", Op.Branch("b"), []RefChange{RefChange{Name: "refs/heads/b", Before: "", After: c("b1")}}) catch _ {
		0
	}
	{
		let (_, nerr) = Undo(d, "a", 0)
		t.NoFault("undo in a", nerr)
	}
	crucible.Equal(mut t, "a's branch undone", refText(d, "refs/heads/a"), "")
	crucible.Equal(mut t, "b's branch untouched", refText(d, "refs/heads/b"), c("b1"))
	let (_, again) = Undo(d, "a", 0)
	t.True("nothing more to undo in a", again != nil && fault.Is(again, ErrNothing))
	{
		let (_, nerr) = Redo(d, "a")
		t.NoFault("redo in a", nerr)
	}
	crucible.Equal(mut t, "a's branch back", refText(d, "refs/heads/a"), c("a1"))
	quarry.RemoveAll(d) catch _ {
	}
}

fn TestUndoRefusesWhenMoved(t mut crucible.T) {
	let d = fresh("moved")
	_ = Run(d, "a", "commit", Op.Commit("kz"), []RefChange{RefChange{Name: "refs/heads/x", Before: "", After: c("1")}}) catch _ {
		0
	}
	_ = Run(d, "b", "commit on top", Op.Commit("ly"), []RefChange{RefChange{Name: "refs/heads/x", Before: c("1"), After: c("2")}}) catch _ {
		0
	}
	let (_, err) = Undo(d, "a", 0)
	t.True("refused", err != nil && fault.Is(err, ErrMoved))
	if err != nil {
		t.True("names the other workspace", fault.Message(err) != "" && contains(fault.Message(err), "workspace b"))
	}
	crucible.Equal(mut t, "the ref stays", refText(d, "refs/heads/x"), c("2"))
	quarry.RemoveAll(d) catch _ {
	}
}

fn contains(s str, sub str) bool {
	for i in 0..len(s) - len(sub) + 1 {
		if s[i:i + len(sub)] == sub {
			return true
		}
	}
	return false
}

fn TestRestore(t mut crucible.T) {
	let d = fresh("restore")
	for i in 1..4 {
		mut before = ""
		if i > 1 {
			before = c("{i - 1}")
		}
		_ = Run(d, "a", "commit", Op.Commit("kz"), []RefChange{RefChange{Name: "refs/heads/main", Before: before, After: c("{i}")}}) catch _ {
			0
		}
	}
	_ = Run(d, "b", "branch", Op.Branch("t"), []RefChange{RefChange{Name: "refs/heads/t", Before: "", After: c("t")}}) catch _ {
		0
	}
	let later = LaterElsewhere(d, "a", 1) catch _ {
		[]Record{}
	}
	crucible.Equal(mut t, "a restore to 1 would reverse b's branch", len(later), 1)
	{
		let (_, nerr) = Restore(d, "a", 1)
		t.NoFault("restore to 1", nerr)
	}
	crucible.Equal(mut t, "main as after operation 1", refText(d, "refs/heads/main"), c("1"))
	crucible.Equal(mut t, "t as after operation 1 (absent)", refText(d, "refs/heads/t"), "")
	{
		let (_, nerr) = Undo(d, "a", 0)
		t.NoFault("undo the restore", nerr)
	}
	crucible.Equal(mut t, "main back to 3", refText(d, "refs/heads/main"), c("3"))
	quarry.RemoveAll(d) catch _ {
	}
}
