package store

import "../object"
import "fault"

// The ObjectStore shape and the stores behind it (design/tit.md sections 5 and 13; #777).

// ErrNotFound is the fault of a lookup of an id the store does not hold.
let ErrNotFound = fault("object not found")

// ObjectStore is where objects are kept: in memory, loose files, packs, or a remote. Reads are mut because a store
// may remember what it read (a cache, an open pack).
shape ObjectStore {
	Has(id object.Id) bool
	mut Get(id object.Id) !object.Object
	mut GetRaw(id object.Id) !(object.Kind, str)
	mut Put(o object.Object) !object.Id
	mut PutRaw(kind object.Kind, body str) !object.Id
}

type raw struct {
	kind object.Kind
	body str
}

// Mem is an ObjectStore in memory, for tests and for objects not yet written. Its map is keyed by the id's bytes:
// a struct field map keyed by object.Id crashes the compiler (#841).
type Mem struct {
	objs map[str]raw
}

// NewMem is an empty memory store.
fn NewMem() Mem {
	return Mem{objs: map[str]raw{}}
}

// Has reports whether the store holds the object.
fn (m Mem) Has(id object.Id) bool {
	let (_, ok) = m.objs[id.Bytes()]
	return ok
}

// GetRaw is the object's kind and body.
fn (m Mem) GetRaw(id object.Id) !(object.Kind, str) {
	let (r, ok) = m.objs[id.Bytes()]
	if !ok {
		fail fault.Wrap(ErrNotFound, id.Hex())
	}
	return r.kind, r.body
}

// Get is the decoded object.
fn (m Mem) Get(id object.Id) !object.Object {
	let (kind, body) = try m.GetRaw(id)
	return try object.Decode(kind, body)
}

// PutRaw stores a body of this kind and returns its id.
fn (m mut Mem) PutRaw(kind object.Kind, body str) !object.Id {
	let id = object.Hash(kind, body)
	m.objs[id.Bytes()] = raw{kind: kind, body: body}
	return id
}

// Put stores an object and returns its id.
fn (m mut Mem) Put(o object.Object) !object.Id {
	let body = try object.Body(o)
	return try m.PutRaw(object.KindOf(o), body)
}

// Matcher finds the objects whose ids start with a hex prefix, for short ids.
shape Matcher {
	Match(prefix str) ![]object.Id
}

// Match is every id in the store starting with the hex prefix.
fn (m Mem) Match(prefix str) ![]object.Id {
	mut out = []object.Id{}
	for raw, _ in m.objs {
		let id = try object.IdOf(raw)
		let h = id.Hex()
		if len(h) >= len(prefix) && h[0:len(prefix)] == prefix {
			out = append(out, id)
		}
	}
	return out
}
