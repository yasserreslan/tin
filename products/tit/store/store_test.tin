package store

import "../object"
import "crucible"
import "fault"
import "quarry"
import "seal"
import "squash"

// Tests for the stores (#777): one suite run against the memory and the loose store through the shape, damaged
// and lying files, layering and the decoded cache. Two processes writing the same objects at once:
// products/tit/tests/programs/store_race.tin.

fn person() object.Person {
	return object.Person{Name: "Ana", Email: "ana@x", When: 1700000000, Zone: 60}
}

fn suite[S ObjectStore](t mut crucible.T, label str, s mut S) {
	let (blob, e1) = s.Put(object.Object.Blob("hello, tin!\n"))
	t.NoFault(label + " put blob", e1)
	crucible.Equal(mut t, label + " blob id", blob.Hex(), "ebc9953649c58cea3a38091425f91d38386dfcc68628332dd79cc6c84b3556e6")
	let tree = object.Object.Tree([]object.Entry{object.Entry{Mode: object.Mode.File, Name: "README", Id: blob}})
	let (tid, e2) = s.Put(tree)
	t.NoFault(label + " put tree", e2)
	let c = object.CommitData{Tree: tid, Parents: []object.Id{}, Change: object.AdoptedChangeId("abc"), Author: person(), Committer: person(), GitHeaders: []str{}, Signature: "", Message: "first\n", Conflicts: []str{}}
	let (cid, e3) = s.Put(object.Object.Commit(c))
	t.NoFault(label + " put commit", e3)
	t.True(label + " has all three", s.Has(blob) && s.Has(tid) && s.Has(cid))
	let (again, e4) = s.Put(object.Object.Blob("hello, tin!\n"))
	t.NoFault(label + " put again", e4)
	t.True(label + " same id again", again == blob)
	let (kind, body, e5) = s.GetRaw(blob)
	t.NoFault(label + " get raw", e5)
	t.True(label + " raw blob", kind == object.Kind.Blob && body == "hello, tin!\n")
	let (back, e6) = s.Get(cid)
	t.NoFault(label + " get commit", e6)
	if e6 == nil {
		let b1 = object.Body(back) catch _ {
			"a"
		}
		let b2 = object.Body(object.Object.Commit(c)) catch _ {
			"b"
		}
		t.True(label + " commit round trip", b1 == b2)
	}
	let missing = object.Hash(object.Kind.Blob, "nothing")
	t.False(label + " missing", s.Has(missing))
	let (_, _, e7) = s.GetRaw(missing)
	t.True(label + " missing is ErrNotFound", e7 != nil && fault.Is(e7, ErrNotFound))
}

fn freshDir(name str) str {
	let d = "/tmp/tin-test-tit-store-" + name + "-" + seal.Hex(seal.RandomBytes(4))
	quarry.RemoveAll(d) catch _ {
	}
	return d
}

fn TestMem(t mut crucible.T) {
	mut m = NewMem()
	suite(mut t, "mem", mut m)
}

fn TestLoose(t mut crucible.T) {
	let d = freshDir("loose")
	mut l = NewLoose(d)
	suite(mut t, "loose", mut l)
	let names = quarry.ReadDir(d) catch _ {
		[]str{}
	}
	mut temps = 0
	for n in names {
		if len(n) > 4 && n[0:4] == "tmp-" {
			temps += 1
		}
	}
	crucible.Equal(mut t, "no temporary files left", temps, 0)
	quarry.RemoveAll(d) catch _ {
	}
}

fn TestLooseDamaged(t mut crucible.T) {
	let d = freshDir("damaged")
	mut l = NewLoose(d)
	let (id, err) = l.PutRaw(object.Kind.Blob, "some content")
	t.NoFault("put", err)
	let p = l.path(id)
	// another object's bytes under this id: the content does not match the id
	quarry.WriteFile(p, squash.Zlib("blob 5\x00other", 6)) catch _ {
	}
	let (_, _, e1) = l.GetRaw(id)
	t.True("wrong content is ErrCorrupt", e1 != nil && fault.Is(e1, object.ErrCorrupt))
	// not zlib at all
	quarry.WriteFile(p, "plain text") catch _ {
	}
	let (_, _, e2) = l.GetRaw(id)
	t.True("not zlib is ErrCorrupt", e2 != nil && fault.Is(e2, object.ErrCorrupt))
	// a header that claims 2^40 bytes: a fault, not a 1 TiB allocation
	quarry.WriteFile(p, squash.Zlib("blob 1099511627776\x00tiny", 6)) catch _ {
	}
	let (_, _, e3) = l.GetRaw(id)
	t.True("a lying size is a fault", e3 != nil)
	// a small file that inflates far past its bound
	mut zeros = make([]u8, 50000000)
	quarry.WriteFile(p, squash.Zlib("blob 50000000\x00" + str(zeros), 9)) catch _ {
	}
	let (_, _, e4) = l.GetRaw(id)
	t.True("a bomb past its bound is a fault", e4 != nil)
	quarry.RemoveAll(d) catch _ {
	}
}

fn TestLayeredAndCached(t mut crucible.T) {
	mut top = NewMem()
	mut bottom = NewMem()
	let deep = bottom.PutRaw(object.Kind.Blob, "in the bottom layer") catch _ {
		object.NoId
	}
	mut l = NewLayered([]dyn ObjectStore{top, bottom})
	let (written, err) = l.PutRaw(object.Kind.Blob, "written through the layers")
	t.NoFault("layered put", err)
	t.True("writes go to the first layer", top.Has(written) && !bottom.Has(written))
	t.True("reads find the second layer", l.Has(deep))
	let (_, body, e2) = l.GetRaw(deep)
	t.True("read from the second layer", e2 == nil && body == "in the bottom layer")
	mut c = NewCached(top, 1 << 20)
	suite(mut t, "cached", mut c)
	let tree = object.Object.Tree([]object.Entry{object.Entry{Mode: object.Mode.File, Name: "a", Id: written}})
	let tid = c.Put(tree) catch _ {
		object.NoId
	}
	let (_, e3) = c.Get(tid)
	t.NoFault("first get", e3)
	crucible.Equal(mut t, "cached after a get", len(c.objs) > 0, true)
}

fn TestMatch(t mut crucible.T) {
	let d = freshDir("match")
	mut l = NewLoose(d)
	mut m = NewMem()
	mut ids = []object.Id{}
	for i in 0..40 {
		let id = l.PutRaw(object.Kind.Blob, "object {i}") catch _ {
			object.NoId
		}
		_ = m.PutRaw(object.Kind.Blob, "object {i}") catch _ {
			object.NoId
		}
		ids = append(ids, id)
	}
	let one = ids[7].Hex()
	let a = l.Match(one[0:10]) catch _ {
		[]object.Id{}
	}
	let b = m.Match(one[0:10]) catch _ {
		[]object.Id{}
	}
	t.True("loose finds it by prefix", len(a) == 1 && a[0] == ids[7])
	t.True("mem finds it by prefix", len(b) == 1 && b[0] == ids[7])
	let wide = l.Match(one[0:1]) catch _ {
		[]object.Id{}
	}
	crucible.Equal(mut t, "one digit is too short for the loose store", len(wide), 0)
	quarry.RemoveAll(d) catch _ {
	}
}

// A file that compresses as far as zlib goes (8 MB of zeros) is read back within the loose store's memory budget.
fn TestLooseCompressible(t mut crucible.T) {
	let d = freshDir("zeros")
	mut l = NewLoose(d)
	let zeros = str(make([]u8, 8000000))
	let id = l.PutRaw(object.Kind.Blob, zeros) catch e {
		t.Error("put: {e}")
		return
	}
	let (_, body, err) = l.GetRaw(id)
	t.NoFault("read", err)
	crucible.Equal(mut t, "the same bytes", len(body), len(zeros))
	quarry.RemoveAll(d) catch _ {
	}
}
