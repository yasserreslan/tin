package store

import "../crash"
import "../object"
import "fault"
import "flume"
import "quarry"
import "seal"
import "squash"

// Loose objects (design/tit.md section 5): each object in its own file, .tit/objects/ab/cdef…, holding zlib of its
// encoding. A write goes to a temporary file that is synced and renamed into place, then the directory is synced,
// so a crash leaves the object whole or absent; two processes writing the same object end with one good file.

// Loose is an ObjectStore of loose object files under dir (a repository's .tit/objects).
type Loose struct {
	dir str
}

// NewLoose is the loose store in dir; the directory is made on the first write.
fn NewLoose(dir str) Loose {
	return Loose{dir: dir}
}

fn (l Loose) path(id object.Id) str {
	let raw = id.Bytes()
	if len(raw) != 32 {
		let h = id.Hex()
		return l.dir + "/" + h[0:2] + "/" + h[2:]
	}
	// built in one buffer: the hex, its slices and the joins were six strings for each lookup (#807)
	mut b = make([]u8, 0, len(l.dir) + 66)
	b = append(b, l.dir...)
	b = append(b, '/')
	for k in 0..32 {
		if k == 1 {
			b = append(b, '/')
		}
		b = append(b, hexDigits[i64(raw[k] >> 4)])
		b = append(b, hexDigits[i64(raw[k] & 15)])
	}
	return str(b)
}

const hexDigits = "0123456789abcdef"

// Has reports whether the store holds the object.
fn (l Loose) Has(id object.Id) bool {
	return quarry.Exists(l.path(id))
}

// GetRaw is the object's kind and body. The file is inflated within a memory budget proportional to its size (zlib
// inflates at most about 1032 times; the inflater's doubling buffers and its one copy of the result take up to 6 times
// the output), and the content is checked against its id.
fn (l Loose) GetRaw(id object.Id) !(object.Kind, str) {
	let p = l.path(id)
	if !quarry.Exists(p) {
		fail fault.Wrap(ErrNotFound, id.Hex())
	}
	let z = try quarry.ReadFile(p)
	let budget = 6 * 1032 * len(z) + 4194304
	// budget * 1: a bare name before { would read as a struct literal.
	let enc = limit memory budget * 1 {
		try squash.Unzlib(z, 1032 * len(z) + 1024)
	} catch err {
		fail fault.Wrap(object.ErrCorrupt, "{id.Hex()}: {fault.Message(err)}")
	}
	if isManifest(enc) {
		// a large blob kept in chunks (chunks.tin)
		let whole = try assemble(l.dir, enc)
		if object.Hash(object.Kind.Blob, whole) != id {
			fail fault.Wrap(object.ErrCorrupt, "{id.Hex()}: its chunks do not match its id")
		}
		return object.Kind.Blob, whole
	}
	let (kind, body) = try object.Split(enc)
	if object.Hash(kind, body) != id {
		fail fault.Wrap(object.ErrCorrupt, "{id.Hex()}: content does not match its id")
	}
	return kind, body
}

// Get is the decoded object.
fn (l Loose) Get(id object.Id) !object.Object {
	let (kind, body) = try l.GetRaw(id)
	return try object.Decode(kind, body)
}

// PutRaw writes a body of this kind and returns its id; an object already present is not written again.
fn (l mut Loose) PutRaw(kind object.Kind, body str) !object.Id {
	let id = object.Hash(kind, body)
	let p = l.path(id)
	if quarry.Exists(p) {
		return id
	}
	let sub = p[0:len(l.dir) + 3]
	try quarry.MkdirAll(sub)
	use tmp = newTemp(l.dir)
	try tmp.write(squash.Zlib("{object.KindName(kind)} {len(body)}\x00{body}", 6))
	crash.Point()
	try quarry.Rename(tmp.path, p)
	tmp.done[0] = true
	try quarry.Sync(sub)
	return id
}

// Put writes an object and returns its id.
fn (l mut Loose) Put(o object.Object) !object.Id {
	let body = try object.Body(o)
	return try l.PutRaw(object.KindOf(o), body)
}

// temp is a temporary file in a store's directory; Close removes it unless it was renamed into place (done).
type temp struct {
	path str
	done []bool
}

fn newTemp(dir str) !temp {
	try quarry.MkdirAll(dir)
	return temp{path: dir + "/tmp-" + seal.Hex(seal.RandomBytes(8)), done: []bool{false}}
}

// write fills the temporary file with data and syncs it.
fn (t temp) write(data str) ! {
	mut w = try flume.CreateExcl(t.path)
	w.Str(data)
	let err = w.Sync()
	try w.Close()
	if err != nil {
		fail err
	}
}

// Close removes the temporary file if it is still there.
fn (t temp) Close() ! {
	if !t.done[0] && quarry.Exists(t.path) {
		try quarry.Remove(t.path)
	}
}

// Match is every loose object whose id starts with the hex prefix (at least two digits).
fn (l Loose) Match(prefix str) ![]object.Id {
	mut out = []object.Id{}
	if len(prefix) < 2 {
		return out
	}
	let sub = l.dir + "/" + prefix[0:2]
	if !quarry.IsDir(sub) {
		return out
	}
	let names = try quarry.ReadDir(sub)
	for n in names {
		let h = prefix[0:2] + n
		if len(h) == 64 && h[0:len(prefix)] == prefix {
			let id = object.ParseId(h) catch _ {
				continue
			}
			out = append(out, id)
		}
	}
	return out
}
