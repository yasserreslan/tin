package store

import "../crash"
import "../object"
import "fault"
import "flume"
import "quarry"
import "seal"
import "squash"

// Large files in chunks (#803, design/tit.md section 5). A blob over ChunkAbove bytes keeps its id (the SHA-256 of
// its whole encoding, as every blob), so trees, commits, packs and git mirrors see an ordinary blob; only the loose
// store keeps it differently: its file holds a manifest, zlib of "chunks <size>\0" and then, for each chunk, its
// SHA-256 (32 bytes) and its length (8 bytes, little-endian), and each chunk is a file of its own,
// objects/chunks/ab/cdef… holding zlib of its bytes. Chunks are cut where the content says (FastCDC: a gear rolling
// hash, normalized around chunkAvg), so an edit in the middle of a large file changes the chunks around it and the
// others are stored once.

// ChunkAbove is the size above which a file is stored in chunks.
const ChunkAbove = 8 << 20

const chunkMin = 256 << 10

const chunkAvg = 1 << 20

const chunkMax = 4 << 20

// gearTable is the gear hash's 256 values: splitmix64 from a fixed seed, so every machine cuts the same chunks.
@wrap fn gearTable() []u64 {
	mut out = make([]u64, 256)
	mut x = u64(0x7469742d63646331)
	for i in 0..256 {
		x = x + u64(0x9e3779b97f4a7c15)
		mut z = x
		z = (z ^ (z >> 30)) * u64(0xbf58476d1ce4e5b9)
		z = (z ^ (z >> 27)) * u64(0x94d049bb133111eb)
		out[i] = z ^ (z >> 31)
	}
	return out
}

// cutAt is the length of the chunk that starts at data[at], with end - at bytes available (all that is left of the
// file, or at least chunkMax): FastCDC's normalized cut, a harder mask before chunkAvg and an easier one after.
@wrap fn cutAt(g []u64, data []u8, at i64, end i64) i64 {
	mut n = end - at
	if n <= chunkMin {
		return n
	}
	if n > chunkMax {
		n = chunkMax
	}
	mut normal = chunkAvg
	if n < normal {
		normal = n
	}
	let maskS = u64(0x3fffff) << 42
	let maskL = u64(0x3ffff) << 46
	mut fp = u64(0)
	mut i = chunkMin
	for i < normal {
		fp = (fp << 1) + g[i64(data[at + i])]
		if fp & maskS == 0 {
			return i + 1
		}
		i += 1
	}
	for i < n {
		fp = (fp << 1) + g[i64(data[at + i])]
		if fp & maskL == 0 {
			return i + 1
		}
		i += 1
	}
	return n
}

fn chunkPath(dir str, hash str) str {
	let h = seal.Hex([]u8(hash))
	return dir + "/chunks/" + h[0:2] + "/" + h[2:]
}

// putChunk stores one chunk (once) and gives its SHA-256.
fn putChunk(dir str, piece str) !str {
	let hash = str(seal.Sha256(piece))
	let p = chunkPath(dir, hash)
	if quarry.Exists(p) {
		return hash
	}
	let sub = p[0:len(p) - 63]
	try quarry.MkdirAll(sub)
	use tmp = newTemp(dir)
	try tmp.write(squash.Zlib(piece, 1))
	crash.Point()
	try quarry.Rename(tmp.path, p)
	tmp.done[0] = true
	return hash
}

fn appendLE64(out mut []u8, v i64) {
	for k in 0..8 {
		out = append(out, u8((v >> (8 * k)) & 255))
	}
}

fn le64At(s str, at i64) i64 {
	mut v = 0
	for k in 0..8 {
		v = v | (i64(s[at + k]) << (8 * k))
	}
	return v
}

// PutFile stores the file at path as a blob, reading it once: in chunks when it is larger than ChunkAbove (each
// chunk compressed in an arena, so a file of any size takes the same memory), whole otherwise.
fn (l mut Loose) PutFile(path str) !object.Id {
	let info = try quarry.Lstat(path)
	if info.Size <= ChunkAbove {
		let body = try flume.ReadFile(path)
		return try l.PutRaw(object.Kind.Blob, body)
	}
	let size = info.Size
	let dir = l.dir
	let g = gearTable()
	mut r = try flume.Open(path)
	mut h = seal.NewSha256()
	h.WriteStr("blob {size}\x00")
	mut buf = make([]u8, 2 * chunkMax)
	mut block = make([]u8, 1 << 20)
	mut fill = 0
	mut at = 0
	mut eof = false
	mut total = 0
	mut manifest = make([]u8, 0, 64 + 40 * (size / chunkAvg + 8))
	let head = "chunks {size}\x00"
	for k in 0..len(head) {
		manifest = append(manifest, head[k])
	}
	for {
		// keep at least chunkMax bytes ahead of the cut, or everything that is left
		if !eof && fill - at < chunkMax {
			if at > 0 {
				copy(buf[0:fill - at], buf[at:fill])
				fill = fill - at
				at = 0
			}
			for !eof && fill + len(block) <= len(buf) {
				let n = r.Read(mut block) catch e {
					r.Close()
					fail e
				}
				if n == 0 {
					eof = true
				}
				copy(buf[fill:fill + n], block[0:n])
				fill += n
				total += n
			}
		}
		if at == fill {
			break
		}
		let n = cutAt(g, buf, at, fill)
		let piece = buf[at:at + n]
		_ = try h.Write(piece)
		let hash = try arena {
			try putChunk(dir, str(piece))
		}
		for k in 0..32 {
			manifest = append(manifest, hash[k])
		}
		appendLE64(mut manifest, n)
		at += n
	}
	r.Close()
	if total != size {
		fail fault.Wrap(object.ErrCorrupt, "{path} changed while it was read: {total} bytes, not {size}")
	}
	let id = try object.IdOf(str(h.Sum()))
	let p = l.path(id)
	if quarry.Exists(p) {
		return id
	}
	let sub = p[0:len(l.dir) + 3]
	try quarry.MkdirAll(sub)
	use tmp = newTemp(l.dir)
	try tmp.write(squash.Zlib(str(manifest), 6))
	crash.Point()
	try quarry.Rename(tmp.path, p)
	tmp.done[0] = true
	try quarry.Sync(sub)
	return id
}

// isManifest reports whether a loose file's inflated content is a chunk manifest.
fn isManifest(enc str) bool {
	return len(enc) > 7 && enc[0:7] == "chunks "
}

// assemble is the blob a manifest names, each chunk checked against its hash.
fn assemble(dir str, enc str) !str {
	let nul = indexNul(enc)
	if nul < 0 {
		fail fault.Wrap(object.ErrCorrupt, "a chunk manifest without its size")
	}
	let size = parseSize(enc[7:nul]) catch _ {
		fail fault.Wrap(object.ErrCorrupt, "a chunk manifest with a bad size")
	}
	let list = enc[nul + 1:]
	if len(list) % 40 != 0 {
		fail fault.Wrap(object.ErrCorrupt, "a chunk manifest of {len(list)} bytes")
	}
	mut out = make([]u8, 0, size)
	mut i = 0
	for i < len(list) {
		let hash = list[i:i + 32]
		let n = le64At(list, i + 32)
		if n <= 0 || n > chunkMax || len(out) + n > size {
			fail fault.Wrap(object.ErrCorrupt, "a chunk of {n} bytes")
		}
		let p = chunkPath(dir, hash)
		if !quarry.Exists(p) {
			fail fault.Wrap(ErrNotFound, "chunk " + seal.Hex([]u8(hash)))
		}
		let piece = try arena {
			let z = try quarry.ReadFile(p)
			let b = squash.Unzlib(z, n + 1) catch err {
				fail fault.Wrap(object.ErrCorrupt, "chunk " + seal.Hex([]u8(hash)) + ": " + fault.Message(err))
			}
			if len(b) != n || str(seal.Sha256(b)) != hash {
				fail fault.Wrap(object.ErrCorrupt, "chunk " + seal.Hex([]u8(hash)) + " does not match its hash")
			}
			[]u8(b)
		}
		out = append(out, piece...)
		i += 40
	}
	if len(out) != size {
		fail fault.Wrap(object.ErrCorrupt, "chunks of {len(out)} bytes, not {size}")
	}
	return str(out)
}

fn indexNul(s str) i64 {
	for i in 0..len(s) {
		if s[i] == 0 {
			return i
		}
	}
	return -1
}

fn parseSize(s str) !i64 {
	if len(s) == 0 || len(s) > 18 {
		fail object.ErrCorrupt
	}
	mut v = 0
	for i in 0..len(s) {
		if s[i] < '0' || s[i] > '9' {
			fail object.ErrCorrupt
		}
		v = v * 10 + i64(s[i] - '0')
	}
	return v
}
