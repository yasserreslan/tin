package crash

import "atomic"
import "quarry"

// Crash points (#806). With TIT_CRASH_AT=n in its environment, a tit process ends at once (status 86, nothing
// flushed or cleaned up, as a power cut would leave it) at the n-th crash point it reaches: each is a write that the
// data on the disk depends on, just before it lands (an object, a pack, a ref, HEAD, an operation record, an index).
// The crash harness (tests/scripts/crash.sh) runs a command once for every n and checks that the repository is then
// exactly as before the command or as after it.

// Status is the exit status of a process a crash point ended.
const Status = 86

fn crashLimit() i64 {
	let s = quarry.Getenv("TIT_CRASH_AT")
	mut n = 0
	for i in 0..len(s) {
		if s[i] < '0' || s[i] > '9' {
			return 0
		}
		n = n * 10 + i64(s[i] - '0')
	}
	return n
}

shared let at = atomic.NewInt(crashLimit())

shared let seen = atomic.NewInt(0)

// Point is one crash point: the process ends here if it is the n-th of TIT_CRASH_AT=n.
fn Point() {
	let n = at.Load()
	if n <= 0 {
		return
	}
	if seen.Add(1) == n {
		quarry.Exit(Status)
	}
}
