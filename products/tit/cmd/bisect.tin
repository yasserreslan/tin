package cmd

import "../change"
import "../identity"
import "../ignore"
import "../index"
import "../object"
import "../revwalk"
import "fault"
import "quarry"
import "spawn"

// verify and bisect --run (#801).

// BisectArgs are tit bisect's arguments.
type BisectArgs struct {
	Run  str
	Good str
	Bad  str
}

fn doVerify(g Global, rev str, o mut Out) ! {
	mut r = try open(g)
	let parsed = try revwalk.Parse(rev)
	mut starts = []object.Id{}
	mut hide = []object.Id{}
	mut single = true
	match parsed {
		Range(a, b) => {
			let ai = try r.resolveRev(a)
			let bi = try r.resolveRev(b)
			hide = append(hide, ai)
			starts = append(starts, bi)
			single = false
		}
		Head => {
		}
		Name(_) => {
		}
		Short(_) => {
		}
		Change(_) => {
		}
		Git(_) => {
		}
		Ancestor(_, _) => {
		}
		Parent(_, _) => {
		}
		Symmetric(_, _) => {
		}
	}
	if single {
		let id = try r.resolveRev(parsed)
		starts = append(starts, id)
	}
	let ids = try revwalk.Walk(mut r.Store, starts, hide, revwalk.Order.Topo, 0)
	mut bad = 0
	for id in ids {
		let c = try commitData(mut r, id)
		mut from = id
		if len(c.Parents) > 0 {
			from = c.Parents[0]
		}
		let keys = try identity.SignersAt(mut r.Store, from)
		mut what = ""
		if len(keys) == 0 {
			if len(c.Signature) == 0 {
				what = "unsigned, no signers file"
			} else {
				what = "signed, no signers file to check it against"
			}
		} else {
			let err = identity.VerifyCommit(c, keys)
			if err == nil {
				what = "good signature of " + c.Committer.Email
			} else {
				what = paint(g, "31", "BAD: " + fault.Message(err))
				bad += 1
			}
		}
		o.Line(id.Hex()[0:12] + " " + what + "  " + firstLine(c.Message))
	}
	if bad > 0 {
		fail fault.Wrap(identity.ErrBadSignature, "{bad} of {len(ids)} commits")
	}
}

// runAt checks out a commit's files and runs the command there: true when it passes (status 0), false when it fails;
// status 125 skips the commit (it cannot be tested), as with git bisect run.
fn runAt(r mut Repo, from object.Id, id object.Id, command str) !(object.Id, i64) {
	let tree = try r.treeOf(id)
	try moveTo(mut r, from, tree, false)
	mut p = try spawn.Start(spawn.Cmd{Argv: []str{"/bin/sh", "-c", command}, Env: spawn.Env.Inherit, Dir: r.Ws.Root, Stdin: spawn.Stdio.Null, Stdout: spawn.Stdio.Inherit, Stderr: spawn.Stdio.Inherit, MaxOutput: 0, Input: ""})
	let code = try p.Wait()
	return tree, code
}

fn doBisect(g Global, a BisectArgs, o mut Out) ! {
	mut r = try open(g)
	use lock = change.Lock(r.Ws.Store)
	// the working directory must hold nothing unsaved: bisect checks out other commits' files
	mut idx = try r.readIndex()
	let headTreeId = try headTree(mut r)
	mut rules = try ignore.Load(r.Ws.Root)
	let rep = try index.Status(mut r.Store, r.Ws.Root, headTreeId, mut idx, mut rules)
	if len(rep.Staged) + len(rep.Unstaged) > 0 {
		fail "bisect checks out other commits: commit or put away your changes first"
	}
	let good = try r.resolve(a.Good)
	mut badRev = a.Bad
	if len(badRev) == 0 {
		badRev = "HEAD"
	}
	let bad = try r.resolve(badRev)
	// the candidates: the first-parent line from bad back to good, oldest first; bad is known to fail
	let line = try revwalk.Walk(mut r.Store, []object.Id{bad}, []object.Id{good}, revwalk.Order.FirstParent, 0)
	if len(line) == 0 {
		fail "{a.Good} is not an ancestor of {badRev}"
	}
	mut cands = []object.Id{}
	for i in 0..len(line) {
		cands = append(cands, line[len(line) - 1 - i])
	}
	mut lo = 0
	mut hi = len(cands) - 1
	mut runs = 0
	mut at = headTreeId
	mut skipped = map[i64]bool{}
	for lo < hi {
		mut mid = (lo + hi) / 2
		for mid < hi && skipped[mid] {
			mid += 1
		}
		if mid >= hi {
			break
		}
		let (tree, code) = try runAt(mut r, at, cands[mid], a.Run)
		at = tree
		runs += 1
		let c = try commitData(mut r, cands[mid])
		if code == 0 {
			quarry.Eprintln("tit bisect: {cands[mid].Hex()[0:12]} passes  " + firstLine(c.Message))
			lo = mid + 1
		} else if code == 125 {
			quarry.Eprintln("tit bisect: {cands[mid].Hex()[0:12]} skipped  " + firstLine(c.Message))
			skipped[mid] = true
		} else {
			quarry.Eprintln("tit bisect: {cands[mid].Hex()[0:12]} fails  " + firstLine(c.Message))
			hi = mid
		}
	}
	// back where it started
	try moveTo(mut r, at, headTreeId, false)
	let first = cands[hi]
	let c = try commitData(mut r, first)
	o.Line("The first failing change is " + c.Change.Letters()[0:12] + " (" + first.Hex()[0:12] + "), found in {runs} runs:")
	o.Line("    " + firstLine(c.Message))
}
