package cmd

import "../change"
import "../object"
import "../oplog"
import "crucible"
import "fault"
import "quarry"
import "twine"

// Tests for saving work (#790); the comparison with git is products/tit/tests/sessions/save.sh.

fn runErr(args []str) str {
	let (g, c, perr) = Parse(args)
	if perr != nil {
		return fault.Message(perr)
	}
	mut o = Out{buf: []u8{}}
	mut msg = ""
	run(g, c, mut o) catch e {
		msg = fault.Message(e)
	}
	return msg
}

fn fresh2(t mut crucible.T, name str) str {
	let d = fresh(name)
	_ = runArgs(mut t, []str{"init", d})
	_ = runArgs(mut t, []str{"-C", d, "config", "set", "user.name", "Ada"})
	_ = runArgs(mut t, []str{"-C", d, "config", "set", "user.email", "ada@example.com"})
	return d
}

fn TestAmendKeepsTheChange(t mut crucible.T) {
	quarry.Setenv("HOME", "/nonexistent") catch _ {
	}
	quarry.Setenv("XDG_CONFIG_HOME", "/nonexistent") catch _ {
	}
	let d = fresh2(mut t, "amend")
	crucible.Equal(mut t, "nothing staged", runErr([]str{"-C", d, "commit", "-m", "x"}), "nothing to commit: stage files with tit add")
	quarry.WriteFile(d + "/a.txt", "one\n") catch _ {
	}
	_ = runArgs(mut t, []str{"-C", d, "add", "a.txt"})
	let out = runArgs(mut t, []str{"-C", d, "commit", "-m", "first"})
	t.True(out, twine.HasPrefix(out, "[main (root commit) ") && twine.HasSuffix(out, "] first\n"))
	crucible.Equal(mut t, "no change", runErr([]str{"-C", d, "commit", "-m", "again"}), "nothing to commit: the staged files match the last commit (tit add stages changes)")
	mut r = open(Global{Json: false, Trace: false, Dir: d, Color: false}) catch e {
		t.Error("open: {e}")
		return
	}
	let c1 = r.resolve("HEAD") catch _ {
		object.NoId
	}
	let d1 = commitData(mut r, c1) catch _ {
		object.CommitData{Tree: object.NoId, Parents: []object.Id{}, Change: object.NewChangeId(), Author: object.Person{Name: "", Email: "", When: 0, Zone: 0}, Committer: object.Person{Name: "", Email: "", When: 0, Zone: 0}, GitHeaders: []str{}, Signature: "", Message: "", Conflicts: []str{}}
	}
	quarry.WriteFile(d + "/a.txt", "one, better\n") catch _ {
	}
	_ = runArgs(mut t, []str{"-C", d, "commit", "-a", "--amend"})
	let c2 = r.resolve("HEAD") catch _ {
		object.NoId
	}
	t.True("a new commit", c2 != c1)
	let d2 = commitData(mut r, c2) catch _ {
		d1
	}
	t.True("the same change", d2.Change == d1.Change)
	crucible.Equal(mut t, "the message kept", d2.Message, "first\n")
	crucible.Equal(mut t, "no parents still", len(d2.Parents), 0)
	let vs = change.Versions(d + "/.tit", d1.Change) catch _ {
		[]change.Version{}
	}
	crucible.Equal(mut t, "two versions", len(vs), 2)
	let ops = oplog.List(d + "/.tit") catch _ {
		[]oplog.Record{}
	}
	crucible.Equal(mut t, "two operations", len(ops), 2)
	if len(ops) == 2 {
		mut kinds = ""
		for op in ops {
			kinds = kinds + match op.Op {
				Commit(_) => "commit "
				Amend(_) => "amend "
				Init, Adopt(_), Rebase(_), Merge(_), Switch(_), Branch(_), Tag(_), Fetch(_), Push(_), Undo(_), Redo(_), Restore(_), Absorb, Split(_), Move(_), Rewrite(_) => "other "
			}
		}
		crucible.Equal(mut t, "a commit, then an amend", kinds, "commit amend ")
	}
}

fn TestEditorMessage(t mut crucible.T) {
	let d = fresh2(mut t, "editor")
	quarry.WriteFile(d + "/a.txt", "one\n") catch _ {
	}
	_ = runArgs(mut t, []str{"-C", d, "add", "."})
	quarry.Setenv("TIT_EDITOR", "printf 'from the editor  \\n\\n\\n# a comment\\nbody\\n' >") catch _ {
	}
	let out = runArgs(mut t, []str{"-C", d, "commit"})
	t.True(out, twine.HasSuffix(out, "] from the editor\n"))
	let body = runArgs(mut t, []str{"-C", d, "cat", "HEAD"})
	t.True(body, twine.HasSuffix(body, "\n\nfrom the editor\n\nbody\n"))
	quarry.WriteFile(d + "/a.txt", "two\n") catch _ {
	}
	quarry.Setenv("TIT_EDITOR", "true") catch _ {
	}
	crucible.Equal(mut t, "an empty message", runErr([]str{"-C", d, "commit", "-a"}), "the message is empty: the commit was not made")
	quarry.Setenv("TIT_EDITOR", "false") catch _ {
	}
	crucible.Equal(mut t, "the editor failed", runErr([]str{"-C", d, "commit", "-a"}), "the editor (false) exited with status 1; the commit was not made")
}

fn TestRmAndMv(t mut crucible.T) {
	let d = fresh2(mut t, "rmmv")
	quarry.MkdirAll(d + "/dir/sub") catch _ {
	}
	quarry.WriteFile(d + "/dir/sub/x.txt", "x\n") catch _ {
	}
	quarry.WriteFile(d + "/a.txt", "a\n") catch _ {
	}
	_ = runArgs(mut t, []str{"-C", d, "add", "."})
	_ = runArgs(mut t, []str{"-C", d, "commit", "-m", "files"})
	crucible.Equal(mut t, "a directory needs -r", runErr([]str{"-C", d, "rm", "dir"}), "dir is a directory: rm -r removes it: see tit help")
	quarry.WriteFile(d + "/a.txt", "edited\n") catch _ {
	}
	crucible.Equal(mut t, "unstaged changes", runErr([]str{"-C", d, "rm", "a.txt"}), "a.txt has changes that are not staged: rm -f removes it anyway, rm --cached keeps the file")
	t.True("kept", quarry.Exists(d + "/a.txt"))
	crucible.Equal(mut t, "untracked", runErr([]str{"-C", d, "rm", "nope.txt"}), "nope.txt is not tracked")
	_ = runArgs(mut t, []str{"-C", d, "mv", "dir", "moved"})
	t.True("moved on the disk", quarry.Exists(d + "/moved/sub/x.txt") && !quarry.Exists(d + "/dir"))
	quarry.MkdirAll(d + "/into") catch _ {
	}
	_ = runArgs(mut t, []str{"-C", d, "mv", "moved/sub/x.txt", "into"})
	t.True("into a directory", quarry.Exists(d + "/into/x.txt"))
	t.False("emptied directories go", quarry.Exists(d + "/moved"))
	let st = runArgs(mut t, []str{"-C", d, "status", "-s"})
	crucible.Equal(mut t, "status", st,  " M a.txt\nR  dir/sub/x.txt -> into/x.txt\n")
	_ = runArgs(mut t, []str{"-C", d, "rm", "-r", "-f", "into"})
	t.False("removed", quarry.Exists(d + "/into"))
	crucible.Equal(mut t, "outside", runErr([]str{"-C", d, "add", "/etc/hosts"}), "/etc/hosts is outside the working directory " + d + ": see tit help")
}
