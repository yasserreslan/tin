package cmd

import "../worktree"
import "crucible"
import "fault"
import "quarry"
import "twine"

// Tests for branches and merging (#791); the comparison with git is products/tit/tests/sessions/branch.sh.

fn TestSwitchRefuses(t mut crucible.T) {
	let d = fresh2(mut t, "switch")
	quarry.WriteFile(d + "/a.txt", "one\n") catch _ {
	}
	_ = runArgs(mut t, []str{"-C", d, "add", "a.txt"})
	_ = runArgs(mut t, []str{"-C", d, "commit", "-m", "one"})
	_ = runArgs(mut t, []str{"-C", d, "switch", "-c", "side"})
	quarry.WriteFile(d + "/a.txt", "side\n") catch _ {
	}
	_ = runArgs(mut t, []str{"-C", d, "commit", "-am", "side"})
	_ = runArgs(mut t, []str{"-C", d, "switch", "main"})
	let back = quarry.ReadFile(d + "/a.txt") catch _ {
		""
	}
	crucible.Equal(mut t, "back on main", back, "one\n")
	quarry.WriteFile(d + "/a.txt", "an edit\n") catch _ {
	}
	let e1 = runErr([]str{"-C", d, "switch", "side"})
	t.True("an unsaved edit blocks: " + e1, twine.Contains(e1, fault.Message(worktree.ErrDirty)) && twine.Contains(e1, "a.txt"))
	_ = runArgs(mut t, []str{"-C", d, "add", "a.txt"})
	let e2 = runErr([]str{"-C", d, "switch", "side"})
	t.True("a staged edit blocks: " + e2, twine.Contains(e2, "staged: a.txt"))
	crucible.Equal(mut t, "no such branch", runErr([]str{"-C", d, "switch", "nope"}), "there is no branch nope (switch -c makes one; --detach goes to a commit)")
	crucible.Equal(mut t, "unmerged", runErr([]str{"-C", d, "branch", "-d", "side"}), "side is not merged into HEAD: branch -D deletes it anyway")
	crucible.Equal(mut t, "current", runErr([]str{"-C", d, "branch", "-d", "main"}), "main is the current branch: switch to another first")
	_ = runArgs(mut t, []str{"-C", d, "branch", "-D", "side"})
	crucible.Equal(mut t, "deleted", runArgs(mut t, []str{"-C", d, "branch"}), "* main\n")
}

fn TestMergeStates(t mut crucible.T) {
	let d = fresh2(mut t, "merge")
	quarry.WriteFile(d + "/a.txt", "one\n") catch _ {
	}
	_ = runArgs(mut t, []str{"-C", d, "add", "a.txt"})
	_ = runArgs(mut t, []str{"-C", d, "commit", "-m", "one"})
	_ = runArgs(mut t, []str{"-C", d, "branch", "same"})
	crucible.Equal(mut t, "up to date", runArgs(mut t, []str{"-C", d, "merge", "same"}), "Already up to date.\n")
	_ = runArgs(mut t, []str{"-C", d, "switch", "-c", "x"})
	quarry.WriteFile(d + "/a.txt", "x\n") catch _ {
	}
	_ = runArgs(mut t, []str{"-C", d, "commit", "-am", "x"})
	_ = runArgs(mut t, []str{"-C", d, "switch", "main"})
	quarry.WriteFile(d + "/a.txt", "main\n") catch _ {
	}
	_ = runArgs(mut t, []str{"-C", d, "commit", "-am", "main"})
	let e = runErr([]str{"-C", d, "merge", "x"})
	t.True("conflicts: " + e, twine.HasPrefix(e, "the merge has conflicts"))
	crucible.Equal(mut t, "a merge in progress", runErr([]str{"-C", d, "switch", "x"}), "a merge is in progress: commit it, or tit merge --abort")
	crucible.Equal(mut t, "not resolved", runErr([]str{"-C", d, "commit", "-m", "too soon"}), "a.txt has a merge conflict: resolve it, then tit add it")
	quarry.WriteFile(d + "/a.txt", "both\n") catch _ {
	}
	_ = runArgs(mut t, []str{"-C", d, "add", "a.txt"})
	_ = runArgs(mut t, []str{"-C", d, "commit"})
	crucible.Equal(mut t, "the merge commit", runArgs(mut t, []str{"-C", d, "log", "--format=subject", "-n", "1"}), "Merge branch 'x'\n")
	t.False("merge state gone", quarry.Exists(d + "/.tit/workspaces/default/MERGE_HEAD"))
	crucible.Equal(mut t, "no merge", runErr([]str{"-C", d, "merge", "--abort"}), "no merge is in progress")
	_ = runArgs(mut t, []str{"-C", d, "switch", "--detach", "HEAD~1"})
	crucible.Equal(mut t, "detached", runErr([]str{"-C", d, "merge", "x"}), "HEAD is detached: switch to a branch to merge into")
}
