package cmd

import "../change"
import "../diff"
import "../identity"
import "../index"
import "../merge"
import "../object"
import "../oplog"
import "../revwalk"
import "../store"
import "../worktree"
import "fault"
import "flume"
import "quarry"
import "sift"
import "twine"

// Branches and merging (#791): branch (list, create, delete, rename), switch (-c, --detach), merge (fast-forward,
// three-way, conflicts written with git's markers and recorded as index stages; then add and commit, or
// merge --abort) and tag (lightweight, or annotated and signed when the user has a key).

// BranchArgs are tit branch's arguments.
type BranchArgs struct {
	Delete bool
	Force  bool
	Rename bool
	Names  []str
}

// SwitchArgs are tit switch's arguments.
type SwitchArgs struct {
	Create bool
	Detach bool
	Target str
	Start  str
}

// MergeArgs are tit merge's arguments.
type MergeArgs struct {
	Rev     str
	Abort   bool
	Message str
}

// TagArgs are tit tag's arguments.
type TagArgs struct {
	Delete    bool
	Annotated bool
	Message   str
	Names     []str
}

fn branchRef(name str) !str {
	let full = "refs/heads/" + name
	try change.CheckName(full)
	return full
}

// currentBranch is the full name of the branch HEAD names, or "" when HEAD is detached.
fn currentBranch(r Repo) !str {
	let h = try change.ReadHead(r.Ws.State())
	return match h {
		Branch(name) => name
		Detached(_) => ""
	}
}

fn commitText(id object.Id) str {
	return change.TargetText(change.Target.Commit(id))
}

// recordRefs writes one operation that moves refs.
fn recordRefs(r Repo, command str, op oplog.Op, moves []oplog.RefChange) ! {
	_ = try oplog.Run(r.Ws.Store, r.Ws.Name, command, op, moves)
}

fn doBranch(g Global, a BranchArgs, o mut Out) ! {
	mut r = try open(g)
	let current = try currentBranch(r)
	if len(a.Names) == 0 && !a.Delete && !a.Rename {
		let refs = change.NewRefs(r.Ws.Store)
		let all = try refs.List("refs/heads/")
		mut names = []str{}
		for ref in all {
			names = append(names, ref.Name)
		}
		sift.Sort(mut names)
		for n in names {
			if n == current {
				o.Line("* " + paint(g, "32", shortBranch(n)))
			} else {
				o.Line("  " + shortBranch(n))
			}
		}
		return
	}
	use lock = change.Lock(r.Ws.Store)
	let refs = change.NewRefs(r.Ws.Store)
	if a.Delete {
		if len(a.Names) == 0 {
			fail fault.Wrap(ErrUsage, "branch -d takes the branches to delete")
		}
		mut moves = []oplog.RefChange{}
		for n in a.Names {
			let full = try branchRef(n)
			if full == current {
				fail "{n} is the current branch: switch to another first"
			}
			let ref = try refs.Get(full)
			if ref == nil {
				fail "there is no branch {n}"
			}
			if !a.Force {
				let head = try r.headCommit()
				let tip = try r.resolve(full)
				mut merged = false
				if head != nil {
					merged = try revwalk.IsAncestor(mut r.Store, tip, head)
				}
				if !merged {
					fail "{n} is not merged into HEAD: branch -D deletes it anyway"
				}
			}
			moves = append(moves, oplog.RefChange{Name: full, Before: change.TargetText(ref.Target), After: ""})
			o.Line("Deleted branch " + n + ".")
		}
		try recordRefs(r, "tit branch -d", oplog.Op.Branch(twine.Join(a.Names, " ")), moves)
		return
	}
	if a.Rename {
		if len(a.Names) != 2 {
			fail fault.Wrap(ErrUsage, "branch -m takes the old name and the new")
		}
		let from = try branchRef(a.Names[0])
		let to = try branchRef(a.Names[1])
		let ref = try refs.Get(from)
		if ref == nil {
			fail "there is no branch {a.Names[0]}"
		}
		let taken = try refs.Get(to)
		if taken != nil {
			fail "a branch {a.Names[1]} exists already"
		}
		let text = change.TargetText(ref.Target)
		try recordRefs(r, "tit branch -m", oplog.Op.Branch(a.Names[1]), []oplog.RefChange{oplog.RefChange{Name: to, Before: "", After: text}, oplog.RefChange{Name: from, Before: text, After: ""}})
		if from == current {
			try change.WriteHead(r.Ws.State(), change.Head.Branch(to))
		}
		return
	}
	// create: tit branch <name> [start]
	if len(a.Names) > 2 {
		fail fault.Wrap(ErrUsage, "branch takes a name and where it starts")
	}
	let full = try branchRef(a.Names[0])
	let taken = try refs.Get(full)
	if taken != nil {
		fail "a branch {a.Names[0]} exists already"
	}
	mut start = "HEAD"
	if len(a.Names) == 2 {
		start = a.Names[1]
	}
	let id = try r.resolve(start)
	try recordRefs(r, "tit branch " + a.Names[0], oplog.Op.Branch(a.Names[0]), []oplog.RefChange{oplog.RefChange{Name: full, Before: "", After: commitText(id)}})
}

// headTree is HEAD's tree, or object.NoId before the first commit.
fn headTree(r mut Repo) !object.Id {
	let head = try r.headCommit()
	if head == nil {
		return object.NoId
	}
	return try r.treeOf(head)
}

// moveTo changes the working directory and the index from the tree from to the tree to. It refuses, changing
// nothing, when a file it would change has uncommitted changes, on the disk (worktree.ErrDirty) or staged.
fn moveTo(r mut Repo, from object.Id, to object.Id, force bool) ! {
	mut idx = try r.readIndex()
	if !force {
		let changes = try diff.TreeDiff(mut r.Store, from, to, false)
		mut staged = []str{}
		for c in changes {
			let e = idx.Find(c.Path)
			if c.Kind == diff.Kind.Added {
				if e != nil && e.Hash != c.NewHash {
					staged = append(staged, c.Path)
				}
			} else if e == nil || e.Hash != c.OldHash {
				if e != nil || quarry.Exists(r.Ws.Root + "/" + c.Path) {
					staged = append(staged, c.Path)
				}
			}
		}
		if len(staged) > 0 {
			fail fault.Wrap(worktree.ErrDirty, "staged: " + twine.Join(staged, ", "))
		}
	}
	try worktree.Checkout(mut r.Store, r.Ws, mut idx, from, to, force)
	try idx.Write(r.Ws.IndexPath())
}

fn doSwitch(g Global, a SwitchArgs, o mut Out) ! {
	mut r = try open(g)
	use lock = change.Lock(r.Ws.Store)
	if quarry.Exists(r.Ws.State() + "/MERGE_HEAD") {
		fail "a merge is in progress: commit it, or tit merge --abort"
	}
	let from = try headTree(mut r)
	let refs = change.NewRefs(r.Ws.Store)
	if a.Create {
		let full = try branchRef(a.Target)
		let taken = try refs.Get(full)
		if taken != nil {
			fail "a branch {a.Target} exists already"
		}
		let id = try r.resolve(a.Start)
		let to = try r.treeOf(id)
		try moveTo(mut r, from, to, false)
		try recordRefs(r, "tit switch -c " + a.Target, oplog.Op.Switch(a.Target), []oplog.RefChange{oplog.RefChange{Name: full, Before: "", After: commitText(id)}})
		try change.WriteHead(r.Ws.State(), change.Head.Branch(full))
		o.Line("Switched to a new branch " + a.Target + ".")
		return
	}
	if a.Detach {
		let id = try r.resolve(a.Target)
		let to = try r.treeOf(id)
		try moveTo(mut r, from, to, false)
		try change.WriteHead(r.Ws.State(), change.Head.Detached(change.Target.Commit(id)))
		try recordRefs(r, "tit switch --detach " + a.Target, oplog.Op.Switch(id.Hex()), []oplog.RefChange{})
		o.Line("HEAD is now at " + id.Hex()[0:12] + ".")
		return
	}
	let full = try branchRef(a.Target)
	let ref = try refs.Get(full)
	if ref == nil {
		fail "there is no branch {a.Target} (switch -c makes one; --detach goes to a commit)"
	}
	let id = try r.resolve(full)
	let to = try r.treeOf(id)
	try moveTo(mut r, from, to, false)
	try change.WriteHead(r.Ws.State(), change.Head.Branch(full))
	try recordRefs(r, "tit switch " + a.Target, oplog.Op.Switch(a.Target), []oplog.RefChange{})
	o.Line("Switched to branch " + a.Target + ".")
}

// mergeMessage is git's: "Merge branch 'side'" for a branch, "Merge commit 'rev'" otherwise.
fn mergeMessage(r Repo, rev str) str {
	let refs = change.NewRefs(r.Ws.Store)
	let ref = refs.Get("refs/heads/" + rev) catch _ {
		nil
	}
	if ref != nil {
		return "Merge branch '" + rev + "'\n"
	}
	return "Merge commit '" + rev + "'\n"
}

// newCommit writes a commit of tree with these parents and message, as the user and signed when they have a key.
fn newCommit(r Repo, tree object.Id, parents []object.Id, message str, when i64) !object.CommitData {
	let cfg = try r.config()
	let who = try identity.Who(cfg, identity.FixedClock{At: when})
	mut c = object.CommitData{Tree: tree, Parents: parents, Change: object.NewChangeId(), Author: who, Committer: who, GitHeaders: []str{}, Signature: "", Message: message}
	let keyPath = identity.DefaultKeyPath(cfg)
	if quarry.Exists(keyPath) {
		let signer = try identity.LoadKey(keyPath)
		c = try signer.SignCommit(c)
	}
	return c
}

fn doMerge(g Global, a MergeArgs, o mut Out) ! {
	mut r = try open(g)
	use lock = change.Lock(r.Ws.Store)
	let state = r.Ws.State()
	if a.Abort {
		try abortMerge(mut r)
		return
	}
	if quarry.Exists(state + "/MERGE_HEAD") {
		fail "a merge is in progress: commit it, or tit merge --abort"
	}
	let current = try currentBranch(r)
	if len(current) == 0 {
		fail "HEAD is detached: switch to a branch to merge into"
	}
	let ours = try r.headCommit()
	if ours == nil {
		fail "the current branch has no commits yet"
	}
	let theirs = try r.resolve(a.Rev)
	let base = try revwalk.MergeBase(mut r.Store, ours, theirs)
	if base != nil && base == theirs {
		o.Line("Already up to date.")
		return
	}
	let oursTree = try r.treeOf(ours)
	let theirsTree = try r.treeOf(theirs)
	if base != nil && base == ours {
		try moveTo(mut r, oursTree, theirsTree, false)
		try recordRefs(r, "tit merge " + a.Rev, oplog.Op.Merge(theirs.Hex()), []oplog.RefChange{oplog.RefChange{Name: current, Before: commitText(ours), After: commitText(theirs)}})
		o.Line("Fast-forward to " + theirs.Hex()[0:12] + ".")
		return
	}
	mut baseTree = object.NoId
	if base != nil {
		baseTree = try r.treeOf(base)
	}
	mut loose = store.NewLoose(r.Ws.Store + "/objects")
	let res = try merge.MergeTrees(mut loose, baseTree, oursTree, theirsTree)
	// the store now holds the merged objects: reopen it to read them
	r = try open(g)
	mut message = a.Message
	if len(message) == 0 {
		message = mergeMessage(r, a.Rev)
	} else {
		message = cleanMessage(message, false)
	}
	if res.Clean() {
		try moveTo(mut r, oursTree, res.Tree, false)
		let when = now()
		let c = try newCommit(r, res.Tree, []object.Id{ours, theirs}, message, when)
		let id = try loose.Put(object.Object.Commit(c))
		use tx = oplog.Begin(r.Ws.Store, r.Ws.Name, "tit merge " + a.Rev, oplog.Op.Merge(theirs.Hex()), []oplog.RefChange{oplog.RefChange{Name: current, Before: commitText(ours), After: commitText(id)}})
		try tx.Apply()
		try change.AddVersion(r.Ws.Store, c.Change, change.NewVersion(tx.Number(), id, when))
		try tx.Commit()
		o.Line("Merged " + a.Rev + " into " + shortBranch(current) + ": " + id.Hex()[0:12] + ".")
		return
	}
	// conflicts: the merged tree (our version at each conflict) goes to the disk, then each conflict is written with
	// markers and recorded as stages
	try moveTo(mut r, oursTree, res.Tree, false)
	mut idx = try r.readIndex()
	mut paths = []str{}
	for c in res.Conflicts {
		let text = try conflictText(mut r, c, a.Rev)
		let full = r.Ws.Root + "/" + c.Path
		let slash = twine.LastIndex(full, "/")
		try quarry.MkdirAll(full[0:slash])
		mut mode = object.Mode.File
		let cur = idx.Find(c.Path)
		if cur != nil {
			mode = cur.Mode
		}
		if mode == object.Mode.Link {
			mode = object.Mode.File
		}
		if quarry.Exists(full) {
			try quarry.Remove(full)
		}
		try quarry.WriteFile(full, text)
		idx.SetConflict(c.Path, mode, hashOf(c.Base()), hashOf(c.Ours()), hashOf(c.Theirs()))
		paths = append(paths, c.Path)
	}
	try idx.Write(r.Ws.IndexPath())
	try quarry.WriteFile(state + "/MERGE_HEAD", theirs.Hex() + "\n")
	try quarry.WriteFile(state + "/MERGE_MSG", message)
	for p in paths {
		o.Line("CONFLICT: " + p)
	}
	fail "the merge has conflicts: edit them, tit add each file, then tit commit (or tit merge --abort)"
}

fn hashOf(id object.Id) str {
	if id == object.NoId {
		return ""
	}
	return id.Bytes()
}

// conflictText is what the working directory gets for a conflict: the lines merged with git's markers, or, when one
// side deleted the file, the other side's version.
fn conflictText(r mut Repo, c merge.Conflict, theirsLabel str) !str {
	mut texts = []str{"", "", ""}
	let ids = []object.Id{c.Base(), c.Ours(), c.Theirs()}
	for k in 0..3 {
		if ids[k] != object.NoId {
			let (_, body) = try r.Store.GetRaw(ids[k])
			texts[k] = body
		}
	}
	if c.Ours() == object.NoId {
		return texts[2]
	}
	if c.Theirs() == object.NoId {
		return texts[1]
	}
	let (text, _) = merge.MergeText(texts[0], texts[1], texts[2], "HEAD", theirsLabel)
	return text
}

// abortMerge puts the index and the working directory back at HEAD and forgets the merge.
fn abortMerge(r mut Repo) ! {
	let state = r.Ws.State()
	if !quarry.Exists(state + "/MERGE_HEAD") {
		fail "no merge is in progress"
	}
	let to = try headTree(mut r)
	let idx = try r.readIndex()
	// where the working directory is: the index, with our version for each conflict
	mut now = index.New()
	mut conflicted = []str{}
	for e in idx.Entries {
		if e.Stage == 0 {
			now.Set(e)
		} else if e.Stage == 2 {
			now.Set(index.Entry{Path: e.Path, Hash: e.Hash, Mode: e.Mode, Stage: 0, Size: 0, Mtime: 0, Ctime: 0, Inode: 0, Device: 0})
		}
		if e.Stage != 0 {
			conflicted = append(conflicted, e.Path)
		}
	}
	mut sc = r.scratch()
	let from = try index.WriteTree(mut sc, now)
	try worktree.Checkout(mut sc, r.Ws, mut now, from, to, true)
	// the files with markers: our version, or gone when we had none
	let back = try index.FromTree(mut r.Store, to)
	for p in conflicted {
		let e = back.Find(p)
		let full = r.Ws.Root + "/" + p
		if e == nil {
			if quarry.Exists(full) {
				try quarry.Remove(full)
			}
			continue
		}
		let (_, body) = try r.Store.GetRaw(e.Id())
		try quarry.WriteFile(full, body)
	}
	mut fresh = try index.FromTree(mut r.Store, to)
	for e in now.Entries {
		let f = fresh.Find(e.Path)
		if f != nil && f.Hash == e.Hash {
			fresh.Set(e)
		}
	}
	try fresh.Write(r.Ws.IndexPath())
	try quarry.Remove(state + "/MERGE_HEAD")
	if quarry.Exists(state + "/MERGE_MSG") {
		try quarry.Remove(state + "/MERGE_MSG")
	}
}

// mergeHead is the commit being merged in, when a merge with conflicts waits for its commit.
fn mergeHead(r Repo) !?object.Id {
	let path = r.Ws.State() + "/MERGE_HEAD"
	if !quarry.Exists(path) {
		return nil
	}
	let text = try flume.ReadFile(path)
	let id = try object.ParseId(twine.TrimSpace(text))
	return id
}

fn doTag(g Global, a TagArgs, o mut Out) ! {
	mut r = try open(g)
	let refs = change.NewRefs(r.Ws.Store)
	if len(a.Names) == 0 && !a.Delete {
		let all = try refs.List("refs/tags/")
		mut names = []str{}
		for ref in all {
			names = append(names, ref.Name[10:])
		}
		sift.Sort(mut names)
		for n in names {
			o.Line(n)
		}
		return
	}
	use lock = change.Lock(r.Ws.Store)
	if a.Delete {
		mut moves = []oplog.RefChange{}
		for n in a.Names {
			let full = "refs/tags/" + n
			let ref = try refs.Get(full)
			if ref == nil {
				fail "there is no tag {n}"
			}
			moves = append(moves, oplog.RefChange{Name: full, Before: change.TargetText(ref.Target), After: ""})
			o.Line("Deleted tag " + n + ".")
		}
		try recordRefs(r, "tit tag -d", oplog.Op.Tag(twine.Join(a.Names, " ")), moves)
		return
	}
	if len(a.Names) > 2 {
		fail fault.Wrap(ErrUsage, "tag takes a name and what it tags")
	}
	let name = a.Names[0]
	let full = "refs/tags/" + name
	try change.CheckName(full)
	let taken = try refs.Get(full)
	if taken != nil {
		fail "a tag {name} exists already"
	}
	mut rev = "HEAD"
	if len(a.Names) == 2 {
		rev = a.Names[1]
	}
	mut target = try r.resolve(rev)
	if a.Annotated || len(a.Message) > 0 {
		let cfg = try r.config()
		let who = try identity.Who(cfg, identity.FixedClock{At: now()})
		mut t = object.TagData{Object: target, Kind: object.Kind.Commit, Name: name, Tagger: who, Signature: "", Message: cleanMessage(a.Message, false)}
		let keyPath = identity.DefaultKeyPath(cfg)
		if quarry.Exists(keyPath) {
			let signer = try identity.LoadKey(keyPath)
			t = try signer.SignTag(t)
		}
		mut loose = store.NewLoose(r.Ws.Store + "/objects")
		target = try loose.Put(object.Object.Tag(t))
	}
	try recordRefs(r, "tit tag " + name, oplog.Op.Tag(name), []oplog.RefChange{oplog.RefChange{Name: full, Before: "", After: commitText(target)}})
}
