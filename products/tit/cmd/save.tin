package cmd

import "../change"
import "../cores"
import "../diff"
import "../identity"
import "../ignore"
import "../index"
import "../object"
import "../oplog"
import "../store"
import "../worktree"
import "fault"
import "flume"
import "quarry"
import "sift"
import "spawn"
import "tide"
import "trail"
import "twine"

// Saving work (#790): add, rm, mv, commit (-m, the editor, -a, --amend) and diff (of the working directory, of the
// staged files, or of two commits; --stat), with patches written the way git writes them.

// RmArgs are tit rm's arguments.
type RmArgs struct {
	Paths     []str
	Cached    bool
	Recursive bool
	Force     bool
}

// CommitArgs are tit commit's arguments.
type CommitArgs struct {
	Messages []str
	All      bool
	Amend    bool
}

// DiffArgs are tit diff's arguments.
type DiffArgs struct {
	Word     bool
	Semantic bool
	Staged bool
	Stat   bool
	Revs   []str
	Paths  []str
}

fn under(path str, dir str) bool {
	return len(dir) == 0 || path == dir || twine.HasPrefix(path, dir + "/")
}

fn full(root str, rel str) str {
	if len(rel) == 0 {
		return root
	}
	return root + "/" + rel
}

// enterAll loads the .gitignore of every directory from the root down to dir.
fn enterAll(rules mut ignore.Rules, dir str) ! {
	try rules.Enter("")
	for i in 0..len(dir) {
		if dir[i] == '/' {
			try rules.Enter(dir[0:i])
		}
	}
	if len(dir) > 0 {
		try rules.Enter(dir)
	}
}

fn doAdd(g Global, paths []str, o mut Out) ! {
	if len(paths) == 0 {
		fail fault.Wrap(ErrUsage, "add takes the paths to stage (. for everything)")
	}
	mut r = try open(g)
	use lock = change.Lock(r.Ws.Store)
	mut idx = try r.readIndex()
	mut rules = try ignore.Load(r.Ws.Root)
	mut loose = store.NewLoose(r.Ws.Store + "/objects")
	for p in paths {
		let rel = try r.rel(g, p)
		let (info, err) = quarry.Lstat(full(r.Ws.Root, rel))
		if err != nil {
			// gone from the disk: the tracked files at or below it leave the index
			if removeUnder(mut idx, rel) == 0 {
				fail "{p} matches no files"
			}
			continue
		}
		if info.Type == quarry.FileType.Dir {
			try enterAll(mut rules, rel)
			try addDir(r.Ws.Root, rel, mut idx, mut loose, mut rules)
			removeMissing(r.Ws.Root, rel, mut idx, worktree.FocusOf(r.Ws))
			continue
		}
		if idx.Find(rel) == nil {
			try enterAll(mut rules, trail.Dir(rel))
			if rules.Ignored(rel, false) {
				fail "{p} is ignored by a .gitignore rule; it was not staged"
			}
		}
		try index.AddFile(mut idx, mut loose, r.Ws.Root, rel)
	}
	try idx.Write(r.Ws.IndexPath())
}

// addDir stages every file below dir that is tracked or not ignored.
fn addDir(root str, dir str, idx mut index.Index, s mut store.Loose, rules mut ignore.Rules) ! {
	let names = try quarry.ReadDir(full(root, dir))
	for name in names {
		if name == ".tit" || name == ".git" {
			continue
		}
		mut rel = name
		if len(dir) > 0 {
			rel = dir + "/" + name
		}
		let info = try quarry.Lstat(full(root, rel))
		let isDir = info.Type == quarry.FileType.Dir
		if rules.Ignored(rel, isDir) && idx.Find(rel) == nil {
			continue
		}
		if isDir {
			try rules.Enter(rel)
			try addDir(root, rel, mut idx, mut s, mut rules)
		} else {
			try index.AddFile(mut idx, mut s, root, rel)
		}
	}
}

fn removeUnder(idx mut index.Index, dir str) i64 {
	mut gone = []str{}
	for e in idx.Entries {
		if under(e.Path, dir) {
			gone = append(gone, e.Path)
		}
	}
	for p in gone {
		idx.Remove(p)
	}
	return len(gone)
}

// removeMissing takes out of the index the files below dir that are no longer on the disk (a file outside the focus
// is not on the disk and stays).
fn removeMissing(root str, dir str, idx mut index.Index, focus []str) {
	mut gone = []str{}
	for e in idx.Entries {
		if under(e.Path, dir) && worktree.InFocus(focus, e.Path) {
			let (_, err) = quarry.Lstat(root + "/" + e.Path)
			if err != nil {
				gone = append(gone, e.Path)
			}
		}
	}
	for p in gone {
		idx.Remove(p)
	}
}

// changedOnDisk reports whether a tracked file differs from its index entry.
fn changedOnDisk(root str, e index.Entry) !bool {
	let path = root + "/" + e.Path
	let (info, err) = quarry.Lstat(path)
	if err != nil {
		return true
	}
	if index.ModeOf(info) != e.Mode {
		return true
	}
	if info.Type == quarry.FileType.Symlink {
		let target = try quarry.Readlink(path)
		let id = object.Hash(object.Kind.Blob, target)
		return id.Bytes() != e.Hash
	}
	let id = try cores.HashPath(path)
	return id.Bytes() != e.Hash
}

// pruneDirs removes the directories above rel that are left empty, up to the root.
fn pruneDirs(root str, rel str) {
	mut d = trail.Dir(rel)
	for len(d) > 0 && d != "." {
		let left = quarry.ReadDir(root + "/" + d) catch _ {
			return
		}
		if len(left) > 0 {
			return
		}
		quarry.Remove(root + "/" + d) catch _ {
			return
		}
		d = trail.Dir(d)
	}
}

fn doRm(g Global, a RmArgs, o mut Out) ! {
	if len(a.Paths) == 0 {
		fail fault.Wrap(ErrUsage, "rm takes the paths to remove")
	}
	mut r = try open(g)
	use lock = change.Lock(r.Ws.Store)
	mut idx = try r.readIndex()
	mut gone = []str{}
	for p in a.Paths {
		let rel = try r.rel(g, p)
		mut hit = []str{}
		for e in idx.Entries {
			if under(e.Path, rel) {
				hit = append(hit, e.Path)
			}
		}
		if len(hit) == 0 {
			fail "{p} is not tracked"
		}
		if !a.Recursive && !(len(hit) == 1 && hit[0] == rel) {
			fail fault.Wrap(ErrUsage, "{p} is a directory: rm -r removes it")
		}
		if !a.Cached && !a.Force {
			for path in hit {
				let e = idx.Find(path)
				if e != nil {
					let changed = try changedOnDisk(r.Ws.Root, e)
					if changed && quarry.Exists(r.Ws.Root + "/" + path) {
						fail "{path} has changes that are not staged: rm -f removes it anyway, rm --cached keeps the file"
					}
				}
			}
		}
		for path in hit {
			gone = append(gone, path)
		}
	}
	for path in gone {
		idx.Remove(path)
		if !a.Cached {
			let fp = r.Ws.Root + "/" + path
			let (_, err) = quarry.Lstat(fp)
			if err == nil {
				try quarry.Remove(fp)
			}
			pruneDirs(r.Ws.Root, path)
		}
		o.Line("rm '" + path + "'")
	}
	try idx.Write(r.Ws.IndexPath())
}

fn doMv(g Global, from str, to str, o mut Out) ! {
	mut r = try open(g)
	use lock = change.Lock(r.Ws.Store)
	mut idx = try r.readIndex()
	let src = try r.rel(g, from)
	mut dst = try r.rel(g, to)
	if len(src) == 0 {
		fail fault.Wrap(ErrUsage, "mv cannot move the working directory itself")
	}
	if quarry.IsDir(full(r.Ws.Root, dst)) {
		dst = trail.Join2(dst, trail.Base(src))
		if dst[0] == '/' || twine.HasPrefix(dst, "./") {
			dst = trail.Clean(dst)
		}
	}
	mut hit = []index.Entry{}
	for e in idx.Entries {
		if under(e.Path, src) {
			hit = append(hit, e)
		}
	}
	if len(hit) == 0 {
		fail "{from} is not tracked"
	}
	if quarry.Exists(full(r.Ws.Root, dst)) {
		fail "{to} exists"
	}
	let parent = trail.Dir(dst)
	if len(parent) > 0 && parent != "." {
		try quarry.MkdirAll(r.Ws.Root + "/" + parent)
	}
	try quarry.Rename(full(r.Ws.Root, src), full(r.Ws.Root, dst))
	for e in hit {
		let moved = dst + e.Path[len(src):]
		idx.Remove(e.Path)
		try index.AddStat(mut idx, r.Ws.Root, moved, e.Hash, e.Mode)
	}
	pruneDirs(r.Ws.Root, src)
	try idx.Write(r.Ws.IndexPath())
}

// now is the time of a new commit in unix ns: TIT_TIME (unix seconds) when set, for tests and reproducible commits.
fn now() i64 {
	let fixed = quarry.Getenv("TIT_TIME")
	if len(fixed) > 0 {
		let secs = parseCount(fixed) catch _ {
			-1
		}
		if secs >= 0 {
			return secs * 1000000000
		}
	}
	return tide.Wall()
}

// cleanMessage is a message as git's stripspace leaves it: trailing spaces off every line, no blank lines at either
// end, runs of blank lines as one, and a final newline; "" when nothing is left.
fn cleanMessage(msg str, comments bool) str {
	mut lines = []str{}
	for raw in twine.Split(msg, "\n") {
		if comments && len(raw) > 0 && raw[0] == '#' {
			continue
		}
		let line = twine.TrimRight(raw, " \t\r")
		if len(line) == 0 && (len(lines) == 0 || len(lines[len(lines) - 1]) == 0) {
			continue
		}
		lines = append(lines, line)
	}
	for len(lines) > 0 && len(lines[len(lines) - 1]) == 0 {
		lines = lines[0:len(lines) - 1]
	}
	if len(lines) == 0 {
		return ""
	}
	return twine.Join(lines, "\n") + "\n"
}

// editMessage asks for a message in $TIT_EDITOR, $EDITOR or vi, starting from start.
fn editMessage(r Repo, start str) !str {
	let path = r.Ws.State() + "/COMMIT_MSG"
	try quarry.WriteFile(path, start + "\n# Write the message for this commit. Lines starting with # are left out; an empty message\n# stops the commit.\n")
	mut editor = quarry.Getenv("TIT_EDITOR")
	if len(editor) == 0 {
		editor = quarry.Getenv("EDITOR")
	}
	if len(editor) == 0 {
		editor = "vi"
	}
	mut p = try spawn.Start(spawn.Cmd{Argv: []str{"/bin/sh", "-c", editor + " \"$1\"", "sh", path}, Env: spawn.Env.Inherit, Dir: "", Stdin: spawn.Stdio.Inherit, Stdout: spawn.Stdio.Inherit, Stderr: spawn.Stdio.Inherit, MaxOutput: 0})
	let code = try p.Wait()
	if code != 0 {
		fail "the editor ({editor}) exited with status {code}; the commit was not made"
	}
	let text = try flume.ReadFile(path)
	quarry.Remove(path) catch _ {
	}
	return cleanMessage(text, true)
}

// stageTracked is commit -a: every tracked file's current content, and the tracked files that are gone, staged.
fn stageTracked(r Repo, idx mut index.Index, s mut store.Loose) ! {
	let focus = worktree.FocusOf(r.Ws)
	mut paths = []str{}
	for e in idx.Entries {
		if e.Stage == 0 && worktree.InFocus(focus, e.Path) {
			paths = append(paths, e.Path)
		}
	}
	for p in paths {
		let e = idx.Find(p)
		if e == nil {
			continue
		}
		let (_, err) = quarry.Lstat(r.Ws.Root + "/" + p)
		if err != nil {
			idx.Remove(p)
			continue
		}
		let changed = try changedOnDisk(r.Ws.Root, e)
		if changed {
			try index.AddFile(mut idx, mut s, r.Ws.Root, p)
		}
	}
}

fn shortBranch(name str) str {
	if twine.HasPrefix(name, "refs/heads/") {
		return name[11:]
	}
	return name
}

fn doCommit(g Global, a CommitArgs, o mut Out) ! {
	mut r = try open(g)
	use lock = change.Lock(r.Ws.Store)
	mut idx = try r.readIndex()
	mut loose = store.NewLoose(r.Ws.Store + "/objects")
	if a.All {
		try stageTracked(r, mut idx, mut loose)
	}
	for e in idx.Entries {
		if e.Stage != 0 {
			fail "{e.Path} has a merge conflict: resolve it, then tit add it"
		}
	}
	let tree = try index.WriteTree(mut loose, idx)
	let head = try change.ReadHead(r.Ws.State())
	let parent = try r.headCommit()
	// no private key or token goes into a commit (tit guard)
	mut guardFrom = object.NoId
	if parent != nil {
		guardFrom = try r.treeOf(parent)
	}
	try guardCommit(mut r, guardFrom, tree)
	// a merge that stopped at conflicts: this commit finishes it, with both parents
	let merging = try mergeHead(r)
	let cfg = try r.config()
	let when = now()
	mut author = try identity.Who(cfg, identity.FixedClock{At: when})
	let committer = author
	mut parents = []object.Id{}
	mut changeId = object.NewChangeId()
	mut message = ""
	if len(a.Messages) > 0 {
		message = cleanMessage(twine.Join(a.Messages, "\n\n"), false)
	}
	if a.Amend {
		if parent == nil {
			fail "there is no commit to amend"
		}
		let old = try commitData(mut r, parent)
		parents = old.Parents
		changeId = old.Change
		author = old.Author
		if len(a.Messages) == 0 {
			message = old.Message
		}
	} else if merging != nil && parent != nil {
		parents = []object.Id{parent, merging}
		if len(a.Messages) == 0 {
			let saved = r.Ws.State() + "/MERGE_MSG"
			if quarry.Exists(saved) {
				let text = try flume.ReadFile(saved)
				message = cleanMessage(text, true)
			} else {
				message = try editMessage(r, "Merge commit " + merging.Hex()[0:12])
			}
		}
	} else {
		if parent != nil {
			parents = []object.Id{parent}
			let ptree = try r.treeOf(parent)
			if ptree == tree {
				fail "nothing to commit: the staged files match the last commit (tit add stages changes)"
			}
		} else if len(idx.Entries) == 0 {
			fail "nothing to commit: stage files with tit add"
		}
		if len(a.Messages) == 0 {
			message = try editMessage(r, "")
		}
	}
	if len(message) == 0 {
		fail "the message is empty: the commit was not made"
	}
	mut c = object.CommitData{Tree: tree, Parents: parents, Change: changeId, Author: author, Committer: committer, GitHeaders: []str{}, Signature: "", Message: message, Conflicts: []str{}}
	// a change of the stack being edited (tit edit): the amend rebases what is above it, in one operation
	let editing = try editState(r)
	if editing != nil {
		if !a.Amend {
			fail "a change of the stack is being edited: tit commit --amend makes its new version"
		}
		try idx.Write(r.Ws.IndexPath())
		try finishEdit(mut r, editing, c, mut o)
		return
	}
	let keyPath = identity.DefaultKeyPath(cfg)
	if quarry.Exists(keyPath) {
		let signer = try identity.LoadKey(keyPath)
		c = try signer.SignCommit(c)
	}
	let id = try loose.Put(object.Object.Commit(c))
	mut op = oplog.Op.Commit(changeId.Letters())
	if a.Amend {
		op = oplog.Op.Amend(changeId.Letters())
	} else if merging != nil {
		op = oplog.Op.Merge(merging.Hex())
	}
	mut refChanges = []oplog.RefChange{}
	mut where = "detached HEAD"
	mut detached = false
	match head {
		Branch(name) => {
			where = shortBranch(name)
			let refs = change.NewRefs(r.Ws.Store)
			let cur = try refs.Get(name)
			mut before = ""
			mut after = change.TargetText(change.Target.Commit(id))
			if cur != nil {
				before = change.TargetText(cur.Target)
				match cur.Target {
					Change(_) => {
						// a stack branch follows its change: it names the new change, or keeps naming the amended one
						after = change.TargetText(change.Target.Change(changeId))
					}
					Commit(_) => {
					}
				}
			}
			if before != after {
				refChanges = append(refChanges, oplog.RefChange{Name: name, Before: before, After: after})
			}
		}
		Detached(_) => {
			detached = true
		}
	}
	if detached {
		let move = try headChange(r, change.Head.Detached(change.Target.Commit(id)))
		refChanges = append(refChanges, move)
	}
	use tx = oplog.Begin(r.Ws.Store, r.Ws.Name, commandLine(a), op, refChanges)
	try tx.Apply()
	try change.AddVersion(r.Ws.Store, changeId, change.NewVersion(tx.Number(), id, when))
	try idx.Write(r.Ws.IndexPath())
	if merging != nil {
		try quarry.Remove(r.Ws.State() + "/MERGE_HEAD")
		if quarry.Exists(r.Ws.State() + "/MERGE_MSG") {
			try quarry.Remove(r.Ws.State() + "/MERGE_MSG")
		}
	}
	try tx.Commit()
	mut root = ""
	if len(parents) == 0 {
		root = " (root commit)"
	}
	o.Line("[" + where + root + " " + id.Hex()[0:12] + "] " + firstLine(message))
}

fn commandLine(a CommitArgs) str {
	mut s = "tit commit"
	if a.Amend {
		s = s + " --amend"
	}
	if a.All {
		s = s + " -a"
	}
	return s
}

// readWork is a working file's content and mode, as a blob would hold it.
fn readWork(root str, rel str) !(str, object.Mode) {
	let path = root + "/" + rel
	let info = try quarry.Lstat(path)
	if info.Type == quarry.FileType.Symlink {
		let target = try quarry.Readlink(path)
		return target, object.Mode.Link
	}
	let body = try flume.ReadFile(path)
	return body, index.ModeOf(info)
}

// worktreeChanges is how the tracked files on the disk differ from the index, their new contents put in s.
fn worktreeChanges(r Repo, s mut store.Layered) ![]diff.FileChange {
	mut idx = try r.readIndex()
	mut rules = ignore.New(r.Ws.Root)
	let rep = try index.Status(mut s, r.Ws.Root, object.NoId, mut idx, mut rules)
	let focus = worktree.FocusOf(r.Ws)
	mut out = []diff.FileChange{}
	for f in rep.Unstaged {
		let p = fpath(f)
		if !worktree.InFocus(focus, p) {
			continue
		}
		let e = idx.Find(p)
		if e == nil {
			continue
		}
		let (_, gone) = quarry.Lstat(r.Ws.Root + "/" + p)
		if gone != nil {
			out = append(out, diff.FileChange{Kind: diff.Kind.Deleted, Path: p, OldPath: p, OldHash: e.Hash, NewHash: "", OldMode: e.Mode, NewMode: e.Mode, Similarity: 0})
			continue
		}
		let (body, mode) = try readWork(r.Ws.Root, p)
		let id = try s.PutRaw(object.Kind.Blob, body)
		mut kind = diff.Kind.Modified
		if (mode == object.Mode.Link) != (e.Mode == object.Mode.Link) {
			kind = diff.Kind.TypeChanged
		}
		out = append(out, diff.FileChange{Kind: kind, Path: p, OldPath: p, OldHash: e.Hash, NewHash: id.Bytes(), OldMode: e.Mode, NewMode: mode, Similarity: 0})
	}
	// in path order already: status walks the index in order
	return out
}

fn doDiff(g Global, a DiffArgs, o mut Out) ! {
	mut r = try open(g)
	mut s = r.scratch()
	mut changes = []diff.FileChange{}
	if len(a.Revs) == 2 {
		let ca = try r.resolve(a.Revs[0])
		let cb = try r.resolve(a.Revs[1])
		let ta = try r.treeOf(ca)
		let tb = try r.treeOf(cb)
		changes = try diff.TreeDiff(mut s, ta, tb, true)
	} else if len(a.Revs) != 0 {
		fail fault.Wrap(ErrUsage, "diff compares two revisions, or none")
	} else if a.Staged {
		let idx = try r.readIndex()
		let head = try r.headCommit()
		mut before = object.NoId
		if head != nil {
			before = try r.treeOf(head)
		}
		let staged = try index.WriteTree(mut s, idx)
		changes = try diff.TreeDiff(mut s, before, staged, true)
	} else {
		changes = try worktreeChanges(r, mut s)
	}
	if len(a.Paths) > 0 {
		mut rels = []str{}
		for p in a.Paths {
			let rel = try r.rel(g, p)
			rels = append(rels, rel)
		}
		mut kept = []diff.FileChange{}
		for c in changes {
			for rel in rels {
				if under(c.Path, rel) || under(c.OldPath, rel) {
					kept = append(kept, c)
					break
				}
			}
		}
		changes = kept
	}
	if g.Json {
		for c in changes {
			o.Line("{{\"kind\":\"" + diff.KindLetter(c.Kind) + "\",\"path\":" + jsonStr(c.Path) + ",\"old_path\":" + jsonStr(c.OldPath) + "}}")
		}
		return
	}
	if a.Semantic {
		try writeSemantic(g, mut s, changes, mut o)
		return
	}
	if a.Stat {
		if len(changes) > 0 {
			let stats = try diff.Stats(mut s, changes)
			o.Text(diff.FormatStat(stats))
		}
		return
	}
	try writePatchWith(g, mut s, changes, a.Word, mut o)
}

// jsonObject is one JSON object of the keys and values in kv, in turn; each value is JSON already (jsonStr of a
// text, a number, jsonList of texts).
fn jsonObject(kv []str) str {
	mut s = "{{"
	mut i = 0
	for i + 1 < len(kv) {
		if i > 0 {
			s = s + ","
		}
		s = s + jsonStr(kv[i]) + ":" + kv[i + 1]
		i += 2
	}
	return s + "}}"
}

fn jsonBool(b bool) str {
	if b {
		return "true"
	}
	return "false"
}

// jsonList is a JSON array of texts.
fn jsonList(xs []str) str {
	mut s = "["
	for i in 0..len(xs) {
		if i > 0 {
			s = s + ","
		}
		s = s + jsonStr(xs[i])
	}
	return s + "]"
}

fn jsonStr(s str) str {
	mut b = []u8{'"'}
	for i in 0..len(s) {
		let c = s[i]
		if c == '"' || c == '\\' {
			b = append(b, '\\', c)
		} else if c < 0x20 {
			let hex = "0123456789abcdef"
			b = append(b, '\\', 'u', '0', '0', hex[i64(c) / 16], hex[i64(c) % 16])
		} else {
			b = append(b, c)
		}
	}
	b = append(b, '"')
	return str(b)
}

fn abbrev(hash str) str {
	if len(hash) == 0 {
		return "000000000000"
	}
	let id = object.IdOf(hash) catch _ {
		return "000000000000"
	}
	return id.Hex()[0:12]
}

fn hasNul(b str) bool {
	for i in 0..min(len(b), 8000) {
		if b[i] == 0 {
			return true
		}
	}
	return false
}

fn blobText(s mut store.Layered, hash str) !str {
	if len(hash) == 0 {
		return ""
	}
	let id = try object.IdOf(hash)
	let (_, body) = try s.GetRaw(id)
	return body
}

// writePatch writes the changes as git's patch format: the diff --git line, the mode, rename and index lines, then
// the unified diff (or "Binary files ... differ").
fn writePatch(g Global, s mut store.Layered, changes []diff.FileChange, o mut Out) ! {
	try writePatchWith(g, mut s, changes, false, mut o)
}

// writePatchWith is writePatch, with words marked inside the lines (as git diff --word-diff=plain) when words.
fn writePatchWith(g Global, s mut store.Layered, changes []diff.FileChange, words bool, o mut Out) ! {
	for c in changes {
		mut oldPath = c.OldPath
		if len(oldPath) == 0 {
			oldPath = c.Path
		}
		o.Line(paint(g, "1", "diff --git a/" + oldPath + " b/" + c.Path))
		let same = c.OldHash == c.NewHash
		match c.Kind {
			Added => {
				o.Line(paint(g, "1", "new file mode " + object.ModeText(c.NewMode)))
				o.Line(paint(g, "1", "index " + abbrev("") + ".." + abbrev(c.NewHash)))
			}
			Deleted => {
				o.Line(paint(g, "1", "deleted file mode " + object.ModeText(c.OldMode)))
				o.Line(paint(g, "1", "index " + abbrev(c.OldHash) + ".." + abbrev("")))
			}
			Renamed => {
				o.Line(paint(g, "1", "similarity index {c.Similarity}%"))
				o.Line(paint(g, "1", "rename from " + c.OldPath))
				o.Line(paint(g, "1", "rename to " + c.Path))
				writeModeAndIndex(g, c, same, mut o)
			}
			Modified, TypeChanged => {
				writeModeAndIndex(g, c, same, mut o)
			}
		}
		if same {
			continue
		}
		let a = try blobText(mut s, c.OldHash)
		let b = try blobText(mut s, c.NewHash)
		mut aName = "a/" + oldPath
		if c.Kind == diff.Kind.Added {
			aName = "/dev/null"
		}
		mut bName = "b/" + c.Path
		if c.Kind == diff.Kind.Deleted {
			bName = "/dev/null"
		}
		if hasNul(a) || hasNul(b) {
			o.Line("Binary files " + aName + " and " + bName + " differ")
			continue
		}
		if words {
			o.Text(diff.WordDiff(aName, bName, a, b, 3))
			continue
		}
		let text = diff.Unified(aName, bName, a, b, 3)
		if g.Color && !g.Json {
			for line in splitLines(text) {
				if twine.HasPrefix(line, "+++") || twine.HasPrefix(line, "---") {
					o.Line(paint(g, "1", line))
				} else if len(line) > 0 && line[0] == '+' {
					o.Line(paint(g, "32", line))
				} else if len(line) > 0 && line[0] == '-' {
					o.Line(paint(g, "31", line))
				} else if twine.HasPrefix(line, "@@") {
					o.Line(paint(g, "36", line))
				} else {
					o.Line(line)
				}
			}
		} else {
			o.Text(text)
		}
	}
}

fn writeModeAndIndex(g Global, c diff.FileChange, same bool, o mut Out) {
	if c.OldMode != c.NewMode {
		o.Line(paint(g, "1", "old mode " + object.ModeText(c.OldMode)))
		o.Line(paint(g, "1", "new mode " + object.ModeText(c.NewMode)))
	}
	if same {
		return
	}
	mut line = "index " + abbrev(c.OldHash) + ".." + abbrev(c.NewHash)
	if c.OldMode == c.NewMode {
		line = line + " " + object.ModeText(c.NewMode)
	}
	o.Line(paint(g, "1", line))
}
