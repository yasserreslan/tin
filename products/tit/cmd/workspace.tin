package cmd

import "../change"
import "../ignore"
import "../index"
import "../object"
import "../oplog"
import "../revwalk"
import "fault"
import "flume"
import "quarry"
import "sift"
import "trail"
import "twine"

// Workspaces and who (#804). A workspace is another working directory on the same store: its own HEAD, index and
// undo, made with its own branch in one step. Its directory holds a .tit file naming the store and the workspace
// (worktree.Find reads it); the store keeps .tit/workspaces/<name>/root, the directory's path.

// WorkspaceArgs are tit workspace's arguments.
type WorkspaceArgs struct {
	Action str
	Name   str
	Dir    str
	From   str
}

fn workspaceName(n str) ! {
	if len(n) == 0 || n == "default" || twine.ContainsAny(n, "/\\ \t\n.:") {
		fail fault.Wrap(ErrUsage, "{n} cannot name a workspace (no slashes, dots, colons or spaces; not default)")
	}
}

fn doWorkspace(g Global, a WorkspaceArgs, o mut Out) ! {
	mut r = try open(g)
	let store = r.Ws.Store
	if a.Action == "list" {
		let names = try quarry.ReadDir(store + "/workspaces")
		mut sorted = []str{}
		for n in names {
			sorted = append(sorted, n)
		}
		sift.Sort(mut sorted)
		for n in sorted {
			mut root = trail.Dir(store)
			let rootFile = store + "/workspaces/" + n + "/root"
			if quarry.Exists(rootFile) {
				let text = try flume.ReadFile(rootFile)
				root = twine.TrimSpace(text)
			}
			mut mark = "  "
			if n == r.Ws.Name {
				mark = "* "
			}
			mut on = ""
			let h = change.ReadHead(store + "/workspaces/" + n) catch _ {
				change.Head.Branch("")
			}
			match h {
				Branch(b) => {
					on = shortBranch(b)
				}
				Detached(t) => {
					on = change.TargetText(t)
				}
			}
			if g.Json {
				o.Line(jsonObject([]str{"name", jsonStr(n), "on", jsonStr(on), "root", jsonStr(root), "this", jsonBool(mark == "* ")}))
			} else {
				o.Line(mark + n + "\t" + on + "\t" + root)
			}
		}
		return
	}
	try workspaceName(a.Name)
	let state = store + "/workspaces/" + a.Name
	if a.Action == "rm" {
		if !quarry.IsDir(state) {
			fail "there is no workspace {a.Name}"
		}
		if a.Name == r.Ws.Name {
			fail "{a.Name} is the workspace you are in: remove it from another"
		}
		let rootFile = state + "/root"
		mut root = ""
		if quarry.Exists(rootFile) {
			let text = try flume.ReadFile(rootFile)
			root = twine.TrimSpace(text)
		}
		// its files go only when nothing in them is unsaved
		if len(root) > 0 && quarry.IsDir(root) {
			let wg = Global{Json: false, Trace: false, Dir: root, Color: false}
			mut w = try open(wg)
			mut idx = try w.readIndex()
			let tree = try headTree(mut w)
			mut rules = try ignore.Load(w.Ws.Root)
			let rep = try index.Status(mut w.Store, w.Ws.Root, tree, mut idx, mut rules)
			if len(rep.Staged) + len(rep.Unstaged) + len(rep.Untracked) > 0 {
				fail "{root} has changes that are not committed: commit them or remove the files yourself"
			}
			try quarry.RemoveAll(root)
		}
		try quarry.RemoveAll(state)
		o.Line("Removed the workspace " + a.Name + "; its branch stays.")
		return
	}
	// new
	if quarry.IsDir(state) {
		fail "a workspace {a.Name} exists already"
	}
	mut dir = a.Dir
	if len(dir) == 0 {
		dir = trail.Dir(r.Ws.Root) + "/" + trail.Base(r.Ws.Root) + "-" + a.Name
	} else if dir[0] != '/' {
		mut base = g.Dir
		if len(base) == 0 {
			base = try quarry.Getwd()
		}
		dir = trail.Clean(base + "/" + dir)
	}
	if quarry.Exists(dir) {
		let left = try quarry.ReadDir(dir)
		if len(left) > 0 {
			fail "{dir} exists and is not empty"
		}
	}
	use lock = change.Lock(store)
	let refs = change.NewRefs(store)
	let branch = try branchRef(a.Name)
	let taken = try refs.Get(branch)
	if taken != nil {
		fail "a branch {a.Name} exists already: a workspace makes its own"
	}
	mut from = a.From
	if len(from) == 0 {
		let main = try refs.Get("refs/heads/main")
		if main != nil {
			from = "main"
		} else {
			from = "HEAD"
		}
	}
	let start = try r.resolve(from)
	try quarry.MkdirAll(dir)
	try quarry.MkdirAll(state)
	try quarry.WriteFile(dir + "/.tit", "store " + store + "\nworkspace " + a.Name + "\n")
	try quarry.WriteFile(state + "/root", dir + "\n")
	try change.WriteHead(state, change.Head.Branch(branch))
	// the branch, in an operation of the new workspace (its own undo)
	_ = try oplog.Run(store, a.Name, "tit workspace new " + a.Name, oplog.Op.Branch(a.Name), []oplog.RefChange{oplog.RefChange{Name: branch, Before: "", After: commitText(start)}})
	mut w = try open(Global{Json: false, Trace: false, Dir: dir, Color: false})
	let tree = try w.treeOf(start)
	try moveTo(mut w, object.NoId, tree, true)
	o.Line("Made the workspace " + a.Name + " in " + dir + ", on its branch " + a.Name + " from " + from + ".")
}

// WhoArgs are tit who's arguments.
type WhoArgs struct {
	Path str
	Most i64
}

type author struct {
	name    str
	email   str
	changes i64
	last    i64
}

// treeEntryId is the id of what path names in a tree (a file's blob or a directory's tree), or "".
fn treeEntryId(r mut Repo, tree object.Id, path str) !str {
	mut cur = tree
	let parts = twine.Split(path, "/")
	for i in 0..len(parts) {
		let o = try r.Store.Get(cur)
		mut next = ""
		match o {
			Tree(es) => {
				for e in es {
					if e.Name == parts[i] {
						next = e.Id.Bytes()
					}
				}
			}
			Commit(_) => {
			}
			Tag(_) => {
			}
			Blob(_) => {
			}
		}
		if len(next) == 0 {
			return ""
		}
		if i == len(parts) - 1 {
			return next
		}
		cur = try object.IdOf(next)
	}
	return ""
}

fn doWho(g Global, a WhoArgs, o mut Out) ! {
	mut r = try open(g)
	let rel = try r.rel(g, a.Path)
	let head = try r.resolve("HEAD")
	let ids = try revwalk.Walk(mut r.Store, []object.Id{head}, []object.Id{}, revwalk.Order.Date, a.Most)
	mut by = map[str]author{}
	mut order = []str{}
	for id in ids {
		let c = try commitData(mut r, id)
		let now = try treeEntryId(mut r, c.Tree, rel)
		mut before = ""
		if len(c.Parents) > 0 {
			let pt = try r.treeOf(c.Parents[0])
			before = try treeEntryId(mut r, pt, rel)
		}
		if now == before {
			continue
		}
		let key = c.Author.Email
		let (cur, seen) = by[key]
		if !seen {
			order = append(order, key)
			by[key] = author{name: c.Author.Name, email: c.Author.Email, changes: 1, last: c.Author.When}
		} else {
			mut last = cur.last
			if c.Author.When > last {
				last = c.Author.When
			}
			by[key] = author{name: cur.name, email: cur.email, changes: cur.changes + 1, last: last}
		}
	}
	if len(order) == 0 {
		o.Line("No commit in the last {len(ids)} changed " + rel + ".")
		return
	}
	sift.SortStableFunc(mut order, fn(x str, y str) i64 {
		let (ax, _) = by[x]
		let (ay, _) = by[y]
		return ay.changes - ax.changes
	})
	for k in order {
		let (au, _) = by[k]
		if g.Json {
			o.Line(jsonObject([]str{"name", jsonStr(au.name), "email", jsonStr(au.email), "changes", "{au.changes}", "last", "{au.last}"}))
			continue
		}
		o.Line(au.name + " <" + au.email + ">  " + count(au.changes, "change", "changes") + ", the last " + dateText(object.Person{Name: "", Email: "", When: au.last, Zone: 0}))
	}
}
