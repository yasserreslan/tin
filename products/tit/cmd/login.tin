package cmd

import "../identity"
import "../transport"
import "fault"
import "quarry"
import "seal"
import "tide"

// tit login, tit invite and tit key add (design/tit.md §18, #1017): signing in with a key, no password.

// LoginArgs is tit login's: the remote (a name or a URL) and an existing login request's code to approve.
type LoginArgs struct {
	Remote str
	Code   str
}

fn parseLogin(rest []str) !LoginArgs {
	mut a = LoginArgs{Remote: "origin", Code: ""}
	mut k = 0
	for k < len(rest) {
		if rest[k] == "--code" && k + 1 < len(rest) {
			k += 1
			a.Code = rest[k]
		} else if len(rest[k]) > 0 && rest[k][0] != '-' {
			a.Remote = rest[k]
		} else {
			fail fault.Wrap(ErrUsage, "login: unexpected {rest[k]}")
		}
		k += 1
	}
	return a
}

fn doLogin(g Global, a LoginArgs, o mut Out) ! {
	let r = try open(g)
	let url = try remoteURL(r, a.Remote)
	mut c = try client(r, url)
	mut code = a.Code
	mut where = ""
	if len(code) == 0 {
		let req = try c.LoginNew()
		code = req.Code
		where = req.Url
	}
	let st = try c.LoginApprove(code)
	o.Line("Login request {code} approved as {st.Email}.")
	if len(where) > 0 {
		o.Line("A browser waiting on {trimSlash(url)}{where} is signed in.")
	}
}

fn trimSlash(u str) str {
	mut s = u
	for len(s) > 0 && s[len(s) - 1] == '/' {
		s = s[0:len(s) - 1]
	}
	return s
}

fn doInvite(g Global, email str, o mut Out) ! {
	let r = try open(g)
	let code = try transport.MakeInvite(r.Ws.Store, email, tide.Wall() / 1000000000)
	if len(email) > 0 {
		o.Line("Invite {code} for {email}, good for 7 days and one key: tit key add <this server's URL> {code}")
	} else {
		o.Line("Invite {code}, good for 7 days and one key: tit key add <this server's URL> {code}")
	}
}

fn doKeyAdd(g Global, url str, invite str, o mut Out) ! {
	// the user's config, and the repository's over it when there is one
	mut cfg = try identity.Load("")
	let (r, oerr) = open(g)
	if oerr == nil {
		cfg = try r.config()
	}
	let email = cfg.Get("user.email")
	if email == nil {
		fail fault.Wrap(identity.ErrNoIdentity, "set user.email first (tit config set --user user.email ...)")
	}
	let keyPath = identity.DefaultKeyPath(cfg)
	if !quarry.Exists(keyPath) {
		let _ = try identity.NewKey(keyPath)
	}
	let signer = try identity.LoadKey(keyPath)
	let pub = seal.B64(signer.Public)
	mut c = transport.NewHttp(url, email, fn(payload str) ![]u8 {
		return try signer.Sign(payload)
	})
	let st = try c.KeyAdd(email, pub, invite)
	o.Line("Added the key of {st.Email} at {url}.")
}
