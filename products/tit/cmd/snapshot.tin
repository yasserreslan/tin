package cmd

import "../change"
import "../diff"
import "../ignore"
import "../index"
import "../merge"
import "../object"
import "../oplog"
import "../store"
import "../worktree"
import "fault"
import "flume"
import "quarry"
import "tide"
import "twine"

// Snapshots of the working directory, timeline, watch and park (#792). Before a command that changes the working
// directory runs, each file that differs from the last commit (changed, staged or untracked and not ignored) is put
// in the local store as a blob and listed in .tit/workspaces/<ws>/snapshots/<time>: the command on the first line,
// then "<blob>\t<mode>\t<path>" a file. A blob only a snapshot names is reachable from no commit, so nothing sends it
// anywhere; a file tit guard flags is not kept; a file over 16 MiB is not kept; snapshots expire after 14 days.

let snapshotDays = 14

let snapshotMost = 16 << 20

fn snapDir(r Repo) str {
	return r.Ws.State() + "/snapshots"
}

// changesWorkdir reports whether a command may change or remove working files (it snapshots them first).
fn changesWorkdir(c Command) bool {
	return match c {
		Switch(_) => true
		Merge(_) => true
		Undo(_, _) => true
		Redo => true
		Oplog(_) => true
		Pull(_) => true
		Sync(_) => true
		Stack(sa) => sa.Action != "stack"
		Rewrite(_) => true
		Park(_) => true
		Focus(_, _) => true
		Unpark(_) => true
		Rm(_) => true
		Mv(_, _) => true
		_ => false
	}
}

fn modeLetter(m object.Mode) str {
	if m == object.Mode.Exec {
		return "x"
	}
	if m == object.Mode.Link {
		return "l"
	}
	return "f"
}

// workChanges are the paths whose working file differs from the last commit, and that commit's tree.
fn workChanges(r mut Repo) !([]str, object.Id) {
	mut idx = try r.readIndex()
	let tree = try headTree(mut r)
	mut rules = try ignore.Load(r.Ws.Root)
	let full = try index.Status(mut r.Store, r.Ws.Root, tree, mut idx, mut rules)
	let rep = focused(r, full)
	try idx.Write(r.Ws.IndexPath())
	mut seen = map[str]bool{}
	mut paths = []str{}
	for f in rep.Staged {
		let p = newPath(mut seen, f)
		if len(p) > 0 {
			paths = append(paths, p)
		}
	}
	for f in rep.Unstaged {
		let p = newPath(mut seen, f)
		if len(p) > 0 {
			paths = append(paths, p)
		}
	}
	for p in rep.Untracked {
		let (_, dup) = seen[p]
		if !dup {
			seen[p] = true
			paths = append(paths, p)
		}
	}
	return paths, tree
}

// newPath is a status entry's path the first time it comes and not deleted, "" otherwise.
fn newPath(seen mut map[str]bool, f index.FileStatus) str {
	if letter(f) == "D" {
		return ""
	}
	let p = fpath(f)
	let (_, dup) = seen[p]
	if dup {
		return ""
	}
	seen[p] = true
	return p
}

// snapshot keeps the working files that differ from the last commit before command runs.
fn snapshot(r mut Repo, command str) ! {
	let (paths, _) = try workChanges(mut r)
	try expireSnapshots(r)
	if len(paths) == 0 {
		return
	}
	let rules = try guardRules(r.Ws.Root)
	mut loose = store.NewLoose(r.Ws.Store + "/objects")
	mut text = command + "\n"
	mut kept = 0
	for p in paths {
		let (info, ierr) = quarry.Lstat(r.Ws.Root + "/" + p)
		if ierr != nil || info.Size > snapshotMost || info.Type == quarry.FileType.Dir {
			continue
		}
		let (body, mode) = try readWork(r.Ws.Root, p)
		if !rules.Ignored(p, false) && len(Scan(p, body)) > 0 {
			// a private key or a token stays out of the store
			continue
		}
		let id = try loose.PutRaw(object.Kind.Blob, body)
		text = text + id.Hex() + "\t" + modeLetter(mode) + "\t" + p + "\n"
		kept += 1
	}
	if kept == 0 {
		return
	}
	try quarry.MkdirAll(snapDir(r))
	let name = snapDir(r) + "/{now()}"
	try quarry.WriteFile(name + ".tmp", text)
	try quarry.Rename(name + ".tmp", name)
}

// snapshotFor snapshots the working directory before a command that may change it.
fn snapshotFor(g Global, c Command) ! {
	if !changesWorkdir(c) {
		return
	}
	let (r0, err) = open(g)
	if err != nil {
		// not in a workspace: the command says so itself
		return
	}
	mut r = r0
	use lock = change.Lock(r.Ws.Store)
	try snapshot(mut r, "tit " + commandName(c))
}

fn expireSnapshots(r Repo) ! {
	let dir = snapDir(r)
	if !quarry.Exists(dir) {
		return
	}
	let oldest = now() - snapshotDays * 24 * 3600 * 1000000000
	let names = try quarry.ReadDir(dir)
	for n in names {
		let at = parseCount(n) catch _ {
			-1
		}
		if at >= 0 && at < oldest {
			try quarry.Remove(dir + "/" + n)
		}
	}
}

// Version is one kept version of a file.
type snapVersion struct {
	at      i64
	command str
	blob    str
	mode    str
}

// versionsOf are a file's kept versions, newest first, each different from the one after it.
fn versionsOf(r Repo, path str) ![]snapVersion {
	mut out = []snapVersion{}
	let dir = snapDir(r)
	if !quarry.Exists(dir) {
		return out
	}
	let names = try quarry.ReadDir(dir)
	mut ats = []i64{}
	for n in names {
		let at = parseCount(n) catch _ {
			-1
		}
		if at >= 0 {
			ats = append(ats, at)
		}
	}
	// newest first
	for i in 1..len(ats) {
		mut j = i
		for j > 0 && ats[j - 1] < ats[j] {
			let t = ats[j]
			ats[j] = ats[j - 1]
			ats[j - 1] = t
			j -= 1
		}
	}
	for at in ats {
		let text = try flume.ReadFile(dir + "/{at}")
		let lines = twine.Split(text, "\n")
		for l in lines[1:] {
			let parts = twine.SplitN(l, "\t", 3)
			if len(parts) != 3 || parts[2] != path {
				continue
			}
			if len(out) > 0 && out[len(out) - 1].blob == parts[0] {
				// the same content kept again by a later command: the older time stays
				out[len(out) - 1].at = at
				out[len(out) - 1].command = lines[0]
				continue
			}
			out = append(out, snapVersion{at: at, command: lines[0], blob: parts[0], mode: parts[1]})
		}
	}
	return out
}

// TimelineArgs are tit timeline's arguments.
type TimelineArgs struct {
	Path str
	Pick i64
}

fn whenText(at i64) str {
	return tide.Format(at, tide.Local(), "2006-01-02 15:04:05")
}

fn doTimeline(g Global, a TimelineArgs, o mut Out) ! {
	mut r = try open(g)
	let rel = try r.rel(g, a.Path)
	let vs = try versionsOf(r, rel)
	if a.Pick == 0 {
		if len(vs) == 0 && !g.Json {
			o.Line("No kept version of " + rel + " (versions are kept before commands that change files, and by tit watch).")
			return
		}
		for i in 0..len(vs) {
			let id = try object.ParseId(vs[i].blob)
			let (_, body) = try r.Store.GetRaw(id)
			if g.Json {
				o.Line(jsonObject([]str{"n", "{i + 1}", "time", "{vs[i].at}", "blob", jsonStr(vs[i].blob), "size", "{len(body)}", "before", jsonStr(vs[i].command)}))
				continue
			}
			o.Line("{i + 1}  " + whenText(vs[i].at) + "  " + vs[i].blob[0:12] + "  {len(body)} bytes  before " + vs[i].command)
		}
		return
	}
	if a.Pick > len(vs) {
		fail fault.Wrap(ErrUsage, "{rel} has {len(vs)} kept versions")
	}
	let v = vs[a.Pick - 1]
	// the file as it is now is kept first (after picking, so the numbers are the ones listed)
	use lock = change.Lock(r.Ws.Store)
	try snapshot(mut r, "tit timeline")
	let vid = try object.ParseId(v.blob)
	let (_, body) = try r.Store.GetRaw(vid)
	let full = r.Ws.Root + "/" + rel
	let slash = twine.LastIndex(full, "/")
	try quarry.MkdirAll(full[0:slash])
	if quarry.Exists(full) {
		try quarry.Remove(full)
	}
	if v.mode == "l" {
		try quarry.Symlink(body, full)
	} else {
		try quarry.WriteFile(full, body)
		if v.mode == "x" {
			try quarry.Chmod(full, 0o755)
		}
	}
	o.Line("Restored " + rel + " as it was at " + whenText(v.at) + " (before " + v.command + ").")
}

// WatchArgs are tit watch's arguments.
type WatchArgs struct {
	// Every is the polling interval in milliseconds; For stops after that many seconds (0: until interrupted).
	Every i64
	For   i64
}

// stamp is what a changed file looks like on the disk, to notice a save.
fn stampOf(root str, paths []str) str {
	mut s = ""
	for p in paths {
		let (info, err) = quarry.Lstat(root + "/" + p)
		if err == nil {
			s = s + p + "\t{info.Size}\t{info.Mtime}\n"
		}
	}
	return s
}

fn doWatch(g Global, a WatchArgs, o mut Out) ! {
	mut r = try open(g)
	let start = now()
	mut last = ""
	o.Line("Watching " + r.Ws.Root + " (every {a.Every} ms); each save is kept for tit timeline.")
	o.flush()
	for a.For == 0 || now() - start < a.For * 1000000000 {
		last = try watchOnce(mut r, last)
		tide.Sleep(a.Every * 1000000)
	}
}

// watchOnce snapshots the changed files when they look different from last time, under the lock; the lock is let go
// before the next poll (a use lasts to the end of its function).
fn watchOnce(r mut Repo, last str) !str {
	use lock = change.Lock(r.Ws.Store)
	let (paths, _) = try workChanges(mut r)
	let stamp = stampOf(r.Ws.Root, paths)
	if stamp != last && len(stamp) > 0 {
		try snapshot(mut r, "tit watch")
	}
	return stamp
}

// parked is where a parked set of changes is recorded.
fn parkPath(r Repo, name str) str {
	return r.Ws.State() + "/parked/" + name
}

fn doPark(g Global, name str, o mut Out) ! {
	mut r = try open(g)
	use lock = change.Lock(r.Ws.Store)
	if len(name) == 0 {
		let dir = r.Ws.State() + "/parked"
		if !quarry.Exists(dir) {
			return
		}
		let names = try quarry.ReadDir(dir)
		for n in names {
			let text = try flume.ReadFile(dir + "/" + n)
			let lines = twine.Split(text, "\n")
			if g.Json {
				o.Line(jsonObject([]str{"name", jsonStr(n), "branch", jsonStr(shortBranch(lines[0])), "commit", jsonStr(lines[1])}))
				continue
			}
			o.Line(n + "  on " + shortBranch(lines[0]) + " at " + lines[1][0:12])
		}
		return
	}
	try benchName(name)
	if quarry.Exists(parkPath(r, name)) {
		fail "{name} is parked already (tit unpark {name})"
	}
	if quarry.Exists(r.Ws.State() + "/MERGE_HEAD") {
		fail "a merge is in progress: commit it, or tit merge --abort"
	}
	let (paths, tree) = try workChanges(mut r)
	if len(paths) == 0 {
		fail "nothing to park: the working directory matches the last commit"
	}
	// the working directory as a tree: every file not ignored, as tit add . would stage it
	mut work = try r.readIndex()
	mut rules = try ignore.Load(r.Ws.Root)
	mut loose = store.NewLoose(r.Ws.Store + "/objects")
	try addDir(r.Ws.Root, "", mut work, mut loose, mut rules)
	removeMissing(r.Ws.Root, "", mut work, worktree.FocusOf(r.Ws))
	let parkTree = try index.WriteTree(mut loose, work)
	let branch = try currentBranch(r)
	let head = try r.headCommit()
	mut headText = object.NoId.Hex()
	if head != nil {
		headText = head.Hex()
	}
	try quarry.MkdirAll(r.Ws.State() + "/parked")
	try quarry.WriteFile(parkPath(r, name), branch + "\n" + headText + "\n" + tree.Hex() + "\n" + parkTree.Hex() + "\n")
	// back to the last commit; the index too
	mut idx = try r.readIndex()
	try worktree.Checkout(mut r.Store, r.Ws, mut idx, parkTree, tree, true)
	idx = try index.FromTree(mut r.Store, tree)
	try idx.Write(r.Ws.IndexPath())
	o.Line("Parked {len(paths)} changed files as " + name + "; the working directory matches the last commit.")
}

fn doUnpark(g Global, name str, o mut Out) ! {
	mut r = try open(g)
	use lock = change.Lock(r.Ws.Store)
	if !quarry.Exists(parkPath(r, name)) {
		fail "nothing is parked as {name} (tit park lists what is)"
	}
	let record = try flume.ReadFile(parkPath(r, name))
	let lines = twine.Split(record, "\n")
	if len(lines) < 4 {
		fail "the record of {name} is damaged: " + parkPath(r, name)
	}
	let branch = lines[0]
	let baseTree = try object.ParseId(lines[2])
	let parkTree = try object.ParseId(lines[3])
	let (paths, _) = try workChanges(mut r)
	if len(paths) > 0 {
		fail fault.Wrap(worktree.ErrDirty, "commit or park the changes first: " + twine.Join(paths, ", "))
	}
	let now1 = try currentBranch(r)
	if len(branch) > 0 && now1 != branch {
		// back to the branch the changes were parked on
		let refs = change.NewRefs(r.Ws.Store)
		let ref = try refs.Get(branch)
		if ref == nil {
			fail "{name} was parked on " + shortBranch(branch) + ", which is gone: tit switch -c " + shortBranch(branch) + " first"
		}
		let from = try headTree(mut r)
		let id = try r.resolve(branch)
		let to = try r.treeOf(id)
		let headMove = try headChange(r, change.Head.Branch(branch))
		try moveTo(mut r, from, to, false)
		try recordRefs(r, "tit unpark " + name, oplog.Op.Switch(shortBranch(branch)), []oplog.RefChange{headMove})
		o.Line("Switched to branch " + shortBranch(branch) + ".")
	}
	let headT = try headTree(mut r)
	mut target = parkTree
	mut conflicts = []merge.Conflict{}
	if headT != baseTree {
		// the branch moved since: the parked changes are merged onto it
		let res = try merge.MergeTrees(mut r.Store, baseTree, headT, parkTree)
		target = res.Tree
		conflicts = res.Conflicts
	}
	mut idx = try r.readIndex()
	try worktree.Checkout(mut r.Store, r.Ws, mut idx, headT, target, false)
	// the changes come back unstaged: the index stays at the last commit
	let changes = try diff.TreeDiff(mut r.Store, headT, target, false)
	let headIdx = try index.FromTree(mut r.Store, headT)
	for c in changes {
		let e = headIdx.Find(c.Path)
		if e != nil {
			idx.Set(e)
		} else {
			idx.Remove(c.Path)
		}
	}
	try idx.Write(r.Ws.IndexPath())
	for c in conflicts {
		let text = try conflictText(mut r, c, "parked " + name)
		try quarry.WriteFile(r.Ws.Root + "/" + c.Path, text)
		o.Line("CONFLICT: " + c.Path)
	}
	try quarry.Remove(parkPath(r, name))
	if len(conflicts) > 0 {
		fail "the parked changes conflict with commits made since on " + shortBranch(branch) + ": edit the files marked"
	}
	o.Line("Unparked " + name + ".")
}
