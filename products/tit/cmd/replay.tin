package cmd

import "../transport"
import "fault"
import "quarry"
import "spawn"
import "twine"

// tit replay (design/tit.md §17, #1027): send a server's version 2 replay capsules to a repository's host, list them,
// and fetch one to run with tin replay.

// ReplayArgs is tit replay's: push, ls, or a capsule id; the remote; push's commit and spool; ls's grouping; and
// for an id, tin replay's arguments (--against BUILD and the rest).
type ReplayArgs struct {
	Sub    str
	Remote str
	Commit str
	Spool  str
	Group  bool
	Id     str
	Tin    []str
}

fn parseReplay(rest []str) !ReplayArgs {
	mut a = ReplayArgs{Sub: "", Remote: "origin", Commit: "HEAD", Spool: "", Group: false, Id: "", Tin: []str{}}
	if len(rest) == 0 {
		fail fault.Wrap(ErrUsage, "replay push | ls | ID")
	}
	a.Sub = rest[0]
	mut k = 1
	for k < len(rest) {
		let x = rest[k]
		if x == "--remote" && k + 1 < len(rest) {
			k += 1
			a.Remote = rest[k]
		} else if x == "--commit" && k + 1 < len(rest) && a.Sub == "push" {
			k += 1
			a.Commit = rest[k]
		} else if x == "--group" && a.Sub == "ls" {
			a.Group = true
		} else if a.Sub != "push" && a.Sub != "ls" && twine.HasPrefix(x, "-") {
			// everything else after an id goes to tin replay (--against BUILD, --live KIND, --save-test NAME ...)
			for j in k..len(rest) {
				a.Tin = append(a.Tin, rest[j])
			}
			break
		} else if a.Sub == "push" && len(a.Spool) == 0 && !twine.HasPrefix(x, "-") {
			a.Spool = x
		} else {
			fail fault.Wrap(ErrUsage, "replay {a.Sub}: unexpected {x}")
		}
		k += 1
	}
	if a.Sub != "push" && a.Sub != "ls" {
		a.Id = a.Sub
		a.Sub = "get"
	}
	return a
}

fn doReplay(g Global, a ReplayArgs, o mut Out) ! {
	mut r = try open(g)
	let url = try remoteURL(r, a.Remote)
	mut c = try client(r, url)
	if a.Sub == "push" {
		mut spool = a.Spool
		if len(spool) == 0 {
			spool = quarry.Getenv("TIN_REPLAY_DIR")
		}
		if len(spool) == 0 {
			fail fault.Wrap(ErrUsage, "replay push: name the spool (or set TIN_REPLAY_DIR)")
		}
		let commit = try r.resolve(a.Commit)
		mut names = []str{}
		let all = try quarry.ReadDir(spool)
		for n in all {
			if twine.HasSuffix(n, ".tcap") {
				names = append(names, n)
			}
		}
		sortNames(mut names)
		mut sent = 0
		mut fresh = 0
		for n in names {
			let path = spool + "/" + n
			let data = try quarry.ReadFileBound(path, transport.MaxCapsule + 1)
			let ans = try c.ReplayPush(commit.Hex(), n, data)
			// sent: the spool lets it go (a push run again sends only what is left)
			try quarry.Remove(path)
			sent += 1
			if ans.New {
				fresh += 1
			}
		}
		o.Line("Sent {sent} capsules to {a.Remote} ({fresh} new).")
		return
	}
	let list = try c.ReplayList()
	if a.Sub == "ls" {
		if a.Group {
			mut order = []str{}
			mut counts = map[str]i64{}
			mut first = map[str]transport.ReplayEntry{}
			for e in list.Capsules {
				let (n, seen) = counts[e.Group]
				if !seen {
					order = append(order, e.Group)
					first[e.Group] = e
				}
				counts[e.Group] = n + 1
			}
			for gid in order {
				o.Line("{gid[0:12]}  {counts[gid]}  {summaryLine(first[gid].Summary)}")
			}
			return
		}
		for e in list.Capsules {
			o.Line("{e.Id[0:12]}  {e.Group[0:12]}  {summaryLine(e.Summary)}  {shortId(e.Commit)}")
		}
		return
	}
	// one capsule: by its id or a unique prefix of it
	mut id = ""
	mut signer = ""
	for e in list.Capsules {
		if twine.HasPrefix(e.Id, a.Id) {
			if len(id) > 0 && id != e.Id {
				fail fault.Wrap(ErrUsage, "replay: {a.Id} names more than one capsule")
			}
			id = e.Id
			signer = e.Signer
		}
	}
	if len(id) == 0 {
		fail fault.Wrap(ErrUsage, "replay: no capsule {a.Id} at {a.Remote}")
	}
	let (got, data) = try c.ReplayGet(id)
	let dir = r.Ws.Store + "/replay"
	try quarry.MkdirAll(dir)
	let path = dir + "/" + id + ".tcap"
	try quarry.WriteFile(path, data)
	if len(a.Tin) == 0 {
		o.Line("{path}  {got.Name}  served by {shortId(got.Commit)}  signed by {signer}")
		return
	}
	mut tin = quarry.Getenv("TIT_TIN")
	if len(tin) == 0 {
		tin = "tin"
	}
	mut argv = []str{tin, "replay", path}
	for x in a.Tin {
		argv = append(argv, x)
	}
	mut p = try spawn.Start(spawn.Cmd{Argv: argv, Env: spawn.Env.Inherit, Dir: "", Stdin: spawn.Stdio.Null, Stdout: spawn.Stdio.Inherit, Stderr: spawn.Stdio.Inherit, MaxOutput: 0, Input: ""})
	let code = try p.Wait()
	if code != 0 {
		quarry.Exit(code)
	}
}

// summaryLine is a capsule's plain summary on one line: "500 POST /checkout/7" and the panic when it has one.
fn summaryLine(s str) str {
	mut status = ""
	mut method = ""
	mut path = ""
	mut panicText = ""
	for line in twine.Split(s, "\n") {
		if twine.HasPrefix(line, "status=") {
			status = line[7:]
		} else if twine.HasPrefix(line, "method=") {
			method = line[7:]
		} else if twine.HasPrefix(line, "path=") {
			path = line[5:]
		} else if twine.HasPrefix(line, "panic=") {
			panicText = "  panic: " + line[6:]
		}
	}
	return status + " " + method + " " + path + panicText
}

fn shortId(hex str) str {
	if len(hex) > 12 {
		return hex[0:12]
	}
	return hex
}

fn sortNames(names mut []str) {
	for i in 1..len(names) {
		mut j = i
		for j > 0 && names[j - 1] > names[j] {
			let t = names[j - 1]
			names[j - 1] = names[j]
			names[j] = t
			j -= 1
		}
	}
}
