package cmd

import "../change"
import "../identity"
import "../index"
import "../object"
import "../oplog"
import "../packfile"
import "../revwalk"
import "../store"
import "../worktree"
import "fault"
import "quarry"
import "seal"
import "trail"
import "twine"

// Opening a repository: the workspace around the current directory (or -C), its objects (loose files and every pack,
// one layered store), and what resolving revisions needs.

// Repo is an open repository.
type Repo struct {
	Ws    worktree.Workspace
	Store  store.Layered
	ids    objects
	layers []dyn store.ObjectStore
}

// objects finds ids by prefix in the loose store and the packs.
type objects struct {
	loose store.Loose
	packs []packfile.Pack
}

// Match is every object whose id starts with the hex prefix.
fn (m objects) Match(prefix str) ![]object.Id {
	mut out = try m.loose.Match(prefix)
	for p in m.packs {
		for i in 0..p.Count {
			let id = p.IdAt(i)
			let h = id.Hex()
			if len(h) >= len(prefix) && h[0:len(prefix)] == prefix {
				out = append(out, id)
			}
		}
	}
	return out
}

fn open(g Global) !Repo {
	mut dir = g.Dir
	if len(dir) == 0 {
		dir = try quarry.Getwd()
	}
	let ws = try worktree.Find(dir)
	// an operation a crash cut short is rolled back before anything reads the repository (design section 9)
	if quarry.Exists(ws.Store + "/oplog/pending.op") {
		try recoverPending(ws.Store)
	}
	let loose = store.NewLoose(ws.Store + "/objects")
	mut layers = []dyn store.ObjectStore{loose}
	mut packs = []packfile.Pack{}
	let pdir = ws.Store + "/packs"
	if quarry.IsDir(pdir) {
		let names = try quarry.ReadDir(pdir)
		for n in names {
			if twine.HasSuffix(n, ".pack") && !twine.HasPrefix(n, "tmp-") {
				let p = try packfile.Open(pdir + "/" + n)
				packs = append(packs, p)
				layers = append(layers, p)
			}
		}
	}
	mut r = Repo{Ws: ws, Store: store.NewLayered(layers), ids: objects{loose: loose, packs: packs}, layers: layers}
	// a lazy clone reads what it left out from its remote (lazy.tin)
	let z = try lazyOf(r)
	if z != nil {
		r.Store = r.Store.WithFallback(z)
	}
	return r
}

fn recoverPending(store str) ! {
	// this process's own operation, between its record and its commit point, is not a crash
	let lockFile = store + "/lock"
	if quarry.Exists(lockFile) {
		let text = quarry.ReadFile(lockFile) catch _ {
			""
		}
		if twine.HasPrefix(text, "{quarry.Pid()} ") {
			return
		}
	}
	use lock = change.Lock(store)
	_ = try oplog.Recover(store)
}

// scratch is the repository's store with an in-memory layer in front that takes the writes: for objects a command
// needs only while it runs (the working directory's files for a diff, the index's tree), which never reach .tit.
fn (r Repo) scratch() store.Layered {
	return r.Store.Under(store.NewMem())
}

// rel is a path the user gave (relative to the current directory, or -C) as a path relative to the working
// directory's root, "" for the root itself.
fn (r Repo) rel(g Global, path str) !str {
	mut base = g.Dir
	if len(base) == 0 {
		base = try quarry.Getwd()
	}
	mut full = path
	if len(path) == 0 || path[0] != '/' {
		full = trail.Join2(base, path)
	}
	let root = trail.Clean(r.Ws.Root)
	let rel = try trail.Rel(root, trail.Clean(full))
	if rel == "." {
		return ""
	}
	if rel == ".." || twine.HasPrefix(rel, "../") {
		fail fault.Wrap(ErrUsage, "{path} is outside the working directory {root}")
	}
	return rel
}

// resolve is the commit a revision names.
fn (r mut Repo) resolve(rev str) !object.Id {
	let parsed = try revwalk.Parse(rev)
	mut rr = revwalk.Repo[store.Layered]{Dir: r.Ws.Store, WsDir: r.Ws.State(), Store: r.Store}
	return try revwalk.Resolve(mut rr, r.ids, parsed)
}

// resolveRev is the commit a parsed revision names.
fn (r mut Repo) resolveRev(rev revwalk.Rev) !object.Id {
	mut rr = revwalk.Repo[store.Layered]{Dir: r.Ws.Store, WsDir: r.Ws.State(), Store: r.Store}
	return try revwalk.Resolve(mut rr, r.ids, rev)
}

// headCommit is the commit HEAD names, or nil before the first commit.
fn (r mut Repo) headCommit() !?object.Id {
	let h = try change.ReadHead(r.Ws.State())
	match h {
		Branch(name) => {
			let refs = change.NewRefs(r.Ws.Store)
			let ref = try refs.Get(name)
			if ref == nil {
				return nil
			}
			// a branch names its commit: no object is read (resolving would read it, to peel a tag)
			match ref.Target {
				Commit(id) => {
					return id
				}
				Change(_) => {
				}
			}
			let id = try r.resolve(name)
			return id
		}
		Detached(_) => {
			let id = try r.resolve("HEAD")
			return id
		}
	}
}

// treeOf is a commit's tree.
fn (r mut Repo) treeOf(commit object.Id) !object.Id {
	let o = try r.Store.Get(commit)
	return match o {
		Commit(c) => c.Tree
		Blob(_) => try notCommitTree(commit)
		Tree(_) => try notCommitTree(commit)
		Tag(_) => try notCommitTree(commit)
	}
}

// headTreeOf is the tree of head, the commit HEAD names, remembered in the workspace (head-tree: "<commit> <tree>"),
// so that status and the commands that compare with the last commit need not read it (reading one object of a pack
// reads the pack). A commit's tree never changes: the file is only a cache, and one that does not match is ignored.
fn (r mut Repo) headTreeOf(head object.Id) !object.Id {
	let path = r.Ws.State() + "/head-tree"
	if quarry.Exists(path) {
		let text = quarry.ReadFile(path) catch _ {
			""
		}
		let parts = twine.Split(twine.TrimSpace(text), " ")
		if len(parts) == 2 && parts[0] == head.Hex() {
			let t = object.ParseId(parts[1]) catch _ {
				object.NoId
			}
			if t != object.NoId {
				return t
			}
		}
	}
	let tree = try r.treeOf(head)
	quarry.WriteFile(path, head.Hex() + " " + tree.Hex() + "\n") catch _ {
	}
	return tree
}

fn notCommitTree(id object.Id) !object.Id {
	fail fault.Wrap(revwalk.ErrBadRev, "{id.Hex()} is not a commit")
}

fn (r Repo) config() !identity.Config {
	return try identity.Load(r.Ws.Store)
}

fn (r Repo) readIndex() !index.Index {
	mut idx = try index.Read(r.Ws.IndexPath())
	// the tree of this very index file, remembered by its hash (index-tree: "<sum> <tree>"): status need not hash
	// every entry again to see that nothing is staged
	if len(idx.Sum) == 32 {
		let text = quarry.ReadFile(r.Ws.State() + "/index-tree") catch _ {
			""
		}
		let parts = twine.Split(twine.TrimSpace(text), " ")
		if len(parts) == 2 && parts[0] == seal.Hex([]u8(idx.Sum)) {
			idx.Tree = object.ParseId(parts[1]) catch _ {
				object.NoId
			}
		}
	}
	return idx
}

// rememberIndexTree keeps the tree status computed for the index file it read.
fn (r Repo) rememberIndexTree(idx index.Index) {
	if len(idx.Sum) == 32 && idx.Tree != object.NoId {
		quarry.WriteFile(r.Ws.State() + "/index-tree", seal.Hex([]u8(idx.Sum)) + " " + idx.Tree.Hex() + "\n") catch _ {
		}
	}
}
