package cmd

import "../change"
import "../index"
import "../object"
import "../worktree"
import "fault"
import "quarry"
import "twine"

// tit focus (#803): check out only some directories (worktree/focus.tin). Changing the focus writes the files that
// come into it and removes those that leave it, refusing, with nothing changed, when one that leaves has changes.

fn doFocus(g Global, dirs []str, all bool, o mut Out) ! {
	mut r = try open(g)
	use lock = change.Lock(r.Ws.Store)
	let old = worktree.FocusOf(r.Ws)
	if len(dirs) == 0 && !all {
		if len(old) == 0 {
			o.Line("Everything is checked out (tit focus <dir>... checks out only those directories).")
		}
		for d in old {
			o.Line(d)
		}
		return
	}
	mut next = []str{}
	for d in dirs {
		let rel = try r.rel(g, d)
		let clean = twine.Trim(rel, "/")
		if len(clean) == 0 {
			fail fault.Wrap(ErrUsage, "focus takes directories below the root (tit focus --all checks out everything)")
		}
		next = append(next, clean)
	}
	mut idx = try r.readIndex()
	mut leaving = []str{}
	mut coming = []str{}
	mut blocked = []str{}
	for e in idx.Entries {
		if e.Stage != 0 {
			blocked = append(blocked, e.Path)
			continue
		}
		let was = worktree.InFocus(old, e.Path)
		let now = worktree.InFocus(next, e.Path)
		if was && !now {
			let changed = try changedOnDisk(r.Ws.Root, e)
			if changed && quarry.Exists(r.Ws.Root + "/" + e.Path) {
				blocked = append(blocked, e.Path)
			}
			leaving = append(leaving, e.Path)
		} else if !was && now {
			coming = append(coming, e.Path)
		}
	}
	if len(blocked) > 0 {
		fail fault.Wrap(worktree.ErrDirty, "commit or park them first: " + twine.Join(blocked, ", "))
	}
	// the files that come in, fetched in one request in a lazy clone
	let z = try lazyOf(r)
	if z != nil {
		mut missing = []object.Id{}
		for p in coming {
			let e = idx.Find(p)
			if e != nil {
				let id = try object.IdOf(e.Hash)
				if !r.Store.Has(id) {
					missing = append(missing, id)
				}
			}
		}
		try r.fetchInto(z, missing)
	}
	let path = r.Ws.State() + "/focus"
	if len(next) == 0 {
		if quarry.Exists(path) {
			try quarry.Remove(path)
		}
	} else {
		try quarry.WriteFile(path, twine.Join(next, "\n") + "\n")
	}
	for p in leaving {
		let e = idx.Find(p)
		let full = r.Ws.Root + "/" + p
		if quarry.Exists(full) {
			try quarry.Remove(full)
		}
		pruneDirs(r.Ws.Root, p)
		if e != nil {
			idx.Set(index.Entry{Path: p, Hash: e.Hash, Mode: e.Mode, Stage: 0, Size: 0, Mtime: 0, Ctime: 0, Inode: 0, Device: 0})
		}
	}
	for p in coming {
		let e = idx.Find(p)
		if e == nil {
			continue
		}
		let id = try object.IdOf(e.Hash)
		let (_, body) = try r.Store.GetRaw(id)
		let full = r.Ws.Root + "/" + p
		let slash = twine.LastIndex(full, "/")
		try quarry.MkdirAll(full[0:slash])
		if quarry.Exists(full) {
			try quarry.Remove(full)
		}
		if e.Mode == object.Mode.Link {
			try quarry.Symlink(body, full)
		} else {
			try quarry.WriteFile(full, body)
			if e.Mode == object.Mode.Exec {
				try quarry.Chmod(full, 0o755)
			}
		}
		try index.AddStat(mut idx, r.Ws.Root, p, e.Hash, e.Mode)
	}
	try idx.Write(r.Ws.IndexPath())
	if len(next) == 0 {
		o.Line("Everything is checked out again ({len(coming)} files written).")
		return
	}
	o.Line("Focused on " + twine.Join(next, ", ") + ": {len(coming)} files written, {len(leaving)} removed.")
}
