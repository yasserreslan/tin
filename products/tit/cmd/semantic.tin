package cmd

import "../diff"
import "../object"
import "../revwalk"
import "../semantic"
import "../store"
import "twine"

// diff --semantic and tit history (#798): changes by Tin declaration.

fn isTin(path str) bool {
	return twine.HasSuffix(path, ".tin")
}

// changeLine is a declaration's change as diff --semantic prints it.
fn changeLine(c semantic.Change) str {
	return match c.Kind {
		Added => "added " + c.Key
		Removed => "removed " + c.Key
		Changed => "changed " + c.Key
		Moved => "moved " + c.Key + " (from " + c.OldPath + ")"
		Renamed => "renamed " + c.OldKey + " to " + c.Key
	}
}

// semanticOf compares the Tin files of a list of file changes.
fn semanticOf(s mut store.Layered, changes []diff.FileChange) ![]semantic.Change {
	mut paths = []str{}
	mut olds = []str{}
	mut news = []str{}
	for c in changes {
		if !isTin(c.Path) && !isTin(c.OldPath) {
			continue
		}
		let a = try blobText(mut s, c.OldHash)
		let b = try blobText(mut s, c.NewHash)
		if c.Kind == diff.Kind.Renamed {
			// a moved file: its declarations leave the old path and come to the new one, so each shows as moved
			paths = append(paths, c.OldPath, c.Path)
			olds = append(olds, a, "")
			news = append(news, "", b)
			continue
		}
		mut p = c.Path
		if c.Kind == diff.Kind.Deleted {
			p = c.OldPath
		}
		paths = append(paths, p)
		olds = append(olds, a)
		news = append(news, b)
	}
	return semantic.Compare(paths, olds, news)
}

fn writeSemantic(g Global, s mut store.Layered, changes []diff.FileChange, o mut Out) ! {
	let cs = try semanticOf(mut s, changes)
	mut byPath = map[str][]str{}
	mut order = []str{}
	for c in cs {
		let (cur, have) = byPath[c.Path]
		if !have {
			order = append(order, c.Path)
			byPath[c.Path] = []str{changeLine(c)}
		} else {
			byPath[c.Path] = append(cur, changeLine(c))
		}
	}
	for p in order {
		o.Line(paint(g, "1", p))
		let (ls, _) = byPath[p]
		for l in ls {
			o.Line("  " + l)
		}
	}
	for c in changes {
		if !isTin(c.Path) && !isTin(c.OldPath) {
			o.Line(paint(g, "1", c.Path) + "  (not Tin: " + diff.KindLetter(c.Kind) + ")")
		}
	}
}

// HistoryArgs are tit history's arguments.
type HistoryArgs struct {
	Name str
	Most i64
}

// declMatches reports whether a declaration's key (and its file's package, the directory's name) is the one asked
// for: "Name", "Type.Method", or either after "package.".
fn declMatches(key str, path str, pkg str, name str) bool {
	let sp = twine.IndexByte(key, ' ')
	if sp < 0 || key[sp + 1:] != name {
		return false
	}
	if len(pkg) == 0 {
		return true
	}
	// the package is the directory's name, or, for a package of one file (lib/quarry.tin in older history), the file's
	let dir = trailDir(path)
	mut base = path
	if len(dir) > 0 {
		base = path[len(dir) + 1:]
	}
	return dir == pkg || twine.HasSuffix(dir, "/" + pkg) || base == pkg + ".tin"
}

fn trailDir(path str) str {
	let slash = twine.LastIndex(path, "/")
	if slash < 0 {
		return ""
	}
	return path[0:slash]
}

fn doHistory(g Global, a HistoryArgs, o mut Out) ! {
	mut r = try open(g)
	// "quarry.ReadFile": the package is the part before the first dot when the rest names a declaration
	mut pkg = ""
	mut name = a.Name
	let parts = twine.Split(a.Name, ".")
	if len(parts) == 3 || (len(parts) == 2 && len(parts[0]) > 0 && parts[0][0] >= 'a' && parts[0][0] <= 'z') {
		pkg = parts[0]
		name = twine.Join(parts[1:], ".")
	}
	let head = try r.resolve("HEAD")
	let ids = try revwalk.Walk(mut r.Store, []object.Id{head}, []object.Id{}, revwalk.Order.Date, a.Most)
	mut found = 0
	for id in ids {
		let c = try commitData(mut r, id)
		mut before = object.NoId
		if len(c.Parents) > 0 {
			before = try r.treeOf(c.Parents[0])
		}
		let changes = try diff.TreeDiff(mut r.Store, before, c.Tree, true)
		mut tin = false
		for ch in changes {
			if isTin(ch.Path) || isTin(ch.OldPath) {
				tin = true
			}
		}
		if !tin {
			continue
		}
		let cs = try semanticOf(mut r.Store, changes)
		mut born = false
		for k in cs {
			if !declMatches(k.Key, k.Path, pkg, name) {
				continue
			}
			found += 1
			if g.Json {
				o.Line(jsonObject([]str{"commit", jsonStr(id.Hex()), "time", "{c.Author.When}", "kind", jsonStr(semantic.KindText(k.Kind)), "key", jsonStr(k.Key), "old_key", jsonStr(k.OldKey), "path", jsonStr(k.Path), "old_path", jsonStr(k.OldPath), "subject", jsonStr(firstLine(c.Message))}))
			} else {
				o.Line(paint(g, "33", id.Hex()[0:12]) + " " + dateText(c.Author)[4:16] + "  " + changeLine(k) + " in " + k.Path + "  " + firstLine(c.Message))
			}
			match k.Kind {
				Renamed => {
					// older commits know it by its old name
					let sp = twine.IndexByte(k.OldKey, ' ')
					name = k.OldKey[sp + 1:]
				}
				Moved => {
				}
				Added => {
					born = true
				}
				Removed => {
				}
				Changed => {
				}
			}
		}
		if born {
			break
		}
	}
	if found == 0 && !g.Json {
		o.Line("No commit among the last {len(ids)} changed " + a.Name + ".")
	}
}
