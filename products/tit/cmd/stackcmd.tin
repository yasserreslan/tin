package cmd

import "../change"
import "../diff"
import "../identity"
import "../index"
import "../object"
import "../oplog"
import "../revwalk"
import "../stack"
import "../store"
import "fault"
import "flume"
import "quarry"
import "twine"

// Stacks (#793): the changes of the current branch above the trunk, oldest first. Moving, splitting, absorbing into
// or editing a change rebases every change above it, as one operation; a conflict is recorded in the new version
// (#786) and the rebase goes on.

// StackArgs are the arguments of tit stack, move, split, absorb and edit.
type StackArgs struct {
	Action  str
	Change  str
	Other   str
	Before  bool
	Paths   []str
	Message str
}

// trunkOf is the branch stacks are counted from: stack.trunk, else main.
fn trunkOf(r Repo) !str {
	let cfg = try r.config()
	let t = cfg.Get("stack.trunk")
	if t != nil {
		return t
	}
	return "main"
}

// Stack is the current branch's changes above the trunk. The base is kept as its id's bytes: a field of another
// package's value struct type is laid out wrongly today (#847).
type Stack struct {
	Branch  str
	base    str
	Commits []object.Id
}

// Base is the commit the stack starts from.
fn (st Stack) Base() object.Id {
	return object.IdOf(st.base) catch _ {
		object.NoId
	}
}

fn stackOf(r mut Repo) !Stack {
	let branch = try currentBranch(r)
	if len(branch) == 0 {
		fail "HEAD is detached: a stack is a branch's changes"
	}
	let trunk = try trunkOf(r)
	let tip = try r.resolve(branch)
	let base = try r.resolve(trunk)
	let line = try revwalk.Walk(mut r.Store, []object.Id{tip}, []object.Id{base}, revwalk.Order.FirstParent, 0)
	mut cs = []object.Id{}
	for i in 0..len(line) {
		cs = append(cs, line[len(line) - 1 - i])
	}
	mut b = base
	if len(cs) > 0 {
		let first = try commitData(mut r, cs[0])
		if len(first.Parents) > 0 {
			b = first.Parents[0]
		}
	}
	return Stack{Branch: branch, base: b.Bytes(), Commits: cs}
}

// findChange is the position in the stack of the change whose id starts with letters.
fn findChange(r mut Repo, st Stack, letters str) !i64 {
	mut found = -1
	for i in 0..len(st.Commits) {
		let c = try commitData(mut r, st.Commits[i])
		if twine.HasPrefix(c.Change.Letters(), letters) {
			if found >= 0 {
				fail fault.Wrap(revwalk.ErrAmbiguous, "{letters} matches more than one change of the stack")
			}
			found = i
		}
	}
	if found < 0 {
		fail fault.Wrap(revwalk.ErrBadRev, "no change of the stack starts with {letters}")
	}
	return found
}

// Version is a change's new commit (its id's bytes, #847), recorded with the operation that made it.
type Version struct {
	change str
	commit str
}

// signed writes a commit, signed with the user's key when there is one.
fn putSigned(r mut Repo, c object.CommitData) !object.Id {
	let cfg = try r.config()
	let keyPath = identity.DefaultKeyPath(cfg)
	mut data = c
	if quarry.Exists(keyPath) {
		let signer = try identity.LoadKey(keyPath)
		data = try signer.SignCommit(c)
	}
	mut loose = store.NewLoose(r.Ws.Store + "/objects")
	return try loose.Put(object.Object.Commit(data))
}

fn committerOf(r Repo) !object.Person {
	let cfg = try r.config()
	return try identity.Who(cfg, identity.FixedClock{At: now()})
}

// replay picks each commit (oldest first) onto the one before it, starting from onto; it gives the new commits.
fn replay(r mut Repo, commits []object.Id, onto object.Id, versions mut []Version) ![]object.Id {
	let who = try committerOf(r)
	mut out = []object.Id{}
	mut parent = onto
	for c in commits {
		let data = try stack.Pick(mut r.Store, c, parent, who)
		let id = try putSigned(mut r, data)
		versions = append(versions, Version{change: data.Change.Letters(), commit: id.Bytes()})
		out = append(out, id)
		parent = id
	}
	return out
}

// restack moves the branch from oldTip to newTip in one operation, records the new versions, and moves the working
// directory (checked first: an unsaved edit in the way refuses everything). moveFiles false leaves the files alone.
fn restack(r mut Repo, command str, op oplog.Op, branch str, oldTip object.Id, newTip object.Id, versions []Version, extra []oplog.RefChange, moveFiles bool) ! {
	let from = try r.treeOf(oldTip)
	let to = try r.treeOf(newTip)
	if moveFiles {
		try checkMove(mut r, from, to)
	}
	mut moves = []oplog.RefChange{oplog.RefChange{Name: branch, Before: commitText(oldTip), After: commitText(newTip)}}
	for e in extra {
		moves = append(moves, e)
	}
	use tx = oplog.Begin(r.Ws.Store, r.Ws.Name, command, op, moves)
	try tx.Apply()
	let at = now()
	for v in versions {
		let cid = try object.ParseChangeId(v.change)
		let vid = try object.IdOf(v.commit)
		try change.AddVersion(r.Ws.Store, cid, change.NewVersion(tx.Number(), vid, at))
	}
	try tx.Commit()
	if moveFiles {
		mut fresh = try open(Global{Json: false, Trace: false, Dir: r.Ws.Root, Color: false})
		try moveTo(mut fresh, from, to, true)
	}
}

fn changeNames(r mut Repo, ids []object.Id) ![]str {
	mut out = []str{}
	for id in ids {
		let c = try commitData(mut r, id)
		out = append(out, c.Change.Letters())
	}
	return out
}

fn doStack(g Global, a StackArgs, o mut Out) ! {
	mut r = try open(g)
	if a.Action == "list" {
		let st = try stackOf(mut r)
		let trunk = try trunkOf(r)
		if g.Json {
			for id in st.Commits {
				let c = try commitData(mut r, id)
				o.Line(jsonObject([]str{"change", jsonStr(c.Change.Letters()), "commit", jsonStr(id.Hex()), "subject", jsonStr(firstLine(c.Message)), "conflicts", jsonList(stack.ConflictPaths(c))}))
			}
			return
		}
		if len(st.Commits) == 0 {
			o.Line("Nothing on " + shortBranch(st.Branch) + " above " + trunk + ".")
			return
		}
		o.Line(shortBranch(st.Branch) + ", above " + trunk + ", oldest first:")
		for id in st.Commits {
			let c = try commitData(mut r, id)
			mut mark = ""
			let ps = stack.ConflictPaths(c)
			if len(ps) > 0 {
				mark = paint(g, "31", "  conflicts: " + twine.Join(ps, ", "))
			}
			o.Line("  " + paint(g, "33", c.Change.Letters()[0:12]) + " " + id.Hex()[0:12] + " " + firstLine(c.Message) + mark)
		}
		return
	}
	use lock = change.Lock(r.Ws.Store)
	let st = try stackOf(mut r)
	if len(st.Commits) == 0 {
		fail "nothing on {shortBranch(st.Branch)} above the trunk"
	}
	let tip = st.Commits[len(st.Commits) - 1]
	if a.Action == "move" {
		let i = try findChange(mut r, st, a.Change)
		let j = try findChange(mut r, st, a.Other)
		if i == j {
			fail "a change cannot move next to itself"
		}
		mut order = []object.Id{}
		for k in 0..len(st.Commits) {
			if k == i {
				continue
			}
			if k == j && a.Before {
				order = append(order, st.Commits[i])
			}
			order = append(order, st.Commits[k])
			if k == j && !a.Before {
				order = append(order, st.Commits[i])
			}
		}
		mut first = 0
		for first < len(order) && order[first] == st.Commits[first] {
			first += 1
		}
		if first == len(order) {
			o.Line("The stack is in that order already.")
			return
		}
		mut onto = st.Base()
		if first > 0 {
			onto = order[first - 1]
		}
		mut versions = []Version{}
		let fresh = try replay(mut r, order[first:], onto, mut versions)
		let names = try changeNames(mut r, fresh)
		try restack(mut r, "tit move", oplog.Op.Move(a.Change), st.Branch, tip, fresh[len(fresh) - 1], versions, []oplog.RefChange{}, true)
		o.Line("Moved " + a.Change + "; rebased " + count(len(fresh), "change", "changes") + ": " + twine.Join(names, " "))
		return
	}
	if a.Action == "split" {
		let i = try findChange(mut r, st, a.Change)
		let c = try commitData(mut r, st.Commits[i])
		mut parent = st.Base()
		if i > 0 {
			parent = st.Commits[i - 1]
		}
		let ptree = try r.treeOf(parent)
		// the first part: the parent's tree with the paths as the change left them
		mut first = try index.FromTree(mut r.Store, ptree)
		let after = try index.FromTree(mut r.Store, c.Tree)
		mut rels = []str{}
		for p in a.Paths {
			let rel = try r.rel(g, p)
			rels = append(rels, rel)
		}
		mut moved = 0
		for e in first.Entries {
			for rel in rels {
				if under(e.Path, rel) && after.Find(e.Path) == nil {
					moved += 1
				}
			}
		}
		for rel in rels {
			mut gone = []str{}
			for e in first.Entries {
				if under(e.Path, rel) {
					gone = append(gone, e.Path)
				}
			}
			for p in gone {
				first.Remove(p)
			}
			for e in after.Entries {
				if under(e.Path, rel) {
					first.Set(e)
					moved += 1
				}
			}
		}
		if moved == 0 {
			fail "{a.Change} does not change those paths"
		}
		mut loose = store.NewLoose(r.Ws.Store + "/objects")
		let tree1 = try index.WriteTree(mut loose, first)
		if tree1 == c.Tree {
			fail "those paths are all of {a.Change}: there is nothing left to split off"
		}
		let who = try committerOf(r)
		mut msg = a.Message
		if len(msg) == 0 {
			msg = "Part of: " + firstLine(c.Message)
		}
		let part = object.CommitData{Tree: tree1, Parents: []object.Id{parent}, Change: object.NewChangeId(), Author: c.Author, Committer: who, GitHeaders: []str{}, Signature: "", Message: cleanMessage(msg, false), Conflicts: []str{}}
		let partId = try putSigned(mut r, part)
		let rest = object.CommitData{Tree: c.Tree, Parents: []object.Id{partId}, Change: c.Change, Author: c.Author, Committer: who, GitHeaders: []str{}, Signature: "", Message: c.Message, Conflicts: c.Conflicts}
		let restId = try putSigned(mut r, rest)
		mut versions = []Version{Version{change: part.Change.Letters(), commit: partId.Bytes()}, Version{change: c.Change.Letters(), commit: restId.Bytes()}}
		mut newTip = restId
		if i + 1 < len(st.Commits) {
			let fresh = try replay(mut r, st.Commits[i + 1:], restId, mut versions)
			newTip = fresh[len(fresh) - 1]
		}
		try restack(mut r, "tit split", oplog.Op.Split(a.Change), st.Branch, tip, newTip, versions, []oplog.RefChange{}, true)
		o.Line("Split " + a.Change + ": " + part.Change.Letters()[0:12] + " holds " + twine.Join(a.Paths, " ") + ", " + a.Change + " the rest.")
		return
	}
	if a.Action == "absorb" {
		try absorb(g, mut r, st, mut o)
		return
	}
	if a.Action == "edit" {
		let i = try findChange(mut r, st, a.Change)
		try startEdit(mut r, st, i, mut o)
		return
	}
	fail fault.Wrap(ErrUsage, "stack | move | split | absorb | edit")
}

// hunk is one run of changed lines: lines [a0, a1) of the old text became lines [b0, b1) of the new.
type hunk struct {
	a0 i64
	a1 i64
	b0 i64
	b1 i64
}

fn hunksOf(a []str, b []str) []hunk {
	let es = diff.Diff(a, b)
	mut out = []hunk{}
	mut i = 0
	mut j = 0
	mut open = false
	mut cur = hunk{a0: 0, a1: 0, b0: 0, b1: 0}
	for e in es {
		match e {
			Keep(n) => {
				if open {
					out = append(out, cur)
					open = false
				}
				i += n
				j += n
			}
			Insert(n) => {
				if !open {
					cur = hunk{a0: i, a1: i, b0: j, b1: j}
					open = true
				}
				j += n
				cur.b1 = j
			}
			Delete(n) => {
				if !open {
					cur = hunk{a0: i, a1: i, b0: j, b1: j}
					open = true
				}
				i += n
				cur.a1 = i
			}
		}
	}
	if open {
		out = append(out, cur)
	}
	return out
}

// applyHunks is a with the chosen hunks of the change from a to b applied.
fn applyHunks(a []str, b []str, hs []hunk, take []bool) str {
	mut out = []u8{}
	mut i = 0
	for k in 0..len(hs) {
		let h = hs[k]
		for i < h.a0 {
			out = append(out, []u8(a[i])...)
			i += 1
		}
		if take[k] {
			for j in h.b0..h.b1 {
				out = append(out, []u8(b[j])...)
			}
		} else {
			for x in h.a0..h.a1 {
				out = append(out, []u8(a[x])...)
			}
		}
		i = h.a1
	}
	for i < len(a) {
		out = append(out, []u8(a[i])...)
		i += 1
	}
	return str(out)
}

fn blobOf(r mut Repo, hash str) !str {
	if len(hash) == 0 {
		return ""
	}
	let id = try object.IdOf(hash)
	let (_, b) = try r.Store.GetRaw(id)
	return b
}

// fileIn is a file's blob id (as bytes) in a commit's tree, or "".
fn fileIn(r mut Repo, commit object.Id, path str) !str {
	let t = try r.treeOf(commit)
	return try treeEntryId(mut r, t, path)
}

// absorb sends each uncommitted hunk to the change of the stack that last touched those lines; a hunk no single
// change owns stays uncommitted. The changes and everything above them are rebased in one operation.
fn absorb(g Global, r mut Repo, st Stack, o mut Out) ! {
	mut idx = try r.readIndex()
	let tip = st.Commits[len(st.Commits) - 1]
	let tipTree = try r.treeOf(tip)
	// staged changes would be taken into the commits silently: absorb starts from an index equal to HEAD
	mut sc = r.scratch()
	let staged = try index.WriteTree(mut sc, idx)
	if staged != tipTree {
		fail "absorb takes changes from the working directory: unstage yours first (the index differs from HEAD)"
	}
	let rv = try open(Global{Json: false, Trace: false, Dir: r.Ws.Root, Color: false})
	mut sc2 = rv.scratch()
	let changes = try worktreeChanges(rv, mut sc2)
	// what goes where: the change's position, the path and the file's new content at that change
	mut planAt = []i64{}
	mut planPath = []str{}
	mut planText = []str{}
	mut absorbed = 0
	mut stays = []str{}
	for ch in changes {
		if ch.Kind != diff.Kind.Modified {
			stays = append(stays, ch.Path + " (not a modified file)")
			continue
		}
		// the newest change of the stack that touched this file
		mut owner = -1
		for k in 0..len(st.Commits) {
			let i = len(st.Commits) - 1 - k
			let now2 = try fileIn(mut r, st.Commits[i], ch.Path)
			mut before = ""
			if i == 0 {
				before = try fileIn(mut r, st.Base(), ch.Path)
			} else {
				before = try fileIn(mut r, st.Commits[i - 1], ch.Path)
			}
			if now2 != before {
				owner = i
				break
			}
		}
		let headText = try blobOf(mut r, ch.OldHash)
		let wid = try object.IdOf(ch.NewHash)
		let (_, workText) = try sc2.GetRaw(wid)
		let a = diff.Lines(headText)
		let b = diff.Lines(workText)
		let hs = hunksOf(a, b)
		if owner < 0 {
			for h in hs {
				stays = append(stays, ch.Path + ":{h.a0 + 1} (no change of the stack touched this file)")
			}
			continue
		}
		// the lines the owner changed, in its version of the file (which HEAD's equals: no later change touched it)
		mut parentOf = st.Base()
		if owner > 0 {
			parentOf = st.Commits[owner - 1]
		}
		let ownerBefore = try fileIn(mut r, parentOf, ch.Path)
		let beforeText = try blobOf(mut r, ownerBefore)
		let owned = hunksOf(diff.Lines(beforeText), a)
		mut take = []bool{}
		mut any = false
		for h in hs {
			mut hit = false
			for w in owned {
				// a fix touches the lines the change wrote, or lines right next to them
				if h.a0 <= w.b1 && w.b0 <= h.a1 {
					hit = true
				}
			}
			take = append(take, hit)
			if hit {
				absorbed += 1
				any = true
			} else {
				stays = append(stays, ch.Path + ":{h.a0 + 1} (lines no change of the stack wrote)")
			}
		}
		if any {
			planAt = append(planAt, owner)
			planPath = append(planPath, ch.Path)
			planText = append(planText, applyHunks(a, b, hs, take))
		}
	}
	if absorbed == 0 {
		o.Line("Nothing to absorb: no hunk belongs to one change of the stack.")
		for s in stays {
			o.Line("  stays: " + s)
		}
		return
	}
	// rebuild the stack from the first target up
	mut first = len(st.Commits)
	mut targets = map[i64]bool{}
	for i in planAt {
		targets[i] = true
		if i < first {
			first = i
		}
	}
	let who = try committerOf(r)
	mut versions = []Version{}
	mut parent = st.Base()
	if first > 0 {
		parent = st.Commits[first - 1]
	}
	mut loose = store.NewLoose(r.Ws.Store + "/objects")
	for i in first..len(st.Commits) {
		mut data = try stack.Pick(mut r.Store, st.Commits[i], parent, who)
		if i == first {
			data = try commitData(mut r, st.Commits[i])
			data = object.CommitData{Tree: data.Tree, Parents: data.Parents, Change: data.Change, Author: data.Author, Committer: who, GitHeaders: []str{}, Signature: "", Message: data.Message, Conflicts: data.Conflicts}
		}
		let (_, target) = targets[i]
		if target {
			mut ti = try index.FromTree(mut r.Store, data.Tree)
			for k in 0..len(planAt) {
				if planAt[k] != i {
					continue
				}
				let path = planPath[k]
				let text = planText[k]
				let e = ti.Find(path)
				if e == nil {
					continue
				}
				let bid = try loose.PutRaw(object.Kind.Blob, text)
				ti.Set(index.Entry{Path: path, Hash: bid.Bytes(), Mode: e.Mode, Stage: 0, Size: 0, Mtime: 0, Ctime: 0, Inode: 0, Device: 0})
			}
			let nt = try index.WriteTree(mut loose, ti)
			data = object.CommitData{Tree: nt, Parents: data.Parents, Change: data.Change, Author: data.Author, Committer: who, GitHeaders: []str{}, Signature: "", Message: data.Message, Conflicts: data.Conflicts}
		}
		let id = try putSigned(mut r, data)
		versions = append(versions, Version{change: data.Change.Letters(), commit: id.Bytes()})
		parent = id
	}
	try restack(mut r, "tit absorb", oplog.Op.Absorb, st.Branch, tip, parent, versions, []oplog.RefChange{}, false)
	// the index follows the new tip; the working directory keeps every edit, so what stays shows as unstaged
	mut fresh = try open(Global{Json: false, Trace: false, Dir: r.Ws.Root, Color: false})
	let newTree = try fresh.treeOf(parent)
	mut ni = try index.FromTree(mut fresh.Store, newTree)
	try ni.Write(fresh.Ws.IndexPath())
	o.Line("Absorbed " + count(absorbed, "hunk", "hunks") + " into " + count(len(targets), "change", "changes") + ".")
	for s in stays {
		o.Line("  stays: " + s)
	}
}

// startEdit puts HEAD on a change of the stack so it can be amended: the files and the index are the change's (with
// git's markers where it records conflicts), and the stack waits in .tit/workspaces/<name>/EDIT until tit commit
// --amend rebases what is above it.
fn startEdit(r mut Repo, st Stack, i i64, o mut Out) ! {
	let path = r.Ws.State() + "/EDIT"
	if quarry.Exists(path) {
		fail "a change is being edited already: tit commit --amend finishes it"
	}
	let target = st.Commits[i]
	let tip = st.Commits[len(st.Commits) - 1]
	let from = try r.treeOf(tip)
	let to = try r.treeOf(target)
	try checkMove(mut r, from, to)
	let headMove = try headChange(r, change.Head.Detached(change.Target.Commit(target)))
	try recordRefs(r, "tit edit", oplog.Op.Switch(target.Hex()), []oplog.RefChange{headMove})
	try quarry.WriteFile(path, st.Branch + "\n" + tip.Hex() + "\n" + target.Hex() + "\n")
	mut fresh = try open(Global{Json: false, Trace: false, Dir: r.Ws.Root, Color: false})
	try moveTo(mut fresh, from, to, true)
	let c = try commitData(mut fresh, target)
	if len(c.Conflicts) > 0 {
		mut idx = try fresh.readIndex()
		for line in c.Conflicts {
			let k = try stack.ParseConflict(line)
			let text = try conflictText(mut fresh, k, "theirs")
			let full = fresh.Ws.Root + "/" + k.Path
			let slash = twine.LastIndex(full, "/")
			try quarry.MkdirAll(full[0:slash])
			if quarry.Exists(full) {
				try quarry.Remove(full)
			}
			try quarry.WriteFile(full, text)
			idx.SetConflict(k.Path, object.Mode.File, hashOf(k.Base()), hashOf(k.Ours()), hashOf(k.Theirs()))
		}
		try idx.Write(fresh.Ws.IndexPath())
		o.Line("Editing " + c.Change.Letters()[0:12] + ", which records conflicts in " + twine.Join(stack.ConflictPaths(c), ", ") + ": resolve them, tit add, then tit commit --amend.")
		return
	}
	o.Line("Editing " + c.Change.Letters()[0:12] + ": change the files, then tit commit --amend (the changes above it follow).")
}

// editState is the change being edited: the branch, its tip then, and the change's commit then.
fn editState(r Repo) !?str {
	let path = r.Ws.State() + "/EDIT"
	if !quarry.Exists(path) {
		return nil
	}
	let text = try flume.ReadFile(path)
	return text
}

// finishEdit is commit --amend while editing: the new version of the edited change, everything above it rebased onto
// it, the branch moved and HEAD back on it, in one operation.
fn finishEdit(r mut Repo, state str, amended object.CommitData, o mut Out) ! {
	let lines = twine.Split(twine.TrimSpace(state), "\n")
	if len(lines) != 3 {
		fail "{r.Ws.State()}/EDIT is damaged"
	}
	let branch = lines[0]
	let oldTip = try object.ParseId(lines[1])
	let edited = try object.ParseId(lines[2])
	let newId = try putSigned(mut r, amended)
	mut versions = []Version{Version{change: amended.Change.Letters(), commit: newId.Bytes()}}
	// the changes above the edited one, oldest first
	let above = try revwalk.Walk(mut r.Store, []object.Id{oldTip}, []object.Id{edited}, revwalk.Order.FirstParent, 0)
	mut order = []object.Id{}
	for i in 0..len(above) {
		order = append(order, above[len(above) - 1 - i])
	}
	mut newTip = newId
	if len(order) > 0 {
		let fresh = try replay(mut r, order, newId, mut versions)
		newTip = fresh[len(fresh) - 1]
	}
	let headMove = try headChange(r, change.Head.Branch(branch))
	// the files: from the amended change (the index's tree) to the new tip
	let from = amended.Tree
	let to = try r.treeOf(newTip)
	use tx = oplog.Begin(r.Ws.Store, r.Ws.Name, "tit commit --amend (editing)", oplog.Op.Amend(amended.Change.Letters()), []oplog.RefChange{oplog.RefChange{Name: branch, Before: commitText(oldTip), After: commitText(newTip)}, headMove})
	try tx.Apply()
	let at = now()
	for v in versions {
		let cid = try object.ParseChangeId(v.change)
		let vid = try object.IdOf(v.commit)
		try change.AddVersion(r.Ws.Store, cid, change.NewVersion(tx.Number(), vid, at))
	}
	try quarry.Remove(r.Ws.State() + "/EDIT")
	try tx.Commit()
	mut fresh = try open(Global{Json: false, Trace: false, Dir: r.Ws.Root, Color: false})
	try moveTo(mut fresh, from, to, true)
	o.Line("Amended " + amended.Change.Letters()[0:12] + "; " + count(len(order), "change", "changes") + " above it rebased; back on " + shortBranch(branch) + ".")
}
