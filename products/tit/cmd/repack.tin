package cmd

import "../change"
import "../object"
import "../packfile"
import "quarry"
import "tide"
import "twine"

// tit repack (#778): every pack into three (commits and tags, trees, blobs), its deltas searched again and its entries compressed on every core. adopt
// leaves three packs (it merges its batches' packs of each kind), but each later adopt and each fetch adds packs, and
// each pack is one more index to search for every object read. Loose objects stay as they are (large files among them
// are kept in chunks). The new pack is in place before the old ones go, so a crash leaves objects twice, never missing;
// the old ones are retired (packfile.Retire), so a reader that listed them still finds them (#1007).

fn doRepack(g Global, all bool, o mut Out) ! {
	mut r = try open(g)
	use lock = change.Lock(r.Ws.Store)
	let dir = r.Ws.Store + "/packs"
	mut old = []str{}
	if quarry.IsDir(dir) {
		let names = try quarry.ReadDir(dir)
		for n in names {
			if twine.HasSuffix(n, ".pack") && !twine.HasPrefix(n, "tmp-") {
				old = append(old, n[0:len(n) - 5])
			}
		}
	}
	if len(old) < 4 && !(all && len(old) > 0) {
		o.Line("Nothing to repack: {len(old)} packs.")
		return
	}
	// commits and tags in one pack, trees in another, blobs in a third: a log then reads only the first
	mut commits = []object.Id{}
	mut trees = []object.Id{}
	mut blobs = []object.Id{}
	for k in 0..len(r.ids.packs) {
		mut p = r.ids.packs[k]
		for i in 0..p.Count {
			let id = p.IdAt(i)
			let kind = try p.KindAt(i)
			match kind {
				Commit, Tag => {
					commits = append(commits, id)
				}
				Tree => {
					trees = append(trees, id)
				}
				Blob => {
					blobs = append(blobs, id)
				}
			}
		}
	}
	mut made = []str{}
	mut count = 0
	mut size = 0
	mut deltas = 0
	for part in [][]object.Id{commits, trees, blobs} {
		if len(part) == 0 {
			continue
		}
		mut p = try packfile.Write(mut r.Store, part, dir)
		made = append(made, p.Path[len(dir) + 1:len(p.Path) - 5])
		count += p.Count
		deltas += p.Deltas()
		let info = try quarry.Lstat(p.Path)
		size += info.Size
	}
	// the old packs are retired, not deleted: a reader that listed them before keeps reading them in packs/retired
	// until they have been retired longer than the grace period (#1007)
	mut gone = []str{}
	for n in old {
		mut kept = false
		for m in made {
			if m == n {
				kept = true
			}
		}
		if !kept {
			gone = append(gone, n)
		}
	}
	let now = tide.Wall() / 1000000000
	_ = try packfile.Retire(dir, gone, now)
	_ = try packfile.Sweep(dir, packfile.Grace(), now)
	o.Line("Packed {count} objects from {len(old)} packs into {len(made)}: commits, trees and blobs apart ({size / 1048576} MiB, {deltas} deltas).")
}
