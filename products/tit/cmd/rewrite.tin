package cmd

import "../change"
import "../ignore"
import "../index"
import "../object"
import "../oplog"
import "../revwalk"
import "../store"
import "../worktree"
import "fault"
import "quarry"
import "seal"
import "spawn"
import "twine"

// tit rewrite (#800): a command run on every change of a stack (or of every branch), each on its own snapshot in a
// working directory of its own; what the command leaves is the change's new version, chained onto the one below. A failing
// command stops nothing: its change keeps what it was, and the failures are listed. Every branch moves in one
// operation, so one undo reverses all of it.

// RewriteArgs are tit rewrite's arguments.
type RewriteArgs struct {
	Command  str
	Branches bool
}

// rewriteOne runs the command on a commit's tree in a temporary directory and gives the tree it leaves, the
// command's exit status and its output.
fn rewriteOne(r mut Repo, tree object.Id, command str) !(object.Id, i64, str) {
	let tmp = r.Ws.Store + "/tmp-rewrite-" + seal.Hex(seal.RandomBytes(8))
	try quarry.MkdirAll(tmp)
	let ws = worktree.Workspace{Name: "rewrite", Root: tmp, Store: r.Ws.Store}
	mut idx = index.New()
	try worktree.Checkout(mut r.Store, ws, mut idx, object.NoId, tree, true)
	let res = try spawn.Run(spawn.Cmd{Argv: []str{"/bin/sh", "-c", command}, Env: spawn.Env.Inherit, Dir: tmp, Stdin: spawn.Stdio.Null, Stdout: spawn.Stdio.Pipe, Stderr: spawn.Stdio.Pipe, MaxOutput: 0, Input: ""})
	// what the command left, as a tree: every file not ignored, as tit add . would stage it
	mut after = index.New()
	mut rules = try ignore.Load(tmp)
	mut loose = store.NewLoose(r.Ws.Store + "/objects")
	try addDir(tmp, "", mut after, mut loose, mut rules)
	let t = try index.WriteTree(mut loose, after)
	try quarry.RemoveAll(tmp)
	return t, res.Code, res.Stdout + res.Stderr
}

fn doRewrite(g Global, a RewriteArgs, o mut Out) ! {
	mut r = try open(g)
	use lock = change.Lock(r.Ws.Store)
	let trunk = try trunkOf(r)
	let trunkTip = try r.resolve(trunk)
	let current = try currentBranch(r)
	mut branches = []str{}
	if a.Branches {
		let refs = change.NewRefs(r.Ws.Store)
		let all = try refs.List("refs/heads/")
		for ref in all {
			if ref.Name != "refs/heads/" + trunk {
				branches = append(branches, ref.Name)
			}
		}
	} else {
		if len(current) == 0 || current == "refs/heads/" + trunk {
			fail "rewrite works on a stack: switch to a branch above {trunk} (or use --all)"
		}
		branches = append(branches, current)
	}
	let who = try committerOf(r)
	mut moves = []oplog.RefChange{}
	mut versions = []Version{}
	mut failed = []str{}
	mut rewritten = 0
	// a change in several branches is rewritten once
	mut done = map[str]str{}
	mut currentFrom = object.NoId
	mut currentTo = object.NoId
	for b in branches {
		let tip = try r.resolve(b)
		let line = try revwalk.Walk(mut r.Store, []object.Id{tip}, []object.Id{trunkTip}, revwalk.Order.FirstParent, 0)
		if len(line) == 0 {
			continue
		}
		mut parent = object.NoId
		let oldest = try commitData(mut r, line[len(line) - 1])
		if len(oldest.Parents) > 0 {
			parent = oldest.Parents[0]
		}
		mut changed = false
		for k in 0..len(line) {
			let c = line[len(line) - 1 - k]
			let (seen, have) = done[c.Bytes()]
			if have {
				let sid = try object.IdOf(seen)
				parent = sid
				if sid != c {
					changed = true
				}
				continue
			}
			// each change's own snapshot goes through the command (as a tree filter does): the results are chained,
			// so nothing is merged and nothing can conflict
			let cd = try commitData(mut r, c)
			let (tree, code, out) = try rewriteOne(mut r, cd.Tree, a.Command)
			mut next = c
			mut t = cd.Tree
			if code != 0 {
				failed = append(failed, cd.Change.Letters()[0:12] + " " + firstLine(cd.Message) + " (status {code}): " + twine.TrimSpace(out))
			} else if tree != cd.Tree {
				t = tree
				rewritten += 1
			}
			if t != cd.Tree || len(cd.Parents) == 0 || cd.Parents[0] != parent {
				let data = object.CommitData{Tree: t, Parents: []object.Id{parent}, Change: cd.Change, Author: cd.Author, Committer: who, GitHeaders: []str{}, Signature: "", Message: cd.Message, Conflicts: cd.Conflicts}
				next = try putSigned(mut r, data)
				versions = append(versions, Version{change: cd.Change.Letters(), commit: next.Bytes()})
				changed = true
			}
			done[c.Bytes()] = next.Bytes()
			parent = next
		}
		if changed {
			moves = append(moves, oplog.RefChange{Name: b, Before: commitText(tip), After: commitText(parent)})
			if b == current {
				currentFrom = try r.treeOf(tip)
				currentTo = try r.treeOf(parent)
			}
		}
	}
	if len(moves) == 0 {
		o.Line("Nothing changed: the command left every change as it was.")
		for f in failed {
			o.Line("  failed: " + f)
		}
		return
	}
	let moveFiles = currentFrom != object.NoId
	if moveFiles {
		try checkMove(mut r, currentFrom, currentTo)
	}
	use tx = oplog.Begin(r.Ws.Store, r.Ws.Name, "tit rewrite", oplog.Op.Rewrite(a.Command), moves)
	try tx.Apply()
	let at = now()
	for v in versions {
		let cid = try object.ParseChangeId(v.change)
		let vid = try object.IdOf(v.commit)
		try change.AddVersion(r.Ws.Store, cid, change.NewVersion(tx.Number(), vid, at))
	}
	try tx.Commit()
	if moveFiles {
		mut fresh = try open(Global{Json: false, Trace: false, Dir: r.Ws.Root, Color: false})
		try moveTo(mut fresh, currentFrom, currentTo, true)
	}
	o.Line("Rewrote " + count(rewritten, "change", "changes") + " on " + count(len(moves), "branch", "branches") + ".")
	for f in failed {
		o.Line("  failed: " + f)
	}
	if len(failed) > 0 {
		fail fault.Wrap(ErrUsage, "{len(failed)} commands failed; their changes kept what they were")
	}
}
