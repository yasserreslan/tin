package cmd

import "../change"
import "../object"
import "../oplog"
import "../transport"
import "argo"
import "fault"
import "tide"
import "twine"

// Never losing work (#792): undo, redo, and the oplog itself (list, show, restore). An undo reverses one operation's
// ref changes as a new operation, in this workspace, and refuses when another operation moved those refs since. When
// it moves this workspace's HEAD (undoing a switch), the working directory moves with it, after the same checks as
// a switch; when it moves only a branch (undoing a commit or a merge), the files stay as they are, so what the
// operation recorded shows as staged changes and nothing on the disk is lost.

// OplogArgs are tit oplog's arguments.
type OplogArgs struct {
	Action str
	N      i64
	Yes    bool
}

// headTarget is the commit this workspace's HEAD names once the ref changes plan are made, and whether plan moves
// this workspace's HEAD at all.
fn headTarget(r mut Repo, plan []oplog.RefChange) !(bool, object.Id) {
	let me = oplog.HeadRef(r.Ws.Name)
	mut headText = ""
	for rc in plan {
		if rc.Name == me {
			headText = rc.After
		}
	}
	if len(headText) == 0 {
		return false, object.NoId
	}
	mut commitText = headText
	if twine.HasPrefix(headText, "ref: ") {
		let branch = headText[5:]
		commitText = ""
		let refs = change.NewRefs(r.Ws.Store)
		let cur = try refs.Get(branch)
		if cur != nil {
			commitText = change.TargetText(cur.Target)
		}
		for rc in plan {
			if rc.Name == branch {
				commitText = rc.After
			}
		}
	}
	if len(commitText) == 0 {
		return true, object.NoId
	}
	let t = try change.ParseTarget(commitText)
	let rev = match t {
		Commit(id) => id.Hex()
		Change(c) => c.Letters()
	}
	let id = try r.resolve(rev)
	let tree = try r.treeOf(id)
	return true, tree
}

// applyPlan makes an undo, redo or restore: the working directory's move is checked first, then the operation is
// written by run, then the files move.
fn applyPlan(r mut Repo, plan []oplog.RefChange, run fn() !i64) !i64 {
	let from = try headTree(mut r)
	let (moves, to) = try headTarget(mut r, plan)
	if moves && from != to {
		try checkMove(mut r, from, to)
	}
	let n = try run()
	if moves && from != to {
		mut fresh = try open(Global{Json: false, Trace: false, Dir: r.Ws.Root, Color: false})
		try moveTo(mut fresh, from, to, true)
	}
	return n
}

fn doUndo(g Global, op i64, yes bool, o mut Out) ! {
	mut r = try open(g)
	use lock = change.Lock(r.Ws.Store)
	let (rec, plan) = try oplog.UndoPlan(r.Ws.Store, r.Ws.Name, op)
	match rec.Op {
		Push(remote) => {
			// the server's branch goes back first, by the same compare-and-swap as any push; then the local copy
			if !yes {
				fail "operation {rec.Number} pushed to {remote}: undoing it puts the branch back there too; tit undo --yes to do so"
			}
			for rc in rec.Refs {
				try undoPush(mut r, remote, rc)
				o.Line("Put " + rc.Name[len("refs/remotes/" + remote + "/"):] + " back to " + short(rc.Before) + " on " + remote + ".")
			}
		}
		_ => {
		}
	}
	let store = r.Ws.Store
	let ws = r.Ws.Name
	_ = try applyPlan(mut r, plan, fn() !i64 {
		return try oplog.Undo(store, ws, rec.Number)
	})
	o.Line("Undid operation {rec.Number}: {rec.Command}.")
}

// undoPush moves the server's copy of a branch from what a push left (rc.After) back to what it held (rc.Before);
// the server refuses when another push moved it since.
fn undoPush(r mut Repo, remote str, rc oplog.RefChange) ! {
	let prefix = "refs/remotes/" + remote + "/"
	if !twine.HasPrefix(rc.Name, prefix) {
		return
	}
	let url = try remoteURL(r, remote)
	mut c = try client(r, url)
	_ = try c.Push(transport.PushRequest{Changes: []transport.ChangeUpdate{}, Refs: []transport.RefUpdate{transport.RefUpdate{Name: "refs/heads/" + rc.Name[len(prefix):], Old: rc.After, New: rc.Before}}}, "")
}

fn doRedo(g Global, o mut Out) ! {
	mut r = try open(g)
	use lock = change.Lock(r.Ws.Store)
	let (rec, plan) = try oplog.RedoPlan(r.Ws.Store, r.Ws.Name)
	let store = r.Ws.Store
	let ws = r.Ws.Name
	_ = try applyPlan(mut r, plan, fn() !i64 {
		return try oplog.Redo(store, ws)
	})
	o.Line("Redid operation {rec.Number}: {rec.Command}.")
}

type opJson struct {
	number    i64
	time      i64
	workspace str
	command   str
	undone    bool
}

fn opText(op oplog.Op) str {
	return match op {
		Init => "init"
		Adopt(d) => "adopt " + d
		Commit(c) => "commit " + c
		Amend(c) => "amend " + c
		Rebase(cs) => "rebase " + twine.Join(cs, " ")
		Merge(c) => "merge " + c
		Switch(b) => "switch " + b
		Branch(b) => "branch " + b
		Tag(t) => "tag " + t
		Fetch(rm) => "fetch " + rm
		Push(rm) => "push " + rm
		Undo(n) => "undo {n}"
		Redo(n) => "redo {n}"
		Restore(n) => "restore {n}"
		Absorb => "absorb"
		Split(c) => "split " + c
		Move(c) => "move " + c
		Rewrite(c) => "rewrite " + c
	}
}

fn short(text str) str {
	if len(text) == 0 {
		return "(none)"
	}
	if len(text) == 64 {
		return text[0:12]
	}
	return text
}

fn doOplog(g Global, a OplogArgs, o mut Out) ! {
	mut r = try open(g)
	let records = try oplog.List(r.Ws.Store)
	// which operations an undo reverses now
	mut undone = map[i64]bool{}
	for rec in records {
		match rec.Op {
			Undo(n) => {
				undone[n] = true
			}
			Redo(n) => {
				undone[n] = false
			}
			Init, Absorb => {
			}
			Adopt(_) => {
			}
			Commit(_) => {
			}
			Amend(_) => {
			}
			Rebase(_) => {
			}
			Merge(_) => {
			}
			Switch(_) => {
			}
			Branch(_) => {
			}
			Tag(_) => {
			}
			Fetch(_) => {
			}
			Push(_) => {
			}
			Restore(_) => {
			}
			Split(_) => {
			}
			Move(_) => {
			}
			Rewrite(_) => {
			}
		}
	}
	if a.Action == "list" {
		for i in 0..len(records) {
			let rec = records[len(records) - 1 - i]
			if g.Json {
				mut b = make([]u8, 0, 128)
				argo.Put(mut b, opJson{number: rec.Number, time: rec.Time, workspace: rec.Workspace, command: rec.Command, undone: undone[rec.Number]})
				o.Line(str(b))
				continue
			}
			mut mark = ""
			if undone[rec.Number] {
				mark = "  (undone)"
			}
			let when = tide.Format(rec.Time, tide.Local(), "2006-01-02 15:04")
			o.Line(paint(g, "33", "{rec.Number}") + "  " + when + "  " + rec.Workspace + "  " + rec.Command + mark)
		}
		return
	}
	mut found = -1
	for i in 0..len(records) {
		if records[i].Number == a.N {
			found = i
		}
	}
	if found < 0 {
		fail "there is no operation {a.N}"
	}
	let rec = records[found]
	if a.Action == "show" {
		o.Line("operation {rec.Number}: {rec.Command}")
		o.Line("  workspace " + rec.Workspace + ", " + tide.Format(rec.Time, tide.Local(), "2006-01-02 15:04:05 -0700"))
		o.Line("  " + opText(rec.Op))
		for rc in rec.Refs {
			o.Line("  " + rc.Name + ": " + short(rc.Before) + " -> " + short(rc.After))
		}
		if undone[rec.Number] {
			o.Line("  undone")
		}
		return
	}
	// restore
	use lock = change.Lock(r.Ws.Store)
	let later = try oplog.LaterElsewhere(r.Ws.Store, r.Ws.Name, a.N)
	if len(later) > 0 && !a.Yes {
		mut names = []str{}
		for l in later {
			names = append(names, "{l.Number} ({l.Command}, workspace {l.Workspace})")
		}
		fail "restoring to {a.N} also reverses later operations of other workspaces: " + twine.Join(names, ", ") + "; oplog restore --yes does it anyway"
	}
	let plan = try oplog.RestorePlan(r.Ws.Store, a.N)
	if len(plan) == 0 {
		o.Line("Everything is already as it was after operation {a.N}.")
		return
	}
	let store = r.Ws.Store
	let ws = r.Ws.Name
	let n = a.N
	_ = try applyPlan(mut r, plan, fn() !i64 {
		return try oplog.Restore(store, ws, n)
	})
	o.Line("Restored the refs to how they were after operation {a.N}.")
}

fn parseOp(s str) !i64 {
	let n = parseCount(s) catch _ {
		-1
	}
	if n <= 0 {
		fail fault.Wrap(ErrUsage, "{s} is not an operation number")
	}
	return n
}
