package cmd

import "../change"
import "../git"
import "../ignore"
import "../index"
import "../object"
import "../oplog"
import "argo"
import "fault"
import "flume"
import "quarry"
import "tty"
import "twine"

// tit adopt (#789): bring a git repository in. The first run starts a tit repository in the git working directory;
// every run converts what is new since the last (the git-ids table remembers), in batches that each end as a
// verified pack, then moves the refs in one oplog operation. Until the cutover, run it again after new git commits.

// adoptBudget is about how many bytes of objects one batch converts before it is written as a pack.
const adoptBudget = 8 * 1024 * 1024

type adoptJson struct {
	objects i64
	planned i64
	refs    i64
	head    str
}

fn doAdopt(g Global, path str, o mut Out) ! {
	mut base = g.Dir
	if len(base) == 0 {
		base = try quarry.Getwd()
	}
	mut gitPath = base
	if len(path) > 0 {
		gitPath = path
		if path[0] != '/' {
			gitPath = base + "/" + path
		}
	}
	let gr = try git.Open(gitPath)
	// the tit repository is the git working directory's; the first adopt starts it
	if !quarry.Exists(gitPath + "/.tit") {
		if !quarry.Exists(gitPath + "/.git") {
			fail fault.Wrap(ErrUsage, "adopt runs in a git working directory (or names one)")
		}
		mut quiet = Out{buf: []u8{}}
		try doInit(Global{Json: false, Trace: false, Dir: "", Color: false}, gitPath, mut quiet)
	}
	let at = Global{Json: g.Json, Trace: g.Trace, Dir: gitPath, Color: g.Color}
	mut r = try open(at)
	use lock = change.Lock(r.Ws.Store)
	let idsPath = r.Ws.Store + "/git-ids"
	mut ids = try git.ReadIds(idsPath)
	let before = ids.Len()
	let refs = try gr.Refs()
	mut tips = []str{}
	for ref in refs {
		tips = append(tips, ref.Id)
	}
	let order = try git.Plan(gr, ids, tips)
	let packs = r.Ws.Store + "/packs"
	let shown = tty.IsTerminal(2) && !g.Json
	mut i = 0
	for i < len(order) {
		let start = i
		let b = try arena {
			try git.ConvertBatch(gr, packs, ids, order, start, adoptBudget)
		}
		for k in 0..len(b.Git) {
			ids.Set(b.Git[k], b.Tit[k])
		}
		_ = try arena {
			try git.WriteIds(idsPath, ids)
			0
		}
		i = b.Next
		if shown {
			quarry.Eprint("\radopt: {i} of {len(order)} commits and tags")
		}
	}
	if shown && len(order) > 0 {
		quarry.Eprint("\n")
	}
	// the refs, in one operation: branches, tags and remote-tracking branches, as git has them
	let titRefs = change.NewRefs(r.Ws.Store)
	mut moves = []oplog.RefChange{}
	for ref in refs {
		if change.CheckName(ref.Name) != nil {
			quarry.Eprintln("tit: adopt: leaving out the ref {ref.Name}, whose name tit does not take")
			continue
		}
		let tid = try object.IdOf(ids.Tit(ref.Id))
		let after = change.TargetText(change.Target.Commit(tid))
		let cur = try titRefs.Get(ref.Name)
		mut was = ""
		if cur != nil {
			was = change.TargetText(cur.Target)
		}
		if was != after {
			moves = append(moves, oplog.RefChange{Name: ref.Name, Before: was, After: after})
		}
	}
	let (gitHead, _) = try gr.Head()
	let head = try change.ReadHead(r.Ws.State())
	mut headName = ""
	mut moveHead = false
	match head {
		Branch(name) => {
			headName = name
			let cur = try titRefs.Get(name)
			// a repository with no commit yet follows git's HEAD
			if cur == nil && len(gitHead) > 0 && gitHead != name {
				headName = gitHead
				moveHead = true
			}
		}
		Detached(_) => {
		}
	}
	mut idx = try r.readIndex()
	let converted = ids.Len() - before
	if len(moves) == 0 && !moveHead && len(idx.Entries) > 0 {
		// nothing to record: no operation
		if g.Json {
			mut b = make([]u8, 0, 128)
			argo.Put(mut b, adoptJson{objects: converted, planned: len(order), refs: 0, head: headName})
			o.Line(str(b))
		} else {
			o.Line("Nothing new in " + gr.GitDir + ".")
		}
		return
	}
	if moveHead {
		let hm = try headChange(r, change.Head.Branch(headName))
		moves = append(moves, hm)
	}
	use tx = oplog.Begin(r.Ws.Store, r.Ws.Name, "tit adopt " + gitPath, oplog.Op.Adopt(gr.GitDir), moves)
	try tx.Apply()
	// a workspace with an empty index starts from HEAD's tree: git checked those files out already
	if len(idx.Entries) == 0 {
		mut fresh = try open(at)
		let hc = try fresh.headCommit()
		if hc != nil {
			let tree = try fresh.treeOf(hc)
			mut built = try index.FromTree(mut fresh.Store, tree)
			mut rules = try ignore.Load(fresh.Ws.Root)
			// status hashes each file once and records its stat, so the next one reads none of them
			_ = try index.Status(mut fresh.Store, fresh.Ws.Root, tree, mut built, mut rules)
			try built.Write(fresh.Ws.IndexPath())
		}
	}
	try tx.Commit()
	try excludeFromGit(gr.CommonDir)
	if g.Json {
		mut b = make([]u8, 0, 128)
		argo.Put(mut b, adoptJson{objects: converted, planned: len(order), refs: len(moves), head: headName})
		o.Line(str(b))
		return
	}
	o.Line("Adopted " + count(converted, "object", "objects") + " (" + count(len(order), "commit or tag", "commits and tags") + ") from " + gr.GitDir + "; " + count(len(moves), "ref", "refs") + " moved.")
	if len(headName) > 0 {
		o.Line("HEAD is " + shortBranch(headName) + ".")
	}
}

// excludeFromGit adds .tit/ to git's info/exclude, so git status leaves tit's directory alone.
fn excludeFromGit(common str) ! {
	let path = common + "/info/exclude"
	mut text = ""
	if quarry.Exists(path) {
		text = try flume.ReadFile(path)
	}
	for line in twine.Split(text, "\n") {
		if twine.TrimSpace(line) == ".tit/" || twine.TrimSpace(line) == ".tit" || twine.TrimSpace(line) == "/.tit/" {
			return
		}
	}
	try quarry.MkdirAll(common + "/info")
	if len(text) > 0 && text[len(text) - 1] != '\n' {
		text = text + "\n"
	}
	try quarry.WriteFile(path, text + ".tit/\n")
}

fn count(n i64, one str, many str) str {
	if n == 1 {
		return "1 " + one
	}
	return "{n} " + many
}
