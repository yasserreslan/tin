package cmd

import "argo"
import "fault"
import "flume"
import "quarry"
import "spawn"
import "twine"

// tit bench (#802): benchmark results kept with the change they measured and the machine that measured them, in
// .tit/bench/<name>.jsonl. A result follows its change id, so it survives amends, rebases and rewrites. Results from
// macOS are development numbers (toolchain/docs/PERFORMANCE.md): they are never compared with Linux ones, and two
// machines are never compared at all.

// BenchArgs are tit bench's arguments.
type BenchArgs struct {
	Action str
	Name   str
	Value  str
	Unit   str
	A      str
	B      str
}

// Machine is where a result was measured.
type Machine struct {
	Os     str
	Arch   str
	Cpu    str
	Kernel str
	Cores  str
}

// Result is one recorded result.
type Result struct {
	Change  str
	Commit  str
	Value   str
	Unit    str
	Time    i64
	Machine Machine
}

fn run1(argv []str) str {
	let r = spawn.Run(spawn.Cmd{Argv: argv, Env: spawn.Env.Inherit, Dir: "", Stdin: spawn.Stdio.Null, Stdout: spawn.Stdio.Pipe, Stderr: spawn.Stdio.Null, MaxOutput: 0, Input: ""}) catch _ {
		return ""
	}
	return twine.TrimSpace(r.Stdout)
}

fn thisMachine() Machine {
	let os = run1([]str{"uname", "-s"})
	mut cpu = ""
	if os == "Darwin" {
		cpu = run1([]str{"sysctl", "-n", "machdep.cpu.brand_string"})
	} else {
		let info = quarry.ReadFile("/proc/cpuinfo") catch _ {
			""
		}
		for line in twine.Split(info, "\n") {
			if (twine.HasPrefix(line, "model name") || twine.HasPrefix(line, "Model")) && len(cpu) == 0 {
				let colon = twine.IndexByte(line, ':')
				if colon > 0 {
					cpu = twine.TrimSpace(line[colon + 1:])
				}
			}
		}
	}
	return Machine{Os: os, Arch: run1([]str{"uname", "-m"}), Cpu: cpu, Kernel: run1([]str{"uname", "-r"}), Cores: run1([]str{"getconf", "_NPROCESSORS_ONLN"})}
}

fn benchName(n str) ! {
	if len(n) == 0 || twine.ContainsAny(n, "/\\ \t\n.") {
		fail fault.Wrap(ErrUsage, "{n} cannot name a benchmark (no slashes, dots or spaces)")
	}
}

fn readResults(path str) ![]Result {
	mut out = []Result{}
	if !quarry.Exists(path) {
		return out
	}
	let text = try flume.ReadFile(path)
	for line in twine.Split(text, "\n") {
		if len(line) == 0 {
			continue
		}
		mut r = Result{Change: "", Commit: "", Value: "", Unit: "", Time: 0, Machine: Machine{Os: "", Arch: "", Cpu: "", Kernel: "", Cores: ""}}
		try argo.Get(line, mut r)
		out = append(out, r)
	}
	return out
}

fn machineText(m Machine) str {
	return m.Os + " " + m.Arch + ", " + m.Cpu + ", " + m.Cores + " cores, kernel " + m.Kernel
}

fn sameMachine(a Machine, b Machine) bool {
	return a.Os == b.Os && a.Arch == b.Arch && a.Cpu == b.Cpu && a.Cores == b.Cores && a.Kernel == b.Kernel
}

fn parseValue(s str) !f64 {
	let v = mintParseF(s) catch _ {
		fail fault.Wrap(ErrUsage, "{s} is not a number")
	}
	return v
}

fn mintParseF(s str) !f64 {
	mut whole = 0.0
	mut frac = 0.0
	mut scale = 1.0
	mut seen = false
	mut dot = false
	mut neg = false
	for i in 0..len(s) {
		let c = s[i]
		if i == 0 && c == '-' {
			neg = true
		} else if c == '.' && !dot {
			dot = true
		} else if c >= '0' && c <= '9' {
			seen = true
			if dot {
				scale = scale / 10.0
				frac = frac + f64(i64(c - '0')) * scale
			} else {
				whole = whole * 10.0 + f64(i64(c - '0'))
			}
		} else {
			fail ErrUsage
		}
	}
	if !seen {
		fail ErrUsage
	}
	if neg {
		return -(whole + frac)
	}
	return whole + frac
}

fn doBench(g Global, a BenchArgs, o mut Out) ! {
	mut r = try open(g)
	try benchName(a.Name)
	let dir = r.Ws.Store + "/bench"
	let path = dir + "/" + a.Name + ".jsonl"
	if a.Action == "record" {
		_ = try parseValue(a.Value)
		let head = try r.resolve("HEAD")
		let c = try commitData(mut r, head)
		let res = Result{Change: c.Change.Letters(), Commit: head.Hex(), Value: a.Value, Unit: a.Unit, Time: now() / 1000000000, Machine: thisMachine()}
		mut b = make([]u8, 0, 256)
		argo.Put(mut b, res)
		try quarry.MkdirAll(dir)
		mut text = ""
		if quarry.Exists(path) {
			text = try flume.ReadFile(path)
		}
		try quarry.WriteFile(path, text + str(b) + "\n")
		mut note = ""
		if res.Machine.Os == "Darwin" {
			note = " (macOS: a development number, never compared with Linux)"
		}
		o.Line("Recorded " + a.Name + " = " + a.Value + " " + a.Unit + " for " + res.Change[0:12] + note + ".")
		return
	}
	let results = try readResults(path)
	if a.Action == "log" {
		for res in results {
			o.Line(res.Change[0:12] + " " + res.Commit[0:12] + "  " + res.Value + " " + res.Unit + "  " + machineText(res.Machine))
		}
		return
	}
	// compare: the newest result of each revision's change, from one machine
	let ca = try r.resolve(a.A)
	let cb = try r.resolve(a.B)
	let da = try commitData(mut r, ca)
	let db = try commitData(mut r, cb)
	mut ra = -1
	mut rb = -1
	for i in 0..len(results) {
		if results[i].Change == da.Change.Letters() {
			ra = i
		}
		if results[i].Change == db.Change.Letters() {
			rb = i
		}
	}
	if ra < 0 || rb < 0 {
		fail "no {a.Name} result for " + a.A + " or " + a.B
	}
	let x = results[ra]
	let y = results[rb]
	if (x.Machine.Os == "Darwin") != (y.Machine.Os == "Darwin") {
		fail "one result is from macOS and one from Linux: macOS numbers are for development only and are never compared with Linux (toolchain/docs/PERFORMANCE.md)"
	}
	if !sameMachine(x.Machine, y.Machine) {
		fail "the results come from two machines (" + machineText(x.Machine) + "; " + machineText(y.Machine) + "): only one machine's results compare"
	}
	let vx = try parseValue(x.Value)
	let vy = try parseValue(y.Value)
	mut ratio = "-"
	if vx != 0.0 {
		ratio = "{vy / vx}"
	}
	o.Line(a.Name + ": " + x.Value + " -> " + y.Value + " " + y.Unit + ", ratio " + ratio + " (" + machineText(x.Machine) + ")")
}
