package cmd

import "../change"
import "../identity"
import "../object"
import "../oplog"
import "../packfile"
import "../revwalk"
import "../store"
import "../transport"
import "fault"
import "flume"
import "quarry"
import "seal"
import "sift"
import "twine"

// Sharing (#795, #796): remote, clone, fetch, pull, push and serve, over the tit protocol (design section 15).

// ShareArgs are the arguments of clone, fetch, pull and push: a remote or URL, a branch, a directory.
type ShareArgs struct {
	Remote str
	Branch str
	Dir    str
	// Lease lets push replace the server's branch with history that does not contain it (a rebased stack), when the
	// server's branch is still what this repository last fetched of it
	Lease bool
	// Lazy (clone --lazy) takes the history without file contents, which come on first read (#803)
	Lazy bool
}

// ServeArgs are tit serve's arguments.
type ServeArgs struct {
	Addr   str
	Public bool
	Allow  str
}

fn remoteURL(r Repo, name str) !str {
	if twine.Contains(name, "://") {
		return name
	}
	let cfg = try r.config()
	let url = cfg.Get("remote." + name + ".url")
	if url == nil {
		fail fault.Wrap(ErrUsage, "there is no remote {name} (tit remote add {name} <url>)")
	}
	return url
}

// client is a connection to url, signing as the user when they have a key.
fn client(r Repo, url str) !transport.Http {
	let cfg = try r.config()
	let email = cfg.Get("user.email")
	let keyPath = identity.DefaultKeyPath(cfg)
	if email == nil || !quarry.Exists(keyPath) {
		return transport.NewHttp(url, "", fn(payload str) ![]u8 {
			fail fault.Wrap(identity.ErrNoIdentity, "no key to sign with")
		})
	}
	let signer = try identity.LoadKey(keyPath)
	return transport.NewHttp(url, email, fn(payload str) ![]u8 {
		return try signer.Sign(payload)
	})
}

// storePack keeps the objects of a pack this repository lacks, as a pack of its own; it gives how many.
fn storePack(r mut Repo, data str) !i64 {
	if len(data) == 0 {
		return 0
	}
	// the pack is kept as it came, with an index built for it (packfile.Keep): nothing is unpacked into memory or
	// packed again, so a clone of a long history takes the memory of the pack
	let p = try packfile.Keep(data, r.Ws.Store + "/packs", transport.MaxObject)
	return p.Count
}

// storeFile keeps the pack a fetch wrote to path (none when it sent nothing) as it is, indexed where it lies; it gives
// how many objects it holds.
fn storeFile(r mut Repo, path str) !i64 {
	if !quarry.Exists(path) {
		return 0
	}
	let p = packfile.KeepFile(path, r.Ws.Store + "/packs", transport.MaxObject) catch e {
		quarry.Remove(path) catch _ {
		}
		fail e
	}
	return p.Count
}

fn localTips(r Repo) ![]str {
	let refs = change.NewRefs(r.Ws.Store)
	let all = try refs.List("refs/")
	mut out = []str{}
	for ref in all {
		match ref.Target {
			Commit(id) => {
				out = append(out, id.Hex())
			}
			Change(_) => {
			}
		}
	}
	return out
}

// fetchFrom brings what remote has that this repository lacks, and moves refs/remotes/<remote>/* (and new tags) to
// the server's values, in one operation. It gives the server's heads and the number of objects fetched.
fn fetchFrom(r mut Repo, remote str, url str, remoteName str) !(transport.Heads, i64) {
	mut c = try client(r, url)
	let heads = try c.Heads()
	mut wants = []str{}
	for ref in heads.Refs {
		if twine.HasPrefix(ref.Target, "change ") {
			continue
		}
		let id = object.ParseId(ref.Target) catch _ {
			continue
		}
		if !r.Store.Has(id) {
			wants = append(wants, ref.Target)
		}
	}
	for ch in heads.Changes {
		let id = object.ParseId(ch.Commit) catch _ {
			continue
		}
		if !r.Store.Has(id) {
			wants = append(wants, ch.Commit)
		}
	}
	mut got = 0
	if len(wants) > 0 {
		let haves = try localTips(r)
		let cfg = try r.config()
		let lazyRemote = cfg.Get("lazy.remote")
		let lazy = lazyRemote != nil && lazyRemote == remote
		// the pack streams to a file and is indexed where it lies (#1009): a clone takes the memory of its buffers
		try quarry.MkdirAll(r.Ws.Store + "/packs")
		let tmp = r.Ws.Store + "/packs/tmp-fetch-" + seal.Hex(seal.RandomBytes(8)) + ".pack"
		_ = c.FetchTo(transport.FetchRequest{Wants: wants, Haves: haves, NoBlobs: lazy, Objects: []str{}}, tmp) catch e {
			if quarry.Exists(tmp) {
				quarry.Remove(tmp) catch _ {
				}
			}
			fail e
		}
		got = try storeFile(mut r, tmp)
	}
	// the refs: branches under refs/remotes/<name>/, tags as they are when this repository has none of that name
	let refs = change.NewRefs(r.Ws.Store)
	mut moves = []oplog.RefChange{}
	for ref in heads.Refs {
		mut local = ""
		if twine.HasPrefix(ref.Name, "refs/heads/") {
			local = "refs/remotes/" + remoteName + "/" + ref.Name[11:]
		} else if twine.HasPrefix(ref.Name, "refs/tags/") {
			let have = try refs.Get(ref.Name)
			if have != nil {
				continue
			}
			local = ref.Name
		} else {
			continue
		}
		let cur = try refs.Get(local)
		mut was = ""
		if cur != nil {
			was = change.TargetText(cur.Target)
		}
		if was != ref.Target {
			moves = append(moves, oplog.RefChange{Name: local, Before: was, After: ref.Target})
		}
	}
	if len(moves) > 0 {
		try recordRefs(r, "tit fetch " + remote, oplog.Op.Fetch(remote), moves)
	}
	return heads, got
}

fn doRemote(g Global, args []str, o mut Out) ! {
	let r = try open(g)
	if len(args) == 0 {
		let cfg = try r.config()
		mut names = []str{}
		for k in cfg.Keys() {
			if twine.HasPrefix(k, "remote.") && twine.HasSuffix(k, ".url") {
				names = append(names, k)
			}
		}
		sift.Sort(mut names)
		for k in names {
			let url = cfg.Get(k)
			if url != nil && g.Json {
				o.Line(jsonObject([]str{"name", jsonStr(k[7:len(k) - 4]), "url", jsonStr(url)}))
			} else if url != nil {
				o.Line(k[7:len(k) - 4] + "\t" + url)
			}
		}
		return
	}
	if args[0] == "add" && len(args) == 3 {
		try identity.Set(r.Ws.Store + "/config", "remote." + args[1] + ".url", args[2])
		return
	}
	fail fault.Wrap(ErrUsage, "remote | remote add <name> <url>")
}

fn doFetch(g Global, a ShareArgs, o mut Out) ! {
	mut r = try open(g)
	use lock = change.Lock(r.Ws.Store)
	let url = try remoteURL(r, a.Remote)
	let (_, got) = try fetchFrom(mut r, a.Remote, url, a.Remote)
	o.Line("Fetched {got} objects from " + a.Remote + ".")
}

fn doClone(g Global, a ShareArgs, o mut Out) ! {
	mut dir = a.Dir
	if len(dir) == 0 {
		mut name = a.Remote
		for twine.HasSuffix(name, "/") {
			name = name[0:len(name) - 1]
		}
		let slash = twine.LastIndex(name, "/")
		dir = name[slash + 1:]
		if twine.HasSuffix(dir, ".tit") {
			dir = dir[0:len(dir) - 4]
		}
	}
	if len(g.Dir) > 0 && dir[0] != '/' {
		dir = g.Dir + "/" + dir
	}
	if quarry.Exists(dir) {
		let left = try quarry.ReadDir(dir)
		if len(left) > 0 {
			fail "{dir} exists and is not empty"
		}
	}
	try quarry.MkdirAll(dir)
	mut quiet = Out{buf: []u8{}}
	try doInit(Global{Json: false, Trace: false, Dir: "", Color: false}, dir, mut quiet)
	try identity.Set(dir + "/.tit/config", "remote.origin.url", a.Remote)
	if a.Lazy {
		try identity.Set(dir + "/.tit/config", "lazy.remote", "origin")
	}
	let at = Global{Json: g.Json, Trace: g.Trace, Dir: dir, Color: g.Color}
	mut r = try open(at)
	use lock = change.Lock(r.Ws.Store)
	let (heads, got) = try fetchFrom(mut r, "origin", a.Remote, "origin")
	// the branch to check out: main, or the first there is
	mut branch = ""
	mut target = ""
	for ref in heads.Refs {
		if !twine.HasPrefix(ref.Name, "refs/heads/") || twine.HasPrefix(ref.Target, "change ") {
			continue
		}
		if len(branch) == 0 || ref.Name == "refs/heads/main" {
			branch = ref.Name
			target = ref.Target
		}
	}
	if len(branch) == 0 {
		o.Line("Cloned an empty repository into " + dir + ".")
		return
	}
	let headMove = try headChange(r, change.Head.Branch(branch))
	try recordRefs(r, "tit clone", oplog.Op.Branch(shortBranch(branch)), []oplog.RefChange{oplog.RefChange{Name: branch, Before: "", After: target}, headMove})
	mut fresh = try open(at)
	let id = try object.ParseId(target)
	let tree = try fresh.treeOf(id)
	try moveTo(mut fresh, object.NoId, tree, true)
	mut lazyNote = ""
	if a.Lazy {
		lazyNote = ", file contents as they are read"
	}
	o.Line("Cloned " + a.Remote + " into " + dir + " ({got} objects{lazyNote}); on " + shortBranch(branch) + ".")
}

// sendObjects is what tip reaches that none of the commits in hide (and their trees) has.
fn sendObjects(r mut Repo, tip object.Id, hide []object.Id) ![]object.Id {
	let commits = try revwalk.Walk(mut r.Store, []object.Id{tip}, hide, revwalk.Order.Topo, 0)
	mut skip = map[str]bool{}
	for h in hide {
		let t = try r.treeOf(h)
		try treeSet(mut r, t, mut skip)
	}
	mut out = []object.Id{}
	mut seen = map[str]bool{}
	for c in commits {
		out = append(out, c)
		let t = try r.treeOf(c)
		try treeWalk(mut r, t, skip, mut seen, mut out)
	}
	return out
}

fn treeSet(r mut Repo, tree object.Id, out mut map[str]bool) ! {
	let (_, done) = out[tree.Bytes()]
	if done {
		return
	}
	out[tree.Bytes()] = true
	let o = try r.Store.Get(tree)
	match o {
		Tree(es) => {
			for e in es {
				if e.Mode == object.Mode.Dir {
					try treeSet(mut r, e.Id, mut out)
				} else {
					out[e.Id.Bytes()] = true
				}
			}
		}
		Commit(_) => {
		}
		Tag(_) => {
		}
		Blob(_) => {
		}
	}
}

fn treeWalk(r mut Repo, tree object.Id, skip map[str]bool, seen mut map[str]bool, out mut []object.Id) ! {
	let (_, a) = seen[tree.Bytes()]
	let (_, b) = skip[tree.Bytes()]
	if a || b {
		return
	}
	seen[tree.Bytes()] = true
	out = append(out, tree)
	let o = try r.Store.Get(tree)
	match o {
		Tree(es) => {
			for e in es {
				if e.Mode == object.Mode.Dir {
					try treeWalk(mut r, e.Id, skip, mut seen, mut out)
				} else {
					let (_, x) = seen[e.Id.Bytes()]
					let (_, y) = skip[e.Id.Bytes()]
					if !x && !y {
						seen[e.Id.Bytes()] = true
						out = append(out, e.Id)
					}
				}
			}
		}
		Commit(_) => {
		}
		Tag(_) => {
		}
		Blob(_) => {
		}
	}
}

fn doPush(g Global, a ShareArgs, o mut Out) ! {
	mut r = try open(g)
	use lock = change.Lock(r.Ws.Store)
	let url = try remoteURL(r, a.Remote)
	mut branch = a.Branch
	if len(branch) == 0 {
		branch = try currentBranch(r)
		if len(branch) == 0 {
			fail "HEAD is detached: push names a branch"
		}
	} else if !twine.HasPrefix(branch, "refs/") {
		branch = "refs/heads/" + branch
	}
	let tip = try r.resolve(branch)
	mut c = try client(r, url)
	let heads = try c.Heads()
	mut old = ""
	for ref in heads.Refs {
		if ref.Name == branch {
			old = ref.Target
		}
	}
	mut hide = []object.Id{}
	if len(old) > 0 {
		let remoteTip = object.ParseId(old) catch _ {
			fail "the server's {shortBranch(branch)} follows a change; tit push does not move it yet"
			object.NoId
		}
		if remoteTip == tip {
			o.Line("Everything is pushed: " + shortBranch(branch) + " is " + tip.Hex()[0:12] + " there too.")
			return
		}
		if !r.Store.Has(remoteTip) {
			fail "the server's {shortBranch(branch)} has commits this repository lacks: tit pull first"
		}
		let ff = try revwalk.IsAncestor(mut r.Store, remoteTip, tip)
		mut leased = false
		if !ff && a.Lease {
			let tracking = try change.NewRefs(r.Ws.Store).Get("refs/remotes/" + a.Remote + "/" + shortBranch(branch))
			leased = tracking != nil && change.TargetText(tracking.Target) == old
		}
		if !ff && !leased {
			fail "the server's {shortBranch(branch)} has moved on from yours: tit pull, then push again"
		}
		hide = append(hide, remoteTip)
	}
	// what the server has already, as far as this repository knows: its other tips
	for ref in heads.Refs {
		let id = object.ParseId(ref.Target) catch _ {
			continue
		}
		if ref.Name != branch && r.Store.Has(id) {
			// an annotated tag counts as the commit it tags
			let cid = r.resolve(id.Hex()) catch _ {
				continue
			}
			hide = append(hide, cid)
		}
	}
	let ids = try sendObjects(mut r, tip, hide)
	let tmp = r.Ws.Store + "/tmp-push-" + seal.Hex(seal.RandomBytes(8))
	let p = try packfile.Write(mut r.Store, ids, tmp)
	// the pack streams from its file (#1009)
	let pushed = try readPushed(r, a.Remote)
	let versions = try stackVersions(mut r, branch, tip, heads, pushed)
	let (_, perr) = c.PushFile(transport.PushRequest{Changes: versions, Refs: []transport.RefUpdate{transport.RefUpdate{Name: branch, Old: old, New: tip.Hex()}}}, p.Path)
	try quarry.RemoveAll(tmp)
	if perr != nil {
		fail perr
	}
	try writePushed(r, a.Remote, pushed, versions)
	// this repository's copy of the server's branch
	let tracking = "refs/remotes/" + a.Remote + "/" + shortBranch(branch)
	if !twine.Contains(a.Remote, "://") {
		let refs = change.NewRefs(r.Ws.Store)
		let cur = try refs.Get(tracking)
		mut was = ""
		if cur != nil {
			was = change.TargetText(cur.Target)
		}
		if was != tip.Hex() {
			try recordRefs(r, "tit push " + a.Remote, oplog.Op.Push(a.Remote), []oplog.RefChange{oplog.RefChange{Name: tracking, Before: was, After: tip.Hex()}})
		}
	}
	o.Line("Pushed " + shortBranch(branch) + " to " + a.Remote + " ({len(ids)} objects).")
}

// fetchLocked is fetch under the repository lock, released when it returns (use defers to the function's end).
fn fetchLocked(g Global, remote str) ! {
	mut r = try open(g)
	use lock = change.Lock(r.Ws.Store)
	let url = try remoteURL(r, remote)
	let (_, _) = try fetchFrom(mut r, remote, url, remote)
}

fn doPull(g Global, a ShareArgs, o mut Out) ! {
	try fetchLocked(g, a.Remote)
	let r2 = try open(g)
	let current = try currentBranch(r2)
	if len(current) == 0 {
		fail "HEAD is detached: switch to a branch to pull into"
	}
	try doMerge(g, MergeArgs{Rev: a.Remote + "/" + shortBranch(current), Abort: false, Message: ""}, mut o)
}

fn doServe(g Global, a ServeArgs, o mut Out) ! {
	let r = try open(g)
	mut allowPath = a.Allow
	if len(allowPath) == 0 {
		allowPath = r.Ws.Store + "/allowed-keys"
	}
	let keys = try transport.AllowedKeys(allowPath)
	quarry.Eprintln("tit: serving " + r.Ws.Root + " on http://" + a.Addr + "/ ({len(keys)} keys allowed; " + allowPath + " lists them)")
	transport.Serve(a.Addr, r.Ws.Store, allowPath, a.Public) catch e {
		fail e
	}
	// stopped (SIGTERM, SIGINT): core 0's requests reset the pool main's values live in (#1056), so nothing made before
	// serving may be read now; end here (#1055)
	quarry.Exit(0)
}

// doSync is tit sync (#797): fetch, rebase the stack onto the remote's trunk (moving the local trunk with it), and push
// the branch, in that order; the rebase is one operation, and the push replaces the server's branch only if it is
// still what the fetch saw.
fn doSync(g Global, a ShareArgs, o mut Out) ! {
	try fetchLocked(g, a.Remote)
	let rebased = try syncRebase(g, a)
	try syncPush(g, a, rebased, mut o)
}

// syncRebase rebases the stack onto the remote's trunk under the repository lock, and gives how many changes moved.
fn syncRebase(g Global, a ShareArgs) !i64 {
	mut r = try open(g)
	use lock = change.Lock(r.Ws.Store)
	mut rebased = 0
	let st = try stackOf(mut r)
	let trunk = try trunkOf(r)
	let refs = change.NewRefs(r.Ws.Store)
	let remoteTrunk = try refs.Get("refs/remotes/" + a.Remote + "/" + trunk)
	if remoteTrunk != nil {
		let upstream = try r.resolve("refs/remotes/" + a.Remote + "/" + trunk)
		let localTrunk = try r.resolve(trunk)
		// the stack's base: the parent of its first change (the trunk itself when there is none)
		mut base = localTrunk
		if len(st.Commits) > 0 {
			let first = try commitData(mut r, st.Commits[0])
			if len(first.Parents) > 0 {
				base = first.Parents[0]
			}
		}
		if upstream != localTrunk || base != upstream {
			mut extra = []oplog.RefChange{}
			if upstream != localTrunk {
				let behind = try revwalk.IsAncestor(mut r.Store, localTrunk, upstream)
				if !behind {
					fail "{trunk} has commits {a.Remote}/{trunk} lacks: push or reconcile {trunk} first"
				}
				extra = append(extra, oplog.RefChange{Name: "refs/heads/" + trunk, Before: commitText(localTrunk), After: commitText(upstream)})
			}
			if len(st.Commits) == 0 {
				// nothing of ours above the trunk: the branch follows the trunk
				if st.Branch != "refs/heads/" + trunk {
					extra = append(extra, oplog.RefChange{Name: st.Branch, Before: commitText(localTrunk), After: commitText(upstream)})
				}
				let from = try r.treeOf(localTrunk)
				let to = try r.treeOf(upstream)
				try checkMove(mut r, from, to)
				try recordRefs(r, "tit sync", oplog.Op.Rebase([]str{}), extra)
				mut fresh = try open(g)
				try moveTo(mut fresh, from, to, true)
			} else {
				let tip = st.Commits[len(st.Commits) - 1]
				mut versions = []Version{}
				let fresh = try replay(mut r, st.Commits, upstream, mut versions)
				let names = try changeNames(mut r, fresh)
				try restack(mut r, "tit sync", oplog.Op.Rebase(names), st.Branch, tip, fresh[len(fresh) - 1], versions, extra, true)
				rebased = len(fresh)
			}
		}
	}
	return rebased
}

fn syncPush(g Global, a ShareArgs, rebased i64, o mut Out) ! {
	// nothing that records a conflict goes to the server
	mut r2 = try open(g)
	let trunk = try trunkOf(r2)
	let st2 = try stackOf(mut r2)
	for id in st2.Commits {
		let c = try commitData(mut r2, id)
		if len(c.Conflicts) > 0 {
			fail "{c.Change.Letters()[0:12]} records conflicts after the rebase: tit edit it, resolve, tit commit --amend, then tit sync"
		}
	}
	if st2.Branch == "refs/heads/" + trunk && len(st2.Commits) == 0 {
		o.Line("Synced: {trunk} is {a.Remote}'s.")
		return
	}
	mut pushOut = Out{buf: []u8{}}
	try doPush(g, ShareArgs{Remote: a.Remote, Branch: shortBranch(st2.Branch), Dir: "", Lease: true, Lazy: false}, mut pushOut)
	o.Line("Synced: rebased " + count(rebased, "change", "changes") + " onto {a.Remote}/{trunk}; " + twine.TrimSpace(str(pushOut.buf)))
}

// pushedFile keeps, per remote, the version of each change this repository pushed last: "<letters> <commit>" lines.
fn pushedFile(r Repo, remote str) str {
	mut name = []u8{}
	for i in 0..len(remote) {
		let b = remote[i]
		if (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9') || b == '-' || b == '.' {
			name = append(name, b)
		} else {
			name = append(name, '_')
		}
	}
	return r.Ws.Store + "/pushed/" + str(name)
}

fn readPushed(r Repo, remote str) !map[str]str {
	mut out = map[str]str{}
	let path = pushedFile(r, remote)
	if !quarry.Exists(path) {
		return out
	}
	let text = try quarry.ReadFile(path)
	for line in twine.Split(text, "\n") {
		let (k, v, ok) = twine.Cut(line, " ")
		if ok && len(k) > 0 && len(v) > 0 {
			out[k] = v
		}
	}
	return out
}

// writePushed records the versions a push sent, keeping the newest 4096 changes.
fn writePushed(r Repo, remote str, before map[str]str, sent []transport.ChangeUpdate) ! {
	if len(sent) == 0 {
		return
	}
	mut all = map[str]str{}
	for k, v in before {
		all[k] = v
	}
	for cu in sent {
		delete(all, cu.Change)
		all[cu.Change] = cu.Commit
	}
	mut lines = []str{}
	for k, v in all {
		lines = append(lines, k + " " + v)
	}
	if len(lines) > 4096 {
		lines = lines[len(lines) - 4096:]
	}
	try quarry.MkdirAll(r.Ws.Store + "/pushed")
	try quarry.WriteFile(pushedFile(r, remote), twine.Join(lines, "\n") + "\n")
}

// stackVersions are the change versions a push of branch sends (design/tit.md §15): the changes of the branch above
// the trunk (stack.trunk, main), oldest first, each with the server's newest version of it as the one it replaces.
// A host reviews them (tinhub opens a review per change). Pushing the trunk itself sends none, and so does a
// repository with no trunk, or a change the server already has at this commit.
fn stackVersions(r mut Repo, branch str, tip object.Id, heads transport.Heads, pushed map[str]str) ![]transport.ChangeUpdate {
	mut out = []transport.ChangeUpdate{}
	let trunk = try trunkOf(r)
	if branch == "refs/heads/" + trunk || !twine.HasPrefix(branch, "refs/heads/") {
		return out
	}
	mut hide = []object.Id{}
	let local = r.resolve("refs/heads/" + trunk) catch _ {
		object.NoId
	}
	if local != object.NoId {
		hide = append(hide, local)
	}
	for ref in heads.Refs {
		if ref.Name != "refs/heads/" + trunk {
			continue
		}
		let id = object.ParseId(ref.Target) catch _ {
			continue
		}
		if r.Store.Has(id) {
			hide = append(hide, id)
		}
	}
	if len(hide) == 0 {
		return out
	}
	let line = try revwalk.Walk(mut r.Store, []object.Id{tip}, hide, revwalk.Order.FirstParent, 0)
	// the heads name only the changes a ref follows; for the others, the version this repository pushed last
	mut server = map[str]str{}
	for k, v in pushed {
		server[k] = v
	}
	for ch in heads.Changes {
		server[ch.Change] = ch.Commit
	}
	for i in 0..len(line) {
		let id = line[len(line) - 1 - i]
		let cd = try commitData(mut r, id)
		let letters = cd.Change.Letters()
		if len(letters) == 0 {
			continue
		}
		let was = server[letters]
		if was == id.Hex() {
			continue
		}
		out = append(out, transport.ChangeUpdate{Change: letters, Replaces: was, Commit: id.Hex()})
	}
	return out
}
