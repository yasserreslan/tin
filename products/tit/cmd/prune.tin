package cmd

import "../change"
import "../object"
import "../prune"
import "fault"
import "mint"
import "tide"

// tit prune and tit purge (#1010): removing what nothing reaches, and objects named for removal at once.

// PruneArgs is tit prune's: how long the oplog and loose files protect what they name (ns), and whether to only say.
type PruneArgs struct {
	Retention i64
	Dry       bool
}

// PurgeArgs is tit purge's: the objects (hex ids) and why.
type PurgeArgs struct {
	Ids    []str
	Reason str
}

// parseDuration reads "30d", "12h", "45m", "90s" or "0" as nanoseconds.
fn parseDuration(s str) !i64 {
	if s == "0" {
		return 0
	}
	if len(s) < 2 {
		fail fault.Wrap(ErrUsage, "a duration like 30d, 12h or 45m, not {s}")
	}
	let n = mint.Atoi(s[0:len(s) - 1]) catch _ {
		fail fault.Wrap(ErrUsage, "a duration like 30d, 12h or 45m, not {s}")
	}
	let unit = match s[len(s) - 1] {
		'd' => 24 * 3600 * 1000000000
		'h' => 3600 * 1000000000
		'm' => 60 * 1000000000
		's' => 1000000000
		_ => 0
	}
	if unit == 0 || n < 0 {
		fail fault.Wrap(ErrUsage, "a duration like 30d, 12h or 45m, not {s}")
	}
	return n * unit
}

fn doPrune(g Global, a PruneArgs, o mut Out) ! {
	let r = try open(g)
	use lock = change.Lock(r.Ws.Store)
	let res = try prune.Prune(r.Ws.Store, a.Retention, tide.Wall(), a.Dry)
	mut verb = "Removed"
	if a.Dry {
		verb = "Would remove"
	}
	o.Line("{verb} {res.Objects} packed and {res.Loose} loose objects and {res.Chunks} chunks; {res.Reachable} objects are reachable ({res.Packs} packs retired).")
}

fn doPurge(g Global, a PurgeArgs, o mut Out) ! {
	let r = try open(g)
	mut ids = []object.Id{}
	for h in a.Ids {
		let id = object.ParseId(h) catch _ {
			fail fault.Wrap(ErrUsage, "purge: {h} is not a full object id (64 hex digits)")
		}
		ids = append(ids, id)
	}
	use lock = change.Lock(r.Ws.Store)
	let res = try prune.Purge(r.Ws.Store, ids, a.Reason, tide.Wall())
	o.Line("Purged {len(ids)} objects: {res.Objects} pack entries, {res.Loose} loose files and {res.Chunks} chunks ({res.Packs} packs rewritten); recorded in .tit/purged.")
}
