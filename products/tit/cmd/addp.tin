package cmd

import "../change"
import "../diff"
import "../index"
import "../object"
import "../store"
import "fault"
import "quarry"
import "spawn"
import "twine"

// tit add -p (#790): stage changes hunk by hunk. Each hunk of a tracked file that differs from the index is shown
// with three lines of context and a question, answered by a line on standard input (a terminal or a pipe): y stages
// it, n leaves it, a stages it and the rest of the file, d leaves the rest of the file, q stops asking. The index
// gets each file's staged lines with no stat, so status compares the file's content again.

// answer reads one line of standard input: a child shell's read takes exactly one line, from a pipe as from a
// terminal, and leaves the rest for the next question. "" at the end of the input.
fn answer() str {
	let r = spawn.Run(spawn.Cmd{Argv: []str{"/bin/sh", "-c", "IFS= read -r a && printf '%s' \"$a\""}, Env: spawn.Env.Inherit, Dir: "", Stdin: spawn.Stdio.Inherit, Stdout: spawn.Stdio.Pipe, Stderr: spawn.Stdio.Null, MaxOutput: 4096, Input: ""}) catch _ {
		return ""
	}
	if r.Code != 0 {
		return ""
	}
	return twine.TrimSpace(r.Stdout)
}

// hunkText is a hunk with its context, as diff -U3 shows it.
fn hunkText(a []str, b []str, h hunk) str {
	mut c0 = h.a0 - 3
	if c0 < 0 {
		c0 = 0
	}
	mut c1 = h.a1 + 3
	if c1 > len(a) {
		c1 = len(a)
	}
	let before = h.a0 - c0
	let after = c1 - h.a1
	let alen = c1 - c0
	let blen = before + (h.b1 - h.b0) + after
	mut astart = c0 + 1
	if alen == 0 {
		astart = c0
	}
	mut bstart = h.b0 - before + 1
	if blen == 0 {
		bstart = h.b0 - before
	}
	mut s = "@@ -" + rangeText(astart, alen) + " +" + rangeText(bstart, blen) + " @@\n"
	for i in c0..h.a0 {
		s = s + " " + lineText(a[i])
	}
	for i in h.a0..h.a1 {
		s = s + "-" + lineText(a[i])
	}
	for j in h.b0..h.b1 {
		s = s + "+" + lineText(b[j])
	}
	for i in h.a1..c1 {
		s = s + " " + lineText(a[i])
	}
	return s
}

fn rangeText(start i64, n i64) str {
	if n == 1 {
		return "{start}"
	}
	return "{start},{n}"
}

fn lineText(l str) str {
	if twine.HasSuffix(l, "\n") {
		return l
	}
	return l + "\n\\ No newline at end of file\n"
}

fn doAddPatch(g Global, paths []str, o mut Out) ! {
	mut r = try open(g)
	use lock = change.Lock(r.Ws.Store)
	mut idx = try r.readIndex()
	mut wanted = []str{}
	for p in paths {
		let rel = try r.rel(g, p)
		wanted = append(wanted, rel)
	}
	mut loose = store.NewLoose(r.Ws.Store + "/objects")
	mut staged = 0
	mut quit = false
	let entries = idx.Entries
	for e in entries {
		if quit {
			break
		}
		if e.Stage != 0 || !matchesAny(e.Path, wanted) {
			continue
		}
		let changed = try changedOnDisk(r.Ws.Root, e)
		if !changed {
			continue
		}
		let id = try object.IdOf(e.Hash)
		let (_, before) = try r.Store.GetRaw(id)
		if !quarry.Exists(r.Ws.Root + "/" + e.Path) {
			writeOut("deleted: " + e.Path + "\nStage this deletion [y,n,q]? ")
			let ans = answer()
			if ans == "y" {
				idx.Remove(e.Path)
				staged += 1
			} else if ans == "q" || len(ans) == 0 {
				quit = true
			}
			continue
		}
		let (after, mode) = try readWork(r.Ws.Root, e.Path)
		if hasNul(before) || hasNul(after) || mode != e.Mode {
			writeOut("Skipping " + e.Path + " (binary, or its mode changed): tit add " + e.Path + " stages it whole.\n")
			continue
		}
		let a = diff.Lines(before)
		let b = diff.Lines(after)
		let hs = hunksOf(a, b)
		mut take = []bool{}
		for _ in hs {
			take = append(take, false)
		}
		writeOut(paint(g, "1", "diff --git a/" + e.Path + " b/" + e.Path) + "\n")
		mut rest = ""
		for k in 0..len(hs) {
			if rest == "a" {
				take[k] = true
				continue
			}
			if rest == "d" {
				continue
			}
			writeOut(hunkText(a, b, hs[k]))
			mut ans = ""
			for {
				writeOut("({k + 1}/{len(hs)}) Stage this hunk [y,n,q,a,d,?]? ")
				ans = answer()
				if ans != "?" {
					break
				}
				writeOut("y - stage this hunk\nn - do not stage this hunk\nq - quit; do not stage this hunk or any of the remaining ones\na - stage this hunk and all later hunks in the file\nd - do not stage this hunk or any of the later hunks in the file\n")
			}
			if ans == "y" {
				take[k] = true
			} else if ans == "a" {
				take[k] = true
				rest = "a"
			} else if ans == "d" {
				rest = "d"
			} else if ans == "q" || len(ans) == 0 {
				quit = true
				break
			} else if ans != "n" {
				fail fault.Wrap(ErrUsage, "add -p: answer y, n, q, a or d (not {ans})")
			}
		}
		mut any = false
		for t in take {
			if t {
				any = true
				staged += 1
			}
		}
		if any {
			let text = applyHunks(a, b, hs, take)
			let nid = try loose.PutRaw(object.Kind.Blob, text)
			// no stat: the file on the disk is not what the index now holds
			idx.Set(index.Entry{Path: e.Path, Hash: nid.Bytes(), Mode: e.Mode, Stage: 0, Size: 0, Mtime: 0, Ctime: 0, Inode: 0, Device: 0})
		}
	}
	try idx.Write(r.Ws.IndexPath())
	o.Line("Staged {staged} " + plural(staged, "hunk", "hunks") + ".")
}

fn matchesAny(path str, wanted []str) bool {
	if len(wanted) == 0 {
		return true
	}
	for w in wanted {
		if w == "" || w == "." || path == w || under(path, w) {
			return true
		}
	}
	return false
}

fn plural(n i64, one str, many str) str {
	if n == 1 {
		return one
	}
	return many
}
