package cmd

import "../diff"
import "../ignore"
import "../object"
import "fault"
import "flume"
import "quarry"
import "seal"
import "twine"

// tit guard (#801): before each commit, the files it adds or changes are searched for private keys and access
// tokens. A key is a PEM block or DER that seal parses as a private key (so a real key is caught and key-shaped text
// is not), an OpenSSH or tit private key, or an encrypted one; a token is an issuer's prefix followed by the length
// and alphabet that issuer uses. Paths listed in .tit-guard-allow (ignore patterns) are not searched. Guard makes no
// claim about passwords.

// ErrSecret is the fault of a commit that would record a private key or a token.
let ErrSecret = fault("a private key or an access token")

// Finding is one secret in a file.
type Finding struct {
	Path str
	Line i64
	What str
}

// tokenRule is an issuer's prefix, the shortest body after it, and the characters the body is made of.
type tokenRule struct {
	prefix str
	least  i64
	chars  str
	what   str
}

const alnum = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"

fn tokenRules() []tokenRule {
	return []tokenRule{
		tokenRule{prefix: "ghp_", least: 36, chars: alnum, what: "a GitHub token"},
		tokenRule{prefix: "gho_", least: 36, chars: alnum, what: "a GitHub token"},
		tokenRule{prefix: "ghu_", least: 36, chars: alnum, what: "a GitHub token"},
		tokenRule{prefix: "ghs_", least: 36, chars: alnum, what: "a GitHub token"},
		tokenRule{prefix: "ghr_", least: 36, chars: alnum, what: "a GitHub token"},
		tokenRule{prefix: "github_pat_", least: 82, chars: alnum + "_", what: "a GitHub token"},
		tokenRule{prefix: "AKIA", least: 16, chars: "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789", what: "an AWS access key"},
		tokenRule{prefix: "ASIA", least: 16, chars: "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789", what: "an AWS access key"},
		tokenRule{prefix: "xoxb-", least: 10, chars: alnum + "-", what: "a Slack token"},
		tokenRule{prefix: "xoxp-", least: 10, chars: alnum + "-", what: "a Slack token"},
		tokenRule{prefix: "xoxa-", least: 10, chars: alnum + "-", what: "a Slack token"},
		tokenRule{prefix: "glpat-", least: 20, chars: alnum + "_-", what: "a GitLab token"},
		tokenRule{prefix: "sk_live_", least: 24, chars: alnum, what: "a Stripe key"},
		tokenRule{prefix: "rk_live_", least: 24, chars: alnum, what: "a Stripe key"},
		tokenRule{prefix: "AIza", least: 35, chars: alnum + "_-", what: "a Google API key"},
		tokenRule{prefix: "sk-ant-", least: 40, chars: alnum + "_-", what: "an Anthropic API key"},
		tokenRule{prefix: "npm_", least: 36, chars: alnum, what: "an npm token"},
		tokenRule{prefix: "pypi-", least: 50, chars: alnum + "_-", what: "a PyPI token"},
	}
}

fn isWordByte(c u8) bool {
	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
}

fn lineAt(body str, at i64) i64 {
	mut n = 1
	for i in 0..at {
		if body[i] == '\n' {
			n += 1
		}
	}
	return n
}

// derAt reads the tag and the content's bounds of the DER element at at, or tag -1.
fn derAt(d []u8, at i64, end i64) (i64, i64, i64) {
	if at + 2 > end {
		return -1, 0, 0
	}
	let tag = i64(d[at])
	mut n = i64(d[at + 1])
	mut p = at + 2
	if n & 0x80 != 0 {
		let k = n & 0x7f
		if k == 0 || k > 4 || p + k > end {
			return -1, 0, 0
		}
		n = 0
		for i in 0..k {
			n = (n << 8) | i64(d[p + i])
		}
		p += k
	}
	if p + n > end {
		return -1, 0, 0
	}
	return tag, p, p + n
}

// keyShape names a private key whose DER has the shape of one even where seal does not take its parameters (an EC
// key with explicit curve parameters): PKCS #8 (version 0, a key algorithm, then the key) or SEC 1 (version 1, then
// the key). Anything else is "".
fn keyShape(d []u8) str {
	let (t0, s0, e0) = derAt(d, 0, len(d))
	if t0 != 0x30 {
		return ""
	}
	let (t1, s1, e1) = derAt(d, s0, e0)
	if t1 != 0x02 || e1 - s1 != 1 {
		return ""
	}
	let version = i64(d[s1])
	let (t2, s2, e2) = derAt(d, e1, e0)
	if version == 1 && t2 == 0x04 && e2 - s2 >= 16 {
		return "an EC private key"
	}
	if version != 0 || t2 != 0x30 {
		return ""
	}
	let (t3, s3, e3) = derAt(d, s2, e2)
	if t3 != 0x06 {
		return ""
	}
	let oid = seal.Hex(d[s3:e3])
	let (t4, s4, e4) = derAt(d, e2, e0)
	if t4 != 0x04 || e4 - s4 < 16 {
		return ""
	}
	if oid == "2a8648ce3d0201" {
		return "an EC private key"
	}
	if oid == "2a864886f70d010101" {
		return "an RSA private key"
	}
	if oid == "2b6570" {
		return "an Ed25519 private key"
	}
	return ""
}

// Scan is every private key and token in a file's content.
fn Scan(path str, body str) []Finding {
	mut out = []Finding{}
	// PEM blocks
	mut at = 0
	for {
		let b = twine.Index(body[at:], "-----BEGIN ")
		if b < 0 {
			break
		}
		let start = at + b
		let close = twine.Index(body[start + 11:], "-----")
		if close < 0 {
			break
		}
		let kind = body[start + 11:start + 11 + close]
		let endMark = "-----END " + kind + "-----"
		let e = twine.Index(body[start:], endMark)
		if e < 0 {
			at = start + 11
			continue
		}
		let block = body[start:start + e + len(endMark)]
		at = start + e + len(endMark)
		if !twine.Contains(kind, "PRIVATE KEY") {
			continue
		}
		mut what = ""
		if kind == "OPENSSH PRIVATE KEY" {
			let blocks = seal.DecodePEM(block) catch _ {
				continue
			}
			if len(blocks) == 1 && len(blocks[0].Bytes) > 15 && str(blocks[0].Bytes[0:15]) == "openssh-key-v1\x00" {
				what = "an OpenSSH private key"
			}
		} else if kind == "ENCRYPTED PRIVATE KEY" {
			let blocks = seal.DecodePEM(block) catch _ {
				continue
			}
			if len(blocks) == 1 && len(blocks[0].Bytes) > 0 {
				what = "an encrypted private key"
			}
		} else {
			let (k, perr) = seal.ParsePrivateKeyPEM(block)
			if perr != nil {
				let blocks = seal.DecodePEM(block) catch _ {
					continue
				}
				if len(blocks) == 1 {
					what = keyShape(blocks[0].Bytes)
				}
				if len(what) > 0 {
					out = append(out, Finding{Path: path, Line: lineAt(body, start), What: what})
				}
				continue
			}
			what = match k.Algorithm {
				UnknownKey => "a private key"
				RSA => "an RSA private key"
				ECDSA => "an EC private key"
				Ed25519 => "an Ed25519 private key"
			}
		}
		if len(what) > 0 {
			out = append(out, Finding{Path: path, Line: lineAt(body, start), What: what})
		}
	}
	// a DER private key: a whole small file that parses as one
	if len(body) > 32 && len(body) < 16384 && body[0] == 0x30 {
		let (k, err) = seal.ParsePrivateKeyDER([]u8(body))
		_ = k
		if err == nil || len(keyShape([]u8(body))) > 0 {
			out = append(out, Finding{Path: path, Line: 1, What: "a DER private key"})
		}
	}
	// a tit key file
	if twine.HasPrefix(body, "tit ed25519 private key\n") {
		out = append(out, Finding{Path: path, Line: 1, What: "a tit private key"})
	}
	// tokens
	for rule in tokenRules() {
		mut from = 0
		for {
			let p = twine.Index(body[from:], rule.prefix)
			if p < 0 {
				break
			}
			let s = from + p
			from = s + len(rule.prefix)
			if s > 0 && isWordByte(body[s - 1]) {
				continue
			}
			mut n = 0
			for from + n < len(body) && twine.ContainsByte(rule.chars, body[from + n]) {
				n += 1
			}
			if n >= rule.least {
				out = append(out, Finding{Path: path, Line: lineAt(body, s), What: rule.what})
			}
		}
	}
	return out
}

// guardRules is .tit-guard-allow: the paths guard does not search.
fn guardRules(root str) !ignore.Rules {
	mut rules = ignore.New(root)
	let path = root + "/.tit-guard-allow"
	if quarry.Exists(path) {
		let text = try flume.ReadFile(path)
		rules.AddOuter(text)
	}
	return rules
}

fn findingText(f Finding) str {
	return "{f.Path}:{f.Line}: {f.What}"
}

// guardCommit searches the files the commit adds or changes from the tree before to the tree after.
fn guardCommit(r mut Repo, before object.Id, after object.Id) ! {
	let changes = try diff.TreeDiff(mut r.Store, before, after, false)
	let rules = try guardRules(r.Ws.Root)
	mut found = []str{}
	for c in changes {
		if c.Kind == diff.Kind.Deleted || rules.Ignored(c.Path, false) {
			continue
		}
		let id = try object.IdOf(c.NewHash)
		let (_, body) = try r.Store.GetRaw(id)
		for f in Scan(c.Path, body) {
			found = append(found, findingText(f))
		}
	}
	if len(found) > 0 {
		fail fault.Wrap(ErrSecret, "tit guard refused the commit: " + twine.Join(found, "; ") + " (a path in .tit-guard-allow is not searched)")
	}
}

fn doGuard(g Global, paths []str, o mut Out) ! {
	let r = try open(g)
	let rules = try guardRules(r.Ws.Root)
	mut files = []str{}
	if len(paths) == 0 {
		let idx = try r.readIndex()
		for e in idx.Entries {
			if e.Stage == 0 {
				files = append(files, e.Path)
			}
		}
	} else {
		for p in paths {
			let rel = try r.rel(g, p)
			files = append(files, rel)
		}
	}
	mut n = 0
	for f in files {
		if rules.Ignored(f, false) {
			continue
		}
		let full = r.Ws.Root + "/" + f
		if !quarry.Exists(full) || quarry.IsDir(full) {
			continue
		}
		let body = try flume.ReadFile(full)
		for x in Scan(f, body) {
			o.Line(findingText(x))
			n += 1
		}
	}
	if n > 0 {
		fail fault.Wrap(ErrSecret, "{n} found (a path in .tit-guard-allow is not searched)")
	}
}
