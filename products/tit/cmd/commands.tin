// The commands of the first wave: init, status, log, show, cat, config and key.

fn doInit(g Global, dir str, o mut Out) ! {
	let root = trail.Clean(dir)
	let store = root + "/.tit"
	if quarry.Exists(store) {
		fail "{store} exists already"
	}
	for sub in []str{"objects", "packs", "refs/heads", "refs/tags", "changes", "oplog", "workspaces/default"} {
		try quarry.MkdirAll(store + "/" + sub)
	}
	try change.WriteHead(store + "/workspaces/default", change.Head.Branch("refs/heads/main"))
	try quarry.WriteFile(store + "/config", "[core]\n\tformat = 1\n")
	if g.Json {
		o.Line("{{\"store\":\"" + store + "\"}}")
	} else {
		o.Line("Started an empty tit repository in " + store)
	}
}

type statusJson struct {
	staged    []str
	unstaged  []str
	untracked []str
}

fn letter(f index.FileStatus) str {
	return match f {
		Added(_) => "A"
		Modified(_) => "M"
		Deleted(_) => "D"
		Renamed(_, _) => "R"
		TypeChanged(_) => "T"
		Untracked(_) => "?"
		Conflicted(_) => "U"
	}
}

fn fpath(f index.FileStatus) str {
	return match f {
		Added(p) => p
		Modified(p) => p
		Deleted(p) => p
		Renamed(_, p) => p
		TypeChanged(p) => p
		Untracked(p) => p
		Conflicted(p) => p
	}
}

// collapse shows an untracked directory with no tracked files in it as "dir/", as git does, instead of each file.
fn collapse(untracked []str, idx index.Index) []str {
	mut tracked = map[str]bool{}
	for e in idx.Entries {
		for i in 0..len(e.Path) {
			if e.Path[i] == '/' {
				tracked[e.Path[0:i]] = true
			}
		}
	}
	mut out = []str{}
	mut seen = map[str]bool{}
	for p in untracked {
		mut shown = p
		for i in 0..len(p) {
			if p[i] == '/' {
				let (_, t) = tracked[p[0:i]]
				if !t {
					shown = p[0:i + 1]
					break
				}
			}
		}
		let (_, dup) = seen[shown]
		if !dup {
			seen[shown] = true
			out = append(out, shown)
		}
	}
	return out
}

// stagedRenames finds, among the staged additions and deletions, the files that moved (as git's status does): new path
// to old path.
fn stagedRenames(r mut Repo, idx index.Index, head object.Id, rep index.Report) !map[str]str {
	mut out = map[str]str{}
	mut adds = 0
	mut dels = 0
	for f in rep.Staged {
		if letter(f) == "A" {
			adds += 1
		} else if letter(f) == "D" {
			dels += 1
		}
	}
	if adds == 0 || dels == 0 {
		return out
	}
	mut s = r.scratch()
	let staged = try index.WriteTree(mut s, idx)
	let changes = try diff.TreeDiff(mut s, head, staged, true)
	for c in changes {
		if c.Kind == diff.Kind.Renamed {
			out[c.Path] = c.OldPath
		}
	}
	return out
}

// stagedLines is each staged change as a letter and its path, a move as "R old -> new".
fn stagedLines(rep index.Report, renames map[str]str) []str {
	mut renamedFrom = map[str]bool{}
	for _, old in renames {
		renamedFrom[old] = true
	}
	mut out = []str{}
	for f in rep.Staged {
		let p = fpath(f)
		let (_, gone) = renamedFrom[p]
		let (old, moved) = renames[p]
		if gone && letter(f) == "D" {
			continue
		}
		if moved && letter(f) == "A" {
			out = append(out, "R " + old + " -> " + p)
		} else {
			out = append(out, letter(f) + " " + p)
		}
	}
	return out
}

// porcelain is status in git's short form: a staged and an unstaged letter per changed path, in path order, then
// "??" for each untracked path.
// conflictCode is git's two letters for a conflicted path, from the stages it has.
fn conflictCode(idx index.Index, path str) str {
	let (b, o, t) = idx.Stages(path)
	if !b && o && t {
		return "AA"
	}
	if b && !o && t {
		return "DU"
	}
	if b && o && !t {
		return "UD"
	}
	if !b && o && !t {
		return "AU"
	}
	if !b && !o && t {
		return "UA"
	}
	return "UU"
}

fn porcelain(rep index.Report, untracked []str, renames map[str]str, idx index.Index) []str {
	mut codes = map[str][]str{}
	mut paths = []str{}
	mut renamedFrom = map[str]bool{}
	for _, old in renames {
		renamedFrom[old] = true
	}
	for f in rep.Staged {
		let p = fpath(f)
		let (_, gone) = renamedFrom[p]
		if gone && letter(f) == "D" {
			continue
		}
		let (cur, ok) = codes[p]
		if !ok {
			paths = append(paths, p)
			codes[p] = []str{letter(f), " "}
		} else {
			codes[p] = []str{letter(f), cur[1]}
		}
	}
	for f in rep.Unstaged {
		let p = fpath(f)
		let (cur, ok) = codes[p]
		if !ok {
			paths = append(paths, p)
			codes[p] = []str{" ", letter(f)}
		} else {
			codes[p] = []str{cur[0], letter(f)}
		}
	}
	sift.Sort(mut paths)
	mut out = []str{}
	for p in paths {
		let (c, _) = codes[p]
		let (old, moved) = renames[p]
		if c[0] == "U" {
			out = append(out, conflictCode(idx, p) + " " + p)
		} else if moved && c[0] == "A" {
			out = append(out, "R" + c[1] + " " + old + " -> " + p)
		} else {
			out = append(out, c[0] + c[1] + " " + p)
		}
	}
	for p in untracked {
		out = append(out, "?? " + p)
	}
	return out
}

fn doStatus(g Global, short bool, o mut Out) ! {
	mut r = try open(g)
	mut idx = try r.readIndex()
	let head = try r.headCommit()
	mut tree = object.NoId
	if head != nil {
		tree = try r.headTreeOf(head)
	}
	mut rules = try ignore.Load(r.Ws.Root)
	let known = idx.Tree != object.NoId
	let full = try index.Status(mut r.Store, r.Ws.Root, tree, mut idx, mut rules)
	let rep = focused(r, full)
	// unchanged files' new stat goes back into the index, so the next status skips them
	if rep.Restat {
		try idx.Write(r.Ws.IndexPath())
	} else if !known {
		r.rememberIndexTree(idx)
	}
	let untracked = collapse(rep.Untracked, idx)
	let renames = try stagedRenames(mut r, idx, tree, rep)
	if short && !g.Json {
		for line in porcelain(rep, untracked, renames, idx) {
			o.Line(line)
		}
		return
	}
	if g.Json {
		mut j = statusJson{staged: []str{}, unstaged: []str{}, untracked: untracked}
		j.staged = stagedLines(rep, renames)
		for f in rep.Unstaged {
			j.unstaged = append(j.unstaged, letter(f) + " " + fpath(f))
		}
		mut b = make([]u8, 0, 256)
		argo.Put(mut b, j)
		o.Line(str(b))
		return
	}
	if len(rep.Staged) + len(rep.Unstaged) + len(rep.Untracked) == 0 {
		o.Line("Nothing to commit, the working directory matches the last commit.")
		return
	}
	if len(rep.Staged) > 0 {
		o.Line("Staged for the next commit:")
		for line in stagedLines(rep, renames) {
			o.Line("  " + paint(g, "32", line))
		}
	}
	if len(rep.Unstaged) > 0 {
		o.Line("Changed, not staged:")
		for f in rep.Unstaged {
			o.Line("  " + paint(g, "31", letter(f) + " " + fpath(f)))
		}
	}
	if len(untracked) > 0 {
		o.Line("Untracked:")
		for p in untracked {
			o.Line("  " + paint(g, "31", p))
		}
	}
}

// focused is a status without the files outside the workspace's focus, which are not on the disk (worktree/focus.tin).
fn focused(r Repo, rep index.Report) index.Report {
	let focus = worktree.FocusOf(r.Ws)
	if len(focus) == 0 {
		return rep
	}
	mut unstaged = []index.FileStatus{}
	for f in rep.Unstaged {
		if worktree.InFocus(focus, fpath(f)) {
			unstaged = append(unstaged, f)
		}
	}
	mut untracked = []str{}
	for p in rep.Untracked {
		if worktree.InFocus(focus, p) {
			untracked = append(untracked, p)
		}
	}
	return index.Report{Staged: rep.Staged, Unstaged: unstaged, Untracked: untracked, Restat: rep.Restat}
}

fn dateText(p object.Person) str {
	let zone = tide.FixedZone("", p.Zone * 60)
	return tide.Format(p.When * 1000000000, zone, "Mon Jan 2 15:04:05 2006 -0700")
}

fn commitData(r mut Repo, id object.Id) !object.CommitData {
	let o = try r.Store.Get(id)
	return match o {
		Commit(c) => c
		Blob(_) => try notCommitData(id)
		Tree(_) => try notCommitData(id)
		Tag(_) => try notCommitData(id)
	}
}

fn notCommitData(id object.Id) !object.CommitData {
	fail fault.Wrap(revwalk.ErrBadRev, "{id.Hex()} is not a commit")
}

fn firstLine(s str) str {
	for i in 0..len(s) {
		if s[i] == '\n' {
			return s[0:i]
		}
	}
	return s
}

type logJson struct {
	commit  str
	change  str
	parents []str
	author  str
	email   str
	time    i64
	message str
}

fn writeCommit(g Global, r mut Repo, id object.Id, c object.CommitData, o mut Out) {
	o.Line(paint(g, "33", "commit " + id.Hex()))
	if len(c.Parents) > 1 {
		mut ps = []str{}
		for p in c.Parents {
			ps = append(ps, p.Hex()[0:12])
		}
		o.Line("Merge:  " + joinWords(ps))
	}
	o.Line("Change: " + c.Change.Letters()[0:12])
	o.Line("Author: " + c.Author.Name + " <" + c.Author.Email + ">")
	o.Line("Date:   " + dateText(c.Author))
	o.Line("")
	for line in splitLines(c.Message) {
		o.Line("    " + line)
	}
}

fn splitLines(s str) []str {
	mut out = []str{}
	mut start = 0
	for i in 0..len(s) {
		if s[i] == '\n' {
			out = append(out, s[start:i])
			start = i + 1
		}
	}
	if start < len(s) {
		out = append(out, s[start:])
	}
	return out
}

fn doLog(g Global, la LogArgs, o mut Out) ! {
	mut r = try open(g)
	let parsed = try revwalk.Parse(la.Rev)
	if la.Rev == "HEAD" {
		let head = try r.headCommit()
		if head == nil {
			fail "the current branch has no commits yet"
		}
	}
	mut starts = []object.Id{}
	mut hide = []object.Id{}
	mut single = false
	match parsed {
		Range(a, b) => {
			let ai = try r.resolveRev(a)
			let bi = try r.resolveRev(b)
			hide = append(hide, ai)
			starts = append(starts, bi)
		}
		Symmetric(a, b) => {
			// what either side has that the other lacks: both tips, less their merge base's history
			let ai = try r.resolveRev(a)
			let bi = try r.resolveRev(b)
			starts = append(starts, ai, bi)
			let base = try revwalk.MergeBase(mut r.Store, ai, bi)
			if base != nil {
				hide = append(hide, base)
			}
		}
		Head => {
			single = true
		}
		Name(_) => {
			single = true
		}
		Short(_) => {
			single = true
		}
		Change(_) => {
			single = true
		}
		Git(_) => {
			single = true
		}
		Ancestor(_, _) => {
			single = true
		}
		Parent(_, _) => {
			single = true
		}
	}
	if single {
		let id = try r.resolveRev(parsed)
		starts = append(starts, id)
	}
	mut order = revwalk.Order.Date
	if la.First {
		order = revwalk.Order.FirstParent
	} else if la.Topo {
		order = revwalk.Order.Topo
	}
	let ids = try revwalk.Walk(mut r.Store, starts, hide, order, la.Most)
	// --format=git-id: the git id each adopted commit came from, "-" for one made in tit
	mut gitOf = map[str]str{}
	if la.Format == "git-id" {
		let table = try git.ReadIds(r.Ws.Store + "/git-ids")
		let (gs, ts) = table.Pairs()
		for k in 0..len(gs) {
			gitOf[ts[k]] = gs[k]
		}
	}
	mut first = true
	for id in ids {
		if la.Format == "id" {
			o.Line(id.Hex())
			continue
		}
		if la.Format == "git-id" {
			let (gid, adopted) = gitOf[id.Bytes()]
			if adopted {
				o.Line(git.Hex(gid))
			} else {
				o.Line("-")
			}
			continue
		}
		let c = try commitData(mut r, id)
		if la.Format == "change" {
			o.Line(c.Change.Letters())
			continue
		}
		if la.Format == "subject" {
			o.Line(firstLine(c.Message))
			continue
		}
		if g.Json {
			mut ps = []str{}
			for p in c.Parents {
				ps = append(ps, p.Hex())
			}
			mut b = make([]u8, 0, 256)
			argo.Put(mut b, logJson{commit: id.Hex(), change: c.Change.Letters(), parents: ps, author: c.Author.Name, email: c.Author.Email, time: c.Author.When, message: c.Message})
			o.Line(str(b))
		} else if la.OneLine {
			o.Line(paint(g, "33", id.Hex()[0:12]) + " " + firstLine(c.Message))
		} else {
			if !first {
				o.Line("")
			}
			writeCommit(g, mut r, id, c, mut o)
		}
		first = false
	}
}

fn doShow(g Global, rev str, o mut Out) ! {
	mut r = try open(g)
	let id = try r.resolve(rev)
	let c = try commitData(mut r, id)
	mut before = object.NoId
	if len(c.Parents) > 0 {
		before = try r.treeOf(c.Parents[0])
	}
	mut sc = r.scratch()
	let changes = try diff.TreeDiff(mut sc, before, c.Tree, true)
	if g.Json {
		mut ps = []str{}
		for p in c.Parents {
			ps = append(ps, p.Hex())
		}
		mut files = "["
		for i in 0..len(changes) {
			if i > 0 {
				files = files + ","
			}
			files = files + jsonObject([]str{"status", jsonStr(diff.KindLetter(changes[i].Kind)), "path", jsonStr(changes[i].Path), "old_path", jsonStr(changes[i].OldPath)})
		}
		o.Line(jsonObject([]str{"commit", jsonStr(id.Hex()), "change", jsonStr(c.Change.Letters()), "parents", jsonList(ps), "author", jsonStr(c.Author.Name), "email", jsonStr(c.Author.Email), "time", "{c.Author.When}", "message", jsonStr(c.Message), "conflicts", jsonList(c.Conflicts), "files", files + "]"}))
		return
	}
	writeCommit(g, mut r, id, c, mut o)
	if len(changes) == 0 {
		return
	}
	o.Line("---")
	let stats = try diff.Stats(mut sc, changes)
	o.Text(diff.FormatStat(stats))
	o.Line("")
	try writePatch(g, mut sc, changes, mut o)
}

fn doCat(g Global, rev str, o mut Out) ! {
	mut r = try open(g)
	mut id = object.NoId
	let parsed = object.ParseId(rev) catch _ {
		object.NoId
	}
	if parsed != object.NoId {
		id = parsed
	} else {
		let found = try r.ids.Match(rev)
		if len(found) == 1 {
			id = found[0]
		} else {
			id = try r.resolve(rev)
		}
	}
	let (kind, body) = try r.Store.GetRaw(id)
	if g.Json {
		mut kname = "blob"
		mut entries = "[]"
		match kind {
			Tree => {
				kname = "tree"
				let obj = try object.Decode(kind, body)
				entries = "["
				match obj {
					Tree(es) => {
						for i in 0..len(es) {
							if i > 0 {
								entries = entries + ","
							}
							entries = entries + jsonObject([]str{"mode", jsonStr(object.ModeText(es[i].Mode)), "id", jsonStr(es[i].Id.Hex()), "name", jsonStr(es[i].Name)})
						}
					}
					Blob(_) => {
					}
					Commit(_) => {
					}
					Tag(_) => {
					}
				}
				entries = entries + "]"
			}
			Blob => {
			}
			Commit => {
				kname = "commit"
			}
			Tag => {
				kname = "tag"
			}
		}
		if kname == "tree" {
			o.Line(jsonObject([]str{"id", jsonStr(id.Hex()), "kind", jsonStr(kname), "entries", entries}))
		} else {
			o.Line(jsonObject([]str{"id", jsonStr(id.Hex()), "kind", jsonStr(kname), "size", "{len(body)}", "content", jsonStr(body)}))
		}
		return
	}
	match kind {
		Tree => {
			let obj = try object.Decode(kind, body)
			match obj {
				Tree(es) => {
					for e in es {
						mut k = "blob"
						if e.Mode == object.Mode.Dir {
							k = "tree"
						}
						o.Line(object.ModeText(e.Mode) + " " + k + " " + e.Id.Hex() + "\t" + e.Name)
					}
				}
				Blob(_) => {
				}
				Commit(_) => {
				}
				Tag(_) => {
				}
			}
		}
		Blob, Commit, Tag => {
			o.Text(body)
		}
	}
}

fn doConfigGet(g Global, key str, o mut Out) ! {
	let r = try open(g)
	let c = try r.config()
	let v = c.Get(key)
	if v == nil {
		fail "{key} is not set"
	}
	if g.Json {
		o.Line(jsonObject([]str{"key", jsonStr(key), "value", jsonStr(v)}))
		return
	}
	o.Line(v)
}

fn doConfigSet(g Global, key str, value str, user bool, o mut Out) ! {
	if user {
		try identity.Set(identity.UserConfigPath(), key, value)
		return
	}
	let r = try open(g)
	try identity.Set(r.Ws.Store + "/config", key, value)
}

fn doConfigList(g Global, o mut Out) ! {
	let r = try open(g)
	let c = try r.config()
	for k in c.Keys() {
		let v = c.Get(k)
		if v != nil {
			if g.Json {
				o.Line(jsonObject([]str{"key", jsonStr(k), "value", jsonStr(v)}))
			} else {
				o.Line(k + "=" + v)
			}
		}
	}
}

fn doKey(g Global, path str, o mut Out) ! {
	mut cfg = identity.NewConfig()
	let (r, oerr) = open(g)
	if oerr == nil {
		cfg = try r.config()
	}
	mut p = path
	if len(p) == 0 {
		p = identity.DefaultKeyPath(cfg)
	}
	if quarry.Exists(p) {
		let s = try identity.LoadKey(p)
		o.Line(seal.B64(s.Public))
		return
	}
	let pub = try identity.NewKey(p)
	o.Line(pub)
	quarry.Eprintln("tit: made a new key at " + p + "; add this line to .tit-signers to be trusted:")
	quarry.Eprintln("<your email> ed25519 " + pub)
}
