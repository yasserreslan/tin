package cmd

import "../change"
import "../diff"
import "../object"
import "../revwalk"
import "sift"
import "twine"

// tit overlap (#799): which other branches (local, and remote ones after a fetch) change the declarations this
// branch's changes change, so two people find out before their merge does.

// declsOf is every Tin declaration the commits from tip down to (not into) base change, as "dir: key".
fn declsOf(r mut Repo, tip object.Id, base object.Id) !map[str]bool {
	mut out = map[str]bool{}
	let ids = try revwalk.Walk(mut r.Store, []object.Id{tip}, []object.Id{base}, revwalk.Order.Topo, 0)
	for id in ids {
		let c = try commitData(mut r, id)
		mut before = object.NoId
		if len(c.Parents) > 0 {
			before = try r.treeOf(c.Parents[0])
		}
		let changes = try diff.TreeDiff(mut r.Store, before, c.Tree, true)
		let cs = try semanticOf(mut r.Store, changes)
		for k in cs {
			out[trailDir(k.Path) + ": " + k.Key] = true
			if len(k.OldPath) > 0 && k.OldKey != k.Key {
				out[trailDir(k.OldPath) + ": " + k.OldKey] = true
			}
		}
	}
	return out
}

fn doOverlap(g Global, o mut Out) ! {
	mut r = try open(g)
	let trunk = try trunkOf(r)
	let trunkTip = try r.resolve(trunk)
	let current = try currentBranch(r)
	let head = try r.resolve("HEAD")
	mut base = trunkTip
	if current == "refs/heads/" + trunk {
		let c = try commitData(mut r, head)
		if len(c.Parents) > 0 {
			base = c.Parents[0]
		}
	}
	let mine = try declsOf(mut r, head, base)
	if len(mine) == 0 {
		o.Line("This branch changes no Tin declaration.")
		return
	}
	let refs = change.NewRefs(r.Ws.Store)
	let all = try refs.List("refs/")
	mut found = 0
	for ref in all {
		let isBranch = twine.HasPrefix(ref.Name, "refs/heads/") || twine.HasPrefix(ref.Name, "refs/remotes/")
		if !isBranch || ref.Name == current || ref.Name == "refs/heads/" + trunk || twine.HasSuffix(ref.Name, "/" + trunk) || twine.HasSuffix(ref.Name, "/" + shortBranch(current)) {
			continue
		}
		let tip = try r.resolve(ref.Name)
		let theirs = try declsOf(mut r, tip, trunkTip)
		mut both = []str{}
		for k, _ in theirs {
			let (_, hit) = mine[k]
			if hit {
				both = append(both, k)
			}
		}
		if len(both) == 0 {
			continue
		}
		sift.Sort(mut both)
		found += 1
		mut name = ref.Name[5:]
		if twine.HasPrefix(ref.Name, "refs/heads/") {
			name = ref.Name[11:]
		}
		o.Line(paint(g, "33", name) + " also changes:")
		for k in both {
			o.Line("  " + k)
		}
	}
	if found == 0 {
		o.Line("No other branch changes the declarations this one changes.")
	}
}
