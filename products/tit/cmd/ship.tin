package cmd

import "../change"
import "../identity"
import "../object"
import "../oplog"
import "../packfile"
import "../revwalk"
import "../store"
import "../transport"
import "fault"
import "flume"
import "quarry"
import "seal"
import "twine"

// tit ship (#804): a release in one command. The tag is annotated with the changelog, the first line of every
// change since the last tag reachable from HEAD, oldest first; it is signed when you have a key; then the branch and
// the tag are pushed.

// ShipArgs are tit ship's arguments.
type ShipArgs struct {
	Version str
	Remote  str
	Push    bool
	DryRun  bool
}

// lastTag is the tag nearest below head (fewest commits away), its commit, and "" when no tag is below head.
fn lastTag(r mut Repo, head object.Id) !(str, object.Id) {
	let refs = change.NewRefs(r.Ws.Store)
	let tags = try refs.List("refs/tags/")
	if len(tags) == 0 {
		return "", object.NoId
	}
	let walk = try revwalk.Walk(mut r.Store, []object.Id{head}, []object.Id{}, revwalk.Order.Topo, 0)
	mut at = map[str]i64{}
	for i in 0..len(walk) {
		at[walk[i].Bytes()] = i
	}
	mut best = ""
	mut bestId = object.NoId
	mut bestAt = len(walk)
	for t in tags {
		let id = r.resolve(t.Name) catch _ {
			continue
		}
		let (i, below) = at[id.Bytes()]
		if below && (i < bestAt || (i == bestAt && t.Name[10:] < best)) {
			best = t.Name[10:]
			bestId = id
			bestAt = i
		}
	}
	return best, bestId
}

// changelog is the tag message: the version, then one line a change since the last tag, oldest first.
fn changelog(r mut Repo, version str, head object.Id) !str {
	let (last, lastId) = try lastTag(mut r, head)
	mut hide = []object.Id{}
	if len(last) > 0 {
		hide = append(hide, lastId)
	}
	let ids = try revwalk.Walk(mut r.Store, []object.Id{head}, hide, revwalk.Order.Topo, 0)
	mut lines = []str{}
	for k in 0..len(ids) {
		let id = ids[len(ids) - 1 - k]
		let c = try commitData(mut r, id)
		if len(c.Parents) > 1 {
			// a merge brings changes listed on their own
			continue
		}
		lines = append(lines, "- " + firstLine(c.Message) + " (" + c.Change.Letters()[0:12] + ")")
	}
	mut since = ""
	if len(last) > 0 {
		since = " since " + last
	}
	mut text = version + "\n\nChanges" + since + " ({len(lines)}):\n\n"
	for l in lines {
		text = text + l + "\n"
	}
	return text
}

fn doShip(g Global, a ShipArgs, o mut Out) ! {
	let (branch, tagId, message) = try shipTag(g, a)
	if a.DryRun {
		o.Text(message)
		return
	}
	o.Text(message)
	o.Line("")
	o.Line("Tagged " + a.Version + " (" + tagId.Hex()[0:12] + ").")
	if !a.Push {
		return
	}
	let r = try open(g)
	let cfg = try r.config()
	if cfg.Get("remote." + a.Remote + ".url") == nil {
		o.Line("No remote " + a.Remote + ": the tag is made here only.")
		return
	}
	try doPush(g, ShareArgs{Remote: a.Remote, Branch: shortBranch(branch), Dir: "", Lease: false}, mut o)
	try pushTag(g, a.Remote, a.Version, tagId)
	o.Line("Pushed the tag " + a.Version + " to " + a.Remote + ".")
}

// shipTag makes the tag under the lock (released when it returns, before the push takes it again).
fn shipTag(g Global, a ShipArgs) !(str, object.Id, str) {
	mut r = try open(g)
	use lock = change.Lock(r.Ws.Store)
	let full = "refs/tags/" + a.Version
	try change.CheckName(full)
	let refs = change.NewRefs(r.Ws.Store)
	let taken = try refs.Get(full)
	if taken != nil {
		fail "a tag {a.Version} exists already"
	}
	let branch = try currentBranch(r)
	if len(branch) == 0 {
		fail "HEAD is detached: ship from a branch"
	}
	let (paths, _) = try workChanges(mut r)
	if len(paths) > 0 {
		fail "the working directory has changes that are not committed (" + twine.Join(paths, ", ") + "): a release is of commits"
	}
	let head = try r.resolve("HEAD")
	let message = try changelog(mut r, a.Version, head)
	if a.DryRun {
		return branch, object.NoId, message
	}
	let cfg = try r.config()
	let who = try identity.Who(cfg, identity.FixedClock{At: now()})
	mut t = object.TagData{Object: head, Kind: object.Kind.Commit, Name: a.Version, Tagger: who, Signature: "", Message: message}
	let keyPath = identity.DefaultKeyPath(cfg)
	if quarry.Exists(keyPath) {
		let signer = try identity.LoadKey(keyPath)
		t = try signer.SignTag(t)
	}
	mut loose = store.NewLoose(r.Ws.Store + "/objects")
	let id = try loose.Put(object.Object.Tag(t))
	try recordRefs(r, "tit ship " + a.Version, oplog.Op.Tag(a.Version), []oplog.RefChange{oplog.RefChange{Name: full, Before: "", After: commitText(id)}})
	return branch, id, message
}

// pushTag sends a tag object and creates its ref on the server (refused there when the tag exists).
fn pushTag(g Global, remote str, name str, id object.Id) ! {
	mut r = try open(g)
	use lock = change.Lock(r.Ws.Store)
	let url = try remoteURL(r, remote)
	mut c = try client(r, url)
	let tmp = r.Ws.Store + "/tmp-push-" + seal.Hex(seal.RandomBytes(8))
	let p = try packfile.Write(mut r.Store, []object.Id{id}, tmp)
	let data = try flume.ReadFile(p.Path)
	try quarry.RemoveAll(tmp)
	_ = c.Push(transport.PushRequest{Changes: []transport.ChangeUpdate{}, Refs: []transport.RefUpdate{transport.RefUpdate{Name: "refs/tags/" + name, Old: "", New: id.Hex()}}}, data) catch e {
		fail fault.Wrap(e, "the branch is pushed, the tag {name} is not")
	}
}
