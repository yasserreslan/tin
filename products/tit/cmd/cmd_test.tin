package cmd

import "../change"
import "../index"
import "../object"
import "../store"
import "../worktree"
import "crucible"
import "fault"
import "quarry"
import "seal"
import "twine"

// Tests for the tit command (#788): a repository with two commits, made through the packages, read back by the
// commands.

fn fresh(name str) str {
	let d = "/tmp/tin-test-tit-cmd-" + name + "-" + seal.Hex(seal.RandomBytes(4))
	quarry.RemoveAll(d) catch _ {
	}
	quarry.MkdirAll(d) catch _ {
	}
	return d
}

fn runArgs(t mut crucible.T, args []str) str {
	let (g, c, perr) = Parse(args)
	if perr != nil {
		t.Error("parse {args[0]}: {perr}")
		return ""
	}
	mut o = Out{buf: []u8{}}
	run(g, c, mut o) catch e {
		t.Error("run: {e}")
	}
	return str(o.buf)
}

fn commitOf(s mut store.Loose, files []str, parents []object.Id, when i64, msg str) object.Id {
	mut idx = index.New()
	mut i = 0
	for i + 1 < len(files) {
		let id = s.PutRaw(object.Kind.Blob, files[i + 1]) catch _ {
			object.NoId
		}
		idx.Set(index.Entry{Path: files[i], Hash: id.Bytes(), Mode: object.Mode.File, Stage: 0, Size: 0, Mtime: 0, Ctime: 0, Inode: 0, Device: 0})
		i += 2
	}
	let tree = index.WriteTree(mut s, idx) catch _ {
		object.NoId
	}
	let who = object.Person{Name: "Ada", Email: "ada@example.com", When: when, Zone: 120}
	let c = object.CommitData{Tree: tree, Parents: parents, Change: object.AdoptedChangeId(msg), Author: who, Committer: who, GitHeaders: []str{}, Signature: "", Message: msg, Conflicts: []str{}}
	return s.Put(object.Object.Commit(c)) catch _ {
		object.NoId
	}
}

// repo makes a repository with two commits on main and gives its directory and the commits.
fn repo(t mut crucible.T, name str) (str, object.Id, object.Id) {
	let d = fresh(name)
	_ = runArgs(mut t, []str{"init", d})
	mut s = store.NewLoose(d + "/.tit/objects")
	let c1 = commitOf(mut s, []str{"a.txt", "hello\n"}, []object.Id{}, 1700000000, "first\n")
	let c2 = commitOf(mut s, []str{"a.txt", "hello\nworld\n", "b.txt", "new\n"}, []object.Id{c1}, 1700000100, "second\n\nwith a body\n")
	mut refs = change.NewRefs(d + "/.tit")
	refs.Update("refs/heads/main", nil, change.Target.Commit(c2)) catch e {
		t.Error("update: {e}")
	}
	return d, c1, c2
}

fn TestInitAndEmptyStatus(t mut crucible.T) {
	let d = fresh("init")
	let out = runArgs(mut t, []str{"init", d})
	t.True(out, twine.Contains(out, "Started an empty tit repository"))
	t.True("refs/heads", quarry.IsDir(d + "/.tit/refs/heads"))
	let st = runArgs(mut t, []str{"-C", d, "status"})
	crucible.Equal(mut t, "output", st, "Nothing to commit, the working directory matches the last commit.\n")
	let (_, c, err) = Parse([]str{"init", d})
	t.True("parse", err == nil)
	mut o = Out{buf: []u8{}}
	mut again = false
	run(Global{Json: false, Trace: false, Dir: "", Color: false}, c, mut o) catch _ {
		again = true
	}
	t.True("a second init fails", again)
}

fn TestLog(t mut crucible.T) {
	let (d, c1, c2) = repo(mut t, "log")
	let one = runArgs(mut t, []str{"-C", d, "log", "--oneline"})
	crucible.Equal(mut t, "output", one, c2.Hex()[0:12] + " second\n" + c1.Hex()[0:12] + " first\n")
	let full = runArgs(mut t, []str{"-C", d, "log", "-n", "1"})
	t.True(full, twine.HasPrefix(full, "commit " + c2.Hex() + "\n"))
	t.True(full, twine.Contains(full, "Author: Ada <ada@example.com>\n"))
	t.True(full, twine.Contains(full, "Date:   Wed Nov 15 00:15:00 2023 +0200\n"))
	t.True(full, twine.Contains(full, "\n    second\n    \n    with a body\n"))
	t.False("-n 1", twine.Contains(full, "first"))
	let js = runArgs(mut t, []str{"-C", d, "--json", "log", "HEAD~1"})
	t.True(js, twine.HasPrefix(js, "{{\"commit\":\"" + c1.Hex() + "\""))
	let rng = runArgs(mut t, []str{"-C", d, "log", "--oneline", "HEAD~1..main"})
	crucible.Equal(mut t, "output", rng, c2.Hex()[0:12] + " second\n")
}

fn TestShowAndCat(t mut crucible.T) {
	let (d, c1, _) = repo(mut t, "show")
	let out = runArgs(mut t, []str{"-C", d, "show"})
	t.True(out, twine.Contains(out, " a.txt | 1 +\n b.txt | 1 +\n 2 files changed, 2 insertions(+)\n"))
	t.True(out, twine.Contains(out, "--- a/a.txt\n+++ b/a.txt\n@@ -1 +1,2 @@\n hello\n+world\n"))
	t.True(out, twine.Contains(out, "--- /dev/null\n+++ b/b.txt\n"))
	let first = runArgs(mut t, []str{"-C", d, "show", c1.Hex()[0:10]})
	t.True(first, twine.Contains(first, "+hello\n"))
	let body = runArgs(mut t, []str{"-C", d, "cat", "HEAD"})
	t.True(body, twine.Contains(body, "parent " + c1.Hex()))
}

fn TestUsage(t mut crucible.T) {
	let (_, _, err) = Parse([]str{"frobnicate"})
	t.True("unknown command", err != nil)
	let (_, _, err2) = Parse([]str{"log", "-n", "x"})
	t.True("bad count", err2 != nil)
	let (_, c, err3) = Parse([]str{})
	t.NoFault("empty", err3)
	crucible.Equal(mut t, "output", commandName(c), "help")
	crucible.Equal(mut t, "output", Main([]str{"--nope"}), 2)
}

fn TestStatus(t mut crucible.T) {
	let (d, _, c2) = repo(mut t, "status")
	mut s = store.NewLoose(d + "/.tit/objects")
	mut r = open(Global{Json: false, Trace: false, Dir: d, Color: false}) catch e {
		t.Error("open: {e}")
		return
	}
	let tree = r.treeOf(c2) catch _ {
		object.NoId
	}
	mut idx = index.New()
	worktree.Checkout(mut s, r.Ws, mut idx, object.NoId, tree, false) catch e {
		t.Error("checkout: {e}")
	}
	idx.Write(r.Ws.IndexPath()) catch e {
		t.Error("write index: {e}")
	}
	crucible.Equal(mut t, "clean", runArgs(mut t, []str{"-C", d, "status"}), "Nothing to commit, the working directory matches the last commit.\n")
	quarry.WriteFile(d + "/a.txt", "hello\nthere\n") catch _ {
	}
	quarry.WriteFile(d + "/c.txt", "untracked\n") catch _ {
	}
	quarry.RemoveAll(d + "/b.txt") catch _ {
	}
	crucible.Equal(mut t, "dirty", runArgs(mut t, []str{"-C", d, "status"}), "Changed, not staged:\n  M a.txt\n  D b.txt\nUntracked:\n  c.txt\n")
	crucible.Equal(mut t, "json", runArgs(mut t, []str{"-C", d, "--json", "status"}), "{{\"staged\":[],\"unstaged\":[\"M a.txt\",\"D b.txt\"],\"untracked\":[\"c.txt\"]}}\n")
}

fn TestEmptyLog(t mut crucible.T) {
	let d = fresh("emptylog")
	_ = runArgs(mut t, []str{"init", d})
	let (g, c, perr) = Parse([]str{"-C", d, "log"})
	t.NoFault("parse", perr)
	mut o = Out{buf: []u8{}}
	mut msg = ""
	run(g, c, mut o) catch e {
		msg = fault.Message(e)
	}
	crucible.Equal(mut t, "message", msg, "the current branch has no commits yet")
}

fn TestKey(t mut crucible.T) {
	let d = fresh("key")
	let first = runArgs(mut t, []str{"key", d + "/k"})
	let again = runArgs(mut t, []str{"key", d + "/k"})
	t.True("a public key", len(first) > 40)
	crucible.Equal(mut t, "the same key", again, first)
}

// Every command has help (#788): tit help <command> and tit <command> --help print its part of the usage text.
fn TestHelpForEveryCommand(t mut crucible.T) {
	let names = []str{"init", "status", "add", "rm", "mv", "commit", "diff", "log", "show", "cat", "config", "key", "branch", "switch", "merge", "tag", "undo", "redo", "oplog", "remote", "clone", "fetch", "push", "pull", "sync", "serve", "guard", "verify", "bisect", "workspace", "workspaces", "who", "stack", "edit", "move", "split", "absorb", "rewrite", "bench", "history", "overlap", "timeline", "ship", "watch", "focus", "repack", "prune", "purge", "replay", "park", "unpark", "mirror", "adopt", "version", "help"}
	for n in names {
		let h = helpOf(n)
		t.True("help for " + n, twine.HasPrefix(h, "usage: tit "))
		let (_, c, err) = Parse([]str{n, "--help"})
		t.True(n + " --help parses", err == nil)
		t.True(n + " --help is help", commandName(c) == "help")
	}
	crucible.Equal(mut t, "no such command", helpOf("nope"), "")
}

// --json output is JSON lines whatever the command writes (#788).
fn TestJsonWraps(t mut crucible.T) {
	crucible.Equal(mut t, "objects stay", asJson("log", "{{\"a\":1}}\n{{\"b\":2}}\n"), "{{\"a\":1}}\n{{\"b\":2}}\n")
	crucible.Equal(mut t, "text is wrapped", asJson("switch", "Switched to branch \"x\".\n"), "{{\"command\":\"switch\",\"lines\":[\"Switched to branch \\\"x\\\".\"]}}\n")
	crucible.Equal(mut t, "nothing", asJson("add", ""), "")
}
