package cmd

import "fault"
import "flume"
import "policy"
import "quarry"
import "spawn"
import "tty"
import "twine"

// The tit command (#788): each subcommand is a variant of Command, parsed from the arguments; output goes to a buffer
// that is paged when it does not fit a terminal; colour only on a terminal; --json for tools; --trace times each step.

// ErrUsage is the fault of arguments the command does not take.
let ErrUsage = fault("see tit help")

// Command is one subcommand with its arguments.
type Command enum {
	Help(str)
	Version(bool)
	Init(str)
	Status(bool)
	Add([]str)
	AddPatch([]str)
	Rm(RmArgs)
	Mv(str, str)
	Commit(CommitArgs)
	Diff(DiffArgs)
	Adopt(str)
	Branch(BranchArgs)
	Switch(SwitchArgs)
	Merge(MergeArgs)
	Tag(TagArgs)
	Undo(i64, bool)
	Redo
	Oplog(OplogArgs)
	Remote([]str)
	Clone(ShareArgs)
	Fetch(ShareArgs)
	Push(ShareArgs)
	Pull(ShareArgs)
	Serve(ServeArgs)
	Mirror(str)
	Guard([]str)
	Verify(str)
	Bisect(BisectArgs)
	Workspace(WorkspaceArgs)
	Who(WhoArgs)
	Stack(StackArgs)
	Sync(ShareArgs)
	Rewrite(RewriteArgs)
	Bench(BenchArgs)
	History(HistoryArgs)
	Overlap
	Timeline(TimelineArgs)
	Ship(ShipArgs)
	Watch(WatchArgs)
	Park(str)
	Focus([]str, bool)
	Repack(bool)
	Unpark(str)
	Log(LogArgs)
	Show(str)
	Cat(str)
	ConfigGet(str)
	ConfigSet(str, str, bool)
	ConfigList
	Key(str)
}

// LogArgs are tit log's arguments.
type LogArgs struct {
	Rev     str
	Most    i64
	OneLine bool
	First   bool
	Topo    bool
	Format  str
}

// Global holds the options every command takes.
type Global struct {
	Json  bool
	Trace bool
	Dir   str
	Color bool
}

// Out is where a command writes: a buffer, paged on a terminal when it is longer than the screen.
type Out struct {
	buf []u8
}

// Line writes s and a newline.
fn (o mut Out) Line(s str) {
	o.buf = append(o.buf, s...)
	o.buf = append(o.buf, '\n')
}

// Text writes s.
fn (o mut Out) Text(s str) {
	o.buf = append(o.buf, s...)
}

// flush writes the buffer to standard output, through `less -FRX` when it is a terminal and the text is taller than it.
fn (o mut Out) flush() {
	let text = str(o.buf)
	if len(text) == 0 {
		return
	}
	if tty.IsTerminal(1) && len(quarry.Getenv("TIT_NO_PAGER")) == 0 {
		let (_, rows, err) = tty.Size(1)
		mut lines = 0
		for i in 0..len(text) {
			if text[i] == '\n' {
				lines += 1
			}
		}
		if err == nil && rows > 0 && lines >= rows {
			mut pager = quarry.Getenv("PAGER")
			if len(pager) == 0 {
				pager = "less"
			}
			mut argv = []str{pager}
			if pager == "less" {
				argv = append(argv, "-FRX")
			}
			mut p = spawn.Start(spawn.Cmd{Argv: argv, Env: spawn.Env.Inherit, Dir: "", Stdin: spawn.Stdio.Pipe, Stdout: spawn.Stdio.Inherit, Stderr: spawn.Stdio.Inherit, MaxOutput: 0}) catch _ {
				writeOut(text)
				return
			}
			_ = p.Write(text) catch _ {
				0
			}
			p.CloseStdin() catch _ {
			}
			_ = p.Wait() catch _ {
				0
			}
			return
		}
	}
	writeOut(text)
}

fn writeOut(text str) {
	mut w = flume.Stdout()
	w.Str(text)
	w.Flush() catch _ {
	}
}

const usageText = `usage: tit [-C dir] [--json] [--trace] <command> [arguments]

commands:
  init [dir]                 start a repository in dir (the current directory by default)
  status [-s]                what changed, what is staged, what is untracked (-s: two letters a file, as git's)
  add [-p] <paths>           stage files (a directory stages what is below it; . everything); -p asks hunk
                             by hunk which changes of the tracked files to stage
  rm [-r] [-f] [--cached] <paths>
                             stop tracking files and remove them (--cached keeps them on the disk)
  mv <from> <to>             move or rename a tracked file or directory
  commit [-m msg]... [-a] [--amend]
                             record the staged files (-a stages every tracked change first; without -m,
                             $EDITOR asks for the message; --amend makes a new version of the last change)
  diff [--staged] [--stat] [--word] [--semantic] [A B] [paths]
                             changes not staged yet, the staged ones, or between two revisions
  log [rev] [-n N] [--oneline] [--first-parent] [--topo] [--format=id|change|subject|git-id]
                             the history from rev (HEAD by default)
  show [rev]                 one commit and its changes
  cat <rev or id>            an object's content
  config get <key>           a setting; config set [--user] <key> <value>; config list
  key [path]                 make your signing key if there is none, and print its public half
  branch [-d|-D] [-m] [name [start]]
                             list branches, make one, delete one (-D: not merged), rename one (-m old new)
  switch [-c] [--detach] <branch or rev> [start]
                             move the working directory to a branch (-c makes it first)
  merge <rev> [-m msg] | merge --abort
                             merge a branch in: fast-forward, or a merge commit; conflicts get git's markers
  tag [-a] [-m msg] [-d] [name [rev]]
                             list tags, make one (annotated with -a or -m, signed when you have a key), delete one
  undo [--op N] [--yes]      reverse the last operation of this workspace (or operation N); undoing a push
                             puts the server's branch back, and asks for --yes first
  redo                       apply again what the last undo reversed
  oplog [show N | restore N [--yes]]
                             the operations, newest first; one in full; every ref as it was after one
  remote [add <name> <url>]  the remotes, or add one
  clone [--lazy] <url> [dir] copy a repository from a tit server (--lazy: every commit, but file contents only
                             when something reads them)
  fetch [remote]             bring a remote's new commits in (refs/remotes/<remote>/...)
  push [remote] [branch]     send a branch to a remote (origin and the current branch by default)
  pull [remote]              fetch, then merge the remote's copy of the current branch
  sync [remote]              fetch, rebase the stack onto the remote's trunk, push the branch
  serve [--addr host:port] [--public] [--allow file]
                             serve this repository over the tit protocol (keys: .tit/allowed-keys)
  guard [paths]              search the tracked files (or these) for private keys and tokens; commit runs it too
  verify [rev or range]      check every commit's signature against .tit-signers as of its parent
  bisect --run <cmd> --good <rev> [--bad <rev>]
                             find the first change where cmd fails (status 125: cannot test, skip it)
  workspace new <name> [dir] [--from rev] | workspace rm <name> | workspaces
                             another working directory on this store, with its own branch, HEAD and undo
  who <path> [-n N]          who changed this file or directory in the last N commits (500), most changes first
  stack                      the changes of this branch above the trunk (stack.trunk, main), oldest first
  edit <change>              go to a change of the stack to amend it; tit commit --amend rebases what is above
  move <change> --before|--after <change>
                             reorder the stack (what is above the move is rebased; conflicts are recorded)
  split <change> <paths> [-m msg]
                             make a new change, just below, of what the change did to these paths
  absorb                     put each uncommitted hunk into the change of the stack that wrote those lines
  rewrite [--stack|--all] <cmd>
                             run cmd on every change of the stack (or of every branch); what it leaves is each
                             change's new version, the changes above follow; one undo reverses it all
  bench record <name> <value> [--unit u] | bench log <name> | bench compare <name> <A> <B>
                             benchmark results kept with the change and the machine (macOS never against Linux)
  history <[package.]Name or Type.Method> [-n N]
                             the commits that changed one Tin declaration, following renames and moves
  overlap                    other branches (and fetched remote ones) changing the declarations this one changes
  repack [--all]             every pack into three (commits, trees, blobs), its deltas found again on every
                             core (adopt leaves several); --all repacks three packs or fewer too
  mirror [git dir or URL]    write every branch and tag into a git directory, as git objects (mirror.url); an
                             http(s) URL gets them pushed over git's smart HTTP (TIT_MIRROR_TOKEN)
  adopt [git dir]            bring a git repository in (again after new git commits: only what is new)
  ship <version> [--remote name] [--no-push] [--dry-run]
                             tag HEAD as version with the changelog since the last tag (signed when you have
                             a key), then push the branch and the tag (origin by default)
  timeline <file> [N]        the versions of a file kept before commands that change files (and by watch); N
                             puts version N back
  watch [--every ms] [--for s]
                             keep each saved version of the changed files for timeline, until interrupted
  focus [<dir>... | --all]   check out only these directories (and the files at the root); status, diff, add
                             and commit -a leave the rest as committed; --all checks out everything again
  park [name] | unpark <name>
                             put the uncommitted changes aside under a name (the branch remembered), and back
  version [-v]               the version
  help [command]             this text

Revisions: HEAD, a branch or tag, a short or full id, a change id (letters k-z), git:<hex> for an adopted git
commit, each followed by ~N or ^N.`

// Parse reads the global options and the command from the arguments (without the program name).
fn Parse(args []str) !(Global, Command) {
	mut g = Global{Json: false, Trace: false, Dir: "", Color: tty.Colors(1)}
	mut i = 0
	for i < len(args) && len(args[i]) > 0 && args[i][0] == '-' {
		let a = args[i]
		if a == "--json" {
			g.Json = true
		} else if a == "--trace" {
			g.Trace = true
		} else if a == "--no-color" {
			g.Color = false
		} else if a == "-C" && i + 1 < len(args) {
			i += 1
			g.Dir = args[i]
		} else if a == "-h" || a == "--help" {
			return g, Command.Help("")
		} else {
			fail fault.Wrap(ErrUsage, "unknown option {a}")
		}
		i += 1
	}
	if i >= len(args) {
		return g, Command.Help("")
	}
	let name = args[i]
	let rest = args[i + 1:]
	if name == "help" {
		mut topic = ""
		if len(rest) > 0 {
			topic = rest[0]
		}
		if topic == "--help" || topic == "-h" {
			topic = "help"
		}
		if len(topic) > 0 && len(helpOf(topic)) == 0 {
			fail fault.Wrap(ErrUsage, "there is no command {topic} (tit help lists them)")
		}
		return g, Command.Help(topic)
	}
	// tit <command> --help (or -h) is tit help <command>
	for a in rest {
		if (a == "--help" || a == "-h") && len(helpOf(name)) > 0 {
			return g, Command.Help(name)
		}
	}
	if name == "version" {
		return g, Command.Version(len(rest) > 0 && rest[0] == "-v")
	}
	if name == "init" {
		mut dir = "."
		if len(rest) > 0 {
			dir = rest[0]
		}
		return g, Command.Init(dir)
	}
	if name == "status" {
		mut short = false
		for a in rest {
			if a == "-s" || a == "--short" || a == "--porcelain" {
				short = true
			} else {
				fail fault.Wrap(ErrUsage, "status: unexpected {a}")
			}
		}
		return g, Command.Status(short)
	}
	if name == "add" {
		mut paths = []str{}
		mut patch = false
		for a in rest {
			if a == "-p" || a == "--patch" {
				patch = true
			} else {
				paths = append(paths, a)
			}
		}
		if patch {
			return g, Command.AddPatch(paths)
		}
		return g, Command.Add(paths)
	}
	if name == "rm" {
		mut ra = RmArgs{Paths: []str{}, Cached: false, Recursive: false, Force: false}
		for a in rest {
			if a == "--cached" {
				ra.Cached = true
			} else if a == "-r" {
				ra.Recursive = true
			} else if a == "-f" || a == "--force" {
				ra.Force = true
			} else if a == "-rf" || a == "-fr" {
				ra.Recursive = true
				ra.Force = true
			} else if len(a) > 1 && a[0] == '-' {
				fail fault.Wrap(ErrUsage, "rm: unknown option {a}")
			} else {
				ra.Paths = append(ra.Paths, a)
			}
		}
		return g, Command.Rm(ra)
	}
	if name == "mv" {
		if len(rest) != 2 {
			fail fault.Wrap(ErrUsage, "mv takes a path and where it goes")
		}
		return g, Command.Mv(rest[0], rest[1])
	}
	if name == "commit" {
		mut ca = CommitArgs{Messages: []str{}, All: false, Amend: false}
		mut k = 0
		for k < len(rest) {
			let a = rest[k]
			if (a == "-m" || a == "--message") && k + 1 < len(rest) {
				k += 1
				ca.Messages = append(ca.Messages, rest[k])
			} else if a == "-a" || a == "--all" {
				ca.All = true
			} else if a == "--amend" {
				ca.Amend = true
			} else if a == "-am" && k + 1 < len(rest) {
				k += 1
				ca.All = true
				ca.Messages = append(ca.Messages, rest[k])
			} else {
				fail fault.Wrap(ErrUsage, "commit: unexpected {a}")
			}
			k += 1
		}
		return g, Command.Commit(ca)
	}
	if name == "diff" {
		mut da = DiffArgs{Word: false, Semantic: false, Staged: false, Stat: false, Revs: []str{}, Paths: []str{}}
		mut paths = false
		for a in rest {
			if paths {
				da.Paths = append(da.Paths, a)
			} else if a == "--" {
				paths = true
			} else if a == "--staged" || a == "--cached" {
				da.Staged = true
			} else if a == "--stat" {
				da.Stat = true
			} else if a == "--semantic" {
				da.Semantic = true
			} else if a == "--word" || a == "--word-diff" || a == "--word-diff=plain" {
				da.Word = true
			} else if len(a) > 1 && a[0] == '-' {
				fail fault.Wrap(ErrUsage, "diff: unknown option {a}")
			} else if isPath(g, a) {
				da.Paths = append(da.Paths, a)
			} else {
				da.Revs = append(da.Revs, a)
			}
		}
		return g, Command.Diff(da)
	}
	if name == "log" {
		mut la = LogArgs{Rev: "HEAD", Most: 0, OneLine: false, First: false, Topo: false, Format: ""}
		mut k = 0
		for k < len(rest) {
			let a = rest[k]
			if a == "-n" && k + 1 < len(rest) {
				k += 1
				la.Most = parseCount(rest[k]) catch _ {
					-1
				}
				if la.Most < 0 {
					fail fault.Wrap(ErrUsage, "log: -n takes a number")
				}
			} else if a == "--oneline" {
				la.OneLine = true
			} else if a == "--first-parent" {
				la.First = true
			} else if a == "--topo" {
				la.Topo = true
			} else if twine.HasPrefix(a, "--format=") {
				la.Format = a[9:]
				if la.Format != "git-id" && la.Format != "id" && la.Format != "change" && la.Format != "subject" {
					fail fault.Wrap(ErrUsage, "log: --format takes id, change, subject or git-id")
				}
			} else if len(a) > 0 && a[0] == '-' {
				fail fault.Wrap(ErrUsage, "log: unknown option {a}")
			} else {
				la.Rev = a
			}
			k += 1
		}
		return g, Command.Log(la)
	}
	if name == "show" {
		mut rev = "HEAD"
		if len(rest) > 0 {
			rev = rest[0]
		}
		return g, Command.Show(rev)
	}
	if name == "cat" {
		if len(rest) != 1 {
			fail fault.Wrap(ErrUsage, "cat takes one revision or id")
		}
		return g, Command.Cat(rest[0])
	}
	if name == "config" {
		if len(rest) == 0 || rest[0] == "list" {
			return g, Command.ConfigList
		}
		if rest[0] == "get" && len(rest) == 2 {
			return g, Command.ConfigGet(rest[1])
		}
		if rest[0] == "set" && len(rest) == 3 {
			return g, Command.ConfigSet(rest[1], rest[2], false)
		}
		if rest[0] == "set" && len(rest) == 4 && rest[1] == "--user" {
			return g, Command.ConfigSet(rest[2], rest[3], true)
		}
		fail fault.Wrap(ErrUsage, "config get <key> | config set [--user] <key> <value> | config list")
	}
	if name == "branch" {
		mut ba = BranchArgs{Delete: false, Force: false, Rename: false, Names: []str{}}
		for a in rest {
			if a == "-d" || a == "--delete" {
				ba.Delete = true
			} else if a == "-D" {
				ba.Delete = true
				ba.Force = true
			} else if a == "-m" || a == "--move" {
				ba.Rename = true
			} else if len(a) > 1 && a[0] == '-' {
				fail fault.Wrap(ErrUsage, "branch: unknown option {a}")
			} else {
				ba.Names = append(ba.Names, a)
			}
		}
		return g, Command.Branch(ba)
	}
	if name == "switch" {
		mut sa = SwitchArgs{Create: false, Detach: false, Target: "", Start: "HEAD"}
		mut pos = []str{}
		for a in rest {
			if a == "-c" || a == "--create" {
				sa.Create = true
			} else if a == "--detach" || a == "-d" {
				sa.Detach = true
			} else if len(a) > 1 && a[0] == '-' {
				fail fault.Wrap(ErrUsage, "switch: unknown option {a}")
			} else {
				pos = append(pos, a)
			}
		}
		if len(pos) == 0 || len(pos) > 2 || (len(pos) == 2 && !sa.Create) {
			fail fault.Wrap(ErrUsage, "switch takes a branch (switch -c takes a new name and where it starts)")
		}
		sa.Target = pos[0]
		if len(pos) == 2 {
			sa.Start = pos[1]
		}
		return g, Command.Switch(sa)
	}
	if name == "merge" {
		mut ma = MergeArgs{Rev: "", Abort: false, Message: ""}
		mut k = 0
		for k < len(rest) {
			let a = rest[k]
			if a == "--abort" {
				ma.Abort = true
			} else if a == "-m" && k + 1 < len(rest) {
				k += 1
				ma.Message = rest[k]
			} else if a == "--no-edit" {
			} else if len(a) > 1 && a[0] == '-' {
				fail fault.Wrap(ErrUsage, "merge: unknown option {a}")
			} else {
				ma.Rev = a
			}
			k += 1
		}
		if !ma.Abort && len(ma.Rev) == 0 {
			fail fault.Wrap(ErrUsage, "merge takes what to merge, or --abort")
		}
		return g, Command.Merge(ma)
	}
	if name == "tag" {
		mut ta = TagArgs{Delete: false, Annotated: false, Message: "", Names: []str{}}
		mut k = 0
		for k < len(rest) {
			let a = rest[k]
			if a == "-d" || a == "--delete" {
				ta.Delete = true
			} else if a == "-a" || a == "--annotate" || a == "-s" {
				ta.Annotated = true
			} else if a == "-m" && k + 1 < len(rest) {
				k += 1
				ta.Message = rest[k]
			} else if len(a) > 1 && a[0] == '-' {
				fail fault.Wrap(ErrUsage, "tag: unknown option {a}")
			} else {
				ta.Names = append(ta.Names, a)
			}
			k += 1
		}
		if ta.Annotated && len(ta.Message) == 0 {
			fail fault.Wrap(ErrUsage, "tag -a takes -m and the message")
		}
		return g, Command.Tag(ta)
	}
	if name == "undo" {
		mut n = 0
		mut yes = false
		mut k = 0
		for k < len(rest) {
			if rest[k] == "--op" && k + 1 < len(rest) {
				n = try parseOp(rest[k + 1])
				k += 2
			} else if rest[k] == "--yes" {
				yes = true
				k += 1
			} else {
				fail fault.Wrap(ErrUsage, "undo takes nothing, --op N, or --yes (to undo a push on the server)")
			}
		}
		return g, Command.Undo(n, yes)
	}
	if name == "redo" {
		try noMore(rest, 0, "redo")
		return g, Command.Redo
	}
	if name == "oplog" {
		mut oa = OplogArgs{Action: "list", N: 0, Yes: false}
		if len(rest) > 0 {
			if (rest[0] == "show" || rest[0] == "restore") && len(rest) >= 2 {
				oa.Action = rest[0]
				oa.N = try parseOp(rest[1])
				for a in rest[2:] {
					if a == "--yes" && oa.Action == "restore" {
						oa.Yes = true
					} else {
						fail fault.Wrap(ErrUsage, "oplog: unexpected {a}")
					}
				}
			} else {
				fail fault.Wrap(ErrUsage, "oplog | oplog show N | oplog restore N [--yes]")
			}
		}
		return g, Command.Oplog(oa)
	}
	if name == "remote" {
		mut ra = []str{}
		for a in rest {
			ra = append(ra, a)
		}
		return g, Command.Remote(ra)
	}
	if name == "clone" {
		mut pos = []str{}
		mut lazy = false
		for a in rest {
			if a == "--lazy" {
				lazy = true
			} else {
				pos = append(pos, a)
			}
		}
		if len(pos) == 0 || len(pos) > 2 {
			fail fault.Wrap(ErrUsage, "clone [--lazy] takes a URL and, if you like, a directory")
		}
		mut dir = ""
		if len(pos) == 2 {
			dir = pos[1]
		}
		return g, Command.Clone(ShareArgs{Remote: pos[0], Branch: "", Dir: dir, Lease: false, Lazy: lazy})
	}
	if name == "sync" {
		mut sa = ShareArgs{Remote: "origin", Branch: "", Dir: "", Lease: true, Lazy: false}
		if len(rest) == 1 {
			sa.Remote = rest[0]
		} else if len(rest) > 1 {
			fail fault.Wrap(ErrUsage, "sync takes a remote")
		}
		return g, Command.Sync(sa)
	}
	if name == "fetch" || name == "pull" || name == "push" {
		mut sa = ShareArgs{Remote: "origin", Branch: "", Dir: "", Lease: false, Lazy: false}
		if len(rest) > 0 {
			sa.Remote = rest[0]
		}
		if len(rest) > 1 && name == "push" {
			sa.Branch = rest[1]
		}
		if len(rest) > 2 || (len(rest) > 1 && name != "push") {
			fail fault.Wrap(ErrUsage, "{name}: unexpected {rest[len(rest) - 1]}")
		}
		if name == "fetch" {
			return g, Command.Fetch(sa)
		}
		if name == "pull" {
			return g, Command.Pull(sa)
		}
		return g, Command.Push(sa)
	}
	if name == "serve" {
		mut va = ServeArgs{Addr: "127.0.0.1:8740", Public: false, Allow: ""}
		mut k = 0
		for k < len(rest) {
			let a = rest[k]
			if a == "--addr" && k + 1 < len(rest) {
				k += 1
				va.Addr = rest[k]
			} else if a == "--public" {
				va.Public = true
			} else if a == "--allow" && k + 1 < len(rest) {
				k += 1
				va.Allow = rest[k]
			} else {
				fail fault.Wrap(ErrUsage, "serve: unexpected {a}")
			}
			k += 1
		}
		return g, Command.Serve(va)
	}
	if name == "guard" {
		mut ps = []str{}
		for a in rest {
			ps = append(ps, a)
		}
		return g, Command.Guard(ps)
	}
	if name == "verify" {
		mut rev = "HEAD"
		if len(rest) == 1 {
			rev = rest[0]
		} else if len(rest) > 1 {
			fail fault.Wrap(ErrUsage, "verify takes a revision or a range")
		}
		return g, Command.Verify(rev)
	}
	if name == "bisect" {
		mut ba = BisectArgs{Run: "", Good: "", Bad: ""}
		mut k = 0
		for k < len(rest) {
			let a = rest[k]
			if a == "--run" && k + 1 < len(rest) {
				k += 1
				ba.Run = rest[k]
			} else if a == "--good" && k + 1 < len(rest) {
				k += 1
				ba.Good = rest[k]
			} else if a == "--bad" && k + 1 < len(rest) {
				k += 1
				ba.Bad = rest[k]
			} else {
				fail fault.Wrap(ErrUsage, "bisect: unexpected {a}")
			}
			k += 1
		}
		if len(ba.Run) == 0 || len(ba.Good) == 0 {
			fail fault.Wrap(ErrUsage, "bisect takes --run <command> and --good <rev> (and --bad <rev>, HEAD by default)")
		}
		return g, Command.Bisect(ba)
	}
	if name == "workspaces" {
		try noMore(rest, 0, "workspaces")
		return g, Command.Workspace(WorkspaceArgs{Action: "list", Name: "", Dir: "", From: ""})
	}
	if name == "workspace" {
		mut wa = WorkspaceArgs{Action: "", Name: "", Dir: "", From: ""}
		mut pos = []str{}
		mut k = 0
		for k < len(rest) {
			let a = rest[k]
			if a == "--from" && k + 1 < len(rest) {
				k += 1
				wa.From = rest[k]
			} else if len(a) > 1 && a[0] == '-' {
				fail fault.Wrap(ErrUsage, "workspace: unknown option {a}")
			} else {
				pos = append(pos, a)
			}
			k += 1
		}
		if len(pos) == 0 || pos[0] == "list" {
			wa.Action = "list"
		} else if (pos[0] == "new" && (len(pos) == 2 || len(pos) == 3)) || (pos[0] == "rm" && len(pos) == 2) {
			wa.Action = pos[0]
			wa.Name = pos[1]
			if len(pos) == 3 {
				wa.Dir = pos[2]
			}
		} else {
			fail fault.Wrap(ErrUsage, "workspace new <name> [dir] [--from rev] | workspace rm <name> | workspaces")
		}
		return g, Command.Workspace(wa)
	}
	if name == "who" {
		mut wh = WhoArgs{Path: "", Most: 500}
		mut k = 0
		for k < len(rest) {
			let a = rest[k]
			if a == "-n" && k + 1 < len(rest) {
				k += 1
				wh.Most = parseCount(rest[k]) catch _ {
					-1
				}
				if wh.Most <= 0 {
					fail fault.Wrap(ErrUsage, "who: -n takes a number")
				}
			} else if len(wh.Path) == 0 {
				wh.Path = a
			} else {
				fail fault.Wrap(ErrUsage, "who takes one path")
			}
			k += 1
		}
		if len(wh.Path) == 0 {
			fail fault.Wrap(ErrUsage, "who takes a path")
		}
		return g, Command.Who(wh)
	}
	if name == "stack" {
		try noMore(rest, 0, "stack")
		return g, Command.Stack(StackArgs{Action: "list", Change: "", Other: "", Before: false, Paths: []str{}, Message: ""})
	}
	if name == "absorb" {
		try noMore(rest, 0, "absorb")
		return g, Command.Stack(StackArgs{Action: "absorb", Change: "", Other: "", Before: false, Paths: []str{}, Message: ""})
	}
	if name == "edit" {
		if len(rest) != 1 {
			fail fault.Wrap(ErrUsage, "edit takes a change of the stack")
		}
		return g, Command.Stack(StackArgs{Action: "edit", Change: rest[0], Other: "", Before: false, Paths: []str{}, Message: ""})
	}
	if name == "move" {
		if len(rest) != 3 || (rest[1] != "--before" && rest[1] != "--after") {
			fail fault.Wrap(ErrUsage, "move <change> --before|--after <change>")
		}
		return g, Command.Stack(StackArgs{Action: "move", Change: rest[0], Other: rest[2], Before: rest[1] == "--before", Paths: []str{}, Message: ""})
	}
	if name == "split" {
		mut sa = StackArgs{Action: "split", Change: "", Other: "", Before: false, Paths: []str{}, Message: ""}
		mut k = 0
		for k < len(rest) {
			if rest[k] == "-m" && k + 1 < len(rest) {
				k += 1
				sa.Message = rest[k]
			} else if len(sa.Change) == 0 {
				sa.Change = rest[k]
			} else {
				sa.Paths = append(sa.Paths, rest[k])
			}
			k += 1
		}
		if len(sa.Change) == 0 || len(sa.Paths) == 0 {
			fail fault.Wrap(ErrUsage, "split <change> <paths> [-m msg]")
		}
		return g, Command.Stack(sa)
	}
	if name == "rewrite" {
		mut ra = RewriteArgs{Command: "", Branches: false}
		for a in rest {
			if a == "--all" || a == "--branches" {
				ra.Branches = true
			} else if a == "--stack" {
				ra.Branches = false
			} else if len(ra.Command) == 0 {
				ra.Command = a
			} else {
				fail fault.Wrap(ErrUsage, "rewrite takes one command (quote it)")
			}
		}
		if len(ra.Command) == 0 {
			fail fault.Wrap(ErrUsage, "rewrite [--stack|--all] <command>")
		}
		return g, Command.Rewrite(ra)
	}
	if name == "bench" {
		mut ba = BenchArgs{Action: "", Name: "", Value: "", Unit: "", A: "", B: ""}
		mut pos = []str{}
		mut k = 0
		for k < len(rest) {
			if rest[k] == "--unit" && k + 1 < len(rest) {
				k += 1
				ba.Unit = rest[k]
			} else {
				pos = append(pos, rest[k])
			}
			k += 1
		}
		if len(pos) == 3 && pos[0] == "record" {
			ba.Action = "record"
			ba.Name = pos[1]
			ba.Value = pos[2]
		} else if len(pos) == 2 && pos[0] == "log" {
			ba.Action = "log"
			ba.Name = pos[1]
		} else if len(pos) == 4 && pos[0] == "compare" {
			ba.Action = "compare"
			ba.Name = pos[1]
			ba.A = pos[2]
			ba.B = pos[3]
		} else {
			fail fault.Wrap(ErrUsage, "bench record <name> <value> [--unit u] | bench log <name> | bench compare <name> <A> <B>")
		}
		return g, Command.Bench(ba)
	}
	if name == "ship" {
		mut sa = ShipArgs{Version: "", Remote: "origin", Push: true, DryRun: false}
		mut k = 0
		for k < len(rest) {
			if rest[k] == "--remote" && k + 1 < len(rest) {
				sa.Remote = rest[k + 1]
				k += 1
			} else if rest[k] == "--no-push" {
				sa.Push = false
			} else if rest[k] == "--dry-run" {
				sa.DryRun = true
			} else if len(sa.Version) == 0 && !twine.HasPrefix(rest[k], "-") {
				sa.Version = rest[k]
			} else {
				fail fault.Wrap(ErrUsage, "ship <version> [--remote name] [--no-push] [--dry-run]")
			}
			k += 1
		}
		if len(sa.Version) == 0 {
			fail fault.Wrap(ErrUsage, "ship <version> [--remote name] [--no-push] [--dry-run]")
		}
		return g, Command.Ship(sa)
	}
	if name == "timeline" {
		mut ta = TimelineArgs{Path: "", Pick: 0}
		if len(rest) < 1 || len(rest) > 2 {
			fail fault.Wrap(ErrUsage, "timeline <file> [N]")
		}
		ta.Path = rest[0]
		if len(rest) == 2 {
			ta.Pick = parseCount(rest[1]) catch _ {
				-1
			}
			if ta.Pick <= 0 {
				fail fault.Wrap(ErrUsage, "timeline: N is a version's number in the list")
			}
		}
		return g, Command.Timeline(ta)
	}
	if name == "watch" {
		mut wa = WatchArgs{Every: 1000, For: 0}
		mut k = 0
		for k < len(rest) {
			if (rest[k] == "--every" || rest[k] == "--for") && k + 1 < len(rest) {
				let n = parseCount(rest[k + 1]) catch _ {
					-1
				}
				if n <= 0 {
					fail fault.Wrap(ErrUsage, "watch: {rest[k]} takes a number")
				}
				if rest[k] == "--every" {
					wa.Every = n
				} else {
					wa.For = n
				}
				k += 2
				continue
			}
			fail fault.Wrap(ErrUsage, "watch [--every ms] [--for seconds]")
		}
		return g, Command.Watch(wa)
	}
	if name == "repack" {
		// --all: repack even three packs or fewer, their deltas searched again (bench/tit measures packing with it)
		if len(rest) == 1 && rest[0] == "--all" {
			return g, Command.Repack(true)
		}
		try noMore(rest, 0, "repack")
		return g, Command.Repack(false)
	}
	if name == "focus" {
		mut dirs = []str{}
		mut all = false
		for a in rest {
			if a == "--all" {
				all = true
			} else {
				dirs = append(dirs, a)
			}
		}
		if all && len(dirs) > 0 {
			fail fault.Wrap(ErrUsage, "focus <dir>... | focus --all")
		}
		return g, Command.Focus(dirs, all)
	}
	if name == "park" || name == "unpark" {
		if len(rest) > 1 || (name == "unpark" && len(rest) == 0) {
			fail fault.Wrap(ErrUsage, "park [name] | unpark <name>")
		}
		mut n = ""
		if len(rest) == 1 {
			n = rest[0]
		}
		if name == "park" {
			return g, Command.Park(n)
		}
		return g, Command.Unpark(n)
	}
	if name == "history" {
		mut ha = HistoryArgs{Name: "", Most: 0}
		mut k = 0
		for k < len(rest) {
			if rest[k] == "-n" && k + 1 < len(rest) {
				k += 1
				ha.Most = parseCount(rest[k]) catch _ {
					-1
				}
				if ha.Most <= 0 {
					fail fault.Wrap(ErrUsage, "history: -n takes a number")
				}
			} else if len(ha.Name) == 0 {
				ha.Name = rest[k]
			} else {
				fail fault.Wrap(ErrUsage, "history takes one declaration")
			}
			k += 1
		}
		if len(ha.Name) == 0 {
			fail fault.Wrap(ErrUsage, "history takes a declaration: Name, Type.Method or package.Name")
		}
		return g, Command.History(ha)
	}
	if name == "overlap" {
		try noMore(rest, 0, "overlap")
		return g, Command.Overlap
	}
	if name == "mirror" {
		mut path = ""
		if len(rest) == 1 {
			path = rest[0]
		} else if len(rest) > 1 {
			fail fault.Wrap(ErrUsage, "mirror takes one git directory")
		}
		return g, Command.Mirror(path)
	}
	if name == "adopt" {
		mut path = ""
		if len(rest) > 0 {
			path = rest[0]
		}
		return g, Command.Adopt(path)
	}
	if name == "key" {
		mut path = ""
		if len(rest) > 0 {
			path = rest[0]
		}
		return g, Command.Key(path)
	}
	fail fault.Wrap(ErrUsage, "unknown command {name}")
}

// isPath reports whether a diff argument names a file or directory, rather than a revision.
fn isPath(g Global, a str) bool {
	mut base = g.Dir
	if len(base) == 0 {
		base = quarry.Getwd() catch _ {
			"."
		}
	}
	if a[0] == '/' {
		return quarry.Exists(a)
	}
	return quarry.Exists(base + "/" + a)
}

fn noMore(rest []str, n i64, name str) ! {
	if len(rest) > n {
		fail fault.Wrap(ErrUsage, "{name}: unexpected {rest[n]}")
	}
}

fn parseCount(s str) !i64 {
	mut n = 0
	if len(s) == 0 {
		fail ErrUsage
	}
	for i in 0..len(s) {
		if s[i] < '0' || s[i] > '9' {
			fail ErrUsage
		}
		n = n * 10 + i64(s[i] - '0')
	}
	return n
}

// helpOf is one command's part of the usage text: its line or lines (a line that names it first, or after a |), with
// the lines that continue them; "" when no command has that name.
fn helpOf(name str) str {
	mut out = ""
	mut taking = false
	for line in twine.Split(usageText, "\n") {
		if twine.HasPrefix(line, "   ") && taking {
			out = out + line + "\n"
			continue
		}
		taking = false
		if !twine.HasPrefix(line, "  ") || twine.HasPrefix(line, "   ") {
			continue
		}
		let head = twine.TrimSpace(twine.SplitN(line[2:], "  ", 2)[0])
		for part in twine.Split(head, "|") {
			let words = twine.Split(twine.TrimSpace(part), " ")
			if len(words) > 0 && words[0] == name {
				taking = true
			}
		}
		if taking {
			out = out + "usage: tit " + twine.TrimSpace(line) + "\n"
		}
	}
	return out
}

// Main runs the command line and returns the exit status: 0, 1 for a failure, 2 for a usage error.
fn Main(args []str) i64 {
	let (g, c, perr) = Parse(args)
	if perr != nil {
		quarry.Eprintln("tit: " + fault.Message(perr))
		return 2
	}
	mut o = Out{buf: []u8{}}
	let err = run(g, c, mut o)
	o.flush()
	if err != nil {
		quarry.Eprintln("tit: " + fault.Message(err))
		if fault.Is(err, ErrUsage) {
			return 2
		}
		return 1
	}
	return 0
}

fn run(g Global, c Command, o mut Out) ! {
	// files a command may change are kept first, for tit timeline (snapshot.tin)
	try snapshotFor(g, c)
	if !g.Json {
		try runTraced(g, c, mut o)
		return
	}
	// --json: what a command writes is JSON lines; a command that writes text gets it as one object's lines
	mut b = Out{buf: []u8{}}
	let err = runTraced(g, c, mut b)
	o.Text(asJson(commandName(c), str(b.buf)))
	if err != nil {
		fail err
	}
}

// asJson is a command's output under --json: as it is when every line is a JSON object, otherwise
// {"command": name, "lines": [...]}.
fn asJson(name str, text str) str {
	let lines = twine.Split(twine.TrimRight(text, "\n"), "\n")
	mut json = true
	mut kept = []str{}
	for l in lines {
		if len(l) == 0 {
			continue
		}
		kept = append(kept, l)
		if l[0] != '{' {
			json = false
		}
	}
	if json {
		return text
	}
	return jsonObject([]str{"command", jsonStr(name), "lines", jsonList(kept)}) + "\n"
}

fn runTraced(g Global, c Command, o mut Out) ! {
	if g.Trace {
		let name = commandName(c)
		// the traced block writes to its own buffer: a function literal cannot hold the mut parameter
		let (text, terr) = with policy.Trace[[]u8]("tit " + name) {
			mut b = Out{buf: []u8{}}
			try dispatch(g, c, mut b)
			b.buf
		}
		if terr != nil {
			fail terr
		}
		o.buf = append(o.buf, text...)
		return
	}
	try dispatch(g, c, mut o)
}

fn commandName(c Command) str {
	return match c {
		Help(_) => "help"
		Version(_) => "version"
		Init(_) => "init"
		Status(_) => "status"
		Add(_) => "add"
		AddPatch(_) => "add"
		Rm(_) => "rm"
		Mv(_, _) => "mv"
		Commit(_) => "commit"
		Diff(_) => "diff"
		Adopt(_) => "adopt"
		Branch(_) => "branch"
		Switch(_) => "switch"
		Merge(_) => "merge"
		Tag(_) => "tag"
		Undo(_, _) => "undo"
		Redo => "redo"
		Oplog(_) => "oplog"
		Remote(_) => "remote"
		Clone(_) => "clone"
		Fetch(_) => "fetch"
		Push(_) => "push"
		Pull(_) => "pull"
		Serve(_) => "serve"
		Mirror(_) => "mirror"
		Guard(_) => "guard"
		Verify(_) => "verify"
		Bisect(_) => "bisect"
		Workspace(_) => "workspace"
		Who(_) => "who"
		Stack(sa) => sa.Action
		Sync(_) => "sync"
		Rewrite(_) => "rewrite"
		Bench(_) => "bench"
		History(_) => "history"
		Overlap => "overlap"
		Timeline(_) => "timeline"
		Ship(_) => "ship"
		Watch(_) => "watch"
		Park(_) => "park"
		Focus(_, _) => "focus"
		Repack(_) => "repack"
		Unpark(_) => "unpark"
		Log(_) => "log"
		Show(_) => "show"
		Cat(_) => "cat"
		ConfigGet(_) => "config"
		ConfigSet(_, _, _) => "config"
		ConfigList => "config"
		Key(_) => "key"
	}
}

fn dispatch(g Global, c Command, o mut Out) ! {
	match c {
		Help(topic) => {
			if len(topic) == 0 {
				o.Line(usageText)
			} else {
				o.Text(helpOf(topic))
				o.Line("")
				o.Line("Every command also takes the global flags: -C dir, --json, --trace. The manual: toolchain/docs/TIT.md.")
			}
		}
		Version(verbose) => {
			o.Line("tit 0 (design/tit.md, #769)")
			if verbose {
				for f in sentinels() {
					o.Line("  " + f)
				}
			}
		}
		Init(dir) => {
			try doInit(g, dir, mut o)
		}
		Status(short) => {
			try doStatus(g, short, mut o)
		}
		Add(paths) => {
			try doAdd(g, paths, mut o)
		}
		AddPatch(paths) => {
			try doAddPatch(g, paths, mut o)
		}
		Rm(ra) => {
			try doRm(g, ra, mut o)
		}
		Mv(from, to) => {
			try doMv(g, from, to, mut o)
		}
		Commit(ca) => {
			try doCommit(g, ca, mut o)
		}
		Diff(da) => {
			try doDiff(g, da, mut o)
		}
		Adopt(path) => {
			try doAdopt(g, path, mut o)
		}
		Branch(ba) => {
			try doBranch(g, ba, mut o)
		}
		Switch(sa) => {
			try doSwitch(g, sa, mut o)
		}
		Merge(ma) => {
			try doMerge(g, ma, mut o)
		}
		Tag(ta) => {
			try doTag(g, ta, mut o)
		}
		Undo(n, yes) => {
			try doUndo(g, n, yes, mut o)
		}
		Redo => {
			try doRedo(g, mut o)
		}
		Oplog(oa) => {
			try doOplog(g, oa, mut o)
		}
		Remote(ra) => {
			try doRemote(g, ra, mut o)
		}
		Clone(sa) => {
			try doClone(g, sa, mut o)
		}
		Fetch(sa) => {
			try doFetch(g, sa, mut o)
		}
		Push(sa) => {
			try doPush(g, sa, mut o)
		}
		Pull(sa) => {
			try doPull(g, sa, mut o)
		}
		Serve(va) => {
			try doServe(g, va, mut o)
		}
		Mirror(path) => {
			try doMirror(g, path, mut o)
		}
		Guard(ps) => {
			try doGuard(g, ps, mut o)
		}
		Verify(rev) => {
			try doVerify(g, rev, mut o)
		}
		Bisect(ba) => {
			try doBisect(g, ba, mut o)
		}
		Workspace(wa) => {
			try doWorkspace(g, wa, mut o)
		}
		Who(wh) => {
			try doWho(g, wh, mut o)
		}
		Stack(sa) => {
			try doStack(g, sa, mut o)
		}
		Sync(sa) => {
			try doSync(g, sa, mut o)
		}
		Rewrite(ra) => {
			try doRewrite(g, ra, mut o)
		}
		Bench(ba) => {
			try doBench(g, ba, mut o)
		}
		History(ha) => {
			try doHistory(g, ha, mut o)
		}
		Overlap => {
			try doOverlap(g, mut o)
		}
		Timeline(ta) => {
			try doTimeline(g, ta, mut o)
		}
		Ship(sa) => {
			try doShip(g, sa, mut o)
		}
		Watch(wa) => {
			try doWatch(g, wa, mut o)
		}
		Park(name) => {
			try doPark(g, name, mut o)
		}
		Focus(dirs, all) => {
			try doFocus(g, dirs, all, mut o)
		}
		Repack(all) => {
			try doRepack(g, all, mut o)
		}
		Unpark(name) => {
			try doUnpark(g, name, mut o)
		}
		Log(la) => {
			try doLog(g, la, mut o)
		}
		Show(rev) => {
			try doShow(g, rev, mut o)
		}
		Cat(rev) => {
			try doCat(g, rev, mut o)
		}
		ConfigGet(key) => {
			try doConfigGet(g, key, mut o)
		}
		ConfigSet(key, value, user) => {
			try doConfigSet(g, key, value, user, mut o)
		}
		ConfigList => {
			try doConfigList(g, mut o)
		}
		Key(path) => {
			try doKey(g, path, mut o)
		}
	}
}

fn paint(g Global, code str, s str) str {
	return tty.Paint(g.Color && !g.Json, code, s)
}

fn joinWords(xs []str) str {
	return twine.Join(xs, " ")
}
