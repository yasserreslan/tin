package cmd

import "../change"
import "../git"
import "../identity"
import "../object"
import "fault"
import "quarry"
import "tty"
import "twine"

// tit mirror (#805): every branch and tag written into a git directory as git objects and refs, in the fixed
// encoding of git/mirror.tin, so git can push them on (to GitHub, until the cutover).

// mirrorBudget is about how many bytes one batch reads before its pairs of ids are recorded.
const mirrorBudget = 8 * 1024 * 1024

fn doMirror(g Global, path str, o mut Out) ! {
	mut r = try open(g)
	use lock = change.Lock(r.Ws.Store)
	let cfg = try r.config()
	mut gitDir = path
	if len(gitDir) == 0 {
		let configured = cfg.Get("mirror.url")
		if configured == nil {
			fail fault.Wrap(ErrUsage, "mirror takes a git directory (or set mirror.url)")
		}
		gitDir = configured
	} else if cfg.Get("mirror.url") == nil {
		try identity.Set(r.Ws.Store + "/config", "mirror.url", gitDir)
	}
	// a git server over HTTP(S): the objects go into a git directory of tit's own first, then are pushed from there
	mut pushTo = ""
	if twine.HasPrefix(gitDir, "http://") || twine.HasPrefix(gitDir, "https://") {
		pushTo = gitDir
		gitDir = r.Ws.Store + "/mirror.git"
		try bareGit(gitDir)
	}
	let target = try git.Open(gitDir)
	let idsPath = r.Ws.Store + "/git-ids"
	mut ids = try git.ReadIds(idsPath)
	mut back = git.BackOf(ids)
	// the branches and tags, by their tit ids
	let refs = change.NewRefs(r.Ws.Store)
	let all = try refs.List("refs/")
	mut names = []str{}
	mut tips = []object.Id{}
	for ref in all {
		if !twine.HasPrefix(ref.Name, "refs/heads/") && !twine.HasPrefix(ref.Name, "refs/tags/") {
			continue
		}
		match ref.Target {
			Commit(id) => {
				names = append(names, ref.Name)
				tips = append(tips, id)
			}
			Change(_) => {
			}
		}
	}
	let order = try git.MirrorPlan(mut r.Store, target, back, tips)
	let shown = tty.IsTerminal(2) && !g.Json
	let store = r.Ws.Store
	mut written = 0
	mut i = 0
	for i < len(order) {
		let start = i
		let b = try arena {
			try git.MirrorBatch(store, gitDir, back, order, start, mirrorBudget)
		}
		for k in 0..len(b.Git) {
			ids.Set(b.Git[k], b.Tit[k])
			back.Set(b.Tit[k], b.Git[k])
		}
		written += len(b.Git)
		_ = try arena {
			try git.WriteIds(idsPath, ids)
			0
		}
		i = b.Next
		if shown {
			quarry.Eprint("\rmirror: {i} of {len(order)} commits and tags")
		}
	}
	if shown && len(order) > 0 {
		quarry.Eprint("\n")
	}
	for k in 0..len(names) {
		let gid = back.Git(tips[k].Bytes())
		if len(gid) == 0 {
			fail "{names[k]} has no git id after mirroring"
		}
		try git.WriteRef(gitDir, names[k], gid)
	}
	let current = try currentBranch(r)
	if len(current) > 0 {
		try git.PointHead(gitDir, current)
	}
	if len(pushTo) == 0 {
		o.Line("Mirrored " + count(written, "object", "objects") + " into " + target.CommonDir + "; " + count(len(names), "ref", "refs") + " written.")
		return
	}
	mut updates = []git.RefPush{}
	for k in 0..len(names) {
		updates = append(updates, git.RefPush{Name: names[k], New: back.Git(tips[k].Bytes())})
	}
	let pushed = try git.Open(gitDir)
	let (moved, sent) = try git.PushHttp(pushed, pushTo, quarry.Getenv("TIT_MIRROR_TOKEN"), updates)
	if moved == 0 {
		o.Line("Everything is mirrored: " + pushTo + " holds every branch and tag already.")
		return
	}
	o.Line("Mirrored to " + pushTo + ": " + count(moved, "ref", "refs") + " moved, " + count(sent, "object", "objects") + " sent.")
}

// bareGit makes an empty bare git directory at dir, unless there is one.
fn bareGit(dir str) ! {
	if quarry.Exists(dir + "/HEAD") {
		return
	}
	try quarry.MkdirAll(dir + "/objects")
	try quarry.MkdirAll(dir + "/refs/heads")
	try quarry.MkdirAll(dir + "/refs/tags")
	try quarry.WriteFile(dir + "/config", "[core]\n\trepositoryformatversion = 0\n\tbare = true\n")
	try quarry.WriteFile(dir + "/HEAD", "ref: refs/heads/main\n")
}
