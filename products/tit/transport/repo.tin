package transport

import "../change"
import "../object"
import "../packfile"
import "../store"

// The repository a server serves (design/tit.md §16, #1003): tit serve's is a .tit directory (DirRepo, #1006),
// tinhub's keeps refs and change versions in Postgres and packs in its pack store. A pack is pending (Stage), live
// (Commit) or retired (Retire), and never modified.

// Staged is a pending pack: its trailing hash, hex.
type Staged struct {
	Name str
}

// Update is what Commit makes current in one step: the changes' new versions, the refs' moves and a staged pack.
type Update struct {
	// Who is the email the request was signed as ("" for tit's own commands).
	Who str
	// Command is the operation's description: "push by ada@example.com", "repack", "prune".
	Command str
	// Changes are each change's new commit and the version it replaces (§15).
	Changes []ChangeUpdate
	// Refs are each ref's old and new target, as a ref file writes them (§15).
	Refs []RefUpdate
	// Pack is a staged pack's name, "" for none.
	Pack str
	// Time is the new versions' time, unix ns.
	Time i64
}

// Repo is what a server needs of one repository. Commit checks every change's replaced version and every ref's old
// target again under the repository lock and refuses (ErrRefused, "Moved: …" or "RefChanged: …") with nothing
// changed; otherwise the pack becomes live, the refs move and the versions are added, as one change.
shape Repo {
	mut Ref(name str) !?change.Ref
	mut Refs(prefix str) ![]change.Ref
	mut Newest(c object.ChangeId) !?change.Version
	mut Objects() !store.Layered
	mut Packs() ![]packfile.Pack
	TempDir() str
	mut Stage(pack str) !Staged
	mut Commit(u Update) !i64
	mut Drop(s Staged) !bool
	mut Retire(names []str) !i64
}
