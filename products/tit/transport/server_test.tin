package transport

import "../change"
import "../identity"
import "../object"
import "../packfile"
import "../store"
import "crucible"
import "fault"
import "quarry"
import "seal"
import "twine"

// Tests for the server (#796), through Handle and the Local transport: pushes that race, replays, damaged packs,
// signers, and fetches with and without haves.

fn repo(name str) str {
	let d = "/tmp/tin-test-tit-transport-" + name + "-" + seal.Hex(seal.RandomBytes(4))
	quarry.RemoveAll(d) catch _ {
	}
	for sub in []str{"objects", "packs", "refs/heads"} {
		quarry.MkdirAll(d + "/.tit/" + sub) catch _ {
		}
	}
	return d + "/.tit"
}

fn person(when i64) object.Person {
	return object.Person{Name: "Ada", Email: "ada@example.com", When: when, Zone: 0}
}

// commitIn writes a commit of one file into s.
fn commitIn[S store.ObjectStore](s mut S, name str, body str, parents []object.Id, cid object.ChangeId, when i64) object.Id {
	let blob = s.PutRaw(object.Kind.Blob, body) catch _ {
		object.NoId
	}
	let tree = s.Put(object.Object.Tree([]object.Entry{object.Entry{Mode: object.Mode.File, Name: name, Id: blob}})) catch _ {
		object.NoId
	}
	let c = object.CommitData{Tree: tree, Parents: parents, Change: cid, Author: person(when), Committer: person(when), GitHeaders: []str{}, Signature: "", Message: "{name}\n", Conflicts: []str{}}
	return s.Put(object.Object.Commit(c)) catch _ {
		object.NoId
	}
}

// packOf is a pack of the objects reachable from commit in s that are not in skip.
fn packOf(s mut store.Mem, ids []object.Id) str {
	let d = "/tmp/tin-test-tit-transport-pack-" + seal.Hex(seal.RandomBytes(4))
	let p = packfile.Write(mut s, ids, d) catch _ {
		return ""
	}
	let data = quarry.ReadFile(p.Path) catch _ {
		""
	}
	quarry.RemoveAll(d) catch _ {
	}
	return data
}

// everything is every object of a commit and its tree (one-file trees, as commitIn makes).
fn everything(s mut store.Mem, id object.Id) []object.Id {
	mut out = []object.Id{id}
	let o = s.Get(id) catch _ {
		return out
	}
	match o {
		Commit(c) => {
			out = append(out, c.Tree)
			let t = s.Get(c.Tree) catch _ {
				return out
			}
			match t {
				Tree(es) => {
					for e in es {
						out = append(out, e.Id)
					}
				}
				Commit(_) => {
				}
				Tag(_) => {
				}
				Blob(_) => {
				}
			}
		}
		Tree(_) => {
		}
		Tag(_) => {
		}
		Blob(_) => {
		}
	}
	return out
}

fn refOf(dir str, name str) str {
	let refs = change.NewRefs(dir)
	let r = refs.Get(name) catch _ {
		nil
	}
	if r == nil {
		return ""
	}
	return change.TargetText(r.Target)
}

fn keyPair() ([]u8, []u8) {
	let seed = seal.RandomBytes(32)
	let pub = seal.Ed25519PublicKey(seed) catch _ {
		[]u8{}
	}
	return seed, pub
}

fn TestPush(t mut crucible.T) {
	let dir = repo("push")
	let (seed, pub) = keyPair()
	let sign = fn(payload str) ![]u8 {
		return try seal.SignEd25519(seed, []u8(payload))
	}
	mut server = NewServer(dir, "secret", false)
	server.Allow("ada@example.com", pub)
	mut client = store.NewMem()
	let c1 = commitIn(mut client, "a.txt", "one\n", []object.Id{}, object.NewChangeId(), 1700000000)
	mut l = NewLocal(server, "ada@example.com", sign)
	let a = l.Push(PushRequest{Changes: []ChangeUpdate{}, Refs: []RefUpdate{RefUpdate{Name: "refs/heads/main", Old: "", New: c1.Hex()}}}, packOf(mut client, everything(mut client, c1))) catch e {
		t.Error("push: {e}")
		return
	}
	crucible.Equal(mut t, "the answer", twine.Join(a.Refs, " "), "refs/heads/main")
	crucible.Equal(mut t, "main moved", refOf(dir, "refs/heads/main"), c1.Hex())
	mut here = objects(dir) catch _ {
		store.NewLayered([]dyn store.ObjectStore{store.NewMem()})
	}
	for id in everything(mut client, c1) {
		t.True("stored: " + id.Hex()[0:12], here.Has(id))
	}
	// two clients push on top of c1: the first wins, the second's old value has moved
	let c2 = commitIn(mut client, "a.txt", "two\n", []object.Id{c1}, object.NewChangeId(), 1700000100)
	let c3 = commitIn(mut client, "a.txt", "three\n", []object.Id{c1}, object.NewChangeId(), 1700000200)
	_ = l.Push(PushRequest{Changes: []ChangeUpdate{}, Refs: []RefUpdate{RefUpdate{Name: "refs/heads/main", Old: c1.Hex(), New: c2.Hex()}}}, packOf(mut client, everything(mut client, c2))) catch e {
		t.Error("the first push: {e}")
		PushAnswer{Refs: []str{}}
	}
	_ = l.Heads() catch _ {
		Heads{Refs: []RefHead{}, Changes: []ChangeHead{}, Nonce: "", Server: "", Limits: Limits{Pack: 0, Refs: 0}}
	}
	let (_, err) = l.Push(PushRequest{Changes: []ChangeUpdate{}, Refs: []RefUpdate{RefUpdate{Name: "refs/heads/main", Old: c1.Hex(), New: c3.Hex()}}}, packOf(mut client, everything(mut client, c3)))
	t.True("the second push is refused: {err}", err != nil && twine.Contains(fault.Message(err), "RefChanged (refs/heads/main)"))
	crucible.Equal(mut t, "main holds the first", refOf(dir, "refs/heads/main"), c2.Hex())
	// a push whose pack lacks what its commit needs
	let c4 = commitIn(mut client, "b.txt", "four\n", []object.Id{c2}, object.NewChangeId(), 1700000300)
	_ = l.Heads() catch _ {
		Heads{Refs: []RefHead{}, Changes: []ChangeHead{}, Nonce: "", Server: "", Limits: Limits{Pack: 0, Refs: 0}}
	}
	let (_, merr) = l.Push(PushRequest{Changes: []ChangeUpdate{}, Refs: []RefUpdate{RefUpdate{Name: "refs/heads/main", Old: c2.Hex(), New: c4.Hex()}}}, packOf(mut client, []object.Id{c4}))
	t.True("an incomplete pack: {merr}", merr != nil && twine.Contains(fault.Message(merr), "BadPack"))
	crucible.Equal(mut t, "main unchanged", refOf(dir, "refs/heads/main"), c2.Hex())
	quarry.RemoveAll(dir) catch _ {
	}
}

fn TestChangeVersions(t mut crucible.T) {
	let dir = repo("versions")
	let (seed, pub) = keyPair()
	let sign = fn(payload str) ![]u8 {
		return try seal.SignEd25519(seed, []u8(payload))
	}
	mut server = NewServer(dir, "secret", false)
	server.Allow("ada@example.com", pub)
	mut client = store.NewMem()
	let cid = object.NewChangeId()
	let v1 = commitIn(mut client, "a.txt", "one\n", []object.Id{}, cid, 1700000000)
	let v2 = commitIn(mut client, "a.txt", "one, better\n", []object.Id{}, cid, 1700000100)
	let v3 = commitIn(mut client, "a.txt", "one, other\n", []object.Id{}, cid, 1700000200)
	mut l = NewLocal(server, "ada@example.com", sign)
	_ = l.Push(PushRequest{Changes: []ChangeUpdate{ChangeUpdate{Change: cid.Letters(), Replaces: "", Commit: v1.Hex()}}, Refs: []RefUpdate{}}, packOf(mut client, everything(mut client, v1))) catch e {
		t.Error("v1: {e}")
		PushAnswer{Refs: []str{}}
	}
	// two clients both make a new version of v1: the first wins, the second names the version that moved
	_ = l.Heads() catch _ {
		Heads{Refs: []RefHead{}, Changes: []ChangeHead{}, Nonce: "", Server: "", Limits: Limits{Pack: 0, Refs: 0}}
	}
	_ = l.Push(PushRequest{Changes: []ChangeUpdate{ChangeUpdate{Change: cid.Letters(), Replaces: v1.Hex(), Commit: v2.Hex()}}, Refs: []RefUpdate{}}, packOf(mut client, everything(mut client, v2))) catch e {
		t.Error("v2: {e}")
		PushAnswer{Refs: []str{}}
	}
	_ = l.Heads() catch _ {
		Heads{Refs: []RefHead{}, Changes: []ChangeHead{}, Nonce: "", Server: "", Limits: Limits{Pack: 0, Refs: 0}}
	}
	let (_, err) = l.Push(PushRequest{Changes: []ChangeUpdate{ChangeUpdate{Change: cid.Letters(), Replaces: v1.Hex(), Commit: v3.Hex()}}, Refs: []RefUpdate{}}, packOf(mut client, everything(mut client, v3)))
	t.True("refused: {err}", err != nil && twine.Contains(fault.Message(err), "Moved") && twine.Contains(fault.Message(err), "version " + v2.Hex()[0:12] + " here"))
	let vs = change.Versions(dir, cid) catch _ {
		[]change.Version{}
	}
	crucible.Equal(mut t, "two versions", len(vs), 2)
	quarry.RemoveAll(dir) catch _ {
	}
}

fn TestAuthentication(t mut crucible.T) {
	let dir = repo("auth")
	let (seed, pub) = keyPair()
	let sign = fn(payload str) ![]u8 {
		return try seal.SignEd25519(seed, []u8(payload))
	}
	let (otherSeed, _) = keyPair()
	mut server = NewServer(dir, "secret", false)
	server.Allow("ada@example.com", pub)
	mut client = store.NewMem()
	let c1 = commitIn(mut client, "a.txt", "one\n", []object.Id{}, object.NewChangeId(), 1700000000)
	let body = Frame(Kind.PushRequest, Encode(PushRequest{Changes: []ChangeUpdate{}, Refs: []RefUpdate{RefUpdate{Name: "refs/heads/main", Old: "", New: c1.Hex()}}}), packOf(mut client, everything(mut client, c1)))
	let now = 1700000000
	let r1 = server.Handle("POST", "/tit/v1/push", "", body, now)
	crucible.Equal(mut t, "unsigned", r1.Status, 401)
	let nonce = NewNonce("secret", now)
	let path = "/tit/v1/push"
	let wrong = seal.SignEd25519(otherSeed, []u8(SigningPayload("POST", path, nonce, body))) catch _ {
		[]u8{}
	}
	let r2 = server.Handle("POST", path, SignatureHeader("ada@example.com", nonce, wrong), body, now)
	crucible.Equal(mut t, "another key", r2.Status, 401)
	let sig = seal.SignEd25519(seed, []u8(SigningPayload("POST", path, nonce, body))) catch _ {
		[]u8{}
	}
	let r3 = server.Handle("POST", path, SignatureHeader("ada@example.com", nonce, sig), body, now + 120)
	crucible.Equal(mut t, "an old nonce", r3.Status, 401)
	t.True("says so", twine.Contains(r3.Body, "NonceExpired"))
	let r4 = server.Handle("POST", path, SignatureHeader("ada@example.com", nonce, sig), body, now + 1)
	crucible.Equal(mut t, "signed", r4.Status, 200)
	// the same request sent again, within the minute
	let r5 = server.Handle("POST", path, SignatureHeader("ada@example.com", nonce, sig), body, now + 2)
	crucible.Equal(mut t, "a replay", r5.Status, 401)
	t.True("names the nonce", twine.Contains(r5.Body, "used already"))
	// a private repository refuses unsigned heads; a public one answers
	crucible.Equal(mut t, "private heads", server.Handle("GET", "/tit/v1/heads", "", "", now).Status, 401)
	mut open = NewServer(dir, "secret", true)
	crucible.Equal(mut t, "public heads", open.Handle("GET", "/tit/v1/heads", "", "", now).Status, 200)
	crucible.Equal(mut t, "a damaged body", open.Handle("POST", "/tit/v1/fetch", "", "nonsense", now).Status, 400)
	crucible.Equal(mut t, "no such request", open.Handle("GET", "/tit/v1/nope", "", "", now).Status, 404)
	quarry.RemoveAll(dir) catch _ {
	}
}

// signed is a commit of s again, signed by signer.
fn signed(s mut store.Mem, signer identity.Signer, id object.Id) object.Id {
	let o = s.Get(id) catch _ {
		return object.NoId
	}
	match o {
		Commit(cd) => {
			let sc = signer.SignCommit(cd) catch _ {
				return object.NoId
			}
			return s.Put(object.Object.Commit(sc)) catch _ {
				object.NoId
			}
		}
		Tree(_) => {
		}
		Tag(_) => {
		}
		Blob(_) => {
		}
	}
	return object.NoId
}

fn TestSigners(t mut crucible.T) {
	let dir = repo("signers")
	let (seed, pub) = keyPair()
	let sign = fn(payload str) ![]u8 {
		return try seal.SignEd25519(seed, []u8(payload))
	}
	mut server = NewServer(dir, "secret", false)
	server.Allow("ada@example.com", pub)
	// Ada's commit key, and a first commit whose signers file trusts it
	let keyPath = dir + "/commit-key"
	let commitPub = identity.NewKey(keyPath) catch e {
		t.Error("key: {e}")
		return
	}
	let signer = identity.LoadKey(keyPath) catch e {
		t.Error("load key: {e}")
		return
	}
	mut client = store.NewMem()
	let signers = "ada@example.com ed25519 " + commitPub + "\n"
	// a root commit is checked against its own signers file, so it is signed too
	let c1 = signed(mut client, signer, commitIn(mut client, ".tit-signers", signers, []object.Id{}, object.NewChangeId(), 1700000000))
	mut l = NewLocal(server, "ada@example.com", sign)
	_ = l.Push(PushRequest{Changes: []ChangeUpdate{}, Refs: []RefUpdate{RefUpdate{Name: "refs/heads/main", Old: "", New: c1.Hex()}}}, packOf(mut client, everything(mut client, c1))) catch e {
		t.Error("the first push: {e}")
		PushAnswer{Refs: []str{}}
	}
	// an unsigned commit on top is refused; the same commit signed by Ada is taken
	let unsigned = commitIn(mut client, ".tit-signers", signers, []object.Id{c1}, object.NewChangeId(), 1700000100)
	_ = l.Heads() catch _ {
		Heads{Refs: []RefHead{}, Changes: []ChangeHead{}, Nonce: "", Server: "", Limits: Limits{Pack: 0, Refs: 0}}
	}
	let (_, err) = l.Push(PushRequest{Changes: []ChangeUpdate{}, Refs: []RefUpdate{RefUpdate{Name: "refs/heads/main", Old: c1.Hex(), New: unsigned.Hex()}}}, packOf(mut client, everything(mut client, unsigned)))
	t.True("unsigned: {err}", err != nil && twine.Contains(fault.Message(err), "BadSignature"))
	let sid = signed(mut client, signer, unsigned)
	_ = l.Heads() catch _ {
		Heads{Refs: []RefHead{}, Changes: []ChangeHead{}, Nonce: "", Server: "", Limits: Limits{Pack: 0, Refs: 0}}
	}
	let (_, serr) = l.Push(PushRequest{Changes: []ChangeUpdate{}, Refs: []RefUpdate{RefUpdate{Name: "refs/heads/main", Old: c1.Hex(), New: sid.Hex()}}}, packOf(mut client, everything(mut client, sid)))
	t.NoFault("signed", serr)
	quarry.RemoveAll(dir) catch _ {
	}
}

fn TestFetch(t mut crucible.T) {
	let dir = repo("fetch")
	let (seed, pub) = keyPair()
	let sign = fn(payload str) ![]u8 {
		return try seal.SignEd25519(seed, []u8(payload))
	}
	mut server = NewServer(dir, "secret", false)
	server.Allow("ada@example.com", pub)
	mut client = store.NewMem()
	let c1 = commitIn(mut client, "a.txt", "one\n", []object.Id{}, object.NewChangeId(), 1700000000)
	let c2 = commitIn(mut client, "a.txt", "two\n", []object.Id{c1}, object.NewChangeId(), 1700000100)
	mut both = everything(mut client, c1)
	for id in everything(mut client, c2) {
		both = append(both, id)
	}
	mut l = NewLocal(server, "ada@example.com", sign)
	_ = l.Push(PushRequest{Changes: []ChangeUpdate{}, Refs: []RefUpdate{RefUpdate{Name: "refs/heads/main", Old: "", New: c2.Hex()}}}, packOf(mut client, both)) catch e {
		t.Error("push: {e}")
		PushAnswer{Refs: []str{}}
	}
	let h = l.Heads() catch e {
		t.Error("heads: {e}")
		return
	}
	crucible.Equal(mut t, "heads", len(h.Refs), 1)
	crucible.Equal(mut t, "main", h.Refs[0].Target, c2.Hex())
	// a clone: no haves, everything comes
	let (a1, p1) = l.Fetch(FetchRequest{Wants: []str{c2.Hex()}, Haves: []str{}, NoBlobs: false, Objects: []str{}}) catch e {
		t.Error("fetch: {e}")
		return
	}
	crucible.Equal(mut t, "six objects", a1.Objects, 6)
	mut fresh = store.NewMem()
	let got = packfile.Unpack(p1, mut fresh, 1 << 20) catch e {
		t.Error("unpack: {e}")
		return
	}
	crucible.Equal(mut t, "in the pack", len(got), 6)
	t.True("the tip", fresh.Has(c2))
	// with c1 already: only c2, its tree and its blob
	let (a2, _) = l.Fetch(FetchRequest{Wants: []str{c2.Hex()}, Haves: []str{c1.Hex(), "0123"}, NoBlobs: false, Objects: []str{}}) catch e {
		t.Error("fetch with haves: {e}")
		return
	}
	crucible.Equal(mut t, "three objects", a2.Objects, 3)
	let (_, _, nerr) = l.Fetch(FetchRequest{Wants: []str{object.Hash(object.Kind.Blob, "nowhere").Hex()}, Haves: []str{}, NoBlobs: false, Objects: []str{}})
	t.True("an unknown want", nerr != nil && twine.Contains(fault.Message(nerr), "NotFound"))
	quarry.RemoveAll(dir) catch _ {
	}
}

// filesUnder is every file below dir, as paths.
fn filesUnder(dir str) []str {
	mut out = []str{}
	let names = quarry.ReadDir(dir) catch _ {
		return out
	}
	for n in names {
		let p = dir + "/" + n
		if quarry.IsDir(p) {
			for f in filesUnder(p) {
				out = append(out, f)
			}
		} else {
			out = append(out, p)
		}
	}
	return out
}

// A push cut off mid-pack (a dropped connection, a killed client) is refused, moves no ref and leaves no pack or
// object behind; the whole push then goes through (#795, #796).
fn TestCutPush(t mut crucible.T) {
	let dir = repo("cut")
	let (seed, pub) = keyPair()
	let sign = fn(payload str) ![]u8 {
		return try seal.SignEd25519(seed, []u8(payload))
	}
	mut server = NewServer(dir, "secret", false)
	server.Allow("ada@example.com", pub)
	mut client = store.NewMem()
	mut big = ""
	for i in 0..2000 {
		big = big + "line {i} of a file large enough to take several reads\n"
	}
	let c1 = commitIn(mut client, "a.txt", big, []object.Id{}, object.NewChangeId(), 1700000000)
	let pack = packOf(mut client, everything(mut client, c1))
	let req = PushRequest{Changes: []ChangeUpdate{}, Refs: []RefUpdate{RefUpdate{Name: "refs/heads/main", Old: "", New: c1.Hex()}}}
	let before = filesUnder(dir)
	mut l = NewLocal(server, "ada@example.com", sign)
	for k in 1..8 {
		let cut = len(pack) * k / 8
		_ = l.Heads() catch _ {
			Heads{Refs: []RefHead{}, Changes: []ChangeHead{}, Nonce: "", Server: "", Limits: Limits{Pack: 0, Refs: 0}}
		}
		let (_, err) = l.Push(req, pack[0:cut])
		t.True("cut at {cut} of {len(pack)}: refused", err != nil)
		crucible.Equal(mut t, "cut at {cut}: main unchanged", refOf(dir, "refs/heads/main"), "")
		crucible.Equal(mut t, "cut at {cut}: no file left", twine.Join(filesUnder(dir), " "), twine.Join(before, " "))
	}
	_ = l.Heads() catch _ {
		Heads{Refs: []RefHead{}, Changes: []ChangeHead{}, Nonce: "", Server: "", Limits: Limits{Pack: 0, Refs: 0}}
	}
	_ = l.Push(req, pack) catch e {
		t.Error("the whole push: {e}")
		PushAnswer{Refs: []str{}}
	}
	crucible.Equal(mut t, "then main moves", refOf(dir, "refs/heads/main"), c1.Hex())
	quarry.RemoveAll(dir) catch _ {
	}
}
