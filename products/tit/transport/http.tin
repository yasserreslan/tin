package transport

import "anvil"
import "wire"
import "../identity"
import "argo"
import "fault"
import "flume"
import "quarry"
import "seal"
import "twine"
import "tide"

// The protocol over HTTP (#795, #796): Http is the client Transport, on wire; Serve puts a Server behind anvil.

// challengeNonce is the fresh nonce a 401 answer carries, or "".
fn challengeNonce(status i64, body str) str {
	if status != 401 {
		return ""
	}
	let (k, header, _, ferr) = ReadFrame(body)
	if ferr != nil || k != Kind.Error {
		return ""
	}
	mut e = ErrorAnswer{Code: "", Message: "", Ref: "", Nonce: ""}
	let derr = argo.Get(header, mut e)
	if derr != nil {
		return ""
	}
	return e.Nonce
}

// answer is the body of a 200 answer, or the refusal any other answer carries.
fn answer(status i64, body str) !str {
	if status == 200 {
		return body
	}
	let (k, header, _, ferr) = ReadFrame(body)
	if ferr != nil || k != Kind.Error {
		fail fault.Wrap(ErrRefused, "Internal: status {status}")
	}
	mut e = ErrorAnswer{Code: "", Message: "", Ref: "", Nonce: ""}
	argo.Get(header, mut e) catch _ {
		fail fault.Wrap(ErrRefused, "Internal: status {status}")
	}
	try Refused(e)
	return ""
}

// Http reaches a repository at url (http:// or https://), signing as email with sign, which signs a payload with the
// user's key (identity.Signer.Sign); "" email: unsigned.
type Http struct {
	url   str
	path  str
	email str
	sign  fn(str) ![]u8
	nonce str
}

// NewHttp is a client of the repository at url.
fn NewHttp(url str, email str, sign fn(str) ![]u8) Http {
	mut base = url
	for twine.HasSuffix(base, "/") {
		base = base[0:len(base) - 1]
	}
	// the path the server sees, which the signature covers
	mut path = ""
	let scheme = twine.Index(base, "://")
	if scheme >= 0 {
		let slash = twine.IndexByte(base[scheme + 3:], '/')
		if slash >= 0 {
			path = base[scheme + 3 + slash:]
		}
	}
	return Http{url: base, path: path, email: email, sign: sign, nonce: ""}
}

fn (h mut Http) send(method str, req str, body str) !wire.Resp {
	mut headers = []str{"Content-Type", "application/x-tit"}
	if len(h.email) > 0 && len(h.nonce) > 0 {
		let s = try h.sign(SigningPayload(method, h.path + req, h.nonce, body))
		headers = append(headers, "Tit-Signature", SignatureHeader(h.email, h.nonce, s))
	}
	return try wire.DoWith(method, h.url + req, headers, body, wire.Options{Timeout: 600 * 1000000000, MaxBody: 4 * 1024 * 1024 * 1024, MaxIdle: 0})
}

fn (h mut Http) call(method str, req str, body str) !str {
	mut r = try h.send(method, req, body)
	let n = challengeNonce(r.Status, r.Body)
	if len(n) > 0 && len(h.email) > 0 {
		h.nonce = n
		r = try h.send(method, req, body)
	}
	return try answer(r.Status, r.Body)
}

// Heads asks for the server's refs, and keeps the nonce for the next requests.
fn (h mut Http) Heads() !Heads {
	let body = try h.call("GET", "/tit/v1/heads", "")
	let (_, header, _) = try ReadFrame(body)
	mut out = Heads{Refs: []RefHead{}, Changes: []ChangeHead{}, Nonce: "", Server: "", Limits: Limits{Pack: 0, Refs: 0}}
	try argo.Get(header, mut out)
	h.nonce = out.Nonce
	return out
}

// Fetch asks for what req wants: the answer's header and the pack.
fn (h mut Http) Fetch(req FetchRequest) !(FetchAnswer, str) {
	let body = try h.call("POST", "/tit/v1/fetch", Frame(Kind.FetchRequest, Encode(req), ""))
	let (_, header, data) = try ReadFrame(body)
	mut a = FetchAnswer{Objects: 0}
	try argo.Get(header, mut a)
	return a, data
}

// Push sends req and its pack, signed with the nonce of the last heads or challenge.
fn (h mut Http) Push(req PushRequest, pack str) !PushAnswer {
	let body = try h.call("POST", "/tit/v1/push", Frame(Kind.PushRequest, Encode(req), pack))
	let (_, header, _) = try ReadFrame(body)
	mut a = PushAnswer{Refs: []str{}}
	try argo.Get(header, mut a)
	return a
}

// served is the server this core answers with, made on the core's first request from what Serve recorded in the
// environment (globals are per core: one assigned in main would exist on core 0 alone, E131).
mut served ?Server = nil

// Serve answers the protocol on addr, on every core, until the process ends, for the repository whose .tit directory
// is dir: allowFile lists the keys allowed to sign (as .tit-signers does), public lets heads and fetch go unsigned,
// and dir/serve-secret holds the key nonces are signed with (made on the first run).
fn Serve(addr str, dir str, allowFile str, public bool) ! {
	// read here, once, and handed to every core through the environment: a core's first request then does no file
	// effect of its own, so a request recorded by anvil (TIN_REPLAY_DIR) replays with tin replay the same way
	// whichever request it was on its core
	let secretKey = try ServeSecret(dir)
	mut allowed = ""
	if quarry.Exists(allowFile) {
		allowed = try flume.ReadFile(allowFile)
	}
	try quarry.Setenv("TIT_SERVE_DIR", dir)
	try quarry.Setenv("TIT_SERVE_SECRET", secretKey)
	try quarry.Setenv("TIT_SERVE_KEYS", allowed)
	mut p = "0"
	if public {
		p = "1"
	}
	try quarry.Setenv("TIT_SERVE_PUBLIC", p)
	try anvil.Serve(addr, handle)
}

// ServeSecret is the key a repository's server signs nonces with, from dir/serve-secret (made when missing), so every
// process and node serving it takes the others' nonces.
fn ServeSecret(dir str) !str {
	let path = dir + "/serve-secret"
	if quarry.Exists(path) {
		let text = try flume.ReadFile(path)
		return twine.TrimSpace(text)
	}
	let key = seal.Hex(seal.RandomBytes(32))
	mut w = try flume.CreateExcl(path)
	w.Str(key + "\n")
	try w.Close()
	try quarry.Chmod(path, 384)
	return key
}

// AllowedKeys reads a file of allowed keys (the .tit-signers format); a missing file allows none.
fn AllowedKeys(path str) ![]identity.TrustedKey {
	if !quarry.Exists(path) {
		return []identity.TrustedKey{}
	}
	let text = try flume.ReadFile(path)
	return try identity.ParseSigners(text)
}

fn serverFromEnv() !Server {
	let dir = quarry.Getenv("TIT_SERVE_DIR")
	mut s = NewServer(dir, quarry.Getenv("TIT_SERVE_SECRET"), quarry.Getenv("TIT_SERVE_PUBLIC") == "1")
	let keys = try identity.ParseSigners(quarry.Getenv("TIT_SERVE_KEYS"))
	for k in keys {
		s.Allow(k.Email, k.Public)
	}
	return s
}

fn handle(q anvil.Req, w mut anvil.Out) {
	if served == nil {
		let made = serverFromEnv() catch e {
			w.Status(500)
			w.Body = []u8(Frame(Kind.Error, Encode(ErrorAnswer{Code: "Internal", Message: fault.Message(e), Ref: "", Nonce: ""}), ""))
			return
		}
		served = keep(made)
	}
	let cur = served
	if cur == nil {
		return
	}
	mut srv = cur
	let r = srv.Handle(q.Method, q.Path, q.Header("tit-signature"), q.Body(), tide.Wall() / 1000000000)
	w.Status(r.Status)
	w.Type("application/x-tit")
	w.Body = []u8(r.Body)
}
