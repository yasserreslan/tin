package transport

import "../change"
import "../crash"
import "../object"
import "../oplog"
import "../packfile"
import "../store"
import "quarry"
import "twine"

// DirRepo is a Repo on a .tit directory (design/tit.md §16, #1006): pending packs in packs/staged, live ones in
// packs, retired ones in packs/retired; refs, versions and the lock as tit's own commands keep them.
type DirRepo struct {
	Dir str
}

// NewDirRepo is the repository whose .tit directory is dir.
fn NewDirRepo(dir str) DirRepo {
	return DirRepo{Dir: dir}
}

// Ref is the ref called name, or nil.
fn (r DirRepo) Ref(name str) !?change.Ref {
	let refs = change.NewRefs(r.Dir)
	return try refs.Get(name)
}

// Refs is every ref whose name starts with prefix.
fn (r DirRepo) Refs(prefix str) ![]change.Ref {
	let refs = change.NewRefs(r.Dir)
	return try refs.List(prefix)
}

// Newest is the change's newest version, or nil.
fn (r DirRepo) Newest(c object.ChangeId) !?change.Version {
	return try change.Newest(r.Dir, c)
}

// Objects is every live object: the loose ones and every live pack's.
fn (r DirRepo) Objects() !store.Layered {
	return try objects(r.Dir)
}

// Packs is the live packs.
fn (r DirRepo) Packs() ![]packfile.Pack {
	return try packsOf(r.Dir)
}

// TempDir is packs/staged: a pack written there is staged by Stage without a copy.
fn (r DirRepo) TempDir() str {
	let d = r.Dir + "/packs/staged"
	quarry.MkdirAll(d) catch _ {
	}
	return d
}

// Stage makes the pack at path (with its .idx beside it) pending, moving it into packs/staged when it is elsewhere.
fn (r DirRepo) Stage(pack str) !Staged {
	if !twine.HasSuffix(pack, ".pack") {
		try refusal(Code.Internal, "{pack} is not a .pack file")
	}
	let base = pack[0:len(pack) - 5]
	let name = baseName(base)
	let to = r.TempDir() + "/" + name
	if base != to {
		crash.Point()
		try quarry.Rename(base + ".idx", to + ".idx")
		crash.Point()
		try quarry.Rename(base + ".pack", to + ".pack")
		try quarry.Sync(r.TempDir())
	}
	return Staged{Name: name}
}

// Commit makes u current under the repository lock: versions and refs checked again, the staged pack moved in (its
// index first, so a listed pack always has one), then the refs and versions in one oplog operation.
fn (r mut DirRepo) Commit(u Update) !i64 {
	use lock = change.Lock(r.Dir)
	try recheck(mut r, u)
	if len(u.Pack) > 0 {
		let from = r.Dir + "/packs/staged/" + u.Pack
		let to = r.Dir + "/packs/" + u.Pack
		if !quarry.Exists(from + ".pack") {
			try refusal(Code.Internal, "no staged pack {u.Pack}")
		}
		crash.Point()
		try quarry.Rename(from + ".idx", to + ".idx")
		crash.Point()
		try quarry.Rename(from + ".pack", to + ".pack")
		try quarry.Sync(r.Dir + "/packs")
	}
	if len(u.Refs) == 0 && len(u.Changes) == 0 {
		return 0
	}
	mut moves = []oplog.RefChange{}
	for ru in u.Refs {
		moves = append(moves, oplog.RefChange{Name: ru.Name, Before: ru.Old, After: ru.New})
	}
	use tx = oplog.Begin(r.Dir, "server", u.Command, oplog.Op.Push(u.Who), moves)
	try tx.Apply()
	for cu in u.Changes {
		let cid = try object.ParseChangeId(cu.Change)
		let id = try object.ParseId(cu.Commit)
		try change.AddVersion(r.Dir, cid, change.NewVersion(tx.Number(), id, u.Time))
	}
	try tx.Commit()
	return tx.Number()
}

// Drop deletes a pending pack.
fn (r DirRepo) Drop(s Staged) !bool {
	let base = r.Dir + "/packs/staged/" + s.Name
	if !quarry.Exists(base + ".pack") {
		return false
	}
	try quarry.Remove(base + ".pack")
	quarry.Remove(base + ".idx") catch _ {
	}
	return true
}

// Retire moves live packs to packs/retired, the pack first (so new readers stop listing it), then its index.
fn (r DirRepo) Retire(names []str) !i64 {
	let to = r.Dir + "/packs/retired"
	try quarry.MkdirAll(to)
	mut n = 0
	for name in names {
		let from = r.Dir + "/packs/" + name
		if !quarry.Exists(from + ".pack") {
			continue
		}
		try quarry.Rename(from + ".pack", to + "/" + name + ".pack")
		try quarry.Rename(from + ".idx", to + "/" + name + ".idx")
		n += 1
	}
	try quarry.Sync(r.Dir + "/packs")
	return n
}

// baseName is the last element of a path.
fn baseName(path str) str {
	let slash = twine.LastIndex(path, "/")
	if slash < 0 {
		return path
	}
	return path[slash + 1:]
}

// recheck refuses an update whose changes or refs moved since it was checked (design/tit.md §16, step 4).
fn recheck[R Repo](r mut R, u Update) ! {
	for cu in u.Changes {
		let cid = object.ParseChangeId(cu.Change) catch _ {
			try refusal(Code.BadRequest, "{cu.Change} is not a change id")
			object.NewChangeId()
		}
		let newest = try r.Newest(cid)
		mut have = ""
		if newest != nil {
			let nid = try object.IdOf(newest.Hash)
			have = nid.Hex()
		}
		if have != cu.Replaces {
			mut what = "a new change"
			if len(cu.Replaces) > 0 {
				what = "version " + cu.Replaces[0:12]
			}
			mut there = "none"
			if len(have) > 0 {
				there = have[0:12]
			}
			try refusal(Code.Moved, "{cu.Change} has version {there} here; this push replaces {what}")
		}
	}
	for ru in u.Refs {
		try change.CheckName(ru.Name)
		let cur = try r.Ref(ru.Name)
		mut now = ""
		if cur != nil {
			now = change.TargetText(cur.Target)
		}
		if now != ru.Old {
			try refusal(Code.RefChanged, "{ru.Name} moved: it holds {short(now)} here, not {short(ru.Old)}")
		}
	}
}
