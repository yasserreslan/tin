package transport

import "../change"
import "../object"
import "../packfile"
import "../store"
import "crucible"
import "fault"
import "quarry"
import "seal"
import "twine"

// Tests for the Repo seam (design/tit.md §16, #1006): the same contract on a .tit directory and in memory, and the
// server's pushes and fetches over a MemRepo.

fn memRepo(name str) MemRepo {
	let d = "/tmp/tin-test-tit-memrepo-" + name + "-" + seal.Hex(seal.RandomBytes(4))
	quarry.RemoveAll(d) catch _ {
	}
	let r = NewMemRepo(d) catch _ {
		return MemRepo{dir: d, refs: map[str]str{}, versions: map[str][]change.Version{}, ops: 0}
	}
	return r
}

// stagePack writes a pack of ids from s into the repo's temp dir and stages it.
fn stagePack[R Repo](r mut R, s mut store.Mem, ids []object.Id) !Staged {
	let p = try packfile.Write(mut s, ids, r.TempDir())
	return try r.Stage(p.Path)
}

// contract is the §16 behaviour every Repo has: a staged pack is invisible, Commit makes it live with its refs and
// versions, a stale ref or version is refused with nothing changed, Drop and Retire remove packs from sight.
fn contract[R Repo](t mut crucible.T, r mut R, label str) {
	mut client = store.NewMem()
	let cid = object.NewChangeId()
	let c1 = commitIn(mut client, "a.txt", "one\n", []object.Id{}, cid, 1700000000)
	let st = stagePack(mut r, mut client, everything(mut client, c1)) catch e {
		t.Error("{label}: stage: {e}")
		return
	}
	let before = r.Objects() catch e {
		t.Error("{label}: objects: {e}")
		return
	}
	t.True("{label}: a staged pack is not read", !before.Has(c1))
	let main = RefUpdate{Name: "refs/heads/main", Old: "", New: c1.Hex()}
	let v1 = ChangeUpdate{Change: cid.Letters(), Replaces: "", Commit: c1.Hex()}
	let n = r.Commit(Update{Who: "ada@example.com", Command: "push", Changes: []ChangeUpdate{v1}, Refs: []RefUpdate{main}, Pack: st.Name, Time: 5}) catch e {
		t.Error("{label}: commit: {e}")
		return
	}
	t.True("{label}: an operation number", n > 0)
	let after = r.Objects() catch e {
		t.Error("{label}: objects: {e}")
		return
	}
	t.True("{label}: the committed pack is read", after.Has(c1))
	let got = r.Ref("refs/heads/main") catch _ {
		nil
	}
	t.True("{label}: main moved", got != nil && change.TargetText(got.Target) == c1.Hex())
	let newest = r.Newest(cid) catch _ {
		nil
	}
	t.True("{label}: the version", newest != nil && newest.Commit() == c1 && newest.Time == 5)
	// a stale ref and a stale version are each refused, and nothing changes
	let c2 = commitIn(mut client, "a.txt", "two\n", []object.Id{c1}, cid, 1700000100)
	let st2 = stagePack(mut r, mut client, everything(mut client, c2)) catch e {
		t.Error("{label}: stage 2: {e}")
		return
	}
	let (_, rerr) = r.Commit(Update{Who: "", Command: "push", Changes: []ChangeUpdate{}, Refs: []RefUpdate{RefUpdate{Name: "refs/heads/main", Old: "", New: c2.Hex()}}, Pack: st2.Name, Time: 6})
	t.True("{label}: a stale ref: {rerr}", rerr != nil && twine.Contains(fault.Message(rerr), "RefChanged"))
	let (_, verr) = r.Commit(Update{Who: "", Command: "push", Changes: []ChangeUpdate{ChangeUpdate{Change: cid.Letters(), Replaces: "", Commit: c2.Hex()}}, Refs: []RefUpdate{}, Pack: st2.Name, Time: 6})
	t.True("{label}: a stale version: {verr}", verr != nil && twine.Contains(fault.Message(verr), "Moved"))
	let still = r.Objects() catch e {
		t.Error("{label}: objects: {e}")
		return
	}
	t.True("{label}: the refused pack stays pending", !still.Has(c2))
	let dropped = r.Drop(st2) catch _ {
		false
	}
	t.True("{label}: dropped", dropped)
	let again = r.Drop(st2) catch _ {
		true
	}
	t.True("{label}: dropped once", !again)
	// retiring the live pack takes it out of sight
	let packs = r.Packs() catch _ {
		[]packfile.Pack{}
	}
	crucible.Equal(mut t, "{label}: one live pack", len(packs), 1)
	let gone = r.Retire([]str{st.Name}) catch _ {
		0
	}
	crucible.Equal(mut t, "{label}: retired", gone, 1)
	let left = r.Packs() catch _ {
		[]packfile.Pack{}
	}
	crucible.Equal(mut t, "{label}: no live pack", len(left), 0)
}

fn TestRepoContract(t mut crucible.T) {
	let dir = repo("contract")
	mut d = NewDirRepo(dir)
	contract(mut t, mut d, "dir")
	mut m = memRepo("contract")
	contract(mut t, mut m, "mem")
	quarry.RemoveAll(dir) catch _ {
	}
	quarry.RemoveAll(m.dir) catch _ {
	}
}

// The server over a MemRepo: pushes race on a ref and on a change version, an incomplete pack is refused, a cut pack
// leaves no pending pack, and fetches send what the haves lack.
fn TestMemRepoServer(t mut crucible.T) {
	let (seed, pub) = keyPair()
	let sign = fn(payload str) ![]u8 {
		return try seal.SignEd25519(seed, []u8(payload))
	}
	mut m = memRepo("server")
	mut server = NewRepoServer(m, "secret", false)
	server.Allow("ada@example.com", pub)
	mut l = NewLocal(server, "ada@example.com", sign)
	mut client = store.NewMem()
	let cid = object.NewChangeId()
	let c1 = commitIn(mut client, "a.txt", "one\n", []object.Id{}, cid, 1700000000)
	_ = l.Push(PushRequest{Changes: []ChangeUpdate{ChangeUpdate{Change: cid.Letters(), Replaces: "", Commit: c1.Hex()}}, Refs: []RefUpdate{RefUpdate{Name: "refs/heads/main", Old: "", New: c1.Hex()}}}, packOf(mut client, everything(mut client, c1))) catch e {
		t.Error("push: {e}")
		PushAnswer{Refs: []str{}}
	}
	let h = l.Heads() catch e {
		t.Error("heads: {e}")
		return
	}
	crucible.Equal(mut t, "one ref", len(h.Refs), 1)
	if len(h.Refs) != 1 {
		return
	}
	crucible.Equal(mut t, "main", h.Refs[0].Target, c1.Hex())
	let v = m.Newest(cid) catch _ {
		nil
	}
	t.True("the change's version", v != nil && v.Commit() == c1)
	let c2 = commitIn(mut client, "a.txt", "two\n", []object.Id{c1}, object.NewChangeId(), 1700000100)
	let c3 = commitIn(mut client, "a.txt", "three\n", []object.Id{c1}, object.NewChangeId(), 1700000200)
	_ = l.Push(PushRequest{Changes: []ChangeUpdate{}, Refs: []RefUpdate{RefUpdate{Name: "refs/heads/main", Old: c1.Hex(), New: c2.Hex()}}}, packOf(mut client, everything(mut client, c2))) catch e {
		t.Error("the first push: {e}")
		PushAnswer{Refs: []str{}}
	}
	_ = l.Heads() catch _ {
		Heads{Refs: []RefHead{}, Changes: []ChangeHead{}, Nonce: "", Server: "", Limits: Limits{Pack: 0, Refs: 0}}
	}
	let (_, err) = l.Push(PushRequest{Changes: []ChangeUpdate{}, Refs: []RefUpdate{RefUpdate{Name: "refs/heads/main", Old: c1.Hex(), New: c3.Hex()}}}, packOf(mut client, everything(mut client, c3)))
	t.True("the second push is refused: {err}", err != nil && twine.Contains(fault.Message(err), "RefChanged (refs/heads/main)"))
	let c4 = commitIn(mut client, "b.txt", "four\n", []object.Id{c2}, object.NewChangeId(), 1700000300)
	_ = l.Heads() catch _ {
		Heads{Refs: []RefHead{}, Changes: []ChangeHead{}, Nonce: "", Server: "", Limits: Limits{Pack: 0, Refs: 0}}
	}
	let (_, merr) = l.Push(PushRequest{Changes: []ChangeUpdate{}, Refs: []RefUpdate{RefUpdate{Name: "refs/heads/main", Old: c2.Hex(), New: c4.Hex()}}}, packOf(mut client, []object.Id{c4}))
	t.True("an incomplete pack: {merr}", merr != nil && twine.Contains(fault.Message(merr), "BadPack"))
	// a cut pack is refused before anything is staged
	let pack = packOf(mut client, everything(mut client, c4))
	_ = l.Heads() catch _ {
		Heads{Refs: []RefHead{}, Changes: []ChangeHead{}, Nonce: "", Server: "", Limits: Limits{Pack: 0, Refs: 0}}
	}
	let (_, cerr) = l.Push(PushRequest{Changes: []ChangeUpdate{}, Refs: []RefUpdate{RefUpdate{Name: "refs/heads/main", Old: c2.Hex(), New: c4.Hex()}}}, pack[0:len(pack) / 2])
	t.True("a cut pack", cerr != nil)
	let staged = quarry.ReadDir(m.dir + "/staged") catch _ {
		[]str{"?"}
	}
	crucible.Equal(mut t, "nothing pending", len(staged), 0)
	// a clone, then a fetch with c1 already
	let (a1, _) = l.Fetch(FetchRequest{Wants: []str{c2.Hex()}, Haves: []str{}, NoBlobs: false, Objects: []str{}}) catch e {
		t.Error("fetch: {e}")
		return
	}
	crucible.Equal(mut t, "six objects", a1.Objects, 6)
	let (a2, _) = l.Fetch(FetchRequest{Wants: []str{c2.Hex()}, Haves: []str{c1.Hex()}, NoBlobs: false, Objects: []str{}}) catch e {
		t.Error("fetch with haves: {e}")
		return
	}
	crucible.Equal(mut t, "three objects", a2.Objects, 3)
	quarry.RemoveAll(m.dir) catch _ {
	}
}
