package transport

import "argo"
import "fault"
import "seal"
import "tide"

// Local is a Transport to a Server in the same process: the requests are framed, signed and answered exactly as
// over HTTP, with no socket. Tests use it, and so can tools that hold both repositories.

// Local reaches server, signing as email with sign ("" email: unsigned).
type Local struct {
	server Server
	email  str
	sign   fn(str) ![]u8
	nonce  str
	path   str
}

// NewLocal is a Local to server, signing as email with sign.
fn NewLocal(server Server, email str, sign fn(str) ![]u8) Local {
	return Local{server: server, email: email, sign: sign, nonce: "", path: ""}
}

fn (l mut Local) call(method str, path str, body str) !str {
	mut r = try l.send(method, path, body)
	// a challenge: sign with the nonce it carries, once
	let n = challengeNonce(r.Status, r.Body)
	if len(n) > 0 && len(l.email) > 0 {
		l.nonce = n
		r = try l.send(method, path, body)
	}
	return try answer(r.Status, r.Body)
}

fn (l mut Local) send(method str, path str, body str) !Reply {
	mut sig = ""
	if len(l.email) > 0 && len(l.nonce) > 0 {
		let s = try l.sign(SigningPayload(method, path, l.nonce, body))
		sig = SignatureHeader(l.email, l.nonce, s)
	}
	return l.server.Handle(method, path, sig, body, tide.Wall() / 1000000000)
}

// Heads asks for the server's refs, and keeps the nonce for the next requests.
fn (l mut Local) Heads() !Heads {
	let body = try l.call("GET", "/tit/v1/heads", "")
	let (_, header, _) = try ReadFrame(body)
	mut h = Heads{Refs: []RefHead{}, Changes: []ChangeHead{}, Nonce: "", Server: "", Limits: Limits{Pack: 0, Refs: 0}}
	try argo.Get(header, mut h)
	l.nonce = h.Nonce
	return h
}

// Fetch asks for what req wants: the answer's header and the pack.
fn (l mut Local) Fetch(req FetchRequest) !(FetchAnswer, str) {
	let body = try l.call("POST", "/tit/v1/fetch", Frame(Kind.FetchRequest, Encode(req), ""))
	let (_, header, data) = try ReadFrame(body)
	mut a = FetchAnswer{Objects: 0}
	try argo.Get(header, mut a)
	return a, data
}

// Push sends req and its pack, signed with the nonce of the last heads or challenge.
fn (l mut Local) Push(req PushRequest, pack str) !PushAnswer {
	let body = try l.call("POST", "/tit/v1/push", Frame(Kind.PushRequest, Encode(req), pack))
	let (_, header, _) = try ReadFrame(body)
	mut a = PushAnswer{Refs: []str{}}
	try argo.Get(header, mut a)
	return a
}
