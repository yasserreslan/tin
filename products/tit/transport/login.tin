package transport

import "argo"
import "fault"
import "flume"
import "../identity"
import "mint"
import "quarry"
import "seal"
import "twine"

// Signing in with a key and adding keys with an invite (design/tit.md §18, #1017). tit serve keeps login requests in
// <dir>/logins and invites in <dir>/invites; tinhub (#1012) answers the same requests from its own accounts.

// LoginTTL is how long a login request may be approved: 10 minutes (TIT_SERVE_LOGIN_TTL, seconds, for tests).
const LoginTTL = 600

// InviteTTL is how long an invite lives: 7 days.
const InviteTTL = 7 * 24 * 3600

// codeLetters is the alphabet of codes: no 0/O, 1/I/L.
const codeLetters = "ABCDEFGHJKMNPQRSTUVWXYZ23456789"

// LoginAnswer answers POST /tit/v1/login.
type LoginAnswer struct {
	@json("code") Code    str
	@json("url") Url      str
	@json("expires") Expires i64
}

// LoginState answers GET /tit/v1/login/<code>, and is what a server keeps of a login request.
type LoginState struct {
	@json("state") State   str
	@json("email") Email   str
	@json("expires") Expires i64
}

// KeyAdd is the body of POST /tit/v1/keys.
type KeyAdd struct {
	@json("email") Email   str
	@json("key") Key       str
	@json("invite") Invite str
}

// Invite is what a server keeps of an invite.
type Invite struct {
	@json("email") Email     str
	@json("expires") Expires i64
}

// NewCode is a fresh code: 8 letters of codeLetters, "ABCD-EFGH".
fn NewCode() str {
	let r = seal.RandomBytes(8)
	mut b = make([]u8, 0, 9)
	for i in 0..8 {
		if i == 4 {
			b = append(b, '-')
		}
		b = append(b, codeLetters[i64(r[i]) % len(codeLetters)])
	}
	return str(b)
}

// codeOk reports whether s has the form of a code (a file name the server may make).
fn codeOk(s str) bool {
	if len(s) != 9 || s[4] != '-' {
		return false
	}
	for i in 0..9 {
		if i != 4 && twine.IndexByte(codeLetters, s[i]) < 0 {
			return false
		}
	}
	return true
}

fn loginTTL() i64 {
	let t = quarry.Getenv("TIT_SERVE_LOGIN_TTL")
	if len(t) == 0 {
		return LoginTTL
	}
	let n = mint.Atoi(t) catch _ {
		LoginTTL
	}
	return n
}

fn jsonReply(v str) Reply {
	return Reply{Status: 200, Body: v}
}

fn (s Server) loginDir() str {
	return s.state + "/logins"
}

// loginNew makes a login request.
fn (s mut Server) loginNew(path str, now i64) !Reply {
	if len(s.state) == 0 {
		try refusal(Code.NotFound, "this server keeps no login requests")
	}
	try quarry.MkdirAll(s.loginDir())
	let code = NewCode()
	let st = LoginState{State: "pending", Email: "", Expires: now + loginTTL()}
	try quarry.WriteFile(s.loginDir() + "/" + code, Encode(st))
	return jsonReply(Encode(LoginAnswer{Code: code, Url: path + "/" + code, Expires: st.Expires}))
}

fn (s Server) loginRead(code str, now i64) !LoginState {
	if !codeOk(code) || !quarry.Exists(s.loginDir() + "/" + code) {
		try refusal(Code.NotFound, "no login request {code}")
	}
	let text = try quarry.ReadFile(s.loginDir() + "/" + code)
	mut st = LoginState{State: "", Email: "", Expires: 0}
	try argo.Get(text, mut st)
	if st.State == "pending" && now > st.Expires {
		st.State = "expired"
	}
	return st
}

// loginApprove approves a pending login request as who, once.
fn (s mut Server) loginApprove(code str, who str, now i64) !Reply {
	let st = try s.loginRead(code, now)
	if st.State == "expired" {
		try refusal(Code.Moved, "login request {code} expired")
	}
	if st.State != "pending" {
		try refusal(Code.Moved, "login request {code} was approved already")
	}
	let next = LoginState{State: "approved", Email: who, Expires: st.Expires}
	try quarry.WriteFile(s.loginDir() + "/" + code + ".tmp", Encode(next))
	try quarry.Rename(s.loginDir() + "/" + code + ".tmp", s.loginDir() + "/" + code)
	return jsonReply(Encode(LoginState{State: "approved", Email: who, Expires: st.Expires}))
}

// MakeInvite makes a one-use invite in the server state directory dir, for email ("" for anyone): its code.
fn MakeInvite(dir str, email str, now i64) !str {
	try quarry.MkdirAll(dir + "/invites")
	let code = NewCode()
	try quarry.WriteFile(dir + "/invites/" + code, Encode(Invite{Email: email, Expires: now + InviteTTL}))
	return code
}

// keyAdd adds the key in body to the allowed keys, spending its invite; the request is signed by that key.
fn (s mut Server) keyAdd(signature str, body str, now i64) !Reply {
	if len(s.state) == 0 || len(s.keysFile) == 0 {
		try refusal(Code.NotFound, "this server takes no keys")
	}
	mut req = KeyAdd{Email: "", Key: "", Invite: ""}
	argoGet(body, mut req) catch e {
		try refusal(Code.BadRequest, fault.Message(e))
	}
	let pub = seal.B64Decode(req.Key) catch _ {
		try refusal(Code.BadRequest, "the key is not base64")
		[]u8{}
	}
	if len(pub) != 32 || len(req.Email) == 0 || twine.IndexByte(req.Email, ' ') >= 0 || twine.IndexByte(req.Email, '\n') >= 0 {
		try refusal(Code.BadRequest, "an email and a 32-byte ed25519 key, please")
	}
	// the request is signed by the key it adds: whoever sends it holds the key
	if len(signature) == 0 {
		try refusal(Code.Unauthorized, "sign the request with the key you add")
	}
	let (email, nonce, sig) = try ParseSignatureHeader(signature)
	try CheckNonce(s.key, nonce, now)
	if email != req.Email {
		try refusal(Code.Unauthorized, "signed as {email}, adding a key for {req.Email}")
	}
	seal.VerifyEd25519(pub, []u8(SigningPayloadOf("POST", "/tit/v1/keys", nonce, seal.Hex(seal.Sha256(body)))), sig) catch _ {
		try refusal(Code.Unauthorized, "the request is not signed by the key it adds")
	}
	// the invite: one use, before it expires, for this email when it names one
	if !codeOk(req.Invite) || !quarry.Exists(s.state + "/invites/" + req.Invite) {
		try refusal(Code.Unauthorized, "no invite {req.Invite} here (spent, or never made)")
	}
	let path = s.state + "/invites/" + req.Invite
	let text = try quarry.ReadFile(path)
	mut inv = Invite{Email: "", Expires: 0}
	try argo.Get(text, mut inv)
	if now > inv.Expires {
		try refusal(Code.Unauthorized, "invite {req.Invite} expired")
	}
	if len(inv.Email) > 0 && inv.Email != req.Email {
		try refusal(Code.Unauthorized, "invite {req.Invite} is for {inv.Email}")
	}
	// spent first: a crash after this leaves the key not added and the invite gone, never one invite used twice
	try quarry.Rename(path, path + ".spent")
	try quarry.AppendFile(s.keysFile, req.Email + " ed25519 " + req.Key + "\n")
	addKey(req.Email, pub)
	return jsonReply(Encode(LoginState{State: "added", Email: req.Email, Expires: 0}))
}

// addedKeys is the keys added while this core serves (§18): by its own key adds, or read again from the keys file for
// one another core added; each email's public keys, 32 bytes each, one after the other. A package global (per core),
// not the server's: the server is not changed by a request.
mut addedKeys = map[str]str{}

// addKey records a key added while serving.
fn addKey(email str, pub []u8) {
	let (have, _) = addedKeys[email]
	mut i = 0
	for i + 32 <= len(have) {
		if have[i:i + 32] == str(pub) {
			return
		}
		i += 32
	}
	addedKeys[keep(email)] = keep(have + str(pub))
}

// addedOf is the keys added for email while serving.
fn addedOf(email str) []str {
	mut out = []str{}
	let (have, _) = addedKeys[email]
	mut i = 0
	for i + 32 <= len(have) {
		out = append(out, have[i:i + 32])
		i += 32
	}
	return out
}

// reloadKeys reads the allowed keys file again (a key another core added) into addedKeys, when the server has one.
fn (s Server) reloadKeys() {
	if len(s.keysFile) == 0 || !quarry.Exists(s.keysFile) {
		return
	}
	let text = flume.ReadFile(s.keysFile) catch _ {
		return
	}
	let keys = identity.ParseSigners(text) catch _ {
		return
	}
	for k in keys {
		let (_, known) = s.keys[k.Email]
		if !known {
			addKey(k.Email, k.Public)
		}
	}
}

// loginRoute answers the §18 requests: path ends at /tit/v1/login, /tit/v1/login/<code> or /tit/v1/keys.
fn (s mut Server) loginRoute(method str, path str, signature str, body str, who str, now i64) !Reply {
	let at = twine.Index(path, "/tit/v1/")
	let tail = path[at + 8:]
	if tail == "keys" && method == "POST" {
		return try s.keyAdd(signature, body, now)
	}
	if tail == "login" && method == "POST" {
		return try s.loginNew(path, now)
	}
	if twine.HasPrefix(tail, "login/") {
		let code = tail[6:]
		if method == "GET" {
			let st = try s.loginRead(code, now)
			return jsonReply(Encode(st))
		}
		if method == "POST" {
			if len(who) == 0 {
				try refusal(Code.Unauthorized, "approve a login request with a signed request (tit login --code)")
			}
			return try s.loginApprove(code, who, now)
		}
	}
	try refusal(Code.NotFound, "no such request: {method} {path}")
	return Reply{Status: 404, Body: ""}
}
