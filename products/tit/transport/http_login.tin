package transport

import "argo"
import "wire"

// The client's sign-in requests (design/tit.md §18, #1017).

// LoginNew asks for a login request (unsigned).
fn (h mut Http) LoginNew() !LoginAnswer {
	let r = try wire.DoWith("POST", h.url + "/tit/v1/login", []str{"Content-Type", "application/x-tit"}, "", wire.Options{Timeout: 60 * 1000000000, MaxBody: MaxHeader, MaxIdle: 0})
	let body = try answer(r.Status, r.Body)
	mut a = LoginAnswer{Code: "", Url: "", Expires: 0}
	try argo.Get(body, mut a)
	return a
}

// LoginApprove approves login request code with this client's key.
fn (h mut Http) LoginApprove(code str) !LoginState {
	try h.ensureNonce()
	let body = try h.call("POST", "/tit/v1/login/" + code, "")
	mut st = LoginState{State: "", Email: "", Expires: 0}
	try argo.Get(body, mut st)
	return st
}

// KeyAdd registers this client's key (its email and public key, base64) with an invite. The server does not know the
// key yet, so the nonce is the one an unsigned heads answer or its challenge carries.
fn (h mut Http) KeyAdd(email str, pub str, invite str) !LoginState {
	let r = try wire.DoWith("GET", h.url + "/tit/v1/heads", []str{}, "", wire.Options{Timeout: 60 * 1000000000, MaxBody: MaxHeader, MaxIdle: 0})
	mut nonce = challengeNonce(r.Status, r.Body)
	if r.Status == 200 {
		let (_, header, _) = try ReadFrame(r.Body)
		mut hd = Heads{Refs: []RefHead{}, Changes: []ChangeHead{}, Nonce: "", Server: "", Limits: Limits{Pack: 0, Refs: 0}}
		try argo.Get(header, mut hd)
		nonce = hd.Nonce
	}
	h.nonce = nonce
	let body = try h.call("POST", "/tit/v1/keys", Encode(KeyAdd{Email: email, Key: pub, Invite: invite}))
	mut st = LoginState{State: "", Email: "", Expires: 0}
	try argo.Get(body, mut st)
	return st
}
