package transport

import "../change"
import "../object"
import "../packfile"
import "../store"
import "quarry"
import "sift"
import "twine"

// MemRepo is a Repo whose refs and change versions are in memory and whose packs are files under one directory
// (design/tit.md §16, #1006): the shape tinhub fills with Postgres and its pack store, small enough for tests. One
// core serves it, so Commit needs no lock: nothing else runs between its checks and its writes.
type MemRepo struct {
	dir      str
	refs     map[str]str
	versions map[str][]change.Version
	ops      i64
}

// NewMemRepo is an empty repository whose packs live in dir (made when missing).
fn NewMemRepo(dir str) !MemRepo {
	for sub in []str{"/staged", "/live", "/retired"} {
		try quarry.MkdirAll(dir + sub)
	}
	return MemRepo{dir: dir, refs: map[str]str{}, versions: map[str][]change.Version{}, ops: 0}
}

// Ref is the ref called name, or nil.
fn (m MemRepo) Ref(name str) !?change.Ref {
	let (text, ok) = m.refs[name]
	if !ok {
		return nil
	}
	let t = try change.ParseTarget(text)
	return change.Ref{Name: name, Target: t}
}

// Refs is every ref whose name starts with prefix, in name order.
fn (m MemRepo) Refs(prefix str) ![]change.Ref {
	mut names = []str{}
	for name, _ in m.refs {
		if twine.HasPrefix(name, prefix) {
			names = append(names, name)
		}
	}
	sift.Sort(mut names)
	mut out = []change.Ref{}
	for name in names {
		let t = try change.ParseTarget(m.refs[name])
		out = append(out, change.Ref{Name: name, Target: t})
	}
	return out
}

// Newest is the change's newest version, or nil.
fn (m MemRepo) Newest(c object.ChangeId) !?change.Version {
	let (vs, ok) = m.versions[c.Letters()]
	if !ok || len(vs) == 0 {
		return nil
	}
	return vs[len(vs) - 1]
}

// Objects is every live pack's objects.
fn (m MemRepo) Objects() !store.Layered {
	let packs = try m.Packs()
	mut layers = []dyn store.ObjectStore{}
	for p in packs {
		layers = append(layers, p)
	}
	return store.NewLayered(layers)
}

// Packs is the live packs.
fn (m MemRepo) Packs() ![]packfile.Pack {
	mut out = []packfile.Pack{}
	let names = try quarry.ReadDir(m.dir + "/live")
	for n in names {
		if twine.HasSuffix(n, ".pack") {
			let p = try packfile.Open(m.dir + "/live/" + n)
			out = append(out, p)
		}
	}
	return out
}

// TempDir is where packs are written before Stage.
fn (m MemRepo) TempDir() str {
	return m.dir + "/staged"
}

// Stage makes the pack at path pending, moving it into the staged directory when it is elsewhere.
fn (m MemRepo) Stage(pack str) !Staged {
	if !twine.HasSuffix(pack, ".pack") {
		try refusal(Code.Internal, "{pack} is not a .pack file")
	}
	let base = pack[0:len(pack) - 5]
	let name = baseName(base)
	let to = m.dir + "/staged/" + name
	if base != to {
		try quarry.Rename(base + ".idx", to + ".idx")
		try quarry.Rename(base + ".pack", to + ".pack")
	}
	return Staged{Name: name}
}

// Commit checks u again and makes it current: the pack live, the refs moved, the versions added.
fn (m mut MemRepo) Commit(u Update) !i64 {
	try recheck(mut m, u)
	if len(u.Pack) > 0 {
		let from = m.dir + "/staged/" + u.Pack
		let to = m.dir + "/live/" + u.Pack
		if !quarry.Exists(from + ".pack") {
			try refusal(Code.Internal, "no staged pack {u.Pack}")
		}
		try quarry.Rename(from + ".idx", to + ".idx")
		try quarry.Rename(from + ".pack", to + ".pack")
	}
	if len(u.Refs) == 0 && len(u.Changes) == 0 {
		return 0
	}
	m.ops += 1
	for ru in u.Refs {
		if len(ru.New) == 0 {
			delete(m.refs, ru.Name)
		} else {
			m.refs[keep(ru.Name)] = keep(ru.New)
		}
	}
	for cu in u.Changes {
		let id = try object.ParseId(cu.Commit)
		let (vs, _) = m.versions[cu.Change]
		mut next = []change.Version{}
		for v in vs {
			next = append(next, v)
		}
		next = append(next, change.NewVersion(m.ops, id, u.Time))
		m.versions[keep(cu.Change)] = keep(next)
	}
	return m.ops
}

// Drop deletes a pending pack.
fn (m MemRepo) Drop(s Staged) !bool {
	let base = m.dir + "/staged/" + s.Name
	if !quarry.Exists(base + ".pack") {
		return false
	}
	try quarry.Remove(base + ".pack")
	quarry.Remove(base + ".idx") catch _ {
	}
	return true
}

// Retire moves live packs to the retired directory.
fn (m MemRepo) Retire(names []str) !i64 {
	mut n = 0
	for name in names {
		let from = m.dir + "/live/" + name
		if !quarry.Exists(from + ".pack") {
			continue
		}
		try quarry.Rename(from + ".pack", m.dir + "/retired/" + name + ".pack")
		try quarry.Rename(from + ".idx", m.dir + "/retired/" + name + ".idx")
		n += 1
	}
	return n
}
