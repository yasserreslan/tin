package transport

import "argo"
import "constraints"
import "fault"
import "pack"
import "seal"
import "twine"

// The tit protocol, version 1 (design/tit.md section 15; #794): the messages, their frames, nonces and the bytes a
// request signature covers. The client (#795) and tit serve (#796) build on these.

// ErrRefused is the fault of a request the server refused; its text holds the Code and the server's message.
let ErrRefused = fault("the server refused the request")

// ErrBadFrame is the fault of a body that is not a version 1 frame.
let ErrBadFrame = fault("not a tit v1 message")

// Version is the protocol version, in every frame and every path (/tit/v1/).
const Version = 1

// MaxHeader is the largest header a frame may hold: 16 MiB.
const MaxHeader = 16 * 1024 * 1024

// NonceLife is how long a nonce is good for, in seconds.
const NonceLife = 60

// Kind is what a frame carries.
type Kind enum {
	HeadsAnswer
	FetchRequest
	FetchAnswer
	PushRequest
	PushAnswer
	Error
}

// Code is why a server refused a request.
type Code enum {
	BadRequest
	Unauthorized
	NonceExpired
	NotFound
	Moved
	RefChanged
	Conflicted
	BadPack
	BadSignature
	TooLarge
	Internal
}

// RefHead is one ref the server has: its name and its target as a ref file writes it.
type RefHead struct {
	Name   str
	Target str
}

// ChangeHead is the newest version of a change a ref follows.
type ChangeHead struct {
	Change  str
	Version i64
	Commit  str
}

// Limits are what the server takes.
type Limits struct {
	Pack i64
	Refs i64
}

// Heads is the answer to GET /tit/v1/heads.
type Heads struct {
	Refs    []RefHead
	Changes []ChangeHead
	Nonce   str
	Server  str
	Limits  Limits
}

// FetchRequest is POST /tit/v1/fetch: the commits wanted and the tips the client has (hex ids).
type FetchRequest struct {
	Wants []str
	Haves []str
	// NoBlobs leaves file contents out (a lazy clone, #803); Objects asks for exactly these objects instead of a walk
	NoBlobs bool
	Objects []str
}

// FetchAnswer is the header of a fetch answer; the pack follows it.
type FetchAnswer struct {
	Objects i64
}

// ChangeUpdate is one change a push moves: its new commit, and the version (commit, hex) it replaces ("" when new).
type ChangeUpdate struct {
	Change   str
	Replaces str
	Commit   str
}

// RefUpdate is one ref a push moves, by compare-and-swap: old and new targets as a ref file writes them ("" for
// none).
type RefUpdate struct {
	Name str
	Old  str
	New  str
}

// PushRequest is the header of POST /tit/v1/push; the pack follows it.
type PushRequest struct {
	Changes []ChangeUpdate
	Refs    []RefUpdate
}

// PushAnswer is the refs a push moved.
type PushAnswer struct {
	Refs []str
}

// ErrorAnswer is the header of an error frame. Unauthorized and NonceExpired carry a fresh nonce to sign with.
type ErrorAnswer struct {
	Code    str
	Message str
	Ref     str
	Nonce   str
}

// Transport is a way to reach a tit repository: the HTTP client (#795) or an in-process server in tests.
shape Transport {
	mut Heads() !Heads
	mut Fetch(req FetchRequest) !(FetchAnswer, str)
	mut Push(req PushRequest, pack str) !PushAnswer
}

fn kindByte(k Kind) i64 {
	return match k {
		HeadsAnswer => 1
		FetchRequest => 2
		FetchAnswer => 3
		PushRequest => 4
		PushAnswer => 5
		Error => 6
	}
}

fn kindOf(b i64) !Kind {
	if b == 1 {
		return Kind.HeadsAnswer
	}
	if b == 2 {
		return Kind.FetchRequest
	}
	if b == 3 {
		return Kind.FetchAnswer
	}
	if b == 4 {
		return Kind.PushRequest
	}
	if b == 5 {
		return Kind.PushAnswer
	}
	if b == 6 {
		return Kind.Error
	}
	fail fault.Wrap(ErrBadFrame, "kind {b}")
}

// CodeName is a code as messages write it.
fn CodeName(c Code) str {
	return match c {
		BadRequest => "BadRequest"
		Unauthorized => "Unauthorized"
		NonceExpired => "NonceExpired"
		NotFound => "NotFound"
		Moved => "Moved"
		RefChanged => "RefChanged"
		Conflicted => "Conflicted"
		BadPack => "BadPack"
		BadSignature => "BadSignature"
		TooLarge => "TooLarge"
		Internal => "Internal"
	}
}

// ParseCode reads a code's name; an unknown name is Internal (a newer server's code this client does not know).
fn ParseCode(s str) Code {
	for c in []Code{Code.BadRequest, Code.Unauthorized, Code.NonceExpired, Code.NotFound, Code.Moved, Code.RefChanged, Code.Conflicted, Code.BadPack, Code.BadSignature, Code.TooLarge, Code.Internal} {
		if CodeName(c) == s {
			return c
		}
	}
	return Code.Internal
}

// Status is the HTTP status a server answers a code with.
fn Status(c Code) i64 {
	return match c {
		BadRequest => 400
		Unauthorized => 401
		NonceExpired => 401
		BadSignature => 403
		NotFound => 404
		Moved => 409
		RefChanged => 409
		Conflicted => 409
		BadPack => 400
		TooLarge => 413
		Internal => 500
	}
}

// Frame is a message: "TITP", the version, the kind, the header's length (u32 little-endian), the header, then the
// pack ("" for kinds without one).
fn Frame(k Kind, header str, packData str) str {
	mut out = make([]u8, 0, 10 + len(header) + len(packData))
	out = append(out, []u8("TITP")...)
	out = append(out, u8(Version), u8(kindByte(k)))
	let n = len(header)
	out = append(out, u8(n & 0xff), u8((n >> 8) & 0xff), u8((n >> 16) & 0xff), u8((n >> 24) & 0xff))
	out = append(out, []u8(header)...)
	out = append(out, []u8(packData)...)
	return str(out)
}

// ReadFrame splits a message into its kind, its header and what follows (the pack, if any).
fn ReadFrame(body str) !(Kind, str, str) {
	if len(body) < 10 || body[0:4] != "TITP" {
		fail fault.Wrap(ErrBadFrame, "no TITP magic")
	}
	if i64(body[4]) != Version {
		fail fault.Wrap(ErrBadFrame, "version {i64(body[4])}")
	}
	let k = try kindOf(i64(body[5]))
	let n = i64(pack.LE.U32([]u8(body[6:10])))
	if n > MaxHeader || 10 + n > len(body) {
		fail fault.Wrap(ErrBadFrame, "a header of {n} bytes")
	}
	return k, body[10:10 + n], body[10 + n:]
}

// Encode is a message's header as JSON.
fn Encode[T constraints.Any](v T) str {
	mut b = make([]u8, 0, 256)
	argo.Put(mut b, v)
	return str(b)
}

// Refused fails with the fault of an error answer: ErrRefused, with its code and message.
fn Refused(e ErrorAnswer) ! {
	if len(e.Ref) > 0 {
		fail fault.Wrap(ErrRefused, e.Code + " (" + e.Ref + "): " + e.Message)
	}
	fail fault.Wrap(ErrRefused, e.Code + ": " + e.Message)
}

fn be64(v i64) []u8 {
	mut out = make([]u8, 8)
	for i in 0..8 {
		out[7 - i] = u8((v >> (8 * i)) & 0xff)
	}
	return out
}

// NewNonce is a nonce for the time now (unix seconds): the time, 16 random bytes and the server's HMAC of both, in
// base64. Any node that holds the secret checks it, with no shared store.
fn NewNonce(key secret str, now i64) str {
	mut raw = be64(now)
	raw = append(raw, seal.RandomBytes(16)...)
	let mac = seal.Hmac(seal.Hash.SHA256, key, str(raw))
	raw = append(raw, mac...)
	return seal.B64(raw)
}

// CheckNonce checks a nonce's HMAC and that it is younger than NonceLife seconds at now.
fn CheckNonce(key secret str, nonce str, now i64) ! {
	let raw = seal.B64Decode(nonce) catch _ {
		fail fault.Wrap(ErrRefused, "NonceExpired: the nonce is not base64")
	}
	if len(raw) != 56 {
		fail fault.Wrap(ErrRefused, "NonceExpired: the nonce has {len(raw)} bytes")
	}
	let want = seal.Hmac(seal.Hash.SHA256, key, str(raw[0:24]))
	if !seal.ConstantTimeEq(want, raw[24:56]) {
		fail fault.Wrap(ErrRefused, "NonceExpired: the nonce is not this server's")
	}
	mut at = 0
	for i in 0..8 {
		at = (at << 8) | i64(raw[i])
	}
	if now - at >= NonceLife || at > now + 5 {
		fail fault.Wrap(ErrRefused, "NonceExpired: the nonce is {now - at} s old")
	}
}

// SignatureHeader is the Tit-Signature header's value: the signer's email, the nonce and the signature.
fn SignatureHeader(email str, nonce str, sig []u8) str {
	return email + " " + nonce + " " + seal.B64(sig)
}

// ParseSignatureHeader splits a Tit-Signature header into the email, the nonce and the signature.
fn ParseSignatureHeader(h str) !(str, str, []u8) {
	let parts = twine.Split(h, " ")
	if len(parts) != 3 {
		fail fault.Wrap(ErrRefused, "Unauthorized: Tit-Signature has {len(parts)} fields, not 3")
	}
	let sig = seal.B64Decode(parts[2]) catch _ {
		fail fault.Wrap(ErrRefused, "Unauthorized: the signature is not base64")
	}
	if len(sig) != 64 {
		fail fault.Wrap(ErrRefused, "Unauthorized: a signature of {len(sig)} bytes")
	}
	return parts[0], parts[1], sig
}

// SigningPayload is the bytes a request's ed25519 signature covers.
fn SigningPayload(method str, path str, nonce str, body str) str {
	return SigningPayloadOf(method, path, nonce, seal.Hex(seal.Sha256(body)))
}

// SigningPayloadOf is SigningPayload for a body whose SHA-256 (hex) is bodyHash: a body streamed through a hasher.
fn SigningPayloadOf(method str, path str, nonce str, bodyHash str) str {
	return "tit v1 " + method + " " + path + "\n" + nonce + "\n" + bodyHash + "\n"
}
