package transport

import "argo"
import "fault"
import "flume"
import "pack"
import "quarry"
import "seal"
import "wire"

// The client's streamed requests (#1009): a fetch's pack goes from the connection to a file a buffer at a time, where
// packfile.KeepFile indexes it as it lies, and a push's pack goes from its file to the connection; a clone or a push
// of gigabytes takes the memory of a few buffers. The response is read inside wire (wire.DoStreamTo): reading a
// wire.Stream from here trips a false E312 in the region pass (#1036).

// strReader reads a string.
type strReader struct {
	s  str
	at i64
}

// Read gives the next bytes of the string.
fn (r mut strReader) Read(buf mut []u8) !i64 {
	if r.at >= len(r.s) {
		return 0
	}
	let n = min(len(buf), len(r.s) - r.at)
	for i in 0..n {
		buf[i] = r.s[r.at + i]
	}
	r.at += n
	return n
}

// pushBody reads a push's frame and header, then its pack file.
type pushBody struct {
	head strReader
	file flume.Reader
	open bool
}

// Read gives the frame and header first, then the pack.
fn (b mut pushBody) Read(buf mut []u8) !i64 {
	let n = try b.head.Read(mut buf)
	if n > 0 || !b.open {
		return n
	}
	return try b.file.Read(mut buf)
}

// small collects a short answer (a push's, an error frame) in memory, refusing more than most bytes.
type small struct {
	b    []u8
	most i64
}

// Write keeps data.
fn (s mut small) Write(data []u8) !i64 {
	if len(s.b) + len(data) > s.most {
		fail fault.Wrap(ErrBadFrame, "an answer longer than {s.most} bytes")
	}
	s.b = append(s.b, data...)
	return len(data)
}

// framed takes a fetch answer as it arrives: its frame and header in memory, the pack after them into a new file at
// path (made on the first byte of the pack). An error frame stays in memory whole.
type framed struct {
	head   []u8
	need   i64
	path   str
	file   flume.Writer
	open   bool
	size   i64
	errors bool
}

// Write takes the next bytes of the answer.
fn (f mut framed) Write(data []u8) !i64 {
	mut at = 0
	for at < len(data) {
		if f.need < 0 && len(f.head) >= 10 {
			if f.head[0] != 'T' || f.head[1] != 'I' || f.head[2] != 'T' || f.head[3] != 'P' {
				fail fault.Wrap(ErrBadFrame, "no TITP magic in the answer")
			}
			let n = i64(pack.LE.U32(f.head[6:10]))
			if n > MaxHeader {
				fail fault.Wrap(ErrBadFrame, "a header of {n} bytes")
			}
			f.need = 10 + n
			f.errors = i64(f.head[5]) != kindByte(Kind.FetchAnswer)
		}
		if f.need < 0 || len(f.head) < f.need || f.errors {
			// the frame and header (or a whole error answer, bounded) in memory
			mut take = len(data) - at
			if f.need < 0 {
				take = min(take, 10 - len(f.head))
			} else if !f.errors {
				take = min(take, f.need - len(f.head))
			}
			if len(f.head) + take > MaxHeader + 64 {
				fail fault.Wrap(ErrBadFrame, "an answer's header longer than {MaxHeader} bytes")
			}
			f.head = append(f.head, data[at:at + take]...)
			at += take
			continue
		}
		// the pack, in pieces of at most 64 KiB (a larger write grows flume's buffer each time)
		if !f.open {
			f.file = try flume.CreateExcl(f.path)
			f.open = true
		}
		let piece = min(len(data) - at, 64 << 10)
		_ = try f.file.Write(data[at:at + piece])
		f.size += piece
		at += piece
	}
	return len(data)
}

// fileHash is the SHA-256 (hex) of head followed by the file at path ("" for none), and the file's size.
fn fileHash(head str, path str) !(str, i64) {
	mut h = seal.NewSha256()
	h.WriteStr(head)
	if len(path) == 0 {
		return seal.Hex(h.Sum()), 0
	}
	mut r = try flume.Open(path)
	mut buf = make([]u8, 1 << 20)
	mut size = 0
	for {
		let k = r.Read(mut buf) catch e {
			r.Close()
			fail e
		}
		if k == 0 {
			break
		}
		_ = try h.Write(buf[0:k])
		size += k
	}
	r.Close()
	return seal.Hex(h.Sum()), size
}

// headers are a request's fields: its type and, when this client signs, its signature over a body hashing to hash.
fn (h mut Http) headers(method str, req str, hash str) ![]str {
	mut out = []str{"Content-Type", "application/x-tit"}
	if len(h.email) > 0 && len(h.nonce) > 0 {
		let s = try h.sign(SigningPayloadOf(method, h.path + req, h.nonce, hash))
		out = append(out, "Tit-Signature", SignatureHeader(h.email, h.nonce, s))
	}
	return out
}

// challenge is the fresh nonce a refused request was answered with, "" for none.
type challenge struct {
	nonce str
}

// FetchTo asks for what req wants and writes the answer's pack to a new file at path (none when the answer has no
// pack), as it arrives; it gives the answer's header. A challenge (a fresh nonce) is answered once.
fn (h mut Http) FetchTo(req FetchRequest, path str) !FetchAnswer {
	let body = Frame(Kind.FetchRequest, Encode(req), "")
	let hash = seal.Hex(seal.Sha256(body))
	let url = h.url + "/tit/v1/fetch"
	let first = try h.headers("POST", "/tit/v1/fetch", hash)
	mut ch = challenge{nonce: ""}
	let a = try fetchOnce(url, first, body, path, mut ch)
	if len(ch.nonce) == 0 {
		return a
	}
	h.nonce = ch.nonce
	ch.nonce = ""
	let again = try h.headers("POST", "/tit/v1/fetch", hash)
	let b = try fetchOnce(url, again, body, path, mut ch)
	if len(ch.nonce) > 0 {
		fail fault.Wrap(ErrRefused, "Unauthorized: the server refused the signature twice")
	}
	return b
}

// fetchOnce sends one fetch and gives its answer; a challenge sets ch's nonce instead, to sign with and send again.
fn fetchOnce(url str, hs []str, body str, path str, ch mut challenge) !FetchAnswer {
	mut f = framed{head: []u8{}, need: -1, path: path, file: flume.Writer{}, open: false, size: 0, errors: false}
	let (r, err) = wire.DoStreamTo("POST", url, hs, strReader{s: body, at: 0}, wire.Options{Timeout: 3600 * 1000000000, MaxBody: 1 << 42, MaxIdle: 0}, mut f)
	if f.open {
		f.file.Close() catch _ {
		}
	}
	mut a = FetchAnswer{Objects: 0}
	if err != nil || r.Status != 200 || f.errors {
		if f.open {
			quarry.Remove(path) catch _ {
			}
		}
		if err != nil {
			fail err
		}
		let text = str(f.head)
		let n = challengeNonce(r.Status, text)
		if len(n) > 0 {
			ch.nonce = keep(n)
			return a
		}
		_ = try answer(r.Status, text)
		fail fault.Wrap(ErrRefused, "Internal: status {r.Status}")
	}
	if f.need < 0 || len(f.head) < f.need {
		fail fault.Wrap(ErrBadFrame, "the fetch answer ends inside its header")
	}
	try argo.Get(str(f.head[10:f.need]), mut a)
	return a
}

// PushFile sends req with the pack in the file at path ("" for none), streamed from the file, signed with the nonce
// of the last heads or challenge. A challenge is answered once.
fn (h mut Http) PushFile(req PushRequest, path str) !PushAnswer {
	let head = Frame(Kind.PushRequest, Encode(req), "")
	let (hash, size) = try fileHash(head, path)
	let url = h.url + "/tit/v1/push"
	let first = try h.headers("POST", "/tit/v1/push", hash)
	mut ch = challenge{nonce: ""}
	let a = try pushOnce(url, first, head, path, size, mut ch)
	if len(ch.nonce) == 0 {
		return a
	}
	h.nonce = ch.nonce
	ch.nonce = ""
	let again = try h.headers("POST", "/tit/v1/push", hash)
	let b = try pushOnce(url, again, head, path, size, mut ch)
	if len(ch.nonce) > 0 {
		fail fault.Wrap(ErrRefused, "Unauthorized: the server refused the signature twice")
	}
	return b
}

// pushOnce sends one push and gives its answer; a challenge sets ch's nonce instead, to sign with and send again.
fn pushOnce(url str, signed []str, head str, path str, size i64, ch mut challenge) !PushAnswer {
	mut hs = []str{}
	for x in signed {
		hs = append(hs, x)
	}
	hs = append(hs, "Content-Length", "{len(head) + size}")
	mut b = pushBody{head: strReader{s: head, at: 0}, file: flume.Reader{}, open: false}
	if len(path) > 0 {
		b.file = try flume.Open(path)
		b.open = true
	}
	mut out = small{b: []u8{}, most: MaxHeader + 64}
	let (r, err) = wire.DoStreamTo("POST", url, hs, b, wire.Options{Timeout: 3600 * 1000000000, MaxBody: MaxHeader + 64, MaxIdle: 0}, mut out)
	if b.open {
		b.file.Close()
	}
	if err != nil {
		fail err
	}
	let text = str(out.b)
	if r.Status != 200 {
		let n = challengeNonce(r.Status, text)
		if len(n) > 0 {
			ch.nonce = keep(n)
			return PushAnswer{Refs: []str{}}
		}
	}
	let ok = try answer(r.Status, text)
	let (_, header, _) = try ReadFrame(ok)
	return try decodePushAnswer(header)
}

// decodePushAnswer reads a push answer's header.
fn decodePushAnswer(header str) !PushAnswer {
	mut a = PushAnswer{Refs: []str{}}
	try argo.Get(header, mut a)
	return a
}
