package transport

import "argo"
import "fault"

// The client's replay requests (design/tit.md §17, #1027). Each is signed: the nonce comes from a heads request first.

// ReplayPush sends one capsule (its file name and the commit that served it).
fn (h mut Http) ReplayPush(commit str, name str, data str) !ReplayAnswer {
	try h.ensureNonce()
	let body = try h.call("POST", "/tit/v1/replay", Frame(Kind.ReplayPush, Encode(ReplayPushHeader{Commit: commit, Name: name}), data))
	let (_, header, _) = try ReadFrame(body)
	mut a = ReplayAnswer{Id: "", Group: "", New: false}
	try argo.Get(header, mut a)
	return a
}

// ReplayList is the server's capsules, newest first.
fn (h mut Http) ReplayList() !ReplayList {
	try h.ensureNonce()
	let body = try h.call("GET", "/tit/v1/replay", "")
	let (_, header, _) = try ReadFrame(body)
	mut l = ReplayList{Capsules: []ReplayEntry{}}
	try argo.Get(header, mut l)
	return l
}

// ReplayGet fetches one capsule by its full id: its header and its bytes.
fn (h mut Http) ReplayGet(id str) !(ReplayGot, str) {
	try h.ensureNonce()
	let body = try h.call("GET", "/tit/v1/replay/" + id, "")
	let (k, header, data) = try ReadFrame(body)
	if k != Kind.ReplayCapsule {
		fail fault.Wrap(ErrBadFrame, "a capsule fetch answered with another kind of message")
	}
	mut g = ReplayGot{Id: "", Name: "", Commit: ""}
	try argo.Get(header, mut g)
	return g, data
}

// ensureNonce asks for the server's heads once, for a nonce to sign with.
fn (h mut Http) ensureNonce() ! {
	if len(h.nonce) == 0 && len(h.email) > 0 {
		_ = try h.Heads()
	}
}
