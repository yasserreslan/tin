package transport

import "../object"
import "../store"
import "crucible"
import "quarry"
import "seal"
import "twine"

// Tests for streamed pushes (#1009): through HandleStream, a body read a piece at a time; refusals before the body
// is read; hostile packs; nothing left behind; a large push in a small memory budget.

// pieces reads a string a few bytes at a time, as a socket gives a body.
type pieces struct {
	s    str
	at   i64
	step i64
}

fn (p mut pieces) Read(buf mut []u8) !i64 {
	if p.at >= len(p.s) {
		return 0
	}
	let n = min(min(len(buf), p.step), len(p.s) - p.at)
	for i in 0..n {
		buf[i] = p.s[p.at + i]
	}
	p.at += n
	return n
}

// signedPush is a push request's body and its Tit-Signature, signed by seed as ada@example.com with a fresh nonce.
fn signedPush(seed []u8, req PushRequest, pack str, now i64) (str, str) {
	let body = Frame(Kind.PushRequest, Encode(req), pack)
	let nonce = NewNonce("secret", now)
	let sig = seal.SignEd25519(seed, []u8(SigningPayload("POST", "/tit/v1/push", nonce, body))) catch _ {
		[]u8{}
	}
	return body, SignatureHeader("ada@example.com", nonce, sig)
}

// stagedFiles is the files a push may leave in the repository's temporary directory.
fn stagedFiles(dir str) i64 {
	let names = quarry.ReadDir(dir + "/packs/staged") catch _ {
		return 0
	}
	return len(names)
}

fn TestStreamedPush(t mut crucible.T) {
	let dir = repo("stream")
	let (seed, pub) = keyPair()
	mut server = NewServer(dir, "secret", false)
	server.Allow("ada@example.com", pub)
	let now = 1700000000
	mut client = store.NewMem()
	let c1 = commitIn(mut client, "a.txt", "one\n", []object.Id{}, object.NewChangeId(), 1700000000)
	let pack = packOf(mut client, everything(mut client, c1))
	let req = PushRequest{Changes: []ChangeUpdate{}, Refs: []RefUpdate{RefUpdate{Name: "refs/heads/main", Old: "", New: c1.Hex()}}}
	// refused before a byte of the body is read: unsigned, and signed by a stranger
	let (body, sig) = signedPush(seed, req, pack, now)
	mut unread = pieces{s: body, at: 0, step: 7}
	let r1 = HandleStream(mut server, "POST", "/tit/v1/push", "", mut unread, now)
	crucible.Equal(mut t, "unsigned", r1.Status, 401)
	crucible.Equal(mut t, "the body is not read", unread.at, 0)
	let (strangerSeed, _) = keyPair()
	let nonce = NewNonce("secret", now)
	let other = seal.SignEd25519(strangerSeed, []u8("x")) catch _ {
		[]u8{}
	}
	mut unread2 = pieces{s: body, at: 0, step: 7}
	let r2 = HandleStream(mut server, "POST", "/tit/v1/push", SignatureHeader("eve@example.com", nonce, other), mut unread2, now)
	crucible.Equal(mut t, "a stranger", r2.Status, 401)
	crucible.Equal(mut t, "the stranger's body is not read", unread2.at, 0)
	// a body changed after it was signed: read, then refused, nothing left
	let tampered = body[0:len(body) - 40] + "x" + body[len(body) - 39:]
	mut tb = pieces{s: tampered, at: 0, step: 4096}
	let r3 = HandleStream(mut server, "POST", "/tit/v1/push", sig, mut tb, now)
	crucible.Equal(mut t, "a tampered body", r3.Status, 401)
	crucible.Equal(mut t, "nothing staged", stagedFiles(dir), 0)
	// the push itself, a few bytes at a time
	let (body2, sig2) = signedPush(seed, req, pack, now)
	mut good = pieces{s: body2, at: 0, step: 13}
	let r4 = HandleStream(mut server, "POST", "/tit/v1/push", sig2, mut good, now)
	crucible.Equal(mut t, "pushed: {r4.Body}", r4.Status, 200)
	crucible.Equal(mut t, "main moved", refOf(dir, "refs/heads/main"), c1.Hex())
	crucible.Equal(mut t, "nothing left staged", stagedFiles(dir), 0)
	quarry.RemoveAll(dir) catch _ {
	}
}

fn TestStreamedHostile(t mut crucible.T) {
	let dir = repo("hostile")
	let (seed, pub) = keyPair()
	mut server = NewServer(dir, "secret", false)
	server.Allow("ada@example.com", pub)
	let now = 1700000000
	mut client = store.NewMem()
	let c1 = commitIn(mut client, "a.txt", "one\n", []object.Id{}, object.NewChangeId(), 1700000000)
	let pack = packOf(mut client, everything(mut client, c1))
	let req = PushRequest{Changes: []ChangeUpdate{}, Refs: []RefUpdate{RefUpdate{Name: "refs/heads/main", Old: "", New: c1.Hex()}}}
	mut bad = []str{}
	// cut short, a byte flipped in an entry, the trailing hash wrong, bytes after the trailer, nothing but a header
	bad = append(bad, pack[0:len(pack) / 2])
	bad = append(bad, pack[0:30] + "\xff" + pack[31:])
	bad = append(bad, pack[0:len(pack) - 1] + "\x00")
	bad = append(bad, pack + "extra")
	bad = append(bad, "TITPACK")
	for i, p in bad {
		let (body, sig) = signedPush(seed, req, p, now)
		mut b = pieces{s: body, at: 0, step: 64}
		let r = HandleStream(mut server, "POST", "/tit/v1/push", sig, mut b, now)
		crucible.Equal(mut t, "hostile {i}: refused", r.Status, 400)
		t.True("hostile {i}: BadPack", twine.Contains(r.Body, "BadPack"))
		crucible.Equal(mut t, "hostile {i}: main unchanged", refOf(dir, "refs/heads/main"), "")
		crucible.Equal(mut t, "hostile {i}: nothing left", stagedFiles(dir), 0)
	}
	// larger than the server takes: TooLarge as it arrives
	server.SetLimits(Limits{Pack: 64, Refs: 10})
	let (body, sig) = signedPush(seed, req, pack, now)
	mut big = pieces{s: body, at: 0, step: 16}
	let r = HandleStream(mut server, "POST", "/tit/v1/push", sig, mut big, now)
	crucible.Equal(mut t, "too large", r.Status, 413)
	t.True("stopped reading", big.at < len(body))
	crucible.Equal(mut t, "too large: nothing left", stagedFiles(dir), 0)
	// a frame that is not a push's
	server.SetLimits(Limits{Pack: 1 << 30, Refs: 10})
	let wrong = Frame(Kind.FetchRequest, "{{}}", "")
	let nonce = NewNonce("secret", now)
	let wsig = seal.SignEd25519(seed, []u8(SigningPayload("POST", "/tit/v1/push", nonce, wrong))) catch _ {
		[]u8{}
	}
	mut w = pieces{s: wrong, at: 0, step: 3}
	let rw = HandleStream(mut server, "POST", "/tit/v1/push", SignatureHeader("ada@example.com", nonce, wsig), mut w, now)
	crucible.Equal(mut t, "a fetch frame on push", rw.Status, 400)
	quarry.RemoveAll(dir) catch _ {
	}
}

// A push of many large blobs streams through a memory budget far below its size: the pack is never held whole.
fn TestStreamedPushMemory(t mut crucible.T) {
	let dir = repo("memory")
	let (seed, pub) = keyPair()
	mut server = NewServer(dir, "secret", false)
	server.Allow("ada@example.com", pub)
	let now = 1700000000
	mut client = store.NewMem()
	mut entries = []object.Entry{}
	mut ids = []object.Id{}
	for i in 0..240 {
		// 256 KiB of random bytes: no compression, no deltas
		let body = str(seal.RandomBytes(256 * 1024))
		let id = client.PutRaw(object.Kind.Blob, body) catch _ {
			object.NoId
		}
		entries = append(entries, object.Entry{Mode: object.Mode.File, Name: "f{i:03}", Id: id})
		ids = append(ids, id)
	}
	let tree = client.Put(object.Object.Tree(entries)) catch _ {
		object.NoId
	}
	let c = object.CommitData{Tree: tree, Parents: []object.Id{}, Change: object.NewChangeId(), Author: person(now), Committer: person(now), GitHeaders: []str{}, Signature: "", Message: "big\n", Conflicts: []str{}}
	let c1 = client.Put(object.Object.Commit(c)) catch _ {
		object.NoId
	}
	ids = append(ids, tree, c1)
	let pack = packOf(mut client, ids)
	t.True("a pack of more than 56 MiB", len(pack) > 56 << 20)
	let req = PushRequest{Changes: []ChangeUpdate{}, Refs: []RefUpdate{RefUpdate{Name: "refs/heads/main", Old: "", New: c1.Hex()}}}
	let (body, sig) = signedPush(seed, req, pack, now)
	mut b = pieces{s: body, at: 0, step: 1 << 20}
	let r = limit memory 32mb {
		HandleStream(mut server, "POST", "/tit/v1/push", sig, mut b, now)
	} catch e {
		t.Error("the push went over its budget: {e}")
		Reply{Status: 0, Body: ""}
	}
	crucible.Equal(mut t, "pushed in 32 MiB: {r.Body}", r.Status, 200)
	crucible.Equal(mut t, "main moved", refOf(dir, "refs/heads/main"), c1.Hex())
	quarry.RemoveAll(dir) catch _ {
	}
}
