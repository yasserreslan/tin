package transport

import "argo"
import "crucible"
import "fault"
import "seal"
import "twine"

// Tests for the protocol's frames, nonces and signatures (#794).

fn TestFrames(t mut crucible.T) {
	let req = PushRequest{Changes: []ChangeUpdate{ChangeUpdate{Change: "kkzz", Replaces: "", Commit: "ab"}}, Refs: []RefUpdate{RefUpdate{Name: "refs/heads/main", Old: "", New: "ab"}}}
	let body = Frame(Kind.PushRequest, Encode(req), "TITPACK...")
	let (k, header, rest, err) = ReadFrame(body)
	t.NoFault("read", err)
	t.True("kind", k == Kind.PushRequest)
	crucible.Equal(mut t, "the pack follows", rest, "TITPACK...")
	mut back = PushRequest{Changes: []ChangeUpdate{}, Refs: []RefUpdate{}}
	t.NoFault("decode", argo.Get(header, mut back))
	crucible.Equal(mut t, "change", back.Changes[0].Change, "kkzz")
	crucible.Equal(mut t, "ref", back.Refs[0].Name, "refs/heads/main")
	for bad in []str{"", "TITQ\x01\x04\x00\x00\x00\x00", "TITP\x02\x04\x00\x00\x00\x00", "TITP\x01\x09\x00\x00\x00\x00", "TITP\x01\x04\xff\x00\x00\x00{{}}"} {
		let (_, _, _, e) = ReadFrame(bad)
		t.True("rejected: " + seal.Hex([]u8(bad)), e != nil && fault.Is(e, ErrBadFrame))
	}
}

fn TestCodes(t mut crucible.T) {
	crucible.Equal(mut t, "name", CodeName(Code.Moved), "Moved")
	t.True("parse", ParseCode("RefChanged") == Code.RefChanged)
	t.True("unknown is Internal", ParseCode("FromTheFuture") == Code.Internal)
	crucible.Equal(mut t, "status", Status(Code.TooLarge), 413)
	let err = Refused(ErrorAnswer{Code: "Moved", Message: "kkzz has a newer version", Ref: ""})
	t.True("refused", err != nil && fault.Is(err, ErrRefused) && twine.Contains(fault.Message(err), "Moved: kkzz"))
}

fn TestNonce(t mut crucible.T) {
	let key = "server secret"
	let n = NewNonce(key, 1700000000)
	t.NoFault("fresh", CheckNonce(key, n, 1700000030))
	let old = CheckNonce(key, n, 1700000060)
	t.True("a minute old", old != nil && twine.Contains(fault.Message(old), "NonceExpired"))
	let other = CheckNonce("another server", n, 1700000001)
	t.True("another server's", other != nil)
	let raw = seal.B64Decode(n) catch _ {
		[]u8{}
	}
	// a nonce with its time moved on, its HMAC unchanged
	mut moved = make([]u8, len(raw))
	copy(moved, raw)
	moved[7] = moved[7] ^ 1
	t.True("tampered", CheckNonce(key, seal.B64(moved), 1700000001) != nil)
	t.True("two nonces differ", NewNonce(key, 1700000000) != n)
}

fn TestSigningPayload(t mut crucible.T) {
	let p = SigningPayload("POST", "/r/tit/v1/push", "NONCE", "body")
	crucible.Equal(mut t, "payload", p, "tit v1 POST /r/tit/v1/push\nNONCE\n" + seal.Hex(seal.Sha256("body")) + "\n")
	// it is what an ed25519 key signs and the server checks
	let seed = seal.RandomBytes(32)
	let pub = seal.Ed25519PublicKey(seed) catch _ {
		[]u8{}
	}
	let sig = seal.SignEd25519(seed, []u8(p)) catch _ {
		[]u8{}
	}
	t.NoFault("verifies", seal.VerifyEd25519(pub, []u8(p), sig))
	let other = SigningPayload("POST", "/r/tit/v1/push", "OTHER", "body")
	t.True("another nonce does not", seal.VerifyEd25519(pub, []u8(other), sig) != nil)
	let (email, nonce, back, err) = ParseSignatureHeader(SignatureHeader("ada@example.com", "NONCE", sig))
	t.NoFault("header", err)
	t.True("header round trip", email == "ada@example.com" && nonce == "NONCE" && seal.Hex(back) == seal.Hex(sig))
	let (_, _, _, herr) = ParseSignatureHeader("ada@example.com sig")
	t.True("two fields", herr != nil)
}
