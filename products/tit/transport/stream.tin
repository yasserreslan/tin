package transport

import "../packfile"
import "fault"
import "flume"
import "io"
import "pack"
import "quarry"
import "seal"
import "twine"

// Streamed requests (#1009): a push's pack goes to a file a buffer at a time, hashed for its signature on the way,
// and is checked where it lies (packfile.KeepFile); a fetch's pack goes out an entry at a time (packfile.ReuseTo).
// The server's memory then holds one buffer and one entry, not the pack, whatever its size. The signer and its nonce
// are checked before the body is read, so a stranger cannot make the server store a pack.

// streamBuf is the size of the buffer a streamed body is read through: flume's own buffer size, so writing a piece
// to the file never grows the writer's buffer (a larger write allocates a new one every time).
const streamBuf = 64 << 10

// readFull reads exactly n bytes of body, hashing them into h.
fn readFull[R io.Reader](body mut R, h mut seal.Hasher, n i64) !str {
	mut out = make([]u8, 0, min(n, streamBuf))
	mut buf = make([]u8, min(max(n, 1), streamBuf))
	for len(out) < n {
		let want = min(len(buf), n - len(out))
		let k = try body.Read(mut buf[0:want])
		if k == 0 {
			fail fault.Wrap(ErrBadFrame, "the body ends after {len(out)} of {n} bytes")
		}
		out = append(out, buf[0:k]...)
	}
	_ = try h.Write(out)
	return str(out)
}

// readBody reads a whole body, refusing one longer than most bytes.
fn readBody[R io.Reader](body mut R, most i64) !str {
	mut out = []u8{}
	mut buf = make([]u8, 64 * 1024)
	for {
		let k = try body.Read(mut buf)
		if k == 0 {
			break
		}
		if len(out) + k > most {
			fail fault.Wrap(ErrRefused, "TooLarge: a body larger than {most} bytes")
		}
		out = append(out, buf[0:k]...)
	}
	return str(out)
}

// HandleStream answers a request whose body is read from body as it arrives. A push streams its pack to a file;
// any other request's body is small (at most a header and a list of ids) and is read whole, then answered by Handle.
fn HandleStream[R io.Reader](s mut Server, method str, path str, signature str, body mut R, now i64) Reply {
	if !(method == "POST" && twine.HasSuffix(path, "/tit/v1/push")) {
		// a replay capsule (§17) may be up to MaxCapsule; anything else is a header and a list of ids
		mut most = MaxHeader + streamBuf
		if twine.HasSuffix(path, "/tit/v1/replay") {
			most = MaxCapsule + MaxHeader + 64
		}
		let whole = readBody(mut body, most) catch e {
			let (c, m) = codeOf(e)
			mut code = c
			if code == Code.Internal {
				code = Code.BadRequest
			}
			return refuse(code, m, "")
		}
		return s.Handle(method, path, signature, whole, now)
	}
	let (answer, err) = pushStream(mut s, path, signature, mut body, now)
	if err != nil {
		return s.answerFor(err, now)
	}
	return Reply{Status: 200, Body: answer}
}

// pushStream receives a push: its signer checked first, its frame and header read, its pack written to a file in
// the repository's temporary directory a buffer at a time, its signature checked over the hash of all it read, then
// the push made from the file (pushFile).
fn pushStream[R io.Reader](s mut Server, path str, signature str, body mut R, now i64) !str {
	let g = try s.signerOf(signature, now)
	if g == nil {
		try refusal(Code.Unauthorized, "sign the request with your key (tit key makes one)")
		return ""
	}
	mut h = seal.NewSha256()
	let prefix = readFull(mut body, mut h, 10) catch e {
		try refusal(Code.BadRequest, fault.Message(e))
		return ""
	}
	if prefix[0:4] != "TITP" || i64(prefix[4]) != Version {
		try refusal(Code.BadRequest, "not a tit v1 message")
	}
	let k = kindOf(i64(prefix[5])) catch e {
		try refusal(Code.BadRequest, fault.Message(e))
		Kind.Error
	}
	if k != Kind.PushRequest {
		try refusal(Code.BadRequest, "a push takes a push request")
	}
	let n = i64(pack.LE.U32([]u8(prefix[6:10])))
	if n > MaxHeader {
		try refusal(Code.BadRequest, "a header of {n} bytes")
	}
	let header = readFull(mut body, mut h, n) catch e {
		try refusal(Code.BadRequest, fault.Message(e))
		return ""
	}
	let tmp = tempPack(s.repo.TempDir())
	let size = receive(mut body, mut h, tmp, s.limits.Pack) catch e {
		if quarry.Exists(tmp) {
			quarry.Remove(tmp) catch _ {
			}
		}
		fail e
	}
	s.verify(g, "POST", path, seal.Hex(h.Sum()), now) catch e {
		quarry.Remove(tmp) catch _ {
		}
		fail e
	}
	mut file = tmp
	if size == 0 {
		quarry.Remove(tmp) catch _ {
		}
		file = ""
	}
	return try s.pushFile(header, file, size, g.email, now)
}

// receive copies the rest of body into a new file at path, hashing it into h, and gives its size; a body longer
// than most bytes is TooLarge.
fn receive[R io.Reader](body mut R, h mut seal.Hasher, path str, most i64) !i64 {
	mut f = try flume.CreateExcl(path)
	mut buf = make([]u8, streamBuf)
	mut size = 0
	for {
		let k = body.Read(mut buf) catch e {
			f.Close() catch _ {
			}
			try refusal(Code.BadRequest, "the push's body: {fault.Message(e)}")
			0
		}
		if k == 0 {
			break
		}
		size += k
		if size > most {
			f.Close() catch _ {
			}
			try refusal(Code.TooLarge, "a pack of more than {most} bytes; this server takes {most}")
		}
		_ = try h.Write(buf[0:k])
		_ = try f.Write(buf[0:k])
	}
	try f.Close()
	return size
}

// Fetching is a fetch ready to send: Head is the answer's frame and header, the pack follows (SendFetch).
type Fetching struct {
	Head str
	plan fetchPlan
}

// StartFetch checks a fetch request (body, signed as signature) and works out what to send; a fault is the answer to
// give instead (answerFor).
fn (s mut Server) StartFetch(path str, signature str, body str, now i64) !Fetching {
	let who = try s.authenticate("POST", path, signature, body, now)
	if len(who) == 0 && !s.public {
		try refusal(Code.Unauthorized, "sign the request with your key (tit key makes one)")
	}
	let plan = try s.planFetch(body)
	return Fetching{Head: Frame(Kind.FetchAnswer, Encode(FetchAnswer{Objects: len(plan.send)}), ""), plan: plan}
}

// SendFetch writes a started fetch's pack to w an entry at a time.
fn SendFetch[W io.Writer](f mut Fetching, w mut W) ! {
	_ = try packfile.ReuseTo(mut f.plan.st, mut f.plan.packs, f.plan.send, mut w)
}

// Refusal is the answer to a request refused with err.
fn (s Server) Refusal(err fault, now i64) Reply {
	return s.answerFor(err, now)
}
