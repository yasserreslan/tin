package transport

import "argo"
import "fault"
import "quarry"
import "replay"
import "seal"
import "twine"

// Replay capsules over the protocol (design/tit.md §17, #1027): version 2 capsules pushed, listed and fetched by
// signed requests. A server stores and groups them by their plain summary and signer; it never opens one.

// MaxCapsule is the largest capsule a server takes: 64 MiB.
const MaxCapsule = 64 * 1024 * 1024

// ReplayStore is where a server keeps capsules: tit serve's is a directory (DirReplays), tinhub's its own (#1022).
shape ReplayStore {
	mut Put(e ReplayEntry, data str) !bool
	mut List() ![]ReplayEntry
	mut Get(id str) !(ReplayEntry, str)
}

// NoReplays is a store that takes no capsule (a server that keeps none).
type NoReplays struct {
	none bool
}

// Put refuses.
fn (n NoReplays) Put(e ReplayEntry, data str) !bool {
	fail fault.Wrap(ErrRefused, "NotFound: this server keeps no replay capsules")
}

// List is empty.
fn (n NoReplays) List() ![]ReplayEntry {
	return []ReplayEntry{}
}

// Get finds nothing.
fn (n NoReplays) Get(id str) !(ReplayEntry, str) {
	fail fault.Wrap(ErrRefused, "NotFound: no capsule {id} here")
}

// DirReplays keeps capsules in a directory: <id>.tcap and <id>.json.
type DirReplays struct {
	Dir str
}

// Put stores a capsule once: false when it was there already.
fn (d DirReplays) Put(e ReplayEntry, data str) !bool {
	try quarry.MkdirAll(d.Dir)
	let base = d.Dir + "/" + e.Id
	if quarry.Exists(base + ".json") {
		return false
	}
	try quarry.WriteFile(base + ".tcap.tmp", data)
	try quarry.Rename(base + ".tcap.tmp", base + ".tcap")
	try quarry.WriteFile(base + ".json.tmp", Encode(e))
	try quarry.Rename(base + ".json.tmp", base + ".json")
	return true
}

// List is every stored capsule, newest first.
fn (d DirReplays) List() ![]ReplayEntry {
	mut out = []ReplayEntry{}
	if !quarry.IsDir(d.Dir) {
		return out
	}
	let names = try quarry.ReadDir(d.Dir)
	for n in names {
		if !twine.HasSuffix(n, ".json") {
			continue
		}
		let text = try quarry.ReadFile(d.Dir + "/" + n)
		mut e = ReplayEntry{Id: "", Group: "", Name: "", Commit: "", Signer: "", Summary: "", Time: 0}
		argo.Get(text, mut e) catch _ {
			continue
		}
		out = append(out, e)
	}
	// newest first, then by id
	for i in 1..len(out) {
		mut j = i
		for j > 0 && (out[j - 1].Time < out[j].Time || (out[j - 1].Time == out[j].Time && out[j - 1].Id > out[j].Id)) {
			let t = out[j - 1]
			out[j - 1] = out[j]
			out[j] = t
			j -= 1
		}
	}
	return out
}

// Get is a stored capsule and its entry.
fn (d DirReplays) Get(id str) !(ReplayEntry, str) {
	if len(id) != 64 || !isHex(id) {
		fail fault.Wrap(ErrRefused, "BadRequest: {id} is not a capsule id")
	}
	let base = d.Dir + "/" + id
	if !quarry.Exists(base + ".json") {
		fail fault.Wrap(ErrRefused, "NotFound: no capsule {id[0:12]} here")
	}
	let text = try quarry.ReadFile(base + ".json")
	mut e = ReplayEntry{Id: "", Group: "", Name: "", Commit: "", Signer: "", Summary: "", Time: 0}
	try argo.Get(text, mut e)
	let data = try quarry.ReadFileBound(base + ".tcap", MaxCapsule + 1)
	return e, data
}

fn isHex(s str) bool {
	for i in 0..len(s) {
		let c = s[i]
		if !((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')) {
			return false
		}
	}
	return true
}

// replayPush stores one pushed capsule after checking it: a version 2 capsule whose signature verifies against the
// signer it names; its id and group from its bytes and its summary.
fn (s mut Server) replayPush(body str, now i64) !str {
	let (k, header, data) = ReadFrame(body) catch e {
		try refusal(Code.BadRequest, fault.Message(e))
		return ""
	}
	if k != Kind.ReplayPush {
		try refusal(Code.BadRequest, "a replay push takes a replay push request")
	}
	mut h = ReplayPushHeader{Commit: "", Name: ""}
	argoGet(header, mut h) catch e {
		try refusal(Code.BadRequest, fault.Message(e))
	}
	if len(data) > MaxCapsule {
		try refusal(Code.TooLarge, "a capsule of {len(data)} bytes; this server takes {MaxCapsule}")
	}
	if replay.Version(data) != 2 {
		try refusal(Code.BadRequest, "not a version 2 capsule: record with TIN_REPLAY_RECIPIENTS and TIN_REPLAY_SIGNING_KEY")
	}
	let (signer, summary) = replay.Summary(data) catch e {
		try refusal(Code.BadRequest, fault.Message(e))
		return ""
	}
	let id = seal.Hex(seal.Sha256(data))
	let group = replayGroup(signer, summary)
	let e = ReplayEntry{Id: id, Group: group, Name: baseName(h.Name), Commit: h.Commit, Signer: signer, Summary: summary, Time: now}
	let fresh = try s.replays.Put(e, data)
	return Frame(Kind.ReplayAnswer, Encode(ReplayAnswer{Id: id, Group: group, New: fresh}), "")
}

// replayGroup is the group of a capsule with summary from signer: the same failure of one route is one group whatever
// ids its paths hold, so a summary naming its Router pattern ("route=", #1106) groups without its path line; one
// without a route groups by the whole summary, as before.
fn replayGroup(signer str, summary str) str {
	mut key = summary
	if twine.HasPrefix(summary, "route=") || twine.Contains(summary, "\nroute=") {
		key = ""
		for line in twine.SplitAfter(summary, "\n") {
			if !twine.HasPrefix(line, "path=") {
				key = key + line
			}
		}
	}
	return seal.Hex(seal.Sha256(signer + "\n" + key))
}

fn (s mut Server) replayList() !str {
	let all = try s.replays.List()
	return Frame(Kind.ReplayAnswer, Encode(ReplayList{Capsules: all}), "")
}

fn (s mut Server) replayGet(id str) !str {
	let (e, data) = try s.replays.Get(id)
	return Frame(Kind.ReplayCapsule, Encode(ReplayGot{Id: e.Id, Name: e.Name, Commit: e.Commit}), data)
}
