package transport

import "../change"
import "../identity"
import "../object"
import "../packfile"
import "../revwalk"
import "../store"
import "fault"
import "flume"
import "quarry"
import "seal"
import "twine"
import "argo"
import "constraints"

// The server side of the protocol (#796), over one repository (a Repo, design/tit.md §16) and with no HTTP in it: Handle takes
// a request's method, path, Tit-Signature header and body and gives the status and body to answer with, so tit serve
// puts it behind anvil and tests call it directly.

// MaxObject is the largest object a push may hold: 1 GiB.
const MaxObject = 1024 * 1024 * 1024

// Reply is what to answer a request with.
type Reply struct {
	Status i64
	Body   str
}

// Server serves one repository.
type Server struct {
	repo   dyn Repo
	key    secret str
	keys   map[str][]str
	public bool
	limits Limits
	seen   map[str]i64
}

// NewServer serves the repository whose .tit directory is dir; key signs its nonces. public lets heads and fetch go
// unsigned.
fn NewServer(dir str, key secret str, public bool) Server {
	return NewRepoServer(NewDirRepo(dir), key, public)
}

// NewRepoServer serves repo (design/tit.md §16): tinhub's, or a MemRepo in tests.
fn NewRepoServer(repo dyn Repo, key secret str, public bool) Server {
	return Server{repo: repo, key: key, keys: map[str][]str{}, public: public, limits: Limits{Pack: 2 * 1024 * 1024 * 1024, Refs: 10000}, seen: map[str]i64{}}
}

// Allow lets the holder of an ed25519 public key sign requests as email.
fn (s mut Server) Allow(email str, pub []u8) {
	let (have, _) = s.keys[email]
	mut ks = []str{}
	for k in have {
		ks = append(ks, k)
	}
	ks = append(ks, str(pub))
	s.keys[email] = ks
}

// SetLimits changes the largest pack and the most refs a push may carry.
fn (s mut Server) SetLimits(l Limits) {
	s.limits = l
}

fn refuse(c Code, message str, ref str) Reply {
	return Reply{Status: Status(c), Body: Frame(Kind.Error, Encode(ErrorAnswer{Code: CodeName(c), Message: message, Ref: ref, Nonce: ""}), "")}
}

// challenge refuses a request for want of a good signature, with a fresh nonce to sign with.
fn (s Server) challenge(c Code, message str, now i64) Reply {
	return Reply{Status: Status(c), Body: Frame(Kind.Error, Encode(ErrorAnswer{Code: CodeName(c), Message: message, Ref: "", Nonce: NewNonce(s.key, now)}), "")}
}

// codeOf is the code a fault from the checks below carries in its text ("Code: message"), Internal for any other.
fn codeOf(err fault) (Code, str) {
	mut m = fault.Message(err)
	let tail = ": " + fault.Message(ErrRefused)
	if twine.HasSuffix(m, tail) {
		m = m[0:len(m) - len(tail)]
	}
	let colon = twine.Index(m, ": ")
	if colon > 0 {
		let name = m[0:colon]
		let c = ParseCode(name)
		if CodeName(c) == name {
			return c, m[colon + 2:]
		}
	}
	return Code.Internal, m
}

fn refusal(c Code, message str) ! {
	fail fault.Wrap(ErrRefused, CodeName(c) + ": " + message)
}

// Handle answers one request at time now (unix seconds).
fn (s mut Server) Handle(method str, path str, signature str, body str, now i64) Reply {
	let (who, err) = s.authenticate(method, path, signature, body, now)
	if err != nil {
		return s.answerFor(err, now)
	}
	let push = twine.HasSuffix(path, "/tit/v1/push")
	if len(who) == 0 && (push || !s.public) {
		return s.challenge(Code.Unauthorized, "sign the request with your key (tit key makes one)", now)
	}
	if method == "GET" && twine.HasSuffix(path, "/tit/v1/heads") {
		let (h, herr) = s.heads(now)
		if herr != nil {
			return s.answerFor(herr, now)
		}
		return Reply{Status: 200, Body: Frame(Kind.HeadsAnswer, Encode(h), "")}
	}
	if method == "POST" && twine.HasSuffix(path, "/tit/v1/fetch") {
		let (answer, ferr) = s.fetch(body)
		if ferr != nil {
			return s.answerFor(ferr, now)
		}
		return Reply{Status: 200, Body: answer}
	}
	if method == "POST" && push {
		let (answer, perr) = s.push(body, who, now)
		if perr != nil {
			return s.answerFor(perr, now)
		}
		return Reply{Status: 200, Body: answer}
	}
	return refuse(Code.NotFound, "no such request: {method} {path}", "")
}

// answerFor is the answer to a request a fault refused: a fresh nonce with a signature's refusal, and the ref or
// change to blame with a push's.
fn (s Server) answerFor(err fault, now i64) Reply {
	let (c, m) = codeOf(err)
	if c == Code.Unauthorized || c == Code.NonceExpired {
		return s.challenge(c, m, now)
	}
	mut ref = ""
	if c == Code.RefChanged || c == Code.Moved || c == Code.Conflicted {
		let sp = twine.IndexByte(m, ' ')
		if sp > 0 {
			ref = m[0:sp]
		}
	}
	return refuse(c, m, ref)
}

// signer is a request's Tit-Signature as far as it can be checked before its body: who signed, the nonce and
// signature, and the keys that may have made it.
type signer struct {
	email str
	nonce str
	sig   []u8
	pubs  []str
}

// signerOf checks a Tit-Signature header's form, its nonce, and that its email has keys here; nil when unsigned.
fn (s Server) signerOf(signature str, now i64) !?signer {
	if len(signature) == 0 {
		return nil
	}
	let (email, nonce, sig) = try ParseSignatureHeader(signature)
	try CheckNonce(s.key, nonce, now)
	let (pubs, known) = s.keys[email]
	if !known {
		try refusal(Code.Unauthorized, "no key of {email} is allowed here")
	}
	return signer{email: email, nonce: nonce, sig: sig, pubs: pubs}
}

// verify checks g's signature over a request whose body's SHA-256 (hex) is bodyHash. A push's nonce is good once on
// this server.
fn (s mut Server) verify(g signer, method str, path str, bodyHash str, now i64) ! {
	let payload = SigningPayloadOf(method, path, g.nonce, bodyHash)
	mut ok = false
	for p in g.pubs {
		let verr = seal.VerifyEd25519([]u8(p), []u8(payload), g.sig)
		if verr == nil {
			ok = true
		}
	}
	if !ok {
		try refusal(Code.Unauthorized, "the signature is not {g.email}'s")
	}
	if twine.HasSuffix(path, "/tit/v1/push") {
		// forget nonces too old to pass CheckNonce, then refuse one seen already
		mut stale = []str{}
		for n, at in s.seen {
			if now - at >= NonceLife {
				stale = append(stale, n)
			}
		}
		for n in stale {
			delete(s.seen, n)
		}
		let (_, used) = s.seen[g.nonce]
		if used {
			try refusal(Code.NonceExpired, "this nonce was used already")
		}
		// a server keeps this past the request: keep() copies it into long-lived memory
		s.seen[keep(g.nonce)] = now
	}
}

// authenticate checks a request's signature: the email it was signed as, "" for an unsigned request.
fn (s mut Server) authenticate(method str, path str, signature str, body str, now i64) !str {
	let g = try s.signerOf(signature, now)
	if g == nil {
		return ""
	}
	try s.verify(g, method, path, seal.Hex(seal.Sha256(body)), now)
	return g.email
}

// objects is the repository's store: its loose objects and every pack.
fn objects(dir str) !store.Layered {
	mut layers = []dyn store.ObjectStore{store.NewLoose(dir + "/objects")}
	let packs = try packfile.OpenAll(dir + "/packs")
	for p in packs {
		layers = append(layers, p)
	}
	return store.NewLayered(layers)
}

// packsOf is the repository's packs, for a fetch to send their entries as they are (packfile.Reuse).
fn packsOf(dir str) ![]packfile.Pack {
	return try packfile.OpenAll(dir + "/packs")
}

fn (s mut Server) heads(now i64) !Heads {
	let all = try s.repo.Refs("refs/")
	mut out = Heads{Refs: []RefHead{}, Changes: []ChangeHead{}, Nonce: NewNonce(s.key, now), Server: "tit 1", Limits: s.limits}
	for r in all {
		out.Refs = append(out.Refs, RefHead{Name: r.Name, Target: change.TargetText(r.Target)})
		match r.Target {
			Change(c) => {
				let v = try s.repo.Newest(c)
				if v != nil {
					let id = try object.IdOf(v.Hash)
					out.Changes = append(out.Changes, ChangeHead{Change: c.Letters(), Version: v.Op, Commit: id.Hex()})
				}
			}
			Commit(_) => {
			}
		}
	}
	return out
}

// reach adds a tree's objects to want, leaving out those in skip and those added already.
fn reach[S store.ObjectStore](st mut S, tree object.Id, skip map[str]bool, want mut []object.Id, seen mut map[str]bool) ! {
	let (_, done) = seen[tree.Bytes()]
	let (_, skipped) = skip[tree.Bytes()]
	if done || skipped {
		return
	}
	seen[tree.Bytes()] = true
	want = append(want, tree)
	let o = try st.Get(tree)
	match o {
		Tree(es) => {
			for e in es {
				if e.Mode == object.Mode.Dir {
					try reach(mut st, e.Id, skip, mut want, mut seen)
				} else {
					let (_, d) = seen[e.Id.Bytes()]
					let (_, k) = skip[e.Id.Bytes()]
					if !d && !k {
						seen[e.Id.Bytes()] = true
						want = append(want, e.Id)
					}
				}
			}
		}
		Commit(_) => {
		}
		Tag(_) => {
		}
		Blob(_) => {
		}
	}
}

// reachTrees adds a tree and the trees below it to want, once each, and no blob: what a lazy clone takes.
fn reachTrees[S store.ObjectStore](st mut S, tree object.Id, want mut []object.Id, seen mut map[str]bool) ! {
	let (_, done) = seen[tree.Bytes()]
	if done {
		return
	}
	seen[tree.Bytes()] = true
	want = append(want, tree)
	let o = try st.Get(tree)
	match o {
		Tree(es) => {
			for e in es {
				if e.Mode == object.Mode.Dir {
					try reachTrees(mut st, e.Id, mut want, mut seen)
				}
			}
		}
		Commit(_) => {
		}
		Tag(_) => {
		}
		Blob(_) => {
		}
	}
}

// treeObjects is every object of a tree, as a set.
fn treeObjects[S store.ObjectStore](st mut S, tree object.Id, out mut map[str]bool) ! {
	let (_, done) = out[tree.Bytes()]
	if done {
		return
	}
	out[tree.Bytes()] = true
	let o = try st.Get(tree)
	match o {
		Tree(es) => {
			for e in es {
				if e.Mode == object.Mode.Dir {
					try treeObjects(mut st, e.Id, mut out)
				} else {
					out[e.Id.Bytes()] = true
				}
			}
		}
		Commit(_) => {
		}
		Tag(_) => {
		}
		Blob(_) => {
		}
	}
}

fn commitOf[S store.ObjectStore](st mut S, id object.Id) !object.CommitData {
	let o = try st.Get(id)
	return match o {
		Commit(c) => c
		Tree(_) => try notCommit(id)
		Tag(_) => try notCommit(id)
		Blob(_) => try notCommit(id)
	}
}

fn notCommit(id object.Id) !object.CommitData {
	fail fault.Wrap(ErrRefused, "BadRequest: {id.Hex()} is not a commit")
}

// fetchPlan is what a fetch asks for: the objects to send, in the order to send them, and the store and packs they
// come from.
type fetchPlan struct {
	st    store.Layered
	packs []packfile.Pack
	send  []object.Id
}

// fetch is the whole answer to a fetch request, in memory.
fn (s mut Server) fetch(body str) !str {
	mut p = try s.planFetch(body)
	let data = try packfile.Reuse(mut p.st, mut p.packs, p.send)
	return Frame(Kind.FetchAnswer, Encode(FetchAnswer{Objects: len(p.send)}), data)
}

// planFetch reads a fetch request and works out what to send.
fn (s mut Server) planFetch(body str) !fetchPlan {
	let (k, header, _) = ReadFrame(body) catch e {
		try refusal(Code.BadRequest, fault.Message(e))
		return fetchPlan{st: store.NewLayered([]dyn store.ObjectStore{}), packs: []packfile.Pack{}, send: []object.Id{}}
	}
	if k != Kind.FetchRequest {
		try refusal(Code.BadRequest, "a fetch takes a fetch request")
	}
	mut req = FetchRequest{Wants: []str{}, Haves: []str{}, NoBlobs: false, Objects: []str{}}
	argoGet(header, mut req) catch e {
		try refusal(Code.BadRequest, fault.Message(e))
	}
	mut st = try s.repo.Objects()
	if len(req.Objects) > 0 {
		// a lazy clone reading what it left out: these objects, and nothing else
		if len(req.Objects) > s.limits.Refs * 100 {
			try refusal(Code.TooLarge, "{len(req.Objects)} objects in one fetch")
		}
		mut ids = []object.Id{}
		for o in req.Objects {
			let id = object.ParseId(o) catch _ {
				try refusal(Code.BadRequest, "{o} is not an id")
				object.NoId
			}
			if !st.Has(id) {
				try refusal(Code.NotFound, "no object {o} here")
			}
			ids = append(ids, id)
		}
		let opacks = try s.repo.Packs()
		return fetchPlan{st: st, packs: opacks, send: ids}
	}
	mut wants = []object.Id{}
	// an annotated tag is sent itself, and the commit it tags is walked
	mut tags = []object.Id{}
	for w in req.Wants {
		let id = object.ParseId(w) catch _ {
			try refusal(Code.BadRequest, "{w} is not an id")
			object.NoId
		}
		if !st.Has(id) {
			try refusal(Code.NotFound, "no commit {w} here")
		}
		mut cur = id
		for k in 0..16 {
			let (kind, body) = try st.GetRaw(cur)
			if kind != object.Kind.Tag {
				break
			}
			tags = append(tags, cur)
			let o = try object.Decode(kind, body)
			match o {
				Tag(t) => {
					cur = t.Object
				}
				Commit(_) => {
				}
				Tree(_) => {
				}
				Blob(_) => {
				}
			}
		}
		let (ck, _) = try st.GetRaw(cur)
		if ck != object.Kind.Commit {
			try refusal(Code.BadRequest, "{w} does not name a commit")
		}
		wants = append(wants, cur)
	}
	mut haves = []object.Id{}
	for h in req.Haves {
		let id = object.ParseId(h) catch _ {
			continue
		}
		if st.Has(id) {
			haves = append(haves, id)
		}
	}
	let commits = try revwalk.Walk(mut st, wants, haves, revwalk.Order.Topo, 0)
	// what the client has already: the objects of the trees of its tips
	mut skip = map[str]bool{}
	for h in haves {
		let c = try commitOf(mut st, h)
		try treeObjects(mut st, c.Tree, mut skip)
	}
	mut send = []object.Id{}
	mut seen = map[str]bool{}
	for t in tags {
		let (_, dup) = seen[t.Bytes()]
		if !dup {
			seen[t.Bytes()] = true
			send = append(send, t)
		}
	}
	for id in commits {
		send = append(send, id)
		let c = try commitOf(mut st, id)
		if req.NoBlobs {
			try reachTrees(mut st, c.Tree, mut send, mut seen)
		} else {
			try reach(mut st, c.Tree, skip, mut send, mut seen)
		}
	}
	// the entries the packs hold already go as they are (packfile.Reuse): no delta search, no recompression
	let packs = try s.repo.Packs()
	return fetchPlan{st: st, packs: packs, send: send}
}

// complete checks that a pushed commit has its tree, its blobs and its parents, in the pack or here. checked holds
// every object checked, true for the commits (the ones whose signatures are checked next).
fn complete[S store.ObjectStore](st mut S, id object.Id, checked mut map[str]bool) ! {
	let (_, done) = checked[id.Bytes()]
	if done {
		return
	}
	checked[id.Bytes()] = false
	if !st.Has(id) {
		try refusal(Code.BadPack, "{id.Hex()} is missing")
	}
	let o = try st.Get(id)
	match o {
		Commit(c) => {
			checked[id.Bytes()] = true
			try complete(mut st, c.Tree, mut checked)
			for p in c.Parents {
				if !st.Has(p) {
					try refusal(Code.BadPack, "{id.Hex()}'s parent {p.Hex()} is missing")
				}
			}
		}
		Tree(es) => {
			for e in es {
				if e.Mode == object.Mode.Dir {
					try complete(mut st, e.Id, mut checked)
					continue
				}
				// a file's blob need only be there: reading it would hold every pushed blob in the request's memory
				let (_, seen) = checked[e.Id.Bytes()]
				if seen {
					continue
				}
				checked[e.Id.Bytes()] = false
				if !st.Has(e.Id) {
					try refusal(Code.BadPack, "{e.Id.Hex()} is missing")
				}
			}
		}
		Tag(t) => {
			try complete(mut st, t.Object, mut checked)
		}
		Blob(_) => {
		}
	}
}

fn (s mut Server) push(body str, who str, now i64) !str {
	let (k, header, data) = ReadFrame(body) catch e {
		try refusal(Code.BadRequest, fault.Message(e))
		return ""
	}
	if k != Kind.PushRequest {
		try refusal(Code.BadRequest, "a push takes a push request")
	}
	// the pack to a file, as a streamed push writes it (HandleStream), then the same path for both
	mut path = ""
	if len(data) > 0 {
		if len(data) > s.limits.Pack {
			try refusal(Code.TooLarge, "a pack of {len(data)} bytes; this server takes {s.limits.Pack}")
		}
		path = tempPack(s.repo.TempDir())
		try quarry.WriteFile(path, data)
	}
	return try s.pushFile(header, path, len(data), who, now)
}

// tempPack is a fresh path in dir for a pack being received.
fn tempPack(dir str) str {
	return dir + "/tmp-recv-" + seal.Hex(seal.RandomBytes(8)) + ".pack"
}

// pushFile is a push whose header is header and whose pack (size bytes) is the file at path ("" for none): the file
// is checked and indexed where it is (packfile.KeepFile, a range at a time), the push checked against it and the
// repository, staged and committed (design/tit.md §16). Whatever fails, nothing of the pack is left behind.
fn (s mut Server) pushFile(header str, path str, size i64, who str, now i64) !str {
	mut staged = pending{name: ""}
	let (answer, err) = s.pushChecked(header, path, size, who, now, mut staged)
	if err != nil {
		if len(path) > 0 && quarry.Exists(path) {
			quarry.Remove(path) catch _ {
			}
		}
		if len(staged.name) > 0 {
			s.repo.Drop(Staged{Name: staged.name}) catch _ {
				false
			}
		}
		fail err
	}
	return answer
}

// pending is the name of the pack a push staged, for pushFile to drop when the push fails.
type pending struct {
	name str
}

fn (s mut Server) pushChecked(header str, path str, size i64, who str, now i64, staged mut pending) !str {
	mut req = PushRequest{Changes: []ChangeUpdate{}, Refs: []RefUpdate{}}
	argoGet(header, mut req) catch e {
		try refusal(Code.BadRequest, fault.Message(e))
	}
	if size > s.limits.Pack {
		try refusal(Code.TooLarge, "a pack of {size} bytes; this server takes {s.limits.Pack}")
	}
	if len(req.Refs) + len(req.Changes) > s.limits.Refs {
		try refusal(Code.TooLarge, "{len(req.Refs) + len(req.Changes)} refs and changes in one push")
	}
	// the pack, verified and indexed as it lies, in front of the repository (pending: nothing reaches it yet)
	mut p ?packfile.Pack = nil
	if len(path) > 0 {
		let kept = packfile.KeepFile(path, s.repo.TempDir(), MaxObject) catch e {
			try refusal(Code.BadPack, fault.Message(e))
			return ""
		}
		staged.name = kept.Path[len(kept.Path) - 69:len(kept.Path) - 5]
		p = kept
	}
	let here = try s.repo.Objects()
	mut layers = []dyn store.ObjectStore{}
	if p != nil {
		layers = append(layers, p)
	}
	layers = append(layers, here)
	mut st = store.NewLayered(layers)
	// design/tit.md §16 step 2: the checks without the lock, against what the repository holds now (Commit makes
	// those on versions and refs again under it)
	let checks = Update{Who: who, Command: "push by " + who, Changes: req.Changes, Refs: req.Refs, Pack: "", Time: now * 1000000000}
	mut rp = s.repo
	try recheck(mut rp, checks)
	for cu in req.Changes {
		let cmt = object.ParseId(cu.Commit) catch _ {
			try refusal(Code.BadRequest, "{cu.Commit} is not an id")
			object.NoId
		}
		let c = try commitOf(mut st, cmt)
		if c.Change.Letters() != cu.Change {
			try refusal(Code.BadRequest, "{cu.Commit} is not a version of {cu.Change}")
		}
	}
	mut checked = map[str]bool{}
	for ru in req.Refs {
		if len(ru.New) > 0 && !twine.HasPrefix(ru.New, "change ") {
			let id = object.ParseId(ru.New) catch _ {
				try refusal(Code.BadRequest, "{ru.New} is not an id")
				object.NoId
			}
			try complete(mut st, id, mut checked)
		}
	}
	for cu in req.Changes {
		let id = try object.ParseId(cu.Commit)
		try complete(mut st, id, mut checked)
	}
	// signatures, where the repository keeps a signers file
	for idb, isCommit in checked {
		if !isCommit {
			continue
		}
		let id = try object.IdOf(idb)
		if here.Has(id) {
			continue
		}
		let c = try commitOf(mut st, id)
		if len(c.Conflicts) > 0 {
			try refusal(Code.Conflicted, "{c.Change.Letters()} records conflicts ({id.Hex()[0:12]}): resolve them (tit edit) before pushing")
		}
		mut from = id
		if len(c.Parents) > 0 {
			from = c.Parents[0]
		}
		let keys = try identity.SignersAt(mut st, from)
		if len(keys) > 0 {
			identity.VerifyCommit(c, keys) catch e {
				try refusal(Code.BadSignature, "{id.Hex()[0:12]}: {fault.Message(e)}")
			}
		}
	}
	// step 3, data first: the pack, as it came, pending
	if p != nil {
		let sp = try s.repo.Stage(p.Path)
		staged.name = sp.Name
	}
	// step 4: versions and refs checked again under the lock, then everything current in one step
	_ = try s.repo.Commit(Update{Who: who, Command: "push by " + who, Changes: req.Changes, Refs: req.Refs, Pack: staged.name, Time: now * 1000000000})
	staged.name = ""
	mut names = []str{}
	for ru in req.Refs {
		names = append(names, ru.Name)
	}
	return Frame(Kind.PushAnswer, Encode(PushAnswer{Refs: names}), "")
}

fn short(text str) str {
	if len(text) == 0 {
		return "nothing"
	}
	if len(text) == 64 {
		return text[0:12]
	}
	return text
}

fn argoGet[T constraints.Any](text str, v mut T) ! {
	try argo.Get(text, mut v)
}
