package change

import "fault"
import "quarry"
import "sift"
import "twine"

// The ref store (design/tit.md section 8): one file per ref under .tit/refs, packed refs in .tit/packed-refs, and
// updates by compare-and-swap through the ref's own lock file, written to a temporary name, synced and renamed.

// Refs is the RefStore of a .tit directory.
type Refs struct {
	dir str
}

// NewRefs is the ref store of the .tit directory dir.
fn NewRefs(dir str) Refs {
	return Refs{dir: dir}
}

// CheckName fails unless name is a valid ref name: "/"-separated parts under refs/, none empty, none starting with
// a dot or ending in ".lock", no "..", and no space, control character or any of ~^:?*[\.
fn CheckName(name str) ! {
	if !twine.HasPrefix(name, "refs/") || twine.HasSuffix(name, "/") || twine.Contains(name, "//") || twine.Contains(name, "..") {
		fail fault.Wrap(ErrBadName, name)
	}
	for part in twine.Split(name, "/") {
		if len(part) == 0 || part[0] == '.' || twine.HasSuffix(part, ".lock") {
			fail fault.Wrap(ErrBadName, name)
		}
	}
	for i in 0..len(name) {
		let c = name[i]
		if c <= ' ' || c == 127 || c == '~' || c == '^' || c == ':' || c == '?' || c == '*' || c == '[' || c == '\\' {
			fail fault.Wrap(ErrBadName, name)
		}
	}
}

fn (r Refs) packed() !map[str]str {
	mut out = map[str]str{}
	let path = r.dir + "/packed-refs"
	if !quarry.Exists(path) {
		return out
	}
	let text = try quarry.ReadFile(path)
	for line in twine.Split(text, "\n") {
		if len(line) == 0 || line[0] == '#' {
			continue
		}
		let sp = twine.IndexByte(line, ' ')
		if sp < 0 {
			fail fault.Wrap(ErrBadName, "packed-refs: " + line)
		}
		mut target = line[0:sp]
		if twine.HasPrefix(target, "change:") {
			target = "change " + target[7:]
		}
		out[line[sp + 1:]] = target
	}
	return out
}

// Get is the ref with this name, or nil.
fn (r Refs) Get(name str) !?Ref {
	try CheckName(name)
	let path = r.dir + "/" + name
	if quarry.Exists(path) {
		let text = try quarry.ReadFile(path)
		let t = try ParseTarget(twine.TrimSpace(text))
		return Ref{Name: name, Target: t}
	}
	let p = try r.packed()
	let (text, ok) = p[name]
	if !ok {
		return nil
	}
	let t = try ParseTarget(text)
	return Ref{Name: name, Target: t}
}

// List is every ref whose name starts with prefix, sorted by name.
fn (r Refs) List(prefix str) ![]Ref {
	mut names = map[str]bool{}
	try r.walk("refs", mut names)
	let p = try r.packed()
	for name, _ in p {
		names[name] = true
	}
	mut sorted = []str{}
	for name, _ in names {
		if twine.HasPrefix(name, prefix) {
			sorted = append(sorted, name)
		}
	}
	sift.Sort(mut sorted)
	mut out = []Ref{}
	for name in sorted {
		let ref = try r.Get(name)
		if ref != nil {
			out = append(out, ref)
		}
	}
	return out
}

fn (r Refs) walk(rel str, names mut map[str]bool) ! {
	let full = r.dir + "/" + rel
	if !quarry.IsDir(full) {
		return
	}
	let entries = try quarry.ReadDirEntries(full)
	for e in entries {
		let child = rel + "/" + e.Name
		if e.Type == quarry.FileType.Dir {
			try r.walk(child, mut names)
		} else if !twine.HasSuffix(e.Name, ".lock") && !twine.HasPrefix(e.Name, ".") {
			names[child] = true
		}
	}
}

// Update sets the ref to next (nil deletes it) if it is still old (nil: it must not exist), and fails with
// ErrConflict naming the value it found otherwise. The ref's lock file keeps two updates of one ref apart.
fn (r mut Refs) Update(name str, old ?Target, next ?Target) ! {
	try CheckName(name)
	let path = r.dir + "/" + name
	try quarry.MkdirAll(dirOf(path))
	let lock = path + ".lock"
	try r.lockRef(lock)
	let err = r.swap(name, path, lock, old, next)
	if quarry.Exists(lock) {
		quarry.Remove(lock) catch _ {
		}
	}
	if err != nil {
		fail err
	}
}

// lockRef takes a ref's lock file, waiting up to a second while another update holds it.
fn (r Refs) lockRef(lock str) ! {
	let got = within 1s {
		mut held = false
		for !held {
			let (ok, err) = flumeCreateExcl(lock, "")
			held = ok && err == nil
			if !held {
				try tideWait()
			}
		}
		true
	} catch err {
		fail fault.Wrap(ErrLocked, "{lock}: {fault.Message(err)}")
	}
	if !got {
		fail fault.Wrap(ErrLocked, lock)
	}
}

fn (r mut Refs) swap(name str, path str, lock str, old ?Target, next ?Target) ! {
	let cur = try r.Get(name)
	mut curTarget ?Target = nil
	if cur != nil {
		curTarget = cur.Target
	}
	if !SameTarget(curTarget, old) {
		mut found = "nothing"
		if curTarget != nil {
			found = TargetText(curTarget)
		}
		fail fault.Wrap(ErrConflict, "{name} is {found}")
	}
	if next == nil {
		if quarry.Exists(path) {
			try quarry.Remove(path)
		}
		try r.unpack(name)
		try quarry.Sync(dirOf(path))
		return
	}
	let tmp = path + ".tmp"
	if quarry.Exists(tmp) {
		try quarry.Remove(tmp)
	}
	let (_, err) = flumeCreateExcl(tmp, TargetText(next) + "\n")
	if err != nil {
		fail err
	}
	try quarry.Rename(tmp, path)
	try quarry.Sync(dirOf(path))
}

// unpack removes a ref from packed-refs, rewriting the file under its lock.
fn (r Refs) unpack(name str) ! {
	let p = try r.packed()
	let (_, ok) = p[name]
	if !ok {
		return
	}
	let path = r.dir + "/packed-refs"
	try r.lockRef(path + ".lock")
	mut names = []str{}
	for n, _ in p {
		if n != name {
			names = append(names, n)
		}
	}
	sift.Sort(mut names)
	mut text = "# tit packed-refs 1\n"
	for n in names {
		mut t = p[n]
		if twine.HasPrefix(t, "change ") {
			t = "change:" + t[7:]
		}
		text = text + t + " " + n + "\n"
	}
	let tmp = path + ".tmp"
	if quarry.Exists(tmp) {
		try quarry.Remove(tmp)
	}
	let (_, err) = flumeCreateExcl(tmp, text)
	if err == nil {
		quarry.Rename(tmp, path) catch _ {
		}
	}
	quarry.Remove(path + ".lock") catch _ {
	}
	if err != nil {
		fail err
	}
}

fn dirOf(path str) str {
	let slash = twine.LastIndex(path, "/")
	if slash <= 0 {
		return "."
	}
	return path[0:slash]
}

// ---- HEAD ----

// Head is what a workspace's HEAD names: a branch, or a commit when it is detached.
type Head enum {
	Branch(str)
	Detached(Target)
}

// ReadHead reads the HEAD of a workspace's state directory (.tit/workspaces/<name>).
fn ReadHead(wsDir str) !Head {
	let raw = try quarry.ReadFile(wsDir + "/HEAD")
	let text = twine.TrimSpace(raw)
	if twine.HasPrefix(text, "ref: ") {
		let name = text[5:]
		try CheckName(name)
		return Head.Branch(name)
	}
	let t = try ParseTarget(text)
	return Head.Detached(t)
}

// WriteHead writes a workspace's HEAD (temporary file, sync, rename).
fn WriteHead(wsDir str, h Head) ! {
	let text = match h {
		Branch(name) => "ref: " + name + "\n"
		Detached(t) => TargetText(t) + "\n"
	}
	try quarry.MkdirAll(wsDir)
	let tmp = wsDir + "/HEAD.tmp"
	if quarry.Exists(tmp) {
		try quarry.Remove(tmp)
	}
	let (_, err) = flumeCreateExcl(tmp, text)
	if err != nil {
		fail err
	}
	try quarry.Rename(tmp, wsDir + "/HEAD")
	try quarry.Sync(wsDir)
}
