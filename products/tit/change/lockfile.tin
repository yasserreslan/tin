package change

import "flume"
import "tide"

// flumeCreateExcl writes text into a new file at path that must not exist yet, synced; true when it did.
fn flumeCreateExcl(path str, text str) !bool {
	mut w = try flume.CreateExcl(path)
	w.Str(text)
	let err = w.Sync()
	try w.Close()
	if err != nil {
		fail err
	}
	return true
}

// tideWait is the pause between tries for a lock.
fn tideWait() ! {
	try tide.Wait(2ms)
}
