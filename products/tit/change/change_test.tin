package change

import "../object"
import "crucible"
import "fault"
import "quarry"
import "seal"
import "spawn"

// Tests for refs, HEAD, the change index and the lock (#779). Many processes updating one ref at once:
// products/tit/tests/programs/refs_race.tin.

fn fresh(name str) str {
	let d = "/tmp/tin-test-tit-change-" + name + "-" + seal.Hex(seal.RandomBytes(4))
	quarry.RemoveAll(d) catch _ {
	}
	quarry.MkdirAll(d) catch _ {
	}
	return d
}

fn commitOf(s str) Target {
	return Target.Commit(object.Hash(object.Kind.Blob, s))
}

fn TestRefs(t mut crucible.T) {
	let d = fresh("refs")
	mut r = NewRefs(d)
	let a = commitOf("a")
	let b = commitOf("b")
	t.NoFault("create", r.Update("refs/heads/main", nil, a))
	let e1 = r.Update("refs/heads/main", nil, b)
	t.True("create over an existing ref is a conflict", e1 != nil && fault.Is(e1, ErrConflict))
	let e2 = r.Update("refs/heads/main", b, a)
	t.True("a wrong old value is a conflict", e2 != nil && fault.Is(e2, ErrConflict))
	t.NoFault("move", r.Update("refs/heads/main", a, b))
	let got = r.Get("refs/heads/main") catch _ {
		nil
	}
	t.True("reads the new value", got != nil && SameTarget(got.Target, b))
	let ch = Target.Change(object.AdoptedChangeId("feature"))
	t.NoFault("a stack branch", r.Update("refs/heads/lstat", nil, ch))
	let st = r.Get("refs/heads/lstat") catch _ {
		nil
	}
	t.True("names a change", st != nil && SameTarget(st.Target, ch))
	t.NoFault("a tag", r.Update("refs/tags/v1", nil, a))
	let all = r.List("refs/heads/") catch _ {
		[]Ref{}
	}
	crucible.Equal(mut t, "two branches", len(all), 2)
	if len(all) == 2 {
		crucible.Equal(mut t, "sorted", all[0].Name + " " + all[1].Name, "refs/heads/lstat refs/heads/main")
	}
	t.NoFault("delete", r.Update("refs/heads/lstat", ch, nil))
	let gone = r.Get("refs/heads/lstat") catch _ {
		nil
	}
	t.True("deleted", gone == nil)
	quarry.RemoveAll(d) catch _ {
	}
}

fn TestPacked(t mut crucible.T) {
	let d = fresh("packed")
	let a = commitOf("a")
	let ch = object.AdoptedChangeId("x")
	quarry.WriteFile(d + "/packed-refs", "# tit packed-refs 1\n" + TargetText(a) + " refs/heads/old\nchange:" + ch.Letters() + " refs/heads/stack\n") catch _ {
	}
	mut r = NewRefs(d)
	let old = r.Get("refs/heads/old") catch _ {
		nil
	}
	t.True("packed ref read", old != nil && SameTarget(old.Target, a))
	let stack = r.Get("refs/heads/stack") catch _ {
		nil
	}
	t.True("packed change ref read", stack != nil && SameTarget(stack.Target, Target.Change(ch)))
	t.NoFault("a loose ref wins", r.Update("refs/heads/old", a, commitOf("b")))
	let now = r.Get("refs/heads/old") catch _ {
		nil
	}
	t.True("loose value read", now != nil && SameTarget(now.Target, commitOf("b")))
	t.NoFault("delete a packed-only ref", r.Update("refs/heads/stack", Target.Change(ch), nil))
	let gone = r.Get("refs/heads/stack") catch _ {
		nil
	}
	t.True("gone from packed-refs", gone == nil)
	quarry.RemoveAll(d) catch _ {
	}
}

fn TestNames(t mut crucible.T) {
	for good in []str{"refs/heads/main", "refs/heads/feature/x-1", "refs/tags/v1.0", "refs/remotes/origin/main"} {
		t.NoFault(good, CheckName(good))
	}
	for bad in []str{"main", "refs/heads/", "refs//x", "refs/heads/a..b", "refs/heads/.hidden", "refs/heads/x.lock", "refs/heads/a b", "refs/heads/a~1", "refs/heads/a:b", "refs/heads/a*"} {
		let err = CheckName(bad)
		t.True("rejects " + bad, err != nil && fault.Is(err, ErrBadName))
	}
}

fn TestHead(t mut crucible.T) {
	let d = fresh("head")
	t.NoFault("branch", WriteHead(d + "/workspaces/default", Head.Branch("refs/heads/main")))
	let h = ReadHead(d + "/workspaces/default") catch _ {
		Head.Branch("")
	}
	let name = match h {
		Branch(n) => n
		Detached(_) => "detached"
	}
	crucible.Equal(mut t, "branch back", name, "refs/heads/main")
	let a = commitOf("a")
	t.NoFault("detached", WriteHead(d + "/workspaces/default", Head.Detached(a)))
	let h2 = ReadHead(d + "/workspaces/default") catch _ {
		Head.Branch("")
	}
	let target = match h2 {
		Branch(_) => "branch"
		Detached(x) => TargetText(x)
	}
	crucible.Equal(mut t, "detached back", target, TargetText(a))
	quarry.RemoveAll(d) catch _ {
	}
}

fn TestVersions(t mut crucible.T) {
	let d = fresh("versions")
	let c = object.AdoptedChangeId("kz")
	let none = Newest(d, c) catch _ {
		nil
	}
	t.True("no version yet", none == nil)
	for i in 1..4 {
		// a version counts once its operation is recorded
		quarry.MkdirAll(d + "/oplog") catch _ {
		}
		quarry.WriteFile(opFile(d, i), "{{}}") catch _ {
		}
		t.NoFault("add", AddVersion(d, c, NewVersion(i, object.Hash(object.Kind.Blob, "v{i}"), 1000 * i)))
	}
	// an operation that never reached its commit point (no record), and a line cut short by a crash
	t.NoFault("add uncommitted", AddVersion(d, c, NewVersion(9, object.Hash(object.Kind.Blob, "v9"), 9000)))
	quarry.AppendFile(changePath(d, c), "10 abc") catch _ {
	}
	let vs = Versions(d, c) catch _ {
		[]Version{}
	}
	crucible.Equal(mut t, "three versions", len(vs), 3)
	let n = Newest(d, c) catch _ {
		nil
	}
	t.True("newest", n != nil && n.Op == 3 && n.Commit() == object.Hash(object.Kind.Blob, "v3"))
	let found = MatchChanges(d, c.Letters()[0:6]) catch _ {
		[]object.ChangeId{}
	}
	t.True("short prefix finds it", len(found) == 1 && found[0] == c)
	quarry.RemoveAll(d) catch _ {
	}
}

fn TestLock(t mut crucible.T) {
	let d = fresh("lock")
	let held = Lock(d) catch err {
		t.Error("first lock: {fault.Message(err)}")
		return
	}
	let second = within 100ms {
		let l2 = try Lock(d)
		l2.path
	} catch err {
		t.True("a held lock is ErrLocked or the deadline", fault.Is(err, ErrLocked) || fault.Is(err, fault.DeadlineExceeded))
		""
	}
	crucible.Equal(mut t, "second lock not taken", second, "")
	t.NoFault("release", held.Close())
	// a lock left by a process that has exited is cleared
	mut p = spawn.Start(spawn.Cmd{Argv: []str{"true"}, Env: spawn.Env.Inherit, Dir: "", Stdin: spawn.Stdio.Null, Stdout: spawn.Stdio.Null, Stderr: spawn.Stdio.Null, MaxOutput: 0}) catch err {
		t.Error("spawn: {fault.Message(err)}")
		return
	}
	let dead = p.Pid()
	_ = p.Wait() catch _ {
		0
	}
	let host = quarry.Hostname() catch _ {
		"?"
	}
	quarry.WriteFile(d + "/lock", "{dead} {host} 0\n") catch _ {
	}
	let taken = Lock(d) catch err {
		t.Error("stale lock not cleared: {fault.Message(err)}")
		return
	}
	t.NoFault("release the cleared lock", taken.Close())
	quarry.RemoveAll(d) catch _ {
	}
}
