package object

import "fault"
import "seal"

// Objects, ids and their canonical encoding (design/tit.md sections 2 and 3; #776 implements Encode and Decode).

// ErrCorrupt is the fault of bytes that are not a canonical encoding.
let ErrCorrupt = fault("corrupt object")

// Id is an object's id: the 32 bytes of the SHA-256 of its encoding. A value struct: it compares with ==,
// is a map key and is copied inline.
type Id value struct {
	raw str
}

// ChangeId is a change's id: 16 bytes, printed in the letters k to z.
type ChangeId value struct {
	raw str
}

// NoId is the zero id, for "none".
let NoId = Id{raw: ""}

// Kind is an object's kind.
type Kind enum {
	Blob
	Tree
	Commit
	Tag
}

// Mode is a tree entry's mode.
type Mode enum {
	File
	Exec
	Link
	Dir
}

// Entry is one entry of a tree.
type Entry struct {
	Mode Mode
	Name str
	Id   Id
}

// Person is an author, committer or tagger, with the time and zone of the act.
type Person struct {
	Name  str
	Email str
	When  i64
	Zone  i64
}

// CommitData is the content of a commit.
type CommitData struct {
	Tree       Id
	Parents    []Id
	Change     ChangeId
	Author     Person
	Committer  Person
	GitHeaders []str
	Signature  str
	Message    str
}

// TagData is the content of a tag.
type TagData struct {
	Object    Id
	Kind      Kind
	Name      str
	Tagger    Person
	Signature str
	Message   str
}

// Object is a blob, tree, commit or tag.
type Object enum {
	Blob(str)
	Tree([]Entry)
	Commit(CommitData)
	Tag(TagData)
}

const hexDigits = "0123456789abcdef"

// KindName is the kind as written in an encoding: blob, tree, commit or tag.
fn KindName(k Kind) str {
	return match k {
		Blob => "blob"
		Tree => "tree"
		Commit => "commit"
		Tag => "tag"
	}
}

// ParseKind reads a kind's name.
fn ParseKind(s str) !Kind {
	if s == "blob" {
		return Kind.Blob
	}
	if s == "tree" {
		return Kind.Tree
	}
	if s == "commit" {
		return Kind.Commit
	}
	if s == "tag" {
		return Kind.Tag
	}
	fail fault.Wrap(ErrCorrupt, "unknown kind {s}")
}

// ModeText is the mode as written in a tree: 100644, 100755, 120000 or 40000.
fn ModeText(m Mode) str {
	return match m {
		File => "100644"
		Exec => "100755"
		Link => "120000"
		Dir => "40000"
	}
}

// Hash is the id of the object with this kind and body.
fn Hash(kind Kind, body str) Id {
	return Id{raw: str(seal.Sha256("{KindName(kind)} {len(body)}\x00{body}"))}
}

// Hex is the id as 64 lower-case hex digits.
fn (id Id) Hex() str {
	return seal.Hex([]u8(id.raw))
}

// Bytes is the id's 32 bytes.
fn (id Id) Bytes() str {
	return id.raw
}

// IdOf is the id with these 32 bytes.
fn IdOf(raw str) !Id {
	if len(raw) != 32 {
		fail fault.Wrap(ErrCorrupt, "an id has 32 bytes, not {len(raw)}")
	}
	return Id{raw: raw}
}

// ParseId reads an id from 64 hex digits.
fn ParseId(s str) !Id {
	if len(s) != 64 {
		fail fault.Wrap(ErrCorrupt, "an id has 64 hex digits, not {len(s)}")
	}
	let b = seal.HexDecode(s) catch err {
		fail fault.Wrap(ErrCorrupt, "id {s}: {fault.Message(err)}")
	}
	return Id{raw: str(b)}
}

// Letters is the change id in the letters k to z, high half of each byte first.
fn (c ChangeId) Letters() str {
	let s = c.raw
	mut out = make([]u8, 0, 2 * len(s))
	for i in 0..len(s) {
		out = append(out, 'k' + (s[i] >> 4))
		out = append(out, 'k' + (s[i] & 15))
	}
	return str(out)
}

// ParseChangeId reads a change id from its 32 letters.
fn ParseChangeId(s str) !ChangeId {
	if len(s) != 32 {
		fail fault.Wrap(ErrCorrupt, "a change id has 32 letters, not {len(s)}")
	}
	mut out = make([]u8, 0, 16)
	for i in 0..16 {
		let hi = s[2 * i]
		let lo = s[2 * i + 1]
		if hi < 'k' || hi > 'z' || lo < 'k' || lo > 'z' {
			fail fault.Wrap(ErrCorrupt, "change id {s}: letters are k to z")
		}
		out = append(out, ((hi - 'k') << 4) | (lo - 'k'))
	}
	return ChangeId{raw: str(out)}
}

// NewChangeId is a random change id.
fn NewChangeId() ChangeId {
	return ChangeId{raw: str(seal.RandomBytes(16))}
}

// AdoptedChangeId is the change id of the commit adopted from the git commit with this hex id.
fn AdoptedChangeId(gitHex str) ChangeId {
	let h = seal.Sha256("tit change {gitHex}")
	return ChangeId{raw: str(h[0:16])}
}
