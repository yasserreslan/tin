package object

import "fault"
import "seal"

// The id of a blob read as a stream (#776), so a file of any size is hashed without holding it.

// Reader is what a blob is read from: io.Reader's method (a stream ends when Read returns 0).
shape Reader {
	mut Read(buf mut []u8) !i64
}

// HashBlob is the id of the blob whose size bytes come from r; fewer or more bytes than size is ErrCorrupt.
fn HashBlob[R Reader](r mut R, size i64) !Id {
	mut h = seal.NewSha256()
	h.WriteStr("blob {size}\x00")
	mut buf = make([]u8, 65536)
	mut got = 0
	for {
		let n = try r.Read(mut buf)
		if n == 0 {
			break
		}
		got += n
		if got > size {
			fail fault.Wrap(ErrCorrupt, "blob: more than the {size} bytes declared")
		}
		_ = try h.Write(buf[0:n])
	}
	if got != size {
		fail fault.Wrap(ErrCorrupt, "blob: {got} bytes, not the {size} declared")
	}
	return Id{raw: str(h.Sum())}
}
