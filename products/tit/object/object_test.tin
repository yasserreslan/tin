package object

import "crucible"
import "dice"
import "fault"
import "sift"
import "twine"

// Tests for ids and the canonical encoding (#776): round trips of generated objects, rejection of every
// non-canonical form, and a corpus of damaged bodies that must give faults, never panics.

fn person(r mut dice.Rand) Person {
	let zones = []i64{0, 330, -480, 60, -150, 840}
	return Person{Name: r.Str(r.Intn(12), "abcdef XYZ.-é"), Email: r.Str(1 + r.Intn(10), "abc@.x9"), When: r.I64n(2000000000), Zone: zones[r.Intn(len(zones))]}
}

fn someId(r mut dice.Rand) Id {
	return Id{raw: str(r.Bytes(32))}
}

fn tree(r mut dice.Rand) []Entry {
	let modes = []Mode{Mode.File, Mode.Exec, Mode.Link, Mode.Dir}
	mut es = []Entry{}
	mut names = map[str]bool{}
	let n = r.Intn(8)
	for i in 0..n {
		let name = r.Str(1 + r.Intn(6), "ab.-_x")
		if names[name] || name == "." || name == ".." {
			continue
		}
		names[name] = true
		es = append(es, Entry{Mode: modes[r.Intn(4)], Name: name, Id: someId(mut r)})
	}
	sift.SortFunc(mut es, fn(a Entry, b Entry) i64 {
		let ka = sortKey(a)
		let kb = sortKey(b)
		if ka < kb {
			return -1
		}
		if ka > kb {
			return 1
		}
		return 0
	})
	return es
}

fn commit(r mut dice.Rand) CommitData {
	mut parents = []Id{}
	for i in 0..r.Intn(3) {
		parents = append(parents, someId(mut r))
	}
	mut hs = []str{}
	if r.Intn(3) == 0 {
		hs = append(hs, "gpgsig -----BEGIN PGP SIGNATURE-----\n\nabc\n-----END PGP SIGNATURE-----")
	}
	if r.Intn(4) == 0 {
		hs = append(hs, "encoding ISO-8859-1")
	}
	mut sig = ""
	if r.Intn(2) == 0 {
		sig = str(r.Bytes(64))
	}
	return CommitData{Tree: someId(mut r), Parents: parents, Change: NewChangeId(), Author: person(mut r), Committer: person(mut r), GitHeaders: hs, Signature: sig, Message: r.Str(r.Intn(40), "ab \n:"), Conflicts: []str{}}
}

fn tag(r mut dice.Rand) TagData {
	mut sig = ""
	if r.Intn(2) == 0 {
		sig = str(r.Bytes(64))
	}
	return TagData{Object: someId(mut r), Kind: Kind.Commit, Name: "v{r.Intn(100)}.{r.Intn(10)}", Tagger: person(mut r), Signature: sig, Message: r.Str(r.Intn(30), "xy \n")}
}

fn samples() []Object {
	mut r = dice.New(7)
	mut out = []Object{}
	for i in 0..40 {
		out = append(out, Object.Blob(str(r.Bytes(r.Intn(50)))))
		out = append(out, Object.Tree(tree(mut r)))
		out = append(out, Object.Commit(commit(mut r)))
		out = append(out, Object.Tag(tag(mut r)))
	}
	return out
}

fn TestWorkedExample(t mut crucible.T) {
	crucible.Equal(mut t, "hello blob id", Hash(Kind.Blob, "hello, tin!\n").Hex(), "ebc9953649c58cea3a38091425f91d38386dfcc68628332dd79cc6c84b3556e6")
	let (enc, err) = Encode(Object.Blob("hello, tin!\n"))
	t.NoFault("encode", err)
	crucible.Equal(mut t, "encoding", enc, "blob 12\x00hello, tin!\n")
	let (kind, body, err2) = Split(enc)
	t.NoFault("split", err2)
	t.True("kind", kind == Kind.Blob)
	crucible.Equal(mut t, "body", body, "hello, tin!\n")
}

fn TestRoundTrip(t mut crucible.T) {
	for o in samples() {
		let (body, err) = Body(o)
		t.NoFault("body", err)
		let (back, err2) = Decode(KindOf(o), body)
		t.NoFault("decode {KindName(KindOf(o))}", err2)
		if err2 != nil {
			continue
		}
		let (again, err3) = Body(back)
		t.NoFault("body again", err3)
		crucible.Equal(mut t, "{KindName(KindOf(o))} round trip", again, body)
	}
}

// TestDamaged flips every bit position's byte and truncates at every length: each result is a fault, or an object
// whose canonical body is exactly the damaged bytes. A panic fails the test.
fn TestDamaged(t mut crucible.T) {
	mut panics = 0
	mut accepted = 0
	mut rejected = 0
	for o in samples() {
		if KindOf(o) == Kind.Blob {
			continue
		}
		let body = Body(o) catch _ {
			""
		}
		let kind = KindOf(o)
		for i in 0..len(body) {
			for d in 0..2 {
				mut b = []u8(body)
				if d == 0 {
					b[i] = b[i] ^ 1
				} else {
					b[i] = b[i] ^ 0x20
				}
				let damaged = str(b)
				let ok = guard {
					checkDamaged(kind, damaged)
				} catch err {
					if fault.Is(err, fault.Panic) {
						panics += 1
					}
					false
				}
				if ok {
					accepted += 1
				} else {
					rejected += 1
				}
			}
		}
		for n in 0..len(body) {
			let ok = guard {
				checkDamaged(kind, body[0:n])
			} catch err {
				if fault.Is(err, fault.Panic) {
					panics += 1
				}
				false
			}
			if ok {
				accepted += 1
			} else {
				rejected += 1
			}
		}
	}
	crucible.Equal(mut t, "panics on damaged input", panics, 0)
	t.True("damage is rejected", rejected > 0)
	t.Log("damaged bodies: {rejected} rejected, {accepted} still canonical (bytes inside messages, names and ids)")
}

// checkDamaged is true when the damaged body decodes to an object whose canonical body is exactly it, false when
// it is rejected; it panics (through a failed check) when an accepted body is not canonical.
fn checkDamaged(kind Kind, damaged str) bool {
	let (o, err) = Decode(kind, damaged)
	if err != nil {
		return false
	}
	let again = Body(o) catch _ {
		panic("accepted a body it cannot encode")
	}
	if again != damaged {
		panic("accepted a non-canonical body")
	}
	return true
}

fn rejects(t mut crucible.T, label str, kind Kind, body str) {
	let (_, err) = Decode(kind, body)
	t.HasFault(label, err)
	if err != nil {
		t.True(label + " is ErrCorrupt", fault.Is(err, ErrCorrupt))
	}
}

fn TestRejects(t mut crucible.T) {
	let id = Hash(Kind.Blob, "x")
	let raw = id.Bytes()
	rejects(mut t, "tree out of order", Kind.Tree, "100644 b\x00{raw}100644 a\x00{raw}")
	rejects(mut t, "tree duplicate", Kind.Tree, "100644 a\x00{raw}100644 a\x00{raw}")
	rejects(mut t, "tree duplicate file and dir", Kind.Tree, "100644 a\x00{raw}40000 a\x00{raw}")
	rejects(mut t, "tree mode 100664", Kind.Tree, "100664 a\x00{raw}")
	rejects(mut t, "tree mode 040000", Kind.Tree, "040000 a\x00{raw}")
	rejects(mut t, "tree name .tit", Kind.Tree, "40000 .tit\x00{raw}")
	rejects(mut t, "tree name with slash", Kind.Tree, "100644 a/b\x00{raw}")
	rejects(mut t, "tree truncated id", Kind.Tree, "100644 a\x00{raw[0:31]}")
	let ch = AdoptedChangeId("08ed4b78").Letters()
	let base = "tree {id.Hex()}\nchange {ch}\nauthor A <a@x> 1 +0000\ncommitter A <a@x> 1 +0000\n\nmsg"
	let (_, okErr) = Decode(Kind.Commit, base)
	t.NoFault("the base commit decodes", okErr)
	rejects(mut t, "upper-case hex", Kind.Commit, twine.Replace(base, id.Hex(), upper(id.Hex()), 1))
	rejects(mut t, "zone -0000", Kind.Commit, "tree {id.Hex()}\nchange {ch}\nauthor A <a@x> 1 -0000\ncommitter A <a@x> 1 +0000\n\nmsg")
	rejects(mut t, "leading zero time", Kind.Commit, "tree {id.Hex()}\nchange {ch}\nauthor A <a@x> 01 +0000\ncommitter A <a@x> 1 +0000\n\nmsg")
	rejects(mut t, "no change", Kind.Commit, "tree {id.Hex()}\nauthor A <a@x> 1 +0000\ncommitter A <a@x> 1 +0000\n\nmsg")
	rejects(mut t, "unknown header", Kind.Commit, "tree {id.Hex()}\nchange {ch}\nauthor A <a@x> 1 +0000\ncommitter A <a@x> 1 +0000\nfoo bar\n\nmsg")
	rejects(mut t, "no empty line", Kind.Commit, "tree {id.Hex()}\nchange {ch}\nauthor A <a@x> 1 +0000\ncommitter A <a@x> 1 +0000\n")
	rejects(mut t, "hex in a change id", Kind.Commit, "tree {id.Hex()}\nchange 0123456789abcdef0123456789abcdef\nauthor A <a@x> 1 +0000\ncommitter A <a@x> 1 +0000\n\nmsg")
	rejects(mut t, "duplicate parent", Kind.Commit, "tree {id.Hex()}\nparent {id.Hex()}\nparent {id.Hex()}\nchange {ch}\nauthor A <a@x> 1 +0000\ncommitter A <a@x> 1 +0000\n\nmsg")
	rejects(mut t, "short signature", Kind.Commit, "tree {id.Hex()}\nchange {ch}\nauthor A <a@x> 1 +0000\ncommitter A <a@x> 1 +0000\nsignature AAAA\n\nmsg")
	rejects(mut t, "tag with a space in its name", Kind.Tag, "object {id.Hex()}\ntype commit\ntag v 1\ntagger A <a@x> 1 +0000\n\nm")
	let (_, _, e1) = Split("blob 3\x00ab")
	t.HasFault("split: wrong size", e1)
	let (_, _, e2) = Split("blob 03\x00abc")
	t.HasFault("split: leading zero", e2)
	let (_, _, e3) = Split("blob 3abc")
	t.HasFault("split: no NUL", e3)
}

fn upper(s str) str {
	mut b = []u8(s)
	for i in 0..len(b) {
		if b[i] >= 'a' && b[i] <= 'f' {
			b[i] = b[i] - 32
		}
	}
	return str(b)
}

fn TestPeople(t mut crucible.T) {
	crucible.Equal(mut t, "+0530", zoneText(330), "+0530")
	crucible.Equal(mut t, "-0800", zoneText(-480), "-0800")
	crucible.Equal(mut t, "+0000", zoneText(0), "+0000")
	let (p, err) = parsePerson("Ana Lu <ana@x.io> 1700000000 -0230", "author")
	t.NoFault("parse", err)
	crucible.Equal(mut t, "zone", p.Zone, -150)
	crucible.Equal(mut t, "name", p.Name, "Ana Lu")
	crucible.Equal(mut t, "email", p.Email, "ana@x.io")
}

fn TestChangeIds(t mut crucible.T) {
	let a = AdoptedChangeId("08ed4b78")
	t.True("adopted change ids are deterministic", a == AdoptedChangeId("08ed4b78"))
	t.True("and differ by git id", a != AdoptedChangeId("08ed4b79"))
	let letters = a.Letters()
	crucible.Equal(mut t, "32 letters", len(letters), 32)
	mut ok = true
	for i in 0..len(letters) {
		if letters[i] < 'k' || letters[i] > 'z' {
			ok = false
		}
	}
	t.True("only k to z", ok)
	let (back, err) = ParseChangeId(letters)
	t.NoFault("parse", err)
	t.True("round trip", back == a)
}

fn TestSigningPayload(t mut crucible.T) {
	mut r = dice.New(3)
	mut c = commit(mut r)
	c.Signature = str(r.Bytes(64))
	let (signed, err) = Body(Object.Commit(c))
	t.NoFault("body", err)
	let (payload, err2) = SigningPayload(c)
	t.NoFault("payload", err2)
	mut u = c
	u.Signature = ""
	let (unsigned, err3) = Encode(Object.Commit(u))
	t.NoFault("unsigned", err3)
	crucible.Equal(mut t, "payload is the unsigned encoding", payload, unsigned)
	t.True("the signed body differs", signed != payload)
}

type pieces struct {
	data str
	at   i64
	step i64
}

fn (p mut pieces) Read(buf mut []u8) !i64 {
	mut n = 0
	for n < len(buf) && n < p.step && p.at < len(p.data) {
		buf[n] = p.data[p.at]
		n += 1
		p.at += 1
	}
	return n
}

fn TestHashBlob(t mut crucible.T) {
	mut r = dice.New(21)
	for size in []i64{0, 1, 63, 64, 65, 1000, 70000, 200000} {
		let data = str(r.Bytes(size))
		for step in []i64{1, 7, 4096, 100000} {
			mut src = pieces{data: data, at: 0, step: step}
			let (id, err) = HashBlob(mut src, size)
			t.NoFault("hash {size} in steps of {step}", err)
			t.True("same id for {size} in steps of {step}", id == Hash(Kind.Blob, data))
		}
	}
	mut short = pieces{data: "abc", at: 0, step: 2}
	let (_, e1) = HashBlob(mut short, 4)
	t.True("fewer bytes than declared", e1 != nil && fault.Is(e1, ErrCorrupt))
	mut long = pieces{data: "abcde", at: 0, step: 2}
	let (_, e2) = HashBlob(mut long, 4)
	t.True("more bytes than declared", e2 != nil && fault.Is(e2, ErrCorrupt))
}

fn TestTagSigningPayloadKeepsTheTag(t mut crucible.T) {
	mut r = dice.New(4)
	let tg = TagData{Object: Hash(Kind.Blob, "x"), Kind: Kind.Blob, Name: "v1", Tagger: person(mut r), Signature: str(r.Bytes(64)), Message: "m\n"}
	let (_, err) = TagSigningPayload(tg)
	t.NoFault("payload", err)
	crucible.Equal(mut t, "the tag keeps its signature", len(tg.Signature), 64)
}

// A commit's recorded conflicts survive encoding, sit right after the committer, and a line with a newline is refused
// (#786).
fn TestConflictLines(t mut crucible.T) {
	let who = Person{Name: "Ada", Email: "ada@example.com", When: 1700000000, Zone: 0}
	let tree = Hash(Kind.Tree, "")
	let line = "a.txt\t-\t" + Hash(Kind.Blob, "ours").Hex() + "\t" + Hash(Kind.Blob, "theirs").Hex()
	let c = CommitData{Tree: tree, Parents: []Id{}, Change: NewChangeId(), Author: who, Committer: who, GitHeaders: []str{}, Signature: "", Message: "m\n", Conflicts: []str{line}}
	let body = Body(Object.Commit(c)) catch e {
		t.Error("encode: {e}")
		return
	}
	t.True("after the committer", twine.Contains(body, "committer Ada <ada@example.com> 1700000000 +0000\nconflict " + line + "\n\nm\n"))
	let back = Decode(Kind.Commit, body) catch e {
		t.Error("decode: {e}")
		return
	}
	match back {
		Commit(d) => {
			crucible.Equal(mut t, "conflicts", len(d.Conflicts), 1)
			crucible.Equal(mut t, "the line", d.Conflicts[0], line)
		}
		Tree(_) => {
			t.Error("not a commit")
		}
		Tag(_) => {
			t.Error("not a commit")
		}
		Blob(_) => {
			t.Error("not a commit")
		}
	}
	let bad = CommitData{Tree: tree, Parents: []Id{}, Change: NewChangeId(), Author: who, Committer: who, GitHeaders: []str{}, Signature: "", Message: "m\n", Conflicts: []str{"a\nb"}}
	let (_, err) = Body(Object.Commit(bad))
	t.True("a newline is refused", err != nil)
}

// richCommit is a commit with what commit leaves out: several parents, conflict lines, and git headers whose values
// have empty lines, lines starting with a space and a trailing newline, as a real gpgsig has.
fn richCommit(r mut dice.Rand) CommitData {
	mut c = commit(mut r)
	for i in 0..r.Intn(4) {
		c.Parents = append(c.Parents, someId(mut r))
	}
	for i in 0..r.Intn(3) {
		c.Conflicts = append(c.Conflicts, r.Str(1 + r.Intn(8), "ab\t-x <"))
	}
	let names = []str{"gpgsig", "mergetag", "encoding", "x-1"}
	mut hs = []str{}
	for i in 0..r.Intn(4) {
		hs = append(hs, names[r.Intn(len(names))] + " " + r.Str(r.Intn(30), "ab \n=-"))
	}
	c.GitHeaders = hs
	return c
}

// variant is damaged copy k of body, for k below 6 * len(body) + 1: each byte flipped two ways, deleted, and a newline
// or a space put before it, every truncation, and the body itself last.
fn variant(body str, k i64) str {
	let i = k / 6
	if i == len(body) {
		return body
	}
	return match k % 6 {
		0 => flip(body, i, 1)
		1 => flip(body, i, 0x20)
		2 => body[0:i] + body[i + 1:]
		3 => body[0:i] + "\n" + body[i:]
		4 => body[0:i] + " " + body[i:]
		_ => body[0:i]
	}
}

fn flip(body str, i i64, d u8) str {
	mut b = []u8(body)
	b[i] = b[i] ^ d
	return str(b)
}

// againstRef decodes b with decodeCommit and the reference: 1 when both accept it and it is canonical, 0 when both
// reject it with ErrCorrupt, and -1 (with a note) otherwise.
fn againstRef(b str) (i64, str) {
	let (got, err) = decodeCommit(b)
	let (want, refErr) = refDecodeCommit(b)
	if (err == nil) != (refErr == nil) {
		return -1, "decodeCommit and the reference differ on {b:q}: {err} / {refErr}"
	}
	if err != nil {
		if !fault.Is(err, ErrCorrupt) {
			return -1, "a rejection that is not ErrCorrupt: {err}"
		}
		return 0, ""
	}
	let again = Body(Object.Commit(got)) catch e {
		return -1, "accepted a body it cannot encode: {b:q}: {e}"
	}
	let refAgain = Body(Object.Commit(want)) catch _ {
		""
	}
	if again != b || refAgain != b {
		return -1, "accepted a non-canonical body: {b:q}"
	}
	return 1, ""
}

// refCounts is what checkAgainstRef found over a body's damaged copies, with the first difference.
type refCounts struct {
	accepted i64
	rejected i64
	differ   i64
	note     str
}

// checkAgainstRef runs againstRef over every damaged copy of body.
fn checkAgainstRef(body str) refCounts {
	mut out = refCounts{accepted: 0, rejected: 0, differ: 0, note: ""}
	for k in 0..6 * len(body) + 1 {
		let (res, note) = againstRef(variant(body, k))
		if res == 1 {
			out.accepted += 1
		} else if res == 0 {
			out.rejected += 1
		} else {
			if out.differ == 0 {
				out.note = note
			}
			out.differ += 1
		}
	}
	return out
}

// TestCommitDecoderMatchesReference checks that decodeCommit accepts exactly the bodies the decoder before #807's
// rewrite accepted, and that each of them is canonical: over generated commits with every kind of header, thousands
// of damaged copies of their bodies, and every truncation.
fn TestCommitDecoderMatchesReference(t mut crucible.T) {
	mut r = dice.New(11)
	mut accepted = 0
	mut rejected = 0
	mut differ = 0
	for n in 0..60 {
		let c = richCommit(mut r)
		let body = Body(Object.Commit(c)) catch e {
			t.Error("encode: {e}")
			return
		}
		// each body's copies in an arena: they are thousands of strings
		let got = arena {
			checkAgainstRef(body)
		}
		accepted += got.accepted
		rejected += got.rejected
		differ += got.differ
		if got.differ > 0 {
			t.Error(got.note)
		}
	}
	crucible.Equal(mut t, "bodies where the decoders differ", differ, 0)
	t.True("some damaged bodies are still canonical", accepted > 60)
	t.True("damage is rejected", rejected > 0)
	t.Log("{accepted} accepted, {rejected} rejected")
}

// ---- the commit decoder before #807's rewrite, kept as a reference ----

// refDecodeCommit is decodeCommit as it was before it read the body with one cursor: it split the headers into lines
// and compared the core headers encoded again. TestCommitDecoderMatchesReference checks the two accept the same bodies.
fn refDecodeCommit(body str) !CommitData {
	let h = try splitHeaders(body, "commit")
	let ls = h.lines
	mut k = 0
	if k >= len(ls) {
		fail fault.Wrap(ErrCorrupt, "commit: no tree")
	}
	let treeHex = field(ls[k], "tree")
	if treeHex == nil {
		fail fault.Wrap(ErrCorrupt, "commit: the first line is not tree")
	}
	let tree = try parseHexId(treeHex, "commit tree")
	let none = Person{Name: "", Email: "", When: 0, Zone: 0}
	mut c = CommitData{Tree: tree, Parents: []Id{}, Change: ChangeId{raw: ""}, Author: none, Committer: none, GitHeaders: []str{}, Signature: "", Message: h.message, Conflicts: []str{}}
	k += 1
	for k < len(ls) {
		let p = field(ls[k], "parent")
		if p == nil {
			break
		}
		let pid = try parseHexId(p, "commit parent")
		c.Parents = append(c.Parents, pid)
		k += 1
	}
	if k >= len(ls) {
		fail fault.Wrap(ErrCorrupt, "commit: no change")
	}
	let ch = field(ls[k], "change")
	if ch == nil {
		fail fault.Wrap(ErrCorrupt, "commit: change expected")
	}
	c.Change = try ParseChangeId(ch)
	k += 1
	if k >= len(ls) {
		fail fault.Wrap(ErrCorrupt, "commit: no author")
	}
	let au = field(ls[k], "author")
	if au == nil {
		fail fault.Wrap(ErrCorrupt, "commit: author expected")
	}
	c.Author = try refParsePerson(au, "author")
	k += 1
	if k >= len(ls) {
		fail fault.Wrap(ErrCorrupt, "commit: no committer")
	}
	let co = field(ls[k], "committer")
	if co == nil {
		fail fault.Wrap(ErrCorrupt, "commit: committer expected")
	}
	c.Committer = try refParsePerson(co, "committer")
	k += 1
	for k < len(ls) {
		let cf = field(ls[k], "conflict")
		if cf == nil {
			break
		}
		c.Conflicts = append(c.Conflicts, cf)
		k += 1
	}
	for k < len(ls) && len(ls[k]) > 4 && ls[k][0:4] == "git-" {
		// a header's continuation lines joined once (a signature has dozens: adding them one by one was quadratic)
		mut parts = []str{ls[k][4:]}
		k += 1
		for k < len(ls) && len(ls[k]) > 0 && ls[k][0] == ' ' {
			parts = append(parts, ls[k][1:])
			k += 1
		}
		c.GitHeaders = append(c.GitHeaders, twine.Join(parts, "\n"))
	}
	if k < len(ls) {
		let sig = field(ls[k], "signature")
		if sig == nil {
			fail fault.Wrap(ErrCorrupt, "commit: unexpected header {ls[k]}")
		}
		c.Signature = try parseSignature(sig)
		k += 1
	}
	if k != len(ls) {
		fail fault.Wrap(ErrCorrupt, "commit: header after the signature")
	}
	// the message is the body's own tail: only the headers and the signature line are encoded again, and compared in
	// place (#807: building the whole body again cost as much as the rest of decoding)
	// The git headers are the body's own lines between the core headers and the signature line, each checked here:
	// encoding them again would give those lines back, so only the rest is encoded again and compared.
	let coreBytes = try commitCore(c)
	let core = str(coreBytes)
	for h in c.GitHeaders {
		let (_, _) = try checkGitHeader(h)
	}
	let sig = try signatureLine(c.Signature)
	let sigAt = len(body) - len(c.Message) - 1 - len(sig)
	if sigAt < len(core) || !textAt(body, 0, core) || !textAt(body, sigAt, sig) || (len(c.GitHeaders) == 0 && sigAt != len(core)) {
		fail fault.Wrap(ErrCorrupt, "commit: not in canonical form")
	}
	return c
}

// refParsePerson is parsePerson as it was before #807's rewrite.
fn refParsePerson(s str, what str) !Person {
	let lt = indexFrom(s, 0, '<')
	let gt = indexFrom(s, 0, '>')
	if lt < 1 || gt < lt || s[lt - 1] != ' ' || gt + 1 >= len(s) || s[gt + 1] != ' ' {
		fail fault.Wrap(ErrCorrupt, "{what}: not 'name <email> seconds zone'")
	}
	let rest = s[gt + 2:]
	let sp = indexFrom(rest, 0, ' ')
	if sp < 0 {
		fail fault.Wrap(ErrCorrupt, "{what}: no zone")
	}
	let when = try parseDecimal(rest[0:sp], what + " time")
	let z = rest[sp + 1:]
	if len(z) != 5 || (z[0] != '+' && z[0] != '-') {
		fail fault.Wrap(ErrCorrupt, "{what}: zone {z} is not +hhmm or -hhmm")
	}
	for i in 1..5 {
		if z[i] < '0' || z[i] > '9' {
			fail fault.Wrap(ErrCorrupt, "{what}: zone {z} is not +hhmm or -hhmm")
		}
	}
	let hh = i64(z[1] - '0') * 10 + i64(z[2] - '0')
	let mm = i64(z[3] - '0') * 10 + i64(z[4] - '0')
	if mm >= 60 {
		fail fault.Wrap(ErrCorrupt, "{what}: zone minutes {mm}")
	}
	mut zone = hh * 60 + mm
	if z[0] == '-' {
		if zone == 0 {
			fail fault.Wrap(ErrCorrupt, "{what}: zone -0000 is written +0000")
		}
		zone = 0 - zone
	}
	let p = Person{Name: s[0:lt - 1], Email: s[lt + 1:gt], When: when, Zone: zone}
	try checkPerson(p, what)
	return p
}

// refCheckEntries is checkEntries as it was before #807's rewrite, with a map of the names seen and sortKey strings.
fn refCheckEntries(es []Entry) ! {
	mut seen = map[str]bool{}
	for i in 0..len(es) {
		let e = es[i]
		try checkName(e.Name)
		if len(e.Id.raw) != 32 {
			fail fault.Wrap(ErrCorrupt, "tree: entry {e.Name} has no id")
		}
		if seen[e.Name] {
			fail fault.Wrap(ErrCorrupt, "tree: duplicate name {e.Name}")
		}
		seen[e.Name] = true
		if i > 0 && !(sortKey(es[i - 1]) < sortKey(e)) {
			fail fault.Wrap(ErrCorrupt, "tree: {e.Name} is out of order")
		}
	}
}

// entryList is a list of entries with names from a small alphabet, so names repeat, are prefixes of each other and
// sort around "/": sorted by sortKey (with duplicates kept) half of the time.
fn entryList(r mut dice.Rand) []Entry {
	let modes = []Mode{Mode.File, Mode.Exec, Mode.Link, Mode.Dir}
	let id = someId(mut r)
	mut es = []Entry{}
	for i in 0..r.Intn(7) {
		es = append(es, Entry{Mode: modes[r.Intn(4)], Name: r.Str(1 + r.Intn(3), "a-.0"), Id: id})
	}
	if r.Intn(2) == 0 {
		sift.SortFunc(mut es, fn(a Entry, b Entry) i64 {
			let ka = sortKey(a)
			let kb = sortKey(b)
			if ka < kb {
				return -1
			}
			if ka > kb {
				return 1
			}
			return 0
		})
	}
	return es
}

// TestCheckEntriesMatchesReference checks that checkEntries rejects exactly the entry lists the check before #807's
// rewrite rejected, and that a tree's sortKey order agrees with keyCompare.
fn TestCheckEntriesMatchesReference(t mut crucible.T) {
	mut r = dice.New(5)
	mut ok = 0
	mut differ = 0
	for n in 0..20000 {
		let es = entryList(mut r)
		let err = checkEntries(es)
		let refErr = refCheckEntries(es)
		if (err == nil) != (refErr == nil) {
			differ += 1
			if differ < 5 {
				t.Error("checkEntries and the reference differ: {err} / {refErr}")
			}
		}
		if err == nil {
			ok += 1
		}
	}
	crucible.Equal(mut t, "entry lists where the checks differ", differ, 0)
	t.True("some lists are valid trees", ok > 1000)
	let names = []str{"a", "a-", "a.", "a0", "aa", "a-b", "b"}
	for x in names {
		for y in names {
			for dx in []bool{false, true} {
				for dy in []bool{false, true} {
					mut kx = x
					if dx {
						kx = x + "/"
					}
					mut ky = y
					if dy {
						ky = y + "/"
					}
					mut want = 0
					if kx < ky {
						want = -1
					} else if kx > ky {
						want = 1
					}
					crucible.Equal(mut t, "keyCompare {kx} {ky}", keyCompare(x, dx, y, dy), want)
				}
			}
		}
	}
}
