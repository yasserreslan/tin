package object

import "fault"
import "seal"
import "twine"

// The canonical encoding (design/tit.md section 3): Body writes it, Decode reads it back and rejects every other
// form, so equal content always has one encoding and one id.

// KindOf is the object's kind.
fn KindOf(o Object) Kind {
	return match o {
		Blob(_) => Kind.Blob
		Tree(_) => Kind.Tree
		Commit(_) => Kind.Commit
		Tag(_) => Kind.Tag
	}
}

// Body is the object's canonical body, or a fault when the object cannot be encoded canonically.
fn Body(o Object) !str {
	return match o {
		Blob(b) => b
		Tree(es) => try treeBody(es)
		Commit(c) => try commitBody(c)
		Tag(t) => try tagBody(t)
	}
}

// Encode is the object's full encoding, `<kind> <size>\0<body>`, whose SHA-256 is its id.
fn Encode(o Object) !str {
	let body = try Body(o)
	return "{KindName(KindOf(o))} {len(body)}\x00{body}"
}

// IdOfObject is the object's id.
fn IdOfObject(o Object) !Id {
	let body = try Body(o)
	return Hash(KindOf(o), body)
}

// Split reads a full encoding into its kind and body, checking the declared size.
fn Split(enc str) !(Kind, str) {
	let sp = indexFrom(enc, 0, ' ')
	if sp < 0 {
		fail fault.Wrap(ErrCorrupt, "no space after the kind")
	}
	let kind = try ParseKind(enc[0:sp])
	let nul = indexFrom(enc, sp + 1, 0)
	if nul < 0 {
		fail fault.Wrap(ErrCorrupt, "no NUL after the size")
	}
	let size = try parseDecimal(enc[sp + 1:nul], "size")
	if size != len(enc) - nul - 1 {
		fail fault.Wrap(ErrCorrupt, "size {size} but {len(enc) - nul - 1} bytes follow")
	}
	return kind, enc[nul + 1:]
}

// Decode reads an object of this kind from its body, rejecting every non-canonical form.
fn Decode(kind Kind, body str) !Object {
	match kind {
		Blob => {
			return Object.Blob(body)
		}
		Tree => {
			let es = try decodeTree(body)
			return Object.Tree(es)
		}
		Commit => {
			let c = try decodeCommit(body)
			return Object.Commit(c)
		}
		Tag => {
			let t = try decodeTag(body)
			return Object.Tag(t)
		}
	}
}

// ---- trees ----

// sortKey is the name a tree entry sorts by: a directory sorts as if its name ended in "/".
fn sortKey(e Entry) str {
	return match e.Mode {
		Dir => e.Name + "/"
		File, Exec, Link => e.Name
	}
}

fn checkName(name str) ! {
	if len(name) == 0 {
		fail fault.Wrap(ErrCorrupt, "tree: empty name")
	}
	if name == "." || name == ".." || name == ".tit" {
		fail fault.Wrap(ErrCorrupt, "tree: name {name} is not allowed")
	}
	for i in 0..len(name) {
		if name[i] == '/' || name[i] == 0 {
			fail fault.Wrap(ErrCorrupt, "tree: name {name} contains / or NUL")
		}
	}
}

// checkEntries checks a tree's entries: valid names, ids, and names in strictly increasing sortKey order with no name
// twice. It allocates nothing (#807: a map of the names seen and two sortKey strings per directory cost more than the
// entries). Two entries with one name have keys name and name + "/" (equal keys are already out of order), so a name
// is twice only when a directory comes after a file, link or executable of its name; every key between those two
// starts with the name, and the entries before the directory are sorted, so a binary search for that key finds it.
fn checkEntries(es []Entry) ! {
	for i in 0..len(es) {
		let e = es[i]
		try checkName(e.Name)
		if len(e.Id.raw) != 32 {
			fail fault.Wrap(ErrCorrupt, "tree: entry {e.Name} has no id")
		}
		if i > 0 {
			let prev = es[i - 1]
			let c = keyCompare(prev.Name, prev.Mode == Mode.Dir, e.Name, e.Mode == Mode.Dir)
			if c == 0 {
				fail fault.Wrap(ErrCorrupt, "tree: duplicate name {e.Name}")
			}
			if c > 0 {
				fail fault.Wrap(ErrCorrupt, "tree: {e.Name} is out of order")
			}
		}
		if e.Mode == Mode.Dir && sortedHasFile(es, i, e.Name) {
			fail fault.Wrap(ErrCorrupt, "tree: duplicate name {e.Name}")
		}
	}
}

// sortedHasFile reports whether es[0:n], sorted by sortKey, holds an entry that is not a directory named name.
fn sortedHasFile(es []Entry, n i64, name str) bool {
	mut lo = 0
	mut hi = n
	for lo < hi {
		let mid = lo + (hi - lo) / 2
		let m = es[mid]
		let c = keyCompare(m.Name, m.Mode == Mode.Dir, name, false)
		if c == 0 {
			return true
		}
		if c < 0 {
			lo = mid + 1
		} else {
			hi = mid
		}
	}
	return false
}

// keyCompare orders two entries' sortKeys (each name, with "/" after it for a directory) without building them: -1,
// 0 or 1.
fn keyCompare(a str, aDir bool, b str, bDir bool) i64 {
	let n = min(len(a), len(b))
	for k in 0..n {
		if a[k] != b[k] {
			if a[k] < b[k] {
				return -1
			}
			return 1
		}
	}
	mut i = n
	for {
		let x = keyTail(a, aDir, i)
		let y = keyTail(b, bDir, i)
		if x != y {
			if x < y {
				return -1
			}
			return 1
		}
		if x < 0 {
			return 0
		}
		i += 1
	}
}

// keyTail is byte k of the sortKey of an entry with this name: a byte of the name, '/' just after a directory's name,
// or -1 past the key's end.
fn keyTail(name str, dir bool, k i64) i64 {
	if k < len(name) {
		return i64(name[k])
	}
	if dir && k == len(name) {
		return i64('/')
	}
	return -1
}

fn treeBody(es []Entry) !str {
	try checkEntries(es)
	mut out = make([]u8, 0, 48 * len(es))
	for e in es {
		appendStr(mut out, ModeText(e.Mode))
		out = append(out, ' ')
		appendStr(mut out, e.Name)
		out = append(out, 0)
		appendStr(mut out, e.Id.raw)
	}
	return str(out)
}

fn parseMode(s str) !Mode {
	return try modeAt(s, 0, len(s))
}

// modeAt reads the mode written in s[from:to].
fn modeAt(s str, from i64, to i64) !Mode {
	let n = to - from
	if n == 6 && textAt(s, from, "100644") {
		return Mode.File
	}
	if n == 6 && textAt(s, from, "100755") {
		return Mode.Exec
	}
	if n == 6 && textAt(s, from, "120000") {
		return Mode.Link
	}
	if n == 5 && textAt(s, from, "40000") {
		return Mode.Dir
	}
	fail fault.Wrap(ErrCorrupt, "tree: unknown mode {s[from:to]}")
}

// decodeTree reads a tree's entries: each "mode name\0" and 32 bytes of id, taking only the name and the id out of
// the body. treeBody writes the same bytes back for the entries it accepts.
fn decodeTree(body str) ![]Entry {
	// the entries counted first, so the list is made once
	mut count = 0
	mut j = 0
	for j < len(body) {
		let nul = indexFrom(body, j, 0)
		if nul < 0 {
			break
		}
		count += 1
		j = nul + 33
	}
	mut es = make([]Entry, 0, count)
	mut i = 0
	for i < len(body) {
		let sp = indexFrom(body, i, ' ')
		if sp < 0 {
			fail fault.Wrap(ErrCorrupt, "tree: entry without a mode")
		}
		let mode = try modeAt(body, i, sp)
		let nul = indexFrom(body, sp + 1, 0)
		if nul < 0 || nul + 33 > len(body) {
			fail fault.Wrap(ErrCorrupt, "tree: truncated entry")
		}
		es = append(es, Entry{Mode: mode, Name: body[sp + 1:nul], Id: Id{raw: body[nul + 1:nul + 33]}})
		i = nul + 33
	}
	try checkEntries(es)
	return es
}

// ---- people ----

fn zoneText(z i64) str {
	mut sign = "+"
	mut m = z
	if z < 0 {
		sign = "-"
		m = 0 - z
	}
	return sign + two(m / 60) + two(m % 60)
}

fn two(n i64) str {
	if n < 10 {
		return "0{n}"
	}
	return "{n}"
}

fn checkPerson(p Person, what str) ! {
	for i in 0..len(p.Name) {
		let c = p.Name[i]
		if c == '<' || c == '>' || c == '\n' || c == 0 {
			fail fault.Wrap(ErrCorrupt, "{what}: name contains <, >, newline or NUL")
		}
	}
	for i in 0..len(p.Email) {
		let c = p.Email[i]
		if c == '<' || c == '>' || c == '\n' || c == 0 {
			fail fault.Wrap(ErrCorrupt, "{what}: email contains <, >, newline or NUL")
		}
	}
	if p.When < 0 {
		fail fault.Wrap(ErrCorrupt, "{what}: time before 1970")
	}
	if p.Zone <= -6000 || p.Zone >= 6000 || p.Zone % 60 >= 60 || p.Zone % 60 <= -60 {
		fail fault.Wrap(ErrCorrupt, "{what}: zone out of range")
	}
}

fn personText(p Person) str {
	return "{p.Name} <{p.Email}> {p.When} {zoneText(p.Zone)}"
}

fn parsePerson(s str, what str) !Person {
	return try parsePersonAt(s, 0, len(s), what)
}

// parsePersonAt reads "name <email> seconds zone" from s[from:to], one header line without its newline, taking only
// the name and the email out of s. It accepts only personText of the person it gives: the name ends at the first '<'
// (after a space) and the email at the first '>', which checkPerson then requires to be the only ones; the seconds are
// a canonical decimal, and the zone is five bytes, +hhmm or -hhmm with mm below 60 and not -0000, which zoneText writes
// back the same (hh is at most 99, so the zone stays inside checkPerson's range).
fn parsePersonAt(s str, from i64, to i64, what str) !Person {
	let lt = indexIn(s, from, to, '<')
	let gt = indexIn(s, from, to, '>')
	if lt < from + 1 || gt < lt || s[lt - 1] != ' ' || gt + 1 >= to || s[gt + 1] != ' ' {
		fail fault.Wrap(ErrCorrupt, "{what}: not 'name <email> seconds zone'")
	}
	let rest = gt + 2
	let sp = indexIn(s, rest, to, ' ')
	if sp < 0 {
		fail fault.Wrap(ErrCorrupt, "{what}: no zone")
	}
	let when = decimalAt(s, rest, sp)
	if when < 0 {
		fail fault.Wrap(ErrCorrupt, "{what} time: {s[rest:sp]} is not a canonical decimal")
	}
	let z = sp + 1
	if to - z != 5 || (s[z] != '+' && s[z] != '-') {
		fail fault.Wrap(ErrCorrupt, "{what}: zone {s[z:to]} is not +hhmm or -hhmm")
	}
	for i in z + 1..z + 5 {
		if s[i] < '0' || s[i] > '9' {
			fail fault.Wrap(ErrCorrupt, "{what}: zone {s[z:to]} is not +hhmm or -hhmm")
		}
	}
	let hh = i64(s[z + 1] - '0') * 10 + i64(s[z + 2] - '0')
	let mm = i64(s[z + 3] - '0') * 10 + i64(s[z + 4] - '0')
	if mm >= 60 {
		fail fault.Wrap(ErrCorrupt, "{what}: zone minutes {mm}")
	}
	mut zone = hh * 60 + mm
	if s[z] == '-' {
		if zone == 0 {
			fail fault.Wrap(ErrCorrupt, "{what}: zone -0000 is written +0000")
		}
		zone = 0 - zone
	}
	let p = Person{Name: s[from:lt - 1], Email: s[lt + 1:gt], When: when, Zone: zone}
	try checkPerson(p, what)
	return p
}

// ---- commits ----

fn checkGitHeader(h str) !(str, str) {
	let sp = indexFrom(h, 0, ' ')
	if sp < 1 {
		fail fault.Wrap(ErrCorrupt, "commit: git header {h} has no name")
	}
	let name = h[0:sp]
	for i in 0..len(name) {
		let c = name[i]
		if !((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-') {
			fail fault.Wrap(ErrCorrupt, "commit: git header name {name}")
		}
	}
	let value = h[sp + 1:]
	if indexFrom(value, 0, 0) >= 0 {
		fail fault.Wrap(ErrCorrupt, "commit: git header {name} contains NUL")
	}
	return name, value
}

fn signatureLine(sig str) !str {
	if len(sig) == 0 {
		return ""
	}
	if len(sig) != 64 {
		fail fault.Wrap(ErrCorrupt, "signature has {len(sig)} bytes, not 64")
	}
	return "signature {seal.B64([]u8(sig))}\n"
}

fn commitHeaders(c CommitData) !str {
	mut out = try commitCore(c)
	for h in c.GitHeaders {
		let (name, value) = try checkGitHeader(h)
		appendStr(mut out, "git-{name} ")
		// each line of the value, the ones after the first continued with a space
		mut from = 0
		for {
			let nl = indexFrom(value, from, '\n')
			if nl < 0 {
				appendStr(mut out, value[from:])
				break
			}
			appendStr(mut out, value[from:nl + 1])
			out = append(out, ' ')
			from = nl + 1
		}
		out = append(out, '\n')
	}
	return str(out)
}

// commitCore is the headers before git's: tree, parents, change, author, committer and conflicts.
fn commitCore(c CommitData) ![]u8 {
	if len(c.Tree.raw) != 32 {
		fail fault.Wrap(ErrCorrupt, "commit: no tree")
	}
	if len(c.Change.raw) != 16 {
		fail fault.Wrap(ErrCorrupt, "commit: no change id")
	}
	try checkPerson(c.Author, "author")
	try checkPerson(c.Committer, "committer")
	mut out = make([]u8, 0, 256)
	appendStr(mut out, "tree {c.Tree.Hex()}\n")
	mut seen = map[Id]bool{}
	for p in c.Parents {
		if len(p.raw) != 32 {
			fail fault.Wrap(ErrCorrupt, "commit: a parent has no id")
		}
		if seen[p] {
			fail fault.Wrap(ErrCorrupt, "commit: parent {p.Hex()} twice")
		}
		seen[p] = true
		appendStr(mut out, "parent {p.Hex()}\n")
	}
	appendStr(mut out, "change {c.Change.Letters()}\n")
	appendStr(mut out, "author {personText(c.Author)}\n")
	appendStr(mut out, "committer {personText(c.Committer)}\n")
	for k in c.Conflicts {
		if len(k) == 0 || indexFrom(k, 0, '\n') >= 0 || indexFrom(k, 0, 0) >= 0 {
			fail fault.Wrap(ErrCorrupt, "commit: a conflict line with a newline or NUL")
		}
		appendStr(mut out, "conflict {k}\n")
	}
	return out
}

fn commitBody(c CommitData) !str {
	let head = try commitHeaders(c)
	let sig = try signatureLine(c.Signature)
	return head + sig + "\n" + c.Message
}

// SigningPayload is the bytes a commit's signature covers: its encoding without the signature line.
fn SigningPayload(c CommitData) !str {
	let head = try commitHeaders(c)
	let body = head + "\n" + c.Message
	return "commit {len(body)}\x00{body}"
}

// lines is the header part of a body as lines, and the message after the empty line.
type headerLines struct {
	lines []str
	message str
}

fn splitHeaders(body str, what str) !headerLines {
	mut lines = []str{}
	mut i = 0
	for {
		if i >= len(body) {
			fail fault.Wrap(ErrCorrupt, "{what}: no empty line before the message")
		}
		let nl = indexFrom(body, i, '\n')
		if nl < 0 {
			fail fault.Wrap(ErrCorrupt, "{what}: no empty line before the message")
		}
		if nl == i {
			return headerLines{lines: lines, message: body[nl + 1:]}
		}
		lines = append(lines, body[i:nl])
		i = nl + 1
	}
}

fn field(line str, name str) ?str {
	let n = len(name)
	if len(line) > n && line[0:n] == name && line[n] == ' ' {
		return line[n + 1:]
	}
	return nil
}

fn parseHexId(s str, what str) !Id {
	let id = ParseId(s) catch err {
		fail fault.Wrap(ErrCorrupt, "{what}: {fault.Message(err)}")
	}
	if id.Hex() != s {
		fail fault.Wrap(ErrCorrupt, "{what}: hex digits are lower-case")
	}
	return id
}

fn parseSignature(s str) !str {
	let b = seal.B64Decode(s) catch _ {
		fail fault.Wrap(ErrCorrupt, "signature is not base64")
	}
	if len(b) != 64 || seal.B64(b) != s {
		fail fault.Wrap(ErrCorrupt, "signature is not 64 bytes in canonical base64")
	}
	return str(b)
}

// decodeCommit reads a commit body with one cursor and takes each field out of it once (#807: splitting the headers
// into lines, joining a signature's lines again and encoding the headers again to compare them cost two to three
// times the body in allocations, which log made for every commit).
//
// It accepts exactly the bodies commitBody writes, without encoding anything again. The headers are read in the
// order commitBody writes them, and each reader accepts only the text its writer gives for the value it returns:
// - tree and parent ids are 64 lower-case hex digits (hexIdLine), which Hex writes back the same; parents are
//   distinct, as commitCore requires;
// - the change id is 32 letters k to z (changeIdLine), which Letters writes back the same;
// - author and committer are read by parsePersonAt, which accepts only personText of what it gives;
// - a conflict is the rest of its line, not empty and without NUL, the checks commitCore makes;
// - a git header is read by gitHeaderAt, which accepts only what commitHeaders writes for what it gives;
// - the signature line holds 64 bytes in canonical base64 (parseSignature), which signatureLine writes back;
// then comes the empty line, and the message is the rest of the body. Each reader starts at a line's start and ends
// after that line's newline, so no other text can come between the lines. No line can be read as another kind of
// header: each starts with its own name and a space, and only a git header's continuation lines start with a space.
fn decodeCommit(body str) !CommitData {
	if !textAt(body, 0, "tree ") {
		fail fault.Wrap(ErrCorrupt, "commit: the first line is not tree")
	}
	let tree = try hexIdLine(body, 5, "commit tree")
	mut at = 5 + 65
	mut parents = []Id{}
	for textAt(body, at, "parent ") {
		let pid = try hexIdLine(body, at + 7, "commit parent")
		for q in parents {
			if q == pid {
				fail fault.Wrap(ErrCorrupt, "commit: parent {pid.Hex()} twice")
			}
		}
		parents = append(parents, pid)
		at += 7 + 65
	}
	if !textAt(body, at, "change ") {
		fail fault.Wrap(ErrCorrupt, "commit: change expected")
	}
	let change = try changeIdLine(body, at + 7)
	at += 7 + 33
	if !textAt(body, at, "author ") {
		fail fault.Wrap(ErrCorrupt, "commit: author expected")
	}
	let authorEnd = try lineEnd(body, at, "commit")
	let author = try parsePersonAt(body, at + 7, authorEnd, "author")
	at = authorEnd + 1
	if !textAt(body, at, "committer ") {
		fail fault.Wrap(ErrCorrupt, "commit: committer expected")
	}
	let committerEnd = try lineEnd(body, at, "commit")
	let committer = try parsePersonAt(body, at + 10, committerEnd, "committer")
	at = committerEnd + 1
	mut conflicts = []str{}
	for textAt(body, at, "conflict ") {
		let e = try lineEnd(body, at, "commit")
		if e == at + 9 || indexIn(body, at + 9, e, 0) >= 0 {
			fail fault.Wrap(ErrCorrupt, "commit: a conflict line is empty or contains NUL")
		}
		conflicts = append(conflicts, body[at + 9:e])
		at = e + 1
	}
	mut gitHeaders = []str{}
	for textAt(body, at, "git-") {
		let (h, next) = try gitHeaderAt(body, at)
		gitHeaders = append(gitHeaders, h)
		at = next
	}
	mut sig = ""
	if textAt(body, at, "signature ") {
		let e = try lineEnd(body, at, "commit")
		sig = try parseSignature(body[at + 10:e])
		at = e + 1
	}
	if at >= len(body) {
		fail fault.Wrap(ErrCorrupt, "commit: no empty line before the message")
	}
	if body[at] != '\n' {
		fail fault.Wrap(ErrCorrupt, "commit: unexpected header at byte {at}")
	}
	return CommitData{Tree: tree, Parents: parents, Change: change, Author: author, Committer: committer, GitHeaders: gitHeaders, Signature: sig, Message: body[at + 1:], Conflicts: conflicts}
}

// lineEnd is the offset of the newline ending the line that holds offset at.
fn lineEnd(s str, at i64, what str) !i64 {
	let e = indexFrom(s, at, '\n')
	if e < 0 {
		fail fault.Wrap(ErrCorrupt, "{what}: no empty line before the message")
	}
	return e
}

// hexIdLine reads the id written at offset at as 64 lower-case hex digits ending the line: the only text Hex writes
// for it.
fn hexIdLine(s str, at i64, what str) !Id {
	if at + 65 > len(s) || s[at + 64] != '\n' {
		fail fault.Wrap(ErrCorrupt, "{what}: an id is a line of 64 hex digits")
	}
	for i in 0..32 {
		let hi = hexValue(s[at + 2 * i])
		let lo = hexValue(s[at + 2 * i + 1])
		if hi < 0 || lo < 0 {
			fail fault.Wrap(ErrCorrupt, "{what}: an id has 64 lower-case hex digits")
		}
		decodeScratch[i] = u8(hi * 16 + lo)
	}
	return Id{raw: str(decodeScratch[0:32])}
}

// hexValue is the value of a lower-case hex digit, or -1.
fn hexValue(c u8) i64 {
	if c >= '0' && c <= '9' {
		return i64(c - '0')
	}
	if c >= 'a' && c <= 'f' {
		return i64(c - 'a') + 10
	}
	return -1
}

// changeIdLine reads the change id written at offset at as 32 letters k to z ending the line: the only text Letters
// writes for it.
fn changeIdLine(s str, at i64) !ChangeId {
	if at + 33 > len(s) || s[at + 32] != '\n' {
		fail fault.Wrap(ErrCorrupt, "commit: a change id is a line of 32 letters")
	}
	for i in 0..16 {
		let hi = s[at + 2 * i]
		let lo = s[at + 2 * i + 1]
		if hi < 'k' || hi > 'z' || lo < 'k' || lo > 'z' {
			fail fault.Wrap(ErrCorrupt, "commit: change id letters are k to z")
		}
		decodeScratch[i] = ((hi - 'k') << 4) | (lo - 'k')
	}
	return ChangeId{raw: str(decodeScratch[0:16])}
}

// gitNameByte reports whether c may be in a git header's name.
fn gitNameByte(c u8) bool {
	return (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-'
}

// gitHeaderAt reads the git header whose line starts at offset at ("git-" name ' ' value), with its continuation
// lines, and gives the header as CommitData keeps it ("name value", the value's lines joined by newlines, built in
// one allocation) and the offset after its last line. It accepts only what commitHeaders writes for that header: the
// name is one or more of a-z, 0-9 and '-' up to the first space and the value has no NUL (checkGitHeader's rules),
// and each newline of the value is written as a newline and a space, so each continuation line is a space and one
// more line of the value. The header ends at the first line that does not start with a space.
fn gitHeaderAt(s str, at i64) !(str, i64) {
	let from = at + 4
	let e = try lineEnd(s, from, "commit")
	mut p = from
	for p < e && gitNameByte(s[p]) {
		p += 1
	}
	if p == from || p == e || s[p] != ' ' {
		fail fault.Wrap(ErrCorrupt, "commit: a git header name is not one or more of a-z, 0-9 and -")
	}
	if indexIn(s, p + 1, e, 0) >= 0 {
		fail fault.Wrap(ErrCorrupt, "commit: git header {s[from:p]} contains NUL")
	}
	mut size = e - from
	mut end = e
	for end + 1 < len(s) && s[end + 1] == ' ' {
		let ne = try lineEnd(s, end + 1, "commit")
		if indexIn(s, end + 2, ne, 0) >= 0 {
			fail fault.Wrap(ErrCorrupt, "commit: git header {s[from:p]} contains NUL")
		}
		size += ne - end - 1
		end = ne
	}
	if end == e {
		return s[from:e], e + 1
	}
	// every newline before end starts a continuation line: the newline is kept and the space after it dropped
	if size > len(decodeScratch) {
		mut out = make([]u8, 0, size)
		mut i = from
		for i < end {
			let c = s[i]
			out = append(out, c)
			if c == '\n' {
				i += 2
			} else {
				i += 1
			}
		}
		return str(out), end + 1
	}
	mut i = from
	mut n = 0
	for i < end {
		let c = s[i]
		decodeScratch[n] = c
		n += 1
		if c == '\n' {
			i += 2
		} else {
			i += 1
		}
	}
	return str(decodeScratch[0:n]), end + 1
}

// decodeScratch is where decoding builds a value before it copies it into the value's one string (an id's bytes, a git
// header's lines joined): a []u8 made for each value and then copied doubled what decoding allocates for it, and a
// signed commit's signature is most of its headers. Each core has its own, and each function that writes it is done
// with it before it returns, with no wait in between.
mut decodeScratch = make([]u8, 4096)

// textAt reports whether s holds t at offset at.
fn textAt(s str, at i64, t str) bool {
	if at + len(t) > len(s) {
		return false
	}
	for i in 0..len(t) {
		if s[at + i] != t[i] {
			return false
		}
	}
	return true
}

// ---- tags ----

fn checkTagName(name str) ! {
	if len(name) == 0 {
		fail fault.Wrap(ErrCorrupt, "tag: empty name")
	}
	for i in 0..len(name) {
		let c = name[i]
		if c == ' ' || c == '\n' || c == 0 {
			fail fault.Wrap(ErrCorrupt, "tag: name contains a space, newline or NUL")
		}
	}
}

fn tagBody(t TagData) !str {
	if len(t.Object.raw) != 32 {
		fail fault.Wrap(ErrCorrupt, "tag: no object")
	}
	try checkTagName(t.Name)
	try checkPerson(t.Tagger, "tagger")
	let sig = try signatureLine(t.Signature)
	return "object {t.Object.Hex()}\ntype {KindName(t.Kind)}\ntag {t.Name}\ntagger {personText(t.Tagger)}\n{sig}\n{t.Message}"
}

// TagSigningPayload is the bytes a tag's signature covers: its encoding without the signature line.
fn TagSigningPayload(t TagData) !str {
	let u = TagData{Object: t.Object, Kind: t.Kind, Name: t.Name, Tagger: t.Tagger, Signature: "", Message: t.Message}
	let body = try tagBody(u)
	return "tag {len(body)}\x00{body}"
}

fn decodeTag(body str) !TagData {
	let h = try splitHeaders(body, "tag")
	let ls = h.lines
	if len(ls) < 4 {
		fail fault.Wrap(ErrCorrupt, "tag: missing headers")
	}
	let obj = field(ls[0], "object")
	let ty = field(ls[1], "type")
	let name = field(ls[2], "tag")
	let tagger = field(ls[3], "tagger")
	if obj == nil || ty == nil || name == nil || tagger == nil {
		fail fault.Wrap(ErrCorrupt, "tag: headers are object, type, tag, tagger")
	}
	let oid = try parseHexId(obj, "tag object")
	let kind = try ParseKind(ty)
	let who = try parsePerson(tagger, "tagger")
	mut t = TagData{Object: oid, Kind: kind, Name: name, Tagger: who, Signature: "", Message: h.message}
	if len(ls) == 5 {
		let sig = field(ls[4], "signature")
		if sig == nil {
			fail fault.Wrap(ErrCorrupt, "tag: unexpected header {ls[4]}")
		}
		t.Signature = try parseSignature(sig)
	} else if len(ls) > 5 {
		fail fault.Wrap(ErrCorrupt, "tag: too many headers")
	}
	let again = try tagBody(t)
	if again != body {
		fail fault.Wrap(ErrCorrupt, "tag: not in canonical form")
	}
	return t
}

// ---- helpers ----

fn indexFrom(s str, from i64, c u8) i64 {
	return twine.IndexByteFrom(s, from, c)
}

fn appendStr(out mut []u8, s str) {
	out = append(out, s...)
}

// parseDecimal reads a non-negative decimal with no sign and no leading zero.
fn parseDecimal(s str, what str) !i64 {
	let n = decimalAt(s, 0, len(s))
	if n < 0 {
		fail fault.Wrap(ErrCorrupt, "{what}: {s} is not a canonical decimal")
	}
	return n
}

// decimalAt is the decimal in s[from:to] when it is canonical (1 to 18 digits, no sign, no leading zero), else -1.
fn decimalAt(s str, from i64, to i64) i64 {
	let n = to - from
	if n <= 0 || n > 18 || (n > 1 && s[from] == '0') {
		return -1
	}
	mut v i64 = 0
	for i in from..to {
		let c = s[i]
		if c < '0' || c > '9' {
			return -1
		}
		v = v * 10 + i64(c - '0')
	}
	return v
}

// indexIn is the offset of the first c in s[from:to], or -1.
fn indexIn(s str, from i64, to i64, c u8) i64 {
	for i in from..to {
		if s[i] == c {
			return i
		}
	}
	return -1
}
