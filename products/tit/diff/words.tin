package diff

// Word diff (#785, #790): the hunks of a unified diff, each change shown inside its lines, as git diff
// --word-diff=plain shows it: removed words as [-...-], added ones as {+...+}, the rest as the new text has it.
// Words are runs of characters other than spaces, tabs and newlines; a mark never crosses the end of a line.

type word struct {
	at  i64
	end i64
}

fn isSpace(c u8) bool {
	return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

fn wordsOf(s str) []word {
	mut out = []word{}
	mut i = 0
	for i < len(s) {
		if isSpace(s[i]) {
			i += 1
			continue
		}
		let start = i
		for i < len(s) && !isSpace(s[i]) {
			i += 1
		}
		out = append(out, word{at: start, end: i})
	}
	return out
}

// marked is text between open and close, closed and opened again around each line end inside it.
fn marked(out mut []u8, text str, open str, close str) {
	appendText(mut out, open)
	for i in 0..len(text) {
		if text[i] == '\n' {
			appendText(mut out, close + "\n" + open)
		} else {
			out = append(out, text[i])
		}
	}
	appendText(mut out, close)
}

// wordBlock writes a changed block, from its old text to its new, with its words marked.
fn wordBlock(out mut []u8, old str, new str) {
	let ow = wordsOf(old)
	let nw = wordsOf(new)
	mut ot = make([]str, 0, len(ow))
	for w in ow {
		ot = append(ot, old[w.at:w.end])
	}
	mut nt = make([]str, 0, len(nw))
	for w in nw {
		nt = append(nt, new[w.at:w.end])
	}
	let es = Diff(ot, nt)
	mut i = 0
	mut j = 0
	mut at = 0
	mut deleted = false
	for e in es {
		match e {
			Keep(n) => {
				for k in 0..n {
					let w = nw[j + k]
					appendText(mut out, new[at:w.at])
					appendText(mut out, new[w.at:w.end])
					at = w.end
				}
				i += n
				j += n
				deleted = false
			}
			Delete(n) => {
				let first = ow[i]
				let last = ow[i + n - 1]
				// the space before a removal comes from the new text, up to where its next word starts
				mut stop = len(new)
				if j < len(nw) {
					stop = nw[j].at
				}
				mut gap = at
				for gap < stop && isSpace(new[gap]) && new[gap] != '\n' {
					gap += 1
				}
				appendText(mut out, new[at:gap])
				at = gap
				marked(mut out, old[first.at:last.end], "[-", "-]")
				i += n
				deleted = true
			}
			Insert(n) => {
				let first = nw[j]
				let last = nw[j + n - 1]
				if !deleted {
					appendText(mut out, new[at:first.at])
				}
				marked(mut out, new[first.at:last.end], "{{+", "+}}")
				at = last.end
				j += n
				deleted = false
			}
		}
	}
	appendText(mut out, new[at:])
}

// WordDiff is the word diff of a and b with context lines around each hunk, after the --- and +++ lines.
fn WordDiff(oldName str, newName str, a str, b str, context i64) str {
	let la = Lines(a)
	let lb = Lines(b)
	let ops = opsOf(Diff(la, lb))
	mut out = []u8{}
	mut x = 0
	for x < len(ops) {
		if ops[x].kind == kindKeep {
			x += 1
			continue
		}
		let (first, end) = hunkAt(ops, x, context)
		if len(out) == 0 {
			appendText(mut out, "--- {oldName}\n+++ {newName}\n")
		}
		appendText(mut out, hunkHeader(la, ops, first, end))
		mut k = first
		for k < end {
			if ops[k].kind == kindKeep {
				appendText(mut out, la[ops[k].ai])
				if len(la[ops[k].ai]) == 0 || la[ops[k].ai][len(la[ops[k].ai]) - 1] != '\n' {
					out = append(out, '\n')
				}
				k += 1
				continue
			}
			mut old = ""
			mut new = ""
			for k < end && ops[k].kind != kindKeep {
				if ops[k].kind == kindDelete {
					old = old + la[ops[k].ai]
				} else {
					new = new + lb[ops[k].bi]
				}
				k += 1
			}
			if len(new) > 0 && new[len(new) - 1] != '\n' {
				new = new + "\n"
			}
			if len(new) == 0 {
				// only removals: their lines, marked, on the old text's lines
				marked(mut out, twineTrimNewline(old), "[-", "-]")
				out = append(out, '\n')
				continue
			}
			wordBlock(mut out, old, new)
		}
		x = end
	}
	return str(out)
}

fn twineTrimNewline(s str) str {
	if len(s) > 0 && s[len(s) - 1] == '\n' {
		return s[0:len(s) - 1]
	}
	return s
}
