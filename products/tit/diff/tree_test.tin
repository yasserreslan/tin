package diff

import "../object"
import "../store"
import "crucible"

// Tree diff cases git's comparison does not cover (#785); that comparison is
// products/tit/tests/programs/treediff_git.tin.

fn tree1(s mut store.Mem, name str, body str) object.Id {
	let b = s.PutRaw(object.Kind.Blob, body) catch _ {
		object.NoId
	}
	return s.Put(object.Object.Tree([]object.Entry{object.Entry{Mode: object.Mode.File, Name: name, Id: b}})) catch _ {
		object.NoId
	}
}

fn TestTreeDiffWithoutRenames(t mut crucible.T) {
	mut s = store.NewMem()
	let a = tree1(mut s, "old.txt", "same content\n")
	let b = tree1(mut s, "new.txt", "same content\n")
	let plain = TreeDiff(mut s, a, b, false) catch _ {
		[]FileChange{}
	}
	crucible.Equal(mut t, "without renames: an add and a delete", len(plain), 2)
	let found = TreeDiff(mut s, a, b, true) catch _ {
		[]FileChange{}
	}
	t.True("with renames: one rename", len(found) == 1 && found[0].Kind == Kind.Renamed && found[0].Similarity == 100)
	let fromEmpty = TreeDiff(mut s, object.NoId, b, true) catch _ {
		[]FileChange{}
	}
	t.True("from an empty tree: added", len(fromEmpty) == 1 && fromEmpty[0].Kind == Kind.Added)
	let same = TreeDiff(mut s, a, a, true) catch _ {
		[]FileChange{FileChange{Kind: Kind.Added, Path: "", OldPath: "", OldHash: "", NewHash: "", OldMode: object.Mode.File, NewMode: object.Mode.File, Similarity: 0}}
	}
	crucible.Equal(mut t, "a tree against itself", len(same), 0)
}
