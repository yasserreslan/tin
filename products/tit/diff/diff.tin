package diff

import "constraints"

// The generic diff (#785): Myers' O(ND) algorithm in linear space (the middle-snake bisection), over any
// comparable element type, so one implementation serves lines, words and declarations. A cost bound turns a
// huge diff into a whole replacement instead of a long wait.

// Edit is one run of the script from a to b: keep, insert or delete n elements.
type Edit enum {
	Keep(i64)
	Insert(i64)
	Delete(i64)
}

const kindKeep = 0
const kindInsert = 1
const kindDelete = 2

type run struct {
	kind i64
	n    i64
}

type state struct {
	out    []run
	budget i64
	over   bool
}

// Diff is a shortest edit script from a to b.
fn Diff[T constraints.Comparable](a []T, b []T) []Edit {
	let (es, _) = DiffLimit(a, b, -1)
	return es
}

// DiffLimit is Diff with a bound on the work (about one unit per diagonal step; a negative bound is no bound).
// When the bound runs out it gives up on the part it is in, which becomes a deletion and an insertion; ok is
// false then, and the script is still correct, only not the shortest.
fn DiffLimit[T constraints.Comparable](a []T, b []T, maxCost i64) ([]Edit, bool) {
	mut st = state{out: []run{}, budget: maxCost, over: false}
	walk(a, 0, len(a), b, 0, len(b), mut st)
	mut es = make([]Edit, 0, len(st.out))
	for r in st.out {
		if r.kind == kindKeep {
			es = append(es, Edit.Keep(r.n))
		} else if r.kind == kindInsert {
			es = append(es, Edit.Insert(r.n))
		} else {
			es = append(es, Edit.Delete(r.n))
		}
	}
	return es, !st.over
}

fn emit(st mut state, kind i64, n i64) {
	if n <= 0 {
		return
	}
	let last = len(st.out) - 1
	if last >= 0 && st.out[last].kind == kind {
		st.out[last].n += n
		return
	}
	// a deletion goes before an insertion next to it, as in a unified diff
	if kind == kindDelete && last >= 0 && st.out[last].kind == kindInsert {
		let ins = st.out[last].n
		st.out[last] = run{kind: kindDelete, n: n}
		if last >= 1 && st.out[last - 1].kind == kindDelete {
			st.out[last - 1].n += n
			st.out[last] = run{kind: kindInsert, n: ins}
			return
		}
		st.out = append(st.out, run{kind: kindInsert, n: ins})
		return
	}
	st.out = append(st.out, run{kind: kind, n: n})
}

fn walk[T constraints.Comparable](a []T, alo0 i64, ahi0 i64, b []T, blo0 i64, bhi0 i64, st mut state) {
	mut alo = alo0
	mut ahi = ahi0
	mut blo = blo0
	mut bhi = bhi0
	mut p = 0
	for alo + p < ahi && blo + p < bhi && a[alo + p] == b[blo + p] {
		p += 1
	}
	emit(mut st, kindKeep, p)
	alo += p
	blo += p
	mut s = 0
	for ahi - s > alo && bhi - s > blo && a[ahi - 1 - s] == b[bhi - 1 - s] {
		s += 1
	}
	ahi -= s
	bhi -= s
	if alo == ahi {
		emit(mut st, kindInsert, bhi - blo)
	} else if blo == bhi {
		emit(mut st, kindDelete, ahi - alo)
	} else {
		let (x, y) = bisect(a, alo, ahi, b, blo, bhi, mut st)
		if x < 0 {
			emit(mut st, kindDelete, ahi - alo)
			emit(mut st, kindInsert, bhi - blo)
		} else {
			walk(a, alo, x, b, blo, y, mut st)
			walk(a, x, ahi, b, y, bhi, mut st)
		}
	}
	emit(mut st, kindKeep, s)
}

// bisect finds where the shortest path through a[alo:ahi] and b[blo:bhi] crosses its middle, searching from both
// ends at once; it gives that point, or (-1, -1) when the two share nothing or the budget ran out.
fn bisect[T constraints.Comparable](a []T, alo i64, ahi i64, b []T, blo i64, bhi i64, st mut state) (i64, i64) {
	let n = ahi - alo
	let m = bhi - blo
	let maxD = (n + m + 1) / 2
	let off = maxD
	let vlen = 2 * maxD + 2
	mut v1 = make([]i64, vlen)
	mut v2 = make([]i64, vlen)
	for i in 0..vlen {
		v1[i] = -1
		v2[i] = -1
	}
	v1[off + 1] = 0
	v2[off + 1] = 0
	let delta = n - m
	let front = delta % 2 != 0
	mut k1start = 0
	mut k1end = 0
	mut k2start = 0
	mut k2end = 0
	for d in 0..maxD {
		if st.budget >= 0 {
			st.budget -= 2 * d + 1
			if st.budget < 0 {
				st.over = true
				return -1, -1
			}
		}
		mut k1 = -d + k1start
		for k1 <= d - k1end {
			let k1off = off + k1
			mut x1 = 0
			if k1 == -d || (k1 != d && v1[k1off - 1] < v1[k1off + 1]) {
				x1 = v1[k1off + 1]
			} else {
				x1 = v1[k1off - 1] + 1
			}
			mut y1 = x1 - k1
			for x1 < n && y1 < m && a[alo + x1] == b[blo + y1] {
				x1 += 1
				y1 += 1
			}
			v1[k1off] = x1
			if x1 > n {
				k1end += 2
			} else if y1 > m {
				k1start += 2
			} else if front {
				let k2off = off + delta - k1
				if k2off >= 0 && k2off < vlen && v2[k2off] != -1 {
					if x1 >= n - v2[k2off] {
						return alo + x1, blo + y1
					}
				}
			}
			k1 += 2
		}
		mut k2 = -d + k2start
		for k2 <= d - k2end {
			let k2off = off + k2
			mut x2 = 0
			if k2 == -d || (k2 != d && v2[k2off - 1] < v2[k2off + 1]) {
				x2 = v2[k2off + 1]
			} else {
				x2 = v2[k2off - 1] + 1
			}
			mut y2 = x2 - k2
			for x2 < n && y2 < m && a[alo + n - x2 - 1] == b[blo + m - y2 - 1] {
				x2 += 1
				y2 += 1
			}
			v2[k2off] = x2
			if x2 > n {
				k2end += 2
			} else if y2 > m {
				k2start += 2
			} else if !front {
				let k1off = off + delta - k2
				if k1off >= 0 && k1off < vlen && v1[k1off] != -1 {
					let x1 = v1[k1off]
					let y1 = off + x1 - k1off
					if x1 >= n - x2 {
						return alo + x1, blo + y1
					}
				}
			}
			k2 += 2
		}
	}
	return -1, -1
}

// Cost is the number of inserted and deleted elements in a script.
fn Cost(es []Edit) i64 {
	mut c = 0
	for e in es {
		match e {
			Keep(_) => {
			}
			Insert(n) => {
				c += n
			}
			Delete(n) => {
				c += n
			}
		}
	}
	return c
}

// Apply rebuilds b from a and a script of Diff(a, b), reading inserted elements from b.
fn Apply[T constraints.Comparable](a []T, b []T, es []Edit) []T {
	mut out = make([]T, 0, len(b))
	mut i = 0
	mut j = 0
	for e in es {
		match e {
			Keep(n) => {
				for k in 0..n {
					out = append(out, a[i + k])
				}
				i += n
				j += n
			}
			Insert(n) => {
				for k in 0..n {
					out = append(out, b[j + k])
				}
				j += n
			}
			Delete(n) => {
				i += n
			}
		}
	}
	return out
}
