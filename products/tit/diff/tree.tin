package diff

import "../object"
import "../store"
import "fault"
import "sift"

// Tree diffs (#785): what changed between two trees, file by file, with renames found by content: first files whose
// bytes are identical, then pairs whose similarity (the bytes of the lines they share, against the larger file) is at
// least half. Ids are kept as their bytes, not as object.Id fields (#847).

// Kind is how a file changed.
type Kind enum {
	Added
	Deleted
	Modified
	Renamed
	TypeChanged
}

// FileChange is one file's change: its path (the new path for a rename), the old path, both blob ids as bytes ("" for
// none), both modes and, for a rename, the similarity in percent.
type FileChange struct {
	Kind       Kind
	Path       str
	OldPath    str
	OldHash    str
	NewHash    str
	OldMode    object.Mode
	NewMode    object.Mode
	Similarity i64
}

type file struct {
	mode object.Mode
	hash str
}

fn flatten[S store.ObjectStore](s mut S, tree object.Id, prefix str, out mut map[str]file) ! {
	if tree == object.NoId {
		return
	}
	let o = try s.Get(tree)
	match o {
		Tree(es) => {
			for e in es {
				if e.Mode == object.Mode.Dir {
					try flatten(mut s, e.Id, prefix + e.Name + "/", mut out)
				} else {
					out[prefix + e.Name] = file{mode: e.Mode, hash: e.Id.Bytes()}
				}
			}
		}
		Blob(_) => {
			fail fault.Wrap(object.ErrCorrupt, "{tree.Hex()} is not a tree")
		}
		Commit(_) => {
			fail fault.Wrap(object.ErrCorrupt, "{tree.Hex()} is not a tree")
		}
		Tag(_) => {
			fail fault.Wrap(object.ErrCorrupt, "{tree.Hex()} is not a tree")
		}
	}
}

fn isLink(m object.Mode) bool {
	return m == object.Mode.Link
}

fn blob[S store.ObjectStore](s mut S, hash str) !str {
	let id = try object.IdOf(hash)
	let (_, body) = try s.GetRaw(id)
	return body
}

// Similarity is how much of a and b is the same, in percent: the bytes of the lines a and b share against the larger.
fn Similarity(a str, b str) i64 {
	if len(a) == 0 && len(b) == 0 {
		return 100
	}
	let la = Lines(a)
	let lb = Lines(b)
	let (es, _) = DiffLimit(la, lb, 4000000)
	mut common = 0
	mut i = 0
	for e in es {
		match e {
			Keep(n) => {
				for k in 0..n {
					common += len(la[i + k])
				}
				i += n
			}
			Delete(n) => {
				i += n
			}
			Insert(_) => {
			}
		}
	}
	return common * 100 / max(len(a), len(b))
}

const renamePairs = 10000

// TreeDiff is every file that differs between the trees a and b (object.NoId for an empty tree), sorted by path,
// with renames found when renames is true.
fn TreeDiff[S store.ObjectStore](s mut S, a object.Id, b object.Id, renames bool) ![]FileChange {
	mut fa = map[str]file{}
	mut fb = map[str]file{}
	try flatten(mut s, a, "", mut fa)
	try flatten(mut s, b, "", mut fb)
	mut out = []FileChange{}
	mut added = []str{}
	mut deleted = []str{}
	for path, x in fa {
		let (y, ok) = fb[path]
		if !ok {
			deleted = append(deleted, path)
		} else if isLink(x.mode) != isLink(y.mode) {
			out = append(out, FileChange{Kind: Kind.TypeChanged, Path: path, OldPath: path, OldHash: x.hash, NewHash: y.hash, OldMode: x.mode, NewMode: y.mode, Similarity: 0})
		} else if x.hash != y.hash || x.mode != y.mode {
			out = append(out, FileChange{Kind: Kind.Modified, Path: path, OldPath: path, OldHash: x.hash, NewHash: y.hash, OldMode: x.mode, NewMode: y.mode, Similarity: 0})
		}
	}
	for path, _ in fb {
		let (_, ok) = fa[path]
		if !ok {
			added = append(added, path)
		}
	}
	sift.Sort(mut added)
	sift.Sort(mut deleted)
	mut goneDel = map[str]bool{}
	mut goneAdd = map[str]bool{}
	if renames && len(added) > 0 && len(deleted) > 0 {
		// identical bytes first, pairing each added file with the first unused deleted one
		mut byHash = map[str][]str{}
		for d in deleted {
			let h = fa[d].hash
			let (list, _) = byHash[h]
			byHash[h] = append(list, d)
		}
		for p in added {
			let (list, ok) = byHash[fb[p].hash]
			if !ok {
				continue
			}
			for d in list {
				if !goneDel[d] {
					goneDel[d] = true
					goneAdd[p] = true
					out = append(out, FileChange{Kind: Kind.Renamed, Path: p, OldPath: d, OldHash: fa[d].hash, NewHash: fb[p].hash, OldMode: fa[d].mode, NewMode: fb[p].mode, Similarity: 100})
					break
				}
			}
		}
		// then similar contents, best pairs first
		mut leftAdd = []str{}
		for p in added {
			if !goneAdd[p] && !isLink(fb[p].mode) {
				leftAdd = append(leftAdd, p)
			}
		}
		mut leftDel = []str{}
		for d in deleted {
			if !goneDel[d] && !isLink(fa[d].mode) {
				leftDel = append(leftDel, d)
			}
		}
		if len(leftAdd) * len(leftDel) <= renamePairs {
			mut pairs = []pairScore{}
			for p in leftAdd {
				let nb = try blob(mut s, fb[p].hash)
				for d in leftDel {
					let ob = try blob(mut s, fa[d].hash)
					let score = arena {
						Similarity(ob, nb)
					}
					if score >= 50 {
						pairs = append(pairs, pairScore{add: p, del: d, score: score})
					}
				}
			}
			sift.SortStableFunc(mut pairs, fn(x pairScore, y pairScore) i64 {
				return y.score - x.score
			})
			for pr in pairs {
				if goneAdd[pr.add] || goneDel[pr.del] {
					continue
				}
				goneAdd[pr.add] = true
				goneDel[pr.del] = true
				out = append(out, FileChange{Kind: Kind.Renamed, Path: pr.add, OldPath: pr.del, OldHash: fa[pr.del].hash, NewHash: fb[pr.add].hash, OldMode: fa[pr.del].mode, NewMode: fb[pr.add].mode, Similarity: pr.score})
			}
		}
	}
	for d in deleted {
		if !goneDel[d] {
			out = append(out, FileChange{Kind: Kind.Deleted, Path: d, OldPath: d, OldHash: fa[d].hash, NewHash: "", OldMode: fa[d].mode, NewMode: fa[d].mode, Similarity: 0})
		}
	}
	for p in added {
		if !goneAdd[p] {
			out = append(out, FileChange{Kind: Kind.Added, Path: p, OldPath: "", OldHash: "", NewHash: fb[p].hash, OldMode: fb[p].mode, NewMode: fb[p].mode, Similarity: 0})
		}
	}
	sift.SortStableFunc(mut out, fn(x FileChange, y FileChange) i64 {
		if x.Path < y.Path {
			return -1
		}
		if x.Path > y.Path {
			return 1
		}
		return 0
	})
	return out
}

type pairScore struct {
	add   str
	del   str
	score i64
}

// KindLetter is git's --name-status letter: A, D, M, R or T.
fn KindLetter(k Kind) str {
	return match k {
		Added => "A"
		Deleted => "D"
		Modified => "M"
		Renamed => "R"
		TypeChanged => "T"
	}
}
