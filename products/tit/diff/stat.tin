package diff

import "../store"

// --stat (#785): one line per file with its count of changed lines and a bar of + and -, then a summary, as
// `git diff --stat` writes them (80 columns; the bar shrinks when the largest change does not fit).

// FileStat is one file's line counts, or its sizes when it is binary.
type FileStat struct {
	Name    str
	Added   i64
	Deleted i64
	Binary  bool
	OldSize i64
	NewSize i64
}

fn isBinary(b str) bool {
	for i in 0..min(len(b), 8000) {
		if b[i] == 0 {
			return true
		}
	}
	return false
}

// statName is the path git shows for a change: a rename as old => new, the common leading directories and trailing
// part written once, as {old => new}.
fn statName(c FileChange) str {
	if c.Kind != Kind.Renamed {
		return c.Path
	}
	let a = c.OldPath
	let b = c.Path
	// the common prefix up to a slash, and the common suffix from a slash
	mut pre = 0
	for i in 0..min(len(a), len(b)) {
		if a[i] != b[i] {
			break
		}
		if a[i] == '/' {
			pre = i + 1
		}
	}
	mut suf = 0
	for i in 1..min(len(a) - pre, len(b) - pre) + 1 {
		if a[len(a) - i] != b[len(b) - i] {
			break
		}
		if a[len(a) - i] == '/' {
			suf = i
		}
	}
	if pre == 0 && suf == 0 {
		return a + " => " + b
	}
	return a[0:pre] + "{{" + a[pre:len(a) - suf] + " => " + b[pre:len(b) - suf] + "}}" + a[len(a) - suf:]
}

// Stats counts each change's added and deleted lines.
fn Stats[S store.ObjectStore](s mut S, changes []FileChange) ![]FileStat {
	mut out = []FileStat{}
	for c in changes {
		mut a = ""
		mut b = ""
		if len(c.OldHash) > 0 {
			a = try blob(mut s, c.OldHash)
		}
		if len(c.NewHash) > 0 {
			b = try blob(mut s, c.NewHash)
		}
		if isBinary(a) || isBinary(b) {
			out = append(out, FileStat{Name: statName(c), Added: 0, Deleted: 0, Binary: true, OldSize: len(a), NewSize: len(b)})
			continue
		}
		let la = Lines(a)
		let lb = Lines(b)
		let es = Diff(la, lb)
		mut ins = 0
		mut del = 0
		for e in es {
			match e {
				Keep(_) => {
				}
				Insert(n) => {
					ins += n
				}
				Delete(n) => {
					del += n
				}
			}
		}
		out = append(out, FileStat{Name: statName(c), Added: ins, Deleted: del, Binary: false, OldSize: len(a), NewSize: len(b)})
	}
	return out
}

fn digits(n i64) i64 {
	mut d = 1
	mut x = n
	for x >= 10 {
		x = x / 10
		d += 1
	}
	return d
}

fn repeat(c str, n i64) str {
	mut s = ""
	for i in 0..n {
		s = s + c
	}
	return s
}

fn pad(s str, n i64) str {
	mut out = s
	for len(out) < n {
		out = out + " "
	}
	return out
}

fn padLeft(s str, n i64) str {
	mut out = s
	for len(out) < n {
		out = " " + out
	}
	return out
}

// scaleLinear is git's: at least one mark for a nonzero count, the largest change filling width.
fn scaleLinear(it i64, width i64, most i64) i64 {
	if it == 0 {
		return 0
	}
	return 1 + it * (width - 1) / most
}

// FormatStat writes the stats as `git diff --stat=80` does, with git's widths and scaling (diff.c, show_stats).
fn FormatStat(stats []FileStat) str {
	if len(stats) == 0 {
		return ""
	}
	mut nameW = 0
	mut most = 0
	mut ins = 0
	mut del = 0
	mut hasBin = false
	for st in stats {
		nameW = max(nameW, len(st.Name))
		if st.Binary {
			hasBin = true
		} else {
			most = max(most, st.Added + st.Deleted)
		}
		ins += st.Added
		del += st.Deleted
	}
	mut numW = digits(most)
	if hasBin {
		numW = max(numW, 3)
	}
	let width = 80
	mut graphW = most
	if nameW + numW + 6 + graphW > width {
		if graphW > width * 3 / 8 - numW - 6 {
			graphW = width * 3 / 8 - numW - 6
			if graphW < 6 {
				graphW = 6
			}
		}
		if nameW > width - numW - 6 - graphW {
			nameW = width - numW - 6 - graphW
		} else {
			graphW = width - numW - 6 - nameW
		}
	}
	mut out = ""
	for st in stats {
		mut name = st.Name
		if len(name) > nameW {
			name = "..." + name[len(name) - nameW + 3:]
		}
		if st.Binary {
			out = out + " " + pad(name, nameW) + " | " + padLeft("Bin", numW) + " {st.OldSize} -> {st.NewSize} bytes\n"
			continue
		}
		mut plus = st.Added
		mut minus = st.Deleted
		if graphW <= most {
			mut total = scaleLinear(plus + minus, graphW, most)
			if total < 2 && plus > 0 && minus > 0 {
				total = 2
			}
			if plus < minus {
				plus = scaleLinear(plus, graphW, most)
				minus = total - plus
			} else {
				minus = scaleLinear(minus, graphW, most)
				plus = total - minus
			}
		}
		let total = st.Added + st.Deleted
		mut line = " " + pad(name, nameW) + " | " + padLeft("{total}", numW)
		if plus + minus > 0 {
			line = line + " " + repeat("+", plus) + repeat("-", minus)
		}
		out = out + line + "\n"
	}
	mut summary = " {len(stats)} file"
	if len(stats) != 1 {
		summary = summary + "s"
	}
	summary = summary + " changed"
	if ins > 0 || del == 0 {
		summary = summary + ", {ins} insertion"
		if ins != 1 {
			summary = summary + "s"
		}
		summary = summary + "(+)"
	}
	if del > 0 || ins == 0 {
		summary = summary + ", {del} deletion"
		if del != 1 {
			summary = summary + "s"
		}
		summary = summary + "(-)"
	}
	return out + summary + "\n"
}
