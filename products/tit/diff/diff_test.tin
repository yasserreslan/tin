package diff

import "crucible"
import "dice"

// Tests for the generic diff (#785): random sequences against a brute-force LCS, the cost bound, a large shuffled
// input that must fall back within its budget, and the line splitting. Unified output is compared with git by
// products/tit/tests/programs/diff_git.tin.

fn lcs(a []i64, b []i64) i64 {
	mut prev = make([]i64, len(b) + 1)
	mut cur = make([]i64, len(b) + 1)
	for i in 1..len(a) + 1 {
		for j in 1..len(b) + 1 {
			if a[i - 1] == b[j - 1] {
				cur[j] = prev[j - 1] + 1
			} else {
				cur[j] = max(prev[j], cur[j - 1])
			}
		}
		for j in 0..len(b) + 1 {
			prev[j] = cur[j]
			cur[j] = 0
		}
	}
	return prev[len(b)]
}

fn seq(r mut dice.Rand, n i64, alphabet i64) []i64 {
	mut out = make([]i64, n)
	for i in 0..n {
		out[i] = r.Intn(alphabet)
	}
	return out
}

fn sameSeq(a []i64, b []i64) bool {
	if len(a) != len(b) {
		return false
	}
	for i in 0..len(a) {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

fn TestShortest(t mut crucible.T) {
	mut r = dice.New(11)
	mut wrong = 0
	mut longer = 0
	for round in 0..2000 {
		let a = seq(mut r, r.Intn(40), 2 + r.Intn(5))
		let b = seq(mut r, r.Intn(40), 2 + r.Intn(5))
		let es = Diff(a, b)
		if !sameSeq(Apply(a, b, es), b) {
			wrong += 1
		}
		if Cost(es) != len(a) + len(b) - 2 * lcs(a, b) {
			longer += 1
		}
	}
	crucible.Equal(mut t, "scripts that do not rebuild b", wrong, 0)
	crucible.Equal(mut t, "scripts longer than the shortest", longer, 0)
}

fn TestEdges(t mut crucible.T) {
	let e = []i64{}
	let abc = []i64{1, 2, 3}
	crucible.Equal(mut t, "both empty", len(Diff(e, e)), 0)
	crucible.Equal(mut t, "insert all", Cost(Diff(e, abc)), 3)
	crucible.Equal(mut t, "delete all", Cost(Diff(abc, e)), 3)
	crucible.Equal(mut t, "equal", Cost(Diff(abc, abc)), 0)
	crucible.Equal(mut t, "one each", Cost(Diff([]i64{1}, []i64{2})), 2)
	let es = Diff([]i64{1, 2}, []i64{3, 4})
	crucible.Equal(mut t, "deletion before insertion", show(es), "[Delete(2) Insert(2)]")
}

fn show(es []Edit) str {
	mut s = "["
	for i in 0..len(es) {
		if i > 0 {
			s = s + " "
		}
		s = s + match es[i] {
			Keep(n) => "Keep({n})"
			Insert(n) => "Insert({n})"
			Delete(n) => "Delete({n})"
		}
	}
	return s + "]"
}

fn TestBudget(t mut crucible.T) {
	mut r = dice.New(5)
	let a = seq(mut r, 3000, 50)
	let b = seq(mut r, 3000, 50)
	let (es, ok) = DiffLimit(a, b, 1000)
	t.False("the bound runs out", ok)
	t.True("the script still rebuilds b", sameSeq(Apply(a, b, es), b))
	let (full, ok2) = DiffLimit(a, b, -1)
	t.True("no bound", ok2)
	t.True("the bounded script is no shorter", Cost(es) >= Cost(full))
}

// TestLargeShuffled diffs 200,000 lines against a shuffle of them: with a bound it ends quickly with a correct,
// unshortened script.
fn TestLargeShuffled(t mut crucible.T) {
	mut r = dice.New(9)
	let n = 200000
	mut a = make([]str, n)
	for i in 0..n {
		a[i] = "line {i} of a large file\n"
	}
	mut b = make([]str, n)
	copy(b, a)
	r.ShuffleStr(mut b)
	let (es, ok) = DiffLimit(a, b, 2000000)
	t.False("falls back", ok)
	mut rebuilt = 0
	mut i = 0
	mut j = 0
	for e in es {
		match e {
			Keep(k) => {
				i += k
				j += k
				rebuilt += k
			}
			Insert(k) => {
				j += k
				rebuilt += k
			}
			Delete(k) => {
				i += k
			}
		}
	}
	crucible.Equal(mut t, "covers a", i, n)
	crucible.Equal(mut t, "covers b", j, n)
	crucible.Equal(mut t, "rebuilds every line of b", rebuilt, n)
}

fn TestLines(t mut crucible.T) {
	crucible.Equal(mut t, "empty", len(Lines("")), 0)
	crucible.Equal(mut t, "no newline", len(Lines("a")), 1)
	let ls = Lines("a\n\nb")
	crucible.Equal(mut t, "count", len(ls), 3)
	crucible.Equal(mut t, "keeps newlines", ls[1], "\n")
	crucible.Equal(mut t, "last without newline", ls[2], "b")
	crucible.Equal(mut t, "span empty", span(4, 0), "4,0")
	crucible.Equal(mut t, "span one", span(4, 1), "5")
	crucible.Equal(mut t, "span many", span(4, 3), "5,3")
}
