package main

import "anvil"
import "argo"
import "mint"
import "mysql"
import "quarry"
import "redis"
import "say"
import "tide"

// The v0.4 benchmark service (bench/v04/go/main.go is the same in Go with chi):
//   GET /users/{id}   the user as JSON: from Redis, else MySQL (then cached for 60 s)
//   GET /db/users/{id} the user as JSON straight from MySQL
//   GET /slow         answers after 50 ms (a slow upstream), to mix with fast requests
type User struct {
	id      i64
	name    str
	email   str
	score   f64
	created str
}

let cache = redis.Open(redis.Options{Addr: quarry.Getenv("REDIS_ADDR")})

let db = mysql.Open(mysql.Options{
	Addr:     quarry.Getenv("MYSQL_ADDR"),
	User:     quarry.Getenv("MYSQL_USER"),
	Password: quarry.Getenv("MYSQL_PASSWORD"),
	Database: quarry.Getenv("MYSQL_DATABASE"),
	Pool:     16,
})

fn upstream(w mut anvil.Out, err fault) {
	w.Status(502)
	w.Text("{err}")
}

// from_db reads user id from MySQL and returns it as JSON ("" when there is none).
fn from_db(id i64) !str {
	let rows = try db.Query("SELECT id, name, email, score, created FROM users WHERE id = {id}")
	if len(rows.Rows) == 0 {
		return ""
	}
	let r = rows.Rows[0]
	let b = make([]u8, 0, 256)
	argo.Put(mut b, User{id: r[0].Int(), name: r[1].Text(), email: r[2].Text(), score: r[3].Float(), created: r[4].Text()})
	return str(b)
}

fn user(q anvil.Req, w mut anvil.Out, cached bool) {
	let id = mint.Atoi(q.PathParam("id")) catch _ {
		w.Status(404)
		w.Text("no such user")
		return
	}
	let key = "user:{id}"
	if cached {
		let (v, found) = cache.Get(key) catch err {
			upstream(mut w, err)
			return
		}
		if found {
			w.Json()
			w.Text(v)
			return
		}
	}
	let body = from_db(id) catch err {
		upstream(mut w, err)
		return
	}
	if body == "" {
		w.Status(404)
		w.Text("no such user")
		return
	}
	if cached {
		cache.SetEx(key, body, 60s) catch err {
			upstream(mut w, err)
			return
		}
	}
	w.Json()
	w.Text(body)
}

fn cached_user(q anvil.Req, w mut anvil.Out) {
	user(q, mut w, true)
}

fn db_user(q anvil.Req, w mut anvil.Out) {
	user(q, mut w, false)
}

fn slow(q anvil.Req, w mut anvil.Out) {
	tide.Wait(50ms) catch _ {}
	w.Text("slow")
}

fn main() {
	let r = anvil.NewRouter()
	r.Get(`/users/{id}`, cached_user)
	r.Get(`/db/users/{id}`, db_user)
	r.Get("/slow", slow)
	let err = r.Serve(":9190")
	say.Line("server:", err)
}
