package main

import "anvil"
import "say"
import "tide"
import "websocket"

// WebSocket endpoints:
//   /echo    sends each message back ("echo: " before text)
//   /ticks   sends "tick N" every 100 ms, ten times, then closes
//   /        a plain HTTP page
func echo_ws(q anvil.Req, w mut anvil.Out) {
	ws := websocket.Accept(q, mut w) catch _ { return }
	ws.Each(echo) catch _ {}
}

func ticks(q anvil.Req, w mut anvil.Out) {
	ws := websocket.Accept(q, mut w) catch _ { return }
	for i := 1; i <= 10; i++ {
		tide.Wait(100 * tide.Millisecond) catch _ { return }
		ws.WriteText("tick {i}") catch _ { return }
	}
	ws.Close()
}

func page(q anvil.Req, w mut anvil.Out) {
	w.Text("websocket demo: connect to /echo or /ticks")
}

// Each releases allocations from this callback after every message; the connection
// remains valid for the stream's whole life. keep(m.Data) retains data when needed.
func echo(ws websocket.Conn, m websocket.Message) ! {
	if m.Text {
		try ws.WriteText("echo: {m.Data}")
	} else {
		try ws.WriteBinary([]u8(m.Data))
	}
}

func main() {
	r := anvil.NewRouter()
	r.Get("/echo", echo_ws)
	r.Get("/ticks", ticks)
	r.Get("/", page)
	err := r.Serve(":9186")
	say.Line("server:", err)
}
