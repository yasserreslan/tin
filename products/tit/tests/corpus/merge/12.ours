package main

import "say"
import "argo"
import "anvil"

type Message struct {
	message str
}

type Echo struct {
	path   str
	query  str
	name   str
	agent  str
	length i64
}

mut hits i64

// count is middleware: it counts every request this core serves, 404s included.
fn count(q anvil.Req, w mut anvil.Out, next fn(anvil.Req, mut anvil.Out)) {
	hits += 1
	next(q, mut w)
}

fn json(q anvil.Req, w mut anvil.Out) {
	w.Json()
	argo.Put(mut w.Body, Message{message: "Hello, World!"})
}

fn plaintext(q anvil.Req, w mut anvil.Out) {
	w.Text("Hello, World!")
}

fn echo(q anvil.Req, w mut anvil.Out) {
	w.Json()
	let b = q.Body()
	argo.Put(mut w.Body, Echo{path: q.Path, query: q.Query, name: q.Param("name"), agent: q.Header("user-agent"), length: len(b)})
}

fn show_hits(q anvil.Req, w mut anvil.Out) {
	w.Text(say.Fmt("%d", hits))
}

fn healthz(q anvil.Req, w mut anvil.Out) {
	w.Text("ok")
}

fn not_found(q anvil.Req, w mut anvil.Out) {
	w.Text("not found")
}

fn main() {
	let r = anvil.NewRouter()
	r.Use(count)
	r.Get("/json", json)
	// Every method: the conformance suite checks that an unknown one is not taken for HEAD.
	r.Any("/plaintext", plaintext)
	r.Get("/echo", echo)
	r.Post("/echo", echo)
	r.Get("/hits", show_hits)
	r.Get("/healthz", healthz)
	r.NotFound(not_found)
	let err = r.Serve(":9180")
	if err != nil {
		say.Line("server:", err)
	}
}
