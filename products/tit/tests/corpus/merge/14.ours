package main

import "anvil"
import "argo"
import "mint"
import "mysql"
import "quarry"
import "say"
import "tls"

// A users service over MySQL (MYSQL_ADDR, MYSQL_USER, MYSQL_PASSWORD, MYSQL_DATABASE):
//   GET /setup             creates the users table
//   GET /add?name=N        adds a user, answers its id
//   GET /user?id=N         the user as JSON, or 404
//   GET /count             how many users there are
//   GET /sleep?ms=N        a statement that takes N ms (SELECT SLEEP)
type User struct {
	id   i64
	name str
}

// Pool is the connections per core (0: max(2, 64/cores), so about 64 for the process whatever the core
// count); MaxTotal caps all cores together (0: no cap). A pod that shares a server with others sets
// MaxTotal so that pods x MaxTotal stays under the server's max_connections.
let db = mysql.Open(mysql.Options{
	Addr:     quarry.Getenv("MYSQL_ADDR"),
	User:     quarry.Getenv("MYSQL_USER"),
	Password: quarry.Getenv("MYSQL_PASSWORD"),
	Database: quarry.Getenv("MYSQL_DATABASE"),
	Pool:     env_int("MYSQL_POOL"),
	MaxTotal: env_int("MYSQL_MAX_TOTAL"),
	TLS:      tls_config(),
})

// tls_config is MYSQL_TLS: "verify" (TLS, checking the certificate), "insecure" (TLS without the
// check: tests against a self-signed server only), or empty for plain TCP.
fn tls_config() ?tls.Config {
	let mode = quarry.Getenv("MYSQL_TLS")
	if mode == "verify" {
		return tls.Config{ServerName: "", RootCAs: "", ALPN: []str{}, Timeout: 0, InsecureSkipVerify: false}
	}
	if mode == "insecure" {
		return tls.Config{ServerName: "", RootCAs: "", ALPN: []str{}, Timeout: 0, InsecureSkipVerify: true}
	}
	return nil
}

fn env_int(name str) i64 {
	let n = mint.Atoi(quarry.Getenv(name)) catch _ { 0 }
	return n
}

fn fail_with(w mut anvil.Out, err fault) {
	w.Status(502)
	w.Text("{err}")
}

fn user(q anvil.Req, w mut anvil.Out) {
	let id = mint.Atoi(q.Param("id")) catch _ { -1 }
	let rows = db.Query("SELECT id, name FROM users WHERE id = {id}") catch err {
		fail_with(mut w, err)
		return
	}
	if len(rows.Rows) == 0 {
		w.Status(404)
		w.Text("no user {id}")
		return
	}
	let r = rows.Rows[0]
	w.Json()
	argo.Put(mut w.Body, User{id: r[0].Int(), name: r[1].Text()})
}

fn add(q anvil.Req, w mut anvil.Out) {
	let name = q.Param("name")
	let res = db.Exec("INSERT INTO users (name) VALUES ({name})") catch err {
		fail_with(mut w, err)
		return
	}
	w.Text("{res.LastID}")
}

fn count(q anvil.Req, w mut anvil.Out) {
	let rows = db.Query("SELECT COUNT(*) FROM users") catch err {
		fail_with(mut w, err)
		return
	}
	w.Text(rows.Rows[0][0].Text())
}

fn sleep(q anvil.Req, w mut anvil.Out) {
	let ms = mint.Atoi(q.Param("ms")) catch _ { 100 }
	let secs = f64(ms) / 1000.0
	_ = db.Query("SELECT SLEEP({secs})") catch err {
		fail_with(mut w, err)
		return
	}
	w.Text("slept")
}

fn setup(q anvil.Req, w mut anvil.Out) {
	_ = db.Exec("CREATE TABLE IF NOT EXISTS users (id BIGINT PRIMARY KEY AUTO_INCREMENT, name VARCHAR(255) NOT NULL)") catch err {
		fail_with(mut w, err)
		return
	}
	w.Text("ok")
}

fn no_route(q anvil.Req, w mut anvil.Out) {
	w.Text("no route {q.Path}")
}

fn main() {
	let r = anvil.NewRouter()
	r.Get("/user", user)
	r.Get("/add", add)
	r.Get("/count", count)
	r.Get("/sleep", sleep)
	r.Get("/setup", setup)
	r.NotFound(no_route)
	let err = r.Serve(":9185")
	say.Line("server:", err)
}
