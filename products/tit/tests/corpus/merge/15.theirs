package main

import "anvil"
import "mint"
import "quarry"
import "redis"
import "say"

// A counter and key/value service over Redis (REDIS_ADDR, default 127.0.0.1:6379):
//   GET /incr?key=K          adds one to K, answers the new value
//   GET /get?key=K           the value at K, or 404
//   GET /set?key=K&value=V   stores V at K
//   GET /twice?key=K         adds two to K in one MULTI/EXEC
//   GET /sleep?ms=N          makes the server pause (DEBUG SLEEP)
var c = redis.Open(redis.Options{Addr: quarry.Getenv("REDIS_ADDR"), Password: quarry.Getenv("REDIS_PASSWORD")})

func upstream(w mut anvil.Out, err fault) {
	w.Status(502)
	w.Text("{err}")
}

func incr(q anvil.Req, w mut anvil.Out) {
	n := c.Incr(q.Param("key")) catch err {
		upstream(mut w, err)
		return
	}
	w.Text("{n}")
}

func get(q anvil.Req, w mut anvil.Out) {
	key := q.Param("key")
	v, found := c.Get(key) catch err {
		upstream(mut w, err)
		return
	}
	if !found {
		w.Status(404)
		w.Text("no {key}")
		return
	}
	w.Text(v)
}

func set(q anvil.Req, w mut anvil.Out) {
	c.Set(q.Param("key"), q.Param("value")) catch err {
		upstream(mut w, err)
		return
	}
	w.Text("ok")
}

func twice(q anvil.Req, w mut anvil.Out) {
	key := q.Param("key")
	// MULTI ... EXEC in one Pipe: both increments happen together.
	rs := c.Pipe([]query{"MULTI", "INCR {key}", "INCR {key}", "EXEC"}) catch err {
		upstream(mut w, err)
		return
	}
	w.Text("{rs[3]}")
}

func sleep(q anvil.Req, w mut anvil.Out) {
	// The server pauses (it needs enable-debug-command): commands queued behind wait too.
	ms := mint.Atoi(q.Param("ms")) catch _ { 100 }
	secs := f64(ms) / 1000.0
	_ = c.Do("DEBUG SLEEP {secs}") catch err {
		upstream(mut w, err)
		return
	}
	w.Text("slept")
}

func no_route(q anvil.Req, w mut anvil.Out) {
	w.Text("no route {q.Path}")
}

func main() {
	r := anvil.NewRouter()
	r.Get("/incr", incr)
	r.Get("/get", get)
	r.Get("/set", set)
	r.Get("/twice", twice)
	r.Get("/sleep", sleep)
	r.NotFound(no_route)
	err := r.Serve(":9184")
	say.Line("server:", err)
}
