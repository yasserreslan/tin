package main

// Shape dispatch vs a hand-written call (roadmap #141, "static dispatch by
// monomorphization"): a call through a shape-constrained type parameter is a direct call
// on the concrete method, so it must cost what the hand-written call costs.
//
// Run it and record the numbers in docs/PERFORMANCE.md:
//
//	bin/tinc -o /tmp/dispatch bench/dispatch/dispatch.tin && /tmp/dispatch
//
// Both loops do the same work: build an 8-byte buffer and copy three bytes into it.
// The best round of each is reported, which is stable enough on a quiet machine.

import "say"
import "tide"

shape Reader { Read(buf mut []u8) !i64 }

type Buf struct { data []u8 }

fn (b Buf) Read(buf mut []u8) !i64 {
	let n = len(b.data)
	let i = 0
	for i < n && i < len(buf) {
		buf[i] = b.data[i]
		i = i + 1
	}
	return i
}

// Through a shape-constrained type parameter: monomorphized, so this is a direct call.
// The body is written out in full (not a single return) so the inliner leaves both
// functions out of line and the two loops measure the same call layers.
fn Drain[R Reader](r R) !i64 {
	let buf = make([]u8, 8)
	let i = 0
	for i < len(buf) {
		buf[i] = 0
		i = i + 1
	}
	return try r.Read(mut buf)
}

// The hand-written call the shape form must match.
fn drainBuf(b Buf) !i64 {
	let buf = make([]u8, 8)
	let i = 0
	for i < len(buf) {
		buf[i] = 0
		i = i + 1
	}
	return try b.Read(mut buf)
}

const Iters = 2000000

const Rounds = 5

fn main() {
	let b = Buf{data: []u8{1, 2, 3}}
	mut checksum i64 = 0
	mut bestShape i64 = 0
	mut bestHand i64 = 0
	let r = 0
	for r < Rounds {
		mut t0 i64 = tide.Now()
		let i = 0
		for i < Iters {
			let n = Drain(b) catch _ { -1 }
			checksum = checksum + n
			i = i + 1
		}
		let dt = tide.Since(t0)
		if bestShape == 0 || dt < bestShape {
			bestShape = dt
		}
		t0 = tide.Now()
		let j = 0
		for j < Iters {
			let m = drainBuf(b) catch _ { -1 }
			checksum = checksum + m
			j = j + 1
		}
		let dt2 = tide.Since(t0)
		if bestHand == 0 || dt2 < bestHand {
			bestHand = dt2
		}
		r = r + 1
	}
	let shapeNs = f64(bestShape) / f64(Iters)
	let handNs = f64(bestHand) / f64(Iters)
	let ratio = f64(bestShape) / f64(bestHand)
	say.Line("shape: {shapeNs:.2} ns/op")
	say.Line("hand:  {handNs:.2} ns/op")
	say.Line("ratio: {ratio:.3} (1.0 means identical)")
	say.Line("checksum: {checksum}")
}
