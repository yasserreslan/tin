package main

import "say"
import "sift"

// checksum folds xs into one wrapping i64.
func checksum(xs []i64) i64 {
	h := i64(0)
	for _, v := range xs {
		h = h*1000003 + v
	}
	return h
}

func main() {
	n := i64(10000000)
	xs := make([]i64, n)
	k := i64(12345)
	for i := i64(0); i < n; i++ {
		k = k*6364136223846793005 + 1442695040888963407
		xs[i] = k
	}
	ys := make([]i64, n)
	copy(ys, xs)
	fs := make([]f64, n)
	for i := i64(0); i < n; i++ {
		fs[i] = f64(xs[i]>>20) / 1024.0
	}

	sift.Ints(mut xs)

	say.Line("ints", sift.IsSortedInts(xs), checksum(xs), xs[0], xs[n-1])

	sift.StableInts(mut ys)

	say.Line("stable", sift.IsSortedInts(ys), checksum(ys))

	sift.F64s(mut fs)

	say.Out("f64s %.3f %.3f\n", fs[0], fs[n-1])

	sift.Ints(mut xs)

	say.Line("presorted", sift.IsSortedInts(xs))

}
