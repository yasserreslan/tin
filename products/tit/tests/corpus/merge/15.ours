package main

import "anvil"
import "mint"
import "quarry"
import "redis"
import "say"

// A counter and key/value service over Redis (REDIS_URL such as rediss://:pw@host:6380/0 for
// TLS, or REDIS_ADDR, default 127.0.0.1:6379):
//   GET /incr?key=K          adds one to K, answers the new value
//   GET /get?key=K           the value at K, or 404
//   GET /set?key=K&value=V   stores V at K
//   GET /twice?key=K         adds two to K in one MULTI/EXEC
//   GET /sleep?ms=N          makes the server pause (DEBUG SLEEP)
let c = redis.Open(options())

// options reads REDIS_URL, or REDIS_ADDR and REDIS_PASSWORD. REDIS_TLS_INSECURE=1 skips the
// certificate check (tests against a self-signed server only).
fn options() redis.Options {
	let url = quarry.Getenv("REDIS_URL")
	if url == "" {
		return redis.Options{Addr: quarry.Getenv("REDIS_ADDR"), Password: quarry.Getenv("REDIS_PASSWORD")}
	}
	let o = redis.ParseURL(url) catch err {
		say.Line("REDIS_URL:", err)
		return redis.Options{Addr: "", Password: ""}
	}
	let t = o.TLS
	if t != nil && quarry.Getenv("REDIS_TLS_INSECURE") == "1" {
		t.InsecureSkipVerify = true
	}
	return o
}

fn upstream(w mut anvil.Out, err fault) {
	w.Status(502)
	w.Text("{err}")
}

fn incr(q anvil.Req, w mut anvil.Out) {
	let n = c.Incr(q.Param("key")) catch err {
		upstream(mut w, err)
		return
	}
	w.Text("{n}")
}

fn get(q anvil.Req, w mut anvil.Out) {
	let key = q.Param("key")
	let (v, found) = c.Get(key) catch err {
		upstream(mut w, err)
		return
	}
	if !found {
		w.Status(404)
		w.Text("no {key}")
		return
	}
	w.Text(v)
}

fn set(q anvil.Req, w mut anvil.Out) {
	c.Set(q.Param("key"), q.Param("value")) catch err {
		upstream(mut w, err)
		return
	}
	w.Text("ok")
}

fn twice(q anvil.Req, w mut anvil.Out) {
	let key = q.Param("key")
	// MULTI ... EXEC in one Pipe: both increments happen together.
	let rs = c.Pipe([]query{"MULTI", "INCR {key}", "INCR {key}", "EXEC"}) catch err {
		upstream(mut w, err)
		return
	}
	w.Text("{rs[3]}")
}

fn sleep(q anvil.Req, w mut anvil.Out) {
	// The server pauses (it needs enable-debug-command): commands queued behind wait too.
	let ms = mint.Atoi(q.Param("ms")) catch _ { 100 }
	let secs = f64(ms) / 1000.0
	_ = c.Do("DEBUG SLEEP {secs}") catch err {
		upstream(mut w, err)
		return
	}
	w.Text("slept")
}

fn no_route(q anvil.Req, w mut anvil.Out) {
	w.Text("no route {q.Path}")
}

fn main() {
	let r = anvil.NewRouter()
	r.Get("/incr", incr)
	r.Get("/get", get)
	r.Get("/set", set)
	r.Get("/twice", twice)
	r.Get("/sleep", sleep)
	r.NotFound(no_route)
	let err = r.Serve(":9184")
	say.Line("server:", err)
}
