package main

import "../../git"
import "../../object"
import "../../packfile"
import "../../revwalk"
import "../../store"
import "fault"
import "quarry"
import "say"
import "seal"
import "spawn"
import "twine"

// Converting git histories that git itself makes (#789): every object, the git-ids table, HEAD's files read back
// through tit, extra commit headers, and a second run that converts only what is new. Needs git. A test program
// rather than crucible tests: called from a crucible test, git.Convert made the region checker take the test's T
// for long-lived memory.

fn fresh(name str) str {
	let d = "/tmp/tin-test-tit-git-" + name + "-" + seal.Hex(seal.RandomBytes(4))
	quarry.RemoveAll(d) catch _ {
	}
	quarry.MkdirAll(d) catch _ {
	}
	return d
}

fn ok(label str, cond bool) {
	if cond {
		say.Line("ok", label)
	} else {
		say.Line("FAIL", label)
	}
}

fn sameS(label str, got str, want str) {
	if got == want {
		say.Line("ok", label)
	} else {
		say.Line("FAIL", label + ": got", got, "want", want)
	}
}

fn sameI(label str, got i64, want i64) {
	if got == want {
		say.Line("ok", label)
	} else {
		say.Line("FAIL", label + ": got", got, "want", want)
	}
}

fn convert(r git.Repo, tit str, ids git.Ids, tips []str, budget i64) !git.Ids {
	_ = try git.Convert(r, tit + "/packs", tit + "/git-ids", ids, tips, budget)
	return try git.ReadIds(tit + "/git-ids")
}

fn run(dir str, args []str) str {
	mut argv = []str{"git"}
	for a in args {
		argv = append(argv, a)
	}
	let env = []str{"PATH=" + quarry.Getenv("PATH"), "HOME=" + dir, "GIT_CONFIG_NOSYSTEM=1", "GIT_AUTHOR_NAME=Ada Lovelace", "GIT_AUTHOR_EMAIL=ada@example.com", "GIT_COMMITTER_NAME=Grace Hopper", "GIT_COMMITTER_EMAIL=grace@example.com", "GIT_AUTHOR_DATE=1700000000 +0530", "GIT_COMMITTER_DATE=1700000100 -0700"}
	let res = spawn.Run(spawn.Cmd{Argv: argv, Env: spawn.Env.Set(env), Dir: dir, Stdin: spawn.Stdio.Null, Stdout: spawn.Stdio.Pipe, Stderr: spawn.Stdio.Pipe, MaxOutput: 0, Input: ""}) catch e {
		say.Line("FAIL", "git {args[0]}: {e}")
		return ""
	}
	if res.Code != 0 {
		let line = twine.Join(args, " ")
		say.Line("FAIL", "git {line}: {res.Stderr}")
	}
	return res.Stdout
}

fn write(path str, text str) {
	let slash = twine.LastIndex(path, "/")
	quarry.MkdirAll(path[0:slash]) catch _ {
	}
	quarry.WriteFile(path, text) catch _ {
	}
}

// history makes a repository with a few commits (some packed with deltas, some loose), a merge, a tag, a symlink,
// an executable, a binary file and a commit with extra headers; it gives the directory.

fn history(name str) str {
	let d = fresh(name)
	_ = run(d, []str{"init", "-q", "-b", "main"})
	mut big = ""
	for i in 0..3000 {
		big = big + "line {i} of a file that changes a little each time\n"
	}
	write(d + "/big.txt", big)
	write(d + "/src/main.tin", "package main\n")
	write(d + "/run.sh", "#!/bin/sh\necho hi\n")
	quarry.Chmod(d + "/run.sh", 493) catch _ {
	}
	quarry.Symlink("big.txt", d + "/link") catch _ {
	}
	write(d + "/bin.dat", "a\x00b\x00c")
	_ = run(d, []str{"add", "-A"})
	_ = run(d, []str{"commit", "-q", "-m", "first\n\nwith a body"})
	for k in 0..4 {
		big = big[0:100 * k] + "edit {k}\n" + big[100 * k:]
		write(d + "/big.txt", big)
		_ = run(d, []str{"commit", "-q", "-am", "edit {k}"})
	}
	_ = run(d, []str{"checkout", "-q", "-b", "side", "HEAD~2"})
	write(d + "/side.txt", "on the side\n")
	_ = run(d, []str{"add", "side.txt"})
	_ = run(d, []str{"commit", "-q", "-m", "side"})
	_ = run(d, []str{"checkout", "-q", "main"})
	_ = run(d, []str{"merge", "-q", "--no-edit", "side"})
	_ = run(d, []str{"tag", "-a", "v1", "-m", "version one"})
	_ = run(d, []str{"gc", "-q", "--aggressive"})
	// after the pack: a loose commit with headers git keeps (encoding, and a multi-line one like gpgsig)
	let tree = twine.TrimSpace(run(d, []str{"rev-parse", "HEAD^{{tree}}"}))
	let head = twine.TrimSpace(run(d, []str{"rev-parse", "HEAD"}))
	let body = "tree {tree}\nparent {head}\nauthor Ada Lovelace <ada@example.com> 1700000200 +0000\ncommitter Grace Hopper <grace@example.com> 1700000300 +0100\nencoding ISO-8859-1\ngpgsig -----BEGIN PGP SIGNATURE-----\n \n abcdef\n -----END PGP SIGNATURE-----\n\nwith headers\n"
	write(d + "/commit.txt", body)
	let id = twine.TrimSpace(run(d, []str{"hash-object", "-t", "commit", "-w", "commit.txt"}))
	quarry.Remove(d + "/commit.txt") catch _ {
	}
	_ = run(d, []str{"update-ref", "refs/heads/main", id})
	return d
}

fn tipsOf(r git.Repo) []str {
	let refs = r.Refs() catch _ {
		[]git.Ref{}
	}
	mut out = []str{}
	for ref in refs {
		out = append(out, ref.Id)
	}
	return out
}

// text is a fault's message in fresh memory. Convert's faults reach the region checker as of unknown origin (they
// come out of arenas), and a test's checker given one would be taken for long-lived memory from then on.

fn layered(dir str) store.Layered {
	mut layers = []dyn store.ObjectStore{}
	let names = quarry.ReadDir(dir) catch _ {
		[]str{}
	}
	for n in names {
		if twine.HasSuffix(n, ".pack") {
			let p = packfile.Open(dir + "/" + n) catch _ {
				continue
			}
			layers = append(layers, p)
		}
	}
	return store.NewLayered(layers)
}

fn modeName(m object.Mode) str {
	return match m {
		File => "File"
		Exec => "Exec"
		Link => "Link"
		Dir => "Dir"
	}
}

fn flat(s mut store.Layered, tree object.Id, prefix str) []str {
	mut out = []str{}
	let o = s.Get(tree) catch _ {
		return out
	}
	match o {
		Tree(es) => {
			for e in es {
				if e.Mode == object.Mode.Dir {
					for f in flat(mut s, e.Id, prefix + e.Name + "/") {
						out = append(out, f)
					}
				} else {
					out = append(out, prefix + e.Name + ":" + modeName(e.Mode))
				}
			}
		}
		Commit(_) => {
		}
		Tag(_) => {
		}
		Blob(_) => {
		}
	}
	return out
}

fn content(s mut store.Layered, tree object.Id, name str) str {
	let o = s.Get(tree) catch _ {
		return ""
	}
	match o {
		Tree(es) => {
			for e in es {
				if e.Name == name {
					let (_, body, err) = s.GetRaw(e.Id)
					if err != nil {
						return ""
					}
					return body
				}
			}
		}
		Commit(_) => {
		}
		Tag(_) => {
		}
		Blob(_) => {
		}
	}
	return ""
}

fn checkConvertHistory() {
	let d = history("history")
	let r = git.Open(d) catch e {
		say.Line("FAIL", "open: {e}")
		return
	}
	ok("the git directory found", len(r.CommonDir) > 0)
	let refs = r.Refs() catch e {
		say.Line("FAIL", "refs: {e}")
		return
	}
	mut names = []str{}
	for ref in refs {
		names = append(names, ref.Name)
	}
	sameS("refs", twine.Join(names, " "), "refs/heads/main refs/heads/side refs/tags/v1")
	let (head, hid, herr) = r.Head()
	ok("head", herr == nil)
	sameS("HEAD", head, "refs/heads/main")
	sameS("HEAD id", git.Hex(hid), twine.TrimSpace(run(d, []str{"rev-parse", "HEAD"})))
	let tit = d + "/.tit"
	let ids = convert(r, tit, git.NewIds(), tipsOf(r), 8 * 1024 * 1024) catch e {
		say.Line("FAIL", "convert: " + fault.Message(e))
		return
	}
	let all = twine.Split(twine.TrimSpace(run(d, []str{"rev-list", "--objects", "--all"})), "\n")
	sameI("every object", ids.Len(), len(all))
	// the table on disk has them all, and revwalk finds a commit in it by its git id
	let back = git.ReadIds(tit + "/git-ids") catch e {
		say.Line("FAIL", "read ids: {e}")
		return
	}
	sameI("table", back.Len(), ids.Len())
	let found = revwalk.GitIds(tit, git.Hex(hid)[0:10]) catch _ {
		[]object.Id{}
	}
	sameI("revwalk finds it", len(found), 1)
	// the files of HEAD read back through tit equal the files git checked out
	mut s = layered(tit + "/packs")
	let headTit = object.IdOf(ids.Tit(hid)) catch _ {
		object.NoId
	}
	let c = s.Get(headTit) catch e {
		say.Line("FAIL", "get head: {e}")
		return
	}
	match c {
		Commit(cd) => {
			sameS("message", cd.Message, "with headers\n")
			sameS("headers kept", twine.Join(cd.GitHeaders, "|"), "encoding ISO-8859-1|gpgsig -----BEGIN PGP SIGNATURE-----\n\nabcdef\n-----END PGP SIGNATURE-----")
			sameS("change from the git id", cd.Change.Letters(), object.AdoptedChangeId(git.Hex(hid)).Letters())
			sameI("zone", cd.Committer.Zone, 60)
			let files = flat(mut s, cd.Tree, "")
			sameS("files", twine.Join(files, " "), "big.txt:File bin.dat:File link:Link run.sh:Exec side.txt:File src/main.tin:File")
			let big = quarry.ReadFile(d + "/big.txt") catch _ {
				""
			}
			sameS("big.txt", content(mut s, cd.Tree, "big.txt"), big)
			sameS("bin.dat", content(mut s, cd.Tree, "bin.dat"), "a\x00b\x00c")
			sameS("link", content(mut s, cd.Tree, "link"), "big.txt")
		}
		Tree(_) => {
			say.Line("FAIL", "HEAD is not a commit")
		}
		Tag(_) => {
			say.Line("FAIL", "HEAD is not a commit")
		}
		Blob(_) => {
			say.Line("FAIL", "HEAD is not a commit")
		}
	}
	quarry.RemoveAll(d) catch _ {
	}
}

fn checkIncremental() {
	let d = history("incremental")
	let tit = d + "/.tit"
	let r = git.Open(d) catch e {
		say.Line("FAIL", "open: {e}")
		return
	}
	let first = convert(r, tit, git.NewIds(), tipsOf(r), 8 * 1024 * 1024) catch e {
		say.Line("FAIL", "convert: " + fault.Message(e))
		return
	}
	write(d + "/new.txt", "new\n")
	_ = run(d, []str{"add", "new.txt"})
	_ = run(d, []str{"commit", "-q", "-m", "new"})
	let r2 = git.Open(d) catch e {
		say.Line("FAIL", "open again: {e}")
		return
	}
	let known = git.ReadIds(tit + "/git-ids") catch e {
		say.Line("FAIL", "read ids: {e}")
		return
	}
	let order = git.Plan(r2, known, tipsOf(r2)) catch e {
		say.Line("FAIL", "plan: {e}")
		return
	}
	sameI("only the new commit is planned", len(order), 1)
	let second = convert(r2, tit, known, tipsOf(r2), 8 * 1024 * 1024) catch e {
		say.Line("FAIL", "convert again: " + fault.Message(e))
		return
	}
	// a commit, its tree and the new blob
	sameI("three new objects", second.Len() - first.Len(), 3)
	// the same history gives the same ids
	let again = convert(r2, d + "/.tit2", git.NewIds(), tipsOf(r2), 1024) catch e {
		say.Line("FAIL", "convert from scratch: " + fault.Message(e))
		return
	}
	let (gs, ts) = second.Pairs()
	mut same = true
	for i in 0..len(gs) {
		if again.Tit(gs[i]) != ts[i] {
			same = false
		}
	}
	ok("deterministic, whatever the batches", same && again.Len() == second.Len())
	quarry.RemoveAll(d) catch _ {
	}
}

fn main() {
	say.Line("== a history")
	checkConvertHistory()
	say.Line("== again, after a new commit")
	checkIncremental()
}
