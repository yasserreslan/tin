package main

import "../../object"
import "../../store"
import "quarry"
import "say"
import "spawn"

// Two processes write the same objects into one loose store at the same time (#777): every object ends up whole
// and readable, and no temporary file is left. The program runs itself twice as the writers.

// dir is this run's own scratch directory (#1065), which the writers it starts are given as their second argument.
let dir = scratchDir("tin-test-tit-store-race")

fn scratchDir(name str) str {
	let args = quarry.Args()
	if len(args) > 2 && args[1] == "writer" {
		return args[2]
	}
	return "/tmp/{name}-{quarry.Pid()}"
}

const count = 300

fn body(i i64) str {
	return "object {i} written by two processes at once\n"
}

fn writer() {
	mut l = store.NewLoose(dir)
	for i in 0..count {
		_ = l.PutRaw(object.Kind.Blob, body(i)) catch err {
			say.Line("write failed:", err)
			quarry.Exit(1)
			object.NoId
		}
	}
}

fn main() {
	let args = quarry.Args()
	if len(args) > 1 && args[1] == "writer" {
		writer()
		return
	}
	quarry.RemoveAll(dir) catch _ {
	}
	mut a = spawn.Start(spawn.Cmd{Argv: []str{args[0], "writer", dir}, Env: spawn.Env.Inherit, Dir: "", Stdin: spawn.Stdio.Null, Stdout: spawn.Stdio.Inherit, Stderr: spawn.Stdio.Inherit, MaxOutput: 0}) catch err {
		say.Line(err)
		return
	}
	mut b = spawn.Start(spawn.Cmd{Argv: []str{args[0], "writer", dir}, Env: spawn.Env.Inherit, Dir: "", Stdin: spawn.Stdio.Null, Stdout: spawn.Stdio.Inherit, Stderr: spawn.Stdio.Inherit, MaxOutput: 0}) catch err {
		say.Line(err)
		return
	}
	let ca = a.Wait() catch _ {
		-1
	}
	let cb = b.Wait() catch _ {
		-1
	}
	say.Line("writers exited:", ca, cb)
	mut l = store.NewLoose(dir)
	mut good = 0
	for i in 0..count {
		let id = object.Hash(object.Kind.Blob, body(i))
		let (kind, got, err) = l.GetRaw(id)
		if err == nil && kind == object.Kind.Blob && got == body(i) {
			good += 1
		}
	}
	say.Line("objects whole and readable:", good, "of", count)
	mut temps = 0
	let names = quarry.ReadDir(dir) catch _ {
		[]str{}
	}
	for n in names {
		if len(n) > 4 && n[0:4] == "tmp-" {
			temps += 1
		}
	}
	say.Line("temporary files left:", temps)
	quarry.RemoveAll(dir) catch _ {
	}
}
