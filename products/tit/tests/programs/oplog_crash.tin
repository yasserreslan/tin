package main

import "../../change"
import "../../object"
import "../../oplog"
import "quarry"
import "say"
import "spawn"
import "tide"

// A writer killed with SIGKILL in the middle of an operation (#780): it has written the pending record and moved its
// refs but not reached the commit point. Recovery puts every ref back, and the oplog holds only the operations
// before it. The program runs itself as the writer.

// dir is this run's own scratch directory (#1065), which the writers it starts are given as their second argument.
let dir = scratchDir("tin-test-tit-oplog-crash")

fn scratchDir(name str) str {
	let args = quarry.Args()
	if len(args) > 2 && args[1] == "writer" {
		return args[2]
	}
	return "/tmp/{name}-{quarry.Pid()}"
}

fn c(s str) str {
	return object.Hash(object.Kind.Blob, s).Hex()
}

fn refText(name str) str {
	let refs = change.NewRefs(dir)
	let r = refs.Get(name) catch _ {
		nil
	}
	if r == nil {
		return "(none)"
	}
	return change.TargetText(r.Target)[0:8]
}

fn writer() {
	let tx = oplog.Begin(dir, "default", "commit", oplog.Op.Commit("kz"), []oplog.RefChange{oplog.RefChange{Name: "refs/heads/main", Before: c("1"), After: c("2")}, oplog.RefChange{Name: "refs/heads/side", Before: "", After: c("s")}}) catch err {
		say.Line(err)
		return
	}
	tx.Apply() catch err {
		say.Line(err)
		return
	}
	quarry.WriteFile(dir + "/applied", "yes") catch _ {
	}
	tide.Sleep(30000000000)
}

fn main() {
	let args = quarry.Args()
	if len(args) > 1 && args[1] == "writer" {
		writer()
		return
	}
	quarry.RemoveAll(dir) catch _ {
	}
	quarry.MkdirAll(dir) catch _ {
	}
	_ = oplog.Run(dir, "default", "init", oplog.Op.Init, []oplog.RefChange{oplog.RefChange{Name: "refs/heads/main", Before: "", After: c("1")}}) catch err {
		say.Line(err)
		0
	}
	mut p = spawn.Start(spawn.Cmd{Argv: []str{args[0], "writer", dir}, Env: spawn.Env.Inherit, Dir: "", Stdin: spawn.Stdio.Null, Stdout: spawn.Stdio.Inherit, Stderr: spawn.Stdio.Inherit, MaxOutput: 0}) catch err {
		say.Line(err)
		return
	}
	for !quarry.Exists(dir + "/applied") {
		tide.Sleep(5000000)
	}
	say.Line("killed mid-operation, main is", refText("refs/heads/main") == c("2")[0:8], "side is", refText("refs/heads/side") == c("s")[0:8])
	p.Kill() catch err {
		say.Line(err)
	}
	_ = p.Wait() catch _ {
		0
	}
	let (was, err) = oplog.Recover(dir)
	say.Line("recovered:", was, err == nil)
	say.Line("main back to the first commit:", refText("refs/heads/main") == c("1")[0:8])
	say.Line("side:", refText("refs/heads/side"))
	let rs = oplog.List(dir) catch _ {
		[]oplog.Record{}
	}
	say.Line("operations:", len(rs))
	quarry.RemoveAll(dir) catch _ {
	}
}
