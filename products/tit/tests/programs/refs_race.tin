package main

import "../../change"
import "../../object"
import "fault"
import "quarry"
import "say"
import "spawn"
import "tide"

// Eight processes increment one ref by compare-and-swap at the same time (#779): each reads the ref, which names
// the commit for a count, and moves it to the commit for the next count, trying again on a conflict. No update may
// be lost: the ref ends at the commit for processes × steps. The program runs itself as the writers.

// dir is this run's own scratch directory (#1065), which the writers it starts are given as their second argument.
let dir = scratchDir("tin-test-tit-refs-race")

fn scratchDir(name str) str {
	let args = quarry.Args()
	if len(args) > 2 && args[1] == "writer" {
		return args[2]
	}
	return "/tmp/{name}-{quarry.Pid()}"
}

const procs = 8

const steps = 25

fn idFor(n i64) object.Id {
	return object.Hash(object.Kind.Blob, "count {n}")
}

fn countOf(t change.Target) i64 {
	let text = change.TargetText(t)
	for n in 0..procs * steps + 1 {
		if idFor(n).Hex() == text {
			return n
		}
	}
	return -1
}

fn writer() {
	mut r = change.NewRefs(dir)
	mut done = 0
	for done < steps {
		let cur = r.Get("refs/heads/counter") catch err {
			say.Line("read failed:", err)
			quarry.Exit(1)
			nil
		}
		if cur == nil {
			say.Line("no counter")
			quarry.Exit(1)
			return
		}
		let n = countOf(cur.Target)
		let err = r.Update("refs/heads/counter", cur.Target, change.Target.Commit(idFor(n + 1)))
		if err == nil {
			done += 1
		} else if fault.Is(err, change.ErrConflict) || fault.Is(err, change.ErrLocked) {
			tide.Wait(1ms) catch _ {
			}
		} else {
			say.Line("update failed:", err)
			quarry.Exit(1)
		}
	}
}

fn main() {
	let args = quarry.Args()
	if len(args) > 1 && args[1] == "writer" {
		writer()
		return
	}
	quarry.RemoveAll(dir) catch _ {
	}
	quarry.MkdirAll(dir) catch _ {
	}
	mut r = change.NewRefs(dir)
	r.Update("refs/heads/counter", nil, change.Target.Commit(idFor(0))) catch err {
		say.Line(err)
	}
	mut ps = []spawn.Process{}
	for i in 0..procs {
		let p = spawn.Start(spawn.Cmd{Argv: []str{args[0], "writer", dir}, Env: spawn.Env.Inherit, Dir: "", Stdin: spawn.Stdio.Null, Stdout: spawn.Stdio.Inherit, Stderr: spawn.Stdio.Inherit, MaxOutput: 0}) catch err {
			say.Line(err)
			return
		}
		ps = append(ps, p)
	}
	mut failed = 0
	for i in 0..len(ps) {
		mut p = ps[i]
		let code = p.Wait() catch _ {
			-1
		}
		if code != 0 {
			failed += 1
		}
	}
	say.Line("writers that failed:", failed)
	let end = r.Get("refs/heads/counter") catch _ {
		nil
	}
	if end != nil {
		say.Line("final count:", countOf(end.Target), "of", procs * steps)
	}
	quarry.RemoveAll(dir) catch _ {
	}
}
