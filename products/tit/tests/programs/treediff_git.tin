package main

import "../../diff"
import "../../object"
import "../../store"
import "quarry"
import "say"
import "sift"

// tit's tree diff against git (#785): this program writes two directories under /tmp, stores each as a tree and prints
// the changes as `git diff --no-index -M --name-status` and `--stat` print them (rename scores left out: git measures
// similarity its own way). The golden output is git's, for the same directories (products/tit/tests/treediff_git.sh).

// dir is the scratch directory (#1065): $TIN_TEST_DIR when the script that writes the golden output names one (it
// reads what this program leaves there), else this run's own, removed when main ends.
let given = quarry.Getenv("TIN_TEST_DIR")
let root = scratchDir("tin-test-tit-treediff")

fn scratchDir(name str) str {
	if len(given) > 0 {
		return given
	}
	return "/tmp/{name}-{quarry.Pid()}"
}

// done removes this run's own scratch directory.
fn done() {
	if len(given) == 0 {
		quarry.RemoveAll(root) catch _ {
		}
	}
}

fn put(rel str, text str) {
	let path = root + "/" + rel
	mut d = path
	for i in 0..len(path) {
		if path[i] == '/' {
			d = path[0:i]
		}
	}
	quarry.MkdirAll(d) catch _ {
	}
	quarry.WriteFile(path, text) catch err {
		say.Line(err)
	}
}

fn lines(prefix str, n i64) str {
	mut s = ""
	for i in 0..n {
		s = s + "{prefix} line {i}: some words to make it long enough\n"
	}
	return s
}

fn setup() {
	quarry.RemoveAll(root) catch _ {
	}
	put("a/same.txt", "unchanged\n")
	put("b/same.txt", "unchanged\n")
	put("a/edit.txt", lines("edit", 10))
	put("b/edit.txt", lines("edit", 4) + "a changed line\n" + lines("edit", 10)[5 * 50:])
	put("a/gone.txt", "only in a\n")
	put("b/new.txt", "only in b\n")
	put("a/old/name.txt", lines("moved", 8))
	put("b/fresh/name.txt", lines("moved", 8))
	put("a/src/lib.tin", lines("lib", 30))
	put("b/src/library.tin", lines("lib", 15) + "an edit in the middle\n" + lines("lib", 30)[16 * 50:])
	put("a/x.txt", lines("xxxx", 6))
	put("b/y.txt", lines("yyyy", 6))
	put("a/run.sh", "echo hi\n")
	put("b/run.sh", "echo hi\n")
	quarry.Chmod(root + "/b/run.sh", 493) catch _ {
	}
	put("a/link", "a regular file\n")
	quarry.Symlink("same.txt", root + "/b/link") catch _ {
	}
	put("a/big.txt", lines("big", 20))
	put("b/big.txt", lines("big", 20) + lines("more", 150))
	put("a/data.bin", "bin\x00ary one")
	put("b/data.bin", "bin\x00ary two, longer")
}

fn treeOf(s mut store.Mem, dir str) object.Id {
	let names = quarry.ReadDirEntries(dir) catch _ {
		[]quarry.DirEntry{}
	}
	mut es = []object.Entry{}
	for e in names {
		let full = dir + "/" + e.Name
		if e.Type == quarry.FileType.Dir {
			es = append(es, object.Entry{Mode: object.Mode.Dir, Name: e.Name, Id: treeOf(mut s, full)})
			continue
		}
		let info = quarry.Lstat(full) catch _ {
			continue
		}
		mut mode = object.Mode.File
		mut body = ""
		if info.Type == quarry.FileType.Symlink {
			mode = object.Mode.Link
			body = quarry.Readlink(full) catch _ {
				""
			}
		} else {
			if info.Perm & 73 != 0 {
				mode = object.Mode.Exec
			}
			body = quarry.ReadFile(full) catch _ {
				""
			}
		}
		let id = s.PutRaw(object.Kind.Blob, body) catch _ {
			object.NoId
		}
		es = append(es, object.Entry{Mode: mode, Name: e.Name, Id: id})
	}
	sift.SortStableFunc(mut es, fn(x object.Entry, y object.Entry) i64 {
		mut kx = x.Name
		mut ky = y.Name
		if x.Mode == object.Mode.Dir {
			kx = kx + "/"
		}
		if y.Mode == object.Mode.Dir {
			ky = ky + "/"
		}
		if kx < ky {
			return -1
		}
		if kx > ky {
			return 1
		}
		return 0
	})
	return s.Put(object.Object.Tree(es)) catch _ {
		object.NoId
	}
}

fn main() {
	defer done()
	let args = quarry.Args()
	setup()
	if len(args) > 1 && args[1] == "setup" {
		return
	}
	mut s = store.NewMem()
	let a = treeOf(mut s, root + "/a")
	let b = treeOf(mut s, root + "/b")
	let changes = diff.TreeDiff(mut s, a, b, true) catch err {
		say.Line(err)
		return
	}
	for c in changes {
		if c.Kind == diff.Kind.Renamed {
			say.Line("R\t" + c.OldPath + "\t" + c.Path)
		} else {
			say.Line(diff.KindLetter(c.Kind) + "\t" + c.Path)
		}
	}
	let stats = diff.Stats(mut s, changes) catch err {
		say.Line(err)
		return
	}
	say.Text(diff.FormatStat(stats))
}
