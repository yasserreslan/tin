package main

import "../../ignore"
import "quarry"
import "say"
import "sift"

// tit/ignore against git (#782): this program builds a tree of files and .gitignore files under /tmp, then prints
// every file the rules ignore. The golden output is what `git ls-files -o -i --exclude-standard` printed for the
// same tree (regenerate with products/tit/tests/ignore_git.sh).

let root = "/tmp/tin-test-tit-ignore"

let rootRules = "# comment line\n*.log\n!keep.log\nbuild/\n/dist\ndocs/**/*.tmp\n**/cache\na/**/z\nfoo/bar\n[abc]x.txt\n[!0-9]num.dat\n\\#hash\n\\!bang\n*.o\n!lib/*.o\nlogs/\n!logs/\ntmp*\ntrailing\\ \nspaces   \n*.[ch]~\nnested/**\n!nested/keep/\nq?.cfg\n"

let subRules = "*.txt\n!important.txt\n/local\ndeep/\n"

let innerRules = "!*.txt\n"

let files = []str{
	"app.log", "keep.log", "x/app.log", "x/keep.log", "build/out.bin", "x/build/out.bin", "build.txt",
	"dist/a", "x/dist/a", "docs/a.tmp", "docs/x/y/b.tmp", "docs/x/c.txt", "cache/f", "x/y/cache/f", "a/z",
	"a/b/c/z", "a/zz", "foo/bar", "x/foo/bar", "ax.txt", "dx.txt", "bx.txt", "anum.dat", "1num.dat", "#hash",
	"!bang", "m.o", "lib/m.o", "lib/sub/m.o", "logs/l1", "tmpfile", "x/tmp2", "trailing ", "trailing", "spaces",
	"main.c~", "main.h~", "main.x~", "nested/a", "nested/keep/b", "q1.cfg", "q12.cfg", "sub/a.txt",
	"sub/important.txt", "sub/local/f", "sub/x/local/f", "sub/deep/f", "sub/x/deep/f", "sub/inner/c.txt",
	"sub/inner/z.log", "plain.go", "x/plain.go",
}

fn main() {
	quarry.RemoveAll(root) catch _ {
	}
	quarry.MkdirAll(root) catch err {
		say.Line(err)
	}
	put(".gitignore", rootRules)
	put("sub/.gitignore", subRules)
	put("sub/inner/.gitignore", innerRules)
	for f in files {
		put(f, "x")
	}
	let rules = ignore.LoadTree(root) catch err {
		say.Line(err)
		return
	}
	mut out = []str{}
	for f in files {
		if rules.Ignored(f, false) {
			out = append(out, f)
		}
	}
	sift.Sort(mut out)
	for f in out {
		say.Line(f)
	}
}

fn put(rel str, text str) {
	let path = root + "/" + rel
	mut dir = path
	for i in 0..len(path) {
		if path[i] == '/' {
			dir = path[0:i]
		}
	}
	quarry.MkdirAll(dir) catch err {
		say.Line(err)
	}
	quarry.WriteFile(path, text) catch err {
		say.Line(err)
	}
}
