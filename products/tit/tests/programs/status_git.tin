package main

import "../../ignore"
import "../../index"
import "../../object"
import "../../store"
import "quarry"
import "say"
import "tide"

// tit's status against git's (#783). With no argument this program builds a working directory, stages and commits it,
// makes staged and unstaged changes of every kind, and prints status in git's porcelain v1 form. The golden output is
// `git status --porcelain` after the same file changes with git doing the staging (products/tit/tests/status_git.sh
// runs this program's init, stage-files and work steps around git).

// dir is the scratch directory (#1065): $TIN_TEST_DIR when the script that writes the golden output names one (it
// reads what this program leaves there), else this run's own, removed when main ends.
let given = quarry.Getenv("TIN_TEST_DIR")
let dir = scratchDir("tin-test-tit-status")

fn scratchDir(name str) str {
	if len(given) > 0 {
		return given
	}
	return "/tmp/{name}-{quarry.Pid()}"
}

// done removes this run's own scratch directory.
fn done() {
	if len(given) == 0 {
		quarry.RemoveAll(dir) catch _ {
		}
	}
}

fn put(rel str, text str) {
	let path = dir + "/" + rel
	mut d = path
	for i in 0..len(path) {
		if path[i] == '/' {
			d = path[0:i]
		}
	}
	quarry.MkdirAll(d) catch _ {
	}
	quarry.WriteFile(path, text) catch err {
		say.Line(err)
	}
}

let initial = []str{"a.txt", "b.txt", "d.sh", "e.txt", "f.txt", "h.txt", "i.txt", "j.txt", "sub/k.txt", "sub/deep/l.txt"}

fn initFiles() {
	quarry.RemoveAll(dir) catch _ {
	}
	quarry.MkdirAll(dir) catch _ {
	}
	for f in initial {
		put(f, "first version of {f}\n")
	}
	put(".gitignore", "*.log\nbuild/\n")
}

fn stageFiles() {
	put("f.txt", "f, staged edit\n")
	put("g.txt", "g, new and staged\n")
	quarry.Remove(dir + "/h.txt") catch _ {
	}
	put("i.txt", "i, staged edit\n")
}

fn work() {
	// a different mtime from the staged versions, whatever the clock's resolution
	tide.Sleep(20000000)
	put("i.txt", "i, edited again after staging\n")
	put("a.txt", "a, edited\n")
	quarry.Remove(dir + "/b.txt") catch _ {
	}
	put("c.txt", "c, untracked\n")
	put("sub/deep/m.txt", "m, untracked in a subdirectory\n")
	quarry.Chmod(dir + "/d.sh", 493) catch _ {
	}
	quarry.Remove(dir + "/e.txt") catch _ {
	}
	quarry.Symlink("a.txt", dir + "/e.txt") catch _ {
	}
	put("x.log", "ignored\n")
	put("build/out.bin", "ignored directory\n")
	put("j.txt", "first version of j.txt\n")
	put("sub/k.txt", "k, edited in a subdirectory\n")
}

fn code(f index.FileStatus) str {
	return match f {
		Added(_) => "A"
		Modified(_) => "M"
		Deleted(_) => "D"
		Renamed(_, _) => "R"
		TypeChanged(_) => "T"
		Untracked(_) => "?"
		Conflicted(_) => "U"
	}
}

fn pathOf(f index.FileStatus) str {
	return match f {
		Added(p) => p
		Modified(p) => p
		Deleted(p) => p
		Renamed(_, p) => p
		TypeChanged(p) => p
		Untracked(p) => p
		Conflicted(p) => p
	}
}

fn main() {
	defer done()
	let args = quarry.Args()
	if len(args) > 1 {
		if args[1] == "init" {
			initFiles()
		} else if args[1] == "stage-files" {
			stageFiles()
		} else if args[1] == "work" {
			work()
		}
		return
	}
	initFiles()
	mut s = store.NewMem()
	mut idx = index.New()
	for f in initial {
		index.Add(mut idx, mut s, dir, f) catch err {
			say.Line(err)
		}
	}
	index.Add(mut idx, mut s, dir, ".gitignore") catch err {
		say.Line(err)
	}
	let head = index.WriteTree(mut s, idx) catch err {
		say.Line(err)
		object.NoId
	}
	stageFiles()
	for f in []str{"f.txt", "g.txt", "i.txt"} {
		index.Add(mut idx, mut s, dir, f) catch err {
			say.Line(err)
		}
	}
	idx.Remove("h.txt")
	work()
	mut rules = ignore.Load(dir) catch _ {
		ignore.New(dir)
	}
	let rep = index.Status(mut s, dir, head, mut idx, mut rules) catch err {
		say.Line(err)
		return
	}
	// porcelain v1: staged and unstaged codes per tracked path in path order, then untracked files
	mut lines = map[str][]str{}
	mut paths = []str{}
	for f in rep.Staged {
		let p = pathOf(f)
		let (cur, ok) = lines[p]
		if !ok {
			paths = append(paths, p)
			lines[p] = []str{code(f), " "}
		} else {
			lines[p] = []str{code(f), cur[1]}
		}
	}
	for f in rep.Unstaged {
		let p = pathOf(f)
		let (cur, ok) = lines[p]
		if !ok {
			paths = append(paths, p)
			lines[p] = []str{" ", code(f)}
		} else {
			lines[p] = []str{cur[0], code(f)}
		}
	}
	for i in 1..len(paths) {
		let x = paths[i]
		mut j = i - 1
		for j >= 0 && paths[j] > x {
			paths[j + 1] = paths[j]
			j -= 1
		}
		paths[j + 1] = x
	}
	for p in paths {
		let c = lines[p]
		say.Line(c[0] + c[1] + " " + p)
	}
	// untracked files come after the tracked ones, as git lists them
	for p in rep.Untracked {
		say.Line("?? " + p)
	}
}
