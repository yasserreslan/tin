package main

import "../../change"
import "../../git"
import "../../index"
import "../../object"
import "../../oplog"
import "../../packfile"
import "../../semantic"
import "../../stack"
import "../../store"
import "../../transport"
import "argo"
import "fault"
import "quarry"
import "say"
import "seal"

// Damaged inputs (#806): every format tit reads from the disk or the network, taken from a valid sample and damaged
// at every byte (one bit flipped) and cut at every length, is decoded inside guard. A decoder may accept a damaged
// input or refuse it with a fault; it must never panic. The golden output is the number of inputs of each format
// and that none of them panicked.

let tmp = "/tmp/tin-test-tit-damaged-" + seal.Hex(seal.RandomBytes(4))

// variants is every one-byte damage and every cut of a sample.
fn variants(sample str) []str {
	mut out = []str{}
	for i in 0..len(sample) {
		mut b = []u8(sample)
		b[i] = b[i] ^ 0x41
		out = append(out, str(b))
	}
	for n in 0..len(sample) {
		out = append(out, sample[0:n])
	}
	return out
}

// refused counts a fault: a damaged input may be refused.
fn refused(e fault) i64 {
	if e == nil {
		return 0
	}
	return 1
}

fn report(name str, inputs i64, panics i64) {
	say.Line(name + ":", inputs, "damaged inputs,", panics, "panics")
}

fn person() object.Person {
	return object.Person{Name: "Ada", Email: "ada@example.com", When: 1700000000, Zone: 60}
}

fn objects() {
	let blob = object.Hash(object.Kind.Blob, "x")
	let tree = object.Object.Tree([]object.Entry{object.Entry{Mode: object.Mode.File, Name: "a.txt", Id: blob}, object.Entry{Mode: object.Mode.Exec, Name: "run", Id: blob}})
	let tb = object.Body(tree) catch _ {
		""
	}
	let tid = object.Hash(object.Kind.Tree, tb)
	let c = object.CommitData{Tree: tid, Parents: []object.Id{blob}, Change: object.AdoptedChangeId("x"), Author: person(), Committer: person(), GitHeaders: []str{"encoding UTF-8"}, Signature: "", Message: "a message\n\nwith a body\n", Conflicts: []str{"a.txt\t-\t" + blob.Hex() + "\t" + blob.Hex()}}
	let cb = object.Body(object.Object.Commit(c)) catch _ {
		""
	}
	let tag = object.TagData{Object: tid, Kind: object.Kind.Commit, Name: "v1", Tagger: person(), Signature: "", Message: "one\n"}
	let gb = object.Body(object.Object.Tag(tag)) catch _ {
		""
	}
	let kinds = []object.Kind{object.Kind.Tree, object.Kind.Commit, object.Kind.Tag}
	let samples = []str{tb, cb, gb}
	mut n = 0
	mut p = 0
	for k in 0..3 {
		for v in variants(samples[k]) {
			n += 1
			let kind = kinds[k]
			_ = guard {
				let (_, err) = object.Decode(kind, v)
				_ = refused(err)
				0
			} catch err {
				if fault.Is(err, fault.Panic) {
					p += 1
				}
				0
			}
		}
	}
	report("objects", n, p)
}

fn packs() {
	mut s = store.NewMem()
	mut ids = []object.Id{}
	mut text = ""
	for i in 0..6 {
		text = text + "line {i} of a file\n"
		let id = s.PutRaw(object.Kind.Blob, text) catch _ {
			object.NoId
		}
		ids = append(ids, id)
	}
	let p = packfile.Write(mut s, ids, tmp + "/pack") catch _ {
		say.Line("cannot write the pack")
		return
	}
	let data = quarry.ReadFile(p.Path) catch _ {
		""
	}
	mut n = 0
	mut panics = 0
	for v in variants(data) {
		n += 1
		_ = guard {
			mut m = store.NewMem()
			let (_, err) = packfile.Unpack(v, mut m, 1 << 20)
			_ = refused(err)
			0
		} catch err {
			if fault.Is(err, fault.Panic) {
				panics += 1
			}
			0
		}
	}
	report("packs", n, panics)
}

fn indexes() {
	mut idx = index.New()
	idx.Set(index.Entry{Path: "a.txt", Hash: object.Hash(object.Kind.Blob, "a").Bytes(), Mode: object.Mode.File, Stage: 0, Size: 2, Mtime: 5, Ctime: 6, Inode: 7, Device: 8})
	idx.SetConflict("b.txt", object.Mode.File, "", object.Hash(object.Kind.Blob, "o").Bytes(), object.Hash(object.Kind.Blob, "t").Bytes())
	let path = tmp + "/index"
	idx.Write(path) catch _ {
		say.Line("cannot write the index")
		return
	}
	let data = quarry.ReadFile(path) catch _ {
		""
	}
	mut n = 0
	mut panics = 0
	for v in variants(data) {
		n += 1
		quarry.WriteFile(path, v) catch _ {
		}
		_ = guard {
			let (_, err) = index.Read(path)
			_ = refused(err)
			0
		} catch err {
			if fault.Is(err, fault.Panic) {
				panics += 1
			}
			0
		}
	}
	report("indexes", n, panics)
}

fn oplogs() {
	let dir = tmp + "/oplog-repo"
	quarry.MkdirAll(dir + "/refs/heads") catch _ {
	}
	_ = oplog.Run(dir, "default", "tit commit", oplog.Op.Commit("kz"), []oplog.RefChange{oplog.RefChange{Name: "refs/heads/main", Before: "", After: object.Hash(object.Kind.Blob, "c").Hex()}}) catch _ {
		0
	}
	let names = quarry.ReadDir(dir + "/oplog") catch _ {
		[]str{}
	}
	let path = dir + "/oplog/" + names[0]
	let data = quarry.ReadFile(path) catch _ {
		""
	}
	mut n = 0
	mut panics = 0
	for v in variants(data) {
		n += 1
		quarry.WriteFile(path, v) catch _ {
		}
		_ = guard {
			let (_, err) = oplog.List(dir)
			_ = refused(err)
			0
		} catch err {
			if fault.Is(err, fault.Panic) {
				panics += 1
			}
			0
		}
	}
	report("oplog records", n, panics)
}

fn frames() {
	let req = transport.PushRequest{Changes: []transport.ChangeUpdate{transport.ChangeUpdate{Change: "kz", Replaces: "", Commit: "ab"}}, Refs: []transport.RefUpdate{transport.RefUpdate{Name: "refs/heads/main", Old: "", New: "ab"}}}
	let body = transport.Frame(transport.Kind.PushRequest, transport.Encode(req), "TITPACK")
	mut n = 0
	mut panics = 0
	for v in variants(body) {
		n += 1
		_ = guard {
			let (_, header, _, err) = transport.ReadFrame(v)
			if err == nil {
				mut back = transport.PushRequest{Changes: []transport.ChangeUpdate{}, Refs: []transport.RefUpdate{}}
				let derr = argo.Get(header, mut back)
				_ = refused(derr)
			}
			0
		} catch err {
			if fault.Is(err, fault.Panic) {
				panics += 1
			}
			0
		}
	}
	report("protocol frames", n, panics)
}

fn gitObjects() {
	let tree = "100644 a.txt\x00" + str(seal.Sha1("a")) + "40000 dir\x00" + str(seal.Sha1("d"))
	let commit = "tree " + seal.Hex(seal.Sha1("t")) + "\nparent " + seal.Hex(seal.Sha1("p")) + "\nauthor Ada <ada@example.com> 1700000000 +0100\ncommitter Ada <ada@example.com> 1700000000 -0230\ngpgsig -----BEGIN-----\n abc\n -----END-----\n\nmessage\n"
	let tag = "object " + seal.Hex(seal.Sha1("o")) + "\ntype commit\ntag v1\ntagger Ada <ada@example.com> 1700000000 +0000\n\none\n"
	mut n = 0
	mut panics = 0
	for v in variants(tree) {
		n += 1
		_ = guard {
			let (_, err) = git.ParseTree(v)
			_ = refused(err)
			0
		} catch err {
			if fault.Is(err, fault.Panic) {
				panics += 1
			}
			0
		}
	}
	for v in variants(commit) {
		n += 1
		_ = guard {
			let (c, err) = git.ParseCommit(v)
			if err == nil {
				let (_, perr) = git.ParsePerson(c.Author)
				_ = refused(perr)
			}
			0
		} catch err {
			if fault.Is(err, fault.Panic) {
				panics += 1
			}
			0
		}
	}
	for v in variants(tag) {
		n += 1
		_ = guard {
			let (_, err) = git.ParseTag(v)
			_ = refused(err)
			0
		} catch err {
			if fault.Is(err, fault.Panic) {
				panics += 1
			}
			0
		}
	}
	report("git objects", n, panics)
}

fn gitIds() {
	mut ids = git.NewIds()
	ids.Set(str(seal.Sha1("a")), object.Hash(object.Kind.Blob, "a").Bytes())
	ids.Set(str(seal.Sha1("b")), object.Hash(object.Kind.Blob, "b").Bytes())
	let path = tmp + "/git-ids"
	git.WriteIds(path, ids) catch _ {
		say.Line("cannot write the table")
		return
	}
	let data = quarry.ReadFile(path) catch _ {
		""
	}
	mut n = 0
	mut panics = 0
	for v in variants(data) {
		n += 1
		quarry.WriteFile(path, v) catch _ {
		}
		_ = guard {
			let (_, err) = git.ReadIds(path)
			_ = refused(err)
			0
		} catch err {
			if fault.Is(err, fault.Panic) {
				panics += 1
			}
			0
		}
	}
	report("git-ids tables", n, panics)
}

fn texts() {
	let src = "package p\n\n// Doc.\nfn (p Point) Len() i64 {{\n\treturn p.X\n}}\n\nfunc old() {{\n}}\n\ntype T struct {{\n\tX i64\n}}\n\nconst K = 1\n"
	let line = "a.txt\t-\t" + object.Hash(object.Kind.Blob, "o").Hex() + "\t-"
	let target = "change kzkzkzkzkzkzkzkzkzkzkzkzkzkzkzkz"
	mut n = 0
	mut panics = 0
	for v in variants(src) {
		n += 1
		_ = guard {
			let (ds, _) = semantic.Decls(v)
			let cs = semantic.Compare([]str{"a.tin"}, []str{src}, []str{v})
			len(ds) + len(cs)
		} catch err {
			if fault.Is(err, fault.Panic) {
				panics += 1
			}
			0
		}
	}
	for v in variants(line) {
		n += 1
		_ = guard {
			let (_, err) = stack.ParseConflict(v)
			_ = refused(err)
			0
		} catch err {
			if fault.Is(err, fault.Panic) {
				panics += 1
			}
			0
		}
	}
	for v in variants(target) {
		n += 1
		_ = guard {
			let (_, err) = change.ParseTarget(v)
			_ = refused(err)
			0
		} catch err {
			if fault.Is(err, fault.Panic) {
				panics += 1
			}
			0
		}
	}
	report("Tin source, conflict lines and ref targets", n, panics)
}

fn main() {
	quarry.MkdirAll(tmp) catch _ {
	}
	objects()
	packs()
	indexes()
	oplogs()
	frames()
	gitObjects()
	gitIds()
	texts()
	quarry.RemoveAll(tmp) catch _ {
	}
}
