package main

import "../../diff"
import "quarry"
import "say"

// tit/diff's unified output against git (#785): this program writes pairs of files under /tmp and prints their
// unified diffs. The golden output is what `git diff --no-index --no-indent-heuristic -U3` printed for the same
// pairs, with its "diff --git" and "index" lines and the function names after "@@" left out (regenerate with
// products/tit/tests/diff_git.sh).

// dir is the scratch directory (#1065): $TIN_TEST_DIR when the script that writes the golden output names one (it
// reads what this program leaves there), else this run's own, removed when main ends.
let given = quarry.Getenv("TIN_TEST_DIR")
let dir = scratchDir("tin-test-tit-diff")

fn scratchDir(name str) str {
	if len(given) > 0 {
		return given
	}
	return "/tmp/{name}-{quarry.Pid()}"
}

// done removes this run's own scratch directory.
fn done() {
	if len(given) == 0 {
		quarry.RemoveAll(dir) catch _ {
		}
	}
}

fn numbered(n i64, edits map[i64]str) str {
	mut out = ""
	for i in 1..n + 1 {
		let (v, ok) = edits[i]
		if ok {
			out = out + v
		} else {
			out = out + "line {i}\n"
		}
	}
	return out
}

fn cases() [][]str {
	return [][]str{
		[]str{"same", "a\nb\n", "a\nb\n"},
		[]str{"empty-to-text", "", "one\ntwo\n"},
		[]str{"text-to-empty", "one\ntwo\n", ""},
		[]str{"no-newline-old", "a\nb", "a\nb\n"},
		[]str{"no-newline-new", "a\nb\n", "a\nc"},
		[]str{"no-newline-both", "x\ny", "x\nz"},
		[]str{"one-change", numbered(10, map[i64]str{5: "five\n"}), numbered(10, map[i64]str{})},
		[]str{"far-apart", numbered(40, map[i64]str{3: "three\n", 35: "thirty-five\n"}), numbered(40, map[i64]str{})},
		[]str{"close-together", numbered(20, map[i64]str{5: "five\n", 11: "eleven\n"}), numbered(20, map[i64]str{})},
		[]str{"insert-start", "b\nc\n", "a\nb\nc\n"},
		[]str{"delete-end", "a\nb\nc\n", "a\nb\n"},
		[]str{"rewrite", "fn main() {{\n\tsay.Line(1)\n}}\n", "package main\n\nfn run() {{\n\treturn\n}}\n"},
		[]str{"blocks", "a\nb\nc\nd\ne\nf\ng\n", "a\nc\nd\nX\nf\ng\nh\n"},
	}
}

fn main() {
	defer done()
	quarry.RemoveAll(dir) catch _ {
	}
	quarry.MkdirAll(dir) catch err {
		say.Line(err)
	}
	for c in cases() {
		let name = c[0]
		quarry.WriteFile(dir + "/" + name + ".old", c[1]) catch err {
			say.Line(err)
		}
		quarry.WriteFile(dir + "/" + name + ".new", c[2]) catch err {
			say.Line(err)
		}
		say.Text(diff.Unified("a/" + name + ".old", "b/" + name + ".new", c[1], c[2], 3))
	}
}
