package main

import "../../merge"
import "quarry"
import "say"
import "seal"

// tit/merge's line merge against git on real files (#786): tests/corpus/merge holds (base, ours, theirs) triples of
// files that both main and another branch of the Tin repository changed since their merge base. For each, this
// program prints whether the merge is clean and, when it is, the SHA-256 of the result; the golden output is what
// `git merge-file -p` gave for the same files (rebuild both with products/tit/tests/merge_corpus.sh).

let dir = "products/tit/tests/corpus/merge"

fn main() {
	mut k = 0
	for quarry.Exists("{dir}/{k}.base") {
		let b = quarry.ReadFile("{dir}/{k}.base") catch _ {
			""
		}
		let o = quarry.ReadFile("{dir}/{k}.ours") catch _ {
			""
		}
		let t = quarry.ReadFile("{dir}/{k}.theirs") catch _ {
			""
		}
		let (merged, clean) = merge.MergeText(b, o, t, "ours", "theirs")
		if clean {
			say.Line(k, "clean", seal.Sha256Hex(merged))
		} else {
			say.Line(k, "conflict")
		}
		k += 1
	}
}
