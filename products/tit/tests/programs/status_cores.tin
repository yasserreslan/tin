package main

import "../../cores"
import "../../ignore"
import "../../index"
import "../../object"
import "../../store"
import "quarry"
import "say"

// Status on four cores (#783): 300 files, every one changed after staging, are hashed by the worker pool, and the
// result equals status on one core.

let dir = "/tmp/tin-test-tit-status-cores"

fn run() {
	quarry.RemoveAll(dir) catch _ {
	}
	mut s = store.NewMem()
	mut idx = index.New()
	for i in 0..300 {
		let p = "d{i % 7}/file{i}.txt"
		quarry.MkdirAll(dir + "/d{i % 7}") catch _ {
		}
		quarry.WriteFile(dir + "/" + p, "version one of {i}\n") catch _ {
		}
		index.Add(mut idx, mut s, dir, p) catch err {
			say.Line(err)
		}
	}
	let head = index.WriteTree(mut s, idx) catch _ {
		object.NoId
	}
	for i in 0..300 {
		// every third file changes; the rest are rewritten with the same bytes, so their stat changes and they must be
		// hashed to learn they are the same
		mut text = "version one of {i}\n"
		if i % 3 == 0 {
			text = "version two of {i}\n"
		}
		quarry.WriteFile(dir + "/d{i % 7}/file{i}.txt", text) catch _ {
		}
	}
	mut rules = ignore.New(dir)
	let rep = index.Status(mut s, dir, head, mut idx, mut rules) catch err {
		say.Line(err)
		return
	}
	say.Line("pool running:", cores.Running())
	say.Line("modified:", len(rep.Unstaged), "staged:", len(rep.Staged), "untracked:", len(rep.Untracked))
}

fn main() {
	cores.Start(4, run)
}
