package main

import "../../merge"
import "dice"
import "quarry"
import "say"
import "seal"

// tit/merge's line merge against git (#786): this program writes 60 triples (a base of 40 lines and two sides with
// random edits) under /tmp and prints, for each, whether the merge is clean and, when it is, the SHA-256 of the result.
// The golden output is what `git merge-file -p` gave for the same files (regenerate with
// products/tit/tests/merge_git.sh).

// dir is the scratch directory (#1065): $TIN_TEST_DIR when the script that writes the golden output names one (it
// reads what this program leaves there), else this run's own, removed when main ends.
let given = quarry.Getenv("TIN_TEST_DIR")
let dir = scratchDir("tin-test-tit-merge")

fn scratchDir(name str) str {
	if len(given) > 0 {
		return given
	}
	return "/tmp/{name}-{quarry.Pid()}"
}

// done removes this run's own scratch directory.
fn done() {
	if len(given) == 0 {
		quarry.RemoveAll(dir) catch _ {
		}
	}
}

let words = []str{"fn", "let", "mut", "return", "x", "y", "count", "+", "1", "if", "{{", "}}", "say.Line", "len", "for"}

fn line(r mut dice.Rand) str {
	mut s = ""
	for i in 0..1 + r.Intn(5) {
		if i > 0 {
			s = s + " "
		}
		s = s + words[r.Intn(len(words))]
	}
	return s + "\n"
}

fn edit(r mut dice.Rand, base []str, lo i64, hi i64) []str {
	mut out = []str{}
	for i in 0..len(base) {
		if i >= lo && i < hi && r.Intn(4) == 0 {
			let what = r.Intn(3)
			if what == 0 {
				continue
			}
			if what == 1 {
				out = append(out, line(mut r))
				continue
			}
			out = append(out, line(mut r))
		}
		out = append(out, base[i])
	}
	return out
}

fn join(ls []str) str {
	mut s = ""
	for l in ls {
		s = s + l
	}
	return s
}

fn main() {
	defer done()
	quarry.RemoveAll(dir) catch _ {
	}
	quarry.MkdirAll(dir) catch err {
		say.Line(err)
	}
	mut r = dice.New(17)
	for k in 0..60 {
		mut base = []str{}
		for i in 0..40 {
			base = append(base, line(mut r))
		}
		// a third of the cases edit far-apart halves, the rest anywhere (so some overlap)
		mut ours = []str{}
		mut theirs = []str{}
		if k % 3 == 0 {
			ours = edit(mut r, base, 0, 15)
			theirs = edit(mut r, base, 25, 40)
		} else {
			ours = edit(mut r, base, 0, 40)
			theirs = edit(mut r, base, 0, 40)
		}
		let b = join(base)
		let o = join(ours)
		let t = join(theirs)
		quarry.WriteFile("{dir}/{k}.base", b) catch _ {
		}
		quarry.WriteFile("{dir}/{k}.ours", o) catch _ {
		}
		quarry.WriteFile("{dir}/{k}.theirs", t) catch _ {
		}
		let (merged, clean) = merge.MergeText(b, o, t, "ours", "theirs")
		if clean {
			say.Line(k, "clean", seal.Sha256Hex(merged))
		} else {
			say.Line(k, "conflict")
		}
	}
}
