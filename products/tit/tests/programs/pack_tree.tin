package main

import "../../object"
import "../../packfile"
import "../../store"
import "quarry"
import "say"

// Packs real files (#778): every .tin file of the standard library, plus an edited second version of each, is packed;
// the pack verifies and every object reads back the same. Run from the repository root (products/tit/tests/run.sh).

// out is this run's own pack directory (#1065).
let out = "/tmp/tin-test-tit-pack-tree-{quarry.Pid()}"

fn main() {
	mut s = store.NewMem()
	mut ids = []object.Id{}
	let pkgs = quarry.ReadDir("toolchain/std") catch err {
		say.Line(err)
		return
	}
	mut files = 0
	for pkg in pkgs {
		let dir = "toolchain/std/" + pkg
		if !quarry.IsDir(dir) {
			continue
		}
		let names = quarry.ReadDir(dir) catch _ {
			[]str{}
		}
		for name in names {
			if len(name) < 5 || name[len(name) - 4:] != ".tin" {
				continue
			}
			let text = quarry.ReadFile(dir + "/" + name) catch _ {
				continue
			}
			files += 1
			let a = s.PutRaw(object.Kind.Blob, text) catch _ {
				object.NoId
			}
			let b = s.PutRaw(object.Kind.Blob, "// edited\n" + text + "\n// more\n") catch _ {
				object.NoId
			}
			ids = append(ids, a)
			ids = append(ids, b)
		}
	}
	quarry.RemoveAll(out) catch _ {
	}
	mut p = packfile.Write(mut s, ids, out) catch err {
		say.Line("write:", err)
		return
	}
	mut wrong = 0
	for id in ids {
		let (k1, b1, e1) = p.GetRaw(id)
		let (k2, b2, e2) = s.GetRaw(id)
		if e1 != nil || e2 != nil || k1 != k2 || b1 != b2 {
			wrong += 1
		}
	}
	say.Line("more than 100 files:", files > 100)
	say.Line("objects read back wrong:", wrong)
	say.Line("the edited versions are deltas:", p.Deltas() * 10 > files * 9)
	let err = p.Verify()
	say.Line("verifies:", err == nil)
	quarry.RemoveAll(out) catch _ {
	}
}
