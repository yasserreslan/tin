package git

import "../object"
import "fault"
import "flume"
import "quarry"
import "seal"
import "sift"
import "squash"
import "trail"
import "twine"

// Reading a git repository (#789): loose objects, packs (index v2, OFS and REF deltas), refs, packed refs and HEAD,
// following a .git file to a git worktree's directory. Ids are their 20 raw bytes; Hex writes them out.

// ErrNotGit is the fault of a directory that is not a git repository.
let ErrNotGit = fault("not a git repository")

// ErrShallow is the fault of a shallow clone, whose history is cut off.
let ErrShallow = fault("a shallow clone: run git fetch --unshallow first")

// ErrMissing is the fault of a git object the repository does not hold.
let ErrMissing = fault("git object not found")

// ErrBadObject is the fault of a damaged git object: one that does not inflate, parse or hash to its id.
let ErrBadObject = fault("bad git object")

// maxObject is the largest object read: 4 GiB.
const maxObject = 4 * 1024 * 1024 * 1024

// Repo is an open git repository.
type Repo struct {
	// GitDir holds HEAD: .git itself, or a worktree's directory under .git/worktrees
	GitDir str
	// CommonDir holds the objects and the shared refs
	CommonDir str
	packs     []Pack
}

// Hex is a git id's 40 hex digits.
fn Hex(id str) str {
	return seal.Hex([]u8(id))
}

// ParseHex is the raw id of 40 hex digits.
fn ParseHex(h str) !str {
	if len(h) != 40 {
		fail fault.Wrap(ErrBadObject, "{h} is not a git id")
	}
	let b = seal.HexDecode(h) catch _ {
		fail fault.Wrap(ErrBadObject, "{h} is not a git id")
	}
	return str(b)
}

fn absolute(base str, p str) str {
	if len(p) > 0 && p[0] == '/' {
		return trail.Clean(p)
	}
	return trail.Clean(base + "/" + p)
}

// Open opens the git repository of a working directory (its .git directory, or the directory a .git file names) or a
// git directory itself. A shallow clone is refused.
fn Open(path str) !Repo {
	mut dir = path
	let dotgit = path + "/.git"
	if quarry.IsDir(dotgit) {
		dir = dotgit
	} else if quarry.Exists(dotgit) {
		let raw = try quarry.ReadFile(dotgit)
		let text = twine.TrimSpace(raw)
		if !twine.HasPrefix(text, "gitdir: ") {
			fail fault.Wrap(ErrNotGit, "{dotgit} does not name a git directory")
		}
		dir = absolute(path, text[8:])
	}
	if !quarry.Exists(dir + "/HEAD") {
		fail fault.Wrap(ErrNotGit, path)
	}
	mut common = dir
	if quarry.Exists(dir + "/commondir") {
		let c = try quarry.ReadFile(dir + "/commondir")
		common = absolute(dir, twine.TrimSpace(c))
	}
	if !quarry.IsDir(common + "/objects") {
		fail fault.Wrap(ErrNotGit, "{path}: no objects directory")
	}
	if quarry.Exists(common + "/shallow") {
		fail fault.Wrap(ErrShallow, path)
	}
	mut packs = []Pack{}
	let pdir = common + "/objects/pack"
	if quarry.IsDir(pdir) {
		mut names = try quarry.ReadDir(pdir)
		sift.Sort(mut names)
		for n in names {
			if twine.HasSuffix(n, ".idx") {
				let base = pdir + "/" + n[0:len(n) - 4]
				if quarry.Exists(base + ".pack") {
					let p = try OpenPack(base)
					packs = append(packs, p)
				}
			}
		}
	}
	return Repo{GitDir: dir, CommonDir: common, packs: packs}
}

fn kindOf(name str) !object.Kind {
	if name == "blob" {
		return object.Kind.Blob
	}
	if name == "tree" {
		return object.Kind.Tree
	}
	if name == "commit" {
		return object.Kind.Commit
	}
	if name == "tag" {
		return object.Kind.Tag
	}
	fail fault.Wrap(ErrBadObject, "unknown kind {name}")
}

fn kindName(k object.Kind) str {
	return match k {
		Blob => "blob"
		Tree => "tree"
		Commit => "commit"
		Tag => "tag"
	}
}

// IdOf is the git id of an object: the SHA-1 of "<kind> <size>\0" and its body.
fn IdOf(kind object.Kind, body str) str {
	mut h = seal.NewSha1()
	h.WriteStr("{kindName(kind)} {len(body)}\x00")
	h.WriteStr(body)
	return str(h.Sum())
}

// Has reports whether the repository holds the object.
fn (r Repo) Has(id str) bool {
	let h = Hex(id)
	if quarry.Exists(r.CommonDir + "/objects/" + h[0:2] + "/" + h[2:]) {
		return true
	}
	for p in r.packs {
		if p.Find(id) >= 0 {
			return true
		}
	}
	return false
}

// Read is an object's kind and body, checked against its id.
fn (r Repo) Read(id str) !(object.Kind, str) {
	let (kind, body) = try r.readUnchecked(id)
	if IdOf(kind, body) != id {
		fail fault.Wrap(ErrBadObject, "{Hex(id)} does not hash to its id")
	}
	return kind, body
}

fn (r Repo) readUnchecked(id str) !(object.Kind, str) {
	let h = Hex(id)
	let loose = r.CommonDir + "/objects/" + h[0:2] + "/" + h[2:]
	if quarry.Exists(loose) {
		let z = try flume.ReadFile(loose)
		let raw = squash.Unzlib(z, maxObject) catch e {
			fail fault.Wrap(ErrBadObject, "{h}: {fault.Message(e)}")
		}
		let sp = twine.IndexByte(raw, ' ')
		let nul = twine.IndexByte(raw, 0)
		if sp < 0 || nul < sp {
			fail fault.Wrap(ErrBadObject, "{h}: no header")
		}
		let kind = try kindOf(raw[0:sp])
		let body = raw[nul + 1:]
		if "{len(body)}" != raw[sp + 1:nul] {
			fail fault.Wrap(ErrBadObject, "{h}: the size in its header is wrong")
		}
		return kind, body
	}
	for i in 0..len(r.packs) {
		let at = r.packs[i].Find(id)
		if at >= 0 {
			return try r.entry(i, at, 0)
		}
	}
	fail fault.Wrap(ErrMissing, h)
}

// resolved is a pack entry with its deltas applied.
type resolved struct {
	kind object.Kind
	body str
}

// entry is the object at offset at of pack i, its deltas applied. Each level of a delta chain runs in an arena of its
// own, so the levels below it are freed as soon as it has its result: a chain costs a few times one object's size,
// not one copy per level.
fn (r Repo) entry(i i64, at i64, depth i64) !(object.Kind, str) {
	let res = try arena {
		try r.level(i, at, depth)
	}
	return res.kind, res.body
}

fn (r Repo) level(i i64, at i64, depth i64) !resolved {
	if depth > 1000 {
		fail fault.Wrap(ErrBadObject, "{r.packs[i].path}: a delta chain longer than 1000")
	}
	let e = try r.packs[i].header(at)
	if e.typ >= 1 && e.typ <= 4 {
		let body = try r.packs[i].inflate(e.data, e.size)
		let kind = try packKind(e.typ)
		return resolved{kind: kind, body: body}
	}
	mut baseKind = object.Kind.Blob
	mut base = ""
	if e.typ == 6 {
		let (k, b) = try r.entry(i, e.base, depth + 1)
		baseKind = k
		base = b
	} else {
		let (k, b) = try r.readUnchecked(e.baseId)
		baseKind = k
		base = b
	}
	let delta = try r.packs[i].inflate(e.data, e.size)
	let body = try applyGitDelta(base, delta)
	return resolved{kind: baseKind, body: body}
}

fn packKind(t i64) !object.Kind {
	if t == 1 {
		return object.Kind.Commit
	}
	if t == 2 {
		return object.Kind.Tree
	}
	if t == 3 {
		return object.Kind.Blob
	}
	if t == 4 {
		return object.Kind.Tag
	}
	fail fault.Wrap(ErrBadObject, "pack entry type {t}")
}

// Ref is a git ref: its full name and the id it names.
type Ref struct {
	Name str
	Id   str
}

// Refs are the branches, tags and remote-tracking branches, from the loose ref files and packed-refs (a loose file
// wins), sorted by name. Symbolic refs (refs/remotes/origin/HEAD) are left out.
fn (r Repo) Refs() ![]Ref {
	mut found = map[str]str{}
	let packed = r.CommonDir + "/packed-refs"
	if quarry.Exists(packed) {
		let text = try quarry.ReadFile(packed)
		for line in twine.Split(text, "\n") {
			if len(line) < 42 || line[0] == '#' || line[0] == '^' {
				continue
			}
			let id = try ParseHex(line[0:40])
			found[line[41:]] = id
		}
	}
	for top in []str{"refs/heads", "refs/tags", "refs/remotes"} {
		try looseRefs(r.CommonDir, top, mut found)
	}
	mut names = []str{}
	for n, _ in found {
		if twine.HasPrefix(n, "refs/heads/") || twine.HasPrefix(n, "refs/tags/") || twine.HasPrefix(n, "refs/remotes/") {
			names = append(names, n)
		}
	}
	sift.Sort(mut names)
	mut out = []Ref{}
	for n in names {
		let (id, _) = found[n]
		out = append(out, Ref{Name: n, Id: id})
	}
	return out
}

fn looseRefs(common str, dir str, found mut map[str]str) ! {
	let full = common + "/" + dir
	if !quarry.IsDir(full) {
		return
	}
	let names = try quarry.ReadDir(full)
	for n in names {
		let rel = dir + "/" + n
		if quarry.IsDir(common + "/" + rel) {
			try looseRefs(common, rel, mut found)
			continue
		}
		let raw = try quarry.ReadFile(common + "/" + rel)
		let text = twine.TrimSpace(raw)
		if twine.HasPrefix(text, "ref: ") || len(text) != 40 {
			continue
		}
		let id = try ParseHex(text)
		found[rel] = id
	}
}

// Head is what HEAD names: a branch (its full name, and its id if it has commits), or a detached commit (name "").
fn (r Repo) Head() !(str, str) {
	let raw = try quarry.ReadFile(r.GitDir + "/HEAD")
	let text = twine.TrimSpace(raw)
	if twine.HasPrefix(text, "ref: ") {
		let name = text[5:]
		let refs = try r.Refs()
		for ref in refs {
			if ref.Name == name {
				return name, ref.Id
			}
		}
		return name, ""
	}
	let id = try ParseHex(text)
	return "", id
}
