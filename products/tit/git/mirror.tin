package git

import "../object"
import "../packfile"
import "../store"
import "fault"
import "flume"
import "quarry"
import "seal"
import "squash"
import "twine"

// tit mirror (#805): tit's commits written as git objects into a git directory, so git (and GitHub) carry the same
// history. Adopted commits are written back byte for byte and keep their git ids (the git-ids table maps them); a
// commit made in tit gets one fixed encoding: its message, then a Change-Id line, and no signature, so every machine
// mirroring it writes the same git id. Every object written is recorded in the git-ids table, so a later run (and a
// later adopt) knows it.

// MirrorMessage is a tit commit's message as the mirror writes it: the message, a blank line, "Change-Id: <id>".
fn MirrorMessage(message str, change str) str {
	mut m = message
	for len(m) > 0 && m[len(m) - 1] == '\n' {
		m = m[0:len(m) - 1]
	}
	return m + "\n\nChange-Id: " + change + "\n"
}

// titStore is the tit repository's store in its .tit directory: the loose objects and every pack.
fn titStore(dir str) !store.Layered {
	mut layers = []dyn store.ObjectStore{store.NewLoose(dir + "/objects")}
	let pdir = dir + "/packs"
	if quarry.IsDir(pdir) {
		let names = try quarry.ReadDir(pdir)
		for n in names {
			if twine.HasSuffix(n, ".pack") && !twine.HasPrefix(n, "tmp-") {
				let p = try packfile.Open(pdir + "/" + n)
				layers = append(layers, p)
			}
		}
	}
	return store.NewLayered(layers)
}

// writeLoose writes a git object into the git directory's loose objects, unless the repository has it.
fn writeLoose(target Repo, kind object.Kind, body str) !str {
	let id = IdOf(kind, body)
	if target.Has(id) {
		return id
	}
	let h = Hex(id)
	let dir = target.CommonDir + "/objects/" + h[0:2]
	try quarry.MkdirAll(dir)
	let tmp = dir + "/tmp-" + seal.Hex(seal.RandomBytes(8))
	mut w = try flume.CreateExcl(tmp)
	w.Str(squash.Zlib(kindName(kind) + " {len(body)}\x00" + body, 6))
	try w.Close()
	try quarry.Rename(tmp, dir + "/" + h[2:])
	return id
}

// Back maps tit ids to git ids (raw bytes), the other way round from Ids.
type Back struct {
	tit map[str]str
}

// BackOf is the reverse of ids.
fn BackOf(ids Ids) Back {
	mut b = Back{tit: map[str]str{}}
	let (gs, ts) = ids.Pairs()
	for i in 0..len(gs) {
		b.tit[ts[i]] = gs[i]
	}
	return b
}

// Git is the git id a tit object was written as, or "".
fn (b Back) Git(titId str) str {
	let (g, ok) = b.tit[titId]
	if !ok {
		return ""
	}
	return g
}

// Set records that a tit object was written as a git object.
fn (b mut Back) Set(titId str, gitId str) {
	b.tit[titId] = gitId
}

// written is the git id of a tit object that has one and that the target holds, or "".
fn written(target Repo, known Back, local Back, titId str) str {
	mut g = local.Git(titId)
	if len(g) > 0 {
		return g
	}
	g = known.Git(titId)
	if len(g) > 0 && target.Has(g) {
		return g
	}
	return ""
}

// MirrorPlan lists the commits and tags tips (tit ids) reach that the git directory does not hold yet, each after
// what it needs.
fn MirrorPlan[S store.ObjectStore](s mut S, target Repo, back Back, tips []object.Id) ![]object.Id {
	let none = Back{tit: map[str]str{}}
	mut order = []object.Id{}
	mut placed = map[str]bool{}
	mut opened = map[str]bool{}
	mut stack = []object.Id{}
	for t in tips {
		stack = append(stack, t)
	}
	for len(stack) > 0 {
		let id = stack[len(stack) - 1]
		let (_, done) = placed[id.Bytes()]
		if done || len(written(target, back, none, id.Bytes())) > 0 {
			stack = stack[0:len(stack) - 1]
			continue
		}
		let (_, open) = opened[id.Bytes()]
		if open {
			placed[id.Bytes()] = true
			order = append(order, id)
			stack = stack[0:len(stack) - 1]
			continue
		}
		opened[id.Bytes()] = true
		let o = try s.Get(id)
		match o {
			Commit(c) => {
				for p in c.Parents {
					stack = append(stack, p)
				}
			}
			Tag(t) => {
				stack = append(stack, t.Object)
			}
			Tree(_) => {
			}
			Blob(_) => {
			}
		}
	}
	return order
}

// MirrorBatch writes the plan's objects from start on, about budget bytes of them, into the git directory gitDir,
// reading the tit repository in titDir. Run it in an arena: only the pairs of ids (Batch.Git and Batch.Tit) leave it.
fn MirrorBatch(titDir str, gitDir str, known Back, order []object.Id, start i64, budget i64) !Batch {
	mut s = try titStore(titDir)
	let target = try Open(gitDir)
	mut local = Back{tit: map[str]str{}}
	mut size = 0
	mut k = start
	for k < len(order) && (k == start || size < budget) {
		size += try mirrorOne(mut s, target, known, mut local, order[k])
		k += 1
	}
	mut gs = []str{}
	mut ts = []str{}
	for t, g in local.tit {
		ts = append(ts, t)
		gs = append(gs, g)
	}
	return Batch{Git: gs, Tit: ts, Next: k, Pack: "", Parts: make([]str, 3)}
}

// commitBody is a tit commit in git's format: an adopted commit as it was (its change id comes from that git id),
// one made in tit in the fixed encoding.
fn commitBody(c object.CommitData, tree str, parents []str) str {
	let asIs = GitCommitBody(c, tree, parents)
	if object.AdoptedChangeId(Hex(IdOf(object.Kind.Commit, asIs))) == c.Change {
		return asIs
	}
	let plain = object.CommitData{Tree: c.Tree, Parents: c.Parents, Change: c.Change, Author: c.Author, Committer: c.Committer, GitHeaders: []str{}, Signature: "", Message: MirrorMessage(c.Message, c.Change.Letters()), Conflicts: []str{}}
	return GitCommitBody(plain, tree, parents)
}

fn mirrorOne(s mut store.Layered, target Repo, known Back, local mut Back, id object.Id) !i64 {
	let o = try s.Get(id)
	match o {
		Commit(c) => {
			if len(c.Conflicts) > 0 {
				fail fault.Wrap(ErrBadObject, "{id.Hex()[0:12]} records conflicts: resolve them (tit edit) before mirroring")
			}
			let (tree, n) = try mirrorTree(mut s, target, known, mut local, c.Tree)
			mut parents = []str{}
			for p in c.Parents {
				let g = written(target, known, local, p.Bytes())
				if len(g) == 0 {
					fail fault.Wrap(ErrMissing, "{id.Hex()}'s parent {p.Hex()} has no git id")
				}
				parents = append(parents, g)
			}
			let body = commitBody(c, tree, parents)
			let g = try writeLoose(target, object.Kind.Commit, body)
			let was = known.Git(id.Bytes())
			if len(was) > 0 && was != g {
				fail fault.Wrap(ErrBadObject, "{id.Hex()} was git {Hex(was)} and now writes as {Hex(g)}")
			}
			local.Set(id.Bytes(), g)
			return n + len(body)
		}
		Tag(t) => {
			let g = written(target, known, local, t.Object.Bytes())
			if len(g) == 0 {
				fail fault.Wrap(ErrMissing, "tag {t.Name}'s object has no git id")
			}
			let body = "object " + Hex(g) + "\ntype " + kindName(t.Kind) + "\ntag " + t.Name + "\ntagger " + PersonText(t.Tagger) + "\n\n" + t.Message
			let tg = try writeLoose(target, object.Kind.Tag, body)
			local.Set(id.Bytes(), tg)
			return len(body)
		}
		Tree(_) => {
			let (_, n) = try mirrorTree(mut s, target, known, mut local, id)
			return n
		}
		Blob(_) => {
			let (_, body) = try s.GetRaw(id)
			let g = try writeLoose(target, object.Kind.Blob, body)
			local.Set(id.Bytes(), g)
			return len(body)
		}
	}
}

// mirrorTree writes a tree and what it holds that the git directory lacks; it gives the tree's git id and the bytes
// it read.
fn mirrorTree(s mut store.Layered, target Repo, known Back, local mut Back, id object.Id) !(str, i64) {
	let have = written(target, known, local, id.Bytes())
	if len(have) > 0 {
		return have, 0
	}
	let o = try s.Get(id)
	mut body = make([]u8, 0, 512)
	mut n = 0
	match o {
		Tree(es) => {
			for e in es {
				mut child = written(target, known, local, e.Id.Bytes())
				if len(child) == 0 {
					if e.Mode == object.Mode.Dir {
						let (g, m) = try mirrorTree(mut s, target, known, mut local, e.Id)
						child = g
						n += m
					} else {
						let (_, b) = try s.GetRaw(e.Id)
						child = try writeLoose(target, object.Kind.Blob, b)
						local.Set(e.Id.Bytes(), child)
						n += len(b)
					}
				}
				body = append(body, []u8(gitMode(e.Mode) + " " + e.Name)...)
				body = append(body, 0)
				body = append(body, []u8(child)...)
			}
		}
		Commit(_) => {
			fail fault.Wrap(ErrBadObject, "{id.Hex()} is not a tree")
		}
		Tag(_) => {
			fail fault.Wrap(ErrBadObject, "{id.Hex()} is not a tree")
		}
		Blob(_) => {
			fail fault.Wrap(ErrBadObject, "{id.Hex()} is not a tree")
		}
	}
	let g = try writeLoose(target, object.Kind.Tree, str(body))
	local.Set(id.Bytes(), g)
	return g, n + len(body)
}

// WriteRef points a ref of the git directory at a git id (a loose ref file, written by temporary file and rename).
fn WriteRef(gitDir str, name str, id str) ! {
	let target = try Open(gitDir)
	let path = target.CommonDir + "/" + name
	let slash = twine.LastIndex(path, "/")
	try quarry.MkdirAll(path[0:slash])
	let tmp = path + ".tmp"
	if quarry.Exists(tmp) {
		try quarry.Remove(tmp)
	}
	mut w = try flume.CreateExcl(tmp)
	w.Str(Hex(id) + "\n")
	try w.Close()
	try quarry.Rename(tmp, path)
}

// PointHead points the git directory's HEAD at branch when it names a branch the directory does not have (as a new
// bare repository's HEAD does), so a clone checks out what tit has checked out.
fn PointHead(gitDir str, branch str) ! {
	let target = try Open(gitDir)
	let (name, id) = try target.Head()
	if len(id) > 0 || len(name) == 0 {
		return
	}
	let path = target.GitDir + "/HEAD"
	let tmp = path + ".tmp"
	if quarry.Exists(tmp) {
		try quarry.Remove(tmp)
	}
	mut w = try flume.CreateExcl(tmp)
	w.Str("ref: " + branch + "\n")
	try w.Close()
	try quarry.Rename(tmp, path)
}
