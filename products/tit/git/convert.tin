package git

import "../object"
import "../packfile"
import "../store"
import "fault"
import "quarry"
import "twine"

// Converting git objects to tit's (#789), bottom up: blobs as they are, trees with tit ids, commits with tit parents,
// a change id derived from the git id and git's extra headers (gpgsig, encoding, mergetag) kept; adopted commits are
// unsigned. The same git history always gives the same tit ids.
//
// The work goes in batches: each batch converts commits (with their trees and blobs) into memory until it holds
// about a budget of bytes, writes them as one tit pack, verifies the pack, and gives back only the pairs of ids, so
// memory stays flat however long the history. Every tree, commit and tag is checked as it is made: decoded back from
// its tit encoding and written in git's format again, it must hash to the git id it came from.

// Ids maps git ids to tit ids (both raw bytes).
type Ids struct {
	git map[str]str
}

// NewIds is an empty map.
fn NewIds() Ids {
	return Ids{git: map[str]str{}}
}

// Tit is the tit id of a git object, or "" when it has not been converted.
fn (m Ids) Tit(gitId str) str {
	let (t, ok) = m.git[gitId]
	if !ok {
		return ""
	}
	return t
}

// Set records that a git object became a tit object.
fn (m mut Ids) Set(gitId str, titId str) {
	m.git[gitId] = titId
}

// Len is the number of objects in the map.
fn (m Ids) Len() i64 {
	return len(m.git)
}

// Pairs is every (git id, tit id), in no order.
fn (m Ids) Pairs() ([]str, []str) {
	mut gs = []str{}
	mut ts = []str{}
	for g, t in m.git {
		gs = append(gs, g)
		ts = append(ts, t)
	}
	return gs, ts
}

// Entry is one entry of a git tree.
type Entry struct {
	Mode str
	Name str
	Id   str
}

// ParseTree reads a git tree's entries: "<mode> <name>\0<20-byte id>" each.
fn ParseTree(body str) ![]Entry {
	mut out = []Entry{}
	mut i = 0
	for i < len(body) {
		let sp = twine.IndexByte(body[i:], ' ')
		if sp <= 0 {
			fail fault.Wrap(ErrBadObject, "tree: an entry without a mode")
		}
		let nul = twine.IndexByte(body[i + sp:], 0)
		if nul < 0 || i + sp + nul + 21 > len(body) {
			fail fault.Wrap(ErrBadObject, "tree: an entry cut off")
		}
		let mode = body[i:i + sp]
		let name = body[i + sp + 1:i + sp + nul]
		let at = i + sp + nul + 1
		out = append(out, Entry{Mode: mode, Name: name, Id: body[at:at + 20]})
		i = at + 20
	}
	return out
}

// Commit is a parsed git commit.
type Commit struct {
	Tree      str
	Parents   []str
	Author    str
	Committer str
	Headers   []str
	Message   str
}

// headerLines splits an object's text into its header lines (continuation lines joined with "\n") and its message.
fn headerLines(body str) ([]str, str) {
	mut end = twine.Index(body, "\n\n")
	mut message = ""
	if end < 0 {
		end = len(body)
		if end > 0 && body[end - 1] == '\n' {
			end -= 1
		}
	} else {
		message = body[end + 2:]
	}
	mut lines = []str{}
	for line in twine.Split(body[0:end], "\n") {
		if len(line) > 0 && line[0] == ' ' && len(lines) > 0 {
			lines[len(lines) - 1] = lines[len(lines) - 1] + "\n" + line[1:]
		} else {
			lines = append(lines, line)
		}
	}
	return lines, message
}

// ParseCommit reads a git commit.
fn ParseCommit(body str) !Commit {
	let (lines, message) = headerLines(body)
	mut c = Commit{Tree: "", Parents: []str{}, Author: "", Committer: "", Headers: []str{}, Message: message}
	for line in lines {
		if twine.HasPrefix(line, "tree ") {
			c.Tree = try ParseHex(line[5:])
		} else if twine.HasPrefix(line, "parent ") {
			let p = try ParseHex(line[7:])
			c.Parents = append(c.Parents, p)
		} else if twine.HasPrefix(line, "author ") {
			c.Author = line[7:]
		} else if twine.HasPrefix(line, "committer ") {
			c.Committer = line[10:]
		} else if len(line) > 0 {
			c.Headers = append(c.Headers, line)
		}
	}
	if len(c.Tree) == 0 || len(c.Author) == 0 || len(c.Committer) == 0 {
		fail fault.Wrap(ErrBadObject, "commit: no tree, author or committer")
	}
	return c
}

// Tag is a parsed annotated git tag.
type Tag struct {
	Object  str
	Kind    str
	Name    str
	Tagger  str
	Message str
}

// ParseTag reads an annotated git tag.
fn ParseTag(body str) !Tag {
	let (lines, message) = headerLines(body)
	mut t = Tag{Object: "", Kind: "", Name: "", Tagger: "", Message: message}
	for line in lines {
		if twine.HasPrefix(line, "object ") {
			t.Object = try ParseHex(line[7:])
		} else if twine.HasPrefix(line, "type ") {
			t.Kind = line[5:]
		} else if twine.HasPrefix(line, "tag ") {
			t.Name = line[4:]
		} else if twine.HasPrefix(line, "tagger ") {
			t.Tagger = line[7:]
		}
	}
	if len(t.Object) == 0 || len(t.Kind) == 0 || len(t.Name) == 0 {
		fail fault.Wrap(ErrBadObject, "tag: no object, type or name")
	}
	return t
}

fn digits(s str) !i64 {
	if len(s) == 0 {
		fail fault.Wrap(ErrBadObject, "a number expected")
	}
	mut n = 0
	for i in 0..len(s) {
		if s[i] < '0' || s[i] > '9' {
			fail fault.Wrap(ErrBadObject, "{s} is not a number")
		}
		n = n * 10 + i64(s[i] - '0')
	}
	return n
}

// ParsePerson reads "<name> <<email>> <unix seconds> <+hhmm|-hhmm>".
fn ParsePerson(s str) !object.Person {
	let lt = twine.IndexByte(s, '<')
	let gt = twine.LastIndex(s, ">")
	if lt < 0 || gt < lt {
		fail fault.Wrap(ErrBadObject, "person {s}")
	}
	let name = twine.TrimSpace(s[0:lt])
	let email = s[lt + 1:gt]
	let rest = twine.Split(twine.TrimSpace(s[gt + 1:]), " ")
	if len(rest) != 2 || len(rest[1]) != 5 || (rest[1][0] != '+' && rest[1][0] != '-') {
		fail fault.Wrap(ErrBadObject, "person {s}: no time")
	}
	let when = try digits(rest[0])
	let hh = try digits(rest[1][1:3])
	let mm = try digits(rest[1][3:5])
	mut zone = hh * 60 + mm
	if rest[1][0] == '-' {
		zone = -zone
	}
	return object.Person{Name: name, Email: email, When: when, Zone: zone}
}

fn modeOf(m str, path str) !object.Mode {
	if m == "40000" || m == "040000" {
		return object.Mode.Dir
	}
	if m == "100755" {
		return object.Mode.Exec
	}
	if m == "120000" {
		return object.Mode.Link
	}
	if m == "160000" {
		fail fault.Wrap(ErrBadObject, "{path} is a submodule, which tit does not take")
	}
	if twine.HasPrefix(m, "100") {
		return object.Mode.File
	}
	fail fault.Wrap(ErrBadObject, "{path}: mode {m}")
}

// Batch is what one batch converted: the git ids, their tit ids, where the next batch starts and the pack written.
type Batch struct {
	Git  []str
	Tit  []str
	Next i64
	Pack str
}

// deps is what a commit or tag needs converted first: its parents, or its object; nothing for a tree or a blob.
fn deps(r Repo, id str) ![]str {
	let (kind, body) = try r.Read(id)
	match kind {
		Commit => {
			let c = ParseCommit(body) catch e {
				fail fault.Wrap(ErrBadObject, "commit {Hex(id)}: {fault.Message(e)}")
			}
			return c.Parents
		}
		Tag => {
			let t = ParseTag(body) catch e {
				fail fault.Wrap(ErrBadObject, "tag {Hex(id)}: {fault.Message(e)}")
			}
			return []str{t.Object}
		}
		Tree, Blob => {
			return []str{}
		}
	}
}

// Plan lists what tips reach that ids lacks, commits and tags each after what it needs (parents before children, a
// tag after its object), with an explicit stack: histories are deeper than a call stack should be.
fn Plan(r Repo, ids Ids, tips []str) ![]str {
	mut order = []str{}
	mut placed = map[str]bool{}
	mut opened = map[str]bool{}
	mut stack = []str{}
	for t in tips {
		stack = append(stack, t)
	}
	for len(stack) > 0 {
		let id = stack[len(stack) - 1]
		let (_, done) = placed[id]
		if done || len(ids.Tit(id)) > 0 {
			stack = stack[0:len(stack) - 1]
			continue
		}
		let (_, open) = opened[id]
		if open {
			placed[id] = true
			order = append(order, id)
			stack = stack[0:len(stack) - 1]
			continue
		}
		opened[id] = true
		let ds = try arena {
			try deps(r, id)
		}
		for d in ds {
			let (_, dd) = placed[d]
			if !dd && len(ids.Tit(d)) == 0 {
				stack = append(stack, d)
			}
		}
	}
	return order
}

// Convert brings everything tips reach (commits, tags, trees, blobs) that ids lacks into tit packs in packDir, a
// batch of about budget bytes at a time; after each batch it adds the batch's pairs to ids and writes the git-ids
// table to idsPath, so an interrupted run picks up after its last finished batch. It returns the number of objects
// converted; ReadIds reads the table. (A caller that shows progress runs Plan, then ConvertBatch and WriteIds in its
// own loop.)
fn Convert(r Repo, packDir str, idsPath str, ids Ids, tips []str, budget i64) !i64 {
	mut all = NewIds()
	let (gs0, ts0) = ids.Pairs()
	for k in 0..len(gs0) {
		all.Set(gs0[k], ts0[k])
	}
	let order = try Plan(r, all, tips)
	try quarry.MkdirAll(packDir)
	mut i = 0
	for i < len(order) {
		let start = i
		let b = try arena {
			try ConvertBatch(r, packDir, all, order, start, budget)
		}
		for k in 0..len(b.Git) {
			all.Set(b.Git[k], b.Tit[k])
		}
		// the table is built whole each time: in an arena, so batches do not pile copies of it up
		_ = try arena {
			try WriteIds(idsPath, all)
			0
		}
		i = b.Next
	}
	return all.Len() - ids.Len()
}

// lookup is the tit id of a git object converted before this batch or in it.
fn lookup(known Ids, local Ids, id str) str {
	let t = local.Tit(id)
	if len(t) > 0 {
		return t
	}
	return known.Tit(id)
}

// ConvertBatch converts the plan from start on, about budget bytes of it, into one pack in packDir, and verifies the
// pack. Run it in an arena: only the Batch need outlive it.
fn ConvertBatch(r Repo, packDir str, known Ids, order []str, start i64, budget i64) !Batch {
	mut mem = store.NewMem()
	mut local = NewIds()
	mut size = 0
	mut k = start
	for k < len(order) && (k == start || size < budget) {
		size += try convertOne(r, mut mem, known, mut local, order[k])
		k += 1
	}
	let (gs, ts) = local.Pairs()
	mut out = Batch{Git: gs, Tit: ts, Next: k, Pack: ""}
	if len(ts) > 0 {
		// commits and tags in a pack of their own, trees in another, blobs in a third: a log then reads only the
		// first, a checkout the second and what it writes (a pack is read whole the first time one of its objects is)
		mut commits = []object.Id{}
		mut trees = []object.Id{}
		mut blobs = []object.Id{}
		for t in ts {
			let id = try object.IdOf(t)
			let (kind, _) = try mem.GetRaw(id)
			match kind {
				Commit, Tag => {
					commits = append(commits, id)
				}
				Tree => {
					trees = append(trees, id)
				}
				Blob => {
					blobs = append(blobs, id)
				}
			}
		}
		for part in [][]object.Id{commits, trees, blobs} {
			if len(part) > 0 {
				mut p = try packfile.Write(mut mem, part, packDir)
				try p.Verify()
				out.Pack = p.Path
			}
		}
	}
	return out
}

// convertOne converts a commit, tag, tree or blob of the plan into mem, and gives the bytes it added.
fn convertOne(r Repo, mem mut store.Mem, known Ids, local mut Ids, id str) !i64 {
	let (kind, body) = try r.Read(id)
	match kind {
		Commit => {
			let c = ParseCommit(body) catch e {
				fail fault.Wrap(ErrBadObject, "commit {Hex(id)}: {fault.Message(e)}")
			}
			let n = try convertTree(r, mut mem, known, mut local, c.Tree, "")
			try convertCommit(mut mem, known, mut local, id, c)
			return n + len(body)
		}
		Tag => {
			let t = ParseTag(body) catch e {
				fail fault.Wrap(ErrBadObject, "tag {Hex(id)}: {fault.Message(e)}")
			}
			try convertTag(mut mem, known, mut local, id, t)
			return len(body)
		}
		Tree => {
			return try convertTree(r, mut mem, known, mut local, id, "")
		}
		Blob => {
			let t = try mem.PutRaw(object.Kind.Blob, body)
			local.Set(id, t.Bytes())
			return len(body)
		}
	}
}

// blobOf reads a blob in an arena of its own: the inflated deltas behind it are dropped, its body is copied out.
fn blobOf(r Repo, id str, path str) !str {
	return try arena {
		let (kind, body) = try r.Read(id)
		if kind != object.Kind.Blob {
			fail fault.Wrap(ErrBadObject, "{path} ({Hex(id)}) is not a blob")
		}
		body
	}
}

// convertTree converts a tree and what it holds that is not converted yet, and gives the bytes it added.
fn convertTree(r Repo, mem mut store.Mem, known Ids, local mut Ids, id str, path str) !i64 {
	if len(lookup(known, local, id)) > 0 {
		return 0
	}
	let es = try arena {
		let (kind, body) = try r.Read(id)
		if kind != object.Kind.Tree {
			fail fault.Wrap(ErrBadObject, "{Hex(id)} at {path}/ is not a tree")
		}
		ParseTree(body) catch e {
			fail fault.Wrap(ErrBadObject, "tree {Hex(id)} at {path}/: {fault.Message(e)}")
		}
	}
	mut added = 0
	mut out = []object.Entry{}
	mut gitBody = make([]u8, 0, 64 * len(es))
	for e in es {
		let p = path + "/" + e.Name
		let mode = try modeOf(e.Mode, p)
		if len(lookup(known, local, e.Id)) == 0 {
			if mode == object.Mode.Dir {
				added += try convertTree(r, mut mem, known, mut local, e.Id, p)
			} else {
				let body = try blobOf(r, e.Id, p)
				let t = try mem.PutRaw(object.Kind.Blob, body)
				local.Set(e.Id, t.Bytes())
				added += len(body)
			}
		}
		let cid = try object.IdOf(lookup(known, local, e.Id))
		out = append(out, object.Entry{Mode: mode, Name: e.Name, Id: cid})
	}
	let t = mem.Put(object.Object.Tree(out)) catch e {
		fail fault.Wrap(ErrBadObject, "tree {Hex(id)} at {path}/: {fault.Message(e)}")
	}
	// back again: the tit tree, decoded and written as git writes trees, with each entry's git id
	let back = try mem.Get(t)
	match back {
		Tree(bes) => {
			if len(bes) != len(es) {
				fail fault.Wrap(ErrBadObject, "tree {Hex(id)} at {path}/: {len(bes)} entries, not {len(es)}")
			}
			for i in 0..len(bes) {
				gitBody = append(gitBody, []u8(gitMode(bes[i].Mode) + " " + bes[i].Name)...)
				gitBody = append(gitBody, 0)
				gitBody = append(gitBody, []u8(es[i].Id)...)
			}
		}
		Commit(_) => {
			fail fault.Wrap(ErrBadObject, "tree {Hex(id)}: did not decode as a tree")
		}
		Tag(_) => {
			fail fault.Wrap(ErrBadObject, "tree {Hex(id)}: did not decode as a tree")
		}
		Blob(_) => {
			fail fault.Wrap(ErrBadObject, "tree {Hex(id)}: did not decode as a tree")
		}
	}
	if IdOf(object.Kind.Tree, str(gitBody)) != id {
		fail fault.Wrap(ErrBadObject, "tree {Hex(id)} at {path}/ does not convert back to itself (an unusual mode or order?)")
	}
	local.Set(id, t.Bytes())
	return added + len(gitBody)
}

fn convertCommit(mem mut store.Mem, known Ids, local mut Ids, id str, c Commit) ! {
	let tree = try object.IdOf(lookup(known, local, c.Tree))
	mut parents = []object.Id{}
	for p in c.Parents {
		let pid = try object.IdOf(lookup(known, local, p))
		parents = append(parents, pid)
	}
	let author = ParsePerson(c.Author) catch e {
		fail fault.Wrap(ErrBadObject, "commit {Hex(id)}: {fault.Message(e)}")
	}
	let committer = ParsePerson(c.Committer) catch e {
		fail fault.Wrap(ErrBadObject, "commit {Hex(id)}: {fault.Message(e)}")
	}
	let data = object.CommitData{Tree: tree, Parents: parents, Change: object.AdoptedChangeId(Hex(id)), Author: author, Committer: committer, GitHeaders: c.Headers, Signature: "", Message: c.Message, Conflicts: []str{}}
	let t = mem.Put(object.Object.Commit(data)) catch e {
		fail fault.Wrap(ErrBadObject, "commit {Hex(id)}: {fault.Message(e)}")
	}
	let back = try mem.Get(t)
	match back {
		Commit(cd) => {
			if IdOf(object.Kind.Commit, GitCommitBody(cd, c.Tree, c.Parents)) != id {
				fail fault.Wrap(ErrBadObject, "commit {Hex(id)} does not convert back to itself")
			}
		}
		Tree(_) => {
			fail fault.Wrap(ErrBadObject, "commit {Hex(id)}: did not decode as a commit")
		}
		Tag(_) => {
			fail fault.Wrap(ErrBadObject, "commit {Hex(id)}: did not decode as a commit")
		}
		Blob(_) => {
			fail fault.Wrap(ErrBadObject, "commit {Hex(id)}: did not decode as a commit")
		}
	}
	local.Set(id, t.Bytes())
}

fn convertTag(mem mut store.Mem, known Ids, local mut Ids, id str, t Tag) ! {
	let kind = try kindOf(t.Kind)
	let target = try object.IdOf(lookup(known, local, t.Object))
	mut tagger = object.Person{Name: "unknown", Email: "unknown", When: 0, Zone: 0}
	if len(t.Tagger) > 0 {
		tagger = ParsePerson(t.Tagger) catch e {
			fail fault.Wrap(ErrBadObject, "tag {Hex(id)}: {fault.Message(e)}")
		}
	}
	let data = object.TagData{Object: target, Kind: kind, Name: t.Name, Tagger: tagger, Signature: "", Message: t.Message}
	let tid = mem.Put(object.Object.Tag(data)) catch e {
		fail fault.Wrap(ErrBadObject, "tag {Hex(id)}: {fault.Message(e)}")
	}
	if len(t.Tagger) > 0 {
		let back = try mem.Get(tid)
		match back {
			Tag(td) => {
				let body = "object " + Hex(t.Object) + "\ntype " + t.Kind + "\ntag " + td.Name + "\ntagger " + PersonText(td.Tagger) + "\n\n" + td.Message
				if IdOf(object.Kind.Tag, body) != id {
					fail fault.Wrap(ErrBadObject, "tag {Hex(id)} does not convert back to itself")
				}
			}
			Tree(_) => {
				fail fault.Wrap(ErrBadObject, "tag {Hex(id)}: did not decode as a tag")
			}
			Commit(_) => {
				fail fault.Wrap(ErrBadObject, "tag {Hex(id)}: did not decode as a tag")
			}
			Blob(_) => {
				fail fault.Wrap(ErrBadObject, "tag {Hex(id)}: did not decode as a tag")
			}
		}
	}
	local.Set(id, tid.Bytes())
}
