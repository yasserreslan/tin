package git

import "fault"
import "flume"
import "pack"
import "quarry"
import "seal"
import "sift"

// The git-ids table (design/tit.md section 7): "TITGIDS\0", u32 version 1, u64 count, then count (20-byte git id,
// 32-byte tit id) pairs sorted by git id, count u32 positions into them sorted by tit id, and the SHA-256 of all of
// that. It is rewritten whole, by temporary file, sync and rename.

fn putU32(out mut []u8, v i64) {
	out = append(out, u8(v & 0xff), u8((v >> 8) & 0xff), u8((v >> 16) & 0xff), u8((v >> 24) & 0xff))
}

fn putU64(out mut []u8, v i64) {
	putU32(mut out, v & 0xffffffff)
	putU32(mut out, (v >> 32) & 0xffffffff)
}

// WriteIds writes the table to path.
fn WriteIds(path str, ids Ids) ! {
	let (gs, ts) = ids.Pairs()
	mut byGit = make([]i64, len(gs))
	for i in 0..len(gs) {
		byGit[i] = i
	}
	sift.SortFunc(mut byGit, fn(a i64, b i64) i64 {
		if gs[a] < gs[b] {
			return -1
		}
		if gs[a] > gs[b] {
			return 1
		}
		return 0
	})
	mut byTit = make([]i64, len(gs))
	for i in 0..len(gs) {
		byTit[i] = i
	}
	// positions into the git-sorted list, ordered by tit id
	mut rank = make([]i64, len(gs))
	for k in 0..len(byGit) {
		rank[byGit[k]] = k
	}
	sift.SortFunc(mut byTit, fn(a i64, b i64) i64 {
		if ts[a] < ts[b] {
			return -1
		}
		if ts[a] > ts[b] {
			return 1
		}
		return 0
	})
	mut out = make([]u8, 0, 20 + len(gs) * 56 + 32)
	out = append(out, []u8("TITGIDS\x00")...)
	putU32(mut out, 1)
	putU64(mut out, len(gs))
	for k in byGit {
		out = append(out, []u8(gs[k])...)
		out = append(out, []u8(ts[k])...)
	}
	for k in byTit {
		putU32(mut out, rank[k])
	}
	let sum = seal.Sha256(str(out))
	out = append(out, sum...)
	let tmp = path + ".tmp"
	if quarry.Exists(tmp) {
		try quarry.Remove(tmp)
	}
	mut w = try flume.CreateExcl(tmp)
	w.Str(str(out))
	let err = w.Sync()
	try w.Close()
	if err != nil {
		fail err
	}
	try quarry.Rename(tmp, path)
}

// ReadIds reads the table at path; a missing table is an empty one.
fn ReadIds(path str) !Ids {
	mut ids = NewIds()
	if !quarry.Exists(path) {
		return ids
	}
	let t = try flume.ReadFile(path)
	if len(t) < 52 || t[0:8] != "TITGIDS\x00" {
		fail fault.Wrap(ErrBadObject, "{path}: not a git-ids table")
	}
	let count = i64(pack.LE.U64([]u8(t[12:20])))
	if count < 0 || 20 + count * 56 + 32 != len(t) {
		fail fault.Wrap(ErrBadObject, "{path}: cut off")
	}
	if str(seal.Sha256(t[0:len(t) - 32])) != t[len(t) - 32:] {
		fail fault.Wrap(ErrBadObject, "{path}: its checksum does not match")
	}
	for i in 0..count {
		let at = 20 + 52 * i
		ids.Set(t[at:at + 20], t[at + 20:at + 52])
	}
	return ids
}
