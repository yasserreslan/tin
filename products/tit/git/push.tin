package git

import "fault"
import "seal"
import "squash"
import "twine"
import "wire"

// Pushing over git's smart HTTP protocol (#805): what tit mirror wrote into its local git directory goes to a git
// server (GitHub) as `git push` sends it. The server's refs come from GET info/refs?service=git-receive-pack; the
// objects the new tips reach and its tips do not go in one pack (version 2, whole objects, zlib); the ref commands
// and the pack go in one POST to git-receive-pack, and its report-status says whether each ref moved. One way only:
// nothing is read from the server but its refs.

// ErrPush is the fault of a push the server refused.
let ErrPush = fault("the git server refused the push")

// RefPush is a ref a push sets: its name and the git id (raw) it is to hold.
type RefPush struct {
	Name str
	New  str
}

let zeroId = "0000000000000000000000000000000000000000"

// pktLine is s as a pkt-line: four hex digits of its length (them included), then s.
fn pktLine(s str) str {
	let n = len(s) + 4
	let hex = "0123456789abcdef"
	mut h = []u8{}
	for k in 0..4 {
		h = append(h, hex[(n >> (4 * (3 - k))) & 15])
	}
	return str(h) + s
}

// pktLines are the pkt-lines at the start of data, "" for each flush, and where they stopped (at a flush when
// toFlush, after which the rest is not pkt-lines).
fn pktLines(data str, flushes i64) !([]str, i64) {
	mut out = []str{}
	mut at = 0
	mut seen = 0
	for at + 4 <= len(data) && seen < flushes {
		let n = parseHex4(data[at:at + 4])
		if n < 0 {
			fail fault.Wrap(ErrPush, "a damaged pkt-line at {at}")
		}
		if n == 0 {
			out = append(out, "")
			at += 4
			seen += 1
			continue
		}
		if n < 4 || at + n > len(data) {
			fail fault.Wrap(ErrPush, "a pkt-line runs past the answer at {at}")
		}
		out = append(out, data[at + 4:at + n])
		at += n
	}
	return out, at
}

fn parseHex4(s str) i64 {
	mut v = 0
	for i in 0..4 {
		let c = s[i]
		mut d = -1
		if c >= '0' && c <= '9' {
			d = i64(c - '0')
		} else if c >= 'a' && c <= 'f' {
			d = i64(c - 'a') + 10
		} else if c >= 'A' && c <= 'F' {
			d = i64(c - 'A') + 10
		}
		if d < 0 {
			return -1
		}
		v = v * 16 + d
	}
	return v
}

// remoteRefs are the server's refs (name to 40 hex digits) from its receive-pack advertisement.
fn remoteRefs(url str, headers []str) !map[str]str {
	let r = try wire.DoWith("GET", url + "/info/refs?service=git-receive-pack", headers, "", wire.Options{Timeout: 120 * 1000000000, MaxBody: 256 << 20, MaxIdle: 0})
	if r.Status == 401 || r.Status == 403 {
		fail fault.Wrap(ErrPush, "{url}: {r.Status}: the server wants credentials (TIT_MIRROR_TOKEN)")
	}
	if r.Status != 200 {
		fail fault.Wrap(ErrPush, "{url}: {r.Status} for its refs (is it a git repository over smart HTTP?)")
	}
	let (lines, _) = try pktLines(r.Body, 2)
	mut out = map[str]str{}
	for line in lines {
		if len(line) == 0 || twine.HasPrefix(line, "# service=") {
			continue
		}
		mut l = twine.TrimRight(line, "\n")
		let nul = twine.IndexByte(l, 0)
		if nul >= 0 {
			l = l[0:nul]
		}
		let sp = twine.IndexByte(l, ' ')
		if sp != 40 {
			continue
		}
		let name = l[41:]
		if l[0:40] != zeroId && name != "capabilities^{{}}" {
			out[name] = l[0:40]
		}
	}
	return out
}

// reach adds to out every object the roots reach that is not in stop, once (git ids, raw).
fn reach(local Repo, roots []str, stop map[str]bool, seen mut map[str]bool, out mut []str) ! {
	mut todo = []str{}
	for r in roots {
		todo = append(todo, r)
	}
	for len(todo) > 0 {
		let id = todo[len(todo) - 1]
		todo = todo[0:len(todo) - 1]
		let (s1, _) = seen[id]
		let (s2, _) = stop[id]
		if s1 || s2 {
			continue
		}
		seen[id] = true
		let (kind, body) = try local.Read(id)
		out = append(out, id)
		match kind {
			Commit => {
				let c = try ParseCommit(body)
				todo = append(todo, c.Tree)
				for p in c.Parents {
					todo = append(todo, p)
				}
			}
			Tree => {
				let es = try ParseTree(body)
				for e in es {
					// a submodule's commit is not in this repository
					if e.Mode != "160000" {
						todo = append(todo, e.Id)
					}
				}
			}
			Tag => {
				let t = try ParseTag(body)
				todo = append(todo, t.Object)
			}
			Blob => {
			}
		}
	}
}

// gitPack is a version 2 git pack of these objects, each whole.
fn gitPack(local Repo, ids []str) !str {
	mut out = []u8{}
	appendText(mut out, "PACK")
	appendBE32(mut out, 2)
	appendBE32(mut out, len(ids))
	for id in ids {
		let (kind, body) = try local.Read(id)
		mut t = 3
		match kind {
			Commit => {
				t = 1
			}
			Tree => {
				t = 2
			}
			Blob => {
				t = 3
			}
			Tag => {
				t = 4
			}
		}
		// the type and size: 3 bits of type and 4 of size, then 7 bits a byte, low first
		mut size = len(body)
		mut b = (t << 4) | (size & 15)
		size = size >> 4
		for size > 0 {
			out = append(out, u8(b | 0x80))
			b = size & 0x7f
			size = size >> 7
		}
		out = append(out, u8(b))
		let z = arena {
			squash.Zlib(body, 6)
		}
		appendText(mut out, z)
	}
	appendText(mut out, str(seal.Sha1(str(out))))
	return str(out)
}

fn appendText(out mut []u8, s str) {
	for i in 0..len(s) {
		out = append(out, s[i])
	}
}

fn appendBE32(out mut []u8, v i64) {
	out = append(out, u8((v >> 24) & 255), u8((v >> 16) & 255), u8((v >> 8) & 255), u8(v & 255))
}

// PushHttp sets the refs on the git server at url (https://github.com/owner/repo.git) from the git directory local,
// sending what the server lacks. token, when not "", goes as HTTP basic credentials (GitHub: a token as the password).
// It gives how many refs moved and how many objects went.
fn PushHttp(local Repo, url str, token str, refs []RefPush) !(i64, i64) {
	mut base = url
	for twine.HasSuffix(base, "/") {
		base = base[0:len(base) - 1]
	}
	mut headers = []str{"User-Agent", "git/2.45.0 (tit)"}
	if len(token) > 0 {
		headers = append(headers, "Authorization", "Basic " + seal.B64([]u8("x-access-token:" + token)))
	}
	let remote = try remoteRefs(base, headers)
	mut commands = []str{}
	mut tips = []str{}
	for r in refs {
		let (old, had) = remote[r.Name]
		mut oldHex = zeroId
		if had {
			oldHex = old
		}
		let newHex = Hex(r.New)
		if oldHex == newHex {
			continue
		}
		commands = append(commands, oldHex + " " + newHex + " " + r.Name)
		tips = append(tips, r.New)
	}
	if len(commands) == 0 {
		return 0, 0
	}
	// what the server has: everything its tips reach, when this repository has them
	mut stop = map[str]bool{}
	mut haveRoots = []str{}
	for _, h in remote {
		let id = ParseHex(h) catch _ {
			continue
		}
		if local.Has(id) {
			haveRoots = append(haveRoots, id)
		}
	}
	mut had = []str{}
	try reach(local, haveRoots, map[str]bool{}, mut stop, mut had)
	mut seen = map[str]bool{}
	mut send = []str{}
	try reach(local, tips, stop, mut seen, mut send)
	let pack = try gitPack(local, send)
	mut body = ""
	for i in 0..len(commands) {
		if i == 0 {
			body = body + pktLine(commands[i] + "\x00report-status agent=tit\n")
		} else {
			body = body + pktLine(commands[i] + "\n")
		}
	}
	body = body + "0000" + pack
	mut post = []str{"Content-Type", "application/x-git-receive-pack-request", "Accept", "application/x-git-receive-pack-result"}
	for h in headers {
		post = append(post, h)
	}
	let r = try wire.DoWith("POST", base + "/git-receive-pack", post, body, wire.Options{Timeout: 600 * 1000000000, MaxBody: 64 << 20, MaxIdle: 0})
	if r.Status != 200 {
		fail fault.Wrap(ErrPush, "{base}: {r.Status} for the push: {twine.TrimSpace(r.Body)}")
	}
	let (lines, _) = try pktLines(r.Body, 1)
	mut refused = []str{}
	mut unpacked = false
	for line in lines {
		let l = twine.TrimRight(line, "\n")
		if l == "unpack ok" {
			unpacked = true
		} else if twine.HasPrefix(l, "unpack ") {
			fail fault.Wrap(ErrPush, "{base}: the server could not unpack the objects: {l[7:]}")
		} else if twine.HasPrefix(l, "ng ") {
			refused = append(refused, l[3:])
		}
	}
	if !unpacked {
		fail fault.Wrap(ErrPush, "{base}: no report from the server")
	}
	if len(refused) > 0 {
		fail fault.Wrap(ErrPush, "{base}: " + twine.Join(refused, "; "))
	}
	return len(commands), len(send)
}
