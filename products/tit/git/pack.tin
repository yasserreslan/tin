package git

import "fault"
import "flume"
import "squash"

// Git packs: the index (version 2: a fan-out table, the sorted ids, CRCs, 4-byte offsets and 8-byte large offsets)
// and the pack's entries (a type and size header; OFS deltas name their base by a backward distance, REF deltas by
// its id; each body is one zlib stream, found with UnzlibPrefix since the pack does not store compressed lengths).

// Pack is an open git pack and its index.
type Pack struct {
	path   str
	data   str
	idx    str
	count  i64
	names  i64
	offs   i64
	large  i64
}

type entryHeader struct {
	typ    i64
	size   i64
	data   i64
	base   i64
	baseId str
}

fn be32(s str, at i64) i64 {
	return (i64(s[at]) << 24) | (i64(s[at + 1]) << 16) | (i64(s[at + 2]) << 8) | i64(s[at + 3])
}

// OpenPack opens base.idx and base.pack.
fn OpenPack(base str) !Pack {
	let idx = try flume.ReadFile(base + ".idx")
	if len(idx) < 8 + 256 * 4 || idx[0:4] != "\xfftOc" || be32(idx, 4) != 2 {
		fail fault.Wrap(ErrBadObject, "{base}.idx: not a version 2 pack index")
	}
	let count = be32(idx, 8 + 255 * 4)
	let names = 8 + 256 * 4
	let crcs = names + count * 20
	let offs = crcs + count * 4
	let large = offs + count * 4
	if large + 40 > len(idx) {
		fail fault.Wrap(ErrBadObject, "{base}.idx: cut off")
	}
	let data = try flume.ReadFile(base + ".pack")
	if len(data) < 32 || data[0:4] != "PACK" || be32(data, 8) != count {
		fail fault.Wrap(ErrBadObject, "{base}.pack: does not match its index")
	}
	return Pack{path: base + ".pack", data: data, idx: idx, count: count, names: names, offs: offs, large: large}
}

// Count is the number of objects in the pack.
fn (p Pack) Count() i64 {
	return p.count
}

// IdAt is the id of the i-th object in id order.
fn (p Pack) IdAt(i i64) str {
	return p.idx[p.names + i * 20:p.names + i * 20 + 20]
}

// Find is the offset of the object in the pack, or -1.
fn (p Pack) Find(id str) i64 {
	if len(id) != 20 {
		return -1
	}
	let first = i64(id[0])
	mut lo = 0
	if first > 0 {
		lo = be32(p.idx, 8 + (first - 1) * 4)
	}
	mut hi = be32(p.idx, 8 + first * 4)
	for lo < hi {
		let mid = (lo + hi) / 2
		let at = p.names + mid * 20
		let name = p.idx[at:at + 20]
		if name == id {
			return p.offsetAt(mid)
		}
		if name < id {
			lo = mid + 1
		} else {
			hi = mid
		}
	}
	return -1
}

fn (p Pack) offsetAt(i i64) i64 {
	let o = be32(p.idx, p.offs + i * 4)
	if o & 0x80000000 == 0 {
		return o
	}
	let k = o & 0x7fffffff
	let at = p.large + k * 8
	return (be32(p.idx, at) << 32) | be32(p.idx, at + 4)
}

// header reads the entry header at offset at.
fn (p Pack) header(at i64) !entryHeader {
	mut i = at
	if i >= len(p.data) - 20 {
		fail fault.Wrap(ErrBadObject, "{p.path}: an entry past the end")
	}
	mut c = i64(p.data[i])
	i += 1
	let typ = (c >> 4) & 7
	mut size = c & 15
	mut shift = 4
	for c & 0x80 != 0 {
		if i >= len(p.data) || shift > 60 {
			fail fault.Wrap(ErrBadObject, "{p.path}: a bad entry header at {at}")
		}
		c = i64(p.data[i])
		i += 1
		size = size | ((c & 0x7f) << shift)
		shift += 7
	}
	mut e = entryHeader{typ: typ, size: size, data: i, base: 0, baseId: ""}
	if typ == 6 {
		c = i64(p.data[i])
		i += 1
		mut off = c & 0x7f
		for c & 0x80 != 0 {
			c = i64(p.data[i])
			i += 1
			off = ((off + 1) << 7) | (c & 0x7f)
		}
		if off <= 0 || off > at {
			fail fault.Wrap(ErrBadObject, "{p.path}: a delta at {at} with its base outside the pack")
		}
		e.base = at - off
		e.data = i
	} else if typ == 7 {
		e.baseId = p.data[i:i + 20]
		e.data = i + 20
	} else if typ == 0 || typ == 5 {
		fail fault.Wrap(ErrBadObject, "{p.path}: entry type {typ} at {at}")
	}
	return e
}

// inflate is the zlib stream at offset at, which must give size bytes.
fn (p Pack) inflate(at i64, size i64) !str {
	// a slice of a str is a copy: take only what the compressed object can span (deflate never needs more than
	// 15 bits a byte, plus headers), not the rest of the pack, which made adopting a large pack quadratic
	mut end = len(p.data) - 20
	if at + 2 * size + 1024 < end {
		end = at + 2 * size + 1024
	}
	let (body, _) = squash.UnzlibPrefix(p.data[at:end], size) catch e {
		fail fault.Wrap(ErrBadObject, "{p.path} at {at}: {fault.Message(e)}")
	}
	if len(body) != size {
		fail fault.Wrap(ErrBadObject, "{p.path} at {at}: {len(body)} bytes, not {size}")
	}
	return body
}

fn deltaSize(d str, at i64) !(i64, i64) {
	mut v = 0
	mut shift = 0
	mut i = at
	for {
		if i >= len(d) || shift > 60 {
			fail fault.Wrap(ErrBadObject, "delta: a bad size")
		}
		let c = i64(d[i])
		i += 1
		v = v | ((c & 0x7f) << shift)
		shift += 7
		if c & 0x80 == 0 {
			break
		}
	}
	return v, i
}

// applyGitDelta rebuilds an object from its base and a git delta: the two sizes, then copies (high bit set: which
// offset and size bytes follow) and inserts (1 to 127 literal bytes).
fn applyGitDelta(base str, d str) !str {
	let (bsize, p1) = try deltaSize(d, 0)
	let (rsize, p2) = try deltaSize(d, p1)
	if bsize != len(base) {
		fail fault.Wrap(ErrBadObject, "delta: for a base of {bsize} bytes, not {len(base)}")
	}
	mut out = make([]u8, 0, rsize)
	mut i = p2
	for i < len(d) {
		let op = i64(d[i])
		i += 1
		if op & 0x80 != 0 {
			mut off = 0
			mut n = 0
			for k in 0..4 {
				if op & (1 << k) != 0 {
					if i >= len(d) {
						fail fault.Wrap(ErrBadObject, "delta: a copy cut off")
					}
					off = off | (i64(d[i]) << (8 * k))
					i += 1
				}
			}
			for k in 0..3 {
				if op & (0x10 << k) != 0 {
					if i >= len(d) {
						fail fault.Wrap(ErrBadObject, "delta: a copy cut off")
					}
					n = n | (i64(d[i]) << (8 * k))
					i += 1
				}
			}
			if n == 0 {
				n = 0x10000
			}
			if off + n > len(base) || len(out) + n > rsize {
				fail fault.Wrap(ErrBadObject, "delta: a copy outside the base")
			}
			out = append(out, base[off:off + n]...)
		} else if op != 0 {
			if i + op > len(d) || len(out) + op > rsize {
				fail fault.Wrap(ErrBadObject, "delta: an insert cut off")
			}
			out = append(out, d[i:i + op]...)
			i += op
		} else {
			fail fault.Wrap(ErrBadObject, "delta: op 0")
		}
	}
	if len(out) != rsize {
		fail fault.Wrap(ErrBadObject, "delta: {len(out)} bytes, not the {rsize} declared")
	}
	return str(out)
}
