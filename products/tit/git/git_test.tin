package git

import "crucible"
import "fault"
import "quarry"
import "seal"
import "spawn"
import "trail"
import "twine"

// Tests for reading git and converting it (#789), against repositories git itself makes: loose objects and packs
// with deltas, an annotated tag, a merge, extra commit headers, a worktree, a shallow clone.

fn fresh(name str) str {
	let d = "/tmp/tin-test-tit-git-" + name + "-" + seal.Hex(seal.RandomBytes(4))
	quarry.RemoveAll(d) catch _ {
	}
	quarry.MkdirAll(d) catch _ {
	}
	return d
}

// run runs git in dir with no user or system configuration and fixed dates, and gives its output.
fn run(t mut crucible.T, dir str, args []str) str {
	mut argv = []str{"git"}
	for a in args {
		argv = append(argv, a)
	}
	let env = []str{"PATH=" + quarry.Getenv("PATH"), "HOME=" + dir, "GIT_CONFIG_NOSYSTEM=1", "GIT_AUTHOR_NAME=Ada Lovelace", "GIT_AUTHOR_EMAIL=ada@example.com", "GIT_COMMITTER_NAME=Grace Hopper", "GIT_COMMITTER_EMAIL=grace@example.com", "GIT_AUTHOR_DATE=1700000000 +0530", "GIT_COMMITTER_DATE=1700000100 -0700"}
	let res = spawn.Run(spawn.Cmd{Argv: argv, Env: spawn.Env.Set(env), Dir: dir, Stdin: spawn.Stdio.Null, Stdout: spawn.Stdio.Pipe, Stderr: spawn.Stdio.Pipe, MaxOutput: 0, Input: ""}) catch e {
		t.Error("git {args[0]}: {e}")
		return ""
	}
	if res.Code != 0 {
		let line = twine.Join(args, " ")
		t.Error("git {line}: {res.Stderr}")
	}
	return res.Stdout
}

fn write(path str, text str) {
	let slash = twine.LastIndex(path, "/")
	quarry.MkdirAll(path[0:slash]) catch _ {
	}
	quarry.WriteFile(path, text) catch _ {
	}
}

// history makes a repository with a few commits (some packed with deltas, some loose), a merge, a tag, a symlink,
// an executable, a binary file and a commit with extra headers; it gives the directory.
fn history(t mut crucible.T, name str) str {
	let d = fresh(name)
	_ = run(mut t, d, []str{"init", "-q", "-b", "main"})
	mut big = ""
	for i in 0..3000 {
		big = big + "line {i} of a file that changes a little each time\n"
	}
	write(d + "/big.txt", big)
	write(d + "/src/main.tin", "package main\n")
	write(d + "/run.sh", "#!/bin/sh\necho hi\n")
	quarry.Chmod(d + "/run.sh", 493) catch _ {
	}
	quarry.Symlink("big.txt", d + "/link") catch _ {
	}
	write(d + "/bin.dat", "a\x00b\x00c")
	_ = run(mut t, d, []str{"add", "-A"})
	_ = run(mut t, d, []str{"commit", "-q", "-m", "first\n\nwith a body"})
	for k in 0..4 {
		big = big[0:100 * k] + "edit {k}\n" + big[100 * k:]
		write(d + "/big.txt", big)
		_ = run(mut t, d, []str{"commit", "-q", "-am", "edit {k}"})
	}
	_ = run(mut t, d, []str{"checkout", "-q", "-b", "side", "HEAD~2"})
	write(d + "/side.txt", "on the side\n")
	_ = run(mut t, d, []str{"add", "side.txt"})
	_ = run(mut t, d, []str{"commit", "-q", "-m", "side"})
	_ = run(mut t, d, []str{"checkout", "-q", "main"})
	_ = run(mut t, d, []str{"merge", "-q", "--no-edit", "side"})
	_ = run(mut t, d, []str{"tag", "-a", "v1", "-m", "version one"})
	_ = run(mut t, d, []str{"gc", "-q", "--aggressive"})
	// after the pack: a loose commit with headers git keeps (encoding, and a multi-line one like gpgsig)
	let tree = twine.TrimSpace(run(mut t, d, []str{"rev-parse", "HEAD^{{tree}}"}))
	let head = twine.TrimSpace(run(mut t, d, []str{"rev-parse", "HEAD"}))
	let body = "tree {tree}\nparent {head}\nauthor Ada Lovelace <ada@example.com> 1700000200 +0000\ncommitter Grace Hopper <grace@example.com> 1700000300 +0100\nencoding ISO-8859-1\ngpgsig -----BEGIN PGP SIGNATURE-----\n \n abcdef\n -----END PGP SIGNATURE-----\n\nwith headers\n"
	write(d + "/commit.txt", body)
	let id = twine.TrimSpace(run(mut t, d, []str{"hash-object", "-t", "commit", "-w", "commit.txt"}))
	quarry.Remove(d + "/commit.txt") catch _ {
	}
	_ = run(mut t, d, []str{"update-ref", "refs/heads/main", id})
	return d
}

fn TestWorktreeAndShallow(t mut crucible.T) {
	let d = history(mut t, "worktree")
	let w = d + "-wt"
	_ = run(mut t, d, []str{"worktree", "add", "-q", w, "side"})
	let r = Open(w) catch e {
		t.Error("open a worktree: {e}")
		return
	}
	let (head, _, herr) = r.Head()
	t.NoFault("worktree head", herr)
	crucible.Equal(mut t, "the worktree's HEAD", head, "refs/heads/side")
	t.True("its objects are the main repository's: " + r.CommonDir, twine.HasSuffix(r.CommonDir, trail.Base(d) + "/.git"))
	t.True("its HEAD is its own: " + r.GitDir, twine.Contains(r.GitDir, "/.git/worktrees/"))
	let s = d + "-shallow"
	_ = run(mut t, d, []str{"clone", "-q", "--depth", "1", "file://" + d, s})
	let (_, err) = Open(s)
	t.True("a shallow clone is refused", err != nil && fault.Is(err, ErrShallow))
	let (_, nerr) = Open(d + "/src")
	t.True("not a repository", nerr != nil && fault.Is(nerr, ErrNotGit))
	quarry.RemoveAll(d) catch _ {
	}
	quarry.RemoveAll(w) catch _ {
	}
	quarry.RemoveAll(s) catch _ {
	}
}

fn TestDamaged(t mut crucible.T) {
	let d = fresh("damaged")
	_ = run(mut t, d, []str{"init", "-q", "-b", "main"})
	write(d + "/a.txt", "a\n")
	_ = run(mut t, d, []str{"add", "a.txt"})
	_ = run(mut t, d, []str{"commit", "-q", "-m", "a"})
	let blob = twine.TrimSpace(run(mut t, d, []str{"rev-parse", "HEAD:a.txt"}))
	let path = d + "/.git/objects/" + blob[0:2] + "/" + blob[2:]
	quarry.Chmod(path, 420) catch _ {
	}
	let r = Open(d) catch e {
		t.Error("open: {e}")
		return
	}
	let id = ParseHex(blob) catch _ {
		""
	}
	let bad = id[0:19] + "\x00"
	let (_, _, err) = r.Read(bad)
	t.True("a missing object", err != nil && fault.Is(err, ErrMissing))
	quarry.WriteFile(path, "not zlib at all") catch _ {
	}
	let (_, _, err2) = r.Read(id)
	t.True("a damaged object names itself", err2 != nil && fault.Is(err2, ErrBadObject) && twine.Contains(fault.Message(err2), blob))
	quarry.RemoveAll(d) catch _ {
	}
}

fn TestParse(t mut crucible.T) {
	let p = ParsePerson("Ada Lovelace <ada@example.com> 1700000000 -0730") catch e {
		t.Error("person: {e}")
		return
	}
	crucible.Equal(mut t, "name", p.Name, "Ada Lovelace")
	crucible.Equal(mut t, "zone", p.Zone, -450)
	crucible.Equal(mut t, "written back", PersonText(p), "Ada Lovelace <ada@example.com> 1700000000 -0730")
	let (_, err) = ParsePerson("nobody 1700000000")
	t.True("no email", err != nil)
	let delta = "\x05\x0b\x90\x05\x03new\x91\x00\x03"
	let out = applyGitDelta("hello", delta) catch e {
		t.Error("delta: {e}")
		return
	}
	crucible.Equal(mut t, "a git delta", out, "hellonewhel")
	let (_, derr) = applyGitDelta("hello", "\x05\x0b\x90\x09")
	t.True("a copy outside the base", derr != nil)
}
