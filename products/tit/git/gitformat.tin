package git

import "../object"

// Writing tit objects in git's format again (#789): how adoption checks each object it makes, and what tit mirror
// (#805) builds on.

fn zoneText(minutes i64) str {
	mut sign = "+"
	mut m = minutes
	if m < 0 {
		sign = "-"
		m = -m
	}
	let hh = m / 60
	let mm = m % 60
	mut out = sign
	if hh < 10 {
		out = out + "0"
	}
	out = out + "{hh}"
	if mm < 10 {
		out = out + "0"
	}
	return out + "{mm}"
}

// PersonText is a person as git writes one.
fn PersonText(p object.Person) str {
	return "{p.Name} <{p.Email}> {p.When} {zoneText(p.Zone)}"
}

fn gitMode(m object.Mode) str {
	return match m {
		File => "100644"
		Exec => "100755"
		Link => "120000"
		Dir => "40000"
	}
}

// GitCommitBody is a commit in git's format, given its tree's and parents' git ids.
fn GitCommitBody(c object.CommitData, tree str, parents []str) str {
	mut out = "tree " + Hex(tree) + "\n"
	for p in parents {
		out = out + "parent " + Hex(p) + "\n"
	}
	out = out + "author " + PersonText(c.Author) + "\ncommitter " + PersonText(c.Committer) + "\n"
	for h in c.GitHeaders {
		mut line = ""
		for i in 0..len(h) {
			line = line + h[i:i + 1]
			if h[i] == '\n' {
				line = line + " "
			}
		}
		out = out + line + "\n"
	}
	return out + "\n" + c.Message
}
