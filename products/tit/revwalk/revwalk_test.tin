package revwalk

import "../change"
import "../object"
import "../store"
import "crucible"
import "fault"
import "quarry"
import "seal"

// Tests for revisions, walks and merge-base (#781), on this history (times in brackets):
//
//   c1[1] - c2[2] - c3[3] ------ m[6]      main, HEAD
//                \               /
//                 b1[4] - b2[5]            feature;  tag v1 = c2

type graph struct {
	dir   str
	s     store.Mem
	ids   map[str]object.Id
}

fn person(when i64) object.Person {
	return object.Person{Name: "A", Email: "a@x", When: when, Zone: 0}
}

fn commit(g mut graph, name str, parents []str, when i64) {
	mut ps = []object.Id{}
	for p in parents {
		ps = append(ps, g.ids[p])
	}
	let tree = g.s.Put(object.Object.Tree([]object.Entry{})) catch _ {
		object.NoId
	}
	let c = object.CommitData{Tree: tree, Parents: ps, Change: object.AdoptedChangeId(name), Author: person(when), Committer: person(when), GitHeaders: []str{}, Signature: "", Message: name + "\n", Conflicts: []str{}}
	let id = g.s.Put(object.Object.Commit(c)) catch _ {
		object.NoId
	}
	g.ids[name] = id
}

fn build() graph {
	let dir = "/tmp/tin-test-tit-revwalk-" + seal.Hex(seal.RandomBytes(4))
	quarry.MkdirAll(dir) catch _ {
	}
	mut g = graph{dir: dir, s: store.NewMem(), ids: map[str]object.Id{}}
	commit(mut g, "c1", []str{}, 1)
	commit(mut g, "c2", []str{"c1"}, 2)
	commit(mut g, "c3", []str{"c2"}, 3)
	commit(mut g, "b1", []str{"c2"}, 4)
	commit(mut g, "b2", []str{"b1"}, 5)
	commit(mut g, "m", []str{"c3", "b2"}, 6)
	mut refs = change.NewRefs(dir)
	refs.Update("refs/heads/main", nil, change.Target.Commit(g.ids["m"])) catch _ {
	}
	refs.Update("refs/heads/feature", nil, change.Target.Commit(g.ids["b2"])) catch _ {
	}
	refs.Update("refs/tags/v1", nil, change.Target.Commit(g.ids["c2"])) catch _ {
	}
	change.WriteHead(dir + "/workspaces/default", change.Head.Branch("refs/heads/main")) catch _ {
	}
	change.AddVersion(dir, object.AdoptedChangeId("b2"), change.NewVersion(1, g.ids["b2"], 5)) catch _ {
	}
	return g
}

fn resolve(g mut graph, s str) str {
	let rev = Parse(s) catch err {
		return "parse: " + fault.Message(err)
	}
	mut r = Repo[store.Mem]{Dir: g.dir, WsDir: g.dir + "/workspaces/default", Store: g.s}
	let id = Resolve(mut r, g.s, rev) catch err {
		return "error: " + fault.Message(err)
	}
	for name, v in g.ids {
		if v == id {
			return name
		}
	}
	return "?"
}

fn names(g graph, ids []object.Id) str {
	mut out = ""
	for id in ids {
		for name, v in g.ids {
			if v == id {
				if len(out) > 0 {
					out = out + " "
				}
				out = out + name
			}
		}
	}
	return out
}

fn TestParse(t mut crucible.T) {
	let r = Parse("main~2^2") catch _ {
		Rev.Head
	}
	let shape = match r {
		Parent(inner, n) => match inner {
			Ancestor(_, k) => "parent {n} of ancestor {k}"
			Head, Name(_), Short(_), Change(_), Git(_), Parent(_, _), Range(_, _), Symmetric(_, _) => "wrong"
		}
		Head, Name(_), Short(_), Change(_), Git(_), Ancestor(_, _), Range(_, _), Symmetric(_, _) => "wrong"
	}
	crucible.Equal(mut t, "suffixes", shape, "parent 2 of ancestor 2")
	let (_, e1) = Parse("")
	t.HasFault("empty", e1)
	let (_, e2) = Parse("git:zz")
	t.HasFault("git: needs hex", e2)
	let rng = Parse("a..b") catch _ {
		Rev.Head
	}
	t.True("range", match rng {
		Range(_, _) => true
		Head, Name(_), Short(_), Change(_), Git(_), Ancestor(_, _), Parent(_, _), Symmetric(_, _) => false
	})
}

fn TestResolve(t mut crucible.T) {
	mut g = build()
	crucible.Equal(mut t, "HEAD", resolve(mut g, "HEAD"), "m")
	crucible.Equal(mut t, "a branch", resolve(mut g, "feature"), "b2")
	crucible.Equal(mut t, "a tag", resolve(mut g, "v1"), "c2")
	crucible.Equal(mut t, "first parent", resolve(mut g, "main~1"), "c3")
	crucible.Equal(mut t, "second parent", resolve(mut g, "main^2"), "b2")
	crucible.Equal(mut t, "two back", resolve(mut g, "HEAD~2"), "c2")
	crucible.Equal(mut t, "mixed", resolve(mut g, "main^2~1"), "b1")
	crucible.Equal(mut t, "short id", resolve(mut g, g.ids["c1"].Hex()[0:8]), "c1")
	crucible.Equal(mut t, "full id", resolve(mut g, g.ids["c3"].Hex()), "c3")
	crucible.Equal(mut t, "a change id", resolve(mut g, object.AdoptedChangeId("b2").Letters()[0:6]), "b2")
	t.True("no such name", len(resolve(mut g, "nope")) > 6 && resolve(mut g, "nope")[0:6] == "error:")
	let pastRoot = resolve(mut g, g.ids["c1"].Hex() + "~1")
	t.True("past the root", len(pastRoot) > 6 && pastRoot[0:6] == "error:")
	quarry.RemoveAll(g.dir) catch _ {
	}
}

fn TestGitIds(t mut crucible.T) {
	mut g = build()
	// a table with one adopted commit: git id 08ed4b78… is tit's c1
	mut b = []u8{}
	for ch in "TITGIDS\x00" {
		b = append(b, u8(ch))
	}
	b = append(b, 1, 0, 0, 0)
	b = append(b, 1, 0, 0, 0, 0, 0, 0, 0)
	let git = seal.HexDecode("08ed4b78aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") catch _ {
		[]u8{}
	}
	b = append(b, git...)
	b = append(b, []u8(g.ids["c1"].Bytes())...)
	b = append(b, 0, 0, 0, 0)
	b = append(b, []u8(seal.Sha256(str(b)))...)
	quarry.WriteFile(g.dir + "/git-ids", str(b)) catch _ {
	}
	crucible.Equal(mut t, "git: id", resolve(mut g, "git:08ed4b78"), "c1")
	crucible.Equal(mut t, "a plain prefix finds the git id too", resolve(mut g, "08ed4b78"), "c1")
	quarry.RemoveAll(g.dir) catch _ {
	}
}

fn TestWalk(t mut crucible.T) {
	mut g = build()
	let m = []object.Id{g.ids["m"]}
	let date = Walk(mut g.s, m, []object.Id{}, Order.Date, 0) catch _ {
		[]object.Id{}
	}
	crucible.Equal(mut t, "date order", names(g, date), "m b2 b1 c3 c2 c1")
	let first = Walk(mut g.s, m, []object.Id{}, Order.FirstParent, 0) catch _ {
		[]object.Id{}
	}
	crucible.Equal(mut t, "first parents", names(g, first), "m c3 c2 c1")
	let topo = Walk(mut g.s, m, []object.Id{}, Order.Topo, 0) catch _ {
		[]object.Id{}
	}
	crucible.Equal(mut t, "children before parents", names(g, topo), "m b2 b1 c3 c2 c1")
	let rng = Walk(mut g.s, m, []object.Id{g.ids["c2"]}, Order.Date, 0) catch _ {
		[]object.Id{}
	}
	crucible.Equal(mut t, "a range hides c2 and before", names(g, rng), "m b2 b1 c3")
	let two = Walk(mut g.s, m, []object.Id{}, Order.Date, 2) catch _ {
		[]object.Id{}
	}
	crucible.Equal(mut t, "at most two", len(two), 2)
	let base = MergeBase(mut g.s, g.ids["c3"], g.ids["b2"]) catch _ {
		nil
	}
	t.True("merge-base", base != nil && base == g.ids["c2"])
	let up = IsAncestor(mut g.s, g.ids["c1"], g.ids["b2"]) catch _ {
		false
	}
	let down = IsAncestor(mut g.s, g.ids["b2"], g.ids["c3"]) catch _ {
		true
	}
	t.True("ancestors", up && !down)
	quarry.RemoveAll(g.dir) catch _ {
	}
}
