package cores

import "../delta"
import "../object"
import "fault"
import "flume"
import "hearth"
import "mint"
import "quarry"
import "relay"
import "squash"
import "twine"

// All the cores (#783). A command runs under Start: core 0 runs it while the other cores wait for jobs over relay
// (cores share no memory, so a job and its answer travel as strings). Work that splits into independent pieces, such
// as hashing the files status has to read, goes to the pool when it is running and runs on core 0 when it is not
// (in tests, or with one core). The pool is started once: a second hearth.Run hangs (#858).

mut running = false

// Start runs main with n cores (hearth.Cores() when n is 0): core 0 runs main, the others serve jobs until it returns.
fn Start(n0 i64, main fn()) {
	mut n = n0
	if n <= 0 {
		n = hearth.Cores()
		// TIN_CORES sets it, as it does for anvil's servers (a number from 1 to the CPUs there are)
		let (env, set) = quarry.LookupEnv("TIN_CORES")
		if set {
			let k = mint.Atoi(env) catch _ {
				0
			}
			if k >= 1 && k <= n {
				n = k
			}
		}
	}
	if n <= 1 {
		main()
		return
	}
	hearth.Run(n, fn(core i64) {
		if core == 0 {
			running = true
			main()
			running = false
			for k in 1..relay.Cores() {
				relay.Send(k, "")
			}
			return
		}
		serveJobs()
	})
}

// serveJobs answers jobs on a worker core until core 0 sends the empty message.
fn serveJobs() {
	for {
		let (_, msg) = relay.Recv()
		if msg == "" {
			return
		}
		let reply = arena {
			serve(msg)
		}
		relay.Send(0, reply)
	}
}

// Running reports whether the pool is serving jobs (on core 0, inside Start with more than one core).
fn Running() bool {
	return running && relay.Cores() > 1
}

// serve answers one job: "h <seq> <path>" hashes a file as a blob; "z <seq> <level>\n<data>" compresses data with
// zlib; "d <seq> <len> <len>...\n<target><base>..." is the shortest delta from one of the bases to the target (the
// reply "<seq> <base>\n<delta>", base -1 when none is under half the target).
fn serve(msg str) str {
	if len(msg) > 2 && (msg[0] == 'z' || msg[0] == 'd') && msg[1] == ' ' {
		return serveData(msg)
	}
	if len(msg) > 2 && msg[0] == 'w' && msg[1] == ' ' {
		return serveWindow(msg)
	}
	let f = twine.SplitN(msg, " ", 3)
	if len(f) == 3 && f[0] == "h" {
		let (id, err) = HashPath(f[2])
		if err != nil {
			return f[1] + " !" + fault.Message(err)
		}
		return f[1] + " " + id.Hex()
	}
	return "? bad job"
}

fn serveData(msg str) str {
	let nl = twine.IndexByte(msg, '\n')
	if nl < 0 {
		return "? bad job"
	}
	let head = twine.Split(msg[2:nl], " ")
	let data = msg[nl + 1:]
	if msg[0] == 'z' && len(head) == 2 {
		let level = mint.Atoi(head[1]) catch _ {
			6
		}
		return head[0] + " " + squash.Zlib(data, level)
	}
	// d: the lengths of the target and of each base, then their bytes
	mut lens = []i64{}
	for h in head[1:] {
		let n = mint.Atoi(h) catch _ {
			-1
		}
		if n < 0 {
			return "? bad job"
		}
		lens = append(lens, n)
	}
	if len(lens) == 0 {
		return "? bad job"
	}
	let target = data[0:lens[0]]
	mut at = lens[0]
	mut best = -1
	mut bestDelta = ""
	for k in 1..len(lens) {
		let base = data[at:at + lens[k]]
		at += lens[k]
		let d = delta.MakeDelta(base, target)
		if len(d) > 0 && len(d) < len(target) / 2 && (best < 0 || len(d) < len(bestDelta)) {
			best = k - 1
			bestDelta = d
		}
	}
	return head[0] + " {best}\n" + bestDelta
}

// runJobs runs jobs (each made by job(i), its text starting "<kind> <i>") on the worker cores, or on core 0 when the
// pool is not running, and gives each one's reply after its "<i> ", in order.
fn runJobs(n i64, job fn(i64) str) []str {
	mut out = make([]str, n)
	if !Running() || n < 2 {
		for i in 0..n {
			// in an arena, as on the workers: what the job made goes with it, its answer is copied out
			let reply = arena {
				serve(job(i))
			}
			let sp = twine.IndexByte(reply, ' ')
			out[i] = reply[sp + 1:]
		}
		return out
	}
	let workers = relay.Cores() - 1
	mut sent = 0
	mut done = 0
	for sent < n && sent < workers * 2 {
		relay.Send(1 + sent % workers, job(sent))
		sent += 1
	}
	for done < n {
		let (from, reply) = relay.Recv()
		let sp = twine.IndexByte(reply, ' ')
		let seq = mint.Atoi(reply[0:sp]) catch _ {
			-1
		}
		if seq >= 0 && seq < n {
			out[seq] = reply[sp + 1:]
		}
		done += 1
		if sent < n {
			relay.Send(from, job(sent))
			sent += 1
		}
	}
	return out
}

// Compress is each data compressed with zlib at its level, on every core.
fn Compress(data []str, levels []i64) []str {
	return runJobs(len(data), fn(i i64) str {
		return "z {i} {levels[i]}\n" + data[i]
	})
}

// BestDeltas is, for each target, which of its bases gives the shortest delta (-1: none under half the target) and
// that delta, computed on every core.
fn BestDeltas(targets []str, bases [][]str) ([]i64, []str) {
	let replies = runJobs(len(targets), fn(i i64) str {
		mut head = "d {i} {len(targets[i])}"
		mut body = targets[i]
		for b in bases[i] {
			head = head + " {len(b)}"
			body = body + b
		}
		return head + "\n" + body
	})
	mut which = make([]i64, len(targets))
	mut deltas = make([]str, len(targets))
	for i in 0..len(replies) {
		let r = replies[i]
		let nl = twine.IndexByte(r, '\n')
		which[i] = -1
		if nl > 0 {
			which[i] = mint.Atoi(r[0:nl]) catch _ {
				-1
			}
			deltas[i] = r[nl + 1:]
		}
	}
	return which, deltas
}

// serveWindow answers "w <seq> <window> <first> <kind>:<len> ...\n<bodies>": objects in pack order, the first
// <first> of them only bases for the rest. For each of the rest, the shortest delta from one of the <window> objects
// before it of its kind (under half its size), as "<seq> <base>:<len> ...\n<deltas>" with base the position in the
// job, -1 for none.
fn serveWindow(msg str) str {
	let nl = twine.IndexByte(msg, '\n')
	if nl < 0 {
		return "? bad job"
	}
	let head = twine.Split(msg[2:nl], " ")
	if len(head) < 3 {
		return "? bad job"
	}
	let window = mint.Atoi(head[1]) catch _ {
		10
	}
	let first = mint.Atoi(head[2]) catch _ {
		0
	}
	let data = msg[nl + 1:]
	mut kinds = []str{}
	mut bodies = []str{}
	mut at = 0
	for h in head[3:] {
		let colon = twine.IndexByte(h, ':')
		let n = mint.Atoi(h[colon + 1:]) catch _ {
			0
		}
		kinds = append(kinds, h[0:colon])
		bodies = append(bodies, data[at:at + n])
		at += n
	}
	mut index = []str{}
	mut out = []u8{}
	for i in first..len(bodies) {
		mut best = -1
		mut bestDelta = ""
		if len(bodies[i]) >= 64 && len(bodies[i]) <= deltaMost {
			for j in max(0, i - window)..i {
				if kinds[j] != kinds[i] || len(bodies[j]) > deltaMost {
					continue
				}
				let d = delta.MakeDelta(bodies[j], bodies[i])
				if len(d) > 0 && len(d) < len(bodies[i]) / 2 && (best < 0 || len(d) < len(bestDelta)) {
					best = j
					bestDelta = d
				}
			}
		}
		index = append(index, "{best}:{len(bestDelta)}")
		for k in 0..len(bestDelta) {
			out = append(out, bestDelta[k])
		}
	}
	return head[0] + " " + twine.Join(index, " ") + "\n" + str(out)
}

// deltaMost is the largest object a delta is searched for.
const deltaMost = 16 << 20

// WindowDeltas is, for each object of a pack in order (bodies, with their kinds), the position of the object among
// the window before it of its kind with the shortest delta to it (-1: none under half its size), and that delta,
// found on every core: each job takes a run of objects and the window before them, so each body travels about once.
fn WindowDeltas(bodies []str, kinds []i64, window i64) ([]i64, []str) {
	let n = len(bodies)
	// runs of about 4 MiB, at least one object
	mut starts = []i64{}
	mut i = 0
	for i < n {
		starts = append(starts, i)
		mut size = 0
		for i < n && (size == 0 || size + len(bodies[i]) <= 4 << 20) {
			size += len(bodies[i])
			i += 1
		}
	}
	starts = append(starts, n)
	let replies = runJobs(len(starts) - 1, fn(k i64) str {
		let a = starts[k]
		let b = starts[k + 1]
		let from = max(0, a - window)
		mut head = "w {k} {window} {a - from}"
		mut parts = []str{}
		for x in from..b {
			head = head + " {kinds[x]}:{len(bodies[x])}"
			parts = append(parts, bodies[x])
		}
		return head + "\n" + twine.Join(parts, "")
	})
	mut which = make([]i64, n)
	mut deltas = make([]str, n)
	for k in 0..len(replies) {
		let a = starts[k]
		let from = max(0, a - window)
		let r = replies[k]
		let nl = twine.IndexByte(r, '\n')
		if nl < 0 {
			for x in a..starts[k + 1] {
				which[x] = -1
			}
			continue
		}
		let fields = twine.Split(r[0:nl], " ")
		mut at = nl + 1
		for f in 0..len(fields) {
			let x = a + f
			let colon = twine.IndexByte(fields[f], ':')
			let w = mint.Atoi(fields[f][0:colon]) catch _ {
				-1
			}
			let ln = mint.Atoi(fields[f][colon + 1:]) catch _ {
				0
			}
			if w >= 0 {
				which[x] = from + w
				deltas[x] = r[at:at + ln]
			} else {
				which[x] = -1
			}
			at += ln
		}
	}
	return which, deltas
}

// HashPath is the blob id of the file at path: its contents, or a symlink's target.
fn HashPath(path str) !object.Id {
	let info = try quarry.Lstat(path)
	if info.Type == quarry.FileType.Symlink {
		let target = try quarry.Readlink(path)
		return object.Hash(object.Kind.Blob, target)
	}
	mut r = try flume.Open(path)
	let (id, err) = object.HashBlob(mut r, info.Size)
	r.Close()
	if err != nil {
		fail err
	}
	return id
}

// HashResult is one file's blob id, or why it could not be read. Id is not the last field (#847).
type HashResult struct {
	Id  object.Id
	Err str
}

// HashPaths hashes the files, on every core when the pool is running and there are enough of them.
fn HashPaths(paths []str) []HashResult {
	mut out = make([]HashResult, 0, len(paths))
	if !Running() || len(paths) < 32 {
		for p in paths {
			let (id, err) = HashPath(p)
			if err != nil {
				out = append(out, HashResult{Err: fault.Message(err), Id: object.NoId})
			} else {
				out = append(out, HashResult{Err: "", Id: id})
			}
		}
		return out
	}
	for i in 0..len(paths) {
		out = append(out, HashResult{Err: "not hashed", Id: object.NoId})
	}
	let workers = relay.Cores() - 1
	mut sent = 0
	mut done = 0
	// keep each worker a few jobs ahead, so the inboxes stay small
	for sent < len(paths) && sent < workers * 4 {
		relay.Send(1 + sent % workers, "h {sent} " + paths[sent])
		sent += 1
	}
	for done < len(paths) {
		let (from, reply) = relay.Recv()
		let sp = twine.IndexByte(reply, ' ')
		let seq = mint.Atoi(reply[0:sp]) catch _ {
			-1
		}
		if seq >= 0 && seq < len(paths) {
			let rest = reply[sp + 1:]
			if len(rest) > 0 && rest[0] == '!' {
				out[seq] = HashResult{Err: rest[1:], Id: object.NoId}
			} else {
				let id = object.ParseId(rest) catch _ {
					object.NoId
				}
				out[seq] = HashResult{Err: "", Id: id}
			}
		}
		done += 1
		if sent < len(paths) {
			relay.Send(from, "h {sent} " + paths[sent])
			sent += 1
		}
	}
	return out
}
