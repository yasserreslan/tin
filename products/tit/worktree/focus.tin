package worktree

import "flume"
import "quarry"
import "twine"

// Focus (#803): a workspace may check out only some directories of its trees, listed one a line in
// .tit/workspaces/<name>/focus. Files at the root are always checked out. A file outside the focus stays in the
// index and in every commit as it is; checkouts do not write it, and status, diff, add and commit -a leave it alone.

// FocusOf is the directories the workspace checks out; none means all of them.
fn FocusOf(w Workspace) []str {
	let path = w.State() + "/focus"
	mut out = []str{}
	if !quarry.Exists(path) {
		return out
	}
	let text = flume.ReadFile(path) catch _ {
		return out
	}
	for line in twine.Split(text, "\n") {
		let d = twine.Trim(twine.TrimSpace(line), "/")
		if len(d) > 0 {
			out = append(out, d)
		}
	}
	return out
}

// InFocus reports whether a path is checked out under the focus dirs (every path when there are none).
fn InFocus(dirs []str, path str) bool {
	if len(dirs) == 0 || twine.IndexByte(path, '/') < 0 {
		return true
	}
	for d in dirs {
		if path == d || twine.HasPrefix(path, d + "/") {
			return true
		}
	}
	return false
}
