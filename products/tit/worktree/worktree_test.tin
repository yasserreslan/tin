package worktree

import "../index"
import "../object"
import "../packfile"
import "../store"
import "crucible"
import "fault"
import "quarry"
import "seal"
import "sift"

// Tests for workspaces and checkout (#784).

fn fresh(name str) str {
	let d = "/tmp/tin-test-tit-worktree-" + name + "-" + seal.Hex(seal.RandomBytes(4))
	quarry.RemoveAll(d) catch _ {
	}
	quarry.MkdirAll(d + "/.tit") catch _ {
	}
	return d
}

type file struct {
	path str
	mode object.Mode
	body str
}

fn treeOf(s mut store.Mem, files []file) object.Id {
	mut idx = index.New()
	for f in files {
		let id = s.PutRaw(object.Kind.Blob, f.body) catch _ {
			object.NoId
		}
		idx.Set(index.Entry{Path: f.path, Hash: id.Bytes(), Mode: f.mode, Stage: 0, Size: 0, Mtime: 0, Ctime: 0, Inode: 0, Device: 0})
	}
	return index.WriteTree(mut s, idx) catch _ {
		object.NoId
	}
}

fn read(root str, path str) str {
	return quarry.ReadFile(root + "/" + path) catch _ {
		"(none)"
	}
}

fn TestFind(t mut crucible.T) {
	let d = fresh("find")
	quarry.MkdirAll(d + "/deep/er") catch _ {
	}
	let w = Find(d + "/deep/er") catch err {
		t.Error(fault.Message(err))
		return
	}
	t.True("the default workspace above", w.Name == "default" && w.Root == d && w.Store == d + "/.tit")
	let other = d + "-other"
	quarry.MkdirAll(other) catch _ {
	}
	quarry.WriteFile(other + "/.tit", "store {d}/.tit\nworkspace 742-pack\n") catch _ {
	}
	let w2 = Find(other) catch err {
		t.Error(fault.Message(err))
		return
	}
	t.True("a linked workspace", w2.Name == "742-pack" && w2.Store == d + "/.tit" && w2.State() == d + "/.tit/workspaces/742-pack")
	let (_, err) = Find("/")
	t.True("none above /", err != nil && fault.Is(err, ErrNoWorkspace))
	quarry.RemoveAll(d) catch _ {
	}
	quarry.RemoveAll(other) catch _ {
	}
}

fn TestCheckoutAndSwitch(t mut crucible.T) {
	let d = fresh("switch")
	let w = Workspace{Name: "default", Root: d, Store: d + "/.tit"}
	mut s = store.NewMem()
	let t1 = treeOf(mut s, []file{file{path: "a.txt", mode: object.Mode.File, body: "a one\n"}, file{path: "d/e/b.txt", mode: object.Mode.File, body: "b\n"}, file{path: "run.sh", mode: object.Mode.File, body: "echo\n"}, file{path: "link", mode: object.Mode.Link, body: "a.txt"}})
	let t2 = treeOf(mut s, []file{file{path: "a.txt", mode: object.Mode.File, body: "a two\n"}, file{path: "c.txt", mode: object.Mode.File, body: "c\n"}, file{path: "run.sh", mode: object.Mode.Exec, body: "echo\n"}, file{path: "link", mode: object.Mode.Link, body: "c.txt"}})
	mut idx = index.New()
	t.NoFault("checkout from nothing", Checkout(mut s, w, mut idx, object.NoId, t1, false))
	crucible.Equal(mut t, "a written", read(d, "a.txt"), "a one\n")
	crucible.Equal(mut t, "nested file written", read(d, "d/e/b.txt"), "b\n")
	let lt = quarry.Readlink(d + "/link") catch _ {
		""
	}
	crucible.Equal(mut t, "symlink written", lt, "a.txt")
	crucible.Equal(mut t, "index holds the tree", len(idx.Entries), 4)
	t.NoFault("switch", Checkout(mut s, w, mut idx, t1, t2, false))
	crucible.Equal(mut t, "a changed", read(d, "a.txt"), "a two\n")
	crucible.Equal(mut t, "c added", read(d, "c.txt"), "c\n")
	t.False("b deleted", quarry.Exists(d + "/d/e/b.txt"))
	t.False("emptied directories removed", quarry.Exists(d + "/d"))
	let rs = quarry.Lstat(d + "/run.sh") catch _ {
		quarry.FileInfo{Type: quarry.FileType.Regular, Perm: 0, Size: 0, Mtime: 0, Ctime: 0, Inode: 0, Device: 0, Links: 0}
	}
	crucible.Equal(mut t, "now executable", rs.Perm, 493)
	let lt2 = quarry.Readlink(d + "/link") catch _ {
		""
	}
	crucible.Equal(mut t, "symlink retargeted", lt2, "c.txt")
	mut paths = []str{}
	for e in idx.Entries {
		paths = append(paths, e.Path)
	}
	sift.Sort(mut paths)
	crucible.Equal(mut t, "index follows", say4(paths), "a.txt c.txt link run.sh")
	quarry.RemoveAll(d) catch _ {
	}
}

fn say4(xs []str) str {
	mut s = ""
	for i in 0..len(xs) {
		if i > 0 {
			s = s + " "
		}
		s = s + xs[i]
	}
	return s
}

fn TestDirtyBlocks(t mut crucible.T) {
	let d = fresh("dirty")
	let w = Workspace{Name: "default", Root: d, Store: d + "/.tit"}
	mut s = store.NewMem()
	let t1 = treeOf(mut s, []file{file{path: "a.txt", mode: object.Mode.File, body: "one\n"}, file{path: "keep.txt", mode: object.Mode.File, body: "k\n"}})
	let t2 = treeOf(mut s, []file{file{path: "a.txt", mode: object.Mode.File, body: "two\n"}, file{path: "keep.txt", mode: object.Mode.File, body: "k\n"}, file{path: "new.txt", mode: object.Mode.File, body: "new\n"}})
	mut idx = index.New()
	t.NoFault("checkout", Checkout(mut s, w, mut idx, object.NoId, t1, false))
	quarry.WriteFile(d + "/a.txt", "my unsaved edit\n") catch _ {
	}
	let e1 = Checkout(mut s, w, mut idx, t1, t2, false)
	t.True("a changed file blocks", e1 != nil && fault.Is(e1, ErrDirty))
	crucible.Equal(mut t, "the edit is kept", read(d, "a.txt"), "my unsaved edit\n")
	t.False("nothing was written", quarry.Exists(d + "/new.txt"))
	quarry.WriteFile(d + "/a.txt", "one\n") catch _ {
	}
	quarry.WriteFile(d + "/new.txt", "an untracked file in the way\n") catch _ {
	}
	let e2 = Checkout(mut s, w, mut idx, t1, t2, false)
	t.True("an untracked file in the way blocks", e2 != nil && fault.Is(e2, ErrDirty))
	t.NoFault("force", Checkout(mut s, w, mut idx, t1, t2, true))
	crucible.Equal(mut t, "forced", read(d, "new.txt"), "new\n")
	quarry.RemoveAll(d) catch _ {
	}
}

fn TestFileBecomesDirectory(t mut crucible.T) {
	let d = fresh("filedir")
	let w = Workspace{Name: "default", Root: d, Store: d + "/.tit"}
	mut s = store.NewMem()
	let t1 = treeOf(mut s, []file{file{path: "p", mode: object.Mode.File, body: "a file\n"}})
	let t2 = treeOf(mut s, []file{file{path: "p/q.txt", mode: object.Mode.File, body: "inside\n"}})
	mut idx = index.New()
	t.NoFault("checkout", Checkout(mut s, w, mut idx, object.NoId, t1, false))
	t.NoFault("file to directory", Checkout(mut s, w, mut idx, t1, t2, false))
	crucible.Equal(mut t, "p is a directory", read(d, "p/q.txt"), "inside\n")
	t.NoFault("directory to file", Checkout(mut s, w, mut idx, t2, t1, false))
	crucible.Equal(mut t, "p is a file again", read(d, "p"), "a file\n")
	crucible.Equal(mut t, "index", len(idx.Entries), 1)
	quarry.RemoveAll(d) catch _ {
	}
}

// A relative directory, and one that does not exist, end the search instead of looping (#795).
fn TestFindEnds(t mut crucible.T) {
	let (_, e1) = Find("../no-such-directory-here/at-all")
	t.True("relative", e1 != nil && fault.Is(e1, ErrNoWorkspace))
	let (_, e2) = Find("/no-such-directory-here/at-all")
	t.True("absolute", e2 != nil && fault.Is(e2, ErrNoWorkspace))
}

// A checkout of more than its memory budget (#1049): 64 files of 1 MiB from the repository's packs are written inside
// limit memory 24mb, a batch at a time; the old checkout read them all first.
fn TestCheckoutBoundedMemory(t mut crucible.T) {
	let d = fresh("bounded")
	let w = Workspace{Name: "default", Root: d, Store: d + "/.tit"}
	mut s = store.NewMem()
	mut files = []file{}
	for i in 0..64 {
		files = append(files, file{path: "f{i}.bin", mode: object.Mode.File, body: str(seal.RandomBytes(1 << 20))})
	}
	let tree = treeOf(mut s, files)
	mut ids = []object.Id{tree}
	for f in files {
		ids = append(ids, object.Hash(object.Kind.Blob, f.body))
	}
	let _ = packfile.Write(mut s, ids, d + "/.tit/packs") catch e {
		t.Error("pack: {e}")
		return
	}
	// read through the packs, as tit reads a repository: every read allocates
	let packs = packfile.OpenAll(d + "/.tit/packs") catch e {
		t.Error("open: {e}")
		return
	}
	mut layers = []dyn store.ObjectStore{}
	for p in packs {
		layers = append(layers, p)
	}
	mut ps = store.NewLayered(layers)
	mut idx = index.New()
	let (_, over) = limit memory 24mb {
		try Checkout(mut ps, w, mut idx, object.NoId, tree, false)
		0
	}
	t.True("the checkout fits in 24 MiB", over == nil)
	crucible.Equal(mut t, "a file written whole", len(read(d, "f63.bin")), 1 << 20)
	quarry.RemoveAll(d) catch _ {
	}
}
