package merge

import "../semantic"
import "twine"

// Merging Tin files by declaration (#799): when the line merge of a .tin file conflicts, the file is merged again one
// top-level declaration at a time. Declarations each side changed or added apart merge cleanly, wherever they sit
// in the file (two functions added at the same place, which a line merge cannot place); only one declaration
// changed differently on both sides still conflicts, and DeclConflicts names it.

// MergeTin merges three versions of a Tin file by declaration; ok is false when they do not merge that way (a file
// not laid out as tin fmt lays it out, a declaration both sides changed differently, one side's change against the
// other's removal), and conflicted names the declarations that stood in the way.
fn MergeTin(base str, ours str, theirs str) (str, bool, []str) {
	let (bd, bok) = semantic.Decls(base)
	let (od, ook) = semantic.Decls(ours)
	let (td, tok) = semantic.Decls(theirs)
	mut conflicted = []str{}
	if !bok || !ook || !tok {
		return "", false, conflicted
	}
	let bm = byKey(bd)
	let om = byKey(od)
	let tm = byKey(td)
	if len(bm) != len(bd) || len(om) != len(od) || len(tm) != len(td) {
		// the same key twice in one file (use, on): too ambiguous to merge by key
		return "", false, conflicted
	}
	// the text before the first declaration (package, imports) merges by lines
	let (pre, preClean) = MergeText(preamble(base, bd), preamble(ours, od), preamble(theirs, td), "ours", "theirs")
	if !preClean {
		return "", false, conflicted
	}
	// the order: ours, with what theirs adds placed after the declaration it follows in theirs
	mut order = []str{}
	for d in od {
		order = append(order, d.Key)
	}
	for i in 0..len(td) {
		let k = td[i].Key
		let (_, inOurs) = om[k]
		let (_, inBase) = bm[k]
		if inOurs || inBase {
			continue
		}
		mut at = 0
		for j in 0..i {
			for p in 0..len(order) {
				if order[p] == td[i - 1 - j].Key && at == 0 {
					at = p + 1
				}
			}
			if at > 0 {
				break
			}
		}
		// after what ours added at the same place: ours first, then theirs
		for at < len(order) {
			let (_, ob) = bm[order[at]]
			let (_, ot) = tm[order[at]]
			if ob || ot {
				break
			}
			at += 1
		}
		mut next = []str{}
		for p in 0..len(order) {
			if p == at {
				next = append(next, k)
			}
			next = append(next, order[p])
		}
		if at >= len(order) {
			next = append(next, k)
		}
		order = next
	}
	mut parts = []str{}
	for k in order {
		let (b, inB) = bm[k]
		let (o, inO) = om[k]
		let (t, inT) = tm[k]
		if inO && inT {
			if o.Norm == t.Norm || (inB && t.Norm == b.Norm) {
				parts = append(parts, o.Text)
			} else if inB && o.Norm == b.Norm {
				parts = append(parts, t.Text)
			} else if inB {
				let (text, clean) = MergeText(b.Text, o.Text, t.Text, "ours", "theirs")
				if !clean {
					conflicted = append(conflicted, k)
					continue
				}
				parts = append(parts, text)
			} else {
				conflicted = append(conflicted, k)
			}
		} else if inO {
			// theirs removed it (or never had it): gone if ours left it as it was, a conflict if ours changed it
			if inB {
				if o.Norm != b.Norm {
					conflicted = append(conflicted, k)
				}
				continue
			}
			parts = append(parts, o.Text)
		} else if inT {
			if inB {
				if t.Norm != b.Norm {
					conflicted = append(conflicted, k)
				}
				continue
			}
			parts = append(parts, t.Text)
		}
	}
	if len(conflicted) > 0 {
		return "", false, conflicted
	}
	mut out = twine.TrimRight(pre, "\n")
	for p in parts {
		out = out + "\n\n" + twine.TrimRight(p, "\n")
	}
	return out + "\n", true, conflicted
}

fn byKey(ds []semantic.Decl) map[str]semantic.Decl {
	mut m = map[str]semantic.Decl{}
	for d in ds {
		m[d.Key] = d
	}
	return m
}

// preamble is the text before a file's first declaration (its doc comment counted with it).
fn preamble(text str, ds []semantic.Decl) str {
	let lines = twine.Split(text, "\n")
	if len(ds) == 0 {
		return text
	}
	return twine.Join(lines[0:ds[0].Line - 1], "\n")
}
