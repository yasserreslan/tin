package merge

import "../object"
import "../store"
import "twine"
import "fault"
import "sift"

// Three-way merge of trees (#786): each name takes the side that changed it; directories changed on both sides
// merge recursively; files changed on both sides merge line by line. Whatever does not combine is recorded as a
// Conflict, and the merged tree keeps our version of that path, so a conflicted merge is still a tree that a change
// can record (conflict markers are written only when the files are checked out).

fn sameEntry(a ?object.Entry, b ?object.Entry) bool {
	if a == nil || b == nil {
		return a == nil && b == nil
	}
	return a.Mode == b.Mode && a.Id == b.Id
}

fn entries[S store.ObjectStore](s mut S, id object.Id) !map[str]object.Entry {
	mut out = map[str]object.Entry{}
	if id == object.NoId {
		return out
	}
	let o = try s.Get(id)
	match o {
		Tree(es) => {
			for e in es {
				out[e.Name] = e
			}
		}
		Blob(_) => {
			fail fault.Wrap(object.ErrCorrupt, "{id.Hex()} is not a tree")
		}
		Commit(_) => {
			fail fault.Wrap(object.ErrCorrupt, "{id.Hex()} is not a tree")
		}
		Tag(_) => {
			fail fault.Wrap(object.ErrCorrupt, "{id.Hex()} is not a tree")
		}
	}
	return out
}

fn isDir(e ?object.Entry) bool {
	return e != nil && e.Mode == object.Mode.Dir
}

// binary reports whether a blob looks binary (a NUL in its first 8000 bytes), which is never merged by lines.
fn binary(b str) bool {
	for i in 0..min(len(b), 8000) {
		if b[i] == 0 {
			return true
		}
	}
	return false
}

fn blob[S store.ObjectStore](s mut S, e ?object.Entry) !str {
	if e == nil {
		return ""
	}
	let (_, body) = try s.GetRaw(e.Id)
	return body
}

// MergeTrees merges the trees ours and theirs, both changed from base (object.NoId when they share no ancestor),
// writing the merged trees and blobs to s.
fn MergeTrees[S store.ObjectStore](s mut S, base object.Id, ours object.Id, theirs object.Id) !Result {
	mut conflicts = []Conflict{}
	// a file one side renamed and the other edited is merged at its new name (renames.tin)
	let (b1, t1) = try followRenames(mut s, base, ours, theirs)
	let (b2, o2) = try followRenames(mut s, b1, t1, ours)
	let id = try mergeDir(mut s, "", b2, o2, t1, mut conflicts)
	return Result{Tree: id, Conflicts: conflicts}
}

fn idOf(e ?object.Entry) object.Id {
	if e == nil {
		return object.NoId
	}
	return e.Id
}

fn mergeDir[S store.ObjectStore](s mut S, path str, base object.Id, ours object.Id, theirs object.Id, conflicts mut []Conflict) !object.Id {
	let b = try entries(mut s, base)
	let o = try entries(mut s, ours)
	let t = try entries(mut s, theirs)
	mut names = map[str]bool{}
	for n, _ in b {
		names[n] = true
	}
	for n, _ in o {
		names[n] = true
	}
	for n, _ in t {
		names[n] = true
	}
	mut sorted = []str{}
	for name, _ in names {
		sorted = append(sorted, name)
	}
	sift.Sort(mut sorted)
	mut out = []object.Entry{}
	for name in sorted {
		mut be ?object.Entry = nil
		mut oe ?object.Entry = nil
		mut te ?object.Entry = nil
		let (bv, bok) = b[name]
		if bok {
			be = bv
		}
		let (ov, ook) = o[name]
		if ook {
			oe = ov
		}
		let (tv, tok) = t[name]
		if tok {
			te = tv
		}
		let full = path + name
		mut pick ?object.Entry = nil
		if sameEntry(oe, te) || sameEntry(te, be) {
			pick = oe
		} else if sameEntry(oe, be) {
			pick = te
		} else if isDir(oe) && isDir(te) {
			mut bsub = object.NoId
			if isDir(be) {
				bsub = idOf(be)
			}
			let sub = try mergeDir(mut s, full + "/", bsub, idOf(oe), idOf(te), mut conflicts)
			pick = object.Entry{Mode: object.Mode.Dir, Name: name, Id: sub}
		} else if oe != nil && te != nil && !isDir(oe) && !isDir(te) {
			pick = try mergeFile(mut s, full, be, oe, te, mut conflicts)
		} else if (oe == nil || isDir(oe)) && (te == nil || isDir(te)) && (be == nil || isDir(be)) {
			// a directory one side deleted and the other changed: merged file by file, as git does, so each file
			// the other side changed is a conflict of its own (its version kept) and the rest goes
			mut bsub = object.NoId
			if isDir(be) {
				bsub = idOf(be)
			}
			let sub = try mergeDir(mut s, full + "/", bsub, idOf(oe), idOf(te), mut conflicts)
			let left = try entries(mut s, sub)
			if len(left) > 0 {
				pick = object.Entry{Mode: object.Mode.Dir, Name: name, Id: sub}
			}
		} else {
			// deleted on one side and changed on the other, or a file against a directory
			conflicts = append(conflicts, NewConflict(full, idOf(be), idOf(oe), idOf(te)))
			pick = oe
			if pick == nil {
				pick = te
			}
		}
		if pick != nil {
			out = append(out, pick)
		}
	}
	sift.SortFunc(mut out, fn(x object.Entry, y object.Entry) i64 {
		let kx = treeKey(x)
		let ky = treeKey(y)
		if kx < ky {
			return -1
		}
		if kx > ky {
			return 1
		}
		return 0
	})
	return try s.Put(object.Object.Tree(out))
}

fn treeKey(e object.Entry) str {
	return match e.Mode {
		Dir => e.Name + "/"
		File, Exec, Link => e.Name
	}
}

fn mergeFile[S store.ObjectStore](s mut S, path str, be ?object.Entry, oe object.Entry, te object.Entry, conflicts mut []Conflict) !object.Entry {
	// the mode: the side that changed it, or a conflict when both changed it differently
	mut mode = oe.Mode
	mut modeOk = true
	if be != nil {
		if oe.Mode == be.Mode {
			mode = te.Mode
		} else if te.Mode != be.Mode && te.Mode != oe.Mode {
			modeOk = false
		}
	} else if oe.Mode != te.Mode {
		modeOk = false
	}
	if oe.Id == te.Id {
		if !modeOk {
			conflicts = append(conflicts, NewConflict(path, idOf(be), oe.Id, te.Id))
		}
		return object.Entry{Mode: mode, Name: oe.Name, Id: oe.Id}
	}
	let bb = try blob(mut s, be)
	let ob = try blob(mut s, oe)
	let tb = try blob(mut s, te)
	if mode == object.Mode.Link || binary(bb) || binary(ob) || binary(tb) {
		conflicts = append(conflicts, NewConflict(path, idOf(be), oe.Id, te.Id))
		return oe
	}
	mut (text, clean) = MergeText(bb, ob, tb, "ours", "theirs")
	if !clean && twine.HasSuffix(path, ".tin") {
		// a Tin file merges again by declaration (#799): changes to different declarations go side by side
		let (dt, dok, _) = MergeTin(bb, ob, tb)
		if dok {
			text = dt
			clean = true
		}
	}
	if !clean || !modeOk {
		conflicts = append(conflicts, NewConflict(path, idOf(be), oe.Id, te.Id))
		return oe
	}
	let id = try s.PutRaw(object.Kind.Blob, text)
	return object.Entry{Mode: mode, Name: oe.Name, Id: id}
}
