package merge

import "../object"

// Three-way merge of trees and lines (#786).

// Conflict is one path both sides changed in ways that do not combine, with the three versions' ids (object.NoId
// for a side that has no file there). The ids are kept in a slice, not three fields: two fields of another package's
// value struct share one slot today (#847).
type Conflict struct {
	Path str
	ids  []object.Id
}

// NewConflict is the conflict at path between the base's, our and their versions.
fn NewConflict(path str, base object.Id, ours object.Id, theirs object.Id) Conflict {
	return Conflict{Path: path, ids: []object.Id{base, ours, theirs}}
}

// Base is the base's version.
fn (c Conflict) Base() object.Id {
	return c.ids[0]
}

// Ours is our version.
fn (c Conflict) Ours() object.Id {
	return c.ids[1]
}

// Theirs is their version.
fn (c Conflict) Theirs() object.Id {
	return c.ids[2]
}

// Result is a merge's outcome: the merged tree and the conflicts recorded in it (none for a clean merge). A struct,
// not an enum of Clean and Conflicts: reading object.Id out of a two-field enum payload crashes today (#847).
type Result struct {
	Tree      object.Id
	Conflicts []Conflict
}

// Clean reports whether the merge had no conflict.
fn (r Result) Clean() bool {
	return len(r.Conflicts) == 0
}
