package merge

import "../diff"
import "../index"
import "../object"
import "../store"

// Renames in a merge (#786): a file one side renamed and the other side only edited merges at its new name, with the
// edit in it, instead of conflicting as a deletion against an edit. The trees are rewritten before the merge: the
// editing side's file (and the base's) moves to the new name.

// followRenames rewrites base and other so that what side renamed (from base) is at its new name in both, when
// other changed the file in place and has nothing at the new name. It gives the three trees to merge.
fn followRenames[S store.ObjectStore](s mut S, base object.Id, side object.Id, other object.Id) !(object.Id, object.Id) {
	if base == object.NoId {
		return base, other
	}
	let moves = try diff.TreeDiff(mut s, base, side, true)
	mut renames = []diff.FileChange{}
	for m in moves {
		if m.Kind == diff.Kind.Renamed {
			renames = append(renames, m)
		}
	}
	if len(renames) == 0 {
		return base, other
	}
	mut bi = try index.FromTree(mut s, base)
	mut oi = try index.FromTree(mut s, other)
	mut moved = 0
	for m in renames {
		let be = bi.Find(m.OldPath)
		let oe = oi.Find(m.OldPath)
		let there = oi.Find(m.Path)
		if be == nil || oe == nil || there != nil {
			continue
		}
		oi.Remove(m.OldPath)
		oi.Set(index.Entry{Path: m.Path, Hash: oe.Hash, Mode: oe.Mode, Stage: 0, Size: 0, Mtime: 0, Ctime: 0, Inode: 0, Device: 0})
		bi.Remove(m.OldPath)
		bi.Set(index.Entry{Path: m.Path, Hash: be.Hash, Mode: be.Mode, Stage: 0, Size: 0, Mtime: 0, Ctime: 0, Inode: 0, Device: 0})
		moved += 1
	}
	if moved == 0 {
		return base, other
	}
	let nb = try index.WriteTree(mut s, bi)
	let no = try index.WriteTree(mut s, oi)
	return nb, no
}
