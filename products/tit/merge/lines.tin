package merge

import "../diff"

// Three-way line merge (#786), diff3's method: lines of the base that both sides keep, in step, are stable; each
// stretch between them is taken from the side that changed it, from either side when both made the same change,
// and is a conflict when both changed it differently. A conflict's lines common to both sides at its start and end
// are taken out of it, as git's zealous merge does.

// Hunk is one stretch of a merged file: lines taken cleanly, or a conflict with the base's, ours and theirs lines.
type Hunk enum {
	Clean([]str)
	Conflict([]str, []str, []str)
}

// keptIn maps each base line to its index on the other side when the edit script keeps it, else -1.
fn keptIn(es []diff.Edit, nbase i64) []i64 {
	mut out = make([]i64, nbase)
	for i in 0..nbase {
		out[i] = -1
	}
	mut i = 0
	mut j = 0
	for e in es {
		match e {
			Keep(n) => {
				for k in 0..n {
					out[i + k] = j + k
				}
				i += n
				j += n
			}
			Insert(n) => {
				j += n
			}
			Delete(n) => {
				i += n
			}
		}
	}
	return out
}

fn sameLines(a []str, b []str) bool {
	if len(a) != len(b) {
		return false
	}
	for i in 0..len(a) {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

// MergeLines merges ours and theirs, both changed from base, into hunks; clean is false when any hunk is a conflict.
fn MergeLines(base []str, ours []str, theirs []str) ([]Hunk, bool) {
	let ko = keptIn(diff.Diff(base, ours), len(base))
	let kt = keptIn(diff.Diff(base, theirs), len(base))
	mut hunks = []Hunk{}
	mut clean = true
	mut pending = []str{}
	mut i = 0
	mut o = 0
	mut t = 0
	for i < len(base) || o < len(ours) || t < len(theirs) {
		if i < len(base) && ko[i] == o && kt[i] == t {
			pending = append(pending, base[i])
			i += 1
			o += 1
			t += 1
			continue
		}
		mut i2 = i
		for i2 < len(base) && (ko[i2] < 0 || kt[i2] < 0) {
			i2 += 1
		}
		mut o2 = len(ours)
		mut t2 = len(theirs)
		if i2 < len(base) {
			o2 = ko[i2]
			t2 = kt[i2]
		}
		let b = base[i:i2]
		let x = ours[o:o2]
		let y = theirs[t:t2]
		if sameLines(x, b) {
			pending = append(pending, y...)
		} else if sameLines(y, b) || sameLines(x, y) {
			pending = append(pending, x...)
		} else {
			// lines both sides share at the start and the end stay out of the conflict
			mut pre = 0
			for pre < len(x) && pre < len(y) && x[pre] == y[pre] {
				pre += 1
			}
			mut suf = 0
			for suf < len(x) - pre && suf < len(y) - pre && x[len(x) - 1 - suf] == y[len(y) - 1 - suf] {
				suf += 1
			}
			pending = append(pending, x[0:pre]...)
			if len(pending) > 0 {
				hunks = append(hunks, Hunk.Clean(pending))
				pending = []str{}
			}
			hunks = append(hunks, Hunk.Conflict(b, x[pre:len(x) - suf], y[pre:len(y) - suf]))
			pending = append(pending, x[len(x) - suf:]...)
			clean = false
		}
		i = i2
		o = o2
		t = t2
	}
	if len(pending) > 0 {
		hunks = append(hunks, Hunk.Clean(pending))
	}
	return hunks, clean
}

// MergeText merges the texts line by line; a conflict is written between git's markers with the given labels.
fn MergeText(base str, ours str, theirs str, oursLabel str, theirsLabel str) (str, bool) {
	let (hunks, clean) = MergeLines(diff.Lines(base), diff.Lines(ours), diff.Lines(theirs))
	mut out = []u8{}
	for h in hunks {
		match h {
			Clean(ls) => {
				for l in ls {
					put(mut out, l)
				}
			}
			Conflict(_, x, y) => {
				put(mut out, "<<<<<<< {oursLabel}\n")
				for l in x {
					putLine(mut out, l)
				}
				put(mut out, "=======\n")
				for l in y {
					putLine(mut out, l)
				}
				put(mut out, ">>>>>>> {theirsLabel}\n")
			}
		}
	}
	return str(out), clean
}

fn put(out mut []u8, s str) {
	for i in 0..len(s) {
		out = append(out, s[i])
	}
}

// putLine writes a line inside a conflict, ending it with a newline when it had none.
fn putLine(out mut []u8, s str) {
	put(mut out, s)
	if len(s) == 0 || s[len(s) - 1] != '\n' {
		out = append(out, '\n')
	}
}
