package main

import "say"

fn badge(score i64) str {
    if score == 0 {
        return "beginner"
    }
    if score < 100 {
        return "explorer"
    }
    return "trailblazer"
}

fn main() {
    let name = "Tin"
    let rank = badge(120)
    mut total = 0
    for i in 0..4 {
        total += i
    }
    say.Line("Hello {name}, {rank}!")
    say.Line("Range total: {total}")
}
