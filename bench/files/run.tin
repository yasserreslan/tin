package main

import "../../tools/ci/ci"
import "../../tools/ci/nettest"
import "../benchlib"
import "mint"
import "quarry"
import "say"
import "tide"
import "twine"

// quarry.ReadFile of 10k files in request handlers (#357): io_uring versus helper threads.
//
// A server (bench/files/files.tin) answers GET /read?n=N by reading the core's next N of FILES files (SIZE bytes each, in the page
// cache after a warm-up pass) one after another. For each core count, the io_uring path (the default on Linux) and the helper threads
// (TIN_IO_URING=0) run in alternating rounds; each run keeps 4 connections per core busy for a fixed time and counts the files read in
// verified responses. Reported: median files/s, the server's CPU time per 1000 files, and the ratios. Numbers count only on Linux
// (toolchain/docs/PERFORMANCE.md).
//
// Usage: run [--files N] [--size BYTES] [--n PER_REQUEST] [--cores 1,2,4,8] [--rounds N] [--seconds S] [--dir PATH] [--json PATH]

// load keeps conns keep-alive connections busy for seconds (each wave sends one request on every connection, then reads every
// answer) and returns the files read.
fn load(port i64, conns i64, n i64, size i64, seconds f64) i64 {
	let want = mint.Itoa(n * size)
	mut clients = []nettest.Client{}
	for i in 0..conns {
		clients = append(clients, nettest.Open(port))
	}
	let end = tide.Now() + i64(seconds * 1000000000.0)
	mut done = 0
	for tide.Now() < end {
		for i in 0..conns {
			mut c = clients[i]
			c.Get("/read?n=" + mint.Itoa(n), "")
			clients[i] = c
		}
		for i in 0..conns {
			mut c = clients[i]
			let r = c.Answer(120.0)
			ci.Check(r.Ok && r.Status == 200 && r.Body == want, "request failed: status " + mint.Itoa(r.Status) + " body " + r.Body)
			clients[i] = c
			if tide.Now() <= end {
				done += n
			}
		}
	}
	for i in 0..conns {
		mut c = clients[i]
		c.Close()
	}
	return done
}

fn rings(pid i64) i64 {
	let o = ci.Sh("ls -l /proc/" + mint.Itoa(pid) + "/fd 2>/dev/null | grep -c io_uring", "", 5)
	return ci.Num(twine.TrimSpace(o.Stdout))
}

// Result of one run: files per second and CPU ms per 1000 files (-1 when unknown).
type One struct {
	Rate f64
	Cpu f64
}

fn runOne(exe str, cores i64, ring bool, files str, count i64, size i64, n i64, seconds f64, logDir str) One {
	let port = nettest.Port()
	mut set = []str{"TIN_CORES=" + mint.Itoa(cores), "FILES_DIR=" + files, "FILES_COUNT=" + mint.Itoa(count), "TIN_DEADLINE_MS=600000"}
	if !ring {
		set = append(set, "TIN_IO_URING=0")
	}
	let server = nettest.Start(exe, []str{}, set, ci.Join(logDir, "server.log"), port)
	server.Ready(20)
	let conns = 4 * cores
	load(port, conns, n, size, 1.0)
	let (c0, known) = benchlib.CpuSeconds(server.Pid)
	let t0 = tide.Now()
	let got = load(port, conns, n, size, seconds)
	let took = f64(tide.Now() - t0) / 1000000000.0
	let (c1, _) = benchlib.CpuSeconds(server.Pid)
	if known && ci.Linux() {
		let r = rings(server.Pid)
		ci.Check(!(ring && r == 0), "io_uring run made no ring (the kernel refuses io_uring?)")
		ci.Check(ring || r == 0, "TIN_IO_URING=0 run made a ring")
	}
	ci.Check(server.Running(), "server exited during the run")
	server.Stop()
	mut cpu = -1.0
	if known {
		cpu = (c1 - c0) * 1000000.0 / f64(got)
	}
	return One{Rate: f64(got) / took, Cpu: cpu}
}

fn pad(s str, width i64) str {
	mut out = s
	for len(out) < width {
		out = " " + out
	}
	return out
}

fn main() {
	let args = quarry.Args()
	mut count = 10000
	mut size = 4096
	mut n = 1000
	mut coreList = "1,2,4,8"
	mut rounds = 5
	mut seconds = 3.0
	mut dir = ""
	mut jsonPath = ""
	mut i = 1
	for i + 1 < len(args) {
		let flag = args[i]
		let v = args[i + 1]
		if flag == "--files" {
			count = ci.Num(v)
		} else if flag == "--size" {
			size = ci.Num(v)
		} else if flag == "--n" {
			n = ci.Num(v)
		} else if flag == "--cores" {
			coreList = v
		} else if flag == "--rounds" {
			rounds = ci.Num(v)
		} else if flag == "--seconds" {
			seconds = mint.ParseFloat(v) catch _ {
				3.0
			}
		} else if flag == "--dir" {
			dir = v
		} else if flag == "--json" {
			jsonPath = v
		} else {
			ci.Fail("unknown flag " + flag)
		}
		i += 2
	}
	mut cores = []i64{}
	for c in twine.Split(coreList, ",") {
		cores = append(cores, ci.Num(c))
	}
	let root = ci.Root()
	let out = ci.Join(root, "bin/bench-files")
	ci.Mkdirs(out)
	let exe = ci.Join(out, "files")
	ci.BuildTin("bench/files/files.tin", exe, "", []str{})
	if len(dir) == 0 {
		dir = out
	}
	let files = ci.TempDir(dir, "tin-bench-files-")
	// random contents: a page cache hit per file after the warm-up, no compression or deduplication below
	let make = ci.Sh("i=0; while [ $i -lt " + mint.Itoa(count) + " ]; do head -c " + mint.Itoa(size) + " /dev/urandom > " + files + "/f$i; i=$((i+1)); done", "", 3600)
	ci.Must(make, "make the files")
	let modes = []str{"helper", "io_uring"}
	mut rates = [][]f64{}
	mut cpus = [][]f64{}
	for k in 0..len(cores) * 2 {
		rates = append(rates, []f64{})
		cpus = append(cpus, []f64{})
	}
	for rnd in 0..rounds {
		for ci_ in 0..len(cores) {
			for m in benchlib.Order(modes, rnd) {
				mut mi = 0
				if m == "io_uring" {
					mi = 1
				}
				let one = runOne(exe, cores[ci_], mi == 1, files, count, size, n, seconds, out)
				rates[ci_ * 2 + mi] = append(rates[ci_ * 2 + mi], one.Rate)
				if one.Cpu >= 0.0 {
					cpus[ci_ * 2 + mi] = append(cpus[ci_ * 2 + mi], one.Cpu)
				}
				say.Line("# " + "round " + mint.Itoa(rnd + 1) + ", " + mint.Itoa(cores[ci_]) + " cores, " + m + " " + benchlib.Fixed(one.Rate, 0) + " files/s")
			}
		}
	}
	ci.Remove(files)
	say.Line("quarry.ReadFile of " + mint.Itoa(count) + " files of " + mint.Itoa(size) + " bytes, " + mint.Itoa(n) + " per request, 4 connections per core, " + mint.Itoa(rounds) + " rounds of " + benchlib.Fixed(seconds, 0) + " s, medians")
	say.Line(pad("cores", 5) + "  " + pad("helper files/s", 14) + "  " + pad("io_uring files/s", 16) + "  " + pad("uring/helper", 12) + "  " + pad("helper CPU ms/1k", 16) + "  " + pad("io_uring CPU ms/1k", 18))
	for c in 0..len(cores) {
		let h = benchlib.Median(rates[c * 2])
		let u = benchlib.Median(rates[c * 2 + 1])
		mut ch = "-"
		mut cu = "-"
		if len(cpus[c * 2]) > 0 {
			ch = benchlib.Fixed(benchlib.Median(cpus[c * 2]), 2)
		}
		if len(cpus[c * 2 + 1]) > 0 {
			cu = benchlib.Fixed(benchlib.Median(cpus[c * 2 + 1]), 2)
		}
		say.Line(pad(mint.Itoa(cores[c]), 5) + "  " + pad(benchlib.Fixed(h, 0), 14) + "  " + pad(benchlib.Fixed(u, 0), 16) + "  " + pad(benchlib.Fixed(u / h, 2) + "x", 12) + "  " + pad(ch, 16) + "  " + pad(cu, 18))
	}
	for c in 1..len(cores) {
		say.Line(mint.Itoa(cores[c]) + " cores / " + mint.Itoa(cores[0]) + ": helper " + benchlib.Fixed(benchlib.Median(rates[c * 2]) / benchlib.Median(rates[0]), 2) + "x, io_uring " + benchlib.Fixed(benchlib.Median(rates[c * 2 + 1]) / benchlib.Median(rates[1]), 2) + "x")
	}
	if len(jsonPath) > 0 {
		mut samples = []str{}
		mut cpuText = []str{}
		for c in 0..len(cores) {
			for mi in 0..2 {
				samples = append(samples, benchlib.Quote(mint.Itoa(cores[c]) + " " + modes[mi]) + ": " + benchlib.NumList(rates[c * 2 + mi]))
				cpuText = append(cpuText, benchlib.Quote(mint.Itoa(cores[c]) + " " + modes[mi]) + ": " + benchlib.NumList(cpus[c * 2 + mi]))
			}
		}
		ci.Write(jsonPath, "{{\n \"files\": " + mint.Itoa(count) + ", \"size\": " + mint.Itoa(size) + ", \"per_request\": " + mint.Itoa(n) + ", \"rounds\": " + mint.Itoa(rounds) + ", \"seconds\": " + benchlib.Num(seconds) + ",\n \"samples\": {{" + twine.Join(samples, ", ") + "}},\n \"cpu_ms_per_1k\": {{" + twine.Join(cpuText, ", ") + "}}\n}}\n")
	}
}
