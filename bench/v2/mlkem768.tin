package main

import "say"
import "seal"

// 200 ML-KEM-768 key generations, encapsulations and decapsulations (#479), the seed and the
// message SHA-512 and SHA-256 of a counter.
fn main() {
	mut acc = seal.Sha256("")
	for i in 0..200 {
		let (dk, ek) = seal.MLKEM768KeyFromSeed(seal.Sha512(say.Fmt("seed %d", i))) catch e {
			say.Line(e)
			return
		}
		let (k, ct) = seal.MLKEM768EncapsulateDerand(ek, seal.Sha256(say.Fmt("message %d", i))) catch e {
			say.Line(e)
			return
		}
		let k2 = seal.MLKEM768Decapsulate(dk, ct) catch e {
			say.Line(e)
			return
		}
		acc = seal.Sha256(str(acc) + str(ek) + str(ct) + str(k) + str(k2))
	}
	say.Line(seal.Hex(acc))
}
