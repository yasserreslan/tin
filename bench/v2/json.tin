package main

import "say"
import "argo"

type Item struct {
	ID   i64
	Name str
	Qty  u32
	Tags []str
	OK   bool
	Note str
}

func main() {
	items := make([]Item, 0, 10)
	for i := i64(0); i < 10; i++ {
		items = append(items, Item{ID: i * 7919, Name: say.Fmt("item-%d", i), Qty: u32(i * 3), Tags: []str{"a", "bb", say.Fmt("t%d", i)}, OK: i%2 == 0, Note: "quote \"here\" and\nnewline"})
	}
	b := make([]u8, 0, 4096)
	total := i64(0)
	for i := 0; i < 1000000; i++ {
		b = b[:0]
		argo.Put(mut b, items)
		total += len(b)
	}
	say.Line(total)
	say.Line(str(b))
}
