package main

import "say"
import "lasso"

// The regular-expression benchmark: the fields of 1000 generated log lines, extracted with four
// patterns (the whole line with named groups, the address, the request line and every word).
// bench/v2/regex.go does the same and must print the same lines.

fn line(i i64) str {
	let ip = say.Fmt("10.%d.%d.%d", i%256, i*7%256, i*13%256)
	let path = say.Fmt("/a/%d/b.html", i%50)
	return say.Fmt("%s - - [10/Oct/2024:13:55:%02d +0000] \"GET %s HTTP/1.1\" %d %d", ip, i%60, path, 200+i%5, 100+i*37%9000)
}

fn main() {
	let full = lasso.MustCompile(`^(?P<ip>\d+\.\d+\.\d+\.\d+) - - \[(?P<time>[^\]]+)\] "(?P<method>[A-Z]+) (?P<path>[^ ]+) HTTP/(?P<ver>\d\.\d)" (?P<status>\d{3}) (?P<size>\d+)$`)
	let ipre = lasso.MustCompile(`\d+\.\d+\.\d+\.\d+`)
	let req = lasso.MustCompile(`"([A-Z]+) ([^ ]+) HTTP/\d\.\d" (\d{3}) (\d+)`)
	let word = lasso.MustCompile(`[a-z]+`)
	mut h i64 = 0
	mut fields i64 = 0
	for i in 0..1000 {
		let s = line(i64(i))
		for _, p in full.Submatch(s) {
			if p != nil {
				fields += 1
				for k in 0..len(p) {
					h = h*%1000003 +% i64(p[k])
				}
			}
		}
		for _, m in ipre.FindAll(s, -1) {
			h = h*%1000003 +% (m.End - m.Start)
		}
		for _, p in req.Submatch(s) {
			if p != nil {
				h = h*%1000003 +% i64(len(p))
			}
		}
		for _, m in word.FindAll(s, -1) {
			h = h*%1000003 +% m.Start
		}
	}
	say.Line("fields", fields, "hash", h)
}
