package main

import "say"
import "sift"

extern func clock_gettime_nsec_np(clk i64) i64

// checksum folds xs into one wrapping i64.
func checksum(xs []i64) i64 {
	h := i64(0)
	for _, v := range xs {
		h = h*1000003 + v
	}
	return h
}

func main() {
	n := i64(10000000)
	xs := make([]i64, n)
	k := i64(12345)
	for i := i64(0); i < n; i++ {
		k = k*6364136223846793005 + 1442695040888963407
		xs[i] = k
	}
	ys := make([]i64, n)
	copy(ys, xs)
	fs := make([]f64, n)
	for i := i64(0); i < n; i++ {
		fs[i] = f64(xs[i]>>20) / 1024.0
	}
	t0 := clock_gettime_nsec_np(4)
	sift.Ints(mut xs)
	t1 := clock_gettime_nsec_np(4)
	say.Line("ints", sift.IsSortedInts(xs), checksum(xs), xs[0], xs[n-1])
	t2 := clock_gettime_nsec_np(4)
	sift.StableInts(mut ys)
	t3 := clock_gettime_nsec_np(4)
	say.Line("stable", sift.IsSortedInts(ys), checksum(ys))
	t4 := clock_gettime_nsec_np(4)
	sift.F64s(mut fs)
	t5 := clock_gettime_nsec_np(4)
	say.Out("f64s %.3f %.3f\n", fs[0], fs[n-1])
	t6 := clock_gettime_nsec_np(4)
	sift.Ints(mut xs)
	t7 := clock_gettime_nsec_np(4)
	say.Line("presorted", sift.IsSortedInts(xs))
	say.Out("ms ints %d stable %d f64s %d presorted %d\n", (t1-t0)/1000000, (t3-t2)/1000000, (t5-t4)/1000000, (t7-t6)/1000000)
}
