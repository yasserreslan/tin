package main

import "say"
import "sift"

// checksum folds xs into one i64, modulo 2^64.
@wrap fn checksum(xs []i64) i64 {
	mut h = i64(0)
	for _, v in xs {
		h = h*1000003 + v
	}
	return h
}

// lcg advances the 64-bit linear congruential generator (modulo 2^64).
@wrap fn lcg(k i64) i64 {
	return k*6364136223846793005 + 1442695040888963407
}

fn main() {
	let n = i64(10000000)
	let xs = make([]i64, n)
	mut k = i64(12345)
	for i in i64(0)..n {
		k = lcg(k)
		xs[i] = k
	}
	let ys = make([]i64, n)
	copy(ys, xs)
	let fs = make([]f64, n)
	for i in i64(0)..n {
		fs[i] = f64(xs[i]>>20) / 1024.0
	}

	sift.Ints(mut xs)

	say.Line("ints", sift.IsSortedInts(xs), checksum(xs), xs[0], xs[n-1])

	sift.StableInts(mut ys)

	say.Line("stable", sift.IsSortedInts(ys), checksum(ys))

	sift.F64s(mut fs)

	say.Out("f64s %.3f %.3f\n", fs[0], fs[n-1])

	sift.Ints(mut xs)

	say.Line("presorted", sift.IsSortedInts(xs))
}
