package main

import "say"

extern func sqrt(x f64) f64

func a(i i64, j i64) f64 {
	return 1.0 / f64((i+j)*(i+j+1)/2+i+1)
}

func mulAv(v []f64, av mut []f64) {
	n := len(v)
	for i := i64(0); i < n; i++ {
		sum := 0.0
		for j := i64(0); j < n; j++ {
			sum += a(i, j) * v[j]
		}
		av[i] = sum
	}
}

func mulAtv(v []f64, atv mut []f64) {
	n := len(v)
	for i := i64(0); i < n; i++ {
		sum := 0.0
		for j := i64(0); j < n; j++ {
			sum += a(j, i) * v[j]
		}
		atv[i] = sum
	}
}

func mulAtAv(v []f64, out mut []f64, tmp mut []f64) {
	mulAv(v, mut tmp)
	mulAtv(tmp, mut out)
}

func main() {
	n := i64(5500)
	u := make([]f64, n)
	v := make([]f64, n)
	tmp := make([]f64, n)
	for i := i64(0); i < n; i++ {
		u[i] = 1.0
	}
	for i := 0; i < 10; i++ {
		mulAtAv(u, mut v, mut tmp)
		mulAtAv(v, mut u, mut tmp)
	}
	vBv := 0.0
	vv := 0.0
	for i := i64(0); i < n; i++ {
		vBv += u[i] * v[i]
		vv += v[i] * v[i]
	}
	say.Out("%.9f\n", sqrt(vBv/vv))
}
