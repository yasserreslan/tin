package main

import "say"
import "abacus"

// The big-integer benchmark: the factorial of 5000, then twenty 2048-bit modular exponentiations
// with growing bases and exponents.

fn main() {
	mut f = abacus.FromI64(1)
	for i in 1..5001 {
		f = f.Mul(abacus.FromI64(i64(i)))
	}
	let s = f.Str()
	mut digitSum = i64(0)
	for i in 0..len(s) {
		digitSum += i64(s[i] - '0')
	}
	say.Line("factorial", len(s), digitSum)

	// 2^2048 - 1 as the modulus.
	let zero = abacus.FromI64(0)
	let m = abacus.FromI64(2).Exp(abacus.FromI64(2048), zero).Sub(abacus.FromI64(1))
	mut h = i64(0)
	for i in 0..20 {
		let base = abacus.FromI64(3).Exp(abacus.FromI64(500 + i64(i)), zero)
		let r = base.Exp(abacus.FromI64(65537 + i64(i)), m)
		let t = r.Text(16)
		h = h*%1000003 +% i64(len(t))
		h = h*%1000003 +% i64(t[0])
		h = h*%1000003 +% i64(t[len(t)-1])
	}
	say.Line("modpow", h)
}
