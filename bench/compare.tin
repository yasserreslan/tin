package main

import "../tools/ci/ci"
import "./benchlib"
import "mint"
import "quarry"
import "say"
import "twine"

// Compare two Tin revisions using their own compiler AND runtime/library trees.
//
// Usage: compare --base-root PATH [--head-root PATH] [--suite cpu|http] [--bench-dir DIR] [--runs N] [--rounds N] [--seconds N] [--json PATH] [NAME...]

fn usage(message str) {
	say.Line("compare: " + message)
	quarry.Exit(2)
}

fn isDir(path str) bool {
	return quarry.IsDir(path)
}

fn main() {
	// Benchmarks measure raw allocation; a plain program past 512 MiB of pool (binary-trees) would print the #629 warning, which the
	// output comparison would count as a difference.
	let root = ci.Root()
	let args = quarry.Args()
	mut baseRoot = ""
	mut headRoot = root
	mut suite = "cpu"
	mut benchDir = ci.Join(root, "bench/v2")
	mut runs = 7
	mut rounds = 5
	mut seconds = 10
	mut jsonPath = ""
	mut selected = []str{}
	mut i = 1
	for i < len(args) {
		let a = args[i]
		if a == "--base-root" && i + 1 < len(args) {
			baseRoot = args[i + 1]
			i += 1
		} else if a == "--head-root" && i + 1 < len(args) {
			headRoot = args[i + 1]
			i += 1
		} else if a == "--suite" && i + 1 < len(args) {
			suite = args[i + 1]
			i += 1
		} else if a == "--bench-dir" && i + 1 < len(args) {
			benchDir = args[i + 1]
			i += 1
		} else if a == "--runs" && i + 1 < len(args) {
			runs = ci.Num(args[i + 1])
			i += 1
		} else if a == "--rounds" && i + 1 < len(args) {
			rounds = ci.Num(args[i + 1])
			i += 1
		} else if a == "--seconds" && i + 1 < len(args) {
			seconds = ci.Num(args[i + 1])
			i += 1
		} else if a == "--json" && i + 1 < len(args) {
			jsonPath = args[i + 1]
			i += 1
		} else if twine.HasPrefix(a, "--") {
			usage("unknown option " + a)
		} else {
			selected = append(selected, a)
		}
		i += 1
	}
	if len(baseRoot) == 0 {
		usage("--base-root is required")
	}
	if runs < 7 || rounds < 5 || seconds < 1 {
		usage("require at least 7 CPU runs, 5 HTTP rounds and positive duration")
	}
	let base = resolve(baseRoot)
	let head = resolve(headRoot)
	for r in []str{base, head} {
		if !ci.Exists(ci.Join(r, "bin/tinc")) || !(isDir(ci.Join(r, "toolchain/runtime")) || isDir(ci.Join(r, "lib"))) {
			usage("build " + r + " with make bootstrap first (compiler and library required)")
		}
	}
	let output = ci.Join(root, "bin/bench")
	ci.Mkdirs(output)
	let work = ci.TempDir(output, "compare-")
	if suite == "cpu" {
		let records = cpu(base, head, resolve(benchDir), selected, runs, work)
		if len(jsonPath) > 0 {
			ci.Mkdirs(jsonPath[0:twine.LastIndex(jsonPath, "/")])
			ci.Write(jsonPath, "{{\n  \"base_root\": " + benchlib.Quote(base) + ",\n  \"head_root\": " + benchlib.Quote(head) + ",\n  \"runs\": " + mint.Itoa(runs) + ",\n  \"results\": [\n" + twine.Join(records, ",\n") + "\n  ]\n}}\n")
		}
	} else {
		if len(selected) > 0 {
			usage("benchmark names apply only to the CPU suite")
		}
		for label in []str{"base", "head"} {
			mut tree = base
			if label == "head" {
				tree = head
			}
			let c = benchlib.TinCommand(tree, ci.Join(head, "examples/api.tin"), ci.Join(work, label), "")
			let built = benchlib.RunChecked(c, 180) catch err {
				ci.Fail(say.Str(err))
				panic("unreachable")
			}
			if built.Seconds < 0.0 {
				ci.Fail("unreachable")
			}
		}
		mut command = []str{"sh", "tools/ci/tin.sh", "bench/http/run_wrk.tin", "1", "2", "100", mint.Itoa(seconds), mint.Itoa(rounds), "--base-api", ci.Join(work, "base"), "--head-api", ci.Join(work, "head")}
		if len(jsonPath) > 0 {
			command = append(command, "--json")
			command = append(command, resolve(jsonPath))
		}
		let o = ci.ExecEnv(command, root, 36000, []str{}, []str{})
		say.Out("%s", o.Stdout)
		ci.Must(o, "the HTTP comparison")
	}
	ci.Remove(work)
}

fn resolve(path str) str {
	if twine.HasPrefix(path, "/") {
		return path
	}
	return ci.Join(ci.Root(), path)
}

fn cpu(base str, head str, suite str, selected []str, runs i64, work str) []str {
	let names = benchlib.BenchmarkNames(suite, selected) catch err {
		usage(say.Str(err))
		return []str{}
	}
	mut records = []str{}
	say.Line("| benchmark | base ms | head ms | head/base time | review |")
	say.Line("|---|---:|---:|---:|---|")
	for name in names {
		let baseExe = ci.Join(work, name + "_base")
		let headExe = ci.Join(work, name + "_head")
		let source = ci.Join(suite, name + ".tin")
		mut baseBuilds = true
		benchlib.RunChecked(benchlib.TinCommand(base, source, baseExe, ""), 180) catch _ {
			baseBuilds = false
		}
		if !baseBuilds {
			// a benchmark of something base does not have yet
			say.Line("| " + name + " | - | - | - | new: base cannot build it |")
			records = append(records, "    {{\"benchmark\": " + benchlib.Quote(name) + ", \"new_in_head\": true}}")
			continue
		}
		benchlib.RunChecked(benchlib.TinCommand(head, source, headExe, ""), 180) catch err {
			ci.Fail(say.Str(err))
			panic("unreachable")
		}
		let commands = []benchlib.Command{benchlib.Command{Argv: []str{baseExe}, Dir: "", Set: []str{"LC_ALL=C", "TIN_POOL_WARN_MB=0"}}, benchlib.Command{Argv: []str{headExe}, Dir: "", Set: []str{"LC_ALL=C", "TIN_POOL_WARN_MB=0"}}}
		let timing = benchlib.Interleaved([]str{"base", "head"}, commands, runs, true, benchlib.DefaultRunner()) catch err {
			ci.Fail(say.Str(err))
			panic("unreachable")
		}
		let ratio = timing.MedianOf("head") / timing.MedianOf("base")
		let review = ratio > 1.05
		mut verdict = "within 5%"
		if review {
			verdict = "REVIEW (>5%)"
		}
		say.Line("| " + name + " | " + benchlib.Fixed(timing.MedianOf("base") * 1000.0, 2) + " | " + benchlib.Fixed(timing.MedianOf("head") * 1000.0, 2) + " | " + benchlib.Fixed(ratio, 3) + " | " + verdict + " |")
		mut flag = "false"
		if review {
			flag = "true"
		}
		records = append(records, "    {{\"benchmark\": " + benchlib.Quote(name) + ", \"seconds\": {{\"base\": " + benchlib.NumList(timing.SamplesOf("base")) + ", \"head\": " + benchlib.NumList(timing.SamplesOf("head")) + "}}, \"head_over_base\": " + benchlib.Num(ratio) + ", \"needs_review\": " + flag + "}}")
	}
	return records
}
