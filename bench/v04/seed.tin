package main

import "../../tools/ci/ci"
import "mint"
import "quarry"
import "say"
import "twine"

// Prints SQL that creates the benchmark's users table with N rows (default 10000).

fn two(v i64) str {
	let s = "0" + mint.Itoa(v)
	return s[len(s) - 2:]
}

fn main() {
	let args = quarry.Args()
	mut n = 10000
	if len(args) > 1 {
		n = ci.Num(args[1])
	}
	say.Line("DROP TABLE IF EXISTS users;")
	say.Line("CREATE TABLE users (id BIGINT PRIMARY KEY, name VARCHAR(64) NOT NULL, email VARCHAR(128) NOT NULL, score DOUBLE NOT NULL, created DATETIME NOT NULL);")
	mut start = 1
	for start <= n {
		mut rows = []str{}
		let end = start + 1000
		for i in start..end {
			if i > n {
				break
			}
			let id = mint.Itoa(i)
			rows = append(rows, "(" + id + ", 'user " + id + "', 'user" + id + "@example.com', " + mint.Itoa(i % 1000) + "." + two(i % 100) + ", '2024-" + two(i % 12 + 1) + "-" + two(i % 28 + 1) + " " + two(i % 24) + ":" + two(i % 60) + ":" + two(i * 7 % 60) + "')")
		}
		say.Line("INSERT INTO users VALUES " + twine.Join(rows, ", ") + ";")
		start = end
	}
}
