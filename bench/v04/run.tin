package main

import "../../tools/ci/ci"
import "../../tools/ci/nettest"
import "../benchlib"
import "mint"
import "say"
import "twine"
import "wire"

// v0.4 benchmark: GET /users/{id} (Redis cache over MySQL) in Tin vs Go + chi, under wrk2.
//
// Needs a Redis and a MySQL with the users table (sh tools/ci/tin.sh bench/v04/seed) and a wrk2 binary:
//   REDIS_ADDR MYSQL_ADDR MYSQL_USER MYSQL_PASSWORD MYSQL_DATABASE WRK2 [CORES=4 ROUNDS=3 SECS=15]
//   [SERVER_CPUS=0,1 WRK_CPUS=2,3]  pin the servers and wrk2 to separate CPUs (taskset)
//
// Scenarios (random ids in 1..10000):
//   cached   all reads hit Redis (warmed first)
//   db       /db/users/{id}: every read is a MySQL prepared statement
//   mixed    cached reads with 0.5% /slow (50 ms) requests mixed in
// Before every run Redis is emptied and the run warms its own cache, so all its keys are fresh: their 60 s TTL cannot expire during a
// run and send a burst of reads to MySQL. Redis snapshots (a fork every minute under the default config) are turned off for the same
// reason. Each runs once at an open-ended rate (the maximum throughput) and once at a fixed rate, 70% of the slower server's maximum,
// for the latency percentiles (wrk2 corrects for coordinated omission). Rounds alternate servers; the median of the rounds is reported,
// with every round's value and the Tin/Go ratios after the table.

type Scenario struct {
	Name str
	Prefix str
	Slow str
}

// Run is one wrk2 run: the rate, the latency percentiles (microseconds) and the errors it reported.
type Run struct {
	Rps f64
	P50 f64
	P99 f64
	P999 f64
	Errors []str
	Rss i64
	PerCpu f64
	Target i64
}

fn pinned(cpus str, argv []str) []str {
	if len(cpus) == 0 {
		return argv
	}
	mut out = []str{"taskset", "-c", cpus}
	for a in argv {
		out = append(out, a)
	}
	return out
}

fn redis(addr str, parts []str) {
	let c = wire.DialTimeout(addr, 10000000000) catch _ {
		ci.Fail("cannot connect to redis at " + addr)
		panic("unreachable")
	}
	mut text = "*" + mint.Itoa(len(parts)) + "\r\n"
	for p in parts {
		text += "$" + mint.Itoa(len(p)) + "\r\n" + p + "\r\n"
	}
	c.Write(text) catch _ {
		ci.Fail("cannot write to redis")
	}
	mut buf = []u8{}
	let reader = c
	within 10000000000 {
		try reader.Read(mut buf, 256)
	} catch _ {
		0
	}
	c.Close()
	ci.Check(twine.HasPrefix(str(buf), "+OK"), "redis " + twine.Join(parts, " ") + ": " + str(buf))
}

// micros reads a wrk2 latency such as 1.20ms.
fn micros(v str) f64 {
	mut unit = ""
	mut scale = 1.0
	if twine.HasSuffix(v, "us") {
		unit = "us"
	} else if twine.HasSuffix(v, "ms") {
		unit = "ms"
		scale = 1000.0
	} else if twine.HasSuffix(v, "m") {
		unit = "m"
		scale = 60000000.0
	} else if twine.HasSuffix(v, "s") {
		unit = "s"
		scale = 1000000.0
	}
	ci.Check(len(unit) > 0, "unknown latency " + v)
	let n = mint.ParseFloat(v[0:len(v) - len(unit)]) catch _ {
		ci.Fail("bad latency " + v)
		0.0
	}
	return n * scale
}

fn wrk2(wrk str, cpus str, threads str, conns i64, port i64, s Scenario, rate i64, secs i64) Run {
	let here = ci.Join(ci.Root(), "bench/v04")
	let argv = pinned(cpus, []str{wrk, "-t" + threads, "-c" + mint.Itoa(conns), "-d" + mint.Itoa(secs) + "s", "-R" + mint.Itoa(rate), "--latency", "-s", ci.Join(here, "mix.lua"), "http://127.0.0.1:" + mint.Itoa(port), "--", s.Prefix, s.Slow})
	let o = ci.Exec(argv, "", secs + 120)
	let out = o.Stdout
	mut rps = -1.0
	mut errors = []str{}
	mut p50 = 0.0
	mut p99 = 0.0
	mut p999 = 0.0
	for line in ci.Lines(out) {
		let t = twine.TrimSpace(line)
		if twine.HasPrefix(t, "Requests/sec:") {
			rps = mint.ParseFloat(twine.TrimSpace(t[len("Requests/sec:"):])) catch _ {
				-1.0
			}
		} else if twine.HasPrefix(t, "Non-2xx or 3xx responses:") || twine.HasPrefix(t, "Socket errors:") {
			errors = append(errors, t)
		} else if twine.Contains(t, "%") {
			let w = twine.Fields(t)
			if len(w) == 2 && twine.HasSuffix(w[0], "%") {
				if w[0] == "50.000%" {
					p50 = micros(w[1])
				} else if w[0] == "99.000%" {
					p99 = micros(w[1])
				} else if w[0] == "99.900%" {
					p999 = micros(w[1])
				}
			}
		}
	}
	ci.Check(rps >= 0.0, "wrk2 (exit " + mint.Itoa(o.Code) + ") gave no rate:\n" + out + "\n" + o.Stderr)
	return Run{Rps: rps, P50: p50, P99: p99, P999: p999, Errors: errors, Rss: 0, PerCpu: 0.0, Target: rate}
}

fn med(runs []Run, pick fn(Run) f64) f64 {
	mut v = []f64{}
	for r in runs {
		v = append(v, pick(r))
	}
	return benchlib.Median(v)
}

fn joined(xs []f64, scale f64, decimals i64) str {
	mut parts = []str{}
	for x in xs {
		parts = append(parts, benchlib.Fixed(x / scale, decimals))
	}
	return twine.Join(parts, " ")
}

fn col(s str, width i64) str {
	mut out = s
	for len(out) < width {
		out = " " + out
	}
	return out
}

fn left(s str, width i64) str {
	mut out = s
	for len(out) < width {
		out = out + " "
	}
	return out
}

fn main() {
	let root = ci.Root()
	let outDir = ci.Join(root, "bin/bench04")
	ci.Mkdirs(outDir)
	let cores = benchlib.Env("CORES", "4")
	let rounds = ci.Num(benchlib.Env("ROUNDS", "3"))
	let secs = ci.Num(benchlib.Env("SECS", "15"))
	let conns = ci.Num(benchlib.Env("CONNS", "256"))
	let threads = benchlib.Env("THREADS", "4")
	let serverCpus = benchlib.Env("SERVER_CPUS", "")
	let wrkCpus = benchlib.Env("WRK_CPUS", "")
	let wrk = ci.Env("WRK2")
	ci.Check(len(wrk) > 0, "set WRK2 to a wrk2 binary")
	let redisAddr = ci.Env("REDIS_ADDR")
	ci.Check(len(redisAddr) > 0, "set REDIS_ADDR")
	ci.BuildTin("bench/v04/users.tin", ci.Join(outDir, "users_tin"), "", []str{})
	ci.Must(ci.Exec([]str{"go", "build", "-o", ci.Join(outDir, "users_go"), "."}, ci.Join(root, "bench/v04/go"), 600), "go build")
	redis(redisAddr, []str{"CONFIG", "SET", "save", ""})
	let scenarios = []Scenario{Scenario{Name: "cached", Prefix: "/users/", Slow: "0"}, Scenario{Name: "db", Prefix: "/db/users/", Slow: "0"}, Scenario{Name: "mixed", Prefix: "/users/", Slow: "0.5"}}
	let names = []str{"tin", "go"}
	// maxes[scenario*2+server], fixed[...]
	mut maxes = [][]Run{}
	mut fixed = [][]Run{}
	for s in scenarios {
		let base = len(maxes)
		maxes = append(maxes, []Run{})
		maxes = append(maxes, []Run{})
		fixed = append(fixed, []Run{})
		fixed = append(fixed, []Run{})
		for phase in 0..2 {
			mut target = 1000000
			if phase == 1 {
				let a = med(maxes[base], fn(r Run) f64 {
					return r.Rps
				})
				let b = med(maxes[base + 1], fn(r Run) f64 {
					return r.Rps
				})
				mut lower = a
				if b < a {
					lower = b
				}
				target = i64(0.7 * lower)
			}
			for r in 0..rounds {
				for name in benchlib.Order(names, r) {
					redis(redisAddr, []str{"FLUSHALL"})
					mut port = 9190
					mut exe = "users_tin"
					mut idx = 0
					if name == "go" {
						port = 9191
						exe = "users_go"
						idx = 1
					}
					mut launcher = ci.Join(outDir, exe)
					mut launchArgs = []str{}
					if len(serverCpus) > 0 {
						launcher = "taskset"
						launchArgs = []str{"-c", serverCpus, ci.Join(outDir, exe)}
					}
					let server = nettest.Start(launcher, launchArgs, []str{"TIN_CORES=" + cores, "GOMAXPROCS=" + cores}, ci.Join(outDir, name + ".log"), port)
					server.Ready(10)
					wrk2(wrk, wrkCpus, threads, conns, port, s, target, 3)
					if phase == 0 {
						let (_, c0) = benchlib.ProcessStats(server.Pid)
						let run = wrk2(wrk, wrkCpus, threads, conns, port, s, target, secs)
						let (rss, c1) = benchlib.ProcessStats(server.Pid)
						let busy = c1 - c0
						mut floor = busy
						if floor < 0.001 {
							floor = 0.001
						}
						maxes[base + idx] = append(maxes[base + idx], Run{Rps: run.Rps, P50: 0.0, P99: 0.0, P999: 0.0, Errors: run.Errors, Rss: rss, PerCpu: run.Rps * f64(secs) / floor, Target: target})
					} else {
						let run = wrk2(wrk, wrkCpus, threads, conns, port, s, target, secs)
						fixed[base + idx] = append(fixed[base + idx], run)
					}
					server.Stop()
				}
			}
		}
	}
	say.Line("cores per server: " + cores + ", wrk2 -t" + threads + " -c" + mint.Itoa(conns) + ", " + mint.Itoa(secs) + " s per run, median of " + mint.Itoa(rounds) + " rounds")
	if len(serverCpus) > 0 || len(wrkCpus) > 0 {
		mut sc = serverCpus
		mut wc = wrkCpus
		if len(sc) == 0 {
			sc = "any"
		}
		if len(wc) == 0 {
			wc = "any"
		}
		say.Line("server CPUs: " + sc + ", wrk2 CPUs: " + wc)
	}
	say.Line(left("scenario", 8) + " " + left("", 4) + " " + col("max req/s", 12) + " " + col("req/cpu-s", 10) + " " + col("fixed req/s", 12) + " " + col("p50 ms", 10) + " " + col("p99 ms", 10) + " " + col("p99.9 ms", 10) + " " + col("RSS MB", 8))
	for si in 0..len(scenarios) {
		for k in 0..2 {
			let mx = maxes[si * 2 + k]
			let fx = fixed[si * 2 + k]
			mut errs = []str{}
			for r in mx {
				for e in r.Errors {
					errs = append(errs, e)
				}
			}
			for r in fx {
				for e in r.Errors {
					errs = append(errs, e)
				}
			}
			say.Line(left(scenarios[si].Name, 8) + " " + left(names[k], 4) + " " + col(benchlib.Fixed(med(mx, fn(r Run) f64 {
				return r.Rps
				}), 0), 12) + " " + col(benchlib.Fixed(med(mx, fn(r Run) f64 {
					return r.PerCpu
					}), 0), 10) + " " + col(mint.Itoa(fx[0].Target), 12) + " " + col(benchlib.Fixed(med(fx, fn(r Run) f64 {
					return r.P50
					}) / 1000.0, 2), 10) + " " + col(benchlib.Fixed(med(fx, fn(r Run) f64 {
					return r.P99
					}) / 1000.0, 2), 10) + " " + col(benchlib.Fixed(med(fx, fn(r Run) f64 {
					return r.P999
					}) / 1000.0, 2), 10) + " " + col(benchlib.Fixed(med(mx, fn(r Run) f64 {
					return f64(r.Rss)
					}) / 1024.0, 0), 8) + " " + twine.Join(unique(errs), " "))
		}
	}
	say.Line("")
	say.Line("every round (in run order): max req/s | fixed-rate p99 ms")
	for si in 0..len(scenarios) {
		for k in 0..2 {
			mut rates = []f64{}
			for r in maxes[si * 2 + k] {
				rates = append(rates, r.Rps)
			}
			mut p99s = []f64{}
			for r in fixed[si * 2 + k] {
				p99s = append(p99s, r.P99)
			}
			say.Line(left(scenarios[si].Name, 8) + " " + left(names[k], 4) + " " + joined(rates, 1.0, 0) + " | " + joined(p99s, 1000.0, 2))
		}
	}
	say.Line("")
	say.Line("Tin/Go ratios of the medians (above 1: Tin higher)")
	say.Line(left("scenario", 8) + " " + col("max req/s", 10) + " " + col("req/cpu-s", 10) + " " + col("p50", 10) + " " + col("p99", 10) + " " + col("p99.9", 10))
	for si in 0..len(scenarios) {
		let t = maxes[si * 2]
		let g = maxes[si * 2 + 1]
		let ft = fixed[si * 2]
		let fg = fixed[si * 2 + 1]
		let rps = med(t, fn(r Run) f64 {
			return r.Rps
		}) / med(g, fn(r Run) f64 {
			return r.Rps
		})
		let cpu = med(t, fn(r Run) f64 {
			return r.PerCpu
		}) / med(g, fn(r Run) f64 {
			return r.PerCpu
		})
		let p50 = med(ft, fn(r Run) f64 {
			return r.P50
		}) / med(fg, fn(r Run) f64 {
			return r.P50
		})
		let p99 = med(ft, fn(r Run) f64 {
			return r.P99
		}) / med(fg, fn(r Run) f64 {
			return r.P99
		})
		let p999 = med(ft, fn(r Run) f64 {
			return r.P999
		}) / med(fg, fn(r Run) f64 {
			return r.P999
		})
		say.Line(left(scenarios[si].Name, 8) + " " + col(benchlib.Fixed(rps, 2), 10) + " " + col(benchlib.Fixed(cpu, 2), 10) + " " + col(benchlib.Fixed(p50, 2), 10) + " " + col(benchlib.Fixed(p99, 2), 10) + " " + col(benchlib.Fixed(p999, 2), 10))
	}
}

fn unique(xs []str) []str {
	mut out = []str{}
	for x in xs {
		mut seen = false
		for o in out {
			if o == x {
				seen = true
			}
		}
		if !seen {
			out = append(out, x)
		}
	}
	return sortedStrs(out)
}

fn sortedStrs(xs []str) []str {
	mut out = []str{}
	for x in xs {
		out = append(out, x)
	}
	for i in 0..len(out) {
		for j in i + 1..len(out) {
			if out[j] < out[i] {
				let t = out[i]
				out[i] = out[j]
				out[j] = t
			}
		}
	}
	return out
}

// The server runs under taskset when SERVER_CPUS is set: nettest.Start runs "env NAME=... exe args", so taskset becomes the program.
