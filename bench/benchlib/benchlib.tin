// What the benchmark runners share: checked, alternating-order timing for CPU reference and revision comparisons (measure), parsers of
// the output of wrk and h2load that refuse errors, medians, process statistics and JSON text. Reference performance numbers come from
// native Linux (toolchain/docs/PERFORMANCE.md).
package benchlib

import "../../tools/ci/ci"
import "mint"
import "quarry"
import "say"
import "sift"
import "tide"
import "tinjson"
import "twine"

// Median is the middle of the values (the mean of the two middle ones for an even count).
fn Median(values []f64) f64 {
	mut xs = []f64{}
	for v in values {
		xs = append(xs, v)
	}
	sift.Sort(mut xs)
	let n = len(xs)
	if n == 0 {
		return 0.0
	}
	if n % 2 == 1 {
		return xs[n / 2]
	}
	return (xs[n / 2 - 1] + xs[n / 2]) / 2.0
}

// Num formats a number for JSON and tables: the shortest text that reads back as the same value.
fn Num(v f64) str {
	return mint.FormatFloat(v, 'f', -1)
}

// Fixed formats a number with this many decimals.
fn Fixed(v f64, decimals i64) str {
	return mint.FormatFloat(v, 'f', decimals)
}

fn Quote(s str) str {
	return tinjson.Quote(s)
}

// NumList is [a, b, c] as JSON.
fn NumList(values []f64) str {
	mut parts = []str{}
	for v in values {
		parts = append(parts, Num(v))
	}
	return "[" + twine.Join(parts, ", ") + "]"
}

// ---------------- measure ----------------

// Command is a program to run: its argv, working directory and extra environment entries (NAME=value).
type Command struct {
	Argv []str
	Dir str
	Set []str
}

// Timed is what one run produced: seconds, standard output and standard error.
type Timed struct {
	Seconds f64
	Stdout str
	Stderr str
}

// RunChecked runs the command, failing when it crashes or takes longer than the timeout; a failed run is never a sample.
fn RunChecked(c Command, seconds i64) !Timed {
	let start = tide.Now()
	let o = ci.ExecEnv(c.Argv, c.Dir, seconds, c.Set, []str{})
	let took = f64(tide.Now() - start) / 1000000000.0
	if o.Code != 0 {
		fail say.Fault("%s", "exit " + mint.Itoa(o.Code) + ": " + twine.Join(c.Argv, " ") + "\n" + o.Stderr)
	}
	return Timed{Seconds: took, Stdout: o.Stdout, Stderr: o.Stderr}
}

// Runner runs one command (tests substitute their own).
type Runner = fn(Command) !Timed

fn defaultRunner(c Command) !Timed {
	return try RunChecked(c, 180)
}

// DefaultRunner is RunChecked with its 180 second timeout.
fn DefaultRunner() Runner {
	return defaultRunner
}

// Result is the medians and every sample of an Interleaved run, by command name.
type Result struct {
	Names []str
	Medians []f64
	Samples [][]f64
}

// Median finds the median of a name.
fn (r Result) MedianOf(name str) f64 {
	for i in 0..len(r.Names) {
		if r.Names[i] == name {
			return r.Medians[i]
		}
	}
	return 0.0
}

// SamplesOf are the samples of a name.
fn (r Result) SamplesOf(name str) []f64 {
	for i in 0..len(r.Names) {
		if r.Names[i] == name {
			return r.Samples[i]
		}
	}
	return []f64{}
}

// Interleaved runs the commands round after round, alternating the order, and checks that every run prints what the first printed.
fn Interleaved(names []str, commands []Command, runs i64, checkOutput bool, run Runner) !Result {
	if runs < 1 {
		fail say.Fault("%s", "runs must be positive")
	}
	mut samples = [][]f64{}
	for n in names {
		samples = append(samples, []f64{})
	}
	mut haveExpected = false
	mut expectedOut = ""
	mut expectedErr = ""
	for round in 0..runs {
		for k in 0..len(names) {
			mut index = k
			if round % 2 == 1 {
				index = len(names) - 1 - k
			}
			let timed = try run(commands[index])
			if checkOutput {
				if !haveExpected {
					haveExpected = true
					expectedOut = timed.Stdout
					expectedErr = timed.Stderr
				} else if timed.Stdout != expectedOut || timed.Stderr != expectedErr {
					fail say.Fault("%s", "OUTPUT MISMATCH: " + names[index] + " in round " + mint.Itoa(round + 1) + " expected=" + expectedOut + " actual=" + timed.Stdout)
				}
			}
			samples[index] = append(samples[index], timed.Seconds)
		}
	}
	mut medians = []f64{}
	for s in samples {
		medians = append(medians, Median(s))
	}
	return Result{Names: names, Medians: medians, Samples: samples}
}

// TinCommand compiles the source with the tree at root (its compiler, or the one given) into output.
fn TinCommand(root str, source str, output str, compiler str) Command {
	mut tinc = ci.Join(root, "bin/tinc")
	if len(compiler) > 0 {
		tinc = compiler
	}
	return Command{Argv: []str{tinc, "-o", output, source}, Dir: root, Set: []str{"TIN_ROOT=" + root, "LC_ALL=C"}}
}

// BenchmarkNames are the names of the *.tin files of the directory (or the selected ones among them); it fails for an unknown name or none.
fn BenchmarkNames(dir str, selected []str) ![]str {
	mut names = []str{}
	for f in ci.Names(dir, ".tin") {
		names = append(names, f[0:len(f) - 4])
	}
	mut unknown = []str{}
	for s in selected {
		mut found = false
		for n in names {
			if n == s {
				found = true
			}
		}
		if !found {
			unknown = append(unknown, s)
		}
	}
	if len(unknown) > 0 {
		sift.Sort(mut unknown)
		fail say.Fault("%s", "unknown benchmarks: " + twine.Join(unknown, ", "))
	}
	mut chosen = []str{}
	for n in names {
		if len(selected) == 0 {
			chosen = append(chosen, n)
		} else {
			for s in selected {
				if s == n {
					chosen = append(chosen, n)
				}
			}
		}
	}
	if len(chosen) == 0 {
		fail say.Fault("%s", "no benchmarks found in " + dir)
	}
	return chosen
}

// ---------------- parsers ----------------

fn isDigit(c u8) bool {
	return c >= '0' && c <= '9'
}

// number reads digits and dots at the start of s: the number and the rest.
fn number(s str) (f64, str, bool) {
	mut i = 0
	for i < len(s) && (isDigit(s[i]) || s[i] == '.') {
		i += 1
	}
	if i == 0 {
		return 0.0, s, false
	}
	let v = mint.ParseFloat(s[0:i]) catch _ {
		return 0.0, s, false
	}
	return v, s[i:], true
}

// lineValue finds a line that starts (after spaces) with the prefix and returns what follows it.
fn lineAfter(text str, prefix str) (str, bool) {
	for line in twine.Split(text, "\n") {
		let t = twine.TrimLeft(line, " \t")
		if twine.HasPrefix(t, prefix) {
			return t[len(prefix):], true
		}
	}
	return "", false
}

fn unit(rest str) (f64, bool) {
	if rest == "us" {
		return 1.0, true
	}
	if rest == "ms" {
		return 1000.0, true
	}
	if rest == "s" {
		return 1000000.0, true
	}
	return 0.0, false
}

// Wrk is a wrk run: requests per second, the 99th percentile latency in microseconds and the request count.
type Wrk struct {
	Rps f64
	P99us f64
	Requests i64
}

// ParseWrk reads wrk's report; it refuses an incomplete one, request errors and zero throughput.
fn ParseWrk(text str) !Wrk {
	let (rpsRest, hasRps) = lineAfter(text, "Requests/sec:")
	let (p99Rest, hasP99) = lineAfter(text, "99%")
	mut total = i64(0)
	mut hasTotal = false
	for line in twine.Split(text, "\n") {
		let t = twine.TrimLeft(line, " \t")
		let at = twine.Index(t, " requests in ")
		if at > 0 {
			mut digits = true
			for i in 0..at {
				if !isDigit(t[i]) {
					digits = false
				}
			}
			if digits {
				total = ci.Num(t[0:at])
				hasTotal = true
			}
		}
	}
	if !hasRps || !hasP99 || !hasTotal {
		fail say.Fault("%s", "incomplete wrk output: " + text)
	}
	if twine.Contains(text, "Socket errors:") || twine.Contains(text, "Non-2xx or 3xx responses:") {
		fail say.Fault("%s", "wrk reported request errors: " + text)
	}
	let (rps, rpsTail, okRps) = number(twine.TrimLeft(rpsRest, " \t"))
	if !okRps || len(twine.TrimSpace(rpsTail)) > 0 {
		fail say.Fault("%s", "incomplete wrk output: " + text)
	}
	let (p99, p99Tail, okP99) = number(twine.TrimLeft(p99Rest, " \t"))
	let (scale, okUnit) = unit(twine.TrimSpace(p99Tail))
	if !okP99 || !okUnit {
		fail say.Fault("%s", "incomplete wrk output: " + text)
	}
	if rps <= 0.0 || total <= 0 {
		fail say.Fault("%s", "wrk returned invalid or zero throughput")
	}
	return Wrk{Rps: rps, P99us: p99 * scale, Requests: total}
}

// H2load is an h2load run: requests per second, requests that succeeded and the mean latency in microseconds.
type H2load struct {
	Rps f64
	Requests i64
	MeanUs f64
}

fn intsAfter(line str, prefix str, count i64) ([]i64, bool) {
	let (rest, ok) = lineAfter(line, prefix)
	if !ok {
		return []i64{}, false
	}
	mut out = []i64{}
	for w in twine.Fields(twine.Replace(rest, ",", " ", -1)) {
		if len(out) < count && allDigits(w) {
			out = append(out, ci.Num(w))
		}
	}
	return out, len(out) == count
}

// ParseH2load reads h2load's report in both of its formats; it refuses failed, errored or non-2xx requests.
fn ParseH2load(text str) !H2load {
	let (finished, hasFinished) = lineAfter(text, "finished in ")
	let (counts, hasCounts) = intsAfter(text, "requests: ", 7)
	let (codes, hasCodes) = intsAfter(text, "status codes: ", 4)
	// nghttp2 1.59 (Ubuntu 24.04) prints min, max, mean; newer versions min, max, median, p95, p99, mean.
	mut meanText = ""
	mut hasMean = false
	let (old, hasOld) = lineAfter(text, "time for request:")
	if hasOld {
		let w = twine.Fields(old)
		if len(w) >= 3 {
			meanText = w[2]
			hasMean = true
		}
	}
	let (current, hasCurrent) = lineAfter(text, "request ")
	if !hasMean && hasCurrent {
		let colon = twine.IndexByte(current, ':')
		if colon >= 0 {
			let w = twine.Fields(current[colon + 1:])
			if len(w) >= 6 {
				meanText = w[5]
				hasMean = true
			}
		}
	}
	if !hasFinished || !hasCounts || !hasCodes || !hasMean {
		fail say.Fault("%s", "incomplete h2load output: " + text)
	}
	// finished in 10.00s, 1000.50 req/s, 1.00MB/s
	let parts = twine.Split(finished, ", ")
	if len(parts) < 2 || !twine.HasSuffix(parts[1], " req/s") {
		fail say.Fault("%s", "incomplete h2load output: " + text)
	}
	let rps = mint.ParseFloat(twine.TrimSuffix(parts[1], " req/s")) catch _ {
		fail say.Fault("%s", "incomplete h2load output: " + text)
	}
	let done = counts[2]
	let succeeded = counts[3]
	let failed = counts[4]
	let errored = counts[5]
	let timeout = counts[6]
	// In a timed run a stream in flight at the end may count its 2xx without being done: no other status may appear at all.
	if failed != 0 || errored != 0 || timeout != 0 || succeeded != done || codes[0] < succeeded || done == 0 || codes[1] + codes[2] + codes[3] != 0 {
		fail say.Fault("%s", "h2load reported failed requests: " + text)
	}
	let (mean, tail, okMean) = number(meanText)
	let (scale, okUnit) = unit(tail)
	if !okMean || !okUnit {
		fail say.Fault("%s", "incomplete h2load output: " + text)
	}
	return H2load{Rps: rps, Requests: succeeded, MeanUs: mean * scale}
}

// VerifyBody checks the body of /json or /plaintext before anything is timed.
fn VerifyBody(path str, body str) ! {
	if path == "/json" {
		let (j, ok) = tinjson.Parse(body)
		if !ok || !j.IsObject() || j.Get("message").Text() != "Hello, World!" || j.Len() != 1 {
			fail say.Fault("%s", "incorrect /json response: " + body)
		}
	} else if body != "Hello, World!" {
		fail say.Fault("%s", "incorrect /plaintext response: " + body)
	}
}

// ---------------- processes ----------------

// ProcessStats are the resident memory (KiB) and the CPU time (seconds) of a process, from ps.
fn ProcessStats(pid i64) (i64, f64) {
	let o = ci.Exec([]str{"ps", "-o", "rss=", "-o", "time=", "-p", mint.Itoa(pid)}, "", 5)
	ci.Must(o, "ps")
	let w = twine.Fields(o.Stdout)
	ci.Check(len(w) == 2, "ps printed " + o.Stdout)
	mut cpu = w[1]
	mut days = 0.0
	let dash = twine.IndexByte(cpu, '-')
	if dash >= 0 {
		days = f64(ci.Num(cpu[0:dash]))
		cpu = cpu[dash + 1:]
	}
	mut seconds = 0.0
	for piece in twine.Split(cpu, ":") {
		let part = mint.ParseFloat(piece) catch _ {
			0.0
		}
		seconds = seconds * 60.0 + part
	}
	return ci.Num(w[0]), seconds + days * 86400.0
}

// CpuSeconds is the user plus system CPU time of every thread of the process (Linux /proc), ok false elsewhere.
fn CpuSeconds(pid i64) (f64, bool) {
	let text = ci.Read("/proc/" + mint.Itoa(pid) + "/stat")
	let close = twine.LastIndex(text, ")")
	if close < 0 {
		return 0.0, false
	}
	let fields = twine.Fields(text[close + 1:])
	if len(fields) < 13 {
		return 0.0, false
	}
	let ticks = f64(ci.Num(ci.Sh("getconf CLK_TCK", "", 5).Stdout))
	return f64(ci.Num(fields[11]) + ci.Num(fields[12])) / ticks, true
}

// Rounds says which order a round runs in: round 0 forwards, round 1 backwards...
fn Order(names []str, round i64) []str {
	if round % 2 == 0 {
		return names
	}
	mut out = []str{}
	for i in 0..len(names) {
		out = append(out, names[len(names) - 1 - i])
	}
	return out
}

fn Env(name str, fallback str) str {
	let v = quarry.Getenv(name)
	if len(v) == 0 {
		return fallback
	}
	return v
}

fn allDigits(s str) bool {
	if len(s) == 0 {
		return false
	}
	for i in 0..len(s) {
		if !isDigit(s[i]) {
			return false
		}
	}
	return true
}
