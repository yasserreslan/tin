package main

import "say"

fn main() {
	let n = 400
	let a = make([]i64, n*n)
	let b = make([]i64, n*n)
	let c = make([]i64, n*n)
	for i in 0..n*n {
		a[i] = i % 7
		b[i] = i % 5
	}
	for i in 0..n {
		for k in 0..n {
			let aik = a[i*n+k]
			for j in 0..n {
				c[i*n+j] += aik * b[k*n+j]
			}
		}
	}
	mut sum = 0
	for i in 0..n*n {
		sum += c[i]
	}
	say.Line(sum)
}
