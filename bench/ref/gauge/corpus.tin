package main

// The corpus check, Tin side: the same inputs and hashes as bench/ref/gauge/corpus.go. Equal output
// means every transcendental function agrees with Go's to the last bit.

import "say"
import "gauge"
import "quarry"
import "mint"

mut seed u64 = 88172645463325252

fn next() u64 {
	seed ^= seed >> 12
	seed ^= seed << 25
	seed ^= seed >> 27
	return seed *% 2685821657736338717
}

fn edge() []f64 {
	return []f64{
		0, gauge.Copysign(0, -1), 1, -1, 0.5, -0.5, 2, -2, 3, 10, 100, 1e-3, 1e-10, 1e-300, 1e300, -1e300,
		gauge.Inf(1), gauge.Inf(-1), gauge.NaN(), gauge.MaxF64, -gauge.MaxF64, gauge.SmallestNonzeroF64,
		-gauge.SmallestNonzeroF64, 2.2250738585072014e-308, 2.225073858507201e-308, 1e-310, 1e-320,
		0.625, 0.66, 0.7, 21, 21.000000000000004, 44.01, 88.03, 709.78, 709.782712893384, 710, -745.13, -745.2,
		1023.9999999999999, 1024, -1074, -1075, 3.725290298461914e-09, 1.862645149230957e-09, 5.551115123125783e-17,
		0.4142135623730951, -0.2928932188134525, 1.4142135623730951, 0.7071067811865476, 0.7853981633974483,
		1.5707963267948966, 3.141592653589793, 6.283185307179586, 536870911, 536870912, 536870913, 1073741824,
		1e10, 1e15, 4503599627370496, 9007199254740992, 9007199254740993, 1e22, 1e100, 1.7e308,
		9.223372036854776e18, 1.8446744073709552e19, 27, -27, 8, 1000, 0.001, 0.1, 0.2, 0.3, 123.456,
	}
}

// count is the number of random inputs (GAUGE_N, default 20000; the CI twin uses 120000).
fn count() i64 {
	let s = quarry.Getenv("GAUGE_N")
	if len(s) == 0 {
		return 20000
	}
	let (v, err) = mint.Atoi(s)
	if err != nil || v <= 0 {
		return 20000
	}
	return v
}

fn inputs() []f64 {
	mut xs = edge()
	for i in 0..count() {
		let v = next()
		let m = next()
		match v % 4 {
			0 => {
				xs = append(xs, f64(i64(m>>11)%2000001-1000000)/100000)
			}
			1 => {
				mut e = i64(v>>8) % 121
				if e < 0 {
					e = -e
				}
				e -= 60
				let bits = u64(1023+e)<<52 | m&0xfffffffffffff | (v>>20&1)<<63
				xs = append(xs, gauge.F64frombits(bits))
			}
			2 => {
				xs = append(xs, gauge.F64frombits(m))
			}
			_ => {
				let k = i64(v>>8)%8001 - 4000
				xs = append(xs, f64(k)/8)
			}
		}
	}
	return xs
}

fn canon(f f64) u64 {
	if f != f {
		return 0x7ff8000000000001
	}
	return gauge.F64bits(f)
}

fn mix(h u64, b u64) u64 {
	for i in 0..8 {
		h ^= (b >> u64(8*i)) & 0xff
		h = h*%1099511628211
	}
	return h
}

fn hex(b u64) str {
	return say.Fmt("%016x", b)
}

// wanted reports whether name is selected: GAUGE_FUNC empty means every function.
fn wanted(name str) bool {
	let sel = quarry.Getenv("GAUGE_FUNC")
	return len(sel) == 0 || sel == name
}

fn unary(name str, f fn(f64) f64, xs []f64, dump bool) {
	if !wanted(name) {
		return
	}
	mut h = u64(14695981039346656037)
	for i, x in xs {
		let b = canon(f(x))
		h = mix(h, b)
		if dump {
			say.Line(name, i, hex(gauge.F64bits(x)), hex(b))
		}
	}
	if !dump {
		say.Line(name, len(xs), hex(h))
	}
}

// unarylg hashes a float result and an integer sign per input, as Lgamma returns.
fn unarylg(name str, f fn(f64) (f64, i64), xs []f64, dump bool) {
	if !wanted(name) {
		return
	}
	mut h = u64(14695981039346656037)
	for i, x in xs {
		let (lg, sign) = f(x)
		let b = canon(lg)
		h = mix(h, b)
		h = mix(h, u64(sign))
		if dump {
			say.Line(name, i, hex(gauge.F64bits(x)), hex(b), hex(u64(sign)))
		}
	}
	if !dump {
		say.Line(name, len(xs), hex(h))
	}
}

// unary2 hashes two results per input, as Sincos returns.
fn unary2(name str, f fn(f64) (f64, f64), xs []f64, dump bool) {
	if !wanted(name) {
		return
	}
	mut h = u64(14695981039346656037)
	for i, x in xs {
		let (a, b) = f(x)
		h = mix(h, canon(a))
		h = mix(h, canon(b))
		if dump {
			say.Line(name, i, hex(gauge.F64bits(x)), hex(canon(a)), hex(canon(b)))
		}
	}
	if !dump {
		say.Line(name, len(xs), hex(h))
	}
}

// unaryi hashes an integer result per input, as Ilogb returns.
fn unaryi(name str, f fn(f64) i64, xs []f64, dump bool) {
	if !wanted(name) {
		return
	}
	mut h = u64(14695981039346656037)
	for i, x in xs {
		let v = u64(f(x))
		h = mix(h, v)
		if dump {
			say.Line(name, i, hex(gauge.F64bits(x)), hex(v))
		}
	}
	if !dump {
		say.Line(name, len(xs), hex(h))
	}
}

// ternary hashes one result per input triple, as FMA takes.
fn ternary(name str, f fn(f64, f64, f64) f64, xs []f64, dump bool) {
	if !wanted(name) {
		return
	}
	mut h = u64(14695981039346656037)
	for i, x in xs {
		let j = (i*7 + 3) % len(xs)
		let k = (i*13 + 1) % len(xs)
		let b = canon(f(x, xs[j], xs[k]))
		h = mix(h, b)
		if dump {
			say.Line(name, i, hex(gauge.F64bits(x)), hex(gauge.F64bits(xs[j])), hex(gauge.F64bits(xs[k])), hex(b))
		}
	}
	if !dump {
		say.Line(name, len(xs), hex(h))
	}
}

// binary32 is binary over f32 conversions, as Nextafter32 takes.
fn binary32(name str, f fn(f64, f64) f64, xs []f64, dump bool) {
	if !wanted(name) {
		return
	}
	mut h = u64(14695981039346656037)
	mut n = 0
	for i, x in xs {
		let js = []i64{(i*7 + 3) % len(xs), (i*13 + 1) % len(xs), i}
		for _, j in js {
			let b = canon(f(x, xs[j]))
			h = mix(h, b)
			if dump {
				say.Line(name, say.Fmt("{i},{j}"), hex(gauge.F64bits(x)), hex(gauge.F64bits(xs[j])), hex(b))
			}
			n += 1
		}
	}
	if !dump {
		say.Line(name, n, hex(h))
	}
}

// unaryu32 hashes a u32 conversion per input, as F32bits returns.
fn unaryu32(name str, f fn(f64) u64, xs []f64, dump bool) {
	if !wanted(name) {
		return
	}
	mut h = u64(14695981039346656037)
	for i, x in xs {
		let v = f(x)
		h = mix(h, v)
		if dump {
			say.Line(name, i, hex(gauge.F64bits(x)), hex(v))
		}
	}
	if !dump {
		say.Line(name, len(xs), hex(h))
	}
}

fn binary(name str, f fn(f64, f64) f64, xs []f64, dump bool) {
	if !wanted(name) {
		return
	}
	mut h = u64(14695981039346656037)
	mut n = 0
	for i, x in xs {
		let js = []i64{(i*7 + 3) % len(xs), (i*13 + 1) % len(xs), i}
		for _, j in js {
			let b = canon(f(x, xs[j]))
			h = mix(h, b)
			if dump {
				say.Line(name, say.Fmt("{i},{j}"), hex(gauge.F64bits(x)), hex(gauge.F64bits(xs[j])), hex(b))
			}
			n += 1
		}
	}
	if !dump {
		say.Line(name, n, hex(h))
	}
}

fn absPow(x f64, y f64) f64 {
	return gauge.Pow(gauge.Abs(x), y)
}

// nextafter32f applies Nextafter32 to the f32 forms and widens the result.
fn nextafter32f(x f64, y f64) f64 {
	return f64(gauge.Nextafter32(f32(x), f32(y)))
}

// f32bitsf widens and takes the bits, out of range inputs become f32 Inf/0 as conversions do.
fn f32bitsf(x f64) u64 {
	return u64(gauge.F32bits(f32(x)))
}

// f32frombitsf builds an f32 from the low 32 bits of x's pattern and widens it.
fn f32frombitsf(x f64) f64 {
	return f64(gauge.F32frombits(u32(gauge.F64bits(x)&0xffffffff)))
}

fn main() {
	let dump = len(quarry.Args()) > 1 && quarry.Args()[1] == "dump"
	let xs = inputs()
	unary("sin", gauge.Sin, xs, dump)
	unary("cos", gauge.Cos, xs, dump)
	unary("tan", gauge.Tan, xs, dump)
	unary("asin", gauge.Asin, xs, dump)
	unary("acos", gauge.Acos, xs, dump)
	unary("atan", gauge.Atan, xs, dump)
	unary("sinh", gauge.Sinh, xs, dump)
	unary("cosh", gauge.Cosh, xs, dump)
	unary("tanh", gauge.Tanh, xs, dump)
	unary("exp", gauge.Exp, xs, dump)
	unary("exp2", gauge.Exp2, xs, dump)
	unary("log", gauge.Log, xs, dump)
	unary("log2", gauge.Log2, xs, dump)
	unary("log10", gauge.Log10, xs, dump)
	unary("log1p", gauge.Log1p, xs, dump)
	unary("cbrt", gauge.Cbrt, xs, dump)
	unary("expm1", gauge.Expm1, xs, dump)
	unary("asinh", gauge.Asinh, xs, dump)
	unary("acosh", gauge.Acosh, xs, dump)
	unary("atanh", gauge.Atanh, xs, dump)
	unary("logb", gauge.Logb, xs, dump)
	unary("erf", gauge.Erf, xs, dump)
	unary("erfc", gauge.Erfc, xs, dump)
	unary("erfinv", gauge.Erfinv, xs, dump)
	unary("erfcinv", gauge.Erfcinv, xs, dump)
	unary("gamma", gauge.Gamma, xs, dump)
	unarylg("lgamma", gauge.Lgamma, xs, dump)
	unaryi("ilogb", gauge.Ilogb, xs, dump)
	unary2("sincos", gauge.Sincos, xs, dump)
	unaryu32("f32bits", f32bitsf, xs, dump)
	unary("f32frombits", f32frombitsf, xs, dump)
	binary("dim", gauge.Dim, xs, dump)
	binary("remainder", gauge.Remainder, xs, dump)
	binary("nextafter", gauge.Nextafter, xs, dump)
	binary32("nextafter32", nextafter32f, xs, dump)
	ternary("fma", gauge.FMA, xs, dump)
	binary("atan2", gauge.Atan2, xs, dump)
	binary("pow", gauge.Pow, xs, dump)
	binary("hypot", gauge.Hypot, xs, dump)
	binary("mod", gauge.Mod, xs, dump)

	if !wanted("powi") {
		return
	}
	mut h = u64(14695981039346656037)
	mut n = 0
	let ys = []f64{2, 3, -2, 10, -7, 0.25, 1.5, -0.75, 100, 0.3333333333333333, 2.5, -1.5}
	for i in 0..2000 {
		for _, y in ys {
			let b = canon(absPow(xs[i], y))
			h = mix(h, b)
			if dump {
				say.Line("powi", n, hex(gauge.F64bits(gauge.Abs(xs[i]))), hex(gauge.F64bits(y)), hex(b))
			}
			n += 1
		}
	}
	if !dump {
		say.Line("powi", n, hex(h))
	}
}
