package main

import "../../tools/ci/ci"
import "../../tools/ci/nettest"
import "../benchlib"
import "mint"
import "quarry"
import "say"
import "twine"

// HTTP client: wire (bench/http/wire_load.tin, one core) against Go's net/http client (bench/http/goload, GOMAXPROCS=1), both calling
// Go's net/http server (bench/http/goh2c, two cores): N GETs of /plaintext from 100 callers at once, over HTTP/2 by prior knowledge
// (one connection, 100 streams) and over HTTP/1.1 (100 kept connections). Interleaved rounds, medians of requests per second, with the
// ratios (#480).
//
// Usage: run_wire N ROUNDS [--json PATH]   (needs bin/wire_load, bin/goload, bin/goh2c)

const UP = 9182
const TIN = 9190
const CALLERS = 100

// rate reads "got errors nanoseconds" and refuses errors.
fn rate(text str, n i64) f64 {
	let w = twine.Fields(text)
	ci.Check(len(w) == 3, "unexpected load output: " + text)
	let got = ci.Num(w[0])
	let errors = ci.Num(w[1])
	let ns = ci.Num(w[2])
	ci.Check(errors == 0 && got == n, mint.Itoa(errors) + " errors in " + mint.Itoa(got) + " calls: " + text)
	return f64(got) / (f64(ns) / 1000000000.0)
}

fn main() {
	let args = quarry.Args()
	mut positional = []str{}
	mut jsonPath = ""
	mut i = 1
	for i < len(args) {
		if args[i] == "--json" && i + 1 < len(args) {
			jsonPath = args[i + 1]
			i += 1
		} else {
			positional = append(positional, args[i])
		}
		i += 1
	}
	if len(positional) != 2 {
		say.Line("usage: run_wire N ROUNDS [--json PATH]")
		quarry.Exit(2)
	}
	let n = ci.Num(positional[0]) / CALLERS * CALLERS
	let rounds = ci.Num(positional[1])
	let root = ci.Root()
	let logDir = ci.TempDir(ci.Join(root, "bin"), "wire-")
	let url = "http://127.0.0.1:" + mint.Itoa(UP) + "/plaintext"
	let up = nettest.Start(ci.Join(root, "bin/goh2c"), []str{":" + mint.Itoa(UP)}, []str{"GOMAXPROCS=2"}, ci.Join(logDir, "goh2c.log"), UP)
	let tin = nettest.Start(ci.Join(root, "bin/wire_load"), []str{}, []str{"TIN_CORES=1"}, ci.Join(logDir, "wire_load.log"), TIN)
	up.Ready(10)
	tin.Ready(10)
	let modes = []str{"h2c", "h1"}
	mut tinSamples = [][]f64{[]f64{}, []f64{}}
	mut goSamples = [][]f64{[]f64{}, []f64{}}
	for r in 0..rounds + 1 {
		for m in 0..2 {
			let mode = modes[m]
			let reply = nettest.Parse(nettest.Raw(TIN, nettest.GetRequest("/load?url=" + url + "&n=" + mint.Itoa(n) + "&c=" + mint.Itoa(CALLERS) + "&mode=" + mode), 300))
			ci.Check(reply.Status == 200, "wire_load answered " + mint.Itoa(reply.Status) + " " + reply.Body)
			let t = rate(reply.Body, n)
			let g = ci.ExecEnv([]str{ci.Join(root, "bin/goload"), "-url", url, "-n", mint.Itoa(n), "-c", mint.Itoa(CALLERS), "-mode", mode}, "", 300, []str{"GOMAXPROCS=1"}, []str{})
			ci.Must(g, "goload")
			let gr = rate(g.Stdout, n)
			if r > 0 {
				tinSamples[m] = append(tinSamples[m], t)
				goSamples[m] = append(goSamples[m], gr)
			}
		}
	}
	tin.Stop()
	up.Stop()
	let tinH2 = benchlib.Median(tinSamples[0])
	let goH2 = benchlib.Median(goSamples[0])
	let tinH1 = benchlib.Median(tinSamples[1])
	let goH1 = benchlib.Median(goSamples[1])
	say.Line("| protocol, " + mint.Itoa(CALLERS) + " callers | wire (Tin) | net/http (Go) | Tin/Go |")
	say.Line("|---|---:|---:|---:|")
	say.Line("| HTTP/2 (one connection) | " + benchlib.Fixed(tinH2, 0) + " req/s | " + benchlib.Fixed(goH2, 0) + " req/s | " + benchlib.Fixed(tinH2 / goH2, 2) + " |")
	say.Line("| HTTP/1.1 (" + mint.Itoa(CALLERS) + " connections) | " + benchlib.Fixed(tinH1, 0) + " req/s | " + benchlib.Fixed(goH1, 0) + " req/s | " + benchlib.Fixed(tinH1 / goH1, 2) + " |")
	say.Line("| HTTP/2 / HTTP/1.1 | " + benchlib.Fixed(tinH2 / tinH1, 2) + " | " + benchlib.Fixed(goH2 / goH1, 2) + " | |")
	if len(jsonPath) > 0 {
		ci.Write(jsonPath, "{{\n \"samples\": {{\"tin h2c\": " + benchlib.NumList(tinSamples[0]) + ", \"go h2c\": " + benchlib.NumList(goSamples[0]) + ", \"tin h1\": " + benchlib.NumList(tinSamples[1]) + ", \"go h1\": " + benchlib.NumList(goSamples[1]) + "}},\n \"medians\": {{\"tin h2c\": " + benchlib.Num(tinH2) + ", \"go h2c\": " + benchlib.Num(goH2) + ", \"tin h1\": " + benchlib.Num(tinH1) + ", \"go h1\": " + benchlib.Num(goH1) + "}}\n}}\n")
	}
}
