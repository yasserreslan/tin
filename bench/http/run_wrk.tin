package main

import "../../tools/ci/ci"
import "../../tools/ci/nettest"
import "../benchlib"
import "mint"
import "quarry"
import "say"
import "tide"
import "twine"

// Checked HTTP measurements; reference servers or two Tin revisions, interleaved medians.
//
// Usage: run_wrk CORES THREADS CONNECTIONS SECONDS [ROUNDS] [--base-api PATH --head-api PATH] [--json PATH]

// Sample is one measurement.
type Sample struct {
	Server str
	Path str
	Round i64
	Rps f64
	P99us f64
	Requests i64
	RssKb f64
	PerCpu f64
	HasPerCpu bool
}

fn usage(message str) {
	say.Line("run_wrk: " + message)
	quarry.Exit(2)
}

// body is the answer of GET path on the port (the probes never pass through a proxy).
fn body(port i64, path str) (str, bool) {
	let r = nettest.Do(port, "GET", path, []str{}, "")
	return r.Body, r.Status == 200
}

fn busy(port i64) bool {
	let c = nettest.Raw(port, "", 1)
	return len(c) > 0
}

// measure runs one server under wrk and returns the sample and the body it served.
fn measure(command []str, port i64, path str, threads i64, connections i64, seconds i64, set []str, logDir str, label str) (Sample, str) {
	// Fail on an occupied port instead of timing a stale server.
	ci.Check(!portOpen(port), "port " + mint.Itoa(port) + " is already in use")
	let url = "http://127.0.0.1:" + mint.Itoa(port) + path
	let exe = command[0]
	let server = nettest.Start(exe, command[1:], set, ci.Join(logDir, label + ".server.log"), 0)
	mut served = ""
	let end = tide.Now() + 10000000000
	mut ready = false
	for tide.Now() < end && !ready {
		ci.Check(server.Running(), "server exited during startup: " + label)
		let (b, ok) = body(port, path)
		if ok {
			served = b
			ready = true
		} else {
			tide.Sleep(50000000)
		}
	}
	ci.Check(ready, "server did not become ready: " + label)
	benchlib.VerifyBody(path, served) catch err {
		ci.Fail(say.Str(err))
	}
	let wrk = []str{"wrk", "-t" + mint.Itoa(threads), "-c" + mint.Itoa(connections), "--latency"}
	let warm = ci.Exec(append2(wrk, []str{"-d2s", url}), "", 15)
	ci.Must(warm, "wrk warm-up")
	ci.Write(ci.Join(logDir, label + ".warmup.log"), warm.Stdout + warm.Stderr)
	benchlib.ParseWrk(warm.Stdout) catch err {
		ci.Fail(say.Str(err))
	}
	let (_, before) = benchlib.ProcessStats(server.Pid)
	let run = ci.Exec(append2(wrk, []str{"-d" + mint.Itoa(seconds) + "s", url}), "", seconds + 15)
	ci.Must(run, "wrk")
	ci.Write(ci.Join(logDir, label + ".wrk.log"), run.Stdout + run.Stderr)
	let metrics = benchlib.ParseWrk(run.Stdout) catch err {
		ci.Fail(say.Str(err))
		panic("unreachable")
	}
	let (rss, after) = benchlib.ProcessStats(server.Pid)
	ci.Check(server.Running(), "server exited during measurement: " + label)
	let (again, okAgain) = body(port, path)
	ci.Check(okAgain, "the server stopped answering: " + label)
	benchlib.VerifyBody(path, again) catch err {
		ci.Fail(say.Str(err))
	}
	server.Stop()
	mut perCpu = 0.0
	mut hasPerCpu = false
	if after > before {
		perCpu = f64(metrics.Requests) / (after - before)
		hasPerCpu = true
	}
	return Sample{Server: "", Path: path, Round: 0, Rps: metrics.Rps, P99us: metrics.P99us, Requests: metrics.Requests, RssKb: f64(rss), PerCpu: perCpu, HasPerCpu: hasPerCpu}, served
}

fn append2(a []str, b []str) []str {
	mut out = []str{}
	for x in a {
		out = append(out, x)
	}
	for x in b {
		out = append(out, x)
	}
	return out
}

fn portOpen(port i64) bool {
	return len(nettest.Raw(port, "GET / HTTP/1.0\r\n\r\n", 1)) > 0
}

fn main() {
	let args = quarry.Args()
	mut positional = []str{}
	mut baseApi = ""
	mut headApi = ""
	let root = ci.Root()
	mut jsonPath = ci.Join(root, "bin/bench-http.json")
	mut i = 1
	for i < len(args) {
		if args[i] == "--base-api" && i + 1 < len(args) {
			baseApi = args[i + 1]
			i += 1
		} else if args[i] == "--head-api" && i + 1 < len(args) {
			headApi = args[i + 1]
			i += 1
		} else if args[i] == "--json" && i + 1 < len(args) {
			jsonPath = args[i + 1]
			i += 1
		} else {
			positional = append(positional, args[i])
		}
		i += 1
	}
	if len(positional) < 4 || len(positional) > 5 {
		usage("usage: run_wrk CORES THREADS CONNECTIONS SECONDS [ROUNDS] [--base-api PATH --head-api PATH] [--json PATH]")
	}
	let cores = ci.Num(positional[0])
	let threads = ci.Num(positional[1])
	let connections = ci.Num(positional[2])
	let seconds = ci.Num(positional[3])
	mut rounds = 3
	if len(positional) == 5 {
		rounds = ci.Num(positional[4])
	}
	let comparison = len(baseApi) > 0
	if comparison != (len(headApi) > 0) {
		usage("provide both --base-api and --head-api")
	}
	if cores < 1 || threads < 1 || connections < 1 || seconds < 1 || rounds < 1 {
		usage("all measurement settings must be positive")
	}
	if comparison && rounds < 5 {
		usage("revision comparisons require at least 5 rounds")
	}
	mut names = []str{"anvil", "fasthttp", "net/http"}
	mut commands = [][]str{[]str{ci.Join(root, "bin/api")}, []str{ci.Join(root, "bin/fast"), ":9182"}, []str{ci.Join(root, "bin/gonet"), ":9181"}}
	mut ports = []i64{9180, 9182, 9181}
	if comparison {
		names = []str{"base", "head"}
		commands = [][]str{[]str{baseApi}, []str{headApi}}
		ports = []i64{9180, 9180}
	}
	let set = []str{"TIN_CORES=" + mint.Itoa(cores), "TIN_PIN=0", "TIN_GRACE=1", "PORT=9180", "GOMAXPROCS=" + mint.Itoa(cores), "LC_ALL=C"}
	let dir = jsonPath[0:twine.LastIndex(jsonPath, "/")]
	ci.Mkdirs(dir)
	let logDir = ci.TempDir(dir, "wrk-")
	mut samples = []Sample{}
	mut expectedPaths = []str{}
	mut expectedBodies = []str{}
	let paths = []str{"/json", "/plaintext"}
	for round in 0..rounds {
		for path in paths {
			for name in benchlib.Order(names, round) {
				mut k = 0
				for j in 0..len(names) {
					if names[j] == name {
						k = j
					}
				}
				let label = mint.Itoa(round) + "-" + twine.Replace(name, "/", "-", -1) + "-" + path[1:]
				let (m, served) = measure(commands[k], ports[k], path, threads, connections, seconds, set, logDir, label)
				if comparison {
					for e in 0..len(expectedPaths) {
						if expectedPaths[e] == path {
							ci.Check(expectedBodies[e] == served, "OUTPUT MISMATCH between HTTP revisions: " + path)
						}
					}
					mut known = false
					for e in expectedPaths {
						if e == path {
							known = true
						}
					}
					if !known {
						expectedPaths = append(expectedPaths, path)
						expectedBodies = append(expectedBodies, served)
					}
				}
				samples = append(samples, Sample{Server: name, Path: path, Round: round + 1, Rps: m.Rps, P99us: m.P99us, Requests: m.Requests, RssKb: m.RssKb, PerCpu: m.PerCpu, HasPerCpu: m.HasPerCpu})
			}
		}
	}
	mut records = []str{}
	for s in samples {
		records = append(records, "    {{\"server\": " + benchlib.Quote(s.Server) + ", \"path\": " + benchlib.Quote(s.Path) + ", \"round\": " + mint.Itoa(s.Round) + ", \"rps\": " + benchlib.Num(s.Rps) + ", \"p99_us\": " + benchlib.Num(s.P99us) + ", \"requests\": " + mint.Itoa(s.Requests) + ", \"rss_kb\": " + benchlib.Num(s.RssKb) + "}}")
	}
	ci.Write(jsonPath, "{{\n  \"rounds\": " + mint.Itoa(rounds) + ",\n  \"cores\": " + mint.Itoa(cores) + ",\n  \"threads\": " + mint.Itoa(threads) + ",\n  \"connections\": " + mint.Itoa(connections) + ",\n  \"seconds\": " + mint.Itoa(seconds) + ",\n  \"logs\": " + benchlib.Quote(logDir) + ",\n  \"samples\": [\n" + twine.Join(records, ",\n") + "\n  ]\n}}\n")
	say.Line("| server | path | median req/s | median p99 us | median RSS KiB | ratio | review |")
	say.Line("|---|---|---:|---:|---:|---:|---|")
	for path in paths {
		mut firstRps = 0.0
		for n in 0..len(names) {
			mut rps = []f64{}
			mut p99 = []f64{}
			mut rss = []f64{}
			for s in samples {
				if s.Server == names[n] && s.Path == path {
					rps = append(rps, s.Rps)
					p99 = append(p99, s.P99us)
					rss = append(rss, s.RssKb)
				}
			}
			let mrps = benchlib.Median(rps)
			if n == 0 {
				firstRps = mrps
			}
			let ratio = mrps / firstRps
			mut review = ""
			if comparison && names[n] == "head" && ratio < 0.95 {
				review = "REVIEW (>5%)"
			}
			say.Line("| " + names[n] + " | " + path + " | " + benchlib.Fixed(mrps, 0) + " | " + benchlib.Fixed(benchlib.Median(p99), 1) + " | " + benchlib.Fixed(benchlib.Median(rss), 0) + " | " + benchlib.Fixed(ratio, 3) + " | " + review + " |")
		}
	}
	say.Line("Ratio is req/s relative to " + names[0] + "; higher is faster.")
}
