// The pieces of the HTTPS benchmarks: certificates made per run with openssl, a probe that waits for a TLS 1.3 answer, and wrk's report.
package httpsbench

import "../../../tools/ci/ci"
import "mint"
import "say"
import "tide"
import "twine"

// Certs are the certificate and key files of one kind.
type Cert struct {
	Kind str
	Cert str
	Key str
}

// MakeCerts makes an ECDSA P-256 and an RSA-2048 certificate (30 days, CN localhost) in the folder.
fn MakeCerts(work str) []Cert {
	mut certs = []Cert{}
	let kinds = []str{"ecdsa", "rsa"}
	let keys = [][]str{[]str{"-newkey", "ec", "-pkeyopt", "ec_paramgen_curve:P-256"}, []str{"-newkey", "rsa:2048"}}
	for i in 0..2 {
		let cert = ci.Join(work, kinds[i] + ".pem")
		let key = ci.Join(work, kinds[i] + ".key")
		mut argv = []str{"openssl", "req", "-x509"}
		for a in keys[i] {
			argv = append(argv, a)
		}
		for a in []str{"-keyout", key, "-out", cert, "-days", "30", "-nodes", "-subj", "/CN=localhost", "-addext", "subjectAltName=DNS:localhost,IP:127.0.0.1"} {
			argv = append(argv, a)
		}
		ci.Must(ci.Exec(argv, "", 60), "openssl req " + kinds[i])
		certs = append(certs, Cert{Kind: kinds[i], Cert: cert, Key: key})
	}
	return certs
}

// CertOf finds the certificate of a kind.
fn CertOf(certs []Cert, kind str) Cert {
	for c in certs {
		if c.Kind == kind {
			return c
		}
	}
	return certs[0]
}

// Ready waits until the server answers /plaintext over TLS 1.3 (up to ten seconds).
fn Ready(port i64) {
	let end = tide.Now() + 10000000000
	for tide.Now() < end {
		let o = ci.Exec([]str{"curl", "-sk", "--tlsv1.3", "--tls-max", "1.3", "--max-time", "2", "https://localhost:" + mint.Itoa(port) + "/plaintext"}, "", 5)
		if o.Code == 0 {
			ci.Check(twine.HasSuffix(o.Stdout, "Hello, World!"), "unexpected answer over TLS: " + o.Stdout)
			return
		}
		tide.Sleep(50000000)
	}
	ci.Fail("server on " + mint.Itoa(port) + " did not answer over TLS")
}

// Wrk is what wrk reported: requests per second and MiB per second.
type Wrk struct {
	Rps f64
	Mib f64
}

fn after(text str, prefix str) (str, bool) {
	for line in twine.Split(text, "\n") {
		let t = twine.TrimSpace(line)
		if twine.HasPrefix(t, prefix) {
			return twine.TrimSpace(t[len(prefix):]), true
		}
	}
	return "", false
}

fn floatOf(s str) f64 {
	return mint.ParseFloat(s) catch _ {
		0.0
	}
}

fn leading(s str) (str, str) {
	mut i = 0
	for i < len(s) && ((s[i] >= '0' && s[i] <= '9') || s[i] == '.') {
		i += 1
	}
	return s[0:i], s[i:]
}

// ParseWrk reads wrk's report; a request of the reference server (Go, GOMAXPROCS=1) now and then takes longer than wrk's 2 s timeout
// with 1 MiB bodies: noted, since it is not what is measured. anvil's are errors.
fn ParseWrk(text str, reference bool) Wrk {
	let (rpsText, hasRps) = after(text, "Requests/sec:")
	let (xfer, hasXfer) = after(text, "Transfer/sec:")
	ci.Check(hasRps && hasXfer, "incomplete wrk output: " + text)
	let (errorsText, hasErrors) = after(text, "Socket errors: ")
	mut connect = 0
	mut read = 0
	mut write = 0
	mut timeouts = 0
	if hasErrors {
		// connect 0, read 0, write 0, timeout 0
		let words = twine.Fields(twine.Replace(errorsText, ",", " ", -1))
		if len(words) >= 8 {
			connect = ci.Num(words[1])
			read = ci.Num(words[3])
			write = ci.Num(words[5])
			timeouts = ci.Num(words[7])
		}
	}
	if reference && timeouts > 0 {
		say.Line("note: wrk timed out " + mint.Itoa(timeouts) + " request(s) of the reference server")
		timeouts = 0
	}
	ci.Check(!twine.Contains(text, "Non-2xx or 3xx responses:") && !(hasErrors && (read > 0 || timeouts > 0)), "wrk reported request errors: " + text)
	let (num, unit) = leading(xfer)
	mut scale = 1.0
	if unit == "B" {
		scale = 1.0 / 1048576.0
	} else if unit == "KB" {
		scale = 1.0 / 1024.0
	} else if unit == "GB" {
		scale = 1024.0
	}
	if connect < 0 || write < 0 {
		ci.Fail("negative counts")
	}
	return Wrk{Rps: floatOf(rpsText), Mib: floatOf(num) * scale}
}
