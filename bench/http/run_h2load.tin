package main

import "../../tools/ci/ci"
import "../../tools/ci/nettest"
import "../benchlib"
import "mint"
import "quarry"
import "say"
import "tide"
import "twine"

// HTTP/2 (h2c) measurements with h2load (#360): anvil (examples/api.tin) against Go's net/http serving h2c (bench/http/goh2c),
// interleaved rounds, medians and the ratio.
//
// Usage: run_h2load CORES THREADS CONNECTIONS STREAMS SECONDS [ROUNDS] [--json PATH]
// Each server gets CORES cores (TIN_CORES, GOMAXPROCS); h2load runs THREADS threads with CONNECTIONS connections of STREAMS concurrent
// streams each, for SECONDS after a 2-second warm-up. A round with a failed, errored or non-2xx request fails the run.

// Sample is one measurement.
type Sample struct {
	Server str
	Path str
	Round i64
	Rps f64
	MeanUs f64
	Requests i64
	RssKb f64
	PerCpu f64
}

fn usage(message str) {
	say.Line("run_h2load: " + message)
	quarry.Exit(2)
}

fn portOpen(port i64) bool {
	return len(nettest.Raw(port, "GET / HTTP/1.0\r\n\r\n", 1)) > 0
}

fn join(a []str, b []str) []str {
	mut out = []str{}
	for x in a {
		out = append(out, x)
	}
	for x in b {
		out = append(out, x)
	}
	return out
}

fn measure(command []str, port i64, path str, threads i64, connections i64, streams i64, seconds i64, set []str, logDir str, label str) Sample {
	ci.Check(!portOpen(port), "port " + mint.Itoa(port) + " is already in use")
	let url = "http://127.0.0.1:" + mint.Itoa(port) + path
	let server = nettest.Start(command[0], command[1:], set, ci.Join(logDir, label + ".server.log"), 0)
	let end = tide.Now() + 10000000000
	mut ready = false
	for tide.Now() < end && !ready {
		ci.Check(server.Running(), "server exited during startup: " + label)
		let r = nettest.Do(port, "GET", path, []str{}, "")
		// The same handlers answer HTTP/1.1: check the bodies the measurement asks for.
		if r.Status == 200 {
			benchlib.VerifyBody(path, r.Body) catch err {
				ci.Fail(say.Str(err))
			}
			ready = true
		} else {
			tide.Sleep(50000000)
		}
	}
	ci.Check(ready, "server did not become ready: " + label)
	let h2 = []str{"h2load", "-t", mint.Itoa(threads), "-c", mint.Itoa(connections), "-m", mint.Itoa(streams)}
	let warm = ci.Exec(join(h2, []str{"-D", "2", url}), "", 30)
	ci.Must(warm, "h2load warm-up")
	ci.Write(ci.Join(logDir, label + ".warmup.log"), warm.Stdout + warm.Stderr)
	benchlib.ParseH2load(warm.Stdout) catch err {
		ci.Fail(say.Str(err))
	}
	let (_, before) = benchlib.ProcessStats(server.Pid)
	let run = ci.Exec(join(h2, []str{"-D", mint.Itoa(seconds), url}), "", seconds + 30)
	ci.Must(run, "h2load")
	ci.Write(ci.Join(logDir, label + ".h2load.log"), run.Stdout + run.Stderr)
	let metrics = benchlib.ParseH2load(run.Stdout) catch err {
		ci.Fail(say.Str(err))
		panic("unreachable")
	}
	let (rss, after) = benchlib.ProcessStats(server.Pid)
	ci.Check(server.Running(), "server exited during measurement: " + label)
	let again = nettest.Do(port, "GET", path, []str{}, "")
	ci.Check(again.Status == 200, "the server stopped answering: " + label)
	benchlib.VerifyBody(path, again.Body) catch err {
		ci.Fail(say.Str(err))
	}
	server.Stop()
	mut perCpu = 0.0
	if after > before {
		perCpu = f64(metrics.Requests) / (after - before)
	}
	return Sample{Server: "", Path: path, Round: 0, Rps: metrics.Rps, MeanUs: metrics.MeanUs, Requests: metrics.Requests, RssKb: f64(rss), PerCpu: perCpu}
}

fn main() {
	let args = quarry.Args()
	mut positional = []str{}
	let root = ci.Root()
	mut jsonPath = ci.Join(root, "bin/bench-h2.json")
	mut i = 1
	for i < len(args) {
		if args[i] == "--json" && i + 1 < len(args) {
			jsonPath = args[i + 1]
			i += 1
		} else {
			positional = append(positional, args[i])
		}
		i += 1
	}
	if len(positional) < 5 || len(positional) > 6 {
		usage("usage: run_h2load CORES THREADS CONNECTIONS STREAMS SECONDS [ROUNDS] [--json PATH]")
	}
	let cores = ci.Num(positional[0])
	let threads = ci.Num(positional[1])
	let connections = ci.Num(positional[2])
	let streams = ci.Num(positional[3])
	let seconds = ci.Num(positional[4])
	mut rounds = 5
	if len(positional) == 6 {
		rounds = ci.Num(positional[5])
	}
	if cores < 1 || threads < 1 || connections < 1 || streams < 1 || seconds < 1 || rounds < 1 {
		usage("all measurement settings must be positive")
	}
	let names = []str{"anvil", "net/http"}
	let commands = [][]str{[]str{ci.Join(root, "bin/api")}, []str{ci.Join(root, "bin/goh2c"), ":9183"}}
	let ports = []i64{9180, 9183}
	let set = []str{"TIN_CORES=" + mint.Itoa(cores), "TIN_PIN=0", "TIN_GRACE=1", "PORT=9180", "GOMAXPROCS=" + mint.Itoa(cores), "LC_ALL=C"}
	let dir = jsonPath[0:twine.LastIndex(jsonPath, "/")]
	ci.Mkdirs(dir)
	let logDir = ci.TempDir(dir, "h2load-")
	let paths = []str{"/json", "/plaintext"}
	mut samples = []Sample{}
	for round in 0..rounds {
		for path in paths {
			for name in benchlib.Order(names, round) {
				mut k = 0
				for j in 0..len(names) {
					if names[j] == name {
						k = j
					}
				}
				let label = mint.Itoa(round) + "-" + twine.Replace(name, "/", "-", -1) + "-" + path[1:]
				let m = measure(commands[k], ports[k], path, threads, connections, streams, seconds, set, logDir, label)
				samples = append(samples, Sample{Server: name, Path: path, Round: round + 1, Rps: m.Rps, MeanUs: m.MeanUs, Requests: m.Requests, RssKb: m.RssKb, PerCpu: m.PerCpu})
			}
		}
	}
	mut records = []str{}
	for s in samples {
		records = append(records, "    {{\"server\": " + benchlib.Quote(s.Server) + ", \"path\": " + benchlib.Quote(s.Path) + ", \"round\": " + mint.Itoa(s.Round) + ", \"rps\": " + benchlib.Num(s.Rps) + ", \"mean_us\": " + benchlib.Num(s.MeanUs) + ", \"requests\": " + mint.Itoa(s.Requests) + ", \"rss_kb\": " + benchlib.Num(s.RssKb) + ", \"requests_per_cpu_second\": " + benchlib.Num(s.PerCpu) + "}}")
	}
	ci.Write(jsonPath, "{{\n  \"rounds\": " + mint.Itoa(rounds) + ",\n  \"cores\": " + mint.Itoa(cores) + ",\n  \"threads\": " + mint.Itoa(threads) + ",\n  \"connections\": " + mint.Itoa(connections) + ",\n  \"streams\": " + mint.Itoa(streams) + ",\n  \"seconds\": " + mint.Itoa(seconds) + ",\n  \"logs\": " + benchlib.Quote(logDir) + ",\n  \"samples\": [\n" + twine.Join(records, ",\n") + "\n  ]\n}}\n")
	say.Line("| server | path | median req/s | median mean latency us | median RSS KiB | median req per CPU s | ratio |")
	say.Line("|---|---|---:|---:|---:|---:|---:|")
	for path in paths {
		mut first = 0.0
		for n in 0..len(names) {
			mut rps = []f64{}
			mut mean = []f64{}
			mut rss = []f64{}
			mut cpu = []f64{}
			for s in samples {
				if s.Server == names[n] && s.Path == path {
					rps = append(rps, s.Rps)
					mean = append(mean, s.MeanUs)
					rss = append(rss, s.RssKb)
					if s.PerCpu > 0.0 {
						cpu = append(cpu, s.PerCpu)
					}
				}
			}
			let mrps = benchlib.Median(rps)
			if n == 0 {
				first = mrps
			}
			say.Line("| " + names[n] + " | " + path + " | " + benchlib.Fixed(mrps, 0) + " | " + benchlib.Fixed(benchlib.Median(mean), 1) + " | " + benchlib.Fixed(benchlib.Median(rss), 0) + " | " + benchlib.Fixed(benchlib.Median(cpu), 0) + " | " + benchlib.Fixed(mrps / first, 3) + " |")
		}
	}
	say.Line("Ratio is req/s relative to " + names[0] + "; higher is faster.")
}
