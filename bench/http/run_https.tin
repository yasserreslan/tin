package main

import "../../tools/ci/ci"
import "../../tools/ci/nettest"
import "../benchlib"
import "./httpsbench"
import "mint"
import "quarry"
import "say"
import "tinjson"
import "twine"

// HTTPS: anvil.ServeTLS (bench/http/https.tin) against Go's crypto/tls (bench/http/gotls), one server core each, interleaved rounds,
// medians with the Tin/Go ratio.
//
// Scenarios (TLS 1.3, certificates generated per run with openssl):
//   handshakes ECDSA P-256 / RSA-2048   bin/tlsload: every connection a full handshake (no session cache; wrk would resume sessions now
//                                       that both servers issue tickets), one GET each
//   resumed handshakes ECDSA P-256      bin/tlsload -resume: every connection resumes the session of the one before (a ticket, no
//                                       certificate or signature, #472)
//   keep-alive /plaintext               wrk: requests per second on established connections
//   1 MiB bodies                        wrk: MiB per second on established connections
//
// Usage: run_https SECONDS ROUNDS [--json PATH]   (needs bin/https_bench, bin/gotls, bin/tlsload, wrk, openssl, curl)

// Scenario is a name, the certificate kind, the path, the connections and whether every request opens a new connection.
type Scenario struct {
	Name str
	Kind str
	Path str
	Conns i64
	Close bool
}

fn scenarios() []Scenario {
	return []Scenario{Scenario{Name: "handshakes ECDSA P-256", Kind: "ecdsa", Path: "/plaintext", Conns: 50, Close: true}, Scenario{Name: "handshakes RSA-2048", Kind: "rsa", Path: "/plaintext", Conns: 50, Close: true}, Scenario{Name: "resumed handshakes ECDSA P-256", Kind: "ecdsa", Path: "/plaintext", Conns: 32, Close: true}, Scenario{Name: "keep-alive /plaintext", Kind: "ecdsa", Path: "/plaintext", Conns: 100, Close: false}, Scenario{Name: "1 MiB bodies", Kind: "ecdsa", Path: "/big?n=1048576", Conns: 10, Close: false}}
}

// Sample is one measurement.
type Sample struct {
	Server str
	Scenario str
	Round i64
	Rps f64
	Mib f64
}

fn measure(name str, s Scenario, cert httpsbench.Cert, seconds i64, logDir str, label str) (f64, f64) {
	mut port = 9191
	if name == "anvil" {
		port = 9190
	}
	let set = []str{"TIN_CORES=1", "TIN_PIN=0", "GOMAXPROCS=1", "PORT=" + mint.Itoa(port), "TLS_CERT=" + cert.Cert, "TLS_KEY=" + cert.Key}
	let root = ci.Root()
	mut exe = ci.Join(root, "bin/https_bench")
	mut args = []str{}
	if name != "anvil" {
		exe = ci.Join(root, "bin/gotls")
		args = []str{":" + mint.Itoa(port), cert.Cert, cert.Key}
	}
	let server = nettest.Start(exe, args, set, ci.Join(logDir, label + ".server.log"), 0)
	httpsbench.Ready(port)
	mut rate = 0.0
	mut mib = 0.0
	if twine.Contains(label, "-resumed-") || twine.Contains(label, "-handshakes-") {
		let resume = twine.Contains(label, "-resumed-")
		mut load = []str{ci.Join(root, "bin/tlsload"), "-addr", "127.0.0.1:" + mint.Itoa(port), "-path", s.Path, "-c", mint.Itoa(s.Conns)}
		if resume {
			load = append(load, "-resume")
		}
		let warm = ci.Exec(append2(load, []str{"-d", "1"}), "", 30)
		ci.Must(warm, "tlsload warm-up")
		let r = ci.Exec(append2(load, []str{"-d", mint.Itoa(seconds)}), "", seconds + 30)
		ci.Must(r, "tlsload")
		ci.Write(ci.Join(logDir, label + ".tlsload.log"), r.Stdout + r.Stderr)
		ci.Check(server.Running(), name + " exited during " + label)
		let (m, ok) = tinjson.Parse(r.Stdout)
		ci.Check(ok, name + " " + label + ": " + r.Stdout)
		let handshakes = m.Get("handshakes").Int()
		let resumed = m.Get("resumed").Int()
		ci.Check(m.Get("errors").Int() == 0 && handshakes != 0 && !(resume && resumed * 10 < handshakes * 9) && !(!resume && resumed != 0), name + " " + label + ": " + r.Stdout)
		rate = benchlib.Median([]f64{f64(m.Get("rate").Int())})
		if !m.Get("rate").IsNumber() {
			rate = 0.0
		}
	} else {
		mut wrk = []str{"wrk", "-t2", "-c" + mint.Itoa(s.Conns)}
		if s.Close {
			wrk = append(wrk, "-H")
			wrk = append(wrk, "Connection: close")
		}
		let url = "https://127.0.0.1:" + mint.Itoa(port) + s.Path
		ci.Must(ci.Exec(append2(wrk, []str{"-d1s", url}), "", 30), "wrk warm-up")
		let r = ci.Exec(append2(wrk, []str{"-d" + mint.Itoa(seconds) + "s", url}), "", seconds + 30)
		ci.Must(r, "wrk")
		ci.Write(ci.Join(logDir, label + ".wrk.log"), r.Stdout + r.Stderr)
		ci.Check(server.Running(), name + " exited during " + label)
		let parsed = httpsbench.ParseWrk(r.Stdout, name != "anvil")
		rate = parsed.Rps
		mib = parsed.Mib
	}
	server.Stop()
	return rate, mib
}

fn append2(a []str, b []str) []str {
	mut out = []str{}
	for x in a {
		out = append(out, x)
	}
	for x in b {
		out = append(out, x)
	}
	return out
}

fn main() {
	let args = quarry.Args()
	mut positional = []str{}
	mut jsonPath = ci.Join(ci.Root(), "bin/bench-https.json")
	mut i = 1
	for i < len(args) {
		if args[i] == "--json" && i + 1 < len(args) {
			jsonPath = args[i + 1]
			i += 1
		} else {
			positional = append(positional, args[i])
		}
		i += 1
	}
	if len(positional) != 2 {
		say.Line("usage: run_https SECONDS ROUNDS [--json PATH]")
		quarry.Exit(2)
	}
	let seconds = ci.Num(positional[0])
	let rounds = ci.Num(positional[1])
	let dir = jsonPath[0:twine.LastIndex(jsonPath, "/")]
	ci.Mkdirs(dir)
	let logDir = ci.TempDir(dir, "https-")
	let certs = httpsbench.MakeCerts(logDir)
	let servers = []str{"anvil", "crypto/tls"}
	let all = scenarios()
	mut samples = []Sample{}
	for round in 0..rounds {
		for s in all {
			for name in benchlib.Order(servers, round) {
				let first = twine.Split(s.Name, " ")[0]
				let route = twine.Split(twine.Trim(s.Path, "/"), "?")[0]
				let label = mint.Itoa(round) + "-" + twine.Replace(name, "/", "-", -1) + "-" + first + "-" + s.Kind + "-" + route
				let (rps, mib) = measure(name, s, httpsbench.CertOf(certs, s.Kind), seconds, logDir, label)
				samples = append(samples, Sample{Server: name, Scenario: s.Name, Round: round + 1, Rps: rps, Mib: mib})
			}
		}
	}
	mut records = []str{}
	for r in samples {
		records = append(records, "    {{\"server\": " + benchlib.Quote(r.Server) + ", \"scenario\": " + benchlib.Quote(r.Scenario) + ", \"round\": " + mint.Itoa(r.Round) + ", \"rps\": " + benchlib.Num(r.Rps) + ", \"mib\": " + benchlib.Num(r.Mib) + "}}")
	}
	ci.Write(jsonPath, "{{\n  \"rounds\": " + mint.Itoa(rounds) + ",\n  \"seconds\": " + mint.Itoa(seconds) + ",\n  \"logs\": " + benchlib.Quote(logDir) + ",\n  \"samples\": [\n" + twine.Join(records, ",\n") + "\n  ]\n}}\n")
	say.Line("| scenario | anvil | crypto/tls | anvil / Go |")
	say.Line("|---|---:|---:|---:|")
	for s in all {
		mut big = twine.HasPrefix(s.Path, "/big")
		mut unit = "req/s"
		if big {
			unit = "MiB/s"
		} else if s.Close {
			unit = "handshakes/s"
		}
		mut medians = []f64{}
		for name in servers {
			mut values = []f64{}
			for r in samples {
				if r.Server == name && r.Scenario == s.Name {
					if big {
						values = append(values, r.Mib)
					} else {
						values = append(values, r.Rps)
					}
				}
			}
			medians = append(medians, benchlib.Median(values))
		}
		say.Line("| " + s.Name + " | " + benchlib.Fixed(medians[0], 0) + " " + unit + " | " + benchlib.Fixed(medians[1], 0) + " " + unit + " | " + benchlib.Fixed(medians[0] / medians[1], 2) + " |")
	}
	say.Line("One server core each (TIN_CORES=1, GOMAXPROCS=1), wrk -t2 on the same machine, " + mint.Itoa(seconds) + " s runs, " + mint.Itoa(rounds) + " alternating rounds, medians; higher is better.")
}
