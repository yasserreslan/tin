package main

import "../../tools/ci/ci"
import "../../tools/ci/nettest"
import "./httpsbench"
import "quarry"
import "say"
import "tide"
import "twine"

// Where a full TLS handshake spends its time in anvil (#488): bin/https_bench on one core under bin/tlsload (every connection a full
// handshake), sampled with perf's cpu-clock for SECONDS. Prints the flat profile (top symbols, percent of the server's samples) for an
// ECDSA P-256 and an RSA-2048 certificate. Linux only; needs perf, openssl, curl, and bin/https_bench and bin/tlsload built (the Profile
// workflow builds them).
// Usage: profile_https SECONDS [ecdsa|rsa ...]

fn profile(kind str, cert httpsbench.Cert, seconds i64, top i64) {
	let root = ci.Root()
	let dir = ci.TempDir(ci.Join(root, "bin"), "perf-")
	let server = nettest.Start(ci.Join(root, "bin/https_bench"), []str{}, []str{"TIN_CORES=1", "TIN_PIN=0", "PORT=9190", "TLS_CERT=" + cert.Cert, "TLS_KEY=" + cert.Key}, ci.Join(dir, "server.log"), 0)
	httpsbench.Ready(9190)
	// the load runs for the whole sample and a little more, in the background of this program
	let load = ci.Join(dir, "load.out")
	let started = ci.Sh("nohup " + ci.Join(root, "bin/tlsload") + " -addr 127.0.0.1:9190 -path /plaintext -c 50 -d " + say.Str(seconds + 4) + " > " + load + " 2>&1 &", "", 10)
	ci.Must(started, "start tlsload")
	tide.Sleep(2000000000)
	let data = ci.Join(dir, "perf.data")
	ci.Must(ci.Exec([]str{"sudo", "perf", "record", "-e", "cpu-clock", "-F", "1999", "-p", say.Str(server.Pid), "-o", data, "--", "sleep", say.Str(seconds)}, "", seconds + 60), "perf record")
	let report = ci.Exec([]str{"sudo", "perf", "report", "-i", data, "--no-children", "--sort", "symbol", "--stdio", "--percent-limit", "0.3"}, "", 120)
	ci.Must(report, "perf report")
	tide.Sleep(4000000000)
	let rate = twine.TrimSpace(ci.Read(load))
	mut lines = []str{}
	for l in ci.Lines(report.Stdout) {
		if len(twine.TrimSpace(l)) > 0 && !twine.HasPrefix(l, "#") {
			lines = append(lines, l)
		}
	}
	if len(lines) > top {
		lines = lines[0:top]
	}
	say.Line("### " + kind + ": full handshakes (load generator) " + rate)
	say.Line("```")
	say.Line(twine.Join(lines, "\n"))
	say.Line("```")
	ci.Check(server.Running(), "the server died")
	server.Stop()
	ci.Remove(dir)
}

fn main() {
	let args = quarry.Args()
	if len(args) < 2 {
		say.Line("usage: profile_https SECONDS [ecdsa|rsa ...]")
		quarry.Exit(2)
	}
	let seconds = ci.Num(args[1])
	mut kinds = []str{"ecdsa", "rsa"}
	if len(args) > 2 {
		kinds = args[2:]
	}
	let work = ci.TempDir(ci.Join(ci.Root(), "bin"), "certs-")
	let certs = httpsbench.MakeCerts(work)
	for kind in kinds {
		profile(kind, httpsbench.CertOf(certs, kind), seconds, 45)
	}
	ci.Remove(work)
}
