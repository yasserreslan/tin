package main

import "../tools/ci/ci"
import "./benchlib"
import "mint"
import "quarry"
import "say"
import "twine"

// Compare Tin and Go with alternating runs, output equality and medians.
//
// BENCH_DIR selects the suite (default bench/); RUNS defaults to seven. Reference performance numbers come from native Linux
// (toolchain/docs/PERFORMANCE.md).
//
// Usage: run [--json PATH] [NAME...]

fn main() {
	// Benchmarks measure raw allocation; a plain program past 512 MiB of pool (binary-trees) would print the #629 warning, which the
	// output comparison would count as a difference.
	let args = quarry.Args()
	mut jsonPath = ""
	mut selected = []str{}
	mut i = 1
	for i < len(args) {
		if args[i] == "--json" && i + 1 < len(args) {
			jsonPath = args[i + 1]
			i += 1
		} else {
			selected = append(selected, args[i])
		}
		i += 1
	}
	let root = ci.Root()
	let directory = ci.Join(root, benchlib.Env("BENCH_DIR", "bench"))
	let runs = ci.Num(benchlib.Env("RUNS", "7"))
	if runs < 7 {
		say.Line("RUNS must be at least 7")
		quarry.Exit(2)
	}
	let names = benchlib.BenchmarkNames(directory, selected) catch err {
		say.Line(say.Str(err))
		quarry.Exit(2)
		return
	}
	ci.Must(ci.Exec([]str{"make", "-s", "bin/tinc"}, root, 600), "make bin/tinc")
	let output = ci.Join(root, "bin/bench")
	ci.Mkdirs(output)
	let tmp = ci.TempDir(output, "reference-")
	mut records = []str{}
	say.Line("| benchmark | Tin build ms | Go build ms | Tin run ms | Go run ms | Go/Tin time |")
	say.Line("|---|---:|---:|---:|---:|---:|")
	for name in names {
		let tinExe = ci.Join(tmp, name + "_tin")
		let goExe = ci.Join(tmp, name + "_go")
		let builds = []benchlib.Command{benchlib.TinCommand(root, ci.Join(directory, name + ".tin"), tinExe, ""), benchlib.Command{Argv: []str{"go", "-C", directory, "build", "-o", goExe, name + ".go"}, Dir: "", Set: []str{"TIN_POOL_WARN_MB=0"}}}
		let build = benchlib.Interleaved([]str{"tin", "go"}, builds, 3, false, benchlib.DefaultRunner()) catch err {
			ci.Fail(say.Str(err))
			panic("unreachable")
		}
		let runsCmd = []benchlib.Command{benchlib.Command{Argv: []str{tinExe}, Dir: "", Set: []str{"TIN_POOL_WARN_MB=0"}}, benchlib.Command{Argv: []str{goExe}, Dir: "", Set: []str{"TIN_POOL_WARN_MB=0"}}}
		let timing = benchlib.Interleaved([]str{"tin", "go"}, runsCmd, runs, true, benchlib.DefaultRunner()) catch err {
			ci.Fail(say.Str(err))
			panic("unreachable")
		}
		let ratio = timing.MedianOf("go") / timing.MedianOf("tin")
		say.Line("| " + name + " | " + benchlib.Fixed(build.MedianOf("tin") * 1000.0, 1) + " | " + benchlib.Fixed(build.MedianOf("go") * 1000.0, 1) + " | " + benchlib.Fixed(timing.MedianOf("tin") * 1000.0, 1) + " | " + benchlib.Fixed(timing.MedianOf("go") * 1000.0, 1) + " | " + benchlib.Fixed(ratio, 3) + " |")
		records = append(records, "    {{\"benchmark\": " + benchlib.Quote(name) + ", \"seconds\": {{\"tin\": " + benchlib.NumList(timing.SamplesOf("tin")) + ", \"go\": " + benchlib.NumList(timing.SamplesOf("go")) + "}}, \"go_over_tin\": " + benchlib.Num(ratio) + "}}")
	}
	if len(jsonPath) > 0 {
		ci.Mkdirs(jsonPath[0:twine.LastIndex(jsonPath, "/")])
		ci.Write(jsonPath, "{{\n  \"runs\": " + mint.Itoa(runs) + ",\n  \"results\": [\n" + twine.Join(records, ",\n") + "\n  ]\n}}\n")
	}
	ci.Remove(tmp)
}
