#!/bin/sh
# tin: run, build and test Tin programs with the self-hosted compiler (no cc, no Go).
#
#   tin FILE.tin [ARGS...]          compile and run
#   tin run [--polls] FILE.tin... [-- ARGS]   compile and run several files as one program
#   tin build FILE.tin... [-o OUT] [--target T] [--polls]  executable (darwin-arm64, linux-arm64, linux-amd64)
#   tin asm FILE.tin...             print the generated ARM64 assembly
#   tin audit secrets [-edition 1] FILE.tin...  list every reveal and secret library argument
#   tin fix -edition 1 FILES...    rewrite legacy syntax to edition 1
#   tin test [-bench] [DIR]         run DIR's *_test.tin tests (TestXxx, BenchmarkXxx)
#   tin replay CAPSULE --against BUILD [--live KIND]... [--save-test NAME --issue N]  replay a recorded request
#   tin vendor [DIR]                copy tin.mod's requires into vendor/ and write tin.lock
#   tin caps FILE.tin...            print the capabilities each package can reach
#   tin suite                       run the compiler's strict test suite (tests/v2)
#   tin bootstrap                   rebuild the compiler with itself and check the fixed point
#   tin version
set -e
self=$0
[ -L "$self" ] && self=$(readlink "$self")
root=$(cd "$(dirname "$self")" && pwd)
tinc=$root/bin/tinc
[ -x "$tinc" ] || make -s -C "$root" bin/tinc
export TIN_ROOT="$root"

target=
polls=
strip=
compile() { # out files...
  out=$1; shift
  "$tinc" $polls $strip ${target:+-target} ${target:+"$target"} -o "$out" "$@"
}

cache=${TMPDIR:-/tmp}/tin-$(id -u)
mkdir -p "$cache"

case $1 in
  run)
    # files holds references like "${2}" to the positional arguments, so eval never splits or globs a name.
    shift
    if [ "${1:-}" = "--polls" ] || [ "${1:-}" = "-polls" ]; then polls=-polls; shift; fi
    files=; n=0
    for a do [ "$a" = "--" ] && break; n=$((n + 1)); files="$files \"\${$n}\""; done
    exe=$cache/run.$$; trap 'rm -f "$exe"' EXIT
    eval "compile \"\$exe\" $files"
    shift $n; [ "$1" = "--" ] && shift
    "$exe" "$@" ;;
  build)
    shift; out=; files=; first=; i=0; skip=
    for a do
      i=$((i + 1))
      case $skip in o) out=$a; skip=; continue ;; t) target=$a; skip=; continue ;; esac
      case $a in
        -o) skip=o ;;
        --target|-target) skip=t ;;
        --polls|-polls) polls=-polls ;;
        --strip|-strip) strip=-strip ;;
        *) files="$files \"\${$i}\""; [ -n "$first" ] || first=$a ;;
      esac
    done
    [ -z "$skip" ] || { echo "tin: build: missing value after the last option" >&2; exit 2; }
    [ -n "$first" ] || { echo "tin: build: no files" >&2; exit 2; }
    [ -n "$out" ] || out=$(basename "$first" .tin)
    eval "compile \"\$out\" $files" ;;
  asm)
    shift
    "$tinc" -S "$@" ;;
  caps)
    shift
    [ $# -gt 0 ] || { echo "tin: caps: no files" >&2; exit 2; }
    "$tinc" -caps "$@" ;;
  audit)
    shift
    [ "${1:-}" = secrets ] || { echo "tin: audit: unknown audit '${1:-}' (try: tin audit secrets FILE.tin)" >&2; exit 2; }
    shift
    "$tinc" -audit-secrets "$@" ;;
  fix)
    shift
    [ "$#" -ge 3 ] && [ "$1" = "-edition" ] && [ "$2" = "1" ] || {
      echo "usage: tin fix -edition 1 FILES..." >&2
      exit 2
    }
    shift 2
    [ "$#" -gt 0 ] || { echo "tin: fix: no files" >&2; exit 2; }
    # A file is rewritten only when its translation parses as edition 1 and translating it
    # again changes nothing; otherwise it is left as it was and named (status 1 at the end).
    status=0
    for f do
      [ -f "$f" ] || { echo "tin: fix: $f is not a file" >&2; exit 2; }
      tmp=$(mktemp "$f.tinfix.XXXXXX"); again=$(mktemp "$f.tinfix.XXXXXX")
      cp -p "$f" "$tmp"
      if ! "$tinc" -fix -edition 1 "$f" > "$tmp"; then
        rm -f "$tmp" "$again"; status=1; continue
      fi
      if ! "$tinc" -edition 1 -parse-only "$tmp" 2> "$again"; then
        echo "tin: fix: $f left unchanged: its translation is not edition 1 yet:" >&2
        sed "s|$tmp|$f (translated)|" "$again" >&2
        rm -f "$tmp" "$again"; status=1; continue
      fi
      if ! "$tinc" -fix -edition 1 "$tmp" > "$again" || ! cmp -s "$tmp" "$again"; then
        echo "tin: fix: $f left unchanged: translating it twice gives two results" >&2
        rm -f "$tmp" "$again"; status=1; continue
      fi
      rm -f "$again"
      if cmp -s "$f" "$tmp"; then rm -f "$tmp"; else mv "$tmp" "$f"; fi
    done
    exit $status ;;
  test)
    # tin test [-bench] [DIR]: build DIR's package with its *_test.tin files and a generated
    # runner, then run every TestXxx(t mut crucible.T) (and BenchmarkXxx with -bench).
    shift; bench=0; dir=
    for a do
      case $a in
        -bench) bench=1 ;;
        -*) echo "tin: test: unknown option $a" >&2; exit 2 ;;
        *) [ -z "$dir" ] || { echo "tin: test: one directory at a time" >&2; exit 2; }; dir=$a ;;
      esac
    done
    [ -n "$dir" ] || dir=.
    [ -d "$dir" ] || { echo "tin: test: $dir is not a directory" >&2; exit 2; }
    set --
    for f in "$dir"/*.tin; do [ -f "$f" ] && set -- "$@" "$f"; done
    tests=0
    for f do case $f in *_test.tin) tests=1 ;; esac; done
    [ "$tests" = 1 ] || { echo "tin: test: no *_test.tin files in $dir"; exit 0; }
    first=
    for f do case $f in *_test.tin) [ -n "$first" ] || first=$f ;; esac; done
    pkg=$(sed -n 's/^package[[:space:]]\{1,\}\([A-Za-z_][A-Za-z0-9_]*\).*/\1/p' "$first" | head -n 1)
    [ -n "$pkg" ] || { echo "tin: test: $first has no package clause" >&2; exit 2; }
    runner=$cache/tintest.$$.tin; exe=$cache/tintest.$$; trap 'rm -f "$exe" "$runner"' EXIT
    {
      echo "package $pkg"
      echo 'import "crucible"'
      echo 'fn TinTestMain() {'
      # As in go test, every TestXxx/BenchmarkXxx in a *_test.tin file (Xxx not starting with a
      # lowercase letter) must be declared on one line as fn TestXxx(name mut crucible.T) {
      # (crucible.B for a benchmark); any other signature is an error, not a skipped test.
      awk -v bench="$bench" '
        FILENAME ~ /_test[.]tin$/ && /^(func|fn)[ \t]+(Test|Benchmark)/ {
          kw = "fn"; if ($0 ~ /^func/) kw = "func"
          name = $0; sub(/^(func|fn)[ \t]+/, "", name); sub(/[^A-Za-z0-9_].*/, "", name)
          if (name ~ /^(Test|Benchmark)[a-z]/) next
          k = "B"; if (name ~ /^Test/) k = "T"
          if ($0 !~ "^" kw "[ \t]+" name "[ \t]*[(][ \t]*[A-Za-z_][A-Za-z0-9_]*[ \t]+mut[ \t]+crucible[.]" k "[ \t]*,?[ \t]*[)][ \t]*[{]") {
            printf "tin: test: %s:%d: wrong signature for %s, must be: %s %s(%s mut crucible.%s)\n", FILENAME, FNR, name, kw, name, tolower(k), k > "/dev/stderr"
            bad = 2
          } else if (k == "T") print "\tcrucible.Run(\"" name "\", " name ")"
          else if (bench == 1) benches = benches "\tcrucible.RunBench(\"" name "\", " name ")\n"
        }
        END { printf "%s", benches; exit bad }' "$@" || exit 2
      echo '	crucible.Finish()'
      echo '}'
    } > "$runner"
    entry=TinTestMain
    [ "$pkg" = main ] || entry=$pkg.TinTestMain
    "$tinc" -entry "$entry" -o "$exe" "$@" "$runner"
    "$exe" ;;
  replay)
    # tin replay CAPSULE --against BUILD [--live KIND]...: run BUILD (a binary, or FILE.tin built
    # here) on the capsule's request with every effect served from the capsule (#242; the
    # report and the exit status, 0, 3 diverged or 4 unreadable, are the program's).
    # --save-test NAME --issue N then saves FILE.tin and the capsule as a regression case.
    shift; capsule=; build=; live=; skip=; save=; issue=
    for a do
      case $skip in
        b) build=$a; skip=; continue ;; l) live=${live:+$live,}$a; skip=; continue ;;
        s) save=$a; skip=; continue ;; i) issue=$a; skip=; continue ;;
      esac
      case $a in
        --against|-against) skip=b ;;
        --live|-live) skip=l ;;
        --save-test|-save-test) skip=s ;;
        --issue|-issue) skip=i ;;
        -*) echo "tin: replay: unknown option $a" >&2; exit 2 ;;
        *) [ -z "$capsule" ] || { echo "tin: replay: one capsule at a time" >&2; exit 2; }; capsule=$a ;;
      esac
    done
    [ -z "$skip" ] || { echo "tin: replay: missing value after the last option" >&2; exit 2; }
    [ -n "$capsule" ] || { echo "tin: replay: no capsule (try: tin replay CAPSULE --against BUILD)" >&2; exit 2; }
    [ -f "$capsule" ] || { echo "tin: replay: $capsule: no such file" >&2; exit 4; }
    [ -n "$build" ] || { echo "tin: replay: --against BUILD is needed (the program, or its FILE.tin)" >&2; exit 2; }
    capsule=$(cd "$(dirname "$capsule")" && pwd)/$(basename "$capsule")
    case $build in
      *.tin) exe=$cache/replay.$$; trap 'rm -f "$exe"' EXIT; compile "$exe" "$build" ;;
      */*) exe=$build ;;
      *) exe=./$build ;;
    esac
    [ -x "$exe" ] || { echo "tin: replay: $build: not an executable" >&2; exit 2; }
    [ -z "$save" ] || [ -n "$issue" ] || { echo "tin: replay: --save-test needs --issue N (the issue the test is for)" >&2; exit 2; }
    [ -z "$save" ] || [ -z "$live" ] || { echo "tin: replay: --save-test cannot keep --live calls in a test" >&2; exit 2; }
    case $save:$build in :*|*:*.tin) ;; *) echo "tin: replay: --save-test needs BUILD as FILE.tin" >&2; exit 2 ;; esac
    if [ -z "$save" ]; then TIN_REPLAY_CAPSULE=$capsule TIN_REPLAY_LIVE=$live "$exe"; exit 0; fi
    out=$cache/replay.$$.out; trap 'rm -f "$exe" "$out"' EXIT
    set +e
    TIN_REPLAY_CAPSULE=$capsule TIN_REPLAY_LIVE= "$exe" > "$out"
    code=$?
    set -e
    cat "$out"
    [ "$code" = 0 ] || { echo "tin: replay: not saved: the replay exited with status $code" >&2; exit "$code"; }
    python3 "$root/tools/replay_save.py" "$root" "$save" "$issue" "$capsule" "$build" "$out" ;;
  vendor)
    # tin vendor [DIR]: copy every package DIR/tin.mod requires, and the packages their tin.mod
    # files require, into DIR/vendor/<path>, then write DIR/tin.lock (docs/PACKAGES.md).
    shift
    [ $# -le 1 ] || { echo "tin: vendor: one project directory at a time" >&2; exit 2; }
    proj=${1:-.}
    [ -f "$proj/tin.mod" ] || { echo "tin: vendor: no tin.mod in $proj" >&2; exit 2; }
    proj=$(cd "$proj" && pwd)
    work=$(mktemp -d "$cache/vendor.XXXXXX"); trap 'rm -rf "$work"' EXIT
    mkdir "$work/vendor"
    # requires DIR appends "path<TAB>absolute source" for each require line of DIR/tin.mod.
    requires() {
      sed -n 's/^[[:space:]]*require[[:space:]]\{1,\}\([^[:space:]]\{1,\}\)[[:space:]]\{1,\}\(.*[^[:space:]]\)[[:space:]]*$/\1	\2/p' "$1/tin.mod" > "$work/req"
      while IFS='	' read -r p s; do
        case $s in /*) ;; *) s=$1/$s ;; esac
        [ -d "$s" ] || { echo "tin: vendor: $1/tin.mod: require $p: $s is not a directory" >&2; return 1; }
        printf '%s\t%s\n' "$p" "$(cd "$s" && pwd)" >> "$work/queue"
      done < "$work/req"
    }
    : > "$work/queue"; : > "$work/done"
    requires "$proj" || exit 1
    while [ -s "$work/queue" ]; do
      IFS='	' read -r p s < "$work/queue"
      tail -n +2 "$work/queue" > "$work/rest"; mv "$work/rest" "$work/queue"
      case $p in
        /*|*..*|*//*|*/) echo "tin: vendor: bad import path '$p'" >&2; exit 1 ;;
      esac
      case ${p%%/*} in
        *.*) ;;
        *) echo "tin: vendor: require $p: an import path starts with a domain (example.com/name)" >&2; exit 1 ;;
      esac
      seen=$(awk -F '	' -v p="$p" '$1 == p { print $2; exit }' "$work/done")
      if [ -n "$seen" ]; then
        [ "$seen" = "$s" ] || { echo "tin: vendor: $p is required from two sources: $seen and $s" >&2; exit 1; }
        continue
      fi
      printf '%s\t%s\n' "$p" "$s" >> "$work/done"
      mkdir -p "$work/vendor/$p"
      n=0
      for f in "$s"/*.tin; do
        case $f in *_test.tin) continue ;; esac
        [ -f "$f" ] || continue
        cp "$f" "$work/vendor/$p/"; n=$((n + 1))
      done
      [ "$n" -gt 0 ] || { echo "tin: vendor: require $p: no .tin files in $s" >&2; exit 1; }
      if [ -f "$s/tin.mod" ]; then
        cp "$s/tin.mod" "$work/vendor/$p/"
        requires "$s" || exit 1
      fi
    done
    # The lock: entries the project keeps for its own files, every vendored file, sorted, then
    # each package's capabilities from its tin.mod, so a reviewer sees what an upgrade asks for.
    LC_ALL=C sort "$work/done" > "$work/sorted"
    {
      [ ! -f "$proj/tin.lock" ] || awk 'length($1) == 64 && index($0, " vendor/") != 65' "$proj/tin.lock"
      (cd "$work" && find vendor -type f \( -name '*.tin' -o -name tin.mod \) | LC_ALL=C sort | while IFS= read -r f; do "$tinc" -hash "$f"; done)
      while IFS='	' read -r p s; do
        caps=
        [ ! -f "$work/vendor/$p/tin.mod" ] || caps=$(awk '$1 == "caps" { for (i = 2; i <= NF; i++) print $i }' "$work/vendor/$p/tin.mod")
        for c in $caps; do
          case $c in net|files|spawn|exec|unsafe) ;; *) echo "tin: vendor: $p/tin.mod: unknown capability '$c' (net, files, spawn, exec, unsafe)" >&2; exit 1 ;; esac
        done
        line="caps $p"
        for c in net files spawn exec unsafe; do
          case " $(echo $caps) " in *" $c "*) line="$line $c" ;; esac
        done
        printf '%s\n' "$line"
      done < "$work/sorted"
    } > "$work/lock"
    # Nothing in the project changes until everything has been copied and hashed.
    rm -rf "$proj/vendor"
    mv "$work/vendor" "$proj/vendor"
    mv "$work/lock" "$proj/tin.lock"
    echo "tin: vendored $(wc -l < "$work/done" | tr -d ' ') packages into $proj/vendor" ;;
  suite)
    "$root/tools/v2test.sh" "$tinc" ;;
  bootstrap)
    make -s -C "$root" bootstrap ;;
  version|-v|--version)
    version=dev
    [ ! -f "$root/VERSION" ] || version=$(cat "$root/VERSION")
    host=$(uname -s | tr A-Z a-z)-$(uname -m | sed 's/x86_64/amd64/; s/aarch64/arm64/')
    echo "tin $version (self-hosted, $host, compiler $(cksum < "$tinc" | cut -d' ' -f1))" ;;
  ""|help|-h|--help)
    sed -n '2,15p' "$self" | sed 's/^# \{0,1\}//' ;;
  *.tin)
    f=$1; shift
    exe=$cache/run.$$; trap 'rm -f "$exe"' EXIT
    compile "$exe" "$f"
    "$exe" "$@" ;;
  *)
    echo "tin: unknown command '$1' (try: tin help)" >&2; exit 2 ;;
esac
