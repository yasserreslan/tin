package main

import "say"
import "bits"

// Every function of package bits over exhaustive 8- and 16-bit inputs and thousands of 32- and 64-bit
// ones, each reduced to a hash of its results; bench/ref/bits/main.go prints the same lines through Go's
// math/bits (its expected output is Go's). Generated from one description with that program.

mut state u64 = 88172645463325252

fn next() u64 {
	state ^= state << 13
	state ^= state >> 7
	state ^= state << 17
	return state
}

fn mix(h u64, v u64) u64 {
	for i in 0..8 {
		h ^= (v >> u64(8*i)) & 0xff
		h *%= 1099511628211
	}
	return h
}

fn out(name str, n i64, h u64) {
	say.Line(name, n, say.Fmt("%016x", h))
}

fn main() {
	let seedHash = u64(14695981039346656037)
	mut in8 = make([]u8, 0, 256)
	for i in 0..256 {
		in8 = append(in8, u8(i))
	}
	mut in16 = make([]u16, 0, 65536)
	for i in 0..65536 {
		in16 = append(in16, u16(i))
	}
	mut in64 = []u64{0, 1, 2, 3, 0x7fffffffffffffff, 0x8000000000000000, 0xffffffffffffffff, 0xfffffffffffffffe, 0x00000000ffffffff, 0xffffffff00000000}
	for k in 0..64 {
		in64 = append(in64, u64(1)<<u64(k), u64(1)<<u64(k)-1, u64(1)<<u64(k)+1)
	}
	for i in 0..20000 {
		mut r = next()
		let m = i % 4
		if m == 1 {
			r &= next()
		} else if m == 2 {
			r |= next()
		} else if m == 3 {
			r <<= next() % 64
		}
		in64 = append(in64, r)
	}
	mut in32 = make([]u32, 0, 2*len(in64))
	for _, v in in64 {
		in32 = append(in32, u32(v), u32(v>>32))
	}
	let ks = []i64{-70, -33, -9, -1, 0, 1, 5, 7, 8, 15, 16, 17, 31, 32, 33, 63, 64, 65, 100}

	{
		mut h = seedHash
		for _, x in in8 {
			h = mix(h, u64(bits.LeadingZeros8(x)))
		}
		out("LeadingZeros8", len(in8), h)
	}
	{
		mut h = seedHash
		for _, x in in16 {
			h = mix(h, u64(bits.LeadingZeros16(x)))
		}
		out("LeadingZeros16", len(in16), h)
	}
	{
		mut h = seedHash
		for _, x in in32 {
			h = mix(h, u64(bits.LeadingZeros32(x)))
		}
		out("LeadingZeros32", len(in32), h)
	}
	{
		mut h = seedHash
		for _, x in in64 {
			h = mix(h, u64(bits.LeadingZeros64(x)))
		}
		out("LeadingZeros64", len(in64), h)
	}
	{
		mut h = seedHash
		for _, x in in8 {
			h = mix(h, u64(bits.TrailingZeros8(x)))
		}
		out("TrailingZeros8", len(in8), h)
	}
	{
		mut h = seedHash
		for _, x in in16 {
			h = mix(h, u64(bits.TrailingZeros16(x)))
		}
		out("TrailingZeros16", len(in16), h)
	}
	{
		mut h = seedHash
		for _, x in in32 {
			h = mix(h, u64(bits.TrailingZeros32(x)))
		}
		out("TrailingZeros32", len(in32), h)
	}
	{
		mut h = seedHash
		for _, x in in64 {
			h = mix(h, u64(bits.TrailingZeros64(x)))
		}
		out("TrailingZeros64", len(in64), h)
	}
	{
		mut h = seedHash
		for _, x in in8 {
			h = mix(h, u64(bits.PopCount8(x)))
		}
		out("PopCount8", len(in8), h)
	}
	{
		mut h = seedHash
		for _, x in in16 {
			h = mix(h, u64(bits.PopCount16(x)))
		}
		out("PopCount16", len(in16), h)
	}
	{
		mut h = seedHash
		for _, x in in32 {
			h = mix(h, u64(bits.PopCount32(x)))
		}
		out("PopCount32", len(in32), h)
	}
	{
		mut h = seedHash
		for _, x in in64 {
			h = mix(h, u64(bits.PopCount64(x)))
		}
		out("PopCount64", len(in64), h)
	}
	{
		mut h = seedHash
		for _, x in in8 {
			h = mix(h, u64(bits.Len8(x)))
		}
		out("Len8", len(in8), h)
	}
	{
		mut h = seedHash
		for _, x in in16 {
			h = mix(h, u64(bits.Len16(x)))
		}
		out("Len16", len(in16), h)
	}
	{
		mut h = seedHash
		for _, x in in32 {
			h = mix(h, u64(bits.Len32(x)))
		}
		out("Len32", len(in32), h)
	}
	{
		mut h = seedHash
		for _, x in in64 {
			h = mix(h, u64(bits.Len64(x)))
		}
		out("Len64", len(in64), h)
	}
	{
		mut h = seedHash
		for _, x in in8 {
			h = mix(h, u64(bits.Reverse8(x)))
		}
		out("Reverse8", len(in8), h)
	}
	{
		mut h = seedHash
		for _, x in in16 {
			h = mix(h, u64(bits.Reverse16(x)))
		}
		out("Reverse16", len(in16), h)
	}
	{
		mut h = seedHash
		for _, x in in32 {
			h = mix(h, u64(bits.Reverse32(x)))
		}
		out("Reverse32", len(in32), h)
	}
	{
		mut h = seedHash
		for _, x in in64 {
			h = mix(h, u64(bits.Reverse64(x)))
		}
		out("Reverse64", len(in64), h)
	}
	{
		mut h = seedHash
		for _, x in in16 {
			h = mix(h, u64(bits.ReverseBytes16(x)))
		}
		out("ReverseBytes16", len(in16), h)
	}
	{
		mut h = seedHash
		for _, x in in32 {
			h = mix(h, u64(bits.ReverseBytes32(x)))
		}
		out("ReverseBytes32", len(in32), h)
	}
	{
		mut h = seedHash
		for _, x in in64 {
			h = mix(h, u64(bits.ReverseBytes64(x)))
		}
		out("ReverseBytes64", len(in64), h)
	}
	{
		mut h = seedHash
		mut n = 0
		for _, x in in8 {
			for _, k in ks {
				h = mix(h, u64(bits.RotateLeft8(x, k)))
				n += 1
			}
		}
		out("RotateLeft8", n, h)
	}
	{
		mut h = seedHash
		mut n = 0
		for _, x in in16 {
			for _, k in ks {
				h = mix(h, u64(bits.RotateLeft16(x, k)))
				n += 1
			}
		}
		out("RotateLeft16", n, h)
	}
	{
		mut h = seedHash
		mut n = 0
		for _, x in in32 {
			for _, k in ks {
				h = mix(h, u64(bits.RotateLeft32(x, k)))
				n += 1
			}
		}
		out("RotateLeft32", n, h)
	}
	{
		mut h = seedHash
		mut n = 0
		for _, x in in64 {
			for _, k in ks {
				h = mix(h, u64(bits.RotateLeft64(x, k)))
				n += 1
			}
		}
		out("RotateLeft64", n, h)
	}
	let n = len(in64)
	{
		mut h = seedHash
		for i in 0..n {
			let (a, b) = bits.Add64(in64[i], in64[(i*7+3)%n], in64[(i*13+1)%n] & 1)
			h = mix(mix(h, u64(a)), u64(b))
		}
		out("Add64", n, h)
	}
	{
		mut h = seedHash
		for i in 0..n {
			let (a, b) = bits.Sub64(in64[i], in64[(i*7+3)%n], in64[(i*13+1)%n] & 1)
			h = mix(mix(h, u64(a)), u64(b))
		}
		out("Sub64", n, h)
	}
	{
		mut h = seedHash
		for i in 0..n {
			let (a, b) = bits.Mul64(in64[i], in64[(i*7+3)%n])
			h = mix(mix(h, u64(a)), u64(b))
		}
		out("Mul64", n, h)
	}
	{
		mut h = seedHash
		for i in 0..n {
			let y = in64[(i*7+3)%n] | 1
			let hi = in64[i] % y
			let lo = in64[(i*13+1)%n]
			let (q, r) = bits.Div64(hi, lo, y)
			h = mix(mix(h, u64(q)), u64(r))
		}
		out("Div64", n, h)
	}
	{
		mut h = seedHash
		for i in 0..n {
			let y = in64[(i*7+3)%n] | 1
			h = mix(h, u64(bits.Rem64(in64[i], in64[(i*13+1)%n], y)))
		}
		out("Rem64", n, h)
	}
	{
		mut h = seedHash
		for i in 0..n {
			let (a, b) = bits.Add32(u32(in64[i]), u32(in64[(i*7+3)%n]), u32(in64[(i*13+1)%n] & 1))
			h = mix(mix(h, u64(a)), u64(b))
		}
		out("Add32", n, h)
	}
	{
		mut h = seedHash
		for i in 0..n {
			let (a, b) = bits.Sub32(u32(in64[i]), u32(in64[(i*7+3)%n]), u32(in64[(i*13+1)%n] & 1))
			h = mix(mix(h, u64(a)), u64(b))
		}
		out("Sub32", n, h)
	}
	{
		mut h = seedHash
		for i in 0..n {
			let (a, b) = bits.Mul32(u32(in64[i]), u32(in64[(i*7+3)%n]))
			h = mix(mix(h, u64(a)), u64(b))
		}
		out("Mul32", n, h)
	}
	{
		mut h = seedHash
		for i in 0..n {
			let y = u32(in64[(i*7+3)%n]) | 1
			let hi = u32(in64[i]) % y
			let lo = u32(in64[(i*13+1)%n])
			let (q, r) = bits.Div32(hi, lo, y)
			h = mix(mix(h, u64(q)), u64(r))
		}
		out("Div32", n, h)
	}
	{
		mut h = seedHash
		for i in 0..n {
			let y = u32(in64[(i*7+3)%n]) | 1
			h = mix(h, u64(bits.Rem32(u32(in64[i]), u32(in64[(i*13+1)%n]), y)))
		}
		out("Rem32", n, h)
	}
}
