package main

import "argo"
import "say"

type Box struct {
	n i64
}

func bump(b mut Box) {
	b.n++
}

func show(b Box) {
	say.Line(b.n)
}

func (b mut Box) Add(k i64) {
	b.n += k
}

func main() {
	b := Box{n: 1}
	bump(b)
	show(mut b)
	f := bump
	f(b)
	b.Add(mut 2)
	buf := make([]u8, 0, 16)
	argo.Put(buf, b)
	say.Line(b.n, len(buf))
}
