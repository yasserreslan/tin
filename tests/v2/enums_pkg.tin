package main

import "./enumpkg"
import "say"

func main() {
	sum := 0
	for _, t := range enumpkg.Lex("12 apples 30 pears") {
		switch t {
		case Num(v):
			sum += v
		case Word(w):
			say.Line("word", w)
		case End:
			say.Line("end")
		}
	}
	say.Line(sum, enumpkg.Token.Num(5), enumpkg.Token.Num(5) == enumpkg.Token.Num(5))
}
