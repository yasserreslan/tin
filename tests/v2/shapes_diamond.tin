package main

// 30 shapes, each listing the next twice: composition must be walked once per
// shape, not 2^30 times.

shape S0 { S1; S1 }
shape S1 { S2; S2 }
shape S2 { S3; S3 }
shape S3 { S4; S4 }
shape S4 { S5; S5 }
shape S5 { S6; S6 }
shape S6 { S7; S7 }
shape S7 { S8; S8 }
shape S8 { S9; S9 }
shape S9 { S10; S10 }
shape S10 { S11; S11 }
shape S11 { S12; S12 }
shape S12 { S13; S13 }
shape S13 { S14; S14 }
shape S14 { S15; S15 }
shape S15 { S16; S16 }
shape S16 { S17; S17 }
shape S17 { S18; S18 }
shape S18 { S19; S19 }
shape S19 { S20; S20 }
shape S20 { S21; S21 }
shape S21 { S22; S22 }
shape S22 { S23; S23 }
shape S23 { S24; S24 }
shape S24 { S25; S25 }
shape S25 { S26; S26 }
shape S26 { S27; S27 }
shape S27 { S28; S28 }
shape S28 { S29; S29 }
shape S29 { M() i64 }

type T struct { n i64 }

func (t T) M() i64 {
	return 1
}

func Use[X S0](x X) i64 {
	return x.M()
}

func main() {
	let t = T{n: 1}
	println(Use(t))
}
