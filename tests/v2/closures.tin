package main

import "say"
import "sift"

var g func() i64

func makeCounter() func() i64 {
	n := 0
	return func() i64 {
		n++
		return n
	}
}

func adder(base i64) func(i64) i64 {
	return func(x i64) i64 {
		base += x
		return base
	}
}

func main() {
	xs := []i64{1, 2, 3, 4, 5}
	total := 0
	u0 := rt_pool_used()
	sift.Each(xs, func(x i64) {
		total += x
	})
	u1 := rt_pool_used()
	say.Line("total:", total)
	say.Line("pool diff:", u1 - u0)

	c1 := makeCounter()
	say.Line("c1:", c1())
	say.Line("c1:", c1())
	say.Line("c1:", c1())

	c2 := makeCounter()
	say.Line("c2:", c2())
	say.Line("c1 again:", c1())

	add10 := adder(10)
	say.Line("add10:", add10(5))
	say.Line("add10:", add10(3))

	g = keep(makeCounter())
	say.Line("global keep:", g())
	say.Line("global keep:", g())
}
