package main

import "say"
import "seal"

// Ed25519 signing (#477): RFC 8032 section 7.1 tests 1, 2 and 3. Each prints the public key and
// the signature computed from the seed, and whether VerifyEd25519 accepts the signature.
fn main() {
	let seeds = []str{"9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60",
		"4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb",
		"c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7"}
	let msgs = []str{"", "72", "af82"}
	for i in 0..3 {
		let seed = seal.HexDecode(seeds[i]) catch _ { []u8{} }
		let msg = seal.HexDecode(msgs[i]) catch _ { []u8{} }
		let pub = seal.Ed25519PublicKey(seed) catch e {
			say.Line("fault", e)
			return
		}
		let sig = seal.SignEd25519(seed, msg) catch e {
			say.Line("fault", e)
			return
		}
		mut ok = true
		seal.VerifyEd25519(pub, msg, sig) catch _ {
			ok = false
		}
		say.Line("test", i+1, seal.Hex(pub), seal.Hex(sig), ok)
	}
	// A wrong seed length is refused.
	let _ = seal.SignEd25519([]u8{1, 2, 3}, []u8{}) catch e {
		say.Line("fault", e)
		[]u8{}
	}
}
