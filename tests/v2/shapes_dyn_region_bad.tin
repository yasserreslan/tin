package main

import "io"

// The region rule: a dyn value's bits are its object's, so request memory cannot reach a
// global through one.
type Buf struct { n i64 }

func (b Buf) Write(data []u8) !i64 {
	return len(data)
}

var g dyn io.Writer = Buf{n: 1}

func main() {
	let b = Buf{n: 2}
	g = b
}
