package main

import "say"

type P struct {
	X i64
	N str
}

func main() {
	m := map[str]str{"a": "x"}
	s := m["nope"]
	say.Line(len(s), s == "")
	ps := map[i64]P{}
	p := ps[3]
	say.Line(p.X, len(p.N))
	ls := map[str][]i64{}
	l := ls["q"]
	say.Line(len(l))
	l = append(l, 1)
	say.Line(l)
	v, ok := m["nope"]
	say.Line(len(v), ok)
	init_check()
}

type Box struct {
	name  str
	items []i64
	tags  map[str]i64
	inner P
}

func mk(fail_it bool) !Box {
	if fail_it {
		fail "asked to fail"
	}
	return Box{name: "ok", items: []i64{1}, tags: make(map[str]i64), inner: P{N: "in"}}
}

func wrap(fail_it bool) !Box {
	b := try mk(fail_it)
	return b
}

func init_check() {
	b, err := wrap(true)
	say.Line("try zero", err, len(b.name), len(b.items), len(b.tags), b.inner.X, len(b.inner.N))
	b2, err2 := wrap(false)
	say.Line("try ok", err2 == nil, b2.name, b2.items, b2.inner.N)
}
