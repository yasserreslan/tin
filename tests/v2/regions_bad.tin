package main

import "say"

type Box struct {
	Items []str
}

var names []str
var cache map[str]i64 = make(map[str]i64)
var last str
var box Box = Box{}

func bad1(q str) {
	names = append(names, q)
}

func bad2(q str) {
	cache[q] = 1
}

func bad3(q str) {
	last = q
}

func put(b mut Box, s str) {
	b.Items = append(b.Items, s)
}

func bad4(q str) {
	put(mut box, q)
}

func bad5(b Box) {
	b.Items = append(b.Items, "x")
}

func main() {
	q := say.Fmt("%d", 1)
	bad1(q)
	bad2(q)
	bad3(q)
	bad4(q)
	bad5(Box{})
	b := Box{}
	put(mut b, q)
	say.Line(len(names))
}
