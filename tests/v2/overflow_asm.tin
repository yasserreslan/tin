package main

import "say"

// add is checked: adds then a branch on overflow to the function's cold stub.
fn add(a i64, b i64) i64 {
	return a + b
}

// wadd wraps: a plain add.
fn wadd(a i64, b i64) i64 {
	return a +% b
}

// umul is checked through the high half of the product.
fn umul(a u64, b u64) u64 {
	return a * b
}

// count's loop counter stays below n, so its increment is not checked.
fn count(xs []i64) i64 {
	mut s = 0
	for i in 0..len(xs) {
		s ^= xs[i]
	}
	return s
}

fn main() {
	say.Line(add(1, 2), wadd(3, 4), umul(5, 6), count([]i64{1, 2, 3}))
}
