package main

// Shapes (#141, compiler step 2: the grammar). Every declaration form parses, and the
// words `shape` and `dyn` stay usable as ordinary names.

import "say"

// A method set: a name, parameters with their mut marks, and results. !T is the fault.
shape Reader {
	Read(buf mut []u8) !i64
}

// Composition: ReadWriter lists Reader and Writer and adds a method of its own.
shape Writer { Write(data []u8) !i64 }

shape ReadWriter {
	Reader
	Writer
	Flush() !i64
}

// A named union, the same grammar as a generic type parameter's constraint.
shape Ordered = i64 | i32 | f64 | str

// A shape may take type parameters, constrained like a generic type's.
shape Seq[T any] {
	Next() ?T
	Close() !i64
}

// Members may be written on one line, and a method may be variadic.
shape OneLiner { Ping() }

shape Odd {
	Sum(xs ...i64) i64
	Take(v mut []u8)
}

// Contextual words: types of their own named `shape` and `dyn` still resolve.
type shape = str

type dyn = i64

func main() {
	// `shape` and `dyn` are contextual: they are keywords only where the grammar wants them.
	shape := 40
	dyn := shape + 2
	say.Line(dyn)
	var a dyn = 1
	var b shape = "ok"
	say.Line(a)
	say.Line(b)
}
