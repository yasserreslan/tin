// NaN and the infinities print as Go prints them for every float verb and flag: NaN, +Inf, -Inf, never
// zero-padded, +NaN under %+g but not %+v. The expected output is what Go's fmt prints for the same calls.
package main

import "say"
import "gauge"

func main() {
	inf, ninf, nan := gauge.Inf(1), gauge.Inf(-1), gauge.NaN()
	for _, x := range []f64{nan, inf, ninf} {
		say.Line(say.Fmt("%e|%f|%g|%E|%G|%.3f|%.2e|%.12g", x, x, x, x, x, x, x, x))
		say.Line(say.Fmt("%8.2f|%-8.2f|%08.2f|%+g|%+f|%+.1e| %g", x, x, x, x, x, x, x))
		say.Line(say.Fmt("%v|%6v|%-7v|%+v|%08v", x, x, x, x, x))
	}
}
