	for _, s := range []str{"", "abc", "a b", "a+b", "a%b", "a/b", "a?b", "a&b=c", "a;b", "a,b", "a:b@c", "a~b_c-d.e", "a!b'c(d)e*f", "aéb", "世界", "a\x00b", "%41", "%zz", "%4", "%", "a%2", "%2g", "a+b%20c", "a%2Bb", "%e4%b8%96", "100%", "~", "$&+,/:;=?@", "[]<>\"{{}}|\\^`", "\t\n"} {
		say.Line("escape", q(s), q(link.QueryEscape(s)), q(link.PathEscape(s)))
