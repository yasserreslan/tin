package main

import "say"
import "link"

func q(s str) str {
	return say.Fmt("%q", s)
}

func b(v bool) str {
	if v {
		return "true"
	}
	return "false"
}

func parseWith(raw str, req bool) !link.URL {
	if req {
		return try link.ParseRequestURI(raw)
	}
	return try link.Parse(raw)
}

func show(label str, raw str, req bool) {
	u := parseWith(raw, req) catch e {
		say.Line(label, q(raw), "ERR", say.Str(e))
		return
	}
	pw, has := u.Password()
	say.Line(label, q(raw), q(u.String()), q(u.Scheme), q(u.Opaque), q(u.Username()), q(pw), b(has), q(u.Host), q(u.Hostname()), q(u.Port()),
		q(u.Path), q(u.RawPath), q(u.EscapedPath()), q(u.RawQuery), b(u.ForceQuery), q(u.Fragment), q(u.RawFragment), q(u.EscapedFragment()),
		b(u.OmitHost), q(u.RequestURI()), b(u.IsAbs()), q(u.Redacted()), q(u.Query().Encode()))
}

func resolve(base str, ref str) {
	bu := link.Parse(base) catch e {
		say.Line("resolve", q(base), q(ref), "BASEERR", say.Str(e))
		return
	}
	ru := link.Parse(ref) catch e {
		say.Line("resolve", q(base), q(ref), "REFERR", say.Str(e))
		return
	}
	r := bu.ResolveReference(ru)
	say.Line("resolve", q(base), q(ref), q(r.String()))
	p := bu.Parse(ref) catch e {
		say.Line("resolve-parse", q(base), q(ref), "ERR", say.Str(e))
		return
	}
	say.Line("resolve-parse", q(base), q(ref), q(p.String()))
}

func query(raw str) {
	v := link.ParseQuery(raw) catch e {
		say.Line("query", q(raw), "ERR", say.Str(e), q(lenient(raw)))
		return
	}
	say.Line("query", q(raw), q(v.Encode()), v.Len(), q(v.Get("a")), b(v.Has("a")), len(v.All("a")))
}

func lenient(raw str) str {
	u := link.Parse("?" + raw) catch _ {
		return "?"
	}
	return u.Query().Encode()
}

func join(base str, elems []str, label str) {
	r := link.JoinPath(base, elems) catch e {
		say.Line("join", base, label, "ERR", say.Str(e))
		return
	}
	say.Line("join", base, label, q(r))
}

