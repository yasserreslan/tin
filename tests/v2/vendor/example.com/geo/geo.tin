// Package geo is a vendored dependency of tests/v2/pkgpath.tin, imported by its path.
package geo

import "example.com/units"

// Area is the area of a w by h rectangle in square centimetres.
func Area(w i64, h i64) i64 {
	return units.Cm(w) * units.Cm(h)
}

// Name is the package's own name.
func Name() str {
	return "geo"
}
