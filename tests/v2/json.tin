package main

import "say"
import "argo"

type Point struct {
	X i64
	Y i64
}

type Item struct {
	name  str
	price f64
	qty   u32
	tags  []str
	at    ?Point
	ok    bool
	note  str
}

func main() {
	b := make([]u8, 0, 16)
	argo.Put(mut b, Point{X: 1, Y: -2})
	say.Line(str(b))
	b = make([]u8, 0)
	it := Item{name: "tin \"can\"", price: 2.5, qty: 7, tags: []str{"a", "b\n"}, at: Point{X: 3, Y: 4}, ok: true, note: "é\x01"}
	argo.Put(mut b, []Item{it, Item{name: "x", tags: []str{}}})
	say.Line(str(b))
	m := make(map[str]i64)
	m["k"] = 9
	b = make([]u8, 0)
	argo.Put(mut b, m)
	argo.Put(mut b, -9223372036854775807-1)
	argo.Put(mut b, "s")
	say.Line(str(b))
}
