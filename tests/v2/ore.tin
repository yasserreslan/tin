package main

import "say"
import "ore"

func bs(s str) []u8 {
	return []u8(s)
}

func main() {
	a := bs("hello world")
	say.Line("equal", ore.Equal(a, bs("hello world")), ore.Equal(a, bs("hello")), ore.Equal(bs(""), bs("")))
	say.Line("compare", ore.Compare(bs("a"), bs("b")), ore.Compare(bs("b"), bs("a")), ore.Compare(bs("ab"), bs("a")), ore.Compare(bs(""), bs("")))
	say.Line("indexbyte", ore.IndexByte(a, 'o'), ore.IndexByte(a, 'z'), ore.LastIndexByte(a, 'o'), ore.IndexByte(bs(""), 'a'))
	say.Line("index", ore.Index(a, bs("world")), ore.Index(a, bs("wq")), ore.Index(a, bs("")), ore.Index(bs("aaab"), bs("aab")), ore.Contains(a, bs("lo w")))
	say.Line("prefix", ore.HasPrefix(a, bs("hell")), ore.HasPrefix(a, bs("world")), ore.HasSuffix(a, bs("world")), ore.HasSuffix(bs("a"), bs("ab")))
	c := ore.Clone(a)
	c[0] = 'J'
	say.Line("clone", str(a), str(c))
	b := make([]u8, 0, 2)
	b = ore.AppendStr(mut b, "n=")
	b = ore.AppendInt(mut b, -1234)
	b = ore.AppendByte(mut b, ' ')
	b = ore.AppendUint(mut b, 18446744073709551615)
	b = ore.AppendByte(mut b, ' ')
	b = ore.AppendHex(mut b, 48879)
	say.Line("append", str(b), len(b))
	ore.Truncate(mut b, 2)
	say.Line("truncate", str(b))
	ore.Reset(mut b)
	say.Line("reset", len(b), cap(b) > 0)
	say.Line("trim", say.Fmt("%q", str(ore.TrimSpace(bs("  \t hi there \n")))), say.Fmt("%q", str(ore.TrimSpace(bs("   ")))))
	say.Line("split", ore.Split(bs("a,b,,c"), ','), len(ore.Split(bs(""), ',')))
	say.Line("fields", ore.Fields(bs("  one two\tthree\n ")), len(ore.Fields(bs(" "))))
	say.Line("case", str(ore.ToLower(bs("MiXeD 123"))), str(ore.ToUpper(bs("MiXeD 123"))))
	say.Line("repeat", str(ore.Repeat(bs("ab"), 3)), len(ore.Repeat(bs("x"), 0)))
}
