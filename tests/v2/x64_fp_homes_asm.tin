package main

func checkpoint(x i64) i64 {
	if x < 0 {
		return 0
	}
	return x + 1
}

func work(n i64) f64 {
	a := 1.0
	b := 2.0
	c := 3.0
	d := 4.0
	e := 5.0
	f := 6.0
	scale := 0.001
	for i := 0; i < n; i++ {
		a = a + b*scale
		b = b + c*scale
		c = c + d*scale
		d = d + e*scale
		e = e + f*scale
		f = f + a*scale
	}
	a = a + f64(checkpoint(n))*0.000000000000001
	return a + b + c + d + e + f
}

func main() {
	_ = work(1000)
}
