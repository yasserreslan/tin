package main

// Static dispatch (roadmap #141, sub-item 2): the call through a shape-constrained type
// parameter must be a direct call on the concrete method. The assembly check lives in
// tests/v2/shapes_dispatch_asm.check; this program is its input.
//
// A dynamic dispatch would load the method from a table and call it indirectly
// (blr x16 on arm64, call rax on amd64), so the direct call below could not appear at
// all. That is what the check asserts, and why CHECK-NOT is enough to catch a table.

shape Reader { Read(buf mut []u8) !i64 }

type Buf struct { data []u8 }

func (b Buf) Read(buf mut []u8) !i64 {
	return len(b.data)
}

func Drain[R Reader](r R) !i64 {
	let buf = make([]u8, 8)
	return try r.Read(mut buf)
}

func main() {
	let b = Buf{data: []u8{1, 2, 3}}
	n := Drain(b) catch _ { 0 }
	println(n)
}
