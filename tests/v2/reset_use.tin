package main

import "hearth"
import "say"

// Uses around hearth.Reset() that are safe (#179): a value created after the reset, a kept
// one, a number, and a loop whose locals are new each iteration.

var kept str = ""

func mk(n i64) str {
	return "fresh-{n}"
}

func main() {
	total := 0
	for i := 0; i < 3; i++ {
		s := mk(i)
		total += len(s)
		hearth.Reset()
	}
	k := keep(mk(7))
	hearth.Reset()
	t := mk(8)
	hearth.Reset()
	t = mk(9)
	kept = keep(t)
	hearth.Reset()
	say.Line("total", total, "kept", k, "again", kept)
}
