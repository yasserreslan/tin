package main

// #99: ?str, ?[]T and ?map[K]V are optionals like ?Struct: nil, narrowing, printing, keep, and
// JSON null in both directions.

import "argo"
import "say"

type User struct {
	Name  str
	Nick  ?str
	Tags  ?[]str
	Meta  ?map[str]i64
}

func find(ok bool) ?str {
	if ok {
		return "x"
	}
	return nil
}

var kept ?str = nil

func main() {
	a := find(true)
	b := find(false)
	say.Line(a, b)
	if a != nil {
		say.Line("len", len(a), a + "!")
	}
	if b == nil {
		say.Line("b is nil")
	}
	var xs ?[]i64 = nil
	say.Line("xs", xs)
	xs = []i64{1, 2}
	if xs != nil {
		xs = append(xs, 3)
		say.Line("xs", xs, len(xs))
	}
	var m ?map[str]i64 = nil
	m = make(map[str]i64)
	if m != nil {
		m["k"] = 1
		say.Line("m", m["k"])
	}
	kept = keep(find(true))
	say.Line("kept", kept)
	u := User{Name: "a", Nick: nil, Tags: nil, Meta: nil}
	buf := make([]u8, 0, 64)
	argo.Put(mut buf, u)
	say.Line(str(buf))
	var v User = User{Name: "", Nick: nil, Tags: nil, Meta: nil}
	err := argo.Get(`{"Name":"z","Nick":null,"Tags":["t1"],"Meta":{"q":2}}`, mut v)
	say.Line("get", err, v.Name, v.Nick, v.Tags, v.Meta)
	err = argo.Get(`{"Name":"y","Nick":"nn","Tags":null,"Meta":null}`, mut v)
	say.Line("get", err, v.Name, v.Nick, v.Tags, v.Meta)
	buf2 := make([]u8, 0, 64)
	argo.Put(mut buf2, v)
	say.Line(str(buf2))
}
