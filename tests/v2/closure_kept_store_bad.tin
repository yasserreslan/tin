package main

import "say"

// A closure that may be kept must not store request memory in its captured variables:
// keep() copies them into long-lived memory (#171).
func recorder() func(str) str {
	last := "nobody"
	return func(s str) str {
		prev := last
		last = s
		return prev
	}
}

var rec func(str) str = keep(recorder())

func main() {
	say.Line(rec(say.Fmt("session-%d", 42)))
}
