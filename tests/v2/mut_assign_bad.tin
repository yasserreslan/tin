package main

import "say"

type Box struct {
	name str
}

// Assigning a mut struct, optional or map parameter itself would be lost in the caller (#180).
func clear(x mut ?Box) { x = nil }
func reset(b mut Box) { b = Box{name: "new"} }
func remake(m mut map[str]i64) { m = make(map[str]i64) }
func (b mut Box) Replace() { b = Box{name: "r"} }

// Still allowed: fields, elements, and the append idiom on a mut slice.
func rename(b mut Box) { b.name = "renamed" }
func grow(xs mut []i64) { xs = append(xs, 1) }
func fill(m mut map[str]i64) { m["k"] = 1 }

func main() {
	var o ?Box = Box{name: "x"}
	clear(mut o)
	b := Box{name: "b"}
	reset(mut b)
	rename(mut b)
	m := make(map[str]i64)
	remake(mut m)
	fill(mut m)
	xs := []i64{}
	grow(mut xs)
	b.Replace()
	say.Line(b.name, len(m), len(xs))
}
