package main

import "hearth"
import "say"

// Globals are per core. In a program that starts cores, main may assign a global only its own
// code reads; what the cores read comes from their initializers, on core.start or once (#343).
mut onlyMain i64
mut table []str = make([]str, 0, 4)
mut perCore i64
mut started i64
mut seen i64

fn describe() str {
	return say.Fmt("%d", onlyMain)
}

on core.start {
	table = keep(append(make([]str, 0, 4), "a", "b", "c"))
	started = 1
}

fn work(id i64) {
	once {
		seen = 100 + id
	}
	perCore = len(table) + started + seen
	say.Line(id, perCore)
}

fn main() {
	onlyMain = 41
	onlyMain += 1
	say.Line("main", describe())
	hearth.Run(1, work)
}
