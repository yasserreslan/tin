package main

import "say"

func show(q query) {
	say.Line(len(q.Parts), len(q.Args), q.Parts)
	for _, a := range q.Args {
		switch a {
		case Int(v):
			say.Line("int", v)
		case Str(v):
			say.Line("str", v)
		case Float(v):
			say.Line("float", v)
		case Bool(v):
			say.Line("bool", v)
		case Bytes(v):
			say.Line("bytes", len(v))
		}
	}
}

func main() {
	id := 42
	var small u8 = 7
	bs := []u8{1, 2}
	name := "o'brien; DROP"
	show("PING")
	show("SET user:{id} {name}")
	show("{small}{1.5}{true}{bs}{f32(2.5)}")
	var q query = "GET k{id}"
	show(q)
}
