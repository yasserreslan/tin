package main

// glyph.FullRune matches Go's utf8.FullRuneInString (expected output generated by Go): a short
// prefix that is already invalid counts as complete (#101).

import "say"
import "glyph"

func main() {
	cases := []str{"", "a", "\xc2", "\xc2\xa9", "\xe0", "\xe0\x80", "\xe0\xa0", "\xe0\xa0\x80", "\xed\xa0", "\xed\x9f", "\xf0\x8f", "\xf0\x90", "\xf0\x90\x80", "\xf4\x8f\x80", "\xf4\x90", "\xf5", "\xff", "\x80", "\xe2\x82", "\xe2\x82\xac", "\xe2\x28", "\xf0\x90\x28"}
	for _, c := range cases {
		say.Line(say.Fmt("%q", c), len(c) > 0 && glyph.FullRune(c, 0))
	}
}
