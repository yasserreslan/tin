package main

import "say"
import "atlas"
import "sift"

// The functions on maps, checked against Go's maps package (bench/ref/atlas prints the same lines).
// Printing a map sorts its keys, as Go does, so the lines do not depend on insertion order; Keys and
// Values are sorted before printing for the same reason.

type Pt struct {
	x i64
	y i64
}

func eqNumStr(a i64, b str) bool {
	return str(a+48) == b
}

func bigOrZ(k str, v i64) bool {
	return v > 50 || k == "z"
}

func odd(k i64, v bool) bool {
	return k%2 == 1
}

func main() {
	m := map[str]i64{"b": 2, "a": 1, "c": 3}
	keys := atlas.Keys(m)
	sift.Sort(mut keys)
	vals := atlas.Values(m)
	sift.Sort(mut vals)
	say.Line("keys", keys, vals, atlas.SortedKeys(m), len(atlas.Keys(m)))

	c := atlas.Clone(m)
	c["d"] = 4
	say.Line("clone", m, c, len(m), len(c))
	atlas.Copy(mut c, map[str]i64{"a": 100, "z": 26})
	say.Line("copy", c)

	say.Line("equal", atlas.Equal(m, atlas.Clone(m)), atlas.Equal(m, c), atlas.Equal(map[str]i64{}, map[str]i64{}),
		atlas.Equal(map[str]i64{"a": 0}, map[str]i64{"b": 0}), atlas.Equal(map[str]i64{"a": 0}, map[str]i64{"a": 0}),
		atlas.Equal(map[str]i64{"a": 1, "b": 2}, map[str]i64{"b": 2, "a": 1}))
	say.Line("equalfunc", atlas.EqualFunc(m, map[str]str{"a": "1", "b": "2", "c": "3"}, eqNumStr),
		atlas.EqualFunc(m, map[str]str{"a": "1", "b": "2", "c": "9"}, eqNumStr),
		atlas.EqualFunc(m, map[str]str{"a": "1", "b": "2", "x": "3"}, eqNumStr))

	atlas.DeleteFunc(mut c, bigOrZ)
	say.Line("deletefunc", c, len(c))
	atlas.DeleteFunc(mut c, bigOrZ)
	say.Line("deletefunc again", c)

	flags := map[i64]bool{1: true, 2: false, 3: true, 4: true, 5: false}
	atlas.DeleteFunc(mut flags, odd)
	say.Line("int keys", flags, atlas.SortedKeys(flags))

	pts := map[Pt]str{Pt{x: 1, y: 2}: "a", Pt{x: 3, y: 4}: "b"}
	cp := atlas.Clone(pts)
	cp[Pt{x: 5, y: 6}] = "c"
	say.Line("struct keys", len(pts), len(cp), atlas.Equal(pts, cp), atlas.Equal(pts, atlas.Clone(pts)))

	floats := map[f64]i64{2.5: 1, -1: 2, 0: 3}
	say.Line("float keys", atlas.SortedKeys(floats), len(floats), floats[2.5], len(atlas.Clone(floats)))
	empty := map[str]i64{}
	say.Line("empty", atlas.Keys(empty), atlas.Values(empty), atlas.SortedKeys(empty), atlas.Clone(empty), len(atlas.Clone(empty)))
}
