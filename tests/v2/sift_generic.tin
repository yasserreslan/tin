package main

import "say"
import "gauge"
import "sift"

// The generic slice functions, checked against Go's slices and cmp (bench/ref/sift/generic.go prints
// the same lines). SortFunc is Go's pattern-defeating quicksort, so even the order of elements that
// compare equal must match Go's: that is what the id checksums below pin down.

type Item struct {
	key i64
	id  i64
}

func lcg(k i64) i64 {
	return k*6364136223846793005 + 1442695040888963407
}

// gen returns n values of one shape; seed varies the random ones.
func gen(shape str, n i64, seed i64) []i64 {
	xs := make([]i64, n)
	k := seed
	for i := 0; i < n; i++ {
		k = lcg(k)
		if shape == "random" {
			xs[i] = k
		} else if shape == "dups" {
			xs[i] = (k >> 33) % 10
		} else if shape == "sorted" {
			xs[i] = i
		} else if shape == "reversed" {
			xs[i] = n - i
		} else if shape == "sawtooth" {
			xs[i] = i % 17
		} else if shape == "equal" {
			xs[i] = 7
		} else {
			// organ pipe: up, then down
			if i < n/2 {
				xs[i] = i
			} else {
				xs[i] = n - i
			}
		}
	}
	return xs
}

func fold(xs []i64) i64 {
	h := i64(0)
	for _, v := range xs {
		h = h*1000003 + v
	}
	return h
}

func items(xs []i64) []Item {
	out := make([]Item, 0, len(xs))
	for i, k := range xs {
		out = append(out, Item{key: k, id: i})
	}
	return out
}

func ids(xs []Item) []i64 {
	out := make([]i64, 0, len(xs))
	for _, it := range xs {
		out = append(out, it.id)
	}
	return out
}

func byKey(a Item, b Item) i64 {
	return sift.Cmp(a.key, b.key)
}

func byKeyDesc(a Item, b Item) i64 {
	return sift.Cmp(b.key, a.key)
}

func cmpInt(a i64, b i64) i64 {
	return sift.Cmp(a, b)
}

func cmpIntStr(a i64, b str) i64 {
	return sift.Cmp(str(a+48), b)
}

func isEven(x i64) bool {
	return x%2 == 0
}

func eqMod3(a i64, b i64) bool {
	return a%3 == b%3
}

func eqIntItem(a i64, b Item) bool {
	return a == b.key
}

func main() {
	// Sort, SortFunc and SortStableFunc over every shape and a spread of sizes.
	shapes := []str{"random", "dups", "sorted", "reversed", "sawtooth", "equal", "pipe"}
	sizes := []i64{0, 1, 2, 3, 7, 12, 13, 20, 49, 50, 51, 64, 100, 257, 1000, 5000, 20000}
	for _, shape := range shapes {
		for _, n := range sizes {
			xs := gen(shape, n, n*31+7)
			a := sift.Clone(xs)
			sift.Sort(mut a)
			b := items(xs)
			sift.SortFunc(mut b, byKey)
			c := items(xs)
			sift.SortStableFunc(mut c, byKey)
			d := items(xs)
			sift.SortFunc(mut d, byKeyDesc)
			say.Line("sort", shape, n, fold(a), sift.IsSorted(a), fold(ids(b)), fold(ids(c)), fold(ids(d)), sift.IsSortedFunc(b, byKey))
		}
	}

	// Strings, and floats with NaN, infinities and -0.
	words := make([]str, 0, 40)
	k := i64(5)
	for i := 0; i < 40; i++ {
		k = lcg(k)
		words = append(words, "w{(k>>40)%97}")
	}
	sift.Sort(mut words)
	say.Line("strings", words, sift.IsSorted(words))
	nan := gauge.NaN()
	fs := []f64{3.5, nan, -1, 1e-300, -7.25, 2, 1e300, -1e300, 0.1, 0.2, nan, gauge.Inf(1), gauge.Inf(-1)}
	sift.Sort(mut fs)
	say.Line("floats", fs)
	say.Line("cmp", sift.Cmp(1, 2), sift.Cmp(2, 1), sift.Cmp(3, 3), sift.Cmp(nan, 1.0), sift.Cmp(1.0, nan), sift.Cmp(nan, nan), sift.Less(nan, 1.0), sift.Less(1.0, nan), sift.Less(nan, nan), sift.Cmp("a", "b"))

	// Searching.
	sorted := []i64{1, 3, 3, 5, 8, 8, 8, 13, 21}
	for _, t := range []i64{0, 1, 3, 4, 8, 9, 21, 22} {
		i, found := sift.BinarySearch(sorted, t)
		j, found2 := sift.BinarySearchFunc(sorted, str(t+48), cmpIntStr)
		say.Line("search", t, i, found, j, found2)
	}
	empty := []i64{}
	ie, fe := sift.BinarySearch(empty, 4)
	say.Line("search empty", ie, fe)
	say.Line("minmax", sift.Min(sorted), sift.Max(sorted), sift.Min([]str{"pear", "apple", "fig"}), sift.Max([]str{"pear", "apple", "fig"}), sift.Min([]f64{2.5, -1, 9}), sift.Max([]f64{2.5, -1, 9}))
	say.Line("minmaxfunc", sift.MinFunc(items([]i64{5, 2, 9, 2}), byKey), sift.MaxFunc(items([]i64{5, 9, 2, 9}), byKey))
	say.Line("index", sift.Index(sorted, 8), sift.Index(sorted, 7), sift.Contains(sorted, 13), sift.Contains(sorted, 14), sift.IndexFunc(sorted, isEven), sift.ContainsFunc(sorted, isEven), sift.Index([]str{"a", "b"}, "b"))

	// Comparing.
	say.Line("equal", sift.Equal([]i64{1, 2}, []i64{1, 2}), sift.Equal([]i64{1, 2}, []i64{1, 3}), sift.Equal([]i64{1}, []i64{1, 2}), sift.Equal([]str{}, []str{}))
	say.Line("equalfunc", sift.EqualFunc([]i64{1, 4, 7}, []i64{10, 1, 4}, eqMod3), sift.EqualFunc([]i64{1, 2}, items([]i64{1, 2}), eqIntItem), sift.EqualFunc([]i64{1, 2}, items([]i64{1, 3}), eqIntItem))
	say.Line("compare", sift.Compare([]i64{1, 2, 3}, []i64{1, 2, 4}), sift.Compare([]i64{1, 2, 3}, []i64{1, 2}), sift.Compare([]i64{1, 2}, []i64{1, 2, 3}), sift.Compare([]i64{}, []i64{}), sift.Compare([]f64{nan}, []f64{1}), sift.CompareFunc([]i64{1, 2}, []i64{1, 3}, cmpInt))

	// Changing a slice. Each result is printed, never the argument afterwards.
	base := []i64{10, 20, 30, 40, 50}
	r := sift.Clone(base)
	sift.Reverse(mut r)
	say.Line("reverse", r, base)
	say.Line("insert", sift.Insert(mut sift.Clone(base), 0, 1), sift.Insert(mut sift.Clone(base), 2, 99), sift.Insert(mut sift.Clone(base), 5, 77))
	say.Line("insertall", sift.InsertAll(mut sift.Clone(base), 0, []i64{1, 2}), sift.InsertAll(mut sift.Clone(base), 3, []i64{7, 8, 9}), sift.InsertAll(mut sift.Clone(base), 5, []i64{6}), sift.InsertAll(mut sift.Clone(base), 2, []i64{}))
	say.Line("delete", sift.Delete(mut sift.Clone(base), 0, 2), sift.Delete(mut sift.Clone(base), 1, 4), sift.Delete(mut sift.Clone(base), 4, 5), sift.Delete(mut sift.Clone(base), 2, 2), sift.Delete(mut sift.Clone(base), 0, 5))
	say.Line("deletefunc", sift.DeleteFunc(mut sift.Clone([]i64{1, 2, 3, 4, 5, 6}), isEven), sift.DeleteFunc(mut sift.Clone([]i64{1, 3, 5}), isEven), sift.DeleteFunc(mut sift.Clone([]i64{2, 4}), isEven))
	say.Line("replace", sift.Replace(mut sift.Clone(base), 1, 3, []i64{0}), sift.Replace(mut sift.Clone(base), 1, 3, []i64{7, 8, 9, 6}), sift.Replace(mut sift.Clone(base), 0, 5, []i64{}), sift.Replace(mut sift.Clone(base), 2, 2, []i64{1, 1}), sift.Replace(mut sift.Clone(base), 4, 5, []i64{3, 3}))
	say.Line("compact", sift.Compact(mut sift.Clone([]i64{1, 1, 2, 2, 2, 3, 1, 1})), sift.Compact(mut sift.Clone([]i64{})), sift.Compact(mut sift.Clone([]i64{5})), sift.Compact(mut sift.Clone([]i64{4, 4, 4})), sift.Compact(mut sift.Clone([]str{"a", "a", "b"})))
	say.Line("compactfunc", sift.CompactFunc(mut sift.Clone([]i64{1, 4, 7, 2, 5, 3}), eqMod3))
	say.Line("clone", sift.Clone(base), len(sift.Clone([]i64{})))
	say.Line("concat", sift.Concat(base, []i64{1}), sift.Concat([]i64{}, base), sift.ConcatAll([][]i64{{1, 2}, {}, {3}, {4, 5}}))
	say.Line("repeat", sift.Repeat([]i64{1, 2}, 3), sift.Repeat([]i64{1, 2}, 0), sift.Repeat([]str{"x"}, 4))
	say.Line("grow", sift.Grow(base, 100), len(sift.Grow(base, 100)))
}
