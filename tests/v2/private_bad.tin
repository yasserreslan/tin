package main

import "flume"
import "mint"
import "say"
import "wire"

func main() {
	w := flume.Stdout()
	say.Line(w.fd)
	n := mint.parseInt("Atoi", "1", 10) catch _ { 0 }
	say.Line(n, mint.MaxI64)
	r := wire.Resp{Status: 200, Body: "", head: ""}
	say.Line(r.Status)
	c := wire.Conn{}
	say.Line(c.open)
	b := flume.bufSize
	say.Line(b)
}
