package main

import "say"
import "flume"

func write_file(path str, content str) ! {
	w := try flume.Create(path)
	w.Str(content)
	return try w.Close()
}

func main() {
	path := "/tmp/tin-test-flume_test.txt"
	long := say.Fmt("%0100000d", 42)
	err := write_file(path, "alpha\nbeta\r\n\ngamma\n" + long + "\nlast line no newline")
	say.Line("write", err == nil)
	r, e1 := flume.Open(path)
	say.Line("open", e1 == nil)
	n := 0
	for {
		line, ok, e2 := r.Line()
		if e2 != nil {
			say.Line("error", e2)
			break
		}
		if !ok {
			break
		}
		if len(line) > 50 {
			say.Line(n, "long", len(line), line[len(line)-2:])
		} else {
			say.Line(n, say.Fmt("%q", line))
		}
		n++
	}
	r.Close()
	all, e3 := flume.ReadFile(path)
	say.Line("readall", len(all), e3 == nil, all[:5])
	r2, _ := flume.Open(path)
	c1, ok1 := r2.Byte()
	c2, ok2 := r2.Byte()
	rest, _ := r2.ReadAll()
	say.Line("bytes", str(c1), ok1, str(c2), ok2, len(rest))
	_, ok3 := r2.Byte()
	say.Line("eof byte", ok3)
	r2.Close()
	_, e4 := flume.Open("/tmp/tin-test-no/such/file")
	say.Line("missing", e4)
	empty := "/tmp/tin-test-flume_empty.txt"
	ee := write_file(empty, "")
	r3, _ := flume.Open(empty)
	_, ok4, _ := r3.Line()
	say.Line("empty", ee == nil, ok4)
	r3.Close()
	w := flume.Stdout()
	w.Str("stdout ")
	w.Int(-77)
	w.Line("!")
	say.Line("flush", w.Flush() == nil)
}
