package main

import "say"
import "sift"

// checked counts with a checked +: the condition is added as 0 or 1, still without a branch.
fn checked(n i64) i64 {
	mut hits = 0
	for i in 0..n {
		if sift.Less(i, n-i) {
			hits += 1
		}
	}
	return hits
}

// wrapping counts with +%: the plain conditional increment (#362).
fn wrapping(n i64) i64 {
	mut hits = 0
	for i in 0..n {
		if sift.Less(i, n-i) {
			hits +%= 1
		}
	}
	return hits
}

fn main() {
	say.Line(checked(1000), wrapping(1000))
}
