# A rotation written as two shifts is one instruction (#488): ror by 64-c on arm64, rol by c on
# x86-64. rot is inlined into main, so the check reads the whole listing.

[arm64]
CHECK: \tror x\d+, x\d+, #51\n
CHECK-NOT: \tlsl x\d+, x\d+, #13\n\t[^\n]*\n?\tlsr x\d+, x\d+, #51

[amd64]
CHECK: \nrol r\w+,0xd\n
