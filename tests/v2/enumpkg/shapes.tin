// Package enumpkg holds an enum used from another package by tests/v2/enums_pkg.tin.
package enumpkg

// Token is a lexer token.
type Token enum {
	Num(v i64)
	Word(text str)
	End
}

// Lex splits s on spaces into tokens.
func Lex(s str) []Token {
	out := []Token{}
	start := 0
	for i := 0; i <= len(s); i++ {
		if i == len(s) || s[i] == ' ' {
			if i > start {
				out = append(out, classify(s[start:i]))
			}
			start = i + 1
		}
	}
	return append(out, Token.End)
}

func classify(w str) Token {
	n := 0
	for i := 0; i < len(w); i++ {
		if w[i] < '0' || w[i] > '9' {
			return Token.Word(w)
		}
		n = n*10 + i64(w[i]-'0')
	}
	return Token.Num(n)
}
