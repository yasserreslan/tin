# The conditional increment stays branchless on both backends: a checked counter (#362) adds
# the condition as 0 or 1 with a flag-setting add (its only branch is the overflow check), and
# a wrapping counter (+%=) is the plain conditional increment.

[arm64]
CHECK: _checked:
CHECK: cset x16, lt
CHECK: adds x[0-9]+, x[0-9]+, x16
CHECK: b\.vs L[0-9]+
CHECK: _wrapping:
CHECK: cinc x[0-9]+, x[0-9]+, lt

[amd64]
CHECK: \nL1:
CHECK: setl r11b
CHECK-NOT: sub rsp,0x10
CHECK: add r[a-z0-9]+,r11\njo L[0-9]+
CHECK: \nL2:
CHECK: lea r11,\[r[0-9]+\+0x1\]
CHECK-NOT: sub rsp,0x10
CHECK: cmov[a-z]+ [a-z0-9]+,[a-z0-9]+
