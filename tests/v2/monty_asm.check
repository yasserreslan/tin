# Multi-word arithmetic (#488): `lo = a * b; hi = mulhi(a, b)` is one mul on x86-64 (mul and umulh
# from operands read once on arm64), and `lo += t; hi += lt(lo, t)` is an add whose carry adc
# takes (adds and cinc on arm64). The checks read seal.m4_mul, P-256's field multiplication.

[arm64]
CHECK: _seal\.m4_mul:\n(?:(?!\n_[\w.]+:\n)[\s\S])*?\tmul (x\d+), (x\d+), (x\d+)\n\tumulh (x\d+), \2, \3\n\tadds \1, \1, x\d+\n\tcinc \4, \4, hs\n

[amd64]
CHECK: # L(\d+): seal\.m4_mul\n[\s\S]*?\nL\1:\n(?:(?!\nret\n)[\s\S])*?\nmul (r\w+)\nmov (r\w+),rax\nmov (r\w+),rdx\nadd \3,[^\n]+\nadc \4,0x0\n
