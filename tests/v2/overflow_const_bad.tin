package main

// Constant arithmetic is exact (#362): these results do not fit, and the wrapping operators
// are for integers only.
const Big = 9223372036854775807 + 1
const Small u8 = 200

fn main() {
	let a i64 = Big
	let b = Small + 100
	let c = -9223372036854775807 - 2
	let d = 18446744073709551615 * 2
	let e = 1.5 +% 2.0
	_ = a
	_ = b
	_ = c
	_ = d
	_ = e
}
