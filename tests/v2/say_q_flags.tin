package main

// %q with width, -, 0, precision (runes), + (ASCII only) and # (backquoted when possible), as Go's
// fmt prints them; the expected output was generated by Go (#149).

import "say"

func main() {
	say.Out("%10q|%-10q|\n", "ab", "ok")
	say.Out("%+q|%#q|%#q|%#q\n", "héllo ☺", "back`tick", "tab\there", "plain")
	say.Out("%.2q|%8.3q|%-8.1q|\n", "héllo", "abcdef", "☺x")
	say.Out("%+10q|%#10q|%010q|\n", "é", "raw", "z")
	say.Out("%q|%+q|%#q\n", "a\nb\x00\xff", "\U0001F600", "\xff")
}
