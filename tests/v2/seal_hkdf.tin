package main

import "say"
import "seal"
import "twine"

func hx(s str) []u8 {
	b, err := seal.HexDecode(s)
	if err != nil {
		panic("bad hex")
	}
	return b
}

func hashName(h seal.Hash) str {
	switch h {
	case SHA256:
		return "sha256"
	case SHA384:
		return "sha384"
	case SHA512:
		return "sha512"
	}
	return ""
}

func long(from i64) str {
	b := make([]u8, 0, 80)
	for i := 0; i < 80; i++ {
		b = append(b, u8(from+i))
	}
	return seal.Hex(b)
}

func main() {
	hashes := []seal.Hash{seal.Hash.SHA256, seal.Hash.SHA384, seal.Hash.SHA512}
	ins := []str{"", "abc", "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu", twine.Repeat("a", 111), twine.Repeat("a", 112), twine.Repeat("a", 127), twine.Repeat("a", 128), twine.Repeat("a", 239), twine.Repeat("a", 240), twine.Repeat("\xff", 1000)}
	for _, s := range ins {
		say.Line("sha", len(s), seal.Hex(seal.Sha384(s)), seal.Hex(seal.Sha512(s)))
	}
	// RFC 4231 test cases 1, 2, 6 (a 131-byte key) and 7.
	keys := []str{twine.Repeat("0b", 20), seal.Hex([]u8("Jefe")), twine.Repeat("aa", 131), twine.Repeat("aa", 131)}
	msgs := []str{"Hi There", "what do ya want for nothing?", "Test Using Larger Than Block-Size Key - Hash Key First", "This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm."}
	for i := 0; i < len(keys); i++ {
		for _, h := range hashes {
			say.Line("hmac", i+1, hashName(h), seal.Hex(seal.Hmac(h, str(hx(keys[i])), msgs[i])))
		}
	}
	// RFC 5869 test cases 1-3, under every hash.
	ikms := []str{"0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b", long(0), "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b"}
	salts := []str{"000102030405060708090a0b0c", long(0x60), ""}
	infos := []str{"f0f1f2f3f4f5f6f7f8f9", long(0xb0), ""}
	sizes := []i64{42, 82, 42}
	for i := 0; i < 3; i++ {
		for _, h := range hashes {
			prk := seal.HkdfExtract(h, str(hx(salts[i])), str(hx(ikms[i])))
			okm := seal.HkdfExpand(h, str(prk), str(hx(infos[i])), sizes[i]) catch e {
				say.Line("fault", e)
				[]u8{}
			}
			say.Line("hkdf", i+1, hashName(h), seal.Hex(prk), seal.Hex(okm))
		}
	}
	for _, h := range hashes {
		sz := seal.Size(h)
		key := str(make([]u8, sz))
		_, err := seal.HkdfExpand(h, key, "", 255*sz+1)
		okm := seal.HkdfExpand(h, key, "", 255*sz) catch _ { []u8{} }
		say.Line("hkdf-limit", hashName(h), err != nil, len(okm))
	}
	// RFC 8448 section 3: the early secret and its "derived" secret, then the handshake traffic keys.
	zeros := str(make([]u8, 32))
	early := seal.HkdfExtract(seal.Hash.SHA256, zeros, zeros)
	empty := seal.Sha256("")
	derived := seal.HkdfExpandLabel(seal.Hash.SHA256, str(early), "derived", str(empty), 32) catch _ { []u8{} }
	say.Line("tls13", seal.Hex(early), seal.Hex(derived))
	shs := str(hx("b67b7d690cc16c4e75e54213cb2d37b4e9c912bcded9105d42befd59d391ad38"))
	key := seal.HkdfExpandLabel(seal.Hash.SHA256, shs, "key", "", 16) catch _ { []u8{} }
	iv := seal.HkdfExpandLabel(seal.Hash.SHA256, shs, "iv", "", 12) catch _ { []u8{} }
	say.Line("tls13 key", seal.Hex(key), seal.Hex(iv))
	for _, h := range hashes[1:] {
		sz := seal.Size(h)
		t := seal.HkdfExpandLabel(h, str(make([]u8, sz)), "c hs traffic", "ctx", sz) catch _ { []u8{} }
		say.Line("tls13", hashName(h), seal.Hex(t))
	}
}
