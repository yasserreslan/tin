package main

import "say"
import "tide"

func main() {
	say.Line("consts", tide.Nanosecond, tide.Microsecond, tide.Millisecond, tide.Second, tide.Minute, tide.Hour, tide.Sunday, tide.Saturday)
	t0 := tide.Now()
	w0 := tide.Wall()
	tide.Sleep(2 * tide.Millisecond)
	el := tide.Since(t0)
	say.Line("clock", t0 > 0, w0 > 1600000000*tide.Second, el >= 2*tide.Millisecond, el < 2*tide.Second, tide.Wall() >= w0, tide.Now() >= t0+el)
	tide.Sleep(0)
	tide.Sleep(-5)

	durs := []i64{0, 1, 999, 1000, 1001, 1500, 999999, 1000000, 1500000, 250000000, 999999999, tide.Second, 1500000000, 1000000001, 61 * tide.Second, 3661 * tide.Second, tide.Hour, 90 * tide.Minute, 100 * tide.Hour, 365 * 24 * tide.Hour, -1, -1500, -1500000, -1500000000, -3661 * tide.Second, 9223372036854775807, -9223372036854775807 - 1, 59999999999, 60000000000, 3599999999999, 123456789012345}
	for _, d := range durs {
		say.Line("fmtdur", d, tide.FormatDuration(d), say.Fmt("%.6f %.6f %.6f", tide.Seconds(d), tide.Minutes(d), tide.Hours(d)), tide.Milliseconds(d), tide.Microseconds(d))
	}

	pd := []str{"0", "+0", "-0", "1s", "1.5s", "250ms", "1h2m3s", "-1.5h", "+2m", "1us", "1µs", "1μs", "1ns", "1h1m1s1ms1us1ns", ".5s", "1.s", "0.0000001h", "100000h", "2562047h47m16.854775807s", "-2562047h47m16.854775808s", "1.000000001s", "0.1us", "1.9999999999999999999s", "1h0m0s", "00001s", "1.5m1.5s", "9223372036854775807ns", "-9223372036854775808ns", "0.5h0.5m", "1.5µs", "3.000000000000000000000001s",
		"", "x", "1", "1x", ".s", "-", "+", "-.", "1h-2m", "9223372036854775808ns", "2562047h47m16.854775808s", "1.5.5s", " 1s", "1 s", "1é", "1hs", "1s ", "3000000h", "9223372036854775808ms", "..5s", "1.2.3", "1S", "1Ms", "1\"s", "1\\s", "1\x01s", "-0x", "1e3s", "1,5s", "1.5 h"}
	for _, s := range pd {
		v, err := tide.ParseDuration(s)
		say.Line("parsedur", say.Fmt("%q", s), v, err)
	}

	stamps := []i64{0, -1, 1, 999999999, tide.Second, 86399 * tide.Second, 86400*tide.Second - 1, 86400 * tide.Second, -86400 * tide.Second, 951782400 * tide.Second, 951868799 * tide.Second, 1709164800 * tide.Second, 4107542400 * tide.Second, -2208988800 * tide.Second, -2208988800*tide.Second - 1, 1759317725 * tide.Second, 9223372036854775807, -9223372036854775807 - 1, 1234567890123456789, -1234567890123456789, 2147483647 * tide.Second, 4102444800*tide.Second - 1, 1759317725123000000, 1759317725000000100, -7857129600 * tide.Second}
	for _, ns := range stamps {
		c := tide.UTC(ns)
		say.Line("utc", ns, c.Year, c.Month, c.Day, c.Hour, c.Min, c.Sec, c.Nano, c.Weekday, c.YearDay, tide.Unix(c) == ns, tide.UnixSec(c), tide.FormatRFC3339(ns), tide.FormatRFC3339Nano(ns), tide.WeekdayName(c.Weekday), tide.MonthName(c.Month))
	}

	say.Line("date", tide.Date(2026, 10, 1, 11, 22, 5, 0), tide.Date(2026, 13, 1, 0, 0, 0, 0), tide.Date(2026, 0, 1, 0, 0, 0, 0), tide.Date(2026, -11, 1, 0, 0, 0, 0), tide.Date(2026, 1, 32, 0, 0, 0, 0), tide.Date(2026, 1, 0, 0, 0, 0, 0), tide.Date(2026, 2, 30, 25, 61, 61, 1500000000), tide.Date(2024, 2, 29, 0, 0, 0, 0), tide.Date(2023, 2, 29, 0, 0, 0, 0), tide.Date(1970, 1, 1, 0, 0, 0, -1), tide.Date(1969, 12, 31, 23, 59, 59, 999999999), tide.Date(2026, 25, -5, -1, -1, -1, -1), tide.Date(1677, 9, 21, 0, 12, 43, 145224192), tide.Date(2262, 4, 11, 23, 47, 16, 854775807))
	say.Line("unix civil", tide.Unix(tide.Civil{Year: 2026, Month: 10, Day: 1, Hour: 11, Min: 22, Sec: 5, Nano: 7, Weekday: 99, YearDay: 99}), tide.UnixSec(tide.Civil{Year: 1969, Month: 12, Day: 31, Hour: 23, Min: 59, Sec: 59, Nano: 1}), tide.UnixSec(tide.Civil{Year: 1970, Month: 1, Day: 1}))

	rfc := []str{"2026-10-01T11:22:05Z", "2026-10-01T11:22:05.5Z", "2026-10-01T11:22:05.123456789Z", "2026-10-01T11:22:05.1234567891234Z", "2026-10-01T11:22:05.000000001Z", "2026-10-01T11:22:05+02:00", "2026-10-01T11:22:05-07:30", "2026-10-01T11:22:05.25-00:00", "2026-10-01T5:22:05Z", "2026-10-01T11:22:05,5Z", "2024-02-29T00:00:00Z", "1700-01-01T00:00:00Z", "1969-12-31T23:59:59.999999999Z", "2262-04-11T23:47:16.854775807Z", "1677-09-21T00:12:43.145224192Z", "2026-10-01T11:22:05+24:00", "2026-10-01T11:22:05+02:60", "2026-10-01T23:59:59Z", "2026-12-31T23:59:59+23:59", "2026-10-01T11:22:05.5+02:00", "2026-10-01T11:22:05-24:00", "2026-10-01T11:22:05.1234567890123456789Z", "2026-10-01T0:00:00Z", "2026-10-01T11:22:05.000Z", "2026-10-01T11:22:05.100Z", "0001-01-01T00:00:00Z", "9999-12-31T23:59:59Z", "2262-04-11T23:47:16.854775808Z", "1677-09-21T00:12:43.145224191Z", "2262-04-12T00:00:00+01:00", "1677-09-21T00:12:43+00:01", "1677-09-21T00:00:00-01:00",
		"", "2026-10-01", "2026-10-01 11:22:05Z", "2026-10-01t11:22:05Z", "2026-10-01T11:22:05z", "2026-13-01T11:22:05Z", "2026-00-01T11:22:05Z", "2026-10-00T11:22:05Z", "2026-02-30T11:22:05Z", "2023-02-29T00:00:00Z", "2026-10-01T24:00:00Z", "2026-10-01T11:60:05Z", "2026-10-01T11:22:60Z", "2026-10-01T11:22:05", "2026-10-01T11:22:05+0200", "2026-10-01T11:22:05+25:00", "2026-10-01T11:22:05+02:61", "2026-10-01T11:22:05Zjunk", "2026-10-01T11:22:05.Z", "2026-10-01T11:22:05.", "2026-1-01T11:22:05Z", "26-10-01T11:22:05Z", "2026-10-01T11:22:05.5", "2026-10-01T11:22:5Z", "2026-10-01T011:22:05Z", "2026-10-01T11:22:05 Z", " 2026-10-01T11:22:05Z", "2026-10-01T11:22:05Z ", "2026/10/01T11:22:05Z", "2026-10-01T11:22:05+2:00", "2026-10-01T11:22:05+02:0", "202a-10-01T11:22:05Z", "2026-10-01T11:22:05Ж", "2026-10-01T11:22:05.5ZZ", "2026-10-01T11:22:05*02:00", "2026-10-01T11:22:05+0a:00", "2026-10-01T11:2a:05Z", "2026-10-01T1a:22:05Z", "2026-10-0aT11:22:05Z", "2026-1a-01T11:22:05Z", "2026-10-01T11:22:05+02-00", "2026-10-01T11:22:05-1:30"}
	for _, s := range rfc {
		v, err := tide.ParseRFC3339(s)
		if err != nil {
			say.Line("parserfc", say.Fmt("%q", s), "fault")
		} else {
			say.Line("parserfc", say.Fmt("%q", s), v, tide.FormatRFC3339Nano(v))
		}
	}

	secs := []i64{0, -1, 1759317725, 951782400, 4107542400, -2208988800, 253402300799, 2147483647, 86400 * 365, 253402300800, -62167219200, -62167219201, 9223372036854775807}
	for _, s := range secs {
		say.Line("http", s, tide.FormatHTTP(s))
	}

	years := []i64{1900, 2000, 2023, 2024, 2100, 2400, 0, -1, -4, -100, -400, 1, 1970}
	for _, y := range years {
		say.Line("leap", y, tide.IsLeap(y), tide.DaysIn(y, 1), tide.DaysIn(y, 2), tide.DaysIn(y, 4), tide.DaysIn(y, 12), tide.DaysIn(y, 0), tide.DaysIn(y, 13))
	}

	say.Line("names", tide.WeekdayName(0), tide.WeekdayName(6), tide.WeekdayName(7), tide.WeekdayName(-1), tide.MonthName(1), tide.MonthName(9), tide.MonthName(12), tide.MonthName(0), tide.MonthName(13))
	say.Line("daysfrom", tide.DaysFromCivil(1970, 1, 1), tide.DaysFromCivil(2000, 3, 1), tide.DaysFromCivil(1600, 1, 1), tide.DaysFromCivil(-1, 12, 31), tide.DaysFromCivil(2026, 10, 1), tide.DaysFromCivil(1969, 12, 31), tide.DaysFromCivil(2026, 2, 30), tide.DaysFromCivil(400, 1, 1), tide.DaysFromCivil(0, 1, 1))
	zs := []i64{0, -1, 1, 11016, 20729, 719162, -719468, -1096, 2932896, -2000000, 146097, -146097}
	for _, z := range zs {
		y, m, d := tide.CivilFromDays(z)
		say.Line("civilfrom", z, y, m, d, tide.DaysFromCivil(y, m, d) == z)
	}
}
