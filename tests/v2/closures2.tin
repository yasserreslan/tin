package main

import "say"
import "sift"
import "twine"

type Acc struct {
	n    i64
	name str
}

// each iteration of a for loop has its own copy of the loop variable
func loopVars() {
	fs := make([]func() i64, 0, 3)
	for i := 0; i < 3; i++ {
		fs = append(fs, func() i64 {
			return i * 10
		})
	}
	for _, f := range fs {
		say.Line("loop", f())
	}
	gs := make([]func() i64, 0, 3)
	for _, v := range []i64{7, 8, 9} {
		gs = append(gs, func() i64 {
			return v + 1
		})
	}
	for _, g := range gs {
		say.Line("range", g())
	}
}

func deferred() {
	n := 1
	defer func() {
		say.Line("deferred sees", n)
	}()
	n = 5
	say.Line("body", n)
}

func nested() i64 {
	a := 1
	f := func() func() i64 {
		b := 10
		return func() i64 {
			a++
			b++
			return a*100 + b
		}
	}
	g := f()
	h := f()
	say.Line("nested", g(), g(), h())
	return a
}

func structs() {
	a := Acc{n: 1, name: "x"}
	inc := func(by i64) {
		a.n += by
	}
	inc(2)
	inc(3)
	say.Line("struct", a.n, a.name)
	total := 0
	for _, s := range []Acc{{n: 1, name: "a"}, {n: 2, name: "b"}} {
		show := func() str {
			total += s.n
			return s.name
		}
		say.Line("each", show())
	}
	say.Line("total", total)
}

func shadow() {
	x := 1
	f := func() i64 {
		x := 100
		x++
		return x
	}
	say.Line("shadow", f(), x)
}

var kept func() i64

func keepNested() {
	base := keep([]i64{1, 2, 3})
	kept = keep(func() i64 {
		base = append(base, i64(len(base)))
		return i64(len(base))
	})
}

func library() {
	xs := []i64{5, 2, 8, 1, 9, 3, 7, 4, 6, 0, 15, 12, 11, 14, 13, 10}
	cmps := 0
	sift.SortFunc(mut xs, func(a i64, b i64) i64 {
		cmps++
		if a < b {
			return -1
		}
		if a > b {
			return 1
		}
		return 0
	})
	say.Line("sorted", xs, cmps)
	limit := 3
	seen := 0
	out := twine.Map(func(r i32) i32 {
		seen++
		if i64(seen) > i64(limit) {
			return r - 32
		}
		return r
	}, "abcdefg")
	say.Line("map", out, seen)
	var sep i32 = 0x2c
	parts := twine.FieldsFunc("a,b;;c,d", func(r i32) bool {
		return r == sep || r == ';'
	})
	say.Line("fields", parts)
}

func main() {
	loopVars()
	deferred()
	say.Line("outer a", nested())
	structs()
	shadow()
	keepNested()
	say.Line("kept", kept(), kept())
	library()
}
