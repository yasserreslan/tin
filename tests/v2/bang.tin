package main

import "say"
import "mint"

type P struct {
	x i64
	tags []str
}

func port(text str) !i64 {
	n := try mint.Atoi(text)
	if n < 1 || n > 65535 {
		fail say.Fmt("port %d out of range", n)
	}
	return n
}

func check(n i64) ! {
	if n < 0 {
		fail "negative"
	}
}

func pair(a str) !(str, i64) {
	if a == "" {
		fail "empty"
	}
	return a, len(a)
}

func mkp(ok bool) !P {
	if !ok {
		fail "no"
	}
	return P{x: 1, tags: []str{"a"}}
}

func orzero(t str) i64 {
	return port(t) catch _ { 0 }
}

func main() {
	p := port("80") catch _ { 8080 }
	q := port("99999") catch err {
		say.Line("err:", err)
		7
	}
	var r i64 = port("x") catch _ { -1 }
	r = port("443") catch _ { -2 }
	say.Line(p, q, r, orzero("nope"), orzero("22"))
	check(-1) catch err {
		say.Line("check:", err)
	}
	e := check(5)
	say.Line("check ok:", e == nil)
	a, n := pair("hey") catch _ {
		return
	}
	say.Line(a, n)
	for _, s := range []str{"", "z"} {
		b, m := pair(s) catch err {
			say.Line("pair:", err)
			continue
		}
		say.Line(b, m)
	}
	v, err := mkp(false)
	say.Line(v.x, len(v.tags), err)
	w := mkp(true) catch _ { P{x: 9, tags: []str{}} }
	say.Line(w.x, w.tags)
}
