package main

import "say"

// A program that starts no cores is one thread: main may assign globals that other functions read.
mut total i64
mut names []str

fn add(n i64) {
	total += n
	names = append(names, keep(say.Fmt("n%d", n)))
}

fn report() {
	say.Line(total, len(names), names[0])
}

fn main() {
	add(2)
	add(3)
	report()
}
