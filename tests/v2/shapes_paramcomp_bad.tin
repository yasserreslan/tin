package main

// A listed instance's parameter constraint is checked at the instantiation.
shape Limited[T i64 | str] { Get() T }

shape LimitedGetter[U any] { Limited[U] }

type Box struct { n i64 }

func (b Box) Get() bool {
	return true
}

func Use[S LimitedGetter[bool]](s S) i64 {
	return 0
}

func main() {
	let b = Box{n: 1}
	Use(b)
}
