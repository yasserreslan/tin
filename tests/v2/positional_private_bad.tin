package main

import "flume"
import "say"
import "wire"

// #96: a positional struct literal cannot set private fields of another package either.
func main() {
	w := flume.Writer{true, 2, []u8{}, nil}
	r := wire.Resp{200, "body", "forged head"}
	ok := wire.Resp{Status: 200, Body: "fine"}
	_ = w
	say.Line(r.Status, ok.Status)
}
