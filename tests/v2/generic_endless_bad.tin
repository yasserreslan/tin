package main

// #98: a generic that instantiates itself with ever deeper types is an error, not a hang;
// plain recursion with the same type (Deep) is fine.

import "constraints"
import "say"

type Box[T constraints.Any] struct {
	v T
}

func Wrap[T constraints.Any](x T, n i64) i64 {
	if n == 0 {
		return 0
	}
	return Wrap(Box[T]{v: x}, n-1) + 1
}

func Deep[T constraints.Any](x T, n i64) i64 {
	if n == 0 {
		return 0
	}
	return Deep(x, n-1) + 1
}

func Nest[T constraints.Any](x T) {
	y := []T{x}
	Nest(y)
}

func main() {
	say.Line(Deep(1, 5))
	say.Line(Wrap(1, 3))
	Nest(1)
}
