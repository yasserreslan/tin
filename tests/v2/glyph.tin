package main

import "say"
import "glyph"

func main() {
	say.Line("runelen", glyph.RuneLen('a'), glyph.RuneLen(0xe9), glyph.RuneLen(0x20ac), glyph.RuneLen(0x1f600), glyph.RuneLen(-1), glyph.RuneLen(0xd800), glyph.RuneLen(0x110000))
	say.Line("validrune", glyph.ValidRune('a'), glyph.ValidRune(0xd800), glyph.ValidRune(0x10ffff), glyph.ValidRune(0x110000))

	b := make([]u8, 0, 16)
	n1 := glyph.EncodeRune(mut b, 'A')
	n2 := glyph.EncodeRune(mut b, 0xe9)
	n3 := glyph.EncodeRune(mut b, 0x20ac)
	n4 := glyph.EncodeRune(mut b, 0x1f600)
	n5 := glyph.EncodeRune(mut b, 0xd800)
	say.Line("encode sizes", n1, n2, n3, n4, n5, len(b))
	say.Line("encode bytes", b)
	say.Line("encode str", str(b))
	say.Line("runestr", glyph.RuneStr(0x20ac), glyph.RuneStr(-5))

	s := "aé€😀"
	r, sz := glyph.DecodeRune(s, 0)
	say.Line("decode0", r, sz)
	r, sz = glyph.DecodeRune(s, 1)
	say.Line("decode1", r, sz)
	r, sz = glyph.DecodeRune(s, 3)
	say.Line("decode3", r, sz)
	r, sz = glyph.DecodeRune(s, 6)
	say.Line("decode6", r, sz)
	r, sz = glyph.DecodeRune(s, 10)
	say.Line("decode end", r, sz)
	r, sz = glyph.DecodeRune(s, 2)
	say.Line("decode mid", r, sz)
	bad := "\xff\xc0\x80\xe2\x82"
	r, sz = glyph.DecodeRune(bad, 0)
	say.Line("decode bad0", r, sz)
	r, sz = glyph.DecodeRune(bad, 1)
	say.Line("decode bad1", r, sz)
	r, sz = glyph.DecodeRune(bad, 3)
	say.Line("decode bad3", r, sz)
	r, sz = glyph.DecodeRune("\xed\xa0\x80", 0)
	say.Line("decode surrogate", r, sz)

	r, sz = glyph.DecodeLastRune(s, len(s))
	say.Line("last", r, sz)
	r, sz = glyph.DecodeLastRune(s, 3)
	say.Line("last3", r, sz)
	r, sz = glyph.DecodeLastRune(s, 1)
	say.Line("last1", r, sz)
	r, sz = glyph.DecodeLastRune(s, 0)
	say.Line("last0", r, sz)
	r, sz = glyph.DecodeLastRune("a\x80", 2)
	say.Line("last bad", r, sz)

	say.Line("runestart", glyph.RuneStart('a'), glyph.RuneStart(0xc3), glyph.RuneStart(0xa9), glyph.RuneStart(0xf0))
	say.Line("fullrune", glyph.FullRune("a", 0), glyph.FullRune("\xc3\xa9", 0), glyph.FullRune("\xc3", 0), glyph.FullRune("\xe2\x82", 0), glyph.FullRune("\xe2x", 0), glyph.FullRune("\xff", 0), glyph.FullRune(s, 6), glyph.FullRune(s, 10))
	say.Line("count", glyph.RuneCount(s), glyph.RuneCount(""), glyph.RuneCount("abc"), glyph.RuneCount(bad))
	say.Line("valid", glyph.Valid(s), glyph.Valid(""), glyph.Valid(bad), glyph.Valid("ok\xc3\xa9"), glyph.Valid("\xef\xbf\xbd"))

	say.Line("isletter", glyph.IsLetter('a'), glyph.IsLetter('Z'), glyph.IsLetter('5'), glyph.IsLetter(0xe9), glyph.IsLetter(0xd7), glyph.IsLetter(0xf7), glyph.IsLetter(0xb5), glyph.IsLetter(0x100))
	say.Line("isdigit", glyph.IsDigit('0'), glyph.IsDigit('9'), glyph.IsDigit('a'), glyph.IsDigit(0xb2))
	say.Line("isspace", glyph.IsSpace(' '), glyph.IsSpace('\t'), glyph.IsSpace('\n'), glyph.IsSpace(0xa0), glyph.IsSpace('x'), glyph.IsSpace(0x85))
	say.Line("isupper", glyph.IsUpper('A'), glyph.IsUpper('a'), glyph.IsUpper(0xc9), glyph.IsUpper(0xd7), glyph.IsUpper(0xe9))
	say.Line("islower", glyph.IsLower('a'), glyph.IsLower('A'), glyph.IsLower(0xe9), glyph.IsLower(0xf7), glyph.IsLower(0xdf), glyph.IsLower(0xb5))
	say.Line("toupper", glyph.ToUpper('a'), glyph.ToUpper('Z'), glyph.ToUpper('1'), glyph.ToUpper(0xe9), glyph.ToUpper(0xf7), glyph.ToUpper(0xff), glyph.ToUpper(0xdf))
	say.Line("tolower", glyph.ToLower('A'), glyph.ToLower('z'), glyph.ToLower('1'), glyph.ToLower(0xc9), glyph.ToLower(0xd7), glyph.ToLower(0xdf))
	say.Line("roundtrip", str(glyph.RuneStr(glyph.ToUpper(0xe9))), str(glyph.RuneStr(glyph.ToLower(0xc9))))
}
