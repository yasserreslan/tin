package main

import "say"

type Point struct {
	X, Y i64
	Tag  u8
	Name str
}

fn (p mut Point) Move(dx i64, dy i64) {
	p.X += dx
	p.Y += dy
}

fn (p Point) Label() str {
	return say.Fmt("%s(%d,%d)", p.Name, p.X, p.Y)
}

fn divmod(a i64, b i64) (i64, i64) {
	return a / b, a % b
}

fn parse(s str) !i64 {
	mut n = i64(0)
	if len(s) == 0 {
		fail "empty"
	}
	for i in 0..len(s) {
		let c = s[i]
		if c < '0' || c > '9' {
			fail say.Fault("bad digit %q at %d", i64(c), i)
		}
		n = n*10 + i64(c-'0')
	}
	return n
}

fn double(s str) !i64 {
	let v = try parse(s)
	return v * 2
}

fn main() {
	say.Line("hello, tin", 42, true, 3.5)
	let p = Point{X: 1, Y: 2, Name: "p"}
	p.Move(10, 20)
	say.Line(p.Label(), p.X+p.Y)
	let (q, r) = divmod(17, 5)
	say.Out("q=%d r=%d %5.2f|%-4s|%x\n", q, r, 3.14159, "ab", 255)
	mut nums = []i64{5, 3, 8}
	nums = append(nums, 1, 9)
	mut total = i64(0)
	for _, n in nums {
		total += n
	}
	say.Line(nums, len(nums), total)
	let m = map[str]i64{"a": 1}
	m["b"] = 2
	m["a"] += 10
	let (v, ok) = m["zz"]
	say.Line(m, len(m), v, ok)
	let s = "héllo"
	for i, c in s {
		say.Text(i, ":", str(c), " ")
	}
	say.Line()
	mut b u8 = 250
	b +%= 10
	mut w i32 = 2147483647
	w +%= 1
	let big = i64(70000)
	say.Line(b, w, u16(big), i8(-129+256), i8(big))
	let (x, err) = double("21")
	if err != nil {
		say.Line("error:", err)
	}
	say.Line("double:", x)
	let (_, err2) = double("4x")
	if err2 != nil {
		say.Line("error:", err2)
	}
	mut f f64 = 2
	f = f * 1.5
	say.Line(f, i64(f), f64(q)/2)
}
