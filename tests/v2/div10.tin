package main

import "say"

func show64(n i64) {
	say.Line(n, n / 10, n % 10, n / -10, n % -10)
}

func show32(n i32) {
	say.Line(n, n / 10, n % 10)
}

func showU(n u64) {
	say.Line(n, n / 10, n % 10)
}

func main() {
	show64(-9223372036854775807 - 1)
	show64(-2147483649)
	show64(-11)
	show64(-10)
	show64(-9)
	show64(-1)
	show64(0)
	show64(1)
	show64(9)
	show64(10)
	show64(11)
	show64(2147483648)
	show64(9223372036854775807)
	show32(-2147483647 - 1)
	show32(-11)
	show32(-10)
	show32(-9)
	show32(-1)
	show32(0)
	show32(1)
	show32(9)
	show32(10)
	show32(11)
	show32(2147483647)
	showU(u64(1) << 63)
}
