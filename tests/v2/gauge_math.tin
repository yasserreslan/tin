package main

import "say"
import "gauge"

// r prints a transcendental result to 12 significant digits, so the last bit (which differs
// between a fused multiply-add and a separate multiply and add) does not matter.
func r(x f64) str {
	return say.Fmt("%.12g", x)
}

func main() {
	inf := gauge.Inf(1)
	ninf := gauge.Inf(-1)
	nan := gauge.NaN()
	nz := gauge.Copysign(0, -1)
	sub := gauge.SmallestNonzeroF64

	// Frexp, Ldexp and Modf are exact.
	for _, x := range []f64{0, nz, 1, 8, 0.1, -3.75, 1e300, sub, 2.2250738585072014e-308, inf, ninf, nan} {
		f, e := gauge.Frexp(x)
		i, fr := gauge.Modf(x)
		say.Line("frexp", x, f, e, "modf", i, fr)
	}
	for _, c := range []f64{1, 0.5, -0.75, 1e-310, 3} {
		say.Line("ldexp", c, gauge.Ldexp(c, -1074), gauge.Ldexp(c, -1075), gauge.Ldexp(c, -1022), gauge.Ldexp(c, 1023), gauge.Ldexp(c, 1024), gauge.Ldexp(c, 0))
	}
	say.Line("ldexp0", gauge.Ldexp(0, 5), gauge.Ldexp(nz, 5), gauge.Ldexp(inf, -5), gauge.Ldexp(nan, 3))

	// Mod is exact, whatever the quotient.
	for _, p := range [][]f64{{7.5, 2}, {-7.5, 2}, {7.5, -2}, {1e300, 7}, {5, inf}, {inf, 5}, {5, 0}, {0, 3}, {nz, 3}, {1e-310, 3e-311}, {nan, 1}, {17, 5.5}} {
		say.Line("mod", p[0], p[1], gauge.Mod(p[0], p[1]))
	}

	// Trigonometry, including the arguments that need the exact (Payne-Hanek) reduction.
	for _, x := range []f64{0, nz, 0.5, 1, -1, 2, 3.141592653589793, 100, 1e6, 536870911, 536870912, 1073741824, 1e10, 1e15, 1e22, 1e100, 1.7e308, inf, nan} {
		say.Line("trig", x, r(gauge.Sin(x)), r(gauge.Cos(x)), r(gauge.Tan(x)))
	}
	for _, x := range []f64{0, nz, 0.25, 0.5, 0.6, 0.7, 0.75, 1, -1, 2, -0.5, inf, ninf, nan, 1e-20, 1e300} {
		say.Line("inv", x, r(gauge.Asin(x)), r(gauge.Acos(x)), r(gauge.Atan(x)))
	}
	for _, y := range []f64{0, nz, 1, -1, inf, ninf, nan} {
		for _, x := range []f64{0, nz, 1, -1, inf, ninf, nan} {
			say.Line("atan2", y, x, r(gauge.Atan2(y, x)))
		}
	}

	// Exponentials and logarithms.
	for _, x := range []f64{0, nz, 1, -1, 0.5, 10, 100, 709, 709.78, 710, -708, -745, -745.2, -746, 1e-10, 1e-20, inf, ninf, nan} {
		say.Line("exp", x, r(gauge.Exp(x)), r(gauge.Exp2(x)), r(gauge.Sinh(x)), r(gauge.Cosh(x)), r(gauge.Tanh(x)))
	}
	for _, x := range []f64{0, nz, 1, 2, 8, 0.125, 10, 1000, 1e-310, sub, 1e300, 2.5, 0.001, -1, inf, ninf, nan} {
		say.Line("log", x, r(gauge.Log(x)), r(gauge.Log2(x)), r(gauge.Log10(x)), r(gauge.Log1p(x)))
	}
	say.Line("log2exact", gauge.Log2(8), gauge.Log2(0.125), gauge.Log2(1), gauge.Log2(1024), gauge.Log2(sub))
	say.Line("log1p", r(gauge.Log1p(1e-20)), r(gauge.Log1p(-0.5)), r(gauge.Log1p(1e300)), gauge.Log1p(-1), gauge.Log1p(-2), gauge.Log1p(1e-300))

	// Pow: the special cases of C99 and Go, then a spread of ordinary values.
	for _, p := range [][]f64{{2, 0}, {nan, 0}, {1, nan}, {nan, 1}, {-8, 1.0 / 3}, {-2, 3}, {-2, 2}, {0, -1}, {nz, -3}, {nz, 3}, {nz, 2}, {nz, -2},
		{2, 1024}, {2, -1075}, {2, -1074}, {2, 0.5}, {4, -0.5}, {10, 308}, {10, -5}, {10, 2.5}, {-1, inf}, {-1, ninf}, {0.5, inf}, {2, ninf}, {0.5, ninf},
		{inf, -1}, {inf, 2}, {ninf, 3}, {ninf, 2}, {ninf, -3}, {ninf, -2}, {0.1, 3}, {1.0000001, 1e9}, {7, 22}, {123.456, -1.5}, {1e-5, 7.25}, {2, 63}, {2, 64}, {3, 40.5}, {1e300, 2}, {1e-300, 2}} {
		say.Line("pow", p[0], p[1], r(gauge.Pow(p[0], p[1])))
	}

	// Cbrt and Hypot.
	for _, x := range []f64{0, nz, 27, -8, 1, 2, 1e-310, sub, 1e300, 0.001, inf, ninf, nan} {
		say.Line("cbrt", x, r(gauge.Cbrt(x)))
	}
	for _, p := range [][]f64{{3, 4}, {-3, 4}, {0, 0}, {inf, nan}, {nan, 5}, {1e300, 1e300}, {sub, sub}, {1e-200, 1e-200}, {5, 12}, {1, 1}} {
		say.Line("hypot", p[0], p[1], r(gauge.Hypot(p[0], p[1])))
	}
}
