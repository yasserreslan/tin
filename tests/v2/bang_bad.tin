package main

import "mint"
import "say"

func old() (i64, fault) {
	return 1, nil
}

func both() !i64 {
	return 1, nil
}

func noval() ! {
	return 3
}

func plain() i64 {
	fail "no fault result"
}

func novalue() i64 {
	n := mint.Atoi("1") catch _ {
		say.Line("no value here")
	}
	return n
}

func nofault() i64 {
	return 2
}

func caught() i64 {
	return nofault() catch _ { 0 }
}

func pairs() !(i64, i64) {
	return 1, 2
}

func multi() i64 {
	a, b := pairs() catch _ { 0 }
	return a + b
}

func main() {
	say.Line(novalue(), caught(), multi())
}
