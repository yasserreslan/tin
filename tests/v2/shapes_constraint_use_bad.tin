package main

// A constraint failure in a listed instance is reported once, even when the shape is used.
shape A[T i64 | str] { Get() T }

shape G[T any] { A[f64] }

type X struct { n i64 }

func (x X) Get() f64 {
	return 0
}

func Use[S G[i64]](s S) i64 {
	return 0
}

func main() {
	let x = X{n: 1}
	Use(x)
}
