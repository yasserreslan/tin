package main

import "say"

// Only `p = append(p, ...)` reaches the caller of a mut slice parameter; any other assignment
// rebinds the callee's copy and would be lost silently (#498).
fn drop2(p mut []u8) { p = p[2:] }
fn swap(p mut []u8, q []u8) { p = q }
fn other(p mut []u8, q []u8) { p = append(q, 1) }
fn reset(p mut []u8) { p = append(p[:0], 1) }
fn fresh(p mut []u8) { p = make([]u8, 0) }

// Still allowed: elements and the append idiom.
fn grow(p mut []u8) {
	p = append(p, 5)
	p[0] = 9
}

fn main() {
	mut a = make([]u8, 0)
	a = append(a, 1, 2, 3, 4)
	drop2(mut a)
	swap(mut a, a)
	other(mut a, a)
	reset(mut a)
	fresh(mut a)
	grow(mut a)
	say.Line(len(a))
}
