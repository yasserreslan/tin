package main

// The type argument picks the signature: Box2.Next returns ?Box2, not ?Box.
shape Seq[T any] { Next() ?T }

type Box struct { n i64 }

func (b Box) Next() ?Box {
	return nil
}

type Box2 struct { n i64 }

func (b Box2) Next() ?Box2 {
	return nil
}

func Use[S Seq[Box]](s S) i64 {
	return 0
}

func main() {
	let c = Box2{n: 1}
	Use(c)
}
