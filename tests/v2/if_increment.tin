package main

import "say"
import "gauge"

fn main() {
	mut hits = 0
	for i in 0..1000 {
		if i%2 == 0 {
			hits += 1
		}
	}
	mut edge = i64(9223372036854775807)
	if edge > 0 {
		edge +%= 1
	}
	let nan = gauge.NaN()
	mut equal = 0
	if nan == nan {
		equal += 1
	}
	mut unequal = 0
	if nan != nan {
		unequal += 1
	}
	say.Line(hits, edge, equal, unequal)
}
