package main

import "say"
import "sift"

// lcg advances a 64-bit linear congruential generator.
func lcg(k i64) i64 {
	return k*6364136223846793005 + 1442695040888963407
}

// genInts returns n full-range pseudo-random values.
func genInts(n i64, seed i64) []i64 {
	xs := make([]i64, n)
	k := seed
	for i := 0; i < n; i++ {
		k = lcg(k)
		xs[i] = k
	}
	return xs
}

// genSmall returns n pseudo-random values in (-m, m).
func genSmall(n i64, seed i64, m i64) []i64 {
	xs := make([]i64, n)
	k := seed
	for i := 0; i < n; i++ {
		k = lcg(k)
		xs[i] = (k >> 33) % m
	}
	return xs
}

// checksum folds xs into one wrapping i64.
func checksum(xs []i64) i64 {
	h := i64(0)
	for _, v := range xs {
		h = h*1000003 + v
	}
	return h
}

// oddFirst orders odd values before even ones, then by value.
func oddFirst(a i64, b i64) bool {
	oa := a & 1
	ob := b & 1
	if oa != ob {
		return oa == 1
	}
	return a < b
}

// desc orders larger values first.
func desc(a i64, b i64) bool {
	return a > b
}

// nan returns a quiet NaN.
func nan() f64 {
	z := f64(0)
	return z / z
}

// inf returns +Inf.
func inf() f64 {
	big := 1e300
	return big * 1e10
}

func main() {
	e := []i64{}
	sift.Ints(mut e)
	say.Line("ints empty", len(e), sift.IsSortedInts(e))
	one := []i64{5}
	sift.Ints(mut one)
	say.Line("ints one", one)
	two := []i64{2, 1}
	sift.Ints(mut two)
	say.Line("ints two", two)
	small := []i64{5, 2, 9, 1, 5, 6, -3, 0}
	sift.Ints(mut small)
	say.Line("ints small", small)
	ext := []i64{9223372036854775807, -9223372036854775807 - 1, 0, -1, 1}
	sift.Ints(mut ext)
	say.Line("ints ext", ext)
	r100 := genInts(100, 42)
	sift.Ints(mut r100)
	say.Line("ints 100", sift.IsSortedInts(r100), r100)
	r1000 := genInts(1000, 7)
	sift.Ints(mut r1000)
	say.Line("ints 1000", sift.IsSortedInts(r1000), checksum(r1000), r1000[0], r1000[999])
	big := genInts(100000, 99)
	sift.Ints(mut big)
	say.Line("ints 100000", sift.IsSortedInts(big), checksum(big))
	sorted := make([]i64, 200)
	for i := 0; i < 200; i++ {
		sorted[i] = i * 3
	}
	sift.Ints(mut sorted)
	say.Line("ints sorted", sift.IsSortedInts(sorted), checksum(sorted))
	rev := make([]i64, 200)
	for i := 0; i < 200; i++ {
		rev[i] = 1000 - i
	}
	sift.Ints(mut rev)
	say.Line("ints reversed", sift.IsSortedInts(rev), rev[0], rev[199], checksum(rev))
	same := make([]i64, 300)
	for i := 0; i < 300; i++ {
		same[i] = 7
	}
	sift.Ints(mut same)
	say.Line("ints same", sift.IsSortedInts(same), same[0], same[299])
	dup := genSmall(500, 3, 5)
	sift.Ints(mut dup)
	say.Line("ints dups", sift.IsSortedInts(dup), checksum(dup), dup[0], dup[499])
	saw := make([]i64, 1000)
	for i := 0; i < 1000; i++ {
		saw[i] = i % 37
	}
	sift.Ints(mut saw)
	say.Line("ints saw", sift.IsSortedInts(saw), checksum(saw))
	pipe := make([]i64, 1000)
	for i := 0; i < 1000; i++ {
		if i < 500 {
			pipe[i] = i
		} else {
			pipe[i] = 1000 - i
		}
	}
	sift.Ints(mut pipe)
	say.Line("ints pipe", sift.IsSortedInts(pipe), checksum(pipe))
	nearly := make([]i64, 300)
	for i := 0; i < 300; i++ {
		nearly[i] = i
	}
	nearly[10] = 290
	nearly[290] = 10
	nearly[150] = 151
	nearly[151] = 150
	sift.Ints(mut nearly)
	say.Line("ints nearly", sift.IsSortedInts(nearly), checksum(nearly))

	d1 := []i64{5, 2, 9, 1, 5, 6, -3, 0}
	sift.IntsDesc(mut d1)
	say.Line("desc small", d1)
	d2 := []i64{9223372036854775807, -9223372036854775807 - 1, 0, -1, 1}
	sift.IntsDesc(mut d2)
	say.Line("desc ext", d2)
	d3 := genInts(100, 42)
	sift.IntsDesc(mut d3)
	say.Line("desc 100", d3)
	d4 := []i64{}
	sift.IntsDesc(mut d4)
	say.Line("desc empty", len(d4))

	u1 := []u64{18446744073709551615, 0, 1, 9223372036854775808, 42, 9223372036854775807}
	sift.U64s(mut u1)
	say.Line("u64 small", u1)
	u2 := make([]u64, 100)
	k := i64(5)
	for i := 0; i < 100; i++ {
		k = lcg(k)
		u2[i] = u64(k)
	}
	sift.U64s(mut u2)
	say.Line("u64 100", u2)
	u3 := []u64{}
	sift.U64s(mut u3)
	say.Line("u64 empty", len(u3))

	f1 := []f64{nan(), 3.5, -inf(), inf(), -0.0, 2.25, -1e308, 1e-308, nan(), 0.5, -2.5}
	sift.F64s(mut f1)
	say.Line("f64 small", f1)
	f2 := make([]f64, 100)
	k = 9
	for i := 0; i < 100; i++ {
		k = lcg(k)
		f2[i] = f64(k>>40) / 1024.0
	}
	f2[10] = nan()
	f2[50] = nan()
	sift.F64s(mut f2)
	say.Line("f64 100", f2)
	f3 := []f64{2.5}
	sift.F64s(mut f3)
	say.Line("f64 one", f3)
	f4 := []f64{nan(), nan()}
	sift.F64s(mut f4)
	say.Line("f64 nans", f4)

	s1 := []str{"banana", "apple", "", "Apple", "cherry", "apple", "b", "héllo", "hello", "zz", "a", "aa", "ab"}
	sift.Strs(mut s1)
	say.Line("strs small", sift.IsSortedStrs(s1), s1)
	s2 := make([]str, 100)
	k = 77
	for i := 0; i < 100; i++ {
		k = lcg(k)
		s2[i] = say.Fmt("s%d", (k>>40)%500)
	}
	sift.Strs(mut s2)
	say.Line("strs 100", sift.IsSortedStrs(s2), s2)
	s3 := []str{}
	sift.Strs(mut s3)
	say.Line("strs empty", len(s3))
	s4 := []str{"x"}
	sift.Strs(mut s4)
	say.Line("strs one", s4)

	b1 := genSmall(50, 11, 1000)
	sift.SortBy(mut b1, oddFirst)
	say.Line("sortby odd", b1)
	b2 := []i64{5, 2, 9, 1, 5, 6, -3, 0}
	sift.SortBy(mut b2, desc)
	say.Line("sortby desc", b2)
	b3 := genInts(300, 13)
	sift.SortBy(mut b3, desc)
	say.Line("sortby desc300", checksum(b3), b3[0], b3[299])
	b4 := []i64{}
	sift.SortBy(mut b4, desc)
	say.Line("sortby empty", len(b4))

	st1 := []i64{5, 2, 9, 1, 5, 6, -3, 0}
	sift.StableInts(mut st1)
	say.Line("stable small", st1)
	st2 := []i64{9223372036854775807, -9223372036854775807 - 1, 0, -1, 1}
	sift.StableInts(mut st2)
	say.Line("stable ext", st2)
	st3 := genInts(1000, 7)
	sift.StableInts(mut st3)
	say.Line("stable 1000", sift.IsSortedInts(st3), checksum(st3))
	st4 := genInts(100000, 99)
	sift.StableInts(mut st4)
	say.Line("stable 100000", sift.IsSortedInts(st4), checksum(st4))
	st5 := make([]i64, 200)
	for i := 0; i < 200; i++ {
		st5[i] = 1000 - i
	}
	sift.StableInts(mut st5)
	say.Line("stable reversed", sift.IsSortedInts(st5), checksum(st5))
	st6 := genSmall(500, 3, 5)
	sift.StableInts(mut st6)
	say.Line("stable dups", sift.IsSortedInts(st6), checksum(st6))
	st7 := []i64{}
	sift.StableInts(mut st7)
	say.Line("stable empty", len(st7))
	st8 := genInts(25, 21)
	sift.StableInts(mut st8)
	say.Line("stable 25", st8)

	h1 := []i64{5, 2, 9, 1, 5, 6, -3, 0}
	sift.HeapInts(mut h1)
	say.Line("heap small", h1)
	h2 := genInts(100, 42)
	sift.HeapInts(mut h2)
	say.Line("heap 100", sift.IsSortedInts(h2), checksum(h2))
	h3 := []i64{}
	sift.HeapInts(mut h3)
	say.Line("heap empty", len(h3))

	say.Line("issorted ints", sift.IsSortedInts([]i64{}), sift.IsSortedInts([]i64{1}), sift.IsSortedInts([]i64{1, 2, 2, 3}), sift.IsSortedInts([]i64{3, 1}), sift.IsSortedInts([]i64{1, 2, 1}))
	say.Line("issorted strs", sift.IsSortedStrs([]str{}), sift.IsSortedStrs([]str{"a", "b"}), sift.IsSortedStrs([]str{"b", "a"}), sift.IsSortedStrs([]str{"a", "a"}), sift.IsSortedStrs([]str{"a", "B"}))

	srch := []i64{1, 3, 3, 5, 8}
	say.Line("search ints", sift.SearchInts(srch, 0), sift.SearchInts(srch, 1), sift.SearchInts(srch, 3), sift.SearchInts(srch, 4), sift.SearchInts(srch, 5), sift.SearchInts(srch, 8), sift.SearchInts(srch, 9), sift.SearchInts([]i64{}, 1))
	srs := []str{"a", "c", "c", "e"}
	say.Line("search strs", sift.SearchStrs(srs, ""), sift.SearchStrs(srs, "a"), sift.SearchStrs(srs, "b"), sift.SearchStrs(srs, "c"), sift.SearchStrs(srs, "d"), sift.SearchStrs(srs, "e"), sift.SearchStrs(srs, "f"), sift.SearchStrs([]str{}, "a"))

	rv1 := []i64{1, 2, 3}
	sift.ReverseInts(mut rv1)
	rv2 := []i64{1, 2}
	sift.ReverseInts(mut rv2)
	rv3 := []i64{1}
	sift.ReverseInts(mut rv3)
	rv4 := []i64{}
	sift.ReverseInts(mut rv4)
	say.Line("reverse ints", rv1, rv2, rv3, len(rv4))
	rs1 := []str{"a", "b", "c"}
	sift.ReverseStrs(mut rs1)
	rs2 := []str{}
	sift.ReverseStrs(mut rs2)
	say.Line("reverse strs", rs1, len(rs2))

	q1 := []i64{1, 1, 2, 2, 2, 3}
	n1 := sift.UniqInts(mut q1)
	say.Line("uniq runs", n1, q1[0:n1])
	q2 := []i64{}
	say.Line("uniq empty", sift.UniqInts(mut q2))
	q3 := []i64{7}
	say.Line("uniq one", sift.UniqInts(mut q3), q3)
	q4 := []i64{1, 2, 3}
	say.Line("uniq distinct", sift.UniqInts(mut q4), q4)
	q5 := []i64{5, 5, 5}
	n5 := sift.UniqInts(mut q5)
	say.Line("uniq same", n5, q5[0:n5])
	q6 := genSmall(500, 3, 5)
	sift.Ints(mut q6)
	n6 := sift.UniqInts(mut q6)
	say.Line("uniq dups", n6, q6[0:n6])

	mn, errMn := sift.MinInts([]i64{3, -1, 7})
	mx, errMx := sift.MaxInts([]i64{3, -1, 7})
	say.Line("minmax", mn, errMn, mx, errMx)
	mn2, errMn2 := sift.MinInts([]i64{})
	mx2, errMx2 := sift.MaxInts([]i64{})
	say.Line("minmax empty", mn2, errMn2, mx2, errMx2)
	mn3, errMn3 := sift.MinInts(ext)
	mx3, errMx3 := sift.MaxInts(ext)
	say.Line("minmax ext", mn3, errMn3, mx3, errMx3)
	mn4, errMn4 := sift.MinInts([]i64{4})
	say.Line("min one", mn4, errMn4)
	say.Line("sum", sift.SumInts([]i64{}), sift.SumInts([]i64{1, 2, 3}), sift.SumInts([]i64{9223372036854775807, 1}), sift.SumInts([]i64{-5}))
	say.Line("index", sift.IndexInts([]i64{4, 5, 6}, 5), sift.IndexInts([]i64{4, 5, 6}, 7), sift.IndexInts([]i64{}, 1), sift.IndexInts([]i64{1, 2, 1}, 1), sift.IndexInts([]i64{1, 2, 1}, 2))
	say.Line("contains", sift.ContainsStr([]str{"a", "b"}, "b"), sift.ContainsStr([]str{"a", "b"}, "c"), sift.ContainsStr([]str{"a", "b"}, ""), sift.ContainsStr([]str{}, "a"), sift.ContainsStr([]str{"", "x"}, ""), sift.ContainsStr([]str{"héllo"}, "héllo"))
	say.Line("equal", sift.EqualInts([]i64{1, 2}, []i64{1, 2}), sift.EqualInts([]i64{1, 2}, []i64{1, 2, 3}), sift.EqualInts([]i64{1, 2}, []i64{1, 3}), sift.EqualInts([]i64{}, []i64{}), sift.EqualInts([]i64{}, []i64{0}), sift.EqualInts(ext, ext))
}
