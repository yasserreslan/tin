package main

import "say"
import "sift"

// #352: slices are references, so a name copied from another is the same slice. Taking a copy,
// not reading the old name after append, or breaking the alias are all fine (slice_alias_bad.tin
// is the trap).
fn main() {
	mut xs = []i64{1, 2, 3}
	mut snap = sift.Clone(xs)
	xs = append(xs, 4)
	say.Line(len(xs), len(snap))

	mut ys = xs
	ys = append(ys, 5)
	say.Line(len(ys))

	mut zs = ys
	zs = []i64{7}
	ys = append(ys, 6)
	say.Line(len(zs), len(ys))

	// Elements are shared as well, which is what an alias is for.
	let view = ys
	ys[0] = 100
	say.Line(view[0])
}
