# Assembly check for tests/v2/shapes_dispatch_asm.tin: the call through the Reader
# parameter is a direct call on Buf.Read on both CPUs, and no indirect call appears
# in the listing (a method table would need one).
#
# CHECK lines match in order; a CHECK-NOT must not match between the previous CHECK's
# match and the next CHECK's match, as in lit. The program has no function values, so
# the trailing CHECK-NOT runs from the direct call to the end of the listing.

[arm64]
CHECK: bl _Buf.Read
CHECK-NOT: blr

[amd64]
CHECK: call S[0-9]+ +# Buf.Read
CHECK-NOT: call r[a-z0-9]+
