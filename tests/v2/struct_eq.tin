package main

import "constraints"
import "say"

type P struct {
	x i64
	name str
}

type Line struct {
	a P
	b P
	w f64
}

type Shape enum {
	Dot(p P)
	Empty
}

// #352: == on structs compares field by field (the way enums do); same(a, b) is identity.
// A struct holding a slice, map or function has no value equality (see struct_eq_bad.tin).
fn main() {
	let a = P{x: 1, name: "a"}
	let b = P{x: 1, name: "a"}
	let c = P{x: 2, name: "a"}
	say.Line(a == b, a != b, a == c, same(a, b), same(a, a))
	let l1 = Line{a: a, b: c, w: 1.5}
	let l2 = Line{a: b, b: c, w: 1.5}
	say.Line(l1 == l2, l1 != l2, Line{a: a, b: a, w: 0.0} == l1)
	say.Line(Shape.Dot(a) == Shape.Dot(b), Shape.Dot(a) == Shape.Dot(c), Shape.Empty == Shape.Empty)
	let xs = []i64{1}
	let ys = xs
	say.Line(same(xs, ys), same(xs, []i64{1}))
	let m = map[str]i64{}
	say.Line(same(m, m))
	// Structs are equal as switch cases and as generic Comparable values.
	let want = P{x: 2, name: "a"}
	match c == want {
		true => {
			say.Line("c is want")
		}
		false => {
			say.Line("c is not want")
		}
	}
	say.Line(count([]P{a, b, c, a}, a))
}

fn count[T constraints.Comparable](xs []T, v T) i64 {
	mut n = 0
	for _, x in xs {
		if x == v {
			n += 1
		}
	}
	return n
}
