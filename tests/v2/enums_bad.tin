package main

import "say"

type Shape enum {
	Circle(r f64)
	Rect(w, h f64)
	Tagged(tags []str)
	Empty
}


func f(s Shape) {
	switch s {
	case Circle(r):
		say.Line(r)
	case Rect(w):
		say.Line(w)
	}
	switch s {
	case Square(x):
		say.Line(x)
	default:
	}
	say.Line(s.r)
	a := Shape.Oval(1)
	b := Shape.Circle(1, 2)
	c := Shape{r: 1}
	say.Line(a, b, c, s == Shape.Empty)
}

func main() {
	f(Shape.Empty)
}
