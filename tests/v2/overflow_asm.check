# Assembly check for tests/v2/overflow_asm.tin (#362): a checked + is a flag-setting add and
# one branch on overflow to the function's cold stub, +% is a plain add, an unsigned * tests
# the high half of the product, and a 0..len(xs) counter's increment carries no check.

[arm64]
CHECK: _add:
CHECK: adds x[0-9]+, x[0-9]+, x[0-9]+
CHECK: b\.vs L[0-9]+
CHECK: bl _rt_overflow_fail
CHECK: _wadd:
CHECK-NOT: adds|b\.vs
CHECK: add x0, x[0-9]+, x[0-9]+
CHECK-NOT: b\.vs
CHECK: _umul:
CHECK: umulh x16, x[0-9]+, x[0-9]+
CHECK: cbnz x16, L[0-9]+
CHECK: _count:
CHECK-NOT: b\.vs|adds
CHECK: add x[0-9]+, x[0-9]+, #1
CHECK-NOT: b\.vs|adds
CHECK: _main\.main:

[amd64]
CHECK: \nL1:
CHECK: add r[a-z0-9]+,r[a-z0-9]+\njo L[0-9]+
CHECK: call S[0-9]+ +# rt_overflow_fail
CHECK: \nL2:
CHECK-NOT: \njo
CHECK: \nL3:
CHECK: mul r[a-z0-9]+\njb L[0-9]+
CHECK: \nL4:
CHECK-NOT: \njo
CHECK: add r[a-z0-9]+,0x1\n
CHECK-NOT: \njo
CHECK: \nL5:
