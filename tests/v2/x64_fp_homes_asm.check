# The x64 loop keeps its float locals in XMM homes, then preserves them around a call.
[arm64]
CHECK: _work:
CHECK: fmadd d9, d10, d8, d9
CHECK: bl _checkpoint

[amd64]
CHECK: # L[0-9]+: work
CHECK: movq xmm(?:8|9|1[0-4]),r11
CHECK-NOT: movsd QWORD PTR \[rbp-
CHECK: addsd xmm(?:8|9|1[0-4]),xmm1
CHECK-NOT: movsd QWORD PTR \[rbp-
CHECK: movsd QWORD PTR \[rsp\],xmm(?:8|9|1[0-4])
CHECK: call S[0-9]+ +# checkpoint
CHECK: movsd xmm(?:8|9|1[0-4]),QWORD PTR \[rsp\]
