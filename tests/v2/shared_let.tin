package main

import "atomic"
import "say"

type Pair struct {
	name str
	n    i64
}

type Color enum {
	Red
	Green(v i64)
}

shared let table = build(1000)
shared let names = map[str]i64{"a": 1, "b": 2}
shared let origin = Pair{name: "o", n: 7}
shared let color = Color.Green(5)
shared let hits = atomic.NewInt(0)
shared let flag = atomic.NewBool(false)
shared let greeting = "hello"

fn build(n i64) []i64 {
	let xs = make([]i64, n)
	for i in 0..n {
		xs[i] = i * 2
	}
	return xs
}

fn main() {
	mut sum = 0
	for _, v in table {
		sum += v
	}
	say.Line(len(table), sum, names["b"], origin.name, origin.n, greeting)
	say.Line(hits.Add(3), hits.Add(-1), hits.Load(), hits.CompareSwap(2, 10), hits.Swap(4), hits.Load())
	say.Line(flag.Load(), flag.CompareSwap(false, true), flag.Load(), flag.Swap(false))
	match color {
		Green(v) => {
			say.Line("green", v)
		}
		Red => {
			say.Line("red")
		}
	}
}
