package main

// A nested satisfaction check must not suppress the outer one: resolving the union
// member Box[Inner] checks T against Inner, and C's own check against T must still run.
shape T { TM() i64 }

type Inner struct { n i64 }

func (i Inner) TM() i64 {
	return 1
}

type C struct { n i64 }

type Box[U T] struct { x U }

shape U = C | Box[Inner]

shape S {
	U
	T
}

func Use[X S](x X) i64 {
	return 0
}

func main() {
	let c = C{n: 1}
	Use(c)
}
