package main

import "hearth"
import "say"

// #179: request memory read after hearth.Reset() freed it.

func mk(n i64) str {
	return "fresh-{n}"
}

func direct() {
	s := mk(1)
	hearth.Reset()
	say.Line(s)
}

func wraps() {
	s := mk(2)
	for i := 0; i < 3; i++ {
		say.Line(s)
		hearth.Reset()
	}
}

func cleanup() {
	hearth.Reset()
}

func helper() {
	xs := []str{mk(3)}
	cleanup()
	say.Line(len(xs))
}

func branch(c bool) {
	s := mk(4)
	if c {
		hearth.Reset()
	}
	say.Line(s)
}

func main() {
	direct()
	wraps()
	helper()
	branch(true)
}
