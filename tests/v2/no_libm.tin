package main

import "say"
import "gauge"
import "quarry"
import "twine"

// The math package is written in Tin and the hardware functions (sqrt, floor, ...) are compiled
// inline, so a program that uses all of it must not depend on the system math library. On Linux a
// program's dynamic section names the libraries it needs, so its own image shows whether libm is
// one (macOS has no /proc; there the answer is always "no").
func main() {
	x := gauge.Sin(1) + gauge.Cos(1) + gauge.Tan(1) + gauge.Atan2(1, 2) + gauge.Exp(1) + gauge.Log(2) +
		gauge.Pow(2, 0.5) + gauge.Cbrt(2) + gauge.Hypot(3, 4) + gauge.Mod(7, 2) + gauge.Sqrt(2) +
		gauge.Floor(2.5) + gauge.Ceil(2.5) + gauge.Trunc(2.5) + gauge.Round(2.5) + gauge.RoundToEven(2.5)
	image := quarry.ReadFile("/proc/self/exe") catch _ {
		""
	}
	// The name is assembled at run time: written out as a literal it would be in the image itself.
	needle := "libm.so." + say.Fmt("%d", 6)
	say.Line("ran:", x > 0, "libm named in its own image:", twine.Contains(image, needle))
}
