package main

// argo.Put writes valid JSON for any str: invalid UTF-8 bytes become \ufffd and U+2028/U+2029
// are escaped, byte for byte as Go's encoding/json (#104).

import "argo"
import "say"

type M struct {
	S str
}

func main() {
	cases := []str{"plain", "h\xffi\xc3", "caf\xc3\xa9", "\xe2\x82\xac euro", "\xed\xa0\x80 surrogate", "\xc0\xaf overlong", "\xf4\x90\x80\x80 big", "\xf0\x9f\x98\x80 emoji", "tail \xe2\x82", "mixed \"q\" \xff\n", "  line sep", "abcdefgh\xffabcdefgh"}
	for _, c := range cases {
		b := make([]u8, 0, 64)
		argo.Put(mut b, M{S: c})
		say.Line(str(b))
	}
}
