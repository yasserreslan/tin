package main

// A method taking this file's Item does not satisfy a shape that wants shapepkg.Item:
// the two signatures are resolved in their own files and compared.
import "./shapepkg"

shape PutItem { Put(v shapepkg.Item) i64 }

type Item struct { N i64 }

type Holder struct { N i64 }

func (h Holder) Put(v Item) i64 {
	return v.N
}

func Use[P PutItem](p P) i64 {
	return 0
}

func main() {
	let h = Holder{N: 1}
	Use(h)
}
