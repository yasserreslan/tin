package main

import "io"

// A dyn conversion that the checker accepts; generating the two-word value is the next
// step, so the back ends refuse it with a message naming the step.
type Buf struct { n i64 }

func (b Buf) Write(data []u8) !i64 {
	return len(data)
}

func Emit(w dyn io.Writer) i64 {
	return 0
}

func main() {
	let b = Buf{n: 1}
	Emit(b)
}
