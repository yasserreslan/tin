fn show(name str, f fn() str) {
	let v = guard {
		f()
	} catch err {
		if fault.Is(err, fault.Panic) {
			say.Line(name, "panic")
		} else {
			say.Line(name, "fault", err)
		}
		return
	}
	say.Line(name, "=", v)
}

// nan is 0/0 computed at run time.
fn nan() f64 {
	let z = f64(len(floats) - len(floats))
	return z / z
}

// The conversion cases' floats, read at run time so no conversion is folded.
let floats = []f64{0.5, -0.5, -1.0, 1e30, -1e30, 127.0, -128.0, 127.75, -128.75, 0.5, -0.5, -1.0, 1e30, -1e30, 32767.0, -32768.0, 32767.75, -32768.75, 0.5, -0.5, -1.0, 1e30, -1e30, 2147483647.0, -2147483648.0, 2147483647.75, -2147483648.75, 0.5, -0.5, -1.0, 1e30, -1e30, 9223372036854775807.0, -9223372036854775808.0, 1e3, -1e3, 0.5, -0.5, -1.0, 1e30, -1e30, 255.0, 0.0, 255.75, 0.75, 0.5, -0.5, -1.0, 1e30, -1e30, 65535.0, 0.0, 65535.75, 0.75, 0.5, -0.5, -1.0, 1e30, -1e30, 4294967295.0, 0.0, 4294967295.75, 0.75, 0.5, -0.5, -1.0, 1e30, -1e30, 18446744073709551615.0, 0.0, 1e3, -1e3}

fn main() {
	show("i8 -128 + 1", fn() str { return say.Str(op_i8(i8(-128), i8(1), 0)) })
	show("i8 -128 - 1", fn() str { return say.Str(op_i8(i8(-128), i8(1), 1)) })
	show("i8 -128 * 1", fn() str { return say.Str(op_i8(i8(-128), i8(1), 2)) })
	show("i8 -128 / 1", fn() str { return say.Str(op_i8(i8(-128), i8(1), 3)) })
	show("i8 neg -128", fn() str { return say.Str(op_i8(i8(-128), i8(1), 4)) })
	show("i8 -128 +% 1", fn() str { return say.Str(op_i8(i8(-128), i8(1), 5)) })
	show("i8 -128 -% 1", fn() str { return say.Str(op_i8(i8(-128), i8(1), 6)) })
	show("i8 -128 *% 1", fn() str { return say.Str(op_i8(i8(-128), i8(1), 7)) })
	show("i8 -128 % 1", fn() str { return say.Str(op_i8(i8(-128), i8(1), 8)) })
	show("i8 -128 + 2", fn() str { return say.Str(op_i8(i8(-128), i8(2), 0)) })
	show("i8 -128 - 2", fn() str { return say.Str(op_i8(i8(-128), i8(2), 1)) })
