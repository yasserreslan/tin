package main

// Integer overflow policy (#362): + - * and negation panic when the result does not fit the
// type, signed / panics on the most negative value / -1, +% -% *% wrap, shift counts must be
// below the width, and float to integer conversions panic out of range. Every width at its
// boundaries, through registers and through constant operands. Generated once by a script
// that computes the expected results independently; the panics print to stderr.

import "fault"
import "say"

fn op_i8(a i8, b i8, op i64) i8 {
	return match op {
		0 => a + b
		1 => a - b
		2 => a * b
		3 => a / b
		4 => -a
		5 => a +% b
		6 => a -% b
		7 => a *% b
		_ => a % b
	}
}

fn k_i8(a i8, op i64) i8 {
	return match op {
		0 => a + 1
		1 => a - 1
		2 => a * 2
		3 => a * 3
		4 => a + 100
		5 => a - 100
		6 => a * 100
		7 => a +% 1
		8 => a -% 1
		_ => a *% 3
	}
}

fn sh_i8(a i8, n i64, left bool) i8 {
	if left {
		return a << n
	}
	return a >> n
}

