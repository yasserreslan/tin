# bits.Mul64 is the __mulhu intrinsic: the high word in one instruction, with no call (#474).
# A function with two results is not inlined, so the check reads Mul64's own body.

[arm64]
CHECK: _bits.Mul64:
CHECK-NOT: \tbl\s
CHECK: umulh x[0-9]+, x[0-9]+, x[0-9]+

[amd64]
CHECK: # L(\d+): bits\.Mul64\n[\s\S]*?\nL\1:\n(?:(?!call|\nL\d+:\n)[\s\S])*?\nmul r
