package main

// mut is for structs, slices and maps: a callee modifies their contents through the parameter. A
// value type (a number, a bool, a str, a fault) is passed by value, so mut on it would silently do
// nothing, and the compiler says so instead. ok shows what mut is for; gen shows that a generic
// function is checked at each instantiation.

type Box struct {
	n i64
}

func bump(n mut i64) {
	n++
}

func scale(x mut f64, by f64) {
	x = x * by
}

func rename(s mut str) {
	s = "x"
}

func flip(b mut bool) {
	b = !b
}

func ok(b mut Box, xs mut []i64, m mut map[str]i64) {
	b.n++
	xs[0] = 1
	m["a"] = 1
}

func gen[T any](x mut T) {
}

func main() {
	gen(mut Box{n: 1})
	v := 1
	gen(mut v)
}
