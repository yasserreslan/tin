package main

import "say"
import "glyph"

const big = 0xffffffffffffffff
const half = big >> 1
const k11 = big >> 11

fn main() {
	let ss = make([]str, 3)
	ss[1] = "b"
	say.Line(len(ss[0]), ss[0] == "", ss)
	let grid = make([][]i64, 2)
	grid[1] = append(grid[1], 7)
	say.Line(len(grid[0]), grid[1])
	let v u64 = big
	let a = u64(0xffffffffffffffff) >> 11
	say.Line(a, v>>11, u64(k11), u64(half), u64(big)/10, big > 1)
	let x u8 = 200
	let y = u8(100) + u8(100)
	say.Line(x+%100, y)
	let r i32 = 0xfffd
	say.Line(r == glyph.RuneError)
}
