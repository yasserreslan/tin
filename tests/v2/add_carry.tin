package main

import "say"

// An add's carry (#488): `s = x + y` followed by `h = k + lt(s, y)` compiles to add and adc on
// x86-64 (adds and cinc on arm64). Each form below is checked against the carry computed from
// 32-bit halves, over pseudo-random words and their edge values, with enough live locals that
// some of them live in frame slots.

@wrap fn lt(a u64, b u64) u64 {
	return u64(i64(a < b))
}

// carry is the carry out of x + y, from 32-bit halves.
@wrap fn carry(x u64, y u64) u64 {
	let low = (x & 0xffffffff) + (y & 0xffffffff)
	return ((x >> 32) + (y >> 32) + (low >> 32)) >> 32
}

@wrap fn next(v u64) u64 {
	mut x = v
	x ^= x << 13
	x ^= x >> 7
	x ^= x << 17
	return x
}

@wrap fn forms(x u64, y u64, h0 u64, k0 u64) i64 {
	mut bad = 0
	// s += y; h += lt(s, y)
	mut s = x
	mut h = h0
	s += y
	h += lt(s, y)
	if s != x+y || h != h0+carry(x, y) {
		bad += 1
	}
	// s = x + y; h = k + lt(s, x): the carry against the other addend, into another local
	let s2 = x + y
	let h2 = k0 + lt(s2, x)
	if s2 != x+y || h2 != k0+carry(x, y) {
		bad += 1
	}
	// the carry first: h = lt(s, y) + h
	mut s3 = x
	mut h3 = h0
	s3 = s3 + y
	h3 = lt(s3, y) + h3
	if s3 != x+y || h3 != h0+carry(x, y) {
		bad += 1
	}
	// h is an addend: s = h + y; h = h + lt(s, y)
	mut h4 = x
	let s4 = h4 + y
	h4 = h4 + lt(s4, y)
	if s4 != x+y || h4 != x+carry(x, y) {
		bad += 1
	}
	// k is the sum itself: h = s + lt(s, y)
	let s5 = x + y
	let h5 = s5 + lt(s5, y)
	if h5 != x+y+carry(x, y) {
		bad += 1
	}
	// doubling: s = x + x
	let s6 = x + x
	let h6 = h0 + lt(s6, x)
	if s6 != x+x || h6 != h0+carry(x, x) {
		bad += 1
	}
	// a constant addend
	let s7 = x + 0x7fffffff
	let h7 = k0 + lt(s7, 0x7fffffff)
	if s7 != x+0x7fffffff || h7 != k0+carry(x, 0x7fffffff) {
		bad += 1
	}
	let s8 = y + 0xfffffffffffffff0
	let h8 = h0 + lt(s8, 0xfffffffffffffff0)
	if s8 != y+0xfffffffffffffff0 || h8 != h0+carry(y, 0xfffffffffffffff0) {
		bad += 1
	}
	// a chain, as Montgomery multiplication has it: two carries into one high word
	mut lo = x
	mut hi = h0
	lo += y
	hi += lt(lo, y)
	lo += k0
	hi += lt(lo, k0)
	let want = h0 + carry(x, y) + carry(x+y, k0)
	if lo != x+y+k0 || hi != want {
		bad += 1
	}
	// the compare with the sum itself is no carry and must stay a compare (always 0)
	let s9 = x + y
	let h9 = h0 + lt(s9, s9)
	if h9 != h0 {
		bad += 1
	}
	return bad
}

fn main() {
	let edges = []u64{0, 1, 2, 0x7fffffff, 0x80000000, 0xffffffff, 0x100000000, 0x7fffffffffffffff, 0x8000000000000000, 0xfffffffffffffffe, 0xffffffffffffffff}
	mut bad = 0
	mut n = 0
	for x in edges {
		for y in edges {
			bad += forms(x, y, 0xfffffffffffffffe, 5)
			bad += forms(x, y, 7, 0xffffffffffffffff)
			n += 2
		}
	}
	mut v = u64(0x9e3779b97f4a7c15)
	for i in 0..20000 {
		let a = next(v)
		let b = next(a)
		let c = next(b)
		v = next(c)
		bad += forms(a, b, c, v)
		n += 1
	}
	say.Line(n, "cases,", bad, "wrong")
}
