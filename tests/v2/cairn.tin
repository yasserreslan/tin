package main

import "say"
import "cairn"
import "sift"

// lcg advances a 64-bit linear congruential generator.
fn lcg(k i64) i64 {
	return k*%6364136223846793005 +% 1442695040888963407
}

fn main() {
	let h = cairn.NewIntHeap(4)
	mut (v, ok) = h.Pop()
	say.Line("heap pop empty", v, ok, h.Len())
	v, ok = h.Peek()
	say.Line("heap peek empty", v, ok)
	let in = []i64{5, 3, 8, 1, 9, 2, 7, 3, -4, 9223372036854775807, -9223372036854775807 - 1, 0}
	for _, x in in {
		h.Push(x)
	}
	v, ok = h.Peek()
	say.Line("heap peek", v, ok, h.Len())
	mut out = make([]i64, 0, 12)
	for h.Len() > 0 {
		v, ok = h.Pop()
		out = append(out, v)
	}
	say.Line("heap drain", out, sift.IsSortedInts(out), h.Len())
	h.Push(10)
	h.Push(4)
	v, ok = h.Pop()
	h.Push(1)
	mut (v2, ok2) = h.Pop()
	mut (v3, ok3) = h.Pop()
	mut (v4, ok4) = h.Pop()
	say.Line("heap interleave", v, ok, v2, ok2, v3, ok3, v4, ok4, h.Len())
	let hz = cairn.IntHeap{}
	mut k = i64(1)
	for i in 0..1000 {
		k = lcg(k)
		hz.Push((k >> 30) % 1000)
	}
	mut prev = i64(-9223372036854775807 - 1)
	mut okAll = true
	mut cs = i64(0)
	for hz.Len() > 0 {
		v, ok = hz.Pop()
		if v < prev {
			okAll = false
		}
		prev = v
		cs = cs*%31 +% v
	}
	say.Line("heap stress", okAll, cs, hz.Len())

	let m = cairn.NewIntMaxHeap(0)
	v, ok = m.Pop()
	say.Line("maxheap pop empty", v, ok, m.Len())
	for _, x in in {
		m.Push(x)
	}
	v, ok = m.Peek()
	say.Line("maxheap peek", v, ok, m.Len())
	out = out[0:0]
	for m.Len() > 0 {
		v, ok = m.Pop()
		out = append(out, v)
	}
	say.Line("maxheap drain", out, m.Len())
	let mz = cairn.IntMaxHeap{}
	k = 2
	for i in 0..1000 {
		k = lcg(k)
		mz.Push((k >> 30) % 1000)
	}
	prev = 9223372036854775807
	okAll = true
	cs = 0
	for mz.Len() > 0 {
		v, ok = mz.Pop()
		if v > prev {
			okAll = false
		}
		prev = v
		cs = cs*%31 +% v
	}
	say.Line("maxheap stress", okAll, cs)

	let d = cairn.NewIntDeque(2)
	v, ok = d.PopFront()
	v2, ok2 = d.PopBack()
	v3, ok3 = d.Front()
	v4, ok4 = d.Back()
	say.Line("deque empty", v, ok, v2, ok2, v3, ok3, v4, ok4, d.Len())
	d.PushBack(1)
	d.PushBack(2)
	d.PushFront(0)
	d.PushFront(-1)
	d.PushBack(3)
	say.Line("deque at", d.Len(), d.At(0), d.At(1), d.At(2), d.At(3), d.At(4))
	v, ok = d.Front()
	v2, ok2 = d.Back()
	say.Line("deque ends", v, ok, v2, ok2)
	v, ok = d.PopFront()
	v2, ok2 = d.PopBack()
	say.Line("deque pops", v, ok, v2, ok2, d.Len(), d.At(0), d.At(2))
	let dz = cairn.IntDeque{}
	for i in 0..100 {
		dz.PushBack(i)
	}
	for i in 0..1000 {
		let (x, xok) = dz.PopFront()
		if xok {
			dz.PushBack(x)
		}
	}
	say.Line("deque rotate", dz.Len(), dz.At(0), dz.At(50), dz.At(99))
	for i in 0..100 {
		dz.PushFront(-i)
	}
	say.Line("deque front", dz.Len(), dz.At(0), dz.At(99), dz.At(100), dz.At(199))
	mut sum = i64(0)
	mut cnt = i64(0)
	for dz.Len() > 0 {
		let (x, xok) = dz.PopBack()
		if xok {
			sum += x
			cnt += 1
		}
	}
	say.Line("deque drain", cnt, sum, dz.Len())
	dz.PushFront(7)
	say.Line("deque reuse", dz.Len(), dz.At(0))

	let q = cairn.NewIntQueue(1)
	v, ok = q.Pop()
	v2, ok2 = q.Peek()
	say.Line("queue empty", v, ok, v2, ok2, q.Len())
	for i in 0..10 {
		q.Push(i * i)
	}
	v, ok = q.Peek()
	say.Line("queue peek", v, ok, q.Len())
	v, ok = q.Pop()
	v2, ok2 = q.Pop()
	q.Push(100)
	say.Line("queue pops", v, ok, v2, ok2, q.Len())
	mut outq = make([]i64, 0)
	for q.Len() > 0 {
		let (x, xok) = q.Pop()
		if xok {
			outq = append(outq, x)
		}
	}
	say.Line("queue drain", outq)
	let qz = cairn.IntQueue{}
	sum = 0
	for i in 0..1000 {
		qz.Push(i)
		if i%3 == 0 {
			let (x, xok) = qz.Pop()
			if xok {
				sum += x
			}
		}
	}
	v, ok = qz.Peek()
	say.Line("queue stress", qz.Len(), sum, v, ok)

	let s = cairn.NewIntSet(4)
	say.Line("set add", s.Add(5), s.Add(5), s.Add(-7), s.Add(0), s.Add(9223372036854775807), s.Len())
	say.Line("set has", s.Has(5), s.Has(6), s.Has(-7), s.Has(0), s.Has(9223372036854775807), s.Has(-9223372036854775807-1))
	say.Line("set del", s.Del(5), s.Del(5), s.Has(5), s.Len())
	say.Line("set readd", s.Add(5), s.Len())
	let keys = s.Keys()
	sift.Ints(mut keys)
	say.Line("set keys", keys)
	let sz = cairn.IntSet{}
	mut ref = make([]i64, 0)
	k = 3
	for i in 0..2000 {
		k = lcg(k)
		let x = (k >> 30) % 1500
		sz.Add(x)
		ref = append(ref, x)
	}
	sift.Ints(mut ref)
	let nref = sift.UniqInts(mut ref)
	ref = ref[0:nref]
	say.Line("set stress len", sz.Len(), nref)
	mut del = 0
	mut exp = make([]i64, 0)
	for _, x in ref {
		if x%3 == 0 {
			if sz.Del(x) {
				del += 1
			}
		} else {
			exp = append(exp, x)
		}
	}
	let keys2 = sz.Keys()
	sift.Ints(mut keys2)
	say.Line("set stress del", del, sz.Len(), sift.EqualInts(keys2, exp))
	mut hit = 0
	{
		mut x = -1500
		for x <= 1500 {
			if sz.Has(x) {
				hit += 1
			}
			x += 1
		}
	}
	say.Line("set stress has", hit)
	for i in 0..3000 {
		sz.Add(i + 10000)
	}
	say.Line("set stress grow", sz.Len(), sz.Has(10000), sz.Has(12999), sz.Has(13000), sz.Has(exp[0]))
	let z = cairn.IntSet{}
	say.Line("set zero", z.Has(1), z.Del(1), z.Len(), len(z.Keys()), z.Add(1), z.Has(1), z.Len())

	let ss = cairn.NewStrSet()
	say.Line("strset add", ss.Add("a"), ss.Add("b"), ss.Add("a"), ss.Add(""), ss.Len())
	say.Line("strset has", ss.Has("a"), ss.Has("c"), ss.Has(""), ss.Del("a"), ss.Del("a"), ss.Has("a"), ss.Len())
	mut sk = ss.Keys()
	sift.Strs(mut sk)
	say.Line("strset keys", sk)
	let zs = cairn.NewStrSet()
	say.Line("strset zero", zs.Has("x"), zs.Len(), zs.Del("x"), len(zs.Keys()), zs.Add("x"), zs.Has("x"), zs.Len())
	k = 5
	for i in 0..500 {
		k = lcg(k)
		zs.Add(say.Fmt("k%d", (k>>35)%300))
	}
	sk = zs.Keys()
	sift.Strs(mut sk)
	say.Line("strset stress", zs.Len(), sk[0], sk[len(sk)-1], zs.Has("x"))

	let bs = cairn.NewBitset(10)
	say.Line("bitset init", bs.Len(), bs.Count(), bs.Has(0), bs.Has(9), bs.Has(64), bs.Has(-1), bs.Next(0))
	bs.Set(0)
	bs.Set(9)
	bs.Set(63)
	bs.Set(64)
	bs.Set(200)
	say.Line("bitset set", bs.Len(), bs.Count(), bs.Has(0), bs.Has(9), bs.Has(63), bs.Has(64), bs.Has(65), bs.Has(200), bs.Has(201))
	say.Line("bitset next", bs.Next(0), bs.Next(1), bs.Next(9), bs.Next(10), bs.Next(63), bs.Next(64), bs.Next(65), bs.Next(200), bs.Next(201), bs.Next(-5), bs.Next(1000))
	bs.Clear(9)
	bs.Clear(64)
	bs.Clear(5000)
	bs.Clear(-1)
	say.Line("bitset clear", bs.Count(), bs.Has(9), bs.Has(64), bs.Next(1), bs.Next(64), bs.Len())
	mut all = make([]i64, 0)
	{
		mut i = bs.Next(0)
		for i >= 0 {
			all = append(all, i)
			i = bs.Next(i + 1)
		}
	}
	say.Line("bitset iter", all)
	let bz = cairn.Bitset{}
	for i in (0..1000).step(7) {
		bz.Set(i)
	}
	cnt = 0
	{
		mut i = bz.Next(0)
		for i >= 0 {
			cnt += 1
			i = bz.Next(i + 1)
		}
	}
	let w = bz.Words()
	say.Line("bitset dense", bz.Count(), cnt, bz.Len(), bz.Next(995), bz.Next(1000), len(w), w[0])

	let c = cairn.NewLRU(2)
	mut (gv, gok) = c.Get("a")
	say.Line("lru empty", say.Fmt("%q", gv), gok, c.Len(), c.Cap(), len(c.Keys()))
	c.Put("a", "1")
	c.Put("b", "2")
	gv, gok = c.Get("a")
	c.Put("c", "3")
	mut (gv2, gok2) = c.Get("b")
	say.Line("lru evict", gv, gok, say.Fmt("%q", gv2), gok2, c.Len(), c.Keys())
	c.Put("a", "11")
	gv, gok = c.Peek("c")
	gv2, gok2 = c.Peek("a")
	say.Line("lru update", c.Keys(), gv, gok, gv2, gok2, c.Has("a"), c.Has("b"))
	say.Line("lru del", c.Del("c"), c.Del("c"), c.Len(), c.Keys())
	c.Put("d", "4")
	c.Put("e", "5")
	say.Line("lru refill", c.Keys(), c.Has("a"), c.Len())
	gv, gok = c.Get("d")
	say.Line("lru get", gv, gok, c.Keys())
	let c1 = cairn.NewLRU(1)
	c1.Put("x", "1")
	c1.Put("y", "2")
	gv, gok = c1.Get("y")
	say.Line("lru one", c1.Keys(), c1.Has("x"), c1.Len(), gv, gok)
	let c0 = cairn.NewLRU(0)
	c0.Put("only", "v")
	c0.Put("only", "w")
	gv, gok = c0.Get("only")
	say.Line("lru zero cap", c0.Cap(), c0.Len(), gv, gok)
	let cl = cairn.NewLRU(100)
	k = 17
	mut hits = 0
	for i in 0..1000 {
		k = lcg(k)
		let key = say.Fmt("k%d", (k>>33)%150)
		if i%3 == 0 {
			let (_, hok) = cl.Get(key)
			if hok {
				hits += 1
			}
		} else if i%7 == 0 {
			cl.Del(key)
		} else {
			cl.Put(key, say.Fmt("v%d", i))
		}
	}
	say.Line("lru stress", cl.Len(), hits, cl.Keys())
	let lk = cl.Keys()
	gv, gok = cl.Peek(lk[0])
	gv2, gok2 = cl.Peek(lk[len(lk)-1])
	say.Line("lru stress peek", gv, gok, gv2, gok2)
}
