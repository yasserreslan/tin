package main

import "say"
import "bits"
import "gauge"

// r prints a transcendental result to 12 significant digits: libms differ in the last bit.
func r(x f64) str {
	return say.Fmt("%.12g", x)
}

func main() {
	say.Line("consts", gauge.Pi, gauge.E, gauge.Sqrt2, gauge.Ln2, gauge.MaxI64, gauge.MinI64, gauge.MaxU64, gauge.MaxF64, gauge.SmallestNonzeroF64)
	xs := []f64{0, -0.5, 2, 2.5, -2.5, 3.7, -3.7, 1e300, 0.1}
	for _, x := range xs {
		say.Line("x", x, gauge.Abs(x), gauge.Floor(x), gauge.Ceil(x), gauge.Trunc(x), gauge.Round(x), gauge.RoundToEven(x), gauge.Signbit(x))
	}
	pos := []f64{0.5, 1, 2, 10, 1e-3, 123.456}
	for _, x := range pos {
		say.Line("p", x, gauge.Sqrt(x), r(gauge.Cbrt(x)), r(gauge.Exp(x)), r(gauge.Exp2(x)), r(gauge.Log(x)), r(gauge.Log2(x)), r(gauge.Log10(x)), r(gauge.Log1p(x)))
		say.Line("t", x, r(gauge.Sin(x)), r(gauge.Cos(x)), r(gauge.Tan(x)), r(gauge.Atan(x)), r(gauge.Sinh(x)), r(gauge.Cosh(x)), r(gauge.Tanh(x)))
	}
	say.Line("inv", r(gauge.Asin(0.5)), r(gauge.Acos(0.5)), r(gauge.Atan2(1, -1)), r(gauge.Atan2(-1, -1)), gauge.Hypot(3, 4), gauge.Mod(7.5, 2), gauge.Mod(-7.5, 2), gauge.Pow(2, 10), r(gauge.Pow(2, 0.5)), gauge.Pow10(3), gauge.Pow10(-2))
	say.Line("minmax", gauge.Min(1, 2), gauge.Max(1, 2), gauge.Min(gauge.NaN(), 1), gauge.Max(gauge.Inf(1), 3), gauge.Min(-0.0, 0), gauge.MinI(3, -4), gauge.MaxI(3, -4), gauge.AbsI(-9), gauge.Clamp(5, 0, 1), gauge.ClampI(-5, 0, 10))
	say.Line("special", gauge.IsNaN(gauge.NaN()), gauge.IsInf(gauge.Inf(-1), -1), gauge.IsInf(gauge.Inf(1), 0), gauge.IsInf(1, 0), gauge.Copysign(3, -1), gauge.Inf(1), gauge.Inf(-1), gauge.Sqrt(-1))
	say.Line("bits", gauge.F64bits(1.5), gauge.F64frombits(4609434218613702656), gauge.F64bits(-0.0))
	say.Line("int", gauge.Gcd(48, 18), gauge.Gcd(-48, 18), gauge.Gcd(0, 5), gauge.Lcm(4, 6), bits.PopCount64(255), bits.PopCount64(18446744073709551615), bits.LeadingZeros64(1), bits.LeadingZeros64(0), bits.TrailingZeros64(8), bits.TrailingZeros64(0))
}
