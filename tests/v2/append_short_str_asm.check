# Short appends copy with one load and one store of the right width, not memcpy. The address may
# carry a constant offset (folded into the load or store since #488).
[arm64]
CHECK: _main.main:
CHECK: cmp x[0-9]+, #1
CHECK: ldrb w[0-9]+, \[x[0-9]+(?:, #[0-9]+)?\]
CHECK: strb w[0-9]+, \[x[0-9]+(?:, #[0-9]+)?\]
CHECK: cmp x[0-9]+, #2
CHECK: ldrh w[0-9]+, \[x[0-9]+(?:, #[0-9]+)?\]
CHECK: strh w[0-9]+, \[x[0-9]+(?:, #[0-9]+)?\]
CHECK: cmp x[0-9]+, #6
CHECK: ldr w[0-9]+, \[x[0-9]+(?:, #[0-9]+)?\]
CHECK: str w[0-9]+, \[x[0-9]+(?:, #[0-9]+)?\]
CHECK: ldrh w[0-9]+, \[x[0-9]+(?:, #[0-9]+)?\]
CHECK: strh w[0-9]+, \[x[0-9]+(?:, #[0-9]+)?\]
CHECK: _memcpy

[amd64]
CHECK: (?m)^L1:$
CHECK: cmp r[a-z0-9]+,0x1
CHECK: movzx [a-z0-9]+,BYTE PTR \[r[a-z0-9]+(?:\+0x[0-9a-f]+)?\]
CHECK: mov BYTE PTR \[r[a-z0-9]+(?:\+0x[0-9a-f]+)?\],(?:r[0-9]+b|[a-z]+l)
CHECK: cmp r[a-z0-9]+,0x2
CHECK: movzx [a-z0-9]+,WORD PTR \[r[a-z0-9]+(?:\+0x[0-9a-f]+)?\]
CHECK: mov WORD PTR \[r[a-z0-9]+(?:\+0x[0-9a-f]+)?\],[a-z0-9]+
CHECK: cmp r[a-z0-9]+,0x6
CHECK: mov [a-z0-9]+,DWORD PTR \[r[a-z0-9]+(?:\+0x[0-9a-f]+)?\]
CHECK: mov DWORD PTR \[r[a-z0-9]+(?:\+0x[0-9a-f]+)?\],[a-z0-9]+
CHECK: movzx [a-z0-9]+,WORD PTR \[r[a-z0-9]+(?:\+0x[0-9a-f]+)?\]
CHECK: mov WORD PTR \[r[a-z0-9]+(?:\+0x[0-9a-f]+)?\],[a-z0-9]+
CHECK: # memcpy
