// Package shapepkg holds shapes and types that satisfy them, used from another package
// by tests/v2/shapes_import.tin: a shape name and a shape method's types must resolve in
// the file that declares them, not in the importing file.
package shapepkg

type Item struct { N i64 }

shape Reader { Read(buf mut []u8) !i64 }

shape Writer { Write(data []u8) !i64 }

shape ReadWriter {
	Reader
	Writer
}

type Counter struct { N i64 }

func (c mut Counter) Read(buf mut []u8) !i64 {
	c.N = c.N + 1
	return c.N
}

func (c Counter) Write(data []u8) !i64 {
	return len(data)
}

// Box's method takes a package-local type, so the candidate's signature must be
// resolved in this package even when the shape is declared elsewhere.
type Box[T any] struct { V T }

func (b Box[T]) Put(v Item) i64 {
	return v.N
}

// Both is a package-local type whose name can match a shape in the importing program: a
// union here must resolve this type, not the caller's shape of the same name.
type Both struct { N i64 }

shape Named = Both | i64

func Pick[X Named](x X) i64 {
	return 0
}
