package main

import "say"
import "seal"

// seal's Montgomery multiplication (#488), reached through P-256 ECDH: the checks read m4_mul.
fn main() {
	let pub = seal.P256PublicKey(seal.Sha256("b")) catch _ {
		[]u8{}
	}
	let s = seal.P256ECDH(seal.Sha256("a"), pub) catch _ {
		[]u8{}
	}
	say.Line(len(s))
}
