func sweepToUpper() {
	h := seed
	n := 0
	for r := 0; r <= 0x10ffff; r++ {
		m := glyph.ToUpper(i32(r))
		if i64(m) != r {
			n++
		}
		h = mix(h, u64(m))
	}
	say.Line("ToUpper", n, h)
}

