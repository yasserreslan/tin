package main

import "say"
import "glyph"
import "mint"

func mix(h u64, v u64) u64 {
	return (h ^ v) * 1099511628211
}

const seed u64 = 14695981039346656037

func table(name str, t glyph.Table) {
	h := seed
	n := 0
	for r := 0; r < 205744; r++ {
		if glyph.Is(t, i32(r)) {
			n++
			h = mix(h, u64(r))
		}
	}
	say.Line("table", name, n, h)
}

func sweepIsLetter() {
	h := seed
	n := 0
	for r := 0; r <= 0x10ffff; r++ {
		if glyph.IsLetter(i32(r)) {
			n++
			h = mix(h, u64(r))
		}
	}
	say.Line("IsLetter", n, h)
}

