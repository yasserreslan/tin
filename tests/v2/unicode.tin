		h = mix(h, u64(m))
	}
	say.Line("SimpleFold", n, h)
}

func sweepQuote() {
	h := seed
	h2 := seed
	n := 0
	for r := 0; r <= 0x10ffff; r++ {
		if r >= 0xd800 && r <= 0xdfff {
			continue
		}
		q := mint.Quote(str(i32(r)))
		if len(q) > 3 && q[1] == '\\' {
			n++
		}
		for i := 0; i < len(q); i++ {
			h = mix(h, u64(q[i]))
		}
		f := say.Fmt("%q", str(i32(r)))
		for i := 0; i < len(f); i++ {
			h2 = mix(h2, u64(f[i]))
		}
	}
	say.Line("quote", n, h, h2)
}

func main() {
	say.Line("version", glyph.UnicodeVersion)
	sweepQuote()
	sweepIsLetter()
	sweepIsDigit()
	sweepIsNumber()
	sweepIsSpace()
	sweepIsUpper()
	sweepIsLower()
	sweepIsTitle()
	sweepIsMark()
	sweepIsPunct()
	sweepIsSymbol()
	sweepIsControl()
	sweepIsGraphic()
	sweepIsPrint()
	sweepToUpper()
	sweepToLower()
	sweepToTitle()
	sweepSimpleFold()
	say.Line("edge", glyph.IsLetter(-1), glyph.IsSpace(-1), glyph.IsPrint(0x110000), glyph.ToUpper(0x110000), glyph.ToLower(-5), glyph.SimpleFold(-5), glyph.SimpleFold(0x110000), glyph.To(7, 65), glyph.To(-1, 65), glyph.IsControl(-3))
	say.Line("orbit", glyph.SimpleFold(75), glyph.SimpleFold(107), glyph.SimpleFold(0x212a), glyph.SimpleFold(0x1e9e), glyph.SimpleFold(0xdf), glyph.SimpleFold(0x3a3), glyph.SimpleFold(0x3c2), glyph.SimpleFold(0x3c3))
	say.Line("oneof", glyph.IsOneOf([]glyph.Table{glyph.Table.Han, glyph.Table.Latin}, 0x4e16), glyph.IsOneOf([]glyph.Table{glyph.Table.Han, glyph.Table.Latin}, 0x639), glyph.IsOneOf([]glyph.Table{}, 65))
