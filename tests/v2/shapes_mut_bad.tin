package main

// A generic body that calls a mut-receiver method must declare its parameter mut.
shape Reader { Read(buf mut []u8) !i64 }

type Cursor struct { pos i64 }

func (c mut Cursor) Read(buf mut []u8) !i64 {
	c.pos = c.pos + 1
	return c.pos
}

func Use[R Reader](r R) i64 {
	let buf = make([]u8, 4)
	n := r.Read(mut buf) catch _ { 0 }
	return n
}

func main() {
	let c = Cursor{pos: 0}
	Use(c)
}
