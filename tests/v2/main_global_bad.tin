package main

import "anvil"
import "say"

type Config struct {
	name  str
	size i64
}

mut table []str
mut cfg Config = Config{name: "", size: 0}
mut hits i64
mut names []str
mut index map[str]i64 = make(map[str]i64)
mut grid [4]i64
mut first str
mut second str
mut handled i64
mut ready bool
mut onlyMain i64

fn pair() (str, str) {
	return "a", "b"
}

// load is called by main: what it assigns reaches core 0 only.
fn load() {
	cfg.size = 10
	names = append(names, "x")
	index["k"] = 1
	grid[2] = 7
	first, second = pair()
}

fn handler(q anvil.Req, w mut anvil.Out) {
	handled += 1 // this core's own copy, assigned by the core that runs it: fine
	w.Text("{len(table)} {cfg.size} {hits} {len(names)} {len(index)} {grid[2]} {first}{second} {handled} {ready}")
}

// ok: runs on every core, before it serves
on core.start {
	ready = true
}

fn main() {
	table = keep(make([]str, 3))
	hits += 1
	load()
	onlyMain = 5 // read only by main: nothing else sees it
	say.Line(onlyMain)
	say.Line(anvil.Serve(":9406", handler))
}
