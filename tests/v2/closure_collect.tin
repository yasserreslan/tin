package main

import "say"
import "sift"

// A closure passed to sift.Each lives no longer than this frame, so it may append request
// memory to a captured local (#181).
func main() {
	xs := []i64{3, 1, 2}
	out := []str{}
	sift.Each(xs, func(x i64) { out = append(out, say.Str(x)) })
	say.Line("collected", out)
	seen := make(map[str]i64)
	sift.Each(xs, func(x i64) { seen["k{x}"] = x })
	say.Line("map", len(seen), seen["k2"])
	last := "none"
	sift.Each(xs, func(x i64) { last = "item {x}" })
	say.Line("last", last)
	sorted := sift.Map(xs, func(x i64) str { return say.Str(x * 10) })
	say.Line("mapped", sorted)
}
