package main

// Shapes across packages (#141): a shape declared in another package, a shape composed
// from it, a generic function constrained by it, and a generic type from that package
// whose method takes a package-local type. Every name must resolve in its own file.

import "./shapepkg"
import "say"

// Composition with qualified names.
shape Both {
	shapepkg.Reader
	shapepkg.Writer
}

shape PutItem { Put(v shapepkg.Item) i64 }

func Drain[R shapepkg.Reader](r mut R) !i64 {
	let buf = make([]u8, 4)
	return try r.Read(mut buf)
}

// Both is satisfied by the package's Counter: Reader and Writer from one type.
func IsBoth[RW Both](rw RW) i64 {
	return 1
}

func Put[P PutItem](p P, it shapepkg.Item) i64 {
	return p.Put(it)
}

func main() {
	let c = shapepkg.Counter{N: 0}
	n := Drain(mut c) catch _ { -1 }
	say.Line("read: {n}")
	say.Line("both: {IsBoth(c)}")
	let b = shapepkg.Box[i64]{V: 1}
	say.Line("put: {Put(b, shapepkg.Item{N: 7})}")
	// The package's own Both type, not this file's Both shape.
	say.Line("pick: {shapepkg.Pick(3)}")
}
