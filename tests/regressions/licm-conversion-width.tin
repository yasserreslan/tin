package main

// Loop-invariant expressions that differ only in type must not share a hoisted temporary.
// @wrap (#362): u8 (1 << 7) * 3 wraps to 128 here, and nothing checked blocks the hoisting.
@wrap fn hoisted(x i64, y i64, s i64, n i64) {
	for i in 0..n {
		let lo = u8(x + 1)
		let wide = u16(x + 1)
		let un = u8(x * y)
		let sg = i8(x * y)
		// The untyped 1 takes each declaration's type: the trees match, the widths do not.
		let sb u8 = (1 << s) * 3
		let sw u16 = (1 << s) * 3
		println(lo, wide, un, sg, sb, sw)
	}
}

fn main() {
	hoisted(299, 3, 7, 1)
}
