package main

import "say"
import "mint"

// %q escapes what strconv.Quote escapes: bytes that are not valid UTF-8 as \xHH, the controls that
// have a short form (\a \b \f \v), and unprintable runes as \u or \U escapes. mint.Quote is the
// reference: every rune must agree between the two.
func main() {
	say.Line(say.Fmt("%q", "a\xe4\xb8b\xff"))
	say.Line(say.Fmt("%q", "\a\b\f\v\n\r\t\x00\x1b\x7f"))
	say.Line(say.Fmt("%q", "café \u00ad\u0085\u2028\xef\xbb\xbf 世界 \U0001f600 \U000e0001"))
	say.Line(say.Fmt("%q", "\xc0\x80 \xed\xa0\x80 \xf4\x90\x80\x80 \xe2\x82"))
	bad := 0
	for r := 0; r <= 0x10ffff; r++ {
		if r >= 0xd800 && r <= 0xdfff {
			continue
		}
		s := str(i32(r))
		if say.Fmt("%q", s) != mint.Quote(s) {
			bad++
		}
	}
	say.Line("rune mismatches:", bad)
}
