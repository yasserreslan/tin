package main

import "say"
import "twine"

// The trim functions and IndexRune compare runes, not bytes: an invalid byte is U+FFFD, and a stray
// byte of a multi-byte rune in the cutset does not match it. Expected output is Go's.
func main() {
	bad := "\xe4\xb8"
	say.Line(say.Fmt("%q", twine.Trim(bad, "\xe4\xb8\x96\xe7\x95\x8c")), say.Fmt("%q", twine.TrimRight(bad, "\xe4\xb8\x96\xe7\x95\x8c")), say.Fmt("%q", twine.TrimLeft(bad, "\xe4\xb8\x96\xe7\x95\x8c")))
	say.Line(say.Fmt("%q", twine.Trim(bad, "\xff")), say.Fmt("%q", twine.TrimRight(bad, "\xef\xbf\xbd")))
	say.Line(twine.LastIndexAny("a\xffb", "\xff"), twine.IndexAny("a\xffb", "\xfe"))
	say.Line(twine.IndexRune("a\xffb", 0xfffd), twine.IndexRune("ab", 0xfffd), twine.IndexRune("ab", 0xd800), twine.IndexRune("ab", 0x110000), twine.IndexRune("ab", -1))
	say.Line(twine.IndexRune("x\xef\xbf\xbdy", 0xfffd), twine.ContainsRune("\xff", 0xfffd))
}
