package main

func div(a i64, b i64) i64 { return a / b }
func rem(a i64, b i64) i64 { return a % b }
func udiv(a u64, b u64) u64 { return a / b }
func urem(a u64, b u64) u64 { return a % b }

func main() {
	d := div
	r := rem
	println(d(-7, 2), r(-7, 2), d(7, -2), r(7, -2))
	min := -9223372036854775807 - 1
	println(d(min, -1), r(min, -1))
	ud := udiv
	ur := urem
	var big u64 = 18446744073709551615
	println(ud(big, 3), ur(big, 10))
	x := -7
	println(x/4, x%4, x/3, x%3, x/-1)
	println(big/3, big%7, big/8, big%8)
	println(div(9, 3), rem(9, 4))
}
