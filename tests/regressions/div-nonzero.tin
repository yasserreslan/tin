package main

// div and rem keep the machine's arithmetic (@wrap, #362), so the most negative value / -1 is
// the wrapped result on both back ends (x86 idiv would trap); checked code panics there instead.
@wrap fn div(a i64, b i64) i64 { return a / b }
@wrap fn rem(a i64, b i64) i64 { return a % b }
fn udiv(a u64, b u64) u64 { return a / b }
fn urem(a u64, b u64) u64 { return a % b }

fn main() {
	let d = div
	let r = rem
	println(d(-7, 2), r(-7, 2), d(7, -2), r(7, -2))
	let min = -9223372036854775807 - 1
	println(d(min, -1), r(min, -1))
	let ud = udiv
	let ur = urem
	let big u64 = 18446744073709551615
	println(ud(big, 3), ur(big, 10))
	let x = -7
	println(x/4, x%4, x/3, x%3, x/-1)
	println(big/3, big%7, big/8, big%8)
	println(div(9, 3), rem(9, 4))
}
