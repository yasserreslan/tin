package main
import "hearth"
var ok i64
func core(id i64) {
    b := make([]u8, 10)
    b[0] = 1
    // The chunk the allocator really uses must be the one hearth reports.
    if hearth.PoolCapacity() == hearth.PoolChunk() { ok = 1 } else { ok = 0 }
    big := make([]u8, hearth.PoolChunk()/2+300000)
    big[len(big)-1] = 2
    hearth.Reset()
    if hearth.PoolCapacity() != hearth.PoolChunk() { ok = 0 }
    if id == 0 { println("ok", ok) }
}
func main() { hearth.Run(2, core) }
