package main
import "hearth"
import "say"
type Entry struct { Name str; Tags []str }
var saved []Entry
func retain() {
    e := Entry{Name: say.Fmt("saved-%d", 42), Tags: []str{say.Fmt("tag-%d", 7)}}
    saved = keep([]Entry{e})
}
func churn() {
    b := make([]u8, 1048576)
    for i := 0; i < len(b); i++ {
        if b[i] != 0 { panic("pool was not zeroed") }
        b[i] = 255
    }
    // Exercise large-block allocation/free as well as the reusable base chunk.
    big := make([]u8, 5242880)
    for i := 0; i < len(big); i += 4096 {
        if big[i] != 0 { panic("large block was not zeroed") }
        big[i] = 127
    }
    xs := make([]str, 1024)
    for _, x := range xs { if x != "" { panic("string zero value") } }
    rows := make([][]i64, 8)
    rows[0] = append(rows[0], 1)
    if len(rows[1]) != 0 { panic("nested slice headers alias") }
}
func main() {
    retain()
    hearth.Reset()
    for i := 0; i < 200; i++ { churn(); hearth.Reset() }
    println(saved[0].Name, saved[0].Tags[0])
}
