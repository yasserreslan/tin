package main

import "say"
import "hearth"

// #176: a sub-slice of a long-lived slice is a view. Growing it, or slicing it again,
// must not touch counts inside the parent's array.
var xs = []i64{1, 2, 3, 4}
var names = []str{"a", "b", "c", "d"}

func main() {
	for round := 0; round < 3; round++ {
		ys := xs[1:]
		ys = append(ys, 5)
		zs := ys[1:][1:]
		zs = append(zs, 6)
		ns := names[2:]
		ns = append(ns, keep("e"))
		hearth.Reset()
	}
	say.Line(xs[0], xs[1], xs[2], xs[3], len(xs))
	say.Line(names[0], names[1], names[2], names[3], len(names))
}
