package main

import "flume"
import "say"

func check(what str, err fault) {
	if err == nil {
		say.Line(what, "nil")
	} else {
		say.Line(what, "fault")
	}
}

func contents(path str) str {
	s, err := flume.ReadFile(path)
	if err != nil {
		return "unreadable"
	}
	return s
}

func main() {
	// A second Close must not close the descriptor the OS hands to the next file.
	w, err := flume.Create("/tmp/tin-test-flume-first")
	check("create first", err)
	check("close first", w.Close())
	v, err2 := flume.Create("/tmp/tin-test-flume-second")
	check("create second", err2)
	check("close first again", w.Close())
	v.Str("hello")
	check("close second", v.Close())
	say.Line("second holds", contents("/tmp/tin-test-flume-second"))

	// Writes after Close fail instead of reaching a reused descriptor.
	w.Str("late")
	check("flush closed", w.Flush())
	check("close closed", w.Close())
	say.Line("first holds", len(contents("/tmp/tin-test-flume-first")))

	// Failed opens carry no descriptor: with fd 0 reused by a file, closing them must leave it alone.
	stdin := flume.NewWriter(0)
	if stdin.Close() != nil {
		// fd 0 was already closed: the next open reuses it either way.
	}
	keep0, err3 := flume.Create("/tmp/tin-test-flume-fd0")
	check("create fd0", err3)
	bad, err4 := flume.Create("/tmp/tin-test-flume-missing/dir/file")
	check("create missing", err4)
	check("close missing", bad.Close())
	r, err5 := flume.Open("/tmp/tin-test-flume-missing/dir/file")
	check("open missing", err5)
	r.Close()
	keep0.Str("still open")
	check("close fd0", keep0.Close())
	say.Line("fd0 holds", contents("/tmp/tin-test-flume-fd0"))
}
