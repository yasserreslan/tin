package main

import "say"
import "seal"

func main() {
	// Every length from empty to several blocks agrees with the portable code.
	b := []u8{}
	bad := 0
	for n := 0; n <= 300; n++ {
		s := str(b)
		if seal.Hex(seal.Sha256(s)) != seal.Hex(seal.Sha256Soft(s)) {
			bad++
		}
		b = append(b, u8(n*7+3))
	}
	say.Line("mismatches", bad)
	say.Line(seal.Sha256Hex(""))
	say.Line(seal.Sha256Hex("abc"))
	say.Line(seal.Sha256Hex("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"))
	say.Line(seal.Sha256Hex("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"))
	say.Line(seal.Hex(seal.HmacSha256("Jefe", "what do ya want for nothing?")))
}
