package main
import "hearth"
var outer i64
var bad i64
func core(id i64) {
    // A core thread may be pinned to one CPU; Cores() must still report the program's CPUs.
    if hearth.Cores() != outer { bad = 1 }
    if id == 0 { println("same", bad == 0) }
}
func main() {
    outer = hearth.Cores()
    hearth.Run(outer, core)
}
