package main

import "say"

// An escape that produces a brace is text, not interpolation: "\x7b" is one byte and does not need
// {{ the way a typed brace does.
func main() {
	n := 7
	open := "\x7b"
	shut := "\u007d"
	say.Line(open, len(open), shut, len(shut))
	say.Line("a\x7b\x7bb\x7d\x7dc", len("a\x7b\x7bb\x7d\x7dc"))
	say.Line("{n}\x7d \x7b{n}", "{{typed}}")
	say.Line(say.Fmt("[%d\x7d", n), `raw {braces}`)
	b := []u8("\x7b\x7d")
	say.Line(b[0], b[1])
}
