package main
import "say"
type Box struct { Items []str; X i64 }
func put(b mut Box, s str) { b.Items = append(b.Items, s); b.X++ }
func twice(f func(mut Box, str), b mut Box) { f(mut b, "a"); f(mut b, say.Fmt("%d", 2)) }
func main() {
    f := put
    b := Box{Items: []str{}}
    f(mut b, "x")
    twice(put, mut b)
    println(len(b.Items), b.X, b.Items[2])
}
