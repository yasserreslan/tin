package main

import "say"

type Inner struct {
	a i64
	b str
}

type Color enum { Red, Green, Blue }

type Outer struct {
	n    i64
	in   Inner
	none ?Inner
	xs   []i64
	ins  []Inner
	m    map[str]i64
	ms   map[str]Inner
	c    Color
	f    f32
	u    u64
	s    str
	ok   bool
	fl   f64
}

type Node struct {
	v    i64
	kids []Node
}

type Tree struct {
	name str
	root Node
	tags map[str][]Node
}

type P struct {
	a i64
	b f64
}

func main() {
	o := Outer{n: 1, in: Inner{a: 2, b: "x"}, none: nil, xs: []i64{4, 5}, ins: []Inner{Inner{a: 6, b: "z"}, Inner{a: 7, b: "w"}},
		m: map[str]i64{"k": 7}, ms: map[str]Inner{"q": Inner{a: 8, b: "v"}}, c: Color.Green, f: 0.1, u: 18446744073709551615, s: "str", ok: true, fl: 2.5}
	say.Line(o)
	say.Line(say.Fmt("%+v", o))
	say.Line(o.in, o.ins)
	say.Line([]Inner{Inner{a: 1, b: "p"}, Inner{a: 2, b: "q"}}, []Inner{})

	// A type that holds itself through a slice, and a struct holding it.
	leaf1 := Node{v: 2, kids: []Node{}}
	leaf2 := Node{v: 3, kids: []Node{}}
	root := Node{v: 1, kids: []Node{leaf1, leaf2}}
	say.Line(root)
	say.Line(say.Fmt("%+v", root))
	t := Tree{name: "t", root: root, tags: map[str][]Node{"a": {leaf1}}}
	say.Line(t)
	say.Line(say.Fmt("%+v", t))
	say.Line([]Node{root, leaf1})

	// %+v is not "%v with a sign": numbers get none, structs get field names. %+d, %+g, %+f and %+e do.
	say.Line(say.Fmt("%+v|%+v|%+v|%+v|%+v", 1.5, 42, -3, "s", true))
	say.Line(say.Fmt("%+d|%+g|%+f|%+.1f|%+e", 42, 1.5, 1.5, 1.5, 1.5))
	say.Line(say.Fmt("%+v|%v", P{a: 1, b: 2.5}, P{a: 1, b: 2.5}))
	say.Line(say.Fmt("%+v", []f64{1.5, -2}), say.Fmt("%+v", []i64{1, -2}))
	say.Line(say.Fmt("%+v|%+v", map[str]P{"k": P{a: 3, b: 0.5}}, map[f64]i64{0.5: 1}))
	say.Line(say.Fmt("%v %+v %v", 7, 7, 7))
}
