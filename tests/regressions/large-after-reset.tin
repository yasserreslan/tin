package main
import "hearth"
import "twine"
func main() {
    a := twine.Repeat("b", 100)
    big := twine.Repeat("a", 5000000)
    println(len(a), len(big))
    hearth.Reset()
    again := twine.Repeat("c", 6000000)
    small := twine.Repeat("d", 10)
    println(len(again), len(small), again[5999999:], small[9:])
}
