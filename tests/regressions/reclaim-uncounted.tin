package main

import "say"
import "hearth"

// #176: a block also held where it cannot be counted (a global's initial value, a store
// into an element's field) must outlive its counted references.
type Row struct {
	Name str
}

var names = []str{twice("ab")}
var cache = map[str]str{}
var rows = []Row{Row{Name: ""}}
var pool []str

func twice(s str) str {
	return s + s + s
}

func step(i i64) {
	cache["k"] = names[0]
	delete(cache, "k")
	pool = append(pool, keep("x{i}"))
	rows[0].Name = pool[len(pool)-1]
	pool = keep(pool[:0])
}

func main() {
	for i := 0; i < 50; i++ {
		step(i)
		hearth.Reset()
		hearth.Reset()
	}
	say.Line(names[0], rows[0].Name, len(pool))
}
