package main

import "say"

// #95: a loop whose step makes the counter wrap negative must keep its bounds check. Since
// #362 the counter's + is checked (it panics before wrapping); in a @wrap function it wraps,
// and the bounds check must still catch the negative index.
@wrap fn walk(xs []i64) {
	mut n = 0
	for i in (1..len(xs)).step(9223372036854775807) {
		say.Line(i, xs[i])
		n += 1
		if n == 3 {
			break
		}
	}
}

fn main() {
	walk([]i64{10, 20, 30})
}
