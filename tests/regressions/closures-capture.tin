package main

import "say"
import "sift"

func makeCounter() func() i64 {
	n := 0
	return func() i64 {
		n++
		return n
	}
}

func main() {
	xs := []i64{1, 2, 3, 4, 5}
	total := 0
	sift.Each(xs, func(x i64) {
		total += x
	})
	say.Line("total:", total)

	c := makeCounter()
	say.Line("c:", c())
	say.Line("c:", c())
}
