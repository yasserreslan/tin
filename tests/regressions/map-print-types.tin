package main

import "say"

type Pt struct {
	x i64
	y i64
}

func main() {
	say.Line("f64 keys", map[f64]i64{2.5: 1, -1: 2, 0: 3, 1e300: 4, -1e-300: 5, 0.5: 6, 1.5: 7})
	say.Line("bool keys", map[bool]str{true: "yes", false: "no"})
	say.Line("u8 keys", map[u8]i64{200: 1, 3: 2, 255: 3})
	say.Line("u64 keys", map[u64]i64{18446744073709551615: 1, 5: 2, 9223372036854775808: 3})
	say.Line("i8 keys", map[i8]i64{-128: 1, 5: 2, -1: 3})
	say.Line("i64 keys", map[i64]str{-9223372036854775807: "min", 7: "seven"})
	say.Line("u64 values", map[str]u64{"a": 18446744073709551615, "b": 1})
	say.Line("u8 values", map[str]u8{"a": 255, "b": 1})
	say.Line("i8 values", map[str]i8{"a": -128, "b": 1})
	say.Line("f32 values", map[str]f32{"a": 0.1, "b": 2.5})
	say.Line("f64 values", map[str]f64{"a": 0.1, "b": 2.5})
	say.Line("slice values", map[str][]i64{"a": {1, 2}, "b": {}})
	say.Line("str slice values", map[str][]str{"a": {"x", "y"}})
	say.Line("nested map values", map[str]map[str]i64{"a": {"x": 1}, "b": {}})
	say.Line("bool values", map[i64]bool{1: true, 2: false})
	say.Line("struct values", map[str]Pt{"a": Pt{x: 1, y: 2}, "b": Pt{x: 3, y: 4}})
	say.Line("deep", map[str]map[str][]i64{"k": {"x": {1}, "a": {2, 3}}})
	say.Line("empty", map[str]i64{}, map[f64]bool{}, len(map[i64]str{}))
	// Formatted forms print the same way.
	m := map[f64]str{0.5: "half", -2: "minus two"}
	say.Line(say.Fmt("%v|%v", m, m), say.Str(m))
	// A large map must sort in O(n log n): 50,000 entries, keys added in a scrambled order.
	big := map[i64]i64{}
	k := 1
	for i := 0; i < 50000; i++ {
		k = (k*48271 + 11) % 2147483647
		big[k%1000003] = i
	}
	text := say.Str(big)
	say.Line("big", len(big), len(text), text[:40])
}
