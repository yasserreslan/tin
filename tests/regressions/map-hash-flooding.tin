package main

import "say"

// Keys chosen to collide under an unkeyed hash must not make map operations quadratic.
// Each k = i * inv(golden ratio) hashed to i under the old k * 0x9E3779B97F4A7C15, so
// every key had the same home slot and building the map took minutes; with the
// per-process hash key they spread out.
fn main() {
	let inv = i64(u64(0xf1de83e19937733d))
	let n = 400000
	let m = map[i64]i64{}
	for i in 0..n {
		m[i*%inv] = i
	}
	mut sum = 0
	for i in 0..n {
		sum += m[i*%inv]
	}
	say.Line(len(m), sum)

	// Long and short str keys, struct keys and deletes still round-trip.
	let s = map[str]i64{}
	for i in 0..1000 {
		s["key-{i}-{i * 7919}"] = i
	}
	delete(s, "key-3-23757")
	let (_, ok) = s["key-3-23757"]
	say.Line(len(s), s["key-999-7911081"], ok, s[""])
	s[""] = 5
	say.Line(s[""])
}
