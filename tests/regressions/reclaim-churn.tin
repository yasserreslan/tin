package main

import "say"
import "hearth"

// #176: replacing long-lived entries reclaims the old ones once the request ends.
type User struct {
	Name str
	Roles []str
}

var users = map[str]User{}
var log []str

func step(i i64) {
	users[keep("u{i % 50}")] = keep(User{Name: "name{i}", Roles: []str{"a{i}"}})
	log = append(log, keep("e{i}"))
	if len(log) > 100 {
		log = keep(log[50:])
	}
}

func main() {
	for i := 0; i < 20000; i++ {
		step(i)
		hearth.Reset()
	}
	report()
}

func report() {
	blocks, bytes, limbo := hearth.RcStats()
	say.Line(len(users), users["u7"].Roles[0], len(log), blocks < 2000, bytes < 200000, limbo < 100)
}
