package main

import "say"

func apply(f func(i64) i64, x i64) i64 {
	return f(x)
}

func double(x i64) i64 {
	return x * 2
}

func addTen(x i64) i64 {
	return x + 10
}

func main() {
	var f func(i64) i64 = double
	say.Line(apply(f, 21))
	f = addTen
	say.Line(apply(f, 32))
	say.Line(apply(func(x i64) i64 { return x * x }, 9))
}
