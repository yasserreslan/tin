package main

import "say"

var handlers []func() i64

func register(f func() i64) {
	handlers = append(handlers, keep(f))
}

func makeAll() []func() i64 {
	out := make([]func() i64, 0, 4)
	for i := 0; i < 4; i++ {
		base := i * 100
		out = append(out, func() i64 {
			base++
			return base + i
		})
	}
	return out
}

func deferred() {
	n := 1
	defer func() {
		say.Line("deferred", n)
	}()
	n = 7
}

func main() {
	// closures stored by a callee and by append outlive the loop iteration and the frame
	for _, name := range []str{"a", "bb", "ccc"} {
		register(func() i64 {
			return i64(len(name))
		})
	}
	for _, h := range handlers {
		say.Line("handler", h())
	}
	fs := makeAll()
	for _, f := range fs {
		say.Line("made", f(), f())
	}
	deferred()
	for k, v := range map[str]i64{"x": 1, "y": 2} {
		g := func() str {
			return k + say.Fmt("%d", v)
		}
		say.Line("map", g())
	}
}
