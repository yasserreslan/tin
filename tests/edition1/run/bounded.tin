package main

import "argo"
import "fault"
import "say"

type User struct {
	name str max 8
	tags []str max 2
	score i64
}

type Name str max 8

// decode shows what argo.Get gives for text: the user, or the fault and whether it is
// fault.LimitExceeded.
fn decode(text str) {
	mut u = User{name: ""}
	let err = argo.Get(text, mut u)
	if err != nil {
		say.Line("fault:", err, "| limit:", fault.Is(err, fault.LimitExceeded))
		return
	}
	say.Line("user:", u.name, len(u.name), u.tags, u.score)
}

fn check(raw str) !Name {
	return try bound(raw)
}

fn rename(u mut User, raw str) ! {
	u.name = try bound(raw)
}

fn plain(s str) str {
	return s + "!"
}

fn main() {
	decode(`{"name": "ann", "tags": ["a", "b"], "score": 3}`)
	decode(`{"name": "12345678"}`)
	decode(`{"name": "123456789", "score": 3}`)
	decode(`{"name": "cafécaf", "score": 1}`)
	decode(`{"name": "cafécafe", "score": 1}`)
	decode(`{"name": "😀😀"}`)
	decode(`{"name": "😀😀!"}`)
	decode(`{"tags": ["a", "b", "c"]}`)
	decode(`{"tags": []}`)
	decode(`{"name": "unte`)
	let a = check("ok") catch err {
		say.Line("never", err)
		""
	}
	let b = check("much too long") catch err {
		say.Line("bound fault:", err, "| limit:", fault.Is(err, fault.LimitExceeded))
		""
	}
	say.Line("bound:", a, b)
	mut u = User{name: "bo"}
	rename(mut u, "eve") catch err {
		say.Line("never", err)
	}
	rename(mut u, "evelynnnn") catch err {
		say.Line("rename fault:", err)
	}
	let n str max 4 = "abcd"
	let wide str max 100 = n
	let s str = u.name
	say.Line("names:", u.name, n, wide, s, plain(u.name), len(u.name + n))
}
