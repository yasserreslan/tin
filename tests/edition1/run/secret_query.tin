package main

import "say"

// A secret value may be written into a query literal (#241, design/interface_replay.md 5.3): it
// is sent as itself, and bit i of the query's Hidden marks Args[i] so a replay key holds its
// handle instead of its text.

fn token() secret str {
	return "tok"
}

fn pin() secret i64 {
	return 7
}

fn show(q query) {
	say.Line(len(q.Parts), len(q.Args), q.Hidden)
}

fn main() {
	let t = token()
	let p = pin()
	let id = 3
	show("GET user:{id}")
	show("GET {t}")
	show("SET user:{id} {t}")
	show("SELECT {id}, {p}, {t}, {id}")
	show("plain text")
}
