package main

import "say"

// break and continue with a label leave or restart the loop the label names, not the innermost one.
fn main() {
	// The docs/LANGUAGE.md example: prints 0 0, 1 0, 1 1.
	outer: for i in 0..3 {
		for j in 0..3 {
			if j > i {
				continue outer
			}
			if i == 2 {
				break outer
			}
			say.Line(i, j)
		}
		say.Line("unreachable", i)
	}

	// Stepped range around a condition loop.
	steps: for k in (0..10).step(3) {
		mut spin = 0
		for spin < 3 {
			if k == 6 && spin == 1 {
				break steps
			}
			spin += 1
		}
		say.Line("step", k)
	}

	// Slice range, map range and string range, three deep.
	let xs = []i64{1, 2, 3}
	let m = map[str]i64{"a": 1, "b": 2}
	mut found = ""
	search: for x in xs {
		for k, v in m {
			for _, c in "xyz" {
				if x == 2 && v == 2 && c == 'y' {
					found = "{x} {k} {str(c)}"
					break search
				}
				if c == 'y' && x == 1 {
					continue search
				}
			}
		}
	}
	say.Line("found", found)

	// Condition loops. Every inner loop is bounded, so a compiler that gets this wrong prints
	// the wrong line instead of spinning.
	mut n = 0
	mut rounds = 0
	rounds_loop: for n < 5 {
		n += 1
		mut tries = 0
		for tries < 3 {
			tries += 1
			if n % 2 == 0 {
				continue rounds_loop
			}
			rounds += 1
			break
		}
	}
	say.Line("rounds", rounds, n)

	// A forever loop inside a condition loop.
	mut laps = 0
	track: for laps < 10 {
		laps += 1
		for {
			if laps == 3 {
				break track
			}
			break
		}
	}
	say.Line("laps", laps)

	// A match inside the inner loop does not get in the way.
	mut hits = 0
	scan: for i in 0..4 {
		for j in 0..4 {
			match j {
				2 => continue scan
				_ => {
					if i == 3 {
						break scan
					}
				}
			}
			hits += 1
		}
	}
	say.Line("hits", hits)

	// An inner loop may reuse the name: the innermost one wins.
	mut inner = 0
	same: for i in 0..3 {
		same: for j in 0..3 {
			if j == 1 {
				continue same
			}
			inner += 1
		}
		inner += 10
	}
	say.Line("inner", inner)

	// Labels inside a closure name the closure's own loops.
	let count = fn(size i64) i64 {
		mut c = 0
		rows: for r in 0..size {
			for col in 0..size {
				if col > r {
					continue rows
				}
				c += 1
			}
		}
		return c
	}
	say.Line("triangle", count(4))
}
