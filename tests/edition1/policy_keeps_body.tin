package main

import "constraints"
import "say"

// A policy may only call its body (#237): the block's variables live on the caller's frame.

type Saver[T constraints.Any] struct {
	saved []fn() !T
}

fn (s mut Saver[T]) Run(body fn() !T) !T {
	s.saved = append(s.saved, body)
	return try body()
}

fn later(f fn() !i64, all mut []fn() !i64) {
	all = append(all, f)
}

type Passer struct {
	all []fn() !i64
}

fn (p mut Passer) Run(body fn() !i64) !i64 {
	later(body, mut p.all)
	return try body()
}

fn main() {
	mut s = Saver[i64]{saved: []fn() !i64{}}
	let a = with s {
		1
	} catch _ {
		0
	}
	mut p = Passer{all: []fn() !i64{}}
	let b = with p {
		2
	} catch _ {
		0
	}
	say.Line(a, b)
}
