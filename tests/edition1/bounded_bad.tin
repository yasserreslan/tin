package main

type User struct {
	name str max 8
	tags []str max 2
}

fn grow(u mut User, raw str) {
	u.name = raw
	u.name = u.name + "x"
	u.tags = append(u.tags, "x")
	let n str max 4 = "too long"
	let count i64 max 5 = 3
}

fn unchecked(raw str) !str {
	let b = try bound(raw)
	return b
}

fn main() {
	let s str max 3 = "abc"
	let t str max 2 = s
	_ = t
}
