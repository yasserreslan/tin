package main

import "fault"
import "hearth"
import "kafka"
import "mint"
import "quarry"
import "relay"
import "say"
import "sift"
import "tide"
import "tls"

// Runs the Kafka client against a real broker: KAFKA_ADDR (default 127.0.0.1:9092), with SASL
// when KAFKA_USER and KAFKA_PASSWORD are set (KAFKA_MECHANISM: PLAIN, SCRAM-SHA-256 or
// SCRAM-SHA-512), and TLS 1.3 when KAFKA_TLS=1 (KAFKA_TLS_INSECURE=1 skips the certificate
// check). It prints one "ok" or "FAIL" line per check and exits 1 on any FAIL. See
// tests/kafka/README.md.

mut failed i64

fn ok(label str, cond bool) {
	if cond {
		say.Line("ok", label)
	} else {
		say.Line("FAIL", label)
		failed += 1
	}
}

fn eq(label str, got i64, want i64) {
	if got == want {
		say.Line("ok", label)
	} else {
		say.Line("FAIL", label, "got", got, "want", want)
		failed += 1
	}
}

fn isFault(label str, err fault, want fault) {
	if err != nil && fault.Is(err, want) {
		say.Line("ok", label)
	} else {
		say.Line("FAIL", label, "got", err)
		failed += 1
	}
}

fn options(addr str) kafka.Options {
	mut o = kafka.Options{Brokers: []str{addr}, ClientID: "tin-it", Username: quarry.Getenv("KAFKA_USER"), Password: quarry.Getenv("KAFKA_PASSWORD"), Timeout: 20s}
	let mech = quarry.Getenv("KAFKA_MECHANISM")
	if mech == "SCRAM-SHA-256" {
		o.Mechanism = kafka.Mechanism.ScramSha256
	} else if mech == "SCRAM-SHA-512" {
		o.Mechanism = kafka.Mechanism.ScramSha512
	}
	if quarry.Getenv("KAFKA_TLS") == "1" {
		o.TLS = tls.Config{ServerName: "", RootCAs: "", ALPN: []str{}, Timeout: 0, InsecureSkipVerify: quarry.Getenv("KAFKA_TLS_INSECURE") == "1"}
	}
	return o
}

fn addr() str {
	let a = quarry.Getenv("KAFKA_ADDR")
	if a == "" {
		return "127.0.0.1:9092"
	}
	return a
}

fn msg(k str, v str) kafka.Message {
	return kafka.Message{Key: k, Value: v, Headers: []kafka.Header{}, Timestamp: 0}
}

// ---- admin ----

fn admin(c kafka.Client, p str) ! {
	try c.Ping()
	say.Line("ok ping")
	try c.CreateTopics([]kafka.TopicSpec{kafka.TopicSpec{Name: p + "-admin", Partitions: 3, Replicas: 1, Configs: []kafka.Config{kafka.Config{Name: "retention.ms", Value: "3600000"}}}})
	let again = c.CreateTopic(p+"-admin", 3, 1)
	isFault("creating a topic twice is ErrTopicExists", again, kafka.ErrTopicExists)
	let names = try c.ListTopics()
	mut seen = false
	for _, n in names {
		if n == p+"-admin" {
			seen = true
		}
	}
	ok("ListTopics names the new topic", seen)
	let cfgs = try c.DescribeConfigs(kafka.Resource.Topic, p+"-admin")
	mut ret = ""
	for _, cf in cfgs {
		if cf.Name == "retention.ms" {
			ret = cf.Value
		}
	}
	ok("topic config set at creation", ret == "3600000")
	try c.SetConfig(kafka.Resource.Topic, p+"-admin", "retention.ms", "7200000")
	// A KRaft broker learns the change from the metadata log a moment later.
	mut ret2 = ""
	mut cleanup = ""
	for k in 0..40 {
		let cfgs2 = try c.DescribeConfigs(kafka.Resource.Topic, p+"-admin")
		for _, cf in cfgs2 {
			if cf.Name == "retention.ms" {
				ret2 = cf.Value
			}
			if cf.Name == "cleanup.policy" {
				cleanup = cf.Value
			}
		}
		if ret2 == "7200000" {
			break
		}
		tide.Sleep(50ms)
	}
	ok("SetConfig changes one key", ret2 == "7200000")
	ok("SetConfig leaves the others", cleanup == "delete")
	try c.ResetConfig(kafka.Resource.Topic, p+"-admin", "retention.ms")
	mut def = false
	for k in 0..40 {
		let cfgs3 = try c.DescribeConfigs(kafka.Resource.Topic, p+"-admin")
		for _, cf in cfgs3 {
			if cf.Name == "retention.ms" {
				def = cf.Default
			}
		}
		if def {
			break
		}
		tide.Sleep(50ms)
	}
	ok("ResetConfig returns the key to its default", def)
	let broker = try c.DescribeConfigs(kafka.Resource.Broker, "1")
	ok("broker configs are described", len(broker) > 50)
	try c.CreatePartitions(p+"-admin", 5)
	let np = try c.Partitions(p + "-admin")
	eq("CreatePartitions grows the topic", np, 5)
	for i in 0..10 {
		_ = try c.SendTo(p+"-admin", 0, msg("", "r{i}"))
	}
	let low = try c.DeleteRecords(p+"-admin", 0, 4)
	eq("DeleteRecords moves the first offset", low, 4)
	let (first, next) = try c.Offsets(p+"-admin", 0)
	eq("first offset after DeleteRecords", first, 4)
	eq("next offset", next, 10)
	let (_, gone) = c.Fetch(p+"-admin", 0, 2, 100ms)
	isFault("fetching deleted records is ErrOffsetOutOfRange", gone, kafka.ErrOffsetOutOfRange)
	try c.DeleteTopics([]str{p + "-admin"})
	tide.Sleep(500ms)
	let names2 = try c.ListTopics()
	mut still = false
	for _, n in names2 {
		if n == p+"-admin" {
			still = true
		}
	}
	ok("DeleteTopics removes the topic", !still)
}

// ---- producing and fetching ----

fn produce(c kafka.Client, p str) ! {
	let topic = p + "-p"
	try c.CreateTopic(topic, 3, 1)
	let a1 = try c.Send(topic, kafka.Message{Key: "foobar", Value: "first", Headers: []kafka.Header{kafka.Header{Key: "src", Value: "tin"}}, Timestamp: 0})
	eq("keyed partition is murmur2's", a1.Partition, kafka.PartitionFor("foobar", 3))
	eq("first offset", a1.Offset, 0)
	let a2 = try c.Send(topic, msg("foobar", "second"))
	eq("same key, same partition, next offset", a2.Offset, 1)
	let rs = try c.Fetch(topic, a1.Partition, 0, 2s)
	ok("fetch returns both", len(rs) == 2 && rs[0].Value == "first" && rs[1].Value == "second")
	if len(rs) == 2 {
		ok("fetch keeps headers", len(rs[0].Headers) == 1 && rs[0].Headers[0].Value == "tin")
		ok("fetch timestamp is recent", rs[0].Timestamp > 1700000000000)
	}
	// Every codec, both ways.
	let codecs = []kafka.Compression{kafka.Compression.None, kafka.Compression.Gzip, kafka.Compression.Snappy, kafka.Compression.Lz4, kafka.Compression.Zstd}
	let names = []str{"none", "gzip", "snappy", "lz4", "zstd"}
	for i, cd in codecs {
		mut o = options(addr())
		o.Compression = cd
		let cc = kafka.Open(o)
		mut ms = []kafka.Message{}
		for k in 0..200 {
			ms = append(ms, msg("", "{names[i]} record {k} with some repeated text repeated text repeated text"))
		}
		let acks = try cc.SendBatch(topic, ms)
		let part = acks[0].Partition
		mut same = true
		for k, a in acks {
			if a.Partition != part || a.Offset != acks[0].Offset+k {
				same = false
			}
		}
		ok("{names[i]}: 200 records in one batch, consecutive offsets", same)
		let back = try c.Fetch(topic, part, acks[0].Offset, 2s)
		mut good = len(back) >= 200
		for k in 0..min(len(back), 200) {
			if back[k].Value != ms[k].Value {
				good = false
			}
		}
		ok("{names[i]}: read back", good)
	}
	// Linger, and a batch limit that splits one call's records over several batches.
	mut og = options(addr())
	og.Linger = 20ms
	let lingering = kafka.Open(og)
	let t0 = tide.Now()
	let la = try lingering.SendBatchTo(topic, 1, []kafka.Message{msg("", "lingered 1"), msg("", "lingered 2")})
	ok("a send with Linger waits for it and lands", la[1].Offset == la[0].Offset+1 && tide.Now()-t0 >= 20ms)
	mut ob = options(addr())
	ob.BatchMax = 1000
	let small = kafka.Open(ob)
	mut many = []kafka.Message{}
	for k in 0..200 {
		many = append(many, msg("", "small batch record {k}"))
	}
	let sa = try small.SendBatchTo(topic, 1, many)
	mut consecutive = true
	for k, a in sa {
		if a.Offset != sa[0].Offset+k {
			consecutive = false
		}
	}
	ok("BatchMax splits a call into several batches, offsets still in order", consecutive)
	// A fetch limited to one byte still gets one whole batch (KIP-74): the first one alone.
	mut of = options(addr())
	of.FetchMax = 1
	let oneBatch = kafka.Open(of)
	let sb = try oneBatch.Fetch(topic, 1, sa[0].Offset, 2s)
	ok("and the first batch holds what fits in BatchMax", len(sb) > 0 && len(sb) < 200 && sb[0].Value == "small batch record 0")
	// Acks.
	mut ol = options(addr())
	ol.Acks = kafka.Acks.Leader
	let leaderOnly = kafka.Open(ol)
	let al = try leaderOnly.Send(topic, msg("k", "leader"))
	ok("acks leader gives an offset", al.Offset >= 0)
	mut on = options(addr())
	on.Acks = kafka.Acks.NoAck
	let fire = kafka.Open(on)
	let an = try fire.Send(topic, msg("k", "no ack"))
	eq("acks none gives no offset", an.Offset, -1)
	tide.Sleep(300ms)
	let tail = try c.Fetch(topic, an.Partition, al.Offset, 1s)
	ok("acks none still writes", len(tail) == 2 && tail[1].Value == "no ack")
	// Several partitions at once.
	let wants = []kafka.Want{kafka.Want{Topic: topic, Partition: 0, Offset: 0}, kafka.Want{Topic: topic, Partition: 1, Offset: 0}, kafka.Want{Topic: topic, Partition: 2, Offset: 0}}
	let f = try c.FetchAll(wants, 1s)
	eq("FetchAll reports each partition", len(f.Parts), 3)
	mut total = 0
	for _, pt in f.Parts {
		total += pt.HighWatermark
	}
	ok("FetchAll sees every partition's records", total >= 1003)
	// Offsets by time.
	let before = tide.Wall()/1000000 - 1
	let ab = try c.SendTo(topic, 2, msg("", "timed"))
	let at = try c.OffsetAt(topic, 2, before)
	eq("OffsetAt finds the first record at or after a time", at, ab.Offset)
	let never = try c.OffsetAt(topic, 2, tide.Wall()/1000000+3600000)
	eq("OffsetAt past every record is -1", never, -1)
	// Errors.
	let (_, badp) = c.Fetch(topic, 9, 0, 100ms)
	isFault("a partition that does not exist is ErrUnknownTopic", badp, kafka.ErrUnknownTopic)
	let (_, big) = c.Send(topic, msg("", str(make([]u8, 2000000))))
	isFault("a record over the broker's limit is ErrMessageTooLarge", big, kafka.ErrMessageTooLarge)
	// Many sends, then everything read back in order.
	mut want = 0
	for i in 0..500 {
		let a = try c.Send(topic, msg("bulk", "m{i}"))
		if i == 0 {
			want = a.Offset
		}
		if a.Offset != want+i {
			say.Line("FAIL bulk offset", i, a.Offset)
			failed += 1
			break
		}
	}
	mut got = 0
	mut off = want
	for got < 500 {
		let more = try c.Fetch(topic, kafka.PartitionFor("bulk", 3), off, 1s)
		if len(more) == 0 {
			break
		}
		for _, r in more {
			if r.Value != "m{got}" {
				say.Line("FAIL bulk order", got, r.Value)
				failed += 1
				return
			}
			got += 1
			off = r.Offset + 1
		}
	}
	eq("500 sends read back in order", got, 500)
}

// ---- transactions ----

fn transactions(c kafka.Client, p str) ! {
	let topic = p + "-tx"
	try c.CreateTopic(topic, 1, 1)
	mut rco = options(addr())
	rco.ReadCommitted = true
	let committedReader = kafka.Open(rco)
	let tx = try c.Transactional(p+"-txid", 0)
	try tx.Begin()
	_ = try tx.Send(topic, msg("a", "aborted 1"))
	_ = try tx.Send(topic, msg("a", "aborted 2"))
	try tx.Abort()
	try tx.Begin()
	let a = try tx.Send(topic, msg("a", "committed 1"))
	_ = try tx.SendBatch(topic, []kafka.Message{msg("a", "committed 2"), msg("a", "committed 3")})
	// Not visible to read_committed before the commit.
	let early = try committedReader.Fetch(topic, 0, 0, 300ms)
	eq("read_committed sees nothing of an open transaction", len(early), 0)
	try tx.Commit()
	let all = try c.Fetch(topic, 0, 0, 1s)
	eq("read_uncommitted sees aborted and committed records", len(all), 5)
	// The commit markers raise the last stable offset just after EndTxn returns.
	mut vals = []str{}
	for k in 0..40 {
		let rc = try committedReader.Fetch(topic, 0, 0, 200ms)
		vals = []str{}
		for _, r in rc {
			vals = append(vals, r.Value)
		}
		if len(vals) >= 3 {
			break
		}
	}
	mut abortedSeen = false
	for _, v in vals {
		if v == "aborted 1" || v == "aborted 2" {
			abortedSeen = true
		}
	}
	ok("read_committed never shows aborted records", !abortedSeen)
	ok("read_committed shows the committed records", len(vals) == 3 && vals[0] == "committed 1" && vals[2] == "committed 3")
	if len(vals) != 3 {
		say.Line("info read_committed values", vals)
	}
	ok("the committed offsets skip the abort marker", a.Offset == 3)
	// Consume-transform-produce: offsets commit with the transaction.
	try tx.Begin()
	_ = try tx.Send(topic, msg("b", "with offsets"))
	try tx.SendOffsets(p+"-txgroup", []kafka.TopicPartition{kafka.TopicPartition{Topic: topic, Partition: 0, Offset: 42}})
	let notYet = try c.Committed(p+"-txgroup", topic, 0)
	eq("transactional offsets are invisible before the commit", notYet, -1)
	try tx.Commit()
	// The coordinator applies the commit marker to the group's offsets just after EndTxn returns.
	mut now = -1
	for k in 0..40 {
		now = try c.Committed(p+"-txgroup", topic, 0)
		if now == 42 {
			break
		}
		tide.Sleep(50ms)
	}
	eq("transactional offsets are the group's after the commit", now, 42)
	// A second producer with the same id fences the first.
	let tx2 = try c.Transactional(p+"-txid", 0)
	try tx.Begin()
	let (_, fenced) = tx.Send(topic, msg("c", "zombie"))
	isFault("an older producer with the same id is fenced", fenced, kafka.ErrFenced)
	try tx2.Begin()
	_ = try tx2.Send(topic, msg("c", "new owner"))
	try tx2.Commit()
}

// ---- simple offsets ----

fn offsets(c kafka.Client, p str) ! {
	let topic = p + "-p"
	let g = p + "-simple"
	let c0 = try c.Committed(g, topic, 0)
	eq("nothing committed yet", c0, -1)
	try c.Commit(g, topic, 0, 2)
	let c1 = try c.Committed(g, topic, 0)
	eq("committed", c1, 2)
}

// ---- groups: one member per core ----

fn member(core i64, p str) ! {
	let c = kafka.Open(options(addr()))
	let topic = p + "-g"
	let g = try c.Group(kafka.GroupOptions{Group: p + "-group", Topics: []str{topic}, Heartbeat: 300ms, Session: 10s, Start: kafka.Start.Earliest})
	// Poll the empty topic until the group has given each of the two members two partitions.
	mut got = []str{}
	let deadline = tide.Now() + 60s
	for len(g.Assigned()) != 2 && tide.Now() < deadline {
		let rs = try g.Poll(300ms)
		for _, r in rs {
			got = append(got, r.Value)
		}
	}
	if len(g.Assigned()) != 2 {
		fail "the group did not split the partitions (this member has {len(g.Assigned())})"
	}
	if core == 0 {
		// Both members are in: write the records now.
		for i in 0..400 {
			_ = try c.Send(topic, msg("k{i}", "v{i}"))
		}
	}
	mut quiet = 0
	for quiet < 10 && tide.Now() < deadline {
		let rs = try g.Poll(300ms)
		if len(rs) == 0 {
			quiet += 1
		} else {
			quiet = 0
		}
		for _, r in rs {
			got = append(got, r.Value)
		}
	}
	try g.Close()
	mut line = "{core} {g.Generation()}"
	for _, v in got {
		line = line + " " + v
	}
	relay.Send(0, line)
}

fn groups(c kafka.Client, p str) ! {
	let topic = p + "-g"
	try c.CreateTopic(topic, 4, 1)
	hearth.Run(2, fn(core i64) {
		member(core, p) catch err {
			relay.Send(0, "{core} error {err}")
		}
	})
	// Each member sends "core generation value value ...".
	mut total = 0
	mut distinct = []str{}
	mut members = 0
	for i in 0..2 {
		let (from, line) = relay.Recv()
		mut f = []str{}
		mut cur = ""
		for k in 0..len(line) {
			if line[k] == ' ' {
				f = append(f, cur)
				cur = ""
			} else {
				cur = cur + line[k:k+1]
			}
		}
		f = append(f, cur)
		if len(f) >= 2 && f[1] == "error" {
			say.Line("FAIL member", line)
			failed += 1
			continue
		}
		say.Line("info member on core", f[0], "generation", f[1], "consumed", len(f)-2)
		if len(f) > 2 {
			members += 1
		}
		for _, v in f[2:] {
			total += 1
			distinct = append(distinct, v)
		}
	}
	sift.Strs(mut distinct)
	mut uniq = 0
	for i, v in distinct {
		if i == 0 || v != distinct[i-1] {
			uniq += 1
		}
	}
	eq("two members on two cores consume every record", uniq, 400)
	eq("both members got partitions", members, 2)
	say.Line("info records delivered twice across the rebalance", total-uniq)
	let d = try c.DescribeGroup(p + "-group")
	ok("a closed group is empty", d.State == "Empty" && len(d.Members) == 0)
	let ls = try c.ListGroups()
	mut listed = false
	for _, l in ls {
		if l.Group == p+"-group" && l.ProtocolType == "consumer" {
			listed = true
		}
	}
	ok("ListGroups names the group", listed)
	let com = try c.Committed(p+"-group", topic, 0)
	ok("the group committed its offsets", com > 0)
	try c.DeleteGroups([]str{p + "-group"})
	let (d2, e2) = c.DescribeGroup(p + "-group")
	ok("DeleteGroups removes the group", e2 != nil || d2.State == "Dead")
}

fn main() {
	let c = kafka.Open(options(addr()))
	let p = "tin-it-{tide.Wall()/1000000}"
	for _, step in []str{"admin", "produce", "offsets", "transactions", "groups"} {
		mut err fault = nil
		if step == "admin" {
			err = admin(c, p)
		} else if step == "produce" {
			err = produce(c, p)
		} else if step == "offsets" {
			err = offsets(c, p)
		} else if step == "transactions" {
			err = transactions(c, p)
		} else {
			err = groups(c, p)
		}
		if err != nil {
			say.Line("FAIL", step, err, "(ErrAuth: {fault.Is(err, kafka.ErrAuth)})")
			failed += 1
		}
	}
	if failed > 0 {
		say.Line("FAILED", failed)
		quarry.Exit(1)
	}
	say.Line("PASS")
}
